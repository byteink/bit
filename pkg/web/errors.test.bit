// pkg/web/errors.test.bit — #3876's acceptance, one named test per assertion.
//
// Everything goes through `app.handle(req)` (adapter.bit), the seam #3885
// established: the real router, the real chain and the real single mapping
// site, with only the socket left out. Calling `mapFailure` directly would
// pass just as well against a mapping that never runs.
//
// `RecordingSink`/`newSink`/`sinkText`/`adapterApp`/`req`/`freezeOrPanic`
// (adapter.test.bit) and `contains` (router.test.bit) are already declared
// module-wide — reused, not redeclared.

// A domain error that says NOTHING about HTTP: it has `message()` and no
// `status()`, which is the shape of every error a database driver, a file
// read or a parser hands back. This is the type the whole security property
// is stated about.
class PlainError {
  msg: string

  export message(): string {
    return this.msg
  }
}

// A domain error that DOES carry a status, but is not one of this package's
// own constructors — the case `asHttpError` exists for (#4512; errors.bit's
// file header). Structural satisfaction, no registration: nothing anywhere
// names this class as an error type the framework knows.
class DomainError {
  msg: string
  code: int

  export message(): string {
    return this.msg
  }

  export status(): int {
    return this.code
  }
}

// A GET carrying one `Accept` header — the only request shape these tests
// vary. `req()` (adapter.test.bit) sends no headers at all, which is its own
// case and is tested below.
fn acceptReq(target: string, accept: string): Request {
  return Request{ method: "GET", path: target, headers: "Accept: ${accept}", body: "" }
}

// One route that fails with `notFound("<msg>")`, frozen and ready. Every
// negotiation test drives THIS app, so the only thing differing between them
// is the `Accept` header.
fn negotiationApp(): App {
  let app = adapterApp(newSink())
  app.get("/missing", (c) => rethrow(notFound(leakCanary)))
  freezeOrPanic(app)
  return app
}

// The message the negotiation tests look for. Distinctive on purpose: an
// assertion that it is ABSENT from the HTML page is only worth something if
// the string could not have been there by coincidence.
const leakCanary = "canary-user-42"

// --- the mapping ----------------------------------------------------------

test "a handler failing with notFound() is a 404 whose body carries the message" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.get("/u/:id", (c) => rethrow(notFound("user")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/u/7"))

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(contains(res.body, "user"), "the opted-in message must be sent, body was '${res.body}'")
  assert(res.contentType == "application/json", "want JSON, got '${res.contentType}'")
  assert(
    len(sinkText(sink)) == 0,
    "a 404 is not a server error and must not be logged: '${sinkText(sink)}'",
  )
}

// THE security property. An error that did not opt in gets a generic body,
// and its real message goes to the log and nowhere else.
test "an error with message() but no status() is a 500 whose message is logged, not sent" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.get("/boom", (c) => rethrow(PlainError{ msg: "postgres://u:p@h/db" }))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/boom?trace=1"))

  assert(res.status == 500, "want 500, got ${res.status}")
  assert(
    !contains(res.body, "postgres://"),
    "the un-opted-in message must NOT reach the client, body was '${res.body}'",
  )
  assert(
    contains(res.body, "Internal Server Error"),
    "the generic body must be sent instead, got '${res.body}'",
  )
  let logged = sinkText(sink)
  assert(contains(logged, "postgres://u:p@h/db"), "the real message must be logged: '${logged}'")
  assert(contains(logged, "GET"), "the log line must carry the method: '${logged}'")
  assert(contains(logged, "/boom"), "the log line must carry the path: '${logged}'")
}

// The six named constructors, each mapping to its own status — one test
// rather than six, because the assertion is identical and the table IS the
// specification.
test "each named constructor maps to its own status" {
  let app = adapterApp(newSink())
  app.get("/e400", (c) => rethrow(badRequest("m")))
  app.get("/e401", (c) => rethrow(unauthorized("m")))
  app.get("/e403", (c) => rethrow(forbidden("m")))
  app.get("/e404", (c) => rethrow(notFound("m")))
  app.get("/e409", (c) => rethrow(conflict("m")))
  app.get("/e422", (c) => rethrow(unprocessable("m")))
  freezeOrPanic(app)

  let paths = []string{ "/e400", "/e401", "/e403", "/e404", "/e409", "/e422" }
  let want = []int{ 400, 401, 403, 404, 409, 422 }
  let i = 0
  while (i < len(paths)) {
    let res = app.handle(req("GET", paths[i]))
    assert(res.status == want[i], "${paths[i]}: want ${want[i]}, got ${res.status}")
    assert(contains(res.body, "m"), "${paths[i]}: the message must be sent, got '${res.body}'")
    i = i + 1
  }
}

// A domain type opts in structurally — it is never named to the framework,
// and the framework holds no list of error types.
test "a domain error carrying status() maps to that status through asHttpError" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.get("/gone", (c) => rethrow(asHttpError(DomainError{ msg: "widget retired", code: 410 })))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/gone"))

  assert(res.status == 410, "want 410, got ${res.status}")
  assert(contains(res.body, "widget retired"), "want the domain message, got '${res.body}'")
  assert(len(sinkText(sink)) == 0, "a 410 must not be logged: '${sinkText(sink)}'")
}

// A 5xx the app asked for is still a server error: it is SENT (it opted in)
// and it is also LOGGED, which is the half a 4xx does not get.
test "a 5xx HttpError is both sent and logged" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.get("/down", (c) => rethrow(httpError(503, "upstream is down")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/down"))

  assert(res.status == 503, "want 503, got ${res.status}")
  assert(contains(res.body, "upstream is down"), "the opted-in message must be sent: '${res.body}'")
  assert(contains(sinkText(sink), "upstream is down"), "every 5xx logs: '${sinkText(sink)}'")
}

// --- the status range -----------------------------------------------------

// AT CONSTRUCTION, not on the response path: there is no app, no request and
// no handler anywhere in this test — just the constructor call. A
// `testpanic_` test passes only if the process exits with the panic status,
// so an `httpError` that quietly accepted 999 would fail it.
test "testpanic_a_status_outside_100_599_panics_when_the_error_is_constructed" {
  let e = httpError(999, "nope")
  print("unreachable: constructed a ${e.status()}\n")
}

// The control for the test above: the boundary values are legal, so the
// panic is about the RANGE and not about the constructor rejecting anything
// unusual.
test "the ends of the 100..599 range are accepted" {
  assert(httpError(100, "m").status() == 100, "100 must be constructible")
  assert(httpError(599, "m").status() == 599, "599 must be constructible")
}

// --- content negotiation --------------------------------------------------

test "Accept: */* gets a JSON error body" {
  let res = negotiationApp().handle(acceptReq("/missing", "*/*"))

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(res.contentType == "application/json", "want JSON, got '${res.contentType}'")
  assert(contains(res.body, leakCanary), "the message belongs in a JSON body: '${res.body}'")
}

test "Accept: application/json gets a JSON error body" {
  let res = negotiationApp().handle(acceptReq("/missing", "application/json"))

  assert(res.contentType == "application/json", "want JSON, got '${res.contentType}'")
  assert(contains(res.body, leakCanary), "the message belongs in a JSON body: '${res.body}'")
}

// What a browser sends when it NAVIGATES. `text/html` at the default weight
// outranks `*/*;q=0.8`, so this one — and only this one — gets the page.
test "Accept: text/html,application/xhtml+xml,*/*;q=0.8 gets an HTML body without the message" {
  let res = negotiationApp().handle(
    acceptReq("/missing", "text/html,application/xhtml+xml,*/*;q=0.8"),
  )

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(res.contentType == "text/html; charset=utf-8", "want HTML, got '${res.contentType}'")
  assert(contains(res.body, "404"), "the page carries the status: '${res.body}'")
  assert(
    !contains(res.body, leakCanary),
    "the HTML page must never carry the message: '${res.body}'",
  )
}

// A request with no `Accept` at all has not asked for HTML.
test "a request carrying no Accept header gets JSON" {
  let res = negotiationApp().handle(req("GET", "/missing"))

  assert(res.contentType == "application/json", "want JSON, got '${res.contentType}'")
}

// `text/html` appearing is not enough — it has to outrank the alternatives.
test "text/html ranked below */* gets JSON, and a tie also gets JSON" {
  let app = negotiationApp()

  let ranked = app.handle(acceptReq("/missing", "text/html;q=0.5, */*"))
  assert(
    ranked.contentType == "application/json",
    "html at 0.5 must lose to */* at 1: got '${ranked.contentType}'",
  )

  let tied = app.handle(acceptReq("/missing", "text/html, application/json"))
  assert(
    tied.contentType == "application/json",
    "a tie must go to JSON: got '${tied.contentType}'",
  )
}

// `text/html` alone, and html outranking a weighted alternative, are the two
// cases that DO get the page — the positive control for the test above, so
// "JSON" is not being reported by a negotiation that can only ever say JSON.
test "text/html alone, and text/html outranking a weighted alternative, get HTML" {
  let app = negotiationApp()

  let only = app.handle(acceptReq("/missing", "text/html"))
  assert(only.contentType == "text/html; charset=utf-8", "got '${only.contentType}'")

  let ranked = app.handle(acceptReq("/missing", "application/json;q=0.2, text/html;q=0.9"))
  assert(ranked.contentType == "text/html; charset=utf-8", "got '${ranked.contentType}'")
}

// --- the bodiless statuses ------------------------------------------------

test "a 204 error carries no body even when its message is non-empty" {
  let app = adapterApp(newSink())
  app.get("/none", (c) => rethrow(httpError(204, "this must not be sent")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/none"))

  assert(res.status == 204, "want 204, got ${res.status}")
  assert(len(res.body) == 0, "a 204 carries no body, got '${res.body}'")
  // And no representation was negotiated for it either: a `Content-Type`
  // naming a body that does not exist is the half `Res.body()` (res.bit)
  // cannot suppress on its own.
  assert(
    res.contentType == "text/plain; charset=utf-8",
    "a bodiless status must declare no JSON or HTML representation, got '${res.contentType}'",
  )
}

// 304 is the other one, and it must stay bodiless under the `Accept` that
// would otherwise have produced a page.
test "a 304 error carries no body, HTML negotiation notwithstanding" {
  let app = adapterApp(newSink())
  app.get("/fresh", (c) => rethrow(httpError(304, "this must not be sent")))
  freezeOrPanic(app)

  let res = app.handle(acceptReq("/fresh", "text/html"))

  assert(res.status == 304, "want 304, got ${res.status}")
  assert(len(res.body) == 0, "a 304 carries no body, got '${res.body}'")
  assert(
    res.contentType == "text/plain; charset=utf-8",
    "not even the HTML type the Accept header asked for, got '${res.contentType}'",
  )
}
