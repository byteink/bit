// pkg/web/res.test.bit — #3884's acceptance, one named test per assertion.
//
// Every `Ctx` here is built the way a served request will build one: a route
// is REGISTERED through an `App`/`Group`, the app is frozen, the router is
// asked to match a concrete path, and the `Match` it returns supplies both
// the params and the pattern (`routedCtx` below). Nothing hands `newCtx` a
// pattern it made up — that would make the `created()` tests assert a string
// this file wrote rather than one the router derived, which is exactly the
// bug the ticket exists to prevent.
//
// `contains` (router.test.bit) and `Request` (ctx.bit) are already imported
// module-wide — reused here, not re-imported (E0042). `JsonEntry` is new to
// the module and is required BY NAME: a class carrying `@json` is refused
// (E0142) unless its module imports both `Json` (escape.bit already does)
// and `JsonEntry`. It is also named in `objectEntries` below, because the
// synthesized `toJson` does not count as a use — the import the checker
// demands is reported unused by the linter (E0210), filed as #4497.

import { JsonEntry, jsonAsArray, jsonAsObject, jsonGet } from "std/json"

// The fixture `c.json` serializes. `@json` is the consent (#3976); the test
// below compares `c.json(u).body()` against `jsonEncode(u.toJson())`, so it
// asserts the response carries THIS value's own serialization rather than a
// string this file spelled out — a hand-written expectation would pass just
// as well against a `json()` that ignored its argument.
@json class User {
  export id: i64,
  export name: string,
}

// `j`'s object entries, or a panic if it is not an object. Named against
// `[]JsonEntry` deliberately: it is what `@json`'s synthesized `toJson`
// builds, and counting them is how the test below proves the mark emitted
// exactly the declared fields and nothing more.
fn objectEntries(j: Json): []JsonEntry {
  let o = jsonAsObject(j)
  if (!isSome(o)) {
    panic("toJson() must build a JSON object, got: ${jsonEncode(j)}")
  }
  return unwrap(o)
}

fn resConfig(): Config {
  return Config{ secret: "test-secret" }
}

// A `Ctx` for `method requestPath`, matched against a route registered as
// `path` under the group `prefix` ("" for the root). Panics rather than
// failing: a fixture that cannot register or match its own route is a broken
// test, not a result.
fn routedCtx(method: string, prefix: string, path: string, requestPath: string): Ctx {
  let app = App(resConfig())
  let r = routesFor(app, prefix)
  register(r, method, path)
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m = app.root.router.lookup(method, requestPath) catch e {
    panic("lookup ${method} ${requestPath}: ${e.message()}")
  }
  let req = Request{ method: method, path: requestPath, headers: "", body: "" }
  return newCtx(req, m.params, app.root.registry, app.config, m.pattern) catch e {
    panic("newCtx: ${e.message()}")
  }
}

fn routesFor(app: App, prefix: string): Routes {
  if (len(prefix) == 0) {
    return app
  }
  return app.group(prefix)
}

fn register(r: Routes, method: string, path: string) {
  if (method == "POST") {
    r.post(path, okHandler)
    return
  }
  r.get(path, okHandler)
}

// A `Ctx` on the root route `/x`, for the tests whose subject is the
// response and not the route.
fn plainCtx(): Ctx {
  return routedCtx("GET", "", "/x", "/x")
}

// How many times `name` appears in `r`'s header list, case-insensitively.
// The `created()` test asserts EXACTLY one `Location`, which a
// `headerValue()` lookup alone cannot see — it returns the first match
// whether there is one or five.
fn headerCount(r: Res, name: string): int {
  let want = toLower(name)
  let n = 0
  for h of r.headerList() {
    if (toLower(h.name) == want) {
      n = n + 1
    }
  }
  return n
}

// --- created(): the Location is derived, never concatenated ---------------

test "created() under an /api/v1 group is 201 with exactly Location: /api/v1/users/42" {
  let c = routedCtx("POST", "/api/v1", "/users", "/api/v1/users")
  let r = c.created("42")

  assert(r.statusCode() == 201, "status: got ${r.statusCode()}")
  assert(
    r.headerValue("Location") == "/api/v1/users/42",
    "Location must carry the group prefix: got '${r.headerValue("Location")}'",
  )
  assert(
    headerCount(r, "Location") == 1,
    "exactly one Location header: got ${headerCount(r, "Location")}",
  )
  assert(
    len(r.headerList()) == 1,
    "created() sets Location and nothing else: got ${len(r.headerList())} header(s)",
  )
  assert(len(r.body()) == 0, "created() has no body: got '${r.body()}'")
}

test "created() at the root, with no group, gets no phantom prefix" {
  let c = routedCtx("POST", "", "/users", "/users")
  assert(
    c.created("42").headerValue("Location") == "/users/42",
    "root Location: got '${c.created("42").headerValue("Location")}'",
  )
}

test "created() fills the matched route's own params from this request's bindings" {
  let c = routedCtx("POST", "/api/v1", "/orgs/:org/users", "/api/v1/orgs/acme/users")
  assert(
    c.created("42").headerValue("Location") == "/api/v1/orgs/acme/users/42",
    "Location: got '${c.created("42").headerValue("Location")}'",
  )
}

test "createdUrl() is the escape hatch for a resource off the route" {
  let c = routedCtx("POST", "/api/v1", "/users", "/api/v1/users")
  let r = c.createdUrl("/people/42")
  assert(r.statusCode() == 201, "status: got ${r.statusCode()}")
  assert(r.headerValue("Location") == "/people/42", "Location: got '${r.headerValue("Location")}'")
}

test "testpanic_created_refuses_an_empty_id" {
  let c = routedCtx("POST", "/api/v1", "/users", "/api/v1/users")
  c.created("")
}

test "testpanic_createdUrl_refuses_a_javascript_scheme" {
  plainCtx().createdUrl("javascript:alert(1)")
}

// --- json() ---------------------------------------------------------------

test "json() sets application/json and a body equal to the value's own toJson output" {
  let u = User{ id: 42, name: "ada" }
  let r = plainCtx().json(u)

  assert(r.statusCode() == 200, "status: got ${r.statusCode()}")
  assert(
    r.headerValue("Content-Type") == "application/json",
    "Content-Type: got '${r.headerValue("Content-Type")}'",
  )
  assert(
    r.body() == jsonEncode(u.toJson()),
    "body must be the value's own serialization: got '${r.body()}'",
  )
  assert(contains(r.body(), "\"name\":\"ada\""), "body carries the field: got '${r.body()}'")

  // `@json` emitted exactly the declared fields, under their own names —
  // the property the mark exists for. A body test alone cannot see an extra
  // key that happens to sort after the two it looks for.
  let entries = objectEntries(u.toJson())
  assert(len(entries) == 2, "@json must emit exactly the two declared fields: got ${len(entries)}")
  assert(isSome(jsonGet(u.toJson(), "id")), "the 'id' key is missing from the payload")
  assert(isSome(jsonGet(u.toJson(), "name")), "the 'name' key is missing from the payload")
}

// --- jsonList() and jsonOpt() (#4011) -------------------------------------
//
// The bound `T: Jsonable` is the entire acceptance rule, so there is nothing
// here that re-implements one: a `[]i64` or a list of an unmarked class does
// not compile, and the two rejections are pinned as checkercases
// (`check_json_list_scalar_element` and
// `check_json_list_unmarked_element`) rather than asserted from Bit,
// because a program that fails to check cannot also be a test.

test "jsonList() renders a JSON array whose elements are each element's own toJson" {
  let users = []User{ User{ id: 1, name: "ada" }, User{ id: 2, name: "grace" } }
  let r = plainCtx().jsonList(users)

  assert(r.statusCode() == 200, "status: got ${r.statusCode()}")
  assert(
    r.headerValue("Content-Type") == "application/json",
    "Content-Type: got '${r.headerValue("Content-Type")}'",
  )

  // Built from the elements' own `toJson`, not from a string spelled out
  // here: a hand-written expectation passes just as well against a
  // `jsonList` that ignored its argument.
  let want = []Json(0)
  for u of users {
    want = append(want, u.toJson())
  }
  assert(
    r.body() == jsonEncode(Json.JsonArray(want)),
    "body must be the array of each element's serialization: got '${r.body()}'",
  )

  // And structurally, which a whole-body compare cannot see: an ARRAY of two
  // objects, not an object wrapping them (the shape the ticket forbids).
  let parsed = jsonParse(r.body()) catch e {
    panic("the body must parse as JSON ('${r.body()}'): ${e.message()}")
  }
  let arr = jsonAsArray(parsed)
  assert(isSome(arr), "the body must be a JSON array, not an object: '${r.body()}'")
  let items = unwrap(arr)
  assert(len(items) == 2, "the array must carry both elements: got ${len(items)}")
  assert(len(objectEntries(items[0])) == 2, "element 0 must carry User's two fields")
  assert(isSome(jsonGet(items[1], "name")), "element 1 is missing the 'name' key")
}

test "jsonList() on an empty list renders exactly [] and never null" {
  let r = plainCtx().jsonList([]User(0))

  assert(r.body() == "[]", "an empty list must render exactly '[]': got '${r.body()}'")
  assert(
    r.headerValue("Content-Type") == "application/json",
    "Content-Type: got '${r.headerValue("Content-Type")}'",
  )
}

test "jsonOpt() on a set Option renders the value's own toJson" {
  let u = User{ id: 42, name: "ada" }
  let r = plainCtx().jsonOpt(Option.Some(u))

  assert(r.statusCode() == 200, "status: got ${r.statusCode()}")
  assert(
    r.headerValue("Content-Type") == "application/json",
    "Content-Type: got '${r.headerValue("Content-Type")}'",
  )
  assert(
    r.body() == jsonEncode(u.toJson()),
    "body must be the value's own serialization: got '${r.body()}'",
  )
}

test "jsonOpt() on an absent Option renders null" {
  let absent: Option<User> = Option.None
  let r = plainCtx().jsonOpt(absent)

  assert(r.body() == "null", "an absent Option must render 'null': got '${r.body()}'")
  assert(
    r.headerValue("Content-Type") == "application/json",
    "Content-Type: got '${r.headerValue("Content-Type")}'",
  )
}

// --- html() and text() ----------------------------------------------------

test "html() escapes a Node built from user input, and raw() passes bytes through untouched" {
  let hostile = "<script>alert(1)</script>"

  let escaped = plainCtx().html(div(text(hostile))).body()
  assert(!contains(escaped, "<script>"), "a live <script> reached the page: '${escaped}'")
  assert(contains(escaped, "&lt;script&gt;"), "the tag must be entity-escaped: '${escaped}'")

  let passed = plainCtx().html(raw(hostile)).body()
  assert(passed == hostile, "raw() must pass bytes through: got '${passed}'")
}

test "html() sets a charset-bearing text/html and text() a charset-bearing text/plain" {
  let h = plainCtx().html(text("hi"))
  assert(
    h.headerValue("Content-Type") == "text/html; charset=utf-8",
    "html: got '${h.headerValue("Content-Type")}'",
  )

  let t = plainCtx().text("hi")
  assert(
    t.headerValue("Content-Type") == "text/plain; charset=utf-8",
    "text: got '${t.headerValue("Content-Type")}'",
  )
  assert(t.statusCode() == 200, "text status: got ${t.statusCode()}")
  assert(t.body() == "hi", "text body: got '${t.body()}'")
}

// --- the bodyless statuses ------------------------------------------------

test "noContent() is 204 with a zero-length body, and a 304 drops a body that was already set" {
  let n = plainCtx().noContent()
  assert(n.statusCode() == 204, "status: got ${n.statusCode()}")
  assert(len(n.body()) == 0, "204 body must be empty: got '${n.body()}'")

  let m = plainCtx().text("this must never be sent").status(304)
  assert(m.statusCode() == 304, "status: got ${m.statusCode()}")
  assert(len(m.body()) == 0, "304 body must be empty even though one was set: got '${m.body()}'")

  // Same rule reached the other way round: the status first, the body never.
  let s = plainCtx().status(204)
  assert(len(s.body()) == 0, "204 built by status(): got '${s.body()}'")
}

// --- redirect() -----------------------------------------------------------

test "redirect() is 302 with Location set, and .status(301) makes it permanent" {
  let r = plainCtx().redirect("/login")
  assert(r.statusCode() == 302, "default redirect status: got ${r.statusCode()}")
  assert(r.headerValue("Location") == "/login", "Location: got '${r.headerValue("Location")}'")

  let p = plainCtx().redirect("/login").status(301)
  assert(p.statusCode() == 301, "permanent redirect status: got ${p.statusCode()}")
  assert(
    p.headerValue("Location") == "/login",
    "Location survives the status change: got '${p.headerValue("Location")}'",
  )
}

test "testpanic_redirect_refuses_a_javascript_scheme" {
  plainCtx().redirect("javascript:alert(1)")
}

// --- status() and header() ------------------------------------------------

test "testpanic_status_above_the_range" {
  plainCtx().status(600)
}

test "testpanic_status_below_the_range" {
  plainCtx().status(99)
}

test "testpanic_status_on_a_built_response_is_checked_too" {
  plainCtx().text("hi").status(600)
}

test "header() chains, and replaces case-insensitively in place" {
  let r = plainCtx().text("hi").header("X-Trace", "abc").header("X-Extra", "1")
  assert(
    r.headerValue("x-trace") == "abc",
    "case-insensitive read: got '${r.headerValue("x-trace")}'",
  )
  assert(len(r.headerList()) == 3, "Content-Type plus two: got ${len(r.headerList())}")

  let over = plainCtx().text("hi").header("content-type", "text/csv")
  assert(
    over.headerValue("Content-Type") == "text/csv",
    "caller override: got '${over.headerValue("Content-Type")}'",
  )
  assert(
    headerCount(over, "Content-Type") == 1,
    "an override replaces, never appends: got ${headerCount(over, "Content-Type")}",
  )
  assert(
    len(over.headerList()) == 1,
    "no header was added by the override: got ${len(over.headerList())}",
  )
}

test "testpanic_a_header_value_carrying_a_newline_is_refused" {
  plainCtx().text("hi").header("X-Evil", "a\r\nSet-Cookie: sid=stolen")
}

test "testpanic_a_header_name_carrying_a_colon_is_refused" {
  plainCtx().text("hi").header("X: Evil", "1")
}

// --- the session's Set-Cookie (#3947) -------------------------------------

test "a response built on a Ctx whose session is new carries Set-Cookie" {
  let cfg = Config{ secret: "test-secret", sessions: MemoryStore() }
  let req = Request{ method: "GET", path: "/x", headers: "", body: "" }
  let c = newCtx(req, map<string, string>(), newNameRegistry(), cfg, "/x") catch e {
    panic("newCtx: ${e.message()}")
  }
  let s = c.session() catch e {
    panic("session: ${e.message()}")
  }
  assert(s.isNew(), "a request with no cookie must mint a new session")

  let r = c.text("hi")
  assert(
    r.headerValue("Set-Cookie") == s.cookie(),
    "Set-Cookie: got '${r.headerValue("Set-Cookie")}'",
  )
  assert(contains(r.headerValue("Set-Cookie"), s.id()), "the cookie must carry this session's id")
}

test "a response built on a Ctx with no session, or a returning one, carries no Set-Cookie" {
  let cfg = Config{ secret: "test-secret", sessions: MemoryStore() }

  // A request that never asks for a session: nothing is minted, nothing sent.
  let untouched = newCtx(
    Request{ method: "GET", path: "/x", headers: "", body: "" },
    map<string, string>(), newNameRegistry(), cfg, "/x",
  ) catch e {
    panic("newCtx: ${e.message()}")
  }
  assert(
    untouched.text("hi").headerValue("Set-Cookie") == "",
    "a request that never touched the session must not be issued one",
  )

  // A round trip: the second request presents the first's cookie, so its
  // session is not new and the cookie is not re-sent.
  let first = newCtx(
    Request{ method: "GET", path: "/x", headers: "", body: "" },
    map<string, string>(), newNameRegistry(), cfg, "/x",
  ) catch e {
    panic("newCtx: ${e.message()}")
  }
  let s1 = first.session() catch e {
    panic("session: ${e.message()}")
  }
  s1.set("k", "v")
  s1.save() catch e {
    panic("save: ${e.message()}")
  }

  let second = newCtx(
    Request{
      method: "GET",
      path: "/x",
      headers: "Cookie: " + sessionCookieName + "=" + s1.id(),
      body: "",
    },
    map<string, string>(), newNameRegistry(), cfg, "/x",
  ) catch e {
    panic("newCtx: ${e.message()}")
  }
  let s2 = second.session() catch e {
    panic("session: ${e.message()}")
  }
  assert(!s2.isNew(), "a session adopted from a cookie is not new")
  assert(
    second.text("hi").headerValue("Set-Cookie") == "",
    "a returning session must not be re-issued a cookie: got '${second.text("hi").headerValue("Set-Cookie")}'",
  )
}
