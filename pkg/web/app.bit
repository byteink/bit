// pkg/web/app.bit — App, Group and the Routes interface (#3882), plus the
// Group-tree wiring middleware.bit's chain composer needs (#3886): `Ctx`,
// `Res` and the stdlib adapter are still separate tickets (#3883, #3884,
// #3885). This file owns the shell and the one interface the framework has.
//
// `App` is a `Group` with an empty prefix at its root — there is exactly one
// registration path (`Group.register`), never two copies that could drift,
// and `App`'s six `Routes` methods are one-line forwards onto it.
//
// Groups do not own a router: `app.group(...)` returns a `Group` sharing the
// SAME `Router` and `NameRegistry` as the app (both are reference types,
// SPEC §13.3), with its prefix already folded in — one trie, one conflict
// check, exactly the constraint this ticket was filed under.
//
// The name registry cannot be module state (`let S = R{...}` at module scope
// is `E0082, only untraced types may live at module scope`), so it lives on
// the root `Group` and is reached through it — the same seam #3883's `Ctx`
// will use for `c.route(name, args)`.
//
// `join` and `Handler` are already brought into this module by router.bit
// (an import/type alias binds module-wide, not per file — SPEC's own name
// resolution is per module) — reused here, not re-declared.

// The one interface the package has (five granular ones were considered and
// dropped as speculative, per #3875). `App` and `Group` both satisfy it
// structurally — no `implements`, no registration — so a feature writes
// `fn userRoutes(r: Routes, db: Db)` once and it mounts at the root or under
// a group with the feature file untouched.
export interface Routes {
  get(path: string, h: Handler): Route,
  post(path: string, h: Handler): Route,
  put(path: string, h: Handler): Route,
  delete(path: string, h: Handler): Route,
  route(method: string, path: string, h: Handler): Route,
  use(m: Middleware),
  onError(h: ErrorHandler),
  group(prefix: string): Group,
}

// Returned by every registration method so `.name(...)` can chain onto it.
export class Route {
  pattern: string
  registry: NameRegistry

  // Records `n` against this route's fully-prefixed pattern. A duplicate
  // name is not an error here — it is recorded and only surfaces at
  // `freeze()`, exactly like the router's own pattern conflicts
  // (router.bit's `registerHandler`), so one error message can name every
  // offending route instead of failing on whichever happened to register
  // first.
  export name(n: string): Route {
    this.registry.record(n, this.pattern)
    return this
  }
}

// name -> fully-prefixed pattern. `frozen` mirrors `Router.frozen`
// (router.bit) rather than App re-deriving its own copy, so a `.name()`
// call after `listen()` fails exactly like a `get` does — the same silent
// race the router itself guards against.
class NameRegistry {
  names: map<string, string>
  errors: []string
  frozen: bool

  record(name: string, pattern: string) {
    if (this.frozen) {
      panic("web: cannot name '${name}' after listen()")
    }
    let (existing, ok) = this.names[name]
    if (ok) {
      this.errors = append(
        this.errors,
        "duplicate route name '${name}': '${existing}' and '${pattern}'",
      )
      return
    }
    this.names[name] = pattern
  }

  freeze(): ()! {
    this.frozen = true
    if (len(this.errors) > 0) {
      fail newError(join(this.errors, "\n"))
    }
  }

  // The reverse of `record`: the fully-prefixed pattern a name was recorded
  // against. Module-private — this is the seam #3883's `Ctx` reaches
  // through `App` for `c.route(name, args)`; this ticket only proves it
  // records the right value.
  lookup(name: string): string! {
    let (pattern, ok) = this.names[name]
    if (!ok) {
      fail newError("no route named '${name}'")
    }
    return pattern
  }
}

fn newNameRegistry(): NameRegistry {
  return NameRegistry{ names: map<string, string>(), errors: []string(0), frozen: false }
}

// `prefix` carries whatever `joinPath` built for this Group: "" at the root,
// otherwise a leading slash. A trailing slash may survive here when the
// caller wrote one (`group("/")`, `group("/pages/")`) and is insignificant —
// `joinPath` trims it off every read, so "" and "/" are the same root.
//
// `router`, `registry` and `pending` are the SAME objects an `App` and every
// `Group` reached from it share — classes are reference types, so this is
// what makes "one trie, one conflict check" true regardless of how many
// groups a feature nests, and it is exactly what lets middleware.bit's
// `flushPending` reach every route from any one of them.
//
// `ancestors` holds this Group's own lineage, root (empty prefix) first,
// NOT including this Group itself — `Group.group()` appends `this` when it
// builds a child's `ancestors`, and `register()` appends `this` again when
// it builds a route's `chain`. It is read, never flattened, at flush time:
// a `use()` on an ancestor made AFTER this Group (or a route on it) was
// created still applies, because `chain` holds Group REFERENCES and
// `collectMiddleware` (middleware.bit) reads each one's CURRENT
// `.middleware` list, not a snapshot taken here.
export class Group {
  prefix: string
  router: Router
  registry: NameRegistry
  middleware: []Middleware
  ancestors: []Group
  pending: Pending
  // The renderer this scope installs for its own failures and its
  // descendants' (#3950; `ErrorHandler` and the walk that reads this field
  // are errors.bit's). `nil` — a function type's zero value, SPEC 13.4 —
  // means this group installs none and inherits, which is the state every
  // group starts in and the one #3876's negotiated default answers for.
  errorHandler: ErrorHandler

  export get(path: string, h: Handler): Route {
    return this.register("GET", path, h)
  }
  export post(path: string, h: Handler): Route {
    return this.register("POST", path, h)
  }
  export put(path: string, h: Handler): Route {
    return this.register("PUT", path, h)
  }
  export delete(path: string, h: Handler): Route {
    return this.register("DELETE", path, h)
  }

  // The four above cover what an application writes most of the time; this is
  // every other method the framework accepts — `HEAD`, `PATCH` and `OPTIONS`.
  // Without it those three were unregistrable from outside this module, which
  // made `cors()`'s preflight handling unreachable (#3955) and `static()`'s
  // HEAD support reachable only through the module-private `register` (#3954).
  //
  // NOT named `handle`, which is what #4516 asked for: `App.handle(Request)`
  // (below) already owns that name on the type this forwards to, and Bit has
  // no signature-based overloading (SPEC §14.1, E0042) — two `handle` members
  // on `App` is a duplicate declaration, not two overloads.
  export route(method: string, path: string, h: Handler): Route {
    return this.register(method, path, h)
  }

  // Adds `m` to THIS group's middleware, which runs for every ROUTE
  // registered on this group or on a group nested under it — and for
  // nothing else. A request that matches no route matches no group either,
  // so a group's middleware does not see it.
  //
  // `App.use` (below) is the scope that does: it is the root group, and the
  // root chain runs around the framework's own 404/405 as well (#4515). The
  // asymmetry is deliberate and is the whole difference between "every
  // request reaching this app" and "every route under this prefix".
  export use(m: Middleware) {
    if (this.router.frozen) {
      panic("web: cannot use() after listen()")
    }
    this.middleware = append(this.middleware, m)
  }

  // Installs this scope's error renderer, replacing #3876's Accept
  // negotiation for every route on this group and on every group nested
  // under it. The handler decides the body; the framework still sets the
  // status, and the handler NEVER sees an error that did not satisfy
  // `HttpError` — `mappedRes` (errors.bit) hands it a value built from the
  // mapping alone.
  //
  // Both refusals abort at REGISTRATION rather than on the response path,
  // the posture `use()` above and `httpError`'s status range (errors.bit)
  // already take: a second handler on one group and a handler installed
  // after `listen()` are programming errors with no correct recovery, and a
  // request is the wrong place to find out about either.
  export onError(h: ErrorHandler) {
    if (this.router.frozen) {
      panic("web: cannot onError() after listen()")
    }
    if (this.errorHandler != nil) {
      panic("web: onError() is already installed on the group '${this.prefix}'")
    }
    this.errorHandler = h
  }

  export group(prefix: string): Group {
    if (this.router.frozen) {
      panic("web: cannot group() after listen()")
    }
    return Group{
      prefix: joinPath(this.prefix, prefix),
      router: this.router,
      registry: this.registry,
      middleware: []Middleware(0),
      ancestors: append(this.ancestors, this),
      pending: this.pending,
      errorHandler: nil,
    }
  }

  // Does NOT call `router.add()` — that would fix the route's middleware
  // chain to whatever this Group's (and its ancestors') `.middleware`
  // lists hold RIGHT NOW, breaking a `use()` that arrives later on the
  // same scope. Instead it records a `PendingRoute` (middleware.bit) that
  // `App.listen()` resolves exactly once, after every `use()` anywhere in
  // the tree is guaranteed to have already happened (a later one panics).
  register(method: string, path: string, h: Handler): Route {
    if (!isKnownMethod(method)) {
      let known = join(knownMethods(), ", ")
      panic("web: cannot register '${method}' ${path}: unknown HTTP method (want one of ${known})")
    }
    if (this.router.frozen) {
      panic("web: cannot register ${method} ${path} after listen()")
    }
    let full = joinPath(this.prefix, path)
    let chain = append(this.ancestors, this)
    this.pending.routes = append(
      this.pending.routes,
      PendingRoute{ method: method, pattern: full, handler: h, chain: chain },
    )
    return Route{ pattern: full, registry: this.registry }
  }
}

// What `App.init` panics with when the app handed over no signing key
// (#4474). It is a `const` rather than a literal at the panic site so a test
// can assert what the message names: `testpanic_` inverts a test's verdict
// (SPEC §18.4) but cannot see the text, and this package has no way to read a
// dead child's output.
const secretRequiredMessage = "web: Config.secret is empty — set it to a " +
  "high-entropy value the app reads from its own environment, for example " +
  "`App(Config{ secret: mustEnv(\"APP_SECRET\") })`. The framework reads no " +
  "env var and opens no file, so this value can only come from the app."

// The framework's entry point: a `Group` at the root (empty prefix), plus
// the three members #3885 added — `freeze()` (close the route table),
// `handle()` (one request in, one response out, in process) and `listen()`
// (freeze, then serve `handle` on a socket).
export class App {
  root: Group

  // The settings the app handed over (config.bit, #3946). Held, never
  // re-read from anywhere else: the framework opens no file and reads no
  // env var, so this object is the only place a setting can come from.
  export config: Config

  // The root middleware chain composed around the framework's own 404/405
  // (`missHandlerFor`, middleware.bit) — built once here and once more at
  // `freeze()`, never per request. Composed in `init` as well so the field is
  // never `nil`: `handle()` before `freeze()` then answers a 404 instead of
  // calling a nil function, and the request path carries no "is it composed
  // yet" branch.
  missHandler: Handler

  init(config: Config) {
    // First thing, before any of the app's own registration runs: #3946 gave
    // `secret` no default, but a `string` field's zero value is `""` (SPEC
    // §13.4), so `App(Config{})` would otherwise build an app whose CSRF
    // tokens are signed under an empty key. The only genuinely mandatory
    // field kind is a class-typed one, which can carry no default at all —
    // so "required" is not something the type expresses here, and this is
    // where it actually lives.
    //
    // A panic rather than a fallible `init`: an app that forgot its signing
    // key is a programming error at startup, the same class as `use()` after
    // `listen()`, not a runtime condition the caller could answer. Demanded
    // at construction rather than at the point csrf.bit first reads it, so
    // the failure names the line that built the app.
    if (len(config.secret) == 0) {
      panic(secretRequiredMessage)
    }
    this.config = config
    this.root = Group{
      prefix: "",
      router: Router(),
      registry: newNameRegistry(),
      middleware: []Middleware(0),
      ancestors: []Group(0),
      pending: newPending(),
      errorHandler: nil,
    }
    this.missHandler = missHandlerFor(this.root)
  }

  export get(path: string, h: Handler): Route {
    return this.root.get(path, h)
  }
  export post(path: string, h: Handler): Route {
    return this.root.post(path, h)
  }
  export put(path: string, h: Handler): Route {
    return this.root.put(path, h)
  }
  export delete(path: string, h: Handler): Route {
    return this.root.delete(path, h)
  }
  export route(method: string, path: string, h: Handler): Route {
    return this.root.route(method, path, h)
  }
  // Middleware for EVERY request this app answers, including one for a path
  // no route matches: the root chain is composed around the framework's own
  // 404/405 too (#4515), so a middleware here can log the miss, act on it, or
  // answer it instead — which is what makes `app.use(static("/assets",
  // "./public"))` serve a file with no route registered under the mount.
  //
  // A middleware that calls `next(c)` on a miss gets the 404 (or 405, with
  // its `Allow`) back from `next` and may act on it like any other response.
  // A group's `use()` is narrower on purpose: see `Group.use` above.
  export use(m: Middleware) {
    this.root.use(m)
  }
  export onError(h: ErrorHandler) {
    this.root.onError(h)
  }
  export group(prefix: string): Group {
    return this.root.group(prefix)
  }

  // Resolves every pending route's middleware chain (`flushPending`,
  // middleware.bit — built exactly once, here, never per request), THEN
  // freezes the route table and the name registry. A registration call
  // after this fails loudly (`panic`, from `Group.register`/`use`/`group`
  // and `NameRegistry.record`) rather than silently racing a served
  // request.
  //
  // Separate from `listen()`, which is this plus a socket: `handle()` needs
  // the route table closed and a test needs to close it without binding a
  // port. A conflicting pattern or a duplicate route name fails HERE, which
  // is what makes `listen()` fail before it can serve anything.
  // `missHandler` is recomposed HERE, from the same lists and at the same
  // moment `flushPending` composes every route's chain, so a `use()` or an
  // `onError()` that arrived after a route was registered reaches the miss
  // path exactly as it reaches the routes.
  export freeze(): ()! {
    flushPending(this.root.router, this.root.pending)
    this.missHandler = missHandlerFor(this.root)
    this.root.router.freeze()?
    this.root.registry.freeze()?
  }

  // The in-process seam (#3885): one request in, one response out, through
  // the real router, the real middleware chain, the real `Ctx` and the real
  // failure mapping — everything `listen()` does except the socket. The
  // whole body is in `dispatch` (adapter.bit) so that this and the served
  // path cannot be two implementations.
  export handle(req: Request): Response {
    return dispatch(this, req)
  }

  // The exact function value `listen()` hands to `listenAndServe`. Exposed
  // so a test can call it and compare, response field by response field,
  // against `handle()` on the same request — the served path proven to be
  // the tested path by exercise rather than by reading the source.
  export serveHandler(): (Request) => Response {
    return serveHandlerFor(this)
  }

  // Freeze, then serve `config.host:config.port` forever. Returns only on a
  // bind or accept error — or immediately, without binding anything, when
  // `freeze()` rejects the route table.
  //
  // There is deliberately nothing else in this body: no second request path,
  // no per-request work, no error mapping. Everything a request meets is
  // behind `handle()`, and `serveHandler()` is the only thing passed here.
  export listen(): ()! {
    this.freeze()?
    listenAndServe(this.config.host, this.config.port, this.serveHandler())?
  }
}

// The methods a route may be registered for. RFC 9110 §9.3's eight, minus
// `CONNECT` and `TRACE`: neither is a method an application route answers
// (`CONNECT` is a proxy tunnel, `TRACE` a request reflector), and making
// either reachable from a handler is a hole rather than a feature.
//
// A method outside this list is a typo — `"Get"`, `"POST "`, `"GTE"` — and
// `Router.lookup` matches by exact string equality, so it would register a
// route no request can ever reach. `register` panics on it at REGISTRATION,
// which is startup, rather than leaving a silent 404 to be found in
// production.
//
// A function, not a module-scope binding: a traced value may not live at
// module scope (E0082). It is read by both `isKnownMethod` and the panic
// message, so the check and what it tells you cannot drift.
fn knownMethods(): []string {
  return []string{ "GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" }
}

fn isKnownMethod(method: string): bool {
  for m of knownMethods() {
    if (m == method) {
      return true
    }
  }
  return false
}

// Joins a group prefix ("", or a leading slash with an insignificant
// trailing one) with a path/sub-prefix that may or may not have a leading
// slash, producing something that always does and never ends in a trailing
// one — except the root itself, "/". The prefix's trailing slash is trimmed;
// the path's is not, because `router.bit`'s `splitSegments` makes a trailing
// slash on a registered pattern significant.
fn joinPath(prefix: string, path: string): string {
  let p = trimTrailingSlash(prefix)
  let s = path
  if (len(s) == 0 || s[0] != '/') {
    s = "/" + s
  }
  if (p == "") {
    return s
  }
  if (s == "/") {
    return p
  }
  return p + s
}

// Applied to the PREFIX side only, where a trailing slash is never
// significant: "/" and "" are both the root, and "/pages/" is the same group
// as "/pages". "/" therefore trims to "", the empty root prefix — it is not
// the special case its own length guard used to make it, and keeping it
// whole is what made `app.group("/")` register "//save" (#4482). The root
// ROUTE "/" is unaffected: `joinPath` never trims its `path` argument.
fn trimTrailingSlash(s: string): string {
  if (len(s) > 0 && s[len(s) - 1] == '/') {
    return s[0:len(s) - 1]
  }
  return s
}
