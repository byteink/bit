// pkg/web/staticrange.test.bit — #6074's acceptance: `Range`/`If-Range` on
// `static()` (RFC 9110 §14) and the `fileRes()` helper, split out of
// static.test.bit to keep that file under the 800-line ceiling
// (spec/LINT.md §4) — a pure move, no behavior change.
//
// `newStaticFixture`, `cssBody`, `staticReq`, `writeFixture`, `mustMkdir`,
// `scratchDir`, `nodeTestTeardown`, `freezeOrPanic`, `App`, `Config`,
// `sampleHttpDate` and `fileRes` are all bound module-wide already (SPEC
// §17.1) — reused from static.bit/static.test.bit/node.test.bit/
// adapter.test.bit, never re-imported (E0042).

// --- Range requests (#6074, RFC 9110 §14) -----------------------------------

const bigFileLen = 100_000

// Byte `i` is `'0' + i % 10` (48 is ASCII `'0'`) — deterministic and
// independently computable at any offset, so `range-large` below can assert
// on a span pulled from the END of a 100000-byte file against `content`'s
// own slice, with no separately-maintained "expected bytes" copy to drift.
fn bigFileContent(): string {
  let buf = []byte(bigFileLen)
  let i = 0
  while (i < bigFileLen) {
    buf[i] = byte(48 + i % 10)
    i = i + 1
  }
  return string(buf)
}

test "a single Range request returns 206 with Content-Range and exactly the requested bytes" {
  let f = newStaticFixture("range-single")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", "Range: bytes=0-3"))

  assert(res.status == 206, "want 206, got ${res.status}")
  assert(res.body == cssBody[0:4], "want '${cssBody[0:4]}', got '${res.body}'")
  assert(
    res.getHeader("Content-Range") == "bytes 0-3/${len(cssBody)}",
    "Content-Range: got '${res.getHeader("Content-Range")}'",
  )
  assert(
    res.getHeader("Accept-Ranges") == "bytes",
    "Accept-Ranges: got '${res.getHeader("Accept-Ranges")}'",
  )
  nodeTestTeardown(f.dir)
}

test "an open-ended range serves from the start byte to the end of the file" {
  let f = newStaticFixture("range-open")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", "Range: bytes=5-"))

  let want = cssBody[5:len(cssBody)]
  assert(res.status == 206, "want 206, got ${res.status}")
  assert(res.body == want, "want '${want}', got '${res.body}'")
  assert(
    res.getHeader("Content-Range") == "bytes 5-${len(cssBody) - 1}/${len(cssBody)}",
    "Content-Range: got '${res.getHeader("Content-Range")}'",
  )
  nodeTestTeardown(f.dir)
}

test "a suffix range serves the last N bytes of the file" {
  let f = newStaticFixture("range-suffix")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", "Range: bytes=-4"))

  let want = cssBody[len(cssBody) - 4:len(cssBody)]
  assert(res.status == 206, "want 206, got ${res.status}")
  assert(res.body == want, "want '${want}', got '${res.body}'")
  nodeTestTeardown(f.dir)
}

test "a range past the end of the file is 416 with Content-Range naming the full size" {
  let f = newStaticFixture("range-unsatisfiable")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", "Range: bytes=1000-2000"))

  assert(res.status == 416, "want 416, got ${res.status}")
  assert(res.body == "", "a 416 must carry no body, got '${res.body}'")
  assert(
    res.getHeader("Content-Range") == "bytes */${len(cssBody)}",
    "Content-Range: got '${res.getHeader("Content-Range")}'",
  )
  nodeTestTeardown(f.dir)
}

test "a malformed Range header is ignored and the full file is served" {
  let f = newStaticFixture("range-malformed")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", "Range: bytes=abc"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
  nodeTestTeardown(f.dir)
}

test "a request naming more than one range falls back to a full 200" {
  let f = newStaticFixture("range-multi")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", "Range: bytes=0-1,3-4"))

  assert(
    res.status == 200,
    "want 200 (documented multipart/byteranges fallback), got ${res.status}",
  )
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
  nodeTestTeardown(f.dir)
}

test "Accept-Ranges is advertised on a plain 200, a 304 and a HEAD" {
  let f = newStaticFixture("accept-ranges")
  let first = f.app.handle(staticReq("GET", "/assets/app.css", ""))
  let etag = first.getHeader("ETag")

  let notModified = f.app.handle(staticReq("GET", "/assets/app.css", "If-None-Match: ${etag}"))
  let head = f.app.handle(staticReq("HEAD", "/assets/app.css", ""))

  assert(
    first.getHeader("Accept-Ranges") == "bytes",
    "200: got '${first.getHeader("Accept-Ranges")}'",
  )
  assert(
    notModified.getHeader("Accept-Ranges") == "bytes",
    "304: got '${notModified.getHeader("Accept-Ranges")}'",
  )
  assert(
    head.getHeader("Accept-Ranges") == "bytes",
    "HEAD: got '${head.getHeader("Accept-Ranges")}'",
  )
  nodeTestTeardown(f.dir)
}

test "If-Range with the current ETag honours the Range; a stale one serves the full file" {
  let f = newStaticFixture("if-range-etag")
  let first = f.app.handle(staticReq("GET", "/assets/app.css", ""))
  let etag = first.getHeader("ETag")

  let fresh = f.app.handle(
    staticReq("GET", "/assets/app.css", "Range: bytes=0-3\r\nIf-Range: ${etag}"),
  )
  let stale = f.app.handle(
    staticReq("GET", "/assets/app.css", "Range: bytes=0-3\r\nIf-Range: \"stale\""),
  )

  assert(fresh.status == 206, "a matching If-Range must honour Range, got ${fresh.status}")
  assert(fresh.body == cssBody[0:4], "want '${cssBody[0:4]}', got '${fresh.body}'")
  assert(stale.status == 200, "a stale If-Range must serve the whole file, got ${stale.status}")
  assert(stale.body == cssBody, "want the file's bytes, got '${stale.body}'")
  nodeTestTeardown(f.dir)
}

test "If-Range with the current Last-Modified honours the Range; an older date serves the full file" {
  let f = newStaticFixture("if-range-date")
  let first = f.app.handle(staticReq("GET", "/assets/app.css", ""))
  let lastMod = first.getHeader("Last-Modified")

  let fresh = f.app.handle(
    staticReq("GET", "/assets/app.css", "Range: bytes=0-3\r\nIf-Range: ${lastMod}"),
  )
  let older = f.app.handle(
    staticReq("GET", "/assets/app.css", "Range: bytes=0-3\r\nIf-Range: ${sampleHttpDate}"),
  )

  assert(fresh.status == 206, "the file's own Last-Modified must honour Range, got ${fresh.status}")
  assert(older.status == 200, "an older date must serve the whole file, got ${older.status}")
  assert(older.body == cssBody, "want the file's bytes, got '${older.body}'")
  nodeTestTeardown(f.dir)
}

test "a ranged request against a large file reads only the requested span, not the whole file" {
  let f = newStaticFixture("range-large")
  let bigPath = "${f.root}/big.bin"
  let content = bigFileContent()
  writeFixture(bigPath, content)

  let start = bigFileLen - 100
  let res = f.app.handle(
    staticReq("GET", "/assets/big.bin", "Range: bytes=${start}-${bigFileLen - 1}"),
  )

  assert(res.status == 206, "want 206, got ${res.status}")
  assert(len(res.body) == 100, "want exactly 100 bytes, got ${len(res.body)}")
  assert(
    res.body == content[start:bigFileLen],
    "the range's bytes did not match the source file at that offset",
  )
  nodeTestTeardown(f.dir)
}

// --- fileRes() (#6074, course part 20) --------------------------------------

fn fileResApp(path: string): App {
  let app = App(Config{ secret = "test-secret" })
  let _ = app.get("/file", (c) => fileRes(path, c))
  freezeOrPanic(app)
  return app
}

test "fileRes serves a specific path directly, with the same Range support as static()" {
  let dir = scratchDir("fileres")
  mustMkdir(dir)
  let path = "${dir}/report.txt"
  writeFixture(path, cssBody)
  let app = fileResApp(path)

  let whole = app.handle(staticReq("GET", "/file", ""))
  let ranged = app.handle(staticReq("GET", "/file", "Range: bytes=0-3"))

  assert(whole.status == 200, "want 200, got ${whole.status}")
  assert(whole.body == cssBody, "want the file's bytes, got '${whole.body}'")
  assert(ranged.status == 206, "want 206, got ${ranged.status}")
  assert(ranged.body == cssBody[0:4], "want '${cssBody[0:4]}', got '${ranged.body}'")
  nodeTestTeardown(dir)
}

test "fileRes on a missing path fails the handler, mapped to the framework's 500" {
  let dir = scratchDir("fileres-missing")
  mustMkdir(dir)
  let app = fileResApp("${dir}/nope.txt")

  let res = app.handle(staticReq("GET", "/file", ""))

  assert(res.status == 500, "want 500, got ${res.status}")
  nodeTestTeardown(dir)
}
