@table("audit_logs") class AuditLog {
  id: i64,
  actorId: i64,
  action: string,
  target: string,
  createdAt: i64,
}

// Use the mutation's transaction so neither record can commit alone.
fn recordAudit(tx: TxHandle, actorId: i64, action: string, target: string): ()! {
  tx.table<AuditLog>().insert(
    AuditLog{ id = 0, actorId = actorId, action = action, target = target, createdAt = now().ns },
  )?
}
