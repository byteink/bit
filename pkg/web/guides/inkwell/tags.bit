// pkg/web/guides/inkwell/tags.bit — the `Tag` entity, its list/create
// routes, and `findOrCreateTag`, the helper articles.bit's transactional
// create calls for each tag name a new article names (#6062, epic #6061,
// course parts 9 "Relationships" and 15 "Transactions").
import { Dir } from "orm"

@table("tags") class Tag {
  id: i64,
  name: string,
}

// Idempotent: a race with another request inserting the same name is
// resolved by re-reading it, never by letting the unique-constraint error
// surface — `link()`/`unlink()` (pkg/orm/docs/manytomany.md) already
// document this "insert, or read what is already there" shape for the join
// table; this is the same shape one level up, for the tag row itself.
// Takes `tx: TxHandle`, not `Db`: articles.bit's `insertArticle` calls this
// from inside `db.tx(...)`, the one transactional caller (course part 15).
// `createTagDirect` below is the identical body over `Db` instead of
// `TxHandle` for tags.bit's own, non-transactional `POST /tags` — `Repo<T>`
// and `TxRepo<T>` are distinct declared types (txrepo.bit's own header), so
// nothing shorter expresses "works over either handle" today.
export fn findOrCreateTag(tx: TxHandle, name: string): Tag! {
  let tags = tx.table<Tag>()
  let found = tags.where("name", name).first()?
  if (isSome(found)) {
    return unwrap(found)
  }
  return tags.insert(Tag{ id = 0, name = name }) catch e {
    let cause = classify(e, "tags")
    let (_, ok) = cause.(UniqueViolation)
    if (ok) {
      return unwrap(tags.where("name", name).first()?)
    }
    fail cause
  }
}

fn createTagDirect(db: Db, name: string): Tag! {
  let tags = db.table<Tag>()
  let found = tags.where("name", name).first()?
  if (isSome(found)) {
    return unwrap(found)
  }
  return tags.insert(Tag{ id = 0, name = name }) catch e {
    let cause = classify(e, "tags")
    let (_, ok) = cause.(UniqueViolation)
    if (ok) {
      return unwrap(tags.where("name", name).first()?)
    }
    fail cause
  }
}

@json class TagView {
  id: i64,
  name: string,
}

fn toTagView(t: Tag): TagView {
  return TagView{ id = t.id, name = t.name }
}

fn listTags(c: Ctx, db: Db): Res! {
  let all = db.table<Tag>().orderBy("name", Dir.Asc).all()?
  let out = []TagView(0)
  for t of all {
    out = append(out, toTagView(t))
  }
  return c.jsonList(out)
}

export @json class CreateTagInput {
  @minLen(1)
  name: string
}

fn createTag(c: Ctx, db: Db): Res! {
  requireAdmin(c)?
  let input = c.body<CreateTagInput>()?
  let t = createTagDirect(db, input.name)?
  return c.created("${t.id}")
}

export fn mountTags(app: App, db: Db) {
  let group = app.group("/tags")
  group.get("/", (c) => listTags(c, db))
  group.post("/", (c) => createTag(c, db))
}
