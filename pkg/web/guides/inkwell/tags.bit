// pkg/web/guides/inkwell/tags.bit — the `Tag` entity, its list/create
// routes, and `findOrCreateTag`, the helper articles.bit's transactional
// create calls for each tag name a new article names (#6062, epic #6061,
// course parts 9 "Relationships" and 15 "Transactions").
import { Dir } from "orm"

@table class Tag {
  @id
  id: i64
  name: string
}

fn tagPlaceholder(): Tag {
  return Tag{ id = 0, name = "" }
}

export fn tagDesc(): TableDesc {
  return TableDesc{ table = "tags", fields = tagPlaceholder().tableDescriptor(), classAttrs = []AttrDesc(0) }
}

export fn tagValues(t: Tag): map<string, Value> {
  return map<string, Value>{ "id": Value.Int(t.id), "name": Value.Text(t.name) }
}

fn tagMapper(rows: Rows): Tag! {
  let cols = rows.columns()
  return Tag{ id = sqlReqInt(rows, cols, "id")?, name = sqlReqText(rows, cols, "name")? }
}

export fn tags(db: Data): Query<Tag> {
  return find<Tag>(db, "tags", tagDesc().fields, tagMapper)
}

export fn findTagByName(db: Data, name: string): Tag! {
  return tags(db).where("name", Value.Text(name)).oneOrFail()?
}

// Idempotent: a race with another request inserting the same name is
// resolved by re-reading it, never by letting the unique-constraint error
// surface — `attach`/`sync` (pkg/orm/docs/manytomany.md) already document
// this "insert, or read what is already there" shape for the join table;
// this is the same shape one level up, for the tag row itself.
export fn findOrCreateTag(db: Data, name: string): Tag! {
  return findTagByName(db, name) catch _ {
    // Uses `insertGeneratedId` (db.bit), not `save()` — see that helper's
    // own comment for why `save()` cannot insert into an `@id`-keyed table
    // on Postgres today (#6088).
    insertGeneratedId(db, "tags", ["name"], [Value.Text(name)]) catch e {
      let cause = classify(e, "tags")
      let (_, ok) = cause.(UniqueViolation)
      if (ok) {
        return findTagByName(db, name)?
      }
      fail cause
    }
    return findTagByName(db, name)?
  }
}

@json class TagView {
  id: i64,
  name: string,
}

fn toTagView(t: Tag): TagView {
  return TagView{ id = t.id, name = t.name }
}

fn listTags(c: Ctx, db: Data): Res! {
  let all = tags(db).orderBy("name", Dir.Asc).all()?
  let out = []TagView(0)
  for t of all {
    out = append(out, toTagView(t))
  }
  return c.jsonList(out)
}

export @json class CreateTagInput {
  @minLen(1)
  name: string
}

fn createTag(c: Ctx, db: Data): Res! {
  requireAdmin(c)?
  let input = c.body<CreateTagInput>()?
  let t = findOrCreateTag(db, input.name)?
  return c.created("${t.id}")
}

export fn mountTags(app: App, db: Data) {
  let group = app.group("/tags")
  group.get("/", (c) => listTags(c, db))
  group.post("/", (c) => createTag(c, db))
}
