// pkg/web/guides/inkwell/config.bit — Inkwell's own settings, read from the
// environment ONCE, at startup (#6062, epic #6061, course part 5:
// "Configuration"). `pkg/web`'s own `Config` (docs/configuration.md) opens
// no file and reads no env var itself; this is the one place Inkwell reads
// one, and every other file takes the resulting `AppConfig` as a plain
// value instead of calling `env()` again.
import { env, envOr } from "std/os"
import { parseInt } from "std/strings"

// What main.bit hands to db.bit (the pool), auth.bit (the session secret)
// and pkg/web's own `Config`. One struct, built once, so a part of the app
// that needs a setting takes `AppConfig` rather than reaching for `env()`
// on its own — the same discipline pkg/web's `Config` documents for the
// framework itself.
export class AppConfig {
  export databaseUrl: string,
  export redisUrl: string,
  export secret: string,
  export host: string,
  export port: int,
  // #6131: a secret dedicated to signing/verifying JWT bearer tokens,
  // separate from `secret` (pkg/web's session-cookie key) — the two protect
  // different things and reusing one HMAC key for both is a key-reuse
  // smell this app should not teach.
  export jwtSecret: string,
  export jwtIssuer: string,
  export jwtAudience: string,
  // #6131: Sign in with Google — all three empty (the default) means the
  // feature is disabled; `auth.bit`'s `googleConfigured` is the one place
  // that reads these three together.
  export googleClientId: string,
  export googleClientSecret: string,
  export googleRedirectUrl: string,
  export s3Endpoint: string,
  export s3Region: string,
  export s3Bucket: string,
  export s3AccessKeyId: string,
  export s3SecretKey: string,
  // Empty host/from disables mail. Remote submission verifies implicit TLS;
  // only an explicit loopback relay uses cleartext for local development.
  export smtpHost: string = "",
  export smtpPort: int = 465,
  export smtpFrom: string = "",
}

// Fails loudly, naming the variable, rather than building an app whose
// database URL or session secret is `""` — the same posture `pkg/web`'s
// `App.init` takes for `Config.secret` (pkg/web/app.bit).
fn mustEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("inkwell: ${name} is not set — export it before starting the app")
  }
  return v
}

export fn loadConfig(): AppConfig! {
  let databaseUrl = mustEnv("DATABASE_URL")?
  let secret = mustEnv("APP_SECRET")?
  let redisUrl = mustEnv("REDIS_URL")?
  let host = envOr("HOST", "127.0.0.1")
  let port = parseInt(envOr("PORT", "8080"))?
  let jwtSecret = mustEnv("JWT_SECRET")?
  let jwtIssuer = mustEnv("JWT_ISSUER")?
  let jwtAudience = mustEnv("JWT_AUDIENCE")?
  return AppConfig{
    databaseUrl = databaseUrl, redisUrl = redisUrl, secret = secret, host = host, port = port, jwtSecret = jwtSecret,
    jwtIssuer = jwtIssuer, jwtAudience = jwtAudience,
    googleClientId = envOr("GOOGLE_CLIENT_ID", ""), googleClientSecret = envOr(
      "GOOGLE_CLIENT_SECRET",
      "",
    ), googleRedirectUrl = envOr("GOOGLE_REDIRECT_URL", ""),
    s3Endpoint = envOr("S3_ENDPOINT", ""), s3Region = envOr("S3_REGION", "us-east-1"),
    s3Bucket = envOr("S3_BUCKET", ""), s3AccessKeyId = envOr("S3_ACCESS_KEY_ID", ""),
    s3SecretKey = envOr("S3_SECRET_KEY", ""),
    smtpHost = envOr("SMTP_HOST", ""), smtpPort = parseInt(envOr("SMTP_PORT", "465"))?,
    smtpFrom = envOr("SMTP_FROM", ""),
  }
}
