// pkg/web/guides/inkwell/migrations/2026_01_01_000005_create_article_tags.bit
// — the `article_tags` join table (#6062, epic #6061, course part 9
// "Relationships"). Was `db.bit`'s `createArticleTags` class — see
// 2026_01_01_000001_create_users.bit's header for the O6 (#6315) move.
//
// `articleTagsDesc` is private to this file: `Article.tags`'s own
// `@manyToMany("article_tags")` mark (articles.bit) names the join table
// and both key columns directly, compiled into `__linkRelation` — nothing
// else in the app builds this shape by hand, so this description is only
// ever read by `manyToManyTable` below, once, at migration time.
//
// The join table's own DDL is built by `manyToManyTable` rather than
// `s.create(...)`, since it already returns a full `SchemaOp` — `Schema.
// ops` stays `export` exactly so a prebuilt op like this one can be
// appended directly (migration.bit's own header). There is no revert: the
// prior registry's own `revert = () => []SchemaOp(0)` carries forward
// unchanged.
import { ManyToManyDesc, Schema, manyToManyTable } from "orm"

fn articleTagsDesc(): ManyToManyDesc {
  return ManyToManyDesc{
    joinTable = "article_tags", ownerColumn = "article_id", ownerTable = "articles",
    ownerIdColumn = "id", targetColumn = "tag_id", targetTable = "tags", targetIdColumn = "id",
  }
}

export class CreateArticleTags {
  up(s: Schema): ()! {
    s.ops = append(s.ops, manyToManyTable(articleTagsDesc()))
  }

  down(s: Schema): ()! {}
}
