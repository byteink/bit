// pkg/web/guides/inkwell/migrations/2026_01_06_000001_create_idempotency_keys.bit
// — course part 40 (#6133): the `bit_idempotency` table behind pkg/web's
// `SqlIdempotencyStore`, which keeps the `Idempotency-Key` reservations and
// cached responses of `POST /articles` and `POST /comments`.
//
// THE PACKAGE'S OWN DDL, NOT A COPY OF IT. `sqlIdempotencyMigration` is the
// statement list the store's live tests run against PostgreSQL and MySQL;
// the schema builder has no `bytea` or `timestamptz` column, so this
// migration hands those statements to `AlterTable.raw` (schema.bit's
// deliberate escape hatch) instead of retyping them here where they could
// drift from what the store reads and writes. A table with no builder ops
// renders only its raw statements, which is all this needs.
import { Schema } from "orm"
import { IdempotencyDialect, sqlIdempotencyMigration } from "web"

export class CreateIdempotencyKeys {
  up(s: Schema): ()! {
    s.table("bit_idempotency", (t) => {
      for stmt of sqlIdempotencyMigration(IdempotencyDialect.Postgres) {
        t.raw(stmt)
      }
    })?
  }

  down(s: Schema): ()! {
    s.table("bit_idempotency", (t) => {
      t.raw("drop table if exists bit_idempotency")
    })?
  }
}
