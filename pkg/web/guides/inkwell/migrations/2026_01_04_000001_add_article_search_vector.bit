// pkg/web/guides/inkwell/migrations/2026_01_04_000001_add_article_search_vector.bit
// — #6129: the full-text search column and its GIN index for
// `articles.bit`'s `searchArticles`. Was `db.bit`'s
// `ensureArticleSearchIndex`, run as raw SQL on every boot through the old
// second connection — see 2026_01_01_000001_create_users.bit's header for
// the O6 (#6315) move; now a real, rollback-able migration step.
//
// RAW SQL, NOT THE SCHEMA DSL'S `t.tsvector`/`t.indexExpr` — this migration
// keeps the exact DDL the old boot-time code ran (`IF NOT EXISTS` on both
// statements, so a re-run stays a no-op the same way it always was); moving
// to the builder's own tsvector/GIN helpers is a behaviour change (a
// different `to_tsvector` weighting) out of this ticket's scope. `t.raw`
// is `AlterTable`'s deliberate escape hatch (schema.bit's own header) for
// exactly this: a generated column and a `using gin` index, neither of
// which the builder's plain column/index methods reach.
import { Schema } from "orm"

export class AddArticleSearchVector {
  up(s: Schema): ()! {
    s.table("articles", (t) => {
      t.raw(
        "alter table articles add column if not exists search_vector tsvector generated always as (to_tsvector('english', coalesce(title, '') || ' ' || coalesce(body, ''))) stored",
      )
      t.raw(
        "create index if not exists articles_search_vector_idx on articles using gin (search_vector)",
      )
    })?
  }

  down(s: Schema): ()! {
    s.table("articles", (t) => {
      t.raw("drop index if exists articles_search_vector_idx")
      t.raw("alter table articles drop column if exists search_vector")
    })?
  }
}
