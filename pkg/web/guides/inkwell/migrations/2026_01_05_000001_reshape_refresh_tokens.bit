// pkg/web/guides/inkwell/migrations/2026_01_05_000001_reshape_refresh_tokens.bit
// — #7234: `refresh_tokens` becomes the table behind pkg/auth's
// `RefreshStore` (`OrmRefreshStore`, auth.bit), one row per
// `RefreshRecord` (pkg/auth/refresh.bit).
//
// DROP AND CREATE, NOT ALTER. The old rows carry no `family`, so none of
// them can be rotated, revoked or reuse-checked by the new code; a token
// that could never be refreshed again is the same as no token, and the
// holders sign in once more. The table is also small and short-lived by
// design (30 days), so there is nothing worth carrying across.
//
// Columns are `RefreshRow`'s fields (auth.bit): `token_hash` is the SHA-256
// hex of the token, unique, which is how `findByHash` and `rotate` find a
// row; `family` is indexed because `revokeFamily` updates by it, and
// `subject` because `revokeSubject` does. `rotated_at` is `0` until the
// token is exchanged, `revoked` is `0`/`1`, and `data` is whatever `issue`
// was given. There is no foreign key to `users`: `subject` is a string the
// package owns, not a user id column.
import { ReferentialAction, Schema } from "orm"

export class ReshapeRefreshTokens {
  up(s: Schema): ()! {
    s.drop("refresh_tokens")?
    s.create("refresh_tokens", (t) => {
      t.id("id")
      t.string("token_hash", 64).unique()
      t.string("family", 64)
      t.string("subject", 64)
      t.int("expires_at")
      t.int("family_expires_at")
      t.int("rotated_at")
      t.int("revoked")
      t.text("data")
      t.index("family")
      t.index("subject")
    })?
  }

  down(s: Schema): ()! {
    s.drop("refresh_tokens")?
    s.create("refresh_tokens", (t) => {
      t.id("id")
      t.int("user_id")
      t.string("token_hash", 64).unique()
      t.int("expires_at")
      t.int("rotated")
      t.int("created_at")
      t.index("user_id")
      t.foreign("user_id").references("users", "id").onDelete(ReferentialAction.Cascade)
    })?
  }
}
