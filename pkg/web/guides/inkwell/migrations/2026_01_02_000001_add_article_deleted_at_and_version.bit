// pkg/web/guides/inkwell/migrations/2026_01_02_000001_add_article_deleted_at_and_version.bit
// — #6129: `deleted_at`/`version` back `articles.bit`'s `@softDelete`/
// `@version` marks on `Article`. Was `db.bit`'s
// `addArticleDeletedAtAndVersion` class — see
// 2026_01_01_000001_create_users.bit's header for the O6 (#6315) move.
//
// Added on an empty `articles` table (no prior migration ever inserts a
// row), so a `NOT NULL` `version` with no default is safe here the same
// way `2026_01_01_000002_create_articles.bit`'s own `t.id("id")` is;
// `deleted_at` stays nullable, unset for every existing row. An `int`
// column, not `timestamp` — `Repo<T>.delete()` (pkg/orm/repo.bit) writes
// `deletedAt` as epoch nanoseconds via `sqlValue(now().ns)`, the same
// convention `created_at`/`updated_at` already use here; a native
// `timestamp` column rejects that value outright (Postgres 22008,
// "date/time field value out of range").
import { Schema } from "orm"

export class AddArticleDeletedAtAndVersion {
  up(s: Schema): ()! {
    s.table("articles", (t) => {
      t.int("deleted_at").nullable()
      t.int("version")
    })?
  }

  down(s: Schema): ()! {
    s.table("articles", (t) => {
      t.dropColumn("deleted_at")
      t.dropColumn("version")
    })?
  }
}
