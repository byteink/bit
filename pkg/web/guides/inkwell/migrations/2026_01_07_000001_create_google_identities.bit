// Existing accounts remain unlinked; only a new verified provider login creates a binding.
import { Schema } from "orm"

export class CreateGoogleIdentities {
  up(s: Schema): ()! {
    s.create("google_identities", (t) => {
      t.string("issuer", 255)
      t.string("subject", 255)
      t.int("user_id")
      t.primaryKey("issuer", "subject")
      t.foreign("user_id").references("users", "id")
    })?
  }

  down(s: Schema): ()! {
    s.drop("google_identities")?
  }
}
