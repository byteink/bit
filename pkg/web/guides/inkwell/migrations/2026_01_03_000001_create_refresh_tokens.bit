// pkg/web/guides/inkwell/migrations/2026_01_03_000001_create_refresh_tokens.bit
// — #6131: refresh tokens for `POST /auth/token/refresh`. Was `db.bit`'s
// `createRefreshTokens` class — see 2026_01_01_000001_create_users.bit's
// header for the O6 (#6315) move.
//
// `token_hash` is the SHA-256 hex of the opaque refresh token — never the
// raw token itself, the same "hashed at rest" discipline `users.
// password_hash` already carries. `rotated` stays an int (0/1) column
// rather than a native `boolean` one — `RefreshToken.rotated` (auth.bit) is
// `i64` to match, so this migration never has to change when the app's own
// write path does.
import { ReferentialAction, Schema } from "orm"

export class CreateRefreshTokens {
  up(s: Schema): ()! {
    s.create("refresh_tokens", (t) => {
      t.id("id")
      t.int("user_id")
      t.string("token_hash", 64).unique()
      t.int("expires_at")
      t.int("rotated")
      t.int("created_at")
      t.index("user_id")
      t.foreign("user_id").references("users", "id").onDelete(ReferentialAction.Cascade)
    })?
  }

  down(s: Schema): ()! {
    s.table("refresh_tokens", (t) => {
      t.dropColumn("token_hash")
    })?
  }
}
