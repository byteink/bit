// pkg/web/guides/inkwell/articles.bit — the `Article` entity and its five
// routes (#6062, epic #6061, course parts 8 "Querying and CRUD", 9
// "Relationships", 14 "Pagination, filtering and sorting" and 15
// "Transactions"). `POST /articles` is the one transaction the course
// asks for: insert the article, find-or-create each tag by name, and
// link them, all inside one `db.tx(...)` block.
import { StaleWriteError } from "orm"
import { httpError, page } from "web"
import { Builder, join } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

import { Client as RedisClient, Script as RedisScript, luaInt, luaStrings, open as openRedis } from "redis"
import { Sha256 as CacheSha256, digest as cacheDigest, encodeHex as cacheHex } from "std/crypto"
import { jsonParse as cacheJsonParse, jsonEncode as cacheJsonEncode } from "std/json"
import { Second as CacheSecond } from "std/time"
import { hasPrefix as tagHasPrefix, split as tagParts, trimSpace as tagTrim } from "std/strings"

const articleCacheGeneration = "{inkwell:articles}:generation"
const articleCacheTtl = 30 * CacheSecond

class CachedArticlePage {
  value: Json
  toJson(): Json { return this.value }
}

fn articleCacheKey(c: Ctx, generation: i64): string {
  let fields = []string(0)
  for name of ["q", "author", "limit", "page", "sort"] {
    let value = c.query(name)
    fields = append(fields, "${len(value)}:${value}")
  }
  let hash = cacheHex(cacheDigest(CacheSha256(), []byte(join(fields, "|"))))
  return "{inkwell:articles}:${generation}:${hash}"
}

fn cachedArticles(c: Ctx, db: Db, redis: RedisClient): Res! {
  let generation = redis.counter(articleCacheGeneration).get()?
  let key = articleCacheKey(c, generation)
  match (redis.get(key)?) {
    Some(body) => return c.json(CachedArticlePage{ value = cacheJsonParse(body)? })
    None => {}
  }
  let result = listArticles(c, db)?
  let body = [""]
  result.mapValue((value) => {
    body[0] = cacheJsonEncode(value)
    return value
  })
  if (!redis.set(key, body[0], ttl = articleCacheTtl)?) {
    fail newError("inkwell: article cache write was refused")
  }
  return result
}

// A concurrent old-generation fill expires normally and is never read again.
fn invalidateArticles(redis: RedisClient): ()! {
  redis.counter(articleCacheGeneration).incr()?
}

@table("articles") @timestamps @softDelete class Article {
  id: i64
  title: string
  slug: string
  body: string
  authorId: i64
  coverImageKey: Option<string>
  @belongsTo("authorId")
  author: User
  @manyToMany("article_tags")
  tags: []Tag
  createdAt: i64
  updatedAt: i64
  deletedAt: Option<i64>
  @version
  version: i64
}

// #6295: `find()` (`pkg/orm/repo.bit`) fails naming the table if the row is
// missing (or, on a primary key, more than one matched), so this needs no
// `where("id", id).first()` workaround. No `.with(...)`: `toArticleView`
// reads `author` and `tags` from this function's result and the compiler
// loads both with this query.
fn findArticleById(db: Db, id: i64): Article! {
  return db.table<Article>().find(id)?
}

// #6129: raw `to_tsquery` full-text search — see migrations/
// 2026_01_04_000001_add_article_search_vector.bit's `AddArticleSearchVector`
// for why this is raw SQL rather than a `Repo<Article>` chain. `db.query<Article>`
// decodes each row through `Article.__fromRow` the same way `all()`/`first()`
// do; `deleted_at is null` excludes a soft-deleted row the same way every
// other read does.
fn searchArticles(db: Db, q: string, limit: int): []Article! {
  let sqlText = "select * from articles where deleted_at is null " +
    "and search_vector @@ plainto_tsquery('english', ?) " +
    "order by ts_rank(search_vector, plainto_tsquery('english', ?)) desc limit ?"
  return db.query<Article>(sqlText, q, q, limit)?
}

export @json class ArticleView {
  id: i64,
  title: string,
  slug: string,
  body: string,
  authorId: i64,
  authorUsername: string,
  version: i64,
  tags: []TagView,
}

fn toArticleView(a: Article): ArticleView {
  let tagViews = []TagView(0)
  for t of a.tags {
    tagViews = append(tagViews, toTagView(t))
  }
  return ArticleView{
    id = a.id, title = a.title, slug = a.slug, body = a.body, authorId = a.authorId,
    authorUsername = a.author.username, version = a.version, tags = tagViews,
  }
}

// A stable, lowercase, hyphenated slug: only `a`-`z`, `0`-`9` survive; every
// other byte becomes one `-`, and runs collapse to one. The `id` suffix
// (appended after insert, by `createArticle`) is what actually guarantees
// uniqueness; this alone is cosmetic.
fn slugify(title: string): string {
  let b = Builder()
  let lastDash = false
  let i = 0
  while (i < len(title)) {
    let ch = title[i]
    let lower = ch
    if (ch >= 'A' && ch <= 'Z') {
      lower = ch + 32
    }
    if ((lower >= 'a' && lower <= 'z') || (lower >= '0' && lower <= '9')) {
      b.writeByte(lower)
      lastDash = false
    } else if (!lastDash) {
      b.writeByte('-')
      lastDash = true
    }
    i = i + 1
  }
  return b.toString()
}

@json class ArticleListItem {
  id: i64,
  title: string,
  slug: string,
  authorId: i64,
  createdAt: i64,
}

fn toListItem(a: Article): ArticleListItem {
  return ArticleListItem{
    id = a.id, title = a.title, slug = a.slug, authorId = a.authorId, createdAt = a.createdAt,
  }
}

const defaultLimit = 20
const maxLimit = 100

fn clampLimit(raw: string): int {
  let n = parseInt(raw) catch _ {
    return defaultLimit
  }
  if (n < 1) {
    return defaultLimit
  }
  if (n > maxLimit) {
    return maxLimit
  }
  return n
}

fn pageNumber(raw: string): int {
  let n = parseInt(raw) catch _ {
    return 1
  }
  if (n < 1) {
    return 1
  }
  return n
}

fn sortDir(raw: string): Dir {
  if (raw == "oldest") {
    return Dir.Asc
  }
  return Dir.Desc
}

// Filters, sorts and paginates in one pass: `author` narrows to one
// writer's articles, `sort` picks `newest` (the default) or `oldest`, and
// `page`/`limit` (capped at `maxLimit`) drive a plain offset window —
// `Repo<T>.count()` (below) and `.all()` both run off the same filtered
// chain, `where`/`orderBy` never mutating the receiver (pkg/orm/repo.bit).
fn filteredArticles(db: Db, c: Ctx): Repo<Article> {
  let q = db.table<Article>().orderBy("createdAt", sortDir(c.query("sort")))
  let authorRaw = c.query("author")
  if (len(authorRaw) == 0) {
    return q
  }
  let authorId = parseInt(authorRaw) catch _ {
    return q
  }
  return q.where("authorId", authorId)
}

// A `q` query runs the full-text search path instead of the paginated
// listing (course scope per #6129 — search returns its matches directly,
// ranked, with no separate page/limit contract of its own).
fn listArticles(c: Ctx, db: Db): Res! {
  let searchTerm = c.query("q")
  if (len(searchTerm) > 0) {
    let matches = searchArticles(db, searchTerm, defaultLimit)?
    let out = []ArticleListItem(0)
    for a of matches {
      out = append(out, toListItem(a))
    }
    return page(out, len(out), defaultLimit, "")
  }
  let limit = clampLimit(c.query("limit"))
  let pageNum = pageNumber(c.query("page"))
  let q = filteredArticles(db, c)
  let total = q.count()?
  let rows = q.limit(limit).offset((pageNum - 1) * limit).all()?
  let out = []ArticleListItem(0)
  for a of rows {
    out = append(out, toListItem(a))
  }
  return page(out, total, limit, "${pageNum + 1}")
}

fn showArticle(c: Ctx, db: Db): Res! {
  let id = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  let a = findArticleById(db, id) catch _ {
    fail notFound("no article with that id")
  }
  let view = toArticleView(a)
  let tag = articleTag(view)
  if (articleTagMatches(c.header("If-None-Match"), tag)) {
    return articleHeaders(c.status(304), tag)
  }
  return articleHeaders(c.json(view), tag)
}

fn articleTag(view: ArticleView): string {
  // The complete view includes related author/tag values. The envelope is a
  // fixed wrapper; compression middleware weakens this validator if enabled.
  let body = cacheJsonEncode(view.toJson())
  return "\"" + cacheHex(cacheDigest(CacheSha256(), []byte(body))) + "\""
}

fn articleTagMatches(raw: string, tag: string): bool {
  if (tagTrim(raw) == "*") {
    return true
  }
  for part of tagParts(raw, ",") {
    let candidate = tagTrim(part)
    if (tagHasPrefix(candidate, "W/")) {
      candidate = candidate[2:]
    }
    if (candidate == tag) {
      return true
    }
  }
  return false
}

fn articleHeaders(response: Res, tag: string): Res {
  // A session may set a cookie on this public read. Let the browser store
  // and revalidate it, without sharing that response through a proxy cache.
  return response.header("ETag", tag).header("Cache-Control", "private, max-age=0, must-revalidate")
}

export @json class CreateArticleInput {
  @minLen(1)
  title: string

  body: string

  tags: []string
}

// The one transaction the course asks for (part 15): the article row and
// every tag it names commit together or not at all, on the one connection
// `db.tx` pins for the closure. `db.table<Article>().insert(a)` writes only
// the real columns — `author`/`tags` are relation fields, never columns, so
// `insert` skips both the same way it already skips the database-generated
// `id`. `link()` is the second, explicit step that writes the join rows.
fn insertArticle(tx: TxHandle, authorId: i64, input: CreateArticleInput): Article! {
  let stamp = now().ns
  let slug = "${slugify(input.title)}-${uuidFormat(uuidV4())[0:8]}"
  let articles = tx.table<Article>()
  let a = articles.insert(
    Article{
      id = 0, title = input.title, slug = slug, body = input.body, authorId = authorId,
      tags = []Tag(0), createdAt = stamp, updatedAt = stamp, deletedAt = Option<i64>.None,
      version = 0, coverImageKey = Option<string>.None,
    },
  )?
  let ids = []i64(0)
  for name of input.tags {
    let t = findOrCreateTag(tx, name)?
    ids = append(ids, t.id)
  }
  if (len(ids) > 0) {
    articles.link(a, "tags", ids)?
  }
  return a
}

fn createArticle(c: Ctx, db: Db, redis: RedisClient): Res! {
  let uid = currentUserId(c)?
  let input = c.body<CreateArticleInput>()?
  let newId = []i64{ 0 }
  db.tx((tx) => {
    let a = insertArticle(tx, uid, input)?
    newId[0] = a.id
  })?
  invalidateArticles(redis)?
  return c.createdUrl("${apiPrefix}/articles/${newId[0]}")
}

export @json class UpdateArticleInput {
  title: string,
  body: string,
}

// Optimistic locking (part 30, #6129): `If-Match` names the version the
// caller last read. `Repo<T>.update` (pkg/orm/repo.bit) binds it as the
// UPDATE's `WHERE version = ...` and raises `StaleWriteError` — never
// silence — when someone else's write landed first; that maps to 412, the
// client's signal to reload and retry.
fn updateArticle(c: Ctx, db: Db, redis: RedisClient): Res! {
  let id = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  let existing = findArticleById(db, id) catch _ {
    fail notFound("no article with that id")
  }
  requireOwnerOrAdmin(c, existing.authorId)?
  let input = c.body<UpdateArticleInput>()?
  let ifMatch = c.header("If-Match")
  if (len(ifMatch) == 0) {
    fail badRequest("If-Match header is required")
  }
  let expectedVersion = parseInt(ifMatch) catch _ {
    fail badRequest("If-Match must be an integer version")
  }
  existing.title = input.title
  existing.body = input.body
  existing.updatedAt = now().ns
  existing.version = expectedVersion
  db.table<Article>().update(existing) catch e {
    let (_, stale) = e.(StaleWriteError)
    if (stale) {
      fail httpError(412, "the article changed since you last read it; reload and retry")
    }
    fail e
  }
  invalidateArticles(redis)?
  let refreshed = findArticleById(db, id)?
  return c.json(toArticleView(refreshed))
}

fn deleteArticle(c: Ctx, db: Db, redis: RedisClient): Res! {
  let id = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  let existing = findArticleById(db, id) catch _ {
    fail notFound("no article with that id")
  }
  requireOwnerOrAdmin(c, existing.authorId)?
  db.table<Article>().delete(id)?
  invalidateArticles(redis)?
  return c.noContent()
}

// `once` is the idempotency middleware (course part 40). It sits on its own
// group so only `POST /articles` runs behind it: a client that sends an
// `Idempotency-Key` gets one article however many times it retries, and a
// request without the header is untouched.
export fn mountArticles(app: Routes, db: Db, once: Middleware, redis: RedisClient) {
  let group = app.group("/articles")
  group.get("/", (c) => cachedArticles(c, db, redis))
  group.get("/:id", (c) => showArticle(c, db))
  let publish = app.group("/articles")
  publish.use(once)
  publish.post("/", (c) => createArticle(c, db, redis))
  group.put("/:id", (c) => updateArticle(c, db, redis))
  group.delete("/:id", (c) => deleteArticle(c, db, redis))
}
