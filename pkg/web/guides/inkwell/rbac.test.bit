fn rbacFixture(db: Db, roles: []string): App {
  let app = App(Config{ secret = "rbac-fixture", sessions = MemoryStore(100) })
  app.get("/session", (c) => {
    let session = c.session()?
    session.set(sessionRoleKey, c.query("role"))
    session.set(sessionUserIdKey, c.query("id"))
    return c.noContent()
  })
  app.get("/roles", (c) => {
    requireRole(c, roles)?
    return c.noContent()
  })
  app.get("/admin", (c) => {
    requireAdmin(c)?
    return c.noContent()
  })
  app.get("/owner", (c) => {
    requireOwnerOrAdmin(c, 42)?
    return c.noContent()
  })
  mountUsers(app.group(apiPrefix), db)
  app.freeze() catch e {
    panic(e.message())
  }
  return app
}

fn rbacDatabase(): Db {
  let cfg = testConfig() catch e {
    panic(e.message())
  }
  return open(cfg.databaseUrl) catch e {
    panic(e.message())
  }
}

fn rbacRequest(app: App, path: string, cookie: string): Response {
  return app.handle(jsonReq("GET", path, cookie, ""))
}

fn rbacSession(app: App, role: string, id: string): string {
  let response = rbacRequest(app, "/session?role=${role}&id=${id}", "")
  assert(response.status == 204, "fixture session must be created")
  return cookiePair(response.getHeader("Set-Cookie"))
}

test "role lists match exactly and deny empty or missing roles" {
  let db = rbacDatabase()
  defer db.pool.close()
  let app = rbacFixture(db, ["editor", "admin"])
  let allowed = ["editor", "admin"]
  for role of allowed {
    let cookie = rbacSession(app, role, "42")
    assert(rbacRequest(app, "/roles", cookie).status == 204, "listed role must pass")
  }
  let denied = ["author", "Admin", "", "administrator"]
  for role of denied {
    let cookie = rbacSession(app, role, "42")
    assert(rbacRequest(app, "/roles", cookie).status == 403, "unlisted role must fail")
  }
  assert(rbacRequest(app, "/roles", "").status == 403, "anonymous role must fail")
  let empty = rbacFixture(db, []string{})
  assert(
    rbacRequest(empty, "/roles", rbacSession(empty, "admin", "42")).status == 403,
    "empty role list must fail closed",
  )
  let missing = rbacFixture(db, [""])
  assert(rbacRequest(missing, "/roles", "").status == 403, "empty role must never grant access")
}

test "role reuse preserves admin errors and owner authorization" {
  let db = rbacDatabase()
  defer db.pool.close()
  let app = rbacFixture(db, ["admin"])
  let author = rbacSession(app, "author", "42")
  let admin = rbacSession(app, "admin", "7")
  let other = rbacSession(app, "author", "7")
  assert(rbacRequest(app, "/admin", admin).status == 204, "admin helper must allow admin")
  let denied = rbacRequest(app, "/admin", author)
  assert(denied.status == 403, "admin helper must reject author")
  assert(contains(denied.body, "admin role required"), "admin detail must stay unchanged")
  assert(
    rbacRequest(app, "/admin", "").status == 403,
    "anonymous admin request must stay forbidden",
  )
  assert(rbacRequest(app, "/owner", author).status == 204, "owner must pass without admin role")
  assert(rbacRequest(app, "/owner", admin).status == 204, "admin must pass for another owner")
  assert(rbacRequest(app, "/owner", other).status == 403, "nonowner must stay forbidden")
  assert(
    rbacRequest(app, "/owner", "").status == 401,
    "anonymous owner request must stay unauthorized",
  )
}

test "admin user route returns only the public user and preserves lookup failures" {
  let db = rbacDatabase()
  defer db.pool.close()
  let username = uniqueName("rbac")
  let user = db.table<User>().insert(
    newUser(username, username + "@example.test", "private-password", "author"),
  ) catch e {
    panic(e.message())
  }
  let app = rbacFixture(db, ["admin"])
  let admin = rbacSession(app, "admin", "7")
  let response = rbacRequest(app, "/v1/admin/users/${user.id}", admin)
  assert(response.status == 200, "admin must read a user through the real route")
  let expected = cacheJsonEncode(toPublicUser(user).toJson())
  assert(response.body == expected, "admin route must retain exact public serialization")
  assert(!contains(response.body, "private-password"), "password must stay private")
  assert(!contains(response.body, user.email), "email must stay private")
  assert(!contains(response.body, "token"), "token fields must stay private")
  assert(rbacRequest(app, "/v1/admin/users/not-an-id", admin).status == 400, "bad id must stay 400")
  assert(rbacRequest(app, "/v1/admin/users/-1", admin).status == 404, "unknown user must stay 404")
  let public = rbacRequest(app, "/v1/users/${user.id}", "")
  assert(
    public.status == 200 && public.body == expected,
    "existing public route must stay unchanged",
  )
}

test "admin user route denies callers before parsing or querying users" {
  let db = rbacDatabase()
  db.pool.close()
  let app = rbacFixture(db, ["admin"])
  let author = rbacSession(app, "author", "42")
  assert(
    rbacRequest(app, "/v1/admin/users/1", author).status == 403,
    "denied caller must not query closed DB",
  )
  assert(
    rbacRequest(app, "/v1/admin/users/not-an-id", author).status == 403,
    "authorization must precede id parsing",
  )
  assert(
    rbacRequest(app, "/v1/admin/users/1", "").status == 403,
    "anonymous caller must not query closed DB",
  )
}
