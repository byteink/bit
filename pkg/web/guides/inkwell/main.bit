// pkg/web/guides/inkwell/main.bit — Inkwell's entry point (#6062, epic
// #6061, course parts 1-5, 13 and 17). Loads `AppConfig`, opens the
// PostgreSQL pool, runs pending migrations, mounts every resource's routes
// behind the operational middleware, and serves.
//
// TWO CONNECTIONS, ON PURPOSE, NOT A LEFTOVER. `pool` (`db.bit`'s
// `openPool`) is the raw `std/sql` connection migrations/`ensureArticleSearchIndex`
// and the `/ready` probe need — `pkg/orm`'s migration runner takes `Data`
// (`pkg/orm/runner.bit`'s `up`), and schema creation is explicitly not part
// of #6294's target (`.claude/kb/data-packages-dx.md`: "Migrations / schema
// creation are NOT in this approval"). `db` (`orm.open`) is the ONE
// connection every repository-backed route below is threaded through —
// `Db.table<T>()`/`db.tx(...)`, never a second `db: Data` parameter, per
// rule 2. `Db` has no way to hand back the raw `Data`/`Pool` underneath it
// (its own `pool` field is package-private, `pkg/orm/db.bit`), so a caller
// needing both today opens both — the same shape #6270's own trail of
// comments on this ticket already named.
//
// GRACEFUL SHUTDOWN (course part 17, second half): NOT implemented here,
// and not faked. `App.listen()` (pkg/web/app.bit) calls `std/http`'s
// module-level `listenAndServe(host, port, handler)`, which never returns
// the `Server` value `std/http/shutdown.bit`'s own `Server.shutdown()`
// needs — so nothing reachable from `pkg/web` can drain in-flight
// connections before exit, even though `std/http` itself already ships
// that engine. Filed as a pkg/web gap under #6061; this file just calls
// `listen()` and blocks until a bind/accept error, same as every other
// pkg/web example in its own docs.
import {
  Config, MemoryCounter, MemoryStore, Limit, Cors, Headers, byIp, cors, envelope, logger,
  rateLimit, recover, secureHeaders,
} from "web"
import { Db, Repo, TxHandle, open } from "orm"

const sessionCap = 10_000
const rateLimitPerMinute = 120
const rateLimitCounterCap = 10_000

fn probeDb(pool: Pool): bool {
  let rows = pool.query("select 1", []Value(0)) catch _ {
    return false
  }
  rows.close()
  return true
}

fn health(c: Ctx): Res! {
  return c.text("ok")
}

fn ready(c: Ctx, pool: Pool): Res! {
  if (!probeDb(pool)) {
    return c.text("database unavailable").status(503)
  }
  return c.text("ready")
}

fn mountOperations(app: App, pool: Pool) {
  app.get("/health", health)
  app.get("/ready", (c) => ready(c, pool))
}

fn mountMiddleware(app: App) {
  app.use(recover())
  app.use(logger())
  app.use(secureHeaders(Headers{ https = false }))
  app.use(
    cors(
      Cors{
        origins = []string{ "http://localhost:3000" }, methods = []string{
          "GET", "POST", "PUT", "DELETE",
        },
        headers = []string{ "Content-Type", "Authorization" }, credentials = true, maxAge = 600,
      },
    ),
  )
  app.use(
    rateLimit(
      Limit{
        requests = rateLimitPerMinute, window = 60, by = byIp, store = MemoryCounter(
          rateLimitCounterCap,
        ),
      },
    ),
  )
  app.use(envelope())
}

// `pool` stays the raw operational connection for `/health`/`/ready` — see
// this file's header for why a second, ORM-facing `Db` is opened here too.
export fn buildApp(cfg: AppConfig, pool: Pool): App! {
  let db = open(cfg.databaseUrl)?
  let app = App(
    Config{
      secret = cfg.secret, host = cfg.host, port = cfg.port, sessions = MemoryStore(sessionCap),
    },
  )
  mountMiddleware(app)
  mountOperations(app, pool)
  mountUsers(app, db)
  mountAuth(app, db, cfg)
  mountArticles(app, db)
  mountTags(app, db)
  mountComments(app, db)
  return app
}

fn main(): ()! {
  let cfg = loadConfig()?
  let pool = openPool(cfg)?
  let report = runMigrations(pool)?
  eprint("inkwell: applied ${len(report.applied)} migration(s)\n")
  let app = buildApp(cfg, pool)?
  app.listen()?
}
