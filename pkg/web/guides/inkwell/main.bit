// pkg/web/guides/inkwell/main.bit — Inkwell's entry point (#6062, epic
// #6061, course parts 1-5, 13 and 17). Loads `AppConfig`, opens the app's
// one PostgreSQL connection, mounts every resource's routes behind the
// operational middleware, and serves.
//
// ONE ORM CONNECTION (O6, #6315): `db` (`orm.open`) is the only connection
// the app's tables go through — `Db.table<T>()`/`db.tx(...)`, never a second
// `db: Data` parameter, per rule 2. Schema setup no longer runs here: `bit
// migrate` (pkg/orm/cmd/migrate) applies `migrations/*.bit` before this
// binary starts, so main.bit never opens a raw `std/sql` connection just to
// run it — `Db.exec` (pkg/orm/rawsql.bit) is enough for the one raw
// statement `/ready` still needs.
//
// THE ONE EXCEPTION IS THE IDEMPOTENCY STORE (course part 40, #6133).
// pkg/web's `SqlIdempotencyStore` takes a `std/sql` `Pool`, and `Db` does
// not hand its own out, so `openIdempotencyStore` opens a second pool for
// it. It touches only the `bit_idempotency` table, which has its own
// migration; no entity ever reads or writes through it.
//
// GRACEFUL SHUTDOWN (course part 17, second half): NOT implemented here,
// and not faked. `App.listen()` (pkg/web/app.bit) calls `std/http`'s
// module-level `listenAndServe(host, port, handler)`, which never returns
// the `Server` value `std/http/shutdown.bit`'s own `Server.shutdown()`
// needs — so nothing reachable from `pkg/web` can drain in-flight
// connections before exit, even though `std/http` itself already ships
// that engine. Filed as a pkg/web gap under #6061; this file just calls
// `listen()` and blocks until a bind/accept error, same as every other
// pkg/web example in its own docs.
import {
  Config, MemoryCounter, MemoryStore, Limit, Cors, Headers, IdempotencyPolicy, IdempotencyStore,
  Middleware, SqlIdempotencyStore, byIp, cors, envelope, idempotency, logger, rateLimit, recover,
  secureHeaders,
} from "web"
import { Db, Repo, TxHandle, open } from "orm"

const sessionCap = 10_000
const rateLimitPerMinute = 120
const rateLimitCounterCap = 10_000

// How long a client may retry a write and get the first answer back: one day.
const idempotencyTtlSeconds: i64 = 86400

fn probeDb(db: Db): bool {
  db.exec("select 1") catch _ {
    return false
  }
  return true
}

fn health(c: Ctx): Res! {
  return c.text("ok")
}

fn ready(c: Ctx, db: Db): Res! {
  if (!probeDb(db)) {
    return c.text("database unavailable").status(503)
  }
  return c.text("ready")
}

fn mountOperations(app: App, db: Db) {
  app.get("/health", health)
  app.get("/ready", (c) => ready(c, db))
}

fn mountMiddleware(app: App) {
  app.use(recover())
  app.use(logger())
  app.use(secureHeaders(Headers{ https = false }))
  app.use(
    cors(
      Cors{
        origins = []string{ "http://localhost:3000" }, methods = []string{
          "GET", "POST", "PUT", "DELETE",
        },
        headers = []string{ "Content-Type", "Authorization" }, credentials = true, maxAge = 600,
      },
    ),
  )
  app.use(
    rateLimit(
      Limit{
        requests = rateLimitPerMinute, window = 60, by = byIp, store = MemoryCounter(
          rateLimitCounterCap,
        ),
      },
    ),
  )
  app.use(envelope())
}

// The keys live in PostgreSQL, next to the data they protect, so every server
// behind a load balancer answers for all of them. Expired rows are harmless
// (`begin` ignores them) but never leave the table by themselves, so each
// start sweeps them once.
fn openIdempotencyStore(cfg: AppConfig): SqlIdempotencyStore! {
  let store = SqlIdempotencyStore(openPool(cfg)?)?
  store.purge()?
  return store
}

export fn buildApp(cfg: AppConfig): App! {
  return buildAppWith(cfg, openIdempotencyStore(cfg)?)?
}

// `buildApp` with the idempotency store chosen by the caller: a test hands in
// a store it can hold still to catch a request in flight.
export fn buildAppWith(cfg: AppConfig, keys: IdempotencyStore): App! {
  let db = open(cfg.databaseUrl)?
  let once = idempotency(IdempotencyPolicy{ store = keys, ttl = idempotencyTtlSeconds })
  let app = App(
    Config{
      secret = cfg.secret, host = cfg.host, port = cfg.port, sessions = MemoryStore(sessionCap),
    },
  )
  mountMiddleware(app)
  mountOperations(app, db)
  mountUsers(app, db)
  mountAuth(app, db, cfg)?
  mountArticles(app, db, once)
  mountTags(app, db)
  mountComments(app, db, once)
  return app
}

fn main(): ()! {
  let cfg = loadConfig()?
  let app = buildApp(cfg)?
  app.listen()?
}
