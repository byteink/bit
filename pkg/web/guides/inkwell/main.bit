// pkg/web/guides/inkwell/main.bit — Inkwell's entry point (#6062, epic
// #6061, course parts 1-5, 13 and 17). Loads `AppConfig`, opens the app's
// one PostgreSQL connection, mounts every resource's routes behind the
// operational middleware, and serves.
//
// ONE ORM CONNECTION (O6, #6315): `db` (`orm.open`) is the only connection
// the app's tables go through — `Db.table<T>()`/`db.tx(...)`, never a second
// `db: Data` parameter, per rule 2. Schema setup no longer runs here: `bit
// migrate` (pkg/orm/cmd/migrate) applies `migrations/*.bit` before this
// binary starts, so main.bit never opens a raw `std/sql` connection just to
// run it — `Db.exec` (pkg/orm/rawsql.bit) is enough for the one raw
// statement `/ready` still needs.
//
// The idempotency store shares `db.pool` with the app's repositories
// (#7870). Its own `bit_idempotency` migration still runs through `bit
// migrate`, alongside every other table.
//
// GRACEFUL SHUTDOWN: This entrypoint calls `App.listen()` and installs no
// signal handler. `App.serve()` (pkg/web/app.bit) returns the `Server` whose
// `shutdown(timeoutMs)` drains in-flight connections; this entrypoint does
// not use it. Its deferred `jobs.stop()` runs when `main` returns, rather
// than acting as a process-signal hook.
import {
  Config, MemoryCounter, Limit, Cors, Headers, IdempotencyPolicy, IdempotencyStore,
  Middleware, OpenApiInfo, Routes, SqlIdempotencyStore, byIp, cors, envelope, idempotency, logger, rateLimit, recover,
  secureHeaders,
} from "web"
import { Db, Repo, TxHandle, open } from "orm"

const rateLimitPerMinute = 120
const rateLimitCounterCap = 10_000
const apiPrefix = "/v1"

// How long a client may retry a write and get the first answer back: one day.
const idempotencyTtlSeconds: i64 = 86400

fn probeDb(db: Db): bool {
  db.exec("select 1") catch _ {
    return false
  }
  return true
}

fn health(c: Ctx): Res! {
  return c.text("ok")
}

fn ready(c: Ctx, db: Db): Res! {
  if (!probeDb(db)) {
    return c.text("database unavailable").status(503)
  }
  return c.text("ready")
}

fn mountOperations(app: Routes, db: Db) {
  app.get("/health", health)
  app.get("/ready", (c) => ready(c, db))
}

fn showOpenApi(c: Ctx, app: App): Res! {
  let document = app.openApi(
    OpenApiInfo{ title = "Inkwell API", version = "v1", description = "Inkwell blogging API" },
  )?
  // This document is already the required wire shape; a valueless response
  // passes through the application envelope without adding a data wrapper.
  return c.bytes(cacheJsonEncode(document), "application/json; charset=utf-8")
}

fn mountMiddleware(app: App) {
  app.use(recover())
  app.use(logger())
  app.use(secureHeaders(Headers{ https = false }))
  app.use(
    cors(
      Cors{
        origins = []string{ "http://localhost:3000" }, methods = []string{
          "GET", "POST", "PUT", "DELETE",
        },
        headers = []string{ "Content-Type", "Authorization" }, credentials = true, maxAge = 600,
      },
    ),
  )
  app.use(
    rateLimit(
      Limit{
        requests = rateLimitPerMinute, window = 60, by = byIp, store = MemoryCounter(
          rateLimitCounterCap,
        ),
      },
    ),
  )
  app.use(envelope())
}

// The keys live in PostgreSQL, next to the data they protect, so every server
// behind a load balancer answers for all of them. Expired rows are harmless
// (`begin` ignores them) but never leave the table by themselves, so each
// start sweeps them once.
fn openIdempotencyStore(db: Db): SqlIdempotencyStore! {
  let store = SqlIdempotencyStore(db.pool)?
  store.purge()?
  return store
}

export fn buildApp(cfg: AppConfig): App! {
  let db = open(cfg.databaseUrl)?
  let store = openIdempotencyStore(db) catch e {
    db.pool.close()
    fail e
  }
  return openAppRedis(cfg, db, store)?
}

// `buildApp` with the idempotency store chosen by the caller: a test hands in
// a store it can hold still to catch a request in flight.
export fn buildAppWith(cfg: AppConfig, keys: IdempotencyStore): App! {
  return openAppRedis(cfg, open(cfg.databaseUrl)?, keys)?
}

fn openAppRedis(cfg: AppConfig, db: Db, keys: IdempotencyStore): App! {
  let redis = openRedis(cfg.redisUrl) catch e {
    db.pool.close()
    fail e
  }
  return buildAppFromDb(cfg, db, keys, redis) catch e {
    redis.close()
    db.pool.close()
    fail e
  }
}

fn buildAppFromDb(cfg: AppConfig, db: Db, keys: IdempotencyStore, redis: RedisClient): App! {
  let once = idempotency(IdempotencyPolicy{ store = keys, ttl = idempotencyTtlSeconds })
  let app = App(
    Config{
      maxBody = coverMaxBytes + 4096,
      secret = cfg.secret, host = cfg.host, port = cfg.port, sessions = InkwellSessionStore(redis),
    },
  )
  mountMiddleware(app)
  let api = app.group(apiPrefix)
  mountOperations(api, db)
  mountUsers(api, db)
  let jobs = openMailQueue(cfg, redis)?
  mountAuth(api, db, cfg, jobs) catch e {
    db.pool.close()
    fail e
  }
  mountArticles(api, db, once, redis)
  mountImages(api, db, cfg, redis)
  mountTags(api, db)
  mountComments(api, db, once)
  app.get("/openapi.json", (c) => showOpenApi(c, app))
  return app
}

fn main(): ()! {
  let cfg = loadConfig()?
  let db = open(cfg.databaseUrl)?
  defer db.pool.close()
  let redis = openRedis(cfg.redisUrl)?
  defer redis.close()
  let app = buildAppFromDb(cfg, db, openIdempotencyStore(db)?, redis)?
  let jobs = openDigestQueue(db, redis, cfg)?
  jobs.start()
  defer jobs.stop()
  app.listen()?
}
