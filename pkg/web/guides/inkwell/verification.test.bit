import { Schema, SchemaOp, Postgres, Migration } from "orm"
import { AddUserEmailVerifiedAt } from "./migrations"

@table class VerificationSnapshot {
  id: i64,
  emailVerifiedAt: Option<i64>,
}

fn verificationSchema(tx: TxHandle, schema: Schema): ()! {
  assert(len(schema.ops) == 1, "one verification migration operation")
  let statements = Postgres{}.render(schema.ops[0])
  assert(len(statements) == 1 && statements[0].transactional, "one transactional migration")
  tx.exec(statements[0].sql)?
}

test "Inkwell verification status defaults to unset" {
  let user = newUser("verification", "verification@example.test", "fixture hash", "author")
  assert(!isSome(user.emailVerifiedAt), "new accounts must remain unverified")
}

test "Inkwell verification migration leaves legacy rows NULL and rolls back" {
  let db = redisGuideDb() catch e {
    panic(e.message())
  }
  defer db.pool.close()
  db.tx((tx) => {
    // A connection-local table lets the actual migration run without changing app users.
    tx.exec("create temporary table users (id bigint primary key, username text not null) on commit drop")?
    tx.exec("insert into users (id, username) values (?, ?)", 1, "legacy")?
    let up = Schema{ ops = []SchemaOp(0) }
    let migration: Migration = AddUserEmailVerifiedAt{}
    migration.up(up)?
    verificationSchema(tx, up)?
    let old = tx.query<VerificationSnapshot>(
      "select id, email_verified_at from users where id = ?",
      1,
    )?
    assert(len(old) == 1 && !isSome(old[0].emailVerifiedAt), "legacy account must remain NULL")
    let down = Schema{ ops = []SchemaOp(0) }
    migration.down(down)?
    verificationSchema(tx, down)?
    // Reapplying proves down removed only the new column and kept the legacy row.
    verificationSchema(tx, up)?
    let restored = tx.query<VerificationSnapshot>(
      "select id, email_verified_at from users where id = ?",
      1,
    )?
    assert(
      len(restored) == 1 && restored[0].id == 1 && !isSome(restored[0].emailVerifiedAt),
      "reversible nullable status",
    )
  }) catch e {
    panic(e.message())
  }
}

test "Inkwell verification timestamp roundtrips without public exposure" {
  let app = testApp()
  let name = uniqueName("verification-status")
  let cookie = registerAndLogin(app, name, "correct horse battery") catch e {
    panic(e.message())
  }
  assert(cookie != "", "existing registration and session login")
  let db = redisGuideDb() catch e {
    panic(e.message())
  }
  defer db.pool.close()
  let user = findUserByUsername(db, name) catch e {
    panic(e.message())
  }
  assert(!isSome(user.emailVerifiedAt), "registration must remain unverified")
  let stamp: i64 = 1700000000123456789
  let changed = db.table<User>().where("id", user.id).set("emailVerifiedAt", stamp).updateAll() catch e {
    panic(e.message())
  }
  assert(changed == 1, "one verification status update")
  let loaded = findUserById(db, user.id) catch e {
    panic(e.message())
  }
  assert(
    isSome(loaded.emailVerifiedAt) && unwrap(loaded.emailVerifiedAt) == stamp,
    "exact epoch nanoseconds roundtrip",
  )
  let response = app.handle(jsonReq("GET", "/v1/users/${user.id}", "", ""))
  assert(response.status == 200, "public user remains readable")
  assert(
    !contains(response.body, "emailVerifiedAt") && !contains(response.body, "email_verified_at"),
    "private verification status excluded",
  )
  assert(
    !contains(response.body, "password") && !contains(response.body, "token"),
    "secret fields excluded",
  )
}

fn verificationPost(app: App, token: string): Response {
  return app.handle(jsonReq("POST", "/v1/auth/verify-email", "", "{\"token\":\"${token}\"}"))
}

fn verificationRouteUnmarked(f: AccountTokenFixture, other: User) {
  for id of [f.user.id, other.id] {
    let user = findUserById(f.db, id) catch e {
      panic(e.message())
    }
    assert(!isSome(user.emailVerifiedAt), "invalid token must update neither account")
  }
}

test "verification POST rejects unknown expired wrong-purpose and changed-address tokens" {
  let app = testApp()
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let other = accountTokenUser(f.db)
  assert(
    verificationPost(app, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA").status == 401,
    "unknown token",
  )
  let expired = accountVerificationIssue(f)
  assert(verificationPost(app, expired).status == 401, "expired token")
  let tokens = OneTimeTokens(f.store) catch e {
    panic(e.message())
  }
  let reset = tokens.issue("password-reset", "${f.user.id}", 600, f.user.email) catch e {
    panic(e.message())
  }
  assert(verificationPost(app, reset).status == 401, "wrong purpose")
  let changed = tokens.issue("verify-email", "${f.user.id}", 600, other.email) catch e {
    panic(e.message())
  }
  assert(verificationPost(app, changed).status == 401, "wrong account address binding")
  verificationRouteUnmarked(f, other)
  let good = tokens.issue("verify-email", "${f.user.id}", 600, f.user.email) catch e {
    panic(e.message())
  }
  assert(verificationPost(app, good).status == 204, "valid token after negative controls")
  assert(verificationPost(app, good).status == 401, "replay")
  let untouched = findUserById(f.db, other.id) catch e {
    panic(e.message())
  }
  assert(!isSome(untouched.emailVerifiedAt), "only the token-bound account is marked")
}

test "verification POST preserves a store failure as an HTTP error" {
  let cfg = testConfig() catch e {
    panic(e.message())
  }
  let db = open(cfg.databaseUrl) catch e {
    panic(e.message())
  }
  db.pool.close()
  let app = App(Config{ secret = "store-failure", sessions = MemoryStore(100) })
  app.post("/v1/auth/verify-email", (c) => verifyEmail(c, db))
  app.freeze() catch e {
    panic(e.message())
  }
  assert(
    verificationPost(app, "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA").status == 500,
    "store error must not become success or invalid-token",
  )
}
