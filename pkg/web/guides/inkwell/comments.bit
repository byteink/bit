// pkg/web/guides/inkwell/comments.bit — the `Comment` entity, nested under
// an article's own routes (#6062, epic #6061, course part 9
// "Relationships": one-to-many, the other side — an article's comments and
// a user's own).
@table @timestamps class Comment {
  @id
  id: i64
  articleId: i64
  authorId: i64
  body: string
  createdAt: i64
  updatedAt: i64
}

fn commentPlaceholder(): Comment {
  return Comment{ id = 0, articleId = 0, authorId = 0, body = "", createdAt = 0, updatedAt = 0 }
}

fn commentDesc(): TableDesc {
  return TableDesc{
    table = "comments", fields = commentPlaceholder().tableDescriptor(), classAttrs = []AttrDesc(0),
  }
}

fn commentValues(cm: Comment): map<string, Value> {
  return map<string, Value>{
    "id": Value.Int(cm.id), "articleId": Value.Int(cm.articleId), "authorId": Value.Int(cm.authorId),
    "body": Value.Text(cm.body),
  }
}

fn commentMapper(rows: Rows): Comment! {
  let cols = rows.columns()
  return Comment{
    id = sqlReqInt(rows, cols, "id")?,
    articleId = sqlReqInt(rows, cols, "article_id")?,
    authorId = sqlReqInt(rows, cols, "author_id")?,
    body = sqlReqText(rows, cols, "body")?,
    createdAt = sqlReqInt(rows, cols, "created_at")?,
    updatedAt = sqlReqInt(rows, cols, "updated_at")?,
  }
}

fn comments(db: Data): Query<Comment> {
  return find<Comment>(db, "comments", commentDesc().fields, commentMapper)
}

fn findCommentById(db: Data, id: i64): Comment! {
  return comments(db).where("id", Value.Int(id)).oneOrFail()?
}

@json class CommentView {
  id: i64,
  articleId: i64,
  authorId: i64,
  body: string,
  createdAt: i64,
}

fn toCommentView(cm: Comment): CommentView {
  return CommentView{
    id = cm.id, articleId = cm.articleId, authorId = cm.authorId, body = cm.body,
    createdAt = cm.createdAt,
  }
}

fn listComments(c: Ctx, db: Data): Res! {
  let articleId = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  let rows = comments(db).where("articleId", Value.Int(articleId)).orderBy(
    "createdAt",
    Dir.Asc,
  ).all()?
  let out = []CommentView(0)
  for cm of rows {
    out = append(out, toCommentView(cm))
  }
  return c.jsonList(out)
}

export @json class CreateCommentInput {
  @minLen(1)
  body: string
}

fn createComment(c: Ctx, db: Data): Res! {
  let articleId = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  findArticleById(db, articleId) catch _ {
    fail notFound("no article with that id")
  }
  let uid = currentUserId(c)?
  let input = c.body<CreateCommentInput>()?
  let cm = Comment{
    id = 0, articleId = articleId, authorId = uid, body = input.body, createdAt = 0, updatedAt = 0,
  }
  let desc = commentDesc()
  let values = commentValues(cm)
  let withStamps = applyTimestamps(desc, values, false, cm.tableAttrs(), now())?
  let result = save(db, withStamps, values, false)?
  let (idVal, ok) = result.generated["id"]
  let newId = 0
  if (ok) {
    newId = intOf(idVal)?
  }
  return c.createdUrl("/articles/${articleId}/comments/${newId}")
}

fn deleteComment(c: Ctx, db: Data): Res! {
  let id = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  let existing = findCommentById(db, id) catch _ {
    fail notFound("no comment with that id")
  }
  requireOwnerOrAdmin(c, existing.authorId)?
  ormDelete(db, commentDesc(), commentValues(existing))?
  return c.noContent()
}

export fn mountComments(app: App, db: Data) {
  let onArticle = app.group("/articles/:id/comments")
  onArticle.get("/", (c) => listComments(c, db))
  onArticle.post("/", (c) => createComment(c, db))
  app.group("/comments").delete("/:id", (c) => deleteComment(c, db))
}
