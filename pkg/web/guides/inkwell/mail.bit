// Local development relays are cleartext; remote submission verifies TLS.
import {
  Address,
  Client as MailClient,
  Message,
  Options as MailOptions,
  dial as dialMail,
  dialTls as dialMailTls,
} from "std/smtp"
import { Second } from "std/time"

fn mailConfigured(cfg: AppConfig): bool {
  return cfg.smtpHost != ""
}

fn validateMailConfig(cfg: AppConfig): ()! {
  if (cfg.smtpHost == "" && cfg.smtpFrom == "") {
    return
  }
  if (cfg.smtpHost == "" || cfg.smtpFrom == "" || cfg.smtpPort <= 0 || cfg.smtpPort > 65535) {
    fail newError("inkwell: SMTP_HOST, SMTP_PORT and SMTP_FROM must configure a mail relay")
  }
}

fn mailConnection(cfg: AppConfig): MailClient! {
  validateMailConfig(cfg)?
  if (!mailConfigured(cfg)) {
    fail newError("inkwell: mail relay is disabled")
  }
  let opts = MailOptions(timeout = 5 * Second)
  if (cfg.smtpHost == "127.0.0.1" || cfg.smtpHost == "::1") {
    return dialMail(cfg.smtpHost, cfg.smtpPort, opts)?
  }
  return dialMailTls(cfg.smtpHost, cfg.smtpPort, opts)?
}

fn sendWelcome(cfg: AppConfig, email: string, username: string): ()! {
  let message = Message(Address{ name = "Inkwell", email = cfg.smtpFrom })
  message.addTo(Address{ name = "", email = email })
  message.setSubject("Welcome to Inkwell")
  message.setText("Welcome to Inkwell, ${username}!\n")
  let client = mailConnection(cfg)?
  defer client.close()
  client.ehlo("inkwell")?
  client.send(message)?
  client.quit()?
}
