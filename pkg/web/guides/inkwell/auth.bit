// pkg/web/guides/inkwell/auth.bit — registration, login, logout, and the
// authorization helpers articles.bit/comments.bit call (#6062, epic #6061,
// course parts 10 "Registering users", 11 "Sessions and logging in", 12
// "Authorization"). `users.bit` owns the `User` entity; this file is the
// one place `pkg/auth`'s password flow is wired to it.
//
// WORKAROUND for a confirmed pkg/auth bug (filed as #6093, epic #6061):
// the documented `requireAuth([...PasswordStrategy...])`-as-login-
// middleware pattern (pkg/auth/README.md, docs/getting-started.md) loses
// the session — `PasswordStrategy.authenticate()` (pkg/auth/password.bit)
// already calls `c.session()?.regenerate()?` once, and `requireAuth`
// (pkg/auth/middleware.bit) unconditionally calls it AGAIN, so whatever
// `requireAuth`'s own `.set(identitySessionKey, ...)` writes lands on a
// session a second `regenerate()` is about to replace. Reproduced
// standalone (no packages beyond "web"/"auth") and recorded on #6093.
// This file uses the OTHER documented shape instead — a route handler
// calling `Strategy.authenticate(c)` directly, the pattern password.bit's
// own comment and password.test.bit's harness already use — and stores
// the result under this app's OWN session keys rather than pkg/auth's
// `identitySessionKey` (module-private, and only `requireAuth`/
// `currentIdentity` read or write it), so `currentUserId`/`currentRole`
// below read back exactly what `login` wrote, with no dependency on the
// broken path.
import { conflict, forbidden, minLen, unauthorized } from "web"
import {
  Identity, Lookup, LookupResult, OidcOptions, OidcStrategy, Provider, Strategy, beginAuthorization,
  InvalidRefreshToken, RefreshRecord, RefreshTokens, currentIdentity, handleCallback, hashPassword,
  PasswordStrategy, requireAuth,
} from "auth"
import { UniqueViolation, classify } from "orm"
import { jsonDecString, jsonGet } from "std/json"
import { isSome, unwrap } from "std/core"
import { SigningKey, VerifyKey, defaultClaimsOptions, sign, verifyToken } from "std/jwt"
import { systemRoots } from "std/crypto"
import { TlsConfig } from "std/tls"
import { hasPrefix } from "std/strings"

const adminRole = "admin"
const sessionUserIdKey = "inkwell:userId"
const sessionRoleKey = "inkwell:role"

// #6131: bearer JWT access tokens (`POST /auth/token`) and opaque refresh
// tokens (`POST /auth/token/refresh`), plus Sign in with Google.
const bearerPrefix = "Bearer "
const accessTokenTtlSeconds = 900

// `pkg/auth`'s `Lookup` — the seam `PasswordStrategy` calls with the
// POST body's `username`, per pkg/auth/docs/getting-started.md.
export fn userLookup(db: Db): Lookup {
  return (username) => {
    let u = findUserByUsername(db, username)?
    return LookupResult{ hash = u.passwordHash, id = "${u.id}", claims = userClaims(u) }
  }
}

export @json class RegisterInput {
  @minLen(3)
  username: string

  email: string

  @minLen(8)
  password: string
}

fn insertUser(db: Db, username: string, email: string, passwordHash: string, role: string): User! {
  let stamp = now().ns
  return db.table<User>().insert(
    User{
      id = 0, username = username, email = email, passwordHash = passwordHash, role = role,
      createdAt = stamp, updatedAt = stamp,
    },
  ) catch e {
    let cause = classify(e, "users")
    let (_, ok) = cause.(UniqueViolation)
    if (ok) {
      fail conflict("that username or email is already registered")
    }
    fail cause
  }
}

fn register(c: Ctx, db: Db): Res! {
  let input = c.body<RegisterInput>()?
  let saved = insertUser(db, input.username, input.email, hashPassword(input.password), "author")?
  return c.created("${saved.id}").header("Location", "/users/${saved.id}")
}

// Verifies the POST body's credentials via `PasswordStrategy` directly
// (never through `requireAuth` — see this file's header) and writes the
// result onto the session itself: `regenerate()` closes session fixation
// exactly once, then the role/id are stored under this app's own keys.
fn login(c: Ctx, strategy: Strategy): Res! {
  let identity = strategy.authenticate(c)?
  let session = c.session()?
  session.regenerate()?
  session.set(sessionUserIdKey, identity.id)
  let role = jsonGet(identity.claims, "role")
  if (isSome(role)) {
    session.set(sessionRoleKey, jsonDecString(unwrap(role), "identity.claims.role")?)
  }
  return c.noContent()
}

fn logout(c: Ctx): Res! {
  c.session()?.destroy()?
  return c.noContent()
}

fn showMe(c: Ctx, db: Db): Res! {
  let id = currentUserId(c)?
  let u = findUserById(db, id)?
  return c.json(toPublicUser(u))
}

// ---- bearer JWT access tokens + opaque refresh tokens (part 34-35) --------

// The access token's claims: `sub` (RFC 7519 §4.1.2) is the user id, `role`
// is this app's own authorization claim (the same one `userClaims` puts on
// a session-based `Identity`), `iat`/`exp` (§4.1.4/.6) are what
// `defaultClaimsOptions` checks on verify.
fn accessTokenPayload(u: User, iat: int, exp: int): Json {
  return Json.JsonObject(
    [
      JsonEntry{ key = "sub", value = Json.JsonString("${u.id}") },
      JsonEntry{ key = "role", value = Json.JsonString(u.role) },
      JsonEntry{ key = "iat", value = Json.JsonInt(iat) },
      JsonEntry{ key = "exp", value = Json.JsonInt(exp) },
    ],
  )
}

fn issueAccessToken(u: User, jwtSecret: string): string! {
  let nowSec = now().ns / Second
  let payload = accessTokenPayload(u, nowSec, nowSec + accessTokenTtlSeconds)
  return sign(SigningKey.Hs256Key([]byte(jwtSecret)), payload)?
}

// The `Strategy` `/api/*` is protected by: reads `Authorization: Bearer
// <jwt>`, verifies it under `jwtSecret` (HS256), and returns an `Identity`
// carrying the token's own claims — never touches `c.session()` itself
// beyond what `requireAuth` (middleware.bit) already does for every
// strategy.
class BearerStrategy {
  jwtSecret: string

  init(secret: string) {
    this.jwtSecret = secret
  }

  export name(): string {
    return "bearer"
  }

  export authenticate(c: Ctx): Identity! {
    let header = c.header("Authorization")
    if (!hasPrefix(header, bearerPrefix)) {
      fail unauthorized()
    }
    let token = header[len(bearerPrefix):len(header)]
    let opts = defaultClaimsOptions(now().ns / Second)
    let payload = verifyToken(token, VerifyKey.Hs256Key([]byte(this.jwtSecret)), opts) catch _ {
      fail unauthorized()
    }
    let subField = jsonGet(payload, "sub")
    if (!isSome(subField)) {
      fail unauthorized()
    }
    let sub = jsonDecString(unwrap(subField), "sub") catch _ {
      fail unauthorized()
    }
    return Identity{ id = sub, claims = payload }
  }
}

export @json class TokenResponse {
  accessToken: string,
  refreshToken: string,
  tokenType: string,
  expiresIn: int,
}

// `refresh_tokens` — one row per refresh token, the shape of pkg/auth's
// `RefreshRecord`. `revoked` is `0`/`1` (an `i64`), matching the migration's
// `t.int("revoked")` column, not a native `boolean` one; `rotatedAt` is `0`
// while the token has not been exchanged.
@table("refresh_tokens") class RefreshRow {
  id: i64,
  tokenHash: string,
  family: string,
  subject: string,
  expiresAt: i64,
  familyExpiresAt: i64,
  rotatedAt: i64,
  revoked: i64,
  data: string,
}

fn toRefreshRow(rec: RefreshRecord): RefreshRow {
  let revoked: i64 = 0
  if (rec.revoked) {
    revoked = 1
  }
  return RefreshRow{
    id = 0, tokenHash = rec.hash, family = rec.family, subject = rec.subject,
    expiresAt = rec.expiresAt, familyExpiresAt = rec.familyExpiresAt, rotatedAt = rec.rotatedAt,
    revoked = revoked, data = rec.data,
  }
}

fn toRefreshRecord(row: RefreshRow): RefreshRecord {
  return RefreshRecord{
    hash = row.tokenHash, family = row.family, subject = row.subject, expiresAt = row.expiresAt,
    familyExpiresAt = row.familyExpiresAt, rotatedAt = row.rotatedAt, revoked = row.revoked != 0,
    data = row.data,
  }
}

// pkg/auth's `RefreshStore` over the `refresh_tokens` table
// (pkg/auth/docs/refresh-tokens.md, "Your own store"). Every method is one
// statement except `rotate`, which is the one that has to be atomic.
class OrmRefreshStore {
  db: Db

  init(db: Db) {
    this.db = db
  }

  export insert(rec: RefreshRecord): ()! {
    this.db.table<RefreshRow>().insert(toRefreshRow(rec))?
  }

  export findByHash(hash: string): Option<RefreshRecord>! {
    let found = this.db.table<RefreshRow>().where("tokenHash", hash).first()?
    if (!isSome(found)) {
      return Option.None
    }
    return Option.Some(toRefreshRecord(unwrap(found)))
  }

  // The conditional UPDATE and the INSERT of the next token are one
  // transaction, and the UPDATE's row count is the answer: of two requests
  // rotating one token, Postgres lets the second UPDATE re-check the WHERE
  // after the first commits, finds `rotated_at` set, and touches no row. A
  // SELECT then an UPDATE would let both win. `db.tx` hands no value back
  // (15-transactions.md), so the answer travels out in `won`.
  export rotate(oldHash: string, next: RefreshRecord, at: i64): bool! {
    let won = []bool{ false }
    this.db.tx((tx) => {
      let row = tx.table<RefreshRow>().where("tokenHash", oldHash)
      let n = row.where("rotatedAt", 0).where("revoked", 0).set("rotatedAt", at).updateAll()?
      if (n == 0) {
        return
      }
      tx.table<RefreshRow>().insert(toRefreshRow(next))?
      won[0] = true
    })?
    return won[0]
  }

  export revokeFamily(family: string): ()! {
    this.db.table<RefreshRow>().where("family", family).set("revoked", 1).updateAll()?
  }

  export revokeSubject(subject: string): ()! {
    this.db.table<RefreshRow>().where("subject", subject).set("revoked", 1).updateAll()?
  }
}

fn tokenResponse(access: string, refresh: string): TokenResponse {
  return TokenResponse{
    accessToken = access, refreshToken = refresh, tokenType = "Bearer",
    expiresIn = accessTokenTtlSeconds,
  }
}

// `POST /auth/token`: the same `Strategy.authenticate(c)` `login` uses —
// same `Credentials` body, same Argon2id check — but issues a bearer token
// pair instead of a cookie session. `tokens.issue` starts a new refresh
// family: this login.
fn issueTokens(c: Ctx, db: Db, tokens: RefreshTokens, strategy: Strategy, jwtSecret: string): Res! {
  let identity = strategy.authenticate(c)?
  let u = findUserById(db, parseId(identity.id)?)?
  let refresh = tokens.issue("${u.id}")?
  return c.json(tokenResponse(issueAccessToken(u, jwtSecret)?, refresh))
}

export @json class RefreshInput {
  refreshToken: string,
}

// `POST /auth/token/refresh` (part 35): `tokens.rotate` swaps the presented
// refresh token for the next one in its family. A token that is unknown,
// expired, revoked or already rotated is one `InvalidRefreshToken` and one
// 401 message — presenting a rotated one also revokes the whole family
// (RFC 9700 section 4.14, pkg/auth/docs/refresh-tokens.md). Anything else
// is the store's failure and propagates as a 500.
fn refreshTokenRoute(c: Ctx, db: Db, tokens: RefreshTokens, jwtSecret: string): Res! {
  let input = c.body<RefreshInput>()?
  let next = tokens.rotate(input.refreshToken) catch e {
    let (_, invalid) = e.(InvalidRefreshToken)
    if (invalid) {
      fail unauthorized("invalid refresh token")
    }
    fail e
  }
  let u = findUserById(db, parseId(next.subject)?)?
  return c.json(tokenResponse(issueAccessToken(u, jwtSecret)?, next.token))
}

fn showApiMe(c: Ctx, db: Db): Res! {
  let identity = currentIdentity(c)?
  let u = findUserById(db, parseId(identity.id)?)?
  return c.json(toPublicUser(u))
}

// ---- Sign in with Google (part 36) ----------------------------------------

fn googleConfigured(cfg: AppConfig): bool {
  return len(cfg.googleClientId) > 0 &&
    len(cfg.googleClientSecret) > 0 &&
    len(cfg.googleRedirectUrl) > 0
}

// Built per-request rather than once at boot: `Provider.Google` calls
// `discover()` over the network (oidc_discovery.bit), and building it once
// would mean a boot-time dependency on Google being reachable, breaking
// every other route on a transient DNS/network hiccup for a feature most
// deployments of this course app leave disabled. `systemRoots()` (the OS CA
// bundle) is the same secure-by-default `TlsConfig` construction
// `pkg/postgres/adapter.bit` already uses.
fn buildGoogleStrategy(cfg: AppConfig): OidcStrategy! {
  // `systemRoots()` (std/crypto) returns the same `TrustStore` `TlsConfig(...)`
  // (std/tls) takes (#6155 unified what used to be two independent classes
  // of the identical shape), so no bridging copy is needed here any more.
  let sys = systemRoots()?
  let tls = TlsConfig(sys)
  return OidcStrategy(
    Provider.Google,
    cfg.googleClientId,
    cfg.googleClientSecret,
    cfg.googleRedirectUrl,
    OidcOptions{ tls = Option.Some(tls) },
  )?
}

fn googleBegin(c: Ctx, cfg: AppConfig): Res! {
  if (!googleConfigured(cfg)) {
    fail notFound()
  }
  return beginAuthorization(buildGoogleStrategy(cfg)?, c)?
}

// A Google `sub` this app has never seen signs in under a User row keyed by
// its verified email — `passwordHash = ""` (never a valid Argon2id PHC
// string, so `POST /auth/login` can never authenticate this row) marks the
// account as "created via Google", never a real local password.
fn findOrCreateGoogleUser(db: Db, email: string): User! {
  let found = db.table<User>().where("username", email).first()?
  if (isSome(found)) {
    return unwrap(found)
  }
  return insertUser(db, email, email, "", "author")?
}

// `handleCallback` (oidc_callback.bit) already verifies the ID token,
// regenerates the session id and stores the `Identity` under pkg/auth's own
// session key — this bridges that into THIS APP's own session convention
// (`sessionUserIdKey`/`sessionRoleKey`), the same one `login` writes, so
// `currentUserId`/`requireOwnerOrAdmin` work identically after a Google
// sign-in as after a password one.
fn googleCallback(c: Ctx, db: Db, cfg: AppConfig): Res! {
  if (!googleConfigured(cfg)) {
    fail notFound()
  }
  let identity = handleCallback(buildGoogleStrategy(cfg)?, c)?
  let emailField = jsonGet(identity.claims, "email")
  if (!isSome(emailField)) {
    fail unauthorized("Google identity carries no 'email' claim")
  }
  let email = jsonDecString(unwrap(emailField), "identity.claims.email")?
  let u = findOrCreateGoogleUser(db, email)?
  let session = c.session()?
  session.set(sessionUserIdKey, "${u.id}")
  session.set(sessionRoleKey, u.role)
  return c.noContent()
}

export fn mountAuth(app: App, db: Db, cfg: AppConfig): ()! {
  let tokens = RefreshTokens(OrmRefreshStore(db))?
  let strategy = PasswordStrategy(userLookup(db))
  let bearer = BearerStrategy(cfg.jwtSecret)
  app.post("/auth/register", (c) => register(c, db))
  app.post("/auth/login", (c) => login(c, strategy))
  app.post("/auth/logout", (c) => logout(c))
  app.post("/auth/token", (c) => issueTokens(c, db, tokens, strategy, cfg.jwtSecret))
  app.post("/auth/token/refresh", (c) => refreshTokenRoute(c, db, tokens, cfg.jwtSecret))
  app.get("/auth/google", (c) => googleBegin(c, cfg))
  app.get("/auth/google/callback", (c) => googleCallback(c, db, cfg))
  app.get("/me", (c) => showMe(c, db))
  let api = app.group("/api")
  api.use(requireAuth([bearer]))
  api.get("/me", (c) => showApiMe(c, db))
}

// ---- authorization: read back the role/id `login` (above) stored ----

export fn currentUserId(c: Ctx): i64! {
  let raw = c.session()?.get(sessionUserIdKey)
  if (len(raw) == 0) {
    fail unauthorized()
  }
  return parseId(raw)?
}

export fn currentRole(c: Ctx): string! {
  return c.session()?.get(sessionRoleKey)
}

// Fails `forbidden()` unless the caller is `ownerId` or carries the admin
// role — the rule articles.bit's edit/delete routes and comments.bit's
// delete route both need: "an author edits only their own articles; an
// admin role" (course part 12).
export fn requireOwnerOrAdmin(c: Ctx, ownerId: i64): ()! {
  let uid = currentUserId(c)?
  if (uid == ownerId) {
    return
  }
  let role = currentRole(c)?
  if (role != adminRole) {
    fail forbidden("you may only modify your own resource")
  }
}

// Fails `forbidden()` unless the caller carries the admin role — tags.bit's
// create route (tag taxonomy is shared, editorial, never per-author).
export fn requireAdmin(c: Ctx): ()! {
  let role = currentRole(c)?
  if (role != adminRole) {
    fail forbidden("admin role required")
  }
}
