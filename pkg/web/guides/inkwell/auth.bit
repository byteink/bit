// pkg/web/guides/inkwell/auth.bit — registration, login, logout, and the
// authorization helpers articles.bit/comments.bit call (#6062, epic #6061,
// course parts 10 "Registering users", 11 "Sessions and logging in", 12
// "Authorization"). `users.bit` owns the `User` entity; this file is the
// one place `pkg/auth`'s password flow is wired to it.
import { conflict, forbidden, minLen, unauthorized } from "web"
import {
  Identity, Lookup, LookupResult, Strategy, currentIdentity, hashPassword, newPasswordStrategy,
  requireAuth,
} from "auth"
import { UniqueViolation, applyTimestamps, classify, save } from "orm"
import { jsonDecString, jsonGet } from "std/json"
import { isSome, unwrap } from "std/core"

const adminRole = "admin"

// `pkg/auth`'s `Lookup` — the seam `newPasswordStrategy` calls with the
// POST body's `username`, per pkg/auth/docs/getting-started.md.
export fn userLookup(db: Data): Lookup {
  return (username) => {
    let u = findUserByUsername(db, username)?
    return LookupResult{ hash = u.passwordHash, id = "${u.id}", claims = userClaims(u) }
  }
}

export @json class RegisterInput {
  @minLen(3)
  username: string

  email: string

  @minLen(8)
  password: string
}

fn insertUser(db: Data, u: User): User! {
  let desc = userDesc()
  let values = userValues(u)
  let withStamps = applyTimestamps(desc, values, u.isPersisted(), u.tableAttrs(), now())?
  save(db, withStamps, values, u.isPersisted()) catch e {
    let cause = classify(e, desc.table)
    let (uv, ok) = cause.(UniqueViolation)
    if (ok) {
      fail conflict("that username or email is already registered")
    }
    fail cause
  }
  u.markPersisted(true)
  return u
}

fn register(c: Ctx, db: Data): Res! {
  let input = c.body<RegisterInput>()?
  let u = User{
    id = 0, username = input.username, email = input.email,
    passwordHash = hashPassword(input.password), role = "author", createdAt = 0, updatedAt = 0,
  }
  let saved = insertUser(db, u)?
  return c.created("${saved.id}").header("Content-Type", "application/json").header("Location", "/users/${saved.id}")
}

fn logout(c: Ctx): Res! {
  c.session()?.destroy()?
  return c.noContent()
}

fn showMe(c: Ctx, db: Data): Res! {
  let identity = currentIdentity(c) catch _ {
    fail unauthorized()
  }
  let id = parseId(identity.id)?
  let u = findUserById(db, id)?
  return c.json(toPublicUser(u))
}

export fn mountAuth(app: App, db: Data) {
  let a = app.group("/auth")
  let login = a.group("/login")
  login.use(requireAuth([]Strategy{ newPasswordStrategy(userLookup(db)) }))
  login.post("/", (c) => showMe(c, db))
  a.post("/register", (c) => register(c, db))
  a.post("/logout", (c) => logout(c))
  app.get("/me", (c) => showMe(c, db))
}

// ---- authorization: read back the role/id `requireAuth` attached ----

export fn currentUserId(c: Ctx): i64! {
  let identity = currentIdentity(c) catch _ {
    fail unauthorized()
  }
  return parseId(identity.id)?
}

export fn currentRole(c: Ctx): string! {
  let identity = currentIdentity(c) catch _ {
    fail unauthorized()
  }
  let role = jsonGet(identity.claims, "role")
  if (!isSome(role)) {
    return ""
  }
  return jsonDecString(unwrap(role), "identity.claims.role")?
}

// Fails `forbidden()` unless the caller is `ownerId` or carries the admin
// role — the rule articles.bit's edit/delete routes and comments.bit's
// delete route both need: "an author edits only their own articles; an
// admin role" (course part 12).
export fn requireOwnerOrAdmin(c: Ctx, ownerId: i64): ()! {
  let uid = currentUserId(c)?
  if (uid == ownerId) {
    return
  }
  let role = currentRole(c)?
  if (role != adminRole) {
    fail forbidden("you may only modify your own resource")
  }
}

// Fails `forbidden()` unless the caller carries the admin role — tags.bit's
// create route (tag taxonomy is shared, editorial, never per-author).
export fn requireAdmin(c: Ctx): ()! {
  let role = currentRole(c)?
  if (role != adminRole) {
    fail forbidden("admin role required")
  }
}
