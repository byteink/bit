// pkg/web/guides/inkwell/db.bit — the PostgreSQL pool and the migration
// registry `main.bit` runs at boot (#6062, epic #6061, course parts 6
// "Connecting to PostgreSQL" and 7 "Tables and migrations with pkg/orm").
//
// The registry is a hand-written list, per pkg/orm/docs/migrate.md's
// "Known gap, stated up front": `generate()` does not yet write or wire a
// checked-in registry file, so `migrations()` below is exactly what that
// page says to write by hand today.
import {
  Data,
  Migration,
  ManyToManyDesc,
  Postgres,
  ReferentialAction,
  RunnerDialect,
  SchemaOp,
  ServerDialect,
  UpReport,
  alter,
  manyToManyTable,
  table,
  up,
} from "orm"
import { Datasource, Pool, Value, pool } from "std/sql"
import { adapter } from "postgres"
import { Second, now } from "std/time"

// The `article_tags` join table's shape — shared between the migration
// below and articles.bit's `manyToManyLoader`/`attach`/`detach`/`sync`
// calls, so both sides name the same table and columns exactly once
// (pkg/orm/docs/manytomany.md).
export fn articleTagsDesc(): ManyToManyDesc {
  return ManyToManyDesc{
    joinTable = "article_tags", ownerColumn = "article_id", ownerTable = "articles",
    ownerIdColumn = "id", targetColumn = "tag_id", targetTable = "tags", targetIdColumn = "id",
  }
}

export fn openPool(cfg: AppConfig): Pool! {
  return pool(adapter(), Datasource{ uri = cfg.databaseUrl })?
}

export fn postgresDialect(): RunnerDialect {
  return RunnerDialect{ render = Postgres{}, server = ServerDialect.Postgres }
}

fn usersMigration(): Migration {
  return Migration{
    version = 1,
    name = "create_users",
    checksum = "inkwell-users-1",
    apply = () => [
      table("users", (t) => {
        t.id("id")
        t.string("username", 60).unique()
        t.string("email", 255).unique()
        t.string("password_hash", 255)
        t.string("role", 20)
        t.int("created_at")
        t.int("updated_at")
      }),
    ],
    revert = () => [
      alter("users", (t) => {
        t.dropColumn("role")
      }),
    ],
  }
}

fn articlesMigration(): Migration {
  return Migration{
    version = 2,
    name = "create_articles",
    checksum = "inkwell-articles-1",
    apply = () => [
      table("articles", (t) => {
        t.id("id")
        t.string("title", 200)
        t.string("slug", 220).unique()
        t.text("body")
        t.int("author_id")
        t.int("created_at")
        t.int("updated_at")
        t.index("author_id")
        t.foreign("author_id").references("users", "id").onDelete(ReferentialAction.Cascade)
      }),
    ],
    revert = () => [
      alter("articles", (t) => {
        t.dropColumn("slug")
      }),
    ],
  }
}

fn tagsMigration(): Migration {
  return Migration{
    version = 3,
    name = "create_tags",
    checksum = "inkwell-tags-1",
    apply = () => [
      table("tags", (t) => {
        t.id("id")
        t.string("name", 60).unique()
      }),
    ],
    revert = () => [
      alter("tags", (t) => {
        t.dropColumn("name")
      }),
    ],
  }
}

fn commentsMigration(): Migration {
  return Migration{
    version = 4,
    name = "create_comments",
    checksum = "inkwell-comments-1",
    apply = () => [
      table("comments", (t) => {
        t.id("id")
        t.int("article_id")
        t.int("author_id")
        t.text("body")
        t.int("created_at")
        t.int("updated_at")
        t.index("article_id")
        t.foreign("article_id").references("articles", "id").onDelete(ReferentialAction.Cascade)
        t.foreign("author_id").references("users", "id").onDelete(ReferentialAction.Cascade)
      }),
    ],
    revert = () => [
      alter("comments", (t) => {
        t.dropColumn("body")
      }),
    ],
  }
}

fn articleTagsMigration(): Migration {
  return Migration{
    version = 5,
    name = "create_article_tags",
    checksum = "inkwell-article-tags-1",
    apply = () => [manyToManyTable(articleTagsDesc())],
    revert = () => []SchemaOp(0),
  }
}

// #6129: `deleted_at`/`version` back `articles.bit`'s `@softDelete`/
// `@version` marks on `Article`. Added on an empty `articles` table (no
// prior migration ever inserts a row), so a `NOT NULL` `version` with no
// default is safe here the same way `articlesMigration`'s own `t.id("id")`
// is; `deleted_at` stays nullable, unset for every existing row. An `int`
// column, not `timestamp` — `Repo<T>.delete()` (pkg/orm/repo.bit) writes
// `deletedAt` as epoch nanoseconds via `sqlValue(now().ns)`, the same
// convention `created_at`/`updated_at` already use here; a native `timestamp`
// column rejects that value outright (Postgres 22008, "date/time field value
// out of range").
fn articleSoftDeleteVersionMigration(): Migration {
  return Migration{
    version = 6,
    name = "add_article_deleted_at_and_version",
    checksum = "inkwell-articles-softdelete-version-1",
    apply = () => [
      alter("articles", (t) => {
        t.int("deleted_at").nullable()
        t.int("version")
      }),
    ],
    revert = () => [
      alter("articles", (t) => {
        t.dropColumn("deleted_at")
        t.dropColumn("version")
      }),
    ],
  }
}

// #6131: refresh tokens for `POST /auth/token/refresh`. `token_hash` is the
// SHA-256 hex of the opaque refresh token — never the raw token itself, the
// same "hashed at rest" discipline `users.password_hash` already carries.
// `rotated` stays an int (0/1) column rather than a native `boolean` one —
// `RefreshToken.rotated` (auth.bit) is `i64` to match, so this migration
// never has to change when the app's own write path does.
fn refreshTokensMigration(): Migration {
  return Migration{
    version = 7,
    name = "create_refresh_tokens",
    checksum = "inkwell-refresh-tokens-1",
    apply = () => [
      table("refresh_tokens", (t) => {
        t.id("id")
        t.int("user_id")
        t.string("token_hash", 64).unique()
        t.int("expires_at")
        t.int("rotated")
        t.int("created_at")
        t.index("user_id")
        t.foreign("user_id").references("users", "id").onDelete(ReferentialAction.Cascade)
      }),
    ],
    revert = () => [
      alter("refresh_tokens", (t) => {
        t.dropColumn("token_hash")
      }),
    ],
  }
}

export fn migrations(): []Migration {
  return [
    usersMigration(), articlesMigration(), tagsMigration(), commentsMigration(),
    articleTagsMigration(), articleSoftDeleteVersionMigration(), refreshTokensMigration(),
  ]
}

// #6129: the full-text search column and its GIN index, RAW SQL rather than
// the schema DSL above — `pkg/orm/schema.bit`'s `ColumnType` has no
// `tsvector` variant and the migration `SchemaOp` tree has no generated-
// column or `using gin` support (course scope per #6071's audit). Both
// statements are `IF NOT EXISTS`, so running this again on every boot is a
// no-op. Runs on the raw migrations connection (`db: Data`), not the app's
// `Db` — migrations and schema creation stay on the pre-#6270 API, per
// #6294's own scope: not yet approved for `db.exec`.
export fn ensureArticleSearchIndex(db: Data): ()! {
  db.exec(
    "alter table articles add column if not exists search_vector tsvector generated always as (to_tsvector('english', coalesce(title, '') || ' ' || coalesce(body, ''))) stored",
    []Value(0),
  )?
  db.exec(
    "create index if not exists articles_search_vector_idx on articles using gin (search_vector)",
    []Value(0),
  )?
}

// Runs every pending migration, in order, under the advisory lock
// `up()` takes, then the raw-SQL search index above — called once at boot
// (main.bit), never per request.
export fn runMigrations(db: Data): UpReport! {
  let report = up(db, postgresDialect(), migrations(), now())?
  ensureArticleSearchIndex(db)?
  return report
}
