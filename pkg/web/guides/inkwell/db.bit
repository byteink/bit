// pkg/web/guides/inkwell/db.bit — the raw PostgreSQL pool `app.test.bit`
// opens to verify a row directly against the database, alongside the app's
// own `orm.open` connection (#6062, epic #6061, course part 6 "Connecting
// to PostgreSQL"). The app itself opens exactly one connection now
// (main.bit's `open(cfg.databaseUrl)`); schema setup runs separately,
// through `bit migrate` against `migrations/*.bit` (O6, #6315) — see that
// directory's own files for what used to be this file's own migration
// registry and boot-time apply function.
import { Datasource, Pool, Value, pool } from "std/sql"
import { adapter } from "postgres"
import { Second, now } from "std/time"

export fn openPool(cfg: AppConfig): Pool! {
  return pool(adapter(), Datasource{ uri = cfg.databaseUrl })?
}
