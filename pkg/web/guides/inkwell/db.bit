// pkg/web/guides/inkwell/db.bit — the PostgreSQL pool and the migration
// registry `main.bit` runs at boot (#6062, epic #6061, course parts 6
// "Connecting to PostgreSQL" and 7 "Tables and migrations with pkg/orm").
//
// The registry is a hand-written list, per pkg/orm/docs/migrate.md's
// "Known gap, stated up front": `generate()` does not yet write or wire a
// checked-in registry file, so `migrations()` below is exactly what that
// page says to write by hand today.
import {
  Data,
  Migration,
  ManyToManyDesc,
  Postgres,
  ReferentialAction,
  RunnerDialect,
  ServerDialect,
  UpReport,
  alter,
  manyToManyTable,
  table,
  up,
} from "orm"
import { Datasource, Pool, pool } from "std/sql"
import { adapter } from "postgres"
import { now } from "std/time"

// The `article_tags` join table's shape — shared between the migration
// below and articles.bit's `manyToManyLoader`/`attach`/`detach`/`sync`
// calls, so both sides name the same table and columns exactly once
// (pkg/orm/docs/manytomany.md).
export fn articleTagsDesc(): ManyToManyDesc {
  return ManyToManyDesc{
    joinTable = "article_tags", ownerColumn = "article_id", ownerTable = "articles",
    ownerIdColumn = "id", targetColumn = "tag_id", targetTable = "tags", targetIdColumn = "id",
  }
}

export fn openPool(cfg: AppConfig): Pool! {
  return pool(adapter(), Datasource{ uri = cfg.databaseUrl })?
}

export fn postgresDialect(): RunnerDialect {
  return RunnerDialect{ render = Postgres{}, server = ServerDialect.Postgres }
}

fn usersMigration(): Migration {
  return Migration{
    version = 1,
    name = "create_users",
    checksum = "inkwell-users-1",
    apply = () => [
      table("users", (t) => {
        t.id("id")
        t.string("username", 60).unique()
        t.string("email", 255).unique()
        t.string("password_hash", 255)
        t.string("role", 20)
        t.timestamp("created_at")
        t.timestamp("updated_at")
      }),
    ],
    revert = () => [alter("users", (t) => { t.dropColumn("role") })],
  }
}

fn articlesMigration(): Migration {
  return Migration{
    version = 2,
    name = "create_articles",
    checksum = "inkwell-articles-1",
    apply = () => [
      table("articles", (t) => {
        t.id("id")
        t.string("title", 200)
        t.string("slug", 220).unique()
        t.text("body")
        t.int("author_id")
        t.timestamp("created_at")
        t.timestamp("updated_at")
        t.index("author_id")
        t.foreign("author_id").references("users", "id").onDelete(ReferentialAction.Cascade)
      }),
    ],
    revert = () => [alter("articles", (t) => { t.dropColumn("slug") })],
  }
}

fn tagsMigration(): Migration {
  return Migration{
    version = 3,
    name = "create_tags",
    checksum = "inkwell-tags-1",
    apply = () => [
      table("tags", (t) => {
        t.id("id")
        t.string("name", 60).unique()
      }),
    ],
    revert = () => [alter("tags", (t) => { t.dropColumn("name") })],
  }
}

fn commentsMigration(): Migration {
  return Migration{
    version = 4,
    name = "create_comments",
    checksum = "inkwell-comments-1",
    apply = () => [
      table("comments", (t) => {
        t.id("id")
        t.int("article_id")
        t.int("author_id")
        t.text("body")
        t.timestamp("created_at")
        t.timestamp("updated_at")
        t.index("article_id")
        t.foreign("article_id").references("articles", "id").onDelete(ReferentialAction.Cascade)
        t.foreign("author_id").references("users", "id").onDelete(ReferentialAction.Cascade)
      }),
    ],
    revert = () => [alter("comments", (t) => { t.dropColumn("body") })],
  }
}

fn articleTagsMigration(): Migration {
  return Migration{
    version = 5,
    name = "create_article_tags",
    checksum = "inkwell-article-tags-1",
    apply = () => [manyToManyTable(articleTagsDesc())],
    revert = () => [],
  }
}

export fn migrations(): []Migration {
  return [
    usersMigration(), articlesMigration(), tagsMigration(), commentsMigration(),
    articleTagsMigration(),
  ]
}

// Runs every pending migration, in order, under the advisory lock
// `up()` takes — called once at boot (main.bit), never per request.
export fn runMigrations(db: Data): UpReport! {
  return up(db, postgresDialect(), migrations(), now())?
}
