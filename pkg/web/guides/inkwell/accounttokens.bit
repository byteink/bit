import { OneTimeRecord } from "auth"

@table("account_tokens") class AccountTokenRow {
  id: i64,
  tokenHash: string,
  purpose: string,
  userId: i64,
  expiresAt: i64,
  data: string,
}

fn accountTokenHashCheck(hash: string): ()! {
  if (len(hash) != 64) {
    fail newError("inkwell: account token store requires a SHA-256 hash")
  }
  let i = 0
  while (i < 64) {
    let b = hash[i]
    if (!((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f'))) {
      fail newError("inkwell: account token store requires a SHA-256 hash")
    }
    i = i + 1
  }
}

fn accountTokenOwner(tx: TxHandle, subject: string): i64! {
  let id = parseId(subject) catch _ {
    fail newError("inkwell: account token subject is not an existing user")
  }
  if (id <= 0 || "${id}" != subject) {
    fail newError("inkwell: account token subject is not an existing user")
  }
  let owner = tx.query<User>("select * from users where id = ? for update", id)?
  if (len(owner) == 0) {
    fail newError("inkwell: account token subject is not an existing user")
  }
  return id
}

fn accountTokenRow(hash: string, rec: OneTimeRecord, userId: i64): AccountTokenRow {
  return AccountTokenRow{
    id = 0, tokenHash = hash, purpose = rec.purpose, userId = userId,
    expiresAt = rec.expiresAt, data = rec.data,
  }
}

fn accountTokenRecord(row: AccountTokenRow): OneTimeRecord {
  return OneTimeRecord{
    purpose = row.purpose, subject = "${row.userId}", expiresAt = row.expiresAt, data = row.data,
  }
}

fn accountTokenInput(hash: string, rec: OneTimeRecord, ttl: i64): ()! {
  accountTokenHashCheck(hash)?
  if (rec.purpose == "" || ttl <= 0) {
    fail newError("inkwell: account token purpose and positive lifetime are required")
  }
}

// OneTimeTokens owns hashing and purpose/expiry checks; the app store owns atomic persistence.
class InkwellOneTimeTxStore {
  tx: TxHandle

  init(tx: TxHandle) {
    this.tx = tx
  }

  export put(hash: string, rec: OneTimeRecord, ttl: i64): ()! {
    accountTokenInput(hash, rec, ttl)?
    let id = accountTokenOwner(this.tx, rec.subject)?
    this.tx.table<AccountTokenRow>().insert(accountTokenRow(hash, rec, id))?
  }

  export replace(hash: string, rec: OneTimeRecord, ttl: i64): ()! {
    accountTokenInput(hash, rec, ttl)?
    // Lock the stable user even when no token exists, so concurrent inserts cannot race.
    let id = accountTokenOwner(this.tx, rec.subject)?
    this.tx.exec("delete from account_tokens where user_id = ? and purpose = ?", id, rec.purpose)?
    this.tx.table<AccountTokenRow>().insert(accountTokenRow(hash, rec, id))?
  }

  export take(hash: string): Option<OneTimeRecord>! {
    accountTokenHashCheck(hash)?
    let candidates = this.tx.query<AccountTokenRow>(
      "select * from account_tokens where token_hash = ?", hash,
    )?
    if (len(candidates) == 0) {
      return Option.None
    }
    assert(len(candidates) == 1, "account token hash must be unique")
    // Match replacement's user-before-token order; recheck the candidate after the wait.
    let id = accountTokenOwner(this.tx, "${candidates[0].userId}")?
    let rows = this.tx.query<AccountTokenRow>(
      "delete from account_tokens where token_hash = ? and user_id = ? returning *", hash, id,
    )?
    if (len(rows) == 0) {
      return Option.None
    }
    assert(len(rows) == 1, "account token hash must be unique")
    return Option.Some(accountTokenRecord(rows[0]))
  }

  export revokeSubject(purpose: string, subject: string): ()! {
    if (purpose == "") {
      fail newError("inkwell: account token purpose is required")
    }
    let id = accountTokenOwner(this.tx, subject)?
    this.tx.exec("delete from account_tokens where user_id = ? and purpose = ?", id, purpose)?
  }
}

class InkwellOneTimeStore {
  db: Db

  init(db: Db) {
    this.db = db
  }

  export put(hash: string, rec: OneTimeRecord, ttl: i64): ()! {
    this.db.tx((tx) => InkwellOneTimeTxStore(tx).put(hash, rec, ttl))?
  }

  export replace(hash: string, rec: OneTimeRecord, ttl: i64): ()! {
    this.db.tx((tx) => InkwellOneTimeTxStore(tx).replace(hash, rec, ttl))?
  }

  export take(hash: string): Option<OneTimeRecord>! {
    let result: Option<OneTimeRecord> = Option.None
    this.db.tx((tx) => {
      result = InkwellOneTimeTxStore(tx).take(hash)?
    })?
    return result
  }

  export revokeSubject(purpose: string, subject: string): ()! {
    this.db.tx((tx) => InkwellOneTimeTxStore(tx).revokeSubject(purpose, subject))?
  }
}
