// Sign-in history contains account IDs, never credentials or bearer tokens.
fn recordLoginAudit(tx: TxHandle, subject: string): ()! {
  let id = parseId(subject)?
  recordAudit(tx, id, "auth.login", "user/${id}")?
}

fn auditSignIn(c: Ctx, db: Db, subject: string): ()! {
  db.tx((tx) => recordLoginAudit(tx, subject)) catch e {
    c.session()?.destroy()?
    fail e
  }
}

// A new refresh family and its sign-in event must commit together.
class LoginRefreshStore {
  base: OrmRefreshStore

  init(db: Db) {
    this.base = OrmRefreshStore(db)
  }

  export insert(rec: RefreshRecord): ()! {
    this.base.db.tx((tx) => {
      tx.table<RefreshRow>().insert(toRefreshRow(rec))?
      recordLoginAudit(tx, rec.subject)?
    })?
  }

  export findByHash(hash: string): Option<RefreshRecord>! {
    return this.base.findByHash(hash)?
  }

  export rotate(oldHash: string, next: RefreshRecord, at: i64): bool! {
    return this.base.rotate(oldHash, next, at)?
  }

  export revokeFamily(family: string): ()! {
    this.base.revokeFamily(family)?
  }

  export revokeSubject(subject: string): ()! {
    this.base.revokeSubject(subject)?
  }
}
