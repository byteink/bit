// pkg/web/guides/inkwell/users.bit — the `User` entity and its one public
// route (#6062, epic #6061, course part 9 "Relationships"). Registration
// and login live in auth.bit, which calls `findUserByUsername` below as
// its `Lookup`. Every route here is a closure over `db: Data`, captured at
// mount time in `mountUsers` — `Ctx` carries the request, never a database
// handle (see pkg/web/docs/request.md's own `Ctx` surface).
import { App, Ctx, Res, badRequest, notFound } from "web"
import { Query, TableDesc, find } from "orm"
import { AttrDesc, FieldDesc, Rows, Value, sqlReqInt, sqlReqText } from "std/sql"
import { Json, JsonEntry } from "std/json"

@table @timestamps class User {
  @id
  id: i64
  username: string
  email: string
  passwordHash: string
  // "author" or "admin" — checked by auth.bit's `requireAdmin`/`isOwner`.
  role: string
  createdAt: i64
  updatedAt: i64
}

fn userPlaceholder(): User {
  return User{
    id = 0, username = "", email = "", passwordHash = "", role = "", createdAt = 0, updatedAt = 0,
  }
}

export fn userDesc(): TableDesc {
  return TableDesc{
    table = "users", fields = userPlaceholder().tableDescriptor(), classAttrs = []AttrDesc(0),
  }
}

export fn userValues(u: User): map<string, Value> {
  return map<string, Value>{
    "id": Value.Int(u.id),
    "username": Value.Text(u.username),
    "email": Value.Text(u.email),
    "passwordHash": Value.Text(u.passwordHash),
    "role": Value.Text(u.role),
  }
}

fn userMapper(rows: Rows): User! {
  let cols = rows.columns()
  return User{
    id = sqlReqInt(rows, cols, "id")?,
    username = sqlReqText(rows, cols, "username")?,
    email = sqlReqText(rows, cols, "email")?,
    passwordHash = sqlReqText(rows, cols, "password_hash")?,
    role = sqlReqText(rows, cols, "role")?,
    createdAt = sqlReqInt(rows, cols, "created_at")?,
    updatedAt = sqlReqInt(rows, cols, "updated_at")?,
  }
}

export fn users(db: Data): Query<User> {
  return find<User>(db, "users", userDesc().fields, userMapper)
}

export fn findUserById(db: Data, id: i64): User! {
  return users(db).where("id", Value.Int(id)).oneOrFail()?
}

// The `Lookup` auth.bit's password strategy calls: username in, the stored
// hash and enough to build an `Identity` out.
export fn findUserByUsername(db: Data, username: string): User! {
  return users(db).where("username", Value.Text(username)).oneOrFail()?
}

// Rides along on a successful login as `Identity.claims`, so a protected
// route can read the caller's role back without a second query (see
// auth.bit's `currentRole`).
export fn userClaims(u: User): Json {
  return Json.JsonObject([JsonEntry{ key = "role", value = Json.JsonString(u.role) }])
}

// The public shape a client is allowed to see — never `passwordHash`.
export @json class PublicUser {
  id: i64,
  username: string,
  role: string,
}

export fn toPublicUser(u: User): PublicUser {
  return PublicUser{ id = u.id, username = u.username, role = u.role }
}

export fn parseId(s: string): i64! {
  return parseInt(s)?
}

fn showUser(c: Ctx, db: Data): Res! {
  let id = parseId(c.param("id")) catch _ {
    fail badRequest("id must be an integer")
  }
  let u = findUserById(db, id) catch _ {
    fail notFound("no user with that id")
  }
  return c.json(toPublicUser(u))
}

export fn mountUsers(app: App, db: Data) {
  let group = app.group("/users")
  group.get("/:id", (c) => showUser(c, db))
}
