// Nightly digests share the app's database and use the existing Redis job queue.
import { Queue, Options as JobOptions, RedisStore, RedisLocker, open as openJobs } from "jobs"
import { getDefault as digestLogger } from "std/log"
import { Hour as DigestHour } from "std/time"

@job("nightly-digest") @json class NightlyDigest {}

@job("send-welcome-email") @json class SendWelcomeEmail {
  email: string,
  username: string,
  verificationLink: Option<string> = Option.None,
}

@job("send-password-reset-email") @json class SendPasswordResetEmail { email: string }

@table("articles") class DigestCount {
  total: i64,
}

fn digestArticleCount(db: Db, at: i64): i64! {
  let since = at - i64(24 * DigestHour)
  let rows = db.query<DigestCount>(
    "select count(*) as total from articles where deleted_at is null and created_at >= ? and created_at < ?",
    since, at,
  )?
  assert(len(rows) == 1, "digest count must return one row")
  return rows[0].total
}

fn runNightlyDigest(db: Db): ()! {
  let total = digestArticleCount(db, now().ns)?
  digestLogger().info().int("articles", int(total)).log("nightly article digest")
}

fn deliverWelcome(cfg: AppConfig, job: SendWelcomeEmail): ()! {
  // A relay can echo the bearer link in its refusal; jobs logs handler failures.
  sendWelcome(cfg, job.email, job.username, job.verificationLink) catch _ {
    fail newError("inkwell: welcome email delivery failed")
  }
}

fn openMailQueue(cfg: AppConfig, redis: RedisClient): Queue! {
  validateMailConfig(cfg)?
  let store = RedisStore(redis, prefix = "{inkwell:jobs}")?
  let locker = RedisLocker(redis, prefix = "{inkwell:jobs}")?
  let q = openJobs(store, JobOptions{ workers = 1, locker = locker })?
  q.register<SendWelcomeEmail>((job) => deliverWelcome(cfg, job))?
  return q
}

fn openDigestQueue(db: Db, redis: RedisClient, cfg: AppConfig): Queue! {
  let q = openMailQueue(cfg, redis)?
  q.register<SendPasswordResetEmail>((job) => deliverPasswordReset(db, cfg, job))?
  q.register<NightlyDigest>((job) => {
    runNightlyDigest(db)?
  })?
  q.schedule("0 2 * * *", NightlyDigest{}, tz = "UTC")?
  return q
}

fn sendPasswordReset(db: Db, cfg: AppConfig, email: string): ()! {
  let link = ""
  db.tx((tx) => {
    let users = tx.query<User>("select * from users where email = ?", email)?
    if (len(users) == 0) {
      return
    }
    let user = users[0]
    let token = OneTimeTokens(InkwellOneTimeTxStore(tx))?.issue(
      "password-reset", "${user.id}", 3600, user.email, live = Live.One,
    )?
    link = verifyLink(cfg.resetPasswordUrl, token)?
  })?
  if (link != "") {
    sendResetMail(cfg, email, link)?
  }
}

fn deliverPasswordReset(db: Db, cfg: AppConfig, job: SendPasswordResetEmail): ()! {
  // Both database errors and relay refusals can contain sensitive job data.
  sendPasswordReset(db, cfg, job.email) catch _ {
    fail newError("inkwell: password reset email delivery failed")
  }
}
