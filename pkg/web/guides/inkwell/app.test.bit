test "the article list paginates: a 1-item page reports the real total and a next cursor" {
  let app = testApp()
  let username = uniqueName("pager")
  let cookie = registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }
  postArticle(app, cookie, "Pager One", "[]") catch e {
    panic(e.message())
  }
  postArticle(app, cookie, "Pager Two", "[]") catch e {
    panic(e.message())
  }

  let res = app.handle(
    Request{
      method = "GET", path = "/articles?limit=1&page=1&sort=newest", headers = "", body = "",
    },
  )
  assert(res.status == 200, "want 200 listing articles, got ${res.status}")
  assert(contains(res.body, "\"meta\""), "paginated list must carry a meta block: ${res.body}")
  assert(
    contains(res.body, "\"limit\":1"),
    "meta.limit did not reflect the requested limit: ${res.body}",
  )
}

// The value of a top-level `"<key>":"<value>"` string field, or `""` when
// absent — the same string-search convention `idFromLocation` above uses,
// good enough for a plain JWT/hex token with no characters JSON would ever
// escape.
fn jsonStringField(body: string, key: string): string {
  let marker = "\"${key}\":\""
  let start = indexOf(body, marker)
  if (start < 0) {
    return ""
  }
  let rest = body[start + len(marker):len(body)]
  let end = indexOf(rest, "\"")
  if (end < 0) {
    return ""
  }
  return rest[0:end]
}

fn bearerReq(method: string, path: string, token: string): Request {
  return Request{
    method = method, path = path, headers = "Authorization: Bearer ${token}", body = "",
  }
}

test "POST /auth/token issues a bearer token, and GET /api/me accepts it" {
  let app = testApp()
  let username = uniqueName("bearer")
  registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }

  let tokenBody = "{\"username\":\"${username}\",\"password\":\"correct horse battery\"}"
  let tokenRes = app.handle(jsonReq("POST", "/auth/token", "", tokenBody))
  assert(tokenRes.status == 200, "want 200 from /auth/token, got ${tokenRes.status}")
  let accessToken = jsonStringField(tokenRes.body, "accessToken")
  assert(len(accessToken) > 0, "no accessToken in response: ${tokenRes.body}")

  let noAuth = app.handle(Request{ method = "GET", path = "/api/me", headers = "", body = "" })
  assert(noAuth.status == 401, "want 401 for /api/me with no bearer token, got ${noAuth.status}")

  let me = app.handle(bearerReq("GET", "/api/me", accessToken))
  assert(me.status == 200, "want 200 from /api/me with a valid bearer token, got ${me.status}")
  assert(contains(me.body, username), "/api/me did not name the caller: ${me.body}")
}

// Logs `username` in through `POST /auth/token` and returns the response's
// `refreshToken`.
fn loginForRefreshToken(app: App, username: string): string {
  registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }
  let tokenBody = "{\"username\":\"${username}\",\"password\":\"correct horse battery\"}"
  let tokenRes = app.handle(jsonReq("POST", "/auth/token", "", tokenBody))
  let refreshToken = jsonStringField(tokenRes.body, "refreshToken")
  assert(len(refreshToken) > 0, "no refreshToken in response: ${tokenRes.body}")
  return refreshToken
}

fn postRefresh(app: App, refreshToken: string): Response {
  return app.handle(
    jsonReq("POST", "/auth/token/refresh", "", "{\"refreshToken\":\"${refreshToken}\"}"),
  )
}

test "POST /auth/token/refresh rotates the refresh token" {
  let app = testApp()
  let first = loginForRefreshToken(app, uniqueName("refresher"))

  let rotated = postRefresh(app, first)
  assert(rotated.status == 200, "want 200 rotating a fresh refresh token, got ${rotated.status}")
  let newAccessToken = jsonStringField(rotated.body, "accessToken")
  assert(len(newAccessToken) > 0, "no accessToken in rotation response: ${rotated.body}")
  let second = jsonStringField(rotated.body, "refreshToken")
  assert(
    len(second) > 0 && second != first,
    "rotation did not issue a new refresh token: ${rotated.body}",
  )

  let me = app.handle(bearerReq("GET", "/api/me", newAccessToken))
  assert(me.status == 200, "want 200 from /api/me with the rotated access token, got ${me.status}")

  let again = postRefresh(app, second)
  assert(again.status == 200, "want 200 rotating the second refresh token, got ${again.status}")
}

test "replaying a rotated refresh token revokes the whole family" {
  let app = testApp()
  let first = loginForRefreshToken(app, uniqueName("replayer"))
  let rotated = postRefresh(app, first)
  assert(rotated.status == 200, "want 200 rotating a fresh refresh token, got ${rotated.status}")
  let second = jsonStringField(rotated.body, "refreshToken")

  let replay = postRefresh(app, first)
  assert(replay.status == 401, "want 401 replaying a rotated refresh token, got ${replay.status}")

  // RFC 9700 section 4.14: the replay revoked the family, so the token the
  // legitimate holder got from the rotation is dead too.
  let revoked = postRefresh(app, second)
  assert(
    revoked.status == 401,
    "want 401 for the second token after its family was revoked, got ${revoked.status}",
  )
}

test "POST /auth/token/refresh answers every bad token with the same 401" {
  let app = testApp()
  let first = loginForRefreshToken(app, uniqueName("prober"))
  let _ = postRefresh(app, first)
  let replay = postRefresh(app, first)
  let unknown = postRefresh(app, "not-a-token")
  assert(
    replay.status == 401 && unknown.status == 401,
    "want 401 for a replay and an unknown token",
  )
  assert(
    replay.body == unknown.body,
    "a replayed and an unknown token must look the same: ${replay.body} vs ${unknown.body}",
  )
  assert(contains(replay.body, "invalid refresh token"), "unexpected 401 body: ${replay.body}")
}

test "OrmRefreshStore.rotate lets exactly one of two rotations of a token win" {
  let cfg = testConfig() catch e {
    panic(e.message())
  }
  let db = open(cfg.databaseUrl) catch e {
    panic(e.message())
  }
  let store = OrmRefreshStore(db)
  let hash = uniqueName("hash")
  let rec = RefreshRecord{
    hash = hash, family = uniqueName("family"), subject = "1", expiresAt = 2_000_000_000,
    familyExpiresAt = 2_000_000_000, data = "",
  }
  store.insert(rec) catch e {
    panic(e.message())
  }
  let next1 = RefreshRecord{
    hash = uniqueName("n1"), family = rec.family, subject = "1", expiresAt = 2_000_000_000,
    familyExpiresAt = 2_000_000_000, data = "",
  }
  let next2 = RefreshRecord{
    hash = uniqueName("n2"), family = rec.family, subject = "1", expiresAt = 2_000_000_000,
    familyExpiresAt = 2_000_000_000, data = "",
  }
  let first = store.rotate(hash, next1, 100) catch e {
    panic(e.message())
  }
  let second = store.rotate(hash, next2, 101) catch e {
    panic(e.message())
  }
  assert(first, "the first rotation of a fresh token must win")
  assert(!second, "the second rotation of the same token must lose")
  let stored = store.findByHash(next2.hash) catch e {
    panic(e.message())
  }
  assert(!isSome(stored), "a lost rotation must not store its next token")
}

fn rotateWorker(
  store: OrmRefreshStore,
  hash: string,
  next: RefreshRecord,
  wins: chan<bool>,
  wg: WaitGroup,
) {
  defer wg.done()
  let won = store.rotate(hash, next, 100) catch _ {
    wins <- false
    return
  }
  wins <- won
}

test "OrmRefreshStore.rotate lets exactly one of 16 concurrent rotations win" {
  let cfg = testConfig() catch e {
    panic(e.message())
  }
  let db = open(cfg.databaseUrl) catch e {
    panic(e.message())
  }
  let store = OrmRefreshStore(db)
  let hash = uniqueName("race")
  let family = uniqueName("family")
  store.insert(
    RefreshRecord{
      hash = hash, family = family, subject = "1", expiresAt = 2_000_000_000,
      familyExpiresAt = 2_000_000_000, data = "",
    },
  ) catch e {
    panic(e.message())
  }
  let n = 16
  let wins = chan<bool>(n)
  let wg = WaitGroup()
  wg.add(n)
  let i = 0
  while (i < n) {
    let next = RefreshRecord{
      hash = uniqueName("next"), family = family, subject = "1", expiresAt = 2_000_000_000,
      familyExpiresAt = 2_000_000_000, data = "",
    }
    spawn rotateWorker(store, hash, next, wins, wg)
    i = i + 1
  }
  wg.wait()
  let won = 0
  let k = 0
  while (k < n) {
    if (<- wins) {
      won = won + 1
    }
    k = k + 1
  }
  assert(won == 1, "${won} of ${n} concurrent rotations of one token won, want exactly 1")
}

test "GET /auth/google is disabled (404) when Google sign-in is not configured" {
  let app = testApp()
  let res = app.handle(Request{ method = "GET", path = "/auth/google", headers = "", body = "" })
  assert(
    res.status == 404,
    "want 404 for /auth/google when Google sign-in is unconfigured, got ${res.status}",
  )
}

fn putWithIfMatch(app: App, cookie: string, id: string, title: string, ifMatch: string): Response {
  let headers = "Content-Type: application/json\r\nCookie: ${cookie}\r\nIf-Match: ${ifMatch}"
  let body = "{\"title\":\"${title}\",\"body\":\"y\"}"
  return app.handle(
    Request{ method = "PUT", path = "/articles/${id}", headers = headers, body = body },
  )
}

test "GET /articles?q= runs a full-text search and returns the matching article" {
  let app = testApp()
  let username = uniqueName("searcher")
  let cookie = registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }
  let term = uniqueName("zephyrion")
  postArticle(app, cookie, "An article about ${term}", "[]") catch e {
    panic(e.message())
  }
  let res = app.handle(
    Request{ method = "GET", path = "/articles?q=${term}", headers = "", body = "" },
  )
  assert(res.status == 200, "want 200 from a search query, got ${res.status}")
  assert(contains(res.body, term), "search did not return the matching article: ${res.body}")
}

test "a soft-deleted article is excluded from listing but the row survives in the database" {
  let p = testPool() catch e {
    panic("testPool: ${e.message()}")
  }
  let app = testApp()
  let username = uniqueName("deleter")
  let cookie = registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }
  let title = "Soft Deleted ${uniqueName("article")}"
  let id = postArticle(app, cookie, title, "[]") catch e {
    panic(e.message())
  }
  let del = app.handle(
    Request{
      method = "DELETE",
      path = "/articles/${id}",
      headers = "Cookie: " + cookie,
      body = "",
    },
  )
  assert(del.status == 204, "want 204 deleting the article, got ${del.status}")

  let list = app.handle(Request{ method = "GET", path = "/articles", headers = "", body = "" })
  assert(list.status == 200, "want 200 listing articles, got ${list.status}")
  assert(
    !contains(list.body, title),
    "a soft-deleted article must not appear in the listing: ${list.body}",
  )

  let articleId = parseInt(id) catch e {
    panic("parseInt: ${e.message()}")
  }
  let rows = p.query("select deleted_at from articles where id = $1", [Value.Int(articleId)]) catch e {
    panic("query: ${e.message()}")
  }
  defer rows.close()
  let found = rows.next() catch e {
    panic("rows.next: ${e.message()}")
  }
  assert(found, "the article row must still exist in the database after a soft delete")
  let deletedAt = sqlOptInt(rows, rows.columns(), "deleted_at") catch e {
    panic("sqlOptInt: ${e.message()}")
  }
  assert(isSome(deletedAt), "deleted_at must be set on the surviving row")
}

test "PUT /articles/:id with a stale If-Match returns 412, and a fresh one succeeds" {
  let app = testApp()
  let username = uniqueName("locker")
  let cookie = registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }
  let id = postArticle(app, cookie, "Versioned Article", "[]") catch e {
    panic(e.message())
  }

  let stale = putWithIfMatch(app, cookie, id, "stale title", "99")
  assert(stale.status == 412, "want 412 for a stale If-Match, got ${stale.status}")

  let fresh = putWithIfMatch(app, cookie, id, "fresh title", "0")
  assert(fresh.status == 200, "want 200 for the correct If-Match, got ${fresh.status}")
  assert(contains(fresh.body, "fresh title"), "update did not take: ${fresh.body}")
}

test "logging out invalidates the session for a subsequent request" {
  let app = testApp()
  let username = uniqueName("logout")
  let cookie = registerAndLogin(app, username, "correct horse battery") catch e {
    panic(e.message())
  }
  let logoutRes = app.handle(
    Request{ method = "POST", path = "/auth/logout", headers = "Cookie: " + cookie, body = "" },
  )
  assert(logoutRes.status == 204, "want 204 from logout, got ${logoutRes.status}")
  let me = app.handle(jsonReq("GET", "/me", cookie, ""))
  assert(me.status == 401, "want 401 from /me after logout, got ${me.status}")
}
