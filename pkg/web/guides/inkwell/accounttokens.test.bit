import { OneTimeTokens, OneTimeOptions, Live, InvalidToken, EmailVerification, VerifyOptions } from "auth"

class AccountTokenFixture {
  db: Db,
  store: InkwellOneTimeStore,
  user: User,
}

fn accountTokenUser(db: Db): User {
  let name = uniqueName("account-token")
  return insertUser(db, name, "${name}@example.test", "unused", "author") catch e {
    panic(e.message())
  }
}

fn accountTokenFixture(): AccountTokenFixture {
  let cfg = testConfig() catch e {
    panic(e.message())
  }
  let db = open(cfg.databaseUrl) catch e {
    panic(e.message())
  }
  return AccountTokenFixture{
    db = db,
    store = InkwellOneTimeStore(db),
    user = accountTokenUser(db),
  }
}

fn accountTokenHash(value: string): string {
  return cacheHex(cacheDigest(CacheSha256(), []byte(value)))
}

fn accountTokenSample(user: User, purpose: string = "verify-email"): OneTimeRecord {
  return OneTimeRecord{
    subject = "${user.id}", purpose = purpose, expiresAt = 1000, data = user.email,
  }
}

fn accountTokenInvalid(tokens: OneTimeTokens, token: string, purpose: string) {
  tokens.redeem(token, purpose) catch e {
    let (_, invalid) = e.(InvalidToken)
    assert(invalid, "token refusal must be InvalidToken")
    return
  }
  panic("account token unexpectedly redeemed")
}

test "account tokens persist only the digest and redeem once" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let tokens = OneTimeTokens(f.store, OneTimeOptions{ clock = () => 100 }) catch e {
    panic(e.message())
  }
  let token = tokens.issue("verify-email", "${f.user.id}", 10, f.user.email, live = Live.One) catch e {
    panic(e.message())
  }
  let rows = f.db.table<AccountTokenRow>().where("userId", f.user.id).all() catch e {
    panic(e.message())
  }
  assert(len(rows) == 1, "one digest row")
  assert(rows[0].tokenHash == accountTokenHash(token), "stored SHA-256 digest")
  assert(!contains(rows[0].data, token), "raw token must not be stored in record metadata")
  let rec = tokens.redeem(token, "verify-email") catch e {
    panic(e.message())
  }
  assert(rec.subject == "${f.user.id}" && rec.data == f.user.email, "account binding")
  accountTokenInvalid(tokens, token, "verify-email")
}

test "account tokens retain purpose and exact expiry boundaries" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let at = []i64{ 100 }
  let tokens = OneTimeTokens(f.store, OneTimeOptions{ clock = () => at[0] }) catch e {
    panic(e.message())
  }
  let valid = tokens.issue("verify-email", "${f.user.id}", 10) catch e {
    panic(e.message())
  }
  at[0] = 109
  tokens.redeem(valid, "verify-email") catch e {
    panic(e.message())
  }
  at[0] = 100
  let expired = tokens.issue("verify-email", "${f.user.id}", 10) catch e {
    panic(e.message())
  }
  at[0] = 110
  accountTokenInvalid(tokens, expired, "verify-email")
  let wrong = tokens.issue("verify-email", "${f.user.id}", 10) catch e {
    panic(e.message())
  }
  accountTokenInvalid(tokens, wrong, "password-reset")
  accountTokenInvalid(tokens, wrong, "verify-email")
}

fn accountTokenPutRejected(f: AccountTokenFixture, hash: string, subject: string) {
  let rec = accountTokenSample(f.user)
  rec.subject = subject
  f.store.put(hash, rec, 10) catch _ {
    return
  }
  panic("account token store accepted an invalid hash or account")
}

test "account tokens reject raw hashes and nonexistent or noncanonical accounts" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  for hash of [
    "",
    "plaintext-token",
    "gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg",
  ] {
    accountTokenPutRejected(f, hash, "${f.user.id}")
  }
  for subject of ["", "0", "-1", "0${f.user.id}", "9223372036854775807"] {
    accountTokenPutRejected(f, accountTokenHash("refused"), subject)
  }
  let count = f.db.table<AccountTokenRow>().where("userId", f.user.id).count() catch e {
    panic(e.message())
  }
  assert(count == 0, "invalid inputs must leave no records")
}

fn accountTokenTakeWorker(
  store: InkwellOneTimeStore,
  hash: string,
  wins: chan<int>,
  wg: WaitGroup,
) {
  defer wg.done()
  let rec = store.take(hash) catch _ {
    wins <- -1
    return
  }
  let result = 0
  if (isSome(rec)) {
    result = 1
  }
  wins <- result
}

test "account tokens allow exactly one concurrent take" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let hash = accountTokenHash("${f.user.id}-take")
  f.store.put(hash, accountTokenSample(f.user), 10) catch e {
    panic(e.message())
  }
  let wins = chan<int>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn accountTokenTakeWorker(f.store, hash, wins, wg)
    i = i + 1
  }
  wg.wait()
  let count = 0
  i = 0
  while (i < 8) {
    let result = <- wins
    assert(result >= 0, "concurrent take must not fail")
    count = count + result
    i = i + 1
  }
  assert(count == 1, "concurrent take must have one winner")
}

fn accountTokenReplaceWorker(
  store: InkwellOneTimeStore, hash: string, rec: OneTimeRecord, errors: chan<bool>, wg: WaitGroup,
) {
  defer wg.done()
  store.replace(hash, rec, 10) catch _ {
    errors <- true
    return
  }
  errors <- false
}

test "account tokens serialize concurrent replacement and preserve other purposes" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let other = accountTokenHash("${f.user.id}-other-purpose")
  f.store.put(other, accountTokenSample(f.user, "password-reset"), 10) catch e {
    panic(e.message())
  }
  let errors = chan<bool>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn accountTokenReplaceWorker(
      f.store, accountTokenHash("${f.user.id}-replace-${i}"), accountTokenSample(f.user), errors, wg,
    )
    i = i + 1
  }
  wg.wait()
  i = 0
  while (i < 8) {
    assert(!<- errors, "replacement must not fail")
    i = i + 1
  }
  let count = f.db.table<AccountTokenRow>().where("userId", f.user.id).where(
    "purpose",
    "verify-email",
  ).count() catch e {
    panic(e.message())
  }
  assert(count == 1, "concurrent replacements must leave exactly one token")
  let preserved = f.store.take(other) catch e {
    panic(e.message())
  }
  assert(isSome(preserved), "replacement must preserve another purpose")
}

test "account tokens roll back replacement when the new hash collides" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let old = accountTokenHash("${f.user.id}-old")
  let collision = accountTokenHash("${f.user.id}-collision")
  let other = accountTokenUser(f.db)
  f.store.put(old, accountTokenSample(f.user), 10) catch e {
    panic(e.message())
  }
  f.store.put(collision, accountTokenSample(other), 10) catch e {
    panic(e.message())
  }
  let failed = false
  f.store.replace(collision, accountTokenSample(f.user), 10) catch _ {
    failed = true
  }
  assert(failed, "duplicate digest must fail replacement")
  let before = f.store.take(old) catch e {
    panic(e.message())
  }
  let untouched = f.store.take(collision) catch e {
    panic(e.message())
  }
  assert(isSome(before), "failed replacement must preserve old token")
  assert(isSome(untouched) && unwrap(untouched).subject == "${other.id}", "other account preserved")
}

fn accountTokenOperation(f: AccountTokenFixture, operation: int, hash: string): ()! {
  if (operation == 0) {
    f.store.put(hash, accountTokenSample(f.user), 10)?
    return
  }
  if (operation == 1) {
    f.store.replace(hash, accountTokenSample(f.user), 10)?
    return
  }
  f.store.revokeSubject("verify-email", "${f.user.id}")?
}

fn accountTokenLockedWorker(
  f: AccountTokenFixture, operation: int, started: chan<bool>, finished: AtomicI64, wg: WaitGroup,
) {
  defer wg.done()
  started <- true
  let hash = accountTokenHash("${f.user.id}-lock-${operation}")
  accountTokenOperation(f, operation, hash) catch e {
    panic(e.message())
  }
  finished.store(1)
}

test "account tokens put replace and revoke wait for the account row lock" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let operation = 0
  while (operation < 3) {
    let started = chan<bool>(1)
    let finished = AtomicI64(0)
    let wg = WaitGroup()
    wg.add(1)
    f.db.tx((tx) => {
      let locked = tx.table<User>().lock().find(f.user.id)?
      assert(locked.id == f.user.id, "fixture user exists")
      spawn accountTokenLockedWorker(f, operation, started, finished, wg)
      let _ = <- started
      sleep(50 * Millisecond)
      assert(finished.load() == 0, "store mutation must wait for account lock")
    }) catch e {
      panic(e.message())
    }
    wg.wait()
    assert(finished.load() == 1, "mutation must complete after account lock releases")
    operation = operation + 1
  }
}

fn accountVerificationIssue(f: AccountTokenFixture, purpose: string = "verify-email"): string {
  let tokens = OneTimeTokens(f.store, OneTimeOptions{ clock = () => 100 }) catch e {
    panic(e.message())
  }
  return tokens.issue(purpose, "${f.user.id}", 10, f.user.email, live = Live.One) catch e {
    panic(e.message())
  }
}

fn accountVerificationMark(tx: TxHandle, subject: string, email: string): ()! {
  let id = parseId(subject)?
  let changed = tx.exec(
    "update users set email_verified_at = ? where id = ? and email = ? and email_verified_at is null",
    123456789, id, email,
  )?
  if (changed != 1) {
    fail InvalidToken{}
  }
}

fn accountVerificationConfirm(
  f: AccountTokenFixture, token: string, at: i64 = 100, failAfterMark: bool = false,
): ()! {
  f.db.tx((tx) => {
    tx.exec("set local statement_timeout = '2s'")?
    let tokens = OneTimeTokens(InkwellOneTimeTxStore(tx), OneTimeOptions{ clock = () => at })?
    let verification = EmailVerification(
      tokens,
      VerifyOptions{
        deliver = (_, _, _) => {},
        currentEmail = (subject) => {
          let users = tx.query<User>("select * from users where id = ?", parseId(subject)?)?
          if (len(users) == 0) {
            return ""
          }
          return users[0].email
        },
        markVerified = (subject, email) => {
          accountVerificationMark(tx, subject, email)?
          if (failAfterMark) {
            fail newError("account verification rollback control")
          }
        },
      },
    )?
    verification.confirm(token)?
  })?
}

fn accountVerificationState(f: AccountTokenFixture, tokens: int, marked: bool) {
  let rows = f.db.table<AccountTokenRow>().where("userId", f.user.id).where(
    "purpose", "verify-email",
  ).all() catch e {
    panic(e.message())
  }
  assert(len(rows) == tokens, "committed verification token consumption")
  let user = findUserById(f.db, f.user.id) catch e {
    panic(e.message())
  }
  assert(isSome(user.emailVerifiedAt) == marked, "committed verification timestamp presence")
  if (marked) {
    assert(unwrap(user.emailVerifiedAt) == 123456789, "exact committed verification timestamp")
  }
}

fn accountVerificationInvalid(f: AccountTokenFixture, token: string, at: i64 = 100) {
  accountVerificationConfirm(f, token, at) catch e {
    let (_, invalid) = e.(InvalidToken)
    assert(invalid, "verification refusal must be InvalidToken")
    return
  }
  panic("account verification unexpectedly succeeded")
}

test "account verification commits token and bound timestamp once and refuses replay" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let other = accountTokenUser(f.db)
  let otherHash = accountTokenHash("${other.id}-verification-control")
  let resetHash = accountTokenHash("${f.user.id}-verification-reset-control")
  f.store.put(otherHash, accountTokenSample(other), 10) catch e {
    panic(e.message())
  }
  f.store.put(resetHash, accountTokenSample(f.user, "password-reset"), 10) catch e {
    panic(e.message())
  }
  let token = accountVerificationIssue(f)
  accountVerificationConfirm(f, token) catch e {
    panic(e.message())
  }
  accountVerificationState(f, 0, true)
  accountVerificationInvalid(f, token)
  accountVerificationState(f, 0, true)
  let untouched = findUserById(f.db, other.id) catch e {
    panic(e.message())
  }
  assert(!isSome(untouched.emailVerifiedAt), "another account remains unverified")
  for hash of [otherHash, resetHash] {
    let rows = f.db.table<AccountTokenRow>().where("tokenHash", hash).all() catch e {
      panic(e.message())
    }
    assert(len(rows) == 1, "another account and purpose remain unchanged")
  }
}

test "account verification rolls back consumption and marking then retries once" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let token = accountVerificationIssue(f)
  let failed = false
  accountVerificationConfirm(f, token, failAfterMark = true) catch e {
    assert(e.message() == "account verification rollback control", "failure occurs after marking")
    failed = true
  }
  assert(failed, "rollback control must fail")
  accountVerificationState(f, 1, false)
  let rows = f.db.table<AccountTokenRow>().where("userId", f.user.id).all() catch e {
    panic(e.message())
  }
  assert(rows[0].tokenHash == accountTokenHash(token), "rollback restores the original token")
  accountVerificationConfirm(f, token) catch e {
    panic(e.message())
  }
  accountVerificationState(f, 0, true)
  accountVerificationInvalid(f, token)
}

test "account verification refuses expiry wrong purpose and changed email without marking" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let expired = accountVerificationIssue(f)
  accountVerificationInvalid(f, expired, 110)
  accountVerificationState(f, 1, false)
  let wrong = accountVerificationIssue(f, "password-reset")
  accountVerificationInvalid(f, wrong)
  accountVerificationState(f, 1, false)
  let token = accountVerificationIssue(f)
  let changed = f.db.exec(
    "update users set email = ? where id = ?",
    "changed@example.test",
    f.user.id,
  ) catch e {
    panic(e.message())
  }
  assert(changed == 1, "fixture changes one current email")
  accountVerificationInvalid(f, token)
  accountVerificationState(f, 1, false)
}

fn accountVerificationRaceWorker(
  f: AccountTokenFixture, token: string, replace: bool, results: chan<int>, wg: WaitGroup,
) {
  defer wg.done()
  if (replace) {
    f.db.tx((tx) => {
      tx.exec("set local statement_timeout = '2s'")?
      InkwellOneTimeTxStore(tx).replace(
        accountTokenHash("${f.user.id}-confirm-replace"), accountTokenSample(f.user), 10,
      )?
    }) catch _ {
      results <- -1
      return
    }
    results <- 0
    return
  }
  accountVerificationConfirm(f, token) catch e {
    let (_, invalid) = e.(InvalidToken)
    if (!invalid) {
      results <- -1
      return
    }
    results <- 0
    return
  }
  results <- 1
}

test "account verification and replacement finish with one committed winner at most" {
  let f = accountTokenFixture()
  defer f.db.pool.close()
  let token = accountVerificationIssue(f)
  let wg = WaitGroup()
  let results = chan<int>(3)
  wg.add(3)
  spawn accountVerificationRaceWorker(f, token, false, results, wg)
  spawn accountVerificationRaceWorker(f, token, false, results, wg)
  spawn accountVerificationRaceWorker(f, token, true, results, wg)
  wg.wait()
  let wins = 0
  let i = 0
  while (i < 3) {
    let result = <- results
    assert(result >= 0, "confirmation and replacement must finish without database failure")
    wins = wins + result
    i = i + 1
  }
  assert(wins <= 1, "at most one confirmation marks the account")
  accountVerificationState(f, 1, wins == 1)
  let rows = f.db.table<AccountTokenRow>().where("userId", f.user.id).all() catch e {
    panic(e.message())
  }
  assert(
    rows[0].tokenHash == accountTokenHash("${f.user.id}-confirm-replace"),
    "replacement token survives",
  )
  accountVerificationInvalid(f, token)
}
