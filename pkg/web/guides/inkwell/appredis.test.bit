// These checks use the isolated PostgreSQL/Redis pair supplied by the guide gate.
fn articleList(app: App, path: string): Response {
  let r = app.handle(Request{ method = "GET", path = path, headers = "", body = "" })
  assert(r.status == 200, "article list failed: ${r.status}: ${r.body}")
  return r
}

fn redisGuideDb(): Db! {
  let cfg = testConfig()?
  return open(cfg.databaseUrl)?
}

test "Redis caches article pages and separates query parameters" {
  let app = testApp()
  let name = uniqueName("cached")
  let cookie = registerAndLogin(app, name, "correct horse battery") catch e {
    panic(e.message())
  }
  let id = postArticle(app, cookie, "Cached Original", "[]") catch e {
    panic(e.message())
  }
  let db = redisGuideDb() catch e {
    panic(e.message())
  }
  defer db.pool.close()
  let user = findUserByUsername(db, name) catch e {
    panic(e.message())
  }
  let path = "/articles?author=${user.id}&limit=1"
  let before = articleList(app, path)
  let articleId = parseId(id) catch e {
    panic(e.message())
  }
  db.exec("update articles set title = ? where id = ?", "Changed Behind Cache", articleId) catch e {
    panic(e.message())
  }
  let hit = articleList(app, path)
  assert(hit.body == before.body, "second GET must hit the cached page")
  let distinct = articleList(app, "/articles?author=${user.id}&limit=2")
  assert(
    contains(distinct.body, "Changed Behind Cache"),
    "different query must not share cached body",
  )
  assert(contains(distinct.body, "\"limit\":2"), "query-specific metadata preserved")
}

fn putCachedArticle(app: App, id: string, cookie: string, title: string) {
  let r = app.handle(
    Request{
      method = "PUT", path = "/articles/${id}",
      headers = "Content-Type: application/json\r\nCookie: ${cookie}\r\nIf-Match: 0",
      body = "{\"title\":\"${title}\",\"body\":\"edited\"}",
    },
  )
  assert(r.status == 200, "update failed: ${r.status}: ${r.body}")
}

test "POST PUT DELETE invalidate warmed Redis article lists" {
  let app = testApp()
  let name = uniqueName("invalidate")
  let cookie = registerAndLogin(app, name, "correct horse battery") catch e {
    panic(e.message())
  }
  let db = redisGuideDb() catch e {
    panic(e.message())
  }
  defer db.pool.close()
  let user = findUserByUsername(db, name) catch e {
    panic(e.message())
  }
  let path = "/articles?author=${user.id}"
  let _ = articleList(app, path)
  let id = postArticle(app, cookie, "Published After Cache", "[]") catch e {
    panic(e.message())
  }
  assert(
    contains(articleList(app, path).body, "Published After Cache"),
    "POST must invalidate cached empty list",
  )
  putCachedArticle(app, id, cookie, "Updated After Cache")
  assert(
    contains(articleList(app, path).body, "Updated After Cache"),
    "PUT must invalidate cached old title",
  )
  let removed = app.handle(jsonReq("DELETE", "/articles/${id}", cookie, ""))
  assert(removed.status == 204, "delete failed: ${removed.status}")
  assert(
    !contains(articleList(app, path).body, "Updated After Cache"),
    "DELETE must invalidate cached row",
  )
}

test "Redis sessions survive across apps and logout revokes the other app" {
  let first = testApp()
  let name = uniqueName("durable")
  let cookie = registerAndLogin(first, name, "correct horse battery") catch e {
    panic(e.message())
  }
  let second = testApp()
  let me = second.handle(jsonReq("GET", "/me", cookie, ""))
  assert(
    me.status == 200 && contains(me.body, name),
    "second app must load first app's Redis session",
  )
  let logout = second.handle(jsonReq("POST", "/auth/logout", cookie, ""))
  assert(logout.status == 204, "logout failed")
  let after = first.handle(jsonReq("GET", "/me", cookie, ""))
  assert(after.status == 401, "logout must revoke session across apps")
}

test "nightly digest counts only visible articles in the last 24 hours" {
  let app = testApp()
  let name = uniqueName("digest")
  let cookie = registerAndLogin(app, name, "correct horse battery") catch e {
    panic(e.message())
  }
  let id = postArticle(app, cookie, "Daily Digest", "[]") catch e {
    panic(e.message())
  }
  let db = redisGuideDb() catch e {
    panic(e.message())
  }
  defer db.pool.close()
  let at = now().ns
  let recent = digestArticleCount(db, at) catch e {
    panic(e.message())
  }
  assert(recent > 0, "new article must appear in digest")
  let articleId = parseId(id) catch e {
    panic(e.message())
  }
  db.exec("update articles set created_at = ? where id = ?", at - i64(25 * DigestHour), articleId) catch e {
    panic(e.message())
  }
  let aged = digestArticleCount(db, at) catch e {
    panic(e.message())
  }
  assert(aged == recent - 1, "articles older than 24 hours must be excluded")
}
