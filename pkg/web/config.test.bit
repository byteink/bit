// pkg/web/config.test.bit — #3946's own acceptance: an App is built from a
// `Config` the app constructs, every field reads back through the App, and a
// field the app leaves out takes its documented default rather than its zero.
//
// Both defaults are deliberately asserted against a value that differs from
// the field's ZERO value — 1_000_000 against 0, `true` against `false`. A
// default that silently stopped being applied would read as the zero, so a
// fixture defaulting anything to zero could not see the failure it exists to
// catch.
//
// `testApp()` (app.test.bit) is the helper every non-config test builds
// through; this file spells its literals out instead, because the shape of
// the literal is exactly what is under test here.
//
// `assert` is a builtin and `contains` is already bound module-wide by
// router.test.bit's import (an import binds per MODULE, and a second one
// is E0042), so this file imports nothing.

test "every Config field reads back through the App that was handed it" {
  let app = App(
    Config{
      secret: "s3cr3t",
      maxBody: 4096,
      rejectUnknownFields: false,
    },
  )
  assert(app.config.secret == "s3cr3t", "secret: got '${app.config.secret}'")
  assert(app.config.maxBody == 4096, "maxBody: got ${app.config.maxBody}")
  assert(
    !app.config.rejectUnknownFields,
    "rejectUnknownFields: got ${app.config.rejectUnknownFields}",
  )
}

test "an omitted field takes its documented default, not its zero value" {
  // Only `secret` is spelled — the whole point of the ticket. `maxBody` must
  // be 1_000_000 and not 0; `rejectUnknownFields` must be true and not false.
  let app = App(Config{ secret: "x" })
  assert(app.config.secret == "x", "secret: got '${app.config.secret}'")
  assert(app.config.maxBody == 1_000_000, "maxBody: got ${app.config.maxBody}")
  assert(
    app.config.rejectUnknownFields,
    "rejectUnknownFields: got ${app.config.rejectUnknownFields}",
  )
}

test "a spelled field beats its default without disturbing the other" {
  let a = App(Config{ secret: "x", maxBody: 42 })
  assert(a.config.maxBody == 42, "maxBody: got ${a.config.maxBody}")
  assert(
    a.config.rejectUnknownFields,
    "rejectUnknownFields should still default true, got ${a.config.rejectUnknownFields}",
  )

  let b = App(Config{ secret: "x", rejectUnknownFields: false })
  assert(!b.config.rejectUnknownFields, "rejectUnknownFields: got ${b.config.rejectUnknownFields}")
  assert(b.config.maxBody == 1_000_000, "maxBody should still default, got ${b.config.maxBody}")
}

test "the sessions field is omittable, and absent means absent" {
  // `sessions` is the one field whose absence is a REFUSAL rather than a
  // default (#3947): the framework ships no in-process session store
  // silently. It is omittable at all only because `SessionStore` is an
  // interface, whose zero value is `nil` (SPEC §13.4) — a class-typed field
  // would be E0083 here, and could carry no default either (§15.4).
  let bare = App(Config{ secret: "x" })
  assert(bare.config.sessions == nil, "an omitted store must be nil, not something")

  let wired = App(Config{ secret: "x", sessions: MemoryStore() })
  assert(wired.config.sessions != nil, "a configured store must read back")
  // The other defaults are untouched by a field that has none.
  assert(wired.config.maxBody == 1_000_000, "maxBody: got ${wired.config.maxBody}")
}

test "the App holds the very Config it was handed, not a copy" {
  // A class is a reference type (SPEC §13.3), so the framework reading
  // `app.config` reads the app's own object. This pins that: nothing between
  // the literal and the field is allowed to snapshot it.
  let cfg = Config{ secret: "x", maxBody: 7 }
  let app = App(cfg)
  cfg.maxBody = 99
  assert(app.config.maxBody == 99, "expected the same object, got ${app.config.maxBody}")
}

test "a Config still drives an App that registers and freezes routes" {
  let app = App(Config{ secret: "x" })
  app.get("/x", okHandler)
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  app.root.router.lookup("GET", "/x") catch e {
    panic("expected /x to be registered: ${e.message()}")
  }
  assert(app.config.maxBody == 1_000_000, "config survived listen(): ${app.config.maxBody}")
}

// --- `secret` is required, and the requirement is enforced, not declared ---

// #3946 gave `secret` no default so that a missing signing key would be "a
// value the app had to produce". It is not: a `string` field's zero value is
// `""` (SPEC §13.4), so `App(Config{})` compiled and ran with an empty key
// until #4474. `testpanic_` inverts the verdict (SPEC §18.4) — these PASS
// only if the process really dies.
test "testpanic_an_app_built_with_an_empty_secret_is_refused" {
  let _ = App(Config{ secret: "" })
}

// Omitting the field entirely is the shape an app actually reaches by
// accident, and it is a DIFFERENT source expression from the one above: it
// takes the field's zero value rather than a spelled empty literal. Without
// this row the check could be satisfied by anything that only looked at a
// written-out `secret: ""`.
test "testpanic_an_app_built_with_secret_omitted_entirely_is_refused" {
  let _ = App(Config{})
}

// The inverse control. Without it both tests above would pass against an
// `App.init` that panicked unconditionally.
test "a non-empty secret still constructs an App and reads back" {
  let app = App(Config{ secret: "x" })
  assert(app.config.secret == "x", "secret: got '${app.config.secret}'")
  assert(app.config.maxBody == 1_000_000, "the rest of the Config survives: ${app.config.maxBody}")
}

// A refusal that did not name the field would send the reader to the
// framework rather than to their own call site. `testpanic_` cannot see the
// message — it reads the child's exit status only — so the text is asserted
// against the `const` app.bit panics with. That pins what the message says,
// not that the panic uses it; the two tests above pin that the panic fires.
test "the empty-secret refusal names the Config field the app must set" {
  assert(
    contains(secretRequiredMessage, "secret"),
    "the refusal must name `secret`: '${secretRequiredMessage}'",
  )
  assert(
    contains(secretRequiredMessage, "Config"),
    "the refusal must name `Config`: '${secretRequiredMessage}'",
  )
}
