// pkg/web/envelope.test.bit — #5079's acceptance, one named test per
// assertion.
//
// Everything goes through `app.handle(req)` (adapter.bit) — the real router,
// the real chain, the real `Ctx` construction — the same seam
// errors.test.bit/adapter.test.bit already drive, so a route registered at
// the wrong path or sitting behind the wrong middleware cannot pass.
//
// `RecordingSink`/`newSink`/`sinkText`/`adapterApp`/`req`/`freezeOrPanic`
// (adapter.test.bit), `testApp` (app.test.bit), `PlainError` (errors.test.bit
// — a domain error with `message()` and no `status()`, exactly the un-opted-
// in shape this file's generic-failure test needs), `jsonInt`/`jsonStr`
// (errors.test.bit), `objectEntries`/`CallCount`/`countingEncode` (res.test.
// bit), `User`/`@json` (res.test.bit), `contains` (router.test.bit) and
// `JsonEntry`/`jsonAsArray`/`jsonAsObject`/`jsonGet` (res.test.bit's import)
// are already declared/imported module-wide — reused here, not redeclared or
// re-imported (E0042).

// One `@json` value, one 200 body, one `{"data": <value>}` envelope, byte for
// byte — not "the body contains the value", which would pass just as well
// against an envelope that added extra keys around it.
test "envelope() wraps a success value: body is exactly {\"data\":<value>}" {
  let u = User{ id: 42, name: "ada" }
  let app = testApp()
  app.use(envelope())
  app.get("/x", (c) => c.json(u))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/x"))

  let want = jsonEncode(Json.JsonObject([JsonEntry{ key: "data", value: u.toJson() }]))
  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == want, "want exactly '${want}', got '${res.body}'")
}

// `notFound("user")` composes with #3876's mapping: 404, message "user" —
// but the SHAPE around it is this file's own, not errors.bit's
// `{"status":...,"error":...}`.
test "envelope() gives a notFound() failure {\"error\":{\"code\":\"not_found\",...}} at 404" {
  let app = testApp()
  app.use(envelope())
  app.get("/missing", (c) => rethrow(notFound("user")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/missing"))

  let want = jsonEncode(
    Json.JsonObject(
      [
        JsonEntry{
          key: "error",
          value: Json.JsonObject(
            [
              JsonEntry{ key: "code", value: Json.JsonString("not_found") },
              JsonEntry{ key: "message", value: Json.JsonString("user") },
            ],
          ),
        },
      ],
    ),
  )
  assert(res.status == 404, "want 404, got ${res.status}")
  assert(res.body == want, "want exactly '${want}', got '${res.body}'")
}

// THE security property, restated for this file's own shape: a failure that
// did not opt into `HttpError` (`PlainError` — `message()`, no `status()`)
// gets the generic 500 body, and its real message goes to the log and
// nowhere else — proven the same way errors.test.bit proves it for the
// framework's own default shape.
test "envelope() gives a plain failure a generic 500 body, and logs the real message" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.use(envelope())
  app.get("/boom", (c) => rethrow(PlainError{ msg: "postgres://u:p@h/db" }))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/boom"))

  assert(res.status == 500, "want 500, got ${res.status}")
  assert(
    !contains(res.body, "postgres://"),
    "the un-opted-in message must NOT reach the client, body was '${res.body}'",
  )
  let j = jsonParse(res.body) catch e {
    panic("the error body must parse as JSON ('${res.body}'): ${e.message()}")
  }
  let errObj = jsonGet(j, "error")
  assert(isSome(errObj), "body must carry a top-level 'error' key: '${res.body}'")
  assert(
    jsonStr(unwrap(errObj), "message") == "Internal Server Error",
    "the generic message must be sent instead, got '${res.body}'",
  )

  let logged = sinkText(sink)
  assert(contains(logged, "postgres://u:p@h/db"), "the real message must be logged: '${logged}'")
}

// The repetition #5079 exists to remove: `page()` fills `meta` from
// `total`/`limit`/`cursor` a handler passes once, rather than every list
// handler hand-assembling it.
test "envelope() fills meta with total, limit and cursor for a paginated result" {
  let users = []User{ User{ id: 1, name: "ada" }, User{ id: 2, name: "grace" } }
  let app = testApp()
  app.use(envelope())
  app.get("/list", (c) => page(users, 940, 50, "cursor-abc"))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/list"))

  let j = jsonParse(res.body) catch e {
    panic("the body must parse as JSON ('${res.body}'): ${e.message()}")
  }
  let metaOpt = jsonGet(j, "meta")
  assert(isSome(metaOpt), "body must carry a top-level 'meta' key: '${res.body}'")
  let meta = unwrap(metaOpt)
  assert(jsonInt(meta, "total") == 940, "total: got ${jsonInt(meta, "total")}")
  assert(jsonInt(meta, "limit") == 50, "limit: got ${jsonInt(meta, "limit")}")
  assert(jsonStr(meta, "cursor") == "cursor-abc", "cursor: got '${jsonStr(meta, "cursor")}'")

  let dataOpt = jsonGet(j, "data")
  assert(isSome(dataOpt), "body must carry a top-level 'data' key: '${res.body}'")
  let items = jsonAsArray(unwrap(dataOpt))
  assert(isSome(items), "'data' must be an array: '${res.body}'")
  assert(len(unwrap(items)) == 2, "want 2 items, got ${len(unwrap(items))}")
}

// A route under a Group that never mounted `envelope()` is untouched — the
// opt-in, per-group rule. Run against a SIBLING group that did mount it, so
// this is a genuine contrast rather than an app with no `envelope()` at all.
test "a route in a group without envelope() returns the unwrapped body" {
  let u = User{ id: 7, name: "grace" }
  let app = testApp()
  let plain = app.group("/plain")
  plain.get("/x", (c) => c.json(u))
  let wrapped = app.group("/wrapped")
  wrapped.use(envelope())
  wrapped.get("/x", (c) => c.json(u))
  freezeOrPanic(app)

  let plainRes = app.handle(req("GET", "/plain/x"))
  assert(
    plainRes.body == jsonEncode(u.toJson()),
    "a route with no envelope() must return the value's own encoding: '${plainRes.body}'",
  )

  let wrappedRes = app.handle(req("GET", "/wrapped/x"))
  let want = jsonEncode(Json.JsonObject([JsonEntry{ key: "data", value: u.toJson() }]))
  assert(
    wrappedRes.body == want,
    "the sibling group's route must still be enveloped: '${wrappedRes.body}'",
  )
}

// The value is serialised exactly once PER RESPONSE, proven by a counting
// serialiser (#5078's own pattern, res.test.bit) rather than by reading the
// output: two independent requests move the counter from 0 to 1 to 2, never
// to 0 or above 2, which a byte comparison alone could not tell apart from a
// decode-and-re-encode round trip.
test "envelope() serialises the value exactly once per response, proven by a counting serialiser" {
  let calls = CallCount{ n: 0 }
  let app = testApp()
  app.use(envelope())
  app.get(
    "/x",
    (c) => newValueRes(200, "application/json", Json.JsonString("v"), countingEncode(calls)),
  )
  freezeOrPanic(app)

  let want = jsonEncode(Json.JsonObject([JsonEntry{ key: "data", value: Json.JsonString("v") }]))

  let first = app.handle(req("GET", "/x"))
  assert(calls.n == 1, "one request must serialise exactly once: got ${calls.n} call(s)")
  assert(first.body == want, "want '${want}', got '${first.body}'")

  let second = app.handle(req("GET", "/x"))
  assert(
    calls.n == 2,
    "a second, independent request must serialise exactly one more time: got ${calls.n} call(s)",
  )
  assert(second.body == want, "want '${want}', got '${second.body}'")
}
