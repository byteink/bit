// pkg/web/ctx.test.bit — Ctx (#3883): header parsing (case-insensitivity,
// repeats, trimming, the count/size caps, malformed lines) and named-route
// resolution.
//
// `contains` is already imported module-wide by router.test.bit — reused
// here, not reimported (E0042). `repeat` is not yet imported anywhere in
// the module, so it is imported fresh here.
//
// `newCtx` and `Ctx.route` are fallible with a non-void result (`Ctx!`,
// `string!`), so `expr catch e { ... }` used as a bare statement must end
// its block in a value or a diversion (return/fail/panic/...) — the void
// exception §18.3 grants `()!` does not apply here. The helpers below give
// the catch block a `return` to divert through, and hand back the error
// message (or "" on success) so a test can assert on it without needing a
// throwaway `Ctx`/`string` value.

import { repeat } from "std/strings"

fn newTestRegistry(): NameRegistry {
  return newNameRegistry()
}

fn newCtxError(raw: string): string {
  let req = Request{ method: "GET", path: "/x", headers: raw, body: "" }
  newCtx(req, map<string, string>(), newTestRegistry()) catch e {
    return e.message()
  }
  return ""
}

fn mustCtx(raw: string): Ctx {
  let req = Request{ method: "GET", path: "/x", headers: raw, body: "" }
  return newCtx(req, map<string, string>(), newTestRegistry()) catch e {
    panic("newCtx: ${e.message()}")
  }
}

// --- header parsing ---------------------------------------------------

test "header names are case-insensitive, a repeat keeps both values, and values are trimmed" {
  let c = mustCtx("Content-Type: text/html\r\nX-Token: one\r\nx-token:   two  \r\nHost: example.com")

  assert(
    c.header("content-type") == "text/html",
    "case-insensitive lookup: got '${c.header("content-type")}'",
  )
  assert(
    c.header("CONTENT-TYPE") == "text/html",
    "case-insensitive lookup (upper): got '${c.header("CONTENT-TYPE")}'",
  )

  let all = c.headers("X-Token")
  assert(len(all) == 2, "expected both repeat values, got ${len(all)}")
  assert(all[0] == "one", "first repeat value: got '${all[0]}'")
  assert(all[1] == "two", "second repeat value not trimmed correctly: got '${all[1]}'")
  assert(
    c.header("x-token") == "one",
    "header() must return the FIRST of a repeat, got '${c.header("x-token")}'",
  )

  assert(
    c.header("host") == "example.com",
    "unrelated header still parses: got '${c.header("host")}'",
  )
}

test "an absent header is empty string, not an error" {
  let c = mustCtx("Host: example.com")
  assert(
    c.header("x-missing") == "",
    "absent header must be empty string, got '${c.header("x-missing")}'",
  )
  assert(
    len(c.headers("x-missing")) == 0,
    "absent header's headers() must be empty, got ${len(c.headers("x-missing"))}",
  )
}

test "a malformed line with no colon is dropped, never recorded as an empty value" {
  let c = mustCtx("Host: example.com\r\nBadLineNoColon\r\nAccept: */*")

  // The malformed line's own text must never become a header name — not
  // even one mapped to an empty value, which `header()` alone could not
  // distinguish from "absent". `headers()`'s LENGTH is what proves it: a
  // present-with-empty-value entry would be a one-element slice holding "".
  assert(len(c.headers("BadLineNoColon")) == 0, "malformed line must not be recorded at all")
  assert(c.header("BadLineNoColon") == "", "malformed line's header() must read as absent")

  // The lines either side of the malformed one must still parse.
  assert(
    c.header("host") == "example.com",
    "header before the malformed line: got '${c.header("host")}'",
  )
  assert(
    c.header("accept") == "*/*",
    "header after the malformed line: got '${c.header("accept")}'",
  )
}

test "a colon at position 0 (empty header name) is also dropped" {
  let c = mustCtx("Host: example.com\r\n: emptyname")
  assert(len(c.headers("")) == 0, "an empty header name must never be recorded")
  assert(c.header("host") == "example.com", "the valid header either side must still parse")
}

test "a header block exceeding the line-count cap is rejected" {
  // 101 "H: v" lines (repeat leaves a trailing CRLF, so split() sees a
  // 102nd, empty, element too — either way it is well over the 100 cap).
  let msg = newCtxError(repeat("H: v\r\n", 101))
  assert(msg != "", "newCtx must reject a header block over the line-count cap")
  assert(contains(msg, "cap"), "error names the cap: '${msg}'")
}

test "a header block exceeding the byte-size cap is rejected" {
  let msg = newCtxError("X: " + repeat("a", 9000))
  assert(msg != "", "newCtx must reject a header block over the byte-size cap")
  assert(contains(msg, "cap"), "error names the cap: '${msg}'")
}

test "a header block at or under both caps is accepted" {
  let msg = newCtxError(repeat("H: v\r\n", 50))
  assert(msg == "", "50 headers must be well under the cap, got error '${msg}'")
}

// --- param / query / method / path -------------------------------------

test "param, query and method/path read from the request, absent is empty string" {
  let req = Request{ method: "POST", path: "/widgets?active=true&sort=", headers: "", body: "" }
  let params = map<string, string>()
  params["id"] = "7"
  let c = newCtx(req, params, newTestRegistry()) catch e {
    panic("newCtx: ${e.message()}")
  }
  assert(c.param("id") == "7", "route param: got '${c.param("id")}'")
  assert(c.param("missing") == "", "absent param must be empty string")
  assert(c.query("active") == "true", "query param: got '${c.query("active")}'")
  assert(c.query("missing") == "", "absent query param must be empty string")
  assert(c.method() == "POST", "method: got '${c.method()}'")
  assert(c.path() == "/widgets", "path must exclude the query string, got '${c.path()}'")
}

// --- c.route() -----------------------------------------------------------

// `c.route`'s error message on success ("") or failure, so a test can
// assert on it without needing a throwaway `string` for the catch block's
// non-void, non-diverging ok path (§18.3).
fn routeError(c: Ctx, name: string, args: []string): string {
  c.route(name, args) catch e {
    return e.message()
  }
  return ""
}

test "c.route on a grouped named route returns the fully-prefixed URL with params filled" {
  let app = App()
  let api = app.group("/api/v1")
  api.get("/users/:id", () => {}).name("users.show")

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }

  let req = Request{ method: "GET", path: "/x", headers: "", body: "" }
  let c = newCtx(req, map<string, string>(), app.root.registry) catch e {
    panic("newCtx: ${e.message()}")
  }

  let url = c.route("users.show", []string{ "42" }) catch e {
    panic("route: ${e.message()}")
  }
  assert(url == "/api/v1/users/42", "resolved URL: got '${url}'")
}

test "c.route on an unknown name fails, naming the registered names" {
  let app = App()
  app.get("/a", () => {}).name("a.show")
  app.listen() catch e {
    panic("listen: ${e.message()}")
  }

  let req = Request{ method: "GET", path: "/x", headers: "", body: "" }
  let c = newCtx(req, map<string, string>(), app.root.registry) catch e {
    panic("newCtx: ${e.message()}")
  }

  let msg = routeError(c, "nope", []string(0))
  assert(msg != "", "c.route on an unknown name must fail")
  assert(contains(msg, "nope"), "error names the unknown name: '${msg}'")
  assert(contains(msg, "a.show"), "error names a registered name: '${msg}'")
}

test "c.route with the wrong argument count fails, naming the pattern and the expected count" {
  let app = App()
  app.get("/users/:id", () => {}).name("users.show")
  app.listen() catch e {
    panic("listen: ${e.message()}")
  }

  let req = Request{ method: "GET", path: "/x", headers: "", body: "" }
  let c = newCtx(req, map<string, string>(), app.root.registry) catch e {
    panic("newCtx: ${e.message()}")
  }

  let tooFew = routeError(c, "users.show", []string(0))
  assert(tooFew != "", "c.route with a missing argument must fail")
  assert(contains(tooFew, "/users/:id"), "error names the pattern: '${tooFew}'")
  assert(contains(tooFew, "1"), "error names the expected count: '${tooFew}'")

  let tooMany = routeError(c, "users.show", []string{ "1", "2" })
  assert(tooMany != "", "c.route with too many arguments must also fail")

  let justRight = routeError(c, "users.show", []string{ "42" })
  assert(
    justRight == "",
    "c.route with the exact argument count must succeed, got error '${justRight}'",
  )
}
