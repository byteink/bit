// pkg/web/middleware.bit — App/Group-scoped middleware, applying to every
// route on that scope regardless of registration order (#3886).
//
// `Next` is `Handler` (router.bit) by alias, which #3885 widened from the
// `() => ()` placeholder to the real `(Ctx) => Res!` — aliases are
// transparent (SPEC §14.1), so this line did not change when it did.
//
// `Middleware` DID change, and by hand: `(Next) => ()` is not a widening of
// anything, it was a stand-in written while `Ctx` and `Res` did not exist
// (#3886's own comment says so). The shape #3886's ticket body specified,
// and the one #3876's mapping and #3951's recover() are written against, is
// `(Ctx, Next) => Res!` — a middleware needs the request to make a decision
// on and must be able to answer with a response instead of calling the rest
// of the chain. That is what it is now.
export type Next = Handler

// A middleware receives the context and the rest of the chain, and decides
// whether — and when — to call it. Onion model: call `next(c)` before acting
// to run code on the way IN, act on the `Res` it returns to run code on the
// way OUT, or never call it at all and return your own `Res` to
// short-circuit (that is how auth rejects).
export type Middleware = (Ctx, Next) => Res!

// A failure, raised from a place that cannot raise one itself: `fail` is
// rejected inside an arrow body (E0060) even when the arrow's expected type
// is fallible, and so is `?` (E0061) — filed as #4504, with the repro and
// the line in `vArrow` that causes it. Until that lands, a middleware or
// handler written as a closure produces a failure by calling this, and
// propagates one it wants to act after with
// `let r = next(c) catch e { return rethrow(e) }`.
//
// Exported because it is the ONLY spelling available to an app's own
// middleware today, not because the framework wants it in its surface: it
// goes when #4504 does.
export fn rethrow(e: error): Res! {
  fail e
}

// Wraps `inner` with one middleware: calling the result calls `mw`, and
// it is `mw` alone that decides whether `inner` ever runs. Nothing here
// intercepts a panic — Bit has no catch for one (SPEC §18.4: "There is no
// `recover`") — and nothing here intercepts a FAILURE either: a `fail` from
// `inner` comes back out of `mw(c, inner)` and straight out of this arrow,
// reaching the adapter's single mapping site (adapter.bit) exactly as the
// epic requires. See middleware.test.bit for both properties.
//
// An EXPRESSION body, not `{ return mw(c, inner)? }`, for the reason
// `rethrow` above exists: `?` inside an arrow is E0061 today (#4504). The
// two forms mean the same thing in tail position — the arrow's result type
// is `Res!` and so is `mw`'s — and this one is checked and lowered
// correctly; it is proven by middleware.test.bit's propagation test, not by
// this comment.
fn wrap(mw: Middleware, inner: Handler): Handler {
  return (c) => mw(c, inner)
}

// Composes `mws` — already ordered outer scope first, then inner; within
// one scope, registration order (see `collectMiddleware`) — around
// `final`, the route's own handler. Called exactly once per route, from
// `flushPending` at `App.listen()`, never per request: this is the whole
// answer to "the chain is built once at freeze, not per request".
fn buildChain(mws: []Middleware, final: Handler): Handler {
  let chain = final
  let i = len(mws) - 1
  while (i >= 0) {
    chain = wrap(mws[i], chain)
    i = i - 1
  }
  return chain
}

// Every middleware in force for one route: each ancestor Group's own list,
// outer (the App's root) to inner (the route's own Group), each list's
// entries kept in registration order. `chain` already ends with the
// owning Group itself (`Group.register` appends `this` when it builds the
// chain), so walking it start to finish already reads outer-to-inner —
// nothing here reorders it.
fn collectMiddleware(chain: []Group): []Middleware {
  let out = []Middleware(0)
  for g of chain {
    for m of g.middleware {
      out = append(out, m)
    }
  }
  return out
}

// One route awaiting its final composed `Handler`. Recorded by
// `Group.register` instead of calling `router.add()` immediately, so a
// `use()` on the SAME (or an ancestor) Group made AFTER the route was
// registered is still picked up: `chain` holds Group REFERENCES (classes
// are reference types, SPEC §13.3), read at flush time — never a snapshot
// of `.middleware` taken at registration time. This IS the mechanism
// behind "regardless of registration order"; see middleware.test.bit's
// "order-independence" tests for both directions (route-then-use and
// use-then-route).
class PendingRoute {
  method: string,
  pattern: string,
  handler: Handler,
  chain: []Group,
}

// Shared by the whole App/Group tree by reference — one per App, exactly
// like `Router`/`NameRegistry` (app.bit) already are — so every Group's
// registrations, however deeply nested, land in the SAME list.
class Pending {
  routes: []PendingRoute,
}

fn newPending(): Pending {
  return Pending{ routes: []PendingRoute(0) }
}

// Builds every pending route's final chain and registers it with `router`.
// `wrapRouteErrors` (errors.bit) is the OUTERMOST layer when some group on
// the route's chain installed an `onError` renderer (#3950) — resolved here,
// from the same `chain` the middleware comes from and at the same moment, so
// an `onError` on an ancestor arriving after the route was registered still
// applies exactly as a late `use()` does.
// Called once, from `App.listen()`, before `router.freeze()`. After this
// call every route `router` holds already carries its middleware baked
// in — dispatch (once #3885 lands) never needs to know about Groups or
// chains at all, only the composed `Handler` the trie already stored.
fn flushPending(router: Router, pending: Pending) {
  for pr of pending.routes {
    let mws = collectMiddleware(pr.chain)
    let composed = wrapRouteErrors(pr.chain, buildChain(mws, pr.handler))
    router.add(pr.method, pr.pattern, composed)
  }
}

// The chain a request that matched NO route runs through (#4515): the
// APP-ROOT group's middleware around `missFinal` (adapter.bit), which is the
// framework's own 404/405. `App.use()` means "every request reaching this
// app", so the same layers a matched route gets — logger, compress, cors,
// secureHeaders, a `static()` mount — see the miss too, and a middleware
// that calls `next(c)` gets the 404 back from it.
//
// ROOT ONLY. `root.middleware` is the app's own list, not `collectMiddleware`
// over some chain: a group's `use()` is scoped to that group's ROUTES, and a
// miss belongs to no group. `wrapRouteErrors` is applied over the same
// one-element chain `Group.register` would build for a route on the root, so
// an app-level `onError` renders a failure raised on the miss path exactly as
// it renders one raised on a route.
//
// Called from `App.init` and again from `App.freeze()` (app.bit) — once, at
// the moment every `use()` and `onError` is guaranteed to have happened,
// never per request. Composing it in `init` too is what keeps the field from
// ever being `nil`, so there is no "not frozen yet" branch on the request
// path.
fn missHandlerFor(root: Group): Handler {
  let chain = append(root.ancestors, root)
  return wrapRouteErrors(chain, buildChain(root.middleware, missFinal))
}
