// pkg/web/peer.test.bit — `c.peer()` on a dual-stack listener (#7410).
//
// An app that serves on `::` (the default dual-stack deployment) is reached by
// IPv6 clients directly and by IPv4 clients as IPv4-mapped sockets. `c.peer()`
// keys `byIp` and every login throttle, so it must name an IPv6 client by its
// address and an IPv4 client by the plain IPv4 address — the one a listener on
// `0.0.0.0` reports — not `::ffff:127.0.0.1`, which would be a second key for
// the same client.
import { get } from "std/http"

fn peerOf(url: string): string {
  let r = get(url) catch e {
    assert(false, "GET ${url}: ${e.message()}")
    return ""
  }
  assert(r.status == 200, "GET ${url}: status ${r.status}")
  return r.body
}

test "c.peer() is ::1 for a client over [::1] and 127.0.0.1 for an IPv4 client of the same :: listener" {
  let app = App(Config{ secret = "test-secret", host = "::", port = 0 })
  app.get("/who", (c) => c.text(c.peer()))
  let server = app.serve() catch e {
    assert(false, "serve on ::: ${e.message()}")
    return
  }
  let port = server.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let v6 = peerOf("http://[::1]:${port}/who")
  let v4 = peerOf("http://127.0.0.1:${port}/who")
  server.close()
  assert(v6 == "::1", "c.peer() over [::1] = '${v6}'")
  assert(v4 == "127.0.0.1", "c.peer() from an IPv4 client of a :: listener = '${v4}'")
}

// `byIp` over the same texts: an exhausted IPv6 client is refused while a
// neighbour in the same /64 and an IPv4 client still have their own quota — the
// key is the whole address, and "ip:" + "::1" cannot collide with anything.
test "byIp counts each IPv6 address and each IPv4 address as its own client" {
  let box = RlClock{ sec = 6000 }
  let app = rlApp(rlLimit(1, 60, byIp, MemoryCounter(1000)), rlClock(box), newSink())
  let first = app.handle(rlReq("2001:db8::7", ""))
  let again = app.handle(rlReq("2001:db8::7", ""))
  let next = app.handle(rlReq("2001:db8::8", ""))
  let loop = app.handle(rlReq("::1", ""))
  let v4 = app.handle(rlReq("192.0.2.7", ""))
  assert(first.status == 200, "first request from 2001:db8::7 must pass, got ${first.status}")
  assert(
    again.status == 429,
    "second request from 2001:db8::7 must be refused, got ${again.status}",
  )
  assert(next.status == 200, "2001:db8::8 is another client, got ${next.status}")
  assert(loop.status == 200, "::1 is another client, got ${loop.status}")
  assert(v4.status == 200, "192.0.2.7 is another client, got ${v4.status}")
}
