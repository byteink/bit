// pkg/web/resjsonappend.test.bit — #5994: `c.json(v)` encodes straight into
// the body bytes when `v` has the `__jsonAppend` that `@json` generates under
// BIT_JSON_APPEND=1, and takes the `Json` tree path otherwise.
//
// A sibling of res.test.bit, not more cases in it: that file is at 768 lines
// and these would take it past the 800-line cap. `plainCtx`, `CallCount` and
// `User` come from res.test.bit and `envOr` from node.test.bit; a test file is
// part of this module, and re-importing a module-wide binding is E0042.
//
// The expectation follows the compile-time flag, read here at run time: `bit
// test` compiles and runs the tests in one process environment, so the value
// the compiler saw is the value this binary sees. `./make test-package-web`
// runs these with the flag unset, so a `@json` value must take the tree path.
// `./make test-package-web-jsonappend` sets it, so the same value must take
// the direct path. Neither run is vacuous.

@json class Note {
  export text: string,
  export tags: []string,
}

// A `Jsonable` written by hand. It has no `__jsonAppend` (the name is E0164
// on every class), so `c.json` must take the tree path for it in both runs.
class HandJson {
  calls: CallCount

  export toJson(): Json {
    this.calls.n = this.calls.n + 1
    return Json.JsonString("hand")
  }
}

fn appendFlagOn(): bool {
  return envOr("BIT_JSON_APPEND", "") == "1"
}

// The bytes the tree path gives for `v`, and so the bytes the wire carried
// before #5994: a `Res` built by `newValueRes` around `toJson()`, then
// encoded by `body()`.
fn treeRes(j: Json): Res {
  return newValueRes(200, "application/json", j, jsonEncode)
}

test "c.json on a @json value takes the direct path only when BIT_JSON_APPEND=1" {
  let n = Note{ text = "a \"quoted\" line", tags = ["x", "y"] }
  let r = plainCtx().json(n)

  assert(
    r.hasSrc == appendFlagOn(),
    "direct path taken=${r.hasSrc}, BIT_JSON_APPEND=1 is ${appendFlagOn()}",
  )
  if (appendFlagOn()) {
    // `toJson` never ran: the bytes are already in `bodyText` before `body()`
    // does anything, and the tree `value` is still unbuilt.
    assert(!r.bodySet, "body() has not run yet, so bodySet must be false")
    assert(
      r.bodyText == jsonEncode(n.toJson()),
      "eager bytes '${r.bodyText}' must equal jsonEncode(toJson()) '${jsonEncode(n.toJson())}'",
    )
  }
  assert(
    r.body() == treeRes(n.toJson()).body(),
    "body '${r.body()}' must equal the tree path's '${treeRes(n.toJson()).body()}'",
  )
  assert(r.headerValue("Content-Type") == "application/json", "Content-Type must not change")
}

test "c.json on a hand-written Jsonable takes the tree path and calls toJson once" {
  let h = HandJson{ calls = CallCount{ n = 0 } }
  let r = plainCtx().json(h)

  assert(!r.hasSrc, "a hand-written Jsonable has no __jsonAppend, so no direct path")
  assert(h.calls.n == 1, "c.json must call toJson exactly once: got ${h.calls.n}")
  assert(r.body() == "\"hand\"", "body must be the tree's encoding: got '${r.body()}'")
  assert(h.calls.n == 1, "body() must not call toJson again: got ${h.calls.n}")
}

test "wrap() and mapValue() on a c.json response give the tree path's bytes" {
  let n = Note{ text = "hi", tags = [] }
  let wrapped = plainCtx().json(n).wrap("data").wrap("outer")
  let wantWrapped = treeRes(n.toJson()).wrap("data").wrap("outer").body()
  assert(
    wrapped.body() == wantWrapped,
    "wrap: got '${wrapped.body()}', want '${wantWrapped}'",
  )
  assert(!wrapped.hasSrc, "wrap must build the value, leaving no direct-path source")

  let f = (j: Json) => Json.JsonArray([j, Json.JsonBool(true)])
  let mapped = plainCtx().json(n).mapValue(f)
  let wantMapped = treeRes(n.toJson()).mapValue(f).body()
  assert(
    mapped.body() == wantMapped,
    "mapValue: got '${mapped.body()}', want '${wantMapped}'",
  )
}

// The one timing difference, documented in docs/response.md. Without a wrap
// both paths send the value as it was at `c.json` time. With a wrap, the
// direct path builds the tree at the wrap, so a change made in between shows.
test "a value changed after c.json: the body keeps the c.json-time bytes; a later wrap sees the change only on the direct path" {
  let n = Note{ text = "before", tags = [] }
  let plain = plainCtx().json(n)
  let wrapped = plainCtx().json(n)
  n.text = "after"

  assert(
    plain.body() == "{\"text\":\"before\",\"tags\":[]}",
    "the body must be the c.json-time snapshot: got '${plain.body()}'",
  )
  let seen = "before"
  if (appendFlagOn()) {
    seen = "after"
  }
  let want = "{\"data\":{\"text\":\"${seen}\",\"tags\":[]}}"
  assert(
    wrapped.wrap("data").body() == want,
    "wrap after the change: got '${wrapped.body()}', want '${want}'",
  )
}
