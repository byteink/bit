// pkg/web/config.bit — every framework setting, as a value the app builds
// and hands to `App` (#3946). The framework reads no env var and opens no
// file, ever: an app that wants `APP_SECRET` reads it itself and puts the
// result in this class.
//
// The two rejected alternatives, recorded so they are not re-proposed.
// Reading env vars implicitly would make the framework own a naming
// convention, so a typo in a variable name silently falls back to a default
// and a missing secret becomes a production surprise. A `web.json` would add
// a format, a parser, a search path, and a second place a secret can land in
// git. Both trade a compile-time obligation for a runtime one.
//
// Every field a subsystem needs is declared by that subsystem's own ticket,
// not ahead of it — a field for work that has not landed is a promise the
// framework cannot keep.
export class Config {
  // Used for CSRF tokens only. Deliberately has NO default: a framework that
  // ships a signing key ships every deployment the same one.
  //
  // It is NOT used for sessions. The session cookie carries a random id, not
  // signed data, so a forged id simply misses in the store — signing it would
  // buy nothing and would tie session validity to this one value.
  export secret: string,
  // Largest request body the framework will read, in bytes.
  export maxBody: i64 = 1_000_000,
  // The app-level default for `c.body<T>()` (#3877), which a route may
  // override. True by default: an unexpected field in a request body is a
  // client bug or an attack, not something to ignore quietly.
  export rejectUnknownFields: bool = true,
  // Where server-side session data lives (#3947, session.bit). There is
  // deliberately NO default: an app that touches `c.session()` without
  // setting this gets a failure naming this field, not a working in-memory
  // session that leaks memory and stops working the day a second process
  // appears. `MemoryStore()` (memorystore.bit) is one line away — it is just
  // written down at the call site, where it can be read.
  //
  // Omitting it is legal because `SessionStore` is an INTERFACE, whose zero
  // value is `nil` (SPEC §13.4). A class-typed field could be neither
  // omitted (E0083) nor given a default, since a default must be a constant
  // expression (§15.4) and no class value is one — so `nil` here is the
  // language's own "absent", not a sentinel this package invented.
  //
  // `secret` is NOT used for sessions: the cookie carries a random id and
  // nothing signed. See session.bit.
  export sessions: SessionStore,
  // The interface `listen()` binds (#3885). Loopback by default, never
  // `0.0.0.0`: a framework whose default exposes a development server to the
  // whole network is one `bit run` away from an incident, and reaching the
  // network is the deliberate act — one field, spelled at the call site.
  export host: string = "127.0.0.1",
  // The port `listen()` binds. 8080 rather than 80, which needs privileges.
  export port: int = 8080,
  // Where the framework writes what it refuses to send (#3885, adapter.bit):
  // the real message behind every 5xx, with the request method and path.
  // Omittable for the same reason `sessions` is — `LogSink` is an interface,
  // whose zero value is `nil` (SPEC §13.4) — and absent means stderr, not
  // silence: a swallowed 500 with no record anywhere is the failure mode this
  // field exists to prevent.
  export logs: LogSink,
}
