// pkg/web/reply.test.bit — #5217's own acceptance: a handler may return
// `Node` directly (200, text/html) or `Res` unchanged, both through the
// REAL request/response seam (`app.handle`, adapter.test.bit's own reasoning
// for why: a route at the wrong path or behind the wrong middleware cannot
// hide from `handle()` the way calling a handler function directly could).
//
// `adapterApp`/`req`/`freezeOrPanic` (adapter.test.bit) and `okHandler`
// (router.test.bit) are already in this module — reused, not re-declared
// (E0042).

test "a handler returning Node directly serves 200 text/html, the JSX case #5217 exists for" {
  let app = adapterApp(newSink())
  app.get("/card", (c) => {
    return div(Node.Attr("class", "card"), text("hi"))
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/card"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.contentType == "text/html; charset=utf-8", "contentType: '${res.contentType}'")
  assert(
    res.body == "<div class=\"card\">hi</div>",
    "want the rendered markup, got '${res.body}'",
  )
}

// The settled shape for a non-200 reply (#5217's thread rejected
// `<div/>.status(404)` and a pending `c.status()` statement alike): body
// first, through `Ctx.html(n)` (unchanged, ctx.bit), THEN `.status(n)`
// (unchanged, `Res.status`, chainable) replaces the 200 it defaults to.
// `c.status(404).html(n)` — status first — is a SEPARATE, still-missing
// piece (`Res` has no `.html`/`.text` to chain onto its own `.status`, per
// the integrator's own comment on this ticket) and is not this test's
// shape. Nothing about `Ctx.html`/`Res.status` changed here — this proves
// `ReplyHandler`'s widening does not need them to.
test "c.html(node).status(404) serves 404 with the same markup" {
  let app = adapterApp(newSink())
  app.get("/missing", (c) => {
    return c.html(div(text("gone"))).status(404)
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/missing"))

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(res.contentType == "text/html; charset=utf-8", "contentType: '${res.contentType}'")
  assert(res.body == "<div>gone</div>", "want the rendered markup, got '${res.body}'")
}

// The acceptance's own words: "every existing (Ctx) => Res! handler still
// compiles unchanged". `okHandler` is router.test.bit's, untouched by this
// ticket, registered here exactly as adapter.test.bit already registers it
// elsewhere in the module.
test "an existing (Ctx) => Res! handler still registers and runs unchanged" {
  let app = adapterApp(newSink())
  app.get("/old", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/old"))

  assert(res.status == 200, "want okHandler's 200, got ${res.status}")
}
