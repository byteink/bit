// pkg/web/logger.bit — `app.use(logger())`: one line per request, carrying
// when it happened, the method, the route, the status and how long the whole
// downstream chain took (#3952).
//
//   2026-08-30T10:22:01Z GET /users 200 4ms
//   2026-08-30T10:22:03Z POST /users 422 11ms
//
// Five space-separated fields and nothing else. The framework's default log
// line is the one that CANNOT leak a credential into a file that ships to a
// third-party aggregator — an app that wants more writes its own middleware,
// where the decision to log a secret is visible at the place it is made.
//
// --- what the "path" field is, and why -------------------------------------
//
// It is the MATCHED ROUTE PATTERN (`Ctx.routePattern`, ctx.bit — the fully
// prefixed pattern the router matched, `/api/v1/users/:id`), never the
// request target and never the concrete path.
//
// The ticket offered the query-less path as the alternative and asked for a
// decision. The pattern wins on the property this middleware exists to
// guarantee: it is a SERVER-AUTHORED string from a fixed set closed at
// `freeze()`, so it is structurally incapable of carrying anything a client
// sent. The query-less path is not — `/reset/:token` and `/invite/:code` are
// ordinary route designs, and their concrete paths carry a credential in a
// path SEGMENT where no query strip can reach it. Logging the pattern also
// makes the line greppable and groupable (bounded cardinality: one value per
// route, not one per request), and guarantees the five fields are
// space-separated, since a registered pattern contains no space.
//
// The cost is real and is the tradeoff: the line says `/users/:id`, so it does
// not say WHICH user. An app that needs that logs it itself.
//
// There is no query-stripping code here for the same reason there is no
// header-filtering code: this file reads two strings off the `Ctx` — the
// method and the pattern — and no accessor that can reach a header, a body or
// a query value is called at all. The property is a consequence of the data
// read, not of a check that could be forgotten.
//
// --- what a failed chain logs ---------------------------------------------
//
// The status field is `-`. A middleware sits INSIDE the chain, and a failure
// that reaches this middleware has not been mapped to a status yet — that
// happens at `failureRes` (adapter.bit), outside and after. Logging `500`
// here would be a guess, and a wrong one as soon as an error carries its own
// status (#3876). The failure's message is deliberately not logged either:
// `failureRes` already writes it to this same sink, and a message can carry
// anything.
//
// --- the clock ------------------------------------------------------------
//
// The duration is measured with `monotonic`/`since` (stdlib/time/time.bit:74
// and :79), never `now()`: a wall-clock difference can go backwards across an
// NTP step and print a negative latency. `now()` is used only for the
// timestamp, which is what wall time is for.
//
// `monotonic`, `since`, `millis` and `Mono` come from std/time; `now` is
// already bound module-wide by memorystore.bit and `utc` by static.bit (an
// import binds per MODULE — SPEC §17.1), so re-importing either here is
// E0042. `logLine` (adapter.bit:97) is the package's single sink write:
// `Config.logs` when the app set one, stderr when it did not. There is
// deliberately no second sink — an app configures one destination, not two.
import { Mono, millis, monotonic, since } from "std/time"

// RFC 3339, UTC, whole seconds. `DateTime.toString()` is deliberately not
// used: it always renders a numeric `+00:00` rather than `Z`
// (stdlib/time/zoned.bit), and it would append a fractional-second field
// whenever the nanosecond reading is nonzero — for a real clock reading
// almost always — so every line would carry a nine-digit tail that no
// reader of a request log wants. `'T'` and `'Z'` are LDML-quoted literals
// (stdlib/time/ldmlfmt.bit): every ASCII letter in a pattern must be one of
// its recognized field symbols, so an unquoted `T` or `Z` would fail
// `format` as an unimplemented pattern letter.
const logStampLayout = "yyyy-MM-dd'T'HH:mm:ss'Z'"

// The status field of a request whose chain failed before producing a `Res`.
const logStatusUnknown = "-"

// Milliseconds, always, with the unit spelled out. `formatDuration`
// (stdlib/time/duration.bit:23) is not used because it drops fractional
// seconds at and above one second — a 1.9s request would print `1s`,
// understating by 47% exactly the slow request this field exists to surface.
// Sub-millisecond requests print `0ms`, which is honest at this resolution.
const logDurationUnit = "ms"

// The request logger. Registered like any other middleware
// (`app.use(logger())`), so it wraps everything registered after it on the
// same scope — which is what makes the duration cover the whole downstream
// chain and not just the handler. Register it FIRST to time everything.
//
// The `catch` is NOT the `next(c)?` workaround the other middlewares carried
// (#4568, #4580 removed those): it writes the request line BEFORE re-raising,
// so a failed request is logged exactly once and with the same duration a
// served one would carry. `?` cannot do that, so this `catch` stays.
export fn logger(): Middleware {
  return (c, next) => {
    let start = monotonic()
    let r = next(c) catch e {
      logRequestLine(c, start, logStatusUnknown)
      return rethrow(e)
    }
    logRequestLine(c, start, "${r.statusCode()}")
    return r
  }
}

// The one place this file writes a line. `c.config.logs` and
// `c.routePattern` are unexported fields of an exported class, which are
// module-private and not file-private (SPEC §17.3) — the same seam
// `registeredNames` (ctx.bit) already reaches through to app.bit's
// `NameRegistry`.
fn logRequestLine(c: Ctx, start: Mono, status: string) {
  // `logStampLayout` is a fixed, already-valid pattern, so `format` cannot
  // fail here; the catch is a safety net, not a real path.
  let stamp = now().inZone(utc()).format(logStampLayout) catch e {
    panic(e.message())
  }
  let took = "${millis(since(start))}${logDurationUnit}"
  logLine(c.config.logs, "${stamp} ${c.method()} ${logTarget(c)} ${status} ${took}")
}

// The route the request took, or the path it asked for when it took none.
//
// An `app.use()` logger now runs for a request that matched NO route
// (#4515), and such a `Ctx` carries no pattern — `routePattern` is "", which
// `joinPath` (app.bit) can never produce for a registered route, so the
// empty string is an unambiguous "there is no route here". Logging the
// PATTERN for a matched route is deliberate and unchanged: `/users/:id`
// groups a million requests into one line's worth of identity, which is what
// makes a request log aggregable. A miss has nothing to group by, and an
// empty third field would make the line unparseable for the reader that
// splits it into five.
fn logTarget(c: Ctx): string {
  if (c.routePattern == "") {
    return c.path()
  }
  return c.routePattern
}
