// pkg/web/logger.bit — `app.use(logger())`: one std/log record per request,
// carrying the method, the route, the status and how long the whole
// downstream chain took (#3952, #7429).
//
//   time=2026-08-30T10:22:01Z level=INFO msg=request method=GET path=/users status=200 took=4ms
//   time=2026-08-30T10:22:03Z level=INFO msg=request method=POST path=/users status=422 took=11ms
//
// Four attributes and nothing else, written through `Config.logger`
// (config.bit; std/log's `getDefault()` when the app set none), so the format
// is the app's handler's: text, JSON, whatever its `Handler` writes. The
// framework's default record is the one that CANNOT leak a credential into a
// file that ships to a third-party aggregator — an app that wants more writes
// its own middleware, where the decision to log a secret is visible at the
// place it is made.
//
// --- what the "path" field is, and why -------------------------------------
//
// It is the MATCHED ROUTE PATTERN (`Ctx.routePattern`, ctx.bit — the fully
// prefixed pattern the router matched, `/api/v1/users/:id`), never the
// request target and never the concrete path.
//
// The ticket offered the query-less path as the alternative and asked for a
// decision. The pattern wins on the property this middleware exists to
// guarantee: it is a SERVER-AUTHORED string from a fixed set closed at
// `freeze()`, so it is structurally incapable of carrying anything a client
// sent. The query-less path is not — `/reset/:token` and `/invite/:code` are
// ordinary route designs, and their concrete paths carry a credential in a
// path SEGMENT where no query strip can reach it. Logging the pattern also
// makes the record greppable and groupable (bounded cardinality: one value per
// route, not one per request), and a registered pattern contains no space, so
// a text handler never has to quote it.
//
// The cost is real and is the tradeoff: the record says `/users/:id`, so it does
// not say WHICH user. An app that needs that logs it itself.
//
// There is no query-stripping code here for the same reason there is no
// header-filtering code: this file reads two strings off the `Ctx` — the
// method and the pattern — and no accessor that can reach a header, a body or
// a query value is called at all. The property is a consequence of the data
// read, not of a check that could be forgotten.
//
// --- what a failed chain logs ---------------------------------------------
//
// The record has no `status` attribute and carries `failed=true`. A
// middleware sits INSIDE the chain, and a failure that reaches this
// middleware has not been mapped to a status yet — that happens at
// `failureRes` (adapter.bit), outside and after. Logging `500` here would be
// a guess, and a wrong one as soon as an error carries its own status
// (#3876). The failure's message is deliberately not logged either:
// `failureRes` already writes it to this same logger, and a message can carry
// anything.
//
// --- the clock ------------------------------------------------------------
//
// The duration is measured with `monotonic`/`since` (stdlib/time/time.bit),
// never `now()`: a wall-clock difference can go backwards across an NTP step
// and print a negative latency. The record's own timestamp is std/log's.
//
// --- the disabled path ----------------------------------------------------
//
// With INFO disabled on the app's Logger the middleware is `next(c)` and
// nothing else: no clock read, no attribute built, no record. The attributes
// are constructed only after `enabled()` said yes, which is what keeps a
// quiet logger at zero allocations per request (std/log's own disabled call
// allocates nothing, and attributes built before the call would not be
// covered by that).
//
// The record is built with std/log's `at(LevelInfo)`, which holds these four
// attributes in the record itself: the enabled line costs the record and the
// line, not an object per attribute (#7438).
//
// `monotonic`, `since` and `Mono` come from std/time; `Logger` and `Record`
// are bound module-wide by adapter.bit (an import binds per MODULE — SPEC
// §17.1), so re-importing them here is E0042. `appLogger` and `errorRecord`
// (adapter.bit) are the package's single Logger access.
import { monotonic, since } from "std/time"
import { LevelInfo } from "std/log"

// The request logger. Registered like any other middleware
// (`app.use(logger())`), so it wraps everything registered after it on the
// same scope — which is what makes the duration cover the whole downstream
// chain and not just the handler. Register it FIRST to time everything.
//
// The `catch` is NOT the `next(c)?` workaround the other middlewares carried
// (#4568, #4580 removed those): it writes the request record BEFORE
// re-raising, so a failed request is logged exactly once and with the same
// duration a served one would carry. `?` cannot do that, so this `catch`
// stays.
export fn logger(): Middleware {
  return (c, next) => {
    let lg = appLogger(c.config)
    if (!lg.enabled(LevelInfo)) {
      return next(c)
    }
    let start = monotonic()
    let r = next(c) catch e {
      let rec = lg.at(LevelInfo).str("method", c.method()).str("path", logTarget(c))
      rec.bool("failed", true).duration("took", since(start)).log("request")
      return rethrow(e)
    }
    let rec = lg.at(LevelInfo).str("method", c.method()).str("path", logTarget(c))
    rec.int("status", r.statusCode()).duration("took", since(start)).log("request")
    return r
  }
}

// The route the request took, or the path it asked for when it took none.
//
// An `app.use()` logger now runs for a request that matched NO route
// (#4515), and such a `Ctx` carries no pattern — `routePattern` is "", which
// `joinPath` (app.bit) can never produce for a registered route, so the
// empty string is an unambiguous "there is no route here". Logging the
// PATTERN for a matched route is deliberate and unchanged: `/users/:id`
// groups a million requests into one line's worth of identity, which is what
// makes a request log aggregable. A miss has nothing to group by, and an
// empty third field would make the line unparseable for the reader that
// splits it into five.
fn logTarget(c: Ctx): string {
  if (c.routePattern == "") {
    return c.path()
  }
  return c.routePattern
}
