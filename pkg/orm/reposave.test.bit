// pkg/orm/reposave.test.bit — `Repo<T>.save(v)` / `TxRepo<T>.save(v)`
// (#6991), against the fake driver `testdrivers.test.bit` declares
// (`wrAdapter`/`newWrPool`/`lastWrCall`, `Account`; same module, SPEC §17.1,
// so none is redeclared here). A separate file because `repo.test.bit`
// would pass the 800-line ceiling with these.
//
// Each test counts the statements the fake saw: `save` must cost exactly one
// `insert` or one `update`, never a read first.

// A composite key (#5084): two `@id` fields.
@table class SaveMembership {
  @id
  userId: i64
  @id
  teamId: i64
  role: string
}

fn saveRepo<T: Tabled>(a: wrAdapter): Repo<T> {
  return Repo<T>{
    db = newWrPool(a), wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
}

test "save() of a zero-id row inserts and returns the database-written id, one statement (#6991)" {
  let a = wrAdapter{
    cols = ["id", "name", "email"], rows = [[Value.Int(7), Value.Text("Ada"), Value.Text("a@x.com")]],
    affected = 0,
  }
  let saved = saveRepo<Account>(a).save(Account{ id = 0, name = "Ada", email = "a@x.com" }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(saved.id == 7, "wanted the id the database wrote back (7), got ${saved.id}")
  assert(len(a.calls) == 1, "save must be exactly one statement, got ${len(a.calls)}")
  assert(hasPrefix(lastWrCall(a).sql, "insert into account "), "got: ${lastWrCall(a).sql}")
}

test "save() of a row with an id updates and returns it, one statement (#6991)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 1 }
  let saved = saveRepo<Account>(a).save(Account{ id = 3, name = "Ada", email = "a@x.com" }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(saved.id == 3 && saved.name == "Ada", "save must hand back the row it was given")
  assert(len(a.calls) == 1, "save must be exactly one statement, got ${len(a.calls)}")
  assert(
    lastWrCall(a).sql == "update account set name = $1, email = $2 where id = $3",
    "got: ${lastWrCall(a).sql}",
  )
}

test "save() on a composite key inserts while any part is zero, updates by every part once all are set (#6991)" {
  let ins = wrAdapter{
    cols = ["user_id", "team_id", "role"], rows = [[Value.Int(1), Value.Int(9), Value.Text("admin")]],
    affected = 0,
  }
  let saved = saveRepo<SaveMembership>(ins).save(
    SaveMembership{ userId = 1, teamId = 0, role = "admin" },
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(saved.teamId == 9, "wanted the row the insert wrote back, got teamId ${saved.teamId}")
  assert(len(ins.calls) == 1, "one statement, got ${len(ins.calls)}")
  assert(hasPrefix(lastWrCall(ins).sql, "insert into "), "got: ${lastWrCall(ins).sql}")

  let upd = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 1 }
  saveRepo<SaveMembership>(upd).save(SaveMembership{ userId = 1, teamId = 2, role = "owner" }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(len(upd.calls) == 1, "one statement, got ${len(upd.calls)}")
  assert(
    hasSuffix(lastWrCall(upd).sql, "set role = $1 where user_id = $2 and team_id = $3"),
    "the UPDATE must match on every key part, got: ${lastWrCall(upd).sql}",
  )
}

test "TxRepo<T>.save(v) forwards to the repo's save (#6991)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 1 }
  let tx = TxRepo<Account>{ inner = saveRepo<Account>(a) }
  tx.save(Account{ id = 3, name = "Ada", email = "a@x.com" }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    len(a.calls) == 1 && hasPrefix(lastWrCall(a).sql, "update account "),
    "got ${len(a.calls)} calls",
  )
}

test "save() on a missing row fails with WriteError, the update's own error (#6991)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 0 }
  saveRepo<Account>(a).save(Account{ id = 3, name = "Ada", email = "a@x.com" }) catch e {
    let (_, ok) = e.(WriteError)
    assert(ok, "must be a WriteError, got '${e.message()}'")
    return
  }
  assert(false, "a 0-row UPDATE must fail")
}
