// pkg/orm/version.test.bit — #5059's acceptance, against a fake driver.
//
// Reuses `wrAdapter`/`wrConn`/`wrRows`/`newWrPool`/`lastWrCall` and
// `fieldWithId` from ./write.test.bit, `field` from ./naming.test.bit,
// `fieldWithVersion` from ./patch.test.bit, and `argsEq`/`valueEq`/
// `valueRepr`/`contains` from ./query.test.bit — all declared in this
// module already (SPEC §17.1); redeclaring any of them here would be
// E0042. `TableDesc`/`SaveResult`/`WriteError`/`WriteCause` are exported by
// ./write.bit; `VersionError`/`VersionCause`/`StaleWriteError` by
// ./version.bit.
//
// The patch builder's own refusal on a `@version` table with no version
// supplied (this ticket's sixth acceptance bullet) is ALREADY proven by
// ./patch.test.bit's "a chain against a @version table with no supplied
// version is refused..." test (#5060, landed) — not duplicated here.

fn vAccountDesc(): TableDesc {
  return TableDesc{
    table: "accounts",
    fields: [fieldWithId("id"), fieldWithVersion("version"), field("balance")],
    classAttrs: []AttrDesc(0),
  }
}

fn vAccountValues(id: int, version: int, balance: int): map<string, Value> {
  return map<string, Value>{
    "id": Value.Int(id), "version": Value.Int(version), "balance": Value.Int(balance),
  }
}

test "save on a @version entity emits an UPDATE whose WHERE carries the primary key and the old version, and whose SET raises version by exactly 1" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)

  save(p, vAccountDesc(), vAccountValues(7, 5, 100), true) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = "update accounts set id = $1, version = $2, balance = $3 where id = $4 and version = $5"
  assert(lastWrCall(a).sql == want, "got: ${lastWrCall(a).sql}")
  assert(
    argsEq(
      lastWrCall(a).args,
      [Value.Int(7), Value.Int(6), Value.Int(100), Value.Int(7), Value.Int(5)],
    ),
    "SET must bind the new version (old 5 + 1 = 6) and WHERE must bind both the primary key (7) and the old version (5)",
  )
}

test "a driver reporting 0 rows affected on a @version UPDATE yields StaleWriteError naming the class, the key and both version numbers" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 0 }
  let p = newWrPool(a)

  save(p, vAccountDesc(), vAccountValues(9, 5, 100), true) catch e {
    let (se, ok) = e.(StaleWriteError)
    assert(ok, "must be a StaleWriteError, got '${e.message()}'")
    assert(se.oldVersion == 5, "must carry the old version")
    assert(se.newVersion == 6, "must carry the attempted new version")
    assert(contains(e.message(), "accounts"), "must name the class: ${e.message()}")
    assert(contains(e.message(), "9"), "must name the key: ${e.message()}")
    assert(contains(e.message(), "5"), "must name the old version: ${e.message()}")
    assert(contains(e.message(), "6"), "must name the new version: ${e.message()}")
    return
  }
  assert(false, "a @version UPDATE matching 0 rows must error, never return success")
}

test "the @version 0-rows error is a distinct type from WriteError, the row-not-found error #5058 raises" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 0 }
  let p = newWrPool(a)

  save(p, vAccountDesc(), vAccountValues(9, 5, 100), true) catch e {
    let (_, isWriteError) = e.(WriteError)
    assert(
      !isWriteError,
      "a stale write must never also satisfy WriteError - a caller's catch must be able to tell 'reload and retry' from '404'",
    )
    let (_, isStale) = e.(StaleWriteError)
    assert(isStale, "must be a StaleWriteError")
    return
  }
  assert(false, "a @version UPDATE matching 0 rows must error")
}

test "a successful save leaves the entity holding the new version, proven by a second save emitting WHERE version = new" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)

  let result = save(p, vAccountDesc(), vAccountValues(7, 5, 100), true) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let (newVersion, ok) = result.generated["version"]
  assert(
    ok,
    "a successful @version save must return the new version in generated, the same channel a generated key already uses",
  )
  match (newVersion) {
    Int(n) => assert(n == 6, "must be old + 1, got ${n}")
    _ => assert(false, "the generated version must be an Int")
  }

  // The caller applies it onto its own values the same way `write.test.bit`'s
  // own "caller applies RETURNING's id" test applies a generated key -
  // proving the SQL of the NEXT save, not a field read off the first result.
  let a2 = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p2 = newWrPool(a2)
  save(p2, vAccountDesc(), vAccountValues(7, 6, 120), true) catch e2 {
    assert(false, "must not error: ${e2.message()}")
    return
  }
  let want = "update accounts set id = $1, version = $2, balance = $3 where id = $4 and version = $5"
  assert(lastWrCall(a2).sql == want, "got: ${lastWrCall(a2).sql}")
  assert(
    argsEq(
      lastWrCall(a2).args,
      [Value.Int(7), Value.Int(7), Value.Int(120), Value.Int(7), Value.Int(6)],
    ),
    "the second save must WHERE version = 6 (the value the first save produced) and SET version = 7 (6 + 1)",
  )
}

test "a class with two @version fields is rejected before any statement reaches the driver" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)
  let badDesc = TableDesc{
    table: "accounts",
    fields: [fieldWithId("id"), fieldWithVersion("version"), fieldWithVersion("revision")],
    classAttrs: []AttrDesc(0),
  }
  let badValues = map<string, Value>{
    "id": Value.Int(7), "version": Value.Int(5), "revision": Value.Int(5),
  }

  save(p, badDesc, badValues, true) catch e {
    let (ve, ok) = e.(VersionError)
    assert(ok, "must be a VersionError, got '${e.message()}'")
    assert(ve.cause == VersionCause.MultipleVersionFields, "cause must be MultipleVersionFields")
    assert(contains(e.message(), "accounts"), "must name the class: ${e.message()}")
    assert(len(a.calls) == 0, "must refuse before any statement reaches the driver")
    return
  }
  assert(false, "a class with two @version fields must be rejected, never saved")
}
