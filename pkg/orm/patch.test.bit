// pkg/orm/patch.test.bit — #5060's acceptance, against a fake driver.
//
// `ptAdapter` is the "database": `exec` records the statement and hands
// back one canned affected-row count (`affected`) — `Patch`/`DeletePatch`
// never call `query`, only `exec` (`pkg/orm/write.bit`'s own header: "exec
// REPORTS AFFECTED ROWS").
//
// `pool`/`Pool`/`Datasource`/`Conn`/`Rows`/`Stmt`/`Tx`/`Value`/`Isolation`
// are imported by ./data.test.bit, this file's sibling in the same module
// (SPEC §17.1) — a second import here would be E0042. `contains` is
// imported by ./query.test.bit likewise. `field` (a plain, non-`@id`
// `FieldDesc`) is declared in ./naming.test.bit and reused here.
// `argsEq`/`valueEq`/`valueRepr` are declared in ./query.test.bit and
// reused here rather than redeclared.

class Contact { id: i64, name: string, phone: string }

class Ledger { id: i64, version: i64, phone: string }

fn fieldWithVersion(name: string): FieldDesc {
  return FieldDesc{
    name: name,
    typeName: "i64",
    attrs: [AttrDesc{ name: "version", args: []string(0) }],
  }
}

class ptCall { sql: string, args: []Value }

// The fake database: every `exec` call, in order, plus the one canned
// affected-row count a test wants back. No `query` — `Patch`/`DeletePatch`
// never call it.
class ptAdapter {
  calls: []ptCall
  affected: int

  connect(cfg: Datasource): Conn! {
    return ptConn{ a: this }
  }
}

class ptConn {
  a: ptAdapter

  query(sqlText: string, params: []Value): Rows! {
    fail newError("fake: query not supported")
  }

  exec(sqlText: string, params: []Value): int! {
    this.a.calls = append(this.a.calls, ptCall{ sql: sqlText, args: params })
    return this.a.affected
  }

  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }

  begin(): Tx! {
    fail newError("fake: begin not supported")
  }

  close() {}
}

fn newPtPool(a: ptAdapter): Pool {
  let p = pool(a, Datasource{ host: "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

fn lastPtCall(a: ptAdapter): ptCall {
  return a.calls[len(a.calls) - 1]
}

test "a chain with one where and one set emits UPDATE naming only that column with both values as placeholders" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 1 }
  let p = newPtPool(a)
  let fields = [field("id"), field("name"), field("phone")]

  let n = update<Contact>(p, "contacts", fields).where("id", Value.Int(1)).set(
    "phone",
    Value.Text("555"),
  ).run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = "update contacts set phone = $2 where id = $1"
  assert(lastPtCall(a).sql == want, "got: ${lastPtCall(a).sql}")
  assert(
    argsEq(lastPtCall(a).args, [Value.Int(1), Value.Text("555")]),
    "bound args did not match",
  )
  assert(n == 1, "got ${n}")
}

test "two chained set calls emit both columns in one statement" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 1 }
  let p = newPtPool(a)
  let fields = [field("id"), field("name"), field("phone")]

  update<Contact>(p, "contacts", fields).where("id", Value.Int(1)).set("name", Value.Text("Ada")).set(
    "phone",
    Value.Text("555"),
  ).run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = "update contacts set name = $2, phone = $3 where id = $1"
  assert(lastPtCall(a).sql == want, "got: ${lastPtCall(a).sql}")
}

test "run() returns the affected count the fake driver reported and does not error when it is 0" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 0 }
  let p = newPtPool(a)
  let fields = [field("id"), field("phone")]

  let n = update<Contact>(p, "contacts", fields).where("id", Value.Int(1)).set(
    "phone",
    Value.Text("555"),
  ).run() catch e {
    assert(false, "0 affected rows must not be an error: ${e.message()}")
    return
  }
  assert(n == 0, "got ${n}")
}

test "a chain with no where and no .all() is refused before any statement reaches the driver" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 5 }
  let p = newPtPool(a)
  let fields = [field("id"), field("phone")]

  update<Contact>(p, "contacts", fields).set("phone", Value.Text("555")).run() catch e {
    let (pe, ok) = e.(PatchError)
    assert(ok, "must be a PatchError, got '${e.message()}'")
    assert(pe.cause == PatchCause.NoWhereClause, "cause must be NoWhereClause")
    assert(len(a.calls) == 0, "no statement may reach the driver before the refusal")
    return
  }
  assert(false, "a bare update with no where and no .all() must be refused")
}

test "the same chain with .all() emits the unfiltered UPDATE" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 5 }
  let p = newPtPool(a)
  let fields = [field("id"), field("phone")]

  let n = update<Contact>(p, "contacts", fields).set("phone", Value.Text("555")).all().run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(lastPtCall(a).sql == "update contacts set phone = $1", "got: ${lastPtCall(a).sql}")
  assert(n == 5, "got ${n}")
}

test "a chain against a @version table with no supplied version is refused, naming the class and @version" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 1 }
  let p = newPtPool(a)
  let fields = [field("id"), fieldWithVersion("version"), field("phone")]

  update<Ledger>(p, "ledgers", fields).where("id", Value.Int(1)).set("phone", Value.Text("555")).run() catch e {
    let (pe, ok) = e.(PatchError)
    assert(ok, "must be a PatchError, got '${e.message()}'")
    assert(pe.cause == PatchCause.VersionRequired, "cause must be VersionRequired")
    assert(contains(e.message(), "ledgers"), "must name the class: ${e.message()}")
    assert(contains(e.message(), "@version"), "must name @version: ${e.message()}")
    assert(len(a.calls) == 0, "no statement may reach the driver before the refusal")
    return
  }
  assert(false, "an update on a @version table with no supplied version must be refused")
}

test "deleteMany<T>().where(...).run() emits DELETE with the predicate" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 2 }
  let p = newPtPool(a)
  let fields = [field("id"), field("name"), field("phone")]

  let n = deleteMany<Contact>(p, "contacts", fields).where("id", Value.Int(1)).run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(lastPtCall(a).sql == "delete from contacts where id = $1", "got: ${lastPtCall(a).sql}")
  assert(n == 2, "got ${n}")
}

test "deleteMany<T>().run() with no where and no .all() is refused before any statement reaches the driver" {
  let a = ptAdapter{ calls: []ptCall(0), affected: 9 }
  let p = newPtPool(a)
  let fields = [field("id")]

  deleteMany<Contact>(p, "contacts", fields).run() catch e {
    let (pe, ok) = e.(PatchError)
    assert(ok, "must be a PatchError, got '${e.message()}'")
    assert(pe.cause == PatchCause.NoWhereClause, "cause must be NoWhereClause")
    assert(len(a.calls) == 0, "no statement may reach the driver before the refusal")
    return
  }
  assert(false, "a bare delete with no where and no .all() must be refused")
}
