// pkg/orm/runner.bit — the batch migration runner (#6309, "laravel style").
//
//   bit migrate            // migratecli.bit (O3b): every pending file, one new batch
//   bit migrate rollback   // undoes the whole last batch
//
// THE REGISTRY IS AN EXPLICIT LIST, NEVER A DIRECTORY SCAN. Bit has no
// reflection, so this file cannot find migration files itself — a caller
// hands `migrate`/`rollback` a `[]MigrationFile` (`migration.bit`); O3b's
// `migratecli.bit` is the one that builds it from a generated registry.
//
// FOUR PIECES, EACH GUARDING ONE FAILURE:
//
// 1. AN ADVISORY LOCK AROUND THE WHOLE RUN. `acquireLock` is the first
//    statement `migrate`/`rollback` issue; `releaseLockBestEffort` is
//    `defer`red immediately after it succeeds, so it runs whether the run
//    below succeeds or fails via `fail`/`?` — SPEC §18.5: a `defer` runs on
//    an ordinary early return, only a `panic` skips it. `acquireLock`
//    MATCHES ON `dialect.server`: `Postgres` issues the real
//    `pg_advisory_lock`; `Mysql(_)` REFUSES before any statement is sent,
//    naming the gap (O3c is the working `GET_LOCK` implementation). The two
//    `RunnerDialect` fields (`render`/`server`) are never collapsed into
//    one — they answer different questions ("how do I render this
//    migration's SQL" vs "which server locks it") — bundled into one class
//    only to satisfy `bit lint`'s max-params finding, the same reasoning
//    `write.bit`'s own header gives for `TableDesc`.
//
// 2. ONE TRANSACTION PER MIGRATION, WHEN THE DIALECT LEAVES ONE TO USE.
//    `runOneMigration`/`runOneRevert` render a migration's ops, split the
//    result into the statements the dialect flagged transactional and the
//    ones it did not (`dialect.bit`'s own `Statement.transactional`), then
//    issue, in order: `BEGIN`, every transactional statement, the
//    `migrations` row for THIS migration (so the ledger write is part of
//    the same atomic unit as the DDL it describes), `COMMIT` — and only
//    after that commits, each non-transactional statement individually,
//    with no wrapping transaction (Postgres refuses `CREATE INDEX
//    CONCURRENTLY` inside one). A failure before `COMMIT` issues
//    `ROLLBACK` and leaves the migration unapplied/unreverted.
//
//    WHEN THE DIALECT FLAGS EVERY STATEMENT NON-TRANSACTIONAL (MySQL DDL
//    auto-commits, `mysql.bit` honestly renders every statement
//    `transactional: false`) there is no `BEGIN`/`COMMIT` block left to
//    carry the ledger write, and writing it first would commit the ledger
//    before the first line of DDL ran. `runOneMigration`/`runOneRevert`
//    instead run every statement first and write the ledger row only once
//    they have all succeeded, with no wrapping transaction of its own — a
//    failing statement leaves no row at all. THE COST: a crash between the
//    last statement and the ledger write leaves the migration's DDL
//    applied but unrecorded, so the next `migrate`/`rollback` re-runs it —
//    the lesser failure against a ledger that lies about a migration that
//    never finished.
//
// 3. BATCHES, NEVER A SINGLE LAST-MIGRATION WINDOW. `migrate` applies every
//    pending file (by name order) as ONE new batch, `maxBatch(history) +
//    1`. `rollback` undoes every row of the HIGHEST batch, newest file
//    first — never a single migration, and never a whole history — so one
//    `bit migrate` run and its one `bit migrate rollback` are exact
//    opposites, the same unit Laravel's own migrate/rollback pair is.
//
// 4. NAMES, NOT INTEGER VERSIONS. Checksums, the integer `version` field
//    and the production `maxAgeNs` rollback window are gone (#6309 — Laravel
//    has none of the three); a migration is identified by its file name,
//    `history.bit`'s own primary key.

import { Millisecond, Mono, monotonic, since } from "std/time"
import { sorted } from "std/sort"

// One migration `migrate` actually applied, for the caller's own report.
export class AppliedMigration {
  export name: string,
  export batch: int,
  export appliedAt: i64,
  export durationMs: i64,
}

export class MigrateReport {
  export applied: []AppliedMigration,
}

// One migration `rollback` actually reverted.
export class RevertedMigration {
  export name: string,
  export batch: int,
}

export class RollbackReport {
  export reverted: []RevertedMigration,
}

// The two facts `migrate`/`rollback` need about the target server, bundled
// into one parameter — see this file's header, piece 1, for why the two
// fields stay separate rather than one derived from the other.
export class RunnerDialect {
  export render: Dialect,
  export server: ServerDialect,
}

// This package's own advisory-lock namespace key (`pg_advisory_lock` takes
// a bigint). Arbitrary, but must never change once shipped: two runner
// builds that disagree on it would never see each other's lock, and a
// rolling deploy's concurrent DDL would interleave again — exactly what
// this lock exists to prevent.
const advisoryLockKey: int = 584176068

// Applies every migration in `migrations` not yet recorded in `migrations`
// (the ledger table), in ascending name order, as one new batch. See this
// file's header for the lock, the transaction shape and the batch rule.
export fn migrate(
  db: Data,
  dialect: RunnerDialect,
  migrations: []MigrationFile,
  at: Timestamp,
): MigrateReport! {
  acquireLock(db, dialect.server)?
  defer releaseLockBestEffort(db)
  ensureHistoryTable(db)?
  let history = loadHistory(db)?
  let pending = pendingInOrder(migrations, history)
  let batch = maxBatch(history) + 1
  let applied = []AppliedMigration(0)
  for f of pending {
    applied = append(applied, applyMigration(db, dialect.render, f, batch, at)?)
  }
  return MigrateReport{ applied = applied }
}

// Reverts every migration in the HIGHEST recorded batch, newest file first
// — see this file's header, piece 3. A no-op, returning an empty report,
// when nothing has ever been applied.
export fn rollback(db: Data, dialect: RunnerDialect, migrations: []MigrationFile): RollbackReport! {
  acquireLock(db, dialect.server)?
  defer releaseLockBestEffort(db)
  let history = loadHistory(db)?
  let batch = maxBatch(history)
  if (batch == 0) {
    return RollbackReport{ reverted = []RevertedMigration(0) }
  }
  let toRevert = newestFirstInBatch(history, batch)
  let reverted = []RevertedMigration(0)
  for h of toRevert {
    reverted = append(reverted, revertMigration(db, dialect.render, migrations, h)?)
  }
  return RollbackReport{ reverted = reverted }
}

// Runs `f.m.up`, renders the ops it collected and applies them (see this
// file's header, piece 2). Any failure is re-raised naming `f.name`, so the
// caller always knows which migration stopped the run.
fn applyMigration(
  db: Data,
  dialect: Dialect,
  f: MigrationFile,
  batch: int,
  at: Timestamp,
): AppliedMigration! {
  let start = monotonic()
  runOneMigration(db, dialect, f, batch, at) catch e {
    fail newError("pkg/orm: migrate: ${f.name}: ${e.message()}")
  }
  return AppliedMigration{
    name = f.name,
    batch = batch,
    appliedAt = at.ns,
    durationMs = elapsedMs(start),
  }
}

fn runOneMigration(db: Data, dialect: Dialect, f: MigrationFile, batch: int, at: Timestamp): ()! {
  let schema = Schema{ ops = []SchemaOp(0) }
  f.m.up(schema)?
  let stmts = renderOps(dialect, schema.ops)
  let (transactional, nonTransactional) = splitByTransactional(stmts)
  if (len(transactional) > 0) {
    runTransactionalBlock(db, transactional, (d) => {
      recordApplied(d, HistoryEntry{ migration = f.name, batch = batch, appliedAt = at.ns })?
    })?
    runNonTransactional(db, nonTransactional)?
    return
  }
  runNonTransactional(db, nonTransactional)?
  recordApplied(db, HistoryEntry{ migration = f.name, batch = batch, appliedAt = at.ns })?
}

// Runs `f.m.down`, renders the ops it collected and applies them, deleting
// `f`'s ledger row the same way `runOneMigration` writes it (this file's
// header, piece 2, applied in reverse).
fn revertMigration(
  db: Data,
  dialect: Dialect,
  migrations: []MigrationFile,
  h: HistoryEntry,
): RevertedMigration! {
  let f = findMigrationFile(migrations, h.migration)?
  runOneRevert(db, dialect, f) catch e {
    fail newError("pkg/orm: migrate: rollback: ${f.name}: ${e.message()}")
  }
  return RevertedMigration{ name = f.name, batch = h.batch }
}

fn runOneRevert(db: Data, dialect: Dialect, f: MigrationFile): ()! {
  let schema = Schema{ ops = []SchemaOp(0) }
  f.m.down(schema)?
  let stmts = renderOps(dialect, schema.ops)
  let (transactional, nonTransactional) = splitByTransactional(stmts)
  if (len(transactional) > 0) {
    runTransactionalBlock(db, transactional, (d) => {
      deleteHistory(d, f.name)?
    })?
    runNonTransactional(db, nonTransactional)?
    return
  }
  runNonTransactional(db, nonTransactional)?
  deleteHistory(db, f.name)?
}

fn elapsedMs(start: Mono): i64 {
  return since(start) / Millisecond
}

// `BEGIN`, every statement in `transactional`, then `ledger(db)` (the
// caller's own ledger write — `recordApplied` for `migrate`, `deleteHistory`
// for `rollback`), then `COMMIT`. Any failure along the way issues
// `ROLLBACK` (best effort — the failure already on its way out is the one
// worth reporting) before propagating the original error, so the migration
// this transaction describes is left un-applied/un-reverted.
fn runTransactionalBlock(db: Data, transactional: []Statement, ledger: (Data) => ()!): ()! {
  db.exec("BEGIN", []Value(0))?
  runTransactionalBody(db, transactional, ledger) catch e {
    execIgnoringError(db, "ROLLBACK")
    fail e
  }
  db.exec("COMMIT", []Value(0))?
}

fn runTransactionalBody(db: Data, transactional: []Statement, ledger: (Data) => ()!): ()! {
  for s of transactional {
    db.exec(s.sql, []Value(0))?
  }
  ledger(db)?
}

// The statements a dialect flagged non-transactional, run individually,
// outside any transaction, after the migration's own transactional block —
// and therefore its ledger row — has already committed.
fn runNonTransactional(db: Data, nonTransactional: []Statement): ()! {
  for s of nonTransactional {
    db.exec(s.sql, []Value(0))?
  }
}

fn execIgnoringError(db: Data, sqlText: string) {
  db.exec(sqlText, []Value(0)) catch _ {
    return
  }
}

// `pg_advisory_lock` on Postgres — the first statement `migrate`/`rollback`
// issue. Refuses on MySQL, issuing nothing, rather than sending a
// Postgres-only function name to a server that has none. See this file's
// header, piece 1.
fn acquireLock(db: Data, dialect: ServerDialect): ()! {
  match (dialect) {
    Postgres => db.exec("select pg_advisory_lock($1)", [Value.Int(advisoryLockKey)])?
    Mysql(_) => fail newError(
        "pkg/orm: migrate: no MySQL advisory lock implementation yet - " +
        "migrate/rollback refuse rather than running unlocked or sending Postgres-only SQL " +
        "to a MySQL server",
    )
  }
}

// `pg_advisory_unlock`, `defer`red right after `acquireLock` succeeds so it
// runs on every path out of `migrate`/`rollback` but a panic. Swallows its
// own failure — the same `abandon` reasoning `stdlib/sql/tx.bit` already
// uses for a rollback that fails while a more useful error is already on
// its way to the caller.
fn releaseLockBestEffort(db: Data) {
  db.exec("select pg_advisory_unlock($1)", [Value.Int(advisoryLockKey)]) catch _ {
    return
  }
}

// `migrations` filtered to names absent from `history`, sorted ascending —
// `migrate`'s own apply order.
fn pendingInOrder(migrations: []MigrationFile, history: []HistoryEntry): []MigrationFile {
  let pending = []MigrationFile(0)
  for f of migrations {
    if (!hasName(history, f.name)) {
      pending = append(pending, f)
    }
  }
  return sorted(pending, (a, b) => a.name < b.name)
}

// `history` filtered to `batch`, sorted by name DESCENDING — `rollback`'s
// own "newest file first" order (this file's header, piece 3). Mutating
// this to sort/filter the WHOLE of `history` instead of just `batch` is
// exactly the one-line regression that turns `rollback` into "undo
// everything ever applied" — see this ticket's own live proof.
fn newestFirstInBatch(history: []HistoryEntry, batch: int): []HistoryEntry {
  let inBatch = []HistoryEntry(0)
  for h of history {
    if (h.batch == batch) {
      inBatch = append(inBatch, h)
    }
  }
  return sorted(inBatch, (a, b) => a.migration > b.migration)
}

fn findMigrationFile(migrations: []MigrationFile, name: string): MigrationFile! {
  for f of migrations {
    if (f.name == name) {
      return f
    }
  }
  fail newError("pkg/orm: migrate: no migration named ${name} in the registry")
}

fn renderOps(dialect: Dialect, ops: []SchemaOp): []Statement {
  let out = []Statement(0)
  for op of ops {
    for s of dialect.render(op) {
      out = append(out, s)
    }
  }
  return out
}

fn splitByTransactional(stmts: []Statement): ([]Statement, []Statement) {
  let transactional = []Statement(0)
  let nonTransactional = []Statement(0)
  for s of stmts {
    if (s.transactional) {
      transactional = append(transactional, s)
    } else {
      nonTransactional = append(nonTransactional, s)
    }
  }
  return (transactional, nonTransactional)
}
