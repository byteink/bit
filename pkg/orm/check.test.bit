// pkg/orm/check.test.bit — #5076's acceptance, against a FAKE driver
// returning a known `information_schema` shape (`ckExecutor` below,
// `generate.test.bit`'s own `gnExecutor` widened by `data_type` and keyed
// the identical way), plus one subprocess test proving the failure's exit
// code is genuinely non-zero and a live-server test proving both
// directions against a real Postgres (#5431: a test that skips when no
// server is configured has never run).
//
// `ckExecutor.columns` IS the fake live schema, one `ckCol{name, dataType}`
// per row `information_schema.columns` would return; `checkClauses` is the
// same idea for `liveEnumCheckClause`'s own `information_schema.
// check_constraints` query (#5435), keyed by `enumCheckName(table, column)`
// exactly like `generate.test.bit`'s own `gnExecutor.checkClauses`.
//
// NO IMPORTS HERE: `env`/`run` (std/os), `cwd`/`isDir`/`mkdir`/`readDir`/
// `remove`/`writeFile` (std/fs) are already imported package-wide by
// `generate.bit`/`generate.test.bit` — a second import of any of them here
// would be E0042 (this file's own `scratchDir`/`resetDir`/`findRepoRoot`
// below reuse `generate.test.bit`'s own declarations for the same reason).
class ckCol {
  name: string,
  dataType: string,
}

class ckExecutor {
  columns: map<string, []ckCol>
  checkClauses: map<string, string>

  query(sqlText: string, params: []Value): Rows! {
    let key = asText(params[0]) catch _ {
      ""
    }
    if (contains(sqlText, "check_constraints")) {
      return ckCheckRows{ clause: this.checkClauses[key], i: -1 }
    }
    return ckColRows{ cols: this.columns[key], i: -1 }
  }

  exec(sqlText: string, params: []Value): int! {
    fail newError("ckExecutor: exec not supported; check never writes or applies anything")
  }
}

class ckCheckRows {
  clause: string
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i == 0 && this.clause != ""
  }

  columns(): []string {
    return ["check_clause"]
  }

  value(col: int): Value {
    return Value.Text(this.clause)
  }

  close() {}
}

class ckColRows {
  cols: []ckCol
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.cols)
  }

  columns(): []string {
    return ["column_name", "data_type"]
  }

  value(col: int): Value {
    if (col == 0) {
      return Value.Text(this.cols[this.i].name)
    }
    return Value.Text(this.cols[this.i].dataType)
  }

  close() {}
}

@table("ck_widgets") class ckWidget {
  @id
  id: i64
  name: string
}

@table("ck_widgets") class ckWidgetPhone {
  @id
  id: i64
  name: string
  phone: string
}

@table("ck_widgets") class ckWidgetIdOnly {
  @id
  id: i64
}

@table("ck_widgets") class ckWidgetAge {
  @id
  id: i64
  age: i64
}

@table("ck_widgets") class ckWidgetStatus {
  @id
  id: i64
  @enumVariants("Draft", "Active", "Archived", "Retired")
  status: string
}

@table("ck_widgets") class ckWidgetStatusReordered {
  @id
  id: i64
  @enumVariants("Archived", "Draft", "Active")
  status: string
}

@table("ck_widgets") class ckWidget3Diff {
  @id
  id: i64
  extra: string
  age: i64
}

test "a schema matching the entity passes, writing no file and issuing no DDL" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "name", dataType: "character varying" },
      ],
    },
  }
  check(db, [ckWidget{}], ServerDialect.Postgres) catch e {
    panic("check: an agreeing schema must pass: ${e.message()}")
  }
}

test "a column present in the entity but not the database fails naming exactly that column and direction" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "name", dataType: "character varying" },
      ],
    },
  }
  let failed = false
  check(db, [ckWidgetPhone{}], ServerDialect.Postgres) catch e {
    failed = true
    assert(
      contains(e.message(), "ck_widgets.phone: in entity, not in database"),
      "missing the expected line: ${e.message()}",
    )
    assert(count(e.message(), "\n") == 1, "expected exactly one diff line: ${e.message()}")
  }
  assert(failed, "check must fail when the entity has a column the database does not")
}

test "a column present in the database but not the entity fails naming the opposite direction" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "legacy_flag", dataType: "boolean" },
      ],
    },
  }
  let failed = false
  check(db, [ckWidgetIdOnly{}], ServerDialect.Postgres) catch e {
    failed = true
    assert(
      contains(e.message(), "ck_widgets.legacy_flag: in database, not in entity"),
      "missing the expected line: ${e.message()}",
    )
    assert(count(e.message(), "\n") == 1, "expected exactly one diff line: ${e.message()}")
  }
  assert(failed, "check must fail when the database has a column the entity does not")
}

test "a differing column type is reported, not just presence" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "age", dataType: "character varying" },
      ],
    },
  }
  let failed = false
  check(db, [ckWidgetAge{}], ServerDialect.Postgres) catch e {
    failed = true
    assert(
      contains(
        e.message(),
        "ck_widgets.age: type mismatch, entity declares 'i64', database has 'character varying'",
      ),
      "missing the expected type-mismatch line: ${e.message()}",
    )
    assert(count(e.message(), "\n") == 1, "expected exactly one diff line: ${e.message()}")
  }
  assert(failed, "check must fail on a column present in both with a differing type")
}

// #5435's own case: an enum variant added in Bit is invisible to
// presence/absence alone (the column stays present with the same type) -
// this is the finding #5076's ticket names explicitly: a check built before
// #5435 would have reported agreement it never tested for.
test "an enum column whose live CHECK is missing a declared variant fails naming the enum drift" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "status", dataType: "text" },
      ],
    },
    checkClauses: map<string, string>{
      "ck_widgets_status_check": "(status = ANY (ARRAY['Draft'::text, 'Active'::text, 'Archived'::text]))",
    },
  }
  let failed = false
  check(db, [ckWidgetStatus{}], ServerDialect.Postgres) catch e {
    failed = true
    assert(
      contains(
        e.message(),
        "ck_widgets.status: enum variants differ, entity declares [Draft, Active, Archived, Retired], database has [Draft, Active, Archived]",
      ),
      "missing the expected enum-drift line: ${e.message()}",
    )
  }
  assert(failed, "check must fail when a declared enum variant is missing from the live CHECK")
}

// The negative control for the finding above: reordering variants with no
// addition or removal must never trip the check - `enumVariantsChanged`'s
// own SET semantics (`generateenum.bit`, #5435), reused here rather than
// reimplemented.
test "reordering enum variants with no additions or removals passes" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "status", dataType: "text" },
      ],
    },
    checkClauses: map<string, string>{
      "ck_widgets_status_check": "(status = ANY (ARRAY['Archived'::text, 'Draft'::text, 'Active'::text]))",
    },
  }
  check(db, [ckWidgetStatusReordered{}], ServerDialect.Postgres) catch e {
    panic("check: a pure reorder must not be reported as drift: ${e.message()}")
  }
}

// The whole point of "readable, not a schema dump": one line per
// difference, table.column.direction only - proven at three simultaneous
// differences rather than one, so a passing single-difference test above
// cannot hide a formatter that grows unboundedly with more findings.
test "a three-difference case stays under ten lines, naming every difference and nothing else" {
  let db = ckExecutor{
    columns: map<string, []ckCol>{
      "ck_widgets": [
        ckCol{ name: "id", dataType: "bigint" },
        ckCol{ name: "legacy", dataType: "boolean" },
        ckCol{ name: "age", dataType: "character varying" },
      ],
    },
  }
  let failed = false
  check(db, [ckWidget3Diff{}], ServerDialect.Postgres) catch e {
    failed = true
    let msg = e.message()
    assert(
      contains(msg, "ck_widgets.extra: in entity, not in database"),
      "missing added-column line: ${msg}",
    )
    assert(
      contains(msg, "ck_widgets.legacy: in database, not in entity"),
      "missing removed-column line: ${msg}",
    )
    assert(
      contains(
        msg,
        "ck_widgets.age: type mismatch, entity declares 'i64', database has 'character varying'",
      ),
      "missing type-mismatch line: ${msg}",
    )
    assert(
      len(split(msg, "\n")) < 10,
      "output is not under ten lines for a 3-difference case:\n${msg}",
    )
  }
  assert(failed, "check must fail when entity and database disagree in three ways at once")
}

// `scratchDir`/`resetDir`/`findRepoRoot` are `generate.test.bit`'s own —
// this file reuses them rather than redeclaring, same module (E0042).

// The mechanism proof the acceptance names explicitly: "the failure exit is
// non-zero". A fake `Data` inside the scratch program's own `main.bit`
// (never a real database - the fake driver above cannot leave this test
// file, `Data` is only an interface) lets `check(...)?` propagate a real
// failure to `main`'s own `()!` return, so this proves the PROCESS exit
// code, not just a catchable error inside `bit test`'s own process.
const nonZeroExitSource: string = "import { Rows, Value } from \"std/sql\"\nimport { FieldDesc, AttrDesc } from \"std/sql\"\nimport { check, Data, ServerDialect } from \"orm\"\n\nclass emptyRows {\n  export next(): bool! { return false }\n  export columns(): []string { return []string(0) }\n  export value(col: int): Value { return Value.Null }\n  export close() {}\n}\n\nclass noSchemaDb {\n  export query(sqlText: string, params: []Value): Rows! { return emptyRows{} }\n  export exec(sqlText: string, params: []Value): int! { fail newError(\"noSchemaDb: exec not supported\") }\n}\n\n@table(\"missing_table\") class Widget {\n  @id\n  id: i64\n  name: string\n}\n\nfn main(): ()! {\n  check(noSchemaDb{}, [Widget{}], ServerDialect.Postgres)?\n}\n"

test "check propagates a non-zero process exit code when entities and the (empty) live schema disagree" {
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let proj = scratchDir("exitcode")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"checkexit\", \"dependencies\": {\"orm\": \"${ormAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", nonZeroExitSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  // Never `selfExe()` under `bit test`/`bit run` - see `generate.test.bit`'s
  // own header for the fork-bomb this caused once already.
  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit"])
  assert(rc != 0, "check's own failure did not produce a non-zero process exit code, rc=${rc}")
  resetDir(proj)
}

// #5431/#5435: a test that skips when no server is configured has never
// run. `ORM_TEST_LIVE_PG_URI` supplies a Postgres connection string; this
// test skips only when it is unset, and says so. Proves BOTH directions
// against a real server: a matching schema passes, a missing column and an
// enum-variant drift (#5435's own rewrite of `in (...)` into `= any
// (array[...])`, which no fake driver reproduces) each fail naming what
// disagreed.
const liveCheckProofSource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value } from \"std/sql\"\nimport { contains } from \"std/strings\"\nimport { adapter } from \"postgres\"\nimport { check, ServerDialect } from \"orm\"\n\n@table(\"widgets_5076a\") class WidgetOk {\n  @id\n  id: i64\n  name: string\n  @enumVariants(\"Draft\", \"Active\", \"Archived\")\n  status: string\n}\n\n@table(\"widgets_5076b\") class WidgetMissingCol {\n  @id\n  id: i64\n  name: string\n  phone: string\n}\n\n@table(\"widgets_5076c\") class WidgetEnumDrift {\n  @id\n  id: i64\n  @enumVariants(\"Draft\", \"Active\", \"Archived\", \"Retired\")\n  status: string\n}\n\nfn main() {\n  let uri = args()[1]\n  let db = pool(adapter(), Datasource{ uri: uri }) catch e {\n    panic(\"pool: \${e.message()}\")\n  }\n\n  db.exec(\"drop table if exists widgets_5076a\", []Value(0)) catch e { panic(\"drop a: \${e.message()}\") }\n  db.exec(\"drop table if exists widgets_5076b\", []Value(0)) catch e { panic(\"drop b: \${e.message()}\") }\n  db.exec(\"drop table if exists widgets_5076c\", []Value(0)) catch e { panic(\"drop c: \${e.message()}\") }\n\n  db.exec(\n    \"create table widgets_5076a (id bigint generated always as identity primary key, name character varying(255) not null, status text not null check (status in ('Draft','Active','Archived')))\",\n    []Value(0),\n  ) catch e { panic(\"create a: \${e.message()}\") }\n\n  check(db, [WidgetOk{}], ServerDialect.Postgres) catch e {\n    panic(\"LIVE PROOF FAILED: an agreeing schema reported a disagreement: \${e.message()}\")\n  }\n\n  db.exec(\n    \"create table widgets_5076b (id bigint generated always as identity primary key, name character varying(255) not null)\",\n    []Value(0),\n  ) catch e { panic(\"create b: \${e.message()}\") }\n\n  let failed1 = false\n  check(db, [WidgetMissingCol{}], ServerDialect.Postgres) catch e {\n    failed1 = true\n    if (!contains(e.message(), \"widgets_5076b.phone: in entity, not in database\")) {\n      panic(\"LIVE PROOF FAILED: missing-column report wrong: \${e.message()}\")\n    }\n  }\n  if (!failed1) {\n    panic(\"LIVE PROOF FAILED: a missing column did not fail check\")\n  }\n\n  db.exec(\n    \"create table widgets_5076c (id bigint generated always as identity primary key, status text not null check (status in ('Draft','Active','Archived')))\",\n    []Value(0),\n  ) catch e { panic(\"create c: \${e.message()}\") }\n\n  let failed2 = false\n  check(db, [WidgetEnumDrift{}], ServerDialect.Postgres) catch e {\n    failed2 = true\n    if (!contains(e.message(), \"widgets_5076c.status: enum variants differ\")) {\n      panic(\"LIVE PROOF FAILED: enum-drift report wrong: \${e.message()}\")\n    }\n  }\n  if (!failed2) {\n    panic(\"LIVE PROOF FAILED: an enum variant drift did not fail check\")\n  }\n\n  db.exec(\"drop table widgets_5076a\", []Value(0)) catch e { panic(\"cleanup a: \${e.message()}\") }\n  db.exec(\"drop table widgets_5076b\", []Value(0)) catch e { panic(\"cleanup b: \${e.message()}\") }\n  db.exec(\"drop table widgets_5076c\", []Value(0)) catch e { panic(\"cleanup c: \${e.message()}\") }\n  db.close()\n  print(\"LIVE_PROOF_OK\")\n}\n"

test "live: an agreeing schema passes, a missing column and an enum drift each fail naming what disagreed" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let proj = scratchDir("liveproof")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof5076\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveCheckProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}
