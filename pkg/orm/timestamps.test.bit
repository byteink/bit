// pkg/orm/timestamps.test.bit — #5062's acceptance, against a fake driver.
//
// `wrAdapter`/`newWrPool`/`lastWrCall` (single-write INSERT/UPDATE) come
// from ./write.test.bit, `ptAdapter`/`newPtPool`/`lastPtCall` (the patch
// builder) from ./patch.test.bit, `field`/`fieldWithId` from
// ./naming.test.bit and ./write.test.bit respectively — all siblings in the
// same module (SPEC §17.1); a second declaration of any would be E0042.
// `Account` (./write.test.bit) is a real `@table` class with no
// `@timestamps` — reused as-is for the "no mark" case rather than adding a
// fourth.

@table @timestamps class Person {
  @id
  id: i64
  name: string
  createdAt: i64
  updatedAt: i64
}

// `@timestamps` present, but the class never declares `updatedAt` — the
// missing-field case.
@table @timestamps class Employee {
  @id
  id: i64
  name: string
  createdAt: i64
}

fn personDesc(): TableDesc {
  return TableDesc{
    table = "people",
    fields = [fieldWithId("id"), field("name"), field("createdAt"), field("updatedAt")],
  }
}

fn personValues(p: Person): map<string, Value> {
  return map<string, Value>{ "id": Value.Int(p.id), "name": Value.Text(p.name) }
}

fn employeeDesc(): TableDesc {
  return TableDesc{
    table = "employees",
    fields = [fieldWithId("id"), field("name"), field("createdAt")],
  }
}

// A fixed reading, never `now()` — see ./timestamps.bit's own header for
// why every test here passes a literal instead.
fn fixedNow(): Timestamp {
  return Timestamp{ ns = 1700000000000000000 }
}

test "INSERT sets createdAt and updatedAt to the same value, byte-identical" {
  let p = Person{ id = 0, name = "Ada", createdAt = 0, updatedAt = 0 }
  let values = personValues(p)
  let at = fixedNow()

  let desc = applyTimestamps(personDesc(), values, p.isPersisted(), p.tableAttrs(), at) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = Value.Int(at.ns)
  let (created, createdOk) = values["createdAt"]
  let (updated, updatedOk) = values["updatedAt"]
  assert(createdOk, "createdAt must be set on INSERT")
  assert(updatedOk, "updatedAt must be set on INSERT")
  assert(valueEq(created, want), "createdAt = ${valueRepr(created)}, want ${valueRepr(want)}")
  assert(valueEq(updated, want), "updatedAt = ${valueRepr(updated)}, want ${valueRepr(want)}")
  assert(valueEq(created, updated), "createdAt and updatedAt must be byte-identical on INSERT")
  assert(
    len(desc.fields) == len(personDesc().fields),
    "INSERT keeps every field, including createdAt",
  )
}

test "save() on a @timestamps entity emits INSERT naming both createdAt and updatedAt" {
  let a = wrAdapter{
    cols = ["id", "name", "created_at", "updated_at"],
    rows = [
      [
        Value.Int(1),
        Value.Text("Ada"),
        Value.Int(1700000000000000000),
        Value.Int(1700000000000000000),
      ],
    ],
    affected = 0,
  }
  let pool = newWrPool(a)
  let p = Person{ id = 0, name = "Ada", createdAt = 0, updatedAt = 0 }
  let values = personValues(p)
  let at = fixedNow()

  let desc = applyTimestamps(personDesc(), values, p.isPersisted(), p.tableAttrs(), at) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  save(pool, desc, values, p.isPersisted()) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = "insert into people (id, name, created_at, updated_at) values ($1, $2, $3, $4) returning *"
  assert(lastWrCall(a).sql == want, "got: ${lastWrCall(a).sql}")
}

test "save() on a persisted @timestamps entity emits UPDATE with updatedAt but never createdAt" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 1 }
  let pool = newWrPool(a)
  let p = Person{
    id = 7,
    name = "Ada",
    createdAt = 1600000000000000000,
    updatedAt = 1600000000000000000,
  }
  p.markPersisted(true)
  let values = personValues(p)
  let at = fixedNow()

  let desc = applyTimestamps(personDesc(), values, p.isPersisted(), p.tableAttrs(), at) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  save(pool, desc, values, p.isPersisted()) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastWrCall(a).sql
  let want = "update people set id = $1, name = $2, updated_at = $3 where id = $4"
  assert(sql == want, "got: ${sql}")
  assert(!contains(sql, "created_at"), "an UPDATE must never name createdAt: ${sql}")
  let (_, createdOk) = values["createdAt"]
  assert(!createdOk, "an UPDATE must not write createdAt into values either")
}

test "a table without @timestamps has neither column written" {
  let u = Account{ id = 0, name = "Ada", email = "ada@x.com" }
  let values = map<string, Value>{
    "id": Value.Int(u.id),
    "name": Value.Text(u.name),
    "email": Value.Text(u.email),
  }
  let desc = accountDesc()
  let at = fixedNow()

  let out = applyTimestamps(desc, values, u.isPersisted(), u.tableAttrs(), at) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let (_, createdOk) = values["createdAt"]
  let (_, updatedOk) = values["updatedAt"]
  assert(!createdOk, "no @timestamps mark means no createdAt")
  assert(!updatedOk, "no @timestamps mark means no updatedAt")
  assert(len(out.fields) == len(desc.fields), "the TableDesc must pass through unchanged")
}

test "a @timestamps class missing updatedAt is rejected naming that field" {
  let e = Employee{ id = 0, name = "Bob", createdAt = 0 }
  let values = map<string, Value>{ "id": Value.Int(e.id), "name": Value.Text(e.name) }
  let at = fixedNow()

  applyTimestamps(employeeDesc(), values, e.isPersisted(), e.tableAttrs(), at) catch err {
    assert(
        err.message() ==
        "pkg/orm: the class mapped to 'employees' carries '@timestamps' but declares no 'updatedAt' field",
      "got: ${err.message()}",
    )
    return
  }
  assert(false, "a class missing updatedAt must be rejected")
}

test "a patch-builder run on a @timestamps table includes updatedAt in its SET list" {
  let a = ptAdapter{ calls = []ptCall(0), affected = 1 }
  let pool = newPtPool(a)
  let fields = [fieldWithId("id"), field("name"), field("createdAt"), field("updatedAt")]
  let at = fixedNow()

  let p = update<Person>(pool, "people", fields).where("id", Value.Int(1)).set(
    "name",
    Value.Text("Bea"),
  )
  withUpdatedAt(p, [AttrDesc{ name = "timestamps", args = []string(0) }], at).run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastPtCall(a).sql
  assert(contains(sql, "updated_at = $3"), "updatedAt must be in the SET list: ${sql}")
}
