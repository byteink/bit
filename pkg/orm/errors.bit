// pkg/orm/errors.bit — turning a driver error into a typed constraint cause
// (#5071), so "email already registered" is a `catch`able type instead of a
// substring search in the driver's English.
//
// SQLSTATE, NEVER MESSAGE TEXT. `classify` below decides the type from
// `sqlState()` alone — the five-character code both `pkg/postgres`'s
// `pgError` and `pkg/mysql`'s `myError` already carry (see either package's
// own `query.bit` header) and which is standardised across engines, unlike
// a message that changes with the server's version and locale. `state` is
// the one thing this file trusts; nothing here calls `contains` or
// `split` on a driver's `message()`.
//
// A SEPARATE HIERARCHY FROM `WriteCause` (write.bit, #5058), ON PURPOSE.
// `WriteCause.NoRowsAffected` answers a different question — the statement
// SUCCEEDED and the application-level row count was wrong — from a
// constraint violation, where the statement itself was REJECTED by the
// server before any row count exists. Folding `UniqueViolation` into
// `WriteError{ cause, table, key }` would force every violation through a
// `key: Value` field that answers "which row's UPDATE matched nothing",
// meaningless for a rejected INSERT, and would need one shared class to
// carry `constraint`/`columns`/`column`/`referencedTable` for causes that
// don't all use them. Two questions, two files answering them, is not the
// duplicate hierarchy the ticket warns about — a single `WriteCause` trying
// to answer both would be the special case.
//
// THE DETAIL FIELDS ARE A HOOK, NOT A PROMISE FROM TODAY'S TWO DRIVERS.
// `sqlState()` is all `pgError`/`myError` expose today, so `classify`
// always gets the CAUSE right but leaves `constraint`/`column`/
// `referencedTable` empty unless the error ALSO satisfies `causeDetail`
// below — structurally, the same opt-in `pkg/web/errors.bit`'s `HttpError`
// uses. Postgres's wire protocol carries a Table/Constraint/Column field on
// every `ErrorResponse` (`t`/`n`/`c`) that `pgError` does not parse yet;
// teaching it to, or teaching a future `Dialect` (`pkg/orm/schema.bit`
// header, #5066/#5070) to do it per engine, satisfies `causeDetail` without
// this file changing at all.
//
// NO `status()` ON ANY OF THESE SIX TYPES, AND NONE IS BUILT FROM A DRIVER'S
// `message()` OR ITS CONFLICTING VALUE. `pkg/web/errors.bit`'s rule is that
// an error opts into reaching a client body by writing `status()` — these
// types never do, so `e.(HttpError)` (that package's own interface) never
// matches one, the same way a bare `SqlRowError` (`stdlib/sql/row.bit`)
// does not. Every `message()` below is built from schema names this
// package's caller already owns (`table`, a constraint or column name),
// never from `err.message()`.
//
// `DeadlockDetected`/`SerializationFailure` CARRY `retryable(): bool` next
// to every other cause so a caller can ask the same question of any of the
// six without a type switch first — `false` is not "this type forgot it",
// it is the answer.

// The shape a driver error already offers today: `pkg/postgres`'s
// `pgError` and `pkg/mysql`'s `myError` both implement `sqlState()`
// exactly this way (their own `query.bit` files document it), so this
// asks for the shape rather than importing either driver package — the
// same "ask for the shape" pattern their own header comments show.
interface sqlStateError {
  message(): string,
  sqlState(): string,
}

// The optional richer shape a dialect-aware driver MAY also offer — see
// this file's header for why today's two drivers do not yet. `column`
// covers both `NotNullViolation`'s and `ForeignKeyViolation`'s single
// column; `UniqueViolation.columns` below is built from it as a
// zero-or-one-element list until a driver reports a real composite list.
interface causeDetail {
  message(): string,
  constraint(): string,
  column(): string,
  referencedTable(): string,
}

// SQLSTATE codes this file classifies. Constants, not literals scattered
// through `classify`, so a code and its meaning are named once each.
const stateUniqueViolation: string = "23505"
const stateForeignKeyViolation: string = "23503"
const stateNotNullViolation: string = "23502"
const stateCheckViolation: string = "23514"
const stateDeadlockDetected: string = "40P01"
const stateSerializationFailure: string = "40001"

// A unique-constraint violation — `email` already taken, most commonly.
// `columns` is the constraint's columns when a driver's `causeDetail`
// reports them, one element or empty otherwise (this file's header).
export class UniqueViolation {
  export table: string
  export constraint: string
  export columns: []string

  export message(): string {
    return "pkg/orm: unique constraint '${this.constraint}' on '${this.table}' violated"
  }

  export retryable(): bool {
    return false
  }
}

// A foreign-key constraint violation — the referenced row does not exist,
// or a referenced row a live foreign key still points to was removed.
export class ForeignKeyViolation {
  export table: string
  export constraint: string
  export column: string
  export referencedTable: string

  export message(): string {
    return "pkg/orm: foreign key constraint '${this.constraint}' on '${this.table}.${this.column}' violated"
  }

  export retryable(): bool {
    return false
  }
}

// A NOT NULL column received no value.
export class NotNullViolation {
  export table: string
  export column: string

  export message(): string {
    return "pkg/orm: '${this.column}' on '${this.table}' may not be null"
  }

  export retryable(): bool {
    return false
  }
}

// A CHECK constraint rejected the row.
export class CheckViolation {
  export table: string
  export constraint: string

  export message(): string {
    return "pkg/orm: check constraint '${this.constraint}' on '${this.table}' violated"
  }

  export retryable(): bool {
    return false
  }
}

// The server killed one transaction of a deadlock to break it — transient,
// not a logic error. `retryable()` is `true`; this file builds no retry
// loop on top of it (the ticket's own constraint).
export class DeadlockDetected {
  export message(): string {
    return "pkg/orm: deadlock detected"
  }

  export retryable(): bool {
    return true
  }
}

// A serializable transaction could not be placed in any serial order —
// transient, the same as `DeadlockDetected`.
export class SerializationFailure {
  export message(): string {
    return "pkg/orm: serialization failure"
  }

  export retryable(): bool {
    return true
  }
}

// The empty-or-one-element column list `UniqueViolation.columns` builds
// from `causeDetail.column()` — see this file's header for why a single
// name is all today's drivers can supply.
fn columnList(name: string): []string {
  if (name == "") {
    return []string(0)
  }
  return [name]
}

// The detail fields `causeDetail` supplies when `err` satisfies it, or
// three empty strings when it doesn't — `classify`'s callers never branch
// on which case happened, they just get the field or `""`.
fn detailOf(err: error): (string, string, string) {
  let (d, ok) = err.(causeDetail)
  if (!ok) {
    return ("", "", "")
  }
  return (d.constraint(), d.column(), d.referencedTable())
}

// The typed cause for `err`, or `err` itself unchanged — never classify by
// matching `err.message()`; an error that isn't `sqlStateError`-shaped, or
// whose `sqlState()` this file doesn't recognise, passes through exactly
// as it arrived, so a caller that already handles the raw error keeps
// working. `table` is the caller's own knowledge — the same `desc.table`
// every write in `write.bit` already carries — since neither driver's
// error names the table on the wire today.
export fn classify(err: error, table: string): error {
  let (se, ok) = err.(sqlStateError)
  if (!ok) {
    return err
  }
  let state = se.sqlState()
  let (constraint, column, referencedTable) = detailOf(err)
  if (state == stateUniqueViolation) {
    return UniqueViolation{ table = table, constraint = constraint, columns = columnList(column) }
  }
  if (state == stateForeignKeyViolation) {
    return ForeignKeyViolation{
      table = table,
      constraint = constraint,
      column = column,
      referencedTable = referencedTable,
    }
  }
  if (state == stateNotNullViolation) {
    return NotNullViolation{ table = table, column = column }
  }
  if (state == stateCheckViolation) {
    return CheckViolation{ table = table, constraint = constraint }
  }
  if (state == stateDeadlockDetected) {
    return DeadlockDetected{}
  }
  if (state == stateSerializationFailure) {
    return SerializationFailure{}
  }
  return err
}
