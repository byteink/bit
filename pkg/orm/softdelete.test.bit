// pkg/orm/softdelete.test.bit — #5063's acceptance, against a fake driver.
//
// `sdAdapter`/`sdConn` are the same shape `pkg/orm/write.test.bit`'s own
// `wrAdapter`/`wrConn` are: `query` records the statement and hands back
// one canned row set, `exec` records the statement and hands back one
// canned affected-row count — enough to drive `delete`/`restore`/
// `forceDelete` and `findScoped`/`updateScoped`/`deleteManyScoped` through
// a fake connection.
//
// `pool`/`Pool`/`Datasource`/`Conn`/`Rows`/`Stmt`/`Tx`/`Value`/`Isolation`
// are imported by ./data.test.bit, `contains` by ./query.test.bit, `field`
// by ./naming.test.bit — all this module's own siblings (SPEC §17.1), so
// re-importing any of them here would be E0042.

class Ticket { id: i64 }

fn ticketMapper(rows: Rows): Ticket! {
  return Ticket{ id: sqlReqInt(rows, rows.columns(), "id")? }
}

// `deletedAt` is present so `ticketDesc(true, ...)` below is a valid
// `@softDelete` class; `deletedAtField`/`fieldsMissingDeletedAt` build the
// "declared the mark without the field" shape the rejection test needs.
fn ticketFields(): []FieldDesc {
  return [fieldWithId("id"), field("subject"), field("deletedAt")]
}

fn fieldsMissingDeletedAt(): []FieldDesc {
  return [fieldWithId("id"), field("subject")]
}

fn softAttrs(): []AttrDesc {
  return [AttrDesc{ name: "softDelete", args: []string(0) }]
}

fn noAttrs(): []AttrDesc {
  return []AttrDesc(0)
}

fn ticketDesc(soft: bool, fields: []FieldDesc): TableDesc {
  let attrs = noAttrs()
  if (soft) {
    attrs = softAttrs()
  }
  return TableDesc{ table: "tickets", fields: fields, classAttrs: attrs }
}

fn ticketValues(id: i64): map<string, Value> {
  return map<string, Value>{ "id": Value.Int(id) }
}

class sdCall { sql: string, args: []Value }

class sdRows {
  cols: []string
  data: [][]Value
  i: int

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

// The fake database: every `query`/`exec` call, in order, plus one canned
// row set and one canned affected-row count a test wants back.
class sdAdapter {
  calls: []sdCall
  cols: []string
  rows: [][]Value
  affected: int

  connect(cfg: Datasource): Conn! {
    return sdConn{ a: this }
  }
}

class sdConn {
  a: sdAdapter

  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, sdCall{ sql: sqlText, args: params })
    return sdRows{ cols: this.a.cols, data: this.a.rows, i: -1 }
  }

  exec(sqlText: string, params: []Value): int! {
    this.a.calls = append(this.a.calls, sdCall{ sql: sqlText, args: params })
    return this.a.affected
  }

  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }

  begin(): Tx! {
    fail newError("fake: begin not supported")
  }

  close() {}
}

fn newSdPool(cols: []string, rows: [][]Value, affected: int): (Pool, sdAdapter) {
  let a = sdAdapter{ calls: []sdCall(0), cols: cols, rows: rows, affected: affected }
  let p = pool(a, Datasource{ host: "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return (p, a)
}

fn lastSdCall(a: sdAdapter): sdCall {
  return a.calls[len(a.calls) - 1]
}

// --- delete()/restore()/forceDelete() -----------------------------------

test "delete on a @softDelete entity emits UPDATE setting deleted_at, never a DELETE" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 1)

  delete(p, ticketDesc(true, ticketFields()), ticketValues(9)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastSdCall(a).sql
  assert(sql == "update tickets set deleted_at = now() where id = $1", "got: ${sql}")
  assert(!contains(sql, "delete from"), "must not be a DELETE: ${sql}")
}

// The other direction: a table without `@softDelete` must never gain the
// filter or lose its real DELETE — the ticket's own constraint.
test "delete on a plain table (no @softDelete) still emits a real DELETE" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 1)

  delete(p, ticketDesc(false, ticketFields()), ticketValues(9)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(lastSdCall(a).sql == "delete from tickets where id = $1", "got: ${lastSdCall(a).sql}")
}

test "restore emits SET deleted_at = NULL by primary key" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 1)

  restore(p, ticketDesc(true, ticketFields()), ticketValues(9)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(
    lastSdCall(a).sql == "update tickets set deleted_at = null where id = $1",
    "got: ${lastSdCall(a).sql}",
  )
}

test "forceDelete emits a real DELETE even on a @softDelete table" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 1)

  forceDelete(p, ticketDesc(true, ticketFields()), ticketValues(9)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(lastSdCall(a).sql == "delete from tickets where id = $1", "got: ${lastSdCall(a).sql}")
}

// A @softDelete class with no declared `deletedAt` is rejected, naming the
// field — the ticket's own words: "the mark without it is an error naming
// the field," never a silent no-op.
test "a @softDelete class lacking deletedAt is rejected naming that field" {
  let (p, _) = newSdPool([]string(0), [][]Value(0), 1)

  delete(p, ticketDesc(true, fieldsMissingDeletedAt()), ticketValues(9)) catch e {
    let (se, ok) = e.(SoftDeleteError)
    assert(ok, "must be a SoftDeleteError, got '${e.message()}'")
    assert(se.cause == SoftDeleteCause.MissingDeletedAtField, "cause must be MissingDeletedAtField")
    assert(contains(e.message(), "deletedAt"), "must name the field: ${e.message()}")
    return
  }
  assert(false, "a @softDelete class with no deletedAt field must be rejected")
}

// --- findScoped<T> --------------------------------------------------------

test "all/one/oneOrFail/count/exists each add 'deleted_at is null' by default" {
  let (allP, a1) = newSdPool(["id"], [[Value.Int(1)]], 0)
  let allQ = findScoped<Ticket>(allP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  allQ.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(contains(lastSdCall(a1).sql, "deleted_at is null"), "all(): got ${lastSdCall(a1).sql}")

  let (oneP, a2) = newSdPool(["id"], [[Value.Int(1)]], 0)
  let oneQ = findScoped<Ticket>(oneP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  oneQ.one() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(contains(lastSdCall(a2).sql, "deleted_at is null"), "one(): got ${lastSdCall(a2).sql}")

  let (oofP, a3) = newSdPool(["id"], [[Value.Int(1)]], 0)
  let oofQ = findScoped<Ticket>(oofP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  oofQ.oneOrFail() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    contains(lastSdCall(a3).sql, "deleted_at is null"),
    "oneOrFail(): got ${lastSdCall(a3).sql}",
  )

  let (cntP, a4) = newSdPool(["n"], [[Value.Int(0)]], 0)
  let cntQ = findScoped<Ticket>(cntP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  cntQ.count() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(contains(lastSdCall(a4).sql, "deleted_at is null"), "count(): got ${lastSdCall(a4).sql}")

  let (exP, a5) = newSdPool([]string(0), [][]Value(0), 0)
  let exQ = findScoped<Ticket>(exP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  exQ.exists() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(contains(lastSdCall(a5).sql, "deleted_at is null"), "exists(): got ${lastSdCall(a5).sql}")
}

test "withTrashed() removes the filter and onlyTrashed() inverts it to NOT NULL" {
  let (wtP, wtA) = newSdPool([]string(0), [][]Value(0), 0)
  let wt = findScoped<Ticket>(wtP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  wt.withTrashed().all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let wtSql = lastSdCall(wtA).sql
  assert(wtSql == "select * from tickets", "withTrashed(): got ${wtSql}")

  let (otP, otA) = newSdPool([]string(0), [][]Value(0), 0)
  let ot = findScoped<Ticket>(otP, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  ot.onlyTrashed().all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let otSql = lastSdCall(otA).sql
  assert(
    otSql == "select * from tickets where deleted_at is not null",
    "onlyTrashed(): got ${otSql}",
  )
}

// A plain @table with no @softDelete gets no filter at all — the other
// silent-failure direction the ticket names as equally dangerous.
test "findScoped on a plain table (no @softDelete) adds no filter" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 0)
  let sq = findScoped<Ticket>(p, "tickets", ticketFields(), noAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(lastSdCall(a).sql == "select * from tickets", "got: ${lastSdCall(a).sql}")
}

// The caller's own `where` composes with the automatic exclusion.
test "a caller's own where still applies, ANDed with the automatic exclusion" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 0)
  let sq = findScoped<Ticket>(p, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.where("subject", Value.Text("billing")).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from tickets where subject = $1 and deleted_at is null"
  assert(lastSdCall(a).sql == want, "got: ${lastSdCall(a).sql}")
}

// The dangerous composition case: `Query<T>` has no `OR` keyword yet
// (`pkg/orm/query.bit`'s own header), so `whereIn` — semantically an OR of
// equalities, spelled as `IN (...)` — is the compound, already-parenthesized
// predicate this package can actually build. This proves the automatic
// filter ANDs onto the END of that clause without corrupting its own
// parens, exactly the failure mode a naive string-concatenated exclusion
// would risk (this file's own header).
test "a caller's own compound where (whereIn) composes correctly with the automatic exclusion" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 0)
  let sq = findScoped<Ticket>(p, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.whereIn("subject", [Value.Text("a"), Value.Text("b")]).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from tickets where subject in ($1, $2) and deleted_at is null"
  assert(lastSdCall(a).sql == want, "got: ${lastSdCall(a).sql}")
}

// --- updateScoped<T> / deleteManyScoped<T> --------------------------------

test "updateScoped's Patch adds the same default exclusion a bulk UPDATE must respect" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 3)
  let patch = updateScoped<Ticket>(p, "tickets", ticketFields(), softAttrs()) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  patch.set("subject", Value.Text("closed")).all().run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    contains(lastSdCall(a).sql, "where deleted_at is null"),
    "got: ${lastSdCall(a).sql}",
  )
}

test "deleteManyScoped on a @softDelete table emits UPDATE, never a real DELETE, consistent with delete()" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 2)
  let dm = deleteManyScoped<Ticket>(p, "tickets", ticketFields(), softAttrs()) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  dm.all().run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let sql = lastSdCall(a).sql
  // `deleteManyScoped` pre-applies the same default exclusion `findScoped`
  // does — `.all()` only overrides the bare-call refusal, never that
  // filter, so a bulk soft-delete stays idempotent against a row already
  // trashed.
  assert(sql == "update tickets set deleted_at = now() where deleted_at is null", "got: ${sql}")
  assert(!contains(sql, "delete from"), "must not be a DELETE: ${sql}")
}

test "deleteManyScoped on a plain table (no @softDelete) still emits a real DELETE" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 2)
  let dm = deleteManyScoped<Ticket>(p, "tickets", ticketFields(), noAttrs()) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  dm.where("id", Value.Int(1)).run() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(lastSdCall(a).sql == "delete from tickets where id = $1", "got: ${lastSdCall(a).sql}")
}

// --- the real `@table @softDelete class` syntax, end to end ---------------

// Every test above builds `classAttrs`/`fields` by hand (`softAttrs()`,
// `ticketFields()`) to isolate this file's own logic from the compiler's
// synthesis. This one instead declares a REAL `@softDelete` class and reads
// `tableAttrs()`/`tableDescriptor()` straight off it, proving the compiler
// actually records `@softDelete` into the synthesized descriptor
// (`compiler/classtabledesc.bit`'s `tableClassOwnAttrs`) the way every test
// above assumes it does.
@table @softDelete class Comment {
  @id
  id: i64
  body: string
  deletedAt: Option<i64>
}

fn commentMapper(rows: Rows): Comment! {
  return Comment{ id: sqlReqInt(rows, rows.columns(), "id")?, body: "", deletedAt: Option.None }
}

test "a real @table @softDelete class synthesizes a classAttrs the compiler, not this file, builds" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 0)
  let c = Comment{ id: 0, body: "", deletedAt: Option.None }
  let sq = findScoped<Comment>(
    p, "comments", c.tableDescriptor(), c.tableAttrs(), commentMapper,
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    lastSdCall(a).sql == "select * from comments where deleted_at is null",
    "got: ${lastSdCall(a).sql}",
  )
}

// --- keyset pagination (#5072) composes with the exclusion -----------------

test "after() composes with the automatic exclusion, keyset predicate and deleted_at both ANDed" {
  let (p, a) = newSdPool([]string(0), [][]Value(0), 0)
  let sq = findScoped<Ticket>(p, "tickets", ticketFields(), softAttrs(), ticketMapper) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.orderBy("id", Dir.Asc)
  sq.after(Value.Int(5)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from tickets where id > $1 and deleted_at is null order by id asc"
  assert(lastSdCall(a).sql == want, "got: ${lastSdCall(a).sql}")
}

// --- with()'s child query (#5061), wired now that it has landed -----------

@table @softDelete class SdParent {
  @id
  id: i64
  deletedAt: Option<i64>
  @hasMany("parentId")
  children: []SdChild
}

@table @softDelete class SdChild {
  @id
  id: i64
  parentId: i64
  deletedAt: Option<i64>
}

// `children` is left OMITTED on purpose, same as `relation.test.bit`'s own
// `relPersonMapper` leaves `posts` omitted — a `[]T` relation field on a
// `@table` class is filled with #5271's reserved sentinel, overwritten by
// the relation loader's own `assign`.
fn sdParentMapper(rows: Rows): SdParent! {
  return SdParent{ id: sqlReqInt(rows, rows.columns(), "id")?, deletedAt: Option.None }
}

fn sdChildMapper(rows: Rows): SdChild! {
  let cols = rows.columns()
  return SdChild{
    id: sqlReqInt(rows, cols, "id")?, parentId: sqlReqInt(rows, cols, "parent_id")?,
    deletedAt: Option.None,
  }
}

fn sdChildFields(): []FieldDesc {
  return SdChild{ id: 0, parentId: 0, deletedAt: Option.None }.tableDescriptor()
}

fn sdChildAttrs(): []AttrDesc {
  return SdChild{ id: 0, parentId: 0, deletedAt: Option.None }.tableAttrs()
}

// The per-entity loader wrapper `pkg/orm/relation.bit`'s own header
// documents (`postsLoader()`-shaped) — the ONE place this schema chooses
// `findScopedQuery<SdChild>` over a plain `find<SdChild>` because the CHILD
// table is `@softDelete`. Nothing in `relation.bit` changed for this.
fn sdChildrenLoader(): RelationLoader<SdParent> {
  return hasMany<SdParent, SdChild>(
    (p) => p.id,
    (db) => findScopedQuery<SdChild>(
      db,
      "sd_children",
      sdChildFields(),
      sdChildAttrs(),
      sdChildMapper,
    ),
    "parentId",
    (c) => c.parentId,
    (p, cs) => {
      p.children = cs
    },
  )
}

// The soft-delete-aware entry point PLUS relation registration — `sq.inner`
// is `SoftQuery<T>`'s own module-private field (SPEC §17.1: this file is in
// the same module), so `withRelations` (relation.bit, taking a plain
// `Query<T>`) attaches straight onto it exactly the way a non-soft-delete
// entity's own wrapper already does in `relation.test.bit`'s `relPeople`.
fn sdParents(db: Data): SoftQuery<SdParent>! {
  let sq = findScoped<SdParent>(
    db, "sd_parents", SdParent{ id: 0, deletedAt: Option.None }.tableDescriptor(),
    SdParent{ id: 0, deletedAt: Option.None }.tableAttrs(), sdParentMapper,
  )?
  sq.inner = withRelations(
    sq.inner, map<string, RelationLoader<SdParent>>{ "children": sdChildrenLoader() },
  )
  return sq
}

// The ticket's own original acceptance criterion, unreachable until #5061
// landed on this branch's rebase: `with("children")` on a `@softDelete`
// child table must ALSO carry `deleted_at is null` on the child statement -
// the classic "a soft-deleted row reappears under the parent's own
// relation" bug this whole feature exists to close. Reuses
// `relation.test.bit`'s own `relAdapter`/`relResult`/`newRelPool` (this
// module's own siblings) — a fake driver that hands back one canned result
// SET PER STATEMENT, required to tell the parent statement from the child
// one.
test "with() on a @softDelete child relation excludes a trashed child row too" {
  let a = relAdapter{
    calls: []relCall(0),
    results: [
      relResult{ cols: ["id"], rows: [[Value.Int(1)]] },
      relResult{ cols: ["id", "parent_id"], rows: [][]Value(0) },
    ],
  }
  let p = newRelPool(a)

  let sq = sdParents(p) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  sq.with("children").all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 2, "want a parent statement and a child statement, got ${len(a.calls)}")
  assert(
    contains(a.calls[0].sql, "deleted_at is null"),
    "the parent statement must exclude trashed rows: ${a.calls[0].sql}",
  )
  assert(
    contains(a.calls[1].sql, "deleted_at is null"),
    "the child statement (via with()) must exclude trashed rows too: ${a.calls[1].sql}",
  )
}
