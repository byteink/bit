// pkg/orm/relationload.bit — generic, reflection-free relation loading for
// the compiler-synthesized `__loadRelation`/`__linkRelation` (#6277,
// compiler/classtablerelation.bit, epic #6261, `.claude/kb/data-packages-dx.md`
// "Approved 2026-09-29"). Bit has no reflection — no way to read or write a
// NAMED field of a generic type parameter `T` (`pkg/orm/relation.bit`'s own
// header states the identical limitation) — but every function below is
// generic over `T: Tabled` and touches only what `Tabled` already gives
// generically: `T.__tableName()`/`T.__fromRow()`/`T.__columns()`/
// `r.__values()`. Reading a "named" column through `__columns()`/
// `__values()`'s own parallel pairing is not reflection, it is the exact
// mechanism `Tabled` exists to provide — the same one `pkg/orm/repo.bit`'s
// own `columnsForValues`/`insert`/`update` already read/write a named
// column through. The compiler only ever supplies what genuinely differs
// PER CONCRETE relation field (which of the class's OWN fields to read a
// key from, which to assign a result to) — both direct field accesses on
// the concrete class the method is synthesized on, never through a type
// parameter.
//
// ONE QUERY PER RELATION, CHUNKED. `loadRelationTargets` mirrors
// `pkg/orm/relation.bit`'s own `fetchByForeignKey` chunking
// (`relationLoadChunk` = the same 1000-row bound `maxRelationChunk` uses)
// rather than importing it: `relation.bit`'s version is typed over the
// retired `Query<T>` chain (`childQuery: (Data) => Query<TChild>`), which
// `Repo<T>`/`Tabled` do not have.
//
// `Data`/`Value`/`FieldDesc`, `columnName` (naming.bit), `hasIdAttr`
// (write.bit), `concat` (already imported by `relation.bit`, this
// package's own sibling), `LinkOp` (linkop.bit), `ManyToManyDesc`/`attach`/
// `detach` (manytomany.bit) are all in scope without a local import — one
// here would be E0042 (SPEC §17.1).

const relationLoadChunk: int = 1000

// A dotted `.with("author.posts")` path may nest at most this many levels
// (#6318) — `pkg/orm/reporelations.bit`'s own `repoWith` asserts it ONCE,
// before the path is queued, which bounds every recursive
// `dispatchLoadRelation`/`RelationLoader` call this same string reaches
// afterward (each strips at least one segment, so the recursion depth can
// never exceed the segment count checked here) without re-checking at each
// level. Real schemas bottom out in 2-3 hops; this exists only so a
// pathological or cyclic one (`"author.posts.author.posts..."`) cannot
// recurse without limit.
const relationMaxPathDepth = 8

// `path`'s own leading segment and everything after its first `.` — `""`
// for the trailing (or only) segment. `dispatchLoadRelation` peels one
// segment off per level; a `RelationLoader` that finds `rest` non-empty
// recurses into its own `TChild`/`TParent`'s `__loadRelation` with it,
// peeling the NEXT segment off in turn (`relation.bit`'s own header) — so
// nesting to any depth needs no mechanism beyond this one split, called
// once per level.
fn relationSplitPath(path: string): (string, string) {
  let i = 0
  while (i < len(path)) {
    if (path[i] == '.') {
      return (path[0:i], path[i + 1:len(path)])
    }
    i = i + 1
  }
  return (path, "")
}

// The number of dot-separated segments in `path` — `repoWith`'s own bound
// (#6318's own header, above).
fn relationPathDepth(path: string): int {
  let n = 1
  let i = 0
  while (i < len(path)) {
    if (path[i] == '.') {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// One query per `relationLoadChunk`-sized chunk of `ids`, against `TChild`'s
// own table, filtered by `TChild`'s Bit field named `keyField` (resolved to
// its SQL column through `columnName`, never assumed to equal the Bit
// name), decoded through `TChild.__fromRow`.
export fn loadRelationTargets<TChild: Tabled>(db: Data, keyField: string, ids: []i64): []TChild! {
  let column = relationColumnName<TChild>(keyField)?
  let out = []TChild(0)
  let i = 0
  while (i < len(ids)) {
    let end = i + relationLoadChunk
    if (end > len(ids)) {
      end = len(ids)
    }
    let got = loadRelationChunk<TChild>(db, column, ids[i:end])?
    out = concat(out, got)
    i = end
  }
  return out
}

fn loadRelationChunk<TChild: Tabled>(db: Data, column: string, ids: []i64): []TChild! {
  let marks = []string(0)
  let args = []Value(0)
  for id of ids {
    args = append(args, Value.Int(id))
    marks = append(marks, "$${len(args)}")
  }
  let sqlText = "select * from ${TChild.__tableName()} where ${column} in (${join(marks, ", ")})"
  let rows = db.query(sqlText, args)?
  defer rows.close()
  let out = []TChild(0)
  while (rows.next()?) {
    out = append(out, TChild.__fromRow(rows)?)
  }
  return out
}

// `rows` grouped by the i64 value of the Bit field named `keyField`, read
// generically off `T.__columns()`/`r.__values()`'s own parallel pairing —
// never a per-field access. A key that never appears reads as the map's
// zero value (an empty slice), the same "loaded-empty" shape
// `pkg/orm/manytomany.bit`'s own `groupManyToMany` relies on.
export fn groupRelationRows<T: Tabled>(rows: []T, keyField: string): map<i64, []T>! {
  let out = map<i64, []T>(0)
  for r of rows {
    let v = relationFieldInt<T>(r, keyField)?
    let (existing, ok) = out[v]
    if (ok) {
      out[v] = append(existing, r)
    } else {
      out[v] = [r]
    }
  }
  return out
}

// The Bit FIELD name of `T`'s single `@id` field — the belongsTo direction's
// own target key, read generically the same way `pkg/orm/repo.bit`'s
// `singleKeyColumn` reads it for `find`/`update`/`delete`, but returning
// the Bit name (for `groupRelationRows`/`loadRelationTargets`, both keyed by
// Bit name) rather than the SQL column.
export fn relationIdField<T: Tabled>(): string! {
  for f of T.__columns() {
    if (hasIdAttr(f)) {
      return f.name
    }
  }
  fail newError("orm: '${T.__tableName()}' has no single '@id' field to load a relation by")
}

// The SQL COLUMN of `T`'s single `@id` field — `ManyToManyDesc`'s own
// `ownerIdColumn`/`targetIdColumn` need the real column, not the Bit name.
export fn relationIdColumn<T: Tabled>(): string! {
  for f of T.__columns() {
    if (hasIdAttr(f)) {
      return columnName(f)
    }
  }
  fail newError("orm: '${T.__tableName()}' has no single '@id' field to link a relation by")
}

fn relationColumnName<T: Tabled>(fieldName: string): string! {
  for f of T.__columns() {
    if (f.name == fieldName) {
      return columnName(f)
    }
  }
  fail newError("orm: '${fieldName}' is not a mapped column of '${T.__tableName()}'")
}

fn relationFieldInt<T: Tabled>(r: T, fieldName: string): i64! {
  let cols = T.__columns()
  let vals = r.__values()
  let i = 0
  while (i < len(cols)) {
    if (cols[i].name == fieldName) {
      match (vals[i]) {
        Int(n) => return n
        _ => fail newError("orm: '${fieldName}' on '${T.__tableName()}' is not an integer column")
      }
    }
    i = i + 1
  }
  fail newError("orm: '${fieldName}' is not a mapped column of '${T.__tableName()}'")
}

// ---- the three RelationLoader constructors --------------------------------
//
// Each takes only the tiny per-field closures that genuinely differ between
// two relation fields (`pkg/orm/relation.bit`'s own retired `hasMany`/
// `hasOne`/`belongsTo` took the identical three-closure shape, for the
// identical reason) — `compiler/classtablerelation.bit` builds ONE call to
// one of these per `@hasMany`/`@hasOne`/`@belongsTo` field, so nothing here
// or in the synthesized caller ever loops over `T`'s fields generically.

// The `hasMany` side: `TParent`'s relation field is `[]TChild`. `rest`
// (#6318) is the dotted path past THIS relation's own segment — non-empty
// only when a caller wrote `.with("thisField.more")` — recursed on the
// FLAT, already-loaded `children` (every `TChild` row this level fetched,
// across every parent), so the further load is still one batched query,
// never one per parent.
export fn hasManyRelation<TParent: Tabled, TChild: Tabled>(
  parentKeyOf: (TParent) => i64,
  childForeignKey: string,
  assign: (TParent, []TChild) => (),
): RelationLoader<TParent> {
  let loader: RelationLoader<TParent> = (db, parents, rest) => {
    if (len(parents) == 0) {
      return
    }
    let ids = []i64(0)
    for p of parents {
      ids = append(ids, parentKeyOf(p))
    }
    let children = loadRelationTargets<TChild>(db, childForeignKey, ids)?
    let grouped = groupRelationRows<TChild>(children, childForeignKey)?
    for p of parents {
      assign(p, grouped[parentKeyOf(p)])
    }
    if (rest != "") {
      TChild.__loadRelation(db, rest, children)?
    }
  }
  return loader
}

// The `hasOne` side: `TParent`'s relation field is a single `TChild`. `rest`
// (#6318): see `hasManyRelation`'s own header — identical shape, recursed on
// the same flat `children` list this level already fetched.
export fn hasOneRelation<TParent: Tabled, TChild: Tabled>(
  parentKeyOf: (TParent) => i64,
  childForeignKey: string,
  assign: (TParent, TChild) => (),
): RelationLoader<TParent> {
  let loader: RelationLoader<TParent> = (db, parents, rest) => {
    if (len(parents) == 0) {
      return
    }
    let ids = []i64(0)
    for p of parents {
      ids = append(ids, parentKeyOf(p))
    }
    let children = loadRelationTargets<TChild>(db, childForeignKey, ids)?
    let grouped = groupRelationRows<TChild>(children, childForeignKey)?
    for p of parents {
      let vs = grouped[parentKeyOf(p)]
      if (len(vs) > 0) {
        assign(p, vs[0])
      }
    }
    if (rest != "") {
      TChild.__loadRelation(db, rest, children)?
    }
  }
  return loader
}

// The `belongsTo` side: `TChild`'s relation field is the single `TParent` it
// points at. Queries the TARGET's own `@id` field generically
// (`relationIdField`) — never assumed to be named "id". `rest` (#6318): see
// `hasManyRelation`'s own header — recursed on the flat `parents` list this
// level already fetched.
export fn belongsToRelation<TChild: Tabled, TParent: Tabled>(
  childForeignKeyOf: (TChild) => i64,
  assign: (TChild, TParent) => (),
): RelationLoader<TChild> {
  let loader: RelationLoader<TChild> = (db, children, rest) => {
    if (len(children) == 0) {
      return
    }
    let ids = []i64(0)
    for c of children {
      ids = append(ids, childForeignKeyOf(c))
    }
    let idField = relationIdField<TParent>()?
    let parents = loadRelationTargets<TParent>(db, idField, ids)?
    let grouped = groupRelationRows<TParent>(parents, idField)?
    for c of children {
      let vs = grouped[childForeignKeyOf(c)]
      if (len(vs) > 0) {
        assign(c, vs[0])
      }
    }
    if (rest != "") {
      TParent.__loadRelation(db, rest, parents)?
    }
  }
  return loader
}

// The compiler-synthesized `__loadRelation`'s own tail: looks `name`'s own
// FIRST dotted segment up in the class's own relation table (one
// `RelationLoader<T>` per `@hasMany`/`@hasOne`/`@belongsTo` field, built
// with the three constructors above) and runs it, handing it whatever comes
// after that segment (#6318: `relationSplitPath`) — an unknown first
// segment fails naming the class, the same backstop
// `compiler/checkormquery.bit`'s literal check (#6271/#6318's `with` rule)
// sits in front of at compile time. `T`'s own relation table only ever has
// entries for its OWN direct fields, never a nested one, so only the first
// segment is ever looked up here — recursion past it happens inside the
// loader itself, against the target class's own table
// (`hasManyRelation`/`hasOneRelation`/`belongsToRelation`'s own headers).
export fn dispatchLoadRelation<T: Tabled>(
  db: Data, name: string, rows: []T, specs: map<string, RelationLoader<T>>,
): []T! {
  let (first, rest) = relationSplitPath(name)
  let (loader, ok) = specs[first]
  if (!ok) {
    fail newError("orm: '${T.__tableName()}' has no relation named '${first}'")
  }
  loader(db, rows, rest)?
  return rows
}

// The compiler-synthesized `__linkRelation`'s own tail (#6275/#6277): looks
// `name` up in the class's own many-to-many table (one `ManyToManyDesc` per
// `@manyToMany` field, `compiler/classtablerelation.bit`'s
// `rbManyToManyDescLit` — the join table and both join columns already
// baked in at compile time from the RAW class names) and attaches or
// detaches through it — an unknown name fails naming the class, the same
// backstop `compiler/checkormquery.bit`'s literal check sits in front of at
// compile time. `op.add` picks `attach` (idempotent INSERT) vs `detach`
// (exact-pair DELETE), `pkg/orm/manytomany.bit`, reused unqualified.
export fn dispatchLinkRelation<Own: Tabled>(
  db: Data, name: string, op: LinkOp, specs: map<string, ManyToManyDesc>,
): ()! {
  let (desc, ok) = specs[name]
  if (!ok) {
    fail newError("orm: '${Own.__tableName()}' has no many-to-many relation named '${name}'")
  }
  if (op.add) {
    return attach(db, desc, op.ownerId, op.targetIds, op.dialect)?
  }
  return detach(db, desc, op.ownerId, op.targetIds)?
}
