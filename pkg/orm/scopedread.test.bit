// pkg/orm/scopedread.test.bit — #7036's acceptance for `pkg/orm/scopedread.bit`:
// a `ScopedRepo<T>`'s read chain narrows every terminal call by the guard's
// filter and a row the actor cannot read is `guard.notFound`.
//
// `srGuard` is a structural `Guard` (SPEC §14.3) whose `filter` answers from a
// script (`mode`) and records what it was asked; `newRawPool`/`newRawAdapter`
// (./rawsql.test.bit) record every statement, so the exact SQL text and the
// arguments are asserted and a short-circuit is seen as zero statements. The
// eight cases run once per dialect (`srPostgres`/`srMysql`): the fragment is
// the guard's own text, appended verbatim, so both dialects must record the
// same statement. The live proof at the bottom (`ORM_TEST_LIVE_PG_URI`/
// `ORM_TEST_LIVE_MYSQL_URI`) is skipped, and says so, when no server is set.

@table("sposts") class SPost {
  id: i64,
  authorId: i64,
  body: string,
}

@table("sdposts") @softDelete class SDPost {
  id: i64,
  authorId: i64,
  deletedAt: Option<i64>,
}

class srUser {
  id: string,
}

// mode: 0 = All, 1 = None, 2 = Sql("author_id = $n", [actor.id]), 3 = error.
class srGuard {
  mode: int
  asked: int
  lastFirst: int
  lastActor: string
  lastOp: GuardOp

  protects(t: string): bool {
    return t == "sposts" || t == "sdposts"
  }

  filter(
    actor: Actor,
    op: GuardOp,
    t: string,
    dialect: ServerDialect,
    firstParam: int,
  ): GuardFilter! {
    this.asked = this.asked + 1
    this.lastFirst = firstParam
    this.lastActor = actor.id
    this.lastOp = op
    if (this.mode == 0) {
      return GuardFilter.All
    }
    if (this.mode == 1) {
      return GuardFilter.None
    }
    if (this.mode == 3) {
      fail newError("authz: rule store unavailable")
    }
    return GuardFilter.Sql("author_id = $${firstParam}", [Value.Text(actor.id)])
  }

  allows(actor: Actor, op: GuardOp, t: string, columns: []string, values: []Value): bool! {
    return true
  }

  denied(actor: Actor, op: GuardOp, t: string): error {
    return newError("denied")
  }

  notFound(t: string): error {
    return newError("${t}: not found")
  }

  check(): ()! {}
}

fn srPostgres(): ServerDialect {
  return ServerDialect.Postgres
}

fn srMysql(): ServerDialect {
  return ServerDialect.Mysql(MysqlVersion{ major = 8, minor = 0 })
}

fn srGuardMode(mode: int): srGuard {
  return srGuard{ mode = mode, asked = 0, lastFirst = 0, lastActor = "", lastOp = GuardOp.Read }
}

fn srDb(a: rawAdapter, d: ServerDialect, g: srGuard): Db {
  return Db{ pool = newRawPool(a), dialect = d, guard = g }
}

fn srPostRows(a: rawAdapter) {
  a.cols = ["id", "author_id", "body"]
  a.rows = [[Value.Int(5), Value.Int(7), Value.Text("hi")]]
}

fn srArgText(v: Value): string {
  match (v) {
    Null => return "null"
    Int(n) => return "i${n}"
    Float(f) => return "f${f}"
    Bool(b) => return "b${b}"
    Text(t) => return "t${t}"
    Blob(_) => return "blob"
  }
}

fn srArgsText(args: []Value): string {
  let parts = []string(0)
  for v of args {
    parts = append(parts, srArgText(v))
  }
  return join(parts, ",")
}

// The one statement `a` must have seen: exact text and arguments.
fn srExpect(a: rawAdapter, sqlText: string, args: string) {
  assert(len(a.queries) == 1, "expected 1 statement, got ${len(a.queries)}")
  let q = lastQuery(a)
  assert(q.sql == sqlText, "sql: ${q.sql}")
  assert(srArgsText(q.args) == args, "args: ${srArgsText(q.args)}")
}

fn srCaseAll(d: ServerDialect) {
  let a = newRawAdapter()
  srPostRows(a)
  let g = srGuardMode(2)
  let rows = srDb(a, d, g).as(srUser{ id = "u7" }).table<SPost>().all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  assert(len(rows) == 1 && rows[0].id == 5, "rows: ${len(rows)}")
  srExpect(a, "select * from sposts where (author_id = $1)", "tu7")
  assert(g.asked == 1 && g.lastFirst == 1 && g.lastActor == "u7", "guard asked ${g.asked}x")
  assert(g.lastOp == GuardOp.Read, "a read must ask for GuardOp.Read")
}

fn srCaseFirst(d: ServerDialect) {
  let a = newRawAdapter()
  srPostRows(a)
  let got = srDb(a, d, srGuardMode(2)).as(srUser{ id = "u7" }).table<SPost>().first() catch e {
    assert(false, "first: ${e.message()}")
    return
  }
  match (got) {
    Some(p) => assert(p.id == 5, "id ${p.id}")
    None => assert(false, "first returned None")
  }
  srExpect(a, "select * from sposts where (author_id = $1) limit 2", "tu7")
}

fn srCaseCount(d: ServerDialect) {
  let a = newRawAdapter()
  a.cols = ["n"]
  a.rows = [[Value.Int(3)]]
  let n = srDb(a, d, srGuardMode(2)).as(srUser{ id = "u7" }).table<SPost>().count() catch e {
    assert(false, "count: ${e.message()}")
    return
  }
  assert(n == 3, "count ${n}")
  srExpect(a, "select count(*) from sposts where (author_id = $1)", "tu7")
}

fn srCaseFind(d: ServerDialect) {
  let a = newRawAdapter()
  srPostRows(a)
  let g = srGuardMode(2)
  let p = srDb(a, d, g).as(srUser{ id = "u7" }).table<SPost>().find(5) catch e {
    assert(false, "find: ${e.message()}")
    return
  }
  assert(p.id == 5, "id ${p.id}")
  srExpect(a, "select * from sposts where id = $1 and (author_id = $2) limit 2", "i5,tu7")
  assert(g.lastFirst == 2, "find must ask with firstParam 2, got ${g.lastFirst}")
}

fn srCaseNumbering(d: ServerDialect) {
  let a = newRawAdapter()
  srPostRows(a)
  let g = srGuardMode(2)
  let repo = srDb(a, d, g).as(srUser{ id = "u7" }).table<SPost>()
  repo.where("body", "x").where("id", 9).all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  srExpect(a, "select * from sposts where body = $1 and id = $2 and (author_id = $3)", "tx,i9,tu7")
  assert(g.lastFirst == 3, "firstParam must continue after 2 args, got ${g.lastFirst}")
}

fn srCaseLimitOffset(d: ServerDialect) {
  let a = newRawAdapter()
  srPostRows(a)
  let repo = srDb(a, d, srGuardMode(2)).as(srUser{ id = "u7" }).table<SPost>()
  repo.orderBy("id", Dir.Desc).limit(10).offset(5).all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  srExpect(
    a,
    "select * from sposts where (author_id = $1) order by id desc limit 10 offset 5",
    "tu7",
  )
}

fn srCaseSoftDelete(d: ServerDialect) {
  let a = newRawAdapter()
  a.cols = ["id", "author_id", "deleted_at"]
  a.rows = [[Value.Int(5), Value.Int(7), Value.Null]]
  let repo = srDb(a, d, srGuardMode(2)).as(srUser{ id = "u7" }).table<SDPost>()
  repo.all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  srExpect(a, "select * from sdposts where (author_id = $1) and deleted_at is null", "tu7")

  let b = newRawAdapter()
  b.cols = a.cols
  b.rows = a.rows
  let repo2 = srDb(b, d, srGuardMode(2)).as(srUser{ id = "u7" }).table<SDPost>()
  repo2.withDeleted().all() catch e {
    assert(false, "withDeleted: ${e.message()}")
    return
  }
  srExpect(b, "select * from sdposts where (author_id = $1)", "tu7")
}

// A `None` filter: [], None, 0, and a `find` that fails with the guard's
// notFound; the driver sees nothing.
fn srCaseNone(d: ServerDialect) {
  let a = newRawAdapter()
  srPostRows(a)
  let g = srGuardMode(1)
  let repo = srDb(a, d, g).as(srUser{ id = "u7" }).table<SPost>()
  let rows = repo.all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  assert(len(rows) == 0, "all must be empty")
  let one = repo.first() catch e {
    assert(false, "first: ${e.message()}")
    return
  }
  match (one) {
    Some(_) => assert(false, "first must be None")
    None => {}
  }
  let n = repo.count() catch e {
    assert(false, "count: ${e.message()}")
    return
  }
  assert(n == 0, "count must be 0")
  repo.find(5) catch e {
    assert(e.message() == "sposts: not found", "find: ${e.message()}")
    assert(len(a.queries) == 0, "a None filter must run 0 statements, got ${len(a.queries)}")
    assert(g.asked == 4, "each terminal must ask the guard, got ${g.asked}")
    return
  }
  assert(false, "find on a None filter must fail")
}

// An empty result for the primary key: unreadable and missing look the same.
fn srCaseUnreadable(d: ServerDialect) {
  let a = newRawAdapter()
  a.cols = ["id", "author_id", "body"]
  a.rows = [][]Value(0)
  srDb(a, d, srGuardMode(2)).as(srUser{ id = "u9" }).table<SPost>().find(5) catch e {
    assert(e.message() == "sposts: not found", "find: ${e.message()}")
    return
  }
  assert(false, "find of an unreadable row must fail")
}

test "ScopedRepo reads on Postgres: all, first, count, find, numbering, limit/offset, soft delete, None (8 of 8)" {
  let d = srPostgres()
  srCaseAll(d)
  srCaseFirst(d)
  srCaseCount(d)
  srCaseFind(d)
  srCaseNumbering(d)
  srCaseLimitOffset(d)
  srCaseSoftDelete(d)
  srCaseNone(d)
}

test "ScopedRepo reads on MySQL: all, first, count, find, numbering, limit/offset, soft delete, None (8 of 8)" {
  let d = srMysql()
  srCaseAll(d)
  srCaseFirst(d)
  srCaseCount(d)
  srCaseFind(d)
  srCaseNumbering(d)
  srCaseLimitOffset(d)
  srCaseSoftDelete(d)
  srCaseNone(d)
}

test "find on an unreadable row fails with guard.notFound on Postgres and MySQL (2 of 2)" {
  srCaseUnreadable(srPostgres())
  srCaseUnreadable(srMysql())
}

test "a guard error fails every terminal closed and runs no statement" {
  let a = newRawAdapter()
  srPostRows(a)
  let repo = srDb(a, srPostgres(), srGuardMode(3)).as(srUser{ id = "u7" }).table<SPost>()
  let failed = 0
  repo.all() catch e {
    assert(e.message() == "authz: rule store unavailable", "got ${e.message()}")
    failed = failed + 1
  }
  repo.first() catch _ {
    failed = failed + 1
  }
  repo.count() catch _ {
    failed = failed + 1
  }
  repo.find(5) catch e {
    assert(
      e.message() == "authz: rule store unavailable",
      "find must not turn it into notFound: ${e.message()}",
    )
    failed = failed + 1
  }
  assert(failed == 4, "expected 4 failures, got ${failed}")
  assert(len(a.queries) == 0, "no statement may run, got ${len(a.queries)}")
}

test "GuardFilter.All adds no clause, a guest is asked with an empty id, an unprotected table is not asked" {
  let a = newRawAdapter()
  srPostRows(a)
  let g = srGuardMode(0)
  srDb(a, srPostgres(), g).asGuest().table<SPost>().all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  srExpect(a, "select * from sposts", "")
  assert(
    g.asked == 1 && g.lastActor == "",
    "a guest is still checked, asked ${g.asked}x as '${g.lastActor}'",
  )

  let b = newRawAdapter()
  b.cols = ["id", "body"]
  b.rows = [[Value.Int(1), Value.Text("x")]]
  let g2 = srGuardMode(2)
  srDb(b, srPostgres(), g2).as(srUser{ id = "u7" }).table<RawNote>().all() catch e {
    assert(false, "unprotected all: ${e.message()}")
    return
  }
  assert(g2.asked == 0, "a table the guard does not protect must not be asked")
  assert(lastQuery(b).sql == "select * from raw_note", "sql: ${lastQuery(b).sql}")
}

test "a chain error is reported before the guard's None short-circuits, and chains keep the actor" {
  let a = newRawAdapter()
  let g = srGuardMode(1)
  let repo = srDb(a, srPostgres(), g).as(srUser{ id = "u7" }).table<SPost>()
  repo.where("nope", 1).all() catch e {
    assert(contains(e.message(), "'nope' is not a field"), "got ${e.message()}")
    assert(g.asked == 0, "a bad column must fail before the guard is asked")
    return
  }
  assert(false, "a bad column must fail")
}

test "a ScopedRepo with no guard reads like a plain Repo" {
  let a = newRawAdapter()
  srPostRows(a)
  let db = Db{ pool = newRawPool(a) }
  db.as(srUser{ id = "u7" }).table<SPost>().where("body", "hi").all() catch e {
    assert(false, "all: ${e.message()}")
    return
  }
  srExpect(a, "select * from sposts where body = $1", "thi")
}

const srLiveSource: string = `import { args } from "std/os"
import { Actor, GuardFilter, GuardOp, Options, ServerDialect, open } from "orm"
import { Value } from "std/sql"

@table("sposts") class SPost {
  id: i64,
  authorId: i64,
  body: string,
}

// The guard keeps owner 7's rows whoever asks: the proof is that the ORM
// applies the fragment, not how a real guard picks it.
class Owner {
  protects(table: string): bool {
    return table == "sposts"
  }

  filter(actor: Actor, op: GuardOp, table: string, dialect: ServerDialect, firstParam: int): GuardFilter! {
    return GuardFilter.Sql("author_id = $@P@", [Value.Int(7)])
  }

  allows(actor: Actor, op: GuardOp, table: string, columns: []string, values: []Value): bool! {
    return true
  }

  denied(actor: Actor, op: GuardOp, table: string): error {
    return newError("denied")
  }

  notFound(table: string): error {
    return newError("not found")
  }

  check(): ()! {}
}

class Me {
  export id: string,
}

fn main(): ()! {
  let uri = args()[1]
  let db = open(uri, Options{ authz = Owner{} })?
  db.exec("drop table if exists sposts")?
  db.exec(args()[2])?
  let sys = db.asSystem().table<SPost>()
  let i = 0
  while (i < 5) {
    let owner = i64(8)
    if (i < 2) {
      owner = i64(7)
    }
    sys.insert(SPost{ id = 0, authorId = owner, body = "p" })?
    i = i + 1
  }
  let mine = db.as(Me{ id = "7" }).table<SPost>()
  let got = mine.all()?
  if (len(got) != 2) {
    panic("LIVE PROOF FAILED: filtered all() expected 2 of 5 rows)")
  }
  let n = mine.count()?
  if (n != 2) {
    panic("LIVE PROOF FAILED: filtered count() expected 2")
  }
  let other = sys.where("authorId", 8).first()?
  match (other) {
    Some(row) => {
      mine.find(row.id) catch e {
        print("LIVE_PROOF_OK")
        return
      }
      panic("LIVE PROOF FAILED: find on another owner's row must fail")
    }
    None => panic("LIVE PROOF FAILED: no row of the other owner")
  }
}
`

// `srLiveSource` is a raw string, where a well-formed interpolation pair
// warns (E0098), so the guard's placeholder number is spliced in here.
fn srLiveProgram(): string {
  return replace(srLiveSource, "@P@", "$" + "{firstParam}")
}

fn srRunLive(envVar: string, name: string, createTable: string) {
  let uri = env(envVar)
  if (uri == "") {
    print("  skipped: ${envVar} is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("liveproof7036${name}")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof7036${name}\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", srLiveProgram()) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }
  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri, createTable])
  assert(
    rc == 0,
    "live proof against a real ${name} server failed, rc=${rc}; run manually: ${bin} run ${proj}/main.bit '${uri}' '<ddl>'",
  )
  resetDir(proj)
}

test "live: a guarded all() returns 2 of 5 rows and find on another owner's row fails on Postgres (#7036)" {
  srRunLive(
    "ORM_TEST_LIVE_PG_URI", "pg",
    "create table sposts (id bigint generated always as identity primary key, author_id bigint not null, body text not null)",
  )
}

test "live: a guarded all() returns 2 of 5 rows and find on another owner's row fails on MySQL (#7036)" {
  srRunLive(
    "ORM_TEST_LIVE_MYSQL_URI", "mysql",
    "create table sposts (id bigint auto_increment primary key, author_id bigint not null, body text not null)",
  )
}
