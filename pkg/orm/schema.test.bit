// pkg/orm/schema.test.bit — #5065's acceptance: a create-table tree's exact
// shape, alter's three distinct op kinds (renameColumn carrying both names
// in one node), raw()'s passthrough, and drop.
//
// EVERY ASSERTION BELOW IS AN EXACT-VALUE CHECK ON A PLAIN IDENTIFIER OR
// ENUM TAG - "users", "email", `ColumnType.String(255)`, `ReferentialAction
// .Cascade`. That is what proves no SQL string is present anywhere in the
// tree: an injected fragment of SQL text in any of these fields would fail
// the equality against the bare name it is compared to, so a passing test
// is itself the proof, not a second scan over the tree.

// A table with an id, a unique 255-length string, a nullable timestamp, an
// index and a foreign key - #5065's own fenced example, unchanged.
test "table(): id, unique string, nullable timestamp, index and foreign key" {
  let op = table("users", (t) => {
    t.id("id")
    t.string("email", 255).unique()
    t.timestamp("created_at").nullable()
    t.index("created_at")
    t.foreign("team_id").references("teams", "id").onDelete(ReferentialAction.Cascade)
  })

  match (op) {
    CreateTable(created) => {
      assert(created.name == "users", "table name: ${created.name}")
      assert(len(created.columns) == 3, "column count: ${len(created.columns)}")

      let id = created.columns[0]
      assert(id.name == "id", "id column name: ${id.name}")
      assert(id.colType == ColumnType.Id, "id column type is not Id")
      assert(id.isPrimary, "id column is not primary")
      assert(!id.isNullable, "id column is nullable")
      assert(!id.isUnique, "id column is unique")

      let email = created.columns[1]
      assert(email.name == "email", "email column name: ${email.name}")
      assert(email.colType == ColumnType.String(255), "email column type/length wrong")
      assert(email.isUnique, "email column is not unique")
      assert(!email.isNullable, "email column is nullable")
      assert(!email.isPrimary, "email column is primary")

      let createdAt = created.columns[2]
      assert(createdAt.name == "created_at", "created_at column name: ${createdAt.name}")
      assert(createdAt.colType == ColumnType.Timestamp, "created_at column type is not Timestamp")
      assert(createdAt.isNullable, "created_at column is not nullable")
      assert(!createdAt.isUnique, "created_at column is unique")

      assert(len(created.indexes) == 1, "index count: ${len(created.indexes)}")
      let ix = created.indexes[0]
      assert(len(ix.columns) == 1, "index column count: ${len(ix.columns)}")
      assert(ix.columns[0] == "created_at", "index column: ${ix.columns[0]}")

      assert(len(created.foreignKeys) == 1, "foreign key count: ${len(created.foreignKeys)}")
      let fk = created.foreignKeys[0]
      assert(len(fk.columns) == 1, "foreign key column count: ${len(fk.columns)}")
      assert(fk.columns[0] == "team_id", "foreign key column: ${fk.columns[0]}")
      assert(fk.refTable == "teams", "foreign key ref table: ${fk.refTable}")
      assert(len(fk.refColumns) == 1, "foreign key ref column count: ${len(fk.refColumns)}")
      assert(fk.refColumns[0] == "id", "foreign key ref column: ${fk.refColumns[0]}")
      assert(fk.onDeleteAction == ReferentialAction.Cascade, "foreign key onDelete is not Cascade")

      assert(len(created.raws) == 0, "unexpected raw statement in a plain create")
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// A composite index - `t.index` is variadic, so more than one column name
// is a plain extra argument, not a second call.
test "table(): a composite index carries every column, in order" {
  let op = table("user_roles", (t) => {
    t.index("user_id", "role_id")
  })

  match (op) {
    CreateTable(created) => {
      assert(len(created.indexes) == 1, "index count: ${len(created.indexes)}")
      let ix = created.indexes[0]
      assert(len(ix.columns) == 2, "composite index column count: ${len(ix.columns)}")
      assert(ix.columns[0] == "user_id", "first index column: ${ix.columns[0]}")
      assert(ix.columns[1] == "role_id", "second index column: ${ix.columns[1]}")
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// alter(): addColumn, dropColumn and renameColumn are three distinct node
// kinds, and renameColumn is ONE node carrying both names - never a
// dropColumn node followed by an addColumn node, which is indistinguishable
// from an unrelated drop-then-add and would lose the column's data under a
// real rename (this file's header on #5065).
test "alter(): addColumn, dropColumn and renameColumn are distinct nodes" {
  let op = alter("users", (t) => {
    t.addString("phone", 20).nullable()
    t.dropColumn("legacy_flag")
    t.renameColumn("email", "email_address")
  })

  match (op) {
    AlterTable(altered) => {
      assert(altered.name == "users", "table name: ${altered.name}")
      assert(len(altered.ops) == 3, "op count: ${len(altered.ops)}")

      match (altered.ops[0]) {
        AddColumn(c) => {
          assert(c.name == "phone", "added column name: ${c.name}")
          assert(c.colType == ColumnType.String(20), "added column type/length wrong")
          assert(c.isNullable, "added column is not nullable")
        }
        _ => panic("ops[0] is not AddColumn")
      }

      match (altered.ops[1]) {
        DropColumn(name) => assert(name == "legacy_flag", "dropped column: ${name}")
        _ => panic("ops[1] is not DropColumn")
      }

      match (altered.ops[2]) {
        RenameColumn(oldName, newName) => {
          assert(oldName == "email", "rename old name: ${oldName}")
          assert(newName == "email_address", "rename new name: ${newName}")
        }
        _ => panic("ops[2] is not RenameColumn, or the rename is split into a drop plus an add")
      }
    }
    _ => panic("alter() did not produce an AlterTable op")
  }
}

// alter(): primaryKey appends a SetPrimaryKey node naming every column, in
// declaration order - AlterTable's own primary-key op (#5397), Table.
// primaryKey's sibling (#5084) for an existing table.
test "alter(): primaryKey appends a SetPrimaryKey node" {
  let op = alter("memberships", (t) => {
    t.addInt("user_id")
    t.primaryKey("user_id", "team_id")
  })

  match (op) {
    AlterTable(altered) => {
      assert(altered.name == "memberships", "table name: ${altered.name}")
      assert(len(altered.ops) == 2, "op count: ${len(altered.ops)}")

      match (altered.ops[1]) {
        SetPrimaryKey(columns) => {
          assert(len(columns) == 2, "column count: ${len(columns)}")
          assert(columns[0] == "user_id", "first key column: ${columns[0]}")
          assert(columns[1] == "team_id", "second key column: ${columns[1]}")
        }
        _ => panic("ops[1] is not SetPrimaryKey")
      }
    }
    _ => panic("alter() did not produce an AlterTable op")
  }
}

// alter(): replacePrimaryKey (#5400) appends a ReplacePrimaryKey node,
// `primaryKey`'s own sibling for a table whose key already exists live —
// see schema.bit's header for why the caller makes this assertion rather
// than the tree carrying live-schema state itself.
test "alter(): replacePrimaryKey appends a ReplacePrimaryKey node" {
  let op = alter("memberships", (t) => {
    t.replacePrimaryKey("user_id", "team_id")
  })

  match (op) {
    AlterTable(altered) => {
      assert(len(altered.ops) == 1, "op count: ${len(altered.ops)}")
      match (altered.ops[0]) {
        ReplacePrimaryKey(columns) => {
          assert(len(columns) == 2, "column count: ${len(columns)}")
          assert(columns[0] == "user_id", "first key column: ${columns[0]}")
          assert(columns[1] == "team_id", "second key column: ${columns[1]}")
        }
        _ => panic("ops[0] is not ReplacePrimaryKey")
      }
    }
    _ => panic("alter() did not produce an AlterTable op")
  }
}

// raw() on both `Table` and `AlterTable`: a passthrough node holding the
// given text verbatim, unparsed - the escape hatch #5065 requires.
test "raw(): a passthrough node holding the text verbatim" {
  let createOp = table("events", (t) => {
    t.id("id")
    t.raw("CREATE INDEX CONCURRENTLY events_payload_idx ON events ((payload->>'kind'))")
  })
  match (createOp) {
    CreateTable(created) => {
      assert(len(created.raws) == 1, "raw count: ${len(created.raws)}")
      assert(
          created.raws[0] ==
          "CREATE INDEX CONCURRENTLY events_payload_idx ON events ((payload->>'kind'))",
        "raw text was not carried verbatim: ${created.raws[0]}",
      )
    }
    _ => panic("table() did not produce a CreateTable op")
  }

  let alterOp = alter("events", (t) => {
    t.raw("ALTER TABLE events ADD CONSTRAINT events_kind_check CHECK (kind <> '')")
  })
  match (alterOp) {
    AlterTable(altered) => {
      assert(len(altered.raws) == 1, "raw count: ${len(altered.raws)}")
      assert(
        altered.raws[0] == "ALTER TABLE events ADD CONSTRAINT events_kind_check CHECK (kind <> '')",
        "raw text was not carried verbatim: ${altered.raws[0]}",
      )
    }
    _ => panic("alter() did not produce an AlterTable op")
  }
}

// drop(): a dropTable node naming the table.
test "drop(): a dropTable node" {
  let op = drop("legacy_events")
  match (op) {
    DropTable(name) => assert(name == "legacy_events", "dropped table: ${name}")
    _ => panic("drop() did not produce a DropTable op")
  }
}

// table(): a decimal column - #5326's ColumnType.Decimal, added for money
// columns (a first-class Bit type, #3980) that the original six variants
// had no way to declare.
test "table(): a decimal column carries the Decimal column type" {
  let op = table("accounts", (t) => {
    t.decimal("balance")
  })
  match (op) {
    CreateTable(created) => {
      assert(len(created.columns) == 1, "column count: ${len(created.columns)}")
      let balance = created.columns[0]
      assert(balance.name == "balance", "balance column name: ${balance.name}")
      assert(balance.colType == ColumnType.Decimal, "balance column type is not Decimal")
      assert(!balance.isNullable, "balance column is nullable")
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// alter(): addDecimal appends a Decimal AddColumn node, chaining .nullable()
// the same way every other addX method does.
test "alter(): addDecimal appends a Decimal AddColumn node" {
  let op = alter("accounts", (t) => {
    t.addDecimal("balance").nullable()
  })
  match (op) {
    AlterTable(altered) => {
      assert(len(altered.ops) == 1, "op count: ${len(altered.ops)}")
      match (altered.ops[0]) {
        AddColumn(c) => {
          assert(c.name == "balance", "added column name: ${c.name}")
          assert(c.colType == ColumnType.Decimal, "added column type is not Decimal")
          assert(c.isNullable, "added column is not nullable")
        }
        _ => panic("ops[0] is not AddColumn")
      }
    }
    _ => panic("alter() did not produce an AlterTable op")
  }
}

// table(): a json column - #5086's ColumnType.Json, the one column type for
// both a Json tree field and a @json class field (this file's own header on
// `ColumnType.Json`).
test "table(): a json column carries the Json column type" {
  let op = table("webhooks", (t) => {
    t.json("payload")
  })
  match (op) {
    CreateTable(created) => {
      assert(len(created.columns) == 1, "column count: ${len(created.columns)}")
      let payload = created.columns[0]
      assert(payload.name == "payload", "payload column name: ${payload.name}")
      assert(payload.colType == ColumnType.Json, "payload column type is not Json")
      assert(!payload.isNullable, "payload column is nullable")
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// alter(): addJson appends a Json AddColumn node, chaining .nullable() the
// same way every other addX method does.
test "alter(): addJson appends a Json AddColumn node" {
  let op = alter("webhooks", (t) => {
    t.addJson("payload").nullable()
  })
  match (op) {
    AlterTable(altered) => {
      assert(len(altered.ops) == 1, "op count: ${len(altered.ops)}")
      match (altered.ops[0]) {
        AddColumn(c) => {
          assert(c.name == "payload", "added column name: ${c.name}")
          assert(c.colType == ColumnType.Json, "added column type is not Json")
          assert(c.isNullable, "added column is not nullable")
        }
        _ => panic("ops[0] is not AddColumn")
      }
    }
    _ => panic("alter() did not produce an AlterTable op")
  }
}

// #6146: t.index().gin()/.gist()/.hash()/.brin() each set IndexMethod,
// leaving a plain t.index() at its Btree zero value.
test "table(): an index defaults to Btree; gin()/gist()/hash()/brin() each set their own method" {
  let op = table("articles", (t) => {
    t.index("created_at")
    t.index("search_vector").gin()
    t.index("path").gist()
    t.index("slug").hash()
    t.index("logged_at").brin()
  })
  match (op) {
    CreateTable(created) => {
      assert(len(created.indexes) == 5, "index count: ${len(created.indexes)}")
      assert(created.indexes[0].method == IndexMethod.Btree, "default method is not Btree")
      assert(created.indexes[1].method == IndexMethod.Gin, "gin() did not set Gin")
      assert(created.indexes[2].method == IndexMethod.Gist, "gist() did not set Gist")
      assert(created.indexes[3].method == IndexMethod.Hash, "hash() did not set Hash")
      assert(created.indexes[4].method == IndexMethod.Brin, "brin() did not set Brin")
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// #6146: t.indexExpr() carries an expression instead of a column list;
// .where() adds a partial index's own predicate to either kind.
test "table(): indexExpr carries an expression; where() adds a partial index's predicate" {
  let op = table("accounts", (t) => {
    t.indexExpr("lower(email)")
    t.index("email").where("deleted_at is null")
  })
  match (op) {
    CreateTable(created) => {
      assert(len(created.indexes) == 2, "index count: ${len(created.indexes)}")
      let exprIx = created.indexes[0]
      assert(exprIx.expr == "lower(email)", "expression index expr: ${exprIx.expr}")
      assert(
        len(exprIx.columns) == 0,
        "expression index must carry no columns: ${len(exprIx.columns)}",
      )
      assert(exprIx.whereClause == "", "expression index must have no predicate by default")

      let partial = created.indexes[1]
      assert(len(partial.columns) == 1, "partial index column count: ${len(partial.columns)}")
      assert(partial.columns[0] == "email", "partial index column: ${partial.columns[0]}")
      assert(
        partial.whereClause == "deleted_at is null", "partial index predicate: ${partial.whereClause}",
      )
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// #6146: t.tsvector() carries the Tsvector column type; .storedAs() records
// a generated column's own expression, empty for every ordinary column.
test "table(): a tsvector column, and storedAs() records a generated column's expression" {
  let op = table("articles", (t) => {
    t.string("title", 200)
    t.tsvector("search_vector").storedAs(toTsvector("english", ["title"], ["A"]))
  })
  match (op) {
    CreateTable(created) => {
      assert(len(created.columns) == 2, "column count: ${len(created.columns)}")
      assert(
        created.columns[0].generatedExpr == "",
        "an ordinary column must have no generated expression",
      )

      let sv = created.columns[1]
      assert(sv.name == "search_vector", "tsvector column name: ${sv.name}")
      assert(sv.colType == ColumnType.Tsvector, "tsvector column type is not Tsvector")
      assert(
        sv.generatedExpr == "setweight(to_tsvector('english', coalesce(title, '')), 'A')",
        "generated expression: ${sv.generatedExpr}",
      )
    }
    _ => panic("table() did not produce a CreateTable op")
  }
}

// #6146: toTsvector() weights and joins every named column, in order.
test "toTsvector(): weights and joins every column with the recommended setweight/coalesce shape" {
  let expr = toTsvector("english", ["title", "body"], ["A", "B"])
  let want = "setweight(to_tsvector('english', coalesce(title, '')), 'A') || " +
    "setweight(to_tsvector('english', coalesce(body, '')), 'B')"
  assert(expr == want, "toTsvector expression: ${expr}")
}

// #6146, against a real Postgres server (`bulk.test.bit`'s own header
// pattern): `ORM_TEST_LIVE_PG_URI` supplies a connection string; this test
// skips only when it is unset, and says so. Builds the table through
// pkg/orm's OWN `t.tsvector(...).storedAs(toTsvector(...))` and
// `t.index(...).gin()`, never a hand-typed DDL string, then proves the
// generated column and its GIN index actually work together: a ranked
// `@@ to_tsquery(...)` search against two rows returns only the matching
// one, ordered by `ts_rank`. `env`/`run`/`envOr` (std/os) and
// `findRepoRoot`/`scratchDir`/`resetDir` are already declared package-wide
// by `generate.test.bit` (`bulk.test.bit`'s own header on why re-importing
// or redeclaring any of them here would be E0042).
const liveTsvectorProofSource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value, Rows, sqlReqText } from \"std/sql\"\nimport { adapter } from \"postgres\"\nimport { Data, table, Postgres, toTsvector } from \"orm\"\n\nfn main(): ()! {\n  let uri = args()[1]\n  let db = pool(adapter(), Datasource{ uri = uri }) catch e {\n    panic(\"pool: \${e.message()}\")\n  }\n\n  db.exec(\"drop table if exists t6146_articles\", []Value(0)) catch e {\n    panic(\"drop: \${e.message()}\")\n  }\n\n  let op = table(\"t6146_articles\", (t) => {\n    t.id(\"id\")\n    t.string(\"title\", 200)\n    t.text(\"body\")\n    t.tsvector(\"search_vector\").storedAs(toTsvector(\"english\", [\"title\", \"body\"], [\"A\", \"B\"]))\n    t.index(\"search_vector\").gin()\n  })\n  let stmts = Postgres{}.render(op)\n  for st of stmts {\n    db.exec(st.sql, []Value(0)) catch e {\n      panic(\"LIVE PROOF FAILED (#6146): create via schema builder: \${e.message()}\")\n    }\n  }\n\n  db.exec(\n    \"insert into t6146_articles (title, body) values (\$1, \$2)\",\n    [Value.Text(\"Fast rockets\"), Value.Text(\"The launch was extremely fast and loud\")],\n  ) catch e {\n    panic(\"insert 1: \${e.message()}\")\n  }\n  db.exec(\n    \"insert into t6146_articles (title, body) values (\$1, \$2)\",\n    [Value.Text(\"Slow turtles\"), Value.Text(\"A calm and unhurried afternoon\")],\n  ) catch e {\n    panic(\"insert 2: \${e.message()}\")\n  }\n\n  let rows = db.query(\n    \"select title from t6146_articles where search_vector @@ to_tsquery('english', 'fast') \" +\n      \"order by ts_rank(search_vector, to_tsquery('english', 'fast')) desc\",\n    []Value(0),\n  ) catch e {\n    panic(\"LIVE PROOF FAILED (#6146): ranked @@ query against the generated tsvector column: \${e.message()}\")\n  }\n  if (!rows.next()) {\n    panic(\"LIVE PROOF FAILED (#6146): ranked @@ query returned no rows\")\n  }\n  let title = sqlReqText(rows, rows.columns(), \"title\") catch e {\n    panic(\"read title: \${e.message()}\")\n  }\n  if (title != \"Fast rockets\") {\n    panic(\"LIVE PROOF FAILED (#6146): expected 'Fast rockets' first, got '\${title}'\")\n  }\n  if (rows.next()) {\n    panic(\"LIVE PROOF FAILED (#6146): expected exactly one match, got a second row\")\n  }\n\n  db.exec(\"drop table t6146_articles\", []Value(0)) catch e {\n    panic(\"cleanup: \${e.message()}\")\n  }\n  db.close()\n  print(\"LIVE_PROOF_OK\")\n}\n"

test "live: a generated tsvector column and its GIN index rank a real @@ search correctly (#6146)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let proj = scratchDir("liveproof6146")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6146\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveTsvectorProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}
