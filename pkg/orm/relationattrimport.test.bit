// pkg/orm/relationattrimport.test.bit — #6144's own acceptance.
//
// #6144: `compiler/classtabledesc.bit`'s `collectRecordedAttrs` dropped a
// field's `@belongsTo`/`@hasOne`/`@hasMany` attribute the moment the SAME
// module also resolved a free function by that exact name — which is
// exactly what building a relation loader requires: `import { belongsTo }
// from "orm"`. `pkg/orm`'s own test files never hit this from the outside
// (`belongsTo` is declared IN this module, not imported), so this test
// compiles a SEPARATE scratch module that genuinely imports it, the same
// shape `articles.bit`'s `authorLoader()` (#6129) hit live. Run through a
// real `bit run` subprocess — #6144's own fix
// (compiler/classtabledesc.bit's `compilerKnownAttrAlwaysRecorded`,
// unconditional since #6192) — the identical local-path-dependency
// mechanism `generate.test.bit`'s "the generated file compiles under bit
// check" test already uses to check generated source against this repo's
// own `pkg/orm`.
//
// `findRepoRoot`/`resetDir` are declared in `./generate.test.bit`, this
// file's sibling in the same module (SPEC §17.1) — declaring them again
// here would be a duplicate.

import { trimSpace } from "std/strings"

test "a @belongsTo field survives a same-named import, and save()'s UPDATE excludes it from SET" {
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  // "postgres"/"mysql" too — see `generate.test.bit`'s own "the generated
  // file compiles under bit check" for why `pkg/orm/db.bit`'s `open`
  // (#6258) makes both a transitive need of every local-path consumer.
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = "${envOr("TMPDIR", "/tmp")}/task6144-relationimport"
  resetDir(proj)
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"relimportcheck\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", relationImportAcceptanceSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let script = "${proj}.sh"
  let outPath = "${proj}.out"
  let rcPath = "${proj}.rc"
  let cmd = "#!/bin/sh\n\"${bin}\" run \"${proj}\" >\"${outPath}\" 2>&1\necho $? > \"${rcPath}\"\n"
  writeFile(script, cmd) catch e {
    panic("writeFile ${script}: ${e.message()}")
  }
  assert(fsChmod(script, 493) == 0, "cannot chmod ${script}")

  let driverRc = osRunBounded(script, 60000)
  let outText = readFile(outPath) catch _ {
    ""
  }
  let childRc = trimSpace(
    readFile(rcPath) catch _ {
      "?"
    },
  )
  fsRemove(script)
  fsRemove(outPath)
  fsRemove(rcPath)
  resetDir(proj)

  assert(driverRc == 0, "driver script did not run to completion (rc=${driverRc}):\n${outText}")
  assert(childRc == "0", "scratch program did not exit 0 (rc=${childRc}):\n${outText}")
  assert(contains(outText, "ACCEPTANCE OK"), "unexpected output:\n${outText}")
  assert(
    contains(outText, "SQL: update articles set title = $1, author_id = $2 where id = $3"),
    "unexpected SET list:\n${outText}",
  )
}

// A genuine consumer module: imports `belongsTo` from "orm" to build a
// relation loader (`authorLoader`, unused by `main` but must type-check,
// the same shape a real caller writes), and ALSO marks `Article.author`
// with `@belongsTo` — the exact collision #6144 reported. `main` proves
// `tableDescriptor()` still records the attribute and that `save()`'s
// UPDATE branch excludes `author` from its SET list, never panicking with
// "no value supplied for field 'author'".
const relationImportAcceptanceSource: string = "import { pool, Datasource, Value, FieldDesc, AttrDesc, Adapter, Conn, Rows, Stmt, Tx, sqlReqInt, sqlReqText } from \"std/sql\"\nimport { save, belongsTo, find, Query, RelationLoader, TableDesc, Data } from \"orm\"\n\n@table class Author {\n  @id\n  id: i64\n  name: string\n}\n\n@table class Article {\n  @id\n  id: i64\n  title: string\n  @belongsTo(\"authorId\")\n  author: Author\n  authorId: i64\n}\n\nclass fakeAdapter {\n  calls: []string\n\n  connect(cfg: Datasource): Conn! {\n    return fakeConn{ a = this }\n  }\n}\n\nclass fakeConn {\n  a: fakeAdapter\n\n  query(sqlText: string, params: []Value): Rows! {\n    fail newError(\"fake: query not supported\")\n  }\n\n  exec(sqlText: string, params: []Value): int! {\n    this.a.calls = append(this.a.calls, sqlText)\n    return 1\n  }\n\n  prepare(sqlText: string): Stmt! {\n    fail newError(\"fake: prepare not supported\")\n  }\n\n  begin(): Tx! {\n    fail newError(\"fake: begin not supported\")\n  }\n\n  close() {}\n}\n\nfn authorMapper(rows: Rows): Author! {\n  let cols = rows.columns()\n  return Author{ id = sqlReqInt(rows, cols, \"id\")?, name = sqlReqText(rows, cols, \"name\")? }\n}\n\n// The normal way to build a relation loader -- the exact shape that made\n// `belongsTo` resolve in this module and triggered #6144.\nfn authorLoader(): RelationLoader<Article> {\n  return belongsTo<Article, Author>(\n    (a) => a.authorId,\n    (db) => find<Author>(db, \"authors\", Author{ id = 0, name = \"\" }.tableDescriptor(), authorMapper),\n    \"id\",\n    (au) => au.id,\n    (art, au) => { art.author = au },\n  )\n}\n\nfn main() {\n  let a = fakeAdapter{ calls = []string(0) }\n  let p = pool(a, Datasource{ host = \"fake\" }) catch e {\n    panic(\"pool: \${e.message()}\")\n  }\n\n  let article = Article{ id = 5, title = \"Hello\", author = Author{ id = 1, name = \"Ada\" }, authorId = 1 }\n  article.markPersisted(true)\n\n  let desc = article.tableDescriptor()\n  let authorAttrs = 0\n  for f of desc {\n    if (f.name == \"author\") {\n      authorAttrs = len(f.attrs)\n    }\n  }\n  if (authorAttrs == 0) {\n    panic(\"ACCEPTANCE FAILED: 'author' carries no recorded attrs; @belongsTo was dropped by the collision with the imported belongsTo\")\n  }\n\n  let values = map<string, Value>{\n    \"id\": Value.Int(article.id), \"title\": Value.Text(article.title), \"authorId\": Value.Int(article.authorId),\n  }\n  save(p, TableDesc{ table = \"articles\", fields = desc, classAttrs = []AttrDesc(0) }, values, article.isPersisted()) catch e {\n    panic(\"ACCEPTANCE FAILED: save() UPDATE panicked: \${e.message()}\")\n  }\n\n  let sql = a.calls[len(a.calls) - 1]\n  print(\"SQL: \${sql}\\n\")\n  print(\"ACCEPTANCE OK\\n\")\n}\n"
