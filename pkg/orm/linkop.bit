// pkg/orm/linkop.bit — `LinkOp`, the compiler-synthesized `__linkRelation`'s
// (#6277, compiler/classtablerelation.bit) own argument bundle: `ownerId`,
// `targetIds`, `dialect` and `add` grouped into one class rather than four
// parameters, the same "group the arguments" answer `pkg/orm/manytomany.bit`'s
// own `ManyToManyDesc` already gives for the identical `bit lint`
// max-params finding — `Repo<T>.link`/`unlink` (pkg/orm/repo.bit) are the
// only callers.
export class LinkOp {
  export ownerId: i64,
  export targetIds: []i64,
  export dialect: ServerDialect,
  export add: bool,
}
