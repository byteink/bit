// pkg/orm/linkop.bit — the argument bundle `Tabled.__linkRelation`
// (compiler/classtablerelation.bit, #6277) and `Repo<T>.link`/`unlink`
// (#6275, pkg/orm/repo.bit's own "// relations" block) pass through: every
// `attach`/`detach` (pkg/orm/manytomany.bit) call needs `ownerId`,
// `targetIds` and (for `attach` only) `dialect` — grouping them here is the
// same "group the arguments" answer `pkg/orm/manytomany.bit`'s own
// `ManyToManyDesc` already gives for the identical LINT.md max-params
// finding, since `__linkRelation`'s OTHER two parameters (`db`, `name`)
// leave no room for four more.

// `add = true` is `link` (INSERT the missing pairs, idempotent); `add =
// false` is `unlink` (DELETE exactly `targetIds`) — `pkg/orm/relationload.bit`'s
// `dispatchLinkRelation` reads this single flag rather than taking two
// separate entry points, mirroring `Repo<T>.orderBy`'s own one-method,
// typed-payload shape (#6271 owner ruling: never a second method for a
// direction).
export class LinkOp {
  export ownerId: i64,
  export targetIds: []i64,
  export add: bool,
  export dialect: ServerDialect,
}
