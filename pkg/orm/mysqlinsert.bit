// pkg/orm/mysqlinsert.bit — INSERT on MySQL (#7417, #7427). MySQL 8 has no
// `INSERT ... RETURNING` (MariaDB 10.5+ does), so the one statement Postgres
// runs becomes two on one connection:
//
//   insert into t (...) values (...), (...)          -- the OK packet carries the first id
//   select * from t where <the ids it generated> order by id
//
// The rows come from a SELECT, never from the values the caller sent, so
// database-side work (triggers, column defaults, type rounding) shows up
// exactly as Postgres's RETURNING shows it. No transaction is opened: the
// INSERT is one statement, so it is atomic on its own, and the generated id
// comes back in the INSERT's own OK packet (`ExecResult.lastInsertId`), so
// nothing has to run between the two statements on the same session.
//
// THE FIRST ID IS ENOUGH. The OK packet's last_insert_id after a multi-row
// INSERT is the FIRST generated id, and 0 when the statement generated none.
// The statement this package builds names no value for the auto-increment
// column, and for such a "simple insert" InnoDB reserves the whole block at
// once under every `innodb_autoinc_lock_mode` (0, 1 and the 8.x default, 2):
// MySQL's "InnoDB AUTO_INCREMENT Lock Modes" page states that only a
// mixed-mode insert (some rows naming an id) can leave a gap inside one
// statement. Row `i` therefore has id `first + i * step`, where `step` is the
// session's `@@auto_increment_increment` (1 unless the server is configured
// for multi-primary replication). The SELECT reads `step` itself, on the
// connection the INSERT ran on (a `Pool` is pinned for the two statements),
// so no cached copy can disagree with the session that generated the ids.
// Ids ascend with the VALUES list, so `order by id` is insert order.
//
// A COMPOSITE KEY names its values itself (`generatedIdField` is empty), so
// each row is re-selected by the key it was inserted with.
//
// `Data`, `Value`, `Rows`, `Pool`, `ExecResult`, `TableDesc`, `FieldDesc`,
// `generatedIdField`, `keyFields`, `columnName`, `valueFor`, `join` and
// `newError` are declared or imported by this package's other files (SPEC
// §17.1).

// Runs the INSERT for `chunk` and returns its rows read back as `T`, in
// insert order. On a `Pool` both statements run on one pinned connection,
// with no BEGIN/COMMIT; a caller's own transaction is already one
// connection, so the statements run on it directly.
fn mysqlInsert<T: Tabled>(db: Data, desc: TableDesc, chunk: []map<string, Value>): []T! {
  let (asPool, isPool) = db.(Pool)
  if (!isPool) {
    return mysqlInsertOn<T>(db, desc, chunk)?
  }
  // The annotation is what lets the closure below be inferred as
  // `(Executor) => []T!` (as runner.bit's `pinned` call says).
  let p: Pool = asPool
  return p.pinned<[]T>((c) => {
    return mysqlInsertOn<T>(c, desc, chunk)?
  })?
}

// The statements themselves, on the one connection `db` stands for.
fn mysqlInsertOn<T: Tabled>(db: Data, desc: TableDesc, chunk: []map<string, Value>): []T! {
  let (sqlText, args) = insertValuesSql(desc, chunk)
  let res = db.exec(sqlText, args)?
  if (generatedIdField(desc) == "") {
    return mysqlReadByKey<T>(db, desc, chunk)?
  }
  return mysqlReadByIds<T>(db, desc, mysqlFirstId(res, desc.table)?, len(chunk))?
}

// The first id the INSERT generated, from its own OK packet. 0 means it
// generated none: the `@id` column is not AUTO_INCREMENT, and reading rows
// back by any id would return someone else's.
fn mysqlFirstId(res: ExecResult, table: string): int! {
  match (res.lastInsertId) {
    Some(id) => {
      if (id > 0) {
        return id
      }
      fail newError("orm: insert into '${table}' generated no id (last_insert_id = ${id}); the '@id' column must be AUTO_INCREMENT on MySQL")
    }
    None => { fail newError("orm: insert into '${table}': the driver reported no generated id") }
  }
}

// The `n` rows the INSERT generated ids for, ascending by id: `first`, then
// every `@@auto_increment_increment`-th id after it, `n` in all.
fn mysqlReadByIds<T: Tabled>(db: Data, desc: TableDesc, first: int, n: int): []T! {
  let keyCol = columnName(keyFields(desc)[0])
  let step = "@@auto_increment_increment"
  let sqlText = "select * from ${desc.table} where ${keyCol} >= $1 and ${keyCol} <= $1 + $2 * ${step} and mod(${keyCol}, ${step}) = mod($1, ${step}) order by ${keyCol}"
  let out = mysqlReadAll<T>(db, sqlText, []Value{ Value.Int(first), Value.Int(n - 1) })?
  if (len(out) != n) {
    fail newError("orm: insert into '${desc.table}' wrote ${n} rows but ${len(out)} were found by generated id ${first}")
  }
  return out
}

// One row per inserted `chunk` entry, each selected by the key it carries.
fn mysqlReadByKey<T: Tabled>(db: Data, desc: TableDesc, chunk: []map<string, Value>): []T! {
  let kf = keyFields(desc)
  let out = []T(0)
  for row of chunk {
    let conds = []string(0)
    let args = []Value(0)
    for f of kf {
      args = append(args, valueFor(row, f, desc.table))
      conds = append(conds, "${columnName(f)} = $${len(args)}")
    }
    let found = mysqlReadAll<T>(
      db,
      "select * from ${desc.table} where ${join(conds, " and ")}",
      args,
    )?
    if (len(found) != 1) {
      fail newError("orm: insert into '${desc.table}' could not be read back by its key (found ${len(found)} rows)")
    }
    out = append(out, found[0])
  }
  return out
}

fn mysqlReadAll<T: Tabled>(db: Data, sqlText: string, args: []Value): []T! {
  let rows = db.query(sqlText, args)?
  defer rows.close()
  let out = []T(0)
  while (rows.next()?) {
    out = append(out, T.__fromRow(rows)?)
  }
  return out
}
