// pkg/orm/reporelations.bit — `Repo<T>`'s own "relations" block, split out
// of repo.bit to keep it under spec/LINT.md's 800-line ceiling (#6289),
// the same "keep the class, move the body" shape `pkg/orm/repoclone.bit`
// already set for `next()`'s own clone helpers.
//
// Every function below is the exact body `repo.bit`'s own method of the
// same name declared, now taking the receiver explicitly as `self:
// Repo<T>` — the method itself stays declared on the class, each a
// one-line call into here.

// Queues eager-loading the relation named `name` — `all()`/`first()`/
// `find()` run it (`repoLoadWith` below) right after fetching their own
// rows, one extra query per LEVEL, never N+1 (#6277's own `__loadRelation`,
// compiler/classtablerelation.bit; #6318's own nested dispatch,
// `pkg/orm/relationload.bit`). `name` may be a dotted path
// (`"author.posts"`) — asserted here, ONCE, against
// `relationMaxPathDepth` before it is ever queued: every recursive
// `dispatchLoadRelation` call this same string reaches afterward only ever
// sees a SUFFIX of it, so bounding the whole string here bounds every one
// of those calls too.
fn repoWith<T: Tabled>(self: Repo<T>, name: string): Repo<T> {
  assert(
    relationPathDepth(name) <= relationMaxPathDepth,
    "orm: with(\"${name}\") nests ${relationPathDepth(name)} levels deep, past the ${relationMaxPathDepth}-level bound",
  )
  let r = self.next()
  r.withNames = append(r.withNames, name)
  return r
}

// Many-to-many `link`/`unlink` (#6277's own `__linkRelation`,
// compiler/classtablerelation.bit) — terminal, never chainable, and never
// resolve a column by string themselves: `v`'s own primary key is read
// generically off `T.__columns()`/`__values()`'s own pairing
// (`relationIdField`/`relationFieldInt`, pkg/orm/relationload.bit), the
// same mechanism `columnFor` (reposql.bit) already reads a named column
// through, never reflection on `T`. `targetIds` are plain `i64`s (rule 5:
// the target's own `@id` values), matching `manytomany.bit`'s own
// `attach`/`detach` signatures unchanged.
fn repoLink<T: Tabled>(self: Repo<T>, v: T, name: string, targetIds: []i64): ()! {
  self.checkErr()?
  let idField = relationIdField<T>()?
  let ownerId = relationFieldInt<T>(v, idField)?
  return T.__linkRelation(
    self.db, name,
    LinkOp{ ownerId = ownerId, targetIds = targetIds, add = true, dialect = self.dialect },
  )?
}

fn repoUnlink<T: Tabled>(self: Repo<T>, v: T, name: string, targetIds: []i64): ()! {
  self.checkErr()?
  let idField = relationIdField<T>()?
  let ownerId = relationFieldInt<T>(v, idField)?
  return T.__linkRelation(
    self.db, name,
    LinkOp{ ownerId = ownerId, targetIds = targetIds, add = false, dialect = self.dialect },
  )?
}

// `rows`, with every queued `with()` name eager-loaded onto them —
// `all()`/`first()`'s own shared tail.
fn repoLoadWith<T: Tabled>(self: Repo<T>, rows: []T): []T! {
  let out = rows
  for name of self.withNames {
    out = T.__loadRelation(self.db, name, out)?
  }
  return out
}
