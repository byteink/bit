// pkg/orm/guard.bit — what the ORM asks of an authorization layer (#7034,
// epic #6984, design D6). `open(url, Options{ authz = guard })` (db.bit)
// keeps the guard on the `Db` and on every handle derived from it, so a
// repository can ask "may this actor do this?" and "which rows may it see?"
// without this package knowing who answers.
//
// THIS PACKAGE NEVER IMPORTS THE AUTHORIZATION PACKAGE. That package keeps
// its own rules in an orm-backed store, so an import in this direction would
// be a cycle. The interfaces below are structural (SPEC §14.3): any class
// with these methods is a `Guard`, and `pkg/authz` satisfies it without
// either side naming the other.
//
// Nothing here changes behaviour on its own. A `Db` with no guard
// (`Options.authz` is `Option.None`, the default) takes none of these
// paths.

// The four things a repository does to a row; a guard's rules are written
// against these.
export enum GuardOp {
  Read,
  Create,
  Update,
  Delete,
}

// What a guard says about the rows an actor may read or change in a table.
// `Sql` is a WHERE fragment already numbered from the `firstParam` the ORM
// passed to `filter`, with the arguments for its placeholders in order, so
// the ORM can append it to its own conditions without renumbering.
export enum GuardFilter {
  All,
  None,
  Sql(string, []Value),
}

// Any subject with an id. The guard gets the actor as this narrow type and
// recovers the full subject with a type assertion.
export interface Actor {
  id: string
}

// The authorization layer as the ORM sees it.
//
// `protects` says whether a table is guarded at all; `filter` narrows reads
// and scopes writes; `allows` judges the column values of one create or
// update; `denied` and `notFound` build the errors the ORM returns, so the
// guard decides how a refusal reads (and whether a row the actor may not
// see looks like a missing one); `check` runs once at `open` and fails when
// the guard cannot serve this ORM, for example a rule set with an operation
// it does not understand or a store it cannot read.
export interface Guard {
  protects(table: string): bool
  filter(actor: Actor, op: GuardOp, table: string, dialect: ServerDialect, firstParam: int): GuardFilter!
  allows(actor: Actor, op: GuardOp, table: string, columns: []string, values: []Value): bool!
  denied(actor: Actor, op: GuardOp, table: string): error
  notFound(table: string): error
  check(): ()!
}
