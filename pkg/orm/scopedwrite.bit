// pkg/orm/scopedwrite.bit — the create side of `ScopedRepo<T>` (#7037, epic
// #6984, design D6): "a write you may not do is 403". `insert` and
// `insertAll` have `Repo<T>`'s own signatures; the bodies live here, the same
// "keep the class, move the body" shape as `pkg/orm/scopedread.bit`.
//
// Before any SQL, `guard.allows(actor, GuardOp.Create, table, columns,
// values)` judges the new row:
//
//   - `columns` are the field names of the non-relation columns, in the
//     order `T.__values()` lists their values (`Repo.columnsForValues`,
//     `pkg/orm/reposql.bit`); a rule names a field exactly as the class
//     declares it.
//   - The guard sees the row as the caller built it: a database-generated id
//     is still its zero value, and `@timestamps` columns are not yet
//     stamped. A create rule over `id` is the app's to avoid.
//   - `false` fails with `guard.denied(actor, GuardOp.Create, table)` and
//     nothing is written; an error from `allows` is returned unchanged
//     (fail closed, never an unchecked write).
//   - `insertAll` asks about every row first, so one denied row rejects the
//     whole batch before its first statement. No transaction is opened, so
//     none is left behind.
//   - A guard that does not `protects` the table is not asked; a
//     `ScopedRepo` with no guard inserts like a plain `Repo<T>`.
//
// The row an allowed insert returns is what `Repo<T>.insert` returns: no
// read-back filter, so a creator who may create but not read still gets the
// row back.

fn scopedInsert<T: Tabled>(self: ScopedRepo<T>, v: T): T! {
  self.inner.checkErr()?
  checkCreate<T>(self, [v])?
  return self.inner.insert(v)?
}

fn scopedInsertAll<T: Tabled>(self: ScopedRepo<T>, rows: []T): []T! {
  self.inner.checkErr()?
  checkCreate<T>(self, rows)?
  return self.inner.insertAll(rows)?
}

// Fails unless the guard allows every row of `rows` to be created.
fn checkCreate<T: Tabled>(self: ScopedRepo<T>, rows: []T): ()! {
  match (self.guard) {
    Some(g) => checkRows<T>(self, g, rows)?
    None => {}
  }
}

fn checkRows<T: Tabled>(self: ScopedRepo<T>, g: Guard, rows: []T): ()! {
  if (len(rows) == 0 || !g.protects(T.__tableName())) {
    return
  }
  let names = []string(0)
  for f of self.inner.columnsForValues(rows[0])? {
    names = append(names, f.name)
  }
  let actor = scopedActor<T>(self)
  for v of rows {
    if (!g.allows(actor, GuardOp.Create, T.__tableName(), names, v.__values())?) {
      fail g.denied(actor, GuardOp.Create, T.__tableName())
    }
  }
}

// The new state is checked before a transaction or a statement can start.
fn scopedUpdate<T: Tabled>(self: ScopedRepo<T>, v: T): ()! {
  self.inner.checkErr()?
  match (self.guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        checkUpdateState<T>(self, g, v)?
        let plan = repoUpdatePlan<T>(self.inner, v, true)?
        guardedWrite<T>(self, g, plan, GuardOp.Update)?
        return
      }
    }
    None => {}
  }
  self.inner.update(v)?
}

fn checkUpdateState<T: Tabled>(self: ScopedRepo<T>, g: Guard, v: T): ()! {
  let names = []string(0)
  for f of self.inner.columnsForValues(v)? {
    names = append(names, f.name)
  }
  let actor = scopedActor<T>(self)
  if (!g.allows(actor, GuardOp.Update, T.__tableName(), names, v.__values())?) {
    fail g.denied(actor, GuardOp.Update, T.__tableName())
  }
}

fn scopedDelete<T: Tabled>(self: ScopedRepo<T>, id: Value, restore: bool, force: bool): ()! {
  self.inner.checkErr()?
  match (self.guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        let plan = scopedDeletePlan<T>(self.inner, id, restore, force)?
        let op = GuardOp.Delete
        if (restore) {
          op = GuardOp.Update
        }
        // Restore and force-delete can address rows already in the trash.
        let scoped = self
        if (restore || force) {
          scoped = scopedWith<T>(self, self.inner.withDeleted())
        }
        guardedWrite<T>(scoped, g, plan, op)?
        return
      }
    }
    None => {}
  }
  plainScopedDelete<T>(self.inner, id, restore, force)?
}

fn plainScopedDelete<T: Tabled>(inner: Repo<T>, id: Value, restore: bool, force: bool): ()! {
  if (restore) {
    inner.restore(id)?
    return
  }
  if (force) {
    inner.forceDelete(id)?
    return
  }
  inner.delete(id)?
}

fn scopedDeletePlan<T: Tabled>(
  inner: Repo<T>,
  id: Value,
  restore: bool,
  force: bool,
): repoWritePlan! {
  let col = inner.singleKeyColumn()?
  let softCol = ""
  if (!force) {
    softCol = inner.trashColumn()
  }
  inner.checkErr()?
  if (restore && softCol == "") {
    fail newError("orm: restore called on the class mapped to '${T.__tableName()}', which does not carry '@softDelete'")
  }
  let args = cloneValues(inner.args)
  let sqlText = "delete from ${T.__tableName()}"
  if (softCol != "" && !force) {
    let value = Value.Null
    if (!restore) {
      value = sqlValue(now().ns)
    }
    args = append(args, value)
    sqlText = "update ${T.__tableName()} set ${softCol} = $${len(args)}"
  }
  args = append(args, id)
  let conds = cloneStrings(inner.wheres)
  conds = append(conds, "${col} = $${len(args)}")
  return repoWritePlan{
    sqlText = sqlText + " where " + join(conds, " and "), args = args, keys = [id],
  }
}

// The permission predicate and mutation share one statement. A zero-row
// result only reads visibility; it can never authorize a later mutation.
fn guardedWrite<T: Tabled>(self: ScopedRepo<T>, g: Guard, plan: repoWritePlan, op: GuardOp): ()! {
  let filter = g.filter(
    scopedActor<T>(self),
    op,
    T.__tableName(),
    self.inner.dialect,
    len(plan.args) + 1,
  )?
  let write = true
  match (filter) {
    All => {}
    None => write = false
    Sql(fragment, args) => {
      plan.sqlText = plan.sqlText + " and (${fragment})"
      for a of args {
        plan.args = append(plan.args, a)
      }
    }
  }
  runTx(self.inner.db, (db) => {
    if (write) {
      if (db.exec(plan.sqlText, plan.args)?.rowsAffected != 0) {
        return
      }
    }
    let inner = self.inner.next()
    inner.db = db
    let keys = keyFields(inner.desc())
    let i = 0
    while (i < len(keys)) {
      inner = inner.where(keys[i].name, plan.keys[i])
      i = i + 1
    }
    let visible = scopedCount<T>(scopedWith<T>(self, inner))?
    if (visible == 0) {
      fail g.notFound(T.__tableName())
    }
    fail g.denied(scopedActor<T>(self), op, T.__tableName())
  })?
}
