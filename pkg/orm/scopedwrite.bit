// pkg/orm/scopedwrite.bit — the create side of `ScopedRepo<T>` (#7037, epic
// #6984, design D6): "a write you may not do is 403". `insert` and
// `insertAll` have `Repo<T>`'s own signatures; the bodies live here, the same
// "keep the class, move the body" shape as `pkg/orm/scopedread.bit`.
//
// Before any SQL, `guard.allows(actor, GuardOp.Create, table, columns,
// values)` judges the new row:
//
//   - `columns` are the field names of the non-relation columns, in the
//     order `T.__values()` lists their values (`Repo.columnsForValues`,
//     `pkg/orm/reposql.bit`); a rule names a field exactly as the class
//     declares it.
//   - The guard sees the row as the caller built it: a database-generated id
//     is still its zero value, and `@timestamps` columns are not yet
//     stamped. A create rule over `id` is the app's to avoid.
//   - `false` fails with `guard.denied(actor, GuardOp.Create, table)` and
//     nothing is written; an error from `allows` is returned unchanged
//     (fail closed, never an unchecked write).
//   - `insertAll` asks about every row first, so one denied row rejects the
//     whole batch before its first statement. No transaction is opened, so
//     none is left behind.
//   - A guard that does not `protects` the table is not asked; a
//     `ScopedRepo` with no guard inserts like a plain `Repo<T>`.
//
// The row an allowed insert returns is what `Repo<T>.insert` returns: no
// read-back filter, so a creator who may create but not read still gets the
// row back.

fn scopedInsert<T: Tabled>(self: ScopedRepo<T>, v: T): T! {
  self.inner.checkErr()?
  checkCreate<T>(self, [v])?
  return self.inner.insert(v)?
}

fn scopedInsertAll<T: Tabled>(self: ScopedRepo<T>, rows: []T): []T! {
  self.inner.checkErr()?
  checkCreate<T>(self, rows)?
  return self.inner.insertAll(rows)?
}

// Fails unless the guard allows every row of `rows` to be created.
fn checkCreate<T: Tabled>(self: ScopedRepo<T>, rows: []T): ()! {
  match (self.guard) {
    Some(g) => checkRows<T>(self, g, rows)?
    None => {}
  }
}

fn checkRows<T: Tabled>(self: ScopedRepo<T>, g: Guard, rows: []T): ()! {
  if (len(rows) == 0 || !g.protects(T.__tableName())) {
    return
  }
  let names = []string(0)
  for f of self.inner.columnsForValues(rows[0])? {
    names = append(names, f.name)
  }
  let actor = scopedActor<T>(self)
  for v of rows {
    if (!g.allows(actor, GuardOp.Create, T.__tableName(), names, v.__values())?) {
      fail g.denied(actor, GuardOp.Create, T.__tableName())
    }
  }
}
