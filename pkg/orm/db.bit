// pkg/orm/db.bit — open(url), Db, TxHandle and the Tabled bound: the locked
// target's entry point (#6258, epic #6253). `open` picks the driver from
// `url`'s own scheme, so a caller never imports `pkg/postgres`/`pkg/mysql`,
// builds an `Adapter`, or touches a `Datasource` — the one line in this
// file that does either lives here, not in the caller's own code.
// `db.table<T>()`/`tx.table<T>()` hand back a `Repo<T>` (`pkg/orm/repo.bit`)
// that already holds the connection;
// nothing in this package takes `db` as a parameter the way pkg/orm's own
// retired hand-built find chain (`pkg/orm/query.bit`, #6296) used to.
//
// `Tabled` IS THE BOUND EVERY `@table` CLASS SATISFIES FOR FREE, WITH NO
// DECLARATION OF ITS OWN (#6255, compiler/classtablerow.bit): `static
// __tableName()`, `static __className()` (the class identifier as declared,
// never the table name, #6988), `static __fromRow(rows): Self!`, `static
// __columns()` and instance `__values()`. `Self` (SPEC §11.3) is what lets
// `__fromRow`'s return type be stated once here and resolved to each concrete
// class at monomorphization — `T.__fromRow(rows)?` inside a `T: Tabled`-bounded
// function returns `T`, not `Tabled`, verified end to end against this
// branch's own compiler (probe: `describe<T: Tabled>` calling
// `T.__fromRow`, `bit run` exits 0 and prints the concrete row).
//
// `__loadRelation` (#6277, compiler/classtablerelation.bit) is the same
// shape, added so `Repo<T>.with` (#6275, pkg/orm/repo.bit) needs no
// reflection on `T`: it is synthesized ON the concrete class, so its body
// reads/writes the class's OWN relation fields directly, never through
// `T`. `__linkRelation` is the identical shape for many-to-many
// (`Repo<T>.link`/`unlink`, pkg/orm/repo.bit's own "// relations" block):
// one arm per `@manyToMany` field, its join table and both join columns
// computed at compile time from the RAW class names, `pkg/orm/manytomany.bit`'s
// `attach`/`detach` doing the actual SQL through
// `pkg/orm/relationload.bit`'s `dispatchLinkRelation`.
import { Adapter, Datasource, pool, tx as runTx, txValue as runTxValue, TableSchema, __tables } from "std/sql"
import { adapter as postgresAdapter } from "postgres"
import { adapter as mysqlAdapter } from "mysql"

// `open`'s own second, defaulted parameter (#6307, owner ruling 2026-09-30:
// TypeORM-style `synchronize`, the developer's own choice in ANY
// environment, production included - no dev-only guard, no prod warning).
// `Options{}` is the default (#6112: a default parameter value may be any
// expression), so every existing `open(url)` call keeps compiling unchanged.
//
// `authz` is the authorization layer (#7034, `pkg/orm/guard.bit`):
// `open(url, Options{ authz = guard })`. A field default of `Option.None`
// is what #6698 made legal, so a caller that sets only `synchronize` keeps
// no guard and the ORM behaves exactly as it did before the field existed.
export class Options {
  export synchronize: bool,
  export authz: Option<Guard> = Option.None,
  // Where `db.asSystem().table<T>()` writes its debug record (#7035): a
  // std/log `Logger` (#7430). Unset means std/log's `getDefault()`, whose
  // INFO threshold drops a debug record, so no logger, no line. Statement
  // logging is separate: `QueryLog(logger).wrap(...)` (`pkg/orm/log.bit`).
  export logger: Option<Logger> = Option.None,
}

// What a `db.table<T>()`/`tx.table<T>()` repository needs from `T`.
//
// `static __tableAttrs(): []AttrDesc` (#6274) - a class's own `@softDelete`/
// `@timestamps` marks, reached the same way `__tableName`/`__columns` are:
// through `T`, never an instance. `Repo<T>.insert`/`.update` never hold a
// non-generic `T` either (`write.bit`'s header: the same reason those three
// take their entity's values explicitly), so class-level marks need their
// OWN static member here, distinct from `tableAttrs()` (classtabledesc.bit),
// the pre-existing INSTANCE method `pkg/orm/write.bit`'s own per-entity
// wrappers already call off a concrete value.
export interface Tabled {
  static __tableName(): string,
  static __className(): string,
  static __fromRow(rows: Rows): Self!,
  static __columns(): []FieldDesc,
  static __tableAttrs(): []AttrDesc,
  __values(): []Value,
  static __loadRelation(db: Data, name: string, rows: []Self): []Self!,
  static __linkRelation(db: Data, name: string, op: LinkOp): ()!,
}

// A SQL database, opened once per process (rule 1). `table<T>()` never
// takes `db` (rule 2) — the `Repo<T>` it returns already holds the pool.
// `dialect` is derived once here (`dialectFor`, matching `adapterFor`'s own
// branch) and carried onto every `Repo<T>`/`TxHandle` it hands out —
// integrator decision 2026-09-29: many-to-many `link`/`unlink`
// (`ManyToManyDesc`'s `attach`/`detach`, pkg/orm/manytomany.bit) needs a
// `ServerDialect`, and `open` already knows it, so nothing downstream has to
// ask for one again.
//
// `guard` is `Options.authz` as `open` received it (`pkg/orm/guard.bit`),
// handed on to every repository and transaction handle this `Db` derives so
// the later guard checks need nothing from the call site.
export class Db {
  pool: Pool
  dialect: ServerDialect
  guard: Option<Guard> = Option.None
  logger: Option<Logger> = Option.None

  // A table the guard protects is not reachable from here: the repository
  // fails every terminal call with `Unscoped` (`pkg/orm/scoped.bit`). Use
  // `as`/`asGuest` for a request and `asSystem` for a job.
  export table<T: Tabled>(): Repo<T> {
    return plainRepo<T>(this.pool, this.dialect, this.guard)
  }

  // The handle for one request: every repository it hands out is checked
  // against the guard for `subject`. `as` is a reserved word, legal as a
  // method name after `.` (SPEC §5.2). `subject` is any class with an `id`.
  export as(subject: Actor, tenant: string = ""): ScopedDb {
    return ScopedDb{ db = this, actor = Option.Some(subject), tenant = tenant }
  }

  // A request with no signed-in subject. Guests are still checked (design
  // D10): they are an actor with no id, never an unchecked one.
  export asGuest(tenant: string = ""): ScopedDb {
    return ScopedDb{ db = this, actor = Option.None, tenant = tenant }
  }

  // The explicit unscoped handle, for jobs and migrations.
  export asSystem(): SystemDb {
    return SystemDb{ db = this }
  }

  // All-or-nothing (rule 6): COMMIT when `f` returns, ROLLBACK on failure
  // or panic (std/sql's own `tx`, `pkg/orm/data.bit`'s header). `f`'s own
  // parameter is the transaction handle, never the outer `db` — see
  // `data.bit`'s header for why the closure must shadow it.
  export tx(f: (TxHandle) => ()!): ()! {
    return runTx(this.pool, (t) => {
      return f(TxHandle{ db = t, dialect = this.dialect, guard = this.guard })?
    })?
  }

  // The raw SQL escape hatch (#6273, `pkg/orm/rawsql.bit` — real logic and
  // full design note there): `?` placeholders, each `values` argument bound
  // through the language's own `Value` coercion (#6280, SPEC next to
  // `sqlValue<V>`) — `...values: Value` accepts a mix of plain
  // string/int/bool/f64/[]byte/`Option<>` values (or a zero-value call) at
  // the call site with no generic of this package's own, never interpolated.
  export exec(sqlText: string, ...values: Value): int! {
    return execOn(this.pool, sqlText, values)?
  }

  export query<T: Tabled>(sqlText: string, ...values: Value): []T! {
    return queryOn<T>(this.pool, sqlText, values)?
  }
}

// The handle a `db.tx()` closure receives — `table<T>()` on the live
// transaction, never the pool underneath. Hands back `TxRepo<T>`
// (pkg/orm/txrepo.bit), not `Repo<T>`: the only structural difference is
// `TxRepo<T>.lock()`, which is how `db.table<T>().lock()` is a COMPILE
// error while `tx.table<T>().lock()` compiles (#6278) — see txrepo.bit's
// header for why a flag or a second `Repo<T>` type parameter cannot do this.
export class TxHandle {
  db: Data
  dialect: ServerDialect
  guard: Option<Guard> = Option.None

  export table<T: Tabled>(): TxRepo<T> {
    return TxRepo<T>{ inner = plainRepo<T>(this.db, this.dialect, this.guard) }
  }

  // Same raw escape hatch as `Db.exec`/`Db.query<T>` above, scoped to this
  // transaction — see `pkg/orm/rawsql.bit`.
  export exec(sqlText: string, ...values: Value): int! {
    return execOn(this.db, sqlText, values)?
  }

  export query<T: Tabled>(sqlText: string, ...values: Value): []T! {
    return queryOn<T>(this.db, sqlText, values)?
  }
}

// The only entry point (rule 1). `url` is forwarded to the chosen driver's
// `Datasource.uri` unparsed — `stdlib/sql/config.bit`'s own header: parsing
// it is the adapter's job, not this function's. `opts.synchronize` runs
// `syncTables` (`sync.bit`) against `__tables()` — the compiler-synthesized
// registry of every `@table` class in the project (#6301) — before the
// connection is handed back, so a caller never lists its own entities.
// A guard's `check()` runs first, before any connection exists, so a guard
// that cannot serve this ORM is a startup error and leaves nothing open.
export fn open(url: string, opts: Options = Options{}): Db! {
  checkGuard(opts.authz)?
  let a = adapterFor(url)?
  let p = pool(a, Datasource{ uri = url })?
  let server = dialectFor(url)
  if (opts.synchronize) {
    syncTables(p, __tables(), RunnerDialect{ render = renderDialectFor(server), server = server })?
  }
  return Db{ pool = p, dialect = server, guard = opts.authz, logger = opts.logger }
}

fn checkGuard(g: Option<Guard>): ()! {
  match (g) {
    Some(guard) => guard.check()?
    None => {}
  }
}

// The DDL renderer matching `dialectFor`'s own branch — `sync`'s own
// `RunnerDialect.render`, derived once here so nothing downstream asks
// again (this file's header, "dialect is derived once").
fn renderDialectFor(server: ServerDialect): Dialect {
  match (server) {
    Postgres => return Postgres{}
    Mysql(_) => return Mysql{}
  }
}

fn adapterFor(url: string): Adapter! {
  if (hasPrefix(url, "postgres://") || hasPrefix(url, "postgresql://")) {
    return postgresAdapter()
  }
  if (hasPrefix(url, "mysql://")) {
    return mysqlAdapter()
  }
  fail newError("orm: no driver recognizes the URL scheme in '${url}' — expected 'postgres://' or 'mysql://'")
}

// The `ServerDialect` matching `adapterFor`'s own branch. The MySQL
// variant's own version is unknown from the URL alone — `manytomany.bit`'s
// `attachSql` only matches the TAG, never the `MysqlVersion` payload, so a
// zeroed one is inert for every caller this field serves today; a real
// version probe is separate future work a version-sensitive caller
// (`lock.bit`'s `SKIP LOCKED`/`NOWAIT` guard) would need, not attempted here.
fn dialectFor(url: string): ServerDialect {
  if (hasPrefix(url, "mysql://")) {
    return ServerDialect.Mysql(MysqlVersion{ major = 0, minor = 0 })
  }
  return ServerDialect.Postgres
}
