// pkg/orm/naming.bit — mapping a #5051 descriptor to the names SQL actually
// uses (#5056, owner decision 2026-09-12).
//
// THREE NAMINGS, THREE AUDIENCES (owner decision, reversing #3976/#3978's
// "one rule for JSON and SQL"): a Bit field is written as it is
// (`createdAt`), a SQL column is snake_case (`created_at`, `@column("...")`
// overrides it), a JSON key is as written (`createdAt`, `@key("...")`
// overrides it, unaffected by this file). snake_case never appears in Bit
// source. Postgres folds an unquoted identifier to lowercase, so leaving a
// mixed-case field name as the column name means either quoting it at every
// call site or having it silently become `createdat` — both worse than
// converting.
//
// PLURALISATION IS FOUR RULES, NO INFLECTOR (owner: "if I have a user model
// it does not make sense to have user table, table has users"). A Rails-style
// irregular-noun list is rejected — English-only, and a permanent stream of
// "why is Datum->data but Forum->forums" reports. `Person`->`persons` is
// wrong but CONSISTENT, and an explicit override is the one place you would
// want to be precise anyway.
//
//   1. ends s, x, z, ch, sh -> +es      Box->Boxes, Class->Classes
//   2. consonant + y -> ies             Company->Companies
//   3. otherwise -> +s                  User->Users, Order->Orders
//
// Then snake_case: OrderLine -> "OrderLines" -> order_lines. The suffix
// rules read the whole PascalCase name's tail, not a detected last "word",
// which is what makes `OrderLine`'s "Line" pluralise correctly without any
// word-boundary detection: "e" falls through to rule 3 regardless of what
// precedes it.
//
// snake_case's OWN rule (shared by both the table and the column path): a
// boundary goes before a capital that follows a lowercase or a digit, or
// before the LAST capital of a run that is followed by a lowercase — so an
// acronym stays one word. `userID` -> `user_id`, `HTTPStatus` ->
// `http_status`, never `user_i_d`. Already-snake_case input is unchanged,
// and the loop never looks at a boundary before index 0, so a leading
// capital never produces a leading underscore.
//
// THE TABLE OVERRIDE IS READ OFF THE DESCRIPTOR (#5189). `@table("people")`
// now parses (compiler/parserdecl.bit's `checkClassAttrs` allows `@table`
// exactly one string-literal argument; `@json` still allows none) and the
// compiler records it the same way a field's `@column("...")` override
// already is: `tableAttrs(): []AttrDesc`, synthesized alongside
// `tableDescriptor()` (compiler/classtabledesc.bit), carries `@table`'s own
// argument as `AttrDesc{name: "table", args: ["people"]}`, empty when
// `@table` had none. `tableName` below reads it with the identical
// `attrArg` helper `columnName` already reads a field's `@column` override
// with - the two overrides in this feature now have the same shape.
//
// The column override has no such gap: `@column("...")` is an ordinary
// FIELD attribute, and #5051 already records any field attribute whose name
// does not resolve to a callable — `column` never does — as
// `AttrDesc{name: "column", args: [...]}` on the field's own `FieldDesc`.
// `columnName` below reads it with no compiler change of any kind.

import { FieldDesc, AttrDesc } from "std/sql"
import { newBuilder } from "std/strings"

// The table name for a `@table` class named `className`, whose own
// synthesized `tableAttrs()` is `classAttrs` - `@column`'s counterpart for
// the class itself, read with the same `attrArg` helper. A given override
// is returned verbatim, never pluralised or case-converted - the one place
// a caller may want the exact spelling.
export fn tableName(className: string, classAttrs: []AttrDesc): string {
  let (v, found) = attrArg(classAttrs, "table")
  if (found) {
    return v
  }
  return toSnake(pluralize(className))
}

// The column name for one field of a `@table` class's descriptor
// (`tableDescriptor()`, #5051): `@column("...")` on the field if present,
// else snake_case of the field name as written.
export fn columnName(f: FieldDesc): string {
  let (v, found) = attrArg(f.attrs, "column")
  if (found) {
    return v
  }
  return toSnake(f.name)
}

// The reverse direction: which field in `fields` maps to the result column
// `column`, or "" if none does. Driven by the descriptor rather than by
// un-converting snake_case, because that conversion is lossy — `user_id`
// could have come from `userID` or `userId`, and only the descriptor (the
// field names actually declared) can say which.
export fn fieldForColumn(fields: []FieldDesc, column: string): string {
  for f of fields {
    if (columnName(f) == column) {
      return f.name
    }
  }
  return ""
}

// The first argument of the attribute named `name` on `attrs`, and whether
// one was found. An attribute with no arguments (recorded, per #5051, with
// an empty `args`) is treated as absent — `@column` with no name to give
// makes no sense syntactically, but this stays defensive rather than
// indexing an empty slice.
fn attrArg(attrs: []AttrDesc, name: string): (string, bool) {
  for a of attrs {
    if (a.name == name && len(a.args) > 0) {
      return (a.args[0], true)
    }
  }
  return ("", false)
}

// `className`, pluralised by the three rules in this file's header comment.
// Case is untouched here — `toSnake` runs after this, on the result.
fn pluralize(className: string): string {
  let n = len(className)
  if (n == 0) {
    return className
  }
  if (pluralizesWithEs(className, n)) {
    return className + "es"
  }
  if (pluralizesWithIes(className, n)) {
    return className[0:n - 1] + "ies"
  }
  return className + "s"
}

// Rule 1: ends s, x, z, ch or sh.
fn pluralizesWithEs(className: string, n: int): bool {
  let last = toLowerByte(className[n - 1])
  if (last == 's' || last == 'x' || last == 'z') {
    return true
  }
  if (n < 2) {
    return false
  }
  let secondLast = toLowerByte(className[n - 2])
  return (secondLast == 'c' || secondLast == 's') && last == 'h'
}

// Rule 2: ends consonant + y.
fn pluralizesWithIes(className: string, n: int): bool {
  if (n < 2) {
    return false
  }
  if (toLowerByte(className[n - 1]) != 'y') {
    return false
  }
  return !isVowelByte(toLowerByte(className[n - 2]))
}

// camelCase/PascalCase -> snake_case (this file's header comment states the
// boundary rule). Built byte-at-a-time over ASCII, the only alphabet a Bit
// identifier can use (SPEC §5).
fn toSnake(s: string): string {
  let b = newBuilder()
  let n = len(s)
  let i = 0
  while (i < n) {
    let c = s[i]
    if (i > 0 && isUpperByte(c) && startsWordBoundary(s, i, n)) {
      b.writeByte('_')
    }
    b.writeByte(toLowerByte(c))
    i = i + 1
  }
  return b.toString()
}

// Whether a snake_case boundary goes immediately before `s[i]`, an
// uppercase byte. True for a lower/digit -> upper transition (`createdAt`'s
// `A`), or for the LAST capital of a run that is followed by a lowercase
// (`HTTPStatus`'s `S` — `HTTP`'s own interior capitals are not boundaries,
// which is what keeps the acronym one word and avoids `h_t_t_p_status`).
fn startsWordBoundary(s: string, i: int, n: int): bool {
  let prev = s[i - 1]
  if (isLowerByte(prev) || isDigitByte(prev)) {
    return true
  }
  return isUpperByte(prev) && i + 1 < n && isLowerByte(s[i + 1])
}

fn isUpperByte(c: u8): bool {
  return c >= 'A' && c <= 'Z'
}

fn isLowerByte(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

fn isDigitByte(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isVowelByte(c: u8): bool {
  return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u'
}

fn toLowerByte(c: u8): u8 {
  if (isUpperByte(c)) {
    return c + 32
  }
  return c
}
