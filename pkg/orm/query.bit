// pkg/orm/query.bit — the find chain (#5057, owner decision 2026-09-12):
// where/whereIn/whereNull/whereLike/orderBy/limit/offset/with, with a
// string-literal column or relation name checked at compile time.
//
//     let fields = User{}.tableDescriptor()
//     let q = find<User>(db, tableName("User", User{}.tableAttrs()), fields, __rowToUser)
//     let rows = q.where("email", Value.Text(e)).orderBy("createdAt", Dir.Desc).limit(20).all()?
//
// `with(name)` requests eager loading of a relation `pkg/orm/relation.bit`'s
// `withRelations` registered on this query — see that file for `hasMany`/
// `hasOne`/`belongsTo` and why the loader is registered explicitly rather
// than derived from `T`'s own `@hasMany`/`@hasOne`/`@belongsTo` field
// (#5061).
//
// `whereRaw`/`orderByField`/`orderByRaw` (#5073, #5362) are the one escape
// hatch through this chain that accepts SQL text or a dynamic column name
// — see `pkg/orm/raw.bit`'s header for the two rules that keep them safe.
//
// WHY `find<T>` TAKES `table`/`fields`/`mapper` EXPLICITLY, NOT
// `db.find<User>()`. #5054's own `find<T>`/`findOne<T>`/`findOneOrFail<T>`
// (stdlib/sql/row.bit) get their per-class mapper by a COMPILER REWRITE at
// the exact call site that writes `<T>` literally (compiler/checksqlrow.bit)
// — the template body never runs. `Query<T>.all()`/`.one()`/`.oneOrFail()`
// below are ordinary METHODS on a generic class: by the time they run, `T`
// is Query's own type parameter, not a literal class name any pre-checker
// pass can resolve to a declaration — the exact same call, written inside a
// generic body instead of at a literal call site, cannot be rewritten the
// way #5054's own call sites are. Auto-deriving the mapper the way
// `db.find<User>()` implies would need a SECOND compiler pass shaped like
// checksqlrow.bit/checksqlrowbuild.bit's, reusing `sqlClassSiteOf`,
// `buildSqlRowClass`, `synthSqlRowMapper` and `injectSqlRowMapperDecls`
// (compiler/checksqlrow.bit, compiler/checksqlrowbuild.bit — all already
// shaped to accept an arbitrary call site, not tied to std/sql's own three
// names) retargeted at `find<T>`'s call shape and wired into
// `injectSynthMembers` (compiler/synthtext.bit). That is real, buildable
// work — flagged here rather than filed, same as #5056's `@table("...")`
// gap and #5065's `E0050` gap — and NOT attempted in this delivery: it
// touches the same shared, heavily-relied-on synthesis pipeline every other
// landed ORM feature runs through, and getting it wrong there is a
// regression risk this ticket's own scope does not need to take. Until it
// lands, the caller supplies `table`, `fields` (`T{}.tableDescriptor()`,
// #5051) and `mapper` once per entity, at the one call site where `T` truly
// is a literal. This is still true after #5320.
//
// #5320 (fixed): `Query<T>` is constructed via a generic function (`find<T>`)
// rather than a literal `Query<Widget>{...}`, and its `T` was thereby reached
// with a separate, degenerate `typeInsts` entry — `T` still `find`'s own
// unbound parameter, never a value any running program holds —
// `lowerMethodInstances`/`recordMethodInstanceCalls` (compiler/lowerdriver.bit)
// walked it exactly like a real receiver instantiation and asked
// `sqlFindMany<T>` to resolve against a TypeParam nothing ever instantiates
// (`error[E0092]`). `typeInstArgsConcrete` (compiler/lowerprim.bit) now skips
// that entry, so `all`/`one`/`oneOrFail` below call stdlib/sql/row.bit's
// `sqlFindMany`/`sqlFindOne`/`sqlFindOneOrFail` directly.
//
// SECURITY IS THE POINT (#5057's own label). A column name reaching SQL
// unchecked is an injection vector. `where`/`whereIn`/`whereNull`/
// `whereLike`/`orderBy` take a Bit FIELD name, never raw SQL text:
// `compiler/checkormquery.bit` rejects a STRING-LITERAL column that is not
// one of `T`'s declared fields, naming the field and the class, at the
// exact call chain rooted at `find<T>(...)`. A column reached any other way
// (a variable, a chain that does not start at `find<T>`) falls back to the
// RUNTIME check `columnFor` below always performs — never silently
// concatenated into SQL text either way. Every VALUE is a `Value`, carried
// to `Executor.query`/`exec` as a separate, numbered `$n` argument
// (stdlib/sql/sql.bit's own header) — nothing in this file ever builds SQL
// text by pasting a caller's value into it.
//
// ONE() AND ONEORFAIL() ALWAYS CARRY A LIMIT. `boundedSql` never emits a
// bare, unbounded SELECT for either: it raises the query's own LIMIT to (at
// least) 2 when none smaller is already set, exactly wide enough for
// `sqlFindOne`/`sqlFindOneOrFail` (stdlib/sql/row.bit) to see a second
// matching row and refuse it, rather than silently returning the first
// (constraint on #5057).
//
// `.forUpdate(opts)` (#5383) CONTINUES THE CHAIN INTO ROW LOCKING
// (`pkg/orm/lock.bit`), ONE LINE DELEGATING TO THE FREE FUNCTION OF THE SAME
// NAME THERE, WHICH DOES THE REAL WORK — `LockedQuery<T>` itself is declared
// in `lock.bit`, beside the rest of row locking (`LockOpts`, `LockError`,
// `requireTx`, `lockClause`, `mysqlLockClause`). A method here and a free
// function there sharing this exact spelling do NOT collide: E0042 is a
// flat-namespace check, and SPEC §10.4 draws `method_decl` as its own
// grammar production, declared inside the class body —
// `compiler/resolvecollect.bit`'s `rCollectTopDecl` states outright that a
// receiver method "do[es] not join the flat namespace... reached via
// `recv.name(...)`, never a bare scope lookup." `stdlib/sql/pool.bit`'s
// `Pool.txValue<T>` already does exactly this same-name delegation.

import { SqlRowCause, SqlRowError, sqlFindMany, sqlFindOne, sqlFindOneOrFail, sqlReqInt } from "std/sql"
import { join } from "std/strings"

// Sort direction for `orderBy`.
export enum Dir { Asc, Desc }

// A chain builder over `T`'s table. Every method but the six terminals
// (`all`/`one`/`oneOrFail`/`count`/`exists`) returns `this`, already
// mutated, so a caller may chain fluently or hold the builder in a
// variable and add to it later — see this file's header for what each
// terminal executes.
export class Query<T> {
  db: Data
  table: string
  fields: []FieldDesc
  mapper: (Rows) => T!
  wheres: []string
  args: []Value
  orderBys: []string
  limitN: int
  hasLimit: bool
  offsetN: int
  hasOffset: bool
  // The Bit field name and direction behind each `orderBys` entry, in the
  // same order — `after()`, below, reads the first one for keyset
  // pagination (#5072); see `keyset.bit`'s header for why.
  orderByFields: []string
  orderByDirs: []Dir
  relations: map<string, RelationLoader<T>>
  withKeys: []string
  export where(
    column: string,
    val: Value,
  ): Query< // `column = $n`, `val` bound as the n-th positional argument.
    T,
  > {
    let col = this.columnFor(column)
    this.args = append(this.args, val)
    this.wheres = append(this.wheres, "${col} = $${len(this.args)}")
    return this
  }
  export whereLike(
    column: string,
    pattern: Value,
  ): Query< // `column like $n`. Still a bound argument — the pattern's `%`/`_`
    // wildcards are the caller's own text, never SQL syntax this file writes.
    T,
  > {
    let col = this.columnFor(column)
    this.args = append(this.args, pattern)
    this.wheres = append(this.wheres, "${col} like $${len(this.args)}")
    return this
  }
  export whereIn(
    column: string,
    vals: []Value,
  ): Query< // `column in ($n, $n+1, ...)`, one bound argument per value. An empty
    // `vals` emits `1 = 0` rather than `in ()`, which several dialects reject
    // outright — "matches nothing" is what an empty set of choices means.
    T,
  > {
    let col = this.columnFor(column)
    if (len(vals) == 0) {
      this.wheres = append(this.wheres, "1 = 0")
      return this
    }
    let marks = []string(0)
    for v of vals {
      this.args = append(this.args, v)
      marks = append(marks, "$${len(this.args)}")
    }
    let list = join(marks, ", ")
    this.wheres = append(this.wheres, "${col} in (${list})")
    return this
  }
  export whereNull(column: string): Query< // `column is null`. Takes no value — NULL is never a bound parameter.
    T,
  > {
    let col = this.columnFor(column)
    this.wheres = append(this.wheres, "${col} is null")
    return this
  }
  export whereRaw(
    fragment: string,
    ...args: Value,
  ): Query< // A raw SQL predicate plus its own bound arguments — the one escape
    // hatch where/whereIn/whereNull/whereLike (above) cannot reach: a
    // window function, a lateral join, a CTE, a `tsvector` match.
    // `fragment`'s own `$n` placeholders are written LOCAL to this call, so
    // `whereRaw("lower(email) = lower($1)", e)` reads exactly as written —
    // `pkg/orm/raw.bit` renumbers them to their true position in the
    // assembled query and panics if the placeholder count and argument
    // count disagree. See that file's header for what makes this safe and
    // why `raw` stays in this method's name.
    T,
  > {
    checkRawArgCount(fragment, len(args))
    let offset = len(this.args)
    for v of args {
      this.args = append(this.args, v)
    }
    this.wheres = append(this.wheres, renumberPlaceholders(fragment, offset))
    return this
  }
  export orderByField(
    field: string,
    dir: Dir,
  ): Query< // The identifier-allowlist counterpart to `whereRaw`: `field` may come
    // from outside the program (a sortable table header) and is resolved
    // against `T`'s own descriptor rather than escaped or quoted — see
    // `pkg/orm/raw.bit`'s header for why. FAILS rather than panics: a
    // caller's handler must be able to turn a rejected field into a 400,
    // never let it crash the process.
    T,
  >! {
    let col = allowedColumn(this.fields, this.table, field)?
    let word = "asc"
    if (dir == Dir.Desc) {
      word = "desc"
    }
    this.orderBys = append(this.orderBys, "${col} ${word}")
    this.orderByFields = append(this.orderByFields, field)
    this.orderByDirs = append(this.orderByDirs, dir)
    return this
  }
  export orderByRaw(
    fragment: string,
  ): Query< // A raw ORDER BY expression - the escape hatch for a `case`, `NULLS
    // LAST`, an ordinal, or a window function's output, none of which
    // `orderBy`/`orderByField` (above) can express. Unlike `whereRaw`,
    // this takes NO argument list: ORDER BY has no bound-value form, so a
    // placeholder in `fragment` could never be filled and is refused
    // rather than silently accepted - see `pkg/orm/raw.bit`'s header for
    // why that asymmetry with `whereRaw` is deliberate. Composes with
    // `orderBy`/`orderByField` in call order, same as every other builder
    // method; does not participate in `after()`'s keyset pagination
    // (`keyset.bit`), which reads only the FIRST `orderBy`/`orderByField`
    // call's own field and direction.
    T,
  > {
    checkNoPlaceholder(fragment)
    this.orderBys = append(this.orderBys, fragment)
    return this
  }
  export orderBy(column: string, dir: Dir): Query<T> {
    let col = this.columnFor(column)
    let word = "asc"
    if (dir == Dir.Desc) {
      word = "desc"
    }
    this.orderBys = append(this.orderBys, "${col} ${word}")
    this.orderByFields = append(this.orderByFields, column)
    this.orderByDirs = append(this.orderByDirs, dir)
    return this
  }
  export limit(n: int): Query<T> {
    this.limitN = n
    this.hasLimit = true
    return this
  }
  export offset(n: int): Query<T> {
    this.offsetN = n
    this.hasOffset = true
    return this
  }
  export with(
    name: string,
  ): Query< // Requests eager loading of a relation registered on this query
    // (`pkg/orm/relation.bit`'s `withRelations`) — recorded, never loaded here.
    // `all()` runs each requested relation's own `RelationLoader` exactly once,
    // in request order, after the parent rows are back. An unregistered name
    // panics naming it and the table, the same category `columnFor` panics for
    // — a caller bug, not a recoverable condition.
    T,
  > {
    let (_, ok) = this.relations[name]
    if (!ok) {
      panic("pkg/orm: '${name}' is not a registered relation for '${this.table}'")
    }
    this.withKeys = append(this.withKeys, name)
    return this
  }
  export all(): []T! { // Every matching row, mapped into `T` (stdlib/sql/row.bit's `sqlFindMany<T>`,
    // reachable from here since #5320), then every relation `with()` requested,
    // each loader running its own bounded, chunked query set against the
    // already-fetched parent rows — never one query per row (#5061).
    let out = sqlFindMany(this.db, this.selectSql(), this.args, this.mapper)?
    for name of this.withKeys {
      this.relations[name](this.db, out)?
    }
    return out
  }
  export one(): Option< // At most one row — `None` for zero, `SqlRowCause.TooManyRows` for more
    // than one, never the first of several silently (`sqlFindOne<T>`; see
    // this file's header for `boundedSql`, which enforces that bound).
    T,
  >! {
    return sqlFindOne(this.db, this.boundedSql(), this.args, this.mapper)?
  }
  export oneOrFail(): T! { // Exactly one row, or an error distinguishing `SqlRowCause.NoRows` from
    // `TooManyRows` (`sqlFindOneOrFail<T>`).
    return sqlFindOneOrFail(this.db, this.boundedSql(), this.args, this.mapper)?
  }
  export count(): i64! { // The row count matching every `where`/`whereIn`/`whereNull`/`whereLike`
    // clause so far — `orderBy`/`limit`/`offset` do not affect a count and are
    // not applied.
    let rows = this.db.query("select count(*) as n from ${this.table}${this.whereSql()}", this.args)?
    defer rows.close()
    rows.next()?
    return sqlReqInt(rows, rows.columns(), "n")?
  }
  export exists(): bool! { // Whether any row matches — `select 1 ... limit 1`, the cheapest query
    // that answers yes/no without counting or mapping a row.
    let sql = "select 1 from ${this.table}${this.whereSql()} limit 1"
    let rows = this.db.query(sql, this.args)?
    defer rows.close()
    return rows.next()?
  }
  export after(
    val: Value,
  ): Query< // Keyset pagination (#5072, `keyset.bit`): carries `val`, the previous
    // page's last row on the column the first `orderBy()` call named, and
    // adds `WHERE <col> > $n` (or `<` for a descending order) instead of an
    // `OFFSET` — see `keyset.bit`'s header for why this returns `Query<T>!`
    // and must be `?`-propagated, unlike every other builder method here.
    T,
  >! {
    let (col, op) = keysetPredicate(this.table, this.fields, this.orderByFields, this.orderByDirs)?
    this.args = append(this.args, val)
    this.wheres = append(this.wheres, "${col} ${op} $${len(this.args)}")
    return this
  }
  export forUpdate(
    opts: LockOpts,
    dialect: ServerDialect,
  ): LockedQuery< // Continues the chain into row locking (`pkg/orm/lock.bit`, #5083/#5383)
    // instead of making the caller wrap the built query — one line
    // delegating to the free function of the identical name there (legal;
    // see this file's header), which does the real work. `dialect` is
    // required and forwarded unchanged — see lock.bit's header (#5391) for
    // why `forUpdate` cannot default it; `ServerDialect` (`pkg/orm/data.bit`,
    // #5384) is the package-wide shape lock.bit's own header explains.
    T,
  > {
    return forUpdate<T>(this, opts, dialect)
  }
  columnFor( // `field`'s SQL column, validated against `T`'s own descriptor at RUNTIME
    // — the fallback for a column name the compiler could not check because it
    // was not a string literal at the call (this file's header, and
    // compiler/checkormquery.bit's own header). A field that does not exist is
    // a caller bug, not a recoverable condition, so this panics naming both —
    // the same category #5053's unloaded-relation panic takes.
    field: string,
  ): string {
    for f of this.fields {
      if (f.name == field) {
        return columnName(f)
      }
    }
    panic("pkg/orm: '${field}' is not a field of the class mapped to '${this.table}'")
  }
  whereSql(): string {
    if (len(this.wheres) == 0) {
      return ""
    }
    return " where " + join(this.wheres, " and ")
  }
  selectSql(): string { // The SQL every terminal but `one`/`oneOrFail` runs: `select * from
    // <table>`, `where`, `order by`, `limit`, `offset`, in that order, each
    // omitted when unset.
    return this.buildSql(this.hasLimit, this.limitN)
  }
  boundedSql(): string { // `selectSql`, but with `hasLimit`/`limitN` forced to at least (LIMIT 2,
    // has-limit) when the caller set none smaller — see this file's header.
    if (this.hasLimit && this.limitN <= 2) {
      return this.buildSql(this.hasLimit, this.limitN)
    }
    return this.buildSql(true, 2)
  }
  buildSql(hasLimit: bool, limitN: int): string {
    let sql = "select * from ${this.table}" + this.whereSql()
    if (len(this.orderBys) != 0) {
      sql = sql + " order by " + join(this.orderBys, ", ")
    }
    if (hasLimit) {
      sql = sql + " limit ${limitN}"
    }
    if (this.hasOffset) {
      sql = sql + " offset ${this.offsetN}"
    }
    return sql
  }
}

// The one entry point (`compiler/checkormquery.bit` recognises `<T>` written
// explicitly here, exactly as `find<T>`/`findOne<T>`/`findOneOrFail<T>`
// (stdlib/sql/row.bit) are recognised by `compiler/checksqlrow.bit`): starts
// an empty `Query<T>` against `table`, validating a later literal column
// against `fields` and mapping every row through `mapper`. See this file's
// header for why these three are explicit rather than derived.
export fn find<T>(db: Data, table: string, fields: []FieldDesc, mapper: (Rows) => T!): Query<T> {
  return Query<T>{
    db = db, table = table, fields = fields, mapper = mapper, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false,
    orderByFields = []string(0), orderByDirs = []Dir(0),
    relations = map<string, RelationLoader<T>>(0), withKeys = []string(0),
  }
}
