// pkg/orm/query.bit — `Dir`, the sort direction shared by `Repo<T>.orderBy`
// (pkg/orm/repo.bit) and every dialect's own ORDER BY rendering. The old
// hand-built chain builder this file used to declare (#5057) is retired
// (#6296): every feature it offered now lives on `Repo<T>`/`TxRepo<T>`
// (`db.table<T>()`/`tx.table<T>()`, pkg/orm/db.bit).
//
// `join` (std/strings)/`sqlReqInt` (std/sql) stay imported here — this
// file's canonical site (#5589-shaped: SPEC §17.1's flat namespace carries
// both to every sibling that uses them unqualified, `compositekey.bit`'s
// `keyFieldNames`/`manytomany.bit`'s `sqlReqInt` call among them) — even
// though this file's own remaining code, `Dir`, needs neither.
import { sqlReqInt } from "std/sql"
import { join } from "std/strings"

// Sort direction for `orderBy`.
export enum Dir { Asc, Desc }
