// pkg/orm/scoped.bit — the three handles a guarded `Db` hands out
// (#7035, epic #6984, design D6): `db.as(subject)` for a request,
// `db.asSystem()` for a job, and the loud failure of the plain
// `db.table<T>()` on a table the guard protects.
//
// A plain `db.table<T>()` on a protected table is a developer mistake: the
// query would run with no actor, so either nothing is checked or everything
// is refused for a reason nobody can read. It returns a `Repo<T>` preset to
// fail every terminal call (`Repo.checkErr`, repo.bit) with `Unscoped`,
// the #6269 shape: no panic, and the chain methods stay infallible. The
// failure is a class of its own rather than an `errText` string because a
// caller must be able to tell "you forgot `db.as`" from a driver error;
// `status()` is 500, so `pkg/web` reports it as a server fault and never as
// a client error.
//
// `ScopedDb.table<T>()` and `SystemDb.table<T>()` build their repositories
// with `openRepo`, which never presets `Unscoped`. The scoped repository's
// reads and writes are later tickets; this file only holds what they need.
// A `Db` with no guard never presets anything, so an unguarded program is
// untouched.

// A table the guard protects was reached through a handle that names no
// actor. `status()` is 500 on purpose, see this file's header.
export class Unscoped {
  export table: string

  export message(): string {
    return "orm: table '${this.table}' is protected by authz; use db.as(subject) or db.asSystem()"
  }

  export status(): int {
    return 500
  }
}

// One `Repo<T>` over `db` with `guard` carried, no `Unscoped` preset. The
// single place a repository is built, so `Db`, `TxHandle`, `ScopedDb` and
// `SystemDb` cannot drift in what they copy.
fn openRepo<T: Tabled>(db: Data, dialect: ServerDialect, guard: Option<Guard>): Repo<T> {
  return Repo<T>{ db = db, dialect = dialect, guard = guard }
}

// What `Db.table` and `TxHandle.table` hand back: `openRepo`, preset to
// `Unscoped` when `guard` protects `T`'s table.
fn plainRepo<T: Tabled>(db: Data, dialect: ServerDialect, guard: Option<Guard>): Repo<T> {
  let r = openRepo<T>(db, dialect, guard)
  match (guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        r.unscoped = T.__tableName()
      }
    }
    None => {}
  }
  return r
}

// What `db.as(subject)` and `db.asGuest()` return. `actor` is `None` for a
// guest: guests are still checked (design D10), they just have no id.
// `tenant` is the empty string when the caller names none.
export class ScopedDb {
  db: Db
  actor: Option<Actor>
  tenant: string

  export table<T: Tabled>(): ScopedRepo<T> {
    let inner = openRepo<T>(this.db.pool, this.db.dialect, this.db.guard)
    return ScopedRepo<T>{
      inner = inner,
      guard = this.db.guard,
      actor = this.actor,
      tenant = this.tenant,
    }
  }
}

// The repository `ScopedDb.table<T>()` returns: the plain `Repo<T>`, the
// guard and the actor every checked read and write needs. The read chain
// has `Repo<T>`'s own signatures and every terminal call narrows by the
// guard's filter (#7036, bodies in `pkg/orm/scopedread.bit`); the write
// methods are added by the tickets that follow.
export class ScopedRepo<T: Tabled> {
  inner: Repo<T>
  guard: Option<Guard>
  actor: Option<Actor>
  tenant: string

  export where(column: string, val: Value): ScopedRepo<T> {
    return scopedWith<T>(this, this.inner.where(column, val))
  }

  export orderBy(column: string, dir: Dir = Dir.Asc): ScopedRepo<T> {
    return scopedWith<T>(this, this.inner.orderBy(column, dir))
  }

  export limit(n: int): ScopedRepo<T> {
    return scopedWith<T>(this, this.inner.limit(n))
  }

  export offset(n: int): ScopedRepo<T> {
    return scopedWith<T>(this, this.inner.offset(n))
  }

  export after(key: Value): ScopedRepo<T> {
    return scopedWith<T>(this, this.inner.after(key))
  }

  export withDeleted(): ScopedRepo<T> {
    return scopedWith<T>(this, this.inner.withDeleted())
  }

  export all(): []T! {
    return scopedAll<T>(this)?
  }

  export first(): Option<T>! {
    return scopedFirst<T>(this)?
  }

  export count(): int! {
    return scopedCount<T>(this)?
  }

  export find(id: Value): T! {
    return scopedFind<T>(this, id)?
  }
}

// What `db.asSystem()` returns: today's unguarded repositories, for jobs and
// migrations that act for no user. Each `table<T>()` is logged at debug when
// the `Db` has a logger (`Options.logger`), so system access can be audited.
export class SystemDb {
  db: Db

  export table<T: Tabled>(): Repo<T> {
    match (this.db.logger) {
      Some(l) => l.debug("orm: system access to ${T.__tableName()}")
      None => {}
    }
    return openRepo<T>(this.db.pool, this.db.dialect, Option.None)
  }
}
