// pkg/orm/relation.bit — `RelationLoader<T>`, the closure shape a compiled
// `T.__loadRelation` runs to eager-load one `@hasMany`/`@hasOne`/
// `@belongsTo` field (`pkg/orm/relationload.bit`'s `dispatchLoadRelation`,
// `hasManyRelation`/`hasOneRelation`/`belongsToRelation`). The old chain
// builders and the explicit loader-registration function this file used to
// declare (#5061), typed over pkg/orm's now-retired hand-built find chain,
// are gone (#6296) — `Repo<T>.with(name)` (pkg/orm/reporelations.bit)
// reaches the same loaders through the compiler-synthesized dispatch
// instead of a caller-registered map.
//
// `concat` (std/seq) stays imported here — this file's canonical site
// (SPEC §17.1's flat namespace), reused unqualified by
// `pkg/orm/manytomany.bit`/`pkg/orm/relationload.bit`.
import { concat } from "std/seq"

// What `Repo<T>.with(name)` (via the compiler-synthesized `__loadRelation`)
// runs once the parent rows are back: given the already-fetched parents,
// load and assign one relation's data. The third parameter is the REST of a
// dotted `.with("author.posts")` path past this relation's own segment
// (#6318) — "" when this was the last (or only) segment, `dispatchLoadRelation`
// (pkg/orm/relationload.bit) peels one segment off at a time. A loader whose
// own target type carries no further loadable relations (`pkg/orm/manytomany.bit`'s
// own `manyToManyLoader`, whose `TChild` is not `Tabled`-bounded) simply
// never reads this parameter.
export type RelationLoader<T> = (Data, []T, string) => ()!

// The most foreign-key values a single `IN (...)` list carries — a larger
// set is chunked instead. Reused unqualified by
// `pkg/orm/manytomany.bit`'s own `fetchManyToMany`.
const maxRelationChunk: int = 1000

// Splits `ids` into chunks of at most `size` elements, preserving order —
// `ceil(len(ids) / size)` chunks, the last one short unless `len(ids)` is an
// exact multiple. Reused unqualified by `pkg/orm/manytomany.bit`.
fn chunkI64(ids: []i64, size: int): [][]i64 {
  let out = [][]i64(0)
  let i = 0
  while (i < len(ids)) {
    let end = i + size
    if (end > len(ids)) {
      end = len(ids)
    }
    out = append(out, ids[i:end])
    i = end
  }
  return out
}

fn i64Values(ids: []i64): []Value {
  let out = []Value(0)
  for id of ids {
    out = append(out, Value.Int(id))
  }
  return out
}
