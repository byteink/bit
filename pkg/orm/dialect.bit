// pkg/orm/dialect.bit — the dialect interface (#5066): renders a #5065
// SchemaOp intent tree into one engine's own DDL. `pkg/orm/postgres.bit`'s
// `Postgres` is the first implementation; #5067's MySQL is a sibling.
// Nothing in schema.bit or this file may know a dialect's own keywords —
// see schema.bit's own header.
//
// NAMED `Dialect` (#5325). It was `SchemaDialect` at first, because
// `pkg/orm/write.bit` (#5058) already exported `enum Dialect { Postgres,
// Mysql }` - a two-value tag `upsert` switches on to pick `ON CONFLICT`
// vs `ON DUPLICATE KEY UPDATE` syntax, and two top-level exports named
// `Dialect` in one package is `duplicate_declaration`/E0042. #5325 decided
// against folding that enum in here: this interface's one method renders
// a whole `SchemaOp` tree, so taking it would force `upsert` to depend on
// a full DDL renderer (and, since only `Postgres` implements one today,
// would block a MySQL upsert on unrelated schema work) just to express a
// two-value syntax choice. The narrower type moved instead - it is now
// `pkg/orm/write.bit`'s `UpsertDialect` - freeing this name for the
// concept `pkg/orm/schema.bit` and `pkg/orm/errors.bit` already call
// "Dialect" in prose.

// One statement a `Dialect` renders a `SchemaOp` into. A single
// `SchemaOp` can render to more than one `Statement` — a `CreateTable`
// yields its own `CREATE TABLE`, then one `CREATE INDEX` per `t.index()`,
// then each `raw()` passthrough — because a mixed transactional /
// non-transactional batch needs each statement flagged on its own.
// `transactional` is `false` only for a statement a dialect itself cannot
// run inside a transaction — on Postgres that is exactly a `raw()` whose
// text names `CREATE INDEX CONCURRENTLY` (schema.bit has no builder that
// produces one any other way). The runner (#5069) must run a `false`
// statement outside any wrapping transaction rather than failing at run
// time.
export class Statement {
  export sql: string,
  export transactional: bool,
}

// Renders one #5065 `SchemaOp` into the statements needed to apply it on
// one database engine, in the order they must run.
export interface Dialect {
  render(op: SchemaOp): []Statement,
}
