// pkg/orm/generate.bit — migrate generate (#5067, owner decision
// 2026-09-12): "you never hand-write a migration." Reads the live schema
// from information_schema, reads each entity's #5051 descriptor, diffs
// them, and writes a NUMBERED FILE of schema-builder (#5065) calls for a
// human to review and commit. `generate` never applies anything — running
// a migration is #5069's job, unstarted.
//
//   orm.generate(db, [User{}, Order{}], "add_user_phone")?
//     -> writes migrations/0007_add_user_phone.bit
//
// FIVE RULES THIS FILE ENFORCES, EVERY ONE OF THEM "DO NOT GUESS":
//
// 1. A RENAME IS NEVER INFERRED. There is no code path here that detects a
//    rename at all — a column the entity has and the database does not,
//    and a column the database has and the entity does not, are always two
//    independent findings: an addColumn and a dropColumn. A diff cannot
//    tell a rename from a delete-and-create, and guessing destroys the
//    dropped column's data (schema.bit's own header cites TypeORM getting
//    exactly this wrong). When both land on the same table in one pass,
//    the drop's comment names the columns the same pass added, so the
//    reviewer can edit the two calls into one `renameColumn(...)` — see
//    `destructiveComment` below — but this file itself never does.
//
// 2. THIS NEVER APPLIES ANYTHING. `generate`/`generateInto` write a `.bit`
//    file and return a message; nothing here opens a transaction or runs
//    a statement against `db` beyond the read-only `information_schema`
//    query that builds the diff.
//
// 3. ENTITIES ARE AN EXPLICIT ARGUMENT. Bit has no reflection, so nothing
//    here enumerates "every @table class" — the caller's own list is the
//    source of truth, the same shape #5061's `with()` relation map uses.
//
// 4. AN EMPTY DIFF WRITES NOTHING. `generateInto` returns a message
//    instead of writing a file when every entity already matches; a
//    migrations directory full of empty files is how people stop reading
//    them.
//
// 5. A DESTRUCTIVE CHANGE IS EMITTED, NEVER OMITTED, with a comment
//    naming it destructive. `dropColumn` is the only destructive op this
//    file emits against an ENTITY table — there is no dropTable path for
//    one; an entity table's own removal is a hand-written decision, never a
//    diff's. The one exception is a `@manyToMany` join table (#5390): its
//    `down()` companion function drops it, because #5081's own decision
//    makes the ORM its owner, not a human — see `manyToManyDescsFor` below.
//
// A COMPOSITE-KEY ENTITY (#5084, more than one `@id` field) NEVER GETS TWO
// AUTO-INCREMENT COLUMNS (#5395, #5397). `AlterTable.primaryKey` (schema.bit,
// #5397) gave `alter()` a way to say "the primary key of this table is
// these columns" that #5395 found missing, so this file no longer refuses a
// composite-key entity - it emits that call instead. `hasCompositeKey`
// below (this file's own count, not `pkg/orm/compositekey.bit`'s
// `keyFields` - that one panics for zero `@id` fields, a case `generate`
// has never required an entity to avoid) still decides two things: whether
// `addColumnCall` maps an `@id` i64 field to `t.addId(...)` (auto-
// increment) or `t.addInt(...)` (plain), and whether `renderAlterBlock`
// appends a `t.primaryKey(...)` call at all.
//
// EVERY `@id` FIELD OF A COMPOSITE KEY BECOMES `t.addInt(...)`, NEVER
// `t.addId(...)`. `pkg/orm/compositekey.bit`'s own `validateCompositeKey`
// caps a composite key at one database-generated column, and this file has
// no honest way to pick WHICH `@id` field of an entity's descriptor should
// be that one column - a wrong guess ships a migration whose key means
// something different from the one the reviewer read (this file's own
// closing header paragraph). `docs/schema.md`'s own composite-key example
// (`Membership{ @id userId, @id teamId }`) is a natural key with no
// database-generated member at all, the ordinary shape a composite key
// takes; a table that genuinely wants one generated column still compiles,
// it just needs the reviewer to change one `t.addInt(...)` to `t.addId(...)`
// by hand, the same review step rule 1 already expects for a rename.
//
// `t.primaryKey(...)` NAMES THE WHOLE KEY, NOT ONLY THE COLUMNS THIS DIFF
// ADDS. `idColumnNames` below reads every `@id` field off the entity's full
// descriptor, so a migration that adds one new key column to a table whose
// other key column already exists live still emits the complete
// `t.primaryKey(...)` call `AlterTable.primaryKey`'s own header requires.
// This call is emitted only when the diff adds at least one `@id` column
// (`hasIdField(added)`) - a diff that never touches one, the ordinary case
// once a composite key already exists live, leaves the key untouched, the
// same as before #5397.
//
// MYSQL RENDERS THIS MIGRATION TOO, BECAUSE `generate` ASSERTS WHICH CASE
// APPLIES (#5400). `generate` writes dialect-agnostic schema-builder source
// (this file's own header, "WHY A NAME READ FROM information_schema..."
// paragraph) - it never picks a `Dialect` and never renders DDL. But
// `mysql.bit`'s own `mysqlAlterOpStatement` cannot safely express "set the
// primary key" from one op alone (MySQL's `DROP PRIMARY KEY` has no `IF
// EXISTS` - mysql.bit's own header). `hasLivePrimaryKey` below reads the
// live `information_schema.table_constraints` - the one live-schema
// question `SchemaOp` itself deliberately never carries (schema.bit's own
// header) - and `primaryKeyCallLine` below emits `t.primaryKey(...)`
// (`AlterOp.SetPrimaryKey`, asserting no key exists yet) or
// `t.replacePrimaryKey(...)` (`AlterOp.ReplacePrimaryKey`, asserting one
// already does) accordingly. Postgres renders both ops identically
// (`postgres.bit`'s own `setPrimaryKeyStatement`), so this assertion only
// changes MySQL's own output.
//
// THE TABLE-NAME GAP, FLAGGED RATHER THAN GUESSED. `naming.bit`'s
// `tableName` falls back to pluralizing the CLASS NAME when `@table`
// carries no override, and a class name is exactly what no `@table` class
// exposes without reflection: `tableDescriptor()`/`tableAttrs()` (#5051,
// #5189) are the only two members `@table` synthesizes, and neither
// carries the class's own name as data. So every entity passed to
// `generate` MUST carry an explicit `@table("name")`; one that does not
// fails loudly (`tableNameOf` below), rather than this file guessing a
// pluralized name it has no way to check against the class it came from.
//
// WHY A NAME READ FROM information_schema NEVER BREAKS OUT OF THE
// GENERATED SOURCE. This file writes Bit SOURCE, not DDL — every table or
// column name it read from the live database or a descriptor becomes a
// Bit STRING LITERAL inside a `.bit` file, never SQL text a driver runs
// (#5066's identifier-escaping rule is about rendering a SchemaOp to DDL,
// a step this file never takes). A name still has to reach that string
// literal safely: Bit's double-quoted string interpolates `${...}`
// unconditionally (SPEC §5.7), so a column literally named `${panic()}`
// would need only `\` and `"` escaped to become a live expression inside
// the file this generator writes. `bitStringLiteral` below additionally
// escapes every literal `$`, and a `//` comment naming a hostile column
// gets its own narrower guard (`commentSafe`) against a newline splitting
// one comment into a comment line plus a line of live Bit source.
import { asText } from "std/sql"
import { isDir, mkdir, readDir, writeFile } from "std/fs"
import { join as pathJoin } from "std/path"
import { padStart, parseInt, split } from "std/strings"

// Anything `generate` can read a descriptor off: exactly the two members
// `@table` synthesizes (#5051, #5189). A concrete `@table` class satisfies
// this structurally (SPEC §14.3) with no declared `implements` — the same
// way `Executor` (`data.bit`) is satisfied by a `Pool` or a transaction
// handle — which is what lets `[User{}, Order{}]` convert to `[]TableEntity`
// element-by-element at the call site (SPEC §12.3's bare-literal rule).
export interface TableEntity {
  tableDescriptor(): []FieldDesc,
  tableAttrs(): []AttrDesc,
}

// Where `generate` writes, relative to the caller's own cwd — a real
// project's migration directory. `generateInto` takes the directory
// explicitly instead, so this file's own tests can point it at a scratch
// directory without touching a real one.
const migrationsDir: string = "migrations"

// Diffs `entities` against the live schema and writes a numbered file
// under "migrations", or returns without writing one if nothing differs.
// See this file's header for the five rules this enforces.
export fn generate(db: Data, entities: []TableEntity, name: string): string! {
  return generateInto(db, entities, name, migrationsDir)?
}

// `generate`, writing under `dir` instead of the hardcoded "migrations".
export fn generateInto(db: Data, entities: []TableEntity, name: string, dir: string): string! {
  let ops = []string(0)
  for e of entities {
    let table = tableNameOf(e)?
    let fields = withoutManyToMany(e.tableDescriptor())
    let liveCols = liveColumns(db, table)?
    let added = fieldsNotIn(fields, liveCols)
    let removed = colsNotInFields(liveCols, fields)
    if (len(added) == 0 && len(removed) == 0) {
      continue
    }
    let composite = hasCompositeKey(fields)
    let primaryKeyCall = ""
    if (composite && hasIdField(added)) {
      let replacing = hasLivePrimaryKey(db, table)?
      primaryKeyCall = primaryKeyCallLine(fields, replacing)
    }
    ops = append(ops, renderAlterBlock(table, added, removed, composite, primaryKeyCall)?)
  }
  let downOps = []string(0)
  for desc of manyToManyDescsFor(entities)? {
    let liveJoinCols = liveColumns(db, desc.joinTable)?
    if (len(liveJoinCols) > 0) {
      continue
    }
    ops = append(ops, renderJoinTableCreate(desc))
    downOps = append(downOps, renderJoinTableDrop(desc.joinTable))
  }
  if (len(ops) == 0) {
    return "pkg/orm: generate: schema already matches every entity given; nothing written"
  }
  if (!isDir(dir)) {
    mkdir(dir)?
  }
  let num = nextMigrationNumber(dir)?
  let fileName = "${padStart("${num}", 4, "0")}_${name}.bit"
  let path = pathJoin(dir, fileName)
  writeFile(path, renderFile(name, ops, downOps))?
  return "pkg/orm: generate: wrote ${path}"
}

// The table name `e` was declared with — its own `@table("name")`
// override, and only that; see this file's header for why a default
// pluralized name is never guessed here.
fn tableNameOf(e: TableEntity): string! {
  let (v, found) = attrArg(e.tableAttrs(), "table")
  if (!found) {
    fail newError(
        "pkg/orm: generate: this entity has no explicit @table(\"name\") — " +
        "generate cannot derive a default table name without the class's " +
        "own name, which @table's synthesized members do not carry (Bit " +
        "has no reflection); add an explicit @table(\"...\") to the entity",
    )
  }
  return v
}

// The live column names of `table`, in ordinal order, read from
// information_schema.columns — LIVE, never cached (rule 4 above), because
// a migration diffed against a stale snapshot could re-drop a column
// another migration already added.
fn liveColumns(db: Data, table: string): []string! {
  let rows = db.query(
    "select column_name from information_schema.columns where table_name = $1 order by ordinal_position",
    [Value.Text(table)],
  )?
  defer rows.close()
  let out = []string(0)
  while (rows.next()?) {
    out = append(out, asText(rows.value(0))?)
  }
  return out
}

// Whether `table` already carries a primary key live, read once — the
// caller's own assertion `mysql.bit`'s renderer needs to pick a safe
// spelling (#5400, this file's header), because `SchemaOp` itself carries no
// live-schema state (schema.bit's own header). Read through the ANSI-
// standard `information_schema.table_constraints` view, same portability as
// `liveColumns`' own `information_schema.columns` — no dialect-specific
// query, since `generate` never picks a `Dialect` (this file's header).
fn hasLivePrimaryKey(db: Data, table: string): bool! {
  let rows = db.query(
    "select constraint_name from information_schema.table_constraints where table_name = $1 and constraint_type = 'PRIMARY KEY'",
    [Value.Text(table)],
  )?
  defer rows.close()
  return rows.next()?
}

// `fields`, excluding any carrying `@manyToMany` (#5390) — that field names
// a relation through a join table, never a column of THIS table, and
// `addColumnCall` below has no mapping for a `[]T` typeName (nor should it
// gain one): `manyToManyDescsFor`'s own pass, not this ordinary column
// diff, is what reads a `@manyToMany` field.
fn withoutManyToMany(fields: []FieldDesc): []FieldDesc {
  let out = []FieldDesc(0)
  for f of fields {
    let (_, found) = attrArg(f.attrs, "manyToMany")
    if (!found) {
      out = append(out, f)
    }
  }
  return out
}

// The fields of `fields` whose own column name (naming.bit's `columnName`
// — `@column("...")` if given, else snake_case) is absent from `liveCols`.
fn fieldsNotIn(fields: []FieldDesc, liveCols: []string): []FieldDesc {
  let out = []FieldDesc(0)
  for f of fields {
    if (!hasColumn(liveCols, columnName(f))) {
      out = append(out, f)
    }
  }
  return out
}

// True iff two or more of `fields` carry `@id` - a composite primary key
// (this file's header). Its own count rather than
// `pkg/orm/compositekey.bit`'s `keyFields`: that one panics naming the
// table for a class with zero `@id` fields at all, a case `generate` has
// never required an entity to avoid.
fn hasCompositeKey(fields: []FieldDesc): bool {
  let n = 0
  for f of fields {
    if (hasIdAttr(f)) {
      n = n + 1
      if (n >= 2) {
        return true
      }
    }
  }
  return false
}

// True iff any of `fields` carries `@id` - whether this diff's own `added`
// list would map through `addColumnCall` into a new `t.addId(...)`/
// `t.addInt(...)` call for a key column.
fn hasIdField(fields: []FieldDesc): bool {
  for f of fields {
    if (hasIdAttr(f)) {
      return true
    }
  }
  return false
}

// Every `@id` field's own column name, in declaration order - the FULL
// primary key `AlterTable.primaryKey` (schema.bit, #5397) needs, whether or
// not each of those columns is one this migration's own diff is adding
// (this file's header).
fn idColumnNames(fields: []FieldDesc): []string {
  let out = []string(0)
  for f of fields {
    if (hasIdAttr(f)) {
      out = append(out, columnName(f))
    }
  }
  return out
}

// Plain membership on a column-name list. Not `std/strings`' `contains`
// (substring on one `string`, already imported module-wide by
// `query.test.bit` and the wrong shape for a `[]string`) or `std/seq`'s
// `contains<T>` (a second import of the same name, E0042) — a five-line
// loop is cheaper than aliasing either import.
fn hasColumn(cols: []string, name: string): bool {
  for c of cols {
    if (c == name) {
      return true
    }
  }
  return false
}

// The live columns with no field in `fields` mapping to them —
// `naming.bit`'s own `fieldForColumn`, read the other direction.
fn colsNotInFields(liveCols: []string, fields: []FieldDesc): []string {
  let out = []string(0)
  for c of liveCols {
    if (fieldForColumn(fields, c) == "") {
      out = append(out, c)
    }
  }
  return out
}

fn columnNamesOf(fields: []FieldDesc): []string {
  let out = []string(0)
  for f of fields {
    out = append(out, columnName(f))
  }
  return out
}

// The default length `generate` gives a new `string` column — there is
// nowhere else to read one from: `@maxLen(...)` resolves to a callable
// validator (#5051) and is never recorded in the descriptor, so no length
// reaches this file at all. Documented here rather than hidden, the same
// way `schema.bit`'s own header flags its `t.string` gap.
const defaultStringLength: int = 255

// The Bit type name a field's descriptor carries -> the `AlterTable` "add"
// call to emit for it. A CLOSED mapping: an unmapped type fails loudly,
// naming the field, rather than guessing a schema column type it might be
// wrong about. `i64` additionally checks `@id` (`write.bit`'s own
// `hasIdAttr`, reused here) — an i64 field marked `@id` becomes an
// auto-increment `Id` column, UNLESS `composite` is true (this file's
// header on why a composite key never auto-picks one generated column), in
// which case it is a plain `Int` the same as any other i64; every
// non-`@id` i64 is always `Int`.
fn addColumnCall(f: FieldDesc, composite: bool): string! {
  let col = bitStringLiteral(columnName(f))
  if (f.typeName == "i64") {
    if (hasIdAttr(f) && !composite) {
      return "t.addId(${col})"
    }
    return "t.addInt(${col})"
  }
  if (f.typeName == "string") {
    return "t.addString(${col}, ${defaultStringLength})"
  }
  if (f.typeName == "bool") {
    return "t.addBool(${col})"
  }
  if (f.typeName == "decimal") {
    return "t.addDecimal(${col})"
  }
  fail newError(
      "pkg/orm: generate: field '${f.name}' has Bit type '${f.typeName}', " +
      "which this generator has no schema column mapping for — add it to " +
      "the migration file by hand instead of guessing one",
  )
}

// One table's `alter()` block as Bit source. `added`/`removed` are never
// both empty — the caller only reaches this when there is a diff.
// `added`'s own column names are recomputed once here (`columnNamesOf`,
// cheap and pure) for `destructiveComment`, instead of a sixth parameter -
// `bit lint`'s own parameter-count ceiling (`spec/LINT.md`) applies to this
// function too. `composite` picks `addColumnCall`'s `t.addId(...)`/
// `t.addInt(...)` split; `primaryKeyCall`, "" unless this diff adds an
// `@id` column of a composite-key entity (this file's header), is the whole
// `t.primaryKey(...)`/`t.replacePrimaryKey(...)` call text
// (`primaryKeyCallLine` below), written after every add and before any drop.
fn renderAlterBlock(
  table: string,
  added: []FieldDesc,
  removed: []string,
  composite: bool,
  primaryKeyCall: string,
): string! {
  let addedCols = columnNamesOf(added)
  let b = newBuilder()
  b.write("alter(${bitStringLiteral(table)}, (t) => {\n")
  for f of added {
    let call = addColumnCall(f, composite)?
    b.write("  ${call}\n")
  }
  if (primaryKeyCall != "") {
    b.write("  ${primaryKeyCall}\n")
  }
  for col of removed {
    b.write("  ${destructiveComment(col, addedCols)}\n")
    b.write("  t.dropColumn(${bitStringLiteral(col)})\n")
  }
  b.write("})")
  return b.toString()
}

// The `t.primaryKey(...)`/`t.replacePrimaryKey(...)` call to append to a
// migration's alter block (#5400) — `replacing` is `generate`'s own
// assertion, read live off `information_schema` (`hasLivePrimaryKey`
// above), that `mysql.bit`'s renderer needs to pick a safe MySQL spelling:
// `t.primaryKey` when the table's key does not exist yet (`AlterOp.
// SetPrimaryKey`), `t.replacePrimaryKey` when it already does (`AlterOp.
// ReplacePrimaryKey`). The caller only reaches this when the diff already
// established a primary-key call is needed (this file's header).
fn primaryKeyCallLine(fields: []FieldDesc, replacing: bool): string {
  let callName = "primaryKey"
  if (replacing) {
    callName = "replacePrimaryKey"
  }
  return "t.${callName}(${primaryKeyCallArgs(idColumnNames(fields))})"
}

// `cols`, each rendered as a Bit string literal and comma-joined —
// `t.primaryKey(...)`/`t.replacePrimaryKey(...)`'s own argument list
// (`primaryKeyCallLine` above).
fn primaryKeyCallArgs(cols: []string): string {
  let out = []string(0)
  for c of cols {
    out = append(out, bitStringLiteral(c))
  }
  return join(out, ", ")
}

// The comment above a `dropColumn` call: marks it destructive (rule 5),
// and — when this same table's diff also added a column in this pass —
// names both instead of guessing a rename (rule 1). The reviewer is the
// one who turns these two calls into a `renameColumn(...)` if that is
// what actually happened.
fn destructiveComment(col: string, addedCols: []string): string {
  let base = "// destructive: '${commentSafe(col)}' exists in the " +
    "database but not in the entity; dropping it deletes data"
  if (len(addedCols) == 0) {
    return base
  }
  return "${base} — this same diff adds ${joinedNames(addedCols)} to " +
    "this table; if this is a rename, edit these two calls into one " +
    "renameColumn(...) call instead"
}

fn joinedNames(names: []string): string {
  let out = []string(0)
  for n of names {
    out = append(out, "'${commentSafe(n)}'")
  }
  return join(out, ", ")
}

// Strips a newline/carriage return from `s` before it goes into a `//`
// comment this file writes. A column name is data, not something trusted
// to stay on one line — a literal newline inside a generated comment
// would let it inject a second line of live Bit source into the file
// instead of staying inert text.
fn commentSafe(s: string): string {
  return replace(replace(s, "\n", " "), "\r", " ")
}

// `s` as a Bit double-quoted string literal, safe against every one of
// its own escape mechanisms (SPEC §5.7): `\` and `"` first (the ordinary
// escapes), then every literal `$` (`\$` is what SPEC §5.7 names as the
// way to emit one) so a name like `${panic()}` cannot become a live
// interpolation in the file this function writes, then a literal newline
// — interpreted strings are single-line — as `\n`.
fn bitStringLiteral(s: string): string {
  let out = replace(s, "\\", "\\\\")
  out = replace(out, "\"", "\\\"")
  out = replace(out, "$", "\\$")
  out = replace(out, "\n", "\\n")
  return "\"${out}\""
}

// One `@manyToMany` field found while walking `entities` (#5390): the
// entity that declared it, the join table its own attribute names, and the
// class name it points at — read off the field's own recorded `typeName`
// (e.g. `"[]Role"`), never off a type parameter's own attributes, which
// `generate` cannot see (this file's header, same "no reflection" gap
// `pkg/orm/foreignkey.bit`'s `RelationTarget` exists for). `entity` is kept
// so `manyToManyDescFrom` can read ITS OWN `tableDescriptor()`/
// `tableAttrs()` once the other side of the pair is found — both sides
// must already be in `entities` for `generate` to build the relation at
// all (rule 3, this file's header: entities are an explicit argument).
class mtmSide {
  entity: TableEntity,
  joinTable: string,
  pointsAtClass: string,
}

// The class name a `[]ClassName` field's own recorded `typeName` names, and
// whether `typeName` was slice-shaped at all — every `@manyToMany` field is
// declared `[]T` (#5081's own example).
fn sliceElementClassName(typeName: string): (string, bool) {
  if (len(typeName) < 3 || typeName[0:2] != "[]") {
    return ("", false)
  }
  return (typeName[2:len(typeName)], true)
}

// Every `@manyToMany` field across ALL `entities`, one `mtmSide` per field —
// gathered before any join table is built so a table named by two
// different entities' fields is recognised as ONE relation, never two
// independent findings (this file's own rule 1: a diff never guesses a
// relationship the compiler did not record explicitly on both sides).
fn manyToManySides(entities: []TableEntity): []mtmSide {
  let out = []mtmSide(0)
  for e of entities {
    for f of e.tableDescriptor() {
      let (joinTable, found) = attrArg(f.attrs, "manyToMany")
      if (!found) {
        continue
      }
      let (className, isSlice) = sliceElementClassName(f.typeName)
      if (!isSlice) {
        panic("pkg/orm: generate: '@manyToMany(\"${joinTable}\")' on field '${f.name}' is not a '[]T' field ('${f.typeName}')")
      }
      out = append(out, mtmSide{ entity: e, joinTable: joinTable, pointsAtClass: className })
    }
  }
  return out
}

// The `mtmSide`s of `sides` naming `joinTable` — `manyToManyDescsFor`'s own
// grouping step.
fn sidesNaming(sides: []mtmSide, joinTable: string): []mtmSide {
  let out = []mtmSide(0)
  for s of sides {
    if (s.joinTable == joinTable) {
      out = append(out, s)
    }
  }
  return out
}

// `fields`'s own single `@id` column name, or a failure naming `table` —
// `manyToManyDescFrom`'s own guard: `manyToManyTable`'s foreign keys are
// single-column, so a side with no `@id` field at all cannot build one.
fn singleIdColumn(fields: []FieldDesc, table: string): string! {
  let ids = idColumnNames(fields)
  if (len(ids) == 0) {
    fail newError("pkg/orm: generate: '${table}' has no '@id' field; a many-to-many join table needs one to reference")
  }
  return ids[0]
}

// One `ManyToManyDesc` per DISTINCT join table name declared by exactly two
// `@manyToMany` sides across `entities` (#5390) — refuses (this file's own
// "never guess" rule) when a join table name is declared by any other
// count: one means the relation's other half is not in `entities` at all
// (rule 3: entities are an explicit argument, so `generate` cannot see a
// class the caller never passed), three or more names an ambiguous join
// table `manyToManyTable` was never designed to build from more than a
// pair. `ownerColumn`/`targetColumn` are each read off the OTHER side's own
// `pointsAtClass` (already known, no reflection needed — this file's own
// `mtmSide` header), snake_cased plus "_id", #5081's own header convention
// ("<singular snake_case target>_id"): `a`'s field names the class `b`'s
// own table is, so `b`'s `pointsAtClass` (naming `a`'s class) is `a`'s own
// join-table column.
fn manyToManyDescsFor(entities: []TableEntity): []ManyToManyDesc! {
  let sides = manyToManySides(entities)
  let seen = map<string, bool>(0)
  let out = []ManyToManyDesc(0)
  for s of sides {
    if (seen[s.joinTable]) {
      continue
    }
    seen[s.joinTable] = true
    let matches = sidesNaming(sides, s.joinTable)
    if (len(matches) != 2) {
      fail newError(
          "pkg/orm: generate: '@manyToMany(\"${s.joinTable}\")' is declared " +
          "by ${len(matches)} field(s) across the given entities, not the " +
          "two sides a join table needs — both classes on this relation " +
          "must be in the entities list passed to generate",
      )
    }
    out = append(out, manyToManyDescFrom(matches[0], matches[1])?)
  }
  return out
}

fn manyToManyDescFrom(a: mtmSide, b: mtmSide): ManyToManyDesc! {
  let aFields = a.entity.tableDescriptor()
  let bFields = b.entity.tableDescriptor()
  if (hasCompositeKey(aFields) || hasCompositeKey(bFields)) {
    fail newError(
        "pkg/orm: generate: '@manyToMany(\"${a.joinTable}\")' cannot build a " +
        "join table — one of its two classes has a composite key, and a " +
        "join table's foreign key is single-column",
    )
  }
  let ownerTable = tableNameOf(a.entity)?
  let targetTable = tableNameOf(b.entity)?
  return ManyToManyDesc{
    joinTable: a.joinTable,
    ownerTable: ownerTable,
    ownerIdColumn: singleIdColumn(aFields, ownerTable)?,
    ownerColumn: "${toSnake(b.pointsAtClass)}_id",
    targetTable: targetTable,
    targetIdColumn: singleIdColumn(bFields, targetTable)?,
    targetColumn: "${toSnake(a.pointsAtClass)}_id",
  }
}

// `manyToManyTable(desc)`'s own call, rendered as Bit source — this file
// never invokes it directly and reserializes the result (rule 2, this
// file's header: `generate` never applies anything); it writes the SAME
// call text a hand-written migration would (#5081's own `manytomany.bit`
// example), into the SAME `up()` block a column diff's `alter(...)` calls
// already go into.
fn renderJoinTableCreate(desc: ManyToManyDesc): string {
  return "manyToManyTable(${manyToManyDescLiteral(desc)})"
}

fn manyToManyDescLiteral(desc: ManyToManyDesc): string {
  return "ManyToManyDesc{\n" +
    "    joinTable: ${bitStringLiteral(desc.joinTable)}, ownerColumn: ${bitStringLiteral(desc.ownerColumn)},\n" +
    "    ownerTable: ${bitStringLiteral(desc.ownerTable)}, ownerIdColumn: ${bitStringLiteral(desc.ownerIdColumn)},\n" +
    "    targetColumn: ${bitStringLiteral(desc.targetColumn)}, targetTable: ${bitStringLiteral(desc.targetTable)},\n" +
    "    targetIdColumn: ${bitStringLiteral(desc.targetIdColumn)},\n" +
    "  }"
}

// `drop(joinTable)`'s own call, rendered as Bit source — the rollback half
// of a join table this migration's `up()` created (#5390); never for an
// ordinary entity table (this file's own rule 5), only for the one table a
// `@manyToMany` attribute makes the ORM's to own, not a human's (#5081's
// own decision).
fn renderJoinTableDrop(joinTable: string): string {
  return "drop(${bitStringLiteral(joinTable)})"
}

// The migration file's whole source: a header naming what generated it,
// an `import` for the schema builder, and one `up()` gathering every
// table's alter block in the order `entities` gave them, plus one `down()`
// dropping any join table `up()` created (#5390), when there is one.
fn renderFile(name: string, ops: []string, downOps: []string): string {
  let b = newBuilder()
  b.write("// Generated by orm.generate(\"${commentSafe(name)}\") — review before committing.\n")
  b.write("// A dropColumn next to an addColumn in the same block may be a\n")
  b.write("// rename; this generator never guesses one — edit it into a\n")
  b.write("// renameColumn(...) call if that is what you meant (#5067).\n\n")
  b.write(renderFileImportLine(downOps))
  b.write("export fn up() {\n")
  for op of ops {
    b.write(indentBlock(op))
    b.write("\n")
  }
  b.write("}\n")
  if (len(downOps) > 0) {
    b.write("\n// The rollback half of the join table(s) this migration's up()\n")
    b.write("// created (#5390) — never for an ordinary entity table (this file's\n")
    b.write("// own rule 5): a @manyToMany join table is the one table this\n")
    b.write("// generator ever creates or drops on its own, since #5081's own\n")
    b.write("// decision makes the ORM its owner, not a human.\n")
    b.write("export fn down() {\n")
    for op of downOps {
      b.write(indentBlock(op))
      b.write("\n")
    }
    b.write("}\n")
  }
  return b.toString()
}

// `import { alter } from "orm"`, widened to also bring in `drop`,
// `manyToManyTable` and `ManyToManyDesc` when the file has a `down()` block
// to compile — those three are used ONLY there and in the matching `up()`
// join-table calls (`renderJoinTableCreate`/`renderJoinTableDrop` above),
// which are always added together (`generateInto`'s own loop), so `downOps`
// being non-empty is exactly the condition that needs them.
fn renderFileImportLine(downOps: []string): string {
  if (len(downOps) > 0) {
    return "import { alter, drop, manyToManyTable, ManyToManyDesc } from \"orm\"\n\n"
  }
  return "import { alter } from \"orm\"\n\n"
}

fn indentBlock(s: string): string {
  let lines = split(s, "\n")
  let out = []string(0)
  for ln of lines {
    out = append(out, "  ${ln}")
  }
  return join(out, "\n")
}

// One higher than the highest `NNNN_...` prefix already in `dir` (0 when
// `dir` has no numbered file yet), so a fresh migration never collides
// with or reorders an existing one.
fn nextMigrationNumber(dir: string): int! {
  let names = readDir(dir)?
  let highest = 0
  for n of names {
    let num = leadingNumber(n)
    if (num > highest) {
      highest = num
    }
  }
  return highest + 1
}

// The leading run of ASCII digits in `name`, or 0 if it has none — a
// non-numbered file already in the directory (a README, say) is simply
// never the highest.
fn leadingNumber(name: string): int {
  let i = 0
  let n = len(name)
  while (i < n && isDigitByte(name[i])) {
    i = i + 1
  }
  if (i == 0) {
    return 0
  }
  return parseInt(name[0:i]) catch _ {
    0
  }
}
