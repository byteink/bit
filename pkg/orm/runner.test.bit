// pkg/orm/runner.test.bit — #6309's own acceptance, against a FAKE driver
// (`rnExecutor` below) that keeps its own in-memory `migrations` ledger and
// records every statement it is asked to run, in order — the same shape
// `check.test.bit`'s `ckExecutor` uses for `information_schema`, applied
// here to `migrations` instead. `Postgres{}` (`postgres.bit`, already
// covered by `postgres.test.bit`) renders every migration's DDL; nothing
// here fakes a `Dialect`, since this file's own acceptance is about the
// RUNNER's statement sequencing and batching, not about DDL correctness.
//
// THE LAST TEST IN THIS FILE runs against a real Postgres server
// (`ORM_TEST_LIVE_PG_URI`) directly — no spawned subprocess, unlike
// `repo.test.bit`'s own live proofs: `migrate`/`rollback` are declared IN
// this module (`runner.bit`), so nothing here proves an external package
// boundary the way `import { open } from "orm"` needs to (`repo.test.bit`'s
// own header explains that distinction). `relationauto.test.bit`'s own live
// test is the precedent for connecting directly rather than spawning.
//
// `adapter` (bare, unaliased) is already bound package-wide by
// `relationauto.test.bit`'s own `import { adapter } from "postgres"` — a
// second import here would be E0042. `pool`/`Datasource`/`Value`/`Data`/
// `Timestamp`/`asInt`/`asText` are already bound package-wide too and are
// not reimported here either.

class rnExecutor {
  history: []HistoryEntry
  log: []string
  // The exact statement text to fail on, once — "" means never fail. Lets a
  // test force the failure path without a driver that understands SQL.
  failOn: string

  query(sqlText: string, params: []Value): Rows! {
    this.log = append(this.log, sqlText)
    this.failIfMatched(sqlText)?
    if (hasPrefix(sqlText, "select migration, batch, applied_at")) {
      return rnRows{ entries = this.history, i = -1 }
    }
    fail newError("rnExecutor: query not supported: ${sqlText}")
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    this.log = append(this.log, sqlText)
    this.failIfMatched(sqlText)?
    if (hasPrefix(sqlText, "insert into migrations")) {
      this.history = append(
        this.history,
        HistoryEntry{
          migration = asText(params[0])?,
          batch = asInt(params[1])?,
          appliedAt = asInt(params[2])?,
        },
      )
      return ExecResult{ rowsAffected = 1 }
    }
    if (hasPrefix(sqlText, "delete from migrations")) {
      this.history = withoutName(this.history, asText(params[0])?)
      return ExecResult{ rowsAffected = 1 }
    }
    return ExecResult{ rowsAffected = 0 }
  }

  failIfMatched(sqlText: string): ()! {
    if (this.failOn != "" && sqlText == this.failOn) {
      fail newError("rnExecutor: forced failure on: ${sqlText}")
    }
  }
}

class rnRows {
  entries: []HistoryEntry
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.entries)
  }

  columns(): []string {
    return ["migration", "batch", "applied_at"]
  }

  value(col: int): Value {
    let e = this.entries[this.i]
    if (col == 0) {
      return Value.Text(e.migration)
    }
    if (col == 1) {
      return Value.Int(e.batch)
    }
    return Value.Int(e.appliedAt)
  }

  close() {}
}

fn withoutName(history: []HistoryEntry, migration: string): []HistoryEntry {
  let out = []HistoryEntry(0)
  for h of history {
    if (h.migration != migration) {
      out = append(out, h)
    }
  }
  return out
}

// The ordinary `RunnerDialect` every test in this file that does not
// specifically target MySQL uses: Postgres both renders DDL and locks. See
// the MySQL test below for the one deliberate exception.
fn pgDialect(): RunnerDialect {
  return RunnerDialect{ render = Postgres{}, server = ServerDialect.Postgres }
}

// Adds one nullable-free string column on `table` — one transactional
// `Statement`, nothing else, either direction.
class rnAddNote {
  table: string

  up(s: Schema): ()! {
    s.table(this.table, (t) => {
      t.string("note", 50)
    })?
  }

  down(s: Schema): ()! {
    s.table(this.table, (t) => {
      t.dropColumn("note")
    })?
  }
}

fn migPlain(table: string): Migration {
  return rnAddNote{ table = table }
}

// Carries both a transactional add and a non-transactional `CREATE INDEX
// CONCURRENTLY` raw — see `postgres.bit`'s own `rawStatement`, which is
// what flags the second op non-transactional.
class rnAddNoteAndIndex {
  table: string

  up(s: Schema): ()! {
    s.table(this.table, (t) => {
      t.string("note", 50)
    })?
    s.table(this.table, (t) => {
      t.raw("CREATE INDEX CONCURRENTLY idx_${this.table}_note ON ${this.table} (note)")
    })?
  }

  down(s: Schema): ()! {
    s.table(this.table, (t) => {
      t.dropColumn("note")
    })?
  }
}

fn migMixed(table: string): Migration {
  return rnAddNoteAndIndex{ table = table }
}

// Renders two statements on MySQL — one `s.table(...)` call declaring two
// `string` columns, so `mysql.bit`'s `mysqlRenderAlterTable` emits one
// `ALTER TABLE` per column — so a test can force the second to fail and see
// whether the first's effect (and the ledger) survives it.
class rnAddAB {
  table: string

  up(s: Schema): ()! {
    s.table(this.table, (t) => {
      t.string("a", 50)
      t.string("b", 50)
    })?
  }

  down(s: Schema): ()! {
    s.table(this.table, (t) => {
      t.dropColumn("a")
      t.dropColumn("b")
    })?
  }
}

fn migMysqlTwoStatements(table: string): Migration {
  return rnAddAB{ table = table }
}

fn indexOf(log: []string, needle: string): int {
  let i = 0
  while (i < len(log)) {
    if (log[i] == needle) {
      return i
    }
    i = i + 1
  }
  return -1
}

fn countPrefixed(log: []string, prefix: string): int {
  let n = 0
  for s of log {
    if (hasPrefix(s, prefix)) {
      n = n + 1
    }
  }
  return n
}

test "migrate applies pending files in ascending name order, one migrations row each, all in the same batch" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let migrations = [
    MigrationFile{ name = "0003_third", m = migPlain("widgets") },
    MigrationFile{ name = "0001_first", m = migPlain("widgets") },
    MigrationFile{ name = "0002_second", m = migPlain("widgets") },
  ]
  let report = migrate(db, pgDialect(), migrations, Timestamp{ ns = 5000 }) catch e {
    panic("migrate: ${e.message()}")
  }
  assert(len(report.applied) == 3, "expected 3 applied migrations, got ${len(report.applied)}")
  assert(
    report.applied[0].name == "0001_first",
    "expected 0001_first first, got ${report.applied[0].name}",
  )
  assert(
    report.applied[1].name == "0002_second",
    "expected 0002_second second, got ${report.applied[1].name}",
  )
  assert(
    report.applied[2].name == "0003_third",
    "expected 0003_third third, got ${report.applied[2].name}",
  )
  for a of report.applied {
    assert(a.batch == 1, "expected batch 1 for a first migrate call, got ${a.batch}")
    assert(a.appliedAt == 5000, "expected appliedAt 5000, got ${a.appliedAt}")
    assert(a.durationMs >= 0, "expected a non-negative duration, got ${a.durationMs}")
  }
  assert(len(db.history) == 3, "expected 3 migrations rows, got ${len(db.history)}")
  assert(
    db.history[0].migration == "0001_first" && db.history[0].batch == 1,
    "row 0 wrong: ${db.history[0].migration}/${db.history[0].batch}",
  )
}

test "a second migrate call applies nothing already recorded, and issues no statement" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let migrations = [MigrationFile{ name = "0001_init", m = migPlain("widgets") }]
  migrate(db, pgDialect(), migrations, Timestamp{ ns = 5000 }) catch e {
    panic("migrate (first): ${e.message()}")
  }
  db.log = []string(0)
  let second = migrate(db, pgDialect(), migrations, Timestamp{ ns = 6000 }) catch e {
    panic("migrate (second): ${e.message()}")
  }
  assert(
    len(second.applied) == 0,
    "expected zero applied on the second run, got ${len(second.applied)}",
  )
  assert(
    indexOf(db.log, "BEGIN") == -1,
    "a BEGIN was issued on the second run; nothing pending should have run",
  )
}

test "the advisory lock is the first statement issued and is released at the end, including on the failure path" {
  let failingSql = "alter table \"widgets\" add column \"note\" varchar(50) not null;"
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = failingSql }
  let migrations = [MigrationFile{ name = "0001_init", m = migPlain("widgets") }]
  migrate(db, pgDialect(), migrations, Timestamp{ ns = 5000 }) catch _ {
    assert(len(db.log) >= 2, "expected at least a lock and an unlock, got ${len(db.log)}")
    assert(
      db.log[0] == "select pg_advisory_lock($1)",
      "lock was not the first statement: ${db.log[0]}",
    )
    assert(
      db.log[len(db.log) - 1] == "select pg_advisory_unlock($1)",
      "lock was not released as the last statement: ${db.log[len(db.log) - 1]}",
    )
    return
  }
  panic("migrate: expected the forced statement failure to propagate")
}

test "each migration's statements are bracketed by BEGIN and COMMIT while a non-transactional statement runs outside" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let migrations = [MigrationFile{ name = "0001_add_note_and_index", m = migMixed("widgets") }]
  migrate(db, pgDialect(), migrations, Timestamp{ ns = 5000 }) catch e {
    panic("migrate: ${e.message()}")
  }
  let beginAt = indexOf(db.log, "BEGIN")
  let commitAt = indexOf(db.log, "COMMIT")
  let insertAt = indexOf(
    db.log,
    "insert into migrations (migration, batch, applied_at) values ($1, $2, $3)",
  )
  let concurrentAt = -1
  let i = 0
  while (i < len(db.log)) {
    if (hasPrefix(db.log[i], "CREATE INDEX CONCURRENTLY")) {
      concurrentAt = i
    }
    i = i + 1
  }
  let logDump = join(db.log, " | ")
  assert(
    beginAt >= 0 && commitAt >= 0 && insertAt >= 0 && concurrentAt >= 0,
    "missing an expected statement: ${logDump}",
  )
  assert(
    beginAt < insertAt && insertAt < commitAt,
    "the migrations row was not written inside the transaction",
  )
  assert(commitAt < concurrentAt, "the non-transactional statement ran before COMMIT")
  assert(
    countPrefixed(db.log, "CREATE INDEX CONCURRENTLY") == 1,
    "expected exactly one CONCURRENTLY statement",
  )
}

// O3c (#6311): MySQL now takes GET_LOCK/RELEASE_LOCK instead of refusing
// (see this file's own header, piece 1) - `mysql.test.bit` covers the real
// round trip and the failing-migration release; this fake-executor test
// covers only ordering, the one thing `mysql.test.bit`'s live tests cannot
// prove deterministically since `spawn` gives no ordering guarantee.
test "migrate on ServerDialect.Mysql issues GET_LOCK first and RELEASE_LOCK last (#6311)" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let migrations = [MigrationFile{ name = "0001_init", m = migPlain("widgets") }]
  let dialect = RunnerDialect{
    render = Mysql{},
    server = ServerDialect.Mysql(MysqlVersion{ major = 8, minor = 0 }),
  }
  migrate(db, dialect, migrations, Timestamp{ ns = 5000 }) catch e {
    panic("migrate: ${e.message()}")
  }
  assert(len(db.log) > 0, "expected statements to be issued")
  assert(
    db.log[0] == "select GET_LOCK($1, -1)",
    "expected GET_LOCK as the first statement issued, got: ${db.log[0]}",
  )
  assert(
    db.log[len(db.log) - 1] == "select RELEASE_LOCK($1)",
    "expected RELEASE_LOCK as the last statement issued, got: ${db.log[len(db.log) - 1]}",
  )
}

// A migration whose `up()` always fails, before it ever builds a `Schema`
// op - so `runOneMigration` never reaches `db.exec` at all. The fake
// executor deterministic sibling of `mysql.test.bit`'s live release proof:
// this file's whole point is proving statement ORDER without a real
// server, and RELEASE_LOCK being issued despite the failure is an ordering
// fact `db.log` can prove directly.
class rnAlwaysFailsUp {
  up(s: Schema): ()! {
    fail newError("rnAlwaysFailsUp: forced failure")
  }

  down(s: Schema): ()! {}
}

test "migrate on ServerDialect.Mysql releases the lock even when a migration's up() fails (#6311)" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let migrations = [MigrationFile{ name = "0001_fails", m = rnAlwaysFailsUp{} }]
  let dialect = RunnerDialect{
    render = Mysql{},
    server = ServerDialect.Mysql(MysqlVersion{ major = 8, minor = 0 }),
  }
  migrate(db, dialect, migrations, Timestamp{ ns = 5000 }) catch e {
    assert(
      contains(e.message(), "0001_fails"),
      "error does not name the failing migration: ${e.message()}",
    )
    assert(
      db.log[len(db.log) - 1] == "select RELEASE_LOCK($1)",
      "expected RELEASE_LOCK issued despite the failure, log ends with: ${db.log[len(db.log) - 1]}",
    )
    return
  }
  panic("migrate: expected rnAlwaysFailsUp to fail the run")
}

test "on MySQL, a migration failing on its second statement leaves no migrations row, naming the migration" {
  // `render: Mysql{}` exercises this test's real subject - mysql.bit's
  // all-non-transactional statement sequencing (this file's header, piece
  // 2, in `runner.bit`). `server: ServerDialect.Postgres` is deliberate,
  // not a copy-paste slip: it keeps this test about statement ORDER
  // (transactional vs non), not the lock, which `mysql.test.bit` and the
  // test directly above this one already cover on their own.
  let failingSql = "alter table `widgets` add column `b` varchar(50) not null;"
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = failingSql }
  let migrations = [MigrationFile{ name = "0001_add_a_and_b", m = migMysqlTwoStatements("widgets") }]
  let dialect = RunnerDialect{ render = Mysql{}, server = ServerDialect.Postgres }
  migrate(db, dialect, migrations, Timestamp{ ns = 5000 }) catch e {
    assert(
      contains(e.message(), "0001_add_a_and_b"),
      "error does not name the migration: ${e.message()}",
    )
    assert(len(db.history) == 0, "expected no migrations row, got ${len(db.history)}")
    assert(
        indexOf(
          db.log,
          "insert into migrations (migration, batch, applied_at) values ($1, $2, $3)",
        ) ==
        -1,
      "the ledger was written despite the forced failure, log has ${len(db.log)} entries",
    )
    return
  }
  panic("migrate: expected the forced second-statement failure to propagate")
}

test "rollback is a no-op when nothing has ever been applied" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let migrations = [MigrationFile{ name = "0001_init", m = migPlain("widgets") }]
  let report = rollback(db, pgDialect(), migrations) catch e {
    panic("rollback: ${e.message()}")
  }
  assert(len(report.reverted) == 0, "expected zero reverted, got ${len(report.reverted)}")
  assert(
    indexOf(db.log, "delete from migrations where migration = $1") == -1,
    "rollback with nothing applied issued a delete",
  )
}

test "rollback reverts only the highest batch, newest file first, leaving earlier batches untouched" {
  let db = rnExecutor{
    history = [
      HistoryEntry{ migration = "0001_a", batch = 1, appliedAt = 1000 },
      HistoryEntry{ migration = "0002_b", batch = 1, appliedAt = 1000 },
      HistoryEntry{ migration = "0003_c", batch = 2, appliedAt = 2000 },
      HistoryEntry{ migration = "0004_d", batch = 2, appliedAt = 2000 },
    ],
    log = []string(0),
    failOn = "",
  }
  let migrations = [
    MigrationFile{ name = "0001_a", m = migPlain("widgets") },
    MigrationFile{ name = "0002_b", m = migPlain("widgets") },
    MigrationFile{ name = "0003_c", m = migPlain("widgets") },
    MigrationFile{ name = "0004_d", m = migPlain("widgets") },
  ]
  let report = rollback(db, pgDialect(), migrations) catch e {
    panic("rollback: ${e.message()}")
  }
  assert(
    len(report.reverted) == 2,
    "expected 2 reverted (batch 2 only), got ${len(report.reverted)}",
  )
  assert(
    report.reverted[0].name == "0004_d" && report.reverted[1].name == "0003_c",
    "expected newest-file-first order within the batch, got ${report.reverted[0].name}/${report.reverted[1].name}",
  )
  assert(len(db.history) == 2, "expected 2 rows left (batch 1), got ${len(db.history)}")
  assert(
    db.history[0].migration == "0001_a" && db.history[1].migration == "0002_b",
    "batch 1 rows were touched: ${db.history[0].migration}/${db.history[1].migration}",
  )
}

// #6309's own live proof (owner ruling 2026-09-30, "laravel style"): two
// files migrate as batch 1, a third migrates later as batch 2, and
// rollback undoes ONLY the third — never the whole
// history. See `runner.bit`'s own `newestFirstInBatch` for the one-line
// mutation (filter the WHOLE of `history` instead of just the highest
// `batch`) this test exists to catch.
class rn6309CreateA {
  up(s: Schema): ()! {
    s.create("rn6309_a", (t) => {
      t.id()
      t.string("name")
    })?
  }

  down(s: Schema): ()! {
    s.drop("rn6309_a")?
  }
}

class rn6309CreateB {
  up(s: Schema): ()! {
    s.create("rn6309_b", (t) => {
      t.id()
      t.string("name")
    })?
  }

  down(s: Schema): ()! {
    s.drop("rn6309_b")?
  }
}

class rn6309CreateC {
  up(s: Schema): ()! {
    s.create("rn6309_c", (t) => {
      t.id()
      t.string("name")
    })?
  }

  down(s: Schema): ()! {
    s.drop("rn6309_c")?
  }
}

fn rn6309TableExists(db: Data, name: string): bool! {
  let rows = db.query(
    "select count(*) from information_schema.tables where table_name = $1", [Value.Text(name)],
  )?
  defer rows.close()
  if (!rows.next()?) {
    return false
  }
  return asInt(rows.value(0))? > 0
}

test "live: two migrations apply as batch 1, a third applies later as batch 2, rollback undoes only the third (#6309)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let db = pool(adapter(), Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists rn6309_a", []Value(0)) catch e {
    panic("drop rn6309_a: ${e.message()}")
  }
  db.exec("drop table if exists rn6309_b", []Value(0)) catch e {
    panic("drop rn6309_b: ${e.message()}")
  }
  db.exec("drop table if exists rn6309_c", []Value(0)) catch e {
    panic("drop rn6309_c: ${e.message()}")
  }
  db.exec("drop table if exists migrations", []Value(0)) catch e {
    panic("drop migrations: ${e.message()}")
  }

  let dialect = pgDialect()
  let a = MigrationFile{ name = "0001_create_a", m = rn6309CreateA{} }
  let b = MigrationFile{ name = "0002_create_b", m = rn6309CreateB{} }
  let c = MigrationFile{ name = "0003_create_c", m = rn6309CreateC{} }

  let firstReport = migrate(db, dialect, [a, b], Timestamp{ ns = 1000 }) catch e {
    panic("LIVE PROOF FAILED: migrate (batch 1): ${e.message()}")
  }
  if (len(firstReport.applied) != 2) {
    panic("LIVE PROOF FAILED: expected 2 applied in batch 1, got ${len(firstReport.applied)}")
  }
  if (firstReport.applied[0].batch != 1 || firstReport.applied[1].batch != 1) {
    panic("LIVE PROOF FAILED: expected batch 1 for both first-run migrations")
  }

  let secondReport = migrate(db, dialect, [a, b, c], Timestamp{ ns = 2000 }) catch e {
    panic("LIVE PROOF FAILED: migrate (batch 2): ${e.message()}")
  }
  if (len(secondReport.applied) != 1 || secondReport.applied[0].name != "0003_create_c") {
    panic("LIVE PROOF FAILED: expected exactly 0003_create_c applied second, got ${len(secondReport.applied)} row(s)")
  }
  if (secondReport.applied[0].batch != 2) {
    panic("LIVE PROOF FAILED: expected batch 2, got ${secondReport.applied[0].batch}")
  }

  let rolled = rollback(db, dialect, [a, b, c]) catch e {
    panic("LIVE PROOF FAILED: rollback: ${e.message()}")
  }
  if (len(rolled.reverted) != 1 || rolled.reverted[0].name != "0003_create_c") {
    panic("LIVE PROOF FAILED: rollback must undo only the newest batch (0003_create_c), got ${len(rolled.reverted)} row(s)")
  }

  let aExists = rn6309TableExists(db, "rn6309_a") catch e {
    panic("check rn6309_a: ${e.message()}")
  }
  let bExists = rn6309TableExists(db, "rn6309_b") catch e {
    panic("check rn6309_b: ${e.message()}")
  }
  let cExists = rn6309TableExists(db, "rn6309_c") catch e {
    panic("check rn6309_c: ${e.message()}")
  }
  if (!aExists || !bExists) {
    panic("LIVE PROOF FAILED: rollback must not have touched batch 1's tables")
  }
  if (cExists) {
    panic("LIVE PROOF FAILED: rollback's down() must have dropped rn6309_c")
  }

  let historyAfter = loadHistory(db) catch e {
    panic("loadHistory: ${e.message()}")
  }
  if (len(historyAfter) != 2) {
    panic("LIVE PROOF FAILED: expected 2 migrations rows left, got ${len(historyAfter)}")
  }

  db.exec("drop table if exists rn6309_a", []Value(0)) catch e {
    panic("cleanup rn6309_a: ${e.message()}")
  }
  db.exec("drop table if exists rn6309_b", []Value(0)) catch e {
    panic("cleanup rn6309_b: ${e.message()}")
  }
  db.exec("drop table if exists migrations", []Value(0)) catch e {
    panic("cleanup migrations: ${e.message()}")
  }
  db.close()
}

// #6328's own live proof, Postgres-spelled: `pg_advisory_lock` is
// session-scoped exactly like MySQL's `GET_LOCK` (`mysql.test.bit`'s own
// O3c header), so it needed the same concurrency proof — before
// `runner.bit`'s `Pool.pinned` fix this test failed the identical way
// `mysql.test.bit`'s #6311 test did, `sql: value is not Int`, because
// nothing pinned `acquireLock`'s connection to the statements it was
// meant to protect. The single pending migration below applies exactly
// once across two concurrent `migrate` calls — either order is correct
// (`spawn` gives no ordering guarantee, SPEC §16), so this sums outcomes
// rather than asserting which one "won", the same shape `mysql.test.bit`'s
// own `my6311RunMigrate`/test pair uses.
class rn6328CreateWidgets {
  up(s: Schema): ()! {
    s.create("rn6328_widgets", (t) => {
      t.id("id")
      t.string("name", 50)
    })?
  }

  down(s: Schema): ()! {
    s.drop("rn6328_widgets")?
  }
}

fn rn6328RunMigrate(db: Data, migrations: []MigrationFile, at: Timestamp, outcomes: chan<string>) {
  let report = migrate(db, pgDialect(), migrations, at) catch e {
    outcomes <- "error:${e.message()}"
    return
  }
  outcomes <- "applied:${len(report.applied)}"
}

// The `n` out of `rn6328RunMigrate`'s own "applied:<n>" outcome string.
// Panics rather than propagating `int!`: both callers are inside a
// `test { }` block, which is not itself fallible.
fn rn6328AppliedCount(outcome: string): int {
  if (!hasPrefix(outcome, "applied:")) {
    panic("rn6328AppliedCount: not an 'applied:' outcome: ${outcome}")
  }
  return parseInt(outcome[8:]) catch e {
    panic("rn6328AppliedCount: bad integer in '${outcome}': ${e.message()}")
  }
}

test "live: two concurrent Postgres migrate runs of the same migration - the lock serializes them, applied exactly once (#6328)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let db = pool(adapter(), Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists rn6328_widgets", []Value(0)) catch e {
    panic("drop rn6328_widgets: ${e.message()}")
  }
  db.exec("drop table if exists migrations", []Value(0)) catch e {
    panic("drop migrations: ${e.message()}")
  }

  let migrations = [MigrationFile{ name = "6328_create_widgets", m = rn6328CreateWidgets{} }]
  let outcomes = chan<string>(2)
  spawn rn6328RunMigrate(db, migrations, Timestamp{ ns = 1000 }, outcomes)
  spawn rn6328RunMigrate(db, migrations, Timestamp{ ns = 1000 }, outcomes)
  let first = <- outcomes
  let second = <- outcomes

  if (hasPrefix(first, "error:") || hasPrefix(second, "error:")) {
    panic("LIVE PROOF FAILED: expected both runs to succeed, got '${first}' and '${second}'")
  }
  let appliedTotal = rn6328AppliedCount(first) + rn6328AppliedCount(second)
  if (appliedTotal != 1) {
    panic("LIVE PROOF FAILED: expected exactly 1 applied across both runs, got '${first}' + '${second}'")
  }

  let history = loadHistory(db) catch e {
    panic("loadHistory: ${e.message()}")
  }
  if (len(history) != 1) {
    panic("LIVE PROOF FAILED: expected 1 migrations row, got ${len(history)}")
  }

  db.exec("drop table if exists rn6328_widgets", []Value(0)) catch e {
    panic("cleanup rn6328_widgets: ${e.message()}")
  }
  db.exec("drop table if exists migrations", []Value(0)) catch e {
    panic("cleanup migrations: ${e.message()}")
  }
  db.close()
}
