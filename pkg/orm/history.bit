// pkg/orm/history.bit — schema_history (#5068): the durability ledger
// `runner.bit` reads and writes. One row per applied migration: version,
// name, a checksum of the migration that produced it, when it applied and
// how long it took — see `runner.bit`'s own header for how each field is
// used to make a rerun safe.
//
// EVERY WRITE GOES THROUGH `Data.exec`/`Data.query`, NEVER A SEPARATE
// CONNECTION. `Data` (`data.bit`) is `Pool` or a live transaction handle
// either way, so `recordApplied` called from inside `runner.bit`'s own
// BEGIN...COMMIT block writes the ledger row in the SAME transaction as the
// migration's DDL — the row exists if and only if the DDL committed.

import { asInt } from "std/sql"

// One applied migration, as recorded in `schema_history`. `appliedAt` is
// nanoseconds since the epoch (a `std/time` `Timestamp.ns` reading `runner.bit`
// took once, before this migration's own work began — never read from the
// database's own clock, so a test can construct one without a live database).
export class HistoryEntry {
  export version: int,
  export name: string,
  export checksum: string,
  export appliedAt: i64,
  export durationMs: i64,
}

// Creates `schema_history` if this is the first run against this database.
// Idempotent — safe to call at the top of every `up`/`down`.
export fn ensureHistoryTable(db: Data): ()! {
  db.exec(
      "create table if not exists schema_history (" +
      "version bigint primary key, " +
      "name text not null, " +
      "checksum text not null, " +
      "applied_at bigint not null, " +
      "duration_ms bigint not null)",
    []Value(0),
  )?
}

// Every applied migration, ordered by version — the full ledger `runner.bit`
// diffs the registry against.
export fn loadHistory(db: Data): []HistoryEntry! {
  let rows = db.query(
    "select version, name, checksum, applied_at, duration_ms from schema_history order by version",
    []Value(0),
  )?
  defer rows.close()
  let out = []HistoryEntry(0)
  while (rows.next()?) {
    out = append(
      out,
      HistoryEntry{
        version = asInt(rows.value(0))?,
        name = asText(rows.value(1))?,
        checksum = asText(rows.value(2))?,
        appliedAt = asInt(rows.value(3))?,
        durationMs = asInt(rows.value(4))?,
      },
    )
  }
  return out
}

// Records `e` as applied. The caller (`runner.bit`) issues this inside the
// migration's own transaction, so a failure here rolls the DDL back with it —
// this file never opens or closes a transaction of its own.
export fn recordApplied(db: Data, e: HistoryEntry): ()! {
  db.exec(
    "insert into schema_history (version, name, checksum, applied_at, duration_ms) values ($1, $2, $3, $4, $5)",
    [
      Value.Int(e.version),
      Value.Text(e.name),
      Value.Text(e.checksum),
      Value.Int(e.appliedAt),
      Value.Int(e.durationMs),
    ],
  )?
}

// Removes `version`'s row — `down`'s own ledger write, issued inside its
// migration's transaction exactly as `recordApplied` is issued inside `up`'s.
export fn deleteHistory(db: Data, version: int): ()! {
  db.exec("delete from schema_history where version = $1", [Value.Int(version)])?
}

// Whether `version` already has a row in `history`.
export fn hasVersion(history: []HistoryEntry, version: int): bool {
  for h of history {
    if (h.version == version) {
      return true
    }
  }
  return false
}

// The row with the highest `version` in `history`, or `found = false` when
// nothing has ever been applied — `down`'s "roll back the last migration"
// target.
export fn latestEntry(history: []HistoryEntry): (HistoryEntry, bool) {
  if (len(history) == 0) {
    return (HistoryEntry{}, false)
  }
  let best = history[0]
  for h of history {
    if (h.version > best.version) {
      best = h
    }
  }
  return (best, true)
}
