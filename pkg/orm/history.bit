// pkg/orm/history.bit — the `migrations` table (#6309, "laravel style",
// .claude/kb/data-packages-dx.md "Migrations, approved 2026-09-30"):
// `migration text primary key, batch bigint, applied_at bigint` —
// `runner.bit`'s own ledger.
//
// EVERY WRITE GOES THROUGH `Data.exec`/`Data.query`, NEVER A SEPARATE
// CONNECTION. `Data` (`data.bit`) is `Pool` or a live transaction handle
// either way, so `recordApplied` called from inside `runner.bit`'s own
// BEGIN...COMMIT block writes the ledger row in the SAME transaction as the
// migration's DDL — the row exists if and only if the DDL committed.
//
// NO CHECKSUM, NO INTEGER VERSION (dropped by #6309, matching Laravel — the
// prior `schema_history` table and its checksum column are gone, not
// migrated: "existing schema_history databases start fresh", the owner
// ruling's own acceptance). A migration is identified by its FILE NAME —
// `migration`, this table's own primary key — exactly `MigrationFile.name`
// (`migration.bit`).

import { asInt } from "std/sql"

// One applied migration, as recorded in `migrations`. `appliedAt` is
// nanoseconds since the epoch — a `std/time` `Timestamp.ns` reading
// `runner.bit` takes once, before a `migrate()` run's own batch began,
// never read from the database's own clock, so a test can construct one
// without a live database.
export class HistoryEntry {
  export migration: string,
  export batch: int,
  export appliedAt: i64,
}

// Creates `migrations` if this is the first run against this database.
// Idempotent — safe to call at the top of every `migrate`/`rollback`.
export fn ensureHistoryTable(db: Data): ()! {
  db.exec(
      "create table if not exists migrations (" +
      "migration text primary key, " +
      "batch bigint not null, " +
      "applied_at bigint not null)",
    []Value(0),
  )?
}

// Every applied migration, ordered by name — the full ledger `runner.bit`
// diffs the registry against.
export fn loadHistory(db: Data): []HistoryEntry! {
  let rows = db.query(
    "select migration, batch, applied_at from migrations order by migration",
    []Value(0),
  )?
  defer rows.close()
  let out = []HistoryEntry(0)
  while (rows.next()?) {
    out = append(
      out,
      HistoryEntry{
        migration = asText(rows.value(0))?,
        batch = asInt(rows.value(1))?,
        appliedAt = asInt(rows.value(2))?,
      },
    )
  }
  return out
}

// Records `e` as applied. The caller (`runner.bit`) issues this inside the
// migration's own transaction, so a failure here rolls the DDL back with it
// — this file never opens or closes a transaction of its own.
export fn recordApplied(db: Data, e: HistoryEntry): ()! {
  db.exec(
    "insert into migrations (migration, batch, applied_at) values ($1, $2, $3)",
    [Value.Text(e.migration), Value.Int(e.batch), Value.Int(e.appliedAt)],
  )?
}

// Removes `migration`'s row — `rollback`'s own ledger write, issued inside
// its migration's transaction exactly as `recordApplied` is issued inside
// `migrate`'s.
export fn deleteHistory(db: Data, migration: string): ()! {
  db.exec("delete from migrations where migration = $1", [Value.Text(migration)])?
}

// Whether `migration` already has a row in `history`.
export fn hasName(history: []HistoryEntry, migration: string): bool {
  for h of history {
    if (h.migration == migration) {
      return true
    }
  }
  return false
}

// The highest `batch` in `history`, or 0 when nothing has ever been applied
// — `migrate`'s own "the next batch is max+1" and `rollback`'s own "undo
// the highest batch" both read this.
export fn maxBatch(history: []HistoryEntry): int {
  let best = 0
  for h of history {
    if (h.batch > best) {
      best = h.batch
    }
  }
  return best
}
