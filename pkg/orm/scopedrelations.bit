fn scopedRelation<T: Tabled>(
  self: ScopedRepo<T>, v: T, name: string, targetIds: []i64, add: bool,
): ()! {
  self.inner.checkErr()?
  match (self.guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        self.inner.singleKeyColumn()?
        let field = relationIdField<T>()?
        let ownerId = relationFieldInt<T>(v, field)?
        runTx(self.inner.db, (db) => {
          let inner = self.inner.next()
          inner.db = db
          let scoped = scopedWith<T>(self, inner)
          lockRelationOwner<T>(scoped, g, field, ownerId)?
          T.__linkRelation(
            db, name,
            LinkOp{
              ownerId = ownerId,
              targetIds = targetIds,
              add = add,
              dialect = inner.dialect,
            },
          )?
        })?
        return
      }
    }
    None => {}
  }
  if (add) {
    return repoLink<T>(self.inner, v, name, targetIds)?
  }
  return repoUnlink<T>(self.inner, v, name, targetIds)?
}

// Lock the stored owner until the relation write commits; the supplied row proves no permission.
fn lockRelationOwner<T: Tabled>(self: ScopedRepo<T>, g: Guard, field: string, ownerId: i64): ()! {
  let owner = self.inner.where(field, Value.Int(ownerId))
  let filter = g.filter(
    scopedActor<T>(self), GuardOp.Update, T.__tableName(),
    owner.dialect, len(owner.args) + 1,
  )?
  let allowed = Option<Repo<T>>.Some(owner)
  match (filter) {
    All => {}
    None => allowed = Option<Repo<T>>.None
    Sql(fragment, args) => allowed = Option<Repo<T>>.Some(withFragment<T>(owner, fragment, args))
  }
  match (allowed) {
    Some(r) => {
      if (relationOwnerExists<T>(r.limit(2))?) {
        return
      }
    }
    None => {}
  }
  if (scopedCount<T>(scopedWith<T>(self, owner))? == 0) {
    fail g.notFound(T.__tableName())
  }
  fail g.denied(scopedActor<T>(self), GuardOp.Update, T.__tableName())
}

fn relationOwnerExists<T: Tabled>(repo: Repo<T>): bool! {
  let clause = LockedRepo<T>{
    inner = repo, opts = lockOptsFor(LockMode.Update), dialect = repo.dialect,
  }.guard()?
  let sqlText = repo.selectSql() + clause
  repo.checkErr()?
  let rows = repo.db.query(sqlText, repo.args)?
  defer rows.close()
  return rows.next()?
}
