// pkg/orm/naming.test.bit — #5056's acceptance: table names, column names
// (each direction) and the override escape hatches.

// FieldDesc and AttrDesc are imported by ./naming.bit, this file's sibling
// in the same module (SPEC §17.1) — a second import here would be E0042.

fn field(name: string): FieldDesc {
  return FieldDesc{ name: name, typeName: "string", attrs: []AttrDesc(0) }
}

fn fieldWithColumnOverride(name: string, column: string): FieldDesc {
  return FieldDesc{
    name: name, typeName: "string",
    attrs: [AttrDesc{ name: "column", args: [column] }],
  }
}

fn noTableOverride(): []AttrDesc {
  return []AttrDesc(0)
}

fn tableOverride(name: string): []AttrDesc {
  return [AttrDesc{ name: "table", args: [name] }]
}

// Table names: the four rules, no irregular-noun list — a plain name, a
// name already ending in a pluralising-trigger letter, an irregular one
// documented as wrong-but-consistent, a multi-word name, and the override
// read off `@table("...")`'s own synthesized `tableAttrs()` (#5189).
test "table names: the four rules and the override" {
  assert(tableName("User", noTableOverride()) == "users", "User -> ${tableName("User", noTableOverride())}")
  assert(tableName("Order", noTableOverride()) == "orders", "Order -> ${tableName("Order", noTableOverride())}")
  assert(tableName("Box", noTableOverride()) == "boxes", "Box -> ${tableName("Box", noTableOverride())}")
  assert(tableName("Class", noTableOverride()) == "classes", "Class -> ${tableName("Class", noTableOverride())}")
  assert(
    tableName("Company", noTableOverride()) == "companies",
    "Company -> ${tableName("Company", noTableOverride())}",
  )
  assert(
    tableName("OrderLine", noTableOverride()) == "order_lines",
    "OrderLine -> ${tableName("OrderLine", noTableOverride())}",
  )
  assert(tableName("Person", noTableOverride()) == "persons", "Person -> ${tableName("Person", noTableOverride())}")
  assert(
    tableName("Person", tableOverride("people")) == "people",
    "override ignored: ${tableName("Person", tableOverride("people"))}",
  )
}

// Column names: a plain name, a name already snake_case, an acronym run
// (userID), a multi-capital run followed by a word (HTTPStatus), and the
// @column override.
test "column names: snake_case, acronym runs, and the override" {
  assert(
    columnName(field("createdAt")) == "created_at",
    "createdAt -> ${columnName(field("createdAt"))}",
  )
  assert(columnName(field("email")) == "email", "email -> ${columnName(field("email"))}")
  assert(columnName(field("userID")) == "user_id", "userID -> ${columnName(field("userID"))}")
  assert(
    columnName(field("HTTPStatus")) == "http_status",
    "HTTPStatus -> ${columnName(field("HTTPStatus"))}",
  )
  assert(
    columnName(field("already_snake")) == "already_snake",
    "already_snake -> ${columnName(field("already_snake"))}",
  )
  let overridden = fieldWithColumnOverride("email", "e_mail")
  assert(columnName(overridden) == "e_mail", "override ignored: ${columnName(overridden)}")
}

// No produced identifier begins with an underscore — a leading capital in
// either direction must not become a leading `_`.
test "no produced identifier begins with an underscore" {
  assert(
    !startsWithUnderscore(tableName("Order", noTableOverride())),
    "table name: ${tableName("Order", noTableOverride())}",
  )
  assert(
    !startsWithUnderscore(columnName(field("CreatedAt"))),
    "column name: ${columnName(field("CreatedAt"))}",
  )
}

fn startsWithUnderscore(s: string): bool {
  return len(s) > 0 && s[0] == '_'
}

// The reverse direction: a result column resolves to the field that
// produces it, read off the descriptor rather than un-converting the string.
test "a result column resolves to its field" {
  let fields = [field("id"), field("createdAt"), fieldWithColumnOverride("email", "e_mail")]
  assert(
    fieldForColumn(fields, "created_at") == "createdAt",
    "created_at -> ${fieldForColumn(fields, "created_at")}",
  )
  assert(
    fieldForColumn(fields, "e_mail") == "email",
    "e_mail -> ${fieldForColumn(fields, "e_mail")}",
  )
  assert(fieldForColumn(fields, "no_such_column") == "", "unknown column resolved to a field")
}
