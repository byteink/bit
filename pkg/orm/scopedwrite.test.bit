// pkg/orm/scopedwrite.test.bit — #7037's acceptance for
// `pkg/orm/scopedwrite.bit`: a `ScopedRepo<T>`'s `insert` and `insertAll` ask
// the guard `allows(actor, GuardOp.Create, ...)` on the new row before any
// SQL, and a refusal is `guard.denied` with nothing written.
//
// `swGuard` is a structural `Guard` (SPEC §14.3) whose `allows` answers from a
// script (`mode`) and records what it was asked; `newRawPool`/`newRawAdapter`
// (./rawsql.test.bit) record every statement, so a refusal is seen as zero
// statements. The cases run once per dialect (`srPostgres`/`srMysql`,
// ./scopedread.test.bit): `insert` emits the same text for both, the MySQL
// adapter rewrites `$n` itself. The live proof at the bottom
// (`ORM_TEST_LIVE_PG_URI`/`ORM_TEST_LIVE_MYSQL_URI`) is skipped, and says so,
// when no server is set.

@table("swposts") class SwPost {
  id: i64,
  authorId: i64,
  body: string,
}

class swHttpError {
  text: string
  code: int
  message(): string { return this.text }
  status(): int { return this.code }
}

class swUser {
  id: string,
}

// mode: 0 = allow, 1 = deny, 2 = error, 3 = deny a row whose body is "bad".
class swGuard {
  mode: int
  asked: int
  lastActor: string
  lastOp: GuardOp
  lastTable: string
  lastCols: string
  lastBody: string
  filterMode: int
  readMode: int
  filters: []GuardOp
  firstParams: []int
  lastValues: string

  protects(t: string): bool {
    return t == "swposts" || t == "swtrash"
  }

  filter(
    actor: Actor,
    op: GuardOp,
    t: string,
    dialect: ServerDialect,
    firstParam: int,
  ): GuardFilter! {
    this.filters = append(this.filters, op)
    this.firstParams = append(this.firstParams, firstParam)
    let mode = this.filterMode
    if (op == GuardOp.Read) {
      mode = this.readMode
    }
    if (mode == 1) {
      return GuardFilter.None
    }
    if (mode == 2) {
      fail newError("authz: filter unavailable")
    }
    if (mode == 3) {
      return GuardFilter.Sql("author_id = $${firstParam}", [Value.Int(7)])
    }
    return GuardFilter.All
  }

  allows(actor: Actor, op: GuardOp, t: string, columns: []string, values: []Value): bool! {
    this.asked = this.asked + 1
    this.lastActor = actor.id
    this.lastOp = op
    this.lastTable = t
    this.lastCols = join(columns, ",")
    this.lastBody = srArgText(values[2])
    this.lastValues = srArgsText(values)
    if (this.mode == 2) {
      fail newError("authz: rule store unavailable")
    }
    if (this.mode == 1) {
      return false
    }
    if (this.mode == 4) {
      return srArgText(values[1]) == "i7"
    }
    if (this.mode == 3) {
      return this.lastBody != "tbad"
    }
    return true
  }

  denied(actor: Actor, op: GuardOp, t: string): error {
    return swHttpError{ text = "denied ${actor.id} ${t}", code = 403 }
  }

  notFound(t: string): error {
    return swHttpError{ text = "${t}: not found", code = 404 }
  }

  check(): ()! {}
}

fn swGuardMode(mode: int): swGuard {
  return swGuard{
    mode = mode, asked = 0, lastActor = "", lastOp = GuardOp.Read, lastTable = "", lastCols = "", lastBody = "",
    filterMode = 0, readMode = 0, filters = []GuardOp(0), firstParams = []int(0), lastValues = "",
  }
}

fn swRepo(a: rawAdapter, d: ServerDialect, g: swGuard): ScopedRepo<SwPost> {
  let db = Db{ pool = newRawPool(a), dialect = d, guard = g }
  return db.as(swUser{ id = "u7" }).table<SwPost>()
}

fn swRows(a: rawAdapter) {
  a.cols = ["id", "author_id", "body"]
  a.rows = [[Value.Int(5), Value.Int(7), Value.Text("hi")]]
}

fn swPost(body: string): SwPost {
  return SwPost{ id = 0, authorId = 7, body = body }
}

const swInsertSql: string = "insert into swposts (author_id, body) values ($1, $2) returning *"

fn swCaseAllowed(d: ServerDialect) {
  let a = newRawAdapter()
  swRows(a)
  let g = swGuardMode(0)
  let got = swRepo(a, d, g).insert(swPost("hi")) catch e {
    assert(false, "insert: ${e.message()}")
    return
  }
  assert(got.id == 5, "the row comes back from RETURNING, id ${got.id}")
  assert(len(a.queries) == 1, "expected 1 statement, got ${len(a.queries)}")
  assert(lastQuery(a).sql == swInsertSql, "sql: ${lastQuery(a).sql}")
  assert(g.asked == 1 && g.lastActor == "u7", "asked ${g.asked}x as '${g.lastActor}'")
  assert(g.lastOp == GuardOp.Create && g.lastTable == "swposts", "op or table wrong")
  assert(g.lastCols == "id,authorId,body", "columns: ${g.lastCols}")
  assert(g.lastBody == "thi", "values must line up with columns, body ${g.lastBody}")
}

fn swCaseDenied(d: ServerDialect) {
  let a = newRawAdapter()
  swRows(a)
  swRepo(a, d, swGuardMode(1)).insert(swPost("hi")) catch e {
    assert(e.message() == "denied u7 swposts", "got ${e.message()}")
    assert(len(a.queries) == 0 && len(a.execs) == 0, "a denied insert must run 0 statements")
    return
  }
  assert(false, "a denied insert must fail")
}

fn swCaseGuardError(d: ServerDialect) {
  let a = newRawAdapter()
  swRows(a)
  swRepo(a, d, swGuardMode(2)).insert(swPost("hi")) catch e {
    assert(
      e.message() == "authz: rule store unavailable",
      "must propagate unchanged: ${e.message()}",
    )
    assert(len(a.queries) == 0 && len(a.execs) == 0, "a guard error must run 0 statements")
    return
  }
  assert(false, "a guard error must fail the insert closed")
}

test "ScopedRepo.insert on Postgres: allowed runs one INSERT, denied and guard error run none (3 of 3)" {
  let d = srPostgres()
  swCaseAllowed(d)
  swCaseDenied(d)
  swCaseGuardError(d)
}

// MySQL has no RETURNING (#7417): the one INSERT is an exec whose reply
// carries the generated id (5, #7427), and the row comes back through one
// SELECT by that id.
fn swCaseAllowedMysql(d: ServerDialect) {
  let a = newRawAdapter()
  swRows(a)
  a.insertId = 5
  let g = swGuardMode(0)
  let got = swRepo(a, d, g).insert(swPost("hi")) catch e {
    assert(false, "insert: ${e.message()}")
    return
  }
  assert(got.id == 5, "the row comes back from the read-back SELECT, id ${got.id}")
  assert(len(a.execs) == 1, "expected 1 INSERT, got ${len(a.execs)}")
  assert(
    a.execs[0].sql == "insert into swposts (author_id, body) values ($1, $2)",
    "sql: ${a.execs[0].sql}",
  )
  assert(len(a.queries) == 1, "expected 1 query, got ${len(a.queries)}")
  assert(
      lastQuery(a).sql ==
      "select * from swposts where id >= $1 and id <= $1 + $2 * cast(@@auto_increment_increment as signed) and mod(id, cast(@@auto_increment_increment as signed)) = mod($1, cast(@@auto_increment_increment as signed)) order by id",
    "sql: ${lastQuery(a).sql}",
  )
  assert(g.asked == 1 && g.lastActor == "u7", "asked ${g.asked}x as '${g.lastActor}'")
  assert(g.lastOp == GuardOp.Create && g.lastTable == "swposts", "op or table wrong")
  assert(g.lastCols == "id,authorId,body", "columns: ${g.lastCols}")
  assert(g.lastBody == "thi", "values must line up with columns, body ${g.lastBody}")
}

test "ScopedRepo.insert on MySQL: allowed runs one INSERT, denied and guard error run none (3 of 3)" {
  let d = srMysql()
  swCaseAllowedMysql(d)
  swCaseDenied(d)
  swCaseGuardError(d)
}

test "insertAll is all-or-nothing: the second of three denied runs 0 statements" {
  let a = newRawAdapter()
  swRows(a)
  let g = swGuardMode(3)
  swRepo(a, srPostgres(), g).insertAll([swPost("a"), swPost("bad"), swPost("c")]) catch e {
    assert(e.message() == "denied u7 swposts", "got ${e.message()}")
    assert(len(a.queries) == 0 && len(a.execs) == 0, "0 statements, got ${len(a.queries)}")
    assert(g.asked == 2, "the check stops at the first denial, asked ${g.asked}x")
    return
  }
  assert(false, "a batch with a denied row must fail")
}

test "insertAll of allowed rows asks about each row, then runs one statement" {
  let a = newRawAdapter()
  swRows(a)
  let g = swGuardMode(3)
  let got = swRepo(a, srPostgres(), g).insertAll([swPost("a"), swPost("b"), swPost("c")]) catch e {
    assert(false, "insertAll: ${e.message()}")
    return
  }
  assert(len(got) == 1, "the recorder returns its one canned row, got ${len(got)}")
  assert(g.asked == 3, "asked ${g.asked}x")
  assert(len(a.queries) == 1, "expected 1 statement, got ${len(a.queries)}")
}

test "insertAll of no rows asks nothing and runs nothing" {
  let a = newRawAdapter()
  let g = swGuardMode(1)
  let got = swRepo(a, srPostgres(), g).insertAll([]SwPost(0)) catch e {
    assert(false, "insertAll: ${e.message()}")
    return
  }
  assert(len(got) == 0 && g.asked == 0 && len(a.queries) == 0, "an empty batch is a no-op")
}

test "a guest is checked with an empty id, an unprotected table is not asked, no guard inserts plainly" {
  let a = newRawAdapter()
  swRows(a)
  let g = swGuardMode(1)
  let db = Db{ pool = newRawPool(a), dialect = srPostgres(), guard = g }
  let denied = false
  db.asGuest().table<SwPost>().insert(swPost("hi")) catch e {
    assert(e.message() == "denied  swposts", "a guest is still denied: ${e.message()}")
    denied = true
  }
  assert(denied, "a guest's insert must be refused")
  assert(g.asked == 1 && g.lastActor == "", "asked ${g.asked}x as '${g.lastActor}'")

  let b = newRawAdapter()
  b.cols = ["id", "body"]
  b.rows = [[Value.Int(1), Value.Text("x")]]
  let g2 = swGuardMode(1)
  let db2 = Db{ pool = newRawPool(b), dialect = srPostgres(), guard = g2 }
  db2.as(swUser{ id = "u7" }).table<RawNote>().insert(RawNote{ id = 0, body = "x" }) catch e {
    assert(false, "unprotected insert: ${e.message()}")
    return
  }
  assert(g2.asked == 0 && len(b.queries) == 1, "a table the guard does not protect is not asked")

  let c = newRawAdapter()
  swRows(c)
  let db3 = Db{ pool = newRawPool(c) }
  db3.as(swUser{ id = "u7" }).table<SwPost>().insert(swPost("hi")) catch e {
    assert(false, "no guard: ${e.message()}")
    return
  }
  assert(len(c.queries) == 1, "a ScopedRepo with no guard inserts like a plain Repo")
}

@table("swtrash") @softDelete class SwTrash {
  id: i64,
  authorId: i64,
  deletedAt: Option<i64>,
}

fn swWriteGuard(): swGuard {
  let g = swGuardMode(4)
  g.filterMode = 3
  g.readMode = 3
  return g
}

fn swChanged(): SwPost {
  return SwPost{ id = 5, authorId = 7, body = "changed" }
}

fn swExpectExec(a: rawAdapter, sqlText: string, args: string) {
  assert(len(a.execs) == 1, "expected one write, got ${len(a.execs)}")
  let q = lastExec(a)
  assert(q.sql == sqlText, "sql: ${q.sql}")
  assert(srArgsText(q.args) == args, "args: ${srArgsText(q.args)}")
}

fn swExpectStatus(e: error, want: int) {
  let (http, ok) = e.(HttpError)
  assert(ok, "guard error lost its status: ${e.message()}")
  assert(http.status() == want, "status ${http.status()}, expected ${want}")
}

const swUpdateSql: string = "update swposts set author_id = $1, body = $2 where id = $3 and (author_id = $4)"
const swDeleteSql: string = "delete from swposts where id = $1 and (author_id = $2)"
const swVisibleSql: string = "select count(*) from swposts where id = $1 and (author_id = $2)"

fn swUpdateAllowed(d: ServerDialect) {
  let a = newRawAdapter()
  a.affected = 1
  let g = swWriteGuard()
  swRepo(a, d, g).update(swChanged()) catch e {
    panic(e.message())
  }
  swExpectExec(a, swUpdateSql, "i7,tchanged,i5,i7")
  assert(len(a.queries) == 0, "successful update must not pre-read")
  assert(
    a.begins == 1 && a.commits == 1 && a.rollbacks == 0 && a.writeTransaction == 1,
    "successful DML must run inside the committed transaction",
  )
  assert(
    g.lastOp == GuardOp.Update && g.lastCols == "id,authorId,body",
    "new-state operation/columns",
  )
  assert(g.lastValues == "i5,i7,tchanged", "new-state values: ${g.lastValues}")
  assert(len(g.filters) == 1 && g.filters[0] == GuardOp.Update, "write filter operation")
  assert(g.firstParams[0] == 4, "write filter starts after SET and key")
}

fn swWriteRefused(d: ServerDialect, deleting: bool, visible: bool) {
  let a = newRawAdapter()
  a.cols = ["n"]
  let count = i64(0)
  let status = 404
  if (visible) {
    count = 1
    status = 403
  }
  a.rows = [[Value.Int(count)]]
  let g = swWriteGuard()
  let r = swRepo(a, d, g)
  let refused = false
  if (deleting) {
    r.delete(i64(5)) catch e {
      swExpectStatus(e, status)
      refused = true
    }
    swExpectExec(a, swDeleteSql, "i5,i7")
  } else {
    r.update(swChanged()) catch e {
      swExpectStatus(e, status)
      refused = true
    }
    swExpectExec(a, swUpdateSql, "i7,tchanged,i5,i7")
  }
  assert(refused, "zero affected rows must resolve to guard error")
  srExpect(a, swVisibleSql, "i5,i7")
  assert(a.begins == 1 && a.commits == 0 && a.rollbacks == 1, "refusal must roll back")
  assert(
    a.writeTransaction == 1 && a.readTransaction == a.writeTransaction,
    "DML and visibility must share the same transaction handle",
  )
  assert(len(g.filters) == 2 && g.filters[1] == GuardOp.Read, "resolve with Read filter")
  assert(g.firstParams[1] == 2, "visibility filter starts after key")
}

fn swNewStateRefused(d: ServerDialect) {
  let a = newRawAdapter()
  let g = swWriteGuard()
  let v = swChanged()
  v.authorId = 8
  swRepo(a, d, g).update(v) catch e {
    swExpectStatus(e, 403)
    assert(g.lastValues == "i5,i8,tchanged", "must check proposed owner")
    assert(
      len(a.execs) == 0 && len(a.queries) == 0 && len(g.filters) == 0 && a.begins == 0,
      "denial before SQL/filter/transaction",
    )
    return
  }
  assert(false, "owner reassignment must be denied")
}

fn swDeleteAllowed(d: ServerDialect) {
  let a = newRawAdapter()
  a.affected = 1
  let g = swWriteGuard()
  swRepo(a, d, g).delete(i64(5)) catch e {
    panic(e.message())
  }
  swExpectExec(a, swDeleteSql, "i5,i7")
  assert(len(a.queries) == 0 && g.asked == 0, "delete needs no new-state check/pre-read")
  assert(g.filters[0] == GuardOp.Delete, "delete filter operation")
}

fn swSixWrites(d: ServerDialect) {
  swUpdateAllowed(d)
  swWriteRefused(d, false, false)
  swWriteRefused(d, false, true)
  swNewStateRefused(d)
  swDeleteAllowed(d)
  swWriteRefused(d, true, true)
}

test "guarded writes Postgres: update ok/404/403/new-state denial, delete ok/403 (6 of 6)" {
  swSixWrites(srPostgres())
}

test "guarded writes MySQL: update ok/404/403/new-state denial, delete ok/403 (6 of 6)" {
  swSixWrites(srMysql())
}

fn swFilterClosed(d: ServerDialect, mode: int) {
  let a = newRawAdapter()
  a.cols = ["n"]
  a.rows = [[Value.Int(1)]]
  let g = swWriteGuard()
  g.filterMode = mode
  swRepo(a, d, g).update(swChanged()) catch e {
    assert(len(a.execs) == 0, "None/error must never run DML")
    if (mode == 1) {
      swExpectStatus(e, 403)
      srExpect(a, swVisibleSql, "i5,i7")
      return
    }
    assert(
      e.message() == "authz: filter unavailable" && len(a.queries) == 0,
      "filter error unchanged",
    )
    return
  }
  assert(false, "None/error must fail closed")
}

fn swSavePaths(d: ServerDialect) {
  let a = newRawAdapter()
  swRows(a)
  a.affected = 1
  a.insertId = 5
  let g = swWriteGuard()
  let r = swRepo(a, d, g)
  let made = r.save(swPost("hi")) catch e {
    panic(e.message())
  }
  assert(made.id == 5 && g.lastOp == GuardOp.Create, "zero key saves through Create")
  a.execs = []rawCall(0)
  a.queries = []rawCall(0)
  let saved = r.save(swChanged()) catch e {
    panic(e.message())
  }
  assert(saved.body == "changed" && g.lastOp == GuardOp.Update, "set key saves through Update")
  swExpectExec(a, swUpdateSql, "i7,tchanged,i5,i7")
  assert(len(a.queries) == 0, "save update must not pre-read")
}

fn swSoftWrites(d: ServerDialect) {
  let a = newRawAdapter()
  a.affected = 1
  let g = swWriteGuard()
  let db = Db{ pool = newRawPool(a), dialect = d, guard = g }
  let r = db.as(swUser{ id = "u7" }).table<SwTrash>()
  r.restore(i64(5)) catch e {
    panic(e.message())
  }
  swExpectExec(
    a,
    "update swtrash set deleted_at = $1 where id = $2 and (author_id = $3)",
    "null,i5,i7",
  )
  assert(g.filters[0] == GuardOp.Update, "restore is Update")
  a.execs = []rawCall(0)
  r.forceDelete(i64(5)) catch e {
    panic(e.message())
  }
  swExpectExec(a, "delete from swtrash where id = $1 and (author_id = $2)", "i5,i7")
  assert(g.filters[1] == GuardOp.Delete, "forceDelete is Delete")
}

test "guarded writes None/error/save/restore/forceDelete use both dialects" {
  for d of [srPostgres(), srMysql()] {
    swFilterClosed(d, 1)
    swFilterClosed(d, 2)
    swSavePaths(d)
    swSoftWrites(d)
  }
}

@table("swplain") class SwPlainVersion {
  id: i64
  name: string
  @version
  version: i64
}

@table("swposts") class SwComposite {
  @id
  id: i64
  @id
  authorId: i64
  body: string
}

@table("swposts") @timestamps class SwStamped {
  id: i64
  authorId: i64
  body: string
  @version
  version: i64
  createdAt: i64
  updatedAt: i64
}

fn swPlainPreserved(d: ServerDialect) {
  let a = newRawAdapter()
  let db = Db{ pool = newRawPool(a), dialect = d }
  db.table<SwPlainVersion>().update(SwPlainVersion{ id = 5, name = "old", version = 3 }) catch e {
    let (stale, ok) = e.(StaleWriteError)
    assert(
      ok && stale.oldVersion == 3 && stale.newVersion == 4,
      "plain stale-version error preserved",
    )
    swExpectExec(
      a,
      "update swplain set name = $1, version = $2 where id = $3 and version = $4",
      "told,i4,i5,i3",
    )
    assert(a.begins == 0 && len(a.queries) == 0, "ordinary update adds no transaction/read")
    return
  }
  assert(false, "plain stale update must fail")
}

fn swCompositeChain(d: ServerDialect) {
  let a = newRawAdapter()
  a.affected = 1
  let g = swWriteGuard()
  let db = Db{ pool = newRawPool(a), dialect = d, guard = g }
  db.as(swUser{ id = "u7" }).table<SwComposite>().where("body", "old").update(
    SwComposite{ id = 5, authorId = 7, body = "changed" },
  ) catch e {
    panic(e.message())
  }
  swExpectExec(
    a, "update swposts set body = $2 where body = $1 and id = $3 and author_id = $4 and (author_id = $5)",
    "told,tchanged,i5,i7,i7",
  )
  assert(g.firstParams[0] == 5, "filter follows chain, SET and both keys")
}

fn swVersionStamp(d: ServerDialect) {
  let a = newRawAdapter()
  a.affected = 1
  let g = swWriteGuard()
  let db = Db{ pool = newRawPool(a), dialect = d, guard = g }
  db.as(swUser{ id = "u7" }).table<SwStamped>().update(
    SwStamped{ id = 5, authorId = 7, body = "v", version = 3, createdAt = 12, updatedAt = 13 },
  ) catch e {
    panic(e.message())
  }
  let q = lastExec(a)
  assert(
      q.sql ==
      "update swposts set author_id = $1, body = $2, version = $3, created_at = $4, updated_at = $5 where id = $6 and version = $7 and (author_id = $8)",
    "version/timestamp SQL: ${q.sql}",
  )
  assert(srArgsText(q.args[0:4]) == "i7,tv,i4,i12", "version increments and creation time stays")
  assert(srArgsText(q.args[5:8]) == "i5,i3,i7", "key, old version, guard arguments")
  assert(srArgText(q.args[4]) != "i13", "updatedAt must be stamped")
  assert(g.lastValues == "i5,i7,tv,i3,i12,i13", "guard checks caller values before stamps")
}

test "guarded writes preserve ordinary stale errors, composite chain keys, versions and timestamps" {
  for d of [srPostgres(), srMysql()] {
    swPlainPreserved(d)
    swCompositeChain(d)
    swVersionStamp(d)
  }
}
