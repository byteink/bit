// pkg/orm/scoped.test.bit — #7035's acceptance for `pkg/orm/scoped.bit`:
// `db.as`, `db.asGuest`, `db.asSystem`, and the `Unscoped` failure of a plain
// `db.table<T>()` on a table the guard protects.
//
// `fakeGuard` (./guard.test.bit) protects exactly the table it is built
// with; `newRawPool`/`newRawAdapter` (./rawsql.test.bit) record every
// statement a repository issues, which is how the "unprotected table is
// unchanged" tests see that SQL still runs and the Unscoped tests see that
// none did. `recSink`/`newLogSink` are ./log.test.bit's. A `Db` is built
// directly (`rawsql.test.bit`'s header says why), so no server is needed.
//
// The error text is built from the table name only, never from a value the
// caller passed: the tests insert a row holding `secretText` and assert it
// appears in no message.

const secretText: string = "s3cr3t-token"

@table("articles") class Article {
  id: i64,
  body: string,
}

@table("notes") class ScopedNote {
  id: i64,
  body: string,
}

class scopedUser {
  id: string,
  name: string,
}

// One failed terminal call: 1 when `e` is `Unscoped` for `table`, status 500,
// naming the table and nothing the caller supplied.
fn unscopedHit(e: error, table: string): int {
  let (u, ok) = e.(Unscoped)
  if (!ok) {
    return 0
  }
  let want = "orm: table '${table}' is protected by authz; use db.as(subject) or db.asSystem()"
  if (u.table != table || e.message() != want || u.status() != 500) {
    return 0
  }
  if (contains(e.message(), secretText)) {
    return 0
  }
  return 1
}

// The 12 terminal calls in three groups of four, so no function carries more
// than a handful of `catch` branches. Each returns how many failed with
// `Unscoped` for `table`.
fn unscopedReads(repo: Repo<Article>, table: string): int {
  let n = 0
  repo.find(1) catch e {
    n = n + unscopedHit(e, table)
  }
  repo.all() catch e {
    n = n + unscopedHit(e, table)
  }
  repo.first() catch e {
    n = n + unscopedHit(e, table)
  }
  repo.count() catch e {
    n = n + unscopedHit(e, table)
  }
  return n
}

fn unscopedWrites(repo: Repo<Article>, table: string): int {
  let a = Article{ id = 1, body = secretText }
  let n = 0
  repo.insert(a) catch e {
    n = n + unscopedHit(e, table)
  }
  repo.update(a) catch e {
    n = n + unscopedHit(e, table)
  }
  repo.save(a) catch e {
    n = n + unscopedHit(e, table)
  }
  repo.delete(1) catch e {
    n = n + unscopedHit(e, table)
  }
  return n
}

fn unscopedBulk(repo: Repo<Article>, table: string): int {
  let a = Article{ id = 1, body = secretText }
  let n = 0
  repo.updateAll() catch e {
    n = n + unscopedHit(e, table)
  }
  repo.deleteAll() catch e {
    n = n + unscopedHit(e, table)
  }
  repo.link(a, "tags", [i64(1)]) catch e {
    n = n + unscopedHit(e, table)
  }
  repo.unlink(a, "tags", [i64(1)]) catch e {
    n = n + unscopedHit(e, table)
  }
  return n
}

fn unscopedTerminals(repo: Repo<Article>, table: string): int {
  return unscopedReads(repo, table) + unscopedWrites(repo, table) + unscopedBulk(repo, table)
}

fn guardedDb(a: rawAdapter, protected: string): Db {
  let g = fakeGuard{ table = protected, checkMsg = "" }
  return Db{ pool = newRawPool(a), guard = g }
}

test "12 of 12 terminal calls on a protected table through db.table<T>() fail with Unscoped (#7035)" {
  let a = newRawAdapter()
  let db = guardedDb(a, "articles")
  let n = unscopedTerminals(db.table<Article>(), "articles")
  assert(n == 12, "expected 12 Unscoped failures, got ${n}")
  assert(len(a.queries) == 0 && len(a.execs) == 0, "no statement may reach the driver")
}

test "chain methods on a protected plain repository stay infallible and keep the Unscoped failure" {
  let a = newRawAdapter()
  let db = guardedDb(a, "articles")
  let chained = db.table<Article>().where("body", "x").orderBy("id").limit(5).offset(1)
  let n = unscopedTerminals(chained, "articles")
  assert(n == 12, "expected 12 Unscoped failures after chaining, got ${n}")
}

test "tx.table<T>() on a protected table fails with Unscoped on every terminal call" {
  let a = newRawAdapter()
  let g = fakeGuard{ table = "articles", checkMsg = "" }
  let tx = TxHandle{ db = newRawPool(a), guard = g }
  let n = unscopedTerminals(tx.table<Article>().inner, "articles")
  assert(n == 12, "expected 12 Unscoped failures, got ${n}")
  let direct = 0
  tx.table<Article>().all() catch e {
    direct = direct + unscopedHit(e, "articles")
  }
  assert(direct == 1, "the TxRepo forward must fail with Unscoped too")
  assert(len(a.queries) == 0 && len(a.execs) == 0, "no statement may reach the driver")
}

test "3 of 3 calls on an unprotected table behave as before: SQL runs, no Unscoped" {
  let a = newRawAdapter()
  a.cols = ["id", "body"]
  a.rows = [[Value.Int(1), Value.Text("hi")]]
  let db = guardedDb(a, "articles")

  let notes = db.table<ScopedNote>()
  let all = notes.all() catch e {
    assert(false, "all on an unprotected table failed: ${e.message()}")
    return
  }
  assert(len(all) == 1 && all[0].body == "hi", "got ${len(all)} row(s)")
  assert(len(a.queries) == 1, "all() must issue 1 query, got ${len(a.queries)}")

  notes.where("id", 1).deleteAll() catch e {
    assert(false, "deleteAll on an unprotected table failed: ${e.message()}")
    return
  }
  assert(len(a.execs) == 1, "deleteAll() must issue 1 statement, got ${len(a.execs)}")

  let plain = Db{ pool = newRawPool(a) }
  plain.table<Article>().all() catch e {
    assert(false, "a Db without a guard must not fail: ${e.message()}")
    return
  }
  assert(len(a.queries) == 2, "an unguarded Db must run the query")
}

test "db.as(subject) and db.asGuest() return a ScopedDb whose table<T>() holds the repo, guard and actor" {
  let a = newRawAdapter()
  let db = guardedDb(a, "articles")
  let who = scopedUser{ id = "u7", name = "Sara" }

  let scoped = db.as(who, "acme")
  assert(scoped.tenant == "acme", "tenant: ${scoped.tenant}")
  let repo = scoped.table<Article>()
  assert(repo.tenant == "acme", "repo tenant: ${repo.tenant}")
  match (repo.guard) {
    Some(g) => assert(g.protects("articles"), "the repo must hold the Db's guard")
    None => assert(false, "the repo must hold the Db's guard")
  }
  match (repo.actor) {
    Some(act) => assert(act.id == "u7", "actor id: ${act.id}")
    None => assert(false, "db.as must carry its subject")
  }
  assert(repo.inner.unscoped == "", "a scoped repository must not be preset to Unscoped")

  let guest = db.asGuest()
  assert(guest.tenant == "", "a guest names no tenant by default")
  match (guest.table<Article>().actor) {
    Some(_) => assert(false, "a guest has no actor")
    None => {}
  }
}

test "db.asSystem() returns working Repos for 2 of 2 protected tables and logs 2 of 2 lines" {
  let a = newRawAdapter()
  a.cols = ["id", "body"]
  a.rows = [[Value.Int(1), Value.Text("hi")]]
  let sink = newLogSink()
  let both = ProtectsBoth{ a = "articles", b = "notes" }
  let db = Db{ pool = newRawPool(a), guard = both, logger = Logger(sink) }

  let sys = db.asSystem()
  let arts = sys.table<Article>().all() catch e {
    assert(false, "system access to a protected table failed: ${e.message()}")
    return
  }
  let notes = sys.table<ScopedNote>().all() catch e {
    assert(false, "system access to a protected table failed: ${e.message()}")
    return
  }
  assert(len(arts) == 1 && len(notes) == 1, "both system repositories must read their rows")
  assert(len(a.queries) == 2, "2 queries must reach the driver, got ${len(a.queries)}")

  assert(len(sink.lines) == 2, "expected 2 log lines, got ${len(sink.lines)}")
  assert(sink.lines[0] == "[debug] orm: system access to articles", "got: ${sink.lines[0]}")
  assert(sink.lines[1] == "[debug] orm: system access to notes", "got: ${sink.lines[1]}")
}

test "db.asSystem() without a logger works and writes nothing" {
  let a = newRawAdapter()
  a.cols = ["n"]
  a.rows = [[Value.Int(3)]]
  let db = guardedDb(a, "articles")
  db.asSystem().table<Article>().count() catch e {
    assert(false, "system access failed: ${e.message()}")
    return
  }
  assert(len(a.queries) == 1, "the system repository must run its query")
}

// A guard protecting two tables, for the asSystem test.
class ProtectsBoth {
  a: string
  b: string

  protects(t: string): bool {
    return t == this.a || t == this.b
  }

  filter(
    actor: Actor,
    op: GuardOp,
    t: string,
    dialect: ServerDialect,
    firstParam: int,
  ): GuardFilter! {
    return GuardFilter.All
  }

  allows(actor: Actor, op: GuardOp, t: string, columns: []string, values: []Value): bool! {
    return true
  }

  denied(actor: Actor, op: GuardOp, t: string): error {
    return newError("denied")
  }

  notFound(t: string): error {
    return newError("not found")
  }

  check(): ()! {}
}
