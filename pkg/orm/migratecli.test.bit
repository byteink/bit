// pkg/orm/migratecli.test.bit — migrateMain's own parsing and dispatch
// layer (O3b, #6310). Reuses `runner.test.bit`'s `rnExecutor`/`pgDialect`/
// `migPlain` (same module — `bit test` loads every `.test.bit` file of a
// module together, SPEC §17.1) rather than a second fake driver:
// `runMigrate`/`runRollback`/`runStatus` below call the exact same
// `migrate`/`rollback` that file already proves against a real batch
// sequence. This file's own job is the CLI wiring on top — subcommand/
// `--url` parsing, the lines it prints, and that a database URL is never
// one of them — so nothing here opens a real connection; `migrateMain`'s
// own `open` call is exercised end to end only by O4's live gate.

test "no subcommand parses to migrate with no --url" {
  let parsed = parseArgs(["bit-migrate"]) catch e {
    panic("parseArgs: ${e.message()}")
  }
  assert(parsed.sub == "", "expected the empty (migrate) subcommand, got '${parsed.sub}'")
  assert(parsed.url == "", "expected no --url, got '${parsed.url}'")
}

test "rollback and status parse, --url is read regardless of position" {
  let before = parseArgs(["bit-migrate", "--url", "u1", "rollback"]) catch e {
    panic("parseArgs: ${e.message()}")
  }
  assert(before.sub == "rollback", "expected rollback, got '${before.sub}'")
  assert(before.url == "u1", "expected u1, got '${before.url}'")

  let after = parseArgs(["bit-migrate", "status", "--url", "u2"]) catch e {
    panic("parseArgs: ${e.message()}")
  }
  assert(after.sub == "status", "expected status, got '${after.sub}'")
  assert(after.url == "u2", "expected u2, got '${after.url}'")
}

test "an unknown subcommand fails, naming neither the URL nor the bad token" {
  parseArgs(["bit-migrate", "bogus"]) catch e {
    assert(
      contains(e.message(), "unknown subcommand"),
      "expected an unknown-subcommand message, got: ${e.message()}",
    )
    return
  }
  panic("parseArgs: expected the unknown subcommand to fail")
}

test "--url wins over DATABASE_URL, and both empty fails naming --url and DATABASE_URL" {
  let flagWins = resolveUrl("flag", "env") catch e {
    panic("resolveUrl: ${e.message()}")
  }
  assert(flagWins == "flag", "the --url flag must win")
  let envFallback = resolveUrl("", "env") catch e {
    panic("resolveUrl: ${e.message()}")
  }
  assert(envFallback == "env", "DATABASE_URL must be the fallback")
  resolveUrl("", "") catch e {
    assert(
      contains(e.message(), "--url") && contains(e.message(), "DATABASE_URL"),
      "expected the missing-URL message to name both, got: ${e.message()}",
    )
    return
  }
  panic("resolveUrl: expected a failure with neither --url nor DATABASE_URL set")
}

test "migrateMain reports an unknown subcommand as exit 1, no database contacted" {
  let files = [MigrationFile{ name = "0001_init", m = migPlain("widgets") }]
  let code = migrateMain(files, ["bit-migrate", "bogus"])
  assert(code == 1, "expected exit code 1 for an unknown subcommand, got ${code}")
}

test "runMigrate prints one applied line per migration actually run, in order" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let files = [
    MigrationFile{ name = "0001_a", m = migPlain("widgets") },
    MigrationFile{ name = "0002_b", m = migPlain("widgets") },
  ]
  let lines = runMigrate(db, pgDialect(), files) catch e {
    panic("runMigrate: ${e.message()}")
  }
  assert(
    len(lines) == 2 && lines[0] == "applied 0001_a" && lines[1] == "applied 0002_b",
    "unexpected migrate output: ${join(lines, " | ")}",
  )
}

test "runRollback prints one rolled back line per migration, newest first" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let files = [
    MigrationFile{ name = "0001_a", m = migPlain("widgets") },
    MigrationFile{ name = "0002_b", m = migPlain("widgets") },
  ]
  runMigrate(db, pgDialect(), files) catch e {
    panic("setup migrate: ${e.message()}")
  }
  let lines = runRollback(db, pgDialect(), files) catch e {
    panic("runRollback: ${e.message()}")
  }
  assert(
    len(lines) == 2 && lines[0] == "rolled back 0002_b" && lines[1] == "rolled back 0001_a",
    "unexpected rollback output: ${join(lines, " | ")}",
  )
}

test "runStatus reports applied-with-batch and pending, in registry order" {
  let db = rnExecutor{ history = []HistoryEntry(0), log = []string(0), failOn = "" }
  let files = [
    MigrationFile{ name = "0001_a", m = migPlain("widgets") },
    MigrationFile{ name = "0002_b", m = migPlain("widgets") },
  ]
  runMigrate(db, pgDialect(), [files[0]]) catch e {
    panic("setup migrate: ${e.message()}")
  }
  let lines = runStatus(db, pgDialect(), files) catch e {
    panic("runStatus: ${e.message()}")
  }
  assert(
    len(lines) == 2 && lines[0] == "applied  0001_a  batch 1" && lines[1] == "pending  0002_b",
    "unexpected status output: ${join(lines, " | ")}",
  )
}
