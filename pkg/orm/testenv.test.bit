// pkg/orm/testenv.test.bit — `locateBit`/`BitLocation`, the repo/bin/stdlib
// locator several source-level "no forbidden call" tests share (SPEC
// §17.1). Was declared in raw.test.bit (retired with `whereRaw`/
// `orderByField`/`orderByRaw`, #6296); `locateBit` itself is generic and
// stays, anchored on `pkg/orm/log.bit` (this file's own sibling, always
// present) rather than the retired `raw.bit`.
//
// `count`/`exists`/`readFile`/`envOr` are imported here — this file's
// canonical site (SPEC §17.1's flat namespace carries them to every
// sibling); a second import of any would be E0042. `scratchDir`/
// `resetDir`/`onlyFile`/`findRepoRoot` below (and the `cwd`/`isDir`/
// `mkdir`/`readDir`/`remove`/`writeFile`/`env`/`run` imports they and their
// many callers need) moved here from `generate.test.bit` when #6300 deleted
// that file's own generator tests — this is now their canonical site too.
import { count, hasSuffix } from "std/strings"
import { cwd, exists, isDir, mkdir, readDir, readFile, remove, writeFile } from "std/fs"
import { env, envOr } from "std/os"
import { run } from "std/process"

class BitLocation { bin: string, stdlib: string, repo: string }

// Same contract as pkg/web/node.test.bit's own `locateBit`: a degrade to an
// empty `BitLocation` never fails the gate, since `BIT_BIN`/`BIT_STDLIB`/
// `BIT_REPO` aren't guaranteed to be set outside `test-package-orm`'s own
// Gate.
fn locateBit(): BitLocation {
  let bin = envOr("BIT_BIN", "")
  let stdlib = envOr("BIT_STDLIB", "")
  let repo = envOr("BIT_REPO", "")
  let fromEnv = len(bin) > 0 && exists(bin) && len(stdlib) > 0 && exists(stdlib)
  fromEnv = fromEnv && len(repo) > 0 && exists("${repo}/pkg/orm/log.bit")
  if (fromEnv) {
    return BitLocation{ bin = bin, stdlib = stdlib, repo = repo }
  }
  if (exists("bit-out/bin/bit") && exists("stdlib") && exists("pkg/orm/log.bit")) {
    return BitLocation{ bin = "bit-out/bin/bit", stdlib = "stdlib", repo = "." }
  }
  return BitLocation{ bin = "", stdlib = "", repo = "" }
}

test "locateBit resolves a repo carrying pkg/orm/log.bit, or degrades to empty rather than failing" {
  let loc = locateBit()
  if (len(loc.repo) == 0) {
    print("locateBit: repo not locatable (set BIT_REPO) — skipping\n")
    return
  }
  assert(exists("${loc.repo}/pkg/orm/log.bit"), "locateBit's own repo must carry pkg/orm/log.bit")
  assert(exists(loc.bin), "locateBit's own bin must exist: ${loc.bin}")
  assert(exists(loc.stdlib), "locateBit's own stdlib must exist: ${loc.stdlib}")
}

// A fresh, empty scratch directory under $TMPDIR for one test — never
// reused across a stale run, since a leftover file from a killed prior run
// would corrupt an assertion that counts what a test itself wrote.
fn scratchDir(label: string): string {
  let dir = "${envOr("TMPDIR", "/tmp")}/ormtest-${label}"
  resetDir(dir)
  return dir
}

fn resetDir(dir: string) {
  if (!exists(dir)) {
    return
  }
  let names = readDir(dir) catch _ {
    []string(0)
  }
  for n of names {
    remove("${dir}/${n}") catch _ {}
  }
  remove(dir) catch _ {}
}

fn onlyFile(dir: string): string {
  let names = readDir(dir) catch e {
    panic("readDir(${dir}): ${e.message()}")
  }
  assert(
    len(names) == 1,
    "expected exactly one file in ${dir}, found ${len(names)}: ${join(names, ", ")}",
  )
  return readFile("${dir}/${names[0]}") catch e {
    panic("readFile: ${e.message()}")
  }
}

// The checkout root as an ABSOLUTE path. `bit.lock`'s local-path entries
// resolve against the SCRATCH PROJECT's own directory, not this process's
// cwd (`compiler/projectpkg.bit`'s `resolvePackageImportUncached`), so the
// literal "." this used to fall back to named the temp project's own
// "pkg/orm" the instant `BIT_REPO` was unset (#5373) — a bare `bit test
// pkg/orm` reported a false "cannot find module \"orm\"" on a green tree.
// `BIT_REPO` (what `./make` exports) wins when set; otherwise walked up
// from `cwd()` looking for this package's own `pkg/orm`, the identical
// override-then-walk shape `_tests_/bit/docsrunner`'s `repoRoot()` uses for
// the same problem. Returns "" when neither locates it, so the caller can
// skip instead of running `bit check`/`bit run` against a directory that
// can only be wrong.
fn findRepoRoot(): string {
  let override = envOr("BIT_REPO", "")
  if (len(override) > 0) {
    return override
  }
  let base = cwd() catch _ {
    return ""
  }
  for c of [".", "..", "../.."] {
    let candidate = "${base}/${c}"
    if (isDir("${candidate}/pkg/orm")) {
      return candidate
    }
  }
  return ""
}
