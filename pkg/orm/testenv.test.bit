// pkg/orm/testenv.test.bit — `locateBit`/`BitLocation`, the repo/bin/stdlib
// locator several source-level "no forbidden call" tests share (SPEC
// §17.1). Was declared in raw.test.bit (retired with `whereRaw`/
// `orderByField`/`orderByRaw`, #6296); `locateBit` itself is generic and
// stays, anchored on `pkg/orm/log.bit` (this file's own sibling, always
// present) rather than the retired `raw.bit`.
//
// `count`/`exists`/`readFile`/`envOr` are imported here — this file's
// canonical site (SPEC §17.1's flat namespace carries them to every
// sibling); a second import of any would be E0042.
import { count, hasSuffix } from "std/strings"
import { exists, readFile } from "std/fs"
import { envOr } from "std/os"

class BitLocation { bin: string, stdlib: string, repo: string }

// Same contract as pkg/web/node.test.bit's own `locateBit`: a degrade to an
// empty `BitLocation` never fails the gate, since `BIT_BIN`/`BIT_STDLIB`/
// `BIT_REPO` aren't guaranteed to be set outside `test-package-orm`'s own
// Gate.
fn locateBit(): BitLocation {
  let bin = envOr("BIT_BIN", "")
  let stdlib = envOr("BIT_STDLIB", "")
  let repo = envOr("BIT_REPO", "")
  let fromEnv = len(bin) > 0 && exists(bin) && len(stdlib) > 0 && exists(stdlib)
  fromEnv = fromEnv && len(repo) > 0 && exists("${repo}/pkg/orm/log.bit")
  if (fromEnv) {
    return BitLocation{ bin = bin, stdlib = stdlib, repo = repo }
  }
  if (exists("bit-out/bin/bit") && exists("stdlib") && exists("pkg/orm/log.bit")) {
    return BitLocation{ bin = "bit-out/bin/bit", stdlib = "stdlib", repo = "." }
  }
  return BitLocation{ bin = "", stdlib = "", repo = "" }
}
