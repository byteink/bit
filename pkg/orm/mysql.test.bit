// pkg/orm/mysql.test.bit — #5070's acceptance: exact rendered DDL text for
// every `SchemaOp` kind and every `ColumnType` variant `schema.bit` actually
// carries, plus every divergence from `postgres.bit` (mysql.bit's own
// header) named where a user will hit it: the zone-aware-type naming trap,
// `auto_increment` vs `identity`, `decimal(38,9)` vs unconstrained
// `numeric`, an indexed `text` column's required prefix length, no
// `CONCURRENTLY` equivalent, and every statement being non-transactional.
//
// EVERY ASSERTION IS AN EXACT STRING COMPARE, NOT A SHAPE CHECK — same
// discipline `postgres.test.bit` uses, for the same reason (that file's own
// header).
//
// THIS TICKET'S ACCEPTANCE NAMES `i32`/`f64`/`[]byte`/A BARE `Date` -
// `ColumnType` (`schema.bit`) HAS NONE OF THEM. It has exactly eight
// variants: `Id`, `Int`, `String(length)`, `Text`, `Bool`, `Timestamp`,
// `Decimal`, `Json` (the last added by #5086, after this ticket was
// written - covered below alongside the other seven). `docs/schema.md`'s
// "Money columns, and what is still missing" section, written for #5326
// (owner decision 2026-09-15, three days after
// this ticket was filed), weighs each of those three and leaves them out on
// purpose - "no table in this package ... has needed one yet". Widening
// `ColumnType` to satisfy #5070's literal wording would reopen that
// decision and reach into `schema.bit`, outside this ticket's own file list
// (`mysql.bit`/`mysql.test.bit`/`dialect.bit`). This file instead covers
// every variant `ColumnType` actually has, exactly - `i64` is `Int`, "string
// ... with and without a length" is `String(length)`/`Text` (schema.bit's
// own two string-shaped variants: a bounded `varchar` and an unbounded
// `text`), `decimal` is `Decimal`, and `DateTime` is `Timestamp`. `i32`,
// `f64`, `[]byte` and a bare `Date` stay untested because there is no
// `ColumnType` node a migration could build to exercise them - filed as a
// ticket comment, not silently dropped.
//
// `contains`/`toUpper` are not imported here - postgres.bit/query.test.bit
// already import them and a Bit import binds package-wide (postgres.bit's
// own header on this).

// Every `ColumnType` variant, a foreign key, an index and a raw()
// passthrough in one `CreateTable` - the MySQL-spelled sibling of
// `postgres.test.bit`'s own "every column type" test, covering every
// divergence `mysql.bit`'s header documents: `auto_increment` (not
// `identity`), `tinyint(1)` (not `boolean`), `decimal(38,9)` (not
// unconstrained `numeric`), `timestamp` (not `datetime`), backtick
// identifiers (not double-quoted), and every statement flagged
// non-transactional.
test "Mysql.render(CreateTable): every column type, a foreign key, an index and a raw passthrough" {
  let op = table("people", (t) => {
    t.id("id")
    t.string("name", 100)
    t.string("email", 255).unique()
    t.text("bio").nullable()
    t.bool("is_active")
    t.decimal("salary").nullable()
    t.json("preferences").nullable()
    t.timestamp("joined_at").nullable()
    t.int("team_id")
    t.index("team_id")
    t.foreign("team_id").references("teams", "id").onDelete(ReferentialAction.Cascade)
    t.raw("CREATE INDEX people_note_idx ON people (note)")
  })

  let stmts = Mysql{}.render(op)
  assert(len(stmts) == 3, "statement count: ${len(stmts)}")

  let want = "create table `people` (\n" +
    "  `id` bigint auto_increment primary key,\n" +
    "  `name` varchar(100) not null,\n" +
    "  `email` varchar(255) not null unique,\n" +
    "  `bio` text,\n" +
    "  `is_active` tinyint(1) not null,\n" +
    "  `salary` decimal(38,9),\n" +
    "  `preferences` json,\n" +
    "  `joined_at` timestamp,\n" +
    "  `team_id` bigint not null,\n" +
    "  constraint `people_team_id_fkey` foreign key (`team_id`) references `teams` (`id`) on delete cascade\n" +
    ");"
  assert(stmts[0].sql == want, "create table sql:\n${stmts[0].sql}")
  assert(!stmts[0].transactional, "MySQL DDL is never transactional (mysql.bit's own header)")

  assert(
    stmts[1].sql == "create index `people_team_id_idx` on `people` (`team_id`);",
    "index sql: ${stmts[1].sql}",
  )
  assert(!stmts[1].transactional, "a t.index() statement must be non-transactional on MySQL")

  assert(
    stmts[2].sql == "CREATE INDEX people_note_idx ON people (note)",
    "raw sql was not carried verbatim: ${stmts[2].sql}",
  )
  assert(!stmts[2].transactional, "a raw() statement must be non-transactional on MySQL")
}

// `t.id` renders `auto_increment`, MySQL's own mechanism - never
// `identity`, which is Postgres/SQL-standard syntax MySQL does not have
// (mysql.bit's own header, quoting this ticket's own constraint).
test "Mysql.render(CreateTable): t.id is auto_increment, never identity" {
  let op = table("widgets", (t) => {
    t.id("id")
  })
  let stmts = Mysql{}.render(op)
  assert(
    stmts[0].sql == "create table `widgets` (\n  `id` bigint auto_increment primary key\n);",
    "id column sql: ${stmts[0].sql}",
  )
  assert(
    contains(stmts[0].sql, "auto_increment"),
    "must contain 'auto_increment': ${stmts[0].sql}",
  )
  assert(!contains(stmts[0].sql, "identity"), "must not contain 'identity': ${stmts[0].sql}")
}

// THE NAMING TRAP (mysql.bit's own header): MySQL's zone-aware type is
// `TIMESTAMP`, not `DATETIME` - the opposite name from Postgres, where
// `timestamp` is zone-naive. Porting the Postgres mapping by name would
// land on `datetime`, silently making every read zone-naive.
test "Mysql.render(CreateTable): a Timestamp column renders timestamp, never datetime" {
  let op = table("events", (t) => {
    t.timestamp("occurred_at")
  })
  let stmts = Mysql{}.render(op)
  assert(
    stmts[0].sql == "create table `events` (\n  `occurred_at` timestamp not null\n);",
    "timestamp column sql: ${stmts[0].sql}",
  )
  assert(contains(stmts[0].sql, "timestamp"), "must contain 'timestamp': ${stmts[0].sql}")
  assert(
    !contains(toUpper(stmts[0].sql), "DATETIME"),
    "must not contain 'datetime': ${stmts[0].sql}",
  )
}

// `Decimal` renders `decimal(38,9)`, unlike `postgres.bit`'s unconstrained
// `numeric` - MySQL has no arbitrary-precision decimal type, so this bound
// is unavoidable, and unlike Postgres it CAN round a value needing more
// than 9 fractional digits (mysql.bit's own header).
test "Mysql.render(CreateTable): a decimal column renders decimal(38,9)" {
  let op = table("accounts", (t) => {
    t.decimal("balance")
  })
  let stmts = Mysql{}.render(op)
  assert(
    stmts[0].sql == "create table `accounts` (\n  `balance` decimal(38,9) not null\n);",
    "decimal column sql: ${stmts[0].sql}",
  )
}

// `Json` renders the lowercase keyword `json` (#5086), MySQL's own type
// name being case-insensitive (mysql.bit's own header) - matching every
// other keyword this dialect renders lowercase. One `t.json(...)` call
// covers both a `Json` tree field ("payload") and a `@json` class field
// ("config"); a `text` field on the same table is unaffected.
test "Mysql.render(CreateTable): a Json field and a @json class field both render json; a text field is unaffected" {
  let op = table("webhooks", (t) => {
    t.id("id")
    t.text("notes")
    t.json("payload")
    t.json("config").nullable()
  })
  let stmts = Mysql{}.render(op)
  let want = "create table `webhooks` (\n" +
    "  `id` bigint auto_increment primary key,\n" +
    "  `notes` text not null,\n" +
    "  `payload` json not null,\n" +
    "  `config` json\n" +
    ");"
  assert(stmts[0].sql == want, "json column sql:\n${stmts[0].sql}")
  assert(!stmts[0].transactional, "MySQL DDL is never transactional (mysql.bit's own header)")
}

// A `text` column has no implicit key length; MySQL refuses to index one
// without an explicit prefix, a limit Postgres never has (mysql.bit's own
// header on `mysqlIndexColumnRef`). Postgres' identical `bio` index needs
// no prefix at all (`postgres.test.bit`'s own "every column type" test).
test "Mysql.render(CreateTable): indexing a text column emits a key-length prefix" {
  let op = table("articles", (t) => {
    t.text("bio").nullable()
    t.index("bio")
  })
  let stmts = Mysql{}.render(op)
  assert(len(stmts) == 2, "statement count: ${len(stmts)}")
  assert(
    stmts[1].sql == "create index `articles_bio_idx` on `articles` (`bio`(255));",
    "text index sql must carry a prefix length: ${stmts[1].sql}",
  )
}

// No CREATE INDEX CONCURRENTLY equivalent exists on MySQL (mysql.bit's own
// header) - a t.index() never emits one, and neither does a raw()
// passthrough scan for one the way postgres.bit's rawStatement does.
test "Mysql.render: never emits CONCURRENTLY" {
  let op = table("people", (t) => {
    t.id("id")
    t.string("email", 255)
    t.index("email")
  })
  let stmts = Mysql{}.render(op)
  for s of stmts {
    assert(!contains(toUpper(s.sql), "CONCURRENTLY"), "must never emit CONCURRENTLY: ${s.sql}")
  }
}

// MySQL DDL is not transactional (mysql.bit's own header) - every statement
// this dialect renders, across every SchemaOp kind, is flagged
// non-transactional, unlike Postgres where only a CONCURRENTLY raw()
// statement is.
test "Mysql.render: every statement is non-transactional, across every SchemaOp kind" {
  let createStmts = Mysql{}.render(
    table("t1", (t) => {
      t.id("id")
    }),
  )
  let alterStmts = Mysql{}.render(
    alter("t1", (t) => {
      t.addString("phone", 20).nullable()
    }),
  )
  let dropStmts = Mysql{}.render(drop("t1"))
  for s of createStmts {
    assert(!s.transactional, "create statement must be non-transactional: ${s.sql}")
  }
  for s of alterStmts {
    assert(!s.transactional, "alter statement must be non-transactional: ${s.sql}")
  }
  for s of dropStmts {
    assert(!s.transactional, "drop statement must be non-transactional: ${s.sql}")
  }
}

// AddColumn, DropColumn and RenameColumn each render their own statement
// shape - the MySQL-spelled sibling of postgres.test.bit's own "add, drop
// and rename each render distinctly" test. MySQL 8's ALTER TABLE ... RENAME
// COLUMN ... TO ... is the same shape as Postgres' (this ticket's own note
// that MySQL 8 does online DDL by default for most ALTERs).
test "Mysql.render(AlterTable): add, drop and rename each render distinctly" {
  let op = alter("people", (t) => {
    t.addString("phone", 20).nullable()
    t.dropColumn("legacy_flag")
    t.renameColumn("email", "email_address")
  })
  let stmts = Mysql{}.render(op)
  assert(len(stmts) == 3, "statement count: ${len(stmts)}")

  assert(
    stmts[0].sql == "alter table `people` add column `phone` varchar(20);",
    "add column sql: ${stmts[0].sql}",
  )
  assert(
    stmts[1].sql == "alter table `people` drop column `legacy_flag`;",
    "drop column sql: ${stmts[1].sql}",
  )
  assert(
    stmts[2].sql == "alter table `people` rename column `email` to `email_address`;",
    "rename column sql: ${stmts[2].sql}",
  )
}

// alter(): primaryKey (#5397) renders a bare ADD PRIMARY KEY on MySQL —
// SetPrimaryKey is the caller's own assertion that no key exists yet
// (schema.bit's header, #5400), so this needs no DROP half at all.
test "Mysql.render(AlterTable): primaryKey renders a bare ADD PRIMARY KEY" {
  let op = alter("memberships", (t) => {
    t.primaryKey("user_id", "team_id")
  })
  let stmts = Mysql{}.render(op)
  assert(len(stmts) == 1, "statement count: ${len(stmts)}")
  assert(
    stmts[0].sql == "alter table `memberships` add primary key (`user_id`, `team_id`);",
    "add primary key sql: ${stmts[0].sql}",
  )
  assert(!stmts[0].transactional, "must render transactional: false, like every MySQL statement")
}

// alter(): replacePrimaryKey (#5400) renders DROP PRIMARY KEY, ADD PRIMARY
// KEY in ONE statement — ReplacePrimaryKey is the caller's own assertion
// that a key already exists (schema.bit's header), so InnoDB validates the
// AUTO_INCREMENT-must-be-keyed rule against the FINAL shape, never an
// intermediate keyless one (mysql.bit's own header on this arm).
test "Mysql.render(AlterTable): replacePrimaryKey renders DROP then ADD in one statement" {
  let op = alter("memberships", (t) => {
    t.replacePrimaryKey("user_id", "team_id")
  })
  let stmts = Mysql{}.render(op)
  assert(len(stmts) == 1, "statement count: ${len(stmts)}")
  assert(
      stmts[0].sql ==
      "alter table `memberships` drop primary key, add primary key (`user_id`, `team_id`);",
    "replace primary key sql: ${stmts[0].sql}",
  )
  assert(!stmts[0].transactional, "must render transactional: false, like every MySQL statement")
}

// drop(): a bare DROP TABLE, identifier backtick-quoted.
test "Mysql.render(DropTable): a quoted DROP TABLE" {
  let op = drop("legacy_events")
  let stmts = Mysql{}.render(op)
  assert(len(stmts) == 1, "statement count: ${len(stmts)}")
  assert(stmts[0].sql == "drop table `legacy_events`;", "drop table sql: ${stmts[0].sql}")
}

// SECURITY: an identifier carrying a backtick (the one character that can
// end a MySQL quoted identifier) is neutralised by doubling it, not
// rejected and not passed through - the MySQL-spelled sibling of
// postgres.test.bit's own "cannot break out of its quoting" test.
test "Mysql.render: an identifier containing a backtick cannot break out of its quoting" {
  let op = table("widgets`; drop table users; --", (t) => {
    t.id("id")
  })
  let stmts = Mysql{}.render(op)
  let want = "create table `widgets``; drop table users; --` (\n" +
    "  `id` bigint auto_increment primary key\n" +
    ");"
  assert(stmts[0].sql == want, "hostile identifier was not fully neutralised:\n${stmts[0].sql}")
}
