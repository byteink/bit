// pkg/orm/repo.bit - Repo<T>, the repository `db.table<T>()`/`tx.table<T>()`
// hand back (the owner-locked target, .claude/kb/data-packages-dx.md): the
// query chain and the write path over one table, holding the connection.
//
// A Repo is a stable handle: every chain method returns a new Repo (`next`
// below) and never changes its receiver, so `people` always means the whole
// table and a saved `people.where(...)` can be reused (#6283).
//
// No panic for anything a caller can cause (#6269): a bad column from a chain
// method is recorded in `errText` and reported by the next terminal call.
//
// Known gap: `__values()` covers string/int/i64/bool/f64/[]byte (and Option
// of those); `columnsForValues` fails naming the class when a column type
// falls outside that set rather than writing a value to the wrong column.
import { sqlValue } from "std/sql"
import { now } from "std/time"

// The find chain and the write path over `T`'s table, holding the
// connection it was built from — `db.table<T>()`/`tx.table<T>()` are the
// only constructors (`pkg/orm/db.bit`).
export class Repo<T: Tabled> {
  db: Data
  // #6277/#6275: the `ServerDialect` `Db.open()` derives once and carries
  // down (`pkg/orm/db.bit`) — a future many-to-many `link`/`unlink` would
  // need it for `manytomany.bit`'s `attach` without asking for it again at
  // the call site. Not read anywhere in this file yet.
  dialect: ServerDialect
  wheres: []string
  args: []Value
  orderBys: []string
  limitN: int
  hasLimit: bool
  offsetN: int
  hasOffset: bool
  // Every relation name queued by `with()` — `all()`/`first()`'s own
  // `loadWith` (`// relations` below) eager-loads each, in order, right
  // after fetching their own rows.
  withNames: []string
  // #6269: NO panic in this file for anything a caller can cause — a bad
  // column name from `where`/`orderBy` (chain methods that
  // return `Repo<T>`, never `Repo<T>!`, so they cannot `fail` themselves)
  // is recorded here instead, and every terminal method (`checkErr` below)
  // fails with it before building any SQL.
  errText: string
  // #6274, this file's own "soft delete and bulk writes" block below:
  // `withDeleted()`'s own flag (default excludes a `@softDelete` row, see
  // `trashColumn`/`whereSql`) and `set()`'s own accumulated `SET` list for
  // `updateAll()` — grouped with the other chain state above rather than in
  // the block itself, the same way `wheres`/`args` already are for `where`.
  includeDeleted: bool
  sets: []string

  // INSERT, RETURNING the row the database wrote back — rule 7: the
  // returned `T` carries a database-generated id, `v` itself is never
  // mutated. A sole database-generated `@id` field is left out of the
  // column list, the same `generatedIdField` exclusion
  // `pkg/orm/write.bit`'s own `insertSql` makes, reused here unchanged.
  export insert(v: T): T! {
    this.checkErr()?
    let cols = this.columnsForValues(v)?
    let genId = generatedIdField(this.desc())
    // #6274: `@timestamps` fills `createdAt`/`updatedAt` on every insert —
    // see this file's own "soft delete and bulk writes" block for
    // `stampTimestamps`, a no-op when `T` carries no `@timestamps` mark.
    let vals = this.stampTimestamps(cols, v.__values(), false)?
    let colNames = []string(0)
    let marks = []string(0)
    let args = []Value(0)
    let i = 0
    while (i < len(cols)) {
      let f = cols[i]
      if (f.name != genId) {
        colNames = append(colNames, columnName(f))
        args = append(args, vals[i])
        marks = append(marks, "$${len(args)}")
      }
      i = i + 1
    }
    let sqlText = "insert into ${T.__tableName()} (${join(colNames, ", ")}) values (${join(
      marks,
      ", ",
    )}) returning *"
    let rows = this.db.query(sqlText, args)?
    defer rows.close()
    if (!rows.next()?) {
      fail newError("orm: insert into '${T.__tableName()}' returned no row from RETURNING")
    }
    return T.__fromRow(rows)?
  }

  // Exactly one row matching the primary key, or an error naming zero or
  // more than one — never a bare unbounded SELECT, the same `LIMIT 2` bound
  // `pkg/orm/query.bit`'s own `oneOrFail()` enforces. Reads the row itself
  // rather than going through `sqlFindOneOrFail<T>` (std/sql/row.bit) —
  // #6265 fixed the compiler bug that once made a closure over `T.__fromRow`
  // fail to lower when handed to another generic function; routing this
  // through `sqlFindOneOrFail` is now possible but not done here (filed
  // separately, not a workaround left over from the bug).
  //
  // #6282: hides a `@softDelete` row like every other read — the locked
  // target's own example calls `find`/`where`/`all` off the SAME `Repo<T>`
  // (`.claude/kb/data-packages-dx.md`: `db.table<T>()` runs once, every
  // statement after reuses that one variable), so `find` staying unaware of
  // `withDeleted()` would make `posts.withDeleted().find(id)` silently keep
  // hiding the row it exists to un-hide. `this.includeDeleted` is read here
  // exactly the way `whereSql` already reads it for `all`/`first`.
  export find(id: Value): T! {
    this.checkErr()?
    let col = this.singleKeyColumn()?
    let softCol = this.trashColumn()
    this.checkErr()?
    let sqlText = "select * from ${T.__tableName()} where ${col} = $1"
    if (softCol != "" && !this.includeDeleted) {
      sqlText = sqlText + " and ${softCol} is null"
    }
    sqlText = sqlText + " limit 2"
    let rows = this.db.query(sqlText, [id])?
    defer rows.close()
    if (!rows.next()?) {
      fail newError("orm: no row in '${T.__tableName()}' matches the given id")
    }
    let row = T.__fromRow(rows)?
    if (rows.next()?) {
      fail newError("orm: more than one row in '${T.__tableName()}' matches the given id")
    }
    return row
  }

  // `column = $n`, `val` turned into a bound `Value` via `sqlValue<V>`
  // (rule 5) — a caller never spells `Value.Text(...)`.
  //
  // #6283 (integrator): NEVER mutates `this` — `Repo<T>` is a STABLE HANDLE,
  // the locked target's own example (`.claude/kb/data-packages-dx.md`)
  // reuses one `db.table<T>()` result for every following, independent
  // statement (`posts.where(...).all()?`, then later `posts.orderBy(...)
  // .first()?`), and `let q = people.where("id", 5)` must be a reusable
  // value that always means "id = 5", never something a LATER unrelated
  // `people.all()` (or a second `q.all()`) can see or lose. Every chain
  // method below returns a NEW `Repo<T>` carrying the added clause; `this`
  // comes back out exactly as it went in.
  export where(column: string, val: Value): Repo<T> {
    let (col, err) = this.columnFor(column)
    if (col == "") {
      return this.withErr(err)
    }
    let r = this.next()
    r.args = append(r.args, val)
    r.wheres = append(r.wheres, "${col} = $${len(r.args)}")
    return r
  }

  // Ascending unless `dir` says otherwise (#6271 owner ruling: one method,
  // not two — `Dir` is a payload-free enum, so a mistyped direction is
  // still a compile error, the same guarantee the removed second method
  // gave, without the second method). Never mutates `this` — see `where`'s
  // own comment, above.
  export orderBy(column: string, dir: Dir = Dir.Asc): Repo<T> {
    let (col, err) = this.columnFor(column)
    if (col == "") {
      return this.withErr(err)
    }
    let word = "asc"
    if (dir == Dir.Desc) {
      word = "desc"
    }
    let r = this.next()
    r.orderBys = append(r.orderBys, "${col} ${word}")
    return r
  }

  // Never mutates `this` — see `where`'s own comment, above.
  export limit(n: int): Repo<T> {
    let r = this.next()
    r.limitN = n
    r.hasLimit = true
    return r
  }

  // Never mutates `this` — see `where`'s own comment, above.
  export offset(n: int): Repo<T> {
    let r = this.next()
    r.offsetN = n
    r.hasOffset = true
    return r
  }

  // ---- locking, paging, versions ----
  // #6276: `lock()`/`after()` reuse pkg/orm/lock.bit and keyset.bit;
  // `@version` checking lives in `update()`. `lock()` on a table taken from
  // `db` (no transaction) is a LockError value when it runs; making it a
  // compile error and adding lock modes is #6278.
  export lock(): LockedRepo<T> {
    return LockedRepo<T>{
      inner = this,
      opts = LockOpts{ skipLocked = false, nowait = false },
      dialect = ServerDialect.Postgres,
    }
  }

  // Keyset pagination (#5072's `keyset.bit`, reused unchanged): carries the
  // previous page's last row on the column the first `orderBy()` call
  // named, and adds `WHERE <col> > $n` (`<` for a descending order) instead
  // of an `OFFSET` — see `keyset.bit`'s header for why this always beats a
  // deep `offset()`. Fails, never panics, on no `orderBy()` yet or a
  // non-unique sort column (`keysetPredicateForRepo`, `keyset.bit`) — a
  // legitimate caller mistake, the same as `Query<T>.after()`'s identical
  // refusal.
  // Never mutates `this` — see `where`'s own comment, above.
  export after(key: Value): Repo<T>! {
    let (col, op) = keysetPredicateForRepo(T.__tableName(), T.__columns(), this.orderBys)?
    let r = this.next()
    r.args = append(r.args, key)
    r.wheres = append(r.wheres, "${col} ${op} $${len(r.args)}")
    return r
  }

  // Never `sqlFindMany<T>` (std/sql/row.bit) — see `find`'s own comment:
  // #6265 fixed the compiler bug this once worked around, but routing
  // through it is a separate change, not done here. Reads `this`, never
  // writes it — `let q = people.where(...)` can call `q.all()` twice and
  // get the identical statement both times (#6283, integrator).
  export all(): []T! {
    this.checkErr()?
    let sqlText = this.selectSql()
    // #6274: `selectSql` -> `whereSql` -> `trashColumn` may have just set
    // `errText` (a `@softDelete` class missing its `deletedAt` field) —
    // checked again before running anything, the same deferred-error shape
    // `checkErr`'s own header already documents for `where`/`orderBy`.
    this.checkErr()?
    let rows = this.db.query(sqlText, this.args)?
    defer rows.close()
    let out = []T(0)
    while (rows.next()?) {
      out = append(out, T.__fromRow(rows)?)
    }
    return this.loadWith(out)?
  }

  // Never `sqlFindOne<T>` — same as `all`, above.
  export first(): Option<T>! {
    this.checkErr()?
    let sqlText = this.boundedSql()
    this.checkErr()? // #6274: see `all`'s own comment, above.
    let rows = this.db.query(sqlText, this.args)?
    defer rows.close()
    if (!rows.next()?) {
      return Option<T>.None
    }
    let row = T.__fromRow(rows)?
    let loaded = this.loadWith([row])?
    return Option<T>.Some(loaded[0])
  }

  // UPDATE every column but the primary key itself, by that key — the
  // single-column counterpart of the "every column" convention
  // `pkg/orm/write.bit`'s own `updateSql` follows. Never RETURNING: MySQL
  // has none, and the caller already holds `v`.
  //
  // #6276: A `@version` FIELD (`pkg/orm/version.bit`, reused unchanged:
  // `versionField`/`StaleWriteError`) MAKES THE WHERE CARRY THE OLD VALUE
  // AND THE SET BUMP IT BY ONE, TRANSPARENTLY — no second method, matching
  // the approved shape's own `people.update(sara)?`. This is the one place
  // in this file the "locking, paging, versions" block above (this ticket's
  // own scope) could not stay a pure addition: `update()` is a single
  // method a class may declare exactly once (SPEC §14), so a `@version`
  // caller cannot be told apart from an ordinary one anywhere else. The
  // edit is the smallest one that closes it: extract the version field
  // once, special-case its own SET, and add its own WHERE clause and
  // `StaleWriteError` (never `WriteError`, since the row is still there —
  // see `version.bit`'s header for why the two must stay distinguishable).
  export update(v: T): ()! {
    this.checkErr()?
    let cols = this.columnsForValues(v)?
    // #6274: `@timestamps` fills `updatedAt` (never `createdAt`) on every
    // update — see `stampTimestamps`, this file's own "soft delete and bulk
    // writes" block.
    let vals = this.stampTimestamps(cols, v.__values(), true)?
    let (vf, hasVersion) = versionField(cols, T.__tableName())?
    let oldVersion = 0
    let newVersion = 0
    let sets = []string(0)
    let args = []Value(0)
    let keyCol = ""
    let keyVal = Value.Null
    let i = 0
    while (i < len(cols)) {
      let f = cols[i]
      if (hasIdAttr(f)) {
        keyCol = columnName(f)
        keyVal = vals[i]
        i = i + 1
        continue
      }
      if (hasVersion && f.name == vf.name) {
        oldVersion = versionIntOf(vals[i], f, T.__tableName())
        newVersion = oldVersion + 1
        args = append(args, Value.Int(newVersion))
        sets = append(sets, "${columnName(f)} = $${len(args)}")
        i = i + 1
        continue
      }
      args = append(args, vals[i])
      sets = append(sets, "${columnName(f)} = $${len(args)}")
      i = i + 1
    }
    if (keyCol == "") {
      fail newError("orm: '${T.__tableName()}' has no single '@id' field for update")
    }
    args = append(args, keyVal)
    let sqlText = "update ${T.__tableName()} set ${join(sets, ", ")} where ${keyCol} = $${len(args)}"
    if (hasVersion) {
      args = append(args, Value.Int(oldVersion))
      sqlText = sqlText + " and ${columnName(vf)} = $${len(args)}"
    }
    let n = this.db.exec(sqlText, args)?
    if (n == 0) {
      if (hasVersion) {
        fail StaleWriteError{
          table = T.__tableName(),
          keys = [keyVal],
          oldVersion = oldVersion,
          newVersion = newVersion,
        }
      }
      fail WriteError{
        cause = WriteCause.NoRowsAffected,
        table = T.__tableName(),
        keys = [keyVal],
      }
    }
  }

  // #6274: hides the row instead of removing it when `T` carries
  // `@softDelete` — see this file's own "soft delete and bulk writes" block
  // for `trashColumn`, the class's own deletedAt column or `""`. A BOUND
  // `sqlValue(now().ns)`, never raw `now()` SQL text: unlike
  // `pkg/orm/softdelete.bit`'s own `deletedAt: Option<DateTime>` (a type
  // `__values()` cannot map, this file's own header), `Repo<T>` needs
  // `deletedAt`/`createdAt`/`updatedAt` to be `Option<i64>`/`i64` — the
  // same epoch-nanosecond convention `@timestamps` (`stampTimestamps`,
  // below) already writes through `Value.Int(at.ns)`, so a raw SQL
  // timestamp expression would be the wrong SQL type for the column.
  export delete(id: Value): ()! {
    this.checkErr()?
    let col = this.singleKeyColumn()?
    let softCol = this.trashColumn()
    this.checkErr()?
    if (softCol != "") {
      this.db.exec(
        "update ${T.__tableName()} set ${softCol} = $1 where ${col} = $2",
        [sqlValue(now().ns), id],
      )?
      return
    }
    this.db.exec("delete from ${T.__tableName()} where ${col} = $1", [id])?
  }

  // ---- internals -----------------------------------------------------------

  desc(): TableDesc {
    return TableDesc{ table = T.__tableName(), fields = T.__columns(), classAttrs = []AttrDesc(0) }
  }

  // #6269: fails with a chain method's own deferred error (`errText`), if
  // one is pending — called first by every terminal method, so a bad
  // `where`/`orderBy` column reports as an ordinary error at
  // the terminal call, never builds SQL, never panics.
  checkErr(): ()! {
    if (this.errText != "") {
      fail newError(this.errText)
    }
  }

  // A full copy of `this` with every clause list freshly allocated, so the
  // caller can append to the copy without the receiver (or any other copy)
  // seeing it. Every chain method starts here: one place names every field,
  // so a field added later cannot be dropped by one method and kept by
  // another.
  next(): Repo<T> {
    return Repo<T>{
      db = this.db, dialect = this.dialect, wheres = cloneStrings(this.wheres),
      args = cloneValues(this.args), orderBys = cloneStrings(this.orderBys),
      limitN = this.limitN, hasLimit = this.hasLimit, offsetN = this.offsetN,
      hasOffset = this.hasOffset, withNames = cloneStrings(this.withNames),
      errText = this.errText, includeDeleted = this.includeDeleted,
      sets = cloneStrings(this.sets),
    }
  }

  // #6283 (integrator): a copy of `this` carrying a chain method's own
  // deferred error (first one wins, `columnFor`'s own contract) — never
  // mutates the receiver, the same immutability every chain method above
  // keeps. `people.where("bogus", 1)` must never poison `people` itself for
  // whatever statement reaches it next.
  withErr(err: string): Repo<T> {
    let r = this.next()
    if (r.errText == "") {
      r.errText = err
    }
    return r
  }

  // `T.__columns()` filtered to the row-mappable, non-relation subset
  // `T.__values()` also covers — see this file's header for why the two
  // lists must come out the same length. #6269: an error naming the class,
  // never a panic — a `@table` class with an unsupported column type
  // (`decimal`/`Timestamp`/`UUID`/`Json`/array) is a caller mistake, not a
  // condition this package cannot recover from.
  columnsForValues(v: T): []FieldDesc! {
    let out = []FieldDesc(0)
    for f of T.__columns() {
      if (!isRelationField(f)) {
        out = append(out, f)
      }
    }
    let vals = v.__values()
    if (len(out) != len(vals)) {
      fail newError("orm: '${T.__tableName()}' has a field type '__values()' cannot map (a 'decimal'/'Timestamp'/'UUID'/'Json'/array column) — Repo<T> needs every non-relation field to be a plain scalar")
    }
    return out
  }

  // #6269: an error naming the class and its key columns, never a panic —
  // `find`/`update`/`delete` on a `T` with no single key is now a COMPILE
  // error at the call site (`compiler/checkormrepokey.bit`) whenever `T` is
  // concrete; this stays the runtime backstop for a `T` still generic at
  // its own call site.
  singleKeyColumn(): string! {
    let kf = keyFields(this.desc())
    if (len(kf) != 1) {
      fail newError("orm: '${T.__tableName()}' carries a composite key (${keyFieldNames(kf)}) — Repo<T>.find/delete need a single-column '@id'")
    }
    return columnName(kf[0])
  }

  // #6269: no panic — `where`/`orderBy`/`set` (above) return `Repo<T>`,
  // never `Repo<T>!`, so a bad column cannot `fail` here. #6283
  // (integrator): NEVER mutates `this` either — a pure lookup, returning
  // the resolved column name (or `""`) alongside the error text a caller
  // with no better handle should carry forward via `withErr` (first one
  // wins there); `checkErr` turns that into a real error at the next
  // terminal call.
  columnFor(field: string): (string, string) {
    for f of T.__columns() {
      if (f.name == field) {
        return (columnName(f), "")
      }
    }
    return ("", "orm: '${field}' is not a field of the class mapped to '${T.__tableName()}'")
  }

  // #6274: every read excludes a `@softDelete` row by default — one more
  // entry ANDed onto `this.wheres`, never a second string-concatenated onto
  // the end (`pkg/orm/softdelete.bit`'s own composition guarantee) —
  // skipped once `withDeleted()` was called.
  whereSql(): string {
    let clauses = this.wheres
    if (!this.includeDeleted) {
      let col = this.trashColumn()
      if (col != "") {
        clauses = append(clauses, "${col} is null")
      }
    }
    if (len(clauses) == 0) {
      return ""
    }
    return " where " + join(clauses, " and ")
  }

  selectSql(): string {
    return this.buildSql(this.hasLimit, this.limitN)
  }

  boundedSql(): string {
    if (this.hasLimit && this.limitN <= 2) {
      return this.buildSql(this.hasLimit, this.limitN)
    }
    return this.buildSql(true, 2)
  }

  buildSql(hasLimit: bool, limitN: int): string {
    let sql = "select * from ${T.__tableName()}" + this.whereSql()
    if (len(this.orderBys) != 0) {
      sql = sql + " order by " + join(this.orderBys, ", ")
    }
    if (hasLimit) {
      sql = sql + " limit ${limitN}"
    }
    if (this.hasOffset) {
      sql = sql + " offset ${this.offsetN}"
    }
    return sql
  }

  // soft delete and bulk writes
  //
  // Ports `pkg/orm/softdelete.bit`/`bulk.bit`/`patch.bit`/`timestamps.bit`
  // onto `Repo<T>` (#6274), reusing every one of their SQL-building/marker
  // functions unchanged - this block only ever adapts their shape (a
  // `map<string, Value>`/`TableDesc` pair, the old API's own vocabulary) to
  // `Repo<T>`'s (a chain holding `T.__values()`-aligned positional arrays).
  // `T.__tableAttrs()` (`pkg/orm/db.bit`'s `Tabled`, #6274) is this block's
  // only new surface: `Repo<T>` never holds an instance of `T` outside
  // `insert`/`update`'s own parameter, so a class-level mark
  // (`@softDelete`/`@timestamps`, as opposed to a per-FIELD one like
  // `@id`/`@version`) needs a static accessor the same way `__tableName`/
  // `__columns` already are one.
  //
  // `find()` IS NOT SOFT-DELETE AWARE. The locked target's own example
  // (`.claude/kb/data-packages-dx.md`, "Approved 2026-09-29") never shows
  // `find()` on a `@softDelete` class - only `all`/`first` (through
  // `whereSql`, below) and the explicit `delete`/`withDeleted`/`restore`/
  // `forceDelete` surface here. Filed as a follow-up rather than guessed at.

  // The soft-delete column for `T`, or `""` when `T` carries no
  // `@softDelete` mark - `pkg/orm/softdelete.bit`'s own `softDeleteColumn`,
  // reused unchanged. #6269: never a panic - `@softDelete` declared without
  // a `deletedAt` field is a class shaped wrong, deferred onto `errText`
  // the same way `columnFor` already defers a bad `where`/`orderBy` column
  // (first one wins), for `checkErr` to fail with at the next terminal call.
  trashColumn(): string {
    let col = softDeleteColumn(T.__tableAttrs(), T.__columns(), T.__tableName()) catch e {
      if (this.errText == "") {
        this.errText = e.message()
      }
      return ""
    }
    return col
  }

  // Every read but `find` excludes a `@softDelete` row once this is called
  // - the target's own `posts.withDeleted().all()?`. Never mutates `this` -
  // see `where`'s own comment, above.
  export withDeleted(): Repo<T> {
    let r = this.next()
    r.includeDeleted = true
    return r
  }

  // `SET deleted_at = NULL` by primary key - the target's own
  // `posts.restore(id)?`. #6269: an error naming the table, never a panic
  // (unlike `pkg/orm/softdelete.bit`'s own `restore`, which panics: that
  // one serves a NON-fallible caller signature, `relation.bit`'s
  // `childQuery`, which has no way to propagate one - `Repo<T>`'s own
  // methods are already fallible throughout, so nothing here needs that
  // exception).
  export restore(id: Value): ()! {
    this.checkErr()?
    let col = this.singleKeyColumn()?
    let softCol = this.trashColumn()
    this.checkErr()?
    if (softCol == "") {
      fail newError("orm: restore called on the class mapped to '${T.__tableName()}', which does not carry '@softDelete'")
    }
    this.db.exec(
      "update ${T.__tableName()} set ${softCol} = $1 where ${col} = $2",
      [Value.Null, id],
    )?
  }

  // A real `DELETE`, soft-delete or not - the target's own
  // `posts.forceDelete(id)?`. `pkg/orm/softdelete.bit`'s own `forceDelete`
  // (`write.bit`'s `deleteSql`) works on a `TableDesc`/key-value map this
  // file does not build; reusing `singleKeyColumn`/`sqlValue` (already this
  // file's own vocabulary, `find`/`delete` above) is the smaller surface.
  export forceDelete(id: Value): ()! {
    this.checkErr()?
    let col = this.singleKeyColumn()?
    this.db.exec("delete from ${T.__tableName()} where ${col} = $1", [id])?
  }

  // Fills `createdAt`/`updatedAt` in `vals` (aligned to `cols`, `insert`'s
  // own positional convention) for a `@timestamps` class, through
  // `pkg/orm/timestamps.bit`'s own `applyTimestamps` unchanged - reused via
  // a throwaway `map<string, Value>` keyed by BIT field name, since
  // `insert`/`update` build positional arrays rather than the map
  // `pkg/orm/write.bit`'s own callers already thread `applyTimestamps`
  // through. A no-op, returning `vals` unchanged, for a class without
  // `@timestamps` - checked here too (not just inside `applyTimestamps`)
  // only to skip building the map at all when there is nothing to fill.
  // Never rewrites `createdAt` on an update: `applyTimestamps` only ever
  // touches `values["updatedAt"]` on its `persisted` branch, so `createdAt`
  // comes back as `v`'s own unchanged value - the redundant `SET createdAt
  // = <same value>` `update`'s own loop still emits is harmless, not a
  // second read of the row's age.
  stampTimestamps(cols: []FieldDesc, vals: []Value, persisted: bool): []Value! {
    if (!hasTimestampsAttr(T.__tableAttrs())) {
      return vals
    }
    let values = map<string, Value>(len(cols))
    let i = 0
    while (i < len(cols)) {
      values[cols[i].name] = vals[i]
      i = i + 1
    }
    applyTimestamps(
      TableDesc{ table = T.__tableName(), fields = cols, classAttrs = []AttrDesc(0) },
      values, persisted, T.__tableAttrs(), now(),
    )?
    let out = []Value(0)
    i = 0
    while (i < len(cols)) {
      out = append(out, values[cols[i].name])
      i = i + 1
    }
    return out
  }

  // INSERT every row of `rows` in as few statements as
  // `pkg/orm/bulk.bit`'s own `maxRowsPerChunk` allows - that file's own
  // `insertAllSql`, reused unchanged, RETURNING every generated column;
  // `T.__fromRow(rows)` reads each one back as a `T`, never the
  // `map<string, Value>` `bulk.bit`'s own exported `insertAll` returns
  // (this file has no concrete entity to apply one onto - see this file's
  // own `find`, above, for why `T.__fromRow` is preferred over that map
  // wherever a live `Rows` is already in hand). Empty `rows` is an ordinary
  // no-op, never an error - `db.exec`/`db.query` never runs at all.
  export insertAll(rows: []T): []T! {
    this.checkErr()?
    if (len(rows) == 0) {
      return []T(0)
    }
    let cols = this.columnsForValues(rows[0])?
    let desc = TableDesc{ table = T.__tableName(), fields = cols, classAttrs = T.__tableAttrs() }
    let chunkSize = maxRowsPerChunk(len(cols))
    let out = []T(0)
    let i = 0
    while (i < len(rows)) {
      let end = i + chunkSize
      if (end > len(rows)) {
        end = len(rows)
      }
      for t of this.insertChunk(desc, cols, rows[i:end])? {
        out = append(out, t)
      }
      i = end
    }
    return out
  }

  // One `INSERT ... VALUES (...), (...), ... RETURNING *` for `chunk`,
  // never empty (`insertAll`'s own loop only calls this with a non-empty
  // slice) - `insertAllSql` (`pkg/orm/bulk.bit`, module-private, reused
  // unchanged) builds the statement from the same per-row `map<string,
  // Value>` shape `stampTimestamps` above already builds.
  insertChunk(desc: TableDesc, cols: []FieldDesc, chunk: []T): []T! {
    let rowMaps = []map<string, Value>(0)
    for v of chunk {
      let vals = this.stampTimestamps(cols, v.__values(), false)?
      let m = map<string, Value>(len(cols))
      let i = 0
      while (i < len(cols)) {
        m[cols[i].name] = vals[i]
        i = i + 1
      }
      rowMaps = append(rowMaps, m)
    }
    let (sqlText, args) = insertAllSql(desc, rowMaps)
    let rows = this.db.query(sqlText, args)?
    defer rows.close()
    let out = []T(0)
    while (rows.next()?) {
      out = append(out, T.__fromRow(rows)?)
    }
    return out
  }

  // `column = $n`, chained the same way `where` already is - the target's
  // own `posts.where("authorId", 7).set("title", "Draft").updateAll()?`.
  // Composes with `where`'s own `this.args`/placeholder numbering exactly
  // as `pkg/orm/patch.bit`'s `Patch<T>.set` composes with its own `where` -
  // Postgres placeholders bind by index, never by textual order, so a
  // `SET` argument numbered after every `WHERE` argument is still correct
  // regardless of which clause the final SQL text puts first.
  // Never mutates `this` — see `where`'s own comment, above.
  export set(column: string, val: Value): Repo<T> {
    let (col, err) = this.columnFor(column)
    if (col == "") {
      return this.withErr(err)
    }
    let r = this.next()
    r.args = append(r.args, val)
    r.sets = append(r.sets, "${col} = $${len(r.args)}")
    return r
  }

  // Runs `UPDATE ... SET <sets> WHERE <wheres>` and returns the affected
  // row count - the target's own `updateAll()`. `@timestamps` bumps
  // `updatedAt` here too, through `set` itself (this file's own vocabulary)
  // rather than `pkg/orm/timestamps.bit`'s `withUpdatedAt` (a `Patch<T>`
  // method this file's `Repo<T>` is not). #6269/`pkg/orm/patch.bit`'s own
  // "A BARE run() MUST NOT BE SILENT": refuses with no `where()` at all,
  // the identical safety `Patch<T>.run()`'s own `refuseIfBare` already
  // enforces for the old API.
  export updateAll(): int! {
    this.checkErr()?
    if (len(this.wheres) == 0) {
      fail newError("orm: updateAll on the class mapped to '${T.__tableName()}' has no where() - refusing to touch every row")
    }
    // #6283 (integrator): `set` no longer mutates `this` — its return value
    // is the ONLY way to see the added `updatedAt` SET clause, so it must
    // be captured into a local rather than discarded the way a mutating
    // `set` allowed.
    let repo = this
    if (hasTimestampsAttr(T.__tableAttrs())) {
      repo = repo.set("updatedAt", now().ns)
    }
    repo.checkErr()?
    if (len(repo.sets) == 0) {
      fail newError("orm: updateAll on the class mapped to '${T.__tableName()}' called with no set() - nothing to write")
    }
    let sqlText = "update ${T.__tableName()} set ${join(repo.sets, ", ")}" + repo.whereSql()
    return repo.db.exec(sqlText, repo.args)?
  }

  // Runs `DELETE ... WHERE <wheres>`, or - on a `@softDelete` class - the
  // same kind of bound `UPDATE ... SET deletedAtCol = $n` `delete` above
  // emits, still by `whereSql`'s own predicate list (never
  // `singleKeyColumn`: this is a bulk delete by whatever `where()` narrowed
  // to, not one row by key) - the target's own
  // `posts.where("authorId", 7).deleteAll()?`. Same bare-`where()` refusal
  // as `updateAll`, above.
  export deleteAll(): int! {
    this.checkErr()?
    if (len(this.wheres) == 0) {
      fail newError("orm: deleteAll on the class mapped to '${T.__tableName()}' has no where() - refusing to touch every row")
    }
    let softCol = this.trashColumn()
    this.checkErr()?
    if (softCol != "") {
      // A BOUND `sqlValue(now().ns)`, never raw `now()` SQL text - see
      // `delete`'s own comment, above, for why. `whereSql()` is computed
      // BEFORE appending this value, so every `$n` it already assigned off
      // `this.args`' current length stays correct; the new value lands at
      // the next, still-unused placeholder. `this.args` itself is never
      // mutated (#6283, integrator) - the extra value lives only in the
      // local `args` this statement runs with.
      let whereText = this.whereSql()
      let args = append(cloneValues(this.args), sqlValue(now().ns))
      let sqlText = "update ${T.__tableName()} set ${softCol} = $${len(args)}" + whereText
      return this.db.exec(sqlText, args)?
    }
    let sqlText = "delete from ${T.__tableName()}" + this.whereSql()
    return this.db.exec(sqlText, this.args)?
  }

  // relations

  // Queues eager-loading the relation named `name` — `all()`/`first()` run
  // it (`loadWith` below) right after fetching their own rows, one extra
  // query per name, never N+1 (#6277's own `__loadRelation`,
  // compiler/classtablerelation.bit).
  export with(name: string): Repo<T> {
    let r = this.next()
    r.withNames = append(r.withNames, name)
    return r
  }

  // `link`/`unlink` (many-to-many, #6277/#6275) are NOT here yet: real
  // `@manyToMany` linking (join table/columns from the class's own raw
  // name, `pkg/orm/manytomany.bit`'s `attach`/`detach`) is not implemented
  // — integrator ruling 2026-09-29: a `Repo<T>` method that always fails
  // "not yet supported" must not ship, so neither the method nor
  // `Tabled.__linkRelation`/`LinkOp` exist on this branch. Follow-up work,
  // not a silently-assumed-done stub.

  // `rows`, with every queued `with()` name eager-loaded onto them —
  // `all()`/`first()`'s own shared tail.
  loadWith(rows: []T): []T! {
    let out = rows
    for name of this.withNames {
      out = T.__loadRelation(this.db, name, out)?
    }
    return out
  }
}
