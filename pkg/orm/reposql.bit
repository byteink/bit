// pkg/orm/reposql.bit — `Repo<T>`'s own column resolution and SQL-text
// assembly, split out of repo.bit to keep it under spec/LINT.md's 800-line
// ceiling (#6289), the same "keep the class, move the body" shape
// `pkg/orm/repoclone.bit` already set for `next()`'s own clone helpers.
// Every function below is the exact body `repo.bit`'s own method of the
// same purpose declared, now taking the receiver explicitly as `self:
// Repo<T>` — the method itself stays declared on the class (lock.bit's
// `LockedRepo<T>` reads `this.inner.singleKeyColumn()` cross-file, SPEC
// §14), each a one-line call into here.

// `T.__columns()` filtered to the row-mappable, non-relation subset
// `T.__values()` also covers — see repo.bit's header for why the two lists
// must come out the same length. #6269: an error naming the class, never a
// panic — a `@table` class with an unsupported column type
// (`decimal`/`Timestamp`/`UUID`/`Json`/array) is a caller mistake, not a
// condition this package cannot recover from.
fn repoColumnsForValues<T: Tabled>(v: T): []FieldDesc! {
  let out = []FieldDesc(0)
  for f of T.__columns() {
    if (!isRelationField(f)) {
      out = append(out, f)
    }
  }
  let vals = v.__values()
  if (len(out) != len(vals)) {
    fail newError("orm: '${T.__tableName()}' has a field type '__values()' cannot map (a 'decimal'/'Timestamp'/'UUID'/'Json'/array column) — Repo<T> needs every non-relation field to be a plain scalar")
  }
  return out
}

// #6269: an error naming the class and its key columns, never a panic —
// `find`/`update`/`delete` on a `T` with no single key is now a COMPILE
// error at the call site (`compiler/checkormrepokey.bit`) whenever `T` is
// concrete; this stays the runtime backstop for a `T` still generic at its
// own call site.
fn repoSingleKeyColumn<T: Tabled>(self: Repo<T>): string! {
  let kf = keyFields(self.desc())
  if (len(kf) != 1) {
    fail newError("orm: '${T.__tableName()}' carries a composite key (${keyFieldNames(kf)}) — Repo<T>.find/delete need a single-column '@id'")
  }
  return columnName(kf[0])
}

// #6269: no panic — `where`/`orderBy`/`set` (repo.bit) return `Repo<T>`,
// never `Repo<T>!`, so a bad column cannot `fail` here. #6283
// (integrator): NEVER mutates the receiver either — a pure lookup,
// returning the resolved column name (or `""`) alongside the error text a
// caller with no better handle should carry forward via `withErr` (first
// one wins there); `checkErr` turns that into a real error at the next
// terminal call.
fn repoColumnFor<T: Tabled>(field: string): (string, string) {
  for f of T.__columns() {
    if (f.name == field) {
      return (columnName(f), "")
    }
  }
  return ("", "orm: '${field}' is not a field of the class mapped to '${T.__tableName()}'")
}

// #6274: every read excludes a `@softDelete` row by default — one more
// entry ANDed onto `self.wheres`, never a second string-concatenated onto
// the end (`pkg/orm/softdelete.bit`'s own composition guarantee) — skipped
// once `withDeleted()` was called.
fn repoWhereSql<T: Tabled>(self: Repo<T>): string {
  let clauses = self.wheres
  if (!self.includeDeleted) {
    let col = self.trashColumn()
    if (col != "") {
      clauses = append(clauses, "${col} is null")
    }
  }
  if (len(clauses) == 0) {
    return ""
  }
  return " where " + join(clauses, " and ")
}

fn repoSelectSql<T: Tabled>(self: Repo<T>): string {
  return self.buildSql(self.hasLimit, self.limitN)
}

fn repoBoundedSql<T: Tabled>(self: Repo<T>): string {
  if (self.hasLimit && self.limitN <= 2) {
    return self.buildSql(self.hasLimit, self.limitN)
  }
  return self.buildSql(true, 2)
}

fn repoBuildSql<T: Tabled>(self: Repo<T>, hasLimit: bool, limitN: int): string {
  let sql = "select * from ${T.__tableName()}" + self.whereSql()
  if (len(self.orderBys) != 0) {
    sql = sql + " order by " + join(self.orderBys, ", ")
  }
  if (hasLimit) {
    sql = sql + " limit ${limitN}"
  }
  if (self.hasOffset) {
    sql = sql + " offset ${self.offsetN}"
  }
  return sql
}
