// Both dialects retain $n until the MySQL adapter rewrites the statement.
class sbGuard {
  mode: int
  asked: int
  first: int
  actor: string
  op: GuardOp

  protects(table: string): bool {
    return table == "sposts" || table == "sdposts"
  }

  filter(
    actor: Actor,
    op: GuardOp,
    table: string,
    dialect: ServerDialect,
    firstParam: int,
  ): GuardFilter! {
    this.asked = this.asked + 1
    this.first = firstParam
    this.actor = actor.id
    this.op = op
    if (this.mode == 0) {
      return GuardFilter.All
    }
    if (this.mode == 1) {
      return GuardFilter.None
    }
    if (this.mode == 3) {
      fail newError("bulk rule unavailable")
    }
    return GuardFilter.Sql(
      "author_id = $${firstParam} or author_id = $${firstParam + 1}",
      [Value.Int(7), Value.Int(9)],
    )
  }

  allows(actor: Actor, op: GuardOp, table: string, columns: []string, values: []Value): bool! {
    fail newError("bulk delete must use filter")
  }

  denied(actor: Actor, op: GuardOp, table: string): error { return newError("denied") }
  notFound(table: string): error { return newError("not found") }
  check(): ()! {}
}

fn sbPolicy(mode: int): sbGuard {
  return sbGuard{ mode = mode, asked = 0, first = 0, actor = "", op = GuardOp.Read }
}

fn sbDb(a: rawAdapter, d: ServerDialect, g: sbGuard): Db {
  return Db{ pool = newRawPool(a), dialect = d, guard = g }
}

fn sbRecorded0(): ()! {
  for d of [srPostgres(), srMysql()] {
    let a = newRawAdapter()
    a.affected = 2
    let g = sbPolicy(2)
    let base = sbDb(a, d, g).as(srUser{ id = "u7" }, "acme").table<SPost>()
    let chain = base.where("body", "outline").orderBy("id").after(3).limit(4).offset(1)
    let before = srArgsText(chain.inner.args)
    assert(chain.deleteAll()? == 2, "return actual affected rows")
    assert(len(a.execs) == 1 && len(a.queries) == 0, "one write, no visibility read")
    assert(
        a.execs[0].sql ==
        "delete from sposts where body = $1 and id > $2 and (author_id = $3 or author_id = $4)",
      a.execs[0].sql,
    )
    assert(srArgsText(a.execs[0].args) == "toutline,i3,i7,i9", "bound arguments")
    assert(
      g.asked == 1 && g.first == 3 && g.actor == "u7" && g.op == GuardOp.Delete,
      "exact Delete request",
    )
    assert(
      srArgsText(chain.inner.args) == before && len(chain.inner.wheres) == 2,
      "source chain unchanged",
    )
    assert(len(base.inner.wheres) == 0 && chain.tenant == "acme", "base and tenant unchanged")
    chain.deleteAll()?
    assert(a.execs[1].sql == a.execs[0].sql, "repeat does not accumulate policy")
  }
}

fn sbRecorded1(): ()! {
  for d of [srPostgres(), srMysql()] {
    for mode of [0, 1, 2, 3] {
      sbModeCase(d, mode)?
    }
  }
}

fn sbRefuseBare(repo: ScopedRepo<SPost>, g: sbGuard, a: rawAdapter) {
  let refused = false
  repo.deleteAll() catch e {
    refused = contains(e.message(), "has no where()")
  }
  assert(refused && g.asked == 0 && len(a.execs) == 0, "policy cannot satisfy caller safety")
}

fn sbModeCase(d: ServerDialect, mode: int): ()! {
  let a = newRawAdapter()
  a.affected = 3
  let g = sbPolicy(mode)
  let repo = sbDb(a, d, g).asGuest().table<SPost>()
  sbRefuseBare(repo, g, a)
  let failed = false
  let n = repo.where("body", "outline").deleteAll() catch e {
    failed = e.message() == "bulk rule unavailable"
    0
  }
  assert(g.asked == 1 && g.actor == "", "guest checked once")
  if (mode == 3) {
    assert(failed && len(a.execs) == 0, "filter error fails closed")
  } else if (mode == 1) {
    assert(n == 0 && len(a.execs) == 0, "None runs no SQL")
  } else {
    assert(n == 3 && len(a.execs) == 1, "All and Sql run write")
    if (mode == 0) {
      assert(a.execs[0].sql == "delete from sposts where body = $1", "All keeps caller")
    }
  }
}

fn sbRecorded2(): ()! {
  for d of [srPostgres(), srMysql()] {
    let a = newRawAdapter()
    a.affected = 4
    let g = sbPolicy(1)
    let db = sbDb(a, d, g)
    let refused = false
    db.asGuest().table<SPost>().where("unknown", 1).deleteAll() catch e {
      refused = contains(e.message(), "unknown")
    }
    assert(refused && g.asked == 0 && len(a.execs) == 0, "chain error before policy")
    assert(
      db.asGuest().table<SwPost>().where("body", "x").deleteAll()? == 4,
      "unprotected passthrough",
    )
    assert(g.asked == 0, "unprotected policy unasked")
    let plain = Db{ pool = newRawPool(a), dialect = d }.asGuest().table<SPost>()
    assert(plain.where("body", "x").deleteAll()? == 4, "no guard passthrough")
    refused = false
    plain.deleteAll() catch e {
      refused = contains(e.message(), "has no where()")
    }
    assert(refused && len(a.execs) == 2, "bare unguarded refusal")
  }
}

fn sbRecorded3(): ()! {
  for d of [srPostgres(), srMysql()] {
    let a = newRawAdapter()
    a.affected = 2
    let g = sbPolicy(2)
    let repo = sbDb(a, d, g).as(srUser{ id = "u7" }).table<SDPost>().where("authorId", 7)
    let before = now().ns
    assert(repo.deleteAll()? == 2, "soft delete affected rows")
    let call = a.execs[0]
    assert(
        call.sql ==
        "update sdposts set deleted_at = $4 where author_id = $1 and (author_id = $2 or author_id = $3) and deleted_at is null",
      call.sql,
    )
    assert(srArgsText(call.args[0:3]) == "i7,i7,i9", "caller then policy args")
    match (call.args[3]) {
      Int(stamp) => assert(stamp >= before && stamp <= now().ns, "bound current timestamp")
      _ => assert(false, "timestamp must be integer")
    }
    repo.withDeleted().deleteAll()?
    assert(!contains(a.execs[1].sql, "is null"), "withDeleted retains its meaning")
    assert(
      len(repo.inner.args) == 1 && !repo.inner.includeDeleted,
      "soft delete leaves chain unchanged",
    )
  }
}

test "scoped bulk delete ANDs Delete policy with caller SQL on both dialects" {
  sbRecorded0() catch e {
    panic(e.message())
  }
}

test "scoped bulk delete All None errors and caller safety on both dialects" {
  sbRecorded1() catch e {
    panic(e.message())
  }
}

test "scoped bulk delete chain errors precede None and passthrough keeps caller safety" {
  sbRecorded2() catch e {
    panic(e.message())
  }
}

test "scoped bulk delete soft marker follows policy arguments on both dialects" {
  sbRecorded3() catch e {
    panic(e.message())
  }
}

const sbLiveSource: string = `import { args } from "std/os"
import { Actor, GuardFilter, GuardOp, Options, ServerDialect, open } from "orm"
import { Value } from "std/sql"

@table("sbposts") class SPost {
  id: i64,
  authorId: i64,
  body: string,
}

// The guard keeps owner 7's rows whoever asks: the proof is that the ORM
// applies the fragment, not how a real guard picks it.
class Owner {
  protects(table: string): bool {
    return table == "sbposts"
  }

  filter(actor: Actor, op: GuardOp, table: string, dialect: ServerDialect, firstParam: int): GuardFilter! {
    if (op == GuardOp.Delete) {
      return GuardFilter.Sql("author_id = $@P@", [Value.Int(7)])
    }
    return GuardFilter.All
  }

  allows(actor: Actor, op: GuardOp, table: string, columns: []string, values: []Value): bool! {
    return true
  }

  denied(actor: Actor, op: GuardOp, table: string): error {
    return newError("denied")
  }

  notFound(table: string): error {
    return newError("not found")
  }

  check(): ()! {}
}

class Me {
  export id: string,
}

fn main(): ()! {
  let db = open(args()[1], Options{ authz = Owner{} })?
  defer db.close()
  db.exec("drop table if exists sbposts")?
  db.exec(args()[2])?
  defer db.exec("drop table sbposts") catch e { panic(e.message()) }
  let sys = db.asSystem().table<SPost>()
  let i = 0
  while (i < 5) {
    let owner = i64(8)
    if (i < 2) {
      owner = i64(7)
    }
    sys.insert(SPost{ id = 0, authorId = owner, body = "outline" })?
    i = i + 1
  }
  let chain = db.as(Me{ id = "7" }).table<SPost>().where("body", "outline")
  let changed = chain.deleteAll()?
  assert(changed == 2, "delete only two visible rows")
  assert(sys.count()? == 3, "three denied rows remain")
  assert(sys.where("authorId", 8).count()? == 3, "denied rows unchanged")
  assert(sys.where("authorId", 7).count()? == 0, "allowed rows removed")
  assert(chain.deleteAll()? == 0, "repeat returns actual zero without changing chain")
  print("LIVE_BULK_DELETE_OK changed=2 denied=3 remaining=3")
}
`

fn sbRunLive(envVar: string, name: string, createTable: string) {
  let uri = env(envVar)
  if (uri == "") {
    print("  skipped: ${envVar} is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("liveproof8448${name}")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof8448${name}\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", replace(sbLiveSource, "@P@", "$" + "{firstParam}")) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }
  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri, createTable])
  assert(
    rc == 0,
    "live proof against a real ${name} server failed, rc=${rc}; rerun with ${envVar} set",
  )
  resetDir(proj)
}

test "live: scoped bulk delete preserves denied rows on Postgres (#8448)" {
  sbRunLive(
    "ORM_TEST_LIVE_PG_URI", "pg",
    "create table sbposts (id bigint generated always as identity primary key, author_id bigint not null, body text not null)",
  )
}

test "live: scoped bulk delete preserves denied rows on MySQL (#8448)" {
  sbRunLive(
    "ORM_TEST_LIVE_MYSQL_URI", "mysql",
    "create table sbposts (id bigint auto_increment primary key, author_id bigint not null, body text not null)",
  )
}
