// pkg/orm/repo.test.bit — the locked target's own `db.bit` example
// (.claude/kb/data-packages-dx.md), run against a real Postgres server
// (#6258, epic #6253). `findRepoRoot`/`scratchDir`/`resetDir` are already
// declared package-wide by `generate.test.bit`; `env`/`envOr`/`run` by
// `generate.test.bit`/`raw.test.bit` — importing or redeclaring any of them
// here would be E0042 (`write.test.bit`'s own header states the rule this
// file follows).
//
// WHY A SPAWNED SUBPROCESS, NOT A TEST FUNCTION CALLING `open` DIRECTLY.
// `import { open } from "orm"` is the target's own first line — proving it
// means compiling a SEPARATE project that imports this package by name, the
// same reason `bulk.test.bit`'s own #6107 live proof spawns one rather than
// calling `insertAll` from inside this module. `Db.pool` is module-private
// (rule 2: a caller never reaches the connection directly), so setup/
// teardown DDL opens its OWN raw pool via `postgres`'s own `adapter()` —
// "postgres" is declared as a second explicit dependency of the scratch
// project below, the same way `bulk.test.bit`'s live proof does.
//
// The `db.tx` block uses the target's own `from`/`to` names: `from` is a
// contextual keyword (#6264), special only after an import list.
//
// ALSO NOT LITERAL: the target's `db.bit` shows no `import { FieldDesc,
// AttrDesc } from "std/sql"`, but a `@table` class still needs one
// (`E0150`, confirmed live) — the same boilerplate #6255's own probe hit.
// Neither gap blocks `open`/`table<T>()`/`Repo<T>` themselves; all three are
// reported on #6258 rather than worked around in the package's own API.
//
// #6269 (`.claude/kb/data-packages-dx.md`): the target's `id: i64` field
// carries NO `@id` — `compiler/classtabledefaultid.bit` now makes a field
// literally named `id` the primary key when no field carries `@id`
// explicitly, so INSERT still leaves it out of the column list and fills
// it from RETURNING exactly as an explicit `@id` always has.
const liveDbProofSource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value, FieldDesc, AttrDesc } from \"std/sql\"\nimport { adapter } from \"postgres\"\nimport { Dir, open } from \"orm\"\n\n@table class Person {\n  id: i64,\n  name: string,\n  email: string,\n}\n\n@table(\"accounts\") class Account {\n  id: i64,\n  owner: i64,\n  balance: i64,\n}\n\nfn main(): ()! {\n  let uri = args()[1]\n  let setup = pool(adapter(), Datasource{ uri = uri })?\n  setup.exec(\"drop table if exists person\", []Value(0))?\n  setup.exec(\"drop table if exists accounts\", []Value(0))?\n  setup.exec(\"create table person (id bigint generated always as identity primary key, name text not null, email text not null)\", []Value(0))?\n  setup.exec(\"create table accounts (id bigint generated always as identity primary key, owner bigint not null, balance bigint not null)\", []Value(0))?\n  setup.close()\n\n  let db = open(uri)?\n\n  let people = db.table<Person>()\n  let accounts = db.table<Account>()\n\n  let sara = people.insert(Person{ id = 0, name = \"Sara\", email = \"sara@example.com\" })?\n  if (sara.id <= i64(0)) { panic(\"LIVE PROOF FAILED: insert did not fill a generated id\") }\n\n  let same = people.find(sara.id)?\n  if (same.email != \"sara@example.com\") { panic(\"LIVE PROOF FAILED: find did not round-trip email\") }\n\n  let found = people.where(\"email\", \"sara@example.com\").orderBy(\"name\").limit(10).all()?\n  if (len(found) != 1) { panic(\"LIVE PROOF FAILED: where/orderBy/limit/all expected 1 row, got \${len(found)}\") }\n\n  sara.name = \"Sara K\"\n  people.update(sara)?\n  let updated = people.find(sara.id)?\n  if (updated.name != \"Sara K\") { panic(\"LIVE PROOF FAILED: update did not persist\") }\n\n  people.delete(sara.id)?\n\n  let acc1 = accounts.insert(Account{ id = 0, owner = 1, balance = 1000 })?\n  let acc2 = accounts.insert(Account{ id = 0, owner = 2, balance = 500 })?\n\n  db.tx((tx) => {\n    let acc = tx.table<Account>()\n    let from = acc.find(acc1.id)?\n    let to = acc.find(acc2.id)?\n    from.balance = from.balance - 50\n    to.balance = to.balance + 50\n    acc.update(from)?\n    acc.update(to)?\n  })?\n\n  let after1 = accounts.find(acc1.id)?\n  let after2 = accounts.find(acc2.id)?\n  if (after1.balance != i64(950) || after2.balance != i64(550)) {\n    panic(\"LIVE PROOF FAILED: db.tx did not commit both updates, got \${after1.balance}/\${after2.balance}\")\n  }\n\n  let descByBalance = accounts.orderBy(\"balance\", Dir.Desc).all()?\n  if (len(descByBalance) != 2 || descByBalance[0].balance < descByBalance[1].balance) {\n    panic(\"LIVE PROOF FAILED: orderBy(column, Dir.Desc) did not sort descending\")\n  }\n  let ascByBalance = accounts.orderBy(\"balance\").all()?\n  if (len(ascByBalance) != 2 || ascByBalance[0].balance > ascByBalance[1].balance) {\n    panic(\"LIVE PROOF FAILED: orderBy(column) with the Dir.Asc default did not sort ascending\")\n  }\n\n  print(\"LIVE_PROOF_OK\")\n}\n"

test "live: the locked target's db.bit example, open/table/insert/find/where/orderBy/limit/all/update/delete/tx (#6258)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("liveproof6258")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6258\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveDbProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}
