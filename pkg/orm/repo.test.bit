// pkg/orm/repo.test.bit — the locked target's own `db.bit` example
// (.claude/kb/data-packages-dx.md), run against a real Postgres server
// (#6258, epic #6253). `findRepoRoot`/`scratchDir`/`resetDir` are already
// declared package-wide by `generate.test.bit`; `env`/`envOr`/`run` by
// `generate.test.bit`/`raw.test.bit` — importing or redeclaring any of them
// here would be E0042 (`write.test.bit`'s own header states the rule this
// file follows).
//
// WHY A SPAWNED SUBPROCESS, NOT A TEST FUNCTION CALLING `open` DIRECTLY.
// `import { open } from "orm"` is the target's own first line — proving it
// means compiling a SEPARATE project that imports this package by name, the
// same reason `bulk.test.bit`'s own #6107 live proof spawns one rather than
// calling `insertAll` from inside this module. `Db.pool` is module-private
// (rule 2: a caller never reaches the connection directly), so setup/
// teardown DDL opens its OWN raw pool via `postgres`'s own `adapter()` —
// "postgres" is declared as a second explicit dependency of the scratch
// project below, the same way `bulk.test.bit`'s live proof does.
//
// The `db.tx` block uses the target's own `from`/`to` names: `from` is a
// contextual keyword (#6264), special only after an import list.
//
// ALSO NOT LITERAL: the target's `db.bit` shows no `import { FieldDesc,
// AttrDesc } from "std/sql"`, but a `@table` class still needs one
// (`E0150`, confirmed live) — the same boilerplate #6255's own probe hit.
// Neither gap blocks `open`/`table<T>()`/`Repo<T>` themselves; all three are
// reported on #6258 rather than worked around in the package's own API.
//
// #6269 (`.claude/kb/data-packages-dx.md`): the target's `id: i64` field
// carries NO `@id` — `compiler/classtabledefaultid.bit` now makes a field
// literally named `id` the primary key when no field carries `@id`
// explicitly, so INSERT still leaves it out of the column list and fills
// it from RETURNING exactly as an explicit `@id` always has.
const liveDbProofSource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value, FieldDesc, AttrDesc } from \"std/sql\"\nimport { adapter } from \"postgres\"\nimport { Dir, open } from \"orm\"\n\n@table class Person {\n  id: i64,\n  name: string,\n  email: string,\n}\n\n@table(\"accounts\") class Account {\n  id: i64,\n  owner: i64,\n  balance: i64,\n}\n\nfn main(): ()! {\n  let uri = args()[1]\n  let setup = pool(adapter(), Datasource{ uri = uri })?\n  setup.exec(\"drop table if exists person\", []Value(0))?\n  setup.exec(\"drop table if exists accounts\", []Value(0))?\n  setup.exec(\"create table person (id bigint generated always as identity primary key, name text not null, email text not null)\", []Value(0))?\n  setup.exec(\"create table accounts (id bigint generated always as identity primary key, owner bigint not null, balance bigint not null)\", []Value(0))?\n  setup.close()\n\n  let db = open(uri)?\n\n  let people = db.table<Person>()\n  let accounts = db.table<Account>()\n\n  let sara = people.insert(Person{ id = 0, name = \"Sara\", email = \"sara@example.com\" })?\n  if (sara.id <= i64(0)) { panic(\"LIVE PROOF FAILED: insert did not fill a generated id\") }\n\n  let same = people.find(sara.id)?\n  if (same.email != \"sara@example.com\") { panic(\"LIVE PROOF FAILED: find did not round-trip email\") }\n\n  let found = people.where(\"email\", \"sara@example.com\").orderBy(\"name\").limit(10).all()?\n  if (len(found) != 1) { panic(\"LIVE PROOF FAILED: where/orderBy/limit/all expected 1 row, got \${len(found)}\") }\n\n  sara.name = \"Sara K\"\n  people.update(sara)?\n  let updated = people.find(sara.id)?\n  if (updated.name != \"Sara K\") { panic(\"LIVE PROOF FAILED: update did not persist\") }\n\n  people.delete(sara.id)?\n\n  let acc1 = accounts.insert(Account{ id = 0, owner = 1, balance = 1000 })?\n  let acc2 = accounts.insert(Account{ id = 0, owner = 2, balance = 500 })?\n\n  db.tx((tx) => {\n    let acc = tx.table<Account>()\n    let from = acc.find(acc1.id)?\n    let to = acc.find(acc2.id)?\n    from.balance = from.balance - 50\n    to.balance = to.balance + 50\n    acc.update(from)?\n    acc.update(to)?\n  })?\n\n  let after1 = accounts.find(acc1.id)?\n  let after2 = accounts.find(acc2.id)?\n  if (after1.balance != i64(950) || after2.balance != i64(550)) {\n    panic(\"LIVE PROOF FAILED: db.tx did not commit both updates, got \${after1.balance}/\${after2.balance}\")\n  }\n\n  let descByBalance = accounts.orderBy(\"balance\", Dir.Desc).all()?\n  if (len(descByBalance) != 2 || descByBalance[0].balance < descByBalance[1].balance) {\n    panic(\"LIVE PROOF FAILED: orderBy(column, Dir.Desc) did not sort descending\")\n  }\n  let ascByBalance = accounts.orderBy(\"balance\").all()?\n  if (len(ascByBalance) != 2 || ascByBalance[0].balance > ascByBalance[1].balance) {\n    panic(\"LIVE PROOF FAILED: orderBy(column) with the Dir.Asc default did not sort ascending\")\n  }\n\n  print(\"LIVE_PROOF_OK\")\n}\n"

test "live: the locked target's db.bit example, open/table/insert/find/where/orderBy/limit/all/update/delete/tx (#6258)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("liveproof6258")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6258\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveDbProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}

// ---- #6276: lock()/after()/@version on Repo<T>, against a fake driver ----
// `wrAdapter`/`wrConn`/`newWrPool`/`lastWrCall` (./write.test.bit) and
// `Account` (./write.test.bit's own real `@table class`, this file's
// sibling in the same module, SPEC §17.1) are reused rather than
// redeclared — a second declaration of either would be E0042. Two tx both
// locking the same row and blocking each other, and after() paging a real
// multi-row table without gaps, both need a live server (repo.test.bit's
// own header explains why `Db.pool` cannot be reached any other way) — not
// proven here; the mechanism each rests on (zero-statements-before-refusal
// for `lock()`, the exact WHERE/ORDER BY/LIMIT `after()` builds, the exact
// conflict `update()` raises on a stale version) is.

@table class VerAccount {
  @id
  id: i64
  name: string
  @version
  version: i64
}

test "lock() outside a transaction fails with LockError before issuing any statement (#6276)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 0 }
  let p = newWrPool(a)
  let repo = Repo<Account>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  repo.lock().find(1) catch _ {
    assert(len(a.calls) == 0, "lock() on a Pool must issue zero statements before refusing")
    return
  }
  assert(false, "lock() on a Pool (no transaction) must fail")
}

test "after() adds WHERE col > $n off the first orderBy(), never an OFFSET (#6276)" {
  let a = wrAdapter{
    cols = ["id", "name", "email"], rows = [[Value.Int(2), Value.Text("Bo"), Value.Text("b@x.com")]],
    affected = 0,
  }
  let p = newWrPool(a)
  let repo = Repo<Account>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  let paged = repo.orderBy("id").after(1) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  paged.limit(20).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from account where id > $1 order by id asc limit 20"
  assert(lastWrCall(a).sql == want, "got: ${lastWrCall(a).sql}")
}

test "a stale-version update fails with StaleWriteError, never a plain WriteError (#6276)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 0 }
  let p = newWrPool(a)
  let repo = Repo<VerAccount>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  repo.update(VerAccount{ id = 1, name = "Ada", version = 5 }) catch e {
    let (se, ok) = e.(StaleWriteError)
    assert(ok, "must be a StaleWriteError, got '${e.message()}'")
    assert(se.oldVersion == 5, "wanted oldVersion 5, got ${se.oldVersion}")
    assert(se.newVersion == 6, "wanted newVersion 6, got ${se.newVersion}")
    let (_, isWriteError) = e.(WriteError)
    assert(!isWriteError, "a stale write must never also satisfy WriteError")
    assert(
      contains(lastWrCall(a).sql, "and version = $"),
      "the UPDATE's own WHERE must carry the old version, got: ${lastWrCall(a).sql}",
    )
    return
  }
  assert(false, "a 0-row UPDATE on a @version table must fail")
}

// #6283: `orderBy(column)`'s `Dir.Asc` default failed to sort ascending
// live, and `withDeleted()` failed to surface a soft-deleted row live — both
// against real Postgres only, both because a REUSED `Repo<T>` (the locked
// target's own shape: `db.table<T>()` once, every following statement off
// that same variable) mutated `this.orderBys`/`this.wheres`/
// `this.includeDeleted` in place, so the second statement silently
// inherited the first's. Every test above builds a fresh `Repo<T>{...}`
// literal per scenario, so no fake test ever chained two TOP-LEVEL
// statements off the same instance, and `wrAdapter` replays its canned
// `rows` no matter what SQL text it is handed — only the emitted SQL TEXT
// of a SECOND call proves whether a chain method leaked a clause onto its
// receiver.
//
// FIX (integrator, superseding the first pass): `Repo<T>` is a STABLE
// HANDLE — `where`/`orderBy`/`limit`/`offset`/`after`/`withDeleted`/`set`
// never mutate `this`; each returns a NEW `Repo<T>` carrying the added
// clause, copying `wheres`/`args`/`orderBys`/`sets` first (`cloneStrings`/
// `cloneValues`) rather than `append`ing onto the receiver's own arrays —
// `append` reuses spare backing-array capacity in place, so two chains
// built off the same parent could otherwise silently overwrite each
// other's clause even with the copy-on-write RETURN value in place. A
// `Repo<T>` a caller keeps (`let q = people.where(...)`) is therefore safe
// to reuse: `people` itself never changes, and `q` always means the same
// query no matter how many times a terminal runs on it.

test "orderBy() on a reused Repo<T> replaces the previous sort, never appends to it (#6283)" {
  let a = wrAdapter{
    cols = ["id", "name", "email"], rows = [
      [Value.Int(1), Value.Text("Ada"), Value.Text("ada@x.com")],
    ],
    affected = 0,
  }
  let p = newWrPool(a)
  let repo = Repo<Account>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  repo.orderBy("name", Dir.Desc).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  repo.orderBy("name").all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from account order by name asc"
  assert(
    lastWrCall(a).sql == want,
    "the second orderBy() must not still carry the first call's 'desc' — got: ${lastWrCall(a).sql}",
  )
}

test "where()/withDeleted() on a reused Repo<T> does not carry the previous call's WHERE (#6283)" {
  let a = wrAdapter{
    cols = ["id", "body", "deleted_at"],
    rows = [[Value.Int(1), Value.Text("hi"), Value.Int(0)]],
    affected = 0,
  }
  let p = newWrPool(a)
  let repo = Repo<Comment>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  repo.where("id", 1).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  repo.withDeleted().where("id", 1).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from comment where id = $1"
  assert(
    lastWrCall(a).sql == want,
    "withDeleted() after a prior where().all() must not still carry the first call's predicate — got: ${lastWrCall(a).sql}",
  )
}

// #6282: `find(id)` on a `@softDelete` class must hide a deleted row like
// every other read; `withDeleted()` is the only way to see it.
test "find() on a @softDelete class excludes a deleted row by default, withDeleted().find() includes it (#6282)" {
  let a = wrAdapter{
    cols = ["id", "body", "deleted_at"],
    rows = [[Value.Int(1), Value.Text("hi"), Value.Int(0)]],
    affected = 0,
  }
  let p = newWrPool(a)
  let repo = Repo<Comment>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  repo.find(1) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from comment where id = $1 and deleted_at is null limit 2"
  assert(
    lastWrCall(a).sql == want,
    "find() must exclude a soft-deleted row by default — got: ${lastWrCall(a).sql}",
  )

  repo.withDeleted().find(1) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want2 = "select * from comment where id = $1 limit 2"
  assert(
    lastWrCall(a).sql == want2,
    "withDeleted().find() must include a soft-deleted row — got: ${lastWrCall(a).sql}",
  )
}

// #6283 (integrator): `Repo<T>` is a stable handle — `where(...)` (and
// every other chain method) must return a NEW value, never mutate the one
// it was called on, so `let q = people.where("id", 1)` cannot make a LATER
// `people.all()` see a WHERE nobody asked `people` for.
test "where() never mutates the receiver — a later call off the original repo carries no WHERE (#6283)" {
  let a = wrAdapter{
    cols = ["id", "name", "email"], rows = [
      [Value.Int(1), Value.Text("Ada"), Value.Text("ada@x.com")],
    ],
    affected = 0,
  }
  let p = newWrPool(a)
  let people = Repo<Account>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  let q = people.where("id", 1)
  people.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let want = "select * from account"
  assert(
    lastWrCall(a).sql == want,
    "people.all() after 'let q = people.where(...)' must carry no WHERE — got: ${lastWrCall(a).sql}",
  )
  q.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let wantQ = "select * from account where id = $1"
  assert(
    lastWrCall(a).sql == wantQ,
    "q itself must still carry its own WHERE — got: ${lastWrCall(a).sql}",
  )
}

// #6283 (integrator): a `Repo<T>` a caller keeps must be reusable — calling
// a terminal on it twice must emit the identical statement both times,
// never accumulate or lose state on the first run.
test "a kept chain value emits the identical SQL on a second terminal call (#6283)" {
  let a = wrAdapter{
    cols = ["id", "name", "email"], rows = [
      [Value.Int(1), Value.Text("Ada"), Value.Text("ada@x.com")],
    ],
    affected = 0,
  }
  let p = newWrPool(a)
  let people = Repo<Account>{
    db = p, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  let q = people.where("id", 1)
  q.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let first = lastWrCall(a).sql
  q.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let second = lastWrCall(a).sql
  assert(
    first == second,
    "q reused for a second .all() must emit the identical SQL — got '${first}' then '${second}'",
  )
  assert(first == "select * from account where id = $1", "got: ${first}")
}

// #6274: soft delete (delete hides/withDeleted/restore/forceDelete) and
// bulk writes (insertAll/where().set().updateAll()/deleteAll), with
// `@timestamps` filled on insert/update/updateAll — the locked target's own
// `@softDelete`/`@timestamps` example (`.claude/kb/data-packages-dx.md`,
// "Approved 2026-09-29"). `deletedAt`/`createdAt`/`updatedAt` are plain
// `i64`/`Option<i64>` epoch-nanosecond columns, never `DateTime`/
// `Timestamp` — `pkg/orm/repo.bit`'s own header: `__values()` cannot map
// either type, so a `@table` class using one could not `insert`/`update` at
// all through `Repo<T>`. A RAW STRING (backtick, SPEC §on strings — no
// escapes) rather than `liveDbProofSource`'s escaped one, above: this
// source is new, so nothing forces it to match that file's own convention.
const liveSoftDeleteBulkProofSource: string = `import { args } from "std/os"
import { pool, Datasource, Value, FieldDesc, AttrDesc } from "std/sql"
import { adapter } from "postgres"
import { open } from "orm"

@table @softDelete @timestamps class Post {
  id: i64,
  title: string,
  deletedAt: Option<i64>,
  createdAt: i64,
  updatedAt: i64,
}

fn newPost(title: string): Post {
  return Post{ id = 0, title = title, deletedAt = Option<i64>.None, createdAt = 0, updatedAt = 0 }
}

fn main(): ()! {
  let uri = args()[1]
  let setup = pool(adapter(), Datasource{ uri = uri })?
  setup.exec("drop table if exists post", []Value(0))?
  setup.exec("create table post (id bigint generated always as identity primary key, title text not null, deleted_at bigint, created_at bigint not null, updated_at bigint not null)", []Value(0))?
  setup.close()

  let db = open(uri)?
  let posts = db.table<Post>()

  let p1 = posts.insert(newPost("one"))?
  if (p1.createdAt <= i64(0) || p1.updatedAt <= i64(0)) {
    panic("LIVE PROOF FAILED: @timestamps did not fill createdAt/updatedAt on insert")
  }

  let beforeUpdatedAt = p1.updatedAt
  p1.title = "one edited"
  posts.update(p1)?
  let afterUpdate = posts.find(p1.id)?
  if (afterUpdate.updatedAt < beforeUpdatedAt) {
    panic("LIVE PROOF FAILED: @timestamps did not bump updatedAt on update")
  }
  if (afterUpdate.createdAt != p1.createdAt) {
    panic("LIVE PROOF FAILED: update rewrote createdAt")
  }

  posts.delete(p1.id)?
  let hidden = posts.where("id", p1.id).all()?
  if (len(hidden) != 0) {
    panic("LIVE PROOF FAILED: delete on a @softDelete class did not hide the row")
  }
  let withTrashed = posts.withDeleted().where("id", p1.id).all()?
  if (len(withTrashed) != 1) {
    panic("LIVE PROOF FAILED: withDeleted did not include the soft-deleted row")
  }

  // #6282: find(id) must hide a soft-deleted row like every other read;
  // withDeleted() is the only way to see it.
  let notFoundAfterDelete = false
  posts.find(p1.id) catch e {
    notFoundAfterDelete = true
  }
  if (!notFoundAfterDelete) {
    panic("LIVE PROOF FAILED: find() must hide a soft-deleted row (#6282)")
  }
  let foundViaWithDeleted = posts.withDeleted().find(p1.id)?
  if (foundViaWithDeleted.id != p1.id) {
    panic("LIVE PROOF FAILED: withDeleted().find() must still return the soft-deleted row (#6282)")
  }

  posts.restore(p1.id)?
  let restored = posts.where("id", p1.id).all()?
  if (len(restored) != 1) {
    panic("LIVE PROOF FAILED: restore did not un-hide the row")
  }

  posts.forceDelete(p1.id)?
  let afterForce = posts.withDeleted().where("id", p1.id).all()?
  if (len(afterForce) != 0) {
    panic("LIVE PROOF FAILED: forceDelete left a row behind")
  }

  let inserted = posts.insertAll([newPost("bulk1"), newPost("bulk2")])?
  if (len(inserted) != 2 || inserted[0].id <= i64(0) || inserted[1].id <= i64(0)) {
    panic("LIVE PROOF FAILED: insertAll did not return rows with generated ids")
  }
  if (inserted[0].createdAt <= i64(0) || inserted[1].createdAt <= i64(0)) {
    panic("LIVE PROOF FAILED: insertAll did not fill @timestamps")
  }

  let updatedCount = posts.where("title", "bulk1").set("title", "Draft").updateAll()?
  if (updatedCount != 1) {
    panic("LIVE PROOF FAILED: updateAll returned the wrong count")
  }
  let afterBulkUpdate = posts.find(inserted[0].id)?
  if (afterBulkUpdate.title != "Draft") {
    panic("LIVE PROOF FAILED: updateAll did not write the set() column")
  }

  let deletedCount = posts.where("title", "bulk2").deleteAll()?
  if (deletedCount != 1) {
    panic("LIVE PROOF FAILED: deleteAll returned the wrong count")
  }
  let afterBulkDelete = posts.where("id", inserted[1].id).all()?
  if (len(afterBulkDelete) != 0) {
    panic("LIVE PROOF FAILED: deleteAll (soft) did not hide the row")
  }
  let afterBulkDeleteTrashed = posts.withDeleted().where("id", inserted[1].id).all()?
  if (len(afterBulkDeleteTrashed) != 1) {
    panic("LIVE PROOF FAILED: deleteAll on a @softDelete class hard-deleted instead of hiding")
  }

  print("LIVE_PROOF_OK")
}
`

test "live: Repo<T> soft delete (delete/withDeleted/restore/forceDelete) and bulk writes (insertAll/updateAll/deleteAll), @timestamps filled (#6274)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("liveproof6274")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6274\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveSoftDeleteBulkProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}
