// pkg/orm/bulk.test.bit — #5072's acceptance for `insertAll`, against a fake
// driver.
//
// `bkAdapter` is the "database": every `query()` call is recorded
// (`calls`, so a test can assert the STATEMENT COUNT), and the row set it
// hands back is not canned — it is computed from the arguments the
// statement actually carried, `len(params) / len(cols)` groups, each
// answering with a fresh, monotonically increasing `id` (modelling a
// database auto-increment column) alongside every other column's value the
// caller sent, unchanged. That is what lets the chunk-boundary test below
// prove every row arrived exactly once: `seq` is the one value this file
// controls end to end, so a dropped, duplicated or reordered row shows up
// as a `seq` that is missing, or seen twice, out of `0..n-1`.
//
// `pool`/`Pool`/`Datasource`/`Conn`/`Rows`/`Stmt`/`Tx`/`Value`/`Isolation`
// are imported by ./data.test.bit, this file's sibling in the same module
// (SPEC §17.1) — a second import here would be E0042. `FieldDesc`/`AttrDesc`
// by ./naming.bit. `Account`/`accountDesc`/`accountValues`/`fieldWithId`
// are declared in ./write.test.bit and reused here rather than redeclared,
// the same way that file reuses `field` from ./naming.test.bit.

class bkCall { sql: string, args: []Value }

// One canned RETURNING row per group, replayed byte-for-byte from what the
// statement itself carried — see this file's header.
class bkRows {
  cols: []string
  data: [][]Value
  i: int

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

// The fake database: every `query()` call, in order, and a monotonically
// increasing generated-key counter shared across every call — modelling one
// auto-increment sequence across every chunk `insertAll` issues.
class bkAdapter {
  calls: []bkCall
  nextId: i64
  // The columns each `RETURNING *` row carries, `id` always first.
  cols: []string
  // The number of BOUND placeholders per VALUES group `query()` steps
  // `params` by — one less than `len(cols)` when the entity carries a sole
  // database-generated `@id` (#6107: `insertAllSql`/`rowMarksAndArgs` exclude
  // it from both the column list and the bound arguments, the same way
  // `write.bit`'s `insertColumnsAndArgs` already does for a single-row
  // INSERT, #6101). Set explicitly per test rather than derived from `cols`,
  // since the two counts now legitimately differ.
  paramsPerRow: int

  connect(cfg: Datasource): Conn! {
    return bkConn{ a = this }
  }
}

class bkConn {
  a: bkAdapter

  // Computes its RETURNING rows from `params` itself: `len(params) /
  // paramsPerRow` groups, each answering with a fresh generated `id` (column
  // 0) and every bound column echoed back exactly as sent, in order.
  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, bkCall{ sql = sqlText, args = params })
    let width = this.a.paramsPerRow
    let data = [][]Value(0)
    let i = 0
    while (i < len(params)) {
      this.a.nextId = this.a.nextId + 1
      let row = []Value(0)
      row = append(row, Value.Int(this.a.nextId))
      let j = 0
      while (j < width) {
        row = append(row, params[i + j])
        j = j + 1
      }
      data = append(data, row)
      i = i + width
    }
    return bkRows{ cols = this.a.cols, data = data, i = -1 }
  }

  exec(sqlText: string, params: []Value): int! {
    fail newError("fake: exec not supported")
  }

  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }

  begin(): Tx! {
    fail newError("fake: begin not supported")
  }

  close() {}
}

fn newBkPool(a: bkAdapter): Pool {
  let p = pool(a, Datasource{ host = "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

// A 4-column entity — `id` (`@id`, generated), `seq`, `note`, `extra` —
// exactly the width `65535 / 4` in `maxRowsPerChunk` (bulk.bit) divides by.
fn bulkItemDesc(): TableDesc {
  return TableDesc{
    table = "bulk_items", fields = [fieldWithId("id"), field("seq"), field("note"), field("extra")],
  }
}

fn bulkItemValues(seq: int): map<string, Value> {
  return map<string, Value>{
    "id": Value.Int(0), "seq": Value.Int(seq), "note": Value.Text("n"), "extra": Value.Text("e"),
  }
}

test "insertAll with 3 rows issues exactly 1 statement carrying 3 value groups" {
  let a = bkAdapter{
    calls = []bkCall(0),
    nextId = 0,
    cols = ["id", "name", "email"],
    paramsPerRow = 2,
  }
  let p = newBkPool(a)
  let u0 = Account{ id = 0, name = "Ada", email = "a@x.com" }
  let u1 = Account{ id = 0, name = "Bea", email = "b@x.com" }
  let u2 = Account{ id = 0, name = "Cid", email = "c@x.com" }
  let rows = [accountValues(u0), accountValues(u1), accountValues(u2)]

  let generated = insertAll(p, accountDesc(), rows) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 1, "must issue exactly 1 statement, got ${len(a.calls)}")
  // `id` is excluded (#6107, same reasoning #6101 already gave write.bit's
  // single-row INSERT): Postgres's `generated always as identity` refuses an
  // explicit INSERT value for it.
  let want = "insert into accounts (name, email) values ($1, $2), ($3, $4), ($5, $6) returning *"
  assert(a.calls[0].sql == want, "got: ${a.calls[0].sql}")
  assert(len(generated) == 3, "must return one row per input row, got ${len(generated)}")
}

test "an INSERT with database-generated keys fills every entity's key and marks it persisted" {
  let a = bkAdapter{
    calls = []bkCall(0),
    nextId = 100,
    cols = ["id", "name", "email"],
    paramsPerRow = 2,
  }
  let p = newBkPool(a)
  let u0 = Account{ id = 0, name = "Ada", email = "a@x.com" }
  let u1 = Account{ id = 0, name = "Bea", email = "b@x.com" }
  let users = [u0, u1]
  let rows = [accountValues(u0), accountValues(u1)]

  let generated = insertAll(p, accountDesc(), rows) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let i = 0
  while (i < len(users)) {
    let (idVal, ok) = generated[i]["id"]
    assert(ok, "generated[${i}] must carry a filled 'id'")
    match (idVal) {
      Int(n) => users[i].id = n
      _ => assert(false, "generated id must be an Int")
    }
    users[i].markPersisted(true)
    i = i + 1
  }
  assert(users[0].id == 101, "got ${users[0].id}")
  assert(users[1].id == 102, "got ${users[1].id}")
  assert(users[0].isPersisted(), "each returned entity must read isPersisted() true")
  assert(users[1].isPersisted(), "each returned entity must read isPersisted() true")
}

// The chunk boundary is where a dropped or duplicated row would hide: 30000
// is deliberately NOT a multiple of `65535 / 4`, so the last chunk is
// short, and the test proves the boundary neither drops nor repeats a row.
test "30000 rows of a 4-column entity chunk at 65535/4 placeholders, every row exactly once" {
  let a = bkAdapter{
    calls = []bkCall(0), nextId = 0, cols = ["id", "seq", "note", "extra"], paramsPerRow = 3,
  }
  let p = newBkPool(a)
  let total = 30000
  let rows = []map<string, Value>(0)
  let i = 0
  while (i < total) {
    rows = append(rows, bulkItemValues(i))
    i = i + 1
  }

  let generated = insertAll(p, bulkItemDesc(), rows) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let chunkSize = 65535 / 4
  let expectedChunks = (total + chunkSize - 1) / chunkSize
  assert(
    len(a.calls) == expectedChunks,
    "must issue ${expectedChunks} statements for ${total} rows at ${chunkSize} rows/chunk, got ${len(a.calls)}",
  )
  assert(len(generated) == total, "must return exactly ${total} rows, got ${len(generated)}")

  let seen = []bool(total)
  let dupes = 0
  let outOfRange = 0
  for g of generated {
    let (seqVal, ok) = g["seq"]
    assert(ok, "every returned row must carry 'seq'")
    match (seqVal) {
      Int(n) => {
        if (n < 0 || n >= i64(total)) {
          outOfRange = outOfRange + 1
        } else if (seen[n]) {
          dupes = dupes + 1
        } else {
          seen[n] = true
        }
      }
      _ => assert(false, "'seq' must be an Int")
    }
  }
  assert(
    outOfRange == 0,
    "no returned row's seq may fall outside 0..${total - 1}, got ${outOfRange} out of range",
  )
  assert(dupes == 0, "no seq may repeat across chunks, got ${dupes} duplicate(s)")
  let missing = 0
  let j = 0
  while (j < total) {
    if (!seen[j]) {
      missing = missing + 1
    }
    j = j + 1
  }
  assert(missing == 0, "every seq 0..${total - 1} must be present, got ${missing} missing")
}

// #6107, against a real Postgres server (`write.test.bit`'s own header
// pattern): `ORM_TEST_LIVE_PG_URI` supplies a connection string; this test
// skips only when it is unset, and says so. Builds the table through
// pkg/orm's OWN `t.id("id")` schema builder and Postgres renderer, never a
// hand-typed DDL string, then round-trips two rows through `insertAll()` —
// pre-fix this hit SQLSTATE 428C9 the identical way #6101's single-row
// `save()` did. `env`/`run` (std/os), `envOr` (std/os) and
// `findRepoRoot`/`scratchDir`/`resetDir` are already imported/declared
// package-wide by `generate.bit`/`generate.test.bit` — see `write.test.bit`'s
// own header for why importing or redeclaring any of them here would be
// E0042.
const liveBulkProofSource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value, FieldDesc, AttrDesc } from \"std/sql\"\nimport { adapter } from \"postgres\"\nimport { TableDesc, Data, insertAll, table, Postgres } from \"orm\"\n\nfn itemDesc(): TableDesc {\n  return TableDesc{\n    table = \"t6107_items\",\n    fields = [\n      FieldDesc{ name = \"id\", typeName = \"i64\", attrs = [AttrDesc{ name = \"id\", args = []string(0) }] },\n      FieldDesc{ name = \"name\", typeName = \"string\", attrs = []AttrDesc(0) },\n    ],\n    classAttrs = []AttrDesc(0),\n  }\n}\n\nfn main(): ()! {\n  let uri = args()[1]\n  let db = pool(adapter(), Datasource{ uri = uri }) catch e {\n    panic(\"pool: \${e.message()}\")\n  }\n\n  db.exec(\"drop table if exists t6107_items\", []Value(0)) catch e { panic(\"drop: \${e.message()}\") }\n\n  let op = table(\"t6107_items\", (t) => {\n    t.id(\"id\")\n    t.string(\"name\", 100)\n  })\n  let stmts = Postgres{}.render(op)\n  for st of stmts {\n    db.exec(st.sql, []Value(0)) catch e { panic(\"create via schema builder: \${e.message()}\") }\n  }\n\n  let rows = [\n    map<string, Value>{ \"id\": Value.Int(0), \"name\": Value.Text(\"a\") },\n    map<string, Value>{ \"id\": Value.Int(0), \"name\": Value.Text(\"b\") },\n  ]\n  let generated = insertAll(db, itemDesc(), rows) catch e {\n    panic(\"LIVE PROOF FAILED (#6107): insertAll against a GENERATED ALWAYS AS IDENTITY table: \${e.message()}\")\n  }\n  if (len(generated) != 2) {\n    panic(\"LIVE PROOF FAILED: expected 2 generated rows, got \${len(generated)}\")\n  }\n  for g of generated {\n    let (idVal, ok) = g[\"id\"]\n    if (!ok) {\n      panic(\"LIVE PROOF FAILED: RETURNING did not fill the generated id\")\n    }\n    match (idVal) {\n      Int(n) => {\n        if (n <= i64(0)) {\n          panic(\"LIVE PROOF FAILED: generated id must be positive, got \${n}\")\n        }\n      }\n      _ => panic(\"LIVE PROOF FAILED: generated id was not an Int\")\n    }\n  }\n\n  db.exec(\"drop table t6107_items\", []Value(0)) catch e { panic(\"cleanup: \${e.message()}\") }\n  db.close()\n  print(\"LIVE_PROOF_OK\")\n}\n"

test "live: insertAll() against a real GENERATED ALWAYS AS IDENTITY table (#6107)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let proj = scratchDir("liveproof6107")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6107\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveBulkProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}
