// pkg/orm/keyset.test.bit — #5072's acceptance for `after()`, against a
// fake driver.
//
// `qryAdapter`/`qryConn`/`newQryPool`/`lastCall`/`Widget`/`widgetMapper`
// are declared in ./query.test.bit, this file's sibling in the same module
// (SPEC §17.1), and reused here rather than redeclared — the same "one
// mapped class every test shares" that file's own header explains.
// `contains` (std/strings) is imported there too; a second import here
// would be E0042. `field`/`fieldWithId` are ./naming.test.bit/
// ./write.test.bit's own helpers, reused likewise.

fn fieldWithUnique(name: string): FieldDesc {
  return FieldDesc{
    name: name,
    typeName: "string",
    attrs: [AttrDesc{ name: "unique", args: []string(0) }],
  }
}

test "after() composes with orderBy: WHERE col > $n ORDER BY col LIMIT n, never an OFFSET" {
  let a = qryAdapter{ cols: []string(0), rows: [][]Value(0) }
  let p = newQryPool(a)
  let fields = [fieldWithId("id")]

  let q = find<Widget>(p, "widgets", fields, widgetMapper).orderBy("id", Dir.Asc)
  let q2 = q.after(Value.Int(42)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  q2.limit(50).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = "select * from widgets where id > $1 order by id asc limit 50"
  assert(lastCall(a).sql == want, "got: ${lastCall(a).sql}")
  assert(
    !contains(lastCall(a).sql, "offset"),
    "keyset pagination must carry no OFFSET: ${lastCall(a).sql}",
  )
}

test "after() with no orderBy() set is refused" {
  let a = qryAdapter{ cols: []string(0), rows: [][]Value(0) }
  let p = newQryPool(a)
  let fields = [fieldWithId("id")]

  find<Widget>(p, "widgets", fields, widgetMapper).after(Value.Int(1)) catch e {
    let (ke, ok) = e.(KeysetError)
    assert(ok, "must be a KeysetError, got '${e.message()}'")
    assert(ke.cause == KeysetCause.NoOrderBy, "cause must be NoOrderBy")
    return
  }
  assert(false, "after() with no orderBy() must be refused")
}

test "after() ordering on a non-unique column is refused, naming that column" {
  let a = qryAdapter{ cols: []string(0), rows: [][]Value(0) }
  let p = newQryPool(a)
  let fields = [fieldWithId("id"), field("name")]

  find<Widget>(p, "widgets", fields, widgetMapper).orderBy("name", Dir.Asc).after(Value.Int(1)) catch e {
    let (ke, ok) = e.(KeysetError)
    assert(ok, "must be a KeysetError, got '${e.message()}'")
    assert(ke.cause == KeysetCause.NotUnique, "cause must be NotUnique")
    assert(contains(e.message(), "name"), "must name the column: ${e.message()}")
    return
  }
  assert(false, "after() ordering on a non-unique column must be refused")
}

test "after() also accepts a column marked @unique, not just @id, and a descending order flips the operator" {
  let a = qryAdapter{ cols: []string(0), rows: [][]Value(0) }
  let p = newQryPool(a)
  let fields = [fieldWithId("id"), fieldWithUnique("email")]

  let q = find<Widget>(p, "widgets", fields, widgetMapper).orderBy("email", Dir.Desc)
  let q2 = q.after(Value.Text("z@x.com")) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  q2.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    contains(lastCall(a).sql, "email < $1"),
    "a descending order must compare with '<': ${lastCall(a).sql}",
  )
}
