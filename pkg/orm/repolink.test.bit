// pkg/orm/repolink.test.bit — Repo<T>/TxRepo<T>.with() on a `@manyToMany`
// field and link/unlink (#6275/#6277), split out of repo.test.bit
// (LINT.md's 800-line ceiling) once #6278's own lock()/after()/@version
// live proofs pushed that file over it — a
// pure move for repo.test.bit's own pre-existing content, this file's own
// content net new. `findRepoRoot`/`scratchDir`/`resetDir`/`env`/`envOr`/
// `run` (testenv.test.bit), `wrAdapter`/`newWrPool`/
// `lastWrCall` (write.test.bit), `mtmUser`/`mtmRole`/`mtmAdapter`/`mtmCall`/
// `mtmResult`/`newMtmPool` (manytomany.test.bit) are this module's own
// siblings (SPEC §17.1) — importing or redeclaring any of them here would
// be E0042.
//
// `mtmUser`/`mtmRole` (./manytomany.test.bit) already carry a real
// `@manyToMany("user_roles")` field each — no new class needed. `mtmUser`'s
// default table name is `toSnakeCase("mtmUser")` = "mtm_user"
// (`compiler/classtablerow.bit`'s own default, unless overridden), and its
// join columns are `toSnakeCase(rawClassName) + "_id"` computed at COMPILE
// time from `mtmUser`/`mtmRole`'s own raw names ("mtm_user_id"/"mtm_role_id")
// — never from `__tableName()` — exactly the two SQL strings these tests
// assert on, proving `__linkRelation` (compiler/classtablerelationlink.bit)
// derived both correctly.

// `mtmAdapter`/`newMtmPool` (./manytomany.test.bit) replay one canned
// result set per `query()` call in order, needed here for the same reason
// `manytomany.test.bit`'s own tests take it: proving `with()` on a
// `@manyToMany` field issues the parent SELECT and the join SELECT as TWO
// distinct statements (`compiler/classtablerelation.bit`'s `with()` arm,
// `manytomany.bit`'s `manyToManyLoader`), never a query per parent row.
test "with() eager-loads a @manyToMany field in exactly 2 statements, never N+1 (#6275)" {
  let a = mtmAdapter{
    calls = []mtmCall(0),
    results = [
      mtmResult{ cols = ["id"], rows = [[Value.Int(1)]] },
      mtmResult{
        cols = ["id", "mtm_owner_id"],
        rows = [[Value.Int(10), Value.Int(1)], [Value.Int(20), Value.Int(1)]],
      },
    ],
    affected = 0,
  }
  let p = newMtmPool(a)
  let repo = Repo<mtmUser>{
    db = p, dialect = ServerDialect.Postgres, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  let got = repo.with("roles").all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    len(a.calls) == 2,
    "with() on a @manyToMany field must issue exactly 2 statements, got ${len(a.calls)}",
  )
  assert(
    contains(a.calls[1].sql, "join user_roles on mtm_role.id = user_roles.mtm_role_id"),
    "join query got: ${a.calls[1].sql}",
  )
  assert(len(got) == 1, "expected 1 parent row, got ${len(got)}")
  assert(len(got[0].roles) == 2, "expected 2 loaded roles, got ${len(got[0].roles)}")
  assert(
    got[0].roles[0].id == i64(10) && got[0].roles[1].id == i64(20),
    "roles not loaded correctly",
  )
}

test "link()/unlink() attach/detach through the compiler-synthesized __linkRelation (#6275/#6277)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 0 }
  let p = newWrPool(a)
  let repo = Repo<mtmUser>{
    db = p, dialect = ServerDialect.Postgres, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  let u = mtmUser{ id = 5 }

  repo.link(u, "roles", [1, 2]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let wantAttach = "insert into user_roles (mtm_user_id, mtm_role_id) values ($1, $2), ($3, $4) on conflict (mtm_user_id, mtm_role_id) do nothing"
  assert(lastWrCall(a).sql == wantAttach, "got: ${lastWrCall(a).sql}")

  repo.unlink(u, "roles", [2]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let wantDetach = "delete from user_roles where mtm_user_id = $1 and mtm_role_id in ($2)"
  assert(lastWrCall(a).sql == wantDetach, "got: ${lastWrCall(a).sql}")
}

test "link() with an unknown relation name fails naming the table, issuing no statement (#6275/#6277)" {
  let a = wrAdapter{ cols = []string(0), rows = [][]Value(0), affected = 0 }
  let p = newWrPool(a)
  let repo = Repo<mtmUser>{
    db = p, dialect = ServerDialect.Postgres, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  let u = mtmUser{ id = 5 }
  repo.link(u, "bogus", [1]) catch e {
    assert(contains(e.message(), "mtm_user"), "must name the table: ${e.message()}")
    assert(len(a.calls) == 0, "an unknown relation name must issue no statement")
    return
  }
  assert(false, "link() with an unknown relation name must fail")
}

// #6275: the locked target's own many-to-many example
// (`posts.link(post, "tags", [1, 2])?`/`unlink`), against a real Postgres
// server — repo.test.bit's own header explains why a spawned subprocess,
// not a call from inside this module. Also proves link/unlink through
// `TxRepo<T>` (pkg/orm/txrepo.bit, #6278's own forward this ticket added
// alongside it): `db.tx((tx) => { tx.table<Post>().link(...) })?` must
// attach inside the transaction and be visible to a read off the SAME
// transaction handle before it commits.
const liveLinkProofSource: string = `import { args } from "std/os"
import { pool, Datasource, Value, asInt } from "std/sql"
import { adapter } from "postgres"
import { open } from "orm"

@table class Tag {
  id: i64,
  name: string,
}

@table class Post {
  id: i64,
  title: string,
  @manyToMany("post_tags")
  tags: []Tag,
}

fn main(): ()! {
  let uri = args()[1]
  let setup = pool(adapter(), Datasource{ uri = uri })?
  setup.exec("drop table if exists post_tags", []Value(0))?
  setup.exec("drop table if exists post", []Value(0))?
  setup.exec("drop table if exists tag", []Value(0))?
  setup.exec("create table tag (id bigint generated always as identity primary key, name text not null)", []Value(0))?
  setup.exec("create table post (id bigint generated always as identity primary key, title text not null)", []Value(0))?
  setup.exec("create table post_tags (post_id bigint not null, tag_id bigint not null, primary key (post_id, tag_id))", []Value(0))?

  let db = open(uri)?
  let posts = db.table<Post>()
  let tags = db.table<Tag>()

  let p = posts.insert(Post{ id = 0, title = "hello", tags = []Tag(0) })?
  let t1 = tags.insert(Tag{ id = 0, name = "bit" })?
  let t2 = tags.insert(Tag{ id = 0, name = "orm" })?

  posts.link(p, "tags", [t1.id, t2.id])?
  let afterLink = setup.query("select count(*) from post_tags where post_id = $1", [Value.Int(p.id)])?
  if (!afterLink.next()?) { panic("LIVE PROOF FAILED: no count row") }
  if (asInt(afterLink.value(0))? != 2) { panic("LIVE PROOF FAILED: link did not attach both tags") }
  afterLink.close()

  posts.link(p, "tags", [t1.id, t2.id])?
  let afterRelink = setup.query("select count(*) from post_tags where post_id = $1", [Value.Int(p.id)])?
  if (!afterRelink.next()?) { panic("LIVE PROOF FAILED: no count row") }
  if (asInt(afterRelink.value(0))? != 2) { panic("LIVE PROOF FAILED: a repeat link() must not duplicate the pair") }
  afterRelink.close()

  posts.unlink(p, "tags", [t2.id])?
  let afterUnlink = setup.query("select tag_id from post_tags where post_id = $1", [Value.Int(p.id)])?
  if (!afterUnlink.next()?) { panic("LIVE PROOF FAILED: unlink removed both pairs") }
  if (asInt(afterUnlink.value(0))? != int(t1.id)) { panic("LIVE PROOF FAILED: unlink removed the wrong pair") }
  if (afterUnlink.next()?) { panic("LIVE PROOF FAILED: unlink left the detached pair behind") }
  afterUnlink.close()

  posts.link(p, "tags", [t2.id])?
  let loaded = posts.with("tags").where("id", p.id).all()?
  if (len(loaded) != 1) { panic("LIVE PROOF FAILED: with(\"tags\") expected 1 parent row") }
  if (len(loaded[0].tags) != 2) { panic("LIVE PROOF FAILED: with(\"tags\") did not load both tags") }

  let p2 = posts.insert(Post{ id = 0, title = "second", tags = []Tag(0) })?
  db.tx((tx) => {
    tx.table<Post>().link(p2, "tags", [t1.id])?
    // Verified through the SAME transaction handle, never the separate
    // "setup" connection above: an uncommitted write is invisible to any
    // other connection under READ COMMITTED, so a check there would prove
    // isolation, not TxRepo.link. find() never runs with()'s own queued
    // eager-load (only all()/first() do), so this reads through
    // where().all() instead, matching the with("tags") check above.
    let inTx = tx.table<Post>().with("tags").where("id", p2.id).all()?
    if (len(inTx) != 1 || len(inTx[0].tags) != 1) {
      panic("LIVE PROOF FAILED: TxRepo<T>.link did not attach inside the transaction")
    }
    return
  })?
  let afterTx = setup.query("select count(*) from post_tags where post_id = $1", [Value.Int(p2.id)])?
  if (!afterTx.next()?) { panic("LIVE PROOF FAILED: no count row after tx commit") }
  if (asInt(afterTx.value(0))? != 1) { panic("LIVE PROOF FAILED: TxRepo<T>.link did not survive commit") }
  afterTx.close()
  setup.close()

  print("LIVE_PROOF_OK")
}
`

test "live: Repo<T>/TxRepo<T>.link/unlink round-trip a many-to-many relation, with() eager-loads it (#6275/#6277/#6278)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("liveproof6275link")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6275link\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveLinkProofSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["run", "${proj}/main.bit", uri])
  assert(
    rc == 0,
    "live proof against a real Postgres server failed, rc=${rc}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}'",
  )
  resetDir(proj)
}
