// pkg/orm/testdrivers.test.bit — the fake `Pool` drivers and mapped classes
// several `Repo<T>` test files share (SPEC §17.1): `wrAdapter` (every
// `query()`/`exec()` call recorded, one canned RETURNING row/affected count
// replayed) and `lockAdapter` (the same shape, but its `Conn.begin()`
// returns a real `Tx`-typed fake, the one thing `requireTx` needs to pass).
// Both were declared in write.test.bit/lock.test.bit, retired with those
// files' own old-API coverage (#6296) — the fakes themselves are generic
// and still what `repo.test.bit`/`repolink.test.bit`/`timestamps.test.bit`
// drive `Repo<T>` against.
//
// `Account`/`Comment` are real `@table` classes `Repo<T>`'s own tests
// instantiate directly (`Repo<Account>{...}`) — never a hand-built
// `TableDesc` (this package's split: `Repo<T>` reads `T.__tableName()`/
// `T.__columns()`/`T.__fromRow()`, all compiler-synthesized).
//
// `pool`/`Pool`/`Datasource`/`Conn`/`Rows`/`Stmt`/`Tx`/`Value` are imported
// by ./data.test.bit, this file's sibling in the same module (SPEC §17.1) —
// a second import here would be E0042.

@table class Account {
  @id
  id: i64
  name: string
  email: string
}

@table @softDelete class Comment {
  @id
  id: i64
  body: string
  deletedAt: Option<i64>
}

class wrCall { sql: string, args: []Value }

// One canned RETURNING row, replayed by every `query()` call.
class wrRows {
  cols: []string
  data: [][]Value
  i: int

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

// The fake database: every `query`/`exec` call, in order, plus the one
// canned RETURNING row and the one canned affected-row count a test wants
// back.
class wrAdapter {
  calls: []wrCall
  cols: []string
  rows: [][]Value
  affected: int

  connect(cfg: Datasource): Conn! {
    return wrConn{ a = this }
  }
}

class wrConn {
  a: wrAdapter

  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, wrCall{ sql = sqlText, args = params })
    return wrRows{ cols = this.a.cols, data = this.a.rows, i = -1 }
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    this.a.calls = append(this.a.calls, wrCall{ sql = sqlText, args = params })
    return ExecResult{ rowsAffected = this.a.affected }
  }

  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }

  begin(opts: TxOptions): Tx! {
    fail newError("fake: begin not supported")
  }

  close() {}
}

fn newWrPool(a: wrAdapter): Pool {
  let p = pool(a, Datasource{ host = "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

fn lastWrCall(a: wrAdapter): wrCall {
  return a.calls[len(a.calls) - 1]
}

class lockCall { sql: string, args: []Value }

class lockRows {
  cols: []string
  data: [][]Value
  i: int
  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }
  columns(): []string {
    return this.cols
  }
  value(col: int): Value {
    return this.data[this.i][col]
  }
  close() {}
}

// The fake database: every `query()` call, through either handle.
class lockAdapter {
  calls: []lockCall
  cols: []string
  rows: [][]Value
  connect(cfg: Datasource): Conn! {
    return lockConn{ a = this }
  }
}

// One physical connection - no transaction open, so `Pool.begin()` (below)
// is the only way to reach `lockTx`; a `query()` issued straight through
// here is exactly the "on a Pool" case `requireTx` refuses.
class lockConn {
  a: lockAdapter
  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, lockCall{ sql = sqlText, args = params })
    return lockRows{ cols = this.a.cols, data = this.a.rows, i = -1 }
  }
  exec(sqlText: string, params: []Value): ExecResult! {
    fail newError("fake: exec not supported")
  }
  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }
  begin(opts: TxOptions): Tx! {
    return lockTx{ a = this.a }
  }
  close() {}
}

// One open transaction. `query()` behaves exactly like `lockConn`'s -
// `p.tx()` is what the caller's `db` becomes a `Tx` under, never this fake's
// own bookkeeping - so `requireTx` sees this as "not a Pool" purely from its
// runtime type, the same assertion `stdlib/sql/tx.bit`'s `enter()` makes.
class lockTx {
  a: lockAdapter
  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, lockCall{ sql = sqlText, args = params })
    return lockRows{ cols = this.a.cols, data = this.a.rows, i = -1 }
  }
  exec(sqlText: string, params: []Value): ExecResult! {
    fail newError("fake: exec not supported")
  }
  commit(): ()! {}
  rollback(): ()! {}
}

fn newLockPool(a: lockAdapter): Pool {
  let p = pool(a, Datasource{ host = "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

fn lastLockCall(a: lockAdapter): lockCall {
  return a.calls[len(a.calls) - 1]
}

test "wrAdapter/lockAdapter record every statement and its bound args, in call order" {
  let wr = wrAdapter{
    cols = ["id", "name", "email"],
    rows = [[Value.Int(1), Value.Text("Ada"), Value.Text("ada@x.com")]],
    affected = 3,
  }
  let wp = newWrPool(wr)
  let repo = Repo<Account>{
    db = wp, wheres = []string(0), args = []Value(0), orderBys = []string(0),
    limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false, errText = "",
  }
  repo.find(1) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    lastWrCall(wr).sql == "select * from account where id = $1 limit 2",
    "got: ${lastWrCall(wr).sql}",
  )
  assert(len(wr.calls) == 1, "wrAdapter must record exactly one statement, got ${len(wr.calls)}")

  let lk = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let lp = newLockPool(lk)
  lp.tx((tx) => {
    tx.query("select 1", []Value(0))?
    return
  }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(lastLockCall(lk).sql == "select 1", "got: ${lastLockCall(lk).sql}")
}
