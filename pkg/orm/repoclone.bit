// pkg/orm/repoclone.bit — the two array-copy helpers `Repo<T>`'s chain
// methods (`pkg/orm/repo.bit`) use, split out to keep repo.bit under
// spec/LINT.md's 800-line ceiling (#6283, integrator).

// #6283 (integrator): every chain method in repo.bit copies `this.wheres`/
// `this.args`/`this.orderBys`/`this.sets` through one of these two BEFORE
// appending, rather than `append(this.wheres, x)` directly. `append`
// reuses the backing array in place whenever it still has spare capacity,
// so two chains built off the SAME parent (`let a = q.where("x", 1)` and
// `let b = q.where("y", 2)`, both extending `q.wheres`) would otherwise be
// able to silently overwrite each other's clause — a plain read-then-
// reassign of the FIELD (`resetChain`'s own former shape) does not protect
// against this, since the danger is in the shared ARRAY `append` writes
// into, not in which slice header points at it.
fn cloneStrings(s: []string): []string {
  let out = []string(len(s))
  let i = 0
  while (i < len(s)) {
    out[i] = s[i]
    i = i + 1
  }
  return out
}

fn cloneValues(v: []Value): []Value {
  let out = []Value(len(v))
  let i = 0
  while (i < len(v)) {
    out[i] = v[i]
    i = i + 1
  }
  return out
}
