// pkg/orm/raw.test.bit — #5073's acceptance: whereRaw, orderByField, and
// the source-level proof that raw.bit offers no identifier escaping.
//
// `qryAdapter`/`qryConn`/`newQryPool`/`lastCall`/`Widget`/`widgetMapper`/
// `argsEq` are declared in ./query.test.bit, this file's sibling in the
// same module (SPEC §17.1), and reused here rather than redeclared.
// `contains` (std/strings) is imported there too; a second import here
// would be E0042. `field` is ./naming.test.bit's own helper, reused
// likewise.

import { count } from "std/strings"
import { exists, readFile } from "std/fs"
import { envOr } from "std/os"

test "whereRaw emits the fragment verbatim, e bound as a parameter and absent from the SQL text" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id"), field("email")]
  let e = "e@x.com"

  find<Widget>(p, "widgets", fields, widgetMapper).whereRaw(
    "lower(email) = lower($1)",
    Value.Text(e),
  ).all() catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }

  let call = lastCall(a)
  let want = "select * from widgets where lower(email) = lower($1)"
  assert(call.sql == want, "got: ${call.sql}")
  assert(argsEq(call.args, [Value.Text(e)]), "bound args did not match")
  assert(!contains(call.sql, e), "e leaked into the SQL text")
}

// A whereRaw fragment composes with an EARLIER where() call: the fragment's
// own local `$1` must land at absolute position 2, never collide with the
// first clause's `$1`.
test "whereRaw composes with an earlier where(), its local $1 renumbered to the true position" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id"), field("email")]

  let q = find<Widget>(p, "widgets", fields, widgetMapper).where("id", Value.Int(7))
  q.whereRaw("lower(email) = lower($1)", Value.Text("e@x.com")).all() catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }

  let want = "select * from widgets where id = $1 and lower(email) = lower($2)"
  assert(lastCall(a).sql == want, "got: ${lastCall(a).sql}")
  assert(
    argsEq(lastCall(a).args, [Value.Int(7), Value.Text("e@x.com")]),
    "bound args did not match",
  )
}

test "testpanic_whereRaw_refuses_a_placeholder_with_no_supplied_argument" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id")]
  find<Widget>(p, "widgets", fields, widgetMapper).whereRaw("id = $1")
}

test "testpanic_whereRaw_refuses_a_supplied_argument_with_no_placeholder" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id")]
  find<Widget>(p, "widgets", fields, widgetMapper).whereRaw("id = 1", Value.Int(1))
}

test "orderByField with a name matching a descriptor field emits ORDER BY on the mapped column" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id"), field("createdAt")]

  let q = find<Widget>(p, "widgets", fields, widgetMapper).orderByField("createdAt", Dir.Desc) catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }
  q.all() catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }

  assert(
    contains(lastCall(a).sql, "order by created_at desc"),
    "got: ${lastCall(a).sql}",
  )
}

test "orderByField with an input not among the descriptor's fields is refused, naming it, and issues zero statements" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id"), field("email")]
  let malicious = "id; drop table users"

  find<Widget>(p, "widgets", fields, widgetMapper).orderByField(malicious, Dir.Asc) catch err {
    let (ce, ok) = err.(UnknownColumnError)
    assert(ok, "must be an UnknownColumnError, got '${err.message()}'")
    assert(ce.field == malicious, "must carry the rejected input, got '${ce.field}'")
    assert(contains(err.message(), malicious), "must name the rejected input: ${err.message()}")
    assert(len(a.calls) == 0, "must issue zero statements")
    return
  }
  assert(false, "orderByField on an unknown column must be refused")
}

test "orderByRaw emits the fragment verbatim in the ORDER BY clause" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id")]

  find<Widget>(p, "widgets", fields, widgetMapper).orderByRaw(
    "case tier when 'gold' then 0 else 1 end",
  ).all() catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }

  let want = "select * from widgets order by case tier when 'gold' then 0 else 1 end"
  assert(lastCall(a).sql == want, "got: ${lastCall(a).sql}")
}

// orderByRaw composes with an EARLIER orderByField() call: both fragments
// land in the ORDER BY clause in the order the calls were made.
test "orderByRaw composes with orderByField in call order" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id"), field("createdAt")]

  let q = find<Widget>(p, "widgets", fields, widgetMapper).orderByField(
    "createdAt",
    Dir.Desc,
  ) catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }
  q.orderByRaw("id is null").all() catch err {
    assert(false, "must not error: ${err.message()}")
    return
  }

  let want = "select * from widgets order by created_at desc, id is null"
  assert(lastCall(a).sql == want, "got: ${lastCall(a).sql}")
}

test "testpanic_orderByRaw_refuses_a_fragment_carrying_a_placeholder" {
  let a = qryAdapter{ cols = []string(0), rows = [][]Value(0) }
  let p = newQryPool(a)
  let fields = [field("id")]
  find<Widget>(p, "widgets", fields, widgetMapper).orderByRaw("case when id = $1 then 0 else 1 end")
}

// --- the source-level half of "no identifier quoting or escaping" --------

class BitLocation { bin: string, stdlib: string, repo: string }

// Same contract as pkg/web/node.test.bit's own `locateBit` (this package's
// first need of it): a degrade to an empty `BitLocation` never fails the
// gate, since `BIT_BIN`/`BIT_STDLIB`/`BIT_REPO` aren't guaranteed to be set
// outside `test-package-orm`'s own Gate.
fn locateBit(): BitLocation {
  let bin = envOr("BIT_BIN", "")
  let stdlib = envOr("BIT_STDLIB", "")
  let repo = envOr("BIT_REPO", "")
  let fromEnv = len(bin) > 0 && exists(bin) && len(stdlib) > 0 && exists(stdlib)
  fromEnv = fromEnv && len(repo) > 0 && exists("${repo}/pkg/orm/raw.bit")
  if (fromEnv) {
    return BitLocation{ bin = bin, stdlib = stdlib, repo = repo }
  }
  if (exists("bit-out/bin/bit") && exists("stdlib") && exists("pkg/orm/raw.bit")) {
    return BitLocation{ bin = "bit-out/bin/bit", stdlib = "stdlib", repo = "." }
  }
  return BitLocation{ bin = "", stdlib = "", repo = "" }
}

// Reads raw.bit's own source and asserts it names no identifier-quoting
// helper — the ticket's own hard constraint (#5073), extended by #5362 to
// cover `orderByRaw`'s own logic (`checkNoPlaceholder`) without narrowing
// it, run as a test so it cannot rot. `quoteIdent` is `pkg/orm/postgres.bit`'s
// real one (#5066); checked absent here as the specific named helper, and
// "quote"/"escape" checked absent from every `fn`/method name in THE WHOLE
// FILE as the general case — every function added to raw.bit, `orderByRaw`'s
// included, is covered by construction, not by naming it — so a
// differently-spelled helper is caught too.
//
// It asserts on source it actually READ: the byte count is checked first,
// so a failed or empty read cannot pass as "no helper found". The control
// at the end proves the search itself can find a positive.
test "source check: raw.bit names no identifier-quoting or -escaping helper" {
  let loc = locateBit()
  if (len(loc.repo) == 0) {
    print("raw.bit source check: repo not locatable (set BIT_REPO) — skipping\n")
    return
  }
  let src = readFile("${loc.repo}/pkg/orm/raw.bit") catch err {
    panic("read raw.bit: ${err.message()}")
  }
  assert(len(src) > 1000, "raw.bit read back ${len(src)} byte(s) — the read failed")

  assert(count(src, "quoteIdent") == 0, "raw.bit must not call or declare quoteIdent")
  assert(count(src, "fn quote") == 0, "raw.bit must not declare a *quote* helper")
  assert(count(src, "fn escape") == 0, "raw.bit must not declare an *escape* helper")

  // The control: the needle search itself must be able to find a positive,
  // proven against postgres.bit, which legitimately declares quoteIdent
  // (#5066) — a search that finds nothing anywhere would pass this test
  // for the wrong reason.
  let postgresSrc = readFile("${loc.repo}/pkg/orm/postgres.bit") catch err {
    panic("read postgres.bit: ${err.message()}")
  }
  assert(
    count(postgresSrc, "fn quote") > 0,
    "the quoting-helper search itself is broken — postgres.bit legitimately declares one",
  )
}
