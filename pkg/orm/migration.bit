// pkg/orm/migration.bit — the migration interface (O3a, #6309, owner ruling
// "laravel style", data-packages-dx.md "Migrations, approved
// 2026-09-30"): one class per migration file, `up`/`down` build a `Schema`,
// neither ever touches a database — `runner.bit`'s `migrate`/`rollback`
// render the collected ops and issue them, the same tree-not-text split
// `schema.bit`'s own header establishes for `SchemaOp`.
//
//   class CreatePerson {
//     up(s: Schema): ()! {
//       s.create("person", (t) => {
//         t.id()
//         t.string("name")
//         t.string("email").unique()
//         t.timestamps()
//       })?
//     }
//     down(s: Schema): ()! { s.drop("person")? }
//   }
//
// Interfaces are structural (SPEC §14.3): a class satisfies `Migration`
// simply by declaring both methods — there is no `implements`/base-type
// clause on a class declaration at all (SPEC §10.5's grammar), so a class
// is never written `class CreatePerson: Migration`. `pkg/orm`'s own
// `Postgres`/`Mysql` (`postgres.bit`/`mysql.bit`) already satisfy `Dialect`
// (`dialect.bit`) the identical way, with no annotation naming it.
//
// REPLACES THE OLD REGISTRY SHAPE (#5068's `Migration{ version, name,
// checksum, apply: () => []SchemaOp, revert: () => []SchemaOp }`, this
// file's home in `runner.bit` before #6309). Checksums and the
// checksum-mismatch refusal are dropped — Laravel has neither. A migration
// is identified by its FILE NAME, never a hand-assigned integer version:
// `MigrationFile.name` below is exactly the `migrations` table's own
// primary key (`history.bit`).
export interface Migration {
  up(s: Schema): ()!,
  down(s: Schema): ()!,
}

// One migration as the runner sees it: its file name (the checked-in
// registry's own ordering key — lexical order is chronological order,
// since `bit make migration` names files
// `YYYY_MM_DD_HHMMSS_<snake_name>.bit`, O5) paired with the class that
// implements it. `migratecli.bit` (O3b) builds this list from the
// generated migrations registry; `runner.bit` only ever reads it.
export class MigrationFile {
  export name: string,
  export m: Migration,
}

// Collects the `SchemaOp`s a migration's `up`/`down` declares — never
// touches a database (`schema.bit`'s own header: "SchemaOp carries no
// live-schema state"). `create`/`table`/`drop` mirror Laravel's own
// `Schema::create`/`Schema::table`/`Schema::drop`, built on this package's
// existing `table()`/`alter()`/`drop()` free functions (`schema.bit`) — the
// same intent-tree builder every other schema-facing site (`sync.bit`,
// `manytomany.bit`'s `manyToManyTable`) already uses, so a migration and a
// live sync render from the identical tree shape. `ops` stays `export` so
// a caller with an already-built `SchemaOp` in hand (`manyToManyTable`'s
// own return value — no `Schema` method builds a join table) can append it
// directly, `Table.raw`'s own "the escape hatch is deliberate" reasoning
// applied one level up.
export class Schema {
  export ops: []SchemaOp

  // A new table (Laravel's `Schema::create`).
  export create(name: string, build: (Table) => ()): ()! {
    requireTableName(name)?
    this.ops = append(this.ops, table(name, build))
  }

  // Changes to an EXISTING table (Laravel's `Schema::table` — the alter
  // form, despite the name; `schema.bit`'s own `alter()` builds it).
  export table(name: string, build: (AlterTable) => ()): ()! {
    requireTableName(name)?
    this.ops = append(this.ops, alter(name, build))
  }

  export drop(name: string): ()! {
    requireTableName(name)?
    this.ops = append(this.ops, drop(name))
  }
}

fn requireTableName(name: string): ()! {
  if (name == "") {
    fail newError("pkg/orm: migrate: Schema: table name must not be empty")
  }
}
