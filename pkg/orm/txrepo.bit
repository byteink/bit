// pkg/orm/txrepo.bit — `TxRepo<T>`, what `tx.table<T>()` hands back instead
// of `Repo<T>` (#6278).
//
// WHY A SEPARATE DECLARED TYPE, NOT A FLAG OR A SECOND TYPE PARAMETER ON
// `Repo<T>`. #6276 shipped `Repo<T>.lock()` reachable from `db.table<T>()`
// too — legal to CALL, only a runtime `LockError` once it ran (`requireTx`,
// pkg/orm/lock.bit), because `Db.table` and `TxHandle.table` (pkg/orm/db.bit)
// returned the identical `Repo<T>`. Bit generics have no per-instantiation
// specialization (SPEC §10.4: a method declared in a generic class's body
// belongs to the class for every type argument that satisfies its bound) —
// so a `Repo<T, H>` with a second, handle-marking parameter could not
// declare `lock()` only for `H = Tx`; the method would still exist (and
// still type-check) for `H = Db` too. The only way to make `db.table<T>()
// .lock()` fail AT COMPILE TIME is a handle-returning method whose RETURN
// TYPE differs — two distinct declared types, one of which simply does not
// declare `lock()` (`Repo<T>`, pkg/orm/repo.bit).
//
// NO DUPLICATED QUERY IMPLEMENTATION. Every method below but `lock()` is a
// one-line forward into `inner: Repo<T>` — the SQL building, `checkErr`,
// `columnFor`, `next()`'s copy-on-write and every other piece of the actual
// find/write logic live in exactly one place, `Repo<T>` (repo.bit). A chain
// method (`where`/`orderBy`/`limit`/`offset`/`after`/`withDeleted`/`set`/
// `with`) rewraps its result into a NEW `TxRepo<T>` rather than returning
// the bare `Repo<T>` `inner`'s own method already produces, so the tx
// flavour SURVIVES CHAINING — `tx.table<T>().where(...).lock()` needs
// `where()`'s return value to still carry `lock()`, which a bare `Repo<T>`
// no longer does. A terminal (`insert`/`find`/`all`/`first`/`update`/
// `delete`/`restore`/`forceDelete`/`insertAll`/`updateAll`/`deleteAll`)
// forwards its result unchanged — none of them return `Repo<T>`, so there is
// nothing to rewrap.
export class TxRepo<T: Tabled> {
  inner: Repo<T>

  export where(column: string, val: Value): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.where(column, val) }
  }
  export orderBy(column: string, dir: Dir = Dir.Asc): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.orderBy(column, dir) }
  }
  export limit(n: int): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.limit(n) }
  }
  export offset(n: int): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.offset(n) }
  }
  export after(key: Value): TxRepo<T>! {
    return TxRepo<T>{ inner = this.inner.after(key)? }
  }
  export withDeleted(): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.withDeleted() }
  }
  export set(column: string, val: Value): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.set(column, val) }
  }
  export with(name: string): TxRepo<T> {
    return TxRepo<T>{ inner = this.inner.with(name) }
  }

  // The method `Repo<T>` does not have — see this file's header. `mode`
  // picks the clause (`lockOptsFor`, pkg/orm/lock.bit); `dialect` is never
  // asked for again at the call site — it is the same `ServerDialect`
  // `Db.open()` derived once and already carried onto `this.inner`
  // (pkg/orm/db.bit), so a MySQL handle still renders the MySQL clause.
  export lock(mode: LockMode = LockMode.Update): LockedRepo<T> {
    return LockedRepo<T>{
      inner = this.inner,
      opts = lockOptsFor(mode),
      dialect = this.inner.dialect,
    }
  }

  export insert(v: T): T! {
    return this.inner.insert(v)?
  }
  export find(id: Value): T! {
    return this.inner.find(id)?
  }
  export all(): []T! {
    return this.inner.all()?
  }
  export first(): Option<T>! {
    return this.inner.first()?
  }
  export update(v: T): ()! {
    return this.inner.update(v)?
  }
  export delete(id: Value): ()! {
    return this.inner.delete(id)?
  }
  export restore(id: Value): ()! {
    return this.inner.restore(id)?
  }
  export forceDelete(id: Value): ()! {
    return this.inner.forceDelete(id)?
  }
  export insertAll(rows: []T): []T! {
    return this.inner.insertAll(rows)?
  }
  export updateAll(): int! {
    return this.inner.updateAll()?
  }
  export deleteAll(): int! {
    return this.inner.deleteAll()?
  }
}
