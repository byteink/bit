// pkg/orm/relation.test.bit — #5061's acceptance, against a fake driver
// that (unlike query.test.bit's `qryAdapter`, one canned result set for the
// whole test) hands back a DIFFERENT result set per statement, in call
// order — required to prove a parent query and its relation query are two
// distinct statements, not the same one replayed.
//
// `field`/`contains`/`Datasource`/`Value`/`Rows` are already declared by
// naming.test.bit/query.test.bit/data.test.bit, this module's own siblings
// (SPEC §17.1) — importing or redeclaring any of them here would be E0042.
//
// THE RUNNING SCHEMA. `relPerson` hasMany `relPost` (`authorId`), `relPost`
// belongsTo `relPerson` (the same foreign key, the other direction),
// `relPerson` hasOne `relProfile` (`personId`) — every field a real
// `@hasMany`/`@belongsTo`/`@hasOne`-attributed, `@table`-carrying class, so
// the unloaded-panic test below exercises the real compiler mechanism
// (#5271), not a hand-rolled stand-in.

class relCall { sql: string, args: []Value }
class relResult { cols: []string, rows: [][]Value }

class relRows {
  cols: []string
  data: [][]Value
  i: int

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

// One canned result set PER STATEMENT, replayed in call order — `results[0]`
// answers the first `query()` call, `results[1]` the second, and so on.
class relAdapter {
  calls: []relCall
  results: []relResult

  connect(cfg: Datasource): Conn! {
    return relConn{ a = this }
  }
}

class relConn {
  a: relAdapter

  query(sqlText: string, params: []Value): Rows! {
    let idx = len(this.a.calls)
    this.a.calls = append(this.a.calls, relCall{ sql = sqlText, args = params })
    let rs = this.a.results[idx]
    return relRows{ cols = rs.cols, data = rs.rows, i = -1 }
  }

  exec(sqlText: string, params: []Value): int! {
    fail newError("fake: exec not supported")
  }

  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }

  begin(): Tx! {
    fail newError("fake: begin not supported")
  }

  close() {}
}

fn newRelPool(a: relAdapter): Pool {
  let p = pool(a, Datasource{ host = "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

@table class relPerson {
  @id
  id: i64
  @hasMany("authorId")
  posts: []relPost
  @hasOne("personId")
  profile: relProfile
}

@table class relPost {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: relPerson
}

@table class relProfile {
  @id
  id: i64
  personId: i64
}

// `posts` is left OMITTED on purpose: a `[]T` relation field on a `@table`
// class is filled with #5271's reserved sentinel rather than an ordinary
// empty slice, and a loader's `assign` overwrites it exactly like any other
// field write. `profile`/`author` (both class-typed, not `[]T`) CANNOT be
// omitted at all — a class-typed field is a reference with no zero value
// (E0083, SPEC §13.4: "a class-typed field is a reference and would be
// null"), so every mapper supplies an explicit placeholder
// (`relPersonZero`/`relProfileZero`) a `hasOne`/`belongsTo` loader's
// `assign` then overwrites — see this file's own relation.bit header for
// why that overwrite, unlike `posts`, carries no unloaded-read guarantee.
fn relProfileZero(): relProfile {
  return relProfile{ id = 0, personId = 0 }
}

fn relPersonZero(): relPerson {
  return relPerson{ id = 0, profile = relProfileZero() }
}

fn relPersonMapper(rows: Rows): relPerson! {
  let cols = rows.columns()
  return relPerson{ id = sqlReqInt(rows, cols, "id")?, profile = relProfileZero() }
}

fn relPostMapper(rows: Rows): relPost! {
  let cols = rows.columns()
  return relPost{
    id = sqlReqInt(rows, cols, "id")?, authorId = sqlReqInt(rows, cols, "author_id")?,
    author = relPersonZero(),
  }
}

fn relProfileMapper(rows: Rows): relProfile! {
  let cols = rows.columns()
  return relProfile{
    id = sqlReqInt(rows, cols, "id")?, personId = sqlReqInt(rows, cols, "person_id")?,
  }
}

fn postsLoader(): RelationLoader<relPerson> {
  return hasMany<relPerson, relPost>(
    (p) => p.id,
    (db) => find<relPost>(db, "posts", [field("id"), field("authorId")], relPostMapper),
    "authorId",
    (post) => post.authorId,
    (p, posts) => {
      p.posts = posts
    },
  )
}

fn profileLoader(): RelationLoader<relPerson> {
  return hasOne<relPerson, relProfile>(
    (p) => p.id,
    (db) => find<relProfile>(db, "profiles", [field("id"), field("personId")], relProfileMapper),
    "personId",
    (pr) => pr.personId,
    (p, pr) => {
      p.profile = pr
    },
  )
}

fn authorLoader(): RelationLoader<relPost> {
  return belongsTo<relPost, relPerson>(
    (post) => post.authorId,
    (db) => find<relPerson>(db, "people", [field("id")], relPersonMapper),
    "id",
    (p) => p.id,
    (post, p) => {
      post.author = p
    },
  )
}

fn relPeople(db: Data): Query<relPerson> {
  let fields = [field("id")]
  return withRelations(
    find<relPerson>(db, "people", fields, relPersonMapper),
    map<string, RelationLoader<relPerson>>{ "posts": postsLoader(), "profile": profileLoader() },
  )
}

fn personRow(id: i64): []Value {
  return [Value.Int(id)]
}

test "with(\"posts\") on 200 parents issues exactly 2 statements, the second carrying an IN list; a parent with none reads loaded-empty" {
  let personRows = [][]Value(0)
  let i: i64 = 1
  while (i <= 200) {
    personRows = append(personRows, personRow(i))
    i = i + 1
  }
  // Only person 1 has posts (two of them); every other person has none.
  let postRows = [[Value.Int(1), Value.Int(1)], [Value.Int(2), Value.Int(1)]]
  let a = relAdapter{
    calls = []relCall(0),
    results = [
      relResult{ cols = ["id"], rows = personRows },
      relResult{ cols = ["id", "author_id"], rows = postRows },
    ],
  }
  let p = newRelPool(a)

  let people = relPeople(p).with("posts").all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 2, "want 2 statements for 200 parents (never 201), got ${len(a.calls)}")
  assert(
    contains(a.calls[1].sql, "in ("),
    "the second statement must carry an IN list, got: ${a.calls[1].sql}",
  )
  assert(len(people) == 200, "want 200 people, got ${len(people)}")
  assert(len(people[0].posts) == 2, "person 1 must have 2 posts, got ${len(people[0].posts)}")
  assert(
    len(people[1].posts) == 0,
    "person 2 has no posts and must read as a loaded-empty slice, got ${len(people[1].posts)}",
  )
}

test "testpanic_reading_a_relation_never_requested_by_with_panics" {
  let a = relAdapter{
    calls = []relCall(0),
    results = [relResult{ cols = ["id"], rows = [personRow(1)] }],
  }
  let p = newRelPool(a)

  let people = relPeople(p).all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  // `posts` was never requested with `.with("posts")`: this read must panic
  // (#5053/#5271) before `len` ever sees a value.
  let n = len(people[0].posts)
  print("${n}\n")
}

test "2500 parent ids chunk into 3 child statements at 1000 ids per IN list" {
  let a = relAdapter{
    calls = []relCall(0),
    results = [
      relResult{ cols = ["id", "author_id"], rows = [][]Value(0) },
      relResult{ cols = ["id", "author_id"], rows = [][]Value(0) },
      relResult{ cols = ["id", "author_id"], rows = [][]Value(0) },
    ],
  }
  let p = newRelPool(a)

  let parents = []relPerson(0)
  let i: i64 = 1
  while (i <= 2500) {
    parents = append(parents, relPerson{ id = i, profile = relProfileZero() })
    i = i + 1
  }

  postsLoader()(p, parents) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 3, "2500 ids at 1000 per chunk must be 3 statements, got ${len(a.calls)}")
  assert(
    len(a.calls[0].args) == 1000,
    "first chunk must carry 1000 ids, got ${len(a.calls[0].args)}",
  )
  assert(
    len(a.calls[1].args) == 1000,
    "second chunk must carry 1000 ids, got ${len(a.calls[1].args)}",
  )
  assert(
    len(a.calls[2].args) == 500,
    "third chunk must carry the remaining 500 ids, got ${len(a.calls[2].args)}",
  )
}

test "belongsTo loads exactly one parent per distinct foreign key value, not one per child row" {
  let a = relAdapter{
    calls = []relCall(0),
    results = [relResult{ cols = ["id"], rows = [personRow(1), personRow(2)] }],
  }
  let p = newRelPool(a)

  // 5 posts, written by only 2 distinct authors.
  let posts = [
    relPost{ id = 1, authorId = 1, author = relPersonZero() },
    relPost{ id = 2, authorId = 1, author = relPersonZero() },
    relPost{ id = 3, authorId = 2, author = relPersonZero() },
    relPost{ id = 4, authorId = 1, author = relPersonZero() },
    relPost{ id = 5, authorId = 2, author = relPersonZero() },
  ]

  authorLoader()(p, posts) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 1, "must load parents in one statement, got ${len(a.calls)}")
  assert(
    len(a.calls[0].args) == 2,
    "must query exactly the 2 distinct author ids, not one per post, got ${len(a.calls[0].args)}",
  )
  assert(posts[0].author.id == 1, "post 1's author must be person 1, got ${posts[0].author.id}")
  assert(posts[2].author.id == 2, "post 3's author must be person 2, got ${posts[2].author.id}")
}

test "two chained with() calls for different relations produce 3 statements total" {
  let a = relAdapter{
    calls = []relCall(0),
    results = [
      relResult{ cols = ["id"], rows = [personRow(1)] },
      relResult{ cols = ["id", "author_id"], rows = [][]Value(0) },
      relResult{ cols = ["id", "person_id"], rows = [][]Value(0) },
    ],
  }
  let p = newRelPool(a)

  relPeople(p).with("posts").with("profile").all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 3, "1 parent statement + 2 relation statements, got ${len(a.calls)}")
}

test "testpanic_with_an_unregistered_relation_name_panics" {
  let a = relAdapter{ calls = []relCall(0), results = []relResult(0) }
  let p = newRelPool(a)
  relPeople(p).with("nope")
}
