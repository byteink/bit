// pkg/orm/foreignkey.bit — `onDelete` on a `@belongsTo` relation (#5061),
// rendered into the foreign-key constraint `pkg/orm/schema.bit`'s builder
// and `postgres.bit`'s `Dialect` already know how to emit (#5065/#5066).
// Owner decision 2026-09-12.
//
//   @table
//   class Order {
//     @id id: i64
//     @belongsTo("userId", onDelete = Cascade)  user: User
//     userId: i64
//   }
//
//   addForeignKeys(t, Order{ id = 0, user = User{ id = 0 }, userId = 0 }.tableDescriptor(),
//     map<string, RelationTarget>{
//       "user": RelationTarget{
//         isTable = true,
//         desc = TableDesc{ table = "users", fields = User{ id = 0 }.tableDescriptor(), classAttrs = User{ id = 0 }.tableAttrs() },
//       },
//     })?
//
// THE ATTRIBUTE'S RECORDED SHAPE. `compiler/classtabledesc.bit` renders
// `@belongsTo("userId", onDelete = Cascade)` to `AttrDesc{ name = "belongsTo",
// args = ["userId", "onDelete", "Cascade"] }` - a named argument renders as
// TWO consecutive words, the keyword then its value
// (`compiler/classtabledescwords.bit`'s `tableAttrArgWords`, #5064's own
// compiler change: attribute argument lists did not accept `name = expr` at
// all before this ticket, confirmed by parse error on this exact example).
// This file reads that flat list; it never re-derives it.
//
// THE DATABASE ENFORCES onDelete, NOT THIS PACKAGE. `addForeignKeys` builds
// the DDL constraint only - it never walks a relation issuing a child
// DELETE. That would be N statements, not atomic without a transaction the
// caller may not have opened, and it would silently diverge from what the
// schema says once someone edits the constraint by hand. A parent delete
// (`pkg/orm/write.bit`'s ordinary `delete<T>`) stays exactly one statement
// to the driver; Postgres/MySQL enforce the constraint atomically from
// there.
//
// DEFAULT IS Restrict, NOT Cascade. An omitted `onDelete` (no "onDelete"
// keyword in `args` at all) is `ReferentialAction.Restrict` - deleting a
// referenced row with a child still pointing at it then fails loudly
// instead of silently destroying the child. Cascade is written down
// deliberately, because a mistaken cascade on a widely-referenced table
// deletes half the database from one statement.
//
// SetNull NEEDS A NULLABLE COLUMN. `onDelete = SetNull` whose foreign-key
// column field is not `Option<...>` is `ForeignKeyError` naming both the
// field and the option - the database would otherwise be asked to write
// NULL into a NOT NULL column and fail at DELETE time, in production, on a
// statement that looked fine in review.
//
// THE TARGET MUST BE A @table CLASS, AND THIS FILE CANNOT SEE ITS
// ATTRIBUTES ITSELF. Bit has no reflection to read a type parameter's own
// attributes - `pkg/orm/relation.bit`'s own header states the identical
// limitation for eager loading. `RelationTarget` is the same explicit
// per-entity-wrapper shape `relation.bit`'s `hasMany`/`hasOne`/`belongsTo`
// and `softdelete.bit`'s scoped entry points already use: the caller (who
// wrote `@table class User` and knows it) supplies `isTable` and the
// target's own `desc: TableDesc` once per relation - a relation missing
// from `targets`, or carrying `isTable: false`, is rejected rather than
// silently emitting a dangling reference to a table that may never exist.
//
// #5398 OWNER DECISION: THE DESCRIPTOR DERIVES THE KEY SHAPE, NEVER A
// CALLER-SUPPLIED FLAG. #5395 added `RelationTarget.compositeKey: bool` and
// refused every composite target outright - it worked, but it pushed a
// fact the caller could get wrong (a hand-set flag that silently drifts
// from the class it is describing) onto every call site, and a wrong flag
// is back to exactly the silently-incomplete foreign key #5395 exists to
// prevent. `RelationTarget` instead carries the target's own
// `desc: TableDesc` - the SAME descriptor `target.tableDescriptor()`
// (compiler/classtabledesc.bit) already synthesizes for every `@table`
// class, structurally, off its `@id` fields. `addForeignKeys` below derives
// the key SHAPE from it with `pkg/orm/compositekey.bit`'s own `keyFields` -
// the identical call `write.bit`/`softdelete.bit` already make for the SAME
// class - rather than trusting a second, independently-typed fact about
// it. No change to `compiler/classtabledesc.bit` was needed:
// `tableDescriptor()` already records every `@id` field, one or many,
// since #5084 - the derivation this ticket wanted was already sitting
// there, unread.
//
// A COMPOSITE TARGET NOW BUILDS A REAL MULTI-COLUMN FOREIGN KEY, NEVER A
// REFERENCE TO ONLY ITS FIRST COLUMN. `@belongsTo`'s own positional
// arguments are the local foreign-key column list, in order -
// `@belongsTo("userId")` for a single-column target, `@belongsTo("userId",
// "teamId")` for a target whose own key is `@id userId` plus `@id teamId`.
// Nothing in the compiler limits how many positional arguments a recorded
// attribute carries (`compiler/classrelationattr.bit`'s own header: "the
// attribute's own argument [is] #5061's [pkg/orm] to read off
// tableDescriptor()'s recorded AttrDesc, not this file's to interpret") -
// `belongsToColumns` below reads every argument up to the first "onDelete"
// keyword; `namedArg`'s own linear scan already tolerates any number of
// leading positionals, unchanged by this ticket. `addForeignKeys` fails
// naming both counts (`ColumnCountMismatch`) when `@belongsTo` names a
// different number of local columns than the target's own key has, rather
// than handing `schema.bit`'s `ForeignKey`/a dialect two mismatched lists
// to zip short - `postgres.bit`'s/`mysql.bit`'s own `foreignKeyDef` already
// PANIC on that mismatch ("a caller bug, not recoverable data",
// postgres.bit's header). This file is that caller, so it fails cleanly
// before ever reaching that panic.
//
// NO FOREIGN-KEY COLUMN IS EVER LEFT UNINDEXED. Postgres does not index a
// referencing column automatically (only the REFERENCED side, always this
// package's key columns, is). `addForeignKeys` always calls
// `t.index(...columns)` alongside `t.foreign(...columns)...` for the
// identical column list - one composite index over the whole local key,
// never one index per column, and never silently skipped because the
// constraint alone "looks" complete.

import { hasPrefix } from "std/strings"

// Why `addForeignKeys` rejected one `@belongsTo` field.
export enum ForeignKeyCause {
  // `onDelete = SetNull` but the foreign-key column field is not
  // `Option<...>`.
  SetNullRequiresOption,
  // The relation's target is missing from `targets`, or was supplied with
  // `isTable: false` - not a `@table` class.
  TargetNotTable,
  // `@belongsTo` names a different number of local foreign-key columns
  // than `keyFields(target.desc)` (compositekey.bit) has - a foreign key
  // must name exactly as many local columns, in the same order, as the
  // key it references (#5398, replacing #5395's blanket refusal of any
  // composite target).
  ColumnCountMismatch,
  // `onDelete`'s own value is none of `Cascade`/`Restrict`/`SetNull`/
  // `NoAction`.
  UnknownOnDelete,
}

// Satisfies the predeclared `error` interface (SPEC §10.6, §18.3), the same
// shape `pkg/orm/softdelete.bit`'s `SoftDeleteError` is.
export class ForeignKeyError {
  export cause: ForeignKeyCause
  export field: string
  export detail: string

  export message(): string {
    match (this.cause) {
      SetNullRequiresOption => return "pkg/orm: '${this.field}' declares onDelete = SetNull but its foreign-key field ${this.detail} is not Option<...>"
      TargetNotTable => return "pkg/orm: '${this.field}' relates to '${this.detail}', which does not carry '@table'"
      ColumnCountMismatch => return "pkg/orm: '${this.field}' cannot build a foreign key - ${this.detail}"
      UnknownOnDelete => return "pkg/orm: '@belongsTo' onDelete value '${this.detail}' is not Cascade, Restrict, SetNull or NoAction"
    }
  }
}

// What the caller already knows about a `@belongsTo` field's target class -
// see this file's header for why it cannot be read off the descriptor
// itself, and for why `desc` carries the target's own `tableDescriptor()`
// rather than a hand-set column list or flag.
export class RelationTarget {
  export isTable: bool,
  export desc: TableDesc,
}

// Adds one `ForeignKey` (plus its index) to `t` for every `@belongsTo`
// field in `fields`, reading each one's own recorded `onDelete` and
// validating it against `targets`. Fields carrying no `@belongsTo` are
// skipped - `@hasMany`/`@hasOne` own no column on this side (relation.bit's
// header) and never reach this file.
export fn addForeignKeys(
  t: Table, fields: []FieldDesc, targets: map<string, RelationTarget>,
): ()! {
  for f of fields {
    let (bitFieldNames, has) = belongsToColumns(f.attrs)
    if (!has) {
      continue
    }
    let (target, found) = targets[f.name]
    if (!found || !target.isTable) {
      fail ForeignKeyError{
        cause = ForeignKeyCause.TargetNotTable, field = f.name, detail = f.typeName,
      }
    }
    let targetKeyFields = keyFields(target.desc)
    if (len(bitFieldNames) != len(targetKeyFields)) {
      fail ForeignKeyError{
        cause = ForeignKeyCause.ColumnCountMismatch, field = f.name,
        detail = "'@belongsTo' names ${len(bitFieldNames)} local column(s) but '${target.desc.table}' has a ${len(targetKeyFields)}-column key",
      }
    }
    let action = onDeleteFor(f.attrs)?
    let (columns, refColumns) = fkColumns(fields, f.name, bitFieldNames, targetKeyFields, action)?
    t.foreign(...columns).references(target.desc.table, ...refColumns).onDelete(action)
    t.index(...columns)
  }
}

// The local and referenced column lists for one `@belongsTo` field, zipped
// index for index - `bitFieldNames[i]` is the local Bit field naming
// `targetKeyFields[i]`, the caller's own responsibility to have declared in
// the target key's order (`schema.bit`'s `ForeignKey` header). Fails
// `SetNullRequiresOption` the moment a local field fails the check, the
// same per-field validation the single-column case always ran.
fn fkColumns(
  fields: []FieldDesc, relationField: string, bitFieldNames: []string,
  targetKeyFields: []FieldDesc, action: ReferentialAction,
): ([]string, []string)! {
  let columns = []string(0)
  let refColumns = []string(0)
  let i = 0
  while (i < len(bitFieldNames)) {
    let fkField = requireField(fields, bitFieldNames[i], relationField)
    if (action == ReferentialAction.SetNull && !hasPrefix(fkField.typeName, "Option<")) {
      fail ForeignKeyError{
        cause = ForeignKeyCause.SetNullRequiresOption, field = relationField,
        detail = "'${bitFieldNames[i]}: ${fkField.typeName}'",
      }
    }
    columns = append(columns, columnName(fkField))
    refColumns = append(refColumns, columnName(targetKeyFields[i]))
    i = i + 1
  }
  return (columns, refColumns)
}

// The `@belongsTo` field named in `fields` for its own foreign-key column
// is a program-shape bug the same category `pkg/orm/write.bit`'s own
// `primaryKeyField` panics for - the attribute's own argument named a field
// that does not exist on the class, not data a caller can recover from.
fn requireField(fields: []FieldDesc, name: string, relationField: string): FieldDesc {
  for f of fields {
    if (f.name == name) {
      return f
    }
  }
  panic("pkg/orm: '@belongsTo' on '${relationField}' names foreign-key field '${name}', which '${relationField}'s class does not declare")
}

// `@belongsTo`'s own positional arguments, in order - the local foreign-key
// column list, one Bit field name for a single-column target, more than one
// for a composite one (this file's header). Every argument up to the first
// "onDelete" is positional: the compiler records positionals before any
// named argument in source order (`compiler/classtabledescwords.bit`'s
// `tableAttrArgWords`), and `@belongsTo`'s own vocabulary recognises no
// other keyword.
fn belongsToColumns(attrs: []AttrDesc): ([]string, bool) {
  for a of attrs {
    if (a.name == "belongsTo" && len(a.args) > 0) {
      return (leadingPositionalArgs(a.args), true)
    }
  }
  return ([]string(0), false)
}

fn leadingPositionalArgs(args: []string): []string {
  let out = []string(0)
  let i = 0
  while (i < len(args) && args[i] != "onDelete") {
    out = append(out, args[i])
    i = i + 1
  }
  return out
}

// `onDelete`'s own value among a `@belongsTo`'s recorded args, or
// `Restrict` when the keyword is absent - this ticket's own default.
fn onDeleteFor(attrs: []AttrDesc): ReferentialAction! {
  for a of attrs {
    if (a.name != "belongsTo") {
      continue
    }
    let (spelling, found) = namedArg(a.args, "onDelete")
    if (!found) {
      return ReferentialAction.Restrict
    }
    return parseOnDelete(spelling)?
  }
  return ReferentialAction.Restrict
}

// The value following `key` in a recorded attribute's flat `args` - see
// this file's header for why a named argument renders as two consecutive
// words. Starts at 1 so `args[0]`, always positional, is never mistaken
// for a keyword - the scan itself tolerates any number of further leading
// positionals ahead of `key`, unchanged since before #5398.
fn namedArg(args: []string, key: string): (string, bool) {
  let i = 1
  while (i < len(args) - 1) {
    if (args[i] == key) {
      return (args[i + 1], true)
    }
    i = i + 1
  }
  return ("", false)
}

fn parseOnDelete(spelling: string): ReferentialAction! {
  if (spelling == "Cascade") {
    return ReferentialAction.Cascade
  }
  if (spelling == "Restrict") {
    return ReferentialAction.Restrict
  }
  if (spelling == "SetNull") {
    return ReferentialAction.SetNull
  }
  if (spelling == "NoAction") {
    return ReferentialAction.NoAction
  }
  fail ForeignKeyError{
    cause = ForeignKeyCause.UnknownOnDelete, field = "", detail = spelling,
  }
}
