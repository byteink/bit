// A scoped transaction keeps authorization on the live connection. Separate
// repository types keep lock() unavailable on a pool-backed scoped repository.
fn scopedTransaction(self: ScopedDb, f: (ScopedTx) => ()!): ()! {
  return self.db.tx((t) => {
    return f(
      ScopedTx{
        db = t.db, dialect = t.dialect, guard = t.guard,
        actor = self.actor, tenant = self.tenant,
      },
    )?
  })?
}

export class ScopedTx {
  db: Data
  dialect: ServerDialect
  guard: Option<Guard>
  actor: Option<Actor>
  tenant: string

  export table<T: Tabled>(): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{
      inner = ScopedRepo<T>{
        inner = openRepo<T>(this.db, this.dialect, this.guard),
        guard = this.guard, actor = this.actor, tenant = this.tenant,
      },
    }
  }
}

// Match TxRepo's forwarding pattern; guard and query logic stay in ScopedRepo.
export class ScopedTxRepo<T: Tabled> {
  inner: ScopedRepo<T>

  export where(column: string, val: Value): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{ inner = this.inner.where(column, val) }
  }

  export orderBy(column: string, dir: Dir = Dir.Asc): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{ inner = this.inner.orderBy(column, dir) }
  }

  export limit(n: int): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{ inner = this.inner.limit(n) }
  }

  export offset(n: int): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{ inner = this.inner.offset(n) }
  }

  export after(key: Value): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{ inner = this.inner.after(key) }
  }

  export withDeleted(): ScopedTxRepo<T> {
    return ScopedTxRepo<T>{ inner = this.inner.withDeleted() }
  }

  export lock(mode: LockMode = LockMode.Update): ScopedLockedRepo<T> {
    return ScopedLockedRepo<T>{ inner = this.inner, opts = lockOptsFor(mode) }
  }

  export all(): []T! { return this.inner.all()? }
  export first(): Option<T>! { return this.inner.first()? }
  export count(): int! { return this.inner.count()? }
  export find(id: Value): T! { return this.inner.find(id)? }
  export insert(v: T): T! { return this.inner.insert(v)? }
  export insertAll(rows: []T): []T! { return this.inner.insertAll(rows)? }
  export update(v: T): ()! { return this.inner.update(v)? }
  export save(v: T): T! { return this.inner.save(v)? }
  export delete(id: Value): ()! { return this.inner.delete(id)? }
  export restore(id: Value): ()! { return this.inner.restore(id)? }
  export forceDelete(id: Value): ()! { return this.inner.forceDelete(id)? }
  export unlink(v: T, name: string, targetIds: []i64): ()! {
    return this.inner.unlink(v, name, targetIds)?
  }
}

export class ScopedLockedRepo<T: Tabled> {
  inner: ScopedRepo<T>
  opts: LockOpts

  export find(id: Value): T! {
    let repo = this.inner.inner
    repo.checkErr()?
    repo.singleKeyColumn()?
    let clause = LockedRepo<T>{ inner = repo, opts = this.opts, dialect = repo.dialect }.guard()?
    let field = keyFields(repo.desc())[0].name
    let byId = scopedWith<T>(this.inner, repo.where(field, id))
    match (scopedNarrow<T>(byId)?) {
      Some(r) => return scopedLockedRead<T>(byId, r.limit(2), clause)?
      None => fail scopedLockMissing<T>(this.inner)
    }
  }
}

fn scopedLockMissing<T: Tabled>(self: ScopedRepo<T>): error {
  match (self.guard) {
    Some(g) => return g.notFound(T.__tableName())
    None => return newError("orm: no row in '${T.__tableName()}' matches the given id")
  }
}

// Build from the narrowed repository so chain predicates, parameters and the
// soft-delete condition survive the locking read.
fn scopedLockedRead<T: Tabled>(self: ScopedRepo<T>, repo: Repo<T>, clause: string): T! {
  let sqlText = repo.selectSql() + clause
  repo.checkErr()?
  let rows = repo.db.query(sqlText, repo.args)?
  defer rows.close()
  if (!rows.next()?) {
    fail scopedLockMissing<T>(self)
  }
  let row = T.__fromRow(rows)?
  if (rows.next()?) {
    fail newError("orm: more than one row in '${T.__tableName()}' matches the given id")
  }
  return row
}
