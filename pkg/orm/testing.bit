// pkg/orm/testing.bit — transaction-per-test isolation and a factory helper
// (#5074), so an application's own test suite leaves no rows behind.
//
//     orm.withRollback(pool, (db) => {
//       let u = orm.make<User>(seq, userSeed)
//       ...
//     })?
//
// WHY THIS CAN EXIST AT ALL WITHOUT ANY TEST-AWARE CODE IN THE REST OF THE
// PACKAGE. `Data` (#5055, data.bit) is `Pool` or a live transaction handle,
// interchangeably — every ORM function already takes `Data`, never `Pool`,
// so running a test's body inside a transaction instead of standalone needs
// nothing from `save`/`find`/etc. to change; `withRollback` only has to
// open the transaction and refuse to let it commit.
//
// WITHROLLBACK ALWAYS ROLLS BACK, EVEN ON SUCCESS — THAT IS THE WHOLE POINT,
// SO IT IS NOT `pool.tx` WITH EXTRA STEPS. `pool.tx`/`stdlib/sql/tx.bit`'s
// own `txValueAt` commit the moment the block returns normally (that file's
// own header: "COMMIT when the block returns normally"); there is no public
// way to ask it for a rollback-only commit, because that is not what `tx`
// is for. So `withRollback` never lets the block return normally: it always
// ends the block with a `fail`, either the body's own error (propagated
// unchanged) or, when the body succeeded, a marker error private to this
// file that exists for exactly one purpose — forcing the rollback branch —
// and is swallowed before it ever reaches the caller. `stdlib/sql/tx.bit`'s
// `txValueAt` only reaches `scope.finish()` (COMMIT) when the block did NOT
// fail; a `withRollback` body can therefore never commit, on any path,
// which is the ticket's own constraint. A panic is still a panic — `tx`'s
// own panic boundary (`runRecovering`, ./tx.bit) rolls it back and
// re-panics unchanged; nothing here needs its own `defer` for that case,
// the same way ./tx.bit's own header explains `txValueAt` needs none.
//
// THE CLOSURE PARAMETER IS `db`, NEVER ANYTHING ELSE — #5055's `Data`
// header: naming it anything else leaves the outer `pool` reachable inside
// the block, and a write issued through `pool` directly runs outside this
// transaction and is never rolled back.
//
// WHY THE FACTORY IS NOT THE TICKET'S LITERAL `orm.make<User>(email =
// "a@b.c")`, THE SAME GAP `write.bit`'S OWN HEADER DOCUMENTS. A function
// generic over an unconstrained `T` cannot build a `T{ field = value, ... }`
// composite literal — the compiler has to know `T`'s field names to check
// one, and an unconstrained type parameter carries none (confirmed by the
// identical class of failure `write.bit`'s header already found for
// `isPersisted`/`markPersisted`/`tableDescriptor`: E0057, "no field or
// method on this type"). So `make`/`create` do not fill columns themselves;
// `build`, a small closure the caller writes once per entity, does — the
// same "caller supplies the one place `T`'s shape is spelled out" shape
// `write.md`'s own `personDesc`/`personValues` already establish for
// `save`. `build`'s own `n` parameter IS the deterministic value (never
// random — a random factory produces a suite that fails once a month and
// cannot be re-run to reproduce it); a caller overriding one field writes
// it directly in the composite literal, which is already the shortest
// spelling Bit has and needs no separate "overrides" mechanism from this
// file to do it.
//
// `Pool` (the `withRollback` parameter below) is imported by ./lock.bit,
// this file's sibling in the same module (SPEC §17.1) — a second import
// here would be E0042, the same reason `write.bit`'s own header gives for
// not re-importing `Value`.

// The counter `make`/`create` draw from: 1, 2, 3, ... — never random, and
// never ambient. An ambient, package-level counter was rejected the same
// way #5055's own header rejects an ambient "current transaction": it would
// make one test's factory output depend on what ran before it in the same
// process, instead of depending only on how many times THIS test called
// `make`. A fresh `Seq{}` per test is what makes "the same test re-run
// produces the identical pair" true — there is no state anywhere for a
// re-run to inherit.
export class Seq {
  n: i64 = 0

  // The next value in this sequence.
  next(): i64 {
    this.n = this.n + 1
    return this.n
  }
}

// Builds one `T` from `seq`'s next deterministic value: `build` fills every
// column the test cares about (deterministically, from `n`) and returns the
// value — see this file's header for why `make` cannot do that filling
// itself for an arbitrary `T`. Never touches a database.
export fn make<T>(seq: Seq, build: (i64) => T): T {
  return build(seq.next())
}

// `make`, then persists the result via `persist` — the caller's own
// `save`-shaped function (`write.md`'s `savePerson` is exactly this shape).
// `make` alone never inserts; this is the only one of the two that does.
export fn create<T>(seq: Seq, build: (i64) => T, persist: (T) => T!): T! {
  return persist(make<T>(seq, build))?
}

// The one error `withRollback` ever fails its transaction with on a
// SUCCESSFUL body, purely to keep `pool.tx` on its rollback path (see this
// file's header) — never returned to a caller: `withRollback` recognises
// its own marker by type and swallows it before returning.
class rollbackMarker {
  message(): string {
    return "pkg/orm: testing: withRollback's own rollback signal (not a real failure)"
  }
}

// Runs `body` inside a transaction that ALWAYS rolls back, whether `body`
// succeeds or fails — see this file's header for why that makes it more
// than `pool.tx` and why no path through it can ever commit. A failing
// `body` still rolls back and its exact error still reaches the caller,
// unwrapped, so a test asserting on a specific error type
// (`e.(SomeError)`) works the same inside `withRollback` as outside it.
export fn withRollback(pool: Pool, body: (Data) => ()!): ()! {
  pool.tx((db) => {
    body(db)?
    fail rollbackMarker{}
  }) catch e {
    let (_, isMarker) = e.(rollbackMarker)
    if (isMarker) {
      return
    }
    fail e
  }
}
