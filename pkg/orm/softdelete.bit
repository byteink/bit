// pkg/orm/softdelete.bit — @softDelete (#5063, owner decision 2026-09-12,
// "the most dangerous ticket in the wave"): `Repo<T>.delete()` marks a row
// instead of removing it, and every read path excludes a marked row unless
// the caller says otherwise on purpose.
//
//     @table @softDelete class User {
//       @id id: i64
//       email: string
//       deletedAt: Option<i64>
//     }
//
//     let users = db.table<User>()
//     users.delete(id)?                 // UPDATE ... SET deleted_at = now()
//     users.all()?                      // WHERE deleted_at IS NULL, added silently
//     users.withDeleted().all()?        // no filter
//     users.restore(id)?                // SET deleted_at = NULL
//     users.forceDelete(id)?            // a real DELETE
//
// THIS FILE OWNS ONLY THE MARK ITSELF. `softDeleteColumn` below reads the
// class's own synthesized `tableAttrs()` and answers "" for a class with no
// `@softDelete` mark, or the column name for one that has it — the one fact
// `Repo<T>`'s own "soft delete and bulk writes" block (pkg/orm/repobulk.bit,
// #6274) needs to add the `deleted_at is null` predicate to `where`/`find`,
// route `delete()` into an UPDATE instead of a DELETE, and gate
// `restore()`/`forceDelete()`. The old explicit wrapper API this file used
// to also declare (#6296) — separate scoped entry points and chain-wrapper
// classes a caller had to reach for by hand — is gone: every `Repo<T>`
// read/write is soft-delete-aware automatically, driven by the SAME
// `@softDelete` mark this file has always read.

// The soft-delete column for a class's own `classAttrs`
// (`tableAttrs()`)/`fields` (`tableDescriptor()`), or `""` when the class
// carries no `@softDelete` at all — every entry point below treats `""` as
// "not a soft-delete table, behave exactly as `pkg/orm/query.bit`/
// `write.bit`/`patch.bit` already do." `@softDelete` present without a
// declared `deletedAt` field fails naming it — the ticket's own words,
// "the mark without it is an error naming the field" — never a silent
// no-op and never a panic: a class shaped wrong is a program the caller
// can still catch and report, not a corrupted invariant.
fn softDeleteColumn(classAttrs: []AttrDesc, fields: []FieldDesc, table: string): string! {
  if (!hasSoftDeleteAttr(classAttrs)) {
    return ""
  }
  for f of fields {
    if (f.name == "deletedAt") {
      return columnName(f)
    }
  }
  fail SoftDeleteError{ cause = SoftDeleteCause.MissingDeletedAtField, table = table }
}

fn hasSoftDeleteAttr(classAttrs: []AttrDesc): bool {
  for a of classAttrs {
    if (a.name == "softDelete") {
      return true
    }
  }
  return false
}

// Why `@softDelete` was declared without the field it requires.
export enum SoftDeleteCause { MissingDeletedAtField }

// Satisfies the predeclared `error` interface (SPEC §10.6, §18.3), the same
// shape `pkg/orm/write.bit`'s `WriteError` and `pkg/orm/patch.bit`'s
// `PatchError` are.
export class SoftDeleteError {
  export cause: SoftDeleteCause
  export table: string

  export message(): string {
    return "pkg/orm: '@softDelete' on the class mapped to '${this.table}' requires a declared 'deletedAt' field"
  }
}

