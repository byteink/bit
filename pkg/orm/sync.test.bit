// pkg/orm/sync.test.bit — #6307's acceptance for `sync.bit`'s (private)
// `syncTables`, against a FAKE driver (`syExecutor` below) that records
// every statement issued, in order — the same `information_schema` shape
// `check.test.bit`'s own `ckExecutor` already uses — plus one live-server
// test proving `open(url, Options{ synchronize = true })` end to end
// against a real Postgres (#5431/#5435/#5076: a test that skips when no
// server is configured has never run).
//
// `syncTables` is not exported (`sync.bit`'s header: `open` is the only
// public surface), so every unit test below builds its own `TableSchema`
// the same way the compiler-synthesized `__tables()` registry would: one
// call each to the class's own `__tableName()`/`__columns()`/
// `__tableAttrs()` statics (#6301).
import { output } from "std/process"

class syExecutor {
  tables: []string
  columnsByTable: map<string, []string>
  checkClauses: map<string, string>
  execLog: []string

  query(sqlText: string, params: []Value): Rows! {
    let key = ""
    if (len(params) > 0) {
      key = asText(params[0]) catch _ {
        ""
      }
    }
    if (contains(sqlText, "check_constraints")) {
      return syCheckRows{ clause = this.checkClauses[key], i = -1 }
    }
    if (contains(sqlText, "information_schema.columns")) {
      return syColRows{ cols = this.columnsByTable[key], i = -1 }
    }
    if (contains(sqlText, "information_schema.tables")) {
      return syExistsRows{ found = hasColumn(this.tables, key), i = -1 }
    }
    fail newError("syExecutor: query not supported: ${sqlText}")
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    this.execLog = append(this.execLog, sqlText)
    return ExecResult{ rowsAffected = 0 }
  }
}

class syCheckRows {
  clause: string
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i == 0 && this.clause != ""
  }

  columns(): []string {
    return ["check_clause"]
  }

  value(col: int): Value {
    return Value.Text(this.clause)
  }

  close() {}
}

class syColRows {
  cols: []string
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.cols)
  }

  columns(): []string {
    return ["column_name"]
  }

  value(col: int): Value {
    return Value.Text(this.cols[this.i])
  }

  close() {}
}

class syExistsRows {
  found: bool
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i == 0 && this.found
  }

  columns(): []string {
    return ["table_name"]
  }

  value(col: int): Value {
    return Value.Text("x")
  }

  close() {}
}

@table("sy_widgets") class syWidget {
  @id
  id: i64
  name: string
}

@table("sy_widgets") class syWidgetAdd {
  @id
  id: i64
  name: string
  phone: string
}

@table("sy_new_table") class syNewTable {
  @id
  id: i64
  name: string
}

@table("sy_status") class syStatus {
  @id
  id: i64
  @enumVariants("Draft", "Active", "Archived", "Retired")
  status: string
}

// #6323: a reciprocal `@manyToMany` pair, the same shape
// `pkg/orm/manytomany.bit`'s own header example uses — both sides name the
// SAME join table, so `syncTables` must create it exactly once.
@table("sy_posts") class syPost {
  @id
  id: i64
  @manyToMany("sy_post_tags")
  tags: []syTag
}

@table("sy_tags") class syTag {
  @id
  id: i64
  @manyToMany("sy_post_tags")
  posts: []syPost
}

fn syDialect(): RunnerDialect {
  return RunnerDialect{ render = Postgres{}, server = ServerDialect.Postgres }
}

fn tsOf(name: string, columns: []FieldDesc, attrs: []AttrDesc, joins: []JoinDesc): TableSchema {
  return TableSchema{ name = name, columns = columns, attrs = attrs, joins = joins }
}

test "a schema that already agrees is a no-op — sync issues no statement at all" {
  let db = syExecutor{
    tables = ["sy_widgets"],
    columnsByTable = map<string, []string>{ "sy_widgets": ["id", "name"] },
  }
  let ts = tsOf(
    syWidget.__tableName(),
    syWidget.__columns(),
    syWidget.__tableAttrs(),
    syWidget.__manyToManyJoins(),
  )
  syncTables(db, [ts], syDialect()) catch e {
    panic("sync: an agreeing schema must not fail: ${e.message()}")
  }
  assert(len(db.execLog) == 0, "an agreeing schema issued a statement: ${join(db.execLog, ", ")}")
}

test "an added column in the entity is applied directly, not just reported" {
  let db = syExecutor{
    tables = ["sy_widgets"],
    columnsByTable = map<string, []string>{ "sy_widgets": ["id", "name"] },
  }
  let ts = tsOf(
    syWidgetAdd.__tableName(),
    syWidgetAdd.__columns(),
    syWidgetAdd.__tableAttrs(),
    syWidgetAdd.__manyToManyJoins(),
  )
  syncTables(db, [ts], syDialect()) catch e {
    panic("sync: ${e.message()}")
  }
  let applied = false
  for stmt of db.execLog {
    if (contains(stmt, "add column") && contains(stmt, "\"phone\"")) {
      applied = true
    }
  }
  assert(applied, "sync did not apply the added column: ${join(db.execLog, ", ")}")
  assert(
    contains(join(db.execLog, "\n"), "BEGIN"),
    "sync did not wrap the change in a transaction: ${join(db.execLog, ", ")}",
  )
}

// Owner ruling 2026-09-30: add only, never drop or rename. A column live
// but absent from the entity must be LEFT ALONE now — #5069's own
// `syncSchema` dropped it; this is the
// behaviour change #6307 makes.
test "a column present live but absent from the entity is kept, never dropped" {
  let db = syExecutor{
    tables = ["sy_widgets"],
    columnsByTable = map<string, []string>{ "sy_widgets": ["id", "name", "legacy_flag"] },
  }
  let ts = tsOf(
    syWidget.__tableName(),
    syWidget.__columns(),
    syWidget.__tableAttrs(),
    syWidget.__manyToManyJoins(),
  )
  syncTables(db, [ts], syDialect()) catch e {
    panic("sync: ${e.message()}")
  }
  for stmt of db.execLog {
    assert(
      !contains(stmt, "drop column"),
      "sync dropped a column; add only, never drop: ${stmt}",
    )
  }
}

test "an entity whose table does not exist yet is created outright" {
  let db = syExecutor{ tables = []string(0), columnsByTable = map<string, []string>(0) }
  let ts = tsOf(
    syNewTable.__tableName(),
    syNewTable.__columns(),
    syNewTable.__tableAttrs(),
    syNewTable.__manyToManyJoins(),
  )
  syncTables(db, [ts], syDialect()) catch e {
    panic("sync: ${e.message()}")
  }
  let created = false
  for stmt of db.execLog {
    if (contains(stmt, "create table \"sy_new_table\"")) {
      created = true
    }
  }
  assert(created, "sync did not create the missing table: ${join(db.execLog, ", ")}")
}

// #6323: `syPost`/`syTag` (this file's header) both name the same join
// table on their own `@manyToMany` field — `TableSchema.joins` carries one
// `JoinDesc` per side, so `syncTables` must create `sy_post_tags` exactly
// once, from either side, never twice.
test "a @manyToMany join table missing live is created exactly once" {
  let db = syExecutor{
    tables = ["sy_posts", "sy_tags"],
    columnsByTable = map<string, []string>{ "sy_posts": ["id"], "sy_tags": ["id"] },
  }
  let postTs = tsOf(
    syPost.__tableName(), syPost.__columns(), syPost.__tableAttrs(), syPost.__manyToManyJoins(),
  )
  let tagTs = tsOf(
    syTag.__tableName(), syTag.__columns(), syTag.__tableAttrs(), syTag.__manyToManyJoins(),
  )
  syncTables(db, [postTs, tagTs], syDialect()) catch e {
    panic("sync: ${e.message()}")
  }
  let createdCount = 0
  for stmt of db.execLog {
    if (contains(stmt, "create table \"sy_post_tags\"")) {
      createdCount = createdCount + 1
    }
  }
  assert(
    createdCount == 1,
    "sync must create the join table exactly once, got ${createdCount}: ${join(db.execLog, ", ")}",
  )
  let joined = join(db.execLog, "\n")
  assert(contains(joined, "\"sy_post_id\""), "join table is missing the owner column: ${joined}")
  assert(contains(joined, "\"sy_tag_id\""), "join table is missing the target column: ${joined}")
}

// #5435's own path: an enum variant added in Bit is invisible to
// presence/absence alone, so this is the finding `enumCheckDiffs`
// (`generateenum.bit`) makes and `sync` must APPLY, not just report.
test "an enum variant change is applied through #5435's own rendering path" {
  let db = syExecutor{
    tables = ["sy_status"],
    columnsByTable = map<string, []string>{ "sy_status": ["id", "status"] },
    checkClauses = map<string, string>{
      "sy_status_status_check": "(status = ANY (ARRAY['Draft'::text, 'Active'::text, 'Archived'::text]))",
    },
  }
  let ts = tsOf(
    syStatus.__tableName(),
    syStatus.__columns(),
    syStatus.__tableAttrs(),
    syStatus.__manyToManyJoins(),
  )
  syncTables(db, [ts], syDialect()) catch e {
    panic("sync: ${e.message()}")
  }
  let joined = join(db.execLog, "\n")
  assert(
    contains(joined, "drop constraint \"sy_status_status_check\""),
    "sync did not apply the enum-CHECK drop-and-recreate: ${join(db.execLog, ", ")}",
  )
  assert(
    contains(joined, "'Retired'"),
    "sync's applied CHECK is missing the new variant: ${join(db.execLog, ", ")}",
  )
}

// The source-level half of "add only, never drop, and warns instead"
// (this file's header): `sync.bit` must call `eprint` and must never call
// `AlterTable.dropColumn`, and the deleted public `syncSchema` must stay
// deleted.
test "source check: sync.bit warns on a removed column, never drops one, and syncSchema stays deleted" {
  let loc = locateBit()
  if (len(loc.repo) == 0) {
    print("sync.bit source check: repo not locatable (set BIT_REPO) — skipping\n")
    return
  }
  let src = readFile("${loc.repo}/pkg/orm/sync.bit") catch e {
    panic("read sync.bit: ${e.message()}")
  }
  assert(len(src) > 500, "sync.bit read back ${len(src)} byte(s) — the read failed")
  assert(count(src, "eprint(") > 0, "sync.bit must warn a removed column through eprint")
  assert(
    count(src, ".dropColumn(") == 0,
    "sync.bit must never call dropColumn — add only, never drop",
  )
  assert(count(src, "export fn syncSchema") == 0, "the public syncSchema must be deleted")
  assert(count(src, "fn syncTables") > 0, "sync.bit must still declare syncTables")
}

// #6307's own acceptance, end to end against a real Postgres: `open` with
// `Options{ synchronize = true }` on an empty database creates the
// project's table; reopening after a column is missing live adds it;
// reopening with a live column the entity does not declare keeps that
// column and warns on stderr, never drops it. `ORM_TEST_LIVE_PG_URI`
// supplies a Postgres connection string; this test skips only when it is
// unset, and says so.
// ONE scratch program, not one per phase: `open`'s own `__tables()`
// registry is fixed per compiled binary (#6301), so the program mutates the
// LIVE side between three `open`s (drop a column, add an unknown one),
// which drives `sync.bit`'s live-versus-entity diff exactly as an edited
// entity would. A program per phase meant three cold compiles of orm,
// postgres and mysql (~6 s CPU each, #6754) against `bit test`'s 30 s
// per-test bound, and the third one timed out on a loaded box.
const liveSyncSource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value, Executor, asText } from \"std/sql\"\nimport { adapter } from \"postgres\"\nimport { open, Options } from \"orm\"\n\n@table(\"sy6307_widgets\") class Widget {\n  @id\n  id: i64\n  name: string\n  phone: string\n}\n\nfn columnNames(db: Executor, table: string): []string! {\n  let rows = db.query(\"select column_name from information_schema.columns where table_name = $1 order by ordinal_position\", [Value.Text(table)])?\n  defer rows.close()\n  let out = []string(0)\n  while (rows.next()?) {\n    out = append(out, asText(rows.value(0))?)\n  }\n  return out\n}\n\nfn hasName(names: []string, name: string): bool {\n  for n of names {\n    if (n == name) {\n      return true\n    }\n  }\n  return false\n}\n\nfn namesJoined(names: []string): string {\n  let out = \"\"\n  for n of names {\n    out = \"\${out}\${n}, \"\n  }\n  return out\n}\n\nfn reopen(uri: string) {\n  open(uri, Options{ synchronize = true }) catch e { panic(\"open: \${e.message()}\") }\n}\n\nfn expect(raw: Executor, col: string, want: bool, step: string): ()! {\n  let cols = columnNames(raw, \"sy6307_widgets\")?\n  if (hasName(cols, col) != want) {\n    panic(\"\${step} FAILED: column \${col} is not as expected, live columns: \${namesJoined(cols)}\")\n  }\n}\n\nfn alter(raw: Executor, ddl: string) {\n  raw.exec(ddl, []Value(0)) catch e { panic(\"\${ddl}: \${e.message()}\") }\n}\n\nfn main(): ()! {\n  let uri = args()[1]\n  let raw = pool(adapter(), Datasource{ uri = uri }) catch e { panic(\"pool: \${e.message()}\") }\n  alter(raw, \"drop table if exists sy6307_widgets\")\n\n  reopen(uri)\n  expect(raw, \"id\", true, \"PHASE1\")?\n  expect(raw, \"name\", true, \"PHASE1\")?\n  expect(raw, \"phone\", true, \"PHASE1\")?\n  print(\"PHASE1_OK\\n\")\n\n  alter(raw, \"alter table sy6307_widgets drop column phone\")\n  expect(raw, \"phone\", false, \"PHASE2 setup\")?\n  reopen(uri)\n  expect(raw, \"phone\", true, \"PHASE2\")?\n  print(\"PHASE2_OK\\n\")\n\n  alter(raw, \"alter table sy6307_widgets add column legacy text\")\n  reopen(uri)\n  expect(raw, \"legacy\", true, \"PHASE3: sync dropped a live column it must never drop,\")?\n  alter(raw, \"drop table sy6307_widgets\")\n  print(\"PHASE3_OK\\n\")\n}\n"

test "live: open(url, Options{ synchronize = true }) creates tables, adds a column on reopen, and keeps+warns on a removed field" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("syncliveproof")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"liveproof6307\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")

  writeFile("${proj}/main.bit", liveSyncSource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }
  let r = output(bin, ["run", "${proj}/main.bit", uri])
  assert(
      r.exitCode == 0 &&
      contains(r.stdout, "PHASE1_OK") &&
      contains(r.stdout, "PHASE2_OK") &&
      contains(r.stdout, "PHASE3_OK"),
    "live sync failed, rc=${r.exitCode}, stdout=${r.stdout}, stderr=${r.stderr}",
  )
  assert(
    contains(r.stderr, "sy6307_widgets") && contains(r.stderr, "legacy"),
    "sync did not warn on stderr about the live column the entity lacks: ${r.stderr}",
  )

  resetDir(proj)
}

// #6323's own acceptance, end to end against a real Postgres: `open(url,
// Options{ synchronize = true })` on a database with NEITHER side table NOR
// the join table creates all three — including the join table `sync.bit`'s
// `syncJoinTables` builds through the registry's `JoinDesc` — and
// `link()`/`with("tags").all()` (#6275/#6277) work immediately off the
// synchronized schema, never a hand-written `CREATE TABLE`.
// `ORM_TEST_LIVE_PG_URI` supplies a Postgres connection string; this test
// skips only when it is unset, and says so.
const liveSyncManyToManySource: string = "import { args } from \"std/os\"\nimport { pool, Datasource, Value } from \"std/sql\"\nimport { adapter } from \"postgres\"\nimport { open, Options } from \"orm\"\n\n@table(\"sy6323_posts\") class SyncPost {\n  @id\n  id: i64\n  title: string\n  @manyToMany(\"sy6323_post_tags\") tags: []SyncTag\n}\n\n@table(\"sy6323_tags\") class SyncTag {\n  @id\n  id: i64\n  name: string\n}\n\nfn main(): ()! {\n  let uri = args()[1]\n  let setup = pool(adapter(), Datasource{ uri = uri }) catch e { panic(\"pool: \${e.message()}\") }\n  setup.exec(\"drop table if exists sy6323_post_tags\", []Value(0)) catch e { panic(\"drop join: \${e.message()}\") }\n  setup.exec(\"drop table if exists sy6323_posts\", []Value(0)) catch e { panic(\"drop posts: \${e.message()}\") }\n  setup.exec(\"drop table if exists sy6323_tags\", []Value(0)) catch e { panic(\"drop tags: \${e.message()}\") }\n\n  let db = open(uri, Options{ synchronize = true }) catch e { panic(\"open: \${e.message()}\") }\n  let posts = db.table<SyncPost>()\n  let tags = db.table<SyncTag>()\n\n  let p = posts.insert(SyncPost{ id = 0, title = \"hello\", tags = []SyncTag(0) }) catch e { panic(\"insert post: \${e.message()}\") }\n  let t = tags.insert(SyncTag{ id = 0, name = \"bit\" }) catch e { panic(\"insert tag: \${e.message()}\") }\n\n  posts.link(p, \"tags\", [t.id]) catch e { panic(\"link: \${e.message()}\") }\n  let loaded = posts.with(\"tags\").where(\"id\", p.id).all() catch e { panic(\"with: \${e.message()}\") }\n  if (len(loaded) != 1) { panic(\"SYNC_MTM_FAILED: expected 1 parent row, got \${len(loaded)}\") }\n  if (len(loaded[0].tags) != 1) { panic(\"SYNC_MTM_FAILED: with(\\\"tags\\\") did not load the linked tag\") }\n  if (loaded[0].tags[0].name != \"bit\") { panic(\"SYNC_MTM_FAILED: wrong tag loaded: \${loaded[0].tags[0].name}\") }\n\n  setup.exec(\"drop table sy6323_post_tags\", []Value(0)) catch e { panic(\"cleanup join: \${e.message()}\") }\n  setup.exec(\"drop table sy6323_posts\", []Value(0)) catch e { panic(\"cleanup posts: \${e.message()}\") }\n  setup.exec(\"drop table sy6323_tags\", []Value(0)) catch e { panic(\"cleanup tags: \${e.message()}\") }\n  setup.close()\n\n  print(\"SYNC_MTM_OK\\n\")\n}\n"

test "live: open(url, Options{ synchronize = true }) on an empty database creates a @manyToMany join table too, and link()/with() work off it (#6323)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let postgresAbs = "${repoRoot}/pkg/postgres"
  let mysqlAbs = "${repoRoot}/pkg/mysql"
  let proj = scratchDir("syncmtmliveproof")
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"syncmtmliveproof\", \"dependencies\": {\"orm\": \"${ormAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", liveSyncManyToManySource) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let r = output(bin, ["run", "${proj}/main.bit", uri])
  assert(
    r.exitCode == 0 && contains(r.stdout, "SYNC_MTM_OK"),
    "live @manyToMany synchronize proof failed, rc=${r.exitCode}; run manually to see its output: ${bin} run ${proj}/main.bit '${uri}', stdout=${r.stdout}, stderr=${r.stderr}",
  )
  resetDir(proj)
}
