// pkg/orm/log.test.bit — #5075's acceptance, restated for std/log (#7430),
// against fakes that need no `Pool`/`Conn` machinery: `QueryLog.wrap` takes a
// `Data` (Executor) directly, so a fake only has to implement `query`/`exec`.
//
// `Value`/`Rows`/`join`/`contains` are already imported module-wide
// (data.test.bit/query.bit/query.test.bit, this module's own siblings) and
// `locateBit`/`BitLocation` are already declared by raw.test.bit — reused,
// not reimported or redeclared (E0042). `relAdapter`/`newRelPool`/
// `relPeople`/`relCall`/`relResult`/`personRow` are relation.test.bit's own
// #5061 fixtures, reused unchanged for the statement-counter test below so
// it proves the SAME two-statements-for-any-parent-count guarantee that
// file already pins, just observed through `QueryLog` instead of `a.calls`.

import { sleep } from "std/time"
// `LevelError` and `Logger` are bound by log.bit (an import binds per MODULE).
// `TextHandler` and `LevelDebug` are bound here for every test file of the
// module, `relationauto.test.bit` and `scoped.test.bit` included.
import { TextHandler, LevelDebug } from "std/log"

// The one value every redaction assertion below must never see —
// unmistakable, so a leak cannot be confused with anything this file
// legitimately writes to the sink.
const secretValue: string = "secret@example.test"

// A std/log `Sink`: std/log hands it one finished record per `write`, with
// its trailing newline, which is dropped here so a test compares the line.
class recSink {
  lines: []string
  export write(s: string): ()! {
    this.lines = append(this.lines, trimRight(s, "\n"))
  }
}

fn newLogSink(): recSink {
  return recSink{ lines = []string(0) }
}

// A text handler at DEBUG without timestamps, so a record reads back
// byte for byte: `level=INFO msg=statement sql=... rows=1 took=...`.
fn recLogger(sink: recSink): Logger {
  return Logger(TextHandler(sink, LevelDebug, false))
}

fn sinkText(s: recSink): string {
  return join(s.lines, "\n")
}

class logCall { sql: string, args: []Value }

// A `Data` whose `exec` records every call and, when `failMessage` is
// non-empty, rejects every one with it as the driver's own message —
// enough for the redaction and failure-logging tests, neither of which
// needs a row back.
class logExecFake {
  calls: []logCall
  failMessage: string

  query(sqlText: string, params: []Value): Rows! {
    fail newError("fake: query not supported")
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    this.calls = append(this.calls, logCall{ sql = sqlText, args = params })
    if (len(this.failMessage) > 0) {
      fail newError(this.failMessage)
    }
    return ExecResult{ rowsAffected = 1 }
  }
}

class logRows {
  cols: []string
  data: [][]Value
  i: int

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

// A `Data` whose `query` sleeps `delayNs` (a REAL monotonic delay — this is
// what lets the slow-query tests exercise `QueryLog`'s own `monotonic`/
// `since` timing rather than a mocked clock) before handing back `data`.
class logQueryFake {
  delayNs: int
  cols: []string
  data: [][]Value

  query(sqlText: string, params: []Value): Rows! {
    sleep(this.delayNs)
    return logRows{ cols = this.cols, data = this.data, i = -1 }
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    fail newError("fake: exec not supported")
  }
}

// Reads every row `rows` has, so `close()` sees the full row count — the
// row-count half of the slow-query acceptance.
fn drain(rows: Rows): ()! {
  while (rows.next()?) {}
}

const insertEmail: string = "insert into users (email) values ($1)"

// Runs `sql` through `db.exec` and hands back whether it failed — the caller
// asserts on the sink, so a test never reads past a swallowed error.
fn execFailure(db: Data, sqlText: string): string {
  db.exec(sqlText, [Value.Text(secretValue)]) catch e {
    return e.message()
  }
  return ""
}

fn slowRead(q: QueryLog, delayMs: int, data: [][]Value): ()! {
  let db = q.wrap(logQueryFake{ delayNs = delayMs * Millisecond, cols = ["id"], data = data })
  let rows = db.query("select id from users", []Value(0))?
  drain(rows)?
  rows.close()
}

test "a statement record carries the statement text, the row count and the duration, and no bound value" {
  let sink = newLogSink()
  let q = QueryLog(recLogger(sink))
  let db = q.wrap(logExecFake{ calls = []logCall(0), failMessage = "" })
  db.exec(insertEmail, [Value.Text(secretValue)]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(
    len(sink.lines) == 1,
    "one record per statement, got ${len(sink.lines)}: ${sinkText(sink)}",
  )
  let want = "level=INFO msg=statement sql=\"insert into users (email) values ($1)\" rows=1 took="
  assert(hasPrefix(sink.lines[0], want), "got: ${sink.lines[0]}")
  assert(
    !contains(sinkText(sink), secretValue),
    "a bound value leaked into the log: ${sinkText(sink)}",
  )
  assert(q.statementCount == 1, "the statement counter must count it, got ${q.statementCount}")
}

test "a level the logger has off writes nothing, and the statement is still counted" {
  let sink = newLogSink()
  let q = QueryLog(Logger(TextHandler(sink, LevelError, false)))
  let db = q.wrap(logExecFake{ calls = []logCall(0), failMessage = "" })
  db.exec(insertEmail, [Value.Text(secretValue)]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(len(sink.lines) == 0, "INFO is below ERROR and must write nothing: ${sinkText(sink)}")
  assert(q.statementCount == 1, "got ${q.statementCount}")
}

test "a slow query logs a WARN record naming the duration and the returned row count; a fast one logs none" {
  let sink = newLogSink()
  slowRead(QueryLog(recLogger(sink)), 250, [[Value.Int(1)], [Value.Int(2)]]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let text = sinkText(sink)
  assert(contains(text, "level=WARN msg=\"slow statement\""), "a 250ms query must warn: ${text}")
  assert(contains(text, "rows=2"), "the warning must name the returned row count: ${text}")
  assert(contains(text, "took="), "the warning must name the duration: ${text}")

  let fastSink = newLogSink()
  slowRead(QueryLog(recLogger(fastSink)), 10, [[Value.Int(1)]]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    !contains(sinkText(fastSink), "level=WARN"),
    "a 10ms query under the 200ms default must not warn: ${sinkText(fastSink)}",
  )
}

test "the slow-query threshold is configurable: 250ms under a 500ms threshold logs no warning" {
  let sink = newLogSink()
  slowRead(QueryLog(recLogger(sink), 500), 250, [[Value.Int(1)]]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    !contains(sinkText(sink), "level=WARN"),
    "250ms under 500ms must not warn: ${sinkText(sink)}",
  )
}

test "a zero slow-query threshold disables the warning rather than firing on every query" {
  let sink = newLogSink()
  slowRead(QueryLog(recLogger(sink), 0), 250, [[Value.Int(1)]]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    !contains(sinkText(sink), "level=WARN"),
    "a zero threshold must disable the warning, not fire on every query: ${sinkText(sink)}",
  )
}

test "a negative slow-query threshold also disables the warning" {
  let sink = newLogSink()
  slowRead(QueryLog(recLogger(sink), -5), 250, [[Value.Int(1)]]) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    !contains(sinkText(sink), "level=WARN"),
    "a negative threshold must disable it: ${sinkText(sink)}",
  )
}

test "a failed statement writes one ERROR record, text and message as separate attributes, and the failure still reaches the caller" {
  let sink = newLogSink()
  let db = QueryLog(recLogger(sink)).wrap(
    logExecFake{ calls = []logCall(0), failMessage = "constraint violation: duplicate key" },
  )
  let msg = execFailure(db, insertEmail)
  assert(
    contains(msg, "constraint violation"),
    "the driver's own failure must still reach the caller: ${msg}",
  )
  assert(len(sink.lines) == 1, "one record, got ${len(sink.lines)}: ${sinkText(sink)}")
  let want = "level=ERROR msg=\"statement failed\" sql=\"insert into users (email) values ($1)\" " +
    "error=\"constraint violation: duplicate key\""
  assert(sink.lines[0] == want, "got: ${sink.lines[0]}")
  assert(
    !contains(sink.lines[0], secretValue),
    "a bound value leaked through a failure log: ${sink.lines[0]}",
  )
}

// #5381's own test: a canned driver message that never contained
// `secretValue` could not have caught the defect — a driver message THAT
// EMBEDS a bound value, the way a real Postgres unique-violation DETAIL line
// does, must not reach the sink.
fn driverDetailMessage(): string {
  return "duplicate key value violates unique constraint \"users_email_key\"\n" +
    "DETAIL:  Key (email)=(${secretValue}) already exists."
}

test "a driver message embedding a bound value is redacted, same as a bound value in args" {
  let sink = newLogSink()
  let db = QueryLog(recLogger(sink)).wrap(
    logExecFake{ calls = []logCall(0), failMessage = driverDetailMessage() },
  )
  let msg = execFailure(db, insertEmail)
  assert(
    contains(msg, secretValue),
    "the driver's own failure reaching the caller is untouched by log redaction: ${msg}",
  )
  assert(len(sink.lines) == 1, "one record, got ${len(sink.lines)}")
  assert(
    !contains(sink.lines[0], secretValue),
    "a bound value leaked through the driver's message: ${sink.lines[0]}",
  )
  assert(
    contains(sink.lines[0], "users_email_key"),
    "the record must still name the constraint: ${sink.lines[0]}",
  )
}

// #5381 follow-up: an earlier version of `redactErrorMessage`'s own doc
// comment claimed Postgres never puts a value in its PRIMARY line — false.
// A failed cast puts the raw offending value right there, double-quoted,
// with no DETAIL section at all: `invalid input syntax for type integer:
// "<value>"`. This is one of the most common driver failures there is (a
// card number typed into a numeric column, a token pasted into a uuid
// column), and it leaked at the default before this fix. The value is
// double-quoted and follows a bare `:`; a double-quoted IDENTIFIER
// elsewhere in the SAME message (preceded by a word, never a colon) must
// still survive in the SAME run, or the fix could pass by redacting the
// whole message — which the ticket forbids.
fn driverCastErrorMessage(): string {
  return "invalid input syntax for type integer: \"${secretValue}\" " +
    "for column \"card_number\" of relation \"payments\""
}

test "a Postgres primary-line cast error (no DETAIL, double-quoted) is redacted, and a double-quoted identifier in the same message survives" {
  let sink = newLogSink()
  let db = QueryLog(recLogger(sink)).wrap(
    logExecFake{ calls = []logCall(0), failMessage = driverCastErrorMessage() },
  )
  let msg = execFailure(db, "insert into payments (card_number) values ($1)")
  assert(
    contains(msg, secretValue),
    "the driver's own failure reaching the caller is untouched by log redaction: ${msg}",
  )
  for line of sink.lines {
    assert(
      !contains(line, secretValue),
      "a value quoted after a bare colon leaked through the driver's own error message: ${line}",
    )
  }
  assert(
    contains(sinkText(sink), "payments"),
    "a double-quoted IDENTIFIER (preceded by a word, not a colon) must survive: ${sinkText(sink)}",
  )
}

// The source-level half of "never write to stdout" (#5075's own constraint)
// and of "never log a bound value" (#7430): log.bit calls no `print`, and no
// log attribute is built from `params`. Same contract as
// pkg/orm/raw.test.bit's own source check.
test "source check: log.bit never calls print (stdout) and never reads a statement's params into a record" {
  let loc = locateBit()
  if (len(loc.repo) == 0) {
    print("log.bit source check: repo not locatable (set BIT_REPO) — skipping\n")
    return
  }
  let src = readFile("${loc.repo}/pkg/orm/log.bit") catch e {
    panic("read log.bit: ${e.message()}")
  }
  assert(len(src) > 500, "log.bit read back ${len(src)} byte(s) — the read failed")
  assert(count(src, " print(") == 0, "log.bit must not call print (stdout)")
  assert(count(src, "params)") == 2, "params must only be forwarded to inner.query/inner.exec")

  // The control: the needle search itself must be able to find a positive,
  // proven against this file's own source, which legitimately calls print
  // in the skip branch above — a search that finds nothing anywhere would
  // pass this test for the wrong reason.
  let ownSrc = readFile("${loc.repo}/pkg/orm/log.test.bit") catch e {
    panic("read log.test.bit: ${e.message()}")
  }
  assert(count(ownSrc, " print(") > 0, "control: the print( search must find a positive somewhere")
}
