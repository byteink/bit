// pkg/orm/guard.test.bit — #7034's acceptance for `pkg/orm/guard.bit` and the
// `Options.authz` field `open` (db.bit) reads.
//
// `fakeGuard` below is a structural `Guard` (SPEC §14.3): it declares no
// `implements` and this package imports no authorization package. The pool
// comes from ./rawsql.test.bit's `newRawPool`/`newRawAdapter`, a sibling in
// the same module, so a `Db` is built directly (`rawsql.test.bit`'s header
// says why) and no live server is needed. `open` itself is only reachable
// here on its failing-guard path, which returns before any connection is
// made; its success path needs a server and is the live gate's.

class fakeGuard {
  table: string
  checkMsg: string

  protects(t: string): bool {
    return t == this.table
  }

  filter(actor: Actor, op: GuardOp, t: string, dialect: ServerDialect, firstParam: int): GuardFilter! {
    return GuardFilter.Sql("owner = $${firstParam}", [Value.Text(actor.id)])
  }

  allows(actor: Actor, op: GuardOp, t: string, columns: []string, values: []Value): bool! {
    return len(columns) == len(values)
  }

  denied(actor: Actor, op: GuardOp, t: string): error {
    return newError("denied ${actor.id} on ${t}")
  }

  notFound(t: string): error {
    return newError("${t}: not found")
  }

  check(): ()! {
    if (this.checkMsg != "") {
      fail newError(this.checkMsg)
    }
  }
}

class guardStaff {
  id: string
  name: string
}

@table class GuardNote {
  id: i64,
  body: string,
}

fn protectsNote(g: Option<Guard>): bool {
  match (g) {
    Some(x) => return x.protects("note")
    None => return false
  }
}

test "Options{} carries no guard, so open(url) is unchanged (#7034, #6698)" {
  let o = Options{}
  assert(!o.synchronize, "synchronize must stay false")
  match (o.authz) {
    Some(_) => assert(false, "a default Options must carry no guard")
    None => {}
  }

  let s = Options{ synchronize = true }
  match (s.authz) {
    Some(_) => assert(false, "setting only synchronize must leave authz None")
    None => {}
  }
}

test "open with a guard whose check() fails returns that error before connecting" {
  let g = fakeGuard{ table = "note", checkMsg = "authz: no Delete rule variant" }
  open("postgres://nowhere.invalid/x", Options{ authz = g }) catch e {
    assert(e.message() == "authz: no Delete rule variant", "got: ${e.message()}")
    return
  }
  assert(false, "a failing guard.check() must fail open")
}

test "a guard that passes check() does not mask the driver error for a bad URL" {
  let g = fakeGuard{ table = "note", checkMsg = "" }
  open("sqlite://x", Options{ authz = g }) catch e {
    assert(contains(e.message(), "no driver recognizes"), "got: ${e.message()}")
    return
  }
  assert(false, "an unknown scheme must still fail open")
}

test "a Db with a guard hands it to table<T>() and to a tx handle's table<T>()" {
  let g = fakeGuard{ table = "note", checkMsg = "" }
  let db = Db{ pool = newRawPool(newRawAdapter()), guard = g }

  assert(protectsNote(db.guard), "the Db must keep its guard")
  assert(protectsNote(db.table<GuardNote>().guard), "table<T>() must carry the guard")
  assert(
    protectsNote(db.table<GuardNote>().where("body", "x").guard),
    "the guard must survive a chain method's copy",
  )

  let tx = TxHandle{ db = newRawPool(newRawAdapter()), guard = db.guard }
  assert(protectsNote(tx.table<GuardNote>().inner.guard), "tx.table<T>() must carry the guard")
}

test "a Db without a guard derives handles without one" {
  let db = Db{ pool = newRawPool(newRawAdapter()) }
  assert(!protectsNote(db.guard), "no guard on the Db")
  assert(!protectsNote(db.table<GuardNote>().guard), "no guard on the repository")
}

test "a Guard receives any class with an id as its Actor and answers through the interface" {
  let g: Guard = fakeGuard{ table = "note", checkMsg = "" }
  let who = guardStaff{ id = "u7", name = "Sara" }

  let f = g.filter(who, GuardOp.Read, "note", ServerDialect.Postgres, 3) catch e {
    assert(false, "filter must not fail: ${e.message()}")
    return
  }
  match (f) {
    Sql(frag, args) => {
      assert(frag == "owner = $3", "got: ${frag}")
      assert(len(args) == 1, "got ${len(args)} arg(s)")
    }
    All => assert(false, "expected Sql")
    None => assert(false, "expected Sql")
  }

  let ok = g.allows(who, GuardOp.Create, "note", ["body"], [Value.Text("x")]) catch e {
    assert(false, "allows must not fail: ${e.message()}")
    return
  }
  assert(ok, "one column, one value must be allowed")
  assert(g.denied(who, GuardOp.Delete, "note").message() == "denied u7 on note", "denied text")
  assert(g.notFound("note").message() == "note: not found", "notFound text")
}
