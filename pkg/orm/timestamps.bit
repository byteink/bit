// pkg/orm/timestamps.bit — @timestamps (#5062): createdAt filled once on
// INSERT, updatedAt filled on INSERT and every UPDATE.
//
//     @table @timestamps
//     class Person {
//       @id id: i64
//       name: string
//       createdAt: i64
//       updatedAt: i64
//     }
//
// `@timestamps` IS RECOGNIZED THE SAME WAY `@table`'S OWN OVERRIDE IS.
// compiler/classtabledesc.bit's `tableClassOwnAttrs` records `@timestamps`'s
// bare presence into the SAME `tableAttrs(): []AttrDesc` list `@table`'s own
// `@table("name")` argument already uses (#5189) — one compiler-known class
// attribute list (compiler/parserdecl.bit's `checkClassAttrs`), one
// synthesized accessor, read here the identical way `write.bit`'s
// `hasIdAttr`/`patch.bit`'s `versionFieldOf` already read a FIELD's own
// recorded attrs: by name, never by a second mechanism. The compiler
// attaches no SQL meaning to it — whether the class also declares
// `createdAt`/`updatedAt` is this file's own RUNTIME check
// (`requireTimestampField`), not a compile-time one, the same split
// `stdlib/sql/desc.bit`'s own header draws for every other recorded
// attribute.
//
// THE CLOCK IS INJECTED, NEVER READ IN THIS FILE. `now()` (stdlib/time) is
// non-deterministic — a test asserting an EXACT value (this ticket's own
// acceptance) cannot call it and compare against itself. Every function
// below takes the reading as a `Timestamp` parameter instead: production
// code reads it once, in the small per-entity wrapper this package has
// always used (write.bit's own header, `saveUser`), and a test passes a
// literal. "One now() per statement, taken in the ORM, not per column" (the
// ticket's own constraint) means exactly one call site reads the clock per
// write; it does not have to be INSIDE this file to be exactly once, and
// keeping it out of this file is what makes the exact-value assertion
// possible at all.
//
// THE PATCH-BUILDER PATH (patch.bit, #5060) HAS NO INSTANCE TO READ
// `tableAttrs()` OFF. Same limitation patch.bit's own header already
// documents for `fields`/`columnForPatchField`: `update<T>`/`deleteMany<T>`
// take `table`/`fields` explicitly because there is no entity in hand, so
// the caller's own wrapper builds a throwaway zero-value instance once
// (`docs/patch.md`'s `personFields()`). `withUpdatedAt` below takes
// `classAttrs` explicitly for the identical reason, read off that same
// throwaway instance's own `tableAttrs()`. `deleteMany`/`DeletePatch` never
// touch `updatedAt` — a DELETE has no SET list.

import { Timestamp } from "std/time"

// Which required field a `@timestamps` class did not declare.
export enum TimestampsCause { MissingField }

// Satisfies the predeclared `error` interface (SPEC §10.6, §18.3), the same
// shape `write.bit`'s `WriteError` and `patch.bit`'s `PatchError` are.
// Catchable rather than a panic (unlike `write.bit`'s `primaryKeyField`,
// which treats a missing `@id` as a caller bug) so a caller — and this
// file's own test — can assert on it directly.
export class TimestampsError {
  export cause: TimestampsCause
  export table: string
  export field: string

  message(): string {
    return "pkg/orm: the class mapped to '${this.table}' carries '@timestamps' but declares no '${this.field}' field"
  }
}

const timestampsMark = "timestamps"
const fieldCreatedAt = "createdAt"
const fieldUpdatedAt = "updatedAt"

// True iff `classAttrs` (a class's own `tableAttrs()`) carries the
// `@timestamps` marker — see this file's header for where that is recorded.
export fn hasTimestampsAttr(classAttrs: []AttrDesc): bool {
  for a of classAttrs {
    if (a.name == timestampsMark) {
      return true
    }
  }
  return false
}

// Fills `values["createdAt"]`/`values["updatedAt"]` for a `@timestamps`
// table, mutating `values` in place, and returns the `TableDesc` `save`
// should actually write with — unchanged when `classAttrs` does not carry
// the mark, so a table without it has neither column written. `persisted`
// is `save`'s own INSERT/UPDATE decision (write.bit), reused rather than
// re-derived: `updatedAt` is set either way; `createdAt` is set ONLY when
// `!persisted` (this is the INSERT), both from the SAME `at.ns` so an
// INSERT's two columns come out byte-identical. `at` is the caller's one
// clock reading for this statement — see this file's header for why this
// file never calls `now()` itself.
//
// ON AN UPDATE, THE RETURNED DESC DROPS `createdAt` FROM `fields`.
// `write.bit`'s own header: "UPDATE WRITES EVERY COLUMN" — `updateSql`
// builds its SET list straight from `desc.fields` with no per-field
// exclusion of its own, and rewriting `createdAt` on an UPDATE would
// destroy the row's age (this ticket's own constraint). Excluding it here,
// once, is the "explicit exclusion" the ticket asks for, without adding a
// column-skip parameter to `write.bit` that every OTHER caller of `save`
// would then have to thread through unused.
export fn applyTimestamps(
  desc: TableDesc, values: map<string, Value>, persisted: bool,
  classAttrs: []AttrDesc, at: Timestamp,
): TableDesc! {
  if (!hasTimestampsAttr(classAttrs)) {
    return desc
  }
  requireTimestampField(desc.table, desc.fields, fieldCreatedAt)?
  requireTimestampField(desc.table, desc.fields, fieldUpdatedAt)?
  values[fieldUpdatedAt] = Value.Int(at.ns)
  if (!persisted) {
    values[fieldCreatedAt] = Value.Int(at.ns)
    return desc
  }
  return TableDesc{ table: desc.table, fields: withoutField(desc.fields, fieldCreatedAt) }
}

// `fields` with `name` removed — the one caller being `applyTimestamps`'s
// UPDATE branch, above.
fn withoutField(fields: []FieldDesc, name: string): []FieldDesc {
  let out = []FieldDesc(0)
  for f of fields {
    if (f.name != name) {
      out = append(out, f)
    }
  }
  return out
}

// Chains `updatedAt = <at>` onto a `Patch<T>` build — the SAME `.set()`
// every other column goes through (patch.bit's own `columnForPatchField`
// validates `updatedAt` against `p.fields` identically), so a table missing
// the field panics the same way a hand-written `.set("updatedAt", ...)`
// would. A no-op, returning `p` unchanged, when `classAttrs` does not carry
// the mark — see this file's header for why `classAttrs` is a parameter
// here rather than read off an instance.
export fn withUpdatedAt<T>(p: Patch<T>, classAttrs: []AttrDesc, at: Timestamp): Patch<T> {
  if (!hasTimestampsAttr(classAttrs)) {
    return p
  }
  return p.set(fieldUpdatedAt, Value.Int(at.ns))
}

// `fields` names `field`, or a catchable `TimestampsError` naming both — the
// ticket's own wording: "a class carrying the mark without them is an error
// naming the missing field".
fn requireTimestampField(table: string, fields: []FieldDesc, field: string): ()! {
  for f of fields {
    if (f.name == field) {
      return
    }
  }
  fail TimestampsError{ cause: TimestampsCause.MissingField, table: table, field: field }
}
