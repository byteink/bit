// pkg/orm/keyset.bit — after(), the keyset-pagination cursor (#5072; #6296
// retired this file's own former `Query<T>.after()` support, `keysetPredicate`/
// `keysetFieldNamed` — `keysetPredicateForRepo` below, `Repo<T>.after()`'s
// own logic, #6293, is the one entry point left).
//
//     let q = people.orderBy("id", Dir.Asc)
//     let page1 = q.limit(50).all()?
//     let last = page1[len(page1) - 1]
//     let page2 = q.after(last.id).limit(50).all()?   // WHERE id > $1 ORDER BY id LIMIT 50
//
// `LIMIT 50 OFFSET 100000` MAKES THE DATABASE COUNT AND DISCARD 100000
// ROWS FIRST — `offset()` (pkg/orm/repo.bit) stays available for a
// page-number UI, but its cost grows with depth. `after()` never adds an
// OFFSET: it carries the last row's own sort key and asks for everything
// past it, which uses the ORDER BY column's index instead of a table scan,
// so page 10000 costs what page 1 costs. See `docs/query.md` (paging by
// key) for what this does and does not prove without a real database — an
// index-friendly WHERE clause is not the same claim as a measured query
// plan.
//
// AFTER() READS THE FIRST orderBy() COLUMN, AND REQUIRES ONE TO ALREADY BE
// SET. `Repo<T>.orderBy()` (pkg/orm/repo.bit) records "<column> <asc|desc>"
// text, already resolved to the SQL column, in `orderBys` — this file's own
// `keysetPredicateForRepo` reads the FIRST entry. Calling `after()` before
// any `orderBy()` — the order is chain-position-independent for every
// other method here, but `after()` needs the order already recorded to
// read it — refuses with `KeysetCause.NoOrderBy`, and ordering by a column
// that carries neither `@id` nor `@unique` refuses naming it
// (`KeysetCause.NotUnique`): a non-unique sort key means two rows can share
// the boundary value, so "everything after it" silently skips or repeats
// rows. A composite (multi-column) keyset cursor, comparing a tuple rather
// than one column, is real, separate work not attempted here, the same way
// this package flags every other real gap (`pkg/orm/schema.bit`'s own
// header lists three).
//
// `split` is imported here — this file's canonical site (SPEC §17.1's flat
// namespace carries it to every sibling, `check.test.bit` among them); a
// second import would be E0042.
import { split } from "std/strings"

// `FieldDesc` (naming.bit/data.test.bit) needs no import here — a second
// import would be E0042.

// Why `after()` on the class mapped to `table` was refused: no `orderBy()`
// was set yet, or the column it orders by is not `@id`/`@unique` — see
// this file's header.
export enum KeysetCause { NoOrderBy, NotUnique }

// Satisfies the predeclared `error` interface (SPEC §10.6, §18.3), the same
// shape `pkg/orm/patch.bit`'s `PatchError` is.
export class KeysetError {
  export cause: KeysetCause
  export table: string
  export column: string

  export message(): string {
    match (this.cause) {
      NoOrderBy => return "pkg/orm: after() on the class mapped to '${this.table}' has no orderBy() set - keyset pagination needs a deterministic order to compare the cursor against"
      NotUnique => return "pkg/orm: after() on the class mapped to '${this.table}' orders by '${this.column}', which is neither @id nor @unique - the page boundary would be ambiguous, silently skipping or repeating rows"
    }
  }
}

// Whether `f` carries `@id` or `@unique` — the one property that makes
// "greater than this row's key" an unambiguous page boundary.
fn keysetIsUnique(f: FieldDesc): bool {
  for a of f.attrs {
    if (a.name == "id" || a.name == "unique") {
      return true
    }
  }
  return false
}

// `Repo<T>.after()` (`pkg/orm/repo.bit`'s own "locking, paging, versions"
// block, #6276) reads `Repo<T>`'s own rendered `orderBys` state directly —
// `Repo<T>.orderBy()` stores "<column> <asc|desc>" text, already resolved
// to the SQL column name (`Repo<T>` tracks no separate Bit-field-name/`Dir`
// pair). Refuses with `KeysetError`/`KeysetCause`, reusing `keysetIsUnique`
// unchanged — only matched here by SQL COLUMN name (`columnName(f)`), the
// one form that survives into `orderBys`.
export fn keysetPredicateForRepo(
  table: string,
  fields: []FieldDesc,
  orderBys: []string,
): (string, string)! {
  if (len(orderBys) == 0) {
    fail KeysetError{ cause = KeysetCause.NoOrderBy, table = table, column = "" }
  }
  let parts = split(orderBys[0], " ")
  let col = parts[0]
  let f = keysetFieldByColumn(fields, col, table)
  if (!keysetIsUnique(f)) {
    fail KeysetError{ cause = KeysetCause.NotUnique, table = table, column = f.name }
  }
  let op = ">"
  if (len(parts) > 1 && parts[1] == "desc") {
    op = "<"
  }
  return (col, op)
}

// `col`'s own `FieldDesc` by SQL column name, or a panic naming both —
// unreachable in practice, since `Repo<T>.orderBy()` already validated the
// column through its own `columnFor` before recording it into `orderBys`;
// kept defensive the same way `keysetFieldNamed` above is.
fn keysetFieldByColumn(fields: []FieldDesc, col: string, table: string): FieldDesc {
  for f of fields {
    if (columnName(f) == col) {
      return f
    }
  }
  panic("pkg/orm: '${col}' is not a column of the class mapped to '${table}'")
}
