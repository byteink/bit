// pkg/orm/lock.test.bit — #5083's acceptance, against a fake driver.
//
// `lockAdapter` is the "database": `calls` records every statement issued,
// through either `lockConn` (no open transaction - a `Pool`) or `lockTx`
// (inside one) - so a test can assert `len(a.calls) == 0` to prove a
// refusal issued nothing, the same shape `pkg/orm/query.test.bit`'s own
// `qryAdapter` is for a plain read.
//
// `pool`/`Pool`/`Datasource`/`Conn`/`Rows`/`Stmt`/`Tx`/`Value` are imported
// by ./data.test.bit, this file's sibling in the same module (SPEC §17.1) -
// a second import here would be E0042. `field` (a plain, non-`@id`
// `FieldDesc`) is declared in ./naming.test.bit and reused here rather than
// redeclared, the same way ./write.test.bit's own header explains reusing
// it. `Widget`/`qryAdapter`/`Account`/`fkAdapter` are already module-level
// names (./query.test.bit, ./write.test.bit, ./data.test.bit) - this file's
// own fake and mapped class are named `lock*`/`Job` so neither collides
// (E0042). `contains` is imported by ./query.test.bit and reused here.

import { hasSuffix } from "std/strings"

class Job { id: i64 }

fn jobMapper(rows: Rows): Job! {
  let cols = rows.columns()
  return Job{ id = sqlReqInt(rows, cols, "id")? }
}

class lockCall { sql: string, args: []Value }

class lockRows {
  cols: []string
  data: [][]Value
  i: int
  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }
  columns(): []string {
    return this.cols
  }
  value(col: int): Value {
    return this.data[this.i][col]
  }
  close() {}
}

// The fake database: every `query()` call, through either handle.
class lockAdapter {
  calls: []lockCall
  cols: []string
  rows: [][]Value
  connect(cfg: Datasource): Conn! {
    return lockConn{ a = this }
  }
}

// One physical connection - no transaction open, so `Pool.begin()` (below)
// is the only way to reach `lockTx`; a `query()` issued straight through
// here is exactly the "on a Pool" case `requireTx` refuses.
class lockConn {
  a: lockAdapter
  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, lockCall{ sql = sqlText, args = params })
    return lockRows{ cols = this.a.cols, data = this.a.rows, i = -1 }
  }
  exec(sqlText: string, params: []Value): int! {
    fail newError("fake: exec not supported")
  }
  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }
  begin(): Tx! {
    return lockTx{ a = this.a }
  }
  close() {}
}

// One open transaction. `query()` behaves exactly like `lockConn`'s -
// `p.tx()` is what the caller's `db` becomes a `Tx` under, never this fake's
// own bookkeeping - so `requireTx` sees this as "not a Pool" purely from its
// runtime type, the same assertion `stdlib/sql/tx.bit`'s `enter()` makes.
class lockTx {
  a: lockAdapter
  query(sqlText: string, params: []Value): Rows! {
    this.a.calls = append(this.a.calls, lockCall{ sql = sqlText, args = params })
    return lockRows{ cols = this.a.cols, data = this.a.rows, i = -1 }
  }
  exec(sqlText: string, params: []Value): int! {
    fail newError("fake: exec not supported")
  }
  commit(): ()! {}
  rollback(): ()! {}
}

fn newLockPool(a: lockAdapter): Pool {
  let p = pool(a, Datasource{ host = "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

// #6108's own fixture needs what neither existing adapter has alone:
// `relAdapter` (relation.test.bit) answers one result set PER STATEMENT but
// has no `begin()`; `lockAdapter` above supports `begin()` but replays the
// SAME canned rows for every statement. `with()` issues two different
// statements (the parent query, then the relation's IN query) and
// `forUpdate()` needs a live Tx, so this wraps `relAdapter`'s per-statement
// replay with a working `begin()`. Reuses `relCall`/`relResult`/`relRows`
// (relation.test.bit, same module, SPEC §17.1) rather than redeclaring them.
class lockRelAdapter {
  calls: []relCall
  results: []relResult
  connect(cfg: Datasource): Conn! {
    return lockRelConn{ a = this }
  }
}

class lockRelConn {
  a: lockRelAdapter
  query(sqlText: string, params: []Value): Rows! {
    let idx = len(this.a.calls)
    this.a.calls = append(this.a.calls, relCall{ sql = sqlText, args = params })
    let rs = this.a.results[idx]
    return relRows{ cols = rs.cols, data = rs.rows, i = -1 }
  }
  exec(sqlText: string, params: []Value): int! {
    fail newError("fake: exec not supported")
  }
  prepare(sqlText: string): Stmt! {
    fail newError("fake: prepare not supported")
  }
  begin(): Tx! {
    return lockRelTx{ a = this.a }
  }
  close() {}
}

class lockRelTx {
  a: lockRelAdapter
  query(sqlText: string, params: []Value): Rows! {
    let idx = len(this.a.calls)
    this.a.calls = append(this.a.calls, relCall{ sql = sqlText, args = params })
    let rs = this.a.results[idx]
    return relRows{ cols = rs.cols, data = rs.rows, i = -1 }
  }
  exec(sqlText: string, params: []Value): int! {
    fail newError("fake: exec not supported")
  }
  commit(): ()! {}
  rollback(): ()! {}
}

fn newLockRelPool(a: lockRelAdapter): Pool {
  let p = pool(a, Datasource{ host = "fake" }) catch e {
    panic("pool: ${e.message()}")
  }
  return p
}

// The running schema for #6108's own fixture: `LockedJob` hasMany `JobNote`
// (`jobId`) — a real `@hasMany`-attributed, `@table`-carrying pair, the same
// "exercise the real compiler mechanism" reasoning relation.test.bit's own
// header gives for its schema.
@table class LockedJob {
  @id
  id: i64
  @hasMany("jobId")
  notes: []JobNote
}

@table class JobNote {
  @id
  id: i64
  jobId: i64
}

fn lockedJobMapper(rows: Rows): LockedJob! {
  let cols = rows.columns()
  return LockedJob{ id = sqlReqInt(rows, cols, "id")? }
}

fn jobNoteMapper(rows: Rows): JobNote! {
  let cols = rows.columns()
  return JobNote{ id = sqlReqInt(rows, cols, "id")?, jobId = sqlReqInt(rows, cols, "job_id")? }
}

fn jobNotesLoader(): RelationLoader<LockedJob> {
  return hasMany<LockedJob, JobNote>(
    (j) => j.id,
    (db) => find<JobNote>(db, "job_notes", [field("id"), field("jobId")], jobNoteMapper),
    "jobId",
    (n) => n.jobId,
    (j, notes) => {
      j.notes = notes
    },
  )
}

fn lockedJobs(db: Data): Query<LockedJob> {
  return withRelations(
    find<LockedJob>(db, "locked_jobs", [field("id")], lockedJobMapper),
    map<string, RelationLoader<LockedJob>>{ "notes": jobNotesLoader() },
  )
}

// One parent row with two child rows — replayed fresh per test below, since
// `lockRelAdapter.results` is consumed by index and each test issues its own
// two statements.
fn lockRelResults(): []relResult {
  return [
    relResult{ cols = ["id"], rows = [[Value.Int(1)]] },
    relResult{
      cols = ["id", "job_id"], rows = [[Value.Int(1), Value.Int(1)], [Value.Int(2), Value.Int(1)]],
    },
  ]
}

fn lastLockCall(a: lockAdapter): lockCall {
  return a.calls[len(a.calls) - 1]
}

fn jobQuery(db: Data): Query<Job> {
  return find<Job>(db, "jobs", [field("id"), field("state")], jobMapper).where(
    "state",
    Value.Text("pending"),
  )
}

test "forUpdate() inside a transaction emits a statement ending FOR UPDATE" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(jobQuery(db), LockOpts{}, ServerDialect.Postgres).oneOrFail()?
  }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastLockCall(a).sql
  assert(hasSuffix(sql, " for update"), "got: ${sql}")
}

test "forUpdate(skipLocked = true) emits FOR UPDATE SKIP LOCKED" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(jobQuery(db), LockOpts{ skipLocked = true }, ServerDialect.Postgres).oneOrFail()?
  }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastLockCall(a).sql
  assert(hasSuffix(sql, " for update skip locked"), "got: ${sql}")
}

test "forUpdate(nowait = true) emits FOR UPDATE NOWAIT" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(jobQuery(db), LockOpts{ nowait = true }, ServerDialect.Postgres).oneOrFail()?
  }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastLockCall(a).sql
  assert(hasSuffix(sql, " for update nowait"), "got: ${sql}")
}

// This is the mutation proof: comment out `requireTx(this.inner.db)?`
// inside `LockedQuery.guard()` (lock.bit) and this test goes red - the
// query on a bare Pool would then run and return the canned row instead of
// failing, and `a.calls` would be non-empty.
test "forUpdate called on a Pool rather than a Tx is refused naming both, with zero statements issued" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  forUpdate<Job>(jobQuery(p), LockOpts{}, ServerDialect.Postgres).oneOrFail() catch e {
    let (le, ok) = e.(LockError)
    assert(ok, "a LockError, got '${e.message()}'")
    assert(le.cause == LockCause.NotInTransaction, "cause must be NotInTransaction")
    assert(contains(e.message(), "Pool"), "message must name Pool: ${e.message()}")
    assert(contains(e.message(), "Tx"), "message must name Tx: ${e.message()}")
    assert(len(a.calls) == 0, "a statement was issued despite the refusal")
    return
  }
  assert(false, "must refuse forUpdate on a Pool")
}

test "skipLocked and nowait passed together are refused" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(
      jobQuery(db),
      LockOpts{ skipLocked = true, nowait = true },
      ServerDialect.Postgres,
    ).oneOrFail() catch e {
      let (le, ok) = e.(LockError)
      assert(ok, "a LockError, got '${e.message()}'")
      assert(le.cause == LockCause.ConflictingOptions, "cause must be ConflictingOptions")
      return
    }
    assert(false, "must refuse skipLocked and nowait together")
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }
}

test "the MySQL renderer refuses SKIP LOCKED at 5.7 and accepts it at 8.0" {
  mysqlLockClause(LockOpts{ skipLocked = true }, MysqlVersion{ major = 5, minor = 7 }) catch e {
    let (le, ok) = e.(LockError)
    assert(ok, "a LockError, got '${e.message()}'")
    assert(le.cause == LockCause.UnsupportedByDialect, "cause must be UnsupportedByDialect")
    assert(contains(e.message(), "5.7"), "message must name the version: ${e.message()}")
    let clause = mysqlLockClause(
      LockOpts{ skipLocked = true },
      MysqlVersion{ major = 8, minor = 0 },
    ) catch e2 {
      assert(false, "must accept at 8.0: ${e2.message()}")
      return
    }
    assert(hasSuffix(clause, "skip locked"), "got: ${clause}")
    return
  }
  assert(false, "must refuse SKIP LOCKED at MySQL 5.7")
}

// #5391's mutation proof: comment out the `Mysql(version) =>` arm's call to
// `mysqlLockClause` inside `LockedQuery.guard()` (lock.bit) and this test
// goes red - the query would run against MySQL 5.7 and return the canned
// row instead of failing, and `a.calls` would be non-empty. Unlike "the
// MySQL renderer refuses..." above, this drives the real find path
// (`forUpdate<T>(...).oneOrFail()`), never `mysqlLockClause` directly - the
// guard that was dead code before #5391 is what this test actually
// exercises.
test "forUpdate through the real find path refuses SKIP LOCKED against MySQL 5.7, naming the version" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(
      jobQuery(db),
      LockOpts{ skipLocked = true },
      ServerDialect.Mysql(MysqlVersion{ major = 5, minor = 7 }),
    ).oneOrFail() catch e {
      let (le, ok) = e.(LockError)
      assert(ok, "a LockError, got '${e.message()}'")
      assert(le.cause == LockCause.UnsupportedByDialect, "cause must be UnsupportedByDialect")
      assert(contains(e.message(), "5.7"), "message must name the version: ${e.message()}")
      assert(len(a.calls) == 0, "a statement was issued despite the refusal")
      return
    }
    assert(false, "must refuse SKIP LOCKED against MySQL 5.7 through forUpdate")
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }
}

// The MySQL 8.0 counterpart: the same real find path, the clause IS
// emitted.
test "forUpdate through the real find path emits SKIP LOCKED against MySQL 8.0" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(
      jobQuery(db),
      LockOpts{ skipLocked = true },
      ServerDialect.Mysql(MysqlVersion{ major = 8, minor = 0 }),
    ).oneOrFail()?
  }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastLockCall(a).sql
  assert(hasSuffix(sql, " for update skip locked"), "got: ${sql}")
}

test "forUpdate on count() is refused" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(jobQuery(db), LockOpts{}, ServerDialect.Postgres).count() catch e {
      let (le, ok) = e.(LockError)
      assert(ok, "a LockError, got '${e.message()}'")
      assert(le.cause == LockCause.TerminalNotLockable, "cause must be TerminalNotLockable")
      return
    }
    assert(false, "must refuse forUpdate on count()")
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }
}

// #5383: `Query<T>.forUpdate(opts)` (pkg/orm/query.bit) is the chain form,
// one line delegating into the free `forUpdate<T>` above — these two tests
// mirror the first and the Pool-refusal test above through that form,
// proving the chain itself locks and refuses identically. The free
// function's own tests above are untouched and still drive it directly.
test "Query<T>.forUpdate() chained emits a statement ending FOR UPDATE" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    jobQuery(db).forUpdate(LockOpts{}, ServerDialect.Postgres).all()?
  }) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let sql = lastLockCall(a).sql
  assert(hasSuffix(sql, " for update"), "got: ${sql}")
}

test "Query<T>.forUpdate() chained on a Pool rather than a Tx is refused, zero statements issued" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  jobQuery(p).forUpdate(LockOpts{}, ServerDialect.Postgres).oneOrFail() catch e {
    let (le, ok) = e.(LockError)
    assert(ok, "a LockError, got '${e.message()}'")
    assert(le.cause == LockCause.NotInTransaction, "cause must be NotInTransaction")
    assert(len(a.calls) == 0, "a statement was issued despite the refusal")
    return
  }
  assert(false, "must refuse forUpdate on a Pool")
}

test "forUpdate on exists() is refused" {
  let a = lockAdapter{ cols = ["id"], rows = [[Value.Int(1)]] }
  let p = newLockPool(a)

  p.tx((db) => {
    forUpdate<Job>(jobQuery(db), LockOpts{}, ServerDialect.Postgres).exists() catch e {
      let (le, ok) = e.(LockError)
      assert(ok, "a LockError, got '${e.message()}'")
      assert(le.cause == LockCause.TerminalNotLockable, "cause must be TerminalNotLockable")
      return
    }
    assert(false, "must refuse forUpdate on exists()")
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }
}

// #6108: `LockedQuery<T>.all()`/`one()`/`oneOrFail()` used to call
// `sqlFindMany`/`sqlFindOne`/`sqlFindOneOrFail` directly and never run
// `this.inner.loadWith(...)`, so `with("notes")` compiled and ran but left
// every `notes` unloaded — the mutation proof: drop any one of the three
// `this.inner.loadWith(...)` calls in `LockedQuery`'s terminals (lock.bit)
// and its own arm of this test goes red, since `notes` would stay at
// #5271's unloaded sentinel length 0 instead of 2.
test "with(\"notes\").forUpdate(...) populates the relation under all(), one() and oneOrFail() alike (#6108)" {
  let aAll = lockRelAdapter{ calls = []relCall(0), results = lockRelResults() }
  let pAll = newLockRelPool(aAll)
  pAll.tx((db) => {
    let jobs = lockedJobs(db).with("notes").forUpdate(LockOpts{}, ServerDialect.Postgres).all()?
    assert(len(jobs) == 1, "want 1 job, got ${len(jobs)}")
    assert(
      len(jobs[0].notes) == 2,
      "all() must populate with(\"notes\"), got ${len(jobs[0].notes)}",
    )
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }

  let aOne = lockRelAdapter{ calls = []relCall(0), results = lockRelResults() }
  let pOne = newLockRelPool(aOne)
  pOne.tx((db) => {
    let opt = lockedJobs(db).with("notes").forUpdate(LockOpts{}, ServerDialect.Postgres).one()?
    assert(isSome<LockedJob>(opt), "one() must return Some for a matching row")
    let job = unwrap<LockedJob>(opt)
    assert(len(job.notes) == 2, "one() must populate with(\"notes\"), got ${len(job.notes)}")
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }

  let aFail = lockRelAdapter{ calls = []relCall(0), results = lockRelResults() }
  let pFail = newLockRelPool(aFail)
  pFail.tx((db) => {
    let job = lockedJobs(db).with("notes").forUpdate(LockOpts{}, ServerDialect.Postgres).oneOrFail()?
    assert(len(job.notes) == 2, "oneOrFail() must populate with(\"notes\"), got ${len(job.notes)}")
  }) catch e {
    assert(false, "must not error: ${e.message()}")
  }
}
