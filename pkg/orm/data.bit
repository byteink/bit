// pkg/orm — the Data interface (#5055): what Pool and a live transaction
// share, so an ORM function runs standalone or inside a caller's
// transaction with no second version and no second entry point.
//
//     fn transfer(db: Data, from: i64, to: i64, amt: decimal): ()! { ... }
//
//     transfer(pool, 1, 2, amt)?                       // its own transaction, per statement
//     pool.tx((db) => { transfer(db, 1, 2, amt)? })?    // inside the caller's
//
// `Data` is `query`/`exec` — the same shape std/sql's own `Executor`
// (stdlib/sql/tx.bit) already names, under the ORM's vocabulary: every ORM
// function that reads or writes takes `Data`, never `Pool`, so nothing in
// this package has to be written twice for "runs on its own" and "runs in a
// transaction".
//
// `db.tx(...)`/`db.txAt(...)` (owner decision 2026-09-12: "aesthetically
// unpleasing" about `tx(pool, f)`) are METHODS on `Pool` now, not free
// functions a caller has to import separately — stdlib/sql/txmethods.bit's
// `Transactable` trait, `use`d once by `Pool` (stdlib/sql/pool.bit). This
// file does not repeat that shape: std/sql's own `tx`/`txAt`/`txValue`/
// `txValueAt` (stdlib/sql/tx.bit) are unchanged and still exported for a
// caller that has not moved to the method form.
//
// THE CLOSURE PARAMETER SHADOWS THE OUTER HANDLE ON PURPOSE. Naming it `db`
// again, as every example above does, makes the pool underneath
// unreachable inside the block — `pool.tx((db) => { pool.save(a)? })` would
// write outside the transaction and never roll back if `pool` stayed
// reachable under a different name. The shortest correct spelling is also
// the safe one.
import { Executor } from "std/sql"

// Anything ORM code can run a query or a write against: a `Pool`, or the
// handle of a transaction already running on one. See this file's header
// for why every ORM function takes `Data` instead of `Pool`.
export type Data = Executor
