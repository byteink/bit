// pkg/orm/errors.test.bit — #5071's acceptance, against a fake driver error.
//
// `contains` is imported by ./query.test.bit, this file's sibling in the
// same module (SPEC §17.1) — a second import here would be E0042.
//
// `fakeDriverError` stands in for `pgError`/`myError` (`pkg/postgres`,
// `pkg/mysql`): `message()`/`sqlState()` are what those two already carry,
// `constraint()`/`column()`/`referencedTable()` are `causeDetail`
// (errors.bit) — the richer, still-optional shape neither driver
// implements yet (errors.bit's own header explains why).
class fakeDriverError {
  code: string
  text: string
  cons: string
  col: string
  refTable: string

  message(): string {
    return this.text
  }

  sqlState(): string {
    return this.code
  }

  constraint(): string {
    return this.cons
  }

  column(): string {
    return this.col
  }

  referencedTable(): string {
    return this.refTable
  }
}

fn driverErr(
  code: string,
  text: string,
  cons: string,
  col: string,
  refTable: string,
): fakeDriverError {
  return fakeDriverError{ code = code, text = text, cons = cons, col = col, refTable = refTable }
}

test "SQLSTATE 23505 classifies as UniqueViolation naming table, constraint and column, never the driver's value" {
  let raw = driverErr(
    "23505",
    "duplicate key value violates unique constraint users_email_key Detail: Key (email)=(a@b.c) already exists.",
    "users_email_key",
    "email",
    "",
  )
  let e = classify(raw, "users")
  let (uv, ok) = e.(UniqueViolation)
  assert(ok, "SQLSTATE 23505 did not classify as UniqueViolation: ${e.message()}")
  assert(uv.table == "users", "table: ${uv.table}")
  assert(uv.constraint == "users_email_key", "constraint: ${uv.constraint}")
  assert(len(uv.columns) == 1 && uv.columns[0] == "email", "columns: len=${len(uv.columns)}")
  assert(
    !contains(e.message(), "a@b.c"),
    "the conflicting value leaked into the typed error: ${e.message()}",
  )
  assert(
    !contains(e.message(), "Key (email)"),
    "the driver's raw detail leaked into the typed error: ${e.message()}",
  )
}

test "23503, 23502, 23514, 40P01 and 40001 each classify as their own distinct type" {
  let fk = classify(driverErr("23503", "fk", "fk_orders_user", "user_id", "users"), "orders")
  let (fkv, fkOk) = fk.(ForeignKeyViolation)
  assert(fkOk, "23503 did not classify as ForeignKeyViolation: ${fk.message()}")
  assert(fkv.referencedTable == "users", "referencedTable: ${fkv.referencedTable}")
  assert(fkv.column == "user_id", "column: ${fkv.column}")

  let nn = classify(driverErr("23502", "nn", "", "email", ""), "users")
  let (nnv, nnOk) = nn.(NotNullViolation)
  assert(nnOk, "23502 did not classify as NotNullViolation: ${nn.message()}")
  assert(nnv.column == "email", "column: ${nnv.column}")

  let ck = classify(driverErr("23514", "ck", "positive_balance", "", ""), "accounts")
  let (ckv, ckOk) = ck.(CheckViolation)
  assert(ckOk, "23514 did not classify as CheckViolation: ${ck.message()}")
  assert(ckv.constraint == "positive_balance", "constraint: ${ckv.constraint}")

  let dl = classify(driverErr("40P01", "dl", "", "", ""), "accounts")
  let (_, dlOk) = dl.(DeadlockDetected)
  assert(dlOk, "40P01 did not classify as DeadlockDetected: ${dl.message()}")

  let sf = classify(driverErr("40001", "sf", "", "", ""), "accounts")
  let (_, sfOk) = sf.(SerializationFailure)
  assert(sfOk, "40001 did not classify as SerializationFailure: ${sf.message()}")
}

test "retryable() is true for the two transient causes and false for a constraint violation" {
  let dl = DeadlockDetected{}
  let sf = SerializationFailure{}
  let uv = UniqueViolation{ table = "users", constraint = "users_email_key", columns = ["email"] }
  assert(dl.retryable(), "DeadlockDetected must be retryable")
  assert(sf.retryable(), "SerializationFailure must be retryable")
  assert(!uv.retryable(), "UniqueViolation must not be retryable")
}

test "an unrecognised SQLSTATE passes the original error through unchanged" {
  let raw = driverErr("08006", "connection failure", "", "", "")
  let e = classify(raw, "users")
  let (fe, ok) = e.(fakeDriverError)
  assert(
    ok,
    "an unrecognised SQLSTATE must pass the original error through unchanged: ${e.message()}",
  )
  assert(fe.text == "connection failure", "message: ${fe.text}")
}

test "an error that carries no sqlState() at all passes through unchanged" {
  let raw = newError("some other failure")
  let e = classify(raw, "users")
  assert(e.message() == "some other failure", "message: ${e.message()}")
}

// The `pkg/web/errors.bit` shape, declared locally — this package must
// never import `pkg/web`. A type that satisfies it can set a client's
// response status; none of the six causes below may.
interface HttpError {
  message(): string,
  status(): int,
}

test "none of the six typed causes satisfies HttpError" {
  let uv = UniqueViolation{ table = "users", constraint = "c", columns = []string(0) }
  let fk = ForeignKeyViolation{
    table = "orders",
    constraint = "c",
    column = "user_id",
    referencedTable = "users",
  }
  let nn = NotNullViolation{ table = "users", column = "email" }
  let ck = CheckViolation{ table = "accounts", constraint = "c" }
  let dl = DeadlockDetected{}
  let sf = SerializationFailure{}
  let (_, uvOk) = uv.(HttpError)
  let (_, fkOk) = fk.(HttpError)
  let (_, nnOk) = nn.(HttpError)
  let (_, ckOk) = ck.(HttpError)
  let (_, dlOk) = dl.(HttpError)
  let (_, sfOk) = sf.(HttpError)
  assert(
    !uvOk && !fkOk && !nnOk && !ckOk && !dlOk && !sfOk,
    "a constraint cause must never satisfy HttpError",
  )
}
