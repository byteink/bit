// pkg/orm/testfields.test.bit — `fieldWithId`, a plain `@id` `FieldDesc`
// builder several test files across this module share (SPEC §17.1): schema/
// foreign-key/keyset/repo tests that build a `TableDesc`/descriptor by hand
// rather than through a real `@table` class. Was declared in
// write.test.bit, retired with that file's own old map-based `save`/
// `delete` coverage (#6296) — `fieldWithId` itself has nothing to do with
// that API and stays.
fn fieldWithId(name: string): FieldDesc {
  return FieldDesc{
    name = name,
    typeName = "i64",
    attrs = [AttrDesc{ name = "id", args = []string(0) }],
  }
}

// A canonical text form for the three `Value` variants these tests use —
// tag-prefixed so `Text("i:1")` can never collide with `Int(1)`. Reduces
// `valueEq` to one string comparison instead of a nested match per variant
// pair (LINT.md's max-complexity). Was declared in query.test.bit, retired
// with that file's own `Query<T>`/`find<T>` coverage (#6296) — generic and
// still shared by `rawsql.test.bit`/`timestamps.test.bit`.
fn valueRepr(v: Value): string {
  match (v) {
    Null => return "null"
    Int(x) => return "i:${x}"
    Float(x) => return "f:${x}"
    Bool(x) => return "bool:${x}"
    Text(x) => return "s:${x}"
    Blob(_) => return "b"
  }
}

fn valueEq(a: Value, b: Value): bool {
  return valueRepr(a) == valueRepr(b)
}

fn argsEq(got: []Value, want: []Value): bool {
  if (len(got) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(got)) {
    if (!valueEq(got[i], want[i])) {
      return false
    }
    i = i + 1
  }
  return true
}
