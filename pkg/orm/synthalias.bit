// pkg/orm/synthalias.bit — the `__` spellings the compiler's `@table`
// relation synthesis writes pkg/orm's names in (#7564).
//
// A module that imports pkg/orm gets `import { Data as __Data, ... }` from the
// compiler, so a user's own `Data`, `LinkOp` or `belongsToRelation` never
// collides with the synthesized `__loadRelation`/`__linkRelation`. This module
// IS pkg/orm: it has nothing to import, so it declares the same `__` names
// itself and the synthesis writes one spelling everywhere. Unexported: a
// consumer imports the original names and binds the alias locally. A function
// alias is a forwarding function, so a signature that drifts from its target
// fails to compile here instead of at a user's class.

type __Data = Data
type __RelationLoader<T> = RelationLoader<T>
type __LinkOp = LinkOp
type __ManyToManyDesc = ManyToManyDesc

fn __dispatchLoadRelation<T: Tabled>(
  db: Data, name: string, rows: []T, specs: map<string, RelationLoader<T>>,
): []T! {
  return dispatchLoadRelation<T>(db, name, rows, specs)?
}

fn __dispatchLinkRelation<Own: Tabled>(
  db: Data, name: string, op: LinkOp, specs: map<string, ManyToManyDesc>,
): ()! {
  return dispatchLinkRelation<Own>(db, name, op, specs)?
}

fn __relationIdColumn<T: Tabled>(): string! {
  return relationIdColumn<T>()?
}

fn __hasManyRelation<TParent: Tabled, TChild: Tabled>(
  parentKeyOf: (TParent) => i64,
  childForeignKey: string,
  assign: (TParent, []TChild) => (),
): RelationLoader<TParent> {
  return hasManyRelation<TParent, TChild>(parentKeyOf, childForeignKey, assign)
}

fn __hasOneRelation<TParent: Tabled, TChild: Tabled>(
  parentKeyOf: (TParent) => i64,
  childForeignKey: string,
  assign: (TParent, TChild) => (),
): RelationLoader<TParent> {
  return hasOneRelation<TParent, TChild>(parentKeyOf, childForeignKey, assign)
}

fn __belongsToRelation<TChild: Tabled, TParent: Tabled>(
  childForeignKeyOf: (TChild) => i64,
  assign: (TChild, TParent) => (),
): RelationLoader<TChild> {
  return belongsToRelation<TChild, TParent>(childForeignKeyOf, assign)
}

fn __manyToManyLoader<TParent, TChild>(
  parentKey: (TParent) => i64,
  desc: ManyToManyDesc,
  childMapper: (Rows) => TChild!,
  assign: (TParent, []TChild) => (),
): RelationLoader<TParent> {
  return manyToManyLoader<TParent, TChild>(parentKey, desc, childMapper, assign)
}
