// pkg/orm/jsoncol.test.bit — #5086's acceptance: a `Json` tree round-trips
// through `jsonColumnValue`/`jsonColumnRead`, a `@json` class field
// round-trips through `jsonColumnDecode<T>` with every field matching, a SQL
// NULL and a JSON null stay distinct in both directions, and invalid JSON
// bytes fail naming the column rather than reading back as an empty value.
// The DDL half of this ticket (`Json` -> `jsonb`/`json`, a string field
// unaffected) lives in postgres.test.bit/mysql.test.bit, alongside every
// other `ColumnType` variant's own DDL test.
//
// NOT A LIVE-DATABASE TEST. `jsonColumnValue`/`jsonColumnRead` round-trip
// through this package's own `jsonEncode`/`jsonParse` only — there is no
// Postgres or MySQL here to normalise whitespace, reorder keys or drop a
// duplicate one, so a passing round trip below proves this PAIR converts
// correctly, not that a live `jsonb`/`JSON` column is byte-identical on the
// way back out (jsoncol.bit's own header states plainly that a live
// database does not make that guarantee). The tree used is deliberately
// NOT already canonical — an unsorted key and a duplicate key — so that
// normalisation, if this test accidentally depended on it, would be
// visible as a mismatch rather than hidden by a value that was already in
// canonical form.

@json class JsoncolSettings {
  theme: string,
  retries: i64,
  tags: []string,
}

test "jsonColumnValue encodes a Json tree to bound text, never a SQL NULL" {
  let tree = Json.JsonObject(
    [
      JsonEntry{ key: "b", value: Json.JsonInt(2) },
      JsonEntry{ key: "a", value: Json.JsonString("x") },
      JsonEntry{ key: "a", value: Json.JsonBool(true) },
    ],
  )
  let v = jsonColumnValue(tree)
  let text = asText(v) catch e {
    panic("jsonColumnValue must always bind Value.Text: ${e.message()}")
  }
  assert(text == "{\"b\":2,\"a\":\"x\",\"a\":true}", "encoded text: ${text}")
}

test "jsonColumnValue/jsonColumnRead round-trip a non-canonical Json tree structurally" {
  let tree = Json.JsonObject(
    [
      JsonEntry{ key: "b", value: Json.JsonInt(2) },
      JsonEntry{ key: "a", value: Json.JsonString("x") },
      JsonEntry{ key: "a", value: Json.JsonBool(true) },
    ],
  )
  let v = jsonColumnValue(tree)
  let back = jsonColumnRead(v, "payload") catch e {
    panic("unexpected read failure: ${e.message()}")
  }
  assert(
    jsonEncode(back) == jsonEncode(tree),
    "round trip did not reproduce the tree: got ${jsonEncode(back)}, want ${jsonEncode(tree)}",
  )
}

test "jsonColumnDecode<T> round-trips a @json class field with every field matching" {
  let settings = JsoncolSettings{ theme: "dark", retries: 3, tags: ["alpha", "beta"] }
  let v = jsonColumnValue(settings.toJson())
  let back = jsonColumnDecode<JsoncolSettings>(v, "config") catch e {
    panic("unexpected decode failure: ${e.message()}")
  }
  assert(back.theme == settings.theme, "theme: ${back.theme}")
  assert(back.retries == settings.retries, "retries: ${back.retries}")
  assert(len(back.tags) == len(settings.tags), "tags length: ${len(back.tags)}")
  assert(back.tags[0] == settings.tags[0], "tags[0]: ${back.tags[0]}")
  assert(back.tags[1] == settings.tags[1], "tags[1]: ${back.tags[1]}")
}

// A JSON `null` is a PRESENT value, stored as the three-byte text "null" —
// never a SQL NULL. See jsoncol.bit's own header for the full NULL-versus-
// JSON-null decision this pins.
test "a JSON null is a stored value, distinct from a SQL NULL" {
  let v = jsonColumnValue(Json.JsonNull)
  let text = asText(v) catch e {
    panic("jsonColumnValue must always bind Value.Text, even for JsonNull: ${e.message()}")
  }
  assert(text == "null", "a JSON null must store the literal 'null': ${text}")

  let back = jsonColumnRead(v, "payload") catch e {
    panic("unexpected read failure: ${e.message()}")
  }
  assert(
    jsonEncode(back) == "null",
    "a stored JSON null must read back as JsonNull: ${jsonEncode(back)}",
  )
}

// A SQL NULL must never be silently read back as `Json.JsonNull` — the two
// are different values (jsoncol.bit's own header) and this is the other
// direction of the test above.
test "jsonColumnRead on a SQL NULL fails naming the column, never becomes JsonNull" {
  jsonColumnRead(Value.Null, "payload") catch e {
    assert(contains(e.message(), "payload"), "error must name the column: ${e.message()}")
    return
  }
  assert(false, "a SQL NULL must not silently become a JSON null")
}

test "jsonColumnDecode<T> on a SQL NULL fails naming the column, never becomes a zero value" {
  jsonColumnDecode<JsoncolSettings>(Value.Null, "config") catch e {
    assert(contains(e.message(), "config"), "error must name the column: ${e.message()}")
    return
  }
  assert(false, "a SQL NULL must not silently decode into a zero-value class")
}

// Invalid JSON bytes are a distinct, column-naming error — never an empty
// value that would hide a corrupted row (this ticket's own constraint).
test "jsonColumnRead on invalid JSON bytes fails naming the column, not an empty value" {
  jsonColumnRead(Value.Text("{not json"), "payload") catch e {
    assert(contains(e.message(), "payload"), "error must name the column: ${e.message()}")
    let (_, isJson) = e.(JsonColumnError)
    assert(isJson, "must be a JsonColumnError, got: ${e.message()}")
    return
  }
  assert(false, "invalid JSON bytes must fail, not return silently")
}

test "jsonColumnDecode<T> on invalid JSON bytes fails naming the column, not an empty value" {
  jsonColumnDecode<JsoncolSettings>(Value.Text("{not json"), "config") catch e {
    assert(contains(e.message(), "config"), "error must name the column: ${e.message()}")
    let (_, isJson) = e.(JsonColumnError)
    assert(isJson, "must be a JsonColumnError, got: ${e.message()}")
    return
  }
  assert(false, "invalid JSON bytes must fail, not return silently")
}

// Structurally valid JSON that does not match `JsoncolSettings`'s own
// fields is still an error naming the column — `jsonColumnDecode<T>` never
// reimplements `jsonDecode<T>`'s own field checking (jsoncol.bit's header),
// so a missing key surfaces through the same wrapper as invalid bytes do.
test "jsonColumnDecode<T> on well-formed JSON missing a required field fails naming the column" {
  jsonColumnDecode<JsoncolSettings>(Value.Text("{\"theme\":\"dark\"}"), "config") catch e {
    assert(contains(e.message(), "config"), "error must name the column: ${e.message()}")
    return
  }
  assert(false, "a document missing required fields must fail, not decode partially")
}
