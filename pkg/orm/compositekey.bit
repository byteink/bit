// pkg/orm/compositekey.bit — composite primary keys, `@id` on more than one
// field (#5084, owner decision 2026-09-12): every place this package used to
// reach through a single `@id` field now reaches through `keyFields` below,
// which is every `@id` field, in declaration order, one column or many.
//
//   @table
//   class Membership {
//     @id userId: i64
//     @id teamId: i64
//     role: string
//   }
//
//   let m = db.table<Membership>()
//   m.update(row)?    // WHERE user_id = $1 AND team_id = $2
//
// `keyFields` is read directly by `pkg/orm/write.bit` and
// `pkg/orm/reposql.bit`'s own `Repo<T>` column resolution — the one place
// that decides WHICH fields make up the key, shared rather than
// re-derived, the same "group what always travels together" reasoning
// `write.bit`'s own `TableDesc` already gives.
//
// `hasIdAttr` STAYS IN `write.bit`, UNCHANGED. `generate.bit`'s own header
// calls it "write.bit's own `hasIdAttr`, reused here" — moving it would make
// that comment name the wrong file. `keyFields` below calls it exactly the
// way `write.bit`'s old `primaryKeyField` did (same package, no import,
// SPEC §17.1).
//
// AT-MOST-ONE-GENERATED IS ENFORCED AT THE SCHEMA-BUILDER LEVEL, NOT HERE.
// This package has no per-field attribute marking a column database-
// generated — the only place that concept exists at all is `ColumnType.Id`
// (`schema.bit`), decided by whoever calls `t.id(...)` vs `t.int(...)`
// while building DDL. `validateCompositeKey` below therefore takes a
// `Table` (schema.bit's own builder tree), not a `TableDesc`/`[]FieldDesc`
// — checking the ENTITY descriptor for "generated" cannot be done honestly
// without guessing.
//
// `Query`/`Data`/`Value`/`FieldDesc` are imported by `query.bit`/`data.bit`/
// `naming.bit`, this file's siblings in the same module (SPEC §17.1); a
// second import here would be E0042. `newError` (errors.bit), `columnName`
// (naming.bit), `valueFor`/`hasIdAttr` (write.bit), `join` (query.bit),
// `columnTypeOf`/`ColumnType`/`Table` (schema.bit) likewise.

// Every field carrying `@id`, in declaration order — one column for an
// ordinary entity, more than one for a composite key. Panics naming the
// table for zero `@id` fields at all, the same category `write.bit`'s own
// `valueFor` panics for: a caller bug (a class mapped with no key at all),
// never picking a column and silently proceeding.
export fn keyFields(desc: TableDesc): []FieldDesc {
  let out = []FieldDesc(0)
  for f of desc.fields {
    if (hasIdAttr(f)) {
      out = append(out, f)
    }
  }
  if (len(out) == 0) {
    panic("pkg/orm: no field of the class mapped to '${desc.table}' carries '@id'")
  }
  return out
}

// Every key field's own name, comma-joined — what an error names when it
// must list the whole key, e.g. a composite key `upsert` cannot default
// `on` against.
fn keyFieldNames(fields: []FieldDesc): string {
  let names = []string(0)
  for f of fields {
    names = append(names, f.name)
  }
  return join(names, ", ")
}

// Every key value, rendered for an error message. A single value prints
// exactly as `valueText` (write.bit) always has — byte-identical to before
// this ticket for a plain, single-`@id` class; two or more print as
// `(v1, v2, ...)`, so a composite key's error names every column, never
// just the first.
export fn keyText(keys: []Value): string {
  if (len(keys) == 1) {
    return valueText(keys[0])
  }
  let parts = []string(0)
  for v of keys {
    parts = append(parts, valueText(v))
  }
  return "(${join(parts, ", ")})"
}

// Refuses a `Table` (schema.bit) whose composite primary key names more
// than one database-generated (`ColumnType.Id`) column — at most one may be
// database-generated; the rest must be supplied by the caller (this
// ticket's own constraint). Two generated columns in one key is not
// expressible in either dialect: each would need its own independent
// `GENERATED ALWAYS AS IDENTITY`/`AUTO_INCREMENT` sequence, so the pair
// could never collide the way a real composite key's rows must. A table
// with fewer than two `primaryKeyColumns` (the ordinary case) is never
// checked — a single `t.id(...)` already carries its own inline `primary
// key` and was never subject to this limit.
export fn validateCompositeKey(t: Table): ()! {
  if (len(t.primaryKeyColumns) < 2) {
    return
  }
  let generated = []string(0)
  for name of t.primaryKeyColumns {
    let (colType, found) = columnTypeOf(t, name)
    if (found && colType == ColumnType.Id) {
      generated = append(generated, name)
    }
  }
  if (len(generated) > 1) {
    fail newError(
      "pkg/orm: composite primary key on '${t.name}' names more than one database-generated column: ${join(
        generated,
        ", ",
      )} - at most one may be database-generated (#5084)",
    )
  }
}
