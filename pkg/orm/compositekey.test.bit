// pkg/orm/compositekey.test.bit — #5084's acceptance.
//
// `wrAdapter`/`newWrPool`/`lastWrCall` (write.test.bit), `qryAdapter`/
// `newQryPool`/`Widget`/`widgetMapper` (query.test.bit), `fieldWithId`/
// `field` (write.test.bit/naming.test.bit), `contains` (query.test.bit's own
// import) are all this file's siblings in the same module (SPEC §17.1) —
// re-declaring or re-importing any of them here would be E0042.

// A two-`@id` entity, neither field database-generated — the ticket's own
// worked example, `userId`/`teamId` both plain `i64`.
fn membershipDesc(): TableDesc {
  return TableDesc{
    table: "memberships",
    fields: [fieldWithId("userId"), fieldWithId("teamId"), field("role")],
    classAttrs: []AttrDesc(0),
  }
}

fn membershipValues(userId: i64, teamId: i64, role: string): map<string, Value> {
  return map<string, Value>{
    "userId": Value.Int(userId), "teamId": Value.Int(teamId), "role": Value.Text(role),
  }
}

class Membership { userId: i64, teamId: i64, role: string }

fn membershipMapper(rows: Rows): Membership! {
  let cols = rows.columns()
  return Membership{
    userId: sqlReqInt(rows, cols, "user_id")?,
    teamId: sqlReqInt(rows, cols, "team_id")?,
    role: "",
  }
}

// ---- the builder: a composite primary key renders as a table-level clause -

test "table(): a composite primary key renders as a table-level constraint, in declaration order" {
  let op = table("memberships", (t) => {
    t.int("user_id")
    t.int("team_id")
    t.string("role", 50)
    t.primaryKey("user_id", "team_id")
  })
  let stmts = Postgres{}.render(op)
  assert(
    contains(stmts[0].sql, "primary key (\"user_id\", \"team_id\")"),
    "DDL must carry a composite primary key in declaration order: ${stmts[0].sql}",
  )
  assert(
    !contains(stmts[0].sql, "\"user_id\" bigint not null primary key"),
    "user_id must not carry its own inline primary key: ${stmts[0].sql}",
  )
}

// A single-column key is still `t.id`'s own inline `primary key` — this
// ticket's builder addition never touches that path.
test "table(): a single-column key stays t.id's own inline primary key, unchanged" {
  let op = table("widgets", (t) => {
    t.id("id")
  })
  let stmts = Postgres{}.render(op)
  assert(
      stmts[0].sql ==
      "create table \"widgets\" (\n  \"id\" bigint generated always as identity primary key\n);",
    "single-@id DDL must be byte-identical to before this ticket: ${stmts[0].sql}",
  )
}

// ---- save/delete: the WHERE names every key column ------------------------

test "save on a persisted composite-key entity emits an UPDATE whose WHERE names both key columns" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)
  let values = membershipValues(1, 2, "admin")

  save(p, membershipDesc(), values, true) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  let want = "update memberships set user_id = $1, team_id = $2, role = $3 where user_id = $4 and team_id = $5"
  assert(lastWrCall(a).sql == want, "got: ${lastWrCall(a).sql}")
}

test "delete on a composite-key entity emits a DELETE naming both key columns" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)
  let values = membershipValues(1, 2, "admin")

  delete(p, membershipDesc(), values) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(
    lastWrCall(a).sql == "delete from memberships where user_id = $1 and team_id = $2",
    "got: ${lastWrCall(a).sql}",
  )
}

// A single-@id entity's UPDATE/DELETE stay exactly what `write.test.bit`
// already proves — restated here so this ticket's own acceptance ("a
// single-@id entity's emitted SQL is byte-identical to before this change")
// has its own explicit check, not just an unbroken pre-existing test.
test "save/delete on a single-@id entity emit the exact same SQL as before this ticket" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)
  let u = Account{ id: 7, name: "Ada", email: "ada@x.com" }
  u.markPersisted(true)

  save(p, accountDesc(), accountValues(u), u.isPersisted()) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    lastWrCall(a).sql == "update accounts set id = $1, name = $2, email = $3 where id = $4",
    "got: ${lastWrCall(a).sql}",
  )

  let a2 = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p2 = newWrPool(a2)
  delete(p2, accountDesc(), accountValues(u)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(lastWrCall(a2).sql == "delete from accounts where id = $1", "got: ${lastWrCall(a2).sql}")
}

// ---- byKey: every part required, or a refusal before any statement --------

test "byKey with only one of two composite key parts is refused, naming the missing field, with zero statements issued" {
  let a = qryAdapter{ calls: []qryCall(0), cols: []string(0), rows: [][]Value(0) }
  let p = newQryPool(a)
  let q = find<Membership>(p, "memberships", membershipDesc().fields, membershipMapper)

  byKey<Membership>(q, membershipDesc(), map<string, Value>{ "userId": Value.Int(1) }) catch e {
    assert(contains(e.message(), "teamId"), "must name the missing field: ${e.message()}")
    assert(len(a.calls) == 0, "must issue zero statements before failing, got ${len(a.calls)}")
    return
  }
  assert(false, "byKey with a partial composite key must be refused")
}

test "byKey with every key part narrows the query on every key column" {
  let a = qryAdapter{ calls: []qryCall(0), cols: []string(0), rows: [][]Value(0) }
  let p = newQryPool(a)
  let q = find<Membership>(p, "memberships", membershipDesc().fields, membershipMapper)

  let narrowed = byKey<Membership>(
    q, membershipDesc(), map<string, Value>{ "userId": Value.Int(1), "teamId": Value.Int(2) },
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  narrowed.all() catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  assert(
    contains(lastCall(a).sql, "user_id = $1") && contains(lastCall(a).sql, "team_id = $2"),
    "got: ${lastCall(a).sql}",
  )
}

// ---- the FK renderer: a reference to a composite key ----------------------

test "a foreign key referencing a composite primary key emits both columns on both sides, in the referenced key's own order" {
  let op = table("membership_notes", (t) => {
    t.int("user_id")
    t.int("team_id")
    t.text("note")
    t.foreign("user_id", "team_id").references("memberships", "user_id", "team_id")
  })
  let stmts = Postgres{}.render(op)
  assert(
    contains(
      stmts[0].sql,
      "foreign key (\"user_id\", \"team_id\") references \"memberships\" (\"user_id\", \"team_id\")",
    ),
    "got: ${stmts[0].sql}",
  )
}

// A single-column foreign key's own constraint name and clause stay exactly
// what `schema.test.bit`/`postgres.test.bit` already prove - this file
// checks the composite-column-count case does not perturb it.
test "a single-column foreign key's constraint name is unaffected by the composite FK path" {
  let op = table("orders", (t) => {
    t.int("team_id")
    t.foreign("team_id").references("teams", "id")
  })
  let stmts = Postgres{}.render(op)
  assert(
    contains(
      stmts[0].sql,
      "constraint \"orders_team_id_fkey\" foreign key (\"team_id\") references \"teams\" (\"id\")",
    ),
    "got: ${stmts[0].sql}",
  )
}

// ---- at most one database-generated column in a composite key -------------

test "a composite primary key naming two database-generated columns is refused, naming both" {
  let t = Table{
    name: "memberships", columns: []Column(0), indexes: []Index(0),
    foreignKeys: []ForeignKey(0), raws: []string(0), primaryKeyColumns: []string(0),
  }
  t.id("user_id")
  t.id("team_id")
  t.primaryKey("user_id", "team_id")

  validateCompositeKey(t) catch e {
    assert(contains(e.message(), "user_id"), "must name the first generated column: ${e.message()}")
    assert(
      contains(e.message(), "team_id"),
      "must name the second generated column: ${e.message()}",
    )
    return
  }
  assert(false, "two database-generated columns in one composite key must be refused")
}

test "a composite primary key naming at most one database-generated column is accepted" {
  let t = Table{
    name: "memberships", columns: []Column(0), indexes: []Index(0),
    foreignKeys: []ForeignKey(0), raws: []string(0), primaryKeyColumns: []string(0),
  }
  t.id("id")
  t.int("team_id")
  t.primaryKey("id", "team_id")

  validateCompositeKey(t) catch e {
    assert(
      false,
      "one generated column among several supplied ones must be accepted: ${e.message()}",
    )
    return
  }
}
