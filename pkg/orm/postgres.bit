// pkg/orm/postgres.bit — Postgres, the first `Dialect` (#5066).
//
// TYPE MAPPING FOLLOWS SCHEMA.BIT'S OWN VOCABULARY, NOT A WIDER ONE.
// `ColumnType` (schema.bit) has eight variants — `Id`, `Int`,
// `String(length)`, `Text`, `Bool`, `Timestamp`, `Decimal`, `Json` — and its
// own header explains why `Int` stays single: "`int` is Bit's only integer
// size in ordinary use... one `int` column, not Laravel's
// `integer`/`bigInteger` split - a dialect maps it to whichever integer
// type it stores 64 bits in." So `Int` here renders `bigint`, once.
// `Timestamp` renders `timestamptz`, never a bare `timestamp` — an instant
// read from a zoneless column is invented (#3986). There is still no
// `i32`, `[]byte` or `Date`-without-time variant to render — schema.bit's
// header and `docs/schema.md` name each and say why (#5326).
//
// `JSON` RENDERS `jsonb`, NEVER BARE `json` (#5086). Postgres' own `json`
// type stores the original text verbatim — whitespace, key order and
// duplicate keys all survive — and cannot be indexed usefully; `jsonb`
// normalises on write and is what every index and the `->`/`->>` operators
// (out of scope here, `pkg/orm/jsoncol.bit`'s own header) are built for.
// `t.json(...)` (schema.bit) is the one builder for both a `Json` tree field
// and a `@json` class field — the DDL is identical either way, so `pgType`
// below needs no second branch to tell them apart.
//
// `Decimal` RENDERS PLAIN `numeric`, WITH NO PRECISION OR SCALE. Bit's
// `decimal` is 128-bit and holds roughly 28 significant digits at
// whatever scale the value itself carries (#3980) — it is not a
// fixed-scale type the way a hand-picked `numeric(p,s)` column is. A
// bounded `numeric(38,9)` would silently round away any value needing
// more than 9 fractional digits or more than 29 integer digits, which is
// exactly the kind of silent money error #3980 was written to close.
// Postgres' own unconstrained `numeric` stores the exact value with no
// precision or scale ceiling of its own, so it is the only mapping that
// cannot truncate a legal Bit `decimal`.
//
// IDENTIFIERS ARE ALWAYS QUOTED AND ESCAPED. Every identifier this file
// emits — table name, column name, a generated index or constraint name,
// a foreign key's referenced table and column — goes through `quoteIdent`,
// which double-quotes and doubles any embedded `"` (the standard SQL
// escape for a quoted identifier, closing the injection vector rather than
// rejecting specific characters). None of that input is trusted: `table`/
// `alter` (schema.bit) take plain strings straight from whoever wrote the
// migration, not necessarily the output of `naming.bit`'s snake_case
// conversion — that conversion only runs for a `@table` class's reflected
// descriptor (a completely different call path, pkg/orm/naming.bit), never
// for a hand-written `table("...", ...)` call. `raw()`'s text is the one
// exception, by design: it is passed to SQL verbatim, unquoted, unescaped
// — the single place this file knowingly suspends that guarantee, exactly
// as schema.bit's own header documents `raw()` to be.
//
// NO VALUE IS EVER RENDERED. schema.bit carries no default-value builder
// yet, so there is nothing here that interpolates caller data into DDL —
// this file's only job is identifiers and the fixed keywords a `ColumnType`/
// `AlterOp`/`ReferentialAction` tag maps to.

// `join` is not imported here — query.bit already imports it, and a Bit
// import binds package-wide (a second import of the same name anywhere in
// pkg/orm is `E0042 already declared in this scope`, confirmed against
// this exact pair while building this file). `contains` (below, used by
// `rawStatement`'s `CONCURRENTLY` check) IS imported here: this file is
// its canonical import site in the module (#5589).
import { contains, replace, toUpper } from "std/strings"

// Postgres, the first `Dialect` implementation.
export class Postgres {
  export render(op: SchemaOp): []Statement {
    match (op) {
      CreateTable(t) => return renderCreateTable(t)
      AlterTable(t) => return renderAlterTable(t)
      DropTable(name) => return [dropTableStatement(name)]
    }
  }
}

// `CREATE TABLE`, then one `CREATE INDEX` per `t.index()`, then each
// `raw()` passthrough, in declaration order — see dialect.bit's header for
// why these are separate `Statement`s rather than one blob.
fn renderCreateTable(t: Table): []Statement {
  validateCompositeKey(t) catch e {
    panic(e.message())
  }
  let defs = []string(0)
  for c of t.columns {
    defs = append(defs, columnDef(c, inPrimaryKey(t, c.name)))
  }
  for fk of t.foreignKeys {
    defs = append(defs, foreignKeyDef(t.name, fk))
  }
  if (len(t.primaryKeyColumns) > 0) {
    defs = append(defs, primaryKeyDef(t.primaryKeyColumns))
  }
  let body = join(defs, ",\n  ")
  let sql = "create table ${quoteIdent(t.name)} (\n  ${body}\n);"
  let stmts = [Statement{ sql: sql, transactional: true }]
  for ix of t.indexes {
    stmts = append(stmts, indexStatement(t.name, ix))
  }
  for r of t.raws {
    stmts = append(stmts, rawStatement(r))
  }
  return stmts
}

// One `ALTER TABLE` statement per `AlterOp`, then each `raw()`
// passthrough. Never batched into one multi-clause `ALTER TABLE` — keeping
// one statement per op keeps a `RenameColumn` (or any op) individually
// retryable and matches schema.bit's own one-node-per-change shape.
fn renderAlterTable(t: AlterTable): []Statement {
  let stmts = []Statement(0)
  for op of t.ops {
    stmts = append(stmts, alterOpStatement(t.name, op))
  }
  for r of t.raws {
    stmts = append(stmts, rawStatement(r))
  }
  return stmts
}

fn alterOpStatement(table: string, op: AlterOp): Statement {
  match (op) {
    AddColumn(c) => return Statement{
      sql: "alter table ${quoteIdent(table)} add column ${columnDef(c, false)};",
      transactional: true,
    }
    DropColumn(name) => return Statement{
      sql: "alter table ${quoteIdent(table)} drop column ${quoteIdent(name)};",
      transactional: true,
    }
    RenameColumn(oldName, newName) => return Statement{
      sql: "alter table ${quoteIdent(table)} rename column ${quoteIdent(oldName)} to ${quoteIdent(newName)};",
      transactional: true,
    }
    SetPrimaryKey(columns) => return setPrimaryKeyStatement(table, columns)
    ReplacePrimaryKey(columns) => return setPrimaryKeyStatement(table, columns)
  }
}

// Drops and re-adds `table`'s own default-named primary key constraint in
// ONE statement (#5397) - Postgres names an unnamed primary key
// "<table>_pkey" whether it came from `Table.id()`'s inline clause or
// `primaryKeyDef`'s own table-level one (both untouched by this file), so
// dropping and re-adding it by that name is safe to assume rather than
// guessed. `drop constraint if exists` covers a table with no primary key
// yet; combined with the `add constraint` in the same statement rather than
// a second one, Postgres validates the WHOLE clause against the table's
// final shape, never an intermediate state a two-statement version could
// leave briefly keyless. Both `AlterOp.SetPrimaryKey` and `AlterOp.
// ReplacePrimaryKey` render through here identically (#5400) - `IF EXISTS`
// already covers both "no key yet" and "replacing one", which is exactly
// what MySQL cannot do in one statement (mysql.bit's own header) and why
// that dialect needs the two ops to render differently.
fn setPrimaryKeyStatement(table: string, columns: []string): Statement {
  let quoted = []string(0)
  for c of columns {
    quoted = append(quoted, quoteIdent(c))
  }
  let name = quoteIdent("${table}_pkey")
  let sql = "alter table ${quoteIdent(table)} drop constraint if exists ${name}, " +
    "add constraint ${name} primary key (${join(quoted, ", ")});"
  return Statement{ sql: sql, transactional: true }
}

fn dropTableStatement(name: string): Statement {
  return Statement{ sql: "drop table ${quoteIdent(name)};", transactional: true }
}

// The migration for an enum column's variant list changing (#5082): drops
// the old named CHECK constraint and adds it back with `variants`' new
// list, in ONE statement — the same drop-then-add-in-one-statement shape
// `setPrimaryKeyStatement` above already uses, and for the identical
// reason: Postgres validates `add constraint` against the table's FINAL
// shape, so a row still holding a removed variant fails the whole
// statement loudly (`errors.bit`'s own `CheckViolation`, SQLSTATE 23514)
// rather than leaving the table briefly without any constraint at all.
// Adding a variant and removing one both render through here — it is
// always "the new full list" — since a CHECK constraint has no per-value
// add/drop syntax to begin with; `enumcol.bit`'s `enumVariantsChanged` is
// what a caller checks first, so a reorder (the same set, given in a
// different order) never reaches this function at all (`enumcol.bit`'s own
// header on "reordering emits nothing"). `column` is a `@table` field's own
// name and, like `enumColumnDef` (`enumcol.bit`'s header), left unquoted on
// purpose inside the CHECK's own `in (...)` clause; the constraint's own
// generated name and the table are quoted, the same as every other
// identifier this file emits.
export fn enumCheckAlter(table: string, column: string, variants: []string): Statement {
  let name = quoteIdent(enumCheckName(table, column))
  let sql = "alter table ${quoteIdent(table)} drop constraint ${name}, " +
    "add constraint ${name} check (${column} in (${enumVariantList(variants)}));"
  return Statement{ sql: sql, transactional: true }
}

// One column's definition inside a `CREATE TABLE`/`ADD COLUMN`. `Id` is
// `bigint generated always as identity primary key` — never `serial`,
// which Postgres' own docs discourage and which leaves a sequence with
// separate ownership — and returns early: an identity primary key needs no
// `not null`/`unique` suffix regardless of what `Column.isNullable`/
// `isUnique` happen to hold on that node. `inCompositeKey` is true only when
// `c.name` is one of `Table.primaryKeyColumns` (#5084) — that column's own
// `primary key` moves to the table-level `primary key (...)` clause
// `renderCreateTable` appends instead, so the two never both declare one
// (Postgres rejects a table naming a primary key twice).
fn columnDef(c: Column, inCompositeKey: bool): string {
  if (c.colType == ColumnType.Id) {
    if (inCompositeKey) {
      return "${quoteIdent(c.name)} bigint generated always as identity"
    }
    return "${quoteIdent(c.name)} bigint generated always as identity primary key"
  }
  let parts = [quoteIdent(c.name), pgType(c.colType)]
  if (!c.isNullable) {
    parts = append(parts, "not null")
  }
  if (c.isUnique) {
    parts = append(parts, "unique")
  }
  return join(parts, " ")
}

// Whether `name` is one of `t.primaryKeyColumns` — an empty
// `primaryKeyColumns` (the ordinary, non-composite table) answers false for
// every column, so `columnDef` above renders exactly as it always has.
fn inPrimaryKey(t: Table, name: string): bool {
  for c of t.primaryKeyColumns {
    if (c == name) {
      return true
    }
  }
  return false
}

// `primary key (col1, col2, ...)`, in `columns`'s own order — the
// table-level constraint a composite key needs (#5084); a single-column key
// never reaches this, since `Table.id`'s own inline `primary key` already
// covers that case and `primaryKeyColumns` stays empty for it.
fn primaryKeyDef(columns: []string): string {
  let quoted = []string(0)
  for c of columns {
    quoted = append(quoted, quoteIdent(c))
  }
  return "primary key (${join(quoted, ", ")})"
}

// `ColumnType` -> Postgres type keyword. See this file's header for why
// there is exactly one branch per variant and no wider mapping.
fn pgType(colType: ColumnType): string {
  match (colType) {
    Id => return "bigint"
    Int => return "bigint"
    String(length) => return "varchar(${length})"
    Text => return "text"
    Bool => return "boolean"
    Timestamp => return "timestamptz"
    Decimal => return "numeric"
    Json => return "jsonb"
  }
}

// `CONSTRAINT ... FOREIGN KEY (...) REFERENCES ...(...)`, named
// `<table>_<col1>_<col2>_fkey` (Postgres' own naming convention, extended to
// every column for a composite reference, #5084). Panics naming the columns
// and table when `references(...)` was never called, or named a different
// number of columns than `foreign(...)` did — schema.bit builds that node
// but deliberately leaves it "a structurally incomplete node rather than a
// builder-time failure" (schema.bit's own header): the dialect is where a
// missing or mismatched target must surface, and a panic (a caller bug, not
// recoverable data) is the same category `pkg/orm/write.bit`'s own
// `valueFor` already panics for. `columns`/`refColumns` are rendered in
// their own given order on both sides, never reordered — matching the
// referenced key's own column order is the caller's job (`ForeignKey`'s own
// header on #5084).
fn foreignKeyDef(table: string, fk: ForeignKey): string {
  if (fk.refTable == "" || len(fk.refColumns) == 0) {
    panic("pkg/orm: foreign key on '${join(fk.columns, ", ")}' of '${table}' has no references(...) target")
  }
  if (len(fk.columns) != len(fk.refColumns)) {
    panic("pkg/orm: foreign key on '${join(fk.columns, ", ")}' of '${table}' names ${len(fk.columns)} column(s) but references(...) named ${len(fk.refColumns)}")
  }
  let name = quoteIdent("${table}_${join(fk.columns, "_")}_fkey")
  let cols = []string(0)
  for c of fk.columns {
    cols = append(cols, quoteIdent(c))
  }
  let refCols = []string(0)
  for c of fk.refColumns {
    refCols = append(refCols, quoteIdent(c))
  }
  let clause = "constraint ${name} foreign key (${join(cols, ", ")}) references ${quoteIdent(fk.refTable)} (${join(
    refCols,
    ", ",
  )})"
  let action = onDeleteClause(fk.onDeleteAction)
  if (action != "") {
    return clause + " " + action
  }
  return clause
}

fn onDeleteClause(action: ReferentialAction): string {
  match (action) {
    NoAction => return ""
    Cascade => return "on delete cascade"
    Restrict => return "on delete restrict"
    SetNull => return "on delete set null"
  }
}

// `CREATE INDEX <table>_<cols>_idx ON <table> (<cols>)`, always
// transactional — `t.index()` has no `CONCURRENTLY` option; only `raw()`
// can ask for one (schema.bit's header).
fn indexStatement(table: string, ix: Index): Statement {
  let cols = []string(0)
  for c of ix.columns {
    cols = append(cols, quoteIdent(c))
  }
  let name = quoteIdent(indexName(table, ix.columns))
  let colList = join(cols, ", ")
  let sql = "create index ${name} on ${quoteIdent(table)} (${colList});"
  return Statement{ sql: sql, transactional: true }
}

fn indexName(table: string, columns: []string): string {
  let parts = [table]
  for c of columns {
    parts = append(parts, c)
  }
  parts = append(parts, "idx")
  return join(parts, "_")
}

// A `raw()` passthrough, unquoted and unescaped by design (this file's
// header) — flagged non-transactional exactly when its text names
// `CREATE INDEX CONCURRENTLY`, case-insensitively, since that is the only
// statement shape schema.bit's builders can produce that Postgres refuses
// to run inside a transaction.
fn rawStatement(text: string): Statement {
  return Statement{ sql: text, transactional: !contains(toUpper(text), "CONCURRENTLY") }
}

// A SQL identifier, double-quoted with any embedded `"` doubled — the
// standard escape for a quoted Postgres identifier. This is the only
// quoting this file performs; see this file's header for why every
// identifier goes through it and why `raw()` alone does not.
fn quoteIdent(name: string): string {
  let escaped = replace(name, "\"", "\"\"")
  return "\"${escaped}\""
}
