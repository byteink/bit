@table("sustamps") @timestamps class SUStamp {
  id: i64,
  body: string,
  createdAt: i64,
  updatedAt: i64,
}

fn suFiltered(d: ServerDialect): ()! {
  let a = newRawAdapter()
  a.affected = 2
  let g = sbPolicy(2)
  let base = sbDb(a, d, g).as(srUser{ id = "u7" }, "acme").table<SPost>()
  let chain = base.where("body", "outline").set("body", "reviewed").orderBy("id").limit(5)
  let before = srArgsText(chain.inner.args)
  assert(chain.updateAll()? == 2, "return actual affected rows")
  assert(
      a.execs[0].sql ==
      "update sposts set body = $2 where body = $1 and (author_id = $3 or author_id = $4)",
    "Update filter must follow caller predicates",
  )
  assert(srArgsText(a.execs[0].args) == "toutline,treviewed,i7,i9", "argument order changed")
  assert(g.actor == "u7" && g.op == GuardOp.Update && g.first == 3, "guard context changed")
  assert(g.columnCalls == 2 && chain.tenant == "acme", "both rule operations must be checked")
  assert(len(base.inner.sets) == 0 && len(base.setColumns) == 0, "set mutated the source chain")
  assert(srArgsText(chain.inner.args) == before, "terminal mutated its argument chain")
  assert(chain.updateAll()? == 2 && g.asked == 2, "repeat must preserve source query")
}

test "scoped bulk update applies Update filter on both dialects" {
  for d of [srPostgres(), srMysql()] {
    suFiltered(d) catch e {
      panic(e.message())
    }
  }
}

fn suMode(d: ServerDialect, mode: int): ()! {
  let a = newRawAdapter()
  a.affected = 3
  let g = sbPolicy(mode)
  let changed = sbDb(a, d, g).asGuest().table<SPost>().where("body", "old").set("body", "new").updateAll() catch _ {
    assert(mode == 3 && len(a.execs) == 0, "filter error must fail closed")
    return
  }
  assert(mode != 3, "guard error was swallowed")
  if (mode == 1) {
    assert(changed == 0 && len(a.execs) == 0, "None must run no SQL")
    return
  }
  assert(changed == 3 && len(a.execs) == 1, "All must preserve affected count")
  assert(a.execs[0].sql == "update sposts set body = $2 where body = $1", "All widened the caller")
}

fn suModes(d: ServerDialect): ()! {
  for mode of [0, 1, 3] {
    suMode(d, mode)?
  }
}

test "scoped bulk update All None and error are fail closed on both dialects" {
  for d of [srPostgres(), srMysql()] {
    suModes(d) catch e {
      panic(e.message())
    }
  }
}

fn suRuleColumns(d: ServerDialect) {
  for op of [GuardOp.Update, GuardOp.Delete] {
    let a = newRawAdapter()
    let g = sbPolicy(0)
    g.ruleOp = op
    g.ruleColumns = ["authorId"]
    let base = sbDb(a, d, g).as(srUser{ id = "u7" }).table<SPost>()
    let refused = false
    base.set("authorId", 9).where("id", 1).orderBy("id").updateAll() catch e {
      refused = e.message() == "denied"
    }
    assert(refused && len(a.execs) == 0 && g.asked == 0, "a rule input must not be written")
    assert(len(base.setColumns) == 0, "rule-column refusal changed base metadata")
    let stampGuard = sbPolicy(0)
    stampGuard.ruleOp = op
    stampGuard.ruleColumns = ["updatedAt"]
    refused = false
    sbDb(a, d, stampGuard).asGuest().table<SUStamp>().where("id", 1).set("body", "new").updateAll() catch e {
      refused = e.message() == "denied"
    }
    assert(refused && len(a.execs) == 0, "automatic timestamps must respect rule columns")
  }
}

test "scoped bulk update refuses Update and Delete rule columns including timestamps" {
  for d of [srPostgres(), srMysql()] {
    suRuleColumns(d)
  }
}

fn suColumnError(d: ServerDialect) {
  let a = newRawAdapter()
  let g = sbPolicy(0)
  g.ruleError = true
  let failed = false
  sbDb(a, d, g).asGuest().table<SPost>().where("id", 1).set("body", "new").updateAll() catch e {
    failed = e.message() == "denied"
  }
  assert(failed && len(a.execs) == 0 && g.asked == 0, "rule introspection error must fail closed")
}

test "scoped bulk update propagates rule introspection errors before SQL" {
  for d of [srPostgres(), srMysql()] {
    suColumnError(d)
  }
}

fn suInvalid(d: ServerDialect) {
  let a = newRawAdapter()
  let g = sbPolicy(0)
  let base = sbDb(a, d, g).asGuest().table<SPost>()
  let failed = false
  base.set("body", "new").updateAll() catch e {
    failed = contains(e.message(), "has no where()")
  }
  assert(failed && g.columnCalls == 0 && g.asked == 0, "bare update must precede the guard")
  failed = false
  base.where("id", 1).updateAll() catch e {
    failed = contains(e.message(), "no set()")
  }
  assert(failed && g.columnCalls == 0, "empty update must precede the guard")
  failed = false
  base.where("id", 1).set("missing", 9).updateAll() catch e {
    failed = contains(e.message(), "missing")
  }
  assert(failed && g.columnCalls == 0 && len(a.execs) == 0, "invalid set must precede the guard")
}

test "scoped bulk update validates caller safety and set columns before policy" {
  for d of [srPostgres(), srMysql()] {
    suInvalid(d)
  }
}

fn suPassthrough(d: ServerDialect): ()! {
  let a = newRawAdapter()
  a.affected = 4
  let g = sbPolicy(3)
  assert(
    sbDb(a, d, g).asGuest().table<SwPost>().where("id", 1).set("body", "new").updateAll()? == 4,
    "unprotected update differs",
  )
  assert(g.asked == 0 && g.columnCalls == 0, "unprotected table consulted the guard")
  let db = Db{ pool = newRawPool(a), dialect = d }
  assert(
    db.asGuest().table<SPost>().where("id", 1).set("body", "new").updateAll()? == 4,
    "unguarded update differs",
  )
}

test "scoped bulk update preserves unprotected and unguarded passthrough" {
  for d of [srPostgres(), srMysql()] {
    suPassthrough(d) catch e {
      panic(e.message())
    }
  }
}

const suLiveMain = `fn main(): ()! {
  let db = open(args()[1], Options{ authz = Owner{} })?
  defer db.pool.close()
  db.exec("drop table if exists suposts")?
  db.exec(args()[2])?
  defer { db.exec("drop table suposts") catch e { panic(e.message()) } }
  let sys = db.asSystem().table<SPost>()
  let i = 0
  while (i < 5) {
    let owner = i64(8)
    if (i < 2) { owner = i64(7) }
    sys.insert(SPost{ id = 0, authorId = owner, body = "outline" })?
    i = i + 1
  }
  let mine = db.as(Me{ id = "7" }).table<SPost>()
  let chain = mine.where("body", "outline").set("body", "reviewed")
  assert(chain.updateAll()? == 2, "update exactly two visible rows")
  assert(sys.where("authorId", 7).where("body", "reviewed").count()? == 2, "visible rows changed")
  assert(sys.where("authorId", 8).where("body", "outline").count()? == 3, "denied rows unchanged")
  assert(chain.updateAll()? == 0, "query chain must preserve original predicates")
  let refused = false
  mine.where("body", "reviewed").set("authorId", 8).updateAll() catch e {
    refused = e.message() == "denied"
  }
  assert(refused, "rule-column update must be denied")
  assert(sys.where("authorId", 7).count()? == 2, "refused write changed owner")
  assert(sys.where("authorId", 8).count()? == 3, "denied rows changed after refusal")
  print("LIVE_BULK_UPDATE_OK changed=2 denied=3 preserved=5")
}
`

fn suLiveProgram(): string {
  let prefix = split(sbLiveSource, "fn main(): ()! {")[0]
  prefix = replace(prefix, "sbposts", "suposts")
  let oldFilter = "if (op == GuardOp.Delete)"
  assert(contains(prefix, oldFilter), "shared live guard filter changed")
  prefix = replace(prefix, oldFilter, "if (op == GuardOp.Delete || op == GuardOp.Update)")
  let oldColumns = "columnsInRules(actor: Actor, op: GuardOp, table: string): []string! { return []string(0) }"
  assert(contains(prefix, oldColumns), "shared live rule-column guard changed")
  prefix = replace(
    prefix, oldColumns,
    "columnsInRules(actor: Actor, op: GuardOp, table: string): []string! { return [\"authorId\"] }",
  )
  return prefix + suLiveMain
}

test "live: scoped bulk update changes only visible rows on Postgres" {
  sbRunLiveSource(
    "ORM_TEST_LIVE_PG_URI", "updatepg",
    "create table suposts (id bigint generated always as identity primary key, author_id bigint not null, body text not null)",
    suLiveProgram(),
  )
}

test "live: scoped bulk update changes only visible rows on MySQL" {
  sbRunLiveSource(
    "ORM_TEST_LIVE_MYSQL_URI", "updatemysql",
    "create table suposts (id bigint auto_increment primary key, author_id bigint not null, body text not null)",
    suLiveProgram(),
  )
}
