// pkg/orm/generate.test.bit — #5067's acceptance, against a FAKE driver
// returning a known information_schema shape (`gnExecutor` below), plus a
// real `bit check` subprocess in the last test for the one clause that has
// to prove the file this package writes actually compiles.
//
// `gnExecutor.columnsByTable` IS the fake "live schema": `query` reads the
// table name straight off the one bound param every call in `generate.bit`
// sends, and hands back a canned column list — there is no SQL parsing
// here, on purpose, since the acceptance is about the DIFF, not about this
// fake understanding SQL. `primaryKeyTables` is the same idea for
// `hasLivePrimaryKey`'s own `information_schema.table_constraints` query
// (#5400): `query` branches on the SQL text naming that view (never parsed,
// just checked with `contains`) and returns a non-empty `gnRows` only when
// the table is listed.
import { run } from "std/os"
import { cwd, remove } from "std/fs"

class gnExecutor {
  columnsByTable: map<string, []string>
  primaryKeyTables: []string

  query(sqlText: string, params: []Value): Rows! {
    let table = asText(params[0]) catch _ {
      ""
    }
    if (contains(sqlText, "table_constraints")) {
      let cols = []string(0)
      if (hasColumn(this.primaryKeyTables, table)) {
        cols = ["PRIMARY"]
      }
      return gnRows{ cols: cols, i: -1 }
    }
    return gnRows{ cols: this.columnsByTable[table], i: -1 }
  }

  exec(sqlText: string, params: []Value): int! {
    fail newError("gnExecutor: exec not supported; generate never writes")
  }
}

// Walks the canned column list once — `information_schema.columns` read
// one row at a time, exactly like a real driver's `Rows`.
class gnRows {
  cols: []string
  i: i64

  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.cols)
  }

  columns(): []string {
    return ["column_name"]
  }

  value(col: int): Value {
    return Value.Text(this.cols[this.i])
  }

  close() {}
}

@table("widgets") class gnWidget {
  @id
  id: i64
  name: string
}

@table("widgets") class gnWidgetWithPhone {
  @id
  id: i64
  name: string
  phone: string
}

@table("widgets") class gnWidgetIdOnly {
  @id
  id: i64
}

@table("widgets") class gnWidgetRenamed {
  @id
  id: i64
  newName: string
}

// Two `@id` fields - a composite primary key (#5084), used to prove
// `generateInto` refuses rather than mapping both through `t.addId(...)`
// (#5395).
@table("widgets") class gnWidgetComposite {
  @id
  id: i64
  @id
  teamId: i64
  name: string
}

// Two sides of a `@manyToMany("user_roles")` relation (#5390) — both passed
// to `generateInto` together, the shape the acceptance test names: neither
// class alone carries enough to build the join table (this file's own
// header on `manyToManyDescsFor`).
@table("gn_users") class gnUser {
  @id
  id: i64
  @manyToMany("user_roles")
  roles: []gnRole
}

@table("gn_roles") class gnRole {
  @id
  id: i64
  @manyToMany("user_roles")
  users: []gnUser
}

// A fresh, empty scratch directory under $TMPDIR for one test — never
// reused across a stale run, since a leftover file from a killed prior
// run would corrupt a numbering assertion.
fn scratchDir(label: string): string {
  let dir = "${envOr("TMPDIR", "/tmp")}/task5067-${label}"
  resetDir(dir)
  return dir
}

fn resetDir(dir: string) {
  if (!exists(dir)) {
    return
  }
  let names = readDir(dir) catch _ {
    []string(0)
  }
  for n of names {
    remove("${dir}/${n}") catch _ {}
  }
  remove(dir) catch _ {}
}

fn onlyFile(dir: string): string {
  let names = readDir(dir) catch e {
    panic("readDir(${dir}): ${e.message()}")
  }
  assert(
    len(names) == 1,
    "expected exactly one file in ${dir}, found ${len(names)}: ${join(names, ", ")}",
  )
  return readFile("${dir}/${names[0]}") catch e {
    panic("readFile: ${e.message()}")
  }
}

test "an entity with one extra field produces exactly one addColumn call and nothing else" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["id", "name"] } }
  let dir = scratchDir("addonly")
  generateInto(db, [gnWidgetWithPhone{}], "add_phone", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(contains(content, "t.addString(\"phone\", 255)"), "missing the add call: ${content}")
  assert(count(content, "  t.add") == 1, "expected exactly one add call: ${content}")
  assert(!contains(content, "t.dropColumn("), "unexpected dropColumn call: ${content}")
  assert(!contains(content, "t.renameColumn("), "unexpected renameColumn call: ${content}")
}

test "a column missing from the entity produces a dropColumn call marked destructive" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["id", "legacy_flag"] } }
  let dir = scratchDir("droponly")
  generateInto(db, [gnWidgetIdOnly{}], "drop_legacy", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(contains(content, "t.dropColumn(\"legacy_flag\")"), "missing the drop call: ${content}")
  assert(contains(content, "destructive"), "drop comment does not say destructive: ${content}")
  assert(count(content, "  t.add") == 0, "unexpected add call: ${content}")
}

test "one added and one removed column produce both ops and no renameColumn" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["id", "old_name"] } }
  let dir = scratchDir("addanddrop")
  generateInto(db, [gnWidgetRenamed{}], "rename_maybe", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(contains(content, "t.dropColumn(\"old_name\")"), "missing the drop call: ${content}")
  assert(contains(content, "t.addString(\"new_name\", 255)"), "missing the add call: ${content}")
  assert(contains(content, "destructive"), "drop comment does not say destructive: ${content}")
  assert(contains(content, "'new_name'"), "drop comment does not name the added column: ${content}")
  assert(
    !contains(content, "t.renameColumn("),
    "generate must never emit a renameColumn call: ${content}",
  )
}

// #5395's own case, kept rather than deleted (this file's header, #5397):
// a composite-key entity whose diff adds every '@id' column used to make
// `generateInto` refuse; now that `AlterTable.primaryKey` (schema.bit)
// exists, it emits a plain `t.addInt(...)` for each '@id' column - never
// `t.addId(...)`, which would auto-increment more than one column of the
// same key - plus one `t.primaryKey(...)` call naming the full key.
test "a composite-key entity emits addInt for every id column plus one primaryKey call naming the full key" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["name"] } }
  let dir = scratchDir("compositekey")
  generateInto(db, [gnWidgetComposite{}], "add_ids", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(contains(content, "t.addInt(\"id\")"), "missing the id add call: ${content}")
  assert(contains(content, "t.addInt(\"team_id\")"), "missing the team_id add call: ${content}")
  assert(
    !contains(content, "t.addId("),
    "must never auto-increment a composite key column: ${content}",
  )
  assert(
    contains(content, "t.primaryKey(\"id\", \"team_id\")"),
    "missing the primaryKey call naming the full key: ${content}",
  )
}

// A composite-key entity whose diff never touches an '@id' column (the
// ordinary case once the key already exists live) still gets no
// `t.primaryKey(...)` call - `generateInto`'s own gate on `hasIdField(added)`
// (this file's header).
test "a composite-key entity with no id column in the diff emits no primaryKey call" {
  let db = gnExecutor{
    columnsByTable: map<string, []string>{ "widgets": ["id", "team_id"] },
  }
  let dir = scratchDir("compositekeynoop")
  generateInto(db, [gnWidgetComposite{}], "add_name", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(contains(content, "t.addString(\"name\", 255)"), "missing the name add call: ${content}")
  assert(
    !contains(content, "t.primaryKey("),
    "must not touch the key when the diff adds no id column: ${content}",
  )
}

// A composite-key entity whose table already carries a live primary key
// (#5400) gets `t.replacePrimaryKey(...)`, never `t.primaryKey(...)` —
// `generateInto`'s own `hasLivePrimaryKey` read decides which.
test "a composite-key entity whose table already has a live primary key emits replacePrimaryKey" {
  let db = gnExecutor{
    columnsByTable: map<string, []string>{ "widgets": ["name"] },
    primaryKeyTables: ["widgets"],
  }
  let dir = scratchDir("compositekeyreplace")
  generateInto(db, [gnWidgetComposite{}], "add_ids", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(
    contains(content, "t.replacePrimaryKey(\"id\", \"team_id\")"),
    "missing the replacePrimaryKey call: ${content}",
  )
  assert(
    !contains(content, "t.primaryKey("),
    "must use replacePrimaryKey, not primaryKey, when a key already exists live: ${content}",
  )
}

// Both sides of a `@manyToMany("user_roles")` relation, passed together
// (#5390) — exactly one CreateTable for the join table, built via
// `manyToManyTable`, alongside each entity's own column diff, and a
// matching `down()` dropping it.
test "two manyToMany sides produce one join-table CreateTable alongside both entity diffs" {
  let db = gnExecutor{
    columnsByTable: map<string, []string>{ "gn_users": [], "gn_roles": [] },
  }
  let dir = scratchDir("manytomany")
  generateInto(db, [gnUser{}, gnRole{}], "add_user_roles", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let content = onlyFile(dir)
  assert(contains(content, "t.addId(\"id\")"), "missing the entity id columns: ${content}")
  assert(
    count(content, "manyToManyTable(ManyToManyDesc{") == 1,
    "expected exactly one join-table CreateTable: ${content}",
  )
  assert(contains(content, "joinTable: \"user_roles\""), "missing the join table name: ${content}")
  assert(contains(content, "ownerTable: \"gn_users\""), "missing the owner table: ${content}")
  assert(contains(content, "ownerColumn: \"gn_user_id\""), "missing the owner column: ${content}")
  assert(contains(content, "targetTable: \"gn_roles\""), "missing the target table: ${content}")
  assert(contains(content, "targetColumn: \"gn_role_id\""), "missing the target column: ${content}")
  assert(contains(content, "export fn down() {"), "missing the down() function: ${content}")
  assert(contains(content, "drop(\"user_roles\")"), "missing the rollback DropTable: ${content}")
}

// A join table already present live needs no CreateTable at all — the same
// "empty diff writes nothing" rule (this file's header, rule 4) applied to
// a join table instead of a column.
test "a manyToMany join table that already exists live gets no CreateTable" {
  let db = gnExecutor{
    columnsByTable: map<string, []string>{
      "gn_users": ["id"], "gn_roles": ["id"], "user_roles": ["gn_user_id", "gn_role_id"],
    },
  }
  let dir = scratchDir("manytomanylive")
  let msg = generateInto(db, [gnUser{}, gnRole{}], "noop", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  assert(contains(msg, "already matches"), "unexpected message: ${msg}")
}

// A `@manyToMany` field whose join table has no reciprocal side anywhere in
// `entities` cannot be derived — refused naming the join table (this file's
// own "never guess" rule), never silently dropped.
test "a manyToMany field with no reciprocal side in entities fails naming the join table" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "gn_users": ["id"] } }
  let dir = scratchDir("manytomanyorphan")
  generateInto(db, [gnUser{}], "add_user_roles", dir) catch e {
    assert(contains(e.message(), "user_roles"), "must name the join table: ${e.message()}")
    return
  }
  assert(false, "must fail rather than guess a join table with only one side")
}

test "a matching schema writes no file and reports it already matches" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["id", "name"] } }
  let dir = scratchDir("matching")
  let msg = generateInto(db, [gnWidget{}], "noop", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  assert(contains(msg, "already matches"), "unexpected message: ${msg}")
  assert(!exists(dir), "expected no migrations directory to be created: ${dir}")
}

test "the generated file's numeric prefix is one higher than the highest existing" {
  let dir = scratchDir("numbering")
  mkdir(dir) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile("${dir}/0001_init.bit", "// noop\n") catch e {
    panic("writeFile: ${e.message()}")
  }
  writeFile("${dir}/0005_other.bit", "// noop\n") catch e {
    panic("writeFile: ${e.message()}")
  }
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["id"] } }
  let msg = generateInto(db, [gnWidgetWithPhone{}], "add_phone", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  assert(contains(msg, "0006_add_phone.bit"), "unexpected message: ${msg}")
  assert(exists("${dir}/0006_add_phone.bit"), "expected 0006_add_phone.bit to exist")
}

// The checkout root as an ABSOLUTE path. `bit.lock`'s local-path entries
// resolve against the SCRATCH PROJECT's own directory, not this process's
// cwd (`compiler/projectpkg.bit`'s `resolvePackageImportUncached`), so the
// literal "." this test used to fall back to named the temp project's own
// "pkg/orm" the instant `BIT_REPO` was unset (#5373) — a bare `bit test
// pkg/orm` reported a false "cannot find module \"orm\"" on a green tree.
// `BIT_REPO` (what `./make` exports) wins when set; otherwise walked up
// from `cwd()` looking for this package's own `pkg/orm`, the identical
// override-then-walk shape `_tests_/bit/docsrunner`'s `repoRoot()` uses for
// the same problem. Returns "" when neither locates it, so the caller can
// skip instead of running `bit check` against a directory that can only be
// wrong.
fn findRepoRoot(): string {
  let override = envOr("BIT_REPO", "")
  if (len(override) > 0) {
    return override
  }
  let base = cwd() catch _ {
    return ""
  }
  for c of [".", "..", "../.."] {
    let candidate = "${base}/${c}"
    if (isDir("${candidate}/pkg/orm")) {
      return candidate
    }
  }
  return ""
}

// The one clause proving the file this package writes is real Bit source,
// not a string formatter's guess — checked in a scratch `bit.json`
// project declaring "orm" as a local-path dependency on this repo's own
// `pkg/orm`, the identical mechanism `_tests_/bit/pkgdocsgate.bit` uses to
// check a doc's own `import ... from "orm"` block.
test "the generated file compiles under bit check" {
  let db = gnExecutor{ columnsByTable: map<string, []string>{ "widgets": ["id"] } }
  let dir = scratchDir("compilecheck")
  generateInto(db, [gnWidgetWithPhone{}], "add_phone", dir) catch e {
    panic("generateInto: ${e.message()}")
  }
  let generated = onlyFile(dir)

  let repoRoot = findRepoRoot()
  if (repoRoot == "") {
    print("  skipped: cannot locate the repo root; set BIT_REPO")
    return
  }
  let ormAbs = "${repoRoot}/pkg/orm"
  let proj = "${envOr("TMPDIR", "/tmp")}/task5067-checkproj"
  resetDir(proj)
  mkdir(proj) catch e {
    panic("mkdir: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.json",
    "{\"name\": \"gencheck\", \"dependencies\": {\"orm\": \"${ormAbs}\"}}\n",
  ) catch e {
    panic("writeFile bit.json: ${e.message()}")
  }
  writeFile(
    "${proj}/bit.lock",
    "{\"orm\": {\"path\": \"${ormAbs}\", \"requires\": {}}}\n",
  ) catch e {
    panic("writeFile bit.lock: ${e.message()}")
  }
  writeFile("${proj}/main.bit", generated) catch e {
    panic("writeFile main.bit: ${e.message()}")
  }

  // NEVER `selfExe()` here: under `bit test`/`bit run`, that resolves to
  // the CURRENT PROCESS'S OWN temp-compiled binary (this test's, not the
  // toolchain's) — re-exec'd with `["check", proj]`, its `main()` ignores
  // argv and forks again unconditionally, which forked exponentially and
  // had to be killed by hand while developing this file. `BIT_BIN`/
  // `BIT_REPO` (falling back to `${repoRoot}/bit-out/bin/bit`, already
  // resolved above) is the toolchain binary itself — the identical
  // convention `_tests_/bit/pkgdocsgate.bit` uses to shell out to `bit
  // check` for the same "orm" local-dependency shape.
  let bin = envOr("BIT_BIN", "${repoRoot}/bit-out/bin/bit")
  let rc = run(bin, ["check", proj])
  assert(rc == 0, "bit check on the generated migration failed, rc=${rc}:\n${generated}")
  resetDir(proj)
}
