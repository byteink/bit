// pkg/orm/lock.bit — pessimistic locking on the `Repo<T>` chain (#5083,
// owner decision 2026-09-12; #6296 retired the old hand-built-chain-based
// locked-query wrapper and its free-function entry point this file used to
// also declare): `FOR UPDATE`, `FOR UPDATE SKIP LOCKED` and
// `FOR UPDATE NOWAIT`, legal only inside a transaction.
//
//     db.tx((tx) => {
//       let repo = tx.table<Account>()
//       let a = repo.lock().find(1)?
//       a.balance = a.balance - amt
//       repo.update(a)?
//     })?
//
//     db.tx((tx) => {
//       let job = tx.table<Job>().lock(LockMode.SkipLocked).find(id)?
//     })?
//
// `TxRepo<T>.lock(mode)` (pkg/orm/txrepo.bit, #6278) is the one entry
// point — see that file's header for why `Repo<T>` itself never declares
// `lock()`.
//
// THE GUARD IS THE POINT. `SELECT ... FOR UPDATE` issued on a `Pool` (no
// open transaction) takes its row lock and releases it at the end of that
// one statement — the query still returns the right rows, so it LOOKS like
// it worked. Two workers racing the same queue row both "win". `requireTx`
// below is what `LockedRepo<T>.find` runs before issuing any SQL, by asking
// Data's own runtime type the same way `stdlib/sql/tx.bit`'s `enter()`
// already does (`db.(Pool)`) — `Data` (this module's `data.bit`) is `Pool`
// or a live transaction handle, and the concrete type is the only thing
// this file has to ask, since `Executor` itself carries no "am I inside a
// transaction" flag (data.bit's own header: there is deliberately no
// ambient one).
//
// MYSQL'S VERSION GATE IS AN EXPLICIT, REQUIRED FIELD ON `ServerDialect`
// ITSELF (#5391, fixed) — NOT A SEPARATE FUNCTION A CALLER MUST REMEMBER TO
// RUN FIRST. `mysqlLockClause` (below) used to be exactly that: a public
// function nothing in this file's own `guard()` ever called, so a caller who
// forgot the separate pre-check got `SKIP LOCKED`/`NOWAIT` sent straight to
// a MySQL 5.7 server and a syntax error back, with the guard built to
// prevent exactly that never consulted. `LockedRepo<T>`'s own `dialect`
// field (`pkg/orm/data.bit`, #5384) carries it, the same "nothing on `Data`
// carries a server version, so the caller supplies it" reasoning every
// dialect-sensitive site in this package now shares — see `data.bit`'s
// header for the full decision. `Mysql` variant still carrying
// `MysqlVersion`, checked at `LockedRepo<T>.guard()` before any SQL is
// built — the same "zero statements issued on a refusal" guarantee
// `requireTx` already gives. `mysqlLockClause` stays exported (a caller who
// wants the version-only check directly can still call it, the same shape
// `pkg/orm/manytomany.bit`'s header cites this file's version parameter
// for).

// `Pool` is imported below: this file is its canonical import site in the
// module (#5589) - the type assertion in `requireTx` below is the one
// production use.
import { Pool } from "std/sql"

// Why `TxRepo<T>.lock(mode)` on the class mapped to a table was refused —
// see this file's header for each.
export enum LockCause {
  NotInTransaction,
  ConflictingOptions,
  TerminalNotLockable,
  UnsupportedByDialect,
}

// Satisfies the predeclared `error` interface (SPEC §10.6, §18.3), the same
// shape `pkg/orm/keyset.bit`'s `KeysetError` is. `detail` carries the one
// piece each cause needs beyond its own fixed wording — empty where a cause
// needs nothing more.
export class LockError {
  export cause: LockCause
  export detail: string

  export message(): string {
    match (this.cause) {
      NotInTransaction => return "pkg/orm: lock() requires a live transaction (Tx), not a Pool - SELECT ... FOR UPDATE issued on a Pool takes the lock and releases it at the end of that one statement, protecting nothing; wrap the call in db.tx((tx) => { ... })"
      ConflictingOptions => return "pkg/orm: lock() cannot take skipLocked and nowait together - SKIP LOCKED returns fewer rows without blocking, NOWAIT fails immediately instead of blocking; they answer different questions"
      TerminalNotLockable => return "pkg/orm: lock() cannot be combined with '${this.detail}' - a row lock is meaningless without a row to lock"
      UnsupportedByDialect => return "pkg/orm: ${this.detail}"
    }
  }
}

// `skipLocked`/`nowait` as two independent fields — see this file's header
// for why a composite literal replaces the named-argument spelling SPEC
// §12.11 forbids here. Both default `false`: plain `LockOpts{}` is `FOR
// UPDATE`.
export class LockOpts {
  export skipLocked: bool = false,
  export nowait: bool = false,
}

// `TxRepo<T>.lock(mode)` (pkg/orm/txrepo.bit, #6278) — ONE method with a
// typed option, replacing the pair of independent `LockOpts` booleans as
// the chain's own surface (`LockOpts`/`lockClause`/`mysqlLockClause` above
// are unchanged and still do the real work; `lockOptsFor` below is the one
// new translation). `Update` (the default) is a plain `FOR UPDATE`;
// `SkipLocked`/`NoWait` are the two combinations `lockClause` already
// supports — `FOR SHARE` is not added here (scope, per the ticket's own
// "or the modes pkg/orm/lock.bit already supports": it needs its own
// dialect-rendering arm in `lockClause`/`mysqlLockClause`, unlike
// `SkipLocked`/`NoWait` which only toggle a flag those already read).
export enum LockMode {
  Update,
  SkipLocked,
  NoWait,
}

// `LockMode` to the `LockOpts` `lockClause`/`mysqlLockClause` already take —
// never a second copy of the clause logic itself.
fn lockOptsFor(mode: LockMode): LockOpts {
  match (mode) {
    Update => return LockOpts{ skipLocked = false, nowait = false }
    SkipLocked => return LockOpts{ skipLocked = true, nowait = false }
    NoWait => return LockOpts{ skipLocked = false, nowait = true }
  }
}

// Fails unless `db` is a live transaction handle. `Pool` is the one concrete
// type this file has to rule out — every other value reaching `Data` is
// already inside a transaction (the handle `db.tx`'s own block receives, or
// a savepoint nested under it), the same distinction `stdlib/sql/tx.bit`'s
// `enter()` draws with the identical assertion.
fn requireTx(db: Data): ()! {
  let (_, isPool) = db.(Pool)
  if (isPool) {
    fail LockError{ cause = LockCause.NotInTransaction, detail = "" }
  }
}

// The `FOR UPDATE` clause text for `opts`, or the refusal for an
// unsatisfiable combination. Dialect-neutral: Postgres and MySQL 8 both
// accept this exact spelling (see this file's header) — `mysqlLockClause`
// below is the one place a server version narrows it further.
fn lockClause(opts: LockOpts): string! {
  if (opts.skipLocked && opts.nowait) {
    fail LockError{ cause = LockCause.ConflictingOptions, detail = "" }
  }
  if (opts.skipLocked) {
    return " for update skip locked"
  }
  if (opts.nowait) {
    return " for update nowait"
  }
  return " for update"
}

// `lockClause`, refusing `skipLocked`/`nowait` when `version` is older than
// MySQL 8.0 — the one engine-specific gate this file needs (this file's
// header). Postgres never calls this: `lockClause` alone is already correct
// for it.
export fn mysqlLockClause(opts: LockOpts, version: MysqlVersion): string! {
  if (opts.skipLocked && version.major < 8) {
    fail LockError{
      cause = LockCause.UnsupportedByDialect,
      detail = "MySQL ${version.major}.${version.minor} does not support FOR UPDATE SKIP LOCKED (added in MySQL 8.0); omit skipLocked or upgrade the server",
    }
  }
  if (opts.nowait && version.major < 8) {
    fail LockError{
      cause = LockCause.UnsupportedByDialect,
      detail = "MySQL ${version.major}.${version.minor} does not support FOR UPDATE NOWAIT (added in MySQL 8.0); omit nowait or upgrade the server",
    }
  }
  return lockClause(opts)?
}

// `TxRepo<T>.lock(mode)` (`pkg/orm/txrepo.bit`, #6278; `Repo<T>.lock()`
// before it, #6276) wraps `Repo<T>` in a second, dedicated class — never a
// new method on `Repo<T>` returning `Repo<T>!` itself, because a Bit class
// may declare `find` exactly once (SPEC §14): `Repo<T>`'s OWN `find`/
// `checkErr`/`singleKeyColumn` (this file's own cross-file access to them
// is legal because a Bit module is a whole directory sharing one
// declaration namespace, SPEC §17.1) stay exactly as `repo.bit` already
// declares them, never touched by this file. `requireTx`/`lockClause`/
// `mysqlLockClause` are reused unchanged — the only new logic here is
// `find`'s own row fetch, the one thing `Repo<T>.find` cannot hand this
// file a hook into.
export class LockedRepo<T: Tabled> {
  inner: Repo<T>
  opts: LockOpts
  dialect: ServerDialect

  export find(id: Value): T! {
    this.inner.checkErr()?
    let col = this.inner.singleKeyColumn()?
    let clause = this.guard()?
    let sqlText = "select * from ${T.__tableName()} where ${col} = $1 limit 2" + clause
    let rows = this.inner.db.query(sqlText, [id])?
    defer rows.close()
    if (!rows.next()?) {
      fail newError("orm: no row in '${T.__tableName()}' matches the given id")
    }
    let row = T.__fromRow(rows)?
    if (rows.next()?) {
      fail newError("orm: more than one row in '${T.__tableName()}' matches the given id")
    }
    return row
  }

  guard(): string! { // `requireTx` then the dialect-appropriate clause, in that order, so a
    // caller on a `Pool` never reaches SQL assembly at all.
    requireTx(this.inner.db)?
    match (this.dialect) {
      Postgres => return lockClause(this.opts)?
      Mysql(version) => return mysqlLockClause(this.opts, version)?
    }
  }
}
