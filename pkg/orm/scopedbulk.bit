// The caller must narrow the bulk write before a policy can narrow it further.
fn scopedDeleteAll<T: Tabled>(self: ScopedRepo<T>): int! {
  self.inner.checkErr()?
  if (len(self.inner.wheres) == 0) {
    return self.inner.deleteAll()?
  }
  match (self.guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        return guardedDeleteAll<T>(self, g)?
      }
    }
    None => {}
  }
  return self.inner.deleteAll()?
}

fn guardedDeleteAll<T: Tabled>(self: ScopedRepo<T>, g: Guard): int! {
  let filter = g.filter(
    scopedActor<T>(self), GuardOp.Delete, T.__tableName(),
    self.inner.dialect, len(self.inner.args) + 1,
  )?
  match (filter) {
    All => return self.inner.deleteAll()?
    None => return 0
    Sql(fragment, args) => return withFragment<T>(self.inner, fragment, args).deleteAll()?
  }
}

fn scopedSet<T: Tabled>(self: ScopedRepo<T>, column: string, val: Value): ScopedRepo<T> {
  let scoped = scopedWith<T>(self, self.inner.set(column, val))
  scoped.setColumns = append(scoped.setColumns, column)
  return scoped
}

fn scopedUpdateAll<T: Tabled>(self: ScopedRepo<T>): int! {
  self.inner.checkErr()?
  if (len(self.inner.wheres) == 0 ||
    (len(self.inner.sets) == 0 && !hasTimestampsAttr(T.__tableAttrs()))) {
    return self.inner.updateAll()?
  }
  match (self.guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        return guardedUpdateAll<T>(self, g)?
      }
    }
    None => {}
  }
  return self.inner.updateAll()?
}

fn guardedUpdateAll<T: Tabled>(self: ScopedRepo<T>, g: Guard): int! {
  checkBulkSetColumns<T>(self, g)?
  let filter = g.filter(
    scopedActor<T>(self), GuardOp.Update, T.__tableName(),
    self.inner.dialect, len(self.inner.args) + 1,
  )?
  match (filter) {
    All => return self.inner.updateAll()?
    None => return 0
    Sql(fragment, args) => return withFragment<T>(self.inner, fragment, args).updateAll()?
  }
}

// Row filters inspect stored values, so a batch cannot safely rewrite their inputs.
fn checkBulkSetColumns<T: Tabled>(self: ScopedRepo<T>, g: Guard): ()! {
  let columns = self.setColumns
  if (hasTimestampsAttr(T.__tableAttrs())) {
    columns = append(columns, "updatedAt")
  }
  for op of [GuardOp.Update, GuardOp.Delete] {
    let referenced = g.columnsInRules(scopedActor<T>(self), op, T.__tableName())?
    for column of columns {
      for ruleColumn of referenced {
        if (column == ruleColumn) {
          fail g.denied(scopedActor<T>(self), GuardOp.Update, T.__tableName())
        }
      }
    }
  }
}
