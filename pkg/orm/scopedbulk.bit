// The caller must narrow the bulk write before a policy can narrow it further.
fn scopedDeleteAll<T: Tabled>(self: ScopedRepo<T>): int! {
  self.inner.checkErr()?
  if (len(self.inner.wheres) == 0) {
    return self.inner.deleteAll()?
  }
  match (self.guard) {
    Some(g) => {
      if (g.protects(T.__tableName())) {
        return guardedDeleteAll<T>(self, g)?
      }
    }
    None => {}
  }
  return self.inner.deleteAll()?
}

fn guardedDeleteAll<T: Tabled>(self: ScopedRepo<T>, g: Guard): int! {
  let filter = g.filter(
    scopedActor<T>(self), GuardOp.Delete, T.__tableName(),
    self.inner.dialect, len(self.inner.args) + 1,
  )?
  match (filter) {
    All => return self.inner.deleteAll()?
    None => return 0
    Sql(fragment, args) => return withFragment<T>(self.inner, fragment, args).deleteAll()?
  }
}
