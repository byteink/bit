// pkg/orm/enumcol.test.bit — #5082's acceptance: the CHECK-constraint DDL
// for an enum field is exact on both dialects, a hostile variant name
// cannot break out of its literal, the write/read pair round-trips the
// same variant, an unrecognised stored value errors naming the column, the
// value and the enum rather than falling back to the first variant, and
// `enumVariantsChanged` is what proves a reorder is a no-op. The dialect
// ALTER (add/drop a variant) tests live in postgres.test.bit/mysql.test.bit
// alongside every other dialect-specific statement this package renders —
// see enumcol.bit's own header for why the column DEFINITION is tested
// here once instead of once per dialect.
//
// `contains`/`toUpper` are not imported here — query.test.bit/postgres.bit
// already import them and a Bit import binds package-wide (postgres.bit's
// own header on this exact pair).

// A small C-like enum carrying its own `name()` method — the shape this
// ticket's own body and enumcol.bit's header both show a caller writing
// once per enum, since Bit has no reflection to derive it.
enum EcStatus {
  Draft
  Active
  Archived

  export name(): string {
    match (this) {
      Draft => return "Draft"
      Active => return "Active"
      Archived => return "Archived"
    }
  }
}

fn ecStatusParse(text: string): Option<EcStatus> {
  if (text == "Draft") {
    return Option.Some(EcStatus.Draft)
  }
  if (text == "Active") {
    return Option.Some(EcStatus.Active)
  }
  if (text == "Archived") {
    return Option.Some(EcStatus.Archived)
  }
  return Option.None
}

test "the DDL for an enum field lists exactly the declared variants, in declaration order, exactly on both dialects" {
  let want = "status text not null check (status in ('Draft','Active','Archived'))"
  let ddl = enumColumnDef("status", ["Draft", "Active", "Archived"])
  assert(ddl == want, "enum column ddl: ${ddl}")
  // enumColumnDef is the ONE function both dialects call (enumcol.bit's
  // own header) — this single exact match IS both the "Postgres DDL" and
  // "the MySQL DDL is the equivalent" clauses, since there is no per-engine
  // divergence to render for this column shape.
  assert(!contains(toUpper(ddl), "ENUM("), "must not emit a native ENUM type: ${ddl}")
}

test "a variant name carrying a single quote is escaped, never breaks out of its literal" {
  let ddl = enumColumnDef("rating", ["A", "B'; drop table users; --"])
  let want = "rating text not null check (rating in ('A','B''; drop table users; --'))"
  assert(ddl == want, "hostile variant was not fully neutralised:\n${ddl}")
}

test "writing an enum value and reading it back gives the same variant" {
  let v = enumColumnValue<EcStatus>(EcStatus.Active, (s) => s.name())
  let text = asText(v) catch e {
    panic("enumColumnValue must always bind Value.Text: ${e.message()}")
  }
  assert(text == "Active", "stored text: ${text}")

  let back = enumColumnRead<EcStatus>(v, "status", "EcStatus", ecStatusParse) catch e {
    panic("unexpected read failure: ${e.message()}")
  }
  assert(back == EcStatus.Active, "round trip did not reproduce the variant")
}

test "every declared variant round-trips" {
  let variants = [EcStatus.Draft, EcStatus.Active, EcStatus.Archived]
  for want of variants {
    let v = enumColumnValue<EcStatus>(want, (s) => s.name())
    let back = enumColumnRead<EcStatus>(v, "status", "EcStatus", ecStatusParse) catch e {
      panic("unexpected read failure: ${e.message()}")
    }
    assert(back == want, "round trip mismatch for one variant")
  }
}

// An unrecognised stored value must never silently become the first
// variant (`Draft`) — that would be a wrong answer that looks like real
// data (this ticket's own constraint).
test "reading an unrecognised stored value errors naming the column, the value and the enum" {
  enumColumnRead<EcStatus>(Value.Text("Deleted"), "status", "EcStatus", ecStatusParse) catch e {
    assert(contains(e.message(), "status"), "error must name the column: ${e.message()}")
    assert(contains(e.message(), "Deleted"), "error must name the raw value: ${e.message()}")
    assert(contains(e.message(), "EcStatus"), "error must name the enum: ${e.message()}")
    let (_, isEnumErr) = e.(EnumColumnError)
    assert(isEnumErr, "must be an EnumColumnError, got: ${e.message()}")
    return
  }
  assert(false, "an unrecognised stored value must fail, never fall back to the first variant")
}

test "a SQL NULL fails naming the column, never becomes the first variant" {
  enumColumnRead<EcStatus>(Value.Null, "status", "EcStatus", ecStatusParse) catch e {
    assert(contains(e.message(), "status"), "error must name the column: ${e.message()}")
    return
  }
  assert(false, "a SQL NULL must fail, never silently become a variant")
}

// `enumVariantsChanged` is the decision a caller makes before emitting
// anything — see enumcol.bit's own header on why the live generate.bit
// integration is separate, wider work this ticket does not attempt.
test "reordering the same variant set changes nothing; adding or removing one does" {
  assert(
    !enumVariantsChanged(["Draft", "Active", "Archived"], ["Archived", "Draft", "Active"]),
    "a reorder of the same set must not count as a change",
  )
  assert(
    enumVariantsChanged(["Draft", "Active", "Archived"], ["Draft", "Active"]),
    "removing a variant must count as a change",
  )
  assert(
    enumVariantsChanged(["Draft", "Active"], ["Draft", "Active", "Archived"]),
    "adding a variant must count as a change",
  )
}
