// pkg/orm/write.bit — `TableDesc`, `WriteError` and the small set of
// column-classification helpers `Repo<T>` (pkg/orm/repo.bit,
// pkg/orm/reposql.bit, pkg/orm/repobulk.bit) reads directly: `valueFor`,
// `hasIdAttr`, `generatedIdField`, `isRelationField`, `valueText`. The old
// map-based `save`/`delete`/`upsert` entry points this file used to declare
// (#5058) are retired (#6296) — every feature they offered now lives on
// `Repo<T>`/`TxRepo<T>`, which build INSERT/UPDATE/DELETE straight off
// `T.__values()` rather than a caller-supplied `map<string, Value>`.
//
// `@id` MARKS THE PRIMARY KEY - `docs/stdlib/sql.md`'s own words: "`pkg/orm`
// treats `@id` as a primary key". More than one `@id` field is a composite
// key (#5084): `pkg/orm/compositekey.bit`'s `keyFields` returns every one of
// them, in declaration order.
//
// UPDATE WRITES EVERY COLUMN EXCEPT A SOLE DATABASE-GENERATED `@id`
// (#6101): Postgres refuses to `SET` a `GENERATED ALWAYS AS IDENTITY`
// column to anything but `DEFAULT` (verified live, SQLSTATE 428C9), so a
// plain `t.id(...)` primary key (`generatedIdField`, below) is carved out
// of every column list a caller of this file's helpers builds. A composite
// key's `@id` fields are never database-generated (`pkg/orm/generate.bit`'s
// own header) and keep flowing through unchanged.

// `Rows`/`Value` are imported here - the module's canonical site for both
// (#5589; a dependent compiling only this package's non-test files needs at
// least one production import of each, SPEC §17.1's flat namespace then
// carries it to every sibling). A second import of either anywhere else in
// pkg/orm would be E0042.
import { Rows, Value } from "std/sql"

// A `@table` class's own name and field list, together - what every
// function in this file needs to build SQL, and never wants split, so a
// caller builds it once: `TableDesc{ table = "users", fields =
// u.tableDescriptor(), classAttrs = u.tableAttrs() }`.
export class TableDesc {
  export table: string,
  export fields: []FieldDesc,
  export classAttrs: []AttrDesc,
}

// Why an UPDATE matched no row: a caller held a stale entity - another
// request already deleted or never inserted it. Distinct from any error a
// `Value`/driver problem would raise, so a caller can `catch` this one
// specifically.
export enum WriteCause { NoRowsAffected }

// Satisfies the predeclared `error` interface (SPEC §10.6, §18.3), the same
// shape `stdlib/sql/row.bit`'s `SqlRowError` is. `Repo<T>.update()`
// (pkg/orm/repo.bit) raises this when its own UPDATE matches 0 rows.
export class WriteError {
  export cause: WriteCause
  export table: string
  export keys: []Value

  export message(): string {
    return "pkg/orm: update matched 0 rows in the class mapped to '${this.table}' with key ${keyText(this.keys)}"
  }
}

// `field`'s current value out of the caller-supplied map, or a panic naming
// the field and the table - a caller bug, not a recoverable condition.
fn valueFor(values: map<string, Value>, field: FieldDesc, table: string): Value {
  let (v, ok) = values[field.name]
  if (!ok) {
    panic("pkg/orm: no value supplied for field '${field.name}' of the class mapped to '${table}'")
  }
  return v
}

// Whether `f` carries `@id` - `pkg/orm/compositekey.bit`'s own `keyFields`
// and `pkg/orm/repo.bit`'s `update()` both call this (same package, no
// import, SPEC §17.1).
fn hasIdAttr(f: FieldDesc): bool {
  for a of f.attrs {
    if (a.name == "id") {
      return true
    }
  }
  return false
}

// The sole `@id` field's own name, or `""` when the class carries zero (a
// caller bug `keyFields` elsewhere already panics for) or more than one (a
// composite key, #5084) - #6101. A single `@id` field is this package's
// only column ever built by `t.id()` (`pkg/orm/docs/schema.md`: "an
// auto-incrementing primary key"; rendered `generated always as identity`
// on Postgres, `auto_increment` on MySQL -
// `pkg/orm/postgres.bit`/`pkg/orm/mysql.bit`), so it never takes a
// client-supplied value: Postgres refuses both an explicit INSERT value and
// any UPDATE `SET` other than `DEFAULT` for one (verified live, SQLSTATE
// 428C9 both ways). A composite key's `@id` fields are never
// database-generated (`pkg/orm/generate.bit`'s own header: they become
// `t.addInt`, never `t.id()`), so this returns `""` for them.
fn generatedIdField(desc: TableDesc): string {
  let name = ""
  let count = 0
  for f of desc.fields {
    if (hasIdAttr(f)) {
      count = count + 1
      name = f.name
    }
  }
  if (count == 1) {
    return name
  }
  return ""
}

// The four compiler-known/package-known relation marks a `FieldDesc.attrs`
// entry can carry - `@belongsTo`/`@hasOne`/`@hasMany`
// (`compiler/classrelationattr.bit`'s `attrNameIsRelation`) and `@manyToMany`
// (recorded the same #5051 way as `@unique`/`@check`, that file's own header:
// "NOT added to attrNameIsRelation"). Declared once so `isRelationField`
// below and any future caller share one list rather than four repeated
// string comparisons drifting apart.
fn relationAttrName(name: string): bool {
  return name == "belongsTo" || name == "hasOne" || name == "hasMany" || name == "manyToMany"
}

// Whether `f` is a relation field, not a column - #6115.
// `compiler/classtabledesc.bit`'s `tableDescriptor()` synthesizes one
// `FieldDesc` per DECLARED field with no special case for a relation, so a
// `@belongsTo`/`@hasOne`/`@hasMany`/`@manyToMany` field lands in
// `desc.fields` exactly like a real column. `pkg/orm/reposql.bit`'s own
// `repoColumnsForValues` excludes it the same way `generatedIdField`
// excludes a sole database-generated `@id`.
fn isRelationField(f: FieldDesc): bool {
  for a of f.attrs {
    if (relationAttrName(a.name)) {
      return true
    }
  }
  return false
}

// A `Value` rendered for an error message - `WriteError.message()`/
// `StaleWriteError.message()`'s own need (via `keyText`,
// pkg/orm/compositekey.bit), kept local since no other file in this package
// renders one to text.
fn valueText(v: Value): string {
  match (v) {
    Null => return "null"
    Int(n) => return "${n}"
    Float(f) => return "${f}"
    Bool(b) => return "${b}"
    Text(s) => return "'${s}'"
    Blob(b) => return "<${len(b)} bytes>"
  }
}
