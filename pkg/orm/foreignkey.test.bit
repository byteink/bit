// pkg/orm/foreignkey.test.bit — #5064's acceptance.
//
// `FieldDesc`/`AttrDesc` are imported by ./naming.bit, `contains` by
// ./query.test.bit, `fieldWithId` is declared in ./write.test.bit,
// `wrAdapter`/`newWrPool`/`accountDesc`/`accountValues`/`delete` (the "no
// child DELETE" test's fake driver and entity) likewise — all this file's
// siblings in the same module (SPEC §17.1); re-declaring or re-importing
// any of them here would be E0042.

// A fresh, empty `orders` table `addForeignKeys` appends to directly - the
// same shape `schema.bit`'s own `table(...)` builder produces, built by
// hand here so a REJECTED call (the SetNull/not-@table tests) never runs
// through a closure that cannot propagate a caught error out to the test.
fn newOrdersTable(): Table {
  return Table{
    name: "orders", columns: []Column(0), indexes: []Index(0),
    foreignKeys: []ForeignKey(0), raws: []string(0), primaryKeyColumns: []string(0),
  }
}

fn userTarget(): RelationTarget {
  return RelationTarget{ isTable: true, table: "users", idColumn: "id" }
}

fn belongsToAttr(args: []string): AttrDesc {
  return AttrDesc{ name: "belongsTo", args: args }
}

// `user: User` plus its own `userId` foreign-key column, the ticket's own
// worked example. `onDeleteArgs` is `@belongsTo`'s own recorded args past
// the column name - `["onDelete", "Cascade"]`, or `[]string(0)` for an
// omitted `onDelete`.
fn orderFields(fkTypeName: string, onDeleteArgs: []string): []FieldDesc {
  let args = ["userId"]
  for a of onDeleteArgs {
    args = append(args, a)
  }
  return [
    fieldWithId("id"),
    FieldDesc{ name: "user", typeName: "User", attrs: [belongsToAttr(args)] },
    FieldDesc{ name: "userId", typeName: fkTypeName, attrs: []AttrDesc(0) },
  ]
}

fn createTableSql(t: Table): string {
  let stmts = Postgres{}.render(SchemaOp.CreateTable(t))
  return stmts[0].sql
}

test "onDelete = Cascade renders REFERENCES users(id) ON DELETE CASCADE" {
  let t = newOrdersTable()
  addForeignKeys(
    t,
    orderFields("i64", ["onDelete", "Cascade"]),
    map<string, RelationTarget>{ "user": userTarget() },
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let sql = createTableSql(t)
  assert(
    contains(sql, "references \"users\" (\"id\") on delete cascade"),
    "got: ${sql}",
  )
}

test "an omitted onDelete emits ON DELETE RESTRICT" {
  let t = newOrdersTable()
  addForeignKeys(
    t,
    orderFields("i64", []string(0)),
    map<string, RelationTarget>{ "user": userTarget() },
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let sql = createTableSql(t)
  assert(contains(sql, "on delete restrict"), "got: ${sql}")
}

test "SetNull on an Option foreign-key field emits ON DELETE SET NULL" {
  let t = newOrdersTable()
  addForeignKeys(
    t,
    orderFields("Option<i64>", ["onDelete", "SetNull"]),
    map<string, RelationTarget>{ "user": userTarget() },
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let sql = createTableSql(t)
  assert(contains(sql, "on delete set null"), "got: ${sql}")
}

// `ReferentialAction.NoAction` is the ANSI default a foreign key names by
// carrying no clause at all - `postgres.bit`'s own `onDeleteClause` renders
// it as "", not the words "no action" (unlike Cascade/Restrict/SetNull,
// each rendered as its own keyword phrase). This is the first test either
// spelling ever ran through.
test "NoAction emits no ON DELETE clause at all (postgres.bit's own ANSI-default rendering)" {
  let t = newOrdersTable()
  addForeignKeys(
    t,
    orderFields("i64", ["onDelete", "NoAction"]),
    map<string, RelationTarget>{ "user": userTarget() },
  ) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }
  let sql = createTableSql(t)
  assert(contains(sql, "foreign key (\"user_id\") references \"users\" (\"id\")"), "got: ${sql}")
  assert(!contains(sql, "on delete"), "NoAction must carry no ON DELETE clause: ${sql}")
}

test "onDelete = SetNull on a non-Option foreign-key field is rejected, naming the field and the option" {
  let t = newOrdersTable()
  addForeignKeys(
    t,
    orderFields("i64", ["onDelete", "SetNull"]),
    map<string, RelationTarget>{ "user": userTarget() },
  ) catch e {
    assert(contains(e.message(), "userId"), "must name the foreign-key field: ${e.message()}")
    assert(contains(e.message(), "SetNull"), "must name the option: ${e.message()}")
    return
  }
  assert(false, "must reject SetNull on a non-Option foreign-key field")
}

test "a relation whose target is not a @table class is rejected" {
  let t = newOrdersTable()
  let notTable = RelationTarget{ isTable: false, table: "users", idColumn: "id" }
  addForeignKeys(
    t,
    orderFields("i64", []string(0)),
    map<string, RelationTarget>{ "user": notTable },
  ) catch e {
    assert(contains(e.message(), "@table"), "must name the missing '@table' mark: ${e.message()}")
    return
  }
  assert(false, "must reject a target that does not carry @table")
}

// #5064's central decision: the DATABASE enforces onDelete, never this
// package walking relations issuing child deletes. Proven the only way
// that decision can be proven - a delete against the fake driver
// (write.test.bit's own `wrAdapter`) reaches the driver exactly once,
// whether or not the deleted row is a foreign key's own target elsewhere.
test "a delete on a parent emits exactly one statement to the driver — no child DELETE is ever issued" {
  let a = wrAdapter{ cols: []string(0), rows: [][]Value(0), affected: 1 }
  let p = newWrPool(a)
  let u = Account{ id: 3, name: "Ada", email: "ada@x.com" }
  u.markPersisted(true)

  delete(p, accountDesc(), accountValues(u)) catch e {
    assert(false, "must not error: ${e.message()}")
    return
  }

  assert(len(a.calls) == 1, "expected exactly one statement, got ${len(a.calls)}")
}
