// pkg/orm/sync.bit — #6307 (S2, epic #6298,
// `.claude/kb/orm-impl-plan-2026-09-30.md` Feature 2), owner ruling
// 2026-09-30: the TypeORM `synchronize: true` experience, allowed in ANY
// environment including production ("some apps are designed this way,
// dynamic") — no dev-only guard, no prod warning, no refusal when the
// database already carries migration history. `db.bit`'s `open(url,
// Options{ synchronize = true })` is the only caller: `syncTables` below is
// not exported, and there is no `db.sync<T>()` — see this ticket's own
// text, "delete the public `syncSchema`".
//
//   open("postgres://localhost/inkwell", Options{ synchronize = true })?
//
// Was named `syncSchema` and took a caller-supplied `[]TableEntity` plus a
// `RunnerDialect` (#5069). #6307 replaces both: the entity list is now
// `[]TableSchema` (`std/sql`'s `__tables()`, #6301's compiler-synthesized
// registry of every `@table` class), so nothing in this package enumerates
// entities by hand, and the function itself is private — `open` is the only
// public surface.
//
// ADD ONLY, NEVER DROP OR RENAME (owner ruling, this ticket). The prior
// `syncSchema` dropped a live column absent from the entity outright; that
// behaviour is gone. A column present live but with no matching field now
// gets exactly one stderr warning and is left untouched — see
// `warnRemovedColumns` below. A RENAME IS NEVER INFERRED either: there is
// no way to tell a rename from a delete-and-create from a diff alone
// (`livediff.bit`'s own header makes the identical point for `check`).
//
// NO REFUSAL ON MIGRATION HISTORY (owner ruling, this ticket, supersedes
// #5069's `refuseIfMigrated`). The owner allowed `synchronize` against any
// database, migrated or not: adding a missing table or column on top of a
// reviewed history is safe precisely because this file never drops or
// renames anything to get there.
//
// NEVER A WHOLE-TABLE DROP, UNCHANGED FROM #5069: a table this project no
// longer declares is simply absent from `__tables()` and is never
// inspected here — a table's own removal is always a hand-written decision.
//
// A MANYTOMANY JOIN TABLE IS STILL OUT OF SCOPE, THE SAME SCOPE #5076's OWN
// `check.bit` DECLARED for the identical reason: `TableSchema` names the
// join table (`@manyToMany("...")`'s own argument) but carries neither the
// owning class's name nor the target table's, so building the join table's
// two foreign-key columns without guessing needs a wider registry than
// `__tables()` gives today (`livediff.bit`'s "never guess" rule, restated
// here for the identical reason `tableNameOf` never guesses a table name).
// Creating one is real, separate work.
//
// A BRAND-NEW TABLE'S OWN ENUM COLUMN GETS NO CHECK CONSTRAINT YET,
// UNCHANGED FROM #5069 — see `generateenum.bit`'s `enumCheckDiffs` header.
//
// NEVER WRITES ANY MIGRATION-HISTORY TABLE — `applyTableOp` below reuses
// `runner.bit`'s own `renderOps`/`splitByTransactional`/
// `runTransactionalBlock`/`runNonTransactional`, passing a no-op ledger
// closure, the identical statement-sequencing primitives `migrate`/
// `rollback` (#6309) use.

// Whether `table` exists live at all — `information_schema.tables` is the
// ANSI-standard view both engines expose (portable, no dialect branch, the
// same reasoning `livediff.bit`'s own `hasLivePrimaryKey` already gives for
// `information_schema.table_constraints`) — read once per entity, since
// `liveColumns` alone cannot tell "the table has zero columns" (impossible)
// from "the table does not exist" (this file's own reason to create one).
fn liveTableExists(db: Data, table: string): bool! {
  let rows = db.query(
    "select table_name from information_schema.tables where table_name = $1",
    [Value.Text(table)],
  )?
  defer rows.close()
  return rows.next()?
}

// A field's Bit type -> the `Table` column it becomes, for a brand-new
// table — the identical closed mapping `addColumnToAlterTable` below gives
// an existing table, built as a real `Column` instead of rendered source
// text, since `sync` applies immediately rather than writing a file.
fn addColumnToCreateTable(t: Table, f: FieldDesc, composite: bool): ()! {
  let col = columnName(f)
  if (f.typeName == "i64") {
    if (hasIdAttr(f) && !composite) {
      t.id(col)
    } else {
      t.int(col)
    }
    return
  }
  if (f.typeName == "string") {
    t.string(col, defaultStringLength)
    return
  }
  if (f.typeName == "bool") {
    t.bool(col)
    return
  }
  if (f.typeName == "decimal") {
    t.decimal(col)
    return
  }
  fail newError(
      "pkg/orm: sync: field '${f.name}' has Bit type '${f.typeName}', " +
      "which this package has no schema column mapping for",
  )
}

// `addColumnToCreateTable`'s own sibling for an EXISTING table's `alter()`
// block — `AlterTable`'s column methods carry `Table`'s own names
// (`id`/`int`/...), not a separate `addX` vocabulary (#6304, schema.bit's
// own header).
fn addColumnToAlterTable(t: AlterTable, f: FieldDesc, composite: bool): ()! {
  let col = columnName(f)
  if (f.typeName == "i64") {
    if (hasIdAttr(f) && !composite) {
      t.id(col)
    } else {
      t.int(col)
    }
    return
  }
  if (f.typeName == "string") {
    t.string(col, defaultStringLength)
    return
  }
  if (f.typeName == "bool") {
    t.bool(col)
    return
  }
  if (f.typeName == "decimal") {
    t.decimal(col)
    return
  }
  fail newError(
      "pkg/orm: sync: field '${f.name}' has Bit type '${f.typeName}', " +
      "which this package has no schema column mapping for",
  )
}

// `table`'s own `CREATE TABLE`, every field mapped through
// `addColumnToCreateTable`, with a `t.primaryKey(...)` call only for a
// composite key (#5084) — a single `@id` field needs no separate call,
// since `t.id(...)` already carries its own inline primary key.
fn buildCreateTable(table: string, fields: []FieldDesc, composite: bool): Table! {
  let t = Table{
    name = table, columns = []Column(0), indexes = []Index(0),
    foreignKeys = []ForeignKey(0), raws = []string(0), primaryKeyColumns = []string(0),
  }
  for f of fields {
    addColumnToCreateTable(t, f, composite)?
  }
  if (composite) {
    t.primaryKey(...idColumnNames(fields))
  }
  return t
}

// The one stderr line a live column with no matching field gets (this
// file's header: add only, never drop). One warning per column, naming
// both the table and the column, so it is searchable — never a failure,
// never a prompt.
fn warnRemovedColumns(table: string, removed: []string) {
  for c of removed {
    eprint(
        "pkg/orm: sync: \"${table}\".\"${c}\" has no matching field on the " +
        "@table class; kept, not dropped\n",
    )
  }
}

// `table`'s own `alter()` block against its live columns, built as a real
// `AlterTable` and applied directly — added columns only (this file's
// header); a live column with no matching field is warned about, never
// dropped. `hasWork` is read off the built node itself (`len(t.ops) > 0 ||
// len(t.raws) > 0`) rather than a separate upfront gate, since building it
// is cheap and this avoids a second count of the same findings.
fn alterTableOp(
  db: Data,
  table: string,
  fields: []FieldDesc,
  dialect: RunnerDialect,
): (AlterTable, bool)! {
  let liveCols = liveColumns(db, table)?
  let added = fieldsNotIn(fields, liveCols)
  let composite = hasCompositeKey(fields)
  let t = AlterTable{ name = table, ops = []AlterOp(0), raws = []string(0) }
  for f of added {
    addColumnToAlterTable(t, f, composite)?
  }
  if (composite && hasIdField(added)) {
    let replacing = hasLivePrimaryKey(db, table)?
    if (replacing) {
      t.replacePrimaryKey(...idColumnNames(fields))
    } else {
      t.primaryKey(...idColumnNames(fields))
    }
  }
  for sql of enumCheckDiffs(db, table, fields, columnNamesOf(added), dialect.server)? {
    t.raw(sql)
  }
  warnRemovedColumns(table, colsNotInFields(liveCols, fields))
  return (t, len(t.ops) > 0 || len(t.raws) > 0)
}

// One `TableSchema`'s own `SchemaOp` and whether it carries any work at
// all — a brand-new table (`liveTableExists` false) always does; an
// existing one only when `alterTableOp` found an added column or a changed
// enum CHECK.
fn tableOp(db: Data, ts: TableSchema, dialect: RunnerDialect): (SchemaOp, bool)! {
  let fields = withoutManyToMany(ts.columns)
  let exists = liveTableExists(db, ts.name)?
  if (!exists) {
    return (SchemaOp.CreateTable(buildCreateTable(ts.name, fields, hasCompositeKey(fields))?), true)
  }
  let (t, hasWork) = alterTableOp(db, ts.name, fields, dialect)?
  return (SchemaOp.AlterTable(t), hasWork)
}

// Renders `op` and applies every statement — `runner.bit`'s own
// `renderOps`/`splitByTransactional`/`runTransactionalBlock`/
// `runNonTransactional`, reused unchanged: a transactional block wrapped in
// `BEGIN`/`COMMIT` (with `ROLLBACK` on failure) when the dialect leaves one
// to use, every non-transactional statement run individually otherwise —
// the identical shape `migrate` applies a migration with, minus any history
// write (the ledger closure passed here does nothing).
fn applyTableOp(db: Data, render: Dialect, op: SchemaOp): ()! {
  let stmts = renderOps(render, [op])
  let (transactional, nonTransactional) = splitByTransactional(stmts)
  if (len(transactional) > 0) {
    runTransactionalBlock(db, transactional, (d) => {})?
  }
  runNonTransactional(db, nonTransactional)?
}

// `open`'s own `Options{ synchronize = true }` path (`db.bit`): creates any
// missing table, adds any missing column, and applies an enum column's
// drifted CHECK constraint (#5435) for every `TableSchema` in `tables` —
// never drops or renames anything (this file's header). Not exported: the
// only public surface is `open`.
fn syncTables(db: Data, tables: []TableSchema, dialect: RunnerDialect): ()! {
  for ts of tables {
    let (op, hasWork) = tableOp(db, ts, dialect)?
    if (!hasWork) {
      continue
    }
    applyTableOp(db, dialect.render, op)?
  }
}
