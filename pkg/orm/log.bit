// pkg/orm/log.bit — query logging (#5075, #7430): every statement the ORM runs,
// written through std/log, with a slow-query warning and a statement counter
// #5061's N+1 guarantee is checkable against.
//
//   let queries = QueryLog(logger)      // logger: std/log's Logger; 200ms slow threshold
//   let db = queries.wrap(pool)         // db: Data — a drop-in for the Pool or Tx it wraps
//   db.query(sqlText, args)?            // INFO msg=statement sql="SELECT ..." rows=3 took=412us
//
// ONE LOGGER TYPE: std/log's. This file used to declare its own `Logger`, a
// one-method `LogSink` and the `LogValues`/`LogOptions` pair; #7430 deleted
// them, so `Options.logger` (db.bit) and `QueryLog` take the same `Logger`
// every other package takes, and the app's handler decides the format and
// the destination. `QueryLog` is what is left of the old class: the wrapper
// and the statement counter, which are not logging.
//
// NO BOUND VALUE IS EVER LOGGED. The old `LogValues.Shown` switch wrote every
// parameter in cleartext; it is gone, not defaulted off, because a log line
// outlives the code that chose to write it. A record carries the statement
// TEXT (`pkg/orm/query.bit`'s header: SQL text alone is safe, values travel
// separately), the row count and the duration — nothing else. A failed
// statement adds the driver's message, redacted by `redactErrorMessage`
// below (#5381).
//
// A THRESHOLD OF ZERO OR NEGATIVE DISABLES THE SLOW-QUERY WARNING RATHER
// THAN FIRING ON EVERY QUERY. "warn when elapsed >= threshold" would make 0
// mean "every statement is slow" the moment a caller passed an unset value.
// Silently turning every query into a warning is a worse surprise than
// logging none, so <= 0 means off. `defaultSlowThresholdMs` is the one place
// 200ms (#5075) is spelled out.
//
// THE ROW COUNT NAMES WHAT DURATION ALONE CANNOT. A query slow because it
// returned 400000 rows and a query slow because it scanned a table for one
// matching row are different bugs with the same duration — `QueryLog.wrap`'s
// `Rows` decorator (`countingRows` below) counts every row the CALLER
// actually reads and logs it beside the duration once the cursor closes.
//
// THE LOGGER CANNOT TURN A WORKING QUERY INTO A FAILED ONE. `Record.log` has
// no `!` — std/log drops a failed write — so there is no failure path out of
// a log write for this file to swallow. Nothing in this file changes a
// statement's SQL text or arguments, retries it, or turns a driver failure
// into a success — every wrapper below forwards to `inner` and only observes.
//
// A FAILED STATEMENT'S TEXT AND THE DRIVER'S MESSAGE ARE SEPARATE
// ATTRIBUTES (`sql`, `error`), never one interpolated string joining them —
// a driver message that echoes a bound value back (a constraint violation
// naming the offending value, say) must not be reassembled against this
// statement's own text into the pair a caller never asked to have logged
// together. std/log's text handler quotes and escapes both, so a message
// holding a newline cannot start a line of its own.
//
// #5381: THE DRIVER'S MESSAGE IS REDACTED. A constraint violation's own
// message routinely echoes the value back (Postgres's `DETAIL:  Key
// (email)=(...) already exists.`; MySQL's `Duplicate entry '...' for key
// '...'`). The error path is the one most likely to leave the machine
// (pasted into a ticket, a chat, an incident doc). `redactErrorMessage`
// below documents exactly which shapes it covers and which it does not.
//
// THE DISABLED PATH. A level the logger has off hands back std/log's shared
// no-op record, so the chain of attribute calls allocates nothing and needs
// no `enabled` guard; the success path builds no string at all. Only the
// failure path guards, because `redactErrorMessage` builds strings before
// any attribute exists.
//
// NOT IMPORTED FROM pkg/web. Packages are released independently
// (pkg/README.md); the only shared contract is std/log.

// `indexOf` as `strIndexOf` — `pkg/orm/runner.test.bit` already declares
// its own package-local `indexOf(log: []string, needle: string): int` (a
// log-line search, different signature), and a Bit import binds
// package-wide (postgres.bit's own header) — a bare `indexOf` here would
// collide, E0042.
import { indexOf as strIndexOf, indexOfFrom, trimRight } from "std/strings"
// `Logger` binds package-wide: `db.bit`'s `Options.logger` and `scoped.bit`'s
// `SystemDb` use it without a second import (a second one is E0042).
import { Logger, LevelError, getDefault } from "std/log"

const defaultSlowThresholdMs: int = 200
const redactedPlaceholder: string = "[redacted]"

// Every statement issued through a `QueryLog.wrap`ped `Data`: one std/log
// record each, and the #5061 statement counter a caller — this package's own
// tests, or an application checking its own handler — can assert against.
//
// `QueryLog(logger)` takes the 200ms slow-query threshold #5075 specified;
// `QueryLog(logger, ms)` gives one explicitly, and `<= 0` turns the warning
// off (this file's header).
export class QueryLog {
  logger: Logger
  slowThresholdMs: int
  export statementCount: int

  init(logger: Logger, slowThresholdMs: int = defaultSlowThresholdMs) {
    this.logger = logger
    this.slowThresholdMs = slowThresholdMs
    this.statementCount = 0
  }

  // Wraps `db` so every `query`/`exec` it runs is logged and counted. The
  // result is itself `Data` — a drop-in anywhere the `Pool` or transaction
  // handle it wraps is accepted, per pkg/orm/data.bit's own header.
  export wrap(db: Data): Data {
    return loggingExecutor{ inner = db, log = this }
  }
}

// The `Logger` a `Db` writes its own events to: `Options.logger` when the
// caller set one, std/log's process default when it did not — resolved at
// each use, so a `setDefault` after `open` still takes effect.
fn dbLogger(db: Db): Logger {
  if (isSome(db.logger)) {
    return unwrap(db.logger)
  }
  return getDefault()
}

// The `Data` `QueryLog.wrap` returns. Forwards every call to `inner`
// unchanged — see this file's header for why nothing here can turn a
// working query into a failed one, or a failed one into a working one.
class loggingExecutor {
  inner: Data
  log: QueryLog

  query(sqlText: string, params: []Value): Rows! {
    this.log.statementCount = this.log.statementCount + 1
    let start = monotonic()
    let rows = this.inner.query(sqlText, params) catch e {
      logFailure(this.log, sqlText, e)
      fail e
    }
    return countingRows{
      inner = rows,
      sqlText = sqlText,
      log = this.log,
      start = start,
      n = 0,
    }
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    this.log.statementCount = this.log.statementCount + 1
    let start = monotonic()
    let res = this.inner.exec(sqlText, params) catch e {
      logFailure(this.log, sqlText, e)
      fail e
    }
    logStatement(this.log, sqlText, since(start), res.rowsAffected)
    return res
  }
}

// Wraps the `Rows` a logged `query` returned so the row count a slow-query
// entry names (this file's header) reflects what the CALLER actually read.
// Logging happens at `close()`, once iteration is over — never by this
// file consuming the cursor itself ahead of the caller.
class countingRows {
  inner: Rows
  sqlText: string
  log: QueryLog
  start: Mono
  n: int

  next(): bool! {
    let more = this.inner.next()?
    if (more) {
      this.n = this.n + 1
    }
    return more
  }

  columns(): []string {
    return this.inner.columns()
  }

  value(col: int): Value {
    return this.inner.value(col)
  }

  close() {
    logStatement(this.log, this.sqlText, since(this.start), this.n)
    this.inner.close()
  }
}

// The one place a statement record is written: INFO `statement` always, then
// a separate WARN `slow statement` when `tookNs` clears the configured
// threshold (this file's header — <= 0 never fires). `rows` is the
// returned-row count for a `query`, the affected-row count for an `exec`.
fn logStatement(q: QueryLog, sqlText: string, tookNs: int, rows: int) {
  q.logger.info().str("sql", sqlText).int("rows", rows).duration("took", tookNs).log("statement")
  if (q.slowThresholdMs > 0 && tookNs >= q.slowThresholdMs * Millisecond) {
    q.logger.warn().str("sql", sqlText).int("rows", rows).duration("took", tookNs).log("slow statement")
  }
}

// A statement the driver rejected: the SQL text (never a value — SQL text
// alone is already safe, `pkg/orm/query.bit`'s own header) and the driver's
// own message as a separate attribute — see this file's header for why never
// one string. The message is redacted (#5381, `redactErrorMessage` below).
fn logFailure(q: QueryLog, sqlText: string, e: error) {
  if (!q.logger.enabled(LevelError)) {
    return
  }
  q.logger.error().str("sql", sqlText).err(newError(redactErrorMessage(e.message()))).log("statement failed")
}

// Redacts the value(s) a driver's own error message echoes back, without
// discarding the constraint or error class that makes the line actionable.
// Three shapes, chosen from what Postgres and MySQL actually emit for a
// rejected write — NOT from any one illustration, since a rule that only
// matches the ticket's own example is not a rule:
//
//   POSTGRES, CONSTRAINT VIOLATIONS put the offending value(s) in a DETAIL
//   line: `duplicate key value violates unique constraint
//   "users_email_key"` / `DETAIL:  Key (email)=(secret@example.com) already
//   exists.` A not-null or check violation's DETAIL is `Failing row contains
//   (...)` — the whole row, not one column. Both are handled the same way:
//   everything from the first `DETAIL:` onward is dropped. The primary line
//   survives untouched and already names the constraint.
//
//   POSTGRES, CAST/TYPE/RANGE ERRORS put the value in the PRIMARY line, no
//   DETAIL at all: `invalid input syntax for type integer: "4111111111111111"`,
//   `invalid input syntax for type uuid: "not-a-uuid"`,
//   `date/time field value out of range: "2026-13-45"`. An EARLIER, WRONG
//   version of this comment claimed Postgres never puts a value in the
//   primary line — false, and this is the common case a failed cast hits
//   every time a caller passes a malformed card number, token or date. The
//   discriminator is punctuation, not meaning, the same as the MySQL rule
//   below: a double-quoted span is a VALUE when it immediately follows `:`
//   (only spaces between), and an IDENTIFIER when it follows a word
//   (`constraint "users_email_key"`, `column "email" of relation
//   "widgets"` — a keyword or name, never a bare colon, precedes those).
//   `redactColonQuoted` redacts only the first kind.
//
//   MYSQL quotes the offending value in single quotes on ONE line:
//   `Duplicate entry 'secret@example.com' for key 'users.email_key'`,
//   `Incorrect integer value: 'abc' for column 'age'`. Postgres never
//   single-quotes anything in its primary line (identifiers are
//   double-quoted), so redacting every single-quoted span is safe for
//   Postgres and catches both MySQL shapes. THE COST: MySQL quotes the KEY
//   NAME the same way ("for key '...'"), so it is redacted along with the
//   value — accepted, since punctuation alone cannot tell a MySQL value
//   quote from a MySQL identifier quote, and the column list earlier in the
//   same message usually still names the field.
//
// NOT HANDLED: a driver that embeds a bare, undelimited value in otherwise
// free-form prose (no DETAIL line, no quotes) is indistinguishable from any
// other word in the sentence and cannot be redacted without destroying the
// message — logged as-is. Also not handled: a hypothetical message quoting
// an IDENTIFIER immediately after a bare colon (`word: "identifier"`) would
// be redacted as if it were a value — no such shape appears in Postgres's
// or MySQL's own error catalogs, but the discriminator cannot rule it out
// by construction. This is a real, named gap, not a claim of total
// coverage.
fn redactErrorMessage(msg: string): string {
  let detailAt = strIndexOf(msg, "DETAIL:")
  let primary = msg
  if (detailAt >= 0) {
    primary = trimRight(msg[0:detailAt], " \n\t")
  }
  return redactColonQuoted(redactSingleQuoted(primary))
}

// Every single-quoted span in `s` becomes `'[redacted]'` — see
// `redactErrorMessage` for why that is the safe general rule here. Bounded:
// `i` strictly increases every iteration, by at least 1.
fn redactSingleQuoted(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\'') {
      let closeAt = indexOfFrom(s, "'", i + 1)
      if (closeAt >= 0) {
        out = out + "'" + redactedPlaceholder + "'"
        i = closeAt + 1
        continue
      }
    }
    out = out + s[i:i + 1]
    i = i + 1
  }
  return out
}

// Every double-quoted span in `s` immediately preceded by `:` (only spaces
// between) becomes `"[redacted]"`; every other double-quoted span (an
// identifier, preceded by a word) is left untouched — see
// `redactErrorMessage` for the Postgres shapes this covers and its named
// gap. Bounded: `i` strictly increases every iteration, by at least 1.
fn redactColonQuoted(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    if (s[i] == '"') {
      let closeAt = indexOfFrom(s, "\"", i + 1)
      if (closeAt >= 0 && precededByColon(s, i)) {
        out = out + "\"" + redactedPlaceholder + "\""
        i = closeAt + 1
        continue
      }
    }
    out = out + s[i:i + 1]
    i = i + 1
  }
  return out
}

// Whether the nearest non-space character before `s[at]` (the opening
// quote) is `:` — the value/identifier discriminator `redactColonQuoted`
// uses. Bounded: `i` strictly decreases every iteration, from `at`.
fn precededByColon(s: string, at: int): bool {
  let i = at - 1
  while (i >= 0 && s[i] == ' ') {
    i = i - 1
  }
  return i >= 0 && s[i] == ':'
}
