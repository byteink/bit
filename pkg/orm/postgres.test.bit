// pkg/orm/postgres.test.bit — #5066's acceptance: exact rendered DDL text
// for every SchemaOp kind, every ColumnType schema.bit actually carries,
// every AlterOp kind, drop, and the two security/operational rules a
// renderer must not get wrong: an identifier that tries to break out of
// its quoting stays inertly inside it, and a CONCURRENTLY raw statement is
// flagged non-transactional.
//
// EVERY ASSERTION IS AN EXACT STRING COMPARE, NOT A SHAPE CHECK - the
// acceptance's own words. A renderer that emitted the right keywords in
// the wrong order, or dropped a space, would fail these the same way a
// wrong keyword would.
//
// `contains`/`toUpper` are not imported here - postgres.bit/query.test.bit
// already import them and a Bit import binds package-wide (see
// postgres.bit's own header on this).

// Continues docs/schema.md's own `people`/`teams` example: an id, a
// unique string, a plain string with a length, a nullable text, a
// not-null bool, a nullable timestamp, a foreign key with its own column,
// an index on it, and a raw CONCURRENTLY passthrough - one CreateTable
// covering every ColumnType variant and both index paths at once.
test "Postgres.render(CreateTable): every column type, a foreign key, an index and a raw CONCURRENTLY passthrough" {
  let op = table("people", (t) => {
    t.id("id")
    t.string("name", 100)
    t.string("email", 255).unique()
    t.text("bio").nullable()
    t.bool("is_active")
    t.timestamp("joined_at").nullable()
    t.int("team_id")
    t.index("team_id")
    t.foreign("team_id").references("teams", "id").onDelete(ReferentialAction.Cascade)
    t.raw("CREATE INDEX CONCURRENTLY people_email_lower_idx ON people (lower(email))")
  })

  let stmts = Postgres{}.render(op)
  assert(len(stmts) == 3, "statement count: ${len(stmts)}")

  let want = "create table \"people\" (\n" +
    "  \"id\" bigint generated always as identity primary key,\n" +
    "  \"name\" varchar(100) not null,\n" +
    "  \"email\" varchar(255) not null unique,\n" +
    "  \"bio\" text,\n" +
    "  \"is_active\" boolean not null,\n" +
    "  \"joined_at\" timestamptz,\n" +
    "  \"team_id\" bigint not null,\n" +
    "  constraint \"people_team_id_fkey\" foreign key (\"team_id\") references \"teams\" (\"id\") on delete cascade\n" +
    ");"
  assert(stmts[0].sql == want, "create table sql:\n${stmts[0].sql}")
  assert(stmts[0].transactional, "create table statement must be transactional")

  assert(
    stmts[1].sql == "create index \"people_team_id_idx\" on \"people\" (\"team_id\");",
    "index sql: ${stmts[1].sql}",
  )
  assert(stmts[1].transactional, "a t.index() statement must be transactional")

  assert(
    stmts[2].sql == "CREATE INDEX CONCURRENTLY people_email_lower_idx ON people (lower(email))",
    "raw sql was not carried verbatim: ${stmts[2].sql}",
  )
  assert(!stmts[2].transactional, "a CONCURRENTLY raw statement must be flagged non-transactional")
}

// `t.id` never renders `serial` - Postgres' own docs discourage it, and it
// leaves a sequence with separate ownership (this ticket's own constraint).
test "Postgres.render(CreateTable): t.id is an identity column, never serial" {
  let op = table("widgets", (t) => {
    t.id("id")
  })
  let stmts = Postgres{}.render(op)
  assert(
      stmts[0].sql ==
      "create table \"widgets\" (\n  \"id\" bigint generated always as identity primary key\n);",
    "id column sql: ${stmts[0].sql}",
  )
  assert(!contains(stmts[0].sql, "serial"), "must not contain 'serial': ${stmts[0].sql}")
}

// A foreign key with no `.references(...)` is a caller bug that must
// surface here rather than rendering silently - `foreignKeyDef`
// (postgres.bit) panics naming the column and table, the same category
// `pkg/orm/write.bit`'s own `valueFor`/`primaryKeyField` panic for. Not
// exercised as a `test` here: a panic is process-fatal in Bit (see
// pkg/web/csrf.test.bit's own note that a panic assertion "PASSES only if
// the process really panics"), so this codebase proves one through an
// external harness, not an in-process `catch` - out of scope for this
// package's own unit suite.

// AddColumn, DropColumn and RenameColumn each render their own statement
// shape - RenameColumn in particular must contain neither DROP nor ADD,
// the acceptance's own words, since a dialect that lost the distinction
// would silently destroy the column's data (schema.bit's own header).
test "Postgres.render(AlterTable): add, drop and rename each render distinctly" {
  let op = alter("people", (t) => {
    t.addString("phone", 20).nullable()
    t.dropColumn("legacy_flag")
    t.renameColumn("email", "email_address")
  })
  let stmts = Postgres{}.render(op)
  assert(len(stmts) == 3, "statement count: ${len(stmts)}")

  assert(
    stmts[0].sql == "alter table \"people\" add column \"phone\" varchar(20);",
    "add column sql: ${stmts[0].sql}",
  )
  assert(
    stmts[1].sql == "alter table \"people\" drop column \"legacy_flag\";",
    "drop column sql: ${stmts[1].sql}",
  )

  let renameSql = stmts[2].sql
  assert(
    renameSql == "alter table \"people\" rename column \"email\" to \"email_address\";",
    "rename column sql: ${renameSql}",
  )
  // "ADD"/"DROP" as bare substrings false-positive on ordinary column text
  // ("email_ADDress"), so this checks the SQL keyword shapes a
  // drop-then-add split would actually render, not the letters.
  assert(
    !contains(toUpper(renameSql), "DROP COLUMN"),
    "renameColumn must not render DROP COLUMN: ${renameSql}",
  )
  assert(
    !contains(toUpper(renameSql), "ADD COLUMN"),
    "renameColumn must not render ADD COLUMN: ${renameSql}",
  )
}

// drop(): a bare DROP TABLE, identifier quoted like every other statement.
test "Postgres.render(DropTable): a quoted DROP TABLE" {
  let op = drop("legacy_events")
  let stmts = Postgres{}.render(op)
  assert(len(stmts) == 1, "statement count: ${len(stmts)}")
  assert(stmts[0].sql == "drop table \"legacy_events\";", "drop table sql: ${stmts[0].sql}")
  assert(stmts[0].transactional, "drop table statement must be transactional")
}

// SECURITY: an identifier carrying a double quote (the one character that
// can end a Postgres quoted identifier) is neutralised by doubling it, not
// rejected and not passed through - the same table name a naive renderer
// would let break out of its quoting and inject a second statement.
test "Postgres.render: an identifier containing a double quote cannot break out of its quoting" {
  let op = table("widgets\"; drop table users; --", (t) => {
    t.id("id")
  })
  let stmts = Postgres{}.render(op)
  // Exact match, not a substring check: the entire hostile fragment,
  // including its own embedded `;` and `--`, must stay INSIDE the doubled,
  // quoted identifier - proven by the whole statement matching this one
  // string, with exactly one `CREATE TABLE` and one trailing `;`, not by
  // scanning for characters that are also legitimate table-name bytes.
  let want = "create table \"widgets\"\"; drop table users; --\" (\n" +
    "  \"id\" bigint generated always as identity primary key\n" +
    ");"
  assert(stmts[0].sql == want, "hostile identifier was not fully neutralised:\n${stmts[0].sql}")
}
