// pkg/orm/relationauto.test.bit — R1's own acceptance (#6302, epic #6298):
// `for post in posts.all()? { post.author.name }` issues exactly 2
// statements (the row query, then one join-free relation load —
// `pkg/orm/relationload.bit`'s `belongsToRelation`), and the identical loop
// reading only `post.title` issues exactly 1 — proving
// `compiler/relationauto.bit`/`relationautosplice.bit` spliced `.with(
// "author")` into the first function and left the second alone. R2's own
// acceptance (#6305) is the same 2-statement proof across a function
// boundary two ways: `relAutoReadAuthorNamesViaParam` passes the row into
// `relAutoTouchAuthorName`, which reads the relation; `relAutoLoadPosts`
// runs the query and the CALLER reads the relation off its return value —
// `compiler/relationautocalls.bit`'s call-graph fixed point. #6318's own
// acceptance (nested reads): `relAutoReadAuthorPostTitles` reads
// `post.author.posts` — TWO relation hops off one `find()` — in exactly 3
// statements, proving the auto-loader records "author.posts" as ONE dotted
// path (`compiler/relationauto.bit`'s `relationAutoResolveMember`) that
// `dispatchLoadRelation` (`pkg/orm/relationload.bit`) then loads one hop at
// a time.
//
// `pool`/`Datasource`/`Value`/`env` are already bound package-wide by this
// module's other files (a Bit import binds package-wide, `log.bit`'s own
// header), so this file does not reimport them — only `adapter`, whose only
// existing binding (`db.bit`'s own `import { adapter as postgresAdapter }
// from "postgres"`) is aliased and so leaves the bare name unbound.
// `Repo<T>`/`ServerDialect`/`Logger`/`newLogger`/`Data` are declared IN this
// module (repo.bit/data.bit/log.bit) and need no import at all.
//
// R2b's own acceptance (#6322,
// `_tests_/bit/ormrelauto/relautoc/relautoc.test.bit`): a class synthesizing
// `Tabled`'s relation statics needs its own module to import "orm" by
// PACKAGE name, which only resolves for a module OUTSIDE pkg/orm's own
// tree — so `RelAutoPost`/`RelAutoAuthor` stay declared HERE, exported, and
// this file exports a QUERY-only wrapper (`relAutoQueryPostsForCrossModule`)
// for a different module's own function to call across the boundary. This
// file does NOT import the fixture modules under `_tests_/bit/ormrelauto/`
// itself: one of them imports THIS module back for the row type, so this
// module importing it too would be a cycle (E0044) —
// `_tests_/bit/ormrelauto/relautoc/relautoc.test.bit`'s own header has the
// full shape.
import { adapter } from "postgres"
//
// `Repo<T>.db: Data` and every other field this file's own
// `newRelAutoRepo` composite-literals are module-PRIVATE, not exported —
// reachable here because a directory's `.bit` files share one namespace
// (SPEC §17.1), the same access `repo.test.bit`'s comment on `Db.pool`
// already describes for the sibling that needs it. This is what lets the
// query-count proof skip `Db`/`open()` (neither has a hook to wrap the
// pool in a `Logger`) and build a `Repo<RelAutoPost>` directly around one.
//
// TABLE NAMES ARE PREFIXED (`relauto_...`) to avoid colliding with
// `repo.test.bit`'s own `author`/`post` tables in the same live database.

class relAutoSink {
  lines: []string
  export log(line: string) {
    this.lines = append(this.lines, line)
  }
}

// `export`ed (R2b, #6322): `_tests_/bit/ormrelauto/relautox`'s own
// `relAutoXTouchAuthorName` takes a `RelAutoPost` parameter, so this file's
// own query below and that function's read must agree on ONE class — never
// a redeclaration in the other module. Same-module access (this file's own
// `newRelAutoPostRepo` composite literals, below) ignores `export` entirely
// (SPEC §17.1's one namespace per directory); only the cross-module import
// needs it.
export @table("relauto_author") class RelAutoAuthor {
  export id: i64
  export name: string
  @hasMany("authorId")
  export posts: []RelAutoPost
}

export @table("relauto_post") class RelAutoPost {
  export id: i64
  export authorId: i64
  export title: string
  @belongsTo("authorId")
  export author: RelAutoAuthor
}

fn newRelAutoPostRepo(db: Data): Repo<RelAutoPost> {
  return Repo<RelAutoPost>{
    db = db, dialect = ServerDialect.Postgres, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false,
    withNames = []string(0), errText = "", includeDeleted = false, sets = []string(0),
  }
}

// The `RelAutoAuthor` sibling of the constructor above, used only by
// `relAutoSeedCrossModuleFixture` below.
fn newRelAutoAuthorRepo(db: Data): Repo<RelAutoAuthor> {
  return Repo<RelAutoAuthor>{
    db = db, dialect = ServerDialect.Postgres, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false,
    withNames = []string(0), errText = "", includeDeleted = false, sets = []string(0),
  }
}

// Same-function relation read (#6302's own R1 acceptance shape, "relations
// load themselves"): the query call and the `.author.name` read are both
// here, so the compiler must splice `.with("author")` in — no explicit
// `.with(...)` is written.
fn relAutoReadAuthorNames(posts: Repo<RelAutoPost>): []string! {
  let names = []string(0)
  for post of posts.all()? {
    names = append(names, post.author.name)
  }
  return names
}

// The identical loop shape, reading only a plain (non-relation) field — the
// splice must add nothing here.
fn relAutoReadTitles(posts: Repo<RelAutoPost>): []string! {
  let titles = []string(0)
  for post of posts.all()? {
    titles = append(titles, post.title)
  }
  return titles
}

// R2's own acceptance (#6305, "across function parameters"): the query
// call is here, but the `.author.name` read is in a DIFFERENT function,
// reached by passing the row across the call — the splice must still land
// on THIS function's `posts.all()?`.
fn relAutoTouchAuthorName(post: RelAutoPost): string {
  return post.author.name
}

fn relAutoReadAuthorNamesViaParam(posts: Repo<RelAutoPost>): []string! {
  let names = []string(0)
  for post of posts.all()? {
    names = append(names, relAutoTouchAuthorName(post))
  }
  return names
}

// R2's own acceptance ("and return values"): the query call is inside a
// HELPER function; the `.author.name` read is in the caller, off the
// helper's own return value — the splice must land on the query call
// inside `relAutoLoadPosts`, not anywhere in the caller.
fn relAutoLoadPosts(posts: Repo<RelAutoPost>): []RelAutoPost! {
  return posts.all()?
}

fn relAutoReadAuthorNamesViaReturn(posts: Repo<RelAutoPost>): []string! {
  let names = []string(0)
  for post of relAutoLoadPosts(posts)? {
    names = append(names, post.author.name)
  }
  return names
}

// R2b's own acceptance (#6322): the query call is HERE, in `pkg/orm` —
// `_tests_/bit/ormrelauto/relautoc/relautoc.test.bit` calls this ACROSS the
// module boundary and reads `.author.name` off its RETURN VALUE inside
// `_tests_/bit/ormrelauto/relautox`'s `relAutoXTouchAuthorName`, a THIRD
// module, called with a NAMED argument (`post = post`, SPEC §12.11).
// Exported (this file's own header: this module cannot import either of the
// other two without an E0044 cycle) — the splice must still land on THIS
// function's `posts.all()?`.
export fn relAutoQueryPostsForCrossModule(posts: Repo<RelAutoPost>): []RelAutoPost! {
  return posts.all()?
}

// #6318's own acceptance: `posts.find(id)?` then reading `post.author.posts`
// (a NESTED read, two relation hops) issues exactly 3 statements — the row
// query, `.with("author")`'s own join-free load (belongsTo), and a FURTHER
// `.with("author.posts")` load on the loaded author (hasMany) — proving the
// auto-loader records the nested read as ONE dotted path rather than two
// flat ones, and `dispatchLoadRelation`/`hasManyRelation`/`belongsToRelation`
// (pkg/orm/relationload.bit) load it one relation hop at a time, never N+1.
fn relAutoReadAuthorPostTitles(posts: Repo<RelAutoPost>, id: i64): []string! {
  let post = posts.find(Value.Int(id))?
  let titles = []string(0)
  for p of post.author.posts {
    titles = append(titles, p.title)
  }
  return titles
}

fn relAutoSetupSchema(uri: string): ()! {
  let setup = pool(adapter(), Datasource{ uri = uri })?
  setup.exec("drop table if exists relauto_post", []Value(0))?
  setup.exec("drop table if exists relauto_author", []Value(0))?
  setup.exec(
    "create table relauto_author (id bigint generated always as identity primary key, name text not null)",
    []Value(0),
  )?
  setup.exec(
    "create table relauto_post (id bigint generated always as identity primary key, author_id bigint not null, title text not null)",
    []Value(0),
  )?
  setup.close()
}

// R2b's own acceptance (#6322): the WHOLE live-db setup — schema, pool,
// two seeded posts, the query-counting `Logger` wrap (`log.bit`) — stays in
// THIS module, the one with "postgres"/"mysql" as its own `bit.lock`
// dependencies, so `_tests_/bit/ormrelauto/relautoc/relautoc.test.bit` never
// needs a copy of either: only the already-wrapped `Repo<RelAutoPost>` and
// its `Logger` (`statementCount`, exported) cross the module boundary, both
// by return value.
export fn relAutoSeedCrossModuleFixture(uri: string): (Repo<RelAutoPost>, Logger)! {
  relAutoSetupSchema(uri)?
  let seedPool = pool(adapter(), Datasource{ uri = uri })?
  let ada = newRelAutoAuthorRepo(seedPool).insert(
    RelAutoAuthor{ id = 0, name = "Ada", posts = []RelAutoPost(0) },
  )?
  let seedPosts = newRelAutoPostRepo(seedPool)
  seedPosts.insert(RelAutoPost{ id = 0, authorId = ada.id, title = "Loops", author = ada })?
  seedPosts.insert(RelAutoPost{ id = 0, authorId = ada.id, title = "Closures", author = ada })?
  let logger = newLogger(relAutoSink{ lines = []string(0) })
  return (newRelAutoPostRepo(logger.wrap(seedPool)), logger)
}

test "live: R1 auto-with — a function reading post.author.name issues exactly 2 statements, a sibling reading only title issues 1 (#6302)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  relAutoSetupSchema(uri) catch e {
    assert(false, "schema setup failed: ${e.message()}")
    return
  }

  let seedPool = pool(adapter(), Datasource{ uri = uri }) catch e {
    assert(false, "seed pool failed: ${e.message()}")
    return
  }
  let seedAuthors = Repo<RelAutoAuthor>{
    db = seedPool, dialect = ServerDialect.Postgres, wheres = []string(0), args = []Value(0),
    orderBys = []string(0), limitN = 0, hasLimit = false, offsetN = 0, hasOffset = false,
    withNames = []string(0), errText = "", includeDeleted = false, sets = []string(0),
  }
  let ada = seedAuthors.insert(RelAutoAuthor{ id = 0, name = "Ada", posts = []RelAutoPost(0) }) catch e {
    assert(false, "insert author failed: ${e.message()}")
    return
  }
  let seedPosts = newRelAutoPostRepo(seedPool)
  let loopsPost = seedPosts.insert(
    RelAutoPost{ id = 0, authorId = ada.id, title = "Loops", author = ada },
  ) catch e {
    assert(false, "insert post failed: ${e.message()}")
    return
  }
  seedPosts.insert(
    RelAutoPost{ id = 0, authorId = ada.id, title = "Closures", author = ada },
  ) catch e {
    assert(false, "insert post failed: ${e.message()}")
    return
  }

  let twoQuerySink = relAutoSink{ lines = []string(0) }
  let twoQueryLogger = newLogger(twoQuerySink)
  let names = relAutoReadAuthorNames(newRelAutoPostRepo(twoQueryLogger.wrap(seedPool))) catch e {
    assert(false, "relAutoReadAuthorNames failed: ${e.message()}")
    return
  }
  assert(len(names) == 2, "expected 2 posts, got ${len(names)}")
  assert(names[0] == "Ada" && names[1] == "Ada", "post.author.name must read the loaded author")
  assert(
    twoQueryLogger.statementCount == 2,
    "reading post.author.name must issue exactly 2 statements (the auto '.with(\"author\")' splice), got ${twoQueryLogger.statementCount}",
  )

  let oneQuerySink = relAutoSink{ lines = []string(0) }
  let oneQueryLogger = newLogger(oneQuerySink)
  let titles = relAutoReadTitles(newRelAutoPostRepo(oneQueryLogger.wrap(seedPool))) catch e {
    assert(false, "relAutoReadTitles failed: ${e.message()}")
    return
  }
  assert(len(titles) == 2, "expected 2 posts, got ${len(titles)}")
  assert(
    oneQueryLogger.statementCount == 1,
    "reading only post.title must issue exactly 1 statement (no relation splice), got ${oneQueryLogger.statementCount}",
  )

  let paramSink = relAutoSink{ lines = []string(0) }
  let paramLogger = newLogger(paramSink)
  let namesViaParam = relAutoReadAuthorNamesViaParam(
    newRelAutoPostRepo(paramLogger.wrap(seedPool)),
  ) catch e {
    assert(false, "relAutoReadAuthorNamesViaParam failed: ${e.message()}")
    return
  }
  assert(len(namesViaParam) == 2, "expected 2 posts, got ${len(namesViaParam)}")
  assert(
    namesViaParam[0] == "Ada" && namesViaParam[1] == "Ada",
    "relAutoTouchAuthorName's own post.author.name must read the loaded author",
  )
  assert(
    paramLogger.statementCount == 2,
    "reading post.author.name across a function PARAMETER must still issue exactly 2 statements (#6305), got ${paramLogger.statementCount}",
  )

  let returnSink = relAutoSink{ lines = []string(0) }
  let returnLogger = newLogger(returnSink)
  let namesViaReturn = relAutoReadAuthorNamesViaReturn(
    newRelAutoPostRepo(returnLogger.wrap(seedPool)),
  ) catch e {
    assert(false, "relAutoReadAuthorNamesViaReturn failed: ${e.message()}")
    return
  }
  assert(len(namesViaReturn) == 2, "expected 2 posts, got ${len(namesViaReturn)}")
  assert(
    namesViaReturn[0] == "Ada" && namesViaReturn[1] == "Ada",
    "post.author.name off relAutoLoadPosts' RETURN VALUE must read the loaded author",
  )
  assert(
    returnLogger.statementCount == 2,
    "reading post.author.name off a helper's RETURN VALUE must still issue exactly 2 statements (#6305), got ${returnLogger.statementCount}",
  )

  let nestedSink = relAutoSink{ lines = []string(0) }
  let nestedLogger = newLogger(nestedSink)
  let postTitles = relAutoReadAuthorPostTitles(
    newRelAutoPostRepo(nestedLogger.wrap(seedPool)), loopsPost.id,
  ) catch e {
    assert(false, "relAutoReadAuthorPostTitles failed: ${e.message()}")
    return
  }
  assert(
    len(postTitles) == 2,
    "expected 2 sibling posts via post.author.posts, got ${len(postTitles)}",
  )
  let hasLoops = false
  let hasClosures = false
  for t of postTitles {
    if (t == "Loops") {
      hasLoops = true
    }
    if (t == "Closures") {
      hasClosures = true
    }
  }
  assert(
    hasLoops && hasClosures,
    "post.author.posts must read both of the author's own sibling posts",
  )
  assert(
    nestedLogger.statementCount == 3,
    "reading post.author.posts (a NESTED relation, #6318) must issue exactly 3 statements (find + author + author.posts), got ${nestedLogger.statementCount}",
  )
}
