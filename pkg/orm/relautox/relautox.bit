// further, like `.../pkg/orm/relautox`, is not). Reported separately
// (#6322's own comment thread); out of THIS ticket's scope, which is the
// relation-READ analysis, not `Tabled` static synthesis. Only the
// FUNCTION crosses the module boundary here.
import { RelAutoPost } from "../"

export fn relAutoXTouchAuthorName(post: RelAutoPost): string {
  return post.author.name
}
