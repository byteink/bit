// pkg/orm/relautox/relautox.bit — R2b (#6322, epic #6298) live acceptance
// fixture: a DIFFERENT module than `pkg/orm/relationauto.test.bit`'s own
// `pkg/orm` (SPEC §17.1: a directory is one module). `RelAutoXPost`/
// `RelAutoXAuthor` and the relation-touching function all live HERE;
// `pkg/orm/relationauto.test.bit` runs the query and calls
// `relAutoXTouchAuthorName` across this module boundary, by a NAMED
// argument (`post = post`) — the two gaps R2 (#6305) left unprovable by
// design (`relationautocalls.bit`'s own header: "a call into another
// module, calls with NamedArg/ArgSpread arguments"). This file needs no
// import: a `@table` class and a plain relation read need nothing from
// `pkg/orm` itself, only the compiler's own `@table`/`@belongsTo` attributes.
export @table("relautox_author") class RelAutoXAuthor {
  export id: i64,
  export name: string,
}

export @table("relautox_post") class RelAutoXPost {
  export id: i64
  export authorId: i64
  export title: string
  @belongsTo("authorId")
  export author: RelAutoXAuthor
}

// The relation READ, in THIS module — the query that produces `post` lives
// in `pkg/orm/relationauto.test.bit`, a different module, and calls this
// function with `post` passed by NAME (SPEC §12.11): R2b's own two gaps,
// both exercised by the one call site that reaches here.
export fn relAutoXTouchAuthorName(post: RelAutoXPost): string {
  return post.author.name
}
