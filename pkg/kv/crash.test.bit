// pkg/kv/crash.test.bit — kill -9 mid-commit crash-consistency proof
// (epic #3467, #5725, depends on #5721's closure-scoped `db.write`).
//
// THE PROPERTY. "kill -9 mid-commit, reopen, assert the tree is consistent
// and the last committed transaction survived" (#3467's own words) — nothing
// else in this package actually interrupts a process mid-write, so this file
// is that proof. It never edits db.bit/engine.bit/btree.bit: it only proves
// the commit path #5721 already built is crash-safe, the same way
// `pkg/kv/db.test.bit`'s free-list test proves reuse by mutation rather than
// by reading the source.
//
// MECHANISM: the child is THIS TEST BINARY, re-executed (`selfExe()`, already
// compiled and already exec'd once), entered through the env var
// `crashChildEnv5725` -- the same re-exec `pkg/kv/db.test.bit`'s lock test
// uses (#6119). The old child was a second Bit binary compiled by a
// compiler call inside the test body, which fleet load pushed past `bit test`'s 30s
// per-test bound (#7777). `bit test` runs the binary once per test with
// `BIT_TEST_INDEX` set and the child inherits it, so the child enters this
// same test, sees the env var, and runs `crashChild5725`. It is run through a
// `/bin/sh` wrapper because #5721's lock test measured that `spawn` +
// `std/process.run()` does NOT give this runtime real concurrency for a
// long-blocking child (a spawned `run("/bin/sleep", "2")` stalled this same
// process's own unrelated sleep loop for the full 2s) -- so nothing here
// relies on Bit-level concurrency at all. Instead the
// ENTIRE poll-then-kill sequence runs inside one `/bin/sh` script
// (`crashKillWrapperScript5725`): background the child, poll its progress
// side-file (a plain `std/fs.appendFile` line per committed transaction,
// written outside the kv engine entirely) until it has logged at least
// `targetLines` transactions, `kill -9` it, then `wait` on it -- the wrapper
// is the child's REAL shell parent throughout, so POSIX `wait` reports the
// termination status directly (128+signal), with no orphan-reparenting
// problem to work around.
//
// EVERY ONE OF 10 CYCLES uses a DIFFERENT `targetLines` (1, 3, 5, ..., 19
// logged transactions), exercising different observed progress prefixes.
// These targets do not select internal write/sync/meta-flip phases. Bounded on OBSERVED
// PROGRESS (`wc -l` on the side-file), not on elapsed wall-clock time, so a
// loaded box slows the whole cycle down uniformly rather than producing a
// false miss — this workspace has been burned by fixed wall-clock bounds
// under fleet load before. For the same reason the child never finishes on
// its own: it commits until the kill lands (`crashChildBudgetMs` is only an
// orphan guard), so a descheduled poller can delay the kill but never miss
// it -- a fixed write count let the child exit first and the cycle failed
// 2 of 12 runs beside 450 busy loops (#7777).
//
// THE ASSERTION always runs against a FRESH `open` from this (the parent)
// process, never from the process being killed. Every committed value
// logged through the child's last complete progress line must be present
// after reopen: Db.tx returned before that acknowledgement was written.
// At most one additional transaction can have committed without its ACK.
// Each transaction also replaces an alternating multi-key tuple; its whole
// state must match the recovered version. These process kills do not select
// internal commit phases or simulate power loss.

import { split } from "std/strings"

// How long a child may run before it gives up on its own. Never reached when
// the parent is alive (the wrapper kills the child first); it only stops an
// orphan left by a parent that died mid-cycle from committing forever.
const crashChildBudgetMs: int = 120000

const crashChildEnv5725 = "BIT_KV_CRASH_CHILD"

// The child half: the env var carries the cycle directory, which holds the
// `db` to write and the `progress` side-file to append to. Commits one
// transaction at a time, logging a line after each, until the parent's
// `kill -9` lands (or `crashChildBudgetMs` expires); the 3ms sleep gives
// the shell poller opportunities to observe completed acknowledgements.
fn crashChild5725(cdir: string) {
  let db = open("${cdir}/db") catch e {
    panic("child open: ${e.message()}")
  }
  let i = 1
  let deadline = timeUnixNs() + crashChildBudgetMs * 1000000
  while (timeUnixNs() < deadline) {
    let key = encodeInt(i64(i))
    db.tx((tx) => {
      tx.put(key, key)?
      tx.put(encodeInt(-1), key)?
      tx.put(encodeInt(-2), encodeInt(-i64(i)))?
      tx.put(encodeInt(-3 - i64(i % 2)), key)?
      tx.delete(encodeInt(-4 + i64(i % 2)))?
    }) catch e {
      panic("child write: ${e.message()}")
    }
    appendFile("${cdir}/progress", "1\n") catch e {
      panic("child progress: ${e.message()}")
    }
    sleep(3000000)
    i = i + 1
  }
}

// Backgrounds the re-executed test binary, polls its OWN progress side-file (never
// elapsed time) until at least `targetLines` transactions have logged, kills
// it, then `wait`s on it from the SAME shell that backgrounded it — the
// wrapper never exits before the kill, so there is no orphan/reparenting gap
// for `wait` to fall into. `wc -l` counts only newline-terminated lines, so
// a progress line the child was killed while writing is not counted either
// side of this script, matching `countCompleteLines5725` below exactly.
fn crashKillWrapperScript5725(
  exe: string, cdir: string, targetLines: int, maxPollTries: int,
): string {
  let progressPath = "${cdir}/progress"
  return "#!/bin/sh\n" +
    "rm -f '${progressPath}'\n" +
    "${crashChildEnv5725}='${cdir}' '${exe}' < /dev/null > '${cdir}/child.log' 2>&1 &\n" +
    "p=$!\n" +
    "n=0\n" +
    "while [ $n -lt ${maxPollTries} ]; do\n" +
    "  if [ -f '${progressPath}' ]; then\n" +
    "    lines=$(wc -l < '${progressPath}' | tr -d ' ')\n" +
    "  else\n" +
    "    lines=0\n" +
    "  fi\n" +
    "  if [ \"$lines\" -ge ${targetLines} ]; then break; fi\n" +
    "  sleep 0.02\n" +
    "  n=$((n+1))\n" +
    "done\n" +
    "kill -9 $p 2>/dev/null\n" +
    "kill_rc=$?\n" +
    "wait $p\n" +
    "child_rc=$?\n" +
    "printf 'child PID=%s kill_rc=%s wait_rc=%s\\n' \"$p\" \"$kill_rc\" \"$child_rc\"\n" +
    "exit $child_rc\n"
}

// The captured `wait $p` result above reports POSIX's 128+signal via the
// wrapper's own (normal) exit code, not via `osRunBounded`'s separate
// killed-by-signal encoding — the wrapper itself always exits cleanly, it is
// only reporting the GRANDCHILD's status. Mirrors
// `_tests_/bit/childrun/childrun.bit:142`'s `signalName` mapping (module-
// private there too, so replicated rather than imported across modules).
fn crashSignalName5725(sig: int): string {
  if (sig == 6) {
    return "SIGABRT (6)"
  }
  if (sig == 9) {
    return "SIGKILL (9)"
  }
  if (sig == 11) {
    return "SIGSEGV (11)"
  }
  return "signal ${sig}"
}

fn crashChildLog5725(cdir: string): string {
  let log = readFile("${cdir}/child.log") catch _ {
    return "<unreadable>"
  }
  return log
}

// Complete (newline-terminated) lines only — a line the child was mid-write
// on when killed is never counted, on either side of the kill wrapper's own
// `wc -l`.
fn countCompleteLines5725(path: string): int {
  let content = readFile(path) catch _ {
    return 0
  }
  let parts = split(content, "\n")
  let n = len(parts) - 1
  if (n < 0) {
    return 0
  }
  return n
}

class CrashTally5725 { checks: int, failures: int }

fn crashCheck5725(t: CrashTally5725, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn crashValue8171(value: []byte, expected: i64): bool {
  return len(value) == 8 && decodeInt(value) == expected
}

// The scan returns values in key order, so missing the last key must fail
// even when every earlier acknowledged value and the meta version survived.
fn crashHistory8171(values: [][]byte, count: int): bool {
  if (len(values) != count) {
    return false
  }
  let k = 0
  while (k < count) {
    if (!crashValue8171(values[k], i64(k + 1))) {
      return false
    }
    k = k + 1
  }
  return true
}

fn crashTuple8171(values: [][]byte, version: i64): bool {
  if (version == 0) {
    return len(values) == 0
  }
  if (len(values) != 3) {
    return false
  }
  return crashValue8171(values[0], version) &&
    crashValue8171(values[1], -version) &&
    crashValue8171(values[2], version)
}

fn crashJournal8171(db: Db, version: i64): ()! {
  let snapshot = kvReadMeta(db.eng)?
  let state = kvJournalStateOf(snapshot.bytes, snapshot.meta.txid)?
  kvJournalPruned(db.eng, state, snapshot.meta.txid)?
  if (version == 0) {
    return
  }
  let record = kvReadJournal(db.eng, state.root)?
  let touched = 5
  if (version == 1) {
    touched = 4 // The first delete has no previous alternating key to remove.
  }
  if (len(record.keys) != touched || !crashValue8171(record.keys[0], version)) {
    fail newError("journal and tree versions differ")
  }
}

fn crashTupleKeys8171(db: Db, version: i64): ()! {
  let left = get(db.eng, db.root, encodeInt(-1))?
  let right = get(db.eng, db.root, encodeInt(-2))?
  if (!crashValue8171(left, version) || !crashValue8171(right, -version)) {
    fail newError("fixed tuple keys differ from version ${version}")
  }
  let active = get(db.eng, db.root, encodeInt(-3 - version % 2))?
  if (!crashValue8171(active, version)) {
    fail newError("alternating key differs from version ${version}")
  }
}

fn crashRecovered8171(db: Db, loggedCount: int): ()! {
  let version = db.version()?
  if (version < i64(loggedCount) || version > i64(loggedCount) + 1) {
    fail newError("recovered version ${version} outside ACK prefix ${loggedCount}")
  }
  let positiveEnd = append(encodeInt(9223372036854775807), byte(0))
  let history = scan(db.eng, db.root, encodeInt(1), positiveEnd)?
  if (!crashHistory8171(history, int(version))) {
    fail newError("acknowledged history missing or corrupt through version ${version}")
  }
  let key = 1
  while (key <= loggedCount) {
    let value = get(db.eng, db.root, encodeInt(i64(key)))?
    if (!crashValue8171(value, i64(key))) {
      fail newError("acknowledged key ${key} has a corrupt value")
    }
    key = key + 1
  }
  let tuple = scan(db.eng, db.root, encodeInt(-4), encodeInt(0))?
  if (!crashTuple8171(tuple, version)) {
    fail newError("partial multi-key transaction at version ${version}")
  }
  if (version > 0) {
    crashTupleKeys8171(db, version)?
  }
  crashJournal8171(db, version)?
}

// Fresh reopen in the parent, with no handle inherited from the killed child.
fn verifyCrashConsistency5725(dbPath: string, progressPath: string, cycle: int, t: CrashTally5725) {
  let loggedCount = countCompleteLines5725(progressPath)
  let db = open(dbPath) catch e {
    crashCheck5725(t, false, "cycle ${cycle}: fresh reopen failed: ${e.message()}")
    return
  }
  let valid = true
  let detail = "all ACKs and one whole transaction state"
  crashRecovered8171(db, loggedCount) catch e {
    valid = false
    detail = e.message()
  }
  crashCheck5725(t, valid, "cycle ${cycle}: ${detail}")
  db.close()
}

// Groups the run's fixed inputs so `runCrashCycle5725` stays within the
// 5-parameter lint ceiling instead of raising it.
class CrashCycleCfg5725 { exe: string, dir: string, maxPollTries: int }

// One kill-and-reopen cycle: fresh db, run the child under the kill
// wrapper, confirm it died by SIGKILL (never a clean exit -- a child that
// quietly finished before the kill landed proves nothing), then verify.
fn runCrashCycle5725(cfg: CrashCycleCfg5725, cycle: int, targetLines: int, t: CrashTally5725) {
  let cdir = "${cfg.dir}/c${cycle}"
  mkdir(cdir) catch e {
    panic("kv crash test: mkdir ${cdir}: ${e.message()}")
  }
  let dbPath = "${cdir}/db"
  let progressPath = "${cdir}/progress"
  let seed = open(dbPath) catch e {
    panic("kv crash test: open cycle ${cycle}: ${e.message()}")
  }
  seed.close()
  let script = "${cfg.dir}/kill-${cycle}.sh"
  let rc = shellRun5721(
    script,
    crashKillWrapperScript5725(cfg.exe, cdir, targetLines, cfg.maxPollTries),
    45000,
  )
  let sigLabel = crashSignalName5725(rc - 128)
  crashCheck5725(
    t, sigLabel == "SIGKILL (9)",
      "cycle ${cycle}: child must die by SIGKILL, wrapper reports exit ${rc} (${sigLabel}); " +
      "child log: ${crashChildLog5725(cdir)}",
  )
  crashCheck5725(
    t, countCompleteLines5725(progressPath) >= targetLines,
    "cycle ${cycle}: child did not reach ACK target ${targetLines}",
  )
  verifyCrashConsistency5725(dbPath, progressPath, cycle, t)
  println(
      "cycle ${cycle}: targetLines=${targetLines} killed=${sigLabel} loggedCount=" +
      "${countCompleteLines5725(progressPath)} checksSoFar=${t.checks} failuresSoFar=${t.failures}",
  )
}

test "kill -9 mid-commit at 10 varying delays: fresh reopen never sees a torn commit" {
  let childDir = envOr(crashChildEnv5725, "")
  if (len(childDir) > 0) {
    crashChild5725(childDir)
    return
  }
  let dir = crashScratchPath5725("run")
  mkdir(dir) catch e {
    panic("kv crash test: mkdir ${dir}: ${e.message()}")
  }

  let t = CrashTally5725{ checks = 0, failures = 0 }
  // 1000 x 20ms = 20s safety bound on the inner poll.
  let cfg = CrashCycleCfg5725{ exe = selfExe(), dir = dir, maxPollTries = 1000 }
  let cycle = 0
  while (cycle < 10) {
    let targetLines = 1 + cycle * 2 // 1,3,5,...,19: distinct progress targets
    runCrashCycle5725(cfg, cycle, targetLines, t)
    cycle = cycle + 1
  }
  assert(
    t.failures == 0,
      "pkg/kv crash test: ${t.failures} of ${t.checks} checks failed across 10 kill cycles " +
      "-- see the per-cycle lines above for which one and why",
  )
  kvTestTeardown(dir)
}

test "crash recovery oracles reject missing last ACK and mixed transaction tuples" {
  let first = encodeInt(1)
  let second = encodeInt(2)
  assert(crashHistory8171([first, second], 2), "complete ACK prefix rejected")
  assert(!crashHistory8171([first], 2), "missing last ACK accepted")
  assert(crashTuple8171([first, encodeInt(-1), first], 1), "whole prior state rejected")
  assert(crashTuple8171([second, encodeInt(-2), second], 2), "whole next state rejected")
  assert(!crashTuple8171([second, encodeInt(-1), second], 2), "mixed tuple accepted")
  let path = crashScratchPath5725("ack-fixture")
  writeFile(path, "1\n1") catch e {
    panic(e.message())
  }
  assert(countCompleteLines5725(path) == 1, "partial final ACK counted")
  appendFile(path, "\n") catch e {
    panic(e.message())
  }
  assert(countCompleteLines5725(path) == 2, "complete final ACK ignored")
  kvTestTeardown(path)
}

// Low-level root replacement calibrates the reader; this is not a storage crash.
fn crashOracleFixture8171(tag: string): Db {
  let db = open(crashScratchPath5725("oracle-${tag}")) catch e {
    panic(e.message())
  }
  db.tx((tx) => {
    tx.put(encodeInt(1), encodeInt(1))?
    tx.put(encodeInt(-1), encodeInt(1))?
    tx.put(encodeInt(-2), encodeInt(-1))?
    tx.put(encodeInt(-4), encodeInt(1))?
  }) catch e {
    panic(e.message())
  }
  crashRecovered8171(db, 1) catch e {
    panic("valid recovered state rejected: ${e.message()}")
  }
  return db
}

fn crashOracleReject8171(db: Db, expected: string) {
  let observed = ""
  crashRecovered8171(db, 1) catch e {
    observed = e.message()
  }
  assert(observed == expected, "recovered oracle expected ${expected}, got ${observed}")
  db.close()
  kvTestTeardown(db.path)
}

test "crash recovered state rejects future positive keys" {
  let db = crashOracleFixture8171("future-key")
  db.root = put(db.eng, db.root, encodeInt(2), encodeInt(2)) catch e {
    panic(e.message())
  }
  crashOracleReject8171(db, "acknowledged history missing or corrupt through version 1")
}

test "crash recovered state rejects a misplaced fixed tuple key" {
  let db = crashOracleFixture8171("tuple-key")
  db.root = delete(db.eng, db.root, encodeInt(-2)) catch e {
    panic(e.message())
  }
  db.root = put(db.eng, db.root, encodeInt(-3), encodeInt(-1)) catch e {
    panic(e.message())
  }
  crashOracleReject8171(db, "kv: get: key not found")
}

// Namespaced with this ticket's own prefix (`bit-kv-crash-5725-`) rather
// than reusing `db.test.bit`'s `scratchPath5721`: `$TMPDIR` is shared by
// every agent working this workspace concurrently, and a distinct prefix
// keeps this file's scratch paths from ever colliding with a sibling
// ticket's.
fn crashScratchPath5725(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-kv-crash-5725-${tag}-${timeUnixNs()}"
}
