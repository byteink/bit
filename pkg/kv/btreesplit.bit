// A large record inserted between two existing records can require three
// ordered siblings, even though the old page and each record fit individually.
fn kvNodeCount(node: kvNode): int {
  match (node) {
    Leaf(entries) => return len(entries)
    Internal(entries) => return len(entries)
  }
}

fn kvNodeRange(node: kvNode, lo: int, hi: int): kvNode {
  match (node) {
    Leaf(entries) => return kvNode.Leaf(entries[lo:hi])
    Internal(entries) => return kvNode.Internal(entries[lo:hi])
  }
}

fn kvNodeFirstKey(node: kvNode): []byte {
  match (node) {
    Leaf(entries) => return entries[0].key
    Internal(entries) => return entries[0].key
  }
}

fn kvPartitionNode(node: kvNode): []kvNode! {
  let parts: []kvNode = []
  let start = 0
  let size = kvNodeHeaderSize
  let count = kvNodeCount(node)
  for (let i = 0; i < count; i++) {
    let entrySize = kvNodeEncodedSize(kvNodeRange(node, i, i + 1)) - kvNodeHeaderSize
    if (kvNodeHeaderSize + entrySize > kvPageSize) {
      fail newError("kv: entry exceeds page size")
    }
    if (size + entrySize > kvPageSize) {
      parts = append(parts, kvNodeRange(node, start, i))
      start = i
      size = kvNodeHeaderSize
    }
    size = size + entrySize
  }
  parts = append(parts, kvNodeRange(node, start, count))
  return parts
}

fn kvWriteNodeOrSplit(a: kvAllocator, node: kvNode): kvInsertResult! {
  let parts = kvPartitionNode(node)?
  let siblings: []kvInternalEntry = []
  for part of parts {
    let id = a.alloc()?
    a.e.writePage(id, kvEncodeNode(part))?
    if (len(parts) == 1) {
      return kvInsertResult.Replaced(id)
    }
    siblings = append(siblings, kvInternalEntry{ key = kvNodeFirstKey(part), child = id })
  }
  return kvInsertResult.Split(siblings)
}

fn kvApplyInsertRoot(a: kvAllocator, result: kvInsertResult): i64! {
  let current = result
  let bound = 1
  match (current) {
    Replaced(id) => return id
    Split(siblings) => bound = len(siblings)
  }
  for (let level = 0; level < bound; level++) {
    match (current) {
      Replaced(id) => return id
      Split(siblings) => {
        // The first child is the fallback and needs no stored lower bound.
        siblings[0] = kvInternalEntry{ key = []byte(0), child = siblings[0].child }
        current = kvWriteNodeOrSplit(a, kvNode.Internal(siblings))?
        match (current) {
          Replaced(id) => return id
          Split(next) => {
            if (len(next) >= len(siblings)) {
              fail newError("kv: keys exceed branch page capacity")
            }
          }
        }
      }
    }
  }
  fail newError("kv: root split did not converge")
}
