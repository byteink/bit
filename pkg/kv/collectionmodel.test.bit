// Keep the expected records and index membership independent of KV's codecs (#8170).
@json class kvCollectionRecord8170 {
  id: i64,
  group: i64,
  rank: i64,
  body: string,
}

class kvCollectionModel8170 {
  entries: []kvCollectionRecord8170 = []

  find(id: i64): int {
    for (let i = 0; i < len(this.entries); i++) {
      if (this.entries[i].id == id) {
        return i
      }
    }
    return -1
  }

  set(value: kvCollectionRecord8170) {
    let at = this.find(value.id)
    if (at >= 0) {
      this.entries[at] = value
      return
    }
    assert(len(this.entries) < 48, "collection model record bound")
    this.entries = append(this.entries, value)
  }

  delete(id: i64) {
    let kept: []kvCollectionRecord8170 = []
    for entry of this.entries {
      if (entry.id != id) {
        kept = append(kept, entry)
      }
    }
    this.entries = kept
  }

  copy(): kvCollectionModel8170 {
    let copied = kvCollectionModel8170{}
    for entry of this.entries {
      copied.set(
        kvCollectionRecord8170{
          id = entry.id, group = entry.group, rank = entry.rank, body = entry.body,
        },
      )
    }
    return copied
  }

  ordered(index: string, bucket: i64): []kvCollectionRecord8170 {
    let out: []kvCollectionRecord8170 = []
    for (let id = -24; id < 24; id++) {
      let at = this.find(i64(id))
      if (at < 0) {
        continue
      }
      let entry = this.entries[at]
      let key = index == "group" ? entry.group : entry.rank
      if (index == "" || key == bucket) {
        out = append(out, entry)
      }
    }
    return out
  }
}

class kvCollectionRandom8170 {
  state: i64

  next(bound: int): int {
    this.state = this.state * 48271 % 2147483647
    return int(this.state % i64(bound))
  }
}

fn kvCollectionGroup8170(value: kvCollectionRecord8170): []byte {
  return encodeInt(value.group)
}

fn kvCollectionRank8170(value: kvCollectionRecord8170): []byte {
  return encodeInt(value.rank)
}

fn kvCollectionHandle8170(tx: Tx): Collection<kvCollectionRecord8170>! {
  let records = tx.collection<kvCollectionRecord8170>()
  declareIndex<kvCollectionRecord8170>(records, "group", kvCollectionGroup8170)?
  declareIndex<kvCollectionRecord8170>(records, "rank", kvCollectionRank8170)?
  return records
}

fn kvCollectionEqual8170(
  actual: kvCollectionRecord8170, expected: kvCollectionRecord8170, context: string,
) {
  assert(actual.id == expected.id, "${context}: id")
  assert(actual.group == expected.group, "${context}: group")
  assert(actual.rank == expected.rank, "${context}: rank")
  assert(actual.body == expected.body, "${context}: body")
}

fn kvCollectionRows8170(
  actual: []kvCollectionRecord8170, expected: []kvCollectionRecord8170, context: string,
) {
  assert(len(actual) == len(expected), "${context}: count ${len(actual)} != ${len(expected)}")
  for (let i = 0; i < len(expected); i++) {
    kvCollectionEqual8170(actual[i], expected[i], "${context} row ${i}")
  }
}

fn kvCollectionRead8170(
  records: Collection<kvCollectionRecord8170>, model: kvCollectionModel8170,
  id: i64, context: string,
): ()! {
  let at = model.find(id)
  let found = true
  let actual = records.get(id) catch e {
    assert(e.message() == "kv: get: key not found", "${context}: ${e.message()}")
    found = false
    kvCollectionRecord8170{ id = 0, group = 0, rank = 0, body = "" }
  }
  assert(found == (at >= 0), "${context}: presence at ${id}")
  if (found) {
    kvCollectionEqual8170(actual, model.entries[at], context)
  }
}

fn kvCollectionCheck8170(
  records: Collection<kvCollectionRecord8170>, model: kvCollectionModel8170, context: string,
): ()! {
  kvCollectionRows8170(records.all()?, model.ordered("", 0), "${context} all")
  for (let bucket = -1; bucket <= 1; bucket++) {
    let key = encodeInt(i64(bucket))
    kvCollectionRows8170(
      records.by("group", key)?, model.ordered("group", i64(bucket)), "${context} group ${bucket}",
    )
    kvCollectionRows8170(
      records.by("rank", key)?, model.ordered("rank", i64(bucket)), "${context} rank ${bucket}",
    )
  }
}

fn kvCollectionBody8170(random: kvCollectionRandom8170, operation: int): string {
  let sizes = [0, 1, 7, 31, 127]
  let body = []byte(sizes[random.next(len(sizes))])
  let alphabet = [byte(0), byte(34), byte(92), byte(97), byte(122)]
  for (let i = 0; i < len(body); i++) {
    body[i] = alphabet[(operation + i) % len(alphabet)]
  }
  return string(body)
}

fn kvCollectionRollbackValue8170(
  model: kvCollectionModel8170, operation: int,
): kvCollectionRecord8170 {
  let value = kvCollectionRecord8170{
    id = -24, group = 0, rank = 0, body = "rollback-${operation}",
  }
  let at = model.find(value.id)
  if (at >= 0) {
    let old = model.entries[at]
    value.group = old.group == 1 ? -1 : old.group + 1
    value.rank = old.rank == 1 ? -1 : old.rank + 1
  }
  return value
}

fn kvCollectionApply8170(
  records: Collection<kvCollectionRecord8170>, model: kvCollectionModel8170,
  random: kvCollectionRandom8170, operation: int, context: string,
): ()! {
  let id = i64(random.next(48) - 24)
  let kind = random.next(5)
  let group = i64(random.next(3) - 1)
  let rank = i64(random.next(3) - 1)
  // Guarantee duplicate buckets, a changed index, and missing reads/deletes before random mixing.
  let firstIds = [-24, -23, -24, 23, -23, 23, -22, -22]
  let firstKinds = [0, 0, 0, 3, 2, 2, 0, 4]
  if (operation < len(firstIds)) {
    id = i64(firstIds[operation])
    kind = firstKinds[operation]
    group = operation == 2 ? 1 : 0
    rank = operation == 2 ? -1 : 0
  }
  if (operation >= 8 && operation % 4 == 0) {
    kind = 0
  }
  if (kind < 2) {
    let value = kvCollectionRecord8170{
      id = id, group = group, rank = rank, body = kvCollectionBody8170(random, operation),
    }
    if (operation % 20 == 8) {
      value = kvCollectionRollbackValue8170(model, operation)
      id = value.id
    }
    assert(len(jsonEncode(value.toJson())) <= 512, "${context}: encoded value bound")
    records.set(id, value)?
    model.set(value)
  }
  if (kind == 2) {
    records.delete(id)?
    model.delete(id)
  }
  kvCollectionRead8170(records, model, id, context)?
  if (kind == 4) {
    kvCollectionCheck8170(records, model, context)?
  }
}

fn kvCollectionCommitted8170(db: Db, model: kvCollectionModel8170, context: string): ()! {
  assert(!db.writing && !db.writerHeld, "${context}: writer retained")
  db.tx((tx) => {
    kvCollectionCheck8170(kvCollectionHandle8170(tx)?, model, context)?
  })?
}

fn kvCollectionHistory8170(seed: i64): ()! {
  let path = scratchPath("collection-model-8170-${seed}")
  let db = open(path)?
  let model = kvCollectionModel8170{}
  let random = kvCollectionRandom8170{ state = seed }
  for (let batch = 0; batch < 64; batch++) {
    let next = model.copy()
    let context = "seed ${seed} operation ${batch * 4} database ${path}"
    let rollback = batch % 5 == 2
    let root = db.root
    let txid = db.eng.txid
    let failed = false
    db.tx((tx) => {
      let records = kvCollectionHandle8170(tx)?
      for (let offset = 0; offset < 4; offset++) {
        let operation = batch * 4 + offset
        kvCollectionApply8170(records, next, random, operation, "${context} offset ${offset}")?
      }
      kvCollectionCheck8170(records, next, "${context} uncommitted")?
      if (rollback) {
        fail newError("collection model rollback 8170")
      }
    }) catch e {
      assert(
        rollback && e.message() == "collection model rollback 8170",
        "${context}: ${e.message()}",
      )
      failed = true
    }
    assert(failed == rollback, "${context}: rollback result")
    if (rollback) {
      assert(db.root == root && db.eng.txid == txid, "${context}: rollback published")
    } else {
      model = next
      assert(db.eng.txid == txid + 1, "${context}: commit version")
    }
    kvCollectionCommitted8170(db, model, context)?
    if (batch % 8 == 7) {
      db.close()
      db = open(path)?
      kvCollectionCommitted8170(db, model, "${context} reopened")?
    }
  }
  db.close()
  kvTestTeardown(path)
}

test "seeded typed collection index history 8170 seed 7" {
  kvCollectionHistory8170(7) catch e {
    panic(e.message())
  }
}

test "seeded typed collection index history 8170 seed 8083" {
  kvCollectionHistory8170(8083) catch e {
    panic(e.message())
  }
}

test "seeded typed collection index history 8170 seed 8154" {
  kvCollectionHistory8170(8154) catch e {
    panic(e.message())
  }
}
