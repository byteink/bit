// Fixed seeds make each mixed transaction history reproducible (#8167).
class kvModelEntry8167 { key: []byte, value: []byte }

fn kvModelCompare8167(left: []byte, right: []byte): int {
  let count = len(left) < len(right) ? len(left) : len(right)
  for (let i = 0; i < count; i++) {
    if (left[i] != right[i]) {
      return left[i] < right[i] ? -1 : 1
    }
  }
  if (len(left) == len(right)) {
    return 0
  }
  return len(left) < len(right) ? -1 : 1
}

// An unsorted owned list keeps the oracle independent of KV's tree and codecs.
class kvModel8167 {
  entries: []kvModelEntry8167 = []

  find(key: []byte): int {
    for (let i = 0; i < len(this.entries); i++) {
      if (string(this.entries[i].key) == string(key)) {
        return i
      }
    }
    return -1
  }

  put(key: []byte, value: []byte) {
    let entry = kvModelEntry8167{ key = clone(key), value = clone(value) }
    let at = this.find(key)
    if (at >= 0) {
      this.entries[at] = entry
      return
    }
    assert(len(this.entries) < 64, "model key bound")
    this.entries = append(this.entries, entry)
  }

  delete(key: []byte) {
    let kept: []kvModelEntry8167 = []
    for entry of this.entries {
      if (string(entry.key) != string(key)) {
        kept = append(kept, entry)
      }
    }
    this.entries = kept
  }

  copy(): kvModel8167 {
    let copied = kvModel8167{}
    for entry of this.entries {
      copied.put(entry.key, entry.value)
    }
    return copied
  }

  scan(lo: []byte, hi: []byte): [][]byte {
    let ordered: []kvModelEntry8167 = []
    for entry of this.entries {
      if (kvModelCompare8167(entry.key, lo) >= 0 && kvModelCompare8167(entry.key, hi) < 0) {
        ordered = append(ordered, entry)
      }
    }
    for (let i = 1; i < len(ordered); i++) {
      let entry = ordered[i]
      let j = i
      while (j > 0 && kvModelCompare8167(ordered[j - 1].key, entry.key) > 0) {
        ordered[j] = ordered[j - 1]
        j = j - 1
      }
      ordered[j] = entry
    }
    let values: [][]byte = []
    for entry of ordered {
      values = append(values, clone(entry.value))
    }
    return values
  }
}

class kvModelRandom8167 {
  state: i64

  next(bound: int): int {
    // Park-Miller stays within signed i64 before the modulus.
    this.state = this.state * 48271 % 2147483647
    return int(this.state % i64(bound))
  }
}

fn kvModelKey8167(id: int): []byte {
  if (id == 0) {
    return []byte(0)
  }
  if (id == 1) {
    return [byte(0)]
  }
  if (id == 2) {
    return [byte(0), byte(0)]
  }
  if (id == 3) {
    return [byte(0), byte(255)]
  }
  return [byte(id - 3)]
}

fn kvModelValue8167(random: kvModelRandom8167, operation: int): []byte {
  let sizes = [0, 1, 7, 127, 511, 2000, 3000]
  let value = []byte(sizes[random.next(len(sizes))])
  for (let i = 0; i < len(value); i++) {
    value[i] = byte((operation + i) % 256)
  }
  return value
}

fn kvModelRead8167(model: kvModel8167, key: []byte, value: []byte, present: bool, context: string) {
  let at = model.find(key)
  assert(present == (at >= 0), "${context}: presence")
  if (at >= 0) {
    assert(string(value) == string(model.entries[at].value), "${context}: value")
  }
}

fn kvModelScan8167(actual: [][]byte, expected: [][]byte, context: string) {
  assert(len(actual) == len(expected), "${context}: scan count")
  for (let i = 0; i < len(expected); i++) {
    assert(string(actual[i]) == string(expected[i]), "${context}: scan order/value ${i}")
  }
}

fn kvModelTxRead8167(tx: Tx, model: kvModel8167, key: []byte, context: string): ()! {
  let present = true
  let value = tx.get(key) catch e {
    assert(e.message() == "kv: get: key not found", "${context}: ${e.message()}")
    present = false
    []byte(0)
  }
  kvModelRead8167(model, key, value, present, context)
}

fn kvModelOperation8167(
  tx: Tx, model: kvModel8167, random: kvModelRandom8167, operation: int, context: string,
): ()! {
  let key = kvModelKey8167(random.next(64))
  let kind = random.next(4)
  if (kind == 0) {
    let value = kvModelValue8167(random, operation)
    tx.put(key, value)?
    model.put(key, value)
  }
  if (kind == 1) {
    tx.delete(key)?
    model.delete(key)
  }
  kvModelTxRead8167(tx, model, key, context)?
  let hi = kind == 3 ? key : kvModelKey8167(random.next(64))
  kvModelScan8167(tx.scan(key, hi)?, model.scan(key, hi), context)
  kvModelScan8167(tx.scan([byte(0)], [byte(1)])?, model.scan([byte(0)], [byte(1)]), context)
}

fn kvModelCommitted8167(db: Db, model: kvModel8167, context: string): ()! {
  for (let id = 0; id < 64; id++) {
    let key = kvModelKey8167(id)
    let present = true
    let value = get(db.eng, db.root, key) catch e {
      assert(e.message() == "kv: get: key not found", "${context}: ${e.message()}")
      present = false
      []byte(0)
    }
    kvModelRead8167(model, key, value, present, "${context} key ${id}")
  }
  let lo = []byte(0)
  let hi = [byte(255)]
  kvModelScan8167(scan(db.eng, db.root, lo, hi)?, model.scan(lo, hi), context)
  checkFreeList8083(db)?
  checkRootNotFree8154(db)?
  assert(!db.writing && !db.writerHeld, "${context}: writer retained")
}

fn kvModelHistory8167(seed: i64): ()! {
  let path = scratchPath("model-8167-${seed}")
  let db = open(path)?
  let model = kvModel8167{}
  let random = kvModelRandom8167{ state = seed }
  for (let batch = 0; batch < 64; batch++) {
    let next = model.copy()
    let context = "seed ${seed} operation ${batch * 8}"
    let rollback = batch % 5 == 2
    let root = db.root
    let txid = db.eng.txid
    let failed = false
    db.tx((tx) => {
      for (let offset = 0; offset < 8; offset++) {
        let operation = batch * 8 + offset
        kvModelOperation8167(tx, next, random, operation, "seed ${seed} operation ${operation}")?
      }
      if (rollback) {
        fail newError("model rollback 8167")
      }
    }) catch e {
      assert(rollback && e.message() == "model rollback 8167", "${context}: ${e.message()}")
      failed = true
    }
    assert(failed == rollback, "${context}: rollback result")
    if (rollback) {
      assert(db.root == root && db.eng.txid == txid, "${context}: rollback published")
    } else {
      model = next
      assert(db.eng.txid == txid + 1, "${context}: commit version")
    }
    kvModelCommitted8167(db, model, context)?
    if (batch % 4 == 3) {
      db.close()
      db = open(path)?
      kvModelCommitted8167(db, model, "${context} reopened")?
    }
  }
  db.close()
  kvTestTeardown(path)
}

test "seeded KV model history 8167 seed 1" {
  kvModelHistory8167(1) catch e {
    panic(e.message())
  }
}

test "seeded KV model history 8167 seed 7" {
  kvModelHistory8167(7) catch e {
    panic(e.message())
  }
}

test "seeded KV model history 8167 seed 42" {
  kvModelHistory8167(42) catch e {
    panic(e.message())
  }
}

test "seeded KV model history 8167 seed 8083" {
  kvModelHistory8167(8083) catch e {
    panic(e.message())
  }
}

test "seeded KV model history 8167 seed 8154" {
  kvModelHistory8167(8154) catch e {
    panic(e.message())
  }
}
