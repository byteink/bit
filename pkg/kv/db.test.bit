// pkg/kv/db.test.bit — the closure-scoped tx API (#3467, #5721, #6257).
//
// The load-bearing properties, one test each: a commit is visible to a fresh
// read, a failed or panicked block leaves nothing visible and the meta txid
// unchanged, a nested `db.tx` is a hard error rather than a savepoint, a
// SECOND OS PROCESS truly contends for the writer lock (not merely an
// in-process mutex), and a delete-then-reinsert cycle proves the free list is
// REUSED — the file returns to its pre-cycle size, not merely tracked while
// still growing. The last one is this file's own mutation-tested property:
// `kvTruncateFreePages` short-circuited to `return free` unmodified (never
// reclaiming a trailing garbage page) turned it red — see the comment above
// that test.

import { readFile, writeFile, mkdir, readDir } from "std/fs"
import { selfExe } from "std/os"
import { contains, hasSuffix } from "std/strings"
import { sleep } from "std/time"

fn scratchPath5721(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-kv-5721-${tag}-${timeUnixNs()}"
}

// Shared by every pkg/kv `.test.bit` file (flat module scope, #5756):
// removes `target` (a file OR a directory -- `create`/`open`'s own
// `path` is a single db FILE, not a directory; only the cross-process lock
// and crash-kill harnesses `mkdir` one) recursively via a `#!/bin/sh`
// script; `std/fs.remove` (stdlib/fs/fs.bit:494) only removes a file or an
// EMPTY directory. The driver script is written as a SIBLING of `target`
// (`target + ".rm.sh"`), never inside it -- `target` itself may not be a
// directory to write into.
//
// ALWAYS the LAST statement of a test, after its final assertion and after
// any handle opened on `target` is closed -- never before, and never while
// `target` or a handle on it is still in use: this is a real database
// engine under test, and unlinking mid-test would exercise fsync/truncate/
// writeback against a deleted file instead of a real one. A test that
// panics or fails an assert therefore keeps its scratch dir on purpose --
// that is the evidence a human needs to debug the failure. Only the PASS
// path must not leak, and it is the one every suite run repeats.
fn kvTestTeardown(target: string) {
  let shPath = target + ".rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${target}' '${shPath}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, 10000)
}

// `get`, with a not-found (or any other failure) read back as an empty
// slice instead of propagated — every rollback test below only needs "is
// this key visible", not the distinction between absent and erroring.
fn getOrEmpty(e: Engine, root: i64, key: []byte): []byte {
  let v = get(e, root, key) catch _ {
    return []byte(0)
  }
  return v
}

test "committed writes are visible via a read-only get() after write() returns" {
  let path = scratchPath5721("commit")
  let db = open(path) catch e {
    panic("open: ${e.message()}")
  }
  db.tx((tx) => {
    tx.put([]byte("a"), []byte("1"))?
    tx.put([]byte("b"), []byte("2"))?
    tx.put([]byte("c"), []byte("3"))?
  }) catch e {
    panic("write: ${e.message()}")
  }
  assert(string(getOrEmpty(db.eng, db.root, []byte("a"))) == "1", "a")
  assert(string(getOrEmpty(db.eng, db.root, []byte("b"))) == "2", "b")
  assert(string(getOrEmpty(db.eng, db.root, []byte("c"))) == "3", "c")
  db.close()
  kvTestTeardown(path)
}

test "a failing block leaves no new data visible and the meta txid unchanged" {
  let path = scratchPath5721("fail")
  let db = open(path) catch e {
    panic("open: ${e.message()}")
  }
  let txidBefore = db.eng.txid
  let rootBefore = db.root
  let failed = false
  db.tx((tx) => {
    tx.put([]byte("x"), []byte("1"))?
    fail newError("forced failure")
  }) catch _ {
    failed = true
  }
  assert(failed, "db.tx must fail when the block fails")
  assert(
    db.eng.txid == txidBefore,
    "txid changed on a failed write: ${db.eng.txid} != ${txidBefore}",
  )
  assert(db.root == rootBefore, "root changed on a failed write")
  assert(
    len(getOrEmpty(db.eng, db.root, []byte("x"))) == 0,
    "key must not be visible after a failed write",
  )
  db.close()
  kvTestTeardown(path)
}

test "a panicking block leaves no new data visible and the meta txid unchanged" {
  let path = scratchPath5721("panic")
  let db = open(path) catch e {
    panic("open: ${e.message()}")
  }
  let txidBefore = db.eng.txid
  let (panicked, msg) = runRecovering(() => {
    db.tx((tx) => {
      tx.put([]byte("y"), []byte("1"))?
      panic("forced panic")
    }) catch e {
      panic("write returned a failure instead of propagating the panic: ${e.message()}")
    }
  })
  assert(panicked, "db.tx must propagate a panicking block's own panic")
  assert(contains(msg, "forced panic"), "panic message: ${msg}")
  assert(
    db.eng.txid == txidBefore,
    "txid changed on a panicked write: ${db.eng.txid} != ${txidBefore}",
  )
  assert(
    len(getOrEmpty(db.eng, db.root, []byte("y"))) == 0,
    "key must not be visible after a panicked write",
  )
  db.close()
  kvTestTeardown(path)
}

// A one-field box around the `Db` handle this test deliberately reuses from
// inside its own transaction block. Not encapsulation for its own sake:
// compiler/linttx.bit's `tx-captured-executor` rule (E0217) flags a BARE
// identifier reused this way as the accidental-escape bug it exists to
// catch, and cannot tell "reused by mistake" from "reused on purpose, to
// prove nesting is rejected" — this test is the second case. `handle.db` is
// a member expression, not a bare identifier, so the rule's own "not a bare
// identifier — nothing captured under a name to re-use" clause (its own
// comment) leaves it alone, with no change to what this test actually runs.
class kvDbHandle5721 { db: Db }

test "a nested db.tx() call fails rather than running as a savepoint" {
  let path = scratchPath5721("nested")
  let opened = open(path) catch e {
    panic("open: ${e.message()}")
  }
  let handle = kvDbHandle5721{ db = opened }
  let failed = false
  handle.db.tx((tx) => {
    tx.put([]byte("outer"), []byte("1"))?
    handle.db.tx((inner) => {
      inner.put([]byte("inner"), []byte("1"))?
    })?
  }) catch e {
    failed = true
    assert(
      contains(e.message(), "nested") || contains(e.message(), "already running"),
      "unexpected failure: ${e.message()}",
    )
  }
  assert(failed, "a nested db.tx() must fail, not run as a savepoint")
  assert(
    len(getOrEmpty(handle.db.eng, handle.db.root, []byte("outer"))) == 0,
    "the outer write must roll back too",
  )
  handle.db.close()
  kvTestTeardown(path)
}

// MUTATION-TESTED: `kvTruncateFreePages` changed to `return free` as its
// first line (never reclaiming a trailing garbage page) turned this red —
// size kept climbing every batch instead of settling. Reverting made it
// green again.
//
// Asserts the file STABILIZES, not that it returns to the pre-cycle
// `baseline`: #5734 fixed a crash-consistency hole by deferring reuse of a
// transaction's own freed pages (and the old free list's own storage pages)
// by exactly one generation — see `pkg/kv/db.bit`'s `Db.commit` — so this
// file settles one generation's worth of pages ABOVE `baseline`, not AT it.
// That settled size is still a hard ceiling: comparing two LATER batches
// (5 cycles apart, once the one-generation pipeline has filled) to each
// other, rather than either to `baseline`, still catches the leak this test
// was written for — a `kvTruncateFreePages` that never reclaims fails this
// exactly as before, since `afterTen` would keep climbing past `afterFive`.
fn runDeleteReinsertCycles5721(db: Db, count: int, label: string) {
  let i = 0
  while (i < count) {
    db.tx((tx) => {
      tx.delete([]byte("k"))?
    }) catch e {
      panic("${label} delete cycle ${i}: ${e.message()}")
    }
    db.tx((tx) => {
      tx.put([]byte("k"), []byte("v"))?
    }) catch e {
      panic("${label} put cycle ${i}: ${e.message()}")
    }
    i = i + 1
  }
}

test "repeated delete-then-reinsert cycles reuse the free list instead of growing the file" {
  let path = scratchPath5721("freelist")
  let db = open(path) catch e {
    panic("open: ${e.message()}")
  }
  db.tx((tx) => {
    tx.put([]byte("k"), []byte("v"))?
  }) catch e {
    panic("seed write: ${e.message()}")
  }

  runDeleteReinsertCycles5721(db, 5, "warmup")
  let afterFive = db.eng.file.size() catch e {
    panic("size after five: ${e.message()}")
  }
  runDeleteReinsertCycles5721(db, 5, "steady-state")
  let afterTen = db.eng.file.size() catch e {
    panic("size after ten: ${e.message()}")
  }
  assert(
    afterTen == afterFive,
      "file grew from ${afterFive} to ${afterTen} bytes across 5 more delete/put " +
      "cycles once already past the one-generation deferral pipeline -- the free " +
      "list is being leaked, not reused",
  )
  db.close()
  kvTestTeardown(path)
}

// --- cross-process writer lock ---------------------------------------------
//
// The child is THIS TEST BINARY, re-executed (`selfExe()`, already compiled
// and already exec'd once, so no compile and no first-exec scan sits inside
// the test's 30s bound -- #6119: the old child was built with `bit build`
// inside the timed body and timed out under fleet load). `bit test` runs the
// binary once per test with `BIT_TEST_INDEX` set; the child inherits it, so
// it enters this same test, sees `lockChildEnv5721`, and plays the holder.
//
// No wall-clock decides the verdict. The handshake is two files in the
// scratch dir: the child creates `ready` once it HOLDS the writer lock, and
// holds it until the parent creates `release`. Every wait is bounded by a
// deadline that only a real hang reaches. Skips nothing: it needs no
// compiler, so unlike `crash.test.bit` it has no "no usable bit" path.

const lockChildEnv5721 = "BIT_KV_LOCK_CHILD"
const lockReadyBudgetMs = 20000
const lockReleaseBudgetMs = 25000

class BitLocation {
  bin: string,
  stdlib: string,
  repo: string,
}

fn locateBit5721(): BitLocation {
  let bin = envOr("BIT_BIN", "")
  let stdlib = envOr("BIT_STDLIB", "")
  let repo = envOr("BIT_REPO", "")
  let fromEnv = len(bin) > 0 && exists(bin) && len(stdlib) > 0 && exists(stdlib)
  fromEnv = fromEnv && len(repo) > 0 && exists("${repo}/pkg/kv/db.bit")
  if (fromEnv) {
    return BitLocation{ bin = bin, stdlib = stdlib, repo = repo }
  }
  if (exists("bit-out/bin/bit") && exists("stdlib") && exists("pkg/kv/db.bit")) {
    return BitLocation{ bin = "bit-out/bin/bit", stdlib = "stdlib", repo = "." }
  }
  return BitLocation{ bin = "", stdlib = "", repo = "" }
}

fn shellRun5721(path: string, script: string, timeoutMs: int): int {
  writeFile(path, script) catch _ {
    return -999
  }
  if (fsChmod(path, 448) != 0) { // 0o700: owner rwx only
    return -998
  }
  return osRunBounded(path, timeoutMs)
}

// Polls for `path` until it exists or `budgetMs` passes; the budget is a
// hang detector, never the expected wait.
fn waitForFile5721(path: string, budgetMs: int): bool {
  let deadline = timeUnixNs() + budgetMs * 1000000
  while (timeUnixNs() < deadline) {
    if (exists(path)) {
      return true
    }
    sleep(10000000) // 10ms
  }
  return exists(path)
}

// The holder: takes the writer lock, announces it, keeps it until the parent
// says release, then commits.
fn lockChild5721(dir: string) {
  let db = open("${dir}/db") catch e {
    panic("child open: ${e.message()}")
  }
  db.tx((tx) => {
    writeFile("${dir}/ready", "1")?
    if (!waitForFile5721("${dir}/release", lockReleaseBudgetMs)) {
      panic("child: parent never released the writer lock")
    }
    tx.put([]byte("child"), []byte("1"))?
  }) catch e {
    panic("child write: ${e.message()}")
  }
}

fn childLog5721(dir: string): string {
  let log = readFile("${dir}/child.log") catch _ {
    return "<unreadable>"
  }
  return log
}

// `Tx.get` with any failure read back as empty, for the ordering check.
fn getOrEmpty5721(tx: Tx, key: string): []byte {
  let v = tx.get([]byte(key)) catch _ {
    return []byte(0)
  }
  return v
}

// Backgrounds the child and returns at once: the readiness wait is Bit-side
// (`waitForFile5721`), so the script has no poll budget of its own. Stdout
// and stderr go to a log the parent prints on failure; stdin and both
// streams are detached so `osRunBounded` sees EOF without waiting for the
// child.
fn lockLaunchScript5721(exe: string, dir: string): string {
  return "#!/bin/sh\n" +
    "${lockChildEnv5721}='${dir}' '${exe}' < /dev/null > '${dir}/child.log' 2>&1 &\n" +
    "exit 0\n"
}

test "a second os-level process holding the writer lock blocks the parent's write()" {
  let childDir = envOr(lockChildEnv5721, "")
  if (len(childDir) > 0) {
    lockChild5721(childDir)
    return
  }
  let dir = scratchPath5721("lock")
  mkdir(dir) catch e {
    panic("mkdir ${dir}: ${e.message()}")
  }
  let dbPath = "${dir}/db"
  let seed = open(dbPath) catch e {
    panic("open: ${e.message()}")
  }
  seed.close()

  let launchCode = shellRun5721("${dir}/lock.sh", lockLaunchScript5721(selfExe(), dir), 15000)
  assert(launchCode == 0, "launching the lock-holding child failed (exit ${launchCode})")
  let held = waitForFile5721("${dir}/ready", lockReadyBudgetMs)
  assert(
    held,
      "the child never signaled it took the writer lock within ${lockReadyBudgetMs}ms; " +
      "its log: ${childLog5721(dir)}",
  )

  let db2 = open(dbPath) catch e {
    panic("open: ${e.message()}")
  }
  // Exclusion, proven without a clock: the child signaled `ready` from
  // inside its tx, so the writer lock is held right now, and a non-blocking
  // attempt on this process's own handle must be refused.
  let got = db2.eng.file.tryLock() catch e {
    panic("tryLock: ${e.message()}")
  }
  if (got) {
    db2.eng.file.unlock() catch _ {}
  }
  assert(!got, "this process took the writer lock while another process held it")

  // Release the child, then write. Whether this tx blocks depends on who
  // wins the race, but it can only ENTER after the child's commit, so the
  // child's key must already be visible inside the closure.
  writeFile("${dir}/release", "1") catch e {
    panic("write release: ${e.message()}")
  }
  db2.tx((tx) => {
    let seen = getOrEmpty5721(tx, "child")
    assert(
      string(seen) == "1",
      "the parent's write() ran before the child's commit finished; its log: " + childLog5721(dir),
    )
    tx.put([]byte("parent"), []byte("1"))?
  }) catch e {
    panic("parent write failed: ${e.message()}")
  }
  assert(
    string(getOrEmpty(db2.eng, db2.root, []byte("child"))) == "1",
    "the child's own write must have committed",
  )
  assert(
    string(getOrEmpty(db2.eng, db2.root, []byte("parent"))) == "1",
    "the parent's write must have committed",
  )
  db2.close()
  kvTestTeardown(dir)
}
