// pkg/kv/collection.bit — the typed collection layer (#3467, #5724, #6257):
// `set`/`get`/`delete`/`all`/`by` over #5721's `Tx`, with declared secondary
// indexes maintained inside the same transaction as the record they index.
//
// USES ONLY THE ENGINE'S PUBLIC API — `Tx.get`/`put`/`delete`/`scan`, never a
// page or B+tree internal directly (this ticket's own constraint, and the
// reason this file lives apart from engine.bit/btree.bit: bbolt is the
// differential oracle for the engine alone and has no collections).
//
// ONE SHARED B+TREE NAMESPACE, TWO KEY SPACES PER COLLECTION. A `Db` has one
// key/value space; every `Collection` carves out its own name-prefixed slice
// of it (`kvRecordKey`) plus one further-prefixed slice per declared index
// (`kvIndexKey`). Every prefix this file builds ends in `kvSep`
// (pkg/kv/keyencoding.bit's own 0x00 separator, reused here rather than
// redeclared — a second `const kvSep` in this module would be E0042) placed
// deliberately so a shorter name can never be a byte-for-byte prefix of a
// longer one: "user" and "users" produce "r\x00user\x00..." and
// "r\x00users\x00...", which diverge at the byte right after "user".
//
// AN INDEX ENTRY'S VALUE IS THE PRIMARY ID, NOT EMPTY. #5719's `scan`
// (`pkg/kv/btree.bit`) returns `[][]byte` of VALUES only — it does not hand
// back the keys it scanned. So `by()` cannot recover a match's primary id by
// parsing an index key's tail; it reads the id back from the entry's VALUE
// instead, which this file writes as exactly the id bytes it was given. The
// id is still appended to the index key too (`idx:name:indexName:value\x00`
// + id), because two records sharing the same indexed value need distinct
// keys to both be storable — the "tail is the primary key" framing in the
// epic's own body is about that uniqueness, not about extraction.
//
// THE PROPERTY THIS FILE EXISTS FOR: an index entry and the record it
// indexes are never observable apart, even transiently within one `tx`.
// `kvCollSave` on an id that already has a record reads the OLD value first
// (the only way to know which index entries are now stale), deletes every
// stale index entry, writes the new record, then writes every new index
// entry — all before returning, all in the caller's own `tx`. Saving a
// brand-new id only ever adds entries, which is why a test that never
// re-saves cannot exercise this: see collection.test.bit's re-save test for
// the property the ticket's acceptance names by name.
//
// #6257: THE ID IS `i64`, ENCODED AT THE BOUNDARY. `Collection<T>`'s own
// surface (`set`/`get`/`delete`) takes `id: i64`, converted to the sortable
// `encodeInt(id)` bytes right here before touching `kvRecordKey`/
// `kvIndexKey` — every byte-level helper below is unchanged from before this
// ticket, still keyed on `[]byte`, so `declareIndex`'s `keyOf` and `by`'s
// `value` still take pre-encoded bytes exactly as they always have.
//
// #6257/#6259: T IS `@json`, DECODED DIRECTLY ON `Collection<T>` ITSELF, NOT
// A CALLER-SUPPLIED MARSHAL PAIR. Encoding is a direct `v.toJson()` call —
// an ordinary interface-bound generic call. Decoding used to need a
// workaround: `jsonDecode<T>(j)` refused to lower wherever `T` was a
// GENERIC CLASS's own type parameter, reached either directly inside a
// `Collection<T>` method (E0145 at check time) or through a free-function
// wrapper called from one (E0092 at lowering) — filed as #6259
// (compiler/classjsondecodeclassgeneric.bit), which extended `jsonDecode<T>`'s
// own generic-retarget mechanism (#4563) from a function/method's own type
// parameter to a CLASS's own, resolved through `ctx.typeInsts` per class
// instantiation. `Collection.decode` below calls `jsonDecode<T>` directly —
// `T` is `Collection`'s own receiver type parameter — with no closure and no
// stored field.
//
// #6254 (a sibling ticket) adds `T.__collectionName()`, at which point
// `Db.collection<T>()`/`Tx.collection<T>()` gain a second, no-argument
// overload that reads it instead of taking `name` — this file's own
// `Collection<T>` value and every helper below are unaffected either way,
// since `name` is only ever consumed as a plain string once the collection
// is built.

import { Json, jsonDecode, jsonEncode, jsonParse } from "std/json"

// A value a `Collection<T>` can store: whatever `@json` (SPEC §10.5)
// synthesizes. Structural (SPEC §14.3), so any `@json class` satisfies it
// with no declaration of its own.
export interface KvJsonable {
  toJson(): Json,
}

// `T`'s own collection name, read with no instance in hand — SPEC §10.5's
// own naming for exactly this bound: "`T.__collectionName()` for a `T`
// bound by `interface Stored { static __collectionName(): string }`". Every
// `@json` class synthesizes this unconditionally (#6254), so any `T:
// KvJsonable` already satisfies it too; kept as its own interface, matching
// the spec's own name, rather than folded into `KvJsonable` — nothing here
// needs the two bounds joined except `Db.collection<T>`/`Tx.collection<T>`'s
// no-argument form.
export interface Stored {
  static __collectionName(): string,
}

// One caller-declared secondary index: a name plus the closure that turns a
// `T` into the bytes it is indexed under. Module-private — reached only
// through `declareIndex` and a `Collection`'s own methods.
class kvIndexDef<T> {
  name: string,
  keyOf: (T) => []byte,
}

// `Db.collection<T>`/`Tx.collection<T>`'s name argument, resolved: an empty
// name (the parameter's default) means `T.__collectionName()`, anything else
// overrides it.
fn kvCollectionName<T: Stored>(name: string): string {
  if (name != "") {
    return name
  }
  return T.__collectionName()
}

// A single mutable slot, used only to carry a value back out of the
// `Db.tx()` closure `kvRunValue` runs it in — `db.tx`'s own signature is
// `(Tx) => ()!`, so a caller that needs a VALUE back (`get`/`all`/`by`,
// outside an explicit `store.tx` block) has nothing else to capture it into.
// A one-element slice rather than `Option<R>`: it is already the zero value
// with no generic constructor call needed, and every write path here always
// appends exactly once before the slice is read.
fn kvRunValue<R>(db: Db, f: (Tx) => R!): R! {
  let out: []R = []R(0)
  db.tx((tx) => {
    let v = f(tx)?
    out = append(out, v)
  })?
  return out[0]
}

// One name-prefixed collection over a `Db`'s shared key/value space. Built
// only by `Db.collection<T>`/`Tx.collection<T>` (db.bit) — never by a bare
// `Collection<T>{...}` literal outside this module, matching `Tx`/`Db`'s own
// convention (module-private fields).
export class Collection<T: KvJsonable> {
  name: string
  db: Db
  activeTx: Option<Tx>
  indexes: []kvIndexDef<T>

  // `raw`, decoded into `T` — `T` is `Collection`'s OWN type parameter here
  // (#6259, compiler/classjsondecodeclassgeneric.bit), resolved per
  // instantiation through `ctx.typeInsts` exactly as a free generic
  // function's own `T` resolves through `ctx.instantiations`. See this
  // file's header for the closure this method replaced.
  decode(raw: []byte): T! {
    let j = jsonParse(string(raw))?
    return jsonDecode<T>(j)?
  }

  // Runs `f` against whichever `Tx` this collection already belongs to (a
  // `Tx.collection<T>()` handle, inside a `store.tx()` block), else opens a
  // fresh `db.tx()` for exactly this one call — the "outside a tx, every
  // call runs in its own transaction" rule the ticket asks for.
  runWrite(f: (Tx) => ()!): ()! {
    if (isSome(this.activeTx)) {
      f(unwrap(this.activeTx))?
      return
    }
    this.db.tx(f)?
  }

  // `runWrite`, returning what `f` returned.
  runRead<R>(f: (Tx) => R!): R! {
    if (isSome(this.activeTx)) {
      return f(unwrap(this.activeTx))?
    }
    return kvRunValue<R>(this.db, f)?
  }

  export set(id: i64, v: T): ()! {
    let key = encodeInt(id)
    this.runWrite((tx) => {
      kvCollSave(this, tx, key, v)?
    })?
  }

  // The record at `id`, or a failure naming it absent (`Tx.get`'s own
  // "key not found").
  export get(id: i64): T! {
    let key = encodeInt(id)
    return this.runRead<T>((tx) => {
      return kvCollGet(this, tx, key)?
    })?
  }

  // Removes the record at `id` and every index entry it had — a no-op, not
  // a failure, if `id` has no record (matches `Tx.delete`'s own semantics).
  export delete(id: i64): ()! {
    let key = encodeInt(id)
    this.runWrite((tx) => {
      kvCollDelete(this, tx, key)?
    })?
  }

  // Every saved record in this collection, regardless of any index, in id
  // order — `encodeInt` preserves numeric order under plain byte comparison
  // (keyencoding.bit), and this is a prefix scan over the collection's own
  // record key space, which the B+tree already returns key-ordered.
  export all(): []T! {
    return this.runRead<[]T>((tx) => {
      return kvCollAll(this, tx)?
    })?
  }

  // Every record whose `index`-declared field equals `value` (already
  // encoded, e.g. via `encodeInt`/`encodeFloat`/`encodeString`) — a prefix
  // scan over that index's value range, then one record read per match. A
  // `value` that matches no declared index's entries simply returns empty;
  // `index` naming a never-declared index does too, the same way an empty
  // prefix scan reads no differently from one that never had entries — no
  // query language or planner here.
  export by(index: string, value: []byte): []T! {
    return this.runRead<[]T>((tx) => {
      return kvCollBy(this, tx, index, value)?
    })?
  }
}

// Declares a secondary index named `name` on `c`, keyed by `keyOf(v)` for
// every `v` saved from here on. `c`'s own fields are mutated in place
// (classes are reference types, SPEC §13.3), so every later `set`/`delete`/
// `by` on this same `Collection` sees it. Does NOT backfill: only records
// saved AFTER this call are indexed.
export fn declareIndex<T: KvJsonable>(c: Collection<T>, name: string, keyOf: (T) => []byte): ()! {
  let i = 0
  while (i < len(c.indexes)) {
    if (c.indexes[i].name == name) {
      fail newError("kv: declareIndex: index '${name}' is already declared on collection '${c.name}'")
    }
    i = i + 1
  }
  c.indexes = append(c.indexes, kvIndexDef<T>{ name = name, keyOf = keyOf })
}

// The read-before-write behind `Collection.set`: reads the current record at
// `id` (if any), removes every stale index entry it implies, writes the new
// record, then writes every new index entry — all inside the caller's own
// `tx`. See this file's header for why the read-before-write is load-
// bearing, not optional.
fn kvCollSave<T: KvJsonable>(c: Collection<T>, tx: Tx, id: []byte, v: T): ()! {
  let recKey = kvRecordKey(c.name, id)
  let existing = kvTxGetOrNone(tx, recKey)
  if (isSome(existing)) {
    let oldValue = c.decode(unwrap(existing))?
    let i = 0
    while (i < len(c.indexes)) {
      let idx = c.indexes[i]
      tx.delete(kvIndexKey(c.name, idx.name, idx.keyOf(oldValue), id))?
      i = i + 1
    }
  }
  tx.put(recKey, []byte(jsonEncode(v.toJson())))?
  let j = 0
  while (j < len(c.indexes)) {
    let idx = c.indexes[j]
    tx.put(kvIndexKey(c.name, idx.name, idx.keyOf(v), id), id)?
    j = j + 1
  }
}

fn kvCollGet<T: KvJsonable>(c: Collection<T>, tx: Tx, id: []byte): T! {
  let raw = tx.get(kvRecordKey(c.name, id))?
  return c.decode(raw)?
}

fn kvCollDelete<T: KvJsonable>(c: Collection<T>, tx: Tx, id: []byte): ()! {
  let recKey = kvRecordKey(c.name, id)
  let existing = kvTxGetOrNone(tx, recKey)
  if (isNone(existing)) {
    return
  }
  let oldValue = c.decode(unwrap(existing))?
  tx.delete(recKey)?
  let i = 0
  while (i < len(c.indexes)) {
    let idx = c.indexes[i]
    tx.delete(kvIndexKey(c.name, idx.name, idx.keyOf(oldValue), id))?
    i = i + 1
  }
}

fn kvCollAll<T: KvJsonable>(c: Collection<T>, tx: Tx): []T! {
  let (lo, hi) = kvPrefixRange(kvRecordPrefix(c.name))
  let raws = tx.scan(lo, hi)?
  let out: []T = []T(0)
  let i = 0
  while (i < len(raws)) {
    out = append(out, c.decode(raws[i])?)
    i = i + 1
  }
  return out
}

fn kvCollBy<T: KvJsonable>(c: Collection<T>, tx: Tx, index: string, value: []byte): []T! {
  let (lo, hi) = kvPrefixRange(kvIndexValuePrefix(c.name, index, value))
  let ids = tx.scan(lo, hi)?
  let out: []T = []T(0)
  let i = 0
  while (i < len(ids)) {
    let raw = tx.get(kvRecordKey(c.name, ids[i]))?
    out = append(out, c.decode(raw)?)
    i = i + 1
  }
  return out
}

// `Tx.get`, with "not found" (or any other read failure) turned into
// `Option<[]byte>.None` instead of propagated — `kvCollSave`/`kvCollDelete`
// both need "does this id already have a record", never the distinction
// between absent and erroring: a genuinely broken `tx` still fails loudly on
// the unconditional `put`/`delete` call that follows either of them.
fn kvTxGetOrNone(tx: Tx, key: []byte): Option<[]byte> {
  let v = tx.get(key) catch _ {
    return Option<[]byte>.None
  }
  return Option.Some(v)
}

// Tags distinguishing a collection's own records from its index entries in
// the shared key space — distinct first bytes ("r" vs "i"), so neither tag
// can ever be mistaken for the other regardless of what a collection or
// index is named.
const kvRecTag: string = "r"
const kvIdxTag: string = "i"

// The fixed prefix for every record `kvRecordKey` under `name` — ends in
// `kvSep`, as `kvPrefixRange` requires.
fn kvRecordPrefix(name: string): []byte {
  let out = []byte(kvRecTag)
  out = append(out, kvSep)
  out = append(out, ...[]byte(name))
  out = append(out, kvSep)
  return out
}

// The exact key `id`'s record is stored under, within collection `name`.
fn kvRecordKey(name: string, id: []byte): []byte {
  return append(kvRecordPrefix(name), ...id)
}

// The fixed prefix for every index entry of collection `name`'s index
// `indexName` whose indexed value is exactly `value` — ends in `kvSep`, as
// `kvPrefixRange` requires, regardless of what `value`'s own trailing byte
// is (fixed-width int/float or self-terminating string, per keyencoding.bit,
// or anything else a caller's `keyOf` returns).
fn kvIndexValuePrefix(name: string, indexName: string, value: []byte): []byte {
  let out = []byte(kvIdxTag)
  out = append(out, kvSep)
  out = append(out, ...[]byte(name))
  out = append(out, kvSep)
  out = append(out, ...[]byte(indexName))
  out = append(out, kvSep)
  out = append(out, ...value)
  out = append(out, kvSep)
  return out
}

// The exact key one index entry (collection `name`, index `indexName`,
// value `value`, record `id`) is stored under. The value stored there is
// `id` itself — see this file's header for why the entry's VALUE, not its
// key tail, is what `by()` actually reads back.
fn kvIndexKey(name: string, indexName: string, value: []byte, id: []byte): []byte {
  return append(kvIndexValuePrefix(name, indexName, value), ...id)
}

// `[lo, hi)` bounding every key with prefix `p`. Every prefix this file
// builds ends in `kvSep` (0x00) by construction; `hi` is `p` with that final
// byte bumped to 0x01 and every earlier byte left untouched. That is
// strictly greater than `p` plus ANY suffix — the byte at that position is
// 0x00 for every key sharing the prefix and 0x01 for `hi`, so the comparison
// is decided right there regardless of what follows — and no greater than
// necessary, since nothing this file produces shares `p`'s bytes up to but
// not including that final `kvSep`.
fn kvPrefixRange(p: []byte): ([]byte, []byte) {
  if (len(p) == 0 || p[len(p) - 1] != kvSep) {
    panic("kv: kvPrefixRange: prefix must end in the separator byte")
  }
  let hi = append([]byte(0), ...p)
  hi[len(hi) - 1] = 0x01
  return (p, hi)
}
