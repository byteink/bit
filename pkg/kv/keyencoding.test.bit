// pkg/kv/keyencoding.test.bit — property tests for the order-preserving key
// codec (#3467, #5715). Round-trip alone (`decode(encode(v)) == v`) proves
// almost nothing about ordering; every check here also sorts the SAME
// values two ways — once by native value comparison, once by the raw
// encoded bytes (compared as `string`, which SPEC 14.6 defines as plain
// unsigned byte comparison) — and asserts the two orders match exactly, so
// a broken encoder that merely LOOKS plausible on a handful of examples
// cannot pass by accident.
//
// The value sets deliberately span the boundaries a small example table
// would skip: both extremes of i64, both signs of zero, both infinities,
// the empty string, a string that is a prefix of another, and strings
// containing the codec's own separator byte.

import { sortInPlace } from "std/sort"

class intCase {
  v: i64,
  enc: string,
}

class floatCase {
  v: f64,
  enc: string,
}

class stringCase {
  v: string,
  enc: string,
}

// Both i64 extremes, both sides of the sign flip at zero, and a spread
// across the range: a broken sign-bit XOR only misorders values that
// straddle zero, so values confined to one side would miss it.
fn intBoundaries(): []i64 {
  let out: []i64 = [
    -9223372036854775808, -9223372036854775807, -4611686018427387904,
    -100, -1, 0, 1, 100, 4611686018427387904,
    9223372036854775806, 9223372036854775807,
  ]
  return out
}

// Both infinities, large and small magnitudes on both signs, and both zeros
// — NaN is excluded here because it has no order to check; its rejection is
// its own test below.
fn floatBoundaries(): []f64 {
  let posInf = 1.0 / 0.0
  let negInf = 0.0 - posInf
  let out: []f64 = [negInf, -1e300, -1.5, -0.0, 0.0, 1.5, 1e300, posInf]
  return out
}

// Empty, single-character, a string that is a strict prefix of another, and
// several strings containing the separator byte (0x00) alone, doubled, and
// mixed with ordinary content — the acceptance-required "round-trips a
// string containing the chosen separator byte literally" case, several ways.
fn stringBoundaries(): []string {
  let out: []string = [
    "", "a", "app", "apple", "b", "z",
    "\x00", "\x00\x00", "a\x00", "a\x00b", "\x00b",
  ]
  return out
}

// Encodes every value in `values`, checks the round-trip, then sorts one
// copy by native `<` and another by encoded-bytes `<` and asserts the two
// orderings name the same value at every rank.
fn checkIntOrder(values: []i64) {
  let byValue: []intCase = []
  for v of values {
    assert(decodeInt(encodeInt(v)) == v, "encodeInt/decodeInt round-trip failed for ${v}")
    byValue = append(byValue, intCase{ v = v, enc = string(encodeInt(v)) })
  }
  let byBytes: []intCase = []
  for c of byValue {
    byBytes = append(byBytes, c)
  }
  sortInPlace(byValue, (a: intCase, b: intCase) => a.v < b.v)
  sortInPlace(byBytes, (a: intCase, b: intCase) => a.enc < b.enc)
  let i = 0
  while (i < len(byValue)) {
    assert(
      byValue[i].v == byBytes[i].v,
      "int order mismatch at rank ${i}: by-value ${byValue[i].v}, by-bytes ${byBytes[i].v}",
    )
    i = i + 1
  }
}

// Same shape as `checkIntOrder`. Compares round-tripped bits, not `==`, so
// that -0.0 and 0.0 (numerically equal, bit-distinct) are proven to decode
// back to exactly the value that was encoded, not merely "some zero".
fn checkFloatOrder(values: []f64) {
  let byValue: []floatCase = []
  for v of values {
    let back = decodeFloat(encodeFloat(v))
    assert(
      floatBits(back) == floatBits(v),
      "encodeFloat/decodeFloat round-trip not bit-exact for ${v}",
    )
    byValue = append(byValue, floatCase{ v = v, enc = string(encodeFloat(v)) })
  }
  let byBytes: []floatCase = []
  for c of byValue {
    byBytes = append(byBytes, c)
  }
  sortInPlace(byValue, (a: floatCase, b: floatCase) => a.v < b.v)
  sortInPlace(byBytes, (a: floatCase, b: floatCase) => a.enc < b.enc)
  let i = 0
  while (i < len(byValue)) {
    assert(
      floatBits(byValue[i].v) == floatBits(byBytes[i].v),
      "float order mismatch at rank ${i}",
    )
    i = i + 1
  }
}

// Same shape as `checkIntOrder`.
fn checkStringOrder(values: []string) {
  let byValue: []stringCase = []
  for v of values {
    assert(
      decodeString(encodeString(v)) == v,
      "encodeString/decodeString round-trip failed for '${v}'",
    )
    byValue = append(byValue, stringCase{ v = v, enc = string(encodeString(v)) })
  }
  let byBytes: []stringCase = []
  for c of byValue {
    byBytes = append(byBytes, c)
  }
  sortInPlace(byValue, (a: stringCase, b: stringCase) => a.v < b.v)
  sortInPlace(byBytes, (a: stringCase, b: stringCase) => a.enc < b.enc)
  let i = 0
  while (i < len(byValue)) {
    assert(
      byValue[i].v == byBytes[i].v,
      "string order mismatch at rank ${i}: by-value '${byValue[i].v}', by-bytes '${byBytes[i].v}'",
    )
    i = i + 1
  }
}

test "encodeInt/decodeInt round-trips and preserves order across the full i64 range" {
  checkIntOrder(intBoundaries())
}

test "encodeFloat/decodeFloat round-trips and preserves order including signed zero and both infinities" {
  checkFloatOrder(floatBoundaries())
}

test "encodeString/decodeString round-trips and preserves order for empty, prefix and separator-bearing strings" {
  checkStringOrder(stringBoundaries())
}

// `bit test` treats the `testpanic_` prefix as a verdict modifier (SPEC
// 18.4): this PASSES only if the call below panics, in its own child
// process. NaN has no total order, so `encodeFloat` refuses it rather than
// silently placing it somewhere.
test "testpanic_encodeFloat rejects NaN" {
  let nan = 0.0 / 0.0
  encodeFloat(nan)
}
