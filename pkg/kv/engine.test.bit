// pkg/kv/engine.test.bit — page I/O and meta-page recovery (#3467, #5716).
//
// The load-bearing property here is TORN-WRITE DETECTION: a meta page whose
// on-disk bytes were corrupted directly (bypassing the engine entirely, via
// a raw `File.writeAt`) must never be trusted, and `open` must still recover
// as long as the OTHER meta page is intact. A checksum test that only ever
// sees checksums it computed itself proves nothing — see the CRC-flip test
// below, which corrupts real on-disk bytes and checks `open`'s behavior
// changes, not just that some internal comparison runs.

import { envOr, run } from "std/os"
import { remove } from "std/fs"

// Nonce'd per call (bitlang-ws/CLAUDE.md: `$TMPDIR` is shared by every
// concurrent agent, and a fixed name is the bug this rule exists for).
fn scratchPath(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-kv-5716-${tag}-${timeUnixNs()}"
}

// `open`, with failure turned into `None` instead of propagated, so a test
// can assert "open must fail" without needing a dummy Engine to return from
// a catch block.
fn tryOpen(path: string): Option<Engine> {
  let eng = open(path) catch _ {
    return Option<Engine>.None
  }
  return Option.Some(eng)
}

// Overwrites meta page `id` (0 = meta A, 1 = meta B) at `path` with garbage,
// bypassing the Engine entirely — a raw `File.writeAt`, exactly the
// "caller can force one meta page's bytes to be garbage" scenario #5716's
// acceptance describes.
//
// Flips ONE byte, in the page's RESERVED tail past the header (leaves magic,
// version, page size and txid untouched) so the ONLY thing that can catch
// this corruption is the checksum — a corruption a magic/version/size check
// would also happen to reject would not prove the CRC check does anything.
// This is the mutation this file's own header promises: engine.bit's CRC
// comparison was disabled by hand, this same corruption was applied, and
// `bit test pkg/kv` went from green to a `both meta pages are corrupted`
// failure (meta A no longer rejected, so meta B's still-valid page failed to
// win); reverting made it green again.
fn corruptMetaPage(path: string, id: int, pageSize: int) {
  let raw = openReadWrite(path) catch e {
    panic("corruptMetaPage: openReadWrite ${path}: ${e.message()}")
  }
  let off = i64(id * pageSize)
  let buf = []byte(pageSize)
  let n = raw.readAt(buf, off) catch e {
    panic("corruptMetaPage: readAt page ${id}: ${e.message()}")
  }
  if (n != pageSize) {
    panic("corruptMetaPage: short read of page ${id}: got ${n} of ${pageSize} bytes")
  }
  buf[pageSize - 1] = buf[pageSize - 1] ^ 0xff
  raw.writeAt(buf, off) catch e {
    panic("corruptMetaPage: writeAt page ${id}: ${e.message()}")
  }
  raw.sync() catch e {
    panic("corruptMetaPage: sync: ${e.message()}")
  }
  raw.close()
}

test "create, close, reopen: open() reports the same page size and the initial txid" {
  let path = scratchPath("roundtrip")
  let eng1 = create(path) catch e {
    panic("create: ${e.message()}")
  }
  let pageSize1 = eng1.pageSize
  eng1.close()

  let eng2 = open(path) catch e {
    panic("open after create: ${e.message()}")
  }
  assert(
    eng2.pageSize == pageSize1,
    "reopened page size ${eng2.pageSize} != created page size ${pageSize1}",
  )
  assert(eng2.txid == 0, "reopened txid ${eng2.txid} != initial txid 0")
  eng2.close()
  kvTestTeardown(path)
}

test "open recovers via meta B when meta A's on-disk bytes are corrupted" {
  let path = scratchPath("recoverb")
  let created = create(path) catch e {
    panic("create: ${e.message()}")
  }
  let pageSize = created.pageSize
  created.close()

  corruptMetaPage(path, 0, pageSize)

  let got = tryOpen(path)
  assert(isSome(got), "open must succeed by falling back to meta B when only meta A is corrupted")
  let eng = unwrap(got)
  assert(eng.pageSize == pageSize, "recovered page size ${eng.pageSize} != ${pageSize}")
  assert(eng.txid == 0, "recovered txid ${eng.txid} != initial txid 0")
  eng.close()
  kvTestTeardown(path)
}

test "open recovers via meta A when meta B's on-disk bytes are corrupted" {
  let path = scratchPath("recovera")
  let created = create(path) catch e {
    panic("create: ${e.message()}")
  }
  let pageSize = created.pageSize
  created.close()

  corruptMetaPage(path, 1, pageSize)

  let got = tryOpen(path)
  assert(isSome(got), "open must succeed by falling back to meta A when only meta B is corrupted")
  let eng = unwrap(got)
  assert(eng.txid == 0, "recovered txid ${eng.txid} != initial txid 0")
  eng.close()
  kvTestTeardown(path)
}

test "open fails, not a bogus Engine, when both meta pages are corrupted" {
  let path = scratchPath("bothbad")
  let created = create(path) catch e {
    panic("create: ${e.message()}")
  }
  let pageSize = created.pageSize
  created.close()

  corruptMetaPage(path, 0, pageSize)
  corruptMetaPage(path, 1, pageSize)

  let got = tryOpen(path)
  assert(
    isNone(got),
    "open must fail, not silently return an Engine, when neither meta page validates",
  )
  kvTestTeardown(path)
}

test "writePage/readPage round-trips an arbitrary page's exact bytes" {
  let path = scratchPath("pageio")
  let eng = create(path) catch e {
    panic("create: ${e.message()}")
  }
  let pageSize = eng.pageSize
  let want = []byte(pageSize)
  let i = 0
  while (i < pageSize) {
    want[i] = byte((i * 167 + 13) % 256)
    i = i + 1
  }
  eng.writePage(2, want) catch e {
    panic("writePage: ${e.message()}")
  }
  let got = eng.readPage(2) catch e {
    panic("readPage: ${e.message()}")
  }
  assert(len(got) == pageSize, "readPage returned ${len(got)} bytes, want ${pageSize}")
  let j = 0
  while (j < pageSize) {
    assert(got[j] == want[j], "page byte ${j}: got ${got[j]}, want ${want[j]}")
    j = j + 1
  }
  eng.close()
  kvTestTeardown(path)
}

// `bit test` treats the `testpanic_` prefix as a verdict modifier (SPEC
// 18.4): this PASSES only if the call below panics, in its own child
// process. `data` must be exactly `pageSize` bytes; handing writePage a
// wrong-sized buffer is a programmer error, so it must panic loudly rather
// than silently truncate, pad, or write a short page.
test "testpanic_writePage rejects a buffer that is not exactly pageSize" {
  let path = scratchPath("wrongsize")
  let eng = create(path) catch e {
    panic("create: ${e.message()}")
  }
  // Torn down BEFORE the call, unlike every other test here: its PASS
  // condition is the panic, so no statement after it ever runs. Safe because
  // `writePage` rejects the length before any I/O (engine.bit:67), so the
  // handle never touches the now-unlinked file.
  kvTestTeardown(path)
  eng.writePage(5, []byte(10)) catch e {
    panic("writePage failed instead of panicking: ${e.message()}")
  }
}

// --- #5797: create is atomic (O_CREAT|O_EXCL|O_NOFOLLOW), not exists-then-open ---

// `create`, with success/failure collapsed to a `bool` — the race test below
// only needs "did I win", and closes the handle itself on a win so it never
// leaks one across 500 iterations.
fn tryCreate(path: string): bool {
  let eng = create(path) catch _ {
    return false
  }
  eng.close()
  return true
}

// Reaches the `ready` rendezvous, then blocks on `go` before racing `create`
// — proves the OTHER spawned task has ALSO already reached the rendezvous
// (the test body below only releases `go` after receiving from `ready`
// twice), so both tasks are genuinely live and about to call `create` at
// the same time, not accidentally serialized by the scheduler.
fn raceCreate(path: string, ready: chan<int>, go: chan<int>, done: chan<bool>) {
  ready <- 1
  let start = <- go
  if (start != 1) {
    panic("raceCreate: bad go signal ${start}")
  }
  done <- tryCreate(path)
}

// #5787's audit: main's `create` checked `exists(path)` then opened without
// `O_EXCL` — two concurrent creates on one path both succeeded 1997 and 1998
// times out of 2000. Two `spawn`ed tasks race `create` on the SAME path,
// `iterations` times; the single `O_CREAT|O_EXCL|O_NOFOLLOW` syscall this
// ticket adds must let exactly one win every time.
//
// RUN WITH BIT_WORKERS=4 (`_tests_/bit/openbeneath/openbeneath.bit`'s own
// header explains why): the default worker pool starts at ONE OS thread and
// grows lazily, so two spawned tasks run cooperatively on that one thread by
// default — never truly concurrent, so a TOCTOU window between two Bit-level
// green threads would never actually open either. The `ready`/`go`
// rendezvous above is the second, in-test half of that same proof: it is
// not enough for `BIT_WORKERS` to be set, both tasks must be OBSERVED to
// have reached the starting line before either attempts `create`.
test "concurrent create on one path over N iterations: exactly one winner every time, both racers ran" {
  let iterations = 500
  let i = 0
  let totalWinners = 0
  while (i < iterations) {
    let path = scratchPath("race-${i}")
    let ready = chan<int>(2)
    let go = chan<int>(2)
    let done = chan<bool>(2)
    spawn raceCreate(path, ready, go, done)
    spawn raceCreate(path, ready, go, done)
    let readyA = <- ready
    let readyB = <- ready
    assert(
      readyA == 1 && readyB == 1,
      "iteration ${i}: both racer tasks must reach the rendezvous before either calls create",
    )
    go <- 1
    go <- 1
    let r1 = <- done
    let r2 = <- done
    let winners = 0
    if (r1) {
      winners = winners + 1
    }
    if (r2) {
      winners = winners + 1
    }
    assert(
      winners == 1,
      "iteration ${i}: expected exactly 1 winner of 2 concurrent creates on ${path}, got ${winners} (r1=${r1} r2=${r2})",
    )
    totalWinners = totalWinners + winners
    // A plain `remove`, not `kvTestTeardown`: every iteration's leftover is
    // exactly one file (the winner's), never a directory, and this loop
    // runs hundreds of times per test — `kvTestTeardown`'s own `#!/bin/sh`
    // subprocess per call is the right tool for a handful of directory
    // teardowns elsewhere in this suite, not this tight a loop.
    remove(path) catch _ {}
    i = i + 1
  }
  assert(
    totalWinners == iterations,
    "expected exactly ${iterations} total winners across ${iterations} iterations (one per path), got ${totalWinners}",
  )
}

// #5787's audit: `create` checked `exists(path)` then opened without
// `O_NOFOLLOW`. `exists` follows a symlink, so it only ever catches a LIVE
// one by accident — a DANGLING symlink (its target absent) reads as "does
// not exist" to `exists` (the underlying open fails ENOENT the same as a
// genuinely missing path), so `create` proceeded straight into
// `openReadWrite`, which itself follows the link and `O_CREAT`s a brand
// new file at wherever the symlink points: a database file planted at an
// attacker-chosen destination, entirely bypassing the caller's own
// `path`. `create` must now refuse outright (`O_NOFOLLOW`) and leave that
// destination untouched. Deterministic and single-shot, not a race: the
// gap is in what `exists` can observe about a dangling link at all, not a
// window between two calls.
test "create refuses a pre-planted dangling symlink at the target path; nothing is planted at its destination" {
  let victim = scratchPath("victim") // never written — must stay absent throughout
  let target = scratchPath("symlink-target")
  let rc = run("/bin/ln", ["-s", victim, target])
  if (rc != 0) {
    panic("/bin/ln -s ${victim} ${target} exited ${rc}")
  }
  assert(
    !tryCreate(target),
    "create must refuse when ${target} is a pre-planted symlink to ${victim}",
  )
  assert(
    !exists(victim),
    "create must not plant a database file at ${victim}, the dangling symlink's destination",
  )
  kvTestTeardown(target)
}
