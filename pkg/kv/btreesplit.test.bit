import { repeat } from "std/strings"

fn splitValues8154(): [][]byte {
  return [[]byte(repeat("a", 3000)), []byte(repeat("b", 2000)), []byte("x"), []byte("x")]
}

fn checkSplitValues8154(db: Db, values: [][]byte): ()! {
  let keys = ["a", "b", "c", "d"]
  for (let i = 0; i < len(keys); i++) {
    assert(string(get(db.eng, db.root, []byte(keys[i]))?) == string(values[i]), keys[i])
  }
  let all = scan(db.eng, db.root, []byte("a"), []byte("e"))?
  assert(len(all) == len(values), "scan count")
  for (let i = 0; i < len(values); i++) {
    assert(string(all[i]) == string(values[i]), "scan order ${i}")
  }
  checkFreeList8083(db)?
}

fn txSplitOrder8154(order: []int, update: bool): ()! {
  let path = scratchPath("byte-split-8154")
  let db = open(path)?
  let keys = ["a", "b", "c", "d"]
  let values = splitValues8154()
  db.tx((tx) => {
    for i of order {
      let value = update ? []byte("x") : values[i]
      tx.put([]byte(keys[i]), value)?
    }
    if (update) {
      for i of order {
        tx.put([]byte(keys[i]), values[i])?
      }
    }
  })?
  checkSplitValues8154(db, values)?
  db.close()
  let reopened = open(path)?
  checkSplitValues8154(reopened, values)?
  reopened.close()
  kvTestTeardown(path)
}

test "byte splits preserve uneven inserts and updates in every insertion order" {
  for (let a = 0; a < 4; a++) {
    for (let b = 0; b < 4; b++) {
      if (a == b) {
        continue
      }
      for (let c = 0; c < 4; c++) {
        if (c == a || c == b) {
          continue
        }
        let d = 6 - a - b - c
        for update of [false, true] {
          txSplitOrder8154([a, b, c, d], update) catch e {
            panic(e.message())
          }
        }
      }
    }
  }
}

fn middleSplit8154(transaction: bool, update: bool, length: int): ()! {
  let path = scratchPath("middle-split-8154")
  let db = open(path)?
  let middle = []byte(repeat("b", i64(length)))
  if (transaction) {
    db.tx((tx) => {
      tx.put([]byte("a"), []byte(repeat("a", 2000)))?
      tx.put([]byte("c"), []byte(repeat("c", 2000)))?
      if (update) {
        tx.put([]byte("b"), []byte("x"))?
      }
      tx.put([]byte("b"), middle)?
    })?
  } else {
    db.root = put(db.eng, db.root, []byte("a"), []byte(repeat("a", 2000)))?
    db.root = put(db.eng, db.root, []byte("c"), []byte(repeat("c", 2000)))?
    if (update) {
      db.root = put(db.eng, db.root, []byte("b"), []byte("x"))?
    }
    db.root = put(db.eng, db.root, []byte("b"), middle)?
  }
  let root = db.root
  db.close()
  let eng = openEngine(path)?
  assert(string(get(eng, root, []byte("a"))?) == repeat("a", 2000), "left")
  assert(string(get(eng, root, []byte("b"))?) == string(middle), "middle")
  assert(string(get(eng, root, []byte("c"))?) == repeat("c", 2000), "right")
  let all = scan(eng, root, []byte("a"), []byte("d"))?
  assert(len(all) == 3 && string(all[1]) == string(middle), "ordered middle")
  eng.close()
  kvTestTeardown(path)
}

test "byte splits handle a three-page middle record through both write paths" {
  for transaction of [false, true] {
    for update of [false, true] {
      for length of [3000, 4081, 4082] {
        middleSplit8154(transaction, update, length) catch e {
          panic(e.message())
        }
      }
    }
  }
}

test "byte splits partition internal separators using their encoded key sizes" {
  let entries: []kvInternalEntry = [
    kvInternalEntry{ key = []byte(repeat("a", 3000)), child = 2 },
    kvInternalEntry{ key = []byte(repeat("b", 2000)), child = 3 },
    kvInternalEntry{ key = []byte("c"), child = 4 },
    kvInternalEntry{ key = []byte("d"), child = 5 },
  ]
  let parts = kvPartitionNode(kvNode.Internal(entries)) catch e {
    panic(e.message())
  }
  assert(len(parts) == 2, "internal partition")
  let seen = 0
  for part of parts {
    assert(kvNodeEncodedSize(part) <= kvPageSize, "internal size")
    let decoded = kvDecodeNode(kvEncodeNode(part))
    match (decoded) {
      Internal(children) => {
        for child of children {
          assert(child.child == entries[seen].child, "child id")
          assert(string(child.key) == string(entries[seen].key), "separator")
          seen = seen + 1
        }
      }
      Leaf(_) => panic("internal became leaf")
    }
  }
  assert(seen == len(entries), "all children retained")
}

fn deepSplit8154(): ()! {
  let path = scratchPath("deep-byte-split-8154")
  let letters = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"]
  let db = open(path)?
  for (let batch = 0; batch < 2; batch++) {
    db.tx((tx) => {
      for letter of letters {
        tx.put([]byte(repeat(letter, 1500)), []byte("${batch}-${letter}"))?
      }
    })?
    checkFreeList8083(db)?
  }
  db.close()
  let reopened = open(path)?
  for letter of letters {
    let got = get(reopened.eng, reopened.root, []byte(repeat(letter, 1500)))?
    assert(string(got) == "1-${letter}", "deep lookup ${letter}")
  }
  let all = scan(reopened.eng, reopened.root, []byte("a"), []byte("z"))?
  assert(len(all) == len(letters), "deep scan count")
  for (let i = 0; i < len(letters); i++) {
    assert(string(all[i]) == "1-${letters[i]}", "deep scan order")
  }
  checkFreeList8083(reopened)?
  reopened.close()
  kvTestTeardown(path)
}

test "byte splits propagate variable separators through multiple branch levels" {
  deepSplit8154() catch e {
    panic(e.message())
  }
}

fn checkPoisoned8154(tx: Tx, message: string): ()! {
  let rejected = 0
  tx.put([]byte("later"), []byte("x")) catch e {
    assert(e.message() == message, "put lost original error")
    rejected = rejected + 1
  }
  tx.delete([]byte("c")) catch e {
    assert(e.message() == message, "delete lost original error")
    rejected = rejected + 1
  }
  tx.get([]byte("c")) catch e {
    assert(e.message() == message, "get lost original error")
    rejected = rejected + 1
  }
  tx.scan([]byte("a"), []byte("z")) catch e {
    assert(e.message() == message, "scan lost original error")
    rejected = rejected + 1
  }
  assert(rejected == 4, "failed transaction accepted later operations")
}

fn checkRootNotFree8154(db: Db): ()! {
  let (free, _) = kvReadFreeList(db.eng, db.eng.freeListRoot)?
  for id of free {
    assert(id != db.root, "live root is free")
  }
  checkFreeList8083(db)?
}

fn catchWrite8154(tx: Tx, empty: bool, branch: bool, expected: string): ()! {
  if (!empty) {
    tx.put([]byte("earlier"), []byte("must roll back"))?
  }
  let message = ""
  let key = branch ? []byte(repeat("z", 4070)) : []byte("a")
  let value = branch ? []byte("x") : []byte(repeat("a", 5000))
  tx.put(key, value) catch e {
    message = e.message()
  }
  assert(message == expected, "missing original size error")
  checkPoisoned8154(tx, message)?
}

fn caughtWrite8154(empty: bool, branch: bool): ()! {
  let path = scratchPath("caught-write-8154")
  let db = open(path)?
  if (!empty) {
    db.tx((tx) => {
      tx.put([]byte("c"), []byte("x"))?
      tx.put([]byte("d"), []byte("x"))?
    })?
  }
  let root = db.root
  let txid = db.eng.txid
  let failed = false
  let expected = branch ? "kv: keys exceed branch page capacity" : "kv: entry exceeds page size"
  db.tx((tx) => {
    catchWrite8154(tx, empty, branch, expected)?
  }) catch e {
    assert(e.message() == expected, "outer error changed")
    failed = true
  }
  assert(failed, "caught write error committed")
  assert(db.root == root && db.eng.txid == txid, "rollback changed committed state")
  checkRootNotFree8154(db)?
  assert(!keyExists(db.eng, db.root, []byte("earlier")), "earlier write survived")
  for (let i = 0; i < 3; i++) {
    db.tx((tx) => {
      tx.put([]byte("new"), []byte("${i}"))?
    })?
    checkRootNotFree8154(db)?
  }
  db.close()
  let reopened = open(path)?
  assert(string(get(reopened.eng, reopened.root, []byte("new"))?) == "2", "same Db progress")
  if (!empty) {
    assert(string(get(reopened.eng, reopened.root, []byte("c"))?) == "x", "old c lost")
    assert(string(get(reopened.eng, reopened.root, []byte("d"))?) == "x", "old d lost")
  }
  assert(!keyExists(reopened.eng, reopened.root, []byte("earlier")), "reopen rollback")
  checkRootNotFree8154(reopened)?
  reopened.close()
  kvTestTeardown(path)
}

test "byte splits abort caught write errors and preserve the same Db even on an empty tree" {
  for empty of [false, true] {
    caughtWrite8154(empty, false) catch e {
      panic(e.message())
    }
  }
  caughtWrite8154(false, true) catch e {
    panic(e.message())
  }
}

test "byte splits preserve direct roots on write errors and accept a later write" {
  let path = scratchPath("direct-error-8154")
  let eng = mustCreate(path)
  let emptyFailed = false
  put(eng, noRoot, []byte("a"), []byte(repeat("a", 5000))) catch _ {
    emptyFailed = true
  }
  assert(emptyFailed, "empty direct tree accepted an oversized record")
  let root = put(eng, noRoot, []byte("c"), []byte("x")) catch e {
    panic(e.message())
  }
  let failed = false
  put(eng, root, []byte("a"), []byte(repeat("a", 5000))) catch _ {
    failed = true
  }
  assert(failed && string(getOrEmpty(eng, root, []byte("c"))) == "x", "old root changed")
  let next = put(eng, root, []byte("b"), []byte("y")) catch e {
    panic(e.message())
  }
  assert(string(getOrEmpty(eng, next, []byte("c"))) == "x", "c lost after retry")
  assert(string(getOrEmpty(eng, next, []byte("b"))) == "y", "retry missing")
  eng.close()
  kvTestTeardown(path)
}
