// pkg/kv/collection.test.bit — #5724's acceptance, re-pointed at #6257's
// `store.collection<T>()` API.
//
// The property this ticket exists for is the third test below
// ("re-saving ... removes the stale index entry"): a record saved once,
// then saved AGAIN under a CHANGED indexed value, must stop appearing under
// its old value and start appearing under its new one, inside one fresh
// `set()`. A test that only ever saves new records (the first test) cannot
// fail on a missing stale-delete — this file's mutation proof targets
// exactly that path.
//
// `Widget` is `@json` (SPEC §10.5) on purpose: it is this codebase's own
// existing `T` marshaling convention, and #6257 makes it the ONLY one —
// `Collection<T>` now requires `T: KvJsonable` and encodes/decodes through
// `toJson()`/`jsonDecode<T>` itself, so this file no longer hand-writes a
// `marshal`/`unmarshal` pair.

fn scratchPath5724(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-kv-5724-${tag}-${timeUnixNs()}"
}

@json class Widget {
  id: string,
  name: string,
  price: i64,
}

fn widgetPriceKey(w: Widget): []byte {
  return encodeInt(w.price)
}

fn openWidgetsDbAt(path: string): Db {
  let db = open(path) catch e {
    panic("open: ${e.message()}")
  }
  return db
}

fn declarePriceIndex(widgets: Collection<Widget>): ()! {
  declareIndex<Widget>(widgets, "price", widgetPriceKey)?
}

test "by(index, value) returns exactly the matching records, by content and by count" {
  let path = scratchPath5724("by-basic")
  let db = openWidgetsDbAt(path)
  let widgets = db.collection<Widget>("widgets")
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  widgets.set(1, Widget{ id = "a", name = "Anvil", price = 100 }) catch e {
    panic("set a: ${e.message()}")
  }
  widgets.set(2, Widget{ id = "b", name = "Brick", price = 200 }) catch e {
    panic("set b: ${e.message()}")
  }
  widgets.set(3, Widget{ id = "c", name = "Crate", price = 100 }) catch e {
    panic("set c: ${e.message()}")
  }

  let at100 = widgets.by("price", encodeInt(100)) catch e {
    panic("by 100: ${e.message()}")
  }
  assert(len(at100) == 2, "expected 2 widgets at price 100, got ${len(at100)}")
  assert(
    at100[0].id == "a" && at100[0].name == "Anvil",
    "first match at price 100 wrong: ${at100[0].id}",
  )
  assert(
    at100[1].id == "c" && at100[1].name == "Crate",
    "second match at price 100 wrong: ${at100[1].id}",
  )

  let at200 = widgets.by("price", encodeInt(200)) catch e {
    panic("by 200: ${e.message()}")
  }
  assert(len(at200) == 1, "expected 1 widget at price 200, got ${len(at200)}")
  assert(
    at200[0].id == "b" && at200[0].name == "Brick",
    "match at price 200 wrong: ${at200[0].id}",
  )
  db.close()
  kvTestTeardown(path)
}

// THE LOAD-BEARING TEST. See this file's header.
test "re-saving a record with a changed indexed value removes the stale index entry" {
  let path = scratchPath5724("resave")
  let db = openWidgetsDbAt(path)
  let widgets = db.collection<Widget>("widgets")
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  widgets.set(1, Widget{ id = "a", name = "Anvil", price = 100 }) catch e {
    panic("set initial: ${e.message()}")
  }
  widgets.set(1, Widget{ id = "a", name = "Anvil", price = 150 }) catch e {
    panic("set resave: ${e.message()}")
  }

  let oldPrice = widgets.by("price", encodeInt(100)) catch e {
    panic("by 100: ${e.message()}")
  }
  assert(
    len(oldPrice) == 0,
    "stale index entry for old price 100 must be gone, got ${len(oldPrice)}",
  )

  let newPrice = widgets.by("price", encodeInt(150)) catch e {
    panic("by 150: ${e.message()}")
  }
  assert(len(newPrice) == 1, "expected 1 widget at new price 150, got ${len(newPrice)}")
  assert(newPrice[0].id == "a", "wrong widget returned for new price: ${newPrice[0].id}")
  db.close()
  kvTestTeardown(path)
}

test "delete removes every index entry for the record" {
  let path = scratchPath5724("delete")
  let db = openWidgetsDbAt(path)
  let widgets = db.collection<Widget>("widgets")
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  widgets.set(1, Widget{ id = "a", name = "Anvil", price = 100 }) catch e {
    panic("set: ${e.message()}")
  }
  widgets.delete(1) catch e {
    panic("delete: ${e.message()}")
  }
  let matches = widgets.by("price", encodeInt(100)) catch e {
    panic("by: ${e.message()}")
  }
  assert(
    len(matches) == 0,
    "deleted widget must not appear under its old index value, got ${len(matches)}",
  )
  db.close()
  kvTestTeardown(path)
}

test "all() returns every saved record in ascending id order" {
  let path = scratchPath5724("all")
  let db = openWidgetsDbAt(path)
  let widgets = db.collection<Widget>("widgets")
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  // Saved out of id order on purpose, so this test cannot pass by accident
  // of insertion order.
  widgets.set(3, Widget{ id = "c", name = "Crate", price = 300 }) catch e {
    panic("set c: ${e.message()}")
  }
  widgets.set(1, Widget{ id = "a", name = "Anvil", price = 100 }) catch e {
    panic("set a: ${e.message()}")
  }
  widgets.set(2, Widget{ id = "b", name = "Brick", price = 200 }) catch e {
    panic("set b: ${e.message()}")
  }

  let everything = widgets.all() catch e {
    panic("all: ${e.message()}")
  }
  assert(len(everything) == 3, "expected 3 widgets total, got ${len(everything)}")
  assert(
    everything[0].id == "a" && everything[1].id == "b" && everything[2].id == "c",
      "all() must return ascending id order, got ${everything[0].id}/" +
      "${everything[1].id}/${everything[2].id}",
  )
  db.close()
  kvTestTeardown(path)
}

// #6257's own acceptance: outside an explicit `store.tx()` block, every
// `Collection` call opens and commits its own transaction — a `get`
// immediately after a `set` on the SAME collection value must see it, with
// no shared `tx` passed between the two calls (there is nowhere left to
// pass one; the new API takes none).
test "implicit per-call transaction: a set is visible to the very next get with no shared tx" {
  let path = scratchPath5724("implicit-tx")
  let db = openWidgetsDbAt(path)
  let widgets = db.collection<Widget>("widgets")
  widgets.set(1, Widget{ id = "a", name = "Anvil", price = 100 }) catch e {
    panic("set: ${e.message()}")
  }
  let got = widgets.get(1) catch e {
    panic("get: ${e.message()}")
  }
  assert(got.id == "a" && got.name == "Anvil" && got.price == 100, "wrong record back: ${got.id}")
  db.close()
  kvTestTeardown(path)
}

// #6257's own acceptance: `store.tx((t) => {...})` is all-or-nothing across
// TWO different collections in the same block — a failure partway through
// must roll back both writes, not just the one that failed.
test "store.tx is all-or-nothing: a failure inside rolls back every write in the block" {
  let path = scratchPath5724("tx-all-or-nothing")
  let db = openWidgetsDbAt(path)
  let failed = false
  db.tx((t) => {
    let widgets = t.collection<Widget>("widgets")
    widgets.set(1, Widget{ id = "a", name = "Anvil", price = 100 })?
    widgets.set(2, Widget{ id = "b", name = "Brick", price = 200 })?
    fail newError("forced failure partway through the block")
  }) catch _ {
    failed = true
  }
  assert(failed, "db.tx must fail when the block fails")

  let widgets = db.collection<Widget>("widgets")
  let everything = widgets.all() catch e {
    panic("all: ${e.message()}")
  }
  assert(
    len(everything) == 0,
    "a failure inside store.tx must roll back EVERY write in the block, found ${len(everything)}",
  )
  db.close()
  kvTestTeardown(path)
}

// #6257's own acceptance: `get` of an id with no record is an error, not a
// zero value or an empty result — matches `Tx.get`'s own "key not found"
// contract one layer down.
test "get of a missing id is an error" {
  let path = scratchPath5724("missing-get")
  let db = openWidgetsDbAt(path)
  let widgets = db.collection<Widget>("widgets")
  let failed = false
  widgets.get(999) catch _ {
    failed = true
    return
  }
  assert(failed, "get of a missing id must fail, not return a zero value")
  db.close()
  kvTestTeardown(path)
}
