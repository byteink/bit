// pkg/kv/collection.test.bit — #5724's acceptance.
//
// The property this ticket exists for is the third test below
// ("re-saving ... removes the stale index entry"): a record saved once,
// then saved AGAIN under a CHANGED indexed value, must stop appearing under
// its old value and start appearing under its new one, inside one fresh
// `db.write()`. A test that only ever saves new records (the first test)
// cannot fail on a missing stale-delete — this file's mutation proof targets
// exactly that path.
//
// `Widget` is `@json` (SPEC §10.5) on purpose: it is this codebase's own
// existing `T` marshaling convention (`toJson()` + `stdlib/json`'s
// `jsonEncode`/`jsonParse`/`jsonDecode<T>`, verified in `pkg/web/res.bit`
// and `pkg/orm/jsoncol.bit` before writing this), not a one-off byte format
// invented for this test.

import { Json, JsonEntry, jsonDecode, jsonEncode, jsonParse } from "std/json"

fn scratchPath5724(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-kv-5724-${tag}-${timeUnixNs()}"
}

@json class Widget {
  id: string,
  name: string,
  price: i64,
}

fn widgetMarshal(w: Widget): []byte {
  return []byte(jsonEncode(w.toJson()))
}

fn widgetUnmarshal(b: []byte): Widget! {
  let j = jsonParse(string(b))?
  return jsonDecode<Widget>(j)?
}

fn widgetPriceKey(w: Widget): []byte {
  return encodeInt(w.price)
}

fn newWidgets(): Collection<Widget> {
  return newCollection<Widget>("widgets", widgetMarshal, widgetUnmarshal)
}

fn openWidgetsDb(tag: string): Db {
  let db = createDb(scratchPath5724(tag)) catch e {
    panic("createDb: ${e.message()}")
  }
  return db
}

fn declarePriceIndex(widgets: Collection<Widget>): ()! {
  declareIndex<Widget>(widgets, "price", widgetPriceKey)?
}

test "by(index, value) returns exactly the matching records, by content and by count" {
  let db = openWidgetsDb("by-basic")
  let widgets = newWidgets()
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  db.write((tx) => {
    widgets.save(tx, []byte("a"), Widget{ id = "a", name = "Anvil", price = 100 })?
    widgets.save(tx, []byte("b"), Widget{ id = "b", name = "Brick", price = 200 })?
    widgets.save(tx, []byte("c"), Widget{ id = "c", name = "Crate", price = 100 })?
  }) catch e {
    panic("write: ${e.message()}")
  }
  db.write((tx) => {
    let at100 = widgets.by(tx, "price", encodeInt(100))?
    assert(len(at100) == 2, "expected 2 widgets at price 100, got ${len(at100)}")
    assert(
      at100[0].id == "a" && at100[0].name == "Anvil",
      "first match at price 100 wrong: ${at100[0].id}",
    )
    assert(
      at100[1].id == "c" && at100[1].name == "Crate",
      "second match at price 100 wrong: ${at100[1].id}",
    )

    let at200 = widgets.by(tx, "price", encodeInt(200))?
    assert(len(at200) == 1, "expected 1 widget at price 200, got ${len(at200)}")
    assert(
      at200[0].id == "b" && at200[0].name == "Brick",
      "match at price 200 wrong: ${at200[0].id}",
    )
  }) catch e {
    panic("read: ${e.message()}")
  }
  db.close()
}

// THE LOAD-BEARING TEST. See this file's header.
test "re-saving a record with a changed indexed value removes the stale index entry" {
  let db = openWidgetsDb("resave")
  let widgets = newWidgets()
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  db.write((tx) => {
    widgets.save(tx, []byte("a"), Widget{ id = "a", name = "Anvil", price = 100 })?
  }) catch e {
    panic("write initial: ${e.message()}")
  }
  db.write((tx) => {
    widgets.save(tx, []byte("a"), Widget{ id = "a", name = "Anvil", price = 150 })?
  }) catch e {
    panic("write resave: ${e.message()}")
  }
  db.write((tx) => {
    let oldPrice = widgets.by(tx, "price", encodeInt(100))?
    assert(
      len(oldPrice) == 0,
      "stale index entry for old price 100 must be gone, got ${len(oldPrice)}",
    )

    let newPrice = widgets.by(tx, "price", encodeInt(150))?
    assert(len(newPrice) == 1, "expected 1 widget at new price 150, got ${len(newPrice)}")
    assert(newPrice[0].id == "a", "wrong widget returned for new price: ${newPrice[0].id}")
  }) catch e {
    panic("read: ${e.message()}")
  }
  db.close()
}

test "delete removes every index entry for the record" {
  let db = openWidgetsDb("delete")
  let widgets = newWidgets()
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  db.write((tx) => {
    widgets.save(tx, []byte("a"), Widget{ id = "a", name = "Anvil", price = 100 })?
  }) catch e {
    panic("write: ${e.message()}")
  }
  db.write((tx) => {
    widgets.delete(tx, []byte("a"))?
  }) catch e {
    panic("delete: ${e.message()}")
  }
  db.write((tx) => {
    let matches = widgets.by(tx, "price", encodeInt(100))?
    assert(
      len(matches) == 0,
      "deleted widget must not appear under its old index value, got ${len(matches)}",
    )
  }) catch e {
    panic("read: ${e.message()}")
  }
  db.close()
}

test "all() returns every saved record regardless of index" {
  let db = openWidgetsDb("all")
  let widgets = newWidgets()
  declarePriceIndex(widgets) catch e {
    panic("declareIndex: ${e.message()}")
  }
  db.write((tx) => {
    widgets.save(tx, []byte("a"), Widget{ id = "a", name = "Anvil", price = 100 })?
    widgets.save(tx, []byte("b"), Widget{ id = "b", name = "Brick", price = 200 })?
    widgets.save(tx, []byte("c"), Widget{ id = "c", name = "Crate", price = 300 })?
  }) catch e {
    panic("write: ${e.message()}")
  }
  db.write((tx) => {
    let everything = widgets.all(tx)?
    assert(len(everything) == 3, "expected 3 widgets total, got ${len(everything)}")
  }) catch e {
    panic("read: ${e.message()}")
  }
  db.close()
}
