// Fixed seeds make a codec failure replayable without a database or random input.
fn kpNext(state: u64): u64 {
  state = state ^ (state << 13)
  state = state ^ (state >> 7)
  return state ^ (state << 17)
}

fn kpSeeds(): []u64 {
  return [1, 42, 8154]
}

fn kpInts(seed: u64): []i64 {
  let values = intBoundaries()
  let state = seed
  let i = 0
  while (i < 256) {
    state = kpNext(state)
    values = append(values, i64(state))
    i = i + 1
  }
  return values
}

fn kpIntPair(a: i64, b: i64, context: string) {
  let x = string(encodeInt(a))
  let y = string(encodeInt(b))
  assert(a < b == (x < y), "int byte order ${context}: ${a}, ${b}")
  assert(a == b == (x == y), "int equality ${context}: ${a}, ${b}")
}

fn kpCheckInts(seed: u64) {
  let values = kpInts(seed)
  checkIntOrder(values)
  sortInPlace(values, (a: i64, b: i64) => a < b)
  let i = 1
  while (i < len(values)) {
    kpIntPair(values[i - 1], values[i], "seed=${seed} adjacent=${i}")
    i = i + 1
  }
  let state = seed
  i = 0
  while (i < 1024) {
    state = kpNext(state)
    let a = int(state % u64(len(values)))
    state = kpNext(state)
    let b = int(state % u64(len(values)))
    kpIntPair(values[a], values[b], "seed=${seed} pair=${i}")
    i = i + 1
  }
}

fn kpFloats(seed: u64): []f64 {
  let values = floatBoundaries()
  let edges: []u64 = [
    0, 0x8000000000000000, 1, 0x8000000000000001,
    0x000fffffffffffff, 0x800fffffffffffff,
    0x0010000000000000, 0x8010000000000000,
    0x7fefffffffffffff, 0xffefffffffffffff,
  ]
  for bits of edges {
    values = append(values, bitsToFloat(bits))
  }
  let state = seed
  let i = 0
  while (i < 256) {
    state = kpNext(state)
    let bits = state
    if ((bits & 0x7ff0000000000000) == 0x7ff0000000000000) {
      bits = bits ^ 0x0010000000000000
    }
    values = append(values, bitsToFloat(bits))
    i = i + 1
  }
  return values
}

// Numeric equality merges the zeros; the codec's contract places -0 before +0.
fn kpFloatLess(a: f64, b: f64): bool {
  if (a != b) {
    return a < b
  }
  if (a == 0.0) {
    return floatBits(a) > floatBits(b)
  }
  return false
}

fn kpFloatPair(a: f64, b: f64, context: string) {
  let x = string(encodeFloat(a))
  let y = string(encodeFloat(b))
  assert(kpFloatLess(a, b) == (x < y), "float byte order ${context}")
  assert(floatBits(a) == floatBits(b) == (x == y), "float equality ${context}")
}

fn kpCheckFloats(seed: u64) {
  let values = kpFloats(seed)
  let i = 0
  while (i < len(values)) {
    let v = values[i]
    assert(
      floatBits(decodeFloat(encodeFloat(v))) == floatBits(v),
      "float round-trip seed=${seed} sample=${i} bits=${floatBits(v)}",
    )
    i = i + 1
  }
  sortInPlace(values, (a: f64, b: f64) => kpFloatLess(a, b))
  i = 1
  while (i < len(values)) {
    kpFloatPair(values[i - 1], values[i], "seed=${seed} adjacent=${i}")
    i = i + 1
  }
  let state = seed
  i = 0
  while (i < 1024) {
    state = kpNext(state)
    let a = int(state % u64(len(values)))
    state = kpNext(state)
    let b = int(state % u64(len(values)))
    kpFloatPair(values[a], values[b], "seed=${seed} pair=${i}")
    i = i + 1
  }
}

fn kpStrings(seed: u64): []string {
  let values = stringBoundaries()
  for s of ["\xff", "\x00\xff", "\xff\x00", "\x00\xff\x00"] {
    values = append(values, s)
  }
  let state = seed
  let i = 0
  while (i < 128) {
    state = kpNext(state)
    let size = 2 + int(state % 32)
    let raw = []byte(size)
    // These two positions cover all 256 byte values in each seed's corpus.
    raw[0] = byte(i)
    raw[1] = byte(i + 128)
    let j = 2
    while (j < size) {
      state = kpNext(state)
      raw[j] = byte(state & 0xff)
      j = j + 1
    }
    values = append(values, string(raw))
    i = i + 1
  }
  return values
}

fn kpStringPair(a: string, b: string, context: string) {
  let x = string(encodeString(a))
  let y = string(encodeString(b))
  assert(a < b == (x < y), "string byte order ${context}")
  assert(a == b == (x == y), "string equality ${context}")
}

fn kpCheckStrings(seed: u64) {
  let values = kpStrings(seed)
  checkStringOrder(values)
  sortInPlace(values, (a: string, b: string) => a < b)
  let i = 1
  while (i < len(values)) {
    kpStringPair(values[i - 1], values[i], "seed=${seed} adjacent=${i}")
    i = i + 1
  }
  let state = seed
  i = 0
  while (i < 1024) {
    state = kpNext(state)
    let a = int(state % u64(len(values)))
    state = kpNext(state)
    let b = int(state % u64(len(values)))
    kpStringPair(values[a], values[b], "seed=${seed} pair=${i}")
    i = i + 1
  }
}

test "seeded integer key codec round-trips and agrees with numeric order" {
  for seed of kpSeeds() {
    kpCheckInts(seed)
  }
}

test "seeded float key codec preserves bits and signed-zero total order" {
  for seed of kpSeeds() {
    kpCheckFloats(seed)
  }
}

test "seeded string key codec round-trips and agrees with byte order" {
  for seed of kpSeeds() {
    kpCheckStrings(seed)
  }
}
