// The explicit adapter keeps Authz.check(row) and Guard.check() distinct.
import { Actor, GuardOp, GuardFilter, ServerDialect } from "orm"

fn guardAction(op: GuardOp): string {
  return match (op) {
    Read => "Read"
    Create => "Create"
    Update => "Update"
    Delete => "Delete"
  }
}

fn guardSubject(actor: Actor): Option<Subject>! {
  if (actor == nil) {
    fail InvalidPolicy{ detail = "ORM guard requires an actor" }
  }
  let (subject, ok) = actor.(Subject)
  if (ok && subject.id != "") {
    return Option<Subject>.Some(subject)
  }
  if (!ok && actor.id == "") {
    return Option<Subject>.None
  }
  fail InvalidPolicy{ detail = "ORM guard actor must be a Subject with a nonempty id" }
}

fn guardResource(resources: []ResourceInfo, table: string): ResourceInfo! {
  let found = Option<ResourceInfo>.None
  for r of resources {
    if (r.table != table) {
      continue
    }
    if (isSome(found)) {
      fail InvalidPolicy{ detail = "ORM guard table has multiple registered resources" }
    }
    found = Option<ResourceInfo>.Some(r)
  }
  match (found) {
    Some(r) => return r
    None => {}
  }
  fail InvalidPolicy{ detail = "ORM guard table is not registered" }
}

fn guardRow(info: ResourceInfo, columns: []string, values: []Value): ()! {
  let names = rowNames(info.columns, values)?
  if (len(names) != len(columns)) {
    fail InvalidPolicy{ detail = "ORM guard row columns do not match the resource" }
  }
  let i = 0
  while (i < len(names)) {
    if (names[i] != columns[i]) {
      fail InvalidPolicy{ detail = "ORM guard row columns do not match the resource" }
    }
    i = i + 1
  }
}

// Wrap a tenant-specific Authz view when the database is tenant-specific.
// Matching Custom and Related rules fail closed, including writes.
export class OrmGuard<A: ActionEnum> {
  authz: Authz<A>

  init(authz: Authz<A>)! {
    if (authz == nil) {
      fail InvalidPolicy{ detail = "ORM guard requires Authz" }
    }
    this.authz = authz
    this.check()?
  }

  export protects(table: string): bool {
    for r of this.authz.registered().resources {
      if (r.table == table) {
        return true
      }
    }
    return false
  }

  export check(): ()! {
    if (this.authz.storeSync.isDown()) {
      fail StoreUnavailable{}
    }
    let resources = this.authz.registered().resources
    if (len(resources) == 0) {
      return
    }
    let _ = parseAction<A>("Read")?
    let _ = parseAction<A>("Create")?
    let _ = parseAction<A>("Update")?
    let _ = parseAction<A>("Delete")?
    for r of resources {
      let _ = guardResource(resources, r.table)?
    }
  }

  export filter(
    actor: Actor,
    op: GuardOp,
    table: string,
    dialect: ServerDialect,
    firstParam: int,
  ): GuardFilter! {
    let info = guardResource(this.authz.registered().resources, table)?
    let action = parseAction<A>(guardAction(op))?
    let user = guardSubject(actor)?
    match (filterNamed<A>(this.authz, user, info.name, action, true)?) {
      All => return GuardFilter.All
      None => return GuardFilter.None
      Where(c) => {
        let f = compileSql(c, info, dialect, firstParam, true)?
        return GuardFilter.Sql(f.sql, f.args)
      }
    }
  }

  export allows(
    actor: Actor,
    op: GuardOp,
    table: string,
    columns: []string,
    values: []Value,
  ): bool! {
    let info = guardResource(this.authz.registered().resources, table)?
    guardRow(info, columns, values)?
    let action = parseAction<A>(guardAction(op))?
    let user = guardSubject(actor)?
    return match (filterNamed<A>(this.authz, user, info.name, action, true)?) {
      All => true
      None => false
      Where(c) => isTrueTruth(evalRow(c, columns, values, nil, Option<RelAsker>.None)?)
    }
  }

  export denied(actor: Actor, op: GuardOp, table: string): error {
    // Guard's denial port carries no row from which to recover a policy name.
    return Denied{ policy = "", action = guardAction(op), resource = table }
  }

  export notFound(table: string): error {
    return NotFound{}
  }
}
