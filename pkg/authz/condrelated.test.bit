// pkg/authz/condrelated.test.bit — `related("editor")`: the sketch's editShared
// rule on six cases, the conditions `fromWhere` refuses at build, and what a
// relationship store that stops answering does to a decision.

import { Op } from "std/where"
import { contains } from "std/strings"
import { Logger, TextHandler, LevelWarn } from "std/log"
import { FieldDesc, AttrDesc } from "std/sql"

@table class RdFolder {
  @id
  id: i64
  name: string
}

// The row has the foreign key column but no relation field: a class with a
// `@belongsTo` field does not compile beside pkg/authz's `Subject` (E0300 on
// the synthesized members, filed on #7014), so the resolution of the relation
// field is tested on hand-built columns (`rdColumns`) instead.
@table class RdArticle {
  @id
  id: i64
  title: string
  folderId: Option<i64>
}

class RdUser {
  export id: string,
  export roles: []string,
}

// A store that answers nothing: every call fails as an unreachable server does.
class RdDown {
  export write(t: Tuple): ()! {
    fail StoreUnavailable{}
  }

  export delete(t: Tuple): ()! {
    fail StoreUnavailable{}
  }

  export has(t: Tuple): bool! {
    fail StoreUnavailable{}
  }

  export direct(object: string, relation: string, offset: int, limit: int): []string! {
    fail StoreUnavailable{}
  }

  export list(subject: string): []Tuple! {
    fail StoreUnavailable{}
  }

  export version(): i64! {
    fail StoreUnavailable{}
  }
}

class RdLines {
  lines: []string
  export write(s: string): ()! {
    this.lines = append(this.lines, s)
  }
}

fn rdWhere<T: Tabled>(field: string, relation: string): Where<T> {
  let c = Clause(field, Op.Eq, [related(relation)]) catch e {
    panic("Clause: ${e.message()}")
  }
  return Where<T>(clauses = [c])
}

fn rdCond<T: Tabled>(field: string, relation: string): Cond {
  return fromWhere<T>(rdWhere<T>(field, relation)) catch e {
    panic("fromWhere: ${e.message()}")
  }
}

// What `{ folder: related("editor") }` resolves to on `RdArticle`.
fn rdViaFolder(relation: string): Cond {
  return Cond.Related("folderId", "RdFolder", relation)
}

// The sketch's `p.can(Update, Article, { folder: related("editor") })`.
fn rdEditShared(): Policy<RdUser, Action> {
  return Policy("EditShared", (p, user) => {
    p.can<RdArticle>([Action.Update], rdViaFolder("editor"))
  })
}

// `{ id: related("editor") }` on the folder itself.
fn rdEditFolder(): Policy<RdUser, Action> {
  return Policy("EditFolder", (p, user) => {
    p.can<RdFolder>([Action.Update], rdCond<RdFolder>("id", "editor"))
  })
}

fn rdBoot(withGuest: bool): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<RdArticle>() catch e {
    panic(e.message())
  }
  let _ = a.resource<RdFolder>() catch e {
    panic(e.message())
  }
  let _ = a.relation<RdFolder>("parent") catch e {
    panic(e.message())
  }
  let _ = a.relation<RdFolder>("editor", inherit = "parent") catch e {
    panic(e.message())
  }
  let _ = a.role<RdUser>("member", [rdEditShared(), rdEditFolder()]) catch e {
    panic("member: ${e.message()}")
  }
  if (withGuest) {
    let _ = a.role<RdUser>("guest", [rdEditShared()]) catch e {
      panic("guest: ${e.message()}")
    }
  }
  return a
}

fn rdPut(a: Authz<Action>, s: string, r: string, o: string) {
  a.relate(s, r, o) catch e {
    panic(e.message())
  }
}

fn rdUser(id: string): Option<Subject> {
  return Option<Subject>.Some(RdUser{ id = id, roles = ["member"] })
}

fn rdArticle(folder: Option<i64>): RdArticle {
  return RdArticle{ id = 7, title = "t", folderId = folder }
}

fn rdIn(folder: int): RdArticle {
  return rdArticle(Option<i64>.Some(i64(folder)))
}

test "editShared: related, not related, null folderId, guest, id-self, two hops, 6 of 6" {
  let a = rdBoot(true)
  rdPut(a, "user:sara", "editor", "rdFolder:1")
  rdPut(a, "rdFolder:2", "parent", "rdFolder:3")
  rdPut(a, "rdFolder:1", "parent", "rdFolder:2")
  let sara = rdUser("sara")
  // 1: related
  assert(a.can<RdArticle>(sara, Action.Update, rdIn(1)), "1 sara edits an article of her folder")
  // 2: not related
  assert(!a.can<RdArticle>(rdUser("tom"), Action.Update, rdIn(1)), "2 tom is no editor")
  assert(!a.can<RdArticle>(sara, Action.Update, rdIn(9)), "2 sara is no editor of folder 9")
  // 3: null folderId
  assert(!a.can<RdArticle>(sara, Action.Update, rdArticle(Option<i64>.None)), "3 no folder")
  // 4: guest
  assert(!a.can<RdArticle>(Option<Subject>.None, Action.Update, rdIn(1)), "4 a guest never relates")
  // 5: the row itself
  let folder = RdFolder{ id = 1, name = "launch" }
  assert(a.can<RdFolder>(sara, Action.Update, folder), "5 sara edits folder 1")
  assert(!a.can<RdFolder>(rdUser("tom"), Action.Update, folder), "5 tom does not")
  // 6: folder 3 inherits from 2, which inherits from 1
  assert(a.can<RdArticle>(sara, Action.Update, rdIn(3)), "6 two hops up")
  assert(a.can<RdFolder>(sara, Action.Update, RdFolder{ id = 3, name = "" }), "6 folder 3")
}

test "a related rule decides nothing for an action it does not name" {
  let a = rdBoot(false)
  rdPut(a, "user:sara", "editor", "rdFolder:1")
  assert(!a.can<RdArticle>(rdUser("sara"), Action.Delete, rdIn(1)), "Delete is not granted")
}

test "check reports a refusal as Denied and a relation grant as ok" {
  let a = rdBoot(false)
  rdPut(a, "user:sara", "editor", "rdFolder:1")
  a.check<RdArticle>(rdUser("sara"), Action.Update, rdIn(1)) catch e {
    assert(false, "sara refused: ${e.message()}")
  }
  let denied = false
  a.check<RdArticle>(rdUser("tom"), Action.Update, rdIn(1)) catch e {
    let (_, ok) = e.(Denied)
    denied = ok
  }
  assert(denied, "tom gets Denied")
}

test "an unrelated user is related once the tuple is written, and not after it is removed" {
  let a = rdBoot(false)
  let tom = rdUser("tom")
  assert(!a.can<RdArticle>(tom, Action.Update, rdIn(1)), "before")
  rdPut(a, "user:tom", "editor", "rdFolder:1")
  assert(a.can<RdArticle>(tom, Action.Update, rdIn(1)), "after relate")
  a.unrelate("user:tom", "editor", "rdFolder:1") catch e {
    panic(e.message())
  }
  assert(!a.can<RdArticle>(tom, Action.Update, rdIn(1)), "after unrelate")
}

test "a user id no tuple can name is not related, never an error" {
  let a = rdBoot(false)
  rdPut(a, "user:sara", "editor", "rdFolder:1")
  let odd = Option<Subject>.Some(RdUser{ id = "sa:ra", roles = ["member"] })
  assert(!a.can<RdArticle>(odd, Action.Update, rdIn(1)), "an id with a colon")
  a.check<RdArticle>(odd, Action.Update, rdIn(1)) catch e {
    let (_, denied) = e.(Denied)
    assert(denied, "Denied, not ${e.message()}")
    return
  }
  assert(false, "check must refuse")
}

fn rdAttr(name: string, args: []string): AttrDesc {
  return AttrDesc{ name = name, args = args }
}

// The columns the compiler records for an article with a `@belongsTo("folderId")
// folder: Option<RdFolder>` relation field (SPEC 10.5, `T.__columns()`).
fn rdColumns(belongs: []string, ids: int): []FieldDesc {
  let cols = [
    FieldDesc{ name = "id", typeName = "i64", attrs = [rdAttr("id", []string(0))] },
    FieldDesc{ name = "title", typeName = "string", attrs = []AttrDesc(0) },
    FieldDesc{ name = "folderId", typeName = "Option<i64>", attrs = []AttrDesc(0) },
    FieldDesc{
      name = "folder",
      typeName = "Option<RdFolder>",
      attrs = [rdAttr("belongsTo", belongs)],
    },
  ]
  if (ids == 2) {
    cols = append(
      cols,
      FieldDesc{ name = "tenant", typeName = "i64", attrs = [rdAttr("id", []string(0))] },
    )
  }
  return cols
}

fn rdClause(field: string, op: Op, vs: []Value): Clause {
  return Clause(field, op, vs) catch e {
    panic("Clause: ${e.message()}")
  }
}

// The condition `clauseCond` makes of `{ field: related("editor") }`, or the
// message of the InvalidPolicy that refused it.
fn rdResolved(cols: []FieldDesc, field: string): string {
  let c = clauseCond(cols, "RdArticle", rdClause(field, Op.Eq, [related("editor")])) catch e {
    let (_, bad) = e.(InvalidPolicy)
    assert(bad, "not an InvalidPolicy: ${e.message()}")
    return e.message()
  }
  return cnShape(c)
}

test "fromWhere refuses a plain field and a composite @belongsTo at build, 2 of 2" {
  let plain = rdResolved(rdColumns(["folderId"], 1), "title")
  assert(contains(plain, "title") && contains(plain, "neither"), "plain scalar: ${plain}")
  let composite = rdResolved(rdColumns(["folderId", "tenant"], 1), "folder")
  assert(
    contains(composite, "folder") && contains(composite, "2 columns"),
    "composite: ${composite}",
  )
  let key = rdResolved(rdColumns(["folderId"], 2), "id")
  assert(contains(key, "2 @id"), "composite key: ${key}")
}

test "fromWhere resolves the relation field, its foreign key and the id" {
  let cols = rdColumns(["folderId"], 1)
  let viaField = rdResolved(cols, "folder")
  assert(viaField == "Related(folderId,RdFolder,editor)", "field: ${viaField}")
  let viaColumn = rdResolved(cols, "folderId")
  assert(viaColumn == "Related(folderId,RdFolder,editor)", "column: ${viaColumn}")
  let viaId = rdResolved(cols, "id")
  assert(viaId == "Related(id,RdArticle,editor)", "id: ${viaId}")
  let named = cnShape(rdCond<RdFolder>("id", "viewer"))
  assert(named == "Related(id,RdFolder,viewer)", "fromWhere on a real class: ${named}")
}

test "fromWhere refuses a marker under a list or an operator, and a missing field" {
  let cols = rdColumns(["folderId"], 1)
  let m = related("editor")
  let inList = rdClause("folder", Op.In, [m, Value.Int(1)])
  let ne = rdClause("folder", Op.Ne, [m])
  for c of [inList, ne, rdClause("nope", Op.Eq, [m])] {
    let failed = false
    clauseCond(cols, "RdArticle", c) catch _ {
      failed = true
    }
    assert(failed, "${c.field} ${len(c.values)} must be refused")
  }
  let plainValue = clauseCond(cols, "RdArticle", rdClause("folderId", Op.Eq, [Value.Int(4)])) catch e {
    panic(e.message())
  }
  assert(cnShape(plainValue) == "Cmp(folderId,eq,1)", "an ordinary value is no marker")
}

test "validate refuses an unregistered target and an undeclared relation" {
  let a = rdBoot(false)
  let ok = rdViaFolder("editor")
  a.validate(resourceRef<RdArticle>(), ok) catch e {
    assert(false, "valid: ${e.message()}")
  }
  let undeclared = rdViaFolder("viewer")
  let why = ""
  a.validate(resourceRef<RdArticle>(), undeclared) catch e {
    why = e.message()
  }
  assert(contains(why, "relation is not declared on rdFolder"), "undeclared: ${why}")
  let lone = Authz<Action>() catch e {
    panic(e.message())
  }
  let _ = lone.resource<RdArticle>() catch e {
    panic(e.message())
  }
  let why2 = ""
  lone.validate(resourceRef<RdArticle>(), ok) catch e {
    why2 = e.message()
  }
  assert(contains(why2, "RdFolder is not a registered resource"), "unregistered: ${why2}")
  let onAll = ""
  a.validate(all, ok) catch e {
    onAll = e.message()
  }
  assert(contains(onAll, "all cannot name a field"), "on all: ${onAll}")
}

test "a policy that relates to an undeclared relation is refused when the role is built" {
  let a = Authz<Action>() catch e {
    panic(e.message())
  }
  let _ = a.resource<RdArticle>() catch e {
    panic(e.message())
  }
  let _ = a.resource<RdFolder>() catch e {
    panic(e.message())
  }
  let failed = false
  a.role<RdUser>("member", [rdEditShared()]) catch e {
    failed = contains(e.message(), "policy EditShared rule 0")
  }
  assert(failed, "role() must name the policy and the rule")
}

test "evalCond has no relationship store and refuses a Related, compileSql has no SQL for it" {
  let c = rdViaFolder("editor")
  let refused = false
  evalCond<RdArticle>(c, rdIn(1)) catch e {
    refused = contains(e.message(), "needs a relationship store")
  }
  assert(refused, "evalCond")
  let info = describe<RdArticle>()
  let listed = false
  compileSql(c, info, ServerDialect.Postgres, 1) catch e {
    listed = contains(e.message(), "cannot filter a list")
  }
  assert(listed, "compileSql")
}

test "a store that is down: can is false and check fails with StoreUnavailable" {
  let a = rdBoot(false)
  a.relations = RdDown{}
  let sara = rdUser("sara")
  assert(!a.can<RdArticle>(sara, Action.Update, rdIn(1)), "can fails closed")
  let down = false
  a.check<RdArticle>(sara, Action.Update, rdIn(1)) catch e {
    let (_, ok) = e.(StoreUnavailable)
    down = ok
  }
  assert(down, "check reports StoreUnavailable")
}

fn rdDeepBoot(): Authz<Action> {
  let a = Authz<Action>(maxDepth = 1) catch e {
    panic(e.message())
  }
  let _ = a.resource<RdArticle>() catch e {
    panic(e.message())
  }
  let _ = a.resource<RdFolder>() catch e {
    panic(e.message())
  }
  let _ = a.relation<RdFolder>("parent") catch e {
    panic(e.message())
  }
  let _ = a.relation<RdFolder>("editor", inherit = "parent") catch e {
    panic(e.message())
  }
  rdPut(a, "rdFolder:2", "parent", "rdFolder:3")
  rdPut(a, "rdFolder:1", "parent", "rdFolder:2")
  return a
}

test "a bound reached: an allow rule does not match and is logged, a deny rule refuses" {
  let a = rdDeepBoot()
  let sink = RdLines{ lines = []string(0) }
  let _ = a.logTo(Logger(TextHandler(sink, LevelWarn, false)))
  let allow = Policy<RdUser, Action>("Allow", (p, user) => {
    p.can<RdArticle>([Action.Read], Cond.True)
    p.can<RdArticle>([Action.Update], rdViaFolder("editor"))
  })
  let deny = Policy<RdUser, Action>("Deny", (p, user) => {
    p.cannot<RdArticle>([Action.Read], rdViaFolder("editor"))
  })
  let _ = a.role<RdUser>("member", [allow, deny]) catch e {
    panic(e.message())
  }
  rdPut(a, "user:sara", "editor", "rdFolder:1")
  let sara = rdUser("sara")
  assert(!a.can<RdArticle>(sara, Action.Update, rdIn(3)), "allow rule skipped at maxDepth")
  assert(
    len(sink.lines) == 1 && contains(sink.lines[0], "relationship undecided"),
    "logged: ${len(sink.lines)}",
  )
  assert(contains(sink.lines[0], "maxDepth"), "names the bound")
  assert(
    !a.can<RdArticle>(sara, Action.Read, rdIn(3)),
    "the deny rule refuses when it cannot decide",
  )
  assert(!a.can<RdArticle>(sara, Action.Read, rdIn(2)), "a decided deny refuses")
  assert(
    a.can<RdArticle>(rdUser("tom"), Action.Read, rdIn(2)),
    "a decided no-match leaves the allow",
  )
}
