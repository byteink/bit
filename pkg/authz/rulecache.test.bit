// pkg/authz/rulecache.test.bit — a subject's rules are kept per subject VALUE:
// a later registration reaches the next check, a changed attribute (new
// object or the same one mutated in place) gets new rules, and a class
// without value semantics is resolved on every call.

import { WaitGroup } from "std/sync"
import { contains } from "std/strings"

@table class RcDoc {
  @id
  id: i64
  team: string
}

class RcUser {
  export id: string,
  export roles: []string,
  export team: string,
}

// A function field gives the class no value members (E0313 if called).
class RcOpaque {
  export id: string,
  export roles: []string,
  export team: string,
  hook: () => int,
}

fn rcTeamRead(): Policy<RcUser, Action> {
  return Policy("TeamRead", (p, user) => {
    p.can<RcDoc>([Action.Read], eq("team", Value.Text(user.team)))
  })
}

fn rcOpaqueRead(): Policy<RcOpaque, Action> {
  return Policy("OpaqueRead", (p, user) => {
    p.can<RcDoc>([Action.Read], eq("team", Value.Text(user.team)))
  })
}

fn rcDeleteAll(): Policy<RcUser, Action> {
  return Policy("DeleteAll", (p, user) => {
    p.canAll([Action.Delete])
  })
}

fn rcAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<RcDoc>() catch e {
    panic("resource: ${e.message()}")
  }
  let _ = a.role<RcUser>("member", [rcTeamRead()]) catch e {
    panic("member: ${e.message()}")
  }
  return a
}

fn rcUser(team: string, roles: []string): RcUser {
  return RcUser{ id = "sara", roles = roles, team = team }
}

fn rcDoc(team: string): RcDoc {
  return RcDoc{ id = 1, team = team }
}

test "a role registered after the first check takes effect on the next" {
  let a = rcAuthz()
  let u = Option<Subject>.Some(rcUser("news", ["member", "cleaner"]))
  assert(!a.can<RcDoc>(u, Action.Delete, rcDoc("news")), "no cleaner role yet")
  let _ = a.role<RcUser>("cleaner", [rcDeleteAll()]) catch e {
    panic("cleaner: ${e.message()}")
  }
  assert(a.can<RcDoc>(u, Action.Delete, rcDoc("news")), "cleaner registered later")
  assert(a.can<RcDoc>(u, Action.Read, rcDoc("news")), "member still reads")
}

test "a subject whose team changes gets the new team's rules" {
  let a = rcAuthz()
  let news = Option<Subject>.Some(rcUser("news", ["member"]))
  assert(a.can<RcDoc>(news, Action.Read, rcDoc("news")), "news reads news")
  assert(!a.can<RcDoc>(news, Action.Read, rcDoc("sports")), "news reads sports")
  let moved = Option<Subject>.Some(rcUser("sports", ["member"]))
  assert(!a.can<RcDoc>(moved, Action.Read, rcDoc("news")), "moved keeps news")
  assert(a.can<RcDoc>(moved, Action.Read, rcDoc("sports")), "moved reads sports")
  assert(a.can<RcDoc>(news, Action.Read, rcDoc("news")), "a news subject still reads news")
}

test "the same object mutated in place is a new key" {
  let a = rcAuthz()
  let u = rcUser("news", ["member"])
  let s = Option<Subject>.Some(u)
  assert(a.can<RcDoc>(s, Action.Read, rcDoc("news")), "before")
  u.team = "sports"
  assert(!a.can<RcDoc>(s, Action.Read, rcDoc("news")), "mutated keeps news")
  assert(a.can<RcDoc>(s, Action.Read, rcDoc("sports")), "mutated reads sports")
  u.roles[0] = "nobody"
  assert(!a.can<RcDoc>(s, Action.Read, rcDoc("sports")), "role slice mutated in place")
}

test "a subject class without value semantics is resolved on every call" {
  let a = rcAuthz()
  let _ = a.role<RcOpaque>("opaque", [rcOpaqueRead()]) catch e {
    panic("opaque: ${e.message()}")
  }
  let u = RcOpaque{ id = "ana", roles = ["opaque"], team = "news", hook = () => 1 }
  let s = Option<Subject>.Some(u)
  assert(!a.state.cache.kindOf(u).owns(u), "an opaque class is a key")
  assert(a.can<RcDoc>(s, Action.Read, rcDoc("news")), "opaque reads news")
  u.team = "sports"
  assert(!a.can<RcDoc>(s, Action.Read, rcDoc("news")), "opaque keeps news")
  assert(a.can<RcDoc>(s, Action.Read, rcDoc("sports")), "opaque reads sports")
}

test "two subjects of the same value share one entry" {
  let a = rcAuthz()
  let first = rcUser("news", ["member"])
  let _ = a.can<RcDoc>(Option<Subject>.Some(first), Action.Read, rcDoc("news"))
  let set1 = ruleSetOf<Action>(a, Option<Subject>.Some(rcUser("news", ["member"])))
  let set2 = ruleSetOf<Action>(a, Option<Subject>.Some(rcUser("news", ["member"])))
  assert(set1.version >= 0 && set1.hash == set2.hash, "not cached")
  assert(
    len(set1.slots) == 1 && len(set2.slots) == 1,
    "slots ${len(set1.slots)} ${len(set2.slots)}",
  )
}

fn rcReader(a: Authz<Action>, wrong: chan<int>, wg: WaitGroup) {
  defer wg.done()
  let news = Option<Subject>.Some(rcUser("news", ["member", "late"]))
  let sports = Option<Subject>.Some(rcUser("sports", ["member"]))
  let bad = 0
  let deleted = false
  let i = 0
  while (i < 300) {
    if (!a.can<RcDoc>(news, Action.Read, rcDoc("news"))) {
      bad = bad + 1
    }
    if (a.can<RcDoc>(sports, Action.Read, rcDoc("news"))) {
      bad = bad + 1
    }
    let del = a.can<RcDoc>(news, Action.Delete, rcDoc("news"))
    if (deleted && !del) {
      bad = bad + 1
    }
    deleted = deleted || del
    i = i + 1
  }
  wrong <- bad
}

test "8 readers share subjects while roles register: no torn or stale answer" {
  let a = rcAuthz()
  let wrong = chan<int>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn rcReader(a, wrong, wg)
    i = i + 1
  }
  let _ = a.role<RcUser>("late", [rcDeleteAll()]) catch e {
    panic("late: ${e.message()}")
  }
  wg.wait()
  let bad = 0
  let n = 0
  while (n < 8) {
    bad = bad + <- wrong
    n = n + 1
  }
  assert(bad == 0, "${bad} wrong answers")
  let news = Option<Subject>.Some(rcUser("news", ["member", "late"]))
  assert(a.can<RcDoc>(news, Action.Delete, rcDoc("news")), "late role reached")
}

// Every check is a miss (a new subject value each time), so each one reads
// the role list while the main task republishes it 200 times.
fn rcChurnReader(a: Authz<Action>, wrong: chan<int>, wg: WaitGroup) {
  defer wg.done()
  let bad = 0
  let deleted = false
  let i = 0
  while (i < 400) {
    let u = Option<Subject>.Some(RcUser{ id = "u${i}", roles = ["member", "c199"], team = "news" })
    if (!a.can<RcDoc>(u, Action.Read, rcDoc("news"))) {
      bad = bad + 1
    }
    let del = a.can<RcDoc>(u, Action.Delete, rcDoc("news"))
    if (deleted && !del) {
      bad = bad + 1
    }
    deleted = deleted || del
    i = i + 1
  }
  wrong <- bad
}

test "8 missing readers while 200 roles register: every list read is whole" {
  let a = rcAuthz()
  let wrong = chan<int>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn rcChurnReader(a, wrong, wg)
    i = i + 1
  }
  let r = 0
  while (r < 200) {
    let _ = a.role<RcUser>("c${r}", [rcDeleteAll()]) catch e {
      panic("c${r}: ${e.message()}")
    }
    r = r + 1
  }
  wg.wait()
  let bad = 0
  let n = 0
  while (n < 8) {
    bad = bad + <- wrong
    n = n + 1
  }
  assert(bad == 0, "${bad} wrong answers")
  assert(len(a.roleNames()) == 201, "${len(a.roleNames())} roles")
}

// True when `a` accepts relation `name` on an RcDoc, i.e. it is declared.
fn rcDeclared(a: Authz<Action>, name: string): bool {
  let _ = a.related("user:sara", name, "rcDoc:1") catch _ {
    return false
  }
  return true
}

// "base" is declared before the readers start, so a read of it must never
// fail; once a reader has seen "r100" it must keep seeing it.
fn rcRelReader(a: Authz<Action>, wrong: chan<int>, wg: WaitGroup) {
  defer wg.done()
  let bad = 0
  let seen = false
  let i = 0
  while (i < 400) {
    if (!rcDeclared(a, "base")) {
      bad = bad + 1
    }
    let now = rcDeclared(a, "r100")
    if (seen && !now) {
      bad = bad + 1
    }
    seen = seen || now
    i = i + 1
  }
  wrong <- bad
}

test "8 readers while 200 relations are declared: every declaration list is whole" {
  let a = rcAuthz()
  let _ = a.relation<RcDoc>("base") catch e {
    panic("base: ${e.message()}")
  }
  let wrong = chan<int>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn rcRelReader(a, wrong, wg)
    i = i + 1
  }
  let r = 0
  while (r < 200) {
    let _ = a.relation<RcDoc>("r${r}") catch e {
      panic("r${r}: ${e.message()}")
    }
    r = r + 1
  }
  wg.wait()
  let bad = 0
  let n = 0
  while (n < 8) {
    bad = bad + <- wrong
    n = n + 1
  }
  assert(bad == 0, "${bad} wrong answers")
  assert(rcDeclared(a, "r199"), "last declaration lost")
  assert(
      (a.hasRelation("user:sara", "r199", "rcDoc:1") catch e {
        panic(e.message())
      }) ==
      false,
    "walk over the full list",
  )
}

fn rcDeclarer(a: Authz<Action>, won: chan<int>, wg: WaitGroup) {
  defer wg.done()
  let n = 0
  let i = 0
  while (i < 50) {
    let _ = a.relation<RcDoc>("same${i}") catch e {
      assert(contains(e.message(), "declared twice"), e.message())
      i = i + 1
      continue
    }
    n = n + 1
    i = i + 1
  }
  won <- n
}

test "8 racing declarations of the same relation: exactly one wins each" {
  let a = rcAuthz()
  let won = chan<int>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn rcDeclarer(a, won, wg)
    i = i + 1
  }
  wg.wait()
  let total = 0
  let n = 0
  while (n < 8) {
    total = total + <- won
    n = n + 1
  }
  assert(total == 50, "${total} wins of 50 relations")
  assert(rcDeclared(a, "same49"), "same49")
}

fn rcSinkReader(a: Authz<Action>, wrong: chan<int>, wg: WaitGroup) {
  defer wg.done()
  let bad = 0
  let u = Option<Subject>.Some(rcUser("news", ["member"]))
  let i = 0
  while (i < 400) {
    if (!a.can<RcDoc>(u, Action.Read, rcDoc("news"))) {
      bad = bad + 1
    }
    i = i + 1
  }
  wrong <- bad
}

test "8 readers while the logger is set: answers hold and the logger is reached" {
  let a = rcAuthz()
  let sink = newLogLines()
  let wrong = chan<int>(8)
  let wg = WaitGroup()
  wg.add(8)
  let i = 0
  while (i < 8) {
    spawn rcSinkReader(a, wrong, wg)
    i = i + 1
  }
  let _ = a.logTo(linesLogger(sink, LevelDebug))
  wg.wait()
  let bad = 0
  let n = 0
  while (n < 8) {
    bad = bad + <- wrong
    n = n + 1
  }
  assert(bad == 0, "${bad} wrong answers")
  let before = len(sink.lines)
  let u = Option<Subject>.Some(rcUser("news", ["member"]))
  assert(a.can<RcDoc>(u, Action.Read, rcDoc("news")), "read after logTo")
  assert(len(sink.lines) == before + 1, "sink saw ${len(sink.lines) - before} lines of 1")
}
