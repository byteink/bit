// pkg/authz/cel.test.bit — condFromCel: 14 CEL expressions that give the same
// Cond as the equivalent JSON document, more accepted forms, 12 refusals that
// name the construct and its byte, and the limits. The resource is condjson's
// JdPost (condjson.test.bit), so both front-ends read the same columns.

import { repeat } from "std/strings"

// The shape `src` reads to, or "ERR <message>" when it is refused.
fn clxRun(src: string): string {
  let c = condFromCel(jdRes(), src) catch e {
    return "ERR ${e.message()}"
  }
  return jdShape(c)
}

// `src` reads to `want`, and so does the JSON document `json` for the same rule.
fn clxIs(src: string, json: string, want: string) {
  let got = clxRun(src)
  assert(got == want, "${src}\n  got:  ${got}\n  want: ${want}")
  let twin = jdRun(json)
  assert(twin == want, "${json}\n  json: ${twin}\n  want: ${want}")
}

// `src` reads to `want`.
fn clxOnly(src: string, want: string) {
  let got = clxRun(src)
  assert(got == want, "${src}\n  got:  ${got}\n  want: ${want}")
}

fn clxRefused(src: string, why: string) {
  clxOnly(src, "ERR invalid policy: cel: ${why}")
}

test "14 of 14 expressions give the Cond of the equivalent JSON document" {
  clxIs("resource.views == 3", "{\"views\":{\"$eq\":3}}", "views eq i3")
  clxIs("resource.views != 3", "{\"views\":{\"$ne\":3}}", "views ne i3")
  clxIs(
    "resource.status in ['draft', 'live']",
    "{\"status\":{\"$in\":[\"draft\",\"live\"]}}",
    "status in t:draft,t:live",
  )
  clxIs("resource.views < 3", "{\"views\":{\"$lt\":3}}", "views lt i3")
  clxIs("resource.views <= 3", "{\"views\":{\"$lte\":3}}", "views lte i3")
  clxIs("resource.score > 1.5", "{\"score\":{\"$gt\":1.5}}", "score gt f1.5")
  clxIs(
    "resource.views >= 18 && resource.views < 65",
    "{\"views\":{\"$gte\":18,\"$lt\":65}}",
    "And(views gte i18 views lt i65)",
  )
  clxIs(
    "resource.done && resource.title == 'a'",
    "{\"$and\":[{\"done\":true},{\"title\":\"a\"}]}",
    "And(done eq btrue title eq t:a)",
  )
  clxIs(
    "resource.done || resource.title == 'a'",
    "{\"$or\":[{\"done\":true},{\"title\":\"a\"}]}",
    "Or(done eq btrue title eq t:a)",
  )
  clxIs("!resource.done", "{\"$not\":{\"done\":true}}", "Not(done eq btrue)")
  clxIs("resource.team == user.team", "{\"team\":\"$user.team\"}", "team eq user.team")
  clxIs("resource.title == '$user.team'", "{\"title\":\"$$user.team\"}", "title eq t:$user.team")
  clxIs(
    "related(resource.folder, 'editor')",
    "{\"folder\":{\"$related\":\"editor\"}}",
    "Related(folderId,JdFolder,editor)",
  )
  clxIs("true", "{}", "True")
}

test "a literal on the left is the same comparison read the other way" {
  clxOnly("3 < resource.views", "views gt i3")
  clxOnly("3 <= resource.views", "views gte i3")
  clxOnly("3 > resource.views", "views lt i3")
  clxOnly("3 >= resource.views", "views lte i3")
  clxOnly("3 == resource.views", "views eq i3")
  clxOnly("'a' != resource.title", "title ne t:a")
  clxOnly("user.team == resource.team", "team eq user.team")
  clxOnly("null == resource.tag", "tag eq NULL")
}

test "negative number literals fold; null is the NULL test on an Option column" {
  clxOnly("resource.views > -5", "views gt i-5")
  clxOnly("resource.score < -2.5", "score lt f-2.5")
  clxOnly("resource.status in ['draft', user.stage]", "status in t:draft,user.stage")
  clxOnly("resource.tag == null", "tag eq NULL")
  clxOnly("resource.tag != null", "tag ne NULL")
  clxOnly("resource.folderId != null", "folderId ne NULL")
  clxOnly("!(resource.tag == null)", "Not(tag eq NULL)")
}

test "user attributes: a scalar, and user.roles as the source of in" {
  clxOnly("resource.team == user.id", "team eq user.id")
  clxOnly("resource.team in user.roles", "team in user.roles")
  clxOnly("resource.views >= user.level", "views gte user.level")
}

test "related: a relation field, its key column, and the row itself" {
  clxOnly("related(resource.folder, 'editor')", "Related(folderId,JdFolder,editor)")
  clxOnly("related(resource.folderId, \"editor\")", "Related(folderId,JdFolder,editor)")
  clxOnly("related(resource.id, 'owner')", "Related(id,JdPost,owner)")
}

test "precedence is CEL's: || loosest, then &&, then relations, then !" {
  clxOnly(
    "resource.done || resource.views > 1 && resource.team == 'a'",
    "Or(done eq btrue And(views gt i1 team eq t:a))",
  )
  clxOnly(
    "(resource.done || resource.views > 1) && resource.team == 'a'",
    "And(Or(done eq btrue views gt i1) team eq t:a)",
  )
  clxOnly("!resource.done && resource.views > 1", "And(Not(done eq btrue) views gt i1)")
  clxOnly("!(resource.done && resource.views > 1)", "Not(And(done eq btrue views gt i1))")
  clxOnly("!!resource.done", "done eq btrue")
  clxOnly(
    "resource.done && resource.views > 1 && resource.team == 'a'",
    "And(done eq btrue views gt i1 team eq t:a)",
  )
}

test "constants fold as the constructors do; comments, trailing commas and escapes read" {
  clxOnly("false", "False")
  clxOnly("true && resource.done", "done eq btrue")
  clxOnly("false || resource.done", "done eq btrue")
  clxOnly("(((resource.done)))", "done eq btrue")
  clxOnly("resource.done // published\n&& resource.views > 1", "And(done eq btrue views gt i1)")
  clxOnly("resource.status in ['draft', 'live',]", "status in t:draft,t:live")
  clxOnly("resource.title == 'it\\'s \\u00e9'", "title eq t:it's é")
  clxOnly("resource.views == 2.5", "views eq f2.5")
  clxOnly("resource.score == 2", "score eq i2")
}

test "12 of 12 refusals name the construct and the byte" {
  clxRefused(
    "size(resource.title) > 3",
    "function call size(...) is not supported; only related(resource.<field>, \"<relation>\") is at byte 0",
  )
  clxRefused(
    "resource.title.matches('a.*')",
    "method call .matches(...) is not supported; it has no SQL filter form at byte 15",
  )
  clxRefused(
    "resource.views + 1 > 3",
    "arithmetic '+' is not supported; compare a field with a value at byte 15",
  )
  clxRefused(
    "resource.done ? true : false",
    "the conditional ?: is not supported (it has no SQL filter form); combine the branches with && and || at byte 14",
  )
  clxRefused(
    "resource.views == resource.score",
    "comparing resource.views with resource.score has no SQL filter form; compare a field with a value at byte 0",
  )
  clxRefused("resource.status in {'a': 1}", "a map or message literal is not supported at byte 19")
  clxRefused("resource", "'resource' cannot be used bare; write resource.<name> at byte 0")
  clxRefused("resource.views == 'many'", "field views is i64, the value is text at byte 18")
  clxRefused(
    repeat("(", 33) + "resource.done" + repeat(")", 33),
    "expression nested deeper than 32 levels at byte 33",
  )
  clxRefused(
    "resource.titel == 'x'",
    "JdPost has no field \"titel\" (closest: \"title\") at byte 0",
  )
  clxRefused("resource.done > false", "field done is bool, which cannot be ordered at byte 14")
  clxRefused(
    "user.id == user.team",
    "comparing user.id with user.team does not involve the resource; compare a user attribute with a resource field at byte 0",
  )
}

test "more refusals: calls, lists, literals, chains, nesting, tokens" {
  clxRefused(
    "has(resource.title)",
    "function call has(...) is not supported; only related(resource.<field>, \"<relation>\") is at byte 0",
  )
  clxRefused(
    "resource.tags.exists(t, t == 'a')",
    "method call .exists(...) is not supported; it has no SQL filter form at byte 14",
  )
  clxRefused(
    "resource.title.startsWith('a')",
    "method call .startsWith(...) is not supported; it has no SQL filter form at byte 15",
  )
  clxRefused(
    "resource.title.size()",
    "method call .size(...) is not supported; it has no SQL filter form at byte 15",
  )
  clxRefused(
    "resource.address.city == 'x'",
    "nested field access is not supported; resource fields and user attributes are flat at byte 16",
  )
  clxRefused(
    "resource.views == 1 * 2",
    "arithmetic '*' is not supported; compare a field with a value at byte 20",
  )
  clxRefused(
    "resource.views > -resource.score",
    "unary '-' only applies to a number literal; arithmetic is not supported at byte 17",
  )
  clxRefused("resource.views == [1]", "a list literal can only follow 'in' at byte 18")
  clxRefused("[1, 2]", "expected a condition, found a list at byte 0")
  clxRefused("1 == 1", "a comparison of two literals is a constant; write true or false at byte 0")
  clxRefused(
    "'a' in user.roles",
    "'in' tests a resource field: write resource.<field> in [...] at byte 0",
  )
  clxRefused(
    "resource.team in 'abc'",
    "'in' needs a list [...] or user.roles on the right, found a literal (text) at byte 17",
  )
  clxRefused("resource.status in []", "'in' needs at least one value at byte 19")
  clxRefused(
    "resource.views < resource.score < 3",
    "chained comparison is not supported; join the two comparisons with && at byte 32",
  )
  clxRefused(
    "(resource.done == true) == true",
    "a boolean expression cannot be compared; use && || ! on it, or compare the field itself (resource.<field> == true) at byte 1",
  )
  clxRefused(
    "resource.views",
    "resource.views is i64, not a bool; compare it with a value (resource.views == ...) at byte 0",
  )
  clxRefused(
    "user.admin",
    "user.admin is not a condition; compare it with a resource field (resource.<field> == user.admin) at byte 0",
  )
  clxRefused(
    "resource.done.",
    "nested field access is not supported; resource fields and user attributes are flat at byte 13",
  )
  clxRefused("user", "'user' cannot be used bare; write user.<name> at byte 0")
  clxRefused(
    "folder.id == 1",
    "unknown name 'folder'; a condition may only use resource.<field> and user.<attribute> at byte 0",
  )
  clxRefused("", "the expression is empty; write true for a condition that always holds at byte 0")
  clxRefused(
    "   // nothing",
    "the expression is empty; write true for a condition that always holds at byte 0",
  )
  clxRefused("resource.done &&", "unexpected end of expression at byte 16")
  clxRefused(
    "resource.done resource.done",
    "unexpected 'resource'; the expression ends before it at byte 14",
  )
  clxRefused(
    "(resource.done",
    "expected ')' to close the bracket at byte 0, found end of expression at byte 14",
  )
  clxRefused("resource.views == 1 )", "unexpected ')'; the expression ends before it at byte 20")
  clxRefused(
    "resource.status in ['a' 'b']",
    "expected ']' to close the bracket at byte 19, found a string literal at byte 24",
  )
  clxRefused(
    "resource.status in [resource.team]",
    "a list item must be a literal or a user attribute at byte 20",
  )
  clxRefused("resource.views == 1 # x", "unexpected character '#' at byte 20")
  clxRefused("resource.tags[0] == 1", "indexing is not supported at byte 13")
}

test "values are checked against the column, with the JSON front-end's words" {
  clxRefused("resource.title != 4", "field title is string, the value is an integer at byte 18")
  clxRefused("resource.done == 'yes'", "field done is bool, the value is text at byte 17")
  clxRefused(
    "resource.status == 'gone'",
    "field status: \"gone\" is not a variant (variants: draft, review, live) at byte 19",
  )
  clxRefused(
    "resource.status < 'live'",
    "field status is an enum, which cannot be ordered at byte 16",
  )
  clxRefused("resource.title == null", "field title is string and cannot be null at byte 18")
  clxRefused(
    "resource.tag < null",
    "field tag: comparing with null is never true (test for it with == null or != null) at byte 15",
  )
  clxRefused(
    "resource.tag in ['a', null]",
    "field tag: comparing with null is never true (test for it with == null or != null) at byte 22",
  )
  clxRefused("resource.data == 'x'", "field data is []byte, the value is text at byte 17")
  clxRefused(
    "resource.folder == 1",
    "resource.folder is not a plain column; test a relation with related(resource.folder, \"<relation>\") at byte 0",
  )
  clxRefused(
    "related(resource.title, 'editor')",
    "related() on title: title is neither a @belongsTo relation nor the @id field at byte 17",
  )
  clxRefused(
    "related(resource.nope, 'editor')",
    "JdPost has no field \"nope\" (closest: \"done\") at byte 17",
  )
  clxRefused("related(resource.folder, '')", "related() needs a relation name at byte 25")
  clxRefused(
    "related(resource.folder)",
    "related() takes (resource.<field>, \"<relation>\") at byte 23",
  )
  clxRefused(
    "related(folder, 'editor')",
    "related() takes (resource.<field>, \"<relation>\") at byte 8",
  )
  clxRefused(
    "related(resource.folder, 5)",
    "related() takes (resource.<field>, \"<relation>\") at byte 25",
  )
}

test "the nesting limit is 32: 32 parentheses read, 33 do not; ! counts too" {
  clxOnly(repeat("(", 32) + "resource.done" + repeat(")", 32), "done eq btrue")
  clxOnly(repeat("!", 32) + "resource.done", "done eq btrue")
  clxRefused(
    repeat("!", 33) + "resource.done",
    "expression nested deeper than 32 levels at byte 33",
  )
}

test "a long chain is a loop, not a recursion: 100 && terms read" {
  let src = repeat("resource.done && ", 99) + "resource.done"
  let c = condFromCel(jdRes(), src) catch e {
    panic(e.message())
  }
  match (c) {
    And(cs) => assert(len(cs) == 99 + 1, "terms: ${len(cs)}")
    _ => assert(false, "not an And: ${jdShape(c)}")
  }
}

test "the lexer's limits reach the caller as the same InvalidPolicy" {
  clxRefused("resource.done && #", "unexpected character '#' at byte 17")
  clxRefused(repeat("a", 4097), "source exceeds 4096 bytes at byte 4096")
}

test "a refusal is an InvalidPolicy carrying no JSON path" {
  let _ = condFromCel(jdRes(), "resource.titel == 1") catch e {
    assert(
      hasPrefix(e.message(), "invalid policy: cel: JdPost has no field"),
      "message: ${e.message()}",
    )
    return
  }
  assert(false, "an unknown field was accepted")
}
