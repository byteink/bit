// Canonical stored conditions; resource metadata is checked when decoding.

class CondJsonWalk {
  nodes: int,
}

fn encBad(why: string): InvalidPolicy {
  return InvalidPolicy{ detail = "condition JSON: ${why}" }
}

fn encCharge(w: CondJsonWalk, n: int): ()! {
  w.nodes = w.nodes + n
  if (w.nodes > maxJsonNodes) {
    fail encBad("more than ${maxJsonNodes} nodes")
  }
}

fn encField(field: string): ()! {
  if (field == "" || hasPrefix(field, "$")) {
    fail encBad("field '${field}' cannot be stored")
  }
}

fn encObject(key: string, value: Json): Json {
  return Json.JsonObject([JsonEntry{ key = key, value = value }])
}

fn encLiteral(v: Value): Json! {
  return match (v) {
    Int(i) => Json.JsonInt(i)
    Float(x) => encFloat(x)?
    Bool(b) => Json.JsonBool(b)
    Text(s) => Json.JsonString(encText(s))
    Null => encFail("literal NULL is not a null predicate")?
    Blob(_) => encFail("a byte literal has no stored JSON form")?
  }
}

fn encFail(why: string): Json! {
  fail encBad(why)
}

fn encFloat(x: f64): Json! {
  if (x != x || x - x != 0.0) {
    fail encBad("a non-finite float has no stored JSON form")
  }
  return Json.JsonFloat(x)
}

fn encText(s: string): string {
  if (hasPrefix(s, "$")) {
    return "$" + s
  }
  return s
}

fn encOperand(o: Operand): Json! {
  return match (o) {
    Lit(v) => encLiteral(v)?
    Param(path) => encParam(path)?
    Null => encFail("NULL is only an equality or inequality predicate")?
  }
}

fn encParam(path: string): Json! {
  if (path == "") {
    fail encBad("a user placeholder names no attribute")
  }
  return Json.JsonString("$user.${path}")
}

fn encOp(op: Op): string {
  return match (op) {
    Eq => "$eq"
    Ne => "$ne"
    In => "$in"
    Lt => "$lt"
    Lte => "$lte"
    Gt => "$gt"
    Gte => "$gte"
  }
}

fn encCmp(field: string, op: Op, os: []Operand): Json! {
  encField(field)?
  checkArity(field, op, len(os))?
  if (len(os) > maxJsonNodes) {
    fail encBad("more than ${maxJsonNodes} operands")
  }
  let value = Json.JsonNull
  if (!isNullTest(op, os)) {
    value = encValues(op, os)?
  }
  if (op != Op.Eq) {
    value = encObject(encOp(op), value)
  }
  return encObject(field, value)
}

fn encValues(op: Op, os: []Operand): Json! {
  if (op != Op.In) {
    return encOperand(os[0])?
  }
  let values = []Json(0)
  for o of os {
    values = append(values, encOperand(o)?)
  }
  return Json.JsonArray(values)
}

fn encRelated(local: string, target: string, relation: string): Json! {
  encField(local)?
  if (target == "" || relation == "") {
    fail encBad("a relationship needs its target and relation name")
  }
  return encObject(local, encObject("$related", Json.JsonString(relation)))
}

fn encChildren(w: CondJsonWalk, cs: []Cond, depth: int): []Json! {
  if (len(cs) > maxJsonNodes) {
    fail encBad("more than ${maxJsonNodes} children")
  }
  let out = []Json(0)
  for c of cs {
    out = append(out, encCond(w, c, depth + 1)?)
  }
  return out
}

fn encMerge(js: []Json): Option<Json> {
  let entries = []JsonEntry(0)
  for j of js {
    match (j) {
      JsonObject(es) => {
        for e of es {
          if (hasPrefix(e.key, "$") || hasKey(entries, e.key)) {
            return Option<Json>.None
          }
          entries = append(entries, e)
        }
      }
      _ => return Option<Json>.None
    }
  }
  let ordered = sorted(entries, (a: JsonEntry, b: JsonEntry) => a.key < b.key)
  return Option<Json>.Some(Json.JsonObject(ordered))
}

fn encAnd(w: CondJsonWalk, cs: []Cond, depth: int): Json! {
  let js = encChildren(w, cs, depth)?
  let merged = encMerge(js)
  if (isSome(merged)) {
    return unwrap(merged)
  }
  return encObject("$and", Json.JsonArray(js))
}

fn encVisit(w: CondJsonWalk, depth: int): ()! {
  if (depth > maxJsonDepth) {
    fail encBad("nested deeper than ${maxJsonDepth} levels")
  }
  encCharge(w, 1)?
}

fn encCond(w: CondJsonWalk, c: Cond, depth: int): Json! {
  encVisit(w, depth)?
  return match (c) {
    True => Json.JsonObject([]JsonEntry(0))
    False => encObject("$or", Json.JsonArray([]Json(0)))
    Cmp(field, op, os) => encCmp(field, op, os)?
    And(cs) => encAnd(w, cs, depth)?
    Or(cs) => encObject("$or", Json.JsonArray(encChildren(w, cs, depth)?))
    Not(inner) => encObject("$not", encCond(w, inner, depth + 1)?)
    Known(_) => encFail("Known is internal and cannot be stored")?
    Custom(_, _) => encFail("Custom holds code and cannot be stored")?
    Related(local, target, relation) => encRelated(local, target, relation)?
  }
}

// Charge the emitted keys and array elements exactly as the decoder does.
fn encJsonNodes(w: CondJsonWalk, j: Json): ()! {
  match (j) {
    JsonObject(es) => {
      encCharge(w, len(es))?
      for e of es {
        encJsonNodes(w, e.value)?
      }
    }
    JsonArray(js) => {
      encCharge(w, len(js))?
      for item of js {
        encJsonNodes(w, item)?
      }
    }
    _ => {}
  }
}

// The canonical JSON form of a resource-valid condition. Related's target is
// restored from that resource's metadata by condFromJson (condjson.bit).
// Code, internal Known nodes and non-JSON literals fail with InvalidPolicy.
export fn condToJson(c: Cond): Json! {
  let j = encCond(CondJsonWalk{ nodes = 0 }, c, 1)?
  encJsonNodes(CondJsonWalk{ nodes = 0 }, j)?
  return j
}
