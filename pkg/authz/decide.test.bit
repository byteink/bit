// pkg/authz/decide.test.bit — `can` and `check`: deny wins, default deny, the
// Manage wildcard, the guest, unknown conditions, invalid rules met at
// request time, placeholders and the decision log.

import { Op } from "std/where"
import { contains, join } from "std/strings"

@table class DcArticle {
  @id
  id: i64
  authorId: string
  status: string
  reviewer: Option<string>
}

@table class DcFolder {
  @id
  id: i64
  name: string
}

class DcUser {
  export id: string,
  export roles: []string,
}

class DcSink {
  lines: []string
  export log(line: string) {
    this.lines = append(this.lines, line)
  }
}

fn dcReadPublished(): Policy<DcUser, Action> {
  return Policy("ReadPublished", (p, user) => {
    p.can<DcArticle>([Action.Read], eq("status", Value.Text("published")))
  })
}

fn dcEditOwn(): Policy<DcUser, Action> {
  return Policy("EditOwn", (p, user) => {
    p.can<DcArticle>([Action.Read, Action.Update], eq("authorId", Value.Text(user.id)))
    p.cannot<DcArticle>([Action.Update], eq("status", Value.Text("archived")))
  })
}

fn peerRead(): Policy<DcUser, Action> {
  return Policy("PeerRead", (p, user) => {
    p.can<DcArticle>([Action.Read], eq("reviewer", Value.Text("sara")))
  })
}

fn dcManageAll(): Policy<DcUser, Action> {
  return Policy("ManageAll", (p, user) => {
    p.canAll([Action.Manage])
  })
}

fn dcNoDelete(): Policy<DcUser, Action> {
  return Policy("NoDelete", (p, user) => {
    p.cannotAll([Action.Delete])
  })
}

// Registers the resources and the sketch's roles; `guest` only when asked.
fn dcAuthz(withGuest: bool): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<DcArticle>() catch e {
    panic("resource: ${e.message()}")
  }
  let _ = a.resource<DcFolder>() catch e {
    panic("resource: ${e.message()}")
  }
  let _ = a.role<DcUser>("reader", [dcReadPublished()]) catch e {
    panic("reader: ${e.message()}")
  }
  let _ = a.role<DcUser>("author", [dcReadPublished(), dcEditOwn()]) catch e {
    panic("author: ${e.message()}")
  }
  let _ = a.role<DcUser>("admin", [dcManageAll()]) catch e {
    panic("admin: ${e.message()}")
  }
  let _ = a.role<DcUser>("locked", [dcNoDelete()]) catch e {
    panic("locked: ${e.message()}")
  }
  if (withGuest) {
    let _ = a.role<DcUser>("guest", [dcReadPublished()]) catch e {
      panic("guest: ${e.message()}")
    }
  }
  return a
}

fn dcUser(id: string, roles: []string): Option<Subject> {
  return Option<Subject>.Some(DcUser{ id = id, roles = roles })
}

fn dcArticle(author: string, status: string): DcArticle {
  return DcArticle{ id = 1, authorId = author, status = status, reviewer = Option<string>.None }
}

// The policy a refusal names for the log, "" when it names none or allows.
fn dcDeciding(a: Authz<Action>, u: Option<Subject>, act: Action, row: DcArticle): string {
  let who = "allowed"
  a.check<DcArticle>(u, act, row) catch e {
    let (d, ok) = e.(Denied)
    assert(ok, "not a Denied: ${e.message()}")
    who = d.deciding()
  }
  return who
}

test "decide.bit: sixteen scenarios of the sketch, 16 of 16" {
  let a = dcAuthz(false)
  let sara = dcUser("sara", ["author"])
  // 1: allow only
  assert(a.can<DcArticle>(sara, Action.Update, dcArticle("sara", "draft")), "1 own draft")
  // 2-3: a deny overrides an allow
  assert(!a.can<DcArticle>(sara, Action.Update, dcArticle("sara", "archived")), "2 archived")
  let root = dcUser("root", ["admin", "locked"])
  assert(!a.can<DcArticle>(root, Action.Delete, dcArticle("sara", "draft")), "3 locked admin")
  // 4-5: default deny
  assert(!a.can<DcArticle>(sara, Action.Update, dcArticle("tom", "draft")), "4 not own")
  assert(
    !a.can<DcArticle>(dcUser("nobody", []string(0)), Action.Read, dcArticle("sara", "published")),
    "5 no roles",
  )
  // 6-11: Manage grants all 6 actions
  let acts = [
    Action.Manage,
    Action.Read,
    Action.Create,
    Action.Update,
    Action.Delete,
    Action.Publish,
  ]
  let granted = 0
  for act of acts {
    if (a.can<DcArticle>(dcUser("ada", ["admin"]), act, dcArticle("tom", "archived"))) {
      granted = granted + 1
    }
  }
  assert(granted == 6, "6-11 manage grants ${granted} of 6")
  // 12-13: the guest
  let open = dcAuthz(true)
  assert(
    open.can<DcArticle>(Option<Subject>.None, Action.Read, dcArticle("tom", "published")),
    "12 guest role",
  )
  assert(
    !a.can<DcArticle>(Option<Subject>.None, Action.Read, dcArticle("tom", "published")),
    "13 no guest role",
  )
  // 14: unknown does not allow
  let _ = a.role<DcUser>("peer", [peerRead()]) catch e {
    panic(e.message())
  }
  assert(
    !a.can<DcArticle>(dcUser("pat", ["peer"]), Action.Read, dcArticle("tom", "draft")),
    "14 NULL",
  )
  // 15: the deciding policy is named for a deny
  assert(
    dcDeciding(a, sara, Action.Update, dcArticle("sara", "archived")) == "EditOwn",
    "15 policy",
  )
  // 16: the client text is fixed
  let msg = ""
  a.check<DcArticle>(sara, Action.Update, dcArticle("tom", "draft")) catch e {
    msg = e.message()
  }
  assert(msg == "forbidden", "16 message: ${msg}")
}

test "default deny names no policy and Manage matches only Manage when asked" {
  let a = dcAuthz(false)
  assert(
    dcDeciding(a, dcUser("sara", ["reader"]), Action.Update, dcArticle("sara", "published")) == "",
    "default deny names a policy",
  )
  let ro = dcUser("sara", ["reader"])
  assert(!a.can<DcArticle>(ro, Action.Manage, dcArticle("sara", "published")), "Read is not Manage")
}

test "the guest is evaluated: a guest rule still faces its condition" {
  let a = dcAuthz(true)
  assert(
    !a.can<DcArticle>(Option<Subject>.None, Action.Read, dcArticle("tom", "draft")),
    "guest read a draft",
  )
}

test "a rule that is wrong in another branch fails check and refuses can" {
  let a = dcAuthz(false)
  let sink = DcSink{ lines = []string(0) }
  let _ = a.logTo(sink)
  let branchy = Policy<DcUser, Action>("Branchy", (p, user) => {
    p.can<DcArticle>([Action.Read])
    if (user.id == "bad") {
      p.can<DcArticle>([])
      p.can<DcFolder>([Action.Read], eq("owner", Value.Text("x")))
    }
  })
  let _ = a.role<DcUser>("odd", [branchy]) catch e {
    panic(e.message())
  }
  let bad = dcUser("bad", ["odd"])
  let row = dcArticle("tom", "published")
  assert(!a.can<DcArticle>(bad, Action.Read, row), "can allowed through a broken rule")
  assert(!a.can<DcArticle>(bad, Action.Read, row), "second call")
  let msg = ""
  a.check<DcArticle>(bad, Action.Read, row) catch e {
    msg = e.message()
  }
  assert(msg == "invalid policy: policy Branchy rule 1: no actions", msg)
  let errors = 0
  for l of sink.lines {
    if (contains(l, "ERROR invalid policy: policy Branchy rule 1")) {
      errors = errors + 1
    }
  }
  assert(errors == 1, "ERROR lines: ${errors} of 1")
  assert(a.can<DcArticle>(dcUser("good", ["odd"]), Action.Read, row), "the other branch refused")
}

test "placeholders bind to the user; one the user cannot supply refuses" {
  let a = dcAuthz(false)
  let mine = Policy<DcUser, Action>("Mine", (p, user) => {
    p.can<DcArticle>([Action.Update], Cond.Cmp("authorId", Op.Eq, [operandOf("$user.id")]))
    p.can<DcArticle>([Action.Delete], Cond.Cmp("authorId", Op.Eq, [operandOf("$user.team")]))
  })
  let _ = a.role<DcUser>("owner", [mine]) catch e {
    panic(e.message())
  }
  let sara = dcUser("sara", ["owner"])
  assert(a.can<DcArticle>(sara, Action.Update, dcArticle("sara", "draft")), "own row refused")
  assert(!a.can<DcArticle>(sara, Action.Update, dcArticle("tom", "draft")), "other row allowed")
  assert(
    !a.can<DcArticle>(sara, Action.Delete, dcArticle("", "draft")),
    "no team attribute granted",
  )
}

test "the decision log names action, resource, subject, outcome and policy" {
  let a = dcAuthz(false)
  let sink = DcSink{ lines = []string(0) }
  let _ = a.logTo(sink)
  let _ = a.can<DcArticle>(dcUser("sara", ["author"]), Action.Update, dcArticle("sara", "archived"))
  let _ = a.can<DcArticle>(dcUser("sara", ["author"]), Action.Update, dcArticle("sara", "draft"))
  let text = join(sink.lines, "\n")
  assert(len(sink.lines) == 2, "lines: ${len(sink.lines)} of 2: ${text}")
  assert(
    contains(sink.lines[0], "deny Update on DcArticle subject=sara policy=EditOwn"),
    sink.lines[0],
  )
  assert(contains(sink.lines[1], "allow Update on DcArticle subject=sara"), sink.lines[1])
  let want = "[authz] debug deny Update on DcArticle subject=sara policy=EditOwn reason=denied by rule"
  assert(sink.lines[0] == want, sink.lines[0])
}
