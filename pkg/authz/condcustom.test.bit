// pkg/authz/condcustom.test.bit — Cond.Custom through `canIf`: a single check
// answers, a list filter refuses with NotFilterable naming policy and label.

@table class CcPost {
  @id
  id: i64
  authorId: string
  views: i64
}

class CcUser {
  export id: string,
  export roles: []string,
}

fn ccOpenWindow(): Policy<CcUser, Action> {
  return Policy("Publishing", (p, user) => {
    p.canIf<CcPost>([Action.Publish], "PublishWindowOpen", (post: CcPost) => post.views < 100)
  })
}

fn ccReadOwn(): Policy<CcUser, Action> {
  return Policy("ReadOwn", (p, user) => {
    p.can<CcPost>([Action.Read], eq("authorId", Value.Text(user.id)))
  })
}

fn ccAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<CcPost>() catch e {
    panic("resource: ${e.message()}")
  }
  let _ = a.role<CcUser>("editor", [ccOpenWindow(), ccReadOwn()]) catch e {
    panic("editor: ${e.message()}")
  }
  return a
}

fn ccUser(id: string): Option<Subject> {
  return Option<Subject>.Some(CcUser{ id = id, roles = ["editor"] })
}

fn ccPost(author: string, views: i64): CcPost {
  return CcPost{ id = 1, authorId = author, views = views }
}

test "canIf: a single check runs the function, 4 of 4 rows" {
  let a = ccAuthz()
  let sara = ccUser("sara")
  assert(a.can<CcPost>(sara, Action.Publish, ccPost("sara", 5)), "1 window open")
  assert(!a.can<CcPost>(sara, Action.Publish, ccPost("sara", 100)), "2 window closed")
  assert(a.can<CcPost>(sara, Action.Read, ccPost("sara", 500)), "3 data rule beside it")
  assert(!a.can<CcPost>(sara, Action.Update, ccPost("sara", 5)), "4 other action")
}

test "canIf: an empty label is refused at registration" {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<CcPost>() catch e {
    panic("resource: ${e.message()}")
  }
  let bad: Policy<CcUser, Action> = Policy("NoLabel", (p, user) => {
    p.canIf<CcPost>([Action.Publish], "", (post: CcPost) => true)
  })
  let why = ccRoleError(a, bad)
  assert(contains(why, "NoLabel rule 0"), "message: ${why}")
  assert(contains(why, "label"), "message: ${why}")
}

fn ccRoleError(a: Authz<Action>, p: Policy<CcUser, Action>): string {
  a.role<CcUser>("editor", [p]) catch e {
    return e.message()
  }
  return ""
}

fn ccCustom(): Cond {
  return custom<CcPost>("Window", (post: CcPost) => true)
}

fn ccFound(c: Cond): string {
  return unwrapOr(filterable(c), "none")
}

test "filterable finds a Custom at the top and under not, and, or: 4 of 4" {
  let data = eq("authorId", Value.Text("sara"))
  assert(ccFound(ccCustom()) == "Window", "top")
  assert(ccFound(Cond.Not(ccCustom())) == "Window", "under not")
  assert(ccFound(Cond.And([data, ccCustom()])) == "Window", "under and")
  assert(ccFound(Cond.Or([data, Cond.And([data, ccCustom()])])) == "Window", "under or")
}

test "filterable is None for a pure tree, 3 of 3" {
  let data = eq("authorId", Value.Text("sara"))
  assert(ccFound(data) == "none", "cmp")
  assert(ccFound(Cond.And([data, Cond.Not(gt("views", Value.Int(1)))])) == "none", "and not")
  assert(ccFound(Cond.Or([Cond.True, Cond.False])) == "none", "or")
}

test "evalCond runs the function: true then false" {
  let c = custom<CcPost>("Window", (post: CcPost) => post.views < 10)
  let t = evalCond<CcPost>(c, ccPost("sara", 3)) catch e {
    panic("eval: ${e.message()}")
  }
  assert(isTrueTruth(t), "views 3")
  let f = evalCond<CcPost>(c, ccPost("sara", 30)) catch e {
    panic("eval: ${e.message()}")
  }
  assert(!isTrueTruth(f), "views 30")
}

test "validateFilterable names the policy and the label, 1 of 1" {
  let a = ccAuthz()
  a.validateFilterable<CcPost>(Action.Read) catch e {
    panic("Read has no code function: ${e.message()}")
  }
  let failed = false
  a.validateFilterable<CcPost>(Action.Publish) catch e {
    let (nf, ok) = e.(NotFilterable)
    assert(ok, "not a NotFilterable: ${e.message()}")
    assert(nf.policy == "Publishing", "policy: ${nf.policy}")
    assert(nf.label == "PublishWindowOpen", "label: ${nf.label}")
    failed = true
  }
  assert(failed, "Publish lists through a code function")
}
