// pkg/authz/policy.bit — a policy is a named function that says what a user
// may and may not do, written the way CASL writes it:
//
//   let editOwn = Policy<User, Action>("EditOwnArticles", (p, user) => {
//     p.can<Article>([Read, Update], eq("authorId", Value.Text(user.id)))
//     p.cannot<Article>([Update], eq("status", Value.Text("archived")))
//   })
//
// The closure runs once per subject (`rulesFor`) and each `can` / `cannot`
// appends one `Rule`: an effect, a list of actions, a resource and a
// condition. A policy written in code and one stored as data are the same
// list of rules (docs/policies.md), so evaluation reads only `Rule`.
//
// The closure cannot fail, so nothing is refused while it runs: the rules it
// built are checked against the registered resources when the policy is
// registered (`Authz.validatePolicy`), at startup, and the error names the
// policy and the rule's position.

import { hasPrefix } from "std/strings"

// Whether a rule grants or refuses. A refusal wins over every grant.
export enum Effect {
  Allow,
  Deny,
}

// One statement of a policy: `effect` for every action in `actions`, on
// `resource`, when `cond` holds. `policy` is the name of the policy that
// wrote it, so a refusal can be logged against the policy that decided it.
export class Rule<A: ActionEnum> {
  export effect: Effect,
  export actions: []A,
  export resource: ResourceRef,
  export cond: Cond,
  export policy: string,
}

// The `p` a policy closure receives. It only records; checking waits for
// registration.
export class Rules<A: ActionEnum> {
  policy: string
  list: []Rule<A>

  init(policy: string) {
    this.policy = policy
    this.list = []Rule<A>(0)
  }

  add(effect: Effect, actions: []A, resource: ResourceRef, cond: Cond) {
    this.list = append(
      this.list,
      Rule<A>{
        effect = effect,
        actions = actions,
        resource = resource,
        cond = cond,
        policy = this.policy,
      },
    )
  }

  // Allows every action in `actions` on resource `T`, where `cond` holds.
  // One action is a one-element list: `p.can<Article>([Read])`. Left out,
  // `cond` is `Cond.True`: every row.
  export can<T: Tabled>(actions: []A, cond: Cond = Cond.True) {
    this.add(Effect.Allow, actions, resourceRef<T>(), cond)
  }

  // Refuses every action in `actions` on resource `T`, where `cond` holds.
  // A refusal wins over any `can`.
  export cannot<T: Tabled>(actions: []A, cond: Cond = Cond.True) {
    this.add(Effect.Deny, actions, resourceRef<T>(), cond)
  }

  // Allows every action in `actions` on every resource: `p.canAll([Manage])`.
  export canAll(actions: []A) {
    this.add(Effect.Allow, actions, all, Cond.True)
  }

  // Refuses every action in `actions` on every resource.
  export cannotAll(actions: []A) {
    this.add(Effect.Deny, actions, all, Cond.True)
  }

  // The rules recorded so far, in the order they were written.
  export rules(): []Rule<A> {
    return this.list
  }
}

// A named policy: `build` is the closure that writes its rules for one
// subject. `S` is the app's user class and `A` its action enum, read from the
// type the policy is written against (`let p: Policy<User, Action> =
// Policy("EditOwnArticles", (p, user) => ...)`, a declared result) or written on
// the call: `Policy<User, Action>("EditOwnArticles", (p, user) => ...)`.
export class Policy<S: Subject, A: ActionEnum> {
  export name: string
  build: (Rules<A>, S) => ()

  init(name: string, build: (Rules<A>, S) => ()) {
    this.name = name
    this.build = build
  }

  // The policy's rules for `s`, every one stamped with the policy name. A
  // fresh `Rules` each call, so one subject's rules never leak into another's.
  export rulesFor(s: S): []Rule<A> {
    let p = Rules<A>(this.name)
    this.build(p, s)
    return p.rules()
  }
}

// What an InvalidPolicy says without its "invalid policy: " lead, so a rule's
// fault reads as one sentence once the policy and position are put in front.
fn faultText(message: string): string {
  let lead = "invalid policy: "
  if (hasPrefix(message, lead)) {
    return message[len(lead):]
  }
  return message
}

// What is wrong with rule `r` once the resources are known, or "".
fn ruleFault<A: ActionEnum>(list: []ResourceInfo, r: Rule<A>): string {
  if (len(r.actions) == 0) {
    return "no actions"
  }
  validateIn(list, r.resource, r.cond) catch e {
    return faultText(e.message())
  }
  return ""
}

// Fails with an InvalidPolicy naming the policy and the position (from 0) of
// the first rule that is wrong: no actions, a resource that is not
// registered, or a condition that does not fit the resource.
fn validateRulesIn<A: ActionEnum>(list: []ResourceInfo, name: string, rules: []Rule<A>): ()! {
  let i = 0
  while (i < len(rules)) {
    let why = ruleFault<A>(list, rules[i])
    if (why != "") {
      fail InvalidPolicy{ detail = "policy ${name} rule ${i}: ${why}" }
    }
    i = i + 1
  }
}
