// pkg/authz/condcheck.test.bit — Authz.validate: a condition is checked
// against the registered resource's fields and types when it is registered.

@table class Memo {
  @id
  id: i64
  title: string
  rank: f64
  done: bool
  tag: Option<string>
  blob: []byte
}

fn ckAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<Memo>() catch e {
    panic("resource: ${e.message()}")
  }
  return a
}

// The InvalidPolicy message `validate` fails with, or "" when it accepts.
fn ckMessage(ref: ResourceRef, c: Cond): string {
  ckAuthz().validate(ref, c) catch e {
    return e.message()
  }
  return ""
}

fn ckMemo(c: Cond): string {
  return ckMessage(resourceRef<Memo>(), c)
}

test "a condition that fits the resource is accepted" {
  let c = and(
    [
      eq("title", Value.Text("x")),
      gte("rank", Value.Int(1)),
      lt("id", Value.Float(9.5)),
      eq("done", Value.Bool(true)),
      oneOf("tag", [Value.Text("a"), Value.Text("b")]),
      eq("blob", Value.Blob([1, 2])),
      not(or([Cond.True, Cond.False])),
    ],
  )
  assert(ckMemo(c) == "", "rejected: ${ckMemo(c)}")
}

test "an unknown field is refused and the message lists the fields" {
  let m = ckMemo(eq("tittle", Value.Text("x")))
  assert(
    m == "invalid policy: no field tittle (fields: id, title, rank, done, tag, blob)",
    "message: ${m}",
  )
}

test "an unknown field is found inside and, or and not" {
  let bad = eq("nope", Value.Int(1))
  assert(ckMemo(and([eq("id", Value.Int(1)), bad])) != "", "and")
  assert(ckMemo(or([Cond.False, bad])) != "", "or")
  assert(ckMemo(not(bad)) != "", "not")
}

test "a value of the wrong type is refused naming the field" {
  let m = ckMemo(eq("title", Value.Int(1)))
  assert(m == "invalid policy: field title is string, the value is an integer", "message: ${m}")
  let n = ckMemo(eq("done", Value.Text("true")))
  assert(n == "invalid policy: field done is bool, the value is text", "message: ${n}")
  let o = ckMemo(oneOf("rank", [Value.Int(1), Value.Text("x")]))
  assert(o == "invalid policy: field rank is f64, the value is text", "message: ${o}")
}

test "an Option field is typed by its payload" {
  assert(
      ckMemo(eq("tag", Value.Int(1))) ==
      "invalid policy: field tag is Option<string>, the value is an integer",
    "mismatch",
  )
}

test "comparing with null is refused" {
  let m = ckMemo(eq("title", Value.Null))
  assert(m == "invalid policy: field title: comparing with null is never true", "message: ${m}")
}

test "a null test is accepted on an Option field only" {
  assert(ckMemo(eqNull("tag")) == "", "eqNull on Option")
  assert(ckMemo(neNull("tag")) == "", "neNull on Option")
  let m = ckMemo(eqNull("title"))
  assert(m == "invalid policy: field title is string and cannot be null", "message: ${m}")
  let n = ckMemo(not(neNull("nope")))
  assert(
    n == "invalid policy: no field nope (fields: id, title, rank, done, tag, blob)",
    "message: ${n}",
  )
  assert(ckMessage(all, eqNull("tag")) != "", "a null test on all names a field")
}

test "the Null operand under any other operator is refused" {
  let want = "invalid policy: field tag: comparing with null is never true"
  assert(ckMemo(Cond.Cmp("tag", Op.Lt, [Operand.Null])) == want, "lt")
  assert(ckMemo(Cond.Cmp("tag", Op.In, [Operand.Null])) == want, "in")
  assert(ckMemo(Cond.Cmp("tag", Op.Eq, [Operand.Null, Operand.Null])) != "", "two operands")
}

test "bool and bytes columns cannot be ordered" {
  let m = ckMemo(lt("done", Value.Bool(true)))
  assert(m == "invalid policy: field done is bool, which cannot be ordered", "message: ${m}")
  assert(ckMemo(gt("blob", Value.Blob([1]))) != "", "blob")
}

test "an empty in list is refused" {
  let m = ckMemo(oneOf("id", []Value{}))
  assert(m == "invalid policy: field id: operator takes one or more values, got 0", "message: ${m}")
}

test "an unregistered resource is refused listing the registered ones" {
  let m = ckMessage(ResourceRef.Named("Nope"), Cond.True)
  assert(m == "invalid policy: unknown resource Nope (registered: Memo)", "message: ${m}")
}

test "a condition on all may not name a field" {
  assert(ckMessage(all, and([Cond.True, Cond.False])) == "", "no fields is fine")
  let m = ckMessage(all, eq("id", Value.Int(1)))
  assert(m == "invalid policy: a condition on all cannot name a field (id)", "message: ${m}")
}

test "columnKind reads the declared type text" {
  assert(columnKind("Option< i64 >") == Option<ColKind>.Some(ColKind.Int), "spaced option")
  assert(columnKind("[]u8") == Option<ColKind>.Some(ColKind.Blob), "bytes")
  assert(!isSome(columnKind("[]string")), "slice of strings")
}

test "rowColumns keeps the scalar columns in order and drops the rest" {
  let cols = rowColumns(Memo.__columns())
  assert(len(cols) == 6, "kept: ${len(cols)}")
  assert(
    len(Memo{ id = 1, title = "", rank = 0.0, done = false, blob = []byte(0) }.__values()) == 6,
    "values",
  )
}
