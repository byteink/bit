// pkg/authz/relation.test.bit — relationship tuples: save-time validation,
// the in-memory store and the version its writes move.

import { indexOf, repeat } from "std/strings"

@table class Notebook {
  @id
  id: i64
  title: string
}

@table class Team {
  @id
  id: i64
  name: string
}

fn rel(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<Notebook>() catch e {
    panic(e.message())
  }
  let _ = a.resource<Team>() catch e {
    panic(e.message())
  }
  return a
}

fn version(a: Authz<Action>): i64 {
  return a.relations.version() catch e {
    panic(e.message())
  }
}

fn isRel(a: Authz<Action>, s: string, r: string, o: string): bool {
  return a.related(s, r, o) catch e {
    panic(e.message())
  }
}

fn relReason(a: Authz<Action>, s: string, r: string, o: string): string {
  a.related(s, r, o) catch e {
    return e.message()
  }
  return ""
}

fn tryRelate(a: Authz<Action>, s: string, r: string, o: string): string {
  a.relate(s, r, o) catch e {
    return e.message()
  }
  return ""
}

fn tryWrite(s: MemoryRelationStore, t: Tuple): string {
  s.write(t) catch e {
    return e.message()
  }
  return ""
}

fn ok(msg: string): bool {
  return msg == ""
}

fn invalid(msg: string): bool {
  return len(msg) > 15 && msg[0:15] == "invalid policy:"
}

fn relate(a: Authz<Action>, s: string, r: string, o: string) {
  a.relate(s, r, o) catch e {
    panic(e.message())
  }
}

test "3 of 3 valid tuples are accepted: user, typed subject, userset" {
  let a = rel()
  assert(ok(tryRelate(a, "user:sara", "editor", "notebook:launch")), "user subject")
  assert(ok(tryRelate(a, "team:eng", "viewer", "notebook:launch")), "typed subject")
  assert(ok(tryRelate(a, "team:eng#member", "editor", "notebook:launch")), "userset subject")
  assert(isRel(a, "user:sara", "editor", "notebook:launch"), "user tuple missing")
  assert(isRel(a, "team:eng#member", "editor", "notebook:launch"), "userset tuple missing")
}

test "6 of 6 malformed tuples are rejected as InvalidPolicy" {
  let a = rel()
  let long = repeat("x", 129)
  let bad = [
    tryRelate(a, "user:sara", "editor", "notebook:"),
    tryRelate(a, "user:sara", "Editor", "notebook:launch"),
    tryRelate(a, "user:sara", "editor", "folder:launch"),
    tryRelate(a, "user:sara", "editor", "notebook:two words"),
    tryRelate(a, "user:sara", "editor", "notebook:${long}"),
    tryRelate(a, "user:sara", "editor", "notebooklaunch"),
  ]
  assert(len(bad) == 6, "cases: ${len(bad)}")
  let n = 0
  for m of bad {
    if (invalid(m)) {
      n = n + 1
    }
  }
  assert(n == 6, "rejected ${n} of 6")
  assert(version(a) == 0, "a refused tuple moved the version")
}

test "each refusal names the part that is wrong and never repeats the input" {
  let a = rel()
  assert(
      tryRelate(a, "user:sara", "editor", "folder:launch") ==
      "invalid policy: object type is not a registered resource (registered: notebook, team)",
    "unknown type",
  )
  let m = tryRelate(a, "user:sara", "ed itor", "notebook:launch")
  assert(m == "invalid policy: relation must match [a-z][a-z0-9_]{0,31}", m)
  let secret = tryRelate(a, "user:sara", "editor", "notebook:s3cret value")
  assert(indexOf(secret, "s3cret") < 0, "the rejected id was echoed: ${secret}")
}

test "id bounds: 128 bytes pass, 129 fail, for subject and object" {
  let a = rel()
  let good = repeat("x", 128)
  let long = repeat("x", 129)
  assert(ok(tryRelate(a, "user:${good}", "editor", "notebook:${good}")), "128 bytes refused")
  assert(!ok(tryRelate(a, "user:${long}", "editor", "notebook:n1")), "129-byte subject id")
  assert(!ok(tryRelate(a, "user:sara", "editor", "notebook:${long}")), "129-byte object id")
}

test "ids refuse '#', a second ':', control bytes, non-ASCII and the empty id" {
  let a = rel()
  let ids = ["a#b", "a:b", "a\tb", "a\x00b", "caf\u{e9}", ""]
  let n = 0
  for id of ids {
    if (!ok(tryRelate(a, "user:sara", "editor", "notebook:${id}"))) {
      n = n + 1
    }
  }
  assert(n == 6, "object ids refused ${n} of 6")
}

test "a subject id with '#' reads as a userset, and its relation is validated" {
  let a = rel()
  assert(ok(tryRelate(a, "user:a#b", "editor", "notebook:n1")), "userset on a user")
  assert(!ok(tryRelate(a, "user:a#B", "editor", "notebook:n1")), "uppercase userset relation")
}

test "subjects: unknown type, 'user' as an object, bad userset relation" {
  let a = rel()
  assert(!ok(tryRelate(a, "ghost:1", "editor", "notebook:n1")), "unregistered subject type")
  assert(!ok(tryRelate(a, "user:sara", "editor", "user:bob")), "user is not an object type")
  assert(
    !ok(tryRelate(a, "team:eng#Member", "editor", "notebook:n1")),
    "userset relation uppercase",
  )
  assert(!ok(tryRelate(a, "team:eng#", "editor", "notebook:n1")), "empty userset relation")
  assert(!ok(tryRelate(a, "team:eng#member#x", "editor", "notebook:n1")), "second '#'")
}

test "relation bounds: 32 bytes pass, 33 fail, a digit may not lead" {
  let a = rel()
  assert(ok(tryRelate(a, "user:sara", "r${repeat("a", 31)}", "notebook:n1")), "32 bytes refused")
  assert(!ok(tryRelate(a, "user:sara", "r${repeat("a", 32)}", "notebook:n1")), "33 bytes accepted")
  assert(!ok(tryRelate(a, "user:sara", "1editor", "notebook:n1")), "leading digit")
  assert(ok(tryRelate(a, "user:sara", "can_edit_2", "notebook:n1")), "underscore and digit")
}

test "idempotent relate keeps the version, 1 of 1" {
  let a = rel()
  relate(a, "user:sara", "editor", "notebook:launch")
  let v = version(a)
  assert(v == 1, "first write: ${v}")
  relate(a, "user:sara", "editor", "notebook:launch")
  assert(version(a) == v, "a repeated write moved the version to ${version(a)}")
  let subs = a.relations.direct("notebook:launch", "editor") catch e {
    panic(e.message())
  }
  assert(len(subs) == 1, "stored ${len(subs)} copies")
}

test "delete bumps the version, 1 of 1, and deleting nothing does not" {
  let a = rel()
  relate(a, "user:sara", "editor", "notebook:launch")
  let v = version(a)
  a.unrelate("user:sara", "editor", "notebook:launch") catch e {
    panic(e.message())
  }
  assert(version(a) == v + 1, "delete: ${version(a)}")
  assert(!isRel(a, "user:sara", "editor", "notebook:launch"), "still related")
  a.unrelate("user:sara", "editor", "notebook:launch") catch e {
    panic(e.message())
  }
  assert(version(a) == v + 1, "deleting an absent tuple moved the version")
}

test "related is direct and exact: another relation, object or subject is false" {
  let a = rel()
  relate(a, "team:eng#member", "editor", "notebook:launch")
  assert(!isRel(a, "user:sara", "editor", "notebook:launch"), "userset expanded")
  assert(!isRel(a, "team:eng#member", "viewer", "notebook:launch"), "other relation")
  assert(!isRel(a, "team:eng#member", "editor", "notebook:other"), "other object")
  assert(!isRel(a, "team:eng", "editor", "notebook:launch"), "bare team")
  assert(invalid(relReason(a, "user:sara", "editor", "folder:x")), "unknown type is an error")
}

test "the store lists direct subjects and a subject's tuples oldest first" {
  let s = MemoryRelationStore()
  let t1 = Tuple{ subject = "user:sara", relation = "editor", object = "notebook:a" }
  let t2 = Tuple{ subject = "user:bob", relation = "editor", object = "notebook:a" }
  let t3 = Tuple{ subject = "user:sara", relation = "viewer", object = "notebook:b" }
  for t of [t1, t2, t3] {
    assert(ok(tryWrite(s, t)), "write")
  }
  let subs = s.direct("notebook:a", "editor") catch e {
    panic(e.message())
  }
  assert(len(subs) == 2 && subs[0] == "user:sara" && subs[1] == "user:bob", "direct order")
  let mine = s.list("user:sara") catch e {
    panic(e.message())
  }
  assert(len(mine) == 2 && mine[0].object == "notebook:a" && mine[1].object == "notebook:b", "list")
  s.delete(t1) catch e {
    panic(e.message())
  }
  let after = s.list("user:sara") catch e {
    panic(e.message())
  }
  assert(len(after) == 1 && after[0].object == "notebook:b", "list after delete: ${len(after)}")
  let gone = s.direct("notebook:a", "editor") catch e {
    panic(e.message())
  }
  assert(len(gone) == 1 && gone[0] == "user:bob", "direct after delete")
}

test "a full store refuses a new tuple and still accepts a repeat" {
  let s = MemoryRelationStore(capacity = 1)
  let t = Tuple{ subject = "user:sara", relation = "editor", object = "notebook:a" }
  let u = Tuple{ subject = "user:bob", relation = "editor", object = "notebook:a" }
  assert(ok(tryWrite(s, t)), "first write")
  assert(ok(tryWrite(s, t)), "repeat of a held tuple")
  assert(!ok(tryWrite(s, u)), "write past capacity")
}
