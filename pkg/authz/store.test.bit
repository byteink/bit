// pkg/authz/store.test.bit — stored policies: `MemoryStore` on its own, then
// `savePolicy`, `attach`, `detach` and `policy` on an `Authz`, and what they
// do to `can`. The #6984 design's PublishOwnTeam document is the running
// example: Publish an Article when its team is the user's and it is in review.
//
// `Article` (resource.test.bit) has the columns the document names and
// `Action` (action.test.bit) the enum.

import { Json, jsonParse } from "std/json"
import { contains, hasPrefix } from "std/strings"

class StUser {
  export id: string,
  export roles: []string,
  export team: string,
}

fn stAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<Article>() catch e {
    panic("resource: ${e.message()}")
  }
  return a
}

fn stJson(text: string): Json {
  return jsonParse(text) catch e {
    panic("test json: ${e.message()}")
  }
}

fn stDoc(name: string, effect: string, actions: []string, when: string): PolicyDoc {
  return PolicyDoc{
    name = name,
    statements = [
      Statement{ effect = effect, actions = actions, resource = "Article", when = stJson(when) },
    ],
  }
}

fn stPublishOwnTeam(): PolicyDoc {
  return stDoc(
    "PublishOwnTeam",
    "allow",
    ["Publish"],
    "{\"team\":\"$user.team\",\"status\":\"review\"}",
  )
}

fn stRole(policy: string, role: string): Attachment {
  return Attachment{
    policy = policy,
    to = Target{
      role = Option<string>.Some(role),
      group = Option<string>.None,
      user = Option<string>.None,
    },
    tenant = "",
  }
}

fn stGroup(policy: string, group: string): Attachment {
  return Attachment{
    policy = policy,
    to = Target{
      role = Option<string>.None,
      group = Option<string>.Some(group),
      user = Option<string>.None,
    },
    tenant = "",
  }
}

fn stUserAtt(policy: string, user: string): Attachment {
  return Attachment{
    policy = policy,
    to = Target{
      role = Option<string>.None,
      group = Option<string>.None,
      user = Option<string>.Some(user),
    },
    tenant = "",
  }
}

fn stSave(a: Authz<Action>, doc: PolicyDoc) {
  a.savePolicy(doc) catch e {
    panic("savePolicy ${doc.name}: ${e.message()}")
  }
}

fn stAttach(a: Authz<Action>, att: Attachment) {
  a.attach(att) catch e {
    panic("attach ${att.policy}: ${e.message()}")
  }
}

fn stWho(id: string, roles: []string, team: string): Option<Subject> {
  return Option<Subject>.Some(StUser{ id = id, roles = roles, team = team })
}

fn stRow(team: string, status: string): Article {
  return Article{ id = 1, title = "t", authorId = "x", team = team, status = status }
}

fn stCan(a: Authz<Action>, u: Option<Subject>, row: Article): bool {
  return a.can<Article>(u, Action.Publish, row)
}

// The message `savePolicy` or `attach` refuses with, or "OK".
fn stSaveErr(a: Authz<Action>, doc: PolicyDoc): string {
  a.savePolicy(doc) catch e {
    return e.message()
  }
  return "OK"
}

fn stAttachErr(a: Authz<Action>, att: Attachment): string {
  a.attach(att) catch e {
    return e.message()
  }
  return "OK"
}

fn stPutErr(s: MemoryStore, doc: PolicyDoc): string {
  let _ = s.putPolicy(doc) catch e {
    return e.message()
  }
  return "OK"
}

fn stAttErr(s: MemoryStore, att: Attachment): string {
  s.attach(att) catch e {
    return e.message()
  }
  return "OK"
}

// The authz handle's own store, which is a MemoryStore.
fn stMem(a: Authz<Action>): MemoryStore {
  let (m, ok) = a.store.(MemoryStore)
  assert(ok, "Authz() keeps a MemoryStore")
  return m
}

fn stVersion(s: MemoryStore): i64 {
  return s.version() catch e {
    panic("version: ${e.message()}")
  }
}

// --- MemoryStore on its own ------------------------------------------------

test "a MemoryStore keeps a policy, replaces it by name and reads it back as a fresh document" {
  let s = MemoryStore()
  let doc = stPublishOwnTeam()
  let v1 = s.putPolicy(doc) catch e {
    panic("put: ${e.message()}")
  }
  assert(v1 == 1, "first write is version 1, got ${v1}")
  doc.name = "Edited"
  let got = s.policy("PublishOwnTeam") catch e {
    panic("get: ${e.message()}")
  }
  assert(
    isSome(got) && unwrap(got).name == "PublishOwnTeam",
    "editing the caller's copy changed the store",
  )
  let none = s.policy("Edited") catch e {
    panic("get: ${e.message()}")
  }
  assert(!isSome(none), "an unsaved name reads as None")
  let v2 = s.putPolicy(stDoc("PublishOwnTeam", "deny", ["Publish"], "null")) catch e {
    panic("put: ${e.message()}")
  }
  let all = s.policies() catch e {
    panic("policies: ${e.message()}")
  }
  assert(
    v2 == 2 && len(all) == 1 && all[0].statements[0].effect == "deny",
    "replace: v${v2}, ${len(all)} policies",
  )
}

test "attach and detach are idempotent and attachments(tenant) lists exactly that tenant" {
  let s = MemoryStore()
  let g = stRole("P", "author")
  let t = stRole("P", "author")
  t.tenant = "inkwell"
  s.attach(g) catch e {
    panic("attach: ${e.message()}")
  }
  s.attach(g) catch e {
    panic("attach again: ${e.message()}")
  }
  s.attach(t) catch e {
    panic("attach tenant: ${e.message()}")
  }
  assert(stVersion(s) == 2, "the repeated attach was a write: v${stVersion(s)}")
  let global = s.attachments("") catch e {
    panic("attachments: ${e.message()}")
  }
  let inkwell = s.attachments("inkwell") catch e {
    panic("attachments: ${e.message()}")
  }
  assert(len(global) == 1 && len(inkwell) == 1 && inkwell[0].tenant == "inkwell", "split by tenant")
  s.detach(stRole("P", "nobody")) catch e {
    panic("detach: ${e.message()}")
  }
  assert(stVersion(s) == 2, "detaching what is not there kept the version")
  s.detach(g) catch e {
    panic("detach: ${e.message()}")
  }
  let left = s.attachments("") catch e {
    panic("attachments: ${e.message()}")
  }
  assert(stVersion(s) == 3 && len(left) == 0, "detach removed it")
}

test "a user id with the key separator in it is a different attachment, not a collision" {
  let s = MemoryStore()
  s.attach(stUserAtt("P", "a|b")) catch e {
    panic("attach: ${e.message()}")
  }
  s.attach(stUserAtt("P", "a")) catch e {
    panic("attach: ${e.message()}")
  }
  assert(stVersion(s) == 2, "two users, two writes")
}

test "a full MemoryStore refuses a new policy and a new attachment but still replaces" {
  let s = MemoryStore(maxPolicies = 1, maxAttachments = 1)
  let _ = s.putPolicy(stDoc("A", "allow", ["Read"], "null")) catch e {
    panic("put: ${e.message()}")
  }
  let full = stPutErr(s, stDoc("B", "allow", ["Read"], "null"))
  assert(contains(full, "full at 1 policies"), "second policy: ${full}")
  let _ = s.putPolicy(stDoc("A", "deny", ["Read"], "null")) catch e {
    panic("replace in a full store: ${e.message()}")
  }
  s.attach(stRole("A", "r")) catch e {
    panic("attach: ${e.message()}")
  }
  let fullAtt = stAttErr(s, stRole("A", "r2"))
  assert(contains(fullAtt, "full at 1 attachments"), "second attachment: ${fullAtt}")
}

// --- the acceptance rows ---------------------------------------------------

test "PublishOwnTeam saved and attached to role author flips can(Publish): 1 of 1 matching, 2 of 2 not" {
  let a = stAuthz()
  let sara = stWho("sara", ["author"], "news")
  let hit = stRow("news", "review")
  assert(!stCan(a, sara, hit), "before the save")
  stSave(a, stPublishOwnTeam())
  assert(!stCan(a, sara, hit), "saved but attached to nobody")
  stAttach(a, stRole("PublishOwnTeam", "author"))
  assert(stCan(a, sara, hit), "matching row after attach")
  assert(!stCan(a, sara, stRow("sport", "review")), "another team's row")
  assert(!stCan(a, sara, stRow("news", "draft")), "a row not in review")
}

test "attach to a group and to one user, 2 of 2" {
  let a = stAuthz()
  stSave(a, stPublishOwnTeam())
  let row = stRow("news", "review")
  let viaGroup = stWho("eve", ["group:editors"], "news")
  let viaUser = stWho("sara", [], "news")
  let neither = stWho("zed", ["group:readers"], "news")
  stAttach(a, stGroup("PublishOwnTeam", "editors"))
  stAttach(a, stUserAtt("PublishOwnTeam", "sara"))
  assert(stCan(a, viaGroup, row), "member of group editors")
  assert(stCan(a, viaUser, row), "user sara")
  assert(!stCan(a, neither, row), "another group")
  assert(
    !stCan(a, stWho("editors", ["editors"], "news"), row),
    "a role called editors is not the group",
  )
}

test "detach revokes, 1 of 1, from a subject already cached" {
  let a = stAuthz()
  stSave(a, stPublishOwnTeam())
  let att = stRole("PublishOwnTeam", "author")
  stAttach(a, att)
  let sara = stWho("sara", ["author"], "news")
  let row = stRow("news", "review")
  assert(stCan(a, sara, row), "granted")
  assert(stCan(a, sara, row), "granted again, from the cache")
  a.detach(att) catch e {
    panic("detach: ${e.message()}")
  }
  assert(!stCan(a, sara, row), "revoked")
}

test "attaching an unknown policy and saving an invalid document are refused, 2 of 2" {
  let a = stAuthz()
  let unknown = stAttachErr(a, stRole("Ghost", "author"))
  assert(hasPrefix(unknown, "invalid policy: /policy: no stored policy is called 'Ghost'"), unknown)
  let bad = stSaveErr(a, stDoc("Bad", "allow", ["Publsh"], "null"))
  assert(hasPrefix(bad, "invalid policy: /statements/0/actions/0"), bad)
  let stored = a.policy("Bad") catch e {
    panic("policy: ${e.message()}")
  }
  assert(!isSome(stored), "an invalid document was stored")
}

test "saving an unchanged document is a no-op and keeps the version, 1 of 1" {
  let a = stAuthz()
  stSave(a, stPublishOwnTeam())
  let before = stVersion(stMem(a))
  stSave(a, stPublishOwnTeam())
  assert(stVersion(stMem(a)) == before, "version moved on an unchanged save")
  stSave(a, stDoc("PublishOwnTeam", "allow", ["Publish"], "null"))
  assert(stVersion(stMem(a)) == before + 1, "a changed document did not")
}

// --- evaluation beside code policies ---------------------------------------

test "a saved policy replaced under the same name changes the answer for a cached subject" {
  let a = stAuthz()
  stSave(a, stPublishOwnTeam())
  stAttach(a, stRole("PublishOwnTeam", "author"))
  let sara = stWho("sara", ["author"], "news")
  assert(stCan(a, sara, stRow("news", "review")), "before")
  stSave(a, stDoc("PublishOwnTeam", "allow", ["Publish"], "{\"status\":\"draft\"}"))
  assert(!stCan(a, sara, stRow("news", "review")), "the old document still applies")
  assert(stCan(a, sara, stRow("sport", "draft")), "the new one does not")
}

test "a stored deny beats a code allow, and a code deny beats a stored allow" {
  let a = stAuthz()
  let codeAllow = Policy<StUser, Action>("CodeAllow", (p, user) => {
    p.canAll([Action.Publish])
  })
  let codeDeny = Policy<StUser, Action>("CodeDeny", (p, user) => {
    p.cannot<Article>([Action.Delete])
  })
  let _ = a.role<StUser>("editor", [codeAllow, codeDeny]) catch e {
    panic("role: ${e.message()}")
  }
  stSave(a, stDoc("NoDraftPublish", "deny", ["Publish"], "{\"status\":\"draft\"}"))
  stSave(a, stDoc("DeleteAny", "allow", ["Delete"], "null"))
  stAttach(a, stRole("NoDraftPublish", "editor"))
  stAttach(a, stRole("DeleteAny", "editor"))
  let eve = stWho("eve", ["editor"], "news")
  assert(stCan(a, eve, stRow("news", "review")), "code allow, stored deny does not match")
  assert(!stCan(a, eve, stRow("news", "draft")), "stored deny wins over the code allow")
  assert(
    !a.can<Article>(eve, Action.Delete, stRow("news", "review")),
    "code deny wins over the stored allow",
  )
}

test "a stored policy may not take the name of a code policy, before or after" {
  let a = stAuthz()
  let codeRead = Policy<StUser, Action>("CodeRead", (p, user) => {
    p.can<Article>([Action.Read])
  })
  let _ = a.role<StUser>("reader", [codeRead]) catch e {
    panic("role: ${e.message()}")
  }
  let msg = stSaveErr(a, stDoc("CodeRead", "deny", ["Read"], "null"))
  assert(
    hasPrefix(msg, "invalid policy: /name: a policy written in code is called 'CodeRead'"),
    msg,
  )
  stSave(a, stDoc("Later", "allow", ["Publish"], "null"))
  stAttach(a, stRole("Later", "late"))
  let laterCode = Policy<StUser, Action>("Later", (p, user) => {
    p.cannot<Article>([Action.Publish])
  })
  let _ = a.role<StUser>("other", [laterCode]) catch e {
    panic("role: ${e.message()}")
  }
  let r = a.rolesOf(StUser{ id = "u", roles = ["other", "late"], team = "" })
  assert(len(r.rules) == 1 && r.rules[0].policy == "Later", "the code policy keeps the name")
  assert(
    len(r.skipped) == 1 && contains(r.skipped[0], "stored policy Later is left out"),
    "skipped: ${len(r.skipped)}",
  )
}

test "a role with only a stored policy is not reported undefined, and the rules come after the code ones" {
  let a = stAuthz()
  let codeRead = Policy<StUser, Action>("CodeRead", (p, user) => {
    p.can<Article>([Action.Read])
  })
  let _ = a.role<StUser>("reader", [codeRead]) catch e {
    panic("role: ${e.message()}")
  }
  stSave(a, stDoc("S1", "allow", ["Update"], "null"))
  stSave(a, stDoc("S2", "allow", ["Create"], "null"))
  stSave(a, stDoc("S3", "allow", ["Delete"], "null"))
  stAttach(a, stRole("S1", "special"))
  stAttach(a, stUserAtt("S3", "u"))
  stAttach(a, stGroup("S2", "g"))
  let r = a.rolesOf(StUser{ id = "u", roles = ["group:g", "special", "reader"], team = "" })
  assert(len(r.skipped) == 0, "skipped: ${len(r.skipped)}")
  assert(len(r.rules) == 4, "rules ${len(r.rules)}")
  assert(r.rules[0].policy == "CodeRead", "code first")
  assert(
    r.rules[1].policy == "S2",
    "roles in the order listed, group g first: ${r.rules[1].policy}",
  )
  assert(r.rules[2].policy == "S1" && r.rules[3].policy == "S3", "role, then the user's own")
}

test "the guest has the stored policies attached to the role guest" {
  let a = stAuthz()
  stSave(a, stDoc("GuestRead", "allow", ["Read"], "{\"status\":\"published\"}"))
  let none = Option<Subject>.None
  let row = stRow("news", "published")
  assert(!a.can<Article>(none, Action.Read, row), "before the attach")
  stAttach(a, stRole("GuestRead", "guest"))
  assert(a.can<Article>(none, Action.Read, row), "after")
  assert(!a.can<Article>(none, Action.Read, stRow("news", "draft")), "a draft stays hidden")
}

test "an attachment for a named tenant is stored but applies to nobody before tenant views" {
  let a = stAuthz()
  stSave(a, stPublishOwnTeam())
  let att = stRole("PublishOwnTeam", "author")
  att.tenant = "inkwell"
  stAttach(a, att)
  assert(
    !stCan(a, stWho("sara", ["author"], "news"), stRow("news", "review")),
    "tenant attachment applied globally",
  )
}

test "filterFor sees the stored rules too" {
  let a = stAuthz()
  stSave(a, stDoc("ReadPublished", "allow", ["Read"], "{\"status\":\"published\"}"))
  stAttach(a, stRole("ReadPublished", "reader"))
  let f = a.filterFor<Article>(stWho("sara", ["reader"], "news"), Action.Read) catch e {
    panic("filterFor: ${e.message()}")
  }
  match (f) {
    Where(_) => {}
    _ => assert(false, "a stored allow with a condition is a Where filter")
  }
}

test "subject<S>() makes a stored-only class cacheable, and calling it twice changes nothing" {
  let plain = stAuthz()
  let kept = stAuthz()
  let _ = kept.subject<StUser>().subject<StUser>()
  let sara = stWho("sara", ["author"], "news")
  for a of [plain, kept] {
    stSave(a, stPublishOwnTeam())
    stAttach(a, stRole("PublishOwnTeam", "author"))
    assert(stCan(a, sara, stRow("news", "review")), "granted")
  }
  assert(
    !plain.state.cache.find(unwrap(sara), plain.tenant).built,
    "an unregistered class is rebuilt on every check",
  )
  assert(kept.state.cache.find(unwrap(sara), kept.tenant).built, "a registered class is kept")
  assert(len(kept.state.cache.kinds) == 1, "kinds: ${len(kept.state.cache.kinds)}")
}
