// pkg/authz/condjson.test.bit — condFromJson: 14 documents that decode to the
// expected Cond, 12 that are refused with the path in the message, and the
// limits (depth 16, 256 nodes).

import { Json, jsonParse } from "std/json"
import { repeat } from "std/strings"

@table class JdFolder {
  @id
  id: i64
  name: string
}

@table class JdPost {
  @id
  id: i64
  title: string
  views: i64
  score: f64
  done: bool
  tag: Option<string>
  data: []byte
  @enumVariants("draft", "review", "live")
  status: string
  team: string
  folderId: Option<i64>
  @belongsTo("folderId")
  folder: Option<JdFolder>
}

fn jdRes(): ResourceInfo {
  return describe<JdPost>()
}

fn jdValue(v: Value): string {
  return match (v) {
    Null => "null"
    Int(i) => "i${i}"
    Float(x) => "f${x}"
    Bool(b) => "b${b}"
    Text(s) => "t:${s}"
    Blob(_) => "blob"
  }
}

fn jdOperand(o: Operand): string {
  return match (o) {
    Lit(v) => jdValue(v)
    Param(p) => "user.${p}"
  }
}

fn jdOps(os: []Operand): string {
  let parts = []string(0)
  for o of os {
    parts = append(parts, jdOperand(o))
  }
  return join(parts, ",")
}

fn jdCmpOp(op: Op): string {
  return match (op) {
    Eq => "eq"
    Ne => "ne"
    In => "in"
    Lt => "lt"
    Lte => "lte"
    Gt => "gt"
    Gte => "gte"
  }
}

fn jdList(cs: []Cond): string {
  let parts = []string(0)
  for c of cs {
    parts = append(parts, jdShape(c))
  }
  return join(parts, " ")
}

fn jdShape(c: Cond): string {
  return match (c) {
    True => "True"
    False => "False"
    Cmp(f, op, os) => "${f} ${jdCmpOp(op)} ${jdOps(os)}"
    And(cs) => "And(${jdList(cs)})"
    Or(cs) => "Or(${jdList(cs)})"
    Not(inner) => "Not(${jdShape(inner)})"
    Known(inner) => "Known(${jdShape(inner)})"
    Custom(label, _) => "Custom(${label})"
    Related(l, t, r) => "Related(${l},${t},${r})"
  }
}

fn jdParse(text: string): Json {
  return jsonParse(text) catch e {
    panic("test json: ${e.message()}")
  }
}

// The shape `text` decodes to, or "ERR <message>" when it is refused.
fn jdRun(text: string): string {
  let c = condFromJson(jdRes(), jdParse(text)) catch e {
    return "ERR ${e.message()}"
  }
  return jdShape(c)
}

fn jdIs(text: string, want: string) {
  let got = jdRun(text)
  assert(got == want, "${text}\n  got:  ${got}\n  want: ${want}")
}

// `{"$not":{"$not": ... {} }}` with `n` $nots: an object nested n + 1 deep.
fn jdNots(n: int): string {
  return repeat("{\"$not\":", n) + "{}" + repeat("}", n)
}

fn jdAnd(n: int): string {
  return "{\"$and\":[" + repeat("{},", n - 1) + "{}]}"
}

test "14 valid documents decode to the expected Cond" {
  jdIs("{\"views\":{\"$eq\":3}}", "views eq i3")
  jdIs("{\"views\":{\"$ne\":3}}", "views ne i3")
  jdIs("{\"status\":{\"$in\":[\"draft\",\"live\"]}}", "status in t:draft,t:live")
  jdIs("{\"views\":{\"$lt\":3}}", "views lt i3")
  jdIs("{\"views\":{\"$lte\":3}}", "views lte i3")
  jdIs("{\"score\":{\"$gt\":1.5}}", "score gt f1.5")
  jdIs("{\"views\":{\"$gte\":18,\"$lt\":65}}", "And(views gte i18 views lt i65)")
  jdIs("{\"$and\":[{\"done\":true},{\"title\":\"a\"}]}", "And(done eq btrue title eq t:a)")
  jdIs("{\"$or\":[{\"done\":true},{\"title\":\"a\"}]}", "Or(done eq btrue title eq t:a)")
  jdIs("{\"$not\":{\"done\":true}}", "Not(done eq btrue)")
  jdIs("{\"team\":\"$user.team\"}", "team eq user.team")
  jdIs("{\"title\":\"$$user.team\"}", "title eq t:$user.team")
  jdIs("{\"folder\":{\"$related\":\"editor\"}}", "Related(folderId,JdFolder,editor)")
  jdIs("{}", "True")
}

test "a plain value is equality, entries are AND-ed, numbers keep their kind" {
  jdIs("{\"title\":\"a\",\"views\":3}", "And(title eq t:a views eq i3)")
  jdIs("{\"score\":2}", "score eq i2")
  jdIs("{\"score\":2.5}", "score eq f2.5")
  jdIs("{\"views\":2.5}", "views eq f2.5")
  jdIs("{\"status\":\"review\"}", "status eq t:review")
  jdIs("{\"status\":{\"$in\":[\"$user.stage\",\"live\"]}}", "status in user.stage,t:live")
}

test "12 invalid documents are refused with the path in the message" {
  jdIs(
    "{\"$or\":[{},{\"titel\":\"x\"}]}",
    "ERR invalid policy: when.$or[1].titel: JdPost has no field \"titel\" (closest: \"title\")",
  )
  jdIs(
    "{\"views\":\"many\"}",
    "ERR invalid policy: when.views: field views is i64, the value is text",
  )
  jdIs(
    "{\"title\":{\"$ne\":4}}",
    "ERR invalid policy: when.title.$ne: field title is string, the value is an integer",
  )
  jdIs(
    "{\"done\":\"yes\"}",
    "ERR invalid policy: when.done: field done is bool, the value is text",
  )
  jdIs(
    "{\"views\":{\"$between\":[1,2]}}",
    "ERR invalid policy: when.views.$between: unknown operator \"$between\" (operators: $eq, $ne, $in, $lt, $lte, $gt, $gte, $related)",
  )
  jdIs(
    "{\"done\":{\"$gt\":true}}",
    "ERR invalid policy: when.done.$gt: field done is bool, which cannot be ordered",
  )
  jdIs(
    "{\"status\":{\"$lt\":\"live\"}}",
    "ERR invalid policy: when.status.$lt: field status is an enum, which cannot be ordered",
  )
  jdIs(
    "{\"views\":{\"$in\":5}}",
    "ERR invalid policy: when.views.$in: $in needs an array, got an integer",
  )
  jdIs(
    "{\"title\":null}",
    "ERR invalid policy: when.title: field title is string and cannot be null",
  )
  jdIs("[1]", "ERR invalid policy: when: expected an object, got an array")
  let deep = jdRun(jdNots(16))
  let at = "when" + repeat(".$not", 16)
  assert(deep == "ERR invalid policy: ${at}: nested deeper than 16 levels", "depth 17: ${deep}")
  let wide = jdRun(jdAnd(257))
  assert(
    wide == "ERR invalid policy: when.$and[255]: more than 256 nodes in one condition",
    "257 nodes: ${wide}",
  )
}

test "the limits are exact: depth 16 and 256 nodes are accepted" {
  // 15 $nots over {} is depth 16; not() folds the pairs, so the result is False.
  let d = jdRun(jdNots(15))
  assert(d == "False", "depth 16: ${d}")
  let n = jdRun(jdAnd(255))
  assert(n == "True", "256 nodes: ${n}")
}

test "other shapes a hand-written document gets wrong are refused" {
  jdIs(
    "{\"views\":{}}",
    "ERR invalid policy: when.views: an operator object needs at least one operator (operators: $eq, $ne, $in, $lt, $lte, $gt, $gte, $related)",
  )
  jdIs(
    "{\"views\":[1,2]}",
    "ERR invalid policy: when.views: field views: use { \"$in\": [...] } for a list",
  )
  jdIs(
    "{\"views\":{\"$in\":[]}}",
    "ERR invalid policy: when.views.$in: $in needs at least one value",
  )
  jdIs(
    "{\"tag\":null}",
    "ERR invalid policy: when.tag: field tag: comparing with null is never true",
  )
  jdIs(
    "{\"status\":\"gone\"}",
    "ERR invalid policy: when.status: field status: \"gone\" is not a variant (variants: draft, review, live)",
  )
  jdIs(
    "{\"$nor\":[]}",
    "ERR invalid policy: when.$nor: unknown operator \"$nor\" (conditions: $and, $or, $not)",
  )
  jdIs(
    "{\"$or\":{}}",
    "ERR invalid policy: when.$or: expected an array of objects, got an object",
  )
  jdIs(
    "{\"team\":\"$user.\"}",
    "ERR invalid policy: when.team: the placeholder \"$user.\" names no attribute",
  )
  jdIs(
    "{\"data\":\"x\"}",
    "ERR invalid policy: when.data: field data is []byte, the value is text",
  )
  jdIs(
    "{\"folder\":\"x\"}",
    "ERR invalid policy: when.folder: folder is not a plain column; a relation takes { \"$related\": \"<relation>\" }",
  )
  jdIs(
    "{\"folder\":{\"$related\":\"editor\",\"$eq\":1}}",
    "ERR invalid policy: when.folder.$related: $related is the whole value of a field, it takes no other operator",
  )
}

test "the path prefix is the caller's" {
  let c = condFromJson(jdRes(), jdParse("{\"xylophone\":1}"), "statements[0].when") catch e {
    let want = "invalid policy: statements[0].when.xylophone: JdPost has no field \"xylophone\" (fields: "
    assert(hasPrefix(e.message(), want), "message: ${e.message()}")
    return
  }
  assert(false, "accepted: ${jdShape(c)}")
}

test "every JSON shape is a refusal or a Cond, never a panic" {
  let docs = [
    "null", "true", "1", "1.5", "\"s\"", "[]", "{}", "{\"\":1}", "{\"$\":1}",
    "{\"$and\":null}", "{\"$and\":[null]}", "{\"$not\":[]}", "{\"views\":{\"$in\":[[1]]}}",
    "{\"views\":{\"$eq\":{}}}", "{\"folder\":{\"$related\":5}}", "{\"folder\":{\"$related\":\"\"}}",
    "{\"folder\":{\"$related\":null}}", "{\"views\":{\"\":1}}", "{\"views\":{\"$eq\":[1]}}",
    "{\"title\":{\"$related\":\"editor\"}}", "{\"nope\":{\"$related\":\"editor\"}}",
  ]
  for d of docs {
    assert(jdRun(d) != "", "empty result for ${d}")
  }
}

enum JdAction { Manage, Read }

// What `condFromJson` returns is what `validate` accepts: the two checks agree.
test "a decoded document passes Authz.validate for the same resource" {
  let a = Authz<JdAction>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<JdPost>() catch e {
    panic("resource: ${e.message()}")
  }
  let doc = "{\"team\":\"$user.team\",\"views\":{\"$gte\":18},\"status\":{\"$in\":[\"draft\",\"live\"]}}"
  let c = condFromJson(jdRes(), jdParse(doc)) catch e {
    panic("decode: ${e.message()}")
  }
  a.validate(resourceRef<JdPost>(), c) catch e {
    panic("validate: ${e.message()}")
  }
}
