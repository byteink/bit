// pkg/authz/rulecache.bit — a subject's rules, built once per subject VALUE
// and reused by every later `can` and `check`: CASL's Ability-per-user, kept
// by the package so the app holds no handle.
//
// THE KEY IS THE WHOLE SUBJECT. A policy closure may read any attribute
// (`user.team`), so the rules are a function of the subject's value, not of
// its id and roles. The compiler writes `__valueHash`, `__sameValue` and
// `__snapshot` for every class with value semantics (SPEC §14.3, #7327): an
// entry is found by the hash, confirmed with `__sameValue` against a deep
// copy taken when it was built, and the policies run on that copy, so a
// later change to the caller's object (even in place, even to a slice) is a
// different key and the rules can hold nothing the caller can still mutate.
//
// WHEN IT IS DROPPED. Every `role` and `resource` registration and every
// `logTo` bumps `version` (a relation declaration does not: no rule reads it); an entry built under an older one is a miss. The table is
// direct-mapped: `cacheSlots` entries, the slot is the hash modulo that, and a
// miss overwrites whatever held its slot. At most `cacheSlots` subjects' rules
// are kept, and a lookup is one slot, never a scan.
//
// NOT EVERY SUBJECT IS KEPT. A class with a field that has no value semantics
// (a function, an interface, a generic class, a tuple; E0313) has none of the
// three members: its rules are built on every call, as before this cache.
// So is a subject whose class has no role registered for it, and one a policy
// written against an interface type runs for (that policy reads the caller's
// own object).
//
// INSIDE AN ENTRY the rules are indexed by (resource class, action) on first
// use: a check scans only the rules that can match, and each carries the
// Decision it makes, built once. Allocation on a hit: none for rules without
// a condition; the row's `__values()` once when a matching rule has one.
//
// ONE LOCK PER HIT. `lookup` picks the subject's kind, hashes it, reads the
// version and the table, and finds or builds the (class, action) slot in one
// locked section; `same` then compares the value outside it. An entry never
// changes once stored except for its `slots`, which only grow under the lock.
//
// TWO PER MISS. On a miss the same section hands back an empty entry that
// carries the hash, the kind, the version and the `Registry` it read; the
// rules are built outside the lock, and `commit` checks them and stores the
// entry in a second section. Registration replaces the `Registry` whole and
// bumps the version in one section, so a miss never reads a list a
// registration is writing (a slice is three words and a racing read can
// tear, SPEC "Data race").

import { Mutex } from "std/sync"
import { Json } from "std/json"
import { Logger, getDefault } from "std/log"

// How many subjects' rules are kept at once.
const cacheSlots: int = 512

// What #7327 writes for a class with value semantics. `Subject`'s requirements
// are repeated so a `Subject` can be asserted to it.
interface Valued<S> {
  id: string,
  roles: []string,
  __field(name: string): Option<Json>,
  __sameValue(other: S): bool,
  __valueHash(): u64,
  __snapshot(): S,
}

// What a set holds as its snapshot before anything is frozen: a subject with
// no id and no roles, which no policy is ever run on. Its fields are exported
// because `__field` is only synthesized for a class that has one (SPEC §14.3).
class Unheld {
  export id: string,
  export roles: []string,
}

// The value operations of one subject class `S`, erased: `owns` is true for a
// subject of exactly class `S` when `S` has the three members.
class SubjectKind {
  owns: (Subject) => bool,
  hash: (Subject) => u64,
  same: (Subject, Subject) => bool,
  freeze: (Subject) => Subject,
}

fn kindFor<S: Subject>(): SubjectKind {
  return SubjectKind{
    owns = (s: Subject) => {
      let (_, ok) = s.(Valued<S>)
      return ok
    },
    hash = (s: Subject) => {
      let (v, _) = s.(Valued<S>)
      return v.__valueHash()
    },
    same = (f: Subject, s: Subject) => {
      let (h, held) = f.(S)
      let (v, ok) = s.(Valued<S>)
      return held && ok && v.__sameValue(h)
    },
    freeze = (s: Subject) => {
      let (v, _) = s.(Valued<S>)
      let f: Subject = v.__snapshot()
      return f
    },
  }
}

fn noKind(): SubjectKind {
  return SubjectKind{
    owns = (s: Subject) => false,
    hash = (s: Subject) => 0,
    same = (f: Subject, s: Subject) => false,
    freeze = (s: Subject) => {
      let f: Subject = Unheld{ id = "", roles = []string(0) }
      return f
    },
  }
}

// The rules of one (resource class, action) pair of `set`, in rule order,
// with each rule's position in its policy and the Decision it makes when it
// matches; `none` is the default deny. `names` are the class's column names.
// The slot names its entry so that one locked lookup returns both.
class RuleSlot<A: ActionEnum> {
  set: RuleSet<A>,
  className: string,
  action: A,
  names: []string,
  rules: []Rule<A>,
  at: []int,
  decs: []Decision,
  none: Decision,
}

// One subject's rules, made from `reg`. `built` is false until the rules are
// in. `clean` is true when no rule was faulty when it was built, so a check
// skips the per-rule fault lookup. Only `slots` changes after the set is
// stored, and only under the cache's lock.
class RuleSet<A: ActionEnum> {
  version: int,
  hash: u64,
  kind: SubjectKind,
  held: Subject,
  reg: Registry<A>,
  built: bool,
  rules: []Rule<A>,
  skipped: []string,
  clean: bool,
  slots: []RuleSlot<A>,
}

// The column names of one registered resource, computed once.
class ResourceCols {
  name: string,
  names: []string,
}

// What registration has published: the roles, the resources with their
// column names, the guest's rules, the relation declarations and the
// logger. Replaced whole under `RuleCache.mu` and never changed after, so a
// reader that took it under the lock reads the lists without it.
class Registry<A: ActionEnum> {
  roles: []RoleDef<A>,
  resources: []ResourceInfo,
  cols: []ResourceCols,
  guest: []Rule<A>,
  decls: []RelationDecl,
  logger: Option<Logger>,
}

// The `Logger` a registry's checks write to: the one `logTo` set, else
// std/log's process default, resolved at each use so a `setDefault` after the
// handle was built still takes effect. A level the logger has off costs a
// check no allocation (std/log's shared off record).
fn loggerOf<A: ActionEnum>(r: Registry<A>): Logger {
  if (isSome(r.logger)) {
    return unwrap(r.logger)
  }
  return getDefault()
}

fn emptyRegistry<A: ActionEnum>(): Registry<A> {
  return Registry<A>{
    roles = []RoleDef<A>(0), resources = []ResourceInfo(0), cols = []ResourceCols(0),
    guest = []Rule<A>(0), decls = []RelationDecl(0), logger = Option<Logger>.None,
  }
}

// A new slice holding `xs` then `x`; `xs`'s array is left as it was, so a
// reader still holding it is unaffected.
fn grown<T>(xs: []T, x: T): []T {
  let out = []T(0, len(xs) + 1)
  for v of xs {
    out = append(out, v)
  }
  return append(out, x)
}

fn colsOf(info: ResourceInfo): ResourceCols {
  let names = []string(0)
  for c of rowColumns(info.columns) {
    names = append(names, c.name)
  }
  return ResourceCols{ name = info.name, names = names }
}

fn namesFor(cols: []ResourceCols, resource: string): []string {
  for c of cols {
    if (c.name == resource) {
      return c.names
    }
  }
  return []string(0)
}

fn allowedBy(policy: string): Decision {
  return Decision{ allowed = true, policy = policy, reason = "allowed by rule", invalid = false }
}

fn ruleDecision<A: ActionEnum>(r: Rule<A>): Decision {
  if (r.effect == Effect.Deny) {
    return denyAll(r.policy)
  }
  return allowedBy(r.policy)
}

fn countApplying<A: ActionEnum>(rules: []Rule<A>, cls: string, want: string, wildcard: bool): int {
  let n = 0
  for r of rules {
    if (applies<A>(r, cls, want, wildcard)) {
      n = n + 1
    }
  }
  return n
}

// Gives `sl` the rules of its set that apply to its (class, action); a first
// pass sizes the slices. `k` is each rule's position in its policy (a
// policy's rules are contiguous).
fn fillSlot<A: ActionEnum>(sl: RuleSlot<A>, wildcard: bool) {
  let rules = sl.set.rules
  let want = actionName(sl.action)
  let n = countApplying<A>(rules, sl.className, want, wildcard)
  sl.rules = []Rule<A>(0, n)
  sl.at = []int(0, n)
  sl.decs = []Decision(0, n)
  let prev = ""
  let k = 0
  for r of rules {
    if (r.policy != prev) {
      prev = r.policy
      k = 0
    }
    if (applies<A>(r, sl.className, want, wildcard)) {
      sl.rules = append(sl.rules, r)
      sl.at = append(sl.at, k)
      sl.decs = append(sl.decs, ruleDecision<A>(r))
    }
    k = k + 1
  }
}

fn emptySet<A: ActionEnum>(): RuleSet<A> {
  return RuleSet<A>{
    version = -1, hash = 0, kind = noKind(), held = Unheld{ id = "", roles = []string(0) }, reg = emptyRegistry<A>(),
    built = false, rules = []Rule<A>(0), skipped = []string(0), clean = true,
    slots = []RuleSlot<A>(0),
  }
}

// The subjects' rule sets and the guest's, under `mu`. `none` (version -1)
// fills every empty slot. `miss` lends its empty slices to a slot not yet
// filled; `noAllow` is the default deny every slot shares. `reg` and
// `version` change together, in one section, on every registration; the
// verdict cache (`DecideState.verdicts`) is guarded by this lock too.
class RuleCache<A: ActionEnum> {
  mu: Mutex
  version: int
  reg: Registry<A>
  table: []RuleSet<A>
  guest: RuleSet<A>
  none: RuleSet<A>
  miss: RuleSlot<A>
  noAllow: Decision
  kinds: []SubjectKind

  init() {
    this.mu = Mutex()
    this.version = 0
    this.none = emptySet<A>()
    this.reg = this.none.reg
    this.noAllow = Decision{ allowed = false, policy = "", reason = noAllowRule, invalid = false }
    let act: A
    this.miss = RuleSlot<A>{
      set = this.none, className = "", action = act, names = []string(0),
      rules = []Rule<A>(0), at = []int(0), decs = []Decision(0), none = this.noAllow,
    }
    this.table = []RuleSet<A>(0)
    let i = 0
    while (i < cacheSlots) {
      this.table = append(this.table, this.none)
      i = i + 1
    }
    this.guest = this.none
    this.kinds = []SubjectKind(0)
  }

  // What registration has published so far.
  registry(): Registry<A> {
    this.mu.lock()
    let r = this.reg
    this.mu.unlock()
    return r
  }

  // Publishes role `def` with its subject kind (and, for the guest role,
  // `guest` as the guest's rules) and a new version, in one section. False,
  // and nothing published, when a role of that name is there already.
  addRole(def: RoleDef<A>, k: SubjectKind, guest: []Rule<A>): bool {
    this.mu.lock()
    let r = this.reg
    let fresh = !isSome(findRole<A>(r.roles, def.name))
    if (fresh) {
      let g = r.guest
      if (def.name == guestRole) {
        g = guest
      }
      this.reg = Registry<A>{
        roles = grown<RoleDef<A>>(r.roles, def), resources = r.resources, cols = r.cols, guest = g,
        decls = r.decls, logger = r.logger,
      }
      this.kinds = append(this.kinds, k)
      this.version = this.version + 1
    }
    this.mu.unlock()
    return fresh
  }

  // Publishes resource `info` and a new version, in one section. False, and
  // nothing published, when a resource of that name is there already.
  addResource(info: ResourceInfo): bool {
    let cols = colsOf(info)
    this.mu.lock()
    let r = this.reg
    let fresh = !isSome(findResource(r.resources, info.name))
    if (fresh) {
      this.reg = Registry<A>{
        roles = r.roles, resources = grown<ResourceInfo>(r.resources, info),
        cols = grown<ResourceCols>(r.cols, cols), guest = r.guest, decls = r.decls, logger = r.logger,
      }
      this.version = this.version + 1
    }
    this.mu.unlock()
    return fresh
  }

  // Publishes relation declaration `d`, in one section. False, and nothing
  // published, when the resource already declares that relation. No version
  // bump: a rule set never reads declarations.
  addDecl(d: RelationDecl): bool {
    this.mu.lock()
    let r = this.reg
    let fresh = !isSome(declNamed(r.decls, d.typ, d.name))
    if (fresh) {
      this.reg = Registry<A>{
        roles = r.roles, resources = r.resources, cols = r.cols, guest = r.guest,
        decls = grown<RelationDecl>(r.decls, d), logger = r.logger,
      }
    }
    this.mu.unlock()
    return fresh
  }

  // Publishes `logger` with a new version, in one section: every set built
  // before it carries the old logger, so the next check of each rebuilds.
  setLogger(logger: Logger) {
    this.mu.lock()
    let r = this.reg
    this.reg = Registry<A>{
      roles = r.roles, resources = r.resources, cols = r.cols, guest = r.guest,
      decls = r.decls, logger = Option<Logger>.Some(logger),
    }
    this.version = this.version + 1
    this.mu.unlock()
  }

  // Under `mu`: the index of the kind that owns `s`, or -1.
  kindAt(s: Subject): int {
    let i = 0
    while (i < len(this.kinds)) {
      if (this.kinds[i].owns(s)) {
        return i
      }
      i = i + 1
    }
    return -1
  }

  // The kind that owns `s`, or `none`'s kind when no class registered has
  // the three members for it.
  kindOf(s: Subject): SubjectKind {
    this.mu.lock()
    let i = this.kindAt(s)
    let k = this.none.kind
    if (i >= 0) {
      k = this.kinds[i]
    }
    this.mu.unlock()
    return k
  }

  // Under `mu`: `s`'s hash under kind `i`, 0 when no kind owns it.
  hashAt(i: int, s: Subject): u64 {
    if (i < 0) {
      return 0
    }
    return this.kinds[i].hash(s)
  }

  // Under `mu`: the current entry with hash `h` for a subject of kind `i`,
  // or `none`. Whether it holds the subject's value is the caller's `same`,
  // outside the lock.
  entryAt(i: int, h: u64): RuleSet<A> {
    if (i < 0) {
      return this.none
    }
    let e = this.table[int(h % u64(cacheSlots))]
    if (e.version != this.version || e.hash != h) {
      return this.none
    }
    return e
  }

  // The current entry for `s`, or `none`.
  find(s: Subject): RuleSet<A> {
    this.mu.lock()
    let i = this.kindAt(s)
    let e = this.entryAt(i, this.hashAt(i, s))
    this.mu.unlock()
    if (e.built && e.kind.same(e.held, s)) {
      return e
    }
    return this.none
  }

  // Under `mu`: an empty slot of `set` for (`cls`, `action`); `fillSlot`
  // gives it its rules.
  emptySlot(set: RuleSet<A>, cls: string, action: A): RuleSlot<A> {
    let m = this.miss
    return RuleSlot<A>{
      set = set, className = cls, action = action, names = namesFor(set.reg.cols, cls),
      rules = m.rules, at = m.at, decs = m.decs, none = this.noAllow,
    }
  }

  // Under `mu`: an empty slot of a new, unbuilt set for a subject of kind
  // `i` with hash `h`, made under the current version and registry.
  fresh(i: int, h: u64, cls: string, action: A): RuleSlot<A> {
    let n = this.none
    let k = n.kind
    if (i >= 0) {
      k = this.kinds[i]
    }
    let set = RuleSet<A>{
      version = this.version, hash = h, kind = k, held = n.held, reg = this.reg, built = false,
      rules = n.rules, skipped = n.skipped, clean = true, slots = []RuleSlot<A>(0, 1),
    }
    return this.emptySlot(set, cls, action)
  }

  // A check's first locked section: the slot for (`cls`, `action`) in the
  // current entry with `s`'s hash, built on first use, else an empty slot of
  // a new set for `s` (`built` false). The caller confirms a built entry
  // holds `s`'s value with `same`.
  lookup(s: Subject, cls: string, action: A, wildcard: bool): RuleSlot<A> {
    this.mu.lock()
    let i = this.kindAt(s)
    let h = this.hashAt(i, s)
    let e = this.entryAt(i, h)
    let sl = this.miss
    if (e.version >= 0) {
      sl = this.slotAt(e, cls, action, wildcard)
    } else {
      sl = this.fresh(i, h, cls, action)
    }
    this.mu.unlock()
    return sl
  }

  // `lookup`'s miss alone, for a subject whose hash an entry of another
  // value holds.
  missFor(s: Subject, cls: string, action: A): RuleSlot<A> {
    this.mu.lock()
    let i = this.kindAt(s)
    let sl = this.fresh(i, this.hashAt(i, s), cls, action)
    this.mu.unlock()
    return sl
  }

  // `lookup` for the guest: its slot while its set is current, else an empty
  // slot of a new set holding the published guest rules.
  guestSlot(cls: string, action: A, wildcard: bool): RuleSlot<A> {
    this.mu.lock()
    let sl = this.miss
    if (this.guest.version == this.version) {
      sl = this.slotAt(this.guest, cls, action, wildcard)
    } else {
      sl = this.fresh(-1, 0, cls, action)
      sl.set.rules = this.reg.guest
    }
    this.mu.unlock()
    return sl
  }

  // Under `mu`: checks the rules of `sl.set` and adds `sl` to it.
  addLocked(sl: RuleSlot<A>, st: DecideState<A>) {
    let set = sl.set
    set.clean = st.allValidLocked(set.reg.resources, set.rules)
    set.slots = append(set.slots, sl)
  }

  // A miss's second locked section: checks the rules of `sl.set`, adds `sl`
  // to it and, when `keep`, stores it unless a registration made it stale.
  commit(sl: RuleSlot<A>, st: DecideState<A>, keep: bool) {
    let set = sl.set
    this.mu.lock()
    this.addLocked(sl, st)
    if (keep && set.version == this.version) {
      this.table[int(set.hash % u64(cacheSlots))] = set
    }
    this.mu.unlock()
  }

  // `commit` for the guest's set.
  commitGuest(sl: RuleSlot<A>, st: DecideState<A>) {
    this.mu.lock()
    this.addLocked(sl, st)
    if (sl.set.version == this.version) {
      this.guest = sl.set
    }
    this.mu.unlock()
  }

  // Under `mu`: the slot of `set` for (`cls`, `action`), built the first
  // time it is asked. The action is compared as a value: its name is read
  // only to build.
  slotAt(set: RuleSet<A>, cls: string, action: A, wildcard: bool): RuleSlot<A> {
    for sl of set.slots {
      if (sl.action == action && sl.className == cls) {
        return sl
      }
    }
    let sl = this.emptySlot(set, cls, action)
    fillSlot<A>(sl, wildcard)
    set.slots = append(set.slots, sl)
    return sl
  }
}

// Builds the set of `sl`, made by a miss for `s`, from the registry it was
// made under, outside the lock, and commits it; it is kept when `s`'s class
// can be a key.
fn buildFor<A: ActionEnum>(a: Authz<A>, sl: RuleSlot<A>, s: Subject): RuleSlot<A> {
  let set = sl.set
  let keep = set.kind.owns(s)
  if (keep) {
    set.held = set.kind.freeze(s)
  }
  let got = resolveRoles<A>(set.reg.roles, s, set.held, keep)
  set.rules = got.rules
  set.skipped = got.skipped
  set.built = true
  fillSlot<A>(sl, a.wildcard)
  a.state.cache.commit(sl, a.state, keep && !got.live)
  return sl
}

// The slot of (`cls`, `action`) in `user`'s rules, and through it the rules:
// one locked `lookup` when they are cached, else built by `buildFor` (the
// guest's are the ones its role published) with one more.
fn slotFor<A: ActionEnum>(a: Authz<A>, user: Option<Subject>, cls: string, action: A): RuleSlot<A> {
  let c = a.state.cache
  if (!isSome(user)) {
    let g = c.guestSlot(cls, action, a.wildcard)
    if (!g.set.built) {
      g.set.built = true
      fillSlot<A>(g, a.wildcard)
      c.commitGuest(g, a.state)
    }
    return g
  }
  let s = unwrap(user)
  let sl = c.lookup(s, cls, action, a.wildcard)
  let e = sl.set
  if (!e.built) {
    return buildFor<A>(a, sl, s)
  }
  if (e.kind.same(e.held, s)) {
    return sl
  }
  return buildFor<A>(a, c.missFor(s, cls, action), s)
}

// The rules of `user`: the cached set for a subject of the same value, else
// the set a check of (no class, the first action) builds.
fn ruleSetOf<A: ActionEnum>(a: Authz<A>, user: Option<Subject>): RuleSet<A> {
  if (isSome(user)) {
    let hit = a.state.cache.find(unwrap(user))
    if (hit.built) {
      return hit
    }
  }
  let act: A
  return slotFor<A>(a, user, "", act).set
}
