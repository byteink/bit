// pkg/authz/filter.test.bit — `filterFor` against `can`, row by row: 12 rule
// sets x 6 rows (NULL columns among them), the All/None shortcuts, the guest,
// a code function anywhere in the matching set, and Known.

import { contains } from "std/strings"

@table class FtDoc {
  @id
  id: i64
  authorId: string
  status: string
  views: i64
  note: Option<string>
}

class FtUser {
  export id: string,
  export roles: []string,
  export team: string,
}

fn ftS(text: string): Value {
  return Value.Text(text)
}

fn ftDoc(id: i64, author: string, status: string, views: i64, note: Option<string>): FtDoc {
  return FtDoc{ id = id, authorId = author, status = status, views = views, note = note }
}

fn ftRows(): []FtDoc {
  return [
    ftDoc(1, "sara", "published", 5, Option<string>.None),
    ftDoc(2, "sara", "archived", 50, Option<string>.Some("x")),
    ftDoc(3, "bob", "published", 200, Option<string>.Some("n")),
    ftDoc(4, "bob", "archived", 0, Option<string>.None),
    ftDoc(5, "sara", "draft", 11, Option<string>.Some("n")),
    ftDoc(6, "eve", "draft", 7, Option<string>.Some("x")),
  ]
}

fn ftMine(user: FtUser): Cond {
  return eq("authorId", ftS(user.id))
}

fn ftNoteIs(text: string): Cond {
  return eq("note", ftS(text))
}

// The 12 rule sets, each one policy named for its position.
fn ftPolicies(): []Policy<FtUser, Action> {
  return [
    Policy("Set1", (p, user) => {
      p.can<FtDoc>([Action.Read], ftMine(user))
    }),
    Policy("Set2", (p, user) => {
      p.can<FtDoc>([Action.Read], ftMine(user))
      p.can<FtDoc>([Action.Read], eq("status", ftS("published")))
    }),
    Policy("Set3", (p, user) => {
      p.can<FtDoc>([Action.Read])
      p.cannot<FtDoc>([Action.Read], eq("status", ftS("archived")))
    }),
    Policy("Set4", (p, user) => {
      p.can<FtDoc>([Action.Read], ftMine(user))
      p.cannot<FtDoc>([Action.Read], ftNoteIs("x"))
    }),
    Policy("Set5", (p, user) => {
      p.can<FtDoc>([Action.Read], ftNoteIs("n"))
    }),
    Policy("Set6", (p, user) => {
      p.can<FtDoc>([Action.Read], gt("views", Value.Int(10)))
      p.cannot<FtDoc>([Action.Read], lt("views", Value.Int(100)))
    }),
    Policy("Set7", (p, user) => {
      p.can<FtDoc>([Action.Read], Cond.Cmp("authorId", Op.Eq, [operandOf("$user.id")]))
      p.cannot<FtDoc>([Action.Read], Cond.Cmp("status", Op.Eq, [operandOf("$user.team")]))
    }),
    Policy("Set8", (p, user) => {
      p.can<FtDoc>([Action.Read], oneOf("status", [ftS("draft"), ftS("archived")]))
      p.cannot<FtDoc>([Action.Read], not(ftNoteIs("x")))
    }),
    Policy("Set9", (p, user) => {
      let late = or([gt("views", Value.Int(5)), ftNoteIs("n")])
      p.can<FtDoc>([Action.Read], and([ftMine(user), late]))
    }),
    Policy("Set10", (p, user) => {
      p.can<FtDoc>([Action.Manage], eq("views", Value.Int(0)))
      p.can<FtDoc>([Action.Read], ne("note", ftS("x")))
      p.cannot<FtDoc>([Action.Read], eq("authorId", ftS("bob")))
    }),
    Policy("Set11", (p, user) => {
      p.can<FtDoc>([Action.Read], not(ftNoteIs("x")))
      p.cannot<FtDoc>([Action.Update], Cond.True)
    }),
    Policy("Set12", (p, user) => {
      p.canAll([Action.Read])
      p.cannot<FtDoc>([Action.Read], ftNoteIs("n"))
      p.cannot<FtDoc>([Action.Read], eq("views", Value.Int(200)))
    }),
  ]
}

fn ftAuthzOf(roles: []string, policies: []Policy<FtUser, Action>): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<FtDoc>() catch e {
    panic("resource: ${e.message()}")
  }
  let i = 0
  while (i < len(roles)) {
    let _ = a.role<FtUser>(roles[i], [policies[i]]) catch e {
      panic("role ${roles[i]}: ${e.message()}")
    }
    i = i + 1
  }
  return a
}

fn ftRoleNames(n: int): []string {
  let out = []string(0)
  let i = 1
  while (i <= n) {
    out = append(out, "set${i}")
    i = i + 1
  }
  return out
}

fn ftAuthz(): Authz<Action> {
  return ftAuthzOf(ftRoleNames(12), ftPolicies())
}

// A one-role authz whose role is `r`, built from one policy.
fn ftOne(name: string, body: (Rules<Action>, FtUser) => ()): Authz<Action> {
  return ftAuthzOf(["r"], [Policy<FtUser, Action>(name, body)])
}

fn ftUser(roles: []string): Option<Subject> {
  return Option<Subject>.Some(FtUser{ id = "sara", roles = roles, team = "archived" })
}

fn ftFilter(a: Authz<Action>, u: Option<Subject>, act: Action): Filter {
  return a.filterFor<FtDoc>(u, act) catch e {
    panic("filterFor: ${e.message()}")
  }
}

fn ftEval(c: Cond, row: FtDoc): Truth {
  return evalCond<FtDoc>(c, row) catch e {
    panic("evalCond: ${e.message()}")
  }
}

// Whether `f` keeps `row`.
fn ftKeeps(f: Filter, row: FtDoc): bool {
  return match (f) {
    All => true
    None => false
    Where(c) => isTrueTruth(ftEval(c, row))
  }
}

fn ftIsAll(f: Filter): bool {
  return match (f) {
    All => true
    _ => false
  }
}

fn ftIsNone(f: Filter): bool {
  return match (f) {
    None => true
    _ => false
  }
}

test "72 of 72 row verdicts of filterFor equal can" {
  let a = ftAuthz()
  let agree = 0
  let n = 1
  while (n <= 12) {
    let u = ftUser(["set${n}"])
    let f = ftFilter(a, u, Action.Read)
    for r of ftRows() {
      let want = a.can<FtDoc>(u, Action.Read, r)
      assert(ftKeeps(f, r) == want, "set ${n} row ${r.id}: filter ${ftKeeps(f, r)}, can ${want}")
      agree = agree + 1
    }
    n = n + 1
  }
  assert(agree == 72, "compared ${agree}")
}

test "the verdicts are not all one answer" {
  let a = ftAuthz()
  let yes = 0
  let no = 0
  let n = 1
  while (n <= 12) {
    for r of ftRows() {
      if (a.can<FtDoc>(ftUser(["set${n}"]), Action.Read, r)) {
        yes = yes + 1
      } else {
        no = no + 1
      }
    }
    n = n + 1
  }
  assert(yes > 10 && no > 10, "yes ${yes} no ${no}")
}

test "All and None shortcuts hit in 4 of 4 constructed cases" {
  let u = ftUser(["r"])
  let none = ftOne("Nothing", (p, user) => {})
  assert(ftIsNone(ftFilter(none, u, Action.Read)), "no rule: None")
  let all = ftOne("Everything", (p, user) => {
    p.canAll([Action.Read])
  })
  assert(ftIsAll(ftFilter(all, u, Action.Read)), "allow True: All")
  let denied = ftOne("Denied", (p, user) => {
    p.canAll([Action.Read])
    p.cannotAll([Action.Read])
  })
  assert(ftIsNone(ftFilter(denied, u, Action.Read)), "deny True: None")
  let falseDeny = ftOne("NeverDenies", (p, user) => {
    p.canAll([Action.Read])
    p.cannot<FtDoc>([Action.Read], Cond.False)
  })
  assert(ftIsAll(ftFilter(falseDeny, u, Action.Read)), "deny False: All")
}

test "an action no rule names, and the guest" {
  let a = ftAuthz()
  assert(ftIsNone(ftFilter(a, ftUser(["set1"]), Action.Delete)), "Delete: None")
  assert(ftIsNone(ftFilter(a, Option<Subject>.None, Action.Read)), "no guest role: None")
  let g = ftAuthzOf(["guest"], [ftPolicies()[2]])
  let f = ftFilter(g, Option<Subject>.None, Action.Read)
  for r of ftRows() {
    assert(ftKeeps(f, r) == g.can<FtDoc>(Option<Subject>.None, Action.Read, r), "guest row ${r.id}")
  }
  assert(!ftIsAll(f) && !ftIsNone(f), "the guest gets a condition")
}

test "a user with two roles gets both roles' rules" {
  let a = ftAuthz()
  let u = ftUser(["set1", "set5"])
  let f = ftFilter(a, u, Action.Read)
  for r of ftRows() {
    assert(ftKeeps(f, r) == a.can<FtDoc>(u, Action.Read, r), "row ${r.id}")
  }
}

test "a second call for the same subject gives the same filter" {
  let a = ftAuthz()
  let u = ftUser(["set6"])
  let first = ftFilter(a, u, Action.Read)
  let second = ftFilter(a, u, Action.Read)
  for r of ftRows() {
    assert(ftKeeps(first, r) == ftKeeps(second, r), "row ${r.id}")
  }
}

// "policy/label" of the NotFilterable a `filterFor` over `a` fails with, "" when it answers.
fn ftRefused(a: Authz<Action>): string {
  let got = ""
  a.filterFor<FtDoc>(ftUser(["r"]), Action.Read) catch e {
    let (nf, ok) = e.(NotFilterable)
    assert(ok, "not a NotFilterable: ${e.message()}")
    got = "${nf.policy}/${nf.label}"
  }
  return got
}

test "Custom anywhere in the matching set is NotFilterable in 3 of 3 cases" {
  let alone = ftRefused(
    ftOne("Window", (p, user) => {
      p.canIf<FtDoc>([Action.Read], "Open", (d: FtDoc) => true)
    }),
  )
  assert(alone == "Window/Open", "alone: ${alone}")
  let beside = ftRefused(
    ftOne("Both", (p, user) => {
      p.canAll([Action.Read])
      p.canIf<FtDoc>([Action.Read], "Late", (d: FtDoc) => true)
    }),
  )
  assert(beside == "Both/Late", "beside an allow-all: ${beside}")
  let deny = ftRefused(
    ftOne("Ban", (p, user) => {
      p.can<FtDoc>([Action.Read], eq("authorId", ftS("sara")))
      p.cannot<FtDoc>(
        [Action.Read],
        and([eq("status", ftS("draft")), custom<FtDoc>("Locked", (d: FtDoc) => true)]),
      )
    }),
  )
  assert(deny == "Ban/Locked", "in a deny: ${deny}")
}

test "a Custom on another action does not refuse" {
  let a = ftOne("Elsewhere", (p, user) => {
    p.can<FtDoc>([Action.Read], eq("authorId", ftS("sara")))
    p.canIf<FtDoc>([Action.Update], "Open", (d: FtDoc) => true)
  })
  let f = ftFilter(a, ftUser(["r"]), Action.Read)
  assert(!ftIsAll(f) && !ftIsNone(f), "a condition")
}

test "Known is true only for true" {
  let row = ftRows()[0]
  let unknown = ftNoteIs("x")
  assert(ftEval(unknown, row) == Truth.Unknown, "premise: unknown")
  assert(ftEval(Cond.Known(unknown), row) == Truth.False, "Known(unknown) is false")
  assert(ftEval(Cond.Not(Cond.Known(unknown)), row) == Truth.True, "Not(Known(unknown)) is true")
  assert(ftEval(Cond.Known(eq("status", ftS("published"))), row) == Truth.True, "Known(true)")
  assert(ftEval(Cond.Known(eq("status", ftS("draft"))), row) == Truth.False, "Known(false)")
}

test "a filter compiles with compileSql" {
  let a = ftAuthz()
  let f = ftFilter(a, ftUser(["set4"]), Action.Read)
  match (f) {
    Where(c) => {
      let info = ResourceInfo{ name = "FtDoc", table = "ft_docs", columns = FtDoc.__columns() }
      let sql = compileSql(c, info, ServerDialect.Postgres, 1) catch e {
        panic("compileSql: ${e.message()}")
      }
      assert(contains(sql.sql, "COALESCE(("), sql.sql)
      assert(contains(sql.sql, "NOT COALESCE"), sql.sql)
    }
    _ => panic("set 4 should be a condition")
  }
}
