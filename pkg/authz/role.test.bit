// pkg/authz/role.test.bit — roles: registering, naming, and what a subject's
// roles resolve to.

import { join, repeat } from "std/strings"

@table class RlArticle {
  @id
  id: i64
  authorId: string
  status: string
}

class RlUser {
  export id: string,
  export roles: []string,
}

class RlRobot {
  export id: string,
  export roles: []string,
}

fn rlAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<RlArticle>() catch e {
    panic("resource: ${e.message()}")
  }
  return a
}

fn rlReadPublished(): Policy<RlUser, Action> {
  return Policy("ReadPublished", (p, user) => {
    p.can<RlArticle>([Action.Read], eq("status", Value.Text("published")))
  })
}

fn rlEditOwn(): Policy<RlUser, Action> {
  return Policy("EditOwn", (p, user) => {
    p.can<RlArticle>([Action.Read, Action.Update], eq("authorId", Value.Text(user.id)))
    p.cannot<RlArticle>([Action.Update], eq("status", Value.Text("archived")))
  })
}

fn rlManageAll(): Policy<RlUser, Action> {
  return Policy("ManageAll", (p, user) => {
    p.canAll([Action.Manage])
  })
}

// The three roles of the design sketch, registered in a row.
fn rlThreeRoles(): Authz<Action> {
  let a = rlAuthz()
  let _ = a.role<RlUser>("reader", [rlReadPublished()]) catch e {
    panic("reader: ${e.message()}")
  }
  let _ = a.role<RlUser>("author", [rlReadPublished(), rlEditOwn()]) catch e {
    panic("author: ${e.message()}")
  }
  let _ = a.role<RlUser>("admin", [rlManageAll()]) catch e {
    panic("admin: ${e.message()}")
  }
  return a
}

fn rlUser(roles: []string): RlUser {
  return RlUser{ id = "sara", roles = roles }
}

// The message `role` fails with for `name` and `p`, or "" when it accepts.
fn rlFaultOf(a: Authz<Action>, name: string, p: Policy<RlUser, Action>): string {
  let _ = a.role<RlUser>(name, [p]) catch e {
    return e.message()
  }
  return ""
}

fn rlFault(a: Authz<Action>, name: string): string {
  return rlFaultOf(a, name, rlReadPublished())
}

fn rlLines(list: []string): string {
  return join(list, "; ")
}

test "the 3 roles of the sketch register, listed sorted" {
  let names = rlThreeRoles().roleNames()
  assert(len(names) == 3, "roles: ${len(names)} of 3")
  assert(
    names[0] == "admin" && names[1] == "author" && names[2] == "reader",
    "order: ${rlLines(names)}",
  )
}

test "a role defined twice is refused and the first stays" {
  let a = rlThreeRoles()
  assert(rlFault(a, "author") == "invalid policy: role author defined twice", rlFault(a, "author"))
  assert(len(a.roleNames()) == 3, "roles: ${len(a.roleNames())} of 3")
}

test "names outside [A-Za-z0-9_.-]{1,64} are refused, 5 of 5" {
  let a = rlAuthz()
  assert(hasPrefix(rlFault(a, ""), "invalid policy: role name must be 1 to 64"), rlFault(a, ""))
  assert(hasPrefix(rlFault(a, "a b"), "invalid policy: role a b: character 1"), rlFault(a, "a b"))
  assert(hasPrefix(rlFault(a, "ré"), "invalid policy: role ré: character 1"), rlFault(a, "ré"))
  assert(hasPrefix(rlFault(a, "x:y"), "invalid policy: role x:y: character 1"), rlFault(a, "x:y"))
  let long = repeat("a", 65)
  assert(
    hasPrefix(rlFault(a, long), "invalid policy: role name must be 1 to 64"),
    "65 chars accepted",
  )
  assert(len(a.roleNames()) == 0, "a refused role was stored")
}

test "names at the edge are accepted: guest, 64 characters, every punctuation" {
  let a = rlAuthz()
  assert(rlFault(a, "guest") == "", rlFault(a, "guest"))
  assert(rlFault(a, repeat("a", 64)) == "", "64 chars refused")
  assert(rlFault(a, "Org_1.admin-2") == "", rlFault(a, "Org_1.admin-2"))
}

test "a role's policies are validated at registration, naming policy and rule" {
  let a = rlAuthz()
  let bad = Policy<RlUser, Action>("Typo", (p, user) => {
    p.can<RlArticle>([Action.Read], eq("owner", Value.Text(user.id)))
  })
  let msg = rlFaultOf(a, "editor", bad)
  assert(hasPrefix(msg, "invalid policy: policy Typo rule 0: no field owner"), msg)
  assert(len(a.roleNames()) == 0, "a role with a bad policy was stored")
}

test "roles reader and author resolve to the union, readPublished once" {
  let r = rlThreeRoles().rolesOf(rlUser(["reader", "author"]))
  assert(len(r.rules) == 3, "rules: ${len(r.rules)} of 3")
  assert(r.rules[0].policy == "ReadPublished", r.rules[0].policy)
  assert(r.rules[1].policy == "EditOwn" && r.rules[2].policy == "EditOwn", "order lost")
  assert(len(r.skipped) == 0, "skipped: ${rlLines(r.skipped)}")
}

test "a role nothing defines adds no rules and a logged line" {
  let r = rlThreeRoles().rolesOf(rlUser(["ghost", "reader"]))
  assert(len(r.rules) == 1, "rules: ${len(r.rules)} of 1")
  assert(
    len(r.skipped) == 1 && r.skipped[0] == "role ghost is not defined",
    "skipped: ${rlLines(r.skipped)}",
  )
}

test "a subject that is not the policy's class gets 0 rules and a logged reason" {
  let robot = RlRobot{ id = "r2", roles = ["author"] }
  let r = rlThreeRoles().rolesOf(robot)
  assert(len(r.rules) == 0, "rules: ${len(r.rules)} of 0")
  assert(len(r.skipped) == 2, "skipped: ${len(r.skipped)} of 2")
  assert(
    r.skipped[0] == "policy ReadPublished (role author) is for another subject class",
    r.skipped[0],
  )
}

test "checkRoles names the first unknown role" {
  let a = rlThreeRoles()
  a.checkRoles(["reader", "admin"]) catch e {
    assert(false, e.message())
  }
  let msg = ""
  a.checkRoles(["reader", "editor"]) catch e {
    msg = e.message()
  }
  assert(msg == "invalid policy: unknown role editor (defined: admin, author, reader)", msg)
}

test "a subject with no roles resolves to nothing" {
  let r = rlThreeRoles().rolesOf(rlUser([]string(0)))
  assert(len(r.rules) == 0 && len(r.skipped) == 0, "rules or skipped for no roles")
}
