// pkg/authz/cellex.bit — the lexer for the CEL subset a stored policy
// condition may use (design D4: optional CEL text, parsed into the same tree
// as a code policy, and only the part that can become a SQL filter; anything
// else is refused when the policy is saved). CEL is the Common Expression
// Language, defined in the language definition of github.com/google/cel-spec.
//
// What is lexed: string literals, decimal integers, floats, `true` / `false`
// / `null`, identifiers, the operators `== != < <= > >= && || ! in`,
// parentheses, list brackets, `,` and `.`, and `//` comments to the end of
// the line. The arithmetic operators `+ - * / %`, the ternary `? :` and the
// braces of a map literal are lexed too, as `Op` tokens, so the parser (cel.bit)
// can refuse each by name; the lexer itself never judges them. Everything else
// is an error that names its byte offset: `cel: unexpected character '#' at
// byte 14`. That includes hexadecimal and `u`-suffixed integers, raw strings,
// triple-quoted strings and bytes literals; the last four say "not supported"
// rather than "unexpected".
//
// The input is an admin's text, so the lexer is bounded before it is clever:
// at most 4096 bytes and 512 tokens, each an InvalidPolicy. It is one pass
// over the bytes and never panics: every read goes through `byteAt`, which
// yields 0 past the end, and every slice is cut between two positions the scan
// has already checked. A string literal with no escape is a slice of the
// source; only one with an escape is rebuilt, through a `Builder`.
//
// Offsets are byte offsets into `src`, `[start, end)`. The error offset is
// the first byte that is wrong, or for a literal that never closes, the byte
// that opened it.

import { Builder, isValidUtf8, parseInt } from "std/strings"

// One CEL token. `in` is the operator `Op("in")`; `true`, `false` and `null`
// are `Bool` and `Null`, never identifiers.
export enum CelTok {
  Ident(string),
  Str(string),
  Int(i64),
  Float(f64),
  Bool(bool),
  Null,
  Op(string),
  LParen,
  RParen,
  LBracket,
  RBracket,
  Comma,
  Dot,
  Eof,
}

// A token and the `[start, end)` bytes of the source it came from. The last
// token of every successful lex is `Eof`, with `start == end == len(src)`.
export class CelSpanTok { export tok: CelTok, export start: int, export end: int }

// The two admin-input bounds. `Eof` is not counted against the token limit.
const celMaxBytes: int = 4096
const celMaxTokens: int = 512

const hexDigits: string = "0123456789abcdef"

fn celErr(msg: string, at: int): InvalidPolicy {
  return InvalidPolicy{ detail = "cel: ${msg} at byte ${at}" }
}

// `s[i]`, or 0 when `i` is past the end. The one way the lexer looks ahead.
fn byteAt(s: string, i: int): u8 {
  if (i >= len(s)) {
    return 0
  }
  return s[i]
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isIdentStart(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn isIdentChar(c: u8): bool {
  return isIdentStart(c) || isDigit(c)
}

fn isSpace(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 12
}

// The value of one hex digit, -1 for any other byte.
fn hexVal(c: u8): int {
  if (isDigit(c)) {
    return int(c - '0')
  }
  let l = c | 0x20
  if (l >= 'a' && l <= 'f') {
    return int(l - 'a') + 10
  }
  return -1
}

// A byte as it appears in an error: printable ASCII as itself, anything else
// as `\xNN`, so an admin's control byte cannot forge a log line.
fn showByte(src: string, at: int): string {
  let c = byteAt(src, at)
  if (c >= 0x20 && c < 0x7f) {
    return src[at:at + 1]
  }
  let v = int(c)
  return "\\x" + hexDigits[v / 16:v / 16 + 1] + hexDigits[v % 16:v % 16 + 1]
}

// The byte a one-character escape (`\n`) stands for, -1 when `c` is not one.
fn escByte(c: u8): int {
  if (c == 'n') {
    return 10
  }
  if (c == 't') {
    return 9
  }
  if (c == '\\' || c == '\'' || c == '"') {
    return int(c)
  }
  return -1
}

// The UTF-8 bytes of `cp`, at most U+FFFF and no surrogate (a `\uXXXX` is
// four hex digits). There is no rune-to-string conversion yet (SPEC §12.9).
fn appendUtf8(b: Builder, cp: int) {
  if (cp < 0x80) {
    b.writeByte(u8(cp))
  } else if (cp < 0x800) {
    b.writeByte(u8(0xC0 | (cp >> 6)))
    b.writeByte(u8(0x80 | (cp & 0x3F)))
  } else {
    b.writeByte(u8(0xE0 | (cp >> 12)))
    b.writeByte(u8(0x80 | ((cp >> 6) & 0x3F)))
    b.writeByte(u8(0x80 | (cp & 0x3F)))
  }
}

// `\uXXXX` at `src[i:i+6]` appended to `b` as UTF-8; the index after it. A
// surrogate is not a code point, so it is refused.
fn decodeU(b: Builder, src: string, i: int): int! {
  let cp = 0
  let k = 0
  while (k < 4) {
    let h = hexVal(byteAt(src, i + 2 + k))
    if (h < 0) {
      fail celErr("invalid \\u escape", i)
    }
    cp = cp * 16 + h
    k = k + 1
  }
  if (cp >= 0xD800 && cp <= 0xDFFF) {
    fail celErr("invalid unicode code point in \\u escape", i)
  }
  appendUtf8(b, cp)
  return i + 6
}

// The escape starting at the backslash `src[i]`, appended to `b`; the index
// after it.
fn decodeEsc(b: Builder, src: string, i: int): int! {
  let c = byteAt(src, i + 1)
  if (c == 'u') {
    return decodeU(b, src, i)?
  }
  let v = escByte(c)
  if (v < 0) {
    fail celErr("invalid escape sequence", i)
  }
  b.writeByte(u8(v))
  return i + 2
}

// The text of a literal body `src[from:to]` that holds at least one escape.
fn decodeStr(src: string, from: int, to: int): string! {
  let b = Builder()
  let seg = from
  let i = from
  while (i < to) {
    if (src[i] == '\\') {
      b.write(src[seg:i])
      i = decodeEsc(b, src, i)?
      seg = i
    } else {
      i = i + 1
    }
  }
  b.write(src[seg:to])
  return b.toString()
}

// The operator the two bytes `c d` start with when `d` is `=`.
fn eqOp(c: u8): string {
  if (c == '=') {
    return "=="
  }
  if (c == '!') {
    return "!="
  }
  if (c == '<') {
    return "<="
  }
  if (c == '>') {
    return ">="
  }
  return ""
}

// The two-byte operator `c d` spells, "" when it is not one.
fn pairOp(c: u8, d: u8): string {
  if (d == '=') {
    return eqOp(c)
  }
  if (c == '&' && d == '&') {
    return "&&"
  }
  if (c == '|' && d == '|') {
    return "||"
  }
  return ""
}

// The bytes that are an operator or punctuation on their own. `!`, `<` and `>`
// are CEL operators; the rest are lexed so the parser can name what it refuses.
const singleOps: string = "!<>+-*/%?:{}"

// The one-byte operator `c` is, "" when it is not one.
fn singleOp(c: u8): string {
  let i = 0
  while (i < len(singleOps)) {
    if (singleOps[i] == c) {
      return singleOps[i:i + 1]
    }
    i = i + 1
  }
  return ""
}

// The keyword a word is, or an identifier.
fn wordTok(w: string): CelTok {
  if (w == "true") {
    return CelTok.Bool(true)
  }
  if (w == "false") {
    return CelTok.Bool(false)
  }
  if (w == "null") {
    return CelTok.Null
  }
  if (w == "in") {
    return CelTok.Op("in")
  }
  return CelTok.Ident(w)
}

// Whether `a b` are the two letters of a bytes / raw prefix: `br`, `rb`, in
// either case.
fn isPrefixPair(a: u8, b: u8): bool {
  let x = a | 0x20
  let y = b | 0x20
  return (x == 'b' && y == 'r') || (x == 'r' && y == 'b')
}

// Whether the word `src[start:end]` is a string prefix (`b`, `r`, `br`, `rb`,
// any case) that the quote after it would attach to.
fn isStringPrefix(src: string, start: int, end: int): bool {
  let n = end - start
  if (n == 1) {
    let x = src[start] | 0x20
    return x == 'b' || x == 'r'
  }
  return n == 2 && isPrefixPair(src[start], src[start + 1])
}

// The index after the digits that start at `i`.
fn skipDigits(src: string, i: int): int {
  let j = i
  while (isDigit(byteAt(src, j))) {
    j = j + 1
  }
  return j
}

// The index after a `.digits` fraction at `i`, `i` itself when there is none.
// `1.` and `a.b` keep their dot as a token.
fn fracEnd(src: string, i: int): int {
  if (byteAt(src, i) == '.' && isDigit(byteAt(src, i + 1))) {
    return skipDigits(src, i + 1)
  }
  return i
}

// The index after an `e[+-]digits` exponent at `i`, `i` itself when there is
// none; `1e` leaves the `e` to be reported as unexpected.
fn expEnd(src: string, i: int): int {
  if ((byteAt(src, i) | 0x20) != 'e') {
    return i
  }
  let j = i + 1
  if (byteAt(src, j) == '+' || byteAt(src, j) == '-') {
    j = j + 1
  }
  if (!isDigit(byteAt(src, j))) {
    return i
  }
  return skipDigits(src, j)
}

// One lex in progress. `push` is the only thing that moves `pos`.
class CelLexer {
  src: string
  pos: int
  toks: []CelSpanTok

  init(src: string) {
    this.src = src
    this.pos = 0
    this.toks = []CelSpanTok(0, 16)
  }

  unexpected(at: int): InvalidPolicy {
    return celErr("unexpected character '${showByte(this.src, at)}'", at)
  }

  // Appends the token and moves `pos` to its end.
  push(tok: CelTok, start: int, end: int): ()! {
    if (len(this.toks) >= celMaxTokens) {
      fail celErr("more than ${celMaxTokens} tokens", start)
    }
    this.toks = append(this.toks, CelSpanTok{ tok = tok, start = start, end = end })
    this.pos = end
  }

  // Moves `pos` past blanks and `//` comments; the new `pos`.
  skipSpace(): int {
    while (this.pos < len(this.src)) {
      let c = this.src[this.pos]
      if (c == '/' && byteAt(this.src, this.pos + 1) == '/') {
        this.skipComment()
      } else if (isSpace(c)) {
        this.pos = this.pos + 1
      } else {
        break
      }
    }
    return this.pos
  }

  // Moves `pos` to the newline that ends the comment at `pos`, or the end.
  skipComment() {
    while (this.pos < len(this.src) && this.src[this.pos] != '\n') {
      this.pos = this.pos + 1
    }
  }

  word(): ()! {
    let start = this.pos
    let i = start + 1
    while (isIdentChar(byteAt(this.src, i))) {
      i = i + 1
    }
    let q = byteAt(this.src, i)
    if ((q == '"' || q == '\'') && isStringPrefix(this.src, start, i)) {
      fail celErr("bytes and raw string literals are not supported", start)
    }
    this.push(wordTok(this.src[start:i]), start, i)?
  }

  // What may follow a number: not a letter, digit or underscore.
  checkNumTail(end: int, isFloat: bool): ()! {
    let c = byteAt(this.src, end)
    if (!isIdentChar(c)) {
      return
    }
    if (!isFloat && (c == 'u' || c == 'U')) {
      fail celErr("unsigned integer literals are not supported", end)
    }
    fail this.unexpected(end)
  }

  number(): ()! {
    let start = this.pos
    if (byteAt(this.src, start) == '0' && (byteAt(this.src, start + 1) | 0x20) == 'x') {
      fail celErr("hexadecimal integers are not supported", start)
    }
    let intEnd = skipDigits(this.src, start)
    let end = expEnd(this.src, fracEnd(this.src, intEnd))
    let isFloat = end != intEnd
    this.checkNumTail(end, isFloat)?
    let text = this.src[start:end]
    if (isFloat) {
      let f = parseFloat(text)
      if (f != f || f > 1.7976931348623157e308) {
        fail celErr("float out of range", start)
      }
      this.push(CelTok.Float(f), start, end)?
      return
    }
    let v = parseInt(text) catch _ {
      fail celErr("integer out of range", start)
    }
    this.push(CelTok.Int(i64(v)), start, end)?
  }

  str(): ()! {
    let start = this.pos
    let q = this.src[start]
    if (byteAt(this.src, start + 1) == q && byteAt(this.src, start + 2) == q) {
      fail celErr("triple-quoted strings are not supported", start)
    }
    let i = start + 1
    let hasEsc = false
    while (i < len(this.src) && this.src[i] != q && this.src[i] != '\n' && this.src[i] != '\r') {
      if (this.src[i] == '\\') {
        hasEsc = true
        i = i + 1
      }
      i = i + 1
    }
    if (byteAt(this.src, i) != q) {
      fail celErr("unterminated string", start)
    }
    let value = this.src[start + 1:i]
    if (hasEsc) {
      value = decodeStr(this.src, start + 1, i)?
    }
    if (!isValidUtf8(value)) {
      fail celErr("invalid UTF-8 in string", start)
    }
    this.push(CelTok.Str(value), start, i + 1)?
  }

  // Pushes the one-byte bracket, comma or dot `c` at `p`; false when `c` is
  // none of them.
  delim(c: u8, p: int): bool! {
    let tok = CelTok.Eof
    if (c == '(') {
      tok = CelTok.LParen
    } else if (c == ')') {
      tok = CelTok.RParen
    } else if (c == '[') {
      tok = CelTok.LBracket
    } else if (c == ']') {
      tok = CelTok.RBracket
    } else if (c == ',') {
      tok = CelTok.Comma
    } else if (c == '.') {
      tok = CelTok.Dot
    } else {
      return false
    }
    this.push(tok, p, p + 1)?
    return true
  }

  // An operator, bracket, comma or dot; anything else is an error.
  symbol(): ()! {
    let p = this.pos
    let c = this.src[p]
    let op = pairOp(c, byteAt(this.src, p + 1))
    if (op == "") {
      op = singleOp(c)
    }
    if (op != "") {
      this.push(CelTok.Op(op), p, p + len(op))?
      return
    }
    if (this.delim(c, p)?) {
      return
    }
    fail this.unexpected(p)
  }

  // The next token, `pos` at a non-blank byte.
  token(): ()! {
    let c = this.src[this.pos]
    if (isIdentStart(c)) {
      this.word()?
    } else if (isDigit(c) || (c == '.' && isDigit(byteAt(this.src, this.pos + 1)))) {
      this.number()?
    } else if (c == '"' || c == '\'') {
      this.str()?
    } else {
      this.symbol()?
    }
  }
}

// The tokens of the CEL source `src`, ending in `Eof`, or the InvalidPolicy
// that says which byte is wrong. `src` over 4096 bytes or over 512 tokens is
// refused; the offset of the first is 4096, of the second the start of the
// 513th token.
export fn lexCel(src: string): []CelSpanTok! {
  if (len(src) > celMaxBytes) {
    fail celErr("source exceeds ${celMaxBytes} bytes", celMaxBytes)
  }
  let lx = CelLexer(src)
  while (lx.skipSpace() < len(src)) {
    lx.token()?
  }
  return append(lx.toks, CelSpanTok{ tok = CelTok.Eof, start = len(src), end = len(src) })
}
