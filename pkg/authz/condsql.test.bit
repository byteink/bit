// pkg/authz/condsql.test.bit — exact SQL text and argument lists for both
// dialects, the injection cases, and the NULL wrappers.

import { MysqlVersion } from "orm"

@table class CsDoc {
  @id
  id: i64
  authorId: string
  status: string
  views: i64
  note: Option<string>
}

@table class CsOdd {
  @id
  id: i64
  @column("we\"ird`name")
  label: string
}

fn csPg(): ServerDialect {
  return ServerDialect.Postgres
}

fn csMy(): ServerDialect {
  return ServerDialect.Mysql(MysqlVersion{ major = 8, minor = 4 })
}

fn csInfo(): ResourceInfo {
  return ResourceInfo{ name = "CsDoc", table = "cs_docs", columns = CsDoc.__columns() }
}

fn csOddInfo(): ResourceInfo {
  return ResourceInfo{ name = "CsOdd", table = "cs_odds", columns = CsOdd.__columns() }
}

fn csVal(v: Value): string {
  return match (v) {
    Null => "null"
    Int(i) => "I:${i}"
    Float(f) => "F:${f}"
    Bool(b) => "B:${b}"
    Text(s) => "T:${s}"
    Blob(_) => "blob"
  }
}

fn csArgs(f: SqlFragment): string {
  let parts = []string(0)
  for v of f.args {
    parts = append(parts, csVal(v))
  }
  return join(parts, "|")
}

fn csCompile(c: Cond, d: ServerDialect, first: int): SqlFragment {
  return compileSql(c, csInfo(), d, first) catch e {
    panic("compileSql: ${e.message()}")
  }
}

fn csExpect(c: Cond, d: ServerDialect, sql: string, args: string, what: string) {
  let f = csCompile(c, d, 1)
  assert(f.sql == sql, "${what}: sql ${f.sql}")
  assert(csArgs(f) == args, "${what}: args ${csArgs(f)}")
}

fn csSara(): Value {
  return Value.Text("sara")
}

test "each operator, both dialects, 14 of 14" {
  let two = [Value.Text("draft"), Value.Text("review")]
  csExpect(eq("authorId", csSara()), csPg(), "\"author_id\" = $1", "T:sara", "pg eq")
  csExpect(eq("authorId", csSara()), csMy(), "`author_id` = ?", "T:sara", "my eq")
  csExpect(ne("status", Value.Text("x")), csPg(), "\"status\" <> $1", "T:x", "pg ne")
  csExpect(ne("status", Value.Text("x")), csMy(), "`status` <> ?", "T:x", "my ne")
  csExpect(oneOf("status", two), csPg(), "\"status\" IN ($1, $2)", "T:draft|T:review", "pg in")
  csExpect(oneOf("status", two), csMy(), "`status` IN (?, ?)", "T:draft|T:review", "my in")
  csExpect(lt("views", Value.Int(9)), csPg(), "\"views\" < $1", "I:9", "pg lt")
  csExpect(lt("views", Value.Int(9)), csMy(), "`views` < ?", "I:9", "my lt")
  csExpect(lte("views", Value.Int(9)), csPg(), "\"views\" <= $1", "I:9", "pg lte")
  csExpect(lte("views", Value.Int(9)), csMy(), "`views` <= ?", "I:9", "my lte")
  csExpect(gt("views", Value.Int(9)), csPg(), "\"views\" > $1", "I:9", "pg gt")
  csExpect(gt("views", Value.Int(9)), csMy(), "`views` > ?", "I:9", "my gt")
  csExpect(gte("views", Value.Int(9)), csPg(), "\"views\" >= $1", "I:9", "pg gte")
  csExpect(gte("views", Value.Int(9)), csMy(), "`views` >= ?", "I:9", "my gte")
}

test "postgres numbers from firstParam, mysql ignores it" {
  let c = and([eq("authorId", csSara()), oneOf("status", [Value.Text("a"), Value.Text("b")])])
  let pg = csCompile(c, csPg(), 4)
  assert(pg.sql == "(\"author_id\" = $4 AND \"status\" IN ($5, $6))", "pg: ${pg.sql}")
  assert(csArgs(pg) == "T:sara|T:a|T:b", "pg args: ${csArgs(pg)}")
  let my = csCompile(c, csMy(), 4)
  assert(my.sql == "(`author_id` = ? AND `status` IN (?, ?))", "my: ${my.sql}")
  assert(csArgs(my) == "T:sara|T:a|T:b", "my args: ${csArgs(my)}")
}

test "nested and, or, not are fully parenthesised, 2 of 2" {
  let c = and(
    [
      eq("authorId", csSara()),
      or([gt("views", Value.Int(10)), not(eq("status", Value.Text("archived")))]),
    ],
  )
  csExpect(
    c,
    csPg(),
    "(\"author_id\" = $1 AND (\"views\" > $2 OR (NOT (\"status\" = $3))))",
    "T:sara|I:10|T:archived",
    "pg nested",
  )
  csExpect(
    not(and([eq("authorId", csSara()), lt("views", Value.Int(3))])),
    csMy(),
    "(NOT (`author_id` = ? AND `views` < ?))",
    "T:sara|I:3",
    "my not and",
  )
}

test "empty in is false: FALSE on postgres, 0 on mysql" {
  csExpect(oneOf("status", []Value(0)), csPg(), "FALSE", "", "pg empty in")
  csExpect(oneOf("status", []Value(0)), csMy(), "0", "", "my empty in")
}

test "True and False literals per dialect and the empty groups" {
  csExpect(Cond.True, csPg(), "TRUE", "", "pg true")
  csExpect(Cond.False, csMy(), "0", "", "my false")
  csExpect(Cond.And([]Cond(0)), csPg(), "TRUE", "", "empty and")
  csExpect(Cond.Or([]Cond(0)), csMy(), "0", "", "empty or")
}

test "a hostile field name is refused and never emitted, 1 of 1" {
  let bad = "x\"; DROP TABLE a;--"
  let failed = false
  compileSql(eq(bad, csSara()), csInfo(), csPg(), 1) catch e {
    let (_, ok) = e.(InvalidPolicy)
    assert(ok, "not an InvalidPolicy: ${e.message()}")
    failed = true
  }
  assert(failed, "an unknown field must fail")
  compileSql(eq(bad, csSara()), csInfo(), csMy(), 1) catch e {
    let (_, ok) = e.(InvalidPolicy)
    assert(ok, "mysql: not an InvalidPolicy: ${e.message()}")
    return
  }
  panic("mysql: an unknown field must fail")
}

test "a hostile value stays in args and the text is unchanged, 1 of 1" {
  let evil = "'; DROP TABLE a;--"
  let f = csCompile(eq("status", Value.Text(evil)), csPg(), 1)
  assert(f.sql == "\"status\" = $1", "sql: ${f.sql}")
  assert(csArgs(f) == "T:${evil}", "args: ${csArgs(f)}")
  let m = csCompile(oneOf("status", [Value.Text(evil), Value.Text("\" OR 1=1")]), csMy(), 1)
  assert(m.sql == "`status` IN (?, ?)", "sql: ${m.sql}")
  assert(len(m.args) == 2, "args: ${len(m.args)}")
}

test "a column name carrying quotes is doubled" {
  let pg = compileSql(eq("label", csSara()), csOddInfo(), csPg(), 1) catch e {
    panic("pg: ${e.message()}")
  }
  assert(pg.sql == "\"we\"\"ird`name\" = $1", "pg: ${pg.sql}")
  let my = compileSql(eq("label", csSara()), csOddInfo(), csMy(), 1) catch e {
    panic("my: ${e.message()}")
  }
  assert(my.sql == "`we\"ird``name` = ?", "my: ${my.sql}")
}

test "asAllow and asDeny wrap for NULL safety on both dialects" {
  let f = csCompile(eq("note", Value.Text("x")), csPg(), 1)
  assert(asAllow(f, csPg()).sql == "COALESCE((\"note\" = $1), FALSE)", asAllow(f, csPg()).sql)
  assert(asDeny(f, csPg()).sql == "NOT COALESCE((\"note\" = $1), FALSE)", asDeny(f, csPg()).sql)
  let m = csCompile(eq("note", Value.Text("x")), csMy(), 1)
  assert(asAllow(m, csMy()).sql == "COALESCE((`note` = ?), 0)", asAllow(m, csMy()).sql)
  assert(asDeny(m, csMy()).sql == "NOT COALESCE((`note` = ?), 0)", asDeny(m, csMy()).sql)
  assert(csArgs(asDeny(m, csMy())) == "T:x", "args kept")
}

test "Custom is NotFilterable, a placeholder and a bad firstParam are InvalidPolicy" {
  let c = and([eq("authorId", csSara()), custom<CsDoc>("Window", (d: CsDoc) => true)])
  let nf = false
  compileSql(c, csInfo(), csPg(), 1) catch e {
    let (got, ok) = e.(NotFilterable)
    assert(ok, "not a NotFilterable: ${e.message()}")
    assert(got.label == "Window", "label: ${got.label}")
    nf = true
  }
  assert(nf, "Custom must refuse")
  let param = Cond.Cmp("authorId", Op.Eq, [Operand.Param("id")])
  compileSql(param, csInfo(), csPg(), 1) catch e {
    assert(contains(e.message(), "unbound placeholder"), "message: ${e.message()}")
    compileSql(eq("authorId", csSara()), csInfo(), csPg(), 0) catch e2 {
      assert(contains(e2.message(), "firstParam"), "message: ${e2.message()}")
      return
    }
    panic("firstParam 0 must fail")
  }
  panic("a placeholder must fail")
}

test "Known compiles to COALESCE on both dialects, 2 of 2" {
  let c = Cond.Not(Cond.Known(eq("note", Value.Text("x"))))
  csExpect(c, csPg(), "(NOT COALESCE((\"note\" = $1), FALSE))", "T:x", "pg")
  csExpect(c, csMy(), "(NOT COALESCE((`note` = ?), 0))", "T:x", "mysql")
}
