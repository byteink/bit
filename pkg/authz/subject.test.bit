// pkg/authz/subject.test.bit — `attributeOf` over subjects that never write
// `@json`: the compiler's `__field` reads one exported field by name.

import {
  Json,
  JsonEntry,
  jsonAsString,
  jsonAsArray,
  jsonAsInt,
  jsonAsBool,
  jsonAsFloat,
  jsonAsObject,
} from "std/json"

enum Level { Junior, Senior }

class Member {
  export id: string,
  export roles: []string,
  export team: string,
  export age: int,
  export score: f64,
  export active: bool,
  export level: Level,
  export tags: []string,
  export codes: []int,
  export manager: Option<string>,
  secret: string,
}

class Address {
  export city: string,
}

class Placed {
  export id: string,
  export roles: []string,
  export address: Address,
  export extra: map<string, string>,
}

// The shape of pkg/auth's Identity, declared locally: pkg/authz imports
// nothing from pkg/auth.
class Identity {
  id: string,
  claims: Json,
}

class Staff {
  export id: string,
  export roles: []string,
  export team: string,
}

fn claimString(i: Identity, key: string): string {
  let obj = jsonAsObject(i.claims)
  for e of unwrapOr(obj, []) {
    if (e.key == key) {
      return unwrapOr(jsonAsString(e.value), "")
    }
  }
  return ""
}

fn staffOf(i: Identity): Staff {
  return Staff{ id = i.id, roles = ["editor"], team = claimString(i, "team") }
}

fn str(o: Option<Json>): string {
  return match (o) {
    Some(j) => unwrapOr(jsonAsString(j), "<not a string>")
    None => "<none>"
  }
}

fn list(o: Option<Json>): []Json {
  return match (o) {
    Some(j) => unwrapOr(jsonAsArray(j), [])
    None => []
  }
}

fn member(): Member {
  return Member{
    id = "u1", roles = ["editor", "author"], team = "news", age = 41, score = 2.5, active = true,
    level = Level.Senior, tags = ["a", "b", "c"], codes = [7, 8], manager = Option<string>.Some("m"),
    secret = "s3",
  }
}

test "a class without @json resolves id, roles and team, 3 of 3" {
  let m = member()
  assert(str(attributeOf(m, "id")) == "u1", "id: ${str(attributeOf(m, "id"))}")
  assert(str(attributeOf(m, "team")) == "news", "team: ${str(attributeOf(m, "team"))}")
  let roles = list(attributeOf(m, "roles"))
  assert(len(roles) == 2, "roles: ${len(roles)}")
  assert(jsonAsString(roles[1]) == Option<string>.Some("author"), "second role")
}

test "int, float, bool, enum and lists map to their Json shape" {
  let m = member()
  let age = match (attributeOf(m, "age")) {
    Some(j) => unwrapOr(jsonAsInt(j), -1)
    None => -2
  }
  assert(age == 41, "age ${age}")
  let score = match (attributeOf(m, "score")) {
    Some(j) => unwrapOr(jsonAsFloat(j), -1.0)
    None => -2.0
  }
  assert(score == 2.5, "score ${score}")
  let active = match (attributeOf(m, "active")) {
    Some(j) => unwrapOr(jsonAsBool(j), false)
    None => false
  }
  assert(active, "active")
  assert(str(attributeOf(m, "level")) == "Senior", "level: ${str(attributeOf(m, "level"))}")
  let tags = list(attributeOf(m, "tags"))
  assert(len(tags) == 3, "tags ${len(tags)}")
  assert(jsonAsString(tags[2]) == Option<string>.Some("c"), "third tag")
  let codes = list(attributeOf(m, "codes"))
  assert(len(codes) == 2, "codes ${len(codes)}")
  assert(jsonAsInt(codes[1]) == Option<i64>.Some(8), "second code")
}

test "unknown, unexported, unsupported and dotted names are all None, 8 of 8" {
  let m = member()
  let bad = ["nope", "", "secret", "manager", "team.name", "roles.0", "Team", "age "]
  for p of bad {
    assert(str(attributeOf(m, p)) == "<none>", "name '${p}': ${str(attributeOf(m, p))}")
  }
}

test "a nested class and a map field are None, never a partial value" {
  let p = Placed{
    id = "u2",
    roles = ["admin"],
    address = Address{ city = "Oslo" },
    extra = map<string, string>{},
  }
  assert(str(attributeOf(p, "id")) == "u2", "id")
  for path of ["address", "address.city", "extra"] {
    assert(str(attributeOf(p, path)) == "<none>", "path '${path}' resolved")
  }
}

test "a class wrapping an Identity look-alike resolves its team claim" {
  let claims = Json.JsonObject([JsonEntry{ key = "team", value = Json.JsonString("desk") }])
  let s = staffOf(Identity{ id = "u3", claims = claims })
  assert(str(attributeOf(s, "id")) == "u3", "id")
  assert(str(attributeOf(s, "team")) == "desk", "team: ${str(attributeOf(s, "team"))}")
  assert(str(attributeOf(s, "claims")) == "<none>", "claims are not exposed")
}
