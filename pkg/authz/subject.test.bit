// pkg/authz/subject.test.bit — `attributeOf` over three shapes of subject.

import { Json, JsonEntry, jsonAsString, jsonAsArray, jsonAsObject } from "std/json"

@json class Member {
  id: string,
  roles: []string,
  team: string,
  address: Address,
}

@json class Address {
  city: string,
}

// No `@json`: only `id` and `roles` can be read.
class Bare {
  id: string,
  roles: []string,
  team: string,
}

// The shape of pkg/auth's Identity, declared locally: pkg/authz imports
// nothing from pkg/auth.
class Identity {
  id: string,
  claims: Json,
}

@json class Staff {
  id: string,
  roles: []string,
  team: string,
}

fn claimString(i: Identity, key: string): string {
  let obj = jsonAsObject(i.claims)
  for e of unwrapOr(obj, []) {
    if (e.key == key) {
      return unwrapOr(jsonAsString(e.value), "")
    }
  }
  return ""
}

fn staffOf(i: Identity): Staff {
  return Staff{ id = i.id, roles = ["editor"], team = claimString(i, "team") }
}

fn str(o: Option<Json>): string {
  return match (o) {
    Some(j) => unwrapOr(jsonAsString(j), "<not a string>")
    None => "<none>"
  }
}

fn rolesOf(o: Option<Json>): []Json {
  return match (o) {
    Some(j) => unwrapOr(jsonAsArray(j), [])
    None => []
  }
}

fn member(): Member {
  return Member{
    id = "u1",
    roles = ["editor", "author"],
    team = "news",
    address = Address{ city = "Oslo" },
  }
}

test "@json class: id, roles and team resolve, 3 of 3" {
  let m = member()
  assert(str(attributeOf(m, "id")) == "u1", "id: ${str(attributeOf(m, "id"))}")
  assert(str(attributeOf(m, "team")) == "news", "team: ${str(attributeOf(m, "team"))}")
  let roles = rolesOf(attributeOf(m, "roles"))
  assert(len(roles) == 2, "roles: ${len(roles)}")
  assert(jsonAsString(roles[1]) == Option<string>.Some("author"), "second role")
}

test "@json class: a dotted path walks nested objects" {
  assert(str(attributeOf(member(), "address.city")) == "Oslo", "city")
}

test "@json class: 2 of 2 missing paths are None" {
  let m = member()
  let bad = ["nope", "address.zip", "team.name", "address.city.x", "", "roles.0"]
  for p of bad {
    assert(str(attributeOf(m, p)) == "<none>", "path '${p}': ${str(attributeOf(m, p))}")
  }
}

test "class without @json: id and roles only" {
  let p = Bare{ id = "u2", roles = ["admin"], team = "ops" }
  assert(str(attributeOf(p, "id")) == "u2", "id")
  let roles = rolesOf(attributeOf(p, "roles"))
  assert(len(roles) == 1, "roles: ${len(roles)}")
  for path of ["team", "address.city", "nope", ""] {
    assert(str(attributeOf(p, path)) == "<none>", "path '${path}' resolved")
  }
}

test "a class wrapping an Identity look-alike resolves its team claim" {
  let claims = Json.JsonObject([JsonEntry{ key = "team", value = Json.JsonString("desk") }])
  let s = staffOf(Identity{ id = "u3", claims = claims })
  assert(str(attributeOf(s, "id")) == "u3", "id")
  assert(str(attributeOf(s, "team")) == "desk", "team: ${str(attributeOf(s, "team"))}")
  assert(str(attributeOf(s, "claims")) == "<none>", "claims are not exposed")
}
