// pkg/authz/resource.test.bit — resources register under their class names.

import { join } from "std/strings"

@table class Article {
  @id
  id: i64
  title: string
  authorId: string
  team: string
  status: string
}

@table("custom") class Folder {
  @id
  id: i64
  name: string
}

@table class OrderLine {
  @id
  id: i64
  qty: i64
}

fn chained(): Authz<Action>! {
  let a = Authz<Action>()?
  a.resource<Article>()?.resource<Folder>()?.resource<OrderLine>()?
  return a
}

fn build(): Authz<Action> {
  return chained() catch e {
    panic("resource: ${e.message()}")
  }
}

test "3 of 3 classes register under their class names" {
  let a = build()
  assert(len(a.resourceNames()) == 3, "registered: ${len(a.resourceNames())}")
  let want = ["Article", "Folder", "OrderLine"]
  for w of want {
    assert(isSome(a.resourceByName(w)), "${w} not registered")
  }
}

test "the class name, not the table name, is the resource name" {
  let a = build()
  assert(!isSome(a.resourceByName("custom")), "table name registered as a resource")
  match (a.resourceByName("Folder")) {
    Some(info) => {
      assert(info.name == "Folder", "name: ${info.name}")
      assert(info.table == "custom", "table: ${info.table}")
      assert(len(info.columns) == 2, "columns: ${len(info.columns)}")
    }
    None => assert(false, "Folder missing")
  }
}

test "names are listed sorted whatever the registration order" {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<OrderLine>() catch e {
    panic(e.message())
  }
  let _ = a.resource<Article>() catch e {
    panic(e.message())
  }
  assert(
    join(a.resourceNames(), ",") == "Article,OrderLine",
    "order: ${join(a.resourceNames(), ",")}",
  )
}

test "a class registered twice is an InvalidPolicy, 1 of 1" {
  let a = build()
  let _ = a.resource<Article>() catch e {
    assert(e.message() == "invalid policy: resource Article registered twice", e.message())
    assert(len(a.resourceNames()) == 3, "the duplicate was added")
    return
  }
  assert(false, "duplicate accepted")
}

test "fieldType resolves 3 of 3 known fields and None for 1 unknown" {
  let a = build()
  assert(a.fieldType("Article", "title") == Option<string>.Some("string"), "title")
  assert(a.fieldType("Folder", "id") == Option<string>.Some("i64"), "id")
  assert(a.fieldType("OrderLine", "qty") == Option<string>.Some("i64"), "qty")
  assert(!isSome(a.fieldType("Article", "nope")), "unknown field resolved")
  assert(!isSome(a.fieldType("Nope", "title")), "unknown resource resolved")
}

test "resourceRef names the class and all is a distinct marker" {
  let r = resourceRef<Folder>()
  match (r) {
    Named(n) => assert(n == "Folder", "named: ${n}")
    All => assert(false, "a class resolved to All")
  }
  match (all) {
    All => {}
    Named(n) => assert(false, "all resolved to ${n}")
  }
}
