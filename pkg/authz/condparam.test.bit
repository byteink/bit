// pkg/authz/condparam.test.bit — `operandOf` and `bind`: subject placeholders
// in stored conditions, resolved against a subject before evaluation.

@table class CpNote {
  @id
  id: i64
  team: string
  owner: string
  level: i64
}

class CpMember {
  export id: string,
  export roles: []string,
  export team: string,
  export age: int,
  export manager: Option<string>,
  secret: string,
}

fn cpMember(): CpMember {
  return CpMember{
    id = "u1", roles = ["editor", "author"], team = "news", age = 3,
    manager = Option<string>.Some("m"), secret = "s",
  }
}

fn cpSubject(m: CpMember): Option<Subject> {
  return Option<Subject>.Some(m)
}

fn cpOperand(o: Operand): string {
  return match (o) {
    Lit(v) => cpValue(v)
    Param(p) => "$${p}"
    Null => "NULL"
  }
}

fn cpValue(v: Value): string {
  return match (v) {
    Text(s) => "'${s}'"
    Int(i) => "${i}"
    _ => "lit"
  }
}

fn cpShape(c: Cond): string {
  return match (c) {
    True => "True"
    False => "False"
    Cmp(f, _, ops) => "${f}(${cpOperands(ops)})"
    And(cs) => "And(${cpList(cs)})"
    Or(cs) => "Or(${cpList(cs)})"
    Not(inner) => "Not(${cpShape(inner)})"
    Known(inner) => "Known(${cpShape(inner)})"
    Custom(label, _) => "Custom(${label})"
    Related(l, t, r) => "Related(${l},${t},${r})"
  }
}

fn cpOperands(ops: []Operand): string {
  let parts = []string(0)
  for o of ops {
    parts = append(parts, cpOperand(o))
  }
  return join(parts, ",")
}

fn cpList(cs: []Cond): string {
  let parts = []string(0)
  for c of cs {
    parts = append(parts, cpShape(c))
  }
  return join(parts, " ")
}

fn cpParam(field: string, op: Op, text: string): Cond {
  return Cond.Cmp(field, op, [operandOf(text)])
}

// The shape `bind` leaves, and the unresolved paths joined by `|`.
fn cpBind(c: Cond, s: Option<Subject>): string {
  let (bound, missing) = bind(c, s)
  return "${cpShape(bound)} !${join(missing, "|")}"
}

fn cpEval(c: Cond): string {
  let row = CpNote{ id = 1, team = "news", owner = "u1", level = 5 }
  let t = evalCond(c, row) catch e {
    return e.message()
  }
  return match (t) {
    True => "True"
    False => "False"
    Unknown => "Unknown"
  }
}

test "operandOf reads a placeholder, an escape and plain text, 5 of 5" {
  assert(cpOperand(operandOf("$user.team")) == "$team", "placeholder")
  assert(cpOperand(operandOf("$user.org.id")) == "$org.id", "dotted path")
  assert(cpOperand(operandOf("$$x")) == "'$x'", "escaped")
  assert(cpOperand(operandOf("$$user.team")) == "'$user.team'", "escaped placeholder")
  assert(
    cpOperand(operandOf("$5")) == "'$5'" && cpOperand(operandOf("a$user.b")) == "'a$user.b'",
    "a $ that does not lead is text",
  )
}

test "bind resolves id, roles, a text attribute and an int attribute, 4 of 4" {
  let s = cpSubject(cpMember())
  assert(cpBind(cpParam("owner", Op.Eq, "$user.id"), s) == "owner('u1') !", "id")
  assert(cpBind(cpParam("team", Op.In, "$user.roles"), s) == "team('editor','author') !", "roles")
  assert(cpBind(cpParam("team", Op.Eq, "$user.team"), s) == "team('news') !", "team")
  assert(cpBind(cpParam("level", Op.Lte, "$user.age"), s) == "level(3) !", "age")
}

test "a guest, a missing, a private, an Option and a dotted path are unresolved, 5 of 5" {
  let s = cpSubject(cpMember())
  assert(
    cpBind(cpParam("team", Op.Eq, "$user.team"), Option<Subject>.None) == "False !team",
    "guest",
  )
  assert(cpBind(cpParam("team", Op.Eq, "$user.nope"), s) == "False !nope", "missing")
  assert(cpBind(cpParam("team", Op.Eq, "$user.secret"), s) == "False !secret", "private")
  assert(cpBind(cpParam("team", Op.Eq, "$user.manager"), s) == "False !manager", "option")
  assert(cpBind(cpParam("team", Op.Eq, "$user.org.id"), s) == "False !org.id", "dotted")
}

test "a literal that spells a placeholder or an escape stays literal, 1 of 1" {
  let c = Cond.Cmp("team", Op.Eq, [operandOf("$$x")])
  assert(
    cpBind(c, cpSubject(cpMember())) == "team('$x') !",
    "got ${cpBind(c, cpSubject(cpMember()))}",
  )
  assert(cpEval(c) == "False", "'$x' is not the team")
}

test "a tree with no placeholder comes back as it is" {
  let c = and([eq("team", Value.Text("news")), not(lt("level", Value.Int(2)))])
  let (bound, missing) = bind(c, Option<Subject>.None)
  assert(cpShape(bound) == cpShape(c) && len(missing) == 0, "changed: ${cpShape(bound)}")
}

test "bind goes through and, or and not and keeps the structure" {
  let c = and(
    [
      cpParam("owner", Op.Eq, "$user.id"),
      or([eq("level", Value.Int(1)), cpParam("team", Op.Eq, "$user.team")]),
    ],
  )
  assert(
    cpBind(c, cpSubject(cpMember())) == "And(owner('u1') Or(level(1) team('news'))) !",
    cpBind(c, cpSubject(cpMember())),
  )
}

test "an unresolved comparison never grants through a not, 2 of 2" {
  let c = not(cpParam("team", Op.Eq, "$user.nope"))
  assert(cpBind(c, cpSubject(cpMember())) == "Not(True) !nope", "odd")
  assert(cpEval(bindOnly(c)) == "False", "the not must not grant")
  let d = Cond.Not(Cond.Not(cpParam("team", Op.Eq, "$user.nope")))
  assert(cpBind(d, cpSubject(cpMember())) == "Not(Not(False)) !nope", "even")
}

fn bindOnly(c: Cond): Cond {
  let (bound, _) = bind(c, cpSubject(cpMember()))
  return bound
}

test "a list is only for in, and an empty list is a definite False, 3 of 3" {
  let s = cpSubject(cpMember())
  assert(cpBind(cpParam("team", Op.Eq, "$user.roles"), s) == "False !roles", "eq over a list")
  let bare = CpMember{
    id = "u2",
    roles = []string(0),
    team = "t",
    age = 1,
    manager = Option<string>.None,
    secret = "",
  }
  assert(cpBind(cpParam("team", Op.In, "$user.roles"), cpSubject(bare)) == "False !", "empty list")
  assert(cpBind(cpParam("team", Op.In, "$user.team"), s) == "team('news') !", "scalar into in")
}

test "a bound tree evaluates, an unbound one is an InvalidPolicy, 3 of 3" {
  let c = and([cpParam("team", Op.Eq, "$user.team"), cpParam("owner", Op.Eq, "$user.id")])
  assert(cpEval(bindOnly(c)) == "True", "bound match")
  assert(cpEval(c) == "invalid policy: field team: unbound placeholder $user.team", cpEval(c))
  let other = cpParam("team", Op.Eq, "$user.nope")
  assert(cpEval(bindOnly(other)) == "False", "unresolved is False")
}

// The InvalidPolicy message `validate` fails with, or "" when it accepts.
fn cpValidate(c: Cond): string {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<CpNote>() catch e {
    panic("resource: ${e.message()}")
  }
  a.validate(resourceRef<CpNote>(), c) catch e {
    return e.message()
  }
  return ""
}

test "validate accepts a placeholder and still checks its field, 2 of 2" {
  let ok = cpValidate(cpParam("team", Op.Eq, "$user.team"))
  assert(ok == "", "refused a placeholder: ${ok}")
  assert(
    cpValidate(cpParam("nope", Op.Eq, "$user.team")) != "",
    "a typo'd field behind a placeholder was accepted",
  )
}

test "bind keeps a null test as it is, with a placeholder beside it" {
  let c = and([eqNull("note"), cpParam("team", Op.Eq, "$user.team")])
  let got = cpBind(c, cpSubject(cpMember()))
  assert(hasPrefix(got, "And(note(NULL) "), "got ${got}")
  assert(cpBind(neNull("note"), cpSubject(cpMember())) == "note(NULL) !", "alone")
}

test "bind goes through Known and keeps the not-parity of an unresolved path, 2 of 2" {
  let c = cpParam("team", Op.Eq, "$user.nope")
  let s = cpSubject(cpMember())
  assert(cpBind(Cond.Known(c), s) == "Known(False) !nope", "known")
  assert(cpBind(Cond.Not(Cond.Known(c)), s) == "Not(Known(True)) !nope", "not known")
}
