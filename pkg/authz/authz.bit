// pkg/authz/authz.bit — the `Authz<A>` handle, built once at startup with
// the app's action enum:
//
//   enum Action { Manage, Read, Create, Update, Delete, Publish }
//
//   let authz = Authz<Action>()?                       // code policies only
//   let authz = Authz<Action>(store = env("AUTHZ_URL"))?  // plus stored policies
//   let authz = Authz<Action>(maxDepth = 12)?          // relationship check bounds
//
// An empty `store` keeps stored policies in memory (store.bit's
// `MemoryStore`): they last as long as the process. A non-empty one opens the
// policy store, and a store that cannot be reached is a StoreUnavailable, so
// the app stops at startup instead of refusing every request later.
// `options = StoreOptions(policyStore = Option<PolicyStore>.Some(s))` brings a
// `PolicyStore` of your own (or one `MemoryStore` shared by two handles, in a
// test). A shared or opened store is polled every `options.refreshEveryMs` for
// another process's writes and the handle fails closed when it cannot be read
// (cache.bit has the whole contract); `close()` stops the poll.

import { Logger } from "std/log"
import { Mutex } from "std/sync"

// The CRUD variants the ORM bridge maps a query onto (CASL's names). Which
// of them the app's enum declares; a missing one is an error only when an
// orm handle is opened with it, not here.
export class CrudActions {
  export read: bool,
  export create: bool,
  export update: bool,
  export delete: bool,
}

// The seam the store tickets fill in (#7030). Until they land, no URL names a
// reachable store.
fn openStore(url: string): PolicyStore! {
  fail StoreUnavailable{}
}

fn hasName(names: []string, want: string): bool {
  for n of names {
    if (n == want) {
      return true
    }
  }
  return false
}

export class Authz<A: ActionEnum> {
  store: PolicyStore
  admin: Mutex
  wildcard: bool
  export crud: CrudActions
  relations: RelationStore
  relationCache: RelCache
  limits: Limits
  state: DecideState<A>
  storeSync: StoreSync
  tenant: TenantKey

  // One handle per app, built at startup. Empty `store` means in-memory.
  // A class's `init` is the constructor (SPEC §10.4): `Authz<Action>(...)`.
  // `maxDepth`, `maxVisited` and `maxFanout` bound `hasRelation` (rebac.bit);
  // one below 1 is an InvalidPolicy. `options` (cache.bit's `StoreOptions`)
  // sets the store to use instead of `store`, how long another process's write
  // can go unseen (`refreshEveryMs`, default 5000, 0 turns the poll off) and
  // how many tenants `forTenant` follows (`maxTenants`, default 10000); a
  // value out of range is an InvalidPolicy.
  init(
    store: string = "",
    maxDepth: int = defaultMaxDepth,
    maxVisited: int = defaultMaxVisited,
    maxFanout: int = defaultMaxFanout,
    options: StoreOptions = StoreOptions(),
  )! {
    let names = A.__variants()
    this.limits = newLimits(maxDepth, maxVisited, maxFanout)?
    options.check()?
    this.admin = Mutex()
    this.storeSync = StoreSync(options.refreshEveryMs, options.maxTenants)
    let shared = store != "" || isSome(options.policyStore)
    if (isSome(options.policyStore)) {
      this.store = unwrap(options.policyStore)
    } else if (store == "") {
      this.store = MemoryStore()
    } else {
      this.store = openStore(store)?
    }
    this.relations = MemoryRelationStore()
    this.relationCache = RelCache(options.relationCacheSize, options.refreshEveryMs)
    this.state = DecideState<A>()
    this.tenant = globalTenant()
    this.wildcard = hasName(names, "Manage")
    this.crud = CrudActions{
      read = hasName(names, "Read"),
      create = hasName(names, "Create"),
      update = hasName(names, "Update"),
      delete = hasName(names, "Delete"),
    }
    startSync<A>(this, shared)?
  }

  // The view of this handle for `tenant` (tenant.bit has what a tenant sees
  // and may write): `authz.forTenant(currentTenant(c))?.check(user, ...)`.
  // It shares everything with this handle, so it is cheap enough to make per
  // request, and policies registered or saved later show in it. An empty
  // tenant is the global one; otherwise 1 to 64 characters of `[A-Za-z0-9_.-]`,
  // else an InvalidPolicy. The first view of a tenant reads its attachments
  // from the store (a StoreUnavailable when it cannot) and the handle follows
  // the tenant from then on; a view of a followed tenant touches no store
  // (cache.bit).
  export forTenant(tenant: string): Authz<A>! {
    let k = tenantKeyOf(tenant)?
    if (tenant != "") {
      followTenant<A>(this, tenant)?
    }
    return Authz<A>{
      store = this.store,
      admin = this.admin,
      wildcard = this.wildcard,
      crud = this.crud,
      relations = this.relations,
      relationCache = this.relationCache,
      limits = this.limits,
      state = this.state,
      storeSync = this.storeSync,
      tenant = k,
    }
  }

  // True when A declares a variant named "Manage". It then matches every
  // action; without one the wildcard does not exist.
  export hasWildcard(): bool {
    return this.wildcard
  }

  // Registers `T`, a `@table` class, as a resource under its class name
  // ("Article", whatever `@table("...")` says). Returns the handle, so
  // registrations chain: `authz.resource<Article>()?.resource<Folder>()?`.
  // Each step carries its own `?`: one trailing `?` over the whole chain does
  // not compile today (#7185). The same class twice is an InvalidPolicy.
  export resource<T: Tabled>(): Authz<A>! {
    this.admin.lock()
    defer this.admin.unlock()
    let info = describe<T>()
    if (!this.state.cache.addResource(info)) {
      fail InvalidPolicy{ detail = "resource ${info.name} registered twice" }
    }
    if (len(this.registered().stored.failures) > 0) {
      syncMarked<A>(this)?
    }
    return this
  }

  // Declares that resource `T`, registered first, has the relation `name`:
  // `authz.relation<Folder>("editor")?`. Returns the handle, so declarations
  // chain. `inherit = "parent"` adds that whoever holds `name` on an object's
  // `parent` holds it here too; `parent` must be declared already. Tuples may
  // only use declared relations, so a typo fails at the call. Declaring one
  // twice is an InvalidPolicy.
  export relation<T: Tabled>(name: string, inherit: string = ""): Authz<A>! {
    this.admin.lock()
    defer this.admin.unlock()
    let reg = this.registered()
    let d = newDecl<T>(reg.resources, reg.decls, name, inherit)?
    if (!this.state.cache.addDecl(d)) {
      fail InvalidPolicy{ detail = "relation ${name} is declared twice on ${T.__className()}" }
    }
    if (len(this.registered().stored.failures) > 0) {
      syncMarked<A>(this)?
    }
    return this
  }

  // Records that `subject` is `relation` of `object`: `relate("user:sara",
  // "editor", "folder:launch")`. The object's type must be a registered
  // resource that declares the relation; every part is validated first
  // (relation.bit) and a bad one is an InvalidPolicy. Writing a tuple that
  // already exists is a no-op.
  export relate(subject: string, relation: string, object: string): ()! {
    let reg = this.registered()
    let t = checkTuple(reg.resources, reg.decls, subject, relation, object)?
    this.relationCache.writing(true)
    defer this.relationCache.writing(false)
    this.relations.write(this.tenant.name, t)?
  }

  // Removes the tuple `relate` wrote; removing one that is not there is a
  // no-op. The same validation applies.
  export unrelate(subject: string, relation: string, object: string): ()! {
    let reg = this.registered()
    let t = checkTuple(reg.resources, reg.decls, subject, relation, object)?
    this.relationCache.writing(true)
    defer this.relationCache.writing(false)
    this.relations.delete(this.tenant.name, t)?
  }

  // Whether that exact tuple was written. Direct only: a userset subject is
  // matched as the literal "team:eng#member", never expanded.
  export related(subject: string, relation: string, object: string): bool! {
    let reg = this.registered()
    return this.relations.has(
      this.tenant.name,
      checkTuple(reg.resources, reg.decls, subject, relation, object)?,
    )?
  }

  // Whether `subject` holds `relation` on `object` through any chain of
  // usersets and inherited relations: `hasRelation("user:sara", "editor",
  // "folder:launch")`. Fails with a RelationLimit when a bound (see
  // `Authz<A>(maxDepth = ...)`) stops it before it can answer; that is NOT
  // related, so callers treat it as `false`. A store failure is returned too.
  export hasRelation(subject: string, relation: string, object: string): bool! {
    let reg = this.registered()
    let t = checkTuple(reg.resources, reg.decls, subject, relation, object)?
    return cachedRelation(
      this.relationCache,
      RelQuery{
        store = this.relations, tenant = this.tenant.name, decls = reg.decls, limits = this.limits, tuple = t,
      },
    ) catch e {
      logStoreDown(loggerOf<A>(reg), e)
      fail e
    }
  }

  // The registered resource stored policies call `name`, or None.
  export resourceByName(name: string): Option<ResourceInfo> {
    return findResource(this.registered().resources, name)
  }

  // The declared type ("i64", "string") of `field` on the resource called
  // `resource`, or None when the resource or the field is unknown.
  export fieldType(resource: string, field: string): Option<string> {
    return fieldTypeIn(this.registered().resources, resource, field)
  }

  // Registered class names, sorted, for "unknown resource" messages.
  export resourceNames(): []string {
    return namesIn(this.registered().resources)
  }

  // Checks `c` against `resource` as a policy is registered: every field it
  // names must be a column of that class and every value must suit the
  // column's type. Fails with an InvalidPolicy that names the mistake, so a
  // typo stops the app at startup. A condition on `all` may not name a field,
  // since the resources it covers do not share one; the resource must be
  // registered.
  export validate(resource: ResourceRef, c: Cond): ()! {
    let reg = this.registered()
    return validateIn(reg.resources, reg.decls, resource, c)?
  }

  // Checks policy `p` as it is registered, against what `probe` makes it say:
  // every rule needs at least one action, a registered resource and a
  // condition that fits it. Fails with an InvalidPolicy naming the policy and
  // the rule's position (from 0), so a typo stops the app at startup. `probe`
  // is any subject of the app's user class; a policy that branches on the
  // subject is checked for the branch `probe` takes.
  export validatePolicy<S: Subject>(p: Policy<S, A>, probe: S): ()! {
    let reg = this.registered()
    return validateRulesIn<A>(reg.resources, reg.decls, p.name, p.rulesFor(probe))?
  }

  // Checks the stored policy `doc` against the registered resources and
  // returns the rules it states, the same `Rule`s a code policy makes (named
  // `validateDoc` since `validate` checks one condition). Every refusal is an
  // InvalidPolicy whose message starts with the RFC 6901 JSON Pointer of the
  // fault (doc.bit has the limits).
  export validateDoc(doc: PolicyDoc): CompiledPolicy<A>! {
    let reg = this.registered()
    return compileDocIn<A>(reg.resources, reg.decls, doc)?
  }

  // Checks the attachment `a` the same way. That the policy it names exists is
  // the store's check.
  export validateAttachment(a: Attachment): ()! {
    return checkAttachment(a)?
  }

  // Registers `S`, the app's user class, so the rules of its subjects are
  // built once per subject value and reused (rulecache.bit). `role<S>` does it
  // already; call this when every role of `S` is defined by stored policies
  // only (nothing in code names the class), or each check rebuilds the
  // subject's rules. Calling it again, or after `role<S>`, changes nothing.
  export subject<S: Subject>(): Authz<A> {
    let empty: S
    this.state.cache.addKind(kindFor<S>(), empty)
    return this
  }

  // Saves the stored policy `doc`: checked as `validateDoc` checks it (an
  // InvalidPolicy with the JSON Pointer of the fault), refused when a policy
  // written in code has its name, then handed to the store and compiled, so no
  // check ever reads the document again. A document equal to the stored one is
  // a no-op that leaves every cache as it was; any other replaces the policy
  // of that name for every subject it is attached to, from their next check.
  // Safe behind an admin endpoint: input is bounded (doc.bit) and nothing here
  // panics.
  export savePolicy(doc: PolicyDoc): ()! {
    if (this.tenant.name != "") {
      fail InvalidPolicy{ detail = "a policy is global: save it on the handle, not on the view for tenant '${this.tenant.name}'" }
    }
    this.validateDoc(doc)?
    if (codePolicyNamed<A>(this.registered().roles, doc.name)) {
      fail InvalidPolicy{ detail = "/name: a policy written in code is called '${doc.name}'" }
    }
    this.admin.lock()
    defer this.admin.unlock()
    let _ = this.store.putPolicy(doc)?
    syncMarked<A>(this)?
  }

  // Attaches a saved policy to a role, a group or one user, for a tenant
  // (doc.bit has the document): `attach(Attachment{ policy = "PublishOwnTeam",
  // to = Target{ role = Option<string>.Some("author") }, tenant = "" })`.
  // Checked as `validateAttachment` checks it, and the policy must be saved
  // already, else an InvalidPolicy. Attaching what is attached is a no-op. On
  // a tenant's view the attachment is written for that tenant (tenant.bit).
  export attach(a: Attachment): ()! {
    checkAttachment(a)?
    let at = attachmentIn(this.tenant.name, a)?
    this.admin.lock()
    defer this.admin.unlock()
    if (!isSome(this.store.policy(at.policy)?)) {
      fail InvalidPolicy{ detail = "/policy: no stored policy is called '${at.policy}'" }
    }
    this.store.attach(at)?
    syncMarked<A>(this)?
  }

  // Undoes `attach`: from the target's next check the policy no longer
  // applies to it. Detaching what is not attached is a no-op. On a tenant's
  // view it detaches that tenant's attachment (tenant.bit).
  export detach(a: Attachment): ()! {
    checkAttachment(a)?
    let at = attachmentIn(this.tenant.name, a)?
    this.admin.lock()
    defer this.admin.unlock()
    this.store.detach(at)?
    syncMarked<A>(this)?
  }

  // Reads the store's versions and reloads what moved, now: the poll's own
  // step, for an app to call once after it has registered its resources and
  // roles (a store that already holds policies starts down until then), and
  // in tests. Fails with the StoreUnavailable the handle is failing closed
  // with. A policy that does not compile refuses only its attached subjects;
  // the handle is up again once the store answers. Calling it when nothing moved costs two store reads.
  export refresh(): ()! {
    this.admin.lock()
    defer this.admin.unlock()
    syncMarked<A>(this)?
  }

  // Stops admission and refuses checks; timeout retains unfinished task ownership.
  export close(): ()! {
    stopSync(this.storeSync)?
  }

  // The callback owns its cleanup; return only after its transport is closed.
  export spawnBackground(name: string, callback: (chan<bool>) => ()!): ()! {
    let slot = this.storeSync.reserve(name)?
    spawn runBackground<A>(this, slot, callback)
  }

  // Coalesces notifications without store I/O and fences in-flight reads.
  export invalidate() {
    let s = this.storeSync
    s.lifecycle.lock()
    defer s.lifecycle.unlock()
    if (s.stopping.load() != 0) {
      return
    }
    s.invalidated = s.invalidated + 1
    this.relationCache.invalidate()
    select {
      case s.wake <- true:
      default:
    }
  }

  // The stored policy called `name`, as it was saved, or None.
  export policy(name: string): Option<PolicyDoc>! {
    return this.store.policy(name)?
  }

  // Defines role `name` as the policies listed, in that order:
  // `authz.role("author", [readPublished, editOwn])?`. Returns the handle, so
  // roles chain. Every policy is checked as `validatePolicy` checks it, so
  // register the resources first. `probe` is the sample subject the policies
  // are run for; left out, a subject with every field empty. A name that is
  // not 1 to 64 characters of `[A-Za-z0-9_.-]`, or defined before, is an
  // InvalidPolicy. The role called "guest" is what `can` and `check` use for
  // `None`: its policies are run once, for `probe`, since a guest has no
  // attributes of its own. Every subject's cached rules are rebuilt on its
  // next check (rulecache.bit).
  export role<S: Subject>(
    name: string,
    policies: []Policy<S, A>,
    probe: Option<S> = Option<S>.None,
  ): Authz<A>! {
    let empty: S
    let sample = unwrapOr(probe, empty)
    let reg = this.registered()
    let def = buildRole<S, A>(reg.resources, reg.decls, name, policies, sample)?
    checkRoleName(name)?
    let guest = []Rule<A>(0)
    if (name == guestRole) {
      guest = guestRules<S, A>(policies, sample)
    }
    if (!this.state.cache.addRole(def, kindFor<S>(), guest)) {
      fail InvalidPolicy{ detail = "role ${name} defined twice" }
    }
    return this
  }

  // What `role` and `resource` have published, read under the cache's lock.
  registered(): Registry<A> {
    return this.state.cache.registry()
  }

  // The defined role names, sorted.
  export roleNames(): []string {
    return roleNamesIn<A>(this.registered().roles)
  }

  // Fails with an InvalidPolicy naming the first of `names` that no role
  // defines. Call it at startup with every role your identity provider can
  // issue, so one nothing defines stops the app instead of granting nothing.
  export checkRoles(names: []string): ()! {
    return checkRolesIn<A>(this.registered().roles, names)?
  }

  // The rules `s` has through its `roles`: each role's policies, each policy
  // once, in the order the roles list them. A role nothing defines and a
  // policy written for another subject class add no rules and a line to
  // `skipped`, so a subject can only lose access to a mistake.
  export rolesOf(s: Subject): Resolved<A> {
    return resolveRoles<A>(
      this.registered(),
      s,
      this.state.cache.none.held,
      false,
      this.tenant.name,
    )
  }

  // Fails with a `NotFilterable` naming the policy and label when a rule that
  // applies to resource `T` and `action` holds a code function (`canIf`), so a
  // test can assert at startup that listing `T` will work. Reads the rules
  // each role's policies make for the probe subject `role()` ran them with
  // (a policy that branches on the subject is checked for that branch), and
  // includes the guest role.
  export validateFilterable<T: Tabled>(action: A): ()! {
    return checkRolesFilterable<A>(
      this.registered().roles,
      T.__className(),
      actionName(action),
      this.wildcard,
    )?
  }

  // Writes this handle's records to `logger` (std/log's), in place of the
  // process default `getDefault()` that an unset handle uses. One DEBUG
  // `decision` record per decision names the outcome, action, resource,
  // subject id and deciding policy; an ERROR `invalid policy` record per
  // startup mistake met at request time; a refusal by `check` is one INFO
  // `denied` record in place of the decision's DEBUG one, and a relationship
  // store that cannot be reached is one ERROR `store unavailable` record. They
  // are for the server log, never for a client. A level the logger has off
  // builds nothing.
  export logTo(logger: Logger): Authz<A> {
    this.state.cache.setLogger(logger)
    return this
  }

  // Whether `user` may do `action` to `thing`: CASL's rules over the policies
  // of the user's roles. A refusal wins over any allow, no matching allow is
  // a refusal, and `None` is the guest. Never panics and never fails: a rule
  // that cannot be evaluated refuses and is logged (see `check` for the
  // error). Allocation: see rulecache.bit.
  export can<T: Tabled>(user: Option<Subject>, action: A, thing: T): bool {
    return decide<A, T>(this, user, action, thing, false).allowed
  }

  // The rows `user` may `action`, as one condition: `All`, `None` or
  // `Where(c)`, with `c` true for exactly the rows `can` allows (filter.bit
  // has the rules and the NULL reading). Compile `c` with `compileSql` as a
  // list's WHERE clause. Fails with a `NotFilterable` when a rule that
  // applies holds a code function (`canIf`), and with an `InvalidPolicy` when
  // one of the user's rules is a developer mistake, as `check` does.
  export filterFor<T: Tabled>(user: Option<Subject>, action: A): Filter! {
    return filterOf<A, T>(this, user, action)?
  }

  // `can` as an error: fails with a `Denied` naming the action and resource
  // (the policy that decided is for the log), or with an `InvalidPolicy`
  // naming the policy and rule when one of the user's rules is a developer
  // mistake. Use `authz.check(user, Action.Update, article)?` in a handler.
  // A rule that holds `related(...)` asks the relationship store, and a store
  // that cannot be reached fails `check` with `StoreUnavailable`.
  export check<T: Tabled>(user: Option<Subject>, action: A, thing: T): ()! {
    let d = decide<A, T>(this, user, action, thing, true)
    if (d.invalid) {
      fail InvalidPolicy{ detail = d.reason }
    }
    if (d.down) {
      fail StoreUnavailable{}
    }
    if (!d.allowed) {
      let denied = Denied{
        policy = d.policy,
        action = actionName(action),
        resource = T.__className(),
      }
      logDenied(loggerOf<A>(this.registered()), user, denied)
      fail denied
    }
  }
}
