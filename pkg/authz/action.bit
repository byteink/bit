// pkg/authz/action.bit — the app's own enum is the set of actions, and a
// policy stores an action by its variant NAME ("Publish"), never by tag.
//
//   enum Action { Manage, Read, Create, Update, Delete, Publish }
//
// Reordering the enum later changes no stored policy. Names are
// case-sensitive: "publish" is not "Publish", and a policy that says so is
// refused with the valid names listed, so a typo fails when the policy is
// saved rather than silently matching nothing.
//
// The bound is `ActionEnum`: the two members the compiler synthesizes on
// every payload-free enum (SPEC §14.7). `Manage`, when the enum declares it,
// is the wildcard that matches every action (`Authz.hasWildcard`).

import { join } from "std/strings"

// What an action enum provides. The compiler writes both members for any
// enum whose variants all carry no payload; nothing is implemented by hand.
export interface ActionEnum {
  __variantName(): string,
  static __variants(): []string,
}

// The variant name a policy stores for `a`.
export fn actionName<A: ActionEnum>(a: A): string {
  return a.__variantName()
}

// The position of `s` among A's variant names, or an InvalidPolicy naming
// `s` and listing every valid name. Exact match: case matters.
fn actionIndex<A: ActionEnum>(s: string): int! {
  let names = A.__variants()
  let i = 0
  while (i < len(names)) {
    if (names[i] == s) {
      return i
    }
    i = i + 1
  }
  fail InvalidPolicy{ detail = "unknown action '${s}'; valid actions: ${join(names, ", ")}" }
}
