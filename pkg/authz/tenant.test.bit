// pkg/authz/tenant.test.bit — tenant views (`forTenant`): which stored
// attachments and which relationship tuples a tenant sees, in both
// directions, and what a view may write.
//
// The helpers `st*` (store.test.bit) build the stored policies; `boot`
// (rebac.test.bit) the relation graph; `rd*` (condrelated.test.bit) the
// `related(...)` rule.

import { hasPrefix } from "std/strings"

fn tnView(a: Authz<Action>, tenant: string): Authz<Action> {
  return a.forTenant(tenant) catch e {
    panic("forTenant ${tenant}: ${e.message()}")
  }
}

fn tnAt(policy: string, role: string, tenant: string): Attachment {
  let at = stRole(policy, role)
  at.tenant = tenant
  return at
}

// Publish an Article of `team` is allowed by the policy `name`.
fn tnPolicy(a: Authz<Action>, name: string, effect: string, team: string) {
  stSave(a, stDoc(name, effect, ["Publish"], "{\"team\":\"${team}\"}"))
}

// A handle with PubA, PubB and PubG (each allows one team) attached to the
// role author in tenant a, tenant b and globally.
fn tnThree(): Authz<Action> {
  let a = stAuthz()
  let _ = a.subject<StUser>()
  tnPolicy(a, "PubA", "allow", "alpha")
  tnPolicy(a, "PubB", "allow", "beta")
  tnPolicy(a, "PubG", "allow", "gamma")
  stAttach(a, tnAt("PubA", "author", "a"))
  stAttach(a, tnAt("PubB", "author", "b"))
  stAttach(a, tnAt("PubG", "author", ""))
  return a
}

fn tnCan(a: Authz<Action>, team: string): bool {
  return stCan(a, stWho("sara", ["author"], "x"), stRow(team, "draft"))
}

// The message `forTenant` refuses `tenant` with, or "OK".
fn tnForErr(a: Authz<Action>, tenant: string): string {
  let _ = a.forTenant(tenant) catch e {
    return e.message()
  }
  return "OK"
}

test "a subject in tenant a sees a's attachments and the global ones, not b's" {
  let a = tnThree()
  let va = tnView(a, "a")
  assert(tnCan(va, "alpha"), "a sees its own grant")
  assert(tnCan(va, "gamma"), "a sees the global grant")
  assert(!tnCan(va, "beta"), "a does not see b's grant")
}

test "a subject in tenant b sees b's attachments and the global ones, not a's" {
  let a = tnThree()
  let vb = tnView(a, "b")
  assert(tnCan(vb, "beta"), "b sees its own grant")
  assert(tnCan(vb, "gamma"), "b sees the global grant")
  assert(!tnCan(vb, "alpha"), "b does not see a's grant")
}

test "the plain handle sees only the global attachments" {
  let a = tnThree()
  assert(tnCan(a, "gamma"), "global grant")
  assert(!tnCan(a, "alpha") && !tnCan(a, "beta"), "no tenant's grant leaks to the plain handle")
}

test "a tenant with no attachments of its own sees the global ones alone" {
  let a = tnThree()
  let vc = tnView(a, "c")
  assert(tnCan(vc, "gamma"), "global grant")
  assert(!tnCan(vc, "alpha") && !tnCan(vc, "beta"), "neither a's nor b's")
}

test "one subject asking in turn in two tenants and globally gets each tenant's answer from a warm cache" {
  let a = tnThree()
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  let rounds = 0
  while (rounds < 3) {
    assert(tnCan(va, "alpha") && !tnCan(va, "beta"), "a, round ${rounds}")
    assert(tnCan(vb, "beta") && !tnCan(vb, "alpha"), "b, round ${rounds}")
    assert(!tnCan(a, "alpha") && !tnCan(a, "beta"), "plain, round ${rounds}")
    rounds = rounds + 1
  }
}

test "the same policy attached in a, b and globally applies once and is the same grant in each" {
  let a = stAuthz()
  tnPolicy(a, "PubAll", "allow", "alpha")
  for t of ["a", "b", ""] {
    stAttach(a, tnAt("PubAll", "author", t))
  }
  assert(tnCan(tnView(a, "a"), "alpha"), "a")
  assert(tnCan(tnView(a, "b"), "alpha"), "b")
  assert(tnCan(a, "alpha"), "global")
  let rules = tnView(a, "a").rolesOf(unwrap(stWho("sara", ["author"], "x"))).rules
  assert(len(rules) == 1, "one rule, not three: ${len(rules)}")
}

test "a global deny beats a tenant allow and a tenant deny beats a global allow" {
  let a = stAuthz()
  tnPolicy(a, "AllowG", "allow", "alpha")
  tnPolicy(a, "DenyG", "deny", "beta")
  tnPolicy(a, "AllowT", "allow", "beta")
  tnPolicy(a, "DenyT", "deny", "alpha")
  stAttach(a, tnAt("AllowG", "author", ""))
  stAttach(a, tnAt("DenyG", "author", ""))
  stAttach(a, tnAt("AllowT", "author", "a"))
  stAttach(a, tnAt("DenyT", "author", "a"))
  let va = tnView(a, "a")
  assert(!tnCan(va, "beta"), "global deny wins over the tenant's allow")
  assert(!tnCan(va, "alpha"), "tenant deny wins over the global allow")
  assert(tnCan(tnView(a, "b"), "alpha"), "the deny is a's alone")
}

// Whether the filter keeps an Article of `team`.
fn tnKeeps(f: Filter, team: string): bool {
  return match (f) {
    All => true
    None => false
    Where(c) => isTrueTruth(
      evalCond<Article>(c, stRow(team, "draft")) catch e {
        panic("evalCond: ${e.message()}")
      },
    )
  }
}

fn tnFilter(a: Authz<Action>): Filter {
  return a.filterFor<Article>(stWho("sara", ["author"], "x"), Action.Publish) catch e {
    panic("filterFor: ${e.message()}")
  }
}

test "filterFor on a view folds in that tenant's rules and not another's" {
  let a = tnThree()
  let inA = tnFilter(tnView(a, "a"))
  let inC = tnFilter(tnView(a, "c"))
  let plain = tnFilter(a)
  assert(tnKeeps(inA, "alpha") && tnKeeps(inA, "gamma") && !tnKeeps(inA, "beta"), "a")
  assert(!tnKeeps(inC, "alpha") && tnKeeps(inC, "gamma") && !tnKeeps(inC, "beta"), "c")
  assert(!tnKeeps(plain, "alpha") && tnKeeps(plain, "gamma") && !tnKeeps(plain, "beta"), "plain")
}

test "an attachment made after the view was created shows in it, and detach revokes it there only" {
  let a = tnThree()
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  assert(!tnCan(va, "delta") && !tnCan(vb, "delta"), "not yet")
  tnPolicy(a, "PubD", "allow", "delta")
  stAttach(a, tnAt("PubD", "author", "a"))
  assert(tnCan(va, "delta") && !tnCan(vb, "delta"), "a gained it, b did not")
  a.detach(tnAt("PubD", "author", "a")) catch e {
    panic("detach: ${e.message()}")
  }
  assert(!tnCan(va, "delta"), "detached")
}

test "the guest has the stored policies attached to the role guest, global and its tenant's, not another's" {
  let a = stAuthz()
  tnPolicy(a, "GuestA", "allow", "alpha")
  tnPolicy(a, "GuestG", "allow", "gamma")
  stAttach(a, tnAt("GuestA", "guest", "a"))
  stAttach(a, tnAt("GuestG", "guest", ""))
  let none = Option<Subject>.None
  let row = (team: string) => stRow(team, "draft")
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  let rounds = 0
  while (rounds < 2) {
    assert(va.can<Article>(none, Action.Publish, row("alpha")), "a's guest, round ${rounds}")
    assert(
      va.can<Article>(none, Action.Publish, row("gamma")),
      "global guest in a, round ${rounds}",
    )
    assert(
      !vb.can<Article>(none, Action.Publish, row("alpha")),
      "b's guest has no a grant, round ${rounds}",
    )
    assert(
      vb.can<Article>(none, Action.Publish, row("gamma")),
      "global guest in b, round ${rounds}",
    )
    assert(!a.can<Article>(none, Action.Publish, row("alpha")), "plain guest, round ${rounds}")
    rounds = rounds + 1
  }
}

test "a view writes its own tenant's attachments: an empty tenant is stamped, another tenant is refused" {
  let a = tnThree()
  tnPolicy(a, "PubD", "allow", "delta")
  let va = tnView(a, "a")
  va.attach(tnAt("PubD", "author", "")) catch e {
    panic("attach: ${e.message()}")
  }
  let mem = stMem(a)
  let mine = mem.attachments("a") catch e {
    panic(e.message())
  }
  let global = mem.attachments("") catch e {
    panic(e.message())
  }
  assert(len(mine) == 2 && len(global) == 1, "a has ${len(mine)}, global ${len(global)}")
  assert(
    tnCan(va, "delta") && !tnCan(tnView(a, "b"), "delta") && !tnCan(a, "delta"),
    "applies in a only",
  )
  let bad = stAttachErr(va, tnAt("PubD", "author", "b"))
  assert(bad == "invalid policy: /tenant: this view writes only the attachments of tenant 'a'", bad)
  let det = ""
  va.detach(tnAt("PubD", "author", "b")) catch e {
    det = e.message()
  }
  assert(det == bad, det)
}

test "the plain handle attaches for any tenant and a view cannot attach globally" {
  let a = tnThree()
  tnPolicy(a, "PubD", "allow", "delta")
  stAttach(a, tnAt("PubD", "author", "z"))
  assert(tnCan(tnView(a, "z"), "delta") && !tnCan(a, "delta"), "written for z")
}

test "savePolicy is refused on a tenant's view and allowed on the empty tenant's" {
  let a = stAuthz()
  let va = tnView(a, "a")
  let doc = stDoc("P", "allow", ["Publish"], "{\"team\":\"alpha\"}")
  let r = stSaveErr(va, doc)
  assert(
      r ==
      "invalid policy: a policy is global: save it on the handle, not on the view for tenant 'a'",
    r,
  )
  assert(stSaveErr(tnView(a, ""), doc) == "OK", "the empty tenant is the handle")
  let got = a.policy("P") catch e {
    panic(e.message())
  }
  assert(isSome(got), "saved by the global view")
}

test "3 of 3 invalid tenant strings are refused and the empty and a well-formed one are accepted" {
  let a = stAuthz()
  let long = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  assert(len(long) == 65, "65 characters")
  for t of ["a b", long, "a;b"] {
    let r = tnForErr(a, t)
    assert(hasPrefix(r, "invalid policy: tenant: "), "'${t}': ${r}")
  }
  assert(tnForErr(a, "") == "OK", "empty is global")
  assert(tnForErr(a, "Inkwell_2.eu-1") == "OK", "well-formed")
  assert(tnForErr(a, long[0:64]) == "OK", "64 is the limit")
}

test "a view of a view is a view of the new tenant, not of both" {
  let a = tnThree()
  let vb = tnView(tnView(a, "a"), "b")
  assert(tnCan(vb, "beta") && !tnCan(vb, "alpha"), "b")
}

// --- relationship tuples ----------------------------------------------------

test "a tuple written in tenant a is invisible in tenant b, in the plain handle, and the other way round" {
  let a = graph()
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  put(va, "user:sara", "editor", "shelf:launch")
  assert(has(va, "user:sara", "editor", "shelf:launch"), "a sees it")
  assert(!has(vb, "user:sara", "editor", "shelf:launch"), "b does not")
  assert(!has(a, "user:sara", "editor", "shelf:launch"), "the plain handle does not")
  put(vb, "user:bob", "editor", "shelf:launch")
  assert(has(vb, "user:bob", "editor", "shelf:launch"), "b sees its own")
  assert(!has(va, "user:bob", "editor", "shelf:launch"), "a does not see b's")
  put(a, "user:amy", "editor", "shelf:launch")
  assert(
      !has(va, "user:amy", "editor", "shelf:launch") &&
      !has(vb, "user:amy", "editor", "shelf:launch"),
    "global tuples are a namespace of their own",
  )
}

test "related and the direct tuple check are per tenant too" {
  let a = graph()
  let va = tnView(a, "a")
  put(va, "user:sara", "editor", "shelf:launch")
  let inA = va.related("user:sara", "editor", "shelf:launch") catch e {
    panic(e.message())
  }
  let inB = tnView(a, "b").related("user:sara", "editor", "shelf:launch") catch e {
    panic(e.message())
  }
  assert(inA && !inB, "related: a ${inA}, b ${inB}")
}

test "the same tuple in two tenants is two tuples: unrelate in one leaves the other" {
  let a = graph()
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  put(va, "user:sara", "editor", "shelf:launch")
  put(vb, "user:sara", "editor", "shelf:launch")
  va.unrelate("user:sara", "editor", "shelf:launch") catch e {
    panic(e.message())
  }
  assert(!has(va, "user:sara", "editor", "shelf:launch"), "gone in a")
  assert(has(vb, "user:sara", "editor", "shelf:launch"), "still in b")
}

test "the walk never leaves the tenant: a userset and an inherited relation read that tenant's tuples only" {
  let a = graph()
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  put(va, "crew:eng#member", "editor", "shelf:f0")
  put(vb, "user:sara", "member", "crew:eng")
  assert(!has(va, "user:sara", "editor", "shelf:f0"), "membership is b's, the grant is a's")
  put(va, "user:sara", "member", "crew:eng")
  assert(has(va, "user:sara", "editor", "shelf:f0"), "both in a")
  assert(!has(vb, "user:sara", "editor", "shelf:f0"), "b has the membership, not the grant")
  put(va, "shelf:f1", "parent", "shelf:f0")
  put(vb, "user:bob", "editor", "shelf:f1")
  assert(
    !has(va, "user:bob", "editor", "shelf:f0"),
    "the parent chain and the editor are in different tenants",
  )
}

test "a related(...) condition asks the relationship store of the view's tenant" {
  let a = rdBoot(false)
  let va = tnView(a, "a")
  let vb = tnView(a, "b")
  rdPut(va, "user:sara", "editor", "rdFolder:1")
  rdPut(vb, "user:bob", "editor", "rdFolder:1")
  let sara = rdUser("sara")
  let bob = rdUser("bob")
  assert(va.can<RdArticle>(sara, Action.Update, rdIn(1)), "sara edits in a")
  assert(!vb.can<RdArticle>(sara, Action.Update, rdIn(1)), "sara is not an editor in b")
  assert(!a.can<RdArticle>(sara, Action.Update, rdIn(1)), "nor globally")
  assert(vb.can<RdArticle>(bob, Action.Update, rdIn(1)), "bob edits in b")
  assert(!va.can<RdArticle>(bob, Action.Update, rdIn(1)), "bob is not an editor in a")
}

test "a MemoryRelationStore keeps tenants apart and a write in any of them moves the one version" {
  let s = MemoryRelationStore()
  let t = Tuple{ subject = "user:sara", relation = "editor", object = "shelf:a" }
  s.write("a", t) catch e {
    panic(e.message())
  }
  let v1 = s.version() catch e {
    panic(e.message())
  }
  let inA = s.has("a", t) catch e {
    panic(e.message())
  }
  let inB = s.has("b", t) catch e {
    panic(e.message())
  }
  let inG = s.has("", t) catch e {
    panic(e.message())
  }
  assert(inA && !inB && !inG, "has: ${inA} ${inB} ${inG}")
  let directB = s.direct("b", "shelf:a", "editor", 0, 10) catch e {
    panic(e.message())
  }
  let listB = s.list("b", "user:sara") catch e {
    panic(e.message())
  }
  let listA = s.list("a", "user:sara") catch e {
    panic(e.message())
  }
  assert(len(directB) == 0 && len(listB) == 0 && len(listA) == 1, "direct/list are per tenant")
  s.write("b", t) catch e {
    panic(e.message())
  }
  s.delete("a", t) catch e {
    panic(e.message())
  }
  let v2 = s.version() catch e {
    panic(e.message())
  }
  let stillB = s.has("b", t) catch e {
    panic(e.message())
  }
  assert(stillB && v2 == v1 + 2, "b survives a's delete; version ${v1} -> ${v2}")
}
