// pkg/authz/authz.test.bit — Authz<A> construction, the Manage wildcard and
// the CRUD variants it records.

enum Plain { Read, Publish }

test "an enum with Manage has the wildcard" {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  assert(a.hasWildcard(), "Manage not seen")
}

test "an enum without Manage has no wildcard" {
  let a = Authz<Plain>() catch e {
    panic("Authz: ${e.message()}")
  }
  assert(!a.hasWildcard(), "wildcard reported without a Manage variant")
}

test "the CRUD variants an enum declares are recorded" {
  let full = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  assert(
    full.crud.read && full.crud.create && full.crud.update && full.crud.delete,
    "4 of 4 expected",
  )
  let part = Authz<Plain>() catch e {
    panic("Authz: ${e.message()}")
  }
  assert(part.crud.read, "Read missing")
  assert(!part.crud.create && !part.crud.update && !part.crud.delete, "only Read exists")
}

test "a non-empty store is StoreUnavailable until the store tickets land" {
  let _ = Authz<Action>(store = "memory://policies") catch e {
    assert(e.message() == "authorization unavailable", "message: ${e.message()}")
    return
  }
  assert(false, "opened a store that cannot exist yet")
}
