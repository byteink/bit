// pkg/authz/cellex.test.bit — the CEL subset lexer: 12 sources that lex to
// exact token lists with byte spans, 8 that are refused at the right byte.

import { join, repeat } from "std/strings"

// A token without a payload, by name.
fn plainName(t: CelTok): string {
  match (t) {
    Null => return "Null"
    LParen => return "LParen"
    RParen => return "RParen"
    LBracket => return "LBracket"
    RBracket => return "RBracket"
    Comma => return "Comma"
    Dot => return "Dot"
    _ => return "Eof"
  }
}

// One token as `Kind(payload)@start-end`.
fn showTok(t: CelSpanTok): string {
  let body = ""
  match (t.tok) {
    Ident(s) => body = "Ident(${s})"
    Str(s) => body = "Str(${s})"
    Int(n) => body = "Int(${n})"
    Float(f) => body = "Float(${f})"
    Bool(b) => body = "Bool(${b})"
    Op(s) => body = "Op(${s})"
    _ => body = plainName(t.tok)
  }
  return "${body}@${t.start}-${t.end}"
}

// The whole lex as one line, or the error's message.
fn lexed(src: string): string {
  let toks = lexCel(src) catch e {
    return e.message()
  }
  let parts = []string(0)
  for t of toks {
    parts = append(parts, showTok(t))
  }
  return join(parts, " ")
}

test "12 of 12 valid sources lex to the expected tokens" {
  let srcs = [
    "resource.ownerId == subject.id",
    "a != 'x' && b || !c",
    "n < 10 && n <= 10 && n > 1 && n >= 1",
    "role in ['admin', \"editor\"]",
    "true",
    "false",
    "null",
    "3.25e2",
    "  42  ",
    "'a\\nb\\t\\\\\\'\\\"\\u00e9'",
    "(a)",
    "",
  ]
  let want = [
    "Ident(resource)@0-8 Dot@8-9 Ident(ownerId)@9-16 Op(==)@17-19 Ident(subject)@20-27 Dot@27-28 Ident(id)@28-30 Eof@30-30",
    "Ident(a)@0-1 Op(!=)@2-4 Str(x)@5-8 Op(&&)@9-11 Ident(b)@12-13 Op(||)@14-16 Op(!)@17-18 Ident(c)@18-19 Eof@19-19",
    "Ident(n)@0-1 Op(<)@2-3 Int(10)@4-6 Op(&&)@7-9 Ident(n)@10-11 Op(<=)@12-14 Int(10)@15-17 Op(&&)@18-20 Ident(n)@21-22 Op(>)@23-24 Int(1)@25-26 Op(&&)@27-29 Ident(n)@30-31 Op(>=)@32-34 Int(1)@35-36 Eof@36-36",
    "Ident(role)@0-4 Op(in)@5-7 LBracket@8-9 Str(admin)@9-16 Comma@16-17 Str(editor)@18-26 RBracket@26-27 Eof@27-27",
    "Bool(true)@0-4 Eof@4-4",
    "Bool(false)@0-5 Eof@5-5",
    "Null@0-4 Eof@4-4",
    "Float(325)@0-6 Eof@6-6",
    "Int(42)@2-4 Eof@6-6",
    "Str(a\nb\t\\'\"é)@0-20 Eof@20-20",
    "LParen@0-1 Ident(a)@1-2 RParen@2-3 Eof@3-3",
    "Eof@0-0",
  ]
  assert(len(srcs) == 12, "sources: ${len(srcs)}")
  assert(len(want) == 12, "expected lists: ${len(want)}")
  let i = 0
  while (i < len(srcs)) {
    let got = lexed(srcs[i])
    assert(got == want[i], "source ${i} '${srcs[i]}'\n got:  ${got}\n want: ${want[i]}")
    i = i + 1
  }
}

// The message `lexCel` fails with, "" when it succeeds.
fn failure(src: string): string {
  let _ = lexCel(src) catch e {
    return e.message()
  }
  return ""
}

test "8 of 8 invalid sources fail at the right byte" {
  let srcs = [
    "a == 1 && b # c",
    "x == 'abc",
    "x == '\\q'",
    "x == 12u",
    "x == '''abc'''",
    "x == b'abc'",
    repeat("a", 4097),
    repeat("a ", 513),
  ]
  let want = [
    "invalid policy: cel: unexpected character '#' at byte 12",
    "invalid policy: cel: unterminated string at byte 5",
    "invalid policy: cel: invalid escape sequence at byte 6",
    "invalid policy: cel: unsigned integer literals are not supported at byte 7",
    "invalid policy: cel: triple-quoted strings are not supported at byte 5",
    "invalid policy: cel: bytes and raw string literals are not supported at byte 5",
    "invalid policy: cel: source exceeds 4096 bytes at byte 4096",
    "invalid policy: cel: more than 512 tokens at byte 1024",
  ]
  assert(len(srcs) == 8, "sources: ${len(srcs)}")
  assert(len(want) == 8, "expected errors: ${len(want)}")
  let i = 0
  while (i < len(srcs)) {
    let got = failure(srcs[i])
    assert(got == want[i], "source ${i}\n got:  ${got}\n want: ${want[i]}")
    i = i + 1
  }
}

test "the limits are inclusive: 4096 bytes and 512 tokens lex" {
  assert(failure(repeat("a", 4096)) == "", "4096 bytes refused")
  let toks = lexCel(repeat("a ", 512)) catch e {
    panic("512 tokens refused: ${e.message()}")
  }
  assert(len(toks) == 513, "512 tokens and Eof: ${len(toks)}")
}

test "the error is an InvalidPolicy" {
  let _ = lexCel("#") catch e {
    assert(
      e.message() == "invalid policy: cel: unexpected character '#' at byte 0",
      "message: ${e.message()}",
    )
    return
  }
  assert(false, "'#' lexed")
}

test "bytes outside printable ASCII are shown as hex, not echoed" {
  assert(
    failure("a\x01") == "invalid policy: cel: unexpected character '\\x01' at byte 1",
    "control byte",
  )
  assert(
    failure("é") == "invalid policy: cel: unexpected character '\\xc3' at byte 0",
    "non-ASCII byte",
  )
}

test "numbers: dot after an integer is a token, a leading dot starts a float" {
  assert(lexed("1.") == "Int(1)@0-1 Dot@1-2 Eof@2-2", lexed("1."))
  assert(lexed(".5") == "Float(0.5)@0-2 Eof@2-2", lexed(".5"))
  assert(lexed("1e3") == "Float(1000)@0-3 Eof@3-3", lexed("1e3"))
  assert(failure("1e") == "invalid policy: cel: unexpected character 'e' at byte 1", failure("1e"))
  assert(
    failure("0x1F") == "invalid policy: cel: hexadecimal integers are not supported at byte 0",
    failure("0x1F"),
  )
  assert(
    failure("9223372036854775808") == "invalid policy: cel: integer out of range at byte 0",
    failure("9223372036854775808"),
  )
  assert(
    lexed("9223372036854775807") == "Int(9223372036854775807)@0-19 Eof@19-19",
    lexed("9223372036854775807"),
  )
  assert(failure("1e999") == "invalid policy: cel: float out of range at byte 0", failure("1e999"))
}

test "operators are maximal munch and a lone = & | is refused" {
  assert(lexed("<=>=") == "Op(<=)@0-2 Op(>=)@2-4 Eof@4-4", lexed("<=>="))
  assert(lexed("!=!") == "Op(!=)@0-2 Op(!)@2-3 Eof@3-3", lexed("!=!"))
  assert(
    failure("a = b") == "invalid policy: cel: unexpected character '=' at byte 2",
    failure("a = b"),
  )
  assert(
    failure("a & b") == "invalid policy: cel: unexpected character '&' at byte 2",
    failure("a & b"),
  )
  assert(
    failure("a | b") == "invalid policy: cel: unexpected character '|' at byte 2",
    failure("a | b"),
  )
}

test "strings: empty, either quote, raw and prefixed forms, bad unicode" {
  assert(lexed("''") == "Str()@0-2 Eof@2-2", lexed("''"))
  assert(lexed("\"it's\"") == "Str(it's)@0-6 Eof@6-6", lexed("\"it's\""))
  assert(
      failure("r'a'") ==
      "invalid policy: cel: bytes and raw string literals are not supported at byte 0",
    failure("r'a'"),
  )
  assert(
      failure("BR\"a\"") ==
      "invalid policy: cel: bytes and raw string literals are not supported at byte 0",
    failure("BR\"a\""),
  )
  assert(lexed("br") == "Ident(br)@0-2 Eof@2-2", lexed("br"))
  assert(
      failure("'\\ud800'") ==
      "invalid policy: cel: invalid unicode code point in \\u escape at byte 1",
    failure("'\\ud800'"),
  )
  assert(
    failure("'\\u12'") == "invalid policy: cel: invalid \\u escape at byte 1",
    failure("'\\u12'"),
  )
  assert(
    failure("'a\nb'") == "invalid policy: cel: unterminated string at byte 0",
    failure("'a\nb'"),
  )
  assert(failure("'\\'") == "invalid policy: cel: unterminated string at byte 0", failure("'\\'"))
}

test "a literal with an escape is rebuilt once: a 4000-byte one lexes fast" {
  let body = repeat("ab\\n", 1000)
  let toks = lexCel("'${body}'") catch e {
    panic(e.message())
  }
  assert(len(toks) == 2, "tokens: ${len(toks)}")
}

test "arithmetic, ternary and brace punctuation lex as operators; comments are skipped" {
  assert(
    lexed("n > -5") == "Ident(n)@0-1 Op(>)@2-3 Op(-)@4-5 Int(5)@5-6 Eof@6-6",
    lexed("n > -5"),
  )
  assert(
      lexed("a + b * c / d % e ? f : {}") ==
      "Ident(a)@0-1 Op(+)@2-3 Ident(b)@4-5 Op(*)@6-7 Ident(c)@8-9 Op(/)@10-11 Ident(d)@12-13 Op(%)@14-15 Ident(e)@16-17 Op(?)@18-19 Ident(f)@20-21 Op(:)@22-23 Op({)@24-25 Op(})@25-26 Eof@26-26",
    lexed("a + b * c / d % e ? f : {}"),
  )
  assert(
    lexed("a // note\n&& b // end") == "Ident(a)@0-1 Op(&&)@10-12 Ident(b)@13-14 Eof@21-21",
    lexed("a // note\n&& b // end"),
  )
  assert(lexed("// only") == "Eof@7-7", lexed("// only"))
}
