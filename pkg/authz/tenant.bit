// pkg/authz/tenant.bit — tenant views. One `Authz` serves every tenant of a
// multi-tenant app; a request narrows it to its own:
//
//   let mine = authz.forTenant(currentTenant(c))?
//   mine.check(user, Action.Update, article)?
//
// WHAT A TENANT SEES.
//
//  - Code policies and roles are global: they apply in every tenant.
//  - A stored attachment with `tenant = ""` is global and applies in every
//    tenant; one with `tenant = "inkwell"` applies inside the view for
//    "inkwell" and nowhere else. A tenant never sees another tenant's
//    attachments (stored.bit has the lookup).
//  - Relationship tuples live in one tenant: `relate`, `unrelate`, `related`
//    and `hasRelation` on a view read and write that tenant's tuples only, and
//    the walk behind `hasRelation` and `related(...)` conditions never leaves
//    them. The plain handle works in the global namespace "", which is a
//    namespace of its own: the tuples there are not inherited by any tenant.
//
// WHAT A VIEW MAY WRITE. `attach` and `detach` on a view write that tenant's
// attachments: an attachment that says `tenant = ""` is stamped with the
// view's tenant, one that names another tenant is an InvalidPolicy, so a
// tenant's admin endpoint can never attach globally or for someone else.
// `savePolicy` is refused on a view: a policy is global, one name for every
// tenant, and saving over it would change what other tenants are allowed.
// Save policies, and attach globally, on the plain handle.
//
// THE MODEL. AWS IAM evaluation logic decides across every policy that
// applies, global or not: an explicit deny from any of them wins, an allow
// needs a match, no match is a refusal
// (https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic.html),
// which is decide.bit's rule, so a global deny cannot be allowed back inside
// a tenant. Tuples follow OpenFGA's tenancy by separation: one tenant's tuples
// are a store of their own and a check reads exactly one.
//
// COST. A view is one small object over the same registry, rule cache, store
// and relationship store; creating one per request is cheap. Its checks are
// cached like the plain handle's, in the same table: the tenant is part of the
// key (rulecache.bit), so two tenants never share an entry.

import { xxhash64 } from "std/hash"

// A tenant name and the hash of it, computed once when the view is made. The
// hash is mixed into the rule cache's key so one subject asking in two tenants
// does not fight for one slot; the name is compared on a hit, so a hash
// collision cannot hand one tenant another's rules. The global tenant has the
// empty name and hash 0, which leaves the plain handle's keys as they were.
//
// `slot` is the tenant's cell in the rule cache's epoch table (rulecache.bit):
// a write in one tenant bumps its cell, so only the entries stamped with that
// cell go stale. Two tenants may share a cell (there are `tenantSlots`, however
// many tenants there are); the cost is one spurious rebuild, never a wrong
// answer. The global tenant has a cell of its own that nothing bumps, since a
// global write bumps the whole cache's version instead.
class TenantKey {
  name: string,
  hash: u64,
  slot: int,
}

// How many epoch cells there are besides the global one.
const tenantSlots: int = 1024

fn tenantSlotOf(hash: u64): int {
  return int(hash % u64(tenantSlots))
}

fn globalTenant(): TenantKey {
  return TenantKey{ name = "", hash = 0, slot = tenantSlots }
}

// The key for `tenant`: empty (global) or 1 to 64 characters of
// `[A-Za-z0-9_.-]`, the alphabet attachments' tenants have (doc.bit), else an
// InvalidPolicy. That keeps a tenant name free of anything a SQL string, a
// Redis key or a log line could be hurt by.
fn tenantKeyOf(tenant: string): TenantKey! {
  if (tenant == "") {
    return globalTenant()
  }
  let why = nameFault(tenant)
  if (why != "") {
    fail InvalidPolicy{ detail = "tenant: ${why}" }
  }
  let h = xxhash64([]byte(tenant))
  return TenantKey{ name = tenant, hash = h, slot = tenantSlotOf(h) }
}

// `a` as written in the view for `view`: the plain handle (view "") writes
// whatever tenant the attachment names; a tenant's view writes its own and
// refuses any other.
fn attachmentIn(view: string, a: Attachment): Attachment! {
  if (view == "" || a.tenant == view) {
    return a
  }
  if (a.tenant != "") {
    fail InvalidPolicy{ detail = "/tenant: this view writes only the attachments of tenant '${view}'" }
  }
  return Attachment{ policy = a.policy, to = a.to, tenant = view }
}
