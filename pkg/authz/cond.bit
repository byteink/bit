// pkg/authz/cond.bit — the one condition model. A policy's `when` part is a
// small tree of data: `Cond`. The same tree answers "may this user touch
// THIS row" (condeval.bit) and, in a later ticket, becomes the WHERE clause
// of a list query, so a single check and a filtered list cannot disagree.
//
//   let mine = eq("authorId", Value.Text(user.id))
//   let open = and([mine, ne("status", Value.Text("archived"))])
//
// A condition names fields as text and the tree is built before anything
// knows which resource it is for. `Authz.validate` is where it meets the
// registered resource: an unknown field or a value of the wrong type is an
// InvalidPolicy there, at startup, not a silent non-match at request time.
//
// `Custom` is the escape hatch: a code function (condcustom.bit). It answers
// a single check but has no SQL form, so a list read over it fails with
// `NotFilterable`.
//
// Every consumer `match`es `Cond` exhaustively, so a variant added later
// (relations, custom code) is a compile error until each
// consumer handles it.
//
// SEMANTICS. A comparison against NULL (an `Option` field that is `None`) is
// neither true nor false but unknown, exactly as in SQL; `and`, `or` and
// `not` follow SQL's three-valued logic. See condeval.bit.
//
// Constructors simplify only what cannot hide a mistake: an empty `and` is
// True, an empty `or` is False, a one-child `and`/`or` is the child, True
// is dropped from an `and`, False from an `or`, and `not(not(c))` is `c`.
// `and([False, c])` is NOT folded to False: that would delete `c`, and with it
// a typo'd field `validate` would have refused.

import { Op, Where, Clause } from "std/where"

// What a comparison is made against: a value written into the tree (`Lit`) or
// a stored condition's `$user.<path>` placeholder (`Param`, holding the path),
// which `bind` (condparam.bit) replaces by the asking subject's value before
// the tree is evaluated. Code built conditions are all `Lit`.
export enum Operand {
  Lit(Value),
  Param(string),
}

export enum Cond {
  True,
  False,
  Cmp(string, Op, []Operand),
  And([]Cond),
  Or([]Cond),
  Not(Cond),
  Custom(string, (AnyRow) => bool),
}

// `vs` as literal operands.
fn litsOf(vs: []Value): []Operand {
  let out = []Operand(0)
  for v of vs {
    out = append(out, Operand.Lit(v))
  }
  return out
}

// `field == v`.
export fn eq(field: string, v: Value): Cond {
  return Cond.Cmp(field, Op.Eq, litsOf([v]))
}

// `field != v`.
export fn ne(field: string, v: Value): Cond {
  return Cond.Cmp(field, Op.Ne, litsOf([v]))
}

// `field` equals any of `vs`. An empty list is refused by `validate` and by
// evaluation, as std/where's `Clause` refuses it.
export fn oneOf(field: string, vs: []Value): Cond {
  return Cond.Cmp(field, Op.In, litsOf(vs))
}

// `field < v`.
export fn lt(field: string, v: Value): Cond {
  return Cond.Cmp(field, Op.Lt, litsOf([v]))
}

// `field <= v`.
export fn lte(field: string, v: Value): Cond {
  return Cond.Cmp(field, Op.Lte, litsOf([v]))
}

// `field > v`.
export fn gt(field: string, v: Value): Cond {
  return Cond.Cmp(field, Op.Gt, litsOf([v]))
}

// `field >= v`.
export fn gte(field: string, v: Value): Cond {
  return Cond.Cmp(field, Op.Gte, litsOf([v]))
}

fn isTrue(c: Cond): bool {
  return match (c) {
    True => true
    _ => false
  }
}

fn isFalse(c: Cond): bool {
  return match (c) {
    False => true
    _ => false
  }
}

// `cs` minus its True children (`dropTrue`) or its False children.
fn without(cs: []Cond, dropTrue: bool): []Cond {
  let out = []Cond(0)
  for c of cs {
    if (dropTrue && isTrue(c)) {
      continue
    }
    if (!dropTrue && isFalse(c)) {
      continue
    }
    out = append(out, c)
  }
  return out
}

// Every child must hold. No children: True.
export fn and(cs: []Cond): Cond {
  let kept = without(cs, true)
  if (len(kept) == 0) {
    return Cond.True
  }
  if (len(kept) == 1) {
    return kept[0]
  }
  return Cond.And(kept)
}

// At least one child must hold. No children: False.
export fn or(cs: []Cond): Cond {
  let kept = without(cs, false)
  if (len(kept) == 0) {
    return Cond.False
  }
  if (len(kept) == 1) {
    return kept[0]
  }
  return Cond.Or(kept)
}

// The opposite of `c`. Unknown stays unknown.
export fn not(c: Cond): Cond {
  return match (c) {
    True => Cond.False
    False => Cond.True
    Not(inner) => inner
    _ => Cond.Not(c)
  }
}

fn clauseCond(c: Clause): Cond {
  return Cond.Cmp(c.field, c.op, litsOf(c.values))
}

// The `Where` tree as a `Cond`, one node for one. A `Where` with no clauses
// and no children matches everything whatever its join (std/where), so it is
// True, not an empty `or`. `T` is std/where's phantom: it ties the literal to
// the class and has no part in the result.
export fn fromWhere<T: Tabled>(w: Where<T>): Cond {
  let parts = []Cond(0)
  for cl of w.clauses {
    parts = append(parts, clauseCond(cl))
  }
  for ch of w.children {
    parts = append(parts, fromWhere<T>(ch))
  }
  let c = Cond.True
  if (len(parts) > 0) {
    c = match (w.join) {
      And => and(parts)
      Or => or(parts)
    }
  }
  if (w.not) {
    return not(c)
  }
  return c
}
