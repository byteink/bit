// pkg/authz/cond.test.bit — the Cond constructors, their simplifications and
// fromWhere over std/where.

import { Join } from "std/where"

@table class Doc {
  @id
  id: i64
  owner: string
  kind: string
}

fn cnShape(c: Cond): string {
  return match (c) {
    True => "True"
    False => "False"
    Cmp(f, op, vs) => "Cmp(${f},${cnOp(op)},${len(vs)})"
    And(cs) => "And(${cnList(cs)})"
    Or(cs) => "Or(${cnList(cs)})"
    Not(inner) => "Not(${cnShape(inner)})"
    Known(inner) => "Known(${cnShape(inner)})"
    Custom(label, _) => "Custom(${label})"
  }
}

fn cnList(cs: []Cond): string {
  let parts = []string(0)
  for c of cs {
    parts = append(parts, cnShape(c))
  }
  return join(parts, " ")
}

fn cnOp(op: Op): string {
  return match (op) {
    Eq => "eq"
    Ne => "ne"
    In => "in"
    Lt => "lt"
    Lte => "lte"
    Gt => "gt"
    Gte => "gte"
  }
}

fn cnA(): Cond {
  return eq("owner", Value.Text("a"))
}

fn cnB(): Cond {
  return ne("kind", Value.Text("b"))
}

test "the 7 comparison constructors build one Cmp each" {
  let v = Value.Int(1)
  let got = [
    cnShape(eq("f", v)),
    cnShape(ne("f", v)),
    cnShape(oneOf("f", [v, v])),
    cnShape(lt("f", v)),
    cnShape(lte("f", v)),
    cnShape(gt("f", v)),
    cnShape(gte("f", v)),
  ]
  let want = [
    "Cmp(f,eq,1)",
    "Cmp(f,ne,1)",
    "Cmp(f,in,2)",
    "Cmp(f,lt,1)",
    "Cmp(f,lte,1)",
    "Cmp(f,gt,1)",
    "Cmp(f,gte,1)",
  ]
  let i = 0
  while (i < len(want)) {
    assert(got[i] == want[i], "got ${got[i]}, want ${want[i]}")
    i = i + 1
  }
}

test "and and or simplify the empty and one-child cases" {
  assert(cnShape(and([])) == "True", "empty and")
  assert(cnShape(or([])) == "False", "empty or")
  assert(cnShape(and([cnA()])) == "Cmp(owner,eq,1)", "one-child and")
  assert(cnShape(or([cnA()])) == "Cmp(owner,eq,1)", "one-child or")
}

test "True is dropped from an and and False from an or" {
  assert(cnShape(and([Cond.True, cnA(), cnB()])) == "And(Cmp(owner,eq,1) Cmp(kind,ne,1))", "and")
  assert(cnShape(or([Cond.False, cnA(), cnB()])) == "Or(Cmp(owner,eq,1) Cmp(kind,ne,1))", "or")
  assert(cnShape(and([Cond.True, Cond.True])) == "True", "and of Trues")
}

test "a False child of an and is kept so validate still sees its siblings" {
  assert(cnShape(and([Cond.False, cnA()])) == "And(False Cmp(owner,eq,1))", "and")
  assert(cnShape(or([Cond.True, cnA()])) == "Or(True Cmp(owner,eq,1))", "or")
}

test "not folds constants and double negation" {
  assert(cnShape(not(Cond.True)) == "False", "not True")
  assert(cnShape(not(Cond.False)) == "True", "not False")
  assert(cnShape(not(not(cnA()))) == "Cmp(owner,eq,1)", "not not")
  assert(cnShape(not(cnA())) == "Not(Cmp(owner,eq,1))", "not")
}

fn cnClause(f: string, op: Op, vs: []Value): Clause {
  return Clause(f, op, vs) catch e {
    panic("Clause: ${e.message()}")
  }
}

test "fromWhere of an empty Where is True whatever its join" {
  assert(cnShape(fromWhere(Where<Doc>())) == "True", "and")
  assert(cnShape(fromWhere(Where<Doc>(join = Join.Or))) == "True", "or")
  assert(cnShape(fromWhere(Where<Doc>(not = true))) == "False", "not")
}

test "fromWhere converts clauses, join, nesting and not one for one" {
  let owner = cnClause("owner", Op.Eq, [Value.Text("a")])
  let kind = cnClause("kind", Op.In, [Value.Text("x"), Value.Text("y")])
  let inner = Where<Doc>(clauses = [kind], not = true)
  let w = Where<Doc>(clauses = [owner], children = [inner])
  assert(
    cnShape(fromWhere(w)) == "And(Cmp(owner,eq,1) Not(Cmp(kind,in,2)))",
    "and tree: ${cnShape(fromWhere(w))}",
  )
  let o = Where<Doc>(clauses = [owner, kind], join = Join.Or)
  assert(cnShape(fromWhere(o)) == "Or(Cmp(owner,eq,1) Cmp(kind,in,2))", "or tree")
}

test "known folds a constant and does not wrap twice, 4 of 4" {
  assert(cnShape(known(Cond.True)) == "True", "true")
  assert(cnShape(known(Cond.False)) == "False", "false")
  let c = eq("owner", Value.Text("a"))
  assert(cnShape(known(c)) == "Known(Cmp(owner,eq,1))", "wraps")
  assert(cnShape(known(known(c))) == "Known(Cmp(owner,eq,1))", "once")
}
