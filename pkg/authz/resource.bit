// pkg/authz/resource.bit — what a policy is about. A resource is a `@table`
// class registered once at startup, and a stored policy names it by its
// CLASS name (`"resource": "Article"`), never the table name: renaming the
// table with `@table("articles")` changes no stored policy.
//
//   let authz = Authz<Action>()?
//   authz.resource<Article>()?.resource<Folder>()?
//
// Only `@table` classes qualify (the `Tabled` bound): a check reads a row
// through `__values()`/`__columns()` and a list filter needs the table and
// its columns, so a plain class could be neither read nor filtered. The
// bound refuses it at compile time. Registering the same class twice is an
// InvalidPolicy, so a copy-pasted line fails at startup.

import { FieldDesc } from "std/sql"
import { Tabled } from "orm"
import { sorted } from "std/sort"

// What a policy condition may be about: the `all` marker (any resource) or
// one registered resource by its class name.
export enum ResourceRef {
  All,
  Named(string),
}

// The any-resource marker: `p.can(Manage, all)`.
export const all: ResourceRef = ResourceRef.All

// One registered resource: the name policies store, the table a list filter
// queries and the columns a condition may mention.
export class ResourceInfo {
  export name: string,
  export table: string,
  export columns: []FieldDesc,
}

// The reference to resource T, by its class name. Registration is not
// required to build it; a policy that names an unregistered resource is
// refused when the policy is registered.
export fn resourceRef<T: Tabled>(): ResourceRef {
  return ResourceRef.Named(T.__className())
}

fn describe<T: Tabled>(): ResourceInfo {
  return ResourceInfo{
    name = T.__className(),
    table = T.__tableName(),
    columns = T.__columns(),
  }
}

// The registered resource called `name`, or None.
fn findResource(list: []ResourceInfo, name: string): Option<ResourceInfo> {
  for r of list {
    if (r.name == name) {
      return Option<ResourceInfo>.Some(r)
    }
  }
  return Option<ResourceInfo>.None
}

// T's entry for `list`, or an InvalidPolicy when the class is already in it.
fn newResource<T: Tabled>(list: []ResourceInfo): ResourceInfo! {
  let info = describe<T>()
  if (isSome(findResource(list, info.name))) {
    fail InvalidPolicy{ detail = "resource ${info.name} registered twice" }
  }
  return info
}

// The declared type of `field` on the resource called `resource`, as the
// compiler spells it ("i64", "string"), or None when either is unknown.
fn fieldTypeIn(list: []ResourceInfo, resource: string, field: string): Option<string> {
  return match (findResource(list, resource)) {
    Some(info) => columnType(info.columns, field)
    None => Option<string>.None
  }
}

fn columnType(columns: []FieldDesc, field: string): Option<string> {
  for c of columns {
    if (c.name == field) {
      return Option<string>.Some(c.typeName)
    }
  }
  return Option<string>.None
}

// Registered class names in alphabetical order, so an error message lists
// them the same way every run ("registered: Article, Folder").
fn namesIn(list: []ResourceInfo): []string {
  let names = []string(0)
  for r of list {
    names = append(names, r.name)
  }
  return sorted(names, (a, b) => a < b)
}
