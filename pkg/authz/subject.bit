// pkg/authz/subject.bit — who is asking. A subject is any class with an `id`
// and a list of `roles`; the package never imports pkg/auth, so the app joins
// the two (docs/subjects.md).
//
//   @json class User { export id: string, export roles: []string, export team: string }
//
// A stored policy may mention the subject's own attributes in a condition:
// `"team": "$user.team"`. `attributeOf` resolves such a placeholder. The
// guest is the ABSENT subject: every API that takes a subject takes
// `Option<Subject>`, and `None` is the guest. There is no guest class.

import { Json, jsonGet } from "std/json"
import { split } from "std/strings"

// The two fields a policy always needs. The class's fields must be `export`ed
// when it lives outside this module (SPEC §14.3).
export interface Subject {
  id: string,
  roles: []string,
}

// What `@json` gives a class (SPEC §10.3.1): the one way to read a field this
// package has no name for, since the language has no reflection. It repeats
// Subject's fields because an assertion (SPEC §14.4) must name a target that
// could satisfy the source interface.
interface JsonSubject {
  id: string,
  roles: []string,
  toJson(): Json,
}

fn rolesJson(roles: []string): Json {
  let out: []Json = []
  for r of roles {
    out = append(out, Json.JsonString(r))
  }
  return Json.JsonArray(out)
}

// Follows `segs` down nested objects. A segment that names no key, or that
// meets anything but an object (a string, a number, an array), is None:
// arrays are never indexed.
fn walk(root: Json, segs: []string): Option<Json> {
  let cur = root
  for seg of segs {
    let next = jsonGet(cur, seg)
    match (next) {
      Some(v) => { cur = v }
      None => return Option<Json>.None
    }
  }
  return Option<Json>.Some(cur)
}

// The value a `$user.<path>` placeholder names, or None. `id` and `roles` are
// always available. Any other path is looked up in the subject's `toJson()`,
// so it resolves only when the class carries `@json`; a dotted path
// (`address.city`) walks nested objects. None means the statement being
// evaluated does not match: an attribute that cannot be read never grants.
export fn attributeOf(s: Subject, path: string): Option<Json> {
  if (path == "id") {
    return Option<Json>.Some(Json.JsonString(s.id))
  }
  if (path == "roles") {
    return Option<Json>.Some(rolesJson(s.roles))
  }
  let (src, ok) = s.(JsonSubject)
  if (!ok) {
    return Option<Json>.None
  }
  return walk(src.toJson(), split(path, "."))
}
