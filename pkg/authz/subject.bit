// pkg/authz/subject.bit — who is asking. A subject is any class with an `id`
// and a list of `roles`; the package never imports pkg/auth, so the app joins
// the two (docs/subjects.md).
//
//   class User { export id: string, export roles: []string, export team: string }
//
// A stored policy may mention the subject's own attributes in a condition:
// `"team": "$user.team"`. `attributeOf` resolves such a placeholder. The
// guest is the ABSENT subject: every API that takes a subject takes
// `Option<Subject>`, and `None` is the guest. There is no guest class.

import { Json } from "std/json"

// What a policy always needs, plus the compiler's by-name field read. The
// class's fields must be `export`ed when it lives outside this module (SPEC
// §14.3). `__field` is synthesized for every class in a program that declares
// this interface (SPEC §14.3, #7110): no `@json`, nothing to write.
export interface Subject {
  id: string,
  roles: []string,
  __field(name: string): Option<Json>,
}

// The value a `$user.<name>` placeholder names, or None: one exported field of
// the subject, read by name without serializing the object. A string, an
// integer, a float, a bool, a payload-free enum (its variant name) and a list
// of those resolve; a nested class, a map, an `Option` field, an unexported
// field or an unknown name is None, so an attribute that cannot be read never
// grants. Names are flat: `address.city` is None, a class's own attribute is
// its own field.
export fn attributeOf(s: Subject, name: string): Option<Json> {
  return s.__field(name)
}
