// pkg/authz/errors.bit — the failures this package reports. Each class has
// `message()` and `status()`, so pkg/web maps it to a response by that
// structure alone (`HttpError`, pkg/web/errors.bit): nothing here imports
// pkg/web and nothing is registered with it.
//
// WHAT A CLIENT MAY SEE IS DECIDED HERE. `Denied` and `NotFound` carry fixed
// texts; `StoreUnavailable` says nothing of the store behind it. The name of
// the policy that decided a denial is for the server log and never for the
// client: `Denied.message()` omits it, and `deciding()` is the one way to
// read it. `NotFilterable` is a developer error and is a 500, which pkg/web
// never sends the message of.

// An action the subject may not do. `message()` is the same for every cause
// so a client cannot probe which policy refused it; the log reads
// `deciding()`.
export class Denied {
  policy: string
  export action: string
  export resource: string

  export message(): string {
    return "forbidden"
  }

  export status(): int {
    return 403
  }

  // The name of the policy that decided, for the server log. Never send it
  // to a client.
  export deciding(): string {
    return this.policy
  }
}

// A row the subject may not read, reported as if it did not exist.
export class NotFound {
  export message(): string {
    return "not found"
  }

  export status(): int {
    return 404
  }
}

// The policy or relationship store could not be reached. Access is refused
// rather than guessed.
export class StoreUnavailable {
  export message(): string {
    return "authorization unavailable"
  }

  export status(): int {
    return 503
  }
}

// A policy that was refused when it was saved. `detail` says why and is
// meant for the admin who saved it, so it is part of `message()`.
export class InvalidPolicy {
  export detail: string

  export message(): string {
    return "invalid policy: ${this.detail}"
  }

  export status(): int {
    return 400
  }
}

// A condition that cannot become a database filter was used to list rows.
// This is a mistake in the app's policies, so it is a 500: pkg/web logs the
// message and never sends it.
export class NotFilterable {
  export policy: string

  export message(): string {
    return "policy '${this.policy}' cannot filter a list"
  }

  export status(): int {
    return 500
  }
}

// A relationship check ran into one of its bounds before it could answer:
// `limit` names it ("maxDepth", "maxVisited", "maxFanout") and `bound` is its
// value. The check is undecided, and an undecided check is NOT related: a
// caller that turns it into `false` fails closed, and one that returns it
// with `?` refuses the request. It is a 500, so pkg/web logs the message
// (which names the bound to raise) and never sends it.
export class RelationLimit {
  export limit: string
  export bound: int

  export message(): string {
    return "relationship check stopped at ${this.limit} ${this.bound}; treated as not related"
  }

  export status(): int {
    return 500
  }
}
