// pkg/authz/condeval.test.bit — evalCond over a four-field @table class: the
// 7 operators (match and no match), the Kleene tables, NULL, and the
// InvalidPolicy cases.

@table class Post {
  @id
  id: i64
  title: string
  score: f64
  note: Option<string>
}

fn ceRow(): Post {
  return Post{ id = 7, title = "draft", score = 2.5 }
}

fn ceEval(c: Cond, row: Post): Truth {
  return evalCond(c, row) catch e {
    panic("evalCond: ${e.message()}")
  }
}

fn ceName(b: Truth): string {
  return match (b) {
    True => "True"
    False => "False"
    Unknown => "Unknown"
  }
}

fn ceIs(c: Cond, want: Truth): bool {
  let got = ceEval(c, ceRow())
  assert(ceName(got) == ceName(want), "got ${ceName(got)}, want ${ceName(want)}")
  return true
}

// The message of the InvalidPolicy `c` fails with, or "" when it evaluates.
fn ceFails(c: Cond): string {
  evalCond(c, ceRow()) catch e {
    return e.message()
  }
  return ""
}

fn ceInt(i: int): Value {
  return Value.Int(i)
}

test "eq: match and no match" {
  assert(ceIs(eq("id", ceInt(7)), Truth.True), "match")
  assert(ceIs(eq("id", ceInt(8)), Truth.False), "no match")
}

test "ne: match and no match" {
  assert(ceIs(ne("id", ceInt(8)), Truth.True), "match")
  assert(ceIs(ne("id", ceInt(7)), Truth.False), "no match")
}

test "in: match and no match" {
  assert(ceIs(oneOf("title", [Value.Text("a"), Value.Text("draft")]), Truth.True), "match")
  assert(ceIs(oneOf("title", [Value.Text("a"), Value.Text("b")]), Truth.False), "no match")
}

test "lt: match and no match" {
  assert(ceIs(lt("id", ceInt(8)), Truth.True), "match")
  assert(ceIs(lt("id", ceInt(7)), Truth.False), "no match")
}

test "lte: match and no match" {
  assert(ceIs(lte("id", ceInt(7)), Truth.True), "match")
  assert(ceIs(lte("id", ceInt(6)), Truth.False), "no match")
}

test "gt: match and no match" {
  assert(ceIs(gt("id", ceInt(6)), Truth.True), "match")
  assert(ceIs(gt("id", ceInt(7)), Truth.False), "no match")
}

test "gte: match and no match" {
  assert(ceIs(gte("id", ceInt(7)), Truth.True), "match")
  assert(ceIs(gte("id", ceInt(8)), Truth.False), "no match")
}

test "text compares byte by byte" {
  assert(ceIs(lt("title", Value.Text("e")), Truth.True), "draft < e")
  assert(ceIs(gt("title", Value.Text("e")), Truth.False), "draft > e")
}

test "an integer widens to float against a float field, and back" {
  assert(ceIs(gt("score", ceInt(2)), Truth.True), "2.5 > 2")
  assert(ceIs(lt("score", ceInt(3)), Truth.True), "2.5 < 3")
  assert(ceIs(eq("id", Value.Float(7.0)), Truth.True), "7 == 7.0")
}

// The three values as conditions over the row: id is 7, note is None.
fn ceVal(i: int): Cond {
  if (i == 0) {
    return eq("id", ceInt(7))
  }
  if (i == 1) {
    return eq("id", ceInt(8))
  }
  return eq("note", Value.Text("x"))
}

// Rows in the order (T,T) (T,F) (T,U) (F,T) (F,F) (F,U) (U,T) (U,F) (U,U).
const ceAnd: []string = [
  "True",
  "False",
  "Unknown",
  "False",
  "False",
  "False",
  "Unknown",
  "False",
  "Unknown",
]
const ceOr: []string = [
  "True",
  "True",
  "True",
  "True",
  "False",
  "Unknown",
  "True",
  "Unknown",
  "Unknown",
]

test "Kleene and: 9 of 9 rows" {
  let row = 0
  for a of [0, 1, 2] {
    for b of [0, 1, 2] {
      let got = ceName(ceEval(and([ceVal(a), ceVal(b)]), ceRow()))
      assert(got == ceAnd[row], "and row ${row}: got ${got}, want ${ceAnd[row]}")
      row = row + 1
    }
  }
  assert(row == 9, "rows: ${row}")
}

test "Kleene or: 9 of 9 rows" {
  let row = 0
  for a of [0, 1, 2] {
    for b of [0, 1, 2] {
      let got = ceName(ceEval(or([ceVal(a), ceVal(b)]), ceRow()))
      assert(got == ceOr[row], "or row ${row}: got ${got}, want ${ceOr[row]}")
      row = row + 1
    }
  }
  assert(row == 9, "rows: ${row}")
}

test "not flips true and false and leaves unknown" {
  assert(ceIs(not(ceVal(0)), Truth.False), "not T")
  assert(ceIs(not(ceVal(1)), Truth.True), "not F")
  assert(ceIs(not(ceVal(2)), Truth.Unknown), "not U")
  assert(ceIs(Cond.Not(Cond.Not(ceVal(2))), Truth.Unknown), "Not(Not(U))")
}

test "NULL gives unknown for 7 of 7 operators" {
  let x = Value.Text("x")
  let conds = [
    eq("note", x),
    ne("note", x),
    oneOf("note", [x]),
    lt("note", x),
    lte("note", x),
    gt("note", x),
    gte("note", x),
  ]
  assert(len(conds) == 7, "operators: ${len(conds)}")
  for c of conds {
    assert(ceIs(c, Truth.Unknown), "NULL field")
  }
}

test "a Null operand is unknown for every operator" {
  assert(ceIs(eq("id", Value.Null), Truth.Unknown), "eq")
  assert(ceIs(oneOf("id", [Value.Null]), Truth.Unknown), "in only NULL")
  assert(ceIs(lt("id", Value.Null), Truth.Unknown), "lt")
}

test "in follows SQL: a match wins, otherwise a NULL operand makes it unknown" {
  assert(ceIs(oneOf("id", [Value.Null, ceInt(7)]), Truth.True), "match beside NULL")
  assert(ceIs(oneOf("id", [Value.Null, ceInt(8)]), Truth.Unknown), "no match beside NULL")
}

test "a Some field compares like its payload" {
  let row = Post{ id = 1, title = "t", score = 0.0, note = Option<string>.Some("n") }
  assert(ceEval(eq("note", Value.Text("n")), row) == Truth.True, "Some match")
  assert(ceEval(eq("note", Value.Text("m")), row) == Truth.False, "Some no match")
}

test "true and false conditions" {
  assert(ceIs(Cond.True, Truth.True), "True")
  assert(ceIs(Cond.False, Truth.False), "False")
  assert(ceIs(and([]), Truth.True), "empty and")
  assert(ceIs(or([]), Truth.False), "empty or")
}

test "an unknown field is an InvalidPolicy, 1 of 1" {
  let m = ceFails(eq("tittle", Value.Text("x")))
  assert(m == "invalid policy: unknown field tittle", "message: ${m}")
}

test "an unknown field fails even when a sibling already decides the answer" {
  let m = ceFails(or([eq("id", ceInt(7)), eq("tittle", Value.Text("x"))]))
  assert(m == "invalid policy: unknown field tittle", "message: ${m}")
  let n = ceFails(and([eq("id", ceInt(8)), eq("tittle", Value.Text("x"))]))
  assert(n == "invalid policy: unknown field tittle", "message: ${n}")
}

test "unlike kinds are an InvalidPolicy" {
  let m = ceFails(eq("title", ceInt(1)))
  assert(m == "invalid policy: field title holds text, cannot compare with an integer", m)
  let n = ceFails(oneOf("id", [ceInt(1), Value.Text("x")]))
  assert(n == "invalid policy: field id holds an integer, cannot compare with text", n)
}

test "bool and bytes cannot be ordered" {
  let c = Cond.Cmp("id", Op.Lt, [Value.Bool(true)])
  assert(ceFails(c) != "", "ordering an integer with a bool must fail")
}

test "an operand count the operator does not take is an InvalidPolicy" {
  let m = ceFails(oneOf("id", []Value{}))
  assert(m == "invalid policy: field id: operator takes one or more values, got 0", m)
  let n = ceFails(Cond.Cmp("id", Op.Eq, [ceInt(1), ceInt(2)]))
  assert(n == "invalid policy: field id: operator takes exactly one value, got 2", n)
  let k = ceFails(eq("", ceInt(1)))
  assert(k == "invalid policy: condition names an empty field", k)
}

test "NaN is unordered: only ne holds" {
  let row = Post{ id = 1, title = "t", score = 0.0 / 0.0 }
  assert(ceEval(eq("score", Value.Float(1.0)), row) == Truth.False, "eq")
  assert(ceEval(ne("score", Value.Float(1.0)), row) == Truth.True, "ne")
  assert(ceEval(lt("score", Value.Float(1.0)), row) == Truth.False, "lt")
  assert(ceEval(gt("score", Value.Float(1.0)), row) == Truth.False, "gt")
}
