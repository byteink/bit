// pkg/authz/condcheck.bit — check a `Cond` against a resource's declared
// columns, once, when the policy is registered. A field the class does not
// have, an operand of the wrong type, a comparison NULL can never satisfy and
// an ordering over bool or bytes are each an InvalidPolicy that names the
// field, so the mistake stops the app at startup instead of denying (or
// worse, granting) quietly at request time. `Authz.validate` is the entry
// point; this file is its walk over the tree.
//
// What a column accepts: an integer or float column takes integers and
// floats (the evaluator widens an integer), a text column takes text, a bool
// column bool, a blob column bytes. `Value.Null` is never an operand:
// comparing with NULL is unknown for every operator, so a policy that wrote it
// could never match.

fn fieldList(cols: []FieldDesc): string {
  let names = []string(0)
  for c of cols {
    names = append(names, c.name)
  }
  return join(names, ", ")
}

fn columnOf(cols: []FieldDesc, field: string): Option<FieldDesc> {
  for c of cols {
    if (c.name == field) {
      return Option<FieldDesc>.Some(c)
    }
  }
  return Option<FieldDesc>.None
}

fn operandKind(v: Value): Option<ColKind> {
  return match (v) {
    Null => Option<ColKind>.None
    Int(_) => Option<ColKind>.Some(ColKind.Int)
    Float(_) => Option<ColKind>.Some(ColKind.Float)
    Bool(_) => Option<ColKind>.Some(ColKind.Bool)
    Text(_) => Option<ColKind>.Some(ColKind.Text)
    Blob(_) => Option<ColKind>.Some(ColKind.Blob)
  }
}

fn isNumeric(k: ColKind): bool {
  return match (k) {
    Int => true
    Float => true
    _ => false
  }
}

fn orderable(k: ColKind): bool {
  return match (k) {
    Bool => false
    Blob => false
    _ => true
  }
}

fn sameKind(col: ColKind, operand: ColKind): bool {
  if (isNumeric(col)) {
    return isNumeric(operand)
  }
  return col == operand
}

fn checkOperand(field: string, col: ColKind, typeName: string, v: Value): ()! {
  let k = operandKind(v)
  if (!isSome(k)) {
    fail InvalidPolicy{ detail = "field ${field}: comparing with null is never true" }
  }
  if (!sameKind(col, unwrap(k))) {
    fail InvalidPolicy{ detail = "field ${field} is ${typeName}, the value is ${kindName(v)}" }
  }
}

// What a condition is checked against: the resource's row columns, every
// registered resource and the declared relations.
class Scope {
  cols: []FieldDesc,
  resources: []ResourceInfo,
  decls: []RelationDecl,
}

fn checkCmp(cols: []FieldDesc, field: string, op: Op, operands: []Operand): ()! {
  checkArity(field, op, len(operands))?
  let col = columnOf(cols, field)
  if (!isSome(col)) {
    fail InvalidPolicy{ detail = "no field ${field} (fields: ${fieldList(cols)})" }
  }
  let typeName = unwrap(col).typeName
  let kind = unwrap(columnKind(typeName))
  if (isOrdering(op) && !orderable(kind)) {
    fail InvalidPolicy{ detail = "field ${field} is ${typeName}, which cannot be ordered" }
  }
  for o of operands {
    checkLit(field, kind, typeName, o)?
  }
}

// A placeholder's value is the subject's, known only when `bind` reads it; the
// evaluator then refuses one of the wrong kind like any other.
fn checkLit(field: string, col: ColKind, typeName: string, o: Operand): ()! {
  match (o) {
    Lit(v) => checkOperand(field, col, typeName, v)?
    Param(_) => {}
  }
}

// A code function is named so the log and `NotFilterable` can say which rule.
fn checkLabel(label: string): ()! {
  if (label == "") {
    fail InvalidPolicy{ detail = "a canIf rule needs a label naming it" }
  }
}

fn checkAll(sc: Scope, cs: []Cond): ()! {
  for c of cs {
    checkTree(sc, c)?
  }
}

// A `Related` names a row column an object id can be made of, a registered
// target and a relation the target declares.
fn checkRelatedCond(sc: Scope, local: string, target: string, relation: string): ()! {
  checkIdColumn(sc.cols, local, local)?
  checkRelated(sc.resources, sc.decls, target, relation)?
}

fn checkTree(sc: Scope, c: Cond): ()! {
  match (c) {
    True => {}
    False => {}
    Cmp(field, op, operands) => checkCmp(sc.cols, field, op, operands)?
    And(cs) => checkAll(sc, cs)?
    Or(cs) => checkAll(sc, cs)?
    Not(inner) => checkTree(sc, inner)?
    Known(inner) => checkTree(sc, inner)?
    Custom(label, _) => checkLabel(label)?
    Related(local, target, relation) => checkRelatedCond(sc, local, target, relation)?
  }
}

// Fails with an InvalidPolicy when `c` names a field `columns` does not
// declare as a row column, compares it with a value it cannot hold, or relates
// to a resource or relation nobody declared.
fn validateCond(
  columns: []FieldDesc,
  resources: []ResourceInfo,
  decls: []RelationDecl,
  c: Cond,
): ()! {
  let sc = Scope{ cols = rowColumns(columns), resources = resources, decls = decls }
  return checkTree(sc, c)?
}

// The first field `c` names, or None for a condition that names none.
fn firstField(c: Cond): Option<string> {
  return match (c) {
    Cmp(field, _, _) => Option<string>.Some(field)
    And(cs) => firstFieldOf(cs)
    Or(cs) => firstFieldOf(cs)
    Not(inner) => firstField(inner)
    Known(inner) => firstField(inner)
    Related(local, _, _) => Option<string>.Some(local)
    _ => Option<string>.None
  }
}

fn firstFieldOf(cs: []Cond): Option<string> {
  for c of cs {
    let f = firstField(c)
    if (isSome(f)) {
      return f
    }
  }
  return Option<string>.None
}

fn validateAll(c: Cond): ()! {
  let f = firstField(c)
  if (isSome(f)) {
    fail InvalidPolicy{ detail = "a condition on all cannot name a field (${unwrap(f)})" }
  }
}

fn validateNamed(list: []ResourceInfo, decls: []RelationDecl, name: string, c: Cond): ()! {
  let info = findResource(list, name)
  if (!isSome(info)) {
    fail InvalidPolicy{ detail = "unknown resource ${name} (registered: ${join(namesIn(list), ", ")})" }
  }
  return validateCond(unwrap(info).columns, list, decls, c)?
}

// `Authz.validate` over the registered resources `list`.
fn validateIn(list: []ResourceInfo, decls: []RelationDecl, resource: ResourceRef, c: Cond): ()! {
  match (resource) {
    All => validateAll(c)?
    Named(name) => validateNamed(list, decls, name, c)?
  }
}
