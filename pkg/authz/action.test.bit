// pkg/authz/action.test.bit — variant names are the stored action names.

import { contains } from "std/strings"

enum Action { Manage, Read, Create, Update, Delete, Publish }

test "6 of 6 variants report their own name" {
  let all = [
    Action.Manage,
    Action.Read,
    Action.Create,
    Action.Update,
    Action.Delete,
    Action.Publish,
  ]
  let want = ["Manage", "Read", "Create", "Update", "Delete", "Publish"]
  assert(len(all) == 6, "variants: ${len(all)}")
  let i = 0
  while (i < len(all)) {
    assert(actionName(all[i]) == want[i], "name of ${i}: ${actionName(all[i])}")
    i = i + 1
  }
}

// The message actionIndex fails with, "" when it succeeds.
fn indexError(s: string): string {
  let _ = actionIndex<Action>(s) catch e {
    return e.message()
  }
  return ""
}

test "every listed name is found at its own position" {
  let names = Action.__variants()
  assert(len(names) == 6, "names: ${len(names)}")
  let i = 0
  while (i < len(names)) {
    let at = actionIndex<Action>(names[i]) catch e {
      panic("${names[i]}: ${e.message()}")
    }
    assert(at == i, "${names[i]} found at ${at}, want ${i}")
    i = i + 1
  }
}

test "an unknown name is an InvalidPolicy naming it and listing the 6 valid names" {
  let bad = ["", "publish", "Nope"]
  for s of bad {
    let m = indexError(s)
    assert(contains(m, "invalid policy: unknown action '${s}'"), "message: ${m}")
    for n of Action.__variants() {
      assert(contains(m, n), "message omits ${n}: ${m}")
    }
  }
}
