// pkg/authz/decide.bit — `Authz.can` and `Authz.check`: may THIS user do THIS
// to THIS row. CASL's algorithm over the rules of the user's roles:
//
//   1. a rule applies when its resource is the thing's class (or `all`) and
//      its actions hold the asked action or `Manage`;
//   2. its condition is bound to the user (`$user.x`, condparam.bit) and
//      evaluated on the row; unknown does not match;
//   3. any matching Deny refuses, else any matching Allow grants, else the
//      answer is no: default deny, with no deciding policy.
//
// The guest is `None`: it gets the rules of the role called "guest" and is
// evaluated like anyone else; with no such role every answer is no.
//
// FAIL CLOSED, LOUD. A rule `validateRulesIn` refuses (no actions, a resource
// nothing registered, a condition that does not fit it) is a developer
// mistake the startup check could miss, because `validatePolicy` runs a
// policy for one probe subject and a policy may branch. Every rule of the
// subject's role rules is checked here: `check` fails with an InvalidPolicy
// naming the policy and the rule, `can` is false, and the mistake is logged
// at ERROR once per policy and rule position. A rule whose condition cannot
// be evaluated on this row gives the same answer.
//
// COST. A subject's rules are built once per subject value and indexed by
// (resource class, action) (rulecache.bit), so a check takes one lock to find
// the rules that can match and returns a Decision built with the index. The verdict on
// a rule is cached by (policy, position, resource, action count); a rule set
// with no faulty rule skips it. A condition without a placeholder is
// evaluated as it is (`bind` copies nothing), a `Cond.True` rule reads no
// row, and the row's column names are computed once at `resource<T>()`. What
// remains per call is the row's `__values()`, read once when some matching
// rule has a condition.

import { join } from "std/strings"
import { Logger, LevelDebug } from "std/log"

// The role `None` uses.
const guestRole: string = "guest"

const noAllowRule: string = "no matching allow rule"

// The outcome of one decision. `invalid` means `reason` is an InvalidPolicy
// detail and the answer is a refusal made because a rule is broken; `down`
// means the relationship store failed and the answer is a refusal `check`
// reports as StoreUnavailable.
class Decision {
  allowed: bool,
  policy: string,
  reason: string,
  invalid: bool,
  down: bool,
}

// What was found when a rule was last checked: 1 valid, 2 faulty; `resource`
// and `actions` are the parts of the rule a fault depends on, so a policy
// that branches on the subject is re-checked when the rule at this position
// is a different one. `logged` keeps the ERROR line to once.
class RuleVerdict {
  code: int,
  resource: ResourceRef,
  actions: int,
  logged: bool,
}

class PolicyVerdicts {
  policy: string,
  rules: []RuleVerdict,
}

// Everything `can` and `check` keep between calls: the rule cache (which
// holds what registration published, the log sink included) and the verdict
// cache, which the rule cache's lock guards so a miss checks its rules in
// the section that stores them.
class DecideState<A: ActionEnum> {
  verdicts: []PolicyVerdicts
  cache: RuleCache<A>

  init() {
    this.cache = RuleCache<A>()
    this.verdicts = []PolicyVerdicts(0)
  }

  // The verdict cached for rule `k` of `r.policy`, or 0.
  lookup(r: Rule<A>, k: int): int {
    this.cache.mu.lock()
    let code = this.lookupLocked(r, k)
    this.cache.mu.unlock()
    return code
  }

  lookupLocked(r: Rule<A>, k: int): int {
    for pv of this.verdicts {
      if (pv.policy != r.policy) {
        continue
      }
      if (k >= len(pv.rules)) {
        return 0
      }
      let v = pv.rules[k]
      if (v.resource == r.resource && v.actions == len(r.actions)) {
        return v.code
      }
      return 0
    }
    return 0
  }

  // Records `code` for rule `k` of `r.policy`; true when this is the first
  // faulty verdict for the position, the one that is logged.
  store(r: Rule<A>, k: int, code: int): bool {
    this.cache.mu.lock()
    let first = this.storeLocked(r, k, code)
    this.cache.mu.unlock()
    return first
  }

  slot(policy: string): PolicyVerdicts {
    for pv of this.verdicts {
      if (pv.policy == policy) {
        return pv
      }
    }
    let pv = PolicyVerdicts{ policy = policy, rules = []RuleVerdict(0) }
    this.verdicts = append(this.verdicts, pv)
    return pv
  }

  storeLocked(r: Rule<A>, k: int, code: int): bool {
    let pv = this.slot(r.policy)
    while (len(pv.rules) <= k) {
      pv.rules = append(
        pv.rules,
        RuleVerdict{ code = 0, resource = all, actions = 0, logged = false },
      )
    }
    let v = pv.rules[k]
    v.code = code
    v.resource = r.resource
    v.actions = len(r.actions)
    let first = code == 2 && !v.logged
    if (first) {
      v.logged = true
    }
    return first
  }

  // Under the cache's lock: whether every rule of `rules` passes the check
  // `can` makes. A valid verdict is cached as `verdict` caches it; a faulty
  // rule is left for `firstFault` to report and log in the decision's own
  // order. Rules of one policy are contiguous, so `k` is a rule's position.
  allValidLocked(reg: Registry<A>, rules: []Rule<A>): bool {
    let prev = ""
    let k = 0
    for r of rules {
      if (r.policy != prev) {
        prev = r.policy
        k = 0
      }
      let code = this.lookupLocked(r, k)
      if (code == 0 && ruleFault<A>(reg.resources, reg.decls, r) == "") {
        code = 1
        let _ = this.storeLocked(r, k, code)
      }
      if (code != 1) {
        return false
      }
      k = k + 1
    }
    return true
  }

  // 1 when rule `k` of its policy is valid, else 2. The check runs once per
  // position; a faulty one is logged once.
  verdict(reg: Registry<A>, r: Rule<A>, k: int): int {
    let code = this.lookup(r, k)
    if (code != 0) {
      return code
    }
    let why = ruleFault<A>(reg.resources, reg.decls, r)
    code = 1
    if (why != "") {
      code = 2
    }
    if (this.store(r, k, code)) {
      loggerOf<A>(reg).error().str("policy", r.policy).int("rule", k).str("why", why).log("invalid policy")
    }
    return code
  }
}

// `policies` as the rules of one subject: the rules each makes for `sample`,
// each policy once, as `rolesOf` resolves a role. This is what `None` gets.
fn guestRules<S: Subject, A: ActionEnum>(policies: []Policy<S, A>, sample: S): []Rule<A> {
  let out = []Rule<A>(0)
  let seen = []string(0)
  for p of policies {
    if (hasName(seen, p.name)) {
      continue
    }
    seen = append(seen, p.name)
    for r of p.rulesFor(sample) {
      out = append(out, r)
    }
  }
  return out
}

fn resourceMatches(ref: ResourceRef, className: string): bool {
  return match (ref) {
    All => true
    Named(n) => n == className
  }
}

// Whether `actions` holds `want` or, when the enum has one, `Manage`.
fn actionMatches<A: ActionEnum>(actions: []A, want: string, wildcard: bool): bool {
  for a of actions {
    let n = actionName(a)
    if (n == want || (wildcard && n == "Manage")) {
      return true
    }
  }
  return false
}

fn applies<A: ActionEnum>(r: Rule<A>, className: string, want: string, wildcard: bool): bool {
  return resourceMatches(r.resource, className) && actionMatches<A>(r.actions, want, wildcard)
}

fn invalidDecision(detail: string): Decision {
  return Decision{ allowed = false, policy = "", reason = detail, invalid = true, down = false }
}

// Logs what `rolesOf` left out of `set`, when DEBUG is on.
fn logSkipped<A: ActionEnum>(logger: Logger, set: RuleSet<A>) {
  if (!logger.enabled(LevelDebug)) {
    return
  }
  for line of set.skipped {
    logger.debug().str("detail", line).log("skipped")
  }
}

// "policy P rule k: why" for the first rule of `rules` that is invalid, or "".
// Rules of one policy are contiguous (`rolesOf` lists a policy once).
fn firstFault<A: ActionEnum>(
  st: DecideState<A>,
  reg: Registry<A>,
  rules: []Rule<A>,
): string {
  let prev = ""
  let k = 0
  for r of rules {
    if (r.policy != prev) {
      prev = r.policy
      k = 0
    }
    if (st.verdict(reg, r, k) == 2) {
      return "policy ${r.policy} rule ${k}: ${ruleFault<A>(reg.resources, reg.decls, r)}"
    }
    k = k + 1
  }
  return ""
}

// `names` when it fits `vals`, else the names `T`'s columns give them; a
// resource registered with `resource<T>()` always fits.
fn rowNamesFor<T: Tabled>(names: []string, vals: []Value): []string! {
  if (len(names) == len(vals)) {
    return names
  }
  return rowNames(T.__columns(), vals)?
}

// `r`'s condition with the user's attributes in it; a path the user cannot
// supply is logged and makes its comparison not hold (condparam.bit).
fn boundCond<A: ActionEnum>(logger: Logger, r: Rule<A>, user: Option<Subject>): Cond {
  if (!hasParam(r.cond)) {
    return r.cond
  }
  let (c, missing) = bind(r.cond, user)
  if (len(missing) > 0 && logger.enabled(LevelDebug)) {
    logger.debug().str("policy", r.policy).str("missing", join(missing, ", ")).log("no value for placeholder")
  }
  return c
}

fn isTrueTruth(t: Truth): bool {
  return match (t) {
    True => true
    _ => false
  }
}

// Whether `c`, a rule's condition bound to the user, holds on the row `vals`
// read from `thing`. Unknown does not hold. `thing` is boxed only for a code
// function (`boxRow`).
fn condHolds<T: Tabled>(
  c: Cond,
  names: []string,
  vals: []Value,
  thing: T,
  rel: Option<RelAsker>,
): bool! {
  return isTrueTruth(evalRow(c, rowNamesFor<T>(names, vals)?, vals, boxRow<T>(c, thing), rel)?)
}

fn isLimit(e: error): bool {
  let (_, limit) = e.(RelationLimit)
  return limit
}

// What a rule whose condition could not be evaluated does to the check. A
// relationship check that hit a bound answered nothing: an allow rule then does
// not match (None, and the log says why), but a deny rule that did not match
// could let an allow through, so it refuses. A broken rule is an invalid
// policy, logged; anything else is the relationship store failing, logged and
// reported as unavailable. Every Some is a refusal.
fn ruleStopped<A: ActionEnum>(logger: Logger, r: Rule<A>, pos: int, e: error): Option<Decision> {
  if (isLimit(e)) {
    if (r.effect == Effect.Allow) {
      logger.warn().str("policy", r.policy).int("rule", pos).str("why", e.message()).log("relationship undecided")
      return Option<Decision>.None
    }
    return Option<Decision>.Some(
      Decision{
        allowed = false,
        policy = r.policy,
        reason = e.message(),
        invalid = false,
        down = false,
      },
    )
  }
  let (_, broken) = e.(InvalidPolicy)
  if (broken) {
    logger.error().str("policy", r.policy).int("rule", pos).str("why", e.message()).log("invalid policy")
    return Option<Decision>.Some(invalidDecision("policy ${r.policy} rule ${pos}: ${e.message()}"))
  }
  logger.error().err(e).str("policy", r.policy).int("rule", pos).log("store unavailable")
  return Option<Decision>.Some(
    Decision{
      allowed = false,
      policy = "",
      reason = "relationship store unavailable",
      invalid = false,
      down = true,
    },
  )
}

// Who is asking, for a decision whose rules hold a relationship test; None
// when none does, so an ordinary decision builds nothing.
fn askerFor<A: ActionEnum>(
  a: Authz<A>,
  reg: Registry<A>,
  user: Option<Subject>,
  rules: []Rule<A>,
): Option<RelAsker> {
  for r of rules {
    if (!isTrue(r.cond) && hasRelated(r.cond)) {
      return Option<RelAsker>.Some(newAsker(a.relations, a.limits, reg.resources, reg.decls, user))
    }
  }
  return Option<RelAsker>.None
}

fn denyAll(policy: string): Decision {
  return Decision{
    allowed = false,
    policy = policy,
    reason = "denied by rule",
    invalid = false,
    down = false,
  }
}

// The rules of `slot` applied to `thing`: first matching Deny, else first
// matching Allow, else default deny. The row is read the first time a rule
// with a condition is reached.
fn applySlot<A: ActionEnum, T: Tabled>(
  logger: Logger,
  user: Option<Subject>,
  slot: RuleSlot<A>,
  thing: T,
  rel: Option<RelAsker>,
): Decision {
  let vals: []Value
  let read = false
  let granted = -1
  let i = 0
  while (i < len(slot.rules)) {
    let r = slot.rules[i]
    if (!isTrue(r.cond)) {
      if (!read) {
        vals = thing.__values()
        read = true
      }
      let c = boundCond<A>(logger, r, user)
      let hit = condHolds<T>(c, slot.names, vals, thing, rel) catch e {
        let stop = ruleStopped<A>(logger, r, slot.at[i], e)
        if (isSome(stop)) {
          return unwrap(stop)
        }
        i = i + 1
        continue
      }
      if (!hit) {
        i = i + 1
        continue
      }
    }
    if (r.effect == Effect.Deny) {
      return slot.decs[i]
    }
    if (granted < 0) {
      granted = i
    }
    i = i + 1
  }
  if (granted >= 0) {
    return slot.decs[granted]
  }
  return slot.none
}

fn subjectId(user: Option<Subject>): string {
  if (!isSome(user)) {
    return guestRole
  }
  return unwrap(user).id
}

fn verbOf(d: Decision): string {
  if (d.allowed) {
    return "allow"
  }
  return "deny"
}

// The decision, once logged when DEBUG is on; the record is built only then.
fn logged<A: ActionEnum>(
  logger: Logger,
  user: Option<Subject>,
  action: A,
  resource: string,
  d: Decision,
): Decision {
  if (logger.enabled(LevelDebug)) {
    let rec = logger.debug().str("outcome", verbOf(d)).str("action", actionName(action)).str(
      "resource",
      resource,
    )
    rec.str("subject", subjectId(user)).str("policy", d.policy).str("reason", d.reason).log("decision")
  }
  return d
}

// The one INFO record a refusal by `check` leaves: who, what and which policy
// decided. Never an attribute value, a row or a request body. A hidden row
// (`NotFound`) is the normal outcome and leaves no record. The handler quotes
// and escapes each value, so an id with a line break cannot forge a line.
fn logDenied(logger: Logger, user: Option<Subject>, d: Denied) {
  let rec = logger.info().str("action", d.action).str("resource", d.resource)
  rec.str("subject", subjectId(user)).str("policy", d.deciding()).log("denied")
}

// A store that cannot be reached is the operator's to see: one ERROR record,
// the client gets the 503 and nothing of the store.
fn logStoreDown(logger: Logger, e: error) {
  let (_, down) = e.(StoreUnavailable)
  if (down) {
    logger.error().err(e).log("store unavailable")
  }
}

// One decision. An invalid rule anywhere in the user's rules beats everything
// else, so a broken policy is never silently skipped. `byCheck` leaves a plain
// refusal to `Authz.check`, which writes its own INFO line for it, so a denied
// request is one line and not two.
fn decide<A: ActionEnum, T: Tabled>(
  a: Authz<A>,
  user: Option<Subject>,
  action: A,
  thing: T,
  byCheck: bool,
): Decision {
  let cls = T.__className()
  let slot = slotFor<A>(a, user, cls, action)
  let set = slot.set
  let logger = loggerOf<A>(set.reg)
  logSkipped<A>(logger, set)
  if (!set.clean) {
    let bad = firstFault<A>(a.state, set.reg, set.rules)
    if (bad != "") {
      return logged<A>(logger, user, action, cls, invalidDecision(bad))
    }
  }
  // Bound first: a call nested in the argument list costs an allocation.
  let rel = askerFor<A>(a, set.reg, user, slot.rules)
  let d = applySlot<A, T>(logger, user, slot, thing, rel)
  if (byCheck && !d.allowed && !d.invalid) {
    return d
  }
  return logged<A>(logger, user, action, cls, d)
}
