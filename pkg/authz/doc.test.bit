// pkg/authz/doc.test.bit — stored policy documents: the two #6984 design
// documents validate and decode, and twelve kinds of invalid document are each
// refused with the JSON Pointer of the fault (doc.bit).
//
// `Article` (resource.test.bit) has the columns the documents name: title,
// authorId, team and status. The documents use the test enum `Action`
// (action.test.bit).

import { Json, jsonDecodeText, jsonParse } from "std/json"
import { hasPrefix, repeat } from "std/strings"

fn pdAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<Article>() catch e {
    panic("resource: ${e.message()}")
  }
  return a
}

fn pdJson(text: string): Json {
  return jsonParse(text) catch e {
    panic("test json: ${e.message()}")
  }
}

// A statement whose `when` is the JSON text `when`.
fn pdStmt(effect: string, actions: []string, resource: string, when: string): Statement {
  return Statement{ effect = effect, actions = actions, resource = resource, when = pdJson(when) }
}

fn pdOne(s: Statement): PolicyDoc {
  return PolicyDoc{ name = "Doc", statements = [s] }
}

// The message `doc` is refused with, or "OK".
fn pdRun(doc: PolicyDoc): string {
  let _ = pdAuthz().validateDoc(doc) catch e {
    return e.message()
  }
  return "OK"
}

// Asserts `doc` is refused and the message starts with `want`.
fn pdRefused(label: string, doc: PolicyDoc, want: string) {
  let got = pdRun(doc)
  assert(hasPrefix(got, "invalid policy: ${want}"), "${label}\n  got:  ${got}\n  want: ${want}...")
}

fn pdEffect(e: Effect): string {
  return match (e) {
    Allow => "allow"
    Deny => "deny"
  }
}

fn pdResource(r: ResourceRef): string {
  return match (r) {
    All => "*"
    Named(n) => n
  }
}

// The #6984 design's first document: the `when` object is verbatim.
test "the PublishOwnTeam document validates to one rule stamped with its name" {
  let doc = PolicyDoc{
    name = "PublishOwnTeam",
    statements = [
      pdStmt(
        "allow",
        ["Publish"],
        "Article",
        "{ \"team\": \"$user.team\", \"status\": \"review\" }",
      ),
    ],
  }
  let cp = pdAuthz().validateDoc(doc) catch e {
    panic("validate: ${e.message()}")
  }
  assert(cp.name == "PublishOwnTeam", "name ${cp.name}")
  assert(len(cp.rules) == 1, "rules ${len(cp.rules)}")
  let r = cp.rules[0]
  assert(pdEffect(r.effect) == "allow", "effect")
  assert(len(r.actions) == 1 && actionName(r.actions[0]) == "Publish", "actions")
  assert(pdResource(r.resource) == "Article", "resource")
  assert(r.policy == "PublishOwnTeam", "policy ${r.policy}")
  match (r.cond) {
    And(cs) => assert(len(cs) == 2, "2 conditions, got ${len(cs)}")
    _ => assert(false, "when is not an and of team and status")
  }
}

// The #6984 design's second document, decoded through @json.
test "the inkwell attachment document decodes and validates" {
  let text = "{ \"policy\": \"PublishOwnTeam\", \"to\": { \"role\": \"author\" }, \"tenant\": \"inkwell\" }"
  let a = jsonDecodeText<Attachment>(text) catch e {
    panic("decode: ${e.message()}")
  }
  assert(a.policy == "PublishOwnTeam" && a.tenant == "inkwell", "fields")
  assert(unwrap(a.to.role) == "author" && !isSome(a.to.group) && !isSome(a.to.user), "target")
  pdAuthz().validateAttachment(a) catch e {
    panic("validate: ${e.message()}")
  }
}

test "an attachment with an empty tenant is global and a user target is valid" {
  let a = jsonDecodeText<Attachment>("{\"policy\":\"P\",\"to\":{\"user\":\"sara@example.com\"},\"tenant\":\"\"}") catch e {
    panic("decode: ${e.message()}")
  }
  pdAuthz().validateAttachment(a) catch e {
    panic("validate: ${e.message()}")
  }
}

test "deny, CEL, null and every-resource statements validate" {
  let doc = PolicyDoc{
    name = "Mixed",
    statements = [
      pdStmt(
        "deny",
        ["Update", "Delete"],
        "Article",
        "{ \"status\": { \"$in\": [\"a\", \"b\"] } }",
      ),
      pdStmt(
        "allow",
        ["Read"],
        "Article",
        "\"resource.team == user.team && resource.status == 'live'\"",
      ),
      pdStmt("allow", ["Manage"], "*", "null"),
      pdStmt("allow", ["Read"], "*", "{}"),
    ],
  }
  let cp = pdAuthz().validateDoc(doc) catch e {
    panic("validate: ${e.message()}")
  }
  assert(len(cp.rules) == 4, "rules ${len(cp.rules)}")
  assert(pdEffect(cp.rules[0].effect) == "deny" && len(cp.rules[0].actions) == 2, "deny rule")
  assert(pdResource(cp.rules[2].resource) == "*", "every resource")
}

test "12 of 12 invalid policy documents are refused with a JSON Pointer" {
  let ok = ["Read"]
  let at = "/statements/0"
  pdRefused(
    "1 unknown action",
    pdOne(pdStmt("allow", ["Publsh"], "Article", "null")),
    "${at}/actions/0: unknown action 'Publsh'; valid actions: Manage, Read",
  )
  pdRefused(
    "2 unknown resource",
    pdOne(pdStmt("allow", ok, "Artcle", "null")),
    "${at}/resource: unknown resource 'Artcle' (registered: Article)",
  )
  pdRefused(
    "3 bad effect",
    pdOne(pdStmt("permit", ok, "Article", "null")),
    "${at}/effect: must be \"allow\" or \"deny\", got \"permit\"",
  )
  pdRefused(
    "4 no statements",
    PolicyDoc{ name = "Doc", statements = []Statement(0) },
    "/statements: must hold 1 to 64 statements, got 0",
  )
  let many = []Statement(0)
  let i = 0
  while (i < 65) {
    many = append(many, pdStmt("allow", ok, "Article", "null"))
    i = i + 1
  }
  pdRefused(
    "5 65 statements",
    PolicyDoc{ name = "Doc", statements = many },
    "/statements: must hold 1 to 64 statements, got 65",
  )
  let big = "\"${repeat("x", 65 * 1024)}\""
  pdRefused("6 65 KiB", pdOne(pdStmt("allow", ok, "Article", big)), "#: document holds ")
  pdRefused(
    "7 bad name",
    PolicyDoc{ name = "bad name", statements = [pdStmt("allow", ok, "Article", "null")] },
    "/name: character 3 is not one of",
  )
  pdRefused(
    "8 bad when",
    pdOne(pdStmt("allow", ok, "Article", "{ \"titel\": \"x\" }")),
    "${at}/when/titel: Article has no field \"titel\" (closest: \"title\")",
  )
  pdRefused(
    "9 star action",
    pdOne(pdStmt("allow", ["*"], "Article", "null")),
    "${at}/actions/0: \"*\" is not an action",
  )
  pdRefused(
    "10 CEL size()",
    pdOne(pdStmt("allow", ok, "Article", "\"size(resource.title) > 3\"")),
    "${at}/when: cel: ",
  )
  pdRefused(
    "11 no actions",
    pdOne(pdStmt("allow", []string(0), "Article", "null")),
    "${at}/actions: needs at least one action",
  )
  pdRefused(
    "12 field on every resource",
    pdOne(pdStmt("allow", ok, "*", "{ \"team\": \"x\" }")),
    "${at}/when/team: * has no field",
  )
}

test "a fault deep in a condition names its whole path" {
  let doc = PolicyDoc{
    name = "Doc",
    statements = [
      pdStmt("allow", ["Read"], "Article", "null"),
      pdStmt(
        "allow",
        ["Read"],
        "Article",
        "{ \"$or\": [ { \"team\": \"a\" }, { \"statuss\": \"b\" } ] }",
      ),
    ],
  }
  pdRefused("deep", doc, "/statements/1/when/$or/1/statuss: ")
}

test "a when that is a number is refused" {
  pdRefused(
    "number",
    pdOne(pdStmt("allow", ["Read"], "Article", "5")),
    "/statements/0/when: must be a JSON object, a CEL string or null, got an integer",
  )
}

test "the 64 statement and 64 character name ceilings are accepted" {
  let many = []Statement(0)
  let i = 0
  while (i < 64) {
    many = append(many, pdStmt("allow", ["Read"], "Article", "null"))
    i = i + 1
  }
  let doc = PolicyDoc{ name = repeat("n", 64), statements = many }
  assert(pdRun(doc) == "OK", pdRun(doc))
  let long = PolicyDoc{ name = repeat("n", 65), statements = many }
  pdRefused("65 character name", long, "/name: must be 1 to 64 characters, got 65")
}

fn pdAttach(text: string): string {
  let a = jsonDecodeText<Attachment>(text) catch e {
    return "DECODE ${e.message()}"
  }
  pdAuthz().validateAttachment(a) catch e {
    return e.message()
  }
  return "OK"
}

test "attachments: a target needs exactly one key and names are checked" {
  let want = "invalid policy: /to: exactly one of role, group, user must be set, got"
  assert(
    hasPrefix(
      pdAttach("{\"policy\":\"P\",\"to\":{\"role\":\"a\",\"group\":\"g\"},\"tenant\":\"\"}"),
      "${want} 2",
    ),
    "2 keys",
  )
  assert(
    hasPrefix(pdAttach("{\"policy\":\"P\",\"to\":{},\"tenant\":\"\"}"), "${want} 0"),
    "empty target",
  )
  assert(
    hasPrefix(
      pdAttach("{\"policy\":\"P Q\",\"to\":{\"role\":\"a\"},\"tenant\":\"\"}"),
      "invalid policy: /policy: character 1",
    ),
    "policy name",
  )
  assert(
    hasPrefix(
      pdAttach("{\"policy\":\"P\",\"to\":{\"role\":\"a b\"},\"tenant\":\"\"}"),
      "invalid policy: /to/role: character 1",
    ),
    "role name",
  )
  assert(
    hasPrefix(
      pdAttach("{\"policy\":\"P\",\"to\":{\"role\":\"a\"},\"tenant\":\"t/1\"}"),
      "invalid policy: /tenant: character 1",
    ),
    "tenant name",
  )
  assert(
    hasPrefix(
      pdAttach("{\"policy\":\"P\",\"to\":{\"user\":\"\"},\"tenant\":\"\"}"),
      "invalid policy: /to/user: must be 1 to 256",
    ),
    "empty user",
  )
}
