// pkg/authz/errors.test.bit — status() and message() of every error class,
// and the rule that a client-facing message never names the deciding policy.

import { contains } from "std/strings"

test "Denied is a 403 with a fixed message" {
  let e = Denied{ policy = "EditOwnArticles", action = "Update", resource = "Article" }
  assert(e.status() == 403, "status: ${e.status()}")
  assert(e.message() == "forbidden", "message: ${e.message()}")
}

test "Denied.message() does not contain the policy name" {
  let e = Denied{ policy = "EditOwnArticles", action = "Update", resource = "Article" }
  assert(!contains(e.message(), "EditOwnArticles"), "message leaks the policy: ${e.message()}")
  assert(e.deciding() == "EditOwnArticles", "deciding: ${e.deciding()}")
}

test "Denied still carries the action and resource for the log" {
  let e = Denied{ policy = "p", action = "Update", resource = "Article" }
  assert(e.action == "Update", "action: ${e.action}")
  assert(e.resource == "Article", "resource: ${e.resource}")
}

test "NotFound is a 404" {
  let e = NotFound{}
  assert(e.status() == 404, "status: ${e.status()}")
  assert(e.message() == "not found", "message: ${e.message()}")
}

test "StoreUnavailable is a 503 that names no store" {
  let e = StoreUnavailable{}
  assert(e.status() == 503, "status: ${e.status()}")
  assert(e.message() == "authorization unavailable", "message: ${e.message()}")
}

test "InvalidPolicy is a 400 carrying its detail" {
  let e = InvalidPolicy{ detail = "unknown action 'Frobnicate'" }
  assert(e.status() == 400, "status: ${e.status()}")
  assert(contains(e.message(), "unknown action 'Frobnicate'"), "message: ${e.message()}")
}

test "NotFilterable is a 500 naming the policy" {
  let e = NotFilterable{ policy = "OnlyBusinessHours" }
  assert(e.status() == 500, "status: ${e.status()}")
  assert(contains(e.message(), "OnlyBusinessHours"), "message: ${e.message()}")
}

// The `pkg/web/errors.bit` shape, declared locally: the structure is the
// whole contract, so the test needs no import of pkg/web.
interface HttpError {
  message(): string,
  status(): int,
}

test "every error class satisfies HttpError" {
  let (_, a) = Denied{ policy = "p", action = "a", resource = "r" }.(HttpError)
  let (_, b) = NotFound{}.(HttpError)
  let (_, c) = StoreUnavailable{}.(HttpError)
  let (_, d) = InvalidPolicy{ detail = "x" }.(HttpError)
  let (_, e) = NotFilterable{ policy = "p" }.(HttpError)
  assert(a && b && c && d && e, "each class must opt in to pkg/web's mapping")
}

test "RelationLimit is a 500 naming the bound it hit" {
  let e = RelationLimit{ limit = "maxDepth", bound = 8 }
  assert(e.status() == 500, "status: ${e.status()}")
  assert(
    e.message() == "relationship check stopped at maxDepth 8; treated as not related",
    "message: ${e.message()}",
  )
}
