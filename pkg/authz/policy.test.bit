// pkg/authz/policy.test.bit — Policy and Rules: what `p.can` / `p.cannot`
// record, the policy name on every rule, and what registration refuses.

@table class PlPost {
  @id
  id: i64
  authorId: string
  status: string
}

@table class PlDraft {
  @id
  id: i64
  note: string
}

class PlWriter {
  export id: string,
  export roles: []string,
}

fn plWriter(): PlWriter {
  return PlWriter{ id = "sara", roles = []string(0) }
}

fn plAuthz(): Authz<Action> {
  let a = Authz<Action>() catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<PlPost>() catch e {
    panic("resource: ${e.message()}")
  }
  return a
}

fn plSample(): Policy<PlWriter, Action> {
  return Policy("Sample", (p, user) => {
    p.can<PlPost>([Action.Read, Action.Update, Action.Delete], eq("authorId", Value.Text(user.id)))
    p.cannot<PlPost>([Action.Update], eq("status", Value.Text("archived")))
    p.canAll([Action.Read])
    p.cannotAll([Action.Delete])
    p.can<PlPost>([Action.Create])
  })
}

fn plEffect(e: Effect): string {
  return match (e) {
    Allow => "allow"
    Deny => "deny"
  }
}

fn plResource(r: ResourceRef): string {
  return match (r) {
    All => "all"
    Named(n) => n
  }
}

fn plCond(c: Cond): string {
  return match (c) {
    True => "true"
    Cmp(f, _, _) => f
    _ => "other"
  }
}

fn plText(o: Operand): string {
  return match (o) {
    Lit(v) => plValue(v)
    _ => ""
  }
}

fn plValue(v: Value): string {
  return match (v) {
    Text(s) => s
    _ => ""
  }
}

fn plShape(r: Rule<Action>): string {
  return "${plEffect(r.effect)} ${len(r.actions)} ${plResource(r.resource)} ${plCond(r.cond)} ${r.policy}"
}

test "rulesFor returns 5 of 5 rules in the order they were written" {
  let rules = plSample().rulesFor(plWriter())
  let want = [
    "allow 3 PlPost authorId Sample",
    "deny 1 PlPost status Sample",
    "allow 1 all true Sample",
    "deny 1 all true Sample",
    "allow 1 PlPost true Sample",
  ]
  assert(len(rules) == len(want), "rules: ${len(rules)} of ${len(want)}")
  let i = 0
  while (i < len(want)) {
    assert(plShape(rules[i]) == want[i], "rule ${i}: ${plShape(rules[i])}")
    i = i + 1
  }
}

test "a can over a list of 3 actions is 1 rule holding all 3" {
  let r = plSample().rulesFor(plWriter())[0]
  assert(len(r.actions) == 3, "actions: ${len(r.actions)}")
  assert(
    r.actions[0] == Action.Read && r.actions[1] == Action.Update && r.actions[2] == Action.Delete,
    "order lost",
  )
}

test "the closure sees the subject it is run for" {
  let other = PlWriter{ id = "omar", roles = []string(0) }
  let r = plSample().rulesFor(other)[0]
  match (r.cond) {
    Cmp(_, _, vs) => assert(plText(vs[0]) == "omar", "value is not omar's id")
    _ => assert(false, "not a comparison")
  }
}

test "each rulesFor call starts from an empty Rules" {
  let p = plSample()
  let _ = p.rulesFor(plWriter())
  assert(len(p.rulesFor(plWriter())) == 5, "rules leaked between calls")
}

// The message `validatePolicy` fails with for `p`, or "" when it accepts.
fn plFault(p: Policy<PlWriter, Action>): string {
  plAuthz().validatePolicy<PlWriter>(p, plWriter()) catch e {
    return e.message()
  }
  return ""
}

test "a registered policy passes validation" {
  assert(plFault(plSample()) == "", "refused: ${plFault(plSample())}")
}

test "a policy takes its type arguments from the annotated let (#7299)" {
  let p: Policy<PlWriter, Action> = Policy("Annotated", (p, user) => {
    p.can<PlPost>([Action.Read], eq("authorId", Value.Text(user.id)))
  })
  assert(plFault(p) == "", "refused: ${plFault(p)}")
  assert(len(p.rulesFor(plWriter())) == 1, "expected one rule")
}

test "a resource that is not registered is refused, naming policy and rule" {
  let p = Policy<PlWriter, Action>("Drafts", (p, user) => {
    p.can<PlPost>([Action.Read])
    p.can<PlDraft>([Action.Read])
  })
  let msg = plFault(p)
  assert(hasPrefix(msg, "invalid policy: policy Drafts rule 1: unknown resource PlDraft"), msg)
}

test "a rule with no actions is refused, naming policy and rule" {
  let p = Policy<PlWriter, Action>("Empty", (p, user) => {
    p.cannot<PlPost>([Action.Read])
    p.can<PlPost>([])
  })
  assert(plFault(p) == "invalid policy: policy Empty rule 1: no actions", plFault(p))
}

test "a condition on a missing field is refused, naming policy and rule" {
  let p = Policy<PlWriter, Action>("Typo", (p, user) => {
    p.can<PlPost>([Action.Read], eq("owner", Value.Text(user.id)))
  })
  assert(hasPrefix(plFault(p), "invalid policy: policy Typo rule 0: no field owner"), plFault(p))
}

test "a condition on all cannot name a field" {
  let p = Policy<PlWriter, Action>("Wide", (p, user) => {
    p.can<PlPost>([Action.Read])
    p.canAll([Action.Read])
  })
  assert(plFault(p) == "", "canAll is True and names no field: ${plFault(p)}")
}
