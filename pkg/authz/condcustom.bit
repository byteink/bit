// pkg/authz/condcustom.bit — the escape hatch: a rule written as a code
// function.
//
//   p.canIf<Article>([Update], "PublishWindowOpen", (a) => a.publishAt <= now())
//
// A function can say anything, so it answers a single check
// (`authz.can(user, Update, article)`) but it cannot become a WHERE clause: a
// list read over it has no SQL to run. That fails loudly, never by quietly
// listing everything or nothing: `filterable` finds the first code function
// in a condition, and the list filter (and the SQL compiler) refuse it with a
// `NotFilterable` that names the policy and the label. It is a developer
// error, raised the first time a scoped list read evaluates the rule;
// `Authz.validateFilterable` asserts it at startup instead.
//
// ERASURE. A `Cond` is not generic over the row class, so the test is kept as
// `(AnyRow) => bool`. A generic `T` cannot be stored in an interface (only a
// class or an enum can), so the row travels in a `RowBox<T>`, which can;
// `custom<T>` wraps the typed `(T) => bool` in a closure that asserts the box
// is a `RowBox<T>`. A row of another class does not hold: fail closed. The box
// is allocated only for a condition that holds a code function (`hasCustom`),
// so a data-only decision pays nothing for it.

// What a `Custom` test receives: the row, behind a box.
interface AnyRow {}

class RowBox<T: Tabled> {
  row: T,
}

// A condition that holds when `test` returns true for the row. `label` names
// the rule for the log and for `NotFilterable` ("PublishWindowOpen"); an empty
// one is refused when the policy is registered.
export fn custom<T: Tabled>(label: string, test: (T) => bool): Cond {
  return Cond.Custom(label, (row: AnyRow) => {
    let (box, ok) = row.(RowBox<T>)
    if (!ok) {
      return false
    }
    return test(box.row)
  })
}

// `row` boxed for `evalRow` when `c` holds a code function, else nil: no
// other condition reads it.
fn boxRow<T: Tabled>(c: Cond, row: T): AnyRow {
  if (!hasCustom(c)) {
    return nil
  }
  return RowBox<T>{ row = row }
}

fn anyCustom(cs: []Cond): bool {
  for c of cs {
    if (hasCustom(c)) {
      return true
    }
  }
  return false
}

// Does `c` hold a code function? Reads only; allocates nothing.
fn hasCustom(c: Cond): bool {
  return match (c) {
    Custom(_, _) => true
    And(cs) => anyCustom(cs)
    Or(cs) => anyCustom(cs)
    Not(inner) => hasCustom(inner)
    _ => false
  }
}

fn firstCustom(cs: []Cond): Option<string> {
  for c of cs {
    let got = filterable(c)
    if (isSome(got)) {
      return got
    }
  }
  return Option<string>.None
}

// The label of the first code function in `c`, however deeply it sits under
// `and`, `or` and `not`, or None when `c` is data all the way down and so can
// become SQL.
export fn filterable(c: Cond): Option<string> {
  return match (c) {
    Custom(label, _) => Option<string>.Some(label)
    And(cs) => firstCustom(cs)
    Or(cs) => firstCustom(cs)
    Not(inner) => filterable(inner)
    _ => Option<string>.None
  }
}

// Fails with a NotFilterable naming `policy` and the label when `c` holds a
// code function.
fn refuseCustom(policy: string, c: Cond): ()! {
  let label = filterable(c)
  if (isSome(label)) {
    fail NotFilterable{ policy = policy, label = unwrap(label) }
  }
}

// Fails with a NotFilterable for the first rule of `rules` that applies to
// resource `className` and `action` and holds a code function.
fn checkRulesFilterable<A: ActionEnum>(
  rules: []Rule<A>,
  className: string,
  action: string,
  wildcard: bool,
): ()! {
  for r of rules {
    if (applies<A>(r, className, action, wildcard)) {
      refuseCustom(r.policy, r.cond)?
    }
  }
}

// `checkRulesFilterable` over every role's sample rules.
fn checkRolesFilterable<A: ActionEnum>(
  roles: []RoleDef<A>,
  className: string,
  action: string,
  wildcard: bool,
): ()! {
  for def of roles {
    checkRulesFilterable<A>(def.sample, className, action, wildcard)?
  }
}
