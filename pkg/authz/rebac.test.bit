// pkg/authz/rebac.test.bit — declared relations and the relationship check
// (`hasRelation`): usersets, inheritance, cycles and every bound.

import { indexOf as find } from "std/strings"

@table class Shelf {
  @id
  id: i64
  name: string
}

@table class Crew {
  @id
  id: i64
  name: string
}

// A store that counts the pages the walk asks for.
class Counting {
  inner: MemoryRelationStore
  calls: int
  biggest: int

  export write(t: Tuple): ()! {
    this.inner.write(t)?
  }

  export delete(t: Tuple): ()! {
    this.inner.delete(t)?
  }

  export has(t: Tuple): bool! {
    return this.inner.has(t)?
  }

  export direct(object: string, relation: string, offset: int, limit: int): []string! {
    this.calls = this.calls + 1
    if (limit > this.biggest) {
      this.biggest = limit
    }
    return this.inner.direct(object, relation, offset, limit)?
  }

  export list(subject: string): []Tuple! {
    return this.inner.list(subject)?
  }

  export version(): i64! {
    return this.inner.version()?
  }
}

// A store that is down.
class Down {
  export write(t: Tuple): ()! {
    fail StoreUnavailable{}
  }

  export delete(t: Tuple): ()! {
    fail StoreUnavailable{}
  }

  export has(t: Tuple): bool! {
    fail StoreUnavailable{}
  }

  export direct(object: string, relation: string, offset: int, limit: int): []string! {
    fail StoreUnavailable{}
  }

  export list(subject: string): []Tuple! {
    fail StoreUnavailable{}
  }

  export version(): i64! {
    fail StoreUnavailable{}
  }
}

fn boot(maxDepth: int, maxVisited: int, maxFanout: int): Authz<Action> {
  let a = Authz<Action>(maxDepth = maxDepth, maxVisited = maxVisited, maxFanout = maxFanout) catch e {
    panic("Authz: ${e.message()}")
  }
  let _ = a.resource<Shelf>() catch e {
    panic(e.message())
  }
  let _ = a.resource<Crew>() catch e {
    panic(e.message())
  }
  let _ = a.relation<Crew>("member") catch e {
    panic(e.message())
  }
  let _ = a.relation<Shelf>("parent") catch e {
    panic(e.message())
  }
  let _ = a.relation<Shelf>("editor", inherit = "parent") catch e {
    panic(e.message())
  }
  let _ = a.relation<Shelf>("viewer") catch e {
    panic(e.message())
  }
  return a
}

fn graph(): Authz<Action> {
  return boot(8, 10_000, 10_000)
}

fn put(a: Authz<Action>, s: string, r: string, o: string) {
  a.relate(s, r, o) catch e {
    panic(e.message())
  }
}

// "true", "false", or the message of the error the check failed with.
fn outcome(a: Authz<Action>, s: string, r: string, o: string): string {
  let yes = a.hasRelation(s, r, o) catch e {
    return e.message()
  }
  if (yes) {
    return "true"
  }
  return "false"
}

fn has(a: Authz<Action>, s: string, r: string, o: string): bool {
  return outcome(a, s, r, o) == "true"
}

// shelf:f0 has parent f1, which has parent f2 ... up to f<n>.
fn chain(a: Authz<Action>, n: int) {
  let i = 0
  while (i < n) {
    put(a, "shelf:f${i + 1}", "parent", "shelf:f${i}")
    i = i + 1
  }
}

fn refusal(a: Authz<Action>, s: string, r: string, o: string): string {
  a.relate(s, r, o) catch e {
    return e.message()
  }
  return ""
}

test "1 of 10: a direct tuple answers true" {
  let a = graph()
  put(a, "user:sara", "editor", "shelf:launch")
  assert(has(a, "user:sara", "editor", "shelf:launch"), "direct tuple")
}

test "2 of 10: a userset subject expands to its members" {
  let a = graph()
  put(a, "crew:eng#member", "editor", "shelf:launch")
  put(a, "user:sara", "member", "crew:eng")
  assert(has(a, "user:sara", "editor", "shelf:launch"), "member of eng")
  assert(!has(a, "user:bob", "editor", "shelf:launch"), "bob is not a member")
}

test "3 of 10: editor is inherited through three levels of parents" {
  let a = graph()
  chain(a, 3)
  put(a, "user:sara", "editor", "shelf:f3")
  assert(has(a, "user:sara", "editor", "shelf:f0"), "3 levels")
  assert(has(a, "user:sara", "editor", "shelf:f2"), "1 level")
  assert(!has(a, "user:sara", "editor", "shelf:f4"), "a folder above the grant")
}

test "4 of 10: a cycle terminates and answers false" {
  let a = graph()
  put(a, "shelf:b", "parent", "shelf:a")
  put(a, "shelf:a", "parent", "shelf:b")
  assert(outcome(a, "user:sara", "editor", "shelf:a") == "false", "cycle of 2")
  put(a, "crew:x#member", "member", "crew:x")
  assert(outcome(a, "user:sara", "member", "crew:x") == "false", "userset naming itself")
  put(a, "user:sara", "editor", "shelf:b")
  assert(has(a, "user:sara", "editor", "shelf:a"), "a grant inside the cycle is found")
}

test "5 of 10: depth 8 is allowed at the default maxDepth" {
  let a = graph()
  chain(a, 8)
  put(a, "user:sara", "editor", "shelf:f8")
  assert(has(a, "user:sara", "editor", "shelf:f0"), "8 hops")
}

test "6 of 10: depth 9 is denied at the default maxDepth with a RelationLimit" {
  let a = graph()
  chain(a, 9)
  put(a, "user:sara", "editor", "shelf:f9")
  assert(
      outcome(a, "user:sara", "editor", "shelf:f0") ==
      "relationship check stopped at maxDepth 8; treated as not related",
    "9 hops: ${outcome(a, "user:sara", "editor", "shelf:f0")}",
  )
}

test "7 of 10: depth 9 is allowed at maxDepth 9" {
  let a = boot(9, 10_000, 10_000)
  chain(a, 9)
  put(a, "user:sara", "editor", "shelf:f9")
  assert(has(a, "user:sara", "editor", "shelf:f0"), "9 hops at maxDepth 9")
}

test "8 of 10: maxVisited stops the walk, and one more node is enough" {
  let tight = boot(20, 8, 10_000)
  chain(tight, 8)
  put(tight, "user:sara", "editor", "shelf:f8")
  let m = outcome(tight, "user:sara", "editor", "shelf:f0")
  assert(m == "relationship check stopped at maxVisited 8; treated as not related", m)
  let roomy = boot(20, 9, 10_000)
  chain(roomy, 8)
  put(roomy, "user:sara", "editor", "shelf:f8")
  assert(has(roomy, "user:sara", "editor", "shelf:f0"), "9 nodes at maxVisited 9")
}

test "9 of 10: 2500 subjects on one node are read in pages of at most 1000" {
  let a = graph()
  let counting = Counting{ inner = MemoryRelationStore(), calls = 0, biggest = 0 }
  a.relations = counting
  let i = 0
  while (i < 2500) {
    put(a, "user:u${i}", "editor", "shelf:big")
    i = i + 1
  }
  assert(has(a, "user:u2499", "editor", "shelf:big"), "the last of 2500")
  assert(counting.calls == 3, "pages read: ${counting.calls}")
  assert(counting.biggest == 1000, "largest page asked for: ${counting.biggest}")
}

test "10 of 10: a subject with no path is false" {
  let a = graph()
  chain(a, 3)
  put(a, "user:sara", "editor", "shelf:f3")
  put(a, "crew:eng#member", "viewer", "shelf:f0")
  assert(outcome(a, "user:bob", "editor", "shelf:f0") == "false", "bob")
  assert(outcome(a, "user:sara", "viewer", "shelf:f0") == "false", "sara is not a viewer")
}

test "maxFanout stops one node's read, and exactly maxFanout subjects is within it" {
  let a = boot(8, 10_000, 2000)
  let i = 0
  while (i < 2500) {
    put(a, "user:u${i}", "editor", "shelf:big")
    i = i + 1
  }
  assert(has(a, "user:u1999", "editor", "shelf:big"), "the 2000th subject is read")
  let m = outcome(a, "user:u2400", "editor", "shelf:big")
  assert(m == "relationship check stopped at maxFanout 2000; treated as not related", m)
  let exact = boot(8, 10_000, 2000)
  let j = 0
  while (j < 2000) {
    put(exact, "user:u${j}", "editor", "shelf:big")
    j = j + 1
  }
  assert(outcome(exact, "user:nobody", "editor", "shelf:big") == "false", "exactly at the cap")
}

test "a hit found beside a bound is still true" {
  let a = boot(1, 10_000, 10_000)
  put(a, "shelf:p1", "parent", "shelf:f0")
  put(a, "shelf:p2", "parent", "shelf:f0")
  put(a, "shelf:q", "parent", "shelf:p1")
  put(a, "user:sara", "editor", "shelf:p2")
  assert(has(a, "user:sara", "editor", "shelf:f0"), "p2 is one hop away")
  assert(
    find(outcome(a, "user:bob", "editor", "shelf:f0"), "maxDepth 1") >= 0,
    "bob hits the bound",
  )
}

test "only a relation that declares inherit is inherited" {
  let a = graph()
  put(a, "shelf:f1", "parent", "shelf:f0")
  put(a, "user:sara", "viewer", "shelf:f1")
  assert(outcome(a, "user:sara", "viewer", "shelf:f0") == "false", "viewer is not inherited")
}

test "a store that is down fails the check, it does not answer false" {
  let a = graph()
  a.relations = Down{}
  assert(outcome(a, "user:sara", "editor", "shelf:f0") == "authorization unavailable", "closed")
}

test "an undeclared relation is refused by relate, unrelate, related and hasRelation" {
  let a = graph()
  let want = "invalid policy: relation is not declared on shelf (declared: editor, parent, viewer)"
  assert(refusal(a, "user:sara", "edtior", "shelf:launch") == want, "relate")
  a.unrelate("user:sara", "edtior", "shelf:launch") catch e {
    assert(e.message() == want, "unrelate: ${e.message()}")
    let r = a.related("user:sara", "edtior", "shelf:launch") catch e2 {
      assert(e2.message() == want, "related: ${e2.message()}")
      assert(outcome(a, "user:sara", "edtior", "shelf:launch") == want, "hasRelation")
      return
    }
    assert(false, "related accepted a typo: ${r}")
  }
  assert(false, "unrelate accepted a typo")
}

test "a userset's relation must be declared on its type" {
  let a = graph()
  let m = refusal(a, "crew:eng#membr", "editor", "shelf:launch")
  assert(m == "invalid policy: subject relation is not declared on crew (declared: member)", m)
  let u = refusal(a, "user:sara#member", "editor", "shelf:launch")
  assert(u == "invalid policy: subject relation is not declared on user (declared: none)", u)
}

test "a type with no declared relation says so" {
  let a = Authz<Action>() catch e {
    panic(e.message())
  }
  let _ = a.resource<Shelf>() catch e {
    panic(e.message())
  }
  let m = refusal(a, "user:sara", "editor", "shelf:launch")
  assert(m == "invalid policy: relation is not declared on shelf (declared: none)", m)
}

fn declare(a: Authz<Action>, name: string, inherit: string): string {
  a.relation<Shelf>(name, inherit = inherit) catch e {
    return e.message()
  }
  return ""
}

test "relation<T>() refuses a duplicate, a bad name and a bad inherit" {
  let a = graph()
  assert(
    declare(a, "editor", "") == "invalid policy: relation editor is declared twice on Shelf",
    "twice",
  )
  assert(
    declare(a, "Owner", "") == "invalid policy: relation must match [a-z][a-z0-9_]{0,31}",
    "format",
  )
  assert(
      declare(a, "owner", "ghost") ==
      "invalid policy: relation owner inherits through ghost, which shelf does not declare (declare it first)",
    "inherit undeclared",
  )
  assert(
    declare(a, "owner", "owner") == "invalid policy: relation owner cannot inherit through itself",
    "inherit self",
  )
  assert(declare(a, "owner", "parent") == "", "a valid inherit")
}

test "relation<T>() on a class that was not registered is refused" {
  let a = Authz<Action>() catch e {
    panic(e.message())
  }
  let m = declare(a, "editor", "")
  assert(m == "invalid policy: Shelf is not registered; call resource<Shelf>() first", m)
}

fn built(maxDepth: int, maxVisited: int, maxFanout: int): string {
  let _ = Authz<Action>(maxDepth = maxDepth, maxVisited = maxVisited, maxFanout = maxFanout) catch e {
    return e.message()
  }
  return ""
}

test "a bound below 1 is an InvalidPolicy at construction" {
  let want = "invalid policy: maxDepth, maxVisited and maxFanout must each be at least 1"
  assert(built(0, 1, 1) == want, "maxDepth 0")
  assert(built(1, 0, 1) == want, "maxVisited 0")
  assert(built(1, 1, -1) == want, "maxFanout -1")
  assert(built(1, 1, 1) == "", "all three at 1")
}
