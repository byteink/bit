// pkg/authz/condrow.bit — how a `@table` class's declared columns line up
// with the values `__values()` returns, so a condition can read a row's field
// by name.
//
// `__columns()` lists every field of the class; `__values()` lists only the
// ones a database row carries: a scalar (`i64`, `int`, `f64`, `bool`,
// `string`, `[]byte`) or an `Option` of one, and never a relation field
// (`@hasMany`, `@hasOne`, `@belongsTo`, `@manyToMany`). A condition may
// mention only those fields, so `rowColumns` keeps exactly them, in order,
// and position `i` of its result is position `i` of `__values()`.

import { Value, isNull } from "std/sql"

// The kind of value a column holds, which decides what a condition may compare
// it with. `Option<T>` has the kind of `T`.
enum ColKind { Int, Float, Bool, Text, Blob }

fn stripSpaces(s: string): string {
  let out = []u8(0)
  let i = 0
  while (i < len(s)) {
    if (s[i] != ' ') {
      out = append(out, s[i])
    }
    i = i + 1
  }
  return string(out)
}

// The text between `Option<` and the closing `>`, or `t` when it is no Option.
fn unwrapOption(t: string): string {
  let pre = "Option<"
  if (len(t) > len(pre) + 1 && t[0:len(pre)] == pre && t[len(t) - 1] == '>') {
    return t[len(pre):len(t) - 1]
  }
  return t
}

// The kind a declared type spells, as the compiler wrote it in `typeName`
// ("i64", "Option<string>"), or None when the type is no row scalar.
fn columnKind(typeName: string): Option<ColKind> {
  let t = unwrapOption(stripSpaces(typeName))
  if (t == "i64" || t == "int") {
    return Option<ColKind>.Some(ColKind.Int)
  }
  if (t == "f64") {
    return Option<ColKind>.Some(ColKind.Float)
  }
  if (t == "bool") {
    return Option<ColKind>.Some(ColKind.Bool)
  }
  if (t == "string") {
    return Option<ColKind>.Some(ColKind.Text)
  }
  if (t == "[]byte" || t == "[]u8") {
    return Option<ColKind>.Some(ColKind.Blob)
  }
  return Option<ColKind>.None
}

fn isRelation(c: FieldDesc): bool {
  for a of c.attrs {
    if (a.name == "hasMany" ||
      a.name == "hasOne" ||
      a.name == "belongsTo" ||
      a.name == "manyToMany") {
      return true
    }
  }
  return false
}

// The columns `__values()` carries a value for, in the same order.
fn rowColumns(columns: []FieldDesc): []FieldDesc {
  let out = []FieldDesc(0)
  for c of columns {
    if (isSome(columnKind(c.typeName)) && !isRelation(c)) {
      out = append(out, c)
    }
  }
  return out
}

// The row's column names, or an InvalidPolicy when the columns and values do
// not pair up (a class shape this package does not know how to read).
fn rowNames(columns: []FieldDesc, values: []Value): []string! {
  let cols = rowColumns(columns)
  if (len(cols) != len(values)) {
    fail InvalidPolicy{ detail = "row has ${len(values)} values for ${len(cols)} columns" }
  }
  let names = []string(0)
  for c of cols {
    names = append(names, c.name)
  }
  return names
}
