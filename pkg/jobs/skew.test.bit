// pkg/jobs/skew.test.bit — an instance whose clock disagrees with the
// database's fires no scheduled tick (scheduler.bit `checkSkew`, #6368).
// Time is the `fakeClock` and the `fakeLocker` of scheduler.test.bit, which
// own the shared helpers; `fourYears` is clockback.test.bit's.

import { Second, Minute } from "std/time"

fn skewedQueue(store: fakeStore, clock: fakeClock, locker: fakeLocker): Queue {
  let q = queueOn(store, clock, locker, "a")
  mustEvery(q, Missed.RunAll(10))
  return q
}

// `skewedQueue` with its records kept in `sink` (joblog.test.bit).
fn loggedSkewedQueue(store: fakeStore, clock: fakeClock, locker: fakeLocker, sink: LgSink): Queue {
  let q = lgQueueOn(store, clock, locker, sink)
  mustEvery(q, Missed.RunAll(10))
  return q
}

fn checkSkewNow(q: Queue, clock: fakeClock) {
  checkSkew(q, clock.nowNs()) catch err {
    panic("checkSkew: ${err.message()}")
  }
}

test "a database clock 4 years behind blocks every enqueue and logs once" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let sink = lgSink()
  let q = loggedSkewedQueue(store, clock, locker, sink)
  locker.offset = 0 - fourYears
  checkSkewNow(q, clock)
  let want = "level=WARN msg=\"cron clock skewed from the database, not firing ticks\" skew=126230400s"
  assert(len(sink.lines) == 1 && sink.lines[0] == want, "got ${lgAll(sink)}")
  let i = 0
  while (i < 5) {
    clock.advance(Minute)
    runDue(q, clock.nowNs())
    i = i + 1
  }
  assert(dueCount(store) == 0, "a skewed instance enqueued ${dueCount(store)} jobs")
  checkSkewNow(q, clock)
  assert(len(sink.lines) == 1, "the same state is logged once, got ${lgAll(sink)}")
  assert(q.skewed, "the instance must still be skewed")
}

test "a database clock 4 years ahead blocks too, and the check runs once a minute" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = skewedQueue(store, clock, locker)
  locker.offset = fourYears
  runDue(q, clock.nowNs())
  clock.advance(30 * Second)
  runDue(q, clock.nowNs())
  assert(
    locker.serverCalls == 1,
    "two passes inside a minute read the database clock once, got ${locker.serverCalls}",
  )
  clock.advance(30 * Second)
  runDue(q, clock.nowNs())
  assert(locker.serverCalls == 2, "a minute later it reads again, got ${locker.serverCalls}")
  assert(dueCount(store) == 0, "nothing fires, got ${dueCount(store)}")
}

test "when the clocks agree again the scheduler resumes and says so" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let sink = lgSink()
  let q = loggedSkewedQueue(store, clock, locker, sink)
  locker.offset = 0 - fourYears
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "blocked while skewed, got ${dueCount(store)}")
  locker.offset = 0
  clock.advance(Minute)
  checkSkewNow(q, clock)
  let want = "level=INFO msg=\"cron clock agrees with the database again, firing ticks\""
  assert(sink.lines[len(sink.lines) - 1] == want, "got ${lgAll(sink)}")
  runDue(q, clock.nowNs())
  assert(dueCount(store) > 0, "the ticks that came due fire once the clocks agree")
  assert(!q.skewed, "no longer skewed")
}

test "29 seconds and exactly 30 seconds of skew fire normally, 31 do not" {
  let skews = [29 * Second, 30 * Second, 31 * Second]
  let want = [1, 1, 0]
  let i = 0
  while (i < 3) {
    let store = newFakeStore()
    let clock = newFakeClock(t0)
    let locker = newFakeLocker()
    let q = skewedQueue(store, clock, locker)
    locker.offset = 0 - skews[i]
    clock.advance(30 * Second)
    runDue(q, clock.nowNs())
    assert(
      dueCount(store) == want[i],
      "skew ${skews[i]}: want ${want[i]} enqueues, got ${dueCount(store)}",
    )
    i = i + 1
  }
}

test "a failed database clock read fires nothing and is retried on the next pass" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = skewedQueue(store, clock, locker)
  locker.serverFails = true
  clock.advance(30 * Second)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "an unchecked clock fired ${dueCount(store)}")
  locker.serverFails = false
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "the retry on the same instant fires, got ${dueCount(store)}")
}

test "a failed read at a recheck does not lift an earlier block" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = skewedQueue(store, clock, locker)
  locker.offset = 0 - fourYears
  runDue(q, clock.nowNs())
  clock.advance(Minute)
  locker.serverFails = true
  runDue(q, clock.nowNs())
  assert(q.skewed, "the block stands while the clock cannot be read")
  assert(dueCount(store) == 0, "nothing fires, got ${dueCount(store)}")
}

test "with no locker there is no second clock and ticks fire" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.RunOnce)
  clock.advance(30 * Second)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "want 1 enqueue, got ${dueCount(store)}")
  assert(!q.skewKnown, "no check is ever made without a locker")
}
