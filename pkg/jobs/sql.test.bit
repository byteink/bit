// pkg/jobs/sql.test.bit — `SqlStore` and `SqlLocker` (sql.bit, sqllocker.bit,
// #7320) against a fake server: no database is needed to prove which dialect
// is picked, that a MySQL older than 8.0.1 is refused at construction, and
// exactly which statements each engine's claim and lease send. The same
// behaviour against live PostgreSQL and MySQL is `_tests_/bit/jobslive.bit`'s
// job (`./make test-package-jobs-live`).
//
// `fakeServer` answers `SELECT version()` with a configurable string and logs
// every other statement, transactions included, in the order it arrived, so a
// test reads the statements a claim sent instead of trusting the code that
// wrote them.

import { Pool, Rows, Value, Conn, Stmt, Tx, TxOptions, Datasource, isolationName, pool } from "std/sql"
import { Mutex } from "std/sync"
import { contains, hasPrefix, join } from "std/strings"

class fakeServer {
  mu: Mutex
  version: string
  // What the lease holder query and the claim query answer with.
  holder: string
  hasJob: bool
  log: []string

  connect(cfg: Datasource): Conn! {
    return fakeConn{ s = this }
  }

  record(entry: string) {
    this.mu.lock()
    this.log = append(this.log, entry)
    this.mu.unlock()
  }

  statements(): []string {
    this.mu.lock()
    defer this.mu.unlock()
    return this.log
  }

  // The rows `sqlText` answers with: the version, a claimed job, a lease
  // holder, or nothing.
  rowsFor(sqlText: string): fakeRows {
    if (sqlText == "SELECT version()") {
      return fakeRows{ cells = [Value.Text(this.version)], pos = -1 }
    }
    if (contains(sqlText, "SKIP LOCKED") && this.hasJob) {
      return fakeRows{ cells = jobCells(), pos = -1 }
    }
    if (hasPrefix(sqlText, "SELECT holder")) {
      return fakeRows{ cells = [Value.Text(this.holder)], pos = -1 }
    }
    return fakeRows{ cells = []Value(0), pos = -1 }
  }
}

// One claimed job as the claim query returns it: id 7, "j", "{}", attempts 1 or
// 0 (PostgreSQL's `RETURNING` already counts the claim; MySQL's SELECT does
// not), max_attempts 5.
fn jobCells(): []Value {
  return [Value.Int(7), Value.Text("j"), Value.Text("{}"), Value.Int(0), Value.Int(5)]
}

class fakeRows {
  cells: []Value
  pos: int

  next(): bool! {
    this.pos = this.pos + 1
    return len(this.cells) > 0 && this.pos < 1
  }

  columns(): []string {
    return []string(0)
  }

  value(col: int): Value {
    if (col < len(this.cells)) {
      return this.cells[col]
    }
    return Value.Null
  }

  close() {}
}

class fakeConn {
  s: fakeServer

  query(sqlText: string, params: []Value): Rows! {
    this.s.record(sqlText)
    return this.s.rowsFor(sqlText)
  }

  exec(sqlText: string, params: []Value): int! {
    this.s.record(sqlText)
    return 1
  }

  prepare(sqlText: string): Stmt! {
    fail newError("fakeServer: prepare is not used")
  }

  begin(opts: TxOptions): Tx! {
    let name = isolationName(opts.isolation)
    if (name == "") {
      this.s.record("BEGIN")
    } else {
      this.s.record("BEGIN ISOLATION LEVEL ${name}")
    }
    return fakeTx{ s = this.s }
  }

  close() {}
}

class fakeTx {
  s: fakeServer

  query(sqlText: string, params: []Value): Rows! {
    this.s.record(sqlText)
    return this.s.rowsFor(sqlText)
  }

  exec(sqlText: string, params: []Value): int! {
    this.s.record(sqlText)
    return 1
  }

  commit(): ()! {
    this.s.record("COMMIT")
  }

  rollback(): ()! {
    this.s.record("ROLLBACK")
  }
}

fn serverReporting(version: string): fakeServer {
  return fakeServer{
    mu = Mutex(),
    version = version,
    holder = "",
    hasJob = false,
    log = []string(0),
  }
}

fn poolOn(s: fakeServer): Pool {
  return pool(s, Datasource{ uri = "fake://jobs" }) catch e {
    panic("pool: ${e.message()}")
  }
}

// The message `dialectOfVersion` fails with, or "" when it accepts.
fn versionError(version: string): string {
  dialectOfVersion(version) catch e {
    return e.message()
  }
  return ""
}

fn dialectName(version: string): string {
  let d = dialectOfVersion(version) catch _ {
    return "refused"
  }
  match (d) {
    Postgres => return "postgres"
    MySql => return "mysql"
  }
}

test "dialectOfVersion names PostgreSQL and every MySQL from 8.0.1" {
  let accepted = [
    ["PostgreSQL 18.6 (Debian 18.6-1.pgdg13+1) on aarch64-unknown-linux-gnu", "postgres"],
    ["PostgreSQL 9.5.0", "postgres"],
    ["8.0.1", "mysql"],
    ["8.0.36-0ubuntu0.22.04.1", "mysql"],
    ["8.4.0", "mysql"],
    ["9.1.0", "mysql"],
    ["10.0.0", "mysql"],
  ]
  for pair of accepted {
    assert(
      dialectName(pair[0]) == pair[1],
      "${pair[0]} -> ${dialectName(pair[0])}, want ${pair[1]}",
    )
  }
}

test "dialectOfVersion refuses MySQL before 8.0.1, naming the version" {
  for v of ["5.7.44", "5.7.44-log", "8.0.0", "5.6.51", "7.9.9"] {
    assert(
        versionError(v) ==
        "jobs: MySQL ${v} is too old for SqlStore: claiming jobs needs SELECT ... FOR UPDATE SKIP LOCKED, which MySQL has had since 8.0.1",
      "${v}: ${versionError(v)}",
    )
  }
}

test "dialectOfVersion refuses MariaDB and what it cannot read" {
  assert(
    contains(versionError("10.11.2-MariaDB-1:10.11.2+maria~ubu2204"), "does not support MariaDB"),
    "MariaDB: ${versionError("10.11.2-MariaDB-1:10.11.2+maria~ubu2204")}",
  )
  for v of ["", "garbage", "8.0", "8", "x.y.z"] {
    assert(
        versionError(v) ==
        "jobs: SqlStore supports PostgreSQL and MySQL 8.0.1 or newer; the server reported '${v}'",
      "'${v}': ${versionError(v)}",
    )
  }
}

// The error constructing `SqlStore` over `s` fails with, or "".
fn storeError(s: fakeServer): string {
  SqlStore(poolOn(s)) catch e {
    return e.message()
  }
  return ""
}

fn lockerError(s: fakeServer): string {
  SqlLocker(poolOn(s)) catch e {
    return e.message()
  }
  return ""
}

test "SqlStore and SqlLocker refuse a MySQL 5.7 server at construction" {
  let want = "jobs: MySQL 5.7.44 is too old for SqlStore: claiming jobs needs SELECT ... FOR UPDATE SKIP LOCKED, which MySQL has had since 8.0.1"
  assert(
    storeError(serverReporting("5.7.44")) == want,
    "store: ${storeError(serverReporting("5.7.44"))}",
  )
  assert(
    lockerError(serverReporting("5.7.44")) == want,
    "locker: ${lockerError(serverReporting("5.7.44"))}",
  )
  assert(storeError(serverReporting("8.4.0")) == "", "8.4.0 must construct")
  assert(lockerError(serverReporting("PostgreSQL 18.6")) == "", "PostgreSQL must construct")
}

fn newStore(s: fakeServer): SqlStore {
  return SqlStore(poolOn(s)) catch e {
    panic("SqlStore: ${e.message()}")
  }
}

fn claimed(store: SqlStore): ClaimedJob {
  let got = store.claim(1000) catch e {
    panic("claim: ${e.message()}")
  }
  match (got) {
    None => panic("claim returned nothing")
    Some(job) => return job
  }
}

test "PostgreSQL claim is one UPDATE ... RETURNING over SKIP LOCKED, no transaction" {
  let s = serverReporting("PostgreSQL 18.6")
  s.hasJob = true
  let store = newStore(s)
  let job = claimed(store)
  assert(job.id == 7 && job.name == "j" && job.maxAttempts == 5, "job: ${job.id} ${job.name}")
  let log = s.statements()
  assert(len(log) == 2, "version + one claim statement, got ${len(log)}: ${join(log, " | ")}")
  assert(hasPrefix(log[1], "UPDATE bit_jobs SET attempts = attempts + 1"), "claim: ${log[1]}")
  assert(contains(log[1], "FOR UPDATE SKIP LOCKED) RETURNING"), "claim: ${log[1]}")
}

test "MySQL claim is one transaction: SELECT ... FOR UPDATE SKIP LOCKED, then UPDATE by id" {
  let s = serverReporting("8.4.0")
  s.hasJob = true
  let store = newStore(s)
  let job = claimed(store)
  assert(job.attempts == 1, "attempts must count this claim, got ${job.attempts}")
  let log = s.statements()
  assert(
    len(log) == 5,
    "version, BEGIN ISOLATION LEVEL, SELECT, UPDATE, COMMIT; got ${len(log)}: ${join(log, " | ")}",
  )
  assert(log[1] == "BEGIN ISOLATION LEVEL READ COMMITTED", "log[1]: ${log[1]}")
  assert(
    contains(log[2], "ORDER BY available_at LIMIT 1 FOR UPDATE SKIP LOCKED"),
    "log[2]: ${log[2]}",
  )
  assert(
    hasPrefix(log[3], "UPDATE bit_jobs SET attempts = $1, claimed_until = $2 WHERE id = $3"),
    "log[3]: ${log[3]}",
  )
  assert(log[4] == "COMMIT", "log[4]: ${log[4]}")
}

test "an empty queue claims nothing on either engine and updates nothing" {
  for v of ["PostgreSQL 18.6", "8.4.0"] {
    let s = serverReporting(v)
    let store = newStore(s)
    let got = store.claim(1000) catch e {
      panic("claim: ${e.message()}")
    }
    match (got) {
      None => {}
      Some(_) => panic("${v}: a job from an empty queue")
    }
    for stmt of s.statements() {
      assert(
        !hasPrefix(stmt, "UPDATE bit_jobs SET attempts = $1"),
        "${v}: updated a job that was not there",
      )
    }
  }
}

test "migrationStatements speaks each dialect" {
  let pg = migrationStatements(Dialect.Postgres)
  let my = migrationStatements(Dialect.MySql)
  assert(contains(pg[0], "BIGSERIAL") && !contains(pg[0], "AUTO_INCREMENT"), "pg: ${pg[0]}")
  assert(
    contains(my[0], "BIGINT NOT NULL AUTO_INCREMENT") && !contains(my[0], "BIGSERIAL"),
    "mysql: ${my[0]}",
  )
  assert(contains(my[1], "utf8mb4_bin"), "case-sensitive lease keys: ${my[1]}")
  for stmt of my {
    assert(!contains(stmt, "WHERE NOT done"), "MySQL has no partial index: ${stmt}")
    assert(hasPrefix(stmt, "CREATE TABLE IF NOT EXISTS"), "re-runnable: ${stmt}")
  }
}

test "migrate runs the DDL of the dialect the server reported" {
  let s = serverReporting("8.4.0")
  migrate(poolOn(s)) catch e {
    panic("migrate: ${e.message()}")
  }
  let log = s.statements()
  assert(len(log) == 3, "version + two tables, got ${len(log)}")
  assert(contains(log[1], "AUTO_INCREMENT"), "log[1]: ${log[1]}")
  let old = serverReporting("5.7.44")
  let refused = false
  migrate(poolOn(old)) catch _ {
    refused = true
  }
  assert(refused, "migrate against 5.7 must fail")
  assert(
    len(old.statements()) == 1,
    "nothing but the version probe may run, got ${join(old.statements(), " | ")}",
  )
}

fn newLocker(s: fakeServer): SqlLocker {
  return SqlLocker(poolOn(s)) catch e {
    panic("SqlLocker: ${e.message()}")
  }
}

test "MySQL lease: delete ours-or-expired, insert, read the holder, win iff it is us" {
  let s = serverReporting("8.4.0")
  s.holder = "me"
  let locker = newLocker(s)
  let won = locker.tryAcquire("sched@100", "me", 50, 150) catch e {
    panic("tryAcquire: ${e.message()}")
  }
  assert(won, "the holder is us")
  let log = s.statements()
  assert(
    log[1] == "BEGIN ISOLATION LEVEL READ COMMITTED",
    "log: ${join(log, " | ")}",
  )
  assert(
    hasPrefix(
      log[2],
      "DELETE FROM bit_schedule_leases WHERE lease_key = $1 AND (holder = $2 OR expires_at <= $3)",
    ),
    "log[2]: ${log[2]}",
  )
  assert(
      hasPrefix(log[3], "INSERT INTO bit_schedule_leases") &&
      contains(log[3], "ON DUPLICATE KEY UPDATE"),
    "log[3]: ${log[3]}",
  )
  assert(hasPrefix(log[4], "SELECT holder FROM bit_schedule_leases"), "log[4]: ${log[4]}")
  assert(log[5] == "COMMIT", "log[5]: ${log[5]}")
  assert(
    hasPrefix(log[6], "DELETE FROM bit_schedule_leases WHERE LEFT(lease_key"),
    "a win prunes: ${log[6]}",
  )
  s.holder = "someone-else"
  let lost = locker.tryAcquire("sched@101", "me", 50, 150) catch e {
    panic("tryAcquire: ${e.message()}")
  }
  assert(!lost, "another holder's live row is not ours")
  assert(
    len(s.statements()) == 7 + 5,
    "a lost lease prunes nothing: ${join(s.statements(), " | ")}",
  )
}

test "PostgreSQL lease is the single INSERT ... ON CONFLICT statement" {
  let s = serverReporting("PostgreSQL 18.6")
  let locker = newLocker(s)
  locker.tryAcquire("sched@100", "me", 50, 150) catch e {
    panic("tryAcquire: ${e.message()}")
  }
  let log = s.statements()
  assert(
      hasPrefix(log[1], "INSERT INTO bit_schedule_leases") &&
      contains(log[1], "ON CONFLICT (lease_key) DO UPDATE"),
    "log[1]: ${log[1]}",
  )
  assert(!contains(log[1], "BEGIN"), "no transaction")
}

test "the store and the locker satisfy Store and Locker" {
  let s = serverReporting("8.4.0")
  let store: Store = newStore(s)
  let locker: Locker = newLocker(s)
  assert(locker.window() == 1024, "default window: ${locker.window()}")
  let _ = store
}
