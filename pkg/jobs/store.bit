// pkg/jobs/store.bit — the queue backend contract (epic #4023, #6082).
//
// NO DEFAULT STORE, the same call already made for pkg/web's SessionStore
// and RateLimitStore (pkg/web/session.bit's header): an in-memory queue
// silently drops every pending job on deploy and behaves differently on one
// instance than on three. `Store` is a structural `interface`, not a
// `trait` — a trait is never a type (SPEC §10.7) and cannot be a field's
// type, and an interface's zero value is `nil`, so `Options.store` needs no
// default to compile.
//
// A job's payload crosses this boundary as JSON TEXT
// (`jsonEncode(job.toJson())`, done by `Queue.enqueue` in jobs.bit before it
// ever reaches a `Store`): a `Store` implementation never needs to know a
// job's Bit type, only its `@job` name (dispatch.bit) and an opaque string.
//
// ONE QUERY HANDLES BOTH "ready" AND "abandoned" JOBS. `claim` is the only
// read path: it must atomically take a row that is either newly available
// (`availableAt <= now`, never claimed) OR a stale claim left behind by a
// worker that crashed mid-job (its visibility window elapsed with no
// `complete`/`retry`/`deadLetter` call). A second `reclaimExpired` method
// would just be the same `WHERE` clause run twice on two schedules, racing
// the same rows — `sql.bit`'s `SELECT ... FOR UPDATE SKIP LOCKED`
// covers both cases in the one statement.

// One row a Store hands back to a claiming worker. `attempts` already
// counts this claim (a Store increments it as part of `claim`, not
// `Queue`), so `Queue.processOne` compares it against `maxAttempts`
// directly to decide retry vs. dead-letter.
export class ClaimedJob {
  export id: int,
  export name: string,
  export payload: string,
  export attempts: int,
  export maxAttempts: int,
}

// A queue backend. Every method is fallible — it is I/O.
export interface Store {
  // Persists a new job: `name` is the `@job` dispatch name, `payload` is
  // already-encoded JSON, `availableAt` is a wall-clock nanosecond
  // timestamp (`std/time.now().ns`) before which `claim` must not return
  // it, and `maxAttempts` is the ceiling `processOne` compares attempts
  // against.
  enqueue(name: string, payload: string, availableAt: int, maxAttempts: int): ()!,
  // Atomically takes ownership of at most one claimable row (see this
  // file's header) for `visibilityTimeout` nanoseconds, incrementing its
  // attempt count, or returns `None` when nothing is claimable.
  claim(visibilityTimeout: int): Option<ClaimedJob>!,
  // The job succeeded; remove it (or mark it done — the store's choice, the
  // caller never reads it again either way).
  complete(id: int): ()!,
  // The job failed and has attempts remaining: release the claim and make
  // it claimable again no earlier than `availableAt`.
  retry(id: int, availableAt: int): ()!,
  // The job exhausted its attempts, or no handler is registered for its
  // name: move it to the dead-letter list, recording `reason`.
  deadLetter(id: int, reason: string): ()!,
}
