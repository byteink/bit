// pkg/jobs/redis.test.bit — the pure parts of `RedisStore` and `RedisLocker`
// (redis.bit, redislocker.bit, #7321): the prefix rule, the server version
// check and the lease-key split, none of which needs a server. The behaviour
// of the scripts against a live Redis is `_tests_/bit/jobslive.bit`'s job
// (`./make test-package-jobs-live`), where the shared Store and Locker
// conformance suites run on it.

import { contains } from "std/strings"

test "a key prefix needs a hash tag with something inside it" {
  requireHashTag("{jobs}") catch e {
    panic("the default prefix was refused: ${e.message()}")
  }
  requireHashTag("app:{jobs}:q") catch e {
    panic("a tag in the middle was refused: ${e.message()}")
  }
  assert(defaultPrefix == "{jobs}", "default prefix = ${defaultPrefix}")
  for bad of ["jobs", "{}", "{jobs", "jobs}", "}{", ""] {
    let refused = ""
    requireHashTag(bad) catch e {
      refused = e.message()
    }
    assert(
      contains(refused, "hash tag"),
      "prefix '${bad}' was accepted, or refused without the reason: '${refused}'",
    )
  }
}

test "the Redis version is read off INFO server" {
  let info = "# Server\r\nredis_version:7.2.4\r\nredis_mode:standalone\r\n"
  assert(redisVersion(info) == "7.2.4", "version = ${redisVersion(info)}")
  assert(redisMajor(redisVersion(info)) == 7, "major = ${redisMajor("7.2.4")}")
  assert(redisMajor("8.10.2") == 8, "major of 8.10.2")
  assert(redisMajor("6.2.14") == 6, "major of 6.2.14")
  assert(
    redisMajor(redisVersion("# Server\nredis_version:7.0.0\n")) == 7,
    "a bare newline ends the line too",
  )
  assert(redisVersion("no version here") == "", "a missing line reads as empty")
  assert(redisMajor("") == 0 && redisMajor("garbage") == 0, "no number reads as 0")
}

test "a lease key splits into its schedule and a 19 digit tick at most" {
  let (s, t) = splitLeaseKey("report@1700000000000000000")
  assert(s == "report" && t == "1700000000000000000", "got ${s} ${t}")
  let (s2, t2) = splitLeaseKey("a@b@100")
  assert(s2 == "a@b" && t2 == "100", "the LAST @ splits: ${s2} ${t2}")
  for key of ["plain", "x@", "x@12a", "x@-5", "x@12345678901234567890"] {
    let (sched, tick) = splitLeaseKey(key)
    assert(sched == key && tick == "", "${key} is not a tick key, got ${sched} ${tick}")
  }
}

// Compile-time proof that the two classes satisfy the interfaces `open` takes:
// the structural check (SPEC §10.7) fails the build when a method drifts.
fn asStore(s: RedisStore): Store {
  return s
}

fn asLocker(l: RedisLocker): Locker {
  return l
}
