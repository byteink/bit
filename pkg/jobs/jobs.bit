// pkg/jobs/jobs.bit — register<T>/enqueue<T>, the worker pool, retries with
// backoff and dead-letter (epic #4023's 2026-09-27 OWNER DECISION, #6082).
//
// DISPATCH GOES THROUGH THE CLASS, NEVER A TYPED STRING. A job class
// carries `@job("name")` (compiler/classjobdesc.bit, #6081), which
// synthesizes a `static __jobName(): string` and requires `@json` — so
// every `@job` class already satisfies `Job` below (both members) with no
// declaration anywhere. `register<T: Job>`/`enqueue<T: Job>` read the name
// off `T` — `T.__jobName()` (SPEC's static-method-through-a-type-parameter
// shape, §10.4.1) — with no compiler-generated cross-module table and no
// reflection: the dispatch table below is built entirely at RUNTIME, one
// entry per `register` call, closing over the concrete `T` it was called
// with.
//
// `Job` REQUIRES `toJson(): Json` IN ADDITION TO `__jobName()`, beyond what
// the compiler's own synthesis comment names, because `enqueue` has to turn
// a `T` value into the JSON text a `Store` persists and there is no
// generic, reflection-free `encode<T>(v: T): string` — the decode side
// (`register` below) reaches `jsonDecode<T>` (composable from a generic,
// #4563) via `jsonParse`, but nothing symmetric exists for encoding, so
// `enqueue` goes through the instance method directly. `@job` already
// requires `@json`, which synthesizes exactly this `toJson()`, so every
// real job class satisfies the wider bound for free.

import { Json, jsonEncode, jsonParse, jsonDecode } from "std/json"
import { now, sleep, zone, Millisecond } from "std/time"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { WaitGroup, AtomicI64 } from "std/sync"
import { runRecovering } from "std/runtime"

// A background job class: `@job("name") @json class Foo { ... }` satisfies
// this structurally, with no `implements` declaration (SPEC §14.3).
//
// `bit fmt` MUST NOT BE RUN ON THIS DECLARATION until #6173 lands: it
// silently strips `static` from an interface method requirement (confirmed
// minimal repro, filed 2026-09-28), which would turn this into an ordinary
// instance-method requirement and break every `register`/`enqueue` call
// site with a confusing E0051 ("does not satisfy the bound 'Job'").
export interface Job {
  static __jobName(): string,
  toJson(): Json,
}

// What a handler fails with when running it again cannot help: a refused
// request, a payload that is wrong for good. The worker dead-letters the job
// at once with `reason`, however many attempts it has left, instead of
// retrying it with backoff. Any other failure is retried until `maxAttempts`.
//
//   fail PermanentFailure{ reason = "the provider refused the address" }
export class PermanentFailure {
  export reason: string

  export message(): string {
    return this.reason
  }
}

// How many workers to run and how they poll. `store` is passed to `open`
// separately, not a field here, so `Options{...}` composite literals never
// need to repeat it.
export class Options {
  export workers: int = 4,
  export pollInterval: int = 500 * Millisecond,
  export visibilityTimeout: int = 30 * Second,
  // Leader election for `schedule`/`every` across several instances (a
  // `SqlLocker`). nil means "always leader": correct for ONE instance,
  // and every instance would enqueue every tick if more than one ran with it.
  export locker: Locker,
  // Names this instance in the lease table; empty picks a random one.
  export instanceId: string = "",
  // The scheduler's time source; nil is the wall clock. Tests inject one.
  export clock: Clock,
}

fn requireOptions(opts: Options): Options! {
  if (opts.workers <= 0) {
    fail newError("jobs: Options.workers must be positive, got ${opts.workers}")
  }
  // A zero poll interval would busy-spin every worker and the scheduler, and a
  // zero visibility timeout would hand a running job to a second worker.
  if (opts.pollInterval <= 0) {
    fail newError("jobs: Options.pollInterval must be positive, got ${opts.pollInterval}")
  }
  if (opts.visibilityTimeout <= 0) {
    fail newError("jobs: Options.visibilityTimeout must be positive, got ${opts.visibilityTimeout}")
  }
  return requireLockerWindow(opts)?
}

// A locker that keeps no lease rows forgets every tick it wins, so a second
// instance would fire it again; `window() < 1` is that, reported at `open`.
fn requireLockerWindow(opts: Options): Options! {
  if (opts.locker == nil) {
    return opts
  }
  let w = opts.locker.window()
  if (w < 1) {
    fail newError("jobs: the locker keeps ${w} lease row(s) per schedule; it must keep at least 1 (SqlLocker(db, keep = ...))")
  }
  return opts
}

// Refuses, at registration, a schedule that would misbehave later: one added
// after `start()`/`run()` (the scheduler iterates `entries` on its own green
// thread and never sees it), a `RunAll` cap below 1 (it would skip on-time
// ticks), or a `RunAll` cap above the Locker's lease window (catching up would
// prune lease rows another instance still races for).
fn requireSchedulable(q: Queue, id: string, missed: Missed): ()! {
  if (q.running.load() == 1) {
    fail newError("jobs: schedule '${id}' registered after start(); register schedules before start() or run()")
  }
  match (missed) {
    Skip => return
    RunOnce => return
    RunAll(n) => requireRunAllCap(q, n)?
  }
}

fn requireRunAllCap(q: Queue, n: int): ()! {
  if (n < 1) {
    fail newError("jobs: Missed.RunAll cap must be at least 1, got ${n}")
  }
  if (q.locker == nil) {
    return
  }
  let w = q.locker.window()
  if (n > w) {
    fail newError("jobs: Missed.RunAll(${n}) exceeds the locker's lease window of ${w}; raise SqlLocker(db, keep = ...)")
  }
}

// One decoded-and-dispatch closure per registered job type, keyed by its
// `@job` name — the runtime dispatch table the epic's OWNER DECISION calls
// for. Building it is `register`'s whole job.
export class Queue {
  store: Store
  opts: Options
  handlers: map<string, (string) => ()!>
  running: AtomicI64
  wg: WaitGroup
  locker: Locker
  clock: Clock
  instance: string
  entries: []entry
  // Whether this instance's clock was last read as disagreeing with the
  // `Locker`'s (`checkSkew`), when it was last compared, and whether it ever
  // was. While `skewed` no scheduled tick fires; the workers run regardless.
  skewed: bool
  skewAt: int
  skewKnown: bool

  // Decodes a claimed job's JSON payload as `T` and calls `handle` with it.
  // Fails naming the job when `T`'s `@job` name already has a handler on this
  // queue: two registrations would leave one of them dead, which is a
  // configuration mistake to stop at startup, not a replacement to allow.
  export register<T: Job>(handle: (T) => ()!): ()! {
    let name = T.__jobName()
    let (_, taken) = this.handlers[name]
    if (taken) {
      fail newError("jobs: register: a handler for job '${name}' is already registered on this Queue")
    }
    // NOT `jsonDecodeText<T>`: it specializes by rewriting its own call
    // site (stdlib/json/dectext.bit), which a type PARAMETER can never be
    // written out as — E0145 names `jsonParse` + `jsonDecode<T>` as the
    // generic-composable equivalent (already tracked, #4563). The explicit
    // `dispatch` type gives the arrow literal its fallible result type — a
    // map-index assignment target does not propagate one on its own.
    let dispatch: (string) => ()! = (payload) => {
      let parsed = jsonParse(payload)?
      let job = jsonDecode<T>(parsed)?
      handle(job)?
    }
    this.handlers[name] = dispatch
  }

  // Encodes `job` and persists it through `this.store`, claimable after
  // `delay` nanoseconds, dead-lettered after `maxAttempts` failed tries.
  // `maxAttempts`'s default, 5, is a literal rather than a named const: a
  // parameter default must be a constant LITERAL (E0159), unlike a field
  // default, which may name one (SPEC §10.5).
  export enqueue<T: Job>(job: T, delay: int = 0, maxAttempts: int = 5): ()! {
    let name = T.__jobName()
    let payload = jsonEncode(job.toJson())
    let availableAt = now().ns + delay
    this.store.enqueue(name, payload, availableAt, maxAttempts)?
  }

  // Enqueues `job` on a cron schedule: `expr` is five fields (minute hour
  // day-of-month month day-of-week) read in the zone named `tz`, which is
  // resolved here, so an unknown zone or a bad expression fails now and not
  // at 02:00. `missed` is the catch-up policy after a stall; a `RunAll` cap
  // below 1 or above the locker's lease window fails here too. Fails after
  // `start()`/`run()`: register schedules before.
  export schedule<T: Job>(
    expr: string,
    job: T,
    missed: Missed = Missed.RunOnce,
    tz: string = "UTC",
  ): ()! {
    let zn = zone(tz)?
    let trig = newCronTrigger(expr, zn)?
    let id = scheduleId(T.__jobName(), expr, zn.name)
    requireSchedulable(this, id, missed)?
    let e = newEntry(id, trig, missed, tickEnqueuer<T>(this.store, job, 5), this.clock)?
    addEntry(this, e)?
  }

  // Enqueues `job` every `period` nanoseconds (`15 * Minute`). Ticks are
  // anchored to the Unix epoch, not to when this process started, so every
  // instance agrees on them.
  export every<T: Job>(period: int, job: T, missed: Missed = Missed.RunOnce): ()! {
    if (period <= 0) {
      fail newError("jobs: every: period must be positive, got ${period}")
    }
    let id = scheduleId(T.__jobName(), "every ${period}", "UTC")
    requireSchedulable(this, id, missed)?
    let trig: trigger = intervalTrigger{ periodNs = period }
    let e = newEntry(id, trig, missed, tickEnqueuer<T>(this.store, job, 5), this.clock)?
    addEntry(this, e)?
  }

  // Starts `opts.workers` worker green threads and returns immediately —
  // for in-process workers running alongside other work (a web server, for
  // example). Pair with `stop()` for a graceful drain.
  export start() {
    this.running.store(1)
    this.wg.add(i64(this.opts.workers))
    let i = 0
    while (i < this.opts.workers) {
      spawn workerLoop(this)
      i = i + 1
    }
    if (len(this.entries) > 0) {
      this.wg.add(1)
      spawn schedulerLoop(this)
    }
  }

  // Signals every worker to stop taking NEW jobs, then blocks until each
  // one finishes whatever job it already claimed — the graceful drain: a
  // worker's loop (`workerLoop` below) only rechecks `running` between
  // jobs, never mid-job.
  export stop() {
    this.running.store(0)
    this.wg.wait()
  }

  // Runs the worker pool in the foreground — the shape a standalone worker
  // process's `main()` wants: `q.run()` starts the pool and blocks until
  // some other green thread (a signal handler the application installs)
  // calls `q.stop()`.
  export run(): ()! {
    this.start()
    this.wg.wait()
  }
}

// A fresh Queue backed by store, ready for register/enqueue calls.
export fn open(store: Store, opts: Options): Queue! {
  let checked = requireOptions(opts)?
  return Queue{
    store = store,
    opts = checked,
    handlers = map<string, (string) => ()!>(),
    running = AtomicI64(0),
    wg = WaitGroup(),
    locker = checked.locker,
    clock = resolveClock(checked),
    instance = resolveInstance(checked),
    entries = []entry(0),
    skewed = false,
    skewAt = 0,
    skewKnown = false,
  }
}

fn resolveClock(opts: Options): Clock {
  if (opts.clock == nil) {
    return systemClock{}
  }
  return opts.clock
}

fn resolveInstance(opts: Options): string {
  if (opts.instanceId == "") {
    return uuidFormat(uuidV4())
  }
  return opts.instanceId
}

// One worker's whole loop: while running, claim at most one job and
// process it, or sleep `pollInterval` when the queue is empty. Runs until
// `Queue.stop` clears `running`, then reports itself done to the drain.
fn workerLoop(q: Queue) {
  let rng = newWorkerRand()
  while (q.running.load() == 1) {
    let claimed = q.store.claim(q.opts.visibilityTimeout) catch e {
      eprint("jobs: claim failed: ${e.message()}\n")
      sleep(q.opts.pollInterval)
      continue
    }
    match (claimed) {
      None => sleep(q.opts.pollInterval)
      Some(cj) => processOne(q, cj, rng)
    }
  }
  q.wg.done()
}

// Runs the job's handler behind the runtime's panic boundary (same
// mechanism pkg/web/recover.bit uses, `runRecovering`, std/runtime), so a
// handler panic counts as a failure instead of taking the worker thread
// down. Dispatches to complete/retry/deadLetter based on the outcome.
fn processOne(q: Queue, cj: ClaimedJob, rng: Rand) {
  let (handle, ok) = q.handlers[cj.name]
  if (!ok) {
    reportOutcome(
      () => q.store.deadLetter(cj.id, "no handler registered for '${cj.name}'"),
      cj.name,
    )
    return
  }
  let failed: error
  let (panicked, msg) = runRecovering(() => {
    handle(cj.payload) catch e {
      failed = e
      return
    }
  })
  if (panicked) {
    failJob(q, cj, msg, rng)
    return
  }
  if (failed != nil) {
    let (perm, permanent) = failed.(PermanentFailure)
    if (permanent) {
      reportOutcome(() => q.store.deadLetter(cj.id, perm.reason), cj.name)
      return
    }
    failJob(q, cj, failed.message(), rng)
    return
  }
  reportOutcome(() => q.store.complete(cj.id), cj.name)
}

// Retries cj if it has attempts left, otherwise dead-letters it with reason.
fn failJob(q: Queue, cj: ClaimedJob, reason: string, rng: Rand) {
  if (cj.attempts >= cj.maxAttempts) {
    reportOutcome(() => q.store.deadLetter(cj.id, reason), cj.name)
    return
  }
  let availableAt = now().ns + backoffDelay(cj.attempts, rng)
  reportOutcome(() => q.store.retry(cj.id, availableAt), cj.name)
}

// The worker loop's own acknowledgements (complete/retry/deadLetter) are
// fallible I/O calls with nothing useful to return to — a failed
// acknowledgement leaves the job claimed until its visibility timeout
// lapses and another worker reclaims it (store.bit's header), so the only
// right response here is to log loudly and move on, never to crash the
// worker thread over it. `op` is a closure, not a raw fallible value —
// `T!E` cannot be held in a variable or parameter (SPEC §18.2).
fn reportOutcome(
  op: () => ()!,
  name: string,
) {
  op() catch e {
    eprint("jobs: acknowledging '${name}' failed: ${e.message()}\n")
  }
}
