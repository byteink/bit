// pkg/jobs/cron.bit — a 5-field cron expression parser and its `nextAfter`
// search, for `Queue.schedule` (schedule.bit, #6083, epic #4023).
//
// FIELD ORDER, standard cron: minute(0-59) hour(0-23) day-of-month(1-31)
// month(1-12, or JAN-DEC) day-of-week(0-7, 0 and 7 both Sunday, or
// SUN-SAT). Each field is a comma-separated list of `*`, a single value, a
// range `a-b`, or a step `x/n` / `a-b/n` — the "ranges, steps, lists,
// names" the ticket asks for. `L`/`W`/`#` (last day, weekday-nearest, Nth
// weekday) are not implemented: no ticket has asked for them and they are
// easy to add as more field-item kinds later without touching this file's
// shape.
//
// EVERY FIELD IS A BITMASK, not a parsed list kept around: `int` already
// has 64 bits, every field's range fits (minute needs 60, the widest), and
// "does hour 14 match" becomes one shift-and-test instead of a linear scan
// of a slice, so `nextAfter`'s search loop below stays cheap per step.
//
// DAY-OF-MONTH AND DAY-OF-WEEK ARE "OR", NOT "AND", THE MOMENT EITHER IS
// RESTRICTED (Vixie cron's own rule, POSIX-inherited): "15 * * * 1"
// ("15 past the hour, on Mondays") means every Monday, not never (which an
// AND of "day 15" and "a Monday" would usually be). `domStar`/`dowStar`
// record whether the field's SOURCE TEXT was the literal `*` — not whether
// the resulting bitmask happens to be full, since `*/1` is textually
// restricted even though it matches every day, matching every other cron
// implementation's quirk here.
//
// NEXT-TICK SEARCH IS FIELD-CARRY, NOT MINUTE-BY-MINUTE: `nextAfter` skips
// a whole non-matching month or day in one step rather than walking every
// minute inside it, so a search across years stays a few thousand steps,
// not tens of millions — POWER OF 10's bounded-loop rule needs a bound
// that is actually reachable in a test, and `cronMaxSearchSteps` below is
// it.
//
// DAYLIGHT SAVING FOLLOWS VIXIE CRON (`man 8 cron`, "Daylight Saving Time and
// other time changes"): "Local time changes of less than three hours ... are
// handled specially. This only applies to jobs that run at a specific time
// and jobs that are run with a granularity greater than one hour. Jobs that
// run more frequently are scheduled normally. If time has moved forward,
// those jobs that would have run in the interval that has been skipped will
// be run immediately. Conversely, if time has moved backward, care is taken
// to avoid running jobs twice." Vixie's source marks a job "wildcard" when
// its minute or hour field starts with `*`; this file does the same, plus a
// field whose mask covers its whole range (`0-59`). Then a tick is an
// INSTANT, never a wall reading:
//
//   - realTime (minute or hour is `*`-like): every instant whose wall
//     reading matches is a tick. A repeated hour ticks in both occurrences;
//     a skipped wall time has no tick.
//   - fixed (minute and hour both named): every matching wall time ticks
//     once. In a repeated hour that is its FIRST occurrence; wall times
//     inside a gap tick once, at the first instant after the gap.
//
// `nextAfter` therefore walks INSTANTS on days where the zone's offset
// changes (`cronWalkDay`) and stays on the cheap wall-clock field search on
// every other day. It assumes a zone changes offset at most once per
// calendar day. Stepping the wall clock alone (the `DateTime` arithmetic of
// stdlib/time/calarith.bit, which resolves a repeated wall time to its
// EARLIER offset) returned an instant 59 minutes before `after` from the
// second 01:30 of a fall-back day; `nextAfter` now fails rather than return
// an instant that is not after `after`.

import { DateTime, NaiveDateTime, Timestamp, Zone, Second } from "std/time"
import { split, trimSpace, toUpper, parseInt, hasPrefix } from "std/strings"

// The widest lookahead `nextAfter` will search before giving up — an
// expression that can never match (`0 0 31 2 *`, day 31 in February) would
// otherwise loop until the search step bound, below, kicks in first; this
// bound exists so the failure names a sane reason instead of a raw step
// count.
const cronMaxYearsAhead: int = 8

// Bounded per POWER OF 10: worst case is a handful of year-boundary
// carries plus day-level carries across a leap-year/weekday combination
// (at most a few thousand), so this bound is never reached by a real
// expression and only fires for one that can never match.
const cronMaxSearchSteps: int = 20000

// One calendar day's walk is at most this many minute steps (25 hours on a
// fall-back day, 48 across a zone that skips a whole date); reaching it means
// the zone data is not a day-long transition, so it fails instead of looping.
const cronMaxWalkSteps: int = 4000

// A parsed cron expression: one bitmask per field plus whether the
// day-of-month/day-of-week fields were literally `*` in the source text
// (this file's header: that decides AND vs. OR between them), and whether
// the minute or hour field is `*`-like (`realTime`, the header's DST rule).
export class CronSchedule {
  minutes: int
  hours: int
  dom: int
  months: int
  dow: int
  domStar: bool
  dowStar: bool
  realTime: bool

  // The first instant strictly after `after`, in `after`'s own zone, whose
  // wall reading matches this schedule, under the daylight-saving rule in
  // this file's header. Fails when nothing matches within
  // `cronMaxYearsAhead` years (an impossible expression), when the search
  // exceeds its step bound (should never happen for a possible one), or when
  // the answer would not be after `after` (a defect, never returned).
  export nextAfter(after: DateTime): DateTime! {
    let afterSec = cronFloorSecs(after.toTimestamp()?.ns)
    let cand = cronAt(after.zone(), afterSec - after.second() + 60)
    let limitYear = after.year() + cronMaxYearsAhead
    let steps = 0
    while (steps < cronMaxSearchSteps) {
      steps = steps + 1
      if (cand.year() > limitYear) {
        fail newError("cron: no matching time within ${cronMaxYearsAhead} years after ${after.year()}-${after.month()}-${after.day()}")
      }
      if ((this.months & bitAt(cand.month())) == 0) {
        cand = cand.withDay(1).addMonths(1).withTime(0, 0, 0)
        continue
      }
      if (!cronDomDowMatches(this, cand.day(), isoToCronDow(cand.dayOfWeek()))) {
        cand = cand.addDays(1).withTime(0, 0, 0)
        continue
      }
      let end = cand.addDays(1).withTime(0, 0, 0)
      let (hit, found) = cronSearchDay(this, cand, end)?
      if (found) {
        return cronEnsureAfter(hit, after)?
      }
      cand = end
    }
    fail newError("cron: search exceeded ${cronMaxSearchSteps} steps")
  }
}

// `sec` seconds since the Unix epoch, read in `z`.
fn cronAt(z: Zone, sec: int): DateTime {
  return Timestamp{ ns = sec * Second }.inZone(z)
}

// Whole seconds at or before `ns`; plain `/` truncates toward zero, which
// would round an instant before 1970 up.
fn cronFloorSecs(ns: int): int {
  let q = ns / Second
  if (q * Second > ns) {
    return q - 1
  }
  return q
}

// `dt`'s instant in whole seconds since the Unix epoch.
fn cronSecs(dt: DateTime): int! {
  let ts = dt.toTimestamp()?
  return cronFloorSecs(ts.ns)
}

// The zone offset in force one second before `dt`'s instant.
fn cronOffsetBefore(dt: DateTime): int! {
  return cronAt(dt.zone(), cronSecs(dt)? - 1).offset()
}

// The invariant `nextAfterNs` (schedule.bit) and the scheduler rely on: a
// tick is never at or before the instant it was asked to follow.
fn cronEnsureAfter(got: DateTime, after: DateTime): DateTime! {
  let g = got.toTimestamp()?
  let a = after.toTimestamp()?
  if (g.ns <= a.ns) {
    fail newError("cron: next tick ${got.toString()} is not after ${after.toString()}")
  }
  return got
}

// The first tick on the calendar day that starts at wall midnight and ends
// at `end` (the next wall midnight), at or after `cand` (a minute on that
// day); `found` is false when the day has none. `cand`'s date already
// matches. A day whose offset is the same throughout takes the wall-clock
// search; any other day is walked by instant.
fn cronSearchDay(cs: CronSchedule, cand: DateTime, end: DateTime): (DateTime, bool)! {
  let start = cand.withTime(0, 0, 0)
  if (cronOffsetBefore(start)? == cronOffsetBefore(end)?) {
    return cronFastDay(cs, cand)
  }
  return cronWalkDay(cs, cand, start, end)?
}

// The first matching hour/minute at or after `cand` on its own day, for a
// day with no offset change (every wall time then names exactly one
// instant).
fn cronFastDay(cs: CronSchedule, cand: DateTime): (DateTime, bool) {
  let h = cand.hour()
  let m0 = cand.minute()
  while (h < 24) {
    if ((cs.hours & bitAt(h)) != 0) {
      let m = cronNextBit(cs.minutes, m0)
      if (m >= 0) {
        return (cand.withTime(h, m, 0), true)
      }
    }
    h = h + 1
    m0 = 0
  }
  return (cand, false)
}

// The lowest set bit of `mask` in `[from, 59]`, or -1.
fn cronNextBit(mask: int, from: int): int {
  let v = from
  while (v <= 59) {
    if ((mask & bitAt(v)) != 0) {
      return v
    }
    v = v + 1
  }
  return -1
}

// What `cronWalkTick` remembers between minutes: the offset one minute ago,
// and (fixed schedules) the instant a repeated stretch of wall time ends,
// before which a wall match is the SECOND occurrence and does not tick.
class cronWalk {
  prevOff: int,
  quietUntil: int,
}

// Walks the instants of one calendar day, `start` to `end` exclusive, a wall
// minute at a time, from the day's start so the walk always knows whether it
// is inside a repeated stretch; returns the first tick at or after `cand`.
fn cronWalkDay(
  cs: CronSchedule,
  cand: DateTime,
  start: DateTime,
  end: DateTime,
): (DateTime, bool)! {
  let z = cand.zone()
  let candSec = cronSecs(cand)?
  let endSec = cronSecs(end)?
  let tSec = cronSecs(start)?
  let t = start
  let w = cronWalk{ prevOff = cronOffsetBefore(start)?, quietUntil = 0 }
  let steps = 0
  while (tSec < endSec && steps < cronMaxWalkSteps) {
    steps = steps + 1
    if (cronWalkTick(cs, t, tSec, w) && tSec >= candSec) {
      return (t, true)
    }
    tSec = tSec + 60 - t.second()
    t = cronAt(z, tSec)
  }
  if (tSec < endSec) {
    fail newError("cron: a day of ${cand.zone().name} did not end within ${cronMaxWalkSteps} minutes")
  }
  return (cand, false)
}

// Whether the instant `t` (`tSec`) is a tick, updating `w` for the offset
// change it may be the first instant of.
fn cronWalkTick(cs: CronSchedule, t: DateTime, tSec: int, w: cronWalk): bool {
  let off = t.offset()
  let gapTick = false
  if (off < w.prevOff) {
    w.quietUntil = tSec + (w.prevOff - off)
  }
  if (off > w.prevOff && !cs.realTime) {
    gapTick = cronGapMatches(cs, t.naive(), (off - w.prevOff) / 60)
  }
  w.prevOff = off
  if (gapTick) {
    return true
  }
  if (!cs.realTime && tSec < w.quietUntil) {
    return false
  }
  return cronWallMatches(cs, t.naive())
}

// Whether any of the `gapMinutes` wall minutes just before `first` (the
// first wall reading after a gap) matches: those wall times do not exist, and
// a fixed job owed one runs at `first`'s instant.
fn cronGapMatches(cs: CronSchedule, first: NaiveDateTime, gapMinutes: int): bool {
  let k = 1
  while (k <= gapMinutes) {
    if (cronWallMatches(cs, first.addMinutes(-k))) {
      return true
    }
    k = k + 1
  }
  return false
}

// Whether the wall reading `n` satisfies all five fields.
fn cronWallMatches(cs: CronSchedule, n: NaiveDateTime): bool {
  if ((cs.months & bitAt(n.month())) == 0) {
    return false
  }
  if (!cronDomDowMatches(cs, n.day(), isoToCronDow(n.dayOfWeek()))) {
    return false
  }
  return (cs.hours & bitAt(n.hour())) != 0 && (cs.minutes & bitAt(n.minute())) != 0
}

// Whether day `dom`/`dow` (cron's own 0=Sunday..6=Saturday numbering for
// `dow`) satisfies the day-of-month and day-of-week fields together, per
// this file's header (OR once either is textually restricted).
fn cronDomDowMatches(cs: CronSchedule, dom: int, dow: int): bool {
  if (cs.domStar && cs.dowStar) {
    return true
  }
  let domOk = (cs.dom & bitAt(dom)) != 0
  let dowOk = (cs.dow & bitAt(dow)) != 0
  if (cs.domStar) {
    return dowOk
  }
  if (cs.dowStar) {
    return domOk
  }
  return domOk || dowOk
}

// `DateTime.dayOfWeek()` is ISO 8601, 1=Monday..7=Sunday
// (stdlib/time/zoned.bit). Cron's day-of-week field is 0=Sunday..6=Saturday
// (with 7 also accepted for Sunday, folded in by `parseCron` below) — `% 7`
// maps ISO 7 (Sunday) to cron 0 and leaves 1..6 (Monday..Saturday) alone.
fn isoToCronDow(iso: int): int {
  return iso % 7
}

fn bitAt(v: int): int {
  return 1 << v
}

// Parses a standard 5-field cron expression. Fields are separated by any
// run of spaces; each field is `*`, `*/step`, a comma-separated list of
// values/ranges, optionally stepped (`a-b/step`). The month field also
// accepts `JAN`..`DEC` and the day-of-week field `SUN`..`SAT`, case
// insensitive.
export fn parseCron(expr: string): CronSchedule! {
  let fields = cronSplitFields(expr)
  if (len(fields) != 5) {
    fail newError("cron: expected 5 fields (minute hour day-of-month month day-of-week), got ${len(fields)} in '${expr}'")
  }
  let noNames = map<string, int>()
  let minutes = cronParseField(fields[0], 0, 59, noNames)?
  let hours = cronParseField(fields[1], 0, 23, noNames)?
  let dom = cronParseField(fields[2], 1, 31, noNames)?
  let months = cronParseField(fields[3], 1, 12, cronMonthNames())?
  let dow = cronFoldSundaySeven(cronParseField(fields[4], 0, 7, cronDowNames())?)
  return CronSchedule{
    minutes = minutes,
    hours = hours,
    dom = dom,
    months = months,
    dow = dow,
    domStar = fields[2] == "*",
    dowStar = fields[4] == "*",
    realTime = cronCoversField(fields[0], minutes, 60) || cronCoversField(fields[1], hours, 24),
  }
}

// Whether a minute or hour field fires at every value of its `width`-value
// range, or at a `*` step of it: Vixie cron's "wildcard" (this file's header).
fn cronCoversField(text: string, mask: int, width: int): bool {
  return hasPrefix(text, "*") || mask == bitAt(width) - 1
}

// Splits on runs of whitespace, dropping empty pieces — `strings.split`
// alone would keep an empty piece between two adjacent spaces.
fn cronSplitFields(expr: string): []string {
  let out: []string = []string(0)
  for raw of split(trimSpace(expr), " ") {
    let f = trimSpace(raw)
    if (len(f) > 0) {
      out = append(out, f)
    }
  }
  return out
}

// A comma-separated field into its combined bitmask.
fn cronParseField(field: string, min: int, max: int, names: map<string, int>): int! {
  let mask = 0
  for item of split(field, ",") {
    mask = mask | cronParseItem(item, min, max, names)?
  }
  return mask
}

// One list item: `*`, `*/step`, `a`, `a/step`, `a-b`, or `a-b/step`.
fn cronParseItem(item: string, min: int, max: int, names: map<string, int>): int! {
  let stepped = split(item, "/")
  if (len(stepped) > 2) {
    fail newError("cron: malformed field item '${item}'")
  }
  let step = 1
  if (len(stepped) == 2) {
    step = parseInt(stepped[1]) catch _ {
      fail newError("cron: invalid step in '${item}'")
    }
    if (step <= 0) {
      fail newError("cron: step must be positive in '${item}'")
    }
  }
  let base = stepped[0]
  if (base == "*") {
    return cronRangeMask(min, max, step)
  }
  let range = split(base, "-")
  if (len(range) == 1) {
    let v = cronParseValue(range[0], min, max, names)?
    if (step > 1) {
      return cronRangeMask(v, max, step)
    }
    return bitAt(v)
  }
  if (len(range) != 2) {
    fail newError("cron: malformed range '${base}'")
  }
  let lo = cronParseValue(range[0], min, max, names)?
  let hi = cronParseValue(range[1], min, max, names)?
  if (lo > hi) {
    fail newError("cron: range start after end in '${base}'")
  }
  return cronRangeMask(lo, hi, step)
}

// `lo, lo+step, lo+2*step, ...` up to `hi` inclusive. Bounded: `v` strictly
// increases by at least 1 each pass and `hi` is at most 59 (the widest
// field), so this never loops more than 60 times.
fn cronRangeMask(lo: int, hi: int, step: int): int {
  let mask = 0
  let v = lo
  while (v <= hi) {
    mask = mask | bitAt(v)
    v = v + step
  }
  return mask
}

// A single field value: a name (month/day-of-week fields only) or a plain
// integer, range-checked against `[min, max]`.
fn cronParseValue(tok: string, min: int, max: int, names: map<string, int>): int! {
  let (named, ok) = names[toUpper(tok)]
  if (ok) {
    return named
  }
  let v = parseInt(tok) catch _ {
    fail newError("cron: invalid value '${tok}'")
  }
  if (v < min || v > max) {
    fail newError("cron: value ${v} out of range [${min},${max}] in '${tok}'")
  }
  return v
}

// Bit 7 (the alternate spelling of Sunday) folded into bit 0, then masked
// to bits 0..6 — the day-of-week field's actual usable range once folded.
fn cronFoldSundaySeven(mask: int): int {
  let folded = mask
  if ((folded & bitAt(7)) != 0) {
    folded = folded | bitAt(0)
  }
  return folded & (bitAt(7) - 1)
}

fn cronMonthNames(): map<string, int> {
  let m = map<string, int>()
  m["JAN"] = 1
  m["FEB"] = 2
  m["MAR"] = 3
  m["APR"] = 4
  m["MAY"] = 5
  m["JUN"] = 6
  m["JUL"] = 7
  m["AUG"] = 8
  m["SEP"] = 9
  m["OCT"] = 10
  m["NOV"] = 11
  m["DEC"] = 12
  return m
}

fn cronDowNames(): map<string, int> {
  let m = map<string, int>()
  m["SUN"] = 0
  m["MON"] = 1
  m["TUE"] = 2
  m["WED"] = 3
  m["THU"] = 4
  m["FRI"] = 5
  m["SAT"] = 6
  return m
}
