// pkg/jobs/schedule.bit — `Missed`, `Locker` (leader election over the
// store) and the pure catch-up arithmetic `Queue.schedule`/`Queue.every`
// (jobs.bit) drive (#6083, epic #4023).
//
// TWO TRIGGER KINDS, ONE INTERFACE. `schedule("0 2 * * *", ...)` and
// `every(15 * Minute, ...)` both produce a `trigger`: `cronTrigger` wraps a
// `CronSchedule` (cron.bit) and a `Zone`, `intervalTrigger` is a fixed
// nanosecond period anchored to the Unix epoch (`0`, never "when this
// process started") so every instance in a fleet computes the SAME tick
// boundaries independently — required for leader election to mean
// anything: if the leader changes mid-run, the new leader must agree with
// the old one about when the next tick falls, not restart its own clock.
//
// LEADER ELECTION IS A LEASE ROW, NOT A METHOD ON `Store`. `Locker` is its
// own interface (this file's own contract, `SqlLocker` lives in
// sqllocker.bit) rather than added to `Store`,
// the same separation pkg/web keeps between `SessionStore` and
// `RateLimitStore` — a `Store` implementation that only ever runs
// `enqueue`/`register` jobs, never `schedule`, should not have to
// implement leader election it never uses. `Options.locker` has no
// default expression (an interface's zero value is nil, store.bit's own
// header) and nil means "always leader" — correct for a single instance,
// documented as wrong for more than one.
//
// CATCH-UP IS PLANNED PURELY, NO CLOCK INVOLVED (`planCatchUp`/
// `missedEnqueueCount` below take plain nanosecond ints and a `trigger`) so a
// test drives them with fixed numbers instead of a real clock or `sleep` —
// this is the injectable-clock shape the ticket's own tests need.
//
// CATCH-UP WORK IS BOUNDED BY THE POLICY, NEVER BY THE DISTANCE BEHIND
// (#6361). A device that boots at 1970 and gets NTP time in 2026 is
// 1.7 billion one-second ticks behind an `every(1 * Second)` schedule. The
// plan never enumerates them: it asks the trigger for the newest tick at or
// before now (`prevAtOrBeforeNs`), and walks BACK from there, at most the
// policy's cap of ticks, stopping at the first tick not yet handled.
//
// A TICK IS MISSED ONLY WHEN IT IS REACHED TOO LATE TO BE ON TIME (#6358,
// after #6354). Tick `T`, whose next tick is `T2`, is missed iff
// `now - T > min(scheduleMissedAfter, T2 - T)`: more than a minute late, or
// late enough that the next tick is already due. Quartz's misfire threshold,
// capped by the schedule's own period. A tick that is not missed is always
// enqueued, whatever `Missed` says; only missed ones go through the policy.
// So the newest due tick is dropped by `Skip` only when it is over a minute
// late (`now < T2` always holds for it), a nightly tick whose store pass
// failed at 02:00:00 and recovered at 02:00:40 still fires, and a deploy
// that restarts the app 30 s after 02:00 still fires it, while a 02:00 run
// the app slept through until 02:30 is dropped by `Skip`. The threshold is
// deliberately not an argument of `schedule`/`every` nor an `Options`
// field: it is one rule for every schedule, not a knob to set wrong. Every
// tick the policy drops is logged (`missedMessage`), never silent.

import { Hour, Minute, Timestamp, Zone, formatDuration } from "std/time"

// How a schedule catches up after downtime: the `missed` argument of
// `Queue.schedule`/`Queue.every`. `RunAll`'s payload is the cap: enqueue at
// most this many catch-up jobs, never unbounded (constraint).
export enum Missed {
  Skip,
  RunOnce,
  RunAll(int),
}

// Leader election over a shared store: exactly one instance in a fleet may
// hold the lease named `key` at a time, so only that instance's scheduler
// loop enqueues a tick (three schedulers, one enqueue per tick). The
// scheduler names a lease per TICK, not per schedule, so a leader that
// dies mid-tick cannot leave a follower double-firing a tick the leader
// already enqueued.
export interface Locker {
  // Returns true if the caller holds the lease named `key` once this call
  // returns — whether newly acquired, renewed because the caller already
  // held it, or taken over because the previous holder's lease expired —
  // and false when another holder's lease has not expired yet. `nowNs` is
  // the caller's clock (Options.clock), so a lease is expired exactly when
  // its `expiresAt <= nowNs`; an implementation never reads a clock of its
  // own, which keeps a test's injected clock authoritative.
  tryAcquire(key: string, holder: string, nowNs: int, expiresAt: int): bool!,
  // The newest tick any instance has ever won for the schedule named
  // `key` (the scheduler's schedule id, the part of a lease key before
  // its "@<tick>"), or 0 when none has. A scheduler that starts after the
  // whole fleet was down reads it to learn which ticks it missed. An
  // implementation must keep at least the newest tick of every schedule
  // for as long as the schedule is in use, or a restart forgets it.
  lastTick(key: string): int!,
  // How many newest ticks of one schedule this locker still remembers
  // (`SqlLocker`'s `keep`). `Queue.schedule`/`every` refuse a
  // `Missed.RunAll` cap above it: catching up more ticks than the locker
  // keeps prunes lease rows another instance still races for.
  window(): int,
  // The database's own clock as nanoseconds since the Unix epoch. The
  // scheduler compares it with its `Clock` and fires nothing while the two
  // differ by more than `scheduleMaxSkew` (`checkSkew`, scheduler.bit): a
  // lease row is stamped with the CALLER's clock, so one instance with a wrong
  // one would win the leases of ticks that are years away. A failure is
  // retried and nothing fires on an unchecked clock.
  serverNowNs(): int!,
}

// A tick source: cron expression or fixed interval, both reduced to "the
// next nanosecond timestamp strictly after `afterNs`" so the scheduler
// loop (jobs.bit) never branches on which kind it has.
interface trigger {
  nextAfterNs(afterNs: int): int!,
  // The newest tick at or before `atNs`, never after it. The mirror of
  // `nextAfterNs`: `nextAfterNs(prevAtOrBeforeNs(t)) > t` and
  // `prevAtOrBeforeNs(nextAfterNs(t)) == nextAfterNs(t)`.
  prevAtOrBeforeNs(atNs: int): int!,
  // How many ticks lie in `[firstNs, lastNs]` (both ticks), when the trigger
  // knows without walking them; `false` otherwise.
  tickCountNs(firstNs: int, lastNs: int): (int, bool),
}

// Wraps a parsed cron expression and the zone its fields are read in.
class cronTrigger {
  cron: CronSchedule
  tz: Zone

  nextAfterNs(afterNs: int): int! {
    let after = Timestamp{ ns = afterNs }.inZone(this.tz)
    let next = this.cron.nextAfter(after)?
    let ts = next.toTimestamp()?
    return ts.ns
  }

  prevAtOrBeforeNs(atNs: int): int! {
    let at = Timestamp{ ns = atNs }.inZone(this.tz)
    let prev = this.cron.prevAtOrBefore(at)?
    let ts = prev.toTimestamp()?
    return ts.ns
  }

  // Cron ticks are not evenly spaced, so they are never counted in closed form.
  tickCountNs(firstNs: int, lastNs: int): (int, bool) {
    return (0, false)
  }
}

// A fixed period, epoch-anchored: the next multiple of `periodNs` strictly
// greater than `afterNs`. Never fails — a fixed period always has a next
// multiple.
class intervalTrigger {
  periodNs: int

  nextAfterNs(afterNs: int): int! {
    return (afterNs / this.periodNs + 1) * this.periodNs
  }

  // Floor division: plain `/` truncates toward zero, which would round an
  // instant before 1970 up to a tick after it.
  prevAtOrBeforeNs(atNs: int): int! {
    let q = atNs / this.periodNs
    if (q * this.periodNs > atNs) {
      q = q - 1
    }
    return q * this.periodNs
  }

  tickCountNs(firstNs: int, lastNs: int): (int, bool) {
    return ((lastNs - firstNs) / this.periodNs + 1, true)
  }
}

// Builds the `cronTrigger` for `schedule(expr, ...)` — split out of
// `Queue.schedule` (jobs.bit) so that method stays a thin wrapper.
fn newCronTrigger(expr: string, tz: Zone): trigger! {
  let cs = parseCron(expr)?
  return cronTrigger{ cron = cs, tz = tz }
}

// How late the scheduler may reach a tick and still have it on time, at
// most: a minute, the slack a failed store pass or a restart needs to
// recover. A schedule with a shorter period is capped by that period instead
// (`tickMissed`).
const scheduleMissedAfter: int = Minute

// How far a wall clock may step back before the scheduler treats it as a
// correction: Vixie cron's threshold (`man 8 cron`: "Time changes of more
// than 3 hours are considered to be corrections to the clock or the
// timezone, and the new time is used immediately"). A step back of less than
// this re-runs nothing: the schedule waits for its next tick, as cron does
// for a daylight saving change.
const scheduleClockBackStep: int = 3 * Hour

// How far an instance's clock may differ from the `Locker`'s (the database's)
// before the scheduler stops firing ticks: far above NTP-synchronised hosts
// (milliseconds) and far below the lease lifetime (`scheduleLeaseTtl`).
const scheduleMaxSkew: int = 30 * Second

// How often the scheduler re-reads `Locker.serverNowNs`: a round trip per
// pass would cost more than the check is worth, and a clock does not drift a
// minute's worth of seconds in a minute.
const scheduleSkewCheckEvery: int = Minute

// The line logged when this instance's clock is `skew` (absolute) away from
// the database's and the scheduler stops firing.
fn skewMessage(skew: int): string {
  return "jobs: this instance's clock is ${formatDuration(skew)} away from the database clock; not firing scheduled ticks until they agree\n"
}

// The line logged when the clocks agree again.
fn skewClearedMessage(): string {
  return "jobs: this instance's clock agrees with the database clock again; firing scheduled ticks\n"
}

// The line logged when `id`'s next tick `next` lies `gap` ahead of the tick
// the clock implies (the clock moved back). With `anchored` the scheduler
// moved the schedule to `anchor`; without, it waits.
fn clockBackMessage(id: string, next: int, gap: int, anchored: bool, anchor: int): string {
  let head = "jobs: schedule '${id}' next tick ${Timestamp{ ns = next }.toString()} is ${formatDuration(gap)} ahead of the clock; the clock moved back"
  if (anchored) {
    return "${head}, re-anchored at ${Timestamp{ ns = anchor }.toString()}\n"
  }
  return "${head} by less than ${formatDuration(scheduleClockBackStep)}, waiting for it\n"
}

// The line logged when the locker's newest tick `last` of `id` lies `gap`
// ahead of the clock and is ignored.
fn lastTickIgnoredMessage(id: string, last: int, gap: int): string {
  return "jobs: schedule '${id}': the locker's last tick ${Timestamp{ ns = last }.toString()} is ${formatDuration(gap)} in the future; ignoring it (an instance with a wrong clock?)\n"
}

// Whether tick `tick` is missed at `nowNs` when the tick after it is due at
// `following`: later than `scheduleMissedAfter`, or than the period when that
// is shorter (the next tick is then already due).
fn tickMissed(tick: int, following: int, nowNs: int): bool {
  let window = following - tick
  if (window > scheduleMissedAfter) {
    window = scheduleMissedAfter
  }
  return nowNs - tick > window
}

// Most ticks that can be on time at once: a tick other than the newest is on
// time only while its following tick is still not after now, and that tick is
// at most the newest, which is at most now, so it must equal now exactly.
const scheduleOnTimeMax: int = 2

// What one scheduler pass does for one schedule (`planCatchUp`).
class catchUp {
  // The ticks to enqueue, oldest first: the `kept` missed ones the policy
  // keeps, then the ones on time.
  fire: []int,
  kept: int,
  // True when the policy drops missed ticks; then `first` to `last` is the
  // window of missed ticks and `count` says how many, worded for the log.
  dropped: bool,
  first: int,
  last: int,
  count: string,
  // `next` once every due tick is handled: the tick after the newest due one,
  // or the unchanged `next` when nothing is due.
  after: int,
}

// The newest tick of `t` at or before `atNs`, failing loudly on a trigger that
// returns a later one: every walk below relies on each step going back.
fn tickAtOrBefore(t: trigger, atNs: int): int! {
  let tick = t.prevAtOrBeforeNs(atNs)?
  if (tick > atNs) {
    fail newError("jobs: trigger returned tick ${tick}, after ${atNs}")
  }
  return tick
}

// `rev` reversed, oldest first.
fn oldestFirst(rev: []int): []int {
  let out = []int(0)
  let i = len(rev) - 1
  while (i >= 0) {
    out = append(out, rev[i])
    i = i - 1
  }
  return out
}

// The ticks from `next` up to `newest` that are on time at `nowNs`, oldest
// first. `after` is the tick following `newest`. Walks back from `newest`, at
// most `scheduleOnTimeMax` steps.
fn onTimeTicks(t: trigger, next: int, newest: int, after: int, nowNs: int): []int! {
  let rev = []int(0)
  let tick = newest
  let following = after
  while (len(rev) < scheduleOnTimeMax && !tickMissed(tick, following, nowNs)) {
    rev = append(rev, tick)
    if (tick <= next) {
      break
    }
    following = tick
    tick = tickAtOrBefore(t, tick - 1)?
  }
  return oldestFirst(rev)
}

// The missed ticks `policy` keeps: the newest of those from `next` to `last`
// (both ticks), oldest first. Walks back from `last` one tick at a time while
// the policy would keep one more, so the work is the policy's cap, not the
// number of missed ticks.
fn keptMissed(t: trigger, next: int, last: int, policy: Missed): []int! {
  let rev = []int(0)
  let tick = last
  while (missedEnqueueCount(len(rev) + 1, policy) > len(rev)) {
    rev = append(rev, tick)
    if (tick <= next) {
      break
    }
    tick = tickAtOrBefore(t, tick - 1)?
  }
  return oldestFirst(rev)
}

// How many ticks lie in `first` to `last`, worded for the log: the exact
// count when `t` knows it, else "more than <k>" with `k` what the pass has
// seen to be a lower bound (the `kept` ticks it kept, at least one).
fn missedCountText(t: trigger, first: int, last: int, kept: int): string {
  if (first == last) {
    return "1"
  }
  let (n, exact) = t.tickCountNs(first, last)
  if (exact) {
    return "${n}"
  }
  if (kept < 1) {
    return "more than 1"
  }
  return "more than ${kept}"
}

// Fills the missed part of `plan`: the ticks from `plan.first` up to the one
// before `edge` (the oldest tick on time, or the tick after the newest).
fn planMissed(t: trigger, plan: catchUp, edge: int, policy: Missed): ()! {
  let last = tickAtOrBefore(t, edge - 1)?
  if (last < plan.first) {
    fail newError("jobs: ${plan.first} is not a tick of its schedule")
  }
  let kept = keptMissed(t, plan.first, last, policy)?
  plan.fire = kept
  plan.kept = len(kept)
  plan.last = last
  plan.dropped = len(kept) == 0 || kept[0] != plan.first
  if (plan.dropped) {
    plan.count = missedCountText(t, plan.first, last, len(kept))
  }
}

// What to do for a schedule whose first unhandled tick is `next`, at `nowNs`.
// Only the newest due tick can be on time (the second newest only when now is
// exactly the newest: `tickMissed`); every older one is missed. The work is
// one `prevAtOrBeforeNs` per tick walked, at most the policy's cap, whatever
// the distance between `next` and now.
fn planCatchUp(t: trigger, next: int, nowNs: int, policy: Missed): catchUp! {
  let newest = tickAtOrBefore(t, nowNs)?
  let plan = catchUp{
    fire = []int(0),
    kept = 0,
    dropped = false,
    first = next,
    last = next,
    count = "",
    after = next,
  }
  if (newest < next) {
    return plan
  }
  plan.after = t.nextAfterNs(newest)?
  let onTime = onTimeTicks(t, next, newest, plan.after, nowNs)?
  let edge = plan.after
  if (len(onTime) > 0) {
    edge = onTime[0]
  }
  if (edge > next) {
    planMissed(t, plan, edge, policy)?
  }
  for tick of onTime {
    plan.fire = append(plan.fire, tick)
  }
  return plan
}

// The `Missed.<Policy>` spelling used in the drop log.
fn missedName(policy: Missed): string {
  match (policy) {
    Skip => return "Skip"
    RunOnce => return "RunOnce"
    RunAll(runAllCap) => return "RunAll(${runAllCap})"
  }
}

// The line logged when `policy` drops missed ticks of schedule `id`: the
// window `plan.first` to `plan.last` and how many of it were enqueued.
fn missedMessage(id: string, plan: catchUp, policy: Missed): string {
  let first = Timestamp{ ns = plan.first }.toString()
  let last = Timestamp{ ns = plan.last }.toString()
  return "jobs: schedule '${id}' missed ${plan.count} tick(s) from ${first} to ${last}; Missed.${missedName(policy)} enqueued ${plan.kept}\n"
}

// How many catch-up jobs to enqueue for `missed` ticks that all came due
// at once (a scheduler restarting after downtime), per `policy` — pure,
// no I/O. `Skip` drops every missed tick. `RunOnce` collapses them into a
// single enqueue. `RunAll(cap)` enqueues one per missed tick, up to `cap`
// — the trade-off this buys: catching up exactly reproduces every tick
// that should have fired (correct against a ledger close that expects one
// row per period), at the cost of a burst of `cap` jobs at once if the
// scheduler was down a long time; `Skip`/`RunOnce` never burst, at the
// cost of a gap (`Skip`) or a merged period (`RunOnce`) in that ledger.
export fn missedEnqueueCount(missed: int, policy: Missed): int {
  if (missed <= 0) {
    return 0
  }
  match (policy) {
    Skip => return 0
    RunOnce => return 1
    RunAll(runAllCap) => {
      if (missed > runAllCap) {
        return runAllCap
      }
      return missed
    }
  }
}
