// pkg/jobs/clockback.test.bit — a wall clock that moves back, or a last tick
// written under a clock that was ahead, must not freeze a schedule with its
// `next` in the future (scheduler.bit `checkClock`/`syncEntry`, #6362). Time
// is the `fakeClock` of scheduler.test.bit, which owns the shared helpers.

import { Second, Minute, Hour, Millisecond } from "std/time"
import { contains } from "std/strings"

const fourYears: int = 1461 * 24 * Hour

test "a schedule registered under a clock that was ahead fires once the clock is corrected" {
  let store = newFakeStore()
  let clock = newFakeClock(day0 + fourYears)
  let q = queueOn(store, clock, nil, "a")
  q.every(Second, TickJob{ tag = "s" }, missed = Missed.RunOnce) catch e {
    panic("every: ${e.message()}")
  }
  clock.ns.store(i64(day0 + 500 * Millisecond))
  clock.advance(Hour)
  runDue(q, clock.nowNs())
  assert(
    q.entries[0].next == day0 + Hour + Second,
    "re-anchored at the next tick, got ${q.entries[0].next}",
  )
  clock.advance(Second)
  runDue(q, clock.nowNs())
  assert(
    dueCount(store) > 0,
    "clock corrected back 4 years: want an enqueue within the hour, got ${dueCount(store)}",
  )
}

test "the clock goes from 2026 to 1970: every 15 minutes fires at the next 1970 quarter hour" {
  let store = newFakeStore()
  let clock = newFakeClock(day0)
  let q = queueOn(store, clock, nil, "a")
  q.every(15 * Minute, TickJob{ tag = "q" }, missed = Missed.RunOnce) catch e {
    panic("every: ${e.message()}")
  }
  clock.ns.store(i64(Minute))
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "nothing is due at minute 1, got ${dueCount(store)}")
  assert(q.entries[0].next == 15 * Minute, "re-anchored at minute 15, got ${q.entries[0].next}")
  clock.advance(14 * Minute)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [15 * Minute], "the first 1970 quarter hour")
}

test "a one hour step back re-runs nothing, logs once and waits for the next tick" {
  let store = newFakeStore()
  let clock = newFakeClock(day0 + 30 * Minute)
  let q = queueOn(store, clock, nil, "a")
  q.every(Hour, TickJob{ tag = "h" }, missed = Missed.RunAll(3)) catch e {
    panic("every: ${e.message()}")
  }
  clock.advance(30 * Minute)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [day0 + Hour], "the first tick")
  clock.ns.store(i64(day0))
  let e = q.entries[0]
  let note = checkClock(e, clock.nowNs()) catch err {
    panic("checkClock: ${err.message()}")
  }
  assert(contains(note, "is 1h0m0s ahead of the clock; the clock moved back"), "got ${note}")
  assert(!contains(note, "re-anchored"), "under three hours nothing is re-anchored: ${note}")
  assert(e.next == day0 + 2 * Hour, "next is unchanged, got ${e.next}")
  let again = checkClock(e, clock.nowNs()) catch err {
    panic("checkClock: ${err.message()}")
  }
  assert(again == "", "the same step is logged once, got ${again}")
  clock.advance(Hour)
  runDue(q, clock.nowNs())
  assert(
    dueCount(store) == 1,
    "the tick that already ran must not run again, got ${dueCount(store)}",
  )
  clock.advance(Hour)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [day0 + Hour, day0 + 2 * Hour], "the next tick fires on time")
}

test "a step of three hours or more re-anchors and says so" {
  let store = newFakeStore()
  let clock = newFakeClock(day0 + 30 * Minute)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.RunOnce)
  let e = q.entries[0]
  clock.ns.store(i64(day0 - 3 * Hour + 10 * Second))
  let note = checkClock(e, clock.nowNs()) catch err {
    panic("checkClock: ${err.message()}")
  }
  assert(contains(note, "the clock moved back, re-anchored at"), "got ${note}")
  assert(e.next == day0 - 3 * Hour + Minute, "re-anchored at the next tick, got ${e.next}")
}

test "a last tick four years ahead is ignored at sync and the schedule fires on time" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = queueOn(store, clock, locker, "a")
  mustEvery(q, Missed.RunOnce)
  locker.newest[q.entries[0].id] = t0 + fourYears
  clock.advance(30 * Second)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [t0 + 30 * Second], "the on-time tick")
  assert(
    q.entries[0].next == t0 + Minute + 30 * Second,
    "next follows the clock, got ${q.entries[0].next}",
  )
}

test "a last tick an hour ahead is used, and the schedule waits for it" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = queueOn(store, clock, locker, "a")
  mustEvery(q, Missed.RunOnce)
  locker.newest[q.entries[0].id] = t0 + Hour
  clock.advance(30 * Second)
  runDue(q, clock.nowNs())
  assert(
    dueCount(store) == 0,
    "a tick an hour ahead is another instance's; want 0, got ${dueCount(store)}",
  )
}

test "the ignored last tick is worded with the schedule, the tick and the distance" {
  let got = lastTickIgnoredMessage("x", 3 * Hour, 2 * Hour)
  assert(contains(got, "jobs: schedule 'x': the locker's last tick "), "got ${got}")
  assert(
    contains(got, " is 2h0m0s in the future; ignoring it (an instance with a wrong clock?)"),
    "got ${got}",
  )
}
