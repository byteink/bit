// pkg/jobs/scheduler.test.bit — `Queue.schedule`/`Queue.every` and the
// scheduler pass behind them (scheduler.bit, #6083): each `Missed` policy
// after a simulated stall, the lease that makes N instances enqueue each
// tick once, zone and expression validation, and the start/stop loop. Time
// is a `fakeClock` the test moves by hand, so nothing sleeps for a tick and
// nothing depends on machine load.

import { Mutex, AtomicI64 } from "std/sync"
import { sleep, Second, Minute, Hour, Millisecond, Timestamp, utc } from "std/time"
import { lastIndexOf, parseInt } from "std/strings"

@job("test-tick") @json class TickJob {
  tag: string,
}

class fakeClock {
  ns: AtomicI64

  nowNs(): int {
    return int(this.ns.load())
  }

  pause(d: int) {
    sleep(Millisecond)
  }

  advance(d: int) {
    this.ns.add(i64(d))
  }
}

fn newFakeClock(startNs: int): fakeClock {
  return fakeClock{ ns = AtomicI64(i64(startNs)) }
}

// An in-memory Locker with the same contract as SqlLocker: a key is
// held until its expiry, the holder itself always re-acquires, and the
// newest tick won per schedule is remembered for `lastTick`. `lastFails`
// makes `lastTick` fail, a database that is down at start; `acquireFails`
// makes `tryAcquire` fail, a database that is down when a tick fires;
// `failAfter` (-1: never) lets that many `tryAcquire` calls succeed and then
// fails the rest, a database that goes down part-way through a burst.
// `clock` is the database's clock: `queueOn` binds the queue's clock to it
// when it has none, so the two agree; a test that sets its own (or an
// `offset`, added to it) makes them disagree. `serverFails` makes
// `serverNowNs` fail, a database that is down at the clock check.
class fakeLocker {
  clock: Clock
  offset: int
  serverFails: bool
  serverCalls: int
  holder: map<string, string>
  expires: map<string, int>
  newest: map<string, int>
  lastFails: bool
  acquireFails: bool
  failAfter: int
  keep: int
  mu: Mutex

  tryAcquire(key: string, holder: string, nowNs: int, expiresAt: int): bool! {
    if (this.acquireFails) {
      fail newError("database down")
    }
    this.mu.lock()
    defer this.mu.unlock()
    if (this.failAfter == 0) {
      fail newError("database down")
    }
    if (this.failAfter > 0) {
      this.failAfter = this.failAfter - 1
    }
    let (cur, has) = this.holder[key]
    let (exp, _) = this.expires[key]
    if (has && cur != holder && exp > nowNs) {
      return false
    }
    this.holder[key] = holder
    this.expires[key] = expiresAt
    this.remember(key)?
    return true
  }

  // Records the tick of a `<schedule id>@<tick>` key when it is the newest.
  remember(key: string): ()! {
    let at = lastIndexOf(key, "@")
    let tick = parseInt(key[at + 1:len(key)])?
    let id = key[0:at]
    let (best, _) = this.newest[id]
    if (tick > best) {
      this.newest[id] = tick
    }
  }

  window(): int {
    return this.keep
  }

  serverNowNs(): int! {
    if (this.serverFails) {
      fail newError("database down")
    }
    this.serverCalls = this.serverCalls + 1
    return this.clock.nowNs() + this.offset
  }

  lastTick(key: string): int! {
    if (this.lastFails) {
      fail newError("database down")
    }
    this.mu.lock()
    defer this.mu.unlock()
    let (best, _) = this.newest[key]
    return best
  }
}

fn newFakeLocker(): fakeLocker {
  return fakeLocker{
    clock = nil,
    offset = 0,
    serverFails = false,
    serverCalls = 0,
    holder = map<string, string>(),
    expires = map<string, int>(),
    newest = map<string, int>(),
    lastFails = false,
    acquireFails = false,
    failAfter = -1,
    keep = 1024,
    mu = Mutex(),
  }
}

// Gives a `fakeLocker` with no database clock the queue's own, so a test that
// says nothing about skew has clocks that agree.
fn bindServerClock(locker: Locker, clock: Clock) {
  if (locker == nil) {
    return
  }
  let (fake, ok) = locker.(fakeLocker)
  if (ok && fake.clock == nil) {
    fake.clock = clock
  }
}

fn queueOn(store: fakeStore, clock: Clock, locker: Locker, id: string): Queue {
  bindServerClock(locker, clock)
  let q = open(
    store,
    Options{
      workers = 1,
      pollInterval = 5 * Millisecond,
      locker = locker,
      clock = clock,
      instanceId = id,
    },
  ) catch e {
    panic("open: ${e.message()}")
  }
  return q
}

fn mustEvery(q: Queue, missed: Missed) {
  q.every(Minute, TickJob{ tag = "t" }, missed = missed) catch e {
    panic("every: ${e.message()}")
  }
}

fn dueCount(store: fakeStore): int {
  return len(store.rows)
}

// Epoch-aligned start, 30 seconds into a minute, so ticks fall on minutes.
const t0: int = 1000 * Minute + 30 * Second

// Exactly on a tick: advancing a whole period from here reaches the tick with
// no lateness at all.
const onTick: int = 1200 * Minute

// t0 is 30 s past a tick, so after five periods the newest tick is 30 s late
// (on time: under a minute and before the next is due) and the four before it
// are missed.
test "a stall of five ticks: four are missed, the newest is on time" {
  let want = [1, 2, 4]
  let policies = [Missed.Skip, Missed.RunOnce, Missed.RunAll(3)]
  let i = 0
  while (i < 3) {
    let store = newFakeStore()
    let clock = newFakeClock(t0)
    let q = queueOn(store, clock, nil, "a")
    mustEvery(q, policies[i])
    clock.advance(5 * Minute)
    runDue(q, clock.nowNs())
    assert(
      dueCount(store) == want[i],
      "policy ${i}: want ${want[i]} enqueues, got ${dueCount(store)}",
    )
    i = i + 1
  }
}

test "an on-time tick is never a miss, even under Skip" {
  let store = newFakeStore()
  let clock = newFakeClock(onTick)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.Skip)
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "one due tick must fire, got ${dueCount(store)}")
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "the same tick must not fire twice, got ${dueCount(store)}")
}

test "three instances sharing a locker enqueue each tick exactly once" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let qs = [
    queueOn(store, clock, locker, "a"),
    queueOn(store, clock, locker, "b"),
    queueOn(store, clock, locker, "c"),
  ]
  for q of qs {
    mustEvery(q, Missed.RunAll(10))
  }
  let tick = 0
  while (tick < 4) {
    clock.advance(Minute)
    for q of qs {
      runDue(q, clock.nowNs())
    }
    tick = tick + 1
  }
  assert(dueCount(store) == 4, "want 4 enqueues for 4 ticks, got ${dueCount(store)}")
}

test "catch-up is exactly-once across instances too" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let a = queueOn(store, clock, locker, "a")
  let b = queueOn(store, clock, locker, "b")
  mustEvery(a, Missed.RunAll(10))
  mustEvery(b, Missed.RunAll(10))
  clock.advance(6 * Minute)
  runDue(a, clock.nowNs())
  runDue(b, clock.nowNs())
  assert(dueCount(store) == 6, "want 6 catch-up enqueues once, got ${dueCount(store)}")
}

test "a cron schedule enqueues at its tick" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  q.schedule("*/2 * * * *", TickJob{ tag = "c" }, tz = "UTC") catch e {
    panic("schedule: ${e.message()}")
  }
  clock.advance(2 * Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "want 1 enqueue, got ${dueCount(store)}")
  assert(store.rows[0].name == "test-tick", "wrong job name ${store.rows[0].name}")
}

test "schedule rejects an unknown zone, a bad expression, a bad period and a duplicate" {
  let store = newFakeStore()
  let q = queueOn(store, newFakeClock(t0), nil, "a")
  let bad = 0
  q.schedule("0 2 * * *", TickJob{ tag = "z" }, tz = "Not/AZone") catch _ {
    bad = bad + 1
  }
  q.schedule("nonsense", TickJob{ tag = "e" }) catch _ {
    bad = bad + 1
  }
  q.every(0, TickJob{ tag = "p" }) catch _ {
    bad = bad + 1
  }
  mustEvery(q, Missed.Skip)
  q.every(Minute, TickJob{ tag = "t" }) catch _ {
    bad = bad + 1
  }
  assert(bad == 4, "want 4 rejections, got ${bad}")
}

test "start() runs the scheduler loop and stop() ends it" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.RunOnce)
  q.start()
  clock.advance(Minute)
  let waited = 0
  while (dueCount(store) < 1 && waited < 5000) {
    sleep(5 * Millisecond)
    waited = waited + 5
  }
  q.stop()
  assert(
    dueCount(store) == 1,
    "the loop must enqueue the tick exactly once, got ${dueCount(store)}",
  )
}

// The fleet fires one tick, goes down for five more, and a brand new
// instance (a new Queue, the same store and locker) starts: what it enqueues
// is what `missed` says about those five ticks.
fn enqueuedAfterDowntime(policy: Missed, locker: Locker): int {
  let store = newFakeStore()
  let clock = newFakeClock(onTick)
  let before = queueOn(store, clock, locker, "before")
  mustEvery(before, policy)
  clock.advance(Minute)
  runDue(before, clock.nowNs())
  assert(dueCount(store) == 1, "the on-time tick must fire, got ${dueCount(store)}")
  clock.advance(5 * Minute + 30 * Second)
  let after = queueOn(store, clock, locker, "after")
  mustEvery(after, policy)
  runDue(after, clock.nowNs())
  return dueCount(store) - 1
}

test "a restart after downtime catches up by policy: the newest tick fires, the missed four go by policy" {
  let want = [1, 2, 4]
  let policies = [Missed.Skip, Missed.RunOnce, Missed.RunAll(3)]
  let i = 0
  while (i < 3) {
    let got = enqueuedAfterDowntime(policies[i], newFakeLocker())
    assert(got == want[i], "policy ${i}: want ${want[i]} catch-up enqueues, got ${got}")
    i = i + 1
  }
}

test "without a locker a restart starts at the next tick and catches nothing up" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.RunAll(10))
  clock.advance(5 * Minute)
  let restarted = queueOn(store, clock, nil, "b")
  mustEvery(restarted, Missed.RunAll(10))
  runDue(restarted, clock.nowNs())
  assert(dueCount(store) == 0, "want 0 enqueues, got ${dueCount(store)}")
}

test "a schedule that never fired starts at the next tick, not in the past" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, newFakeLocker(), "a")
  mustEvery(q, Missed.RunAll(10))
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "want 0 enqueues before the first tick, got ${dueCount(store)}")
}

test "a failing lastTick holds the schedule back until it succeeds" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = queueOn(store, clock, locker, "a")
  mustEvery(q, Missed.RunOnce)
  locker.lastFails = true
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "a schedule that cannot read its last tick fired ${dueCount(store)}")
  locker.lastFails = false
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "want 1 enqueue once lastTick works, got ${dueCount(store)}")
}

// One tick of an hourly schedule, `lateNs` past its due time when the
// scheduler first reaches it, under `policy`: how many jobs are enqueued.
fn enqueuedWhenLate(lateNs: int, policy: Missed): int {
  let store = newFakeStore()
  let clock = newFakeClock(onTick)
  let q = queueOn(store, clock, newFakeLocker(), "a")
  q.every(Hour, TickJob{ tag = "h" }, missed = policy) catch e {
    panic("every: ${e.message()}")
  }
  clock.advance(Hour + lateNs)
  runDue(q, clock.nowNs())
  return dueCount(store)
}

test "a tick due 30 minutes ago after a restart: Skip 0, RunOnce 1, RunAll(3) 1" {
  let want = [0, 1, 1]
  let policies = [Missed.Skip, Missed.RunOnce, Missed.RunAll(3)]
  let i = 0
  while (i < 3) {
    let got = enqueuedWhenLate(30 * Minute, policies[i])
    assert(got == want[i], "policy ${i}: want ${want[i]} enqueues, got ${got}")
    i = i + 1
  }
}

test "a tick reached 1 ms late is on time: Skip enqueues it" {
  let got = enqueuedWhenLate(Millisecond, Missed.Skip)
  assert(got == 1, "want 1 enqueue 1 ms late, got ${got}")
}

test "an hourly tick is missed only past a minute, inclusive" {
  assert(enqueuedWhenLate(Minute, Missed.Skip) == 1, "a tick exactly a minute late must fire")
  assert(enqueuedWhenLate(Minute + 1, Missed.Skip) == 0, "a tick past a minute late is missed")
}

test "the threshold is a minute, not pollInterval: a tick 10 polls late fires" {
  assert(enqueuedWhenLate(50 * Millisecond, Missed.Skip) == 1, "10 polls late must fire")
  assert(enqueuedWhenLate(30 * Second, Missed.Skip) == 1, "30 s late must fire")
}

// The plan for an every-minute schedule whose first unhandled tick is
// minute `next`, at `now`, under `policy`.
fn minutePlan(next: int, now: int, policy: Missed): catchUp {
  let t: trigger = intervalTrigger{ periodNs = Minute }
  let plan = planCatchUp(t, next, now, policy) catch e {
    panic("planCatchUp: ${e.message()}")
  }
  return plan
}

// `xs` as "[a, b, c]" for an assertion message.
fn showInts(xs: []int): string {
  let out = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      out = out + ", "
    }
    out = out + "${xs[i]}"
    i = i + 1
  }
  return out + "]"
}

fn wantInts(got: []int, want: []int, what: string) {
  assert(showInts(got) == showInts(want), "${what}: want ${showInts(want)}, got ${showInts(got)}")
}

fn wantFire(plan: catchUp, want: []int, what: string) {
  wantInts(plan.fire, want, what)
}

test "on-time ticks after a missed prefix always fire: RunOnce keeps one of the missed" {
  let next = 1 * Minute
  // One second past tick 4 (on time); tick 3 is a minute and a second late
  // with tick 4 already due, so it is missed.
  let now = 4 * Minute + Second
  wantFire(minutePlan(next, now, Missed.Skip), [4 * Minute], "Skip keeps only the on-time tick")
  wantFire(
    minutePlan(next, now, Missed.RunOnce),
    [3 * Minute, 4 * Minute],
    "RunOnce adds one missed tick",
  )
  wantFire(
    minutePlan(next, now, Missed.RunAll(2)),
    [2 * Minute, 3 * Minute, 4 * Minute],
    "RunAll(2) adds two missed ticks",
  )
  let all = minutePlan(next, now, Missed.RunAll(9))
  wantFire(all, [Minute, 2 * Minute, 3 * Minute, 4 * Minute], "RunAll(9) keeps all four")
  assert(!all.dropped, "RunAll(9) drops nothing")
  let skip = minutePlan(next, now, Missed.Skip)
  assert(skip.dropped && skip.count == "3", "Skip drops 3 of 3, got ${skip.count}")
  assert(skip.first == Minute && skip.last == 3 * Minute, "the window is minutes 1 to 3")
  assert(skip.after == 5 * Minute, "the next tick is minute 5, got ${skip.after}")
}

test "a tick is not missed until the next one is overdue, exactly" {
  let on = minutePlan(1 * Minute, 2 * Minute, Missed.Skip)
  wantFire(on, [Minute, 2 * Minute], "now == next tick: the one before it is not missed")
  assert(!on.dropped, "nothing is dropped when now is the next tick")
  let late = minutePlan(1 * Minute, 2 * Minute + 1, Missed.Skip)
  wantFire(late, [2 * Minute], "one ns past: the older tick is missed")
  assert(late.dropped && late.count == "1", "one tick dropped, got ${late.count}")
}

test "nothing is due before the first tick: the plan changes nothing" {
  let plan = minutePlan(5 * Minute, Minute, Missed.RunAll(3))
  wantFire(plan, []int(0), "no ticks due")
  assert(!plan.dropped && plan.after == 5 * Minute, "next stays minute 5, got ${plan.after}")
}

test "every second, stalled 3 s: two ticks missed, one on time" {
  let store = newFakeStore()
  let clock = newFakeClock(1000 * Minute + 500 * Millisecond)
  let q = queueOn(store, clock, nil, "a")
  q.every(Second, TickJob{ tag = "s" }, missed = Missed.Skip) catch e {
    panic("every: ${e.message()}")
  }
  clock.advance(3 * Second)
  let t: trigger = intervalTrigger{ periodNs = Second }
  let plan = planCatchUp(t, 1000 * Minute + Second, clock.nowNs(), Missed.Skip) catch e {
    panic("planCatchUp: ${e.message()}")
  }
  assert(plan.dropped && plan.count == "2", "want 2 missed of 3 due, got ${plan.count}")
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "Skip: want the one on-time tick, got ${dueCount(store)}")
}

// A nightly 02:00 UTC schedule over a fleet that already fired the night
// before: a fresh instance (a restart, or the same one after a failed pass)
// reaches the new night's tick `lateNs` after 02:00. Returns the enqueues
// for that night.
const day0: int = 1767225600 * Second

fn nightlyAfter(lateNs: int, policy: Missed): int {
  let store = newFakeStore()
  let locker = newFakeLocker()
  let clock = newFakeClock(day0 + 2 * Hour - Minute)
  let before = queueOn(store, clock, locker, "before")
  before.schedule("0 2 * * *", TickJob{ tag = "n" }, tz = "UTC", missed = policy) catch e {
    panic("schedule: ${e.message()}")
  }
  clock.advance(Minute)
  runDue(before, clock.nowNs())
  assert(dueCount(store) == 1, "the first night must fire, got ${dueCount(store)}")
  clock.advance(24 * Hour + lateNs)
  let after = queueOn(store, clock, locker, "after")
  after.schedule("0 2 * * *", TickJob{ tag = "n" }, tz = "UTC", missed = policy) catch e {
    panic("schedule: ${e.message()}")
  }
  runDue(after, clock.nowNs())
  return dueCount(store) - 1
}

test "a deploy that restarts the app 30 s after 02:00 still enqueues the nightly tick under Skip" {
  assert(nightlyAfter(30 * Second, Missed.Skip) == 1, "want the nightly tick enqueued")
}

test "a restart over a minute after 02:00 drops the nightly tick under Skip, enqueues it otherwise" {
  assert(nightlyAfter(Minute + Second, Missed.Skip) == 0, "Skip: want it dropped")
  assert(nightlyAfter(Minute + Second, Missed.RunOnce) == 1, "RunOnce: want it enqueued")
}

test "a store failure at 02:00:00 that recovers at 02:00:40 still enqueues the nightly tick under Skip" {
  let store = newFakeStore()
  let locker = newFakeLocker()
  let clock = newFakeClock(day0 + 2 * Hour - Minute)
  let q = queueOn(store, clock, locker, "a")
  q.schedule("0 2 * * *", TickJob{ tag = "n" }, tz = "UTC", missed = Missed.Skip) catch e {
    panic("schedule: ${e.message()}")
  }
  locker.acquireFails = true
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "the store is down: nothing can be enqueued yet")
  // Many failed retries, one per poll, then the store comes back.
  let retry = 0
  while (retry < 10) {
    clock.advance(4 * Second)
    runDue(q, clock.nowNs())
    retry = retry + 1
  }
  locker.acquireFails = false
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "want the nightly tick enqueued at 02:00:40, got ${dueCount(store)}")
}

test "a store failure that outlasts a minute drops the nightly tick under Skip" {
  let store = newFakeStore()
  let locker = newFakeLocker()
  let clock = newFakeClock(day0 + 2 * Hour - Minute)
  let q = queueOn(store, clock, locker, "a")
  q.schedule("0 2 * * *", TickJob{ tag = "n" }, tz = "UTC", missed = Missed.Skip) catch e {
    panic("schedule: ${e.message()}")
  }
  locker.acquireFails = true
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  clock.advance(Minute + Second)
  locker.acquireFails = false
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "a minute past the tick, Skip drops it, got ${dueCount(store)}")
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "a dropped tick stays dropped, got ${dueCount(store)}")
}

// A clock that moves `step` on every read, the way a slow pass moves real
// time, and remembers the first `pause` the loop asked for.
class stepClock {
  ns: AtomicI64
  step: AtomicI64
  firstPause: AtomicI64

  nowNs(): int {
    return int(this.ns.add(this.step.load()))
  }

  pause(d: int) {
    this.firstPause.compareAndSwap(i64(0), i64(d))
    sleep(Millisecond)
  }
}

test "the loop sleeps from the end of the pass, not from its start" {
  let store = newFakeStore()
  let clock = stepClock{
    ns = AtomicI64(i64(onTick)),
    step = AtomicI64(i64(0)),
    firstPause = AtomicI64(i64(0)),
  }
  let q = queueOn(store, clock, nil, "a")
  q.every(Hour, TickJob{ tag = "h" }, missed = Missed.Skip) catch e {
    panic("every: ${e.message()}")
  }
  // 7 ms before the tick; each read moves 2 ms, so the pass reads 5 ms
  // before it and the sleep is computed from a clock 3 ms before it. Measured
  // from the pass start the sleep would be the full 5 ms pollInterval.
  clock.ns.store(i64(onTick + Hour - 7 * Millisecond))
  clock.step.store(i64(2 * Millisecond))
  q.start()
  let waited = 0
  while (clock.firstPause.load() == i64(0) && waited < 5000) {
    sleep(Millisecond)
    waited = waited + 1
  }
  q.stop()
  assert(
    clock.firstPause.load() == i64(3 * Millisecond),
    "want a 3 ms sleep, got ${clock.firstPause.load()} ns",
  )
}

test "missedMessage names the schedule, the window, the policy and what was enqueued" {
  let plan = minutePlan(1 * Minute, 4 * Minute + Second, Missed.RunAll(2))
  let first = Timestamp{ ns = 1 * Minute }.toString()
  let last = Timestamp{ ns = 3 * Minute }.toString()
  let want = "jobs: schedule 'x' missed 3 tick(s) from ${first} to ${last}; Missed.RunAll(2) enqueued 2\n"
  let got = missedMessage("x", plan, Missed.RunAll(2))
  assert(got == want, "got ${got}")
  assert(missedName(Missed.Skip) == "Skip", "Skip")
  assert(missedName(Missed.RunOnce) == "RunOnce", "RunOnce")
}

test "a count the trigger cannot know is worded as a lower bound" {
  let cs = parseCron("*/5 * * * *") catch e {
    panic("parse: ${e.message()}")
  }
  let t: trigger = cronTrigger{ cron = cs, tz = utc() }
  let next = 1000 * Minute
  let plan = planCatchUp(t, next, next + 100 * Minute + Second, Missed.RunAll(3)) catch e {
    panic("planCatchUp: ${e.message()}")
  }
  assert(plan.count == "more than 3", "want 'more than 3', got '${plan.count}'")
  let skip = planCatchUp(t, next, next + 100 * Minute + Second, Missed.Skip) catch e {
    panic("planCatchUp: ${e.message()}")
  }
  assert(skip.count == "more than 1", "want 'more than 1', got '${skip.count}'")
}

// The availableAt of every enqueued row, in enqueue order.
fn enqueuedTicks(store: fakeStore): []int {
  let out = []int(0)
  for r of store.rows {
    out = append(out, r.availableAt)
  }
  return out
}

fn wantEnqueued(store: fakeStore, want: []int, what: string) {
  wantInts(enqueuedTicks(store), want, what)
}

// A device with no RTC registers `every(1 * Second)` at 1970 (`newEntry`
// reads the clock), then NTP moves the clock to 2026-01-01T00:00:00.5Z: 1.77
// billion ticks behind, the last of them on time.
fn bootedAt1970(policy: Missed, locker: Locker): (Queue, fakeStore, fakeClock) {
  let store = newFakeStore()
  let clock = newFakeClock(0)
  let q = queueOn(store, clock, locker, "a")
  q.every(Second, TickJob{ tag = "s" }, missed = policy) catch e {
    panic("every: ${e.message()}")
  }
  clock.advance(day0 + 500 * Millisecond)
  return (q, store, clock)
}

test "1970 to 2026, every second, RunOnce: one catch-up and the on-time tick, in one pass" {
  let (q, store, clock) = bootedAt1970(Missed.RunOnce, nil)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [day0 - Second, day0], "RunOnce")
  assert(
    q.entries[0].next == day0 + Second,
    "next must be the tick after now, got ${q.entries[0].next}",
  )
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 2, "a second pass must add nothing, got ${dueCount(store)}")
}

test "1970 to 2026, every second, RunAll(3): the newest three missed ticks and the on-time tick" {
  let (q, store, clock) = bootedAt1970(Missed.RunAll(3), nil)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [day0 - 3 * Second, day0 - 2 * Second, day0 - Second, day0], "RunAll(3)")
}

test "1970 to 2026, every second, Skip: only the on-time tick" {
  let (q, store, clock) = bootedAt1970(Missed.Skip, nil)
  runDue(q, clock.nowNs())
  wantEnqueued(store, [day0], "Skip")
}

test "a cron schedule three years behind: the newest three missed ticks and the on-time tick" {
  let store = newFakeStore()
  let clock = newFakeClock(day0)
  let q = queueOn(store, clock, nil, "a")
  q.schedule("*/5 * * * *", TickJob{ tag = "c" }, tz = "UTC", missed = Missed.RunAll(3)) catch e {
    panic("schedule: ${e.message()}")
  }
  let newest = day0 + 1096 * 24 * Hour
  clock.advance(1096 * 24 * Hour + 30 * Second)
  runDue(q, clock.nowNs())
  wantEnqueued(
    store,
    [newest - 15 * Minute, newest - 10 * Minute, newest - 5 * Minute, newest],
    "cron RunAll(3)",
  )
  assert(
    q.entries[0].next == newest + 5 * Minute,
    "next is 5 minutes on, got ${q.entries[0].next}",
  )
}

test "a burst cut short by a failing store resumes at the first tick not enqueued" {
  let locker = newFakeLocker()
  let (q, store, clock) = bootedAt1970(Missed.RunAll(3), locker)
  locker.failAfter = 2
  runDue(q, clock.nowNs())
  wantEnqueued(store, [day0 - 3 * Second, day0 - 2 * Second], "before the failure")
  assert(q.entries[0].next == day0 - Second, "resume at the third tick, got ${q.entries[0].next}")
  locker.failAfter = -1
  runDue(q, clock.nowNs())
  wantEnqueued(
    store,
    [day0 - 3 * Second, day0 - 2 * Second, day0 - Second, day0],
    "after the retry",
  )
}

