// pkg/jobs/scheduler.test.bit — `Queue.schedule`/`Queue.every` and the
// scheduler pass behind them (scheduler.bit, #6083): each `Missed` policy
// after a simulated stall, the lease that makes N instances enqueue each
// tick once, zone and expression validation, and the start/stop loop. Time
// is a `fakeClock` the test moves by hand, so nothing sleeps for a tick and
// nothing depends on machine load.

import { newMutex, Mutex, newAtomicI64, AtomicI64 } from "std/sync"
import { sleep, Minute, Hour, Millisecond } from "std/time"
import { lastIndexOf, parseInt } from "std/strings"

@job("test-tick") @json class TickJob {
  tag: string,
}

class fakeClock {
  ns: AtomicI64

  nowNs(): int {
    return int(this.ns.load())
  }

  pause(d: int) {
    sleep(Millisecond)
  }

  advance(d: int) {
    this.ns.add(i64(d))
  }
}

fn newFakeClock(startNs: int): fakeClock {
  return fakeClock{ ns = newAtomicI64(i64(startNs)) }
}

// An in-memory Locker with the same contract as PostgresLocker: a key is
// held until its expiry, the holder itself always re-acquires, and the
// newest tick won per schedule is remembered for `lastTick`. `lastFails`
// makes `lastTick` fail, a database that is down at start.
class fakeLocker {
  holder: map<string, string>
  expires: map<string, int>
  newest: map<string, int>
  lastFails: bool
  mu: Mutex

  tryAcquire(key: string, holder: string, nowNs: int, expiresAt: int): bool! {
    this.mu.lock()
    defer this.mu.unlock()
    let (cur, has) = this.holder[key]
    let (exp, _) = this.expires[key]
    if (has && cur != holder && exp > nowNs) {
      return false
    }
    this.holder[key] = holder
    this.expires[key] = expiresAt
    this.remember(key)?
    return true
  }

  // Records the tick of a `<schedule id>@<tick>` key when it is the newest.
  remember(key: string): ()! {
    let at = lastIndexOf(key, "@")
    let tick = parseInt(key[at + 1:len(key)])?
    let id = key[0:at]
    let (best, _) = this.newest[id]
    if (tick > best) {
      this.newest[id] = tick
    }
  }

  lastTick(key: string): int! {
    if (this.lastFails) {
      fail newError("database down")
    }
    this.mu.lock()
    defer this.mu.unlock()
    let (best, _) = this.newest[key]
    return best
  }
}

fn newFakeLocker(): fakeLocker {
  return fakeLocker{
    holder = map<string, string>(),
    expires = map<string, int>(),
    newest = map<string, int>(),
    lastFails = false,
    mu = newMutex(),
  }
}

fn queueOn(store: fakeStore, clock: fakeClock, locker: Locker, id: string): Queue {
  let q = open(
    store,
    Options{
      workers = 1,
      pollInterval = 5 * Millisecond,
      locker = locker,
      clock = clock,
      instanceId = id,
    },
  ) catch e {
    panic("open: ${e.message()}")
  }
  return q
}

fn mustEvery(q: Queue, missed: Missed) {
  q.every(Minute, TickJob{ tag = "t" }, missed = missed) catch e {
    panic("every: ${e.message()}")
  }
}

fn dueCount(store: fakeStore): int {
  return len(store.rows)
}

// Epoch-aligned start, 30 seconds into a minute, so ticks fall on minutes.
const t0: int = 1000 * Minute + 30 * Second

// Exactly on a tick: advancing a whole period from here reaches the tick with
// no lateness at all.
const onTick: int = 1200 * Minute

test "a stall of five ticks: Skip enqueues none, RunOnce one, RunAll(3) three" {
  let want = [0, 1, 3]
  let policies = [Missed.Skip, Missed.RunOnce, Missed.RunAll(3)]
  let i = 0
  while (i < 3) {
    let store = newFakeStore()
    let clock = newFakeClock(t0)
    let q = queueOn(store, clock, nil, "a")
    mustEvery(q, policies[i])
    clock.advance(5 * Minute)
    runDue(q, clock.nowNs())
    assert(
      dueCount(store) == want[i],
      "policy ${i}: want ${want[i]} enqueues, got ${dueCount(store)}",
    )
    i = i + 1
  }
}

test "an on-time tick is never a miss, even under Skip" {
  let store = newFakeStore()
  let clock = newFakeClock(onTick)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.Skip)
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "one due tick must fire, got ${dueCount(store)}")
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "the same tick must not fire twice, got ${dueCount(store)}")
}

test "three instances sharing a locker enqueue each tick exactly once" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let qs = [
    queueOn(store, clock, locker, "a"),
    queueOn(store, clock, locker, "b"),
    queueOn(store, clock, locker, "c"),
  ]
  for q of qs {
    mustEvery(q, Missed.RunAll(10))
  }
  let tick = 0
  while (tick < 4) {
    clock.advance(Minute)
    for q of qs {
      runDue(q, clock.nowNs())
    }
    tick = tick + 1
  }
  assert(dueCount(store) == 4, "want 4 enqueues for 4 ticks, got ${dueCount(store)}")
}

test "catch-up is exactly-once across instances too" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let a = queueOn(store, clock, locker, "a")
  let b = queueOn(store, clock, locker, "b")
  mustEvery(a, Missed.RunAll(10))
  mustEvery(b, Missed.RunAll(10))
  clock.advance(6 * Minute)
  runDue(a, clock.nowNs())
  runDue(b, clock.nowNs())
  assert(dueCount(store) == 6, "want 6 catch-up enqueues once, got ${dueCount(store)}")
}

test "a cron schedule enqueues at its tick" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  q.schedule("*/2 * * * *", TickJob{ tag = "c" }, tz = "UTC") catch e {
    panic("schedule: ${e.message()}")
  }
  clock.advance(2 * Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "want 1 enqueue, got ${dueCount(store)}")
  assert(store.rows[0].name == "test-tick", "wrong job name ${store.rows[0].name}")
}

test "schedule rejects an unknown zone, a bad expression, a bad period and a duplicate" {
  let store = newFakeStore()
  let q = queueOn(store, newFakeClock(t0), nil, "a")
  let bad = 0
  q.schedule("0 2 * * *", TickJob{ tag = "z" }, tz = "Not/AZone") catch _ {
    bad = bad + 1
  }
  q.schedule("nonsense", TickJob{ tag = "e" }) catch _ {
    bad = bad + 1
  }
  q.every(0, TickJob{ tag = "p" }) catch _ {
    bad = bad + 1
  }
  mustEvery(q, Missed.Skip)
  q.every(Minute, TickJob{ tag = "t" }) catch _ {
    bad = bad + 1
  }
  assert(bad == 4, "want 4 rejections, got ${bad}")
}

test "start() runs the scheduler loop and stop() ends it" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.RunOnce)
  q.start()
  clock.advance(Minute)
  let waited = 0
  while (dueCount(store) < 1 && waited < 5000) {
    sleep(5 * Millisecond)
    waited = waited + 5
  }
  q.stop()
  assert(
    dueCount(store) == 1,
    "the loop must enqueue the tick exactly once, got ${dueCount(store)}",
  )
}

// The fleet fires one tick, goes down for five more, and a brand new
// instance (a new Queue, the same store and locker) starts: what it enqueues
// is what `missed` says about those five ticks.
fn enqueuedAfterDowntime(policy: Missed, locker: Locker): int {
  let store = newFakeStore()
  let clock = newFakeClock(onTick)
  let before = queueOn(store, clock, locker, "before")
  mustEvery(before, policy)
  clock.advance(Minute)
  runDue(before, clock.nowNs())
  assert(dueCount(store) == 1, "the on-time tick must fire, got ${dueCount(store)}")
  clock.advance(5 * Minute + 30 * Second)
  let after = queueOn(store, clock, locker, "after")
  mustEvery(after, policy)
  runDue(after, clock.nowNs())
  return dueCount(store) - 1
}

test "a restart after downtime catches up by policy: Skip 0, RunOnce 1, RunAll(3) 3" {
  let want = [0, 1, 3]
  let policies = [Missed.Skip, Missed.RunOnce, Missed.RunAll(3)]
  let i = 0
  while (i < 3) {
    let got = enqueuedAfterDowntime(policies[i], newFakeLocker())
    assert(got == want[i], "policy ${i}: want ${want[i]} catch-up enqueues, got ${got}")
    i = i + 1
  }
}

test "without a locker a restart starts at the next tick and catches nothing up" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, nil, "a")
  mustEvery(q, Missed.RunAll(10))
  clock.advance(5 * Minute)
  let restarted = queueOn(store, clock, nil, "b")
  mustEvery(restarted, Missed.RunAll(10))
  runDue(restarted, clock.nowNs())
  assert(dueCount(store) == 0, "want 0 enqueues, got ${dueCount(store)}")
}

test "a schedule that never fired starts at the next tick, not in the past" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let q = queueOn(store, clock, newFakeLocker(), "a")
  mustEvery(q, Missed.RunAll(10))
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "want 0 enqueues before the first tick, got ${dueCount(store)}")
}

test "a failing lastTick holds the schedule back until it succeeds" {
  let store = newFakeStore()
  let clock = newFakeClock(t0)
  let locker = newFakeLocker()
  let q = queueOn(store, clock, locker, "a")
  mustEvery(q, Missed.RunOnce)
  locker.lastFails = true
  clock.advance(Minute)
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 0, "a schedule that cannot read its last tick fired ${dueCount(store)}")
  locker.lastFails = false
  runDue(q, clock.nowNs())
  assert(dueCount(store) == 1, "want 1 enqueue once lastTick works, got ${dueCount(store)}")
}

// One tick of an hourly schedule, `lateNs` past its due time when the
// scheduler first reaches it, under `policy`: how many jobs are enqueued.
fn enqueuedWhenLate(lateNs: int, policy: Missed): int {
  let store = newFakeStore()
  let clock = newFakeClock(onTick)
  let q = queueOn(store, clock, newFakeLocker(), "a")
  q.every(Hour, TickJob{ tag = "h" }, missed = policy) catch e {
    panic("every: ${e.message()}")
  }
  clock.advance(Hour + lateNs)
  runDue(q, clock.nowNs())
  return dueCount(store)
}

test "a tick due 30 minutes ago after a restart: Skip 0, RunOnce 1, RunAll(3) 1" {
  let want = [0, 1, 1]
  let policies = [Missed.Skip, Missed.RunOnce, Missed.RunAll(3)]
  let i = 0
  while (i < 3) {
    let got = enqueuedWhenLate(30 * Minute, policies[i])
    assert(got == want[i], "policy ${i}: want ${want[i]} enqueues, got ${got}")
    i = i + 1
  }
}

test "a tick reached 1 ms late is on time: Skip enqueues it" {
  let got = enqueuedWhenLate(Millisecond, Missed.Skip)
  assert(got == 1, "want 1 enqueue 1 ms late, got ${got}")
}

test "the grace window is one pollInterval, inclusive" {
  let poll = 5 * Millisecond
  assert(enqueuedWhenLate(poll, Missed.Skip) == 1, "a tick exactly one poll late must fire")
  assert(enqueuedWhenLate(poll + 1, Missed.Skip) == 0, "a tick past one poll late is missed")
}

test "on-time ticks after a late prefix always fire: RunOnce keeps one of the late" {
  let ticks = [1 * Minute, 2 * Minute, 3 * Minute, 4 * Minute]
  let now = 4 * Minute
  assert(
    firstFiredTick(ticks, now, Millisecond, Missed.Skip) == 3,
    "Skip keeps only the on-time tick",
  )
  assert(
    firstFiredTick(ticks, now, Millisecond, Missed.RunOnce) == 2,
    "RunOnce adds one late tick",
  )
  assert(
    firstFiredTick(ticks, now, Millisecond, Missed.RunAll(2)) == 1,
    "RunAll(2) adds two late ticks",
  )
  assert(
    firstFiredTick(ticks, now, Millisecond, Missed.RunAll(9)) == 0,
    "RunAll(9) keeps all four",
  )
}
