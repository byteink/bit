// pkg/jobs/scheduler.bit — the scheduler loop `Queue.start` spawns beside
// the worker pool, the `Clock` it reads, and the per-tick lease that makes
// three instances enqueue each tick exactly once (#6083, epic #4023).
//
// ONE LEASE PER TICK, NOT PER SCHEDULE. Every instance runs the same loop
// over the same registered schedules and computes the same tick
// boundaries (schedule.bit: interval ticks are epoch-anchored, cron ticks
// are calendar arithmetic), so all of them reach "tick T is due" together.
// `holdsLease` then asks the `Locker` for the lease named
// "<schedule id>@<T>": exactly one instance is told yes, the rest skip the
// tick. A lease per SCHEDULE would let a leader that dies right after
// enqueueing tick T leave a follower that has never heard of T to fire it
// again once the lease lapses; a lease per tick cannot, because the key
// names the tick itself. With no `Locker` (a single instance) every tick
// is ours.
//
// LAST TICK COMES BACK FROM THE LOCKER. A process that starts asks its
// `Locker` for the newest tick of each schedule (`syncEntry`) and begins at
// the first tick after it, so the ticks that came due while the whole fleet
// was down are handled by the same `Missed` policy as a stalled loop. With
// no `Locker` nothing durable exists: a schedule then starts at the first
// tick after "now" and `Missed` covers only this scheduler's own stalls.
//
// A CLOCK THAT MOVES BACK CANNOT FREEZE A SCHEDULE (#6362). `next` only
// moves forward, so a wall clock reset to the past, or a schedule registered
// or synced under a clock that was ahead, would leave `next` years in the
// future with nothing firing. Every pass `checkClock` compares `next` with
// the first tick after now; a gap of `scheduleClockBackStep` (Vixie cron's
// three hours) or more re-anchors the schedule at that tick, a smaller one
// waits, and a `Locker.lastTick` that far in the future is ignored. Each of
// these is logged, once.
//
// A CLOCK THAT DISAGREES WITH THE DATABASE FIRES NOTHING (#6368). A lease row
// is stamped with the CALLER's clock, so an instance whose clock ran years
// ahead would win the leases of ticks that are years away, enqueue those jobs
// now, and leave rows that block every correct instance when the real clock
// reaches them. With a `Locker` there is a second clock to ask: at most once
// per `scheduleSkewCheckEvery` a pass compares `Clock.nowNs` with
// `Locker.serverNowNs`, and while they differ by more than `scheduleMaxSkew`
// the pass fires nothing. The workers run jobs regardless. A check that fails
// is a failed pass: nothing fires on an unchecked clock, and the next pass
// asks again. With no `Locker` there is no second clock and nothing changes.
//
// NO BUSY-WAIT: the loop sleeps until the earliest due tick, at most one
// `pollInterval` at a time so `stop()` is never delayed longer than that.

import { jsonEncode } from "std/json"
import { now, sleep, Hour } from "std/time"

// How long a per-tick lease outlives the moment it was taken. Only needs to
// exceed the skew between the fleet's clocks and the time an instance takes
// to enqueue; an hour is far beyond both. Expiry only lets another holder
// take the key over: it does not delete the row (`Locker.lastTick`).
const scheduleLeaseTtl: int = Hour

// The time source the scheduler reads and sleeps on. The default is the
// wall clock; a test injects its own through `Options.clock` so a run
// crosses hours of ticks in milliseconds and never depends on load.
export interface Clock {
  // The current time as nanoseconds since the Unix epoch.
  nowNs(): int,
  // Blocks the calling green thread for `ns` nanoseconds of this clock.
  pause(ns: int),
}

class systemClock {
  nowNs(): int {
    return now().ns
  }

  pause(ns: int) {
    sleep(ns)
  }
}

// One registered schedule: what ticks it has, how it catches up, the next
// tick not yet handled, and the closure that enqueues its job for a tick.
class entry {
  id: string,
  // The `@job` name, for the records `joblog.bit` writes about this schedule.
  job: string,
  trig: trigger,
  missed: Missed,
  next: int,
  fire: (int) => ()!,
  // True once `next` has been reconciled with the Locker's last tick.
  synced: bool,
  // The `next` for which no note is owed: a clock that stepped back by less
  // than `scheduleClockBackStep` leaves `next` ahead and is logged once per
  // `next`, not on every pass (`checkClock`).
  noted: int,
}

// What `schedule` and `every` register: the schedule's identity, the job it
// enqueues, what ticks it and how it catches up.
class schedSpec {
  id: string,
  job: string,
  trig: trigger,
  missed: Missed,
}

// A schedule whose first tick is the first one strictly after "now".
fn newEntry(spec: schedSpec, fire: (int) => ()!, clock: Clock): entry! {
  let first = spec.trig.nextAfterNs(clock.nowNs())?
  return entry{
    id = spec.id,
    job = spec.job,
    trig = spec.trig,
    missed = spec.missed,
    next = first,
    fire = fire,
    synced = false,
    noted = first,
  }
}

// Registers `e`, refusing a duplicate: two identical schedules share one
// lease key per tick, so the second would silently double-fire.
fn addEntry(q: Queue, e: entry): ()! {
  for have of q.entries {
    if (have.id == e.id) {
      fail newError("jobs: '${e.id}' is already scheduled")
    }
  }
  q.entries = append(q.entries, e)
}

// A stable identity for a schedule across processes: the job's `@job` name,
// what ticks it, and the zone it ticks in.
fn scheduleId(name: string, spec: string, tz: string): string {
  return "${name}|${spec}|${tz}"
}

// The closure that enqueues `job` for a tick. The payload is encoded once,
// at registration, not on every tick. `availableAt` is the tick itself so
// a catch-up burst is claimed oldest first.
fn tickEnqueuer<T: Job>(store: Store, job: T, maxAttempts: int): (int) => ()! {
  let name = T.__jobName()
  let payload = jsonEncode(job.toJson())
  let fire: (int) => ()! = (availableAt) => {
    store.enqueue(name, payload, availableAt, maxAttempts)?
  }
  return fire
}

fn holdsLease(q: Queue, e: entry, tick: int, nowNs: int): bool! {
  if (q.locker == nil) {
    return true
  }
  let held = q.locker.tryAcquire("${e.id}@${tick}", q.instance, nowNs, nowNs + scheduleLeaseTtl)?
  return held
}

fn fireTick(q: Queue, e: entry, tick: int, nowNs: int): ()! {
  let lead = holdsLease(q, e, tick, nowNs)?
  if (!lead) {
    return
  }
  e.fire(tick)?
}

// Moves `e.next` to the first tick after the newest one the fleet has
// already enqueued, once per process. Ticks between that and "now" are then
// due like any stall's. A failure leaves `synced` false, so the next pass
// retries before `e` fires anything on a stale `next`. A last tick more than
// `scheduleClockBackStep` after `nowNs` was written by an instance whose clock
// was ahead: it is logged and ignored, or `e` would wait for it, not fire.
fn syncEntry(q: Queue, e: entry, nowNs: int): ()! {
  if (e.synced) {
    return
  }
  if (q.locker != nil) {
    let last = q.locker.lastTick(e.id)?
    if (last - nowNs > scheduleClockBackStep) {
      logLastTickIgnored(q, e, last, last - nowNs)
    } else if (last > 0) {
      e.next = e.trig.nextAfterNs(last)?
    }
  }
  e.synced = true
}

// Reconciles `e.next` with a clock that stepped back (an RTC reset, NTP
// correcting a clock that ran ahead, a schedule registered under a clock
// that was ahead). While the clock only moves forward `e.next` is never after
// the first tick following `nowNs`; when it is, the clock moved back past at
// least one tick. A step of `scheduleClockBackStep` or more is a correction:
// `e` is re-anchored to the first tick after `nowNs`. A smaller one re-runs
// nothing and `e` waits. Both are logged (`logClockBack`), the waiting one
// once per `next`.
fn checkClock(q: Queue, e: entry, nowNs: int): ()! {
  let expected = e.trig.nextAfterNs(nowNs)?
  let gap = e.next - expected
  if (gap <= 0) {
    return
  }
  if (gap >= scheduleClockBackStep) {
    let was = e.next
    e.next = expected
    e.noted = expected
    logClockBack(q, e, was, gap, true)
    return
  }
  if (e.noted == e.next) {
    return
  }
  e.noted = e.next
  logClockBack(q, e, e.next, gap, false)
}

// Handles every tick of `e` due at `nowNs`, per `planCatchUp`: the work is the
// policy's cap, however far `e.next` is behind. `e.next` advances tick by tick
// as each is handled, so a failure part-way leaves `e.next` at the first
// tick not yet handled and the retry cannot re-enqueue one that already ran.
fn handleDue(q: Queue, e: entry, nowNs: int): ()! {
  let plan = planCatchUp(e.trig, e.next, nowNs, e.missed)?
  if (plan.dropped) {
    // The dropped ticks are decided: log them once and step past them, so a
    // failed store pass below retries from the first tick it keeps.
    logTickDropped(q, e, plan, e.missed)
    e.next = plan.after
    if (len(plan.fire) > 0) {
      e.next = plan.fire[0]
    }
  }
  for tick of plan.fire {
    fireTick(q, e, tick, nowNs)?
    e.next = e.trig.nextAfterNs(tick)?
  }
  e.next = plan.after
}

fn runEntry(q: Queue, e: entry, nowNs: int): ()! {
  syncEntry(q, e, nowNs)?
  checkClock(q, e, nowNs)?
  if (e.next <= nowNs) {
    handleDue(q, e, nowNs)?
  }
}

// Compares this instance's clock with the locker's, at most once per
// `scheduleSkewCheckEvery` (a `nowNs` before the last check, a clock that
// stepped back, asks again). Sets `q.skewed` and logs it when that state
// changed; a failed read leaves the state as it was.
fn checkSkew(q: Queue, nowNs: int): ()! {
  let age = nowNs - q.skewAt
  if (q.skewKnown && age >= 0 && age < scheduleSkewCheckEvery) {
    return
  }
  let server = q.locker.serverNowNs()?
  q.skewAt = nowNs
  q.skewKnown = true
  let skew = nowNs - server
  if (skew < 0) {
    skew = 0 - skew
  }
  let bad = skew > scheduleMaxSkew
  if (bad == q.skewed) {
    return
  }
  q.skewed = bad
  if (bad) {
    logSkewed(q, skew)
    return
  }
  logSkewCleared(q)
}

// Whether this pass may fire ticks: true with no `Locker`, else when the
// clocks agree (`checkSkew`).
fn clocksAgree(q: Queue, nowNs: int): bool {
  if (q.locker == nil) {
    return true
  }
  checkSkew(q, nowNs) catch err {
    logClockUnreadable(q, err)
    return false
  }
  return !q.skewed
}

// One pass over every schedule at `nowNs`; returns the earliest tick still
// pending (0 when there are no schedules, or when the pass fired nothing
// because the clocks disagree or the check failed: `sleepFor` then waits one
// `pollInterval`). A failing schedule is logged
// and retried on the next pass, never allowed to stop the others.
fn runDue(q: Queue, nowNs: int): int {
  if (!clocksAgree(q, nowNs)) {
    return 0
  }
  let wake = 0
  for e of q.entries {
    runEntry(q, e, nowNs) catch err {
      logScheduleFailed(q, e, err)
    }
    if (wake == 0 || e.next < wake) {
      wake = e.next
    }
  }
  return wake
}

// How long to sleep after a pass ending at `nowNs`: until `wake`, but never
// longer than one `pollInterval`. A `wake` already in the past means a schedule just failed;
// waiting a full `pollInterval` is the retry backoff.
fn sleepFor(q: Queue, nowNs: int, wake: int): int {
  let d = wake - nowNs
  if (wake == 0 || d <= 0 || d > q.opts.pollInterval) {
    return q.opts.pollInterval
  }
  return d
}

// The scheduler's whole loop, run on its own green thread by `Queue.start`
// until `Queue.stop` clears `running`.
fn schedulerLoop(q: Queue) {
  while (q.running.load() == 1) {
    let wake = runDue(q, q.clock.nowNs())
    // Read the clock again: a slow pass must not be added to the next wake.
    q.clock.pause(sleepFor(q, q.clock.nowNs(), wake))
  }
  q.wg.done()
}
