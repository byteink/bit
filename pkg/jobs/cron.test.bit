// pkg/jobs/cron.test.bit — a table test for `parseCron`/`nextAfter`
// (cron.bit, #6083), including the two DST edges (spring gap, fall-back
// overlap) `zonedFromWall` (stdlib/time/zoned.bit) documents.

import { DateTime, Zone, Minute, Second, Timestamp, utc, zone, date } from "std/time"
import { join } from "std/strings"
import { data } from "std/tz"

// A wall-clock fixture: `y-mo-d h:mi:00`, grouped into one class so
// `mkDt` below stays under spec/LINT.md's parameter ceiling.
class wallSpec {
  y: int, mo: int, d: int, h: int, mi: int,
}

// Builds the wall-clock instant `w` in `z` — every test case below goes
// through this rather than chaining `date(...)?.atTime(...)?` inline, so a
// bad fixture panics with one clear message instead of three near-identical
// `catch` blocks per call site.
fn mkDt(w: wallSpec, z: Zone): DateTime {
  let dt = date(w.y, w.mo, w.d) catch e {
    panic("fixture date ${w.y}-${w.mo}-${w.d}: ${e.message()}")
  }
  let ndt = dt.atTime(w.h, w.mi, 0) catch e {
    panic("fixture time ${w.h}:${w.mi} on ${w.y}-${w.mo}-${w.d}: ${e.message()}")
  }
  return ndt.inZone(z)
}

class cronCase {
  expr: string,
  afterY: int, afterMo: int, afterD: int, afterH: int, afterMi: int,
  wantY: int, wantMo: int, wantD: int, wantH: int, wantMi: int,
}

// Every case below is checked in UTC unless noted; timezone edges get
// their own test below. `after*` is exclusive: `nextAfter` always returns
// a time strictly later than it.
fn cronCases(): []cronCase {
  return [
    // every minute
    cronCase{
      expr = "* * * * *",
      afterY = 2026, afterMo = 1, afterD = 1, afterH = 0, afterMi = 0,
      wantY = 2026, wantMo = 1, wantD = 1, wantH = 0, wantMi = 1,
    },
    // a fixed time daily
    cronCase{
      expr = "30 2 * * *",
      afterY = 2026, afterMo = 3, afterD = 1, afterH = 0, afterMi = 0,
      wantY = 2026, wantMo = 3, wantD = 1, wantH = 2, wantMi = 30,
    },
    // after today's slot has passed, rolls to tomorrow
    cronCase{
      expr = "30 2 * * *",
      afterY = 2026, afterMo = 3, afterD = 1, afterH = 3, afterMi = 0,
      wantY = 2026, wantMo = 3, wantD = 2, wantH = 2, wantMi = 30,
    },
    // a step: every 15 minutes
    cronCase{
      expr = "*/15 * * * *",
      afterY = 2026, afterMo = 1, afterD = 1, afterH = 10, afterMi = 7,
      wantY = 2026, wantMo = 1, wantD = 1, wantH = 10, wantMi = 15,
    },
    // a list of hours
    cronCase{
      expr = "0 9,13,18 * * *",
      afterY = 2026, afterMo = 1, afterD = 1, afterH = 10, afterMi = 0,
      wantY = 2026, wantMo = 1, wantD = 1, wantH = 13, wantMi = 0,
    },
    // a range with a step
    cronCase{
      expr = "0 8-18/2 * * *",
      afterY = 2026, afterMo = 1, afterD = 1, afterH = 9, afterMi = 0,
      wantY = 2026, wantMo = 1, wantD = 1, wantH = 10, wantMi = 0,
    },
    // month by name, rolls into next year
    cronCase{
      expr = "0 0 1 JAN *",
      afterY = 2026, afterMo = 6, afterD = 1, afterH = 0, afterMi = 0,
      wantY = 2027, wantMo = 1, wantD = 1, wantH = 0, wantMi = 0,
    },
    // day-of-week by name: next Monday at 09:00
    cronCase{
      expr = "0 9 * * MON",
      afterY = 2026, afterMo = 9, afterD = 30, afterH = 0, afterMi = 0, // a Wednesday
      wantY = 2026, wantMo = 10, wantD = 5, wantH = 9, wantMi = 0,
    },
    // dom OR dow once either is restricted: the 1st (a Thursday) beats
    // Friday the 2nd
    cronCase{
      expr = "0 0 1 * FRI",
      afterY = 2026, afterMo = 9, afterD = 30, afterH = 0, afterMi = 0, // a Wednesday
      wantY = 2026, wantMo = 10, wantD = 1, wantH = 0, wantMi = 0,
    },
    // Sunday spelled 7 folds onto 0
    cronCase{
      expr = "0 0 * * 7",
      afterY = 2026, afterMo = 9, afterD = 30, afterH = 0, afterMi = 0, // a Wednesday
      wantY = 2026, wantMo = 10, wantD = 4, wantH = 0, wantMi = 0,      // next Sunday
    },
  ]
}

test "cron parser table" {
  let z = utc()
  for c of cronCases() {
    let cs = parseCron(c.expr) catch e {
      panic("parse '${c.expr}': ${e.message()}")
    }
    let after = mkDt(
      wallSpec{ y = c.afterY, mo = c.afterMo, d = c.afterD, h = c.afterH, mi = c.afterMi },
      z,
    )
    let got = cs.nextAfter(after) catch e {
      panic("nextAfter '${c.expr}' after ${c.afterY}-${c.afterMo}-${c.afterD} ${c.afterH}:${c.afterMi}: ${e.message()}")
    }
    let want = "${c.wantY}-${c.wantMo}-${c.wantD} ${c.wantH}:${c.wantMi}"
    let gotStr = "${got.year()}-${got.month()}-${got.day()} ${got.hour()}-${got.minute()}"
    assert(
        got.year() == c.wantY &&
        got.month() == c.wantMo &&
        got.day() == c.wantD &&
        got.hour() == c.wantH &&
        got.minute() == c.wantMi,
      "'${c.expr}': want ${want}, got ${gotStr}",
    )
  }
}

test "an expression without exactly 5 fields fails" {
  parseCron("* * * *") catch _ {
    return
  }
  panic("'* * * *' (4 fields) should have failed")
}

test "an impossible day of month fails rather than looping forever" {
  let cs = parseCron("0 0 31 2 *") catch e {
    panic("parse: ${e.message()}")
  }
  let after = mkDt(wallSpec{ y = 2026, mo = 1, d = 1, h = 0, mi = 0 }, utc())
  cs.nextAfter(after) catch _ {
    return
  }
  panic("February 31st can never match; nextAfter should have failed")
}

// Fall-back overlap: Europe/London goes 01:59 BST -> 01:00 GMT on
// 2026-10-25, so 00:30 local happens once, unambiguously (it is before
// the overlap starts). Confirms a schedule entirely below the overlap
// ticks exactly once, then again the following day.
test "fall-back day: a schedule before the overlap ticks exactly once" {
  let z = zone("Europe/London") catch e {
    panic("zone: ${e.message()}")
  }
  let cs = parseCron("30 0 * * *") catch e {
    panic("parse: ${e.message()}")
  }
  let after = mkDt(wallSpec{ y = 2026, mo = 10, d = 24, h = 12, mi = 0 }, z)
  let first = cs.nextAfter(after) catch e {
    panic("nextAfter: ${e.message()}")
  }
  assert(
      first.year() == 2026 &&
      first.month() == 10 &&
      first.day() == 25 &&
      first.hour() == 0 &&
      first.minute() == 30,
    "first got ${first.year()}-${first.month()}-${first.day()} ${first.hour()}:${first.minute()}",
  )
  let second = cs.nextAfter(first) catch e {
    panic("nextAfter: ${e.message()}")
  }
  assert(second.day() == 26, "second occurrence should be the next day, got day ${second.day()}")
}

// The next `n` ticks of `expr` after the UTC instant `from`, read in the zone
// `zoneName`, as `DateTime.toString()` forms joined by spaces: the whole DST
// contract (cron.bit's header) is one string per case.
fn tickSeq(expr: string, zoneName: string, from: wallSpec, n: int): string {
  let z = zone(zoneName) catch e {
    panic("zone ${zoneName}: ${e.message()}")
  }
  let cs = parseCron(expr) catch e {
    panic("parse '${expr}': ${e.message()}")
  }
  let cur = mkDt(from, utc()).withZone(z)
  let out = ""
  let i = 0
  while (i < n) {
    cur = cs.nextAfter(cur) catch e {
      panic("nextAfter '${expr}' in ${zoneName}: ${e.message()}")
    }
    if (i > 0) {
      out = out + " "
    }
    out = out + cur.toString()
    i = i + 1
  }
  return out
}

fn wantTicks(expr: string, zoneName: string, from: wallSpec, n: int, want: string) {
  let got = tickSeq(expr, zoneName, from, n)
  assert(got == want, "'${expr}' in ${zoneName}: want [${want}], got [${got}]")
}

fn instantNs(dt: DateTime): int {
  let ts = dt.toTimestamp() catch e {
    panic("toTimestamp ${dt.toString()}: ${e.message()}")
  }
  return ts.ns
}

// Every minute across a transition must be exactly 60 s of real time apart:
// a repeated hour ticks twice, a skipped one not at all, and no tick is ever
// at or before the one it follows.
fn wantEveryMinute(zoneName: string, from: wallSpec, n: int) {
  let z = zone(zoneName) catch e {
    panic("zone ${zoneName}: ${e.message()}")
  }
  let cs = parseCron("* * * * *") catch e {
    panic("parse: ${e.message()}")
  }
  let cur = mkDt(from, utc()).withZone(z)
  let i = 0
  while (i < n) {
    let next = cs.nextAfter(cur) catch e {
      panic("nextAfter in ${zoneName}: ${e.message()}")
    }
    let gap = instantNs(next) - instantNs(cur)
    assert(
      gap == Minute,
      "${zoneName}: ${cur.toString()} -> ${next.toString()} is ${gap} ns, want one minute",
    )
    cur = next
    i = i + 1
  }
}

// America/New_York springs forward 02:00 EST -> 03:00 EDT at 2026-03-08 07:00Z.
test "spring gap, New York: a fixed time inside the gap runs once, at 03:00" {
  let from = wallSpec{ y = 2026, mo = 3, d = 8, h = 5, mi = 0 }
  wantTicks(
    "30 2 * * *",
    "America/New_York",
    from,
    2,
    "2026-03-08T03:00:00-04:00 2026-03-09T02:30:00-04:00",
  )
  wantTicks(
    "0 2 * * *",
    "America/New_York",
    from,
    2,
    "2026-03-08T03:00:00-04:00 2026-03-09T02:00:00-04:00",
  )
  let eve = wallSpec{ y = 2026, mo = 3, d = 7, h = 12, mi = 0 }
  wantTicks("30 2 * * *", "America/New_York", eve, 1, "2026-03-08T03:00:00-04:00")
}

test "spring gap, New York: two fixed times in the gap run once" {
  let from = wallSpec{ y = 2026, mo = 3, d = 8, h = 5, mi = 0 }
  wantTicks(
    "15,45 2 * * *",
    "America/New_York",
    from,
    2,
    "2026-03-08T03:00:00-04:00 2026-03-09T02:15:00-04:00",
  )
}

test "spring gap, New York: a real-time schedule has no ticks inside the gap" {
  let from = wallSpec{ y = 2026, mo = 3, d = 8, h = 6, mi = 58 }
  wantTicks(
    "* * * * *",
    "America/New_York",
    from,
    4,
    "2026-03-08T01:59:00-05:00 2026-03-08T03:00:00-04:00 2026-03-08T03:01:00-04:00 2026-03-08T03:02:00-04:00",
  )
  let hour = wallSpec{ y = 2026, mo = 3, d = 8, h = 6, mi = 0 }
  wantTicks(
    "0 * * * *",
    "America/New_York",
    hour,
    2,
    "2026-03-08T03:00:00-04:00 2026-03-08T04:00:00-04:00",
  )
}

// America/New_York falls back 02:00 EDT -> 01:00 EST at 2026-11-01 06:00Z.
test "fall-back overlap, New York: a fixed time in the repeated hour runs at its first occurrence" {
  let from = wallSpec{ y = 2026, mo = 11, d = 1, h = 4, mi = 0 }
  wantTicks(
    "30 1 * * *",
    "America/New_York",
    from,
    2,
    "2026-11-01T01:30:00-04:00 2026-11-02T01:30:00-05:00",
  )
  wantTicks(
    "0 1 * * *",
    "America/New_York",
    from,
    2,
    "2026-11-01T01:00:00-04:00 2026-11-02T01:00:00-05:00",
  )
  let eve = wallSpec{ y = 2026, mo = 10, d = 31, h = 12, mi = 0 }
  wantTicks(
    "30 1 * * SUN",
    "America/New_York",
    eve,
    2,
    "2026-11-01T01:30:00-04:00 2026-11-08T01:30:00-05:00",
  )
}

test "fall-back overlap, New York: from the second 01:30 the next tick is 01:31 EST, not EDT" {
  let second = wallSpec{ y = 2026, mo = 11, d = 1, h = 6, mi = 30 }
  wantTicks(
    "* * * * *",
    "America/New_York",
    second,
    2,
    "2026-11-01T01:31:00-05:00 2026-11-01T01:32:00-05:00",
  )
  wantTicks("30 1 * * *", "America/New_York", second, 1, "2026-11-02T01:30:00-05:00")
  let first = wallSpec{ y = 2026, mo = 11, d = 1, h = 5, mi = 30 }
  wantTicks("30 1 * * *", "America/New_York", first, 1, "2026-11-02T01:30:00-05:00")
}

test "fall-back overlap, New York: a real-time schedule ticks in both occurrences" {
  let late = wallSpec{ y = 2026, mo = 11, d = 1, h = 5, mi = 58 }
  wantTicks(
    "* * * * *",
    "America/New_York",
    late,
    3,
    "2026-11-01T01:59:00-04:00 2026-11-01T01:00:00-05:00 2026-11-01T01:01:00-05:00",
  )
  let hour = wallSpec{ y = 2026, mo = 11, d = 1, h = 4, mi = 0 }
  wantTicks(
    "0 * * * *",
    "America/New_York",
    hour,
    4,
    "2026-11-01T01:00:00-04:00 2026-11-01T01:00:00-05:00 2026-11-01T02:00:00-05:00 2026-11-01T03:00:00-05:00",
  )
  wantTicks(
    "*/30 1 * * *",
    "America/New_York",
    hour,
    5,
    "2026-11-01T01:00:00-04:00 2026-11-01T01:30:00-04:00 2026-11-01T01:00:00-05:00 2026-11-01T01:30:00-05:00 2026-11-02T01:00:00-05:00",
  )
}

// Europe/London springs forward 01:00 GMT -> 02:00 BST at 2026-03-29 01:00Z
// and falls back 02:00 BST -> 01:00 GMT at 2026-10-25 01:00Z.
test "spring gap, London: 01:30 does not exist, it runs once at 02:00" {
  let eve = wallSpec{ y = 2026, mo = 3, d = 28, h = 12, mi = 0 }
  wantTicks(
    "30 1 * * *",
    "Europe/London",
    eve,
    2,
    "2026-03-29T02:00:00+01:00 2026-03-30T01:30:00+01:00",
  )
  let late = wallSpec{ y = 2026, mo = 3, d = 29, h = 0, mi = 58 }
  wantTicks(
    "* * * * *",
    "Europe/London",
    late,
    3,
    "2026-03-29T00:59:00+00:00 2026-03-29T02:00:00+01:00 2026-03-29T02:01:00+01:00",
  )
}

test "fall-back overlap, London: a fixed 01:30 runs once, real-time schedules twice" {
  let from = wallSpec{ y = 2026, mo = 10, d = 24, h = 23, mi = 0 }
  wantTicks(
    "30 1 * * *",
    "Europe/London",
    from,
    2,
    "2026-10-25T01:30:00+01:00 2026-10-26T01:30:00+00:00",
  )
  wantTicks(
    "0 * * * *",
    "Europe/London",
    from,
    4,
    "2026-10-25T01:00:00+01:00 2026-10-25T01:00:00+00:00 2026-10-25T02:00:00+00:00 2026-10-25T03:00:00+00:00",
  )
  let late = wallSpec{ y = 2026, mo = 10, d = 25, h = 0, mi = 58 }
  wantTicks(
    "* * * * *",
    "Europe/London",
    late,
    3,
    "2026-10-25T01:59:00+01:00 2026-10-25T01:00:00+00:00 2026-10-25T01:01:00+00:00",
  )
}

// Havana changes at midnight: 00:00 CST -> 01:00 CDT on 2026-03-08 (05:00Z)
// and 01:00 CDT -> 00:00 CST on 2026-11-01 (05:00Z), so the gap and the
// repeated hour belong to the day that starts at the change.
test "a transition at midnight: Havana" {
  let spring = wallSpec{ y = 2026, mo = 3, d = 7, h = 12, mi = 0 }
  wantTicks(
    "30 0 * * *",
    "America/Havana",
    spring,
    2,
    "2026-03-08T01:00:00-04:00 2026-03-09T00:30:00-04:00",
  )
  let fall = wallSpec{ y = 2026, mo = 10, d = 31, h = 12, mi = 0 }
  wantTicks(
    "30 0 * * *",
    "America/Havana",
    fall,
    2,
    "2026-11-01T00:30:00-04:00 2026-11-02T00:30:00-05:00",
  )
}

test "every minute is exactly one minute after the last across every transition" {
  wantEveryMinute("America/New_York", wallSpec{ y = 2026, mo = 3, d = 8, h = 5, mi = 0 }, 300)
  wantEveryMinute("America/New_York", wallSpec{ y = 2026, mo = 11, d = 1, h = 4, mi = 0 }, 300)
  wantEveryMinute("Europe/London", wallSpec{ y = 2026, mo = 10, d = 24, h = 23, mi = 0 }, 300)
  wantEveryMinute("America/Havana", wallSpec{ y = 2026, mo = 11, d = 1, h = 3, mi = 0 }, 300)
  // Lord Howe shifts by 30 minutes, not 60.
  wantEveryMinute("Australia/Lord_Howe", wallSpec{ y = 2026, mo = 4, d = 4, h = 13, mi = 0 }, 300)
  wantEveryMinute("Australia/Lord_Howe", wallSpec{ y = 2026, mo = 10, d = 3, h = 13, mi = 30 }, 300)
}

// The newest tick of `expr` at or before the UTC instant `from`, read in the
// zone `zoneName`, as a `DateTime.toString()` form.
fn prevTick(expr: string, zoneName: string, from: wallSpec): string {
  let z = zone(zoneName) catch e {
    panic("zone ${zoneName}: ${e.message()}")
  }
  let cs = parseCron(expr) catch e {
    panic("parse '${expr}': ${e.message()}")
  }
  let got = cs.prevAtOrBefore(mkDt(from, utc()).withZone(z)) catch e {
    panic("prevAtOrBefore '${expr}' in ${zoneName}: ${e.message()}")
  }
  return got.toString()
}

fn wantPrev(expr: string, zoneName: string, from: wallSpec, want: string) {
  let got = prevTick(expr, zoneName, from)
  assert(got == want, "'${expr}' in ${zoneName}: want [${want}], got [${got}]")
}

test "prevAtOrBefore: a tick is at or before itself, a minute later finds the same tick" {
  let at = wallSpec{ y = 2026, mo = 5, d = 4, h = 9, mi = 30 }
  wantPrev("*/15 * * * *", "UTC", at, "2026-05-04T09:30:00+00:00")
  let later = wallSpec{ y = 2026, mo = 5, d = 4, h = 9, mi = 44 }
  wantPrev("*/15 * * * *", "UTC", later, "2026-05-04T09:30:00+00:00")
}

test "prevAtOrBefore: crosses days, months and years" {
  let jan = wallSpec{ y = 2026, mo = 1, d = 1, h = 0, mi = 10 }
  wantPrev("0 23 * * *", "UTC", jan, "2025-12-31T23:00:00+00:00")
  // Day-of-month OR day-of-week: the 13th or any Friday.
  let mar = wallSpec{ y = 2026, mo = 3, d = 12, h = 12, mi = 0 }
  wantPrev("0 0 13 * 5", "UTC", mar, "2026-03-06T00:00:00+00:00")
  let apr = wallSpec{ y = 2026, mo = 4, d = 1, h = 0, mi = 0 }
  wantPrev("0 0 31 * *", "UTC", apr, "2026-03-31T00:00:00+00:00")
}

test "prevAtOrBefore: a leap day is found eight years back at most" {
  let at = wallSpec{ y = 2026, mo = 6, d = 1, h = 0, mi = 0 }
  wantPrev("0 0 29 2 *", "UTC", at, "2024-02-29T00:00:00+00:00")
  let gap = wallSpec{ y = 2103, mo = 6, d = 1, h = 0, mi = 0 }
  wantPrev("0 0 29 2 *", "UTC", gap, "2096-02-29T00:00:00+00:00")
}

test "prevAtOrBefore: an impossible expression fails rather than looping" {
  let cs = parseCron("0 0 31 2 *") catch e {
    panic("parse: ${e.message()}")
  }
  let failed = false
  cs.prevAtOrBefore(mkDt(wallSpec{ y = 2026, mo = 6, d = 1, h = 0, mi = 0 }, utc())) catch _ {
    failed = true
  }
  assert(failed, "a schedule that never matches must fail, not return a tick")
}

test "prevAtOrBefore, spring gap, New York: a fixed time in the gap ran at 03:00, and not before" {
  // 2026-03-08 07:00Z is 03:00 EDT, the first instant after the gap.
  let gapEnd = wallSpec{ y = 2026, mo = 3, d = 8, h = 7, mi = 0 }
  wantPrev("30 2 * * *", "America/New_York", gapEnd, "2026-03-08T03:00:00-04:00")
  let before = wallSpec{ y = 2026, mo = 3, d = 8, h = 6, mi = 59 }
  wantPrev("30 2 * * *", "America/New_York", before, "2026-03-07T02:30:00-05:00")
  let later = wallSpec{ y = 2026, mo = 3, d = 8, h = 16, mi = 0 }
  wantPrev("30 2 * * *", "America/New_York", later, "2026-03-08T03:00:00-04:00")
}

test "prevAtOrBefore, spring gap, New York: a real-time schedule has no tick in the gap" {
  let gapEnd = wallSpec{ y = 2026, mo = 3, d = 8, h = 7, mi = 0 }
  wantPrev("30 * * * *", "America/New_York", gapEnd, "2026-03-08T01:30:00-05:00")
  wantPrev("0 * * * *", "America/New_York", gapEnd, "2026-03-08T03:00:00-04:00")
}

test "prevAtOrBefore, fall-back overlap, New York: a fixed time ticked at its first occurrence" {
  // 01:30 EDT is 05:30Z; the repeated 01:30 EST is 06:30Z.
  let second = wallSpec{ y = 2026, mo = 11, d = 1, h = 6, mi = 30 }
  wantPrev("30 1 * * *", "America/New_York", second, "2026-11-01T01:30:00-04:00")
  let after = wallSpec{ y = 2026, mo = 11, d = 1, h = 7, mi = 30 }
  wantPrev("30 1 * * *", "America/New_York", after, "2026-11-01T01:30:00-04:00")
  let first = wallSpec{ y = 2026, mo = 11, d = 1, h = 5, mi = 30 }
  wantPrev("30 1 * * *", "America/New_York", first, "2026-11-01T01:30:00-04:00")
  let eve = wallSpec{ y = 2026, mo = 11, d = 1, h = 5, mi = 29 }
  wantPrev("30 1 * * *", "America/New_York", eve, "2026-10-31T01:30:00-04:00")
}

test "prevAtOrBefore, fall-back overlap, New York: a real-time schedule ticks in both occurrences" {
  let second = wallSpec{ y = 2026, mo = 11, d = 1, h = 6, mi = 30 }
  wantPrev("30 * * * *", "America/New_York", second, "2026-11-01T01:30:00-05:00")
  let mid = wallSpec{ y = 2026, mo = 11, d = 1, h = 6, mi = 10 }
  wantPrev("30 * * * *", "America/New_York", mid, "2026-11-01T01:30:00-04:00")
}

test "prevAtOrBefore, a transition at midnight: Havana" {
  let spring = wallSpec{ y = 2026, mo = 3, d = 8, h = 12, mi = 0 }
  wantPrev("30 0 * * *", "America/Havana", spring, "2026-03-08T01:00:00-04:00")
  let fall = wallSpec{ y = 2026, mo = 11, d = 1, h = 12, mi = 0 }
  wantPrev("30 0 * * *", "America/Havana", fall, "2026-11-01T00:30:00-04:00")
}

// CRON'S PER-DAY OFFSET TEST IS A CHECKED INVARIANT (#6367). `cronSearchDay`
// and `cronSearchDayLast` (cron.bit) take the wall-clock search on a day
// whose offset is the same one second before its first and its next midnight,
// which is exact only while the day holds at most ONE offset change: two
// that cancel would look like no change at all. `std/time` exposes no
// transition list to ask at run time, so the bundled database (`std/tz`) is
// read here instead, straight from its TZif images, and every zone is checked
// over the next thirty years (2026-01-01 .. 2056-01-01, fixed so the test is
// deterministic). A tzdata update that puts two changes in one local day
// fails this test naming the zone and the date. The TZif tables end in 2037;
// later years are the footer rule, which std/time does not read either, so
// no offset change exists to check after it.
const cronDayChangeLimit: int = 1
const cronZoneWindowLo: int = 1767225600
const cronZoneWindowHi: int = 2713910400
const cronDaySecs: int = 86400

// One offset change of a zone: at UTC second `at` the offset went from
// `before` to `after` seconds.
class zoneChange {
  at: int,
  before: int,
  after: int,
}

fn tzBe32(b: []byte, p: int): int {
  return (int(b[p]) << 24) | (int(b[p + 1]) << 16) | (int(b[p + 2]) << 8) | int(b[p + 3])
}

fn tzBe32s(b: []byte, p: int): int {
  let v = tzBe32(b, p)
  if (v >= 2147483648) {
    return v - 4294967296
  }
  return v
}

// A big-endian two's complement int64.
fn tzBe64s(b: []byte, p: int): int {
  return (tzBe32s(b, p) << 32) | tzBe32(b, p + 4)
}

// `floor(a / b)` for positive `b`; plain `/` truncates toward zero.
fn tzFloorDiv(a: int, b: int): int {
  let q = a / b
  if (q * b > a) {
    return q - 1
  }
  return q
}

// The six counts of the TZif header at `base` (RFC 8536 section 3.1), in file
// order: isutcnt, isstdcnt, leapcnt, timecnt, typecnt, charcnt.
fn tzCounts(b: []byte, base: int): []int {
  let out = []int(6)
  let i = 0
  while (i < 6) {
    out[i] = tzBe32(b, base + 20 + 4 * i)
    i = i + 1
  }
  return out
}

// Where the version 2 header starts: past the 44-byte version 1 header and
// the version 1 block, whose times are 4 bytes wide.
fn tzV2Base(b: []byte): int {
  let c = tzCounts(b, 0)
  return 44 + c[3] * 5 + c[4] * 6 + c[5] + c[2] * 8 + c[1] + c[0]
}

// The offset changes of the TZif image `img` (version 2 or later), in time
// order. A transition between two types of the same offset (an abbreviation
// change) is not an offset change and is left out.
fn tzChanges(img: []byte): []zoneChange {
  assert(len(img) > 44 && string(img[0:4]) == "TZif" && img[4] >= '2', "not a version 2 TZif image")
  let base = tzV2Base(img)
  let c = tzCounts(img, base)
  let timeAt = base + 44
  let typeAt = timeAt + c[3] * 8
  let infoAt = typeAt + c[3]
  assert(infoAt + c[4] * 6 <= len(img), "TZif image shorter than its own counts")
  let out = []zoneChange(0)
  let prev = tzBe32s(img, infoAt)
  let i = 0
  while (i < c[3]) {
    let ty = int(img[typeAt + i])
    assert(ty < c[4], "TZif transition type out of range")
    let now = tzBe32s(img, infoAt + ty * 6)
    if (now != prev) {
      out = append(out, zoneChange{ at = tzBe64s(img, timeAt + i * 8), before = prev, after = now })
    }
    prev = now
    i = i + 1
  }
  return out
}

// The local calendar day, as a day number, that the wall clock reads one
// second before change `c` and at it (two different days when the change
// crosses midnight).
fn tzDaysOf(c: zoneChange): []int {
  return [
    tzFloorDiv(c.at - 1 + c.before, cronDaySecs),
    tzFloorDiv(c.at + c.after, cronDaySecs),
  ]
}

// The first local day inside the window holding more than `limit` of
// `changes`, as `(day number, count)`; `(0, 0)` when none does.
fn tzCrowdedDay(changes: []zoneChange, limit: int): (int, int) {
  let per = map<int, int>()
  for c of changes {
    if (c.at < cronZoneWindowLo || c.at >= cronZoneWindowHi) {
      continue
    }
    let days = tzDaysOf(c)
    let n = 0
    while (n < 2) {
      if (n == 0 || days[1] != days[0]) {
        per[days[n]] = per[days[n]] + 1
        if (per[days[n]] > limit) {
          return (days[n], per[days[n]])
        }
      }
      n = n + 1
    }
  }
  return (0, 0)
}

// `name`'s TZif image in the `std/tz` blob, whose layout stdlib/time/extend.bit
// documents: an 8-byte magic, a u32 zone count, then per zone a u16 name
// length, the name, and a u32 offset and length into the blob.
class tzEntry {
  name: string,
  img: []byte,
}

fn tzEntries(blob: []byte): []tzEntry {
  assert(len(blob) > 12 && blob[0] == 'B' && blob[7] == 1, "std/tz data: bad magic or version")
  let count = tzBe32(blob, 8)
  let out = []tzEntry(0)
  let pos = 12
  let i = 0
  while (i < count) {
    let nameLen = (int(blob[pos]) << 8) | int(blob[pos + 1])
    let name = string(blob[pos + 2:pos + 2 + nameLen])
    let at = pos + 2 + nameLen
    let off = tzBe32(blob, at)
    let length = tzBe32(blob, at + 4)
    out = append(out, tzEntry{ name = name, img = blob[off:off + length] })
    pos = at + 8
    i = i + 1
  }
  return out
}

// `dayNo` read as a date: the UTC reading of its first instant.
fn tzDayName(dayNo: int): string {
  return Timestamp{ ns = dayNo * cronDaySecs * Second }.inZone(utc()).toString()
}

// The zones of `std/tz` with a crowded day, each as a finding naming the zone
// and the date.
fn tzFindings(limit: int): []string {
  let out = []string(0)
  for e of tzEntries([]byte(data)) {
    let (day, n) = tzCrowdedDay(tzChanges(e.img), limit)
    if (n > 0) {
      out = append(out, "${e.name}: ${n} offset changes on local day ${tzDayName(day)}")
    }
  }
  return out
}

test "no zone in the bundled tz data changes offset twice in one local day, 2026 to 2056" {
  let found = tzFindings(cronDayChangeLimit)
  assert(len(found) == 0, "cron's per-day offset test is unsound for: ${join(found, "; ")}")
}

test "the per-day scan sees the zones and their changes: limit 0 reports them" {
  // The check above passing means nothing unless the same scan can fail: with
  // no change allowed per day, every zone that has one in the window is named.
  let found = tzFindings(0)
  assert(len(tzEntries([]byte(data))) > 500, "std/tz lists fewer than 500 zones")
  assert(
    len(found) > 100,
    "limit 0 named only ${len(found)} zones, want the zones that change offset",
  )
  let want = "America/New_York: 1 offset changes on local day 2026-03-08T00:00:00+00:00"
  let seen = false
  for f of found {
    if (f == want) {
      seen = true
    }
  }
  assert(seen, "limit 0 did not report [${want}]")
}

test "two changes that cancel within one local day are found, and so are two across midnight" {
  let day = 1800000000
  let cancel = [
    zoneChange{ at = day, before = 0, after = 3600 },
    zoneChange{ at = day + 1800, before = 3600, after = 0 },
  ]
  let (d, n) = tzCrowdedDay(cancel, 1)
  assert(
    n == 2 && d == tzFloorDiv(day + 3600, cronDaySecs),
    "cancelling pair: got day ${d} count ${n}",
  )
  let apart = [
    zoneChange{ at = day, before = 0, after = 3600 },
    zoneChange{ at = day + 3 * cronDaySecs, before = 3600, after = 0 },
  ]
  let (_, m) = tzCrowdedDay(apart, 1)
  assert(m == 0, "changes three days apart were reported as one day")
  // Havana-style: the first change carries the wall clock from 23:59:59 over
  // midnight to 01:00, so it touches two days, and the change an hour later
  // lands on the second of them. `mid` is a local midnight (a multiple of a day).
  let mid = 1796083200
  let across = [
    zoneChange{ at = mid + 18000, before = -18000, after = -14400 },
    zoneChange{ at = mid + 21600, before = -14400, after = -18000 },
  ]
  let (_, k) = tzCrowdedDay(across, 1)
  assert(k == 2, "two changes an hour apart were not found on one day: ${k}")
}
