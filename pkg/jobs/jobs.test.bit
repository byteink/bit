// pkg/jobs/jobs.test.bit — unit coverage for register/enqueue, retry with
// backoff, dead-letter, an unknown name, a panicking handler, and a
// worker-pool drain, all against `fakeStore` (no real server — the live
// gate, `_tests_/bit/jobslive.bit`, covers the same shapes against real
// PostgreSQL).

import { Mutex } from "std/sync"
import { contains } from "std/strings"
import { jsonAsObject } from "std/json"

@job("test-echo") @json class EchoJob {
  message: string,
}

@job("test-boom") @json class BoomJob {
  reason: string,
}

class fakeRow {
  id: int,
  name: string,
  payload: string,
  attempts: int,
  maxAttempts: int,
  availableAt: int,
  done: bool,
  deadLettered: bool,
  deadReason: string,
}

// A minimal in-memory Store: linear scan, one Mutex, no persistence — fine
// for these unit tests, never a production store (store.bit's header: no
// default). `claim` leases a row the way postgres.bit's `claimOneLocked`
// does: it pushes `availableAt` out by `visibilityTimeout`, so a claimed row
// is invisible to the next `claim` until it completes or the lease lapses.
// Without that, a second worker re-claims a row the first is still running
// (#5812: 14 completions of 10 jobs at BIT_WORKERS=4).
class fakeStore {
  rows: []fakeRow
  mu: Mutex
  nextId: int

  enqueue(name: string, payload: string, availableAt: int, maxAttempts: int): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    this.nextId = this.nextId + 1
    this.rows = append(
      this.rows,
      fakeRow{
        id = this.nextId, name = name, payload = payload, attempts = 0,
        maxAttempts = maxAttempts, availableAt = availableAt, done = false,
        deadLettered = false, deadReason = "",
      },
    )
  }

  claim(visibilityTimeout: int): Option<ClaimedJob>! {
    this.mu.lock()
    defer this.mu.unlock()
    let nowNs = now().ns
    let i = 0
    while (i < len(this.rows)) {
      let r = this.rows[i]
      if (!r.done && !r.deadLettered && r.availableAt <= nowNs) {
        r.attempts = r.attempts + 1
        r.availableAt = nowNs + visibilityTimeout
        this.rows[i] = r
        return Option.Some(
          ClaimedJob{
            id = r.id,
            name = r.name,
            payload = r.payload,
            attempts = r.attempts,
            maxAttempts = r.maxAttempts,
          },
        )
      }
      i = i + 1
    }
    return Option.None
  }

  complete(id: int): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    let i = this.indexOf(id)
    if (i < 0) {
      fail newError("fakeStore: complete: no row ${id}")
    }
    let r = this.rows[i]
    r.done = true
    this.rows[i] = r
  }

  retry(id: int, availableAt: int): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    let i = this.indexOf(id)
    if (i < 0) {
      fail newError("fakeStore: retry: no row ${id}")
    }
    let r = this.rows[i]
    r.availableAt = availableAt
    this.rows[i] = r
  }

  deadLetter(id: int, reason: string): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    let i = this.indexOf(id)
    if (i < 0) {
      fail newError("fakeStore: deadLetter: no row ${id}")
    }
    let r = this.rows[i]
    r.deadLettered = true
    r.deadReason = reason
    this.rows[i] = r
  }

  // Unlocked: every caller above already holds this.mu.
  indexOf(id: int): int {
    let i = 0
    while (i < len(this.rows)) {
      if (this.rows[i].id == id) {
        return i
      }
      i = i + 1
    }
    return -1
  }

  byId(id: int): fakeRow {
    this.mu.lock()
    defer this.mu.unlock()
    return this.rows[this.indexOf(id)]
  }
}

fn newFakeStore(): fakeStore {
  return fakeStore{ rows = []fakeRow(0), mu = Mutex(), nextId = 0 }
}

fn newTestQueue(store: Store): Queue {
  return open(store, Options{ workers = 1 }) catch e {
    panic("open: ${e.message()}")
  }
}

// Also the reason this module imports `Json` (jobs.bit) is a genuine one,
// not just to satisfy `@job`'s own `@json` requirement (E0142): `enqueue`'s
// payload is asserted here to be the `{"message": "hi"}` object `toJson()`
// produced, entry by entry.
test "enqueue then a successful handler completes the row" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  let seen: []string = []string(0)
  q.register<EchoJob>((job: EchoJob) => {
    seen = append(seen, job.message)
  })
  q.enqueue(EchoJob{ message = "hi" }) catch e {
    panic("enqueue: ${e.message()}")
  }
  let entries: Option<[]JsonEntry> = jsonAsObject(
    jsonParse(store.byId(1).payload) catch e {
      panic("parse payload: ${e.message()}")
    },
  )
  match (entries) {
    None => panic("payload is not a JSON object")
    Some(fields) => {
      assert(len(fields) == 1, "expected 1 field, got ${len(fields)}")
      assert(fields[0].key == "message", "field key '${fields[0].key}'")
      match (fields[0].value) {
        JsonString(s) => assert(s == "hi", "field value '${s}'")
        _ => panic("message field is not a JsonString")
      }
    }
  }
  let claimed = store.claim(30000000000) catch e {
    panic("claim: ${e.message()}")
  }
  match (claimed) {
    None => panic("expected a claimable row")
    Some(cj) => processOne(q, cj, newWorkerRand())
  }
  assert(len(seen) == 1 && seen[0] == "hi", "handler did not observe the payload")
  assert(store.byId(1).done, "row was not marked complete")
}

test "a failed handler with attempts remaining is retried, not dead-lettered" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  q.register<BoomJob>((job: BoomJob) => {
    fail newError(job.reason)
  })
  q.enqueue(BoomJob{ reason = "boom" }, 0, 3) catch e {
    panic("enqueue: ${e.message()}")
  }
  let claimed = store.claim(30000000000) catch e {
    panic("claim: ${e.message()}")
  }
  match (claimed) {
    None => panic("expected a claimable row")
    Some(cj) => processOne(q, cj, newWorkerRand())
  }
  let row = store.byId(1)
  assert(!row.deadLettered, "row was dead-lettered with attempts remaining")
  assert(!row.done, "a failed job must not be marked complete")
  assert(row.availableAt > 0, "retry did not set a new availableAt")
}

test "a failed handler out of attempts is dead-lettered with the failure reason" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  q.register<BoomJob>((job: BoomJob) => {
    fail newError(job.reason)
  })
  q.enqueue(BoomJob{ reason = "last try" }, 0, 1) catch e {
    panic("enqueue: ${e.message()}")
  }
  let claimed = store.claim(30000000000) catch e {
    panic("claim: ${e.message()}")
  }
  match (claimed) {
    None => panic("expected a claimable row")
    Some(cj) => processOne(q, cj, newWorkerRand())
  }
  let row = store.byId(1)
  assert(row.deadLettered, "row was not dead-lettered after its only attempt")
  assert(row.deadReason == "last try", "dead-letter reason was '${row.deadReason}'")
}

test "a PermanentFailure dead-letters at once with attempts remaining" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  q.register<BoomJob>((job: BoomJob) => {
    fail PermanentFailure{ reason = job.reason }
  })
  q.enqueue(BoomJob{ reason = "refused for good" }, 0, 5) catch e {
    panic("enqueue: ${e.message()}")
  }
  let claimed = store.claim(30000000000) catch e {
    panic("claim: ${e.message()}")
  }
  match (claimed) {
    None => panic("expected a claimable row")
    Some(cj) => {
      assert(cj.attempts == 1 && cj.maxAttempts == 5, "attempts ${cj.attempts} of ${cj.maxAttempts}")
      processOne(q, cj, newWorkerRand())
    }
  }
  let row = store.byId(1)
  assert(row.deadLettered, "a PermanentFailure was not dead-lettered")
  assert(row.deadReason == "refused for good", "dead-letter reason was '${row.deadReason}'")
  assert(!row.done, "a dead-lettered job must not be marked complete")
}

test "a panicking handler is caught and counted as a failure" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  q.register<BoomJob>((job: BoomJob) => {
    panic(job.reason)
  })
  q.enqueue(BoomJob{ reason = "panic-reason" }, 0, 1) catch e {
    panic("enqueue: ${e.message()}")
  }
  let claimed = store.claim(30000000000) catch e {
    panic("claim: ${e.message()}")
  }
  match (claimed) {
    None => panic("expected a claimable row")
    Some(cj) => processOne(q, cj, newWorkerRand())
  }
  let row = store.byId(1)
  assert(row.deadLettered, "a panicking handler's job was not dead-lettered")
  assert(row.deadReason == "panic-reason", "dead-letter reason was '${row.deadReason}'")
}

test "a job whose name has no registered handler is dead-lettered loudly" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  q.enqueue(EchoJob{ message = "orphan" }) catch e {
    panic("enqueue: ${e.message()}")
  }
  let claimed = store.claim(30000000000) catch e {
    panic("claim: ${e.message()}")
  }
  match (claimed) {
    None => panic("expected a claimable row")
    Some(cj) => processOne(q, cj, newWorkerRand())
  }
  let row = store.byId(1)
  assert(row.deadLettered, "an unregistered job name was not dead-lettered")
}

test "Options.workers must be positive" {
  let store = newFakeStore()
  let _ = open(store, Options{ workers = 0 }) catch e {
    assert(contains(e.message(), "workers"), "wrong error: ${e.message()}")
    return
  }
  panic("open succeeded with workers = 0")
}

// The error `open` returns for `opts`, or "" when it accepts them.
fn openError(opts: Options): string {
  let _ = open(newFakeStore(), opts) catch e {
    return e.message()
  }
  return ""
}

test "open rejects a non-positive pollInterval and visibilityTimeout, naming the value" {
  assert(
    openError(Options{ pollInterval = 0 }) == "jobs: Options.pollInterval must be positive, got 0",
    "pollInterval = 0: ${openError(Options{ pollInterval = 0 })}",
  )
  assert(
      openError(Options{ pollInterval = -5 }) ==
      "jobs: Options.pollInterval must be positive, got -5",
    "pollInterval = -5: ${openError(Options{ pollInterval = -5 })}",
  )
  assert(
      openError(Options{ visibilityTimeout = 0 }) ==
      "jobs: Options.visibilityTimeout must be positive, got 0",
    "visibilityTimeout = 0: ${openError(Options{ visibilityTimeout = 0 })}",
  )
  assert(openError(Options{}) == "", "the defaults must open: ${openError(Options{})}")
}

test "open rejects a locker that keeps fewer than 1 lease row, naming the count" {
  let locker = newFakeLocker()
  locker.keep = 0
  assert(
      openError(Options{ locker = locker }) ==
      "jobs: the locker keeps 0 lease row(s) per schedule; it must keep at least 1 (PostgresLocker(keep = ...))",
    "keep = 0: ${openError(Options{ locker = locker })}",
  )
  locker.keep = 1
  assert(openError(Options{ locker = locker }) == "", "a window of 1 must open")
}

// The error `q.every(Minute, ..., missed)` returns, or "" when it accepts.
fn everyError(q: Queue, missed: Missed): string {
  q.every(1000000000, TickJob{ tag = "g" }, missed = missed) catch e {
    return e.message()
  }
  return ""
}

test "RunAll(n) with n below 1 is refused at registration, naming n" {
  let q = queueOn(newFakeStore(), newFakeClock(t0), nil, "a")
  assert(
    everyError(q, Missed.RunAll(0)) == "jobs: Missed.RunAll cap must be at least 1, got 0",
    "RunAll(0) via every: ${everyError(q, Missed.RunAll(0))}",
  )
  let err = ""
  q.schedule("0 2 * * *", TickJob{ tag = "g" }, missed = Missed.RunAll(-3)) catch e {
    err = e.message()
  }
  assert(
    err == "jobs: Missed.RunAll cap must be at least 1, got -3",
    "RunAll(-3) via schedule: ${err}",
  )
  assert(everyError(q, Missed.RunAll(1)) == "", "RunAll(1) must be accepted")
}

test "RunAll(n) above the locker's lease window is refused, at the window accepted" {
  let locker = newFakeLocker()
  locker.keep = 10
  let q = queueOn(newFakeStore(), newFakeClock(t0), locker, "a")
  assert(
      everyError(q, Missed.RunAll(11)) ==
      "jobs: Missed.RunAll(11) exceeds the locker's lease window of 10; raise PostgresLocker(keep = ...)",
    "RunAll(11) over a window of 10: ${everyError(q, Missed.RunAll(11))}",
  )
  assert(everyError(q, Missed.RunAll(10)) == "", "RunAll(10) fits a window of 10")
}

test "without a locker there is no lease window to exceed" {
  let q = queueOn(newFakeStore(), newFakeClock(t0), nil, "a")
  assert(everyError(q, Missed.RunAll(100000)) == "", "RunAll must not be capped without a locker")
}

test "schedule and every after start() are refused, naming the schedule" {
  let q = queueOn(newFakeStore(), newFakeClock(t0), nil, "a")
  q.start()
  let first = everyError(q, Missed.Skip)
  let second = ""
  q.schedule("0 2 * * *", TickJob{ tag = "g" }) catch e {
    second = e.message()
  }
  q.stop()
  assert(
      first ==
      "jobs: schedule 'test-tick|every 1000000000|UTC' registered after start(); register schedules before start() or run()",
    "every after start: ${first}",
  )
  assert(
      second ==
      "jobs: schedule 'test-tick|0 2 * * *|UTC' registered after start(); register schedules before start() or run()",
    "schedule after start: ${second}",
  )
}

// Two workers against ten jobs: every job completes exactly once, and no
// job is ever claimed by both workers at once — `fakeStore.claim`'s Mutex
// is the same exclusion `postgres.bit`'s `FOR UPDATE SKIP LOCKED` gives a
// real database.
test "concurrency: N workers process every job exactly once" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  let processed = AtomicI64(0)
  q.register<EchoJob>((job: EchoJob) => {
    processed.add(1)
  })
  let n = 10
  let i = 0
  while (i < n) {
    q.enqueue(EchoJob{ message = "job-${i}" }) catch e {
      panic("enqueue: ${e.message()}")
    }
    i = i + 1
  }
  let pool = open(store, Options{ workers = 3, pollInterval = 5 * Millisecond }) catch e {
    panic("open: ${e.message()}")
  }
  pool.register<EchoJob>((job: EchoJob) => {
    processed.add(1)
  })
  pool.start()
  let waited = 0
  while (processed.load() < n && waited < 2000) {
    sleep(5 * Millisecond)
    waited = waited + 5
  }
  pool.stop()
  assert(processed.load() == n, "expected exactly ${n} completions, got ${processed.load()}")
  let i2 = 0
  while (i2 < n) {
    assert(store.byId(i2 + 1).done, "row ${i2 + 1} was never marked complete")
    i2 = i2 + 1
  }
}

// stop() must not return while a claimed job is still running.
test "stop() drains: an in-flight job finishes before stop returns" {
  let store = newFakeStore()
  let q = newTestQueue(store)
  let started = AtomicI64(0)
  let finished = AtomicI64(0)
  q.register<EchoJob>((job: EchoJob) => {
    started.store(1)
    sleep(50 * Millisecond)
    finished.store(1)
  })
  q.enqueue(EchoJob{ message = "slow" }) catch e {
    panic("enqueue: ${e.message()}")
  }
  q.start()
  let waited = 0
  while (started.load() == 0 && waited < 2000) {
    sleep(2 * Millisecond)
    waited = waited + 2
  }
  assert(started.load() == 1, "handler never started")
  q.stop()
  assert(finished.load() == 1, "stop() returned before the in-flight job finished")
}
