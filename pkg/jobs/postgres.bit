// pkg/jobs/postgres.bit — a `Store` (store.bit) backed by a `std/sql.Pool`,
// using PostgreSQL's `SELECT ... FOR UPDATE SKIP LOCKED` so N workers
// polling concurrently never claim the same row (#6082, epic #4023).
//
// `Pool`, NOT `pkg/postgres` DIRECTLY. `PostgresStore` is Postgres-specific
// SQL (`FOR UPDATE SKIP LOCKED`, `BIGSERIAL`), but it takes a `std/sql.Pool`
// — the application builds one with `pool(adapter(), Datasource{...})`
// (pkg/postgres's own README) and hands it in. `_tests_/bit/jobslive.bit`'s
// live tests are what actually pull in `pkg/postgres` to build a real one.
//
// TRANSACTIONS GO THROUGH `txValue`, NEVER `Pool.begin` DIRECTLY —
// `Pool.begin` is unexported by design (#3979, stdlib/sql/tx.bit's own
// header): every `?` between a hand-written `begin` and `commit` is an
// early return that skips the rollback and leaks the pooled connection.
// `txValue<T>(db, f)` commits on a normal return and rolls back on failure
// OR a panic, with no way to forget either.
//
// ONE QUERY FOR BOTH "ready" AND "abandoned" (store.bit's header): `claim`'s
// `WHERE` clause accepts a row that is either newly available
// (`claimed_until <= now`, true for a never-claimed row whose default is 0)
// or a stale claim whose visibility window elapsed — a worker-crash
// re-claim needs no separate method or schedule, just the same predicate
// evaluated on the next poll.

import { Pool, Tx, Rows, Value, asInt, asText, txValue } from "std/sql"
import { lastIndexOf } from "std/strings"

// Run once against a fresh database before a `PostgresStore` is used. A
// LIST, not one multi-statement string: Postgres's extended protocol (what
// every `std/sql` driver call goes through) refuses more than one command
// per prepared statement, so `migrate` below runs each entry as its own
// `exec`. A list also means neither this file nor an application running
// these by hand has to split on `;` — fragile the moment a future
// statement's own text ever contains one (a string literal, a comment).
// Not run by this package itself: the application controls its own
// migration tooling and ordering.
// A `[]string` is a reference type and cannot be a top-level `const`
// (SPEC §11.11: module-level state holds only untraced scalars) — a
// function returning a fresh slice each call is the ordinary alternative,
// the same shape `defaultOptions()`-style constructors use elsewhere.
export fn migrationStatements(): []string {
  return [
      "CREATE TABLE IF NOT EXISTS bit_jobs (\n" +
      "  id BIGSERIAL PRIMARY KEY,\n" +
      "  name TEXT NOT NULL,\n" +
      "  payload TEXT NOT NULL,\n" +
      "  attempts BIGINT NOT NULL DEFAULT 0,\n" +
      "  max_attempts BIGINT NOT NULL,\n" +
      "  available_at BIGINT NOT NULL,\n" +
      "  claimed_until BIGINT NOT NULL DEFAULT 0,\n" +
      "  done BOOLEAN NOT NULL DEFAULT FALSE,\n" +
      "  dead_lettered BOOLEAN NOT NULL DEFAULT FALSE,\n" +
      "  dead_reason TEXT NOT NULL DEFAULT ''\n" +
      ")",
      "CREATE INDEX IF NOT EXISTS bit_jobs_claimable ON bit_jobs (available_at)\n" +
      "  WHERE NOT done AND NOT dead_lettered",
      "CREATE TABLE IF NOT EXISTS bit_schedule_leases (\n" +
      "  lease_key TEXT PRIMARY KEY,\n" +
      "  holder TEXT NOT NULL,\n" +
      "  expires_at BIGINT NOT NULL\n" +
      ")",
  ]
}

// A `Store` (store.bit) over one `Pool`. `Pool` is already safe for
// concurrent callers (its own header: a checkout-and-return pool), so one
// `PostgresStore` may back every worker in a `Queue`.
export class PostgresStore {
  db: Pool

  export enqueue(name: string, payload: string, availableAt: int, maxAttempts: int): ()! {
    this.db.exec(
      "INSERT INTO bit_jobs (name, payload, max_attempts, available_at) VALUES ($1, $2, $3, $4)",
      [Value.Text(name), Value.Text(payload), Value.Int(maxAttempts), Value.Int(availableAt)],
    )?
  }

  export claim(visibilityTimeout: int): Option<ClaimedJob>! {
    return txValue<Option<ClaimedJob>>(this.db, (t) => {
      return claimOneLocked(t, visibilityTimeout)?
    })?
  }

  export complete(id: int): ()! {
    this.db.exec("UPDATE bit_jobs SET done = true WHERE id = $1", [Value.Int(id)])?
  }

  export retry(id: int, availableAt: int): ()! {
    this.db.exec(
      "UPDATE bit_jobs SET available_at = $1, claimed_until = 0 WHERE id = $2",
      [Value.Int(availableAt), Value.Int(id)],
    )?
  }

  export deadLetter(id: int, reason: string): ()! {
    this.db.exec(
      "UPDATE bit_jobs SET dead_lettered = true, dead_reason = $1 WHERE id = $2",
      [Value.Text(reason), Value.Int(id)],
    )?
  }
}

// The two queries over a schedule's lease rows. `$1` is the schedule id and
// its "@" (`<id>@`); a row counts only when what follows is all digits, so
// a schedule whose id merely starts with another's never reads the other's
// ticks. `pruneSql` drops all but the newest `$2` rows by tick.
const lastTickSql: string = "SELECT coalesce(max(substr(lease_key, length($1::text) + 1)::bigint), 0) FROM bit_schedule_leases " +
  "WHERE starts_with(lease_key, $1::text) AND substr(lease_key, length($1::text) + 1) ~ '^[0-9]{1,19}$'"
const pruneSql: string = "DELETE FROM bit_schedule_leases WHERE lease_key IN (" +
  "SELECT lease_key FROM bit_schedule_leases " +
  "WHERE starts_with(lease_key, $1::text) AND substr(lease_key, length($1::text) + 1) ~ '^[0-9]{1,19}$' " +
  "ORDER BY substr(lease_key, length($1::text) + 1)::bigint DESC OFFSET $2)"

// A `Locker` (schedule.bit) over one `Pool`: a lease row per key with an
// expiry, not an advisory lock — an advisory lock belongs to one connection
// and `Pool` does not promise the same connection across two calls.
// `tryAcquire` is one `INSERT ... ON CONFLICT DO UPDATE ... WHERE` statement,
// so two instances racing for the same key are serialized by the row lock
// and exactly one sees a returned row: the conflict branch only rewrites a
// row that is ours already or has expired.
//
// The rows are also the durable record of every tick ever fired, which is
// what `lastTick` reads. Expiry therefore never deletes a row (a fleet down
// for a day would forget its last tick); the table stays bounded by
// dropping all but the newest `keep` rows of a schedule each time one wins a
// tick. `keep` is how many rows that is, by tick (1024 from
// `newPostgresLocker`). A per-tick key is never asked for again once its
// tick has passed, so older rows only cost space. The window is also how far
// behind a slow instance can be and still find a tick already taken, so
// `Queue.schedule`/`every` refuse a `Missed.RunAll` cap above it (`window`).
export class PostgresLocker {
  db: Pool
  keep: int

  export tryAcquire(key: string, holder: string, nowNs: int, expiresAt: int): bool! {
    let rows = this.db.query(
        "INSERT INTO bit_schedule_leases (lease_key, holder, expires_at) VALUES ($1, $2, $3) " +
        "ON CONFLICT (lease_key) DO UPDATE SET holder = EXCLUDED.holder, expires_at = EXCLUDED.expires_at " +
        "WHERE bit_schedule_leases.holder = EXCLUDED.holder OR bit_schedule_leases.expires_at <= $4 " +
        "RETURNING holder",
      [Value.Text(key), Value.Text(holder), Value.Int(expiresAt), Value.Int(nowNs)],
    )?
    let won = rows.next()?
    rows.close()
    if (won) {
      this.prune(key)?
    }
    return won
  }

  export lastTick(key: string): int! {
    let rows = this.db.query(lastTickSql, [Value.Text(key + "@")])?
    let has = rows.next()?
    if (!has) {
      rows.close()
      return 0
    }
    let tick = asInt(rows.value(0))?
    rows.close()
    return tick
  }

  export window(): int {
    return this.keep
  }

  // Drops every lease row of `key`'s schedule but the newest `keep`.
  prune(key: string): ()! {
    let at = lastIndexOf(key, "@")
    if (at < 0) {
      return
    }
    this.db.exec(pruneSql, [Value.Text(key[0:at + 1]), Value.Int(this.keep)])?
  }
}

// A fresh locker over an already-open pool. `migrate` creates its table.
// `keep` is how many lease rows to retain per schedule (at least 1).
export fn newPostgresLocker(db: Pool, keep: int = 1024): PostgresLocker {
  if (keep < 1) {
    return PostgresLocker{ db = db, keep = 1 }
  }
  return PostgresLocker{ db = db, keep = keep }
}

// A fresh store over an already-open pool.
export fn newPostgresStore(db: Pool): PostgresStore {
  return PostgresStore{ db = db }
}

// Runs `migrationStatements()` in order — a convenience for tests and
// small apps; anything with its own migration tool can run the same
// statements itself instead.
export fn migrate(db: Pool): ()! {
  for stmt of migrationStatements() {
    db.exec(stmt, []Value(0))?
  }
}

// The whole SELECT-then-UPDATE, inside `txValue`'s transaction: split out of
// `claim` to stay under spec/LINT.md's complexity ceiling.
fn claimOneLocked(t: Tx, visibilityTimeout: int): Option<ClaimedJob>! {
  let nowNs = now().ns
  let rows = t.query(
      "SELECT id, name, payload, attempts, max_attempts FROM bit_jobs " +
      "WHERE NOT done AND NOT dead_lettered AND available_at <= $1 AND claimed_until <= $1 " +
      "ORDER BY available_at LIMIT 1 FOR UPDATE SKIP LOCKED",
    [Value.Int(nowNs)],
  )?
  let has = rows.next()?
  if (!has) {
    rows.close()
    return Option.None
  }
  let row = readClaimRow(rows)?
  rows.close()
  t.exec(
    "UPDATE bit_jobs SET attempts = $1, claimed_until = $2 WHERE id = $3",
    [Value.Int(row.attempts + 1), Value.Int(nowNs + visibilityTimeout), Value.Int(row.id)],
  )?
  return Option.Some(
    ClaimedJob{
      id = row.id,
      name = row.name,
      payload = row.payload,
      attempts = row.attempts + 1,
      maxAttempts = row.maxAttempts,
    },
  )
}

fn readClaimRow(rows: Rows): ClaimedJob! {
  let id = asInt(rows.value(0))?
  let name = asText(rows.value(1))?
  let payload = asText(rows.value(2))?
  let attempts = asInt(rows.value(3))?
  let maxAttempts = asInt(rows.value(4))?
  return ClaimedJob{
    id = id,
    name = name,
    payload = payload,
    attempts = attempts,
    maxAttempts = maxAttempts,
  }
}
