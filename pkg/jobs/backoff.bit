// pkg/jobs/backoff.bit — exponential backoff with full jitter (#6082).
//
// "Full jitter" (AWS Architecture Blog, "Exponential Backoff And Jitter"):
// `sleep = random_between(0, min(cap, base * 2^attempt))`, rather than a
// fixed exponential delay, so N workers that all failed the same job type
// at the same instant do not all retry in lockstep and re-collide.

import { Rand } from "std/rand"
import { randomU64 } from "std/crypto"
import { Second } from "std/time"

// The first retry's ceiling: 1s. Doubles per attempt after that.
const backoffBaseNs: int = 1 * Second
// No retry waits longer than 5 minutes, however many attempts a job has
// used — an unbounded exponent would eventually overflow the shift below.
const backoffCapNs: int = 300 * Second
// Power-of-10: every loop needs a static bound. 20 doublings already blows
// through backoffCapNs (2^20 * 1s >> 300s), so this is generous, not tight.
const backoffMaxShift: int = 20

// The nanosecond delay before a job that just failed its `attempt`th try
// (1-based) should become claimable again, drawn from `rng`. Unexported:
// an internal of `jobs.bit`'s worker loop, not part of the package's
// public API — a caller never schedules a retry by hand.
fn backoffDelay(attempt: int, rng: Rand): int {
  let shift = attempt - 1
  if (shift < 0) {
    shift = 0
  }
  if (shift > backoffMaxShift) {
    shift = backoffMaxShift
  }
  let exp = backoffBaseNs << shift
  let ceiling = exp
  if (ceiling > backoffCapNs || ceiling < 0) {
    ceiling = backoffCapNs
  }
  return rng.intn(ceiling)
}

// A worker-local generator: `Rand` keeps unsynchronized state (its own doc
// comment, stdlib/rand/rand.bit), so each worker green thread seeds its own
// rather than sharing one across the pool. Unexported, same reason as
// `backoffDelay` above.
fn newWorkerRand(): Rand {
  return Rand(randomU64())
}
