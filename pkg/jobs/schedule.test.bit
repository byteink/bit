// pkg/jobs/schedule.test.bit — unit coverage for the pure catch-up
// arithmetic (`missedEnqueueCount`) and the two `trigger` kinds
// (`cronTrigger`/`intervalTrigger`), all schedule.bit (#6083, #6361). No
// clock, no store, no sleep: every case below drives fixed nanosecond
// integers, the injectable-clock shape the constraint asks tests to use.

import { Second, Minute, Hour, utc, zone } from "std/time"

test "an interval trigger lands on the next epoch-anchored multiple" {
  let t: trigger = intervalTrigger{ periodNs = 15 * Minute }
  // 10:07 -> 10:15 (both epoch-anchored: 1970-01-01 was a Thursday, but
  // the anchor is nanosecond 0, not a calendar boundary).
  let afterNs = 10 * 3600 * Second + 7 * Minute
  let got = t.nextAfterNs(afterNs) catch e {
    panic("nextAfterNs: ${e.message()}")
  }
  let want = 10 * 3600 * Second + 15 * Minute
  assert(got == want, "want ${want}, got ${got}")
}

test "an interval trigger on an exact boundary still advances" {
  let t: trigger = intervalTrigger{ periodNs = 15 * Minute }
  let got = t.nextAfterNs(30 * Minute) catch e {
    panic("nextAfterNs: ${e.message()}")
  }
  assert(got == 45 * Minute, "expected the FOLLOWING boundary, got ${got}")
}

test "a cron trigger delegates to CronSchedule.nextAfter through a Timestamp round-trip" {
  let cs = parseCron("30 2 * * *") catch e {
    panic("parse: ${e.message()}")
  }
  let t: trigger = cronTrigger{ cron = cs, tz = utc() }
  // 2026-01-01T00:00:00Z, a fixed epoch nanosecond count.
  let afterNs = 1767225600 * Second
  let got = t.nextAfterNs(afterNs) catch e {
    panic("nextAfterNs: ${e.message()}")
  }
  let want = afterNs + 2 * 3600 * Second + 30 * Minute
  assert(got == want, "want ${want}, got ${got}")
}

test "missedEnqueueCount: Skip drops every missed tick" {
  assert(missedEnqueueCount(0, Missed.Skip) == 0, "0 missed")
  assert(missedEnqueueCount(1, Missed.Skip) == 0, "1 missed")
  assert(missedEnqueueCount(500, Missed.Skip) == 0, "500 missed")
}

test "missedEnqueueCount: RunOnce collapses any number of missed ticks into one" {
  assert(missedEnqueueCount(0, Missed.RunOnce) == 0, "0 missed")
  assert(missedEnqueueCount(1, Missed.RunOnce) == 1, "1 missed")
  assert(missedEnqueueCount(500, Missed.RunOnce) == 1, "500 missed")
}

test "missedEnqueueCount: RunAll enqueues one per tick, capped" {
  assert(missedEnqueueCount(0, Missed.RunAll(10)) == 0, "0 missed")
  assert(missedEnqueueCount(3, Missed.RunAll(10)) == 3, "3 missed, under cap")
  assert(missedEnqueueCount(10, Missed.RunAll(10)) == 10, "exactly at cap")
  assert(missedEnqueueCount(50, Missed.RunAll(10)) == 10, "50 missed, capped at 10")
}

test "an interval trigger's previous tick is the multiple at or before, floored below the epoch" {
  let t: trigger = intervalTrigger{ periodNs = 15 * Minute }
  let at = 10 * 3600 * Second + 7 * Minute
  assert(mustPrev(t, at) == 10 * 3600 * Second, "10:07 -> 10:00")
  assert(mustPrev(t, at + 8 * Minute) == at + 8 * Minute, "a tick is at or before itself")
  assert(mustPrev(t, 0) == 0, "the epoch is a tick")
  assert(mustPrev(t, -1) == -15 * Minute, "one ns before 1970 floors to the tick before it")
  assert(mustPrev(t, -15 * Minute) == -15 * Minute, "a negative tick is at or before itself")
}

test "an interval trigger counts ticks in closed form, a cron trigger never does" {
  let iv: trigger = intervalTrigger{ periodNs = Minute }
  let (n, exact) = iv.tickCountNs(2 * Minute, 9 * Minute)
  assert(exact && n == 8, "minutes 2 to 9 are 8 ticks, got ${n}")
  let cs = parseCron("* * * * *") catch e {
    panic("parse: ${e.message()}")
  }
  let ct: trigger = cronTrigger{ cron = cs, tz = utc() }
  let (_, known) = ct.tickCountNs(2 * Minute, 9 * Minute)
  assert(!known, "a cron trigger must not claim an exact count")
}

fn mustPrev(t: trigger, atNs: int): int {
  let got = t.prevAtOrBeforeNs(atNs) catch e {
    panic("prevAtOrBeforeNs(${atNs}): ${e.message()}")
  }
  return got
}

fn mustNext(t: trigger, atNs: int): int {
  let got = t.nextAfterNs(atNs) catch e {
    panic("nextAfterNs(${atNs}): ${e.message()}")
  }
  return got
}

fn zonedTrigger(expr: string, zoneName: string): trigger {
  let cs = parseCron(expr) catch e {
    panic("parse '${expr}': ${e.message()}")
  }
  let z = zone(zoneName) catch e {
    panic("zone ${zoneName}: ${e.message()}")
  }
  return cronTrigger{ cron = cs, tz = z }
}

// The two directions of one trigger agree at `atNs`: the newest tick at or
// before it is not after it, the tick after that one is after it (no tick
// lies between), and the newest tick at or before the next tick is that tick.
fn wantAgree(t: trigger, atNs: int, what: string) {
  let prev = mustPrev(t, atNs)
  assert(prev <= atNs, "${what}: prev(${atNs}) = ${prev} is after it")
  let following = mustNext(t, prev)
  assert(following > atNs, "${what}: next(prev(${atNs})) = ${following} is not after it")
  let next = mustNext(t, atNs)
  assert(mustPrev(t, next) == next, "${what}: prev(next(${atNs})) is not ${next}")
}

// 2026-01-01T00:00:00Z, and the two New York transitions of 2026:
// 02:00 EST -> 03:00 EDT on 2026-03-08 (07:00Z, day 66) and 02:00 EDT ->
// 01:00 EST on 2026-11-01 (06:00Z, day 304).
const year0: int = 1767225600 * Second
const springNy: int = year0 + 66 * 24 * Hour + 7 * Hour
const fallNy: int = year0 + 304 * 24 * Hour + 6 * Hour

fn agreeExprs(): []string {
  return ["30 1 * * *", "30 2 * * *", "0 2 * * 0", "*/15 * * * *", "0 * * * *", "* * * * *"]
}

test "prev and next agree over a year of instants in America/New_York" {
  for expr of agreeExprs() {
    let t = zonedTrigger(expr, "America/New_York")
    let at = year0 + 13 * Second
    while (at < year0 + 365 * 24 * Hour) {
      wantAgree(t, at, expr)
      at = at + 97 * Minute + 17 * Second
    }
  }
}

test "prev and next agree minute by minute around both New York transitions" {
  for expr of agreeExprs() {
    let t = zonedTrigger(expr, "America/New_York")
    for edge of [springNy, fallNy] {
      let at = edge - 4 * Hour + 13 * Second
      while (at < edge + 4 * Hour) {
        wantAgree(t, at, expr)
        at = at + Minute
      }
    }
  }
}
