// pkg/jobs/schedule.test.bit — unit coverage for the pure catch-up
// arithmetic (`dueTicks`/`missedEnqueueCount`) and the two `trigger`
// kinds (`cronTrigger`/`intervalTrigger`), all schedule.bit (#6083). No
// clock, no store, no sleep: every case below drives fixed nanosecond
// integers, the injectable-clock shape the constraint asks tests to use.

import { Second, Minute, utc } from "std/time"

test "an interval trigger lands on the next epoch-anchored multiple" {
  let t: trigger = intervalTrigger{ periodNs = 15 * Minute }
  // 10:07 -> 10:15 (both epoch-anchored: 1970-01-01 was a Thursday, but
  // the anchor is nanosecond 0, not a calendar boundary).
  let afterNs = 10 * 3600 * Second + 7 * Minute
  let got = t.nextAfterNs(afterNs) catch e {
    panic("nextAfterNs: ${e.message()}")
  }
  let want = 10 * 3600 * Second + 15 * Minute
  assert(got == want, "want ${want}, got ${got}")
}

test "an interval trigger on an exact boundary still advances" {
  let t: trigger = intervalTrigger{ periodNs = 15 * Minute }
  let got = t.nextAfterNs(30 * Minute) catch e {
    panic("nextAfterNs: ${e.message()}")
  }
  assert(got == 45 * Minute, "expected the FOLLOWING boundary, got ${got}")
}

test "a cron trigger delegates to CronSchedule.nextAfter through a Timestamp round-trip" {
  let cs = parseCron("30 2 * * *") catch e {
    panic("parse: ${e.message()}")
  }
  let t: trigger = cronTrigger{ cron = cs, tz = utc() }
  // 2026-01-01T00:00:00Z, a fixed epoch nanosecond count.
  let afterNs = 1767225600 * Second
  let got = t.nextAfterNs(afterNs) catch e {
    panic("nextAfterNs: ${e.message()}")
  }
  let want = afterNs + 2 * 3600 * Second + 30 * Minute
  assert(got == want, "want ${want}, got ${got}")
}

test "missedEnqueueCount: Skip drops every missed tick" {
  assert(missedEnqueueCount(0, Missed.Skip) == 0, "0 missed")
  assert(missedEnqueueCount(1, Missed.Skip) == 0, "1 missed")
  assert(missedEnqueueCount(500, Missed.Skip) == 0, "500 missed")
}

test "missedEnqueueCount: RunOnce collapses any number of missed ticks into one" {
  assert(missedEnqueueCount(0, Missed.RunOnce) == 0, "0 missed")
  assert(missedEnqueueCount(1, Missed.RunOnce) == 1, "1 missed")
  assert(missedEnqueueCount(500, Missed.RunOnce) == 1, "500 missed")
}

test "missedEnqueueCount: RunAll enqueues one per tick, capped" {
  assert(missedEnqueueCount(0, Missed.RunAll(10)) == 0, "0 missed")
  assert(missedEnqueueCount(3, Missed.RunAll(10)) == 3, "3 missed, under cap")
  assert(missedEnqueueCount(10, Missed.RunAll(10)) == 10, "exactly at cap")
  assert(missedEnqueueCount(50, Missed.RunAll(10)) == 10, "50 missed, capped at 10")
}

test "dueTicks lists every due tick and stops on the first future one" {
  let t: trigger = intervalTrigger{ periodNs = Minute }
  // Ticks land at minute 1, 2, 3, .... Starting from minute 1 with "now"
  // at minute 3 and a bit: 1, 2, 3 are all due, next is 4.
  let (ticks, next) = dueTicks(t, Minute, 3 * Minute + 30 * Second) catch e {
    panic("dueTicks: ${e.message()}")
  }
  assert(len(ticks) == 3, "expected 3 due ticks, got ${len(ticks)}")
  assert(ticks[0] == Minute && ticks[2] == 3 * Minute, "ticks out of order or wrong")
  assert(next == 4 * Minute, "expected next tick at minute 4, got ${next}")
}

test "dueTicks reports none when the first tick is already in the future" {
  let t: trigger = intervalTrigger{ periodNs = Minute }
  let (ticks, next) = dueTicks(t, 5 * Minute, Minute) catch e {
    panic("dueTicks: ${e.message()}")
  }
  assert(len(ticks) == 0, "expected no due ticks, got ${len(ticks)}")
  assert(next == 5 * Minute, "next tick must be unchanged, got ${next}")
}
