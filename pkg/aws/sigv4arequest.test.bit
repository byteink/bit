// One unique official header request; base and header fixtures coincide at
// aws-c-auth 84a26ea184d9ccd322c8164759510b3604ab13fd, get-vanilla.
fn sigV4aRequestConfig(): SigV4aConfig {
  let credential = AwsCredential(
    accessKeyId = "AKIDEXAMPLE",
    secretAccessKey = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  ) catch e {
    panic(e.message())
  }
  return SigV4aConfig{
    credential = credential,
    service = "service",
    regionSet = "us-east-1",
    contentSha256Header = false,
  }
}

fn sigV4aRequestFixture(): SigV4Request {
  return SigV4Request{
    method = "GET",
    path = "/",
    query = [](string, string)(0),
    headers = [SigHeader{ name = "host", value = "example.amazonaws.com" }],
    payloadHash = sha256Hex(""),
  }
}

fn sigV4aRequestSigned(cfg: SigV4aConfig, req: SigV4Request): SigV4Signed {
  return signV4a(cfg, req, "20150830T123600Z") catch e {
    panic(e.message())
  }
}

fn sigV4aHeaderCount(headers: []SigHeader, name: string, value: string): int {
  let count = 0
  for header of headers {
    if (header.name == name && header.value == value) {
      count = count + 1
    }
  }
  return count
}

test "SigV4a public header official canonical request and DER verification" {
  let signed = sigV4aRequestSigned(sigV4aRequestConfig(), sigV4aRequestFixture())
  assert(
      signed.canonicalRequest ==
      "GET\n/\n\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "official SigV4a header canonical request",
  )
  assert(
      signed.stringToSign ==
      "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\ncf59db423e841c8b7e3444158185aa261b724a5c27cbe762676f3eed19f4dc02",
    "official SigV4a header message",
  )
  let public = sigV4aReadPublic(
    sigV4aCurve(),
    sigV4aTestBytes("04b6618f6a65740a99e650b33b6b4b5bd0d43b176d721a3edfea7e7d2d56d936b1865ed22a7eadc9c5cb9d2cbaca1b3699139fedc5043dc6661864218330c8e518"),
  ) catch e {
    panic(e.message())
  }
  let der = sigV4aTestBytes(signed.signature)
  let signature = sigV4aReadSignature(der) catch e {
    panic(e.message())
  }
  let hash = sigV4aDigest(SigV4aSha256(), []byte(signed.stringToSign))
  assert(sigV4aVerify(public, hash, signature), "published point verifies request signature")
  assert(
    !sigV4aVerify(
      public,
      sigV4aDigest(SigV4aSha256(), []byte(signed.stringToSign + "x")),
      signature,
    ),
    "message tampering rejected",
  )
  der[len(der) - 1] = der[len(der) - 1] ^ 1
  let changed = sigV4aReadSignature(der) catch e {
    panic(e.message())
  }
  assert(!sigV4aVerify(public, hash, changed), "signature tampering rejected")
  assert(
      signed.authorization ==
      "AWS4-ECDSA-P256-SHA256 Credential=AKIDEXAMPLE/20150830/service/aws4_request, SignedHeaders=host;x-amz-date;x-amz-region-set, Signature=${signed.signature}",
    "region-free ECDSA authorization",
  )
}

test "SigV4a public header region policy accepts single list wildcard and byte bound" {
  for regions of ["*", "us-west-*", "us-east-1", "us-west-2,us-east-1", "u*s-*", repeat("a", 8192)] {
    let cfg = sigV4aRequestConfig()
    cfg.regionSet = regions
    let signed = sigV4aRequestSigned(cfg, sigV4aRequestFixture())
    assert(
      sigV4aHeaderCount(signed.headers, "x-amz-region-set", regions) == 1,
      "one exact region header",
    )
    assert(
      contains(signed.canonicalRequest, "x-amz-region-set:${regions}\n"),
      "region value signed intact",
    )
  }
}

test "SigV4a public header session generated replacements preserve caller arrays" {
  let cfg = sigV4aRequestConfig()
  cfg.credential.sessionToken = Option.Some("session-token")
  cfg.contentSha256Header = true
  let req = sigV4aRequestFixture()
  req.headers = append(
    req.headers,
    SigHeader{ name = "X-Amz-Region-Set", value = "old" },
    SigHeader{ name = "x-amz-region-set", value = "old-two" },
    SigHeader{ name = "X-Amz-Date", value = "old-date" },
    SigHeader{ name = "Date", value = "old-date-two" },
    SigHeader{ name = "X-Amz-Security-Token", value = "old-token" },
    SigHeader{ name = "Authorization", value = "old-auth" },
  )
  let signed = sigV4aRequestSigned(cfg, req)
  assert(
      len(req.headers) == 7 &&
      req.headers[1].value == "old" &&
      req.headers[2].name == "x-amz-region-set",
    "input headers intact",
  )
  assert(req.method == "GET" && len(req.query) == 0, "request intact")
  assert(!contains(signed.canonicalRequest, "old"), "generated caller values replaced")
  assert(
    sigV4aHeaderCount(signed.headers, "x-amz-security-token", "session-token") == 1,
    "one generated session token",
  )
  assert(
    sigV4aHeaderCount(signed.headers, "x-amz-content-sha256", sha256Hex("")) == 1,
    "generated content hash",
  )
  assert(
    contains(
      signed.authorization,
      "SignedHeaders=host;x-amz-content-sha256;x-amz-date;x-amz-region-set;x-amz-security-token,",
    ),
    "session and hash signed",
  )
  req.headers = append(
    req.headers,
    SigHeader{ name = "X-Amz-Content-Sha256", value = unsignedPayload },
  )
  let explicit = sigV4aRequestSigned(cfg, req)
  assert(
    contains(explicit.canonicalRequest, "x-amz-content-sha256:UNSIGNED-PAYLOAD\n"),
    "caller payload hash wins",
  )
  assert(
    sigV4aHeaderCount(explicit.headers, "x-amz-content-sha256", unsignedPayload) == 0,
    "caller hash needs no generated duplicate",
  )
}

fn sigV4aRequestRejected(cfg: SigV4aConfig, req: SigV4Request, date: string) {
  let message = ""
  signV4a(cfg, req, date) catch e {
    message = e.message()
  }
  assert(message == "aws: sigv4a: invalid signing input", "fixed redacted request error")
}

test "SigV4a public header rejects region syntax and byte overflow" {
  for regions of [
    "",
    repeat("x", 8193),
    "US-east-1",
    ",us-east-1",
    "us-east-1,",
    "a,,b",
    "a b",
    "a/b",
    "a_1",
    "a\nsentinel-secret",
  ] {
    let cfg = sigV4aRequestConfig()
    cfg.regionSet = regions
    sigV4aRequestRejected(cfg, sigV4aRequestFixture(), "20150830T123600Z")
  }
}

test "SigV4a public header rejects malformed request and scope" {
  let cfg = sigV4aRequestConfig()
  let req = sigV4aRequestFixture()
  for date of ["", "20150830X123600Z", "sentinel-secret", repeat("x", 1048576)] {
    sigV4aRequestRejected(cfg, req, date)
  }
  for service of ["", repeat("s", 129), "s/service", "s\nsentinel-secret"] {
    cfg.service = service
    sigV4aRequestRejected(cfg, req, "20150830T123600Z")
  }
  cfg.service = "service"
  for method of ["", "GET\nsentinel-secret", "GET bad"] {
    req.method = method
    sigV4aRequestRejected(cfg, req, "20150830T123600Z")
  }
  req.method = "GET"
  req.headers = []SigHeader(0)
  sigV4aRequestRejected(cfg, req, "20150830T123600Z")
  req.headers = [SigHeader{ name = "host", value = " " }]
  sigV4aRequestRejected(cfg, req, "20150830T123600Z")
  req.headers = [SigHeader{ name = "sentinel-secret\n", value = "x" }]
  sigV4aRequestRejected(cfg, req, "20150830T123600Z")
  req.headers = [SigHeader{ name = "host", value = "example.amazonaws.com" }]
  req.payloadHash = "sentinel-secret"
  sigV4aRequestRejected(cfg, req, "20150830T123600Z")
}

test "SigV4a public header rechecks mutated credential fields without leaks" {
  for value of ["", " sentinel-secret", "sentinel-secret\n"] {
    let cfg = sigV4aRequestConfig()
    cfg.credential.accessKeyId = value
    sigV4aRequestRejected(cfg, sigV4aRequestFixture(), "20150830T123600Z")
  }
  for value of ["", " sentinel-secret", "sentinel-secret\n"] {
    let cfg = sigV4aRequestConfig()
    cfg.credential.sessionToken = Option.Some(value)
    sigV4aRequestRejected(cfg, sigV4aRequestFixture(), "20150830T123600Z")
    cfg.credential.sessionToken = Option.None
    cfg.credential.secretAccessKey = value
    sigV4aRequestRejected(cfg, sigV4aRequestFixture(), "20150830T123600Z")
  }
}
