// pkg/aws/partition.test.bit — partition.bit against the regions of every
// partition, an unknown region, a malformed one and the empty one.
//
// The `Vectors` counter below is shared by the other test files of the package:
// it keeps the vectors that failed, so a red run names them all and a green one
// can say "N of N".

class Vectors {
  passed: int,
  total: int,
  failures: []string,
}

fn vectors(): Vectors {
  return Vectors{ passed = 0, total = 0, failures = []string(0) }
}

fn check(t: Vectors, ok: bool, what: string) {
  t.total = t.total + 1
  if (ok) {
    t.passed = t.passed + 1
    return
  }
  t.failures = append(t.failures, what)
}

fn finish(t: Vectors, name: string) {
  println("${name}: ${t.passed} of ${t.total} vectors")
  let all = ""
  for f of t.failures {
    all = all + f + "; "
  }
  assert(len(t.failures) == 0, "failed: ${all}")
}

test "awsPartition names the partition of a region" {
  let t = vectors()
  partitionVectors(t)
  finish(t, "partition (partitions.json 1.1)")
}

fn partitionVectors(t: Vectors) {
  check(t, awsPartition("us-east-1").name == "aws", "us-east-1")
  check(t, awsPartition("aws-global").name == "aws", "aws-global")
  check(t, awsPartition("cn-north-1").dnsSuffix == "amazonaws.com.cn", "cn-north-1")
  check(t, awsPartition("us-gov-west-1").name == "aws-us-gov", "us-gov-west-1")
  check(t, awsPartition("us-iso-east-1").name == "aws-iso", "us-iso-east-1")
  check(t, awsPartition("us-isob-east-1").dualStackDnsSuffix == "api.aws.scloud", "us-isob-east-1")
  check(t, awsPartition("eusc-de-east-1").dnsSuffix == "amazonaws.eu", "eusc-de-east-1")
  check(t, awsPartition("us-future-9").name == "aws", "an unknown region is in aws")
  check(t, awsPartition("a b").name == "aws", "a malformed region is in aws")
  check(t, awsPartition("").name == "aws", "an empty region is in aws")
  check(
    t,
    awsPartition("us-east-1").supportsFIPS && awsPartition("us-east-1").supportsDualStack,
    "supports",
  )
}
