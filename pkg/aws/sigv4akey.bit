// AWS SigV4a derives a P-256 scalar through its bounded SP800-108 construction.
import {
  EcdsaPrivateKey as SigV4aPrivateKey, ecdsaPrivateKey as sigV4aMakeKey,
  nistecP256 as sigV4aCurve, hmac as sigV4aHmac, HashAlg as SigV4aHash,
  decodeHex as sigV4aDecode, secureZero as sigV4aZero,
} from "std/crypto"

fn sigV4aKeyError(): error {
  return newError("aws: sigv4a: invalid key derivation input")
}

fn sigV4aKeyInput(accessKeyId: string, counter: int): []byte! {
  if (counter < 1 || counter > 254 || len(accessKeyId) > 8192) {
    fail sigV4aKeyError()
  }
  let label = []byte("AWS4-ECDSA-P256-SHA256")
  let out = []byte(32 + len(accessKeyId))
  out[3] = 1
  let i = 0
  while (i < len(label)) {
    out[4 + i] = label[i]
    i = i + 1
  }
  let offset = 5 + len(label)
  i = 0
  while (i < len(accessKeyId)) {
    out[offset + i] = accessKeyId[i]
    i = i + 1
  }
  out[offset + len(accessKeyId)] = byte(counter)
  out[len(out) - 2] = 1
  return out
}

// Scan all 32 octets; a rejected digest must not reveal its first differing byte.
fn sigV4aKeyCandidate(digest: []byte): Option<[]byte>! {
  if (len(digest) != 32) {
    fail sigV4aKeyError()
  }
  let limit = sigV4aDecode("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f")?
  let borrow = 0
  let i = 31
  while (i >= 0) {
    borrow = ((int(limit[i]) - int(digest[i]) - borrow) >> 8) & 1
    i = i - 1
  }
  if (borrow != 0) {
    return Option<[]byte>.None
  }
  let scalar = []byte(32)
  let carry = 1
  i = 31
  while (i >= 0) {
    let sum = int(digest[i]) + carry
    scalar[i] = byte(sum & 255)
    carry = sum >> 8
    i = i - 1
  }
  return Option<[]byte>.Some(scalar)
}

// The private PRF seam makes the otherwise improbable retry bound testable.
fn sigV4aDeriveScalar(
  accessKeyId: string,
  secretAccessKey: string,
  prf: ([]byte, []byte) => []byte,
): []byte! {
  if (len(accessKeyId) > 8192 || len(secretAccessKey) > 8192) {
    fail sigV4aKeyError()
  }
  checkField("accessKeyId", accessKeyId) catch _ {
    fail sigV4aKeyError()
  }
  checkField("secretAccessKey", secretAccessKey) catch _ {
    fail sigV4aKeyError()
  }
  let key = []byte("AWS4A" + secretAccessKey)
  defer sigV4aZero(key)
  let counter = 1
  while (counter <= 254) {
    let block = prf(key, sigV4aKeyInput(accessKeyId, counter)?)
    let candidate = sigV4aKeyCandidate(block) catch _ {
      sigV4aZero(block)
      fail sigV4aKeyError()
    }
    sigV4aZero(block)
    match (candidate) {
      Some(scalar) => return scalar
      None => {}
    }
    counter = counter + 1
  }
  fail sigV4aKeyError()
}

fn sigV4aKey(accessKeyId: string, secretAccessKey: string): SigV4aPrivateKey! {
  let scalar = sigV4aDeriveScalar(
    accessKeyId, secretAccessKey, (key, input) => sigV4aHmac(SigV4aHash.Sha256, key, input),
  )?
  defer sigV4aZero(scalar)
  return sigV4aMakeKey(sigV4aCurve(), scalar) catch _ {
    fail sigV4aKeyError()
  }
}
