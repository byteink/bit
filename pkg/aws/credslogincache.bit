import { openBeneath as loginOpenBeneath, statOpen as loginStatOpen } from "std/fs/secure"
import { dir as loginCacheDir, base as loginCacheBase } from "std/path"

// Sign-In preserves unknown cache fields when it rotates the refresh token.
class LoginCache {
  value: Json,
  credential: AwsCredential,
  clientId: string,
  refreshToken: string,
  dpopKey: string,
}

fn loginCacheError(): error {
  return newError("aws: login: invalid or unavailable session cache; run aws login")
}

// The consumer supplies the directory; env() cannot distinguish empty from unset.
fn loginCachePath(directory: string, session: string): string! {
  if (len(directory) > 8192 ||
    hasControl([]byte(directory)) ||
    len(session) == 0 ||
    len(session) > 8192 ||
    hasControl([]byte(session))) {
    fail loginCacheError()
  }
  let name = encodeHex(digest(Sha256(), []byte(session))) + ".json"
  return pathJoin(directory, name)
}

fn loginCacheText(value: Json, key: string): string! {
  let text = ssoText(value, key) catch _ {
    fail loginCacheError()
  }
  if (len(text) > 8192) {
    fail loginCacheError()
  }
  return text
}

fn loginCacheMember(value: Json, key: string): Json! {
  match (jsonGet(value, key)) {
    Some(member) => return member
    None => { fail loginCacheError() }
  }
}

fn loginCacheAccount(account: string): bool {
  if (len(account) != 12) {
    return false
  }
  for c of []byte(account) {
    if (c < '0' || c > '9') {
      return false
    }
  }
  return true
}

fn loginCacheCredential(value: Json): AwsCredential! {
  let access = loginCacheMember(value, "accessToken")?
  let account = loginCacheText(access, "accountId")?
  if (!loginCacheAccount(account)) {
    fail loginCacheError()
  }
  let expiry = parseRfc3339(loginCacheText(access, "expiresAt")?) catch _ {
    fail loginCacheError()
  }
  return AwsCredential(
    accessKeyId = loginCacheText(access, "accessKeyId")?,
    secretAccessKey = loginCacheText(access, "secretAccessKey")?,
    sessionToken = Option.Some(loginCacheText(access, "sessionToken")?),
    expiration = Option.Some(expiry),
    accountId = Option.Some(account),
  ) catch _ {
    fail loginCacheError()
  }
}

fn loginCacheKey(value: Json): string! {
  let pem = ""
  match (loginCacheMember(value, "dpopKey")?) {
    JsonString(text) => pem = text
    _ => { fail loginCacheError() }
  }
  loginProofKey(pem) catch _ {
    fail loginCacheError()
  }
  return pem
}

fn loginCacheParse(value: Json): LoginCache! {
  return LoginCache{
    value = value,
    credential = loginCacheCredential(value)?,
    clientId = loginCacheText(value, "clientId")?,
    refreshToken = loginCacheText(value, "refreshToken")?,
    dpopKey = loginCacheKey(value)?,
  }
}

fn loginCacheRead(path: string): LoginCache! {
  let file = loginOpenBeneath(loginCacheDir(path), loginCacheBase(path)) catch _ {
    fail loginCacheError()
  }
  defer file.close()
  let info = loginStatOpen(file) catch _ {
    fail loginCacheError()
  }
  if (!info.isRegular) {
    fail loginCacheError()
  }
  let value = ssoReadFile(file) catch _ {
    fail loginCacheError()
  }
  return loginCacheParse(value)?
}

fn loginCacheWrite(path: string, value: Json): LoginCache! {
  let cache = loginCacheParse(value)?
  ssoWrite(path, value) catch _ {
    fail loginCacheError()
  }
  return cache
}
