// pkg/aws/stsresponse.test.bit — the response side of sts.bit and the whole call
// against a fake STS server on loopback. The success bodies are the reference
// examples of docs.aws.amazon.com/STS/latest/APIReference (API_AssumeRole.html,
// API_AssumeRoleWithWebIdentity.html), the error bodies the awsQuery protocol
// tests of smithy-lang/smithy bd0ed9e054b29874a5bec389e16d8c4db9dc9b94
// (model/awsQuery/xml-errors.smithy) and the shape the service documents.

import { Request, Server, listenAndServeOn, serve } from "std/http"
import { repeat, replace } from "std/strings"

const docToken: string = ""

// The reference response of AssumeRole with the session token on one line, as
// the service sends it (the document wraps it for display, see below).
fn assumeRoleXml(token: string): string {
  return "<AssumeRoleResponse xmlns=\"https://sts.amazonaws.com/doc/2011-06-15/\">\n" +
    "  <AssumeRoleResult>\n" +
    "  <SourceIdentity>Alice</SourceIdentity>\n" +
    "    <AssumedRoleUser>\n" +
    "      <Arn>arn:aws:sts::123456789012:assumed-role/demo/TestAR</Arn>\n" +
    "      <AssumedRoleId>ARO123EXAMPLE123:TestAR</AssumedRoleId>\n" +
    "    </AssumedRoleUser>\n" +
    "    <Credentials>\n" +
    "      <AccessKeyId>ASIAIOSFODNN7EXAMPLE</AccessKeyId>\n" +
    "      <SecretAccessKey>wJalrXUtnFEMI/K7MDENG/bPxRfiCYzEXAMPLEKEY</SecretAccessKey>\n" +
    "      <SessionToken>" +
    token +
    "</SessionToken>\n" +
    "      <Expiration>2019-11-09T13:34:41Z</Expiration>\n" +
    "    </Credentials>\n" +
    "    <PackedPolicySize>6</PackedPolicySize>\n" +
    "  </AssumeRoleResult>\n" +
    "  <ResponseMetadata>\n" +
    "    <RequestId>c6104cbe-af31-11e0-8154-cbc7ccf896c7</RequestId>\n" +
    "  </ResponseMetadata>\n" +
    "</AssumeRoleResponse>\n"
}

const webIdentityXml: string = "<AssumeRoleWithWebIdentityResponse xmlns=\"https://sts.amazonaws.com/doc/2011-06-15/\">\n" +
  "  <AssumeRoleWithWebIdentityResult>\n" +
  "    <SubjectFromWebIdentityToken>amzn1.account.AF6RHO7KZU5XRVQJGXK6HB56KR2A</SubjectFromWebIdentityToken>\n" +
  "    <Audience>client.5498841531868486423.1548@apps.example.com</Audience>\n" +
  "    <AssumedRoleUser>\n" +
  "      <Arn>arn:aws:sts::123456789012:assumed-role/FederatedWebIdentityRole/app1</Arn>\n" +
  "      <AssumedRoleId>AROACLKWSDQRAOEXAMPLE:app1</AssumedRoleId>\n" +
  "    </AssumedRoleUser>\n" +
  "    <Credentials>\n" +
  "      <SessionToken>AQoDYXdzEE0a8ANXXXXXXXXNO1ewxE5TijQyp+IEXAMPLE</SessionToken>\n" +
  "      <SecretAccessKey>wJalrXUtnFEMI/K7MDENG/bPxRfiCYzEXAMPLEKEY</SecretAccessKey>\n" +
  "      <Expiration>2014-10-24T23:00:23Z</Expiration>\n" +
  "      <AccessKeyId>ASgeIAIOSFODNN7EXAMPLE</AccessKeyId>\n" +
  "    </Credentials>\n" +
  "    <SourceIdentity>SourceIdentityValue</SourceIdentity>\n" +
  "    <Provider>www.amazon.com</Provider>\n" +
  "  </AssumeRoleWithWebIdentityResult>\n" +
  "  <ResponseMetadata>\n" +
  "    <RequestId>ad4156e9-bce1-11e2-82e6-6b6efEXAMPLE</RequestId>\n" +
  "  </ResponseMetadata>\n" +
  "</AssumeRoleWithWebIdentityResponse>\n"

// awsQuery protocol test QueryInvalidGreetingError.
const invalidGreeting: string = "<ErrorResponse>\n" +
  "   <Error>\n" +
  "      <Type>Sender</Type>\n" +
  "      <Code>InvalidGreeting</Code>\n" +
  "      <Message>Hi</Message>\n" +
  "   </Error>\n" +
  "   <RequestId>foo-id</RequestId>\n" +
  "</ErrorResponse>\n"

// The shape STS answers an expired web identity token with.
const expiredToken: string = "<ErrorResponse xmlns=\"https://sts.amazonaws.com/doc/2011-06-15/\">\n" +
  "  <Error>\n" +
  "    <Type>Sender</Type>\n" +
  "    <Code>ExpiredTokenException</Code>\n" +
  "    <Message>Token expired: current date/time 1600000000 must be before the expiration date/time 1500000000</Message>\n" +
  "  </Error>\n" +
  "  <RequestId>7a62c49f-347e-4fc4-9331-6e8eEXAMPLE</RequestId>\n" +
  "</ErrorResponse>\n"

fn reply(status: int, body: string, headers: string = ""): Response {
  return Response{ status = status, contentType = "text/xml", headers = headers, body = body }
}

fn ts(s: string): Timestamp {
  return parseRfc3339(s) catch e {
    panic(e.message())
  }
}

fn assumed(op: string, res: Response): AssumedRole {
  return parseAssumed(op, res) catch e {
    panic("${op}: ${e.message()}")
  }
}

fn assumedFailure(op: string, body: string): string {
  parseAssumed(op, reply(200, body)) catch e {
    return e.message()
  }
  return ""
}

// --- success -----------------------------------------------------------------

test "the AssumeRole reference response parses to its key, secret, token and expiry" {
  let r = assumed("AssumeRole", reply(200, assumeRoleXml(docToken)))
  let c = r.credentials
  assert(c.accessKeyId == "ASIAIOSFODNN7EXAMPLE", "key: ${c.accessKeyId}")
  assert(c.secretAccessKey == "wJalrXUtnFEMI/K7MDENG/bPxRfiCYzEXAMPLEKEY", "secret")
  assert(c.token() == docToken, "token")
  assert(c.expiration == Option<Timestamp>.Some(ts("2019-11-09T13:34:41Z")), "expiration")
  assert(c.accountId == Option<string>.Some("123456789012"), "account id from the assumed role ARN")
  assert(
    r.assumedRoleArn == Option<string>.Some("arn:aws:sts::123456789012:assumed-role/demo/TestAR"),
    "arn",
  )
  assert(r.assumedRoleId == Option<string>.Some("ARO123EXAMPLE123:TestAR"), "role id")
  assert(r.packedPolicySize == Option<int>.Some(6), "packed policy size")
  assert(r.sourceIdentity == Option<string>.Some("Alice"), "source identity")
  assert(r.requestId == "c6104cbe-af31-11e0-8154-cbc7ccf896c7", "request id: ${r.requestId}")
  assert(
    r.provider == Option<string>.None && r.audience == Option<string>.None,
    "web identity members are unset",
  )
}

test "the AssumeRoleWithWebIdentity reference response parses to its key, secret, token and expiry" {
  let r = assumed("AssumeRoleWithWebIdentity", reply(200, webIdentityXml))
  let c = r.credentials
  assert(c.accessKeyId == "ASgeIAIOSFODNN7EXAMPLE", "key")
  assert(c.secretAccessKey == "wJalrXUtnFEMI/K7MDENG/bPxRfiCYzEXAMPLEKEY", "secret")
  assert(c.token() == "AQoDYXdzEE0a8ANXXXXXXXXNO1ewxE5TijQyp+IEXAMPLE", "token")
  assert(c.expiration == Option<Timestamp>.Some(ts("2014-10-24T23:00:23Z")), "expiration")
  assert(c.accountId == Option<string>.Some("123456789012"), "account id")
  assert(
      r.subjectFromWebIdentityToken ==
      Option<string>.Some("amzn1.account.AF6RHO7KZU5XRVQJGXK6HB56KR2A"),
    "subject",
  )
  assert(r.provider == Option<string>.Some("www.amazon.com"), "provider")
  assert(
    r.audience == Option<string>.Some("client.5498841531868486423.1548@apps.example.com"),
    "audience",
  )
  assert(r.sourceIdentity == Option<string>.Some("SourceIdentityValue"), "source identity")
  assert(r.requestId == "ad4156e9-bce1-11e2-82e6-6b6efEXAMPLE", "request id")
}

test "the request id of the x-amzn-requestid header wins over the body's" {
  let r = assumed(
    "AssumeRole",
    reply(200, assumeRoleXml(docToken), "x-amzn-requestid: from-header\r\n"),
  )
  assert(r.requestId == "from-header", "request id: ${r.requestId}")
}

test "the token the reference document wraps over lines is refused, naming the field not the value" {
  let wrapped = "\n       AQoDYXdzEPT//////////wEXAMPLEtc764bNrC9SAPBSM22wDOk4x4HIZ8j4FZTwdQW\n       LWsKWHGBuFqwAeMicRXmxfpSPfIeoIYRqTflfKD8YUuwthAx7mSEI/qkPpKPi/kMcGd\n      "
  let msg = assumedFailure("AssumeRole", assumeRoleXml(wrapped))
  assert(contains(msg, "sessionToken"), "message: ${msg}")
  assert(
    !contains(msg, "AQoDYXdz") && !contains(msg, "LWsKWH"),
    "the message quotes the token: ${msg}",
  )
}

test "whitespace around a value is trimmed, as the SDK's XML parser does" {
  let r = assumed("AssumeRole", reply(200, assumeRoleXml("\n      " + docToken + "\n    ")))
  assert(r.credentials.token() == docToken, "token")
}

// --- a success body that is not a success --------------------------------------

test "a 200 without credentials, or with part of them, is an error" {
  let whole = assumeRoleXml(docToken)
  assert(
    contains(assumedFailure("AssumeRole", replace(whole, "Credentials", "Nothing")), "Credentials"),
    "no Credentials",
  )
  assert(
    contains(
      assumedFailure("AssumeRole", replace(whole, "SecretAccessKey", "Nothing")),
      "SecretAccessKey",
    ),
    "no secret",
  )
  assert(
    contains(assumedFailure("AssumeRole", replace(whole, "AccessKeyId", "Nothing")), "AccessKeyId"),
    "no key id",
  )
  assert(
    contains(
      assumedFailure("AssumeRole", replace(whole, "SessionToken", "Nothing")),
      "SessionToken",
    ),
    "no token",
  )
  assert(
    contains(assumedFailure("AssumeRole", replace(whole, "Expiration", "Nothing")), "Expiration"),
    "no expiry",
  )
}

test "a 200 whose body is not the operation's response is an error" {
  assert(
    contains(assumedFailure("AssumeRole", webIdentityXml), "AssumeRoleResponse"),
    "the other operation's response",
  )
  assert(
    contains(
      assumedFailure("AssumeRole", "<AssumeRoleResponse></AssumeRoleResponse>"),
      "AssumeRoleResult",
    ),
    "no result element",
  )
  assert(contains(assumedFailure("AssumeRole", "not xml"), "not well-formed"), "not xml")
  assert(contains(assumedFailure("AssumeRole", ""), "not well-formed"), "empty body")
  assert(
    contains(
      assumedFailure("AssumeRole", "<!DOCTYPE x [<!ENTITY a \"b\">]><AssumeRoleResponse/>"),
      "not well-formed",
    ),
    "a DTD is refused",
  )
  let bad = replace(assumeRoleXml(docToken), "2019-11-09T13:34:41Z", "yesterday")
  assert(contains(assumedFailure("AssumeRole", bad), "Expiration"), "a bad expiry")
  let badInt = replace(assumeRoleXml(docToken), ">6<", ">six<")
  assert(contains(assumedFailure("AssumeRole", badInt), "PackedPolicySize"), "a bad integer")
}

// --- errors --------------------------------------------------------------------

test "the awsQuery protocol test error body parses to its type, code, message and request id" {
  let e = stsErrorOf(reply(400, invalidGreeting))
  assert(
    e.status == 400 && e.code == "InvalidGreeting" && e.errorType == "Sender",
    "${e.message()}",
  )
  assert(e.detail == "Hi" && e.requestId == "foo-id", "${e.message()}")
  assert(
    e.message() == "aws: sts: InvalidGreeting: Hi (status 400, request id foo-id)",
    e.message(),
  )
}

test "an STS ErrorResponse parses, with the header's request id when there is one" {
  let e = stsErrorOf(reply(400, expiredToken))
  assert(
    e.code == "ExpiredTokenException" && e.requestId == "7a62c49f-347e-4fc4-9331-6e8eEXAMPLE",
    e.message(),
  )
  let h = stsErrorOf(reply(400, expiredToken, "X-Amzn-RequestId: hdr-id\r\n"))
  assert(h.requestId == "hdr-id", h.message())
}

test "an Errors/Error wrapper is read as the SDK does" {
  let body = "<ErrorResponse><Errors><Error><Type>Receiver</Type><Code>ServiceUnavailable</Code><Message>try later</Message></Error></Errors><RequestId>r1</RequestId></ErrorResponse>"
  let e = stsErrorOf(reply(503, body))
  assert(
    e.code == "ServiceUnavailable" && e.errorType == "Receiver" && e.detail == "try later",
    e.message(),
  )
}

test "an error without a code is NotFound for a 404 and Unknown otherwise, never a parse failure" {
  assert(stsErrorOf(reply(404, "")).code == "NotFound", "404 with no body")
  let html = stsErrorOf(reply(503, "<html><body>Service Unavailable</body></html>"))
  assert(html.code == "Unknown" && html.status == 503, html.message())
  let junk = stsErrorOf(reply(502, "<<<"))
  assert(junk.code == "Unknown" && contains(junk.detail, "not well-formed XML"), junk.message())
  let nocode = stsErrorOf(
    reply(400, "<ErrorResponse><Error><Message>m</Message></Error></ErrorResponse>"),
  )
  assert(nocode.code == "Unknown" && nocode.detail == "m", nocode.message())
}

test "a long error message is cut, so a hostile endpoint cannot fill a log" {
  let long = repeat("x", 5000)
  let e = stsErrorOf(
    reply(
      400,
      "<ErrorResponse><Error><Code>C</Code><Message>" + long + "</Message></Error></ErrorResponse>",
    ),
  )
  assert(len(e.detail) == 1024, "detail is ${len(e.detail)} bytes")
}

// --- the whole call against a fake server ----------------------------------------

// What the fake server saw, and what it answers.
class Seen {
  status: int,
  answer: string,
  method: string,
  path: string,
  headers: string,
  body: string,
  hits: int,
}

fn record(seen: Seen, req: Request): Response {
  seen.method = req.method
  seen.path = req.path
  seen.headers = req.headers
  seen.body = req.body
  seen.hits = seen.hits + 1
  return reply(seen.status, seen.answer)
}

fn fakeServe(s: Server, seen: Seen) {
  listenAndServeOn(s, (req) => record(seen, req)) catch _ {
    return
  }
}

fn clientFor(port: int): StsClient {
  return StsClient(StsOptions{ region = "us-east-1", endpoint = "http://127.0.0.1:${port}" }) catch e {
    panic(e.message())
  }
}

test "AssumeRole over the wire: a signed form POST to /, the response parsed" {
  let seen = Seen{ status = 200, answer = assumeRoleXml(docToken) }
  let s = serve("127.0.0.1", 0) catch e {
    panic("serve: ${e.message()}")
  }
  let port = s.port() catch e {
    panic("port: ${e.message()}")
  }
  spawn fakeServe(s, seen)
  let client = clientFor(port)
  client.amzDate = fixedDate
  let cred = AwsCredential(
    accessKeyId = "AKIDEXAMPLE",
    secretAccessKey = secretKey,
    sessionToken = sessionTokenText,
  ) catch e {
    panic(e.message())
  }
  let input = assumeInput(session = "wire-session")
  let got = client.assumeRole(cred, input) catch e {
    s.close()
    panic("assumeRole: ${e.message()}")
  }
  s.close()
  assert(
    seen.hits == 1 && seen.method == "POST" && seen.path == "/",
    "${seen.method} ${seen.path} x${seen.hits}",
  )
  assert(seen.body == assumeRoleBody(input), "body: ${seen.body}")
  assert(
    httpHeader(seen.headers, "content-type") == "application/x-www-form-urlencoded",
    "content-type",
  )
  let auth = httpHeader(seen.headers, "authorization")
  assert(
    contains(auth, "Credential=AKIDEXAMPLE/20150830/us-east-1/sts/aws4_request"),
    "authorization: ${auth}",
  )
  assert(
    contains(auth, "SignedHeaders=content-type;host;x-amz-date;x-amz-security-token"),
    "signed headers: ${auth}",
  )
  assert(httpHeader(seen.headers, "x-amz-date") == "20150830T123600Z", "x-amz-date")
  assert(
    httpHeader(seen.headers, "x-amz-security-token") == sessionTokenText,
    "x-amz-security-token",
  )
  assert(
    got.credentials.accessKeyId == "ASIAIOSFODNN7EXAMPLE" && got.credentials.token() == docToken,
    "credentials",
  )
}

test "AssumeRoleWithWebIdentity over the wire is unsigned and carries the token in the body only" {
  let seen = Seen{ status = 200, answer = webIdentityXml }
  let s = serve("127.0.0.1", 0) catch e {
    panic("serve: ${e.message()}")
  }
  let port = s.port() catch e {
    panic("port: ${e.message()}")
  }
  spawn fakeServe(s, seen)
  let input = AssumeRoleWithWebIdentityInput{
    roleArn = demoRole,
    roleSessionName = "app1",
    webIdentityToken = "web-token-value",
  }
  let got = clientFor(port).assumeRoleWithWebIdentity(input) catch e {
    s.close()
    panic("assumeRoleWithWebIdentity: ${e.message()}")
  }
  s.close()
  assert(seen.body == webIdentityBody(input), "body: ${seen.body}")
  assert(contains(seen.body, "&WebIdentityToken=web-token-value"), "token in the body")
  assert(httpHeader(seen.headers, "authorization") == "", "the call must not be signed")
  assert(httpHeader(seen.headers, "x-amz-security-token") == "", "no session token header")
  assert(!contains(seen.headers, "web-token-value"), "the token must not travel in a header")
  assert(got.credentials.accessKeyId == "ASgeIAIOSFODNN7EXAMPLE", "credentials")
}

test "an error status over the wire is an StsError with the service's code" {
  let seen = Seen{ status = 400, answer = expiredToken }
  let s = serve("127.0.0.1", 0) catch e {
    panic("serve: ${e.message()}")
  }
  let port = s.port() catch e {
    panic("port: ${e.message()}")
  }
  spawn fakeServe(s, seen)
  let input = AssumeRoleWithWebIdentityInput{
    roleArn = demoRole,
    roleSessionName = "app1",
    webIdentityToken = "web-token-value",
  }
  clientFor(port).assumeRoleWithWebIdentity(input) catch err {
    s.close()
    let (typed, ok) = err.(StsError)
    assert(ok, "not an StsError: ${err.message()}")
    assert(
      typed.code == "ExpiredTokenException" && typed.status == 400 && typed.errorType == "Sender",
      err.message(),
    )
    assert(!contains(err.message(), "web-token-value"), "the error quotes the token")
    return
  }
  s.close()
  assert(false, "a 400 was a success")
}

test "a server that is not there is an error, not a hang" {
  let s = serve("127.0.0.1", 0) catch e {
    panic("serve: ${e.message()}")
  }
  let port = s.port() catch e {
    panic("port: ${e.message()}")
  }
  s.close()
  let input = AssumeRoleWithWebIdentityInput{
    roleArn = demoRole,
    roleSessionName = "app1",
    webIdentityToken = "web-token-value",
  }
  clientFor(port).assumeRoleWithWebIdentity(input) catch err {
    assert(!contains(err.message(), "web-token-value"), "the error quotes the token")
    return
  }
  assert(false, "a closed port answered")
}
