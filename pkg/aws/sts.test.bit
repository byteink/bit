// pkg/aws/sts.test.bit — sts.bit against the AWS STS API reference examples
// (docs.aws.amazon.com/STS/latest/APIReference/API_AssumeRole.html and
// API_AssumeRoleWithWebIdentity.html, copied), the awsQuery protocol tests of
// smithy-aws-protocol-tests (smithy-lang/smithy bd0ed9e054b29874a5bec389e16d8c4db9dc9b94,
// model/awsQuery/input-lists.smithy and xml-errors.smithy), and a fake STS
// server on loopback.
//
// The reference examples list a request's parameters in an order of their own;
// the SDK writes them in the order of the schema. So a body is checked twice: as
// the exact string the SDK serializer produces, and as the same set of decoded
// parameters the reference example shows.

import { contains, join, split } from "std/strings"
import { Timestamp, parseRfc3339 } from "std/time"

const demoRole: string = "arn:aws:iam::123456789012:role/demo"
const secretKey: string = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
const sessionTokenText: string = "AQoDYXdzEPT//////////wEXAMPLEtoken"

// The reference example of AssumeRole, parameters in the document's order, the
// `&AUTHPARAMS` placeholder dropped.
const docAssumeRoleQuery: string = "Version=2011-06-15&Action=AssumeRole&RoleSessionName=testAR&RoleArn=arn:aws:iam::123456789012:role/demo&PolicyArns.member.1.arn=arn:aws:iam::123456789012:policy/demopolicy1&PolicyArns.member.2.arn=arn:aws:iam::123456789012:policy/demopolicy2&Policy=JSON-IAM-POLICY&DurationSeconds=3600&Tags.member.1.Key=Project&Tags.member.1.Value=Pegasus&Tags.member.2.Key=Team&Tags.member.2.Value=Engineering&Tags.member.3.Key=Cost-Center&Tags.member.3.Value=12345&TransitiveTagKeys.member.1=Project&TransitiveTagKeys.member.2=Cost-Center&ExternalId=123ABC&SourceIdentity=Alice"

// The same for AssumeRoleWithWebIdentity; the document wraps the token over five
// lines, joined here.
const docWebIdentityQuery: string = "Action=AssumeRoleWithWebIdentity&DurationSeconds=3600&PolicyArns.member.1.arn=arn:aws:iam::123456789012:policy/webidentitydemopolicy1&PolicyArns.member.2.arn=arn:aws:iam::123456789012:policy/webidentitydemopolicy2&ProviderId=www.amazon.com&RoleSessionName=app1&RoleArn=arn:aws:iam::123456789012:role/FederatedWebIdentityRole&WebIdentityToken=Atza%7CIQEBLjAsAhRFiXuWpUXuRvQ9PZL3GMFcYevydwIUFAHZwXZXXXXXXXXXJnrulxKDHwy87oGKPznh0D6bEQZTSCzyoCtL_8S07pLpr0zMbn6w1lfVZKNTBdDansFBmtGnIsIapjI6xKR02Yc_2bQ8LZbUXSGm6Ry6_BG7PrtLZtj_dfCTj92xNGed-CrKqjG7nPBjNIL016GGvuS5gSvPRUxWES3VYfm1wl7WTI7jn-Pcb6M-buCgHhFOzTQxod27L9CqnOLio7N3gZAGpsp6n1-AJBOCJckcyXe2c6uD0srOJeZlKUm2eTDVMf8IehDVI0r1QOnTV6KzzAI3OY87Vd_cVMQ&Version=2011-06-15"

fn assumeInput(
  session: string = "testAR",
  policyArns: Option<[]string> = Option.None,
  tags: Option<[]StsTag> = Option.None,
): AssumeRoleInput {
  return AssumeRoleInput{
    roleArn = demoRole,
    roleSessionName = session,
    policyArns = policyArns,
    tags = tags,
  }
}

// The decoded `key=value` parameters of a form body, sorted.
fn paramSet(body: string): []string {
  let out = []string(0)
  for pair of split(body, "&") {
    out = append(out, percentDecode(pair))
  }
  return sortStrings(out)
}

fn sortStrings(xs: []string): []string {
  let out = xs
  let i = 1
  while (i < len(out)) {
    let key = out[i]
    let j = i - 1
    while (j >= 0 && key < out[j]) {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  return out
}

fn sameSet(got: string, want: string): bool {
  return join(paramSet(got), "\n") == join(paramSet(want), "\n")
}

// --- request bodies ----------------------------------------------------------

test "AssumeRole serializes the reference example, in schema order, percent-encoded" {
  let input = AssumeRoleInput{
    roleArn = demoRole,
    roleSessionName = "testAR",
    policyArns = [
      "arn:aws:iam::123456789012:policy/demopolicy1",
      "arn:aws:iam::123456789012:policy/demopolicy2",
    ],
    policy = "JSON-IAM-POLICY",
    durationSeconds = 3600,
    tags = [
      StsTag{ key = "Project", value = "Pegasus" },
      StsTag{ key = "Team", value = "Engineering" },
      StsTag{ key = "Cost-Center", value = "12345" },
    ],
    transitiveTagKeys = ["Project", "Cost-Center"],
    externalId = "123ABC",
    sourceIdentity = "Alice",
  }
  let body = assumeRoleBody(input)
  let want = "Action=AssumeRole&Version=2011-06-15&RoleArn=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2Fdemo&RoleSessionName=testAR&PolicyArns.member.1.arn=arn%3Aaws%3Aiam%3A%3A123456789012%3Apolicy%2Fdemopolicy1&PolicyArns.member.2.arn=arn%3Aaws%3Aiam%3A%3A123456789012%3Apolicy%2Fdemopolicy2&Policy=JSON-IAM-POLICY&DurationSeconds=3600&Tags.member.1.Key=Project&Tags.member.1.Value=Pegasus&Tags.member.2.Key=Team&Tags.member.2.Value=Engineering&Tags.member.3.Key=Cost-Center&Tags.member.3.Value=12345&TransitiveTagKeys.member.1=Project&TransitiveTagKeys.member.2=Cost-Center&ExternalId=123ABC&SourceIdentity=Alice"
  assert(body == want, "body:\n${body}\nwant:\n${want}")
  assert(
    sameSet(body, docAssumeRoleQuery),
    "the parameters differ from the reference example:\n${body}",
  )
}

test "AssumeRoleWithWebIdentity serializes the reference example" {
  let token = "Atza|IQEBLjAsAhRFiXuWpUXuRvQ9PZL3GMFcYevydwIUFAHZwXZXXXXXXXXXJnrulxKDHwy87oGKPznh0D6bEQZTSCzyoCtL_8S07pLpr0zMbn6w1lfVZKNTBdDansFBmtGnIsIapjI6xKR02Yc_2bQ8LZbUXSGm6Ry6_BG7PrtLZtj_dfCTj92xNGed-CrKqjG7nPBjNIL016GGvuS5gSvPRUxWES3VYfm1wl7WTI7jn-Pcb6M-buCgHhFOzTQxod27L9CqnOLio7N3gZAGpsp6n1-AJBOCJckcyXe2c6uD0srOJeZlKUm2eTDVMf8IehDVI0r1QOnTV6KzzAI3OY87Vd_cVMQ"
  let input = AssumeRoleWithWebIdentityInput{
    roleArn = "arn:aws:iam::123456789012:role/FederatedWebIdentityRole",
    roleSessionName = "app1",
    webIdentityToken = token,
    providerId = "www.amazon.com",
    policyArns = [
      "arn:aws:iam::123456789012:policy/webidentitydemopolicy1",
      "arn:aws:iam::123456789012:policy/webidentitydemopolicy2",
    ],
    durationSeconds = 3600,
  }
  let body = webIdentityBody(input)
  let want = "Action=AssumeRoleWithWebIdentity&Version=2011-06-15&RoleArn=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2FFederatedWebIdentityRole&RoleSessionName=app1&WebIdentityToken=" +
    percentEncode(token) +
    "&ProviderId=www.amazon.com&PolicyArns.member.1.arn=arn%3Aaws%3Aiam%3A%3A123456789012%3Apolicy%2Fwebidentitydemopolicy1&PolicyArns.member.2.arn=arn%3Aaws%3Aiam%3A%3A123456789012%3Apolicy%2Fwebidentitydemopolicy2&DurationSeconds=3600"
  assert(body == want, "body:\n${body}\nwant:\n${want}")
  assert(contains(body, "WebIdentityToken=Atza%7CIQEB"), "the | of the token is not %7C")
  assert(
    sameSet(body, docWebIdentityQuery),
    "the parameters differ from the reference example:\n${body}",
  )
}

test "a member that is not set is not written, a list that is set and empty is Name=" {
  let bare = assumeRoleBody(assumeInput())
  assert(
      bare ==
      "Action=AssumeRole&Version=2011-06-15&RoleArn=arn%3Aaws%3Aiam%3A%3A123456789012%3Arole%2Fdemo&RoleSessionName=testAR",
    "bare: ${bare}",
  )
  // awsQuery protocol test EmptyQueryLists: `ListArg=` for a set, empty list.
  let empty = assumeRoleBody(assumeInput(policyArns = []string(0), tags = []StsTag(0)))
  assert(contains(empty, "&RoleSessionName=testAR&PolicyArns=&Tags="), "empty lists: ${empty}")
}

test "keys and values are encoded as extendedEncodeURIComponent does" {
  let tags = [StsTag{ key = "k e/y", value = "a!b'c(d)e*f é+&=" }]
  let body = assumeRoleBody(assumeInput(tags = tags))
  assert(
    contains(
      body,
      "&Tags.member.1.Key=k%20e%2Fy&Tags.member.1.Value=a%21b%27c%28d%29e%2Af%20%C3%A9%2B%26%3D",
    ),
    "encoding: ${body}",
  )
}

// --- inputs fail loudly --------------------------------------------------------

fn assumeFailure(roleArn: string, session: string, duration: Option<int> = Option.None): string {
  let input = AssumeRoleInput{
    roleArn = roleArn,
    roleSessionName = session,
    durationSeconds = duration,
  }
  input.check() catch e {
    return e.message()
  }
  return ""
}

test "an input STS would refuse fails in check, naming the field and never the value" {
  assert(contains(assumeFailure("", "testAR"), "RoleArn"), "empty arn")
  assert(contains(assumeFailure(demoRole, "x"), "RoleSessionName"), "one-character session name")
  let long = assumeFailure(
    demoRole,
    "0123456789012345678901234567890123456789012345678901234567890123456789",
  )
  assert(contains(long, "RoleSessionName"), "long session name")
  let bad = assumeFailure(demoRole, "bad name!")
  assert(contains(bad, "RoleSessionName") && !contains(bad, "bad name"), "bad character: ${bad}")
  assert(contains(assumeFailure(demoRole, "testAR", 899), "DurationSeconds"), "899")
  assert(contains(assumeFailure(demoRole, "testAR", 43201), "DurationSeconds"), "43201")
  assert(assumeFailure(demoRole, "testAR", 900) == "", "900 is the minimum")
  assert(
    assumeFailure(demoRole, "a_b+c=d,e.f@g-h", 43200) == "",
    "43200 and every legal session character",
  )
  let noToken = AssumeRoleWithWebIdentityInput{
    roleArn = demoRole,
    roleSessionName = "testAR",
    webIdentityToken = "",
  }
  noToken.check() catch e {
    assert(contains(e.message(), "WebIdentityToken"), "empty token: ${e.message()}")
    return
  }
  assert(false, "an empty web identity token was accepted")
}

test "the calls check their input before any request" {
  let client = StsClient(StsOptions{ region = "us-east-1", endpoint = "http://127.0.0.1:1" }) catch e {
    panic(e.message())
  }
  let cred = AwsCredential(accessKeyId = "AKIDEXAMPLE", secretAccessKey = secretKey) catch e {
    panic(e.message())
  }
  client.assumeRole(cred, assumeInput(session = "x")) catch e {
    assert(contains(e.message(), "RoleSessionName"), "message: ${e.message()}")
    return
  }
  assert(false, "an invalid input was sent")
}

// --- signing ---------------------------------------------------------------------

fn fixedDate(): string {
  return "20150830T123600Z"
}

fn headerValue(hs: []SigHeader, name: string): string {
  for h of hs {
    if (h.name == name) {
      return h.value
    }
  }
  return "<absent>"
}

// Oracle: the Authorization value below was computed by an independent
// implementation of SigV4 (Python hmac/hashlib, not this package's code) for the
// canonical request `POST / ` with headers content-type, host, x-amz-date and
// x-amz-security-token, service `sts`, region us-east-1, date 20150830T123600Z.
test "AssumeRole is signed for service sts, without x-amz-content-sha256" {
  let client = StsClient(StsOptions{ region = "us-east-1" }) catch e {
    panic(e.message())
  }
  client.amzDate = fixedDate
  let cred = AwsCredential(
    accessKeyId = "AKIDEXAMPLE",
    secretAccessKey = secretKey,
    sessionToken = sessionTokenText,
  ) catch e {
    panic(e.message())
  }
  let body = assumeRoleBody(assumeInput())
  let hs = client.signedHeaders(cred, "sts.us-east-1.amazonaws.com", body) catch e {
    panic(e.message())
  }
  let want = "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/sts/aws4_request, SignedHeaders=content-type;host;x-amz-date;x-amz-security-token, Signature=b6f5a5ea00befd358f78661fbd106be2daf096bc272ac399df52665aaffc4776"
  assert(
    headerValue(hs, "authorization") == want,
    "authorization: ${headerValue(hs, "authorization")}",
  )
  assert(headerValue(hs, "x-amz-date") == "20150830T123600Z", "x-amz-date")
  assert(headerValue(hs, "x-amz-security-token") == sessionTokenText, "x-amz-security-token")
  assert(headerValue(hs, "x-amz-content-sha256") == "<absent>", "STS takes no x-amz-content-sha256")
}

test "the global endpoint is signed for us-east-1" {
  let client = StsClient(StsOptions{ region = "eu-west-1", useGlobalEndpoint = true }) catch e {
    panic(e.message())
  }
  client.amzDate = fixedDate
  let cred = AwsCredential(accessKeyId = "AKIDEXAMPLE", secretAccessKey = secretKey) catch e {
    panic(e.message())
  }
  let hs = client.signedHeaders(cred, "sts.amazonaws.com", "Action=AssumeRole") catch e {
    panic(e.message())
  }
  assert(
    contains(
      headerValue(hs, "authorization"),
      "Credential=AKIDEXAMPLE/20150830/us-east-1/sts/aws4_request",
    ),
    "scope",
  )
}

test "a client without a region, or with a negative timeout, fails when built" {
  StsClient(StsOptions{ region = "" }) catch e {
    assert(contains(e.message(), "region"), "region: ${e.message()}")
    StsClient(StsOptions{ region = "us-east-1", timeoutMs = 0 - 1 }) catch e2 {
      assert(contains(e2.message(), "timeoutMs"), "timeout: ${e2.message()}")
      return
    }
    assert(false, "a negative timeout was accepted")
    return
  }
  assert(false, "an empty region was accepted")
}
