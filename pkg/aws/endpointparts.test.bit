// pkg/aws/endpointparts.test.bit — endpoint parsing and host-header derivation
// (endpointparts.bit), at the unit level (no network).

test "parseEndpoint reads scheme, host and an explicit port" {
  let parts = parseEndpoint("http://127.0.0.1:9000") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(!parts.https, "expected cleartext")
  assert(parts.host == "127.0.0.1", "host = ${parts.host}")
  assert(parts.port == 9000, "port = ${parts.port}")
}

test "parseEndpoint defaults the port per scheme when none is given" {
  let http = parseEndpoint("http://s3.example.com") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(http.port == 80, "http default port = ${http.port}")

  let https = parseEndpoint("https://s3.example.com") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(https.port == 443, "https default port = ${https.port}")
}

test "parseEndpoint fails without an http:// or https:// scheme" {
  parseEndpoint("s3.example.com:9000") catch e {
    assert(indexOf(e.message(), "http://") >= 0, "message = ${e.message()}")
    return
  }
  assert(false, "parseEndpoint accepted a schemeless endpoint")
}

test "signedHostValue omits the port only at the scheme's default" {
  let custom = parseEndpoint("http://127.0.0.1:9000") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(signedHostValue(custom) == "127.0.0.1:9000", "custom port = ${signedHostValue(custom)}")

  let defaultHttps = parseEndpoint("https://s3.amazonaws.com") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(
    signedHostValue(defaultHttps) == "s3.amazonaws.com",
    "default port = ${signedHostValue(defaultHttps)}",
  )
}
