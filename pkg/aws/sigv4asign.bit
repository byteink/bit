import {
  digest as sigV4aDigest, Sha256 as SigV4aSha256,
  HashAlg as SigV4aSignHash, ecdsaSign as sigV4aEcdsaSign,
  ecdsaSignatureToDer as sigV4aSignatureDer,
} from "std/crypto"

fn sigV4aSignError(): error {
  return newError("aws: sigv4a: invalid signing input")
}

fn sigV4aServiceChar(value: byte): bool {
  return (value >= 'a' && value <= 'z') ||
    (value >= 'A' && value <= 'Z') ||
    (value >= '0' && value <= '9') ||
    value == '-'
}

fn sigV4aCheckService(service: string): ()! {
  if (len(service) == 0 || len(service) > 128) {
    fail sigV4aSignError()
  }
  for value of []byte(service) {
    if (!sigV4aServiceChar(value)) {
      fail sigV4aSignError()
    }
  }
}

fn sigV4aMessage(amzDate: string, service: string, canonical: string): string! {
  if (len(amzDate) != 16 || len(canonical) > 1048576) {
    fail sigV4aSignError()
  }
  checkAmzDate(amzDate) catch _ {
    fail sigV4aSignError()
  }
  sigV4aCheckService(service)?
  // SigV4a binds its region set in the canonical request, not the scope.
  return "AWS4-ECDSA-P256-SHA256\n${amzDate}\n${amzDate[0:8]}/${service}/aws4_request\n${sha256Hex(canonical)}"
}

fn sigV4aSign(
  accessKeyId: string,
  secretAccessKey: string,
  amzDate: string,
  service: string,
  canonical: string,
): string! {
  let message = sigV4aMessage(amzDate, service, canonical)?
  let key = sigV4aKey(accessKeyId, secretAccessKey) catch _ {
    fail sigV4aSignError()
  }
  let signature = sigV4aEcdsaSign(
    key,
    sigV4aDigest(SigV4aSha256(), []byte(message)),
    SigV4aSignHash.Sha256,
  ) catch _ {
    fail sigV4aSignError()
  }
  return encodeHex(sigV4aSignatureDer(signature))
}
