// A refreshed token is installed only after a bounded, private atomic write.
import { Sha1 } from "std/crypto"
import { createExclusive as ssoCreate } from "std/fs/secure"
import { File as SsoFile, rename as ssoRename, remove as ssoRemove } from "std/fs"
import { uuidV4 as ssoUuid, format as ssoUuidText } from "std/uuid"

const ssoMaxBytes: int = 65536

fn ssoCachePath(home: string, key: string): string {
  return pathJoin(home, ".aws/sso/cache/${encodeHex(digest(Sha1(), []byte(key)))}.json")
}

fn ssoRead(path: string): Json! {
  let file = openRegular(path) catch _ {
    fail ssoLoginError()
  }
  defer file.close()
  return ssoReadFile(file)?
}

// Callers own the descriptor and choose their symlink policy.
fn ssoReadFile(file: SsoFile): Json! {
  let data = []byte(ssoMaxBytes + 1)
  let total = 0
  while (total < len(data)) {
    let n = file.readAt(data[total:len(data)], i64(total)) catch _ {
      fail ssoLoginError()
    }
    if (n == 0) {
      return jsonParse(string(data[0:total])) catch _ {
        fail ssoLoginError()
      }
    }
    total = total + n
  }
  fail ssoLoginError()
}

fn ssoSet(value: Json, key: string, replacement: Json): Json {
  let entries = match (value) {
    JsonObject(items) => items
    _ => []JsonEntry(0)
  }
  let updated = []JsonEntry(0)
  for entry of entries {
    if (entry.key != key) {
      updated = append(updated, entry)
    }
  }
  return Json.JsonObject(append(updated, JsonEntry{ key = key, value = replacement }))
}

fn ssoWriteFile(file: SsoFile, text: string): ()! {
  defer file.close()
  file.write(text)?
  file.sync()?
}

fn ssoOpen(path: string): SsoFile! {
  match (ssoCreate(path, 0o600)?) {
    Some(file) => return file
    None => { fail ssoLoginError() }
  }
}

fn ssoWrite(path: string, value: Json): ()! {
  let text = ssoEncode(value)
  if (len(text) > ssoMaxBytes) {
    fail ssoLoginError()
  }
  let temp = path + "." + ssoUuidText(ssoUuid()) + ".tmp"
  let file = ssoOpen(temp)?
  ssoWriteFile(file, text) catch _ {
    ssoRemove(temp) catch _ {}
    fail ssoLoginError()
  }
  ssoRename(temp, path) catch _ {
    ssoRemove(temp) catch _ {}
    fail ssoLoginError()
  }
}

fn ssoTokenExpiry(value: Json): int! {
  let expiry = parseRfc3339(ssoText(value, "expiresAt")?) catch _ {
    fail ssoLoginError()
  }
  return expiry.ns
}

fn ssoTryRefresh(value: Json, path: string, oidc: string, timestamp: int): string! {
  let updated = ssoRefresh(value, oidc, timestamp)?
  ssoWrite(path, updated)?
  return ssoText(updated, "accessToken")?
}

fn ssoAccessToken(config: SsoConfig, path: string, oidc: string, timestamp: int): string! {
  let value = ssoRead(path)?
  let token = ssoText(value, "accessToken")?
  let expiry = ssoTokenExpiry(value)?
  if (expiry > timestamp && expiry - timestamp > refreshWindow) {
    return token
  }
  if (config.session != "") {
    return ssoTryRefresh(value, path, oidc, timestamp) catch _ {
      if (expiry > timestamp) {
        return token
      }
      fail ssoLoginError()
    }
  }
  if (expiry <= timestamp) {
    fail ssoLoginError()
  }
  return token
}
