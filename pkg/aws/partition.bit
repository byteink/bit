// pkg/aws/partition.bit — which AWS partition a region belongs to, and the
// DNS suffixes and capabilities of that partition. The table is
// gen_partitions.bit, generated from the pinned partitions.json.

import { mustCompile } from "std/regex"

// The `Partition` structure of `aws.partition`.
export class Partition {
  export name: string,
  export dnsSuffix: string,
  export dualStackDnsSuffix: string,
  export supportsFIPS: bool,
  export supportsDualStack: bool,
  export implicitGlobalRegion: string,
}

fn regionListed(regions: []string, region: string): bool {
  for r of regions {
    if (r == region) {
      return true
    }
  }
  return false
}

// The `Partition` a table row describes.
fn partitionOfRow(row: PartitionRow): Partition {
  return Partition{
    name = row.name,
    dnsSuffix = row.dnsSuffix,
    dualStackDnsSuffix = row.dualStackDnsSuffix,
    supportsFIPS = row.supportsFIPS,
    supportsDualStack = row.supportsDualStack,
    implicitGlobalRegion = row.implicitGlobalRegion,
  }
}

// `aws.partition`: the partition that lists `region` by name, else the first
// whose pattern matches it, else `aws`, as in every AWS SDK
// (aws-sdk-js-v3 054298b1520f, util-endpoints `partition`), so the rule that
// checks the region name (S3's "region was not a valid DNS name") still runs.
// The table is `partitionRows` (gen_partitions.bit, partitions.json 1.1).
export fn awsPartition(region: string): Partition {
  let rows = partitionRows()
  for row of rows {
    if (regionListed(row.regions, region)) {
      return partitionOfRow(row)
    }
  }
  for row of rows {
    if (mustCompile(row.regionRegex).matches(region)) {
      return partitionOfRow(row)
    }
  }
  for row of rows {
    if (row.name == "aws") {
      return partitionOfRow(row)
    }
  }
  panic("partitions.json has no aws partition")
}

