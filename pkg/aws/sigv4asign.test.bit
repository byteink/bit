// Published get-vanilla fixtures at aws-c-auth 84a26ea184d9ccd322c8164759510b3604ab13fd.
import {
  ecdsaPublicKey as sigV4aReadPublic, ecdsaSignatureFromDer as sigV4aReadSignature,
  ecdsaVerify as sigV4aVerify,
} from "std/crypto"

class SigV4aSignVector {
  name: string,
  canonical: string,
  message: string,
}

fn sigV4aSignVectors(): []SigV4aSignVector {
  return [
    SigV4aSignVector{
      name = "base",
      canonical = "GET\n/\n\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\ncf59db423e841c8b7e3444158185aa261b724a5c27cbe762676f3eed19f4dc02",
    },
    SigV4aSignVector{
      name = "header-",
      canonical = "GET\n/\n\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\ncf59db423e841c8b7e3444158185aa261b724a5c27cbe762676f3eed19f4dc02",
    },
    SigV4aSignVector{
      name = "query-",
      canonical = "GET\n/\nX-Amz-Algorithm=AWS4-ECDSA-P256-SHA256&X-Amz-Credential=AKIDEXAMPLE%2F20150830%2Fservice%2Faws4_request&X-Amz-Date=20150830T123600Z&X-Amz-Expires=3600&X-Amz-Region-Set=us-east-1&X-Amz-SignedHeaders=host\nhost:example.amazonaws.com\n\nhost\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\n890c4ed28c1a1ac10b5862719b537afbe392e987dc1aab1efa16fe7de41d3c81",
    },
  ]
}

test "SigV4a signing matches all three published messages and public-key verifications" {
  let public = sigV4aReadPublic(
    sigV4aCurve(),
    sigV4aTestBytes("04b6618f6a65740a99e650b33b6b4b5bd0d43b176d721a3edfea7e7d2d56d936b1865ed22a7eadc9c5cb9d2cbaca1b3699139fedc5043dc6661864218330c8e518"),
  ) catch e {
    panic(e.message())
  }
  let checked = 0
  for vector of sigV4aSignVectors() {
    let message = sigV4aMessage("20150830T123600Z", "service", vector.canonical) catch e {
      panic(e.message())
    }
    assert(message == vector.message, "published SigV4a message")
    let signature = sigV4aSign(
      "AKIDEXAMPLE",
      "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
      "20150830T123600Z",
      "service",
      vector.canonical,
    ) catch e {
      panic(e.message())
    }
    let decoded = sigV4aReadSignature(sigV4aTestBytes(signature)) catch e {
      panic(e.message())
    }
    assert(
      sigV4aVerify(public, sigV4aDigest(SigV4aSha256(), []byte(vector.message)), decoded),
      "published point verifies DER signature",
    )
    assert(
      !sigV4aVerify(
        public,
        sigV4aDigest(SigV4aSha256(), []byte(vector.message + "tampered")),
        decoded,
      ),
      "changed message rejected",
    )
    let bytes = sigV4aTestBytes(signature)
    bytes[len(bytes) - 1] = bytes[len(bytes) - 1] ^ 1
    let changed = sigV4aReadSignature(bytes) catch e {
      panic(e.message())
    }
    assert(
      !sigV4aVerify(public, sigV4aDigest(SigV4aSha256(), []byte(vector.message)), changed),
      "changed signature rejected",
    )
    checked = checked + 1
  }
  assert(checked == 3, "all 3 of 3 published fixtures checked")
}

fn sigV4aSignRejected(date: string, service: string, canonical: string) {
  let message = ""
  sigV4aMessage(date, service, canonical) catch e {
    message = e.message()
  }
  assert(message == sigV4aSignError().message(), "fixed secret-free input error")
}

test "SigV4a signing bounds reject malformed dates and scope injection" {
  for date of [
    repeat("x", 1048576),
    "sentinel-date-secret",
    "20150830T123600Z\nsentinel-secret",
    "20150830X123600Z",
  ] {
    sigV4aSignRejected(date, "service", "canonical")
  }
  for service of ["", repeat("x", 129), "a/b", "a\nsentinel-service-secret", "a:b", "a b"] {
    sigV4aSignRejected("20150830T123600Z", service, "canonical")
  }
  sigV4aSignRejected("20150830T123600Z", "service", repeat("x", 1048577))
  let valid = sigV4aMessage("20150830T123600Z", repeat("s", 128), repeat("x", 1048576)) catch e {
    panic(e.message())
  }
  assert(len(valid) > 128, "exact input bounds accepted")
}

test "SigV4a signing never exposes invalid credential values" {
  for secret of ["", "sentinel-secret\n"] {
    let message = ""
    sigV4aSign("AKIDEXAMPLE", secret, "20150830T123600Z", "service", "canonical") catch e {
      message = e.message()
    }
    assert(message == sigV4aSignError().message(), "fixed secret-free key error")
  }
}
