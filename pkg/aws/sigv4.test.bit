// pkg/aws/sigv4.test.bit — sigv4.bit checked against AWS's own published
// test suite (`aws-sig-v4-test-suite`, Apache-2.0, Amazon-authored, mirrored
// at github.com/rhymu8354/aws-sig-v4-test-suite — the original
// docs.aws.amazon.com-hosted zip is no longer served). Every literal below
// (request, canonical request, string-to-sign, Authorization header) is
// copied byte-for-byte from that suite's `get-vanilla`, `post-vanilla`,
// `get-vanilla-query-order-key` and `post-x-www-form-urlencoded` cases, not
// re-derived from this file's own code — independently cross-checked
// against a from-scratch Python HMAC-SHA256 chain before being copied in.
//
// All four cases share the suite's fixed test credential: access key
// `AKIDEXAMPLE`, secret `wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY`, region
// `us-east-1`, service `service` (a placeholder, not literally S3 — the
// suite is generic across every AWS service SigV4 covers), date
// `20150830T123600Z`.

import { indexOf } from "std/strings"

fn testHeaders(): []SigHeader {
  return [
    SigHeader{ name = "host", value = "example.amazonaws.com" },
    SigHeader{ name = "x-amz-date", value = "20150830T123600Z" },
  ]
}

test "get-vanilla: canonical request, string-to-sign and signature match AWS's own vectors" {
  let creq = canonicalRequest("GET", "/", [](string, string)(0), testHeaders(), sha256Hex(""))
  let wantCreq = "GET\n/\n\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\n\n" +
    "host;x-amz-date\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  assert(creq == wantCreq, "canonical request:\n${creq}")

  let scope = credentialScope("20150830", "us-east-1", "service")
  assert(scope == "20150830/us-east-1/service/aws4_request", "scope = ${scope}")

  let sts = stringToSign("20150830T123600Z", scope, creq)
  let wantSts = "AWS4-HMAC-SHA256\n20150830T123600Z\n20150830/us-east-1/service/aws4_request\n" +
    "bb579772317eb040ac9ed261061d46c1f17a8133879d6129b6e1c25292927e63"
  assert(sts == wantSts, "string to sign:\n${sts}")

  let key = signingKey(
    "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    "20150830",
    "us-east-1",
    "service",
  )
  let sig = signature(key, sts)
  assert(
    sig == "5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31",
    "signature = ${sig}",
  )

  let authz = authorizationHeader("AKIDEXAMPLE", scope, signedHeaders(testHeaders()), sig)
  let wantAuthz = "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, " +
    "SignedHeaders=host;x-amz-date, Signature=5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31"
  assert(authz == wantAuthz, "authorization header:\n${authz}")
}

test "post-vanilla: same empty-body signature computation, method POST" {
  let creq = canonicalRequest("POST", "/", [](string, string)(0), testHeaders(), sha256Hex(""))
  let scope = credentialScope("20150830", "us-east-1", "service")
  let sts = stringToSign("20150830T123600Z", scope, creq)
  let wantSts = "AWS4-HMAC-SHA256\n20150830T123600Z\n20150830/us-east-1/service/aws4_request\n" +
    "553f88c9e4d10fc9e109e2aeb65f030801b70c2f6468faca261d401ae622fc87"
  assert(sts == wantSts, "string to sign:\n${sts}")

  let key = signingKey(
    "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    "20150830",
    "us-east-1",
    "service",
  )
  let sig = signature(key, sts)
  assert(
    sig == "5da7c1a2acd57cee7505fc6676e4e544621c30862966e37dddb68e92efbe5d6b",
    "signature = ${sig}",
  )
}

test "get-vanilla-query-order-key: two values under the same key sort by VALUE too" {
  let params = [("Param1", "value2"), ("Param1", "Value1")]
  let qs = canonicalQueryString(params)
  assert(qs == "Param1=Value1&Param1=value2", "query string = ${qs}")

  let creq = canonicalRequest("GET", "/", params, testHeaders(), sha256Hex(""))
  let scope = credentialScope("20150830", "us-east-1", "service")
  let sts = stringToSign("20150830T123600Z", scope, creq)
  let wantSts = "AWS4-HMAC-SHA256\n20150830T123600Z\n20150830/us-east-1/service/aws4_request\n" +
    "704b4cef673542d84cdff252633f065e8daeba5f168b77116f8b1bcaf3d38f89"
  assert(sts == wantSts, "string to sign:\n${sts}")

  let key = signingKey(
    "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    "20150830",
    "us-east-1",
    "service",
  )
  let sig = signature(key, sts)
  assert(
    sig == "eedbc4e291e521cf13422ffca22be7d2eb8146eecf653089df300a15b2382bd1",
    "signature = ${sig}",
  )
}

test "post-x-www-form-urlencoded: a non-empty payload hash and four signed headers" {
  let body = "Param1=value1"
  let headers = [
    SigHeader{ name = "content-length", value = "13" },
    SigHeader{ name = "content-type", value = "application/x-www-form-urlencoded" },
    SigHeader{ name = "host", value = "example.amazonaws.com" },
    SigHeader{ name = "x-amz-date", value = "20150830T123600Z" },
  ]
  let creq = canonicalRequest("POST", "/", [](string, string)(0), headers, sha256Hex(body))
  let wantCreq = "POST\n/\n\n" +
    "content-length:13\ncontent-type:application/x-www-form-urlencoded\n" +
    "host:example.amazonaws.com\nx-amz-date:20150830T123600Z\n\n" +
    "content-length;content-type;host;x-amz-date\n" +
    "9095672bbd1f56dfc5b65f3e153adc8731a4a654192329106275f4c7b24d0b6e"
  assert(creq == wantCreq, "canonical request:\n${creq}")

  let scope = credentialScope("20150830", "us-east-1", "service")
  let sts = stringToSign("20150830T123600Z", scope, creq)
  let wantSts = "AWS4-HMAC-SHA256\n20150830T123600Z\n20150830/us-east-1/service/aws4_request\n" +
    "a1a6cdc48a69eabac00524b1103e18f2655960c25a3c2e8de6f180e59238c68a"
  assert(sts == wantSts, "string to sign:\n${sts}")

  let key = signingKey(
    "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    "20150830",
    "us-east-1",
    "service",
  )
  let sig = signature(key, sts)
  assert(
    sig == "fec50118d90ecf934441dd37fb9a49bd7f5adb6450802ca3a0977623bbb7c27f",
    "signature = ${sig}",
  )
}

test "canonicalUri preserves / and percent-encodes everything outside the unreserved set" {
  assert(canonicalUri("") == "/", "empty path")
  assert(canonicalUri("/a/b") == "/a/b", "plain path")
  assert(canonicalUri("/a b") == "/a%20b", "space")
  assert(canonicalUri("/a~b-c_d.e") == "/a~b-c_d.e", "unreserved punctuation left alone")
}

// ---------------------------------------------------------------------------
// The four worked examples of the S3 API reference, "Authenticating Requests:
// Using the Authorization Header (AWS Signature Version 4)" ("Examples:
// Signature calculations"): credential AKIAIOSFODNN7EXAMPLE, bucket
// `examplebucket`, region us-east-1, signing time 20130524T000000Z. The
// published signatures below are the ones AWS prints (third-party S3 clients
// pin the same four strings in their own tests); none is computed here.
// ---------------------------------------------------------------------------

fn exampleConfig(): SigV4Config {
  return SigV4Config{
    accessKeyId = "AKIAIOSFODNN7EXAMPLE",
    secretKey = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
    sessionToken = "",
    region = "us-east-1",
    service = "s3",
    contentSha256Header = true,
  }
}

fn exampleSign(
  method: string,
  path: string,
  query: [](string, string),
  extra: []SigHeader,
  body: string,
): SigV4Signed {
  let headers = [SigHeader{ name = "Host", value = "examplebucket.s3.amazonaws.com" }]
  for h of extra {
    headers = append(headers, h)
  }
  let signed = signV4(
    exampleConfig(),
    SigV4Request{
      method = method,
      path = path,
      query = query,
      headers = headers,
      payloadHash = sha256Hex(body),
    },
    "20130524T000000Z",
  ) catch e {
    panic("signV4: ${e.message()}")
  }
  return signed
}

test "S3 example: GET Object with a Range header" {
  let s = exampleSign(
    "GET",
    "/test.txt",
    [](string, string)(0),
    [SigHeader{ name = "Range", value = "bytes=0-9" }],
    "",
  )
  let want = "GET\n/test.txt\n\nhost:examplebucket.s3.amazonaws.com\nrange:bytes=0-9\n" +
    "x-amz-content-sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\n" +
    "x-amz-date:20130524T000000Z\n\nhost;range;x-amz-content-sha256;x-amz-date\n" +
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  assert(s.canonicalRequest == want, "canonical request:\n${s.canonicalRequest}")
  assert(
    s.signature == "f0e8bdb87c964420e857bd35b5d6ed310bd44f0170aba48dd91039c6036bdb41",
    "signature = ${s.signature}",
  )
}

test "S3 example: PUT Object signs Date and x-amz-storage-class and encodes $ once" {
  let s = exampleSign(
    "PUT",
    "/test$file.text",
    [](string, string)(0),
    [
      SigHeader{ name = "Date", value = "Fri, 24 May 2013 00:00:00 GMT" },
      SigHeader{ name = "x-amz-storage-class", value = "REDUCED_REDUNDANCY" },
    ],
    "Welcome to Amazon S3.",
  )
  let want = "PUT\n/test%24file.text\n\ndate:Fri, 24 May 2013 00:00:00 GMT\n" +
    "host:examplebucket.s3.amazonaws.com\n" +
    "x-amz-content-sha256:44ce7dd67c959e0d3524ffac1771dfbba87d2b6b4b4e99e42034a8b803f8b072\n" +
    "x-amz-date:20130524T000000Z\nx-amz-storage-class:REDUCED_REDUNDANCY\n\n" +
    "date;host;x-amz-content-sha256;x-amz-date;x-amz-storage-class\n" +
    "44ce7dd67c959e0d3524ffac1771dfbba87d2b6b4b4e99e42034a8b803f8b072"
  assert(s.canonicalRequest == want, "canonical request:\n${s.canonicalRequest}")
  assert(
    s.signature == "98ad721746da40c64f1a55b78f14c238d841ea1380cd77a1b5971af0ece108bd",
    "signature = ${s.signature}",
  )
}

test "S3 example: GET Bucket Lifecycle, a subresource query with an empty value" {
  let s = exampleSign("GET", "/", [("lifecycle", "")], [], "")
  assert(
    s.signature == "fea454ca298b7da1c68078a5d1bdbfbbe0d65c699e0f91ac7a200a0136783543",
    "signature = ${s.signature}",
  )
}

test "S3 example: GET Bucket (List Objects) with max-keys and prefix" {
  let s = exampleSign("GET", "/", [("prefix", "J"), ("max-keys", "2")], [], "")
  assert(
    s.signature == "34b48302e7b5fa45bde8084f4b7868a86f0a534bc59db6670ed5711ef69dc6f7",
    "signature = ${s.signature}",
  )
  assert(
      s.authorization ==
        "AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request, " +
        "SignedHeaders=host;x-amz-content-sha256;x-amz-date, " +
        "Signature=34b48302e7b5fa45bde8084f4b7868a86f0a534bc59db6670ed5711ef69dc6f7",
    "authorization = ${s.authorization}",
  )
}

// ---------------------------------------------------------------------------
// Header handling the suite does not pin on its own.
// ---------------------------------------------------------------------------

fn vanillaRequest(headers: []SigHeader): SigV4Request {
  return SigV4Request{
    method = "GET",
    path = "/",
    query = [](string, string)(0),
    headers = headers,
    payloadHash = sha256Hex(""),
  }
}

fn suiteConfig(token: string): SigV4Config {
  return SigV4Config{
    accessKeyId = "AKIDEXAMPLE",
    secretKey = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    sessionToken = token,
    region = "us-east-1",
    service = "service",
    contentSha256Header = false,
  }
}

fn signOk(cfg: SigV4Config, req: SigV4Request): SigV4Signed {
  let s = signV4(cfg, req, "20150830T123600Z") catch e {
    panic("signV4: ${e.message()}")
  }
  return s
}

fn signFails(cfg: SigV4Config, req: SigV4Request, date: string): string {
  let msg = ""
  signV4(cfg, req, date) catch e {
    msg = e.message()
  }
  return msg
}

test "the unsignable headers are never signed, host and x-amz-user-agent are" {
  let s = signOk(
    suiteConfig(""),
    vanillaRequest(
      [
        SigHeader{ name = "Host", value = "example.amazonaws.com" },
        SigHeader{ name = "User-Agent", value = "bit" },
        SigHeader{ name = "Connection", value = "keep-alive" },
        SigHeader{ name = "Expect", value = "100-continue" },
        SigHeader{ name = "Transfer-Encoding", value = "chunked" },
        SigHeader{ name = "Proxy-Authorization", value = "x" },
        SigHeader{ name = "Sec-Fetch-Mode", value = "cors" },
        SigHeader{ name = "Authorization", value = "stale" },
        SigHeader{ name = "x-amz-user-agent", value = "aws-sdk" },
      ],
    ),
  )
  assert(
    indexOf(s.authorization, "SignedHeaders=host;x-amz-date;x-amz-user-agent,") >= 0,
    "authorization = ${s.authorization}",
  )
}

test "a caller-set x-amz-date is replaced, not signed twice" {
  let s = signOk(
    suiteConfig(""),
    vanillaRequest(
      [
        SigHeader{ name = "Host", value = "example.amazonaws.com" },
        SigHeader{ name = "X-Amz-Date", value = "19990101T000000Z" },
      ],
    ),
  )
  assert(indexOf(s.canonicalRequest, "19990101") < 0, "stale date signed:\n${s.canonicalRequest}")
  assert(
    indexOf(s.canonicalRequest, "x-amz-date:20150830T123600Z\n") >= 0,
    "canonical:\n${s.canonicalRequest}",
  )
}

test "same-name headers merge in order, tabs and newlines collapse, case is lowered" {
  let s = signOk(
    suiteConfig(""),
    vanillaRequest(
      [
        SigHeader{ name = "HOST", value = "  example.amazonaws.com\t" },
        SigHeader{ name = "My-Header", value = "b" },
        SigHeader{ name = "my-header", value = "a\r\n   c\t\td" },
      ],
    ),
  )
  assert(
    indexOf(s.canonicalRequest, "host:example.amazonaws.com\nmy-header:b,a c d\n") >= 0,
    "canonical:\n${s.canonicalRequest}",
  )
}

test "a session token is signed and returned as x-amz-security-token" {
  let s = signOk(
    suiteConfig("tok"),
    vanillaRequest([SigHeader{ name = "host", value = "example.amazonaws.com" }]),
  )
  assert(
    indexOf(s.canonicalRequest, "x-amz-security-token:tok\n") >= 0,
    "canonical:\n${s.canonicalRequest}",
  )
  assert(
    indexOf(s.authorization, "host;x-amz-date;x-amz-security-token") >= 0,
    "authz = ${s.authorization}",
  )
  let found = false
  for h of s.headers {
    if (h.name == "x-amz-security-token" && h.value == "tok") {
      found = true
    }
  }
  assert(found, "x-amz-security-token missing from the returned headers")
}

test "the path is encoded once and never normalised" {
  let req = vanillaRequest([SigHeader{ name = "host", value = "example.amazonaws.com" }])
  req.path = "//a/./b/../c d%41"
  let s = signOk(suiteConfig(""), req)
  assert(
    indexOf(s.canonicalRequest, "GET\n//a/./b/../c%20d%2541\n") == 0,
    "canonical:\n${s.canonicalRequest}",
  )
}

test "query pairs sort by encoded key, then value, not by the joined pair" {
  let qs = canonicalQueryString([("Param-3", "Value3"), ("Param", "Value2"), ("Param", "Value1")])
  assert(qs == "Param=Value1&Param=Value2&Param-3=Value3", "query = ${qs}")
}

test "signV4 fails loudly on malformed input" {
  let host = SigHeader{ name = "host", value = "example.amazonaws.com" }
  let good = vanillaRequest([host])
  let date = "20150830T123600Z"
  assert(signFails(suiteConfig(""), vanillaRequest([]), date) != "", "no host header accepted")
  assert(signFails(suiteConfig(""), good, "2015-08-30T12:36:00Z") != "", "ISO date accepted")
  assert(signFails(suiteConfig(""), good, "20150830T12360Z") != "", "short date accepted")
  let noKey = suiteConfig("")
  noKey.secretKey = ""
  assert(signFails(noKey, good, date) != "", "empty secret accepted")
  let noRegion = suiteConfig("")
  noRegion.region = ""
  assert(signFails(noRegion, good, date) != "", "empty region accepted")
  let badHash = vanillaRequest([host])
  badHash.payloadHash = "E3B0"
  assert(signFails(suiteConfig(""), badHash, date) != "", "short payload hash accepted")
  let badName = vanillaRequest([host, SigHeader{ name = "bad name", value = "x" }])
  assert(signFails(suiteConfig(""), badName, date) != "", "header name with a space accepted")
  let markers = vanillaRequest([host])
  markers.payloadHash = unsignedPayload
  assert(signFails(suiteConfig(""), markers, date) == "", "UNSIGNED-PAYLOAD rejected")
}
