// pkg/aws/credentials.test.bit — credentials.bit: the credential value and its
// validation, the environment provider against the SDK's own fromEnv cases
// (aws-sdk-js-v3 packages-internal/credential-provider-env fromEnv.spec.ts),
// the expiring single-flight cache, and the hand-off to the SigV4 signer.

import { contains } from "std/strings"
import { AtomicI64 } from "std/sync"
import { Millisecond, Timestamp, parseRfc3339, sleep } from "std/time"

const secretText: string = "SECRETVALUE"
const tokenText: string = "TOKENVALUE"

fn mk(id: string, secret: string): AwsCredential {
  return AwsCredential(accessKeyId = id, secretAccessKey = secret) catch e {
    panic("AwsCredential: ${e.message()}")
  }
}

fn at(s: string): Timestamp {
  return parseRfc3339(s) catch e {
    panic("parseRfc3339: ${e.message()}")
  }
}

fn expiring(id: string, expires: Timestamp): AwsCredential {
  return AwsCredential(accessKeyId = id, secretAccessKey = secretText, expiration = expires) catch e {
    panic("AwsCredential: ${e.message()}")
  }
}

// The message `AwsCredential(...)` fails with, or "" when it succeeds.
fn buildError(
  id: string,
  secret: string,
  token: Option<string> = Option.None,
  account: Option<string> = Option.None,
): string {
  AwsCredential(
    accessKeyId = id,
    secretAccessKey = secret,
    sessionToken = token,
    accountId = account,
  ) catch e {
    return e.message()
  }
  return ""
}

fn resolveError(cache: CredentialCache, refresh: Refresh = Refresh.IfNeeded): string {
  cache.resolve(refresh) catch e {
    return e.message()
  }
  return ""
}

fn resolveId(cache: CredentialCache, refresh: Refresh = Refresh.IfNeeded): string {
  let c = cache.resolve(refresh) catch e {
    return "error: ${e.message()}"
  }
  return c.accessKeyId
}

// --- printing never shows the secret -----------------------------------------

test "a credential prints as its access key id and never its secret or token" {
  let c = AwsCredential(
    accessKeyId = "AKIDEXAMPLE",
    secretAccessKey = secretText,
    sessionToken = tokenText,
  ) catch e {
    panic(e.message())
  }
  let shown = "${c}"
  assert(contains(shown, "AKIDEXAMPLE"), "interpolation lacks the key id: ${shown}")
  assert(!contains(shown, secretText), "interpolation leaks the secret: ${shown}")
  assert(!contains(shown, tokenText), "interpolation leaks the token: ${shown}")
  assert(c.show() == shown, "show() and interpolation differ")
}

test "the message of every construction failure names the field and never the value" {
  let bad = [
    buildError("AKID", secretText + "\n"),
    buildError("AKID", " " + secretText),
    buildError("AKID" + "\r", secretText),
    buildError("AKID", secretText, tokenText + "\n"),
    buildError("AKID", secretText, tokenText, " 1234"),
  ]
  for m of bad {
    assert(m != "", "a malformed credential was accepted")
    assert(!contains(m, secretText), "message leaks the secret: ${m}")
    assert(!contains(m, tokenText), "message leaks the token: ${m}")
  }
}

test "a provider failure and an expired credential keep the secret out of the error" {
  let failing = CredentialCache(() => {
    fail newError("imds said no")
  })
  let m = resolveError(failing)
  assert(contains(m, "provider failed: imds said no"), "provider failure not reported: ${m}")
  let stale = CredentialCache(() => {
    return expiring("AKIDOLD", at("2020-01-01T00:00:00Z"))
  })
  let m2 = resolveError(stale)
  assert(contains(m2, "AKIDOLD"), "expired credential not named: ${m2}")
  assert(!contains(m2, secretText), "expired-credential error leaks the secret: ${m2}")
}

// --- construction fails loudly ----------------------------------------------

test "AwsCredential refuses empty and malformed parts, naming the field" {
  assert(contains(buildError("", secretText), "accessKeyId must not be empty"), "empty id")
  assert(contains(buildError("AKID", ""), "secretAccessKey must not be empty"), "empty secret")
  assert(
    contains(buildError("AKID", secretText + "\n"), "secretAccessKey contains a control character"),
    "newline",
  )
  assert(
    contains(
      buildError("AKID", secretText + " "),
      "secretAccessKey has leading or trailing whitespace",
    ),
    "space",
  )
  assert(
    contains(buildError("AKID", secretText, ""), "sessionToken must not be empty"),
    "empty token",
  )
  assert(
    contains(buildError("AKID", secretText, tokenText, ""), "accountId must not be empty"),
    "empty account",
  )
  assert(
    buildError("AKID", secretText, tokenText, "123456789012") == "",
    "a well-formed credential was refused",
  )
}

// --- environment provider (SDK fromEnv vectors) -------------------------------

fn lookup(pairs: map<string, string>): (string) => string {
  return (name) => pairs[name]
}

fn fullEnv(): map<string, string> {
  let m = map<string, string>()
  m["AWS_ACCESS_KEY_ID"] = "mockAccessKeyId"
  m["AWS_SECRET_ACCESS_KEY"] = "mockSecretAccessKey"
  m["AWS_SESSION_TOKEN"] = "mockSessionToken"
  m["AWS_CREDENTIAL_EXPIRATION"] = "2026-10-03T12:00:00Z"
  m["AWS_ACCOUNT_ID"] = "123456789012"
  return m
}

fn fromEnvOrPanic(m: map<string, string>): AwsCredential {
  return credentialsFromLookup(lookup(m)) catch e {
    panic("credentialsFromLookup: ${e.message()}")
  }
}

test "fromEnv reads every known variable" {
  let c = fromEnvOrPanic(fullEnv())
  assert(c.accessKeyId == "mockAccessKeyId", "accessKeyId")
  assert(c.secretAccessKey == "mockSecretAccessKey", "secretAccessKey")
  assert(c.token() == "mockSessionToken", "sessionToken")
  assert(c.accountId == Option<string>.Some("123456789012"), "accountId")
  match (c.expiration) {
    Some(t) => assert(t.ns == at("2026-10-03T12:00:00Z").ns, "expiration")
    None => assert(false, "expiration missing")
  }
}

test "fromEnv without a session token, account id or expiration" {
  let m = fullEnv()
  m["AWS_SESSION_TOKEN"] = ""
  m["AWS_CREDENTIAL_EXPIRATION"] = ""
  m["AWS_ACCOUNT_ID"] = ""
  let c = fromEnvOrPanic(m)
  assert(c.sessionToken == Option<string>.None, "sessionToken should be None")
  assert(c.expiration == Option<Timestamp>.None, "expiration should be None")
  assert(c.accountId == Option<string>.None, "accountId should be None")
}

test "fromEnv fails when the key or the secret is missing, naming both variables" {
  for name of ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"] {
    let m = fullEnv()
    m[name] = ""
    credentialsFromLookup(lookup(m)) catch e {
      assert(
        contains(e.message(), "AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not both set"),
        e.message(),
      )
      assert(!contains(e.message(), "mockSecretAccessKey"), "leaks the secret")
      continue
    }
    assert(false, "${name} unset was accepted")
  }
}

test "fromEnv refuses an unparsable expiration instead of treating it as never" {
  let m = fullEnv()
  m["AWS_CREDENTIAL_EXPIRATION"] = "tomorrow"
  credentialsFromLookup(lookup(m)) catch e {
    assert(
      contains(e.message(), "AWS_CREDENTIAL_EXPIRATION is not an RFC 3339 timestamp"),
      e.message(),
    )
    return
  }
  assert(false, "a malformed expiration was accepted")
}

// --- the cache -----------------------------------------------------------------

// A provider that counts its calls and returns a credential expiring at
// `expires` (never, when empty).
fn counting(calls: AtomicI64, id: string, expires: string): () => AwsCredential! {
  return () => {
    calls.add(1)
    if (expires == "") {
      return mk(id, secretText)
    }
    return expiring(id, at(expires))
  }
}

test "a credential without expiration is fetched once and served forever" {
  let calls = AtomicI64(0)
  let cache = CredentialCache(counting(calls, "AKIDSTATIC", ""))
  cache.clock = () => at("2099-01-01T00:00:00Z").ns
  assert(resolveId(cache) == "AKIDSTATIC", "first")
  assert(resolveId(cache) == "AKIDSTATIC", "second")
  assert(calls.load() == 1, "provider calls = ${calls.load()}")
}

test "the cache refreshes exactly when expiry is inside the five minute window" {
  let calls = AtomicI64(0)
  let cache = CredentialCache(counting(calls, "AKIDTEMP", "2026-10-03T12:00:00Z"))
  let t = at("2026-10-03T11:00:00Z").ns
  cache.clock = () => t
  assert(resolveId(cache) == "AKIDTEMP", "first")
  assert(resolveId(cache) == "AKIDTEMP", "second")
  assert(calls.load() == 1, "an hour before expiry: ${calls.load()} calls")
  t = at("2026-10-03T11:55:00Z").ns
  assert(resolveId(cache) == "AKIDTEMP", "at the window edge")
  assert(
    calls.load() == 1,
    "five minutes before expiry is not yet inside the window: ${calls.load()} calls",
  )
  t = at("2026-10-03T11:55:01Z").ns
  assert(resolveId(cache) == "AKIDTEMP", "inside the window")
  assert(calls.load() == 2, "inside the window: ${calls.load()} calls")
}

test "Force fetches even a fresh credential" {
  let calls = AtomicI64(0)
  let cache = CredentialCache(counting(calls, "AKIDFORCE", ""))
  let _ = resolveId(cache)
  let _ = resolveId(cache, Refresh.Force)
  assert(calls.load() == 2, "calls = ${calls.load()}")
}

test "a failed refresh serves the credential that has not expired, and the next call retries" {
  let calls = AtomicI64(0)
  let failing = AtomicI64(0)
  let cache = CredentialCache(() => {
    calls.add(1)
    if (failing.load() == 1) {
      fail newError("backend down")
    }
    return expiring("AKIDOLD", at("2026-10-03T12:00:00Z"))
  })
  let t = at("2026-10-03T11:00:00Z").ns
  cache.clock = () => t
  assert(resolveId(cache) == "AKIDOLD", "prime")
  failing.store(1)
  t = at("2026-10-03T11:58:00Z").ns
  assert(resolveId(cache) == "AKIDOLD", "served despite the failed refresh")
  assert(resolveId(cache) == "AKIDOLD", "served again")
  assert(calls.load() == 3, "every call retried: ${calls.load()}")
  assert(
    contains(resolveError(cache, Refresh.Force), "backend down"),
    "Force must report the failure",
  )
  t = at("2026-10-03T12:00:01Z").ns
  assert(contains(resolveError(cache), "backend down"), "an expired credential must not be served")
  failing.store(0)
  t = at("2026-10-03T11:00:00Z").ns
  assert(resolveId(cache) == "AKIDOLD", "recovers when the provider does")
}

test "a provider that returns an already expired credential is refused" {
  let cache = CredentialCache(() => {
    return expiring("AKIDDEAD", at("2020-01-01T00:00:00Z"))
  })
  assert(contains(resolveError(cache), "already expired"), "expired credential accepted")
}

// --- single flight ---------------------------------------------------------------

fn slowProvider(calls: AtomicI64, release: chan<bool>): () => AwsCredential! {
  return () => {
    calls.add(1)
    <- release
    return expiring("AKIDSLOW", at("2026-10-03T14:00:00Z"))
  }
}

fn worker(cache: CredentialCache, out: chan<string>) {
  out <- resolveId(cache)
}

const taskCount: int = 50

test "50 tasks hitting an empty cache cause exactly one provider call" {
  let calls = AtomicI64(0)
  let release = chan<bool>()
  let cache = CredentialCache(slowProvider(calls, release))
  cache.clock = () => at("2026-10-03T12:00:00Z").ns
  let out = chan<string>(taskCount)
  let i = 0
  while (i < taskCount) {
    spawn worker(cache, out)
    i = i + 1
  }
  sleep(100 * Millisecond)
  close(release)
  let j = 0
  while (j < taskCount) {
    let id = <- out
    assert(id == "AKIDSLOW", "task got ${id}")
    j = j + 1
  }
  assert(calls.load() == 1, "provider calls = ${calls.load()}")
}

test "50 tasks hitting an expired cache cause exactly one provider call" {
  let calls = AtomicI64(0)
  let release = chan<bool>()
  let cache = CredentialCache(slowProvider(calls, release))
  cache.current = Option<AwsCredential>.Some(expiring("AKIDOLD", at("2026-10-03T12:00:00Z")))
  cache.clock = () => at("2026-10-03T12:00:01Z").ns
  let out = chan<string>(taskCount)
  let i = 0
  while (i < taskCount) {
    spawn worker(cache, out)
    i = i + 1
  }
  sleep(100 * Millisecond)
  close(release)
  let j = 0
  while (j < taskCount) {
    let id = <- out
    assert(id == "AKIDSLOW", "task got ${id}")
    j = j + 1
  }
  assert(calls.load() == 1, "provider calls = ${calls.load()}")
}

test "50 tasks share one failure, and the next call tries again" {
  let calls = AtomicI64(0)
  let release = chan<bool>()
  let cache = CredentialCache(() => {
    calls.add(1)
    <- release
    fail newError("boom")
  })
  let out = chan<string>(taskCount)
  let i = 0
  while (i < taskCount) {
    spawn worker(cache, out)
    i = i + 1
  }
  sleep(100 * Millisecond)
  close(release)
  let j = 0
  while (j < taskCount) {
    let m = <- out
    assert(contains(m, "boom"), "task got ${m}")
    j = j + 1
  }
  assert(calls.load() == 1, "provider calls = ${calls.load()}")
  assert(contains(resolveError(cache), "boom"), "no retry after a failed flight")
  assert(calls.load() == 2, "retry calls = ${calls.load()}")
}

test "a caller holding a valid credential does not wait behind a refresh" {
  let calls = AtomicI64(0)
  let release = chan<bool>()
  let cache = CredentialCache(slowProvider(calls, release))
  let t = at("2026-10-03T13:00:00Z").ns
  cache.clock = () => t
  cache.current = Option<AwsCredential>.Some(expiring("AKIDHELD", at("2026-10-03T13:03:00Z")))
  let out = chan<string>(1)
  spawn worker(cache, out)
  sleep(100 * Millisecond)
  assert(calls.load() == 1, "the leader has not started")
  assert(resolveId(cache) == "AKIDHELD", "a second caller must be served at once")
  assert(calls.load() == 1, "the second caller started its own call")
  close(release)
  assert(<- out == "AKIDSLOW", "the leader gets the refreshed credential")
}

// --- Credentials -------------------------------------------------------------------

test "Credentials.Static resolves to its credential and Provider to its provider" {
  let s = Credentials.Static(mk("AKIDSTATIC", secretText)).resolver() catch e {
    panic(e.message())
  }
  assert(resolveId(s) == "AKIDSTATIC", "static")
  let p = Credentials.Provider(constantProvider(mk("AKIDPROV", secretText))).resolver() catch e {
    panic(e.message())
  }
  assert(resolveId(p) == "AKIDPROV", "provider")
}

test "Credentials.Default resolves through the environment provider" {
  let d = Credentials.Default.resolver() catch e {
    panic(e.message())
  }
  assert(d.current == Option<AwsCredential>.None, "nothing is fetched at construction")
}

test "Credentials.Profile fails at construction: empty name, and no config reader yet" {
  let _ = Credentials.Profile("").resolver() catch e {
    assert(contains(e.message(), "needs a profile name"), e.message())
    return
  }
  assert(false, "an empty profile name was accepted")
}

// --- hand-off to the signer ------------------------------------------------------

test "a resolved credential signs a request and the session token is signed" {
  let c = AwsCredential(
    accessKeyId = "AKIDEXAMPLE",
    secretAccessKey = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    sessionToken = tokenText,
  ) catch e {
    panic(e.message())
  }
  let req = SigV4Request{
    method = "GET",
    path = "/photos/a.jpg",
    query = [](string, string)(0),
    headers = [SigHeader{ name = "host", value = "127.0.0.1:9000" }],
    payloadHash = unsignedPayload,
  }
  let signed = signV4(c.sigV4Config("us-east-1"), req, "20260101T000000Z") catch e {
    panic(e.message())
  }
  assert(
    contains(signed.authorization, "Credential=AKIDEXAMPLE/20260101/us-east-1/s3/aws4_request"),
    signed.authorization,
  )
  assert(contains(signed.authorization, "x-amz-security-token"), "the token is not signed")
  assert(
    !contains(signed.canonicalRequest, "wJalrXUtnFEMI"),
    "the secret is in the canonical request",
  )
  let sent = false
  for h of signed.headers {
    if (h.name == "x-amz-security-token") {
      assert(h.value == tokenText, "token header")
      sent = true
    }
  }
  assert(sent, "x-amz-security-token header missing")
}
