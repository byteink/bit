// Header signing keeps the region set in the request, outside the credential scope.
export class SigV4aConfig {
  export credential: AwsCredential,
  export service: string,
  export regionSet: string,
  export contentSha256Header: bool,
}

fn sigV4aRegionChar(value: byte): bool {
  return (value >= 'a' && value <= 'z') ||
    (value >= '0' && value <= '9') ||
    value == '*' ||
    value == '-'
}

fn sigV4aCheckRegions(regions: string): ()! {
  if (len(regions) == 0 || len(regions) > 8192) {
    fail sigV4aSignError()
  }
  let item = false
  for value of []byte(regions) {
    if (value == ',') {
      if (!item) {
        fail sigV4aSignError()
      }
      item = false
    } else {
      if (!sigV4aRegionChar(value)) {
        fail sigV4aSignError()
      }
      item = true
    }
  }
  if (!item) {
    fail sigV4aSignError()
  }
}

fn sigV4aHeaderView(cfg: SigV4aConfig): SigV4Config! {
  checkField("accessKeyId", cfg.credential.accessKeyId)?
  checkField("secretAccessKey", cfg.credential.secretAccessKey)?
  checkOptional("sessionToken", cfg.credential.sessionToken)?
  let token = ""
  match (cfg.credential.sessionToken) {
    Some(value) => token = value
    None => {}
  }
  return SigV4Config{
    accessKeyId = cfg.credential.accessKeyId,
    secretKey = cfg.credential.secretAccessKey,
    sessionToken = token,
    region = "",
    service = cfg.service,
    contentSha256Header = cfg.contentSha256Header,
  }
}

fn sigV4aRequest(cfg: SigV4aConfig, req: SigV4Request, amzDate: string): SigV4Signed! {
  sigV4aCheckRegions(cfg.regionSet)?
  checkHeaderName(req.method)?
  let view = sigV4aHeaderView(cfg)?
  let payload = payloadFor(req.headers, req.payloadHash)
  checkPayloadHash(payload)?
  let generated = generatedHeaders(view, req.headers, payload, amzDate)
  generated = append(generated, SigHeader{ name = "x-amz-region-set", value = cfg.regionSet })
  let replaced = generatedNames(view) + "x-amz-region-set,"
  let own = signableHeaders(req.headers, replaced, HeaderRules{})?
  if (!hasHost(own)) {
    fail sigV4aSignError()
  }
  for header of own {
    if (header.name == "host" && header.value == "") {
      fail sigV4aSignError()
    }
  }
  let signed = sortHeaders(append(own, ...generated))
  let canonical = canonicalRequest(req.method, req.path, req.query, signed, payload)
  let message = sigV4aMessage(amzDate, cfg.service, canonical)?
  let signature = sigV4aSign(
    cfg.credential.accessKeyId, cfg.credential.secretAccessKey, amzDate, cfg.service, canonical,
  )?
  let scope = "${amzDate[0:8]}/${cfg.service}/aws4_request"
  let authorization = "AWS4-ECDSA-P256-SHA256 Credential=${cfg.credential.accessKeyId}/${scope}, SignedHeaders=${signedHeaders(signed)}, Signature=${signature}"
  return SigV4Signed{
    canonicalRequest = canonical,
    stringToSign = message,
    signature = signature,
    authorization = authorization,
    headers = append(generated, SigHeader{ name = "authorization", value = authorization }),
  }
}

// Signs with ECDSA and returns the generated headers to replace on the wire.
// Region sets use a bounded, lowercase CSV policy; order and wildcards are preserved.
export fn signV4a(cfg: SigV4aConfig, req: SigV4Request, amzDate: string): SigV4Signed! {
  return sigV4aRequest(cfg, req, amzDate) catch _ {
    fail sigV4aSignError()
  }
}
