fn endpointCases(): []string {
  let out = []string(0)
  out = append(out, ...endpointCases0())
  out = append(out, ...endpointCases1())
  out = append(out, ...endpointCases2())
  out = append(out, ...endpointCases3())
  return out
}

fn flag(s: string): bool {
  return s == "T"
}

// The row's outcome: "ERR" or "<url> <signingRegion>".
fn resolved(f: []string): string {
  let custom = Option<string>.None
  if (f[4] != "") {
    custom = Option<string>.Some(f[4])
  }
  let ep = resolveStsEndpoint(f[0], custom, flag(f[1]), flag(f[2]), flag(f[3])) catch _ {
    return "ERR"
  }
  return "${ep.url} ${ep.signingRegion}"
}

test "every endpoint case of the STS model resolves as the model says" {
  let cases = endpointCases()
  assert(len(cases) == 69, "the model has 69 endpoint cases, this table has ${len(cases)}")
  let errors = 0
  for row of cases {
    let f = split(row, ",")
    assert(len(f) == 7, "row '${row}' has ${len(f)} fields")
    let want = "ERR"
    if (f[5] != "ERR") {
      want = "${f[5]} ${f[6]}"
    } else {
      errors = errors + 1
    }
    let got = resolved(f)
    assert(got == want, "row '${row}': got '${got}', want '${want}'")
  }
  assert(errors == 3, "the model rejects 3 of its cases, saw ${errors}")
}

test "a custom endpoint with a path, a query or credentials is refused, one with a trailing slash is trimmed" {
  let bad = [
    "https://x.example/sts",
    "https://x.example/?a=b",
    "https://u:p@x.example",
    "ftp://x.example",
    "https://",
    "x.example",
  ]
  for e of bad {
    resolveStsEndpoint("us-east-1", Option<string>.Some(e), false, false, false) catch _ {
      continue
    }
    assert(false, "accepted the endpoint '${e}'")
  }
  let ok = resolveStsEndpoint(
    "us-east-1",
    Option<string>.Some("http://127.0.0.1:9/"),
    false,
    false,
    false,
  ) catch e {
    panic(e.message())
  }
  assert(ok.url == "http://127.0.0.1:9", "url = ${ok.url}")
}

test "the *-global pseudo regions belong to their partition" {
  assert(awsPartition("aws-cn-global").dnsSuffix == "amazonaws.com.cn", "aws-cn-global")
  assert(awsPartition("aws-us-gov-global").name == "aws-us-gov", "aws-us-gov-global")
  assert(awsPartition("aws-iso-b-global").dnsSuffix == "sc2s.sgov.gov", "aws-iso-b-global")
  assert(awsPartition("eusc-de-east-1").dnsSuffix == "amazonaws.eu", "eusc-de-east-1")
  assert(awsPartition("xx-nowhere-9").name == "aws", "an unknown region is in the aws partition")
}
