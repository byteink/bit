// AWS signing fixtures (Apache-2.0), aws-c-auth 84a26ea184d9ccd322c8164759510b3604ab13fd.
// Canonical bytes and public points are the published references, not signer output.
class SigV4aHeaderVector {
  name: string,
  headers: []SigHeader,
  query: [](string, string),
  canonical: string,
  message: string,
}

fn sigV4aHeaderVectors(): []SigV4aHeaderVector {
  return [
    SigV4aHeaderVector{
      name = "get-header-key-duplicate",
      query = [](string, string)(0),
      headers = [
        SigHeader{ name = "Host", value = "example.amazonaws.com" },
        SigHeader{ name = "My-Header1", value = "value2" },
        SigHeader{ name = "My-Header1", value = "value2" },
        SigHeader{ name = "My-Header1", value = "value1" },
      ],
      canonical = "GET\n/\n\nhost:example.amazonaws.com\nmy-header1:value2,value2,value1\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;my-header1;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\n30f1f7b639b7fd5982a0f700e6d23bf7bb24f2f1d9e1314005bf22130da61cdf",
    },
    SigV4aHeaderVector{
      name = "get-header-value-order",
      query = [](string, string)(0),
      headers = [
        SigHeader{ name = "Host", value = "example.amazonaws.com" },
        SigHeader{ name = "My-Header1", value = "value4" },
        SigHeader{ name = "My-Header1", value = "value1" },
        SigHeader{ name = "My-Header1", value = "value3" },
        SigHeader{ name = "My-Header1", value = "value2" },
      ],
      canonical = "GET\n/\n\nhost:example.amazonaws.com\nmy-header1:value4,value1,value3,value2\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;my-header1;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\ne1c3b5d34632ffff080330b3bc31906c8988bf1683f4af689ef3f1811952df36",
    },
    SigV4aHeaderVector{
      name = "get-header-value-trim",
      query = [](string, string)(0),
      headers = [
        SigHeader{ name = "Host", value = "example.amazonaws.com" },
        SigHeader{ name = "My-Header1", value = " value1" },
        SigHeader{ name = "My-Header2", value = " \"a   b   c\"" },
      ],
      canonical = "GET\n/\n\nhost:example.amazonaws.com\nmy-header1:value1\nmy-header2:\"a b c\"\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;my-header1;my-header2;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\n18b43001be9b531ebdd8202144dbd7630ea8a35bc328a7d0e561dda03a876095",
    },
  ]
}

fn sigV4aCheckHeaderVectors(vectors: []SigV4aHeaderVector, kind: string) {
  let public = sigV4aReadPublic(
    sigV4aCurve(),
    sigV4aTestBytes("04b6618f6a65740a99e650b33b6b4b5bd0d43b176d721a3edfea7e7d2d56d936b1865ed22a7eadc9c5cb9d2cbaca1b3699139fedc5043dc6661864218330c8e518"),
  ) catch e {
    panic(e.message())
  }
  let checked = 0
  for vector of vectors {
    let req = sigV4aRequestFixture()
    req.headers = vector.headers
    req.query = vector.query
    let signed = sigV4aRequestSigned(sigV4aRequestConfig(), req)
    assert(
      signed.canonicalRequest == vector.canonical,
      "official ${vector.name} canonical request",
    )
    assert(signed.stringToSign == vector.message, "official ${vector.name} string to sign")
    let der = sigV4aTestBytes(signed.signature)
    let signature = sigV4aReadSignature(der) catch e {
      panic(e.message())
    }
    let hash = sigV4aDigest(SigV4aSha256(), []byte(vector.message))
    assert(
      sigV4aVerify(public, hash, signature),
      "official ${vector.name} published public point",
    )
    assert(
      !sigV4aVerify(
        public,
        sigV4aDigest(SigV4aSha256(), []byte(vector.message + "tampered")),
        signature,
      ),
      "official ${vector.name} changed message rejected",
    )
    der[len(der) - 1] = der[len(der) - 1] ^ 1
    let changed = sigV4aReadSignature(der) catch e {
      panic(e.message())
    }
    assert(
      !sigV4aVerify(public, hash, changed),
      "official ${vector.name} changed signature rejected",
    )
    checked = checked + 1
  }
  assert(checked == 3, "all 3 of 3 official ${kind} cases checked")
}

fn sigV4aQueryVectors(): []SigV4aHeaderVector {
  return [
    SigV4aHeaderVector{
      name = "get-vanilla-query-order-key-case",
      headers = [SigHeader{ name = "Host", value = "example.amazonaws.com" }],
      query = [("Param2", "value2"), ("Param1", "value1")],
      canonical = "GET\n/\nParam1=value1&Param2=value2\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\ncc07b29e0d0f0b2d6aa296621a5608fd9c2271159b9b2f737f682704ebb96482",
    },
    SigV4aHeaderVector{
      name = "get-vanilla-query-order-encoded",
      headers = [SigHeader{ name = "Host", value = "example.amazonaws.com" }],
      query = [("Param-3", "Value3"), ("Param", "Value2"), ("ሴ", "Value1")],
      canonical = "GET\n/\n%E1%88%B4=Value1&Param=Value2&Param-3=Value3\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\n55568a29040b287c72015a5ab482d9aaceeb1e9881f3bc946378bc3d6079f6a5",
    },
    SigV4aHeaderVector{
      name = "get-vanilla-query-unreserved",
      headers = [SigHeader{ name = "Host", value = "example.amazonaws.com" }],
      query = [
        (
          "-._~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
          "-._~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
        ),
      ],
      canonical = "GET\n/\n-._~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz=-._~0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\nx-amz-region-set:us-east-1\n\nhost;x-amz-date;x-amz-region-set\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      message = "AWS4-ECDSA-P256-SHA256\n20150830T123600Z\n20150830/service/aws4_request\n377b8a3e195894659b84cd1c475dc8a3663a663360a349430c0c3b82bd82b77b",
    },
  ]
}

test "SigV4a public header matches three official normalization cases" {
  sigV4aCheckHeaderVectors(sigV4aHeaderVectors(), "header normalization")
}

test "SigV4a public header matches three official query cases" {
  sigV4aCheckHeaderVectors(sigV4aQueryVectors(), "query canonicalization")
}
