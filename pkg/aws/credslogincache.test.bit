import { isSymlink as loginCacheIsSymlink } from "std/fs"

fn loginCacheFixture(): Json {
  let value = jsonParse("{\"accessToken\":{\"accessKeyId\":\"ASIALOGIN\",\"secretAccessKey\":\"fixture-secret\",\"sessionToken\":\"fixture-session\",\"accountId\":\"123456789012\",\"expiresAt\":\"2020-01-01T00:00:00Z\",\"extra\":\"access-extra\"},\"clientId\":\"fixture-client\",\"refreshToken\":\"fixture-refresh\",\"extra\":\"root-extra\"}") catch e {
    panic(e.message())
  }
  return ssoSet(value, "dpopKey", Json.JsonString(loginTestPem(loginTestMembers())))
}

fn loginCacheRejected(value: Json) {
  let message = ""
  loginCacheParse(value) catch e {
    message = e.message()
  }
  assert(message == loginCacheError().message(), "fixed private cache error")
}

fn loginCacheReadRejected(path: string) {
  let message = ""
  loginCacheRead(path) catch e {
    message = e.message()
  }
  assert(message == loginCacheError().message(), "fixed private file error")
}

test "login cache path hashes exact UTF8 session in an explicit directory" {
  let sessions = ["demo", "arn:aws:signin:us-east-1:123456789012:oauth2/public-client", "é"]
  let hashes = [
    "2a97516c354b68848cdbd8f54a226a0a55b21ed138e207ad6c5cbb9c00aa5aea",
    "3a506062411db8734aca038810bafe474804e9dd64f82b9f12ef7f04561e78e0",
    "4a99557e4033c3539de2eb65472017cad5f9557f7a0625a09f1c3f6e2ba69c4c",
  ]
  for i of [0, 1, 2] {
    let path = loginCachePath("/fixture/cache", sessions[i]) catch e {
      panic(e.message())
    }
    assert(path == "/fixture/cache/${hashes[i]}.json", "exact SHA256 cache filename")
  }
  let relative = loginCachePath("", "demo") catch e {
    panic(e.message())
  }
  assert(relative == hashes[0] + ".json", "explicit empty directory stays relative")
}

test "login cache parse retains expired credentials and exact private members" {
  let cache = loginCacheParse(loginCacheFixture()) catch e {
    panic(e.message())
  }
  assert(cache.credential.accessKeyId == "ASIALOGIN", "access key binding")
  assert(cache.credential.secretAccessKey == "fixture-secret", "secret key binding")
  assert(cache.credential.token() == "fixture-session", "session token binding")
  assert(cache.credential.accountId == Option.Some("123456789012"), "account binding")
  assert(
    cache.credential.remaining(at("2026-01-01T00:00:00Z").ns) < 0,
    "expired value retained for refresh",
  )
  assert(
    cache.clientId == "fixture-client" && cache.refreshToken == "fixture-refresh",
    "refresh members",
  )
  assert(cache.dpopKey == loginTestPem(loginTestMembers()), "DPoP key binding")
}

test "login cache rejects missing wrong type empty and secret-bearing invalid fields" {
  loginCacheRejected(Json.JsonNull)
  for key of ["accessToken", "clientId", "refreshToken", "dpopKey"] {
    loginCacheRejected(ssoSet(loginCacheFixture(), key, Json.JsonNull))
    loginCacheRejected(ssoSet(loginCacheFixture(), key, Json.JsonString("")))
  }
  for key of ["accessKeyId", "secretAccessKey", "sessionToken", "accountId", "expiresAt"] {
    let value = loginCacheFixture()
    let access = loginTestMember(value, "accessToken")
    loginCacheRejected(ssoSet(value, "accessToken", ssoSet(access, key, Json.JsonNull)))
    loginCacheRejected(ssoSet(value, "accessToken", ssoSet(access, key, Json.JsonString(""))))
  }
  for text of ["bad-secret-date", "2026-13-01T00:00:00Z"] {
    let value = loginCacheFixture()
    let access = ssoSet(loginTestMember(value, "accessToken"), "expiresAt", Json.JsonString(text))
    loginCacheRejected(ssoSet(value, "accessToken", access))
  }
  for text of ["123", "12345678901x"] {
    let value = loginCacheFixture()
    let access = ssoSet(loginTestMember(value, "accessToken"), "accountId", Json.JsonString(text))
    loginCacheRejected(ssoSet(value, "accessToken", access))
  }
  loginCacheRejected(ssoSet(loginCacheFixture(), "dpopKey", Json.JsonString("private-key-sentinel")))
  loginCacheRejected(ssoSet(loginCacheFixture(), "clientId", Json.JsonString(repeat("x", 8193))))
  loginCacheRejected(ssoSet(loginCacheFixture(), "refreshToken", Json.JsonString("secret\nvalue")))
}

test "login cache bounded file reader rejects missing malformed oversized and directory input" {
  let path = ssoFixturePath()
  defer ssoCleanup(path)
  loginCacheReadRejected(path)
  loginCacheReadRejected(envOr("TMPDIR", "/tmp"))
  for text of ["not-json", "{}", repeat("x", ssoMaxBytes + 1)] {
    write(path, text)
    loginCacheReadRejected(path)
  }
}

test "login cache atomic write preserves unknown fields and leaves private regular file" {
  let path = ssoFixturePath()
  defer ssoCleanup(path)
  let value = loginCacheFixture()
  let cache = loginCacheWrite(path, value) catch e {
    panic(e.message())
  }
  let loaded = loginCacheRead(path) catch e {
    panic(e.message())
  }
  assert(ssoEncode(loaded.value) == ssoEncode(cache.value), "complete cache value retained")
  assert(
      (ssoText(loaded.value, "extra") catch _ {
        ""
      }) ==
      "root-extra",
    "root extension retained",
  )
  let access = loginTestMember(loaded.value, "accessToken")
  assert(
      (ssoText(access, "extra") catch _ {
        ""
      }) ==
      "access-extra",
    "access extension retained",
  )
  let info = stat(path) catch e {
    panic(e.message())
  }
  assert((info.mode & 0o777) == 0o600, "private cache permissions")
  let invalid = ssoSet(value, "refreshToken", Json.JsonString(""))
  let rejected = false
  loginCacheWrite(path, invalid) catch _ {
    rejected = true
  }
  assert(rejected, "invalid cache write refused")
  let unchanged = loginCacheRead(path) catch e {
    panic(e.message())
  }
  assert(ssoEncode(unchanged.value) == ssoEncode(loaded.value), "rejected write preserves cache")
}

// A valid target distinguishes no-follow refusal from malformed JSON refusal.
test "login cache valid target reads but symlink FIFO and device are refused" {
  let path = ssoFixturePath()
  let link = path + ".link"
  let fifo = path + ".fifo"
  defer ssoCleanup(path)
  defer ssoCleanup(link)
  defer ssoCleanup(fifo)
  let value = loginCacheFixture()
  loginCacheWrite(path, value) catch e {
    panic(e.message())
  }
  let direct = loginCacheRead(path) catch e {
    panic(e.message())
  }
  assert(direct.credential.accessKeyId == "ASIALOGIN", "valid target calibration")
  assert(run("/bin/ln", ["-s", path, link]) == 0, "create owned symlink")
  assert(loginCacheIsSymlink(link), "symlink calibration")
  loginCacheReadRejected(link)
  let generic = ssoRead(link) catch e {
    panic(e.message())
  }
  assert(ssoEncode(generic) == ssoEncode(value), "SSO symlink policy preserved")
  assert(run("/usr/bin/mkfifo", [fifo]) == 0, "create owned FIFO")
  loginCacheReadRejected(fifo)
  loginCacheReadRejected("/dev/null")
  let after = loginCacheRead(path) catch e {
    panic(e.message())
  }
  assert(ssoEncode(after.value) == ssoEncode(value), "target bytes preserved")
}
