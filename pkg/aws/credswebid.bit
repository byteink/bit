// File-backed web identity follows aws-sdk-js-v3 054298b1520f:
// credential-provider-web-identity/fromTokenFile and fromWebToken.
import { openRegular } from "std/fs/secure"
import { env } from "std/os"
import { Millisecond, now } from "std/time"

const webIdentityFile: string = "AWS_WEB_IDENTITY_TOKEN_FILE"
const webIdentityRole: string = "AWS_ROLE_ARN"
const webIdentitySession: string = "AWS_ROLE_SESSION_NAME"
// STS API_AssumeRoleWithWebIdentity: WebIdentityToken is 4..20000 characters.
const webIdentityMaxBytes: int = 20000

// The default chain can distinguish absence from a configured provider failure.
class WebIdentityNotConfigured {
  message(): string {
    return "aws: web identity: configuration not specified"
  }
}

class WebIdentityConfig {
  tokenFile: string,
  roleArn: string,
  sessionName: string,
  region: string,
}

fn webIdentityRegion(get: (string) => string, profile: map<string, string>): string {
  let region = get("AWS_REGION")
  if (region != "") {
    return region
  }
  let (fromProfile, _) = profile["region"]
  if (fromProfile != "") {
    return fromProfile
  }
  return "us-east-1"
}

fn webIdentityConfig(
  path: string, role: string, session: string, region: string, millis: int,
): WebIdentityConfig! {
  if (path == "" || role == "") {
    fail WebIdentityNotConfigured{}
  }
  let name = session
  if (name == "") {
    name = "aws-sdk-js-session-${millis}"
  }
  return WebIdentityConfig{
    tokenFile = path, roleArn = role, sessionName = name, region = region,
  }
}

fn webIdentityEnv(get: (string) => string, millis: int): WebIdentityConfig! {
  return webIdentityConfig(
    get(webIdentityFile), get(webIdentityRole), get(webIdentitySession),
    webIdentityRegion(get, map<string, string>{}), millis,
  )?
}

fn webIdentityProfileConfig(
  profile: map<string, string>, get: (string) => string, millis: int,
): WebIdentityConfig! {
  let (path, _) = profile["web_identity_token_file"]
  let (role, _) = profile["role_arn"]
  let (session, hasSession) = profile["role_session_name"]
  if (!hasSession) {
    session = get(webIdentitySession)
  }
  return webIdentityConfig(path, role, session, webIdentityRegion(get, profile), millis)?
}

fn webIdentityReadToken(path: string): string! {
  let file = openRegular(path) catch _ {
    fail newError("aws: web identity: token file cannot be opened")
  }
  defer file.close()
  let bytes = []byte(webIdentityMaxBytes + 1)
  let total = 0
  while (total < len(bytes)) {
    let count = file.readAt(bytes[total:len(bytes)], i64(total)) catch _ {
      fail newError("aws: web identity: token file cannot be read")
    }
    if (count == 0) {
      if (total < 4) {
        fail newError("aws: web identity: token must contain 4 to 20000 bytes")
      }
      return string(bytes[0:total])
    }
    total = total + count
  }
  fail newError("aws: web identity: token exceeds 20000 bytes")
}

fn webIdentityResolve(config: WebIdentityConfig, client: StsClient): AwsCredential! {
  let token = webIdentityReadToken(config.tokenFile)?
  let input = AssumeRoleWithWebIdentityInput{
    roleArn = config.roleArn,
    roleSessionName = config.sessionName,
    webIdentityToken = token,
  }
  // STS may clip an echoed token before this point, making redaction unsafe.
  let assumed = client.assumeRoleWithWebIdentity(input) catch _ {
    fail newError("aws: web identity: STS exchange failed")
  }
  return assumed.credentials
}

fn webIdentityAssume(config: WebIdentityConfig): AwsCredential! {
  let client = StsClient(StsOptions{ region = config.region })?
  return webIdentityResolve(config, client)?
}

fn webIdentityProfile(profile: map<string, string>): AwsCredential! {
  let config = webIdentityProfileConfig(profile, env, now().ns / Millisecond)?
  return webIdentityAssume(config)?
}

// Credentials from AWS_WEB_IDENTITY_TOKEN_FILE and AWS_ROLE_ARN. Resolving
// through Credentials.Provider reopens the token file whenever refresh is due.
export fn webIdentityCredentials(): AwsCredential! {
  let config = webIdentityEnv(env, now().ns / Millisecond)?
  if (env("AWS_REGION") == "") {
    let profiles = loadSharedProfiles()?
    let (profile, _) = profiles.sections[profileName()]
    config.region = webIdentityRegion(env, profile)
  }
  return webIdentityAssume(config)?
}
