// The worker pool (#1364) driven WITHOUT operating-system threads: two worker
// blocks run one after the other on the single main thread.
//
// This is the all-targets half of the migration check. It proves the scheduler
// bookkeeping that migration depends on — that a task parks cleanly, that it can
// be placed on a worker other than the one it parked on, that it resumes there,
// that `schedCurrentWorker` reports the NEW worker afterwards, and that the
// registry links and unlinks it — on every target including ones where the
// thread providers cannot be exercised.
//
// WHAT IT PROVES ONLY BY ACCIDENT, so that the two-thread programs are not
// mistaken for redundant. Dropping the x19 save/restore from the switch DOES
// fail this program (measured: 31 -> 23) — but only because the worker loop
// running in between happens to place one of its own locals in x19. That is an
// allocator decision, not a property: a compiler that chose differently would
// let the sentinel simply sit undisturbed in the register across the round trip
// and this program would pass a broken switch. The previous register check in
// tests/stress/sched was caught out by exactly that, under one compiler and not
// the other.
//
// ../schedpoollinux and ../schedpooldarwin do not depend on the accident: their
// resuming worker is a different OS THREAD that has demonstrably been running
// its own loop, so the probe registers provably hold something else. This
// program is the portable floor, not the ceiling.
//
// The two `schedWorkerRun` calls are sequential and each returns because
// `stopping` is set before it is entered: worker 0 runs until the task parks and
// then finds no work, worker 1 runs the resumed task to completion. Neither can
// spin forever, and neither can steal from the other, because only one is ever
// running.

import { poolInit, poolWorkerAddr, poolSchedAddr, poolTaskParked, poolWake } from "./props"
import { poolShutdown, poolRestart, poolVerdict, poolTotal, poolFinished, poolQueueStealTask } from "./props"
import { schedWorkerRun, schedNoTimers, schedNoPoller, taskAt } from "../../../runtime/sched"

function main() {
  if (!poolInit()) {
    print("init-failed\n")
    return
  }

  // Worker 0 runs until the task parks and it then finds nothing to do.
  // `stopping` is set up front so the idle path exits instead of spinning.
  poolShutdown()
  schedWorkerRun(taskAt(poolWorkerAddr(0)), schedNoTimers, schedNoPoller)

  // The task must now be parked, and it must not have finished.
  let parked = poolTaskParked()
  let notDone = !poolFinished()

  // Hand it to the OTHER worker and let that one run it out.
  poolRestart()
  let placed = poolWake()

  // Also leave a task on worker 0's ring. Worker 0 is finished, so worker 1 can
  // only run it by stealing — see ./props for why that case needed its own task.
  let queued = poolQueueStealTask()

  poolShutdown()
  schedWorkerRun(taskAt(poolWorkerAddr(1)), schedNoTimers, schedNoPoller)

  print("${parked && notDone && placed && queued} ${poolVerdict()} ${poolTotal}\n")
}
