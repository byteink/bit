// The cross-worker migration property, shared by the three programs that drive
// it: the platform-free single-thread version next door, and the two real
// two-OS-thread versions in ../../schedpoollinux and ../../schedpooldarwin.
//
// ---------------------------------------------------------------------------
// WHY THIS TEST EXISTS AT ALL
// ---------------------------------------------------------------------------
//
// #1364's context-switch half shipped with one worker, so a task always resumed
// on the worker it parked on and the switch was never asked the question that
// matters: does a task's callee-saved register file survive being handed to a
// DIFFERENT OS thread? That is not a hypothetical gap in this project. The `x18`
// bug cost it a debugging session precisely because a missing clobber was
// invisible while a task resumed where it parked, and corrupted only once the
// task woke on another worker whose value for that register differed.
//
// So a migration test that lets the scheduler choose which worker resumes the
// task proves nothing on the runs where it happens to choose the same one.
// This one removes the choice by removing the alternative: the original worker's
// OS THREAD IS JOINED before the task is woken, so there is no second candidate
// left to resume it. See step 4 below.
//
// ---------------------------------------------------------------------------
// HOW THE MIGRATION IS MADE DETERMINISTIC
// ---------------------------------------------------------------------------
//
// The two-thread programs run this sequence, and every step is a fact the next
// step can rely on rather than a timing hope:
//
//   1. Only worker 0's OS thread is started, and the task is queued only on
//      worker 0. So it provably first runs on worker 0.
//   2. The task records its worker id, loads sentinels into callee-saved
//      registers, and parks.
//   3. The driver polls the task's state until it reads `taskParked`. That
//      store happens on the worker's own thread strictly AFTER the switch saved
//      the task's context, so seeing it means the context is complete.
//   4. The driver shuts the scheduler down and JOINS worker 0's thread. Worker 0
//      is now gone — not idle, gone — so it cannot steal the task back. This is
//      what turns "probably migrates" into "must migrate".
//   5. `stopping` is cleared, the task is unparked onto the global queue, and
//      worker 1's thread is started. It is the only worker alive, so it is the
//      only one that can take the task.
//   6. The task resumes on worker 1, on a DIFFERENT OS THREAD whose registers
//      hold that thread's own working state, and reads its sentinels back.
//
// Step 4 is the whole trick. Without it both workers are alive and either may
// take the task, so the interesting case would be sampled rather than forced.
//
// ---------------------------------------------------------------------------
// WHAT MAKES THE REGISTER CHECK NON-VACUOUS HERE
// ---------------------------------------------------------------------------
//
// The previous register check in tests/stress/sched had to poison the probe
// registers by hand, because with one worker a dropped save/restore could go
// undetected: the sentinel simply stayed in the register across the round trip
// unless the worker happened to reuse it.
//
// Migration removes that weakness by construction. The resuming worker is a
// DIFFERENT OS THREAD that has been executing `schedWorkerRun`'s own loop —
// spinning on the idle backoff, walking the worker array to steal — so its
// callee-saved registers demonstrably hold that loop's values and not this
// task's. A switch that fails to restore x19/x20/x21 (rbx/r12/r13) therefore
// hands the task worker 1's loop state, which is not the sentinel sum. The
// sentinels are deliberately large and distinctive (0x4711..0x4713) so they
// cannot be confused with a small loop counter that a worker might plausibly
// be holding.
//
// The same limit as the earlier test still applies and is not papered over: the
// FP file (d8..d15) is NOT covered, because §11.6's `clobber` has no spelling
// for an FP register, so a sentinel in d8 cannot be reserved against the
// allocator. The integer file is proven; the FP file is argued.
//
// ---------------------------------------------------------------------------
// WHY THE BODY PARKS BY HAND INSTEAD OF CALLING `schedPark`
// ---------------------------------------------------------------------------
//
// §11.6's register exclusion is PER-FUNCTION. `schedPark` is a different
// function, so its own allocator is free to use x19/x20/x21 — and it would
// destroy the sentinels between this body loading them and the switch saving
// them, failing the test for a reason that has nothing to do with the switch.
//
// So this body resolves its task and worker pointers FIRST, while no sentinel is
// live, then loads the sentinels and calls `schedSwitch` directly with nothing
// in between. `schedSwitch`'s body is a single asm block touching only x0..x3
// (rdi/rsi/rax), so it is the one call that provably cannot disturb the probes.
// The read-back is likewise the first thing after the switch returns.
//
// This is a constraint on the TEST, not a limitation of `schedPark` — ordinary
// task code holding a value across a park is fine, because the switch saves and
// restores whatever the caller had. It only matters when the value must be in a
// NAMED register in order to be observed at all.

import { schedSwitch, schedTaskInit, taskAt, taskState } from "../../../../runtime/sched"
import { taskParked, schedStackBytes, schedStackAligned } from "../../../../runtime/sched"
import { schedInit, schedWorkerAt, schedWorkerRun, schedShutdown, schedRegister } from "../../../../runtime/sched"
import { schedCurrentWorker, schedTaskExit, schedUnpark, wkId, wkCtx, wkDisposition } from "../../../../runtime/sched"
import { dqPushBottom, wkDeque, workerWords, scStopping, schedRegCount } from "../../../../runtime/sched"
import { schedCurrentTask, schedTaskOnStack } from "../../../../runtime/sched"
import { parkMinBackoffNs } from "../../../../runtime/park"

// Two workers is the minimum that can express "a different worker", and the
// property is about crossing the boundary rather than about scale.
export const poolWorkers: int = 2

// Two 64KiB stacks, 64KiB-aligned, carved out of a 192KiB region. The extra
// 64KiB is what guarantees two aligned bases exist inside it whatever address
// the linker gives the array — module-level arrays are only 8-byte aligned
// (a known gap, #1421), so the alignment has to be taken rather than assumed.
let stackArea: [24576]i64

let taskBlock: [32]i64
let stealTaskBlock: [32]i64
let workerBlocks: [584]i64
let schedBlock: [16]i64

// Observations, written by the task and read by the driver.
//
// Module state is untraced and statically allocated (§11.11), which is what
// these must be: they are written from a green thread on one OS thread and read
// from another, and the collector must never walk them.
let obsWorkerBefore: i64 = -1
let obsWorkerAfter: i64 = -1
let obsSentinels: i64 = 0
let obsFinished: i64 = 0
let obsRegAfterInit: i64 = -1

// Addresses resolved once by `poolInit`, because `ptrOf` is rejected inside a
// `@nosplit` body (#1421) even though §11.11 says reaching module state is pure
// arithmetic. The task body is `@nosplit` and needs both, so they are taken here
// on an ordinary thread and carried as integers — the same workaround
// tests/stress/sched uses, and what a real scheduler does anyway since a task
// reaches its own state through a stored pointer rather than a static name.
// A region shaped like a task stack base but never tagged: word 0 holds a
// plausible task address, word 1 holds something that is not the tag.
let decoyStack: [4]i64

let addrTask: i64 = 0
let addrFinished: i64 = 0
let addrStolen: i64 = 0

// Set by the second task, which exists only to be STOLEN — see
// `poolQueueStealTask`.
let obsStolen: i64 = 0

// The sentinel sum the task must read back: 0x4711 + 0x4712 + 0x4713.
export const poolSentinelSum: int = 54582

@nosplit function alignUpStack(addr: int): int {
  let bumped = addr + schedStackBytes - 1
  return bumped - bumped % schedStackBytes
}

export function poolTaskAddr(): int {
  return int(ptrOf(taskBlock))
}

export function poolStealTaskAddr(): int {
  return int(ptrOf(stealTaskBlock))
}

// The migrating task's stack base — the region `schedTaskInit` tagged.
export function poolStackBase(): int {
  return alignUpStack(int(ptrOf(stackArea)))
}

export function poolSchedAddr(): int {
  return int(ptrOf(schedBlock))
}

export function poolWorkerAddr(i: int): int {
  return int(ptrOf(workerBlocks)) + i * workerWords * 8
}

// True once the task has parked with its context fully saved — the signal the
// driver waits on before moving it to another worker.
export function poolTaskParked(): bool {
  return atomicLoad(taskAt(poolTaskAddr()) + taskState) == taskParked
}

export function poolFinished(): bool {
  return atomicLoad(ptrOf(obsFinished)) != 0
}

// Clear `stopping` so a fresh worker can run after the first one was joined.
export function poolRestart() {
  atomicStore(taskAt(poolSchedAddr()) + scStopping, 0)
}

export function poolShutdown() {
  schedShutdown(taskAt(poolSchedAddr()))
}

// Make the parked task runnable again. `sched.zig`'s `unpark`, which routes
// through the global queue — the caller is the driver thread, not a worker.
//
// NOTE THAT THIS DOES NOT CHOOSE THE RESUMING WORKER, and it does not need to.
// An earlier draft added a `schedUnparkTo` that placed the task on a named
// worker's local ring, on the theory that migration had to be aimed to be
// deterministic. Mutation-testing disproved it: rewiring that call to aim at the
// WRONG worker did not fail this test, because whichever worker is alive steals
// the task anyway. The determinism comes entirely from having joined worker 0
// (step 4), so the aiming primitive was doing no work and has been dropped
// rather than kept as an unjustified addition to the Zig's API.
export function poolWake(): bool {
  return schedUnpark(taskAt(poolSchedAddr()), poolTaskAddr())
}

// ---------------------------------------------------------------------------
// The migrating task
// ---------------------------------------------------------------------------
//
// `@nosplit` because a task stack is not known to the collector, and now also
// because more than one OS thread is live — see `schedWorkerRun`'s comment on
// why the whole pool is `@nosplit` today.
@nosplit function migrateBody() {
  // Resolve everything needed for the park BEFORE any sentinel is live, so that
  // no call happens between loading them and the switch. See the header.
  let t = taskAt(addrTask)
  let wPtr = taskAt(schedCurrentWorker())
  obsWorkerBefore = *(wPtr + wkId)

  // Load the probe registers. Naming them in a `clobber` list also excludes
  // them from THIS function's allocator for its whole body (§11.6), which is
  // what stops the code around the switch from using them as scratch.
  asm {
    arm64 {
      0xD288E233,                                 // movz x19, #0x4711
      0xD288E254,                                 // movz x20, #0x4712
      0xD288E275                                  // movz x21, #0x4713
    }
    x64 {
      0xBB, 0x11, 0x47, 0x00, 0x00,               // mov ebx, 0x4711
      0x41, 0xBC, 0x12, 0x47, 0x00, 0x00,         // mov r12d, 0x4712
      0x41, 0xBD, 0x13, 0x47, 0x00, 0x00          // mov r13d, 0x4713
    }
    clobber arm64 { x19, x20, x21 }
    clobber x64 { rbx, r12, r13 }
  }

  // Park by hand: nothing between here and the switch may be a call.
  *(wPtr + wkDisposition) = taskParked
  schedSwitch(t, wPtr + wkCtx)

  // Resumed — on worker 1, on another OS thread. Read the probes back before
  // anything else can touch them.
  let got = asm {
    arm64 {
      0xAA1303E0,                                 // mov x0, x19
      0x8B140000,                                 // add x0, x0, x20
      0x8B150000                                  // add x0, x0, x21
    }
    x64 {
      0x48, 0x89, 0xD8,                           // mov rax, rbx
      0x4C, 0x01, 0xE0,                           // add rax, r12
      0x4C, 0x01, 0xE8                            // add rax, r13
    }
    result arm64 x0 x64 rax : int
  }

  obsSentinels = got
  let wAfter = schedCurrentWorker()
  obsWorkerAfter = *(taskAt(wAfter) + wkId)
  atomicStore(taskAt(addrFinished), 1)
  schedTaskExit()
}

// ---------------------------------------------------------------------------
// The task that exists to be stolen
// ---------------------------------------------------------------------------
//
// WHY THIS IS HERE, stated plainly because it was nearly missed. The migrating
// task travels through the GLOBAL queue (`schedUnpark`), so it never exercises
// work stealing at all. Mutation-testing found that: disabling the steal pass in
// `schedFindWork` entirely — `let n = 0`, so a worker never looks at any other
// worker's ring — did NOT fail this suite. Stealing is half of what makes the
// run loop M:N, and it was untested.
//
// This task closes that. It is queued on worker 0's LOCAL ring at a point where
// worker 0 is already retired, so the only way it can ever run is for worker 1
// to steal it out of a ring it does not own. If the steal pass is broken the
// task never runs and the bit stays clear.
@nosplit function stealBody() {
  atomicStore(taskAt(addrStolen), 1)
  schedTaskExit()
}

// Queue the steal task on worker 0's local ring. Called when worker 0 is no
// longer running, so nothing but a steal can pick it up.
export function poolQueueStealTask(): bool {
  let s = taskAt(poolSchedAddr())
  let stackBase = alignUpStack(int(ptrOf(stackArea))) + schedStackBytes
  if (!schedStackAligned(stackBase)) {
    return false
  }
  let t = taskAt(poolStealTaskAddr())
  schedTaskInit(t, stackBase, schedStackBytes, entryOf(stealBody), 0)

  // Registering is not optional. A worker unregisters every task it sees
  // finish, and `schedUnregister` on a task that was never linked in resets the
  // registry HEAD to 0 — silently dropping whatever else was on it. That is a
  // precondition of the Zig's `unregisterTask` too; it just has no way to say so.
  schedRegister(s, poolStealTaskAddr())
  return dqPushBottom(schedWorkerAt(s, 0) + wkDeque, poolStealTaskAddr())
}

export function poolStolen(): bool {
  return atomicLoad(ptrOf(obsStolen)) != 0
}

// Both tasks have run to completion. What the two-thread drivers wait on.
export function poolAllDone(): bool {
  return poolFinished() && poolStolen()
}

// ---------------------------------------------------------------------------
// Setup
// ---------------------------------------------------------------------------

// Build the scheduler, the task, and queue the task on worker 0 only.
// Returns false if the stack could not be aligned, which would silently break
// `schedCurrentTask` rather than fault.
export function poolInit(): bool {
  let decoy: *i64 = ptrOf(decoyStack)
  *decoy = poolTaskAddr()
  *(decoy + 1) = 12345

  addrTask = poolTaskAddr()
  addrFinished = int(ptrOf(obsFinished))
  addrStolen = int(ptrOf(obsStolen))

  let s = taskAt(poolSchedAddr())
  schedInit(s, int(ptrOf(workerBlocks)), poolWorkers)

  let stackBase = alignUpStack(int(ptrOf(stackArea)))
  if (!schedStackAligned(stackBase)) {
    return false
  }

  let t = taskAt(poolTaskAddr())
  schedTaskInit(t, stackBase, schedStackBytes, entryOf(migrateBody), 0)
  schedRegister(s, poolTaskAddr())
  obsRegAfterInit = schedRegCount(s)
  return dqPushBottom(schedWorkerAt(s, 0) + wkDeque, poolTaskAddr())
}

// The OS thread body for a worker.
//
// NOT `@nosplit`, and that is only safe because it contains NO LOOP — the same
// argument runtime/thread's providers make for their children. `schedWorkerRun`
// owns the loop and is itself `@nosplit`, so no safepoint is reached on this
// thread.
//
// `arg` points at a two-word block: the worker's address, then the `done` word
// this thread must clear on the way out. Clearing it is mandatory on Darwin
// (pthreads has no `CLONE_CHILD_CLEARTID`) and harmless on Linux, where the
// kernel clears it too — so one wrapper serves both platforms.
export function poolWorkerEntry(arg: *byte): *byte {
  let block = taskAt(int(arg))
  let workerAddr = *block
  let doneAddr = *(block + 1)

  schedWorkerRun(taskAt(workerAddr))

  let z: *i32 = nil
  atomicStore(z + doneAddr / 4, i32(0))
  return nil
}

// ---------------------------------------------------------------------------
// The verdict
// ---------------------------------------------------------------------------
//
// Four independent properties, one bit each, so a partial failure says which
// half broke rather than just "wrong number":
//
//   1  the task ran and finished
//   2  it started on worker 0
//   4  it resumed on a DIFFERENT worker  <- the migration itself
//   8  its callee-saved registers survived that migration
//  16  the registry held the task while live and dropped it at teardown
//  32  a second task was STOLEN out of a retired worker's local ring
//  64  the stack tag distinguishes a task stack from a look-alike region
//
// The registry bit is checked in two halves at two points that CANNOT race the
// worker: the count after `poolInit` is taken on the driver's thread before any
// worker exists, and the count after teardown is only read once the last
// worker's OS thread has been joined, so its `taskDone` unregister has
// certainly run. Reading the live count at any other moment would be a race
// against the worker rather than a property.
export const poolTotal: int = 127

export function poolVerdict(): int {
  let mask = 0
  if (obsFinished != 0) {
    mask = mask | 1
  }
  if (obsWorkerBefore == 0) {
    mask = mask | 2
  }
  if (obsWorkerAfter != obsWorkerBefore && obsWorkerAfter >= 0) {
    mask = mask | 4
  }
  if (obsSentinels == poolSentinelSum) {
    mask = mask | 8
  }
  if (obsRegAfterInit == 1 && schedRegCount(taskAt(poolSchedAddr())) == 0) {
    mask = mask | 16
  }
  if (obsStolen != 0) {
    mask = mask | 32
  }

  // The stack tag, checked both ways.
  //
  // Positive: the migrating task's own stack base resolves back to that task.
  // Negative: `decoyStack`, which holds a plausible-looking task address but no
  // tag, resolves to 0 rather than to the address it contains.
  //
  // ASKING ONLY `schedCurrentTask() == 0` FROM THIS THREAD WOULD BE VACUOUS —
  // measured: the driver's stack reads 0 at its 64KiB boundary anyway, so that
  // assertion passes with the tag check deleted. The decoy is what makes the
  // absence of the check observable, and `schedSpawn` (callable from any thread
  // per the Zig) is the path that would otherwise dereference such a word.
  // One line: a condition broken across lines is closed by ASI at the newline
  // (§7), the same gap that stops a multi-line `import` from parsing.
  let decoy = int(ptrOf(decoyStack))
  let tagPos = schedTaskOnStack(poolStackBase()) == poolTaskAddr()
  let tagNeg = schedTaskOnStack(decoy) == 0
  if (schedCurrentTask() == 0 && tagPos && tagNeg) {
    mask = mask | 64
  }
  return mask
}

// ---------------------------------------------------------------------------
// Bounded waits
// ---------------------------------------------------------------------------
//
// Every wait here is finite BY CONSTRUCTION, carrying both a deadline and a
// static trip bound — `runtime/thread`'s `threadJoin` pattern, adopted for the
// same reason it exists there. A deadline alone is only as trustworthy as the
// clock enforcing it, and a wait that can hang turns a wedged scheduler into a
// hung test suite instead of a failing one. This project has already paid for
// that once, when a closing QUIC peer stranded its waiters.
//
// The clock and sleep arrive as function VALUES because this module must import
// neither platform provider, and both are platform code — the same shape
// `threadJoin` uses, and it keeps one copy of each wait rather than a
// per-platform copy that could drift.
const WAIT_MAX_POLLS: int = 100000

export function poolWaitParked(sleepFn: (int) => (), monoFn: () => int, timeoutNs: int): bool {
  let deadline = monoFn() + timeoutNs
  let i = 0
  while (i < WAIT_MAX_POLLS) {
    if (poolTaskParked()) {
      return true
    }
    if (monoFn() >= deadline) {
      return false
    }
    sleepFn(parkMinBackoffNs)
    i = i + 1
  }
  return false
}

export function poolWaitFinished(sleepFn: (int) => (), monoFn: () => int, timeoutNs: int): bool {
  let deadline = monoFn() + timeoutNs
  let i = 0
  while (i < WAIT_MAX_POLLS) {
    if (poolAllDone()) {
      return true
    }
    if (monoFn() >= deadline) {
      return false
    }
    sleepFn(parkMinBackoffNs)
    i = i + 1
  }
  return false
}
