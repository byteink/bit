// Shared property checks for the write/exit providers of the Stage-2 port of
// runtime/root.zig (#1367) — SEAM 3's kernel-facing half.
//
// `runtime/root/linux/io.bit` reaches the kernel with a raw `write`/`exit_group`
// syscall (§11.8) and `runtime/root/darwin/io.bit` with a libSystem
// `write`/`_exit` call (§11.7), and those two cannot appear in one module — an
// `extern function` is rejected outright when targeting Linux and a `syscall`
// when targeting Darwin. So the driver is split into `../../rootiolinux` and
// `../../rootiodarwin`, and everything they assert lives HERE, shared verbatim,
// so the two platforms are held to an identical standard and cannot drift. Same
// shape as `../../alloc/props` and `../../rand/props`.
//
// The provider is taken as function values rather than imported, which is what
// lets one copy serve both platforms.
//
// ---------------------------------------------------------------------------
// WHY THE GOLDEN FILE IS THE ORACLE HERE, AND WHAT THAT BUYS
// ---------------------------------------------------------------------------
//
// Every other stress program in this tree computes a summary and prints it. This
// one CANNOT, because what is under test IS the printing: a function that writes
// the wrong bytes to the right fd, or the right bytes to the wrong fd, would
// still return normally and still let a hand-computed mask come out full.
//
// So the assertions are made positionally, in the golden itself. The port's own
// `rootPrint`/`panicWrite`/`rootWriteAll` emit bytes DIRECTLY into this
// program's stdout, interleaved with ordinary `print` calls, and
// `tests/stress.zig` compares the whole stream byte for byte. That makes the
// golden a transcript rather than a summary: a swapped fd, an off-by-one length,
// a dropped prefix or a reordered write all change it.
//
// Two properties are checked by ABSENCE, which is the only way to check them:
//
//   P2  `eprint` MUST NOT REACH STDOUT. It writes a loud marker to fd 2; the
//       harness compares stdout only, so the marker appearing in the golden is
//       the failure. This is what catches fd 1 and fd 2 being swapped — a bug no
//       amount of checking `eprint`'s return value could see, since it has none.
//
//   P5  `rootExit` MUST ACTUALLY EXIT. A marker is printed immediately AFTER the
//       call; reaching it means the exit fell through. The process must also end
//       with status 0, which `tests/stress.zig` requires independently — so this
//       one line checks both that the exit happens and that the code survives
//       the low-8-bit mask.
//
//   P7  (#1715) THE ONE-RESULT TYPE ASSERTION'S PANIC LINE, checked the same
//       way P3 checks `rootPanic`'s: a MATCH writes nothing (checked by
//       ABSENCE, bracketed like P6), a MISMATCH writes
//       `panic: type assertion failed: <got> is not <want>\n` verbatim. Only
//       the write half — `bit_rt_iface_assert`'s `exit(2)` is `rootExit`'s
//       same syscall P5 already proves, and this file's own policy is not to
//       re-prove a non-zero exit status (see below).
//
// WHAT IS NOT COVERED, STATED PLAINLY: a NON-ZERO exit code. `rootExit(2)` is
// what `rootPanic` uses, but observing it needs a parent to reap the child, and
// the stress harness runs one process and requires status 0 from it. The mask
// arithmetic is shared with the zero case and the Zig is a one-line
// `exit_group`/`_exit` call, so the residual risk is a wrong syscall NUMBER —
// which P5 would already catch, since a wrong number cannot exit 0 either.

import {
  loadWord, loadByte, storeWord,
  gcTiSize, gcTiPtrOffsetsPtr, gcTiPtrOffsetsLen, gcTiNamePtr, gcTiNameLen,
  gcTiMethodsPtr, gcTiMethodsLen,
} from "../../../../runtime/gc"
import {
  rootBindMemory, rootInit, rootConfigure, rootStatOom,
  rtSliceNew, rtSliceSet, rtStringFromBytes,
  strPtr, strLen, rtGcAlloc,
} from "../../../../runtime/root"

// 1 MiB of object heap and 16 KiB of index — far more than the handful of short
// strings below need. Nothing collects the port's heap in this program, so every
// allocation is permanent; `rootStatOom` is asserted zero on the last line so a
// silent exhaustion cannot masquerade as a pass. Same sizing rationale as
// ../../rootbit, one eighth the arena because there is no map churn here.
const ARENA_WORDS = 131072
const INDEX_WORDS = 2048
const MARK_STACK = 4096
const MIN_TRIGGER = 65536
const GROWTH_PCT = 200

// A port-heap `string` holding the same bytes as the native string `s`.
// Identical to ../../rootbit's bridge and for the same reason: it goes through
// three real entry points rather than a private constructor.
function mine(s: string): int {
  let n = len(s)
  let h = rtSliceNew(n, n, 0)
  let i = 0
  while (i < n) {
    rtSliceSet(h, i, int(s[i]))
    i = i + 1
  }
  return rtStringFromBytes(h)
}

// The byte address of a port-heap string's payload (ABI.md §2: a `{ptr, len}`
// header whose `ptr` addresses the object's own inline bytes).
function bytesOf(s: int): int {
  let p = loadWord(s + strPtr)
  return p
}

function sizeOf(s: int): int {
  let n = loadWord(s + strLen)
  return n
}

// ---------------------------------------------------------------------------
// The portable half: is the BRIDGE sound?
// ---------------------------------------------------------------------------

// Check the port-heap string bridge that every transcript below depends on.
// Returns a mask of the properties that held; `bridgeTotal()` is the full house.
//
// WHY THIS EXISTS SEPARATELY FROM `ioProps`. `rootPrint` is handed a byte
// ADDRESS and a LENGTH, both computed here by `bytesOf`/`sizeOf`. If either were
// wrong, every platform transcript would be wrong too — but for a reason that
// has nothing to do with the provider under test. Splitting the bridge out means
// a failure says WHICH layer broke instead of just that something did, and it
// does so on every target rather than one at a time.
//
// It also gives `../../rootio` a real program of its own, which is what lets
// this directory host a shared props module at all: the stress harness
// enumerates every top-level directory under tests/stress and requires each to
// be a runnable program with a golden. Same arrangement as `../alloc/props`
// under `../alloc` and `../thread/props` under `../thread`.
export function bridgeProps(): int {
  // Own arena, own liveness obligation — see `ioProps` for why the witness at
  // the bottom is load-bearing rather than decorative.
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)

  rootBindMemory(int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!rootInit(MARK_STACK)) {
    return 0
  }
  rootConfigure(true, false, MIN_TRIGGER, GROWTH_PCT, false)

  let mask = 0

  // B1: the length a provider would pass to `write` is the string's real length.
  // Covers the empty string (a zero-length write is P4z's case) and a
  // multi-word string, so neither a `+1` nor a word/byte confusion survives.
  if (sizeOf(mine("")) == 0 && sizeOf(mine("a")) == 1 && sizeOf(mine("abcdefgh")) == 8 &&
      sizeOf(mine("the quick brown fox")) == 19) {
    mask = mask | 1
  }

  // B2: the bytes at that address are the string's real bytes, in order. This is
  // the property the whole transcript rests on — a provider that writes the
  // right length from the wrong address still produces output, just garbage.
  // Read back through `loadByte` at the SAME address arithmetic the providers
  // use, including the interior offset P4 exercises.
  let txt = "abcdefgh"
  let m = mine(txt)
  let base = bytesOf(m)
  let ok2 = base != 0
  let i = 0
  while (i < len(txt)) {
    if (loadByte(base + i) != int(txt[i])) {
      ok2 = false
    }
    i = i + 1
  }
  if (ok2) { mask = mask | 2 }

  // B3: two distinct strings do not alias. If `mine` handed back one buffer, the
  // transcript would still look plausible for a single write and collapse for
  // two — exactly the shape that makes P1 and P3 pass or fail together.
  //
  // THE DISTINCT BYTES ARE THE PROOF, not an added comparison of the addresses:
  // aliased buffers would necessarily read the same byte, so 'i' and 'j' both
  // arriving is already non-aliasing. An explicit `bytesOf(x) != bytesOf(y)`
  // conjunct was here and mutation showed deleting it changed nothing — it was
  // implied by the two checks that follow it, so it is gone rather than kept as
  // decoration.
  let x = mine("iiii")
  let y = mine("jjjj")
  if (loadByte(bytesOf(x)) == 105 && loadByte(bytesOf(y)) == 106) {
    mask = mask | 4
  }

  // B4: allocation is still sound after the churn above, and nothing ran out —
  // an exhausted arena would make every string empty, which reads as a length
  // bug rather than as the resource failure it is.
  let live = mine("live")
  if (sizeOf(live) == 4 && rootStatOom() == 0) { mask = mask | 8 }

  // Extends both arena slices past every safepoint above (see `ioProps`).
  //
  // MUTATION DID NOT KILL THIS ONE, and it is kept anyway — the asymmetry is
  // deliberate. Replacing it with `true` leaves this function passing, while the
  // identical witness in `ioProps` is load-bearing (deleting it there is an
  // immediate SIGSEGV). The difference is only how much work happens between the
  // bind and the witness: this function allocates a handful of strings, `ioProps`
  // runs the whole transcript. The HAZARD is the same and it is real — the arena
  // address lives in module state, which the collector never scans (rule 1), so
  // nothing but this witness roots it. It did not fire here; it would the moment
  // anyone added allocation above. Kept as the obligation it is, labelled as
  // unfired rather than advertised as proven.
  if (len(arena) == ARENA_WORDS && len(indexArena) == INDEX_WORDS) { mask = mask | 16 }

  return mask
}

export function bridgeTotal(): int { return 31 }

// ---------------------------------------------------------------------------
// The platform half: does the PROVIDER put the right bytes on the right fd?
// ---------------------------------------------------------------------------

// Drive every entry point of a write/exit provider, emitting a fixed transcript
// on stdout.
//
// RETURNS NOTHING, because it does not return: `exitFn` is called last and ends
// the process on success (P5). A result would be unreachable by construction, so
// the arena-liveness witness is PRINTED here rather than handed back — see
// `rooted` below.
//
// Every byte the port emits is BRACKETED by native `print` calls, so a write of
// the wrong length shows up as displaced brackets rather than as text that still
// happens to read plausibly.
//
// EVERY VOID-RETURNING PARAMETER IS WRAPPED TO RETURN `bool`, WITH THE RESULT
// DISCARDED, which needs explaining because it looks like an oversight. Most
// functions under test return void — that is their ABI (§12) and it does not
// change. But §5.3's `func_type` grammar is `"(" [types] ")" "=>" result_type`
// with NO void form, so a void-returning function CANNOT BE SPELLED AS A
// FUNCTION TYPE and cannot be passed as a value at all. The drivers therefore
// wrap each void one in a three-line `: bool` shim and pass that. The shims
// are the only thing duplicated between the two platforms; every assertion
// still lives here, which is the property the split exists to preserve.
// `ifaceAssertFn` is the one exception: `ifaceAssertWrite` already returns
// `int`, so §5.3's grammar spells its type directly and no shim is needed.
//
// (Worth a ticket in its own right: a first-class function value is useless for
// the entire void-returning half of an API, and this is the second port to want
// one. Not filed here — it is a language gap, not #1367's surface.)
export function ioProps(writeAll: (int, int, int) => bool,
                        printFn: (int) => bool, eprintFn: (int) => bool,
                        panicWriteFn: (int, int) => bool,
                        ifaceAssertFn: (int, int, int) => int,
                        exitFn: (int) => bool) {
  // Only raw, untraced addresses into these ever reach the port, so these
  // bindings are the ONLY thing keeping the arena alive — AND A BINDING IS NOT
  // ENOUGH, it must still be LIVE. Liveness is by LAST USE, not by scope: were
  // `arena`'s last use the `ptrOf` below, the stack map would stop naming it and
  // the first collection under `BIT_GC=stress` would sweep the port's entire
  // heap out from under it. `rooted` at the bottom is what extends both slices
  // across every safepoint in between; it is load-bearing, not a diagnostic,
  // which is why the caller prints its result rather than discarding it.
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)

  rootBindMemory(int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!rootInit(MARK_STACK)) {
    print("rootInit failed\n")
    return
  }
  rootConfigure(true, false, MIN_TRIGGER, GROWTH_PCT, false)

  // ---- P1: `print` puts EXACTLY these bytes on stdout ----------------------
  //
  // Emitted between two ordinary `print` calls, so the transcript pins the
  // ORDER as well as the content: the port's writes and the native runtime's
  // both go to fd 1 unbuffered, so a reordering would be visible. The marker
  // deliberately contains no trailing newline of its own — the newline comes
  // from the native `print` after it, which means a `rootPrint` that wrote one
  // byte too many or too few shifts the rest of the line.
  print("P1[")
  printFn(mine("alpha"))
  print("]\n")

  // ---- P2: `eprint` goes to fd 2, NOT fd 1 ---------------------------------
  //
  // Checked by ABSENCE (see the header). If `rootEprint` wrote to stdout, this
  // marker would land in the middle of the transcript and the golden would
  // mismatch. The text is deliberately unmistakable so a failure diff reads as
  // a diagnosis rather than a puzzle.
  eprintFn(mine("P2-THIS-MUST-NOT-REACH-STDOUT"))

  // ---- P3: the panic line's exact format -----------------------------------
  //
  // `panic: <msg>\n` — prefix, message, newline, in that order. Directed at fd 1
  // rather than fd 2 purely so it lands in the compared stream; `rootPanic`
  // fixes it to stderr. A dropped prefix, a missing newline, a truncated
  // 6-or-8-byte prefix (it is packed into one word and its length is stated
  // separately, so both are possible to get wrong independently) all show here.
  print("P3[")
  panicWriteFn(1, mine("boom"))
  print("]\n")

  // ---- P4: `writeAll`'s offset and length arithmetic -----------------------
  //
  // A three-byte window out of the MIDDLE of an eight-byte string: start at +2,
  // run for 3, expect exactly "cde". Neither endpoint is at a boundary, so an
  // off-by-one at either end changes the output rather than falling off a cliff,
  // and reading from `addr + off` versus `addr` is distinguishable — which it
  // would not be if the window started at 0.
  print("P4[")
  let s = mine("abcdefgh")
  writeAll(1, bytesOf(s) + 2, 3)
  print("]\n")

  // A zero-length write must emit nothing rather than trapping or writing a
  // stray byte; the loop's guard is `off < n`, which is only exercised as a
  // FIRST-iteration test by this case.
  print("P4z[")
  writeAll(1, bytesOf(s), 0)
  print("]\n")

  // ---- P6: a NULL string header writes NOTHING (#1564/#1570) ---------------
  //
  // A zeroed struct's `string` field is the null word (SPEC §13.4), so
  // `print(z.label)` hands 0 to this provider in ordinary Bit code.
  // `root.zig` takes an OPTIONAL header on `bit_rt_print`/`bit_rt_eprint` and
  // reads null as `""`; the provider must do the same instead of loading its
  // `{ptr, len}` from address 0.
  //
  // BRACKETED, so "wrote nothing" is proven rather than assumed: without the
  // guard the process dies here and the golden loses every line from this point
  // on — including P6's own closing bracket and the verdict below.
  print("P6[")
  printFn(0)
  print("]\n")

  // Null through `eprint` too (absence-checked on fd 2, like P2), and through
  // the PANIC path, which must still emit its prefix and newline around an empty
  // message. The panic path is the one that runs when everything else has
  // already failed, so it is the least acceptable place for a null to fault.
  eprintFn(0)
  print("P6p[")
  panicWriteFn(1, 0)
  print("]\n")

  // ---- P7: the type-assertion panic line's exact format (#1715) -------------
  //
  // `bit_rt_iface_assert` (ABI.md §2.2) must panic on a mismatch, and unlike
  // `rootPanic` it cannot take a heap `string` — the message names two
  // `TypeInfo` descriptors it reads directly, exactly as `rootOom`'s message
  // is packed rather than allocated. Two hand-built descriptors and one real
  // GC object (`rtGcAlloc`) stand in for `Circle`/`Square`, the same rig
  // `tests/stress/rootbit`'s phase I uses for the decision half of this
  // assertion; this checks the WRITE half that phase I cannot reach without
  // exiting the process.
  let meta = []i64(16)
  let metaBase = int(ptrOf(meta))
  let nameCircle = mine("Circle")
  let nameSquare = mine("Square")
  storeWord(metaBase + gcTiSize, 16)
  storeWord(metaBase + gcTiPtrOffsetsPtr, 0)
  storeWord(metaBase + gcTiPtrOffsetsLen, 0)
  storeWord(metaBase + gcTiNamePtr, bytesOf(nameCircle))
  storeWord(metaBase + gcTiNameLen, sizeOf(nameCircle))
  storeWord(metaBase + gcTiMethodsPtr, 0)
  storeWord(metaBase + gcTiMethodsLen, 0)
  let infoCircle = metaBase
  let infoSquare = metaBase + 7 * 8
  storeWord(infoSquare + gcTiSize, 16)
  storeWord(infoSquare + gcTiPtrOffsetsPtr, 0)
  storeWord(infoSquare + gcTiPtrOffsetsLen, 0)
  storeWord(infoSquare + gcTiNamePtr, bytesOf(nameSquare))
  storeWord(infoSquare + gcTiNameLen, sizeOf(nameSquare))
  storeWord(infoSquare + gcTiMethodsPtr, 0)
  storeWord(infoSquare + gcTiMethodsLen, 0)
  let circleObj = rtGcAlloc(infoCircle)

  // A match writes NOTHING and hands back the receiver — bracketed the same
  // way P6 proves absence, since the process would otherwise lose every line
  // after a false write.
  print("P7[")
  ifaceAssertFn(1, circleObj, infoCircle)
  print("]\n")

  // A mismatch writes the full line: prefix, both names straight out of the
  // descriptors' own bytes, and the newline — everything `panic:
  // type assertion failed: Circle is not Square\n` needs, with neither name
  // truncated nor swapped.
  print("P7m[")
  ifaceAssertFn(1, circleObj, infoSquare)
  print("]\n")

  // Extends `arena`/`indexArena` past every safepoint above (see their comment)
  // and, by allocating from the port's heap AFTER all the writing, proves that
  // heap is still intact rather than merely still addressable.
  let stillWorks = sizeOf(mine("live")) == 4
  let rooted = len(arena) == ARENA_WORDS && len(indexArena) == INDEX_WORDS && stillWorks

  // `oom` is part of the verdict, not a side check: every property above assumes
  // its allocations succeeded, and a silent exhaustion would make the strings
  // empty rather than the writes wrong.
  print("rootio rooted=${rooted} oom=${rootStatOom()}\n")

  // ---- P5: `rootExit` actually exits, with status 0 -------------------------
  //
  // Nothing may follow but the failure marker. Reaching it means the exit fell
  // through, and its presence in stdout fails the golden.
  exitFn(0)
  print("P5-EXIT-FELL-THROUGH\n")
}
