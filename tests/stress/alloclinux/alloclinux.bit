// Linux half of the #1362 verification: `runtime/alloc/linux`'s page provider,
// which reaches the kernel through a raw 6-argument `mmap` syscall (§11.8) —
// the one call form that puts an argument in `r10` on x86-64 and so separates
// the kernel ABI from the C ABI.
//
// A separate program from `allocdarwin` because §11.7 and §11.8 cannot coexist
// in one module — a `syscall` is rejected when targeting Darwin and an
// `extern function` declaration when targeting Linux (E0078), so a single
// source form would fail to compile for BOTH. `linux-only` marks it for the
// harness.
//
// The properties themselves come from `../alloc/props`, shared verbatim with
// the Darwin program, so the two platforms are held to an identical standard.
// They run the REAL allocator on REAL kernel pages — the end-to-end path a
// shipped libbitrt.a takes.

import { pageProps, pageTotal } from "../alloc/props"
import { mapPages, unmapPages, pageSize } from "../../../runtime/alloc/linux"

function main() {
  print("alloclinux pages=${pageProps(mapPages, unmapPages, pageSize)}/${pageTotal()}\n")
}
