// #2167's other socket-free variant: N fire-and-forget `spawn`s — no join, no
// sockets, no locks. Companion to `../spawnjoin` (joined) and
// `../spawnconnleak` (socket-parked); together the three prove the fix is
// universal to task teardown, not specific to how a task is scheduled or
// resumed. See `../spawnjoin`'s header for why this corpus asserts
// correctness rather than RSS, and #2167 for the external RSS table.
//
// Completion is observed through a plain atomic counter rather than a
// `WaitGroup`, because "fire-and-forget" is the point: nothing here ever
// blocks waiting on a specific spawned task, only polls for the aggregate
// count to reach N — the shape the ticket's own disproof measured
// ("300 000 fire-and-forget spawns... RSS flat" was the claim; the fresh
// measurement was linear at the same ~48-49 KB/spawn rate as everything
// else, before the fix).

import { sleep, Millisecond } from "std/time"

// Untraced module state (SPEC §11.11): a fixed `[1]i64`, written from every
// spawned task and read only by `main`'s own poll loop below, never walked by
// the collector.
let counter: [1]i64

fn noop() {
  atomicAdd(ptrOf(counter), 1)
}

const N: int = 3000

// Bounded poll (Power of 10, rule 2): a broken teardown that wedges a worker
// must fail this program rather than hang the suite. `sleep` PARKS this green
// thread each round rather than spinning it — required with `BIT_WORKERS=1`,
// where a busy-spinning main would starve every worker able to run the
// spawned tasks it is waiting on.
const maxPolls: int = 20000

fn main() {
  let i = 0
  while (i < N) {
    spawn noop()
    i = i + 1
  }
  let polls = 0
  while (int(atomicLoad(ptrOf(counter))) < N && polls < maxPolls) {
    sleep(1 * Millisecond)
    polls = polls + 1
  }
  print("spawnfireforget ${int(atomicLoad(ptrOf(counter)))}\n")
}
