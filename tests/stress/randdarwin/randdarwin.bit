// Darwin half of the #1368 verification: `runtime/rand/darwin`'s
// `entropyFill`, which reaches the OS CSPRNG through `arc4random_buf` via
// `extern function` (§11.7).
//
// A separate program from `randlinux` because §11.7 and §11.8 cannot coexist
// in one module — an `extern function` declaration is rejected outright when
// targeting Linux (E0078) and a `syscall` when targeting Darwin, so a single
// source form would fail to compile for BOTH. `darwin-only` marks it for the
// harness.
//
// The properties themselves come from `../rand/props`, shared verbatim with
// the Linux program, so the two platforms are held to an identical standard
// and the guard-band regime cannot drift between them.

import { entropyProps, entropyTotal } from "../rand/props"
import { entropyFill } from "../../../runtime/rand/darwin"

fn main() {
  print("randdarwin entropy=${entropyProps(entropyFill)}/${entropyTotal()}\n")
}
