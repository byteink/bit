// A string-keyed map held live across a GC-churning loop. Under BIT_GC=stress
// the collector runs at every back-edge; `keep`, its ref key buffer (the
// interpolated string keys) and its value buffer must stay rooted through
// map_info's ptr_offsets, or a survivor is swept and the checksum breaks. The
// live set is kept small (1k entries) so per-collection cost stays O(1k): the
// point here is rooting correctness, not raw throughput (the 100k insert/
// lookup/delete volume gate is the run_map_stress golden).
function main() {
  let keep = map<string, int>()
  let i = 0
  while (i < 1000) {
    keep["k${i}"] = i
    i = i + 1
  }

  // Churn: a throwaway map and its interpolated key every iteration, discarded
  // immediately. Forces collections that must not touch `keep`.
  i = 0
  while (i < 20000) {
    let junk = map<string, int>()
    junk["j${i}"] = i
    i = i + 1
  }

  let hit = 0
  let sum = 0
  i = 0
  while (i < 1000) {
    if (keep["k${i}"] == i) {
      hit = hit + 1
    }
    sum = sum + keep["k${i}"]
    i = i + 1
  }
  print("hit=${hit} sum=${sum} len=${len(keep)}\n")
}
