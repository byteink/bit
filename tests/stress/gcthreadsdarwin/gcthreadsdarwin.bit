// Concurrent collection on the Darwin thread provider (#1431).
//
// Darwin-only by construction, hence the sibling `darwin-only` marker: the
// provider declares `extern function`s (SPEC §11.7), which the compiler rejects
// on both Linux targets with E0078 even for an uncalled declaration.
//
// The properties, and the argument for why each one discriminates, live in
// ./../thread/gcprops. This file supplies only the platform binding. It is kept
// identical in shape to its Linux twin, so a future divergence between the two
// means a real platform difference rather than a spelling one.
import { gcThreadsRun, gcThreadsTotal } from "../thread/gcprops"
import { threadStart, threadRelease } from "../../../runtime/thread/darwin"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/darwin"

function main() {
  let got = gcThreadsRun(threadStart, threadRelease, parkSleepNs, parkMonoNs)
  let total = gcThreadsTotal()
  print("${got == total} ${got}\n")
}
