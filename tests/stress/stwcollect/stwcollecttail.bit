// tests/stress/stwcollect/stwcollecttail.bit — the geometry constants and the
// independent stack-map decoder (u16At/u32At/u64At/i32At/mapsBegin/mapsEnd,
// alive, usableSlot) that stwcollect.bit's main() uses, split off under the
// 800-line limit (#2481). Sibling files in a directory are the same module, so
// this file holds no import of its own. Every `ROOT CLASS <n>` marker stays in
// stwcollect.bit itself, unmoved: tests/bit/stwwiring/stwwiring.bit reads that
// exact file by name and scans it for the markers, so a marker moved here would
// silently drop out of coverage. Named `stwcollecttail` per #2481's own
// constraint that stwcollect.bit keep its name (tests/bit/stwwiring/stwwiring.bit
// names it in a constant); it sorts bytewise after `stwcollect.bit`.

// Channel header field offsets, in words — runtime/chan/chan.bit's private
// layout, hardcoded exactly as tests/stress/chanroots and chanmakeroots do. A
// layout drift fails this test loudly, which is the intent.
const CH_BUF = 2
const CH_COUNT = 5

const CAP = 8
const ARENA_WORDS = 131072
const INDEX_WORDS = 8192
const MARK_STACK = 64
const MIN_TRIGGER = 4096
const GROWTH_PCT = 200
const CHAN_RESERVE_WORDS = 4096
// The SHORT synthetic stack, and it is short on purpose: #1679's scratch scan
// walked a fixed `chanScratchWords` (265) words off a task's stack base, which
// on a 64-word block reads 201 words past the end and SIGSEGVs. That is how the
// scan's `min(chanScratchWords, stackBytes/8)` bound was found rather than
// reasoned about, so a registered task with a stack shorter than the scratch
// area has to stay in this program.
const TASK_STACK_WORDS = 64

// The class-4 task's stack, and THE REASON IT IS LONGER THAN THE SCRATCH AREA.
//
// The class-4 payload used to sit at word 7 of the 64-word stack above, with
// `sp` at the base — and that case went VACUOUS the moment #1679 added class 6,
// because the scratch scan covers `min(265, 64)` = the whole of that block.
// Deleting the class-4 stack walk left this program fully green (measured), so
// the assertion labelled `stack=` was being carried by a different class.
//
// The separation is now structural: `sp` starts exactly ONE WORD PAST the
// scratch area, so class 6 covers words 0..264, class 4 covers 265..511, and
// the payload at 400 is reachable from class 4 and nothing else.
const LONG_STACK_WORDS = 512
const LONG_STACK_SLOT = 400

// Metadata: one leaf `Node` TypeInfo (16-byte body, no pointer fields, so the
// marker word is pure data the tracer never reinterprets), the
// `ref_array_info` sentinel `gcInit` matches by address, and one MALFORMED
// TypeInfo for phase F. Seven words each, then the malformed one's offset
// array.
const META_WORDS = 22
const MI_NODE = 0
const MI_REFARR = 7
// A 16-byte body declaring ONE pointer field at offset 4 — MISALIGNED, so
// `scanObject` must count it in `gcStatBadOffsets` and skip it rather than read
// a straddling word (`runtime/gc` deviation 5).
const MI_BAD = 14
const MI_BAD_OFFS = 21

// The `Mutator` record layout in the World block (`runtime/gc/gcworld.bit`),
// whose word offsets are private to that file — hardcoded here exactly as the
// channel header offsets above are, and a drift fails phase E loudly (the fake
// slot never reads as parked, the rendezvous expires and `abandoned=` goes
// non-zero) rather than silently skipping the class.
const MU_STATE = 0
const MU_FRAME = 1
const MU_ACKED = 2
// Word 4 (`gcworld.bit`'s `const muSp = 4`): the caller's `sp` at entry to a
// `syscall` region, published by `worldBeginSyscall` and read by class 9's
// `stwSyscallLo`. Hardcoded for the same reason MU_STATE/MU_FRAME/MU_ACKED
// are: a drift fails phase J loudly (the slot never reads as belonging to
// the fake task, and `alive=false` for a payload that should have survived)
// rather than silently skipping the class.
const MU_SP = 4
// The slot stride is `muWords`, imported rather than copied. It WAS a local
// `const MU_WORDS = 4`, and #1904 making it 5 silently moved every slot this
// file writes — the state landed in the wrong word, the slot never looked
// parked, and phases E/G/H reported abandoned collections that read exactly
// like a collector regression. A cross-module const cannot initialize a
// top-level one (E0064), so the import is used at each site below.
// `worldEpochWord`: the stop counter, one past the slot array.
const MU_EPOCH_IDX = 1

// The synthetic frame phase C plants a precise root in. `FRAME_MID` is far
// enough from both ends that a stack-slot offset of either sign lands inside.
const FRAME_WORDS = 4096
const FRAME_MID = 2048
// How far from `fp` a usable stack slot may sit.
const FRAME_REACH = 8192

// `SafepointFrame` (ABI.md §4): ret, fp, then 32 register words.
const SNAP_WORDS = 34

const M_CHAN = 1001
const M_ARG = 1002
const M_STACK = 1003
const M_DEAD = 1004
const M_PRECISE = 1005
const M_MISSED = 1006
const M_SCR_ELEM = 1007
const M_SCR_ERR = 1008
const M_SCR_LAST = 1009
const M_SCR_DEAD = 1010
const M_PARKED = 1011
const M_PARKED_DEAD = 1012
const M_BADMAP = 1013
const M_CTX = 1014
const M_CTX_DEAD = 1015
// Phase H plants SIXTEEN payloads rather than one, and the count is the test.
// See phase H: a raw `int` local must be on the STACK for class 8 to be the
// class that reaches it, and sixteen simultaneously-live values cannot all sit
// in the callee-saved file (ten on arm64, five on x64), so at least six are
// spilled by any register allocator. One payload could have been kept in a
// register for its whole life and proven nothing.
const M_CLS8 = 1016
const CLS8_COUNT = 16
const M_CLS10 = 1017
const M_CLS10_DEAD = 1018
const M_SYSCALL = 1019
const M_SYSCALL_REG = 1020
const M_SYSCALL_DEAD = 1021

// Phase I's stack, and the three slots in it. The geometry is what makes the
// phase a test of class 10 ALONE, so each number is load-bearing:
//
//   - 512 words, longer than the 265-word scratch area, so class 6 covers only
//     words 0..264 and both slots below sit outside it.
//   - the published `SafepointFrame` at word 300, which is where the parked
//     mutator claims to be. Its first word is left 0, so `gcScanSnapshot`
//     (class 3) reads `ret == 0` and walks nothing — this phase must not be
//     carried by the precise walk phase E already proves.
//   - the payload at word 400, above the frame and below the task's `ctxSp`,
//     which phase I sets to the stack's own TOP so class 4's range is empty.
//
// So the payload is reachable from class 10 and from nothing else, and deleting
// `lo = stwParkedLo(world, t, lo)` from `stwScanTasks` must redden this line
// alone.
const PARK_STACK_WORDS = 512
const PARK_FRAME_SLOT = 300
const PARK_PAYLOAD_SLOT = 400

// A word inside `[0, ctxWords)` that is none of `ctxSp`/`ctxPc` — those two
// carry a live stack/code address on a REAL parked task and using either
// would make phase G indistinguishable from a test of the wrong field. Any
// other slot stands in for a callee-saved GP register (`schedSwitch`'s
// x19..x28 / rbx,r12..r15); this program never runs the task through a real
// switch, so no slot is more "correct" than another.
const CTX_SLOT = 6

// Phase J's stack, and the two slots in it — the same geometry phase I uses,
// for the same reason: 512 words is longer than the 265-word scratch area, so
// class 6 covers only words 0..264 and both slots below sit outside it, and
// `ctxSp` is set to the stack's own TOP so class 4's own contribution is
// empty. The published `sp` sits at word 300 — inside the mapping, above the
// scratch area — and the payload at word 400, between that `sp` and `ctxSp`,
// so only class 9's lowering of the scan's low bound brings it into range.
const SYSCALL_STACK_WORDS = 512
const SYSCALL_SP_SLOT = 300
const SYSCALL_PAYLOAD_SLOT = 400

// ---------------------------------------------------------------------------
// An INDEPENDENT decoder for the emitted stack-map table (ABI.md §4)
// ---------------------------------------------------------------------------
//
// Deliberately a second transcription rather than a call into the runtime's:
// this is what lets phase C name a real safepoint address and a real slot offset
// and then check that the RUNTIME's walk marks it. Layout, per entry:
//
//   u64 code_addr | u32 code_size | u16 num_saved | num_saved*(u16 reg, i32 off)
//   u16 num_safepoints | num_safepoints*( u32 ret_off
//                                       | u16 num_slots | num_slots*i32
//                                       | u16 num_regs  | num_regs*u16 )

fn u16At(a: int): int {
  return loadByte(a) | (loadByte(a + 1) << 8)
}

fn u32At(a: int): int {
  return u16At(a) | (u16At(a + 2) << 16)
}

fn u64At(a: int): int {
  return u32At(a) | (u32At(a + 4) << 32)
}

fn i32At(a: int): int {
  let v = u32At(a)
  if (v >= 2147483648) {
    return v - 4294967296
  }
  return v
}

@nosplit fn mapsBegin(): int {
  return int(stackMapsBegin())
}

@nosplit fn mapsEnd(): int {
  return int(stackMapsEnd())
}

// Still owned by `g` AND still carrying its marker: a swept-and-reused slot is
// owned again but reads back the wrong word, so both halves are needed.
fn alive(g: *i64, p: int, marker: int): bool {
  if (!gcOwns(g, p)) {
    return false
  }
  return loadWord(p) == marker
}

// Whether a stack slot offset can host phase C's planted root: inside the
// synthetic frame, and NOT on the frame record itself (+0 saved fp, +8 return
// address), which the walk reads to decide where to stop — planting there would
// break the walk's termination instead of testing its marking.
fn usableSlot(s: int): bool {
  if (s == 0 || s == 8) {
    return false
  }
  return s < FRAME_REACH && s > 0 - FRAME_REACH
}
