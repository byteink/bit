// Phase N of the `runtime/root` port differential (#1570): EVERY ENTRY POINT
// DRIVEN WITH A NULL HEADER.
//
// WHY THIS PHASE EXISTS. A zeroed class's `[]T` or `string` field is the NULL
// WORD (SPEC §13.4), so `len(z.tags)`, `z.tags[0]`, `append(z.tags, x)` and
// `print(z.label)` all hand 0 to a runtime entry point in ordinary Bit code.
// #1564 made the deleted native runtime's `root` module read that as the empty value; the Bit port under
// `runtime/root/` was left dereferencing it, which is #1570. Before this phase
// the two implementations were INDISTINGUISHABLE here — not because they agreed,
// but because nothing had ever called either one with a null (before #1564 that
// was a segfault everywhere, so no test could have existed).
//
// A SIBLING FILE, not a section of `rootbit.bit`: same module, so `mine`,
// `sameStr` and the imports there are all in scope with no import of its own
// (#1503). It sorts AFTER `rootbit.bit`, which is the order #1511 requires — its
// helpers must already be lowered for the inliner to reach them.
//
// EVERY CHECK BELOW IS MUTATION-VISIBLE. Each one either faults or returns a
// different answer if the guard it covers is deleted; a check that merely
// re-passes without its guard would be decoration.

fn phaseN(): int {
  let ok = 0

  // --- slices: reads -------------------------------------------------------
  // A null header is length 0, so every index is out of range and now panics
  // (#2014, SPEC §12.6) — covered by run_slice_index_read_panic.bit, not here.
  if (!rtSliceInBounds(0, 0)) { ok = ok + 1 }

  // An out-of-range write on a null header now panics too (#2014) — covered by
  // run_slice_index_write_panic.bit, not here.

  // --- slices: reslice -----------------------------------------------------
  // Capacity 0, so `[0:0]` is the ONLY in-bounds reslice; anything else is
  // rejected and now panics (#2014) — covered by run_slice_range_panic.bit.
  let z0 = rtSliceSlice(0, 0, 0)
  if (z0 != 0 && loadWord(z0 + slcLen) == 0) { ok = ok + 1 }

  // --- slices: append ------------------------------------------------------
  // Appending to a null header allocates a fresh slice instead of growing
  // through null.
  let a1 = rtSliceAppend(0, 7, 0, 8)
  if (a1 != 0 && loadWord(a1 + slcLen) == 1 && rtSliceGet(a1, 0, 8) == 7) { ok = ok + 1 }

  // is_ref on that fresh buffer matches the caller's static element type
  // rather than being conservatively traced (#1569): a []i64 append reads
  // is_ref==0 off the header directly, and a []string/ref append reads 1.
  if (loadWord(a1 + slcIsRef) == 0) { ok = ok + 1 }
  let r1 = rtSliceAppend(0, 0, 1, 8)
  if (r1 != 0 && loadWord(r1 + slcIsRef) == 1) { ok = ok + 1 }

  // NO SHARED EMPTY — the sharp one. `append` grows its header IN PLACE, so if
  // the port ever answered a null with one process-wide empty slice (the trap
  // #1557 named), the first append anywhere would corrupt it for every later
  // caller and these two would alias. They must be distinct objects holding
  // distinct values.
  let a2 = rtSliceAppend(0, 9, 0, 8)
  if (a1 != a2 && rtSliceGet(a1, 0, 8) == 7 && rtSliceGet(a2, 0, 8) == 9) { ok = ok + 1 }
  if (loadWord(a2 + slcLen) == 1 && !rtSliceInBounds(a2, 1)) { ok = ok + 1 }

  // The reslice of a null is fresh for the same reason: growing it must not be
  // visible through a second `[0:0]` taken afterwards.
  let z1 = rtSliceAppend(z0, 3, 0, 8)
  if (z1 != 0 && rtSliceGet(z1, 0, 8) == 3 && loadWord(rtSliceSlice(0, 0, 0) + slcLen) == 0) { ok = ok + 1 }

  // --- strings: a null header reads as "" ----------------------------------
  if (rtStringEq(0, 0)) { ok = ok + 1 }
  if (rtStringEq(0, mine(""))) { ok = ok + 1 }
  if (!rtStringEq(0, mine("x"))) { ok = ok + 1 }

  // Concat with a null on either side, and on both.
  if (sameStr(rtStringConcat(0, mine("tail")), "tail")) { ok = ok + 1 }
  if (sameStr(rtStringConcat(mine("head"), 0), "head")) { ok = ok + 1 }
  if (sameStr(rtStringConcat(0, 0), "")) { ok = ok + 1 }

  // Indexing: length 0, so every index is out of range and now panics (#2014)
  // — covered by run_string_index_panic.bit, not here.

  // Slicing: `[0:0]` yields a fresh empty string; anything else is rejected
  // and now panics (#2014) — covered by run_string_range_panic.bit.
  if (sameStr(rtStringSlice(0, 0, 0), "")) { ok = ok + 1 }

  // --- the conversions in both directions ----------------------------------
  // `[]byte(null_string)` is the empty `[]u8`...
  let nb = rtBytesFromString(0)
  if (nb != 0 && loadWord(nb + slcLen) == 0 && !rtSliceInBounds(nb, 0)) { ok = ok + 1 }
  // ...and `string(null_slice)` is "". This one takes a SLICE header, so the
  // `strBytes`/`strSize` funnel does not cover it — it carries its own guard.
  if (sameStr(rtStringFromBytes(0), "")) { ok = ok + 1 }

  // --- consumers of the funnel beyond strings.bit --------------------------
  // The point of guarding `strBytes`/`strSize` rather than each reader is that
  // every OTHER string consumer in the module inherits it. These three are not
  // string entry points at all, and all three are covered for free.
  if (rtWyhashString(0, u64(0)) == rtWyhashString(mine(""), u64(0))) { ok = ok + 1 }
  // Compared as a BIT PATTERN, not with `==`: `rtParseFloat` returns `f64`
  // since #1655 (a `u64` return travelled in the integer register while every
  // caller read the float one), and `v == v` is false for NaN — so a value
  // comparison here would not even see its own guard pass. Every rejection
  // path (a null string reads as "", the "no digits" case) returns the
  // canonical quiet NaN `0x7FF8000000000000` since #2138 (SPEC 5.3), not
  // +0.0.
  if (floatBits(rtParseFloat(0)) == u64(9221120237041090560)) { ok = ok + 1 }
  let pz = fsPathZ(0)
  if (pz != 0 && loadByte(pz) == 0) { ok = ok + 1 }

  // A null STRING KEY in a map, which reaches `mapHash` and `mapKeyEq` — both
  // of which hash and compare the key's bytes through the same funnel. A null
  // key must therefore behave exactly as "" does, including finding the entry
  // that "" inserted.
  let nm = rtMapNew(1, 0)
  rtMapSet(nm, 0, 5)
  if (rtMapGet(nm, mine("")) == 5 && rtMapHas(nm, 0) && rtMapLen(nm) == 1) { ok = ok + 1 }

  return ok
}
