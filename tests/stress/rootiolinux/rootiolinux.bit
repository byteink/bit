// Linux half of the #1367 SEAM 3 verification: `runtime/root/linux`'s write/exit
// provider, which reaches the kernel with raw `write` and `exit_group` syscalls
// (§11.8) rather than a libc, because Bit's ELF output is fully static with no
// libc to call into.
//
// A separate program from `rootiodarwin` because §11.7 and §11.8 cannot coexist
// in one module — a `syscall` is rejected outright when targeting Darwin and an
// `extern function` when targeting Linux (E0078), so a single source form would
// fail to compile for BOTH. `linux-only` marks it for the harness.
//
// Runs on both Linux architectures, which is the point of covering it here: the
// syscall NUMBERS differ per arch (write is 1 on x86-64 and 64 on aarch64,
// exit_group 231 and 94) and are selected at run time by `hostTarget()`, so a
// number transposed between the two arms is invisible on one architecture and
// fatal on the other. P5 catches it either way — a wrong `exit_group` number
// cannot exit 0.
//
// The properties themselves come from `../rootio/props`, shared verbatim with
// the Darwin program, so the two platforms are held to an identical standard.

import { ioProps } from "../rootio/props"
import {
  rootWriteAll, rootPrint, rootEprint, panicWrite, ifaceAssertWrite, rootExit,
} from "../../../runtime/root/linux"

// Shims that exist only to give each entry point a spellable function TYPE.
//
// Every function under test but `ifaceAssertWrite` returns void, and §5.3's
// `func_type` grammar has no void result form — so a void-returning function
// cannot be passed as a value at all. These are the minimum wrappers that make
// it possible, and they are the only code duplicated between this file and
// `../rootiodarwin`; `../rootio/props` holds every actual assertion. The `true`
// is never inspected. `ifaceAssertWrite` already returns `int` and is passed
// straight through, unshimmed.
function wWriteAll(fd: int, addr: int, n: int): bool {
  rootWriteAll(fd, addr, n)
  return true
}

function wPrint(s: int): bool {
  rootPrint(s)
  return true
}

function wEprint(s: int): bool {
  rootEprint(s)
  return true
}

function wPanicWrite(fd: int, s: int): bool {
  panicWrite(fd, s)
  return true
}

// Does not return when the provider is correct — that is property P5.
function wExit(code: int): bool {
  rootExit(code)
  return true
}

function main() {
  ioProps(wWriteAll, wPrint, wEprint, wPanicWrite, ifaceAssertWrite, wExit)
}
