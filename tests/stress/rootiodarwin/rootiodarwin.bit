// Darwin half of the #1367 SEAM 3 verification: `runtime/root/darwin`'s
// write/exit provider, which reaches the kernel through libSystem's `write` and
// `_exit` via `extern function` (§11.7). Apple publishes no stable syscall
// numbers, so a C call is the supported path.
//
// A separate program from `rootiolinux` because §11.7 and §11.8 cannot coexist
// in one module — an `extern function` declaration is rejected outright when
// targeting Linux (E0078) and a `syscall` when targeting Darwin, so a single
// source form would fail to compile for BOTH. `darwin-only` marks it for the
// harness.
//
// This program is ALSO the check that #1436 has not reached `write`. That bug —
// the self-hosted compiler emitting only libSystem's `$NOCANCEL` variant of a
// cancellable symbol and silently dropping the plain import, so the call lands
// on an unbound stub — builds cleanly and SIGSEGVs at run time. `write` is a
// cancellation point and so has exactly the `_write`/`_write$NOCANCEL` shape
// that broke `close`. `zig build test` runs this under BOTH compilers, which is
// what makes that visible; the differential gates cannot see it, since they
// compare check and type dumps rather than the linked image's import table.
//
// The properties themselves come from `../rootio/props`, shared verbatim with
// the Linux program, so the two platforms are held to an identical standard.

import { ioProps } from "../rootio/props"
import {
  rootWriteAll, rootPrint, rootEprint, panicWrite, rootExit,
} from "../../../runtime/root/darwin"

// Shims that exist only to give each entry point a spellable function TYPE.
//
// Every function under test returns void, and §5.3's `func_type` grammar has no
// void result form — so a void-returning function cannot be passed as a value at
// all. These are the minimum wrappers that make it possible, and they are the
// only code duplicated between this file and `../rootiolinux`; `../rootio/props`
// holds every actual assertion. The `true` is never inspected.
function wWriteAll(fd: int, addr: int, n: int): bool {
  rootWriteAll(fd, addr, n)
  return true
}

function wPrint(s: int): bool {
  rootPrint(s)
  return true
}

function wEprint(s: int): bool {
  rootEprint(s)
  return true
}

function wPanicWrite(fd: int, s: int): bool {
  panicWrite(fd, s)
  return true
}

// Does not return when the provider is correct — that is property P5.
function wExit(code: int): bool {
  rootExit(code)
  return true
}

function main() {
  ioProps(wWriteAll, wPrint, wEprint, wPanicWrite, wExit)
}
