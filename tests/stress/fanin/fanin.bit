// Fan-in under load: 500 green threads each send their id over one unbuffered
// channel; main sums them. Exercises spawn (arg-packed thunks, all GC objects),
// channel rendezvous, and — under BIT_GC=stress — collection while many workers
// are parked, so their stacks and the spawn thunks must survive the conservative
// parked-task scan. Sum of 0..499 = 124750.
function worker(id: i64, out: chan<i64>) {
  out <- id
}

function main() {
  let out = chan<i64>(0)
  let i = 0
  while (i < 500) {
    spawn worker(i, out)
    i = i + 1
  }
  let sum = 0
  let got = 0
  while (got < 500) {
    sum = sum + (<- out)
    got = got + 1
  }
  print("${sum}\n")
}
