// The netpoller park/register race and the protocol that closes it (#1366),
// against the ported scheduler (#1364).
//
// WHAT IS ACTUALLY BROKEN WITHOUT THIS. the deleted native runtime's `sched` module registers an fd with the
// poller from a `ParkFn` that runs on the WORKER's side of the context switch,
// strictly after the task's state is published as parked. That hook is a call
// through a function value, which `@nosplit` rejects (E0075), so a Bit task has
// to register BEFORE it parks. A readiness report that lands in the window
// between those two steps finds the task still `taskRunning`, fails
// `schedUnpark`'s compare-exchange, and is DROPPED. Timers survive that — the
// deadline is still on the list, so the next expire finds the task again — but
// a poller registration is ONE-SHOT, so the drain that failed to deliver has
// already consumed the edge and nothing will ever report that fd again.
//
// THIS IS NOT A TIMING TEST, AND THAT IS THE ONLY REASON IT IS WORTH HAVING.
// The window is a few instructions wide, so a program that spawned threads and
// hoped to land inside it would pass whether or not the protocol existed — the
// vacuous-guard shape this project has now found a dozen of. Instead the losing
// interleaving is PRODUCED: the task delivers the wake to ITSELF from inside its
// own window, which is bit-for-bit the same sequence of compare-exchanges a
// draining worker on another core performs, on every single run. A wake that is
// dropped is dropped deterministically.
//
// Platform-free by construction — no `syscall`, no `extern`, no real poller —
// so it runs on every target and carries no `linux-only`/`darwin-only` marker.
// The kernel-facing half of the poller is what ../schedpolllinux and
// ../schedpolldarwin exist for; what is under test HERE is the state machine,
// and a state machine is better tested without a kernel in the way.

import { schedInit, schedWorkerAt, schedWorkerRun, schedNoPoller } from "../../../runtime/sched"
import { schedTaskInit, schedRegister, schedSpawn, schedShutdown } from "../../../runtime/sched"
import { schedTaskExit, schedPark, schedCurrentTask } from "../../../runtime/sched"
import { schedParkArm, schedParkDisarm, schedPollUnpark } from "../../../runtime/sched"
import { schedStackAligned, schedStackBytes, taskAt } from "../../../runtime/sched"

const parkWorkers: int = 1

// How many arm/wake/park cycles the racer performs. Every one of them is a
// losing interleaving, so ONE would already prove the protocol; the count is
// high because each cycle drives the worker loop round once and the worker
// loop's back edge is where this program's safepoints are — a low count would
// leave the `BIT_GC=stress` run with too few collections to be an oracle.
const rounds: int = 4000

let schedBlock: [16]i64
let workerBlocks: [292]i64
// One 64KiB stack inside a 128KiB region, so a 64KiB-aligned base exists
// whatever address the linker gives the array.
let stackArea: [16384]i64
let racerTask: [32]i64

// Observations. Untraced module state (§11.11): written from a green thread,
// read by the driver, and never walked by the collector.
let obsRounds: i64 = 0
let obsEntries: i64 = 0
let obsArmFailed: i64 = 0
let obsWakeUndelivered: i64 = 0
let obsDisarmClean: i64 = 0
let obsDisarmOwed: i64 = 0
let addrSched: i64 = 0

// The idle-pass budget before the program gives up and declares the wake lost.
//
// A DROPPED WAKE MUST FAIL, NOT HANG. `schedWorkerRun`'s own trip bound is a
// billion steps and would wedge the suite for hours reporting a timeout rather
// than a verdict. This guard rides the CLOCK hook while the thing under test is
// the park protocol, so deleting the protocol cannot delete the guard — the
// mistake ../schedtimer's first draft made, where the give-up shared a code path
// with the property it bounded and the program hung instead of failing.
const idleGiveUp: int = 200000
let idlePasses: i64 = 0

fn guardClock(): int {
  idlePasses = idlePasses + 1
  if (int(idlePasses) > idleGiveUp) {
    schedShutdown(taskAt(addrSched))
  }
  return int(idlePasses)
}

fn schedAddr(): int {
  return int(ptrOf(schedBlock))
}

// The racer. `@nosplit` because a green task here runs on a stack this program
// laid out by hand, which the collector reaches conservatively rather than
// through a published safepoint frame — the same reason every task body in this
// suite carries it.
//
// Each round: arm, hand a wake to ourselves from inside the window, then park.
// With the protocol the worker finds `taskWakePending` and delivers the owed
// wake by requeueing, so `schedPark` returns and the loop advances. Without it
// the wake is dropped, the task parks forever, and `obsRounds` stops at 0.
@nosplit fn racerBody() {
  obsEntries = obsEntries + 1
  let self = schedCurrentTask()
  let s = taskAt(addrSched)

  // Property: a clean arm/disarm pair leaves the task running and reports that
  // no wake was owed. Run BEFORE the loop so a broken disarm cannot be mistaken
  // for a broken park.
  if (schedParkArm()) {
    if (!schedParkDisarm()) {
      obsDisarmClean = 1
    }
  }

  // Property: an arm whose registration then fails, with a wake already handed
  // over, reports the owed wake so the caller knows to keep running. This is the
  // path `netAwaitReady` takes when `pollRegister` fails, and without its own
  // property `schedParkDisarm` would ship having never been called.
  if (schedParkArm()) {
    let handed = schedPollUnpark(s, self)
    if (handed && schedParkDisarm()) {
      obsDisarmOwed = 1
    }
  }

  let i = 0
  while (i < rounds) {
    if (!schedParkArm()) {
      obsArmFailed = obsArmFailed + 1
      i = rounds
    } else {
      // The whole point: this is what a draining worker on another core does,
      // and it happens here strictly inside the arm/park window.
      if (!schedPollUnpark(s, self)) {
        obsWakeUndelivered = obsWakeUndelivered + 1
      }
      schedPark()
      obsRounds = obsRounds + 1
      i = i + 1
    }
  }

  schedShutdown(s)
  schedTaskExit()
}

fn main() {
  let s = taskAt(schedAddr())
  schedInit(s, int(ptrOf(workerBlocks)), parkWorkers)
  addrSched = schedAddr()

  let base = int(ptrOf(stackArea))
  let bumped = base + schedStackBytes - 1
  let stackBase = bumped - bumped % schedStackBytes
  let aligned = schedStackAligned(stackBase)

  let taskAddr = int(ptrOf(racerTask))
  schedTaskInit(taskAt(taskAddr), stackBase, schedStackBytes, entryOf(racerBody), 0)
  schedRegister(s, taskAddr)
  schedSpawn(s, taskAddr)

  schedWorkerRun(schedWorkerAt(s, 0), guardClock, schedNoPoller)

  // Every count is asserted exactly. "It did not hang" is not a result here: a
  // protocol that delivered SOME wakes and dropped others would still terminate,
  // and only an exact round count can tell those apart.
  let delivered = int(obsRounds) == rounds
  let armed = int(obsArmFailed) == 0 && int(obsWakeUndelivered) == 0
  // Entered exactly once. A wake consumed by `schedParkDisarm` that was instead
  // requeued would put an already-running task on a run queue, and the worker
  // would re-enter this body — which is what this counter is for.
  let once = int(obsEntries) == 1
  let disarm = int(obsDisarmClean) == 1 && int(obsDisarmOwed) == 1

  println("park ${aligned} ${once}")
  println("rounds ${delivered} ${armed}")
  println("disarm ${disarm}")
}
