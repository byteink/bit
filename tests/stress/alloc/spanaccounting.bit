// Properties (j) #2374 and (k) #2375. Sibling of `./alloc.bit`, same module
// (SPEC §17.1) — everything `./alloc.bit` imports (heap*, alloc*, spin*, ...)
// and everything it declares at module scope (`spanTake`, `OCC_CLASS`,
// `OCC_SPANS`, `REC_SPANS`) is visible here with no import, the same
// arrangement `./spancache.bit` and `./classify.bit` use. Split out to keep
// `alloc.bit` under `tests/bit/lintfilelines.bit`'s 800-line gate (E0200) —
// see `bitlang-ws/CLAUDE.md`'s "Splitting a file" section: this seam declares
// nothing an earlier-sorting sibling could forward-reference, so there is no
// ordering question, only a diagnostic-order one the differentials would
// catch. `occRun` and `recRun` each recompute their own `perSpan`/`occCs` —
// both pure calls to `allocSpanSlots`/`allocClassSize` — rather than share
// state with the other, so the two properties are independently callable.
//
//   (j) PER-SPAN OCCUPANCY — the property #2374 exists to establish. Every slot
//       of one size class is taken across THREE spans, then freed in a
//       scrambled order, and after every single free each span's own free count
//       must equal a tally this file computes from the slot addresses alone.
//       The independence is the point: `allocSpanOf` is a mask over the
//       address, so a take or give that credited the wrong span leaves every
//       aggregate over the class exactly right — `liveBytes`, the class total,
//       even `sum over spans of (total - free)` — and only a per-span
//       comparison sees it. Mutation-tested: masking one bit too few in
//       `heapGiveSmallLocked` fails this and nothing else in the corpus.
//       The scrambled order is a Fisher-Yates shuffle rather than a stride, so
//       it stays a permutation if the slots-per-span count ever moves; a stride
//       that stopped being coprime would free an address twice.
//
//   (k) SPAN RECLAMATION — the property #2375 exists to establish, and the one
//       that turns 0% returned into 99%. Four spans of one class are filled,
//       every slot is freed, and the class must then hand back all but the
//       anchor: the chain the pass returns is checked span by span, and the
//       retained anchor must still serve exactly its own slot count and no
//       address outside itself. That last half is the one that matters — a pass
//       that unlinks the SPANS but leaves their slots on the class's free list
//       hands out an address inside memory the caller has already unmapped, and
//       every aggregate counter still balances.

// Property (j): every slot of `OCC_CLASS` taken across `OCC_SPANS` spans, then
// freed in a scrambled order, checking each span's own free count after every
// single free. A third private heap, so the class owns exactly the spans below
// and the tally has no other traffic to account for. Returns `(occOk, occN)`.
fn occRun(a: []i64): (int, int) {
  let h3buf = []i64(heapWords)
  let h3 = ptrOf(h3buf)
  let l3buf = []i32(1)
  let lk3 = ptrOf(l3buf)
  atomicStore(lk3, spinUnlocked)
  heapInit(h3)

  let occOk = 1
  let occCs = allocClassSize(OCC_CLASS)
  let perSpan = allocSpanSlots(OCC_CLASS)
  let occN = OCC_SPANS * perSpan
  let occSpan = []i64(OCC_SPANS)
  let occFreed = []i64(OCC_SPANS)
  let occAddr = []i64(occN)
  let occOwner = []i64(occN)

  // Three spans up front. Each must report the class it was carved for, the
  // slot count the class expects, and no slot handed out yet.
  let oi = 0
  while (oi < OCC_SPANS) {                              // bounded: OCC_SPANS
    let sp = spanTake(a)
    occFreed[oi] = 0
    if (sp == 0) {
      occOk = 0                                         // arena exhausted
    } else {
      occSpan[oi] = sp
      spinAcquire(lk3)
      heapRefillLocked(h3, OCC_CLASS, sp, false)
      spinRelease(lk3)
      if (allocSpanOf(sp) != sp) { occOk = 0 }          // spans are self-aligned
      if (allocSpanClass(sp) != OCC_CLASS) { occOk = 0 }
      if (allocSpanTotal(sp) != perSpan) { occOk = 0 }
      if (allocSpanFree(sp) != perSpan) { occOk = 0 }
    }
    oi = oi + 1
  }

  // Take every slot the three spans hold. Each address must belong to one of
  // them, by the mask alone.
  let ti = 0
  while (ti < occN) {                                   // bounded: occN
    spinAcquire(lk3)
    let addr = heapTakeSmallLocked(h3, OCC_CLASS, occCs)
    spinRelease(lk3)
    occAddr[ti] = addr
    occOwner[ti] = 0
    if (addr == 0) {
      occOk = 0
    } else {
      let owner = -1
      let oj = 0
      while (oj < OCC_SPANS) {                          // bounded: OCC_SPANS
        if (allocSpanOf(addr) == occSpan[oj]) { owner = oj }
        oj = oj + 1
      }
      if (owner < 0) { occOk = 0 } else { occOwner[ti] = owner }
    }
    ti = ti + 1
  }

  // Fully occupied: every span reads zero free, and one more take must FAIL
  // rather than re-serve a live slot.
  let oc = 0
  while (oc < OCC_SPANS) {                              // bounded: OCC_SPANS
    if (allocSpanFree(occSpan[oc]) != 0) { occOk = 0 }
    oc = oc + 1
  }
  spinAcquire(lk3)
  let occExtra = heapTakeSmallLocked(h3, OCC_CLASS, occCs)
  spinRelease(lk3)
  if (occExtra != 0) { occOk = 0 }

  // A deterministic Fisher-Yates over the slot indices. A permutation by
  // construction, so no address can be freed twice if `perSpan` ever moves.
  let occOrder = []i64(occN)
  let po = 0
  while (po < occN) { occOrder[po] = po; po = po + 1 }  // bounded: occN
  let seed = 12345
  let sw = occN - 1
  while (sw > 0) {                                      // bounded: occN - 1
    seed = (seed * 1103515245 + 12345) % 2147483648
    let pick = seed % (sw + 1)
    let tmp = occOrder[sw]
    occOrder[sw] = occOrder[pick]
    occOrder[pick] = tmp
    sw = sw - 1
  }

  // The property: after EVERY free, each span's own free count equals the tally
  // kept here from the addresses alone.
  let fi = 0
  while (fi < occN) {                                   // bounded: occN
    let k = occOrder[fi]
    spinAcquire(lk3)
    let occWant = heapGiveSmallLocked(h3, occAddr[k], OCC_CLASS, occCs)
    spinRelease(lk3)
    let own = occOwner[k]
    occFreed[own] = occFreed[own] + 1
    let cj = 0
    while (cj < OCC_SPANS) {                            // bounded: OCC_SPANS
      if (allocSpanFree(occSpan[cj]) != occFreed[cj]) { occOk = 0 }
      cj = cj + 1
    }
    fi = fi + 1
  }

  // Everything back: each span wholly free, no live bytes, and the runtime's own
  // cross-check of `sum over spans of (total - free)` against the class's live
  // slot count agrees.
  let oe = 0
  while (oe < OCC_SPANS) {                              // bounded: OCC_SPANS
    if (occFreed[oe] != perSpan) { occOk = 0 }
    if (allocSpanFree(occSpan[oe]) != perSpan) { occOk = 0 }
    oe = oe + 1
  }
  if (heapLiveBytes(h3) != 0) { occOk = 0 }
  spinAcquire(lk3)
  let occBad = heapCheckSpansLocked(h3)
  spinRelease(lk3)
  if (occBad != 0) { occOk = 0 }
  if (heapSpanViolations(h3) != 0) { occOk = 0 }

  return occOk, occN
}

// Property (k): a class that has filled several spans and then had every slot
// freed gives all but one of them BACK, and the one it keeps still serves
// every allocation the class asks for.
//
// A FOURTH PRIVATE HEAP, AND THE ONLY PLACE THIS PROPERTY SAYS `owned` IS
// TRUE. The arena is a Bit-managed `[]i64`, so unmapping any of it would punch
// a hole in the live heap — and this test does not unmap. It does not have to:
// the allocator's contract is that IT unlinks and the CALLER releases, so a
// caller that declines to release still exercises every line of the
// bookkeeping. That split is what makes the property testable at all on a
// platform-free allocator. Returns `(recOk, recGot)`.
fn recRun(a: []i64): (int, int) {
  let occCs = allocClassSize(OCC_CLASS)
  let perSpan = allocSpanSlots(OCC_CLASS)

  let h4buf = []i64(heapWords)
  let h4 = ptrOf(h4buf)
  let l4buf = []i32(1)
  let lk4 = ptrOf(l4buf)
  atomicStore(lk4, spinUnlocked)
  heapInit(h4)

  let recOk = 1
  let recSpan = []i64(REC_SPANS)
  let recN = REC_SPANS * perSpan
  let recAddr = []i64(recN)
  let rs = 0
  while (rs < REC_SPANS) {                              // bounded: REC_SPANS
    let sp = spanTake(a)
    if (sp == 0) {
      recOk = 0                                         // arena exhausted
      recSpan[rs] = 0
    } else {
      recSpan[rs] = sp
      spinAcquire(lk4)
      heapRefillLocked(h4, OCC_CLASS, sp, true)
      spinRelease(lk4)
    }
    rs = rs + 1
  }
  // The most recent refill is the anchor, and the anchor is what must survive.
  let recAnchor = recSpan[REC_SPANS - 1]
  if (heapClassSpans(h4, OCC_CLASS) != REC_SPANS) { recOk = 0 }
  if (heapClassEmpty(h4, OCC_CLASS) != REC_SPANS) { recOk = 0 }

  // Fill every span, which must take the releasable count to zero: a span with
  // one slot handed out is not reclaimable, and that is the counter that decides.
  let rt = 0
  while (rt < recN) {                                   // bounded: recN
    spinAcquire(lk4)
    let addr = heapTakeSmallLocked(h4, OCC_CLASS, occCs)
    spinRelease(lk4)
    recAddr[rt] = addr
    if (addr == 0) { recOk = 0 }
    rt = rt + 1
  }
  if (heapClassEmpty(h4, OCC_CLASS) != 0) { recOk = 0 }

  // Give it all back. The allocator must ASK for a pass at least once — a fix
  // whose trigger never fires returns exactly as much memory as no fix at all.
  let asked = 0
  let rg = 0
  while (rg < recN) {                                   // bounded: recN
    spinAcquire(lk4)
    let want = heapGiveSmallLocked(h4, recAddr[rg], OCC_CLASS, occCs)
    spinRelease(lk4)
    asked = asked + want
    rg = rg + 1
  }
  if (asked == 0) { recOk = 0 }
  if (heapClassEmpty(h4, OCC_CLASS) != REC_SPANS) { recOk = 0 }

  // The pass. Every span on the chain must be releasable and must NOT be the
  // anchor, and the class must be left holding exactly the anchor.
  spinAcquire(lk4)
  let recChain = heapReclaimSpansLocked(h4, OCC_CLASS)
  spinRelease(lk4)
  let recGot = 0
  let rc = recChain
  while (rc != 0 && recGot <= REC_SPANS) {              // bounded: REC_SPANS + 1
    if (rc == recAnchor) { recOk = 0 }
    if (allocSpanOwned(rc) == 0) { recOk = 0 }
    if (allocSpanFree(rc) != perSpan) { recOk = 0 }
    recGot = recGot + 1
    rc = allocSpanNext(rc)
  }
  if (recGot != REC_SPANS - 1) { recOk = 0 }
  if (heapClassSpans(h4, OCC_CLASS) != 1) { recOk = 0 }
  if (heapClassEmpty(h4, OCC_CLASS) != 1) { recOk = 0 }
  if (heapLiveBytes(h4) != 0) { recOk = 0 }
  spinAcquire(lk4)
  let recBad = heapCheckSpansLocked(h4)
  spinRelease(lk4)
  if (recBad != 0) { recOk = 0 }
  if (heapSpanViolations(h4) != 0) { recOk = 0 }

  // THE HALF THAT CATCHES A HALF-DONE UNLINK, and the reason the pass has two
  // phases at all: the reclaimed spans' slots must be off the class's FREE list
  // too. Leave one behind and the class serves an address inside memory its
  // caller has already unmapped — a use-after-free that no aggregate counter can
  // see. So the retained anchor must serve exactly `perSpan` slots, every one
  // inside itself, and then report empty.
  let recServed = 0
  let recDone = 0
  let recGuard = 0
  while (recDone == 0 && recGuard <= perSpan) {         // bounded: perSpan + 1
    spinAcquire(lk4)
    let s5 = heapTakeSmallLocked(h4, OCC_CLASS, occCs)
    spinRelease(lk4)
    if (s5 == 0) {
      recDone = 1
    } else {
      if (allocSpanOf(s5) != recAnchor) { recOk = 0 }
      recServed = recServed + 1
    }
    recGuard = recGuard + 1
  }
  if (recDone == 0) { recOk = 0 }
  if (recServed != perSpan) { recOk = 0 }
  if (allocSpanKeep < 2) { recOk = 0 }                  // see `allocSpanKeep`

  return recOk, recGot
}
