// Property (m), #3100's `allocClassify` fast path. Sibling of `./alloc.bit`,
// same module (SPEC §17.1) — everything `./alloc.bit` imports (`allocClassify`,
// `allocClassSize`, `allocAlignUp`, `allocNumClasses`, `allocMaxSmall`) is
// visible here with no import, the same arrangement `./spancache.bit` uses.
//
// WHY THIS IS NOT PROPERTY (c). (c) checks `allocClassify` against its
// SPECIFICATION — "the smallest class that both fits and divides" — over a
// matrix of sampled sizes (`sz = sz * 3 + 1`) and ten alignments. That is the
// right check for the contract and the wrong one for #3100, which replaced a
// linear scan with a closed-form shortcut for classes 0-3. A shortcut that is
// wrong for ONE size in 16384 would slip through a sample and would not slip
// through here: this property runs the ORIGINAL scan, kept verbatim below, and
// the shipped function over EVERY (size, alignment) pair in the domain, and
// requires them to agree on every single one.
//
// The check is possible at all because `allocClassify` is a pure function of
// two ints — no heap, no lock, no state to set up — which is why #3100 moved it
// and the rest of that pure half into `runtime/alloc/classify.bit`.
//
// WHAT A DISAGREEMENT WOULD MEAN, so the cost of a red here is not
// underestimated: `allocClassify` decides which size class an object lands in,
// on every allocation AND every free. Answer a smaller class on free than on
// alloc and a slot goes back onto the wrong free list, which is silent heap
// corruption discovered much later somewhere else. This property is the reason
// the shortcut is allowed to exist.
//
// THE DOMAIN, and why it is drawn this way:
//   - alignment 1..CLS_MAX_ALIGN, EVERY value and not just the powers of two.
//     3, 5, 6 and 7 are the load-bearing ones and they are the reason the
//     shipped guard tests for a power of two rather than just `alignment <= 8`:
//     8 % 6 != 0 while 48 % 6 == 0, so the scan answers class 3 for a 48-byte
//     request at alignment 6 where a bare `<= 8` shortcut answers class 0.
//     No caller passes a non-power-of-two alignment and `allocAlignUp` is a
//     power-of-two mask, so those answers are nonsense either way — but the
//     two halves must produce the SAME nonsense, or the change is a behaviour
//     change wearing an optimization's clothes.
//   - alignment 0 IS EXCLUDED, and by necessity rather than convenience: the
//     scan evaluates `cs % alignment`, which traps on zero. It traps today and
//     it must keep trapping, which is what the shipped guard's `alignment > 0`
//     is for; a property cannot observe a trap without dying with it.
//   - every power-of-two alignment from CLS_MAX_ALIGN*2 up to `allocMaxSmall`,
//     so the whole range where the fast path must NEVER fire is covered too.
//   - size 0..CLS_MAX_SIZE, which runs 64 bytes past `allocMaxSmall` so the
//     direct-mapped (-1) answers on the far side of the boundary are included.
//
// `fired` in the output is the denominator that makes this non-vacuous: the
// number of pairs on which the fast path actually produced the answer. A
// refactor that accidentally made the guard unreachable would leave `clsfast=1`
// green with `fired=0`, so the count is printed, not merely computed.
const CLS_MAX_ALIGN = 64
const CLS_MAX_SIZE = 16448              // allocMaxSmall + 64

// `allocClassify`'s body as it stood before #3100, verbatim, as the oracle.
// It must not be "kept in sync" with the shipped one — the entire value of
// this property is that it is an INDEPENDENT copy of the behaviour being
// preserved. If a future change to the size classes makes this diverge, that
// is the property doing its job, not a stale duplicate.
fn classifyScan(size: int, alignment: int): int {
  let needed = allocAlignUp(size, alignment)
  if (needed > allocMaxSmall) { return -1 }
  let i = 0
  while (i < allocNumClasses) {         // bounded: <= allocNumClasses iterations
    let cs = allocClassSize(i)
    if (cs >= needed && cs % alignment == 0) { return i }
    i = i + 1
  }
  return -1
}

// Accumulator slots, so one sweep can report three numbers.
const C_PAIRS = 0
const C_OK = 1
const C_FIRED = 2

// Every size in range at one alignment.
fn classifySweep(alignment: int, counts: []i64) {
  let sz = 0
  while (sz <= CLS_MAX_SIZE) {          // bounded: CLS_MAX_SIZE + 1 iterations
    let got = allocClassify(sz, alignment)
    let want = classifyScan(sz, alignment)
    counts[C_PAIRS] = counts[C_PAIRS] + 1
    if (got == want) { counts[C_OK] = counts[C_OK] + 1 }
    // The shipped guard, restated, so `fired` counts the pairs the shortcut
    // actually answered rather than the pairs it was merely offered.
    if (alignment > 0 && alignment <= 8 && (alignment & (alignment - 1)) == 0) {
      if (allocAlignUp(sz, alignment) <= 48) {
        counts[C_FIRED] = counts[C_FIRED] + 1
      }
    }
    sz = sz + 1
  }
}

fn classifyRun() {
  let counts = []i64(3)

  let a = 1                             // 0 excluded: `cs % 0` traps
  while (a <= CLS_MAX_ALIGN) {          // bounded: CLS_MAX_ALIGN iterations
    classifySweep(a, counts)
    a = a + 1
  }

  let p = CLS_MAX_ALIGN * 2
  while (p <= allocMaxSmall) {          // bounded: log2(allocMaxSmall) iterations
    classifySweep(p, counts)
    p = p * 2
  }

  let ok = 0
  if (counts[C_PAIRS] > 0 && counts[C_OK] == counts[C_PAIRS]) { ok = 1 }
  if (counts[C_FIRED] == 0) { ok = 0 }  // vacuous sweep is a failure, not a pass
  print("clsfast=${ok}/${counts[C_PAIRS]} fired=${counts[C_FIRED]}\n")
}
