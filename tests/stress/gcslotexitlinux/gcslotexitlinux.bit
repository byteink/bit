// A raw OS thread's mutator slot is released by the Linux thread provider's side
// of the contract, not by the thread's body (#1801).
//
// Linux-only by construction, hence the sibling `linux-only` marker: the provider
// issues raw `syscall`s (SPEC §11.8), which the compiler rejects when targeting
// Darwin, even for an uncalled declaration.
//
// The properties, and the argument for why each one discriminates — including
// why the real oracle is the sibling `no-abandon` marker rather than this
// program's output — live in ./../thread/exitprops. This file supplies only the
// platform binding. It is kept identical in shape to its Darwin twin, so a future
// divergence between the two means a real platform difference rather than a
// spelling one.
import { slotExitRun, slotExitTotal } from "../thread/exitprops"
import { threadStart, threadRelease } from "../../../runtime/thread/linux"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/linux"

function main() {
  let got = slotExitRun(threadStart, threadRelease, parkSleepNs, parkMonoNs)
  let total = slotExitTotal()
  print("${got == total} ${got}\n")
}
