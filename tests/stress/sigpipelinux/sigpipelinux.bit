// Linux mirror of ../sigpipedarwin: proof that `runtime/root/linux`'s
// `ignoreSigpipe` (#1615) changes the process's SIGPIPE disposition. Install
// SIG_IGN, then WRITE to a pipe whose read end has been closed. With the
// disposition changed the write returns -EPIPE and the process lives to print;
// with the default disposition the write raises SIGPIPE and the kernel kills the
// process before any output — which the stress harness reads as red. A wrong
// signal number or SIG_DFL reddens this test rather than passing it silently.
//
// Linux-only: `pipe2`/`close`/`write` are raw `syscall`s (§11.8), the number
// selected per-arch by `hostTarget()` exactly as ../syscall does. The Darwin
// mirror ../sigpipedarwin uses libSystem `extern`s. Straight-line and about
// signal disposition, not rooting, so it carries a `no-collect` marker.
//
// THE RETURN OF A BROKEN-PIPE `write` IS -EPIPE (-32) HERE, not the -1 the Darwin
// mirror sees: a raw Linux syscall returns the NEGATIVE errno itself, where
// libSystem returns -1 and stashes the errno. EPIPE = 32 (std.os.linux `E`).

import { ignoreSigpipe } from "../../../runtime/root/linux"
import { loadWord } from "../../../runtime/gc"

// Per-arch syscall selector. `hostTarget()` is 0 for x86_64-linux, 1 for
// aarch64-linux; this program is linux-only, so the two cases are exhaustive.
function nr(x64: int, arm64: int): int {
  if (hostTarget() == 0) {
    return x64
  }
  return arm64
}

// pipe2(fds, 0) — aarch64 has no legacy `pipe`, only `pipe2` (59); x86_64 has
// both and `pipe2` (293) matches. close (3 / 57), write (1 / 64). All read out of
// std.os.linux/syscalls.zig, not memory.
function nrPipe2(): int { return nr(293, 59) }
function nrClose(): int { return nr(3, 57) }
function nrWrite(): int { return nr(1, 64) }

// Low-32 / high-32 split of the packed `{read, write}` fd word `pipe2` writes.
const fdMask: int = 4294967295
const fdShift: int = 4294967296

function main() {
  let rc = ignoreSigpipe()

  // A pipe, then close its read end so the write end has no reader. Both fds
  // land packed into one 8-byte cell: read in the low 32 bits, write in the high.
  let fdcell = []i64(1)
  let pr = int(syscall(nrPipe2(), i64(ptrOf(fdcell)), i64(0)))
  if (pr != 0) {
    print("pipe failed pr=${pr}\n")
    return
  }
  let packed = loadWord(int(ptrOf(fdcell)))
  let readFd = packed & fdMask
  let writeFd = (packed / fdShift) & fdMask
  syscall(nrClose(), i64(readFd))

  // The write that would raise SIGPIPE. Reaching the line below proves the signal
  // was ignored; `wrote` proves the kernel reported EPIPE (-32).
  let msg = []int(1)
  msg[0] = 65
  let wrote = int(syscall(nrWrite(), i64(writeFd), i64(ptrOf(msg)), i64(1)))

  print("sig=${rc} pipe=${pr} wrote=${wrote}\n")
}
