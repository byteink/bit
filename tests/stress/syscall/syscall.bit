// Raw `syscall` (§11.8) — the Stage-2 unmanaged-subset primitive that lets the
// runtime talk to the kernel without a C library. Linux only: Darwin publishes
// no stable syscall numbers, so this directory carries a `linux-only` marker
// and the stress harness skips it on any other host.
//
// The backends emit the kernel trap inline (`syscall` = 0F 05 on x86-64,
// `svc #0` = 0xD4000001 on AArch64) rather than a relocated call to a runtime
// symbol, so this is the one builtin with its own IR op. Argument marshalling
// is the kernel ABI, NOT the C ABI: on x86-64 the fourth argument travels in
// `r10`, because the `syscall` instruction overwrites `rcx` with the return
// address. That single register is the likeliest thing to get wrong, which is
// why the 6-argument `mmap` below is the centrepiece — it is the only form
// that puts a value in `r10` at all.
//
// Syscall numbers are per-architecture, and Bit has no arch-conditional
// compilation, so `hostTarget()` selects between them at run time (0 =
// x86_64-linux, 1 = aarch64-linux). Every number here was read out of the
// pinned Zig stdlib's `std.os.linux.SYS` tables, not from memory.

// The syscall number for the running architecture.
function nr(x64: int, arm64: int): int {
  if (hostTarget() == 0) {
    return x64
  }
  return arm64
}

function sysWrite(): int { return nr(1, 64) }
function sysMmap(): int { return nr(9, 222) }
function sysMunmap(): int { return nr(11, 215) }
function sysGetpid(): int { return nr(39, 172) }
function sysClockGettime(): int { return nr(228, 113) }

function main() {
  // (a) `write(1, buf, 6)` — three arguments, and the one call whose effect is
  // visible in stdout. Emitted before any `print` so the ordering between the
  // raw trap and the runtime's own buffered output is fixed.
  //
  // The kernel wants six PACKED bytes, but a Bit slice stores one 8-byte word
  // per element — `ptrOf([]u8)` addresses words, not bytes — so the six ASCII
  // codes are packed little-endian into a single `int` cell instead. Writing
  // the six low bytes of that one word yields "sysca\n".
  let msg = []int(1)
  msg[0] = 11413396617587 // 's' | 'y'<<8 | 's'<<16 | 'c'<<24 | 'a'<<32 | '\n'<<40
  let wrote = syscall(sysWrite(), 1, i64(ptrOf(msg)), 6)

  // (b) `getpid()` — the degenerate zero-argument form: nothing but the number
  // register and the return register are involved.
  let pid = syscall(sysGetpid())

  // (c) `mmap(null, 4096, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)`
  // — all six argument registers, including the `r10` slot that separates the
  // kernel ABI from the C one. A failure returns a small negative errno, so a
  // large positive result is proof the flags argument arrived intact: passing
  // `flags` in `rcx` instead yields EINVAL (-22) on x86-64.
  let page = syscall(sysMmap(), 0, 4096, 3, 34, 0 - 1, 0)
  let mapped = page > 0

  // The mapping is writable memory the GC knows nothing about — touch it to
  // prove the kernel really honoured PROT_WRITE, then hand it back.
  let unmapped = 0 - 1
  if (mapped) {
    let cell = page
    unmapped = syscall(sysMunmap(), cell, 4096)
  }

  // (d) `clock_gettime(CLOCK_MONOTONIC, &ts)` into a two-word buffer — a
  // pointer argument the kernel WRITES to, unlike (a)'s read-only buffer.
  let ts = []u8(16)
  let clockRc = syscall(sysClockGettime(), 1, i64(ptrOf(ts)))

  // (e) The register-allocator drive, mirroring the `asm` stress case: a loop
  // whose accumulator must survive across a back edge while every kernel-ABI
  // register stays excluded from the allocatable file. `getpid` is constant for
  // the life of the process, so the total is exactly `pid * 4` — a pinning bug
  // (a vreg parked in a register the trap overwrites) shows up as a wrong total
  // rather than as a crash.
  let acc = 0
  let i = 0
  while (i < 4) {
    acc = acc + syscall(sysGetpid())
    i = i + 1
  }
  let loopOk = acc == pid * 4

  print("wrote=${wrote} pid=${pid > 0} mapped=${mapped} unmapped=${unmapped} clock=${clockRc} loop=${loopOk}\n")
}
