// Concurrent collection: two OS threads running ORDINARY, non-`@nosplit`,
// allocating Bit code, under `BIT_GC=stress` (#1431).
//
// WHY THIS PROGRAM EXISTS. Every other multi-threaded stress program in this
// suite runs `@nosplit` children. `@nosplit` code contains no safepoints, and
// codegen emits `bit_rt_safepoint` at loop back-edges and nowhere else, so those
// programs collect **zero** times however much they allocate — cf. #1409: the
// stress oracle is only as dense as the safepoints. The one configuration that
// exercises real concurrent collection had therefore never been run, and it was
// broken: two independent defects, both silently sweeping live objects.
//
// It is also the gating test the stop-the-world handshake never had (#1432). A
// mutation against `@nosplit`-only tests is vacuous — removing the rendezvous
// leaves them all green — so the handshake was measured to engage but nothing
// failed when it did not. This program fails when it does not.
//
// WHAT MAKES IT DISCRIMINATING, rather than "it printed a number":
//
//   - Each child holds `keep`, a `[]i64(16)`, live across every collection and
//     verifies it ELEMENT BY ELEMENT against its own seed. A lost root is
//     therefore caught as a wrong value, not as a plausible one — and the seeds
//     differ per child, so a cross-thread mix-up is caught too.
//   - Each child allocates garbage in a loop, so it reaches a safepoint on every
//     back edge and under stress collects on every one of them.
//   - BOTH children are started before either is joined, so the two genuinely
//     overlap. `NT = 1` reproduced the original defects on its own, but only two
//     live mutators exercise the rendezvous in both directions.
//   - The PARENT is a mutator too, and a first-class one: it joins through
//     `threadJoin`, which loops and holds the two provider FUNCTION VALUES
//     across every collection. That is not incidental — a recycled function
//     value jumping to a null code address is exactly how the second defect
//     surfaced, and a join hand-rolled without function values does not catch it.
//   - The parent's own `[]i64` survives the join and is re-verified, so a
//     collection that loses the PARENT's roots fails here rather than silently.
//
// THE COLLECTION COUNT IS NOT SELF-REPORTED. A Bit program cannot read the
// collector's counters, so "it collected" is confirmed out of band with
// `BIT_GC_STATS=1` (~435 collections per run on the reference machine, 0
// abandoned). What this program guarantees on its own is that if a collection
// does happen, losing a root fails it.

import { i32At, i64At, byteAt, elemAddr } from "../props"
import { threadJoin, threadJoinDone } from "../../../../runtime/thread"

// All properties passed: G1|G2|G3|G4|G5 = 1|2|4|8|16. A bitmask, not a count, so
// a failure names the property that broke — and the three conditions a naive
// version would lump together (started / joined / verified) are kept separate,
// because "a child lost a root" and "a join ran out of clock" are completely
// different findings and only the first is a correctness failure.
export fn gcThreadsTotal(): int { return 31 }

// Two children. Small and fixed: the point is that more than one mutator is live
// and allocating at once, which two demonstrates as well as twenty while keeping
// the program's cost flat enough to run twice per suite.
const NT: int = 2

// Elements of the live array each child (and the parent) holds across
// collections. Sixteen is enough that a partial or shifted overwrite is caught
// by the element-by-element check rather than landing on the right value.
const KEEP_N: int = 16

// Garbage-allocating iterations per child. Each one allocates, so each one is a
// safepoint, so under `BIT_GC=stress` each one is a collection ATTEMPT.
//
// SIZED BY WALL CLOCK, NOT BY AMBITION. The discriminating power here is "a
// collection ran while a live array was held", which dozens of collections
// demonstrate as well as hundreds. The cost is not the collections, it is the
// ABANDONED ones: the parent spends the join inside `sleepFn`, which does not
// use the `blocked` contract, so it reads as `running` and each collection a
// child attempts meanwhile spins to `stw_spin_bound` before giving up. Sixty-four
// keeps the whole run to a couple of seconds on the slowest target with the same
// number of *live* mutators and the same oracle. (Sizing `stw_spin_bound` itself
// is what made that affordable on x86-64 — see its comment in runtime/gc/gcworld.bit.)
const CHURN_N: int = 64

// Join deadline, and THE ONLY WALL-CLOCK DEPENDENCE IN THIS PROGRAM (G2).
//
// Under `BIT_GC=stress` a child's real cost is not its own arithmetic — that is
// microseconds — it is the abandoned collections it attempts while the parent
// sleeps (see `CHURN_N`). Whole-run wall clock is ~2.5s on a 6-core x86_64 box
// and under a second on arm64, so ten seconds is several times the measured
// worst case rather than a number picked to make a red test green. G2 is split
// out from G3 precisely so that if it ever does prove tight on some machine, it
// fails as "the clock ran out" and not as "a root was lost".
const JOIN_NS: int = 10000000000        // 10s

// The body both children run.
//
// **IT IS DELIBERATELY NOT `@nosplit`, AND THAT IS THE WHOLE PROPERTY.** Every
// other child body in this suite carries the attribute precisely to keep the
// collector out; this one must reach safepoints, from a raw OS thread, while
// another mutator collects.
//
// Its argument is a two-word region holding the ADDRESSES of the two words it
// owns — its done word and its result cell — matching `../props`.
//
// THE STORE ORDER IS THE CONTRACT: the result is published BEFORE the done word
// is cleared, so a parent that observes done == 0 also observes the result.
fn gcChild(arg: *byte): *byte {
  let base = int(arg)
  let done = i32At(int(*i64At(base)))
  let cell = i32At(int(*i64At(elemAddr(base, 1))))
  let seed = int(atomicLoad(cell))

  // Live across every collection below. Seeded from this child's own seed so the
  // two children's arrays are distinguishable.
  let keep = []i64(KEEP_N)
  let k = 0
  while (k < KEEP_N) {
    keep[k] = i64(seed + k)
    k = k + 1
  }

  let bad = 0

  // Garbage. `tmp` is dead at the back edge, so sweeping it is CORRECT — the
  // point is the safepoint the back edge carries, and that `keep` survives it.
  let i = 0
  while (i < CHURN_N) {
    let tmp = []i64(8)
    tmp[0] = i64(i)
    tmp[7] = i64(i)
    if (int(tmp[0]) != int(tmp[7])) { bad = bad + 1 }
    i = i + 1
  }

  // The oracle: every element, against the seed, after ~400 collections.
  let v = 0
  while (v < KEEP_N) {
    if (int(keep[v]) != seed + v) { bad = bad + 1 }
    v = v + 1
  }

  atomicStore(cell, i32(bad))
  atomicStore(done, i32(0))
  return nil
}

// `entryOf` (§11.10) needs its operand to name a function declaration directly,
// so the address is taken here, where that function is declared.
export fn gcChildEntry(): *byte {
  return entryOf(gcChild)
}

// Run the whole set against one platform's thread provider.
//
// The provider arrives as function VALUES rather than imports, which is what
// lets one copy of these checks run on either platform — the same shape
// `../../thread/props` uses.
export fn gcThreadsRun(startFn: (*byte, *byte, *i32) => int,
                             releaseFn: (int) => bool,
                             sleepFn: (int) => (),
                             monoFn: () => int): int {
  let mask = 0

  // Every atomic word the children touch lives in one of these slices, so one
  // live local per slice keeps all of them reachable. Holding only raw addresses
  // would not: a raw pointer is untraced (§11.4), so the collector could reclaim
  // a word a running child still writes to.
  let dones = []i32(NT)
  let cells = []i32(NT)
  let regions = []i64(2 * NT)

  let donesBase = int(ptrOf(dones))
  let cellsBase = int(ptrOf(cells))
  let regionsBase = int(ptrOf(regions))

  // The parent's own live array, held across every collection the children
  // trigger and re-verified after the join.
  let keep = []i64(KEEP_N)
  let s = 0
  while (s < KEEP_N) {
    keep[s] = i64(1000 + s)
    s = s + 1
  }

  let t = 0
  while (t < NT) {
    dones[t] = i32(0)
    // Distinct, non-zero seeds: a child that read the wrong region, or wrote the
    // wrong cell, produces a wrong answer rather than a coincidentally right one.
    cells[t] = i32(101 + 37 * t)
    regions[2 * t] = i64(elemAddr(donesBase, t))
    regions[2 * t + 1] = i64(elemAddr(cellsBase, t))
    t = t + 1
  }

  // ---- Start BOTH before joining EITHER ----------------------------------
  //
  // Starting and joining one at a time would serialise the children and never
  // put two allocating mutators in the world at the same time, which is the
  // configuration under test.
  let handles = []i64(NT)
  let started = 0
  let a = 0
  while (a < NT) {
    let h = startFn(gcChildEntry(),
                    byteAt(elemAddr(regionsBase, 2 * a)),
                    i32At(elemAddr(donesBase, a)))
    handles[a] = i64(h)
    if (h != 0) { started = started + 1 }
    a = a + 1
  }

  // ---- G1: both children started -----------------------------------------
  if (started == NT) { mask = mask | 1 }

  // ---- G2: both children finished inside the deadline --------------------
  //
  // `threadJoin` is a BOUNDED poll, so a child that never finishes fails this
  // rather than hanging the suite. It also loops while holding `sleepFn`/`monoFn`
  // — see the header on why that matters.
  //
  // SEPARATE FROM G3 ON PURPOSE. This is the only wall-clock-dependent property
  // in the program, and under `BIT_GC=stress` the clock is not the children's:
  // the parent spends this loop inside `sleepFn`, which does NOT use the
  // collector's `blocked` contract (see runtime/ABI.md §5, "Known limitation"),
  // so it reads as `running` and every collection a child attempts meanwhile
  // spins to the rendezvous bound and is abandoned. On a 6-core x86_64 box that
  // was 195 abandoned collections and ~66s of wall clock. That is a documented
  // runtime inefficiency, not a lost root — so it must fail as ITS OWN bit
  // rather than as "a child lost a root", which is what G3 means.
  let joined = 0
  let clean = 0
  let j = 0
  while (j < NT) {
    if (threadJoin(i32At(elemAddr(donesBase, j)), JOIN_NS, sleepFn, monoFn) == threadJoinDone) {
      joined = joined + 1
      // 0 means the child verified all KEEP_N elements of its own array.
      if (int(cells[j]) == 0) { clean = clean + 1 }
    }
    j = j + 1
  }
  if (joined == NT) { mask = mask | 2 }

  // ---- G3: no child that finished lost a root ----------------------------
  //
  // THE PROPERTY THIS PROGRAM EXISTS FOR.
  //
  // Measured against `joined`, not `NT`, so that a join running out of clock
  // fails G2 ALONE instead of dragging this bit down with it — a child that
  // never reported cannot have lost a root, and conflating the two would report
  // a scheduling artifact as heap corruption. `joined > 0` keeps it from passing
  // vacuously when nothing finished at all.
  if (joined > 0 && clean == joined) { mask = mask | 4 }

  // ---- G4: the PARENT's roots survived too -------------------------------
  let parentOk = true
  let v = 0
  while (v < KEEP_N) {
    if (int(keep[v]) != 1000 + v) { parentOk = false }
    v = v + 1
  }
  if (parentOk) { mask = mask | 8 }

  // ---- G5: every handle releases -----------------------------------------
  //
  // Only meaningful after the joins reported done: releasing a running thread's
  // stack is the use-after-free that ordering exists to prevent.
  let released = 0
  let r = 0
  while (r < NT) {
    if (releaseFn(int(handles[r]))) { released = released + 1 }
    r = r + 1
  }
  if (released == NT) { mask = mask | 16 }

  return mask
}
