// The platform-free half of runtime/thread (#1403): the join loop and the
// constants both providers implement against.
//
// Runs on every target, because it contains no platform code at all — the two
// providers are exercised by tests/stress/threadlinux and
// tests/stress/threaddarwin, which are marked linux-only and darwin-only
// respectively. `threadJoin` takes its clock and its sleep as function VALUES
// precisely so it can be driven by fakes here.
//
// T2 IS THE REASON THIS PROGRAM EXISTS. Everything else about the join is
// checked against a real thread by the platform programs; what they cannot
// check is the behaviour of the loop when the CLOCK ITSELF misbehaves, because
// a real clock always advances. A deadline is not a bound if the only thing
// enforcing it is a clock — a stopped clock, or one that jumps backwards past
// its deadline, would turn `threadJoin` into an infinite loop and a stuck
// worker into a hung test suite instead of a failing one. That is a
// Power-of-10 violation, and this project has already paid once for a wait that
// hung rather than failed (the QUIC teardown). So the loop carries a static
// trip bound as well, and T2 is what proves the static bound is real rather
// than decorative.

import { threadJoin, threadJoinDone, threadJoinTimedOut, threadRunning,
         threadStackBytes, threadMaxWorkers } from "../../../runtime/thread"

// A clock frozen at zero. The deadline `threadJoin` computes from it can
// therefore never be reached, which is exactly the pathology T2 needs.
function frozenMono(): int { return 0 }

// A sleep that does not sleep, so a million polls cost microseconds rather than
// minutes. The loop under test does not care what it does, only that it returns.
function noSleep(ns: int) { }

// All three properties passed: T1|T2|T3 = 1|2|4.
function total(): int { return 7 }

function props(): int {
  let mask = 0

  // ---- T1: an already-finished thread joins immediately -------------------
  //
  // The word is already 0, so the join must report done without consulting the
  // clock at all. This is also the idempotent second join: releasing a handle
  // and then joining again must not wait out a deadline.
  let finished = []i32(1)
  atomicStore(ptrOf(finished), i32(0))
  if (threadJoin(ptrOf(finished), 1000000000, noSleep, frozenMono) == threadJoinDone) {
    mask = mask | 1
  }

  // ---- T2: the join TERMINATES against a clock that never advances --------
  //
  // The word never becomes 0 and `frozenMono` never reaches the deadline, so
  // the only thing that can end this call is the static trip bound. If that
  // bound were removed — or were expressed as "loop until the deadline", which
  // is the natural way to write it — this line would hang forever and the
  // suite with it. It returning at all is the property; that it returns
  // `threadJoinTimedOut` is the right answer to have returned.
  let stuck = []i32(1)
  atomicStore(ptrOf(stuck), i32(threadRunning))
  if (threadJoin(ptrOf(stuck), 1000000000, noSleep, frozenMono) == threadJoinTimedOut) {
    mask = mask | 2
  }

  // ---- T3: the constants the providers and the scheduler agree on ---------
  //
  // `threadJoinDone` and `threadJoinTimedOut` must be distinct, or every join
  // result is unreadable. `threadRunning` must be nonzero, or a word armed with
  // it would read as already finished. `threadMaxWorkers` mirrors the bound
  // `Scheduler.init` asserts, and `threadStackBytes` must be a whole number of
  // 4KiB pages, since the Linux provider maps it and a partial page would make
  // the mapping and the unmapping disagree.
  let distinct = threadJoinDone != threadJoinTimedOut
  let armed = threadRunning != 0
  let bounded = threadMaxWorkers == 1024
  let paged = threadStackBytes > 0 && threadStackBytes % 4096 == 0
  if (distinct && armed && bounded && paged) {
    mask = mask | 4
  }

  return mask
}

function main() {
  let m = props()
  let ok = m == total()
  print("${ok} ${m}\n")
}
