// Shared property checks for the OS-thread providers (#1403), applied unchanged
// to `runtime/thread/linux` and `runtime/thread/darwin`. The provider is taken
// as a set of function VALUES rather than imported, which is what lets one copy
// of these checks run against either platform — the same shape
// tests/stress/park/props and tests/stress/alloc/props use.
//
// WHAT THESE CHECKS ARE FOR. A thread-creation primitive has three ways to be
// catastrophically wrong:
//
//   - NO THREAD IS CREATED, but the call reports success. Caught by P1: the
//     child is the only thing that writes its result cell, so a cell still
//     holding its seed means nothing ran.
//
//   - THE THREAD IS CREATED BUT IS NOT A SECOND THREAD — the work happens on
//     the caller. This is the failure a naive test cannot see at all, because
//     the answers all come out right. It is caught by P4, and only by P4: a
//     parent BLOCKED in `parkWait` cannot also be running the child, so a wake
//     that arrives proves two threads were executing at once. Nothing else
//     here distinguishes a real thread from a very fast function call.
//
//   - THE JOIN NEVER RETURNS. Every wait below is finite by construction —
//     `threadJoin` is a bounded poll against a deadline — so a thread that
//     never finishes makes P5 fail rather than hanging the suite. An unbounded
//     probe loop would turn a failure into a hang, which is a Power-of-10
//     violation and strictly worse to debug than a red test.
//
// P4 IS THE PROPERTY THIS WHOLE TASK EXISTS TO MAKE POSSIBLE. Until OS thread
// creation landed, `runtime/park`'s `parkWake` had never been observed waking a
// real waiter: `root.zig` pins the scheduler to one worker, so a Bit program had
// exactly one thread running Bit code and a wait that genuinely blocked could
// not be released by any Bit code in the same process. #1403's first half said
// so explicitly and told #1364 not to treat wake as exercised. P4 is that gap
// closed — see the discrimination argument on the check itself.
//
// The timing bounds are generous on purpose: the suite runs under load and
// twice per program (once under BIT_GC=stress). They are still nowhere near the
// failures they guard.

import { threadJoin, threadJoinDone, threadJoinTimedOut, threadRunning,
         threadStackBytes, threadMaxWorkers } from "../../../../runtime/thread"
import { parkWaitReady, parkWaitTimedOut } from "../../../../runtime/park"

// All six properties passed: P1|P2|P3|P4|P5|P6 = 1|2|4|8|16|32.
// A bitmask rather than a count so a failure names the property that broke.
export fn threadTotal(): int { return 63 }

// How many threads P3 runs at once. Small and fixed: the point is to prove that
// more than one child can be live simultaneously and that each gets its own
// stack and its own done word, which four demonstrates as well as forty while
// keeping the whole test's resource use flat.
const NT: int = 4

// The bounded work each child does. `sum(0..999) = 499500`, which is well
// inside i32 even after a seed is added.
const WORK_N: int = 1000
const WORK_SUM: int = 499500

// P1/P3 join deadline. A child does microseconds of work; seconds of headroom
// covers the suite running under load without ever approaching the failure.
const JOIN_NS: int = 10000000000        // 10s

// P4's parameters. The child sleeps `WAKE_DELAY_NS` so the parent is already
// blocked when the wake lands, then wakes it. The parent's wait is bounded by
// `WAKE_WAIT_NS`.
// Exported because the WAKER CHILD lives in each platform program (it must call
// that platform's `parkWake`), while the floor and ceiling it has to sit between
// are here. Keeping the delay with the bounds it must satisfy is what stops the
// two drifting into a window that no longer discriminates.
export const threadWakeDelayNs: int = 100000000    // 100ms
const WAKE_WAIT_NS: int = 5000000000    // 5s
const WAKE_FLOOR_NS: int = 40000000     // 40ms  — below this it never blocked
const WAKE_CEIL_NS: int = 2000000000    // 2s    — above this the wake was lost

// P5's deadline for a word that is never cleared, and the window the timeout
// must land in. The floor proves it really waited rather than returning
// `threadJoinTimedOut` immediately, which a join that ignored the word would.
const TIMEOUT_NS: int = 300000000       // 300ms
const TIMEOUT_FLOOR_NS: int = 200000000 // 200ms
const TIMEOUT_CEIL_NS: int = 5000000000 // 5s

// An address as a `*i32`, for the atomic words the children share with us.
//
// Pointer arithmetic scales by the pointee's size (§11.4), so the index is the
// byte address divided by 4. Every address passed here is 8-aligned — it is
// either `ptrOf` of a slice or a whole number of 8-byte slice elements past it
// — so the division is exact.
export @nosplit fn i32At(addr: int): *i32 {
  let z: *i32 = nil
  return z + (addr / 4)
}

// The same for a 64-bit word. Used only to read the two ADDRESSES a child finds
// in its argument region.
export @nosplit fn i64At(addr: int): *i64 {
  let z: *i64 = nil
  return z + (addr / 8)
}

// A BIT SLICE STORES ONE 8-BYTE WORD PER ELEMENT, so element `i` of any slice
// begins at byte `8 * i` regardless of the element type — a `[]i32` is NOT a
// packed array of 4-byte integers. That has already produced two silent bugs in
// this runtime port (a zeroed Darwin timebase and a mis-strided affinity mask),
// so it is spelled out once here and used everywhere below.
//
// P6 pins the assumption rather than trusting it: it writes through the slice
// and reads back through the pointer this returns.
// Exported so `../gcprops` uses this one rule rather than restating
// the stride it depends on just as heavily.
export @nosplit fn elemAddr(base: int, i: int): int {
  return base + 8 * i
}

// The body every P1/P3 child runs.
//
// `@nosplit` IS LOAD-BEARING, NOT DECORATION. This function contains a loop, and
// codegen emits `bl bit_rt_safepoint` at every loop back-edge in a function that
// is not `@nosplit`. A child thread is not a registered runtime worker, so a
// safepoint poll from here would run the collector from a thread the collector
// does not know about, concurrently with the real mutator — and under
// `BIT_GC=stress`, which collects at every safepoint, that would happen on the
// first iteration. `@nosplit` suppresses the poll, and the attribute's own rule
// (no allocation, no safepoint) is exactly the obligation a child owes.
//
// Its argument is a two-word region holding the ADDRESSES of the two words it
// owns: its done word and its result cell. Passing addresses rather than a
// packed struct keeps every atomic word a properly allocated slice element and
// keeps this body free of any layout assumption beyond `elemAddr`.
//
// THE STORE ORDER IS THE CONTRACT: the result is published BEFORE the done word
// is cleared, so a parent that observes done == 0 is guaranteed to observe the
// result too.
@nosplit fn workChild(arg: *byte): *byte {
  let base = int(arg)
  let done = i32At(int(*i64At(base)))
  let cell = i32At(int(*i64At(elemAddr(base, 1))))

  let seed = int(atomicLoad(cell))
  let acc = 0
  let i = 0
  while (i < WORK_N) {
    acc = acc + i
    i = i + 1
  }

  atomicStore(cell, i32(seed + acc))
  atomicStore(done, i32(0))
  return nil
}

// The entry address of the shared child body, for the platform programs to hand
// to `threadStart`. `entryOf` (§11.10) requires its operand to reference a named
// function declaration directly, so it is taken here, where that function is
// declared, rather than exported as a value.
export fn workChildEntry(): *byte {
  return entryOf(workChild)
}

// Run the whole property set against one platform's provider.
//
// `wakerEntry` is the one child body this module cannot supply: P4's child must
// call the PLATFORM's `parkWake`, and a child receives only a `*byte` argument,
// so it cannot be handed a function value. Each platform program therefore
// declares its own waker and passes its entry address in. The requirements on
// that body are stated at P4.
export fn threadProps(startFn: (*byte, *byte, *i32) => int,
                            releaseFn: (int) => bool,
                            waitFn: (*i32, i32, int) => int,
                            sleepFn: (int) => (),
                            monoFn: () => int,
                            wakerEntry: *byte): int {
  let mask = 0

  // Every atomic word the children touch lives in one of these two slices, so
  // one live local per slice keeps all of them reachable. Holding only raw
  // addresses would not: a raw pointer is untraced (§11.4), so the collector
  // could reclaim a word a running child still writes to.
  let dones = []i32(NT)
  let cells = []i32(NT)
  // Two words per thread: [address of its done word, address of its cell].
  let regions = []i64(2 * NT)

  let donesBase = int(ptrOf(dones))
  let cellsBase = int(ptrOf(cells))
  let regionsBase = int(ptrOf(regions))

  let t = 0
  while (t < NT) {
    dones[t] = i32(0)
    cells[t] = i32(0)
    regions[2 * t] = i64(elemAddr(donesBase, t))
    regions[2 * t + 1] = i64(elemAddr(cellsBase, t))
    t = t + 1
  }

  // ---- P1: one thread starts, runs, and is joined -------------------------
  //
  // The seed is what makes "it ran" distinguishable from "the cell happened to
  // hold the right number": the child returns seed + WORK_SUM, so a cell still
  // holding the seed means no child ran, and a zero means it never even got
  // its argument.
  let seed1 = 77
  cells[0] = i32(seed1)
  let done0 = i32At(elemAddr(donesBase, 0))
  let h1 = startFn(workChildEntry(), byteAt(regionsBase), done0)
  let joined1 = threadJoinTimedOut
  if (h1 != 0) {
    joined1 = threadJoin(done0, JOIN_NS, sleepFn, monoFn)
  }
  if (h1 != 0 && joined1 == threadJoinDone && int(cells[0]) == seed1 + WORK_SUM) {
    mask = mask | 1
  }

  // ---- P2: the handle releases -------------------------------------------
  //
  // Only meaningful after P1's join reported done — releasing a running
  // thread's stack is exactly the use-after-free this ordering exists to
  // prevent, which is why `threadRelease` is documented as join-then-release.
  if (h1 != 0 && joined1 == threadJoinDone && releaseFn(h1)) {
    mask = mask | 2
  }

  // ---- P3: NT threads run at once, each with its own stack and done word --
  //
  // All are started before any is joined, so they are genuinely concurrent
  // rather than a sequence of one-at-a-time spawns. Distinct seeds mean a
  // provider that handed two children the same argument region — or the same
  // stack — produces a wrong sum rather than a plausible one.
  let handles = []int(NT)
  let started = 0
  let k = 0
  while (k < NT) {
    cells[k] = i32(100 + k)
    handles[k] = startFn(workChildEntry(),
                         byteAt(elemAddr(regionsBase, 2 * k)),
                         i32At(elemAddr(donesBase, k)))
    if (handles[k] != 0) {
      started = started + 1
    }
    k = k + 1
  }

  let joinedAll = 0
  let correct = 0
  let released = 0
  let j = 0
  while (j < NT) {
    if (handles[j] != 0) {
      if (threadJoin(i32At(elemAddr(donesBase, j)), JOIN_NS, sleepFn, monoFn) == threadJoinDone) {
        joinedAll = joinedAll + 1
        if (int(cells[j]) == 100 + j + WORK_SUM) {
          correct = correct + 1
        }
        if (releaseFn(handles[j])) {
          released = released + 1
        }
      }
    }
    j = j + 1
  }
  if (started == NT && joinedAll == NT && correct == NT && released == NT) {
    mask = mask | 4
  }

  // ---- P4: parkWake WAKES A REAL WAITER -----------------------------------
  //
  // The whole reason this task had to exist before #1364 could trust the
  // parking pair. The parent blocks in `parkWait` on a word holding 42,
  // expecting 42, with a 5s bound. The child sleeps 100ms — long enough that
  // the parent is already blocked — and then calls the platform's `parkWake`
  // on that same word WITHOUT CHANGING IT.
  //
  // Leaving the word alone is what makes the outcomes discriminate. The wait
  // can only end early by being woken, so:
  //
  //   wake works   -> returns ~100ms with parkWaitReady
  //   wake is lost -> returns at the 5s deadline with parkWaitTimedOut
  //   never blocks -> returns immediately, under the 40ms floor
  //
  // All three are distinguishable, and the two failures are 50x and 25x away
  // from the pass window rather than adjacent to it. A spurious wake cannot
  // manufacture a pass either, because the floor requires that it really did
  // block for at least 40ms first.
  let wakeWord = []i32(1)
  let wakeDone = []i32(1)
  let wakeRegion = []i64(2)
  atomicStore(ptrOf(wakeWord), i32(42))
  wakeDone[0] = i32(0)
  wakeRegion[0] = i64(int(ptrOf(wakeDone)))
  wakeRegion[1] = i64(int(ptrOf(wakeWord)))

  let wakeHandle = startFn(wakerEntry, byteAt(int(ptrOf(wakeRegion))), ptrOf(wakeDone))
  if (wakeHandle != 0) {
    let w0 = monoFn()
    let rc = waitFn(ptrOf(wakeWord), i32(42), WAKE_WAIT_NS)
    let elapsed = monoFn() - w0
    if (rc == parkWaitReady && elapsed >= WAKE_FLOOR_NS && elapsed < WAKE_CEIL_NS) {
      mask = mask | 8
    }
    // Reap regardless of the outcome, so a failed P4 cannot leak a thread into
    // the rest of the run.
    let wj = threadJoin(ptrOf(wakeDone), JOIN_NS, sleepFn, monoFn)
    if (wj == threadJoinDone) {
      let rel = releaseFn(wakeHandle)
    }
  }

  // ---- P5: the join's timeout really fires, and really waited -------------
  //
  // No thread is involved: the word simply never becomes 0, which is precisely
  // what a wedged worker looks like. This is the guard that keeps every join
  // finite, so it is checked directly rather than trusted — a join that
  // returned `threadJoinDone` here would report a stuck thread as finished, and
  // a join that returned instantly would not have waited at all.
  let stuck = []i32(1)
  atomicStore(ptrOf(stuck), i32(threadRunning))
  let s0 = monoFn()
  let rc5 = threadJoin(ptrOf(stuck), TIMEOUT_NS, sleepFn, monoFn)
  let waited = monoFn() - s0
  if (rc5 == threadJoinTimedOut && waited >= TIMEOUT_FLOOR_NS && waited < TIMEOUT_CEIL_NS) {
    mask = mask | 16
  }

  // ---- P6: the boundaries, and the slice-layout assumption ----------------
  //
  // Three unrelated small facts that would each silently break something:
  //
  //   - an already-cleared word joins immediately rather than waiting out a
  //     deadline (an idempotent second join);
  //   - `threadRelease` refuses a zero handle instead of unmapping address 0;
  //   - `elemAddr`'s ONE-8-BYTE-WORD-PER-ELEMENT assumption really holds. This
  //     is written through the slice and read back through the raw pointer, so
  //     if a `[]i32` were ever a packed 4-byte array, every address this file
  //     computes would be wrong and this is what would say so.
  let cleared = []i32(1)
  atomicStore(ptrOf(cleared), i32(0))
  let rc6 = threadJoin(ptrOf(cleared), TIMEOUT_NS, sleepFn, monoFn)

  let probe = []i32(3)
  probe[0] = i32(0)
  probe[1] = i32(4242)
  probe[2] = i32(0)
  let probeBase = int(ptrOf(probe))
  let layoutOk = int(atomicLoad(i32At(elemAddr(probeBase, 1)))) == 4242

  // The core's constants are imported here purely so that a provider drifting
  // from them is a compile-time or check-time event rather than a silent one;
  // `threadRunning` is used above, and these two bound the pool the scheduler
  // will size.
  let constantsOk = threadStackBytes > 0 && threadMaxWorkers == 1024

  if (rc6 == threadJoinDone && !releaseFn(0) && layoutOk && constantsOk) {
    mask = mask | 32
  }

  return mask
}

// An address as a `*byte`, for the opaque argument a child receives.
export @nosplit fn byteAt(addr: int): *byte {
  let z: *byte = nil
  return z + addr
}
