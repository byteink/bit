// Linux half of the #1368 verification: `runtime/rand/linux`'s `entropyFill`,
// which reaches the OS CSPRNG through the raw `getrandom(2)` syscall (§11.8),
// with a `/dev/urandom` fallback for pre-3.17 kernels.
//
// A separate program from `randdarwin` because §11.7 and §11.8 cannot coexist
// in one module — a `syscall` is rejected when targeting Darwin and an
// `extern function` when targeting Linux, so a single source form would fail
// to compile for BOTH. `linux-only` marks it for the harness.
//
// The properties themselves come from `../rand/props`, shared verbatim with
// the Darwin program, so the two platforms are held to an identical standard
// and the guard-band regime cannot drift between them.

import { entropyProps, entropyTotal } from "../rand/props"
import { entropyFill } from "../../../runtime/rand/linux"

function main() {
  print("randlinux entropy=${entropyProps(entropyFill)}/${entropyTotal()}\n")
}
