// Select storm: two producers race 300 values each onto separate unbuffered
// channels while main multiplexes them with select, 600 receives total. Under
// BIT_GC=stress the collector runs throughout, with producers parked mid-send.
// sum(0..299) + sum(10000..10299) = 44850 + 3044850 = 3089700.
function producer(ch: chan<i64>, base: i64) {
  let i = 0
  while (i < 300) {
    ch <- base + i
    i = i + 1
  }
}

function main() {
  let a = chan<i64>(0)
  let b = chan<i64>(0)
  spawn producer(a, 0)
  spawn producer(b, 10000)
  let sum = 0
  let got = 0
  while (got < 600) {
    select {
      case x = <- a:
        sum = sum + x
      case y = <- b:
        sum = sum + y
    }
    got = got + 1
  }
  print("${sum}\n")
}
