// #2167's socket-free variant: N `spawn`ed tasks joined through a
// `WaitGroup`, no sockets, no locks, no netpoller involvement at all.
//
// THIS IS THE PROGRAM THAT DISPROVED THE TICKET'S OWN ORIGINAL HYPOTHESIS.
// The Hypothesis field originally read "the leak needs `spawn` AND the task
// blocking on socket I/O", citing 200 000 joined spawns with flat RSS. This
// exact shape, measured fresh against `main` before the fix, leaked at the
// same ~48-49 KB/spawn rate as the socket-parked case, at every scale tried
// (100/1000/5000) — flat, linear, no plateau — which is what a per-task
// `mapGuardedStack`/`mapPages` pair with no matching `unmapPages` on ANY exit
// path produces regardless of whether the task ever touches a socket. See
// `../spawnconnleak` for the socket-parked sibling and #2167 for the RSS
// table (both variants, three scales, before and after).
//
// WHY CORRECTNESS, NOT RSS, HERE (see `../spawnconnleak`'s header for the
// full argument): this harness diffs deterministic stdout, and a wrong
// `munmap` range or a missing `mainTaskBlock` sentinel is a crash or a
// corrupted count here, not a slow leak — that failure mode is exactly what
// this program can catch and an RSS assertion could not.
//
// N is large enough that a broken teardown (a bad address, a double-unmap, a
// missing sentinel check corrupting `main`'s own task block) would corrupt
// the count or crash well before N spawns finish, and small enough that two
// runs (default policy, then `BIT_GC=stress`) are fast.

import { newWaitGroup, WaitGroup } from "std/sync"

const N: int = 3000

struct S { wg: WaitGroup, done: []i64, idx: int }

fn noop(s: S) {
  s.done[s.idx] = 1
  s.wg.done()
}

fn main() {
  let wg = newWaitGroup()
  wg.add(i64(N))
  let done = []i64(N)
  let i = 0
  while (i < N) {
    spawn noop(S{ wg: wg, done: done, idx: i })
    i = i + 1
  }
  wg.wait()

  let count = 0
  let j = 0
  while (j < N) {
    if (done[j] == 1) {
      count = count + 1
    }
    j = j + 1
  }
  print("spawnjoin ${count}\n")
}
