// Inline `asm` (§11.6) — the Stage-2 unmanaged-subset primitive: an asm block
// that adds two register inputs and returns their sum.
//
// The arm64 sub-block is one pre-encoded instruction word, `add x0, x1, x2`
// (0x8B020020), with `a` pinned to x1, `b` to x2, and the result read back out
// of x0. The x64 sub-block is `add rax, rcx` (48 01 C8), with `a` pinned to rax
// (which doubles as the result register) and `b` to rcx. Both targets live on
// the one node — each backend reads only its own arch's sub-block — so the same
// source compiles for either without arch-conditional compilation.
//
// The payload is raw pre-encoded bytes/words, not mnemonic text: the backends
// are instruction-selection only and have no text assembler, so emission is a
// straight `emitByte`/`emitWord` passthrough.
//
// Beyond the single KAT this also drives the register allocator. The sum feeds
// further arithmetic, and a loop accumulates through the asm block, so the
// pinned registers must stay excluded from the allocatable file across a back
// edge. A pinning bug (a vreg parked in x0/x1/x2, or a clobber the allocator
// did not know about) shows up immediately as a wrong total rather than as a
// crash.

fn addAsm(a: int, b: int): int {
  return asm {
    arm64 { 0x8B020020 }
    x64 { 0x48, 0x01, 0xC8 }
    result arm64 x0 x64 rax : int
    input arm64 x1 x64 rax = a
    input arm64 x2 x64 rcx = b
  }
}

// The same block under `@nosplit` (§10.3.1). An asm payload is opaque, so it is
// admitted on the author's assertion rather than on proof — the rule the GC's
// register snapshot and the scheduler's context switch depend on, both being
// nosplit-by-nature and irreducibly asm. This must not merely typecheck: the
// nosplit path also suppresses the safepoint poll and changes which registers
// the allocator may use, so the block has to still produce the right value with
// that machinery off.
@nosplit fn addAsmNosplit(a: int, b: int): int {
  return asm {
    arm64 { 0x8B020020 }
    x64 { 0x48, 0x01, 0xC8 }
    result arm64 x0 x64 rax : int
    input arm64 x1 x64 rax = a
    input arm64 x2 x64 rcx = b
  }
}

// A nosplit caller reaching the asm block through a nosplit callee, driven
// across a back edge — the one-hop transitive rule and the suppressed back-edge
// safepoint exercised together.
@nosplit fn sumViaAsm(n: int): int {
  let acc = 0
  let i = 0
  while (i < n) {
    acc = addAsmNosplit(acc, i)
    i = i + 1
  }
  return acc
}

// A loop living entirely INSIDE one asm block (§11.6), branching to a
// hand-computed PC-relative displacement rather than a label the compiler
// resolved. This is the shape a context switch needs, and the spec once claimed
// it was unsupported pending a relocation pass — it is not: a backend emits the
// payload contiguously and unmodified, so a self-relative back edge is stable.
//
// Multiply by repeated addition, so the result is INPUT-DEPENDENT. A block whose
// branch silently fell through would return `m` every time instead of `n * m`,
// which a fixed-answer probe (a countdown to zero) would not distinguish.
fn mulAsm(n: int, m: int): int {
  return asm {
    // loop: add x2, x2, x1 ; subs x0, x0, #1 ; b.ne -8 (back two words)
    arm64 { 0x8B010042, 0xF1000400, 0x54FFFFC1 }
    // loop: add rdx, rcx ; dec rax ; jne -8 (back eight bytes)
    x64 { 0x48, 0x01, 0xCA, 0x48, 0xFF, 0xC8, 0x75, 0xF8 }
    result arm64 x2 x64 rdx : int
    input arm64 x0 x64 rax = n
    input arm64 x1 x64 rcx = m
    input arm64 x2 x64 rdx = 0
  }
}

fn main() {
  // (a) the direct KAT: 40 + 2.
  let sum = addAsm(40, 2)

  // (b) the asm result feeding further arithmetic (101 + 23).
  let mixed = addAsm(100, 1) + addAsm(20, 3)

  // (c) loop accumulation through the asm block: acc doubles each step after
  // the first, reaching 26 — a value that only comes out right if every
  // intermediate survived the pinned registers across the back edge.
  let acc = 0
  let i = 0
  while (i < 5) {
    acc = acc + addAsm(acc, i)
    i = i + 1
  }

  // (d) the same block under @nosplit: 40 + 2, and 0+1+2+3+4 accumulated
  // through a nosplit->nosplit call across a back edge with the safepoint
  // poll suppressed.
  let nosplitSum = addAsmNosplit(40, 2)
  let nosplitAcc = sumViaAsm(5)

  // (e) a loop INSIDE one asm block, reaching its back edge by hand-computed
  // displacement: 5*7 and 12*12.
  let looped = mulAsm(5, 7)
  let looped2 = mulAsm(12, 12)

  print("${sum} ${mixed} ${acc} ${nosplitSum} ${nosplitAcc} ${looped} ${looped2}\n")
}
