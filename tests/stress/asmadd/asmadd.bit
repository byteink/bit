// Inline `asm` (§11.6) — the Stage-2 unmanaged-subset primitive: an asm block
// that adds two register inputs and returns their sum.
//
// The arm64 sub-block is one pre-encoded instruction word, `add x0, x1, x2`
// (0x8B020020), with `a` pinned to x1, `b` to x2, and the result read back out
// of x0. The x64 sub-block is `add rax, rcx` (48 01 C8), with `a` pinned to rax
// (which doubles as the result register) and `b` to rcx. Both targets live on
// the one node — each backend reads only its own arch's sub-block — so the same
// source compiles for either without arch-conditional compilation.
//
// The payload is raw pre-encoded bytes/words, not mnemonic text: the backends
// are instruction-selection only and have no text assembler, so emission is a
// straight `emitByte`/`emitWord` passthrough.
//
// Beyond the single KAT this also drives the register allocator. The sum feeds
// further arithmetic, and a loop accumulates through the asm block, so the
// pinned registers must stay excluded from the allocatable file across a back
// edge. A pinning bug (a vreg parked in x0/x1/x2, or a clobber the allocator
// did not know about) shows up immediately as a wrong total rather than as a
// crash.

function addAsm(a: int, b: int): int {
  return asm {
    arm64 { 0x8B020020 }
    x64 { 0x48, 0x01, 0xC8 }
    result arm64 x0 x64 rax : int
    input arm64 x1 x64 rax = a
    input arm64 x2 x64 rcx = b
  }
}

function main() {
  // (a) the direct KAT: 40 + 2.
  let sum = addAsm(40, 2)

  // (b) the asm result feeding further arithmetic (101 + 23).
  let mixed = addAsm(100, 1) + addAsm(20, 3)

  // (c) loop accumulation through the asm block: acc doubles each step after
  // the first, reaching 26 — a value that only comes out right if every
  // intermediate survived the pinned registers across the back edge.
  let acc = 0
  let i = 0
  while (i < 5) {
    acc = acc + addAsm(acc, i)
    i = i + 1
  }

  print("${sum} ${mixed} ${acc}\n")
}
