// A raw OS thread's mutator slot is released by the Darwin thread provider's
// side of the contract, not by the thread's body (#1801).
//
// Darwin-only by construction, hence the sibling `darwin-only` marker: the
// provider declares `extern function`s (SPEC §11.7), which the compiler rejects
// on both Linux targets with E0078 even for an uncalled declaration.
//
// The properties, and the argument for why each one discriminates — including
// why the real oracle is the sibling `no-abandon` marker rather than this
// program's output — live in ./../thread/exitprops. This file supplies only the
// platform binding. It is kept identical in shape to its Linux twin, so a future
// divergence between the two means a real platform difference rather than a
// spelling one.
import { slotExitRun, slotExitTotal } from "../thread/exitprops"
import { threadStart, threadRelease } from "../../../runtime/thread/darwin"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/darwin"

// `slotExitRun` takes `sleepFn` as the generic `(int) => ()` shape shared
// with the Linux twin — `parkSleepNs` no longer fits it directly now that it
// takes a caller-owned scratch (#2318), so this adapts it back using this
// thread's own scratch, which nothing else on this OS thread touches
// concurrently.
let sleepScratch: [2]i64

fn sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(sleepScratch))
}

fn main() {
  let got = slotExitRun(threadStart, threadRelease, sleepAdapt, parkMonoNs)
  let total = slotExitTotal()
  print("${got == total} ${got}\n")
}
