// Objects reachable ONLY through a slice must survive collection: the GC traces
// a reference element buffer word-by-word (ABI.md §2). Under BIT_GC=stress every
// safepoint collects, so any element the collector fails to root is swept and
// the next iteration reads freed memory. Mixed concrete types behind an
// interface, dispatched dynamically, with append-driven growth for extra churn.
interface Shape { area(): i64 }
class Circle { export r: i64 }
fn (c: Circle) area(): i64 { return c.r * c.r }
class Square { export s: i64 }
fn (sq: Square) area(): i64 { return sq.s * sq.s }

fn build(n: i64): []Shape {
  let xs = []Shape(0)
  let i = 0
  while (i < n) {
    if (i % 2 == 0) {
      xs = append(xs, Circle{ r: i })
    } else {
      xs = append(xs, Square{ s: i })
    }
    i = i + 1
  }
  return xs
}

fn main() {
  let shapes = build(20)
  let sum = 0
  for s of shapes {
    sum = sum + s.area()
  }
  print("sum=${sum}\n")
}
