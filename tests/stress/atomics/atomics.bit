// Atomics (§11.5) on a raw `*T` — the Stage-2 unmanaged-subset primitives,
// exercised two ways, both deterministic:
//
//   (a) CAS KAT — `atomicCmpxchg(p, old, new)` swaps (and returns true) only
//       when `*p == old`, otherwise leaves `*p` untouched and returns false.
//       A CAS-retry loop (`casInc`) then increments through that primitive.
//
//   (b) Concurrent counters — WORKERS green threads each apply ITERS increments
//       to one shared `*i64`, once through a CAS-retry loop and once through
//       `atomicAdd`. The counters must each reach exactly WORKERS*ITERS: a
//       broken atomic (a wrong result word, a CAS loop that never converges, or
//       a store that corrupts the neighbouring counter) shows up immediately as
//       a wrong total. The v1 scheduler pins to a single worker, so the threads
//       interleave cooperatively rather than truly in parallel; the same test
//       becomes a genuine data-race probe unchanged once the scheduler unpins to
//       M:N. The collector firing at every safepoint (BIT_GC=stress) also proves
//       the shared buffers stay rooted through `main` while only raw, untraced
//       `*i64`s reach the workers.
//
// The `*i64` targets a live `[]i64(1)` buffer via `ptrOf` (the one bridge from
// traced memory to a raw pointer — Bit has no `&`); `main` holds the slice
// across the join so the collector keeps its backing storage alive.
//
// WORKERS*ITERS = 8 * 12500 = 100000.

const WORKERS = 8
const ITERS = 12500

// Increment `*p` by one through a compare-and-swap retry loop: read the current
// value, then swap in value+1 only if it is still current, retrying on a race.
fn casInc(p: *i64) {
  let done = false
  while (!done) {
    let old = atomicLoad(p)
    done = atomicCmpxchg(p, old, old + 1)
  }
}

fn casWorker(p: *i64, iters: i64, done: chan<i64>) {
  let k = 0
  while (k < iters) {
    casInc(p)
    k = k + 1
  }
  done <- 1
}

fn addWorker(p: *i64, iters: i64, done: chan<i64>) {
  let k = 0
  while (k < iters) {
    atomicAdd(p, 1)
    k = k + 1
  }
  done <- 1
}

fn main() {
  // (a) CAS KAT — single-threaded, fully deterministic.
  let kbuf = []i64(1)
  let kp = ptrOf(kbuf)
  atomicStore(kp, 100)
  let swapped = atomicCmpxchg(kp, 100, 200)     // matches -> swaps, true
  let notSwapped = atomicCmpxchg(kp, 100, 300)   // 200 != 100 -> no swap, false
  let n = 0
  while (n < 50) {
    casInc(kp)                                    // 200 -> 250 over 50 CAS loops
    n = n + 1
  }
  let kat = 0
  if (swapped && !notSwapped && atomicLoad(kp) == 250) {
    kat = 1
  }

  // (b) Two shared counters, hammered concurrently.
  let cbuf = []i64(1)
  let cp = ptrOf(cbuf)
  atomicStore(cp, 0)
  let abuf = []i64(1)
  let ap = ptrOf(abuf)
  atomicStore(ap, 0)

  let done = chan<i64>(WORKERS * 2)
  let w = 0
  while (w < WORKERS) {
    spawn casWorker(cp, ITERS, done)
    spawn addWorker(ap, ITERS, done)
    w = w + 1
  }
  let j = 0
  while (j < WORKERS * 2) {
    let sig = <- done
    j = j + 1
  }

  // `cbuf`/`abuf` are read here so they stay live (rooted) across the join.
  let casTotal = atomicLoad(cp)
  let addTotal = atomicLoad(ap)
  print("${kat} ${casTotal} ${addTotal} ${cbuf[0]} ${abuf[0]}\n")
}
