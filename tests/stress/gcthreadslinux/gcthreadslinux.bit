// Concurrent collection on the Linux thread provider (#1431).
//
// Linux-only by construction, hence the sibling `linux-only` marker: the
// provider issues raw `syscall`s (SPEC §11.8), which the compiler rejects
// when targeting Darwin, even for an uncalled declaration.
//
// The properties, and the argument for why each one discriminates, live in
// ./../thread/gcprops. This file supplies only the platform binding. It is kept
// identical in shape to its Darwin twin, so a future divergence between the two
// means a real platform difference rather than a spelling one.
import { gcThreadsRun, gcThreadsTotal } from "../thread/gcprops"
import { threadStart, threadRelease } from "../../../runtime/thread/linux"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/linux"

// `gcThreadsRun` takes `sleepFn`/`monoFn` as the generic `(int) => ()` /
// `() => int` shape shared with the Darwin twin — `parkSleepNs`/`parkMonoNs`
// no longer fit it directly now that each takes a caller-owned scratch
// (#2318), so these adapt them back using this thread's own scratch, which
// nothing else on this OS thread touches concurrently.
let scratch: [2]i64

function sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(scratch))
}

function monoAdapt(): int {
  return parkMonoNs(ptrOf(scratch))
}

function main() {
  let got = gcThreadsRun(threadStart, threadRelease, sleepAdapt, monoAdapt)
  let total = gcThreadsTotal()
  print("${got == total} ${got}\n")
}
