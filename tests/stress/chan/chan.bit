// Channel semantics (#1365) driven on a single worker, so every phase is
// deterministic rather than sampled.
//
// This is the all-targets floor: buffer discipline, ring wraparound, unbuffered
// rendezvous, FIFO across a full buffer, `close` releasing blocked receivers AND
// blocked senders, select's arm choice / default / winner-take-all, and the
// GC root-scanning cursor.
//
// WHAT IT DOES NOT COVER, stated here so this program is not mistaken for the
// whole test: the `chanWake` wait — the one place this port diverges from
// `chan.zig`'s park callback — is unreachable with one worker, because a waiter
// can only be observed by a peer that runs strictly after the waiting task has
// already switched away. ../chanlinux and ../chandarwin put a sender and a
// receiver on two real OS threads, which is what makes that race live.
//
// The `close` phases are the teardown check, and they are deliberately built so
// that a partial `close` HANGS rather than printing a wrong number: the blocked
// tasks have no peer left that could ever satisfy them, so if `close` fails to
// drain a wait queue the suite's own timeout is what reports it.

import { propsInit, phaseFifo, phaseRendezvous, phaseCloseRecv, phaseCloseSend } from "./props"
import { phaseSelect, phaseSelectBlocking, phaseFifoAcrossFull, phaseRegistry } from "./props"
import { phaseQueueOrder, phaseSelectRace, phaseSelectUnlink } from "./props"
import { propsVerdict, propsTotal } from "./props"

function main() {
  if (!propsInit()) {
    print("init-failed\n")
    return
  }

  let ok = phaseFifo()
  ok = phaseRendezvous() && ok
  ok = phaseCloseRecv() && ok
  ok = phaseCloseSend() && ok
  ok = phaseSelect() && ok
  ok = phaseSelectBlocking() && ok
  ok = phaseFifoAcrossFull() && ok
  ok = phaseQueueOrder() && ok
  ok = phaseSelectRace() && ok
  ok = phaseSelectUnlink() && ok
  phaseRegistry()

  print("${ok} ${propsVerdict()} ${propsTotal}\n")
}
