// The Linux parking provider (runtime/park/linux, #1403) against the real
// kernel.
//
// Linux-only by construction, hence the sibling `linux-only` marker file: the
// provider issues raw `syscall`s (SPEC §11.8), which the compiler rejects when
// targeting Darwin — even for an uncalled declaration.
//
// The properties, the timing bounds, and the limits of what can be proven
// without a second OS thread are all documented in ./../park/props. The one
// Linux-specific note: unlike Darwin, futex CAN distinguish a failed compare
// (-EAGAIN) from a wake (0) — but the shared contract does not expose that,
// because Darwin cannot honour it. P2 therefore asserts the same
// `parkWaitReady` here as it does there, which is the point: both providers
// implement ONE contract, not two similar ones.
//
// The calls are hoisted into `let`s to match the Darwin twin. There the hoist is
// a required workaround for #1407 (an interpolation slot that allocates
// corrupts earlier slots when the value derives from an `extern function`);
// here it is not required, because this provider reaches the kernel through
// `syscall` rather than an extern and the corruption does not occur. The two
// programs are kept identical in shape anyway, so that a future divergence
// between them means a real platform difference rather than a spelling one.

import { parkProps, parkTotal, parkBackoffKat } from "../park/props"
import { parkWait, parkWake, parkSleepNs, parkMonoNs, parkCpuCount } from "../../../runtime/park/linux"
import { parkTimerSlackNs } from "../../../runtime/park/linux"

// The one property with no Darwin counterpart, so it lives here rather than in
// the shared props: a Linux sleep is only as short as the calling thread's timer
// slack, which defaults to 50us and would otherwise round every sub-50us sleep
// up to ~75us (#1439). Darwin has no such rounding and nothing to assert.
//
// MUST BE READ AFTER `parkProps`, because `parkSleepNs` is what drops the slack
// and `parkProps` is what calls it. Reading first would measure the inherited
// default and pass for the wrong reason.
//
// A ceiling rather than an equality: the requested value is 1ns, but pinning the
// .expected to a number the kernel is free to represent differently would be an
// assertion about the kernel rather than about this provider. 1us separates
// cleanly from the 50000ns default, which is the regression being guarded.
const SLACK_CEILING_NS: int = 1000

// `parkProps` takes `sleepFn`/`monoFn` as the generic `(int) => ()` /
// `() => int` shape shared with the Darwin twin — `parkSleepNs`/`parkMonoNs`
// no longer fit it directly now that each takes a caller-owned scratch
// (#2318), so these adapt them back using this thread's own scratch, which
// nothing else on this OS thread touches concurrently.
let scratch: [2]i64

function sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(scratch))
}

function monoAdapt(): int {
  return parkMonoNs(ptrOf(scratch))
}

function main() {
  let props = parkProps(parkWait, parkWake, sleepAdapt, monoAdapt, parkCpuCount)
  let total = parkTotal()
  let kat = parkBackoffKat()
  let ok = props == total
  let slack = parkTimerSlackNs()
  let slackOk = slack >= 0 && slack <= SLACK_CEILING_NS
  print("${ok} ${props} ${kat} ${slackOk}\n")
}
