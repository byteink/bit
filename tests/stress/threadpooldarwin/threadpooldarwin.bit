// The worker-pool start/join composition (#1607) on TWO REAL OS THREADS, Darwin.
//
// This drives the new `schedStart`/`schedJoin` primitives end to end: one call
// brings the scheduler up on two OS workers, they drain a set of green tasks,
// and one call reaps them after shutdown. The neutral ../threadpool program
// checks the same primitives' logic without threads; this one is where the
// composition meets a genuine second OS thread — the parallel-startup race, the
// per-worker done-word handoff, and the started-only reap on real handles.
//
// Darwin-only by construction, hence the sibling `darwin-only` marker: it binds
// runtime/thread/darwin and runtime/park/darwin, which reach the OS through
// `extern function` (SPEC §11.7) — rejected on Linux even for an uncalled
// declaration. Kept identical in shape to its Linux twin so a divergence between
// the two means a real platform difference rather than a spelling one.

import { poolInit, poolSchedAddr, poolShutdown, poolWorkers } from "../threadpool/props"
import { poolWorkerEntry, poolWaitCounted, poolVerdict, poolTotal } from "../threadpool/props"
import { schedStart, schedJoin } from "../../../runtime/thread"
import { taskAt } from "../../../runtime/sched"
import { threadStart, threadRelease } from "../../../runtime/thread/darwin"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/darwin"

// The three caller-owned areas `schedStart`/`schedJoin` fill and read, sized for
// the worker count: two argument blocks (2 words each), two done words, two
// handle slots.
let argBlocks: [4]i64
let doneWords: [2]i32
let handles: [2]i64

// `poolWaitCounted`/`schedJoin` take `sleepFn` as the generic `(int) => ()`
// shape shared with the Linux twin — `parkSleepNs` no longer fits it directly
// now that it takes a caller-owned scratch (#2318), so this adapts it back
// using this thread's own scratch, which nothing else on this OS thread
// touches concurrently.
let sleepScratch: [2]i64

function sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(sleepScratch))
}

// Generous relative to the real timings (the tasks are microseconds of work, a
// worker exits as soon as it finds no work after shutdown) and small enough that
// a wedge fails the suite in seconds rather than hanging it.
const WAIT_NS: int = 15000000000

function main() {
  if (!poolInit()) {
    print("init-failed\n")
    return
  }
  let s = taskAt(poolSchedAddr())

  // Bring the pool up on two real OS threads. `poolWorkerEntry` binds the
  // no-timer/no-poller seam; `threadStart` is Darwin's spawn.
  let started = schedStart(s, poolWorkers, entryOf(poolWorkerEntry),
                           ptrOf(argBlocks), ptrOf(doneWords), ptrOf(handles),
                           threadStart)

  // Wait for the workers to drain every task, then signal shutdown so each
  // worker returns once it next finds no work.
  let counted = poolWaitCounted(sleepAdapt, parkMonoNs, WAIT_NS)
  poolShutdown()

  // Reap exactly the workers that started.
  let joined = schedJoin(started, ptrOf(doneWords), ptrOf(handles), WAIT_NS,
                         sleepAdapt, parkMonoNs, threadRelease)

  // The verdict is read only once BOTH threads are joined, so the registry count
  // it checks cannot race a worker still tearing a task down.
  let staged = started == poolWorkers && counted && joined
  print("${staged} ${poolVerdict()} ${poolTotal}\n")
}
