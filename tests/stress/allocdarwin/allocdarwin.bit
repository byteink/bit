// Darwin half of the #1362 verification: `runtime/alloc/darwin`'s page
// provider, which reaches the kernel through libSystem's `mmap` via
// `extern function` (§11.7). Apple publishes no stable syscall numbers, so a
// C call is the supported path — and Darwin's constants differ from Linux's
// (MAP_ANON is 0x1000, not 0x20) with a 16384-byte page rather than 4096.
//
// A separate program from `alloclinux` because §11.7 and §11.8 cannot coexist
// in one module — an `extern function` declaration is rejected outright when
// targeting Linux (E0078) and a `syscall` when targeting Darwin, so a single
// source form would fail to compile for BOTH. `darwin-only` marks it for the
// harness.
//
// The properties themselves come from `../alloc/props`, shared verbatim with
// the Linux program, so the two platforms are held to an identical standard.

import { pageProps, pageTotal } from "../alloc/props"
import { mapPages, unmapPages, pageSize } from "../../../runtime/alloc/darwin"

fn main() {
  print("allocdarwin pages=${pageProps(mapPages, unmapPages, pageSize)}/${pageTotal()}\n")
}
