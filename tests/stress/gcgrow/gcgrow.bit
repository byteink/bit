// The Bit heap must grow (#1638).
//
// WHAT THIS EXISTS TO CATCH. `runtime/gc`'s heap was a fixed bump arena: `boot`
// mapped 8 MiB once, `reserveTake` returned 0 the moment the bump hit its end,
// and nothing anywhere mapped another page. So the heap's capacity was a
// compile-time constant while `runtime/alloc.zig`'s — the oracle it is a port
// of — is the machine's. Four 2 MiB slices was enough to exceed it: the first
// succeeded and the rest silently came back NULL, which the compiler stores
// into without checking, so the program printed wrong answers (empty string
// interpolations, `got=0`) before eventually faulting.
//
// THE ENTIRE EXISTING SUITE WAS BLIND TO IT, and that is part of the defect.
// `tests/stress/gcbit` — the collector's differential — says so in its own
// comment: its arenas are "far more than the script needs; the point is that
// neither ever runs out". Every other program here links the ZIG runtime, which
// has no cap. Nothing asked what happens at the edge, so the edge was a cliff.
//
// So this program does the opposite of gcbit: it binds a DELIBERATELY TINY
// reserve and then allocates two orders of magnitude more than it, through both
// allocation paths, and requires every single request to succeed with intact
// contents. Pre-fix it fails on the second cycle; post-fix the reserve is a
// batching buffer over `mapPages` and the only limit is the OS.
//
// The three things it pins, each of which was independently broken:
//
//   1. THE SMALL PATH. `gcHeapAlloc` refills a size class from the span
//      reserve. Sizes below `allocMaxSmall` sweep 12 classes here and each
//      class needs its own `allocSpanBytes` (128 KiB) span, so the 256 KiB
//      reserve is spent before the first cycle finishes.
//   2. THE LARGE PATH. Anything over `allocMaxSmall` (16384) is direct-mapped.
//      It used to come out of the same reserve and was therefore capped by it
//      AND permanently unreclaimable; it now goes straight to the OS, exactly
//      as `alloc.zig`'s `allocLarge` does. The 32 KiB and 64 KiB rows below are
//      that path, and they alone total ~3.8 MiB against a 256 KiB reserve.
//   3. THE INDEX. The address->object index is sized by live object count and
//      grew out of a second fixed reserve; when that ran out `idxDisable` fired
//      and membership silently degraded to the O(objects) linear scan. The
//      2 KiB index reserve here holds 256 slots against 560 live objects, so it
//      MUST grow — `indexOk` and the entries/objects agreement on the final
//      line are what check it did.
//
// Contents are verified, not just non-null. Every word of every body is written
// with a value derived from the object's index and read back, because the
// original bug's first symptom was wrong DATA and only later a crash; a test
// that checked allocation success alone would have called it green.

import { spinUnlocked } from "../../../runtime"
import { heapInit, heapWords } from "../../../runtime/alloc"
import { gcInit, gcConfigure, gcAllocRaw, gcNumObjects, gcIndexEntries, gcIndexEnabled, gcWords, gcBindMemory, gcHeaderSize, storeWord, loadWord } from "../../../runtime/gc"

// 14 sizes, 8 bytes to 64 KiB, doubling: `allocClassify` maps the first 12 to
// distinct size classes and rejects the last two to the direct-mapped path.
const SIZES = 14
const CYCLES = 40
const OBJECTS = 560                    // SIZES * CYCLES

// The reserve is the point. 256 KiB of span reserve is two spans, so it cannot
// even give every size class one; 2 KiB of index reserve is 256 slots against
// 560 live objects. Both are ~1/20th of what the run needs.
const ARENA_WORDS = 32768
const INDEX_WORDS = 256

const MARK_STACK = 64
const MIN_TRIGGER = 4096
const GROWTH_PCT = 200

// One leaf `TypeInfo` (ABI.md §2, 7 words) plus the `ref_array_info` sentinel.
// Leaf is required: `gcAllocRaw` shares one descriptor across every body
// length, which is only sound when `scanObject` never reads `info.size`.
const MI_LEAF = 0
const MI_REFARR = 7
const META_WORDS = 14

fn writeInfo(meta: []i64, at: int, size: int, offsAddr: int, offsLen: int) {
  meta[at + 0] = size
  meta[at + 1] = offsAddr
  meta[at + 2] = offsLen
  meta[at + 3] = 0
  meta[at + 4] = 0
  meta[at + 5] = 0
  meta[at + 6] = 0
}

// Body size for row `i` of a cycle: 8 << i, i.e. 8 .. 65536.
fn sizeAt(i: int): int {
  let n = 8
  let k = 0
  while (k < i) {                      // bounded: k < SIZES
    n = n * 2
    k = k + 1
  }
  return n
}

// The word this object should hold at word offset `w`. Derived from both the
// object's ordinal and the offset so a body that is short, shifted, or aliased
// onto another object reads back wrong rather than merely different.
fn patternAt(obj: int, w: int): int {
  return obj * 1000003 + w * 7 + 1
}

fn main() {
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let state = []i64(gcWords)
  let meta = []i64(META_WORDS)
  let lock = []i32(1)
  // Every body base, held for the whole run so nothing can be reused and every
  // object stays live in the index.
  let bodies = []i64(OBJECTS)

  let metaAddr = int(ptrOf(meta))
  writeInfo(meta, MI_LEAF, 0, 0, 0)
  writeInfo(meta, MI_REFARR, 0, 0, 0)
  let leafInfo = metaAddr + MI_LEAF * 8
  let refArrInfo = metaAddr + MI_REFARR * 8

  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)
  let lp = ptrOf(lock)
  atomicStore(lp, spinUnlocked)

  let g = ptrOf(state)
  gcBindMemory(g, int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!gcInit(g, int(hp), int(hlk), int(lp), refArrInfo, MARK_STACK)) {
    print("gcgrow gcInit failed\n")
    return
  }
  gcConfigure(g, true, false, MIN_TRIGGER, GROWTH_PCT, false)

  let failedAlloc = 0
  let requested = 0

  // Allocate. Bounded: exactly CYCLES * SIZES iterations.
  let c = 0
  while (c < CYCLES) {
    let i = 0
    while (i < SIZES) {
      let obj = c * SIZES + i
      let size = sizeAt(i)
      let body = gcAllocRaw(g, size, leafInfo)
      bodies[obj] = body
      if (body == 0) {
        failedAlloc = failedAlloc + 1
      } else {
        requested = requested + size
        let w = 0
        while (w < size / 8) {         // bounded: size/8 <= 8192
          storeWord(body + w * 8, patternAt(obj, w))
          w = w + 1
        }
      }
      i = i + 1
    }
    c = c + 1
  }

  // Read every word back. Bounded: OBJECTS bodies, size/8 words each.
  let corrupt = 0
  let obj2 = 0
  while (obj2 < OBJECTS) {
    let body = bodies[obj2]
    if (body == 0) {
      obj2 = obj2 + 1
      continue
    }
    let size = sizeAt(obj2 % SIZES)
    let w = 0
    while (w < size / 8) {
      if (loadWord(body + w * 8) != patternAt(obj2, w)) {
        corrupt = corrupt + 1
        w = size / 8                   // one report per object
      }
      w = w + 1
    }
    obj2 = obj2 + 1
  }

  // Distinctness: no two objects may share a base. O(n^2) over 560 is trivial
  // and it is the check that catches a grown reserve handing out the same
  // chunk twice — the failure mode a "did every alloc return non-null" test
  // would pass with flying colours.
  let overlap = 0
  let a = 0
  while (a < OBJECTS) {
    let b = a + 1
    while (b < OBJECTS) {
      if (bodies[a] != 0 && bodies[a] == bodies[b]) {
        overlap = overlap + 1
      }
      b = b + 1
    }
    a = a + 1
  }

  let indexOk = 0
  if (gcIndexEnabled(g) && gcIndexEntries(g) == gcNumObjects(g)) {
    indexOk = 1
  }

  print("gcgrow objects=${gcNumObjects(g)} requested=${requested} failed=${failedAlloc} corrupt=${corrupt} overlap=${overlap} index=${indexOk}\n")
}
