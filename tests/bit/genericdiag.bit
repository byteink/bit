// The three diagnostics a generic call only becomes decidable for once its type
// arguments are known, as seen from outside the compiler: #2360 (argument
// count), #2243 (argument types), #2148 (map-key comparability per
// monomorphization).
//
// The property under test is that a generic is not a hole in the checker.
// `vCall` used to return the moment `declParamListNode` answered -1, so a
// generic callee escaped the spread, variadic, count AND type rules together:
//
//   function second<T>(a: T, b: T): T { return b }
//   function main() { print(second(7)) }
//
// compiled clean, ran rc=0 and printed whatever was in the second parameter's
// register. Meanwhile `std/testing`'s `eq(got: T, want: T, label: string)`
// accepted `eq(1, true, "x")` and reported `ok` — the assertion every other test
// in this repo is written with, unable to fail in the green direction. And the
// E0052 map-key rule was judged only against the key as WRITTEN, so `map<T,bool>`
// accepted `T = []int`, which is a compile error when spelled directly.
//
// WHY THIS LIVES IN tests/bit/ AND NOT tests/cases/.
//
// All three fixes make this compiler REJECT programs the pinned 0.1.5 stage0
// oracle accepts. scripts/selfhost-diffcheck.sh classifies exactly that as
// FALSEPOS and exits 1 on it, and its sweep is
//     find stdlib examples tests/cases tests/imports -name '*.bit'
// so a golden case would BE the file that turns the differential red. Measured:
// with the three cases under tests/cases/ the sweep reported MATCH=664 MISSING=0
// FALSEPOS=3 DIFF=0, and the three FALSEPOS were exactly those three files.
// The divergence is deliberate and correct — the oracle predates the fixes — but
// that script refuses known-divergence lists on principle (#1883: "a filter on a
// differential's ORACLE side can only ever hide a difference, never reveal one"),
// so adding one would be the wrong repair. tests/bit/ is not in the sweep. Same
// placement, and the same reasoning, as tests/bit/constoverflow.bit (#2261).
//
// The ACCEPT halves stay in tests/cases/ as run_generic_arg_ok.bit and
// run_map_key_generic_ok.bit: both compilers are silent on them, so they are
// MATCH, they cost the differential nothing, and they belong with the corpus.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run tests/bit/genericdiag.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; unset, the compiler under
// test is `<cwd>/bit-out/bin/bit`, resolved from a child's own `pwd` — Bit has no
// getcwd primitive, and `selfExe()` here is the throwaway binary `bit run` built,
// not the compiler that built it.
//
// ANTI-VACUITY. This gate mostly asserts that things are REJECTED, which a
// compiler that rejected everything would satisfy. So: every capture is asserted
// non-empty before any content check; every rejection asserts the diagnostic CODE
// and a needle naming the offending expression, not merely a non-zero exit; the
// accept half BUILDS AND RUNS its programs and compares stdout, so a blanket
// refusal fails here even while the reject half passes; the tables' lengths are
// asserted before their loops and the iteration counts after; and the final line
// prints how many checks actually ran.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, writeFile } from "std/fs"
import { contains, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// One `bit` invocation, as seen from outside it.
struct Run { code: int, out: string, err: string }

// Assertion accounting. A struct because Bit has no mutable module-level state,
// and the count is the anti-vacuity marker: an empty run must not read as pass.
struct Tally { checks: int, failures: int }

// One program that must be REJECTED: its source, the diagnostic code that must
// appear, and a fragment that must appear in the rendering so the diagnostic is
// pinned to this expression rather than to any refusal at all.
struct Reject { name: string, src: string, code: string, needle: string }

// One program that must still be ACCEPTED, with the stdout it must produce. The
// half that keeps the fixes from becoming "reject more".
struct Accept { name: string, src: string, want: string }

// How long any one child gets. A `bit build` of a ten-line program is well under
// a second; this only ever fires on a hang, and a hang is a failure.
function timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ { 300 }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns are
// `osRunBounded`'s mechanism channel, never a program exit status, so each one is
// a named panic rather than a value any assertion could consume.
function shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("genericdiag: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("genericdiag: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("genericdiag: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("genericdiag: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise the dev-tree build
// artifact relative to the working directory this program was started in. Never
// returns "" — a compiler this cannot find is a hard stop, not a skipped test.
function bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("genericdiag: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("genericdiag: could not read the working directory (exit ${code})")
  }
  let cwd = trimWs(readFile(cwdFile)?)
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("genericdiag: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// Runs `bit <verb> <file>` with `dir` as the working directory.
//
// The wrapper always exits 0 and writes the real status to `code.txt`, so a
// missing `code.txt` is unmistakably "the compiler never ran" rather than a
// status some assertion could mistake for a verdict. Stale captures are deleted
// first for the same reason: no case may read a previous case's output.
function runBit(bit: string, verb: string, dir: string, file: string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  clear(outPath)
  clear(errPath)
  clear(codePath)
  let script = "#!/bin/sh\n" +
    "cd '${dir}' || exit 0\n" +
    "'${bit}' ${verb} '${file}' > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/run.sh", script, ms)?
  if (sh != 0) {
    fail newError("genericdiag: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("genericdiag: no exit code was recorded for `bit ${verb} ${file}` — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

function clear(path: string) {
  if (exists(path)) {
    remove(path) catch _ { return }
  }
}

// Records one assertion. Failures are named and the run continues, so a single
// invocation reports every broken expectation instead of only the first.
function check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// `${` cannot be written literally inside a Bit string — the lexer opens an
// interpolation on it — so a GENERATED program's interpolation is assembled from
// a lone `$`, which lexes as an ordinary character.
function interp(expr: string): string {
  return "$" + "{" + expr + "}"
}

// The two-parameter generic every rejection below is written against. One type
// parameter in two positions is the shape the diagnostic exists for.
function pairDecl(): string {
  return "function pair<T>(a: T, b: T): int { return 1 }\n"
}

function secondDecl(): string {
  return "function second<T>(a: T, b: T): T { return b }\n"
}

// A generic set, the natural spelling of which puts a type parameter in a map's
// KEY position.
function dedupeDecl(): string {
  return "function dedupe<T>(xs: []T): int {\n" +
    "  let seen = map<T, bool>()\n" +
    "  for x of xs {\n" +
    "    seen[x] = true\n" +
    "  }\n" +
    "  return len(seen)\n" +
    "}\n"
}

// A body that USES the call's result, so no rejection below can pass because a
// dead statement was folded away before it was ever judged.
function useMain(callExpr: string): string {
  return "function main() {\n" +
    "  let v = " + callExpr + "\n" +
    "  print(\"" + interp("v") + "\\n\")\n" +
    "}\n"
}

// #2360 (E0050) x2, #2243 (E0041) x3 including the cross-module path through
// std/testing, #2148 (E0052) x1.
function rejects(): []Reject {
  return [
    // Too few: `return b` reads an uninitialized register. The severity case.
    Reject{ name: "arity-too-few", code: "E0050",
      src: secondDecl() + useMain("second(7)"),
      needle: "expected 2 argument(s), found 1" },
    // Too many: silently discarded.
    Reject{ name: "arity-too-many", code: "E0050",
      src: secondDecl() + useMain("second(1, 2, 3)"),
      needle: "expected 2 argument(s), found 3" },
    // T binds i64 from the first argument; the second must be judged against
    // that binding, not against the raw `T`.
    Reject{ name: "unify-bool", code: "E0041",
      src: pairDecl() + useMain("pair(1, true)"),
      needle: "found 'untyped bool'" },
    // The binding runs the other way round too: T binds string, and the i64 is
    // the offender.
    Reject{ name: "unify-string-first", code: "E0041",
      src: pairDecl() + useMain("pair(\"s\", 1.5)"),
      needle: "expected 'string'" },
    // THE TICKET'S OWN REPRO (#2243), and the one that matters most: the
    // generic is declared in ANOTHER MODULE, so the parameter node and the
    // argument node live in different trees. `eq` is the most-used function in
    // this repo's entire test corpus.
    Reject{ name: "testing-eq-cross-module", code: "E0041",
      src: "import { eq } from \"std/testing\"\n" +
        "function main() { eq(1, true, \"1 vs true\") }\n",
      needle: "found 'untyped bool'" },
    // #2148: `[]int` is not comparable (SPEC §14.6), so this key was never
    // constructible — but only the instantiation knows that.
    Reject{ name: "mapkey-slice-instantiation", code: "E0052",
      src: dedupeDecl() +
        "function main() {\n" +
        "  let a: [][]int = [[1], [1], [2]]\n" +
        "  let v = dedupe(a)\n" +
        "  print(\"" + interp("v") + "\\n\")\n" +
        "}\n",
      needle: "'[]i64'" },
  ]
}

// The acceptance set, and the reason this gate cannot pass by rejecting
// everything. Each one BUILDS AND RUNS.
function accepts(): []Accept {
  return [
    // Correct calls at three different bindings, including untyped literals
    // that must ADAPT to the binding rather than be compared against it raw.
    // Bound to locals first: a nested string literal inside an interpolation is
    // not a shape the lexer accepts, and the calls are what is under test here,
    // not the interpolation.
    Accept{ name: "pair-ok",
      src: pairDecl() + "function main() {\n" +
        "  let a = pair(1, 2)\n" +
        "  let b = pair(\"x\", \"y\")\n" +
        "  let c = pair<int>(3, 4)\n" +
        "  print(\"" + interp("a") + " " + interp("b") + " " + interp("c") + "\\n\")\n" +
        "}\n",
      want: "1 1 1\n" },
    // The same generic set at a COMPARABLE argument: E0052 must stay silent, and
    // the count must be right.
    Accept{ name: "dedupe-ok",
      src: dedupeDecl() + "function main() {\n" +
        "  print(\"" + interp("dedupe([1, 1, 2])") + "\\n\")\n}\n",
      want: "2\n" },
    // The cross-module path, used correctly. `eq` returns silently on a match,
    // so reaching the print at all is the assertion.
    Accept{ name: "testing-eq-ok",
      src: "import { eq } from \"std/testing\"\n" +
        "function main() {\n" +
        "  eq(1, 1, \"same\")\n" +
        "  eq(\"a\", \"a\", \"same\")\n" +
        "  print(\"ok\\n\")\n" +
        "}\n",
      want: "ok\n" },
  ]
}

// Every rejection case: non-zero exit, the right CODE, and the diagnostic
// pinned to this expression.
function checkRejects(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  let cases = rejects()
  check(t, len(cases) == 6, "reject table has ${len(cases)} entries, want 6")
  let ran = 0
  for c of cases {
    let file = "r_${c.name}.bit"
    writeFile("${dir}/${file}", c.src)?
    let r = runBit(bit, "check", dir, file, capDir, ms)?
    // Non-empty FIRST: every check below is satisfied by the empty string.
    check(t, len(r.err) > 0, "${c.name}: stderr is empty — the compiler said nothing")
    check(t, r.code != 0, "${c.name}: exit ${r.code}, want non-zero")
    check(t, contains(r.err, "error[${c.code}]"),
      "${c.name}: no ${c.code} in the diagnostic — got: ${r.err}")
    check(t, contains(r.err, c.needle),
      "${c.name}: diagnostic does not point at `${c.needle}` — got: ${r.err}")
    ran = ran + 1
  }
  check(t, ran == 6, "only ${ran} of 6 rejection cases ran")
}

// Every acceptance case: builds AND runs, and the stdout is compared. Running
// matters — a compiler that accepted the program and then inferred wrongly would
// pass an exit-code-only check.
function checkAccepts(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  let cases = accepts()
  check(t, len(cases) == 3, "accept table has ${len(cases)} entries, want 3")
  let ran = 0
  for c of cases {
    let file = "a_${c.name}.bit"
    writeFile("${dir}/${file}", c.src)?
    let r = runBit(bit, "run", dir, file, capDir, ms)?
    check(t, r.code == 0, "${c.name}: exit ${r.code}, want 0 — stderr: ${r.err}")
    check(t, r.out == c.want, "${c.name}: printed ${r.out}want ${c.want}")
    ran = ran + 1
  }
  check(t, ran == 3, "only ${ran} of 3 acceptance cases ran")
}

// Both halves, against a scratch directory built fresh. Split out of `main` so
// each stays inside the repo's own max-complexity limit.
function runAll(t: Tally, scratch: string, ms: int) {
  let dir = "${scratch}/src"
  let capDir = "${scratch}/cap"
  mkdir(dir) catch e { panic("genericdiag: cannot create ${dir}: ${e.message()}") }
  mkdir(capDir) catch e { panic("genericdiag: cannot create ${capDir}: ${e.message()}") }
  let bit = bitBinary(scratch, ms) catch e { panic("genericdiag: ${e.message()}") }
  checkRejects(t, bit, dir, capDir, ms) catch e { panic("genericdiag: ${e.message()}") }
  checkAccepts(t, bit, dir, capDir, ms) catch e { panic("genericdiag: ${e.message()}") }
}

function main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-genericdiag-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("genericdiag: cannot create ${scratch}: ${e.message()}")
  }
  defer teardown(scratch, ms)
  runAll(t, scratch, ms)

  // The run marker: a gate that stopped checking is visible here rather than
  // green. 6 rejections x 4 assertions + 3 acceptances x 2 + 4 table/loop
  // assertions = 34.
  if (t.checks < 34) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 34\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("genericdiag: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("genericdiag: PASS — ${t.checks} checks")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
function teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ { return }
}

// `std/strings`' `trimSpace` stops at spaces and tabs, and every capture here
// arrives newline-terminated from a shell redirect.
function trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

function isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

function trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
