// Multi-module imports + prelude guard, in Bit (port of tests/imports.zig, #1153).
//
// Every direct subdirectory of the corpus is a root module (its `main`); it may
// import project-relative modules (`./util`) and standard-library modules
// (`std/core`), and it sees the auto-imported prelude. This harness builds each
// one with the self-hosted `bit` and diffs the program's stdout against the
// project's checked-in `expected` — so cross-module lowering and the prelude can
// never silently regress.
//
// Configuration is by ENVIRONMENT, not argv: `bit run <file>` forwards no
// arguments to the program it launches (compiler/build.bit `runCmd`), so an
// argv-shaped config would read empty and this harness would run over nothing.
// Every variable is validated and a bad one is a loud failure, never a skip:
//
//   BIT_IMPORTS_DIR     absolute path to the corpus (tests/imports)   required
//   BIT_IMPORTS_BIT     absolute path to the `bit` under test         required
//   BIT_STDLIB          absolute path to stdlib/                      required
//   BIT_LIBBITRT        absolute path to the target's libbitrt.a      required
//   BIT_IMPORTS_FILTER  run one named project (must match exactly)    optional
//   BIT_TEST_TIMEOUT_S  per-child wall clock, default 300             optional
//
// WHY A SHELL WRAPPER. `osRunBounded` (ABI.md §19) is the only bounded child
// wait Bit has, and it takes a path and nothing else — no argv, no env, no
// stdout capture. So each case gets two generated `/bin/sh` scripts, and the
// shell supplies the three missing pieces, plus (below) its own parallelism —
// see `writeScripts` and `driverScript`.
//
// `bit_rt_os_run_bounded` IS STILL NOT RE-ENTRANT, and nothing here changes
// that (#2508 does not touch it — that is `runtime/root/**`, a mandatory-full-
// suite change, and out of scope). Its child argv, wait-status cell and
// timespec scratch are module-level and unlocked (`osArgvBuf`, `osStatusBuf`,
// `osChildEnvp`, `osIdxBuf`, `osClockBuf` in
// `runtime/root/{linux,darwin}/os.bit`), sound only under the single-worker
// contract — "a `run` fully completes (fork through wait) before any other
// `run` can begin". A `spawn`ed pool of green threads each calling it would
// race on that shared state.
//
// So the concurrency lives in the SHELL instead, which this harness already
// delegated env/argv/stdout capture to. This file now makes exactly ONE
// `osRunBounded` call, for every case combined, on one generated driver
// script — and the driver, not Bit green threads, is what fans out:
// `find | xargs -P` does in the shell exactly what a re-entrant
// `osRunBounded` would otherwise have had to do inside the runtime.
//
// TWO WAVES, BARRIERED, NOT ONE. `fork` duplicates the fd table, so a child
// spawned while another process still holds a write fd open to some binary
// inherits it, and a later `execve` of that inode fails with ETXTBSY — a
// real, already-paid-for bug (74811a3). A serial harness has no such window;
// a parallel one does, UNLESS every compile's write fd is closed before any
// run forks at all. So the driver runs `find …compile.sh | xargs -P …` to
// COMPLETION — `xargs` blocks until every parallel invocation it started has
// exited — before it even starts the second `find …run.sh | xargs -P …`. One
// script, two statements in sequence, is the whole barrier. Collapsing that
// into a single wave (compile-then-run per job) would reopen exactly the
// window 74811a3 closed.
//
// PER-CASE DEADLINES MOVE INTO THE GENERATED SCRIPTS THEMSELVES. The outer
// `osRunBounded` bound is now GLOBAL — it covers the whole driver, both
// waves, every case — so `BIT_TEST_TIMEOUT_S` can no longer be enforced by
// `osRunBounded` per case. Each generated script instead backgrounds its own
// work, races it against a `sleep $T; kill -9` watchdog, and reports the
// result through a `.rc` file (`decodeRc`/`readRcFile`) rather than through
// an `osRunBounded` return value — which now describes only the driver as a
// whole (`decode`, called exactly once, on the single outer call).
//
// This file deliberately uses only universe builtins (ABI boundary primitives)
// and no `std/*` import, so it runs under a bare `bit run` with no BIT_STDLIB
// needed to compile the harness itself.

// The corpus size this gate refuses to run below. The Zig original had only an
// UPPER bound (`scanned < max_programs`) and an explicit `if (cases.len == 0)
// return` — an empty corpus was a green pass. A floor is the whole difference
// between a gate and a decoration: raise it when projects are added.
const caseFloor: int = 99

// Upper bound on directory entries examined (Power of 10 rule 2).
const maxEntries: int = 4096

const defaultTimeoutS: int = 300

// The outer `osRunBounded` call now spans the WHOLE driver (every case, both
// waves) instead of one case, so its bound must be generous rather than
// tight — the per-case watchdog each generated script carries is what stays
// tight (`BIT_TEST_TIMEOUT_S`). `2 *` covers two full waves at the fully
// serial worst case (parallelism only ever finishes sooner than that); this
// slack absorbs `find`/`xargs`/process-startup overhead on top of it.
const outerSlackMs: int = 60000

// 0o755 — the scripts must be executable by the `fork`+`execve` in `xargs`
// (phase B) and, for the driver itself, in `osRunBounded`.
const scriptMode: int = 493

struct Cfg {
  corpus: string
  bitExe: string
  stdlib: string
  libbitrt: string
  filter: string
  timeoutMs: int
}

struct Case {
  name: string
  dir: string
  expected: string
  compileSh: string
  runSh: string
  bin: string
  log: string
  out: string
  err: string
  // Written by `compileSh`/`runSh` themselves (`echo "$rc" > …`), since phase
  // B no longer makes a per-case `osRunBounded` call whose return value could
  // carry this instead.
  compileRc: string
  runRc: string
}

// Per-case verdict. `reason` empty means the case passed; `detail` is the
// evidence (compiler log, captured stderr, or the two sides of a mismatch).
struct Verdict {
  reason: string
  detail: string
}

struct Text {
  ok: bool
  data: string
}

// --- small utilities (no std/*, no prelude) --------------------------------

function readWhole(path: string): Text {
  let fd = fsOpen(path, false)
  if (fd < 0) {
    return Text{ ok: false, data: "" }
  }
  let s = fsReadAll(fd)
  fsClose(fd)
  return Text{ ok: true, data: s }
}

function writeWhole(path: string, content: string): bool {
  let fd = fsOpen(path, true)
  if (fd < 0) {
    return false
  }
  let n = fsWrite(fd, content)
  fsClose(fd)
  return n >= 0
}

// Byte-wise `a < b`, so a listing is reproducible across filesystems.
function lessStr(a: string, b: string): bool {
  let n = len(a)
  if (len(b) < n) {
    n = len(b)
  }
  let i = 0
  while (i < n) {
    if (a[i] != b[i]) {
      return a[i] < b[i]
    }
    i = i + 1
  }
  return len(a) < len(b)
}

function sortStrings(xs: []string): []string {
  let i = 1
  while (i < len(xs)) {
    let j = i
    while (j > 0 && lessStr(xs[j], xs[j - 1])) {
      let t = xs[j - 1]
      xs[j - 1] = xs[j]
      xs[j] = t
      j = j - 1
    }
    i = i + 1
  }
  return xs
}

// `fsListDir` returns entries NUL-separated: NUL is the one byte a POSIX
// filename cannot contain.
function splitNul(raw: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw) && len(out) < maxEntries) {
    if (raw[i] == 0) {
      if (i > start) {
        out = append(out, raw[start:i])
      }
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// Digits only, and short enough that `v * 10` cannot overflow i64.
const maxIntDigits: int = 9

function parseNonNegInt(s: string): int {
  if (len(s) == 0 || len(s) > maxIntDigits) {
    return -1
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < 48 || c > 57) {
      return -1
    }
    v = v * 10 + int(c) - 48
    i = i + 1
  }
  return v
}

// A path is interpolated into a double-quoted shell word, so anything the shell
// would still expand or terminate there must be rejected outright rather than
// quoted around. Rejecting is safe: every real path in this repo is plain.
function shSafe(s: string): bool {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == 34 || c == 36 || c == 96 || c == 92 || c == 10 || c == 13 || c == 0) {
      return false
    }
    i = i + 1
  }
  return true
}

function fatal(msg: string) {
  eprint("imports: FAIL ${msg}\n")
  osExit(1)
}

// --- configuration ---------------------------------------------------------

// Every path must be ABSOLUTE. A relative corpus path resolved against whatever
// CWD the harness happens to inherit is the single most likely way this gate
// goes silently vacuous — `fsListDir` on a missing directory yields nothing,
// which without this check reads as "0 failed".
function requireDir(name: string): string {
  let v = osEnv(name)
  if (len(v) == 0) {
    fatal("${name} is unset; it must be an absolute directory path")
  }
  if (v[0] != 47) {
    fatal("${name}='${v}' is not absolute")
  }
  if (!fsIsDir(v)) {
    fatal("${name}='${v}' is not a directory")
  }
  if (!shSafe(v)) {
    fatal("${name}='${v}' contains a character this harness will not put in a shell word")
  }
  return v
}

function requireFile(name: string): string {
  let v = osEnv(name)
  if (len(v) == 0) {
    fatal("${name} is unset; it must be an absolute file path")
  }
  if (v[0] != 47) {
    fatal("${name}='${v}' is not absolute")
  }
  if (!fsExists(v) || fsIsDir(v)) {
    fatal("${name}='${v}' is not a file")
  }
  if (!shSafe(v)) {
    fatal("${name}='${v}' contains a character this harness will not put in a shell word")
  }
  return v
}

function loadConfig(): Cfg {
  let corpus = requireDir("BIT_IMPORTS_DIR")
  let bitExe = requireFile("BIT_IMPORTS_BIT")
  let stdlib = requireDir("BIT_STDLIB")
  let libbitrt = requireFile("BIT_LIBBITRT")

  let secs = defaultTimeoutS
  let raw = osEnv("BIT_TEST_TIMEOUT_S")
  if (len(raw) != 0) {
    let parsed = parseNonNegInt(raw)
    if (parsed <= 0) {
      // The Zig harness reads 0 as "block forever". There is no unbounded form
      // of `osRunBounded`, and a 0 ms budget would kill every child instantly,
      // so an unusable value is refused instead of silently reinterpreted.
      fatal("BIT_TEST_TIMEOUT_S='${raw}' is not a positive integer")
    }
    secs = parsed
  }

  let filter = osEnv("BIT_IMPORTS_FILTER")
  if (len(filter) != 0 && !shSafe(filter)) {
    fatal("BIT_IMPORTS_FILTER='${filter}' is not a plain name")
  }

  return Cfg{ corpus: corpus, bitExe: bitExe, stdlib: stdlib, libbitrt: libbitrt,
    filter: filter, timeoutMs: secs * 1000 }
}

// --- discovery -------------------------------------------------------------

function discover(cfg: Cfg, scratch: string): []Case {
  let names = sortStrings(splitNul(fsListDir(cfg.corpus)))
  let dirs = []string(0)
  let i = 0
  while (i < len(names)) {
    let n = names[i]
    if (fsIsDir("${cfg.corpus}/${n}")) {
      dirs = append(dirs, n)
    }
    i = i + 1
  }

  if (len(cfg.filter) != 0) {
    let kept = []string(0)
    let j = 0
    while (j < len(dirs)) {
      if (dirs[j] == cfg.filter) {
        kept = append(kept, dirs[j])
      }
      j = j + 1
    }
    if (len(kept) == 0) {
      fatal("BIT_IMPORTS_FILTER='${cfg.filter}' matched no project under ${cfg.corpus}")
    }
    dirs = kept
  } else if (len(dirs) < caseFloor) {
    fatal("discovered ${len(dirs)} project(s) under ${cfg.corpus}, below the floor of ${caseFloor} — the corpus is wrong or has shrunk")
  }

  let cases = []Case(0)
  let k = 0
  while (k < len(dirs)) {
    let name = dirs[k]
    if (!shSafe(name)) {
      fatal("project name '${name}' is not a plain name")
    }
    let dir = "${cfg.corpus}/${name}"
    // Fail, never skip. A missing `main.bit` or a missing/empty `expected` is
    // how 96 cases turn into 0 with no change in the output.
    if (!fsExists("${dir}/main.bit")) {
      fatal("project '${name}' has no main.bit")
    }
    let exp = readWhole("${dir}/expected")
    if (!exp.ok) {
      fatal("project '${name}' has no readable 'expected' file")
    }
    if (len(exp.data) == 0) {
      fatal("project '${name}' has an EMPTY 'expected' file; an empty comparison proves nothing")
    }
    let base = "${scratch}/${name}"
    cases = append(cases, Case{ name: name, dir: dir, expected: exp.data,
      compileSh: "${base}.compile.sh", runSh: "${base}.run.sh", bin: "${base}.bin",
      log: "${base}.log", out: "${base}.out", err: "${base}.err",
      compileRc: "${base}.compile.rc", runRc: "${base}.run.rc" })
    k = k + 1
  }
  return cases
}

// --- phase A: write every script, fork nothing -----------------------------

function writeScripts(cfg: Cfg, cases: []Case) {
  let i = 0
  while (i < len(cases)) {
    let c = cases[i]
    // Each script backgrounds its real work (`cmd &`) and captures that exact
    // child's pid in `$p`, then races it against a `sleep $T; kill -9`
    // watchdog running as a second background job (`$w`) — the per-job
    // deadline a shared wave now needs, since a whole wave of cases goes
    // through one outer `osRunBounded` call rather than one each. `wait "$p"`
    // reports that specific child's status (128+9=137 on our own SIGKILL,
    // since nothing else in this closed system sends it, which is what
    // `decodeRc` below reads back out of the `.rc` file). `kill "$w"` reaps
    // the watchdog once the real work is done so it does not outlive the
    // script. No `exec`: the backgrounded command is already the direct
    // child (no wrapping shell to hand status through), and control has to
    // return to THIS script afterward to write the `.rc` file.
    let compile = "#!/bin/sh\nexport BIT_STDLIB=\"${cfg.stdlib}\"\nexport BIT_LIBBITRT=\"${cfg.libbitrt}\"\n\"${cfg.bitExe}\" build \"${c.dir}\" -o \"${c.bin}\" >\"${c.log}\" 2>&1 &\np=$!\n( sleep ${cfg.timeoutMs / 1000}; kill -9 \"$p\" 2>/dev/null ) &\nw=$!\nwait \"$p\"\nrc=$?\nkill \"$w\" 2>/dev/null\necho \"$rc\" > \"${c.compileRc}\"\nexit \"$rc\"\n"
    // BIT_SELF_EXE is a real coupling, not decoration: tests/imports/pmadd_e2e
    // execs the compiler that built it (`bit add`) and panics without it. The
    // shell also hands the child the full inherited environment, which that
    // case's git/HOME/PATH usage needs.
    let run = "#!/bin/sh\nexport BIT_SELF_EXE=\"${cfg.bitExe}\"\n\"${c.bin}\" >\"${c.out}\" 2>\"${c.err}\" &\np=$!\n( sleep ${cfg.timeoutMs / 1000}; kill -9 \"$p\" 2>/dev/null ) &\nw=$!\nwait \"$p\"\nrc=$?\nkill \"$w\" 2>/dev/null\necho \"$rc\" > \"${c.runRc}\"\nexit \"$rc\"\n"
    if (!writeWhole(c.compileSh, compile) || fsChmod(c.compileSh, scriptMode) != 0) {
      fatal("cannot write compile script for '${c.name}' at ${c.compileSh}")
    }
    if (!writeWhole(c.runSh, run) || fsChmod(c.runSh, scriptMode) != 0) {
      fatal("cannot write run script for '${c.name}' at ${c.runSh}")
    }
    i = i + 1
  }
}

// --- phase B: one shell driver, two barriered waves -------------------------

// The whole fan-out. `-print0`/`-0` so a case name can never be split by
// `xargs`'s default whitespace/newline delimiting (case names are validated
// plain by `shSafe`, but that does not rule out a space). `sh -c 'exec "$0"'`
// treats each found path as the command to run — the scripts phase A wrote
// are directly executable, so this is the standard portable idiom for
// "execute every file `find` names", and it works identically with `-P`
// (parallel) on both GNU and BSD (macOS) `xargs`, unlike `-I`.
//
// The barrier IS the ordering: the first `find | xargs -P` line runs to
// completion — `xargs` does not return until every parallel invocation it
// started has exited — before the second line's `find | xargs -P` starts a
// single fork. See the header comment for why that barrier is the whole
// ETXTBSY defense.
//
// `rc1`/`rc2` capture each wave's `xargs` exit status on its own line, not
// discarded and not `||true`'d away: nonzero means at least one case's script
// itself exited nonzero. That is expected and not fatal here — `gradeCase`
// below is what names the specific case — but the driver still exits 1 in
// that case (rather than swallowing it into an unconditional 0) so the
// caller in `main` can read it back and, if `gradeCase` found NO failing case
// at all despite `xargs` reporting one, treat that contradiction as its own
// fatal error.
function driverScript(scratch: string): string {
  return "#!/bin/sh\nN=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)\nfind \"${scratch}\" -maxdepth 1 -name '*.compile.sh' -print0 | xargs -0 -P \"$N\" -n1 sh -c 'exec \"$0\"'\nrc1=$?\nfind \"${scratch}\" -maxdepth 1 -name '*.run.sh' -print0 | xargs -0 -P \"$N\" -n1 sh -c 'exec \"$0\"'\nrc2=$?\nif [ \"$rc1\" -eq 0 ] && [ \"$rc2\" -eq 0 ]; then\n  exit 0\nfi\nexit 1\n"
}

// ABI.md §19: `>= 0` exit code, `-1` spawn failure, `-2` deadline, `<= -100`
// signalled with the number at `-(r) - 100`. Every negative sentinel passes a
// naive `if (code > 0)`, so a hung or SIGSEGV'd case would read as a pass; each
// gets its own named outcome instead. Used exactly once now, on the single
// outer `osRunBounded` call over the whole driver script — per-case results no
// longer come from here, see `decodeRc`.
function decode(r: int, what: string): string {
  if (r == 0) {
    return ""
  }
  if (r > 0) {
    return "${what} exited ${r}"
  }
  if (r == -1) {
    return "${what} SPAWN FAILED"
  }
  if (r == -2) {
    return "${what} TIMED OUT"
  }
  if (r <= -100) {
    return "${what} KILLED by signal ${0 - r - 100}"
  }
  return "${what} unknown osRunBounded result ${r}"
}

// Reads a `.rc` file the way `wait "$p"; rc=$?` fills it: a POSIX wait status
// in 0..255, where a process killed by signal N reads back as `128 + N` — so
// `137` means SIGKILL, and 9 is the only signal anything in this harness ever
// sends (the per-case watchdog in `writeScripts`). A missing, empty, or
// unparsable file (the script never reached its own `echo`, or never ran at
// all) composes into `parseNonNegInt`'s existing `-1` sentinel with no extra
// branching: `readWhole` on a missing path already returns empty data.
function readRcFile(path: string): int {
  let s = readWhole(path).data
  if (len(s) != 0 && s[len(s) - 1] == 10) {
    s = s[0:len(s) - 1]
  }
  return parseNonNegInt(s)
}

// Mirrors `decode` above but reads the `.rc`-file encoding instead of an
// `osRunBounded` sentinel: there is no `-1`/`-2` here, because phase B no
// longer makes a bounded call per case. A negative `rc` (from `readRcFile`)
// means the file never got written at all, which this harness treats the same
// as any other failure — never as a pass.
function decodeRc(rc: int, what: string): string {
  if (rc == 0) {
    return ""
  }
  if (rc < 0) {
    return "${what} produced no exit status (script did not run to completion)"
  }
  if (rc == 137) {
    return "${what} TIMED OUT"
  }
  if (rc > 128) {
    return "${what} KILLED by signal ${rc - 128}"
  }
  return "${what} exited ${rc}"
}

// --- phase C: grade every case from its .rc files ---------------------------

// Two separate `.rc` files, not one combined script, so a compile failure and
// a run failure stay distinguishable exactly as they did when this read two
// separate `osRunBounded` calls.
function gradeCase(c: Case): Verdict {
  let cr = decodeRc(readRcFile(c.compileRc), "compile")
  if (len(cr) != 0) {
    return Verdict{ reason: cr, detail: readWhole(c.log).data }
  }
  if (!fsExists(c.bin)) {
    return Verdict{ reason: "compile produced no binary", detail: readWhole(c.log).data }
  }
  let rr = decodeRc(readRcFile(c.runRc), "run")
  if (len(rr) != 0) {
    return Verdict{ reason: rr, detail: readWhole(c.err).data }
  }
  let got = readWhole(c.out)
  if (!got.ok) {
    // Both sides failing to read must never compare equal — that is how a
    // harness that executed nothing reports every case as matching.
    return Verdict{ reason: "no stdout captured", detail: "expected ${c.out} to exist" }
  }
  if (got.data != c.expected) {
    return Verdict{ reason: "output mismatch",
      detail: "  expected: ${c.expected}\n  got:      ${got.data}" }
  }
  return Verdict{ reason: "", detail: "" }
}

// --- cleanup + report ------------------------------------------------------

function cleanup(scratch: string, cases: []Case, driverSh: string) {
  let i = 0
  while (i < len(cases)) {
    let c = cases[i]
    fsRemove(c.compileSh)
    fsRemove(c.runSh)
    fsRemove(c.compileRc)
    fsRemove(c.runRc)
    fsRemove(c.bin)
    fsRemove(c.log)
    fsRemove(c.out)
    fsRemove(c.err)
    i = i + 1
  }
  fsRemove(driverSh)
  fsRemove(scratch)
}

function scratchRoot(): string {
  let base = osEnv("TMPDIR")
  if (len(base) == 0) {
    base = "/tmp"
  }
  if (base[len(base) - 1] == 47) {
    base = base[0:len(base) - 1]
  }
  return "${base}/bit-importsrun-${timeUnixNs()}"
}

struct DriverRun {
  driverSh: string
  result: int
}

// Phase B: writes the driver script and makes the ONE outer `osRunBounded`
// call for the whole corpus — see the header comment for why the bound is
// generous and why the barrier between its two waves must stay a barrier.
// Each per-case script already carries its OWN `BIT_TEST_TIMEOUT_S` watchdog,
// so this outer bound only exists to catch the driver itself getting stuck
// (`find`, `xargs`, or the shell never returning at all); a case that merely
// runs slowly, even every case at once, is exactly what `2 *` plus
// `outerSlackMs` is sized to absorb. Fatal only for the driver's OWN
// process-level failure — a plain exit of 1 means at least one case's script
// itself returned nonzero, which `gradeAll`/`gradeCase` are what name; a
// spawn failure, the outer deadline firing, or a signal has no single case to
// attribute it to, because the driver never ran at all or got stuck as a
// whole.
function runDriver(cfg: Cfg, scratch: string, caseCount: int): DriverRun {
  let driverSh = "${scratch}/driver.sh"
  if (!writeWhole(driverSh, driverScript(scratch)) || fsChmod(driverSh, scriptMode) != 0) {
    fatal("cannot write driver script at ${driverSh}")
  }
  let outerTimeoutMs = 2 * caseCount * cfg.timeoutMs + outerSlackMs
  let result = osRunBounded(driverSh, outerTimeoutMs)
  if (result != 0 && result != 1) {
    fatal("imports driver: ${decode(result, "driver")}")
  }
  return DriverRun{ driverSh: driverSh, result: result }
}

struct Report {
  failed: int
  summary: string
}

// Phase C: grades every case and prints each failure as it is found.
function gradeAll(cases: []Case): Report {
  let failed = 0
  let summary = ""
  let i = 0
  while (i < len(cases)) {
    let v = gradeCase(cases[i])
    if (len(v.reason) != 0) {
      failed = failed + 1
      summary = "${summary} ${cases[i].name}(${v.reason})"
      eprint("imports '${cases[i].name}': ${v.reason}\n")
      if (len(v.detail) != 0) {
        eprint("${v.detail}\n")
      }
    }
    i = i + 1
  }
  return Report{ failed: failed, summary: summary }
}

function main() {
  let cfg = loadConfig()

  let scratch = scratchRoot()
  if (!shSafe(scratch)) {
    fatal("scratch path '${scratch}' is not shell-safe")
  }

  // Discovery only composes path STRINGS, so the directory is created after it
  // — a config or corpus failure then leaves nothing behind to clean up, and
  // `fatal` needs no unwinding of its own.
  let cases = discover(cfg, scratch)
  print("imports: discovered ${len(cases)} cases under ${cfg.corpus}\n")

  if (fsMkdir(scratch) < 0) {
    fatal("cannot create scratch directory ${scratch}")
  }
  writeScripts(cfg, cases)

  let driver = runDriver(cfg, scratch, len(cases))
  let report = gradeAll(cases)

  // `driver.result` is `xargs`'s own verdict, read here rather than
  // discarded: if it reported a failing case (1) but every case above graded
  // clean, the `.rc`-file bookkeeping itself is broken — some case's script
  // failed by `xargs`'s own account with nothing in this harness able to say
  // which one, which is worse than any single named failure and must not
  // report as 0 failed.
  if (report.failed == 0 && driver.result == 1) {
    fatal("imports driver: xargs reported a failing case script, but no case graded as failed — the .rc bookkeeping is broken")
  }

  cleanup(scratch, cases, driver.driverSh)

  print("imports: ${len(cases) - report.failed}/${len(cases)} OK\n")
  if (report.failed != 0) {
    eprint("imports: FAILED:${report.summary}\n")
    osExit(1)
  }
}
