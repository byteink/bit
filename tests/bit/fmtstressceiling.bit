// #3702: `tests/stress/` sits under NO `bit fmt --check` gate — neither
// `test-fmt` (tools/build/gates.bit, stdlib/+examples/+pkg/+bench/+editors/
// as of #3699/#3700/#3701) nor `test-fmt-ceiling` (tests/bit/fmtceiling.bit,
// compiler/+runtime/+tools/) reaches it.
//
// `tests/stress/` cannot be a HARD ZERO like `test-fmt`: measured fresh on
// this branch, it is 65 unformatted of 117 `.bit` files — real pre-existing
// debt, not something this ticket owes to clear. So this copies
// `fmtimportsceiling.bit`'s ratchet shape (#3693, itself modelled on
// `fmtceiling.bit`'s, #3670/#3654, itself modelled on `lintself.bit`'s
// lint-count ratchet, epic #2354): going over the recorded ceiling in
// `tools/build/fmt-ceiling-stress.txt` fails; going under it passes and
// names the lower number a human could ratchet it down to. This gate never
// runs `bit fmt -w` and never rewrites either data file.
//
// A SEPARATE small harness rather than widening `fmtceiling.bit` or
// `fmtimportsceiling.bit`, for the same two reasons #3693 gave: first,
// neither `tools/build/fmt-ceiling.txt` (owned by #3632) nor
// `tools/build/fmt-ceiling-imports.txt` (owned by #3693) should gain a
// fourth/second tree from an unrelated ticket. Second, this repo already
// keeps overlapping-but-distinct `bit lint` and `bit fmt` ratchets as
// separate small harnesses rather than one parameterized megagate
// (`test-lint-runtime`, `test-lint-filelines`, `test-lint-self`,
// `test-lint-sweep`, `test-fmt-ceiling`, `test-fmt-imports-ceiling` are six
// files, not one) — this follows the same precedent rather than inventing a
// new shape.
//
// `tests/stress/` was checked and does NOT carry #3543's `bit lint`
// all-or-nothing-per-invocation hazard: `bit fmt --check`'s own
// implementation (compiler/fmtcmd.bit's `fmtOneFile`) is per-file
// independent by design ("Every path is independent, so the caller keeps
// going after a failure (gofmt's contract)"). `tests/stress/` itself has
// zero deliberately-malformed fixtures (it is a corpus of runnable stress
// programs, not a rejection corpus), confirmed by the absence of any
// `error[...]` diagnostic in a full scan. So this harness's strict per-line
// parse below (a bare `.bit` path or nothing) is safe here without having
// to tolerate diagnostic blocks the way a gate over `tests/bit/` or
// `tests/cases/` would.
//
// BIT_REPO IS REQUIRED, same reason as every sibling in this directory: the
// harness points `bit fmt --check` at `${BIT_REPO}/tests/stress` and reads
// `${BIT_REPO}/tools/build/fmt-ceiling-stress.txt` — it must not silently
// default to ".".
//
// Run it from the repository root:
//     ./bit-out/bin/bit run tests/bit/fmtstressceiling.bit
import { env, envOr, exit } from "std/os"
import { exists, isDir, mkdir, readDir, readFile, writeFile } from "std/fs"
import { hasPrefix, hasSuffix, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Bounds on the independent file-count walk below — Power of 10 rule 2.
const maxEntries: int = 4096
const maxScanDepth: int = 16

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("fmtstressceiling: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("fmtstressceiling: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("fmtstressceiling: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("fmtstressceiling: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("fmtstressceiling: ${name} is required and was not set")
  }
  return v
}

// One `bit fmt --check <dir>` invocation, as seen from outside it.
class Run { code: int, err: string }

fn runFmtCheck(bit: string, dir: string, capDir: string, ms: int): Run! {
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' fmt --check '${dir}' > /dev/null 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/fmt.sh", script, ms)?
  if (sh != 0) {
    fail newError("fmtstressceiling: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("fmtstressceiling: no exit code was recorded — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, err: readFile(errPath)? }
}

// `r` is a usable observation of a real run. `bit fmt --check` prints
// NOTHING when a tree is fully canonical, so an empty stderr is only
// trustworthy paired with exit 0; either exit 1 with empty stderr or exit 0
// with nonempty stderr means this harness's own invocation is not behaving
// the way `fmtCmd` is documented to, and it is safer to stop than to guess a
// count.
fn assertTrustworthy(r: Run, dir: string) {
  if (r.code != 0 && r.code != 1) {
    panic("fmtstressceiling: `bit fmt --check ${dir}` exited ${r.code}, want 0 or 1")
  }
  if (r.code == 0 && len(r.err) > 0) {
    panic("fmtstressceiling: `bit fmt --check ${dir}` exited 0 but wrote to stderr:\n${r.err}")
  }
  if (r.code == 1 && len(r.err) == 0) {
    panic("fmtstressceiling: `bit fmt --check ${dir}` exited 1 but stderr is empty — untrustworthy run")
  }
}

// Every nonblank stderr line from a clean `tests/stress/` scan is the bare
// repo-relative-once-stripped path of an unformatted file
// (compiler/fmtcmd.bit's `fmtOneFile`: `eprint("${path}\n")`, checkOnly
// path). Anything else — a `bit fmt: ...`-prefixed diagnostic or a parse
// error block from a malformed fixture — fails loudly rather than being
// silently folded into "0 findings": see the header for why `tests/stress/`
// is not expected to contain either, and why this gate must not guess if
// that ever stops being true.
fn parseUnformatted(err: string, repo: string): []string! {
  let out = []string(0)
  let prefix = "${repo}/"
  for line of split(err, "\n") {
    if (len(trimSpace(line)) == 0) {
      continue
    }
    if (hasPrefix(line, "bit fmt: ")) {
      fail newError("fmtstressceiling: unexpected `bit fmt` diagnostic: ${line}")
    }
    if (!hasSuffix(line, ".bit")) {
      fail newError("fmtstressceiling: unrecognized `bit fmt --check` output line: ${line}")
    }
    if (!hasPrefix(line, prefix)) {
      fail newError("fmtstressceiling: unformatted path outside ${repo}: ${line}")
    }
    out = append(out, line[len(prefix):])
  }
  return out
}

// Parses tools/build/fmt-ceiling-stress.txt: a single `stress <count>`
// line. A human edits this file to lower the ceiling; this gate reads it and
// never writes it (mirrors fmtimportsceiling.bit's / lintself.bit's
// contract).
fn parseCeilingFile(text: string): int! {
  let seen = map<string, int>{}
  for rawLine of split(text, "\n") {
    let line = trimSpace(rawLine)
    if (len(line) == 0) {
      continue
    }
    let fields = split(line, " ")
    if (len(fields) != 2) {
      fail newError("fmtstressceiling: malformed fmt-ceiling-stress.txt line: '${line}'")
    }
    if (fields[0] != "stress") {
      fail newError("fmtstressceiling: unknown scope '${fields[0]}' in fmt-ceiling-stress.txt")
    }
    let n = parseInt(fields[1])?
    seen[fields[0]] = n
  }
  let (stress, ok) = seen["stress"]
  if (!ok) {
    fail newError("fmtstressceiling: fmt-ceiling-stress.txt must have a 'stress <n>' line")
  }
  return stress
}

fn loadCeiling(repo: string): int! {
  let path = "${repo}/tools/build/fmt-ceiling-stress.txt"
  if (!exists(path)) {
    fail newError("fmtstressceiling: no ceiling file at ${path}")
  }
  return parseCeilingFile(readFile(path)?)?
}

// The count of `.bit` files anywhere beneath `dir` — an independent walk used
// only as the anti-vacuity denominator (see header). Bounded by
// `maxScanDepth` (Power of 10 rule 2), not merely documented as such.
fn countBitFiles(dir: string, depth: int): int {
  if (depth <= 0) {
    panic("fmtstressceiling: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("fmtstressceiling: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("fmtstressceiling: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  let n = 0
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      n = n + countBitFiles(path, depth - 1)
    } else if (hasSuffix(name, ".bit")) {
      n = n + 1
    }
  }
  return n
}

// The full verdict for `tests/stress/`: the independently walked `.bit`
// file count, and the unformatted files that count against the ceiling.
class TreeResult { filesTotal: int, files: []string }

fn scanTree(bit: string, repo: string, capDir: string, ms: int): TreeResult {
  let full = "${repo}/tests/stress"
  if (!exists(full)) {
    panic("fmtstressceiling: no such directory: ${full}")
  }
  let filesTotal = countBitFiles(full, maxScanDepth)
  if (filesTotal == 0) {
    panic("fmtstressceiling: ${full} contains zero .bit files — refusing a vacuous scan")
  }
  let r = runFmtCheck(bit, full, capDir, ms) catch e {
    panic("fmtstressceiling: ${e.message()}")
  }
  assertTrustworthy(r, full)
  let unformatted = parseUnformatted(r.err, repo) catch e {
    panic("fmtstressceiling: ${e.message()}")
  }
  return TreeResult{ filesTotal: filesTotal, files: unformatted }
}

fn printFiles(files: []string) {
  eprint("  tests/stress unformatted file(s) counted against the ceiling:\n")
  for f of files {
    eprint("    ${f}\n")
  }
}

// The verdict. Returns true when the gate FAILS.
fn reportTree(tr: TreeResult, ceiling: int): bool {
  let total = len(tr.files)
  if (total > ceiling) {
    eprint("fmt-stress-ceiling: FAIL -- tests/stress reports ${total} unformatted file(s) (of ${tr.filesTotal} scanned), ceiling is ${ceiling} (tools/build/fmt-ceiling-stress.txt) -- grew by ${total - ceiling}.\n")
    printFiles(tr.files)
    return true
  }
  if (total < ceiling) {
    println("fmt-stress-ceiling: tests/stress ${total} unformatted of ${tr.filesTotal} .bit file(s) scanned (ceiling ${ceiling}) -- PASS. Lower the ceiling to ${total} in tools/build/fmt-ceiling-stress.txt once reviewed.")
    return false
  }
  println("fmt-stress-ceiling: tests/stress ${total} unformatted of ${tr.filesTotal} .bit file(s) scanned (ceiling ${ceiling}) -- PASS.")
  return false
}

fn newCapDir(): string {
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  return "${tmp}/bit-fmtstressceiling-${uuidFormat(uuidV4())}"
}

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ {
    return
  }
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE") catch e {
    panic("fmtstressceiling: ${e.message()}")
  }
  let repo = requiredEnv("BIT_REPO") catch e {
    panic("fmtstressceiling: ${e.message()}")
  }
  let ceiling = loadCeiling(repo) catch e {
    panic("fmtstressceiling: ${e.message()}")
  }

  let capDir = newCapDir()
  mkdir(capDir) catch e {
    panic("fmtstressceiling: cannot create ${capDir}: ${e.message()}")
  }
  defer teardown(capDir, ms)

  let result = scanTree(bit, repo, capDir, ms)
  if (reportTree(result, ceiling)) {
    eprint("fmt-stress-ceiling: ceiling lives in tools/build/fmt-ceiling-stress.txt; a human lowers it, this gate never does.\n")
    exit(1)
  }
  println("fmt-stress-ceiling: PASS")
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
