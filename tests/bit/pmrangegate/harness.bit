// tests/bit/pmrangegate/harness.bit — the git-fixture, CLI-driving and
// bit.lock/bit.json verification plumbing for tests/bit/pmrangegate/
// scenarios.bit (#2369, epic #2362). Split from a single pmrangegate.bit
// (originally 785 lines) once formatting it pushed the file past the
// 800-line E0200 ceiling while the tree-wide `tests/bit` fmt ratchet
// (tools/build/fmt-ceiling-testsbit.txt) demanded it be formatted at all —
// two ceilings in tension, resolved by splitting rather than by skipping
// either one.
//
// `tests/bit/*.bit` files are normally each their own standalone
// compilation unit (no imports between them — see e.g.
// tests/bit/pmimports.bit's header). A DIRECTORY under tests/bit/ is
// different: `bit run <dir>` builds every `.bit` file in it as ONE module
// (`bit run <file>` builds only that file — verified directly: a sibling
// function is `E0040: undefined name ... build the directory rather than
// the file`). So this directory's two files share one flat, name-keyed
// scope exactly like any other Bit module (e.g. compiler/): every import,
// const, class and function below is visible to scenarios.bit unqualified,
// and scenarios.bit declares none of these names again — re-importing a
// name the module already imports elsewhere is `E0042 already declared in
// this scope`. `tools/build/gates.bit`'s `test-pmrangegate` gate now points
// `bit run` at this directory, not a single file.
//
// This file owns: the wrapper-reserved exit codes and shared constants, the
// `Run`/`FixtureCtx`/`CliCtx`/`NeighborCase`/`Snapshot` data shapes, the git
// fixture builder (`newFixtureCtx`/`gitInitRepo`/`commitAndTag`/
// `assertAnnotatedTag`), the `insteadOf`-rewrite helper `bit up`'s fetches
// need (it has no `--url` override), the real subprocess driver
// (`runBitCli`), and reading `bit.lock`/`bit.json` back through the real
// JSON parser. scenarios.bit owns `main()` and the three scenarios
// themselves.
//
// ANTI-VACUITY RULES this module holds itself to (identical to every other
// tests/bit/*.bit harness's own):
//
//  - Nothing is ever SKIPPED. A missing `git` is a loud failure naming it
//    (`rcGitAbsent`), never an early return.
//  - Exit codes are compared EXACTLY (`== 0`, `== 1`), never `!= 0`.
//  - The wrapper script reserves 111-114/121/124 for its OWN failures, and
//    those are rejected before any verdict is read.
//  - Capture files must EXIST before they are read.
//  - stdout AND stderr are compared with exact equality, never `contains`.
//  - The fixture HEAD is checked to be 40 hex digits before use, and every
//    fixture carries at least one ANNOTATED tag (`git tag -a`), asserted via
//    `git cat-file -t` (#2064's own bug class: a lightweight-tag fixture
//    sails straight past the peeling bug this must catch).
import { exists, readFile, remove, writeFile } from "std/fs"
import { envOr, exit } from "std/os"
import { base as pathBase, dir as pathDir } from "std/path"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { Json, jsonGet, jsonAsString, jsonParse } from "std/json"

const subprocessTimeoutMs: int = 120000

// Wrapper-reserved exit codes — a harness break, never the compiler under
// test disagreeing. 124 is this file's own timeout sentinel (`runScript`'s
// script body), matching `runGit`'s convention now that wrapper scripts run
// through unbounded `osRun` with their own embedded deadline.
const rcCdFailed: int = 111
const rcBitNotExecutable: int = 112
const rcStdlibUnresolvable: int = 113
const rcBitDirUnresolvable: int = 114
const rcGitAbsent: int = 121
const rcTimedOut: int = 124

const gitHost: string = "github.com"
const owner: string = "pmresolvegate"
class Run { code: int, stdout: string, stderr: string }

// The git fixture's on-disk location and isolated git identity, bundled per
// spec/LINT.md's E0202 guidance (past ~5 params, they want to be a class).
class FixtureCtx { root: string, srcDir: string, home: string, noConfigPath: string }

// One fresh scratch project plus the compiler/stdlib under test and a name
// for diagnostics — bundled so `runBitCli` and every scenario helper below
// take one parameter instead of five (E0202).
class CliCtx {
  name: string,
  bitExe: string,
  stdRoot: string,
  projDir: string,
  cacheRoot: string,
  home: string,
}

// One neighboring-constraint-kind case for `checkOneRef` (E0202: this used
// to be 5 positional params).
class NeighborCase {
  label: string,
  ref: string,
  wantVersion: string,
  wantCommit: string,
  checkCommit: bool,
}

class Snapshot { lock: string, json: string }

// ---- the git fixture ------------------------------------------------------

fn newFixtureCtx(root: string, label: string): FixtureCtx {
  let srcDir = root + "/" + label
  mkdirp("fixture", srcDir)
  let home = root + "/" + label + "-home"
  mkdirp("fixture", home)
  let noConfigPath = root + "/" + label + "-noconfig"
  writeFile(noConfigPath, "") catch e {
    fatal("fixture", "cannot write git isolation config: " + e.message())
  }
  return FixtureCtx{ root: root, srcDir: srcDir, home: home, noConfigPath: noConfigPath }
}

// Scoped away from the operator's real `~/.gitconfig` (this fleet sets
// `tag.gpgsign true`), so every tag below is unsigned and deterministic
// regardless of what machine runs this gate.
fn gitInitRepo(ctx: FixtureCtx) {
  let q = shQuote(ctx.srcDir)
  let script = "set -e\n" +
    "command -v git > /dev/null 2>&1 || exit ${rcGitAbsent}\n" +
    "export HOME=" +
    shQuote(ctx.home) +
    "\n" +
    "export GIT_CONFIG_GLOBAL=" +
    shQuote(ctx.noConfigPath) +
    "\n" +
    "export GIT_CONFIG_SYSTEM=/dev/null\n" +
    "git init --quiet -b main " +
    q +
    "\n" +
    "git -C " +
    q +
    " config user.email pmrangegate@example.com\n" +
    "git -C " +
    q +
    " config user.name pmrangegate\n"
  mustSucceed("fixture", "git init", script)
}

// Commits whatever files are currently on disk in `ctx.srcDir` (the caller
// writes them first) and tags the result ANNOTATED (`-a`) — never
// lightweight (#2064's own bug class: `resolveDependencyRef` must peel
// `<ref>^{}` rather than the tag object's own sha). `--no-sign`/
// `--no-gpg-sign` sidestep `tag.gpgsign true`, set globally on this fleet.
// Returns the new commit's own 40-hex sha.
fn commitAndTag(ctx: FixtureCtx, msg: string, tag: string): string {
  let q = shQuote(ctx.srcDir)
  let shaPath = ctx.root + "/head-" + uuidFormat(uuidV4())
  let script = "set -e\n" +
    "export HOME=" +
    shQuote(ctx.home) +
    "\n" +
    "export GIT_CONFIG_GLOBAL=" +
    shQuote(ctx.noConfigPath) +
    "\n" +
    "export GIT_CONFIG_SYSTEM=/dev/null\n" +
    "git -C " +
    q +
    " add -A\n" +
    "git -C " +
    q +
    " commit --quiet --no-gpg-sign -m " +
    shQuote(msg) +
    "\n" +
    "git -C " +
    q +
    " tag -a " +
    shQuote(tag) +
    " --no-sign -m " +
    shQuote(tag) +
    "\n" +
    "git -C " +
    q +
    " rev-parse HEAD > " +
    shQuote(shaPath) +
    "\n"
  mustSucceed("fixture", "commit+tag ${tag}", script)
  let sha = trimEol(
    readFile(shaPath) catch e {
      fatal("fixture", "cannot read fixture HEAD: " + e.message())
      ""
    },
  )
  if (!isFullSha(sha)) {
    fatal("fixture", "fixture HEAD is not a 40-hex commit sha after tagging ${tag}: '${sha}'")
  }
  return sha
}

fn assertAnnotatedTag(name: string, ctx: FixtureCtx, tag: string) {
  let q = shQuote(ctx.srcDir)
  let typePath = ctx.root + "/tagtype-" + uuidFormat(uuidV4())
  let script = "export HOME=" +
    shQuote(ctx.home) +
    "\n" +
    "export GIT_CONFIG_GLOBAL=" +
    shQuote(ctx.noConfigPath) +
    "\n" +
    "export GIT_CONFIG_SYSTEM=/dev/null\n" +
    "git -C " +
    q +
    " cat-file -t refs/tags/" +
    tag +
    " > " +
    shQuote(typePath) +
    "\n"
  mustSucceed(name, "checking tag ${tag} is annotated", script)
  let tagType = trimEol(
    readFile(typePath) catch e {
      fatal(name, "cannot read fixture tag type: " + e.message())
      ""
    },
  )
  if (tagType != "tag") {
    fatal(name, "fixture tag ${tag} is not annotated: got '${tagType}', want 'tag'")
  }
}

fn scratchRoot(label: string): string {
  return envOr("TMPDIR", "/tmp") + "/bit-pmrangegate-" + label + "-" + uuidFormat(uuidV4())
}

// A fresh project directory + cache root + scratch HOME under `root`, keyed
// by `label` so scenario 1's own "main" project and each neighbor-kind
// project never collide when they share the same fixture root.
fn newProjectCli(
  name: string,
  bitExe: string,
  stdRoot: string,
  root: string,
  label: string,
): CliCtx {
  let projDir = root + "/" + label + "-proj"
  let cacheRoot = root + "/" + label + "-cache"
  let home = root + "/" + label + "-cli-home"
  mkdirp(name, projDir)
  mkdirp(name, home)
  writeFile(projDir + "/bit.json", "{}\n") catch e {
    fatal(name, "cannot write bit.json: " + e.message())
  }
  return CliCtx{
    name: name,
    bitExe: bitExe,
    stdRoot: stdRoot,
    projDir: projDir,
    cacheRoot: cacheRoot,
    home: home,
  }
}

// `bit up` has no `--url` override, so redirecting a fetch it owns needs a
// plain git `insteadOf` rewrite of the `https://` URL bit.lock already
// records for `repo` — the same mechanism tests/bit/pmvanity.bit uses.
fn writeInsteadOfConfig(cli: CliCtx, localDir: string, repo: string): string {
  let path = cli.cacheRoot + "-rewrite.gitconfig"
  let httpsUrl = "https://${gitHost}/${owner}/${repo}.git"
  writeFile(path, "[url \"file://${localDir}\"]\n\tinsteadOf = ${httpsUrl}\n") catch e {
    fatal(cli.name, "cannot write git insteadOf config: " + e.message())
  }
  return path
}

// ---- bit.lock / bit.json verification -------------------------------------

fn snapshotProject(cli: CliCtx): Snapshot {
  return Snapshot{
    lock: readFileMust(cli.name, cli.projDir + "/bit.lock"),
    json: readFileMust(cli.name, cli.projDir + "/bit.json"),
  }
}

// Reads `projDir/bit.lock` through the real JSON parser and returns the one
// entry named `depName` — never a substring search, which an empty or
// truncated file could also satisfy.
fn readLockEntry(name: string, projDir: string, depName: string): Json {
  let text = readFileMust(name, projDir + "/bit.lock")
  let doc = jsonParse(text) catch e {
    fatal(name, "cannot parse bit.lock: " + e.message())
    Json.JsonNull
  }
  let v = jsonGet(doc, depName)
  if (!isSome(v)) {
    fatal(name, "bit.lock has no '${depName}' entry")
  }
  return unwrap(v)
}

fn assertJsonString(name: string, what: string, container: Json, key: string, want: string) {
  let v = jsonGet(container, key)
  if (!isSome(v)) {
    fatal(name, "${what} has no '${key}' field")
  }
  let s = jsonAsString(unwrap(v))
  if (!isSome(s)) {
    fatal(name, "${what}'s '${key}' field is not a JSON string")
  }
  let got = unwrap(s)
  if (got != want) {
    fatal(name, "${what}'s '${key}' field is '${got}', want '${want}'")
  }
}

fn assertNoKey(name: string, what: string, container: Json, key: string) {
  let v = jsonGet(container, key)
  if (isSome(v)) {
    fatal(name, "${what} unexpectedly has a '${key}' key")
  }
}

fn readFileMust(name: string, path: string): string {
  if (!exists(path)) {
    fatal(name, "expected file does not exist: ${path}")
  }
  return readFile(path) catch e {
    fatal(name, "cannot read ${path}: " + e.message())
    ""
  }
}

// ---- driving the CLI -------------------------------------------------------

// Runs `<ctx.bitExe> <args...>` with `ctx.projDir` as its working directory
// and a SEALED environment (`/usr/bin/env -i`), plus `extraEnv` — the same
// shape tests/bit/pmvanity.bit's/pmaddgit.bit's own `runBitCli` use, bundled
// into one `CliCtx` parameter (E0202: this used to be 9 positional params).
fn runBitCli(
  ctx: CliCtx,
  extraEnv: []string,
  args: []string,
  outPath: string,
  errPath: string,
): Run {
  let cmd = "\"$BIT\""
  let i = 0
  while (i < len(args)) {
    cmd = cmd + " " + shQuote(args[i])
    i = i + 1
  }
  let extra = ""
  let j = 0
  while (j < len(extraEnv)) {
    let eq = indexOfByte(extraEnv[j], '=')
    if (eq >= 0) {
      extra = extra + " " + extraEnv[j][0:eq] + "=" + shQuote(extraEnv[j][eq + 1:len(extraEnv[j])])
    }
    j = j + 1
  }
  let body = "BITDIR=$(cd " +
    shQuote(pathDir(ctx.bitExe)) +
    " && pwd) || exit ${rcBitDirUnresolvable}\n" +
    "BIT=\"$BITDIR\"/" +
    shQuote(pathBase(ctx.bitExe)) +
    "\n" +
    "[ -x \"$BIT\" ] || exit ${rcBitNotExecutable}\n" +
    "STD=$(cd " +
    shQuote(ctx.stdRoot) +
    " && pwd) || exit ${rcStdlibUnresolvable}\n" +
    "cd " +
    shQuote(ctx.projDir) +
    " || exit ${rcCdFailed}\n" +
    "exec /usr/bin/env -i" +
    " PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin" +
    " TMPDIR=/tmp BIT_STDLIB=\"$STD\" BIT_PKG_CACHE=" +
    shQuote(ctx.cacheRoot) +
    extra +
    " " +
    cmd +
    " > " +
    shQuote(outPath) +
    " 2> " +
    shQuote(errPath)
  let code = runScript(ctx.name, body)
  rejectWrapperFailure(ctx.name, code)
  if (!exists(outPath) || !exists(errPath)) {
    fatal(
      ctx.name,
      "the wrapper exited ${code} without creating its capture files — it never launched the compiler",
    )
  }
  let out = readFileMust(ctx.name, outPath)
  let err = readFileMust(ctx.name, errPath)
  return Run{ code: code, stdout: out, stderr: err }
}

// Every code the wrapper reserves for its own breakage, plus the two
// `/bin/sh` reserves for "found but not executable"/"not found" — none of
// them can be the compiler's own verdict.
fn rejectWrapperFailure(name: string, code: int) {
  if (code < 0) {
    fatal(name, "the wrapper script could not be launched")
  }
  if (code == rcTimedOut) {
    fatal(
      name,
      "subprocess TIMED OUT after ${subprocessTimeoutMs}ms — a hang is a failure, not a stall",
    )
  }
  if (code == rcCdFailed) {
    fatal(name, "wrapper: cd into the project directory failed")
  }
  if (code == rcBitNotExecutable) {
    fatal(name, "wrapper: the compiler under test is not executable")
  }
  if (code == rcStdlibUnresolvable) {
    fatal(name, "wrapper: the stdlib root could not be resolved to an absolute path")
  }
  if (code == rcBitDirUnresolvable) {
    fatal(name, "wrapper: the compiler's directory could not be resolved to an absolute path")
  }
  if (code == 126) {
    fatal(name, "wrapper: /bin/sh reported a command found but not executable (126)")
  }
  if (code == 127) {
    fatal(name, "wrapper: /bin/sh reported a command not found (127) — the compiler never ran")
  }
}

// ---- shell/timeout plumbing ------------------------------------------------

// Runs `body` under a wall-clock deadline by backgrounding it as one subshell
// job and racing a `sleep`-then-`kill -9` watcher against it — the same
// shape compiler/pmfetchtail.bit's `runGit` uses, invoked through
// `osRun("/bin/sh", [scriptPath])` rather than exec'd directly (see this
// file's own header for why). Returns the body's own exit code, or
// `rcTimedOut` (124) if the watcher fired first.
fn runScript(name: string, body: string): int {
  let path = envOr("TMPDIR", "/tmp") + "/bit-pmrangegate-" + uuidFormat(uuidV4()) + ".sh"
  let secs = subprocessTimeoutMs / 1000
  let script = "#!/bin/sh\n(\n" +
    body +
    "\n) &\n" +
    "child=$!\n" +
    "( sleep ${secs}; kill -9 \"$child\" 2>/dev/null ) &\n" +
    "watcher=$!\n" +
    "wait \"$child\" 2>/dev/null\n" +
    "status=$?\n" +
    "if kill -0 \"$watcher\" 2>/dev/null; then\n" +
    "  kill \"$watcher\" 2>/dev/null\n" +
    "  wait \"$watcher\" 2>/dev/null\n" +
    "  exit \"$status\"\n" +
    "fi\n" +
    "wait \"$watcher\" 2>/dev/null\n" +
    "exit ${rcTimedOut}\n"
  writeFile(path, script) catch e {
    fatal(name, "cannot write the wrapper script: " + e.message())
  }
  let code = osRun("/bin/sh", [path])
  removeQuiet(path)
  return code
}

// A fixture-setup script that must exit 0 — a `git` absence gets its own
// named diagnostic (`rcGitAbsent`) rather than reading as a plain failure.
fn mustSucceed(name: string, what: string, body: string) {
  let code = runScript(name, body)
  if (code == rcTimedOut) {
    fatal(name, "fixture setup (${what}) TIMED OUT after ${subprocessTimeoutMs}ms")
  }
  if (code == rcGitAbsent) {
    fatal(name, "fixture setup (${what}) needs `git` on PATH and it is not there")
  }
  if (code != 0) {
    fatal(name, "fixture setup (${what}) exited ${code}, want 0")
  }
}

fn mkdirp(name: string, path: string) {
  mustSucceed(name, "mkdir -p ${path}", "set -e\nmkdir -p " + shQuote(path) + "\n")
}

fn removeQuiet(path: string) {
  remove(path) catch _ {
    return
  }
}

// Wraps `s` as one POSIX `/bin/sh` word: every embedded `'` becomes `'\''`.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\'') {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn indexOfByte(s: string, c: byte): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// ---- small shared helpers ---------------------------------------------

fn isFullSha(s: string): bool {
  if (len(s) != 40) {
    return false
  }
  let i = 0
  while (i < 40) {
    let c = s[i]
    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
      return false
    }
    i = i + 1
  }
  return true
}

fn trimEol(s: string): string {
  let n = len(s)
  while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r')) {
    n = n - 1
  }
  return s[0:n]
}

fn fatal(name: string, msg: string) {
  print("FAIL [${name}]: ${msg}\n")
  exit(1)
}
