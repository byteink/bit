// #2925: word-offset drift gate for the arm64 backend's inlined back-edge
// poll guard.
//
// THE COUPLING THIS GATE MAKES LOUD. `compiler/arm64call.bit`'s
// emitInlinedPollGuard replaced #2921's call to `bit_rt_safepoint_needed`
// with the same condition (runtime/stw/stwpoll.bit's stwPollNeeded) emitted
// directly at the loop back-edge: ordinary loads through the GC/World struct
// fields, at hardcoded word offsets, because a pinned symbol (§11.9) crosses
// the compiler/runtime object boundary only for a FUNCTION, never for module
// state or a struct field (§17.6/§11.11) — so the backend cannot import
// these numbers, it can only mirror them. `compiler/arm64call.bit`'s
// pgWorldStopWordWord/pgGcCfgStressWord/pgGcCfgEnabledWord/pgGcHeapAddrWord/
// pgHeapLiveWordWord/pgGcNextBytesWord return these SAME six numbers as
// literals. If the runtime's own layout ever moves one of them and this
// backend's copy is not updated in the same change, the inlined guard reads
// the wrong word — a poll that never fires, or one that always does — with
// no build, link or golden-corpus failure to catch it (the exact shape
// tests/bit/gcdefaults.bit's header describes for the GC-config case).
//
// WHAT THIS ASSERTS. The runtime's own exported consts, imported here by
// name, still equal the literals the arm64 backend hardcodes. A change to
// any of the six numbers below — on either side — must fail this gate
// immediately, loudly, rather than compiling and running with a silently
// wrong guard.
//
// Run from the repository root: ./bit-out/bin/bit run tests/bit/pollguardoffsets.bit
import { exit } from "std/os"
import {
  gcHeapAddr, gcCfgEnabled, gcCfgStress, gcNextBytes, worldStopWord,
} from "../../runtime/gc"
import { heapLiveWord } from "../../runtime/alloc"

struct Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn main() {
  let t = Tally{ checks: 0, failures: 0 }

  // Mirrors compiler/arm64call.bit's pgGcHeapAddrWord().
  check(t, gcHeapAddr == 0,
    "runtime/gc gcHeapAddr is ${gcHeapAddr}, want 0 " +
    "(compiler/arm64call.bit pgGcHeapAddrWord drifted)")
  // Mirrors pgGcCfgEnabledWord().
  check(t, gcCfgEnabled == 9,
    "runtime/gc gcCfgEnabled is ${gcCfgEnabled}, want 9 " +
    "(compiler/arm64call.bit pgGcCfgEnabledWord drifted)")
  // Mirrors pgGcCfgStressWord().
  check(t, gcCfgStress == 10,
    "runtime/gc gcCfgStress is ${gcCfgStress}, want 10 " +
    "(compiler/arm64call.bit pgGcCfgStressWord drifted)")
  // Mirrors pgGcNextBytesWord().
  check(t, gcNextBytes == 14,
    "runtime/gc gcNextBytes is ${gcNextBytes}, want 14 " +
    "(compiler/arm64call.bit pgGcNextBytesWord drifted)")
  // Mirrors pgWorldStopWordWord(). runtime/gc/gcworld.bit:152's own trailing
  // comment says 1024 — that comment is stale (256*5 = 1280; #2938 tracks
  // the doc fix). 1280 is the real, currently-exported value.
  check(t, worldStopWord == 1280,
    "runtime/gc worldStopWord is ${worldStopWord}, want 1280 " +
    "(compiler/arm64call.bit pgWorldStopWordWord drifted)")
  // Mirrors pgHeapLiveWordWord().
  check(t, heapLiveWord == 0,
    "runtime/alloc heapLiveWord is ${heapLiveWord}, want 0 " +
    "(compiler/arm64call.bit pgHeapLiveWordWord drifted)")

  if (t.checks < 6) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 6\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("pollguardoffsets: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("pollguardoffsets: PASS — ${t.checks} checks")
}
