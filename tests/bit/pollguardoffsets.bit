// #2925 (arm64) / #3169 (x64): word-offset drift gate for BOTH backends'
// inlined back-edge poll guard.
//
// THE COUPLING THIS GATE MAKES LOUD. `compiler/arm64call.bit`'s
// emitInlinedPollGuard and `compiler/x64call.bit`'s xEmitInlinedPollGuard
// replaced #2921/#2926's call to `bit_rt_safepoint_needed` with the same
// condition (runtime/stw/stwpoll.bit's stwPollNeeded) emitted directly at the
// loop back-edge: ordinary loads through the GC/World struct fields, at
// hardcoded word offsets, because a pinned symbol (§11.9) crosses the
// compiler/runtime object boundary only for a FUNCTION, never for module
// state or a struct field (§17.6/§11.11) — so a backend cannot import these
// numbers, it can only mirror them. `compiler/codegen.bit`'s
// pgWorldStopWordWord/pgGcCfgStressWord/pgGcCfgEnabledWord/pgGcHeapAddrWord/
// pgHeapLiveWordWord/pgGcNextBytesWord return these SAME six numbers as
// literals, once, for both backends. If the runtime's own layout ever moves
// one of them and the compiler's copy is not updated in the same change, both
// inlined guards read the wrong word — a poll that never fires, or one that
// always does — with no build, link or golden-corpus failure to catch it (the
// exact shape tests/bit/gcdefaults.bit's header describes for the GC-config
// case).
//
// WHAT THIS ASSERTS. The runtime's own exported consts, imported here by
// name, still equal the literals the compiler hardcodes. A change to any of
// the six numbers below — on either side — must fail this gate immediately,
// loudly, rather than compiling and running with a silently wrong guard.
//
// Run from the repository root: ./bit-out/bin/bit run tests/bit/pollguardoffsets.bit
import { exit } from "std/os"
import {
  gcHeapAddr, gcCfgEnabled, gcCfgStress, gcNextBytes, worldStopWord,
} from "../../runtime/gc"
import { heapLiveWord } from "../../runtime/alloc"

struct Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn main() {
  let t = Tally{ checks: 0, failures: 0 }

  // Mirrors compiler/codegen.bit's pgGcHeapAddrWord().
  check(t, gcHeapAddr == 0,
    "runtime/gc gcHeapAddr is ${gcHeapAddr}, want 0 " +
    "(compiler/codegen.bit pgGcHeapAddrWord drifted)")
  // Mirrors compiler/codegen.bit's pgGcCfgEnabledWord().
  check(t, gcCfgEnabled == 9,
    "runtime/gc gcCfgEnabled is ${gcCfgEnabled}, want 9 " +
    "(compiler/codegen.bit pgGcCfgEnabledWord drifted)")
  // Mirrors compiler/codegen.bit's pgGcCfgStressWord().
  check(t, gcCfgStress == 10,
    "runtime/gc gcCfgStress is ${gcCfgStress}, want 10 " +
    "(compiler/codegen.bit pgGcCfgStressWord drifted)")
  // Mirrors compiler/codegen.bit's pgGcNextBytesWord().
  check(t, gcNextBytes == 14,
    "runtime/gc gcNextBytes is ${gcNextBytes}, want 14 " +
    "(compiler/codegen.bit pgGcNextBytesWord drifted)")
  // Mirrors compiler/codegen.bit's pgWorldStopWordWord(). muWords went 5->6
  // in #2646, moving worldStopWord = maxMutators * muWords from 1280 to
  // 1536; #3240 updated the compiler's mirror to follow.
  check(t, worldStopWord == 1536,
    "runtime/gc worldStopWord is ${worldStopWord}, want 1536 " +
    "(compiler/codegen.bit pgWorldStopWordWord drifted)")
  // Mirrors compiler/codegen.bit's pgHeapLiveWordWord().
  check(t, heapLiveWord == 0,
    "runtime/alloc heapLiveWord is ${heapLiveWord}, want 0 " +
    "(compiler/codegen.bit pgHeapLiveWordWord drifted)")

  if (t.checks < 6) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 6\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("pollguardoffsets: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("pollguardoffsets: PASS — ${t.checks} checks")
}
