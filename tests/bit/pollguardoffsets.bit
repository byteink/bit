// #2925 (arm64) / #3169 (x64): word-offset drift gate for BOTH backends'
// inlined back-edge poll guard.
//
// THE COUPLING THIS GATE MAKES LOUD. `compiler/arm64call.bit`'s
// emitInlinedPollGuard and `compiler/x64call.bit`'s xEmitInlinedPollGuard
// replaced #2921/#2926's call to `bit_rt_safepoint_needed` with the same
// condition (runtime/stw/stwpoll.bit's stwPollNeeded) emitted directly at the
// loop back-edge: ordinary loads through the GC/World struct fields, at
// hardcoded word offsets, because a pinned symbol (§11.9) crosses the
// compiler/runtime object boundary only for a FUNCTION, never for module
// state or a struct field (§17.6/§11.11) — so a backend cannot import these
// numbers, it can only mirror them. `compiler/codegen.bit`'s
// pgWorldStopWordWord/pgGcCfgStressWord/pgGcCfgEnabledWord/pgGcHeapAddrWord/
// pgHeapLiveWordWord/pgGcNextBytesWord/pgGcNumObjectsIdxWord/
// pgGcNextObjectsWord return these SAME eight numbers as
// literals, once, for both backends. If the runtime's own layout ever moves
// one of them and the compiler's copy is not updated in the same change, both
// inlined guards read the wrong word — a poll that never fires, or one that
// always does — with no build, link or golden-corpus failure to catch it (the
// exact shape tests/bit/gcdefaults.bit's header describes for the GC-config
// case).
//
// THREE COPIES, THREE EDGES. (1) the runtime's own exported consts, imported
// here by name; (2) `compiler/codegen.bit`'s eight literal-returning
// `pg*Word()` functions, read as TEXT below (a pinned symbol crosses the
// compiler/runtime boundary only as a function body, never as importable
// state — see above — so this file cannot `import` (2), only parse it); (3)
// this file's own copy, now the eight `want*` constants below. #3241: this
// used to check only the (1)-vs-(3) edge, while every failure message named
// `compiler/codegen.bit` — so editing (2) alone, with (1) and (3) untouched,
// passed silently. Both edges are checked now: (1)-vs-(3) below, and
// (2)-vs-(3) in the `pgWords` loop.
//
// WHAT THIS ASSERTS. The runtime's own exported consts, imported here by
// name, still equal this file's copy of the eight numbers (checks 1-8) — a
// change to either side must fail loudly. And `compiler/codegen.bit`'s own
// `pg*Word()` literals, parsed out of the checked-in source, still equal the
// same eight numbers (checks 9-16) — a change to the compiler's copy ALONE,
// with the runtime and this file untouched, must fail loudly too, which is
// the direction #3241 closes.
//
// Run from the repository root: ./bit-out/bin/bit run tests/bit/pollguardoffsets.bit
// `BIT_REPO` overrides the repository root used to locate
// `compiler/codegen.bit` (default: search . / .. / ../.. / ../../..).
import { env, exit } from "std/os"
import { exists, readFile } from "std/fs"
import { indexOf } from "std/strings"
import {
  gcHeapAddr, gcCfgEnabled, gcCfgStress, gcNextBytes, worldStopWord,
  gcNumObjectsIdx, gcNextObjects,
} from "../../runtime/gc"
import { heapLiveWord } from "../../runtime/alloc"

// This file's own copy of the eight numbers — edge (3) of the three-way
// mirror. Named once so the runtime check and the compiler-literal check
// below compare against the exact same value, not two independently typed
// literals.
const wantGcHeapAddr: int = 0
const wantGcCfgEnabled: int = 9
const wantGcCfgStress: int = 10
const wantGcNextBytes: int = 14
// muWords went 5->6 in #2646, moving worldStopWord = maxMutators * muWords
// from 1280 to 1536; #3240 updated the compiler's mirror to follow.
const wantWorldStopWord: int = 1536
const wantHeapLiveWord: int = 0
// The object half of the trigger (#3292), mirrored into both inlined ladders
// by #3359. #3292 moved the runtime predicate and left the two compiler copies
// on the byte trigger alone; this gate covered only the six words that already
// existed, so nothing went red. The ladders are only as pinned as this table
// is complete.
const wantGcNumObjectsIdx: int = 4
const wantGcNextObjects: int = 37

// Bounds — a single small source file, but still capped explicitly (Power of
// 10 rule 2).
const maxCodegenBytes: int = 1048576
const maxLiteralDigits: int = 12

struct Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn die(msg: string) {
  eprint("pollguardoffsets: SETUP FAILED: ${msg}\n")
  exit(1)
}

// The repo root: the nearest ancestor holding `compiler/codegen.bit`.
// BIT_REPO wins, same convention as tests/bit/version.bit and
// tests/bit/fmtcitations.bit.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (exists("${c}/compiler/codegen.bit")) {
      return c
    }
  }
  die("cannot locate compiler/codegen.bit from this cwd; set BIT_REPO")
  return ""
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn parseDigits(s: string): (int, bool) {
  let n = len(s)
  if (n == 0 || n > maxLiteralDigits) {
    return 0, false
  }
  let v = 0
  let i = 0
  while (i < n) {
    let c = s[i]
    if (!isDigit(c)) {
      return 0, false
    }
    v = v * 10 + (int(c) - 48)
    i = i + 1
  }
  return v, true
}

// The literal integer `compiler/codegen.bit` returns from
// `fn <fnName>(): int { return <N> }`, parsed straight out of the checked-in
// source — the same "read the file as its own source of truth" technique
// tests/bit/version.bit's stampedVersion uses, so this comparison stays
// independent of whatever the compiler under test happens to have compiled
// in. Line-shaped, exactly as the eight functions are written
// (compiler/codegen.bit:432-448): a shape change must fail loudly rather than
// silently yield 0.
fn codegenPgWord(codegenSrc: string, fnName: string): (int, bool) {
  let marker = "fn ${fnName}(): int { return "
  let idxRaw = indexOf(codegenSrc, marker)
  if (idxRaw < 0) {
    return 0, false
  }
  let start = int(idxRaw) + len(marker)
  let n = len(codegenSrc)
  let j = start
  while (j < n && (j - start) < maxLiteralDigits && isDigit(codegenSrc[j])) {
    j = j + 1
  }
  if (j == start) {
    return 0, false
  }
  return parseDigits(codegenSrc[start:j])
}

struct PgWord { fnName: string, want: int }

fn checkCodegenWord(t: Tally, codegenSrc: string, pw: PgWord) {
  let (got, ok) = codegenPgWord(codegenSrc, pw.fnName)
  if (!ok) {
    check(t, false,
      "compiler/codegen.bit ${pw.fnName}() literal not found or unparseable " +
      "(compiler/codegen.bit ${pw.fnName} drifted out of its `fn ${pw.fnName}(): int { return N }` shape)")
    return
  }
  check(t, got == pw.want,
    "compiler/codegen.bit ${pw.fnName}() returns ${got}, want ${pw.want} " +
    "(compiler/codegen.bit ${pw.fnName} drifted)")
}

fn main() {
  let t = Tally{ checks: 0, failures: 0 }

  // Edge (1)-vs-(3): the runtime's own exported consts against this file's
  // copy. A failure here means the RUNTIME moved — update
  // compiler/codegen.bit's mirror to follow.
  check(t, gcHeapAddr == wantGcHeapAddr,
    "runtime/gc gcHeapAddr is ${gcHeapAddr}, want ${wantGcHeapAddr} " +
    "(the runtime moved; update compiler/codegen.bit's pgGcHeapAddrWord to match)")
  check(t, gcCfgEnabled == wantGcCfgEnabled,
    "runtime/gc gcCfgEnabled is ${gcCfgEnabled}, want ${wantGcCfgEnabled} " +
    "(the runtime moved; update compiler/codegen.bit's pgGcCfgEnabledWord to match)")
  check(t, gcCfgStress == wantGcCfgStress,
    "runtime/gc gcCfgStress is ${gcCfgStress}, want ${wantGcCfgStress} " +
    "(the runtime moved; update compiler/codegen.bit's pgGcCfgStressWord to match)")
  check(t, gcNextBytes == wantGcNextBytes,
    "runtime/gc gcNextBytes is ${gcNextBytes}, want ${wantGcNextBytes} " +
    "(the runtime moved; update compiler/codegen.bit's pgGcNextBytesWord to match)")
  check(t, worldStopWord == wantWorldStopWord,
    "runtime/gc worldStopWord is ${worldStopWord}, want ${wantWorldStopWord} " +
    "(the runtime moved; update compiler/codegen.bit's pgWorldStopWordWord to match)")
  check(t, heapLiveWord == wantHeapLiveWord,
    "runtime/alloc heapLiveWord is ${heapLiveWord}, want ${wantHeapLiveWord} " +
    "(the runtime moved; update compiler/codegen.bit's pgHeapLiveWordWord to match)")
  check(t, gcNumObjectsIdx == wantGcNumObjectsIdx,
    "runtime/gc gcNumObjectsIdx is ${gcNumObjectsIdx}, want ${wantGcNumObjectsIdx} " +
    "(the runtime moved; update compiler/codegen.bit's pgGcNumObjectsIdxWord to match)")
  check(t, gcNextObjects == wantGcNextObjects,
    "runtime/gc gcNextObjects is ${gcNextObjects}, want ${wantGcNextObjects} " +
    "(the runtime moved; update compiler/codegen.bit's pgGcNextObjectsWord to match)")

  // Edge (2)-vs-(3): compiler/codegen.bit's own `pg*Word()` literals,
  // read out of the checked-in source, against this file's copy. A failure
  // here means compiler/codegen.bit itself drifted — the direction #3241
  // closes, previously invisible to this gate.
  let root = repoRoot()
  let codegenPath = "${root}/compiler/codegen.bit"
  let codegenSrc = readFile(codegenPath) catch e {
    die("cannot read ${codegenPath}: ${e.message()}")
    ""
  }
  if (len(codegenSrc) > maxCodegenBytes) {
    die("${codegenPath} is ${len(codegenSrc)} bytes, over the ${maxCodegenBytes} bound")
  }

  let pgWords = [
    PgWord{ fnName: "pgGcHeapAddrWord", want: wantGcHeapAddr },
    PgWord{ fnName: "pgGcCfgEnabledWord", want: wantGcCfgEnabled },
    PgWord{ fnName: "pgGcCfgStressWord", want: wantGcCfgStress },
    PgWord{ fnName: "pgGcNextBytesWord", want: wantGcNextBytes },
    PgWord{ fnName: "pgWorldStopWordWord", want: wantWorldStopWord },
    PgWord{ fnName: "pgHeapLiveWordWord", want: wantHeapLiveWord },
    PgWord{ fnName: "pgGcNumObjectsIdxWord", want: wantGcNumObjectsIdx },
    PgWord{ fnName: "pgGcNextObjectsWord", want: wantGcNextObjects },
  ]
  // A shortened table is a green run that proves nothing.
  assert(len(pgWords) == 8)
  for pw of pgWords {
    checkCodegenWord(t, codegenSrc, pw)
  }

  if (t.checks < 16) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 16\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("pollguardoffsets: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("pollguardoffsets: PASS — ${t.checks} checks")
}
