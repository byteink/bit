// Doc-tests — the Bit-native port of tests/docs.zig (#351).
//
// The property, in one sentence: every ```` ```bit ```` fenced block under
// `docs/` that is not marked `ignore` typechecks against the real prelude and
// the real `std/*` — with a page's blocks joined into ONE module unless the page
// carries `<!-- doctest: per-block -->`.
//
// Documentation that does not compile is worse than no documentation, because a
// reader trusts it. A snippet is CHECKED, not built: it is a module, not a
// program, so it has no `main` to link. That is exactly what lets a reference
// page show one function in isolation.
//
// A page's blocks are one module by default, concatenated in document order,
// because that is how a reference page reads: `interfaces.md` declares
// `interface Shape` in one block and implements it three blocks later. It also
// means such a page cannot declare a name twice. A page whose blocks are
// separate programs — a tutorial, where each snippet is a whole `main` you could
// run — says so with `<!-- doctest: per-block -->`, and each of its blocks is
// checked on its own. A block that cannot join its page's module is fenced
// ```` ```bit ignore ````: still highlighted as Bit, just not checked.
//
// WHAT THE PORT CHANGES, AND THE NEW FAILURE MODE IT CREATES. The Zig original
// called the front end in-process (`bit.checkHostProject`) and got the
// diagnostics back as a value. Bit gets one subprocess primitive — ABI.md §19's
// `os_run_bounded(path, timeout_ms)`, no argv and no stdout capture — so argv,
// the `BIT_STDLIB` override and the output redirect all have to come from a
// generated `/bin/sh` script. That is a way to be green while checking nothing
// which did not exist before the port: a script that cannot fail makes every
// page pass. `plumbingSelfTest` runs FIRST and exists solely to kill that: it
// checks one snippet that must pass and one that must fail, and aborts the whole
// run if the broken one comes back clean.
//
// WHY THE CHECKS RUN IN PARALLEL, AND HOW THE VERDICT SURVIVES IT. Serially
// this gate cost 303s, which is why it was wired out of `./make test`. The
// cost is neither the harness nor process startup: it is the front end
// re-checking `std/*` once per snippet, so one page importing `std/http` costs
// 2.8s against 0.03s for one importing nothing. No process can share that work,
// so the only lever is running them at once — and `osRunBounded` cannot, being
// `@nosplit` over module-level scratch, one child at a time. So the fan-out
// lives in the script, and ONE `osRunBounded` call drives the whole corpus.
//
// The unit of judgement does NOT change: every snippet still gets its own module
// directory, `bit check`, captured output and exit status, and a failure is
// still named by page and by block. What changes is where the status comes from.
// `exec` no longer makes the script's status BE the compiler's — there are N
// compilers — so each job `echo`es its own into `s<i>`, and a MISSING or
// unparseable `s<i>` is a hard abort, never a pass. `plumbingSelfTest` runs its
// good and bad snippets as one two-job batch through that exact path, which also
// pins the slot mapping: put both in slot 0 and the bad one comes back clean,
// put both in slot 1 and the good one fails.
//
// The batch deadline replaces the per-check one and stays a real bound: ~48s
// against `BIT_TEST_TIMEOUT_S`'s 300s default is the ~6x headroom docs/development.md sets
// for every other harness. A timeout is still attributable — jobs that finished
// wrote a status, so the ones missing one are the snippets that hung.
//
// WHY THE SCRIPT IS WRITTEN ONCE AND NEVER REWRITTEN. Rewriting an executable
// while a previous exec of it may still be in flight is the ETXTBSY trap that
// bit tests/harness.zig (74811a3). Only data changes: the slot modules
// `w<i>/main.bit` and the job count in `n.txt`, which the script reads.
//
// WHY THE COMPILER IS COPIED BEFORE BEING RUN. The self-hosted `bit` is
// rewritten in place by a `has_side_effects` build step, so a concurrent build
// truncates the file mid-exec (#1644); a truncated binary execs with no output,
// which a "did it report errors" assertion would happily read as success. The
// per-run nonce in the scratch path is #1828's fix for the fixed-/tmp-path race.
//
// FLOORS, NOT A `> 0` FLOOR. `checked > 0` — the Zig original's only corpus
// assertion — cannot tell 271 blocks from 1. A cursor that fails to advance past
// a close fence yields exactly one block per page and still passes it. The
// floors below are set just under the live corpus (271 blocks over 31 pages,
// 219 invocations) so a structural regression in the extractor lands under them.

import { readFile, writeFile, exists, isDir, mkdir, remove, walk } from "std/fs"
import { contains, indexOf, hasSuffix, parseInt } from "std/strings"
import { env, envOr } from "std/os"

// Bounds on the walk, so the traversal is provably finite (Power of 10).
const maxFiles: int = 256
const maxBlocksPerFile: int = 128
// Ceilings on the queue and on the fan-out, so the run's resource use is
// decided before it starts rather than by whatever the corpus grew into.
const maxJobs: int = 512
const maxFanout: int = 32

const fenceTag: string = "```bit"
const fenceClose: string = "\n```"

// A page carrying this marker has its blocks checked one at a time, rather than
// joined into a single module.
const perBlockMarker: string = "<!-- doctest: per-block -->"

// Corpus floors. Each is set below today's real count with room for ordinary
// documentation churn, and far above the value any known extractor regression
// would produce.
const minPagesWithBlocks: int = 25
const minTotalBlocks: int = 250
const minInvocations: int = 200

// Everything a batch of checks needs. Resolved once, asserted once.
struct Cfg {
  bin: string        // the compiler under test, already copied into scratch
  stdlibDir: string
  docsDir: string
  dir: string        // scratch root, and the runner's cwd
  jobs: int          // workers, i.e. how many `bit check` run at once
  script: string     // the generated runner, written once
  countPath: string  // `n.txt`: how many slots this batch uses
  timeoutMs: i64
}

// One check: the child's exit status, and whatever it printed.
struct CheckResult {
  code: i64
  report: string
}

// One snippet queued for checking. `block` is the 1-based block number for a
// per-block page, or 0 when the job is the page's blocks joined — the two cases
// read differently in a failure message.
struct Job {
  page: string
  block: int
  blocks: int
  src: string
}

// The corpus walk's output: what to check, and what was counted while deciding.
struct Plan { jobs: []Job, st: Stats }

// One extractBlocks unit case.
struct ExtractCase {
  name: string
  md: string
  want: []string
}

// Setup failures are never a pass. Every one of them ends the process nonzero
// rather than leaving work unrun — a skipped check is a green test, which is
// exactly the vacuity this file exists to avoid.
function die(msg: string) {
  eprint("docs: SETUP FAILED: ${msg}\n")
  osExit(1)
}

function slurp(path: string, what: string): string {
  if (!exists(path)) {
    die("${what}: missing: ${path}")
  }
  return readFile(path) catch e {
    die("${what}: ${path}: ${e.message()}")
    ""
  }
}

function spill(path: string, content: string, what: string) {
  writeFile(path, content) catch e {
    die("${what}: ${path}: ${e.message()}")
  }
}

// 8 bytes of OS entropy, the same scheme compiler/build.bit uses for scratch
// paths it writes and then execs. A timestamp is not enough: two processes CAN
// read the same nanosecond, they cannot draw the same 64-bit nonce.
function nonce(): uint {
  let b = []byte(cryptoRandomBytes(8))
  let x: uint = 0
  let i = 0
  while (i < 8) {
    x = (x << 8) | uint(b[i])
    i = i + 1
  }
  return x
}

// The repo root: the nearest ancestor holding BOTH the built compiler and the
// docs tree. Overridable with BIT_REPO. Not finding one is a hard failure, never
// a skip — an empty corpus from a wrong cwd is the classic green no-op.
function repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (exists("${c}/bit-out/bin/bit") && isDir("${c}/docs")) {
      return c
    }
  }
  die("cannot locate the repo root from this cwd; set BIT_REPO")
  return ""
}

// " \t\r" trimmed from both ends. NOT std/strings' trimSpace, which leaves `\r`
// — a CRLF page would then have info string "\r", every block would test as
// unchecked, and the whole page would silently contribute nothing.
function trimInfo(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t' || s[lo] == '\r')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t' || s[hi - 1] == '\r')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// The checkable `bit` blocks in `md`: those fenced exactly ```` ```bit ```` at
// the start of a line. A port of the Zig extractor, decision for decision.
//
// The two tests that look redundant and are not: `atLineStart` rejects a
// ```` ```bit ```` written inside prose (docs/stdlib/README.md has one), and
// `len(info) == 0` rejects both ```` ```bit ignore ```` and a hypothetical
// ```` ```bitrot ````, which shares the tag as a prefix.
function extractBlocks(md: string): []string {
  let blocks = []string(0)
  let rest = md
  while (len(blocks) < maxBlocksPerFile) {
    let tagRel = indexOf(rest, fenceTag)
    if (tagRel < 0) {
      break
    }
    let t = int(tagRel)
    let atLineStart = t == 0 || rest[t - 1] == '\n'
    let afterTag = rest[t + len(fenceTag):]

    // The rest of the fence line is the info string's remaining words.
    let nlRel = indexOf(afterTag, "\n")
    if (nlRel < 0) {
      break
    }
    let n = int(nlRel)
    let info = trimInfo(afterTag[:n])
    let body = afterTag[n + 1:]

    let closeRel = indexOf(body, fenceClose)
    if (closeRel < 0) {
      break
    }
    let c = int(closeRel)
    if (atLineStart && len(info) == 0) {
      blocks = append(blocks, body[:c])
    }
    // Advancing to the close fence — not past the open one — is what stops a
    // nested ```` ```bit ```` inside a block being re-read as a new block, and
    // is the line whose absence yields exactly one block per page.
    rest = body[c:]
  }
  return blocks
}

// A page's blocks, joined into one module in document order.
function joinBlocks(blocks: []string): string {
  let out = ""
  for b of blocks {
    out = out + b + "\n\n"
  }
  return out
}

// Slot `i`'s paths: its module directory, its captured output, its exit status,
// and the claim directory a worker `mkdir`s to take the job.
function slotDir(cfg: Cfg, i: int): string { return "${cfg.dir}/w${i}" }
function slotMain(cfg: Cfg, i: int): string { return "${cfg.dir}/w${i}/main.bit" }
function slotOut(cfg: Cfg, i: int): string { return "${cfg.dir}/o${i}" }
function slotStatus(cfg: Cfg, i: int): string { return "${cfg.dir}/s${i}" }
function slotClaim(cfg: Cfg, i: int): string { return "${cfg.dir}/c${i}" }

// A leftover from an earlier batch is removed before the next one starts: a
// child that never ran must not hand back stale output or a stale zero status.
// A stale CLAIM is the nastier one — every worker would skip that job, which
// `slotResult` then reads as the harness being broken.
function scrub(path: string) {
  if (exists(path)) {
    remove(path) catch e { die("cannot clear ${path}: ${e.message()}") }
  }
}

// What slot `i` produced, once the runner has finished with it. Absent, empty
// or non-numeric status all abort the run: a check whose result is unknown is
// not a check, and there is no lenient reading of this file.
function slotResult(cfg: Cfg, i: int): CheckResult {
  let p = slotStatus(cfg, i)
  if (!exists(p)) {
    die("no exit status at ${p}: the runner did not record slot ${i}, so its snippet is unchecked")
  }
  // trimInfo strips " \t\r" but not the newline `echo` writes, which is the
  // last byte when present.
  let raw = slurp(p, "check status")
  let cut = raw
  while (len(cut) > 0 && cut[len(cut) - 1] == '\n') { cut = cut[:len(cut) - 1] }
  let code = parseInt(trimInfo(cut)) catch _ {
    die("unreadable exit status in ${p}: ${jsonish(raw)}")
    0
  }
  let outPath = slotOut(cfg, i)
  if (!exists(outPath)) {
    die("no output capture at ${outPath}: the runner script is not redirecting slot ${i}")
  }
  return CheckResult{ code: i64(code), report: slurp(outPath, "check output") }
}

// Typechecks `srcs` — one module per source — in ONE runner invocation, and
// returns one result per source in the same order. The workers claim jobs
// dynamically rather than being handed a fixed share, because the corpus is
// wildly uneven and any static split leaves most workers idle behind the one
// page that imports `std/http`. Measured here: 303s serially, 74s in fixed
// rounds of 8, 48s pulled from one queue by 12.
function runBatch(cfg: Cfg, srcs: []string): []CheckResult {
  let n = len(srcs)
  assert(n > 0 && n <= maxJobs)
  stageBatch(cfg, srcs)
  let r = osRunBounded(cfg.script, cfg.timeoutMs)
  assertRunnerRan(cfg, r, n)
  return collectBatch(cfg, n, r)
}

// One module per source, plus the count the runner reads, plus a clean slate.
function stageBatch(cfg: Cfg, srcs: []string) {
  let i = 0
  while (i < len(srcs)) {
    if (!exists(slotDir(cfg, i))) {
      mkdir(slotDir(cfg, i)) catch e { die("mkdir ${slotDir(cfg, i)}: ${e.message()}") }
    }
    spill(slotMain(cfg, i), srcs[i], "scratch module")
    scrub(slotOut(cfg, i))
    scrub(slotStatus(cfg, i))
    scrub(slotClaim(cfg, i))
    i = i + 1
  }
  spill(cfg.countPath, "${len(srcs)}\n", "batch size")
}

// ABI.md §19 packs three outcomes into one i64, and here they are the RUNNER's,
// not a compiler's. Only the timeout is a verdict about the docs; the rest mean
// the harness is broken, and a broken harness must not be able to pass.
// The runner exits 0 after `wait`; 111-113 are its own setup failures, and any
// other positive status means it never reached the worker loop.
function assertRunnerRan(cfg: Cfg, r: i64, n: int) {
  if (r == -1) { die("SPAWN FAILED (fork/exec/wait error) running ${cfg.script}") }
  if (r <= -100) { die("runner ${cfg.script} killed by signal ${-r - 100}") }
  if (r < 0 && r != -2) { die("unknown os_run_bounded result ${r} from ${cfg.script}") }
  if (r > 0) { die("runner ${cfg.script} exited ${r} — it never ran the ${n} check(s) in this batch") }
}

// A hang is a failure, not a stall — and it is attributable: the jobs that
// finished wrote a status, so a missing one names the snippet that hung instead
// of condemning the whole batch.
function collectBatch(cfg: Cfg, n: int, r: i64): []CheckResult {
  let out = []CheckResult(0)
  let j = 0
  while (j < n) {
    if (r == -2 && !exists(slotStatus(cfg, j))) {
      out = append(out, CheckResult{ code: r,
        report: "TIMED OUT: still running when the batch deadline of ${cfg.timeoutMs}ms elapsed" })
    } else {
      out = append(out, slotResult(cfg, j))
    }
    j = j + 1
  }
  return out
}

// Runs BEFORE the corpus walk, and aborts it on any surprise.
//
// This is the countermeasure to the port's own failure mode: the harness reads
// numbers a generated script wrote, and a script that cannot report failure
// makes every page pass. So one snippet that must check clean and one that must
// not are run through the exact same path the corpus uses. The good one also
// imports `std/strings`, which proves BIT_STDLIB reached the child — without it
// every std-importing page would fail for a reason unrelated to the docs.
//
// Running them as ONE two-job batch is deliberate: it also pins the slot mapping
// the batch depends on. If every job were checking slot 0 the bad snippet would
// come back clean; if every job were checking the last slot the good one would
// fail. Either way this aborts, and no corpus page is ever judged by a runner
// that confuses one snippet with another.
function plumbingSelfTest(cfg: Cfg) {
  assert(cfg.jobs >= 2)
  let rs = runBatch(cfg, [
    "import { contains } from \"std/strings\"\n\nfunction docsPlumbingOk(s: string): bool {\n  return contains(s, \"a\")\n}\n",
    "let docsPlumbingBad: int = \"not an int\"\n",
  ])
  assert(len(rs) == 2)
  let good = rs[0]
  let bad = rs[1]

  if (good.code != 0) {
    die("plumbing: a known-good snippet did not check (status ${good.code}):\n${good.report}")
  }
  if (bad.code == 0) {
    die("plumbing: a DELIBERATELY BROKEN snippet checked clean — the runner is not recording the compiler's exit status, so this gate cannot fail. Captured output:\n${bad.report}")
  }
  if (!contains(bad.report, "error[")) {
    die("plumbing: the broken snippet failed (status ${bad.code}) but no diagnostics were captured — the output redirect is not wired. Captured:\n${bad.report}")
  }
}

// The extractor's own tests, on literal pages rather than the corpus. The
// corpus floors prove the extractor finds a lot; these prove it finds the RIGHT
// things, which no count can.
function extractCases(): []ExtractCase {
  return [
    // The Zig original's case: takes ```bit, skips ```bit ignore and a bare
    // fence, and the two results prove the cursor advances past a close fence.
    ExtractCase{
      name: "takes-bit-skips-ignore-and-plain",
      md: "intro\n```bit\nlet a = 1\n```\nprose\n```\nnot bit\n```\n```bit ignore\nthis need not compile\n```\n```bit\nlet b = 2\n```\n",
      want: ["let a = 1", "let b = 2"],
    },
    // docs/stdlib/README.md's live shape: a ```bit written inside prose. Its
    // info string is empty in neither reading, but the at-line-start test is
    // what must reject it — and the following real block must still be found.
    ExtractCase{
      name: "inline-fence-is-not-a-block",
      md: "x ```bit\nnope\n```\n```bit\nlet ok = 1\n```\n",
      want: ["let ok = 1"],
    },
    // CRLF. The info string is "\r", which only trimInfo (not std/strings'
    // trimSpace) reduces to empty. Get this wrong and a CRLF page silently
    // contributes zero blocks.
    ExtractCase{
      name: "crlf-page",
      md: "```bit\r\nlet a = 1\r\n```\r\n",
      want: ["let a = 1\r"],
    },
    // ```bitrot shares the tag as a prefix and is not a Bit fence at all.
    ExtractCase{
      name: "bitrot-is-not-bit",
      md: "```bitrot\nlet a = 1\n```\n",
      want: [],
    },
    // An unterminated fence is dropped, not half-read.
    ExtractCase{
      name: "unterminated-fence",
      md: "```bit\nlet a = 1\n",
      want: [],
    },
  ]
}

function runExtractTests(): int {
  let cases = extractCases()
  // A shortened case list is a green run that proves nothing.
  assert(len(cases) == 5)

  let failed = 0
  for c of cases {
    let got = extractBlocks(c.md)
    if (len(got) != len(c.want)) {
      eprint("docs: FAIL extractBlocks/${c.name}: got ${len(got)} block(s), want ${len(c.want)}\n")
      failed = failed + 1
      continue
    }
    let i = 0
    let ok = true
    while (i < len(got)) {
      if (got[i] != c.want[i]) {
        eprint("docs: FAIL extractBlocks/${c.name}: block #${i + 1} was ${jsonish(got[i])}, want ${jsonish(c.want[i])}\n")
        ok = false
      }
      i = i + 1
    }
    if (!ok) {
      failed = failed + 1
    }
  }
  return failed
}

// A one-line, newline-escaped rendering, so a diff of captured text stays on one
// line and an empty value is visibly empty rather than invisible.
function jsonish(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let ch = s[i]
    if (ch == byte(10)) {
      out = out + "\\n"
    } else if (ch == byte(13)) {
      out = out + "\\r"
    } else if (ch == byte(34)) {
      out = out + "\\\""
    } else {
      out = out + string([]byte([ch]))
    }
    i = i + 1
  }
  return out + "\""
}

// The scratch tree, the compiler copy and the runner script. Built once.
function setup(root: string): Cfg {
  let docsDir = envOr("BIT_DOCS", "${root}/docs")
  if (!isDir(docsDir)) {
    die("BIT_DOCS is not a directory: ${docsDir}")
  }

  let stdlibDir = envOr("BIT_STDLIB", "${root}/stdlib")
  if (!isDir(stdlibDir)) {
    die("stdlib is not a directory: ${stdlibDir} (set BIT_STDLIB)")
  }

  // The compiler under test is the one built in this tree, never PATH's `bit`
  // — that is brew's release build, a different compiler entirely.
  let src = envOr("BIT", "${root}/bit-out/bin/bit")
  if (!exists(src)) {
    die("compiler under test is missing: ${src} (set BIT)")
  }

  let dir = "/tmp/bit-docsgate-${nonce()}"
  mkdir(dir) catch e {
    die("mkdir ${dir}: ${e.message()}")
  }

  let bin = "${dir}/bit"
  spill(bin, slurp(src, "compiler under test"), "compiler copy")
  if (fsChmod(bin, 493) != 0) {
    die("chmod ${bin}")
  }

  let cfg = Cfg{
    bin: bin,
    stdlibDir: stdlibDir,
    docsDir: docsDir,
    dir: dir,
    jobs: fanout(),
    script: "${dir}/run.sh",
    countPath: "${dir}/n.txt",
    timeoutMs: deadlineMs(),
  }
  writeRunner(cfg)
  return cfg
}

// How many `bit check` run at once. 12 is where the measured curve flattens
// (303s serial, 56s at 8, 48s at 12, 50s at 16 — beyond that they contend); a
// fixed number rather than a core count because Bit cannot ask for one, with
// `BIT_DOCS_JOBS` as the knob for a smaller host. Below 2 the plumbing
// self-test's slot-mapping check has nothing to distinguish.
function fanout(): int {
  let raw = envOr("BIT_DOCS_JOBS", "12")
  let jobs = parseInt(raw) catch _ {
    die("BIT_DOCS_JOBS is not an integer: ${jsonish(raw)}")
    12
  }
  if (jobs < 2 || jobs > maxFanout) {
    die("BIT_DOCS_JOBS must be between 2 and ${maxFanout}, got ${jobs}")
  }
  return jobs
}

// The bound on the one runner invocation. 0 disables the bound in the Zig
// harnesses; ABI.md §19 has no "forever", so it maps to the one-hour clamp
// rather than being silently treated as 0ms.
function deadlineMs(): i64 {
  let raw = envOr("BIT_TEST_TIMEOUT_S", "300")
  let timeoutS = parseInt(raw) catch _ {
    die("BIT_TEST_TIMEOUT_S is not an integer: ${jsonish(raw)}")
    300
  }
  if (timeoutS <= 0) {
    return i64(3600000)
  }
  return i64(timeoutS) * 1000
}

// Written ONCE, then never touched again: rewriting a script between execs is
// the ETXTBSY hazard. It reads its per-batch input (`n.txt`) rather than being
// regenerated, and `echo $?` on its own line after the compiler is the
// load-bearing token — that file IS the snippet's verdict, and `slotResult`
// aborts rather than assume anything when it is missing.
//
// `mkdir` is the claim, because it is the one atomic test-and-set POSIX sh has:
// exactly one worker can create `c$id`, so exactly one worker runs job `id` and
// a loser moves straight on. That is what makes workers PULL work. `</dev/null`
// stops the background workers sharing the shell's stdin, and `wait` with no
// operand waits for all of them, so the runner cannot return while a check is
// still writing its status.
function writeRunner(cfg: Cfg) {
  spill(cfg.script,
    "#!/bin/sh\n" +
    "BIT_STDLIB='${cfg.stdlibDir}'\n" +
    "export BIT_STDLIB\n" +
    "cd '${cfg.dir}' || exit 111\n" +
    "n=$(cat n.txt) || exit 112\n" +
    "[ \"$n\" -ge 1 ] || exit 113\n" +
    "w=0\n" +
    "while [ \"$w\" -lt ${cfg.jobs} ]; do\n" +
    "  (\n" +
    "    id=0\n" +
    "    while [ \"$id\" -lt \"$n\" ]; do\n" +
    "      if mkdir \"c$id\" 2>/dev/null; then\n" +
    "        '${cfg.bin}' check \"w$id\" >\"o$id\" 2>&1\n" +
    "        echo $? >\"s$id\"\n" +
    "      fi\n" +
    "      id=$((id+1))\n" +
    "    done\n" +
    "  ) </dev/null &\n" +
    "  w=$((w+1))\n" +
    "done\n" +
    "wait\n" +
    "exit 0\n",
    "runner script")
  if (fsChmod(cfg.script, 493) != 0) {
    die("chmod ${cfg.script}")
  }
}

// std/fs has no recursive delete, so every leaf is named. Failures here are
// reported, not fatal: the run's verdict is already decided.
function teardown(cfg: Cfg) {
  for p of [cfg.script, cfg.countPath, cfg.bin] {
    drop(p)
  }
  // Every slot the batch COULD have used, not just the ones it did: a bounded
  // sweep is cheaper to trust than a second copy of the batch size.
  let i = 0
  while (i < maxJobs) {
    drop(slotMain(cfg, i))
    drop(slotOut(cfg, i))
    drop(slotStatus(cfg, i))
    drop(slotClaim(cfg, i))
    drop(slotDir(cfg, i))
    i = i + 1
  }
  drop(cfg.dir)
}

function drop(path: string) {
  if (exists(path)) {
    remove(path) catch e { eprint("docs: warning: cannot remove ${path}: ${e.message()}\n") }
  }
}

// Every .md file under `docsDir`, in walk order and bounded by maxFiles.
function docPages(docsDir: string): []string {
  let all = walk(docsDir) catch e {
    // Never swallowed into an empty list: an empty corpus passes every
    // assertion that is not a floor.
    die("cannot walk ${docsDir}: ${e.message()}")
    []string(0)
  }
  if (len(all) > maxFiles) {
    die("${docsDir} holds ${len(all)} entries, over the maxFiles bound of ${maxFiles}")
  }
  let pages = []string(0)
  for p of all {
    if (hasSuffix(p, ".md")) {
      pages = append(pages, p)
    }
  }
  return pages
}

// What the corpus walk observed. Every field is asserted afterwards; none is
// merely reported.
struct Stats {
  pages: int
  pagesWithBlocks: int
  pagesWithoutBlocks: int
  totalBlocks: int
  invocations: int
  failures: int
}

// One page's jobs: one per block for a per-block page, otherwise one for the
// whole page with its blocks joined in document order.
function pageJobs(page: string, md: string, blocks: []string): []Job {
  let out = []Job(0)
  if (contains(md, perBlockMarker)) {
    let i = 0
    while (i < len(blocks)) {
      out = append(out, Job{ page: page, block: i + 1, blocks: len(blocks), src: blocks[i] })
      i = i + 1
    }
    return out
  }
  return append(out, Job{ page: page, block: 0, blocks: len(blocks), src: joinBlocks(blocks) })
}

// Walks the corpus and queues every snippet, checking nothing. Extraction is
// separated from execution so the runner gets one full queue — a per-page
// fan-out would idle every worker on the 30 pages that yield a single job.
function planCorpus(pages: []string): Plan {
  let st = Stats{ pages: len(pages), pagesWithBlocks: 0, pagesWithoutBlocks: 0,
    totalBlocks: 0, invocations: 0, failures: 0 }
  let jobs = []Job(0)
  for page of pages {
    let md = slurp(page, "doc page")
    let blocks = extractBlocks(md)
    if (len(blocks) == 0) {
      st.pagesWithoutBlocks = st.pagesWithoutBlocks + 1
      continue
    }
    if (len(blocks) >= maxBlocksPerFile) {
      die("${page} hit the maxBlocksPerFile bound of ${maxBlocksPerFile}; blocks past it are silently unchecked")
    }
    st.pagesWithBlocks = st.pagesWithBlocks + 1
    st.totalBlocks = st.totalBlocks + len(blocks)
    for j of pageJobs(page, md, blocks) {
      if (len(jobs) >= maxJobs) {
        die("more than ${maxJobs} snippets queued; the corpus outgrew this harness's bound")
      }
      jobs = append(jobs, j)
    }
  }
  return Plan{ jobs: jobs, st: st }
}

// A failure, named by page and by block — the whole point of batching
// carefully: the message must be what it was one-snippet-per-process.
function reportFailure(j: Job, r: CheckResult) {
  if (j.block > 0) {
    eprint("\ndocs: FAIL ${j.page} block #${j.block} does not typecheck (status ${r.code}):\n${r.report}\n--- snippet ---\n${j.src}\n")
    return
  }
  eprint("\ndocs: FAIL ${j.page} (${j.blocks} blocks, joined) does not typecheck (status ${r.code}):\n${r.report}\n--- joined module ---\n${j.src}\n")
}

// Every queued job, in one batch. Results come back in submission order, so
// result i is job i — the mapping the plumbing self-test pins before this runs.
function runJobs(cfg: Cfg, jobs: []Job, st: Stats): Stats {
  let out = st
  let srcs = []string(0)
  for j of jobs {
    srcs = append(srcs, j.src)
  }
  let rs = runBatch(cfg, srcs)
  // A short result list would silently drop the tail of the corpus.
  assert(len(rs) == len(jobs))

  let i = 0
  while (i < len(jobs)) {
    out.invocations = out.invocations + 1
    if (rs[i].code != 0) {
      out.failures = out.failures + 1
      reportFailure(jobs[i], rs[i])
    }
    i = i + 1
  }
  return out
}

// The floors, each naming what it would have caught — a bare number in a
// failure message is a puzzle rather than a diagnosis.
function checkFloors(st: Stats): int {
  let floored = 0
  if (st.pagesWithBlocks < minPagesWithBlocks) {
    eprint("docs: FLOOR: only ${st.pagesWithBlocks} page(s) yielded blocks, want >= ${minPagesWithBlocks} — the corpus shrank or the fence match broke\n")
    floored = floored + 1
  }
  if (st.totalBlocks < minTotalBlocks) {
    eprint("docs: FLOOR: only ${st.totalBlocks} block(s) extracted, want >= ${minTotalBlocks} — a cursor that stops after the first block per page lands here\n")
    floored = floored + 1
  }
  if (st.invocations < minInvocations) {
    eprint("docs: FLOOR: only ${st.invocations} check invocation(s), want >= ${minInvocations} — per-block pages are being joined, or pages are being skipped\n")
    floored = floored + 1
  }
  if (st.pagesWithoutBlocks * 2 >= st.pages) {
    eprint("docs: FLOOR: ${st.pagesWithoutBlocks} of ${st.pages} page(s) yielded nothing — the info-string test is rejecting real fences\n")
    floored = floored + 1
  }
  return floored
}

function main() {
  let cfg = setup(repoRoot())

  // Unit first: a broken extractor makes every corpus number meaningless.
  let unitFailures = runExtractTests()
  if (unitFailures != 0) {
    teardown(cfg)
    eprint("docs: FAILED — ${unitFailures} extractBlocks unit case(s)\n")
    osExit(1)
  }

  // Plumbing second, and before a single page is read.
  plumbingSelfTest(cfg)

  let pages = docPages(cfg.docsDir)
  if (len(pages) == 0) {
    teardown(cfg)
    eprint("docs: FAILED — no .md files under ${cfg.docsDir}\n")
    osExit(1)
  }

  let plan = planCorpus(pages)
  let st = runJobs(cfg, plan.jobs, plan.st)
  teardown(cfg)

  let floored = checkFloors(st)
  if (st.failures != 0 || floored != 0) {
    eprint("docs: FAILED — ${st.failures} page/block failure(s), ${floored} floor violation(s) over ${st.pages} page(s) in ${cfg.docsDir}\n")
    osExit(1)
  }
  print("docs: ok — ${st.totalBlocks} block(s) over ${st.pagesWithBlocks} page(s), ${st.invocations} check invocation(s), ${st.pages} .md file(s) in ${cfg.docsDir}\n")
}
