// One bounded std/regex compile+match check, run as a fresh subprocess by
// tests/bit/regexfuzz.bit's Runner — the same isolation shape
// tests/bit/fuzz.bit uses for `bit check <mutant>` (ABI.md §19's
// osRunBounded). A candidate pattern is compiled and, when it compiles,
// matched against five fixed subjects. Isolating each candidate in its own
// process is what makes a genuine hang or memory-safety crash in std/regex
// recoverable and attributable to one exact pattern, instead of wedging the
// whole fuzz campaign.
//
// The candidate PATTERN is read as raw bytes from the file named by argv[1]
// — never passed as argv itself, since a generated pattern may contain
// invalid UTF-8 or a NUL byte, neither of which survives shell argv
// reliably.
//
// Exit codes. `0` is the only passing outcome; every other code is a finding
// for the driver's classifier, which treats "not exactly 0" (short of the
// crash/timeout/spawn-failure bands `regexfuzz.bit` already carves out) as a
// bug regardless of which of these fired — the split below exists only so a
// human re-running a saved case by hand
// (`bit run tests/bit/regexfuzzcase.bit <file>`) can read `$?` and know
// which invariant broke without re-reading stderr:
//
//   0  every check on this candidate passed
//   4  usage or I/O error — the harness itself is broken, not a finding
//   5  compile() failed, but the error message did not start "regex: "
//   6  compile() accepted a pattern over the documented 4096-byte cap
//      (stdlib/regex/parse.bit's maxPatternLength)
//   7  a match invariant was violated: either 0<=start<=end<=len(s) failed,
//      or text(s) disagreed with s[start:end]
//
// A genuine bug surfacing as an uncaught runtime panic exits 2 (the golden
// `// panic` convention) or kills the process with a signal; either way this
// file never calls panic() itself, and the driver's classifier does not need
// to distinguish that from 5/6/7 — both are "not 0", both are findings.
// `Regex.split` is not covered here: #2036 (epic #2025) has not landed, so
// std/regex exports only `matches`/`find`/`findAll` today — this file
// exercises everything that exists.

import { compile, Regex, Match } from "std/regex"
import { readFile } from "std/fs"
import { args, exit } from "std/os"
import { hasPrefix, repeat } from "std/strings"

const exitUsage: int = 4
const exitBadErrorPrefix: int = 5
const exitLengthCapEscape: int = 6
const exitInvariant: int = 7

// stdlib/regex/parse.bit's own `maxPatternLength`, duplicated here as a
// literal rather than imported: it is not exported (only `Regex`,
// `compile` and the match surface are — regex.bit's header), and a
// fuzz oracle checking a cap from OUTSIDE the module is the whole point —
// an oracle that read the module's own constant could never see the module's
// own bug in applying it.
const maxPatternBytes: int = 4096

// Five fixed subjects every successfully-compiled candidate is matched
// against: empty, plain ASCII, multi-byte UTF-8, deliberately invalid UTF-8
// (an overlong encoding, two lone continuation/lead bytes and a raw UTF-16
// surrogate half — none of them valid UTF-8, chosen to hit different
// rejection paths in the rune decoder), and 4 KiB of repeated text.
fn subjects(): []string {
  let out = []string(0)
  out = append(out, "")
  out = append(out, "the quick brown fox jumps over 42 lazy dogs")
  out = append(out, "héllo wörld 日本語 emoji 🚀 done")
  out = append(out, string([]byte{ 0xC0, 0x80, 0xFF, 0xFE, 0x41, 0x80, 0xED, 0xA0, 0x80 }))
  out = append(out, repeat("a", 4096))
  return out
}

fn subjectLabels(): []string {
  return ["empty", "ascii", "utf8", "invalid-utf8", "repeated-4k"]
}

// The two invariants #2038 asks for on every match found, checked against
// the SAME subject the match was produced from: a span outside the subject
// is a memory-safety bug in slicing, not merely a wrong answer, so this exits
// distinctly rather than merely printing.
fn checkMatch(m: Match, s: string, where: string) {
  if (m.start < 0 || m.start > m.end || m.end > len(s)) {
    eprint("regexfuzzcase: invariant: ${where}: span [${m.start},${m.end}) outside [0,${len(s)}]\n")
    exit(exitInvariant)
  }
  if (m.text(s) != s[m.start:m.end]) {
    eprint("regexfuzzcase: invariant: ${where}: text(s) disagrees with s[start:end]\n")
    exit(exitInvariant)
  }
}

// matches/find/findAll(-1) against one subject. `matches` is a bool
// predicate — nothing to check on it beyond "it returned" (the caller's
// osRunBounded already proves that). `find`/`findAll` are where a span could
// escape the subject.
fn checkSubject(re: Regex, s: string, label: string) {
  let _ = re.matches(s)

  match (re.find(s)) {
    Some(m) => checkMatch(m, s, "${label} find")
    None => {}
  }

  let all = re.findAll(s, -1)
  let i = 0
  while (i < len(all)) {
    checkMatch(all[i], s, "${label} findAll[${i}]")
    i = i + 1
  }
}

// compile()'s two required outcomes (#2038 item 2): a `Regex`, or a caught
// error whose message begins "regex: ". Anything else — an error with the
// wrong prefix, or (item 4/the cap check) a `Regex` from a pattern over the
// documented byte cap — is this file's own finding, not a crash, so it is
// checked and exited on explicitly rather than left to fall out the bottom.
fn checkCandidate(pattern: string) {
  let re = compile(pattern) catch e {
    let msg = e.message()
    if (!hasPrefix(msg, "regex: ")) {
      eprint("regexfuzzcase: compile error missing 'regex: ' prefix: ${msg}\n")
      exit(exitBadErrorPrefix)
    }
    return
  }
  if (len(pattern) > maxPatternBytes) {
    eprint("regexfuzzcase: compile() accepted a ${len(pattern)}-byte pattern, over the ${maxPatternBytes}-byte cap\n")
    exit(exitLengthCapEscape)
  }

  let subs = subjects()
  let labels = subjectLabels()
  let i = 0
  while (i < len(subs)) {
    checkSubject(re, subs[i], labels[i])
    i = i + 1
  }
}

fn main() {
  let a = args()
  if (len(a) < 2) {
    eprint("regexfuzzcase: usage: bit run tests/bit/regexfuzzcase.bit <pattern-file>\n")
    exit(exitUsage)
  }
  let pattern = readFile(a[1]) catch e {
    eprint("regexfuzzcase: read ${a[1]}: ${e.message()}\n")
    exit(exitUsage)
    ""
  }
  checkCandidate(pattern)
}
