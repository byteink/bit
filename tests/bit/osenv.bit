// `std/os` argument + environment access (#354), Bit-native replacement for
// tests/osenv.zig.
//
// The property: a compiled Bit binary's `env(name)` reads the LIVE per-process
// environment its parent handed it at exec, not a snapshot baked in at compile
// time and not a stub. It is proven by running ONE unchanged binary five times
// with identical argv and reading back five different answers for the same
// name — four injected values plus the unset case.
//
// The binary under test is this program's own executable, copied byte-for-byte
// into a scratch directory; a process whose `arg(0)` names that copy takes the
// fixture role. Every fixture failure is a DISTINCT non-zero exit code, so a
// fixture that no-ops, dies early, or reads a hardwired empty string cannot
// score the value the harness is waiting for. `osRunTestBounded`'s own -1
// (fork failed), -2 (timed out) and 127 (the fork succeeded but `execve` did
// not — a missing or non-executable path lands here, NOT on -1) are all
// rejected before the value is compared, so "nothing ran at all" is a loud
// failure rather than a silent pass (#1637: a hang is a failure, not a stall).
import { arg, argc, args, env, envOr, exit, selfExe } from "std/os"
import { readFile, writeFile, mkdir, remove } from "std/fs"
import { hasSuffix, parseInt } from "std/strings"

// Wall-clock bound on every child, mirroring `pmCheckTimeoutMs`.
const osenvTimeoutMs: int = 20000

// Basename of the scratch copy. `arg(0)` ending in "/" + this is what selects
// the fixture role, and `bit run`'s own temp name never ends that way.
const osenvFixtureName: string = "osenv-fixture"

// The unset leg's sentinel: the fixture found BIT_TEST_INDEX empty.
const osenvUnsetCode: int = 251

function osenvFail(msg: string) {
  eprint("FAIL osenv: " + msg + "\n")
  exit(1)
}

// --- fixture role -----------------------------------------------------------

// Runs in the copied binary. Reports what THIS process's environment says, as
// an exit code; every failure path is a distinct sentinel so a failure is
// attributable and no path can collide with a legitimate index (0-250).
function osenvFixtureMain() {
  // A deep inherited entry, not the one the harness prepends: if envp capture
  // were broken wholesale this dies here rather than looking like "unset".
  if (len(env("PATH")) == 0) {
    exit(249)
  }
  if (envOr("BIT_OSENV_ABSENT", "default") != "default") {
    exit(252)
  }
  if (len(args()) != argc()) {
    exit(253)
  }
  if (argc() != 1) {
    exit(254)
  }
  if (len(arg(0)) == 0) {
    exit(254)
  }
  let raw = env("BIT_TEST_INDEX")
  if (len(raw) == 0) {
    exit(osenvUnsetCode)
  }
  let idx = parseInt(raw) catch e { 0 - 1 }
  if (idx < 0 || idx > 250) {
    exit(255)
  }
  exit(idx)
}

// --- harness ----------------------------------------------------------------

// Names the fixture sentinels so a failure report says what the child decided
// rather than printing a bare number.
function osenvWhy(code: int): string {
  if (code == 249) {
    return "fixture saw an empty PATH — inherited environment lost entirely"
  }
  if (code == osenvUnsetCode) {
    return "fixture read BIT_TEST_INDEX as empty — the injected value never arrived"
  }
  if (code == 252) {
    return "fixture saw BIT_OSENV_ABSENT set — envOr fallback broken"
  }
  if (code == 253) {
    return "fixture saw len(args()) != argc()"
  }
  if (code == 254) {
    return "fixture saw a bad argv (argc != 1 or empty arg(0))"
  }
  if (code == 255) {
    return "fixture could not parse BIT_TEST_INDEX"
  }
  return "unexpected exit code"
}

// Rejects the run-level outcomes that mean no useful observation happened.
// `what` names the leg so the failure is attributable.
function osenvMustHaveRun(what: string, code: int) {
  if (code == 0 - 1) {
    osenvFail("${what}: spawn failed (-1) — the fixture never ran")
  }
  if (code == 0 - 2) {
    osenvFail("${what}: timed out after ${osenvTimeoutMs}ms")
  }
  if (code <= 0 - 100) {
    osenvFail("${what}: killed by signal ${0 - 100 - code}")
  }
  if (code < 0) {
    osenvFail("${what}: negative result ${code}")
  }
  // The runtime forks, then execs; a missing or non-executable path fails in
  // the child, which exits 127 rather than reporting -1 to the parent.
  if (code == 127) {
    osenvFail("${what}: exec failed (127) — the fixture binary is missing or not executable")
  }
}

// A per-run scratch suffix, so a leftover directory from an earlier run can
// never stand in for this one's (`scratchNonce` in compiler/build.bit, minus
// the top byte so the name reads as a positive number).
function osenvNonce(): uint {
  let b = []byte(cryptoRandomBytes(8))
  let x: uint = 0
  let i = 0
  while (i < 7) {
    x = (x << 8) | uint(b[i])
    i = i + 1
  }
  return x
}

function main() {
  if (hasSuffix(arg(0), "/" + osenvFixtureName)) {
    osenvFixtureMain()
    return
  }

  // The check injects BIT_TEST_INDEX, so an inherited one would mask the whole
  // result: every leg would agree with an environment nobody controlled.
  if (len(env("BIT_TEST_INDEX")) != 0) {
    osenvFail("BIT_TEST_INDEX is already set in this environment; unset it and rerun")
  }
  // The inheritance leg needs a variable that is NOT the prepended one.
  if (len(env("PATH")) == 0) {
    osenvFail("PATH is unset; the inheritance leg has nothing to check")
  }

  let self = selfExe()
  if (len(self) == 0) {
    osenvFail("selfExe() returned empty — no binary to copy")
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/osenv-" + "${osenvNonce()}"
  mkdir(scratch) catch e {
    osenvFail("mkdir ${scratch}: ${e.message()}")
  }
  let image = readFile(self) catch e {
    osenvFail("read ${self}: ${e.message()}")
    ""
  }
  if (len(image) == 0) {
    osenvFail("own executable ${self} read back empty")
  }
  let bin = scratch + "/" + osenvFixtureName
  writeFile(bin, image) catch e {
    osenvFail("write ${bin}: ${e.message()}")
  }
  if (fsChmod(bin, 493) != 0) {
    osenvFail("chmod 0755 ${bin} failed")
  }

  // THE ROUND TRIP: one unchanged binary, identical argv, four different values
  // read back for the same variable name.
  let want = [0, 1, 42, 250]
  let i = 0
  while (i < len(want)) {
    let idx = want[i]
    let got = osRunTestBounded(bin, idx, osenvTimeoutMs)
    osenvMustHaveRun("BIT_TEST_INDEX=${idx}", got)
    if (got != idx) {
      osenvFail("BIT_TEST_INDEX=${idx}: fixture reported ${got} (${osenvWhy(got)})")
    }
    i = i + 1
  }

  // THE UNSET LEG: same binary, same argv, nothing injected.
  let unset = osRunBounded(bin, osenvTimeoutMs)
  osenvMustHaveRun("unset", unset)
  if (unset != osenvUnsetCode) {
    osenvFail("unset leg: expected ${osenvUnsetCode}, got ${unset} (${osenvWhy(unset)})")
  }

  // Best-effort, and only after every assertion, so cleanup can never hide one.
  remove(bin) catch println("osenv: cleanup failed for ${bin}")
  remove(scratch) catch println("osenv: cleanup failed for ${scratch}")
  println("PASS osenv: env() round-tripped 0,1,42,250 and read empty when unset (5 runs of one unchanged binary)")
}
