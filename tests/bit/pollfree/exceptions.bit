// tests/bit/pollfree/exceptions.bit — the reviewed exception list for the
// poll-free gate (#3001's split of `tests/bit/pollfree.bit`, which crossed
// the 800-line limit once #3000 added group (f5)'s three deadline-bounded
// ABI wrappers).
//
// Sibling of `pollfree.bit` in the same directory module: no `import`, one
// shared scope. This file is pure data — no consts, no structs — and calls
// nothing beyond the builtin `append`, so the import-per-module trap
// (#2867's `rootabi` split hit it first: re-importing a name the module
// already imports elsewhere is `E0042 already declared in this scope`) does
// not apply here. `pollFreeExceptions()` below is what `pollfree.bit`'s
// `main` calls; the four `exceptions*()` tables it assembles, and every
// per-entry justification comment, moved here VERBATIM from the original
// file.

// ---------------------------------------------------------------------------
// The reviewed exception list — carried across VERBATIM from
// `tests/rootabi_pollfree.zig`, per-entry justifications intact. It was
// hand-audited and cannot be cheaply reconstructed.
// ---------------------------------------------------------------------------

// Functions under the covered subtrees that are deliberately NOT poll-free.
//
// EVERY ENTRY IS A CLAIM THAT THE FUNCTION HOLDS NO GC OBJECT AS A RAW
// ADDRESS, not merely that annotating it was inconvenient. Adding a line here
// is a review decision; the groups and their reasons:
//
// (a) `float{big,fmt,parse}.bit` and the two `floats.bit` wrappers — genuinely
//     MANAGED Bit code, allocating bignum limb arrays, digit buffers and
//     `string`s, so `@nosplit` (which forbids allocation) is not available to
//     them. #1658 gave them the property instead of the annotation: every raw
//     address now lives inside `packLowBytes`/`unpackToWords`, which ARE
//     `@nosplit`, and the outer bodies hold only managed values.
// (b) `rootconfig.bit`/`testindex.bit` — they read the kernel-supplied `envp`
//     block, so every address they carry is outside the heap. They could not be
//     annotated anyway: `len(<literal>)` is not `@nosplit`-callable.
// (c) `{darwin,linux}/boot.bit`'s boot machinery — must reach the scheduler,
//     thread and park layers and run user `main`, which E0075 would forbid. It
//     carries only raw kernel addresses (argv/envp/auxv, `mapPages` stacks).
// (d) `{darwin,linux}/time.bit`'s three ABI pins — every parameter and result
//     is a scalar `int`; no object crosses them in either direction.
//
// The one list is spelled across four functions ONLY because a single one
// exceeds `max-fn-lines`. The split follows the group boundaries above, so no
// entry is separated from the reasoning that admitted it; `pollFreeExceptions`
// is the whole list and is the only thing the gate reads.
fn pollFreeExceptions(): []string {
  let out = []string(0)
  for e of exceptionsFloatText() {
    out = append(out, e)
  }
  for e of exceptionsEnvBoot() {
    out = append(out, e)
  }
  for e of exceptionsRandNetEngine() {
    out = append(out, e)
  }
  for e of exceptionsNetAbi() {
    out = append(out, e)
  }
  return out
}

// (a) managed float text — see `runtime/root/floats.bit`'s SEAM 5a block.
fn exceptionsFloatText(): []string {
  return [
    "root:bigLimbs",
    "root:bigNew",
    "root:bigSetU64",
    "root:bigNorm",
    "root:bigCopy",
    "root:bigCmp",
    "root:bigAdd",
    "root:bigSub",
    "root:bigMulSmall",
    "root:bigMulAddSmall",
    "root:bigShl",
    "root:bigShr1",
    "root:bigBitLen",
    "root:bigIsZero",
    "root:bigMulPow10",
    "root:fmtMaxDigits",
    "root:fmtBits",
    "root:dragon4",
    "root:highTest",
    "root:render",
    "root:zeros",
    "root:u64BitLen",
    "root:floorDiv",
    "root:parseMaxDigits",
    "root:parseBits",
    "root:assembleBits",
    "root:hexDigitVal",
    "root:parseHexBits",
    "root:roundShiftRight",
    "root:infBits",
    "root:rtStringFromFloat",
    "root:rtParseFloat",
  ]
}

// (b) envp readers, (c) boot machinery, (d) clocks and sleep.
fn exceptionsEnvBoot(): []string {
  return [
    // (b) envp readers — no heap object in play.
    "root:gcEnvValuePtr",
    "root:gcEnvKeyMatch",
    "root:gcCstrEq",
    "root:gcCstrUsize",
    "root:gcEnvEnabled",
    "root:gcEnvStress",
    "root:gcEnvMinTrigger",
    "root:gcEnvGrowthPct",
    "root:gcEnvMarkStack",
    "root:gcEnvWorkers",
    "root:gcEnvVerbose",
    "root:rootConfigureFromEnv",
    "root:rootEnvVerbose",
    "root:rootEnvMarkStack",
    "root:rootEnvWorkers",
    "root:testIndexParse",
    "root:rtTestIndex",
    // (c) boot machinery — reaches the scheduler/thread/park layers and `main`.
    "root/darwin:workerBody",
    "root/darwin:joinWorker",
    "root/darwin:mainTrampoline",
    "root/darwin:boot",
    "root/darwin:machoMain",
    "root/linux:workerBody",
    "root/linux:joinWorker",
    "root/linux:mainTrampoline",
    "root/linux:boot",
    "root/linux:initLinuxTls",
    "root/linux:rtStartMain",
    // (d) clocks and sleep — scalars only, and `sleep_ns` parks.
    "root/darwin:rtTimeMonoNs",
    "root/darwin:rtTimeUnixNs",
    "root/darwin:rtTimeSleepNs",
    "root/linux:rtTimeMonoNs",
    "root/linux:rtTimeUnixNs",
    "root/linux:rtTimeSleepNs",
  ]
}

// (e) `runtime/rand`, and (f1)/(f2) of `runtime/net`.
fn exceptionsRandNetEngine(): []string {
  return [
    // -----------------------------------------------------------------------
    // (e) `runtime/rand` (#1667) — one per platform, and only because `panic`
    //     is not `@nosplit`-callable. The allocate-and-fill half IS `@nosplit`
    //     (`randomBytesFill`); what is left here is straight-line with NO LOOP,
    //     and the one call it makes while `s` is set — `panic` — is on the
    //     branch where `s` is the `randEntropyFailed` sentinel rather than an
    //     object, and never returns. See `rand/*/random.bit`.
    "rand/darwin:rtRandomBytes",
    "rand/linux:rtRandomBytes",
    // -----------------------------------------------------------------------
    // (f) `runtime/net` (#1668) — THE PARK LAYER. Every entry from here down
    //     rests on claim (b) in this file's header: it holds no raw GC
    //     address, so a poll or a park inside it is harmless. `@nosplit` is not
    //     merely inconvenient for these, it is unavailable — E0075 is transitive
    //     and the subtree reaches `schedPark`. Each was confirmed refused by the
    //     compiler rather than assumed: marking them yields
    //     "calls 'netAwaitReady', which is not marked nosplit" (the engine),
    //     "calls 'fsOpen'" (`readResolvConf`) or "may not allocate" (the four
    //     wrappers that own a managed scratch).
    //
    //     (f1) The socket engine. Buffers arrive as `*u8` PARAMETERS pointing
    //     into memory the caller owns and keeps alive; these frames hold no
    //     object address of their own. `netAwaitReady` is the parker itself.
    "net/darwin:netAwaitReady",
    "net/linux:netAwaitReady",
    "net/darwin:netAcceptTcp",
    "net/darwin:netDialTcp",
    "net/darwin:netReadSock",
    "net/darwin:netWriteSock",
    "net/linux:netAcceptTcp",
    "net/linux:netDialTcp",
    "net/linux:netReadSock",
    "net/linux:netWriteSock",
    "net/darwin:netRecvFrom",
    "net/darwin:netSendTo",
    "net/linux:netRecvFrom",
    "net/linux:netSendTo",
    //     (f2) `readResolvConf` — reads into the caller's managed `[]i64`
    //     scratch through a `*u8`; owns no object. Refused `@nosplit` because
    //     `fsOpen`/`fsClose` are RtFn builtins.
    "net/darwin:readResolvConf",
    "net/linux:readResolvConf",
  ]
}

// (f3) and (f4) of `runtime/net` — the `netabi.bit` ABI wrappers.
fn exceptionsNetAbi(): []string {
  return [
    //     (f3) The ABI wrappers that pass a caller's `string` STRAIGHT THROUGH
    //     to the parking engine as `strData(s)`. `s` is a raw `int` here, but
    //     the object is rooted by the compiled Bit caller's own stack-map slot —
    //     the runtime never allocated it, so unlike #1656's `rtFsReadAll` there
    //     IS a frame that names it, and the precise walk covers every frame of
    //     the running task.
    "net/darwin:netAbiAccept",
    "net/darwin:netAbiDial",
    "net/darwin:netAbiUdpSend",
    "net/darwin:netAbiWrite",
    "net/linux:netAbiAccept",
    "net/linux:netAbiDial",
    "net/linux:netAbiUdpSend",
    "net/linux:netAbiWrite",
    //     (f4) The four wrappers that ALLOCATE a receive buffer — this ticket's
    //     actual defect, and now the reason they cannot be `@nosplit`: their
    //     buffers are MANAGED `[]i64` locals and `@nosplit` forbids allocation
    //     outright. That is the fix, not a workaround; a managed local is a
    //     stack-map slot, which is precisely what the raw `rtStrAlloc` address
    //     they used to hold was not.
    "net/darwin:netAbiRead",
    "net/darwin:netAbiUdpRecv",
    "net/darwin:netAbiUdpSenderHost",
    "net/darwin:netAbiResolve",
    "net/linux:netAbiRead",
    "net/linux:netAbiUdpRecv",
    "net/linux:netAbiUdpSenderHost",
    "net/linux:netAbiResolve",
    //     (f5) #2291/#3000: the three deadline-bounded ABI wrappers that pack a
    //     caller's word-strided `[]byte` into a PACKED scratch before handing it
    //     to the deadline-bounded socket engine below (`netDialTcpDeadline`/
    //     `netReadSockDeadline`/`netWriteSockDeadline`, all `@nosplit` — see
    //     ../../../runtime/net/darwin/tcp.bit's "Deadline-bounded" section). Same
    //     reasoning and same shape as (f4) above: `[]i64(scratchWords(...))` is a
    //     MANAGED local, a real stack-map slot, so `@nosplit` is refused only
    //     because it forbids allocation outright (confirmed by the compiler:
    //     E0075 "may not allocate or call indirectly here", underlining the
    //     slice literal) — not because a raw address survives a poll. The engine
    //     calls below never see the managed local itself, only the packed `*u8`
    //     address computed from it, which is the identical contract every other
    //     ABI wrapper in this file already relies on.
    "net/darwin:netAbiDialDeadlineW",
    "net/darwin:netAbiReadDeadlineW",
    "net/darwin:netAbiWriteDeadlineW",
    "net/linux:netAbiDialDeadlineW",
    "net/linux:netAbiReadDeadlineW",
    "net/linux:netAbiWriteDeadlineW",
  ]
}
