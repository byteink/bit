// Benchmark regression gate (#2931): builds and runs bench/cases/{collatz,
// mandelbrot,fib,alloc,churn} with the compiler under test and fails when
// either peak RSS or user CPU time regresses past 1.5x a baseline recorded
// below. "churn" (#2978) is a leak guard, not a speed benchmark: a live set
// of one object allocated 4,000,000 times, run with BIT_GC_MIN_KB pinned via
// Baseline.gcMinKb -- see runtime/gc/gcindex.bit's idxGrow (#2756/#2922) for
// the bug this catches.
//
// WHY THIS EXISTS. docs/perf-regression-rca.md records a 4-5x compute
// regression and an 18x peak-RSS regression that shipped across many
// releases with every gate in `./make test` staying green, because nothing
// in the suite measured performance at all — both were only found by a human
// running `bench/run.sh` by hand, 1470 commits after the fact (#2920,
// #2921). This is the gate that would have caught them the day they landed.
//
// WHY NOT `bench/run.sh`. That script needs `go` and `cc` on PATH, runs 7
// iterations per case per LANGUAGE (Bit, Go, C), and rewrites three tracked
// files (README.md, bench/RESULTS.md, bench/history.csv) — a gate must not
// mutate the tree, and 7x3 external-toolchain builds is not a suite cost.
// This measures Bit only, against baselines recorded in this file rather
// than read from bench/history.csv: its newest rows predate #2920 and still
// encode the bug (`alloc` RSS = 161529856), which is exactly the number
// #2920 fixed.
//
// WHY PEAK RSS AND USER CPU, NEVER WALL CLOCK. This repo already has three
// open tickets (#2401, #2415, #2422) about absolute wall-clock deadlines
// reddening the suite purely from host load. Peak RSS is a kernel-tracked
// high-water mark, unaffected by what else the box is doing. User CPU time is
// time actually spent executing on a core, not time spent waiting for one —
// measured on this host while writing this gate, `user` stayed within 0.06s
// across 7 runs of the same binary. `real` (wall clock) is never read below.
//
// WHY MINIMUM OF N, NOT MEAN. Contention and scheduling noise can only ever
// make one run cost MORE than its true floor, never less, so the minimum of
// `reps` independent runs is the statistic noise cannot inflate — the same
// reasoning tests/bit/schedbench.bit's header gives for context-switch
// timing.
//
// WHY 1.5x, AND WHY IT NEVER FIRES ON AN IMPROVEMENT. The regressions this
// gate exists to catch were 4-5x and 18x — the bar only needs to clear gross
// breakage, not police day-to-day noise. The check is a strict
// greater-than against `baseline * 1.5`, so a benchmark that gets faster or
// leaner can only pass more easily, never fail. CPU (not RSS) can override
// this per case via Baseline.cpuCeilingPct — fib does (#2982), because its
// baseline is small enough in absolute terms that 1.5x cannot absorb real
// multi-agent scheduling noise; see fib's own baseline-table comment.
//
// WHY OUTPUTS ARE ASSERTED TOO. A benchmark that returns the wrong answer
// quickly is exactly the failure mode a pure-timing gate cannot see, so
// every run's stdout is compared byte-for-byte against the known-correct
// value before its cost is even considered.
//
// SUBPROCESS MECHANICS, as tests/bit/golden.bit and tests/bit/lspcache.bit:
// each case is built once with the compiler under test, then run `reps`
// times through a generated `/bin/sh` wrapper via `osRunBounded` (no rusage
// primitive is reachable from Bit itself). The wrapper is the only
// platform-specific part: macOS's `/usr/bin/time -l` reports both user CPU
// seconds and maximum resident set size (bytes) from ONE run; Linux has no
// such tool guaranteed present, so it backgrounds the binary and polls
// `/proc/<pid>/status` (`VmHWM`, itself a kernel-maintained high-water mark —
// any read taken late in the run already reflects the true peak) and
// `/proc/<pid>/stat` (utime+stime, the same two fields
// tests/bit/fsblock.bit's `cpu()` helper already reads and was mutation-
// tested for, #2207).
//
// Run from the repository root:
//   ./bit-out/bin/bit run tests/bit/benchgate.bit
// Needs BIT_BIN (the compiler under test), BIT_LIBBITRT (the runtime
// archive to link against) and BIT_BENCH_DIR (bench/cases) — no defaults.

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, exists, mkdir } from "std/fs"
import { trimSpace, parseInt, split } from "std/strings"

// Independent timed runs per case; the MINIMUM of each series is compared to
// baseline. 3 costs roughly one pass of the 4 cases' combined baseline CPU
// (~4.6s) times 3, plus 4 one-time builds — under 20s measured, inside the
// ~30s budget #2931 set (#2747's lint gate, at 21s, is the precedent for
// what a suite addition may cost).
const reps: int = 3

// FAIL when measured > baseline * 3 / 2 (i.e. > 1.5x). Integer arithmetic
// throughout so there is no float-rounding edge case in the comparison. Used
// for RSS on every case, and for CPU on every case except where
// Baseline.cpuCeilingPct overrides it -- see cpuCeiling() below and #2982.
fn ceiling(baseline: int): int {
  return baseline * 3 / 2
}

// CPU ceiling, per-case (#2982). `ceiling()` above is 150 (1.5x) for every
// case; fib overrides Baseline.cpuCeilingPct to 190 because its baseline
// (29cs on macOS/arm64) is too small in absolute terms for 1.5x to absorb
// real scheduling noise in this gate's actual operating environment (a
// single unshared run, per the full-suite-owns-this-gate note below) — see
// fib's own baseline-table comment for the measurements. Integer
// arithmetic, same reasoning as ceiling() above.
fn cpuCeiling(b: Baseline): int {
  return b.cpuCentis * b.cpuCeilingPct / 100
}

// Generous per-subprocess bound; every case finishes in under 3s and this
// only matters if something hangs. `BIT_TEST_TIMEOUT_S` widens it the same
// way every other harness in this suite honors it.
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "60")) catch _ {
    60
  }
  if (s <= 0) {
    return 60000
  }
  return s * 1000
}

struct Baseline {
  name: string,
  expected: string,
  cpuCentis: int,
  rssBytes: int,
  // 0 means "do not set BIT_GC_MIN_KB; inherit the runtime's own default".
  // Non-zero pins the GC trigger floor explicitly for this case's run so its
  // RSS does not silently drift if a future ticket changes the default
  // (#2920 already moved it once). See the "churn" case below (#2978).
  gcMinKb: int,
  // CPU ceiling as a percentage of cpuCentis (150 = 1.5x, the file's blanket
  // default -- see ceiling() above). RSS always uses the blanket 1.5x
  // regardless of this field; only CPU reads it, via cpuCeiling(). fib
  // overrides this to 190 (#2982) -- see its baseline-table comment.
  cpuCeilingPct: int,
}

// Baselines are per-platform (#2933): a Skylake-class x86_64-linux box is
// nowhere near an Apple Silicon Mac's per-instruction throughput, and using
// one table for both turned every real-Linux run of this gate into a false
// positive. Keyed on `hostTarget()`'s ordinal — BOTH platform and
// architecture, never `uname -s` alone — because scripts/arm64gate.sh runs
// this gate on aarch64-linux, whose numbers are nothing like x86_64-linux's;
// a table keyed on "linux" would compare aarch64 against an x86_64 baseline
// and produce a confidently wrong verdict. See hostTriple() in
// tests/bit/pathresolve.bit for the same ordinal spelled as a triple.
fn platformName(target: int): string {
  if (target == 0) {
    return "linux/x86_64"
  }
  if (target == 1) {
    return "linux/aarch64"
  }
  if (target == 2) {
    return "macos/aarch64"
  }
  return "unknown hostTarget() ordinal ${target}"
}

// Measured fresh on `main` @ 368d654a (2026-08-12, after #2920 and #2921 both
// landed), minimum of 7 runs each via `/usr/bin/time -l` on an idle host —
// NOT read from bench/history.csv (see the file header for why). Re-measure
// rather than hand-edit these if they drift:
//   BIT_STDLIB=stdlib ./bit-out/bin/bit build bench/cases/<name>/<name>.bit -o /tmp/b
//   /usr/bin/time -l /tmp/b   # repeat a few times; take the minimum `user` and RSS
fn baselinesMacosArm64(): []Baseline {
  return [
    Baseline{
      name: "collatz",
      expected: "524",
      cpuCentis: 83,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    Baseline{
      name: "mandelbrot",
      expected: "204866964",
      cpuCentis: 121,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2982: fib's baseline (29cs) is too small in absolute terms for the
    // blanket 1.5x ceiling (43cs) to absorb real scheduling noise -- it was
    // the reliable false-positive repro (FAIL at 45/54/47cs against 43cs).
    //
    // WHICH DATASET CALIBRATES THIS, AND WHY. `test-benchgate` is registered
    // only as a `Gate{}` (this file's own registration in
    // tools/build/gates.bit), reachable from `./make test` — it has no entry
    // in any `scripts/gate.sh` bucket (verified: neither `bench` nor
    // `benchgate` appears in that script except in the unrelated bench/*.md
    // doc-only carve-out). So its real deployment is a single unshared
    // full-suite run, per this repo's own rule that the full suite runs once
    // per push with the box to itself -- NOT the heavy concurrent-agent
    // scenario this ticket was first (wrongly) calibrated against. Load
    // average 30-44 readings taken under 3 concurrent make-driver builds are
    // real but unrepresentative of how this gate actually runs; they are
    // recorded on #3017 instead (along with the sharper, genuinely new
    // finding that user CPU itself, not just wall clock, is measurably noisy
    // at that intensity -- a limit on the load-insensitivity the file header
    // claims for this metric, but one that does not affect this gate in its
    // designed environment).
    //
    // The relevant dataset is 16 consecutive `./make test-benchgate` runs at
    // load average 5.1-10.8 (1-3 sibling make-driver builds; the ticket's own
    // "at least 2 concurrent make-driver builds" scenario): fib's minCpu
    // ranged 31-43cs (1.07-1.48x baseline), sitting AT the old 43cs ceiling
    // once -- one scheduling hiccup from red. The same session also caught a
    // real FAIL on alloc (347cs against its own untouched 346cs ceiling);
    // alloc's ceiling is intentionally not touched here (see #3017).
    //
    // BASELINE, re-checked directly rather than inferred from the ticket's
    // 31-32cs benchgate-mediated "quiet" readings (which were themselves
    // taken under load 5-10, not truly idle): `BIT_STDLIB=stdlib
    // ./bit-out/bin/bit build bench/cases/fib/fib.bit -o /tmp/b`, then 7
    // direct `/usr/bin/time -l /tmp/b` runs with zero concurrent make-driver
    // builds (load average ~5, background-agent noise only) read 29/29/29/
    // 30/30/30/31cs -- minimum 29cs, exactly matching the recorded baseline.
    // 29cs is confirmed correct; this is a ceiling fix, not a re-baseline.
    //
    // THE CEILING: cpuCeilingPct raises fib's CPU ceiling from 150 (1.5x =
    // 43cs) to 190 (1.9x = 55cs on macOS/arm64), clearing the worst reading
    // in the representative dataset (43cs) by 12cs/28% margin, while sitting
    // 3cs below an exact 2x regression (58cs) so a genuine doubling clears
    // the ceiling with room rather than landing on the boundary.
    // Mutation-tested at load average 8.8-13.6 (2-3 sibling make-driver
    // builds, matching the representative dataset above): temporarily made
    // bench/cases/fib/fib.bit's `main` call `fib(40)` twice (exactly 2x the
    // compute, output unchanged) -- measured 89cs, FAILed against the 55cs
    // ceiling with a 34cs margin. Reverted (confirmed byte-identical via
    // `git diff --stat`) and re-ran at the same load: 33cs, PASS. fib.bit
    // itself is unchanged in this commit. Re-baselining fib's workload
    // upward (bench/cases/fib/fib.bit, e.g. fib(41) or higher) was
    // considered and rejected: it would change the case's `expected` output
    // on every platform, invalidating baselinesLinuxX64's fib entry (real
    // hardware, hl-master, not reachable from this session to re-measure).
    Baseline{
      name: "fib",
      expected: "102334155",
      cpuCentis: 29,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 190,
    },
    Baseline{
      name: "alloc",
      expected: "59995000000",
      cpuCentis: 231,
      rssBytes: 10698752,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2978. Regression guard for the GC address->object index leak
    // (#2756/#2922, fixed 32a4888d): bench/cases/churn/churn.bit holds a live
    // set of exactly ONE object across 4,000,000 allocations, which is the
    // shape that drove runtime/gc/gcindex.bit's idxGrow to abandon the whole
    // rehashed table into the bump-only gcIdxRes reserve after every sweep.
    // BIT_GC_MIN_KB is pinned to 64 (not inherited) so this case's RSS cannot
    // silently drift if a future ticket changes the runtime default (#2920
    // already moved it once) -- see gcMinKb's field comment above.
    //
    // RSS baseline measured fresh on main @ 0ebcd2a5 (2026-08-13): 1982464
    // bytes in 17 of 18 direct /usr/bin/time -l runs, all taken while 2-3
    // other agents' make-driver builds ran concurrently (load average
    // 8.8-15.9 on an 18-core host); the one outlier read 2048000 (+3.3%).
    // That confirms peak RSS here is load-insensitive to the precision this
    // file's header claims -- a single-digit-percent blip, not jitter that
    // could plausibly approach a 1.5x ceiling.
    //
    // User CPU did NOT hold as steady: the same 18 runs ranged 49-120
    // centiseconds depending on which other builds were mid-selfhost at the
    // same moment, wider than the "0.06s across 7 runs" this file's header
    // reports for the original 4 cases on a quiet host -- this dev box was
    // never quiet this session. Rather than record the rare-best-case
    // minimum and risk a flaky red on an ordinary contended run (a min-of-3
    // during the ACTUAL gate hit 73cs against a 73cs ceiling at baseline 49 --
    // verified too close), the baseline below is the highest of the 18
    // direct samples, so CPU is a slack secondary check here and RSS carries
    // this case's regression detection, consistent with peak RSS -- not CPU
    // or wall clock -- being the property this specific defect ever affected
    // (collections/swept were IDENTICAL between fixed and reverted builds;
    // see below).
    //
    // THE CEILING, stated: ceiling() below applies this file's blanket 1.5x
    // to every case. For RSS that is 1982464 * 3 / 2 = 2973696 bytes.
    // Reverting #2922's fix (32a4888d) and rebuilding reproduces 85934080
    // bytes (81.95 MB) -- 43.3x this baseline, 28.9x past the ceiling -- so a
    // real regression of this shape trips immediately with room to spare,
    // while the largest RSS blip observed under real contention (2048000,
    // 1.03x baseline) is nowhere near tripping it. collections/swept were
    // identical between the fixed and reverted builds in the mutation test
    // (2925 collections, ~3999983 swept either way), matching #2756's
    // "collected but never returned" finding, not a marking regression --
    // the leaked bytes were never live, so this is a pure RSS signature.
    Baseline{
      name: "churn",
      expected: "7999998000000",
      cpuCentis: 120,
      rssBytes: 1982464,
      gcMinKb: 64,
      cpuCeilingPct: 150,
    },
  ]
}

// Measured on real x86_64-linux hardware (hl-master, i7-6700@3.4GHz, 6
// vCPUs) by #2932 via `X64GATE_HOST=hl-master STEP=test-benchgate
// scripts/x64gate.sh`, taking the minimum of two independent cold-build runs
// ~10 minutes apart (#2933) — the same "minimum cannot be inflated by noise"
// reasoning the file header gives for `reps`:
//   run 1: collatz 328cs/233472B, mandelbrot 569cs/233472B, fib 101cs/229376B, alloc 1144cs/8818688B
//   run 2: collatz 327cs/229376B, mandelbrot 559cs/229376B, fib 101cs/225280B, alloc 1153cs/8749056B
// The ratio to the macOS/arm64 table above is NOT constant across cases
// (3.5x on fib, 3.9x collatz, 4.6x mandelbrot, 5.0x alloc) — a pure
// host-speed difference would be roughly constant, so part of the gap is
// x86_64 codegen quality, not clock speed alone (filed separately, not
// chased here: #2926 landed the x64 backend's first back-edge safepoint
// guard the same day these numbers were measured). RSS on this host is
// LOWER than macOS/arm64 (Linux's /proc VmHWM accounting differs from
// macOS's `/usr/bin/time -l`), well under its own ceiling.
fn baselinesLinuxX64(): []Baseline {
  return [
    Baseline{
      name: "collatz",
      expected: "524",
      cpuCentis: 327,
      rssBytes: 229376,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    Baseline{
      name: "mandelbrot",
      expected: "204866964",
      cpuCentis: 559,
      rssBytes: 229376,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // cpuCeilingPct: 190, same #2982 fix and same ratio as
    // baselinesMacosArm64's fib entry above -- the small-absolute-baseline
    // noise mechanism is not macOS-specific, but this exact number is
    // unverified on this platform: no load-5-10 dataset exists for
    // hl-master, only #2932/#2933's two cold-build runs on an otherwise
    // idle host.
    Baseline{
      name: "fib",
      expected: "102334155",
      cpuCentis: 101,
      rssBytes: 225280,
      gcMinKb: 0,
      cpuCeilingPct: 190,
    },
    Baseline{
      name: "alloc",
      expected: "59995000000",
      cpuCentis: 1144,
      rssBytes: 8749056,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2978's churn case has NOT been measured on this platform (no Linux
    // host in this session) -- omitted rather than guessed, matching
    // baselinesLinuxArm64's precedent below. baselinesFor's per-platform
    // table length means this is safe: main()'s completion check compares
    // against len(table), not a hardcoded case count.
  ]
}

// linux/aarch64 (scripts/arm64gate.sh) has never been measured on a quiet
// host — #2932 correctly skipped it because this Mac had three concurrent
// builds running at the time (#2933). Returning an empty table here, rather
// than a guess or a borrowed platform's numbers, is what makes
// `baselinesFor` below fail loudly instead of comparing the wrong pair.
fn baselinesLinuxArm64(): []Baseline {
  return []
}

// Selects the baseline table for the host this gate is actually running on.
fn baselinesFor(target: int): []Baseline {
  if (target == 0) {
    return baselinesLinuxX64()
  }
  if (target == 1) {
    return baselinesLinuxArm64()
  }
  if (target == 2) {
    return baselinesMacosArm64()
  }
  return []
}

// --- shell plumbing ----------------------------------------------------

// Wraps `s` as exactly one POSIX `/bin/sh` word.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn mkdirQuiet(path: string) {
  mkdir(path) catch e {
    return
  }
}

// A scratch root whose path is already lexically canonical (the trailing-
// slash hazard is tests/bit/lspcache.bit's #2410 — `TMPDIR` ends in `/` on
// macOS, and a doubled separator has bitten a gate here before).
fn scratchRoot(): string {
  let base = envOr("TMPDIR", "/tmp")
  while (len(base) > 1 && base[len(base) - 1] == '/') {
    base = base[0:len(base) - 1]
  }
  return base + "/bit-benchgate-${timeUnixNs()}"
}

// `osRunBounded`'s three non-zero outcomes rendered as a message (ABI.md
// §19), same encoding as tests/bit/stress/verify.bit's `runMsg`.
fn runMsg(code: int): string {
  if (code == 0) {
    return ""
  }
  if (code == 0 - 1) {
    return "SPAWN FAILED (fork/exec/wait error)"
  }
  if (code == 0 - 2) {
    return "TIMED OUT after ${timeoutMs()}ms (raise BIT_TEST_TIMEOUT_S)"
  }
  if (code <= 0 - 100) {
    return "CRASHED: killed by signal ${0 - code - 100}"
  }
  return "exited ${code}"
}

// --- build ---------------------------------------------------------------

fn buildScript(
  bit: string, libbitrt: string, stdlib: string, srcPath: string,
  binPath: string, outPath: string, errPath: string,
): string {
  let s = "#!/bin/sh\n"
  if (stdlib != "") {
    s = s + "BIT_STDLIB=" + shQuote(stdlib) + "\nexport BIT_STDLIB\n"
  }
  if (libbitrt != "") {
    s = s + "BIT_LIBBITRT=" + shQuote(libbitrt) + "\nexport BIT_LIBBITRT\n"
  }
  s = s +
    "exec " +
    shQuote(bit) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(binPath) +
    " > " +
    shQuote(outPath) +
    " 2> " +
    shQuote(errPath) +
    "\n"
  return s
}

// --- measure ---------------------------------------------------------------

// One run's user-CPU-and-peak-RSS wrapper. Dispatches on `uname -s` so a
// single generated script serves both gate platforms (macOS dev host, real
// aarch64/x86_64 Linux via scripts/{arm64,x64}gate.sh) — see the file header
// for why each branch works the way it does. The wrapper's own `exit`
// re-raises the BENCHMARK's exit code, so `osRunBounded`'s return value is
// the thing that failed, not "the wrapper script", and non-zero there is
// treated as a hard failure by the caller.
//
// Result file format: one line, three space-separated decimals —
// "<benchmark exit code> <user CPU centiseconds> <peak RSS bytes>" — with -1
// standing in for "not measured" on either metric, never a silent 0 (the
// same convention tests/bit/lspcache.bit's `intAfter` uses).
fn measureScript(bin: string, outPath: string, resPath: string, gcMinKb: int): string {
  let rawPath = resPath + ".raw"
  let s = "#!/bin/sh\n"
  // Exported before the platform dispatch below so it reaches the benchmark
  // child on either branch. 0 means "leave BIT_GC_MIN_KB unset" (see the
  // Baseline.gcMinKb field comment).
  if (gcMinKb > 0) {
    s = s + "BIT_GC_MIN_KB=${gcMinKb}\nexport BIT_GC_MIN_KB\n"
  }
  s = s + "case \"$(uname -s)\" in\n"
  s = s + "  Darwin)\n"
  s = s +
    "    /usr/bin/time -l " +
    shQuote(bin) +
    " >" +
    shQuote(outPath) +
    " 2>" +
    shQuote(rawPath) +
    "\n"
  s = s + "    ec=$?\n"
  // `/usr/bin/time -l`'s first line is fixed-format: "<real> real <user> user
  // <sys> sys", so the user-seconds value is always field 3 of the line
  // matching " user". `(u*100)+0.5` rounds to the nearest centisecond.
  s = s +
    "    awk -v ec=$ec 'BEGIN{u=-1;r=-1} / user/{u=$3} " +
    "/maximum resident set size/{r=$1} END{printf \"%d %d %d\\n\", ec, (u*100)+0.5, r}' " +
    shQuote(rawPath) +
    " > " +
    shQuote(resPath) +
    "\n"
  s = s + "    exit $ec\n"
  s = s + "    ;;\n"
  s = s + "  *)\n"
  s = s + "    " + shQuote(bin) + " >" + shQuote(outPath) + " &\n"
  s = s + "    pid=$!\n"
  s = s + "    cpu=-1\n"
  s = s + "    hwm=-1\n"
  s = s + "    while kill -0 $pid 2>/dev/null; do\n"
  s = s + "      if [ -r /proc/$pid/status ]; then\n"
  s = s + "        v=$(awk '/VmHWM/{print $2}' /proc/$pid/status 2>/dev/null)\n"
  s = s + "        case $v in\n"
  s = s + "          '') ;;\n"
  s = s + "          *) hwm=$v ;;\n"
  s = s + "        esac\n"
  s = s + "      fi\n"
  // `sed 's/.*) //'` strips through the LAST ')' so a comm field containing
  // its own parens cannot shift the column count; the remaining fields'
  // 12th and 13th are utime+stime — tests/bit/fsblock.bit's `cpu()` reads
  // the same two fields the same way, mutation-tested for #2207.
  s = s + "      if [ -r /proc/$pid/stat ]; then\n"
  s = s + "        c=$(sed 's/.*) //' /proc/$pid/stat 2>/dev/null | awk '{print $12+$13}')\n"
  s = s + "        case $c in\n"
  s = s + "          '') ;;\n"
  s = s + "          *) cpu=$c ;;\n"
  s = s + "        esac\n"
  s = s + "      fi\n"
  s = s + "      sleep 0.05\n"
  s = s + "    done\n"
  s = s + "    wait $pid\n"
  s = s + "    ec=$?\n"
  s = s + "    CLK=$(getconf CLK_TCK 2>/dev/null || echo 100)\n"
  s = s + "    cpuCs=-1\n"
  s = s + "    rssB=-1\n"
  s = s + "    if [ $cpu -ge 0 ]; then cpuCs=$((cpu * 100 / CLK)); fi\n"
  s = s + "    if [ $hwm -ge 0 ]; then rssB=$((hwm * 1024)); fi\n"
  s = s + "    printf \"%d %d %d\\n\" $ec $cpuCs $rssB > " + shQuote(resPath) + "\n"
  s = s + "    exit $ec\n"
  s = s + "    ;;\n"
  s = s + "esac\n"
  return s
}

struct Measured {
  ok: bool,
  exitCode: int,
  cpuCentis: int,
  rssBytes: int,
  out: string,
}

// `trimSpace` (std/strings) only strips spaces and tabs, not newlines — the
// result file's line always ends in the `\n` awk's/printf's own `%s\n`
// emitted, so that has to go before `split` sees it or the last field keeps
// a trailing `\n` and fails `parseInt`.
fn trimTrailingNl(s: string): string {
  let hi = len(s)
  while (hi > 0 && (s[hi - 1] == '\n' || s[hi - 1] == '\r')) {
    hi = hi - 1
  }
  return s[0:hi]
}

fn parseMeasured(resText: string, outText: string): Measured {
  let parts = split(trimSpace(trimTrailingNl(resText)), " ")
  if (len(parts) != 3) {
    return Measured{ ok: false, exitCode: 0, cpuCentis: 0, rssBytes: 0, out: outText }
  }
  let ec = parseInt(parts[0]) catch _ {
    return Measured{ ok: false, exitCode: 0, cpuCentis: 0, rssBytes: 0, out: outText }
  }
  let cpu = parseInt(parts[1]) catch _ {
    return Measured{ ok: false, exitCode: 0, cpuCentis: 0, rssBytes: 0, out: outText }
  }
  let rss = parseInt(parts[2]) catch _ {
    return Measured{ ok: false, exitCode: 0, cpuCentis: 0, rssBytes: 0, out: outText }
  }
  return Measured{ ok: true, exitCode: ec, cpuCentis: cpu, rssBytes: rss, out: outText }
}

// --- tally -----------------------------------------------------------------

struct Tally { checks: int, failures: int }

fn markFail(t: Tally, msg: string) {
  t.failures = t.failures + 1
  eprint("FAIL benchgate: " + msg + "\n")
}

fn minInt(a: int, b: int): int {
  if (a < b) {
    return a
  }
  return b
}

// --- one case ----------------------------------------------------------

fn runCase(
  bit: string, libbitrt: string, stdlib: string, benchDir: string,
  scratch: string, b: Baseline, t: Tally,
) {
  let caseScratch = scratch + "/" + b.name
  mkdirQuiet(caseScratch)

  let srcPath = benchDir + "/" + b.name + "/" + b.name + ".bit"
  let binPath = caseScratch + "/bin"
  let buildOut = caseScratch + "/build.out"
  let buildErr = caseScratch + "/build.err"
  let buildSh = caseScratch + "/build.sh"

  writeFile(buildSh, buildScript(bit, libbitrt, stdlib, srcPath, binPath, buildOut, buildErr)) catch e {
    markFail(t, "${b.name}: cannot write build script: " + e.message())
    return
  }
  if (fsChmod(buildSh, 448) != 0) { // 0o700
    markFail(t, "${b.name}: cannot chmod build script")
    return
  }
  let buildCode = osRunBounded(buildSh, timeoutMs())
  if (buildCode != 0) {
    let berr = readFile(buildErr) catch e {
      ""
    }
    markFail(t, "${b.name}: build failed (${runMsg(buildCode)}): ${berr}")
    return
  }
  if (!exists(binPath)) {
    markFail(t, "${b.name}: build reported success but ${binPath} does not exist")
    return
  }

  // Sentinels above any measurement this gate could ever legitimately see —
  // the check after the loop proves a real run replaced them, the same shape
  // tests/bit/schedbench.bit's `benchTrials` uses.
  let minCpu = 1000000000
  let minRss = 1000000000
  let sawOne = false

  let rep = 0
  while (rep < reps) {
    let outPath = caseScratch + "/run${rep}.out"
    let resPath = caseScratch + "/run${rep}.res"
    let runSh = caseScratch + "/run${rep}.sh"
    writeFile(runSh, measureScript(binPath, outPath, resPath, b.gcMinKb)) catch e {
      markFail(t, "${b.name} rep ${rep}: cannot write run script: " + e.message())
      rep = rep + 1
      continue
    }
    if (fsChmod(runSh, 448) != 0) {
      markFail(t, "${b.name} rep ${rep}: cannot chmod run script")
      rep = rep + 1
      continue
    }
    // The wrapper's own exit re-raises the benchmark's exit code (see
    // measureScript's header), so a non-zero, non-timeout, non-signal code
    // here means the BENCHMARK itself failed, not the harness.
    let code = osRunBounded(runSh, timeoutMs())
    if (code == 0 - 2 || code == 0 - 1 || code <= 0 - 100) {
      markFail(t, "${b.name} rep ${rep}: ${runMsg(code)}")
      rep = rep + 1
      continue
    }
    let resText = readFile(resPath) catch e {
      ""
    }
    let outText = readFile(outPath) catch e {
      ""
    }
    let m = parseMeasured(resText, outText)
    if (!m.ok) {
      markFail(t, "${b.name} rep ${rep}: no parseable result line (got '${resText}')")
      rep = rep + 1
      continue
    }
    if (m.exitCode != 0) {
      markFail(t, "${b.name} rep ${rep}: benchmark exited ${m.exitCode}")
      rep = rep + 1
      continue
    }
    if (m.cpuCentis < 0 || m.rssBytes < 0) {
      markFail(
        t,
        "${b.name} rep ${rep}: measurement unavailable (cpu=${m.cpuCentis} rss=${m.rssBytes})",
      )
      rep = rep + 1
      continue
    }
    let got = trimSpace(trimTrailingNl(m.out))
    if (got != b.expected) {
      markFail(
        t,
        "${b.name} rep ${rep}: printed '${got}', want '${b.expected}' — wrong answer, cost not trusted",
      )
      rep = rep + 1
      continue
    }
    minCpu = minInt(minCpu, m.cpuCentis)
    minRss = minInt(minRss, m.rssBytes)
    sawOne = true
    rep = rep + 1
  }

  if (!sawOne) {
    markFail(t, "${b.name}: no successful run out of ${reps}")
    return
  }

  // CPU reads its own per-case ceiling (#2982); RSS always uses the blanket
  // 1.5x — see cpuCeiling()'s and Baseline.cpuCeilingPct's comments above.
  let cpuCeil = cpuCeiling(b)
  let rssCeil = ceiling(b.rssBytes)
  // Printed unconditionally, pass or fail, so a slow drift toward the
  // ceiling is visible in the suite log before it ever trips (#2931).
  print(
      "benchgate: ${b.name} cpu=${minCpu}cs (baseline ${b.cpuCentis}cs, ceiling ${cpuCeil}cs) " +
      "rss=${minRss}B (baseline ${b.rssBytes}B, ceiling ${rssCeil}B)\n",
  )

  if (minCpu > cpuCeil) {
    markFail(
      t,
        "${b.name} user CPU regressed: ${minCpu}cs (min of ${reps}), " +
        "baseline ${b.cpuCentis}cs, ceiling ${cpuCeil}cs (${b.cpuCeilingPct}%)",
    )
  }
  if (minRss > rssCeil) {
    markFail(
      t,
        "${b.name} peak RSS regressed: ${minRss}B (min of ${reps}), " +
        "baseline ${b.rssBytes}B, ceiling ${rssCeil}B (150%)",
    )
  }
  t.checks = t.checks + 1
}

// --- driver ------------------------------------------------------------

fn main() {
  let bit = envOr("BIT_BIN", "")
  if (bit == "" || !exists(bit)) {
    eprint("FAIL benchgate: BIT_BIN='${bit}' does not exist — refusing to guess\n")
    exit(1)
  }
  let libbitrt = envOr("BIT_LIBBITRT", "")
  if (libbitrt == "" || !exists(libbitrt)) {
    eprint("FAIL benchgate: BIT_LIBBITRT='${libbitrt}' does not exist — refusing to guess\n")
    exit(1)
  }
  let benchDir = envOr("BIT_BENCH_DIR", "")
  if (benchDir == "" || !exists(benchDir)) {
    eprint("FAIL benchgate: BIT_BENCH_DIR='${benchDir}' does not exist — refusing to guess\n")
    exit(1)
  }
  let stdlib = env("BIT_STDLIB")

  let target = hostTarget()
  let table = baselinesFor(target)
  if (len(table) == 0) {
    eprint(
        "FAIL benchgate: no baseline recorded for ${platformName(target)}; " +
        "measure one on a quiet host and add it to baselines() in tests/bit/benchgate.bit\n",
    )
    exit(1)
  }

  let root = scratchRoot()
  mkdirQuiet(root)

  let t = Tally{ checks: 0, failures: 0 }
  for b of table {
    runCase(bit, libbitrt, stdlib, benchDir, root, b, t)
  }

  // Compared against the actual table length, not a hardcoded count (#2978):
  // platforms register different numbers of cases (baselinesLinuxX64 lacks
  // "churn"), so a fixed constant here would under-count a genuine failure
  // on whichever platform has the larger table.
  if (t.checks < len(table)) {
    eprint("FAIL benchgate: only ${t.checks} of ${len(table)} cases completed\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("benchgate: FAIL — ${t.failures} problem(s) across ${t.checks} case(s)")
    exit(1)
  }
  println("benchgate: PASS — ${t.checks} case(s) within 1.5x of baseline")
}
