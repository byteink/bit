// tests/bit/releasesurface.bit — gates a removed or re-signatured stdlib
// export against the PREVIOUS RELEASE's own source, using `bit doc --fields`
// as the instrument (#3039).
//
// THE DEFECT THIS CLOSES. 0.1.16 shipped four breaking stdlib changes and
// announced none of them: `dist/changelog.sh` buckets breaking changes off a
// conventional-commit `!`, so a human remembering to type one character was
// the only control, and it failed four times out of four. One of the four
// was `struct Exchange { conn, request }` -> `struct Exchange { conn }`
// (#2346) — a FIELD removal — and it broke a real downstream build
// (bit-website's `server/serve.bit`) the day it shipped.
//
// WHY `bit doc`, NOT `git grep '^export '`. The original audit used grep and
// found the three signature changes but missed the field removal entirely —
// grep collapses a struct's body to its opening line. `bit doc` derives the
// surface from the checker, so it sees fields. It did not always: this
// harness is the reason `compiler/doc.bit` grew a `--fields` flag (kept
// OFF by default there — see its own header for why turning it on
// unconditionally would break two OTHER gates that already depend on the
// unmodified shape).
//
// THE BASELINE, AND WHAT HAPPENS OFFLINE (the ticket's own caution). The
// "previous release" is the PINNED stage0 tarball
// (`dist/stage0/SHA256SUMS`), fetched/digest-verified/cached by
// `scripts/stage0.sh --stdlib-root` — the same mechanism every
// `selfhost-diff*.sh` differential already trusts for "an earlier version of
// this same compiler". That script refuses rather than silently skipping
// when it cannot reach its oracle (its own header: "a gate that cannot reach
// its oracle and exits 0 is worse than no gate"), and this harness inherits
// that behaviour rather than papering over it: on a machine with a cold
// `bit-out/stage0` cache AND no network, this gate hard-fails rather than
// passing vacuously. On every other run — including every run after the
// first on one machine — the cache is warm and no network is touched. This
// is the FIRST gate in `gateNames()` (tools/build/defs.bit) with that
// property; every other gate in `./make test` is fully offline.
//
// WHY THE SAME (CURRENT) COMPILER DOCUMENTS BOTH SIDES. The pinned stage0
// BINARY predates `--fields` — it cannot be asked to emit field lines, and
// there is no way to make an already-shipped release understand a flag added
// after it shipped. So this harness never runs the stage0 binary at all: it
// runs the CURRENT `bit doc --fields` twice, once against the baseline
// release's OWN `stdlib/` (unpacked from its tarball, so its cross-imports
// resolve against ITS OWN sibling modules, not the working tree's) and once
// against the working tree's `stdlib/`. Historical Bit source is expected to
// keep parsing under a newer compiler (the language evolves additively); a
// baseline module that no longer documents cleanly is reported and SKIPPED,
// the same "out of scope" treatment `selfhost-diffdoc.sh` already gives a
// module its own oracle cannot document — never silently folded into a pass.
//
// WHAT COUNTS AS BREAKING. A symbol (function, method, const, named type, or
// — because of `--fields` — a struct's own field, `Recv.field`) that existed
// in the baseline and is ABSENT from the current tree is "removed". One that
// exists in both but renders a different `kind` or a different signature
// text is "changed". A symbol that exists only in the CURRENT tree is an
// ADDITION and is never reported — 0.1.16 added 18 exports, and that is not
// a breaking release (the ticket's own constraint).
//
// THE ALLOWLIST. `tests/bit/releasesurface.allowlist` — one line per
// intentionally-shipped break, `<module> <symbol> <removed|changed>
// <#ticket>`. The ticket field is REQUIRED and validated to look like
// `#<digits>`: an allowlist entry with no ticket is a silent pass with no
// reviewable trail, exactly the property that let 0.1.16's four changes
// through unannounced. Comments start a line with `//`; blank lines are
// skipped.
//
// Usage (cwd is the repo root, as for every other build step):
//
//     bit run tests/bit/releasesurface.bit
//
// `bit run` forwards no argv, so every input comes from the environment:
//
//     BIT_REPO               repo root                          (REQUIRED)
//     BIT_SELF_EXE            the `bit` under test                (default: <cwd>/bit-out/bin/bit)
//     BIT_SURFACE_BASELINE    an explicit baseline stdlib root, bypassing
//                             scripts/stage0.sh entirely — how this harness
//                             was proven against the actual v0.1.15 -> v0.1.16
//                             boundary, and how a machine with no network but
//                             a hand-fetched older release can still run it
//     BIT_SURFACE_ALLOWLIST  path to the allowlist file (default:
//                             tests/bit/releasesurface.allowlist under
//                             BIT_REPO) — overridable so the allowlist
//                             mechanism itself can be mutation-tested without
//                             editing the committed file
//     BIT_TEST_TIMEOUT_S      per-invocation deadline in seconds  (default 300, 0 = none)

import { readDir, isDir, readFile, writeFile, exists, mkdir } from "std/fs"
import { env, envOr, exit } from "std/os"
import { hasPrefix, split, parseInt, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// std/strings exports no trimSuffix; tests/bit/constoverflow.bit carries the
// same small local helper for the same reason.
fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}

// std/strings' `trimSpace` strips only ASCII space and tab — NOT the
// trailing newline a captured child's stdout always carries. `trimWs`/`isWs`
// are tests/bit/lintcmd.bit's own local pair for exactly this (reading back
// a generated script's captured output), copied here for the same reason.
fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// Bounds, so every walk is provably finite (Power of 10 rule 2).
const maxModules: int = 64
const maxSymbolLines: int = 20000
const maxAllowlistLines: int = 4096

// Anti-vacuity floor on the baseline module COUNT. Today's baseline has 20
// module directories (the same stdlib layout as the working tree, modulo
// ordinary churn); set below that with room for a module being added,
// renamed or removed between releases.
const minModules: int = 15

const defaultTimeoutMs: int = 300000

fn timeoutMs(): int {
  let raw = envOr("BIT_TEST_TIMEOUT_S", "")
  if (len(raw) == 0) {
    return defaultTimeoutMs
  }
  let secs = parseInt(raw) catch e {
    eprint("releasesurface: BIT_TEST_TIMEOUT_S is not a number: ${raw}\n")
    return defaultTimeoutMs
  }
  if (secs <= 0) {
    return 0
  }
  return secs * 1000
}

// `osRunBounded` takes a path and nothing else — no argv, no environment, no
// stdout capture — so every child here is a generated `/bin/sh` script,
// matching the shape every other tests/bit/*.bit harness that shells out
// uses (e.g. tests/bit/constoverflow.bit's `shell`).
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("releasesurface: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("releasesurface: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("releasesurface: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("releasesurface: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// BIT_REPO is REQUIRED, same reason as test-lint-runtime/test-coldboot/
// test-spec: this harness locates stdlib/, scripts/stage0.sh and its own
// allowlist relative to it, and must not silently default to "." and read
// whatever directory it happened to be invoked from.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    eprint("releasesurface: BIT_REPO is required (see this file's own header)\n")
    exit(1)
    return ""
  }
  if (!isDir(r)) {
    eprint("releasesurface: BIT_REPO=${r} is not a directory\n")
    exit(1)
    return ""
  }
  return r
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise the dev-tree build
// artifact relative to the working directory this program was started in.
fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("releasesurface: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > \"${cwdFile}\"\n", ms)?
  if (code != 0) {
    fail newError("releasesurface: could not read the working directory (exit ${code})")
  }
  let cwd = trimWs(readFile(cwdFile)?)
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("releasesurface: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// The previous release's OWN `stdlib/` root. `BIT_SURFACE_BASELINE` wins —
// an explicit override, the same shape as every `selfhost-diff*.sh`
// differential's `DIFFDOC_ORACLE`-style variable, and how this harness is
// proven against the real v0.1.15 -> v0.1.16 boundary (the pinned stage0
// moves forward on every repin, so the ONLY way to pin the comparison to a
// specific pair of releases is to name the older one explicitly). Otherwise
// `scripts/stage0.sh --stdlib-root` resolves the currently-pinned release —
// see this file's own header for what that costs on a cold, offline machine.
fn baselineRoot(repo: string, scratch: string, ms: int): string! {
  let override = env("BIT_SURFACE_BASELINE")
  if (len(override) > 0) {
    if (!isDir(override)) {
      fail newError("releasesurface: BIT_SURFACE_BASELINE=${override} is not a directory")
    }
    return override
  }
  let outPath = "${scratch}/baseline.out"
  let errPath = "${scratch}/baseline.err"
  let script = "#!/bin/sh\n" +
    "exec sh \"" + repo + "/scripts/stage0.sh\" --stdlib-root >\"" + outPath + "\" 2>\"" + errPath + "\"\n"
  let code = shell("${scratch}/baseline.sh", script, ms)?
  if (code != 0) {
    let why = readFile(errPath) catch e { "" }
    fail newError("releasesurface: scripts/stage0.sh --stdlib-root failed (exit ${code}):\n${why}")
  }
  let root = trimWs(readFile(outPath)?)
  if (!isDir(root)) {
    fail newError("releasesurface: scripts/stage0.sh --stdlib-root printed a non-directory: ${root}")
  }
  return root
}

// The per-module directory list. `readDir` returns bare names, so `isDir` is
// asked about the joined path.
fn moduleList(stdRoot: string): []string {
  let entries = readDir(stdRoot) catch e {
    eprint("releasesurface: cannot read ${stdRoot}: ${e.message()}\n")
    return []string(0)
  }
  let mods = []string(0)
  let n = len(entries)
  if (n > maxModules) {
    n = maxModules
  }
  for (let i = 0; i < n; i = i + 1) {
    if (isDir(stdRoot + "/" + entries[i])) {
      mods = append(mods, entries[i])
    }
  }
  return mods
}

// Runs `<bin> doc --fields <moduleDir>` with BIT_STDLIB=<stdlibRoot> (so the
// module's own cross-imports resolve against the SAME release's sibling
// modules), capturing stdout/stderr under `scratch`. Returns ("", false) on
// any non-zero exit — the caller decides whether that is in-scope (the
// baseline side may legitimately fail to document) or a hard stop (the
// current tree must always document cleanly).
fn docModule(bin: string, stdlibRoot: string, moduleDir: string, scratch: string, tag: string, ms: int): (string, bool) {
  let outPath = "${scratch}/${tag}.out"
  let errPath = "${scratch}/${tag}.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=\"" + stdlibRoot + "\"\n" +
    "export BIT_STDLIB\n" +
    "exec \"" + bin + "\" doc --fields \"" + moduleDir + "\" >\"" + outPath + "\" 2>\"" + errPath + "\"\n"
  let code = shell("${scratch}/${tag}.sh", script, ms) catch e {
    panic("releasesurface: ${e.message()}")
    -1
  }
  if (code != 0) {
    return "", false
  }
  let text = readFile(outPath) catch e {
    panic("releasesurface: cannot read ${outPath}: ${e.message()}")
    ""
  }
  return text, true
}

// One symbol as `bit doc --fields` prints it in its plain form: `name` is
// the bare identifier (generics cut off, matching tests/bit/stdlibdocs.bit's
// own `cutAtGenerics` — a named type's or a generic function's line has no
// separate name column, so the whole remainder up to `<` is the name), and
// `sig` is everything after `kind` verbatim — the whole point of keeping it
// intact is that ANY difference in it (added/removed generic params, a
// changed parameter list, a changed result or field type) is a signature
// change worth reporting.
struct Symbol {
  kind: string
  name: string
  sig: string
}

// Joins `parts[start:]` with a single space each.
fn joinFrom(parts: []string, start: int): string {
  let rest = ""
  for (let j = start; j < len(parts); j = j + 1) {
    if (len(rest) > 0) {
      rest = rest + " "
    }
    rest = rest + parts[j]
  }
  return rest
}

// The bare symbol name: `s` up to (not including) its first `<`.
fn cutAtGenerics(s: string): string {
  let at = 0 - 1
  let i = 0
  while (i < len(s)) {
    if (s[i] == '<') {
      at = i
      break
    }
    i = i + 1
  }
  if (at < 0) {
    return s
  }
  return s[0:at]
}

fn parseSymbols(text: string): []Symbol {
  let out = []Symbol(0)
  let lines = split(text, "\n")
  let n = len(lines)
  if (n > maxSymbolLines) {
    n = maxSymbolLines
  }
  for (let i = 0; i < n; i = i + 1) {
    let line = lines[i]
    if (len(line) == 0) {
      continue
    }
    let parts = split(line, " ")
    if (len(parts) < 2) {
      continue
    }
    let kind = parts[0]
    let sig = joinFrom(parts, 1)
    let nameField = parts[1]
    if (kind == "struct" || kind == "enum" || kind == "interface" || kind == "type") {
      nameField = sig
    }
    out = append(out, Symbol{ kind: kind, name: cutAtGenerics(nameField), sig: sig })
  }
  return out
}

// One allowlist entry: an intentional break, named by the ticket that made
// it.
struct AllowEntry {
  module: string
  name: string
  change: string
  ticket: string
}

fn loadAllowlist(path: string): []AllowEntry {
  if (!exists(path)) {
    return []AllowEntry(0)
  }
  let text = readFile(path) catch e {
    panic("releasesurface: cannot read ${path}: ${e.message()}")
    ""
  }
  let lines = split(text, "\n")
  let n = len(lines)
  if (n > maxAllowlistLines) {
    panic("releasesurface: ${path} holds ${n} lines, over the maxAllowlistLines bound of ${maxAllowlistLines}")
  }
  let out = []AllowEntry(0)
  for (let i = 0; i < n; i = i + 1) {
    let raw = trimSpace(lines[i])
    if (len(raw) == 0 || hasPrefix(raw, "//")) {
      continue
    }
    let fields = split(raw, " ")
    if (len(fields) != 4) {
      eprint("releasesurface: ${path}:${i + 1}: expected 4 fields \"<module> <symbol> <removed|changed> <#ticket>\", got ${len(fields)}: ${raw}\n")
      exit(1)
    }
    let change = fields[2]
    if (change != "removed" && change != "changed") {
      eprint("releasesurface: ${path}:${i + 1}: change kind must be \"removed\" or \"changed\", got \"${change}\"\n")
      exit(1)
    }
    let ticket = fields[3]
    if (!hasPrefix(ticket, "#") || len(ticket) < 2) {
      eprint("releasesurface: ${path}:${i + 1}: ticket must look like \"#1234\" (a reviewable line, not a silent pass), got \"${ticket}\"\n")
      exit(1)
    }
    out = append(out, AllowEntry{ module: fields[0], name: fields[1], change: change, ticket: ticket })
  }
  return out
}

fn isAllowed(entries: []AllowEntry, mod: string, name: string, change: string): bool {
  for e of entries {
    if (e.module == mod && e.name == name && e.change == change) {
      return true
    }
  }
  return false
}

// One unallowlisted (or allowlisted) breaking difference.
struct Finding {
  module: string
  name: string
  change: string
  before: string
  after: string
}

// `old`'s symbols not present, or present with a different rendering, in
// `cur`. A symbol only in `cur` is an addition and is never reported here.
fn compareModule(mod: string, old: []Symbol, cur: []Symbol): []Finding {
  let curByName = map<string, Symbol>{}
  for s of cur {
    curByName[s.name] = s
  }
  let out = []Finding(0)
  for o of old {
    let (n, ok) = curByName[o.name]
    if (!ok) {
      out = append(out, Finding{ module: mod, name: o.name, change: "removed",
        before: "${o.kind} ${o.sig}", after: "" })
      continue
    }
    if (n.kind != o.kind || n.sig != o.sig) {
      out = append(out, Finding{ module: mod, name: o.name, change: "changed",
        before: "${o.kind} ${o.sig}", after: "${n.kind} ${n.sig}" })
    }
  }
  return out
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-releasesurface-${uuidFormat(uuidV4())}"
  mkdir(scratch) catch e {
    panic("releasesurface: cannot create ${scratch}: ${e.message()}")
  }
  defer teardown(scratch, ms)

  let repo = repoRoot()
  let bin = bitBinary(scratch, ms) catch e { panic("releasesurface: ${e.message()}") }
  let baseline = baselineRoot(repo, scratch, ms) catch e { panic("releasesurface: ${e.message()}") }
  let allowPath = envOr("BIT_SURFACE_ALLOWLIST", "${repo}/tests/bit/releasesurface.allowlist")
  let allow = loadAllowlist(allowPath)

  let oldMods = moduleList(baseline)
  if (len(oldMods) < minModules) {
    eprint("FAIL releasesurface: found ${len(oldMods)} module(s) under ${baseline}, expected at least ${minModules}\n")
    exit(1)
  }

  let curStdlib = "${repo}/stdlib"
  let compared = 0
  let skipped = 0
  let findings = 0
  let allowed = 0

  for m of oldMods {
    let oldDir = "${baseline}/${m}"
    let newDir = "${curStdlib}/${m}"

    let (oldText, oldOk) = docModule(bin, baseline, oldDir, scratch, "old-${m}", ms)
    if (!oldOk) {
      skipped = skipped + 1
      continue
    }
    let oldSyms = parseSymbols(oldText)
    if (len(oldSyms) == 0) {
      continue // an internal module with nothing exported: nothing to regress
    }

    let curSyms = []Symbol(0)
    if (isDir(newDir)) {
      let (curText, curOk) = docModule(bin, curStdlib, newDir, scratch, "cur-${m}", ms)
      // The CURRENT tree must always document cleanly — test-stdlib-docs and
      // test-selfhostcheck already assume it does. A failure here is a
      // harness/build problem, not a surface regression to skip past.
      if (!curOk) {
        panic("releasesurface: ${newDir} does not document cleanly under the compiler being gated")
      }
      curSyms = parseSymbols(curText)
    }

    compared = compared + 1
    let mname = "std/${m}"
    let diffs = compareModule(mname, oldSyms, curSyms)
    for f of diffs {
      if (isAllowed(allow, f.module, f.name, f.change)) {
        allowed = allowed + 1
        continue
      }
      findings = findings + 1
      eprint("releasesurface: BREAKING ${f.module} ${f.name} ${f.change}\n" +
        "  before: ${f.before}\n" +
        "  after:  ${f.after}\n" +
        "  to allow an intentional break, add \"${f.module} ${f.name} ${f.change} #<ticket>\" to ${allowPath}\n")
    }
  }

  if (compared == 0) {
    eprint("FAIL releasesurface: zero modules were compared against ${baseline} — no evidence this gate checked anything\n")
    exit(1)
  }

  if (findings > 0) {
    eprint("FAIL releasesurface: ${findings} unallowlisted breaking change(s) across ${compared} compared module(s) (${skipped} skipped, ${allowed} allowlisted)\n")
    exit(1)
  }

  println("PASS releasesurface: ${compared} module(s) compared against ${baseline}, 0 unallowlisted breaking change(s) (${allowed} allowlisted, ${skipped} skipped)")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came —
// same convention as tests/bit/constoverflow.bit's `teardown`.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf \"${scratch}\"\n", ms) catch _ { return }
}
