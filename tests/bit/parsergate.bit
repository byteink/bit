// Front-end BEHAVIOURS this tree introduced that no released compiler shares —
// gated the way tests/cases gates a `// run` case (build, run, byte-compare
// stdout against a pinned `.expected`), but driven from a directory the corpus
// differential does not sweep.
//
// The corpus, in tests/bit/parsercases/:
//   run_catch_precedence.bit   `catch` precedence, #2344
//   run_match_arm_sep.bit      match-arm `,`/`;` separator, #2100
//
// Plus one section with no corpus file: the #2022 expression nesting-depth
// limit, whose inputs are GENERATED here (4000 nested parens is not a file
// anyone should have to read, and its diagnostic renders the whole 8000-column
// line in the gutter, so there is no useful `.expected` to pin).
//
// WHY THESE LIVE OUTSIDE tests/cases/.
//
// The self-host differential family compares this compiler against the PINNED
// stage0 — the previous RELEASE of this same compiler — over
//     find stdlib examples tests/cases tests/imports -name '*.bit'
// and `scripts/selfhost-diffast.sh` requires the two `--dump-ast` renderings to
// be BYTE-IDENTICAL. A deliberate change to the expression grammar is exactly a
// tree the oracle renders differently, so a golden case under tests/cases/ IS
// the file that turns the differential red. Measured with
// run_catch_precedence.bit still in the sweep:
//
//   (let_decl (binding denied _ (catch_default (call read …) (binary == …))))   oracle
//   (let_decl (binding denied _ (binary == (catch_default (call read …) …) …))) here
//
// which is the fix, stated as a diff. diffir and difftypes read the same corpus
// and diverge for the same reason. Note this is NOT the tests/bit/checkerdiag.bit
// case: that one is about a REJECTION the oracle does not make (a diffcheck
// FALSEPOS). This is about a PARSE the oracle does not make, and it reddens
// diffast/diffir/difftypes even though both compilers exit 0.
//
// A known-divergence list is not the repair either: selfhost-diffcheck.sh
// refuses one on principle (#1883 — "a filter on a differential's ORACLE side
// can only ever hide a difference, never reveal one").
//
// Same placement, and the same reasoning, as tests/bit/checkerdiag.bit (#2377),
// tests/bit/constoverflow.bit (#2261) and tests/bit/genericdiag.bit.
//
// WHY IT RUNS THE PROGRAM RATHER THAN CHECKING IT.
//
// #2344's whole shape is "the compiler accepted it and then the binary
// SIGSEGVed", so an exit-code-only or `bit check`-only assertion is satisfied by
// the bug. Every case here is built AND run, and its stdout compared whole.
//
// NON-VACUITY. This repo has shipped guards that passed over empty input sets,
// so checkerdiag.bit's four floors are reproduced rather than assumed:
//
//   1. `BIT_PARSER_CASES_DIR` and `BIT_BIN` have NO defaults. Unset is a hard
//      failure, never a silent walk of ".".
//   2. The case count is pinned exactly (`expectedCases`). Adding or removing a
//      case must edit it in the same commit. "Fewer than max" is not a floor —
//      zero satisfies it.
//   3. Orphans are detected BOTH ways: every `.bit` needs a readable
//      `.expected` AND every `.expected` needs a `.bit`.
//   4. Line 1 of every case must be `// run`, so an `// error` case dropped in
//      here fails loudly instead of being judged by the wrong oracle, and a
//      wrapper that never reached its `exec` is a named failure rather than
//      "the program printed nothing".
//
// Usage:
//   BIT_PARSER_CASES_DIR=$PWD/tests/bit/parsercases BIT_BIN=$PWD/bit-out/bin/bit \
//   BIT_STDLIB=$PWD/stdlib bit run tests/bit/parsergate.bit

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, readDir, exists, remove, mkdir } from "std/fs"
import { hasPrefix, hasSuffix, trimSpace, indexOf, parseInt, contains } from "std/strings"

// THE MANIFEST. Measured on disk; see the header for what belongs here.
const expectedCases: int = 2

// Assertions per case: exit 0, and stdout matches `.expected`.
const checksPerCase: int = 2

// `osRunBounded`'s own ceiling (runtime/root/*/os.bit `osBoundedMaxMs`).
const maxTimeoutMs: int = 4800000
const defaultTimeoutS: int = 300

class Ctx {
  casesDir: string,
  bin: string,
  stdlib: string,
  libbitrt: string,
  scratch: string,
  timeoutMs: int,
  checks: int,
  failures: int,
}

class RunOut {
  code: int,
  out: string,
  err: string,
}

// --- reporting -------------------------------------------------------------

// Every failure names the case and what was being asserted; nothing is counted
// without being printed, so a red run says which case and why.
fn failCase(c: Ctx, name: string, what: string, why: string) {
  c.failures = c.failures + 1
  eprint("parsergate: FAIL ${name} [${what}]: ${why}\n")
}

fn clip(s: string): string {
  if (len(s) <= 600) {
    return s
  }
  return s[0:600] + "\n  ...[truncated]"
}

fn reportDiff(expected: string, actual: string) {
  eprint("  expected (${len(expected)} bytes):\n${clip(expected)}\n")
  eprint("  actual   (${len(actual)} bytes):\n${clip(actual)}\n")
}

// --- shell wrapper ---------------------------------------------------------

// Wraps `s` as exactly one POSIX `/bin/sh` word.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn outPath(c: Ctx): string { return c.scratch + "/out" }
fn errPath(c: Ctx): string { return c.scratch + "/err" }
fn shPath(c: Ctx): string { return c.scratch + "/w.sh" }

fn removeQuiet(path: string) {
  remove(path) catch e { return }
}

// Builds and runs one `/bin/sh` wrapper: cd into the corpus, export the
// compiler's environment, then `exec` `argv` with stdout/stderr redirected to
// files this process reads back. `exec` matters: it makes the child REPLACE the
// shell, so a program that dies of SIGSEGV kills the process `osRunBounded`
// waits on and the crash stays distinguishable from a nonzero exit (ABI.md §19)
// — which is the entire point of this gate, since #2344 was a clean exit 0 from
// the compiler followed by a signal death from its output.
//
// Returns ok=false and reports the failure itself when the wrapper could not be
// launched, timed out, crashed, or never reached its `exec` — so the caller can
// never read an absent redirect file as "empty output".
fn runWrapped(c: Ctx, dir: string, name: string, what: string, argv: []string): (RunOut, bool) {
  removeQuiet(outPath(c))
  removeQuiet(errPath(c))

  let script = "#!/bin/sh\n"
  script = script + "cd " + shQuote(dir) + " || exit 125\n"
  if (c.stdlib != "") {
    script = script + "BIT_STDLIB=" + shQuote(c.stdlib) + "\nexport BIT_STDLIB\n"
  }
  if (c.libbitrt != "") {
    script = script + "BIT_LIBBITRT=" + shQuote(c.libbitrt) + "\nexport BIT_LIBBITRT\n"
  }
  script = script + "exec"
  let i = 0
  while (i < len(argv)) {
    script = script + " " + shQuote(argv[i])
    i = i + 1
  }
  script = script + " > " + shQuote(outPath(c)) + " 2> " + shQuote(errPath(c)) + "\n"

  let empty = RunOut{ code: 0, out: "", err: "" }
  writeFile(shPath(c), script) catch e {
    failCase(c, name, what, "cannot write wrapper script ${shPath(c)}")
    return empty, false
  }
  if (fsChmod(shPath(c), 448) != 0) { // 0o700
    failCase(c, name, what, "cannot chmod wrapper script ${shPath(c)}")
    return empty, false
  }

  let code = osRunBounded(shPath(c), c.timeoutMs)
  if (code == 0 - 2) {
    failCase(c, name, what, "TIMED OUT after ${c.timeoutMs}ms (raise BIT_TEST_TIMEOUT_S)")
    return empty, false
  }
  if (code == 0 - 1) {
    failCase(c, name, what, "cannot launch wrapper script (spawn/wait failure)")
    return empty, false
  }
  if (code <= 0 - 100) {
    failCase(c, name, what, "CRASHED: killed by signal ${0 - code - 100}")
    return empty, false
  }
  if (code == 125) {
    failCase(c, name, what, "wrapper could not cd to ${dir}")
    return empty, false
  }
  // The redirections are established before `exec`, so both files exist the
  // moment the command starts. A missing one means the wrapper never got that
  // far — the exact silent hole a `readFile ... catch { "" }` fallback hides.
  if (!exists(outPath(c)) || !exists(errPath(c))) {
    failCase(c, name, what, "wrapper produced no redirect files — it never ran the command")
    return empty, false
  }
  let so = readFile(outPath(c)) catch e {
    failCase(c, name, what, "cannot read captured stdout")
    return empty, false
  }
  let se = readFile(errPath(c)) catch e {
    failCase(c, name, what, "cannot read captured stderr")
    return empty, false
  }
  return RunOut{ code: code, out: so, err: se }, true
}

// --- the check -------------------------------------------------------------

fn firstLine(src: string): string {
  let nl = indexOf(src, "\n")
  let line = src
  if (nl >= 0) {
    line = src[0:nl]
  }
  if (len(line) > 0 && line[len(line) - 1] == 13) { // \r
    line = line[0:len(line) - 1]
  }
  return trimSpace(line)
}

// One `// run` case: `bit run` must exit 0 AND stdout must match `.expected`
// byte for byte. `bit run` compiles to a temporary binary and executes it, so a
// signal death in the PROGRAM is reported by `runWrapped` as CRASHED.
fn checkRun(c: Ctx, name: string, expected: string) {
  let (r, ok) = runWrapped(c, c.casesDir, name, "run", [c.bin, "run", name])
  if (!ok) {
    return
  }
  c.checks = c.checks + 1
  if (r.code != 0) {
    failCase(c, name, "run", "exited ${r.code}, want 0 — stderr:\n${clip(r.err)}")
    return
  }
  c.checks = c.checks + 1
  if (expected == r.out) {
    return
  }
  failCase(c, name, "run", "stdout does not match .expected")
  reportDiff(expected, r.out)
}

// --- #2022: the expression nesting-depth limit -----------------------------

// The ticket's own repro depth. Far past `compiler/parser.bit`'s
// `maxParseDepth` of 400 and far past the depth at which the unguarded parser
// died: `bit check` on 6000 nested parens exited 139 (SIGSEGV) with no output at
// all, and 4000 was already over the edge when the ticket was filed.
const deepN: int = 4000

// The deepest nesting that must still COMPILE AND RUN. One below the limit,
// because the enclosing `let x = ...` spends the first level.
const nearN: int = 399

// The four subcommands the ticket names. Every one of them parses, so a fix in
// one entry point that left another crashing is not the fix. `--dump-ir` is
// included on top: it bypasses the checker, so it is the one path that hands
// lowering a program `bit build` refused (the #2084 shape).
fn depthVerbs(): []string {
  return ["check", "fmt", "lint", "--dump-ir"]
}

// `s` repeated `n` times, by doubling — `n` is 4000 here and repeated
// concatenation onto a growing string is quadratic. Terminating: `have` at least
// doubles each turn, so the loop runs at most log2(n) + 1 times.
fn repeatStr(s: string, n: int): string {
  if (n <= 0) {
    return ""
  }
  let out = s
  let have = 1
  while (have * 2 <= n) {
    out = out + out
    have = have * 2
  }
  return out + repeatStr(s, n - have)
}

// One nesting shape, as a whole source file. The ticket measured parens, slice
// literals and calls; the prefix-operator chain is here because it recurses
// through `parseUnary` rather than `parseExpr` and so needs its own accounting.
class Shape { name: string, src: string }

fn shapes(n: int): []Shape {
  let f = "fn f(x: i64): i64 { return x }\n"
  return [
    Shape{ name: "paren",
      src: "fn main() {\n  let x = " + repeatStr("(", n) + "1" +
        repeatStr(")", n) + "\n}\n" },
    Shape{ name: "slicelit",
      src: "fn main() {\n  let x = " + repeatStr("[", n) +
        repeatStr("]", n) + "\n}\n" },
    Shape{ name: "call",
      src: f + "fn main() {\n  let x = " + repeatStr("f(", n) + "1" +
        repeatStr(")", n) + "\n}\n" },
    Shape{ name: "prefix",
      src: "fn main() {\n  let x = " + repeatStr("!", n) + "true\n}\n" },
  ]
}

// Every over-deep shape, through every entry point: a real diagnostic and a
// non-zero exit, never a signal. `runWrapped` reports a signal death as CRASHED
// and counts it as a failure, so "does not SIGSEGV" is asserted by construction
// on all of them — including `--dump-ir`, which is allowed to exit 0.
fn checkDeepShape(c: Ctx, dir: string, s: Shape) {
  let file = "deep_${s.name}.bit"
  writeFile(dir + "/" + file, s.src) catch e {
    failCase(c, file, "setup", "cannot write ${dir}/${file}")
    return
  }
  for verb of depthVerbs() {
    let (r, ok) = runWrapped(c, dir, file, verb, [c.bin, verb, file])
    if (!ok) {
      continue
    }
    c.checks = c.checks + 1
    if (verb == "--dump-ir") {
      continue // survival is the whole assertion; the dump may exit 0
    }
    if (r.code == 0) {
      failCase(c, file, verb, "exited 0 — ${deepN}-deep nesting was accepted")
      continue
    }
    c.checks = c.checks + 1
    if (!contains(r.err, "error[E0022]") || !contains(r.err, "nested more than")) {
      failCase(c, file, verb, "no depth diagnostic — stderr:\n${clip(r.err)}")
    }
  }
  checkDeepBuild(c, dir, file)
}

// `bit build` takes an `-o`, so it does not fit the loop above.
fn checkDeepBuild(c: Ctx, dir: string, file: string) {
  let out = c.scratch + "/deep.bin"
  let (r, ok) = runWrapped(c, dir, file, "build", [c.bin, "build", file, "-o", out])
  if (!ok) {
    return
  }
  c.checks = c.checks + 1
  if (r.code == 0) {
    failCase(c, file, "build", "exited 0 — ${deepN}-deep nesting was accepted")
    return
  }
  c.checks = c.checks + 1
  if (!contains(r.err, "error[E0022]") || !contains(r.err, "nested more than")) {
    failCase(c, file, "build", "no depth diagnostic — stderr:\n${clip(r.err)}")
  }
}

// The other half, and the reason this cannot pass by refusing everything: a file
// nested one level UNDER the limit still compiles and runs, and prints the right
// answer. A guard that fired one level early would be caught here.
fn checkNearLimit(c: Ctx, dir: string) {
  let file = "near_paren.bit"
  let src = "fn main() {\n  let x = " + repeatStr("(", nearN) + "41" +
    repeatStr(")", nearN) + "\n  print(\"x=" + interp("x + 1") + "\\n\")\n}\n"
  writeFile(dir + "/" + file, src) catch e {
    failCase(c, file, "setup", "cannot write ${dir}/${file}")
    return
  }
  let (r, ok) = runWrapped(c, dir, file, "run", [c.bin, "run", file])
  if (!ok) {
    return
  }
  c.checks = c.checks + 1
  if (r.code != 0) {
    failCase(c, file, "run", "exited ${r.code} at depth ${nearN}, want 0 — stderr:\n${clip(r.err)}")
    return
  }
  c.checks = c.checks + 1
  if (r.out != "x=42\n") {
    failCase(c, file, "run", "printed ${r.out}want x=42")
  }
}

// `${` cannot be written literally inside a Bit string — the lexer opens an
// interpolation on it — so a GENERATED program's interpolation is assembled from
// a lone `$`, which lexes as an ordinary character.
fn interp(expr: string): string {
  return "$" + "{" + expr + "}"
}

fn checkDepth(c: Ctx) {
  let dir = c.scratch + "/deep"
  mkdir(dir) catch e {
    c.failures = c.failures + 1
    eprint("parsergate: FAIL depth: cannot create ${dir}\n")
    return
  }
  let ss = shapes(deepN)
  if (len(ss) != 4) {
    c.failures = c.failures + 1
    eprint("parsergate: FAIL depth: ${len(ss)} shapes, want 4\n")
    return
  }
  for s of ss {
    checkDeepShape(c, dir, s)
  }
  checkNearLimit(c, dir)
  removeQuiet(dir + "/near_paren.bit")
  for s of ss {
    removeQuiet(dir + "/deep_${s.name}.bit")
  }
  removeQuiet(c.scratch + "/deep.bin")
  removeQuiet(dir)
}

// --- corpus walk -----------------------------------------------------------

// Every `.expected` must have a `.bit`, so a renamed case cannot leave dead
// weight behind that nothing reads and nobody notices.
fn checkOrphanExpected(c: Ctx, names: []string) {
  let stems = map<string, bool>{}
  for n of names {
    if (hasSuffix(n, ".bit")) {
      stems[n[0:len(n) - 4]] = true
    }
  }
  for n of names {
    if (!hasSuffix(n, ".expected")) {
      continue
    }
    let stem = n[0:len(n) - 9]
    let (_, has) = stems[stem]
    if (!has) {
      c.failures = c.failures + 1
      eprint("parsergate: FAIL ${n}: orphaned .expected — no sibling ${stem}.bit\n")
    }
  }
}

// Returns how many cases were actually walked, which the census then pins.
fn walk(c: Ctx, names: []string): int {
  let total = 0
  for n of names {
    if (!hasSuffix(n, ".bit")) {
      continue
    }
    total = total + 1
    let src = readFile(c.casesDir + "/" + n) catch e {
      c.failures = c.failures + 1
      eprint("parsergate: FAIL ${n}: cannot read case source\n")
      continue
    }
    // Only `// run` belongs here. Anything else would be judged by the wrong
    // oracle — silently, since an `// error` case's `.expected` is stderr.
    let line = firstLine(src)
    if (!hasPrefix(line, "// run")) {
      c.failures = c.failures + 1
      eprint("parsergate: FAIL ${n}: line 1 is '${line}', want a `// run` directive\n")
      eprint("  this gate drives `bit run` only; other directives belong elsewhere\n")
      continue
    }
    let expectedPath = c.casesDir + "/" + n[0:len(n) - 4] + ".expected"
    let expected = readFile(expectedPath) catch e {
      c.failures = c.failures + 1
      eprint("parsergate: FAIL ${n}: cannot read ${expectedPath}\n")
      continue
    }
    // An empty `.expected` would be satisfied by a program that prints nothing.
    if (len(expected) == 0) {
      c.failures = c.failures + 1
      eprint("parsergate: FAIL ${n}: ${expectedPath} is empty — nothing would be pinned\n")
      continue
    }
    checkRun(c, n, expected)
  }
  return total
}

fn checkCensus(c: Ctx, total: int) {
  if (total == expectedCases) {
    return
  }
  c.failures = c.failures + 1
  eprint("parsergate: FAIL census: walked ${total} case(s), manifest says ${expectedCases}\n")
  eprint("  adding or removing a case must edit expectedCases in the same commit\n")
}

// --- configuration ---------------------------------------------------------

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("parsergate: ${name} is not set — refusing to guess. This gate has no\n")
    eprint("parsergate: defaults; an unset corpus or compiler path must fail, never\n")
    eprint("parsergate: silently walk '.'.\n")
    exit(2)
  }
  return v
}

// `BIT_TEST_TIMEOUT_S`, the contract every harness here shares: default 300s,
// `0` disables the bound (here: the runtime's own one-hour ceiling).
fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch e {
    eprint("parsergate: BIT_TEST_TIMEOUT_S='${raw}' is not a number; using ${defaultTimeoutS}s\n")
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn newCtx(casesDir: string, bin: string, scratch: string): Ctx {
  return Ctx{
    casesDir: casesDir,
    bin: bin,
    stdlib: env("BIT_STDLIB"),
    libbitrt: env("BIT_LIBBITRT"),
    scratch: scratch,
    timeoutMs: timeoutMs(),
    checks: 0,
    failures: 0,
  }
}

fn main() {
  let casesDir = requiredEnv("BIT_PARSER_CASES_DIR")
  let bin = requiredEnv("BIT_BIN")
  if (!fsIsDir(casesDir)) {
    eprint("parsergate: BIT_PARSER_CASES_DIR='${casesDir}' is not a directory\n")
    exit(2)
  }
  if (!exists(bin)) {
    eprint("parsergate: BIT_BIN='${bin}' does not exist\n")
    exit(2)
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-parsergate-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("parsergate: cannot create scratch directory ${scratch}\n")
    exit(2)
  }

  let c = newCtx(casesDir, bin, scratch)
  let names = readDir(casesDir) catch e {
    eprint("parsergate: cannot list ${casesDir}\n")
    exit(2)
    return
  }
  checkOrphanExpected(c, names)
  let total = walk(c, names)
  checkCensus(c, total)
  checkDepth(c)

  removeQuiet(outPath(c))
  removeQuiet(errPath(c))
  removeQuiet(shPath(c))
  removeQuiet(scratch)

  // The run marker: a gate that stopped checking is visible here, not green.
  // 4 shapes x (3 diagnostic verbs x 2 + `--dump-ir` survival x 1 + build x 2)
  // = 36, plus 2 for the near-limit case, plus the corpus cases.
  let wantChecks = expectedCases * checksPerCase + 38
  if (c.checks < wantChecks) {
    c.failures = c.failures + 1
    eprint("parsergate: FAIL: only ${c.checks} checks ran, want ${wantChecks}\n")
  }
  if (c.failures > 0) {
    eprint("parsergate: FAIL — ${c.failures} failure(s) over ${total} case(s), ${c.checks} checks\n")
    exit(1)
    return
  }
  print("parsergate: PASS — ${total} cases, ${c.checks} checks, 0 failures\n")
}
