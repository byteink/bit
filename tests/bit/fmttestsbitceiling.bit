// #3711: `tests/bit/` — the largest harness tree in the repo — sits under NO
// `bit fmt --check` gate at all. Neither `test-fmt` (tools/build/gates.bit,
// stdlib/+examples/+pkg/+bench/+editors/ as of #3699/#3700/#3701) nor
// `test-fmt-ceiling`/`test-fmt-imports-ceiling`/`test-fmt-stress-ceiling`
// (compiler/+runtime/+tools/, tests/imports/, tests/stress/ respectively)
// reaches it.
//
// `tests/bit/` cannot be a HARD ZERO like `test-fmt`: measured fresh on this
// branch (see the derivation command in #3711's ticket body, re-run rather
// than trusted), it is real pre-existing debt, not something this ticket owes
// to clear. So this copies `fmtimportsceiling.bit`'s ratchet shape
// (#3693/#3670/#3654, itself modelled on `lintself.bit`'s lint-count ratchet,
// epic #2354): going over the recorded ceiling in
// `tools/build/fmt-ceiling-testsbit.txt` fails; going under it passes and
// names the lower number a human could ratchet it down to. This gate never
// runs `bit fmt -w` and never rewrites either data file.
//
// A SEPARATE small harness rather than widening any sibling ceiling file, for
// the same two reasons #3693/#3702 gave: first, none of the three existing
// ceiling files should gain a tree from an unrelated ticket. Second, this
// repo already keeps overlapping-but-distinct `bit lint`/`bit fmt` ratchets as
// separate small harnesses rather than one parameterized megagate
// (`test-lint-runtime`, `test-lint-filelines`, `test-lint-self`,
// `test-lint-sweep`, `test-fmt-ceiling`, `test-fmt-imports-ceiling`,
// `test-fmt-stress-ceiling` are seven files, not one) — this follows the same
// precedent rather than inventing a new shape.
//
// ONE DELIBERATE DIFFERENCE from every sibling ceiling harness above:
// `tests/bit/` — unlike compiler/, runtime/, tools/, tests/imports/ and
// tests/stress/ — DOES carry deliberately-malformed fixtures (parser-rejection
// corpora such as tests/bit/parsercases/), confirmed by
// `fmtimportsceiling.bit`'s own header ("tests/bit/ ... DOES carry
// deliberately-malformed fixtures ... findings for every well-formed file
// kept appearing after a malformed one"). `bit fmt --check` only parses (it
// never runs the full checker), so a syntactically-unparseable fixture makes
// `formatSource` return `failed: true` and `fmtOneFile` `eprint`s the FULL
// RENDERED DIAGNOSTIC BLOCK (compiler/diagnostics.bit's `renderOne`:
// `error[E0nnn]: <msg>` / ` --> path:line:col` / ` |` / `N | <source>` /
// ` | <pad>^^^ <hint>`), not a bare drifted-file path — and does so
// PERMANENTLY: a file that can never parse can never become canonical, so
// `bit fmt --check tests/bit` exits 1 forever regardless of how much drift is
// fixed. `parseUnformatted` below tolerates and skips a rendered diagnostic
// block by its known line shapes rather than panicking on it, and the ratchet
// itself is computed purely from `len(files)` against the ceiling — never
// from `bit fmt --check`'s own exit code, which this tree can never make
// report 0.
//
// BIT_REPO IS REQUIRED, same reason as every sibling in this directory: the
// harness points `bit fmt --check` at `${BIT_REPO}/tests/bit` and reads
// `${BIT_REPO}/tools/build/fmt-ceiling-testsbit.txt` — it must not silently
// default to ".".
//
// Run it from the repository root:
//     ./bit-out/bin/bit run tests/bit/fmttestsbitceiling.bit
import { env, envOr, exit } from "std/os"
import { exists, isDir, mkdir, readDir, readFile, writeFile } from "std/fs"
import { hasPrefix, hasSuffix, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Bounds on the independent file-count walk below — Power of 10 rule 2.
const maxEntries: int = 4096
const maxScanDepth: int = 16

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("fmttestsbitceiling: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("fmttestsbitceiling: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("fmttestsbitceiling: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("fmttestsbitceiling: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("fmttestsbitceiling: ${name} is required and was not set")
  }
  return v
}

// One `bit fmt --check <dir>` invocation, as seen from outside it.
class Run { code: int, err: string }

fn runFmtCheck(bit: string, dir: string, capDir: string, ms: int): Run! {
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' fmt --check '${dir}' > /dev/null 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/fmt.sh", script, ms)?
  if (sh != 0) {
    fail newError("fmttestsbitceiling: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("fmttestsbitceiling: no exit code was recorded — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, err: readFile(errPath)? }
}

// `r` is a usable observation of a real run. Unlike every sibling ceiling
// harness, `r.code == 1` here does NOT imply "some finding exists that isn't
// already accounted for" on its own — see the header: a permanently
// unparseable fixture pins `r.code` at 1 forever. So this only checks the
// two shapes that would mean the invocation itself misbehaved, never that
// `r.code == 0`.
fn assertTrustworthy(r: Run, dir: string) {
  if (r.code != 0 && r.code != 1) {
    panic("fmttestsbitceiling: `bit fmt --check ${dir}` exited ${r.code}, want 0 or 1")
  }
  if (r.code == 0 && len(r.err) > 0) {
    panic("fmttestsbitceiling: `bit fmt --check ${dir}` exited 0 but wrote to stderr:\n${r.err}")
  }
  if (r.code == 1 && len(r.err) == 0) {
    panic("fmttestsbitceiling: `bit fmt --check ${dir}` exited 1 but stderr is empty — untrustworthy run")
  }
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

// The `-->` location line of a rendered diagnostic (compiler/diagnostics.bit's
// `renderOne`): `${pad}--> ${path}:${line}:${col}`.
fn isDiagArrowLine(line: string): bool {
  return hasPrefix(trimSpace(line), "-->")
}

// Either the bare gutter (`${pad} |`) or the caret line
// (`${pad} | ${caretPad}^^^ <hint>`) of a rendered diagnostic — both are the
// trimmed line starting with `|`.
fn isDiagGutterLine(line: string): bool {
  return hasPrefix(trimSpace(line), "|")
}

// The quoted source line of a rendered diagnostic: `${lineNo} | <source>`,
// i.e. one or more digits followed by ` | `.
fn isDiagSourceLine(line: string): bool {
  let i = 0
  while (i < len(line) && isDigit(line[i])) {
    i = i + 1
  }
  if (i == 0) {
    return false
  }
  return hasPrefix(line[i:], " | ")
}

// The header line of a rendered diagnostic: `severityLabel[code]: message` or
// `severityLabel: message` when the diagnostic carries no code
// (compiler/diagnostics.bit's `severityLabel`: "error", "warning" or "note").
fn isDiagHeaderLine(line: string): bool {
  return hasPrefix(line, "error") || hasPrefix(line, "warning") || hasPrefix(line, "note")
}

// True for any line belonging to a rendered parse-failure diagnostic block —
// tolerated debt-free noise from a deliberately-malformed fixture, never
// counted against the ceiling. See the file header for why `tests/bit/`
// alone, among this gate's siblings, needs this.
fn isDiagLine(line: string): bool {
  return isDiagHeaderLine(line) ||
    isDiagArrowLine(line) ||
    isDiagGutterLine(line) ||
    isDiagSourceLine(line)
}

// Every nonblank stderr line from a `tests/bit/` scan is either the bare
// repo-relative-once-stripped path of an unformatted file
// (compiler/fmtcmd.bit's `fmtOneFile`: `eprint("${path}\n")`, checkOnly
// path), a line of a rendered parse-failure diagnostic block (tolerated, see
// `isDiagLine`), or a `bit fmt: ...`-prefixed tool diagnostic (an unreadable
// file or an empty directory — unexpected here and still fatal). Anything
// else fails loudly rather than being silently folded into "0 findings".
fn parseUnformatted(err: string, repo: string): []string! {
  let out = []string(0)
  let prefix = "${repo}/"
  for line of split(err, "\n") {
    if (len(trimSpace(line)) == 0) {
      continue
    }
    if (hasPrefix(line, "bit fmt: ")) {
      fail newError("fmttestsbitceiling: unexpected `bit fmt` diagnostic: ${line}")
    }
    if (isDiagLine(line)) {
      continue
    }
    if (!hasSuffix(line, ".bit")) {
      fail newError("fmttestsbitceiling: unrecognized `bit fmt --check` output line: ${line}")
    }
    if (!hasPrefix(line, prefix)) {
      fail newError("fmttestsbitceiling: unformatted path outside ${repo}: ${line}")
    }
    out = append(out, line[len(prefix):])
  }
  return out
}

// Parses tools/build/fmt-ceiling-testsbit.txt: a single `testsbit <count>`
// line. A human edits this file to lower the ceiling; this gate reads it and
// never writes it (mirrors every sibling ceiling file's contract).
fn parseCeilingFile(text: string): int! {
  let seen = map<string, int>{}
  for rawLine of split(text, "\n") {
    let line = trimSpace(rawLine)
    if (len(line) == 0) {
      continue
    }
    let fields = split(line, " ")
    if (len(fields) != 2) {
      fail newError("fmttestsbitceiling: malformed fmt-ceiling-testsbit.txt line: '${line}'")
    }
    if (fields[0] != "testsbit") {
      fail newError("fmttestsbitceiling: unknown scope '${fields[0]}' in fmt-ceiling-testsbit.txt")
    }
    let n = parseInt(fields[1])?
    seen[fields[0]] = n
  }
  let (testsbit, ok) = seen["testsbit"]
  if (!ok) {
    fail newError("fmttestsbitceiling: fmt-ceiling-testsbit.txt must have a 'testsbit <n>' line")
  }
  return testsbit
}

fn loadCeiling(repo: string): int! {
  let path = "${repo}/tools/build/fmt-ceiling-testsbit.txt"
  if (!exists(path)) {
    fail newError("fmttestsbitceiling: no ceiling file at ${path}")
  }
  return parseCeilingFile(readFile(path)?)?
}

// The count of `.bit` files anywhere beneath `dir` — an independent walk used
// only as the anti-vacuity denominator (see header). Bounded by
// `maxScanDepth` (Power of 10 rule 2), not merely documented as such.
fn countBitFiles(dir: string, depth: int): int {
  if (depth <= 0) {
    panic("fmttestsbitceiling: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("fmttestsbitceiling: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("fmttestsbitceiling: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  let n = 0
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      n = n + countBitFiles(path, depth - 1)
    } else if (hasSuffix(name, ".bit")) {
      n = n + 1
    }
  }
  return n
}

// The full verdict for `tests/bit/`: the independently walked `.bit` file
// count, and the unformatted files that count against the ceiling.
class TreeResult { filesTotal: int, files: []string }

fn scanTree(bit: string, repo: string, capDir: string, ms: int): TreeResult {
  let full = "${repo}/tests/bit"
  if (!exists(full)) {
    panic("fmttestsbitceiling: no such directory: ${full}")
  }
  let filesTotal = countBitFiles(full, maxScanDepth)
  if (filesTotal == 0) {
    panic("fmttestsbitceiling: ${full} contains zero .bit files — refusing a vacuous scan")
  }
  let r = runFmtCheck(bit, full, capDir, ms) catch e {
    panic("fmttestsbitceiling: ${e.message()}")
  }
  assertTrustworthy(r, full)
  let unformatted = parseUnformatted(r.err, repo) catch e {
    panic("fmttestsbitceiling: ${e.message()}")
  }
  return TreeResult{ filesTotal: filesTotal, files: unformatted }
}

fn printFiles(files: []string) {
  eprint("  tests/bit unformatted file(s) counted against the ceiling:\n")
  for f of files {
    eprint("    ${f}\n")
  }
}

// The verdict. Returns true when the gate FAILS.
fn reportTree(tr: TreeResult, ceiling: int): bool {
  let total = len(tr.files)
  if (total > ceiling) {
    eprint("fmt-testsbit-ceiling: FAIL -- tests/bit reports ${total} unformatted file(s) (of ${tr.filesTotal} scanned), ceiling is ${ceiling} (tools/build/fmt-ceiling-testsbit.txt) -- grew by ${total - ceiling}.\n")
    printFiles(tr.files)
    return true
  }
  if (total < ceiling) {
    println("fmt-testsbit-ceiling: tests/bit ${total} unformatted of ${tr.filesTotal} .bit file(s) scanned (ceiling ${ceiling}) -- PASS. Lower the ceiling to ${total} in tools/build/fmt-ceiling-testsbit.txt once reviewed.")
    return false
  }
  println("fmt-testsbit-ceiling: tests/bit ${total} unformatted of ${tr.filesTotal} .bit file(s) scanned (ceiling ${ceiling}) -- PASS.")
  return false
}

fn newCapDir(): string {
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  return "${tmp}/bit-fmttestsbitceiling-${uuidFormat(uuidV4())}"
}

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ {
    return
  }
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE") catch e {
    panic("fmttestsbitceiling: ${e.message()}")
  }
  let repo = requiredEnv("BIT_REPO") catch e {
    panic("fmttestsbitceiling: ${e.message()}")
  }
  let ceiling = loadCeiling(repo) catch e {
    panic("fmttestsbitceiling: ${e.message()}")
  }

  let capDir = newCapDir()
  mkdir(capDir) catch e {
    panic("fmttestsbitceiling: cannot create ${capDir}: ${e.message()}")
  }
  defer teardown(capDir, ms)

  let result = scanTree(bit, repo, capDir, ms)
  if (reportTree(result, ceiling)) {
    eprint("fmt-testsbit-ceiling: ceiling lives in tools/build/fmt-ceiling-testsbit.txt; a human lowers it, this gate never does.\n")
    exit(1)
  }
  println("fmt-testsbit-ceiling: PASS")
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
