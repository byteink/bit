// error
// #3050: the method-call shape of the same miscompile. vCallAgainstFuncSig
// (compiler/validateiface.bit), shared by vMethodCall and vCallValue, skipped
// every interface-typed parameter via vExpectExprNonIface on the claim that
// "vIfaceStore's rule" covered it elsewhere — but vIfaceStore is never called
// on a method call's arguments at all, so a class argument that did not
// satisfy the parameter's method set was never checked here either.
// `h.take(cash)` built rc=0 and segfaulted exactly like the free-call shape
// check_call_arg_iface_satisfy.bit covers.
interface Payer {
  pay(): i64
}

class Cash {
  n: i64,
}

class Handler {
  fee: i64,

  take(p: Payer): i64 {
    return p.pay()
  }
}

fn main() {
  let cash = Cash{ n: 1 }
  let h = Handler{ fee: 0 }
  print("${h.take(cash)}\n")
}
