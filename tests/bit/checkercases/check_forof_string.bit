// error
// #2013: `for c of s` over a string, and its two-binder spelling
// `for (i, c) of s`, both pass `bit check` silently and die at lowering with
// a spanless "cannot lower 1 function(s)" refusal, naming only the enclosing
// function. Unlike #2108's map case this is not a semantics choice: SPEC.md
// §21 (:3132-3134) reserves "rune iteration (`for r of s`)" for a future
// version by name, so there is nothing to decide — only somewhere for the
// rule to live.
//
// What must STAY legal, in the same file: for-of over a slice (both binder
// forms), and the byte-level operations the diagnostic points readers at —
// index bytes with `s[i]` (§12.6) and convert with `[]byte(s)` (§12.9).
fn main() {
  for c of "abc" { println("${c}") }
  let s = "abc"
  for (i, c2) of s { println("${i}") }
  let xs = [10, 20, 30]
  for x of xs { println("${x}") }
  for (j, x2) of xs { println("${j}=${x2}") }
  let b = []byte(s)
  println("${s[0]}=${len(b)}")
}
