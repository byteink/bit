// error
// #2804: `bit check` accepted a call to a member that does not exist on a
// wildcard-namespace import (`import * as fs from "std/fs"`) — the checker's
// inference path for a namespace-qualified callee looks the dotted key up
// and silently returns the invalid type (0) on a miss, with no diagnostic.
// Only `bit build`'s later lowering refusal caught it, and by then it names
// only the enclosing function, not the bad call site. Fixed in
// validateexpr.bit's vMember: an ImportNamespace receiver is now checked for
// E0046 presence in the same `importedFrom` table a bad NAMED import's
// export-table check already uses.
import * as fs from "std/fs"

fn main(): ()! {
  let n = fs.totallyBogusName("x")
  return
}
