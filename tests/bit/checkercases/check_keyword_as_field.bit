// error
// #2248: a reserved word (SPEC §5.2) used as a class field name used to
// cascade into 22 generic "expected X, found kw_type" diagnostics, none of
// which said the word was a keyword. `type` is picked because it is the most
// common field name this collides with (the discriminator on almost every
// event/message/node record).
class Event { type: string }

fn main() {}
