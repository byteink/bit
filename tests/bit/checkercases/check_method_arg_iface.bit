// error
// #2755: the same missing argument-validation gap as check_method_arg_concrete
// fires identically through an INTERFACE-typed receiver — no `Self` and no
// generic involved, an ordinary interface is enough. `vCallValue`/`vCall`
// (compiler/validatestmt.bit) both skipped every `Tag.Member` callee outright,
// on the premise that a method and a func-typed field "are not separable at
// this point" — they are, via `methodSigLookup`, which is what this case
// pins.
interface Foo {
  bar(x: int): bool
}

struct P { v: int }

fn (p: P) bar(x: int): bool {
  return x > 0
}

fn main() {
  let o: Foo = P{v: 1}
  print("${o.bar("hello")}\n")
}
