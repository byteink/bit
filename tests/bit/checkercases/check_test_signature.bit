// error
// #2080: a `test_*` function `bit test` cannot run (SPEC §19 requires no
// parameters, no result, never fallible) used to be dropped from discovery
// with no diagnostic from `check`, `build`, `lint` or `test` — and `bit test`
// still printed a green summary and exited 0 whenever another test in the
// same module survived, silently erasing whatever the dropped one would have
// found. All three malformed shapes below sit beside one well-formed test:
// before the fix that combination printed `1 test: 1 passed, 0 failed`, rc=0,
// naming none of `test_takes_a_param`, `test_returns_int` or
// `test_parses_config`.
import { eq } from "std/testing"

fn test_addition() { eq(1 + 1, 2, "sum") }

fn test_takes_a_param(n: int) { eq(1, 1, "never runs") }

fn test_returns_int(): int { return 0 }

// Fallible so the body could use `?` — the shape a developer reaches for the
// moment a test wants to call something fallible (`?` is only legal inside a
// fallible function, SPEC §18).
fn test_parses_config(): ()! {
  fail newError("this assertion should have failed the suite")
}
