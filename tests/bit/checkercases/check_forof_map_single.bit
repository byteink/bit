// error
// #2108: `for k of m` over a map passed `bit check` silently and died at
// lowering with a spanless "cannot lower 1 function(s)" refusal, naming only
// the enclosing function. SPEC.md §12.6 only ever shows the two-binder form
// `for (k, v) of m`; a single binder over a map is unspecified and cannot be
// guessed consistently (a slice's single binder binds the element, so
// importing Go's key convention would make one binder mean the first of the
// pair for a map and the second for a slice) — so the checker rejects it
// rather than picking a meaning.
//
// What must STAY legal, in the same file: the two-binder form, which lowers
// and runs correctly.
function main() {
  let m = map<string, int>{"a": 1}
  for k of m { println("${k}") }
  for (k2, v2) of m { println("${k2}=${v2}") }
}
