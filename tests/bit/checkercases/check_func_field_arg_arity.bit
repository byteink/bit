// error
// #2786: an extra argument through a func-typed STRUCT FIELD was silently
// ignored — no arity check at all, the same hole check_func_field_arg_type.bit
// pins for the argument TYPE.
//
// Measured on the #2755 build (6511d8fe) before this fix: `bit check` exited 0
// and `bit build` produced a binary that ran to completion and printed `3`,
// the extra argument discarded without a diagnostic.
struct C { add: (int, int) => int }

function sum2(a: int, b: int): int {
  return a + b
}

function main() {
  let r = C{ add: sum2 }
  print("${r.add(1, 2, 3)}\n")
}
