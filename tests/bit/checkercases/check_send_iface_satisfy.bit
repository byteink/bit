// error
// #3061: interface satisfaction was never checked for a channel send
// `ch <- v`. `vSendIface` (compiler/validateiface.bit) called `vIfaceStore`
// (the narrow "cannot store" scalar case) and `vExpectExprNonIface`, which
// explicitly returns on an Interface-kind target — so a struct sent on an
// interface-typed channel that does not implement the interface was never
// checked by either. `bit check` exited 0, `bit build` produced a binary,
// and the receive read the value back through a method table the struct
// does not have.
interface Payer {
  pay(): i64
}

struct Cash {
  n: i64,
}

fn main() {
  let ch = chan<Payer>(1)
  let cash = Cash{ n: 1 }
  ch <- cash
  let p = <- ch
  print("${p.pay()}\n")
}
