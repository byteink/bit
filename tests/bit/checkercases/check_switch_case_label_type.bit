// error
// #2428: a switch case label was never type-checked against the subject, so
// `switch (s) { case 1: }` on a `string` passed `bit check` with exit 0 and
// SIGSEGV'd at run time — #2407 routes a case label's implicit `subject ==
// label` through `lowerCompare`, so the mismatched `1` reaches
// `rt_call string_eq(subject, label)` and dereferences the raw integer as a
// string handle. The same operator spelled `==` was already diagnosed
// (E0053); this pins the identical diagnostic for the case-label spelling,
// spanned on the label rather than the whole switch. Single-file golden: no
// prelude.
function main() {
  let s = "a"
  switch (s) {
    case 1:
      print("int label\n")
    default:
      print("d\n")
  }
}
