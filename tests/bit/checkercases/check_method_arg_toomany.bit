// error
// #2755: arity was as unchecked as type for a method call — too MANY
// arguments into a fixed-arity method (`bar` takes exactly one) was accepted
// end to end, ran, and printed `true`, ignoring the extra arguments outright.
struct P { v: int }

function (p: P) bar(x: int): bool {
  return x > 0
}

function main() {
  let q = P{v: 1}
  print("${q.bar(1, 2, 3)}\n")
}
