// error
// #3060: a match arm with MORE binders than the variant's declared payload
// arity was accepted with no diagnostic at all — `bit check` exited 0, and
// the extra binder was never typed, so lowering still bound it to whatever
// word sat past the payload's own fields. With a reference-typed field last
// that out-of-bounds word could reach the collector as if it were a live
// pointer (the same hazard [[bit-gc-nongc-refs]] documents for markRoot).
// spec/SPEC.md:2246 is normative: "the binder count must match the
// variant's payload arity."
enum Shape {
  Two(int, string),
  Zero,
}

fn main() {
  let s = Shape.Two(7, "hello")
  match (s) {
    Two(a, b, extra) => print("a=${a} b=${b} extra=${extra}\n")
    Zero => print("zero\n")
  }
}
