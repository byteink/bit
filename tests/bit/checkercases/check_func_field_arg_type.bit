// error
// #2786: a call through a func-typed STRUCT FIELD (SPEC §9.4) skipped argument
// validation entirely — both arity and type. `vMethodCall`
// (compiler/validateiface.bit) already validated a METHOD call (#2755), but
// returned early the moment its method-signature lookup missed, which is
// exactly what happens for a field of the same shape: nothing downstream ever
// judged the argument again.
//
// Measured on the #2755 build (6511d8fe) before this fix: `bit check` exited 0
// and `bit build` produced a binary that printed 8594981168 — the string
// argument's own POINTER, read as an integer and doubled — a heap address
// leaked into the program's output, not merely a wrong answer.
struct R { read: (int) => int }

fn double(x: int): int {
  return x * 2
}

fn main() {
  let r = R{ read: double }
  print("${r.read("nope")}\n")
}
