// error
// #2740: SPEC §11.1 — a `string` is immutable; `s[i]` yields a read-only
// `byte`. `vIndex` (compiler/validateexpr.bit) answers TRUE for a string on
// the READ side, correctly, and nothing else asked whether THIS particular
// index is a write target, so `s[0] = x`, `s[0] += 1` and `s[0]++` all
// passed `bit check` and reached the lowerer's "cannot lower" refusal
// instead. All three spellings must be rejected here, by the checker.
//
// What must STAY legal, in the same file: the read `s[0]`, and a write
// through something genuinely mutable — a slice element and a fixed-array
// element — at all three spellings. Their presence is what makes the
// `.expected` pinning exactly 3 diagnostics the proof that the fix does not
// over-reject.
function main() {
  let s = "abc"
  let b = s[0]
  s[0] = 120
  s[0] += 1
  s[0]++

  let xs = [1, 2, 3]
  xs[0] = 9
  xs[1] += 1
  xs[2]++

  let a: [3]int
  a[0] = 9
  a[1] += 1
  a[2]++

  print("${b} ${xs[0]} ${xs[1]} ${xs[2]} ${a[0]} ${a[1]} ${a[2]}\n")
}
