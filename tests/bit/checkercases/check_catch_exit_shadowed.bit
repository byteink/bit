// error
// #3471: `vIsDivergingCall` (compiler/validatestmt.bit) recognizes a `catch`
// tail of `exit(...)` as diverging, like `panic(...)` — but only when it
// resolves to the imported `std/os` exit, never a LOCAL declaration of the
// same name. `funcRefAt`'s resolution tells the two apart: an import
// resolves to a decl owned by the exporting module (a different `moduleId`
// from the call site's own), a local declaration resolves to a decl owned by
// the call site's own module. This file's `exit` is declared locally and
// returns `i64`, so the tail must still be checked against the block's
// `string` result like any other value-producing call — a fix that treated
// ANY call literally named `exit` as diverging (ignoring who declared it)
// would silently accept this, and E0041 would never fire.
class myErr { code: i64 }
fn (e: myErr) message(): string { return "code=${e.code}" }
fn exit(code: i64): i64 { return code }
fn g(): string! { fail myErr{ code: 1 } }
fn f(): string {
  return g() catch e {
    exit(2)
  }
}
