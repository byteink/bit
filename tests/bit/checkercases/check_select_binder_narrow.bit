// error
// #3038: a `select`-case receive binder (`RecvBind`) was never typed by the
// checker — Tag.SelectStmt/Tag.RecvBind appeared in no check*.bit file, so
// `q` here resolved through envLookup to 0/`<error>`, and the assignability
// check is permissive against an unknown type (the safety rule). `bit check`
// exited 0, silently ignoring the `i32` annotation, where the identical
// narrowing from a plain `i64` parameter is already caught by E0041.
// `compiler/checkmatch.bit`'s `typeSelectBinders`, called from pre-pass 3
// (compiler/checkmodule.bit) alongside the existing for-of/match/catch
// binders, fixes this by deriving `q`'s type from the channel's element type
// — mirroring what `bindSelectRecv` (compiler/lowerbranch.bit) already did at
// lower time, which is why the emitted code was always correctly `i64`.
fn recv2(ch: chan<i64>): i32 {
  select {
    case q = <- ch:
      let narrow: i32 = q
      return narrow
  }
  return -1
}
