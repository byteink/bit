// error
// Traits (SPEC §10.7, #3369): two traits a class `use`s both PROVIDE the
// same method name — a compile error naming both traits, not a silent
// pick of one (there is no `insteadof`/`as` conflict resolution).
trait A {
  foo(): i64 { return 1 }
}

trait B {
  foo(): i64 { return 2 }
}

class C {
  use A, B
}

fn main() {
  print("${C{}.foo()}\n")
}
