// error
// #2176: SPEC §11 says "There is deliberately no tuple literal expression ...
// A tuple value is produced by a multi-value `return`". `(a, b)` in expression
// position used to fall out of the generic parenthesized-expression grammar as
// two E0021s naming the parser's STATE ("expected ')', found ','", then a
// second error from whatever followed) instead of the rule — worst on
// `let t = (1, true)`, which degraded further and blamed the `true` token it
// landed on. Covers both spellings from the ticket: a tuple `return` and a
// tuple `let` initializer.
//
// What must STAY legal, in the same file: a multi-value return (`return 1,
// true`, no parens — the actual way to build a tuple), a parenthesized
// non-tuple expression, a 2-argument call, and a parenthesized destructuring
// `let (a, b) = ...` — none of these route through the new diagnostic.
fn pairOk(): (int, bool) {
  return 1, true
}

fn pairBad(): (int, bool) {
  return (1, true)
}

fn letBad(): (int, bool) {
  let t = (1, true)
  return t
}

fn add(a: int, b: int): int {
  return a + b
}

fn main() {
  let (a, b) = pairOk()
  let g = (a + add(1, 2)) * 2
  print("${g} ${b}\n")
}
