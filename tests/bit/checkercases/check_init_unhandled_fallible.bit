// error
// #3371: calling a fallible 'init' without '?' or 'catch' leaves the call
// typed 'Account!', which cannot flow into an 'Account'-typed binding — the
// same E0041 mismatch any other unhandled fallible call produces (§18.3),
// distinct from the composite-literal seal and the duplicate-init
// diagnostics (check_init_seal_cross_module.bit, check_init_duplicate.bit).
class Account {
  balance: i64

  init(opening: i64)! {
    this.balance = opening
  }
}

fn main() {
  let a: Account = Account(500)
}
