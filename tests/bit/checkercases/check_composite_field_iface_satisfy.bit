// error
// #3061: interface satisfaction was never checked for a composite-literal
// struct FIELD. `vCompositeSlot` (compiler/validatezero.bit) called
// `vExpectExprNonIface`, which returns on an Interface-kind target, then
// `vIfaceStore`, the narrow "cannot store" scalar case — so a struct field
// whose value does not implement the field's interface type was never
// checked. `bit check` exited 0, `bit build` produced a binary, and reading
// the field back dispatched through a nonexistent method slot.
interface Payer {
  pay(): i64
}

struct Cash {
  n: i64,
}

struct Wallet {
  holder: Payer,
}

fn main() {
  let cash = Cash{ n: 1 }
  let w = Wallet{ holder: cash }
  print("${w.holder.pay()}\n")
}
