// error
// #2123: §14.6's comparability rule was not applied to comparison operands at
// all, so every type the spec calls NOT comparable compiled and answered
// `false` — a slice, a map, a function value, and a payload-carrying enum —
// while `false < true` answered `true` though §14.6 grants ordering to numerics
// and strings only. A payload enum is the dangerous one: adding a payload to one
// variant flips the whole enum from a tag word to a box, so every `==` in a
// transition table silently becomes box identity.
//
// What must STAY legal is pinned by run_comparable_ok.bit, not here.
// Single-file golden: no prelude, so this cannot name `Option`.
enum State { Draft, Cancelled(string) }

function f(x: int): int { return x }

function main() {
  let s1 = [1, 2]
  let s2 = [1, 2]
  print("${s1 == s2}\n")
  print("${s1 < s2}\n")
  print("${State.Draft == State.Draft}\n")
  let m1 = map<int, int>()
  let m2 = map<int, int>()
  print("${m1 == m2}\n")
  let g = f
  let h = f
  print("${g == h}\n")
  print("${false < true}\n")
  print("${s1 == nil}\n")
}
