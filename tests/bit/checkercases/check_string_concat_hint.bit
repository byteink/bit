// error
// #3010: a failed string + non-string '+' (§14.2, E0053) now suggests ${}
// interpolation (§5.7) when the OTHER operand converts to string — a
// primitive, or a type implementing Show — and stays silent when it does
// not (a slice has no conversion: E0073 territory, and the suggestion would
// be wrong) or when the string side has no literal text to splice a ${}
// into (a raw string's ${} is inert, #3009). Symmetric in operand order:
// the string on the right gets a correctly-ordered suggestion too.
interface Show { show(): string }
class Point { x: i64 
  show(): string {
    return "Point"
  }
}
fn main() {
  let sum = 15
  let xs = [1, 2, 3]
  let p = Point{x: 1}
  print("The sum is: " + sum)
  print(sum + "The sum is: ")
  print("point is: " + p)
  print("xs is: " + xs)
  print(`raw ` + sum)
}
