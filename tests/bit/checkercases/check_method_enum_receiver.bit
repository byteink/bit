// error
// #2736: a method declared with an enum receiver passed `bit check` with
// exit 0 and only failed at lowering, with a spanless "cannot lower 1
// function(s)" naming `main`, not the method (compiler/lowercall.bit's
// E0092 catch-all). SPEC §10.4: a method receiver must be a struct or
// type-alias declared in the same module; an enum is its own nominal
// declaration kind (SPEC §14.7).
enum OrderState { Draft, Paid }

fn (s: OrderState) label(): string {
  return match (s) {
    Draft => "Draft",
    Paid => "Paid"
  }
}

fn main() {
  print("hi\n")
}
