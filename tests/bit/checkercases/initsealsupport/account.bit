// Support module for check_init_seal_cross_module.bit (#3371): a class
// declaring 'init', imported from a different module than the one building
// its composite literal. Not a case itself — checkerdiag.bit's manifest walk
// only reads names ending in '.bit' DIRECTLY inside checkercases/, so this
// nested file is invisible to the '// error' census.
export class Account {
  balance: i64

  init(opening: i64) {
    this.balance = opening
  }
}
