// error
// #3050: interface satisfaction was never checked for a call argument. vCall
// (compiler/validatecall.bit) skipped every interface-typed parameter,
// deferring to vCallArgIface (compiler/validateiface.bit) — but that only
// rejects a non-storable SCALAR (E0041's narrow "cannot store" case), never a
// storable class that simply does not implement the interface. `bit check`
// exited 0, `bit build` produced a binary, and calling the missing method
// dispatched through whatever occupied that slot in the class's (nonexistent)
// method table: a segfault with no compiler diagnostic pointing at the cause.
//
// Two structs, same shape as check_iface_why.bit, so the two `.expected`
// messages are checked to differ: one has no `pay` method at all, the other
// has one with the wrong signature.
interface Payer {
  pay(): i64
}

class Cash {
  n: i64,
}

class Voucher {
  n: i64,
}

fn (v: Voucher) pay(amount: i64): i64 {
  return v.n
}

fn take(p: Payer): i64 {
  return p.pay()
}

fn main() {
  let cash = Cash{ n: 1 }
  let voucher = Voucher{ n: 2 }
  print("${take(cash)}${take(voucher)}\n")
}
