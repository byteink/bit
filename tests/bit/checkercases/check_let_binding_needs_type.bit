// error
// #2147: §10.1's grammar makes `let v, ok = m["a"]` TWO independent bindings —
// `v1` (no type, no initializer) and `ok1 = m["a"]` (a plain, well-typed read)
// — not the two-result map read it looks like. `bit check` used to accept it
// and hand lowering a function it could not emit: "cannot lower 1
// function(s)", naming neither the file nor the line. §10.1 already states the
// rule this should have failed on: "A `let` without an initializer is set to
// the zero value of its declared type; the type annotation is then required."
//
// What must STAY legal is covered in the same file: the parenthesised
// two-result form §12.6 specifies, and every ordinary comma-list binding that
// carries either an initializer or an annotation.
function main() {
  let m = map<string, int>()
  m["a"] = 1
  let v1, ok1 = m["a"]
  let a1, b1 = 1
  let (v2, ok2) = m["a"]
  let a2 = 1, b2 = 2
  let a3: int, b3 = 2
  let x1: int
  print("${ok1}${b1}${v2}${ok2}${a2}${b2}${a3}${b3}${x1}\n")
}
