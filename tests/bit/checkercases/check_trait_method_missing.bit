// error
// Traits (SPEC §10.7, #3369): a REQUIRED method (a signature with no body)
// that the using class neither supplies itself nor gets from another
// `use`d trait's provided method is a compile error naming the trait and
// the method.
trait Damageable {
  hurt(n: i64)
}

class Enemy {
  use Damageable
  hp: i64,
}

fn main() {
  print("${Enemy{ hp: 1 }.hp}\n")
}
