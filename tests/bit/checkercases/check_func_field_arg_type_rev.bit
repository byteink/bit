// error
// #2786: the same func-typed-STRUCT-FIELD hole as check_func_field_arg_type.bit,
// the other direction — an int argument into a `(string) => int` field.
//
// Measured on the #2755 build (6511d8fe) before this fix: `bit check` exited 0
// and `bit build` produced a binary that SIGSEGV'd (rc=139, no output) —
// the int argument's bit pattern was used as a string's pointer.
class S { greet: (string) => int }

fn shout(s: string): int {
  return len(s)
}

fn main() {
  let r = S{ greet: shout }
  print("${r.greet(1234567)}\n")
}
