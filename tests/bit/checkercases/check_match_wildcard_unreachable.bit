// error
// #2294: a `_` wildcard arm that discharges no variant at all, because every
// variant of the enum already has its own arm. Accepting it would silently
// disable E0071 for this match forever — the next variant added to `Color`
// would fall into the redundant `_` instead of raising a diagnostic — so it
// is refused (§13.8) rather than accepted as a harmless no-op.
enum Color { Red, Green, Blue }

fn label(c: Color): string {
  match (c) {
    Red   => return "red"
    Green => return "green"
    Blue  => return "blue"
    _     => return "?"
  }
}

fn main() { println(label(Color.Red)) }
