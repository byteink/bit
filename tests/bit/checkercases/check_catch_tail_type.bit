// error
// #2981: vCatchBind's `Tag.ExprStmt` branch (compiler/validatestmt.bit)
// walked a `catch e { ... }` block's trailing bare expression for its own
// diagnostics but never compared its TYPE against the operand's unwrapped
// ok type. `checkExprType`'s `CatchBind` case (compiler/checkexpr.bit:441-442)
// types the whole catch EXPRESSION from the operand alone, independent of
// what the block's tail actually yields, so nothing else ever compared them
// — a void-typed tail like `println(...)` silently fed a typed `i64`
// binding. See the sibling ACCEPT case run_catch_tail_type.bit: a
// correctly-typed tail (`len(...)`) still compiles, and a void-ok `()!`
// catch with an `println(...)` tail is still exempt (#2103).
struct myErr { code: i64 }
fn (e: myErr) message(): string { return "code=${e.code}" }
fn f(): i64! { fail myErr{ code: 1 } }
fn main() {
  let v: i64 = f() catch e { println(e.message()) }
  println("v=${v}")
}
