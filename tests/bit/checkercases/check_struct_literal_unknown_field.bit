// error
// #2230: a misspelled key in a struct literal used to pass `bit check` with
// rc=0 and only fail at lowering, spanless. The read side (`u.emial`) has
// always been E0057; the literal side consulted no field table at all.
struct User {
  name: string,
  age: i64,
}

struct Empty {}

function main() {
  let u = User{ nmae: "ana", age: 3 }
  let e = Empty{ what: 1 }
  print("${u.name}${e == e}\n")
}
