// error
// #2273: an out-of-range `\u{...}` escape was accepted with NO diagnostic and
// then silently deleted itself and the rest of the literal. `"[\u{D800}]tail"` —
// nine visible characters of source — became the one-byte string `"["`, because
// the escape encoded to zero bytes and the encoder's caller read that as "stop".
// `bit check` exited 0 on all three compilers (brew 0.1.8, the 0.1.5 oracle and
// the dev tree), so this is not a regression; it has always been there.
//
// SPEC §5.6 defines the escape as denoting "a Unicode scalar value", which
// excludes both the UTF-16 surrogate block D800-DFFF and everything above
// U+10FFFF. Both ends of the surrogate block are pinned here, plus one value
// above the maximum, plus the rune-literal spelling, which had the matching hole
// (`'\u{D800}'` yielded 55296 — a surrogate in a `rune`).
//
// The ACCEPT half is tests/cases/run_unicode_escape_boundary.bit, which pins the
// neighbours on the legal side of both boundaries (D7FF, E000, 10FFFF).
//
// Single-file golden: no prelude.
function main() {
  let lo = "[\u{D800}]"
  let hi = "[\u{DFFF}]"
  let over = "[\u{110000}]"
  let r = '\u{D800}'
  print("${lo}${hi}${over}${int(r)}\n")
}
