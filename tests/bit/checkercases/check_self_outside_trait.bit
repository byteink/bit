// error
// `Self` (SPEC §10.7, #3369) names the class using a trait, and only makes
// sense inside one — a bare top-level function has no using class for it
// to mean anything, so it is an ordinary undefined name (the resolver
// never binds "Self" outside a trait or interface body).
fn f(x: Self): bool { return true }

fn main() {
  print("ok\n")
}
