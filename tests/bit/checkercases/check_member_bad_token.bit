// error
// #2845: `.member` access took ANY token as the field name with no
// diagnostic. The postfix `Kind.Dot` arm (compiler/parserexpr.bit) called
// `leaf(p, Tag.Ident)` unconditionally — it reads whatever token is CURRENT,
// tags it `Tag.Ident` in the tree, and advances, without checking the token's
// actual kind. So `s.+` built a `Tag.Member` node whose "name" leaf's source
// text was `+`, with nothing tying a diagnostic back to the real problem.
// Routed through `expectIdent` now (SPEC §12.5's `member = "." ( IDENT |
// INT_LIT )` — the IntLit tuple-index case is handled separately, above this
// arm), the same guard every other identifier-required site already uses.
class S { f: int }

fn main() {
  let s = S{f: 1}
  let x = s.+ 1
  print("${x}")
}
