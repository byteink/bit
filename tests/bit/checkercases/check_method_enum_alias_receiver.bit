// error
// #2738: #2736 gated a DIRECT enum receiver but a type-alias receiver that
// resolves to an enum reaches the same `vMethodReceiverKind` check by
// construction (an alias resolves transparently to its underlying TypeId,
// checkbind.bit's declTypeOf). The gate itself needed no alias-specific
// code; what was missing was the diagnostic — naming only the written alias
// ("'OS' is declared 'enum'") is false, since OS is declared a type alias,
// not an enum. SPEC §10.4: a method receiver must be a class or
// type-alias declared in the same module; an enum is its own nominal
// declaration kind (SPEC §14.7), and aliasing it does not change that.
enum OrderState { Draft, Paid }
type OS = OrderState

fn (s: OS) label(): string {
  return match (s) {
    Draft => "Draft",
    Paid => "Paid"
  }
}

fn main() {
  print("hi\n")
}
