// error
// #3370: two traits a class `use`s both declare the same field name — a
// compile error naming both traits. Unlike a method conflict (#3369, which
// the class's own declaration can silently override), a field conflict has
// no override: SPEC §10.7 says a collision is always an error, whatever the
// two field types are.
trait A {
  x: i64
}

trait B {
  x: string
}

class C {
  use A, B
}

fn main() {
  print("${C{}}\n")
}
