// error
// Traits (SPEC §10.7, #3369): a trait is never a type — not usable as a
// parameter type, a field type, a variable's type, or anywhere else a real
// type belongs. This is the parameter case; the fix is a structural
// interface, not the trait itself.
trait Damageable {
  hurt(n: i64)
}

fn f(t: Damageable) {}

fn main() {
  print("ok\n")
}
