// error
// #3371: Bit has no constructor overloading — a class declaring a SECOND
// 'init' is a compile error naming the class, distinct from the composite-
// literal seal (check_init_seal_cross_module.bit) and the unhandled-
// fallible-call diagnostic (check_init_unhandled_fallible.bit).
class Account {
  balance: i64

  init(opening: i64) {
    this.balance = opening
  }

  init(a: i64, b: i64) {
    this.balance = a + b
  }
}

fn main() {
  let a = Account(1, 2)
}
