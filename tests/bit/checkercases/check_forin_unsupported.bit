// error
// #2162 (owner decision 2026-08-10): `for x in it` gets TypeScript semantics
// — the index for a slice/array, the key for a map — and rejects every other
// operand rather than guessing. `string` is excluded deliberately: what
// `for c of s` itself yields is still unsettled (§21, #2013), so an `in` form
// over strings before that lands would be building on sand. `chan<T>` is a
// stream, not a container, so it has no keys either.
//
// What must STAY legal, in the same file: for-in over a slice (binding the
// index) and a map (binding the key).
fn main() {
  let s = "abc"
  for c in s { println("${c}") }
  let ch = chan<int>()
  for v in ch { println("${v}") }
  let xs = [10, 20, 30]
  for i in xs { println("${i}") }
  let m = map<string, int>{"a": 1}
  for k in m { println("${k}") }
}
