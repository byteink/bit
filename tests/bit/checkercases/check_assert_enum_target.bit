// error
// #2104: SPEC §14.3 makes it impossible for an enum to ever sit behind an
// interface value, and the checker already says so when the store is direct
// (`let m: M = K.A(1)`). The same rule did not apply to a type ASSERTION:
// `vTypeAssert` (compiler/validateiface.bit) checks `vStorableInInterface`
// before `vSatisfies`, so `m.(K)` is rejected on K's non-class kind alone —
// no method on K is needed to reach the assertion, which is just as well
// since #2736 (SPEC §10.4) separately made a method with an enum receiver
// illegal, and K used to carry one here only to make it structurally satisfy
// M under the pre-#2736 checker.
interface M { message(): string }
class S { c: int }
enum K { A(int), B }
fn (s: S) message(): string { return "s" }
fn main() {
  let m: M = S{ c: 1 }
  let (k, ok) = m.(K)
  println("ok=${ok}")
}
