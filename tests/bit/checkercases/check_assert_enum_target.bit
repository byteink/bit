// error
// #2104: SPEC §14.3 makes it impossible for an enum to ever sit behind an
// interface value, and the checker already says so when the store is direct
// (`let m: M = K.A(1)`). The same rule did not apply to a type ASSERTION,
// where the target is equally impossible: `vTypeAssert` tested `vSatisfies`
// only, and `K` genuinely satisfies `M` (it has `message()`), so `m.(K)`
// passed `bit check` and then failed lowering with a spanless "cannot lower
// 1 function(s)" instead of a diagnostic naming the assertion.
interface M { message(): string }
struct S { c: int }
enum K { A(int), B }
function (s: S) message(): string { return "s" }
function (k: K) message(): string { return "k" }
function main() {
  let m: M = S{ c: 1 }
  let (k, ok) = m.(K)
  println("ok=${ok}")
}
