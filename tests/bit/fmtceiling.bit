// #3670, decided on #3654: `test-fmt` (tools/build/gates.bit's `test-fmt`
// Gate) stays a hard zero over `stdlib/` and `examples/` only — those are the
// two trees `bit fmt --check` has ever covered. `compiler/`, `runtime/` and
// `tools/` were UNGATED: #3654 measured 196/224, 95/134 and 10/14 files
// unformatted respectively, on a green `test-fmt` the whole time, because
// nothing pointed the formatter at them.
//
// This gate closes that hole the same way `tests/bit/lintself.bit` already
// ratchets `bit lint` findings against `tools/build/lint-ceiling.txt`
// (#2453, epic #2354) — copy that shape, not a new one:
//
//   Going over the recorded ceiling in `tools/build/fmt-ceiling.txt` fails;
//   going under it passes and names the lower number a human could ratchet
//   it down to. A human lowers the ceiling; this gate only ever refuses a
//   rise. It never runs `bit fmt -w` and never rewrites either data file.
//
// ONE DELIBERATE DIFFERENCE from lintself.bit: `bit fmt --check` has no
// E0214-shaped "always zero" class and no `lint: N findings` summary line to
// cross-check a scan against (compiler/fmtcmd.bit's `fmtOneFile` prints
// nothing but the bare drifted path, to stderr, once per unformatted file —
// see `parseUnformatted` below). So this harness independently walks each
// tree for its own `.bit` file count (`countBitFiles`, the same hand-rolled
// bound as lintfilelines.bit's) purely as an anti-vacuity denominator: a
// count of zero unformatted files must never be indistinguishable from a
// broken BIT_REPO pointing at an empty directory.
//
// `tools/build/fmt-exempt.txt` lists files #3654 verified are genuinely
// hand-aligned column tables (asm byte literals with trailing instruction
// comments, packed string-literal chunks) that `bit fmt`'s canonical style
// measurably degrades — not merely large or never-formatted. A file on that
// list is never counted against its tree's ceiling, whether or not it is
// currently unformatted; this gate never edits that file either.
//
// BIT_REPO IS REQUIRED, same reason as every sibling in this directory: the
// harness points `bit fmt --check` at `${BIT_REPO}/compiler`,
// `${BIT_REPO}/runtime` and `${BIT_REPO}/tools`, and reads
// `${BIT_REPO}/tools/build/{fmt-ceiling,fmt-exempt}.txt` — it must not
// silently default to ".".
//
// Run it from the repository root:
//     ./bit-out/bin/bit run tests/bit/fmtceiling.bit
import { env, envOr, exit } from "std/os"
import { exists, isDir, mkdir, readDir, readFile, writeFile } from "std/fs"
import { hasPrefix, hasSuffix, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Bounds on the independent file-count walk below — Power of 10 rule 2.
const maxEntries: int = 4096
const maxScanDepth: int = 16

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ { 300 }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("fmtceiling: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("fmtceiling: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("fmtceiling: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("fmtceiling: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("fmtceiling: ${name} is required and was not set")
  }
  return v
}

// One `bit fmt --check <dir>` invocation, as seen from outside it.
class Run { code: int, err: string }

fn runFmtCheck(bit: string, dir: string, capDir: string, ms: int): Run! {
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' fmt --check '${dir}' > /dev/null 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/fmt.sh", script, ms)?
  if (sh != 0) {
    fail newError("fmtceiling: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("fmtceiling: no exit code was recorded — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, err: readFile(errPath)? }
}

// `r` is a usable observation of a real run. `bit fmt --check` (unlike `bit
// lint`) prints NOTHING when a tree is fully canonical — compiler/fmtcmd.bit
// never calls `eprint` on the clean path — so an empty stderr is only
// trustworthy paired with exit 0; either exit 1 with empty stderr or exit 0
// with nonempty stderr means this harness's own invocation is not behaving
// the way `fmtCmd` is documented to, and it is safer to stop than to guess a
// count.
fn assertTrustworthy(r: Run, dir: string) {
  if (r.code != 0 && r.code != 1) {
    panic("fmtceiling: `bit fmt --check ${dir}` exited ${r.code}, want 0 or 1")
  }
  if (r.code == 0 && len(r.err) > 0) {
    panic("fmtceiling: `bit fmt --check ${dir}` exited 0 but wrote to stderr:\n${r.err}")
  }
  if (r.code == 1 && len(r.err) == 0) {
    panic("fmtceiling: `bit fmt --check ${dir}` exited 1 but stderr is empty — untrustworthy run")
  }
}

// Every nonblank stderr line from `bit fmt --check` is EITHER the bare
// repo-relative-once-stripped path of an unformatted file (compiler/
// fmtcmd.bit's `fmtOneFile`: `eprint("${path}\n")`, checkOnly path, nothing
// else) or a `bit fmt: ...`-prefixed diagnostic (an unreadable file, an empty
// directory, or a parse failure this harness did not expect from a tree that
// builds). Either of the latter fails loudly rather than being silently
// folded into "0 findings" — a broken invocation must never read as a clean
// tree.
fn parseUnformatted(err: string, repo: string): []string! {
  let out = []string(0)
  let prefix = "${repo}/"
  for line of split(err, "\n") {
    if (len(trimSpace(line)) == 0) {
      continue
    }
    if (hasPrefix(line, "bit fmt: ")) {
      fail newError("fmtceiling: unexpected `bit fmt` diagnostic: ${line}")
    }
    if (!hasSuffix(line, ".bit")) {
      fail newError("fmtceiling: unrecognized `bit fmt --check` output line: ${line}")
    }
    if (!hasPrefix(line, prefix)) {
      fail newError("fmtceiling: unformatted path outside ${repo}: ${line}")
    }
    out = append(out, line[len(prefix):])
  }
  return out
}

// Splits `paths` (repo-relative unformatted files) into the ones this gate
// counts and the ones `tools/build/fmt-exempt.txt` excludes.
fn splitExempt(paths: []string, exempt: map<string, bool>): ([]string, int) {
  let kept = []string(0)
  let exempted = 0
  for p of paths {
    let (_, ok) = exempt[p]
    if (ok) {
      exempted = exempted + 1
    } else {
      kept = append(kept, p)
    }
  }
  return kept, exempted
}

fn loadExempt(repo: string): map<string, bool>! {
  let path = "${repo}/tools/build/fmt-exempt.txt"
  if (!exists(path)) {
    fail newError("fmtceiling: no exempt file at ${path}")
  }
  let set = map<string, bool>{}
  for rawLine of split(readFile(path)?, "\n") {
    let line = trimSpace(rawLine)
    if (len(line) == 0) {
      continue
    }
    set[line] = true
  }
  return set
}

// The three ceilings recorded in tools/build/fmt-ceiling.txt.
class Ceiling { compiler: int, runtime: int, tools: int }

fn ceilingFromCounts(seen: map<string, int>): Ceiling! {
  let (c, cok) = seen["compiler"]
  let (r, rok) = seen["runtime"]
  let (t, tok) = seen["tools"]
  if (!cok || !rok || !tok) {
    fail newError("fmtceiling: fmt-ceiling.txt must have 'compiler <n>', 'runtime <n>' and 'tools <n>' lines")
  }
  return Ceiling{ compiler: c, runtime: r, tools: t }
}

// Parses tools/build/fmt-ceiling.txt: `<tree> <count>` lines, one each for
// compiler/runtime/tools, in any order. A human edits this file to lower a
// ceiling; this gate reads it and never writes it (mirrors lintself.bit's
// lint-ceiling.txt contract).
fn parseCeilingFile(text: string): Ceiling! {
  let seen = map<string, int>{}
  for rawLine of split(text, "\n") {
    let line = trimSpace(rawLine)
    if (len(line) == 0) {
      continue
    }
    let fields = split(line, " ")
    if (len(fields) != 2) {
      fail newError("fmtceiling: malformed fmt-ceiling.txt line: '${line}'")
    }
    if (fields[0] != "compiler" && fields[0] != "runtime" && fields[0] != "tools") {
      fail newError("fmtceiling: unknown scope '${fields[0]}' in fmt-ceiling.txt")
    }
    let n = parseInt(fields[1])?
    seen[fields[0]] = n
  }
  return ceilingFromCounts(seen)?
}

fn loadCeiling(repo: string): Ceiling! {
  let path = "${repo}/tools/build/fmt-ceiling.txt"
  if (!exists(path)) {
    fail newError("fmtceiling: no ceiling file at ${path}")
  }
  return parseCeilingFile(readFile(path)?)?
}

// The count of `.bit` files anywhere beneath `dir` — an independent walk used
// only as the anti-vacuity denominator (see header). Bounded by
// `maxScanDepth` (Power of 10 rule 2), not merely documented as such.
fn countBitFiles(dir: string, depth: int): int {
  if (depth <= 0) {
    panic("fmtceiling: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("fmtceiling: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("fmtceiling: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  let n = 0
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      n = n + countBitFiles(path, depth - 1)
    } else if (hasSuffix(name, ".bit")) {
      n = n + 1
    }
  }
  return n
}

// One tree's full verdict: the independently walked `.bit` file count, and
// the unformatted files that count against the ceiling (already stripped of
// anything `fmt-exempt.txt` names).
class TreeResult { tree: string, filesTotal: int, files: []string, exempted: int }

fn scanTree(bit: string, repo: string, tree: string, exempt: map<string, bool>, capDir: string, ms: int): TreeResult {
  let full = "${repo}/${tree}"
  if (!exists(full)) {
    panic("fmtceiling: no such directory: ${full}")
  }
  let filesTotal = countBitFiles(full, maxScanDepth)
  if (filesTotal == 0) {
    panic("fmtceiling: ${full} contains zero .bit files — refusing a vacuous scan")
  }
  let subDir = "${capDir}/${tree}"
  mkdir(subDir) catch e { panic("fmtceiling: cannot create ${subDir}: ${e.message()}") }

  let r = runFmtCheck(bit, full, subDir, ms) catch e { panic("fmtceiling: ${e.message()}") }
  assertTrustworthy(r, full)
  let unformatted = parseUnformatted(r.err, repo) catch e { panic("fmtceiling: ${e.message()}") }
  let (kept, exempted) = splitExempt(unformatted, exempt)
  return TreeResult{ tree: tree, filesTotal: filesTotal, files: kept, exempted: exempted }
}

fn printFiles(scope: string, files: []string) {
  eprint("  ${scope} unformatted file(s) counted against the ceiling:\n")
  for f of files {
    eprint("    ${f}\n")
  }
}

// The verdict for one tree. Returns true when this tree FAILS the gate.
fn reportTree(tr: TreeResult, ceiling: int): bool {
  let total = len(tr.files)
  if (total > ceiling) {
    eprint("fmt-ceiling: FAIL -- ${tr.tree} reports ${total} unformatted file(s) (of ${tr.filesTotal} scanned, ${tr.exempted} exempt), ceiling is ${ceiling} (tools/build/fmt-ceiling.txt) -- grew by ${total - ceiling}.\n")
    printFiles(tr.tree, tr.files)
    return true
  }
  if (total < ceiling) {
    println("fmt-ceiling: ${tr.tree} ${total} unformatted of ${tr.filesTotal} .bit file(s) scanned (${tr.exempted} exempt) (ceiling ${ceiling}) -- PASS. Lower the ceiling to ${total} in tools/build/fmt-ceiling.txt once reviewed.")
    return false
  }
  println("fmt-ceiling: ${tr.tree} ${total} unformatted of ${tr.filesTotal} .bit file(s) scanned (${tr.exempted} exempt) (ceiling ${ceiling}) -- PASS.")
  return false
}

fn newCapDir(): string {
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  return "${tmp}/bit-fmtceiling-${uuidFormat(uuidV4())}"
}

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ { return }
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE") catch e { panic("fmtceiling: ${e.message()}") }
  let repo = requiredEnv("BIT_REPO") catch e { panic("fmtceiling: ${e.message()}") }
  let ceiling = loadCeiling(repo) catch e { panic("fmtceiling: ${e.message()}") }
  let exempt = loadExempt(repo) catch e { panic("fmtceiling: ${e.message()}") }

  let capDir = newCapDir()
  mkdir(capDir) catch e { panic("fmtceiling: cannot create ${capDir}: ${e.message()}") }
  defer teardown(capDir, ms)

  let compilerR = scanTree(bit, repo, "compiler", exempt, capDir, ms)
  let runtimeR = scanTree(bit, repo, "runtime", exempt, capDir, ms)
  let toolsR = scanTree(bit, repo, "tools", exempt, capDir, ms)

  let compilerFail = reportTree(compilerR, ceiling.compiler)
  let runtimeFail = reportTree(runtimeR, ceiling.runtime)
  let toolsFail = reportTree(toolsR, ceiling.tools)

  if (compilerFail || runtimeFail || toolsFail) {
    eprint("fmt-ceiling: ceilings live in tools/build/fmt-ceiling.txt; a human lowers them, this gate never does.\n")
    exit(1)
  }
  println("fmt-ceiling: PASS")
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
