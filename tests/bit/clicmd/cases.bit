// tests/bit/clicmd/cases.bit — the argv-contract case tables for #2107's CLI
// gate (#2867 phase 2's split of `tests/bit/clicmd.bit`).
//
// Sibling of `clicmd.bit` in the same directory module: no `import`, one
// shared scope. Every function here returns `[]Case` (the class is declared
// in `clicmd.bit`) and documents one bug or feature as a table of rows —
// nothing here calls `bit`, builds a fixture, or asserts anything itself.
// `clicmd.bit`'s `runAll` appends every table below (plus its own
// `DirNameCase`/`Dump` tables, which stay there because they need bespoke
// runners `runCase`'s generic loop cannot express) and drives each row through
// `runCase`, which stays in `clicmd.bit` beside the `check`/`runBit` machinery
// that actually launches `bit` and reads its exit code, stdout and stderr.

// THE REJECTIONS. One per subcommand that reaches the shared front end, each
// naming the flag it refused — a bare non-zero exit would pass while printing
// nothing, which is the half-fix this ticket is about.
fn rejectCases(): []Case {
  return [
    // The three spellings from the report, against a module that MUST be seen
    // to fail. Exit 2 and the flag named, never 0 and silence.
    Case{ name: "check-version", argv: "check --version bad", wantExit: 2,
      wantErrSub: "unknown flag '--version'", wantOutSub: "", absent: "error[E0041]" },
    Case{ name: "check-bogus", argv: "check --bogus bad", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
    Case{ name: "check-short", argv: "check -x bad", wantExit: 2,
      wantErrSub: "unknown flag '-x'", wantOutSub: "", absent: "" },
    Case{ name: "run-bogus", argv: "run --bogus ok.bit", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "ok" },
    Case{ name: "build-bogus", argv: "build ok.bit --nope", wantExit: 2,
      wantErrSub: "unknown flag '--nope'", wantOutSub: "", absent: "" },
    Case{ name: "test-bogus", argv: "test --bogus ok.bit", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
    Case{ name: "fmt-bogus", argv: "fmt --bogus ok.bit", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "cannot read" },
    Case{ name: "doc-bogus", argv: "doc --bogus good", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
    Case{ name: "lint-bogus", argv: "lint --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
    Case{ name: "lsp-bogus", argv: "lsp --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
    Case{ name: "ar-bogus", argv: "ar out.a --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
    Case{ name: "version-bogus", argv: "version --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "" },
  ]
}

// THE ACCEPTANCES. Without these the file above is satisfied by a front end
// that refuses every flag there is, which would be a worse compiler than the
// one with the bug.
fn acceptCases(): []Case {
  return [
    // The behaviour #2107 exists to protect: the module is still checked, and
    // still rejected, when nothing precedes it.
    Case{ name: "check-bad", argv: "check bad", wantExit: 1,
      wantErrSub: "error[E0041]", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "check-good", argv: "check good", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "run-plain", argv: "run ok.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "ok", absent: "unknown flag" },
    // Every declared `build` flag, including the value-skipping branch: `-o`'s
    // value begins with `-` and is an operand, not a flag.
    Case{ name: "build-dash-value", argv: "build ok.bit -o -weird", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "build-emit-obj", argv: "build ok.bit -c -o ok.o", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "build-target", argv: "build ok.bit --target aarch64-linux -o ok.lin", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "fmt-check", argv: "fmt --check ok.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    // `--check` after the path, which used to be read as a filename. Declaring
    // a flag accepted while the parser treats it as an operand is the drift the
    // front end exists to prevent, so it is asserted rather than assumed.
    Case{ name: "fmt-check-trailing", argv: "fmt ok.bit --check", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "cannot read" },
    Case{ name: "doc-json", argv: "doc --json good", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "lint-json", argv: "lint --json good", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    Case{ name: "version-plain", argv: "version", wantExit: 0,
      wantErrSub: "", wantOutSub: "bit ", absent: "unknown flag" },
    // `bit lsp --stdio` is what LSP clients send by convention. It worked by
    // accident before the front end existed (every argument was dropped), and
    // refusing it would break a working editor for no gain. Reads an empty
    // stdin and exits 0, exactly as bare `bit lsp` does here.
    Case{ name: "lsp-stdio", argv: "lsp --stdio", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unknown flag" },
    // `pmcli.bit` owns its own flags (#2267) and is absent from the front
    // end's table, so its operand positions are guarded there instead. This
    // one reached the NETWORK: `--bogus` became a vanity package and `bit add`
    // tried to resolve `https://--bogus`. "must not touch the network" is what
    // the absent needle asserts.
    Case{ name: "add-flag-operand", argv: "add --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "https://--bogus" },
    Case{ name: "remove-flag-operand", argv: "remove --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "no such dependency" },
    Case{ name: "up-flag-operand", argv: "up --bogus", wantExit: 2,
      wantErrSub: "unknown flag '--bogus'", wantOutSub: "", absent: "no such dependency" },
    // The pm `--help` path landed by #2267 — asserted here so the guard above
    // cannot be tightened into swallowing it.
    Case{ name: "add-help-kept", argv: "add --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit add", absent: "unknown flag" },
  ]
}

// THE HELP SURFACE (#2233). Before this there was no `--help` anywhere and no
// other shipped source of flag documentation — no man page, and a README that
// names no flag — so the only way to learn `bit build -o out` exists was to
// read the compiler source, which an installed user does not have. Every one of
// the twelve subcommands answered `--help` with a different wrong answer, so
// each `absent` needle below is the exact wrong answer that row used to give.
fn helpCases(): []Case {
  return [
    Case{ name: "top-long", argv: "--help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit <subcommand>", absent: "unknown subcommand" },
    Case{ name: "top-short", argv: "-h", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit <subcommand>", absent: "unknown subcommand" },
    Case{ name: "top-word", argv: "help", wantExit: 0,
      wantErrSub: "", wantOutSub: "  build     compile", absent: "unknown subcommand" },
    Case{ name: "build-help", argv: "build --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit build", absent: "NoMain" },
    // The flag descriptions themselves, not merely the invocation line — an
    // acceptance that stopped at "usage:" would pass on a one-line stub.
    Case{ name: "build-help-flags", argv: "build -h", wantExit: 0,
      wantErrSub: "", wantOutSub: "-t, --target <triple>", absent: "NoMain" },
    Case{ name: "run-help", argv: "run --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit run", absent: "NoMain" },
    Case{ name: "check-help", argv: "check --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit check", absent: "unknown flag" },
    Case{ name: "test-help", argv: "test --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit test", absent: "no tests in" },
    Case{ name: "fmt-help", argv: "fmt --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit fmt", absent: "cannot read" },
    Case{ name: "doc-help", argv: "doc --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit doc", absent: "not a module" },
    Case{ name: "lint-help", argv: "lint --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit lint", absent: "unknown flag" },
    Case{ name: "lsp-help", argv: "lsp --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit lsp", absent: "unknown flag" },
    Case{ name: "ar-help", argv: "ar --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit ar", absent: "no input objects" },
    Case{ name: "version-help", argv: "version --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit version", absent: "unknown flag" },
    // The pm half landed separately (#2267); asserted here so the shared front
    // end above cannot start shadowing it with a different answer.
    Case{ name: "up-help", argv: "up --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit up", absent: "does not exist" },
    Case{ name: "update-help", argv: "update --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit up", absent: "does not exist" },
    Case{ name: "remove-help", argv: "remove --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit remove", absent: "does not exist" },
  ]
}

// THE SURPLUS OPERANDS (#2023). `bit check good extra` built the module,
// discarded the extra argument and exited 0 — so a mistyped flag and a
// program's own argv vanished the same way, while `bit build` refused the
// identical input. Each case here names the token that used to disappear.
//
// `run` USED TO be in this table (`run-surplus`/`run-surplus-one`, pinning
// #2023's `bit run x.bit alpha beta` and #2865's `bit run <script> <dir>`
// shapes) and no longer is: #2399 gave `bit run` real argv forwarding, so an
// operand past the module path is no longer surplus, it is the program's own
// argument. The identical two inputs now live in `runForwardCases` below,
// asserting the opposite outcome — forwarded, not refused.
fn surplusCases(): []Case {
  return [
    Case{ name: "check-surplus", argv: "check good extra", wantExit: 2,
      wantErrSub: "unexpected argument 'extra'", wantOutSub: "", absent: "" },
    Case{ name: "test-surplus", argv: "test ok.bit extra", wantExit: 2,
      wantErrSub: "unexpected argument 'extra'", wantOutSub: "", absent: "no tests in" },
    Case{ name: "doc-surplus", argv: "doc good extra", wantExit: 2,
      wantErrSub: "unexpected argument 'extra'", wantOutSub: "", absent: "" },
    Case{ name: "build-surplus", argv: "build ok.bit extra", wantExit: 2,
      wantErrSub: "unexpected argument 'extra'", wantOutSub: "", absent: "" },
    Case{ name: "lsp-surplus", argv: "lsp extra", wantExit: 2,
      wantErrSub: "unexpected argument 'extra'", wantOutSub: "", absent: "" },
    Case{ name: "version-surplus", argv: "version extra", wantExit: 2,
      wantErrSub: "unexpected argument 'extra'", wantOutSub: "", absent: "" },
    // The value-taking flag with nothing left to consume — the one shape
    // `build`'s own parser still decides, and it must not report exit 1.
    Case{ name: "build-dangling-o", argv: "build ok.bit -o", wantExit: 2,
      wantErrSub: "unexpected argument '-o'", wantOutSub: "", absent: "" },
    // Not surplus: the subcommands that take as many operands as they are
    // given must keep taking them.
    Case{ name: "fmt-many", argv: "fmt --check ok.bit good", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unexpected argument" },
    Case{ name: "lint-many", argv: "lint ok.bit good", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "unexpected argument" },
  ]
}

// Mirrors `compiler/build.bit`'s `runMaxForwardedArgs` (#2399) — this file
// cannot see into `compiler/`'s tree, the same reason
// `runtime/root/darwin/fs.bit`'s `fsLinkMaxPath` mirrors `fsMaxPath`. Keep
// the two literals equal.
const runMaxForwardedArgsForTest: int = 64

// `"run echoargs.bit"` followed by `n` single-letter tokens, built rather
// than hand-typed so the boundary rows below (exactly the max, and one past
// it) stay exact even if `runMaxForwardedArgsForTest` above changes.
fn runArgvWithNForwarded(n: int): string {
  let argv = "run echoargs.bit"
  let i = 0
  while (i < n) {
    argv = argv + " a"
    i = i + 1
  }
  return argv
}

// THE FORWARDED ARGUMENTS (#2399). `bit run <src> [args...]` passes
// everything after `<src>` to the program as its own argv, `arg(0)` staying
// the built binary's own path exactly as it is for a program run directly —
// `echoargs.bit` (`makeFixtures`, clicmd.bit) prints that back.
fn runForwardCases(): []Case {
  return [
    // Zero arguments: unchanged from before #2399 — one entry, arg(0) only.
    Case{ name: "run-forward-none", argv: "run echoargs.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "argc=1", absent: "unexpected argument" },
    // One plain argument.
    Case{ name: "run-forward-one", argv: "run echoargs.bit hello", wantExit: 0,
      wantErrSub: "", wantOutSub: "[1]=hello", absent: "unexpected argument" },
    // The ticket's own two-argument acceptance example — adjacent in the
    // fixture's output, so ordering is asserted along with the values.
    Case{ name: "run-forward-two", argv: "run echoargs.bit alpha beta", wantExit: 0,
      wantErrSub: "", wantOutSub: "[1]=alpha\n[2]=beta", absent: "unexpected argument" },
    // #2023's and #2865's exact historical repros — `surplusCases`' old
    // `run-surplus`/`run-surplus-one`, which asserted rejection. Now they
    // must succeed; `ok.bit` ignores whatever arguments it is handed.
    Case{ name: "run-forward-legacy-surplus", argv: "run ok.bit alpha beta", wantExit: 0,
      wantErrSub: "", wantOutSub: "ok", absent: "unexpected argument" },
    Case{ name: "run-forward-legacy-surplus-one", argv: "run ok.bit onedir", wantExit: 0,
      wantErrSub: "", wantOutSub: "ok", absent: "unexpected argument" },
    // A flag-lookalike WITHOUT `--` is still refused as an unknown flag of
    // `bit run` itself — forwarding never bypasses the front end's own flag
    // check, only an explicit `--` does that.
    Case{ name: "run-forward-flag-rejected", argv: "run echoargs.bit -x", wantExit: 2,
      wantErrSub: "unknown flag '-x'", wantOutSub: "", absent: "argc" },
    // The same token, past an explicit `--`: forwarded verbatim, never
    // interpreted as a flag of `bit run`'s own.
    Case{ name: "run-forward-flag-separator", argv: "run echoargs.bit -- -x", wantExit: 0,
      wantErrSub: "", wantOutSub: "[1]=-x", absent: "unknown flag" },
    // An empty-string argument must arrive as one — neither dropped nor
    // collapsed into an entry either side of it (cli.bit's own `cliScanArgs`
    // comment names this exact case as the reason it reports an INDEX).
    Case{ name: "run-forward-empty-string", argv: "run echoargs.bit ''", wantExit: 0,
      wantErrSub: "", wantOutSub: "[1]=\n", absent: "unexpected argument" },
    // A single argument containing a space, quoted at the shell exactly as a
    // caller would type it — this file's own `argv` is spliced into
    // `/bin/sh` text, so the quoting here is the SAME quoting a real shell
    // applies before `bit run` ever sees the token.
    Case{ name: "run-forward-space", argv: "run echoargs.bit 'hello world'", wantExit: 0,
      wantErrSub: "", wantOutSub: "[1]=hello world", absent: "unexpected argument" },
    // `bit run <src> --help` still means `bit run`'s OWN help — unchanged
    // precedent — and the program never runs at all.
    Case{ name: "run-forward-help-not-forwarded", argv: "run ok.bit --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "usage: bit run", absent: "ok" },
    // Past `--`, a literal `--help` is just another forwarded argument.
    Case{ name: "run-forward-help-past-separator", argv: "run echoargs.bit -- --help", wantExit: 0,
      wantErrSub: "", wantOutSub: "[1]=--help", absent: "usage: bit run" },
    // Exactly the stated maximum: must still succeed — the boundary is
    // "more than", not "at least".
    Case{ name: "run-forward-at-max", argv: runArgvWithNForwarded(runMaxForwardedArgsForTest),
      wantExit: 0, wantErrSub: "",
      wantOutSub: "argc=${runMaxForwardedArgsForTest + 1}", absent: "too many arguments" },
    // One past it: a clean, named rejection — never a truncation.
    Case{ name: "run-forward-over-max", argv: runArgvWithNForwarded(runMaxForwardedArgsForTest + 1),
      wantExit: 2, wantErrSub: "too many arguments", wantOutSub: "", absent: "argc" },
  ]
}

// `build`'s OWN flag validation (#2412), found auditing the same ticket:
// `--target`'s value and the `--freestanding`-without-`-c` combination are
// rejected by `build`'s own argument loop in compiler/main.bit, not by the
// shared front end above, and both used to print to stdout like every other
// diagnostic that ticket covers.
fn buildFlagValidationCases(): []Case {
  return [
    Case{ name: "build-bad-target", argv: "build ok.bit --target bogus-arch -o ok.badtarget",
      wantExit: 1, wantErrSub: "unknown target 'bogus-arch'", wantOutSub: "", absent: "" },
    Case{ name: "build-freestanding-no-emitobj", argv: "build ok.bit --freestanding -o ok.free",
      wantExit: 2, wantErrSub: "--freestanding emits an archive member", wantOutSub: "", absent: "" },
  ]
}

// THE OPERAND THAT NAMES NOTHING (#2394 for `check`/`run`/`build`, #2249 for
// `test`). `bit check <path>` exited **0 with no output** when `<path>` did not
// exist, so `bit check src/` after a rename was a green CI step that had
// checked zero files — the same shape as #2107 above, one layer down and
// reachable without any flag at all.
//
// `loadProject` is tolerant of a root that names nothing by construction: given
// `(dir, only)` it SKIPS an `only` it cannot read, leaving a module with no files
// that parses clean. So every command that reads an operand as a module inherited
// the hole, and each told a different lie about the same input: `check` reported
// success, `run`/`build` reached the EMITTER and blamed the absent file for
// having no `main` (#2234), and `test` printed "no tests in <missing file>" and
// exited 0.
//
// A directory that EXISTS and holds no Bit source is the same defect wearing a
// different hat, so it is asserted beside it.
//
// EVERY ROW IS PAIRED WITH A NON-REGRESSION, because a guard that refuses
// everything would satisfy the refusals and break the compiler: `check good`,
// `check ok.bit` and `run ok.bit` above must stay green, and `test ok.bit` must
// still report "no tests in" and exit 0 — a real file with no tests is not a
// missing file, and this is the row that keeps the two apart.
//
// `run`/`build`/`test` diagnostics are asserted on STDERR (#2412): every
// failure message from these three used to land on stdout — the same
// condition `bit check` already reported correctly, one layer over — so a
// wrapper capturing stdout as the artifact log and stderr as the error
// channel filed the diagnostic under "output" and saw an empty error channel.
fn missingInputCases(): []Case {
  return [
    Case{ name: "check-missing-dir", argv: "check nosuchdir", wantExit: 1,
      wantErrSub: "nosuchdir: no such file or directory", wantOutSub: "", absent: "" },
    Case{ name: "check-missing-file", argv: "check nosuch.bit", wantExit: 1,
      wantErrSub: "nosuch.bit: no such file or directory", wantOutSub: "", absent: "" },
    Case{ name: "check-empty-dir", argv: "check empty", wantExit: 1,
      wantErrSub: "empty: no .bit source files in this directory", wantOutSub: "", absent: "" },
    Case{ name: "check-dir-without-bit", argv: "check nosrc", wantExit: 1,
      wantErrSub: "nosrc: no .bit source files in this directory", wantOutSub: "", absent: "" },
    // The rows that used to be blamed on a missing `main`. `NoMain` is asserted
    // absent here as well as in the entry-point group: these inputs are not
    // "no main" conditions and no wording at the emitter could make them right.
    Case{ name: "run-missing-file", argv: "run nosuch.bit", wantExit: 1,
      wantErrSub: "nosuch.bit: no such file or directory", wantOutSub: "", absent: "NoMain" },
    Case{ name: "build-missing-file", argv: "build nosuch.bit -o nosuch.out", wantExit: 1,
      wantErrSub: "nosuch.bit: no such file or directory", wantOutSub: "", absent: "NoMain" },
    Case{ name: "test-missing-file", argv: "test nosuch.bit", wantExit: 1,
      wantErrSub: "nosuch.bit: no such file or directory", wantOutSub: "", absent: "no tests in" },
    // #2249's three remaining operand shapes for `test`, which the row above
    // does not reach. A DIRECTORY and an ABSOLUTE path travel different
    // branches of the guard than a relative file does — `fsIsDir` decides
    // between the first two — and each is a real CI spelling: `bit test
    // "$TESTDIR"` after a rename, and a Makefile carrying an absolute path.
    // All three used to print "no tests in <path>" and exit 0, so a suite
    // switched off by a typo read as a suite that passed.
    Case{ name: "test-missing-dir", argv: "test nosuchdir", wantExit: 1,
      wantErrSub: "nosuchdir: no such file or directory", wantOutSub: "", absent: "no tests in" },
    Case{ name: "test-missing-abs", argv: "test /definitely/not/a/real/path", wantExit: 1,
      wantErrSub: "/definitely/not/a/real/path: no such file or directory", wantOutSub: "",
      absent: "no tests in" },
    // The directory that RESOLVES and holds no Bit source at any depth: still a
    // refusal, and worded as one, because `check`/`run` refuse the same input.
    // Distinct from "a module with no tests", which is exit 0 two rows below.
    Case{ name: "test-empty-dir", argv: "test empty", wantExit: 1,
      wantErrSub: "empty: no .bit source files in this directory", wantOutSub: "",
      absent: "no tests in" },
    Case{ name: "run-empty-dir", argv: "run empty", wantExit: 1,
      wantErrSub: "empty: no .bit source files in this directory", wantOutSub: "", absent: "NoMain" },
    // The non-regressions. `check ok.bit` covers the single-file module the
    // guard has to keep accepting (SPEC §17.1), and `test ok.bit` is the row
    // that proves "exists, defines no test" is still not an error.
    Case{ name: "check-single-file", argv: "check ok.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "no such file" },
    Case{ name: "test-no-tests", argv: "test ok.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "no tests in ok.bit", absent: "no such file" },
    // `bit doc` (#2411) — the last of the #2394/#2234/#2396 family, left open
    // because `compiler/doc.bit` was outside that fix's write fence. Before
    // this, all three rows below printed nothing and exited 0, the same
    // answer as a module whose exports are all private (the non-regression
    // two rows down), so a mistyped path could not be told from "nothing to
    // document" — by a user or by a script.
    Case{ name: "doc-missing-dir", argv: "doc nosuchdir", wantExit: 1,
      wantErrSub: "nosuchdir: no such file or directory", wantOutSub: "",
      absent: "not a module" },
    Case{ name: "doc-empty-dir", argv: "doc empty", wantExit: 1,
      wantErrSub: "empty: no .bit source files in this directory", wantOutSub: "",
      absent: "not a module" },
    Case{ name: "doc-dir-without-bit", argv: "doc nosrc", wantExit: 1,
      wantErrSub: "nosrc: no .bit source files in this directory", wantOutSub: "",
      absent: "not a module" },
    // The non-regression that keeps the fix from over-reaching: `nomaindir`
    // has REAL Bit source, it just exports nothing, which is a legitimate and
    // different case from the three above. It must keep exiting 0 and
    // printing nothing, exactly as it did before this fix — `absent: "greet"`
    // catches the unexported symbol ever leaking into the output.
    Case{ name: "doc-no-exports", argv: "doc nomaindir", wantExit: 0,
      wantErrSub: "", wantOutSub: "", absent: "greet" },
    // The other non-regression: a module with a real, exported surface must
    // still be documented.
    Case{ name: "doc-real-exports", argv: "doc docexports", wantExit: 0,
      wantErrSub: "", wantOutSub: "function greet () => string",
      absent: "no .bit source" },
    // #2828: `bit doc` gets #2254's manifest-vs-lock guard, the third call
    // site alongside `checkCmd` and `buildIr`. Before this fix, a malformed
    // `bit.json` was never opened at all and `doc docbadmanifest` printed
    // `greet` and exited 0 — the same silent-success bug #2254 closed for
    // `check`/`build`/`run`.
    Case{ name: "doc-bad-manifest", argv: "doc docbadmanifest", wantExit: 1,
      wantErrSub: "bit.json", wantOutSub: "", absent: "greet" },
  ]
}

// THE MISSING ENTRY POINT (#2234). `bit run`/`bit build` reported a module with
// no `main` as `bit: <path>: NoMain` — an internal error-enum identifier, in
// CamelCase with no space, unlike every other message the CLI emits, and the
// same string it printed for a file that did not exist (fixed above) and for an
// empty directory. A developer who mistyped `mian.bit` was told the file had no
// main.
//
// `bit test` already words the analogous situation correctly — "no tests in x
// (a test is a top-level `function test_<name>()`)" — so the shape was in the
// tree; `main` now gets the same one.
//
// BOTH EMITTERS. The string lived twice, byte-identical, in
// compiler/emitelf.bit and compiler/emitmacho.bit, so a fix to one leaves the
// other shipping the enum name. `--target aarch64-linux` reaches the ELF site
// and the host default reaches the Mach-O one; both are asserted here, and the
// `absent: "NoMain"` needle is what would catch a half-fix.
fn entryPointCases(): []Case {
  return [
    Case{ name: "run-nomain-file", argv: "run nomain.bit", wantExit: 1,
      wantErrSub: "no `main` in this module", wantOutSub: "", absent: "NoMain" },
    // The hint itself, not merely the first clause: an acceptance that stopped
    // at "no `main`" would pass on a message that still says nothing about what
    // an entry point looks like.
    Case{ name: "build-nomain-file", argv: "build nomain.bit -o nomain.out", wantExit: 1,
      wantErrSub: "an entry point is a top-level `fn main()`", wantOutSub: "",
      absent: "NoMain" },
    Case{ name: "run-nomain-dir", argv: "run nomaindir", wantExit: 1,
      wantErrSub: "no `main` in this module", wantOutSub: "", absent: "NoMain" },
    // The ELF emitter's copy of the same string.
    Case{ name: "build-nomain-elf", argv: "build nomain.bit --target aarch64-linux -o nomain.lin",
      wantExit: 1, wantErrSub: "no `main` in this module", wantOutSub: "", absent: "NoMain" },
    // Non-regression: `bit test` synthesizes its own entry point, so a module
    // with no `main` is not an error there and must not become one.
    Case{ name: "test-nomain-file", argv: "test nomain.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "no tests in nomain.bit", absent: "no `main`" },
  ]
}

// RECURSIVE DISCOVERY (#2247). `bit test rec` used to build and run only
// `rec`'s own `test_*` functions, never `./mathx`'s — so the DELIBERATELY
// BROKEN assertion in `rec/mathx/mathx_test.bit` sat in the tree while the
// parent run printed `1 test: 1 passed, 0 failed` and exited 0. Both of
// those exact symptoms are asserted directly: `wantExit: 1` (the bug reports
// 0) and `wantOutSub` naming the sub-module's failing test (the bug's stdout
// never mentions it — `test_clamp_is_deliberately_broken` cannot appear on a
// run that never built `mathx`). Together they leave no passing reading
// under the old behaviour; `absent` is not needed on top of them, and the
// obvious candidate — the bug's exact combined line — is also the correct
// PER-MODULE summary `rec`'s own passing test still prints today, so
// asserting it absent would fail on the fix, not the bug.
//
// `test-recursive-child` is not new behaviour — `bit test rec/mathx` alone
// already found this failure before #2247 — but it is asserted here anyway,
// against the SAME fixture the parent row uses, as the control: if this one
// ever went green the fixture itself would be broken, not the feature.
fn recursiveTestCases(): []Case {
  return [
    Case{ name: "test-recursive-parent", argv: "test rec", wantExit: 1,
      wantErrSub: "", wantOutSub: "test_clamp_is_deliberately_broken", absent: "" },
    Case{ name: "test-recursive-child", argv: "test rec/mathx", wantExit: 1,
      wantErrSub: "", wantOutSub: "test_clamp_is_deliberately_broken", absent: "" },
  ]
}

// THE WALK ESCAPING ITS ROOT (#2489), same class as #2152's `std/fs.walk` bug
// and built on the `symlinkwalk/` fixture `makeSymlinkFixtures` sets up
// alongside a link to `${root}-outside` and a self-referential one. `wantExit:
// 0` and `wantOutSub` naming the real test are the fixed behaviour;
// `absent: "=="` is what the bug flips — `testProject`'s per-module `==` header
// can only appear if the walk found a second module, which it can only do by
// following one of the two links.
fn symlinkWalkCases(): []Case {
  return [
    Case{ name: "test-symlink-no-follow", argv: "test symlinkwalk", wantExit: 0,
      wantErrSub: "", wantOutSub: "test_symlinkwalk_real", absent: "==" },
  ]
}

// THE WARNING THAT NEVER RENDERED (#2491). `hasErrors` reflects only
// `errorCount`, and a warning (E0048, shadowing a predeclared identifier —
// still the only one) deliberately never bumps it, so `reportCheckErrors`'s
// `!hasErrors(d)` gate returned false — "nothing to report" — for a
// diagnostics list holding a warning and nothing else, and the caller never
// reached `renderDiags` at all. Confirmed on the pinned stage0 oracle too: no
// released `bit` has ever shown this warning through `check` or `build`.
//
// `shadow.bit` is built to have EXACTLY one diagnostic and it must be this
// one: `check_shadows_predeclared.bit` under tests/cases/ pairs the same
// warning with a real type error precisely because that combination already
// worked (the error's `hasErrors` gate rendered the whole list, warning
// included) — so it could not have caught this bug, and does not exercise the
// fix (`reportCheckDiagnostics`'s render-on-nonempty-list branch) at all.
// `absent: "error["` keeps this row from silently degrading into that one.
fn warningCases(): []Case {
  return [
    Case{ name: "check-shadow-warning", argv: "check shadow.bit", wantExit: 0,
      wantErrSub: "warning[E0048]", wantOutSub: "", absent: "error[" },
  ]
}

// #3009: raw-string `${...}` warns (E0098) only on a well-formed pair.
// `run`, not `check`, on every row: the same case proves the diagnostic AND
// that the program still compiles, runs, and prints the raw text unchanged —
// the "warning, not error" constraint the ticket is about. The three silent
// rows are the false-positive guard: a bare `$`, a `$foo` shell variable, and
// an unmatched `${` are exactly what a raw string exists to hold, and this is
// the table that would go red if the check ever started firing on them.
fn rawInterpWarningCases(): []Case {
  return [
    Case{ name: "run-rawinterp-warns", argv: "run rawinterp_warn.bit", wantExit: 0,
      wantErrSub: "warning[E0098]", wantOutSub: "The sum is \${1 + 2}", absent: "error[" },
    Case{ name: "run-rawinterp-dollar-silent", argv: "run rawinterp_dollar.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "price is $5", absent: "E0098" },
    Case{ name: "run-rawinterp-var-silent", argv: "run rawinterp_var.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "echo $foo", absent: "E0098" },
    Case{ name: "run-rawinterp-unmatched-silent", argv: "run rawinterp_unmatched.bit", wantExit: 0,
      wantErrSub: "", wantOutSub: "\${unterminated brace", absent: "E0098" },
  ]
}
