// tests/bit/filesize.bit — a file-size ratchet over tests/bit/*.bit (#2793).
//
// docs/development.md and CONTRIBUTING.md set an 800-line hard limit per file,
// backed by compiler/lint.bit's E0200 `max-file-lines` rule — but no gate ever
// pointed `bit lint` (or anything else) at `tests/bit/` itself, so seven
// harness files drifted past the limit with nothing to catch it (#2793):
// stwwiring.bit (993), clicmd.bit (952), abimembers.bit (917), rootpins.bit
// (905), rootabi.bit (821), golden.bit (819), stress.bit (805). Two more sit
// at exactly 800 (docs.bit, spec.bit) — legal, with zero headroom.
//
// THE RULE IS `> 800` FAILS, NOT `>= 800` — the same threshold E0200 uses
// (compiler/lint.bit's `lintMaxFileLines`: `n <= limit` passes), so a file
// sitting exactly at 800 is not a false positive.
//
// THE RATCHET. Splitting seven test files — one of them 993 lines — is a real
// refactor per file, not this ticket's job (see #2793's follow-ups).
// Introducing the limit into a tree that already violates it seven times over
// means grandfathering the existing offenders rather than either (a) blocking
// every future edit to `tests/bit/` on an unrelated refactor, or (b) silently
// exempting `tests/bit/` from the limit forever. `grandfatherList` below is
// the visible allowlist: each entry carries the file's line count AS
// MEASURED when it was grandfathered, and a grandfathered file may only ever
// get SMALLER — growing even one line past its recorded count fails the gate,
// naming the file and both counts. A file with no entry (including any new
// file dropped into tests/bit/) must comply with the 800-line limit
// immediately; there is no default exemption.
//
// THE DEBT STAYS VISIBLE. `reportResult` prints how many grandfathered files
// are STILL over 800 right now and their combined overage every run — an
// allowlist nobody has to look at is exactly the kind of green-but-unverified
// result this repo already has four other documented ways to produce
// (docs/development.md); this gate does not add a fifth.
//
// SCOPE: only `.bit` files directly under `tests/bit/`, not its fixture
// subdirectories (`checkercases/`, `parsercases/`) — those are corpora of
// small synthetic cases consumed by `test-checker-diag`/`test-parser`, not
// harness files subject to the 800-line rule themselves.
//
// `BIT_REPO` overrides the directory searched for a `tests/bit` subdirectory,
// the same override every other tests/bit/*.bit harness in this family reads
// (default: search . / .. / ../.. / ../../..) — used by this gate's own
// mutation tests to point the scan at a scratch tree instead of the real one.
//
// Run from the repository root: bit-out/bin/bit run tests/bit/filesize.bit

import { readDir, readFile, isDir } from "std/fs"
import { env } from "std/os"
import { hasSuffix } from "std/strings"

// Bounds — Power of 10 rule 2: every walk below is over a small, fixed
// directory, but each is still capped explicitly.
const maxFiles: int = 256
const maxFileBytes: int = 4194304

// The hard limit itself — E0200's default in compiler/lint.bit, restated here
// rather than imported: this gate is deliberately independent of the checker
// front end (it never invokes `bit lint`), so a bug in the checker cannot
// silently disable it.
const maxFileLines: int = 800

// One grandfathered file: `lines` is its line count AS MEASURED when it was
// grandfathered, and the ceiling it may never grow past again.
struct Grandfathered { name: string, lines: int }

// #2793's inventory, measured on merged main (`adbbabe6`) with `wc -l` over
// `git ls-files 'tests/bit/*.bit'`. Shrink or remove an entry the day its
// file drops under 800 lines for good; never raise one.
fn grandfatherList(): []Grandfathered {
  return [
    Grandfathered{ name: "stwwiring.bit", lines: 993 },
    Grandfathered{ name: "clicmd.bit", lines: 952 },
    Grandfathered{ name: "abimembers.bit", lines: 917 },
    Grandfathered{ name: "rootpins.bit", lines: 905 },
    Grandfathered{ name: "rootabi.bit", lines: 821 },
    Grandfathered{ name: "golden.bit", lines: 711 },
    Grandfathered{ name: "stress.bit", lines: 805 },
  ]
}

struct ScanResult {
  failures: int
  filesScanned: int
  grandfatheredOver: int
  overageTotal: int
}

fn die(msg: string) {
  eprint("filesize: SETUP FAILED: ${msg}\n")
  osExit(1)
}

fn report(sc: ScanResult, msg: string) {
  eprint("filesize: FAIL: ${msg}\n")
  sc.failures = sc.failures + 1
}

// The repo root: the nearest ancestor holding a `tests/bit` directory.
// `BIT_REPO` wins outright, including for a scratch tree this gate's own
// mutation tests point it at — never falls back silently.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (isDir("${c}/tests/bit")) {
      return c
    }
  }
  die("cannot locate a tests/bit directory from this cwd; set BIT_REPO")
  return ""
}

// Mirrors compiler/lint.bit's `lintCountLines` exactly, so this gate's counts
// agree with E0200's: every `\n`, plus one more if the file's last byte is
// not itself a `\n` (an unterminated final line still counts).
fn lineCount(src: string): int {
  if (len(src) == 0) {
    return 0
  }
  let n = 0
  let i = 0
  while (i < len(src)) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  if (src[len(src) - 1] != '\n') {
    n = n + 1
  }
  return n
}

fn findGrandfathered(list: []Grandfathered, name: string): (Grandfathered, bool) {
  for g of list {
    if (g.name == name) {
      return g, true
    }
  }
  return Grandfathered{ name: "", lines: 0 }, false
}

// One file's verdict, computed with NO side effect — deliberately separate
// from `checkFile` below so `selfTestEvaluateFile` can drive this against
// synthetic names and counts without also triggering `report`'s stderr
// output, which would otherwise make a clean self-test print what looks like
// a real failure. `violates` decides pass/fail; `overLimit`/`overage` feed
// the visible debt tally regardless of `violates` — a grandfathered file
// still over `maxFileLines` but under its recorded ceiling is passing AND
// still counted as debt.
struct Verdict { violates: bool, msg: string, overLimit: bool, overage: int }

fn evaluateFile(list: []Grandfathered, name: string, count: int): Verdict {
  let (g, found) = findGrandfathered(list, name)
  if (found) {
    let overLimit = count > maxFileLines
    let overage = 0
    if (overLimit) {
      overage = count - maxFileLines
    }
    return Verdict{
      violates: count > g.lines,
      msg: "tests/bit/${name} grew to ${count} lines, past its grandfathered ${g.lines} — a grandfathered file may only get smaller",
      overLimit: overLimit, overage: overage,
    }
  }
  return Verdict{
    violates: count > maxFileLines,
    msg: "tests/bit/${name} is ${count} lines, over the ${maxFileLines}-line limit with no grandfather entry",
    overLimit: false, overage: 0,
  }
}

// One file's real verdict, applied: reports a violation and/or tallies debt
// against `sc`. The only caller of `report` in this file — self-tests drive
// `evaluateFile` directly instead, so they never print.
fn checkFile(sc: ScanResult, list: []Grandfathered, name: string, count: int) {
  let v = evaluateFile(list, name, count)
  if (v.violates) {
    report(sc, v.msg)
  }
  if (v.overLimit) {
    sc.grandfatheredOver = sc.grandfatheredOver + 1
    sc.overageTotal = sc.overageTotal + v.overage
  }
}

fn scanDir(sc: ScanResult, dir: string, list: []Grandfathered) {
  let names = readDir(dir) catch e {
    die("cannot list ${dir}: ${e.message()}")
    []string(0)
  }
  if (len(names) > maxFiles) {
    die("${dir} has ${len(names)} entries, over the ${maxFiles} bound")
  }
  for name of names {
    if (!hasSuffix(name, ".bit")) {
      continue
    }
    let path = "${dir}/${name}"
    let src = readFile(path) catch e {
      die("cannot read ${path}: ${e.message()}")
      ""
    }
    if (len(src) > maxFileBytes) {
      die("${path} is ${len(src)} bytes, over the ${maxFileBytes} bound")
    }
    sc.filesScanned = sc.filesScanned + 1
    checkFile(sc, list, name, lineCount(src))
  }
}

fn reportResult(sc: ScanResult) {
  if (sc.failures > 0) {
    eprint("filesize: FAILED — ${sc.failures} finding(s) over ${sc.filesScanned} file(s) scanned\n")
    osExit(1)
  }
  print("filesize: ok — ${sc.filesScanned} file(s) scanned, ${sc.grandfatheredOver} grandfathered file(s) still over the ${maxFileLines}-line limit, ${sc.overageTotal} line(s) total overage\n")
}

fn selfCheck(cond: bool, label: string): int {
  if (cond) {
    return 0
  }
  eprint("filesize: SELFTEST FAIL: ${label}\n")
  return 1
}

fn selfTestLineCount(): int {
  let failed = 0
  failed = failed + selfCheck(lineCount("") == 0,
    "lineCount misjudged an empty file")
  failed = failed + selfCheck(lineCount("abc") == 1,
    "lineCount misjudged a file with no trailing newline")
  failed = failed + selfCheck(lineCount("abc\n") == 1,
    "lineCount misjudged a single terminated line")
  failed = failed + selfCheck(lineCount("a\nb\n") == 2,
    "lineCount misjudged two terminated lines")
  failed = failed + selfCheck(lineCount("a\nb") == 2,
    "lineCount misjudged a trailing unterminated line")
  return failed
}

fn freshScan(): ScanResult {
  return ScanResult{ failures: 0, filesScanned: 0, grandfatheredOver: 0, overageTotal: 0 }
}

// Exercises `evaluateFile` against synthetic names and counts BEFORE the real
// scan, on the same principle as spec.bit's selfTest: a bug in the verdict
// logic must be caught on known-good/known-bad input, not silently mis-score
// the real corpus. Drives `evaluateFile` (the pure decision), not `checkFile`
// (which calls `report` and would print a stderr line for every synthetic
// case here, indistinguishable from a real finding).
fn selfTestEvaluateFile(): int {
  let failed = 0
  let list = [Grandfathered{ name: "old.bit", lines: 900 }]

  let grow = evaluateFile(list, "old.bit", 901)
  failed = failed + selfCheck(grow.violates,
    "evaluateFile did not flag a grandfathered file that grew past its recorded count")

  let shrink = evaluateFile(list, "old.bit", 850)
  failed = failed + selfCheck(!shrink.violates,
    "evaluateFile flagged a grandfathered file that stayed under its recorded count")
  failed = failed + selfCheck(shrink.overLimit && shrink.overage == 50,
    "evaluateFile miscomputed overage for a grandfathered file still over the limit")

  let newOver = evaluateFile(list, "brandnew.bit", 801)
  failed = failed + selfCheck(newOver.violates,
    "evaluateFile did not flag a non-grandfathered file over the limit")

  let newUnder = evaluateFile(list, "brandnew.bit", 800)
  failed = failed + selfCheck(!newUnder.violates,
    "evaluateFile flagged a non-grandfathered file sitting exactly at the limit")

  return failed
}

fn selfTest(): int {
  return selfTestLineCount() + selfTestEvaluateFile()
}

fn main() {
  let selfFailed = selfTest()
  if (selfFailed != 0) {
    eprint("filesize: SELFTEST FAILED — ${selfFailed} case(s); aborting before the real scan\n")
    osExit(1)
  }

  let root = repoRoot()
  let dir = "${root}/tests/bit"
  let sc = freshScan()
  scanDir(sc, dir, grandfatherList())
  reportResult(sc)
}
