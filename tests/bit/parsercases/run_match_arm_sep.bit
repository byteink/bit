// run
// #2100: SPEC §13.8 makes a match arm's trailing separator optional AND lets it
// be `,` OR `;`, on every arm including the last — `{ match_arm [ "," | ";" ] }`.
// The parser rejected the comma form: a statement-bodied arm's own
// comma-continuation loops (`parseSimpleStmt`'s bare multi-target list,
// `parseReturn`'s multi-value list) consumed the arm-separating `,` as part of
// the CURRENT arm, silently dropping the arm written after it. Exhaustiveness
// then truthfully reported the dropped variant "not handled" — a diagnostic
// naming code the reader can see, right there, handled. This pins that every
// legal separator placement compiles and RUNS the arm it actually names, so a
// swallowed arm (wrong output, not just a parse error) fails the case.
enum Color { Red, Green, Blue }

// The ticket's literal reproduction, extended to 3 variants: comma-separated
// arms with an expression-statement body (`print(...)`), no trailing comma.
function describe(c: Color) {
  match (c) {
    Red => print("red"),
    Green => print("green"),
    Blue => print("blue")
  }
}

// `,` between arms, none after the last.
function commaNoTrailing(c: Color): string {
  match (c) {
    Red => return "r1",
    Green => return "g1",
    Blue => return "b1"
  }
  return "?"
}

// `,` after every arm, including the last.
function commaTrailing(c: Color): string {
  match (c) {
    Red => return "r2",
    Green => return "g2",
    Blue => return "b2",
  }
  return "?"
}

// `;` between arms, none after the last.
function semiNoTrailing(c: Color): string {
  match (c) {
    Red => return "r3";
    Green => return "g3";
    Blue => return "b3"
  }
  return "?"
}

// `;` after every arm, including the last.
function semiTrailing(c: Color): string {
  match (c) {
    Red => return "r4";
    Green => return "g4";
    Blue => return "b4";
  }
  return "?"
}

// No separator at all — today's working form. Must not regress.
function noSep(c: Color): string {
  match (c) {
    Red => return "r5"
    Green => return "g5"
    Blue => return "b5"
  }
  return "?"
}

function main() {
  describe(Color.Red)
  print("\n")
  describe(Color.Green)
  print("\n")
  describe(Color.Blue)
  print("\n")
  print("${commaNoTrailing(Color.Red)} ${commaNoTrailing(Color.Green)} ${commaNoTrailing(Color.Blue)}\n")
  print("${commaTrailing(Color.Red)} ${commaTrailing(Color.Green)} ${commaTrailing(Color.Blue)}\n")
  print("${semiNoTrailing(Color.Red)} ${semiNoTrailing(Color.Green)} ${semiNoTrailing(Color.Blue)}\n")
  print("${semiTrailing(Color.Red)} ${semiTrailing(Color.Green)} ${semiTrailing(Color.Blue)}\n")
  print("${noSep(Color.Red)} ${noSep(Color.Green)} ${noSep(Color.Blue)}\n")
}
