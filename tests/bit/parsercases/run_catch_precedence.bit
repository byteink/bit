// run
// #2344: `catch` binds TIGHTER than a comparison and looser than arithmetic, so
// a trailing `== x` after the fallback compares the catch's RESULT instead of
// being swallowed as part of the fallback. It used to parse as
// `read(p) catch ("<denied>" == "<denied>")` — a `bool` fallback against a
// `string!` operand, which `bit check` accepted and which then SIGSEGVed at run
// time. Every line below pins one side of the precedence boundary, because a
// fix that only re-scoped the fallback (without letting the trailing operator
// re-attach) would print nothing at all.
//
// Named `readData`, not `read`: the root module keeps bare link names, and
// `read` collides with the runtime's own linked extern (E0096, SPEC §11.7).
// Do not rename it back — the function's name is irrelevant to what this
// case tests.
struct myErr { code: i64 }
fn (e: myErr) message(): string { return "code=${e.code}" }

fn readData(bad: bool): string! {
  if (bad) {
    fail myErr{ code: 1 }
  }
  return "content"
}

fn num(bad: bool): i64! {
  if (bad) {
    fail myErr{ code: 2 }
  }
  return 10
}

fn main() {
  // The repro: the comparison applies to the catch expression, not to the
  // fallback. Both operands are the fallback string, so this is true.
  let denied = readData(true) catch "<denied>" == "<denied>"
  print("denied=${denied}\n")
  // Ok path: the comparison sees the UNWRAPPED ok value, so it is false.
  let okpath = readData(false) catch "<denied>" == "<denied>"
  print("okpath=${okpath}\n")

  // Arithmetic still binds INTO the fallback (`catch (1 + 2)`), so this is 3 —
  // if it printed 1 the fallback had been cut at the wrong operator.
  print("sum=${num(true) catch 1 + 2}\n")
  // ...and the comparison stays OUTSIDE it: `(num(true) catch 1) == 1`.
  print("cmp=${num(true) catch 1 == 1}\n")

  // `catch` is RIGHT-associative: `num(true) catch (num(false) catch 7)`. Under a
  // left-associative reading the second `catch` would guard an already-handled,
  // non-fallible `i64` and the file would not compile.
  print("chain=${num(true) catch num(false) catch 7}\n")
  print("chain2=${num(true) catch num(true) catch 7}\n")

  // The binding form is unaffected by the precedence change.
  let handled = num(true) catch e {
    print("err: ${e.message()}\n")
    0
  }
  print("handled=${handled}\n")
}
