// #3653 (2448-fallout). Guards stdlib entry points that must allocate ZERO
// heap objects per call, the class of regression #3637 (stdlib/strings/
// parseInt) and #3617 (stdlib/json/parse) both shipped: #2448's E0204 split
// took a call from 0 to exactly 1.0000 objects/call by returning a class as
// the multiple-return vehicle, and nothing caught either for months.
//
// WHY A SLOPE, NOT A TOTAL. A single run's `swept+live` includes every fixed
// allocation the runtime makes before `main` (boot, arg parsing) and would
// drift with unrelated changes, making a total-based gate flaky and, in
// time, ignored. Instead this harness builds and runs the SAME fixture body
// at `callsN` and `2*callsN` calls and takes the marginal:
//
//     (objects(2N) - objects(N)) / N == the row's declared slope
//
// Fixed per-process cost cancels out of the subtraction; only the per-call
// cost of the row's own expression survives. A single total is explained by
// boot overhead — a two-point slope is not.
//
// WHY THE CALL'S ARGUMENT IS HOISTED OUT OF THE LOOP (`let arg = ...` once,
// then `row.callExpr` referencing `arg` on every iteration). A probe that
// re-builds its own argument inside the timed loop measures the argument
// construction alongside the call under test, not the call alone — found by
// a sibling gate the same day this one was written, as a constant offset
// between two measurements of what should have been the same number.
//
// WHY `swept+live`, NEVER `swept` OR `live` ALONE. The two vary against each
// other run to run depending on exactly when the trigger fires; their sum —
// every object the process ever allocated — does not (tests/bit/lspcache.bit
// and tests/bit/benchgate/benchgate.bit's headers, same reasoning).
//
// WHY `bit build` + exec, NOT `bit run`: `bit run` refuses `BIT_GC=stress`
// but this gate does not need stress mode at all — plain `BIT_GC_STATS=1` on
// a normally-triggered run already reports the exit summary
// (tests/bit/gcbootsafepoint.bit's header explains the `bit run` refusal for
// the sibling case; this gate compiles once per (row, N) and execs directly
// for the same reason: a fresh, uncomplicated child process).
//
// WHY `int()`/`i64()` need no bridging here: `int` is an alias for `i64`
// (spec/SPEC.md §5.3), so `parseInt`'s `int!` result and the fixture's `sum`
// accumulator are the same type with no conversion call to itself allocate
// or hide behind.
//
// THE SUM CHECK inside the fixture (`sum != row.perCallValue * n`) is not
// decoration: it forces the compiler to treat every `row.callExpr` result as
// used by a data-dependent branch, and it doubles as a correctness floor — a
// loop that silently ran zero or a different number of times fails loudly
// here rather than reporting a slope of 0 for the wrong reason.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run tests/bit/allocslope.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; `BIT_STDLIB` must point
// at a real std/strings (required — this gate's fixtures import stdlib).
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Calls per measured arm. Matches the measurement recorded on #3637
// (task-3637-parseint-alloc, d4433deb): swept+live is 7 at BOTH 100000 and
// 200000 calls (dead flat, slope 0); before that fix the same probe read
// 100007 and 200007 (slope 1).
const callsN: int = 100000

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "120")) catch _ { 120 }
  if (s <= 0) {
    return 120000
  }
  return s * 1000
}

class Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("allocslope: cannot make script executable: ${scriptPath}")
  }
  return osRunBounded(scriptPath, ms)
}

fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("allocslope: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("allocslope: could not read the working directory (exit ${code})")
  }
  let candidate = "${trimWs(readFile(cwdFile)?)}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("allocslope: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// The decimal that follows the FIRST occurrence of `key`, or -1 when `key` is
// absent or not followed by a digit. -1 rather than 0 is load-bearing: a
// missing field must fail this gate, never read as "zero of it happened".
fn intAfter(s: string, key: string): int {
  let n = len(key)
  let i = 0
  while (i + n <= len(s)) {
    if (s[i:i + n] == key) {
      let j = i + n
      let v = 0
      let digits = 0
      while (j < len(s) && s[j] >= u8('0') && s[j] <= u8('9')) {
        v = v * 10 + (int(s[j]) - int(u8('0')))
        digits = digits + 1
        j = j + 1
      }
      if (digits == 0) {
        return 0 - 1
      }
      return v
    }
    i = i + 1
  }
  return 0 - 1
}

// One stdlib entry point plus a one-line call expression (#3653's own
// wording). `argLiteral` is Bit source for the argument, hoisted to a `let
// arg = ...` OUTSIDE the timed loop; `callExpr` is the one-line expression
// using `arg`, evaluated once per iteration. `perCallValue` is the exact
// `int!` this call returns on success, used only for the fixture's own
// correctness floor. `slope` is the declared objects-per-call this row must
// hold at.
class Row {
  name: string,
  importLine: string,
  argLiteral: string,
  callExpr: string,
  perCallValue: int,
  slope: int,
}

fn rows(): []Row {
  return [
    Row{
      name: "parseInt",
      importLine: "import { parseInt } from \"std/strings\"",
      argLiteral: "\"-12345\"",
      callExpr: "parseInt(arg)",
      perCallValue: 0 - 12345,
      slope: 0,
    },
  ]
}

fn fixtureSource(row: Row, n: int): string {
  return "${row.importLine}\n\n" +
    "fn main() {\n" +
    "  let arg = ${row.argLiteral}\n" +
    "  let sum = 0\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    let v = ${row.callExpr} catch _ { panic(\"allocslope: ${row.name} call failed\") }\n" +
    "    sum = sum + v\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  if (sum != ${row.perCallValue} * ${n}) {\n" +
    "    panic(\"allocslope: ${row.name} sum mismatch\")\n" +
    "  }\n" +
    "}\n"
}

class Measured { ok: bool, exitCode: int, objects: int }

fn buildFixture(bit: string, stdlib: string, src: string, prog: string, scratch: string, tag: string, ms: int): int! {
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=${stdlib}\nexport BIT_STDLIB\n" +
    "'${bit}' build '${src}' -o '${prog}'\n"
  return shell("${scratch}/build_${tag}.sh", script, ms)?
}

fn runFixture(prog: string, scratch: string, tag: string, ms: int): Measured! {
  let errPath = "${scratch}/err_${tag}.txt"
  let script = "#!/bin/sh\n" +
    "BIT_GC_STATS=1\nexport BIT_GC_STATS\n" +
    "exec '${prog}' > '${scratch}/out_${tag}.txt' 2> '${errPath}'\n"
  let code = shell("${scratch}/run_${tag}.sh", script, ms)?
  let err = readFile(errPath) catch _ { "" }
  let swept = intAfter(err, "swept=")
  let live = intAfter(err, "live=")
  if (swept < 0 || live < 0) {
    return Measured{ ok: false, exitCode: code, objects: 0 - 1 }
  }
  return Measured{ ok: true, exitCode: code, objects: swept + live }
}

// Builds and runs `row`'s fixture at exactly `n` calls, returning the
// `swept+live` object count, or -1 (having already recorded the failing
// checks under `t`) when either step could not be measured.
fn measureAt(t: Tally, bit: string, stdlib: string, scratch: string, row: Row, n: int, ms: int): int {
  let tag = "${row.name}_${n}"
  let src = "${scratch}/${tag}.bit"
  writeFile(src, fixtureSource(row, n)) catch e {
    check(t, false, "${row.name}: cannot write fixture: ${e.message()}")
    return 0 - 1
  }
  let prog = "${scratch}/${tag}"
  let build = buildFixture(bit, stdlib, src, prog, scratch, tag, ms) catch e {
    check(t, false, "${row.name}: ${e.message()}")
    return 0 - 1
  }
  check(t, build == 0 && exists(prog), "${row.name}: fixture at N=${n} must compile (bit build exited ${build})")
  if (build != 0 || !exists(prog)) {
    return 0 - 1
  }
  let run = runFixture(prog, scratch, tag, ms) catch e {
    check(t, false, "${row.name}: ${e.message()}")
    return 0 - 1
  }
  check(t, run.exitCode == 0, "${row.name}: fixture at N=${n} must exit 0 (exited ${run.exitCode})")
  check(t, run.ok, "${row.name}: no `[bit-gc] ... swept=N live=N` summary at N=${n} — the run was not measured")
  if (run.exitCode != 0 || !run.ok) {
    return 0 - 1
  }
  return run.objects
}

// Measures `row` at `callsN` and `2*callsN`, derives the marginal slope, and
// checks it against the row's declared value. Prints the two counts and the
// derived slope unconditionally, pass or fail, so a failure names the exact
// numbers it was computed from.
fn evalRow(t: Tally, bit: string, stdlib: string, scratch: string, row: Row, ms: int) {
  let objN = measureAt(t, bit, stdlib, scratch, row, callsN, ms)
  let obj2N = measureAt(t, bit, stdlib, scratch, row, callsN * 2, ms)
  if (objN < 0 || obj2N < 0) {
    return
  }
  let slope = (obj2N - objN) / callsN
  print("allocslope: ${row.name}: N=${callsN} objects=${objN}, 2N=${callsN * 2} objects=${obj2N}, slope=${slope}\n")
  check(t, slope == row.slope,
    "${row.name}: slope ${slope} objects/call, want ${row.slope} " +
    "(N=${callsN} objects=${objN}, 2N=${callsN * 2} objects=${obj2N})")
}

fn runAll(t: Tally, scratch: string, ms: int) {
  let bit = bitBinary(scratch, ms) catch e { panic("allocslope: ${e.message()}") }
  let stdlib = env("BIT_STDLIB")
  if (len(stdlib) == 0) {
    check(t, false, "BIT_STDLIB is unset — this gate needs a real stdlib to import")
    return
  }
  for row of rows() {
    evalRow(t, bit, stdlib, scratch, row, ms)
  }
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-allocslope-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e { panic("allocslope: cannot create ${scratch}: ${e.message()}") }
  defer teardown(scratch, ms)
  runAll(t, scratch, ms)

  if (t.checks < 2) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 2\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("allocslope: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("allocslope: PASS — ${t.checks} checks")
}

fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ { return }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
