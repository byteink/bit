// tests/bit/classkeyword.bit — phase 1 of the struct->class migration
// (#3425, epic #3424): `class` is accepted as a synonym for `struct` at
// every record-declaration site, and the two spellings must produce
// byte-identical binaries when built to the same `-o` path (Mach-O
// codesigning embeds the output filename, so the path has to be shared,
// not just equal).
//
// NOT placed in tests/cases/: that corpus is swept by every
// scripts/selfhost-diff*.sh differential (CORPUS="stdlib examples
// tests/cases tests/imports" in scripts/selfhost-diffdump.sh) against the
// PINNED STAGE0 oracle — an earlier RELEASED compiler that has never heard
// of `class`. It lexes as a plain identifier there, so a `class`-using file
// in tests/cases/ fails to even parse on the oracle side and reddens every
// differential by construction (verified: MISMATCH=1 on
// tests/cases/keyword_class_struct_synonym.bit, "expected a top-level
// declaration, found an identifier"). That is exactly the class of problem
// tests/bit/golden.bit's own header documents for a not-yet-released
// diagnostic — "route it to tests/bit/ behind a registered gate" — so this
// drives the CLI directly instead, outside the oracle-swept corpus.
//
// WIRED INTO `./make test` as `test-classkeyword` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 3600000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("classkeyword: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

// Same contract every harness here shares: default 60s (this gate builds and
// runs two tiny one-file programs, nothing more), `0` disables the bound.
fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// Builds `srcPath` to `outPath`, cd'd into `dir`, with the compiler's own
// environment (BIT_STDLIB/BIT_LIBBITRT) exported. Returns the wrapper's exit
// code and captured stderr.
fn buildOne(bin: string, stdlib: string, libbitrt: string, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" + shQuote(stdlib) + "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" + shQuote(libbitrt) + "\nexport BIT_LIBBITRT\n" +
    "exec " + shQuote(bin) + " build " + shQuote(srcPath) + " -o " + shQuote(outPath) +
    " > /dev/null 2> " + shQuote(errPath) + "\n"
  writeFile(shPath, script) catch e {
    eprint("classkeyword: cannot write build wrapper: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("classkeyword: cannot chmod build wrapper\n")
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ { "" }
  return code, err
}

// Runs the built binary at `binPath` (no compiler environment forwarded —
// the program under test is not the compiler's business). Returns its exit
// code and captured stdout.
fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("classkeyword: cannot write run wrapper: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("classkeyword: cannot chmod run wrapper\n")
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ { "" }
  return code, out
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let stdlib = requiredEnv("BIT_STDLIB")
  let libbitrt = requiredEnv("BIT_LIBBITRT")

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-classkeyword-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("classkeyword: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  // Identical shape, one field difference from the tests/cases idiom this
  // mirrors (`arrow_param_name_collision.bit`'s `Caller`/`Widget` pair):
  // a method-bearing record and a `main` that prints one computed value, so
  // a divergence in either spelling's codegen has somewhere to show up.
  let classSrc = "class Point { a: int, b: int }\n\n" +
    "fn (p: Point) sum(): int { return p.a + p.b }\n\n" +
    "fn main() {\n  let p = Point{ a: 3, b: 4 }\n  print(\"\${p.sum()}\\n\")\n}\n"
  let structSrc = "struct Point { a: int, b: int }\n\n" +
    "fn (p: Point) sum(): int { return p.a + p.b }\n\n" +
    "fn main() {\n  let p = Point{ a: 3, b: 4 }\n  print(\"\${p.sum()}\\n\")\n}\n"

  let classPath = scratch + "/class_point.bit"
  let structPath = scratch + "/struct_point.bit"
  writeFile(classPath, classSrc) catch e {
    eprint("classkeyword: cannot write ${classPath}: ${e.message()}\n")
    exit(2)
  }
  writeFile(structPath, structSrc) catch e {
    eprint("classkeyword: cannot write ${structPath}: ${e.message()}\n")
    exit(2)
  }

  // Same -o path for both builds (never two different paths): Mach-O
  // codesigning embeds the output filename, so two different paths would
  // differ for that reason alone, proving nothing about the keyword.
  let outPath = scratch + "/out"

  let (classCode, classErr) = buildOne(bin, stdlib, libbitrt, scratch, classPath, outPath)
  if (classCode != 0) {
    eprint("classkeyword: FAIL — 'class Point' failed to build (exit ${classCode}):\n${classErr}\n")
    exit(1)
  }
  let (classRunCode, classOut) = runOne(scratch, outPath)
  if (classRunCode != 0 || classOut != "7\n") {
    eprint("classkeyword: FAIL — 'class Point' binary ran wrong: exit=${classRunCode} out='${classOut}'\n")
    exit(1)
  }
  let classBin = readFile(outPath) catch e {
    panic("classkeyword: cannot read built binary ${outPath}: ${e.message()}")
  }

  let (structCode, structErr) = buildOne(bin, stdlib, libbitrt, scratch, structPath, outPath)
  if (structCode != 0) {
    eprint("classkeyword: FAIL — 'struct Point' failed to build (exit ${structCode}):\n${structErr}\n")
    exit(1)
  }
  let (structRunCode, structOut) = runOne(scratch, outPath)
  if (structRunCode != 0 || structOut != "7\n") {
    eprint("classkeyword: FAIL — 'struct Point' binary ran wrong: exit=${structRunCode} out='${structOut}'\n")
    exit(1)
  }
  let structBin = readFile(outPath) catch e {
    panic("classkeyword: cannot read built binary ${outPath}: ${e.message()}")
  }

  if (classBin != structBin) {
    eprint("classkeyword: FAIL — 'class Point' and 'struct Point' built to DIFFERENT binaries " +
      "(${len(classBin)} vs ${len(structBin)} bytes) for the same -o path\n")
    exit(1)
  }

  print("PASS classkeyword: 'class' and 'struct' both compile, run correctly, and produce byte-identical binaries (${len(classBin)} bytes)\n")
}
