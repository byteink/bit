// tests/bit/benchgate/baselines.bit — the per-platform baseline tables for
// the benchmark regression gate (#3023's split of `tests/bit/benchgate.bit`,
// which crossed the 800-line limit once #2982 gave fib its own
// `cpuCeilingPct` and carried the calibration reasoning as comments).
//
// Sibling of `benchgate.bit` in the same directory module: no `import`, one
// shared scope. This file is pure data — no `import`s needed, nothing here
// calls anything outside this module — so the import-per-module trap
// (#2867's `rootabi` split hit it first: re-importing a name the module
// already imports elsewhere is `E0042 already declared in this scope`) does
// not apply here. `Baseline`, `platformName`, `baselinesMacosArm64`,
// `baselinesLinuxX64`, `baselinesLinuxArm64` and `baselinesFor` moved here
// VERBATIM from the original file, every per-case measurement and
// calibration comment intact.

struct Baseline {
  name: string,
  expected: string,
  cpuCentis: int,
  rssBytes: int,
  // 0 means "do not set BIT_GC_MIN_KB; inherit the runtime's own default".
  // Non-zero pins the GC trigger floor explicitly for this case's run so its
  // RSS does not silently drift if a future ticket changes the default
  // (#2920 already moved it once). See the "churn" case below (#2978).
  gcMinKb: int,
  // CPU ceiling as a percentage of cpuCentis (150 = 1.5x, the file's blanket
  // default -- see ceiling() above). RSS always uses the blanket 1.5x
  // regardless of this field; only CPU reads it, via cpuCeiling(). fib
  // overrides this to 190 (#2982) -- see its baseline-table comment.
  cpuCeilingPct: int,
}

// Baselines are per-platform (#2933): a Skylake-class x86_64-linux box is
// nowhere near an Apple Silicon Mac's per-instruction throughput, and using
// one table for both turned every real-Linux run of this gate into a false
// positive. Keyed on `hostTarget()`'s ordinal — BOTH platform and
// architecture, never `uname -s` alone — because scripts/arm64gate.sh runs
// this gate on aarch64-linux, whose numbers are nothing like x86_64-linux's;
// a table keyed on "linux" would compare aarch64 against an x86_64 baseline
// and produce a confidently wrong verdict. See hostTriple() in
// tests/bit/pathresolve.bit for the same ordinal spelled as a triple.
fn platformName(target: int): string {
  if (target == 0) {
    return "linux/x86_64"
  }
  if (target == 1) {
    return "linux/aarch64"
  }
  if (target == 2) {
    return "macos/aarch64"
  }
  return "unknown hostTarget() ordinal ${target}"
}

// Measured fresh on `main` @ 368d654a (2026-08-12, after #2920 and #2921 both
// landed), minimum of 7 runs each via `/usr/bin/time -l` on an idle host —
// NOT read from bench/history.csv (see the file header for why). Re-measure
// rather than hand-edit these if they drift:
//   BIT_STDLIB=stdlib ./bit-out/bin/bit build bench/cases/<name>/<name>.bit -o /tmp/b
//   /usr/bin/time -l /tmp/b   # repeat a few times; take the minimum `user` and RSS
fn baselinesMacosArm64(): []Baseline {
  return [
    Baseline{
      name: "collatz",
      expected: "524",
      cpuCentis: 83,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    Baseline{
      name: "mandelbrot",
      expected: "204866964",
      cpuCentis: 121,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2982: fib's baseline (29cs) is too small in absolute terms for the
    // blanket 1.5x ceiling (43cs) to absorb real scheduling noise -- it was
    // the reliable false-positive repro (FAIL at 45/54/47cs against 43cs).
    //
    // WHICH DATASET CALIBRATES THIS, AND WHY. `test-benchgate` is registered
    // only as a `Gate{}` (this file's own registration in
    // tools/build/gates.bit), reachable from `./make test` — it has no entry
    // in any `scripts/gate.sh` bucket (verified: neither `bench` nor
    // `benchgate` appears in that script except in the unrelated bench/*.md
    // doc-only carve-out). So its real deployment is a single unshared
    // full-suite run, per this repo's own rule that the full suite runs once
    // per push with the box to itself -- NOT the heavy concurrent-agent
    // scenario this ticket was first (wrongly) calibrated against. Load
    // average 30-44 readings taken under 3 concurrent make-driver builds are
    // real but unrepresentative of how this gate actually runs; they are
    // recorded on #3017 instead (along with the sharper, genuinely new
    // finding that user CPU itself, not just wall clock, is measurably noisy
    // at that intensity -- a limit on the load-insensitivity the file header
    // claims for this metric, but one that does not affect this gate in its
    // designed environment).
    //
    // The relevant dataset is 16 consecutive `./make test-benchgate` runs at
    // load average 5.1-10.8 (1-3 sibling make-driver builds; the ticket's own
    // "at least 2 concurrent make-driver builds" scenario): fib's minCpu
    // ranged 31-43cs (1.07-1.48x baseline), sitting AT the old 43cs ceiling
    // once -- one scheduling hiccup from red. The same session also caught a
    // real FAIL on alloc (347cs against its own untouched 346cs ceiling);
    // alloc's ceiling is intentionally not touched here (see #3017).
    //
    // BASELINE, re-checked directly rather than inferred from the ticket's
    // 31-32cs benchgate-mediated "quiet" readings (which were themselves
    // taken under load 5-10, not truly idle): `BIT_STDLIB=stdlib
    // ./bit-out/bin/bit build bench/cases/fib/fib.bit -o /tmp/b`, then 7
    // direct `/usr/bin/time -l /tmp/b` runs with zero concurrent make-driver
    // builds (load average ~5, background-agent noise only) read 29/29/29/
    // 30/30/30/31cs -- minimum 29cs, exactly matching the recorded baseline.
    // 29cs is confirmed correct; this is a ceiling fix, not a re-baseline.
    //
    // THE CEILING: cpuCeilingPct raises fib's CPU ceiling from 150 (1.5x =
    // 43cs) to 190 (1.9x = 55cs on macOS/arm64), clearing the worst reading
    // in the representative dataset (43cs) by 12cs/28% margin, while sitting
    // 3cs below an exact 2x regression (58cs) so a genuine doubling clears
    // the ceiling with room rather than landing on the boundary.
    // Mutation-tested at load average 8.8-13.6 (2-3 sibling make-driver
    // builds, matching the representative dataset above): temporarily made
    // bench/cases/fib/fib.bit's `main` call `fib(40)` twice (exactly 2x the
    // compute, output unchanged) -- measured 89cs, FAILed against the 55cs
    // ceiling with a 34cs margin. Reverted (confirmed byte-identical via
    // `git diff --stat`) and re-ran at the same load: 33cs, PASS. fib.bit
    // itself is unchanged in this commit. Re-baselining fib's workload
    // upward (bench/cases/fib/fib.bit, e.g. fib(41) or higher) was
    // considered and rejected: it would change the case's `expected` output
    // on every platform, invalidating baselinesLinuxX64's fib entry (real
    // hardware, hl-master, not reachable from this session to re-measure).
    Baseline{
      name: "fib",
      expected: "102334155",
      cpuCentis: 29,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 190,
    },
    Baseline{
      name: "alloc",
      expected: "59995000000",
      cpuCentis: 231,
      rssBytes: 10698752,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2978. Regression guard for the GC address->object index leak
    // (#2756/#2922, fixed 32a4888d): bench/cases/churn/churn.bit holds a live
    // set of exactly ONE object across 4,000,000 allocations, which is the
    // shape that drove runtime/gc/gcindex.bit's idxGrow to abandon the whole
    // rehashed table into the bump-only gcIdxRes reserve after every sweep.
    // BIT_GC_MIN_KB is pinned to 64 (not inherited) so this case's RSS cannot
    // silently drift if a future ticket changes the runtime default (#2920
    // already moved it once) -- see gcMinKb's field comment above.
    //
    // RSS baseline measured fresh on main @ 0ebcd2a5 (2026-08-13): 1982464
    // bytes in 17 of 18 direct /usr/bin/time -l runs, all taken while 2-3
    // other agents' make-driver builds ran concurrently (load average
    // 8.8-15.9 on an 18-core host); the one outlier read 2048000 (+3.3%).
    // That confirms peak RSS here is load-insensitive to the precision this
    // file's header claims -- a single-digit-percent blip, not jitter that
    // could plausibly approach a 1.5x ceiling.
    //
    // User CPU did NOT hold as steady: the same 18 runs ranged 49-120
    // centiseconds depending on which other builds were mid-selfhost at the
    // same moment, wider than the "0.06s across 7 runs" this file's header
    // reports for the original 4 cases on a quiet host -- this dev box was
    // never quiet this session. Rather than record the rare-best-case
    // minimum and risk a flaky red on an ordinary contended run (a min-of-3
    // during the ACTUAL gate hit 73cs against a 73cs ceiling at baseline 49 --
    // verified too close), the baseline below is the highest of the 18
    // direct samples, so CPU is a slack secondary check here and RSS carries
    // this case's regression detection, consistent with peak RSS -- not CPU
    // or wall clock -- being the property this specific defect ever affected
    // (collections/swept were IDENTICAL between fixed and reverted builds;
    // see below).
    //
    // THE CEILING, stated: ceiling() below applies this file's blanket 1.5x
    // to every case. For RSS that is 1982464 * 3 / 2 = 2973696 bytes.
    // Reverting #2922's fix (32a4888d) and rebuilding reproduces 85934080
    // bytes (81.95 MB) -- 43.3x this baseline, 28.9x past the ceiling -- so a
    // real regression of this shape trips immediately with room to spare,
    // while the largest RSS blip observed under real contention (2048000,
    // 1.03x baseline) is nowhere near tripping it. collections/swept were
    // identical between the fixed and reverted builds in the mutation test
    // (2925 collections, ~3999983 swept either way), matching #2756's
    // "collected but never returned" finding, not a marking regression --
    // the leaked bytes were never live, so this is a pure RSS signature.
    Baseline{
      name: "churn",
      expected: "7999998000000",
      cpuCentis: 120,
      rssBytes: 1982464,
      gcMinKb: 64,
      cpuCeilingPct: 150,
    },
  ]
}

// Measured on real x86_64-linux hardware (hl-master, i7-6700@3.4GHz, 6
// vCPUs) by #2932 via `X64GATE_HOST=hl-master STEP=test-benchgate
// scripts/x64gate.sh`, taking the minimum of two independent cold-build runs
// ~10 minutes apart (#2933) — the same "minimum cannot be inflated by noise"
// reasoning the file header gives for `reps`:
//   run 1: collatz 328cs/233472B, mandelbrot 569cs/233472B, fib 101cs/229376B, alloc 1144cs/8818688B
//   run 2: collatz 327cs/229376B, mandelbrot 559cs/229376B, fib 101cs/225280B, alloc 1153cs/8749056B
// The ratio to the macOS/arm64 table above is NOT constant across cases
// (3.5x on fib, 3.9x collatz, 4.6x mandelbrot, 5.0x alloc) — a pure
// host-speed difference would be roughly constant, so part of the gap is
// x86_64 codegen quality, not clock speed alone (filed separately, not
// chased here: #2926 landed the x64 backend's first back-edge safepoint
// guard the same day these numbers were measured). RSS on this host is
// LOWER than macOS/arm64 (Linux's /proc VmHWM accounting differs from
// macOS's `/usr/bin/time -l`), well under its own ceiling.
fn baselinesLinuxX64(): []Baseline {
  return [
    Baseline{
      name: "collatz",
      expected: "524",
      cpuCentis: 327,
      rssBytes: 229376,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    Baseline{
      name: "mandelbrot",
      expected: "204866964",
      cpuCentis: 559,
      rssBytes: 229376,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2982's fib fix does NOT transfer here -- deliberately left at the
    // blanket 150 (1.5x). The defect on macOS/arm64 is an ABSOLUTE-headroom
    // problem: baseline 29cs, 1.5x ceiling 43cs, only 14cs of absolute
    // headroom for scheduling noise that is itself roughly fixed in
    // centiseconds, not proportional to the baseline -- that 14cs is what
    // real contention filled. hl-master's fib baseline is 101cs (3.5x
    // larger), so 1.5x already gives 151cs, i.e. 51cs of absolute headroom
    // -- 3.5x the margin that broke on macOS/arm64. Raising this to 190
    // would buy nothing against a mechanism this baseline is not exposed to,
    // while costing real detection power: it would move the ceiling from
    // 151cs to 191cs against a 2x regression at 202cs, shrinking the margin
    // from 51cs to 11cs -- reintroducing the thin-boundary problem #2982
    // fixed on macOS/arm64, on the one platform with no direct load
    // measurement to justify it. If a false positive is ever observed on
    // hl-master, that needs its own ticket with fresh measurements from that
    // hardware, not a number inferred from this box.
    Baseline{
      name: "fib",
      expected: "102334155",
      cpuCentis: 101,
      rssBytes: 225280,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    Baseline{
      name: "alloc",
      expected: "59995000000",
      cpuCentis: 1144,
      rssBytes: 8749056,
      gcMinKb: 0,
      cpuCeilingPct: 150,
    },
    // #2978's churn case has NOT been measured on this platform (no Linux
    // host in this session) -- omitted rather than guessed, matching
    // baselinesLinuxArm64's precedent below. baselinesFor's per-platform
    // table length means this is safe: main()'s completion check compares
    // against len(table), not a hardcoded case count.
  ]
}

// linux/aarch64 (scripts/arm64gate.sh) has never been measured on a quiet
// host — #2932 correctly skipped it because this Mac had three concurrent
// builds running at the time (#2933). Returning an empty table here, rather
// than a guess or a borrowed platform's numbers, is what makes
// `baselinesFor` below fail loudly instead of comparing the wrong pair.
fn baselinesLinuxArm64(): []Baseline {
  return []
}

// Selects the baseline table for the host this gate is actually running on.
fn baselinesFor(target: int): []Baseline {
  if (target == 0) {
    return baselinesLinuxX64()
  }
  if (target == 1) {
    return baselinesLinuxArm64()
  }
  if (target == 2) {
    return baselinesMacosArm64()
  }
  return []
}
