// tests/bit/benchgate/baselines.bit — the per-platform baseline tables for
// the benchmark regression gate (#3023's split of `tests/bit/benchgate.bit`,
// which crossed the 800-line limit once #2982 gave fib its own
// `cpuCeilingPct` and carried the calibration reasoning as comments).
//
// Sibling of `benchgate.bit` in the same directory module: no `import`, one
// shared scope. This file is pure data — no `import`s needed, nothing here
// calls anything outside this module — so the import-per-module trap
// (#2867's `rootabi` split hit it first: re-importing a name the module
// already imports elsewhere is `E0042 already declared in this scope`) does
// not apply here. `Baseline`, `platformName`, `baselinesMacosArm64`,
// `baselinesLinuxX64`, `baselinesLinuxArm64` and `baselinesFor` moved here
// VERBATIM from the original file, every per-case measurement and
// calibration comment intact.

struct Baseline {
  name: string,
  expected: string,
  cpuCentis: int,
  rssBytes: int,
  // 0 means "do not set BIT_GC_MIN_KB; inherit the runtime's own default".
  // Non-zero pins the GC trigger floor explicitly for this case's run so its
  // RSS does not silently drift if a future ticket changes the default
  // (#2920 already moved it once). See the "churn" case below (#2978).
  gcMinKb: int,
  // CPU ceiling as a percentage of cpuCentis (150 = 1.5x, the file's blanket
  // default -- see ceiling() above). RSS always uses the blanket 1.5x
  // regardless of this field; only CPU reads it, via cpuCeiling(). fib
  // overrides this to 190 (#2982) -- see its baseline-table comment.
  cpuCeilingPct: int,
  // Allocated object count baseline: `swept+live` from one `BIT_GC_STATS=1`
  // run (#3130). Unlike cpuCentis/rssBytes this is EXACTLY deterministic --
  // the same binary reports the identical count on every run, verified 5x on
  // every macOS/arm64 case below (readings pasted in #3130's ticket comment)
  // -- so its guard is TWO-SIDED via objCeiling()/objFloor() in
  // benchgate.bit, at a blanket [0.5x, 1.05x] band (objFloorPct/objCeilPct):
  // it fails on a regression (more objects than recorded) AND on an
  // unrecorded improvement (fewer objects than recorded), forcing a
  // re-baseline rather than letting a win silently protect nothing. -1 means
  // "not measured on this platform" -- the band check is skipped for that
  // case (see runCase), but the BIT_GC_STATS line itself is still required
  // unconditionally on every platform; a missing or malformed line is always
  // a hard fail regardless of this field's value.
  objects: int,
}

// Baselines are per-platform (#2933): a Skylake-class x86_64-linux box is
// nowhere near an Apple Silicon Mac's per-instruction throughput, and using
// one table for both turned every real-Linux run of this gate into a false
// positive. Keyed on `hostTarget()`'s ordinal — BOTH platform and
// architecture, never `uname -s` alone — because scripts/arm64gate.sh runs
// this gate on aarch64-linux, whose numbers are nothing like x86_64-linux's;
// a table keyed on "linux" would compare aarch64 against an x86_64 baseline
// and produce a confidently wrong verdict. See hostTriple() in
// tests/bit/pathresolve.bit for the same ordinal spelled as a triple.
fn platformName(target: int): string {
  if (target == 0) {
    return "linux/x86_64"
  }
  if (target == 1) {
    return "linux/aarch64"
  }
  if (target == 2) {
    return "macos/aarch64"
  }
  return "unknown hostTarget() ordinal ${target}"
}

// Measured fresh on `main` @ 368d654a (2026-08-12, after #2920 and #2921 both
// landed), minimum of 7 runs each via `/usr/bin/time -l` on an idle host —
// NOT read from bench/history.csv (see the file header for why). Re-measure
// rather than hand-edit these if they drift:
//   BIT_STDLIB=stdlib ./bit-out/bin/bit build bench/cases/<name>/<name>.bit -o /tmp/b
//   /usr/bin/time -l /tmp/b   # repeat a few times; take the minimum `user` and RSS
fn baselinesMacosArm64(): []Baseline {
  return [
    // objects (#3130): 5 on collatz, mandelbrot AND fib -- all three are
    // pure-int compute with no case-specific heap allocation, so the count is
    // boot-path overhead only (see baselinesMacosArm64's own header for the
    // determinism verification method and #3130's ticket comment for the
    // 5-run readings).
    Baseline{
      name: "collatz",
      expected: "524",
      cpuCentis: 83,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: 5,
    },
    Baseline{
      name: "mandelbrot",
      expected: "204866964",
      cpuCentis: 121,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: 5,
    },
    // #2982: fib's baseline (29cs) is too small in absolute terms for the
    // blanket 1.5x ceiling (43cs) to absorb real scheduling noise -- it was
    // the reliable false-positive repro (FAIL at 45/54/47cs against 43cs).
    //
    // WHICH DATASET CALIBRATES THIS, AND WHY. `test-benchgate` is registered
    // only as a `Gate{}` (this file's own registration in
    // tools/build/gates.bit), reachable from `./make test` — it has no entry
    // in any `scripts/gate.sh` bucket (verified: neither `bench` nor
    // `benchgate` appears in that script except in the unrelated bench/*.md
    // doc-only carve-out). So its real deployment is a single unshared
    // full-suite run, per this repo's own rule that the full suite runs once
    // per push with the box to itself -- NOT the heavy concurrent-agent
    // scenario this ticket was first (wrongly) calibrated against. Load
    // average 30-44 readings taken under 3 concurrent make-driver builds are
    // real but unrepresentative of how this gate actually runs; they are
    // recorded on #3017 instead (along with the sharper, genuinely new
    // finding that user CPU itself, not just wall clock, is measurably noisy
    // at that intensity -- a limit on the load-insensitivity the file header
    // claims for this metric, but one that does not affect this gate in its
    // designed environment).
    //
    // The relevant dataset is 16 consecutive `./make test-benchgate` runs at
    // load average 5.1-10.8 (1-3 sibling make-driver builds; the ticket's own
    // "at least 2 concurrent make-driver builds" scenario): fib's minCpu
    // ranged 31-43cs (1.07-1.48x baseline), sitting AT the old 43cs ceiling
    // once -- one scheduling hiccup from red. The same session also caught a
    // real FAIL on alloc (347cs against its own untouched 346cs ceiling);
    // alloc's ceiling is intentionally not touched here (see #3017).
    //
    // BASELINE, re-checked directly rather than inferred from the ticket's
    // 31-32cs benchgate-mediated "quiet" readings (which were themselves
    // taken under load 5-10, not truly idle): `BIT_STDLIB=stdlib
    // ./bit-out/bin/bit build bench/cases/fib/fib.bit -o /tmp/b`, then 7
    // direct `/usr/bin/time -l /tmp/b` runs with zero concurrent make-driver
    // builds (load average ~5, background-agent noise only) read 29/29/29/
    // 30/30/30/31cs -- minimum 29cs, exactly matching the recorded baseline.
    // 29cs is confirmed correct; this is a ceiling fix, not a re-baseline.
    //
    // THE CEILING: cpuCeilingPct raises fib's CPU ceiling from 150 (1.5x =
    // 43cs) to 190 (1.9x = 55cs on macOS/arm64), clearing the worst reading
    // in the representative dataset (43cs) by 12cs/28% margin, while sitting
    // 3cs below an exact 2x regression (58cs) so a genuine doubling clears
    // the ceiling with room rather than landing on the boundary.
    // Mutation-tested at load average 8.8-13.6 (2-3 sibling make-driver
    // builds, matching the representative dataset above): temporarily made
    // bench/cases/fib/fib.bit's `main` call `fib(40)` twice (exactly 2x the
    // compute, output unchanged) -- measured 89cs, FAILed against the 55cs
    // ceiling with a 34cs margin. Reverted (confirmed byte-identical via
    // `git diff --stat`) and re-ran at the same load: 33cs, PASS. fib.bit
    // itself is unchanged in this commit. Re-baselining fib's workload
    // upward (bench/cases/fib/fib.bit, e.g. fib(41) or higher) was
    // considered and rejected: it would change the case's `expected` output
    // on every platform, invalidating baselinesLinuxX64's fib entry (real
    // hardware, hl-master, not reachable from this session to re-measure).
    Baseline{
      name: "fib",
      expected: "102334155",
      cpuCentis: 29,
      rssBytes: 1949696,
      gcMinKb: 0,
      cpuCeilingPct: 190,
      objects: 5,
    },
    // objects (#3130): 10030005 = swept 9979876 + live 50129, identical
    // across 5 direct runs (see #3130's ticket comment).
    Baseline{
      name: "alloc",
      expected: "59995000000",
      cpuCentis: 231,
      rssBytes: 10698752,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: 10030005,
    },
    // #2978. Regression guard for the GC address->object index leak
    // (#2756/#2922, fixed 32a4888d): bench/cases/churn/churn.bit holds a live
    // set of exactly ONE object across 4,000,000 allocations, which is the
    // shape that drove runtime/gc/gcindex.bit's idxGrow to abandon the whole
    // rehashed table into the bump-only gcIdxRes reserve after every sweep.
    // BIT_GC_MIN_KB is pinned to 64 (not inherited) so this case's RSS cannot
    // silently drift if a future ticket changes the runtime default (#2920
    // already moved it once) -- see gcMinKb's field comment above.
    //
    // RSS baseline measured fresh on main @ 0ebcd2a5 (2026-08-13): 1982464
    // bytes in 17 of 18 direct /usr/bin/time -l runs, all taken while 2-3
    // other agents' make-driver builds ran concurrently (load average
    // 8.8-15.9 on an 18-core host); the one outlier read 2048000 (+3.3%).
    // That confirms peak RSS here is load-insensitive to the precision this
    // file's header claims -- a single-digit-percent blip, not jitter that
    // could plausibly approach a 1.5x ceiling.
    //
    // User CPU did NOT hold as steady: the same 18 runs ranged 49-120
    // centiseconds depending on which other builds were mid-selfhost at the
    // same moment, wider than the "0.06s across 7 runs" this file's header
    // reports for the original 4 cases on a quiet host -- this dev box was
    // never quiet this session. Rather than record the rare-best-case
    // minimum and risk a flaky red on an ordinary contended run (a min-of-3
    // during the ACTUAL gate hit 73cs against a 73cs ceiling at baseline 49 --
    // verified too close), the baseline below is the highest of the 18
    // direct samples, so CPU is a slack secondary check here and RSS carries
    // this case's regression detection, consistent with peak RSS -- not CPU
    // or wall clock -- being the property this specific defect ever affected
    // (collections/swept were IDENTICAL between fixed and reverted builds;
    // see below).
    //
    // THE CEILING, stated: ceiling() below applies this file's blanket 1.5x
    // to every case. For RSS that is 1982464 * 3 / 2 = 2973696 bytes.
    // Reverting #2922's fix (32a4888d) and rebuilding reproduces 85934080
    // bytes (81.95 MB) -- 43.3x this baseline, 28.9x past the ceiling -- so a
    // real regression of this shape trips immediately with room to spare,
    // while the largest RSS blip observed under real contention (2048000,
    // 1.03x baseline) is nowhere near tripping it. collections/swept were
    // identical between the fixed and reverted builds in the mutation test
    // (2925 collections, ~3999983 swept either way), matching #2756's
    // "collected but never returned" finding, not a marking regression --
    // the leaked bytes were never live, so this is a pure RSS signature.
    // objects (#3130): 4000005, identical across 5 direct BIT_GC_MIN_KB=64
    // runs -- but swept/live INDIVIDUALLY did not hold steady run to run
    // (e.g. swept 3999867/live 138 vs swept 3998877/live 1128), only their
    // SUM did. That is the concrete case for gating on swept+live rather
    // than either field alone: which objects are swept vs still live at
    // process exit depends on exactly when the last collection landed
    // relative to the object graph, but the total this run ever allocated
    // does not.
    Baseline{
      name: "churn",
      expected: "7999998000000",
      cpuCentis: 120,
      rssBytes: 1982464,
      gcMinKb: 64,
      cpuCeilingPct: 150,
      objects: 4000005,
    },
    // --- #3129: json, map, matrix, sort, strings -------------------------
    //
    // #3097 added these five to bench/cases/ and recorded no baseline, so the
    // five WORST cases in the suite (strings 117x C, json 123x, matrix 109x,
    // sort 15.8x, map 11.3x) were the only ones under active optimization
    // with no regression guard: #2293, #3107, #3111 and #3116 all landed
    // against them on 2026-08-15 with nothing watching.
    //
    // Measured on `main` @ d4b5e88e (2026-08-15) with the method this file's
    // header prescribes -- built with the compiler under test, then 7 direct
    // `/usr/bin/time -l` runs each, minimum taken, on a host carrying one
    // sibling make-driver build (load average 3.8-4.6). The readings, as
    // "cpu centiseconds / peak RSS bytes":
    //   json    535/922615808  535/922615808  536/922615808  540/922615808
    //           541/922615808  557/922615808  518/922615808
    //   map      53/56573952    51/56573952    53/60784640    53/56573952
    //            51/56573952    52/60784640    53/56573952
    //   matrix  502/33505280   507/33505280   467/33505280   486/33505280
    //           497/33505280   503/33505280   502/33505280
    //   sort     83/48267264    82/48250880    84/48267264    83/48250880
    //            84/48250880    83/48250880    82/48250880
    //   strings 337/998424576  343/998424576  355/998424576  383/998424576
    //           395/998424576  386/998408192  365/998424576
    //
    // THE CPU BASELINES BELOW ARE LOWER THAN THAT SERIES' MINIMUM ON FOUR OF
    // THE FIVE, and deliberately so: nine further `./make test-benchgate`
    // runs (the gate's own min-of-3, load average 2.1-17.7, 0-1 sibling
    // make-driver builds) read a lower floor on json, map, matrix and
    // strings. The floor is the quantity being estimated and noise can only
    // inflate it, so the lowest observed reading wins:
    //   json    517 729 575 498 563 520 485 504 481 -> floor 481 (direct 518)
    //   map      49  96  61  54  54  53  52  55  50 -> floor  49 (direct  51)
    //   matrix  490 543 522 461 480 458 461 472 457 -> floor 457 (direct 467)
    //   sort     90  86 115  84  94  82  82  93  83 -> floor  82 (direct  82)
    //   strings 392 379 345 364 398 332 335 381 378 -> floor 332 (direct 337)
    // The last of those nine was the quietest (load 2.1) and produced the
    // lowest json and matrix readings, which is the expected shape: the floor
    // is only approached when nothing else is on the box. The remaining gap
    // is under 1% on both, far below anything either ceiling turns on.
    // RSS over those same 9 runs never once fell below the direct minimum,
    // and barely moved at all: json and matrix read ONE value in all 16 runs
    // (7 direct + 9 gate); map's gate minimum was 56573952 in all 9, the 2
    // direct runs that read 60784640 being the only +7.4% blips anywhere;
    // sort took 48267264 in 4 of 16 (+0.03%) and strings 998424576 in 8 of
    // 16 (+0.002%). Peak RSS is the load-insensitive metric this file's
    // header claims, and the RSS baselines below are consequently the strong
    // half of each case's guard; the CPU spread above is not, and it is what
    // drives the per-case ceilings recorded below.
    //
    // gcMinKb is 0 (inherit) on all five, unlike churn: BIT_GC_MIN_KB's
    // default is 4096 KiB (runtime/ABI.md:775) and the smallest peak here is
    // matrix at 32 MB, so the trigger floor is under 13% of even the smallest
    // case's RSS and cannot move these baselines the way it moves churn's
    // 1.9 MB one. Pinning it would add a knob that guards nothing. Verified
    // rather than assumed: `BIT_GC_MIN_KB=1` on the map binary read 0.57s
    // user against 0.57s at the default.
    //
    // json: CPU ceiling 175 (1.75x = 841cs), not the blanket 150 (721cs).
    // The worst of the 9 gate runs above is 729cs -- 1.50x the floor, i.e. a
    // reading that would have gone RED at 150 with the code unchanged, and it
    // did not come from a small-baseline effect (json's floor is 481cs, 16x
    // fib's). The mechanism is this case's concurrent collector: `user`
    // EXCEEDS `real` here (4.45s real against 5.99s user on one direct run),
    // so user CPU sums the mutator and the collector thread, and contention
    // buys the collector more spinning, not less work. 841 clears 729 by
    // 112cs (15%) while a genuine 2x regression (962cs) still trips it by
    // 121cs -- the same both-sided trade #2982 made for fib.
    // objects (#3130): 10200067 = swept 2550040 + live 7650027, identical
    // across 5 direct runs (see #3130's ticket comment) -- and matches
    // #2293's own measured before/after (15,450,097 -> 10,200,067) exactly.
    Baseline{
      name: "json",
      expected: "11249925000 2099959 75000 1388890",
      cpuCentis: 481,
      rssBytes: 922615808,
      gcMinKb: 0,
      cpuCeilingPct: 175,
      objects: 10200067,
    },
    // map: CPU ceiling 250 (2.5x = 122cs). This is the largest override in
    // the file and the reason is measured, not assumed -- `./make
    // test-benchgate` FAILED on this case with the code unchanged while this
    // table was being calibrated:
    //   FAIL benchgate: map user CPU regressed: 96cs (min of 3),
    //     baseline 51cs, ceiling 76cs (150%)
    // at load average 17.7. That is #2982's fib defect exactly: 49cs of
    // absolute baseline leaves 24cs of headroom under a 1.5x ceiling, and
    // scheduling noise on this host is roughly fixed in centiseconds rather
    // than proportional, so it fills that headroom. The other 8 gate runs
    // read 49-61cs.
    //
    // WHAT THIS COSTS, STATED PLAINLY: at 122cs, map's CPU check can no
    // longer see a 2x regression (98cs) -- it catches 2.5x and worse. No
    // ceiling can do better here, because a doubling of this case's cost is
    // literally smaller than the noise already observed on the unchanged
    // binary. Fine-grained detection for map is carried by RSS, which is the
    // load-insensitive metric: 56573952B in every one of the 9 gate runs
    // above, against a 1.5x ceiling of 84860928B. Mutation-tested
    // rather than argued (#3129): a 3x-compute map, output byte-identical,
    // measured 155cs and FAILED against this 122cs ceiling. The honest way to
    // narrow this is to make the case itself bigger, which changes `expected`
    // on every platform including baselinesLinuxX64 -- rejected here for the
    // same reason #2982 rejected re-baselining fib's workload.
    // objects (#3130): 72 = swept 56 + live 16, identical across 5 direct
    // runs (see #3130's ticket comment).
    Baseline{
      name: "map",
      expected: "7874994750000 1125000 5906250000000 1125000",
      cpuCentis: 49,
      rssBytes: 56573952,
      gcMinKb: 0,
      cpuCeilingPct: 250,
      objects: 72,
    },
    // matrix keeps the blanket 150 (685cs): the worst of the 9 gate runs is
    // 543cs, 1.19x the floor, leaving 142cs (26%) of margin. This case is
    // compute-bound with a 33 MB live set (`user` 5.30s against `real` 5.31s
    // -- no second thread accruing CPU, unlike json and strings), which is
    // why it is the steadiest of the five despite being the second most
    // expensive. It is also the case #3107 optimized today (inner loop 333 ->
    // 79 instructions), so a tight ceiling here is worth keeping.
    // objects (#3130): 50 = swept 26 + live 24, identical across 5 direct
    // runs (see #3130's ticket comment).
    Baseline{
      name: "matrix",
      expected: "38654738429 75498279 24453 24856",
      cpuCentis: 457,
      rssBytes: 33505280,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: 50,
    },
    // sort: CPU ceiling 180 (1.8x = 147cs), not 150 (123cs). Worst of the 9
    // gate runs is 115cs, 1.40x the floor -- 8cs under a 150 ceiling, which
    // is one scheduling hiccup from red and is the same "sitting AT the
    // ceiling once" state #2982 refused to ship for fib. 82cs of baseline is
    // small enough for the absolute-headroom mechanism to bite (41cs at 150,
    // against the 14cs that broke fib). 147 clears the worst reading by 32cs
    // (28%, matching the margin #2982 accepted) and still trips a 2x
    // regression (164cs) by 17cs -- a wider both-sided margin than fib's own
    // 190, which sits only 3cs under its 2x point.
    // objects (#3130): 2200045, identical across 5 direct runs -- but, like
    // churn above, swept/live individually varied between runs (e.g. swept
    // 1816690/live 383355 vs swept 1816686/live 383359) while their sum did
    // not (see #3130's ticket comment for all 5 readings).
    Baseline{
      name: "sort",
      expected: "29402557 true 781018614 true",
      cpuCentis: 82,
      rssBytes: 48250880,
      gcMinKb: 0,
      cpuCeilingPct: 180,
      objects: 2200045,
    },
    // strings keeps the blanket 150 (498cs): worst of the 9 gate runs is
    // 398cs, 1.20x the floor, 100cs (25%) of margin. It shares json's
    // concurrent-collector shape (`user` 4.23s against `real` 3.16s) and is
    // measurably noisier than matrix because of it, but its floor is high
    // enough in absolute terms that 1.5x still absorbs the spread. This is
    // the suite's worst case against C (117x) and #2293's target, so it keeps
    // the strictest bar the data supports.
    // objects (#3130): 7125042 = swept 6682506 + live 442536, identical
    // across 5 direct runs (see #3130's ticket comment).
    Baseline{
      name: "strings",
      expected: "28500007 0 10000",
      cpuCentis: 332,
      rssBytes: 998408192,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: 7125042,
    },
  ]
}

// Measured on real x86_64-linux hardware (hl-master, i7-6700@3.4GHz, 6
// vCPUs) by #2932 via `X64GATE_HOST=hl-master STEP=test-benchgate
// scripts/x64gate.sh`, taking the minimum of two independent cold-build runs
// ~10 minutes apart (#2933) — the same "minimum cannot be inflated by noise"
// reasoning the file header gives for `reps`:
//   run 1: collatz 328cs/233472B, mandelbrot 569cs/233472B, fib 101cs/229376B, alloc 1144cs/8818688B
//   run 2: collatz 327cs/229376B, mandelbrot 559cs/229376B, fib 101cs/225280B, alloc 1153cs/8749056B
// The ratio to the macOS/arm64 table above is NOT constant across cases
// (3.5x on fib, 3.9x collatz, 4.6x mandelbrot, 5.0x alloc) — a pure
// host-speed difference would be roughly constant, so part of the gap is
// x86_64 codegen quality, not clock speed alone (filed separately, not
// chased here: #2926 landed the x64 backend's first back-edge safepoint
// guard the same day these numbers were measured). RSS on this host is
// LOWER than macOS/arm64 (Linux's /proc VmHWM accounting differs from
// macOS's `/usr/bin/time -l`), well under its own ceiling.
// objects (#3130) is -1 ("not measured on this platform") on every entry in
// this table: no Linux host reachable this session, same constraint #2932
// already recorded for the CPU/RSS numbers above. The band check in
// benchgate.bit's runCase skips a -1 baseline; the BIT_GC_STATS line is
// still required unconditionally regardless. Object counts should in
// principle be host-architecture-independent (they are a property of the
// source program's control flow and the runtime's allocator policy, not of
// clock speed or codegen) -- but "should in principle" is exactly the kind
// of unverified claim this repo's own rules say not to record as a number;
// leave -1 until someone measures it on real Linux hardware.
fn baselinesLinuxX64(): []Baseline {
  return [
    Baseline{
      name: "collatz",
      expected: "524",
      cpuCentis: 327,
      rssBytes: 229376,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: -1,
    },
    Baseline{
      name: "mandelbrot",
      expected: "204866964",
      cpuCentis: 559,
      rssBytes: 229376,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: -1,
    },
    // #2982's fib fix does NOT transfer here -- deliberately left at the
    // blanket 150 (1.5x). The defect on macOS/arm64 is an ABSOLUTE-headroom
    // problem: baseline 29cs, 1.5x ceiling 43cs, only 14cs of absolute
    // headroom for scheduling noise that is itself roughly fixed in
    // centiseconds, not proportional to the baseline -- that 14cs is what
    // real contention filled. hl-master's fib baseline is 101cs (3.5x
    // larger), so 1.5x already gives 151cs, i.e. 51cs of absolute headroom
    // -- 3.5x the margin that broke on macOS/arm64. Raising this to 190
    // would buy nothing against a mechanism this baseline is not exposed to,
    // while costing real detection power: it would move the ceiling from
    // 151cs to 191cs against a 2x regression at 202cs, shrinking the margin
    // from 51cs to 11cs -- reintroducing the thin-boundary problem #2982
    // fixed on macOS/arm64, on the one platform with no direct load
    // measurement to justify it. If a false positive is ever observed on
    // hl-master, that needs its own ticket with fresh measurements from that
    // hardware, not a number inferred from this box.
    Baseline{
      name: "fib",
      expected: "102334155",
      cpuCentis: 101,
      rssBytes: 225280,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: -1,
    },
    Baseline{
      name: "alloc",
      expected: "59995000000",
      cpuCentis: 1144,
      rssBytes: 8749056,
      gcMinKb: 0,
      cpuCeilingPct: 150,
      objects: -1,
    },
    // #2978's churn case has NOT been measured on this platform (no Linux
    // host in this session) -- omitted rather than guessed, matching
    // baselinesLinuxArm64's precedent below. baselinesFor's per-platform
    // table length means this is safe: main()'s completion check compares
    // against len(table), not a hardcoded case count.
  ]
}

// linux/aarch64 (scripts/arm64gate.sh) has never been measured on a quiet
// host — #2932 correctly skipped it because this Mac had three concurrent
// builds running at the time (#2933). Returning an empty table here, rather
// than a guess or a borrowed platform's numbers, is what makes
// `baselinesFor` below fail loudly instead of comparing the wrong pair.
fn baselinesLinuxArm64(): []Baseline {
  return []
}

// Selects the baseline table for the host this gate is actually running on.
fn baselinesFor(target: int): []Baseline {
  if (target == 0) {
    return baselinesLinuxX64()
  }
  if (target == 1) {
    return baselinesLinuxArm64()
  }
  if (target == 2) {
    return baselinesMacosArm64()
  }
  return []
}
