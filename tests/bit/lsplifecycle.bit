// `bit lsp` lifecycle gate (#2332): drives the REAL self-hosted `bit lsp`
// binary as a subprocess over a batch-framed stdio transcript and asserts on
// its exit code and its raw JSON-RPC output — the two things that were wrong:
//
//   1. the process never terminated on the `exit` notification (only on
//      stdin EOF), so this gate proves BOTH the notification path AND that
//      its exit code reports whether `shutdown` preceded it (0) or not (1);
//   2. a request received after `shutdown` was served normally instead of
//      erroring InvalidRequest.
//
// SUBPROCESS MECHANICS mirror tests/bit/golden.bit and tests/bit/rootabi.bit:
// `osRunBounded(path, timeoutMs)` takes a bare path with no argv/env/stdio
// hookup, so each case is a generated `/bin/sh` wrapper that redirects a
// pre-built JSON-RPC payload file to stdin and both output streams to files
// this process reads back, then `exec`s the real `bit lsp` so a crash stays
// distinguishable from an ordinary exit (ABI.md §19). The whole payload is
// written before the process starts (never a live back-and-forth) because
// `exit`'s own effect — the process terminating on its own, before stdin
// closes — is exactly what distinguishes it from the pre-existing stdin-EOF
// path; a batch run can still observe the CODE that decision produces.
//
// NOT WIRED INTO `./make test` YET: adding a named step needs an entry in
// tools/build/gates.bit, outside this change's file fence (compiler/lsp*.bit,
// tests/**, docs/**). Filed as its own follow-up so this gate does not sit
// silently unrun.

import { envOr, exit } from "std/os"
import { readFile, writeFile, remove, mkdir, exists } from "std/fs"

const timeoutMs: int = 20000

fn failCase(msg: string) {
  eprint("FAIL lsplifecycle: " + msg + "\n")
  exit(1)
}

// Wraps `s` as exactly one POSIX `/bin/sh` word.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// The `Content-Length: N\r\n\r\n<body>` wire form of `body` — same framing
// `bit lsp` itself writes (compiler/lspserver.bit's `lspFrame`).
fn frame(body: string): string {
  return "Content-Length: ${len(body)}\r\n\r\n" + body
}

// Runs `bin lsp` with `payload` fed on stdin, both streams captured to files
// under `scratch`. Returns (exit code, stdout, ok); ok is false only when the
// wrapper itself could not be prepared or the child never ran at all — a
// distinct failure from "ran and exited nonzero".
fn runLsp(bin: string, scratch: string, payload: string): (int, string, bool) {
  mkdirQuiet(scratch)
  let inPath = scratch + "/in"
  let outPath = scratch + "/out"
  let errPath = scratch + "/err"
  let shPath = scratch + "/w.sh"
  writeFile(inPath, payload) catch e {
    failCase("cannot write input payload: " + e.message())
    return 0, "", false
  }
  let script = "#!/bin/sh\nexec " + shQuote(bin) + " lsp < " + shQuote(inPath) +
    " > " + shQuote(outPath) + " 2> " + shQuote(errPath) + "\n"
  writeFile(shPath, script) catch e {
    failCase("cannot write wrapper script: " + e.message())
    return 0, "", false
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    failCase("cannot chmod wrapper script")
    return 0, "", false
  }
  let code = osRunBounded(shPath, timeoutMs)
  if (code == 0 - 2) {
    failCase("TIMED OUT after ${timeoutMs}ms (raise BIT_TEST_TIMEOUT_S)")
    return 0, "", false
  }
  if (code == 0 - 1) {
    failCase("cannot launch wrapper script (spawn/wait failure)")
    return 0, "", false
  }
  if (code <= 0 - 100) {
    failCase("CRASHED: killed by signal ${0 - code - 100}")
    return 0, "", false
  }
  let out = readFile(outPath) catch e { "" }
  return code, out, true
}

// Best-effort mkdir: scenario 3 (case 3 in `main`) already created its
// scratch directory to hold a fixture document before `runLsp` gets it.
fn mkdirQuiet(path: string) {
  mkdir(path) catch e { return }
}

fn contains(haystack: string, needle: string): bool {
  let n = len(needle)
  if (n == 0) { return true }
  let i = 0
  while (i + n <= len(haystack)) {
    if (haystack[i:i + n] == needle) { return true }
    i = i + 1
  }
  return false
}

fn main() {
  let bin = envOr("BIT", "bit-out/bin/bit")
  if (!exists(bin)) {
    failCase("BIT='${bin}' does not exist — refusing to guess")
    return
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-lsplifecycle-${timeUnixNs()}"
  mkdir(scratch) catch e {
    failCase("cannot create scratch directory ${scratch}")
    return
  }

  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let shutdownReq = frame("{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"shutdown\",\"params\":null}")
  let exitNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":null}")

  // 1. shutdown THEN exit: the process must terminate with code 0.
  let p1 = initReq + initNotif + shutdownReq + exitNotif
  let (code1, out1, ok1) = runLsp(bin, scratch + "/a", p1)
  if (ok1) {
    if (code1 != 0) {
      failCase("shutdown-then-exit: expected exit code 0, got ${code1}\n" + out1)
    } else {
      print("PASS lsplifecycle: shutdown-then-exit exits 0\n")
    }
    if (!contains(out1, "\"id\":9") || !contains(out1, "\"result\":null")) {
      failCase("shutdown-then-exit: shutdown did not reply {result:null}\n" + out1)
    } else {
      print("PASS lsplifecycle: shutdown replies result:null\n")
    }
  }

  // 2. exit WITHOUT a prior shutdown: an unclean exit, code 1.
  let p2 = initReq + initNotif + exitNotif
  let (code2, out2, ok2) = runLsp(bin, scratch + "/b", p2)
  if (ok2) {
    if (code2 != 1) {
      failCase("exit-without-shutdown: expected exit code 1, got ${code2}\n" + out2)
    } else {
      print("PASS lsplifecycle: exit-without-shutdown exits 1\n")
    }
  }

  // 3. a request AFTER shutdown errors InvalidRequest (-32600) rather than
  //    being served — id 10 is documentSymbol on a real open document, which
  //    would otherwise succeed (it is exactly what completion/hover resolve
  //    correctly through the same overlay, per #2327-#2333's own repros).
  let docPath = scratch + "/c/main.bit"
  mkdir(scratch + "/c") catch e {
    failCase("cannot create scratch subdirectory ${scratch}/c")
    return
  }
  let docText = "function main() {\n}\n"
  writeFile(docPath, docText) catch e {
    failCase("cannot write ${docPath}: " + e.message())
    return
  }
  let uri = "file://" + docPath
  let didOpen = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"function main() {\\n}\\n\"}}}")
  let docSymAfter = frame("{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"textDocument/documentSymbol\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}")
  let p3 = initReq + initNotif + didOpen + shutdownReq + docSymAfter
  let (code3, out3, ok3) = runLsp(bin, scratch + "/c", p3)
  if (ok3) {
    if (!contains(out3, "\"id\":10") || !contains(out3, "\"code\":-32600")) {
      failCase("post-shutdown request: expected id 10 to error -32600, got:\n" + out3)
    } else {
      print("PASS lsplifecycle: request after shutdown errors -32600\n")
    }
    if (contains(out3, "\"id\":10,\"result\"")) {
      failCase("post-shutdown request: id 10 was served a result instead of rejected\n" + out3)
    }
  }

  print("lsplifecycle: all scenarios passed\n")
}
