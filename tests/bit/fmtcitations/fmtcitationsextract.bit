// tests/bit/fmtcitations/fmtcitationsextract.bit — the two raw-text scans
// every check in this module runs over: extractPathTokens (path-token
// citations, e.g. "compiler/fmt.bit:78") and extractHedges (a hedged
// "~line N" or bare "(~N)" citation). Split out of fmtcitations.bit to keep
// that file under the repo's 800-line limit (E0200). Sibling in the same
// directory module, so both functions call straight into fmtcitations.bit's
// PathToken/Hedge/docLineFor/isIdentContCh/isIdentStartCh/trimWs consts and
// helpers with no import, matching the convention documented in
// docs/development.md's "Splitting a file" section and already used by
// fmtcitationsassoc.bit (#3611). Called from checkDocument in fmtcitations.bit.

// Every `<path>.bit` occurrence: find each literal ".bit", scan BACKWARD
// over identifier/slash chars for the token's start, then optionally
// forward over a `:N[-M][, N[-M]...]` spec. `requiredPrefix` (if set)
// discards a token not containing that substring. `i` only ever advances.
fn extractPathTokens(text: string, requiredPrefix: string): []PathToken {
  let out = []PathToken(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxPathTokens) {
    let relRaw = indexOf(text[i:n], bitSuffix)
    if (relRaw < 0) {
      break
    }
    let bitStart = i + int(relRaw)
    let afterBit = bitStart + len(bitSuffix)
    if (afterBit < n && isIdentContCh(text[afterBit])) {
      i = bitStart + 1
      continue
    }
    let start = bitStart
    let floor = bitStart - maxTokenLen
    if (floor < 0) {
      floor = 0
    }
    while (start > floor && (isIdentContCh(text[start - 1]) || text[start - 1] == '/')) {
      start = start - 1
    }
    if (start == bitStart) {
      i = afterBit // nothing path-like precedes ".bit" (e.g. a glob) -- not a citation
      continue
    }
    let fileName = text[start:bitStart] + bitSuffix
    if (fileName[0] == '/') {
      fileName = fileName[1:len(fileName)] // brace-expansion leftover, e.g. "/boot.bit" -- treat as its bare basename
    }
    if (len(fileName) == 0 || !isIdentStartCh(fileName[0])) {
      i = afterBit
      continue
    }
    if (len(requiredPrefix) > 0 && !contains(fileName, requiredPrefix)) {
      i = afterBit
      continue
    }
    let hasSpec = false
    let lineSpecRaw = ""
    let endOffset = afterBit
    if (afterBit < n && text[afterBit] == ':') {
      let specStart = afterBit + 1
      let q = specStart
      while (q < n && q - specStart < maxLineSpecLen && isLineSpecChar(text[q])) {
        q = q + 1
      }
      let raw = trimWs(text[specStart:q])
      if (len(raw) > 0) {
        hasSpec = true
        lineSpecRaw = raw
        endOffset = q
      }
    }
    out = append(
      out,
      PathToken{
        file: fileName, lineSpecRaw: lineSpecRaw, hasSpec: hasSpec,
        docLine: docLineFor(text, start), startOffset: start,
      },
    )
    i = endOffset
  }
  return out
}

// Every hedge: `~line N[/M][-M]` or a bare `(~N[/M][-M])` right after "(" —
// never a duration/count (`~75us`), which is why both require direct adjacency.
fn extractHedges(text: string): []Hedge {
  let out = []Hedge(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxHedges) {
    let relRaw = indexOf(text[i:n], "~")
    if (relRaw < 0) {
      break
    }
    let tildeAt = i + int(relRaw)
    let specStart = tildeAt + 1
    let viaLineWord = specStart + len(hedgeLineWord) <= n &&
      text[specStart:specStart + len(hedgeLineWord)] == hedgeLineWord
    let viaParen = tildeAt > 0 && text[tildeAt - 1] == '('
    if (!viaLineWord && !viaParen) {
      i = tildeAt + 1
      continue
    }
    if (viaLineWord) {
      specStart = specStart + len(hedgeLineWord)
    }
    let q = specStart
    while (q < n &&
      q - specStart < maxLineSpecLen &&
      ((text[q] >= '0' && text[q] <= '9') ||
        text[q] == '-' ||
        text[q] == '/' ||
        text[q] == ',' ||
        text[q] == ' ')) {
      q = q + 1
    }
    let raw = trimWs(text[specStart:q])
    if (len(raw) == 0 || !(raw[0] >= '0' && raw[0] <= '9')) {
      i = tildeAt + 1
      continue
    }
    out = append(
      out,
      Hedge{ lineSpecRaw: raw, docLine: docLineFor(text, tildeAt), startOffset: tildeAt },
    )
    i = q
  }
  return out
}
