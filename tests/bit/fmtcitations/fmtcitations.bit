// tests/bit/fmtcitations.bit — file:line citation-drift gate (#3072, #3381).
//
// Table-driven (`docRows()`): spec/FMT.md cites `compiler/fmt*.bit:NNN`,
// runtime/ABI.md cites `runtime/**/*.bit:NNN` — a third document is a table
// row, never a new script or Gate{}. #3350's sweep of ABI.md found 23 of 55
// citations wrong (44 exact `path:line`, 11 hedged `~line`); nothing had
// ever checked either.
//
// TIER 1 (every row): the cited file exists and every line number in the
// spec is within [1, its current line count]. A HEDGED citation (`~line N`
// or a bare `(~N)`/`(~N/M)` right after "(", ABI.md's "approximately" idiom)
// gets the same check against a file resolved from CONTEXT, not a token of
// its own — no numeric tolerance added, just a different way of finding the
// file, tallied separately (hedges/hedgesChecked).
//
// TIER 2, opt-in per row (`verifySymbols`, spec/FMT.md only): a citation
// preceded by a backtick bare identifier naming a declared top-level
// fn/const gets that declaration checked against the cited range. ABI.md's
// prose does not follow this shape and its content is out of scope
// (#3381), so its row leaves this off.
//
// RESOLUTION (see `resolveToken`): ABI.md shortens a citation to a bare
// basename or dir+basename once the full path was named earlier in the
// paragraph, and a hedge names no file at all — both fall back to the most
// recently resolved full path (`contextAt`) when the token alone is
// ambiguous or absent. `requiredPrefix` (FMT.md: "compiler/fmt") keeps that
// row scoped exactly as #3072 left it.
//
// The summary prints every denominator every run, per document and in
// aggregate, so this cannot regress into scanning zero documents while
// printing PASS.
//
// Run from the repository root: bit-out/bin/bit run tests/bit/fmtcitations.bit
// `BIT_REPO` overrides the repository root, matching tests/bit/spec/spec.bit.

import { exists, readFile, walk } from "std/fs"
import { env } from "std/os"
import { contains, hasPrefix, hasSuffix, indexOf, join, replace, split } from "std/strings"

// Bounds — every walk below is over a handful of documents and a few
// hundred source files, each still capped explicitly (Power of 10 rule 2).
const maxDocBytes: int = 1048576
const maxPathTokens: int = 512
const maxHedges: int = 64
const maxTokenLen: int = 128
const maxLineSpecLen: int = 64
const maxSegmentsPerCitation: int = 8
const maxIdentLen: int = 64
const maxBackScan: int = 200
const maxCitedFileBytes: int = 1048576
const maxCitedFileLines: int = 8192
const maxDeclsPerFile: int = 512
const maxIndexFiles: int = 1024

// Floors, not exact counts (a pinned count merges cleanly across two
// branches touching the same document and lands on a wrong total). Set well
// under each document's real count so a regression toward zero fails loudly.
const minVerifiedFloor: int = 10
const minTotalCitationsFloor: int = 51

const bitSuffix: string = ".bit"
const hedgeLineWord: string = "line "

// One row per document this gate covers.
class DocRow { docPath: string, searchRoot: string, requiredPrefix: string,
  checkBareMentions: bool, verifySymbols: bool, minCitations: int }

fn docRows(): []DocRow {
  return [
    DocRow{docPath: "spec/FMT.md", searchRoot: "compiler", requiredPrefix: "compiler/fmt",
      checkBareMentions: true, verifySymbols: true, minCitations: 20},
    DocRow{docPath: "runtime/ABI.md", searchRoot: "runtime", requiredPrefix: "",
      checkBareMentions: false, verifySymbols: false, minCitations: 30},
  ]
}

class PathToken { file: string, lineSpecRaw: string, hasSpec: bool, docLine: int, startOffset: int }

// "/" separates independent line numbers (unlike "-", not a range).
class Hedge { lineSpecRaw: string, docLine: int, startOffset: int }

// A file resolved at a given offset, so a filename-less hedge can ask "what was established here".
class ContextEvent { offset: int, path: string }

class Segment { start: int, end: int, ok: bool }
class Decl { name: string, line: int }
class BoundsResult { ok: bool, lines: []string, segs: []Segment }

class Scan { citations: int, boundsChecked: int, verified: int, bareMentions: int,
  hedges: int, hedgesChecked: int, failures: int }

fn die(msg: string) {
  eprint("fmtcitations: SETUP FAILED: ${msg}\n")
  osExit(1)
}

fn report(sc: Scan, msg: string) {
  eprint("fmtcitations: FAIL: ${msg}\n")
  sc.failures = sc.failures + 1
}

// The repo root: the nearest ancestor holding `spec/FMT.md`. BIT_REPO wins.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (exists("${c}/spec/FMT.md")) {
      return c
    }
  }
  die("cannot locate spec/FMT.md from this cwd; set BIT_REPO")
  return ""
}

fn isIdentStartCh(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn isIdentContCh(c: u8): bool {
  return isIdentStartCh(c) || (c >= '0' && c <= '9')
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn isLineSpecChar(c: u8): bool {
  return (c >= '0' && c <= '9') || c == '-' || c == ',' || c == ' '
}

// `s` trimmed of leading/trailing space/tab/newline/CR — std/strings'
// trimSpace strips only space/tab, and a citation's connector routinely
// crosses a markdown line-wrap.
fn trimWs(s: string): string {
  let lo = 0
  let hi = len(s)
  while (lo < hi && isWs(s[lo])) {
    lo = lo + 1
  }
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isBareIdentifier(s: string): bool {
  let n = len(s)
  if (n == 0 || n > maxIdentLen) {
    return false
  }
  if (!isIdentStartCh(s[0])) {
    return false
  }
  let i = 1
  while (i < n) {
    if (!isIdentContCh(s[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn docLineFor(text: string, offset: int): int {
  return len(split(text[0:offset], "\n"))
}

// Every `<path>.bit` occurrence: find each literal ".bit", scan BACKWARD
// over identifier/slash chars for the token's start, then optionally
// forward over a `:N[-M][, N[-M]...]` spec. `requiredPrefix` (if set)
// discards a token not containing that substring. `i` only ever advances.
fn extractPathTokens(text: string, requiredPrefix: string): []PathToken {
  let out = []PathToken(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxPathTokens) {
    let relRaw = indexOf(text[i:n], bitSuffix)
    if (relRaw < 0) {
      break
    }
    let bitStart = i + int(relRaw)
    let afterBit = bitStart + len(bitSuffix)
    if (afterBit < n && isIdentContCh(text[afterBit])) {
      i = bitStart + 1
      continue
    }
    let start = bitStart
    let floor = bitStart - maxTokenLen
    if (floor < 0) {
      floor = 0
    }
    while (start > floor && (isIdentContCh(text[start - 1]) || text[start - 1] == '/')) {
      start = start - 1
    }
    if (start == bitStart) {
      i = afterBit  // nothing path-like precedes ".bit" (e.g. a glob) -- not a citation
      continue
    }
    let fileName = text[start:bitStart] + bitSuffix
    if (fileName[0] == '/') {
      fileName = fileName[1:len(fileName)]  // brace-expansion leftover, e.g. "/boot.bit" -- treat as its bare basename
    }
    if (len(fileName) == 0 || !isIdentStartCh(fileName[0])) {
      i = afterBit
      continue
    }
    if (len(requiredPrefix) > 0 && !contains(fileName, requiredPrefix)) {
      i = afterBit
      continue
    }
    let hasSpec = false
    let lineSpecRaw = ""
    let endOffset = afterBit
    if (afterBit < n && text[afterBit] == ':') {
      let specStart = afterBit + 1
      let q = specStart
      while (q < n && (q - specStart) < maxLineSpecLen && isLineSpecChar(text[q])) {
        q = q + 1
      }
      let raw = trimWs(text[specStart:q])
      if (len(raw) > 0) {
        hasSpec = true
        lineSpecRaw = raw
        endOffset = q
      }
    }
    out = append(out, PathToken{file: fileName, lineSpecRaw: lineSpecRaw, hasSpec: hasSpec,
      docLine: docLineFor(text, start), startOffset: start})
    i = endOffset
  }
  return out
}

// Every hedge: `~line N[/M][-M]` or a bare `(~N[/M][-M])` right after "(" —
// never a duration/count (`~75us`), which is why both require direct adjacency.
fn extractHedges(text: string): []Hedge {
  let out = []Hedge(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxHedges) {
    let relRaw = indexOf(text[i:n], "~")
    if (relRaw < 0) {
      break
    }
    let tildeAt = i + int(relRaw)
    let specStart = tildeAt + 1
    let viaLineWord = specStart + len(hedgeLineWord) <= n &&
      text[specStart:specStart + len(hedgeLineWord)] == hedgeLineWord
    let viaParen = tildeAt > 0 && text[tildeAt - 1] == '('
    if (!viaLineWord && !viaParen) {
      i = tildeAt + 1
      continue
    }
    if (viaLineWord) {
      specStart = specStart + len(hedgeLineWord)
    }
    let q = specStart
    while (q < n && (q - specStart) < maxLineSpecLen && ((text[q] >= '0' && text[q] <= '9') || text[q] == '-' || text[q] == '/' || text[q] == ',' || text[q] == ' ')) {
      q = q + 1
    }
    let raw = trimWs(text[specStart:q])
    if (len(raw) == 0 || !(raw[0] >= '0' && raw[0] <= '9')) {
      i = tildeAt + 1
      continue
    }
    out = append(out, Hedge{lineSpecRaw: raw, docLine: docLineFor(text, tildeAt), startOffset: tildeAt})
    i = q
  }
  return out
}

// If the citation at `citStartOffset` is directly preceded (only a comma or
// open-paren, plus whitespace, in between) by a single backtick-quoted bare
// identifier, returns it; otherwise "". Deliberately conservative — see the
// TIER 2 note above.
fn findAssociatedSymbol(text: string, citStartOffset: int): string {
  if (citStartOffset < 1 || text[citStartOffset - 1] != '`') {
    return ""
  }
  let scanFloor = citStartOffset - 1 - maxBackScan
  if (scanFloor < 0) {
    scanFloor = 0
  }
  let k = citStartOffset - 2
  while (k >= scanFloor && text[k] != '`') {
    k = k - 1
  }
  if (k < scanFloor || text[k] != '`') {
    return ""
  }
  let connector = trimWs(text[k + 1:citStartOffset - 1])
  if (connector != "," && connector != "(") {
    return ""
  }
  let nameEnd = k
  let nameFloor = k - 1 - maxIdentLen
  if (nameFloor < 0) {
    nameFloor = 0
  }
  let m = k - 1
  while (m >= nameFloor && text[m] != '`') {
    m = m - 1
  }
  if (m < nameFloor || text[m] != '`') {
    return ""
  }
  let candidate = text[m + 1:nameEnd]
  if (!isBareIdentifier(candidate)) {
    return ""
  }
  return candidate
}

// The bare name after `kw` (e.g. "fn " or "const ") at the very start of
// `line`, or "" if `line` does not begin with `kw` followed by an identifier.
fn declName(line: string, kw: string): string {
  if (!hasPrefix(line, kw)) {
    return ""
  }
  let rest = line[len(kw):len(line)]
  if (len(rest) == 0 || !isIdentStartCh(rest[0])) {
    return ""
  }
  let n = len(rest)
  let j = 1
  while (j < n && isIdentContCh(rest[j])) {
    j = j + 1
  }
  return rest[0:j]
}

// Every top-level `fn NAME` / `const NAME` declared in `lines`, in order.
fn extractDecls(lines: []string): []Decl {
  let out = []Decl(0)
  let n = len(lines)
  let i = 0
  while (i < n && len(out) < maxDeclsPerFile) {
    let name = declName(lines[i], "fn ")
    if (len(name) == 0) {
      name = declName(lines[i], "const ")
    }
    if (len(name) > 0) {
      out = append(out, Decl{name: name, line: i + 1})
    }
    i = i + 1
  }
  return out
}

fn lookupDecl(decls: []Decl, name: string): int {
  for d of decls {
    if (d.name == name) {
      return d.line
    }
  }
  return 0
}

fn parseIntSimple(s: string): (int, bool) {
  let n = len(s)
  if (n == 0 || n > 6) {
    return 0, false
  }
  let v = 0
  let i = 0
  while (i < n) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return 0, false
    }
    v = v * 10 + (int(c) - 48)
    i = i + 1
  }
  return v, true
}

fn parseOneSegment(raw: string): Segment {
  let t = trimWs(raw)
  if (len(t) == 0) {
    return Segment{start: 0, end: 0, ok: false}
  }
  let dashRaw = indexOf(t, "-")
  if (dashRaw < 0) {
    let (v, ok) = parseIntSimple(t)
    return Segment{start: v, end: v, ok: ok}
  }
  let dash = int(dashRaw)
  let a = trimWs(t[0:dash])
  let b = trimWs(t[dash + 1:len(t)])
  let (va, oka) = parseIntSimple(a)
  let (vb, okb) = parseIntSimple(b)
  return Segment{start: va, end: vb, ok: oka && okb && vb >= va}
}

// `spec` split on "," into segments, each "N" (start==end) or "N-M". A
// hedge's "/"-separated form is normalized to "," by its caller first.
fn parseSegments(spec: string): []Segment {
  let out = []Segment(0)
  let parts = split(spec, ",")
  if (len(parts) == 0 || len(parts) > maxSegmentsPerCitation) {
    return []Segment(0)
  }
  for part of parts {
    out = append(out, parseOneSegment(part))
  }
  return out
}

// `p` split on "/" with empty components dropped.
fn pathComponents(p: string): []string {
  let parts = split(p, "/")
  let out = []string(0)
  for part of parts {
    if (len(part) > 0) {
      out = append(out, part)
    }
  }
  return out
}

// Whether `candidateComps`'s LAST `len(tokenComps)` components equal
// `tokenComps` in order — e.g. candidate [runtime,root,linux,boot.bit]
// matches token [linux,boot.bit] but not [darwin,boot.bit].
fn suffixMatches(candidateComps: []string, tokenComps: []string): bool {
  let n = len(tokenComps)
  let m = len(candidateComps)
  if (n == 0 || n > m) {
    return false
  }
  let offset = m - n
  let i = 0
  while (i < n) {
    if (candidateComps[offset + i] != tokenComps[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Every `.bit` file under `<root>/<searchRoot>`, as repo-relative paths.
fn buildIndex(root: string, searchRoot: string): []string {
  let walkArg = searchRoot
  let strip = ""
  if (root != ".") {
    walkArg = "${root}/${searchRoot}"
    strip = "${root}/"
  }
  let all = walk(walkArg) catch e {
    die("cannot walk ${walkArg}: ${e.message()}")
    []string(0)
  }
  if (len(all) > maxIndexFiles) {
    die("${walkArg} holds ${len(all)} entries, over the maxIndexFiles bound of ${maxIndexFiles}")
  }
  let out = []string(0)
  for p of all {
    if (!hasSuffix(p, bitSuffix)) {
      continue
    }
    let canon = p
    if (len(strip) > 0 && hasPrefix(p, strip)) {
      canon = p[len(strip):len(p)]
    }
    out = append(out, canon)
  }
  return out
}

// Resolves `token`: a direct hit, else a unique suffix match against
// `index`, else a suffix-consistent fallback to `contextPath`, else unresolved.
fn resolveToken(root: string, token: string, index: []string, contextPath: string): (string, bool) {
  if (exists("${root}/${token}")) {
    return token, true
  }
  let tokenComps = pathComponents(token)
  if (len(tokenComps) == 0) {
    return "", false
  }
  let matches = []string(0)
  for cand of index {
    if (suffixMatches(pathComponents(cand), tokenComps)) {
      matches = append(matches, cand)
    }
  }
  if (len(matches) == 1) {
    return matches[0], true
  }
  if (len(contextPath) > 0 && suffixMatches(pathComponents(contextPath), tokenComps)) {
    return contextPath, true
  }
  return "", false
}

// The most recently resolved file at or before `offset` (events is in order).
fn contextAt(events: []ContextEvent, offset: int): string {
  let result = ""
  for e of events {
    if (e.offset < offset) {
      result = e.path
    }
  }
  return result
}

// Tier-1 bounds check shared by an exact citation and a hedge: `resolved`
// must exist and `parseSpec`'s segments must fall in [1, its line count].
fn checkBoundsShared(sc: Scan, root: string, docPath: string, docLine: int, resolved: string,
    parseSpec: string, displaySpec: string, verb: string): BoundsResult {
  let failResult = BoundsResult{ok: false, lines: []string(0), segs: []Segment(0)}
  let full = "${root}/${resolved}"
  if (!exists(full)) {
    report(sc, "${docPath}:${docLine}: ${verb} ${resolved}:${displaySpec}, but ${resolved} does not exist under the repo root")
    return failResult
  }
  let text = readFile(full) catch e {
    report(sc, "${docPath}:${docLine}: ${verb} ${resolved}:${displaySpec}, but it could not be read: ${e.message()}")
    return failResult
  }
  if (len(text) > maxCitedFileBytes) {
    die("${resolved} is ${len(text)} bytes, over the ${maxCitedFileBytes} bound")
  }
  let lines = split(text, "\n")
  if (len(lines) > maxCitedFileLines) {
    die("${resolved} has ${len(lines)} lines, over the ${maxCitedFileLines} bound")
  }
  let lineCount = len(lines)
  let segs = parseSegments(parseSpec)
  if (len(segs) == 0) {
    report(sc, "${docPath}:${docLine}: ${verb} ${resolved}:${displaySpec}, which has an unparseable line spec")
    return failResult
  }
  let boundsOk = true
  for seg of segs {
    if (!seg.ok || seg.start < 1 || seg.end > lineCount) {
      boundsOk = false
    }
  }
  if (!boundsOk) {
    report(sc, "${docPath}:${docLine}: ${verb} ${resolved}:${displaySpec}, out of bounds (${resolved} has ${lineCount} line(s))")
    return failResult
  }
  return BoundsResult{ok: true, lines: lines, segs: segs}
}

// Tier-1 (+ Tier-2 when `row.verifySymbols`) for one already-resolved citation.
fn checkExactCitationBody(sc: Scan, root: string, row: DocRow, docText: string, tok: PathToken, resolved: string) {
  let res = checkBoundsShared(sc, root, row.docPath, tok.docLine, resolved, tok.lineSpecRaw, tok.lineSpecRaw, "cites")
  if (!res.ok) {
    return
  }
  sc.boundsChecked = sc.boundsChecked + 1
  if (!row.verifySymbols) {
    return
  }
  let symbolName = findAssociatedSymbol(docText, tok.startOffset)
  if (len(symbolName) == 0) {
    return
  }
  let declLine = lookupDecl(extractDecls(res.lines), symbolName)
  if (declLine < 1) {
    return
  }
  let inRange = false
  for seg of res.segs {
    if (declLine >= seg.start && declLine <= seg.end) {
      inRange = true
    }
  }
  if (inRange) {
    sc.verified = sc.verified + 1
  } else {
    report(sc, "${row.docPath}:${tok.docLine}: `${symbolName}` is declared at ${resolved}:${declLine}, outside the cited range ${resolved}:${tok.lineSpecRaw}")
  }
}

// Tier-1 for one hedge, resolved against `resolvedContext`.
fn checkHedge(sc: Scan, root: string, row: DocRow, resolvedContext: string, h: Hedge) {
  sc.hedges = sc.hedges + 1
  if (len(resolvedContext) == 0) {
    report(sc, "${row.docPath}:${h.docLine}: hedges toward ~${h.lineSpecRaw}, but no preceding full-path file mention resolves it")
    return
  }
  let normalized = replace(h.lineSpecRaw, "/", ",")
  let res = checkBoundsShared(sc, root, row.docPath, h.docLine, resolvedContext, normalized, "~${h.lineSpecRaw}", "hedges toward")
  if (!res.ok) {
    return
  }
  sc.hedgesChecked = sc.hedgesChecked + 1
}

// Scans one document row end to end into `sc`; returns this row's own
// (citations, hedges, failures) delta so a zero-scan row can't hide in the aggregate.
fn checkDocument(sc: Scan, root: string, row: DocRow): (int, int, int) {
  let beforeCitations = sc.citations
  let beforeHedges = sc.hedges
  let beforeFailures = sc.failures
  let docFullPath = "${root}/${row.docPath}"
  let docText = readFile(docFullPath) catch e {
    die("cannot read ${docFullPath}: ${e.message()}")
    ""
  }
  if (len(docText) > maxDocBytes) {
    die("${docFullPath} is ${len(docText)} bytes, over the ${maxDocBytes} bound")
  }
  let index = buildIndex(root, row.searchRoot)
  let tokens = extractPathTokens(docText, row.requiredPrefix)
  let events = []ContextEvent(0)
  let contextPath = ""
  for tok of tokens {
    let (resolved, ok) = resolveToken(root, tok.file, index, contextPath)
    // Only a token that was ITSELF written as a path (contains "/") becomes
    // the new context. A bare basename cited in passing (e.g. "floats.bit"
    // inside a list of other funnels' call sites) resolves fine on its own
    // merits but must not overwrite the paragraph's real subject file, or a
    // LATER hedge in the same paragraph would resolve against the wrong file.
    if (ok && contains(tok.file, "/")) {
      contextPath = resolved
      events = append(events, ContextEvent{offset: tok.startOffset, path: resolved})
    }
    if (tok.hasSpec) {
      sc.citations = sc.citations + 1
      if (!ok) {
        report(sc, "${row.docPath}:${tok.docLine}: cites ${tok.file}:${tok.lineSpecRaw}, but ${tok.file} could not be resolved to a file under ${row.searchRoot}/")
      } else {
        checkExactCitationBody(sc, root, row, docText, tok, resolved)
      }
    } else if (row.checkBareMentions) {
      sc.bareMentions = sc.bareMentions + 1
      if (!ok) {
        report(sc, "${row.docPath}:${tok.docLine}: names ${tok.file}, which does not exist under the repo root")
      } else if (!exists("${root}/${resolved}")) {
        report(sc, "${row.docPath}:${tok.docLine}: names ${resolved}, which does not exist under the repo root")
      }
    }
  }
  for h of extractHedges(docText) {
    checkHedge(sc, root, row, contextAt(events, h.startOffset), h)
  }
  return sc.citations - beforeCitations, sc.hedges - beforeHedges, sc.failures - beforeFailures
}

fn selfCheck(cond: bool, label: string): int {
  if (cond) {
    return 0
  }
  eprint("fmtcitations: SELFTEST FAIL: ${label}\n")
  return 1
}

fn selfTestPathTokens(): int {
  let failed = 0
  let text = "See `myFn`, `compiler/fmt.bit:5-9` and bare `compiler/fmtwrap.bit` mention, then `other`, `compiler/fmtdispatch.bit:20, 30-31`."
  let toks = extractPathTokens(text, "compiler/fmt")
  failed = failed + selfCheck(len(toks) == 3, "did not find exactly 3 citations")
  if (len(toks) == 3) {
    failed = failed + selfCheck(toks[0].file == "compiler/fmt.bit" && toks[0].hasSpec && toks[0].lineSpecRaw == "5-9", "misparsed the ranged citation")
    failed = failed + selfCheck(toks[1].file == "compiler/fmtwrap.bit" && !toks[1].hasSpec, "misparsed the bare mention")
    failed = failed + selfCheck(toks[2].file == "compiler/fmtdispatch.bit" && toks[2].lineSpecRaw == "20, 30-31", "misparsed the multi-segment citation")
  }
  // Unfiltered: full, partial (dir+basename), and bare-basename tokens all extract.
  let toks2 = extractPathTokens("`runtime/root/floats.bit:172` then `linux/boot.bit:189,254` then bare `scratch.bit:77`.", "")
  failed = failed + selfCheck(len(toks2) == 3, "unfiltered scan did not find exactly 3 tokens")
  if (len(toks2) == 3) {
    failed = failed + selfCheck(toks2[0].file == "runtime/root/floats.bit", "misparsed the full-path token")
    failed = failed + selfCheck(toks2[1].file == "linux/boot.bit", "misparsed the partial-path token")
    failed = failed + selfCheck(toks2[2].file == "scratch.bit", "misparsed the bare-basename token")
  }
  // A glob has no path char before ".bit" and must never be extracted.
  failed = failed + selfCheck(len(extractPathTokens("matches under `runtime/**/*.bit` and nothing else", "")) == 0,
    "wrongly extracted a token from a glob pattern")
  return failed
}

fn selfTestAssociation(): int {
  let failed = 0
  let t1 = "rule (`fmtFoo`, `compiler/fmt.bit:5-9`) applies"
  let c1 = extractPathTokens(t1, "")
  failed = failed + selfCheck(len(c1) == 1 && findAssociatedSymbol(t1, c1[0].startOffset) == "fmtFoo", "did not associate a comma-connected name")
  let t2 = "call `fmtFoo` (`compiler/fmt.bit:5-9`) applies"
  let c2 = extractPathTokens(t2, "")
  failed = failed + selfCheck(len(c2) == 1 && findAssociatedSymbol(t2, c2[0].startOffset) == "fmtFoo", "did not associate a paren-connected name")
  let t3 = "`fmtFoo`'s own branch, `compiler/fmt.bit:5-9` applies"
  let c3 = extractPathTokens(t3, "")
  failed = failed + selfCheck(len(c3) == 1 && findAssociatedSymbol(t3, c3[0].startOffset) == "", "wrongly associated across a possessive connector")
  let t4 = "the `fmtGap(p, true)`, `compiler/fmt.bit:5-9` call"
  let c4 = extractPathTokens(t4, "")
  failed = failed + selfCheck(len(c4) == 1 && findAssociatedSymbol(t4, c4[0].startOffset) == "", "wrongly associated a call expression")
  return failed
}

fn selfTestDecls(): int {
  let failed = 0
  let decls = extractDecls(["// header", "const fmtMaxWidth = 100", "", "fn fmtFoo(p: Printer) {", "  return 1", "}"])
  failed = failed + selfCheck(len(decls) == 2, "did not find both declarations")
  if (len(decls) == 2) {
    failed = failed + selfCheck(decls[0].name == "fmtMaxWidth" && decls[0].line == 2, "misparsed the const declaration")
    failed = failed + selfCheck(decls[1].name == "fmtFoo" && decls[1].line == 4, "misparsed the fn declaration")
  }
  return failed
}

fn selfTestSegments(): int {
  let failed = 0
  let segs1 = parseSegments("5-9")
  failed = failed + selfCheck(len(segs1) == 1 && segs1[0].ok && segs1[0].start == 5 && segs1[0].end == 9, "misparsed a single range")
  let segs2 = parseSegments("267, 294")
  failed = failed + selfCheck(len(segs2) == 2 && segs2[0].start == 267 && segs2[1].start == 294, "misparsed a two-value list")
  let segs3 = parseSegments("12-x")
  failed = failed + selfCheck(len(segs3) == 1 && !segs3[0].ok, "accepted a non-numeric range end")
  return failed
}

// index/context fixtures shared by every resolveToken case below.
fn selfTestResolve(): int {
  let failed = 0
  let index = ["runtime/root/floats.bit", "runtime/root/os.bit", "runtime/root/linux/os.bit",
    "runtime/root/darwin/os.bit", "runtime/net/linux/netabi.bit", "runtime/net/darwin/netabi.bit"]
  let (r1, ok1) = resolveToken(".", "floats.bit", index, "")
  failed = failed + selfCheck(ok1 && r1 == "runtime/root/floats.bit", "did not resolve a uniquely-suffixed bare basename")
  let (r2, ok2) = resolveToken(".", "linux/netabi.bit", index, "")
  failed = failed + selfCheck(ok2 && r2 == "runtime/net/linux/netabi.bit", "did not resolve a directory-qualified partial path")
  let (r3, ok3) = resolveToken(".", "os.bit", index, "runtime/root/os.bit")
  failed = failed + selfCheck(ok3 && r3 == "runtime/root/os.bit", "did not fall back to context for an ambiguous basename")
  let (_r4, ok4) = resolveToken(".", "os.bit", index, "")
  failed = failed + selfCheck(!ok4, "guessed at an ambiguous basename with no context")
  let (_r5, ok5) = resolveToken(".", "os.bit", index, "runtime/root/floats.bit")
  failed = failed + selfCheck(!ok5, "used a context inconsistent with the token's own basename")
  return failed
}

fn selfTestHedges(): int {
  let failed = 0
  let text = "Rewrite it (the two functions, ~line 591/599) for the new arithmetic. `allocString` (~line 510) additionally. Six funnels (~444/452), (~392/400)."
  let hs = extractHedges(text)
  failed = failed + selfCheck(len(hs) == 4, "did not find exactly 4 hedge markers")
  if (len(hs) == 4) {
    failed = failed + selfCheck(hs[0].lineSpecRaw == "591/599", "misparsed a two-value ~line hedge")
    failed = failed + selfCheck(hs[1].lineSpecRaw == "510", "misparsed a single-value ~line hedge")
    failed = failed + selfCheck(hs[2].lineSpecRaw == "444/452", "misparsed a bare parenthesized hedge")
    failed = failed + selfCheck(hs[3].lineSpecRaw == "392/400", "misparsed the second bare parenthesized hedge")
  }
  failed = failed + selfCheck(len(extractHedges("the kernel rounded a 1us sleep to ~75us and the shim reserves ~300 bytes")) == 0,
    "wrongly treated a duration/count as a line hedge")
  return failed
}

// Runs BEFORE the real scan, on synthetic text, so a scanner bug is caught
// before it silently mis-scores a real document.
fn selfTest(): int {
  return selfTestPathTokens() + selfTestAssociation() + selfTestDecls() + selfTestSegments() +
    selfTestResolve() + selfTestHedges()
}

fn main() {
  let selfFailed = selfTest()
  if (selfFailed != 0) {
    eprint("fmtcitations: SELFTEST FAILED — ${selfFailed} case(s); aborting before the real scan\n")
    osExit(1)
  }
  let root = repoRoot()
  let rows = docRows()
  let sc = Scan{citations: 0, boundsChecked: 0, verified: 0, bareMentions: 0, hedges: 0, hedgesChecked: 0, failures: 0}
  let perDocSummaries = []string(0)
  for row of rows {
    let (rowCitations, rowHedges, rowFailures) = checkDocument(sc, root, row)
    if (rowCitations + rowHedges < row.minCitations) {
      report(sc, "${row.docPath}: only ${rowCitations} citation(s) and ${rowHedges} hedge(s) found, want >= ${row.minCitations} — the scanner regressed or the doc lost its citations")
    }
    perDocSummaries = append(perDocSummaries,
      "${row.docPath}: ${rowCitations} citation(s), ${rowHedges} hedge(s), ${rowFailures} failure(s)")
  }
  let totalCitations = sc.citations + sc.hedges
  if (totalCitations < minTotalCitationsFloor) {
    report(sc, "only ${totalCitations} total citation(s) (exact + hedged) found across ${len(rows)} document(s), want >= ${minTotalCitationsFloor}")
  }
  if (sc.verified < minVerifiedFloor) {
    report(sc, "only ${sc.verified} citation(s) symbol-verified, want >= ${minVerifiedFloor} — the association heuristic regressed")
  }
  let summary = join(perDocSummaries, "; ")
  if (sc.failures > 0) {
    eprint("fmtcitations: FAILED — ${sc.failures} finding(s) over ${len(rows)} document(s) scanned, ${totalCitations} citation(s) total (${sc.citations} exact, ${sc.hedges} hedged, ${sc.boundsChecked} bounds-checked, ${sc.hedgesChecked} hedges-checked, ${sc.verified} symbol-verified, ${sc.bareMentions} bare mention(s)) — ${summary}\n")
    osExit(1)
  }
  print("fmtcitations: ok — ${len(rows)} document(s) scanned, ${totalCitations} citation(s) total (${sc.citations} exact, ${sc.hedges} hedged, ${sc.boundsChecked} bounds-checked, ${sc.hedgesChecked} hedges-checked, ${sc.verified} symbol-verified, ${sc.bareMentions} bare mention(s)), 0 failure(s) — ${summary}\n")
}
