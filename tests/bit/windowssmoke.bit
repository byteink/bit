// `./make test-windows-smoke` (#3341, epic #3322): cross-build a Bit program
// for x86_64-windows, ship it to the REAL Windows box over SSH, run it there,
// and assert its output — the same shape dist/release.sh already uses for
// x86_64-linux via X64_HOST (scp a build, ssh in, run, assert), adapted to a
// bare SSH host instead of a released tarball + docker.
//
// NOT part of the default `./make test`: tools/build/defs.bit registers this
// Step in `coreSteps()`, not `gateSteps()`, so `gateNames()` — the list
// `test` depends on — never names it, and an unreachable remote host (or an
// incomplete Windows runtime port, see below) can never fail the mandatory
// suite. `./make test-windows-smoke` runs it explicitly.
//
// USE THE RIGHT ALIAS. `mustafa-desktop-win` (native Windows 11, PowerShell)
// and `mustafa-desktop-wsl` (WSL2 Ubuntu, bash) are the SAME physical
// machine, and WSL interop means a Windows .exe invoked over the WSL alias
// can still run and exit 0 — through a translation layer, with a different
// current directory and console. Two independent layers guard against the
// wrong alias here:
//   1. Every remote command below is PowerShell syntax. Sent to the WSL
//      alias's default bash shell, it fails mechanically — verified
//      2026-08-21: `ssh mustafa-desktop-wsl '$PWD.Path'` exits 127,
//      "command not found", before any assertion below even runs.
//   2. The smoke program itself prints argv[0] — the ABSOLUTE path this
//      script invoked it with, resolved via PowerShell's own `$PWD.Path` at
//      invocation time, not a bare relative reference — and this gate
//      asserts it does not start with `\\`, the UNC-path signature WSL
//      interop gives a Windows process's view of its own invocation.
//
// HISTORY, kept because the mechanism recurs: this gate crossed FOUR real
// link/boot walls, all on `main` now, before it could pass for the first
// time (2026-08-24). #3385 (pelink.bit's `.bss` atoms never got an RVA
// folded into `addrOf`, so any reference to a zero-init global — e.g.
// runtime/chan/chanwrap.bit's chanReserveAddr via chanBootBind, hit by every
// program at boot — failed to link with an unnamed "pe: undefined symbol").
// #3391 (an empty `fn main() {}` crashed before bit_main ever ran). #3503
// (`spawn()` segfaulted on real hardware: runtime/sched/task.bit's
// `taskInvoke` hardcoded SysV's `rdi` for its one argument, but every
// x86_64-windows function — including the compiler-synthesized spawn
// trampoline — compiles `XCallConv.Win64`, whose first argument register is
// `rcx`). #3554 (the `@naked bit_rt_safepoint` shim had the identical
// rdi/rcx defect; only visible under `BIT_GC=stress`, which is the only path
// that forces a poll at every back edge).
//
// THE PROGRAM BELOW NOW `spawn`S ONE TASK (see Phase 2), specifically so
// this gate would have caught #3503 automatically — a smoke run that only
// prints never reaches taskInvoke at all. It deliberately does NOT run
// under `BIT_GC=stress`: while building this spawn check, `args()`'s own
// returned slice turned out to be corrupted under stress on real Windows
// hardware (garbage length, or a segfault on indexing — 3/3 reproducible,
// gone the instant `BIT_GC=stress` is unset) — a new, distinct bug, filed
// as #3592 rather than fixed here (out of this ticket's `tools/build/**`
// scope). Wiring `BIT_GC=stress` into this gate would fail it on #3592, not
// on anything `tools/build` owns. Once #3592 lands, add it here so this
// gate would have caught #3554's class of bug the same way it now catches
// #3503's.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { contains, hasPrefix, parseInt, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Generous for a cross-build; the SSH round trips are seconds. A hang here
// is a failure, not a stall (matches coldboot.bit's reasoning).
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "180")) catch _ { 180 }
  if (s <= 0) {
    return 180000
  }
  return s * 1000
}

// BIT_REPO IS REQUIRED, same reason as every other shell-out gate in this
// repo (tests/bit/coldboot.bit's header): a silent "." default would build
// and ship whatever directory `bit` happened to be invoked from.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("windowssmoke: BIT_REPO is not set — run this through `./make test-windows-smoke`")
  }
  return r
}

// Overridable so this gate's OWN unreachable-host path is testable without a
// network outage: `BIT_WINDOWS_HOST=nonexistent ./make test-windows-smoke`.
fn windowsHost(): string {
  return envOr("BIT_WINDOWS_HOST", "mustafa-desktop-win")
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}

// Runs `script` through /bin/sh (this Mac's shell, not the remote one) and
// returns its exit code. Same shape as coldboot.bit's `shell()`: negative
// returns are osRunBounded's own channel (ABI.md §19), never a program's
// exit status, so each is a named panic rather than a value an assertion
// could mistake for the thing under test.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("windowssmoke: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("windowssmoke: TIMED OUT after ${ms}ms — a hang is a failure, not a stall")
  }
  if (code == -1) {
    panic("windowssmoke: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("windowssmoke: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// Runs `script`, recording ITS OWN command's exit code to `codePath` — never
// the wrapper's — so a wrapper-level setup failure (90/91 below) can never
// be confused with the command under test failing. Returns (exit code,
// captured stdout+stderr).
//
// `script` runs inside a `{ ...; }` group redirected to `outPath` — NOT
// inherited from this process's own stdout/stderr. `osForkExecWaitBounded`
// (runtime/root/{linux,darwin}/os.bit) does no fd redirection of its own; a
// child simply inherits this process's fds. Without the explicit `{ } >
// outPath 2>&1` wrapper here, `script`'s output would stream straight
// through to `./make`'s own stdout and `outPath` would never be written,
// making `readFile(outPath) catch ""` always return "" — silently turning
// every content-based assertion below (`contains(out4, "smoke ok")`, the
// nativeness check) into a check against an empty string that can never
// pass, regardless of what the remote command actually printed. Found
// 2026-08-24: the FIRST real end-to-end run (#3503/#3554 fixed by then)
// printed "smoke ok" and a clean argv0 straight to the terminal — proof the
// program ran correctly — while this gate still reported FAIL, because
// `out4` was "" the whole time. `$?` right after the closing `}` still
// reports the group's own last command, not this wrapper's.
fn runCaptured(scratch: string, tag: string, script: string, ms: int): (int, string) {
  let outPath = "${scratch}/${tag}.out"
  let codePath = "${scratch}/${tag}.code"
  let wrapped = "#!/bin/sh\n{\n" + script + "\n} > '${outPath}' 2>&1\necho $? > '${codePath}'\nexit 0\n"
  let wrapperRc = shell("${scratch}/${tag}.sh", wrapped, ms) catch e {
    panic("windowssmoke: ${e.message()}")
    0
  }
  if (wrapperRc != 0) {
    panic("windowssmoke: ${tag} wrapper script exited ${wrapperRc}, which it never should")
  }
  if (!exists(codePath)) {
    panic("windowssmoke: no exit code recorded for '${tag}' — it never ran")
  }
  let codeText = trimSpace(readFile(codePath) catch e {
    panic("windowssmoke: cannot read ${codePath}: ${e.message()}")
    ""
  })
  let code = parseInt(codeText) catch _ {
    panic("windowssmoke: ${codePath} did not contain a number: '${codeText}'")
    0 - 1
  }
  let out = readFile(outPath) catch ""
  return code, out
}

fn failStage(stage: string, code: int, out: string) {
  eprint(out)
  println("windowssmoke: FAIL at '${stage}' (exit ${code})")
  exit(1)
}

// Phase 0: is the box even reachable? Fail here with a diagnostic that names
// the host, cheaply, before any cross-build.
fn checkReachable(scratch: string, host: string, ms: int) {
  let (rc0, out0) = runCaptured(scratch, "reachable",
    "ssh -o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 '${host}' 'exit 0'\n", ms)
  if (rc0 != 0) {
    eprint(out0)
    println("windowssmoke: FAIL — ${host} is unreachable over SSH (exit ${rc0}); this does not fail `./make test`")
    exit(1)
  }
}

// Phase 1: cross-build (or refresh) libbitrt.a for x86_64-windows, using
// THIS TREE'S OWN compiler — the pinned stage0 does not know the target name
// at all (tools/build/artifacts.bit's targets() comment). Returns the
// archive path.
fn buildArchive(scratch: string, root: string, bitBin: string, ms: int): string {
  let archivePath = "${scratch}/libbitrt-x86_64-windows.a"
  let (rc1, out1) = runCaptured(scratch, "archive",
    "cd '${root}' || exit 90\n" +
    "BIT='${bitBin}' bash scripts/g2archive.sh x86_64-windows '${archivePath}'\n", ms)
  if (rc1 != 0) {
    failStage("cross-build libbitrt-x86_64-windows.a", rc1, out1)
  }
  return archivePath
}

// Phase 2: cross-build the smoke program against that archive. Returns the
// built exe path.
//
// The program also `spawn`s one task and waits for it via a plain atomic
// counter (spawnfireforget.bit's own shape) — exercising the exact path
// #3503 broke (runtime/sched/task.bit's `taskInvoke` hardcoded SysV's `rdi`
// for its one argument; every x86_64-windows function, including the
// compiler-synthesized spawn trampoline, compiles `XCallConv.Win64`, whose
// first argument register is `rcx`) and #3503's fix (landed,
// runtime/sched/windows/spawn.bit) is meant to have closed. `timeSleepNs` is
// a predeclared builtin (compiler/symbols.bit), not `std/time`'s `sleep` —
// deliberately, so this program does not import `std/fs` transitively
// through `std/time`'s tzlocal.bit while #3549 is open. Deliberately NOT run
// under `BIT_GC=stress`: #3592 (found while building this gate, filed
// separately) reproduces a real, unrelated corruption in `args()`'s
// returned slice under stress mode on native Windows — adding stress here
// would fail this gate on a bug this ticket does not own.
fn buildProgram(scratch: string, root: string, bitBin: string, archivePath: string, runId: string, ms: int): string {
  let progDir = "${scratch}/prog"
  mkdir(progDir) catch e {
    panic("windowssmoke: cannot create ${progDir}: ${e.message()}")
  }
  writeFile("${progDir}/main.bit",
    "import { args } from \"std/os\"\n\n" +
    "let spawnCounter: [1]i64\n\n" +
    "fn spawnWorker() {\n" +
    "  atomicAdd(ptrOf(spawnCounter), 1)\n" +
    "}\n\n" +
    "fn main() {\n" +
    "  spawn spawnWorker()\n" +
    "  let polls = 0\n" +
    "  while (int(atomicLoad(ptrOf(spawnCounter))) < 1 && polls < 20000) {\n" +
    "    timeSleepNs(1000000)\n" +
    "    polls = polls + 1\n" +
    "  }\n" +
    "  print(\"spawn ok \${int(atomicLoad(ptrOf(spawnCounter)))}\\n\")\n" +
    "  print(\"smoke ok\\n\")\n" +
    "  print(\"argv0=\${args()[0]}\\n\")\n" +
    "}\n") catch e {
    panic("windowssmoke: cannot write ${progDir}/main.bit: ${e.message()}")
  }
  let exePath = "${scratch}/${runId}.exe"
  let (rc2, out2) = runCaptured(scratch, "buildprog",
    "cd '${root}' || exit 90\n" +
    "BIT_LIBBITRT='${archivePath}' '${bitBin}' build '${progDir}' --target x86_64-windows -o '${exePath}'\n", ms)
  if (rc2 != 0) {
    failStage("cross-build the smoke program", rc2, out2)
  }
  return exePath
}

// Phase 3: ship it, run it natively, assert the marker, the spawn check and
// the nativeness signal (see the file header for what each catches and why
// BIT_GC=stress is deliberately not used here).
//
// A RELATIVE scp destination, deliberately: a Windows destination with a
// drive letter (`host:C:\Users\...`) breaks scp's `host:path` parsing on the
// drive letter's own colon (verified 2026-08-21 — `scp` reports "No such
// file or directory" against a path PowerShell itself just created). A bare
// relative name lands in the SSH server's default directory (the user's
// home) with no such ambiguity.
fn shipAndRun(scratch: string, host: string, runId: string, exePath: string, ms: int) {
  let remoteName = "${runId}.exe"
  let (rc3, out3) = runCaptured(scratch, "ship",
    "scp -q -o BatchMode=yes -o ConnectTimeout=8 '${exePath}' '${host}:${remoteName}'\n", ms)
  if (rc3 != 0) {
    failStage("scp the smoke program to ${host}", rc3, out3)
  }

  // `Join-Path $PWD.Path ...` resolves the ABSOLUTE invocation path
  // server-side, at run time — never a bare `.\name.exe` reference, which
  // would make argv[0] the literal relative string and defeat the
  // nativeness check below.
  let (rc4, out4) = runCaptured(scratch, "run",
    "ssh -o BatchMode=yes -o ConnectTimeout=8 '${host}' " +
    "\"& (Join-Path \\$PWD.Path '${remoteName}')\"\n", ms)
  // Best-effort cleanup regardless of the run's own result; teardown() also
  // retries this, so a failure here is not itself fatal.
  runCaptured(scratch, "cleanup",
    "ssh -o BatchMode=yes -o ConnectTimeout=8 '${host}' 'Remove-Item -Force ${remoteName}'\n", ms)
  if (rc4 != 0) {
    failStage("run the smoke program on ${host}", rc4, out4)
  }
  if (!contains(out4, "smoke ok")) {
    println("windowssmoke: FAIL — ${host} did not print 'smoke ok':")
    eprint(out4)
    exit(1)
  }
  if (!contains(out4, "spawn ok 1")) {
    println("windowssmoke: FAIL — ${host} did not print 'spawn ok 1' (a spawn()'d task never ran or the counter was lost):")
    eprint(out4)
    exit(1)
  }
  let argv0Line = extractArgv0(out4)
  if (len(argv0Line) == 0) {
    println("windowssmoke: FAIL — no argv0= line in the program's output:")
    eprint(out4)
    exit(1)
  }
  if (hasPrefix(argv0Line, "\\\\")) {
    println("windowssmoke: FAIL — argv[0] is a UNC path ('${argv0Line}') — this ran through WSL interop, not natively. Check BIT_WINDOWS_HOST.")
    exit(1)
  }
  println("windowssmoke: PASS — ${host}, argv0=${argv0Line}")
}

fn main() {
  let ms = timeoutMs()
  let root = repoRoot()
  let host = windowsHost()
  let bitBin = "${root}/bit-out/bin/bit"
  let runId = "wsmoke-" + uuidFormat(uuidV4())
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-windowssmoke-${uuidFormat(uuidV4())}"
  mkdir(scratch) catch e {
    panic("windowssmoke: cannot create ${scratch}: ${e.message()}")
  }
  defer teardown(scratch, host, runId, ms)

  checkReachable(scratch, host, ms)
  let archivePath = buildArchive(scratch, root, bitBin, ms)
  let exePath = buildProgram(scratch, root, bitBin, archivePath, runId, ms)
  shipAndRun(scratch, host, runId, exePath, ms)
}

// Pulls the value out of the program's own "argv0=..." output line.
fn extractArgv0(out: string): string {
  let lines = splitLines(out)
  for line of lines {
    if (hasPrefix(line, "argv0=")) {
      return trimSpace(line[6:])
    }
  }
  return ""
}

fn splitLines(s: string): []string {
  let lines = []string(0)
  let start = 0
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\n') {
      lines = append(lines, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  if (start < len(s)) {
    lines = append(lines, s[start:])
  }
  return lines
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
// Also best-effort removes the remote copy, in case Phase 3's own cleanup
// never ran (an earlier phase failed first).
fn teardown(scratch: string, host: string, runId: string, ms: int) {
  shell("${scratch}/cleanup-remote.sh",
    "#!/bin/sh\nssh -o BatchMode=yes -o ConnectTimeout=5 '${host}' 'Remove-Item -Force ${runId}.exe' > /dev/null 2>&1\nexit 0\n",
    ms) catch _ { 0 }
  shell("${scratch}/cleanup-local.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ { 0 }
}
