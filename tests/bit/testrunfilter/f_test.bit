// tests/bit/testrunfilter/f_test.bit — the three-test fixture for `bit test
// --run <pattern>` (epic #2258). #2833 landed argument parsing for `--run`
// (parsed and validated, filter not yet applied); #2834 applies the filter;
// #2836 adds the shell case that drives `bit test` against this fixture with
// `--run test_alpha` (want: only that test runs) and `--run test_zzz` (want:
// no test matched, non-zero exit).
//
// Three tests, one assert line each, all pass with no filter — exactly the
// epic's own repro block (#2258) — so a filter-less run stays a clean
// baseline no matter which pattern a later case tries.
//
// Lives in its own directory rather than tests/testproj/ (scripts/
// selfhost-difftests.sh's fixture): that directory is read as a WHOLE
// PROJECT (sibling .bit files share one module), and its header already pins
// a specific count — "two pass, two fail" — that adding tests here would
// silently change. This directory holds nothing else, so passing this file's
// path directly to `bit test` never pulls in an unrelated module.
import { ok } from "std/testing"

fn test_alpha() { ok(true, "a") }
fn test_beta() { ok(true, "b") }
fn test_gamma() { ok(true, "c") }
