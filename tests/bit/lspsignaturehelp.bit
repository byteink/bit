// `bit lsp` textDocument/signatureHelp gate (#2337): drives the REAL
// self-hosted `bit lsp` binary as a subprocess and asserts on its raw
// JSON-RPC output, the same mechanics as tests/bit/lspreferences.bit (see its
// header) and tests/bit/lspresolve.bit — each `bit run tests/bit/*.bit` is a
// standalone single-file program, so the small harness (frame/shQuote/
// runLsp/...) is duplicated here rather than imported.
//
// THE CASES THAT ACTUALLY BREAK THIS FEATURE (the ticket's own list):
//   - the active-parameter index as the cursor moves across commas
//     (checkSignatureHelpActiveParameter: 3 requests at 3 cursor positions
//     in one `join3("x", "y", "z")` call, asserting 0, 1, 2);
//   - a call with zero arguments (checkSignatureHelpZeroArgs: empty
//     `parameters` array, activeParameter still 0, not an out-of-range
//     value a client would have to guard against);
//   - a nested call (checkSignatureHelpNestedCall: `f(g(1), 2)` with the
//     cursor right after the INNER `(` must resolve to `g`'s signature, not
//     the outer `f`'s — NOT the unclosed `f(g(` shape the ticket's own text
//     illustrates: an unclosed call is out of scope for signature help's own
//     resolution logic (compiler/lspsignature.bit's `lspEnclosingCall`/
//     `lspCalleeDecl`), so this case stays well-formed instead. The
//     file-wide `checkedOk` gate this comment used to cite as the reason
//     (compiler/lspbuild.bit's `checkedOk = !hasErrors(p.diags)`, skipping
//     `checkResolved` entirely on any parse error anywhere in the file) was
//     REMOVED by #3559 — checkResolved now runs unconditionally, so do not
//     go looking for it or "restore" it);
//   - an unresolved callee (checkSignatureHelpUnresolvedCallee: a call to an
//     undefined name must answer `null`, not crash or fabricate a signature);
//   - a method vs a free function (checkSignatureHelpAcceptance covers the
//     method path — the ticket's own acceptance shape, `Board.add` — and
//     checkSignatureHelpActiveParameter/ZeroArgs/NestedCall all cover the
//     free-function path, so both resolution branches in
//     compiler/lspsignature.bit's `lspCalleeDecl` are exercised).
//
// WIRED INTO `./make test` as `test-lsp-signaturehelp` (tools/build/
// gates.bit, tools/build/defs.bit), registered in the same commit as this
// file so scripts/gate.sh does not see it as an unmapped tests/bit/** path.

import { envOr, exit } from "std/os"
import { readFile, writeFile, mkdir, exists } from "std/fs"

const timeoutMs: int = 20000

fn failCase(msg: string) {
  eprint("FAIL lspsignaturehelp: " + msg + "\n")
  exit(1)
}

fn frame(body: string): string {
  return "Content-Length: ${len(body)}\r\n\r\n" + body
}

fn mkdirQuiet(path: string) {
  mkdir(path) catch e {
    return
  }
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn runLsp(bin: string, scratch: string, payload: string): (string, bool) {
  mkdirQuiet(scratch)
  let inPath = scratch + "/in"
  let outPath = scratch + "/out"
  let errPath = scratch + "/err"
  let shPath = scratch + "/w.sh"
  writeFile(inPath, payload) catch e {
    failCase("cannot write input payload: " + e.message())
    return "", false
  }
  let script = "#!/bin/sh\nexec " +
    shQuote(bin) +
    " lsp < " +
    shQuote(inPath) +
    " > " +
    shQuote(outPath) +
    " 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    failCase("cannot write wrapper script: " + e.message())
    return "", false
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    failCase("cannot chmod wrapper script")
    return "", false
  }
  let code = osRunBounded(shPath, timeoutMs)
  if (code == 0 - 2) {
    failCase("TIMED OUT after ${timeoutMs}ms (raise BIT_TEST_TIMEOUT_S)")
    return "", false
  }
  if (code == 0 - 1) {
    failCase("cannot launch wrapper script (spawn/wait failure)")
    return "", false
  }
  if (code <= 0 - 100) {
    failCase("CRASHED: killed by signal ${0 - code - 100}")
    return "", false
  }
  let out = readFile(outPath) catch e {
    ""
  }
  return out, true
}

// Escapes `s` for embedding as a JSON string literal's body — the only bytes
// the fixtures below ever contain are '"', '\' and '\n'.
fn jsonEscape(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == u8('"')) {
      out = out + "\\\""
    } else if (c == u8('\\')) {
      out = out + "\\\\"
    } else if (c == u8('\n')) {
      out = out + "\\n"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out
}

fn contains(haystack: string, needle: string): bool {
  let n = len(needle)
  if (n == 0) {
    return true
  }
  let i = 0
  while (i + n <= len(haystack)) {
    if (haystack[i:i + n] == needle) {
      return true
    }
    i = i + 1
  }
  return false
}

// One reply's own JSON body, bounded to the next framed message (or end of
// `out`) rather than to end of string: a request's reply is routinely
// followed by `publishDiagnostics` notifications that carry their own JSON,
// and an unbounded tail would silently fold those in.
fn resultTail(out: string, idMarker: string): string {
  let mlen = len(idMarker)
  let start = 0
  while (start + mlen <= len(out) && out[start:start + mlen] != idMarker) {
    start = start + 1
  }
  if (start + mlen > len(out)) {
    failCase("resultTail: marker " + idMarker + " not found\n" + out)
    return ""
  }
  let sep = "Content-Length:"
  let slen = len(sep)
  let end = start + mlen
  while (end + slen <= len(out) && out[end:end + slen] != sep) {
    end = end + 1
  }
  if (end + slen > len(out)) {
    end = len(out)
  }
  return out[start:end]
}

// The integer value following `"activeParameter":` in `tail`, or -1 if the
// key is absent — bounded by `len(tail)`.
fn activeParameterOf(tail: string): int {
  let key = "\"activeParameter\":"
  let klen = len(key)
  let i = 0
  while (i + klen <= len(tail) && tail[i:i + klen] != key) {
    i = i + 1
  }
  if (i + klen > len(tail)) {
    return -1
  }
  let j = i + klen
  let n = 0
  let sawDigit = false
  while (j < len(tail) && tail[j] >= u8('0') && tail[j] <= u8('9')) {
    n = n * 10 + (int(tail[j]) - int(u8('0')))
    sawDigit = true
    j = j + 1
  }
  if (!sawDigit) {
    return -1
  }
  return n
}

fn initReq(): string {
  return frame(
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
      "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}",
  )
}

fn initNotif(): string {
  return frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
}

fn didOpen(uri: string, text: string): string {
  return frame(
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
      "\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"bit\",\"version\":1," +
      "\"text\":\"" +
      jsonEscape(text) +
      "\"}}}",
  )
}

fn sigHelpReq(id: int, uri: string, line: int, character: int): string {
  return frame(
      "{\"jsonrpc\":\"2.0\",\"id\":${id},\"method\":\"textDocument/signatureHelp\"," +
      "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":${line}," +
      "\"character\":${character}}}}",
  )
}

// The capability an editor gates parameter hints on — #2337's own repro:
// absent -> `-32601 method not found`, so typing `f(` never shows anything.
fn checkSignatureHelpCapability(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/cap"
  mkdirQuiet(dir)
  let (out, ok) = runLsp(bin, dir, initReq())
  if (!ok) {
    return
  }
  if (!contains(out, "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]")) {
    failCase("initialize result is missing signatureHelpProvider triggerCharacters\n" + out)
    return
  }
  if (!contains(out, "\"retriggerCharacters\":[\",\"]")) {
    failCase("initialize result is missing signatureHelpProvider retriggerCharacters\n" + out)
    return
  }
  print("PASS lspsignaturehelp: initialize advertises signatureHelpProvider\n")
}

// #2337's own acceptance shape, verbatim: `b.add(` with the cursor
// immediately after `(` resolves the METHOD path
// (compiler/lspsignature.bit's `lspCalleeDeclFromMember`) to one
// SignatureInformation labelled `add(title: string): Task`, activeParameter 0.
fn checkSignatureHelpAcceptance(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/acceptance"
  mkdirQuiet(dir)
  let board = "class Board {\n  tasks: []Task,\n\n  add(title: string): Task {\n" +
    "    let t = Task{ title: title }\n    this.tasks = append(this.tasks, t)\n" +
    "    return t\n  }\n}\n\nclass Task {\n  title: string,\n}\n"
  let main = "fn main() {\n  let b = Board{ tasks: []Task(0) }\n" +
    "  let a = b.add(\"write the parser\")\n}\n"
  writeFile(dir + "/board.bit", board) catch e {
    failCase("cannot write board.bit: " + e.message())
    return
  }
  writeFile(dir + "/main.bit", main) catch e {
    failCase("cannot write main.bit: " + e.message())
    return
  }
  let bUri = "file://" + dir + "/board.bit"
  let mUri = "file://" + dir + "/main.bit"
  // main.bit line 2 "  let a = b.add(\"write the parser\")": character 16 is
  // immediately after `add`'s `(` — the ticket's own reproduction position.
  let payload = initReq() +
    initNotif() +
    didOpen(bUri, board) +
    didOpen(mUri, main) +
    sigHelpReq(2, mUri, 2, 16)
  let (out, ok) = runLsp(bin, dir, payload)
  if (!ok) {
    return
  }
  let tail = resultTail(out, "\"id\":2,\"result\":")
  if (!contains(tail, "\"label\":\"add(title: string): Task\"")) {
    failCase("Board.add signatureHelp: wrong or missing signature label\n" + tail)
    return
  }
  if (!contains(tail, "\"parameters\":[{\"label\":\"title: string\"}]")) {
    failCase("Board.add signatureHelp: wrong or missing parameters array\n" + tail)
    return
  }
  if (activeParameterOf(tail) != 0) {
    failCase("Board.add signatureHelp: expected activeParameter 0, got ${activeParameterOf(tail)}\n" + tail)
    return
  }
  print("PASS lspsignaturehelp: b.add( resolves the method's signature, activeParameter 0\n")
}

// THE OFF-BY-ONE THIS FEATURE EXISTS TO CATCH: `join3("x", "y", "z")` at 3
// cursor positions — right after `(`, right after the first comma, right
// after the second — must answer activeParameter 0, 1, 2 respectively, on
// the FREE-FUNCTION resolution path (`lspCalleeDeclFromIdent`).
fn checkSignatureHelpActiveParameter(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/activeparam"
  mkdirQuiet(dir)
  let text = "fn join3(a: string, b: string, c: string): string {\n  return a + b + c\n}\n\n" +
    "fn main() {\n  let r = join3(\"x\", \"y\", \"z\")\n}\n"
  writeFile(dir + "/j.bit", text) catch e {
    failCase("cannot write j.bit: " + e.message())
    return
  }
  let uri = "file://" + dir + "/j.bit"
  // line 5 "  let r = join3(\"x\", \"y\", \"z\")": char 16 is right after `(`,
  // char 20 is right after the first `, `, char 25 right after the second.
  let payload = initReq() +
    initNotif() +
    didOpen(uri, text) +
    sigHelpReq(2, uri, 5, 16) +
    sigHelpReq(3, uri, 5, 20) +
    sigHelpReq(4, uri, 5, 25)
  let (out, ok) = runLsp(bin, dir, payload)
  if (!ok) {
    return
  }
  assertActiveParamSeq(out)
  print("PASS lspsignaturehelp: activeParameter tracks the cursor across 2 commas (0, 1, 2)\n")
}

// Split out of `checkSignatureHelpActiveParameter` to keep it under the
// repo's max-fn-lines limit (E0201).
fn assertActiveParamSeq(out: string) {
  let want = [0, 1, 2]
  let ids = [2, 3, 4]
  let i = 0
  while (i < 3) {
    let tail = resultTail(out, "\"id\":${ids[i]},\"result\":")
    if (!contains(tail, "\"label\":\"join3(a: string, b: string, c: string): string\"")) {
      failCase("join3 signatureHelp id ${ids[i]}: wrong or missing label\n" + tail)
      return
    }
    let got = activeParameterOf(tail)
    if (got != want[i]) {
      failCase("join3 signatureHelp id ${ids[i]}: expected activeParameter ${want[i]}, got ${got}\n" + tail)
      return
    }
    i = i + 1
  }
}

// A zero-argument call: `parameters` must be an empty array, and
// activeParameter must still be a valid (0), not an out-of-range index.
fn checkSignatureHelpZeroArgs(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/zeroargs"
  mkdirQuiet(dir)
  let text = "fn h(): i64 {\n  return 1\n}\n\nfn main() {\n  h()\n}\n"
  writeFile(dir + "/z.bit", text) catch e {
    failCase("cannot write z.bit: " + e.message())
    return
  }
  let uri = "file://" + dir + "/z.bit"
  // line 5 "  h()": char 4 is between `(` and `)`.
  let payload = initReq() + initNotif() + didOpen(uri, text) + sigHelpReq(2, uri, 5, 4)
  let (out, ok) = runLsp(bin, dir, payload)
  if (!ok) {
    return
  }
  let tail = resultTail(out, "\"id\":2,\"result\":")
  if (!contains(tail, "\"label\":\"h(): i64\"") || !contains(tail, "\"parameters\":[]")) {
    failCase("h() signatureHelp: expected label \"h(): i64\" and an empty parameters array\n" + tail)
    return
  }
  if (activeParameterOf(tail) != 0) {
    failCase("h() signatureHelp: expected activeParameter 0, got ${activeParameterOf(tail)}\n" + tail)
    return
  }
  print("PASS lspsignaturehelp: a zero-argument call answers an empty parameters array\n")
}

// `f(g(1), 2)`, cursor right after the INNER `(`. Must resolve `g`'s
// signature (the innermost enclosing call, compiler/lspsignature.bit's
// `lspEnclosingCall`), never the outer `f`'s — deliberately WELL-FORMED (see
// this file's header): the unclosed-call shape the ticket illustrates is out
// of scope for signature help's own resolution logic, not a case this test
// needs to cover. The file-wide `checkedOk` gate this comment used to cite
// as the reason was REMOVED by #3559 — checkResolved now runs
// unconditionally, so do not go looking for it here.
fn checkSignatureHelpNestedCall(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/nested"
  mkdirQuiet(dir)
  let text = "fn g(y: i64): i64 {\n  return y\n}\n\n" +
    "fn f(x: i64, y: i64): i64 {\n  return x + y\n}\n\n" +
    "fn main() {\n  let r = f(g(1), 2)\n}\n"
  writeFile(dir + "/n.bit", text) catch e {
    failCase("cannot write n.bit: " + e.message())
    return
  }
  let uri = "file://" + dir + "/n.bit"
  // line 9 "  let r = f(g(1), 2)": char 14 is immediately after g's own `(`.
  let payload = initReq() + initNotif() + didOpen(uri, text) + sigHelpReq(2, uri, 9, 14)
  let (out, ok) = runLsp(bin, dir, payload)
  if (!ok) {
    return
  }
  let tail = resultTail(out, "\"id\":2,\"result\":")
  if (!contains(tail, "\"label\":\"g(y: i64): i64\"")) {
    failCase("f(g( signatureHelp: expected g's signature, got\n" + tail)
    return
  }
  if (contains(tail, "\"label\":\"f(")) {
    failCase("f(g( signatureHelp: wrongly resolved the OUTER call\n" + tail)
    return
  }
  print("PASS lspsignaturehelp: f(g( resolves the INNER call g's signature, not the outer f's\n")
}

// #3559 removed the file-wide `checkedOk` gate (`compiler/lspbuild.bit`'s
// `checkedOk = !hasErrors(p.diags)`, which used to skip `checkResolved`
// entirely on any parse error anywhere in the file) — `checkResolved` now
// runs unconditionally. `f(g(` (both calls left open, `main`'s own closing
// `}` never reached) is a real mid-edit shape a user hits constantly, and it
// now resolves the INNER call `g`'s signature even though the file is full
// of parse errors, alongside the publishDiagnostics carrying those errors —
// the point of #3559 is type info AND diagnostics together, not one or the
// other. Verified directly against the compiled binary (#3581): the
// signatureHelp reply is `g(y: i64): i64` / `activeParameter 0`, and the
// same session's publishDiagnostics carries E0021 (x4, the unclosed calls
// and missing brace), E0050 (arg count) and E0041 (result type) — this case
// pins the signature/activeParameter and confirms diagnostics still flow,
// not the exact diagnostic count, which is incidental to this feature.
fn checkSignatureHelpUnclosedNestedCall(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/unclosednested"
  mkdirQuiet(dir)
  let text = "fn g(y: i64): i64 {\n  return y\n}\n\n" +
    "fn f(x: i64, y: i64): i64 {\n  return x + y\n}\n\n" +
    "fn main() {\n  let r = f(g(\n}\n"
  writeFile(dir + "/uc.bit", text) catch e {
    failCase("cannot write uc.bit: " + e.message())
    return
  }
  let uri = "file://" + dir + "/uc.bit"
  // line 9 "  let r = f(g(": char 14 is immediately after g's own unclosed
  // `(` — the same position #3581's own reproduction used.
  let payload = initReq() + initNotif() + didOpen(uri, text) + sigHelpReq(2, uri, 9, 14)
  let (out, ok) = runLsp(bin, dir, payload)
  if (!ok) {
    return
  }
  if (!contains(out, "\"method\":\"textDocument/publishDiagnostics\"") ||
    !contains(out, "\"code\":\"E0021\"")) {
    failCase("f(g( unclosed: expected publishDiagnostics with a parse-error (E0021) still flowing\n" + out)
    return
  }
  let tail = resultTail(out, "\"id\":2,\"result\":")
  if (!contains(tail, "\"label\":\"g(y: i64): i64\"") ||
    !contains(tail, "\"parameters\":[{\"label\":\"y: i64\"}]")) {
    failCase("f(g( unclosed signatureHelp: expected g's signature and parameters, got\n" + tail)
    return
  }
  if (activeParameterOf(tail) != 0) {
    failCase(
        "f(g( unclosed signatureHelp: expected activeParameter 0, got ${activeParameterOf(tail)}\n" +
        tail,
    )
    return
  }
  print("PASS lspsignaturehelp: unclosed f(g( resolves g's signature (activeParameter 0) alongside parse-error diagnostics\n")
}

// A call to an undefined name must answer `null` — never crash, never
// fabricate a signature from whatever type inference happened to leave
// behind.
fn checkSignatureHelpUnresolvedCallee(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/unresolved"
  mkdirQuiet(dir)
  let text = "fn main() {\n  let z = totallyUndefinedFn(1, 2)\n}\n"
  writeFile(dir + "/u.bit", text) catch e {
    failCase("cannot write u.bit: " + e.message())
    return
  }
  let uri = "file://" + dir + "/u.bit"
  // line 1 "  let z = totallyUndefinedFn(1, 2)": char 29 is right after `(`.
  let payload = initReq() + initNotif() + didOpen(uri, text) + sigHelpReq(2, uri, 1, 29)
  let (out, ok) = runLsp(bin, dir, payload)
  if (!ok) {
    return
  }
  let tail = resultTail(out, "\"id\":2,\"result\":")
  if (!contains(tail, "null")) {
    failCase("undefined-callee signatureHelp: expected a null result, got\n" + tail)
    return
  }
  print("PASS lspsignaturehelp: an unresolved callee answers null rather than crashing\n")
}

fn main() {
  let bin = envOr("BIT", "bit-out/bin/bit")
  if (!exists(bin)) {
    failCase("BIT='${bin}' does not exist — refusing to guess")
    return
  }
  let scratchRoot = envOr("TMPDIR", "/tmp") + "/bit-lspsignaturehelp-${timeUnixNs()}"
  mkdirQuiet(scratchRoot)
  checkSignatureHelpCapability(bin, scratchRoot)
  checkSignatureHelpAcceptance(bin, scratchRoot)
  checkSignatureHelpActiveParameter(bin, scratchRoot)
  checkSignatureHelpZeroArgs(bin, scratchRoot)
  checkSignatureHelpNestedCall(bin, scratchRoot)
  checkSignatureHelpUnclosedNestedCall(bin, scratchRoot)
  checkSignatureHelpUnresolvedCallee(bin, scratchRoot)
  print("lspsignaturehelp: all scenarios passed\n")
}
