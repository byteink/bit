// tests/bit/pmrangegate.bit — end-to-end gate for version-RANGE resolution
// through the real dispatched `bit` CLI (#2369, epic #2362). The sibling of
// tests/bit/pmaddgit.bit/pmvanity.bit (direct/vanity `bit add`) and
// tests/bit/pmimports.bit (warm-cache imports): none of those, and no
// in-process unit check in compiler/pmzclicheck.bit (which calls
// `upDependencies` directly, never through `main.bit`'s command dispatch or
// an observable exit code), drives `^`/`~` resolution or a PubGrub conflict
// through a real subprocess. That gap is why #3631 ("bit up wipes a caret
// dependency's recorded version") went unnoticed even though it was already
// fixed: the one check that exercised the caret/tilde `bit up` path was
// in-process and, at the time, asserted only `.commit`, never `.version`.
//
// Three scenarios, each a real `bit` subprocess against a local `file://` git
// fixture, none of it reaching the network:
//
//  1. `checkCaretResolutionAndUp` — `bit add name@^1.0.0` against a fixture
//     tagged 1.0.0/1.2.0/2.0.0 resolves to 1.2.0 (2.0.0 excluded by the
//     caret's own upper bound), the fetched package builds and runs, and a
//     following `bit up` with nothing new published leaves both fields
//     unchanged.
//  2. `checkUnsatisfiableConflict` — two real fetched packages ("depa",
//     whose own bit.json pins a third package "thirdparty" at an exact
//     v2.0.0, and a direct `bit add thirdparty@^1.0.0` that only has v1.0.0
//     to resolve to) drive `resolvePubGrub` (compiler/pmresolve.bit) to a
//     genuine, structured failure via `checkVersionConflict`
//     (compiler/pmz.bit) — asserted on the EXACT stderr text, not merely a
//     nonzero exit, and that neither bit.lock nor bit.json gained any debris.
//  3. `checkBitUpMovesToPublishedVersion` — locks at 1.0.0 under `^1.0.0`,
//     publishes 1.2.0 to the SAME fixture, then `bit up` moves both
//     `.commit` and `.version` while `bit.json` stays byte-identical — the
//     exact shape #3631 was filed against.
//
// `checkNeighboringConstraintKinds` covers the other four ref forms this
// ticket asks about, reusing scenario 1's fixture: an exact pin (`@v1.0.0`),
// a tilde (`@~1.0.0`, whose narrower upper bound also picks 1.0.0, proving
// tilde and caret are not the same range), a branch (`@main`, the moving tip)
// and a bare 40-hex commit sha. Each is asserted on `bit.lock`'s
// `commit`/`version` fields only — no build+run and no `bit up` follow-on for
// these four, since scenario 1 already proves the build+run and up-survives
// paths end to end and repeating them four more times buys nothing new.
// Deliberately NOT covered: an ssh:// spec and a vanity name — both already
// have their own dedicated gates (pmclicheck.bit's ssh-url check,
// pmvanity.bit) and neither is a distinct RANGE-resolution path.
//
// `bit up` has no `--url` override (compiler/pmcliup.bit's own module
// comment: it refreshes whatever `bit.lock` already recorded), so every `bit
// up` call below runs under a scoped `GIT_CONFIG_GLOBAL` carrying one
// `url.<file-path>.insteadOf <https-url>` rule (the same mechanism
// tests/bit/pmvanity.bit uses for its git fetch) rather than a CLI flag.
//
// Wrapper scripts run via `osRun("/bin/sh", [scriptPath])`, never exec'd
// directly (#3680, #3681): a freshly-written executable file pays a ~15-26s
// macOS first-exec security-scan penalty that a script merely READ by
// `/bin/sh` never triggers. Since `osRun` (unlike `osRunBounded`) has no
// built-in deadline, the wall-clock bound is embedded in the script itself —
// background the body, race a `sleep`-then-`kill -9` watcher against it,
// exit 124 on timeout — the identical shape compiler/pmfetchtail.bit's
// `runGit` already uses.
//
// ANTI-VACUITY RULES (identical to every tests/bit/*.bit sibling's own —
// restated here because each such file is its own standalone compilation
// unit and cannot import another):
//
//  - Nothing is ever SKIPPED. A missing `git` is a loud failure naming it
//    (`rcGitAbsent`), never an early return.
//  - Exit codes are compared EXACTLY (`== 0`, `== 1`), never `!= 0`.
//  - The wrapper script reserves 111-114/121/124 for its OWN failures, and
//    those are rejected before any verdict is read.
//  - Capture files must EXIST before they are read.
//  - stdout AND stderr are compared with exact equality, never `contains`,
//    for the conflict scenario's diagnostic — a resolver that fails with a
//    useless message is exactly the bug this gate exists to catch.
//  - The fixture HEAD is checked to be 40 hex digits before use, and every
//    fixture carries at least one ANNOTATED tag (`git tag -a`), asserted via
//    `git cat-file -t` (#2064's own bug class: a lightweight-tag fixture
//    sails straight past the peeling bug this must catch).
import { exists, readFile, remove, writeFile } from "std/fs"
import { envOr, exit } from "std/os"
import { base as pathBase, dir as pathDir } from "std/path"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { Json, jsonGet, jsonAsString, jsonParse } from "std/json"

const subprocessTimeoutMs: int = 120000

// Wrapper-reserved exit codes — a harness break, never the compiler under
// test disagreeing. 124 is this file's own timeout sentinel (`runScript`'s
// script body), matching `runGit`'s convention now that wrapper scripts run
// through unbounded `osRun` with their own embedded deadline.
const rcCdFailed: int = 111
const rcBitNotExecutable: int = 112
const rcStdlibUnresolvable: int = 113
const rcBitDirUnresolvable: int = 114
const rcGitAbsent: int = 121
const rcTimedOut: int = 124

const gitHost: string = "github.com"
const owner: string = "pmresolvegate"

class Run { code: int, stdout: string, stderr: string }

// The git fixture's on-disk location and isolated git identity, bundled per
// spec/LINT.md's E0202 guidance (past ~5 params, they want to be a class).
class FixtureCtx { root: string, srcDir: string, home: string, noConfigPath: string }

// One fresh scratch project plus the compiler/stdlib under test and a name
// for diagnostics — bundled so `runBitCli` and every scenario helper below
// take one parameter instead of five (E0202).
class CliCtx { name: string, bitExe: string, stdRoot: string, projDir: string, cacheRoot: string, home: string }

// One neighboring-constraint-kind case for `checkOneRef` (E0202: this used
// to be 5 positional params).
class NeighborCase { label: string, ref: string, wantVersion: string, wantCommit: string, checkCommit: bool }

class Snapshot { lock: string, json: string }

fn main() {
  let bitExe = envOr("BIT_UNDER_TEST", "bit-out/bin/bit")
  let stdRoot = envOr("BIT_STDLIB_UNDER_TEST", "stdlib")
  if (!exists(bitExe)) {
    fatal("setup", "no compiler under test at '${bitExe}' — run from the repo root, or set BIT_UNDER_TEST")
  }
  if (!exists(stdRoot)) {
    fatal("setup", "no stdlib at '${stdRoot}' — run from the repo root, or set BIT_STDLIB_UNDER_TEST")
  }

  let (rangeCtx, sha100) = checkCaretResolutionAndUp(bitExe, stdRoot)
  print("PASS: pmrangegate — caret resolution picks the highest in-range tag, builds+runs, and survives a no-op bit up\n")

  checkNeighboringConstraintKinds(bitExe, stdRoot, rangeCtx, sha100)
  print("PASS: pmrangegate — exact/tilde/branch/sha refs each resolve bit.lock's commit/version correctly\n")

  checkUnsatisfiableConflict(bitExe, stdRoot)
  print("PASS: pmrangegate — two packages requiring incompatible versions of a third fail loudly, naming both and the disputed package\n")

  checkBitUpMovesToPublishedVersion(bitExe, stdRoot)
  print("PASS: pmrangegate — bit up moves both commit and version to a newly published in-range tag; bit.json stays byte-identical (#3631)\n")
}

// ---- scenario 1: caret resolution + surviving a no-op bit up -------------

// Returns the fixture context (reused by `checkNeighboringConstraintKinds`)
// and the 1.0.0 tag's own sha (needed for the sha-ref neighbor check).
fn checkCaretResolutionAndUp(bitExe: string, stdRoot: string): (FixtureCtx, string) {
  let name = "caret-resolve"
  let root = scratchRoot("caret")
  let ctx = newFixtureCtx(root, "caretpkg")
  gitInitRepo(ctx)
  let (sha100, sha120) = buildCaretTags(ctx)
  assertAnnotatedTag(name, ctx, "v1.2.0")

  let cli = newProjectCli(name, bitExe, stdRoot, root, "main")
  addCaretDependency(cli, ctx, sha120)
  buildAndRunCaretProgram(cli)
  verifyNoOpBitUp(cli, ctx, sha120)
  return ctx, sha100
}

// Three commits, three ANNOTATED tags (1.0.0/1.2.0/2.0.0), each with
// DIFFERENT content — so a wrong pick fails on its printed stdout, not just
// silently building. Returns (sha of 1.0.0, sha of 1.2.0); the 2.0.0 sha is
// intentionally discarded — only its presence-and-exclusion matters here.
fn buildCaretTags(ctx: FixtureCtx): (string, string) {
  writeFile(ctx.srcDir + "/greet.bit", greetSrc("1.0.0")) catch e {
    fatal("caret-resolve", "cannot write fixture module: " + e.message())
  }
  let sha100 = commitAndTag(ctx, "v1.0.0", "v1.0.0")
  writeFile(ctx.srcDir + "/greet.bit", greetSrc("1.2.0")) catch e {
    fatal("caret-resolve", "cannot write fixture module: " + e.message())
  }
  let sha120 = commitAndTag(ctx, "v1.2.0", "v1.2.0")
  writeFile(ctx.srcDir + "/greet.bit", greetSrc("2.0.0")) catch e {
    fatal("caret-resolve", "cannot write fixture module: " + e.message())
  }
  let _ = commitAndTag(ctx, "v2.0.0", "v2.0.0")
  return sha100, sha120
}

fn greetSrc(version: string): string {
  return "export fn greet(): string {\n  return \"hi from caretpkg ${version}\\n\"\n}\n"
}

fn addCaretDependency(cli: CliCtx, ctx: FixtureCtx, sha120: string) {
  let spec = "${gitHost}/${owner}/caretpkg@^1.0.0"
  let addResult = runBitCli(cli, ["HOME=" + cli.home],
    ["add", spec, "--url", "file://${ctx.srcDir}"], cli.projDir + "/add.out", cli.projDir + "/add.err")
  if (addResult.code != 0) {
    fatal(cli.name, "`bit add ${spec}` exited ${addResult.code}, want 0\n  stderr: ${addResult.stderr}")
  }
  let expectedAdd = "bit add: caretpkg -> ${spec} (${sha120})\n"
  if (addResult.stdout != expectedAdd) {
    fatal(cli.name, "bit add stdout was '${addResult.stdout}', want exactly '${expectedAdd}'")
  }
  let lock1 = readLockEntry(cli.name, cli.projDir, "caretpkg")
  assertJsonString(cli.name, "bit.lock caretpkg", lock1, "commit", sha120)
  assertJsonString(cli.name, "bit.lock caretpkg", lock1, "version", "1.2.0")
}

fn buildAndRunCaretProgram(cli: CliCtx) {
  writeFile(cli.projDir + "/main.bit",
    "import { greet } from \"caretpkg\"\nfn main() {\n  print(greet())\n}\n") catch e {
    fatal(cli.name, "cannot write main.bit: " + e.message())
  }
  let runResult = runBitCli(cli, []string(0), ["run", "main.bit"], cli.projDir + "/run.out", cli.projDir + "/run.err")
  if (runResult.code != 0) {
    fatal(cli.name, "`bit run main.bit` exited ${runResult.code}, want 0\n  stderr: ${runResult.stderr}")
  }
  if (runResult.stdout != "hi from caretpkg 1.2.0\n") {
    fatal(cli.name, "bit run stdout was '${runResult.stdout}', want exactly 'hi from caretpkg 1.2.0\\n'")
  }
}

fn verifyNoOpBitUp(cli: CliCtx, ctx: FixtureCtx, sha120: string) {
  let rewritePath = writeInsteadOfConfig(cli, ctx.srcDir, "caretpkg")
  let upEnv = ["HOME=" + cli.home, "GIT_CONFIG_GLOBAL=" + rewritePath, "GIT_CONFIG_SYSTEM=/dev/null"]
  let upResult = runBitCli(cli, upEnv, ["up"], cli.projDir + "/up.out", cli.projDir + "/up.err")
  if (upResult.code != 0) {
    fatal(cli.name, "`bit up` exited ${upResult.code}, want 0\n  stderr: ${upResult.stderr}")
  }
  let expectedUp = "bit up: caretpkg -> ^1.0.0 (${sha120})\n"
  if (upResult.stdout != expectedUp) {
    fatal(cli.name, "bit up stdout was '${upResult.stdout}', want exactly '${expectedUp}'")
  }
  let lock2 = readLockEntry(cli.name, cli.projDir, "caretpkg")
  assertJsonString(cli.name, "bit.lock caretpkg (after up)", lock2, "commit", sha120)
  assertJsonString(cli.name, "bit.lock caretpkg (after up)", lock2, "version", "1.2.0")
}

// ---- neighboring constraint kinds: exact, tilde, branch, sha -------------

// Each ref is added into its OWN fresh project+cache under `ctx.root`, so
// none of these interacts with scenario 1's own already-populated lock or
// with each other. All four reuse `ctx`'s already-built, already-tagged
// fixture: no further git operations are needed.
fn checkNeighboringConstraintKinds(bitExe: string, stdRoot: string, ctx: FixtureCtx, sha100: string) {
  // Exact pin: resolves to exactly 1.0.0, written back canonicalised (#2367:
  // no `v` prefix), even though the tag itself is `v1.0.0`.
  checkOneRef(bitExe, stdRoot, ctx,
    NeighborCase{ label: "exact", ref: "v1.0.0", wantVersion: "1.0.0", wantCommit: sha100, checkCommit: true })
  // Tilde: `~1.0.0` is `>=1.0.0 <1.1.0` (compiler/pmversion.bit), a NARROWER
  // range than caret's `^1.0.0` — both fixtures share tags 1.0.0/1.2.0/2.0.0,
  // so a tilde resolving to 1.0.0 while caret (scenario 1) resolved to 1.2.0
  // is proof the two operators are not being conflated.
  checkOneRef(bitExe, stdRoot, ctx,
    NeighborCase{ label: "tilde", ref: "~1.0.0", wantVersion: "1.0.0", wantCommit: sha100, checkCommit: true })
  // Branch: not a version at all — resolves to whatever "main" currently
  // points at (the LAST commit made, tagged v2.0.0), and bit.lock's
  // `version` key is omitted entirely (`lockAddEntry`'s own "only when
  // non-empty" rule), never written as "".
  checkOneRef(bitExe, stdRoot, ctx,
    NeighborCase{ label: "branch", ref: "main", wantVersion: "", wantCommit: "", checkCommit: false })
  // Bare 40-hex commit sha: also not a version. Pins the FIRST commit
  // (sha100) directly, proving a sha ref is never treated as "the tip".
  checkOneRef(bitExe, stdRoot, ctx,
    NeighborCase{ label: "sha", ref: sha100, wantVersion: "", wantCommit: sha100, checkCommit: false })
}

fn checkOneRef(bitExe: string, stdRoot: string, ctx: FixtureCtx, nc: NeighborCase) {
  let name = "neighbor-" + nc.label
  let cli = newProjectCli(name, bitExe, stdRoot, ctx.root, nc.label)
  let spec = "${gitHost}/${owner}/caretpkg@${nc.ref}"
  let r = runBitCli(cli, []string(0),
    ["add", spec, "--url", "file://${ctx.srcDir}"], cli.projDir + "/add.out", cli.projDir + "/add.err")
  if (r.code != 0) {
    fatal(name, "`bit add ${spec}` exited ${r.code}, want 0\n  stderr: ${r.stderr}")
  }
  let entry = readLockEntry(name, cli.projDir, "caretpkg")
  if (nc.checkCommit) {
    assertJsonString(name, "bit.lock caretpkg", entry, "commit", nc.wantCommit)
  }
  if (len(nc.wantVersion) > 0) {
    assertJsonString(name, "bit.lock caretpkg", entry, "version", nc.wantVersion)
  } else {
    assertNoKey(name, "bit.lock caretpkg", entry, "version")
  }
}

// ---- scenario 2: an unsatisfiable conflict fails loudly ------------------

// "depa" (one commit, tagged v1.0.0) whose own bit.json requires
// "thirdparty" at an EXACT v2.0.0; "thirdparty" itself (tagged v1.0.0 and
// v2.0.0). Adding depa locks thirdparty@v2.0.0 transitively
// (compiler/pmz.bit's `resolveTransitiveDeps`) with no conflict — it is the
// only stated requirement so far. A direct `bit add thirdparty@^1.0.0` next
// can only resolve within [1.0.0, 2.0.0), i.e. exactly v1.0.0 (2.0.0 is
// excluded by the caret's own upper bound AND is the version already locked
// via depa) — genuinely incompatible with depa's exact pin, and
// `checkVersionConflict` must refuse it rather than silently overwriting
// either requirement.
fn checkUnsatisfiableConflict(bitExe: string, stdRoot: string) {
  let root = scratchRoot("conflict")
  let (tp, depa, depaSha) = buildConflictFixtures(root)

  let cli = newProjectCli("conflict", bitExe, stdRoot, root, "main")
  let rewritePath = addDepaDependency(cli, tp, depa)
  let before = snapshotProject(cli)
  let addTp = addConflictingThirdparty(cli, tp, rewritePath)
  assertConflictResult(cli, depaSha, addTp, before)
}

fn buildConflictFixtures(root: string): (FixtureCtx, FixtureCtx, string) {
  let tp = newFixtureCtx(root, "thirdparty")
  gitInitRepo(tp)
  writeFile(tp.srcDir + "/a.txt", "v1\n") catch e {
    fatal("conflict", "cannot write thirdparty fixture: " + e.message())
  }
  let _ = commitAndTag(tp, "v1.0.0", "v1.0.0")
  writeFile(tp.srcDir + "/a.txt", "v2\n") catch e {
    fatal("conflict", "cannot write thirdparty fixture: " + e.message())
  }
  let _ = commitAndTag(tp, "v2.0.0", "v2.0.0")
  assertAnnotatedTag("conflict", tp, "v2.0.0")

  let depa = newFixtureCtx(root, "depa")
  gitInitRepo(depa)
  writeFile(depa.srcDir + "/bit.json",
    "{\"dependencies\":{\"thirdparty\":\"${gitHost}/${owner}/thirdparty@v2.0.0\"}}") catch e {
    fatal("conflict", "cannot write depa manifest: " + e.message())
  }
  let depaSha = commitAndTag(depa, "depa v1.0.0", "v1.0.0")
  return tp, depa, depaSha
}

// depa's OWN transitive requirement on "thirdparty" has no `--url` escape
// hatch (that flag only overrides the ROOT spec's fetch) — it must resolve
// to a fetchable URL on its own, via an `insteadOf` rewrite. Returns the
// rewrite config path so the second (conflicting) add can reuse it.
fn addDepaDependency(cli: CliCtx, tp: FixtureCtx, depa: FixtureCtx): string {
  let rewritePath = writeInsteadOfConfig(cli, tp.srcDir, "thirdparty")
  let env = ["HOME=" + cli.home, "GIT_CONFIG_GLOBAL=" + rewritePath, "GIT_CONFIG_SYSTEM=/dev/null"]
  let addDepa = runBitCli(cli, env,
    ["add", "${gitHost}/${owner}/depa@v1.0.0", "--url", "file://${depa.srcDir}"],
    cli.projDir + "/depa.out", cli.projDir + "/depa.err")
  if (addDepa.code != 0) {
    fatal(cli.name, "`bit add depa` exited ${addDepa.code}, want 0\n  stderr: ${addDepa.stderr}")
  }
  return rewritePath
}

fn addConflictingThirdparty(cli: CliCtx, tp: FixtureCtx, rewritePath: string): Run {
  let env = ["HOME=" + cli.home, "GIT_CONFIG_GLOBAL=" + rewritePath, "GIT_CONFIG_SYSTEM=/dev/null"]
  return runBitCli(cli, env,
    ["add", "${gitHost}/${owner}/thirdparty@^1.0.0", "--url", "file://${tp.srcDir}"],
    cli.projDir + "/tp.out", cli.projDir + "/tp.err")
}

fn assertConflictResult(cli: CliCtx, depaSha: string, addTp: Run, before: Snapshot) {
  if (addTp.code != 1) {
    fatal(cli.name, "`bit add thirdparty@^1.0.0` exited ${addTp.code}, want exactly 1\n  stdout: ${addTp.stdout}  stderr: ${addTp.stderr}")
  }
  if (addTp.stdout != "") {
    fatal(cli.name, "conflicting bit add printed stdout '${addTp.stdout}', want none")
  }
  // The whole reason PubGrub was chosen over a bare "no version satisfies"
  // message (compiler/pmresolve.bit's own module header): the diagnostic
  // must name BOTH conflicting requirements (v2.0.0, v1.0.0) and the
  // disputed package (thirdparty) — pinned exactly, not merely `contains`.
  let wantErr = "bit add: pmcli: thirdparty conflicts: depa requires v2.0.0; root requires v1.0.0;\n"
  if (addTp.stderr != wantErr) {
    fatal(cli.name, "conflict stderr was '${addTp.stderr}', want exactly '${wantErr}'")
  }
  // No debris: a failed add must leave bit.lock/bit.json exactly as they
  // were, never a half-applied entry for "thirdparty" at the wrong version.
  let after = snapshotProject(cli)
  if (after.lock != before.lock) {
    fatal(cli.name, "bit.lock changed after a failed add")
  }
  if (after.json != before.json) {
    fatal(cli.name, "bit.json changed after a failed add")
  }
  if (!isFullSha(depaSha)) {
    fatal(cli.name, "internal: depa fixture sha is not 40-hex: '${depaSha}'")
  }
}

// ---- scenario 3: bit up moves to a newly published version (#3631) ------

fn checkBitUpMovesToPublishedVersion(bitExe: string, stdRoot: string) {
  let name = "up-moves"
  let root = scratchRoot("up")
  let ctx = newFixtureCtx(root, "uppkg")
  gitInitRepo(ctx)
  writeFile(ctx.srcDir + "/a.txt", "v1\n") catch e {
    fatal(name, "cannot write fixture: " + e.message())
  }
  let sha1 = commitAndTag(ctx, "v1.0.0", "v1.0.0")
  assertAnnotatedTag(name, ctx, "v1.0.0")

  let cli = newProjectCli(name, bitExe, stdRoot, root, "main")
  addUppkgDependency(cli, ctx, sha1)
  let bitJsonBefore = readFileMust(cli.name, cli.projDir + "/bit.json")

  // Publish 1.2.0 to the SAME fixture repository — simulating an upstream
  // release made after this project first locked.
  let sha2 = publishNewUppkgVersion(ctx, sha1)
  verifyUpMovesVersion(cli, ctx, sha2, bitJsonBefore)
}

fn addUppkgDependency(cli: CliCtx, ctx: FixtureCtx, sha1: string) {
  let spec = "${gitHost}/${owner}/uppkg@^1.0.0"
  let addResult = runBitCli(cli, ["HOME=" + cli.home],
    ["add", spec, "--url", "file://${ctx.srcDir}"], cli.projDir + "/add.out", cli.projDir + "/add.err")
  if (addResult.code != 0) {
    fatal(cli.name, "`bit add ${spec}` exited ${addResult.code}, want 0\n  stderr: ${addResult.stderr}")
  }
  let lock1 = readLockEntry(cli.name, cli.projDir, "uppkg")
  assertJsonString(cli.name, "bit.lock uppkg", lock1, "commit", sha1)
  assertJsonString(cli.name, "bit.lock uppkg", lock1, "version", "1.0.0")
}

fn publishNewUppkgVersion(ctx: FixtureCtx, sha1: string): string {
  writeFile(ctx.srcDir + "/a.txt", "v1.2\n") catch e {
    fatal("up-moves", "cannot advance fixture: " + e.message())
  }
  let sha2 = commitAndTag(ctx, "v1.2.0", "v1.2.0")
  if (sha2 == sha1) {
    fatal("up-moves", "internal: publishing a new tag did not move the fixture's HEAD")
  }
  return sha2
}

fn verifyUpMovesVersion(cli: CliCtx, ctx: FixtureCtx, sha2: string, bitJsonBefore: string) {
  let rewritePath = writeInsteadOfConfig(cli, ctx.srcDir, "uppkg")
  let upEnv = ["HOME=" + cli.home, "GIT_CONFIG_GLOBAL=" + rewritePath, "GIT_CONFIG_SYSTEM=/dev/null"]
  let upResult = runBitCli(cli, upEnv, ["up"], cli.projDir + "/up.out", cli.projDir + "/up.err")
  if (upResult.code != 0) {
    fatal(cli.name, "`bit up` exited ${upResult.code}, want 0\n  stderr: ${upResult.stderr}")
  }
  let expectedUp = "bit up: uppkg -> ^1.0.0 (${sha2})\n"
  if (upResult.stdout != expectedUp) {
    fatal(cli.name, "bit up stdout was '${upResult.stdout}', want exactly '${expectedUp}'")
  }
  // The #3631 hole this ticket closes: both fields, not just `.commit`.
  let lock2 = readLockEntry(cli.name, cli.projDir, "uppkg")
  assertJsonString(cli.name, "bit.lock uppkg (after up)", lock2, "commit", sha2)
  assertJsonString(cli.name, "bit.lock uppkg (after up)", lock2, "version", "1.2.0")
  let bitJsonAfter = readFileMust(cli.name, cli.projDir + "/bit.json")
  if (bitJsonAfter != bitJsonBefore) {
    fatal(cli.name, "bit.json changed after a plain bit up")
  }
}

// ---- the git fixture ------------------------------------------------------

fn newFixtureCtx(root: string, label: string): FixtureCtx {
  let srcDir = root + "/" + label
  mkdirp("fixture", srcDir)
  let home = root + "/" + label + "-home"
  mkdirp("fixture", home)
  let noConfigPath = root + "/" + label + "-noconfig"
  writeFile(noConfigPath, "") catch e {
    fatal("fixture", "cannot write git isolation config: " + e.message())
  }
  return FixtureCtx{ root: root, srcDir: srcDir, home: home, noConfigPath: noConfigPath }
}

// Scoped away from the operator's real `~/.gitconfig` (this fleet sets
// `tag.gpgsign true`), so every tag below is unsigned and deterministic
// regardless of what machine runs this gate.
fn gitInitRepo(ctx: FixtureCtx) {
  let q = shQuote(ctx.srcDir)
  let script = "set -e\n" +
    "command -v git > /dev/null 2>&1 || exit ${rcGitAbsent}\n" +
    "export HOME=" + shQuote(ctx.home) + "\n" +
    "export GIT_CONFIG_GLOBAL=" + shQuote(ctx.noConfigPath) + "\n" +
    "export GIT_CONFIG_SYSTEM=/dev/null\n" +
    "git init --quiet -b main " + q + "\n" +
    "git -C " + q + " config user.email pmrangegate@example.com\n" +
    "git -C " + q + " config user.name pmrangegate\n"
  mustSucceed("fixture", "git init", script)
}

// Commits whatever files are currently on disk in `ctx.srcDir` (the caller
// writes them first) and tags the result ANNOTATED (`-a`) — never
// lightweight (#2064's own bug class: `resolveDependencyRef` must peel
// `<ref>^{}` rather than the tag object's own sha). `--no-sign`/
// `--no-gpg-sign` sidestep `tag.gpgsign true`, set globally on this fleet.
// Returns the new commit's own 40-hex sha.
fn commitAndTag(ctx: FixtureCtx, msg: string, tag: string): string {
  let q = shQuote(ctx.srcDir)
  let shaPath = ctx.root + "/head-" + uuidFormat(uuidV4())
  let script = "set -e\n" +
    "export HOME=" + shQuote(ctx.home) + "\n" +
    "export GIT_CONFIG_GLOBAL=" + shQuote(ctx.noConfigPath) + "\n" +
    "export GIT_CONFIG_SYSTEM=/dev/null\n" +
    "git -C " + q + " add -A\n" +
    "git -C " + q + " commit --quiet --no-gpg-sign -m " + shQuote(msg) + "\n" +
    "git -C " + q + " tag -a " + shQuote(tag) + " --no-sign -m " + shQuote(tag) + "\n" +
    "git -C " + q + " rev-parse HEAD > " + shQuote(shaPath) + "\n"
  mustSucceed("fixture", "commit+tag ${tag}", script)
  let sha = trimEol(readFile(shaPath) catch e {
    fatal("fixture", "cannot read fixture HEAD: " + e.message())
    ""
  })
  if (!isFullSha(sha)) {
    fatal("fixture", "fixture HEAD is not a 40-hex commit sha after tagging ${tag}: '${sha}'")
  }
  return sha
}

fn assertAnnotatedTag(name: string, ctx: FixtureCtx, tag: string) {
  let q = shQuote(ctx.srcDir)
  let typePath = ctx.root + "/tagtype-" + uuidFormat(uuidV4())
  let script = "export HOME=" + shQuote(ctx.home) + "\n" +
    "export GIT_CONFIG_GLOBAL=" + shQuote(ctx.noConfigPath) + "\n" +
    "export GIT_CONFIG_SYSTEM=/dev/null\n" +
    "git -C " + q + " cat-file -t refs/tags/" + tag + " > " + shQuote(typePath) + "\n"
  mustSucceed(name, "checking tag ${tag} is annotated", script)
  let tagType = trimEol(readFile(typePath) catch e {
    fatal(name, "cannot read fixture tag type: " + e.message())
    ""
  })
  if (tagType != "tag") {
    fatal(name, "fixture tag ${tag} is not annotated: got '${tagType}', want 'tag'")
  }
}

fn scratchRoot(label: string): string {
  return envOr("TMPDIR", "/tmp") + "/bit-pmrangegate-" + label + "-" + uuidFormat(uuidV4())
}

// A fresh project directory + cache root + scratch HOME under `root`, keyed
// by `label` so scenario 1's own "main" project and each neighbor-kind
// project never collide when they share the same fixture root.
fn newProjectCli(name: string, bitExe: string, stdRoot: string, root: string, label: string): CliCtx {
  let projDir = root + "/" + label + "-proj"
  let cacheRoot = root + "/" + label + "-cache"
  let home = root + "/" + label + "-cli-home"
  mkdirp(name, projDir)
  mkdirp(name, home)
  writeFile(projDir + "/bit.json", "{}\n") catch e {
    fatal(name, "cannot write bit.json: " + e.message())
  }
  return CliCtx{ name: name, bitExe: bitExe, stdRoot: stdRoot, projDir: projDir, cacheRoot: cacheRoot, home: home }
}

// `bit up` has no `--url` override, so redirecting a fetch it owns needs a
// plain git `insteadOf` rewrite of the `https://` URL bit.lock already
// records for `repo` — the same mechanism tests/bit/pmvanity.bit uses.
fn writeInsteadOfConfig(cli: CliCtx, localDir: string, repo: string): string {
  let path = cli.cacheRoot + "-rewrite.gitconfig"
  let httpsUrl = "https://${gitHost}/${owner}/${repo}.git"
  writeFile(path, "[url \"file://${localDir}\"]\n\tinsteadOf = ${httpsUrl}\n") catch e {
    fatal(cli.name, "cannot write git insteadOf config: " + e.message())
  }
  return path
}

// ---- bit.lock / bit.json verification -------------------------------------

fn snapshotProject(cli: CliCtx): Snapshot {
  return Snapshot{
    lock: readFileMust(cli.name, cli.projDir + "/bit.lock"),
    json: readFileMust(cli.name, cli.projDir + "/bit.json"),
  }
}

// Reads `projDir/bit.lock` through the real JSON parser and returns the one
// entry named `depName` — never a substring search, which an empty or
// truncated file could also satisfy.
fn readLockEntry(name: string, projDir: string, depName: string): Json {
  let text = readFileMust(name, projDir + "/bit.lock")
  let doc = jsonParse(text) catch e {
    fatal(name, "cannot parse bit.lock: " + e.message())
    Json.JsonNull
  }
  let v = jsonGet(doc, depName)
  if (!isSome(v)) {
    fatal(name, "bit.lock has no '${depName}' entry")
  }
  return unwrap(v)
}

fn assertJsonString(name: string, what: string, container: Json, key: string, want: string) {
  let v = jsonGet(container, key)
  if (!isSome(v)) {
    fatal(name, "${what} has no '${key}' field")
  }
  let s = jsonAsString(unwrap(v))
  if (!isSome(s)) {
    fatal(name, "${what}'s '${key}' field is not a JSON string")
  }
  let got = unwrap(s)
  if (got != want) {
    fatal(name, "${what}'s '${key}' field is '${got}', want '${want}'")
  }
}

fn assertNoKey(name: string, what: string, container: Json, key: string) {
  let v = jsonGet(container, key)
  if (isSome(v)) {
    fatal(name, "${what} unexpectedly has a '${key}' key")
  }
}

fn readFileMust(name: string, path: string): string {
  if (!exists(path)) {
    fatal(name, "expected file does not exist: ${path}")
  }
  return readFile(path) catch e {
    fatal(name, "cannot read ${path}: " + e.message())
    ""
  }
}

// ---- driving the CLI -------------------------------------------------------

// Runs `<ctx.bitExe> <args...>` with `ctx.projDir` as its working directory
// and a SEALED environment (`/usr/bin/env -i`), plus `extraEnv` — the same
// shape tests/bit/pmvanity.bit's/pmaddgit.bit's own `runBitCli` use, bundled
// into one `CliCtx` parameter (E0202: this used to be 9 positional params).
fn runBitCli(ctx: CliCtx, extraEnv: []string, args: []string, outPath: string, errPath: string): Run {
  let cmd = "\"$BIT\""
  let i = 0
  while (i < len(args)) {
    cmd = cmd + " " + shQuote(args[i])
    i = i + 1
  }
  let extra = ""
  let j = 0
  while (j < len(extraEnv)) {
    let eq = indexOfByte(extraEnv[j], '=')
    if (eq >= 0) {
      extra = extra + " " + extraEnv[j][0:eq] + "=" + shQuote(extraEnv[j][eq + 1:len(extraEnv[j])])
    }
    j = j + 1
  }
  let body = "BITDIR=$(cd " + shQuote(pathDir(ctx.bitExe)) + " && pwd) || exit ${rcBitDirUnresolvable}\n" +
    "BIT=\"$BITDIR\"/" + shQuote(pathBase(ctx.bitExe)) + "\n" +
    "[ -x \"$BIT\" ] || exit ${rcBitNotExecutable}\n" +
    "STD=$(cd " + shQuote(ctx.stdRoot) + " && pwd) || exit ${rcStdlibUnresolvable}\n" +
    "cd " + shQuote(ctx.projDir) + " || exit ${rcCdFailed}\n" +
    "exec /usr/bin/env -i" +
    " PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin" +
    " TMPDIR=/tmp BIT_STDLIB=\"$STD\" BIT_PKG_CACHE=" + shQuote(ctx.cacheRoot) + extra + " " +
    cmd + " > " + shQuote(outPath) + " 2> " + shQuote(errPath)
  let code = runScript(ctx.name, body)
  rejectWrapperFailure(ctx.name, code)
  if (!exists(outPath) || !exists(errPath)) {
    fatal(ctx.name, "the wrapper exited ${code} without creating its capture files — it never launched the compiler")
  }
  let out = readFileMust(ctx.name, outPath)
  let err = readFileMust(ctx.name, errPath)
  return Run{ code: code, stdout: out, stderr: err }
}

// Every code the wrapper reserves for its own breakage, plus the two
// `/bin/sh` reserves for "found but not executable"/"not found" — none of
// them can be the compiler's own verdict.
fn rejectWrapperFailure(name: string, code: int) {
  if (code < 0) {
    fatal(name, "the wrapper script could not be launched")
  }
  if (code == rcTimedOut) {
    fatal(name, "subprocess TIMED OUT after ${subprocessTimeoutMs}ms — a hang is a failure, not a stall")
  }
  if (code == rcCdFailed) {
    fatal(name, "wrapper: cd into the project directory failed")
  }
  if (code == rcBitNotExecutable) {
    fatal(name, "wrapper: the compiler under test is not executable")
  }
  if (code == rcStdlibUnresolvable) {
    fatal(name, "wrapper: the stdlib root could not be resolved to an absolute path")
  }
  if (code == rcBitDirUnresolvable) {
    fatal(name, "wrapper: the compiler's directory could not be resolved to an absolute path")
  }
  if (code == 126) {
    fatal(name, "wrapper: /bin/sh reported a command found but not executable (126)")
  }
  if (code == 127) {
    fatal(name, "wrapper: /bin/sh reported a command not found (127) — the compiler never ran")
  }
}

// ---- shell/timeout plumbing ------------------------------------------------

// Runs `body` under a wall-clock deadline by backgrounding it as one subshell
// job and racing a `sleep`-then-`kill -9` watcher against it — the same
// shape compiler/pmfetchtail.bit's `runGit` uses, invoked through
// `osRun("/bin/sh", [scriptPath])` rather than exec'd directly (see this
// file's own header for why). Returns the body's own exit code, or
// `rcTimedOut` (124) if the watcher fired first.
fn runScript(name: string, body: string): int {
  let path = envOr("TMPDIR", "/tmp") + "/bit-pmrangegate-" + uuidFormat(uuidV4()) + ".sh"
  let secs = subprocessTimeoutMs / 1000
  let script = "#!/bin/sh\n(\n" + body + "\n) &\n" +
    "child=$!\n" +
    "( sleep ${secs}; kill -9 \"$child\" 2>/dev/null ) &\n" +
    "watcher=$!\n" +
    "wait \"$child\" 2>/dev/null\n" +
    "status=$?\n" +
    "if kill -0 \"$watcher\" 2>/dev/null; then\n" +
    "  kill \"$watcher\" 2>/dev/null\n" +
    "  wait \"$watcher\" 2>/dev/null\n" +
    "  exit \"$status\"\n" +
    "fi\n" +
    "wait \"$watcher\" 2>/dev/null\n" +
    "exit ${rcTimedOut}\n"
  writeFile(path, script) catch e {
    fatal(name, "cannot write the wrapper script: " + e.message())
  }
  let code = osRun("/bin/sh", [path])
  removeQuiet(path)
  return code
}

// A fixture-setup script that must exit 0 — a `git` absence gets its own
// named diagnostic (`rcGitAbsent`) rather than reading as a plain failure.
fn mustSucceed(name: string, what: string, body: string) {
  let code = runScript(name, body)
  if (code == rcTimedOut) {
    fatal(name, "fixture setup (${what}) TIMED OUT after ${subprocessTimeoutMs}ms")
  }
  if (code == rcGitAbsent) {
    fatal(name, "fixture setup (${what}) needs `git` on PATH and it is not there")
  }
  if (code != 0) {
    fatal(name, "fixture setup (${what}) exited ${code}, want 0")
  }
}

fn mkdirp(name: string, path: string) {
  mustSucceed(name, "mkdir -p ${path}", "set -e\nmkdir -p " + shQuote(path) + "\n")
}

fn removeQuiet(path: string) {
  remove(path) catch _ { return }
}

// Wraps `s` as one POSIX `/bin/sh` word: every embedded `'` becomes `'\''`.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\'') {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn indexOfByte(s: string, c: byte): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// ---- small shared helpers ---------------------------------------------

fn isFullSha(s: string): bool {
  if (len(s) != 40) {
    return false
  }
  let i = 0
  while (i < 40) {
    let c = s[i]
    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
      return false
    }
    i = i + 1
  }
  return true
}

fn trimEol(s: string): string {
  let n = len(s)
  while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r')) {
    n = n - 1
  }
  return s[0:n]
}

fn fatal(name: string, msg: string) {
  print("FAIL [${name}]: ${msg}\n")
  exit(1)
}
