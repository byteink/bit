// Grade phase for tests/bit/golden (#1901): reads every job's captured
// output back from tests/bit/gatefanout and applies the SAME comparisons
// the pre-#1901 serial harness made synchronously right after launching each
// subprocess. Grading itself is ordinary serial Bit code — there is no
// `spawn` anywhere in this harness, so nothing here can interleave two
// cases' output, and the report never depends on which case's shell job
// happened to finish first: `golden.bit`'s `main` walks `cases` in the
// corpus's own sorted discovery order for both staging and grading.

import { cleanupJob, gradeJob } from "../gatefanout"

// `osRunBounded`'s own sentinel encoding (ABI.md §19), reused verbatim by
// `gatefanout.gradeJob` so a caller ported from a direct `osRunBounded` call
// keeps the same branches.
const rcTimedOut: int = 0 - 2
const rcSpawnFailed: int = 0 - 1
const rcSignalBase: int = 0 - 100

// Turns one graded job into the (RunOut, ok) shape the pre-#1901 harness's
// `runWrapped` returned directly, so every comparison function below is
// otherwise unchanged from before this ticket.
fn loadResult(ctx: Ctx, name: string, what: string, scratch: string, key: string): (RunOut, bool) {
  let jr = gradeJob(scratch, key)
  let empty = RunOut{ code: 0, out: "", err: "" }
  if (!jr.ran) {
    failCase(ctx, name, what, "wrapper produced no result — the job never ran to completion")
    return empty, false
  }
  if (jr.code == rcTimedOut) {
    failCase(ctx, name, what, "TIMED OUT (raise BIT_TEST_TIMEOUT_S)")
    return empty, false
  }
  if (jr.code == rcSpawnFailed) {
    failCase(ctx, name, what, "cannot launch wrapper script")
    return empty, false
  }
  if (jr.code <= rcSignalBase) {
    failCase(ctx, name, what, "CRASHED: killed by signal ${0 - jr.code - 100}")
    return empty, false
  }
  return RunOut{ code: jr.code, out: jr.out, err: jr.err }, true
}

// #2084: the `--dump-ir`/`--dump-ir-pre` commands must not die by signal on
// ANY case, valid or not. Output is deliberately ignored — an invalid
// program has no correct dump to compare against — so `loadResult` itself,
// which counts a signal death as a failure, is the whole check.
fn gradeDumpSurvives(ctx: Ctx, name: string, scratch: string, idx: int) {
  let (_, _) = loadResult(ctx, name, "dump-ir survives", scratch, dumpIrKey(idx))
  let (_, _) = loadResult(ctx, name, "dump-ir-pre survives", scratch, dumpIrPreKey(idx))
  cleanupJob(scratch, dumpIrKey(idx))
  cleanupJob(scratch, dumpIrPreKey(idx))
}

// `// error`: compilation must fail AND the rendered diagnostics must match.
fn gradeError(ctx: Ctx, scratch: string, c: GCase) {
  let (r, ok) = loadResult(ctx, c.name, "error", scratch, primaryKey(c.idx))
  if (!ok) {
    return
  }
  if (r.code == 0) {
    failCase(ctx, c.name, "error", "expected compilation to fail, but `bit check` exited 0")
    return
  }
  expectText(ctx, c.name, "error", c.expected, stripDotSlash(r.err))
}

// `// fmt`: canonicalisation, read back from the staged copy `bit fmt`
// rewrote in place.
fn gradeFmt(ctx: Ctx, scratch: string, c: GCase) {
  let (r, ok) = loadResult(ctx, c.name, "fmt", scratch, primaryKey(c.idx))
  if (!ok) {
    fsRemove(c.fmtTmp)
    return
  }
  if (r.code != 0) {
    failCase(ctx, c.name, "fmt", "expected exit 0, got ${r.code}\n  stderr: ${clip(r.err)}")
    fsRemove(c.fmtTmp)
    return
  }
  let got = readFile(c.fmtTmp) catch _ {
    failCase(ctx, c.name, "fmt", "cannot read back the formatted copy")
    return
  }
  expectText(ctx, c.name, "fmt", c.expected, got)
  fsRemove(c.fmtTmp)
}

// `// lint`: stderr must match AND the exit code must equal the directive's
// mandatory `exit=` value (spec/LINT.md §8).
fn gradeLint(ctx: Ctx, scratch: string, c: GCase) {
  let want = lintExitCode(c.line)
  if (want < 0) {
    failCase(ctx, c.name, "lint", "line 1 must be `// lint exit=<0|1|2>`")
    return
  }
  let (r, ok) = loadResult(ctx, c.name, "lint", scratch, primaryKey(c.idx))
  if (!ok) {
    return
  }
  if (r.code != want) {
    failCase(ctx, c.name, "lint", "expected exit ${want}, got ${r.code}\n  stderr: ${clip(r.err)}")
    return
  }
  expectText(ctx, c.name, "lint", c.expected, r.err)
}

// `// doc`: rendered symbol index over the staged one-file module directory.
fn gradeDoc(ctx: Ctx, scratch: string, c: GCase) {
  let (r, ok) = loadResult(ctx, c.name, "doc", scratch, primaryKey(c.idx))
  if (!ok) {
    fsRemove("${c.docDir}/main.bit")
    fsRemove(c.docDir)
    return
  }
  if (r.code != 0) {
    failCase(ctx, c.name, "doc", "expected exit 0, got ${r.code}\n  stderr: ${clip(r.err)}")
    fsRemove("${c.docDir}/main.bit")
    fsRemove(c.docDir)
    return
  }
  expectText(ctx, c.name, "doc", c.expected, r.out)
  fsRemove("${c.docDir}/main.bit")
  fsRemove(c.docDir)
}

// One of the four CLI dump flags, compared on stdout. These commands print
// nothing on stderr and exit 0 for a well-formed case, so a nonzero exit is
// itself a failure.
fn gradeDump(ctx: Ctx, scratch: string, c: GCase, what: string) {
  let (r, ok) = loadResult(ctx, c.name, what, scratch, primaryKey(c.idx))
  if (!ok) {
    return
  }
  if (r.code != 0) {
    failCase(ctx, c.name, what, "expected exit 0, got ${r.code}\n  stderr: ${clip(r.err)}")
    return
  }
  expectText(ctx, c.name, what, c.expected, r.out)
}

fn dumpKindName(c: GCase): string {
  if (c.directive == dTypes) {
    return "types"
  }
  if (c.directive == dTokens) {
    return "tokens"
  }
  if (c.directive == dAst) {
    return "ast"
  }
  return "ir"
}

// `// run` / `// panic` / `// panic-debug`: grades the compile job, then —
// only if it succeeded and produced a binary — the run job. `run` wants
// exit 0 + stdout; panic variants want exit `panicExit` + stderr, a trap IS
// success. Mirrors the pre-#1901 `checkRun`'s branch structure exactly.
fn gradeRunFamily(ctx: Ctx, scratch: string, c: GCase) {
  let what = directiveName(c.directive)
  let (b, bok) = loadResult(ctx, c.name, "${what}/compile", scratch, primaryKey(c.idx))
  cleanupJob(scratch, primaryKey(c.idx))
  if (!bok) {
    cleanupJob(scratch, runKey(c.idx))
    fsRemove(c.binPath)
    return
  }
  if (b.code != 0) {
    failCase(
      ctx, c.name, "${what}/compile",
      "compile failed with exit ${b.code}\n  stderr: ${clip(b.err)}",
    )
    cleanupJob(scratch, runKey(c.idx))
    fsRemove(c.binPath)
    return
  }
  if (!exists(c.binPath)) {
    failCase(
      ctx, c.name, "${what}/compile",
      "compiler exited 0 but produced no binary at ${c.binPath}",
    )
    cleanupJob(scratch, runKey(c.idx))
    return
  }
  gradeRunOutcome(ctx, scratch, c, what)
}

fn gradeRunOutcome(ctx: Ctx, scratch: string, c: GCase, what: string) {
  let (r, ok) = loadResult(ctx, c.name, what, scratch, runKey(c.idx))
  cleanupJob(scratch, runKey(c.idx))
  fsRemove(c.binPath)
  if (!ok) {
    return
  }
  if (isPanicLike(c.directive)) {
    if (r.code != panicExit) {
      failCase(
        ctx, c.name, what,
        "expected a panic (exit ${panicExit}), got exit ${r.code}\n  stderr: ${clip(r.err)}",
      )
      return
    }
    expectText(ctx, c.name, what, c.expected, r.err)
    return
  }
  if (r.code != 0) {
    failCase(ctx, c.name, what, "binary exited with ${r.code}\n  stderr: ${clip(r.err)}")
    return
  }
  expectText(ctx, c.name, what, c.expected, r.out)
}

fn gradeByDirective(ctx: Ctx, scratch: string, c: GCase) {
  if (c.directive == dErr) {
    gradeError(ctx, scratch, c)
  } else if (c.directive == dFmt) {
    gradeFmt(ctx, scratch, c)
  } else if (c.directive == dLint) {
    gradeLint(ctx, scratch, c)
  } else if (c.directive == dDoc) {
    gradeDoc(ctx, scratch, c)
  } else {
    gradeDump(ctx, scratch, c, dumpKindName(c))
  }
  cleanupJob(scratch, primaryKey(c.idx))
}

fn gradeCase(ctx: Ctx, scratch: string, c: GCase) {
  gradeDumpSurvives(ctx, c.name, scratch, c.idx)
  if (isRunLike(c.directive)) {
    gradeRunFamily(ctx, scratch, c)
    return
  }
  gradeByDirective(ctx, scratch, c)
}
