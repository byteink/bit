import { args, arg, argc, env, envOr } from "std/os"

// Probed by tests/osenv.zig, which runs this twice: once with
// BIT_OSENV_PROBE unset, once set. Everything printed is deterministic.
function main() {
  println("argc=${argc()}")
  println("arg0_nonempty=${len(arg(0)) > 0}")
  println("args_len_matches=${len(args()) == argc()}")
  println("probe=[${env("BIT_OSENV_PROBE")}]")
  println("fallback=${envOr("BIT_OSENV_ABSENT", "default")}")
}
