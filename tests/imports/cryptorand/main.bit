// Crypto boundary primitives (#1159, ABI.md §21): OS-CSPRNG random bytes and an
// optimizer-proof buffer wipe. `cryptoRandomBytes`/`cryptoSecureZero` are
// universe-scope builtins (no import). The random bytes are non-deterministic,
// so the program only prints *derived booleans* that are always true for a
// correct CSPRNG — that keeps the golden `expected` stable.

function main() {
  let n = 1 << 20 // 1 MiB
  let a = cryptoRandomBytes(n)
  let b = cryptoRandomBytes(n)

  // Length is exact.
  println("len=${len(a) == n}")

  // Two independent draws differ (a 1 MiB collision never happens in practice).
  println("differ=${a != b}")

  // Byte histogram over the first draw.
  let buckets = []i64(256)
  let i = 0
  while (i < n) {
    let v = int(a[i])
    buckets[v] = buckets[v] + 1
    i = i + 1
  }

  // Not all zero: the zero byte cannot account for the whole draw (the
  // weak/zero-fallback failure mode this primitive must never exhibit).
  println("nonzero=${buckets[0] != n}")

  // Loose uniformity: mean = 1048576 / 256 = 4096; require every bucket within
  // ±20%, i.e. [3277, 4915]. A real CSPRNG deviates by ~64 (one stddev), so this
  // is a wide, non-flaky bound that still catches a biased or broken generator.
  let uniform = true
  let k = 0
  while (k < 256) {
    let c = buckets[k]
    if (c < 3277 || c > 4915) {
      uniform = false
    }
    k = k + 1
  }
  println("uniform=${uniform}")

  // secureZero wipes a filled buffer back to all zeros.
  let key = []byte(32)
  let j = 0
  while (j < 32) {
    key[j] = 200
    j = j + 1
  }
  cryptoSecureZero(key)
  let wiped = true
  j = 0
  while (j < 32) {
    if (key[j] != 0) {
      wiped = false
    }
    j = j + 1
  }
  println("wiped=${wiped}")
}
