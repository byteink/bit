// std/crypto X.509 (#1197): parse a small offline PKI (root -> intermediate ->
// leaf, plus Ed25519 and ECDSA-P256 chains) and exercise the full verifier. The
// DER fixtures are generated offline by cryptography (genpki.py) and are already
// independently verified with that library. Asserts: the parsed leaf fields; a
// happy-path chain verification; five distinct negative failures (expired,
// hostname mismatch, non-CA issuer, tampered signature, missing intermediate);
// Ed25519 and ECDSA-P256 chain verification (signature-dispatch coverage); the
// RSA-PSS, RSA-PKCS1, ECDSA and Ed25519 single-signature dispatch; and hostname
// matching (exact, case-insensitive, wildcard, and IPv4).
import { x509Parse, x509VerifyChain, x509VerifySignature, x509MatchHostname, Certificate, decodeHex } from "std/crypto"

// A time inside every fixture's validity window, and one past the leaf's notAfter
// (but still inside the CA windows) so it isolates leaf expiry.
const tsHappy: int = 1748736000
const tsExpired: int = 2064268800

// Parse a hex-encoded DER certificate.
function certOf(hex: string): Certificate! {
  return x509Parse(decodeHex(hex)?)?
}

// A single-element certificate pool.
function one(c: Certificate): []Certificate {
  let s = []Certificate(0)
  return append(s, c)
}

// Verify a chain and print one labelled line: "ok" on success, else the specific
// failure message — so each negative asserts a distinct error.
function report(name: string, leaf: Certificate, inters: []Certificate, roots: []Certificate, host: string, now: int) {
  x509VerifyChain(leaf, inters, roots, host, now) catch e {
    println("${name}=${e.message()}")
    return
  }
  println("${name}=ok")
}

function main() {
  run() catch e {
    println("setup=${e.message()}")
  }
}

function run(): ()! {
  let root = certOf(hexRoot())?
  let inter = certOf(hexInter())?
  let leaf = certOf(hexLeaf())?
  let nonca = certOf(hexNonca())?
  let leafbad = certOf(hexLeafbad())?
  let wildleaf = certOf(hexWildleaf())?
  let ipleaf = certOf(hexIpleaf())?
  let pssleaf = certOf(hexPssleaf())?
  let edroot = certOf(hexEdroot())?
  let edleaf = certOf(hexEdleaf())?
  let ecroot = certOf(hexEcroot())?
  let ecleaf = certOf(hexEcleaf())?

  // --- parsed leaf fields ---
  println("subject=${leaf.subject}")
  println("issuer=${leaf.issuer}")
  println("validity=${leaf.notBefore}..${leaf.notAfter}")
  println("pubKeyAlg=${leaf.pubKeyAlg} isCa=${leaf.isCa} hasPathLen=${leaf.hasPathLen}")
  println("dns=${leaf.dnsNames[0]},${leaf.dnsNames[1]} hasEku=${leaf.hasExtKeyUsage}")
  println("interIsCa=${inter.isCa} interPathLen=${inter.maxPathLen}")
  println("edAlg=${edleaf.pubKeyAlg} ecAlg=${ecleaf.pubKeyAlg} ecCurve=${ecleaf.ecCurveOid}")

  let roots = one(root)
  let inters = one(inter)
  let noInters = []Certificate(0)

  // --- happy path + five distinct negatives ---
  report("happy", leaf, inters, roots, "example.com", tsHappy)
  report("expired", leaf, inters, roots, "example.com", tsExpired)
  report("hostname", leaf, inters, roots, "evil.com", tsHappy)
  report("nonca", leafbad, one(nonca), roots, "bad.example.com", tsHappy)
  report("missing", leaf, noInters, roots, "example.com", tsHappy)

  // tampered signature: flip a byte in the leaf's signatureValue, re-parse, verify.
  let der = decodeHex(hexLeaf())?
  der[len(der) - 1] = der[len(der) - 1] ^ 0x01
  let tampered = x509Parse(der)?
  report("tampered", tampered, inters, roots, "example.com", tsHappy)

  // --- signature-dispatch coverage through chain verification ---
  report("ed", edleaf, noInters, one(edroot), "ed.example.com", tsHappy)
  report("ec", ecleaf, noInters, one(ecroot), "ec.example.com", tsHappy)

  // --- single-signature dispatch (leaf verified directly under its issuer) ---
  println("sigRsa=${x509VerifySignature(leaf, inter)}")
  println("sigPss=${x509VerifySignature(pssleaf, inter)}")
  println("sigEd=${x509VerifySignature(edleaf, edroot)}")
  println("sigEc=${x509VerifySignature(ecleaf, ecroot)}")
  println("sigWrongIssuer=${x509VerifySignature(leaf, root)}")

  // --- hostname matching: exact, case-insensitive, wildcard, IPv4 ---
  println("mExact=${x509MatchHostname(leaf, "example.com")}")
  println("mCase=${x509MatchHostname(leaf, "EXAMPLE.COM")}")
  println("mWww=${x509MatchHostname(leaf, "www.example.com")}")
  println("mEvil=${x509MatchHostname(leaf, "evil.com")}")
  println("mWild=${x509MatchHostname(wildleaf, "a.wild.example.com")}")
  println("mWildBare=${x509MatchHostname(wildleaf, "wild.example.com")}")
  println("mWildDeep=${x509MatchHostname(wildleaf, "a.b.wild.example.com")}")
  println("mIp=${x509MatchHostname(ipleaf, "192.0.2.10")}")
  println("mIpNo=${x509MatchHostname(ipleaf, "192.0.2.11")}")
}

function hexRoot(): string { return "" }
function hexInter(): string { return "" }
function hexLeaf(): string { return "" }
function hexNonca(): string { return "" }
function hexLeafbad(): string { return "" }
function hexWildleaf(): string { return "" }
function hexIpleaf(): string { return "" }
function hexPssleaf(): string { return "" }
function hexEdroot(): string { return "" }
function hexEdleaf(): string { return "" }
function hexEcroot(): string { return "" }
function hexEcleaf(): string { return "" }
