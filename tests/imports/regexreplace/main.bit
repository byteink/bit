// std/regex `replaceAll`/`replaceFirst` and their `$`-template expansion
// (#2035). Each function below prints exactly one line, matched 1:1 against
// `expected` — see that file's header for the full list.
//
// Every expected value was hand-derived against this module's own
// documented template grammar (`stdlib/regex/replace.bit`'s doc comment),
// the same rules `docs/stdlib/regex.md`'s `replaceAll`/`replaceFirst`
// sections state.

import { mustCompile } from "std/regex"

fn main() {
  println(literalReplacement())
  println(numberedGroup())
  println(namedGroup())
  println(dollarDollar())
  println(dollarLetterAndTrailing())
  println(bracedDigitVsPlain())
  println(outOfRange())
  println(nonParticipating())
  println(emptyMatchPattern())
  println(utf8Input())
  println(replaceFirstThreeMatches())
  println(replaceFirstNoMatch())
}

// A plain literal replacement, two non-overlapping matches.
fn literalReplacement(): string {
  let re = mustCompile("cat")
  return re.replaceAll("the cat sat on the cat mat", "dog")
}

// `$1`/`$2`, reordered — also exercises `$1` specifically (the ticket's own
// requirement), not just a group reference in general.
//
// The `\$` here escapes BIT'S OWN string interpolation (SPEC §5.7) — this
// literal must reach `replaceAll` as the two literal bytes "$" "2", not be
// evaluated by the compiler as an interpolated expression named `2`.
fn numberedGroup(): string {
  let re = mustCompile("(a)(b)")
  return re.replaceAll("ab", "\$2-\$1")
}

// `${name}` for a named group, both directions. Same `\$` escaping as
// above, for the same reason.
fn namedGroup(): string {
  let re = mustCompile("(?<year>[0-9]{4})-(?<month>[0-9]{2})")
  return re.replaceAll("2026-08", "\${month}/\${year}")
}

// `$$` is a literal `$`, never a group reference.
fn dollarDollar(): string {
  let re = mustCompile("a")
  return re.replaceAll("a", "x\$\$y")
}

// `$` followed by a non-digit, non-`{` byte is that `$` plus the byte,
// unchanged (`r1`); `$` as the very last byte of the template is a literal
// `$` with nothing to combine with (`r2`) — two related escape-boundary
// decisions on one line.
fn dollarLetterAndTrailing(): string {
  let re = mustCompile("a")
  let r1 = re.replaceAll("a", "\$z")
  let r2 = re.replaceAll("a", "end\$")
  return "${r1}|${r2}"
}

// `${1}0` is group 1 then the literal digit "0" (`r1`); `$10` is group TEN,
// which this one-group pattern does not have, so it expands empty (`r2`) —
// the ticket's own worked example, and the only way the two spellings can
// ever disagree.
fn bracedDigitVsPlain(): string {
  let re = mustCompile("(a)")
  let r1 = re.replaceAll("xay", "\${1}0")
  let r2 = re.replaceAll("xay", "\$10")
  return "${r1}|${r2}"
}

// An out-of-range group index expands to the empty string, never an error
// and never the literal template text.
fn outOfRange(): string {
  let re = mustCompile("(a)(b)")
  return re.replaceAll("ab", "[\$7]")
}

// A group that took no part in the winning alternative — `(a)` never ran
// against "b" — expands to the empty string, never the literal `$1`.
fn nonParticipating(): string {
  let re = mustCompile("(a)|(b)")
  return re.replaceAll("b", "[\$1-\$2]")
}

// A pattern that can match the empty string: `replaceAll` must terminate
// and must not double-substitute at the same position. `a*` against "bb"
// finds three empty matches (offsets 0, 1, 2), never four, and the literal
// "b"s survive between them.
fn emptyMatchPattern(): string {
  let re = mustCompile("a*")
  return re.replaceAll("bb", "-")
}

// A multi-byte UTF-8 match, captured and reinserted through `$1` — the
// match's own byte offsets must stay correct across the substitution.
fn utf8Input(): string {
  let re = mustCompile("(café)")
  return re.replaceAll("I like café so much", "[$1]")
}

// `replaceFirst` touches only the leftmost of three matches.
fn replaceFirstThreeMatches(): string {
  let re = mustCompile("[0-9]+")
  return re.replaceFirst("a1 b22 c333", "N")
}

// `replaceFirst` on a subject with no match returns it unchanged.
fn replaceFirstNoMatch(): string {
  let re = mustCompile("[0-9]+")
  return re.replaceFirst("no digits here", "N")
}
