// std/crypto HMAC (#1172): the RFC 4231 known-answer vectors, hex-compared via
// encodeHex, over both SHA-256 and SHA-512. Covers all three key paths — a key
// equal to the block (case 1), a short key that is zero-padded (case 2, "Jefe"),
// and a 131-byte key that must be hashed down first (case 7) — plus a
// constant-time tag check (`hmacEqual`) on a matching and a one-byte-tampered
// tag. The construction is generic over the digest: `newSha512` already returns
// `Hash`, while `newSha256` returns the concrete `Sha256`, so it is wrapped as a
// `() => Hash` value. Every output is deterministic, so the golden `expected` is
// stable, and it pins the two nested-hash digests across architectures.
import { Hash, hmac, hmacEqual, newSha256, newSha512, encodeHex, decodeHex } from "std/crypto"

// The concrete SHA-256 constructor exposed as a `() => Hash` value.
function sha256Hash(): Hash { return newSha256() }

// A byte slice of `n` copies of `v` — builds the RFC 4231 repeated-byte keys.
function repeatByte(n: int, v: byte): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = v
    i = i + 1
  }
  return out
}

function run(): ()! {
  // Case 1 — key is 20 bytes of 0x0b (< block, zero-padded), data "Hi There".
  let k1 = repeatByte(20, 0x0b)
  let m1 = []byte("Hi There")
  let t1 = hmac(sha256Hash, k1, m1)
  println("c1sha256=${encodeHex(t1)}")
  println("c1sha512=${encodeHex(hmac(newSha512, k1, m1))}")

  // Case 2 — short key "Jefe" (4 bytes, zero-padded to the block).
  let k2 = []byte("Jefe")
  let m2 = []byte("what do ya want for nothing?")
  println("c2sha256=${encodeHex(hmac(sha256Hash, k2, m2))}")

  // Case 7 — 131-byte key of 0xaa (> block, hashed down first) and a long
  // message that itself spans multiple blocks.
  let k7 = repeatByte(131, 0xaa)
  let m7 = []byte("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")
  println("c7sha256=${encodeHex(hmac(sha256Hash, k7, m7))}")
  println("c7sha512=${encodeHex(hmac(newSha512, k7, m7))}")

  // Constant-time tag check: the true tag verifies, a one-byte tamper does not.
  let want = decodeHex("b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")?
  println("equalMatch=${hmacEqual(t1, want)}")
  let bad = decodeHex("b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff8")?
  println("equalTamper=${hmacEqual(t1, bad)}")
}

function main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
