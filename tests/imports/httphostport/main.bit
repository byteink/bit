// Host header omits the port (#2296): the request serialiser wrote `Host:
// ${host}` straight from the parsed URL and never appended the port, so
// every request to a non-default port carried a `Host` value RFC 7230 §5.4
// requires to include it — misrouting or getting rejected by any
// virtual-hosted reverse proxy or dev server (nginx/Traefik/Caddy pick a
// `server` block from Host; Rails/Django/Vite validate it).
// `hostHeaderValue` now appends `:port` unless it is the scheme's default (80
// for http, 443 for https).
//
// Driven over a raw std/net listener on a kernel-assigned (non-default) port
// so the exact wire bytes are captured, reusing the exported `header()`
// parser to read the `Host:` line back out — the same function a real server
// or proxy would use. `expected` holds no wire CRLFs (never printed) so this
// repo's autocrlf setting cannot touch it.
//
// The scheme-default omission (`http://h/x` -> `Host: h`, `https://h/x` ->
// `Host: h`) is NOT round-tripped here: binding port 80 or 443 needs root,
// unavailable in this sandbox, and a live port 80/443 on a shared dev
// machine cannot safely be assumed free. It is preserved by construction —
// `hostHeaderValue`'s default-port branch returns the bare host exactly as
// the unconditional old code always did — and was already correct before
// this fix (see the ticket's own comparison table).
import { listen, Listener, Conn } from "std/net"
import { get, header } from "std/http"

fn tryWrite(c: Conn) {
  c.write("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok") catch e {
    return
  }
}

fn serveOne(c: Conn, got: chan<string>) {
  let req = c.read(8192)
  got <- req
  tryWrite(c)
  c.close()
}

fn loop(l: Listener, got: chan<string>) {
  let c = l.accept() catch e {
    return
  }
  serveOne(c, got)
}

fn main() {
  let l = listen("127.0.0.1", 0) catch e {
    println("listen failed")
    return
  }
  let port = l.port() catch e {
    0
  }
  let got = chan<string>(1)
  spawn loop(l, got)

  let r = get("http://127.0.0.1:${port}/users/1") catch e {
    println("unexpected client error")
    l.close()
    return
  }
  let wire = <- got
  let hostValue = header(wire, "Host")
  let expected = "127.0.0.1:${port}"
  println("status=${r.status} host-matches-expected=${hostValue == expected}")
  l.close()
}
