// std/crypto scrypt (#1178): the RFC 7914 §12 known-answer vectors, hex-compared
// via encodeHex. The first vector (P="", S="", N=16, r=1, p=1) exercises the
// minimum parameters — one ROMix over a 16-entry table — and the second
// (P="password", S="NaCl", N=1024, r=8, p=16) a real memory-hard derivation
// across 16 blocks. Both outputs are deterministic, so the golden `expected` is
// stable across architectures. The RFC's N>=16384 vectors are correct but omitted
// here: they are deliberately slow and CI runs this on three targets. A parameter
// rejection (N not a power of two) is checked too, exercising the fallible path.
import { scrypt, encodeHex } from "std/crypto"

fn run(): ()! {
  // P="", S="", N=16, r=1, p=1, dkLen=64.
  println("v1=${encodeHex(scrypt([]byte(""), []byte(""), 16, 1, 1, 64)?)}")
  // P="password", S="NaCl", N=1024, r=8, p=16, dkLen=64.
  println("v2=${encodeHex(scrypt([]byte("password"), []byte("NaCl"), 1024, 8, 16, 64)?)}")
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
    return
  }
  // A non-power-of-two N must be rejected rather than silently derive.
  let bad = scrypt([]byte("x"), []byte("y"), 15, 1, 1, 32) catch e {
    println("badN=${e.message()}")
    return
  }
  println("badN=unexpected ok, len ${len(bad)}")
}
