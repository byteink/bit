// Golden test for #2668: std/time's `after`, `newTimer` and `Timer.stop`.
//
// Nothing here spawns a green thread — the point of these primitives is
// that they don't need one (a timer fire is a plain channel send, not a
// task with its own stack).
import { after, newTimer, sleep, Millisecond, Second } from "std/time"

// timeout_fired: `never` has no sender anywhere in the program, so the
// `after` arm is the ONLY arm that can ever become ready. The duration only
// affects how long this test takes to run, never which arm wins — 30ms
// keeps it fast without risking timer-wheel resolution jitter.
fn timeoutFired(): bool {
  let never = chan<bool>(1)
  select {
    case <- never:
      return false
    case <- after(30 * Millisecond):
      return true
  }
}

// value_won: `ready` is preloaded with 7 before the `select` even runs, so
// it is already ready at entry while `after`'s timer has not started
// ticking yet — there is no race to lose regardless of scheduling delay.
// The 3-second timeout arm costs nothing: the select returns as soon as it
// observes `ready` is ready, without ever waiting out `after`'s duration. 3
// seconds is chosen far longer than any scheduling jitter a loaded box
// could introduce between entering select and observing the buffered value.
fn valueWon(): int {
  let ready = chan<int>(1)
  ready <- 7
  select {
    case v = <- ready:
      return v
    case <- after(3 * Second):
      return -1
  }
}

// stopped_timer_silent: stop() is called immediately after the timer is
// armed — a synchronous, non-blocking call with no I/O, so it always
// completes well before the 30ms deadline regardless of fleet load.
// Sleeping 150ms (5x the timer's own duration) before checking, then using
// a non-blocking `default` arm, proves the channel stays empty even past
// the point the timer would have fired had stop() failed to cancel it.
fn stoppedTimerSilent(): bool {
  let t = newTimer(30 * Millisecond)
  t.stop()
  sleep(150 * Millisecond)
  select {
    case <- t.c:
      return false
    default:
      return true
  }
}

fn main() {
  println("timeout_fired=${timeoutFired()}")
  println("value_won=${valueWon()}")
  println("stopped_timer_silent=${stoppedTimerSilent()}")
}
