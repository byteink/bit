// Exercises std/math. Each result is bound before printing (one interpolated
// call per line) — clear, and it sidesteps a known pre-existing x64 codegen bug
// with 3+ branchy float calls inlined in a single interpolation (see the
// bit-x64-float-interp memory / issue).
import { abs, min, max, clamp, sign, floor, ceil, trunc, sqrt } from "std/math"

function main() {
  let a = abs(-3.5)
  let mn = min(2.0, 5.0)
  let mx = max(2.0, 5.0)
  println("abs=${a} min=${mn} max=${mx}")

  let c = clamp(12.0, 0.0, 10.0)
  let s = sign(-7.0)
  println("clamp=${c} sign=${s}")

  let fl = floor(-2.3)
  let ce = ceil(2.1)
  let tr = trunc(-2.9)
  println("floor=${fl} ceil=${ce} trunc=${tr}")

  let r1 = sqrt(144.0)
  let r2 = sqrt(2.0)
  println("sqrt144=${r1} sqrt2=${r2}")
}
