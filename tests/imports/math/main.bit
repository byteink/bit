// Exercises std/math. The calls are inlined directly in each interpolation —
// three branchy float-returning calls in one string was the shape that used to
// hit a spill-slot aliasing bug in the register allocator (now fixed; see
// tests/cases/run_float_spill_eviction), so this doubles as a cross-module
// guard for it.
import { pi, e, abs, min, max, clamp, sign, floor, ceil, trunc, sqrt } from "std/math"

fn main() {
  println("abs=${abs(-3.5)} min=${min(2.0, 5.0)} max=${max(2.0, 5.0)}")
  println("clamp=${clamp(12.0, 0.0, 10.0)} sign=${sign(-7.0)}")
  println("floor=${floor(-2.3)} ceil=${ceil(2.1)} trunc=${trunc(-2.9)}")
  println("sqrt144=${sqrt(144.0)} sqrt2=${sqrt(2.0)}")
  println("pi=${pi} e=${e}")
}
