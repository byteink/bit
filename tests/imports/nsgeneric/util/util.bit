// The module #2133's root reaches through a NAMESPACE binding. Both a generic
// and a non-generic export, because only the generic one failed: the namespace
// form was wired for non-generic members (#1154) and never for generic ones.
export fn idOf<T>(x: T): T {
  return x
}

export fn firstOf<T>(xs: []T, fallback: T): T {
  if (len(xs) == 0) {
    return fallback
  }
  return xs[0]
}

export fn plain(x: int): int {
  return x + 1
}
