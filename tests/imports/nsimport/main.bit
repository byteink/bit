// Namespace imports (#1154): `import ns from "..."` and `import * as ns from
// "..."` both bind a namespace, and `ns.member` names an exported symbol of that
// module — the same symbol `import { member } from "..."` would have bound.
import strings from "std/strings"
import * as fs from "std/fs"
import time from "std/time"

function roundTrip(path: string): string! {
  fs.writeFile(path, "hello")?
  let text = fs.readFile(path)?
  fs.remove(path)?
  return text
}

function main() {
  // A namespace member call, and an aliased one.
  println("upper=${strings.toUpper("bit")} lower=${strings.toLower("BIT")}")

  // A namespaced constant, not a call.
  println("ms=${time.Millisecond} sec=${time.Second}")

  // `* as` binds the same kind of namespace.
  let text = roundTrip("/tmp/bit-nsimport.txt") catch "<failed>"
  println("file=${text}")

  // Namespace and named import of the same module coexist.
  println("joined=${strings.join(["a", "b"], "-")}")
}
