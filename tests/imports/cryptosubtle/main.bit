// Constant-time subtle primitives (#1160): `ctEq`, `ctSelect`, `secureZero`
// from std/crypto. The program exercises each over fixed inputs so the golden
// `expected` is stable, checking only the derived booleans / ints.
import { ctEq, ctSelect, secureZero } from "std/crypto"

fn main() {
  // ctEq: equal buffers match; a one-bit flip in the last byte does not; and a
  // length mismatch is rejected by the fast public-length branch.
  let a = []byte(4)
  let b = []byte(4)
  let i = 0
  while (i < 4) {
    a[i] = byte(i + 1)
    b[i] = byte(i + 1)
    i = i + 1
  }
  println("eqSame=${ctEq(a, b)}")

  b[3] = b[3] ^ 0x01 // flip one bit
  println("eqDiff=${ctEq(a, b)}")

  let short = []byte(3)
  println("eqLen=${ctEq(a, short)}")

  // ctSelect: v == 1 keeps the first operand, v == 0 keeps the second, with no
  // branch on the selector.
  println("selTrue=${ctSelect(1, 7, 9)}")
  println("selFalse=${ctSelect(0, 7, 9)}")

  // secureZero: fill a buffer, then wipe it back to all zeros.
  let key = []byte(8)
  let j = 0
  while (j < 8) {
    key[j] = 200
    j = j + 1
  }
  secureZero(key)
  let wiped = true
  j = 0
  while (j < 8) {
    if (key[j] != 0) {
      wiped = false
    }
    j = j + 1
  }
  println("wiped=${wiped}")
}
