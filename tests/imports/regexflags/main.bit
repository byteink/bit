// std/regex inline flags `(?i)` `(?s)` `(?m)`, the scoped `(?i:...)` form,
// and multiline anchor semantics (#2030). Every expected value below is
// justified against Go's `regexp`/`regexp/syntax` documented behavior, not
// against this implementation — see the comment above each group.
//
// `find` prints "start,end,text" or "no match"; `findAll` prints a leading
// count (so an empty result is visible, not a blank line) followed by one
// "[start,end,text]" per match; `checkErr` prints "ok" on a pattern that
// compiles or the compile error's message otherwise — same shape as
// tests/imports/regexsyntax's `check`.

import { mustCompile, compile, Regex, Match } from "std/regex"

fn find(pattern: string, s: string): string {
  let re = mustCompile(pattern)
  return match (re.find(s)) {
    Some(m) => "${m.start},${m.end},${m.text(s)}"
    None => "no match"
  }
}

fn findAll(pattern: string, s: string): string {
  let re = mustCompile(pattern)
  let ms = re.findAll(s, -1)
  let out = "count=${len(ms)}"
  let i = 0
  // Bounded by `len(ms)`, itself bounded by `findAll`'s own `len(s) + 1`.
  while (i < len(ms)) {
    out = out + " [${ms[i].start},${ms[i].end},${ms[i].text(s)}]"
    i = i + 1
  }
  return out
}

fn checkErr(pattern: string) {
  let re = compile(pattern) catch e {
    println(e.message())
    return
  }
  println("ok ${pattern}")
}

fn main() {
  // --- (?i): a literal, both cases, and inside a class (RE2/Go's `(?i)`
  // case-insensitive matching; ASCII-only fold, this ticket's scope) --------
  println(find("(?i)abc", "ABC"))
  println(find("(?i)abc", "xyzABCxyz"))
  println(find("(?i)[a-f]+", "ABCxyz"))
  println(find("(?i)[A-F]+", "abcxyz"))
  println(find("[a-f]+", "ABCxyz")) // no `(?i)`: class does not fold

  // --- (?i) applied mid-pattern only affects what follows it: `ab` before
  // it stays case-sensitive, `cd` after it folds -----------------------------
  println(find("ab(?i)cd", "abCD")) // "ab" literal, "CD" folded: matches
  println(find("ab(?i)cd", "ABcd")) // "AB" fails the still-literal "ab"

  // --- (?-i) clears a flag `(?i)` set earlier in the same group ------------
  println(find("(?i)a(?-i)b", "AB")) // "B" now needs an exact "b": no match
  println(find("(?i)a(?-i)b", "Ab")) // "A" folds, "b" is exact: matches

  // --- (?i:...) is scoped: flags set inside never leak past its `)` --------
  println(find("(?i:a)b", "AB")) // "b" outside the scope needs exact "b"
  println(find("(?i:a)b", "Ab")) // matches: "A" folds, "b" exact

  // --- the scoped form vs. the SETTING form across `|`: RE2/Go's
  // `(?flags)` (no colon) applies "to the end of the enclosing group",
  // which includes later `|` branches of that SAME group — `|` does not
  // close a group. A scoped `(?flags:...)` does not: its flags are entirely
  // internal, so a sibling branch never sees them. -------------------------
  println(find("(?i)a|b", "B")) // (?i) leaks into the second branch: matches
  println(find("(?i:a)|b", "B")) // scoped: second branch stays case-sensitive

  // --- (?i:...) nested two deep, with an inner (?-i:...) clearing back to
  // exact matching for just its own span, and the OUTER `i` resuming right
  // after the inner scope closes -------------------------------------------
  println(find("(?i:a(?-i:B)c)", "ABC")) // inner "B" exact, outer i resumes for "c"
  println(find("(?i:a(?-i:B)c)", "AbC")) // inner exact "B" fails against "b"

  // --- (?s): `.` matches `\n` too; without it, `.` excludes ONLY `\n` — a
  // lone `\r` always matches `.`, `(?s)` or not, and a `\r\n` pair needs
  // `(?s)` for `.` to cover the `\n` half of it ------------------------------
  println(find("(?s)a.b", "a\nb")) // dotall: matches across the \n
  println(find("a.b", "a\nb")) // no (?s): . excludes \n, no match anywhere
  println(find("a.b", "a\rb")) // . always matches a lone \r (not \n)
  println(find("(?s)a..b", "a\r\nb")) // dotall: both . cover \r then \n
  println(find("a..b", "a\r\nb")) // no (?s): second . can't cross the \n

  // --- (?m): ^/$ also hold at line boundaries, on a three-line subject,
  // with and without a trailing newline; default (no m) matches nothing on
  // the same subject since no single line is the WHOLE text ------------------
  println(findAll("(?m)^\\w+$", "one\ntwo\nthree")) // no trailing \n
  println(findAll("^\\w+$", "one\ntwo\nthree")) // default: matches nothing
  println(findAll("(?m)^\\w+$", "one\ntwo\n")) // trailing \n: still 2 matches,
  // not a spurious 3rd empty match after the final \n (\w+ needs >= 1 char)

  // --- (?m)'s ^/$ vs plain ^/$ on the SAME text, showing the line-boundary
  // vs. text-boundary distinction directly -----------------------------------
  println(find("(?m)^foo", "bar\nfoo")) // ^ holds right after the \n under m
  println(find("^foo", "bar\nfoo")) // without m, ^ only holds at position 0
  println(find("(?m)foo$", "foo\nbar")) // $ holds right before the \n under m
  println(find("foo$", "foo\nbar")) // without m, $ only holds at the true end

  // --- $ without (?m): Go's regexp/syntax docs say `$` is "like \z not \Z"
  // — it does NOT match just before a trailing \n, unlike Perl's default `$`.
  // \z is exactly the same check, so it must agree with plain $ here. --------
  println(find("a$", "a\n")) // no match: '\n' follows, and $ wants true end
  println(find("a$", "a")) // matches: true end right after "a"
  println(find("a\\z", "a\n")) // \z agrees with $ (no m): also no match
  println(find("^a", "\na")) // ^ without m only holds at position 0, not here

  // --- \A/\z always ignore (?m), even when it is active ---------------------
  println(find("(?m)\\Afoo", "bar\nfoo")) // \A is position-0 only, always
  println(find("(?m)foo\\z", "foo\nbar")) // \z is true-end only, always
  println(find("(?m)\\Afoo", "foo\nbar")) // contrast: \A DOES hold at pos 0

  // --- combined flags in one group: `(?im-s)` sets i and m, clears s -------
  println(find("(?im-s)^abc$", "xyz\nABC"))

  // --- errors: an unknown flag letter, and an empty flag list --------------
  checkErr("(?x)a")
  checkErr("(?)a")
}
