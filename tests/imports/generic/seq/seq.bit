// Generic slice helpers, monomorphized at the cross-module call sites in main.
export function contains<T>(xs: []T, target: T): bool {
  for x of xs {
    if (x == target) {
      return true
    }
  }
  return false
}
export function count<T>(xs: []T): i64 {
  let n: i64 = 0
  for x of xs {
    n = n + 1
  }
  return n
}
