// Generic slice helpers, monomorphized at the cross-module call sites in main.
export fn contains<T>(xs: []T, target: T): bool {
  for x of xs {
    if (x == target) {
      return true
    }
  }
  return false
}
export fn count<T>(xs: []T): i64 {
  let n: i64 = 0
  for x of xs {
    n = n + 1
  }
  return n
}
export fn indexOf<T>(xs: []T, target: T): i64 {
  let i: i64 = 0
  for x of xs {
    if (x == target) {
      return i
    }
    i = i + 1
  }
  return -1
}
