// Cross-module generic slice ops: `contains<T>`/`count<T>` live in ./seq and are
// monomorphized here for []i64. Exercises for..of over a slice inside an
// imported generic template.
import { contains, count } from "./seq"
function main() {
  let xs = [10, 20, 30]
  println("has20=${contains(xs, 20)} has99=${contains(xs, 99)} n=${count(xs)}")
}
