// Cross-module generic slice ops: contains<T>/count<T>/indexOf<T> live in ./seq
// and are monomorphized here for []i64. Exercises for..of over a slice (and an
// early return from inside it) in an imported generic template.
import { contains, count, indexOf } from "./seq"
function main() {
  let xs = [10, 20, 30]
  println("has20=${contains(xs, 20)} has99=${contains(xs, 99)} n=${count(xs)} idx30=${indexOf(xs, 30)} idxNone=${indexOf(xs, 99)}")
}
