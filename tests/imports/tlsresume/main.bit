// std/tls session resumption + 0-RTT (RFC 8446 §2.3, §4.6.1, #1209). Drives a
// full handshake, has the server issue a ticket, and resumes with it three
// ways over an in-memory byte pipe — no sockets, same pattern as
// tests/imports/tlsserver:
//
//   1. plain PSK-DHE resumption (no early data): the server must accept the
//      PSK and skip Certificate/CertificateVerify entirely — asserted
//      directly via `peerCertificates()` being empty, since that field is
//      only ever populated by the Certificate-message branch of the client's
//      auth-flight dispatch.
//   2. 0-RTT accepted: the client sends early application data in the same
//      flight as its ClientHello; the server decrypts and delivers it before
//      the handshake finishes, and both sides still complete the handshake
//      (EndOfEarlyData + Finished) and exchange ordinary application data
//      afterward.
//   3. 0-RTT rejected: the server has early data turned off (but the PSK
//      itself is still valid), so the client's speculative early data is
//      never decrypted; the client falls back to resending the same payload
//      as ordinary 1-RTT application data once connected.
//
// *** 0-RTT data is replayable (RFC 8446 §8) — see stdlib/tls/resume.bit's
// header comment. This module implements no anti-replay defense; an
// application must only ever put idempotent requests in early data. ***
import { decodeHex, pemEncode } from "std/crypto"
import {
  TrustStore, newTrustStore,
  TlsClientConfig, TlsClientHandshake, TlsClientConn, tlsClientStart, tlsClientStartResume,
  TlsServerConfig, newTlsServerConfig, TlsServerHandshake, TlsServerConn, tlsServerStart,
  TlsGroup, GroupKeypair,
  SessionTicket, newSessionTicket, parseNewSessionTicket,
} from "std/tls"

const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

fn hx(s: string): []byte { return decodeHex(s) catch e { return []byte(0) } }
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }
fn bytesEq(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) { return false }
  let i = 0
  while (i < len(a)) { if (a[i] != b[i]) { return false }; i = i + 1 }
  return true
}

// The paired connection endpoints a completed handshake yields.
struct Endpoints { cconn: TlsClientConn, sconn: TlsServerConn }

// Drive an already-started client/server pair through the rest of the
// handshake to completion. Shared by a fresh handshake and a resumed one —
// only how `c`/`s` were started differs.
fn drive(c: TlsClientHandshake, s: TlsServerHandshake): Endpoints! {
  let sstep = s.processClientHello(c.hello)?
  let guard = 0
  while (sstep.retry && guard < 2) {
    let cs = c.processServerFlight(sstep.outbound)?
    sstep = s.processClientHello(cs.outbound)?
    guard = guard + 1
  }
  let cstep = c.processServerFlight(sstep.outbound)?
  let sconn = s.processClientFinished(cstep.outbound)?
  return Endpoints{ cconn: c.connection()?, sconn: sconn }
}

// A fresh (non-resumed) handshake.
fn handshake(clientCfg: TlsClientConfig, serverCfg: TlsServerConfig): Endpoints! {
  let c = tlsClientStart(clientCfg)?
  let s = tlsServerStart(serverCfg)?
  return drive(c, s)?
}

// A resumed handshake plus everything a caller needs to inspect the outcome:
// both handshake state machines (for `pskWasAccepted`/`earlyDataWasAccepted`/
// `earlyDataReceived`) alongside the completed endpoints.
struct Resumed { c: TlsClientHandshake, s: TlsServerHandshake, ep: Endpoints }

fn resume(
  clientCfg: TlsClientConfig,
  serverCfg: TlsServerConfig,
  session: SessionTicket,
  earlyData: []byte,
): Resumed! {
  let c = tlsClientStartResume(clientCfg, session, earlyData)?
  let s = tlsServerStart(serverCfg)?
  let ep = drive(c, s)?
  return Resumed{ c: c, s: s, ep: ep }
}

fn baseClient(trust: TrustStore): TlsClientConfig {
  return TlsClientConfig{
    serverName: "localhost",
    alpn: ["h2"],
    trust: trust,
    insecureSkipVerify: false,
    nowUnix: 1800000000,
    groups: [TlsGroup.X25519],
    keyShareGroups: []TlsGroup(0),
    suites: []int(0),
    clientHelloOverride: []byte(0),
    ephemeralOverride: []GroupKeypair(0),
  }
}

// Complete a full handshake, have the server issue a ticket, and hand it to
// the client — the "obtain a ticket to resume with" step every scenario needs.
fn getTicket(clientCfg: TlsClientConfig, serverCfg: TlsServerConfig): SessionTicket! {
  let full = handshake(clientCfg, serverCfg)?
  let ticketRecord = full.sconn.issueTicket()?
  let pt = full.cconn.openApp(ticketRecord)?
  println("ticket: postHandshakeMsgType=${pt.contentType}")
  let nst = parseNewSessionTicket(pt.content)?
  return newSessionTicket(nst, full.cconn)
}

fn run(): ()! {
  let trust = newTrustStore(pemOf("CERTIFICATE", caHex))?
  let serverCfg = newTlsServerConfig(pemOf("CERTIFICATE", leafHex), pemOf("PRIVATE KEY", keyHex), ["h2"])?
  let clientCfg = baseClient(trust)

  // --- 1. full handshake -> ticket -> plain PSK-DHE resumption ---
  let session = getTicket(clientCfg, serverCfg)?
  let r1 = resume(clientCfg, serverCfg, session, []byte(0))?
  println("resume: pskAcceptedClient=${r1.c.pskWasAccepted()} pskAcceptedServer=${r1.s.pskWasAccepted()}")
  println("resume: certificateSkipped=${len(r1.ep.cconn.peerCertificates()) == 0}")
  let toServer1 = r1.ep.cconn.sealApp([]byte("GET /resumed HTTP/1.1"))?
  let atServer1 = r1.ep.sconn.openApp(toServer1)?
  println("resume: c2s='${string(atServer1.content)}'")
  let toClient1 = r1.ep.sconn.sealApp([]byte("HTTP/1.1 200 OK"))?
  let atClient1 = r1.ep.cconn.openApp(toClient1)?
  println("resume: s2c='${string(atClient1.content)}'")

  // --- 2. a second ticket, this time driving 0-RTT ---
  let session2 = getTicket(clientCfg, serverCfg)?
  let earlyPayload = []byte("GET /early HTTP/1.1")

  // 2a. accepted: server has early data on (the default).
  let r2 = resume(clientCfg, serverCfg, session2, earlyPayload)?
  println("0rtt-accept: pskAccepted=${r2.c.pskWasAccepted()}")
  println("0rtt-accept: certificateSkipped=${len(r2.ep.cconn.peerCertificates()) == 0}")
  println("0rtt-accept: serverAccepted=${r2.s.earlyDataWasAccepted()} clientSawAccepted=${r2.c.earlyDataAccepted}")
  println("0rtt-accept: earlyDataMatch=${bytesEq(r2.s.earlyDataReceived(), earlyPayload)}")
  let toServer2 = r2.ep.cconn.sealApp([]byte("post-handshake ping"))?
  let atServer2 = r2.ep.sconn.openApp(toServer2)?
  println("0rtt-accept: postHandshake='${string(atServer2.content)}'")

  // 2b. rejected: same ticket, but this server now declines early data (a
  // realistic operator toggle — resumption itself still works). The client
  // sends the same speculative early data; the server never decrypts it since
  // it never echoes early_data, so the client falls back to resending it as
  // ordinary 1-RTT application data once connected.
  serverCfg.allowEarlyData = false
  let r3 = resume(clientCfg, serverCfg, session2, earlyPayload)?
  println("0rtt-reject: pskAccepted=${r3.c.pskWasAccepted()}")
  println("0rtt-reject: certificateSkipped=${len(r3.ep.cconn.peerCertificates()) == 0}")
  println("0rtt-reject: serverAccepted=${r3.s.earlyDataWasAccepted()} clientSawAccepted=${r3.c.earlyDataAccepted}")
  println("0rtt-reject: serverEarlyDataLen=${len(r3.s.earlyDataReceived())}")
  let fallback = r3.ep.cconn.sealApp(earlyPayload)?
  let atServerFallback = r3.ep.sconn.openApp(fallback)?
  println("0rtt-reject: fallbackMatch=${bytesEq(atServerFallback.content, earlyPayload)}")
}

fn main() { run() catch e { println("error: ${e.message()}") } }
