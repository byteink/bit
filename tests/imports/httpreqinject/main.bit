// Request-line injection via CR/LF/space in a URL path or host (#2297): the
// client used to interpolate a URL's path straight into the request line
// unvalidated, so a CR or LF there split it into extra header lines — or,
// after the blank line, a whole second attacker-chosen request — and a bare
// space silently truncated the request-target at the HTTP version token.
// `parseUrl` now rejects any control character or space in the host or path
// before a single byte reaches the socket, so every malicious case below
// fails inside the client and never dials at all.
//
// The server side is a raw std/net accept loop (no std/http) that reports how
// many bytes it received, so "the request never arrived" is proven, not
// assumed. Neither the raw wire bytes nor the error text (which embeds the
// attacker's own CR/LF) is ever printed — see httpctlheader/httpframing for
// why: only counts and booleans, so `expected` stays deterministic under this
// repo's autocrlf setting.
import { listen, Listener, Conn } from "std/net"
import { get } from "std/http"
import { indexOf } from "std/strings"

function tryWrite(c: Conn) {
  c.write("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok") catch e {
    return
  }
}

function serveOne(c: Conn, got: chan<int>) {
  let req = c.read(8192)
  got <- len(req)
  tryWrite(c)
  c.close()
}

function loop(l: Listener, got: chan<int>) {
  while (true) {
    let c = l.accept() catch e {
      return
    }
    serveOne(c, got)
  }
}

// A request expected to reach the server: blocks for the byte count the
// server actually saw.
function probeOk(got: chan<int>, port: int, label: string, path: string) {
  let r = get("http://127.0.0.1:${port}${path}") catch e {
    println("${label}: unexpected client error")
    return
  }
  let n = <- got
  println("${label}: status=${r.status} reached-server=${n > 0}")
}

// A request that must be rejected client-side, before any byte reaches the
// socket, with an error naming `expectName` (CR, LF, or space).
function probeRejected(port: int, label: string, path: string, expectName: string) {
  probeRejectedUrl(label, "http://127.0.0.1:${port}${path}", expectName)
}

// As `probeRejected`, but for a fully-formed URL (used for the host cases, so
// the injected bytes land in `Url.host` rather than `Url.path`).
function probeRejectedUrl(label: string, url: string, expectName: string) {
  let r = get(url) catch e {
    let named = indexOf(e.message(), expectName) >= 0
    println("${label}: rejected named-correctly=${named}")
    return
  }
  println("${label}: NOT REJECTED status=${r.status}")
}

function main() {
  let l = listen("127.0.0.1", 0) catch e {
    println("listen failed")
    return
  }
  let port = l.port() catch e {
    0
  }
  let got = chan<int>(1)
  spawn loop(l, got)

  probeOk(got, port, "plain", "/users/1")

  // CR, LF, space — in the path.
  probeRejected(port, "crlf-header-injection-path", "/users/1\r\nX-Admin: true", "CR")
  probeRejected(port, "full-request-smuggling-path", "/a\r\nX: 1\r\n\r\nGET /admin HTTP/1.1\r\nHost: evil\r\n\r\n", "CR")
  probeRejected(port, "cr-in-path", "/a\rb", "CR")
  probeRejected(port, "lf-in-path", "/a\nb", "LF")
  probeRejected(port, "space-in-path", "/a b", "space")

  // CR, LF, space — in the host (no "/", so parseUrl's authority == the
  // whole string and the injected byte lands in `host`, not `path`).
  probeRejectedUrl("crlf-in-host", "http://evilhost\r\nXAdmin", "CR")
  probeRejectedUrl("lf-in-host", "http://evilhost\nXAdmin", "LF")
  probeRejectedUrl("space-in-host", "http://evil host", "space")

  // The listener must still be healthy: none of the rejected probes left a
  // phantom connection queued or otherwise disturbed it.
  probeOk(got, port, "plain-again", "/users/2")

  l.close()
}
