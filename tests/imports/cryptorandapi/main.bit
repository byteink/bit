// std/crypto rand surface (#1163): randomBytes / randomU64 / randomUintBelow /
// fillRandom over the OS CSPRNG. The bytes are non-deterministic, so the program
// prints only *derived booleans* that hold for any correct CSPRNG — that keeps
// the golden `expected` stable while still catching a broken range or a
// no-op draw.

import { randomBytes, randomU64, randomUintBelow, fillRandom } from "std/crypto"

function main() {
  // randomBytes: exact length, and two independent draws differ. Compared as
  // strings (byte-exact) since slice `!=` is not defined.
  let a = randomBytes(32)
  let b = randomBytes(32)
  println("len32=${len(a) == 32}")
  println("bytesDiffer=${string(a) != string(b)}")

  // randomUintBelow(6): unbiased range. Over 100k draws every result must land
  // in [0, 6) and every bucket 0..5 must be hit — a no-bias smoke test of the
  // range logic (not statistical quality).
  let bound = 6
  let draws = 100000
  let hits = []i64(bound)
  let inRange = true
  let i = 0
  while (i < draws) {
    let v = int(randomUintBelow(6))
    if (v < 0 || v >= bound) {
      inRange = false
    } else {
      hits[v] = hits[v] + 1
    }
    i = i + 1
  }
  println("belowInRange=${inRange}")
  let allHit = true
  let k = 0
  while (k < bound) {
    if (hits[k] == 0) {
      allHit = false
    }
    k = k + 1
  }
  println("belowAllBuckets=${allHit}")

  // randomU64: two draws differ.
  let x = randomU64()
  let y = randomU64()
  println("u64Differ=${x != y}")

  // fillRandom: overwrites a zero-filled buffer in place, leaving its length
  // intact and at least one byte non-zero (the all-zero result is a 2^-128 event).
  let buf = []byte(16)
  let j = 0
  while (j < 16) {
    buf[j] = 0
    j = j + 1
  }
  fillRandom(buf)
  let changed = false
  j = 0
  while (j < 16) {
    if (buf[j] != 0) {
      changed = true
    }
    j = j + 1
  }
  println("fillLen=${len(buf) == 16} fillChanged=${changed}")
}
