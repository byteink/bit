// std/crypto SHA-512 family (#1166): the FIPS 180-4 known-answer vectors for
// SHA-512, SHA-384, and SHA-512/256, the digest/blockSize each constructor
// reports through the `Hash` interface, and a multi-block streaming digest fed
// in odd 7-byte chunks proven byte-identical to the one-shot digest of the same
// message. Every value is deterministic, so `expected` is stable.
import { Hash, digest, newSha512, newSha384, newSha512_256, encodeHex } from "std/crypto"

// A deterministic `n`-byte message with no structure a block boundary could
// hide: 200 bytes spans two 128-byte blocks with a partial tail.
function mkMsg(n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = u8((i * 31 + 7) & 0xff)
    i = i + 1
  }
  return b
}

// Hex digest of `msg` fed to `h` in `step`-byte slices, exercising the partial
// block buffer across writes.
function streamHex(h: Hash, msg: []byte, step: int): string {
  let lo = 0
  while (lo < len(msg)) {
    let hi = lo + step
    if (hi > len(msg)) {
      hi = len(msg)
    }
    h.write(msg[lo:hi])
    lo = hi
  }
  return encodeHex(h.sum())
}

function main() {
  println("sha512_empty=${encodeHex(digest(newSha512(), []byte("")))}")
  println("sha512_abc=${encodeHex(digest(newSha512(), []byte("abc")))}")
  println("sha384_abc=${encodeHex(digest(newSha384(), []byte("abc")))}")
  println("sha512_256_abc=${encodeHex(digest(newSha512_256(), []byte("abc")))}")

  let h = newSha512()
  println(
    "sizes=${h.size()},${newSha384().size()},${newSha512_256().size()} block=${h.blockSize()}",
  )

  let msg = mkMsg(200)
  let once = encodeHex(digest(newSha512(), msg))
  let streamed = streamHex(newSha512(), msg, 7)
  println("stream_matches=${once == streamed}")
}
