// std/regex character classes, pattern parser and compile() surface (#2026).
// This ticket only parses and validates a pattern — no matching yet (#2027)
// — so this test's only observable is whether `compile` accepts or rejects
// each pattern, and the exact message for every rejection: `expected` pins
// the exact error text and byte offset for every invalid pattern below.

import { compile, mustCompile } from "std/regex"

// Prints "ok <pattern>" on success, or the caught error's message (already
// "regex: <reason> at offset <n>") on failure — the same one line either
// way, so `expected` reads as a flat list.
fn check(pattern: string) {
  let re = compile(pattern) catch e {
    println(e.message())
    return
  }
  println("ok ${pattern}")
}

fn main() {
  // --- every atom, quantifier, class form, both named-group spellings,
  // anchors and escapes -----------------------------------------------------
  check("abc")
  check("a|b|c")
  check("a*")
  check("a+")
  check("a?")
  check("a*?")
  check("a+?")
  check("a??")
  check(".")
  check("[abc]")
  check("[a-z]")
  check("[^a-z]")
  check("[a-zA-Z0-9_]")
  check("\\d")
  check("\\D")
  check("\\w")
  check("\\W")
  check("\\s")
  check("\\S")
  check("[[:alpha:]]")
  check("[[:digit:][:space:]]")
  check("(abc)")
  check("(?:abc)")
  check("(?<name>abc)")
  check("(?P<name>abc)")
  check("^abc$")
  check("\\Aabc\\z")
  check("\\bword\\B")
  check("a\\.b")
  check("\\(\\)\\[\\]\\{\\}\\|\\*\\+\\?\\.\\\\")
  check("(a(b)c)")
  check("(a|b)*")
  check("[\\d\\s]")
  check("[^\\d]")
  check("[]a]")
  check("[a-]")

  // --- malformed patterns compile() must reject -----------------------------
  check("(")
  check("a)")
  check("[a")
  check("[z-a]")
  check("a\\")
  check("\\q")
  check("\\1")
  check("*a")
  check("a**")
  check("(?<1a>x)")
  check("[[:bogus:]]")
  check("a{2,3}")
  check("(?i)a")
  check("x(?<=y)")
  check("xy(?P<>z)")
  check("(?:abc")
  check("[\\d-z]")

  // --- pattern()/groupCount() -----------------------------------------------
  let re = mustCompile("(a)(?<b>c)(?:d)")
  println("pattern=${re.pattern()}")
  println("groupCount=${re.groupCount()}")
}
