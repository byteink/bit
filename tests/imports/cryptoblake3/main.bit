// std/crypto BLAKE3 (#1171): the official test-vector inputs (byte i is i % 251)
// checked against the reference digests for the default hash, keyed_hash, and
// derive_key modes, plus an extended XOF draw, the `Hash`-interface conformance
// (size/blockSize, `digest`, and a keyed hasher through `digest`), a streaming
// vs one-shot proof, and the 32-byte key-length guard. The lengths span every
// boundary that matters: empty, sub-block, exactly one block (64), one chunk
// (1024), and the first two/three-chunk trees (1025, 2048, 3072). Every value is
// deterministic, so `expected` is stable.
import {
  Hash, digest, encodeHex,
  newBlake3, newBlake3Keyed, newBlake3DeriveKey,
  blake3Hash, blake3KeyedHash, blake3DeriveKey, blake3Xof,
} from "std/crypto"

// The official BLAKE3 test-vector input of length `n`: byte i is i % 251.
function mkInput(n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = u8(i % 251)
    i = i + 1
  }
  return b
}

// Hex digest of `msg` fed to `h` in `step`-byte slices, exercising the chunk and
// block buffers across many small writes.
function streamHex(h: Hash, msg: []byte, step: int): string {
  let lo = 0
  while (lo < len(msg)) {
    let hi = lo + step
    if (hi > len(msg)) {
      hi = len(msg)
    }
    h.write(msg[lo:hi])
    lo = hi
  }
  return encodeHex(h.sum())
}

// One-shot keyed hash as hex; fallible because the key length is validated.
function keyedHex(key: []byte, inp: []byte): string! {
  return encodeHex(blake3KeyedHash(key, inp)?)
}

// A keyed hasher driven through the `Hash` interface (`digest` = reset+write+sum),
// which must reproduce the one-shot keyed hash.
function keyedIfaceHex(key: []byte, inp: []byte): string! {
  let h = newBlake3Keyed(key)?
  return encodeHex(digest(h, inp))
}

function main() {
  let key = []byte("whats the Elvish word for friend")
  let ctx = "BLAKE3 2019-12-27 16:29:52 test vectors context"

  // Default hash across the boundary-relevant lengths.
  let lens = []int{ 0, 1, 64, 65, 1024, 1025, 2048, 3072 }
  let li = 0
  while (li < len(lens)) {
    let n = lens[li]
    println("hash[${n}]=${encodeHex(blake3Hash(mkInput(n)))}")
    li = li + 1
  }

  // Keyed hash (a MAC) at a single-chunk and a multi-chunk length.
  let k1024 = keyedHex(key, mkInput(1024)) catch e { "ERR" }
  let k3072 = keyedHex(key, mkInput(3072)) catch e { "ERR" }
  println("keyed[1024]=${k1024}")
  println("keyed[3072]=${k3072}")

  // Key derivation with a context string.
  println("derive[1024]=${encodeHex(blake3DeriveKey(ctx, mkInput(1024)))}")
  println("derive[3072]=${encodeHex(blake3DeriveKey(ctx, mkInput(3072)))}")

  // Extendable output: a 64-byte draw whose first 32 bytes are the plain digest.
  println("xof1024_64=${encodeHex(blake3Xof(mkInput(1024), 64))}")

  // Hash-interface conformance and a streaming vs one-shot proof.
  let h = newBlake3()
  println("size=${h.size()} block=${h.blockSize()}")
  println("iface_empty=${encodeHex(digest(newBlake3(), mkInput(0)))}")
  let msg = mkInput(3072)
  println("stream_matches=${streamHex(newBlake3(), msg, 7) == encodeHex(blake3Hash(msg))}")

  // A keyed hasher reused via `digest` reproduces the one-shot keyed MAC.
  let ki = keyedIfaceHex(key, mkInput(2048)) catch e { "ERR" }
  let ko = keyedHex(key, mkInput(2048)) catch e { "ERR2" }
  println("iface_keyed_ok=${ki == ko}")

  // The keyed constructor rejects a key that is not exactly 32 bytes.
  let bad = keyedHex([]byte(16), mkInput(1)) catch e { "rejected" }
  println("badkey=${bad}")
}
