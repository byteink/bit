// Structural conformance to `std/crypto`'s `Aead` interface (#1181).
//
// `Stub` is not a real cipher: it XORs each byte with a fixed pad and appends a
// one-byte XOR-fold "tag". Because Bit interfaces are structural (§14.3), owning
// the four `Aead` methods is all it takes to be an `Aead` — no `implements`
// clause. Every operation below dispatches through an `Aead`-typed *parameter*
// (the concrete `Stub` is widened to `Aead` at each call, exactly as the crypto
// `Hash` tests pass a concrete digest to `digest(h: Hash, ...)`), which proves:
//   1. `Stub` satisfies `Aead` (it typechecks as one at every call site);
//   2. seal -> open round-trips through the interface (open recovers the
//      plaintext) and `nonceSize`/`overhead` dispatch;
//   3. the fallible `open` method, dispatched on an interface value, FAILS on a
//      corrupted ciphertext rather than return unauthenticated plaintext —
//      proving fallible-method dispatch (and `?` propagation) through `Aead`.
import { Aead } from "std/crypto"

class Stub {
  pad: byte
}

// Encrypt: XOR each byte with the pad, then append a 1-byte authentication tag
// (the XOR-fold of the produced ciphertext bytes). Overhead is that one byte.
fn (s: Stub) seal(nonce: []byte, plaintext: []byte, aad: []byte): []byte {
  let out = []byte(len(plaintext) + 1)
  let tag: byte = 0
  let i = 0
  while (i < len(plaintext)) {
    let c = plaintext[i] ^ s.pad
    out[i] = c
    tag = tag ^ c
    i = i + 1
  }
  out[len(plaintext)] = tag
  return out
}

// Decrypt: verify the trailing tag; on mismatch FAIL — never return plaintext.
fn (s: Stub) open(nonce: []byte, ciphertext: []byte, aad: []byte): []byte! {
  if (len(ciphertext) < 1) {
    fail newError("open: ciphertext shorter than the tag")
  }
  let n = len(ciphertext) - 1
  let out = []byte(n)
  let tag: byte = 0
  let i = 0
  while (i < n) {
    let c = ciphertext[i]
    tag = tag ^ c
    out[i] = c ^ s.pad
    i = i + 1
  }
  if (tag != ciphertext[n]) {
    fail newError("open: authentication failed")
  }
  return out
}

fn (s: Stub) nonceSize(): int {
  return 12
}

fn (s: Stub) overhead(): int {
  return 1
}

// The interface-dispatch surface: each helper takes an `Aead` value and calls a
// method through it, so passing a `Stub` proves structural conformance.
fn tagOverhead(a: Aead): int {
  return a.overhead()
}

fn requiredNonce(a: Aead): int {
  return a.nonceSize()
}

fn sealWith(a: Aead, nonce: []byte, msg: []byte, aad: []byte): []byte {
  return a.seal(nonce, msg, aad)
}

// Fallible-method dispatch on an interface value: `?` propagates open's failure.
fn openWith(a: Aead, nonce: []byte, ct: []byte, aad: []byte): []byte! {
  return a.open(nonce, ct, aad)?
}

// True iff `open` accepts `ct` through the interface; the catch diverts, so a
// failure is observable as false without inspecting the (discarded) plaintext.
fn accepts(a: Aead, nonce: []byte, ct: []byte, aad: []byte): bool {
  openWith(a, nonce, ct, aad) catch e {
    return false
  }
  return true
}

fn main() {
  let s = Stub{ pad: 0x5a }
  let nonce = []byte(12)
  let aad = []byte(0)

  let msg = []byte(3)
  msg[0] = 1
  msg[1] = 2
  msg[2] = 3

  // seal appends exactly `overhead` bytes; both dispatch through `Aead`.
  let ct = sealWith(s, nonce, msg, aad)
  println("overhead=${tagOverhead(s)} nonceSize=${requiredNonce(s)}")
  println("sealedLen=${len(ct) == len(msg) + tagOverhead(s)}")

  // open round-trips: the recovered plaintext equals the input.
  let pt = openWith(s, nonce, ct, aad) catch e {
    println("open failed: ${e.message()}")
    return
  }
  let same = len(pt) == 3 && pt[0] == 1 && pt[1] == 2 && pt[2] == 3
  println("roundtrip=${same}")

  // A single flipped ciphertext byte breaks the tag: open must FAIL.
  let bad = []byte(len(ct))
  let j = 0
  while (j < len(ct)) {
    bad[j] = ct[j]
    j = j + 1
  }
  bad[0] = bad[0] ^ 0xff
  println("tamperRejected=${!accepts(s, nonce, bad, aad)}")
}
