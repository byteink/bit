// std/uuid (#1211): RFC 9562 known-answer vectors and invariants, all
// cross-checked against Python's `uuid` module.
//
//   uuidV5(NAMESPACE_DNS, "www.example.com") -> 2ed6657d-e927-568b-95e1-2665a8aea6a2
//   uuidV5(NAMESPACE_DNS, "example.com")     -> cfbff0d1-9375-5685-968c-48ce8b15ae17
//
// v4/v7 carry random bits, so only their fixed version/variant nibbles and (for
// v7) the time ordering of two successive values are asserted.
import { uuidV4, uuidV5, uuidV7, parse, format, equals, nilUUID, maxUUID, namespaceDNS, namespaceURL, namespaceOID, namespaceX500 } from "std/uuid"
import { sleep, Millisecond } from "std/time"

function main() {
  // The four RFC 9562 predefined namespaces.
  println("dns=${format(namespaceDNS())}")
  println("url=${format(namespaceURL())}")
  println("oid=${format(namespaceOID())}")
  println("x500=${format(namespaceX500())}")

  // The Nil and Max special UUIDs.
  println("nil=${format(nilUUID())}")
  println("max=${format(maxUUID())}")

  // Name-based v5 known-answer vectors.
  let v5 = uuidV5(namespaceDNS(), "www.example.com")
  println("v5=${format(v5)}")
  println("v5ver=${v5.version()}")
  println("v5var=${v5.variant()}")
  println("v5b=${format(uuidV5(namespaceDNS(), "example.com"))}")

  // parse/format round-trip: the recovered value equals the original.
  let rt = parse(format(v5)) catch nilUUID()
  println("roundtrip=${equals(rt, v5)}")

  // Malformed input is rejected, not guessed.
  let bad = parse("xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx") catch nilUUID()
  println("rejectbad=${equals(bad, nilUUID())}")

  // v4: random, but the version nibble is 4 and the variant is RFC (2).
  let v4 = uuidV4()
  println("v4ver=${v4.version()}")
  println("v4var=${v4.variant()}")

  // v7: version nibble 7, RFC variant, and time-ordering — two values drawn a
  // clock tick apart increase. (v7 is monotonic to the clock's sub-ms
  // resolution; a deliberate gap makes the assertion independent of it.)
  let a = uuidV7()
  sleep(2 * Millisecond)
  let b = uuidV7()
  println("v7ver=${a.version()}")
  println("v7var=${a.variant()}")
  println("v7inc=${a.hi < b.hi || (a.hi == b.hi && a.lo < b.lo)}")
}
