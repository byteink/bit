// std/crypto MD5 (#1169): the four RFC 1321 §A.5 known-answer vectors through the
// one-shot `digest`, plus a streaming-vs-one-shot check over a >64-byte message
// fed in odd 7-byte chunks. MD5 is broken (interop only); these vectors just
// prove the implementation is bit-exact.
import { newMd5, digest, encodeHex } from "std/crypto"

// Hex of the MD5 digest of `msg`, one-shot through the `Hash` interface.
fn md5hex(msg: string): string {
  return encodeHex(digest(newMd5(), []byte(msg)))
}

fn main() {
  // RFC 1321 §A.5 test vectors.
  println("empty=${md5hex("")}")
  println("abc=${md5hex("abc")}")
  println("digest=${md5hex("message digest")}")
  println("alpha=${md5hex("abcdefghijklmnopqrstuvwxyz")}")

  // Streaming must equal one-shot. This message is 85 bytes (>1 block), fed in
  // odd 7-byte chunks so block boundaries fall mid-chunk.
  let msg = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs."
  let bytes = []byte(msg)
  let h = newMd5()
  h.reset()
  let i = 0
  let step = 7
  while (i < len(bytes)) {
    let end = i + step
    if (end > len(bytes)) {
      end = len(bytes)
    }
    h.write(bytes[i:end])
    i = end
  }
  println("streamEq=${encodeHex(h.sum()) == md5hex(msg)}")
}
