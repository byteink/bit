// std/regex `Regex.split(s, limit)` (#2036). Prints a leading "count=N" and
// each piece bracketed, so an empty piece ("[]") is visible rather than a
// blank that could be mistaken for a skipped case. Every expected value
// below was cross-checked against Go's `(*Regexp).Split` (go1.27.0) before
// being pinned — see the comment on each block for how.

import { mustCompile } from "std/regex"

fn split(pattern: string, s: string, limit: int): string {
  let re = mustCompile(pattern)
  let pieces = re.split(s, limit)
  let out = "count=${len(pieces)}"
  let i = 0
  // Bounded by `len(pieces)`, itself bounded by `split`'s own
  // `len(s) + 1`-bounded scan.
  while (i < len(pieces)) {
    out = out + " [${pieces[i]}]"
    i = i + 1
  }
  return out
}

fn main() {
  // --- a simple separator, and the four `limit` shapes: unlimited, zero,
  // and two positive caps where the LAST piece absorbs the remainder ------
  println(split(",", "a,b,c", -1)) // count=3 [a] [b] [c]
  println(split(",", "a,b,c", 0))  // count=0
  println(split(",", "a,b,c", 1))  // count=1 [a,b,c] — remainder untouched
  println(split(",", "a,b,c", 2))  // count=2 [a] [b,c]

  // --- a match at offset 0 yields a leading empty piece; a match ending
  // at len(s) yields a trailing one; neither is dropped -------------------
  println(split(",", ",ab", -1)) // count=2 [] [ab]
  println(split(",", "ab,", -1)) // count=2 [ab] []

  // --- consecutive matches produce an empty piece between them -----------
  println(split(",", "a,,b", -1)) // count=3 [a] [] [b]

  // --- a non-empty-source pattern against an EMPTY subject is a Go-verbatim
  // special case: always one empty piece, never zero, regardless of
  // whether the pattern could match "" itself ------------------------------
  println(split("\\s+", "", -1)) // count=1 []

  // --- an empty-matching pattern splits BETWEEN every rune rather than
  // looping forever — and, matching Go exactly, the zero-width matches
  // sitting right at offset 0 and at len(s) do NOT produce extra empty
  // pieces the way a non-empty match at those same offsets would: splitting
  // "abc" on the empty pattern gives 3 pieces, not 5 ------------------------
  println(split("", "abc", -1)) // count=3 [a] [b] [c]

  // --- a subject with no match returns a single piece: the whole subject -
  println(split("z", "abc", -1)) // count=1 [abc]

  // --- UTF-8: a piece boundary sitting right next to a multi-byte
  // character must not split the character itself -------------------------
  println(split(",", "é,è", -1)) // count=2 [é] [è]
}
