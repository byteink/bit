import { sqrt, pow, log, log2, log10, atan2, floor, ceil, round, trunc, abs, clamp, sign, pi } from "std/math"
import { iabs, imin, imax, ipow, gcd } from "std/math"

function main() {
  println("sqrt=${sqrt(9.0)} pow=${pow(2.0, 10.0)}")
  println("log2=${log2(1000.0)} log10=${log10(1000.0)} log=${log(1.0)}")
  println("atan2=${atan2(1.0, 1.0) == pi / 4.0}")
  println("floor=${floor(-2.5)} ceil=${ceil(-2.5)} round=${round(-2.5)} trunc=${trunc(-2.5)}")
  println("abs=${abs(-3.5)} clamp=${clamp(9.0, 0.0, 5.0)} sign=${sign(-0.5)}")
  println("iabs=${iabs(-7)} imin=${imin(3, 9)} imax=${imax(3, 9)}")
  println("ipow=${ipow(3, 5)} gcd=${gcd(48, 18)}")
}
