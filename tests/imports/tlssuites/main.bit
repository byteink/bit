// std/tls cipher-suite registry, wired to std/crypto (#1201).
//
// A binding/wiring test, not a crypto test — the AEAD and hash math are
// KAT-verified in std/crypto. For each of the three mandatory TLS 1.3 suites it
//   1. looks the descriptor up by code point (`tlsSuiteById`);
//   2. builds the suite's AEAD from a suite-length test key and round-trips a
//      message seal -> open through the `Aead` interface (open must recover the
//      exact plaintext);
//   3. checks the suite's `Hash` really produces `hashLen` bytes; and
//   4. asserts the descriptor's key / iv / tag lengths match the built AEAD's
//      key length and reported `nonceSize`/`overhead`.
// It also confirms the preference list is the three suites in order and that an
// unknown code point fails.
import { Aead, Hash } from "std/crypto"
import { CipherSuite, tlsSuiteById, tlsSuitePreference, tlsSuiteNewAead, tlsSuiteNewHash, TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256 } from "std/tls"

// A deterministic `n`-byte key: byte i = i + 1, so no zero key and every suite
// gets a distinct-length buffer.
function testKey(n: int): []byte {
  let k = []byte(n)
  let i = 0
  while (i < n) {
    k[i] = byte(i + 1)
    i = i + 1
  }
  return k
}

// True iff two byte slices are equal length and content.
function bytesEqual(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// True iff building the suite's AEAD from `key` succeeds; the catch diverts so a
// failure is observable as a bool without inspecting the (discarded) result.
function aeadBuilds(suite: CipherSuite, key: []byte): bool {
  tlsSuiteNewAead(suite, key) catch e {
    return false
  }
  return true
}

// True iff `id` resolves to a registered suite.
function suiteKnown(id: int): bool {
  tlsSuiteById(id) catch e {
    return false
  }
  return true
}

// Exercise one suite end to end; prints a single PASS/FAIL line per suite.
function checkSuite(id: int) {
  let suite = tlsSuiteById(id) catch e {
    println("suite ${id}: lookup failed: ${e.message()}")
    return
  }

  // Build the AEAD from a suite-length key and round-trip a message through the
  // `Aead` interface.
  let key = testKey(suite.keyLen)
  let aead = tlsSuiteNewAead(suite, key) catch e {
    println("${suite.name}: aead build failed: ${e.message()}")
    return
  }
  let nonce = []byte(suite.ivLen)
  let aad = []byte(3)
  aad[0] = 0x17 // a stand-in TLS record type, just some AAD
  let msg = []byte(5)
  let m = 0
  while (m < 5) {
    msg[m] = byte(0x40 + m)
    m = m + 1
  }

  let sealed = aead.seal(nonce, msg, aad)
  let opened = aead.open(nonce, sealed, aad) catch e {
    println("${suite.name}: open failed: ${e.message()}")
    return
  }

  // The built AEAD's own reported sizes must match the descriptor.
  let ivOk = aead.nonceSize() == suite.ivLen
  let tagOk = aead.overhead() == suite.tagLen
  let keyOk = len(key) == suite.keyLen
  let roundtrip = bytesEqual(opened, msg)
  let sealLenOk = len(sealed) == len(msg) + suite.tagLen

  // The suite's hash must emit exactly `hashLen` bytes.
  let h = tlsSuiteNewHash(suite)
  h.reset()
  h.write(msg)
  let hashOk = len(h.sum()) == suite.hashLen && h.size() == suite.hashLen

  let ok = ivOk && tagOk && keyOk && roundtrip && sealLenOk && hashOk
  println("${suite.name}: keyLen=${suite.keyLen} ivLen=${suite.ivLen} tagLen=${suite.tagLen} hashLen=${suite.hashLen} ok=${ok}")
}

function main() {
  checkSuite(TLS_AES_128_GCM_SHA256)
  checkSuite(TLS_AES_256_GCM_SHA384)
  checkSuite(TLS_CHACHA20_POLY1305_SHA256)

  // Preference order: ChaCha20-Poly1305 first (software stack, no AES-NI — see
  // tlsSuitePreference), then AES-256-GCM, then AES-128-GCM.
  let pref = tlsSuitePreference()
  let orderOk = len(pref) == 3 && pref[0].id == TLS_CHACHA20_POLY1305_SHA256 && pref[1].id == TLS_AES_256_GCM_SHA384 && pref[2].id == TLS_AES_128_GCM_SHA256
  println("preference ok=${orderOk}")

  // A wrong-length key is rejected cleanly rather than panicking.
  let suite = tlsSuiteById(TLS_AES_128_GCM_SHA256) catch e {
    println("unexpected: ${e.message()}")
    return
  }
  println("badKeyRejected=${!aeadBuilds(suite, []byte(8))}")

  // An unregistered code point fails.
  println("unknownRejected=${!suiteKnown(0x0000)}")
}
