// #2345: `jsonMaxDepth` is a RECURSION bound, and the bound that matters is the
// one a GREEN THREAD's stack can take, not main's.
//
// `parseValue` calls `parseObject`/`parseArray`, which call `parseValue` back,
// so an accepted nesting depth is that many stack frames. A green thread's
// stack is fixed and much smaller than main's (#2246). When the cap was raised
// to 1000 for #2256, a ~250-level document parsed fine on the main thread and
// SIGSEGVed inside `spawn` — which is where every HTTP handler runs. A clean
// "max nesting depth exceeded" had become a remote crash.
//
// This test lives under tests/imports/ and not tests/cases/ ON PURPOSE: a
// golden case is single-file with no prelude and cannot import std/json, so a
// case-based test can only exercise a local copy of the parser and would stay
// green while the real module regressed. This one drives the shipped module.
//
// It must run the deep parse INSIDE a spawn. The same parse on the main thread
// passes at depths that kill a green thread, so a main-thread-only test reports
// a ceiling roughly 3x too high and walks straight back into the bug.
import { jsonParse, jsonMaxDepth } from "std/json"

function nest(depth: int): string {
  let b: []byte = []
  for (let i = 0; i < depth; i = i + 1) { b = append(b, '[') }
  b = append(b, '1')
  for (let i = 0; i < depth; i = i + 1) { b = append(b, ']') }
  return string(b)
}

// Parses in a spawned task and reports the outcome over a channel. Reaching the
// send at all is most of the point: the regression killed the whole process
// here, so a crash shows up as no output rather than as a wrong value.
function parseInSpawn(txt: string, out: chan<string>) {
  let v = jsonParse(txt) catch e {
    out <- "rejected"
    return
  }
  out <- "accepted"
}

function runInSpawn(txt: string): string {
  let c = chan<string>(1)
  spawn parseInSpawn(txt, c)
  return <- c
}

function main() {
  // The cap must stay inside what a green thread survives. Measured on this
  // tree: depth 220 survived a spawn, depth 250 did not. Assert the constant
  // rather than the measurement, so this fails loudly if someone raises it.
  println("capWithinStack=${jsonMaxDepth <= 200}")

  // Just under the cap: must parse, inside a spawn, without dying.
  println("underCap=${runInSpawn(nest(jsonMaxDepth - 1))}")

  // Exactly at the cap: still legal, the (cap+1)th open is what is refused.
  println("atCap=${runInSpawn(nest(jsonMaxDepth))}")

  // Over the cap: must be REJECTED cleanly. Before the fix this was the
  // SIGSEGV — the process died and printed nothing at all.
  println("overCap=${runInSpawn(nest(jsonMaxDepth + 1))}")

  // Far over the cap, the shape that actually crashed: ~600 levels is what an
  // attacker sends. Must still be a clean rejection, not a signal.
  println("farOverCap=${runInSpawn(nest(600))}")

  // #2256's original complaint, restated as a floor: an object nested inside an
  // array costs two depth units, so the cap must clear an ordinary 33-level
  // recursive structure (a category tree, a comment thread) with room to spare.
  println("clears33Levels=${jsonMaxDepth >= 66}")
}
