// Control characters in header values (#2169): a bare LF inside a header
// value is not a line terminator to this parser, so it used to stay embedded
// in that header's value — and anything after it rode along as
// attacker-controlled text once a handler reflected the value into a
// response, injecting arbitrary response header lines (Set-Cookie, CORS,
// response splitting). readMessage now rejects the whole message instead.
//
// Driven over a raw std/net socket so the wire bytes are exactly the bare-LF
// attack, not what a well-behaved client API would ever construct. The raw
// response is reduced to its status line and body before printing — never the
// literal bytes — so `expected` holds no wire CRLFs for this repo's
// `core.autocrlf=input` to silently rewrite to LF.
import { serve, Server, Exchange, Response, header } from "std/http"
import { dial } from "std/net"
import { indexOf } from "std/strings"

function dispatch(ex: Exchange) {
  let rid = header(ex.request.headers, "x-request-id")
  let res = Response{
    status: 200,
    contentType: "text/plain",
    headers: "X-Request-Id: ${rid}\r\n",
    body: "ok",
  }
  ex.respond(res) catch e {
    return
  }
}

function serveLoop(s: Server, n: int, ready: chan<int>): ()! {
  ready <- 0
  let i = 0
  while (i < n) {
    let ex = s.accept()?
    spawn dispatch(ex)
    i = i + 1
  }
  s.close()
}

function statusOf(raw: string): string {
  let eol = indexOf(raw, "\r\n")
  if (eol < 0) {
    return raw
  }
  return raw[0:eol]
}

function bodyOf(raw: string): string {
  let sep = indexOf(raw, "\r\n\r\n")
  if (sep < 0) {
    return ""
  }
  return raw[sep + 4:len(raw)]
}

function raw(port: int, req: string): string {
  let c = dial("127.0.0.1", port) catch e {
    return "DIAL FAILED"
  }
  c.write(req) catch e {
    c.close()
    return "WRITE FAILED"
  }
  let r = c.readAll()
  c.close()
  return r
}

function attempt(port: int, label: string, req: string) {
  let r = raw(port, req)
  let injected = indexOf(r, "Set-Cookie") >= 0
  println("${label}: ${statusOf(r)} | injected-set-cookie=${injected} | ${bodyOf(r)}")
}

function main() {
  let s = serve("127.0.0.1", 0) catch e {
    println("serve failed: ${e.message()}")
    return
  }
  let port = s.port() catch e {
    println("port failed: ${e.message()}")
    return
  }
  let ready = chan<int>(1)
  spawn serveLoop(s, 2, ready)
  let started = <- ready

  attempt(
    port,
    "case1 bare LF in header value",
    "GET / HTTP/1.1\r\nHost: x\r\nX-Request-Id: legit\nSet-Cookie: admin=1\nX-Injected: yes\r\nConnection: close\r\n\r\n",
  )
  attempt(
    port,
    "case2 ordinary request still works",
    "GET / HTTP/1.1\r\nHost: x\r\nX-Request-Id: legit\r\nConnection: close\r\n\r\n",
  )
}
