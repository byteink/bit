// Structural conformance to `std/crypto`'s `Hash` interface (#1164).
//
// `Stub` is not a real hash: it counts the bytes it is fed and always returns a
// fixed 4-byte digest. Because Bit interfaces are structural (§14.3), owning the
// five `Hash` methods is all it takes to be a `Hash` — no `implements` clause.
// The program proves three things at runtime:
//   1. `Stub` satisfies `Hash` (it typechecks as one, both when passed to
//      `digest` and when bound to a `Hash`-typed variable);
//   2. `digest` dispatches reset -> write -> sum through the interface (the
//      returned bytes are exactly `Stub.sum`'s, and `fed` shows reset+write ran);
//   3. direct interface-value method calls dispatch too (`size`/`blockSize`).
import { Hash, digest } from "std/crypto"

class Stub {
  fed: int

  write(data: []byte) {
    this.fed = this.fed + len(data)
  }

  sum(): []byte {
    let out = []byte(4)
    out[0] = 0xde
    out[1] = 0xad
    out[2] = 0xbe
    out[3] = 0xef
    return out
  }

  reset() {
    this.fed = 0
  }

  size(): int {
    return 4
  }

  blockSize(): int {
    return 64
  }
}

fn main() {
  let s = Stub{ fed: 99 }

  let msg = []byte(3)
  msg[0] = 1
  msg[1] = 2
  msg[2] = 3

  // One-shot digest through the `Hash` interface: reset (fed -> 0), write
  // (fed -> 3), then sum (the fixed digest).
  let d = digest(s, msg)
  let ok = len(d) == 4 && d[0] == 0xde && d[1] == 0xad && d[2] == 0xbe && d[3] == 0xef
  println("digest=${ok}")
  println("fed=${s.fed}")

  // Direct interface-value dispatch, not routed through `digest`.
  let h: Hash = s
  println("size=${h.size()} blockSize=${h.blockSize()}")
}
