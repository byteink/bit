// std/crypto SHA-224 + SHA-256 (#1165): the FIPS 180-4 / NIST known-answer
// vectors, hex-compared via encodeHex, plus a streaming case that feeds a
// >64-byte message in odd-sized chunks and must match the one-shot digest. Every
// output is deterministic, so the golden `expected` is stable. This also pins
// the narrow-width (u32 wrap + rotate) codegen fix (#1158) across architectures:
// a wrong narrow wrap would corrupt these digests here.
import { newSha256, newSha224, digest, encodeHex, hwAvailableSha256 } from "std/crypto"

// One-shot SHA-256 of `s`, as lowercase hex.
function sha256hex(s: string): string {
  return encodeHex(digest(newSha256(), []byte(s)))
}

// One-shot SHA-224 of `s`, as lowercase hex.
function sha224hex(s: string): string {
  return encodeHex(digest(newSha224(), []byte(s)))
}

function main() {
  // Diagnostic only (stderr — see cryptoaes/main.bit for why this must never
  // be part of the portable golden `expected`).
  eprint("hwAvailableSha256=${hwAvailableSha256()}\n")

  // FIPS 180-4 known-answer vectors.
  println("sha256empty=${sha256hex("")}")
  println("sha256abc=${sha256hex("abc")}")
  println("sha256long=${sha256hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")}")
  println("sha224abc=${sha224hex("abc")}")

  // Streaming: feed a >64-byte message in several odd-sized chunks and confirm
  // it equals the one-shot digest — exercises block buffering across writes.
  let msg = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs."
  let bytes = []byte(msg)
  let h = newSha256()
  let sizes = []int{ 1, 7, 13, 31, 3, 25 }
  let off = 0
  let k = 0
  while (off < len(bytes)) {
    let take = sizes[k % len(sizes)]
    if (off + take > len(bytes)) {
      take = len(bytes) - off
    }
    h.write(bytes[off:off + take])
    off = off + take
    k = k + 1
  }
  let streamed = encodeHex(h.sum())
  let oneShot = sha256hex(msg)
  println("streamMatch=${streamed == oneShot}")
  println("streamHex=${streamed}")
}
