// std/crypto SHA-224 + SHA-256 (#1165): the FIPS 180-4 / NIST known-answer
// vectors, hex-compared via encodeHex, plus a streaming case that feeds a
// >64-byte message in odd-sized chunks and must match the one-shot digest. Every
// output is deterministic, so the golden `expected` is stable. This also pins
// the narrow-width (u32 wrap + rotate) codegen fix (#1158) across architectures:
// a wrong narrow wrap would corrupt these digests here.
//
// #2528 added the length sweep at the bottom. It is the acceptance corpus for
// routing the compression through the ARM64 SHA2 extension
// (`bit_rt_sha256_hw_blocks`, #2524) when `hwSha2()` is true, and it must print
// the same lines on the hardware and the software path — run it once as-is and
// once with `BIT_CRYPTO_HW=0`, which forces every hasher onto the software
// fallback (`stdlib/crypto/hw.bit`). The lengths bracket every seam the two
// paths can disagree on: the 64-byte block, the 56-byte padding threshold, an
// extra padding block, a lone whole block, and a 100000-byte message that is
// one 1562-block primitive call. The goldens were produced by Python's
// `hashlib`, an EXTERNAL oracle, not by either path here.
import { newSha256, newSha224, digest, encodeHex, hwAvailableSha256, hwSha2 } from "std/crypto"

// One-shot SHA-256 of `s`, as lowercase hex.
fn sha256hex(s: string): string {
  return encodeHex(digest(newSha256(), []byte(s)))
}

// A deterministic `n`-byte message: byte `i` is `(i * 37 + 11) mod 256`. The
// generator is duplicated in the `hashlib` script that produced the goldens,
// so the expected digests never came from this implementation.
fn corpus(n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = byte((i * 37 + 11) & 0xff)
    i = i + 1
  }
  return b
}

// `msg` fed to one hasher in chunks of the cycling sizes in `sizes`, as hex.
// The sizes are chosen so writes start mid-block, carry runs of whole blocks,
// and leave ragged tails — the three arms of `Sha256.write`, which is where a
// bulk hardware call and a byte-at-a-time software fill could diverge.
fn streamHex(msg: []byte, sizes: []int): string {
  let h = newSha256()
  let off = 0
  let k = 0
  while (off < len(msg)) {
    let take = sizes[k % len(sizes)]
    if (off + take > len(msg)) {
      take = len(msg) - off
    }
    h.write(msg[off:off + take])
    off = off + take
    k = k + 1
  }
  return encodeHex(h.sum())
}

// One line per length: the one-shot digest, and whether the chunked stream of
// the same message agrees with it.
fn sweep() {
  let lens = []int{
    0,
    1,
    55,
    56,
    57,
    63,
    64,
    65,
    119,
    120,
    127,
    128,
    129,
    191,
    192,
    1000,
    4096,
    100000,
  }
  let sizes = []int{ 1, 7, 13, 31, 3, 25, 64, 128, 100 }
  let i = 0
  while (i < len(lens)) {
    let msg = corpus(lens[i])
    let one = encodeHex(digest(newSha256(), msg))
    println("n=${lens[i]} d=${one} s=${streamHex(msg, sizes) == one}")
    i = i + 1
  }

  // SHA-224 shares the same compression and the same dispatch, and differs only
  // in IV and truncation — so it is the check that the hardware path was routed
  // for the shared code and not for SHA-256 alone.
  let lens224 = []int{ 0, 64, 1000 }
  i = 0
  while (i < len(lens224)) {
    println("n224=${lens224[i]} d=${encodeHex(digest(newSha224(), corpus(lens224[i])))}")
    i = i + 1
  }
}

// One-shot SHA-224 of `s`, as lowercase hex.
fn sha224hex(s: string): string {
  return encodeHex(digest(newSha224(), []byte(s)))
}

fn main() {
  // Diagnostic only (stderr — see cryptoaes/main.bit for why this must never
  // be part of the portable golden `expected`).
  eprint("hwAvailableSha256=${hwAvailableSha256()}\n")
  eprint("hwSha2=${hwSha2()}\n")

  // FIPS 180-4 known-answer vectors.
  println("sha256empty=${sha256hex("")}")
  println("sha256abc=${sha256hex("abc")}")
  println("sha256long=${sha256hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")}")
  println("sha224abc=${sha224hex("abc")}")

  // Streaming: feed a >64-byte message in several odd-sized chunks and confirm
  // it equals the one-shot digest — exercises block buffering across writes.
  let msg = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs."
  let bytes = []byte(msg)
  let h = newSha256()
  let sizes = []int{ 1, 7, 13, 31, 3, 25 }
  let off = 0
  let k = 0
  while (off < len(bytes)) {
    let take = sizes[k % len(sizes)]
    if (off + take > len(bytes)) {
      take = len(bytes) - off
    }
    h.write(bytes[off:off + take])
    off = off + take
    k = k + 1
  }
  let streamed = encodeHex(h.sum())
  let oneShot = sha256hex(msg)
  println("streamMatch=${streamed == oneShot}")
  println("streamHex=${streamed}")

  sweep()
}
