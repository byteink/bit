// std/crypto ECDSA (#1193): RFC 6979 deterministic sign + verify known-answer
// tests over NIST P-256/SHA-256 and P-384/SHA-384, plus DER round-trips.
//
// The P-256 (r, s) is RFC 6979 Appendix A.2.5 ("sample" / SHA-256) and the P-384
// (r, s) is Appendix A.2.6 ("sample" / SHA-384) — the canonical deterministic
// ECDSA vectors. Both were independently re-generated with Python `ecdsa`
// (`sign_deterministic`) before being locked here, so a miscompiled ladder or a
// wrong DRBG cannot quietly agree with itself. The public keys are the SEC 1
// uncompressed points from those same vectors; the message digests are recomputed
// in-Bit from "sample" to exercise the whole pipeline. The verify cases cover a
// valid signature (accept), a one-bit-tampered digest (reject), and a tampered
// `s` (reject) — the CAVP-style valid/invalid pair.
//
// The per-vector inputs are bundled in a `Vec` struct so `report` stays at two
// parameters: the x86_64 SysV backend passes arguments only in registers (no
// stack spill yet), and a struct is a reference type (one register), so this keeps
// the helper within the six-register budget on x64.
import {
  Curve, Point, Nat,
  EcdsaSignature,
  ecdsaPublicKey, ecdsaPrivateKey, ecdsaSign, ecdsaVerify,
  ecdsaSignatureToDer, ecdsaSignatureFromDer,
  nistecP256, nistecP384,
  Hash, newSha256, newSha384, digest,
  encodeHex, decodeHex,
  bigintCmp, bigintToBytes,
} from "std/crypto"

// One known-answer vector: the curve, its field width, the private scalar and
// SEC 1 public point (both hex), the message digest, and the reference DER.
struct Vec {
  name: string,
  curve: Curve,
  w: int,
  privHex: string,
  pubSec1: string,
  msgHash: []byte,
  wantDer: string,
}

// SHA-256 exposed as a `() => Hash` value (newSha256 returns the concrete Sha256).
function sha256Hash(): Hash { return newSha256() }

// Decode a known-good hex literal; the impossible malformed case degrades to an
// empty slice so callers never thread a fallible result.
function hx(s: string): []byte {
  return decodeHex(s) catch e { return []byte(0) }
}

// `n` as `w` fixed-width big-endian bytes, hex-encoded ("err" on overflow, which
// cannot happen for r, s < n of width `w`).
function fixedHex(n: Nat, w: int): string {
  let b = bigintToBytes(n, w) catch e { return "err" }
  return encodeHex(b)
}

// A fresh copy of `b` with its first byte's low bit flipped — a minimal tamper.
function flip0(b: []byte): []byte {
  let out = []byte(len(b))
  let i = 0
  while (i < len(b)) {
    out[i] = b[i]
    i = i + 1
  }
  if (len(out) > 0) {
    out[0] = out[0] ^ 0x01
  }
  return out
}

// Whether two points share both affine coordinates.
function sameKey(a: Point, b: Point): bool {
  return bigintCmp(a.x, b.x) == 0 && bigintCmp(a.y, b.y) == 0
}

// Sign `v.msgHash` under the vector's key, then report r, s, the derived-key
// check, the three verify outcomes, and the DER encode + parse round-trip.
function report(v: Vec, newHash: () => Hash) {
  println("${v.name}_digest=${encodeHex(v.msgHash)}")

  let priv = ecdsaPrivateKey(v.curve, hx(v.privHex)) catch e {
    println("${v.name}_err=priv")
    return
  }
  let pub = ecdsaPublicKey(v.curve, hx(v.pubSec1)) catch e {
    println("${v.name}_err=pub")
    return
  }
  println("${v.name}_pub_ok=${sameKey(priv.q, pub.q)}")

  let sig = ecdsaSign(priv, v.msgHash, newHash) catch e {
    println("${v.name}_err=sign")
    return
  }
  println("${v.name}_r=${fixedHex(sig.r, v.w)}")
  println("${v.name}_s=${fixedHex(sig.s, v.w)}")

  println("${v.name}_verify=${ecdsaVerify(pub, v.msgHash, sig)}")
  println("${v.name}_verify_badhash=${ecdsaVerify(pub, flip0(v.msgHash), sig)}")
  let badSig = EcdsaSignature{ r: sig.r, s: sig.r }
  println("${v.name}_verify_badsig=${ecdsaVerify(pub, v.msgHash, badSig)}")

  let der = ecdsaSignatureToDer(sig)
  println("${v.name}_der_match=${encodeHex(der) == v.wantDer}")
  let back = ecdsaSignatureFromDer(der) catch e {
    println("${v.name}_der_roundtrip=false")
    return
  }
  println("${v.name}_der_roundtrip=${bigintCmp(back.r, sig.r) == 0 && bigintCmp(back.s, sig.s) == 0}")
}

function main() {
  report(Vec{
    name: "p256",
    curve: nistecP256(),
    w: 32,
    privHex: "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721",
    pubSec1: "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299",
    msgHash: digest(newSha256(), []byte("sample")),
    wantDer: "3046022100efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716022100f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8",
  }, sha256Hash)

  report(Vec{
    name: "p384",
    curve: nistecP384(),
    w: 48,
    privHex: "6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5",
    pubSec1: "04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc138015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720",
    msgHash: digest(newSha384(), []byte("sample")),
    wantDer: "306602310094edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe4602310099ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8",
  }, newSha384)
}
