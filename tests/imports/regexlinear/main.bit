// Bit standard library test — std/regex ReDoS corpus, proving the Pike VM's
// linearity invariant (`stdlib/regex/pike.bit:397`,
// `assert(clist.count <= numInsts, "regex: pike VM thread count exceeded
// program size")`) actually gets exercised by the patterns that are
// classically exponential under a backtracking engine (Cox, "Regular
// Expression Matching Can Be Simple And Fast"). #2037. Sibling of
// `tests/imports/regexmatch`, whose `pathological()` already proves the
// point once at n=30 as a sanity check; this corpus is the dedicated one,
// at the six named patterns and at input lengths of 1000/2000/4000.
//
// Each pattern is matched, unanchored (`Regex.matches`), against
// `repeat(atom, n)` for n in {1000, 2000, 4000} — a run of the pattern's
// OWN repeated character, with no trailing anchor character present. For
// every pattern that requires one (the trailing `b`/`y`), that is the
// worst case: the VM must walk the full-length closure at every position
// before concluding failure, never short-circuiting on an early match.
//
// TWO DELIBERATE DEPARTURES FROM THE TICKET'S LITERAL TEXT, RECORDED HERE
// PER THE STANDING INSTRUCTION TO DISPROVE RATHER THAN SILENTLY PATCH A
// FALSE PREMISE:
//
// 1. The ticket says every input is "repetitions of 'a'". True for five of
//    the six patterns, but `(x+x+)+y`'s own repeated character is `x`, not
//    `a`. Feeding it an all-`a` string never enters the `x+x+` loop at all
//    — the very first rune already fails the `Op.Char('x')` test — so
//    `clist.count` never grows past 1 and the case would pass having
//    exercised nothing, exactly the failure mode the ticket's own Details
//    section warns against ("an assert nothing exercises proves nothing").
//    This file uses `repeat("x", n)` for that one pattern so its closure
//    genuinely reaches the same many-threads shape the other five do.
//
// 2. The fifth pattern (20 lazy... no, 20 GREEDY optional `a?`s then 20
//    mandatory `a`s) has no trailing anchor character to omit — it is not
//    of the `(...)b` shape the other five share. Run unanchored against a
//    string of `a`s it matches at offset 0, however long the input, rather
//    than failing. That is expected and is not a weaker test: to conclude
//    even a successful match, the VM must still resolve all 2^20 ways a
//    backtracker would assign each optional `a?` down to the closure's own
//    bounded thread count — exactly the shape that would trip the assert
//    if the sparse-set dedupe (`pike.bit`'s `PcSet`) were ever broken.
//
// TIMING: the ticket names `now()`; this file uses `monotonic()`/`since()`
// instead, the same pair `tests/imports/regexmatch`'s own `pathological()`
// already uses. `std/time`'s header (`time.bit:9-16`) says `now()` is "for
// dating an event, never for measuring an interval" — it can jump backward
// under NTP — and `monotonic()` is "the only clock that may measure
// elapsed time". Using the documented-wrong clock for an elapsed-time
// backstop is exactly the kind of bug this module exists to catch in OTHER
// code. The 10-second bound is a deliberately generous backstop, not a
// performance assertion (#2037's Constraints): it exists only to catch a
// linear step count where each step became absurdly expensive, which the
// thread-count assert cannot see on its own.
//
// A RED run here is real, but the two failure modes read differently. The
// linearity assert has a fixed location and message and cannot false-alarm
// — trust it immediately. The timing backstop can only ever be slow-machine
// noise: per CLAUDE.md's rule on trusting a timing failure, run `uptime`
// first and re-run the single failing pattern standalone before calling it
// a hang — load above ~20 on this 18-core box makes any timing here
// meaningless. Print only pass/fail, never a raw duration: a duration in
// `expected` would make this file's golden output machine-dependent.

import { mustCompile } from "std/regex"
import { repeat } from "std/strings"
import { monotonic, since, Second } from "std/time"

// The stopwatch backstop (see header for why `monotonic`/`since`, not the
// ticket-named `now`). Generous on purpose; never tighten this into a
// performance assertion — that is the benchmark harness's job, not this
// one's (#2037 Constraints).
const timeoutNs: int = 10 * Second

// Compiles `pattern` and runs it against `repeat(atom, n)` for every length
// in `lengths`, panicking if a single call exceeds `timeoutNs`. `matches`
// alone is enough: this corpus is about whether the VM finishes inside its
// own complexity bound, not about what it finds — see the header for why
// some of these six patterns match and some do not.
fn stress(pattern: string, atom: string) {
  let re = mustCompile(pattern)
  // The three input lengths this pattern is driven at.
  let lengths: []int = []int{ 1000, 2000, 4000 }
  let i = 0
  // Bounded by `lengths`'s fixed length, 3.
  while (i < len(lengths)) {
    let input = repeat(atom, lengths[i])
    let start = monotonic()
    re.matches(input)
    let elapsed = since(start)
    if (elapsed > timeoutNs) {
      panic("regexlinear: ${pattern} exceeded the 10s backstop")
    }
    i = i + 1
  }
  println("${pattern} ok")
}

// #3629's NESTED-CAPTURING-GROUP case: the same linearity promise broken
// from the other direction. The six patterns above are about the NUMBER of
// threads one position's closure produces, which `pike.bit`'s sparse-set
// dedupe bounds; this one is about the WORK done inside a single closure
// walk, which nothing above can see. `((( ... a ... )))` at depth `d` has
// `2d` `Save` instructions and `2(d+1)` capture slots, and the VM used to
// copy the whole slot array at every `Save` — O(d^2) per input position,
// so O(n*d^2) for a search. A 893-byte, 446-deep pattern took minutes on a
// 4 KiB subject: an attacker-supplied pattern is a denial-of-service
// primitive at that cost, which is why this is a gate and not a benchmark.
//
// THE SHAPE HERE IS LOAD-BEARING IN TWO WAYS A FUTURE EDIT COULD SILENTLY
// UNDO, both measured rather than assumed:
//
// 1. The subject must END in something the pattern cannot match (the
//    trailing "b" below, against a trailing `$`), so the search NEVER
//    matches and the VM walks a full closure at every one of the
//    `nestingInput` positions. Drop it and the pattern matches at offset 0,
//    one closure runs, and the case passes in microseconds having
//    exercised nothing — the same "an assert nothing exercises proves
//    nothing" failure the header warns about.
// 2. The pattern's required literal must be PRESENT at nearly every
//    position of the subject. #2052's prefilter (`prefilter.bit`) skips
//    seeding a thread at any position it can prove cannot begin a match, so
//    the obvious spelling — `((( ... a ... )))b` against a run of `a`s —
//    requires the literal "ab", finds it nowhere, and skips the whole
//    subject: measured at 8ms both with and without the fix, i.e. a case
//    that could never fail. Here the required literal is just "a", which
//    every position has.
//
// Sized for a wide margin in both directions on this box, measured against
// the pre-fix VM: 48.4s before the fix (4.8x over the backstop, so a
// regression is red even on a fast quiet machine) and 132ms after it (76x
// under, so fleet load cannot make it red by itself).
const nestingDepth: int = 1000
const nestingInput: int = 1000

// The nested-group case (see above). Kept separate from `stress` rather
// than folded into it: one input length is enough here — the axis under
// test is nesting depth, not input length — and the printed label must be
// short, since `stress` prints the pattern itself and this pattern is 2001
// bytes long.
fn stressNesting() {
  let re = mustCompile(repeat("(", nestingDepth) + "a" + repeat(")", nestingDepth) + "$")
  let input = repeat("a", nestingInput) + "b"
  let start = monotonic()
  re.matches(input)
  let elapsed = since(start)
  if (elapsed > timeoutNs) {
    panic("regexlinear: ${nestingDepth}-deep nested groups exceeded the 10s backstop")
  }
  println("nested x${nestingDepth} ok")
}

fn main() {
  stress("(a*)*b", "a")
  stress("(a|a)*b", "a")
  stress("(a+)+b", "a")
  stress("(a|aa)+b", "a")
  stress("a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?a?aaaaaaaaaaaaaaaaaaaa", "a")
  stress("(x+x+)+y", "x")
  stressNesting()
}
