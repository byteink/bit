// #3484: `Client.setHeader` sets a per-client default header honored by
// `Client.request`/`Client.requestWith`, but `Client.requestTimeout`,
// `Client.getTimeout` and `Client.postTimeout` called `requestTimeoutTls`
// (client.bit), which never read `c.headers` and had no headers parameter at
// all — so a header set with `setHeader` silently vanished on exactly the
// calls that also bound their own deadline, with no error and no warning.
//
// Each case spins up its own echo server (so a case can never see a
// previous case's connection reuse hide a regression) and checks the
// EXACT header value the server received, not merely that the call
// succeeded. Case 1 is the control proving the header still reaches the
// plain, non-timeout call; cases 2-4 check `requestTimeout`, `getTimeout`
// and `postTimeout` independently, since the ticket named all three and
// nothing guarantees they share a code path.
import {
  newClient, serve, listenAndServeOn, header, respond, Response, Request, Server, Client,
} from "std/http"

fn echoApiKey(req: Request): Response {
  return respond(200, header(req.headers, "X-Api-Key"))
}

fn serveEcho(s: Server) {
  listenAndServeOn(s, echoApiKey) catch e {
    println("server error: ${e.message()}")
  }
}

fn newEchoServer(): Server! {
  let s = serve("127.0.0.1", 0)?
  spawn serveEcho(s)
  return s
}

fn clientWithApiKey(): Client! {
  let c = newClient()
  c.setHeader("X-Api-Key", "k1")?
  return c
}

fn caseGet(): ()! {
  let s = newEchoServer()?
  let port = s.port()?
  let c = clientWithApiKey()?
  let res = c.get("http://127.0.0.1:${port}/")?
  println("case1 get             -> X-Api-Key=\"${res.body}\"")
}

fn caseRequestTimeout(): ()! {
  let s = newEchoServer()?
  let port = s.port()?
  let c = clientWithApiKey()?
  let res = c.requestTimeout("GET", "http://127.0.0.1:${port}/", "", 5000)?
  println("case2 requestTimeout  -> X-Api-Key=\"${res.body}\"")
}

fn caseGetTimeout(): ()! {
  let s = newEchoServer()?
  let port = s.port()?
  let c = clientWithApiKey()?
  let res = c.getTimeout("http://127.0.0.1:${port}/", 5000)?
  println("case3 getTimeout      -> X-Api-Key=\"${res.body}\"")
}

fn casePostTimeout(): ()! {
  let s = newEchoServer()?
  let port = s.port()?
  let c = clientWithApiKey()?
  let res = c.postTimeout("http://127.0.0.1:${port}/", "", 5000)?
  println("case4 postTimeout     -> X-Api-Key=\"${res.body}\"")
}

fn main() {
  caseGet() catch e {
    println("case1 failed: ${e.message()}")
  }
  caseRequestTimeout() catch e {
    println("case2 failed: ${e.message()}")
  }
  caseGetTimeout() catch e {
    println("case3 failed: ${e.message()}")
  }
  casePostTimeout() catch e {
    println("case4 failed: ${e.message()}")
  }
}
