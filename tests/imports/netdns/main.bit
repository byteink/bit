// Deterministic, network-free: a dotted-quad address resolves to itself, so this
// exercises the resolve() wiring without depending on a live nameserver. Real
// hostname lookups are covered by the runtime's DNS wire-format unit tests.
import { resolve } from "std/net"

fn run(): ()! {
  println(resolve("127.0.0.1")?)
  println(resolve("8.8.8.8")?)
  println(resolve("255.255.255.255")?)
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
