// Self-host readiness spike (#1331): a representative slice of the lexer, ported
// to Bit, to prove the language can express the compiler's real patterns — a
// large sum-type enum, a struct with methods, byte-level scanning over `s[i]`,
// string slicing, a growable `[]Token` via `append`, and `match`. It tokenizes a
// sample and prints one token per line (`<kind> <start> <end>`), mirroring the
// seed's `--dump-tokens`. Not the final lexer (that is #1334, differential-
// tested); this is the confidence check that the port is tractable.

enum Kind {
  Ident,
  Int,
  Plus,
  Minus,
  Star,
  Slash,
  Eq,
  LParen,
  RParen,
  Semi,
  Unknown,
  Eof,
}

struct Token {
  kind: Kind,
  start: int,
  end: int,
}

function isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

function isAlpha(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

function isAlnum(c: u8): bool {
  return isDigit(c) || isAlpha(c)
}

function opKind(c: u8): Kind {
  if (c == '+') { return Kind.Plus }
  if (c == '-') { return Kind.Minus }
  if (c == '*') { return Kind.Star }
  if (c == '/') { return Kind.Slash }
  if (c == '=') { return Kind.Eq }
  if (c == '(') { return Kind.LParen }
  if (c == ')') { return Kind.RParen }
  if (c == ';') { return Kind.Semi }
  return Kind.Unknown
}

// Tokenize `src` into a growable slice. Skips whitespace and `//` line comments;
// scans identifiers, integers, and single-character operators. Every loop is
// bounded by `len(src)` and advances at least one byte per iteration.
function lex(src: string): []Token {
  let toks: []Token = []Token(0)
  let i = 0
  let n = len(src)
  while (i < n) {
    let c = src[i]
    if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
      i = i + 1
      continue
    }
    if (c == '/' && i + 1 < n && src[i + 1] == '/') {
      while (i < n && src[i] != '\n') {
        i = i + 1
      }
      continue
    }
    if (isDigit(c)) {
      let start = i
      while (i < n && isDigit(src[i])) {
        i = i + 1
      }
      toks = append(toks, Token{ kind: Kind.Int, start: start, end: i })
      continue
    }
    if (isAlpha(c)) {
      let start = i
      while (i < n && isAlnum(src[i])) {
        i = i + 1
      }
      toks = append(toks, Token{ kind: Kind.Ident, start: start, end: i })
      continue
    }
    toks = append(toks, Token{ kind: opKind(c), start: i, end: i + 1 })
    i = i + 1
  }
  toks = append(toks, Token{ kind: Kind.Eof, start: n, end: n })
  return toks
}

function kindName(k: Kind): string {
  match (k) {
    Ident => { return "Ident" }
    Int => { return "Int" }
    Plus => { return "Plus" }
    Minus => { return "Minus" }
    Star => { return "Star" }
    Slash => { return "Slash" }
    Eq => { return "Eq" }
    LParen => { return "LParen" }
    RParen => { return "RParen" }
    Semi => { return "Semi" }
    Unknown => { return "Unknown" }
    Eof => { return "Eof" }
  }
}

function main() {
  let src = "let x = 42 + y // c\n(x);"
  let toks = lex(src)
  for t of toks {
    print("${kindName(t.kind)} ${t.start} ${t.end}\n")
  }
}
