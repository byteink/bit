// std/regex `Match` spans plus `Regex.find`/`Regex.findAll` (#2028). `find`
// prints "start,end,text" or "no match"; `findAll` prints one
// "[start,end,text]" per match on one line, with a leading count so an
// empty result is visible rather than a blank line that could be mistaken
// for a skipped case.

import { mustCompile, Regex, Match } from "std/regex"

fn find(pattern: string, s: string): string {
  let re = mustCompile(pattern)
  return match (re.find(s)) {
    Some(m) => "${m.start},${m.end},${m.text(s)}"
    None => "no match"
  }
}

fn findAll(pattern: string, s: string, limit: int): string {
  let re = mustCompile(pattern)
  let ms = re.findAll(s, limit)
  let out = "count=${len(ms)}"
  let i = 0
  // Bounded by `len(ms)`, itself bounded by `findAll`'s own `len(s) + 1`.
  while (i < len(ms)) {
    out = out + " [${ms[i].start},${ms[i].end},${ms[i].text(s)}]"
    i = i + 1
  }
  return out
}

fn main() {
  // --- find: a match at the start, in the middle, at the end, and none ----
  println(find("foo", "foobar"))
  println(find("bar", "foobarbaz"))
  println(find("baz", "foobarbaz"))
  println(find("xyz", "foobar"))

  // --- leftmost-first: two alternatives could both match at the winning
  // offset, and the earlier-listed one must win even when the other is
  // longer -----------------------------------------------------------------
  println(find("a|ab", "ab"))
  println(find("ab|a", "ab"))
  // ...and the winning THREAD must be the one that starts earliest, not
  // whichever branch is textually first, when only one branch can start at
  // the earlier offset.
  println(find("b|bc", "abc"))

  // --- anchors: ^ only matches true text start, not merely "the search
  // window's start", and $ only matches true text end -----------------------
  println(find("^foo", "foobar"))
  println(find("^bar", "foobar"))
  println(find("bar$", "foobar"))

  // --- find's span sliced back out of the subject with .text -------------
  let re = mustCompile("[0-9]+")
  let m = re.find("id=482;")
  match (m) {
    Some(mm) => println("slice: ${mm.text("id=482;")}")
    None => println("slice: no match")
  }

  // --- findAll: limit -1 (unbounded), 0, and a positive cap ---------------
  println(findAll("a", "banana", -1))
  println(findAll("a", "banana", 0))
  println(findAll("a", "banana", 2))

  // --- findAll of a pattern that can match empty: the classic
  // zero-width infinite-loop trap. `a*` over "bb" must yield three empty
  // matches, at byte offsets 0, 1 and 2 — never fewer, never a hang --------
  println(findAll("a*", "bb", -1))

  // --- findAll over UTF-8 input where an empty match sits between two
  // multi-byte characters: the offsets must land on rune boundaries (0, 2,
  // 4 for two 2-byte runes), never mid-character (1 or 3) -------------------
  println(findAll("x*", "éè", -1))

  // --- findAll finding REAL matches over UTF-8 input, byte spans covering
  // each rune's actual width -------------------------------------------------
  println(findAll(".", "aéb", -1))

  // --- a resumed findAll search still sees real "before" context for \b,
  // not "nothing yet": the "foo" inside "xfoo" must NOT match, since it is
  // not preceded by a word boundary, even though the search resumes
  // mid-string right after the previous "foo" -------------------------------
  println(findAll("\\bfoo\\b", "foo foo xfoo foo", -1))
}
