// Writing to a socket whose peer has closed must NOT kill the process. Without
// SIGPIPE ignored at runtime boot, such a write raises SIGPIPE (default: terminate
// with no output — an exit-141 crash), so a single client that hangs up mid-
// response would take down the whole server. With it ignored the write returns a
// clean error and the server survives (#1265).
//
// Deterministic by construction: the server reads to EOF first, so the peer is
// provably gone before it writes; whether a given write buffers or returns the
// error varies, so the test asserts only the invariant that matters — the process
// reaches the end and prints `survived`. If SIGPIPE were live, that line would
// never print and the exit code would be 141.
import { listen, dial } from "std/net"
import { sleep, Millisecond } from "std/time"

const port: int = 47233

function server() {
  let l = listen("127.0.0.1", port) catch e {
    return
  }
  let c = l.accept() catch e {
    return
  }
  // Drain until the client's close shows up as EOF, so the following writes are
  // guaranteed to target a peer that is already gone.
  let waited = 0
  while (waited < 500) {
    let got = c.read(64)
    if (len(got) == 0) {
      break
    }
    waited = waited + 1
  }
  // Hammer the broken pipe. Any error is swallowed on purpose — the point is that
  // none of these may raise a signal that ends the process.
  let i = 0
  while (i < 2000) {
    c.write("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx") catch e {
      i = i + 1
      continue
    }
    i = i + 1
  }
}

function main() {
  spawn server()
  sleep(50 * Millisecond)
  let c = dial("127.0.0.1", port) catch e {
    print("dial failed\n")
    return
  }
  c.close() // close without reading — the server will write into a dead peer
  sleep(300 * Millisecond) // let the server hit the broken pipe (and, if buggy, die)
  print("survived\n")
}
