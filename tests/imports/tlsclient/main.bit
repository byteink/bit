// std/tls TLS 1.3 client (#1206): the RFC 8448 §3 "Simple 1-RTT Handshake" trace,
// replayed server-side. The client is pinned to RFC 8448's exact ClientHello and
// ephemeral X25519 key, then fed the trace's recorded ServerHello + encrypted
// flight. It derives the handshake secrets, verifies the server's RSA-PSS
// CertificateVerify over the real transcript and the server Finished MAC, reaches
// "connected", and decrypts the trace's post-handshake NewSessionTicket and
// application record to the exact RFC plaintext — proving the derived server
// application-traffic secret is byte-correct. (The trace's certificate is an
// expired self-signed test cert, so chain + hostname checks are skipped via
// insecureSkipVerify; the signature and MAC are still verified.)
//
// The second half proves server authentication actually rejects: against a live
// Bit server with a real throwaway PKI, three client misconfigurations — an
// untrusted trust store, a hostname mismatch, and an expired-clock time — each
// abort the handshake with an error instead of connecting.
import { decodeHex, encodeHex, pemEncode, Certificate } from "std/crypto"
import {
  TrustStore, newTrustStore, TlsClientConfig, TlsClientConn, tlsClientStart,
  TlsServerConfig, newTlsServerConfig, tlsServerStart,
  TlsGroup, GroupKeypair,
} from "std/tls"

// --- RFC 8448 §3 recorded values ---
const chHex: string = ""
const clientPrivHex: string = "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"
const clientPubHex: string = "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c"
const shHex: string = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"
const ccsHex: string = "140303000101"
const shRecordHex: string = ""
const nstRecordHex: string = ""
const appRecordHex: string = "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"

// --- throwaway PKI for the rejection paths ---
const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

fn hx(s: string): []byte { return decodeHex(s) catch e { return []byte(0) } }
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }
fn cat(a: []byte, b: []byte): []byte {
  let o = a
  let i = 0
  while (i < len(b)) { o = append(o, b[i]); i = i + 1 }
  return o
}
fn wrapHs(msg: []byte): []byte {
  let o = []byte(0)
  o = append(o, byte(22)); o = append(o, byte(3)); o = append(o, byte(3))
  o = append(o, byte(len(msg) >> 8)); o = append(o, byte(len(msg)))
  return cat(o, msg)
}

// The RFC 8448 §3 client, replayed against the trace's recorded server flight.
fn replay(): ()! {
  let kp = GroupKeypair{ priv: hx(clientPrivHex), keyShare: hx(clientPubHex) }
  let cfg = TlsClientConfig{
    serverName: "server",
    alpn: []string(0),
    trust: TrustStore{ roots: []Certificate(0) },
    insecureSkipVerify: true,
    nowUnix: 1500000000,
    groups: [TlsGroup.X25519],
    keyShareGroups: []TlsGroup(0),
    suites: [0x1301, 0x1303, 0x1302],
    clientHelloOverride: hx(chHex),
    ephemeralOverride: [kp],
  }
  let h = tlsClientStart(cfg)?
  let flight = cat(wrapHs(hx(shHex)), hx(ccsHex))
  flight = cat(flight, hx(shRecordHex))
  let step = h.processServerFlight(flight)?
  let conn = h.connection()?
  println("replay: connected=${step.done} suite=${conn.cipherSuiteId()} peerCerts=${len(conn.peerCertificates())}")
  let nst = conn.openApp(hx(nstRecordHex))?
  let app = conn.openApp(hx(appRecordHex))?
  println("replay: nstType=${nst.contentType} appType=${app.contentType}")
  println("replay: appData=${encodeHex(app.content)}")
}

// A client config over the throwaway PKI, with the given trust / hostname / clock.
fn badClient(trust: TrustStore, host: string, nowUnix: int): TlsClientConfig {
  return TlsClientConfig{
    serverName: host,
    alpn: ["h2"],
    trust: trust,
    insecureSkipVerify: false,
    nowUnix: nowUnix,
    groups: [TlsGroup.X25519],
    keyShareGroups: []TlsGroup(0),
    suites: []int(0),
    clientHelloOverride: []byte(0),
    ephemeralOverride: []GroupKeypair(0),
  }
}

// Drive a live Bit server against `cfg` and assert the client rejects the server
// during flight processing (certificate verification must fail closed).
fn expectReject(tag: string, cfg: TlsClientConfig, serverCfg: TlsServerConfig): ()! {
  let c = tlsClientStart(cfg)?
  let s = tlsServerStart(serverCfg)?
  let sstep = s.processClientHello(c.hello)?
  let step = c.processServerFlight(sstep.outbound) catch e {
    println("${tag}: rejected=true")
    return
  }
  println("${tag}: rejected=false connected=${step.done}")
}

fn run(): ()! {
  replay()?

  let goodTrust = newTrustStore(pemOf("CERTIFICATE", caHex))?
  let emptyTrust = TrustStore{ roots: []Certificate(0) }
  let serverCfg = newTlsServerConfig(pemOf("CERTIFICATE", leafHex), pemOf("PRIVATE KEY", keyHex), ["h2"])?

  expectReject("untrusted", badClient(emptyTrust, "localhost", 1800000000), serverCfg)?
  expectReject("badhost", badClient(goodTrust, "evil.example.org", 1800000000), serverCfg)?
  expectReject("expired", badClient(goodTrust, "localhost", 2200000000), serverCfg)?
}

fn main() { run() catch e { println("error: ${e.message()}") } }
