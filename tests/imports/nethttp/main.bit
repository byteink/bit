// HTTP/1.1 server and client over green threads (#353): a server routing on
// path and echoing POST bodies, driven by clients on the same runtime.
import { serve, get, post, ok, respond, header, Server, Exchange } from "std/http"
import { hasPrefix } from "std/strings"

fn handle(ex: Exchange): ()! {
  let req = ex.read()?
  if (req.method == "POST") {
    ex.respond(ok("echo:${req.body}"))?
    return
  }
  if (hasPrefix(req.path, "/echo/")) {
    ex.respond(ok(req.path[6:len(req.path)]))?
    return
  }
  if (req.path == "/") {
    ex.respond(ok("root"))?
    return
  }
  ex.respond(respond(404, "missing"))?
}

fn server(s: Server, n: int, ready: chan<int>): ()! {
  ready <- 0
  let i = 0
  while (i < n) {
    let ex = s.accept()?
    spawn handle(ex)
    i = i + 1
  }
  s.close()
}

fn run(): ()! {
  let s = serve("127.0.0.1", 0)?
  let port = s.port()?
  let ready = chan<int>(1)
  spawn server(s, 4, ready)
  let started = <- ready

  let base = "http://127.0.0.1:${port}"
  let r1 = get("${base}/")?
  println("${r1.status} ${r1.body}")
  let r2 = get("${base}/echo/bit")?
  println("${r2.status} ${r2.body}")
  let r3 = get("${base}/nope")?
  println("${r3.status} ${r3.body}")
  let r4 = post("${base}/submit", "payload")?
  println("${r4.status} ${r4.body}")
  println("content-type: ${header(r1.headers, "Content-Type")}")
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
