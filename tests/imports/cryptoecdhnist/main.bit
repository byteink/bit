// std/crypto ECDH over NIST P-256 / P-384 (#1194): known-answer tests.
//
// The two shared-secret vectors are the NIST CAVP ECC-CDH primitive test
// COUNT=0 answers for P-256 and P-384 (`KAS_ECC_CDH_PrimitiveTest`): our private
// scalar `dIUT`, the peer public point `QCAVS` in SEC 1 uncompressed form, and
// the expected shared x-coordinate `ZIUT`. Every value here was re-derived
// offline with an independent pure-integer EC point multiply before being locked
// into the sibling `expected` file, so a miscompiled ladder cannot quietly agree
// with itself.
//
// Coverage: both CAVP shared secrets; a tampered off-curve peer point that must
// be rejected (invalid-curve defense); the ECDH symmetry property over two
// freshly generated key pairs per curve (`shared(a, B) == shared(b, A)`), which
// exercises `ecdhnistGenerateKeypair` and the SEC 1 public encoding without
// depending on the non-deterministic RNG output; and the shape of a generated
// public key (0x04 uncompressed prefix, `1 + 2*size` length, `size`-byte scalar).
import {
  Curve, EcdhKeypair,
  nistecP256, nistecP384,
  ecdhnistGenerateKeypair, ecdhnistSharedSecret,
  encodeHex, decodeHex,
} from "std/crypto"

// The bytes of a big-endian hex literal; a malformed literal degrades to empty,
// which any downstream length check catches.
function fromHex(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}

// The hex of the ECDH shared secret for our `privHex` scalar against the SEC 1
// `peerHex` public point on `c`; "err" if agreement is rejected.
function sharedHex(c: Curve, privHex: string, peerHex: string): string {
  let s = ecdhnistSharedSecret(fromHex(privHex), fromHex(peerHex), c) catch e {
    return "err"
  }
  return encodeHex(s)
}

// Whether the SEC 1 point `peerHex` is rejected as a peer key (off-curve or
// malformed): true exactly when agreement fails.
function rejects(c: Curve, privHex: string, peerHex: string): bool {
  ecdhnistSharedSecret(fromHex(privHex), fromHex(peerHex), c) catch e {
    return true
  }
  return false
}

// Whether two byte slices are identical.
function sameBytes(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The ECDH symmetry check on `c`: two independent key pairs must agree on the
// shared secret computed from opposite sides. Any failure (agreement error or a
// mismatch) prints false.
function ecdhAgrees(c: Curve): bool {
  let a = ecdhnistGenerateKeypair(c)
  let b = ecdhnistGenerateKeypair(c)
  let sa = ecdhnistSharedSecret(a.priv, b.pub, c) catch e {
    return false
  }
  let sb = ecdhnistSharedSecret(b.priv, a.pub, c) catch e {
    return false
  }
  return sameBytes(sa, sb)
}

function main() {
  let p256 = nistecP256()
  let p384 = nistecP384()

  // NIST CAVP ECC-CDH primitive test, COUNT=0 (dIUT / QCAVS / ZIUT).
  let p256Priv = "7d7dc5f71eb29ddaf80d6214632eeae03d9058af1fb6d22ed80badb62bc1a534"
  let p256Peer = "04700c48f77f56584c5cc632ca65640db91b6bacce3a4df6b42ce7cc838833d287db71e509e3fd9b060ddb20ba5c51dcc5948d46fbf640dfe0441782cab85fa4ac"
  let p384Priv = "3cc3122a68f0d95027ad38c067916ba0eb8c38894d22e1b15618b6818a661774ad463b205da88cf699ab4d43c9cf98a1"
  let p384Peer = "04a7c76b970c3b5fe8b05d2838ae04ab47697b9eaf52e764592efda27fe7513272734466b400091adbf2d68c58e0c50066ac68f19f2e1cb879aed43a9969b91a0839c4c38a49749b661efedf243451915ed0905a32b060992b468c64766fc8437a"
  // Tampered peer point: P-256 QCAVS with the last y-byte flipped -> off-curve.
  let p256Off = "04700c48f77f56584c5cc632ca65640db91b6bacce3a4df6b42ce7cc838833d287db71e509e3fd9b060ddb20ba5c51dcc5948d46fbf640dfe0441782cab85fa4ad"

  println("p256_shared=${sharedHex(p256, p256Priv, p256Peer)}")
  println("p384_shared=${sharedHex(p384, p384Priv, p384Peer)}")
  println("p256_offcurve_reject=${rejects(p256, p256Priv, p256Off)}")
  println("p256_agree=${ecdhAgrees(p256)}")
  println("p384_agree=${ecdhAgrees(p384)}")

  // Shape of a freshly generated key pair.
  let kp = ecdhnistGenerateKeypair(p256)
  println("p256_priv_len=${len(kp.priv)}")
  println("p256_pub_len=${len(kp.pub)}")
  println("p256_pub_prefix=${int(kp.pub[0])}")
}
