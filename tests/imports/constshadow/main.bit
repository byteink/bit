// #1499: the checker's `env` is flat, so `shadowed.bit`'s function-local `q`
// overwrote the module-level `q`'s entry, and the import copied the LOCAL's
// type. `q` then interpolated through `string_from_int` and printed an address.
// Exit code stayed 0 — a silent miscompile, which is why this is a run case.
import { q, bump, readCounter } from "./shadowed"

function main() {
  println("q=${q}")
  println("counter=${readCounter()}")
  println("bump=${bump(1)}")
}
