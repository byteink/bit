import { mapped, filter, reduce, forEach, find, any, all } from "std/seq"

function main() {
  let xs = [1, 2, 3, 4, 5]

  let doubled = mapped<i64, i64>(xs, (x: i64) => x * 2)
  println("${doubled[0]} ${doubled[4]}")

  let evens = filter<i64>(xs, (x: i64) => x % 2 == 0)
  println("${len(evens)} ${evens[0]} ${evens[1]}")

  println("${reduce<i64, i64>(xs, 0, (a: i64, x: i64) => a + x)}")

  // forEach for a side effect (Bit closures capture by value, so use it for
  // I/O or a captured reference, not to accumulate into a local).
  forEach<i64>(xs, (x: i64) => println("e${x}"))

  let found = find<i64>(xs, (x: i64) => x > 3)
  println("${unwrap(found)}")
  println("${isNone(find<i64>(xs, (x: i64) => x > 10))}")

  println("${any<i64>(xs, (x: i64) => x == 3)} ${all<i64>(xs, (x: i64) => x > 0)}")
}
