// Exercises the std/seq generic slice helpers, monomorphized here for []i64
// and []string. reverse builds a fresh slice; the originals are unchanged.
import { contains, indexOf, count, reverse } from "std/seq"

function main() {
  let xs = [3, 1, 4, 1, 5, 1]
  println("has4=${contains(xs, 4)} has9=${contains(xs, 9)}")
  println("idx4=${indexOf(xs, 4)} idx9=${indexOf(xs, 9)} ones=${count(xs, 1)}")

  let r = reverse(xs)
  println("rev0=${r[0]} rev5=${r[5]} orig0=${xs[0]}")

  let words = ["go", "bit", "go"]
  println("hasBit=${contains(words, "bit")} gos=${count(words, "go")} idxBit=${indexOf(words, "bit")}")
}
