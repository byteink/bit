import { now, monotonic, since, sleep, Millisecond } from "std/time"

// #2678: `now()` returns an `Instant`, `monotonic()` returns a `Mono`, and
// `since()` only accepts a `Mono` — nominal types so a wall-clock reading can
// never be handed to `since` by mistake. This proves the runtime behavior
// survives the type change: both clocks still read a sensible value, and
// `since(monotonic())` still measures elapsed time correctly.
fn main() {
  let start = monotonic()
  sleep(20 * Millisecond)
  let elapsed = since(start)
  println("elapsed_at_least_20ms=${elapsed >= 20 * Millisecond}")

  let reading = now()
  println("now_ns_positive=${reading.ns > 0}")

  let markStart = monotonic()
  println("mono_ns_nonnegative=${markStart.ns >= 0}")
}
