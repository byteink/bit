// §11.9: calling an IMPORTED `@symbol`-pinned function by its Bit name (#1410).
//
// The pin bypasses module qualification, so `./rt`'s functions are emitted as
// `bit_pinned_sum`/`bit_pinned_diff` rather than `m<id>$pinnedSum`. Lowering
// applied the pin to the DEFINITION but the call site kept qualifying, so the
// two disagreed: the object defined `bit_pinned_sum` and referenced
// `m<id>$pinnedSum`, which nothing defines.
//
// That failure lands far from its cause — the reference is dead-stripped when
// unreferenced, and on Darwin it falls through to a libSystem import and aborts
// at dyld load rather than failing the link. So this fixture RUNS the program:
// a linked binary that prints the right numbers is the only evidence that the
// definition and the call agree on a name.
//
// This is the ordinary build path, not `--freestanding`. The freestanding
// emitter refuses a mangled cross-module reference outright (#1408), so it was
// already fail-closed; the ordinary path had no such guard and miscompiled
// silently, which is why the case lives here.
import { pinnedSum, pinnedDiff, plainDiff } from "./rt"

function main() {
  // pinnedSum recurses, so the pinned name has to resolve for the SELF-call as
  // well as this one. plainDiff is the unpinned control and still travels the
  // ordinary `m<id>$` path.
  println("sum=${pinnedSum(8)} diff=${pinnedDiff(22, 64)} plain=${plainDiff(50, 8)}")
}
