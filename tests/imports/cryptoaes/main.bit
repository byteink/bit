// std/crypto AES block cipher (#1179): the FIPS 197 Appendix B/C known-answer
// vectors for all three key sizes, hex-compared via encodeHex, plus a decrypt
// round-trip per size and a bad-key-length rejection. The S-box is computed in
// GF(2^8) (constant-time, no secret-indexed table), so a narrow-width (u8 wrap
// and rotate) or field-arithmetic miscompile would corrupt these digests here.
// Output is deterministic, so the golden `expected` is stable.
import { newAes, encodeHex, decodeHex, hwAvailableAes } from "std/crypto"

// The shared FIPS 197 plaintext, one-shot enciphered under `keyHex`, as lowercase
// hex ciphertext. Panics only on a malformed literal in this test, never on data.
function encHex(keyHex: string, ptHex: string): string {
  let key = decodeHex(keyHex) catch e { return "badkey" }
  let pt = decodeHex(ptHex) catch e { return "badpt" }
  let c = newAes(key) catch e { return "badaes" }
  return encodeHex(c.encryptBlock(pt))
}

// Decipher `ctHex` under `keyHex` back to plaintext hex — the inverse check.
function decHex(keyHex: string, ctHex: string): string {
  let key = decodeHex(keyHex) catch e { return "badkey" }
  let ct = decodeHex(ctHex) catch e { return "badct" }
  let c = newAes(key) catch e { return "badaes" }
  return encodeHex(c.decryptBlock(ct))
}

// Whether `newAes` rejects a key of `n` bytes (true) or accepts it (false).
function keyRejected(n: int): bool {
  let c = newAes([]byte(n)) catch e { return true }
  return false
}

function main() {
  // Diagnostic only (stderr, not part of the golden `expected` — task #1223's
  // hardware path is host-dependent, so this line's value differs by host and
  // must never be part of the portable golden diff): confirms which path this
  // run actually took, so a real-hardware verification run can see AES-NI
  // engaged rather than silently falling back to software.
  eprint("hwAvailableAes=${hwAvailableAes()}\n")

  let pt = "00112233445566778899aabbccddeeff"

  let k128 = "000102030405060708090a0b0c0d0e0f"
  let k192 = "000102030405060708090a0b0c0d0e0f1011121314151617"
  let k256 = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

  // FIPS 197 Appendix B (AES-128) and Appendix C.1/C.2/C.3 known-answer vectors.
  let ct128 = encHex(k128, pt)
  let ct192 = encHex(k192, pt)
  let ct256 = encHex(k256, pt)
  println("aes128=${ct128}")
  println("aes192=${ct192}")
  println("aes256=${ct256}")

  // Decrypt round-trips: decryptBlock(encryptBlock(pt)) must equal pt.
  println("rt128=${decHex(k128, ct128) == pt}")
  println("rt192=${decHex(k192, ct192) == pt}")
  println("rt256=${decHex(k256, ct256) == pt}")

  // A key that is not 16/24/32 bytes must be rejected, not silently truncated.
  println("badKeyRejected=${keyRejected(20)}")
}
