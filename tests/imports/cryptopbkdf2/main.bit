// std/crypto PBKDF2 (#1177): the RFC 6070 known-answer vectors over HMAC-SHA-1
// plus the RFC 7914 §11 HMAC-SHA-256 vector, hex-compared via encodeHex. The
// SHA-1 cases cover a single iteration, a 4096-iteration stretch, and a 25-byte
// derived key that spans two blocks (T(1) whole, T(2) truncated to 5 bytes),
// exercising the block counter and the final-block truncation. The SHA-256 case
// (c=1, dkLen=64) spans exactly two 32-byte blocks. The construction is generic
// over the digest: `newSha1` already returns `Hash`, while `newSha256` returns
// the concrete `Sha256`, so it is wrapped as a `() => Hash` value. Every output
// is deterministic, so the golden `expected` is stable across architectures.
//
// The famous RFC 7914 P="Password"/S="NaCl"/c=80000 vector is verified but left
// out of the harness — 80000 iterations is deliberately slow, and CI runs this
// on three targets. Its answer is 4ddcd8f6...397f33c8d.
import { Hash, pbkdf2, newSha1, newSha256, encodeHex } from "std/crypto"

// The concrete SHA-256 constructor exposed as a `() => Hash` value.
function sha256Hash(): Hash { return newSha256() }

function run(): ()! {
  // RFC 6070 — HMAC-SHA-1.
  // P="password", S="salt", c=1, dkLen=20.
  println("s1a=${encodeHex(pbkdf2(newSha1, []byte("password"), []byte("salt"), 1, 20))}")
  // P="password", S="salt", c=4096, dkLen=20.
  println("s1b=${encodeHex(pbkdf2(newSha1, []byte("password"), []byte("salt"), 4096, 20))}")
  // P="passwordPASSWORDpassword", S="saltSALT...salt", c=4096, dkLen=25 — the
  // 25-byte key spans two SHA-1 blocks, the second truncated.
  let longP = []byte("passwordPASSWORDpassword")
  let longS = []byte("saltSALTsaltSALTsaltSALTsaltSALTsalt")
  println("s1c=${encodeHex(pbkdf2(newSha1, longP, longS, 4096, 25))}")

  // RFC 7914 §11 — HMAC-SHA-256, P="passwd", S="salt", c=1, dkLen=64: two
  // 32-byte blocks concatenated.
  println("s256a=${encodeHex(pbkdf2(sha256Hash, []byte("passwd"), []byte("salt"), 1, 64))}")
}

function main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
