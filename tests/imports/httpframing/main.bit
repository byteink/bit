// Request framing (#2168): `readMessage` must frame a request body per RFC
// 9112 §6 — Content-Length read exactly, Transfer-Encoding: chunked decoded
// (never passed through as raw chunk bytes), no framing header meaning no
// body, and Content-Length together with Transfer-Encoding rejected outright.
// Driven over raw std/net sockets so the wire bytes are exactly what an
// attacker would send, not what a well-behaved client API would build.
//
// The raw response is reduced to its status line and body before printing —
// never the literal bytes — so the checked-in `expected` holds no wire CRLFs
// for this repo's `core.autocrlf=input` to silently rewrite to LF.
import { serve, Server, Exchange, ok } from "std/http"
import { dial } from "std/net"
import { indexOf } from "std/strings"

function dispatch(ex: Exchange) {
  let r = ex.request
  ex.respond(ok("bodylen=${len(r.body)} body=[${r.body}]")) catch e {
    return
  }
}

function serveLoop(s: Server, n: int, ready: chan<int>): ()! {
  ready <- 0
  let i = 0
  while (i < n) {
    let ex = s.accept()?
    spawn dispatch(ex)
    i = i + 1
  }
  s.close()
}

function statusOf(raw: string): string {
  let eol = indexOf(raw, "\r\n")
  if (eol < 0) {
    return raw
  }
  return raw[0:eol]
}

function bodyOf(raw: string): string {
  let sep = indexOf(raw, "\r\n\r\n")
  if (sep < 0) {
    return ""
  }
  return raw[sep + 4:len(raw)]
}

function raw(port: int, req: string): string {
  let c = dial("127.0.0.1", port) catch e {
    return "DIAL FAILED"
  }
  c.write(req) catch e {
    c.close()
    return "WRITE FAILED"
  }
  let r = c.readAll()
  c.close()
  return r
}

function attempt(port: int, label: string, req: string) {
  let r = raw(port, req)
  println("${label}: ${statusOf(r)} | ${bodyOf(r)}")
}

function main() {
  let s = serve("127.0.0.1", 0) catch e {
    println("serve failed: ${e.message()}")
    return
  }
  let port = s.port() catch e {
    println("port failed: ${e.message()}")
    return
  }
  let ready = chan<int>(1)
  spawn serveLoop(s, 4, ready)
  let started = <- ready

  attempt(port, "case1 CL:5 30bytes", "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nConnection: close\r\n\r\nAAAAABBBBBCCCCCDDDDDEEEEEFFFFF")
  attempt(port, "case2 noCL noTE 10bytes", "POST / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\nSMUGGLED!!")
  attempt(port, "case3 TE:chunked", "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\nHELLO\r\n0\r\n\r\n")
  attempt(port, "case4 CL+TE both", "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nAAAAA")
}
