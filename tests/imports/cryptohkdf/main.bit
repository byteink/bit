// std/crypto HKDF (#1176): the RFC 5869 Appendix A known-answer vectors over
// SHA-256, hex-compared via encodeHex. Covers all three published cases — A.1
// (13-byte salt, 10-byte info, L=42), A.2 (80-byte inputs, L=82, spanning three
// expand blocks), and A.3 (zero-length salt and info, exercising the HashLen
// zero-salt default) — checking `hkdfExtract`'s PRK, `hkdfExpand`'s OKM, and the
// one-shot `hkdf` convenience against A.1/A.3. A final case pins the
// `255*HashLen` output cap: an over-long expand must fail rather than truncate.
// The construction is generic over the digest; `newSha256` returns the concrete
// `Sha256`, so it is wrapped as a `() => Hash` value. Every output is
// deterministic, so the golden `expected` is stable across architectures.
import { Hash, hkdf, hkdfExtract, hkdfExpand, newSha256, encodeHex } from "std/crypto"

// The concrete SHA-256 constructor exposed as a `() => Hash` value.
function sha256Hash(): Hash { return newSha256() }

// A byte slice of `n` copies of `v` — builds the RFC 5869 repeated-byte IKM.
function repeatByte(n: int, v: byte): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = v
    i = i + 1
  }
  return out
}

// A byte slice of `n` bytes counting up from `start`: `rangeBytes(0x00, 13)` is
// the A.1 salt 00 01 .. 0c, `rangeBytes(0xf0, 10)` the A.1 info f0 f1 .. f9.
function rangeBytes(start: int, n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = byte(start + i)
    i = i + 1
  }
  return out
}

// "rejected" iff the 255*HashLen output cap fires for an over-long expand;
// otherwise a telltale "accepted-N" that would break the golden.
function expandTooLong(prk: []byte): string {
  let okm = hkdfExpand(sha256Hash, prk, []byte(0), 255 * 32 + 1) catch e {
    return "rejected"
  }
  return "accepted-${len(okm)}"
}

function run(): ()! {
  // A.1 — IKM = 22 x 0x0b, salt = 00..0c (13 bytes), info = f0..f9 (10), L = 42.
  let ikm1 = repeatByte(22, 0x0b)
  let salt1 = rangeBytes(0x00, 13)
  let info1 = rangeBytes(0xf0, 10)
  let prk1 = hkdfExtract(sha256Hash, salt1, ikm1)
  println("a1prk=${encodeHex(prk1)}")
  println("a1okm=${encodeHex(hkdfExpand(sha256Hash, prk1, info1, 42)?)}")
  // The one-shot convenience must reproduce the same OKM end to end.
  println("a1okmc=${encodeHex(hkdf(sha256Hash, salt1, ikm1, info1, 42)?)}")

  // A.2 — 80-byte inputs, L = 82: OKM spans three expand blocks, the last
  // truncated to 18 of its 32 bytes.
  let ikm2 = rangeBytes(0x00, 80)
  let salt2 = rangeBytes(0x60, 80)
  let info2 = rangeBytes(0xb0, 80)
  let prk2 = hkdfExtract(sha256Hash, salt2, ikm2)
  println("a2prk=${encodeHex(prk2)}")
  println("a2okm=${encodeHex(hkdfExpand(sha256Hash, prk2, info2, 82)?)}")

  // A.3 — zero-length salt and info: the empty salt takes the HashLen-zero
  // default, and expand runs with no context bytes.
  let ikm3 = repeatByte(22, 0x0b)
  let empty = []byte(0)
  let prk3 = hkdfExtract(sha256Hash, empty, ikm3)
  println("a3prk=${encodeHex(prk3)}")
  println("a3okm=${encodeHex(hkdf(sha256Hash, empty, ikm3, empty, 42)?)}")

  // The 255*HashLen cap: one byte over the limit must fail, not silently short.
  println("overflow=${expandTooLong(prk1)}")
}

function main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
