// std/crypto SHA-1 (#1168): the three FIPS 180-1 known-answer vectors through
// the one-shot `digest`, plus a streaming-vs-one-shot check over a >64-byte
// message fed in odd 7-byte chunks. SHA-1 is legacy (interop only); these
// vectors just prove the implementation is bit-exact.
import { newSha1, digest, encodeHex } from "std/crypto"

// Hex of the SHA-1 digest of `msg`, one-shot through the `Hash` interface.
fn sha1hex(msg: string): string {
  return encodeHex(digest(newSha1(), []byte(msg)))
}

fn main() {
  // FIPS 180-1 test vectors.
  println("empty=${sha1hex("")}")
  println("abc=${sha1hex("abc")}")
  println("two=${sha1hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")}")

  // Streaming must equal one-shot. This message is 85 bytes (>1 block), fed in
  // odd 7-byte chunks so block boundaries fall mid-chunk.
  let msg = "The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs."
  let bytes = []byte(msg)
  let h = newSha1()
  h.reset()
  let i = 0
  let step = 7
  while (i < len(bytes)) {
    let end = i + step
    if (end > len(bytes)) {
      end = len(bytes)
    }
    h.write(bytes[i:end])
    i = end
  }
  println("streamEq=${encodeHex(h.sum()) == sha1hex(msg)}")
}
