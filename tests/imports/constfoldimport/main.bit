// #2115: a top-level `const` initializer may name a const IMPORTED from another
// module (SPEC 15.4 — a `const` expression over untyped constants; 17.3 — an
// exported declaration is visible to importing modules). Nothing in the spec
// carves out imported constants, and the same expression has always been legal
// with a same-module operand.
//
// Before the fix every line below was `error[E0064]: top-level 'const'
// initializer must be a compile-time constant expression`: the folder resolved a
// bare `Ident` only against ITS OWN module's node arena, so an imported name
// looked like a non-constant. Lowering could already render all of it — an
// imported const inlines at its use site through the declOwner rule — so this
// was a checker-only refusal of a program the back end was ready to compile.
//
// Three shapes, because they take three different paths through the folder:
//   NAMED    `import { KB }`      -> Tag.Ident, resolved via `importedFrom`
//   CHAINED  `MB` is itself `1024 * KB` in the owner -> recursion INSIDE the owner
//   DOTTED   `import u from ...`  -> Tag.Member, resolved via `nsQualifiedName`
import { KB, MB } from "./units"
import u from "./units"

const FROM_NAMED: int = 1024 * KB
const FROM_CHAINED: int = 1024 * MB
const FROM_DOTTED: int = 1024 * u.KB
// No annotation: the fold has to carry the value, not merely accept the shape.
const UNANNOTATED = KB + 1

fn main() {
  println("${FROM_NAMED}")
  println("${FROM_CHAINED}")
  println("${FROM_DOTTED}")
  println("${UNANNOTATED}")
}
