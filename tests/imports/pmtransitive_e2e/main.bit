// End-to-end regression coverage for `bit add`'s transitive dependency
// resolution (#2251) through the real dispatched CLI, mirroring
// `tests/imports/pmadd_e2e`'s technique (see that file's own header for why
// an exec of `BIT_SELF_EXE` is required here instead of a unit call into
// `compiler/pmcli.bit`'s internals: `compiler/` is the compiler's own
// implementation and is not importable from a program the compiler builds).
//
// The graph is a genuine MVS diamond, discovered in ONE `bit add` so it
// actually exercises `resolveMVS`'s max-version arbitration rather than
// merely "first-requirer-wins" order-dependence:
//
//   app -> libtop -> { liba -> textutil@v0.1.0, libb -> textutil@v0.2.0 }
//
// `libtop`'s own `bit.json` names BOTH `liba` and `libb` as direct
// dependencies, each of which names a DIFFERENT version of `textutil` as
// its own dependency. Before this test existed, `bit add libtop@v1.0.0`
// alone was already known-good coverage of #2251's core fix (a dependency's
// own transitive requirements get fetched and locked at all, two levels
// deep: libtop -> {liba, libb} -> textutil). What this graph shape adds is
// the diamond: `textutil` is reachable through TWO different, differently-
// versioned requirers in the SAME resolution walk, so a correct resolver
// must pick the max (v0.2.0) — not whichever requirer's edge the walk
// happens to visit first.
//
// A DELIBERATELY NARROWER GRAPH WAS TRIED AND REJECTED: two SEPARATE root
// `bit add` calls (`bit add liba@v1.0.0` then `bit add libb@v1.0.0`) look
// like the more obvious diamond shape, but empirically do NOT exercise MVS
// at all with the resolver as it exists today. `compiler/pmz.bit`'s
// `resolveTransitiveDeps` skips ANY requirement for a name that already has
// a top-level `bit.lock` entry (`lockHasEntry`, checked before the version
// is even read) — and the first `bit add` call already locks `textutil` via
// its own transitive walk before the second call ever runs. So two
// sequential adds only ever demonstrate first-added-wins, never a real
// max-version comparison; #2251's own ticket documents this as a known,
// out-of-scope limitation ("a name that already has a top-level bit.lock
// entry is never reconsidered by this walk"), and #2250 (which DOES cover
// re-arbitrating an explicit root `bit add` of an already-locked name
// against a higher transitive requirement) explicitly leaves this
// transitive-vs-transitive case "not verified". Verified by hand against
// the real dispatched CLI before writing this file: adding `liba` then
// `libb` directly leaves `textutil` pinned at v0.1.0 regardless of order.
// The single-call diamond above is the one shape that is both true to how
// `resolveMVS` actually runs and immune to that documented gap.
//
// The host is `github.com`, a KNOWN git host (`pmfetch.bit`'s
// `isKnownGitHost`) — required for every spec here to resolve as a DIRECT
// dependency rather than a vanity name (#2068), matching `pmadd_e2e`'s own
// header note on the same point. Every fetch (the root `libtop` add and
// each transitively-discovered dependency) is redirected to a local fixture
// via `GIT_CONFIG_GLOBAL`'s `url.<file-url>.insteadOf` mechanism, scoped to
// a scratch config file this test creates — never `--url`, which is a
// CLI-only override for the one spec named on the command line and has no
// reach into a transitively-discovered spec `resolveTransitiveSpec`
// resolves internally (#2251's own ticket comment on why `--url` cannot
// cover this test).
import { env, envOr } from "std/os"
import { exists, isDir, mkdir, readFile, remove, writeFile } from "std/fs"
import { split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// mkdir -p, iteratively (Power of 10 rule 2) — copied from pmadd_e2e's own
// helper (itself a deliberate small copy of compiler/pmfetch.bit's version,
// which is not importable from a program the compiler builds).
fn mkdirAll(path: string): ()! {
  if (len(path) == 0 || isDir(path)) {
    return
  }
  let parts = split(path, "/")
  let acc = ""
  let i = 0
  while (i < len(parts)) {
    if (len(parts[i]) > 0) {
      acc = acc + "/" + parts[i]
      if (!isDir(acc)) {
        mkdir(acc)?
      }
    }
    i = i + 1
  }
}

fn scratchRoot(): string {
  return envOr("TMPDIR", "/tmp") + "/bit-pmtransitive-e2e-" + uuidFormat(uuidV4())
}

// Runs a throwaway `/bin/sh` script and returns its exit code. Same
// rationale as `pmadd_e2e`'s identical helper: no deadline watcher needed
// here (every step is a local git op or this program's own compiler on a
// fixed local fixture), and the whole process is already bounded by the
// harness's own per-case deadline.
fn runShell(script: string): int! {
  let scriptPath = scratchRoot() + ".sh"
  defer removeQuiet(scriptPath)
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700: owner rwx only
    fail newError("pmtransitive_e2e: cannot make script executable: ${scriptPath}")
  }
  return osRun(scriptPath, []string(0))
}

fn removeQuiet(path: string) {
  remove(path) catch e { return }
}

// `git init` + a fixed committer identity, split out of the per-commit step
// below so `textutil` (two commits) only pays for it once.
fn gitInit(dir: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git init -q -b main '${dir}'\n" +
    "git -C '${dir}' config user.email 'pmtransitive-e2e@bit-lang.invalid'\n" +
    "git -C '${dir}' config user.name 'pmtransitive_e2e fixture'\n" +
    // An ambient `tag.gpgsign=true` in the host's real ~/.gitconfig would
    // otherwise force every `git tag` below into an interactive annotated
    // signature ("fatal: no tag message?") — matching #2251/#2250's own
    // repro scripts, which set both explicitly for the same reason.
    "git -C '${dir}' config tag.gpgsign false\n" +
    "git -C '${dir}' config commit.gpgsign false\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmtransitive_e2e: git init failed for ${dir} (exit ${code})")
  }
}

// Stages the working tree and commits + tags it with a fixed author/
// committer date (explicit UTC offset) and `--no-gpg-sign`, exactly
// `pmadd_e2e`'s `buildFixture` technique, so the resulting commit sha —
// which both `bit add`'s confirmation line and the written `bit.lock`
// embed — is a fixed string this golden `expected` file can diff against.
fn gitCommitTag(dir: string, msg: string, date: string, tag: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git -C '${dir}' add -A\n" +
    "GIT_AUTHOR_DATE='${date}' GIT_COMMITTER_DATE='${date}' " +
    "git -C '${dir}' commit -q --no-gpg-sign -m '${msg}'\n" +
    "git -C '${dir}' tag ${tag}\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmtransitive_e2e: git commit/tag failed for ${dir}@${tag} (exit ${code})")
  }
}

// Two commits, two tags: v0.1.0 exports only `slugify`; v0.2.0 adds
// `centre`. Neither export is actually called by a requirer below — only
// the LOCKED VERSION (and therefore commit sha) is what this test checks.
fn buildTextutil(dir: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/textutil.bit", "export function slugify(s: string): string { return s }\n")?
  writeFile(dir + "/bit.json", "{\n  \"name\": \"textutil\",\n  \"version\": \"0.1.0\",\n  \"dependencies\": {}\n}\n")?
  gitInit(dir)?
  gitCommitTag(dir, "textutil v0.1.0", "2020-01-01T00:00:00+0000", "v0.1.0")?
  writeFile(dir + "/textutil.bit",
    "export function slugify(s: string): string { return s }\n" +
    "export function centre(s: string): string { return s }\n")?
  writeFile(dir + "/bit.json", "{\n  \"name\": \"textutil\",\n  \"version\": \"0.2.0\",\n  \"dependencies\": {}\n}\n")?
  gitCommitTag(dir, "textutil v0.2.0", "2020-01-02T00:00:00+0000", "v0.2.0")?
}

// `liba`/`libb`: one commit each, tagged v1.0.0, differing only in which
// `textutil` version their own `bit.json` requires — the two arms of the
// diamond `libtop` (below) converges.
fn buildLib(dir: string, fileName: string, libName: string, textutilVersion: string, date: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/${fileName}.bit",
    "import { slugify } from \"textutil\"\n" +
    "export function idFor(t: string): string { return \"${libName}-\" + slugify(t) }\n")?
  writeFile(dir + "/bit.json",
    "{\n  \"name\": \"${libName}\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n" +
    "    \"textutil\": \"github.com/pmtransitive-e2e/textutil@${textutilVersion}\"\n  }\n}\n")?
  gitInit(dir)?
  gitCommitTag(dir, "${libName} v1.0.0", date, "v1.0.0")?
}

// The convergence point: depends directly on BOTH `liba` and `libb`, so a
// single `bit add libtop@...` discovers both arms of the diamond (and, via
// each of them, `textutil`) in one `resolveTransitiveDeps` walk.
fn buildLibtop(dir: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/libtop.bit",
    "import { idFor as aId } from \"liba\"\n" +
    "import { idFor as bId } from \"libb\"\n" +
    "export function combine(t: string): string { return aId(t) + bId(t) }\n")?
  writeFile(dir + "/bit.json",
    "{\n  \"name\": \"libtop\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n" +
    "    \"liba\": \"github.com/pmtransitive-e2e/liba@v1.0.0\",\n" +
    "    \"libb\": \"github.com/pmtransitive-e2e/libb@v1.0.0\"\n  }\n}\n")?
  gitInit(dir)?
  gitCommitTag(dir, "libtop v1.0.0", "2020-01-05T00:00:00+0000", "v1.0.0")?
}

// The project `bit add` runs against.
fn buildProject(dir: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/bit.json", "{\n  \"name\": \"pmtransitive-e2e-project\",\n  \"dependencies\": {}\n}\n")?
}

// Every fetch this test's `bit add` performs (the root `libtop` spec, plus
// every transitively-discovered `liba`/`libb`/`textutil` spec) resolves to
// `https://github.com/pmtransitive-e2e/<name>.git` per `pmfetch.bit`'s
// `defaultDepUrl` — redirected here to the matching local fixture, scoped
// to this run's own `configPath` and never the real `~/.gitconfig`.
fn writeInsteadOfConfig(configPath: string, textutilDir: string, libaDir: string, libbDir: string, libtopDir: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git config -f '${configPath}' url.'file://${textutilDir}'.insteadOf 'https://github.com/pmtransitive-e2e/textutil.git'\n" +
    "git config -f '${configPath}' url.'file://${libaDir}'.insteadOf 'https://github.com/pmtransitive-e2e/liba.git'\n" +
    "git config -f '${configPath}' url.'file://${libbDir}'.insteadOf 'https://github.com/pmtransitive-e2e/libb.git'\n" +
    "git config -f '${configPath}' url.'file://${libtopDir}'.insteadOf 'https://github.com/pmtransitive-e2e/libtop.git'\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmtransitive_e2e: writing insteadOf config failed (exit ${code})")
  }
}

// Every scratch path this run needs, built by `setupFixtures` below and
// consumed by `main` — kept out of `main` itself so its own error handling
// is one `catch`, not eight (E0204 max-complexity).
class FixturePaths {
  home: string
  configPath: string
  projectDir: string
}

// Builds every fixture repo, the project `bit add` runs against, and the
// `insteadOf` redirect config — the whole scratch tree this test needs.
// Each step propagates with `?` (not its own `catch`): a single failure
// anywhere in here is reported by `main`'s one wrapping `catch`, with
// nothing here adding to that function's own branch count.
fn setupFixtures(root: string): FixturePaths! {
  let textutilDir = root + "/textutil"
  let libaDir = root + "/liba"
  let libbDir = root + "/libb"
  let libtopDir = root + "/libtop"
  let projectDir = root + "/project"
  let home = root + "/home" // isolates `bit add`'s ~/.bit/pkg cache to this run
  let configPath = root + "/gitconfig"

  buildTextutil(textutilDir)?
  buildLib(libaDir, "liba", "liba", "v0.1.0", "2020-01-03T00:00:00+0000")?
  buildLib(libbDir, "libb", "libb", "v0.2.0", "2020-01-04T00:00:00+0000")?
  buildLibtop(libtopDir)?
  buildProject(projectDir)?
  mkdirAll(home)?
  writeInsteadOfConfig(configPath, textutilDir, libaDir, libbDir, libtopDir)?

  return FixturePaths{ home: home, configPath: configPath, projectDir: projectDir }
}

fn main() {
  let selfExe = env("BIT_SELF_EXE")
  if (len(selfExe) == 0) {
    panic("pmtransitive_e2e: BIT_SELF_EXE is not set — the tests/imports harness must set it (#1767)")
  }

  let root = scratchRoot()
  mkdirAll(root) catch e {
    panic("pmtransitive_e2e: cannot create scratch root: " + e.message())
  }

  let paths = setupFixtures(root) catch e {
    panic("pmtransitive_e2e: " + e.message())
    FixturePaths{ home: "", configPath: "", projectDir: "" }
  }

  let addScript = "#!/bin/sh\n" +
    "set -e\n" +
    "export HOME='${paths.home}'\n" +
    "export GIT_CONFIG_GLOBAL='${paths.configPath}'\n" +
    "'${selfExe}' add github.com/pmtransitive-e2e/libtop@v1.0.0 --dir '${paths.projectDir}' >/dev/null\n"
  let addCode = runShell(addScript) catch e {
    panic("pmtransitive_e2e: " + e.message())
    -1
  }
  println("bit add exit: ${addCode}")

  let bitLock = readFile(paths.projectDir + "/bit.lock") catch e {
    panic("pmtransitive_e2e: cannot read bit.lock: " + e.message())
    ""
  }
  println("--- bit.lock ---")
  print(bitLock)
  println("")
}
