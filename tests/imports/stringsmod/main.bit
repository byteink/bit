import { compare, hasPrefix, hasSuffix, indexOf, contains, count, repeat, join, toUpper, toLower } from "std/strings"
import { newBuilder } from "std/strings"

fn main() {
  println("${hasPrefix("hello world", "hello")} ${hasSuffix("hello world", "world")}")
  println("${indexOf("mississippi", "ssi")} ${contains("mississippi", "sip")}")
  println("${count("mississippi", "ss")} ${count("aaaa", "aa")}")
  println("${compare("apple", "banana")} ${compare("dog", "dog")} ${compare("cat", "car")}")
  println("${repeat("ab", 3)}")
  println("${join(["a", "b", "c"], "-")}")
  println("${toUpper("Hello, World")} ${toLower("Hello, World")}")

  let b = newBuilder()
  b = b.write("Hi")
  b = b.writeByte(33)
  b = b.write(" there")
  println("${b.toString()} len=${b.length()}")
}
