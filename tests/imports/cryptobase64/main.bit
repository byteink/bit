// std/crypto base64 surface (#1162): encodeBase64/decodeBase64 (standard,
// '='-padded) and encodeBase64Url/decodeBase64Url (URL-safe, no padding). The
// encode vectors are RFC 4648 §10 verbatim; decode is checked by round-trip so
// the two stay mutually consistent. Output is fixed, so the golden `expected`
// is stable.

import { encodeBase64, decodeBase64, encodeBase64Url, decodeBase64Url } from "std/crypto"

// Round-trip a string through standard base64 and back, reporting both the
// encoded text and whether decode reproduced the original bytes.
fn roundTrip(s: string) {
  let enc = encodeBase64([]byte(s))
  let back = decodeBase64(enc) catch e {
    println("${s} -> decode FAILED")
    return
  }
  println("${s} -> ${enc} -> ${string(back) == s}")
}

fn main() {
  // RFC 4648 §10 known-answer vectors.
  roundTrip("")
  roundTrip("f")
  roundTrip("fo")
  roundTrip("foo")
  roundTrip("foob")
  roundTrip("fooba")
  roundTrip("foobar")

  // URL-safe alphabet, no padding. 0xFB 0xFF exercises both '-' and '_' and the
  // "no trailing =" rule; round-trip confirms decodeBase64Url inverts
  // encodeBase64Url.
  let raw = []byte(2)
  raw[0] = 251
  raw[1] = 255
  let u = encodeBase64Url(raw)
  let ub = decodeBase64Url(u) catch e {
    println("url -> decode FAILED")
    return
  }
  println("url=${u} urlRoundTrip=${len(ub) == 2 && ub[0] == 251 && ub[1] == 255}")

  // A '=' is not in the URL-safe alphabet, so standard-padded text must be
  // rejected by decodeBase64Url.
  let bad = decodeBase64Url("Zg==") catch e {
    println("urlRejectsPadding=true")
    return
  }
  println("urlRejectsPadding=false len=${len(bad)}")
}
