// Regression for #2653: `sleep(d)` (std/time) computes an absolute wake
// deadline as `parkMonoNs() + d`. That addition overflows i64 when `d` is
// close to i64max, wrapping the deadline negative — the green thread then
// wakes in microseconds instead of after ~292 years.
//
// This spawns a green thread sleeping for i64max nanoseconds, waits 300ms on
// the main thread, then does a NON-BLOCKING select on the sleeper's done
// channel. A property, not a wall-clock number, is what's asserted — "did it
// wake up early" — so this can't join the flaky timing-sensitive family: any
// wait long enough to observe "still asleep" passes, and the broken (wrapped)
// deadline wakes within microseconds, far under any wait this uses.
import { sleep, Millisecond } from "std/time"

fn sleeper(d: int, out: chan<bool>) {
  sleep(d)
  out <- true
}

fn main() {
  let out = chan<bool>(1)
  spawn sleeper(9223372036854775807, out)
  sleep(300 * Millisecond)
  let woke = false
  select {
    case <- out:
      woke = true
    default:
      woke = false
  }
  // i64max ns is ~292 years. It must still be sleeping.
  println("returned_early=${woke}")
}
