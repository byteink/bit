// std/crypto variable-width unsigned bigint (#1186): known-answer tests for the
// modular-arithmetic bedrock that RSA and the NIST curves build on. Every golden
// value here is independently computed with CPython's `pow`/`math.gcd` and
// hardcoded, so a miscompiled limb routine cannot quietly agree with itself.
//
// The 4^13 mod 497 == 445 line is the regression proof for codegen bug #1236 (a
// scalar parameter clobbered across a loop): while that bug was live Montgomery
// reduction returned 384. Big values travel as big-endian hex so the checks read
// against the Python output directly. Each check is a small function with few
// live locals, matching the ASN.1 test's shape.
import {
  Nat,
  bigintZero,
  bigintFromU64,
  bigintToU64,
  bigintFromBytes,
  bigintToBytes,
  bigintModExp,
  bigintModExpPublic,
  bigintModInverse,
  bigintDivMod,
  bigintMod,
  bigintMul,
  bigintSub,
  bigintCmp,
  bigintGcd,
  decodeHex,
  encodeHex,
} from "std/crypto"

// The `Nat` whose big-endian hex is `s`; a malformed literal degrades to zero.
function natFromHex(s: string): Nat {
  let b = decodeHex(s) catch e {
    return bigintZero()
  }
  return bigintFromBytes(b)
}

// `n` as `w` big-endian bytes, hex-encoded; "err" if it does not fit.
function hexOf(n: Nat, w: int): string {
  let b = bigintToBytes(n, w) catch e {
    return "err"
  }
  return encodeHex(b)
}

// The #1236 regression proof: 4^13 mod 497 (was 384 while miscompiled).
function modexpSmall(): u64 {
  let r = bigintModExp(bigintFromU64(4), bigintFromU64(13), bigintFromU64(497)) catch e {
    return 0
  }
  let v = bigintToU64(r) catch e {
    return 0
  }
  return v
}

// RSA encrypt c = m^e mod n with the public exponent (variable-time path).
function rsaEncryptPublic(): string {
  let n = natFromHex("ccf049a3642e2c349b654bc7b7c2a622d0ab7eac0f32aa3e66c17478992891b3")
  let m = natFromHex("4269742063727970746f206269676e756d20524b4154")
  let c = bigintModExpPublic(m, bigintFromU64(65537), n) catch e {
    return "err"
  }
  return hexOf(c, 32)
}

// The same encrypt through the default (constant-time Montgomery) entry point;
// must match the public-exponent path bit for bit.
function rsaEncrypt(): string {
  let n = natFromHex("ccf049a3642e2c349b654bc7b7c2a622d0ab7eac0f32aa3e66c17478992891b3")
  let m = natFromHex("4269742063727970746f206269676e756d20524b4154")
  let c = bigintModExp(m, bigintFromU64(65537), n) catch e {
    return "err"
  }
  return hexOf(c, 32)
}

// RSA decrypt m = c^d mod n with the secret exponent (constant-time Montgomery
// ladder). The 32-byte width preserves the message's leading zero bytes.
function rsaDecrypt(): string {
  let n = natFromHex("ccf049a3642e2c349b654bc7b7c2a622d0ab7eac0f32aa3e66c17478992891b3")
  let c = natFromHex("23bdaf18938635a33976962f24f039fad0185167ec36d90a99fd771863cd6c10")
  let d = natFromHex("465a4ecd3a7ce74bfff49c39298a36c1ab238ff784ad1f792372f080b79a3951")
  let m = bigintModExp(c, d, n) catch e {
    return "err"
  }
  return hexOf(m, 32)
}

// bigintModInverse(3, 11) == 4.
function invSmall(): u64 {
  let inv = bigintModInverse(bigintFromU64(3), bigintFromU64(11)) catch e {
    return 0
  }
  let v = bigintToU64(inv) catch e {
    return 0
  }
  return v
}

// The modular inverse of a 128-bit `a` modulo the Mersenne prime 2^127-1.
function invLarge(): string {
  let p = natFromHex("7fffffffffffffffffffffffffffffff")
  let a = natFromHex("deadbeefcafef00dabad1deac0ffee42")
  let inv = bigintModInverse(a, p) catch e {
    return "err"
  }
  return hexOf(inv, 16)
}

// a * modInverse(a, p) mod p == 1 for the same large operands.
function invCheck(): u64 {
  let p = natFromHex("7fffffffffffffffffffffffffffffff")
  let a = natFromHex("deadbeefcafef00dabad1deac0ffee42")
  let inv = bigintModInverse(a, p) catch e {
    return 0
  }
  let prod = bigintMod(bigintMul(a, inv), p) catch e {
    return 0
  }
  let v = bigintToU64(prod) catch e {
    return 0
  }
  return v
}

// Fermat inverse a^(p-2) mod p for prime p; must equal invLarge().
function fermatInv(): string {
  let p = natFromHex("7fffffffffffffffffffffffffffffff")
  let a = natFromHex("deadbeefcafef00dabad1deac0ffee42")
  let pm2 = bigintSub(p, bigintFromU64(2)) catch e {
    return "err"
  }
  let inv = bigintModExp(a, pm2, p) catch e {
    return "err"
  }
  return hexOf(inv, 16)
}

// Knuth Algorithm D with a divisor whose quotient digit over-estimates, forcing
// the D6 add-back correction. q is 9 bytes, r is 8.
function divmodAddbackQ(): string {
  let u = natFromHex("e9c349e03602f8ac10f1bc81448aaa9e")
  let v = natFromHex("9132b63ef16287e4")
  let d = bigintDivMod(u, v) catch e {
    return "err"
  }
  return hexOf(d.q, 9)
}

function divmodAddbackR(): string {
  let u = natFromHex("e9c349e03602f8ac10f1bc81448aaa9e")
  let v = natFromHex("9132b63ef16287e4")
  let d = bigintDivMod(u, v) catch e {
    return "err"
  }
  return hexOf(d.r, 8)
}

// Single-limb divisor: the fast bigintDivModSmall path.
function divmodSmallQ(): string {
  let u = natFromHex("123456789abcdef0fedcba9876543210")
  let v = natFromHex("f0000001")
  let d = bigintDivMod(u, v) catch e {
    return "err"
  }
  return hexOf(d.q, 12)
}

function divmodSmallR(): string {
  let u = natFromHex("123456789abcdef0fedcba9876543210")
  let v = natFromHex("f0000001")
  let d = bigintDivMod(u, v) catch e {
    return "err"
  }
  return hexOf(d.r, 4)
}

// a < b: quotient 0, remainder a.
function divmodAltbQ(): u64 {
  let d = bigintDivMod(bigintFromU64(5), bigintFromU64(497)) catch e {
    return 99
  }
  let v = bigintToU64(d.q) catch e {
    return 99
  }
  return v
}

function divmodAltbR(): u64 {
  let d = bigintDivMod(bigintFromU64(5), bigintFromU64(497)) catch e {
    return 99
  }
  let v = bigintToU64(d.r) catch e {
    return 99
  }
  return v
}

// gcd of two 80-bit values.
function gcdCheck(): string {
  let a = natFromHex("3fffffffffffffffffff")
  let b = natFromHex("2aaaaaaaaaaaaaaaaaaa")
  return hexOf(bigintGcd(a, b), 10)
}

// bigintToBytes(bigintFromBytes(x)) == x for an x with leading zero bytes; the
// fixed 8-byte width restores the zeros normalization drops.
function roundtrip(): string {
  return hexOf(natFromHex("000000deadbeef00"), 8)
}

// Edge: a zero exponent yields 1.
function exp0(): u64 {
  let r = bigintModExp(bigintFromU64(5), bigintZero(), bigintFromU64(497)) catch e {
    return 99
  }
  let v = bigintToU64(r) catch e {
    return 99
  }
  return v
}

// Edge: modulus 1 yields 0.
function mod1(): u64 {
  let r = bigintModExp(bigintFromU64(12345), bigintFromU64(7), bigintFromU64(1)) catch e {
    return 99
  }
  let v = bigintToU64(r) catch e {
    return 99
  }
  return v
}

// Even modulus takes the variable-time fallback: 7^5 mod 100 == 7.
function evenMod(): u64 {
  let r = bigintModExp(bigintFromU64(7), bigintFromU64(5), bigintFromU64(100)) catch e {
    return 99
  }
  let v = bigintToU64(r) catch e {
    return 99
  }
  return v
}

// Unsigned subtraction underflow fails rather than wrapping.
function subUnderflow(): bool {
  bigintSub(bigintFromU64(3), bigintFromU64(5)) catch e {
    return true
  }
  return false
}

// Cmp trichotomy over the RSA modulus and message.
function cmpCheck(): bool {
  let n = natFromHex("ccf049a3642e2c349b654bc7b7c2a622d0ab7eac0f32aa3e66c17478992891b3")
  let m = natFromHex("4269742063727970746f206269676e756d20524b4154")
  return bigintCmp(m, n) == -1 && bigintCmp(n, m) == 1 && bigintCmp(n, n) == 0
}

function main() {
  println("modexp_4_13_497=${modexpSmall()}")
  println("rsa_encrypt=${rsaEncrypt()}")
  println("rsa_encrypt_pub=${rsaEncryptPublic()}")
  println("rsa_decrypt=${rsaDecrypt()}")
  println("inv_3_11=${invSmall()}")
  println("inv_large=${invLarge()}")
  println("inv_check=${invCheck()}")
  println("fermat_inv=${fermatInv()}")
  println("divmod1_q=${divmodAddbackQ()}")
  println("divmod1_r=${divmodAddbackR()}")
  println("divmod2_q=${divmodSmallQ()}")
  println("divmod2_r=${divmodSmallR()}")
  println("divmod_altb_q=${divmodAltbQ()}")
  println("divmod_altb_r=${divmodAltbR()}")
  println("gcd=${gcdCheck()}")
  println("roundtrip=${roundtrip()}")
  println("exp0=${exp0()}")
  println("mod1=${mod1()}")
  println("even_mod=${evenMod()}")
  println("sub_underflow_err=${subUnderflow()}")
  println("cmp_ok=${cmpCheck()}")
}
