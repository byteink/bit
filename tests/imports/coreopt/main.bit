// Option/Result helpers from the prelude (auto-imported): unwrap/unwrapOr,
// isSome/isNone, unwrapOk/okOr, isOk/isErr.
fn main() {
  let a: Option<i64> = Option.Some(7)
  let b: Option<i64> = Option.None
  println("${unwrap(a)}")
  println("${unwrapOr(b, 99)}")
  println("${isSome(a)} ${isNone(b)}")

  let r: Result<i64, string> = Result.Ok(3)
  let e: Result<i64, string> = Result.Err("bad")
  println("${unwrapOk(r)}")
  println("${okOr(e, 0) - 1}")
  println("${isOk(r)} ${isErr(e)}")
}
