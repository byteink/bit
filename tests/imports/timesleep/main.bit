import { sleep, monotonic, since, Millisecond } from "std/time"

// 1000 green threads each sleep 50ms. `sleep` parks on the scheduler's timer
// queue rather than blocking the worker's OS thread, so they all wake at about
// the same moment: total wall time stays near 50ms instead of the ~50 seconds a
// thread-blocking sleep would take (the scheduler pins one OS thread).
function worker(done: chan<i64>) {
  sleep(50 * Millisecond)
  done <- 1
}

function main() {
  let done = chan<i64>(1000)
  let start = monotonic()

  let i = 0
  while (i < 1000) {
    spawn worker(done)
    i = i + 1
  }
  i = 0
  while (i < 1000) {
    <- done
    i = i + 1
  }

  let elapsed = since(start)
  // Every sleeper really waited its 50ms (the timer fired, not early)...
  println("slept=${elapsed >= 50 * Millisecond}")
  // ...and they overlapped: serialized sleeps would need 50 seconds.
  println("concurrent=${elapsed < 5000 * Millisecond}")
}
