// std/crypto ChaCha20 + HChaCha20 (#1180): the RFC 8439 and
// draft-irtf-cfrg-xchacha known-answer vectors, hex-compared via encodeHex.
// Every output is deterministic, so the golden `expected` is stable. Like the
// SHA test, this also pins the narrow-width u32 wrap/rotate codegen (#1158)
// across architectures: a wrong 32-bit wrap or rotate would corrupt the
// keystream and fail here.
import { chacha20, hchacha20, encodeHex, decodeHex } from "std/crypto"

// Decode a known-valid test-vector hex string. The inputs are compile-time
// constants, so a decode failure is a bug in this test — surfaced as an output
// mismatch (empty bytes) rather than a silent pass.
function hx(s: string): []byte {
  return decodeHex(s) catch e {
    println("test hex decode failed: ${e.message()}")
    return []byte(0)
  }
}

function main() {
  let key = hx("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")

  // RFC 8439 §2.3.2 block function: the keystream block equals ChaCha20 applied
  // to 64 zero bytes (XOR with zero is the raw keystream), counter 1.
  let nonce1 = hx("000000090000004a00000000")
  let ks = chacha20(key, nonce1, 1, []byte(64))
  println("block232=${encodeHex(ks)}")

  // RFC 8439 §2.4.2 encryption of the "Ladies and Gentlemen" plaintext, counter 1.
  let nonce2 = hx("000000000000004a00000000")
  let pt = []byte("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
  let ct = chacha20(key, nonce2, 1, pt)
  println("cipher242=${encodeHex(ct)}")

  // Decryption is the same XOR operation, so re-running it round-trips to the
  // plaintext — exercises the multi-block path (114 bytes spans two blocks).
  let back = chacha20(key, nonce2, 1, ct)
  println("roundtrip=${encodeHex(back) == encodeHex(pt)}")

  // draft-irtf-cfrg-xchacha §2.2.1 HChaCha20 subkey (used by XChaCha20).
  let hnonce = hx("000000090000004a0000000031415927")
  println("hchacha221=${encodeHex(hchacha20(key, hnonce))}")
}
