// std/crypto AES, GCM and SHA-256: a single project that checks every vector
// against its own hard-coded expected value and reports the verdict through
// its exit code (#2525, epic #1224) — unlike the existing per-primitive
// projects (cryptoaes, cryptogcm, cryptosha256), which print raw hex for the
// harness's external string diff. It exits 0 when every vector matches and
// exits 1, with each failing vector's name on stderr, otherwise.
//
// It is meant to also be run directly, TWICE, under BOTH `BIT_CRYPTO_HW`
// settings and diffed: `./bit-out/bin/bit run tests/imports/cryptokat` and
// the same with `BIT_CRYPTO_HW=0`. Today nothing in `stdlib/crypto` or
// `runtime/cryptohw` consults `BIT_CRYPTO_HW`, or even `bit_rt_crypto_hwcaps`
// (the ARM64 capability probe #2520 added) — `hwAvailableAes`/
// `hwAvailableGhash`/`hwAvailableSha256` below query the x86-64-only
// `bit_rt_crypto_*_hw_available` pins, which are hard-coded `false` on every
// target (see `runtime/cryptohw/cryptohw.bit`'s header) — so the two runs are
// expected to be byte-identical until #2526/#2527/#2528 route the compute
// path through a real hardware dispatch. This file exists to make that
// disagreement visible the day it can occur, not to prove it occurs today.
//
// Vector provenance — none of these were produced by the code under test:
//   AES-128 ECB, one block:        FIPS 197 Appendix B (the same vector
//                                    checked into tests/imports/cryptoaes)
//   SHA-256 "", "abc", 2-block msg: FIPS 180-4 Appendix B.1-B.2 (the same
//                                    vectors checked into
//                                    tests/imports/cryptosha256)
//   AES-GCM Test Cases 1-4:         NIST SP 800-38D Appendix B (Test Cases
//                                    2-4 are the same vectors checked into
//                                    tests/imports/cryptogcm; Test Case 1 —
//                                    empty plaintext, empty AAD — is new
//                                    here and covers the empty-input case)
import { newAes, newGcm, newSha256, digest, encodeHex, decodeHex, hwAvailableAes, hwAvailableGhash, hwAvailableSha256 } from "std/crypto"
import { exit } from "std/os"

// Appends `name` to `fails` when `got != want`, so every vector is checked
// even after an earlier one fails.
fn check(fails: []string, name: string, got: string, want: string): []string {
  if (got == want) {
    return fails
  }
  return append(fails, name)
}

// Encrypt `ptHex` under `keyHex` with AES, one block, as lowercase hex.
fn aesEncHex(keyHex: string, ptHex: string): string {
  let key = decodeHex(keyHex) catch e { return "badkey" }
  let pt = decodeHex(ptHex) catch e { return "badpt" }
  let c = newAes(key) catch e { return "badaes" }
  return encodeHex(c.encryptBlock(pt))
}

// Decrypt `ctHex` under `keyHex` back to plaintext hex.
fn aesDecHex(keyHex: string, ctHex: string): string {
  let key = decodeHex(keyHex) catch e { return "badkey" }
  let ct = decodeHex(ctHex) catch e { return "badct" }
  let c = newAes(key) catch e { return "badaes" }
  return encodeHex(c.decryptBlock(ct))
}

// One-shot SHA-256 of `s`, as lowercase hex.
fn sha256Hex(s: string): string {
  return encodeHex(digest(newSha256(), []byte(s)))
}

// Seal `ptHex` under `keyHex`/`ivHex` with `aadHex`, returning ct||tag as hex.
fn gcmSealHex(keyHex: string, ivHex: string, ptHex: string, aadHex: string): string {
  let key = decodeHex(keyHex) catch e { return "badkey" }
  let iv = decodeHex(ivHex) catch e { return "badiv" }
  let pt = decodeHex(ptHex) catch e { return "badpt" }
  let aad = decodeHex(aadHex) catch e { return "badaad" }
  let g = newGcm(key) catch e { return "badgcm" }
  return encodeHex(g.seal(iv, pt, aad))
}

// Open the sealed ct||tag back under the same key/nonce/aad and compare
// against `ptHex` — the legitimate round trip, not the tamper case below.
fn gcmOpenMatches(keyHex: string, ivHex: string, ptHex: string, aadHex: string): bool {
  let key = decodeHex(keyHex) catch e { return false }
  let iv = decodeHex(ivHex) catch e { return false }
  let pt = decodeHex(ptHex) catch e { return false }
  let aad = decodeHex(aadHex) catch e { return false }
  let g = newGcm(key) catch e { return false }
  let sealed = g.seal(iv, pt, aad)
  let opened = g.open(iv, sealed, aad) catch e { return false }
  return encodeHex(opened) == ptHex
}

// A single flipped tag byte must make `open` fail, never return plaintext.
fn gcmTamperRejected(keyHex: string, ivHex: string, ptHex: string, aadHex: string): bool {
  let key = decodeHex(keyHex) catch e { return false }
  let iv = decodeHex(ivHex) catch e { return false }
  let pt = decodeHex(ptHex) catch e { return false }
  let aad = decodeHex(aadHex) catch e { return false }
  let g = newGcm(key) catch e { return false }
  let sealed = g.seal(iv, pt, aad)
  let bad = []byte(len(sealed))
  let i = 0
  while (i < len(sealed)) {
    bad[i] = sealed[i]
    i = i + 1
  }
  bad[len(bad) - 1] = bad[len(bad) - 1] ^ 0xff
  let opened = g.open(iv, bad, aad) catch e { return true }
  return false
}

fn main() {
  // Diagnostic only (stderr, not part of the pass/fail verdict): which path
  // this run actually took. See the header above for why these are always
  // false today, under either BIT_CRYPTO_HW setting.
  eprint("hwAvailableAes=${hwAvailableAes()} hwAvailableGhash=${hwAvailableGhash()} hwAvailableSha256=${hwAvailableSha256()}\n")

  let fails = []string(0)

  // --- AES-128 ECB, one exact block. FIPS 197 Appendix B.
  let aesKey = "000102030405060708090a0b0c0d0e0f"
  let aesPt = "00112233445566778899aabbccddeeff"
  let aesCt = "69c4e0d86a7b0430d8cdb78070b4c55a"
  fails = check(fails, "aes128Encrypt", aesEncHex(aesKey, aesPt), aesCt)
  fails = check(fails, "aes128Decrypt", aesDecHex(aesKey, aesCt), aesPt)

  // --- SHA-256. FIPS 180-4: empty input, a sub-block ("abc", 3 bytes, well
  // under the 64-byte compression block), and the 56-byte two-block message.
  fails = check(fails, "sha256empty", sha256Hex(""),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  fails = check(fails, "sha256abc", sha256Hex("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  fails = check(fails, "sha256twoblock",
    sha256Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
    "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

  // --- AES-GCM. NIST SP 800-38D Appendix B, Test Cases 1-4: an empty
  // plaintext (TC1), one exact 16-byte block (TC2), an exact multiple of the
  // block size at 64 bytes / 4 blocks (TC3), and a multi-block plaintext
  // with a non-exact 60-byte length plus AAD (TC4). TC1-3 have no AAD; TC4
  // does, satisfying "at least one case with AAD and one without".
  let zeroKey128 = "00000000000000000000000000000000"
  let zeroIv = "000000000000000000000000"
  let zeroBlk = "00000000000000000000000000000000"
  let key128 = "feffe9928665731c6d6a8f9467308308"
  let iv96 = "cafebabefacedbaddecaf888"
  let pt3 = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
  let pt4 = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
  let aad4 = "feedfacedeadbeeffeedfacedeadbeefabaddad2"

  fails = check(fails, "gcmTC1empty", gcmSealHex(zeroKey128, zeroIv, "", ""),
    "58e2fccefa7e3061367f1d57a4e7455a")
  fails = check(fails, "gcmTC2oneBlock", gcmSealHex(zeroKey128, zeroIv, zeroBlk, ""),
    "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf")
  fails = check(fails, "gcmTC3fourBlocks", gcmSealHex(key128, iv96, pt3, ""),
    "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4")
  fails = check(fails, "gcmTC4partialBlockWithAad", gcmSealHex(key128, iv96, pt4, aad4),
    "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47")

  if (!gcmOpenMatches(key128, iv96, pt4, aad4)) {
    fails = append(fails, "gcmTC4RoundTrip")
  }
  if (!gcmTamperRejected(key128, iv96, pt4, aad4)) {
    fails = append(fails, "gcmTC4TamperNotRejected")
  }

  if (len(fails) > 0) {
    let i = 0
    while (i < len(fails)) {
      eprint("FAIL: ${fails[i]}\n")
      i = i + 1
    }
    exit(1)
  }

  println("PASS: aes+gcm+sha256 known-answer vectors, both hardware-detection settings runnable")
}
