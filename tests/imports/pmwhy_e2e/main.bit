// End-to-end regression coverage for `bit why <name>` (#3511) through the
// real dispatched CLI, mirroring `tests/imports/pmtransitive_e2e`'s technique
// (see that file's own header for why an exec of `BIT_SELF_EXE` is required
// here instead of a unit call into `compiler/pmcliwhy.bit`'s internals:
// `compiler/` is the compiler's own implementation and is not importable
// from a program the compiler builds). The STRUCTURE is copied; the
// ASSERTIONS are not — `pmtransitive_e2e` is suspected failing on `main`
// right now because it asserts the retired MVS resolver's version-arbitration
// semantics (#2366 replaced it with PubGrub, #3561 is the open repair
// ticket). This fixture sidesteps that entirely: every requirer of
// `textutil` below asks for the SAME version, so there is no version
// arbitration to get right or wrong — only graph SHAPE matters here, which
// is the only thing `bit why` reads (`LockEntry.requires`, verbatim).
//
// The graph is a genuine diamond, discovered in ONE `bit add` so it
// exercises real transitive resolution rather than a hand-written bit.lock:
//
//   project -> libtop -> { liba -> textutil@main, libb -> textutil@main }
//
// `textutil` is reachable through TWO different requirers in the SAME
// resolution walk — exactly the case `bit why` exists for (#3511's own
// ticket: "every path if a package is reachable more than one way, since a
// diamond is exactly when someone asks").
//
// EVERY spec below is a BRANCH ref (`@main`), never a version TAG
// (`@vX.Y.Z`) — found empirically, not by design: a tag-based `bit add`
// (even a trivial single-dependency one, no diamond at all) currently fails
// on this branch with "<name> conflicts: root requires vX.Y.Z; <name>
// X.Y.Z requires vX.Y.Z" — the exact shape `pmtransitive_e2e` already hits,
// confirming this is the SAME live PubGrub-migration defect (#2366/#3561),
// not something this diamond shape triggers on its own. Filed separately as
// its own ticket per this ticket's "file it as its own ticket the moment
// you find it" instruction; not fixed here.
//
// After the real `bit add`, `libtop.bit` genuinely imports and calls both
// `liba`/`libb`'s exports, and the project's own `main.bit` genuinely
// imports and calls `libtop`'s `combine()` — so `bit run` on the project
// (below, BEFORE any `bit why` assertion, per the ticket's acceptance line
// "`bit run` ... exits 0 first") proves the graph actually LINKS, not just
// that it PARSED.
//
// The host is `github.com`, a KNOWN git host (`pmfetch.bit`'s
// `isKnownGitHost`) — required for every spec here to resolve as a DIRECT
// dependency rather than a vanity name (#2068). Every fetch is redirected to
// a local fixture via `GIT_CONFIG_GLOBAL`'s `url.<file-url>.insteadOf`
// mechanism, scoped to a scratch config file this test creates.
//
// `BIT_PKG_CACHE` (not `HOME`'s default `~/.bit/pkg`) points every command
// below — `add`, `run`, and every `bit why` — at one scratch cache, so `bit
// run` resolves `libtop`'s import from the exact bytes `bit add` fetched,
// with no second fetch and no reach into the developer's real cache.
//
// Unhappy paths covered, each asserted as ITS OWN distinct message/exit —
// see #3511's "cover the unhappy paths explicitly" instruction:
//   - a name absent from bit.lock entirely (`nosuchpkg`)
//   - a name that IS the root project's own direct dependency (`libtop`,
//     the one-hop case)
//   - a package reachable by more than one path (`textutil`, the diamond)
//   - a locked but UNREACHABLE ("orphan") entry, hand-inserted into
//     bit.lock after the real add via std/json's CST edit layer
//     (`cstSetStringPath`) — the one case a real dependency graph can never
//     produce on its own, so it must be constructed by hand, same as
//     #3511's own ticket says
//   - a REAL cycle in `requires` (`liba` and `libb` hand-edited to each
//     require the other, on top of their real shared `textutil`
//     requirement) — proves `whyWalk`'s cycle guard actually terminates a
//     real cyclic walk rather than merely being asserted to
//   - outside a project entirely: see `tests/bit/clicmd/cases.bit`'s
//     `why-no-project` case, which needs no fixture (the clicmd corpus root
//     already has no bit.json)
import { env, envOr } from "std/os"
import { isDir, mkdir, readFile, remove, writeFile } from "std/fs"
import { split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { cstParse, cstPrint, cstSetStringPath } from "std/json"

// mkdir -p, iteratively (Power of 10 rule 2) — same small per-file copy
// `pmtransitive_e2e`/`pmadd_e2e` each carry; `compiler/pmfetch.bit`'s own
// version is not importable from a program the compiler builds.
fn mkdirAll(path: string): ()! {
  if (len(path) == 0 || isDir(path)) {
    return
  }
  let parts = split(path, "/")
  let acc = ""
  let i = 0
  while (i < len(parts)) {
    if (len(parts[i]) > 0) {
      acc = acc + "/" + parts[i]
      if (!isDir(acc)) {
        mkdir(acc)?
      }
    }
    i = i + 1
  }
}

fn scratchRoot(): string {
  return envOr("TMPDIR", "/tmp") + "/bit-pmwhy-e2e-" + uuidFormat(uuidV4())
}

// Runs a throwaway `/bin/sh` script and returns its exit code. No deadline
// watcher: every step below is a local git op or this program's own compiler
// against a fixed local fixture, and the whole process is already bounded by
// the harness's own per-case watchdog (tests/bit/importsrun/importsrun.bit).
fn runShell(script: string): int! {
  let scriptPath = scratchRoot() + ".sh"
  defer removeQuiet(scriptPath)
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700: owner rwx only
    fail newError("pmwhy_e2e: cannot make script executable: ${scriptPath}")
  }
  return osRun(scriptPath, []string(0))
}

fn removeQuiet(path: string) {
  remove(path) catch e { return }
}

fn gitInit(dir: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git init -q -b main '${dir}'\n" +
    "git -C '${dir}' config user.email 'pmwhy-e2e@bit-lang.invalid'\n" +
    "git -C '${dir}' config user.name 'pmwhy_e2e fixture'\n" +
    "git -C '${dir}' config tag.gpgsign false\n" +
    "git -C '${dir}' config commit.gpgsign false\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmwhy_e2e: git init failed for ${dir} (exit ${code})")
  }
}

// No `git tag`: every dependency spec below is a BRANCH ref (`@main`), so
// nothing here ever needs one (see this file's header for why).
fn gitCommit(dir: string, msg: string, date: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git -C '${dir}' add -A\n" +
    "GIT_AUTHOR_DATE='${date}' GIT_COMMITTER_DATE='${date}' " +
    "git -C '${dir}' commit -q --no-gpg-sign -m '${msg}'\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmwhy_e2e: git commit failed for ${dir} (exit ${code})")
  }
}

fn buildTextutil(dir: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/textutil.bit", "export fn slugify(s: string): string { return s }\n")?
  writeFile(dir + "/bit.json", "{\n  \"name\": \"textutil\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {}\n}\n")?
  gitInit(dir)?
  gitCommit(dir, "textutil", "2020-01-01T00:00:00+0000")?
}

// `liba`/`libb`: one commit each, BOTH requiring the SAME `textutil`
// branch ref — deliberately, so no version arbitration (MVS vs PubGrub,
// #3561) is exercised by this fixture, only graph shape.
fn buildLib(dir: string, libName: string, date: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/${libName}.bit",
    "import { slugify } from \"textutil\"\n" +
    "export fn idFor(t: string): string { return \"${libName}-\" + slugify(t) }\n")?
  writeFile(dir + "/bit.json",
    "{\n  \"name\": \"${libName}\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n" +
    "    \"textutil\": \"github.com/pmwhy-e2e/textutil@main\"\n  }\n}\n")?
  gitInit(dir)?
  gitCommit(dir, libName, date)?
}

// The convergence point: depends directly on BOTH `liba` and `libb`, and
// genuinely calls both exports — so a successful `bit run` of the project
// (which calls THIS module's own export) proves the whole chain links.
fn buildLibtop(dir: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/libtop.bit",
    "import { idFor as aId } from \"liba\"\n" +
    "import { idFor as bId } from \"libb\"\n" +
    "export fn combine(t: string): string { return aId(t) + bId(t) }\n")?
  writeFile(dir + "/bit.json",
    "{\n  \"name\": \"libtop\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n" +
    "    \"liba\": \"github.com/pmwhy-e2e/liba@main\",\n" +
    "    \"libb\": \"github.com/pmwhy-e2e/libb@main\"\n  }\n}\n")?
  gitInit(dir)?
  gitCommit(dir, "libtop", "2020-01-04T00:00:00+0000")?
}

// The project `bit add`/`bit run`/`bit why` all run against. `main.bit`
// genuinely imports and calls `libtop`'s export, so `bit run` proves real
// link+run, not just that `bit add` wrote a plausible-looking bit.lock.
fn buildProject(dir: string): ()! {
  mkdirAll(dir)?
  writeFile(dir + "/bit.json", "{\n  \"name\": \"pmwhy-e2e-project\",\n  \"dependencies\": {}\n}\n")?
  writeFile(dir + "/main.bit",
    "import { combine } from \"libtop\"\n" +
    "fn main() { println(combine(\"z\")) }\n")?
}

fn writeInsteadOfConfig(configPath: string, textutilDir: string, libaDir: string, libbDir: string, libtopDir: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git config -f '${configPath}' url.'file://${textutilDir}'.insteadOf 'https://github.com/pmwhy-e2e/textutil.git'\n" +
    "git config -f '${configPath}' url.'file://${libaDir}'.insteadOf 'https://github.com/pmwhy-e2e/liba.git'\n" +
    "git config -f '${configPath}' url.'file://${libbDir}'.insteadOf 'https://github.com/pmwhy-e2e/libb.git'\n" +
    "git config -f '${configPath}' url.'file://${libtopDir}'.insteadOf 'https://github.com/pmwhy-e2e/libtop.git'\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmwhy_e2e: writing insteadOf config failed (exit ${code})")
  }
}

class FixturePaths {
  home: string
  cache: string
  configPath: string
  projectDir: string
}

fn setupFixtures(root: string): FixturePaths! {
  let textutilDir = root + "/textutil"
  let libaDir = root + "/liba"
  let libbDir = root + "/libb"
  let libtopDir = root + "/libtop"
  let projectDir = root + "/project"
  let home = root + "/home"
  let cache = root + "/pkgcache" // isolates BIT_PKG_CACHE to this run
  let configPath = root + "/gitconfig"

  buildTextutil(textutilDir)?
  buildLib(libaDir, "liba", "2020-01-02T00:00:00+0000")?
  buildLib(libbDir, "libb", "2020-01-03T00:00:00+0000")?
  buildLibtop(libtopDir)?
  buildProject(projectDir)?
  mkdirAll(home)?
  mkdirAll(cache)?
  writeInsteadOfConfig(configPath, textutilDir, libaDir, libbDir, libtopDir)?

  return FixturePaths{ home: home, cache: cache, configPath: configPath, projectDir: projectDir }
}

// Every env var every command below needs: an isolated HOME and git config
// (so `bit add`'s fetches never touch the real ~/.gitconfig) and a shared
// BIT_PKG_CACHE (so `bit run` and `bit why` never re-fetch anything `bit
// add` already wrote).
fn envPrefix(paths: FixturePaths): string {
  return "export HOME='${paths.home}'\n" +
    "export GIT_CONFIG_GLOBAL='${paths.configPath}'\n" +
    "export BIT_PKG_CACHE='${paths.cache}'\n"
}

fn addDependency(selfExe: string, paths: FixturePaths): int! {
  let script = "#!/bin/sh\n" + envPrefix(paths) +
    "'${selfExe}' add github.com/pmwhy-e2e/libtop@main --dir '${paths.projectDir}' >/dev/null 2>&1\n" +
    "exit $?\n"
  return runShell(script)?
}

// `bit run` on the real dispatched CLI — proves the diamond genuinely
// LINKS, not just that `bit add` wrote a plausible bit.lock. Output goes to
// `outPath`; the exit code is this function's own return value, read
// directly (never through a pipe), per #3511's acceptance line.
fn runProject(selfExe: string, paths: FixturePaths, outPath: string): int! {
  let script = "#!/bin/sh\n" + envPrefix(paths) +
    "'${selfExe}' run '${paths.projectDir}' > '${outPath}' 2>&1\n" +
    "exit $?\n"
  return runShell(script)?
}

// One `bit why <name>` call, cwd'd into the project (`why` has no `--dir`
// flag — it always reads "."). `cd` failing is distinguished with a reserved
// exit code so a harness bug can never masquerade as `why`'s own verdict.
fn runWhy(selfExe: string, paths: FixturePaths, name: string, outPath: string): int! {
  let script = "#!/bin/sh\n" +
    "cd '${paths.projectDir}' || exit 111\n" +
    "'${selfExe}' why ${name} > '${outPath}' 2>&1\n" +
    "exit $?\n"
  return runShell(script)?
}

fn readCaptured(path: string): string {
  return readFile(path) catch e { "<unreadable: " + e.message() + ">" }
}

fn reportCaptured(label: string, code: int, outPath: string) {
  println("${label} exit: ${code}")
  println("--- ${label} ---")
  print(readCaptured(outPath))
}

fn lsA(dir: string, outPath: string): string! {
  let script = "#!/bin/sh\nls -a '${dir}' > '${outPath}'\n"
  runShell(script)?
  return readFile(outPath)?
}

// Hand-edits the real, `bit add`-written bit.lock via std/json's CST edit
// layer (the same layer `bit add` itself uses on bit.json) to add TWO
// things a real resolution can never produce on its own, both needed by
// #3511's own "cover the unhappy paths" instruction:
//   - an ORPHAN entry: locked, but reachable from nothing in bit.json.
//   - a REAL CYCLE: `liba` and `libb` are each given an extra `requires`
//     edge pointing at the OTHER, on top of their real shared `textutil`
//     requirement — so `liba -> libb -> liba -> ...` is a genuine cycle in
//     the data `whyWalk` walks, not a hypothetical one.
fn mutateLock(lockPath: string): ()! {
  let src = readFile(lockPath)?
  let doc = cstParse(src)?
  let d1 = cstSetStringPath(doc, []string{ "liba", "requires", "libb" }, "github.com/pmwhy-e2e/libb@main")?
  let d2 = cstSetStringPath(d1, []string{ "libb", "requires", "liba" }, "github.com/pmwhy-e2e/liba@main")?
  let d3 = cstSetStringPath(d2, []string{ "orphanpkg", "url" }, "https://github.com/pmwhy-e2e/orphanpkg.git")?
  let d4 = cstSetStringPath(d3, []string{ "orphanpkg", "commit" }, "0000000000000000000000000000000000000000")?
  writeFile(lockPath, cstPrint(d4))?
}

// `bit add` the diamond, then `bit run` the project — the latter FIRST,
// before any `bit why` assertion (#3511's acceptance line), proving the
// graph genuinely resolved and links rather than merely that `bit add`
// wrote a plausible-looking bit.lock.
fn addAndRun(selfExe: string, paths: FixturePaths, root: string) {
  let addCode = addDependency(selfExe, paths) catch e {
    panic("pmwhy_e2e: bit add: " + e.message())
    -1
  }
  println("bit add exit: ${addCode}")

  let runOut = root + "/run.out"
  let runCode = runProject(selfExe, paths, runOut) catch e {
    panic("pmwhy_e2e: bit run: " + e.message())
    -1
  }
  reportCaptured("bit run", runCode, runOut)
}

// The diamond (`textutil`, reachable via both `liba` and `libb`) and the
// one-hop direct dependency (`libtop`) — the latter wrapped in an `ls -a`
// before/after to prove `bit why` creates no file.
fn diamondAndOneHop(selfExe: string, paths: FixturePaths, root: string) {
  let out1 = root + "/why-textutil.out"
  let c1 = runWhy(selfExe, paths, "textutil", out1) catch e {
    panic("pmwhy_e2e: bit why textutil: " + e.message())
    -1
  }
  reportCaptured("bit why textutil", c1, out1)

  let lsBefore = lsA(paths.projectDir, root + "/ls-before.txt") catch e {
    panic("pmwhy_e2e: ls -a (before): " + e.message())
    ""
  }
  let out2 = root + "/why-libtop.out"
  let c2 = runWhy(selfExe, paths, "libtop", out2) catch e {
    panic("pmwhy_e2e: bit why libtop: " + e.message())
    -1
  }
  let lsAfter = lsA(paths.projectDir, root + "/ls-after.txt") catch e {
    panic("pmwhy_e2e: ls -a (after): " + e.message())
    ""
  }
  reportCaptured("bit why libtop", c2, out2)
  println("ls -a unchanged around bit why libtop: ${lsBefore == lsAfter}")
}

// A name absent from bit.lock entirely, then the hand-edit that adds an
// orphan entry and a real `liba<->libb` cycle for the next phase to query.
fn notFoundThenMutate(selfExe: string, paths: FixturePaths, root: string) {
  let out3 = root + "/why-nosuchpkg.out"
  let c3 = runWhy(selfExe, paths, "nosuchpkg", out3) catch e {
    panic("pmwhy_e2e: bit why nosuchpkg: " + e.message())
    -1
  }
  reportCaptured("bit why nosuchpkg", c3, out3)

  mutateLock(paths.projectDir + "/bit.lock") catch e {
    panic("pmwhy_e2e: mutateLock: " + e.message())
  }
}

// The orphan entry (locked but unreachable — a DIFFERENT message than
// "absent entirely") and the diamond query re-run against the now-cyclic
// lock, proving `whyWalk`'s cycle guard terminates a genuine cyclic walk.
fn orphanAndCycle(selfExe: string, paths: FixturePaths, root: string) {
  let out4 = root + "/why-orphanpkg.out"
  let c4 = runWhy(selfExe, paths, "orphanpkg", out4) catch e {
    panic("pmwhy_e2e: bit why orphanpkg: " + e.message())
    -1
  }
  reportCaptured("bit why orphanpkg", c4, out4)

  let out5 = root + "/why-textutil-cycled.out"
  let c5 = runWhy(selfExe, paths, "textutil", out5) catch e {
    panic("pmwhy_e2e: bit why textutil (cycled): " + e.message())
    -1
  }
  reportCaptured("bit why textutil (cycled lock)", c5, out5)
}

// `bit why` entirely outside a project (#3511's acceptance line: a clear
// message, non-zero exit, and `ls -a` before/after proving no file was
// created). `capDir` is a SIBLING of `outsideDir`, never a child of it —
// both the `ls -a` snapshots and `bit why`'s own captured stdout have to
// live outside the directory being watched, or the act of capturing them
// would itself show up as the very pollution this check is trying to rule
// out.
fn outsideProject(selfExe: string, outsideDir: string, capDir: string): ()! {
  mkdirAll(outsideDir)?
  mkdirAll(capDir)?
  let lsBefore = lsA(outsideDir, capDir + "/ls-outside-before.txt")?
  let outPath = capDir + "/why-outside.out"
  let script = "#!/bin/sh\n" +
    "cd '${outsideDir}' || exit 111\n" +
    "'${selfExe}' why somepkg > '${outPath}' 2>&1\n" +
    "exit $?\n"
  let code = runShell(script)?
  let lsAfter = lsA(outsideDir, capDir + "/ls-outside-after.txt")?
  reportCaptured("bit why somepkg (outside a project)", code, outPath)
  println("ls -a unchanged around bit why outside a project: ${lsBefore == lsAfter}")
}

fn main() {
  let selfExe = env("BIT_SELF_EXE")
  if (len(selfExe) == 0) {
    panic("pmwhy_e2e: BIT_SELF_EXE is not set — the tests/imports harness must set it (#1767)")
  }

  let root = scratchRoot()
  mkdirAll(root) catch e {
    panic("pmwhy_e2e: cannot create scratch root: " + e.message())
  }
  let paths = setupFixtures(root) catch e {
    panic("pmwhy_e2e: " + e.message())
    FixturePaths{ home: "", cache: "", configPath: "", projectDir: "" }
  }

  addAndRun(selfExe, paths, root)
  diamondAndOneHop(selfExe, paths, root)
  notFoundThenMutate(selfExe, paths, root)
  orphanAndCycle(selfExe, paths, root)
  outsideProject(selfExe, root + "/outside", root + "-cap") catch e {
    panic("pmwhy_e2e: outsideProject: " + e.message())
  }
}
