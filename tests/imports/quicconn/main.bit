// std/quic QUIC v1 transport core (#1220): a full connection over a local UDP
// pair, driven by two green-thread endpoints (spawn + channels). Six scenarios:
//
//   * direct — complete the QUIC-TLS handshake, open a client bidi stream,
//     transfer a 96 KiB payload, and assert byte-identical delivery (the
//     received SHA-256 equals the sent one). The payload is three times the
//     32 KiB flow-control window, so it exercises multiple packets, MAX_DATA /
//     MAX_STREAM_DATA window extension, and NewReno pacing.
//
//   * loss — the same transfer, but a shim relay between the endpoints drops a
//     deterministic fraction of the 1-RTT datagrams (never the handshake), so
//     retransmission (packet-threshold + PTO) must recover the whole stream.
//
//   * listener — accept two connections on one shared socket, close the first,
//     then require a round trip on the second and a brand-new third connection.
//     Closing one accepted connection used to close the listener's socket (#1473).
//
//   * idle — blackhole the peer after the handshake and require a thread parked
//     in `finish` to come back with an error in bounded time (#1449/#1474).
//
//   * reset — the client resets a freshly-opened stream; the server's first
//     `read` on it must return a reset chunk promptly rather than hang on data
//     that will never arrive (#3229).
//
//   * streamlimit — open the peer's advertised 16-stream limit, then require the
//     17th `openStream` to fail distinctly instead of the limit going
//     unenforced (#3229).
//
// Every printed line is a boolean, a byte count, a content hash, or a fixed
// error string — nothing timing-dependent — so the golden is stable across
// targets and schedules.
//
// This program is NOT run under `BIT_GC=stress`, and that hole is declared and
// argued in tests/bit/stress/stress.bit rather than left to be inferred (#1475): a QUIC-TLS
// handshake is millions of loop back-edges, stress collects at every one of them,
// and even a 1-byte payload does not finish in 300s. It is not a QUIC defect —
// `tests/imports/cryptorsa` behaves the same way — and it is not the #1462
// no-safepoint shape, which the measurements there rule out explicitly.
import { dialQuic, acceptQuic, listenQuic, Conn, Listener, Stream, StreamChunk } from "std/quic"
import { udpBind, UdpSocket } from "std/net"
import { monotonic } from "std/time"
import { newSha256, encodeHex, decodeHex, pemEncode } from "std/crypto"

const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

const payloadBytes: int = 98304
const dropEvery: int = 10

fn hx(s: string): []byte { return decodeHex(s) catch e { return []byte(0) } }
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

// The server certificate chain (leaf then CA) and its RSA key, as PEM.
fn chainPem(): string { return pemOf("CERTIFICATE", leafHex) + pemOf("CERTIFICATE", caHex) }
fn keyPem(): string { return pemOf("PRIVATE KEY", keyHex) }

// A deterministic pseudo-random payload (a linear congruential stream), so the
// content hash is fixed across runs.
fn makePayload(n: int): []byte {
  let out = []byte(n)
  let x = u32(0x12345678)
  let i = 0
  while (i < n) {
    x = x * u32(1664525) + u32(1013904223)
    out[i] = byte(x >> u32(24))
    i = i + 1
  }
  return out
}

fn sha256Hex(data: []byte): string {
  let h = newSha256()
  h.write(data)
  return encodeHex(h.sum())
}

fn boolStr(b: bool): string {
  if (b) { return "true" }
  return "false"
}

// A shared drop counter the loss shim increments and the driver reads once the
// transfer has settled.
struct Counter { n: int }

// Forward one datagram, ignoring a send error (a closed socket at shutdown).
fn relay(sock: UdpSocket, host: string, port: int, data: string) {
  sock.send(host, port, data) catch e {
    return
  }
}

// The server endpoint: accept the connection, accept the client's bidi stream,
// read it to completion, and report "<sha256>:<len>" (or an error tag).
fn serverRole(sock: UdpSocket, chain: string, keyp: string, resultCh: chan<string>) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    resultCh <- "server-handshake-failed"
    return
  }
  let s = conn.acceptStream() catch e {
    resultCh <- "accept-failed"
    return
  }
  let got = []byte(0)
  let done = false
  let guard = 0
  while (!done && guard < 1000000) {
    guard = guard + 1
    let chunk = s.read() catch e {
      done = true
      continue
    }
    for b of chunk.data {
      got = append(got, b)
    }
    if (chunk.fin) {
      done = true
    }
  }
  resultCh <- "${sha256Hex(got)}:${len(got)}"
  conn.close()
}

// The loss shim: one UDP socket between the client and the server. Datagrams
// from the server go to the client and vice versa; a deterministic 1-in-N of the
// 1-RTT (short-header) datagrams is dropped. Handshake (long-header) datagrams
// are never dropped, so the handshake always completes.
fn lossShim(sock: UdpSocket, srvHost: string, srvPort: int, ctr: Counter) {
  let cliHost = ""
  let cliPort = 0
  let haveCli = false
  let seen = 0
  while (true) {
    let d = sock.recv(2048) catch e {
      return
    }
    let fromSrv = d.host == srvHost && d.port == srvPort
    if (!fromSrv) {
      cliHost = d.host
      cliPort = d.port
      haveCli = true
    }
    let bytes = []byte(d.data)
    let isLong = len(bytes) > 0 && (int(bytes[0]) & 0x80) != 0
    if (!isLong) {
      seen = seen + 1
      if (seen % dropEvery == 0) {
        ctr.n = ctr.n + 1
        continue
      }
    }
    if (fromSrv) {
      if (haveCli) {
        relay(sock, cliHost, cliPort, d.data)
      }
    } else {
      relay(sock, srvHost, srvPort, d.data)
    }
  }
}

// Client side of a transfer: dial `port`, open a stream, send `payload`, wait for
// full acknowledgement, close.
fn clientSend(port: int, payload: []byte): bool {
  let conn = dialQuic("127.0.0.1", port, "localhost") catch e {
    return false
  }
  let s = conn.openStream() catch e {
    return false
  }
  s.write(payload) catch e {
    return false
  }
  s.finish() catch e {
    return false
  }
  conn.close()
  return true
}

// A shared switch the driver flips to make the blackhole shim stop forwarding.
struct Switch { on: int }

// A relay that forwards both directions until `sw.on` is set, then drops
// everything. Stands in for a peer that vanishes: still reachable at the socket
// layer, but never answering again — the case RFC 9000 §10.1's idle timeout
// exists for, and the one a PTO series alone retransmits into forever (#1449).
fn blackholeShim(sock: UdpSocket, srvHost: string, srvPort: int, sw: Switch) {
  let cliHost = ""
  let cliPort = 0
  let haveCli = false
  while (true) {
    let d = sock.recv(2048) catch e {
      return
    }
    let fromSrv = d.host == srvHost && d.port == srvPort
    if (!fromSrv) {
      cliHost = d.host
      cliPort = d.port
      haveCli = true
    }
    if (sw.on != 0) {
      continue
    }
    if (fromSrv) {
      if (haveCli) {
        relay(sock, cliHost, cliPort, d.data)
      }
    } else {
      relay(sock, srvHost, srvPort, d.data)
    }
  }
}

// True if the stream failed to drain — a separate function because a `catch`
// block has to divert control, so it cannot just set a flag in place.
fn finishFailed(s: Stream): bool {
  s.finish() catch e {
    return true
  }
  return false
}

const idleTimeoutNs: int = 500000000
const idleBoundNs: int = 5000000000

// #1449 / #1474: with the peer blackholed, a thread parked in `finish` must come
// back with an error once the idle timeout expires instead of waiting forever.
// `setIdleTimeout` is what makes this assertable in-suite at all — at the 30s
// default the same assertion costs ~31s of wall clock, which is why the original
// fix shipped untested.
fn idleScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let shim = udpBind("127.0.0.1", 0)?
  let shimPort = shim.port()?
  let sw = Switch{ on: 0 }
  spawn blackholeShim(shim, "127.0.0.1", srvPort, sw)
  let res = chan<string>(1)
  spawn serverRole(srv, chain, keyp, res)
  let conn = dialQuic("127.0.0.1", shimPort, "localhost") catch e {
    println("idle_handshake=false")
    return
  }
  println("idle_handshake=true")
  conn.setIdleTimeout(idleTimeoutNs)
  // The peer vanishes here: after the handshake, before any stream byte is
  // acknowledged, so `finish` has no way to ever make progress.
  sw.on = 1
  let s = conn.openStream()?
  s.write([]byte("ping"))?
  let start = monotonic()
  let failed = finishFailed(s)
  let elapsed = monotonic() - start
  println("idle_finish_failed=${boolStr(failed)}")
  println("idle_bounded=${boolStr(elapsed < idleBoundNs)}")
}

const resetErrCode: int = 42

// #3229: the server side of the reset scenario. A short idle timeout means an
// unfixed regression (the `ResetStream` arm back to a no-op) does not hang the
// whole suite: `read` would instead come back — slowly, via the pre-existing
// #1449 idle-timeout path — with a generic connection-closed error once nothing
// more arrives from the peer, rather than the reset chunk directly and
// promptly. `fast` is the discriminator between "fixed" and "reverted"; the
// read loop is bounded so a still-broken build fails this scenario instead of
// wedging every scenario after it.
//
// Reads until a reset chunk arrives or the connection ends, accumulating any
// data delivered first — the client writes a few bytes before resetting (see
// `resetScenario`'s comment for why: the stream must exist server-side, via a
// real STREAM frame, before RESET_STREAM references it; #3232).
fn resetServerRole(sock: UdpSocket, chain: string, keyp: string, resultCh: chan<string>) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    resultCh <- "handshake-failed"
    return
  }
  conn.setIdleTimeout(idleTimeoutNs)
  let s = conn.acceptStream() catch e {
    resultCh <- "accept-failed"
    return
  }
  let start = monotonic()
  let gotData = 0
  let sawReset = false
  let resetCode = -1
  let guard = 0
  while (!sawReset && guard < 1000) {
    guard = guard + 1
    let chunk = s.read() catch e {
      resultCh <- "read-failed"
      return
    }
    gotData = gotData + len(chunk.data)
    if (chunk.reset) {
      sawReset = true
      resetCode = chunk.resetCode
    }
  }
  let elapsed = monotonic() - start
  resultCh <- "reset=${boolStr(sawReset)}:code=${resetCode}:predata=${gotData}:" +
    "fast=${boolStr(elapsed < idleTimeoutNs)}"
}

// A `read()` on a stream the peer RESET_STREAM'd must return a distinguishable
// reset chunk instead of waiting for data or a FIN that will now never arrive
// (#3229's core finding). The client writes a few bytes first, so the server
// learns the stream exists via a real STREAM frame before the reset — resetting
// with zero prior writes hits a separate, pre-existing gap (#3232: no implicit
// stream creation from a non-STREAM frame) that would hang `acceptStream`
// rather than exercise the fix under test here.
fn resetScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn resetServerRole(srv, chain, keyp, res)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let s = conn.openStream()?
  s.write([]byte("hi"))?
  s.reset(resetErrCode)?
  let got = <- res
  println("reset_result=${got}")
  conn.close()
}

// "" if `conn.openStream` succeeds, else the error it failed with. A separate
// function because a `catch` block used as a statement must either produce a
// `Stream` or divert control (`return`), the same constraint `keyRejected` in
// tests/imports/cryptoaes/main.bit works around the same way.
fn tryOpenStream(conn: Conn): string {
  let s = conn.openStream() catch e { return e.message() }
  return ""
}

// The peer only ever advertises `initialMaxStreamsBidi = 16`
// (`quicconnLocalParams`); nothing gated `Conn.openStream` against it at all
// before #3229. Open exactly that many, then require the next one to fail
// distinctly (not hang, not fail with the generic "connection closed").
fn streamLimitScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  spawn acceptOnly(srv, chain, keyp)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let opened = 0
  let i = 0
  while (i < 16) {
    let s = conn.openStream()?
    opened = opened + 1
    i = i + 1
  }
  let msg = tryOpenStream(conn)
  println("streamlimit_opened=${opened}")
  println("streamlimit_17th_blocked=${boolStr(msg != "")}")
  println("streamlimit_17th_message=${msg}")
  conn.close()
}

// Complete the handshake and hold the connection open; `streamLimitScenario`
// needs a live peer only to learn the peer's advertised transport parameters —
// none of the streams it opens ever carry data, so the server never even learns
// they exist (a STREAM frame is what creates a stream server-side, and no
// `write` is ever called).
fn acceptOnly(sock: UdpSocket, chain: string, keyp: string) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    return
  }
  conn.setIdleTimeout(listenerIdleNs)
}

// One listener client: dial, open a stream, then wait for `go` before sending, so
// the driver controls exactly when traffic has to cross the shared socket.
fn listenerClient(port: int, msg: string, go: chan<int>, out: chan<string>) {
  let conn = dialQuic("127.0.0.1", port, "localhost") catch e {
    out <- "dial-failed"
    return
  }
  let s = conn.openStream() catch e {
    out <- "open-failed"
    return
  }
  <- go
  s.write([]byte(msg)) catch e {
    out <- "write-failed"
    return
  }
  s.finish() catch e {
    out <- "finish-failed"
    return
  }
  out <- "sent"
}

// Drain one accepted connection's first stream to FIN.
fn readStream(c: Conn): string {
  let s = c.acceptStream() catch e {
    return "accept-failed"
  }
  let got = []byte(0)
  let done = false
  let guard = 0
  while (!done && guard < 1000000) {
    guard = guard + 1
    let chunk = s.read() catch e {
      done = true
      continue
    }
    for b of chunk.data {
      got = append(got, b)
    }
    if (chunk.fin) {
      done = true
    }
  }
  return string(got)
}

const listenerIdleNs: int = 5000000000

// #1473: closing ONE listener-created connection must not touch the socket it
// shares with the listener and every sibling connection. Accept two, close the
// first, then require a full round trip on the second and a brand-new third
// connection — every one of which needs that socket alive, and none of which can
// be satisfied from data already buffered, because the clients hold their
// payload until told to send. The surviving connection gets a short idle timeout
// so a regressed build answers wrongly within seconds instead of hanging.
fn listenerScenario(chain: string, keyp: string): ()! {
  let lsock = udpBind("127.0.0.1", 0)?
  let port = lsock.port()?
  let lst = listenQuic(lsock, chain, keyp)?

  let goA = chan<int>(1)
  let outA = chan<string>(1)
  spawn listenerClient(port, "alpha", goA, outA)
  let c1 = lst.accept()?

  let goB = chan<int>(1)
  let outB = chan<string>(1)
  spawn listenerClient(port, "beta", goB, outB)
  let c2 = lst.accept()?
  c2.setIdleTimeout(listenerIdleNs)

  // The destructive act: before #1473 this closed `lsock` itself, taking the
  // accept loop and every sibling connection with it.
  c1.close()

  goB <- 1
  let got2 = readStream(c2)
  println("listener_sibling_roundtrip=${boolStr(got2 == "beta")}")

  let goC = chan<int>(1)
  let outC = chan<string>(1)
  goC <- 1
  spawn listenerClient(port, "gamma", goC, outC)
  // Read the client's own verdict first: it is bounded by the 5s dial handshake
  // timeout, so a dead listener socket surfaces as a failure here rather than
  // parking the accept below forever.
  let rc = <- outC
  let got3 = ""
  if (rc == "sent") {
    let c3 = lst.accept()?
    got3 = readStream(c3)
  }
  println("listener_third_accept=${boolStr(got3 == "gamma")}")
}

fn run(): ()! {
  let payload = makePayload(payloadBytes)
  let want = sha256Hex(payload)
  println("payload_len=${payloadBytes}")
  println("payload_hash=${want}")

  // --- direct: no loss ---
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn serverRole(srv, chainPem(), keyPem(), res)
  let ok = clientSend(srvPort, payload)
  let got = <- res
  println("direct_handshake=${boolStr(ok)}")
  println("direct_match=${boolStr(got == "${want}:${payloadBytes}")}")

  // --- loss: shim drops ~10% of 1-RTT datagrams ---
  let srv2 = udpBind("127.0.0.1", 0)?
  let srvPort2 = srv2.port()?
  let shim = udpBind("127.0.0.1", 0)?
  let shimPort = shim.port()?
  let ctr = Counter{ n: 0 }
  spawn lossShim(shim, "127.0.0.1", srvPort2, ctr)
  let res2 = chan<string>(1)
  spawn serverRole(srv2, chainPem(), keyPem(), res2)
  let ok2 = clientSend(shimPort, payload)
  let got2 = <- res2
  println("loss_handshake=${boolStr(ok2)}")
  println("loss_match=${boolStr(got2 == "${want}:${payloadBytes}")}")
  println("loss_dropped_some=${boolStr(ctr.n > 0)}")

  // --- listener: one connection's close must not kill its siblings (#1473) ---
  listenerScenario(chainPem(), keyPem())?

  // --- idle: a vanished peer unparks `finish` in bounded time (#1449/#1474) ---
  idleScenario(chainPem(), keyPem())?

  // --- reset: RESET_STREAM wakes a blocked `read` instead of hanging (#3229) ---
  resetScenario(chainPem(), keyPem())?

  // --- streamlimit: MAX_STREAMS is enforced, not silently ignored (#3229) ---
  streamLimitScenario(chainPem(), keyPem())?
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
