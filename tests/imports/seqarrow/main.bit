// #2040: `std/seq`'s transformers called with the BARE-parameter arrow their own
// signatures invite. `mapped<T, U>` and `forEach<T>` used to typecheck and then
// refuse to lower — `U` was bound by nothing and defaulted to `()`, so the
// instantiation minted was `mapped<i64, ()>`.
//
// The sibling `seqtransform` covers the fully explicit spellings (turbofish plus
// an annotated arrow parameter), which always worked. This one covers only the
// inferred spelling, so a regression that reinstates the old skip fails HERE and
// leaves that one green.
import { mapped, filter, reduce, forEach, find, any, all } from "std/seq"

function main() {
  let xs = [1, 2, 3, 4, 5]

  // `(T) => U`, the shape that could not lower: `U` comes from the arrow body.
  let doubled = mapped(xs, x => x * 2)
  println("${doubled[0]} ${doubled[4]}")

  // `U` differing from `T` — inferred across the element type, not from it.
  let flags = mapped(xs, x => x > 3)
  println("${flags[0]} ${flags[4]}")

  // `(T) => ()`, the other shape that could not lower.
  forEach(xs, x => println("e${x}"))

  // `(T) => bool` and the `init`-fixed accumulator both worked before; they must
  // keep working, since a fix that merely moved the failure would break them.
  let evens = filter(xs, x => x % 2 == 0)
  println("${len(evens)} ${evens[0]} ${evens[1]}")
  println("${reduce(xs, 0, (a, x) => a + x)}")

  let found = find(xs, x => x > 3)
  println("${unwrap(found)} ${isNone(find(xs, x => x > 10))}")
  println("${any(xs, x => x == 3)} ${all(xs, x => x > 0)}")

  // A string element type, so nothing above passes by defaulting to i64.
  let ws = ["go", "bit"]
  let lens = mapped(ws, w => len(w))
  println("${lens[0]} ${lens[1]}")
}
