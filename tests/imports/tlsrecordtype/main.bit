// std/tls record content-type ordering regression (#2317): a peer's first
// record byte is its content type, and it must be checked BEFORE the
// declared-length body is read — checking it after (as the handshake-level
// "expected a plaintext handshake record" checks already did) is too late,
// because a hostile peer can declare a length it never intends to fill and
// block the reader forever. A raw TCP peer writes a plain HTTP request line at
// a `std/tls` listener and then holds the socket open without ever sending
// more; `TlsListener.accept()` must still return an error quickly instead of
// waiting on bytes the peer never sends.
import { decodeHex, pemEncode } from "std/crypto"
import { TlsConfig, TlsListener, emptyTrustStore, listen } from "std/tls"
import { dial as rawDial } from "std/net"
import { monotonic, since, millis } from "std/time"

// --- throwaway PKI: localhost leaf under a test root, valid 2026-2036 ---
// (the same PKI used by tests/imports/tlsapi)
const leafHex: string = ""
const keyHex: string = ""

fn hx(s: string): []byte { return decodeHex(s) catch _ { return []byte(0) } }
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

// `listen`'s config never verifies a peer, so `roots` is never consulted —
// but the field is struct-typed and must be given a value.
fn serverConfig(): TlsConfig {
  return TlsConfig{
    roots: emptyTrustStore(),
    certPem: pemOf("CERTIFICATE", leafHex),
    keyPem: pemOf("PRIVATE KEY", keyHex),
  }
}

// Time `l.accept()` on a listener a hostile peer has already sent an
// illegally-typed record to, and report the elapsed milliseconds.
fn acceptTimed(l: TlsListener, out: chan<int>) {
  let start = monotonic()
  let conn = l.accept() catch e {
    let ms = millis(since(start))
    eprint("accept rejected in ${ms} ms: ${e.message()}\n")
    out <- ms
    return
  }
  conn.close()
  out <- 0 - 1
}

fn run(): ()! {
  let l = listen("127.0.0.1", 0, serverConfig())?
  let port = l.port()?

  let out = chan<int>(1)
  spawn acceptTimed(l, out)

  // A raw (non-TLS) peer: sends a plain HTTP request line, whose first byte
  // 'G' (0x47) is not a legal TLS record content type, then holds the socket
  // open instead of closing it — nothing here ever completes a TLS record.
  let raw = rawDial("127.0.0.1", port)?
  raw.write("GET / HTTP/1.1\r\nHost: x\r\n\r\n")?

  let ms = <- out
  if (ms < 0) {
    println("accept: unexpectedly succeeded")
  } else {
    // A generous margin over the ordering fix's actual (millisecond) cost,
    // chosen to stay robust on a loaded machine while remaining light years
    // away from "blocks until the peer closes" (seconds, or forever).
    println("accept: rejected fast=${ms < 2000}")
  }
  raw.close()
  l.close()
}

fn main() {
  run() catch e {
    println("error: ${e.message()}")
  }
}
