// std/quic packet protection (#1215): the RFC 9001 Appendix A sample vectors,
// reproduced byte-for-byte. Every value the RFC prints — the Initial secrets, the
// key/iv/hp, the header-protection sample and mask, and the final protected packets
// for the client Initial (A.2), server Initial (A.3), Retry integrity tag (A.4), and
// the ChaCha20 short-header header protection (A.5) — is recomputed here and diffed
// against `expected`, which holds the RFC's own published hex. All of it is
// deterministic, so the golden is stable across architectures.
import {
  clientInitialKeys,
  serverInitialKeys,
  deriveInitialSecret,
  clientInitialSecret,
  serverInitialSecret,
  protectPayload,
  headerSample,
  aesHeaderMask,
  chachaHeaderMask,
  applyHeaderProtection,
  encodeInitialHeader,
  retryIntegrityTag,
  verifyRetry,
  expandLabel,
  Frame,
  encodeFrame,
} from "std/quic"
import { encodeHex, decodeHex } from "std/crypto"

// Concatenate two byte slices into a fresh, mutable buffer.
function cat(a: []byte, b: []byte): []byte {
  let out = []byte(0)
  for x of a {
    out = append(out, x)
  }
  for x of b {
    out = append(out, x)
  }
  return out
}

function run(): ()! {
  let dcid = decodeHex("8394c8f03e515708")?
  let empty = []byte(0)

  // A.1 — Initial keys derived from the client DCID.
  println("initial=${encodeHex(deriveInitialSecret(dcid))}")
  println("csecret=${encodeHex(clientInitialSecret(dcid))}")
  let ck = clientInitialKeys(dcid)
  println("ckey=${encodeHex(ck.key)}")
  println("civ=${encodeHex(ck.iv)}")
  println("chp=${encodeHex(ck.hp)}")
  println("ssecret=${encodeHex(serverInitialSecret(dcid))}")
  let sk = serverInitialKeys(dcid)
  println("skey=${encodeHex(sk.key)}")
  println("siv=${encodeHex(sk.iv)}")
  println("shp=${encodeHex(sk.hp)}")

  // A.2 — client Initial. The CRYPTO frame carries a 241-byte ClientHello; PADDING
  // (zero bytes) pads the payload to 1162 bytes. Building the frame through
  // `encodeFrame` also checks its 060040f1 header against the RFC.
  let cdata = decodeHex("")?
  let cryptoFrame = encodeFrame(Frame.Crypto(0, cdata))
  let plaintext = cat(cryptoFrame, []byte(1162 - len(cryptoFrame)))
  let length2 = u64(4 + len(plaintext) + 16)
  let header2 = encodeInitialHeader(1, dcid, empty, empty, length2, 2, 4)
  let pp2 = protectPayload(ck, 2, header2, plaintext)?
  let sample2 = headerSample(pp2, 4)?
  println("a2sample=${encodeHex(sample2)}")
  let mask2 = aesHeaderMask(ck.hp, sample2)?
  println("a2mask=${encodeHex(mask2)}")
  let packet2 = cat(header2, pp2)
  applyHeaderProtection(packet2, len(header2) - 4, mask2)?
  println("a2header=${encodeHex(packet2[0:len(header2)])}")
  println("a2packet=${encodeHex(packet2)}")

  // A.3 — server Initial. The server payload (ACK + CRYPTO, no PADDING) is given.
  let a3pt = decodeHex("02000000000600405a020000560303eefce7f7b37ba1d1632e96677825ddf73988cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00020304")?
  let scid = decodeHex("f067a5502a4262b5")?
  let length3 = u64(2 + len(a3pt) + 16)
  let header3 = encodeInitialHeader(1, empty, scid, empty, length3, 1, 2)
  let pp3 = protectPayload(sk, 1, header3, a3pt)?
  let sample3 = headerSample(pp3, 2)?
  println("a3sample=${encodeHex(sample3)}")
  let mask3 = aesHeaderMask(sk.hp, sample3)?
  println("a3mask=${encodeHex(mask3)}")
  let packet3 = cat(header3, pp3)
  applyHeaderProtection(packet3, len(header3) - 2, mask3)?
  println("a3packet=${encodeHex(packet3)}")

  // A.4 — Retry integrity tag over the pseudo-packet built from the original DCID.
  let retry = decodeHex("ff000000010008f067a5502a4262b5746f6b656e04a265ba2eff4d829058fb3f0f2496ba")?
  let retryBody = retry[0:len(retry) - 16]
  let tag = retryIntegrityTag(dcid, retryBody)?
  println("a4tag=${encodeHex(tag)}")
  let ok = verifyRetry(dcid, retry)?
  if (ok) {
    println("a4verify=ok")
  } else {
    println("a4verify=bad")
  }

  // A.5 — ChaCha20 header protection over a short-header 1-RTT packet.
  let secret = decodeHex("9ac312a7f877468ebe69422748ad00a15443f18203a07d6060f688f30f21632b")?
  let a5key = expandLabel(secret, "quic key", 32)
  let a5iv = expandLabel(secret, "quic iv", 12)
  let a5hp = expandLabel(secret, "quic hp", 32)
  println("a5key=${encodeHex(a5key)}")
  println("a5iv=${encodeHex(a5iv)}")
  println("a5hp=${encodeHex(a5hp)}")
  let ct5 = decodeHex("655e5cd55c41f69080575d7999c25a5bfb")?
  let hdr5 = decodeHex("4200bff4")?
  let sample5 = headerSample(ct5, 3)?
  let mask5 = chachaHeaderMask(a5hp, sample5)?
  println("a5mask=${encodeHex(mask5)}")
  let packet5 = cat(hdr5, ct5)
  applyHeaderProtection(packet5, 1, mask5)?
  println("a5packet=${encodeHex(packet5)}")
}

function main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
