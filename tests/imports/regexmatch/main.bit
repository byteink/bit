// std/regex `Regex.matches` — the Pike VM backend (#2027). `compile`/parse
// already has its own coverage (#2026, tests/imports/regexsyntax); this test
// is the matcher: literals, `.` vs `\n`, alternation, nesting, the three
// quantifier shapes both greedy and lazy, character classes, anchors
// (`^ $ \b \B`), UTF-8 input, the empty pattern, and an empty input. Every
// expectation below (and the "expected" golden it produces) was checked
// against Go's `regexp.MatchString`, the epic's designated oracle — see the
// ticket for the full list of labels cross-checked.
//
// Two blocks are not part of the flat `check(...)` list: `pathological`
// proves the whole point of building a Pike VM instead of a backtracker —
// `a?` repeated 25 times followed by 25 literal `a`s, matched against 25
// `a`s, is the textbook exponential-blowup pattern for a backtracking
// engine and must complete immediately here — and `concurrency` spawns 8
// green threads sharing one compiled `Regex`, proving the "safe to share
// across any number of green threads" promise `regex.bit` makes.
import { mustCompile, Regex } from "std/regex"
import { repeat } from "std/strings"
import { monotonic, since, toMillis } from "std/time"

// Prints `<label>: <result>` — one flat golden line per case, the same
// shape `tests/imports/regexsyntax` uses for `compile`'s own coverage.
fn check(label: string, pattern: string, s: string) {
  let re = mustCompile(pattern)
  println("${label}: ${re.matches(s)}")
}

fn checkAll() {
  check("literal exact", "abc", "abc")
  check("literal miss", "abc", "abd")
  check("literal substring", "abc", "xxabcxx")
  check("dot ordinary", "a.b", "axb")
  check("dot not newline", "a.b", "a\nb")
  check("alt first", "cat|dog", "cat")
  check("alt second", "cat|dog", "dog")
  check("alt none", "cat|dog", "bird")
  check("alt three way b", "a|b|c", "b")
  check("nested group", "(a(b(c)))", "abc")
  check("nested group miss", "(a(b(c)))", "abx")
  check("star zero", "ab*c", "ac")
  check("star many", "ab*c", "abbbbc")
  check("plus zero fails", "ab+c", "ac")
  check("plus one", "ab+c", "abc")
  check("quest zero", "ab?c", "ac")
  check("quest one", "ab?c", "abc")
  check("quest anchored fails two", "^ab?c$", "abbc")
  check("lazy star", "a*?", "aaa")
  check("lazy plus", "a+?", "")
  check("lazy quest", "a??b", "b")
  check("class basic", "[abc]", "b")
  check("class negated", "[^abc]", "d")
  check("class negated fails", "[^abc]", "a")
  check("class range", "[a-z]+", "hello")
  check("digit shorthand", "\\d+", "12345")
  check("digit shorthand fails", "^\\d+$", "12a45")
  check("word shorthand", "\\w+", "hello_1")
  check("space shorthand", "\\s", " ")
  check("anchors full", "^hello$", "hello")
  check("anchors full fails", "^hello$", "hello world")
  check("anchor begin", "^abc", "abcdef")
  check("anchor end", "def$", "abcdef")
  check("anchor begin fails", "^abc", "xabc")
  check("word boundary start", "\\bcat", "cat sat")
  check("word boundary end", "cat\\b", "the cat")
  check("word boundary interior fails", "\\bcat\\b", "concatenate")
  check("non word boundary", "\\Bcat", "concatenate")
  check("utf8 dot", "^.$", "€")
  check("utf8 dot two runes fails", "^.$", "€€")
  check("utf8 literal", "café", "café")
  check("empty pattern empty input", "", "")
  check("empty pattern nonempty input", "", "anything")
  check("empty input pattern fails", "abc", "")
  check("never matches", "xyz123", "hello world")
  check("non capturing group", "(?:abc)+", "abcabc")
  check("named group", "(?P<word>\\w+)", "hello")
  // An empty-bodied star: `Repeat`'s body compiles to zero instructions, so
  // the loop-back `Jump` targets the very `Split` that started it — an
  // epsilon cycle the sparse-set dedupe (pike.bit) must break, or this hangs
  // instead of reaching the literal `abc` that follows.
  check("empty group star terminates", "(?:)*abc", "abc")
}

// The classic backtracker-killer: `a?` repeated `n` times followed by `n`
// literal `a`s, matched against `n` `a`s. A backtracking engine explores
// 2^n ways to (mis)assign each optional `a?`; a Pike VM explores at most
// `len(program)` threads per input character, so this must stay fast as `n`
// grows. `n = 25` alone would already hang a backtracker; this prints the
// elapsed milliseconds as a sanity signal, not a pass/fail threshold — the
// `expected` golden pins only the boolean result and the "fast" label, never
// a timing number, since wall clock is not reproducible across machines.
fn pathological() {
  let n = 30
  let pattern = repeat("a?", n) + repeat("a", n)
  let input = repeat("a", n)
  let re = mustCompile(pattern)
  let start = monotonic()
  let matched = re.matches(input)
  let elapsedMs = toMillis(since(start))
  let fast = elapsedMs < 1000.0
  println("pathological n=${n}: matched=${matched} fast=${fast}")
}

// 8 green threads calling `matches` on the SAME compiled `Regex` at once —
// the concurrency promise `regex.bit` makes (`Regex` is immutable; every
// call allocates its own VM scratch state, per `pike.bit`). Each reports its
// own agreement with the expected boolean into a shared channel; `main`
// only prints once everything has answered and agreed.
fn matchWorker(re: Regex, s: string, want: bool, results: chan<bool>) {
  let got = re.matches(s)
  results <- (got == want)
}

fn concurrency() {
  let re = mustCompile("[a-z]+@[a-z]+\\.[a-z]+")
  let results = chan<bool>(8)
  let i = 0
  // Bounded: exactly 8 iterations, fixed.
  while (i < 8) {
    spawn matchWorker(re, "user@example.com", true, results)
    i = i + 1
  }
  let allAgree = true
  let j = 0
  // Bounded: exactly 8 receives, matching the 8 sends above.
  while (j < 8) {
    if (!(<- results)) {
      allAgree = false
    }
    j = j + 1
  }
  println("concurrency agreement: ${allAgree}")
}

fn main() {
  checkAll()
  pathological()
  concurrency()
}
