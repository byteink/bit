// Response framing (#2292): the client used to hand back whatever bytes
// arrived on the socket as `Response.body`, with no regard for
// `Transfer-Encoding` or `Content-Length` — a chunked response came back with
// its "1a\r\n...\r\n0\r\n\r\n" chunk markers inline, a Content-Length shorter
// than what was actually sent was ignored (trailing bytes included in the
// body), and a connection that closed mid-body read as a clean 200 with a
// short body. `readResponse` now frames the body exactly as `readMessage`
// frames a request (http.bit): chunked is decoded, Content-Length is enforced
// exactly (extra bytes discarded, a short read before it arrives is a hard
// error), and neither header present means the body runs to the peer's
// close.
//
// The shapes of the three wire responses from the ticket: a real
// chunked-by-default proxy (nginx, Go's net/http), a Content-Length shorter
// than the bytes actually sent, and a truncated upstream. `chunked`'s chunk
// sizes are corrected to match its data exactly (23 = 0x17 bytes, then 20 =
// 0x14) — the ticket's illustrative "1a"/"11" did not match its own payload
// length, which is itself a malformed-chunk-stream case, not this one.
import { listen, Listener, Conn } from "std/net"
import { get } from "std/http"
import { indexOf } from "std/strings"

const chunked: string = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n17\r\n{\"id\":7,\"name\":\"Chunked\r\n14\r\n Ada\",\"active\":true}\r\n0\r\n\r\n"
const shortCl: string = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n{\"a\":1}AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
const cut: string = "HTTP/1.1 200 OK\r\nContent-Length: 120\r\n\r\n{\"id\":9,\"name\":\"trunca"

fn tryWrite(c: Conn, s: string) {
  c.write(s) catch e {
    return
  }
}

fn serveOne(c: Conn, reply: string) {
  let req = c.read(4096)
  tryWrite(c, reply)
  c.close()
}

fn loop(l: Listener, reply: string) {
  let c = l.accept() catch e {
    return
  }
  serveOne(c, reply)
}

fn probeOk(label: string, reply: string) {
  let l = listen("127.0.0.1", 0) catch e {
    println("${label}: listen failed")
    return
  }
  let port = l.port() catch e {
    0
  }
  spawn loop(l, reply)
  let r = get("http://127.0.0.1:${port}/x") catch e {
    println("${label}: unexpected client error")
    l.close()
    return
  }
  let chunkMarker = "\r\n0\r\n"
  let hasChunkMarker = indexOf(r.body, chunkMarker) >= 0
  println("${label}: status=${r.status} bodyLen=${len(r.body)} hasChunkMarker=${hasChunkMarker} body=[${r.body}]")
  l.close()
}

// The `cut` case must be an error, not a status — a truncated body must never
// read as a clean response.
fn probeErrors(label: string, reply: string) {
  let l = listen("127.0.0.1", 0) catch e {
    println("${label}: listen failed")
    return
  }
  let port = l.port() catch e {
    0
  }
  spawn loop(l, reply)
  let r = get("http://127.0.0.1:${port}/x") catch e {
    println("${label}: errored (correct)")
    l.close()
    return
  }
  println("${label}: NOT AN ERROR status=${r.status} bodyLen=${len(r.body)}")
  l.close()
}

fn main() {
  probeOk("chunked", chunked)
  probeOk("shortcl", shortCl)
  probeErrors("cut", cut)
}
