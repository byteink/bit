// std/crypto ASN.1/DER (#1188): round-trip every universal type, encode the two
// real signature-algorithm OIDs, build and re-parse an ECDSA `SEQUENCE { r, s }`
// byte-identically, and confirm the strict decoder rejects the three classic
// malformations — a non-minimal length, a non-minimal INTEGER, and the
// indefinite-length marker. Each check lives in its own small function (kept
// deliberately low on live locals), so the output is deterministic and stable.
import {
  Element,
  BitString,
  asn1Parse,
  asn1Encode,
  asn1Boolean,
  asn1Integer,
  asn1BigInteger,
  asn1BitString,
  asn1OctetString,
  asn1Null,
  asn1Oid,
  asn1Utf8String,
  asn1Sequence,
  asn1ExplicitTag,
  asn1ReadBoolean,
  asn1ReadInteger,
  asn1ReadBigInteger,
  asn1ReadBitString,
  asn1ReadOctetString,
  asn1ReadNull,
  asn1ReadOid,
  asn1ReadString,
  asn1ReadSequence,
  asn1ReadExplicit,
  asn1OidString,
  classContext,
  tagNull,
  encodeHex,
} from "std/crypto"

// Whether two byte slices are equal.
fn sameBytes(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The hex of a value's DER encoding.
fn hexOf(e: Element): string { return encodeHex(asn1Encode(e)) }

// Whether `der` parses as valid DER — the catch diverts a rejection to false so
// the strict-rejection cases are observable without inspecting the error.
fn parses(der: []byte): bool {
  asn1Parse(der) catch e {
    return false
  }
  return true
}

// BOOLEAN: true is 0xFF, and it round-trips to true.
fn boolCheck(): bool {
  let back = asn1Parse(asn1Encode(asn1Boolean(true))) catch e {
    return false
  }
  let v = asn1ReadBoolean(back) catch e {
    return false
  }
  return v && hexOf(asn1Boolean(true)) == "0101ff"
}

// INTEGER: minimal encoding across zero, a sign-byte boundary, a negative, and a
// signed read-back.
fn intCheck(): bool {
  if (hexOf(asn1Integer(0)) != "020100") {
    return false
  }
  if (hexOf(asn1Integer(128)) != "02020080") {
    return false
  }
  if (hexOf(asn1Integer(-1)) != "0201ff") {
    return false
  }
  let back = asn1Parse(asn1Encode(asn1Integer(-12345))) catch e {
    return false
  }
  let v = asn1ReadInteger(back) catch e {
    return false
  }
  return v == -12345
}

// The DER hex of an OID from its arcs.
fn oidHex(arcs: []int): string {
  let e = asn1Oid(arcs) catch x {
    return "err"
  }
  return encodeHex(asn1Encode(e))
}

// OBJECT IDENTIFIER: the two real signature-algorithm OIDs, and a dotted-string
// read-back of the first.
fn oidCheck(): bool {
  if (oidHex([]int{ 1, 2, 840, 113549, 1, 1, 11 }) != "06092a864886f70d01010b") {
    return false
  }
  if (oidHex([]int{ 1, 2, 840, 10045, 4, 3, 2 }) != "06082a8648ce3d040302") {
    return false
  }
  let e = asn1Oid([]int{ 1, 2, 840, 113549, 1, 1, 11 }) catch x {
    return false
  }
  let back = asn1Parse(asn1Encode(e)) catch x {
    return false
  }
  let arcs = asn1ReadOid(back) catch x {
    return false
  }
  return asn1OidString(arcs) == "1.2.840.113549.1.1.11"
}

// OCTET STRING with a long-form (multi-byte) length: 200 octets need the
// 0x81 0xC8 length prefix, and the content round-trips.
fn octetCheck(): bool {
  let big = []byte(200)
  let i = 0
  while (i < 200) {
    big[i] = byte(i)
    i = i + 1
  }
  let der = asn1Encode(asn1OctetString(big))
  if (encodeHex(der[0:3]) != "0481c8") {
    return false
  }
  let back = asn1Parse(der) catch e {
    return false
  }
  let data = asn1ReadOctetString(back) catch e {
    return false
  }
  return sameBytes(data, big)
}

// The DER hex of an ECDSA SEQUENCE { INTEGER r, INTEGER s }. r's top bit is set
// (a 0x00 sign octet is prepended); s's is clear (none is).
fn sigHex(): string {
  let r = []byte{ 0x8f, 0x2a, 0x00, 0x01 }
  let s = []byte{ 0x03, 0xff, 0x00, 0x2b }
  return encodeHex(asn1Encode(asn1Sequence([]Element{ asn1BigInteger(r), asn1BigInteger(s) })))
}

// ECDSA signature: build, encode, re-parse, read r and s back, and confirm the
// re-encode is byte-identical.
fn sigCheck(): bool {
  let r = []byte{ 0x8f, 0x2a, 0x00, 0x01 }
  let s = []byte{ 0x03, 0xff, 0x00, 0x2b }
  let der = asn1Encode(asn1Sequence([]Element{ asn1BigInteger(r), asn1BigInteger(s) }))
  let back = asn1Parse(der) catch e {
    return false
  }
  let parts = asn1ReadSequence(back) catch e {
    return false
  }
  if (len(parts) != 2) {
    return false
  }
  let rBack = asn1ReadBigInteger(parts[0]) catch e {
    return false
  }
  let sBack = asn1ReadBigInteger(parts[1]) catch e {
    return false
  }
  return sameBytes(rBack, r) && sameBytes(sBack, s) && sameBytes(der, asn1Encode(back))
}

// The DER hex of an explicit context tag [40] (a high-tag-number identifier,
// 0xFF 0x28) wrapping a NULL.
fn explicitHex(): string { return encodeHex(asn1Encode(asn1ExplicitTag(40, asn1Null()))) }

// Explicit context tag [40]: parse it back, unwrap the inner NULL, and confirm
// the class and inner tag.
fn explicitCheck(): bool {
  let back = asn1Parse(asn1Encode(asn1ExplicitTag(40, asn1Null()))) catch e {
    return false
  }
  let inner = asn1ReadExplicit(back, 40) catch e {
    return false
  }
  asn1ReadNull(inner) catch e {
    return false
  }
  return back.cls == classContext && inner.tag == tagNull
}

// BIT STRING round-trip: 0 unused bits, four value octets.
fn bitStrCheck(): bool {
  let back = asn1Parse(asn1Encode(asn1BitString(0, []byte{ 0xde, 0xad, 0xbe, 0xef }))) catch e {
    return false
  }
  let bs = asn1ReadBitString(back) catch e {
    return false
  }
  return bs.unusedBits == 0 && encodeHex(bs.bytes) == "deadbeef"
}

// UTF8String round-trip through a multi-byte character.
fn utf8Check(): bool {
  let back = asn1Parse(asn1Encode(asn1Utf8String("héllo"))) catch e {
    return false
  }
  let text = asn1ReadString(back) catch e {
    return false
  }
  return text == "héllo"
}

fn main() {
  // Encoded forms (hex-compared against the known-answer DER).
  println("boolTrue=${hexOf(asn1Boolean(true))}")
  println("int0=${hexOf(asn1Integer(0))}")
  println("int128=${hexOf(asn1Integer(128))}")
  println("intNeg1=${hexOf(asn1Integer(-1))}")
  println("oidRsa=${oidHex([]int{ 1, 2, 840, 113549, 1, 1, 11 })}")
  println("oidEcdsa=${oidHex([]int{ 1, 2, 840, 10045, 4, 3, 2 })}")
  println("sig=${sigHex()}")
  println("explicit=${explicitHex()}")

  // Round-trip and read-back checks.
  println("boolOk=${boolCheck()}")
  println("intOk=${intCheck()}")
  println("oidOk=${oidCheck()}")
  println("octetOk=${octetCheck()}")
  println("sigOk=${sigCheck()}")
  println("explicitOk=${explicitCheck()}")
  println("bitStrOk=${bitStrCheck()}")
  println("utf8Ok=${utf8Check()}")

  // Strict rejections. Each of these must FAIL to parse.
  //  - non-minimal length: INTEGER with 0x81 0x01 (long form for length 1).
  println("badLen=${!parses([]byte{ 0x02, 0x81, 0x01, 0x05 })}")
  //  - non-minimal INTEGER: content 0x00 0x05 (redundant leading 0x00).
  println("badInt=${!parses([]byte{ 0x02, 0x02, 0x00, 0x05 })}")
  //  - indefinite length: the 0x80 length marker.
  println("indefinite=${!parses([]byte{ 0x30, 0x80, 0x00, 0x00 })}")
}
