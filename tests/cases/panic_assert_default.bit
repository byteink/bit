// panic
//
// `bit_rt_assert` has one frozen 2-arg signature (ABI.md §12), so the 1-arg
// source form still has to hand the runtime a message. Lowering supplies the
// default; before it did, the failing path read an undefined register as a
// string pointer, and only a *firing* assert ever looked at it.
function main() {
  let n = len("bit")
  assert(n == 3)  // holds, so the message is never read
  assert(n == 99) // fires, and must print the default message
}
