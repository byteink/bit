// error
// #2242: E0041 must say WHY a candidate fails to satisfy an interface, not
// just name the two types. Two shapes in one file specifically so the two
// `.expected` messages are checked to DIFFER — before the fix both rendered
// the identical bare "expected 'PaymentMethod', found '<Type>'".
interface PaymentMethod {
  label(): string
  charge(amount: i64): i64
}

// Mismatch: `charge` exists on Card, but takes a `string`, not an `i64`.
class Card {
  limit: i64,
}

fn (c: Card) label(): string { return "card" }
fn (c: Card) charge(amount: string): i64 { return 1 }

// Missing: Cash has no `charge` method at all.
class Cash {
  amount: i64,
}

fn (c: Cash) label(): string { return "cash" }

fn main() {
  let byCard: PaymentMethod = Card{ limit: 1 }
  let byCash: PaymentMethod = Cash{ amount: 5 }
  print("${byCard.label()} ${byCash.label()}")
}
