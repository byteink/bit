// run
// #1563: a generic function reading a NESTED generic field (`h.inner.v`, where
// `inner: Box<T>`) used to lower the intermediate `h.inner` as the bare template
// `Box`, so the following `.v` had no concrete field type and yielded void.
// `bit check` agreed with the seed and `bit build` then REFUSED to emit — the
// false-positive direction, and one only a real build could see.
//
// Closed by #1560's nominal arm in `bindTypeParamFromNode`: `idH(h)` binds T from
// the ARGUMENT's instantiation (`Holder<string>`) rather than from its syntax, so
// `peek` is instantiated at the right argument and the intermediate field read
// resolves. Guarded here because no other corpus file reads a nested generic
// field from inside a generic body.

struct Box<T> { v: T }
struct Holder<T> { inner: Box<T>, tag: T }

function idH<T>(h: Holder<T>): Holder<T> { return h }
function peek<T>(h: Holder<T>): T { return h.inner.v }

function main() {
  let h = Holder<string>{ inner: Box<string>{ v: "hi" }, tag: "t" }
  print("${peek(idH(h))}\n")
  let n = Holder<i64>{ inner: Box<i64>{ v: 7 }, tag: 1 }
  print("${peek(n)}\n")
}
