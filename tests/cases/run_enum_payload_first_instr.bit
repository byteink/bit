// run
// Regression (#1493): a payload-carrying variant constructed as the FIRST
// instruction of a function. The payload box is then SSA value id 0, which the
// self-hosted lowering used as its "no payload" sentinel — so the box was built,
// discarded, and the enum's payload word stored as nil. Reading the payload back
// segfaulted. Anything emitted before the construction hid the bug, so the
// construction must stay the first statement in `main`.
enum Opt<T> {
  Some(T)
  None
}

function get<T>(o: Opt<T>): T {
  match (o) {
    Some(v) => return v
    None => panic("none")
  }
}

function main() {
  let a: Opt<i64> = Opt.Some(7)
  print("${get(a)}\n")
}
