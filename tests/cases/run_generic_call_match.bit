// run
// #1558: a match on the RESULT of a generic call binds its payload at the
// call's inferred type argument, not at the callee's bare type parameter.
// The un-annotated binding is the shape that was refused: it writes no type
// down anywhere, so the scrutinee's type args come from the initializing call.
// The annotated one was refused too — the annotation was recorded only by the
// main sweep, and match binders are typed a pass earlier.
enum Opt<T> { Some(T), None }

function idOpt<T>(o: Opt<T>): Opt<T> {
  return o
}

function fromCall(o: Opt<int>): int {
  let r = idOpt(o)
  match (r) {
    Some(v) => { return v + 1 }
    None => { return 0 }
  }
}

function fromAnnotatedCall(o: Opt<int>): int {
  let a: Opt<int> = idOpt(o)
  match (a) {
    Some(v) => { return v + 2 }
    None => { return 0 }
  }
}

function fromStringPayload(so: Opt<string>): string {
  let s = idOpt(so)
  match (s) {
    Some(v) => { return v }
    None => { return "" }
  }
}

function main() {
  print("${fromCall(Opt<int>.Some(41))}\n")
  print("${fromAnnotatedCall(Opt<int>.Some(40))}\n")
  print("${fromStringPayload(Opt<string>.Some("s"))}\n")
}
