// panic
// `m[k]` on a missing key must PANIC when the value type has no zero value
// (#1926), not hand back a null.
//
// SPEC §12.6 says a missing key yields the value type's zero value, and #1914
// established that a struct with a struct-typed field HAS no zero value. The
// two could not both hold: the miss edge used to materialize a bare allocation
// whose `b` was null, so `v.a` read 0 and `v.b` faulted — a crash at the first
// field read, arbitrarily far from the map.
//
// Panicking is the same answer this compiler already gives for `[]T(n)` with
// such an element type, and it matches Bit's existing idiom: indexing a slice
// out of range, writing a nil map and calling a nil function all panic (§18.4).
//
// THE COMMA-OK FORM IS DELIBERATELY EXEMPT and is covered by
// run_map_no_zero_value_ok.bit — `let (v, ok) = m[k]` exists to ask whether the
// key is present, so making it panic would leave such a map unreadable by any
// means. There the miss yields a null `v` with `ok` false, which is the contract
// that form already carries.
struct Inner { xs: []u32 }
struct Outer { a: int, b: Inner }

function main() {
  let m = map<int, Outer>{}
  m[1] = Outer{ a: 5, b: Inner{} }

  // A present key is unaffected: no panic, no allocation on the miss edge.
  print("hit=")
  print(itoa(m[1].a))
  print("\n")

  // A missing one has no value to give back.
  let v = m[7]
  print("unreachable\n")
}

function itoa(n: int): string {
  if (n == 0) { return "0" }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) { s = d[v % 10 : v % 10 + 1] + s; v = v / 10 }
  return s
}
