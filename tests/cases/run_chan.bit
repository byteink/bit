// run
fn main() {
  let nums = chan<i64>(3)
  nums <- 5
  nums <- 7
  nums <- 9
  let a = <- nums
  let b = <- nums
  let c = <- nums
  print("nums ${a} ${b} ${c} sum=${a + b + c}\n")

  let words = chan<string>(2)
  words <- "hi"
  words <- "there"
  print(<- words)
  print(" ")
  print(<- words)
  print("\n")
}
