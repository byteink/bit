// error
// Only `show(): string` gives a type a string conversion (§5.7). A method that
// merely shares the name is not one: taking it would have called it with the
// wrong arity and result type, which crashed the compiler in the inliner.
class Point { x: i64 }
fn (p: Point) show(width: i64): i64 { return p.x * width }
fn main() {
  let p = Point{x: 1}
  print("${p}\n")
}
