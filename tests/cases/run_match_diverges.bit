// run
// An exhaustive `match` whose every arm diverges (return or panic) satisfies
// return-path analysis (§13.8): the function needs no trailing return. The
// panic arm is never taken here, so the program runs and exits 0.
enum Color { Red, Green, Blue }

fn code(c: Color): i64 {
  match (c) {
    Red   => return 1
    Green => return 2
    Blue  => panic("no blue")
  }
}

fn main() {
  print("${code(Color.Red)}${code(Color.Green)}\n")
}
