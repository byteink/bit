// run
// #2114: `fs.exists` must answer "does this path name anything at all", not
// "can I open it read-only". A mode-000 file plainly exists — `exists` must
// say so, distinct from "does not exist", so a caller can tell "no such
// file" from "permission denied".
import { envOr } from "std/os"
import { exists, isDir, mkdir, writeFile, remove } from "std/fs"

function main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_exists_unreadable_${timeUnixNs()}"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }
  let p = "${dir}/noperm.txt"
  writeFile(p, "secret") catch _ {
    println("setup failed: cannot write ${p}")
    return
  }
  fsChmod(p, 0)

  println("exists=${exists(p)} isDir=${isDir(p)}")
  println("missing exists=${exists("${dir}/does-not-exist")}")

  fsChmod(p, 420)
  remove(p) catch _ { return }
  remove(dir) catch _ { return }
}
