// error
// A generic callee's argument COUNT is checked exactly like a concrete one's
// (#2360). Before this, `vCall` returned as soon as it saw a generic decl, ahead
// of the count rule, so `second(7)` compiled AND ran rc=0 while `return b` read
// an uninitialized register.
function second<T>(a: T, b: T): T { return b }

function main() {
  let tooFew = second(7)
  let tooMany = second(1, 2, 3)
  print("${tooFew} ${tooMany}\n")
}
