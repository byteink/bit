// error
// E0052 is judged per monomorphization (#2148). `map<T, bool>` is the natural
// spelling of a generic set; instantiated at `[]int` it is the key
// check_map_key_not_comparable.bit rejects when spelled directly, and before
// this the map silently degraded to keying on slice handles (two equal `[1]`
// slices landed in separate buckets).
function dedupe<T>(xs: []T): int {
  let seen = map<T, bool>()
  for x of xs {
    seen[x] = true
  }
  return len(seen)
}

function main() {
  print("int=${dedupe([1, 1, 2])}\n")
  let a: [][]int = [[1], [1], [2]]
  print("slicekey=${dedupe(a)}\n")
}
