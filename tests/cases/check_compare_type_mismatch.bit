// error
// #2232: a comparison between operands of DIFFERENT types was accepted by
// `bit check` with exit 0, and lowering then merged the two into the left
// operand's type — so `string < bool` handed `string_cmp` a bool to dereference
// and the four-line program died with SIGSEGV, while `int < string` quietly
// answered `true`. §14.6 defines every comparison between operands of the SAME
// type; agreement is checked before comparability, because the crash is in the
// disagreement. Single-file golden: no prelude.
function main() {
  let i = 3
  let s = "3"
  let b = true
  let f = 1.5
  print("${i == s}\n")
  print("${i < s}\n")
  print("${i == b}\n")
  print("${f == s}\n")
  print("${s < b}\n")
}
