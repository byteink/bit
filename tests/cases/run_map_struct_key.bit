// run
// #2111: a `map<K,V>` with a composite key hashed and matched the key's HANDLE,
// so a value-equal key MISSED (reading V's zero value, indistinguishable from a
// stored zero) and re-inserting it GREW the map instead of overwriting. §11.2
// admits a struct key because §14.6 makes a struct comparable, so all of this
// typechecked and answered plausibly.
//
// `len` is the assertion that matters. The read missing is bad; the write
// duplicating is worse, because an insert-or-update loop then grows without
// bound and iteration yields the same logical key twice. Line B is that case.
//
// The `S` block reaches through a REFERENCE field to its bytes: `"a" + "cme"` is
// a different allocation from the literal `"acme"`, so a hash over the handle
// puts them in different buckets while `==` says they are equal — the exact
// disagreement between hashing and equality that loses entries.
//
// Line J is the bulk case: 200 keys inserted, then all 200 re-inserted. A hash
// that disagrees with equality shows up as 400.
//
// Single-file golden: no prelude.
struct P { x: int }

struct S { id: int, name: string }

struct Pt { x: int, y: int }

function key(a: int, b: string): (int, string) { return a, b }

function main() {
  let m = map<P, int>()
  m[P{ x: 1 }] = 7
  print("A len=${len(m)} get=${m[P{ x: 1 }]}\n")
  m[P{ x: 1 }] = 9
  print("B len=${len(m)} get=${m[P{ x: 1 }]}\n")
  let (v, ok) = m[P{ x: 1 }]
  print("C v=${v} ok=${ok}\n")
  let (v2, ok2) = m[P{ x: 2 }]
  print("D v=${v2} ok=${ok2}\n")
  delete(m, P{ x: 1 })
  print("E len=${len(m)} get=${m[P{ x: 1 }]}\n")

  let sm = map<S, int>()
  sm[S{ id: 1, name: "acme" }] = 10
  sm[S{ id: 1, name: "a" + "cme" }] = 11
  print("F len=${len(sm)} get=${sm[S{ id: 1, name: "acme" }]}\n")
  sm[S{ id: 2, name: "acme" }] = 12
  print("G len=${len(sm)}\n")

  let tm = map<(int, string), int>()
  tm[key(1, "a")] = 100
  tm[key(1, "a")] = 101
  print("H len=${len(tm)} get=${tm[key(1, "a")]}\n")
  tm[key(2, "a")] = 102
  print("I len=${len(tm)}\n")

  let g = map<Pt, int>()
  let i = 0
  while (i < 200) {
    g[Pt{ x: i, y: i * 2 }] = i
    i = i + 1
  }
  let first = len(g)
  i = 0
  while (i < 200) {
    g[Pt{ x: i, y: i * 2 }] = i + 1000
    i = i + 1
  }
  let sum = 0
  i = 0
  while (i < 200) {
    sum = sum + g[Pt{ x: i, y: i * 2 }]
    i = i + 1
  }
  let seen = 0
  for (k, val) of g {
    seen = seen + 1
  }
  print("J first=${first} second=${len(g)} sum=${sum} iter=${seen}\n")
}
