// error
// A generic body is checked once, against its own rigid `T`, so `${x}` can only
// be judged per monomorphization: `p(1)` is fine, `p(Point{...})` is not. The
// checker re-judges the operand at every instantiation — lowering, which
// monomorphizes the same bodies, must never be the first to notice.
struct Point { x: i64 }
function p<T>(x: T) {
  print("${x}\n")
}
function main() {
  p(1)
  p(Point{x: 2})
}
