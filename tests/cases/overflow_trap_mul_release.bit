// run
// #3087 (epic #3076): a release build never inserts the overflow check
// #3084/#3085 add under `--debug`, so a runtime i64 MAX * 2 must silently
// wrap to the documented two's-complement value (SPEC §13.5) and exit 0.
// Sibling of overflow_trap_mul_debug.bit: the identical expression, built
// WITH `--debug`, where the same overflow must trap instead. `two()` is
// routed through `len(args())` so `compiler/optfold.bit`'s `foldAddSubMul`
// cannot resolve this multiply as a compile-time constant.
import { args } from "std/os"

fn two(): int { return len(args()) + 1 }

fn main() {
  let x: i64 = 9223372036854775807
  print("prod=${x * two()}\n")
}
