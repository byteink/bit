// run
// #2163: `hmac` takes a hash constructor `() => Hash`, and every SHA-2 family
// constructor should be directly usable there with no wrapper. Before this fix,
// `newSha256`/`newSha224` declared their concrete `Sha256` as the return type,
// so `hmac(newSha256, ...)` failed with E0041 ("expected '() => Hash', found
// '() => Sha256'") while `hmac(newSha512, ...)` — whose constructor already
// declared `Hash` — compiled fine. This case passes ALL THREE constructors to
// `hmac` directly, with no `fn wrapper(): Hash { return newSha256() }` shim, so
// a regression to the old asymmetry fails to compile rather than fails a value
// check.
//
// The tag values are RFC 4231 Test Case 1 (key = twenty 0x0b bytes, data =
// "Hi There"), which defines HMAC-SHA-224, HMAC-SHA-256 and HMAC-SHA-512 over
// the identical key/message pair — cross-checked independently against
// Python's `hmac`/`hashlib` stdlib, not derived from this compiler's own
// output.
import { hmac, newSha224, newSha256, newSha512, encodeHex } from "std/crypto"

fn repeatByte(n: int, v: byte): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = v
    i = i + 1
  }
  return out
}

fn main() {
  let key = repeatByte(20, 0x0b)
  let msg = []byte("Hi There")
  println("sha224=${encodeHex(hmac(newSha224, key, msg))}")
  println("sha256=${encodeHex(hmac(newSha256, key, msg))}")
  println("sha512=${encodeHex(hmac(newSha512, key, msg))}")
}
