// error
// SPEC 10.3.1 (#1640): admitting the extern CALL does not admit its ARGUMENTS.
// The assertion covers only the callee's opaque body; an allocating argument is
// ordinary Bit code the compiler can inspect, so it stays E0075 — the same
// operand discipline the `asm` and `ptrOf` carve-outs keep.
extern fn sink(p: i64): i64

fn alloc(): i64 { return 1 }

@nosplit fn f(): i64 {
  return sink(alloc())
}
