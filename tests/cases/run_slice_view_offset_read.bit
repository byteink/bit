// run
// #3107: a sliced view carries a NON-ZERO `slcOff` (ABI.md §2), and an element
// read must load `buf[off + index]`, not `buf[index]`.
//
// This is the case the inline lowering can get wrong in a way nothing else in
// the corpus would catch. `bit_rt_slice_get` loaded `off` from the header and
// added it; #3107 reproduces that at the call site, and dropping the `off`
// term — or loading it from the wrong word — leaves every read of a WHOLE
// slice correct (its `off` is 0) while every read through a view silently
// returns the parent's element from the wrong position. Both compile, both
// exit 0, and only a view disagrees.
//
// So each read is checked against the parent element it must equal, and the
// equality is printed rather than the value: a shifted view would still print
// plausible numbers.
//
// `run_reslice.bit` exercises views but reads them without an independent
// oracle for what the element should be.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  let xs = [10, 20, 30, 40, 50, 60]

  // off = 2, len = 3.
  let mid = xs[2:5]
  print("mid0=${mid[zero()]} same=${mid[zero()] == xs[2]}\n")
  print("mid1=${mid[zero() + 1]} same=${mid[zero() + 1] == xs[3]}\n")
  print("mid2=${mid[len(mid) - 1]} same=${mid[len(mid) - 1] == xs[4]}\n")

  // A view OF a view: `off` accumulates, so this one is 2 + 1 = 3.
  let inner = mid[1:3]
  print("inner0=${inner[zero()]} same=${inner[zero()] == xs[3]}\n")
  print("innerlen=${len(inner)}\n")

  // The last element of the last legal view: `off` at its maximum.
  let tail = xs[len(xs) - 1:len(xs)]
  print("tail0=${tail[zero()]} same=${tail[zero()] == xs[len(xs) - 1]}\n")

  // A write through the view must land where the read finds it. This pinned the
  // two halves against each other while they were lowered differently; since
  // #3108 inlined the store as well, both now share `emitInlineSliceElem`, so
  // the independent check on the write side moved to
  // `run_slice_view_offset_write.bit` — where the parent, not the view, is the
  // oracle. A shared offset computation is wrong in both directions at once, and
  // a check written in terms of the view could no longer see that.
  mid[zero()] = 99
  print("wrote=${mid[zero()]} parent=${xs[2]} same=${mid[zero()] == xs[2]}\n")
}
