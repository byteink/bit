// panic
// #3108: a NEGATIVE index on the WRITE path still panics. The mirror of
// `run_slice_index_neg_panic.bit`, which pins the same index on the read.
//
// Both halves are now one unsigned compare — `(u64)index < (u64)len` — so a
// negative index is caught only because it reads as a huge unsigned. That is one
// instruction doing the work of `index < 0 || index >= vlen`, and it is the half
// an `scmp`/`slt` written where `ucmp`/`lo` belongs would silently lose: with a
// signed compare this store lands at `buf - 8`, one word BEFORE the buffer, which
// is inside the object header. It would not fault, it would corrupt a GC object
// and exit 0.
//
// The index comes from `args()` so nothing is decidable at compile time.
import { args } from "std/os"

fn neg(): int { return -1 - (len(args()) - 1) }

fn main() {
  let xs = [1, 2, 3]
  print("start len=${len(xs)}\n")
  xs[neg()] = 99
  print("unreachable\n")
}
