// run
// #2162 (owner decision 2026-08-10): `for x in it` yields TypeScript-style
// semantics — the INDEX of a slice/array, never the element. Contrast with
// `for x of it`, which yields the element.
fn main() {
  let xs = [10, 20, 30]
  for i in xs {
    print("${i}\n")
  }

  let arr = [3]i64{7, 8, 9}
  for i in arr {
    print("arr${i}\n")
  }

  // `xs[i]` recovers the element the index names, proving `i` really is the
  // index rather than a copy of the value.
  let sum = 0
  for i in xs {
    sum = sum + xs[i]
  }
  print("sum=${sum}\n")
}
