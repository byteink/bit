// run
// #1713: `f++`/`f--` on a float materialised the literal `1` with `const_int`
// against the operand's own (float) TypeId instead of `const_float 1.0` —
// clean build, no diagnostic, silently wrong number. Seed printed `0`
// (garbage: the int-add opcode also survived, reading the operand out of the
// wrong register class), self-hosted printed `1.5` (no-op: `1` read as the
// float bit pattern for the subnormal 5e-324, so `1.5 + 5e-324 == 1.5`).
//
// The start value is 1.5, not 1.0, so a bit-pattern mix-up cannot coincide
// with the right answer. Covers both `++` and `--`, `f32` and `f64`, and a
// module-level `let` (a separate lowering path from a local).
let gf: f64 = 1.5

function main() {
  let a: f64 = 1.5
  a++
  print("local_f64_inc=${a}\n")

  let b: f64 = 1.5
  b--
  print("local_f64_dec=${b}\n")

  let c: f32 = 1.5
  c++
  print("local_f32_inc=${c}\n")

  let d: f32 = 1.5
  d--
  print("local_f32_dec=${d}\n")

  gf++
  print("module_f64_inc=${gf}\n")
}
