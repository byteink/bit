// run
// stdlib/json/cst_print.bit's cstPrint (#1726), combined with cstSetString
// (#1725), over the same hand-formatted JSONC fixture as
// json_cst_roundtrip_untouched.bit. A golden case is a single file with no
// prelude and cannot import std/json (see json_cst_parse_trivia.bit), so
// this redeclares the comment-emitting lexer, the #1720 CST types, the
// #1723 CST parser, the #1725 edit function, and the printer under test
// locally.
//
// Sets exactly one key's string value, prints the result, and asserts
// (via a line-by-line diff against the original source) that EXACTLY one
// line changed — every comment, every blank line, and every other value's
// formatting survives the edit untouched.

struct jsonErr { msg: string }
fn (e: jsonErr) message(): string { return e.msg }

enum Opt<T> { Some(T), None }

// --- lexer (stdlib/json/lex.bit + the Comment-emitting mode) ---------------

enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
  Comment,
}

struct Token { kind: TokenKind, start: int, end: int }

const jsonMaxDepth = 64

struct Lexer { src: string, i: int, depth: int }

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

fn emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

fn scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

fn scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

fn scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

fn scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

fn scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

fn scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '/' && lx.i + 1 < len(lx.src) && lx.src[lx.i + 1] == '/') {
      let start = lx.i
      lx.i = lx.i + 2
      while (lx.i < len(lx.src) && lx.src[lx.i] != '\n') {
        lx.i = lx.i + 1
      }
      return Token{ kind: TokenKind.Comment, start: start, end: lx.i }
    } else if (c == '/' && lx.i + 1 < len(lx.src) && lx.src[lx.i + 1] == '*') {
      let start = lx.i
      lx.i = lx.i + 2
      let closed = false
      while (lx.i + 1 < len(lx.src)) {
        if (lx.src[lx.i] == '*' && lx.src[lx.i + 1] == '/') {
          lx.i = lx.i + 2
          closed = true
          break
        }
        lx.i = lx.i + 1
      }
      if (!closed) {
        lx.i = len(lx.src)
        return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
      }
      return Token{ kind: TokenKind.Comment, start: start, end: lx.i }
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

fn lexCst(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

// --- string decoding (stdlib/json/parse.bit, trimmed) -----------------------

fn describeInvalid(src: string, t: Token): string {
  let c = src[t.start]
  if (c == '{' || c == '[') {
    return "json: max nesting depth exceeded"
  }
  if (c == '"') {
    return "json: unterminated string"
  }
  if (c == '/' && t.end - t.start > 1) {
    return "json: unterminated block comment"
  }
  return "json: unexpected character in input"
}

fn isValidJsonNumber(s: string): bool {
  let n = len(s)
  let i = 0
  if (i >= n) {
    return false
  }
  if (s[i] == '-') {
    i = i + 1
  }
  if (i >= n) {
    return false
  }
  if (s[i] == '0') {
    i = i + 1
  } else if (s[i] >= '1' && s[i] <= '9') {
    i = i + 1
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  } else {
    return false
  }
  if (i < n && s[i] == '.') {
    i = i + 1
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  if (i < n && (s[i] == 'e' || s[i] == 'E')) {
    i = i + 1
    if (i < n && (s[i] == '+' || s[i] == '-')) {
      i = i + 1
    }
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  return i == n
}

fn byteToStr(c: u8): string {
  let out = []byte(1)
  out[0] = c
  return string(out)
}

fn writeUtf8(cp: i64): string {
  if (cp < 0x80) {
    return byteToStr(u8(cp))
  }
  if (cp < 0x800) {
    return byteToStr(u8(0xC0 | (cp >> 6))) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  if (cp < 0x10000) {
    return byteToStr(u8(0xE0 | (cp >> 12))) + byteToStr(u8(0x80 | ((cp >> 6) & 0x3F))) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  return byteToStr(u8(0xF0 | (cp >> 18))) + byteToStr(u8(0x80 | ((cp >> 12) & 0x3F))) + byteToStr(u8(0x80 | ((cp >> 6) & 0x3F))) + byteToStr(u8(0x80 | (cp & 0x3F)))
}

fn hexDigitVal(c: u8): i64! {
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return i64(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return i64(c - 'A') + 10
  }
  fail jsonErr{ msg: "invalid hex" }
}

fn decodeHex4(src: string, i: int): i64! {
  let v = i64(0)
  let k = 0
  while (k < 4) {
    let d = hexDigitVal(src[i + k])?
    v = v * 16 + d
    k = k + 1
  }
  return v
}

fn decodeStringLiteral(src: string, t: Token): string! {
  let i = t.start + 1
  let end = t.end - 1
  let out = ""
  while (i < end) {
    let c = src[i]
    if (c < 32) {
      fail jsonErr{ msg: "control character in string" }
    }
    if (c != '\\') {
      out = out + byteToStr(c)
      i = i + 1
      continue
    }
    if (i + 1 >= end) {
      fail jsonErr{ msg: "unterminated escape" }
    }
    let e = src[i + 1]
    if (e == '"') {
      out = out + "\""
      i = i + 2
    } else if (e == '\\') {
      out = out + "\\"
      i = i + 2
    } else if (e == '/') {
      out = out + "/"
      i = i + 2
    } else if (e == 'b') {
      out = out + byteToStr(8)
      i = i + 2
    } else if (e == 'f') {
      out = out + byteToStr(12)
      i = i + 2
    } else if (e == 'n') {
      out = out + "\n"
      i = i + 2
    } else if (e == 'r') {
      out = out + "\r"
      i = i + 2
    } else if (e == 't') {
      out = out + "\t"
      i = i + 2
    } else if (e == 'u') {
      if (i + 6 > end) {
        fail jsonErr{ msg: "invalid \\u escape" }
      }
      let cp = decodeHex4(src, i + 2)?
      i = i + 6
      if (cp >= 0xD800 && cp <= 0xDBFF) {
        if (i + 6 > end || src[i] != '\\' || src[i + 1] != 'u') {
          fail jsonErr{ msg: "unpaired surrogate" }
        }
        let lo = decodeHex4(src, i + 2)?
        if (lo < 0xDC00 || lo > 0xDFFF) {
          fail jsonErr{ msg: "invalid low surrogate" }
        }
        i = i + 6
        let combined = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
        out = out + writeUtf8(combined)
      } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
        fail jsonErr{ msg: "unpaired surrogate" }
      } else {
        out = out + writeUtf8(cp)
      }
    } else {
      fail jsonErr{ msg: "invalid escape character" }
    }
  }
  return out
}

// --- CST types (stdlib/json/cst.bit, #1720 as revised by #1726) ------------

struct Trivia { leading: string, trailing: string }

struct CstEntry { keyText: string, key: string, midGap: string, value: CstNode }

enum CstNode {
  CstNull(Trivia),
  CstBool(bool, Trivia),
  CstNumber(string, Trivia),
  CstString(string, Trivia),
  CstArray([]CstNode, []Opt<string>, Trivia),
  CstObject([]CstEntry, []Opt<string>, Trivia),
}

// --- CST parser (stdlib/json/cst_parse.bit, #1723 as revised by #1726) -----

struct CstParser { src: string, toks: []Token, i: int }

fn ctPeek(p: CstParser): Token {
  return p.toks[p.i]
}

fn ctAdvance(p: CstParser): Token {
  let t = p.toks[p.i]
  if (p.i < len(p.toks) - 1) {
    p.i = p.i + 1
  }
  return t
}

fn ctSlice(p: CstParser, t: Token): string {
  return p.src[t.start:t.end]
}

fn ctLastEnd(p: CstParser): int {
  return p.toks[p.i - 1].end
}

fn ctSkipComments(p: CstParser) {
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound && ctPeek(p).kind == TokenKind.Comment) {
    ctAdvance(p)
    guard = guard + 1
  }
}

fn ctSkipGap(p: CstParser, startAt: int): string {
  ctSkipComments(p)
  return p.src[startAt:ctPeek(p).start]
}

fn ctBuildValue(p: CstParser): CstNode! {
  let t = ctPeek(p)
  if (t.kind == TokenKind.LBrace) {
    return ctParseObject(p)?
  }
  if (t.kind == TokenKind.LBracket) {
    return ctParseArray(p)?
  }
  if (t.kind == TokenKind.StringTok) {
    ctAdvance(p)
    decodeStringLiteral(p.src, t)?
    return CstNode.CstString(ctSlice(p, t), Trivia{ leading: "", trailing: "" })
  }
  if (t.kind == TokenKind.NumberTok) {
    ctAdvance(p)
    let raw = ctSlice(p, t)
    if (!isValidJsonNumber(raw)) {
      fail jsonErr{ msg: "json: invalid number literal" }
    }
    return CstNode.CstNumber(raw, Trivia{ leading: "", trailing: "" })
  }
  if (t.kind == TokenKind.TrueTok) {
    ctAdvance(p)
    return CstNode.CstBool(true, Trivia{ leading: "", trailing: "" })
  }
  if (t.kind == TokenKind.FalseTok) {
    ctAdvance(p)
    return CstNode.CstBool(false, Trivia{ leading: "", trailing: "" })
  }
  if (t.kind == TokenKind.NullTok) {
    ctAdvance(p)
    return CstNode.CstNull(Trivia{ leading: "", trailing: "" })
  }
  if (t.kind == TokenKind.Invalid) {
    fail jsonErr{ msg: describeInvalid(p.src, t) }
  }
  fail jsonErr{ msg: "json: unexpected token, expected a value" }
}

fn ctParseObject(p: CstParser): CstNode! {
  let openTok = ctAdvance(p)
  let entries = []CstEntry(0)
  let gaps = []Opt<string>(0)
  let cursor = openTok.end
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let gap = ctSkipGap(p, cursor)
    if (ctPeek(p).kind == TokenKind.RBrace) {
      ctAdvance(p)
      gaps = append(gaps, Opt<string>.Some(gap))
      return CstNode.CstObject(entries, gaps, Trivia{ leading: "", trailing: "" })
    }
    gaps = append(gaps, Opt<string>.Some(gap))
    let keyTok = ctPeek(p)
    if (keyTok.kind != TokenKind.StringTok) {
      fail jsonErr{ msg: "json: expected string key" }
    }
    ctAdvance(p)
    let keyText = ctSlice(p, keyTok)
    let key = decodeStringLiteral(p.src, keyTok)?
    if (ctPeek(p).kind != TokenKind.Colon) {
      fail jsonErr{ msg: "json: expected ':' after object key" }
    }
    ctAdvance(p)
    let midGap = ctSkipGap(p, keyTok.end)
    let val = ctBuildValue(p)?
    entries = append(entries, CstEntry{ keyText: keyText, key: key, midGap: midGap, value: val })
    cursor = ctLastEnd(p)
    ctSkipComments(p)
    let nxt = ctPeek(p)
    if (nxt.kind == TokenKind.Comma) {
      ctAdvance(p)
    } else if (nxt.kind != TokenKind.RBrace) {
      fail jsonErr{ msg: "json: expected ',' or '}' in object" }
    }
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: object nesting exceeds token bound" }
}

fn ctParseArray(p: CstParser): CstNode! {
  let openTok = ctAdvance(p)
  let items = []CstNode(0)
  let gaps = []Opt<string>(0)
  let cursor = openTok.end
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let gap = ctSkipGap(p, cursor)
    if (ctPeek(p).kind == TokenKind.RBracket) {
      ctAdvance(p)
      gaps = append(gaps, Opt<string>.Some(gap))
      return CstNode.CstArray(items, gaps, Trivia{ leading: "", trailing: "" })
    }
    gaps = append(gaps, Opt<string>.Some(gap))
    let v = ctBuildValue(p)?
    items = append(items, v)
    cursor = ctLastEnd(p)
    ctSkipComments(p)
    let nxt = ctPeek(p)
    if (nxt.kind == TokenKind.Comma) {
      ctAdvance(p)
    } else if (nxt.kind != TokenKind.RBracket) {
      fail jsonErr{ msg: "json: expected ',' or ']' in array" }
    }
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: array nesting exceeds token bound" }
}

fn ctAttachRootTrivia(node: CstNode, t: Trivia): CstNode {
  match (node) {
    CstNull(old) => return CstNode.CstNull(t)
    CstBool(b, old) => return CstNode.CstBool(b, t)
    CstNumber(r, old) => return CstNode.CstNumber(r, t)
    CstString(s, old) => return CstNode.CstString(s, t)
    CstArray(items, gaps, old) => return CstNode.CstArray(items, gaps, t)
    CstObject(entries, gaps, old) => return CstNode.CstObject(entries, gaps, t)
  }
}

fn cstParse(source: string): CstNode! {
  let p = CstParser{ src: source, toks: lexCst(source), i: 0 }
  let leading = ctSkipGap(p, 0)
  let node = ctBuildValue(p)?
  let trailing = ctSkipGap(p, ctLastEnd(p))
  if (ctPeek(p).kind != TokenKind.Eof) {
    fail jsonErr{ msg: "json: trailing garbage after value" }
  }
  return ctAttachRootTrivia(node, Trivia{ leading: leading, trailing: trailing })
}

// --- edit layer (stdlib/json/edit.bit, #1725 as revised by #1726) ----------

fn findEntryIndex(entries: []CstEntry, key: string): int {
  let idx = -1
  let i = 0
  while (i < len(entries)) {
    if (entries[i].key == key) {
      idx = i
    }
    i = i + 1
  }
  return idx
}

fn jsonEscapeString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      out = out + "\\\""
    } else if (c == '\\') {
      out = out + "\\\\"
    } else if (c == '\n') {
      out = out + "\\n"
    } else {
      out = out + byteToStr(c)
    }
    i = i + 1
  }
  return out + "\""
}

fn appendGapSlot(gaps: []Opt<string>): []Opt<string> {
  let out = []Opt<string>(0)
  let i = 0
  while (i < len(gaps) - 1) {
    out = append(out, gaps[i])
    i = i + 1
  }
  out = append(out, Opt<string>.None)
  out = append(out, gaps[len(gaps) - 1])
  return out
}

fn cstSetStringAt(node: CstNode, path: []string, idx: int, value: string): CstNode! {
  match (node) {
    CstObject(entries, gaps, trivia) => {
      let key = path[idx]
      let found = findEntryIndex(entries, key)
      if (idx == len(path) - 1) {
        if (found >= 0) {
          match (entries[found].value) {
            CstString(raw, strTrivia) => {
              entries[found].value = CstNode.CstString(jsonEscapeString(value), strTrivia)
              return node
            }
            CstNull(t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstBool(b, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstNumber(r, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstArray(a, g, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstObject(es, g, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
          }
        }
        let newEntry = CstEntry{
          keyText: jsonEscapeString(key),
          key: key,
          midGap: ": ",
          value: CstNode.CstString(jsonEscapeString(value), Trivia{ leading: "", trailing: "" }),
        }
        return CstNode.CstObject(append(entries, newEntry), appendGapSlot(gaps), trivia)
      }
      if (found < 0) {
        fail jsonErr{ msg: "json: cstSetString: path segment does not exist" }
      }
      let updated = cstSetStringAt(entries[found].value, path, idx + 1, value)?
      entries[found].value = updated
      return node
    }
    CstNull(t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstBool(b, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstNumber(r, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstString(s, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstArray(a, g, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
  }
}

fn cstSetString(root: CstNode, path: []string, value: string): CstNode! {
  if (len(path) == 0) {
    fail jsonErr{ msg: "json: cstSetString: path must have at least one segment" }
  }
  return cstSetStringAt(root, path, 0, value)?
}

// --- CST printer under test (stdlib/json/cst_print.bit, #1726) -------------

fn gapIndent(gap: string): string {
  let lastNl = -1
  let i = 0
  let n = len(gap)
  while (i < n) {
    if (gap[i] == '\n') {
      lastNl = i
    }
    i = i + 1
  }
  if (lastNl < 0) {
    return ""
  }
  return gap[lastNl + 1:n]
}

fn gapForIndex(gaps: []Opt<string>, i: int): string {
  match (gaps[i]) {
    Some(g) => return g
    None => {
      if (i == 0) {
        return ""
      }
      match (gaps[i - 1]) {
        Some(prev) => return ",\n" + gapIndent(prev)
        None => return ",\n"
      }
    }
  }
}

fn printEntries(entries: []CstEntry, gaps: []Opt<string>): string {
  let out = ""
  let i = 0
  let n = len(entries)
  while (i < n) {
    out = out + gapForIndex(gaps, i) + entries[i].keyText + entries[i].midGap + cstPrint(entries[i].value)
    i = i + 1
  }
  out = out + gapForIndex(gaps, n)
  return out
}

fn printItems(items: []CstNode, gaps: []Opt<string>): string {
  let out = ""
  let i = 0
  let n = len(items)
  while (i < n) {
    out = out + gapForIndex(gaps, i) + cstPrint(items[i])
    i = i + 1
  }
  out = out + gapForIndex(gaps, n)
  return out
}

fn cstPrint(n: CstNode): string {
  match (n) {
    CstNull(t) => return t.leading + "null" + t.trailing
    CstBool(b, t) => {
      if (b) {
        return t.leading + "true" + t.trailing
      }
      return t.leading + "false" + t.trailing
    }
    CstNumber(r, t) => return t.leading + r + t.trailing
    CstString(s, t) => return t.leading + s + t.trailing
    CstArray(items, gaps, t) => return t.leading + "[" + printItems(items, gaps) + "]" + t.trailing
    CstObject(entries, gaps, t) => return t.leading + "{" + printEntries(entries, gaps) + "}" + t.trailing
  }
}

// --- line-diff assertion helper --------------------------------------------

// `s` split on '\n' (no trailing-newline special case needed: neither the
// fixture nor a valid edit output ends in one). Bounded by `len(s)`.
fn splitLines(s: string): []string {
  let lines = []string(0)
  let start = 0
  let i = 0
  let n = len(s)
  while (i < n) {
    if (s[i] == '\n') {
      lines = append(lines, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  lines = append(lines, s[start:n])
  return lines
}

// The number of positions where `a` and `b` differ, plus any extra lines one
// side has beyond the other's length (never true for a `cstSetString` edit,
// which only ever replaces one value's text — checked here anyway, so a
// regression that adds/drops a line shows up as more than one changed line
// instead of silently comparing only the shorter prefix).
fn countDiffLines(a: []string, b: []string): int {
  let minN = len(a)
  if (len(b) < minN) {
    minN = len(b)
  }
  let maxN = len(a)
  if (len(b) > maxN) {
    maxN = len(b)
  }
  let count = maxN - minN
  let i = 0
  while (i < minN) {
    if (a[i] != b[i]) {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

// --- test -------------------------------------------------------------

fn main() {
  let source = "{\n  // header comment\n  \"name\": \"widget\",\n  /* count of widgets */\n  \"count\": 3,\n  \"tags\": [\"a\", \"b\"],\n  \"nested\": {\n    \"flag\": true // trailing note\n  }\n}"

  let root = cstParse(source) catch e {
    print("parse-error: ${e.message()}\n")
    return
  }

  let updated = cstSetString(root, []string{ "name" }, "gadget") catch e {
    print("set-error: ${e.message()}\n")
    return
  }

  let printed = cstPrint(updated)
  let changed = countDiffLines(splitLines(source), splitLines(printed))
  print("changedLines=${changed}\n")
}
