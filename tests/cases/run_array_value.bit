// run
// #1470, the LEGAL half. check_array_literal.bit pins what both compilers must
// REJECT (a bare `[ ... ]` slice literal against an `[N]T` annotation, SPEC
// §12.3); this pins what they must ACCEPT and get RIGHT — the type-prefixed
// array literal `[N]T{...}`, the only array construction §11.2/§12.3 admit.
//
// Why this file exists at all, given the fix is a rejection: a checker change
// that merely rejects more is trivially "correct" if nothing proves the legal
// path still works. Rejecting the bare form is only right if the typed form is
// available and produces the right values — otherwise #1470 would be closed by
// making arrays unusable.
//
// EVERY CHECK COMPARES, none merely print. #1457 was two stacked bugs precisely
// because print and compare disagreed: a float can render plausibly and still be
// the wrong width in the slot. The `==` results are what get printed, so a
// regression flips a `true` to `false` rather than perturbing a rendered digit.
//
// f32 is the element type that mattered. #1470's miscompile stored an f64 into
// an f32-wide slot and `arr[0] == 4.5` came out FALSE, the same narrow-storage
// truncation as #1456/#1457. The f32 cases below are that exact shape.
//
// No NaN and no -0.0 anywhere: the default NaN sign differs between x86-64 and
// AArch64, so an `==` against an absolute bit pattern is not portable.
//
// A golden case is a single file, so it has no prelude.

// Arrays are VALUE types (§11.2): passing one copies it, so a callee's writes
// must not be visible to the caller.
function sum3(a: [3]i32): i32 {
  return a[0] + a[1] + a[2]
}

function mutate(a: [2]i32): i32 {
  a[0] = 99
  return a[0]
}

function makeF32(): [2]f32 {
  return [2]f32{4.5, 4.5}
}

function main() {
  // The #1470 shape, in its legal spelling. Compared against an explicitly
  // converted f32 rather than a pinned constant, so the case states the
  // invariant ("the literal and the conversion agree") not a magic number.
  let arr: [2]f32 = [2]f32{4.5, 4.5}
  print("f32.0=${arr[0] == f32(4.5)}\n")
  print("f32.1=${arr[1] == f32(4.5)}\n")

  // The bare `4.5` comparison is the one that was FALSE before the fix.
  print("f32lit=${arr[0] == 4.5}\n")

  // An integer element type: the same construction, no float width involved,
  // as the control that isolates the f32 result above.
  let ints: [3]i32 = [3]i32{1, 2, 3}
  print("i32sum=${sum3(ints) == 6}\n")

  // A zero-valued array (§11.2: `let a: [N]T` needs no initializer) must be
  // all zeroes — this is the slot the length-mismatch hole left uninitialized.
  let zeroed: [4]i32
  print("zeroed=${zeroed[0] == 0 && zeroed[1] == 0 && zeroed[2] == 0 && zeroed[3] == 0}\n")

  // Value semantics: the callee's store must not reach the caller's copy.
  let orig: [2]i32 = [2]i32{7, 8}
  let inner = mutate(orig)
  print("copied=${inner == 99 && orig[0] == 7}\n")

  // An array returned across a call boundary, f32 elements — the #1456 word-ABI
  // shape applied to the legal construction.
  let back = makeF32()
  print("ret=${back[0] == f32(4.5) && back[1] == f32(4.5)}\n")
}
