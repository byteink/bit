// panic
// #2014, the write half: `xs[i] = v` past the end must panic (SPEC §12.6,
// §18.4). `bit_rt_slice_set` dropped the store silently, which is the worse of
// the two directions — a lost write leaves the program reading a stale value it
// believes it has just replaced, so the damage shows up arbitrarily far from the
// bug. Sibling of run_slice_index_read_panic.bit; index non-foldable for the
// same reason.
import { args } from "std/os"

fn oob(): int { return len(args()) + 8 }

fn main() {
  let xs = [1, 2, 3]
  print("start\n")
  xs[oob()] = 42
  print("survived xs=${xs[0]},${xs[1]},${xs[2]}\n")
}
