// run
// A fallible method in an interface body, newline-separated (no comma). The `!`
// result marker must terminate the method so the next member parses — before
// #1234 `read(): []byte!`⏎`next()` ran the `!` straight into `next`, an E0021
// parse error. Regression guard for `.bang` as an ASI terminator.
interface Source {
  read(): i64!
  tag(): i64
}

class Ok {
  n: i64,
}

fn (o: Ok) read(): i64! {
  return o.n
}

fn (o: Ok) tag(): i64 {
  return 7
}

fn pull(s: Source): i64! {
  return s.read()?
}

fn main() {
  let s: Source = Ok{ n: 5 }
  let v = pull(s) catch e {
    print("err\n")
    return
  }
  print("read ${v} tag ${s.tag()}\n")
}
