// lint exit=0
// the identical self-assignment again, but threaded through a RETURNED
// BUNDLE's field instead of returned directly — the `emitElfBlobs`/
// `EmElfBlobs{ symbols: symbols, ... }` shape (#3648, compiler/emitelf.bit)
// this rule's one-hop exemption also has to recognise (#3688).
class Bundle {
  items: []int,
  n: int,
}
fn bundledOwner(items: []int, v: int): Bundle {
  items = append(items, v)
  return Bundle{ items: items, n: v }
}
