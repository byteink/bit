// run
// #3087 (epic #3076): a release build never inserts the overflow check
// #3081/#3083 add under `--debug`, so negating a runtime i64 MIN must
// silently wrap to i64 MIN itself (SPEC §13.5) and exit 0. Sibling of
// overflow_trap_neg_debug.bit: the identical expression, built WITH
// `--debug`, where the same overflow must trap instead. `minRuntime()`
// routes i64 MIN through a non-foldable subtraction so
// `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve the negation as a
// compile-time constant.
import { args } from "std/os"

fn one(): int { return len(args()) }

fn minRuntime(): int { return -9223372036854775807 - one() }

fn main() {
  print("neg=${-minRuntime()}\n")
}
