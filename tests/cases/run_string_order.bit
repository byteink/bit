// run
// String ordering is LEXICOGRAPHIC on bytes, not a compare of the two
// backing addresses (SPEC 14.6, #1664). Bytes compare unsigned and a
// common prefix is broken by length (shorter is less), which for UTF-8 is
// also code-point order. Every expected value here was derived from
// Python's comparison on bytes, never from Bit's own output.
//
// Operands go through parameters so no case can be answered by folding two
// literals, and the tail slices a string so a length-blind or
// NUL-terminated compare fails here too.

fn row(label: string, a: string, b: string) {
  print("${label} ${a < b} ${a <= b} ${a > b} ${a >= b}\n")
}

fn main() {
  row("abc_zzz", "abc", "zzz")
  row("getpid_h", "getpid", "h")
  row("getpid_getpie", "getpid", "getpie")
  row("ab_abc", "ab", "abc")
  row("abc_ab", "abc", "ab")
  row("zzz_abc", "zzz", "abc")
  row("empty_a", "", "a")
  row("a_empty", "a", "")
  row("empty_empty", "", "")
  row("abc_abc", "abc", "abc")
  row("nul_b_nul_c", "a\x00b", "a\x00c")
  row("a_nul_vs_a", "a\x00", "a")
  row("nul_z_vs_nul", "a\x00z", "a\x00")
  row("e_acute_z", "\xc3\xa9", "z")
  row("e_acute_e_circ", "\xc3\xa9", "\xc3\xaa")
  row("tilde_euro", "~", "\xe2\x82\xac")
  row("u7f_u80", "\x7f", "\xc2\x80")
  row("max_vs_ff", "\xf4\x8f\xbf\xbf", "\xc3\xbf")
  let src = "xxgetpidyy"
  let s = src[2:8]
  row("slice_h", s, "h")
  row("slice_getpie", s, "getpie")
  row("slice_self", s, "getpid")
}
