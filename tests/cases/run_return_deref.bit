// run
// `return *p` — a §11.4 raw-pointer dereference as a return operand (#1405).
//
// `parseReturnStmt` asks `canStartExpression` whether a value follows the
// keyword, and that predicate's prefix-operator tail had every unary operator
// `parseUnary` accepts EXCEPT `*`. So `return *p` was rejected as a bare return
// followed by stray input (E0021: expected ';', found '*') while the identical
// expression parsed fine in every other position — `let v = *p` worked, which is
// what made this read as a type or lowering problem rather than a parser gap.
// The ported scheduler's run queue needs deref-in-return constantly.
//
// The last two functions are the guard that the fix did not go too far: a bare
// `return` must still terminate at a line break (§7 automatic semicolon
// insertion), even when the next statement begins with `*`. If ASI regressed,
// `bumpUnless` would swallow `*p = 7` as the bare return's operand and both
// branches would print the same value.
function get(p: *i64): i64 {
  return *p
}

// Deref inside a larger return expression, not just as the whole operand.
function getPlus(p: *i64, n: i64): i64 {
  return *p + n
}

// Deref through pointer arithmetic — `*(p + 1)` needs the parenthesized form to
// reach the second word, since `*p + 1` binds as `(*p) + 1` above.
function getNext(p: *i64): i64 {
  return *(p + 1)
}

function bumpUnless(p: *i64, skip: bool) {
  if (skip) {
    return
  }
  *p = 7
}

function main() {
  let s = []i64(2)
  let p = ptrOf(s)
  atomicStore(p, 3)
  atomicStore(p + 1, 40)

  print("${get(p)} ${getPlus(p, 5)} ${getNext(p)}\n")

  bumpUnless(p, true)
  print("skipped=${get(p)}")
  bumpUnless(p, false)
  print(" applied=${get(p)}\n")
}
