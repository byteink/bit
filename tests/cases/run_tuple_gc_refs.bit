// run
// A tuple's reference elements must appear in its `ptr_offsets` (ABI.md §1.1/§2),
// or the collector will not trace them and a live element is freed underneath us.
//
// The loop is what makes this a real test: codegen emits `bit_rt_safepoint` only
// at loop back-edges, so a straight-line program collects zero times no matter
// how much it allocates and would pass with a completely wrong pointer map. The
// tuples built here mix a traced element (`string`) with an untraced one (`i64`)
// in both orders, so a map that is merely offset by one word is caught too.
fn labelled(i: i64): (string, i64) {
  return "s${i}", i
}

fn flipped(i: i64): (i64, string) {
  return i, "f${i}"
}

fn main() {
  // Allocate enough to force collections while keeping two tuples live across
  // every one of them.
  let keep = labelled(1)
  let keep2 = flipped(2)

  let n = 0
  let acc = 0
  while (n < 20000) {
    let t = labelled(n)
    let u = flipped(n)
    acc = acc + t.1 + u.0
    n = n + 1
  }

  // If the elements were collected or the map was misaligned, these read back
  // as garbage, an empty string, or a crash.
  print("keep ${keep.0} ${keep.1}\n")
  print("keep2 ${keep2.0} ${keep2.1}\n")
  print("acc ${acc}\n")
}
