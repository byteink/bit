// run
// A u64-typed module `const` must keep u64 in the IR (#1239). If its literal
// were kept as i64, `BIG` would be -1: the comparison would go signed (`> 5`
// false) and the logical shift would sign-fill. Each line below flips its
// output under signed semantics, so this is a real miscompile guard, not a
// tautology. Was worked around in stdlib/quic/tls.bit with explicit `u64(X)`.
const BIG: u64 = 0xFFFFFFFFFFFFFFFF
const HALF: u64 = 0x8000000000000000

function main() {
  if (BIG > 5) { print("gt ") } else { print("le ") }
  if (HALF > 100) { print("hi ") } else { print("lo ") }
  print("${BIG >> 60}\n")
}
