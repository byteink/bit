// error
// The other half of run_shadowed_free_call: a local elsewhere in the module must
// not disable validation of a call to the free function (#1502). The flat env
// said "twice is a local" module-wide, so this wrong-arity call was accepted.
function twice(n: i64): i64 {
  return n * 2
}

function shadower() {
  let twice = 5
  print("${twice}\n")
}

function main() {
  shadower()
  print("${twice(1, 2)}\n")
}
