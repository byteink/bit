// run
// Traits (SPEC §10.7, #3370): a trait can declare FIELDS, not just methods.
// `Enemy` never declares `hp` itself — `use Damageable` injects it into the
// class's own layout, so it is readable, writable and settable in a
// composite literal exactly like a hand-written field. `hp` is deliberately
// `export`ed: the trait member is parsed as `export[field[hp i64]]`, and a
// first draft of injection stored that WRAPPER node's tag (Export, not
// Field) when collecting the trait's field set, silently dropping `hp` from
// injection entirely and turning every reference to it into "no field or
// method 'hp' on this type" — caught by exactly this fixture.
trait Damageable {
  export hp: i64

  hurt(n: i64) { this.hp = this.hp - n }
  dead(): bool { return this.hp <= 0 }
}

class Enemy {
  use Damageable
  name: string
}

fn main() {
  let e = Enemy{ hp: 10, name: "Goblin" }
  e.hurt(3)
  print("${e.name} ${e.hp} ${e.dead()}\n")
  e.hurt(10)
  print("${e.dead()}\n")
}
