// run
// #1522: the code that must still compile once a block-bodied arrow's `return`s
// are actually validated (see the sibling check_arrow_block_return.bit for the
// program that must now be REFUSED).
//
// The interesting half of this case is the false positives it pins down. The
// first attempt at the fix read the arrow's own function type back and judged
// every `return` against it. That rejected the multi-return arrows below, which
// the seed accepts: an arrow with no expectation INFERS its result from the
// first `return` (#1488), and the seed never checks the later ones against that
// inference — its inner FnCtx carries the EXPECTED result and stays unset when
// the source supplied none. So the validator asks for the expectation, not the
// arrow's final type.
//
// The rest is the arrow-boundary context, which the walk now has to restart
// rather than inherit: break/continue inside an arrow do not target an
// enclosing loop, so an arrow that legitimately loops must still be accepted
// after the boundary reset.
//
// A golden case is a single file, so it has no prelude.

function applyI32(f: (f32) => i32): i32 {
  return f(1.0)
}

function main() {
  // The expectation is honoured and the body satisfies it.
  print("expected=${applyI32((x: f32) => { return 4 })}\n")

  // No expectation, so the result is inferred from the first `return` and the
  // later ones are not judged against it. Both of these were rejected by the
  // read-back-the-arrow's-own-type version of the fix.
  let sign = (a: i32) => {
    if (a > 0) { return 1 }
    return 0
  }
  print("infer=${sign(7)}${sign(0)}\n")

  // A bare `return` in a void arrow: the walk must not demand a value when
  // there is no expected result to demand one against.
  let noop = (a: i32) => {
    if (a > 0) { return }
    return
  }
  noop(1)
  print("void=ok\n")

  // break/continue INSIDE the arrow bind to the arrow's own loop, not to the
  // enclosing one. The boundary reset must not break this.
  for outer of [1, 2] {
    let count = (n: i32) => {
      let total: i32 = 0
      let i: i32 = 0
      while (i < n) {
        i = i + 1
        if (i == 2) { continue }
        if (i > 3) { break }
        total = total + i
      }
      return total
    }
    print("loop=${count(5)}\n")
    if (outer == 9) { break }
  }
}
