// error
// One type parameter in two parameter positions binds ONCE, and every later
// argument is judged against that binding (#2243). Before this, a generic call
// escaped the argument-type check entirely, so `std/testing`'s
// `eq(got: T, want: T, label: string)` accepted `eq(1, true, "x")` and reported
// `ok` — an assertion that could not fail in the green direction.
function pair<T>(a: T, b: T): int { return 1 }

function main() {
  print("${pair(1, true)}\n")
  print("${pair(1, "s")}\n")
  print("${pair("s", 1.5)}\n")
  print("${pair(1, 1.0)}\n")
}
