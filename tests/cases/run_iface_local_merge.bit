// run
// Interface widening across control-flow merges (§14.3): an interface-typed
// local holds a concrete value, whose IR value type is the concrete class
// while the slot's declared type is the interface. Threading it through a
// control-flow join — an if-tail, a reassignment merge, a `catch`, and a loop
// back-edge — makes it a block argument; the join param is created at the
// interface type, so lowering must relabel the concrete value to the interface
// (a no-op boxed-handle cast) at every store or the IR verifier rejects the
// block-arg type mismatch. Dispatch still resolves through each object's own
// method table, so the printed area/name prove the right concrete method ran.
interface Shape { area(): i64, name(): string }
class Square {
  side: i64
  area(): i64 { return this.side * this.side }

  name(): string { return "square" }
}
class Circle {
  r: i64
  area(): i64 { return 3 * this.r * this.r }

  name(): string { return "circle" }
}
class shapeErr {
  message(): string { return "no shape" }
}
// Fallible returning an interface: the `catch` join merges the ok Shape and the
// handler's Shape at a block param typed `Shape`.
fn pick(n: i64): Shape! {
  if (n < 0) {
    fail shapeErr{}
  }
  return Square{ side: n }
}

fn main() {
  // (A) if-tail: `a` is live after the `if`, so it is threaded as a block arg.
  let a: Shape = Circle{ r: 2 }
  if (a.area() > 0) {
    print("A ${a.name()}=${a.area()}\n")
  }
  print("A after ${a.name()}=${a.area()}\n")

  // (B) reassignment merge: the else-edge carries the original Circle, the
  // then-edge the reassigned Square; both reach the tail join typed `Shape`.
  let b: Shape = Circle{ r: 3 }
  if (a.area() > 10) {
    b = Square{ side: 5 }
  }
  print("B ${b.name()}=${b.area()}\n")

  // (C) catch join: ok value and handler value are both interface-typed.
  let c: Shape = pick(4) catch Circle{ r: 1 }
  print("C ${c.name()}=${c.area()}\n")
  let d: Shape = pick(-1) catch Circle{ r: 10 }
  print("C ${d.name()}=${d.area()}\n")

  // (D) loop back-edge: `s` is reassigned each iteration and threaded across
  // the loop header merge.
  let s: Shape = Square{ side: 1 }
  let i = 0
  while (i < 3) {
    s = Circle{ r: i + 1 }
    i = i + 1
  }
  print("D ${s.name()}=${s.area()}\n")
}
