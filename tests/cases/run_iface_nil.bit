// run
// An interface is a reference type, so `nil` is its zero value (§13.4) — and
// that has to hold for a *non-empty* interface too, not just an empty one.
// `nil` has no method set, so it can never pass the structural-satisfaction test
// (§14.3); assignability must answer `nil` before it ever asks about methods.
// Every way a value can reach an interface-typed slot must accept it, which is
// what makes "declare it null, fill it in later" spellable.
interface Shape {
  area(): i64
}

struct Circle {
  r: i64,
}

fn (c: Circle) area(): i64 {
  return c.r * c.r
}

struct Box {
  v: Shape,
}

fn take(s: Shape): i64 {
  if (s == nil) {
    return -1
  }
  return s.area()
}

fn give(): Shape {
  return nil
}

fn main() {
  let a: Shape = nil                    // let
  let n = take(nil)                     // argument
  let g = give()                        // return
  let b = Box{ v: nil }                 // struct field initializer
  let sl: []Shape = [nil]               // slice literal element
  let m = map<string, Shape>{"k": nil}  // map literal value
  let ch = chan<Shape>(1)
  ch <- nil                             // channel send
  let got = <- ch

  print("${n} ${a == nil} ${g == nil} ${b.v == nil} ${sl[0] == nil} ${m["k"] == nil} ${got == nil}\n")

  // The point of the zero value: declare it null, fill it in later.
  let s: Shape = nil
  print("${s == nil}\n")
  s = Circle{ r: 3 }
  print("${s != nil} ${take(s)}\n")
}
