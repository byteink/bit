// error
// #1489: composite-literal diagnostic ORDER. Both compilers already emitted the
// same SET of diagnostics here, with identical text and identical spans — only
// the SEQUENCE differed, so no gate was red and no diagnostic was wrong. That is
// exactly the shape that rots quietly: the differentials compare RENDERED output
// byte-for-byte, so the first multi-error nested-literal golden anyone added
// would have reddened selfhost-diffcheck for a reason unrelated to their change.
//
// THE SPEC RULING (SPEC.md §12.3, added with this case). A composite literal is
// checked slot by slot in source order; the whole-literal rule (E0050 length)
// lands first, and each slot's EXPRESSION is checked to completion — reporting
// everything nested inside it — before that slot's assignability. So the inner
// `a: "s"` below is reported BEFORE the outer `x:` that contains it, even though
// `x:` starts earlier in the source. That is the seed's checkCompositeLit order
// (checkStructInit / checkSeqInit / checkMapInit each call checkExpr, THEN
// expect), and it is the order the spec now fixes: post-order, not source order.
//
// The self-hosted validator ran the whole literal at PRE-order and descended
// afterwards, which put every outer-slot diagnostic ahead of every nested one.
// Fixed by making the CompositeLit walk own its own recursion and interleave
// each slot's judgement with the descent into that slot (vComposite /
// vCompositeSlot). A map entry interleaves at SLOT granularity, not entry
// granularity, because the seed judges the key before it descends into the
// value — the `Bad{...}` key and value below are what prove that.

struct Inner { a: int, b: int }
struct Outer { x: Inner, y: int, z: Inner }

// Nesting under a slot whose own type is wrong: the nested `a: "s"` must precede
// the outer `x:` mismatch it sits inside.
struct Flat { x: int }

function main() {
  let o = Outer{ x: Inner{ a: "s", b: "t" }, y: "u", z: Inner{ a: "v", b: "w" } }
  let f = Flat{ x: Inner{ a: "n", b: 0 } }
  let m = map<int, int>{ Inner{ a: "k", b: 0 }: Inner{ a: "v", b: 0 } }
  let s = []Inner{ Inner{ a: "p", b: 0 }, Inner{ a: 0, b: "q" } }
  let arr = [1]int{ "e", "f" }
  print(o.y)
  print(f.x)
  print(m)
  print(s)
  print(arr)
}
