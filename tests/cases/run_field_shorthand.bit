// run
// #3735: field shorthand in a class literal. `P{ db, name }` desugars to
// `P{ db: db, name: name }` in the parser; field order stays irrelevant and
// shorthand may be freely mixed with the keyed form in one literal.
class P { db: int, name: string }

fn main() {
  let db = 7
  let name = "x"
  let shorthand = P{ db, name }
  let keyed = P{ db: db, name: name }
  let mixed = P{ name, db: db }
  print("shorthand=${shorthand.db} ${shorthand.name}\n")
  print("keyed=${keyed.db} ${keyed.name}\n")
  print("mixed=${mixed.db} ${mixed.name}\n")
}
