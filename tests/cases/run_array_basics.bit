// run
// Fixed-size arrays `[N]T` (SPEC §11.2): zero-initialization, an array literal,
// and index read/write. `let a: [N]T` yields a block of `N` zeroed elements;
// `[N]T{...}` builds one from an initializer list.
function main() {
  // Zero-init: every element reads 0 before assignment.
  let z: [4]u32
  print("zero=${z[0]} ${z[1]} ${z[2]} ${z[3]}\n")

  // Index write then read.
  z[0] = u32(10)
  z[3] = u32(40)
  print("written=${z[0]} ${z[3]}\n")

  // Array literal.
  let lit: [4]u32 = [4]u32{u32(1), u32(2), u32(3), u32(4)}
  print("literal=${lit[0]} ${lit[1]} ${lit[2]} ${lit[3]}\n")
}
