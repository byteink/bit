// run
// The no-false-positive half of #2243/#2360. Judging a generic call's arguments
// means substituting the call's inferred type arguments first, and every shape
// where that substitution can come back unsettled must stay SILENT rather than
// report against a type nobody wrote.
struct Box<T> { v: T }

// Two positions, one type parameter — the shape the diagnostic exists for, here
// used correctly, including through untyped literals that must adapt to the
// binding rather than be compared against it raw.
fn pair<T>(a: T, b: T): int { return 1 }

// Bound through a composite, not a bare parameter.
fn firstOr<T>(xs: []T, fallback: T): T {
  if (len(xs) == 0) {
    return fallback
  }
  return xs[0]
}

// `U` is reachable ONLY through a function-typed parameter, and the result.
fn mapped<T, U>(xs: []T, f: (T) => U): []U {
  let out = []U(0)
  for x of xs {
    out = append(out, f(x))
  }
  return out
}

// A nominal generic parameter: the argument type carries its arguments in the
// instantiation ledger, not in the type itself.
fn unbox<T>(b: Box<T>): T { return b.v }

// Variadic: only the fixed prefix has an arity, and the rest slot is not a
// position this rule may judge.
fn tally<T>(label: string, ...xs: T): int { return len(xs) }

fn double(n: int): int { return n * 2 }

fn main() {
  print("${pair(1, 2)}\n")
  print("${pair<int>(1, 2)}\n")
  print("${pair("a", "b")}\n")
  print("${pair(1.5, 2.5)}\n")
  print("${firstOr([7, 8], 0)}\n")
  print("${firstOr([]int(0), 9)}\n")
  print("${len(mapped([1, 2, 3], double))}\n")
  print("${unbox(Box<int>{ v: 42 })}\n")
  print("${unbox(Box<string>{ v: "s" })}\n")
  print("${tally("x", 1, 2, 3)}\n")
}
