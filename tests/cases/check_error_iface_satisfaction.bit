// error
// #2237: structural satisfaction (§14.3) was enforced for a user-declared
// interface but not for the PREDECLARED `error` (§10.6) — its method set is
// registered in `methodResults` only, and the satisfaction walk read
// `methodSigs`, so the loop had nothing to compare and every struct "satisfied"
// it. `bit check` exited 0, the binary linked, and the first `message()` call
// was a SIGSEGV through a slot no method table ever filled.
struct NoMethod { code: i64 }

struct WrongSig { code: i64 }

// i64, not string: `error` is `message(): string`.
function (e: WrongSig) message(): i64 {
  return e.code
}

function main() {
  let a: error = NoMethod{ code: 1 }
  let b: error = WrongSig{ code: 2 }
  print("${a.message()}${b.message()}\n")
}
