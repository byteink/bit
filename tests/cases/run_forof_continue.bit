// run
// `continue` inside a `for..of` must advance the iterator, not re-enter the loop
// on the same element. The cursor step lives in a dedicated block that both the
// normal fall-through and every `continue` pass through; a `continue` that jumped
// straight to the header would re-test the un-advanced index and loop forever.
// Regression guard for the #1243 infinite loop — a `// run` case so a relapse
// hangs the suite loudly rather than printing a wrong number.
fn main() {
  // Slice: skip one element mid-body.
  let xs = [1, 2, 3, 4]
  let s = 0
  for x of xs {
    if (x == 2) { continue }
    s = s + x
  }
  print("slice ${s}\n") // 1+3+4

  // continue as the last statement (no trailing work) still advances.
  let n = 0
  for x of xs {
    n = n + 1
    if (x > 0) { continue }
  }
  print("count ${n}\n") // 4

  // continue and break in the same loop.
  let b = 0
  for x of xs {
    if (x == 2) { continue }
    if (x == 4) { break }
    b = b + x
  }
  print("mixed ${b}\n") // 1+3

  // Map: iterate slots, skip one value.
  let m = map<string, i64>()
  m["a"] = 1
  m["b"] = 2
  m["c"] = 3
  let ms = 0
  for (k, v) of m {
    if (v == 2) { continue }
    ms = ms + v
  }
  print("map ${ms}\n") // 1+3

  // Nested: continue in the inner loop must not disturb the outer cursor.
  let acc = 0
  for i of xs {
    for j of xs {
      if (j == 2) { continue }
      acc = acc + 1
    }
  }
  print("nested ${acc}\n") // 4 outer * 3 kept inner
}
