// run
// #1548: a bind-catch block whose only divergence is an infinite loop lowers.
// `while (true)` with no own break diverges, and the validator has always known
// that (E0067 does not fire here), but the lowerer used to reopen the loop's
// exit block and clear `terminated` unconditionally — so `lowerCatch` saw a
// catch block that fell through with no value and, since #1519, refused the
// whole function rather than merge a bogus operand into the join. The seed hit
// the same disagreement one step earlier and panicked on a null unwrap.
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally.
struct myErr { code: i64 }
fn (e: myErr) message(): string { return "code=${e.code}" }
fn g(ok: bool): i64! {
  if (!ok) { fail myErr{ code: 1 } }
  return 7
}
// The catch block never runs here — the point is that it LOWERS. Running it
// would hang, which is exactly what "this block diverges" means.
fn f(ok: bool): i64 {
  return g(ok) catch e {
    while (true) {
    }
  }
}
// A `while (true)` that DOES break still falls out normally: the exit stays
// reachable, so this must not be mistaken for a diverging loop.
fn loops(): i64 {
  let n = 0
  while (true) {
    n = n + 1
    if (n > 2) { break }
  }
  return n
}
fn main() {
  print("a=${f(true)}\n")
  print("b=${loops()}\n")
}
