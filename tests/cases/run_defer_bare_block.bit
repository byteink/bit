// run
// #3443: a bare, unconditional `{ }` block is NOT a conditional region (if/
// while/for), so #2378's E0092 refusal never applies to a `defer` inside one
// -- it always runs, exactly once, like any defer in the enclosing scope. The
// bug was in lowering, not semantics: truncating the block's own env locals
// at the closing brace also dropped the defer's captured-argument slots,
// panicking `index out of range` at the function's actual exit. Covers a
// free-function call, a receiver method call, a zero-argument call (already
// correct, kept as the control), two defers in one block (LIFO order must
// hold across the block boundary), and a block that terminates via `return`
// (the drop path, mirroring deferScopeEnd's terminated branch) beside ones
// that fall through (the rehome path).
class C {
  n: int,
}
fn (c: C) bump() {
  c.n = c.n + 1
}
fn (c: C) show() {
  print("show n=${c.n}\n")
}
fn note(s: string) {
  print(s)
}

// One deferred call with an argument, inside a block that falls through.
fn oneArg() {
  { defer note("one-arg\n") }
  print("after one-arg\n")
}

// A deferred receiver method call.
fn receiver() {
  let c = C{ n: 5 }
  { defer c.show() }
  print("after receiver\n")
}

// A deferred call with no arguments -- already correct before #3443; kept so
// a future regression on this path shows up beside the fix.
fn zeroArg() {
  { defer note("zero-arg\n") }
}

// Two defers in the same block: LIFO order must survive the block boundary.
fn twoDefers() {
  {
    defer note("first\n")
    defer note("second\n")
  }
  print("after two\n")
}

// A block that always returns: its defer already replayed at that return, so
// it must run exactly once, not again at the function's own exit.
fn terminates(c: C) {
  {
    defer c.bump()
    return
  }
}

fn main() {
  oneArg()
  receiver()
  zeroArg()
  twoDefers()
  let c = C{ n: 0 }
  terminates(c)
  print("terminates -> ${c.n} (want 1)\n")
}
