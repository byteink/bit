// error
// #1521: type-ANNOTATION diagnostic ORDER (E0052 map-key-not-comparable, E0072
// array-element-not-scalar). Both compilers emitted the same SET here, with
// identical text and identical spans — only the SEQUENCE differed, so no gate
// was red and no diagnostic was wrong. Same shape as #1489, one traversal over.
//
// The self-hosted compiler ran `vTypeNodes` as a whole-DECLARATION pre-pass,
// because type nodes were believed to be unreachable from the statement walk.
// They are reachable — vStmt descends every kid — so the pre-pass hoisted every
// E0052/E0072 in a function body ahead of every statement diagnostic in it,
// while the seed emits them from `checkType`, reached in ordinary walk order.
//
// THE SPEC RULING (SPEC.md §12.3). A node's own judgement is emitted AFTER every
// judgement in its subtree, subtrees visited in source order. Post-order is not
// a stylistic choice: a node's verdict depends on its children's types, so any
// single recursive checker must produce it. This case pins three consequences.
//
// 1. A nested type reports INNER-FIRST: `[2][2]string` reports the inner
//    `[2]string` element before the outer one, and likewise for a nested map.
// 2. A type node embedded in an EXPRESSION reports in its source position among
//    that expression's other diagnostics — NOT hoisted to the front.
// 3. A binding's assignability verdict comes LAST, after its annotation's own
//    diagnostics and after everything nested in its initializer.
//
// Single-file golden, so there is NO prelude: `print` takes a string.

function g(s: string): int {
  return 0
}

// Signature type nodes are checked before the body, param before result.
function sig(p: [2]string): [2]string {
  return p
}

function main() {
  // (1) inner-first nesting, both spellings.
  let a: [2][2]string = [2][2]string{}
  let m: map<[]int, map<[]int, int>> = map<[]int, map<[]int, int>>{}

  // (2) the type node sits to the RIGHT of a bad call argument, so the call's
  // diagnostic must come first. This is the assertion a whole-declaration
  // pre-pass fails: it would hoist the E0072 above the E0041.
  let z = g(1) + g("ok") + len([2]string{})

  // (3) annotation first, then the diagnostic nested inside the initializer,
  // then the binding's own assignability verdict at the initializer's span.
  let w: map<[]int, int> = g(1)

  print(a)
  print(m)
  print(z)
  print(w)
}
