// run
// #2307: a generic call whose EXPLICIT type argument names the enclosing
// function's own type parameter — `idf<T>(x)` inside `chain<T>`. `bit check`
// accepted it and the build refused with `cannot lower 1 function(s): chain$1`,
// while the inferred spelling `idf(x)` compiled.
//
// The type argument is read off the AST and resolved again while lowering, when
// `T` is already bound to the instantiation's concrete argument, so the call
// asked for `idf<i64>` — an instance the check pass, which saw only the bare
// `T`, had never recorded.
//
// Why it blocks a library rather than being cosmetic (SPEC §15.3): for a
// generic with nothing to infer from — a constructor — the turbofish is the
// ONLY legal spelling, so `newStack<T>()` was unreachable from anywhere inside
// its own library.
function idf<T>(x: T): T { return x }

function chain<T>(x: T): T {
  return idf<T>(x)
}

// A CONCRETE explicit argument inside a generic body always worked; it must
// keep working.
function concreteInside<T>(x: T): i64 {
  return idf<i64>(1)
}

// The constructor shape from the report: nothing to infer from, so the type
// argument has to be written, and it names the caller's own parameter.
function empty<T>(): []T {
  return []T(0)
}

function mk<T>(x: T): []T {
  let e = empty<T>()
  return append(e, x)
}

function main() {
  assert(chain(3) == 3, "chain int")
  assert(chain("s") == "s", "chain string")
  assert(concreteInside(9) == 1, "concrete inside")

  let xs = mk<i64>(11)
  let ss = mk("q")
  print("${chain(3)} ${xs[0]} ${ss[0]} ${len(xs)}\n")
  print("ok\n")
}
