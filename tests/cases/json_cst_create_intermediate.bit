// run
// stdlib/json's CST edit API must never emit a document its own `jsonParse`
// refuses (#2351). `cstSetStringPath`, when the path required CREATING a
// missing intermediate object, rendered it with a TRAILING COMMA —
// `{"foo": "bar",` newline `}` — so the file it wrote back could not be read
// again. That is data loss for the one use case the CST layer exists for:
// editing a hand-maintained config without reformatting the rest of it.
//
// Root cause was in the printer, not the editor: an object built from scratch
// (edit.bit's `emptyCstObject`) has `Option<string>.None` for its TAIL gap —
// the boundary after the last entry, before the closing `}` — and
// `gapForIndex` (cst_print.bit) classified every `None` at index > 0 as a
// between-entries separator and synthesized a comma for it. Only the first and
// last boundary of a container are non-separators; the tail is now excluded.
//
// This case imports the REAL std/json rather than redeclaring it. The older
// json goldens here each carry a local copy of the module on the belief that a
// single-file case gets no prelude and cannot import `std/*`; measured against
// both this compiler and the pinned 0.1.5 oracle, it can do both (#2347), and a
// local copy would only shadow the code under test.
//
// Row `existing-empty` is the shape that already worked before the fix (a
// `"dependencies": {}` that came from `cstParse`, which is what
// compiler/pmcli.bit pre-seeds for #2245) and pins that the fix left it
// byte-identical. The `delete-*` rows cover the mirror-image case: removing the
// last, the first, or the only member must not strand a separator either.
import { cstParse, cstSetStringPath, cstDeleteKey, cstPrint, jsonParse } from "std/json"

// `s` with newlines and tabs as two-character escapes, so each row's whole
// document is one line of the `.expected` file — a trailing comma before a
// newline is then visible in a diff instead of hiding at a line end.
// Bounded by `len(s)`: one byte per iteration.
fn esc(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\n') {
      out = out + "\\n"
    } else if (s[i] == '\t') {
      out = out + "\\t"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out
}

// The verdict of feeding `text` back through the module's own strict parser.
// Printed rather than asserted with a boolean so the failure names its reason.
fn reparse(text: string): string {
  let v = jsonParse(text) catch e {
    return "REPARSE FAILED: " + e.message()
  }
  return "reparse ok"
}

fn report(label: string, text: string) {
  println("${label}: ${esc(text)} -> ${reparse(text)}")
}

fn setPath(label: string, src: string, path: []string) {
  let root = cstParse(src) catch e {
    println("${label}: cstParse failed: ${e.message()}")
    return
  }
  let out = cstSetStringPath(root, path, "bar") catch e {
    println("${label}: cstSetStringPath failed: ${e.message()}")
    return
  }
  report(label, cstPrint(out))
}

fn deleteKey(label: string, src: string, path: []string) {
  let root = cstParse(src) catch e {
    println("${label}: cstParse failed: ${e.message()}")
    return
  }
  let out = cstDeleteKey(root, path) catch e {
    println("${label}: cstDeleteKey failed: ${e.message()}")
    return
  }
  report(label, cstPrint(out))
}

fn main() {
  setPath("create-missing", "{\n  \"name\": \"demo\"\n}\n", ["dependencies", "foo"])
  setPath("existing-empty", "{\n  \"name\": \"demo\",\n  \"dependencies\": {}\n}\n", ["dependencies", "foo"])
  setPath("empty-document", "{}\n", ["dependencies", "foo"])
  setPath("create-three-levels", "{}\n", ["a", "b", "c"])
  deleteKey("delete-only-member", "{\n  \"a\": \"1\"\n}\n", ["a"])
  deleteKey("delete-last-member", "{\n  \"a\": \"1\",\n  \"b\": \"2\"\n}\n", ["b"])
  deleteKey("delete-first-member", "{\n  \"a\": \"1\",\n  \"b\": \"2\"\n}\n", ["a"])
  deleteKey("delete-nested-only-member", "{\n  \"deps\": {\n    \"x\": \"1\"\n  }\n}\n", ["deps", "x"])
  println("done")
}
