// run
// Top-level `const` values are inlined at each reference by re-lowering the
// initializer (SPEC §15.4). Covers an explicit type, an inferred untyped
// literal, a const defined in terms of another const, and use inside an
// expression and a string interpolation.
const RATE: f64 = 1.5
const COUNT = 4
const TOTAL = COUNT * 10
const LABEL = "n="

function main() {
  print("rate=${RATE}\n")
  print("count=${COUNT} total=${TOTAL}\n")
  let scaled = RATE * f64(COUNT)
  print("scaled=${scaled}\n")
  print("${LABEL}${COUNT}\n")
}
