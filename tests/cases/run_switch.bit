// run
function label(n: i64): string {
  switch (n) {
    case 1, 2:
      return "low"
    case 3:
      return "mid"
    default:
      return "high"
  }
}

function main() {
  print(label(1))
  print(" ")
  print(label(2))
  print(" ")
  print(label(3))
  print(" ")
  print(label(9))
  print(" ")

  let y = 5
  switch (y) {
    case 5: {
      print("hit")
      break
    }
    default:
      print("miss")
  }
  print(" ")

  let a = 7
  switch {
    case a < 0:
      print("neg")
    default:
      print("pos")
  }
  print("\n")
}
