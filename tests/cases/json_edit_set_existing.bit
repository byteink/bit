// run
// stdlib/json/edit.bit's cstSetString (#1725), replacing an EXISTING key's
// string value in place. A golden case is a single file with no prelude and
// cannot import std/json (see json_cst_parse_trivia.bit), so this
// redeclares the comment-emitting lexer, the #1720 CST types, the #1723 CST
// parser, and the edit function under test locally.
//
// Parses a JSONC object with a `//` comment before "name", replaces "name"'s
// value with a string that needs escaping (an embedded `"`), then asserts
// (via cstGet) the new value round-trips JSON-quoted-and-escaped while the
// entry's own keyText and Trivia (that same leading comment) stay untouched.

struct jsonErr { msg: string }
fn (e: jsonErr) message(): string { return e.msg }

enum Opt<T> { Some(T), None }

// --- lexer (stdlib/json/lex.bit + the Comment-emitting mode) ---------------

enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
  Comment,
}

struct Token { kind: TokenKind, start: int, end: int }

const jsonMaxDepth = 64

struct Lexer { src: string, i: int, depth: int }

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

fn emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

fn scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

fn scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

fn scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

fn scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

fn scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

fn scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '/' && lx.i + 1 < len(lx.src) && lx.src[lx.i + 1] == '/') {
      let start = lx.i
      lx.i = lx.i + 2
      while (lx.i < len(lx.src) && lx.src[lx.i] != '\n') {
        lx.i = lx.i + 1
      }
      return Token{ kind: TokenKind.Comment, start: start, end: lx.i }
    } else if (c == '/' && lx.i + 1 < len(lx.src) && lx.src[lx.i + 1] == '*') {
      let start = lx.i
      lx.i = lx.i + 2
      let closed = false
      while (lx.i + 1 < len(lx.src)) {
        if (lx.src[lx.i] == '*' && lx.src[lx.i + 1] == '/') {
          lx.i = lx.i + 2
          closed = true
          break
        }
        lx.i = lx.i + 1
      }
      if (!closed) {
        lx.i = len(lx.src)
        return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
      }
      return Token{ kind: TokenKind.Comment, start: start, end: lx.i }
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

fn lexCst(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

// --- string decoding/encoding (stdlib/json/parse.bit + encode.bit, trimmed) -

fn describeInvalid(src: string, t: Token): string {
  let c = src[t.start]
  if (c == '{' || c == '[') {
    return "json: max nesting depth exceeded"
  }
  if (c == '"') {
    return "json: unterminated string"
  }
  if (c == '/' && t.end - t.start > 1) {
    return "json: unterminated block comment"
  }
  return "json: unexpected character in input"
}

fn isValidJsonNumber(s: string): bool {
  let n = len(s)
  let i = 0
  if (i >= n) {
    return false
  }
  if (s[i] == '-') {
    i = i + 1
  }
  if (i >= n) {
    return false
  }
  if (s[i] == '0') {
    i = i + 1
  } else if (s[i] >= '1' && s[i] <= '9') {
    i = i + 1
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  } else {
    return false
  }
  if (i < n && s[i] == '.') {
    i = i + 1
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  if (i < n && (s[i] == 'e' || s[i] == 'E')) {
    i = i + 1
    if (i < n && (s[i] == '+' || s[i] == '-')) {
      i = i + 1
    }
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  return i == n
}

fn byteToStr(c: u8): string {
  let out = []byte(1)
  out[0] = c
  return string(out)
}

fn writeUtf8(cp: i64): string {
  if (cp < 0x80) {
    return byteToStr(u8(cp))
  }
  if (cp < 0x800) {
    return byteToStr(u8(0xC0 | (cp >> 6))) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  if (cp < 0x10000) {
    return byteToStr(u8(0xE0 | (cp >> 12))) + byteToStr(u8(0x80 | ((cp >> 6) & 0x3F))) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  return byteToStr(u8(0xF0 | (cp >> 18))) + byteToStr(u8(0x80 | ((cp >> 12) & 0x3F))) + byteToStr(u8(0x80 | ((cp >> 6) & 0x3F))) + byteToStr(u8(0x80 | (cp & 0x3F)))
}

fn hexDigitVal(c: u8): i64! {
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return i64(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return i64(c - 'A') + 10
  }
  fail jsonErr{ msg: "invalid hex" }
}

fn decodeHex4(src: string, i: int): i64! {
  let v = i64(0)
  let k = 0
  while (k < 4) {
    let d = hexDigitVal(src[i + k])?
    v = v * 16 + d
    k = k + 1
  }
  return v
}

fn decodeStringLiteral(src: string, t: Token): string! {
  let i = t.start + 1
  let end = t.end - 1
  let out = ""
  while (i < end) {
    let c = src[i]
    if (c < 32) {
      fail jsonErr{ msg: "control character in string" }
    }
    if (c != '\\') {
      out = out + byteToStr(c)
      i = i + 1
      continue
    }
    if (i + 1 >= end) {
      fail jsonErr{ msg: "unterminated escape" }
    }
    let e = src[i + 1]
    if (e == '"') {
      out = out + "\""
      i = i + 2
    } else if (e == '\\') {
      out = out + "\\"
      i = i + 2
    } else if (e == '/') {
      out = out + "/"
      i = i + 2
    } else if (e == 'b') {
      out = out + byteToStr(8)
      i = i + 2
    } else if (e == 'f') {
      out = out + byteToStr(12)
      i = i + 2
    } else if (e == 'n') {
      out = out + "\n"
      i = i + 2
    } else if (e == 'r') {
      out = out + "\r"
      i = i + 2
    } else if (e == 't') {
      out = out + "\t"
      i = i + 2
    } else if (e == 'u') {
      if (i + 6 > end) {
        fail jsonErr{ msg: "invalid \\u escape" }
      }
      let cp = decodeHex4(src, i + 2)?
      i = i + 6
      if (cp >= 0xD800 && cp <= 0xDBFF) {
        if (i + 6 > end || src[i] != '\\' || src[i + 1] != 'u') {
          fail jsonErr{ msg: "unpaired surrogate" }
        }
        let lo = decodeHex4(src, i + 2)?
        if (lo < 0xDC00 || lo > 0xDFFF) {
          fail jsonErr{ msg: "invalid low surrogate" }
        }
        i = i + 6
        let combined = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
        out = out + writeUtf8(combined)
      } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
        fail jsonErr{ msg: "unpaired surrogate" }
      } else {
        out = out + writeUtf8(cp)
      }
    } else {
      fail jsonErr{ msg: "invalid escape character" }
    }
  }
  return out
}

const hexDigits = "0123456789abcdef"

fn unicodeEscape(c: u8): string {
  let out = []byte(2)
  out[0] = hexDigits[int(c >> 4)]
  out[1] = hexDigits[int(c & 0x0f)]
  return "\\u00" + string(out)
}

// stdlib/json/encode.bit's jsonEscapeString, minus the Builder (golden cases
// can't import std/strings either) — plain concatenation instead.
fn jsonEscapeString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      out = out + "\\\""
    } else if (c == '\\') {
      out = out + "\\\\"
    } else if (c == '\n') {
      out = out + "\\n"
    } else if (c == '\t') {
      out = out + "\\t"
    } else if (c == '\r') {
      out = out + "\\r"
    } else if (c == 8) {
      out = out + "\\b"
    } else if (c == 12) {
      out = out + "\\f"
    } else if (c < 32) {
      out = out + unicodeEscape(c)
    } else {
      out = out + byteToStr(c)
    }
    i = i + 1
  }
  return out + "\""
}

// --- CST types (stdlib/json/cst.bit, #1720) --------------------------------

struct Trivia { leading: []string, trailing: Opt<string> }

struct CstEntry { keyText: string, key: string, trivia: Trivia, value: CstNode }

enum CstNode {
  CstNull(Trivia),
  CstBool(bool, Trivia),
  CstNumber(string, Trivia),
  CstString(string, Trivia),
  CstArray([]CstNode, Trivia),
  CstObject([]CstEntry, Trivia),
}

// --- CST parser (stdlib/json/cst_parse.bit, #1723) --------------------------

struct CstParser { src: string, toks: []Token, i: int }

fn ctPeek(p: CstParser): Token {
  return p.toks[p.i]
}

fn ctAdvance(p: CstParser): Token {
  let t = p.toks[p.i]
  if (p.i < len(p.toks) - 1) {
    p.i = p.i + 1
  }
  return t
}

fn ctSlice(p: CstParser, t: Token): string {
  return p.src[t.start:t.end]
}

fn ctSameLine(src: string, startAt: int, endAt: int): bool {
  let i = startAt
  while (i < endAt) {
    if (src[i] == '\n') {
      return false
    }
    i = i + 1
  }
  return true
}

fn ctCollectLeading(p: CstParser): []string {
  let leading = []string(0)
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound && ctPeek(p).kind == TokenKind.Comment) {
    let t = ctAdvance(p)
    leading = append(leading, ctSlice(p, t))
    guard = guard + 1
  }
  return leading
}

fn ctTakeTrailing(p: CstParser, afterEnd: int): Opt<string> {
  let t = ctPeek(p)
  if (t.kind == TokenKind.Comment && ctSameLine(p.src, afterEnd, t.start)) {
    ctAdvance(p)
    return Opt<string>.Some(ctSlice(p, t))
  }
  return Opt<string>.None
}

fn ctFirstOrNone(comments: []string): Opt<string> {
  if (len(comments) > 0) {
    return Opt<string>.Some(comments[0])
  }
  return Opt<string>.None
}

fn ctBuildValue(p: CstParser, leading: []string): CstNode! {
  let t = ctPeek(p)
  if (t.kind == TokenKind.LBrace) {
    return ctParseObject(p, leading)?
  }
  if (t.kind == TokenKind.LBracket) {
    return ctParseArray(p, leading)?
  }
  if (t.kind == TokenKind.StringTok) {
    ctAdvance(p)
    decodeStringLiteral(p.src, t)?
    let trailing = ctTakeTrailing(p, t.end)
    return CstNode.CstString(ctSlice(p, t), Trivia{ leading: leading, trailing: trailing })
  }
  if (t.kind == TokenKind.NumberTok) {
    ctAdvance(p)
    let raw = ctSlice(p, t)
    if (!isValidJsonNumber(raw)) {
      fail jsonErr{ msg: "json: invalid number literal" }
    }
    let trailing = ctTakeTrailing(p, t.end)
    return CstNode.CstNumber(raw, Trivia{ leading: leading, trailing: trailing })
  }
  if (t.kind == TokenKind.TrueTok) {
    ctAdvance(p)
    return CstNode.CstBool(true, Trivia{ leading: leading, trailing: ctTakeTrailing(p, t.end) })
  }
  if (t.kind == TokenKind.FalseTok) {
    ctAdvance(p)
    return CstNode.CstBool(false, Trivia{ leading: leading, trailing: ctTakeTrailing(p, t.end) })
  }
  if (t.kind == TokenKind.NullTok) {
    ctAdvance(p)
    return CstNode.CstNull(Trivia{ leading: leading, trailing: ctTakeTrailing(p, t.end) })
  }
  if (t.kind == TokenKind.Invalid) {
    fail jsonErr{ msg: describeInvalid(p.src, t) }
  }
  fail jsonErr{ msg: "json: unexpected token, expected a value" }
}

fn ctParseValue(p: CstParser): CstNode! {
  let leading = ctCollectLeading(p)
  return ctBuildValue(p, leading)?
}

fn ctParseObject(p: CstParser, leading: []string): CstNode! {
  ctAdvance(p)
  let entries = []CstEntry(0)
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let pending = ctCollectLeading(p)
    if (ctPeek(p).kind == TokenKind.RBrace) {
      ctAdvance(p)
      return CstNode.CstObject(
        entries,
        Trivia{ leading: leading, trailing: ctFirstOrNone(pending) },
      )
    }
    let keyTok = ctPeek(p)
    if (keyTok.kind != TokenKind.StringTok) {
      fail jsonErr{ msg: "json: expected string key" }
    }
    ctAdvance(p)
    let keyText = ctSlice(p, keyTok)
    let key = decodeStringLiteral(p.src, keyTok)?
    if (ctPeek(p).kind != TokenKind.Colon) {
      fail jsonErr{ msg: "json: expected ':' after object key" }
    }
    ctAdvance(p)
    let val = ctParseValue(p)?
    entries = append(
      entries,
      CstEntry{
        keyText: keyText,
        key: key,
        trivia: Trivia{ leading: pending, trailing: Opt<string>.None },
        value: val,
      },
    )
    let nxt = ctPeek(p)
    if (nxt.kind == TokenKind.RBrace) {
      ctAdvance(p)
      return CstNode.CstObject(entries, Trivia{ leading: leading, trailing: Opt<string>.None })
    }
    if (nxt.kind != TokenKind.Comma) {
      fail jsonErr{ msg: "json: expected ',' or '}' in object" }
    }
    ctAdvance(p)
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: object nesting exceeds token bound" }
}

fn ctParseArray(p: CstParser, leading: []string): CstNode! {
  ctAdvance(p)
  let items = []CstNode(0)
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let pending = ctCollectLeading(p)
    if (ctPeek(p).kind == TokenKind.RBracket) {
      ctAdvance(p)
      return CstNode.CstArray(items, Trivia{ leading: leading, trailing: ctFirstOrNone(pending) })
    }
    let v = ctBuildValue(p, pending)?
    items = append(items, v)
    let nxt = ctPeek(p)
    if (nxt.kind == TokenKind.RBracket) {
      ctAdvance(p)
      return CstNode.CstArray(items, Trivia{ leading: leading, trailing: Opt<string>.None })
    }
    if (nxt.kind != TokenKind.Comma) {
      fail jsonErr{ msg: "json: expected ',' or ']' in array" }
    }
    ctAdvance(p)
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: array nesting exceeds token bound" }
}

fn cstParse(source: string): CstNode! {
  let p = CstParser{ src: source, toks: lexCst(source), i: 0 }
  let node = ctParseValue(p)?
  ctCollectLeading(p)
  if (ctPeek(p).kind != TokenKind.Eof) {
    fail jsonErr{ msg: "json: trailing garbage after value" }
  }
  return node
}

// --- edit layer under test (stdlib/json/edit.bit, #1725) -------------------

fn findEntryIndex(entries: []CstEntry, key: string): int {
  let idx = -1
  let i = 0
  while (i < len(entries)) {
    if (entries[i].key == key) {
      idx = i
    }
    i = i + 1
  }
  return idx
}

fn cstGet(root: CstNode, path: []string): Opt<CstNode> {
  let node = root
  let i = 0
  while (i < len(path)) {
    match (node) {
      CstObject(entries, trivia) => {
        let found = findEntryIndex(entries, path[i])
        if (found < 0) {
          return Opt<CstNode>.None
        }
        node = entries[found].value
      }
      CstNull(t) => return Opt<CstNode>.None
      CstBool(b, t) => return Opt<CstNode>.None
      CstNumber(r, t) => return Opt<CstNode>.None
      CstString(s, t) => return Opt<CstNode>.None
      CstArray(a, t) => return Opt<CstNode>.None
    }
    i = i + 1
  }
  return Opt<CstNode>.Some(node)
}

fn cstSetStringAt(node: CstNode, path: []string, idx: int, value: string): CstNode! {
  match (node) {
    CstObject(entries, trivia) => {
      let key = path[idx]
      let found = findEntryIndex(entries, key)
      if (idx == len(path) - 1) {
        if (found >= 0) {
          match (entries[found].value) {
            CstString(raw, strTrivia) => {
              entries[found].value = CstNode.CstString(jsonEscapeString(value), strTrivia)
              return node
            }
            CstNull(t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstBool(b, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstNumber(r, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstArray(a, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
            CstObject(es, t) => fail jsonErr{ msg: "json: cstSetString: key is not a string value" }
          }
        }
        let newEntry = CstEntry{
          keyText: jsonEscapeString(key),
          key: key,
          trivia: Trivia{ leading: []string(0), trailing: Opt<string>.None },
          value: CstNode.CstString(
            jsonEscapeString(value),
            Trivia{ leading: []string(0), trailing: Opt<string>.None },
          ),
        }
        return CstNode.CstObject(append(entries, newEntry), trivia)
      }
      if (found < 0) {
        fail jsonErr{ msg: "json: cstSetString: path segment does not exist" }
      }
      let updated = cstSetStringAt(entries[found].value, path, idx + 1, value)?
      entries[found].value = updated
      return node
    }
    CstNull(t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstBool(b, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstNumber(r, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstString(s, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
    CstArray(a, t) => fail jsonErr{ msg: "json: cstSetString: path segment does not resolve to an object" }
  }
}

fn cstSetString(root: CstNode, path: []string, value: string): CstNode! {
  if (len(path) == 0) {
    fail jsonErr{ msg: "json: cstSetString: path must have at least one segment" }
  }
  return cstSetStringAt(root, path, 0, value)?
}

// --- test -------------------------------------------------------------

fn main() {
  // A leading comment on "name"; cstSetString must leave it (and keyText)
  // untouched when it replaces only "name"'s value.
  let src = "{\n  // comment before name\n  \"name\": \"old\",\n  \"count\": 1\n}"

  let root = cstParse(src) catch e {
    print("parse failed: ${e.message()}\n")
    return
  }

  // New value has an embedded quote, so rawText must come back escaped.
  let root2 = cstSetString(root, []string{ "name" }, "new \"value\"") catch e {
    print("set failed: ${e.message()}\n")
    return
  }

  match (cstGet(root2, []string{ "name" })) {
    Some(node) => {
      match (node) {
        CstString(raw, t) => print("name.value.rawText=${raw}\n")
        CstNull(t) => print("name.value=wrong-null\n")
        CstBool(b, t) => print("name.value=wrong-bool\n")
        CstNumber(r, t) => print("name.value=wrong-number\n")
        CstArray(a, t) => print("name.value=wrong-array\n")
        CstObject(es, t) => print("name.value=wrong-object\n")
      }
    }
    None => print("name.value=missing\n")
  }

  match (root2) {
    CstObject(entries, trivia) => {
      print("entries.len=${len(entries)}\n")
      let nameEntry = entries[0]
      print("name.keyText=${nameEntry.keyText}\n")
      if (len(nameEntry.trivia.leading) == 1) {
        print("name.leading[0]=${nameEntry.trivia.leading[0]}\n")
      } else {
        print("name.leading.len=${len(nameEntry.trivia.leading)}\n")
      }
    }
    CstNull(t) => print("root=wrong-null\n")
    CstBool(b, t) => print("root=wrong-bool\n")
    CstNumber(r, t) => print("root=wrong-number\n")
    CstString(s, t) => print("root=wrong-string\n")
    CstArray(a, t) => print("root=wrong-array\n")
  }

  print("done\n")
}
