// run
// `for..of` over a slice: the element read must go through slice_get and the
// iterable must thread through the loop's block params (regression: it used to
// emit an array-only index_get on a stale pre-header SSA value and crash).
fn main() {
  let xs = [10, 20, 30, 40]
  let acc = 0
  for x of xs {
    acc = acc + x
  }
  print("sum=${acc} len=${len(xs)}\n")

  // grown slice, iterated after append
  let ys = [1]
  ys = append(ys, 2)
  ys = append(ys, 3)
  let prod = 1
  for y of ys {
    prod = prod * y
  }
  print("prod=${prod}\n")
}
