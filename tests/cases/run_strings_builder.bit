// run
// #2112: Builder.write/writeByte mutate the receiver in place — the natural
// statement form `b.write(s)` is a real append, not a silent no-op — and the
// old-style reassignment `b = b.write(s)` still works, since both return the
// same Builder. Also covers newBuilder().toString() == "" and writeByte with
// 0x00 and 0xFF, both #2126-required behaviour carried into this ticket.
import { newBuilder } from "std/strings"

function main() {
  let empty = newBuilder()
  println("empty=[${empty.toString()}] len=${empty.length()}")

  let b = newBuilder()
  b.write("hello")
  b.write(" world")
  println("statement-form=[${b.toString()}] len=${b.length()}")

  let c = newBuilder()
  c = c.write("chained")
  c = c.writeByte('!')
  println("reassign-form=[${c.toString()}] len=${c.length()}")

  let d = newBuilder()
  d.writeByte(0)
  d.writeByte(255)
  println("bytes len=${d.length()} first=${int(d.toString()[0])} second=${int(d.toString()[1])}")

  let e = newBuilder()
  e.write("a").write("b").write("c")
  println("fluent=[${e.toString()}]")
}
