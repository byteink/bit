// run
// stdlib/json/encode.bit's jsonEncodePretty (#1719), exercised behaviourally.
// A golden case is a single file with no prelude and cannot import std/json
// (see run_math.bit / json_value_accessors.bit), so this redeclares the same
// shapes and encoder logic locally.
//
// Covers: nested object + array, an escape-needing string, int, float, bool,
// null, an empty array and an empty object (both stay on one line, `[]`/`{}`,
// rather than exploding to three) — and a round-trip check: two
// independently built trees describing the same value must pretty-encode to
// the identical string, since there is no parser yet to decode the output
// back through.

struct JsonEntry { key: string, value: Json }

enum Json {
  JsonNull
  JsonBool(bool)
  JsonInt(i64)
  JsonFloat(f64)
  JsonString(string)
  JsonArray([]Json)
  JsonObject([]JsonEntry)
}

function repeatStr(s: string, n: i64): string {
  let out = ""
  let i = 0
  while (i < n) {
    out = out + s
    i = i + 1
  }
  return out
}

function encodeBool(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

const hexDigits: string = "0123456789abcdef"

function unicodeEscape(c: u8): string {
  let out = []byte(2)
  out[0] = hexDigits[int(c >> 4)]
  out[1] = hexDigits[int(c & 0x0f)]
  return "\\u00" + string(out)
}

function jsonEscapeString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      out = out + "\\\""
    } else if (c == '\\') {
      out = out + "\\\\"
    } else if (c == '\n') {
      out = out + "\\n"
    } else if (c == '\t') {
      out = out + "\\t"
    } else if (c == '\r') {
      out = out + "\\r"
    } else if (c == 8) {
      out = out + "\\b"
    } else if (c == 12) {
      out = out + "\\f"
    } else if (c < 32) {
      out = out + unicodeEscape(c)
    } else {
      let one = []byte(1)
      one[0] = c
      out = out + string(one)
    }
    i = i + 1
  }
  return out + "\""
}

function encodeValuePretty(j: Json, indent: string, depth: i64): string {
  match (j) {
    JsonNull => return "null"
    JsonBool(b) => return encodeBool(b)
    JsonInt(i) => return "${i}"
    JsonFloat(f) => return "${f}"
    JsonString(s) => return jsonEscapeString(s)
    JsonArray(a) => return encodeArrayPretty(a, indent, depth)
    JsonObject(o) => return encodeObjectPretty(o, indent, depth)
  }
}

function encodeArrayPretty(a: []Json, indent: string, depth: i64): string {
  if (len(a) == 0) {
    return "[]"
  }
  let inner = repeatStr(indent, depth + 1)
  let outer = repeatStr(indent, depth)
  let out = "[\n"
  let i = 0
  while (i < len(a)) {
    out = out + inner + encodeValuePretty(a[i], indent, depth + 1)
    if (i < len(a) - 1) {
      out = out + ","
    }
    out = out + "\n"
    i = i + 1
  }
  return out + outer + "]"
}

function encodeObjectPretty(o: []JsonEntry, indent: string, depth: i64): string {
  if (len(o) == 0) {
    return "{}"
  }
  let inner = repeatStr(indent, depth + 1)
  let outer = repeatStr(indent, depth)
  let out = "{\n"
  let i = 0
  while (i < len(o)) {
    out = out + inner + jsonEscapeString(o[i].key) + ": " + encodeValuePretty(o[i].value, indent, depth + 1)
    if (i < len(o) - 1) {
      out = out + ","
    }
    out = out + "\n"
    i = i + 1
  }
  return out + outer + "}"
}

// The tree under test: nested object/array, an escape-needing string, int,
// float, bool, null, an empty array, an empty object.
function buildTree(): Json {
  return Json.JsonObject([]JsonEntry{
    JsonEntry{ key: "name", value: Json.JsonString("bit\n\"lang\"\t") },
    JsonEntry{ key: "count", value: Json.JsonInt(42) },
    JsonEntry{ key: "ratio", value: Json.JsonFloat(3.5) },
    JsonEntry{ key: "ok", value: Json.JsonBool(true) },
    JsonEntry{ key: "nil", value: Json.JsonNull },
    JsonEntry{ key: "list", value: Json.JsonArray([]Json{
      Json.JsonInt(1),
      Json.JsonInt(2),
    }) },
    JsonEntry{ key: "nested", value: Json.JsonObject([]JsonEntry{
      JsonEntry{ key: "inner", value: Json.JsonBool(false) },
    }) },
    JsonEntry{ key: "emptyList", value: Json.JsonArray([]Json(0)) },
    JsonEntry{ key: "emptyObj", value: Json.JsonObject([]JsonEntry(0)) },
  })
}

function main() {
  let tree = buildTree()
  print(encodeValuePretty(tree, "  ", 0))
  print("\n")

  // Round-trip check: since #1719 lands before the parser task, there is no
  // decoder to feed the output back through. Instead, two independently
  // built trees describing the same value must pretty-encode to the
  // identical string — the closest self-check available without a parser.
  let again = buildTree()
  if (encodeValuePretty(tree, "  ", 0) == encodeValuePretty(again, "  ", 0)) {
    print("roundtrip=ok\n")
  } else {
    print("roundtrip=FAIL\n")
  }
}
