// run
// Taking a method off an interface value without calling it — `let g = a.addTo`
// — binds the receiver into a closure that dispatches through the receiver's
// vtable at each call (#1260). Before the fix this died with UnsupportedConstruct
// in lowering; only immediate `a.addTo(x)` calls worked. Covers a nullary method
// value, one with an argument, and one passed as a first-class function value so
// the dynamic dispatch is exercised through an indirect call.
interface Adder { addTo(x: i64): i64 }

struct Base { b: i64 }
function (v: Base) addTo(x: i64): i64 { return v.b + x }

struct Neg {}
function (v: Neg) addTo(x: i64): i64 { return 0 - x }

function apply(f: (i64) => i64, n: i64): i64 {
  return f(n)
}

function main() {
  let a: Adder = Base{ b: 100 }
  let g = a.addTo
  print("${g(5)}\n")
  let n: Adder = Neg{}
  let h = n.addTo
  print("${apply(h, 9)}\n")
}
