// run
// #2749: an arrow-fn literal written directly into a struct field, assigned to
// one after construction, or landing straight in a slice/array element or a
// map value builds and runs — SPEC §12.8 permits an arrow anywhere a
// function-typed value is expected. `Checker.arrowExpected` (#1487) only ever
// recorded the expectation for a `let`-annotated binding or a call argument,
// so an arrow reaching any of these other positions kept its own unannotated
// parameter typed `<error>` — visible on `--dump-types` — while `bit check`
// and `bit build` both exited 0. Lowering then compiled the arrow's body as
// if its parameter were a plain word: `"hi " + name` emitted a raw `add` over
// two string pointers instead of `rt_call string_concat`, which read or wrote
// through whatever the resulting garbage address happened to be — SIGSEGV,
// SIGBUS or `panic: out of memory` depending on what that read, and not
// reliably the same fault twice for the identical source.
struct Box { f: (string) => string }
struct Outer { inner: Box }

function main() {
  let b = Box{ f: (name) => "hi " + name }
  print("lit=${b.f("world")}\n")

  b.f = (name) => "yo " + name
  print("assign=${b.f("world")}\n")

  let nested = Outer{ inner: Box{ f: (name) => "nested " + name } }
  print("nested=${nested.inner.f("world")}\n")

  let fs = []((string) => string){ (name) => "slice " + name }
  print("slice=${fs[0]("world")}\n")

  let m = map<string, (string) => string>{ "k": (name) => "map " + name }
  print("map=${m["k"]("world")}\n")
}
