// run
// `close(c)` plus the two-result receive `let (v, ok) = <- c` (SPEC §16.2).
// Receives drain what is still buffered, then yield `(zero, false)`; a receiver
// already blocked on the channel is woken by the close. `ok` is what makes a
// *reference* element safe to receive after a close — the zero word is then a
// null pointer, so the receiver must be able to tell "closed" from "a value"
// before dereferencing it.
struct Box {
  n: i64,
}

fn closer(w: chan<i64>) {
  close(w)
}

fn main() {
  // Buffered values drain first, then the channel reports closed.
  let c = chan<i64>(2)
  c <- 7
  close(c)
  let (v1, ok1) = <- c
  let (v2, ok2) = <- c
  print("drain ${v1} ${ok1} then ${v2} ${ok2}\n")

  // A reference element: `ok` guards the null zero word.
  let b = chan<Box>(2)
  b <- Box{ n: 42 }
  close(b)
  let (r1, rok1) = <- b
  if (rok1) {
    print("ref ${r1.n}\n")
  }
  let (r2, rok2) = <- b
  print("ref closed ${rok2}\n")

  // A receiver already blocked on the channel is woken by the close.
  let w = chan<i64>(0)
  spawn closer(w)
  let (v3, ok3) = <- w
  print("woken ${v3} ${ok3}\n")

  // `_` discards the value word.
  let (_, ok4) = <- c
  print("blank ${ok4}\n")
}
