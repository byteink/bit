// run
// NEGATIVE case for #1534: every top-level `const` form the seed folds must
// still compile. E0064 is a REJECTION, so extending its reach is exactly the
// change that can start refusing valid programs, and this file is the guard
// against that — it asserts the absence of a diagnostic, which no differential
// over the corpus can do for a form the corpus does not happen to contain.
//
// It earned its place immediately. `const S = "hello"` was a FALSE POSITIVE on
// the first cut of the fix: `vConstEval` had no string arm, because until #1534
// its only caller was module-`let` state, whose untraced-type rule (§11.11)
// rejects a string long before the fold runs. Nothing in the corpus, and no
// diffcheck/diffdiags/difftypes run, saw it — only this case did.
//
// The seed's ConstVal.string carries no payload: the only question asked of a
// string here is "is it constant at all", which a bare literal always is.
//
// NOT included, because the SEED refuses them too and this file is about what
// must be ACCEPTED: float arithmetic (`1.0 / 2.0`), boolean operators
// (`true && false`), and comparisons (`1 < 2`) are all outside §15.4's folding.
//
// Single-file golden, so there is NO prelude: `print` takes a string.

const S = "hello"
const R = `raw string`
const A: int = 5
const B: bool = true
const N = -7
const E = 2 + 3 * 4
const F = A + 1
const C = 'x'
const D: f64 = 1.5
const SHIFT: i64 = 1 << 20
const PAREN = (1 + 2) * 3
export const P = 42

function main() {
  print(S)
  print("\n")
  print(R)
  print("\n")
}
