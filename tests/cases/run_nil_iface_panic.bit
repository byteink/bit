// panic
// #2240: a method call dispatched through a nil interface value must panic
// rather than reading `*(recv - 32)` as a TypeInfo pointer at address -32 and
// dying on SIGSEGV. `let o: Order` is a fully legal, checker-blessed value
// (a class's zero value is a live instance with each field zero-valued,
// SPEC §13.3) whose `pm` field is nil (SPEC §13.4) -- there is no way to
// declare an interface-typed field such that it cannot be.
interface PaymentMethod { charge(amount: i64): i64 }

class Order { pm: PaymentMethod }

fn main() {
  let o: Order
  println("start")
  println("${o.pm.charge(100)}")
}
