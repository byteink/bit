// run
// The unsigned-looking values in `.expected` are not a regeneration accident:
// `floatBits` returns a `u64`, and until #2011 interpolation rendered every
// unsigned prim through the SIGNED formatter, so the negative spellings this
// file used to pin were the bug written down. See `run_float_bitexact.bit`.
// #1456: reading a float element back out of a slice, a map or a channel.
//
// The container primitives (`bit_rt_slice_get`/`_set`, `bit_rt_map_get`/`_set`,
// `bit_rt_chan_send`/`_recv`) declare every element as an untyped `u64` WORD, so
// it travels in an INTEGER register whatever the Bit element type is. Codegen
// used to classify the operand by its Bit type instead, passing a float element
// in `d0`/`xmm0` — which the callee never reads and never writes. Lowering now
// bitcasts each float across that boundary (`ir.rtWordArgs`/`rtReturnsWord`).
//
// WHY THREE ELEMENTS AND NOT TWO: the old bug read whatever was left in the FP
// return register, so the FIRST read yielded the value of the LAST store and
// every later read yielded zero. With two elements `[a, b]` that pattern can
// print a right-looking answer by coincidence; with three distinct values it
// cannot. Every container below therefore holds at least three.
//
// WHY BIT PATTERNS AND NOT `==` (see run_float_bitexact.bit for the long form):
// `-0.0 == 0.0` is true and `NaN != NaN`, so `==` passes a broken round trip
// that loses the sign of zero and fails a correct one. `floatBits` is the only
// way to observe the stored word from Bit. `-0.0` is in the corpus for exactly
// that reason: it is the value a lossy round trip most easily turns into `+0.0`
// without changing anything a comparison can see.
//
// The `f32` half goes through `float32Bits` rather than interpolation because
// the two sides must be a 32-bit transfer (`fmov s`/`movd`), and because the
// stored word is the whole property under test.
//
// A golden case is a single file, so it has no prelude — the primitives are
// called directly.

fn main() {
  // `[]f64(n)`, written by index, read back by index.
  let xs = []f64(3)
  xs[0] = 1.0
  xs[1] = 2.0
  xs[2] = 3.0
  print("idx=${xs[0]},${xs[1]},${xs[2]}\n")
  print("idxbits=${floatBits(xs[0])},${floatBits(xs[1])},${floatBits(xs[2])}\n")

  // The sign of zero must survive the word round trip; `==` cannot see it.
  let zs = []f64(3)
  zs[0] = -0.0
  zs[1] = 0.0
  zs[2] = -0.0
  print("zerobits=${floatBits(zs[0])},${floatBits(zs[1])},${floatBits(zs[2])}\n")

  // The `append`-built form: a slice that starts empty and grows.
  let ys: []f64 = []
  ys = append(ys, 1.25)
  ys = append(ys, 2.25)
  ys = append(ys, 3.25)
  print("app=${ys[0]},${ys[1]},${ys[2]}\n")

  // `for..of` reads each element through the same `slice_get`.
  let sum = 0.0
  for v of ys {
    sum = sum + v
  }
  print("forof=${sum}\n")

  // A reslice shares the backing buffer and reads through the same primitive.
  let sl = ys[1:3]
  print("resl=${sl[0]},${sl[1]}\n")

  // `[]f32`: a 32-bit transfer on both sides.
  let fs = []f32(3)
  fs[0] = 1.5
  fs[1] = 2.5
  fs[2] = 3.5
  print("f32bits=${float32Bits(fs[0])},${float32Bits(fs[1])},${float32Bits(fs[2])}\n")

  // A float-valued map, and a float-KEYED one — the key is a word too.
  let m = map<int, f64>()
  m[1] = 1.75
  m[2] = 2.75
  m[3] = 3.75
  print("mapval=${m[1]},${m[2]},${m[3]}\n")
  let km = map<f64, int>()
  km[1.5] = 10
  km[2.5] = 20
  km[3.5] = 30
  print("mapkey=${km[1.5]},${km[2.5]},${km[3.5]}\n")

  // A buffered channel: `chan_send` takes a word, `chan_recv` returns one.
  let c = chan<f64>(4)
  c <- 1.5
  c <- 2.5
  c <- 3.5
  print("chan=${<- c},${<- c},${<- c}\n")
}
