// run
// Byte indexing on a string (§12.2): `s[i]` is the `u8` byte at position `i`,
// and `len(s)` is the byte count. Indexing drives a loop here to count the
// uppercase letters (bytes 65..90) and echo the raw bytes.
function main() {
  let s = "Bit"
  print("len=${len(s)}\n")
  print("bytes=${s[0]},${s[1]},${s[2]}\n")

  let uppers = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c >= 65 && c <= 90) {
      uppers = uppers + 1
    }
    i = i + 1
  }
  print("uppers=${uppers}\n")
}
