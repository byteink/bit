// run
// Fixed-size arrays are value types (SPEC §11.2/§13.3): copied on assignment,
// argument passing, and return. Mutating a copy never disturbs the original.

// The callee receives its own copy; its mutation is invisible to the caller.
function bump(x: [2]u32): u32 {
  x[0] = x[0] + u32(100)
  return x[0]
}

// A returned array is an independent copy of the local.
function make(): [3]u32 {
  let v: [3]u32
  v[0] = u32(7)
  v[1] = u32(8)
  v[2] = u32(9)
  return v
}

function main() {
  // Assignment copies: mutating `b` leaves `a` untouched.
  let a: [2]u32
  a[0] = u32(1)
  let b = a
  b[0] = u32(9)
  print("assign=${a[0]} ${b[0]}\n")

  // Pass by copy: the caller's `a` is unchanged after `bump`.
  let inside = bump(a)
  print("arg=${inside} ${a[0]}\n")

  // Return by copy: two calls yield independent arrays.
  let m = make()
  let n = make()
  n[0] = u32(0)
  print("ret=${m[0]} ${m[1]} ${m[2]} ${n[0]}\n")
}
