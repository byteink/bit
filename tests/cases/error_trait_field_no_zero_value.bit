// error
// SPEC §10.7/§13.4, #3370: a trait field whose type is a class inherits the
// same no-zero-value rule a hand-written class-typed field already has
// (E0083) — it may not be omitted from a composite literal. This is
// entirely reused machinery: `vMissingStructFields` (validatezero.bit) walks
// `structFieldNodes`, which sees the injected field exactly like a
// declared one, so nothing in this file's rejection is trait-specific.
class Inner {
  n: i64,
}

trait Holds {
  x: Inner
}

class Container {
  use Holds
}

fn main() {
  let c = Container{}
  print("${c.x.n}\n")
}
