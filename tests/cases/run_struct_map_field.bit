// run
// A map as a struct field (parses because `>` closes the generic and ASI
// terminates the line); build it, read it back through the field.
struct Counts {
  label: string
  by: map<string, int>
}

fn main() {
  let c = Counts{ label: "hits", by: map<string, int>{} }
  c.by["a"] = 1
  c.by["b"] = 2
  c.by["a"] = c.by["a"] + 10
  print("${c.label} ${c.by["a"]} ${c.by["b"]} ${len(c.by)}\n")
}
