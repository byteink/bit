// run
// The other two halves of #1898, kept apart from the interface case so a
// failure names which conversion form broke.
//
// A type alias in call position (`MyInt(5)`) and a struct in call position
// where the argument is already that struct (`Point(p)`, the identity). Both
// typechecked and then died at codegen with "cannot lower 1 function(s)".
type MyInt = int
type Celsius = i64

struct Point {
  x: i64
  y: i64
}

fn sum(p: Point): i64 {
  return p.x + p.y
}

fn main() {
  // Alias conversion of a literal.
  let a = MyInt(5)
  print("${a}\n")

  // Alias conversion of an expression, so it is not folded from a literal.
  let n = 20
  let b = MyInt(n + 2)
  print("${b}\n")

  // A second alias over a sized integer type, to catch a fix that only handles
  // aliases of `int`.
  let c = Celsius(37)
  print("${c}\n")

  // Struct conversion — the identity, since the argument is already a Point.
  let p = Point{x: 3, y: 4}
  let q = Point(p)
  print("${sum(q)}\n")

  // Structs are reference types, so the conversion must not copy: mutating
  // through the converted binding must be visible through the original. This
  // is the assertion an identity-conversion fix could plausibly get wrong.
  q.x = 10
  print("${p.x}\n")
}
