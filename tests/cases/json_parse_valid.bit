// run
// stdlib/json/parse.bit's strict recursive-descent parser (#1479's json
// epic, #1721), exercised behaviourally: round-trips a representative
// document through jsonParse then jsonEncode (#1719) and reads every field
// back out through the jsonGet/jsonAsX accessors (#1717). A golden case is a
// single file with no prelude and cannot import std/json (see run_math.bit /
// json_lex_basic.bit / json_encode_compact.bit / json_value_accessors.bit),
// so this redeclares the lexer, value type, parser, and compact encoder
// locally.
//
// Covers: nested object + array, a string needing quote/backslash/newline/
// tab escapes, a `\u` escape (non-ASCII BMP codepoint) and a `\u` surrogate
// pair (astral codepoint), an int, an integral literal too wide for `i64`
// (falls back to `JsonFloat`), a float, true/false, and null.

struct jsonErr { msg: string }
function (e: jsonErr) message(): string { return e.msg }

enum Opt<T> { Some(T), None }

// --- lexer (stdlib/json/lex.bit) ------------------------------------------

enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
}

struct Token { kind: TokenKind, start: int, end: int }

const jsonMaxDepth = 64

struct Lexer { src: string, i: int, depth: int }

function isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

function isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

function emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

function scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

function scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

function scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

function scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

function scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

function scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

function lex(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

// --- value type (stdlib/json/value.bit) -----------------------------------

struct JsonEntry { key: string, value: Json }

enum Json {
  JsonNull
  JsonBool(bool)
  JsonInt(i64)
  JsonFloat(f64)
  JsonString(string)
  JsonArray([]Json)
  JsonObject([]JsonEntry)
}

function jsonIsNull(j: Json): bool {
  match (j) {
    JsonNull => return true
    JsonBool(b) => return false
    JsonInt(i) => return false
    JsonFloat(f) => return false
    JsonString(s) => return false
    JsonArray(a) => return false
    JsonObject(o) => return false
  }
}

function jsonAsBool(j: Json): Opt<bool> {
  match (j) {
    JsonBool(b) => return Opt<bool>.Some(b)
    JsonNull => return Opt<bool>.None
    JsonInt(i) => return Opt<bool>.None
    JsonFloat(f) => return Opt<bool>.None
    JsonString(s) => return Opt<bool>.None
    JsonArray(a) => return Opt<bool>.None
    JsonObject(o) => return Opt<bool>.None
  }
}

function jsonAsInt(j: Json): Opt<i64> {
  match (j) {
    JsonInt(i) => return Opt<i64>.Some(i)
    JsonNull => return Opt<i64>.None
    JsonBool(b) => return Opt<i64>.None
    JsonFloat(f) => return Opt<i64>.None
    JsonString(s) => return Opt<i64>.None
    JsonArray(a) => return Opt<i64>.None
    JsonObject(o) => return Opt<i64>.None
  }
}

function jsonAsFloat(j: Json): Opt<f64> {
  match (j) {
    JsonFloat(f) => return Opt<f64>.Some(f)
    JsonNull => return Opt<f64>.None
    JsonBool(b) => return Opt<f64>.None
    JsonInt(i) => return Opt<f64>.None
    JsonString(s) => return Opt<f64>.None
    JsonArray(a) => return Opt<f64>.None
    JsonObject(o) => return Opt<f64>.None
  }
}

function jsonAsString(j: Json): Opt<string> {
  match (j) {
    JsonString(s) => return Opt<string>.Some(s)
    JsonNull => return Opt<string>.None
    JsonBool(b) => return Opt<string>.None
    JsonInt(i) => return Opt<string>.None
    JsonFloat(f) => return Opt<string>.None
    JsonArray(a) => return Opt<string>.None
    JsonObject(o) => return Opt<string>.None
  }
}

function jsonAsArray(j: Json): Opt<[]Json> {
  match (j) {
    JsonArray(a) => return Opt<[]Json>.Some(a)
    JsonNull => return Opt<[]Json>.None
    JsonBool(b) => return Opt<[]Json>.None
    JsonInt(i) => return Opt<[]Json>.None
    JsonFloat(f) => return Opt<[]Json>.None
    JsonString(s) => return Opt<[]Json>.None
    JsonObject(o) => return Opt<[]Json>.None
  }
}

function jsonGet(o: Json, key: string): Opt<Json> {
  match (o) {
    JsonObject(entries) => {
      let found = Opt<Json>.None
      for e of entries {
        if (e.key == key) {
          found = Opt<Json>.Some(e.value)
        }
      }
      return found
    }
    JsonNull => return Opt<Json>.None
    JsonBool(b) => return Opt<Json>.None
    JsonInt(i) => return Opt<Json>.None
    JsonFloat(f) => return Opt<Json>.None
    JsonString(s) => return Opt<Json>.None
    JsonArray(a) => return Opt<Json>.None
  }
}

// --- parser (stdlib/json/parse.bit) ---------------------------------------

struct Parser { src: string, toks: []Token, i: int }

function peek(p: Parser): Token {
  return p.toks[p.i]
}

function advance(p: Parser): Token {
  let t = p.toks[p.i]
  if (p.i < len(p.toks) - 1) {
    p.i = p.i + 1
  }
  return t
}

function describeInvalid(src: string, t: Token): string {
  let c = src[t.start]
  if (c == '{' || c == '[') {
    return "json: max nesting depth exceeded"
  }
  if (c == '"') {
    return "json: unterminated string"
  }
  return "json: unexpected character in input"
}

function isValidJsonNumber(s: string): bool {
  let n = len(s)
  let i = 0
  if (i >= n) {
    return false
  }
  if (s[i] == '-') {
    i = i + 1
  }
  if (i >= n) {
    return false
  }
  if (s[i] == '0') {
    i = i + 1
  } else if (s[i] >= '1' && s[i] <= '9') {
    i = i + 1
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  } else {
    return false
  }
  if (i < n && s[i] == '.') {
    i = i + 1
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  if (i < n && (s[i] == 'e' || s[i] == 'E')) {
    i = i + 1
    if (i < n && (s[i] == '+' || s[i] == '-')) {
      i = i + 1
    }
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  return i == n
}

function looksIntegral(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] == '.' || s[i] == 'e' || s[i] == 'E') {
      return false
    }
    i = i + 1
  }
  return true
}

function parseIntLocal(s: string): i64! {
  if (len(s) == 0) {
    fail jsonErr{ msg: "empty" }
  }
  let i = 0
  let neg = false
  if (s[0] == '-') {
    neg = true
    i = 1
  }
  if (i >= len(s)) {
    fail jsonErr{ msg: "no digits" }
  }
  let maxDiv10 = 922337203685477580
  let maxMod10 = 7
  let v = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail jsonErr{ msg: "invalid digit" }
    }
    let d = i64(c - '0')
    if (v > maxDiv10 || (v == maxDiv10 && d > maxMod10)) {
      fail jsonErr{ msg: "out of range" }
    }
    v = v * 10 + d
    i = i + 1
  }
  if (neg) {
    return 0 - v
  }
  return v
}

function decodeNumber(src: string, t: Token): Json! {
  let text = src[t.start:t.end]
  if (!isValidJsonNumber(text)) {
    fail jsonErr{ msg: "json: invalid number literal" }
  }
  if (looksIntegral(text)) {
    let iv = parseIntLocal(text) catch e {
      return Json.JsonFloat(parseFloat(text))
    }
    return Json.JsonInt(iv)
  }
  return Json.JsonFloat(parseFloat(text))
}

function hexDigitVal(c: u8): i64! {
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return i64(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return i64(c - 'A') + 10
  }
  fail jsonErr{ msg: "invalid hex" }
}

function decodeHex4(src: string, i: int): i64! {
  let v = i64(0)
  let k = 0
  while (k < 4) {
    let d = hexDigitVal(src[i + k])?
    v = v * 16 + d
    k = k + 1
  }
  return v
}

function byteToStr(c: u8): string {
  let out = []byte(1)
  out[0] = c
  return string(out)
}

function writeUtf8(cp: i64): string {
  if (cp < 0x80) {
    return byteToStr(u8(cp))
  }
  if (cp < 0x800) {
    return byteToStr(u8(0xC0 | (cp >> 6))) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  if (cp < 0x10000) {
    return byteToStr(u8(0xE0 | (cp >> 12))) + byteToStr(
      u8(0x80 | ((cp >> 6) & 0x3F)),
    ) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  return byteToStr(u8(0xF0 | (cp >> 18))) + byteToStr(
    u8(0x80 | ((cp >> 12) & 0x3F)),
  ) + byteToStr(u8(0x80 | ((cp >> 6) & 0x3F))) + byteToStr(u8(0x80 | (cp & 0x3F)))
}

function decodeStringLiteral(src: string, t: Token): string! {
  let i = t.start + 1
  let end = t.end - 1
  let out = ""
  while (i < end) {
    let c = src[i]
    if (c < 32) {
      fail jsonErr{ msg: "control character in string" }
    }
    if (c != '\\') {
      out = out + byteToStr(c)
      i = i + 1
      continue
    }
    if (i + 1 >= end) {
      fail jsonErr{ msg: "unterminated escape" }
    }
    let e = src[i + 1]
    if (e == '"') {
      out = out + "\""
      i = i + 2
    } else if (e == '\\') {
      out = out + "\\"
      i = i + 2
    } else if (e == '/') {
      out = out + "/"
      i = i + 2
    } else if (e == 'b') {
      out = out + byteToStr(8)
      i = i + 2
    } else if (e == 'f') {
      out = out + byteToStr(12)
      i = i + 2
    } else if (e == 'n') {
      out = out + "\n"
      i = i + 2
    } else if (e == 'r') {
      out = out + "\r"
      i = i + 2
    } else if (e == 't') {
      out = out + "\t"
      i = i + 2
    } else if (e == 'u') {
      if (i + 6 > end) {
        fail jsonErr{ msg: "invalid \\u escape" }
      }
      let cp = decodeHex4(src, i + 2)?
      i = i + 6
      if (cp >= 0xD800 && cp <= 0xDBFF) {
        if (i + 6 > end || src[i] != '\\' || src[i + 1] != 'u') {
          fail jsonErr{ msg: "unpaired surrogate" }
        }
        let lo = decodeHex4(src, i + 2)?
        if (lo < 0xDC00 || lo > 0xDFFF) {
          fail jsonErr{ msg: "invalid low surrogate" }
        }
        i = i + 6
        let combined = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
        out = out + writeUtf8(combined)
      } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
        fail jsonErr{ msg: "unpaired surrogate" }
      } else {
        out = out + writeUtf8(cp)
      }
    } else {
      fail jsonErr{ msg: "invalid escape character" }
    }
  }
  return out
}

function parseValue(p: Parser): Json! {
  let t = peek(p)
  if (t.kind == TokenKind.LBrace) {
    return parseObject(p)?
  }
  if (t.kind == TokenKind.LBracket) {
    return parseArray(p)?
  }
  if (t.kind == TokenKind.StringTok) {
    advance(p)
    return Json.JsonString(decodeStringLiteral(p.src, t)?)
  }
  if (t.kind == TokenKind.NumberTok) {
    advance(p)
    return decodeNumber(p.src, t)?
  }
  if (t.kind == TokenKind.TrueTok) {
    advance(p)
    return Json.JsonBool(true)
  }
  if (t.kind == TokenKind.FalseTok) {
    advance(p)
    return Json.JsonBool(false)
  }
  if (t.kind == TokenKind.NullTok) {
    advance(p)
    return Json.JsonNull
  }
  if (t.kind == TokenKind.Invalid) {
    fail jsonErr{ msg: describeInvalid(p.src, t) }
  }
  fail jsonErr{ msg: "json: unexpected token, expected a value" }
}

function parseObject(p: Parser): Json! {
  advance(p)
  let entries = []JsonEntry(0)
  if (peek(p).kind == TokenKind.RBrace) {
    advance(p)
    return Json.JsonObject(entries)
  }
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let keyTok = peek(p)
    if (keyTok.kind != TokenKind.StringTok) {
      fail jsonErr{ msg: "json: expected string key" }
    }
    advance(p)
    let key = decodeStringLiteral(p.src, keyTok)?
    if (peek(p).kind != TokenKind.Colon) {
      fail jsonErr{ msg: "json: expected ':' after object key" }
    }
    advance(p)
    let val = parseValue(p)?
    entries = append(entries, JsonEntry{ key: key, value: val })
    let nxt = peek(p)
    if (nxt.kind == TokenKind.RBrace) {
      advance(p)
      return Json.JsonObject(entries)
    }
    if (nxt.kind != TokenKind.Comma) {
      fail jsonErr{ msg: "json: expected ',' or '}' in object" }
    }
    advance(p)
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: object nesting exceeds token bound" }
}

function parseArray(p: Parser): Json! {
  advance(p)
  let items = []Json(0)
  if (peek(p).kind == TokenKind.RBracket) {
    advance(p)
    return Json.JsonArray(items)
  }
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let v = parseValue(p)?
    items = append(items, v)
    let nxt = peek(p)
    if (nxt.kind == TokenKind.RBracket) {
      advance(p)
      return Json.JsonArray(items)
    }
    if (nxt.kind != TokenKind.Comma) {
      fail jsonErr{ msg: "json: expected ',' or ']' in array" }
    }
    advance(p)
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: array nesting exceeds token bound" }
}

function jsonParse(source: string): Json! {
  let p = Parser{ src: source, toks: lex(source), i: 0 }
  let v = parseValue(p)?
  if (peek(p).kind != TokenKind.Eof) {
    fail jsonErr{ msg: "json: trailing garbage after value" }
  }
  return v
}

// --- compact encoder (stdlib/json/encode.bit) -----------------------------

function encodeBool(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

const hexDigits: string = "0123456789abcdef"

function unicodeEscape(c: u8): string {
  let out = []byte(2)
  out[0] = hexDigits[int(c >> 4)]
  out[1] = hexDigits[int(c & 0x0f)]
  return "\\u00" + string(out)
}

function jsonEscapeString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      out = out + "\\\""
    } else if (c == '\\') {
      out = out + "\\\\"
    } else if (c == '\n') {
      out = out + "\\n"
    } else if (c == '\t') {
      out = out + "\\t"
    } else if (c == '\r') {
      out = out + "\\r"
    } else if (c == 8) {
      out = out + "\\b"
    } else if (c == 12) {
      out = out + "\\f"
    } else if (c < 32) {
      out = out + unicodeEscape(c)
    } else {
      out = out + byteToStr(c)
    }
    i = i + 1
  }
  return out + "\""
}

function encodeValue(j: Json): string {
  match (j) {
    JsonNull => return "null"
    JsonBool(b) => return encodeBool(b)
    JsonInt(i) => return "${i}"
    JsonFloat(f) => return "${f}"
    JsonString(s) => return jsonEscapeString(s)
    JsonArray(a) => return encodeArray(a)
    JsonObject(o) => return encodeObject(o)
  }
}

function encodeArray(a: []Json): string {
  let out = "["
  let i = 0
  while (i < len(a)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + encodeValue(a[i])
    i = i + 1
  }
  return out + "]"
}

function encodeObject(o: []JsonEntry): string {
  let out = "{"
  let i = 0
  while (i < len(o)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + jsonEscapeString(o[i].key) + ":" + encodeValue(o[i].value)
    i = i + 1
  }
  return out + "}"
}

function jsonEncode(j: Json): string {
  return encodeValue(j)
}

// --- test ------------------------------------------------------------------

function main() {
  let src = "{\"name\": \"bit \\\"lang\\\"\", \"esc\": \"line1\\nline2\\ttab\", \"accent\": \"\\u00e9\", \"emoji\": \"\\ud83d\\ude00\", \"count\": 42, \"big\": 100000000000000000000, \"ratio\": 2.5, \"ok\": true, \"nope\": false, \"nil\": null, \"list\": [1, 2, 3], \"nested\": {\"inner\": true}}"

  let parsed = jsonParse(src) catch e {
    print("parse failed: ${e.message()}\n")
    return
  }

  match (jsonGet(parsed, "name")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("name=${s}\n")
        None => print("name=wrong-type\n")
      }
    }
    None => print("name=missing\n")
  }

  match (jsonGet(parsed, "esc")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("esc=${s}\n")
        None => print("esc=wrong-type\n")
      }
    }
    None => print("esc=missing\n")
  }

  match (jsonGet(parsed, "accent")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("accent=${s}\n")
        None => print("accent=wrong-type\n")
      }
    }
    None => print("accent=missing\n")
  }

  match (jsonGet(parsed, "emoji")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("emoji=${s}\n")
        None => print("emoji=wrong-type\n")
      }
    }
    None => print("emoji=missing\n")
  }

  match (jsonGet(parsed, "count")) {
    Some(v) => {
      match (jsonAsInt(v)) {
        Some(i) => print("count=${i}\n")
        None => print("count=wrong-type\n")
      }
    }
    None => print("count=missing\n")
  }

  match (jsonGet(parsed, "big")) {
    Some(v) => {
      match (jsonAsFloat(v)) {
        Some(f) => print("big=${f}\n")
        None => print("big=wrong-type\n")
      }
    }
    None => print("big=missing\n")
  }

  match (jsonGet(parsed, "ratio")) {
    Some(v) => {
      match (jsonAsFloat(v)) {
        Some(f) => print("ratio=${f}\n")
        None => print("ratio=wrong-type\n")
      }
    }
    None => print("ratio=missing\n")
  }

  match (jsonGet(parsed, "ok")) {
    Some(v) => {
      match (jsonAsBool(v)) {
        Some(b) => print("ok=${b}\n")
        None => print("ok=wrong-type\n")
      }
    }
    None => print("ok=missing\n")
  }

  match (jsonGet(parsed, "nope")) {
    Some(v) => {
      match (jsonAsBool(v)) {
        Some(b) => print("nope=${b}\n")
        None => print("nope=wrong-type\n")
      }
    }
    None => print("nope=missing\n")
  }

  match (jsonGet(parsed, "nil")) {
    Some(v) => print("nil=${jsonIsNull(v)}\n")
    None => print("nil=missing\n")
  }

  match (jsonGet(parsed, "list")) {
    Some(v) => {
      match (jsonAsArray(v)) {
        Some(items) => {
          print("list_len=${len(items)}\n")
          match (jsonAsInt(items[0])) {
            Some(i) => print("list0=${i}\n")
            None => print("list0=wrong-type\n")
          }
          match (jsonAsInt(items[1])) {
            Some(i) => print("list1=${i}\n")
            None => print("list1=wrong-type\n")
          }
          match (jsonAsInt(items[2])) {
            Some(i) => print("list2=${i}\n")
            None => print("list2=wrong-type\n")
          }
        }
        None => print("list=wrong-type\n")
      }
    }
    None => print("list=missing\n")
  }

  match (jsonGet(parsed, "nested")) {
    Some(v) => {
      match (jsonGet(v, "inner")) {
        Some(inner) => {
          match (jsonAsBool(inner)) {
            Some(b) => print("nested_inner=${b}\n")
            None => print("nested_inner=wrong-type\n")
          }
        }
        None => print("nested_inner=missing\n")
      }
    }
    None => print("nested=missing\n")
  }

  print(jsonEncode(parsed))
  print("\n")
}
