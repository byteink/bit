// run
// stdlib/json/lex.bit's flat JSON lexer (#1479's json epic, #1718),
// exercised behaviourally. A golden case is a single file with no prelude and
// cannot import std/json (see run_math.bit), so this redeclares the same
// lexer locally — the same trade tests/cases/json_value_accessors.bit
// already makes for stdlib/json/value.bit.
//
// Covers: the full token stream for a nested object/array/string/number/bool/
// null literal (kind + raw span per token, including a `StringTok` span that
// keeps its surrounding quotes and an internal `\"` escape unprocessed), and
// a `NumberTok`'s raw span round-tripping a literal byte-for-byte.

// The lexical categories a JSON token can be.
enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
}

// One lexical token: its kind and its `[start, end)` byte span in the source.
struct Token {
  kind: TokenKind,
  start: int,
  end: int,
}

// Combined `{`/`[` nesting limit: the open that would create the 65th level
// is rejected as `Invalid` instead of tracked.
const jsonMaxDepth = 64

struct Lexer {
  src: string,
  i: int,
  depth: int,
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

// Advances the cursor by `n` and returns the token `[start, start+n)`.
fn emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

// `{`/`[`: enforces `jsonMaxDepth`, returning `Invalid` (without opening a new
// level) once the counter already sits at the cap.
fn scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

// `}`/`]`: pops one level; never goes negative on an unmatched closer.
fn scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

// A `"`-delimited string span, quotes included, escapes left raw. A `\`
// always protects the byte after it from ending the string (so an escaped
// quote does not close it); an unterminated string consumes to EOF and
// reports `Invalid` rather than looping past the source.
fn scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

// A JSON number span (RFC 8259 §6: optional `-`, integer part, optional `.`
// fraction, optional `e`/`E` exponent) captured verbatim.
fn scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

// `true`/`false`/`null`, or `Invalid` for any other lowercase run.
fn scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

// Skips JSON whitespace (RFC 8259 §2) and dispatches one token, or `Eof`.
fn scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

// The full token stream for `source`, ending with one `Eof`.
fn lex(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

fn kindName(k: TokenKind): string {
  if (k == TokenKind.LBrace) { return "LBrace" }
  if (k == TokenKind.RBrace) { return "RBrace" }
  if (k == TokenKind.LBracket) { return "LBracket" }
  if (k == TokenKind.RBracket) { return "RBracket" }
  if (k == TokenKind.Colon) { return "Colon" }
  if (k == TokenKind.Comma) { return "Comma" }
  if (k == TokenKind.StringTok) { return "StringTok" }
  if (k == TokenKind.NumberTok) { return "NumberTok" }
  if (k == TokenKind.TrueTok) { return "TrueTok" }
  if (k == TokenKind.FalseTok) { return "FalseTok" }
  if (k == TokenKind.NullTok) { return "NullTok" }
  if (k == TokenKind.Eof) { return "Eof" }
  return "Invalid"
}

fn main() {
  // {"a": [1, 2.5, true, false, null, "x\"y"]}
  let src = "{\"a\": [1, 2.5, true, false, null, \"x\\\"y\"]}"
  let toks = lex(src)
  for t of toks {
    print(kindName(t.kind) + ":" + src[t.start:t.end] + "\n")
  }

  // Raw span round-trip: an untouched number literal must slice back
  // byte-for-byte, so a CST layer can echo it unchanged.
  let numSrc = "1.50000"
  let numToks = lex(numSrc)
  if (numSrc[numToks[0].start:numToks[0].end] == numSrc) {
    print("roundtrip=ok\n")
  } else {
    print("roundtrip=FAIL\n")
  }
}
