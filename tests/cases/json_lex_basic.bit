// run
// stdlib/json/lex.bit's flat JSON lexer (#1479's json epic, #1718),
// exercised behaviourally.
//
// Covers: the full token stream for a nested object/array/string/number/bool/
// null literal (kind + raw span per token, including a `StringTok` span that
// keeps its surrounding quotes and an internal `\"` escape unprocessed), and
// a `NumberTok`'s raw span round-tripping a literal byte-for-byte.
//
// Used to redeclare `lex`, `TokenKind` and `Token` locally on the stated
// belief that "a golden case is single-file with no prelude and cannot
// import std/json". That belief is false (#2421): `tests/bit/golden.bit`'s
// `checkRun` runs `bit build <case>` with `BIT_STDLIB` exported, so the
// import below resolves exactly as it would for any other caller, and this
// now actually exercises the module instead of a frozen copy of it.
import { TokenKind, Token, lex } from "std/json"

fn kindName(k: TokenKind): string {
  if (k == TokenKind.LBrace) { return "LBrace" }
  if (k == TokenKind.RBrace) { return "RBrace" }
  if (k == TokenKind.LBracket) { return "LBracket" }
  if (k == TokenKind.RBracket) { return "RBracket" }
  if (k == TokenKind.Colon) { return "Colon" }
  if (k == TokenKind.Comma) { return "Comma" }
  if (k == TokenKind.StringTok) { return "StringTok" }
  if (k == TokenKind.NumberTok) { return "NumberTok" }
  if (k == TokenKind.TrueTok) { return "TrueTok" }
  if (k == TokenKind.FalseTok) { return "FalseTok" }
  if (k == TokenKind.NullTok) { return "NullTok" }
  if (k == TokenKind.Eof) { return "Eof" }
  return "Invalid"
}

fn main() {
  // {"a": [1, 2.5, true, false, null, "x\"y"]}
  let src = "{\"a\": [1, 2.5, true, false, null, \"x\\\"y\"]}"
  let toks = lex(src)
  for t of toks {
    print(kindName(t.kind) + ":" + src[t.start:t.end] + "\n")
  }

  // Raw span round-trip: an untouched number literal must slice back
  // byte-for-byte, so a CST layer can echo it unchanged.
  let numSrc = "1.50000"
  let numToks = lex(numSrc)
  if (numSrc[numToks[0].start:numToks[0].end] == numSrc) {
    print("roundtrip=ok\n")
  } else {
    print("roundtrip=FAIL\n")
  }
}
