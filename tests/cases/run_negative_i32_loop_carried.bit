// run
// #1708: a negative narrow-signed (i32) loop-carried variable compared
// wrong at a while-loop header. Constant folding (opt.zig) zero-extended a
// folded negative narrow result instead of sign-extending it, so `-5: i32`
// was stored width-canonical as `4294967291` (its unsigned bit pattern) —
// the header's signed `<=` then read it as huge and positive, and the loop
// never ran. Pinned expected values: k starts at -5, crosses 20 after two
// +25 steps (-5 -> 20 -> 45), so the loop runs exactly twice.
fn main() {
  let k: i32 = -5
  let m = 0
  while (k <= 20) {
    m = m + 1
    k = k + 25
  }
  print("iters2=${m} final2=${k}\n")
}
