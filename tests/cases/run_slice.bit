// run
function sum(xs: []i64): i64 {
  let total = 0
  let i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    i = i + 1
  }
  return total
}

function main() {
  let xs = [10, 20, 30]
  xs = append(xs, 40)
  xs = append(xs, 50)
  xs[0] = 99
  print("len=${len(xs)} cap=${cap(xs)} sum=${sum(xs)} first=${xs[0]}\n")

  let ws = []string{"a", "bb"}
  ws = append(ws, "ccc")
  let i = 0
  while (i < len(ws)) {
    if (i > 0) {
      print(" ")
    }
    print(ws[i])
    i = i + 1
  }
  print("\n")

  let empty = []i64{}
  print("empty=${len(empty)}\n")
}
