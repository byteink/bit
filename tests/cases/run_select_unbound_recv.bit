// run
// Regression for #1693: an UNBOUND receive `case <- ch:` (SPEC.md §16.3 makes
// recv_bind's binder optional) must lower without a compiler panic, and must
// still pick the ready case.
fn main() {
  let a = chan<i64>(1)
  a <- 7
  select {
    case <- a:
      print("fired\n")
    default:
      print("idle\n")
  }
  let b = chan<i64>(1)
  select {
    case <- b:
      print("unexpected\n")
    default:
      print("empty\n")
  }
  let c = chan<i64>(1)
  let d = chan<i64>(1)
  d <- 1
  select {
    case <- c:
      print("c\n")
    case <- d:
      print("d\n")
  }
}
