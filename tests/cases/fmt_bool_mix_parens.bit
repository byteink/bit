// fmt
// #2356: a `&&` group nested in a `||` (or vice versa) keeps its
// clarifying parens even though precedence makes them unnecessary --
// the printer's boolean-mix style rule, same shape as the existing
// bitwise/shift rule. A comparison leaf next to `||` (no `&&` on both
// sides of the mix) stays bare either way; a redundant OUTER wrap still
// collapses down to whatever the inner rule actually needs.
fn isDefaultPort(https: bool, port: int): bool {
  return (!https && port == 80) || (https && port == 443)
}

fn dataIndependent(typ: int, pass: int, slice: int): bool {
  return typ == 1 || typ == 2 && pass == 0 && slice < 2
}

fn redundantOuterWrap(a: bool, b: bool, c: bool): bool {
  return ((a && b) || c)
}
