// run
// stdlib/json/parse.bit's JSONC extension (#1479's json epic, #1722) is
// narrow and explicit — NOT JSON5. This covers one of JSON5's leniencies
// that stays explicitly out of scope: an unquoted object key. A golden case
// is a single file with no prelude and cannot import std/json (see
// json_parse_errors.bit), so this redeclares the lexer, value type, and
// parser locally.
//
// Directive note: this is a runtime fallible-return error (bad JSON *data*
// passed to `jsoncParse`), not a compile-time diagnostic on this file's own
// Bit source — the source below is valid Bit and compiles cleanly. Per
// `tests/bit/golden.bit`, `// error` means "compilation must fail"; the case for
// "this fallible function returns an error" is `// run` + `catch`, exactly
// how the sibling case json_parse_errors.bit (#1721) covers jsonParse's
// error paths. If this panicked instead of returning an error, this
// `// run` case (which requires a clean exit) would fail the build.
//
// Covers: `{a: 1}` — `a` lexes as a bare word (not `true`/`false`/`null`, so
// `Invalid`), and the parser only ever accepts a `StringTok` for an object
// key, so this is rejected regardless of what shape the bad key takes.

struct jsonErr { msg: string }
fn (e: jsonErr) message(): string { return e.msg }

// --- lexer (stdlib/json/lex.bit) ------------------------------------------

enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
}

struct Token { kind: TokenKind, start: int, end: int }

const jsonMaxDepth = 64

struct Lexer { src: string, i: int, depth: int }

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

fn emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

fn scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

fn scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

fn scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

fn scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

fn scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

fn scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

fn lex(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

// --- value type (stdlib/json/value.bit) -----------------------------------

struct JsonEntry { key: string, value: Json }

enum Json {
  JsonNull
  JsonBool(bool)
  JsonInt(i64)
  JsonFloat(f64)
  JsonString(string)
  JsonArray([]Json)
  JsonObject([]JsonEntry)
}

// --- parser (stdlib/json/parse.bit, JSONC trailing-comma extension) -------

struct Parser { src: string, toks: []Token, i: int }

fn peek(p: Parser): Token {
  return p.toks[p.i]
}

fn advance(p: Parser): Token {
  let t = p.toks[p.i]
  if (p.i < len(p.toks) - 1) {
    p.i = p.i + 1
  }
  return t
}

fn describeInvalid(src: string, t: Token): string {
  let c = src[t.start]
  if (c == '{' || c == '[') {
    return "json: max nesting depth exceeded"
  }
  if (c == '"') {
    return "json: unterminated string"
  }
  return "json: unexpected character in input"
}

fn isValidJsonNumber(s: string): bool {
  let n = len(s)
  let i = 0
  if (i >= n) {
    return false
  }
  if (s[i] == '-') {
    i = i + 1
  }
  if (i >= n) {
    return false
  }
  if (s[i] == '0') {
    i = i + 1
  } else if (s[i] >= '1' && s[i] <= '9') {
    i = i + 1
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  } else {
    return false
  }
  if (i < n && s[i] == '.') {
    i = i + 1
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  if (i < n && (s[i] == 'e' || s[i] == 'E')) {
    i = i + 1
    if (i < n && (s[i] == '+' || s[i] == '-')) {
      i = i + 1
    }
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  return i == n
}

fn looksIntegral(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] == '.' || s[i] == 'e' || s[i] == 'E') {
      return false
    }
    i = i + 1
  }
  return true
}

fn parseIntLocal(s: string): i64! {
  if (len(s) == 0) {
    fail jsonErr{ msg: "empty" }
  }
  let i = 0
  let neg = false
  if (s[0] == '-') {
    neg = true
    i = 1
  }
  if (i >= len(s)) {
    fail jsonErr{ msg: "no digits" }
  }
  let maxDiv10 = 922337203685477580
  let maxMod10 = 7
  let v = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail jsonErr{ msg: "invalid digit" }
    }
    let d = i64(c - '0')
    if (v > maxDiv10 || (v == maxDiv10 && d > maxMod10)) {
      fail jsonErr{ msg: "out of range" }
    }
    v = v * 10 + d
    i = i + 1
  }
  if (neg) {
    return 0 - v
  }
  return v
}

fn decodeNumber(src: string, t: Token): Json! {
  let text = src[t.start:t.end]
  if (!isValidJsonNumber(text)) {
    fail jsonErr{ msg: "json: invalid number literal" }
  }
  if (looksIntegral(text)) {
    let iv = parseIntLocal(text) catch e {
      return Json.JsonFloat(parseFloat(text))
    }
    return Json.JsonInt(iv)
  }
  return Json.JsonFloat(parseFloat(text))
}

fn hexDigitVal(c: u8): i64! {
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return i64(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return i64(c - 'A') + 10
  }
  fail jsonErr{ msg: "invalid hex" }
}

fn decodeHex4(src: string, i: int): i64! {
  let v = i64(0)
  let k = 0
  while (k < 4) {
    let d = hexDigitVal(src[i + k])?
    v = v * 16 + d
    k = k + 1
  }
  return v
}

fn byteToStr(c: u8): string {
  let out = []byte(1)
  out[0] = c
  return string(out)
}

fn writeUtf8(cp: i64): string {
  if (cp < 0x80) {
    return byteToStr(u8(cp))
  }
  if (cp < 0x800) {
    return byteToStr(u8(0xC0 | (cp >> 6))) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  if (cp < 0x10000) {
    return byteToStr(u8(0xE0 | (cp >> 12))) + byteToStr(
      u8(0x80 | ((cp >> 6) & 0x3F)),
    ) + byteToStr(u8(0x80 | (cp & 0x3F)))
  }
  return byteToStr(u8(0xF0 | (cp >> 18))) + byteToStr(
    u8(0x80 | ((cp >> 12) & 0x3F)),
  ) + byteToStr(u8(0x80 | ((cp >> 6) & 0x3F))) + byteToStr(u8(0x80 | (cp & 0x3F)))
}

fn decodeStringLiteral(src: string, t: Token): string! {
  let i = t.start + 1
  let end = t.end - 1
  let out = ""
  while (i < end) {
    let c = src[i]
    if (c < 32) {
      fail jsonErr{ msg: "control character in string" }
    }
    if (c != '\\') {
      out = out + byteToStr(c)
      i = i + 1
      continue
    }
    if (i + 1 >= end) {
      fail jsonErr{ msg: "unterminated escape" }
    }
    let e = src[i + 1]
    if (e == '"') {
      out = out + "\""
      i = i + 2
    } else if (e == '\\') {
      out = out + "\\"
      i = i + 2
    } else if (e == '/') {
      out = out + "/"
      i = i + 2
    } else if (e == 'b') {
      out = out + byteToStr(8)
      i = i + 2
    } else if (e == 'f') {
      out = out + byteToStr(12)
      i = i + 2
    } else if (e == 'n') {
      out = out + "\n"
      i = i + 2
    } else if (e == 'r') {
      out = out + "\r"
      i = i + 2
    } else if (e == 't') {
      out = out + "\t"
      i = i + 2
    } else if (e == 'u') {
      if (i + 6 > end) {
        fail jsonErr{ msg: "invalid \\u escape" }
      }
      let cp = decodeHex4(src, i + 2)?
      i = i + 6
      if (cp >= 0xD800 && cp <= 0xDBFF) {
        if (i + 6 > end || src[i] != '\\' || src[i + 1] != 'u') {
          fail jsonErr{ msg: "unpaired surrogate" }
        }
        let lo = decodeHex4(src, i + 2)?
        if (lo < 0xDC00 || lo > 0xDFFF) {
          fail jsonErr{ msg: "invalid low surrogate" }
        }
        i = i + 6
        let combined = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
        out = out + writeUtf8(combined)
      } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
        fail jsonErr{ msg: "unpaired surrogate" }
      } else {
        out = out + writeUtf8(cp)
      }
    } else {
      fail jsonErr{ msg: "invalid escape character" }
    }
  }
  return out
}

fn parseValue(p: Parser): Json! {
  let t = peek(p)
  if (t.kind == TokenKind.LBrace) {
    return parseObject(p)?
  }
  if (t.kind == TokenKind.LBracket) {
    return parseArray(p)?
  }
  if (t.kind == TokenKind.StringTok) {
    advance(p)
    return Json.JsonString(decodeStringLiteral(p.src, t)?)
  }
  if (t.kind == TokenKind.NumberTok) {
    advance(p)
    return decodeNumber(p.src, t)?
  }
  if (t.kind == TokenKind.TrueTok) {
    advance(p)
    return Json.JsonBool(true)
  }
  if (t.kind == TokenKind.FalseTok) {
    advance(p)
    return Json.JsonBool(false)
  }
  if (t.kind == TokenKind.NullTok) {
    advance(p)
    return Json.JsonNull
  }
  if (t.kind == TokenKind.Invalid) {
    fail jsonErr{ msg: describeInvalid(p.src, t) }
  }
  fail jsonErr{ msg: "json: unexpected token, expected a value" }
}

fn parseObject(p: Parser): Json! {
  advance(p)
  let entries = []JsonEntry(0)
  if (peek(p).kind == TokenKind.RBrace) {
    advance(p)
    return Json.JsonObject(entries)
  }
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let keyTok = peek(p)
    if (keyTok.kind != TokenKind.StringTok) {
      fail jsonErr{ msg: "json: expected string key" }
    }
    advance(p)
    let key = decodeStringLiteral(p.src, keyTok)?
    if (peek(p).kind != TokenKind.Colon) {
      fail jsonErr{ msg: "json: expected ':' after object key" }
    }
    advance(p)
    let val = parseValue(p)?
    entries = append(entries, JsonEntry{ key: key, value: val })
    let nxt = peek(p)
    if (nxt.kind == TokenKind.RBrace) {
      advance(p)
      return Json.JsonObject(entries)
    }
    if (nxt.kind != TokenKind.Comma) {
      fail jsonErr{ msg: "json: expected ',' or '}' in object" }
    }
    advance(p)
    if (peek(p).kind == TokenKind.RBrace) {
      advance(p)
      return Json.JsonObject(entries)
    }
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: object nesting exceeds token bound" }
}

fn parseArray(p: Parser): Json! {
  advance(p)
  let items = []Json(0)
  if (peek(p).kind == TokenKind.RBracket) {
    advance(p)
    return Json.JsonArray(items)
  }
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let v = parseValue(p)?
    items = append(items, v)
    let nxt = peek(p)
    if (nxt.kind == TokenKind.RBracket) {
      advance(p)
      return Json.JsonArray(items)
    }
    if (nxt.kind != TokenKind.Comma) {
      fail jsonErr{ msg: "json: expected ',' or ']' in array" }
    }
    advance(p)
    if (peek(p).kind == TokenKind.RBracket) {
      advance(p)
      return Json.JsonArray(items)
    }
    guard = guard + 1
  }
  fail jsonErr{ msg: "json: array nesting exceeds token bound" }
}

fn jsoncParse(source: string): Json! {
  let p = Parser{ src: source, toks: lex(source), i: 0 }
  let v = parseValue(p)?
  if (peek(p).kind != TokenKind.Eof) {
    fail jsonErr{ msg: "json: trailing garbage after value" }
  }
  return v
}

// --- test --------------------------------------------------------------

fn main() {
  let r = jsoncParse("{a: 1}") catch e {
    print("unquoted_key=${e.message()}\n")
    Json.JsonNull
  }

  print("done\n")
}
