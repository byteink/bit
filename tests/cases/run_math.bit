// run
// The float primitives (ABI.md §17), called directly — a golden case is a
// single file, so it has no prelude and cannot import std/math.
//
// Regression guard for the AArch64 mapping-symbol bug: `log`/`log2`/`log10` are
// table-driven, and a mis-atomized `.rodata` literal pool made them return
// garbage while leaving table-free fast paths (log2 of an exact power of two)
// correct. Values here deliberately miss those fast paths.
fn main() {
  let e: f64 = 2.718281828459045
  let k: f64 = 1000.0

  print("sqrt=${fsqrt(9.0)} pow=${fpow(2.0, 10.0)}\n")
  print("floor=${ffloor(2.7)} ceil=${fceil(2.1)} round=${fround(2.5)} trunc=${ftrunc(-2.7)}\n")
  print("log2_8=${flog2(8.0)} log2_1000=${flog2(k)}\n")
  print("log10_1000=${flog10(k)} log10_100=${flog10(100.0)}\n")
  print("log_e=${flog(e)} log_1=${flog(1.0)}\n")
  print("atan2=${fatan2(1.0, 1.0)} sqrt2=${fsqrt(2.0)}\n")
}
