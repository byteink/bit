// error
// #2103 narrows E0067 for VOID-fallible catches only (SPEC §11 line 750: a
// bare `()` is a valid type only in result position, so no expression can
// produce it). A `T!E` catch block that falls through via a plain
// assignment — the same statement shape the sibling ACCEPT case
// check_catch_unit_falls_through.bit legitimately uses to fall through when
// T is `()` — must still be rejected: the block has a real `i64` value to
// produce, and an assignment produces none.
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally.
struct myErr { code: i64 }
fn (e: myErr) message(): string { return "code=${e.code}" }
fn g(): i64! { fail myErr{ code: 1 } }
fn f(): i64 {
  let msg = "x"
  return g() catch e {
    msg = e.message()
  }
}
fn main() {
  print("f=${f()}\n")
}
