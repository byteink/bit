// error
// #1534: E0064 for a top-level `const` whose initializer is not a compile-time
// constant. The seed raises this from two places in checkBinding — the module
// `let` path AND the `is_const and is_top` path — and only the `let` arm was
// ported (validateunmanaged.bit's message is the `let` wording). A top-level
// `const` bound to a call was therefore accepted in silence.
//
// The two messages differ by one word, `let` vs `const`, and the differentials
// byte-compare the diagnostic stream, so the const wording has to be exact.
//
// E0064 lands at the INITIALIZER's span and comes after the binding's type and
// assignability verdicts (SPEC.md §14.8, post-order). `pick()` is well-typed on
// purpose: the only thing wrong with it is that it cannot be folded, so this
// case cannot pass by accident on the back of some other diagnostic.
//
// Single-file golden, so there is NO prelude: `print` takes a string.

function pick(): int {
  return 7
}

const c = pick()

function main() {
  print("x\n")
}
