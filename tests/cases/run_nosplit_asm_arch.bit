// run
// SPEC 10.3.1 / 11.6 (#1659): the shape the runtime uses to obtain its host
// `BuildTarget` ordinal from inside poll-free code, now that
// check_nosplit_host_target.bit pins `hostTarget()` as refused there.
//
// `archOrd` is `runtime/root/linux/os.bit`'s `rtHostTarget` verbatim — the same
// two immediates — and `isArm` stands in for `fs.bit`'s `isX64`: a `@nosplit`
// caller reaching a `@nosplit` callee whose whole body is an `asm` block. That
// nesting is the part under test; §10.3.1 admits `asm` inside `@nosplit`, and
// E0075 is transitive, so both links have to hold for this to compile at all.
//
// SELF-CHECKING ACROSS ALL THREE TARGETS rather than printing the ordinal,
// which differs per target and would make this case unrunnable on two of them.
// `hostTarget()` is the independent oracle (`seed/main.zig`'s `host_target`),
// and the mapping it is checked against is `compiler/build.bit`'s `BuildTarget`:
//
//     0 x86_64-linux   1 aarch64-linux   2 aarch64-macos
//
// so "not 0" means aarch64 on every recognised target. A flipped arch mapping
// in the `asm` — the silent failure mode, since both immediates assemble fine —
// makes this print MISMATCH. The x86_64/aarch64 axis is the only one an `asm`
// block can decide; the OS axis is decided by which provider directory the
// runtime file sits in, which is why `../darwin/os.bit` needs no `asm` at all.
@nosplit function archOrd(): int {
  return asm {
    arm64 { 0xD2800020 }                    // movz x0, #1  -> aarch64
    x64   { 0xB8, 0x00, 0x00, 0x00, 0x00 }  // mov  eax, 0  -> x86_64
    result arm64 x0 x64 rax : int
  }
}

@nosplit function isArm(): bool {
  return archOrd() == 1
}

function main() {
  let expectArm = hostTarget() != 0
  if (isArm() != expectArm) {
    print("MISMATCH\n")
    return
  }
  print("ok\n")
}
