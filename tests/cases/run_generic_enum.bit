// run
// Generic enums (§14.7): one declaration, monomorphized per instantiation.
// `Opt<i64>` (bare-tag-free — a boxed sum type) and `Opt<string>` (a GC-traced
// string payload) share the `Opt<T>` template; `Res<i64,string>` carries a
// different type on each side. Type arguments come from the expected type
// (the function results below) or are inferred from the argument (`Opt.Some(9)`).
enum Opt<T> {
  Some(T)
  None
}

enum Res<T, E> {
  Ok(T)
  Err(E)
}

function firstEven(xs: []i64): Opt<i64> {
  for x of xs {
    if (x % 2 == 0) {
      return Opt.Some(x)
    }
  }
  return Opt.None
}

function tag(name: string): Opt<string> {
  if (len(name) == 0) {
    return Opt.None
  }
  return Opt.Some("<" + name + ">")
}

function div(a: i64, b: i64): Res<i64, string> {
  if (b == 0) {
    return Res.Err("zero")
  }
  return Res.Ok(a / b)
}

function main() {
  match (firstEven([3, 5, 8, 10])) {
    Some(v) => print("even ${v}\n")
    None    => print("no even\n")
  }
  match (firstEven([1, 3, 5])) {
    Some(v) => print("even ${v}\n")
    None    => print("no even\n")
  }
  match (Opt.Some(9)) {
    Some(v) => print("some ${v}\n")
    None    => print("none\n")
  }
  match (tag("bit")) {
    Some(s) => print("${s}\n")
    None    => print("empty\n")
  }
  match (div(20, 4)) {
    Ok(q)  => print("${q}\n")
    Err(m) => print("err ${m}\n")
  }
  match (div(1, 0)) {
    Ok(q)  => print("${q}\n")
    Err(m) => print("err ${m}\n")
  }
}
