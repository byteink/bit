// run
// #3622: dead-allocation elimination (compiler/optalloc.bit) deletes a
// `gc_alloc` whose result nothing reads. Every function here is a shape where
// the allocation IS read, so it must SURVIVE — this case goes red the moment
// the pass's escape rule is loosened.
//
// A `// run` case and not an `// ir` one, for the reason
// run_field_forward_aliasing.bit already gives: an IR golden pins whatever the
// optimizer happens to emit today and goes stale the moment a later pass
// improves it, whereas an over-eager deletion here corrupts a printed answer,
// and a wrong answer cannot go stale. ir_tuple_layout.expected pins the other
// direction — that the genuinely removable boxes really are removed.
//
// MUTATION-PROVEN, not assumed. Two targeted breaks of `countEscapingUses`
// were built and run, and both compiled and self-hosted cleanly:
//   - stop counting the VALUE half of a `field_set` as an escape:
//     nestedReachOnly -> 0 and capturedCell -> 2, instead of 42.
//   - treat a `field_get` as transparent: readAfterAlloc -> 0.
// Seven of ten probe programs still printed the RIGHT answer under the first
// mutation and nine of ten under the second, which is exactly why these four
// shapes are pinned one function at a time instead of being left to the
// corpus at large to notice.
class Inner {
  v: i64,
}

class Outer {
  i: Inner,
}

fn build(n: i64): Outer {
  return Outer{ i: Inner{ v: n } }
}

fn show(o: Outer): i64 {
  return o.i.v
}

// The Inner object is reachable ONLY through Outer's field: apart from its own
// store, its single mention is being the value half of `field_set outer[0]`.
// The loop back edge carries Outer, so neither object may be dropped.
fn nestedReachOnly(): i64 {
  let o = build(21)
  let s = 0
  let k = 0
  while (k < 2) {
    s = s + show(o)
    k = k + 1
  }
  return s
}

// A second allocation sits between the store and the load, and `gc_alloc` is a
// barrier for store-to-load forwarding (compiler/optstore.bit's rule 3), so
// this `field_get` is a real load and the object behind it must live.
fn readAfterAlloc(): i64 {
  let a = Inner{ v: 42 }
  let b = Inner{ v: 1 }
  return a.v * b.v
}

// A captured local that the body writes is a heap cell (#2128). The closure
// environment holds it, so the cell escapes through a `field_set` into the env
// and the read must see the WRITTEN value, not a zero.
fn capturedCell(): i64 {
  let c = Inner{ v: 20 }
  let get = () => c.v + 2
  c.v = 40
  return get()
}

fn pair(x: i64): (i64, i64) {
  return x, x + 1
}

// The removable case, kept here so the two directions sit side by side: this
// tuple IS deleted, and deleting it must not change the answer.
fn deadTuple(): i64 {
  let (a, b) = pair(20)
  return a + b + 1
}

fn main() {
  print("nestedReachOnly ${nestedReachOnly()}\n")
  print("readAfterAlloc ${readAfterAlloc()}\n")
  print("capturedCell ${capturedCell()}\n")
  print("deadTuple ${deadTuple()}\n")
}
