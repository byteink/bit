// run
// #2179: std/http Response.setHeader/addHeader/getHeader — the only doors
// besides raw string concatenation for setting a response header, each
// validating a value for CR, LF and NUL and a name for a non-token byte
// (RFC 9110 §5, §5.6.2) before serializeResponse splices `headers` into the
// wire response unexamined. Pins: setHeader replacing a header set twice,
// addHeader appending (the Set-Cookie case), getHeader reading either, the
// exact #2169-style reproduction (a bare LF carrying a second header) over a
// REAL served connection so the assertion is on bytes that actually reached
// the wire, and three more one-byte-at-a-time attempts (bare CR, NUL, and a
// control byte in the field NAME) checked directly against the header block
// serializeResponse splices verbatim — the same bytes, no transformation
// between the two.
import { serve, Server, Exchange, Response, ok, header } from "std/http"
import { dial } from "std/net"
import { indexOf, contains } from "std/strings"

fn countOccurrences(hay: string, needle: string): int {
  let count = 0
  let i = 0
  while (len(needle) > 0 && i <= len(hay) - len(needle)) {
    if (hay[i:i + len(needle)] == needle) {
      count = count + 1
      i = i + len(needle)
    } else {
      i = i + 1
    }
  }
  return count
}

fn statusOf(raw: string): string {
  let eol = indexOf(raw, "\r\n")
  if (eol < 0) {
    return raw
  }
  return raw[0:eol]
}

fn dispatch(ex: Exchange) {
  let req = ex.read() catch e {
    return
  }
  let res = ok("hi")
  res.setHeader("X-Request-Id", "legit\nSet-Cookie: admin=1") catch e {
    print("liveSetHeaderRejected=1\n")
  }
  ex.respond(res) catch e {
    return
  }
}

fn serveOne(s: Server, ready: chan<int>): ()! {
  ready <- 0
  let ex = s.accept()?
  dispatch(ex)
  s.close()
}

fn main() {
  // Live round trip: the exact #2169-style reproduction, over a real
  // connection, checked against the bytes actually served.
  let s = serve("127.0.0.1", 0) catch e {
    print("serveFailed\n")
    return
  }
  let port = s.port() catch e {
    print("portFailed\n")
    return
  }
  let ready = chan<int>(1)
  spawn serveOne(s, ready)
  let started = <- ready
  let c = dial("127.0.0.1", port) catch e {
    print("dialFailed\n")
    return
  }
  c.write("GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n") catch e {
    print("writeFailed\n")
    return
  }
  let wire = c.readAll()
  c.close()
  print("liveStatus=${statusOf(wire)}\n")
  print("liveHasSetCookie=${contains(wire, "Set-Cookie")}\n")

  // setHeader replaces: two calls to the same name leave exactly one line.
  let r1 = ok("hi")
  r1.setHeader("X-A", "1") catch e { print("r1setErr1\n") }
  r1.setHeader("X-A", "2") catch e { print("r1setErr2\n") }
  print("setHeaderReplaceCount=${countOccurrences(r1.headers, "X-A:")}\n")
  print("setHeaderReplaceValue=${r1.getHeader("X-A")}\n")

  // addHeader appends: two calls to Set-Cookie leave two lines.
  let r2 = ok("hi")
  r2.addHeader("Set-Cookie", "a=1") catch e { print("r2addErr1\n") }
  r2.addHeader("Set-Cookie", "b=2") catch e { print("r2addErr2\n") }
  print("addHeaderCount=${countOccurrences(r2.headers, "Set-Cookie:")}\n")

  // Bare CR in a value: rejected, or dropped from the header block.
  let r3 = ok("hi")
  let crFailed = false
  r3.setHeader("X-Request-Id", "legit\rSet-Cookie: admin=1") catch e { crFailed = true }
  print("crRejectedOrDropped=${crFailed || !contains(r3.headers, "Set-Cookie")}\n")

  // NUL in a value: rejected, or dropped from the header block.
  let r4 = ok("hi")
  let nulFailed = false
  r4.setHeader("X-Request-Id", "legit\0Set-Cookie: admin=1") catch e { nulFailed = true }
  print("nulRejectedOrDropped=${nulFailed || !contains(r4.headers, "Set-Cookie")}\n")

  // A control byte in the NAME: rejected outright, no header line written.
  let r5 = ok("hi")
  let nameFailed = false
  r5.setHeader("X-A\r\nX-B", "1") catch e { nameFailed = true }
  print("badNameRejected=${nameFailed}\n")
  print("badNameAbsent=${!contains(r5.headers, "X-B:")}\n")
}
