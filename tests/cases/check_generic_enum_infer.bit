// error
// A generic enum's type arguments must be inferable: a bare `None` carries no
// argument to solve `T`, and there is no annotated target here, so the compiler
// cannot pick an instantiation (§14.7). Annotate the binding to fix it.
enum Opt<T> {
  Some(T)
  None
}

fn main() {
  let x = Opt.None
}
