// run
// #2276: std/strings had no way to ask "is this actually well-formed UTF-8?"
// runeCount/runes launder malformed bytes into U+FFFD and keep going, so a
// validator built on top of them cannot tell malformed input apart from
// input that genuinely contains the replacement character — most sharply
// for overlong encodings, where a byte-level check and a rune-level check
// can disagree about what a filter should reject (the classic overlong-UTF-8
// filter bypass: C0 AF decodes to ASCII '/' if accepted). isValidUtf8 closes
// that gap by running the same decoder to completion and reporting false on
// the first byte it must reject, rather than substituting and continuing.
//
// Five ways a byte sequence can be malformed, each covered below: a bad
// continuation-byte shape, the three overlong minimums (2/3/4-byte forms),
// the surrogate block (U+D800-U+DFFF), the U+10FFFF ceiling, and truncation
// at end-of-input.
import { isValidUtf8 } from "std/strings"

fn main() {
  // Well-formed: ASCII, a 2-byte rune, empty, and the maximum scalar value.
  assert(isValidUtf8("hello"), "plain ASCII must be valid")
  assert(isValidUtf8("h\u{e9}llo"), "a well-formed 2-byte rune must be valid")
  assert(isValidUtf8(""), "the empty string must be valid")
  assert(isValidUtf8("\u{10FFFF}"), "the maximum scalar value must be valid")

  // Malformed: not a UTF-8 lead/continuation byte at all.
  assert(!isValidUtf8("\xff\xfe"), "0xFF/0xFE are never valid UTF-8 bytes")
  assert(!isValidUtf8("\x80"), "a lone continuation byte must be rejected")

  // Malformed: truncated multi-byte sequence (bad continuation-byte shape:
  // fewer bytes remain than the lead byte's length claims).
  assert(!isValidUtf8("\xe2\x82"), "a truncated 3-byte sequence must be rejected")

  // Malformed: overlong encoding. C0 AF is the textbook filter-bypass case —
  // a rune-level reader that trusted this would see ASCII '/' (U+002F).
  assert(!isValidUtf8("\xc0\xaf"), "an overlong encoding of '/' must be rejected")

  // Malformed: an encoded surrogate half (U+D800-U+DFFF is not a scalar value).
  assert(!isValidUtf8("\xed\xa0\x80"), "an encoded surrogate half must be rejected")

  // Malformed: above the U+10FFFF ceiling.
  assert(!isValidUtf8("\xf5\x8f\xbf\xbf"), "a value above U+10FFFF must be rejected")

  println("ok")
}
