// run
// A fixed-size array filled and read back through a dynamically-indexed loop —
// index addressing is `base + i*elem_width` into the inline block.
function main() {
  let sq: [8]u32
  let i = 0
  while (i < 8) {
    sq[i] = u32(i * i)
    i = i + 1
  }
  let sum: u32 = 0
  i = 0
  while (i < 8) {
    sum = sum + sq[i]
    i = i + 1
  }
  print("sum=${sum} first=${sq[0]} last=${sq[7]}\n")
}
