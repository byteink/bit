// run
// Sibling of defer_loop_early_return.bit (#2078): the exit from inside the
// loop is `?` propagation in a `T!` function rather than a `return`. Same
// "IR verification failed" refusal before the fix — `?`'s propagation path
// replays the deferred call exactly like `return` does (lowerTryExpr).
struct P { n: int }
struct tooBig { }
fn (e: tooBig) message(): string { return "too big" }

fn pop(p: P) { p.n = p.n - 1 }

fn maybeBig(p: P): int! {
  if (p.n > 2) { fail tooBig{} }
  return p.n
}

fn f(p: P): int! {
  defer pop(p)
  while (true) {
    let v = maybeBig(p)?
    p.n = p.n + 1
  }
  return 0
}

fn main() {
  let p = P{ n: 5 }
  let r = f(p) catch e { print("caught: ${e.message()}\n"); -1 }
  print("${r}\n")
}
