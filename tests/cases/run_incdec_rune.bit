// run
// Positive control for #2556/#2557's `++`/`--` numeric-operand check
// (E0053): `rune` is one of the three concrete numeric prims the check
// admits (`vPrimIsInt` in compiler/checkexpr.bit), but no existing
// `run_incdec_*` case exercises it — `run_incdec_float.bit` covers f32/f64,
// `run_incdec_field.bit`/`run_incdec_index.bit`/`run_incdec_map.bit`/
// `run_generic_slice_incdec_ok.bit` all only ever touch `int`. Plain `int`
// and an unannotated ("untyped") int local are already covered
// incidentally: every `for (let i = 0; …; i++)` loop in the corpus
// increments an unannotated int local. This case adds the one concrete
// numeric prim nothing else in the corpus exercises.
fn main() {
  let r = 'a'
  r++
  print("rune_inc=${r}\n")

  let s = 'z'
  s--
  print("rune_dec=${s}\n")
}
