// error
// The atomic builtins (§11.5) take a `*T` pointer as their first argument, at
// minimum. `vAtomicCall` (compiler/validateunmanaged.bit) already rejects a
// call with zero arguments, but `lowerAtomic` (compiler/lowerprim.bit) used to
// read argument 0 unconditionally: `bit check`/`build`/`run` never reach it
// empty, but `--dump-ir`/`--dump-ir-pre` lower checker-rejected input
// regardless (#3756/#3755's family), so a bare `atomicLoad()`/`atomicStore()`
// panicked "index out of range" there instead of declining (#3759). One guard
// covers the whole family — every atomic name shares the same unguarded
// `args[0]` read, so both are exercised here rather than just one.
let counter: i64 = 0

fn main() {
  let bad = atomicLoad()
  atomicStore()

  // Legal form this rule must leave silent.
  let a = atomicLoad(ptrOf(counter))
}
