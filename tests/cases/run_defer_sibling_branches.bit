// run
// #2280: a `defer` in a branch that did NOT run must not run. Deferred calls
// were replayed by TEXTUAL position — `runDefers` emitted the whole pending
// list at every exit — so taking the second of two guarded branches ran both
// branches' deferred calls, and the count scaled with the branch INDEX. The
// shape this breaks is the one `defer` exists for: one cleanup per guarded
// route, `lock(); defer unlock(); return`, which double-unlocked and hung.
struct C {
  n: int,
}
fn (c: C) bump() {
  c.n = c.n + 1
}

// Two sibling guards, each returning inside its own branch.
fn h(c: C, which: int) {
  if (which == 1) {
    defer c.bump()
    return
  }
  if (which == 2) {
    defer c.bump()
    return
  }
}

// Three of them: taking branch 3 used to run three deferred calls.
fn h3(c: C, which: int) {
  if (which == 1) {
    defer c.bump()
    return
  }
  if (which == 2) {
    defer c.bump()
    return
  }
  if (which == 3) {
    defer c.bump()
    return
  }
}

// A branch defer nested under an unconditional one: dropping the branch's must
// not disturb the LIFO order of what remains.
fn branchOrder(which: int) {
  defer print("outer\n")
  if (which == 1) {
    defer print("inner\n")
    return
  }
  print("fell through\n")
}

// The same guard one loop deeper: the deferred call runs once for the iteration
// that returned, and not at all when no iteration matched.
fn firstMatch(c: C, n: int) {
  for (let i = 0; i < 3; i++) {
    if (i == n) {
      defer c.bump()
      return
    }
  }
}

fn main() {
  let a = C{ n: 0 }
  h(a, 1)
  print("took branch 1 -> ${a.n} deferred calls (want 1)\n")
  let b = C{ n: 0 }
  h(b, 2)
  print("took branch 2 -> ${b.n} deferred calls (want 1)\n")

  let x = C{ n: 0 }
  h3(x, 1)
  let y = C{ n: 0 }
  h3(y, 2)
  let z = C{ n: 0 }
  h3(z, 3)
  print("three siblings -> ${x.n} ${y.n} ${z.n} (want 1 1 1)\n")

  branchOrder(1)
  branchOrder(2)

  let l = C{ n: 0 }
  firstMatch(l, 2)
  let m = C{ n: 0 }
  firstMatch(m, 9)
  print("in a loop -> ${l.n} ${m.n} (want 1 0)\n")
}
