// run
// #3164: the optimizer's algebraic-identity rules (compiler/optfold.bit's
// `foldIdentities`). Before it, `analyzeConsts` folded a binary op only when
// BOTH operands were known, so `x + 0` survived to codegen as a materialized
// zero plus a real `add`.
//
// THE SHAPE OF THIS TEST IS A DIFFERENTIAL, not a table of expected numbers.
// Every row computes the same value twice: once with a LITERAL operand, which
// the folder rewrites, and once with the identical value routed through
// `op*()`, which it cannot. Those helpers have two blocks, and `inlineEligible`
// only inlines single-block callees, so the second column is always the
// unoptimized arithmetic. A rule that is wrong for some operand therefore
// prints MISMATCH rather than agreeing with a hand-written expectation that was
// derived from the same wrong rule.
//
// The operands are chosen to be the ones an identity can be wrong on: a
// negative value, i64 MIN (every overflow rule turns on it), and narrow signed
// and unsigned types, where a folded constant must come back sign-extended for
// `i32` and zero-extended for `u32`/`u8` (#1708's `canon` rule) and where
// "all ones" is `-1`, `4294967295` and `255` for the same bit pattern.
//
// The literal operands are written BARE (`x & -1`, not `x & i32(-1)`): the
// checker types a bare literal as the narrow type directly, whereas an explicit
// conversion lowers to `const_int i64` plus a `convert`, and a constant
// `convert` is not folded. Written the second way, the narrow rows below would
// pass while exercising nothing.
fn op64(v: int): int {
  if (v == 4611686018427387904) {
    return v - 1
  }
  return v
}

fn op32(v: i32): i32 {
  if (v == 1073741824) {
    return v - 1
  }
  return v
}

fn opU32(v: u32): u32 {
  if (v == 3221225472) {
    return v - 1
  }
  return v
}

fn opU8(v: u8): u8 {
  if (v == 200) {
    return v - 1
  }
  return v
}

fn i64Min(): int {
  // The literal -9223372036854775808 would parse its magnitude as a positive
  // i64 first, which overflows.
  return -9223372036854775807 - 1
}

fn show(name: string, folded: int, opaque: int) {
  let tag = "ok"
  if (folded != opaque) {
    tag = "MISMATCH"
  }
  print("${name} ${folded} ${opaque} ${tag}\n")
}

fn main() {
  let x = op64(-7)
  let z = op64(0)
  let one = op64(1)
  let ones = op64(-1)
  let three = op64(3)

  show("add-r0", x + 0, x + z)
  show("add-l0", 0 + x, z + x)
  show("sub-r0", x - 0, x - z)
  show("mul-r1", x * 1, x * one)
  show("mul-l1", 1 * x, one * x)
  show("mul-r0", x * 0, x * z)
  show("mul-l0", 0 * x, z * x)
  show("and-r-1", x & -1, x & ones)
  show("and-l-1", -1 & x, ones & x)
  show("and-r0", x & 0, x & z)
  show("and-l0", 0 & x, z & x)
  show("or-r0", x | 0, x | z)
  show("or-l0", 0 | x, z | x)
  show("or-r-1", x | -1, x | ones)
  show("or-l-1", -1 | x, ones | x)
  show("xor-r0", x ^ 0, x ^ z)
  show("xor-l0", 0 ^ x, z ^ x)
  show("shl-r0", x << 0, x << z)
  show("ashr-r0", x >> 0, x >> z)
  show("shl-l0", 0 << 3, z << three)
  show("ashr-l0", 0 >> 3, z >> three)
  // §13.5 takes a shift count modulo the operand width, so 64 on an i64 is as
  // much a no-op as 0 — and folding it as one must agree with the hardware.
  show("shl-r64", x << 64, x << op64(64))
  show("ashr-r64", x >> 64, x >> op64(64))

  // i64 MIN.
  let m = op64(i64Min())
  show("min-add0", m + 0, m + z)
  show("min-sub0", m - 0, m - z)
  show("min-mul1", m * 1, m * one)
  show("min-mul0", m * 0, m * z)
  show("min-and-1", m & -1, m & ones)
  show("min-or0", m | 0, m | z)
  show("min-xor0", m ^ 0, m ^ z)
  show("min-shl0", m << 0, m << z)
  show("min-ashr0", m >> 0, m >> z)

  // i32: a negative value and i32 MIN. The folded constant must sign-extend.
  let n = op32(-7)
  let nMin = op32(-2147483647 - 1)
  show("i32-add0", int(n + 0), int(n + op32(0)))
  show("i32-sub0", int(n - 0), int(n - op32(0)))
  show("i32-mul1", int(n * 1), int(n * op32(1)))
  show("i32-mul0", int(n * 0), int(n * op32(0)))
  show("i32-and-1", int(n & -1), int(n & op32(-1)))
  show("i32-or-1", int(n | -1), int(n | op32(-1)))
  show("i32-xor0", int(n ^ 0), int(n ^ op32(0)))
  show("i32-shl0", int(n << 0), int(n << op32(0)))
  show("i32-ashr0", int(n >> 0), int(n >> op32(0)))
  show("i32min-mul1", int(nMin * 1), int(nMin * op32(1)))
  show("i32min-and-1", int(nMin & -1), int(nMin & op32(-1)))

  // u32: all ones is 4294967295, `>>` is logical, and the folded constant must
  // zero-extend.
  let u = opU32(4294967289)
  show("u32-add0", int(u + 0), int(u + opU32(0)))
  show("u32-mul1", int(u * 1), int(u * opU32(1)))
  show("u32-mul0", int(u * 0), int(u * opU32(0)))
  show("u32-and-1", int(u & 4294967295), int(u & opU32(4294967295)))
  show("u32-and0", int(u & 0), int(u & opU32(0)))
  show("u32-or-1", int(u | 4294967295), int(u | opU32(4294967295)))
  show("u32-or0", int(u | 0), int(u | opU32(0)))
  show("u32-lshr0", int(u >> 0), int(u >> opU32(0)))
  show("u32-shl0", int(u << 0), int(u << opU32(0)))

  // u8: the narrowest width, where an all-ones mask written as 255 must not be
  // read as -1 and a folded zero must not sign-extend.
  let b = opU8(249)
  show("u8-add0", int(b + 0), int(b + opU8(0)))
  show("u8-and-1", int(b & 255), int(b & opU8(255)))
  show("u8-or-1", int(b | 255), int(b | opU8(255)))
  show("u8-mul0", int(b * 0), int(b * opU8(0)))
  show("u8-lshr0", int(b >> 0), int(b >> opU8(0)))

  // Pointer arithmetic: `wordAt`'s exact shape. `let n: *i64 = nil` lowers to a
  // `const_nil`, which `analyzeConsts` does not record as a constant at all —
  // `constView` is what makes the nil operand fold away here.
  let p: *i64 = nil
  let q = p + 8
  show("ptr-nil-add", int(q), 64)
}
