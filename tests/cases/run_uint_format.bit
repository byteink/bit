// run
// #2011: interpolating an UNSIGNED integer must render it unsigned. Every
// `u64` here has bit 63 set, and each one printed as the i64 with the same bit
// pattern (`18446744073709551615` -> `-1`) until `lowerToString` learned to
// pick `string_from_uint` for the u8..u64 prim tags. The bit pattern was always
// right — only the rendering was signed — so nothing but the printed text can
// catch this, and the comparison/shift/division guards in
// `run_u64_const_ops.bit` all stayed green through it.
//
// `1 << 63` is the idiomatic way to write a u64 top-bit mask and only became
// buildable with #2265; before that this bug was unreachable through the
// spelling users are most likely to write.
//
// The u8/u16/u32 lines are the other half of the fix: they already printed
// correctly (zero-extension keeps them under 2^63) and must keep doing so now
// that they take a different runtime formatter. The signed lines guard the
// reverse mistake — routing i8..i64 through the unsigned path would print
// `-42` as 18446744073709551574.
const MASK: u64 = 1 << 63
const HEX: u64 = 0xFFFFFFFFFFFFFFFF

function main() {
  let x: u64 = 18446744073709551615
  print("max=${x}\n")
  print("hex=${HEX}\n")
  print("mask=${MASK}\n")

  // Unsigned arithmetic is modular (SPEC §11.1): 0 - 1 is 2^64-1, not -1.
  let a: u64 = 0
  let b = a - 1
  print("wrap=${b}\n")

  let half: u64 = 9223372036854775808
  let below: u64 = 9223372036854775807
  print("half=${half} below=${below}\n")

  let e: u8 = 255
  let f: u16 = 65535
  let g: u32 = 4294967295
  print("u8=${e} u16=${f} u32=${g}\n")

  // The narrow prims wrap by truncation, so they stay zero-extended.
  let h: u8 = 0
  let i8w = h - 1
  let j: u16 = 0
  let j16w = j - 1
  let k: u32 = 0
  let k32w = k - 1
  print("u8wrap=${i8w} u16wrap=${j16w} u32wrap=${k32w}\n")

  let zero: u64 = 0
  let one: u64 = 1
  print("zero=${zero} one=${one}\n")

  let neg: i64 = -42
  let neg32: i32 = -7
  let pos: int = 42
  print("i64=${neg} i32=${neg32} int=${pos}\n")
}
