// run
// #1532: `match` nested inside a bind-catch block parses correctly — the block
// reading wins over the composite-literal reading of `e { ... }`, and the
// nested match braces do not defeat it. Match arms are separated here by
// newlines (ASI); juxtaposing two arms on ONE line is what actually needs an
// explicit `;` or `,` separator, which is what made this look like a parser bug.
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally.
enum E { A, B }
class myErr { code: i64 }
fn (e: myErr) message(): string { return "code=${e.code}" }
fn g(): i64! { fail myErr{ code: 1 } }
fn f(v: E): i64 {
  return g() catch e {
    match (v) {
      A => return 7
      B => return 8
    }
  }
}
fn main() {
  print("a=${f(E.A)}\n")
  print("b=${f(E.B)}\n")
}
