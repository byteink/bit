// panic-debug
// #3087 (epic #3076): arm64/x64 `--debug` builds emit an overflow-checked
// signed add (#3080/#3082) that must TRAP when a runtime i64 MAX + 1
// overflows the type's range (SPEC §13.5). `one()` is routed through
// `len(args())` so `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve
// this add as a compile-time constant -- this pins the CODEGEN path, not
// the constant folder. Sibling of overflow_trap_add_release.bit: the
// identical expression, built WITHOUT `--debug`, where the same overflow
// must silently wrap instead.
import { args } from "std/os"

fn one(): int { return len(args()) }

fn main() {
  print("start\n")
  let x: i64 = 9223372036854775807
  print("sum=${x + one()}\n")
  print("unreachable\n")
}
