// run
// #2110: strings.split was O(n^2) — it re-sliced the whole unconsumed tail
// on every separator found. 200,000 lines must split well inside the golden
// harness's timeout (it used to need ~3 minutes for 40,000). Also pins the
// semantics that must not change under the fix (#2132's merged comment):
// adjacent/edge separators yield empty parts, an empty separator yields the
// whole string as one part, an empty input yields one empty part, and
// multi-byte separators still work.
import { join, repeat, split } from "std/strings"

function show(parts: []string): string {
  return "[" + join(parts, "|") + "]"
}

function main() {
  let blob = repeat("x\n", 200000)
  let parts = split(blob, "\n")
  println("large n=${len(parts)}")

  println("adjacent=${show(split("a,,b,", ","))}")
  println("empty-sep=${show(split("abc", ""))}")
  println("empty-input=${show(split("", ","))}")
  println("multi-byte=${show(split("a::b", "::"))}")
}
