// run
function main() {
  let xs = [10, 20, 30, 40, 50]
  let mid = xs[1:4]
  print("mid: len=${len(mid)} cap=${cap(mid)} m0=${mid[0]} m2=${mid[2]}\n")
  mid[0] = 99
  print("xs1=${xs[1]}\n")
  let tail = xs[3:]
  print("tail: ${tail[0]} ${tail[1]} len=${len(tail)}\n")
  let head = xs[:2]
  print("head: ${head[0]} ${head[1]}\n")
}
