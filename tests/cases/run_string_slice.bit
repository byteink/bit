// run
// String reslice `s[lo:hi]` (SPEC §12.6) copies a byte range into a fresh
// string; `lo` defaults to 0 and `hi` to `len(s)`. The `[]byte(s)` and
// `string([]byte)` conversions (SPEC §12.9) round-trip through a `[]u8`.
function main() {
  let s = "hello world"
  print("${s[0:5]}\n")
  print("${s[6:11]}\n")
  print("${s[6:]}\n")
  print("${s[:5]}\n")

  let b = []byte(s)
  print("${b[0]} ${b[10]} ${len(b)}\n")

  let s2 = string(b)
  print("${s2}\n")
}
