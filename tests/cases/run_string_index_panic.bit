// panic
// #2014, the string index: `s[i]` past the end must panic (SPEC §12.6, §18.4).
// `bit_rt_string_byte` returned -1, described in its own comment as "a value no
// byte can take" — but `s[i]` is typed `u8`, so -1 arrived as
// 0xFFFFFFFFFFFFFFFF and printed `18446744073709551615` (`-1` before #2011).
// A plausible-looking number in a byte-typed value is not a sentinel a caller
// notices, which is exactly why the panic and not a magic value is the contract.
import { args } from "std/os"

fn oob(): int { return len(args()) + 8 }

fn main() {
  let s = "ab"
  print("start\n")
  print("byte=${s[oob()]}\n")
  print("unreachable\n")
}
