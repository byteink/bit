// run
function main() {
  // An all-untyped arithmetic expression takes its concrete type from context
  // (here the channel element type i64); the result type must match the
  // materialized operands, not stay untyped.
  let ch = chan<i64>(2)
  ch <- 7 * 6
  ch <- 100 - 58
  print("${<- ch} ${<- ch}\n")
}
