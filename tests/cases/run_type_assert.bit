// run
// Type assertions (SPEC §14.4). An interface value is the receiver pointer, so
// its dynamic type is the `TypeInfo` in its GC header and the assertion is a
// descriptor-identity test (ABI.md §2.2).
//
// On a mismatch the two-result form yields `(nil, false)` — nil, not the
// un-narrowed receiver, because the result is typed as the target: handing back
// the receiver would let a caller that ignores `ok` read a `Square` as a
// `Circle`. `ok` is the guard, exactly as for a reference-element channel recv.
struct Circle { r: i64 }

struct Square { s: i64 }

fn (c: Circle) area(): i64 { return c.r * c.r * 3 }

fn (q: Square) area(): i64 { return q.s * q.s }

interface Shape { area(): i64 }

fn describe(sh: Shape) {
  let (c, cok) = sh.(Circle)
  if (cok) {
    print("circle r=${c.r} area=${c.area()}\n")
  }
  let (q, qok) = sh.(Square)
  if (qok) {
    print("square s=${q.s} area=${q.area()}\n")
  }
}

fn main() {
  describe(Circle{ r: 2 })
  describe(Square{ s: 3 })

  // Dispatch still goes through the interface; the assertion only narrows.
  let sh: Shape = Circle{ r: 4 }
  print("via iface ${sh.area()}\n")

  // A mismatch reports `false` rather than panicking.
  let (miss, missok) = sh.(Square)
  print("as square ${missok}\n")

  // The one-result form narrows directly (it panics on a mismatch — see
  // panic_type_assert).
  let c = sh.(Circle)
  print("narrowed ${c.r}\n")

  // Assignment spelling, into existing locals.
  let got = Circle{ r: 0 }
  let ok = false
  (got, ok) = sh.(Circle)
  print("assigned ${got.r} ${ok}\n")
}
