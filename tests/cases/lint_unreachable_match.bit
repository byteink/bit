// lint exit=1
// #1386: the `return` inside the `Red` arm's own block makes the `let dead`
// that follows it unreachable, exactly like a plain function body. The other
// arms don't diverge, so the `return 0` after the whole `match` stays live.
enum Color { Red, Green, Blue }

function f(c: Color): int {
  match (c) {
    Red => {
      return 1
      let dead = 2
    }
    Green => {
      let ok = 1
    }
    Blue => {
      let ok = 2
    }
  }
  return 0
}
