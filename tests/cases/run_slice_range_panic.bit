// panic
// #2014, the slice re-slice: `xs[lo:hi]` outside `0 <= lo <= hi <= cap` must
// panic with `slice bounds out of range` (SPEC §12.6, §18.4).
// `bit_rt_slice_slice` returned 0 out of range, which reads as the EMPTY SLICE,
// so `xs[0:9]` became `[]` and every element the caller expected simply vanished
// with no diagnostic — a silent truncation rather than a visibly wrong value.
//
// The message differs from the string form on purpose: a slice's legal upper
// bound is `cap`, a string's is `len`, so which limit was violated is the first
// thing a reader needs.
import { args } from "std/os"

function oob(): int { return len(args()) + 8 }

function main() {
  let xs = [1, 2, 3]
  print("start\n")
  let v = xs[0:oob()]
  print("survived len=${len(v)}\n")
}
