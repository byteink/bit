// run
// #3108: a sliced view carries a NON-ZERO `slcOff` (ABI.md §2), and an element
// WRITE must land at `buf[off + index]`, not `buf[index]`. The write half of
// `run_slice_view_offset_read.bit`.
//
// This is the case the inline store can get wrong in a way nothing else in the
// corpus would catch, and it is worse than the read's version of the same bug.
// Dropping the `off` term leaves every write to a WHOLE slice correct (its `off`
// is 0) while a write through a view silently lands on the parent's element at
// the wrong position — so the program does not just read a wrong answer, it
// CORRUPTS a live element it was never asked to touch. It compiles, it exits 0,
// and only a view disagrees.
//
// Every check is made through the PARENT, which is the whole point: a view whose
// `off` was dropped would still read back its own write self-consistently. The
// parent is the independent oracle, and the untouched neighbours are checked too,
// because a shifted write shows up as much in what it clobbered as in what it
// failed to set.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  let xs = [10, 20, 30, 40, 50, 60]

  // off = 2, len = 3 — the view is xs[2], xs[3], xs[4].
  let mid = xs[2:5]

  mid[zero()] = 99
  print("p2=${xs[2]} hit=${xs[2] == 99}\n")

  mid[zero() + 2] = 77
  print("p4=${xs[4]} hit=${xs[4] == 77}\n")

  // The elements on either side of the view must be untouched: a write that
  // ignored `off` would have landed on xs[0] and xs[2] instead.
  let outside = xs[0] == 10 && xs[1] == 20 && xs[5] == 60
  print("p0=${xs[0]} p1=${xs[1]} p5=${xs[5]} outside=${outside}\n")

  // A view OF a view: `off` accumulates, so this one is 2 + 1 = 3.
  let inner = mid[1:3]
  inner[zero()] = 55
  print("p3=${xs[3]} hit=${xs[3] == 55}\n")

  // The last element of the last legal view: `off` at its maximum.
  let tail = xs[len(xs) - 1:len(xs)]
  tail[zero()] = 66
  print("p5=${xs[5]} hit=${xs[5] == 66}\n")

  // Read-modify-write goes down a DIFFERENT lowering path — `writeLvalue`, not
  // `lowerIndexStore` — and must apply the same offset.
  mid[zero() + 1] = 40
  mid[zero() + 1] += 5
  print("p3rmw=${xs[3]} hit=${xs[3] == 45}\n")

  // `++` is the third path into the same store.
  mid[zero() + 1]++
  print("p3inc=${xs[3]} hit=${xs[3] == 46}\n")
}
