// run
// u8 addition wraps at 8 bits: 200 + 100 == 300 mod 256 == 44 (#1158).
//
// `blackbox` (multi-block, never inlined/folded at -O1) makes the left operand
// opaque so the add runs in codegen rather than being folded.
function blackbox(x: u8): u8 {
  if (x == 0) { return 0 }
  return x
}

function main() {
  let x: u8 = blackbox(200)
  print("${x + 100}\n")
}
