// run
// #2947: an arrow-function parameter's type was inferred from an unrelated
// same-named function's parameter elsewhere in the module, rather than left
// unknown when the call site (a METHOD call) gives the checker no expected
// function type to seed it from. `checkExprType`'s Tag.Ident fallback used the
// module-wide flat env — keyed by NAME only — whenever a resolved local decl's
// own type was still 0, so `r` inside `(r) => r + 1` picked up `takesR`'s
// unrelated `r: Widget` parameter (E0053, "operator not defined for 'Widget'
// and 'untyped int'") instead of staying untyped and letting the arrow lower
// against the call site the way an unambiguous name always did.
//
// `takesR`'s parameter is deliberately named `r`, matching the arrow's own
// parameter, and deliberately placed AFTER `useArrow` in source order — same
// module, reversed declaration order — so a fix that only works one way round
// cannot pass this case.
struct Caller { x: int }

fn (c: Caller) serve(f: (int) => int): int {
  return f(c.x)
}

fn useArrow(): int {
  let c = Caller{ x: 5 }
  return c.serve((r) => r + 1)
}

struct Widget { pos: int }

fn takesR(r: Widget): int {
  return r.pos
}

fn main() {
  print("useArrow()=${useArrow()}\n")
}
