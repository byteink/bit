// run
// NEGATIVE case for #1535: valid type declarations must still compile once
// E0052/E0072 can reach struct fields, enum payloads, type aliases and
// interface signatures. Extending a diagnostic's REACH is the change that can
// start refusing valid code, and this asserts the absence of a diagnostic —
// something no differential over the corpus can do for a shape the corpus does
// not contain. Both false positives caught in this area today were invisible to
// every differential and surfaced only from a hand-written negative.
//
// The generic forms are the ones that actually carry the risk. `Arr<T>` is the
// sharpest: E0072 rejects a fixed array of REFERENCE-typed elements, and an
// unbound `T` is not yet known to be scalar, so a predicate that judged before
// resolving would reject a legal generic struct. It stays quiet because
// vTypeNode is guarded by vTypeResolved — an unresolved annotation judges
// nothing, which is the permissive answer required when the verdict is not yet
// decidable. `Box<T>`, `M<T>`, `Opt<T>` and `Alias<T>` cover the same guard
// through the other type-declaration forms.
//
// The non-generic half pins the ordinary shapes that must keep passing: a map
// with a comparable key (including a nested one), a slice, and a fixed array of
// scalars — each the LEGAL side of a rule whose illegal side is now reported.
//
// Single-file golden, so there is NO prelude: `print` takes a string.

struct Box<T> {
  v: T,
}

struct Arr<T> {
  a: [4]T,
}

struct M<T> {
  m: map<string, T>,
}

enum Opt<T> {
  Some(T),
  None,
}

type Alias<T> = map<string, T>

struct Plain {
  i: int,
  s: string,
  f: f64,
  b: bool,
  sl: []int,
  arr: [3]int,
}

struct MapOk {
  m: map<string, []int>,
  n: map<int, map<string, int>>,
}

type Simple = []int

interface Shape {
  area(): f64
}

function main() {
  let p = Plain{ i: 1, s: "ok", f: 1.5, b: true, sl: []int{}, arr: [3]int{0, 0, 0} }
  print(p.s)
  print("\n")
}
