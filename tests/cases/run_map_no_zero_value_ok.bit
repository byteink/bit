// run
// The escape hatch that makes #1926's panic acceptable: `let (v, ok) = m[k]`
// must NOT panic even when the value type has no zero value.
//
// `m[k]` on such a type panics (panic_map_no_zero_value.bit). If the comma-ok
// form panicked too, a `map<K,V>` whose V has a struct-typed field would be
// unreadable by any means at all — you could insert into it and iterate it, but
// never ask whether a key is there. That is the whole reason the two forms
// differ, and it is the same split C++ draws between `operator[]` (which
// requires a default-constructible value) and `find`.
//
// On a miss the comma-ok form yields `ok == false` and a `v` that must not be
// read, which is the contract that form already carries.
//
// A plain struct value type is unaffected throughout: `Inner` has no
// struct-typed field, so it HAS a zero value and a miss still materializes a
// live zeroed instance the way it always did (#1557).
struct Inner { xs: []u32, n: int }
struct Outer { a: int, b: Inner }

fn main() {
  // Plain V: the miss edge still builds a live zero.
  let p = map<int, Inner>{}
  print("plain.xs=")
  print(itoa(len(p[7].xs)))
  print(" plain.n=")
  print(itoa(p[7].n))
  print("\n")

  // No-zero-value V, missing key: no panic, ok is false.
  let m = map<int, Outer>{}
  let (miss, missOk) = m[7]
  print("missOk=")
  print(btoa(missOk))
  print("\n")

  // No-zero-value V, present key: both forms read it back.
  m[1] = Outer{ a: 5, b: Inner{ n: 9 } }
  let (hit, hitOk) = m[1]
  print("hitOk=")
  print(btoa(hitOk))
  print(" a=")
  print(itoa(hit.a))
  print(" b.n=")
  print(itoa(hit.b.n))
  print(" direct=")
  print(itoa(m[1].a))
  print("\n")
}

fn btoa(b: bool): string {
  if (b) { return "true" }
  return "false"
}

fn itoa(n: int): string {
  if (n == 0) { return "0" }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) { s = d[v % 10 : v % 10 + 1] + s; v = v / 10 }
  return s
}
