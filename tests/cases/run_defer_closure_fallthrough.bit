// run
// #3504: a closure body that falls off the end without an explicit `return`
// never replayed its own defers — lowerClosureBody's fall-through Ret was
// emitted with no runDefers(cfc) call, unlike the ordinary function fall-
// through path. Return/fail/`?` inside a closure already worked because
// lowerStmt's generic handling calls runDefers with whatever FnCtx it is
// given; only the implicit exit edge was skipped. Covers both shapes since
// they lower through different branches: fall-through (broken) and an
// explicit `return` (already correct) must produce identical output.
fn main() {
  let fallThrough = () => {
    defer print("closure-defer-1\n")
    print("closure-body-1\n")
  }
  fallThrough()
  print("after-1\n")

  let explicitReturn = () => {
    defer print("closure-defer-2\n")
    print("closure-body-2\n")
    return
  }
  explicitReturn()
  print("after-2\n")
}
