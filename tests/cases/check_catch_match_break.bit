// error
// #1531: a `break` inside a match arm targets the enclosing LOOP — a match is
// not a break target (`lowerMatch` pushes no loop frame). So this `while (true)`
// DOES terminate, the catch block falls through without producing a value, and
// E0067 must fire. Before the fix the divergence analysis never descended into
// match arms, reported the loop as diverging, and accepted this program.
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally.
enum E { A, B }
class myErr {
  code: i64
  message(): string { return "code=${this.code}" }
}
fn g(): i64! { fail myErr{ code: 1 } }
fn f(): i64 {
  return g() catch e {
    while (true) {
      match (E.A) {
        A => break
        B => break
      }
    }
  }
}
