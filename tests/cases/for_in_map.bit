// run
// #2162 (owner decision 2026-08-10): `for x in it` yields the KEY for a map,
// never the value — the pair form `for (k, v) of m` already covers pairs.
// Key order is unspecified (slot order, not insertion order), so this sums
// the keys rather than printing them directly (same convention as
// run_map.bit).
fn main() {
  let m = map<int, int>{ 1: 10, 2: 20, 3: 30 }
  let ksum = 0
  for k in m {
    ksum = ksum + k
  }
  print("ksum=${ksum} len=${len(m)}\n")

  // The binder really is the key, not the value: indexing the map with it
  // recovers the value.
  let vsum = 0
  for k in m {
    vsum = vsum + m[k]
  }
  print("vsum=${vsum}\n")
}
