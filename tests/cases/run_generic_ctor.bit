// run
// A generic container's constructor (#2041). `struct Stack<T> { items: []T }` is
// the most ordinary generic shape there is, and it had no writable constructor:
// the struct's field is typed against the STRUCT's `T` and the constructor's
// literal against the FUNCTION's `T`, two distinct TypeParam ids, so the two
// `[]T` were two Slice ids and the checker reported `expected '[]T', found
// '[]T'` — the same spelling on both sides.
//
// Every affected composite kind is here: a slice field, a map field, and a
// function-typed field (the only way to order a container while `T: Ord` is
// unusable, #2136). So is the `return h.keys` accessor, which fails through the
// return-assignability path rather than the composite-literal one.
struct Stack<T> { items: []T }
struct Bag<T> { m: map<T, int> }
struct Cmp<T> { less: (T, T) => bool }

// The already-working shapes, pinned so the fix does not disturb them: a bare
// type-parameter field, and a nested generic struct field.
struct Box<T> { v: T }
struct Wrap<T> { b: Box<T>, n: int }

fn newStack<T>(): Stack<T> {
  return Stack<T>{ items: []T(0) }
}

// Filled from a `[]T` PARAMETER rather than a fresh allocation.
fn stackOf<T>(xs: []T): Stack<T> {
  return Stack<T>{ items: xs }
}

// Filled from a LOCAL of type `[]T`.
fn stackVia<T>(): Stack<T> {
  let e = []T(0)
  return Stack<T>{ items: e }
}

fn newBag<T>(): Bag<T> {
  return Bag<T>{ m: map<T, int>() }
}

fn newCmp<T>(f: (T, T) => bool): Cmp<T> {
  return Cmp<T>{ less: f }
}

// Reading a `[]T` field back out of a generic struct and returning it.
fn itemsOf<T>(s: Stack<T>): []T {
  return s.items
}

fn newWrap<T>(v: T): Wrap<T> {
  return Wrap<T>{ b: Box<T>{ v: v }, n: 1 }
}

fn unbox<T>(w: Wrap<T>): T {
  return w.b.v
}

fn lessInt(a: int, b: int): bool { return a < b }

fn main() {
  let si = newStack<int>()
  let ss = newStack<string>()
  print("${len(si.items)} ${len(ss.items)}\n")

  let filled = stackOf<int>([1, 2, 3])
  print("${len(itemsOf<int>(filled))} ${filled.items[0]}\n")

  let via = stackVia<string>()
  print("${len(via.items)}\n")

  let bi = newBag<int>()
  let bs = newBag<string>()
  bi.m[7] = 70
  bs.m["k"] = 1
  print("${len(bi.m)} ${len(bs.m)} ${bi.m[7]}\n")

  let c = newCmp<int>(lessInt)
  print("${c.less(1, 2)} ${c.less(2, 1)}\n")

  print("${unbox(newWrap<int>(42))} ${unbox(newWrap<string>("s"))}\n")

  // A concrete literal outside any generic must keep working.
  let plain = Stack<int>{ items: []int(0) }
  print("${len(plain.items)}\n")
}
