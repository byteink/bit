// fmt
// #3719: an int-literal receiver of a member/tuple-index access must keep
// its parens -- printing the bare digits immediately before `.` re-lexes
// as the start of a float literal (`5.zzz`), corrupting the token stream.
// `Tag.FloatLit`/`Tag.StringLit` receivers need no such protection (the
// dot is already consumed or the receiver is quoted), so this is a no-op
// for them but load-bearing for `Tag.IntLit`.
fn main() {
  let w = (5).zzz
  let y = 1.5.zzz
  let z = "a".zzz
  println("${w}${y}${z}")
}
