// run
// #1428: `defer` of a generic gets the same instance resolution a direct call
// does. `lowerDefer` module-qualified its callee but never instantiated it, so
// a deferred generic emitted a bare `g` against a definition named `g$0`.
function g<T>(x: T) {
  print("g ran with ${x}\n")
}
function main() {
  defer g(7)
  print("main body\n")
}
