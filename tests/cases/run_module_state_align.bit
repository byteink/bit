// run
// §11.11 module state is 16-byte aligned, whatever its type (#1421).
//
// Before this was pinned, cells took 8-byte alignment, so an array landed at
// `addr % 16 == 8` for SOME declaration orders and not others. That matters
// because §11.11 admits `[N]U` so the runtime can carve its own memory out of
// one, and a green-thread stack is that use: AAPCS64 faults on a misaligned
// `sp`, so a stack cut from an 8-aligned array SIGBUSes on arm64 — and only for
// the orders that happened to land it odd, which is what made it look like a
// scheduler bug rather than a layout one.
//
// The sizes here are chosen to be exactly the case that used to fail: the odd
// and non-multiple-of-16 lengths force each following cell onto an 8-boundary
// under natural alignment. Under the guarantee every remainder is 0. Printing
// the remainder rather than the address keeps the case position-independent.
let a: [24]u8
let b: [8]u8
let c: [40]u8
let d: i64 = 0
let e: [56]u8
let f: [7]u8
let g: [9]u8
let h: [64]u8
let scalar: i32 = 7

function main() {
  print("a=${int(ptrOf(a)) % 16} b=${int(ptrOf(b)) % 16} c=${int(ptrOf(c)) % 16}\n")
  print("d=${int(ptrOf(d)) % 16} e=${int(ptrOf(e)) % 16} f=${int(ptrOf(f)) % 16}\n")
  print("g=${int(ptrOf(g)) % 16} h=${int(ptrOf(h)) % 16} s=${int(ptrOf(scalar)) % 16}\n")
  // The cells still hold their declared values — alignment padding sits
  // between cells, never inside one.
  print("d=${d} scalar=${scalar}\n")
}
