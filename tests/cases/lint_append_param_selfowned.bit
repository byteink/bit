// lint exit=0
// the identical self-assignment as lint_append_param_reassigned.bit, but
// this function DOES hand `buf` back to its own caller by returning it
// directly — so the growth reaches the caller through the return value, not
// through aliasing, and the rule must stay silent (#3688; spec/LINT.md §4).
fn ownedAndReturned(buf: []byte, v: int): []byte {
  buf = append(buf, v)
  return buf
}
