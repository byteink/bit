// error
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally rather than
// `newError` (which lives in the prelude).
struct myErr { code: i64 }
function (e: myErr) message(): string { return "code=${e.code}" }
function g(): i64! { fail myErr{ code: 1 } }
function f(): i64 {
  return g() catch e {
    let z = 1
  }
}
