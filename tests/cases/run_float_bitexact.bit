// run
// THE NEGATIVE-LOOKING PATTERNS IN `.expected` CHANGED WITH #2011, AND THE OLD
// ONES WERE WRONG. `floatBits` returns a `u64`, so a pattern with bit 63 set —
// every negative float — is a value above 2^63, not a negative number. Until
// #2011 interpolation rendered every unsigned prim through the SIGNED runtime
// formatter, so this file's `.expected` recorded `b_nzero=-9223372036854775808`
// for `floatBits(-0.0)` = 0x8000000000000000. Each such line is now the same
// bit pattern read unsigned (`9223372036854775808`); the difference on every
// changed line is exactly 2^64, and `compiler/arm64selcheck.bit:566` already
// asserted the unsigned spelling. Do not "restore" the signed values — they are
// the old bug written down. Four goldens in this corpus carried it.
//
// #1442: `fsqrt`, `floatBits` and `float32Bits` are emitted as INLINE machine
// instructions (`fsqrt`/`sqrtsd`, `fmov`/`movq`), not as calls into libbitrt.
// This golden is the numeric half of that change's guard: it pins the exact
// result BITS of every one of them, against the values `runtime/root.zig`'s
// `@sqrt`/`@bitCast` produce.
//
// WHY BIT PATTERNS AND NOT THE PRINTED NUMBER (this is the whole point of the
// file — `run_math.bit` already prints these as decimals and cannot see any of
// it):
//
//   - `-0.0 == 0.0` is TRUE, so a comparison-based check passes an
//     implementation that has lost the sign of zero. That is not hypothetical:
//     the `(x + 2^52) - 2^52` rounding identity, the obvious way to write these
//     without SSE4.1, is wrong on exactly the negative-zero cases and nothing
//     else. Losing it flips the printed shortest string.
//   - `NaN != NaN` is TRUE, so a comparison-based check FAILS a correct
//     implementation and can only be made to pass by special-casing it away.
//
// `floatBits` is therefore both a subject of this test and its instrument: it
// is the only way to observe the bits at all from Bit.
//
// A golden case is a single file, so it has no prelude and cannot import
// std/math — the primitives are called directly, and the non-literal corpus
// values (infinities, NaN) are built by arithmetic.
fn main() {
  // ---- the corpus -------------------------------------------------------
  // Every class the IEEE-754 edge cases live in: signed zeros, the subnormal
  // range, both infinities, NaN, and (for sqrt) the operands whose result is
  // NaN rather than a number.
  let zero: f64 = 0.0
  let nzero: f64 = -0.0
  let sub: f64 = 5e-324                  // smallest positive subnormal
  let maxfin: f64 = 1.7976931348623157e308
  let inf = 1.0 / 0.0
  let ninf = -1.0 / 0.0
  let nan = 0.0 / 0.0

  // ---- floatBits: the bit-preserving transfer ---------------------------
  // `nzero` is the load-bearing row: it is the ONLY one that distinguishes a
  // real bitcast from a numeric conversion, since every other value here has
  // the same bits either way.
  print("b_zero=${floatBits(zero)}\n")
  print("b_nzero=${floatBits(nzero)}\n")
  print("b_sub=${floatBits(sub)}\n")
  print("b_maxfin=${floatBits(maxfin)}\n")
  print("b_inf=${floatBits(inf)}\n")
  print("b_ninf=${floatBits(ninf)}\n")
  // A NaN's BIT PATTERN IS NOT PORTABLE, so these four rows assert NaN-ness
  // structurally instead of pinning a constant: the hardware default NaN is
  // NEGATIVE on x86-64 (0xFFF8..) and POSITIVE on AArch64 (0x7FF8..), and
  // pinning either one makes the golden fail on the other architecture. The
  // test is exponent-all-ones AND mantissa-nonzero, done in integer arithmetic
  // on the bits -- exact, portable, and still never an `==` between floats.
  //   0x7FF0000000000000 = 9218868437227405312  (exponent mask)
  //   0x000FFFFFFFFFFFFF = 4503599627370495     (mantissa mask)
  print("b_nan_isnan=${(floatBits(nan) & 9218868437227405312) == 9218868437227405312 && (floatBits(nan) & 4503599627370495) != 0}\n")
  print("b_one=${floatBits(1.0)}\n")
  print("b_none=${floatBits(0.0 - 1.0)}\n")

  // ---- float32Bits: the same, at single precision -----------------------
  // Narrow: the result is u32, so a backend that moved 64 bits instead of 32
  // (or failed to zero-extend the 32-bit view) shows up here and nowhere else.
  print("f_zero=${float32Bits(f32(0.0))}\n")
  print("f_nzero=${float32Bits(f32(-0.0))}\n")
  print("f_one=${float32Bits(f32(1.0))}\n")
  print("f_half=${float32Bits(f32(0.5))}\n")

  // ---- fsqrt ------------------------------------------------------------
  // Exact cases (4, 2.25) pin the value; irrational cases (2, 3) pin the
  // correctly-rounded last bit, which is what distinguishes the hardware
  // instruction from an approximation.
  print("s_4=${floatBits(fsqrt(4.0))}\n")
  print("s_225=${floatBits(fsqrt(2.25))}\n")
  print("s_2=${floatBits(fsqrt(2.0))}\n")
  print("s_3=${floatBits(fsqrt(3.0))}\n")
  // sqrt(+-0) is +-0, NOT NaN — the sign of zero survives the square root, and
  // this row is the one that catches a backend that routed it through an
  // absolute value or a compare-with-zero.
  print("s_zero=${floatBits(fsqrt(zero))}\n")
  print("s_nzero=${floatBits(fsqrt(nzero))}\n")
  // sqrt of a negative, of -inf, and of NaN are all NaN; sqrt(+inf) is +inf.
  print("s_neg_isnan=${(floatBits(fsqrt(0.0 - 1.0)) & 9218868437227405312) == 9218868437227405312 && (floatBits(fsqrt(0.0 - 1.0)) & 4503599627370495) != 0}\n")
  print("s_inf=${floatBits(fsqrt(inf))}\n")
  print("s_ninf_isnan=${(floatBits(fsqrt(ninf)) & 9218868437227405312) == 9218868437227405312 && (floatBits(fsqrt(ninf)) & 4503599627370495) != 0}\n")
  print("s_nan_isnan=${(floatBits(fsqrt(nan)) & 9218868437227405312) == 9218868437227405312 && (floatBits(fsqrt(nan)) & 4503599627370495) != 0}\n")
  print("s_sub=${floatBits(fsqrt(sub))}\n")
}
