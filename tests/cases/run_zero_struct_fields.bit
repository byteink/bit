// run
// A struct zero-value is one gc_alloc of zeroed memory (SPEC §13.4 — "a live
// instance with each field zero-valued"), so a slice or string FIELD holds the
// null word rather than an empty header. `xs == nil` is not spellable for
// either type (E0053), so null and empty are indistinguishable to a program —
// the only observable difference was the fault, exit 139 on every read (#1564).
//
// #1557 fixed the sibling case (a map miss) at the PRODUCER by materializing
// the zero. That does not transfer here: a struct's fields are one zeroed
// allocation, and a struct-typed field cannot be materialized without
// recursing on a self-referential type. So the tolerance is reader-side — a
// null header READS as the empty value — which also covers every other way a
// null header can arise. Note `append` on a null must allocate a FRESH header:
// it grows in place, so a shared empty would be corrupted process-wide.
struct S {
  n: i64
  xs: []i64
  s: string
}

function main() {
  let z = S{}
  print("scalar ${z.n}\n")
  print("len ${len(z.xs)} cap ${cap(z.xs)}\n")
  print("string ${len(z.s)} [${z.s}]\n")

  // A reslice of the empty slice is in bounds only at [0:0], and yields a
  // fresh empty slice rather than a view onto a shared body.
  print("reslice ${len(z.xs[0:0])}\n")

  let total = 0
  for v of z.xs {
    total = total + v
  }
  print("iterate ${total}\n")

  // append allocates rather than mutating through the null header, and the
  // original zero struct's field is unchanged by it.
  let grown = append(z.xs, 7)
  print("append ${len(grown)} ${grown[0]} orig ${len(z.xs)}\n")

  // A null string header behaves as "" for concat and comparison.
  print("concat [${z.s + "tail"}]\n")
  if (z.s == "") {
    print("eq empty\n")
  } else {
    print("eq WRONG\n")
  }

  // Two independently zeroed structs must not share any header: appending
  // through one cannot be observable through the other.
  let a = S{}
  let b = S{}
  let ga = append(a.xs, 1)
  print("independent ${len(ga)} ${len(b.xs)}\n")
}
