// run
// #2288: there was no way to take an independent copy of a slice, and
// `append` grows its argument in place and aliases the original's backing
// array — so a slice handed to a callee that appends could have the caller's
// own view mutated underneath it. `clone` (std/seq) copies the elements into
// a fresh backing array, so appending to (or writing into) the clone never
// touches the original — proven here for a value element type and for two
// reference element types (string, class), so the copy cannot be a shallow
// reinterpretation of the same backing array.
import { clone } from "std/seq"

class Point { x: i64, y: i64 }

fn main() {
  // The motivating case: taking a copy and growing it must leave the
  // original's own length and elements untouched.
  let base = [1, 2]
  let snap = clone(base)
  snap = append(snap, 3)
  print("base_len=${len(base)} base=[${base[0]},${base[1]}] snap=[${snap[0]},${snap[1]},${snap[2]}]\n")
  base[0] = 99
  print("base0=${base[0]} snap0=${snap[0]}\n")

  // Empty slice: cloning it yields a fresh, independently-growable slice.
  let empty: []i64 = []i64(0)
  let emptyClone = clone(empty)
  emptyClone = append(emptyClone, 7)
  print("empty_len=${len(empty)} clone_len=${len(emptyClone)} clone0=${emptyClone[0]}\n")

  // Single-element slice.
  let one = [42]
  let oneClone = clone(one)
  oneClone[0] = 7
  print("one0=${one[0]} oneClone0=${oneClone[0]}\n")

  // Reference-typed element (string): the clone must copy the slice's OWN
  // backing array, not merely re-share it under a fresh header.
  let words = ["ab", "cd"]
  let wordsClone = clone(words)
  wordsClone[0] = "zz"
  wordsClone = append(wordsClone, "ee")
  print("words_len=${len(words)} words0=${words[0]} wordsClone=[${wordsClone[0]},${wordsClone[1]},${wordsClone[2]}]\n")

  // Reference-typed element (class): `clone` copies the SLOT (which class
  // instance a given index refers to), so replacing a clone slot must not
  // move the original's slot to a different instance. (It does not deep-copy
  // the pointee: mutating a field through a shared class instance is
  // visible from both views either way, same as Go's `copy`.)
  let pts = [Point{x: 1, y: 2}, Point{x: 3, y: 4}]
  let ptsClone = clone(pts)
  ptsClone[0] = Point{x: 100, y: 100}
  print("pts0x=${pts[0].x} ptsClone0x=${ptsClone[0].x}\n")
}
