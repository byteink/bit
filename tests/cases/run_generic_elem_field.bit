// run
// A generic struct reached through a CONTAINER ELEMENT (#1544). `xs[0].v` on a
// `[]Box<i64>` must yield i64: the field is stored against the template as the
// bare param `T`, and the receiver's type arguments live one level inside the
// container's declared type node. Reading the field type without descending
// there left it as `T` and rejected valid code with E0053.
//
// The map, nested-slice, struct-field and call arms pin the neighbouring shapes
// that share the same substitution path, so a fix here cannot quietly regress
// them into the opposite (a false negative that miscompiles).
enum Maybe<T> {
  Some(T)
  None
}

struct Box<T> {
  v: T
}

struct Holder {
  boxes: []Box<i64>
  names: map<string, Box<string>>
}

fn fromSlice(xs: []Box<i64>): i64 {
  return xs[0].v + 1
}

fn fromMap(m: map<string, Box<i64>>): i64 {
  return m["k"].v + 2
}

fn fromNestedSlice(xss: [][]Box<i64>): i64 {
  return xss[0][0].v + 3
}

fn fromStructField(h: Holder): i64 {
  return h.boxes[0].v + 4
}

fn fromStructMapField(h: Holder): string {
  return h.names["k"].v
}

fn mk(): Box<i64> {
  return Box<i64>{ v: 50 }
}

fn same(b: Box<i64>): Box<i64> {
  return b
}

fn fromCall(): i64 {
  return mk().v + 5
}

fn fromNestedCall(): i64 {
  return same(mk()).v + 6
}

fn fromElemThroughCall(xs: []Box<i64>): i64 {
  return same(xs[0]).v + 7
}

fn fromLocal(): i64 {
  let b: Box<i64> = Box<i64>{ v: 80 }
  return b.v + 8
}

// A generic ENUM element: the match binder's payload type comes from the same
// type-argument recovery, so a slice element must bind `n` at i64, not `T`.
fn pickElem(ms: []Maybe<i64>): i64 {
  match (ms[0]) {
    Some(n) => { return n + 9 }
    None => { return 0 }
  }
}

fn main() {
  let boxes = [Box<i64>{ v: 10 }]
  let m = map<string, Box<i64>>{ "k": Box<i64>{ v: 20 } }
  let h = Holder{
    boxes: boxes,
    names: map<string, Box<string>>{ "k": Box<string>{ v: "named" } },
  }
  print("${fromSlice(boxes)}\n")
  print("${fromMap(m)}\n")
  print("${fromNestedSlice([boxes])}\n")
  print("${fromStructField(h)}\n")
  print("${fromStructMapField(h)}\n")
  print("${fromCall()}\n")
  print("${fromNestedCall()}\n")
  print("${fromElemThroughCall(boxes)}\n")
  print("${fromLocal()}\n")
  print("${pickElem([Maybe.Some(31)])}\n")
  let strs: []Box<string> = [Box<string>{ v: "elem" }]
  print("${strs[0].v}\n")
}
