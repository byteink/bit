// error
// `entryOf(f)` (§11.10) accepts only a direct reference to a named function
// declaration. Every rejection below is a DESIGN decision enforced in the
// checker, not an implementation limit — the point is that a program asking for
// an address that cannot exist is told so, rather than passing `bit check` and
// failing during lowering.
//
// The closure cases are the substantive ones. A closure is a (code, env) pair,
// and the captured environment is exactly what makes calling it meaningful;
// handing back the code half alone would produce an address that runs against
// somebody else's environment, or none. Lowering could easily emit something
// here — `make_closure` has the code pointer in hand — which is precisely why
// the refusal has to live in the checker.
function alpha(): int { return 42 }
function gen<T>(v: T): T { return v }

function main() {
  // A function VALUE, not a declaration: `held` is a binding that happens to
  // hold a closure. Same shape a `let` capturing environment would have.
  let held = alpha
  let n = 5
  let arrow = (x: int) => x + n

  print("${int(entryOf(held))}")
  print("${int(entryOf(arrow))}")
  // No single body exists until instantiation, so there is no one address.
  print("${int(entryOf(gen))}")
  // Arity, so the builtin cannot be called into a wrong shape silently.
  print("${int(entryOf(alpha, alpha))}")
  // Not a function at all.
  print("${int(entryOf(n))}")
}
