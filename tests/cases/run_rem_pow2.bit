// run
// srem/urem by a compile-time power-of-two constant (#1704): the same x64
// strength reduction #1702 gave sdiv/udiv, extended to the remainder ops.
// The divisor is always a literal so the fast path fires; each dividend is a
// genuine runtime value (a loop-carried variable, or an array load indexed by
// one) rather than a literal, so it survives to the real codegen path (idiv,
// or the new shift/mask sequence) instead of being folded away before codegen
// ever sees it — both compilers' constant folder (optfold.bit's
// foldBinaryArith) only folds a `%` whose OPERANDS are already ConstInt
// nodes, and neither a loop's carried value nor an array load is one.
//
// The i32 case indexes an array rather than looping the dividend itself
// (#1708: a negative i32 value carried through a while-loop's own phi
// currently mis-compares in this loop-header shape — a separate, filed bug
// unrelated to div/rem; an array load sidesteps it while still exercising a
// genuine narrow-signed runtime value).
//
// Signed remainder rounds toward zero and takes the DIVIDEND's sign (SPEC
// section 13.5) -- the negative-dividend cases below are exactly where a
// naive `x & (N-1)` mask (correct only for unsigned) gets it wrong.
function main() {
  let i: i64 = -9
  while (i <= 9) {
    print("${i % 8} ")
    i = i + 1
  }
  print("\n")

  let arr: [5]i32 = [5]i32{-20, -10, 0, 10, 20}
  let idx = 0
  while (idx < 5) {
    print("${arr[idx] % 16} ")
    idx = idx + 1
  }
  print("\n")

  let u: u64 = 0
  while (u < 20) {
    print("${u % 16} ")
    u = u + 5
  }
  print("\n")

  let v: u32 = 0
  while (v < 20) {
    print("${v % 4} ")
    v = v + 7
  }
  print("\n")
}
