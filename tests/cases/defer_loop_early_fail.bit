// run
// Sibling of defer_loop_early_return.bit (#2078): the exit from inside the
// loop is a `fail` in a `T!` function rather than a `return`. Same "IR
// verification failed" refusal before the fix — `fail` replays the deferred
// call exactly like `return` does (compiler/lowerfunc.bit's lowerFail).
class P { n: int }
class tooBig { 
  message(): string { return "too big" }
}
fn pop(p: P) { p.n = p.n - 1 }

fn f(p: P): int! {
  defer pop(p)
  while (true) {
    if (p.n > 2) { fail tooBig{} }
    p.n = p.n + 1
  }
  return 0
}

fn main() {
  let p = P{ n: 5 }
  let r = f(p) catch e { print("caught: ${e.message()}\n"); -1 }
  print("${r}\n")
}
