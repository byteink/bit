// panic
// #2018: calling a nil function value must panic (SPEC §13.4, §18.4: "call
// of a `nil` function") rather than dereferencing address 0 for the closure
// cell's {code, env} fields and dying on SIGSEGV.
function main() {
  let f: (int) => int
  print("start\n")
  let r = f(1)
  print("unreachable ${r}\n")
}
