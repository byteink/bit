// run
// A u32 rotate-right built from shifts + or, checked against a hardcoded table
// of known triples (#1158). The `x << (32 - n)` half overflows u32 unless the
// shift-left result is re-narrowed to width — the exact pattern SHA-256 /
// BLAKE / ChaCha20 run every round.
//
// The first two rows call rotr32 with plain literal arguments: this is the
// natural crypto call shape, and it also guards the lowering fix that hints an
// untyped literal to its parameter type (an unhinted `4` would be an i64 fused
// into rotr32's u32 body by the inliner, which IR verification rejects). The
// last three route inputs through `blackbox` (multi-block, so never
// inlined/folded), forcing the shifts to run in codegen on runtime values —
// the row (0x80000000, 31) exercises the shift-left overflow directly.
function blackbox(x: u32): u32 {
  if (x == 0) { return 0 }
  return x
}

function rotr32(x: u32, n: u32): u32 {
  return (x >> n) | (x << (32 - n))
}

function main() {
  print("${rotr32(0x12345678, 4)}\n")
  print("${rotr32(0x00000001, 1)}\n")
  print("${rotr32(blackbox(0x80000000), blackbox(31))}\n")
  print("${rotr32(blackbox(0xDEADBEEF), blackbox(8))}\n")
  print("${rotr32(blackbox(0xDEADBEEF), blackbox(16))}\n")
}
