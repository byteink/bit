// run
// SPEC §15.4: integer literals "and `const` expressions over them" are untyped
// constants, "usable in any type in which [they are] representable". A bare
// literal adapted; an EXPRESSION did not, for integers only (#2265). `let a:
// i32 = 5` was accepted and `let a: i32 = 2 + 3` on the next line was E0041,
// which made every integer type other than i64/int unreachable by any
// arithmetic.
//
// `print`, not `println`: a golden case compiles single-file with NO prelude
// (#1493).
const C1: i32 = 2 + 3
const C2: u8 = 1 << 3

struct S { f: u8 }

function g(): i32 { return 2 + 3 }
function f(x: u8): u8 { return x }

function main() {
  let a: i32 = 2 + 3
  let b: u8 = 100 + 100
  let c: u8 = 1 << 3
  let d: i16 = 10 / 2
  print("${a} ${b} ${c} ${d}\n")

  // Every other typed context the ticket lists: a const decl, a function
  // result, a function argument, and a struct-literal field.
  let s = S{ f: 1 + 1 }
  print("${C1} ${C2} ${g()} ${f(1 + 1)} ${s.f}\n")

  // The ticket's headline case, in a language called Bit: a top-bit mask
  // written as an expression. Its VALUE is deliberately not interpolated — a
  // u64 above i64 MAX renders as a negative number (#2011), which is a separate
  // defect and would pin the wrong string here. Comparing it is enough to prove
  // it compiled and holds the right bits.
  let m: u64 = 1 << 63
  let n: u64 = 1 << 62
  print("${m > n} ${m / 2 == n}\n")

  // Float constant expressions already worked; pinned so the integer fix does
  // not disturb the path that was right. Compared rather than interpolated:
  // `${e}` on an f32 bound from a constant EXPRESSION builds clean and then
  // dies with SIGILL, on this tree and on brew 0.1.8 and oracle 0.1.5 alike
  // (#2376). That is a separate codegen defect, and this case must not depend
  // on it.
  let e: f32 = 1.0 + 0.5
  let one: f32 = 1.0
  print("${e > one} ${e < 2.0}\n")

  // The bare-literal path this must not regress.
  let h: i32 = 5
  let i: u8 = 255
  print("${h} ${i}\n")
}
