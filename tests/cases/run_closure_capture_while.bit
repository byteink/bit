// run
// #2128: a `while` counter is ONE variable, so all three closures share it and
// print the final value. Bit printed `0 1 2` here before — right only by accident
// of the by-value snapshot, and the opposite of what Go 1.26 gives for the same
// program. The per-iteration rule belongs to `for`, not to `while`.
fn main() {
  let fs = []( () => int )(0)
  let j = 0
  while (j < 3) {
    fs = append(fs, () => j)
    j = j + 1
  }
  print("${fs[0]()} ${fs[1]()} ${fs[2]()}\n")
}
