// run
// SPEC 10.3.1 / 11.7 (#1640): a call to an `extern function` is admitted inside
// a `@nosplit` body. `bit_rt_host_target` is a runtime symbol, so it is present
// in the linked archive on every target and this case is portable; the builtin
// `hostTarget()` reads the same runtime entry point, so the two agreeing proves
// the extern call actually ran and returned its value, not merely that it
// compiled.
extern function bit_rt_host_target(): i64

@nosplit function targetFromExtern(): int {
  return int(bit_rt_host_target())
}

function main() {
  print("agree=${targetFromExtern() == hostTarget()}\n")
}
