// run
// #2128: the shared cell outlives the frame that declared it (SPEC §12.8 — a
// captured variable survives as long as it is reachable), so the returned closure
// still reads the writes its sibling made. Was `get=0`.
fn pair(): () => int {
  let n = 0
  let inc = () => { n = n + 1 }
  inc()
  inc()
  return () => n
}
fn main() {
  let g = pair()
  print("get=${g()}\n")
}
