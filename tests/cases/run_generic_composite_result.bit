// run
// A generic function whose declared RESULT is a composite built from its type
// parameters (§14.1, §14.7) — `[]T`, `[]U`, `map<K, V>` — not just a bare `T`.
// Each type param must substitute all the way into the result type at the call
// site, including a param reachable only through a function-typed parameter
// (`U` in `mapped`, bound from `f: (T) => U`).
//
// The tell for an unsubstituted result is narrow: `len()` still works (it does
// not care about the element type) while indexing or iterating the same value
// cannot compute an element width. So each case here does BOTH.

fn mapped<T, U>(xs: []T, f: (T) => U): []U {
  let out: []U = []U(0)
  for x of xs {
    out = append(out, f(x))
  }
  return out
}

fn keep<T>(xs: []T, ok: (T) => bool): []T {
  let out: []T = []T(0)
  for x of xs {
    if (ok(x)) {
      out = append(out, x)
    }
  }
  return out
}

fn fold<T, A>(xs: []T, init: A, step: (A, T) => A): A {
  let acc = init
  for x of xs {
    acc = step(acc, x)
  }
  return acc
}

fn flip<K, V>(k: K, v: V): map<K, V> {
  let m = map<K, V>()
  m[k] = v
  return m
}

fn main() {
  let nums = [1, 2, 3, 4, 5, 6]

  // []U from a type param bound only through a function-typed parameter.
  let squares = mapped<i64, i64>(nums, (n: i64) => n * n)
  print("${len(squares)} ${squares[0]} ${squares[5]}\n")

  // []T from the first type param; iterate rather than index.
  let evens = keep<i64>(squares, (n: i64) => n % 2 == 0)
  let sum = 0
  for e of evens {
    sum = sum + e
  }
  print("${len(evens)} ${sum}\n")

  // A bare type-param result still works (the case that always did).
  print("${fold<i64, i64>(evens, 0, (a: i64, n: i64) => a + n)}\n")

  // The result type param substitutes into a composite that is not a slice.
  let m = flip<string, i64>("k", 9)
  print("${m["k"]}\n")

  // Changing the element type across the call: []i64 -> []string.
  let names = mapped<i64, string>([1, 2], (n: i64) => "n${n}")
  print("${names[0]} ${names[1]}\n")
}
