// run
// #2322: `select { case (v, ok) = <- c: }`. SPEC §16.3's
// `recv_bind = [ ( IDENT | tuple_pat ) "=" ] "<-" expression` has always
// admitted the pair and the checker types both halves, but only the IDENT form
// was lowered — so `bit check` exited 0 and `bit build` refused the function.
//
// What that cost: a `select`-based worker could not observe that a channel
// closed. Waiting on both a job channel and a cancellation channel meant either
// signalling the close out of band on a second channel, or giving up `select`
// for the plain two-result receive — which lowers, but can then wait on only
// one channel.
//
// A closed channel is permanently ready, so the loop below sees one open
// receive and then two closed ones.
//
// A golden case is a single file, so it has no prelude.
fn feeder(jobs: chan<i64>) {
  jobs <- 7
  close(jobs)
}

fn main() {
  let c = chan<i64>(1)
  c <- 42
  close(c)
  let got = 0
  let sawOpen = 0
  let sawClosed = 0
  for (let i = 0; i < 3; i++) {
    select {
      case (v, ok) = <- c: {
        if (ok) {
          got = v
          sawOpen = sawOpen + 1
        } else {
          sawClosed = sawClosed + 1
        }
      }
    }
  }
  print("got=${got} open=${sawOpen} closed=${sawClosed}\n")

  // The shutdown idiom this unblocks: drain the jobs, and stop when the channel
  // reports closed rather than when a count runs out.
  let jobs = chan<i64>(1)
  let done = chan<i64>(1)
  spawn feeder(jobs)
  let total = 0
  let running = true
  while (running) {
    select {
      case (j, ok) = <- jobs: {
        if (!ok) {
          running = false
        } else {
          total = total + j
        }
      }
      case (q, qok) = <- done: {
        total = total + q
        running = qok
      }
    }
  }
  print("total=${total}\n")

  // The single-binder form still lowers, beside the pair in the same select.
  let one = chan<i64>(1)
  one <- 5
  select {
    case only = <- one:
      print("one=${only}\n")
    case (v2, ok2) = <- done:
      print("unreachable ${v2} ${ok2}\n")
  }

  // A pair binder with `_` in either position.
  let d = chan<i64>(1)
  d <- 9
  close(d)
  select {
    case (_, dok) = <- d:
      print("blank value ${dok}\n")
  }
  select {
    case (dv, _) = <- d:
      print("blank ok ${dv}\n")
  }
}
