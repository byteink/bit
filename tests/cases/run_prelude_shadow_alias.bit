// run
// #3404: same shadow guard as run_prelude_shadow_struct.bit, exercised
// through a `type` alias instead of a `class`. Before the fix this was a
// FALSE REJECTION, not just a build-time E0092: `bit check` rejected the
// annotation itself with `error[E0041]: expected 'Result', found 'untyped
// int'`, because `let r: Result` resolved `Result` to the prelude's generic
// enum rather than this module's `int` alias.
//
// This fixture is expected to score MISSING (not MATCH) in
// selfhost-diffcheck: the pinned stage0 oracle still emits the bogus E0041
// this fixture proves the fixed compiler no longer does, so the oracle is
// outpaced here, not regressed against (see golden.bit's "ACCEPTANCE — the
// MISSING direction, which does not gate" note on why this stays in
// tests/cases rather than tests/bit/).
type Result = int
fn main() {
  let r: Result = 7
  print("${r}\n")
}
