// run
// Taking a method off a concrete STRUCT value without calling it — `let g = p.get`
// — binds the receiver into a closure. A method's ABI already takes its receiver
// as the leading parameter, which is exactly the closure calling convention, so
// the method's own symbol is the closure's code; no trampoline is synthesized.
//
// The seed always did this; the self-hosted lowerer did not, and every `v.m` that
// named no field was reported as an unlowerable function. That is what made
// `bit` unable to build anything importing std/quic: stdlib/tls passes
// `h.clientNewHash` as a `() => Hash` to the key schedule (#1483).
struct P {
  a: i64
}

fn (p: P) get(): i64 {
  return p.a
}

fn (p: P) add(n: i64): i64 {
  return p.a + n
}

fn apply(f: () => i64): i64 {
  return f()
}

fn main() {
  let p = P{ a: 7 }
  let g = p.get
  let h = p.add
  print("${apply(p.get)} ${g()} ${h(5)}\n")
  // The closure holds the receiver object, so a later mutation is visible
  // through the bound method value — the same aliasing a direct call has.
  p.a = 100
  print("${g()} ${p.get()}\n")
}
