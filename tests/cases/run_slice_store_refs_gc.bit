// run
// #3108: REFERENCE elements written through the inline store must survive real
// collections. This is the write-barrier question made checkable, and it is the
// one case in this ticket whose failure mode is a wrong answer rather than a
// panic.
//
// Two distinct things can break here and both are silent.
//
// THE BARRIER. `rt_call slice_set` was a plain `storeWord` and this collector is
// a full stop-the-world mark-sweep (runtime/gc/gccollect.bit), so no barrier was
// being performed and none is being dropped — ref-ness lives in the buffer
// object's type-info descriptor, chosen at allocation by `allocBuf`
// (riRefArray vs riSliceBuf), not in anything the store touches. That is an
// argument, and this is the test that has to agree with it: every string below is
// reachable ONLY through the slice buffer, so if the collector cannot find it
// through the buffer's descriptor it is swept and these print garbage, an empty
// string, or crash. When the GC goes incremental this case is what goes red.
//
// THE MOVED BUFFER. The inline sequence loads `buf` into a plain `i64` vreg that
// no stack map describes, then stores through it. That is only sound because its
// live range contains no safepoint. Every store here is inside a loop, and a loop
// back edge is exactly where `bit_rt_safepoint` is emitted, so if that window
// ever opened this is where it would show.
//
// The garbage loops are what make it a real test rather than a shape: codegen
// emits a safepoint only at back edges, so a straight-line program collects zero
// times no matter how much it allocates, and would pass with the collector
// switched off. The loops dwarf the 4 MiB default trigger. Values are stored
// BEFORE, BETWEEN and AFTER collections so a buffer that went stale part-way is
// caught as a partial answer, not a total one.

fn churn(n: int): int {
  let acc = 0
  let i = 0
  while (i < n) {
    let junk = "junk${i}"
    acc = acc + len(junk)
    i = i + 1
  }
  return acc
}

fn main() {
  let keep = []string(32)

  // Written before any collection has run.
  let i = 0
  while (i < 32) {
    keep[i] = "v${i}"
    i = i + 1
  }

  let acc = churn(20000)

  // Every element must still be intact after the collections above.
  let ok1 = true
  let j = 0
  while (j < 32) {
    if (keep[j] != "v${j}") {
      ok1 = false
    }
    j = j + 1
  }
  print("after-first ok=${ok1}\n")

  // Overwrite half of them once the heap has already been collected, so these
  // stores happen with a buffer that has survived a mark-sweep.
  let k = 0
  while (k < 32) {
    if (k % 2 == 0) {
      keep[k] = "w${k}"
    }
    k = k + 1
  }

  acc = acc + churn(20000)

  let ok2 = true
  let m = 0
  while (m < 32) {
    let want = "v${m}"
    if (m % 2 == 0) {
      want = "w${m}"
    }
    if (keep[m] != want) {
      ok2 = false
    }
    m = m + 1
  }
  print("after-second ok=${ok2}\n")

  // A slice of STRUCT references, stored the same way: the element is a boxed
  // object, so a lost store or an untraced word reads back as a null receiver.
  let boxes = []Box(16)
  let b = 0
  while (b < 16) {
    boxes[b] = Box{v: b * 3}
    b = b + 1
  }

  acc = acc + churn(20000)

  let sum = 0
  let c = 0
  while (c < 16) {
    sum = sum + boxes[c].v
    c = c + 1
  }
  print("boxes sum=${sum} want=360 ok=${sum == 360}\n")
  print("acc=${acc}\n")
}

class Box { v: int }
