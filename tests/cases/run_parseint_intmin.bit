// run
// #2122: parseInt rejected -9223372036854775808 (int64 MIN), the one int
// value it could not round-trip, because it accumulated a positive magnitude
// that would overflow representing it. Fixed by accumulating negatively.
import { parseInt } from "std/strings"

function parseOk(s: string): bool {
  let v = parseInt(s) catch e {
    return false
  }
  return true
}

function main() {
  let minVal = parseInt("-9223372036854775808") catch e {
    panic("intMin should parse, got error: ${e.message()}")
  }
  assert(minVal == -9223372036854775808, "intMin must equal -9223372036854775808, got ${minVal}")
  println("intMin ok: ${minVal}")

  assert(!parseOk("-9223372036854775809"), "one below intMin must still be rejected")
  println("tooNeg rejected")

  assert(!parseOk("9223372036854775808"), "one past intMax (positive intMin magnitude) must still be rejected")
  println("tooPos rejected")

  let maxVal = parseInt("9223372036854775807") catch e {
    panic("intMax should parse, got error: ${e.message()}")
  }
  assert(maxVal == 9223372036854775807, "intMax must equal 9223372036854775807, got ${maxVal}")
  println("intMax ok: ${maxVal}")

  let x: i64 = -9223372036854775808
  let s = "${x}"
  let back = parseInt(s) catch e {
    panic("roundtrip should parse, got error: ${e.message()}")
  }
  assert(back == x, "roundtrip must equal ${x}, got ${back}")
  println("roundtrip ok: ${back}")
}
