// run
// The unsigned-looking values in `.expected` are not a regeneration accident:
// `floatBits` returns a `u64`, and until #2011 interpolation rendered every
// unsigned prim through the SIGNED formatter, so the negative spellings this
// file used to pin were the bug written down. See `run_float_bitexact.bit`.
// #1442: ffloor/fceil/ftrunc/fround are emitted INLINE (FRINT* on AArch64, an
// SSE2 expansion on x86-64) instead of calling into libbitrt. This golden pins
// their exact result BITS against what runtime/root.zig's @floor/@ceil/@trunc/
// @round produce, over every IEEE class that distinguishes a correct
// implementation from a plausible one.
//
// BITS, NOT THE PRINTED NUMBER, and not `==`:
//   - `-0.0 == 0.0` is TRUE, so a comparison-based check silently passes an
//     implementation that has lost the sign of zero. ceil(-1e-300) is -0.0 and
//     the `(x + 2^52) - 2^52` identity gives +0.0; nothing but the bits sees it.
//   - `NaN != NaN` is TRUE, so a comparison-based check FAILS a correct one.
//
// The tie rows (0.5/-0.5/1.5/-1.5/2.5/-2.5) are what separate ties-AWAY-from-
// zero (`fround`, FRINTA) from ties-to-EVEN (FRINTN, roundsd mode 0): a
// nearest-even implementation gives rd_th=2.0 where this file requires 3.0.
//
// A golden case is a single file, so there is no prelude and no std/math --
// the primitives are called directly and inf/nan are built by arithmetic.
function main() {
  let z: f64 = 0.0
  let nz: f64 = -0.0
  let sub: f64 = 5e-324
  let nsub: f64 = -5e-324
  let p2: f64 = 0.2
  let n2: f64 = -0.2
  let ph: f64 = 0.5
  let nh: f64 = -0.5
  let o: f64 = 1.0
  let no: f64 = -1.0
  let oh: f64 = 1.5
  let noh: f64 = -1.5
  let th: f64 = 2.5
  let nth: f64 = -2.5
  let tiny: f64 = 1e-300
  let ntiny: f64 = -1e-300
  let e52: f64 = 4503599627370496.0
  let ne52: f64 = -4503599627370496.0
  let e52h: f64 = 4503599627370495.5
  let ne52h: f64 = -4503599627370495.5
  let big: f64 = 1e300
  let nbig: f64 = -1e300
  let maxfin: f64 = 1.7976931348623157e308
  let inf: f64 = 1.0 / 0.0
  let ninf: f64 = -1.0 / 0.0
  print("fl_z=${floatBits(ffloor(z))}\n")
  print("fl_nz=${floatBits(ffloor(nz))}\n")
  print("fl_sub=${floatBits(ffloor(sub))}\n")
  print("fl_nsub=${floatBits(ffloor(nsub))}\n")
  print("fl_p2=${floatBits(ffloor(p2))}\n")
  print("fl_n2=${floatBits(ffloor(n2))}\n")
  print("fl_ph=${floatBits(ffloor(ph))}\n")
  print("fl_nh=${floatBits(ffloor(nh))}\n")
  print("fl_o=${floatBits(ffloor(o))}\n")
  print("fl_no=${floatBits(ffloor(no))}\n")
  print("fl_oh=${floatBits(ffloor(oh))}\n")
  print("fl_noh=${floatBits(ffloor(noh))}\n")
  print("fl_th=${floatBits(ffloor(th))}\n")
  print("fl_nth=${floatBits(ffloor(nth))}\n")
  print("fl_tiny=${floatBits(ffloor(tiny))}\n")
  print("fl_ntiny=${floatBits(ffloor(ntiny))}\n")
  print("fl_e52=${floatBits(ffloor(e52))}\n")
  print("fl_ne52=${floatBits(ffloor(ne52))}\n")
  print("fl_e52h=${floatBits(ffloor(e52h))}\n")
  print("fl_ne52h=${floatBits(ffloor(ne52h))}\n")
  print("fl_big=${floatBits(ffloor(big))}\n")
  print("fl_nbig=${floatBits(ffloor(nbig))}\n")
  print("fl_maxfin=${floatBits(ffloor(maxfin))}\n")
  print("fl_inf=${floatBits(ffloor(inf))}\n")
  print("fl_ninf=${floatBits(ffloor(ninf))}\n")
  print("ce_z=${floatBits(fceil(z))}\n")
  print("ce_nz=${floatBits(fceil(nz))}\n")
  print("ce_sub=${floatBits(fceil(sub))}\n")
  print("ce_nsub=${floatBits(fceil(nsub))}\n")
  print("ce_p2=${floatBits(fceil(p2))}\n")
  print("ce_n2=${floatBits(fceil(n2))}\n")
  print("ce_ph=${floatBits(fceil(ph))}\n")
  print("ce_nh=${floatBits(fceil(nh))}\n")
  print("ce_o=${floatBits(fceil(o))}\n")
  print("ce_no=${floatBits(fceil(no))}\n")
  print("ce_oh=${floatBits(fceil(oh))}\n")
  print("ce_noh=${floatBits(fceil(noh))}\n")
  print("ce_th=${floatBits(fceil(th))}\n")
  print("ce_nth=${floatBits(fceil(nth))}\n")
  print("ce_tiny=${floatBits(fceil(tiny))}\n")
  print("ce_ntiny=${floatBits(fceil(ntiny))}\n")
  print("ce_e52=${floatBits(fceil(e52))}\n")
  print("ce_ne52=${floatBits(fceil(ne52))}\n")
  print("ce_e52h=${floatBits(fceil(e52h))}\n")
  print("ce_ne52h=${floatBits(fceil(ne52h))}\n")
  print("ce_big=${floatBits(fceil(big))}\n")
  print("ce_nbig=${floatBits(fceil(nbig))}\n")
  print("ce_maxfin=${floatBits(fceil(maxfin))}\n")
  print("ce_inf=${floatBits(fceil(inf))}\n")
  print("ce_ninf=${floatBits(fceil(ninf))}\n")
  print("tr_z=${floatBits(ftrunc(z))}\n")
  print("tr_nz=${floatBits(ftrunc(nz))}\n")
  print("tr_sub=${floatBits(ftrunc(sub))}\n")
  print("tr_nsub=${floatBits(ftrunc(nsub))}\n")
  print("tr_p2=${floatBits(ftrunc(p2))}\n")
  print("tr_n2=${floatBits(ftrunc(n2))}\n")
  print("tr_ph=${floatBits(ftrunc(ph))}\n")
  print("tr_nh=${floatBits(ftrunc(nh))}\n")
  print("tr_o=${floatBits(ftrunc(o))}\n")
  print("tr_no=${floatBits(ftrunc(no))}\n")
  print("tr_oh=${floatBits(ftrunc(oh))}\n")
  print("tr_noh=${floatBits(ftrunc(noh))}\n")
  print("tr_th=${floatBits(ftrunc(th))}\n")
  print("tr_nth=${floatBits(ftrunc(nth))}\n")
  print("tr_tiny=${floatBits(ftrunc(tiny))}\n")
  print("tr_ntiny=${floatBits(ftrunc(ntiny))}\n")
  print("tr_e52=${floatBits(ftrunc(e52))}\n")
  print("tr_ne52=${floatBits(ftrunc(ne52))}\n")
  print("tr_e52h=${floatBits(ftrunc(e52h))}\n")
  print("tr_ne52h=${floatBits(ftrunc(ne52h))}\n")
  print("tr_big=${floatBits(ftrunc(big))}\n")
  print("tr_nbig=${floatBits(ftrunc(nbig))}\n")
  print("tr_maxfin=${floatBits(ftrunc(maxfin))}\n")
  print("tr_inf=${floatBits(ftrunc(inf))}\n")
  print("tr_ninf=${floatBits(ftrunc(ninf))}\n")
  print("rd_z=${floatBits(fround(z))}\n")
  print("rd_nz=${floatBits(fround(nz))}\n")
  print("rd_sub=${floatBits(fround(sub))}\n")
  print("rd_nsub=${floatBits(fround(nsub))}\n")
  print("rd_p2=${floatBits(fround(p2))}\n")
  print("rd_n2=${floatBits(fround(n2))}\n")
  print("rd_ph=${floatBits(fround(ph))}\n")
  print("rd_nh=${floatBits(fround(nh))}\n")
  print("rd_o=${floatBits(fround(o))}\n")
  print("rd_no=${floatBits(fround(no))}\n")
  print("rd_oh=${floatBits(fround(oh))}\n")
  print("rd_noh=${floatBits(fround(noh))}\n")
  print("rd_th=${floatBits(fround(th))}\n")
  print("rd_nth=${floatBits(fround(nth))}\n")
  print("rd_tiny=${floatBits(fround(tiny))}\n")
  print("rd_ntiny=${floatBits(fround(ntiny))}\n")
  print("rd_e52=${floatBits(fround(e52))}\n")
  print("rd_ne52=${floatBits(fround(ne52))}\n")
  print("rd_e52h=${floatBits(fround(e52h))}\n")
  print("rd_ne52h=${floatBits(fround(ne52h))}\n")
  print("rd_big=${floatBits(fround(big))}\n")
  print("rd_nbig=${floatBits(fround(nbig))}\n")
  print("rd_maxfin=${floatBits(fround(maxfin))}\n")
  print("rd_inf=${floatBits(fround(inf))}\n")
  print("rd_ninf=${floatBits(fround(ninf))}\n")
  // NaN is checked as an IDENTITY, not against a constant: `0.0/0.0` at
  // runtime gives the hardware default NaN, which is NEGATIVE on x86-64
  // (0xFFF8..) and POSITIVE on AArch64 (0x7FF8..). The property these ops
  // owe is that a NaN comes back with its bits untouched, and that is
  // portable. It is a real check: the magnitude guard is the only reason a
  // NaN never reaches the cvttsd2si round trip, which would return
  // INT64_MIN and turn it into -9.22e18.
  let nan: f64 = 0.0 / 0.0
  print("fl_nan_unchanged=${floatBits(ffloor(nan)) == floatBits(nan)}\n")
  print("ce_nan_unchanged=${floatBits(fceil(nan)) == floatBits(nan)}\n")
  print("tr_nan_unchanged=${floatBits(ftrunc(nan)) == floatBits(nan)}\n")
  print("rd_nan_unchanged=${floatBits(fround(nan)) == floatBits(nan)}\n")
  // ---- fneg on a value the constant folder cannot see through --------
  // `-<literal>` is folded at lowering, so a literal never exercises the
  // fneg CODEGEN path. These operands are op RESULTS, so they do. x86-64
  // expanded fneg as `0.0 - x`, which returns +0.0 for -0.0 and CLEARS a
  // NaN's sign bit; the fix flips the sign bit instead. AArch64 always used
  // a real FNEG and was never affected.
  let dnz: f64 = ffloor(nz)   // -0.0 at runtime, not a literal
  let dz: f64 = ffloor(z)     // +0.0 at runtime
  print("neg_dnz=${floatBits(-dnz)}\n")
  print("neg_dz=${floatBits(-dz)}\n")
  // NaN's bits are not portable, so assert that negation FLIPS them.
  let dnan: f64 = ftrunc(nan)
  print("neg_nan_flips=${floatBits(-dnan) != floatBits(dnan)}\n")
}
