// run
// #2123's other half: what the §14.6 comparability rule must NOT reject. Every
// line here compiles and answers correctly today, and the rejection added for
// slices/maps/functions/payload enums is one carve-out away from taking these
// with it — a C-like enum is an integer tag and DOES compare, and a map or a
// function value IS comparable against `nil` even though it is comparable
// against nothing else. Single-file golden: no prelude.
enum Colour { Red, Green }

function f(x: int): int { return x }

function main() {
  print("${Colour.Red == Colour.Red} ${Colour.Red == Colour.Green}\n")
  let n = 7
  let u: u8 = 200
  print("${n == 7} ${n < 8} ${u == 200} ${u > 199}\n")
  print("${1.5 < 2.5} ${'a' < 'b'}\n")
  let s = "abc"
  print("${s == "abc"} ${s < "abd"} ${s >= "abc"}\n")
  print("${true == true} ${true != false}\n")
  let m = map<int, int>()
  let g = f
  print("${m == nil} ${g == nil}\n")
}
