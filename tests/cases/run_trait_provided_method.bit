// run
// Traits (SPEC §10.7, #3369): a class that `use`s a trait never declares
// the trait's PROVIDED method (`dead`) itself, yet calling it runs the
// trait's own body — injected into `Enemy` at check time, with `this`
// bound to the using class. `hurt` is REQUIRED (no body in the trait) and
// is satisfied by the class's own in-body method (#3367).
trait Damageable {
  hurt(n: i64)
  dead(): bool { return this.hp() <= 0 }
}

class Enemy {
  use Damageable

  hp0: i64
  hurt(n: i64) { this.hp0 = this.hp0 - n }
  hp(): i64 { return this.hp0 }
}

fn main() {
  let e = Enemy{ hp0: 10 }
  e.hurt(3)
  print("${e.dead()}\n")
  e.hurt(10)
  print("${e.dead()}\n")
}
