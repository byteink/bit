// run
// A module-level `const` interpolated in a string must resolve even when it is
// declared textually *after* the referencing function. The checker types every
// top-level binding before any function body, so a forward reference is a real
// type (not `.invalid` poison that once miscompiled or died unlocated in
// lowering) — see #1238. Covers both the string and integer to-string paths.
fn main() {
  print("s=${S} n=${N}\n")
}

const S: string = "hi"
const N: i64 = 42
