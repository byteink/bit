// ir
// #1428: a spawned generic's thunk layout must be built from the SUBSTITUTED
// parameter types. `T` binds to `i64` here, so the slot at offset 0 holds a
// plain integer and must NOT appear in the gc_alloc's `ptrs=[...]`. Built from
// the unsubstituted template instead, `T` is a non-primitive and therefore
// classifies as a GC reference, giving `ptrs=[0, 8]` — and the collector then
// walks the integer 7 as a pointer. That descriptor is the whole point of this
// golden; the callee symbol below (`idg$0`, the monomorphized instance, not the
// bare `idg` the source spells) is the other half of the same fix.
function idg<T>(x: T, out: chan<T>) {
  out <- x
}
function main() {
  let c = chan<int>(1)
  spawn idg(7, c)
}
