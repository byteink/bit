// run
// #2128: a nested closure writing a capture of the ENCLOSING closure reaches the
// outermost frame's cell — the capture stays boxed across every boundary it is
// packed through, not just the first. Was `outer=0 n=0`.
fn main() {
  let n = 0
  let outer = () => {
    let inner = () => { n = n + 1 }
    inner()
    inner()
    return n
  }
  print("outer=${outer()} n=${n}\n")
}
