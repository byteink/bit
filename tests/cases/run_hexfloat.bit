// run
// Hex float literals (SPEC 5.5). Guards #1857: `parseFloat` had no hex branch
// at all, and because unparsable text yields 0 rather than an error, every
// `0x…p…` literal silently became ±0.0 — sign kept, magnitude discarded.
//
// Nothing in stdlib/, examples/, tests/cases/ or tests/imports/ used a hex
// float, and those four directories ARE the differential corpus, so fifteen
// green gates never once compared this construct. Its only user was
// runtime/root, whose coefficient tables it zeroed: `bit_rt_log` returned 0 for
// every input until #1593 first asked the self-hosted compiler to build the
// runtime. This case exists so that cannot recur silently.

function main() {
  // Sign, and an exponent below 1.
  print("a=${-0x1p-1}\n")
  // A full 52-bit mantissa — the shape musl's log coefficients actually use.
  print("b=${0x1.5555555555577p-2}\n")
  // Exponent zero, and a positive exponent.
  print("c=${0x1p0} d=${0x1.8p1}\n")
  // Upper-case digits, upper-case P, explicit `+`.
  print("f=${0x1.ABCDEFp+4}\n")
  // Zero stays zero, sign preserved.
  print("g=${0x0p0} h=${-0x0p0}\n")
  // Large and small exponents, well inside range.
  print("i=${0x1p100} j=${0x1p-100}\n")
}
