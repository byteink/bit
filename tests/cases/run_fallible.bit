// run
// Fallible functions (§18): `!` marks a result "T or error", `fail` produces
// the error, `?` propagates it to the caller, and `catch` handles it locally
// (either with a default value or a binding block). A user-defined type
// satisfies the predeclared `error` interface structurally via `message()`.
class myErr {
  code: i64
  message(): string { return "code=${this.code}" }
}
fn checked(n: i64): i64! {
  if (n < 0) {
    fail myErr{ code: n }
  }
  return n * 2
}

// `?` bubbles a negative up to our caller; a non-negative doubles twice.
fn twice(n: i64): i64! {
  let a = checked(n)?
  let b = checked(a)?
  return b
}

fn main() {
  let good = twice(3) catch -1
  print("good=${good}\n")

  let bad = twice(-5) catch -1
  print("bad=${bad}\n")

  let handled = twice(-9) catch e {
    print("err: ${e.message()}\n")
    0
  }
  print("handled=${handled}\n")
}
