// panic-debug
// #3087 (epic #3076): arm64/x64 `--debug` builds emit an overflow-checked
// signed sub (#3080/#3082) that must TRAP when a runtime i64 MIN - 1
// underflows the type's range (SPEC §13.5). `one()` is routed through
// `len(args())` so `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve
// this subtraction as a compile-time constant. Sibling of
// overflow_trap_sub_release.bit: the identical expression, built WITHOUT
// `--debug`, where the same overflow must silently wrap instead.
import { args } from "std/os"

fn one(): int { return len(args()) }

fn main() {
  print("start\n")
  let x: i64 = -9223372036854775807 - 1
  print("diff=${x - one()}\n")
  print("unreachable\n")
}
