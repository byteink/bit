// run
// The second killer (#1158): a wrapped u32 feeding an unsigned compare
// in-register. 0xFFFFFFFF + 1 wraps to 0, so (0 < 5) is true. A full-width add
// leaves 0x100000000, which compares as > 5 unsigned — the wrong answer.
//
// `blackbox` (multi-block, so never inlined/folded at -O1) hands the add a
// value the optimizer treats as unknown, forcing the compare to run in codegen.
function blackbox(x: u32): u32 {
  if (x == 0) { return 0 }
  return x
}

function main() {
  let a: u32 = blackbox(0xFFFFFFFF)
  let x: u32 = a + 1
  print("${x < 5}\n")
}
