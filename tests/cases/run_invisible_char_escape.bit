// run
// #2165, the ACCEPT half: every character the three checkercases reject
// (tests/bit/checkercases/check_invisible_nul_string.bit,
// check_invisible_zero_width_space.bit,
// check_invisible_bidi_unpaired_comment.bit) has a visible escape spelling
// that must keep compiling unchanged, so the diagnostic costs an author
// nothing beyond typing it out. Single-file golden: no prelude.
fn main() {
  let a = "a\0b"
  let z = "a\u{200B}b"
  print("${len(a)} ${len(z)}\n")
}
