// run
// #2128, the two directions of sharing that a snapshot cannot give: the frame
// sees a write the closure made (`n=2`, was `n=0`), and a closure created BEFORE
// the frame's own write still sees it (`sees 41`, was `sees 0`). The second half
// is a READ, which is why a diagnostic could not have been the answer here.
function main() {
  let n = 0
  let bump = () => { n = n + 1 }
  bump()
  bump()
  print("n=${n}\n")
  let peek = () => { print("sees ${n}\n") }
  n = 41
  peek()
}
