// run
// The two-result map index `let (v, ok) = m[k]` (SPEC §12.6). A missing key
// yields the value type's zero value either way, so `ok` is the only thing that
// separates "absent" from "present and zero" — which the `stored 0 true` case
// below is here to pin down.
function main() {
  let m = map<string, i64>()
  m["a"] = 7
  m["zero"] = 0

  let (v1, ok1) = m["a"]
  print("hit ${v1} ${ok1}\n")

  let (v2, ok2) = m["nope"]
  print("miss ${v2} ${ok2}\n")

  // The whole point of `ok`: a stored 0 is indistinguishable from an absent key
  // by value alone.
  let (v3, ok3) = m["zero"]
  print("stored 0 ${v3} ${ok3}\n")

  // Both assignment spellings — parenthesized and bare — target existing locals.
  let v = -1
  let ok = false
  (v, ok) = m["a"]
  print("paren ${v} ${ok}\n")
  v, ok = m["nope"]
  print("bare ${v} ${ok}\n")

  // `_` discards the value word.
  let (_, ok4) = m["a"]
  print("blank ${ok4}\n")
}
