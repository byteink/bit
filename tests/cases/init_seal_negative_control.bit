// run
// #3371: the negative control for the 'init' composite-literal seal
// (E0110, classinit.bit) — a class declaring NO 'init' is never sealed, so
// its composite literal must still compile from a DIFFERENT module
// (./initnomodule), exactly as before this ticket. Without this the seal
// could be accidentally applying to every class rather than only the ones
// that declare 'init'.
import { PlainRecord } from "./initnomodule"

fn main() {
  let r = PlainRecord{ n: 7 }
  print("n=${r.n}\n")
}
