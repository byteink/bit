// run
// Numeric conversions T(x) (§12.9): explicit, no implicit narrowing. Covers
// int↔int (sign/zero extend + truncate), int↔float (truncating toward zero),
// and f32↔f64, then the byte→int case that byte iteration needs.
function main() {
  let b: u8 = 200
  print("u8->i64: ${i64(b)}\n")
  print("i64->u8: ${u8(300)}\n")

  let neg: i8 = -5
  print("i8->i64: ${i64(neg)}\n")

  print("i64->f64: ${f64(10)}\n")
  print("f64->i64: ${i64(3.9)} ${i64(-3.9)}\n")
  print("f32->f64: ${f64(f32(2.5))}\n")

  let s = "abc"
  let total = 0
  let i = 0
  while (i < len(s)) {
    total = total + i64(s[i])
    i = i + 1
  }
  print("bytesum: ${total}\n")
}
