// run
// A missing key yields the value type's zero value (SPEC §12.6, §13.4). For a
// reference-typed V the zero the runtime can report is the null word, which is
// not usable: `len` on a null slice/string header has no `len` word to load and
// a null class has no fields, so a miss used to fault (#1557). Every miss below
// must hand back a live zero object instead.
class Point {
  x: i64
  label: string
  tags: []i64
}

fn main() {
  let ms = map<i64, []i64>()
  ms[1] = [7, 8]
  print("hit ${len(ms[1])}\n")
  let miss = ms[2]
  print("slice ${len(miss)}\n")
  // The zero slice is a real, growable slice, not a shared empty singleton.
  let grown = append(miss, 5)
  print("append ${len(grown)} ${grown[0]} ${len(ms[2])}\n")

  let mstr = map<i64, string>()
  mstr[1] = "abc"
  print("string ${len(mstr[9])} [${mstr[9]}]\n")

  let mp = map<i64, Point>()
  mp[1] = Point{x: 3, label: "p", tags: [1]}
  let zp = mp[2]
  print("class ${zp.x}\n")

  // The two-result form reports the miss and still yields the same usable zero.
  let (v, ok) = ms[3]
  print("commaok ${ok} ${len(v)}\n")
  let (sv, sok) = mstr[3]
  print("commaok ${sok} ${len(sv)}\n")

  // A declared-but-uninitialized slice is the same zero value.
  let dz: []i64
  print("decl ${len(dz)}\n")
}
