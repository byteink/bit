// run
// Traits (SPEC §10.7, #3369): `Self` in a trait's own result type resolves
// to the using class at injection time, so a fluent, chainable trait
// method returns the CONCRETE class (`Enemy`, not some abstract "Self"
// type) and a second trait method can be chained straight off the result.
trait Buildable {
  withHp(n: i64): Self {
    this.hp = n
    return this
  }
  withName(s: string): Self {
    this.name = s
    return this
  }
}

class Enemy {
  use Buildable
  hp: i64
  name: string
}

fn main() {
  let e = Enemy{ hp: 0, name: "" }
  let e2 = e.withHp(30).withName("x")
  print("${e2.hp} ${e2.name}\n")
}
