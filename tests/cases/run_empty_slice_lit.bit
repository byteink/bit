// run
// An empty slice literal must not swallow the next statement as its element
// type (#1441). `[]` is only a slice TYPE when an element type follows it, so
// each `[]` here is a value and ASI ends the statement at the `]`.
fn main() {
  let xs: []string = []
  print("len=${len(xs)}\n")
  xs = append(xs, "a")
  print("after append: len=${len(xs)} x0=${xs[0]}\n")
  let ns: []int = []
  print("ns=${len(ns)}\n")
  // The slice-type spelling still parses as a type when one follows.
  let bs = []byte("hi")
  print("bs=${len(bs)}\n")
}
