// doc

// Holds a value.
export class Box<T> { value: T }

// Maybe holds a value.
export enum Maybe<T> { Some(T), None }

// Picks a default or the maybe's value.
export fn pick<T, E>(m: Maybe<T>, dflt: T, e: E): T {
  match (m) {
    Some(v) => return v
    None => return dflt
  }
}

// A point.
export class Point { x: int, y: int }
