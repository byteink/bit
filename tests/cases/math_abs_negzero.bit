// run
// std/math's `abs` must clear the sign bit, IEEE 754-2019 §5.5.1, not compare
// against zero (#2269). `if (x < 0.0) { return -x }` fell through for `-0.0`
// (`-0.0 < 0.0` is false), so `abs(-0.0)` returned `-0.0`.
//
// EVERY ASSERTION HERE IS A DIVISION, ON PURPOSE. `-0.0 == 0.0` is true in
// IEEE 754, so `abs(-0.0) == 0.0` passes with the bug present — that is exactly
// how this survived. Dividing into the result is what makes the sign
// observable: `1.0 / +0.0` is `inf` and `1.0 / -0.0` is `-inf`.
//
// `nzComputed` matters as much as the literal: `0.0 * -1.0` is `-0.0`, so a
// negative zero arrives from ordinary arithmetic (a delta that cancelled from
// the wrong side) and not only from someone typing `-0.0`.
//
// The non-zero rows pin that clearing the sign bit did not change the ordinary
// cases, including the extremes where a `0.0 - x` implementation would differ.
// Siblings audited in the same sweep and NOT changed: `floor`/`ceil`/`round`/
// `trunc`/`sqrt`/`pow` and unary negation already produce the IEEE-correct
// signed zero (they are hardware instructions), and `sign(-0.0)` returning
// `+0.0` is the documented convention. `min`/`max` are wrong for one argument
// order each; that is #2420, not this.
import { abs } from "std/math"

// `inf`, `-inf` or a finite quotient — the only way to read the SIGN of a zero
// without a bit-level primitive, and the assertion the ticket specifies.
function recip(x: f64): f64 {
  return 1.0 / x
}

function main() {
  let nzLiteral = -0.0
  let nzComputed = 0.0 * -1.0

  println("abs(-0.0)=${abs(nzLiteral)} recip=${recip(abs(nzLiteral))}")
  println("abs(0.0*-1.0)=${abs(nzComputed)} recip=${recip(abs(nzComputed))}")
  println("abs(+0.0)=${abs(0.0)} recip=${recip(abs(0.0))}")
  println("abs(-3.5)=${abs(-3.5)} abs(3.5)=${abs(3.5)}")
  // The subnormal is compared rather than printed: its positional expansion is
  // 300+ bytes and says nothing this does not.
  println("abs(-1.0/0.0)=${abs(-1.0 / 0.0)} minSubnormalExact=${abs(0.0 - 5e-324) == 5e-324}")
  println("recip(-0.0)=${recip(nzLiteral)}")
}
