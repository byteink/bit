// run
// #2146: an embedded NUL byte in a path string must be rejected, not silently
// truncated. `newBuilder().writeByte(0)` embeds a real NUL (unlike a `"\0"`
// literal, which some editors mangle), so `fs.exists`/`fs.readFile` on the
// NUL-poisoned path must fail even though the string's own `hasSuffix` check
// (a stand-in for an application's path-validation policy) sees ".txt" and
// passes it.
import { envOr } from "std/os"
import { exists, readFile, mkdir, writeFile, remove } from "std/fs"
import { hasSuffix, newBuilder } from "std/strings"

function main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_path_nul_${timeUnixNs()}"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }
  let secret = "${dir}/secret.key"
  writeFile(secret, "TOP-SECRET-PRIVATE-KEY-MATERIAL") catch _ {
    println("setup failed: cannot write ${secret}")
    return
  }

  // A ".txt"-only policy, exactly the shape a real caller's exclude/allow list
  // takes. The Bit string legitimately ends in ".txt" — the policy is right.
  let attack = newBuilder().write(secret).writeByte(0).write(".txt").toString()
  println("nul-poisoned path policy allows it = ${hasSuffix(attack, ".txt")}")
  println("nul-poisoned path exists()         = ${exists(attack)}")
  println("nul-poisoned path readFile()       = ${readFile(attack) catch "<denied>"}")

  // The real path, unpoisoned, must still work exactly as before.
  println("control path exists()              = ${exists(secret)}")
  println("control path readFile()            = ${readFile(secret) catch "<denied>"}")

  remove(secret) catch _ { return }
  remove(dir) catch _ { return }
}
