// run
// A local binding shadows a free function's NAME in one function; a call to the
// free function in ANOTHER function must still resolve — and still be validated
// (#1502). Before the checker asked the resolver, the module-wide flat env said
// "twice is a local" for the whole module, so this call was never validated at
// all; the risk of asking properly is refusing this, which is valid code.
fn twice(n: i64): i64 {
  return n * 2
}

fn shadower() {
  let twice = 5
  print("${twice}\n")
}

fn main() {
  shadower()
  print("${twice(21)}\n")
}
