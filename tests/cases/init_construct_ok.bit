// run
// #3371: `init` constructors (SPEC §10.4) — `Account(500)?` allocates a
// zero-valued Account, runs 'init' on it, and yields the constructed value; a
// failing 'init' propagates its error through the ordinary fallible channel
// (§18), caught here with `catch`, used as a bare statement so its
// intentionally-discarded ok value needs no binding (§16 expr_stmt).
// A single-file golden gets no prelude, so the error type is declared
// locally (mirrors check_catch_binds_error_type.bit) rather than pulled from
// std/errors.
class NegativeBalance { requested: i64 }
fn (e: NegativeBalance) message(): string {
  return "negative opening balance: ${e.requested}"
}

class Account {
  balance: i64

  init(opening: i64)!NegativeBalance {
    if (opening < 0) {
      fail NegativeBalance{ requested: opening }
    }
    this.balance = opening
  }

  deposit(n: i64) {
    this.balance = this.balance + n
  }
}

fn main(): ()! {
  let a = Account(500)?
  a.deposit(25)
  print("balance=${a.balance}\n")

  Account(-1) catch e {
    print("rejected: ${e.message()}\n")
    return
  }
}
