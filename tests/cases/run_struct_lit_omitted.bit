// run
// What a struct literal MAY still omit, after #1914 made a struct-typed field
// non-omittable (E0083, covered by error_struct_no_zero_value.bit).
//
// The rule is narrow on purpose. A field whose zero value is zero BITS stays
// omittable, because that is exactly what the literal's `gc_alloc` already
// wrote: scalars, strings, slices and maps. Only a struct-typed field is
// refused, because a struct is a reference and zero bits there is a null.
//
// An inline ARRAY field is the case worth pinning, and it is why this file
// survived the rule rather than being deleted with it. An array field lives in
// the struct's OWN storage rather than as a handle, so the zeroed allocation is
// already a valid zeroed array — there is nothing to fill in. #1914 briefly
// shipped a lowering pass that filled omitted struct AND array fields, and
// deleting it had to not regress this. `arr[2]` reading 0 below is that check.
struct Inner { xs: []u32, n: int }
struct Outer { a: int, b: Inner, arr: [3]int, name: string }

function main() {
  // `b` is named because it must be; everything else here is omitted.
  let o = Outer{ b: Inner{} }
  print("a=")
  print(itoa(o.a))
  print(" b.xs=")
  print(itoa(len(o.b.xs)))
  print(" b.n=")
  print(itoa(o.b.n))
  print(" arr[2]=")
  print(itoa(o.arr[2]))
  print(" name=[")
  print(o.name)
  print("]\n")

  // The struct-typed field is a real instance, not a placeholder: it is
  // writable, and a slice inside it grows.
  let p = Outer{ a: 1, b: Inner{ n: 3 }, arr: [3]int{4, 5, 6} }
  p.b.n = 9
  p.b.xs = append(p.b.xs, u32(2))
  print("p.a=")
  print(itoa(p.a))
  print(" p.arr[1]=")
  print(itoa(p.arr[1]))
  print(" p.b.n=")
  print(itoa(p.b.n))
  print(" p.b.xs=")
  print(itoa(len(p.b.xs)))
  print("\n")

  // A struct with NO struct-typed field still has a zero value, so the
  // initializer-less binding keeps working — the rule refuses one shape, not
  // the feature.
  let q: Inner
  print("q.xs=")
  print(itoa(len(q.xs)))
  print(" q.n=")
  print(itoa(q.n))
  print("\n")
}

function itoa(n: int): string {
  if (n == 0) { return "0" }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) { s = d[v % 10 : v % 10 + 1] + s; v = v / 10 }
  return s
}
