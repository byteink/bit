// run
// A struct literal that omits a struct-typed field must leave that field a LIVE
// zero instance, not a null reference (#1914). SPEC §13.4: "struct -> a live
// instance with each field zero-valued (structs are references, so `let p: Point`
// yields a usable zeroed `Point`, not `nil`)", and §15.6 permits omitting any
// field from a keyed literal.
//
// Before the fix this SIGSEGVed on the first read through `o.b`: `GcAlloc` zeroes
// the object, which is the correct zero value for a scalar, a string or a slice,
// but a struct field needs an object of its own and zero bits are a null
// reference. Reached from ordinary code with no unsafe construct in it, and the
// crash lands arbitrarily far from the literal — `stdlib/crypto`'s
// `RsaPrivateKey{n, e, d}` short form is how it was found.
//
// An inline array field is covered too: its zero value is `newArray`, not zero
// bits, and it is copied into the struct's own storage rather than stored as a
// handle.
struct Inner { xs: []u32, n: int }
struct Outer { a: int, b: Inner, arr: [3]int }

function main() {
  let o = Outer{ a: 7 }
  print("a=")
  print(itoa(o.a))
  print(" b.xs=")
  print(itoa(len(o.b.xs)))
  print(" b.n=")
  print(itoa(o.b.n))
  print(" arr[2]=")
  print(itoa(o.arr[2]))
  print("\n")

  // The named fields still work, and an omitted field is writable afterwards —
  // it is a real instance, not a placeholder.
  let p = Outer{ a: 1, arr: [3]int{4, 5, 6} }
  p.b.n = 9
  print("p.a=")
  print(itoa(p.a))
  print(" p.arr[1]=")
  print(itoa(p.arr[1]))
  print(" p.b.n=")
  print(itoa(p.b.n))
  print("\n")
}

function itoa(n: int): string {
  if (n == 0) { return "0" }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) { s = d[v % 10 : v % 10 + 1] + s; v = v / 10 }
  return s
}
