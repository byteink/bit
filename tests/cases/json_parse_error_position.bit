// run
// stdlib/json/parse.bit's error-position tracking (#2286): every `jsonParse`
// error carries its byte offset and 1-based line:column, not just a bare
// category string. A golden case can import std/json (#2421: `checkRun` runs
// `bit build` with `BIT_STDLIB` exported), so this exercises the real module
// rather than a redeclared local copy.
//
// Four distinct malformed shapes, each locating a different failure site in
// stdlib/json/parse.bit:
//   - a bad token mid-object (a missing comma between two entries)
//   - an unterminated object (the error is at EOF — the position just past
//     the last byte, not an out-of-range value or a silent zero)
//   - a strict-JSON trailing comma (rejected: after the comma the parser
//     expects a value and finds the closing `]` instead)
//   - an invalid `\` escape inside a string
import { jsonParse } from "std/json"

fn msg(src: string): string {
  let v = jsonParse(src) catch e { return e.message() }
  return "no error"
}

fn main() {
  print("bad_token=" + msg("{\"a\":1 \"b\":2}") + "\n")
  print("unterminated=" + msg("{\"a\":1") + "\n")
  print("trailing_comma=" + msg("[1,2,]") + "\n")
  print("invalid_escape=" + msg("\"\\q\"") + "\n")
  print("done\n")
}
