// run
class Stack<T> {
  items: []T,
}

fn (s: Stack<T>) push(v: T): Stack<T> {
  s.items = append(s.items, v)
  return s
}

fn (s: Stack<T>) size(): i64 {
  return len(s.items)
}

fn (s: Stack<T>) top(): T {
  return s.items[len(s.items) - 1]
}

class Pair<A, B> {
  a: A,
  b: B,
}

fn (p: Pair<A, B>) first(): A {
  return p.a
}

fn (p: Pair<A, B>) second(): B {
  return p.b
}

fn main() {
  let ints = Stack<i64>{ items: [1, 2, 3] }
  print("${ints.size()} ${ints.top()}\n")

  let strs = Stack<string>{ items: ["a", "b"] }
  print("${strs.size()} ${strs.top()}\n")

  let grown = Stack<i64>{ items: [] }
  print("${grown.push(10).push(20).size()}\n")

  let p = Pair<i64, string>{ a: 7, b: "z" }
  print("${p.first()} ${p.second()}\n")
}
