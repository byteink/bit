// error
// The predeclared `error` interface (§10.6) carries `message(): string`, not
// `show(): string`, so an error value does not interpolate either — print
// `e.message()` instead. Rejected here rather than in lowering.
struct Boom { why: string }
fn (b: Boom) message(): string { return b.why }
fn blow(): i64! {
  fail Boom{why: "no"}
}
fn main() {
  let v = blow() catch e {
    print("${e}\n")
    0
  }
  print("${v}\n")
}
