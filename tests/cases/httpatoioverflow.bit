// run
// #2175: http.atoi must never silently wrap on an overflowing magnitude — the
// same "return -1, do not wrap" guard strings.parseInt already uses.
import { atoi } from "std/http"

function main() {
  print("${atoi("0")}\n")
  print("${atoi("9223372036854775807")}\n")
  print("${atoi("9223372036854775808")}\n")
  print("${atoi("99999999999999999999999999")}\n")
  print("${atoi("")}\n")
  print("${atoi("12a3")}\n")
}
