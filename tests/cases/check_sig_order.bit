// error
// Diagnostic ORDER across the two declaration phases (SPEC §14.8, #1550).
//
// The seed judges every declaration's type nodes in ONE source-order phase —
// struct fields and function signatures together — and only then the module
// bindings. So the order here is NOT source order: the struct field on line 12
// and the signature on line 15 both precede the `const` on line 11.
//
// The self-hosted compiler swept signatures from vFuncDecl, which runs in the
// main arena pass after both pre-passes, so `f`'s signature sorted LAST. The set
// was identical and only the sequence diverged, which no corpus file caught
// because none paired a bad signature with a bad module binding.
const c1: map<[]int, int> = map<[]int, int>{}
struct A { m: map<[]int, int> }
function f(p: map<[]int, int>) { }
function main() { print("x\n") }
