// types
// SPEC 10.3.1 / 11.8 (#1640): a raw `syscall` is admitted inside a `@nosplit`
// body — both backends emit the kernel trap inline, so it is not a call at all
// and takes no safepoint. Checked in `// types` mode rather than `// run`
// because emitting a `syscall` is Linux-only (§11.8) while a golden runs
// natively; what is under test here is the checker's verdict.
@nosplit fn mapPages(n: i64): i64 {
  let p = syscall(i64(9), 0, n, i64(3), i64(34), 0 - 1, 0)
  if (p < 0) { return 0 }
  return p
}

fn main() {
  let unused = mapPages(4096)
}
