// run
// A scalar int param whose live range spans a loop that never uses it, then
// is read after the loop. The loop back-edge inserts a synthetic
// `bit_rt_safepoint` call; the param must survive it (#1236 — it used to be
// left in a caller-saved register the safepoint call clobbered).
function f(a: int): int {
  let i = 0
  while (i < 3) { i = i + 1 }
  return a + 1
}
function main() {
  print("${f(497)}\n")
}
