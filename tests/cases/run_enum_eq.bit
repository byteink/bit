// run
// A C-like enum is an integer tag, so `==`/`!=` compare tags (§14.6). Payload
// enums still need `match` (structural equality is future work). Before this,
// `comparable` excluded every enum as a Stage-1 deferral.
enum Dir { North, East, South, West }

fn opposite(d: Dir): Dir {
  if (d == Dir.North) { return Dir.South }
  if (d == Dir.South) { return Dir.North }
  if (d == Dir.East) { return Dir.West }
  return Dir.East
}

fn main() {
  let d = Dir.East
  if (opposite(d) == Dir.West) { print("ok ") }
  if (d != Dir.North) { print("ne ") }
  print("\n")
}
