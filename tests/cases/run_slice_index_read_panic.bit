// panic
// #2014: `xs[i]` past the end must panic (SPEC §12.6, §18.4), not evaluate to 0.
// The Bit runtime port made `bit_rt_slice_get` return 0 out of range and left the
// panic to "the layer that owns the write path"; nothing in `compiler/` ever
// referenced `slice_in_bounds`, so the panic was lost end to end and EVERY
// out-of-bounds read in every program yielded zero with exit 0. That is worse
// than the crash it replaced: the program continues on fabricated data.
//
// Every release through 0.1.8 shipped it, so this file and its five siblings are
// the first coverage the behaviour has ever had.
//
// The index comes from `len(args())` so nothing folds at compile time — neither
// the optimizer nor a future compile-time-range diagnostic can retire this case,
// only a real runtime check can.
import { args } from "std/os"

function oob(): int { return len(args()) + 8 }

function main() {
  let xs = [1, 2, 3]
  print("start\n")
  print("read=${xs[oob()]}\n")
  print("unreachable\n")
}
