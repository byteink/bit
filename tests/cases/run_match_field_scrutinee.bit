// run
// `match (st.f)` where `f` is a struct field of generic-enum type: the arm's
// payload binder must be typed at the field's concrete type argument.
//
// `scrutineeTypeArgs` recovered a scrutinee's type-args from a local's
// annotation and from a call's result node, but had no case for a struct field,
// so a field scrutinee bound its payload at the enum's UNSUBSTITUTED type param.
// Nothing downstream could then resolve a method on the binder, which is how
// std/quic's `match (st.chOpt) { Some(h) => h.clientHelloMessage() }` became an
// unlowerable function under the self-hosted compiler (#1483).
enum Opt<T> {
  None,
  Some(T)
}

struct P {
  a: i64
}

fn (p: P) get(): i64 {
  return p.a
}

struct Box {
  o: Opt<P>
  n: Opt<i64>
}

fn main() {
  let b = Box{ o: Opt.Some(P{ a: 5 }), n: Opt.Some(9) }
  match (b.o) {
    None => { print("none\n") }
    Some(p) => { print("${p.get()}\n") }
  }
  match (b.n) {
    None => { print("none\n") }
    Some(v) => { print("${v + 1}\n") }
  }
}
