// run
// Variadic calls (§10.3) and the spread form (§12.4). The callee binds ONE
// `[]T`, so the call site must collect its trailing arguments into a slice;
// lowering them as separate scalars makes the callee read a slice header off
// an integer, which segfaults rather than answering wrongly.
function count(...xs: int): int {
  return len(xs)
}
function sum(label: string, ...xs: int): int {
  let t = 0
  for x of xs {
    t = t + x
  }
  return t
}
function joinAll(...parts: string): string {
  let s = ""
  for p of parts {
    s = s + p
  }
  return s
}
function main() {
  print("${count()}\n")
  print("${count(1, 2, 3)}\n")
  let a = [4, 5, 6, 7]
  print("${count(...a)}\n")
  print("${sum("x", 10, 20, 30)}\n")
  print("${sum("y")}\n")
  print("${sum("z", ...a)}\n")
  print("${joinAll("a", "b", "c")}\n")
}
