// run
// stdlib/json/lex.bit's JSONC block-comment scanner, exercised through the
// module's own entry points (#3642).
//
// The sibling case jsonc_parse_comments.bit covers comments too, but it is a
// frozen LOCAL COPY of the lexer and parser -- it declares its own `lex`,
// `describeInvalid` and `Token` and imports nothing -- so it exercises none
// of stdlib/json. That copy also only mentions the unterminated `/*` in a
// header comment; it never runs one. So until this case there was no test
// anywhere that reached `scanBlockCommentSpan`'s "no closing `*/` before EOF"
// branch in the real module.
//
// That branch is what #3642 re-encoded: the scanner used to return
// `class BlockCommentSpan { start, closed }`, one heap object per block
// comment lexed, and now returns the start offset as a plain `int` with an
// unterminated comment encoded as its complement (`-1 - start`). The offset
// 0 cases below are the ones that pin that encoding down: a `/*` at the very
// start of the document has `start == 0`, which is the only offset where a
// naive "negative means unterminated" scheme collides with a real position.
//
// Covers, for both a closed and an unterminated comment:
//   - the `Invalid` span an unterminated `/*` produces, which must start at
//     the `/` and run to EOF (parse.bit's `describeInvalid` distinguishes it
//     from a lone stray `/` purely by that span being longer than one byte);
//   - the `Comment` token `lexCst` emits for a closed comment, verbatim,
//     delimiters included;
//   - the error text and position `jsoncParse` and `cstParse` surface.
import { TokenKind, lexCst, jsoncParse, jsonEncode, cstParse, cstPrint } from "std/json"

fn kindName(k: TokenKind): string {
  if (k == TokenKind.StringTok) {
    return "StringTok"
  }
  if (k == TokenKind.Comment) {
    return "Comment"
  }
  if (k == TokenKind.Invalid) {
    return "Invalid"
  }
  if (k == TokenKind.Eof) {
    return "Eof"
  }
  return otherKindName(k)
}

fn otherKindName(k: TokenKind): string {
  if (k == TokenKind.LBrace) {
    return "LBrace"
  }
  if (k == TokenKind.RBrace) {
    return "RBrace"
  }
  if (k == TokenKind.Colon) {
    return "Colon"
  }
  return "Other"
}

fn showTokens(src: string) {
  for t of lexCst(src) {
    let span = "[${t.start},${t.end})"
    print("  tok ${kindName(t.kind)} ${span} <${src[t.start:t.end]}>\n")
  }
}

fn showParse(src: string) {
  let v = jsoncParse(src) catch e {
    print("  parse ERR ${e.message()}\n")
    return
  }
  print("  parse OK ${jsonEncode(v)}\n")
}

fn showCst(src: string) {
  let n = cstParse(src) catch e {
    print("  cst ERR ${e.message()}\n")
    return
  }
  print("  cst OK <${cstPrint(n)}>\n")
}

fn probe(label: string, src: string) {
  print("== ${label}\n")
  showTokens(src)
  showParse(src)
  showCst(src)
}

fn main() {
  // Closed, at offset 0: the `Comment` token must span the delimiters too.
  probe("closed-at-0", "/* lead */{\"a\":\"x\"}")
  // Closed, after a value, and the minimal `/**/` form.
  probe("closed-after-value", "{\"a\":\"x\"/* c */}")
  probe("minimal-closed", "/**/{\"a\":\"x\"}")
  // Non-nesting: the first `*/` closes, whatever came before it.
  probe("non-nesting", "/* /* */{\"a\":\"x\"}")
  // Unterminated at offset 0 -- `start == 0`, the encoding's edge.
  probe("unterminated-at-0", "/*")
  probe("unterminated-at-0-text", "/* never closed")
  // `/*/` is unterminated: the `/` is the comment's own second byte reused,
  // there is no `*/` after it.
  probe("unterminated-slash", "/*/")
  probe("unterminated-star", "/**")
  // Unterminated after a complete value: the `Invalid` span starts at the
  // `/`, not at the document start.
  probe("unterminated-after-value", "{\"a\":\"x\"}/*")
  probe("unterminated-midobject", "{\"a\": /* oops \"x\"}")
  // A lone `/` is a one-byte `Invalid`, a different diagnostic.
  probe("lone-slash", "/")
  print("done\n")
}
