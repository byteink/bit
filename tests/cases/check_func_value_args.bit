// error
// A call through a function VALUE is checked against the value's own signature
// (#1529). The callee is a local binding, not a declaration, so the free-call
// arity+type rule never saw these — the wrong-typed argument built a binary
// that passed an i64 into an i32 slot, which is silent miscompile rather than a
// missing diagnostic. Covers both the arrow and the named-function value, and
// arity as well as element types.
fn twice(a: i32): i32 {
  return a * 2
}

fn pair(a: i32, b: string): i32 {
  return a
}

fn main() {
  let n = 0

  // An arrow bound to a local: the argument is an i64, the parameter an i32.
  let k = (a: i32) => a * 2
  print("${k(n)}\n")

  // The same hole with a NAMED function as the value — the reason this class is
  // wider than the arrow case it was found beside.
  let t = twice
  print("${t(n)}\n")

  // Arity through a value, both directions.
  print("${t(1, 2)}\n")
  let p = pair
  print("${p(1)}\n")

  // The second parameter's type, so the check is not merely positional.
  print("${p(1, 2)}\n")
}
