// run
// `>>`, `>>=` and `>=` lex as single tokens, but a run of `>` also closes nested
// generic argument lists (#1155); the parser splits one where a `>` is due.
// Also: `type Ids = map<string, int>` ends at `>`, a binary operator, so no
// automatic semicolon is inserted after it (§5.6) and the parser must not
// demand one.
type Ids = map<string, int>

enum Opt<T> {
  Some(T)
  None
}

fn collect(out: chan<map<string, int>>) {
  let m = map<string, int>()
  m["a"] = 1
  m["b"] = 2
  out <- m
}

fn unwrap(x: Opt<Opt<i64>>): i64 {
  match (x) {
    Some(inner) => {
      match (inner) {
        Some(v) => { return v }
        None => { return -1 }
      }
    }
    None => { return -2 }
  }
  return -3
}

fn main() {
  let ch = chan<map<string, int>>(1)
  spawn collect(ch)
  let got = <- ch
  print("a=${got["a"]} b=${got["b"]}\n")

  let t: Ids = map<string, int>()
  t["n"] = 7
  print("n=${t["n"]}\n")

  // No space before `=`, so this lexes as `>>=`: two closes and an assignment.
  let nested: Opt<Opt<i64>>= Opt.Some(Opt.Some(41))
  print("v=${unwrap(nested)}\n")

  // A real shift and a real comparison still lex as themselves.
  let shifted = 1 << 4
  print("shift=${shifted >> 2} cmp=${shifted >= 16}\n")
}
