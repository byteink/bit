// run
// Traits (SPEC §10.7, #3369): `Self` as a PARAMETER type — `equals(other:
// Self)` — resolves to the using class too, so `other.n` type-checks as an
// ordinary field access on another `Box`, not on some abstract type.
trait Comparable {
  equals(other: Self): bool { return this.n == other.n }
}

class Box {
  use Comparable
  n: i64,
}

fn main() {
  let a = Box{ n: 5 }
  let b = Box{ n: 5 }
  let c = Box{ n: 9 }
  print("${a.equals(b)} ${a.equals(c)}\n")
}
