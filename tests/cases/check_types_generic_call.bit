// types
interface Shape { area(): f64 }
struct Circle { export r: f64 }
function (c: Circle) area(): f64 { return 3.14159265358979 * c.r * c.r }
function totalArea<T: Shape>(shapes: []T): f64 {
  let sum = 0.0
  for s of shapes {
    sum += s.area()
  }
  return sum
}
function main() {
  let shapes = [Circle{ r: 1.0 }]
  let total = totalArea(shapes)
}
