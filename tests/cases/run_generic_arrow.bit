// run
// #2040: a BARE-parameter arrow passed to a GENERIC parameter whose function
// type mentions an unbound type param (`(T) => U`) or returns void (`(T) => ()`)
// typechecked and then refused to lower — `cannot lower 1 function(s): main`.
//
// A generic callee's parameter type is written against its type params, so the
// seeding pass skipped it outright and the arrow got no expectation at all: its
// parameter stayed untyped, its body typed to nothing, and nothing bound `U`.
// `genericTypeArgs` then fell through to `()`, minting `applyU<i64, ()>` — an
// instantiation the lowerer cannot build. `(T) => bool` escaped because a
// concrete result needs no binding.
//
// SPEC §12.8 makes the bare form conditional on inferability and §15.3 fixes the
// order: `T` is bound by unifying the declared parameter types with the argument
// types, and the expected type then flows inward to the arrow.
//
// The spellings that never needed that inward flow — an annotated arrow
// parameter, a named function, an explicit turbofish — are here to STAY working:
// they reach the instantiation by another route, so a fix that merely moved the
// failure would show up as one of them breaking.

fn applyU<T, U>(av: T, f: (T) => U): U {
  return f(av)
}

fn applyVoid<T>(bv: T, f: (T) => ()) {
  f(bv)
}

fn applyBool<T>(cv: T, f: (T) => bool): bool {
  return f(cv)
}

fn applyPair<T, U>(p: T, q: T, f: (T, T) => U): U {
  return f(p, q)
}

// `seq.mapped`'s own shape: `T` is reachable only THROUGH the slice, so the
// binder has to descend into `[]T` before the arrow has anything to be checked
// against.
fn mapSlice<T, U>(xs: []T, f: (T) => U): []U {
  let out = []U(0)
  let i = 0
  while (i < len(xs)) {
    out = append(out, f(xs[i]))
    i = i + 1
  }
  return out
}

// The check env holds one binding per NAME, so an arrow parameter left untyped
// READ this generic's own same-named parameter instead: `x => x + 1` below
// reported `E0053: operator not defined for 'T' and 'untyped int'` rather than
// refusing to lower. Typing the arrow's parameter is what rebinds the name.
fn shadowed<T, U>(x: T, f: (T) => U): U {
  return f(x)
}

fn double(n: i64): i64 {
  return n * 2
}

fn main() {
  // The four shapes that refused to lower, every one with a bare parameter.
  print("${applyU(3, x => x * 2)}\n")
  applyVoid(4, y => print("v${y}\n"))
  print("${applyBool(5, z => z > 1)}\n")
  print("${applyPair(6, 7, (a, b) => a + b)}\n")

  let ds = mapSlice([1, 2, 3], e => e * 3)
  print("${ds[0]},${ds[1]},${ds[2]}\n")

  // `U` differs from `T`: it can only come from the arrow's own body.
  print("${applyU(8, w => w > 2)}\n")

  // A string `T`, so the binding is not silently i64 everywhere.
  print("${applyU("ab", s => len(s))}\n")

  print("${shadowed(10, x => x + 1)}\n")

  // Spellings that never needed the inward flow.
  print("${applyU(11, (x: i64) => x * 2)}\n")
  applyVoid(12, (y: i64) => print("v${y}\n"))
  print("${applyU(13, double)}\n")
  print("${applyU<i64, i64>(14, x => x * 2)}\n")
  print("ok\n")
}
