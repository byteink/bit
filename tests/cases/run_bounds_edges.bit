// run
// #2014's OTHER half, and the reason it is a case rather than a comment: the six
// `*_panic.bit` siblings only prove the bounds checks FIRE. This one proves they
// do not fire on anything legal — an over-eager guard (`>` where `>=` belongs,
// `cap` confused with `len`, a null header treated as a fault) would pass all six
// of those and break every program in the tree.
//
// Every bound is spelled through `len`/`cap` rather than a literal, so the case
// still asks the same question if the fixtures change.
import { args } from "std/os"

struct Z { xs: []int, s: string, n: int }

// Non-foldable 0, so the in-bounds indices below cannot be constant-folded past
// the runtime check the way a literal `xs[0]` might be.
fn zero(): int { return len(args()) - 1 }

fn main() {
  let xs = [10, 20, 30]
  print("first=${xs[zero()]}\n")
  print("last=${xs[len(xs) - 1]}\n")
  xs[len(xs) - 1] = 99
  print("wrote=${xs[len(xs) - 1]}\n")

  // The three re-slice edges that are legal and look like violations: the whole
  // view, the empty tail AT the length, and the empty head.
  print("whole=${len(xs[0:len(xs)])}\n")
  print("tail=${len(xs[len(xs):len(xs)])}\n")
  print("head=${len(xs[zero():zero()])}\n")

  // A slice's upper re-slice bound is `cap`, NOT `len` (SPEC §12.6, Go
  // semantics): `append` grew cap past len, and `[0:cap]` must still be legal.
  let ys = []int(1, 8)
  print("ylen=${len(ys)} ycap=${cap(ys)}\n")
  print("tocap=${len(ys[0:cap(ys)])}\n")

  let s = "hello"
  print("sfirst=${s[zero()]}\n")
  print("slast=${s[len(s) - 1]}\n")
  print("swhole=[${s[0:len(s)]}]\n")
  print("stail=[${s[len(s):len(s)]}]\n")
  print("shead=[${s[zero():zero()]}]\n")

  // A zeroed struct's slice and string fields are the NULL WORD (SPEC §13.4,
  // #1564/#1570), not empty headers. They must behave as the empty slice/string:
  // length 0, `[0:0]` legal, appendable. Reading element 0 of them is out of
  // range and panics — covered by the sibling cases, not here.
  let z = Z{}
  print("zlen=${len(z.xs)} zcap=${cap(z.xs)}\n")
  print("zreslice=${len(z.xs[zero():zero()])}\n")
  z.xs = append(z.xs, 7)
  print("zappend=${z.xs[zero()]}\n")
  print("zstrlen=${len(z.s)}\n")
  print("zstrreslice=[${z.s[zero():zero()]}]\n")
}
