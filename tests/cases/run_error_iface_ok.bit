// run
// #2237's other half: what must keep working once `error` is checked
// structurally. A class that DOES declare `message(): string` still assigns
// into an `error` location, is still the `E` of a `T!E`, and is still `fail`able
// from a plain `T!`. (`newError("x").message()` needs the prelude, which a
// golden case does not get; examples/errors covers it, as do the 84 stdlib and
// compiler files that build on it.)
class NotFound { path: string }

fn (e: NotFound) message(): string {
  return "not found: " + e.path
}

fn openIt(p: string): i64! {
  if (p == "") {
    fail NotFound{ path: "<empty>" }
  }
  return 7
}

fn tagged(p: string): i64!NotFound {
  fail NotFound{ path: p }
}

fn main() {
  let e: error = NotFound{ path: "a.txt" }
  print("${e.message()}\n")
  let v = openIt("") catch err {
    print("${err.message()}\n")
    0
  }
  let w = tagged("b.txt") catch err2 {
    print("${err2.message()}\n")
    1
  }
  print("${v} ${w} ${openIt("x") catch 0}\n")
}
