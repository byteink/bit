// run
// #3648: a STATICALLY-empty slice — `[]T(0)`, `[]T{}`, a bare `[]`, and a class
// field's zero value — is the null header and costs no heap object. Every
// reader must still answer it as the empty slice, which is what this pins:
// `len`, `cap`, iteration, reslice, conversion, and `append` growing it into a
// real slice. SPEC §13.4 defines exactly this behaviour for the zero value, so
// all four spellings must now agree with it and with each other.
class Bag {
  xs: []string
}

// A RESLICE OF THE NULL HEADER MUST KEEP THE ELEMENT TYPE'S `is_ref`. The
// runtime used to answer `null[0:0]` with a fabricated header carrying
// `is_ref = 0`, so the buffer a following `append` allocated was untraced and
// the collector could sweep a string the program still held. Reading the value
// back after churning the heap is what would catch that.
fn resliceThenAppend(): string {
  let empty = []string(0)
  let view = empty[0:0]
  view = append(view, "kept-${len(empty) + 1}")
  let i = 0
  while (i < 40000) {
    let junk = []int(3)
    junk[0] = i
    i = i + 1
  }
  return view[0]
}

fn main() {
  let a = []int(0)
  let b = []string{}
  let c: []int = []
  let d = Bag{}
  print("len=${len(a)},${len(b)},${len(c)},${len(d.xs)}\n")
  print("cap=${cap(a)},${cap(b)},${cap(c)},${cap(d.xs)}\n")
  let seen = 0
  for (x of a) {
    seen = seen + x + 1
  }
  print("forof=${seen}\n")
  print("reslice=${len(a[0:0])},${len(d.xs[0:0])}\n")
  print("bytes=[${string([]byte(0))}]\n")
  let grown = append(a, 7)
  print("grown=${len(grown)} v=${grown[0]} cap=${cap(grown)}\n")
  let e: []int = []
  e = append(e, 1)
  e = append(e, 2)
  e = append(e, 3)
  print("e=${len(e)},${e[0]},${e[1]},${e[2]}\n")
  print("reslice-append=${resliceThenAppend()}\n")
}
