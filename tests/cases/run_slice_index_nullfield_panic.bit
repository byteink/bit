// panic
// #3107: reading an element of a zeroed class's slice field. The field holds
// the NULL WORD, not an empty header (SPEC §13.4, #1564/#1570), so this is the
// arm `bit_rt_slice_get` spelled as an explicit `if (h == 0)` before it ever
// looked at a length.
//
// `run_bounds_edges.bit` covers the legal half of the null header — `len`, `cap`
// and `[0:0]` on it — and says in so many words that "reading element 0 of them
// is out of range and panics — covered by the sibling cases". No sibling case
// covered it. This is that case.
//
// #3107's inline lowering has no `h == 0` test at all: it relies on `slice_len`
// reading a null header as 0, which makes EVERY index fail the bounds compare
// and reach the same panic. That is one fewer branch on the hot path and one
// more thing that can be silently wrong — drop the null guard from
// `emitHeaderWordOrZero` and this read faults at address 8 with SIGSEGV instead
// of panicking, which is exit 11, not exit 2.
import { args } from "std/os"

class Z { xs: []int, n: int }

fn zero(): int { return len(args()) - 1 }

fn main() {
  let z = Z{}
  print("start len=${len(z.xs)}\n")
  print("read=${z.xs[zero()]}\n")
  print("unreachable\n")
}
