// run
// #3431: the all-good twin of testing_checktable_badrows.bit. Every row
// matches, so no `checkX` call records a failure and the paired
// `checkDone()` is a no-op — the process exits 0 having printed nothing to
// stderr, unlike the bad-rows sibling.
import { checkEq, checkDone } from "std/testing"

class C { name: string, got: int, want: int }

fn main() {
  defer checkDone()
  let cases = [
    C{ name: "row1-ok", got: 1, want: 1 },
    C{ name: "row2-ok", got: 2, want: 2 },
    C{ name: "row3-ok", got: 3, want: 3 },
    C{ name: "row4-ok", got: 4, want: 4 },
    C{ name: "row5-ok", got: 5, want: 5 },
  ]
  for (let i = 0; i < len(cases); i++) {
    let c = cases[i]
    checkEq(c.got, c.want, "case ${c.name}")
  }
  print("all rows passed\n")
}
