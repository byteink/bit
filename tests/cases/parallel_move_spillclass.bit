// run
// #3168: a block-edge parallel move was sequentialized once per register
// class (sequentializeAndEmit(intMoves, Int) then (floatMoves, Float)) while
// int and float spill slots were drawn from one flat, class-agnostic pool. An
// int move's destination slot could also be a float move's source slot; the
// int pass ran first and clobbered the float value before the float pass read
// it. The empty x86_64 float register file makes that fire at 1 live float
// (see the sibling x64-only case for that shape); AArch64's d8-d15 give it 8
// callee-saved float registers, so it takes 8+ simultaneously-live floats
// carried across a loop back edge to force enough of them to memory to
// collide with an int spill on THIS host. f0..f7 and n0..n9 are all
// loop-carried across the inner `while`, with a conditional `break`, which is
// exactly the block-edge parallel-move shape the bug needs.
//
// Expected value cross-checked against a `cc -O0` C oracle of the identical
// arithmetic: 44450894. Before the fix this printed 280822836 on
// aarch64-macos and aarch64-linux alike (verified natively and under Docker
// --platform linux/arm64) — the float variables were silently corrupted by
// the int block-edge moves, a constant wrong answer with no crash.
fn main() {
  let px = 0
  let acc = 0
  while (px < 2) {
    let f0 = 0.5
    let f1 = 1.5
    let f2 = 2.5
    let f3 = 3.5
    let f4 = 4.5
    let f5 = 5.5
    let f6 = 6.5
    let f7 = 7.5
    let n0 = 1
    let n1 = 2
    let n2 = 3
    let n3 = 4
    let n4 = 5
    let n5 = 6
    let n6 = 7
    let n7 = 8
    let n8 = 9
    let n9 = 10
    let iter = 0
    while (iter < 20) {
      if (f0 > 100000.0) { break }
      f0 = (f0 + f1) + 0.25
      f1 = (f1 + f2) + 0.25
      f2 = (f2 + f3) + 0.25
      f3 = (f3 + f4) + 0.25
      f4 = (f4 + f5) + 0.25
      f5 = (f5 + f6) + 0.25
      f6 = (f6 + f7) + 0.25
      f7 = (f7 + f0) + 0.25
      n0 = (n0 + n1) + 1
      n1 = (n1 + n2) + 1
      n2 = (n2 + n3) + 1
      n3 = (n3 + n4) + 1
      n4 = (n4 + n5) + 1
      n5 = (n5 + n6) + 1
      n6 = (n6 + n7) + 1
      n7 = (n7 + n8) + 1
      n8 = (n8 + n9) + 1
      n9 = (n9 + n0) + 1
      iter = iter + 1
    }
    acc = (acc + iter) + i64(f0 * 100.0)
    acc = acc + n0
    acc = acc + n1
    acc = acc + n2
    acc = acc + n3
    acc = acc + n4
    acc = acc + n5
    acc = acc + n6
    acc = acc + n7
    acc = acc + n8
    acc = acc + n9
    px = px + 1
  }
  print("acc=${acc}\n")
}
