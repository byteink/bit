// run
// stdlib/json/lex.bit's combined `{`/`[` depth cap (#1479, #1718): a 65th
// nesting level must yield an `Invalid` token, not a stack overflow or hang.
// Single-file golden convention (no prelude, no std/json import — see
// run_math.bit), so this redeclares the same lexer locally, as
// tests/cases/json_lex_basic.bit already does.
//
// Builds `[` * 65 + `]` * 65 (65-deep nested arrays) and asserts: the scan
// completes (proves no recursion / no unbounded stack growth), the token
// count is exactly 65 opens + 65 closes + 1 Eof, and exactly one token in
// the stream is `Invalid` — the 65th open, the only one past the cap. Every
// closer still decrements cleanly, none of them going negative or crashing.

// The lexical categories a JSON token can be.
enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
}

// One lexical token: its kind and its `[start, end)` byte span in the source.
struct Token {
  kind: TokenKind,
  start: int,
  end: int,
}

// Combined `{`/`[` nesting limit: the open that would create the 65th level
// is rejected as `Invalid` instead of tracked.
const jsonMaxDepth = 64

struct Lexer {
  src: string,
  i: int,
  depth: int,
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

// Advances the cursor by `n` and returns the token `[start, start+n)`.
fn emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

// `{`/`[`: enforces `jsonMaxDepth`, returning `Invalid` (without opening a new
// level) once the counter already sits at the cap.
fn scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

// `}`/`]`: pops one level; never goes negative on an unmatched closer.
fn scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

// A `"`-delimited string span, quotes included, escapes left raw.
fn scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

// A JSON number span captured verbatim (RFC 8259 §6).
fn scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

// `true`/`false`/`null`, or `Invalid` for any other lowercase run.
fn scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

// Skips JSON whitespace (RFC 8259 §2) and dispatches one token, or `Eof`.
fn scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

// The full token stream for `source`, ending with one `Eof`.
fn lex(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let digits = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    let d = v % 10
    s = digits[d:d + 1] + s
    v = v / 10
  }
  return s
}

fn main() {
  let opens = 65
  let src = ""
  let i = 0
  while (i < opens) {
    src = src + "["
    i = i + 1
  }
  i = 0
  while (i < opens) {
    src = src + "]"
    i = i + 1
  }

  let toks = lex(src)

  let invalidCount = 0
  for t of toks {
    if (t.kind == TokenKind.Invalid) {
      invalidCount = invalidCount + 1
    }
  }

  print("tokens=" + itoa(len(toks)) + "\n")
  print("invalid=" + itoa(invalidCount) + "\n")
}
