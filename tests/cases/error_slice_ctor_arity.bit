// error
// `[]T(...)` is the SIZED constructor — one length, optionally a capacity — and
// anything else is E0050 (#1921).
//
// The lowering used to read argument 0 as the length and never look at how many
// there were, so `[]u8(127, 69, 76, 70)` built a 127-byte run of zeroes and threw
// the other three away without a word. That shape is dangerous rather than
// untidy: it reads like a byte-slice literal, which is what most languages with
// this bracket style use it for, and it succeeds with a plausible non-empty
// result instead of failing.
//
// It was found in compiler/archivecheck.bit, where an assertion meant to prove
// that ELF magic is ACCEPTED handed the predicate 127 zero bytes. The predicate
// correctly said no, the assertion passed, and the test proved nothing. A test
// that cannot fail is worse than no test.
//
// Zero arguments is the same hole from the other end: `[]u8()` type-checked
// clean and failed much later as "cannot lower 1 function(s)", naming neither
// the expression nor the problem.
//
// The legal forms at the bottom must stay silent — this is an arity rule, not a
// change to what the constructor does.
fn main() {
  let bytes = []u8(127, 69, 76, 70)
  let none = []u8()
  let many = []int(1, 2, 3, 4, 5)

  // Legal: a length, a length and a capacity, and the string conversion that
  // covers what the broken spelling above was reaching for.
  let n = []u8(4)
  let withCap = []u8(4, 16)
  let magic = []byte("\x7fELF")
  print(itoa(len(n) + len(withCap) + len(magic)))
  print("\n")
}

fn itoa(n: int): string {
  if (n == 0) { return "0" }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) { s = d[v % 10 : v % 10 + 1] + s; v = v / 10 }
  return s
}
