// panic
// #2016: `n % 0` must panic (SPEC §13.5, §18.4) rather than silently
// returning `n`. Sibling of run_divzero_panic.bit -- the harness needs one
// panic per file, so `/` and `%` get separate cases. The divisor comes from
// `len(args())` so it cannot fold at compile time.
import { args } from "std/os"

function zero(): int { return len(args()) - 1 }

function main() {
  print("start\n")
  print("rem=${7 % zero()}\n")
  print("unreachable\n")
}
