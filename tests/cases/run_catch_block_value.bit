// run
// A bind-catch BLOCK's value (#1519). `lowerCatchBlock` reports "this block
// yielded no value" with -1, never 0 — 0 is the value id of a function's first
// instruction, so the old sentinel made "no value" indistinguishable from "the
// first instruction's value" and merged that instruction into the join. That is
// the collision that produced the #1493 miscompile.
//
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally rather than
// `newError` (which lives in the prelude), and output goes through `print`.
struct myErr { code: i64 }
function (e: myErr) message(): string { return "code=${e.code}" }

function g(ok: bool): i64! {
  if (ok) { return 7 }
  fail myErr{ code: 1 }
}

// Block form: the trailing expression statement is the handled value.
function blockLit(ok: bool): i64 { return g(ok) catch e { 42 } }
// Default form: `catch <expr>`, no block.
function dflt(ok: bool): i64 { return g(ok) catch 99 }
// The handled value derives from the bound error, so the merge must carry the
// handler's own instruction and not the function's first one.
function fromErr(ok: bool): i64 { return g(ok) catch e { len(e.message()) } }
// A block that diverts control instead of producing a value: nothing merges.
function divert(ok: bool): i64 { return g(ok) catch e { return 0 - 1 } }

function main() {
  print("blockLit=${blockLit(true)},${blockLit(false)}\n")
  print("dflt=${dflt(true)},${dflt(false)}\n")
  print("fromErr=${fromErr(true)},${fromErr(false)}\n")
  print("divert=${divert(true)},${divert(false)}\n")
}
