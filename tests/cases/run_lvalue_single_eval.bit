// run
// Read-modify-write lvalue lowering (#1712): the index expression of an
// inc/dec or compound-assign target must be evaluated exactly once —
// `xs[f()]++` must call `f` once, not twice.
let calls = 0

function nextKey(): int {
  calls = calls + 1
  return 0
}

function main() {
  let xs = []int{10, 20, 30}
  xs[nextKey()]++
  print("val=${xs[0]} calls=${calls}\n")
}
