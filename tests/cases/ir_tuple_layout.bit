// ir
// Pins the boxed-tuple ABI (ABI.md §1.1) at the IR level, because program output
// cannot see it. A tuple is laid out exactly like a struct: elements in order,
// each aligned to its own size, body rounded up to 8, and every reference
// element listed in `ptrs` for the collector.
//
// Why this case exists as an `// ir` golden and not just a `// run` one: lowering
// an element at its default i64 width instead of its declared width still
// *prints* the right answers, because the stores run in increasing-offset order
// so each oversized store is repaired by the next one, and only the last spills
// past the body. That defect is invisible to stdout and plainly visible here as
// `const_int i64` feeding a `u8` slot. Assert on the emitted IR for layout work.
function narrow(): (u8, i32, u8) {
  return 200, 70000, 44
}

// A reference element must appear in `ptrs`, an untraced one must not — this is
// the entire precision contract the collector relies on (ABI.md §2).
function mixed(): (string, i64) {
  return "s", 9
}

function main() {
  let (a, b, c) = narrow()
  let (s, n) = mixed()
  print("${a} ${b} ${c} ${s} ${n}\n")
}
