// run
// `panic(...)` must lower without crashing the compiler (it emits an
// `unreachable` terminator). Here it sits in never-taken branches — inside a
// helper and inside `main` — so the program compiles, runs, and exits 0
// without ever aborting.
function guard(x: i64): i64 {
  if (x < 0) {
    panic("negative")
  }
  return x * 2
}

function main() {
  print("${guard(5)}\n")
  let ok = true
  if (!ok) {
    panic("never")
  }
  print("done\n")
}
