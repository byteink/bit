// error
// `entryOf(f)` (§11.10) takes exactly one operand — a direct reference to a
// named function declaration. `vEntryOfCall` (compiler/validateunmanaged.bit)
// already rejects a call whose argument count is not 1, but `lowerEntryOf`
// (compiler/lowerprim.bit) used to read argument 0 unconditionally: `bit
// check`/`build`/`run` never reach it with zero arguments, but
// `--dump-ir`/`--dump-ir-pre` lower checker-rejected input regardless
// (#3756/#3755's family), so a bare `entryOf()` panicked "index out of
// range" there instead of declining (#3759).
fn helper() {}

fn main() {
  let bad = entryOf()

  // Legal form this rule must leave silent.
  let a = entryOf(helper)
}
