// run
// Early `return` from inside a `for..of`, with enough live loop-carried locals
// (i, d, plus the hidden iterable + index) to force the x64 allocator to spill.
// Regression: the loop-exit block was emitted mid-loop (non-RPO) and block-param
// intervals didn't cover the predecessor edge that writes them, so a spilled
// loop-carried value shared a slot and the early return read garbage.
fn indexOf(xs: []i64, target: i64): i64 {
  let i: i64 = 0
  let d: i64 = 0
  for x of xs {
    if (x == target) {
      return i
    }
    i = i + 1
    d = d + 1
  }
  return -1 - d
}
fn main() {
  let xs = [5, 3, 8, 1, 9]
  print("first=${indexOf(xs, 5)} mid=${indexOf(xs, 8)} last=${indexOf(xs, 9)} none=${indexOf(xs, 42)}\n")
}
