// run
// Traits (SPEC §10.7, #3369): an INJECTED method participates in
// structural interface satisfaction exactly like a declared one (SPEC
// §14.3) — `Enemy` never writes `dead(): bool` itself, only `use
// Damageable`, and still satisfies `Mortal` and passes as one.
trait Damageable {
  hurt(n: i64)
  dead(): bool { return this.hp() <= 0 }
}

interface Mortal {
  dead(): bool
}

class Enemy {
  use Damageable
  hp0: i64,
  hurt(n: i64) { this.hp0 = this.hp0 - n }
  hp(): i64 { return this.hp0 }
}

fn report(m: Mortal): string {
  if (m.dead()) { return "dead" }
  return "alive"
}

fn main() {
  let e = Enemy{ hp0: 5 }
  print("${report(e)}\n")
  e.hurt(10)
  print("${report(e)}\n")
}
