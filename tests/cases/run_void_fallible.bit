// run
// A void-fallible function `()!` (§18.2) returns nothing or an error: `fail`
// and `?` work with no ok value, and `catch` at statement position handles the
// error (a void result yields nothing). Uses an inline error type — any type
// with `message(): string` satisfies the `error` interface.
struct fault { why: string }
function (f: fault) message(): string { return f.why }

function checkPositive(n: i64): ()! {
  if (n <= 0) {
    fail fault{ why: "not positive: ${n}" }
  }
}

// `?` propagates a void-fallible with no value to unwrap.
function checkBoth(a: i64, b: i64): ()! {
  checkPositive(a)?
  checkPositive(b)?
}

function main() {
  checkBoth(1, 2) catch e {
    print("unexpected: ${e.message()}\n")
  }
  print("both ok\n")

  checkBoth(1, -5) catch e {
    print("caught: ${e.message()}\n")
  }
  print("done\n")
}
