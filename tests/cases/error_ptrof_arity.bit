// error
// `ptrOf(s)` (§11.5) takes exactly one operand — a slice or module-level
// state. `vPtrOfCall` (compiler/validateunmanaged.bit) already rejects a call
// whose argument count is not 1, but `lowerPtrOf` (compiler/lowerprim.bit)
// used to read argument 0 unconditionally: `bit check`/`build`/`run` never
// reach it with zero arguments, but `--dump-ir`/`--dump-ir-pre` lower
// checker-rejected input regardless (#3756/#3755's family), so a bare
// `ptrOf()` panicked "index out of range" there instead of declining (#3759).
let counter: i64 = 0

fn main() {
  let bad = ptrOf()

  // Legal forms this rule must leave silent: module state and a slice.
  let a = ptrOf(counter)
  let buf = []i64{ 1, 2, 3 }
  let b = ptrOf(buf)
}
