// run
// #3367: the in-body method form (SPEC §10.4), alongside the existing
// receiver form, on the SAME class. Proves: an in-body method's implicit
// `this` types as the enclosing class and supports both a field READ and a
// field WRITE, `export` on an in-body method behaves like it does on a
// receiver-form method, a class may mix both method-declaration styles, and
// an in-body method satisfies a structural interface exactly like a
// receiver-form one (§14.3).
class Counter {
  n: int

  bump(): int {
    this.n = this.n + 1
    return this.n
  }

  export doubled(): int {
    return this.n * 2
  }
}

fn (c: Counter) reset() {
  c.n = 0
}

interface Incrementer {
  bump(): int,
}

fn bumpTwice(inc: Incrementer): int {
  inc.bump()
  return inc.bump()
}

fn main() {
  let c = Counter{ n: 5 }
  print("${c.bump()}\n")
  print("${c.doubled()}\n")
  c.reset()
  print("${bumpTwice(c)}\n")
}
