// run
// Deferred calls run on the fail/propagate paths too (§18.5), in LIFO order,
// and the propagated error survives them: `inner` fails and runs its defer,
// `outer` propagates with `?` and runs its own defer, then `main` catches the
// original error intact.
struct e2 { m: string }
function (x: e2) message(): string { return x.m }

function inner(): i64! {
  defer print("inner-defer\n")
  fail e2{ m: "boom" }
}

function outer(): i64! {
  defer print("outer-defer\n")
  let v = inner()?
  return v + 1
}

function main() {
  let r = outer() catch e {
    print("got: ${e.message()}\n")
    -1
  }
  print("r=${r}\n")
}
