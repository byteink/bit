// run
// #2102: a generic call whose argument is a LOCAL bound to another generic
// call's result, inside a generic function. `bit check` accepted it and the
// build then refused with a spanless `cannot lower 1 function(s): build$2`.
//
// The trigger is the local, not the call count: `return f2(f1(x))` already
// worked, because a Call argument's type is re-computed during lowering and so
// came back as the template's `T` again — matching the `f2<T>` the check pass
// recorded — while a local's type is read from the checker's decl table, which
// lowering rewrites concretely as the `let` lowers. The two spellings therefore
// asked for two different instantiations of the same call, and only one of them
// had been recorded.
function f1<T>(x: T): T { return x }
function f2<T>(x: T): T { return x }

function build<T>(x: T): T {
  let a = f1(x)
  return f2(a)
}

function main() {
  print("${build(5)}\n")
}
