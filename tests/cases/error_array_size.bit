// error
// #1903: the parser accepts a whole expression as an array length, so the
// "compile-time constant" half of SPEC §12 is enforced here rather than by the
// grammar. Pinned as an error case because the failure mode is silent: without
// the check a non-constant length folds to -1 and `mkArray` builds an array of
// length -1, which compiles clean and prints `len(a) == -1` at run time.
const size: int = 4

function f() {
  // A local `let` is not a constant, however obvious its value looks.
  let n = 5
  let a: [n]i64
  // A negative length is rejected by the same check, since the fold succeeds
  // and simply yields a number no array can have.
  let b: [0 - size]i64
  // A function call is not foldable.
  let c: [g()]i64
}

function g(): int {
  return 3
}
