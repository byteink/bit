// run
// SPEC §12.9: "A type used in call position converts or constructs." That holds
// for builtin and compound types (`i32(x)`, `[]byte(s)`, `chan<int>(16)`) and
// used to fail for every user-declared type (#1898): `E(car)` typechecked and
// then died at codegen with "cannot lower 1 function(s)".
//
// The IMPLICIT spelling of the same conversion always worked, which is what made
// this a gap rather than a missing feature — so this case pins both spellings
// side by side. If only the implicit one is exercised the regression comes back
// invisibly.
interface Shape {
  area(): i64
  name(): string
}

class Square {
  side: i64

  area(): i64 {
    return this.side * this.side
  }

  name(): string {
    return "square"
  }
}

class Rect {
  w: i64
  h: i64

  area(): i64 {
    return this.w * this.h
  }

  name(): string {
    return "rect"
  }
}

// A conversion in argument position, so the fix is exercised somewhere other
// than a `let` initialiser.
fn describe(s: Shape): string {
  return "${s.name()}=${s.area()}"
}

fn main() {
  let sq = Square{side: 4}
  let rc = Rect{w: 3, h: 5}

  // The explicit call-position spelling — the one #1898 could not lower.
  let a = Shape(sq)
  print("${a.name()} ${a.area()}\n")

  // The implicit spelling, which already worked. Both must agree.
  let b: Shape = sq
  print("${b.name()} ${b.area()}\n")

  // Conversion as a call argument, not a binding.
  print("${describe(Shape(rc))}\n")

  // Conversion into a slice element, mixing both concrete types behind the
  // interface — the composition-over-inheritance shape this bug was found in.
  let world: []Shape = [Shape(sq), Shape(rc)]
  let total = 0
  for s of world {
    total = total + s.area()
  }
  print("total ${total}\n")
}
