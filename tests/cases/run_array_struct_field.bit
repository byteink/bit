// run
// A fixed-size array as a class field is stored INLINE in the class body, not
// as a shared handle: two class instances have independent array storage.
class Vec { xs: [3]u32, tag: u32 }

fn main() {
  // Zero-init a class with an array field: the inline block reads all zeros.
  let a: Vec
  print("zero=${a.xs[0]} ${a.xs[1]} ${a.xs[2]} ${a.tag}\n")

  // Two instances do not alias — writing `b` never touches `a`.
  let b: Vec
  a.xs[0] = u32(11)
  a.tag = u32(1)
  b.xs[0] = u32(22)
  b.tag = u32(2)
  print("noalias=${a.xs[0]} ${a.tag} ${b.xs[0]} ${b.tag}\n")

  // Class literal copies the source array into the inline field; later
  // mutation of the source does not leak into the class.
  let src: [3]u32 = [3]u32{u32(5), u32(6), u32(7)}
  let c = Vec{ xs: src, tag: u32(3) }
  src[0] = u32(99)
  print("copyin=${c.xs[0]} ${c.xs[2]} ${c.tag} ${src[0]}\n")
}
