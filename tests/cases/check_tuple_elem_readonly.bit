// error
// Tuple elements are read-only (SPEC §12.5). That is not an arbitrary
// restriction: it is what lets a tuple stay a value type (§13.3) while being
// represented as one shared heap box (ABI.md §1.1). With no way to mutate an
// element, sharing the box is unobservable — the same argument the spec makes
// for `string`. A mutable tuple element would silently turn a declared value
// type into a reference type.
fn pair(): (i64, string) {
  return 7, "hi"
}

fn main() {
  let t = pair()
  t.0 = 9
  t.1 = "no"
  t.0++
  print("${t.0}\n")
}
