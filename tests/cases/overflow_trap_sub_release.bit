// run
// #3087 (epic #3076): a release build never inserts the overflow check
// #3080/#3082 add under `--debug`, so a runtime i64 MIN - 1 must silently
// wrap to the documented two's-complement value (SPEC §13.5) and exit 0.
// Sibling of overflow_trap_sub_debug.bit: the identical expression, built
// WITH `--debug`, where the same underflow must trap instead. `one()` is
// routed through `len(args())` so `compiler/optfold.bit`'s `foldAddSubMul`
// cannot resolve this subtraction as a compile-time constant.
import { args } from "std/os"

fn one(): int { return len(args()) }

fn main() {
  let x: i64 = -9223372036854775807 - 1
  print("diff=${x - one()}\n")
}
