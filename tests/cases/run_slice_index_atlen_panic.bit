// panic
// #3107: the `index == len` BOUNDARY. Pinned separately from its two siblings —
// `run_slice_index_read_panic.bit` probes `len + 8` and
// `run_slice_index_neg_panic.bit` probes a negative index — because this is the
// ONE index a `<=` written where `<` belongs would admit, and neither of those
// two would notice: one is far past the end and the other is far below it.
//
// It matters more now than it did when the check lived in `bit_rt_slice_get`.
// #3107 lowers `xs[i]` INLINE and spells both halves of `index < 0 ||
// index >= len` as a single unsigned compare, so the two bounds are no longer
// two separate source conditions a reader can eyeball — one wrong condition code
// (`ls` for `lo`) moves this exact index from panicking to reading one word past
// the live data, with nothing else in the corpus disagreeing.
//
// The length is read back through `len(xs)` and the slice is grown by a
// non-foldable amount, so nothing here is decidable at compile time.
import { args } from "std/os"

fn extra(): int { return len(args()) - 1 }

fn main() {
  let xs = [1, 2, 3]
  xs = append(xs, 4 + extra())
  print("start len=${len(xs)}\n")
  print("read=${xs[len(xs)]}\n")
  print("unreachable\n")
}
