// run
// SPEC §11.3's own worked example (#2136), typed out with a concrete type.
// `Self` inside an interface method signature must bind to the candidate
// implementing type AT SATISFACTION-CHECK TIME (§14.3: "with Self bound to
// S"), not once at declaration — the same interface is satisfied by many
// types, so a single substitution baked into `Ord.less`'s own signature would
// be wrong for the second implementer. Before the fix `Self` resolved to
// `invalid`, so `Ord.less` interned as `(invalid) => bool` and no candidate's
// own `(P) => bool` could ever match it — E0051 on every implementer, always.
interface Ord { less(other: Self): bool }
struct P { x: int }
function (p: P) less(other: P): bool { return p.x < other.x }
function maxOf<T: Ord>(a: T, b: T): T {
  if (a.less(b)) { return b }
  return a
}
function main() { print("${maxOf(P{x:1}, P{x:2}).x}\n") }
