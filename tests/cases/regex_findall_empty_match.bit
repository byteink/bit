// run
// #3566: `Regex.findAll`'s global-find loop against the two empty-match
// failure modes that sit right next to each other, mirroring Go's
// `regexp.go` (`(*Regexp).matches`, go1.27.0 regexp.go:747-800) exactly —
// suppress an empty match only when it starts right where the immediately
// preceding ACCEPTED match ended.
//
// Direction 1 (the bug): a match ending at offset E must never be followed
// by a spurious empty match starting at E. `.*` is greedy and matches the
// whole 6-byte subject in one go, so Go's own `findTests` (the row this
// fixture pins) reports exactly one match, not a real match plus a
// zero-width echo of its own end. `a*` on "baaab" pins the same shape with
// three real matches (an empty one at each end of the run of `a`s), not
// four.
//
// Direction 2 (the regression this must not reintroduce): a pattern that
// can ONLY match empty must still report every one of those empty matches.
// `a*` against "b" has no `a` to consume anywhere, so Go's own regexp
// (verified directly: `go run` against 1.27.0's `regexp.MustCompile("a*")`)
// reports TWO empty matches — [0,0) before the "b", and [1,1) after it —
// not one and not zero. The suppression rule added for direction 1 must
// not fire here: match [1,1) starts where NO accepted match ended (the
// prior accepted match [0,0) ended at 0, not 1), so it stays accepted.
// Suppressing every empty match unconditionally, or advancing past one
// unconditionally, both destroy this case.
import { mustCompile, Match } from "std/regex"

fn matchStr(m: Match): string {
  return "${m.start},${m.end}"
}

fn joinMatches(ms: []Match): string {
  let out = ""
  let i = 0
  while (i < len(ms)) {
    if (i > 0) {
      out = out + " "
    }
    out = out + matchStr(ms[i])
    i = i + 1
  }
  return out
}

fn main() {
  // Direction 1: no spurious empty match right after a match that ends at
  // the same offset.
  let dotStar = mustCompile(".*")
  let m1 = dotStar.findAll("abcdef", -1)
  println("dotStarCount=${len(m1)}")
  println("dotStarMatches=${joinMatches(m1)}")

  let aStar = mustCompile("a*")
  let m2 = aStar.findAll("baaab", -1)
  println("aStarRunCount=${len(m2)}")
  println("aStarRunMatches=${joinMatches(m2)}")

  // Direction 2: a legitimate empty match (nothing for the pattern to
  // consume) must still be reported, not swallowed by the suppression rule.
  let m3 = aStar.findAll("b", -1)
  println("aStarNoneCount=${len(m3)}")
  println("aStarNoneMatches=${joinMatches(m3)}")
}
