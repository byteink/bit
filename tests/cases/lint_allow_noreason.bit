// lint exit=1
// the identical override, but its reason is under the 10-character floor
// (spec/LINT.md §5.5): the directive is DEFECTIVE, so it is reported itself
// (E0297) as an ordinary finding, and it does NOT suppress the E0214 it
// was aimed at — a broken override must not make its target vanish.
fn catchEdgeArgs(buf: []byte): int {
  // bit:lint allow E0214 -- x
  append(buf, 1)
  return len(buf)
}
