// run
// #1560/#1566: a generic enum's variant payload types are carried SUBSTITUTED on
// the type table (ctx.variantPayloads, filled per instantiation), so a match site
// reads a concrete binder type off the subject's own TypeId instead of
// re-deriving the enum's type arguments from the scrutinee's syntax.
//
// Each shape below defeated that syntactic recovery, and each was a false
// positive: `bit-seed check` accepted it, `bit check` refused it. They are kept
// together because they share one root cause — none of them is closed by adding
// another per-shape arm to `scrutineeTypeArgs`/`exprDeclTypeNode`.

enum Opt<T> { Some(T), None }
enum Pair<A, B> { Both(A, B), Neither }

function idOpt<T>(o: Opt<T>): Opt<T> { return o }

// #1566 shape A: the type params are SWAPPED in the result, and the argument is
// itself a variant construction. Binding A and B at the call needs the argument's
// nominal instantiation, not its syntax.
function flip<A, B>(p: Pair<A, B>): Pair<B, A> {
  match (p) {
    Both(a, b) => { return Pair<B, A>.Both(b, a) }
    Neither => { return Pair<B, A>.Neither }
  }
}

// #1566 shape C: the generic call's ARGUMENT is a struct field read.
struct Holder { o: Opt<int> }
function fromFieldArgument(h: Holder): int {
  let f = idOpt(h.o)
  match (f) {
    Some(v) => { return v + 3 }
    None => { return 0 }
  }
}

// #1566 shape D, first half: same local name as `fromStr` below, different
// payload type, and this one is ANNOTATED. Under the flat name-keyed
// `declTypeNodes` table the annotation here decided the OTHER function's binder.
function fromAnn(o: Opt<int>): int {
  let r: Opt<int> = idOpt(o)
  match (r) {
    Some(v) => { return v + 2 }
    None => { return 0 }
  }
}

// #1566 shape D, second half: making this binding un-annotated used to be what
// flipped the collision, which is the tell that flat name keying was deciding.
function fromStr(): string {
  let r = idOpt(Opt<string>.Some("s"))
  match (r) {
    Some(v) => { return v }
    None => { return "" }
  }
}

function main() {
  // #1566 shape A.
  let f = flip(Pair<int, string>.Both(7, "x"))
  match (f) {
    Both(a, b) => { print("a=${a} b=${b + 1}\n") }
    Neither => { print("a=none\n") }
  }

  // #1566 shape B: an index into an UNANNOTATED array literal — the container
  // writes no declared type node for the recovery to read.
  let xs = [Opt<int>.Some(9)]
  match (xs[0]) {
    Some(v) => { print("b=${v + 1}\n") }
    None => { print("b=none\n") }
  }

  print("c=${fromFieldArgument(Holder{ o: Opt<int>.Some(4) })}\n")
  print("d=${fromAnn(Opt<int>.Some(1))} ${fromStr()}\n")

  // #1566 shape E: this rendered `field_get ... <T>` where the seed renders
  // `field_get ... string`. The binary was correct and only the IR annotation
  // diverged, which is exactly why a run-only check cannot guard it.
  let s = idOpt(Opt<string>.Some("s"))
  match (s) {
    Some(v) => { print("e=${v}\n") }
    None => { print("e=none\n") }
  }
}
