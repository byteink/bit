// error
// An interface value *is* the receiver's object pointer (ABI.md §2.1) — there is
// no boxing step — so only a struct can sit behind one (SPEC §14.3). Storing a
// scalar there would leave a non-pointer in a word the GC traces as a root and
// `iface.(T)` reads as an object header. Every way a value can reach an
// interface-typed slot must reject it, not just `let`.
interface Any {}

interface Shape {
  area(): i64
}

struct Circle {
  r: i64,
}

function (c: Circle) area(): i64 {
  return c.r * c.r
}

struct Box {
  v: Any,
}

// A method may be declared on a type alias (§10.4), and an alias to a scalar is
// transparently that scalar (§14.1) — so a method set alone cannot gate this: an
// i64 can satisfy even a *non-empty* interface.
type Meters = i64

function (m: Meters) area(): i64 {
  return m * 2
}

function take(a: Any): i64 {
  return 1
}

function give(): Any {
  return 7
}

function main() {
  let a: Any = 5
  a = 6
  let n = take(7)
  let b = Box{ v: 8 }
  let sl: []Any = [9]
  let m = map<string, Any>{"k": 10}
  let ch = chan<Any>(1)
  ch <- 11
  let meters: Meters = 21
  let sh: Shape = meters

  // Still legal: a struct is a pointer already, an interface value is one too,
  // and `nil` is the null word.
  let c: Circle = Circle{ r: 2 }
  let ok1: Shape = c
  let ok2: Any = ok1
  let ok3: Any = nil
  print("${n} ${ok1.area()} ${b.v == ok2} ${ok3 == nil} ${sh == ok1} ${sl[0] == m["k"]} ${a == give()}\n")
  ch <- c
}
