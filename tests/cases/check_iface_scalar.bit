// error
// An interface value *is* the receiver's object pointer (ABI.md §2.1) — there is
// no boxing step — so only a class can sit behind one (SPEC §14.3). Storing a
// scalar there would leave a non-pointer in a word the GC traces as a root and
// `iface.(T)` reads as an object header. Every way a value can reach an
// interface-typed slot must reject it, not just `let`.
interface Any {}

interface Shape {
  area(): i64
}

class Circle {
  r: i64,

  area(): i64 {
    return this.r * this.r
  }
}

class Box {
  v: Any,
}

// #3762: methods can now only be declared in a class body, so a scalar alias
// can never have a method again — `let sh: Shape = meters` below is rejected
// for lacking `area()` before the representation check in §14.3 ever runs.
// The invariant this file exists to pin (only a class can sit behind an
// interface value, independent of method-set satisfaction) is still tested
// by the eight `Any` cases above: `Any` requires no methods at all, so an
// untyped int's trivially-empty method set already satisfies it, isolating
// the same representation rule this case's `Meters` used to isolate.
type Meters = i64

fn take(a: Any): i64 {
  return 1
}

fn give(): Any {
  return 7
}

fn main() {
  let a: Any = 5
  a = 6
  let n = take(7)
  let b = Box{ v: 8 }
  let sl: []Any = [9]
  let m = map<string, Any>{"k": 10}
  let ch = chan<Any>(1)
  ch <- 11
  let meters: Meters = 21
  let sh: Shape = meters

  // Still legal: a class is a pointer already, an interface value is one too,
  // and `nil` is the null word.
  let c: Circle = Circle{ r: 2 }
  let ok1: Shape = c
  let ok2: Any = ok1
  let ok3: Any = nil
  print("${n} ${ok1.area()} ${b.v == ok2} ${ok3 == nil} ${sh == ok1} ${sl[0] == m["k"]} ${a == give()}\n")
  ch <- c
}
