// run
// #3168: the x86_64 half of the block-edge parallel-move / spill-pool-class
// collision (see parallel_move_spillclass.bit for the mechanism and the
// AArch64 8-live-float threshold). SysV's caller-saved-only XMM convention
// means x86_64 keeps NO float value in a callee-saved register across a call
// or a safepoint (x64frame.bit's xBuildFloatRegs returns an empty register
// set), so every float here is memory-resident and the threshold is just 1
// live float carried across the inner loop's back edge — this is the
// mandelbrot escape-iteration shape from the original report, not an
// artificially inflated one.
//
// On THIS host (aarch64-macos) this case is not a regression check by
// itself — six floats never reach AArch64's 8-register threshold, so it
// prints the values below both before and after #3168's fix, natively.
// Cross-built `bit build tests/cases/parallel_move_spillclass_x64.bit -t
// x86_64-linux` and run on real x86_64 hardware, it diverges exactly as
// bench/cases/mandelbrot does: rowsum pinned at 10 on every row before the
// fix (the escape test never fires because the int block-edge move clobbers
// the float being tested), matching the values below after.
fn main() {
  let py = 0
  while (py < 3) {
    let y0 = f64(py) / 7.0 * 2.5 - 1.25
    let rowsum = 0
    let px = 0
    while (px < 2) {
      let x0 = 0.375
      let x = 0.0
      let y = 0.0
      let iter = 0
      while (iter < 5) {
        let x2 = x * x
        let y2 = y * y
        if (x2 + y2 > 4.0) {
          break
        }
        y = 2.0 * x * y + y0
        x = x2 - y2 + x0
        iter = iter + 1
      }
      rowsum = rowsum + iter
      px = px + 1
    }
    print("py=${py} rowsum=${rowsum} y0=${i64(y0 * 1000000.0)}\n")
    py = py + 1
  }
}
