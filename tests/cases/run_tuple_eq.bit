// run
// #2113: `==` on two tuples compared the BOXES. A tuple is a value type (SPEC
// §13.3) represented as a shared heap box precisely because its elements are
// read-only, so the sharing is meant to be unobservable — `==` observed it, and
// any two independently produced tuples were unequal however identical their
// elements. §14.6 makes a tuple comparable ELEMENT-WISE.
//
// `a == a` was true before the fix only by box identity; it must stay true for
// the element-wise reason. The 3-element case mixes an integer, a `string` and a
// `bool` so the walk has to get a reference element and two scalar elements
// right in one program, and `pair` vs `pairSame` proves it is the CONTENTS and
// not the producing call site that decides.
//
// Single-file golden: no prelude.
function pair(): (int, string) { return 1, "a" }

function other(): (int, string) { return 1, "b" }

function triple(a: int, b: string, c: bool): (int, string, bool) {
  return a, b, c
}

function main() {
  let a = pair()
  let b = pair()
  print("${a == b} ${a == a}\n")
  let c = other()
  print("${a == c} ${a != c}\n")
  print("${triple(1, "x", true) == triple(1, "x", true)}\n")
  print("${triple(1, "x", true) == triple(1, "x", false)}\n")
  print("${triple(1, "x", true) == triple(2, "x", true)}\n")
  print("${triple(1, "x", true) == triple(1, "y", true)}\n")
}
