// run
// `ptrOf` inside a `@nosplit` body (#1421) — §11.11 states module state is
// addressable via `ptrOf` from `@nosplit`, but §10.3.1's allowlist admitted only
// the atomics, `entryOf` and numeric conversions, so the checker rejected it.
//
// The checker was the side at fault. `ptrOf` allocates and reaches no safepoint
// in EITHER form: on module state it is a link-time constant address
// materialized inline (`global_addr` + retype, the same shape `entryOf` is
// admitted for), and on a slice it is two field reads and an add — field access
// on a value in hand plus arithmetic, both already on the allowlist. Refusing it
// while admitting the atomics carved out an operation that could never be
// reached, since the atomics take a `*T` and `ptrOf` is the only bridge to one.
//
// Both forms are exercised here because both are on the proof, and because the
// two callers that forced the issue need one each: the allocator's lock word is
// module state, the scheduler's run queue is a slice.
let lockWord: i64 = 0
let hits: i64 = 0

// Module-state form: pure address arithmetic against a static symbol.
@nosplit function tryLock(): bool {
  return atomicCmpxchg(ptrOf(lockWord), 0, 1)
}

@nosplit function unlock() {
  atomicStore(ptrOf(lockWord), 0)
}

@nosplit function bumpHits(): i64 {
  return atomicAdd(ptrOf(hits), 1)
}

// Slice form: `buf + off*8`, reached through a value in hand.
@nosplit function cellAdd(s: []i64, v: i64): i64 {
  let p = ptrOf(s)
  return atomicAdd(p, v)
}

// `ptrOf` through a `@nosplit` callee still resolves on the callee's own
// attribute, so the transitive rule is unaffected by the carve-out.
@nosplit function lockTwice(): bool {
  let first = tryLock()
  let second = tryLock()
  unlock()
  return first && !second
}

function main() {
  print("locked=${tryLock()}")
  print(" relock=${tryLock()}")
  unlock()
  print(" after=${tryLock()}\n")
  unlock()

  print("hits=${bumpHits()},${bumpHits()},${bumpHits()}\n")

  let cell = []i64(1)
  atomicStore(ptrOf(cell), 10)
  print("cell=${cellAdd(cell, 5)}")
  print(" now=${atomicLoad(ptrOf(cell))}\n")

  print("twice=${lockTwice()}\n")
}
