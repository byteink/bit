// run
// stdlib/json/value.bit's Json sum type + jsonGet/jsonAsInt/jsonAsString
// (#1479), exercised behaviourally. A golden case is a single file with no
// prelude and cannot import std/json (see run_math.bit), so this redeclares
// the same shapes locally — the same trade the Option-payload coverage in
// run_generic_enum_payload.bit already makes for the prelude's Option.
//
// Covers: jsonGet's documented last-key-wins policy on a duplicate key, a
// missing key, and jsonAsInt/jsonAsString returning None (not a panic) when
// called on the wrong variant — the shape untrusted JSON decoding must
// tolerate as data, not a crash.
enum Opt<T> { Some(T), None }

struct JsonEntry { key: string, value: Json }

enum Json {
  JsonNull
  JsonBool(bool)
  JsonInt(i64)
  JsonFloat(f64)
  JsonString(string)
  JsonArray([]Json)
  JsonObject([]JsonEntry)
}

function jsonGet(o: Json, key: string): Opt<Json> {
  match (o) {
    JsonObject(entries) => {
      let found = Opt<Json>.None
      for e of entries {
        if (e.key == key) {
          found = Opt<Json>.Some(e.value)
        }
      }
      return found
    }
    JsonNull => return Opt<Json>.None
    JsonBool(b) => return Opt<Json>.None
    JsonInt(i) => return Opt<Json>.None
    JsonFloat(f) => return Opt<Json>.None
    JsonString(s) => return Opt<Json>.None
    JsonArray(a) => return Opt<Json>.None
  }
}

function jsonAsInt(j: Json): Opt<i64> {
  match (j) {
    JsonInt(i) => return Opt<i64>.Some(i)
    JsonNull => return Opt<i64>.None
    JsonBool(b) => return Opt<i64>.None
    JsonFloat(f) => return Opt<i64>.None
    JsonString(s) => return Opt<i64>.None
    JsonArray(a) => return Opt<i64>.None
    JsonObject(o) => return Opt<i64>.None
  }
}

function jsonAsString(j: Json): Opt<string> {
  match (j) {
    JsonString(s) => return Opt<string>.Some(s)
    JsonNull => return Opt<string>.None
    JsonBool(b) => return Opt<string>.None
    JsonInt(i) => return Opt<string>.None
    JsonFloat(f) => return Opt<string>.None
    JsonArray(a) => return Opt<string>.None
    JsonObject(o) => return Opt<string>.None
  }
}

function main() {
  let obj = Json.JsonObject([]JsonEntry{
    JsonEntry{ key: "a", value: Json.JsonInt(1) },
    JsonEntry{ key: "b", value: Json.JsonString("x") },
    JsonEntry{ key: "a", value: Json.JsonInt(2) },
  })

  // Duplicate key "a": jsonGet must return the LAST entry's value (2, not 1).
  match (jsonGet(obj, "a")) {
    Some(v) => {
      match (v) {
        JsonInt(i) => { print("dup=${i}\n") }
        JsonNull => { print("dup=wrong\n") }
        JsonBool(b) => { print("dup=wrong\n") }
        JsonFloat(f) => { print("dup=wrong\n") }
        JsonString(s) => { print("dup=wrong\n") }
        JsonArray(a) => { print("dup=wrong\n") }
        JsonObject(o) => { print("dup=wrong\n") }
      }
    }
    None => { print("dup=missing\n") }
  }

  // Absent key: None, not a panic.
  match (jsonGet(obj, "c")) {
    Some(v) => { print("missing=found\n") }
    None => { print("missing=none\n") }
  }

  // Wrong-variant accessors: None, not a panic.
  match (jsonAsInt(Json.JsonString("x"))) {
    Some(i) => { print("asIntOnString=${i}\n") }
    None => { print("asIntOnString=none\n") }
  }

  match (jsonAsString(Json.JsonInt(5))) {
    Some(s) => { print("asStringOnInt=${s}\n") }
    None => { print("asStringOnInt=none\n") }
  }
}
