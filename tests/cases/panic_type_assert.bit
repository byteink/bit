// panic
// The one-result assertion `iface.(T)` panics on a mismatch (SPEC §14.4, §18.4).
// Both concrete type names come from the `TypeInfo` descriptors the assertion
// already compares (ABI.md §2.2), so the message can name them — a bare "type
// assertion failed" would leave you guessing what it actually held.
class Circle { r: i64 }

class Square { s: i64 }

fn (c: Circle) area(): i64 { return c.r }

fn (q: Square) area(): i64 { return q.s }

interface Shape { area(): i64 }

fn main() {
  let sh: Shape = Circle{ r: 2 }
  let q = sh.(Square)
  print("unreachable ${q.s}\n")
}
