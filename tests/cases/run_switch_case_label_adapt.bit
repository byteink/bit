// run
// #2428: the legal untyped-literal adaptations a case label must keep making
// now that a label is type-checked against its subject — an untyped int
// label assignable into a SIZED integer subject (the same range check
// `u == 200` already runs), and an untyped rune label against a plain `int`
// subject (comparing the rune's code point, exactly as `n == 'a'` already
// does).
fn main() {
  let u: u8 = 200
  let us = "no"
  switch (u) {
    case 200:
      us = "yes"
    default:
      us = "no"
  }
  print("u8   ${us}\n")

  let n = 97
  let ns = "no"
  switch (n) {
    case 'a':
      ns = "yes"
    default:
      ns = "no"
  }
  print("rune ${ns}\n")
}
