// run
// std/csv golden (#2289): RFC 4180 quoting is the whole ticket, and the
// expensive rule is the one about a newline inside a quoted field not
// ending the record. Seven cases, matching the acceptance criterion
// verbatim: a bare field, an embedded comma, an embedded doubled quote, an
// embedded newline inside a quoted field, a CRLF terminator, an empty
// field, and a final record with no trailing terminator at all.
import { csvParse, csvFormat } from "std/csv"

// Parses `source`, prints every field of every record, then re-formats and
// re-parses the result and prints whether the two field grids are
// identical -- the round-trip half of the acceptance criterion.
fn roundtrip(label: string, source: string) {
  let records = csvParse(source) catch e {
    print("${label}: PARSE-FAIL ${e.message()}\n")
    return
  }
  let r = 0
  while (r < len(records)) {
    let row = records[r]
    let c = 0
    while (c < len(row)) {
      print("${label}: record${r} field${c}=[${row[c]}]\n")
      c = c + 1
    }
    r = r + 1
  }
  let text = csvFormat(records)
  let back = csvParse(text) catch e {
    print("${label}: REPARSE-FAIL ${e.message()}\n")
    return
  }
  print("${label}: roundtrip=${gridEquals(records, back)}\n")
}

fn gridEquals(a: [][]string, b: [][]string): bool {
  if (len(a) != len(b)) {
    return false
  }
  let r = 0
  while (r < len(a)) {
    if (len(a[r]) != len(b[r])) {
      return false
    }
    let c = 0
    while (c < len(a[r])) {
      if (a[r][c] != b[r][c]) {
        return false
      }
      c = c + 1
    }
    r = r + 1
  }
  return true
}

fn main() {
  // A bare field: no quoting needed anywhere.
  roundtrip("bare", "a,b,c\n")

  // An embedded comma forces quoting on that field alone.
  roundtrip("comma", "a,\"b,c\",d\n")

  // An embedded doubled quote decodes to one literal `"`.
  roundtrip("dquote", "a,\"say \"\"hi\"\"\",c\n")

  // An embedded newline inside a quoted field is data, not a record
  // boundary -- get this wrong and every later row is off by one.
  roundtrip("newline", "a,\"line1\nline2\",c\n")

  // A CRLF terminator.
  roundtrip("crlf", "a,b,c\r\n")

  // An empty field.
  roundtrip("empty", "a,,c\n")

  // A final record with no trailing terminator at all.
  roundtrip("noterm", "a,b,c")

  // The acceptance criterion's own case, verbatim.
  roundtrip("acceptance", "a,\"b,c\",\"say \"\"hi\"\"\",\"line1\nline2\"\r\n")
}
