// run
// The killer case (#1158): a narrow add whose result feeds a logical right
// shift in-register. 0x80000000 + 0x80000000 must wrap to 0 at u32 width, so
// (0) >> 1 == 0. A full-width add leaves 0x100000000, and 0x100000000 >> 1 is
// 0x80000000 (2147483648) — the silent miscompile this guards against.
//
// `blackbox` is a runtime-value barrier: it is multi-block, so the -O1 inliner
// skips it and the constant folder cannot see through the call. The arithmetic
// therefore runs in codegen on a value the optimizer treats as unknown —
// exactly the path real crypto (non-constant data) takes, and the path #1158
// fixes. Without the barrier, -O1 folds the whole expression at compile time
// (unsigned overflow folds modularly) and the codegen bug never runs.
fn blackbox(x: u32): u32 {
  if (x == 0) { return 0 }
  return x
}

fn main() {
  let a: u32 = blackbox(0x80000000)
  print("${(a + a) >> 1}\n")
}
