// error
// A destructuring assignment needs a tuple (SPEC §13.1) or a two-result form
// (§12.6/§14.4/§16.2); `5` is neither. The parser folds a target list into one
// pattern, so without this check the arity test sees 1 target and 1 value and
// waves the statement through untyped.
fn main() {
  let a = 1
  let b = 2
  (a, b) = 5
  print("${a}\n")
}
