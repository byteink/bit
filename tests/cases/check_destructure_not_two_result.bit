// error
// A destructuring assignment only makes sense against a two-result form (SPEC
// §12.6/§14.4/§16.2). The parser folds a parenthesized target list into one
// pattern, so without this check the arity test sees 1 target and 1 value and
// waves the statement through untyped.
function main() {
  let a = 1
  let b = 2
  (a, b) = 5
  print("${a}\n")
}
