// run
// #2275: an arrow parameter written WITHOUT a type annotation, whose body
// INDEXES it, compiled clean and returned the slice HEADER. `xs[0]` gave the
// data pointer (a live heap address, different every run) and `xs[1]` gave the
// length. No diagnostic at any stage: `bit check` exited 0, `bit build` emitted
// a binary, and the binary printed garbage — or took SIGBUS on the []string
// shape below.
//
// The mechanism, so a future reader can tell a regression from a near miss:
// `checkArrowFnAt` left an unannotated parameter's type at 0, so the arrow's
// own function type interned with an invalid member; `lowerClosureBody`
// declared the closure local at that type; and `lowerIndex` fell through its
// slice/map/string arms to the fixed-array `index_get` — raw word addressing
// over `{ptr, len, cap}`. A wrong value here means the parameter type is not
// reaching lowering again, NOT that indexing is broken.
//
// The map and string shapes are here because they take different arms of
// `lowerIndex`, and the multi-parameter comparator because it is the lambda
// application code actually writes.
fn use(xs: []int, f: ([]int) => int): int {
  return f(xs)
}

fn main() {
  let f: ([]int) => int = xs => xs[0]
  let g: ([]int) => int = xs => xs[1]
  let h: ([]int) => int = xs => xs[0] + 0
  let s: ([]string) => string = xs => xs[0]
  let m = map<int, int>{}
  m[1] = 42
  let q: (map<int, int>) => int = t => t[1]
  let c: (int, int) => bool = (p, r) => p < r
  print("f=${f([10, 20])} g=${g([10, 20])} h=${h([7, 8])}\n")
  print("s=${s(["hi", "yo"])} q=${q(m)} c=${c(1, 2)}\n")
  print("arg=${use([7], xs => xs[0])}\n")
}
