// run
// #1457: an `f32` reaching `${...}` printed `0.000...` while the value itself
// was provably correct (comparison, arithmetic and `f64(f)` widening all agreed
// on it). Two independent defects, both silent:
//
//   1. `bit_rt_string_from_float` takes an `f64`, so an `f32` passed straight
//      through arrived in `s0`/`xmm0` with the upper half undefined and the
//      callee formatted a denormal near zero. Lowering now widens f32 -> f64 at
//      the call site.
//   2. A struct literal lowered its field initializers with NO type hint, so
//      `T{ c: 4.5 }` materialized `4.5` at its default type `f64` and the
//      `field_set` wrote the field's 4-byte width from it — the low half of an
//      f64, which is zero. The field's own type is now the hint.
//
// The second one is a wrong VALUE, not a wrong rendering: `t.c == 4.5` was
// FALSE. It hid behind the first, because both print as `0`.
//
// This golden prints f32 values DIRECTLY, never through `f64(...)` — the
// widening conversion was the one path that already worked, so routing through
// it would make the test vacuous. The `float32Bits` lines are the independent
// check that the stored word is right and not merely that the formatter agrees
// with itself.
//
// A golden case is a single file, so it has no prelude.

struct T {
  c: f32,
  d: f32,
}

struct Mixed {
  n: i64,
  c: f32,
  f: f64,
}

fn main() {
  // A plain local, and an f32 arithmetic result.
  let f: f32 = 4.5
  let g: f32 = 2.0
  print("local=${f},${g}\n")
  print("arith=${f + g},${f * g},${f - g}\n")

  // A struct field, both on its own and packed next to other widths — a
  // narrow field's offset is where a width mix-up shows up.
  let t = T{ c: 4.5, d: 1.25 }
  print("field=${t.c},${t.d}\n")
  print("fieldbits=${float32Bits(t.c)},${float32Bits(t.d)}\n")
  let m = Mixed{ n: 7, c: 4.5, f: 8.5 }
  print("mixed=${m.n},${m.c},${m.f}\n")

  // An f32 slice element: the container word ABI (#1456) on top of the
  // formatting path, printed rather than bit-compared.
  let xs = []f32(3)
  xs[0] = 1.5
  xs[1] = 2.5
  xs[2] = 3.5
  print("slice=${xs[0]},${xs[1]},${xs[2]}\n")

  // The f64 control: this path was never broken and must stay right.
  let d: f64 = 4.5
  print("f64ctl=${d}\n")
}
