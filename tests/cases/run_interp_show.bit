// run
// SPEC §5.7: a type implementing `show(): string` interpolates — statically for
// a concrete receiver, through the interface method table for an interface one,
// and per monomorphization inside a generic body. Primitives still convert
// directly, including inside the same literal.
interface Show { show(): string }
class Point { x: i64, y: i64 
  show(): string {
    return "(${this.x},${this.y})"
  }
}
fn render(s: Show): string {
  return "[${s}]"
}
fn label<T>(v: T): string {
  return "<${v}>"
}
fn main() {
  let p = Point{x: 1, y: 2}
  print("direct=${p}\n")
  print("iface=${render(p)}\n")
  print("generic=${label(p)} ${label(7)} ${label(true)}\n")
  print("prims=${1 + 1} ${2.5} ${'A'} ${"s"} ${false}\n")
}
