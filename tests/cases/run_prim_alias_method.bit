// run
// #2728: a method call on a PRIMITIVE-ALIAS receiver — `type Meters = i64` —
// dispatches statically, exactly like a struct receiver, through lowerCall's
// Member branch in compiler/lowercall.bit.
//
// Before this fix, `recvTy`'s `TypeKind.Prim` matched neither the Interface arm
// nor the Struct arm, so `bit check` exited 0 (the checker already accepts a
// method call on a prim receiver whose method DOES exist — that half of the
// language was always sound) but `bit build` fell through to loweraccess.bit's
// generic field-access lowerer and refused with `error[E0092]: cannot lower a
// `.` field access on a receiver that is not a struct or interface`, so the
// program never ran at all. `defer m.bye()` already built and ran before this
// fix, proving the symbol `bye$t11` and the `ctx.methodSigs` entry under the
// prim type id both existed — only the direct-call arm was missing.
type Meters = i64

fn (m: Meters) bye(): string {
  print("BYE ${m}\n")
  return "x"
}

fn main() {
  let m: Meters = 3
  let s = m.bye()
  print("done ${s}\n")
}
