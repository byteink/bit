// run
// #2128: a boxed local whose VALUE is a GC reference. The cell is a one-word
// record, so its pointer map has to mark word 0 — miss that and the collector
// frees a captured string or slice that is still live. 2000 iterations of string
// concatenation is the allocation pressure that makes the miss fatal rather than
// theoretical.
function main() {
  let msg = "a"
  let total = 0
  let grow = (s: string) => { msg = msg + s; total = total + len(msg) }
  let i = 0
  while (i < 2000) {
    grow("x")
    i = i + 1
  }
  print("${len(msg)} ${total}\n")
}
