// run
// #2407: a switch-case label was tested with a bare `icmp_eq` on the two
// handles, so `switch (s) { case "one": }` asked "same allocation?" and took
// `default` for every string that was not the literal itself. `s == "one"` in an
// `if` answered true for the same two values, because that path routes a
// `string` through `string_eq` — so the two spellings of `==` disagreed, and only
// the switch was wrong. A class subject never matched at all, for the same
// reason (#2105/#2113 had already made `==` field-wise; the switch stayed
// handle-wise).
//
// `name(1)` returns a CONCATENATION on purpose. The bug is invisible when the
// subject is itself a literal, because the string pool interns by content and
// both sides are then the same handle — that accident is why this survived, so
// the subject here must be built at run time.
//
// The float and enum switches pin the paths the fix must not take with it: the
// label test now runs the full comparison selection, so a float has to keep
// picking `fcmp_eq` (a word compare of two float registers is nonsense) and a
// C-like enum has to keep its plain tag compare.
//
// Single-file golden: no prelude.
class P { x: int }

enum Colour { Red, Green, Blue }

fn name(n: int): string {
  if (n == 1) {
    return "o" + "ne"
  }
  return "two"
}

fn main() {
  let s = name(1)
  switch (s) {
    case "one":
      print("switch: matched one\n")
    default:
      print("switch: default\n")
  }
  print("if: ${s == "one"}\n")

  let a = P{ x: 1 }
  switch (a) {
    case P{ x: 1 }:
      print("switch: one\n")
    default:
      print("switch: other\n")
  }

  let f = 1.5
  switch (f) {
    case 1.5:
      print("switch: float ok\n")
    default:
      print("switch: float FAIL\n")
  }

  let c = Colour.Red
  switch (c) {
    case Colour.Red:
      print("switch: enum ok\n")
    default:
      print("switch: enum FAIL\n")
  }
}
