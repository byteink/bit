// run
// `[]T(n)` where T is a class must leave n LIVE zero instances, not n nulls
// (#1924).
//
// `slice_new` zeroes the backing store, which is the zero value of a scalar or
// a nested slice and a NULL for a class, because structs are references. So
// `[]Inner(3)` used to hand back three wild pointers and `s[0].xs` segfaulted
// with no diagnostic — on the one construct whose documented meaning is "n zero
// values" (SPEC §12.9).
//
// The elements must also be INDEPENDENT objects. A fill that stored one shared
// instance n times would pass a read-only check and then alias on the first
// write, so `s[1]` is mutated below and `s[0]` re-read afterwards.
class Inner { xs: []u32, n: int }

fn main() {
  let s = []Inner(3)
  print("len=")
  print(itoa(len(s)))
  print(" s0.xs=")
  print(itoa(len(s[0].xs)))
  print(" s2.n=")
  print(itoa(s[2].n))
  print("\n")

  // Independence: writing through one element must not touch another.
  s[1].n = 42
  s[1].xs = append(s[1].xs, u32(7))
  print("s1.n=")
  print(itoa(s[1].n))
  print(" s1.xs=")
  print(itoa(len(s[1].xs)))
  print(" s0.n=")
  print(itoa(s[0].n))
  print(" s2.xs=")
  print(itoa(len(s[2].xs)))
  print("\n")

  // Degenerate and two-argument forms: zero length allocates nothing to fill,
  // and `[]T(n, cap)` fills n, not cap.
  let e = []Inner(0)
  let big = []Inner(2, 16)
  print("empty=")
  print(itoa(len(e)))
  print(" big=")
  print(itoa(len(big)))
  print(" big1.n=")
  print(itoa(big[1].n))
  print("\n")
}

fn itoa(n: int): string {
  if (n == 0) { return "0" }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) { s = d[v % 10 : v % 10 + 1] + s; v = v / 10 }
  return s
}
