// run
// C-like enums (§14.4) and exhaustive `match` (§16.4): declaration, variant
// construction (EnumName.Variant), an enum-typed parameter, match as a
// statement with side-effecting arms, and match with returning arms.
enum Color { Red, Green, Blue }

fn name(c: Color): string {
  match (c) {
    Red => { return "red" }
    Green => { return "green" }
    Blue => { return "blue" }
  }
  return "?"
}

fn main() {
  print("${name(Color.Red)} ${name(Color.Green)} ${name(Color.Blue)}\n")

  let c = Color.Green
  match (c) {
    Red => print("is red\n")
    Green => print("is green\n")
    Blue => print("is blue\n")
  }
}
