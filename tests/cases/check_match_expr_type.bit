// error
// In a `match` expression every arm must yield the same type (§13.8): the first
// arm fixes the result type (i64 here) and a later arm of a different type is an
// error, just like a mismatched `return`.
enum Color { Red, Green, Blue }

function main() {
  let x = match (Color.Red) {
    Red   => 1
    Green => "green"
    Blue  => 3
  }
}
