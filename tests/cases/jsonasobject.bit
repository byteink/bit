// run
// stdlib/json/value.bit's jsonAsObject (#2180): the missing enumeration
// accessor. Every other Json variant has an `jsonAsX`; JsonObject only had
// `jsonGet`, which answers one known key at a time and cannot enumerate the
// keys a caller was actually given.
//
// Covers: source order preserved (not re-sorted), a duplicate key surviving
// as two separate entries rather than being deduped or last-wins (that
// policy is jsonGet's, not this accessor's), and None on every non-object
// Json variant — a shape mismatch is data, not a crash.
import { jsonParse, jsonAsObject, jsonAsInt, Json, JsonEntry } from "std/json"

fn main() {
  let ordered = jsonParse("{\"a\":1,\"b\":2}") catch e {
    print("parse failed: ${e.message()}\n")
    return
  }
  match (jsonAsObject(ordered)) {
    Some(entries) => {
      print("len=${len(entries)}\n")
      print("key0=${entries[0].key}\n")
      print("key1=${entries[1].key}\n")
    }
    None => print("ordered=wrong-type\n")
  }

  let dup = jsonParse("{\"a\":1,\"a\":2}") catch e {
    print("parse failed: ${e.message()}\n")
    return
  }
  match (jsonAsObject(dup)) {
    Some(entries) => {
      print("dup_len=${len(entries)}\n")
      print("dup_key0=${entries[0].key}\n")
      match (jsonAsInt(entries[0].value)) {
        Some(i) => print("dup_val0=${i}\n")
        None => print("dup_val0=wrong-type\n")
      }
      print("dup_key1=${entries[1].key}\n")
      match (jsonAsInt(entries[1].value)) {
        Some(i) => print("dup_val1=${i}\n")
        None => print("dup_val1=wrong-type\n")
      }
    }
    None => print("dup=wrong-type\n")
  }

  match (jsonAsObject(Json.JsonNull)) {
    Some(entries) => print("null=some\n")
    None => print("null=none\n")
  }
  match (jsonAsObject(Json.JsonBool(true))) {
    Some(entries) => print("bool=some\n")
    None => print("bool=none\n")
  }
  match (jsonAsObject(Json.JsonInt(1))) {
    Some(entries) => print("int=some\n")
    None => print("int=none\n")
  }
  match (jsonAsObject(Json.JsonFloat(1.5))) {
    Some(entries) => print("float=some\n")
    None => print("float=none\n")
  }
  match (jsonAsObject(Json.JsonString("x"))) {
    Some(entries) => print("string=some\n")
    None => print("string=none\n")
  }
  match (jsonAsObject(Json.JsonArray([]Json{}))) {
    Some(entries) => print("array=some\n")
    None => print("array=none\n")
  }
}
