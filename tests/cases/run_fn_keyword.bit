// run
// #2760: `fn` is a synonym for `function` in the lexer keyword table — one
// token (Kind.KwFunction) covers all three declaration forms, so all three
// must parse under the new spelling. `getpid` (SPEC §11.7's own example) is
// on the libSystem admit-list (compiler/machosyms.bit); `puts` is not, so an
// `extern fn puts` declaration parses (verified separately with `bit check`)
// but cannot be part of a fixture this gate actually links and runs.
class Box { v: int }

fn (b: Box) get(): int { return b.v }

extern fn getpid(): i32

fn main() {
  let b = Box{ v: 42 }
  print("hi ${b.get()} pid=${getpid() > 0}\n")
}
