// run
// #2012: `for (i, x) of` a slice or an array. The checker MODELS the form — it
// types the index binder `i64` and the element binder as the element type, and
// annotating the index `string` reports a correctly spanned E0041 — but
// lowering admitted the pair only over a map, so `bit check` exited 0 and
// `bit build` refused the whole function with a spanless "cannot lower".
//
// Nothing in the corpus wrote the slice/array pair, which is why a form the
// front end fully implements stayed unlowerable. `for (k, v) of m` was covered
// four times over.
//
// A golden case is a single file, so it has no prelude.
function main() {
  // The index is the loop's own cursor, not a copy of the element.
  let xs = [10, 20, 30]
  for (i, x) of xs {
    print("int ${i}=${x}\n")
  }

  // The element binder follows the slice's element type, not the index's.
  let names = ["ann", "bo"]
  for (i, s) of names {
    print("str ${i}=${s}\n")
  }

  // A fixed array counts by the same cursor (§12.3's typed array literal is the
  // only array construction there is).
  let arr = [3]i64{7, 8, 9}
  for (i, v) of arr {
    print("arr ${i}=${v}\n")
  }

  // `_` discards the index; the element still binds.
  let total = 0
  for (_, v) of xs {
    total = total + v
  }
  print("total ${total}\n")

  // ... and `_` discards the element, leaving a plain index loop.
  let idxSum = 0
  for (i, _) of xs {
    idxSum = idxSum + i
  }
  print("indices ${idxSum}\n")

  // `break` and `continue` still target the loop, and the two binders stay in
  // step across both.
  for (i, x) of xs {
    if (i == 0) {
      continue
    }
    if (x == 30) {
      break
    }
    print("mid ${i}=${x}\n")
  }

  // An empty iterable runs the body zero times, index and all.
  let none = []int(0)
  for (i, x) of none {
    print("unreachable ${i}=${x}\n")
  }
  print("done\n")
}
