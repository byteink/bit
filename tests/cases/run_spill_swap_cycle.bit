// run
// Regression (#1235): a function holding many live `u64` across a loop with an
// early `return` spills its loop-carried locals. On the loop back-edge the
// register allocator recycles stack slots, so two spilled loop-carried values
// end up SWAPPING slots — a mem<->mem cycle in the edge's parallel move. The
// cycle-breaking scratch register was the same one `emitMove` uses internally
// for a mem->mem copy, so the first rotation step clobbered the saved value and
// the swap resolved to garbage: one accumulator silently took another's value
// (e.g. a loop counter that fails to advance, or a wrong sum). This shape mirrors
// the Poly1305 clamp+absorb+finalize function that first exposed it on
// aarch64-macos. Twelve accumulators forces enough spilling to hit the cycle.
fn mac(xs: []u64, stop: u64): u64 {
  let a0: u64 = 1
  let a1: u64 = 2
  let a2: u64 = 3
  let a3: u64 = 4
  let a4: u64 = 5
  let a5: u64 = 6
  let a6: u64 = 7
  let a7: u64 = 8
  let a8: u64 = 9
  let a9: u64 = 10
  let a10: u64 = 11
  let a11: u64 = 12
  for x of xs {
    a0 = a0 + x
    a1 = a1 + x * u64(2)
    a2 = a2 + x * u64(3)
    a3 = a3 + x * u64(4)
    a4 = a4 + x * u64(5)
    a5 = a5 + x * u64(6)
    a6 = a6 + x * u64(7)
    a7 = a7 + x * u64(8)
    a8 = a8 + x * u64(9)
    a9 = a9 + x * u64(10)
    a10 = a10 + x * u64(11)
    a11 = a11 + x * u64(12)
    if (x == stop) {
      return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
    }
  }
  return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
}
fn main() {
  let xs = [u64(10), u64(20), u64(30), u64(40), u64(50)]
  print("r=${mac(xs, u64(30))}\n")
}
