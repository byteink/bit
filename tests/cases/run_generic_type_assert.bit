// run
// A type assertion to a generic struct instantiation. `lowerTypeInfo` used to
// lay the struct out with `noSubst()`, resolving the field declared `v: T`
// against the bare, unbound type param instead of the instantiation's real
// argument — so `Box<i64>`'s integer was mapped as a traced GC pointer (#1565).
//
// A wrong `ptrOffsets` here is a GC PRECISION bug: the descriptor is baked into
// a static .rodata TypeInfo blob and tells the collector which words to walk.
// It is also self-inconsistent, which is what this case pins: an assertion
// compares TypeInfo POINTERS, and the descriptor built at the assertion site
// has to be the same object as the one built at the allocation site. With one
// side substituted (`gc_alloc`, fixed in #1557) and the other not, the two
// mangled symbols differed and the assertion failed with "Box is not Box" even
// though the value's type was exactly right.
//
// `Box<i64>` must map NO pointers and `Box<string>` exactly one, at offset 0.
struct Box<T> {
  v: T
}

interface Any {
  tag(): i64
}

function (b: Box<T>) tag(): i64 {
  return 7
}

function main() {
  let bi = Box<i64>{ v: 42 }
  let bs = Box<string>{ v: "hi" }

  let ai: Any = bi
  let as2: Any = bs

  // Round-tripping through the interface and back must recover both values.
  let xi = ai.(Box<i64>)
  let xs = as2.(Box<string>)
  print("scalar ${xi.v}\n")
  print("ref ${xs.v} len ${len(xs.v)}\n")

  // The dynamic type must still be told apart from the other instantiation:
  // a shared or colliding descriptor would make both assertions succeed.
  let (bad, ok) = ai.(Box<string>)
  if (ok) {
    print("WRONG: Box<i64> asserted as Box<string>\n")
  } else {
    print("distinct instantiations\n")
  }
}
