// run
// #2278 (ASCII half): std/strings had no case-insensitive comparison at all,
// so every caller had to allocate two lowercased copies first. `equalFold`
// adds that without allocating, for ASCII. Full Unicode case folding (so
// `toLower`/`toUpper`/`equalFold` handle non-ASCII scripts) is deferred to
// #2341 — bytes >= 0x80 compare exactly here, unfolded.
import { equalFold } from "std/strings"

fn main() {
  assert(equalFold("abc", "ABC"), "pure-ASCII fold must match")
  assert(equalFold("Bob", "bob"), "mixed-case ASCII fold must match")
  assert(!equalFold("abc", "abd"), "different letters must not match")
  assert(!equalFold("abc", "abcd"), "different lengths must not match")
  assert(equalFold("", ""), "two empty strings must match")
  assert(equalFold("HTTP/1.1", "http/1.1"), "non-letter bytes must compare exactly")
  assert(!equalFold("straße", "STRASSE"), "simple ASCII folding must not expand ß to ss")
  // "É" (U+00C9) vs "é" (U+00E9): same byte length (2 bytes each), differ only
  // by case in a script ASCII folding does not touch — must compare unequal.
  assert(!equalFold("É", "é"), "non-ASCII bytes are not folded yet (#2341)")
  println("ok")
}
