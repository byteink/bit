// run
// Positive control for #2556/#2557's `++`/`--` numeric-operand check
// (E0053): `xs[i]++` inside a generic `<T>` body must still pass `bit check`
// once `T` is bound to a numeric type at the call site. #2556 landed a
// checker-side guard that read the declared (rigid, unsubstituted) operand
// type and refused this exact shape — the same regression
// `tests/bit/lowerrefuse.bit`'s `lv-generic-slice-incdec` catches at the
// lowering-guard level. This pins it at the checker level too, in the
// corpus `selfhost-diffcheck.sh` sweeps on every gate, so it cannot regress
// silently again.
fn step<T>(xs: []T, i: int) {
  xs[i]++
}

fn main() {
  let xs = [1, 2, 3]
  step(xs, 2)
  print("${xs[0]},${xs[1]},${xs[2]}\n")
}
