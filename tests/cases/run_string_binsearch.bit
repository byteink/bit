// run
// The victim pattern of #1664: a binary search over a sorted string table.
// It needs `<` to order by CONTENT; while `<` compared backing addresses
// this reported 'absent' for entries that are present. The table order and
// every expected index below come from Python's sort on bytes, not from Bit.

// Lower-bound binary search: the first index whose entry is >= key.
fn find(table: []string, key: string): int {
  let lo = 0
  let hi = len(table)
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2
    if (table[mid] < key) {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if (lo < len(table) && table[lo] == key) {
    return lo
  }
  return -1
}

fn main() {
  // `probes` is declared FIRST, in UNSORTED order, on purpose: string
  // literals intern in order of first appearance, so this makes address
  // order disagree with content order. With the #1664 pointer compare in
  // place this case fails; with the table declared first it would not.
  let probes = [
    "getpid",
    "h",
    "getpie",
    "a",
    "ab",
    "abc",
    "exit",
    "exit_group",
    "read",
    "readv",
    "write",
    "writev",
    "openat",
    "open",
    "close",
    "mmap",
    "mmap2",
    "munmap",
    "z",
    "zz",
    "Z",
    "A0",
    "_x",
    "getpi",
    "getpif",
    "",
    "aa",
    "zzz",
    "mmap3",
    "~",
    "B",
  ]
  let table = [
    "A0",
    "Z",
    "_x",
    "a",
    "ab",
    "abc",
    "close",
    "exit",
    "exit_group",
    "getpid",
    "getpie",
    "h",
    "mmap",
    "mmap2",
    "munmap",
    "open",
    "openat",
    "read",
    "readv",
    "write",
    "writev",
    "z",
    "zz",
  ]
  // The table must be sorted for the search to be meaningful; assert it.
  let i = 1
  let ordered = true
  while (i < len(table)) {
    if (!(table[i - 1] < table[i])) {
      ordered = false
    }
    i = i + 1
  }
  print("ordered ${ordered}\n")
  let missing = 0
  let j = 0
  while (j < len(probes)) {
    let at = find(table, probes[j])
    print("${probes[j]} ${at}\n")
    if (at < 0) {
      missing = missing + 1
    }
    j = j + 1
  }
  print("missing ${missing}\n")
}
