// run
// #3568: `*` of a possibly-empty body, e.g. `(|a)*`, must resolve exactly
// like Go's leftmost-first: the body's first (nullable) branch always
// wins, so the star completes one empty iteration and stops there — it
// never gets a chance to try the second branch's real characters.
// Ground truth (Go 1.27.0, `go run`):
//   regexp.MustCompile("(|a)*").FindStringSubmatchIndex("aa") == [0 0 0 0]
// i.e. whole match [0,0), group 1 also [0,0) (the group DID participate,
// via its empty branch, not [-1,-1) from never entering the loop body).
//
// The second case is the one a naive fix could quietly break: an ORDINARY
// greedy `(a)*` (non-nullable body) against "aaa" must still consume as
// far as it can, unaffected by the nullable-body special case above.
// Ground truth (Go 1.27.0, `go run`):
//   regexp.MustCompile("(a)*").FindStringSubmatchIndex("aaa") == [0 3 2 3]
// i.e. whole match [0,3), group 1 [2,3) (the last iteration's span).
import { mustCompile } from "std/regex"

fn reportFind(label: string, pat: string, subj: string) {
  let re = mustCompile(pat)
  let m = re.find(subj)
  match (m) {
    Some(mm) => {
      let g1 = mm.group(1)
      match (g1) {
        Some(g) => print("${label}: whole=[${mm.start},${mm.end}) group1=[${g.start},${g.end})\n")
        None => print("${label}: whole=[${mm.start},${mm.end}) group1=NONE\n")
      }
    }
    None => print("${label}: NO MATCH\n")
  }
}

fn main() {
  reportFind("nullable(|a)*", "(|a)*", "aa")
  reportFind("greedy(a)*", "(a)*", "aaa")
}
