// run
// SPEC §10.7, #3370: a trait field of REFERENCE type must be traced by the
// using class's GC pointer map, or the collector will not mark it and the
// object it points at can be swept while the trait field is still the only
// live reference to it. `Box`'s only own field is `tag`; `ref` comes
// entirely from `use Holder`, so if `structLayout` (lowercall.bit) ever
// forgot to add an injected field's offset to `ptrOffsets`, this is the
// shape that catches it: build many `Box`es (each reachable only via the
// growing slice, each `ref` reachable only through that specific `Box`'s
// injected field) and read every `ref.val` back after the fact.
//
// This file's own default-policy run (golden, checked here) cannot exercise
// the bug — the heap never grows enough to collect. The load-bearing check
// is manual: `bit build` this file, then run the binary directly under
// `BIT_GC=stress` (ABI.md §7, collects at every safepoint) and confirm the
// sum is still exactly right. Mutation-tested for #3370 by temporarily
// excluding the injected field's offset from `structLayout`'s ptrOffsets
// (a one-line, reverted change to compiler/lowercall.bit, never committed):
// the mutated build corrupted the printed sum under `BIT_GC=stress`
// (12502504, wrong, reference reused from freed memory), 5/5 repeats on the
// real build stayed at the correct 12497500 — see the ticket record.
class Payload {
  val: i64,
}

trait Holder {
  ref: Payload
}

class Box {
  use Holder
  tag: i64
}

fn build(n: int): []Box {
  let xs = []Box(0)
  let i = 0
  while (i < n) {
    xs = append(xs, Box{ tag: i, ref: Payload{ val: i } })
    i = i + 1
  }
  return xs
}

fn main() {
  let boxes = build(5000)
  let sum = 0
  let i = 0
  while (i < len(boxes)) {
    sum = sum + boxes[i].ref.val
    i = i + 1
  }
  print("n=${len(boxes)} sum=${sum}\n")
}
