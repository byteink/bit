// run
// The no-false-positive half of #1882. validateinst.bit judges interpolation
// operands per monomorphization, so it MUST stay silent when every instantiation
// is legitimately stringable: a primitive, and a named type with `show()`.
// Judging the generic's own rigid `T` instead would reject all of this.
struct Point { x: i64 }
fn (p: Point) show(): string { return "Point(${p.x})" }
fn one<T>(v: T) {
  print("${v}\n")
}
fn two<A, B>(a: A, b: B) {
  print("${a}/${b}\n")
}
fn main() {
  one(1)
  one("s")
  one(true)
  one(Point{x: 2})
  two(3, Point{x: 4})
}
