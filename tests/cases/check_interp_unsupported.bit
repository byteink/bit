// error
// SPEC §5.7: only primitives and types with `show(): string` convert to string.
// Every other operand shape is rejected here, with a location — none may reach
// lowering, which has no diagnostics and would fail with no file/line/column.
struct Point { x: i64 }
enum Color { Red, Green }
function nothing() {}
function twice(n: i64): i64 { return n * 2 }
function main() {
  let xs = []i64{1, 2}
  let arr: [2]u32 = [2]u32{u32(1), u32(2)}
  let m = map<string, i64>{}
  let c = chan<i64>(1)
  let f = twice
  let p = Point{x: 1}
  let col = Color.Red
  print("${xs}")
  print("${arr}")
  print("${m}")
  print("${c}")
  print("${f}")
  print("${p}")
  print("${col}")
  print("${nothing()}")
  print("${nil}")
}
