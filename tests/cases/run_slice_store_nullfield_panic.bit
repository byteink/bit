// panic
// #3108: writing an element of a zeroed struct's slice field. The field holds
// the NULL WORD, not an empty header (SPEC §13.4, #1564/#1570), so this is the
// arm `bit_rt_slice_set` spelled as an explicit `if (h == 0)` before it ever
// looked at a length. `run_slice_index_nullfield_panic.bit` is the read half.
//
// The inline lowering has no `h == 0` test at all: it relies on `slice_len`
// reading a null header as 0, which makes EVERY index fail the bounds compare
// and reach the same panic. Drop the null guard from `emitHeaderWordOrZero` and
// this does not fault the way the read does — the read loads from address 8 and
// gets SIGSEGV, but a STORE would compute `buf + off + index * 8` from two words
// read out of the null page and write there. On this platform page zero is
// unmapped so it is still a fault, which is exit 11 rather than exit 2, and on a
// target where it is not, it is a wild store. Either way it is not this panic.
import { args } from "std/os"

struct Z { xs: []int, n: int }

fn zero(): int { return len(args()) - 1 }

fn main() {
  let z = Z{}
  print("start len=${len(z.xs)}\n")
  z.xs[zero()] = 99
  print("unreachable\n")
}
