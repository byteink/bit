// run
// #2295: `+` over constant strings is a constant expression, so it may
// initialize a top-level `const`. SPEC §15.4 names string among the kinds whose
// literals "(and `const` expressions over them)" are untyped constants, and
// nothing there restricts the fold to arithmetic.
//
// Before the fix `const A: string = "x" + "y"` was
// `error[E0064]: top-level 'const' initializer must be a compile-time constant
// expression`, one line below a numeric fold that succeeded. Both halves of the
// machinery were already present and neither was reachable from the other: the
// string arm of the folder returns a constant (#1534 added it), and the Binary
// arm then discarded it, admitting `vcInt` operands only.
//
// WHY THIS IS SAFE DESPITE `vcString` CARRYING NO VALUE. A top-level scalar
// `const` is not a static cell — it is re-lowered from its initializer node at
// every use site — so nothing renders this into a byte image. The two functions
// that DO render images refuse `vcString` outright (lowerglobal.bit's
// moduleGlobalImage and constArrayImage), and a module-level `let` never reaches
// the fold at all because §11.11's untraced-type rule rejects a string first.
//
// Concatenating another CONST rather than only literals is deliberate: the
// operand then arrives through the folder's Ident arm, which is a different path
// from a bare StringLit and is the shape a real program writes (a URL built from
// a scheme const, a banner built from a version const).
//
// Single-file golden, so there is NO prelude: `print` takes a string.

const LIT: string = "x" + "y"
const SCHEME: string = "https://"
const HOST = "bitlang.org"
const URL = SCHEME + HOST
const THREE: string = "a" + "b" + "c"
// Unannotated, so the fold must carry the kind through with no target type to
// lean on.
const BARE = "p" + "q"

fn main() {
  print(LIT)
  print("\n")
  print(URL)
  print("\n")
  print(THREE)
  print("\n")
  print(BARE)
  print("\n")
}
