// run
// A named top-level function used as a first-class value: passed as an argument,
// applied twice, and bound to a variable then called through it.
function inc(n: int): int {
  return n + 1
}

function apply(f: (int) => int, x: int): int {
  return f(x)
}

function twice(f: (int) => int, x: int): int {
  return f(f(x))
}

function main() {
  let g = inc
  print("${apply(inc, 5)} ${twice(inc, 5)} ${g(100)}\n")
}
