// run
// #2426: block-local store-to-load forwarding replaces a `field_get` with the
// value a `field_set` just put in that slot. Every function here is either a
// case the pass must REFUSE, or one where forwarding has to produce the same
// answer the reload did.
//
// This is a `// run` case and not an `// ir` one on purpose. An IR golden pins
// the shape the optimizer happens to have today and goes stale the moment a
// later pass improves it; a wrong invalidation rule here is a silent
// miscompile, and the answer it corrupts cannot go stale.
//
// Aliasing is the hazard the pass has no analysis for, so `twoRefs` and
// `twoObjects` are the load-bearing ones: two distinct SSA values may or may
// not be the same object, so the table holds entries for ONE base at a time
// and any store through another base clears it.
class Cell {
  a: int,
  b: int,
}

// Multi-block on purpose: a single-block body would be inlined into its caller
// and the call barrier below would stop being a call at all.
fn bump(c: Cell) {
  let i = 0
  while (i < 1) {
    c.a = c.a + 100
    i = i + 1
  }
}

// Two names for ONE object. `y.a = 9` overwrites what `x.a = 7` stored, so both
// reads must see 9 — 18, never 16.
fn twoRefs(): int {
  let x = Cell{ a: 1, b: 2 }
  let y = x
  x.a = 7
  y.a = 9
  return x.a + y.a
}

// A call between the store and the reload can write anything it can reach, so
// the reload must survive it. 105, never 5.
fn acrossCall(): int {
  let c = Cell{ a: 1, b: 2 }
  c.a = 5
  bump(c)
  return c.a
}

// Nothing here is a call, and the refusal is structural instead: a slice index
// carries a bounds check, and that branch splits the block between the store
// and the read. This pass is block-local by construction, so a store that no
// longer shares a block with its reader is not available. 14, never 6.
fn acrossBlockSplit(): int {
  let c = Cell{ a: 1, b: 2 }
  let xs = []int(3)
  c.a = 5
  xs[0] = 9
  return c.a + xs[0]
}

// Two DIFFERENT objects: a store through one must not answer a read of the
// other. 1020, never 2020 or 1010.
fn twoObjects(): int {
  let p = Cell{ a: 1, b: 2 }
  let q = Cell{ a: 3, b: 4 }
  p.a = 10
  q.a = 20
  return p.a * 100 + q.a
}

// Two offsets of the SAME base are different slots, so both reads forward and
// both must still be right. 1122.
fn twoFields(): int {
  let c = Cell{ a: 0, b: 0 }
  c.a = 11
  c.b = 22
  return c.a * 100 + c.b
}

// Store, read, store, read on one slot: the second read must see the SECOND
// store. 34, never 33 or 44.
fn sameSlot(): int {
  let c = Cell{ a: 0, b: 0 }
  c.a = 3
  let first = c.a
  c.a = 4
  let second = c.a
  return first * 10 + second
}

// A loop back edge carries the store, so the read after it must see the last
// iteration's write and not the entry value. 11, never 1.
fn loopStore(): int {
  let c = Cell{ a: 1, b: 0 }
  let i = 0
  while (i < 5) {
    c.a = c.a + i
    i = i + 1
  }
  return c.a
}

fn main() {
  print("${twoRefs()} ${acrossCall()} ${acrossBlockSplit()}\n")
  print("${twoObjects()} ${twoFields()} ${sameSlot()} ${loopStore()}\n")
}
