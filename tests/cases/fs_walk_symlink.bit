// run
// #2152: `fs.walk` must not follow symbolic links.
//
// Following them was a data-escape, not an untidiness: against a tree holding
// ONE real file plus two links, `walk` returned 33 paths, 15 of which named a
// file OUTSIDE the walk root. Anything built on `walk` — a backup tool, a doc
// generator, a static server — could therefore be induced to read files its
// user never granted, and one `ln -s . loop` in a user-writable directory was
// a denial of service on top.
//
// The fixed contract, which is Go's `filepath.WalkDir` ("WalkDir does not
// follow symbolic links") and the default of Rust's `walkdir`
// (`follow_links(false)`): a link is REPORTED as a leaf path, whatever it
// points at, and never descended.
//
// The two assertions that matter are structural, not counted. A path
// containing `self-loop/` or `link-to-dir/` can only exist if the walk stepped
// THROUGH a link, and a path naming `private.txt` can only exist if it left
// the root. Both must be zero. Termination is asserted by this program
// finishing at all — and by finishing without `walk` failing, so it is not
// `maxWalkDepth` firing, and with paths this short, so it is not PATH_MAX
// truncating the recursion into silence the way it used to.
import { envOr } from "std/os"
import { isDir, isSymlink, mkdir, remove, walk, writeFile } from "std/fs"
import { contains } from "std/strings"

// Creating a symbolic link is not something Bit can express — `std/fs` has no
// `symlink`, and a link cannot be committed to the repo as a plain file — so
// the two fixtures come from a shell script run with `osRun`, the shape
// `compiler/pmfetch.bit` and `tests/imports/pmadd_e2e` already use for this.
fn makeLinks(dir: string): bool {
  let script = "${dir}/setup.sh"
  let body = "#!/bin/sh\n" +
    "ln -s '${dir}/outside' '${dir}/src/link-to-dir' || exit 1\n" +
    "ln -s '${dir}/src' '${dir}/src/self-loop' || exit 1\n"
  writeFile(script, body) catch _ {
    return false
  }
  if (fsChmod(script, 448) != 0) { // 0o700: owner rwx only
    return false
  }
  return osRun(script) == 0
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_walk_symlink_${timeUnixNs()}"
  let root = "${dir}/src"
  let outsideDir = "${dir}/outside"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }
  mkdir(root) catch _ {
    println("setup failed: cannot create ${root}")
    return
  }
  mkdir(outsideDir) catch _ {
    println("setup failed: cannot create ${outsideDir}")
    return
  }
  writeFile("${outsideDir}/private.txt", "DATA OUTSIDE THE WALK ROOT\n") catch _ {
    println("setup failed: cannot write private.txt")
    return
  }
  writeFile("${root}/normal.txt", "the only real file\n") catch _ {
    println("setup failed: cannot write normal.txt")
    return
  }
  if (!makeLinks(dir)) {
    println("setup failed: cannot create the symlinks")
    return
  }

  let paths = walk(root) catch e {
    println("walk failed: ${e.message()}")
    return
  }
  let descended = 0
  let outside = 0
  for p of paths {
    if (contains(p, "self-loop/") || contains(p, "link-to-dir/")) {
      descended = descended + 1
    }
    if (contains(p, "private.txt")) {
      outside = outside + 1
    }
  }
  println("walk paths: ${len(paths)}")
  println("descended through a link: ${descended}")
  println("paths naming data outside the root: ${outside}")

  // The links are REPORTED, not dropped: a walk that pretended they did not
  // exist would be its own surprise, and a caller can now tell which is which.
  println("reported: link-to-dir=${reported(paths, "link-to-dir")} self-loop=${reported(paths, "self-loop")} normal.txt=${reported(paths, "normal.txt")}")
  println("isSymlink: link-to-dir=${isSymlink("${root}/link-to-dir")} self-loop=${isSymlink("${root}/self-loop")} normal.txt=${isSymlink("${root}/normal.txt")}")

  // `isDir` is unchanged and still FOLLOWS a link, as `stat(2)` does: the fix
  // is in `walk`'s decision, not in what `isDir` means. Pinned here so a later
  // change to `isDir` cannot pass for a fix to this.
  println("isDir: root=${isDir(root)} link-to-dir=${isDir("${root}/link-to-dir")} self-loop=${isDir("${root}/self-loop")}")

  // `remove` unlinks the LINK, never the directory behind it — so `outside`
  // survives to be removed on its own, and a failure to clean up would show as
  // a leftover, never as a deleted target.
  remove("${root}/link-to-dir") catch _ { return }
  remove("${root}/self-loop") catch _ { return }
  remove("${root}/normal.txt") catch _ { return }
  remove(root) catch _ { return }
  remove("${outsideDir}/private.txt") catch _ { return }
  remove(outsideDir) catch _ { return }
  remove("${dir}/setup.sh") catch _ { return }
  remove(dir) catch _ { return }
}

// Whether `walk` yielded an entry named `name` directly under some directory.
fn reported(paths: []string, name: string): bool {
  for p of paths {
    if (contains(p, "/${name}")) {
      return true
    }
  }
  return false
}
