// run
// #2128: a boxed local threads through control-flow joins. Its env slot holds a
// CELL POINTER, so every block param carrying it across a loop header or an
// if/else join has to be typed as the cell — typed as `int`/`bool` instead, the
// live cell would be missing from the stack maps.
function main() {
  let n = 0
  let flag = false
  let bump = () => { n = n + 1 }
  let i = 0
  while (i < 5) {
    if (i % 2 == 0) {
      bump()
    } else {
      n = n + 10
    }
    i = i + 1
  }
  if (n > 20) {
    flag = true
  }
  let see = () => {
    if (flag) {
      return n
    }
    return 0 - n
  }
  print("n=${n} see=${see()}\n")
}
