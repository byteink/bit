// run
// #2273, the ACCEPT half: the neighbours on the legal side of both boundaries
// still lex and still carry their full UTF-8 encoding. D7FF is one below the
// surrogate block and E000 one above it (both 3 bytes); 10FFFF is the maximum
// scalar value (4 bytes). With the brackets that is 5, 5 and 6 bytes.
//
// This half stays in tests/cases/ on purpose: every released compiler agrees
// with it, so it costs the self-host differential nothing. The REJECT half is
// tests/bit/checkercases/check_unicode_escape_range.bit, which cannot live here
// — no released compiler emits those diagnostics, so a golden would score
// FALSEPOS in selfhost-diffcheck.sh.
//
// The lengths are bound to locals first: a nested string literal inside an
// interpolation is not a shape the lexer accepts.
//
// Single-file golden: no prelude.
fn main() {
  let below = "[\u{D7FF}]"
  let above = "[\u{E000}]"
  let max = "[\u{10FFFF}]"
  let a = len(below)
  let b = len(above)
  let c = len(max)
  print("${a} ${b} ${c}\n")
}
