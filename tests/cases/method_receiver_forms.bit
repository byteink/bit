// run
// #2239: negative control for #2238's new checker rejection (a method
// receiver must be a struct or a type-alias declared in the same module,
// SPEC §10.4). #2736 rejects an enum receiver and #2738 rejects a
// type-alias-to-enum receiver, but neither touches the two forms the spec
// keeps legal. Pins both: a direct struct receiver and a type-alias-to-struct
// receiver still typecheck, lower and run.
struct Cart {
  n: int
}

fn (c: Cart) size(): int {
  return c.n
}

type Basket = Cart

fn (b: Basket) doubled(): int {
  return b.n * 2
}

fn main() {
  let c = Cart{ n: 3 }
  print("${c.size()}\n")

  let b: Basket = Cart{ n: 5 }
  print("${b.doubled()}\n")
}
