// run
// The no-false-positive half of #2148: the per-monomorphization E0052 must stay
// SILENT for every instantiation whose key type IS comparable. A rigid `T` is
// comparable by THE SAFETY RULE, so the rule may only speak once substitution
// has produced a concrete, non-comparable type.
enum Color { Red, Green }

function dedupe<T>(xs: []T): int {
  let seen = map<T, bool>()
  for x of xs {
    seen[x] = true
  }
  return len(seen)
}

// A map whose key is a COMPOSITE over the type parameter: `[2]T` is comparable
// exactly when T is, so this must follow the element and stay silent at int.
function tally<T>(a: T, b: T): int {
  let m = map<[2]T, int>()
  m[[2]T{ a, b }] = 1
  return len(m)
}

function main() {
  print("int=${dedupe([1, 1, 2])}\n")
  let s: []string = ["a", "a", "b"]
  print("str=${dedupe(s)}\n")
  let e: []Color = [Color.Red, Color.Red, Color.Green]
  print("enum=${dedupe(e)}\n")
  print("arr=${tally(1, 2)}\n")
}
