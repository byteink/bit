// A SECOND freestanding runtime module, existing to prove the one thing a
// single module cannot: that §17.6 module-scoped emission actually partitions a
// multi-module project into per-module objects (#1400).
//
// It is deliberately not a toy. `guardBump`/`guardRead` are the shape every
// runtime table has — a lock word and a value beside it, mutated under the lock
// — which is exactly what the allocator's free lists and the scheduler's run
// queue will need from #1362 onward. Written against `runtime/spinlock.bit`
// rather than a copy of it, so this file exercises the real cross-module path.
//
// WHAT THIS FIXTURE PROVES, and why each piece is load-bearing:
//
//   (a) It IMPORTS another module, so `lowerProject` lowers spinlock's three
//       functions into the same `ir.Module` as these two. Emitted freestanding,
//       this object must contain ONLY `bit_rt_guard_*` — spinlock's functions
//       belong to spinlock's own object. Without the module filter they land in
//       both, and archiving the two is an immediate DuplicateSymbol.
//
//   (b) It CALLS across that boundary, so the object carries a real undefined
//       relocation the linker must satisfy from the sibling member. A fixture
//       that only imported without calling would link even if the filter were
//       broken, because dead-strip would quietly drop the duplicate.
//
//   (c) Both sides are pinned with §11.9 `@symbol`. This is not decoration: a
//       module's symbols are prefixed `m<id>$` where `<id>` is an ordinal the
//       IMPORTING build assigns, so spinlock-as-root spells its function one
//       way and guard's build spells the reference another. Two separately
//       emitted objects therefore cannot link by ordinary names at all. The pin
//       is the fixed point, and every runtime module that another one calls
//       needs it.
//
// Every function is `@nosplit` for the reason spinlock's are (§10.3): a
// freestanding object carries no `bit_stack_maps`, so code that could reach a
// safepoint is refused rather than emitted with no way for the collector to
// scan its frame.
import { spinAcquire, spinRelease } from "../../../runtime"

// Increment the counter at `cell` under the lock at `lock`, returning the new
// value. The read-modify-write inside the critical section is deliberately
// PLAIN, not atomic: an atomic RMW would give the right answer even with no
// lock at all, so only a non-atomic one can distinguish a working lock from one
// that excludes nothing.
export @nosplit @symbol("bit_rt_guard_bump")
function guardBump(lock: *i32, cell: *i32): i32 {
  spinAcquire(lock)
  let next = atomicLoad(cell) + 1
  atomicStore(cell, next)
  spinRelease(lock)
  return next
}

// The current counter value, read without the lock. A single atomic load needs
// no mutual exclusion, and having a second exported function keeps the symbol
// table's evidence unambiguous: an object holding exactly this module's two
// names cannot be mistaken for one that happened to drop everything.
export @nosplit @symbol("bit_rt_guard_read")
function guardRead(cell: *i32): i32 {
  return atomicLoad(cell)
}
