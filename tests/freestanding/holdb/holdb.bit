// The INNER of two freestanding members whose FRAMES sit between the collection
// and the roots (ABI.md §4). See `holda` for what the pair proves.
//
// Nothing here holds a reference: a pinned symbol is a C-ABI boundary (§11.9,
// E0079) so only scalars cross it, and a freestanding member cannot allocate.
// The frame is the point. The collector's walk climbs frame by frame and STOPS
// at the first `pc` it finds no entry for, so if this member's entries are
// missing from the merged table, everything ABOVE this frame — including the
// caller's live roots — is never marked.
extern fn bit_rt_mm_churn(rounds: int): int

export @symbol("bit_rt_mm_hold_b") fn holdB(rounds: int): int {
  return bit_rt_mm_churn(rounds) + 1
}
