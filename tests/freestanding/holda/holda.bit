// The OUTER of two freestanding members whose frames sit between a collection
// and the roots that must survive it.
//
// WHAT THIS PAIR PROVES, AND WHY ONE MEMBER CANNOT. The GC stack-map table is
// now per-member and merged by the linker (ABI.md §4.1). A merged table carries
// no count and no terminator — only the linker-defined
// `bit_stack_maps`..`bit_stack_maps_end` extent bounds it — so a broken merge
// fails by having the walk stop after the FIRST contributing object's entries.
// Against a single contributor that is indistinguishable from a working merge.
//
// Here the stack at collection time is:
//
//   main (holds live heap objects in locals)   <- entries from the PROGRAM object
//     holdA                                    <- entries from THIS member
//       holdB                                  <- entries from the OTHER member
//         churn -> allocates -> collects
//
// `scanFrame` returns false the moment `pc` lands in a function the table does
// not describe, which ends the walk. So if either member's entries are absent
// or unreachable, the climb halts below `main` and `main`'s roots are swept
// while still live — and `main`'s own arithmetic over them is the assertion.
// Three separate objects must contribute to one table for this to pass.
extern function bit_rt_mm_hold_b(rounds: int): int

export @symbol("bit_rt_mm_hold_a") function holdA(rounds: int): int {
  return bit_rt_mm_hold_b(rounds) + 1
}
