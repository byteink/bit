// Fixture for tests/testcmd.zig: a directory module whose tests import
// std/testing. Two pass, one fails with a rendered value diff.
import { ok, notOk, eq, neq, near, eqSlice, failNow } from "std/testing"
import { gcd, ipow } from "std/math"

function test_scalars() {
  eq<i64>(1 + 1, 2, "sum")
  eq<string>("ab" + "c", "abc", "concat")
  eq<bool>(1 < 2, true, "less")
  neq<i64>(gcd(48, 18), 5, "gcd is not 5")
  ok(ipow(3, 5) == 243, "ipow")
  notOk(ipow(2, 3) == 9, "ipow not 9")
}

function test_floats_and_slices() {
  near(0.1 + 0.2, 0.3, 0.000001, "float add")
  eqSlice<i64>([1, 2, 3], [1, 2, 3], "slice")
}

function test_fails_with_a_diff() {
  eq<i64>(6, 7, "sum")
}

function test_fails_explicitly() {
  failNow("nope")
}
