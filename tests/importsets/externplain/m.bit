// The control: an extern whose name collides with nothing predeclared. Both
// compilers have always agreed here, which is exactly why it belongs in the
// set — if this fixture ever diverges the cause is the extern path itself and
// not builtin shadowing, and the two fixtures together say which.
extern fn getpid(): i32

fn main() {
  let r = int(getpid())
  print("ok=${r > 0}\n")
}
