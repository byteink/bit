// #1436: `close` is also a predeclared builtin (`close(chan)`, SPEC §16.2).
// A user `extern function close` must win over the builtin — the seed resolves
// the callee through the symbol table and does, so it emits an `_close` import.
// Self-hosted lowering dispatched on the callee's SOURCE TEXT, so it emitted
// `bit_rt_chan_close` instead and the `_close` import vanished: a clean build
// that dereferenced -1 as a channel at runtime.
extern fn close(fd: i32): i32

fn main() {
  let r = int(close(-1))
  print("close=${r}\n")
}
