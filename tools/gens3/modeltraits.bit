// tools/gens3 — member and shape trait readers for model.bit (#6604).
//
// Each `member*Trait` / `shape*Trait` takes one trait (key, value) and returns
// whether it handled it; the caller tries each group and, if none did, fails
// naming the trait and the shape. `what` is "<shape id>.<member>: trait <key>".

const traitHttpHeader: string = "smithy.api#httpHeader"
const traitHttpQuery: string = "smithy.api#httpQuery"
const traitPrefixHeaders: string = "smithy.api#httpPrefixHeaders"
const traitXmlName: string = "smithy.api#xmlName"
const traitXmlNamespace: string = "smithy.api#xmlNamespace"
const traitTimestampFormat: string = "smithy.api#timestampFormat"
const unknownTraitHint: string = "unknown trait, the generator does not read it (teach tools/gens3/modeltraits.bit or list it in isUnreadShapeTrait)"

// Parsed `smithy.api#xmlNamespace`: {"uri": ..., "prefix": ...}, prefix optional.
class XmlNs { uri: string, prefix: string }

fn readXmlNs(v: Json, what: string): XmlNs! {
  let entries = needObject(v, what)?
  onlyKeys(entries, ["uri", "prefix"], what)?
  let uri = needNonEmpty(needKey(v, "uri", what)?, what)?
  let prefix = ""
  if (hasKey(v, "prefix")) {
    prefix = needNonEmpty(optKey(v, "prefix"), what)?
  }
  return XmlNs{ uri = uri, prefix = prefix }
}

fn readTimestampFormat(v: Json, what: string): string! {
  let f = needString(v, what)?
  if (f != "date-time" && f != "epoch-seconds" && f != "http-date") {
    fail newError("${what}: unknown timestamp format \"${f}\"")
  }
  return f
}

fn readContextParam(v: Json, what: string): string! {
  onlyKeys(needObject(v, what)?, ["name"], what)?
  return needNonEmpty(needKey(v, "name", what)?, what)?
}

// httpHeader, httpQuery and httpPrefixHeaders: one non-empty name each.
fn memberWireNameTrait(m: Member, key: string, v: Json, what: string): bool! {
  if (key == traitHttpHeader) {
    m.header = needNonEmpty(v, what)?
    return true
  }
  if (key == traitHttpQuery) {
    m.query = needNonEmpty(v, what)?
    return true
  }
  if (key == traitPrefixHeaders) {
    m.prefixHeaders = needNonEmpty(v, what)?
    return true
  }
  return false
}

// The marker traits that say where a member travels.
fn memberWireFlagTrait(m: Member, key: string, v: Json, what: string): bool! {
  if (key == "smithy.api#httpLabel") {
    needMarker(v, what)?
    m.label = true
    return true
  }
  if (key == "smithy.api#httpPayload") {
    needMarker(v, what)?
    m.payload = true
    return true
  }
  if (key == "smithy.api#httpQueryParams") {
    needMarker(v, what)?
    m.queryParams = true
    return true
  }
  if (key == "smithy.api#httpResponseCode") {
    needMarker(v, what)?
    m.responseCode = true
    return true
  }
  return false
}

// Host label and event-stream payload markers (WriteGetObjectResponse's
// RequestRoute, SelectObjectContent's frames).
fn memberStreamFlagTrait(m: Member, key: string, v: Json, what: string): bool! {
  if (key == "smithy.api#hostLabel") {
    needMarker(v, what)?
    m.hostLabel = true
    return true
  }
  if (key == "smithy.api#eventPayload") {
    needMarker(v, what)?
    m.eventPayload = true
    return true
  }
  return false
}

fn memberXmlTrait(m: Member, key: string, v: Json, what: string): bool! {
  if (key == traitXmlName) {
    m.xmlName = needNonEmpty(v, what)?
    return true
  }
  if (key == "smithy.api#xmlFlattened") {
    needMarker(v, what)?
    m.xmlFlattened = true
    return true
  }
  if (key == "smithy.api#xmlAttribute") {
    needMarker(v, what)?
    m.xmlAttribute = true
    return true
  }
  if (key == traitXmlNamespace) {
    let ns = readXmlNs(v, what)?
    m.xmlNsUri = ns.uri
    m.xmlNsPrefix = ns.prefix
    return true
  }
  return false
}

fn memberCoreTrait(m: Member, key: string, v: Json, what: string): bool! {
  if (key == "smithy.api#required") {
    needMarker(v, what)?
    m.required = true
    return true
  }
  if (key == "smithy.api#default") {
    m.hasDefault = true
    m.defaultText = jsonEncode(v)
    return true
  }
  if (key == "smithy.api#idempotencyToken") {
    needMarker(v, what)?
    m.idempotencyToken = true
    return true
  }
  if (key == "smithy.api#deprecated") {
    needMarker(v, what)?
    m.deprecated = true
    return true
  }
  return false
}

fn memberValueTrait(m: Member, key: string, v: Json, what: string): bool! {
  if (key == traitTimestampFormat) {
    m.timestampFormat = readTimestampFormat(v, what)?
    return true
  }
  if (key == "smithy.rules#contextParam") {
    m.contextParam = readContextParam(v, what)?
    return true
  }
  if (key == "smithy.api#enumValue") {
    m.enumValue = needNonEmpty(v, what)?
    return true
  }
  return false
}

// Apply one member trait, or fail: a member trait outside the groups above is
// a trait the generator was never taught.
fn applyMemberTrait(m: Member, key: string, v: Json, what: string): ()! {
  if (memberWireNameTrait(m, key, v, what)?) {
    return
  }
  if (memberWireFlagTrait(m, key, v, what)?) {
    return
  }
  if (memberStreamFlagTrait(m, key, v, what)?) {
    return
  }
  if (memberXmlTrait(m, key, v, what)?) {
    return
  }
  if (memberCoreTrait(m, key, v, what)?) {
    return
  }
  if (memberValueTrait(m, key, v, what)?) {
    return
  }
  fail newError("${what}: ${unknownTraitHint}")
}

// How many wire locations the member claims; Smithy allows one.
fn locationCount(m: Member): int {
  let n = 0
  if (m.header != "") {
    n = n + 1
  }
  if (m.query != "") {
    n = n + 1
  }
  if (m.prefixHeaders != "") {
    n = n + 1
  }
  if (m.label) {
    n = n + 1
  }
  if (m.payload) {
    n = n + 1
  }
  if (m.queryParams) {
    n = n + 1
  }
  if (m.responseCode) {
    n = n + 1
  }
  return n
}

// Traits on shapes that the generator does not read, each with why. Everything
// else not read at shape level is an error, so a new one cannot slip by.
fn unreadShapeTraits(): []string {
  return [
    // Operation input/output markers: the operation names them already.
    "smithy.api#input",
    "smithy.api#output",
    // Client-side validation constraints: the SDK sends the value and lets S3
    // answer, so the generated types carry no range or pattern.
    "smithy.api#length",
    "smithy.api#pattern",
    "smithy.api#range",
    // Service-level facts the endpoint and signing stages take from their own
    // pinned inputs, or that name no behaviour.
    "smithy.api#suppress",
    "smithy.api#title",
    "aws.api#service",
    "aws.auth#sigv4",
    "aws.protocols#restXml",
    "smithy.rules#clientContextParams",
  ]
}

fn isUnreadShapeTrait(key: string): bool {
  for k of unreadShapeTraits() {
    if (k == key) {
      return true
    }
  }
  return false
}

fn shapeXmlTrait(s: Shape, key: string, v: Json, what: string): bool! {
  if (key == traitXmlName) {
    s.xmlName = needNonEmpty(v, what)?
    return true
  }
  if (key == traitXmlNamespace) {
    let ns = readXmlNs(v, what)?
    s.xmlNsUri = ns.uri
    s.xmlNsPrefix = ns.prefix
    return true
  }
  return false
}

fn shapeErrorTrait(s: Shape, key: string, v: Json, what: string): bool! {
  if (key == "smithy.api#error") {
    let k = needString(v, what)?
    if (k != "client" && k != "server") {
      fail newError("${what}: error kind must be client or server, got \"${k}\"")
    }
    s.errorKind = k
    return true
  }
  if (key == "smithy.api#httpError") {
    let code = needInt(v, what)?
    if (code < 100 || code > 599) {
      fail newError("${what}: HTTP status ${code} out of range")
    }
    s.httpError = code
    return true
  }
  return false
}

fn shapeValueTrait(s: Shape, key: string, v: Json, what: string): bool! {
  if (key == "smithy.api#streaming") {
    needMarker(v, what)?
    s.streaming = true
    return true
  }
  if (key == "smithy.api#sensitive") {
    needMarker(v, what)?
    s.sensitive = true
    return true
  }
  if (key == traitTimestampFormat) {
    s.timestampFormat = readTimestampFormat(v, what)?
    return true
  }
  return false
}

fn applyShapeTrait(s: Shape, key: string, v: Json, what: string): ()! {
  if (shapeXmlTrait(s, key, v, what)?) {
    return
  }
  if (shapeErrorTrait(s, key, v, what)?) {
    return
  }
  if (shapeValueTrait(s, key, v, what)?) {
    return
  }
  if (isUnreadShapeTrait(key)) {
    return
  }
  fail newError("${what}: ${unknownTraitHint}")
}
