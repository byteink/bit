// tools/gens3/emitxmlser.test.bit — #6621. The XML request body emitter against
// the vendored model: every input whose body is XML has its serializer ("35 of
// 35"), every enum a body writes has its wire writer, files stay under the
// 800-line ceiling, two renders are byte-identical, and the checked-in
// gen_xmlser_*.bit and gen_xmlservec_*.test.bit are what the generator renders
// now (the freshness check). Then the spellings the design fixes (the root, a
// namespace, wrapped and flattened lists, maps, attributes, unions) and the
// failure paths on small fixtures. The behaviour of the emitted code is
// pkg/s3/xmlser.test.bit and the restXml body request vectors in
// pkg/s3/gen_xmlservec_*.test.bit.
//
// Run from the repo root: bit test tools/gens3

fn renderedSer(m: Model): []GenFile {
  return renderXmlSer(m, testCommit, testSha) catch e {
    panic("renderXmlSer: ${e.message()}")
  }
}

fn expectSerError(m: Model, want: string) {
  let _ = renderXmlSer(m, testCommit, testSha) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("renderXmlSer accepted the model, want an error containing ${want}")
}

test "every input whose body is XML has its serializer: N of N" {
  let m = loadedModel()
  let xmlInputs = textCount(allText(renderedReq(m)), "\n// body: xml")
  let text = allText(renderedSer(m))
  let built = textCount(text, "\nfn serialize")
  assert(built == xmlInputs, "serializers: ${built} of ${xmlInputs} xml inputs")
  assert(built == 35, "xml inputs: ${built} of 35")
  let writers = textCount(text, "\nfn xmlPut")
  println("xml request emitter: ${built} of ${xmlInputs} body serializers, ${writers} shape writers")
}

test "every enum an XML body writes has its wire writer in gen_req_enums" {
  let m = loadedModel()
  let p = planShapes(m) catch e {
    panic("planShapes: ${e.message()}")
  }
  let inBody = xmlBodyEnums(p) catch e {
    panic("xmlBodyEnums: ${e.message()}")
  }
  let text = allText(renderedReq(m))
  let wanted = 0
  let i = 0
  while (i < len(m.shapes)) {
    if (inBody[i]) {
      wanted = wanted + 1
      assert(
        contains(text, "\nfn wire${shortName(m.shapes[i].id)}("),
        "no wire writer for ${m.shapes[i].id}",
      )
    }
    i = i + 1
  }
  assert(wanted == 54, "enums an XML body writes: ${wanted} of 54")
  assert(!contains(text, "\nfn wireArchiveStatus("), "an enum only an output carries has no writer")
}

test "xmlser files are numbered from 01, under 800 lines, headed with the pin" {
  let files = renderedSer(loadedModel())
  assert(len(files) > 0, "no files")
  for f of files {
    assert(hasPrefix(f.name, "gen_xmlser_0"), "name ${f.name}")
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    assert(
      contains(f.text, "bit run tools/gens3 -- xmlser\n"),
      "${f.name} names no regenerate command",
    )
    assert(contains(f.text, "api-models-aws at commit ${testCommit}"), "${f.name} names no commit")
    assert(
      contains(f.text, "\nimport { Attr, Writer } from \"std/xml\"\n"),
      "${f.name} does not import the Writer",
    )
  }
}

test "two xmlser renders are byte-identical" {
  let m = loadedModel()
  let a = renderedSer(m)
  let b = renderedSer(m)
  assert(len(a) == len(b), "file counts differ")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == b[i].name && a[i].text == b[i].text, "${a[i].name} differs between renders")
    i = i + 1
  }
}

test "the checked-in gen_xmlser files are what the generator renders now" {
  let m = loadedModel()
  let files = renderedSer(m)
  for f of files {
    assert(
      diskText(f.name) == f.text,
      "${f.name} is stale, regenerate with: bit run tools/gens3 -- xmlser",
    )
  }
  assert(
    filesWith("gen_xmlser_") == len(files),
    "pkg/s3 holds ${filesWith("gen_xmlser_")} gen_xmlser files, the generator renders ${len(files)}",
  )
}

const serVecFile: string = "tools/gens3/model/restxml-xmlser-vectors.json"

fn serVectorText(): string {
  return readFile(serVecFile) catch e {
    panic("read ${serVecFile}: ${e.message()}")
  }
}

fn renderedSerVectors(): []GenFile {
  return renderXmlSerVectors(serVectorText(), testCommit, testSha) catch e {
    panic("renderXmlSerVectors: ${e.message()}")
  }
}

test "restXml body request vectors: the filter keeps 41 of 50 request tests, every other is excluded with a reason" {
  let root = jsonParse(serVectorText()) catch e {
    panic("parse ${serVecFile}: ${e.message()}")
  }
  let cases = arrayLen(root, "cases")
  let excluded = arrayLen(root, "excluded")
  let total = needInt(
    needKey(root, "total", "vectors") catch e {
      panic(e.message())
    },
    "total",
  ) catch e {
    panic(e.message())
  }
  assert(total == 50, "request tests in the restXml body files: ${total} of 50")
  assert(cases == 41, "applicable: ${cases} of 41")
  assert(cases + excluded == total, "applicable ${cases} + excluded ${excluded} != ${total}")
  assert(
    contains(serVectorText(), vectorCommit),
    "the vectors do not name the pinned smithy commit",
  )
  let filter = needString(
    needKey(root, "filter", "vectors") catch e {
      panic(e.message())
    },
    "filter",
  ) catch e {
    panic(e.message())
  }
  println("restXml body request vectors at smithy ${vectorCommit}: ${cases} of ${total} apply, ${excluded} excluded")
  println("filter: ${filter}")
}

test "every excluded body request test names its reason" {
  let root = jsonParse(serVectorText()) catch e {
    panic("parse ${serVecFile}: ${e.message()}")
  }
  for e of needArray(
    needKey(root, "excluded", "vectors") catch err {
      panic(err.message())
    },
    "excluded",
  ) catch err {
    panic(err.message())
  } {
    let reason = needString(
      needKey(e, "reason", "excluded") catch err {
        panic(err.message())
      },
      "reason",
    ) catch err {
      panic(err.message())
    }
    assert(len(reason) > 20, "an excluded test has no reason: ${reason}")
  }
}

test "every body request vector becomes one generated test: N of N, each file under 800 lines" {
  let files = renderedSerVectors()
  let tests = 0
  for f of files {
    assert(hasSuffix(f.name, ".test.bit"), "${f.name} is not a test file")
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    tests = tests + textCount(f.text, "\ntest \"restXml body request vector ")
  }
  assert(tests == 41, "tests: ${tests} of 41")
  let text = allText(files)
  assert(contains(text, "restXml body request vector 1 of 41: "), "first vector")
  assert(contains(text, "restXml body request vector 41 of 41: "), "last vector")
}

test "the checked-in gen_xmlservec files are what the generator renders now" {
  let files = renderedSerVectors()
  for f of files {
    assert(
      diskText(f.name) == f.text,
      "${f.name} is stale, regenerate with: bit run tools/gens3 -- xmlservec",
    )
  }
  assert(
    filesWith("gen_xmlservec_") == len(files),
    "pkg/s3 holds ${filesWith("gen_xmlservec_")} gen_xmlservec files, the generator renders ${len(files)}",
  )
}

test "spellings: the root and its namespace, wrapped and flattened lists, attributes, unions, required members" {
  let text = allText(renderedSer(loadedModel()))
  assert(
    contains(
      text,
      "  xmlPutDelete(w, \"Delete\", xmlNs(\"\", \"http://s3.amazonaws.com/doc/2006-03-01/\"), input.delete)?\n",
    ),
    "root with the service namespace",
  )
  assert(
    contains(
      text,
      "    xmlTag(\"AccessControlList\", xmlNoAttrs()),\n    xmlTag(\"Grant\", xmlNoAttrs()),\n    v.grants,\n    xmlPutGrant,\n",
    ),
    "wrapped list named by xmlName, items named by the list member",
  )
  assert(
    contains(text, "  xmlPutFlat(w, \"Tag\", xmlNoAttrs(), v.tags, xmlPutTag)?\n"),
    "flattened list",
  )
  assert(
    contains(
      text,
      "  at = xmlAttrPutEnum(at, \"xsi:type\", v.type_, wireType)\n  w.start(name, at)?\n",
    ),
    "the attribute is added before the start tag",
  )
  assert(
    contains(
      text,
      "    xmlNs(\"xsi\", \"http://www.w3.org/2001/XMLSchema-instance\"),\n    v.grantee,\n",
    ),
    "xmlns:xsi declared on the Grantee element",
  )
  assert(
    contains(text, "    Prefix(x) => { xmlPutStr(w, \"Prefix\", xmlNoAttrs(), x)? }\n"),
    "union arm",
  )
  assert(
    contains(text, "    Unknown(m) => { xmlUnknownMember(\"AnalyticsFilter\", m)? }\n"),
    "union Unknown",
  )
  assert(
    contains(text, "  xmlPutStr(w, \"Id\", xmlNoAttrs(), v.id)?\n"),
    "a required string is written",
  )
  assert(
    contains(text, "    Option.Some(v.tagSet),\n    xmlPutTag,\n  )?\n"),
    "a required list is written as a set one",
  )
  assert(
    contains(text, "\"SelectObjectContentRequest\",\n"),
    "an input with no payload is written under its own name",
  )
}

// A model whose one input has the members `members`, none bound to HTTP, and the
// further shapes `extra`.
fn serMini(members: string, extra: string): Model {
  return reqMini(members, extra, "/x")
}

test "a flattened map, a wrapped map, an epoch timestamp and a blob are written through the runtime helpers" {
  let m = serMini(
      "\"F\":{\"target\":\"a#M\",\"traits\":{\"smithy.api#xmlFlattened\":{},\"smithy.api#xmlName\":\"KVP\"}}," +
      "\"W\":{\"target\":\"a#M\"},\"E\":{\"target\":\"a#Ep\"},\"B\":{\"target\":\"a#B\"}",
      ",\"a#M\":{\"type\":\"map\",\"key\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#xmlName\":\"K\"}},\"value\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#xmlName\":\"V\"}}}," +
      "\"a#Ep\":{\"type\":\"timestamp\",\"traits\":{\"smithy.api#timestampFormat\":\"epoch-seconds\"}}," +
      "\"a#B\":{\"type\":\"blob\"}",
  )
  let text = allText(renderedSer(m))
  assert(
    contains(
      text,
      "  let fNames = xmlMapNames(\n    xmlTag(\"entry\", xmlNoAttrs()),\n    xmlTag(\"K\", xmlNoAttrs()),\n    xmlTag(\"V\", xmlNoAttrs()),\n  )\n",
    ),
    "map names",
  )
  assert(
    contains(text, "  xmlPutFlatMap(w, xmlTag(\"KVP\", xmlNoAttrs()), fNames, v.f, xmlPutStr)?\n"),
    "flattened map",
  )
  assert(
    contains(text, "  xmlPutMap(w, xmlTag(\"W\", xmlNoAttrs()), wNames, v.w, xmlPutStr)?\n"),
    "wrapped map",
  )
  assert(
    contains(text, "  xmlPutSome(w, \"E\", xmlNoAttrs(), v.e, xmlPutEpoch)?\n"),
    "epoch seconds",
  )
  assert(contains(text, "  xmlPutSome(w, \"B\", xmlNoAttrs(), v.b, xmlPutBlob)?\n"), "blob")
  assert(
    contains(text, "fn serializeOpBody(req: RequestHead, input: OpInput): ()! {\n"),
    "the serializer of an input with no payload",
  )
  assert(
    contains(text, "  xmlPutOpInput(w, \"In\", xmlNoAttrs(), input)?\n"),
    "root named after the input shape",
  )
}

test "a streaming blob, a non-string attribute, a non-string map key, a wide union are errors" {
  expectSerError(
    serMini(
      "\"B\":{\"target\":\"a#B\"}",
      ",\"a#B\":{\"type\":\"blob\",\"traits\":{\"smithy.api#streaming\":{}}}",
    ),
    "a streaming blob in an XML body",
  )
  expectSerError(
    serMini(
      "\"A\":{\"target\":\"a#I\",\"traits\":{\"smithy.api#xmlAttribute\":{}}}",
      ",\"a#I\":{\"type\":\"integer\"}",
    ),
    "an attribute of this kind",
  )
  expectSerError(
    serMini(
      "\"M\":{\"target\":\"a#M\"}",
      ",\"a#I\":{\"type\":\"integer\"},\"a#M\":{\"type\":\"map\",\"key\":{\"target\":\"a#I\"},\"value\":{\"target\":\"a#T\"}}",
    ),
    "keyed by strings",
  )
  expectSerError(
    serMini(
      "\"U\":{\"target\":\"a#U\"}",
      ",\"a#U\":{\"type\":\"union\",\"members\":{\"A\":{\"target\":\"a#T\"},\"B\":{\"target\":\"a#T\"},\"C\":{\"target\":\"a#T\"},\"D\":{\"target\":\"a#T\"},\"E\":{\"target\":\"a#T\"},\"F\":{\"target\":\"a#T\"},\"G\":{\"target\":\"a#T\"},\"H\":{\"target\":\"a#T\"},\"I\":{\"target\":\"a#T\"}}}",
    ),
    "a union writer holds 8",
  )
}
