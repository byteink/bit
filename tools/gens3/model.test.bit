// tools/gens3/model.test.bit — #6604. The loader against the vendored model
// (tools/gens3/model/s3.json, pinned at api-models-aws
// 7eb6ab98cd5f1e5dc6dd90ea1bdc625f9ae308ba): the counts epic #6565 states, the
// PutObject members the acceptance names, and for every trait the loader
// reads, that the number of members carrying it equals the number the raw JSON
// holds, counted here by a separate walk. Then the failure paths on small
// fixtures: an unknown trait, a trait in an unexpected shape, an unknown key
// and a dangling target are errors naming the shape.
//
// Run from the repo root: bit test tools/gens3

import { replace } from "std/strings"

const putObjectInput: string = "com.amazonaws.s3#PutObjectRequest"

fn loadedModel(): Model {
  return loadModel(loadVendored()) catch e {
    panic("loadModel: ${e.message()}")
  }
}

fn shapeOf(m: Model, id: string): Shape {
  match (findShape(m, id)) {
    Some(s) => return s
    None => panic("no shape ${id}")
  }
}

fn opOf(m: Model, id: string): Operation {
  match (findOperation(m, id)) {
    Some(op) => return op
    None => panic("no operation ${id}")
  }
}

fn memberOf(m: Model, shape: string, name: string): Member {
  let s = shapeOf(m, shape)
  for mem of s.members {
    if (mem.name == name) {
      return mem
    }
  }
  panic("${shape} has no member ${name}")
}

// A one-structure model around `members` JSON, plus the service and one
// operation the loader requires; `extra` is spliced into the shapes object.
fn miniModel(extra: string): string {
  return "{\"smithy\":\"2.0\",\"shapes\":{" +
    "\"a#Svc\":{\"type\":\"service\",\"version\":\"1\",\"operations\":[{\"target\":\"a#Op\"}],\"traits\":{}}," +
    "\"a#Op\":{\"type\":\"operation\",\"input\":{\"target\":\"a#In\"},\"output\":{\"target\":\"smithy.api#Unit\"},\"traits\":{\"smithy.api#http\":{\"method\":\"GET\",\"uri\":\"/\"}}}," +
    extra +
    "}}"
}

fn miniIn(memberJson: string): string {
  return miniModel(
      "\"a#In\":{\"type\":\"structure\",\"members\":{\"M\":" +
      memberJson +
      "},\"traits\":{}},\"a#T\":{\"type\":\"string\"}",
  )
}

fn expectLoadError(src: string, want: string) {
  let _ = loadModel(src) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("loadModel accepted the input, want an error containing ${want}")
}

// Walk the raw JSON: every member object of every shape (a list's "member", a
// map's "key" and "value" included).
fn rawMembers(root: Json): []Json {
  let out = []Json(0)
  for shape of entriesOf(field(root, "shapes")) {
    for k of ["member", "key", "value"] {
      if (len(entriesOf(field(shape.value, k))) > 0) {
        out = append(out, field(shape.value, k))
      }
    }
    for mem of entriesOf(field(shape.value, "members")) {
      out = append(out, mem.value)
    }
  }
  return out
}

fn rawTraitCount(root: Json, key: string): int {
  let n = 0
  for mem of rawMembers(root) {
    if (hasKey(field(mem, "traits"), key)) {
      n = n + 1
    }
  }
  return n
}

fn loadedCount(m: Model, has: (Member) => bool): int {
  let n = 0
  for s of m.shapes {
    for mem of s.members {
      if (has(mem)) {
        n = n + 1
      }
    }
  }
  return n
}

test "the loader reports 112 operations and 1681 members, the counts the raw model has" {
  let m = loadedModel()
  let raw = countModel(parseOk(loadVendored()))
  assert(len(m.operations) == 112, "operations: ${len(m.operations)} of 112")
  assert(countMembers(m) == 1681, "members: ${countMembers(m)} of 1681")
  assert(
    len(m.operations) == raw.operations,
    "operations ${len(m.operations)} != raw ${raw.operations}",
  )
  assert(countMembers(m) == raw.members, "members ${countMembers(m)} != raw ${raw.members}")
  assert(len(m.serviceOperations) == 112, "service lists ${len(m.serviceOperations)}")
  assert(m.serviceVersion == "2006-03-01", "service version ${m.serviceVersion}")
  assert(
    m.serviceXmlNsUri == "http://s3.amazonaws.com/doc/2006-03-01/",
    "service xml ns ${m.serviceXmlNsUri}",
  )
}

test "PutObject input has 49 members with the wire locations the model gives" {
  let m = loadedModel()
  let s = shapeOf(m, putObjectInput)
  assert(len(s.members) == 49, "PutObjectRequest has ${len(s.members)} members, want 49")
  assert(memberOf(m, putObjectInput, "ContentMD5").header == "Content-MD5", "ContentMD5 header")
  assert(
    memberOf(m, putObjectInput, "Metadata").prefixHeaders == "x-amz-meta-",
    "Metadata prefix headers",
  )
  let body = memberOf(m, putObjectInput, "Body")
  assert(body.payload, "Body is the payload")
  assert(isStreaming(m, body), "Body is a streaming blob")
  assert(body.hasDefault && body.defaultText == "\"\"", "Body default ${body.defaultText}")
  assert(
    memberOf(m, putObjectInput, "Bucket").label && memberOf(m, putObjectInput, "Bucket").required,
    "Bucket is a required label",
  )
  assert(memberOf(m, putObjectInput, "Bucket").contextParam == "Bucket", "Bucket context param")
  assert(!isStreaming(m, memberOf(m, putObjectInput, "ContentMD5")), "ContentMD5 is not streaming")
}

test "every trait the loader reads is carried by as many members as the raw JSON holds" {
  let m = loadedModel()
  let root = parseOk(loadVendored())
  assert(
    loadedCount(m, (x) => x.header != "") == rawTraitCount(root, "smithy.api#httpHeader"),
    "httpHeader",
  )
  assert(
    loadedCount(m, (x) => x.query != "") == rawTraitCount(root, "smithy.api#httpQuery"),
    "httpQuery",
  )
  assert(
    loadedCount(m, (x) => x.label) == rawTraitCount(root, "smithy.api#httpLabel"),
    "httpLabel",
  )
  assert(
    loadedCount(m, (x) => x.payload) == rawTraitCount(root, "smithy.api#httpPayload"),
    "httpPayload",
  )
  assert(
      loadedCount(m, (x) => x.prefixHeaders != "") ==
      rawTraitCount(root, "smithy.api#httpPrefixHeaders"),
    "httpPrefixHeaders",
  )
  assert(
    loadedCount(m, (x) => x.required) == rawTraitCount(root, "smithy.api#required"),
    "required",
  )
  assert(
    loadedCount(m, (x) => x.xmlName != "") == rawTraitCount(root, "smithy.api#xmlName"),
    "xmlName",
  )
  assert(
    loadedCount(m, (x) => x.xmlFlattened) == rawTraitCount(root, "smithy.api#xmlFlattened"),
    "xmlFlattened",
  )
  assert(
    loadedCount(m, (x) => x.xmlAttribute) == rawTraitCount(root, "smithy.api#xmlAttribute"),
    "xmlAttribute",
  )
  assert(
    loadedCount(m, (x) => x.xmlNsUri != "") == rawTraitCount(root, "smithy.api#xmlNamespace"),
    "xmlNamespace",
  )
  assert(
    loadedCount(m, (x) => x.hasDefault) == rawTraitCount(root, "smithy.api#default"),
    "default",
  )
  assert(
    loadedCount(m, (x) => x.contextParam != "") == rawTraitCount(root, "smithy.rules#contextParam"),
    "contextParam",
  )
  assert(
    loadedCount(m, (x) => x.idempotencyToken) == rawTraitCount(root, "smithy.api#idempotencyToken"),
    "idempotencyToken",
  )
  assert(
      loadedCount(m, (x) => x.timestampFormat != "") ==
      rawTraitCount(root, "smithy.api#timestampFormat"),
    "timestampFormat",
  )
  assert(
    loadedCount(m, (x) => x.hostLabel) == rawTraitCount(root, "smithy.api#hostLabel"),
    "hostLabel",
  )
  assert(
    loadedCount(m, (x) => x.eventPayload) == rawTraitCount(root, "smithy.api#eventPayload"),
    "eventPayload",
  )
  assert(
    loadedCount(m, (x) => x.deprecated) == rawTraitCount(root, "smithy.api#deprecated"),
    "deprecated",
  )
}

test "operations carry http, checksum, pagination, waiters, endpoint and context traits" {
  let m = loadedModel()
  let put = opOf(m, "com.amazonaws.s3#PutObject")
  assert(put.method == "PUT" && put.code == 200, "PutObject ${put.method} ${put.code}")
  assert(put.uri == "/{Bucket}/{Key+}?x-id=PutObject", "PutObject uri ${put.uri}")
  assert(
    put.checksum.present && put.checksum.requestAlgorithmMember == "ChecksumAlgorithm",
    "PutObject checksum",
  )
  assert(len(put.errors) == 4, "PutObject errors ${len(put.errors)}")
  let get = opOf(m, "com.amazonaws.s3#GetObject")
  assert(
    len(get.checksum.responseAlgorithms) == 10,
    "GetObject response algorithms ${len(get.checksum.responseAlgorithms)}",
  )
  let list = opOf(m, "com.amazonaws.s3#ListObjectsV2")
  assert(
    list.paginated.present && list.paginated.items == "" && list.paginated.pageSize == "MaxKeys",
    "ListObjectsV2 pagination",
  )
  let head = opOf(m, "com.amazonaws.s3#HeadBucket")
  assert(len(head.waiters) == 2 && head.waiters[0].name == "BucketExists", "HeadBucket waiters")
  assert(head.waiters[0].minDelay == 5 && head.waiters[0].maxDelay == 120, "BucketExists delays")
  let loc = opOf(m, "com.amazonaws.s3#GetBucketLocation")
  assert(loc.unwrappedXmlOutput && len(loc.staticParams) == 1, "GetBucketLocation customizations")
  let wgor = opOf(m, "com.amazonaws.s3#WriteGetObjectResponse")
  assert(
      wgor.hostPrefix == "{RequestRoute}." &&
      wgor.unsignedPayload &&
      wgor.output == "smithy.api#Unit",
    "WriteGetObjectResponse endpoint",
  )
}

test "error shapes carry their kind and status, shapes their xml names" {
  let m = loadedModel()
  let denied = shapeOf(m, "com.amazonaws.s3#AccessDenied")
  assert(
    denied.errorKind == "client" && denied.httpError == 403,
    "AccessDenied ${denied.errorKind} ${denied.httpError}",
  )
  let done = shapeOf(m, "com.amazonaws.s3#CompleteMultipartUploadOutput")
  assert(done.xmlName == "CompleteMultipartUploadResult", "xmlName ${done.xmlName}")
  let grantee = memberOf(m, "com.amazonaws.s3#Grantee", "Type")
  assert(grantee.xmlAttribute, "Grantee.Type is an xml attribute")
}

test "a trait the generator does not read is an error naming the trait and the shape" {
  expectLoadError(
    miniIn("{\"target\":\"a#T\",\"traits\":{\"smithy.api#bogus\":{}}}"),
    "a#In.M: trait smithy.api#bogus: unknown trait",
  )
  expectLoadError(
    miniModel("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{\"smithy.api#bogus\":{}}}"),
    "a#In: trait smithy.api#bogus: unknown trait",
  )
  expectLoadError(
    replace(
      miniModel("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}}"),
      "\"smithy.api#http\"",
      "\"smithy.api#bogus\":{},\"smithy.api#http\"",
    ),
    "a#Op: trait smithy.api#bogus: unknown trait",
  )
}

test "a trait read in an unexpected shape is an error naming the shape" {
  expectLoadError(
    miniIn("{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpHeader\":5}}"),
    "a#In.M: trait smithy.api#httpHeader: expected a string",
  )
  expectLoadError(
    miniIn("{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpLabel\":true}}"),
    "a#In.M: trait smithy.api#httpLabel: expected {}",
  )
  expectLoadError(
    miniIn("{\"target\":\"a#T\",\"traits\":{\"smithy.api#timestampFormat\":\"rfc\"}}"),
    "unknown timestamp format",
  )
  expectLoadError(
    miniIn("{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpHeader\":\"X\",\"smithy.api#httpQuery\":\"x\"}}"),
    "more than one wire location",
  )
  expectLoadError(
    miniIn("{\"target\":\"a#T\",\"traits\":{\"smithy.api#xmlNamespace\":{\"uri\":\"u\",\"extra\":1}}}"),
    "unknown key \"extra\"",
  )
  expectLoadError(miniIn("{\"target\":\"a#T\",\"extra\":1}"), "a#In.M: unknown key \"extra\"")
}

test "a dangling target, a duplicate id and a missing binding are errors" {
  expectLoadError(
    miniIn("{\"target\":\"a#Missing\"}"),
    "a#In.M: target a#Missing is not in the model",
  )
  expectLoadError(
    miniModel("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}},\"a#In\":{\"type\":\"string\"}"),
    "a#In: defined twice",
  )
  expectLoadError(
    replace(
      miniModel("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}}"),
      "\"smithy.api#http\":{\"method\":\"GET\",\"uri\":\"/\"}",
      "",
    ),
    "no smithy.api#http trait",
  )
  expectLoadError(miniModel("\"a#In\":{\"type\":\"document\"}"), "a#In: shape type \"document\"")
}

test "a waiter matcher the generator does not read is an error" {
  let w = "\"smithy.waiters#waitable\":{\"W\":{\"acceptors\":[{\"state\":\"success\",\"matcher\":{\"output\":{}}}]}}"
  let src = replace(
    miniModel("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}}"),
    "\"smithy.api#http\"",
    w + ",\"smithy.api#http\"",
  )
  expectLoadError(src, "a#Op: trait smithy.waiters#waitable.W: unknown matcher \"output\"")
}
