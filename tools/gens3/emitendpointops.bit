// tools/gens3 — the per-operation half of the endpoint emitter (#6843, epic
// #6565): `pkg/s3/gen_endpoint_ops.bit`, the table of which endpoint rule
// parameters each operation of the model sets. Run:
//
//   bit run tools/gens3 -- endpoint [out-dir]
//
// An operation sets a rule parameter two ways: a member of its input carries
// `smithy.rules#contextParam` (the input value is the parameter), or the operation
// carries `smithy.rules#staticContextParams` (the parameter has a fixed value).
// The S3 model uses no `smithy.rules#operationContextParams`; the model loader
// refuses a trait it does not know, so a model bump that brings one stops there.
//
// One row a model operation, `Name|flags`, in model order. The parameter names
// are closed lists: a name outside them is an error naming the operation, never
// a dropped binding.

import { Builder, indexOf } from "std/strings"

// The order a row lists its flags in, whatever order the model declares them.
const epFlagOrder: []string = ["B", "K", "P", "C", "X", "S", "L", "A"]

// The rule parameters an input member binds to, and the letter that stands for each.
fn epMemberFlag(name: string): string {
  if (name == "Bucket") {
    return "B"
  }
  if (name == "Key") {
    return "K"
  }
  if (name == "Prefix") {
    return "P"
  }
  if (name == "CopySource") {
    return "C"
  }
  return ""
}

// The static parameters the model sets to true, and the letter that stands for each.
fn epStaticFlag(name: string): string {
  if (name == "UseS3ExpressControlEndpoint") {
    return "X"
  }
  if (name == "DisableS3ExpressSessionAuth") {
    return "S"
  }
  if (name == "UseObjectLambdaEndpoint") {
    return "L"
  }
  if (name == "DisableAccessPoints") {
    return "A"
  }
  return ""
}

// The member flags of `op`, in the order its input shape declares the members.
fn epMemberFlags(op: Operation, shape: Shape): string! {
  let flags = ""
  for mem of shape.members {
    if (mem.contextParam == "") {
      continue
    }
    let f = epMemberFlag(mem.contextParam)
    if (f == "") {
      fail newError("${op.name}.${mem.name}: contextParam ${mem.contextParam} is not one the generator knows")
    }
    if (mem.name != mem.contextParam) {
      fail newError("${op.name}.${mem.name}: contextParam ${mem.contextParam} on a member of another name")
    }
    flags = flags + f
  }
  return flags
}

// The static flags of `op`, in the order the model lists them.
fn epStaticFlags(op: Operation): string! {
  let flags = ""
  for p of op.staticParams {
    let f = epStaticFlag(p.name)
    if (f == "") {
      fail newError("${op.name}: staticContextParams ${p.name} is not one the generator knows")
    }
    if (p.valueText != "true") {
      fail newError("${op.name}: staticContextParams ${p.name} is ${p.valueText}, the generator reads true")
    }
    flags = flags + f
  }
  return flags
}

// `flags` in `epFlagOrder`, so a row does not depend on member declaration order.
fn epCanonFlags(flags: string): string {
  let out = ""
  for f of epFlagOrder {
    if (indexOf(flags, f) >= 0) {
      out = out + f
    }
  }
  return out
}

// The rows, one a model operation in model order.
fn epOperationRows(m: Model): []string! {
  let rows = []string(0)
  for op of m.operations {
    match (findShape(m, op.input)) {
      Some(shape) => rows = append(
        rows,
        "${op.name}|${epCanonFlags(epMemberFlags(op, shape)? + epStaticFlags(op)?)}",
      )
      None => fail newError("${op.name}: input shape ${op.input} is not in the model")
    }
  }
  return rows
}

// `gen_endpoint_ops.bit`: the operation table of the vendored model.
fn epRenderOperations(m: Model, pin: string): GenFile! {
  let rows = epOperationRows(m)?
  let s = Builder()
  s.write(headerLines("endpoint", pinValue(pin, "commit")?, pinValue(pin, "sha256")?))
  s.write("\n")
  s.write("// Every operation of the model as `Name|flags`. B, K, P and C: the operation\n")
  s.write("// binds its Bucket, Key, Prefix and CopySource member to the parameter of that\n")
  s.write("// name. X, S, L and A: its static context parameters UseS3ExpressControlEndpoint,\n")
  s.write("// DisableS3ExpressSessionAuth, UseObjectLambdaEndpoint and DisableAccessPoints\n")
  s.write("// are true.\n")
  s.write("const endpointOperations: []string = [\n")
  for r of rows {
    s.write("  ${epStringLit(r, "operation row")?},\n")
  }
  s.write("]\n")
  return GenFile{ name = epOperationsName, text = s.toString() }
}
