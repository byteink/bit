// tools/gens3 — the S3 model generator's entry point. Run from the repo root:
//
//   bit run tools/gens3 -- trim <upstream-model.json> [out-file]   (trim.bit)
//   bit run tools/gens3 -- shapes [out-dir]                        (emitshapes.bit)
//   bit run tools/gens3 -- errors [out-dir]                        (emiterrors.bit)
//   bit run tools/gens3 -- resp [out-dir]                          (emitresp.bit)
//
// `shapes` renders pkg/s3/gen_shapes_NN.bit (or `out-dir`) from the vendored
// model and removes any gen_shapes_NN.bit a smaller output no longer has.
// `errors` renders pkg/s3/gen_errors.bit (or in `out-dir`) from the vendored
// model and tools/gens3/unmodeled.txt.
// `resp` renders pkg/s3/gen_resp_enums_NN.bit and gen_resp_ops_NN.bit (or in
// `out-dir`) from the vendored model and removes any gen_resp_*.bit a smaller
// output no longer has.

import { args, exit } from "std/os"
import { readFile, writeFile, readDir, remove } from "std/fs"
import { join } from "std/path"
import { hasPrefix, hasSuffix } from "std/strings"

const vendoredModelFile: string = "tools/gens3/model/s3.json"
const unmodeledFile: string = "tools/gens3/unmodeled.txt"
const defaultShapesOut: string = "pkg/s3"
const shapesPrefix: string = "gen_shapes_"
const respPrefix: string = "gen_resp_"

// The files `shapes` writes for the vendored model and its PIN.
fn generateShapes(modelFile: string, pinFile: string): []GenFile! {
  let m = loadModelFile(modelFile)?
  let pin = readFile(pinFile)?
  return renderShapes(m, pinValue(pin, "commit")?, pinValue(pin, "sha256")?)?
}

// Whether `name` is a generated `<prefix>*.bit` that `files` no longer has.
fn isStaleFile(prefix: string, name: string, files: []GenFile): bool {
  if (!hasPrefix(name, prefix) || !hasSuffix(name, ".bit") || hasSuffix(name, ".test.bit")) {
    return false
  }
  for f of files {
    if (f.name == name) {
      return false
    }
  }
  return true
}

// Write `files` into `dir`, then delete the generated `<prefix>*.bit` files not among them.
fn writeGenerated(dir: string, prefix: string, files: []GenFile): ()! {
  for f of files {
    writeFile(join(dir, f.name), f.text)?
  }
  for name of readDir(dir)? {
    if (isStaleFile(prefix, name, files)) {
      remove(join(dir, name))?
    }
  }
}

fn shapesMain(a: []string) {
  if (len(a) > 2) {
    eprint("usage: gens3 shapes [out-dir]\n")
    exit(2)
    return
  }
  let out = defaultShapesOut
  if (len(a) == 2) {
    out = a[1]
  }
  let files = generateShapes(vendoredModelFile, pinPath) catch e {
    eprint("gens3 shapes: ${e.message()}\n")
    exit(1)
    return
  }
  writeGenerated(out, shapesPrefix, files) catch e {
    eprint("gens3 shapes: ${e.message()}\n")
    exit(1)
    return
  }
  eprint("gens3 shapes: ${len(files)} files\n")
}

// The file `errors` writes for the vendored model, its PIN and unmodeled.txt.
fn generateErrors(modelFile: string, pinFile: string, codesFile: string): GenFile! {
  let m = loadModelFile(modelFile)?
  let pin = readFile(pinFile)?
  return renderErrors(m, readFile(codesFile)?, pinValue(pin, "commit")?, pinValue(pin, "sha256")?)?
}

fn errorsMain(a: []string) {
  if (len(a) > 2) {
    eprint("usage: gens3 errors [out-dir]\n")
    exit(2)
    return
  }
  let out = defaultShapesOut
  if (len(a) == 2) {
    out = a[1]
  }
  let f = generateErrors(vendoredModelFile, pinPath, unmodeledFile) catch e {
    eprint("gens3 errors: ${e.message()}\n")
    exit(1)
    return
  }
  writeFile(join(out, f.name), f.text) catch e {
    eprint("gens3 errors: ${e.message()}\n")
    exit(1)
    return
  }
  eprint("gens3 errors: ${f.name}\n")
}

// The files `resp` writes for the vendored model and its PIN.
fn generateResp(modelFile: string, pinFile: string): []GenFile! {
  let m = loadModelFile(modelFile)?
  let pin = readFile(pinFile)?
  return renderResp(m, pinValue(pin, "commit")?, pinValue(pin, "sha256")?)?
}

fn respMain(a: []string) {
  if (len(a) > 2) {
    eprint("usage: gens3 resp [out-dir]\n")
    exit(2)
    return
  }
  let out = defaultShapesOut
  if (len(a) == 2) {
    out = a[1]
  }
  let files = generateResp(vendoredModelFile, pinPath) catch e {
    eprint("gens3 resp: ${e.message()}\n")
    exit(1)
    return
  }
  writeGenerated(out, respPrefix, files) catch e {
    eprint("gens3 resp: ${e.message()}\n")
    exit(1)
    return
  }
  eprint("gens3 resp: ${len(files)} files\n")
}

fn main() {
  let a = args()
  if (len(a) >= 2 && a[1] == "trim") {
    trimMain(a[1:len(a)])
    return
  }
  if (len(a) >= 2 && a[1] == "shapes") {
    shapesMain(a[1:len(a)])
    return
  }
  if (len(a) >= 2 && a[1] == "errors") {
    errorsMain(a[1:len(a)])
    return
  }
  if (len(a) >= 2 && a[1] == "resp") {
    respMain(a[1:len(a)])
    return
  }
  eprint("usage: gens3 trim <upstream-model.json> [out-file] | gens3 shapes [out-dir] | gens3 errors [out-dir] | gens3 resp [out-dir]\n")
  exit(2)
}
