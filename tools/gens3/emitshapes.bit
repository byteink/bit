// tools/gens3 — renders the shapes of the pinned S3 model as Bit source,
// `pkg/s3/gen_shapes_NN.bit` (#6614, epic #6565). The types and their names
// come from emitplan.bit, the member types from emittypes.bit, the spellings
// from naming.bit.
//
// What a type looks like:
//
//   - a structure is a class; a member that is `required` or declares a
//     `default` is a plain field, every other member is `Option<T>`, so a
//     literal names only what it sets and presence is never lost (S3 tells an
//     absent header from `false`). An output class also carries
//     `responseMetadata: ResponseMetadata` (the SDK's `$metadata`; it is not
//     called `metadata` because GetObject and HeadObject have a modeled
//     `Metadata` member, the user metadata, which keeps that name);
//   - an enum is a Bit enum with one variant per value and a last
//     `Unknown(string)`, so a value the server adds later is carried, not lost;
//   - a union is an enum with one payload variant per member and a last
//     `Unknown(string)` (the member name the server sent).
//
// Output is a pure function of the model and the pin: types sorted by name,
// members in the loaded (model) order, files filled greedily in that order
// and cut before a type that would cross `maxBlockLines`.

import { Builder } from "std/strings"

// A file is the header, at most one import line and the type blocks; the cap
// leaves room for the header and stays under the 800-line file ceiling.
const maxBlockLines: int = 740

class GenFile {
  name: string,
  text: string,
}

fn countLines(s: string): int {
  let n = 0
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// The one header the SDK's s3-expires step rewrites: an output's `Expires`
// (a string in the model) is a date here, parsed from the header, with the raw
// text beside it as `expiresString`; a value that is not a date leaves
// `expires` unset and `expiresString` raw (emitresp.bit fills both).
fn isExpiresHeader(u: Unit, mem: Member): bool {
  return u.role == Role.Output && mem.header == "Expires"
}

fn writeMember(b: Builder, p: Plan, u: Unit, mem: Member): ()! {
  let at = "${u.shape.id}.${mem.name}"
  let t = typeExpr(p, u.role, mem.target)?
  if (isExpiresHeader(u, mem)) {
    t = "Timestamp"
  }
  if (!mem.required && !mem.hasDefault) {
    t = "Option<${t}>"
  }
  b.write("  export ${fieldName(mem.name)}: ${t}${defaultSuffix(p, mem, at)?},\n")
  if (isExpiresHeader(u, mem)) {
    b.write("  export expiresString: Option<string>,\n")
  }
}

// Field names that collide inside one class: `Foo` and `foo` would both be `foo`.
fn checkFieldNames(u: Unit): ()! {
  let seen = []string(0)
  for mem of u.shape.members {
    let f = fieldName(mem.name)
    if (u.role == Role.Output && f == "responseMetadata") {
      fail newError("${u.shape.id}: member ${mem.name} collides with the response metadata field")
    }
    if (u.role == Role.Output && f == "expiresString") {
      fail newError("${u.shape.id}: member ${mem.name} collides with the generated expiresString field")
    }
    for s of seen {
      if (s == f) {
        fail newError("${u.shape.id}: two members make the field ${f}")
      }
    }
    seen = append(seen, f)
  }
}

fn renderClass(p: Plan, u: Unit): string! {
  checkFieldNames(u)?
  let b = Builder()
  b.write("// ${u.shape.id}\n")
  if (len(u.shape.members) == 0 && u.role != Role.Output) {
    b.write("export class ${u.name} {}\n")
    return b.toString()
  }
  b.write("export class ${u.name} {\n")
  for mem of u.shape.members {
    writeMember(b, p, u, mem)?
  }
  if (u.role == Role.Output) {
    b.write("  export responseMetadata: ResponseMetadata = ResponseMetadata{},\n")
  }
  b.write("}\n")
  return b.toString()
}

fn checkVariant(seen: []string, v: string, at: string): ()! {
  if (v == "Unknown") {
    fail newError("${at}: the variant name Unknown is the generator's")
  }
  for s of seen {
    if (s == v) {
      fail newError("${at}: two variants are named ${v}")
    }
  }
}

fn renderEnum(p: Plan, u: Unit): string! {
  let b = Builder()
  let seen = []string(0)
  b.write("// ${u.shape.id}\n")
  b.write("export enum ${u.name} {\n")
  for mem of u.shape.members {
    let v = variantName(mem.name)?
    checkVariant(seen, v, u.shape.id)?
    seen = append(seen, v)
    b.write("  ${v},\n")
  }
  b.write("  Unknown(string),\n}\n")
  return b.toString()
}

// A union member is already a PascalCase word; it keeps its spelling.
fn unionVariant(name: string, at: string): string! {
  if (len(name) == 0 || !isUpperByte(name[0])) {
    fail newError("${at}: union member ${name} is not a PascalCase name")
  }
  return name
}

fn renderUnion(p: Plan, u: Unit): string! {
  let b = Builder()
  let seen = []string(0)
  b.write("// ${u.shape.id}\n")
  b.write("export enum ${u.name} {\n")
  for mem of u.shape.members {
    let v = unionVariant(mem.name, u.shape.id)?
    checkVariant(seen, v, u.shape.id)?
    seen = append(seen, v)
    b.write("  ${v}(${typeExpr(p, u.role, mem.target)?}),\n")
  }
  b.write("  Unknown(string),\n}\n")
  return b.toString()
}

fn renderUnit(p: Plan, u: Unit): string! {
  return match (u.shape.kind) {
    Enum => renderEnum(p, u)?
    Union => renderUnion(p, u)?
    _ => renderClass(p, u)?
  }
}

// Whether any member of the type writes `Timestamp`.
fn unitUsesTimestamp(p: Plan, u: Unit): bool {
  for mem of u.shape.members {
    if (usesTimestamp(p.m, mem.target) || isExpiresHeader(u, mem)) {
      return true
    }
  }
  return false
}

// The generator's header lines, without the blank line that ends them. `cmd` is
// the gens3 subcommand that regenerates the file.
fn headerLines(cmd: string, commit: string, sha: string): string {
  return "// Code generated by tools/gens3 from the S3 Smithy model; DO NOT EDIT.\n" +
    "// Model: github.com/aws/api-models-aws at commit ${commit}\n" +
    "// (model file sha256 ${sha}).\n" +
    "// Regenerate with: bit run tools/gens3 -- ${cmd}\n"
}

fn header(commit: string, sha: string): string {
  return headerLines("shapes", commit, sha) + "\n"
}

fn fileName(n: int): string {
  if (n < 10) {
    return "gen_shapes_0${n}.bit"
  }
  return "gen_shapes_${n}.bit"
}

// The finished file: header, `Timestamp` import when a block needs it, blocks.
fn finishFile(n: int, head: string, blocks: []string, stamp: bool): GenFile {
  let b = Builder()
  b.write(head)
  if (stamp) {
    b.write("import { Timestamp } from \"std/time\"\n\n")
  }
  let i = 0
  while (i < len(blocks)) {
    b.write(blocks[i])
    if (i + 1 < len(blocks)) {
      b.write("\n")
    }
    i = i + 1
  }
  return GenFile{ name = fileName(n), text = b.toString() }
}

// Every `gen_shapes_NN.bit`, in order. `commit` and `sha` are the model pin.
fn renderShapes(m: Model, commit: string, sha: string): []GenFile! {
  let p = planShapes(m)?
  let head = header(commit, sha)
  let files = []GenFile(0)
  let blocks = []string(0)
  let lines = 0
  let stamp = false
  for u of p.units {
    let block = renderUnit(p, u)?
    let n = countLines(block) + 1
    if (len(blocks) > 0 && lines + n > maxBlockLines) {
      files = append(files, finishFile(len(files) + 1, head, blocks, stamp))
      blocks = []string(0)
      lines = 0
      stamp = false
    }
    blocks = append(blocks, block)
    lines = lines + n
    stamp = stamp || unitUsesTimestamp(p, u)
  }
  if (len(blocks) > 0) {
    files = append(files, finishFile(len(files) + 1, head, blocks, stamp))
  }
  return files
}
