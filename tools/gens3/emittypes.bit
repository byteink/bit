// tools/gens3 — the Bit type a member's Smithy target stands for, and the
// default a member declares (#6614, epic #6565).

// A blob is bytes; a streaming blob is `Body` going out and `ByteStream`
// coming back.
fn blobType(s: Shape, role: Role): string {
  if (!s.streaming) {
    return "[]byte"
  }
  if (role == Role.Input) {
    return "Body"
  }
  return "ByteStream"
}

// The type of a simple shape, "" for an aggregate.
fn scalarType(s: Shape, role: Role): string {
  return match (s.kind) {
    String => "string"
    Boolean => "bool"
    Integer => "int"
    Long => "int"
    Timestamp => "Timestamp"
    Blob => blobType(s, role)
    _ => ""
  }
}

// The type written for the shape `id` (in a type of role `role`).
fn typeExpr(p: Plan, role: Role, id: string): string! {
  let i = shapeIndex(p.m, id)
  if (i < 0) {
    fail newError("target ${id} is not in the model")
  }
  let s = p.m.shapes[i]
  let simple = scalarType(s, role)
  if (simple != "") {
    return simple
  }
  return aggregateType(p, role, i)?
}

fn aggregateType(p: Plan, role: Role, i: int): string! {
  let s = p.m.shapes[i]
  if (s.kind == ShapeKind.List) {
    return "[]" + typeExpr(p, role, s.members[0].target)?
  }
  if (s.kind == ShapeKind.Map) {
    return "map<${typeExpr(p, role, s.members[0].target)?}, ${typeExpr(p, role, s.members[1].target)?}>"
  }
  if (s.kind == ShapeKind.Union && s.streaming) {
    return "EventStream<${p.names[i]}>"
  }
  return p.names[i]
}

// Whether writing the shape `id` names std/time's `Timestamp`.
fn usesTimestamp(m: Model, id: string): bool {
  let i = shapeIndex(m, id)
  if (i < 0) {
    return false
  }
  let s = m.shapes[i]
  if (s.kind == ShapeKind.Timestamp) {
    return true
  }
  if (s.kind == ShapeKind.List || s.kind == ShapeKind.Map) {
    for mem of s.members {
      if (usesTimestamp(m, mem.target)) {
        return true
      }
    }
  }
  return false
}

// The JSON string `text` without its quotes, or "" when it is not one.
fn unquoted(text: string): string {
  if (len(text) < 2 || text[0] != '"' || text[len(text) - 1] != '"') {
    return ""
  }
  return text[1:len(text) - 1]
}

// ` = Enum.Variant` for an enum member whose default is the value `text`.
fn enumDefault(p: Plan, i: int, text: string, at: string): string! {
  let want = unquoted(text)
  for mem of p.m.shapes[i].members {
    if (mem.enumValue == want && want != "") {
      return " = ${p.names[i]}.${variantName(mem.name)?}"
    }
  }
  fail newError("${at}: default ${text} is not a value of ${p.names[i]}")
}

// The default texts that are the zero value of the kinds `hasZeroValue` names.
fn isZeroDefault(t: string): bool {
  return t == "\"\"" || t == "0" || t == "false" || t == "[]" || t == "{}"
}

// The kinds whose zero value is a Smithy default of `""`, 0, false, [] or {}.
fn hasZeroValue(k: ShapeKind): bool {
  return match (k) {
    Blob => true
    String => true
    Integer => true
    Long => true
    Boolean => true
    List => true
    Map => true
    _ => false
  }
}

// The ` = literal` a member's `default` trait asks for, "" when the zero value
// already is that default (every default the S3 model has: a blob `""`).
// A default the generator cannot spell is an error: it stops a model bump
// that adds one, where silently dropping it would change what the field holds.
fn defaultSuffix(p: Plan, mem: Member, at: string): string! {
  if (!mem.hasDefault) {
    return ""
  }
  let i = shapeIndex(p.m, mem.target)
  let t = mem.defaultText
  let k = p.m.shapes[i].kind
  if (k == ShapeKind.Enum) {
    return enumDefault(p, i, t, at)?
  }
  if (isZeroDefault(t) && hasZeroValue(k)) {
    return ""
  }
  if (t == "true" && k == ShapeKind.Boolean) {
    return " = true"
  }
  fail newError("${at}: default ${t} is not one the generator spells")
}
