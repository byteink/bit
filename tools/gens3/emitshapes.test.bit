// tools/gens3/emitshapes.test.bit — #6614. The shape emitter against the
// vendored model: every structure, enum and union has its type (counts
// re-derived from the loaded model, "N of N"), every file stays under the
// 800-line ceiling, two renders are byte-identical, the pin is in every
// header, and the spellings the design fixes hold (inputs, outputs, enum
// `Unknown`, optional and required members). Then the failure paths on
// small fixtures. Compilation of the emitted files is `bit check pkg/s3`; the
// literal that builds a `PutObjectInput` is pkg/s3/gen_shapes.test.bit.
//
// Run from the repo root: bit test tools/gens3

import { indexOfFrom } from "std/strings"

const testCommit: string = "7eb6ab98cd5f1e5dc6dd90ea1bdc625f9ae308ba"
const testSha: string = "73e4f75747396176053a0fcc910261cf670c7e133c1cebcfffefa703fad3ce68"

fn renderedFiles(m: Model): []GenFile {
  return renderShapes(m, testCommit, testSha) catch e {
    panic("renderShapes: ${e.message()}")
  }
}

fn variantOf(name: string): string {
  return variantName(name) catch e {
    panic("variantName: ${e.message()}")
  }
}

fn allText(files: []GenFile): string {
  let b = Builder()
  for f of files {
    b.write(f.text)
  }
  return b.toString()
}

fn kindCount(m: Model, k: ShapeKind): int {
  let n = 0
  for s of m.shapes {
    if (s.kind == k) {
      n = n + 1
    }
  }
  return n
}

fn textCount(text: string, needle: string): int {
  let n = 0
  let at = indexOfFrom(text, needle, 0)
  while (at >= 0) {
    n = n + 1
    at = indexOfFrom(text, needle, at + len(needle))
  }
  return n
}

fn expectRenderError(m: Model, want: string) {
  let _ = renderShapes(m, testCommit, testSha) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("renderShapes accepted the model, want an error containing ${want}")
}

fn miniLoaded(extra: string): Model {
  return loadModel(miniModel(extra)) catch e {
    panic("loadModel: ${e.message()}")
  }
}

test "every structure, enum and union of the model has its type: N of N" {
  let m = loadedModel()
  let want = kindCount(m, ShapeKind.Structure) +
    kindCount(m, ShapeKind.Enum) +
    kindCount(m, ShapeKind.Union)
  assert(
    kindCount(m, ShapeKind.Structure) == 364,
    "structures: ${kindCount(m, ShapeKind.Structure)} of 364",
  )
  assert(kindCount(m, ShapeKind.Enum) == 76, "enums: ${kindCount(m, ShapeKind.Enum)} of 76")
  assert(kindCount(m, ShapeKind.Union) == 4, "unions: ${kindCount(m, ShapeKind.Union)} of 4")
  let p = planShapes(m) catch e {
    panic("planShapes: ${e.message()}")
  }
  let derived = len(p.units) - want
  assert(derived == 1, "derived output types: ${derived} of 1 (NotificationConfiguration's)")
  let text = allText(renderedFiles(m))
  let classes = textCount(text, "\nexport class ")
  let enums = textCount(text, "\nexport enum ")
  assert(classes + enums == len(p.units), "emitted ${classes + enums} of ${len(p.units)} types")
  assert(enums == 80, "enums and unions: ${enums} of 80")
  println("generated types: ${classes + enums} of ${len(p.units)} (${want} model shapes + ${derived} derived output)")
}

test "files are numbered from 01, under 800 lines, headed with the pin" {
  let all = renderedFiles(loadedModel())
  assert(
    all[len(all) - 1].name == "gen_checksum_ops.bit",
    "the last file is ${all[len(all) - 1].name}",
  )
  let files = all[0:len(all) - 1]
  assert(len(files) >= 2, "one file cannot hold the shapes: ${len(files)}")
  let i = 0
  while (i < len(files)) {
    let f = files[i]
    assert(f.name == "gen_shapes_0${i + 1}.bit", "file ${i} is named ${f.name}")
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    assert(
      hasPrefix(
        f.text,
        "// Code generated by tools/gens3 from the S3 Smithy model; DO NOT EDIT.\n",
      ),
      "${f.name} header",
    )
    assert(contains(f.text, "api-models-aws at commit ${testCommit}"), "${f.name} names no commit")
    assert(contains(f.text, "sha256 ${testSha}"), "${f.name} names no model hash")
    i = i + 1
  }
}

test "two renders are byte-identical" {
  let m = loadedModel()
  let a = renderedFiles(m)
  let b = renderedFiles(m)
  assert(len(a) == len(b), "file counts differ")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == b[i].name && a[i].text == b[i].text, "${a[i].name} differs between renders")
    i = i + 1
  }
}

test "operation shapes are named Input and Output, required members are plain, the rest Option" {
  let text = allText(renderedFiles(loadedModel()))
  assert(contains(text, "\nexport class PutObjectInput {\n"), "no PutObjectInput")
  assert(!contains(text, "PutObjectRequest {"), "PutObjectRequest was not renamed")
  assert(contains(text, "\n  export bucket: string,\n"), "bucket is not a plain string")
  assert(contains(text, "\n  export body: Body,\n"), "an input's streaming body is not Body")
  assert(
    contains(text, "\n  export body: ByteStream,\n"),
    "an output's streaming body is not ByteStream",
  )
  assert(
    contains(text, "\n  export contentMD5: Option<string>,\n"),
    "contentMD5 is not Option<string>",
  )
  assert(
    contains(text, "\n  export metadata: Option<map<string, string>>,\n"),
    "user metadata is not an optional map",
  )
  assert(contains(text, "\n  export type_: Option<"), "the keyword member `Type` is not type_")
  assert(
    contains(text, "\nexport class UpdateObjectEncryptionOutput {\n"),
    "UpdateObjectEncryptionResponse was not renamed",
  )
  assert(
    contains(text, "\nexport class GetBucketNotificationConfigurationOutput {\n"),
    "no derived output type",
  )
  assert(
    contains(text, "\nexport class NotificationConfiguration {\n"),
    "the shared shape lost its own type",
  )
}

test "every output carries responseMetadata, nothing else does" {
  let m = loadedModel()
  let text = allText(renderedFiles(m))
  let outputs = 0
  for op of m.operations {
    if (op.output != unitShape) {
      outputs = outputs + 1
    }
  }
  assert(outputs == 71, "operations with an output: ${outputs} of 71")
  let carried = textCount(
    text,
    "  export responseMetadata: ResponseMetadata = ResponseMetadata{},\n",
  )
  assert(carried == outputs, "responseMetadata on ${carried} of ${outputs} outputs")
}

test "an enum ends with Unknown(string), a union too, and the S3 unions keep their members" {
  let text = allText(renderedFiles(loadedModel()))
  assert(
    contains(
      text,
      "export enum StorageClass {\n  AwsBackupLowCostWarm,\n  AwsBackupWarm,\n  DeepArchive,",
    ),
    "StorageClass variants",
  )
  assert(
    textCount(text, "\n  Unknown(string),\n}\n") == 80,
    "Unknown(string) on ${textCount(text, "\n  Unknown(string),\n}\n")} of 80",
  )
  assert(
    contains(
      text,
      "export enum AnalyticsFilter {\n  And(AnalyticsAndOperator),\n  Prefix(string),\n  Tag(Tag),\n",
    ),
    "AnalyticsFilter",
  )
  assert(contains(text, "  SSEKMS(SSEKMSEncryption),\n"), "ObjectEncryption.SSEKMS")
  assert(
    contains(text, "export enum BucketLocationConstraint {\n  Eu,\n  AfSouth1,\n"),
    "lower-case enum values",
  )
  assert(
    contains(text, "  export payload: Option<EventStream<SelectObjectContentEventStream>>,\n"),
    "the event stream member",
  )
}

test "member and value spellings" {
  assert(lowerCamel("ContentMD5") == "contentMD5", "ContentMD5 -> ${lowerCamel("ContentMD5")}")
  assert(lowerCamel("SSEKMSKeyId") == "ssekmsKeyId", "SSEKMSKeyId -> ${lowerCamel("SSEKMSKeyId")}")
  assert(lowerCamel("ETag") == "eTag", "ETag -> ${lowerCamel("ETag")}")
  assert(lowerCamel("ID") == "id", "ID -> ${lowerCamel("ID")}")
  assert(lowerCamel("MFA") == "mfa", "MFA -> ${lowerCamel("MFA")}")
  assert(lowerCamel("Bucket") == "bucket", "Bucket -> ${lowerCamel("Bucket")}")
  assert(lowerCamel("IfMatch") == "ifMatch", "IfMatch -> ${lowerCamel("IfMatch")}")
  assert(fieldName("Type") == "type_", "Type -> ${fieldName("Type")}")
  assert(fieldName("Default") == "default_", "Default -> ${fieldName("Default")}")
  assert(fieldName("Delete") == "delete", "Delete -> ${fieldName("Delete")}")
  assert(variantOf("STANDARD_IA") == "StandardIa", "STANDARD_IA")
  assert(variantOf("af_south_1") == "AfSouth1", "af_south_1")
  assert(variantOf("Enabled") == "Enabled", "Enabled")
  assert(variantOf("GLACIER_IR") == "GlacierIr", "GLACIER_IR")
}

test "a name that cannot be spelled, a default the generator cannot write and a shared input are errors" {
  expectRenderError(
    miniLoaded("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}},\"a#E\":{\"type\":\"enum\",\"members\":{\"1x\":{\"target\":\"smithy.api#Unit\",\"traits\":{\"smithy.api#enumValue\":\"1x\"}}}}"),
    "does not make a Bit variant name",
  )
  expectRenderError(
    miniLoaded("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}},\"a#U\":{\"type\":\"union\",\"members\":{\"lower\":{\"target\":\"a#S\"}}},\"a#S\":{\"type\":\"structure\",\"members\":{},\"traits\":{}}"),
    "is not a PascalCase name",
  )
  expectRenderError(
    miniLoaded("\"a#In\":{\"type\":\"structure\",\"members\":{\"N\":{\"target\":\"a#I\",\"traits\":{\"smithy.api#default\":7}}},\"traits\":{}},\"a#I\":{\"type\":\"integer\"}"),
    "default 7 is not one the generator spells",
  )
  expectRenderError(
    miniLoaded("\"a#In\":{\"type\":\"structure\",\"members\":{\"A\":{\"target\":\"a#T\"},\"a\":{\"target\":\"a#T\"}},\"traits\":{}},\"a#T\":{\"type\":\"string\"}"),
    "two members make the field a",
  )
  expectRenderError(
    miniLoaded("\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}},\"a#E\":{\"type\":\"enum\",\"members\":{\"X_Y\":{\"target\":\"smithy.api#Unit\",\"traits\":{\"smithy.api#enumValue\":\"a\"}},\"x_y\":{\"target\":\"smithy.api#Unit\",\"traits\":{\"smithy.api#enumValue\":\"b\"}}}}"),
    "two variants are named XY",
  )
}

test "a shared enum default is spelled as the variant, a true boolean default as true" {
  let m = miniLoaded(
      "\"a#In\":{\"type\":\"structure\",\"members\":{\"E\":{\"target\":\"a#E\",\"traits\":{\"smithy.api#default\":\"B\"}},\"F\":{\"target\":\"a#B\",\"traits\":{\"smithy.api#default\":true}}},\"traits\":{}}," +
      "\"a#B\":{\"type\":\"boolean\"},\"a#E\":{\"type\":\"enum\",\"members\":{\"A\":{\"target\":\"smithy.api#Unit\",\"traits\":{\"smithy.api#enumValue\":\"A\"}},\"B\":{\"target\":\"smithy.api#Unit\",\"traits\":{\"smithy.api#enumValue\":\"B\"}}}}",
  )
  let text = allText(renderedFiles(m))
  assert(contains(text, "  export e: E = E.B,\n"), "enum default: ${text}")
  assert(contains(text, "  export f: bool = true,\n"), "bool default: ${text}")
}

test "an output's Expires is a date with the raw text beside it, an input's stays a string" {
  let text = allText(renderedFiles(loadedModel()))
  assert(
    textCount(
      text,
      "  export expires: Option<Timestamp>,\n  export expiresString: Option<string>,\n",
    ) == 2,
    "GetObjectOutput and HeadObjectOutput carry expires and expiresString",
  )
  assert(
    textCount(text, "  export expires: Option<string>,\n") == 4,
    "the 4 inputs that send Expires keep a string",
  )
}
