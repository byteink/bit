// tools/gens3/emitendpoint.test.bit — #6592. The endpoint emitter against its
// vendored inputs: the node, condition, result and test-case counts re-derived
// from the files ("N of N" against what the files declare and the epic names),
// two renders byte-identical, the checked-in pkg/s3/gen_endpoint*.bit and
// gen_partitions.bit what the generator renders now (edit an input or the PIN
// without regenerating and this goes red), and the failure paths on small
// fixtures. The generated walker itself is run by pkg/s3/gen_endpoint.test.bit.
//
// Run from the repo root: bit test tools/gens3

import { readFile } from "std/fs"
import { contains, replace } from "std/strings"
import { jsonParse } from "std/json"

fn endpointInputs(): EpInputs {
  return epReadInputs() catch e {
    panic("epReadInputs: ${e.message()}")
  }
}

fn loadedBdd(): EpBdd {
  return epLoadBdd(endpointInputs().bdd) catch e {
    panic("epLoadBdd: ${e.message()}")
  }
}

fn renderedEndpoint(inp: EpInputs): []GenFile {
  return epRender(inp) catch e {
    panic("epRender: ${e.message()}")
  }
}

fn expectCount(what: string, got: int, want: int) {
  println("endpoint ${what}: ${got} of ${want}")
  assert(got == want, "${what}: ${got}, want ${want}")
}

test "the vendored endpoint inputs hold 553 nodes, 75 conditions, 115 results and 393 cases" {
  let inp = endpointInputs()
  let b = loadedBdd()
  let cases = epCases(inp.tests) catch e {
    panic("epCases: ${e.message()}")
  }
  let c = epCountsOf(b, cases)
  expectCount("nodes", c.nodes, 553)
  expectCount("node table triples", len(b.nodes) / 3, 553)
  expectCount("conditions", c.conditions, 75)
  expectCount("results", c.results, 115)
  expectCount("cases", c.cases, 393)
  expectCount("rule parameters", len(b.params), 17)
}

test "two renders of the endpoint files are byte-identical" {
  let inp = endpointInputs()
  let a = renderedEndpoint(inp)
  let b = renderedEndpoint(inp)
  assert(len(a) == len(b), "file count ${len(a)} vs ${len(b)}")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == b[i].name && a[i].text == b[i].text, "${a[i].name} differs between runs")
    i = i + 1
  }
}

test "every generated file stays under 800 lines" {
  for f of renderedEndpoint(endpointInputs()) {
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
  }
}

test "the checked-in endpoint files are what the generator renders now" {
  let files = renderedEndpoint(endpointInputs())
  for f of files {
    let path = "pkg/s3/${f.name}"
    let onDisk = readFile(path) catch e {
      panic("read ${path}: ${e.message()}")
    }
    assert(onDisk == f.text, "${path} is stale: run bit run tools/gens3 -- endpoint")
  }
  println("endpoint freshness: ${len(files)} of ${len(files)} files")
}

test "a diagram of another version is refused" {
  let text = replace(endpointInputs().bdd, "\"version\": \"1.1\"", "\"version\": \"2.0\"")
  let r = epLoadBdd(text) catch e {
    assert(contains(e.message(), "version 2.0"), "message: ${e.message()}")
    return
  }
  panic("a version 2.0 diagram loaded: ${r.nodeCount}")
}

test "a declared node count the table does not hold is refused" {
  let text = replace(endpointInputs().bdd, "\"nodeCount\": 553", "\"nodeCount\": 554")
  epLoadBdd(text) catch e {
    assert(contains(e.message(), "nodeCount 554"), "message: ${e.message()}")
    return
  }
  panic("a table of the wrong size loaded")
}

test "a condition that calls a function the generator does not know is refused" {
  let b = loadedBdd()
  let sc = EpScope{ params = b.params, vars = []EpVar(0) }
  let j = jsonParse("{\"fn\": \"frobnicate\", \"argv\": []}") catch e {
    panic(e.message())
  }
  epCondFn(sc, j, 0) catch e {
    assert(contains(e.message(), "frobnicate"), "message: ${e.message()}")
    return
  }
  panic("an unknown function was emitted")
}

test "an input that does not hash to its PIN line is refused" {
  epCheckSha("endpoint-bdd", "not the file", endpointInputs().pin) catch e {
    assert(contains(e.message(), "not the pinned file"), "message: ${e.message()}")
    return
  }
  panic("a wrong hash passed")
}
