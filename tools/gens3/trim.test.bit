// tools/gens3/trim.test.bit — #6581. trim.bit's strip and sort rules on a
// small fixture, the vendored model's counts, that the vendored file is its
// own fixed point, and that PIN and the hash gate hold. The counts are the
// ones epic #6565 states for upstream commit
// 7eb6ab98cd5f1e5dc6dd90ea1bdc625f9ae308ba; the upstream file itself is not
// in the repo, so the counts are read off the trimmed copy, which keeps every
// shape and member.
//
// Run from the repo root: bit test tools/gens3

import { contains } from "std/strings"
import { envOr } from "std/os"

fn modelPath(): string {
  return "${envOr("BIT_REPO", ".")}/tools/gens3/model/s3.json"
}

fn loadVendored(): string {
  return readFile(modelPath()) catch e {
    panic("read ${modelPath()}: ${e.message()} (run from the repo root or set BIT_REPO)")
  }
}

fn trimOk(src: string): string {
  return trimModel(src) catch e {
    panic("trimModel: ${e.message()}")
  }
}

fn parseOk(src: string): Json {
  return jsonParse(src) catch e {
    panic("jsonParse: ${e.message()}")
  }
}

test "trimModel drops the five stripped traits at shape and member level, keeps the rest" {
  let src = "{\"shapes\":{\"a#S\":{\"type\":\"structure\",\"members\":{\"M\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#documentation\":\"d\",\"smithy.api#required\":{}}}},\"traits\":{\"smithy.api#examples\":[],\"smithy.rules#endpointRuleSet\":{},\"smithy.rules#endpointBdd\":{},\"smithy.rules#endpointTests\":{},\"smithy.api#xmlName\":\"X\"}}}}"
  let out = trimOk(src)
  assert(!contains(out, "documentation"), "documentation survived: ${out}")
  assert(!contains(out, "examples"), "examples survived: ${out}")
  assert(!contains(out, "endpoint"), "an endpoint-rules trait survived: ${out}")
  assert(contains(out, "smithy.api#required"), "required trait lost: ${out}")
  assert(contains(out, "smithy.api#xmlName"), "xmlName trait lost: ${out}")
}

test "trimModel sorts object keys and keeps array order" {
  let out = trimOk("{\"b\":1,\"a\":[3,1,2],\"c\":{\"z\":null,\"y\":true}}")
  let want = "{\n  \"a\": [\n    3,\n    1,\n    2\n  ],\n  \"b\": 1,\n  \"c\": {\n    \"y\": true,\n    \"z\": null\n  }\n}\n"
  assert(out == want, "got ${out}")
}

test "trimModel does not touch a non-trait key that happens to be named traits" {
  let out = trimOk("{\"members\":{\"traits\":{\"target\":\"a#T\"}}}")
  assert(contains(out, "\"target\": \"a#T\""), "member named traits was altered: ${out}")
}

test "trimModel rejects a duplicate key instead of picking one" {
  let r = trimModel("{\"a\":1,\"a\":2}") catch e {
    assert(contains(e.message(), "duplicate key \"a\""), "wrong error: ${e.message()}")
    return
  }
  panic("trimModel accepted a duplicate key: ${r}")
}

test "trimModel rejects text that is not JSON" {
  let r = trimModel("{\"a\":") catch _ {
    return
  }
  panic("trimModel accepted truncated JSON: ${r}")
}

test "vendored s3.json has 112 operations and 1681 structure and union members" {
  let c = countModel(parseOk(loadVendored()))
  assert(c.operations == 112, "operations: want 112, got ${c.operations}")
  assert(c.members == 1681, "members: want 1681, got ${c.members}")
}

test "vendored s3.json is a fixed point of trimModel (deterministic bytes)" {
  let src = loadVendored()
  assert(trimOk(src) == src, "trimming the vendored file changed it")
  assert(trimOk(trimOk(src)) == trimOk(src), "trimModel is not idempotent")
}

test "vendored s3.json carries none of the stripped traits" {
  let src = loadVendored()
  assert(!contains(src, "smithy.api#documentation"), "documentation trait present")
  assert(!contains(src, "smithy.api#examples"), "examples trait present")
  assert(!contains(src, "smithy.rules#endpoint"), "endpoint-rules trait present")
}

test "sha256Hex matches the FIPS 180-4 vector for abc" {
  assert(
    sha256Hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    "sha256(abc)",
  )
}

test "PIN names the pinned commit and a 64-digit lowercase sha256" {
  let pin = readFile("${envOr("BIT_REPO", ".")}/tools/gens3/model/PIN") catch e {
    panic("read PIN: ${e.message()}")
  }
  let commit = pinValue(pin, "commit") catch e {
    panic("PIN commit: ${e.message()}")
  }
  assert(commit == "7eb6ab98cd5f1e5dc6dd90ea1bdc625f9ae308ba", "commit: ${commit}")
  let sum = pinValue(pin, "sha256") catch e {
    panic("PIN sha256: ${e.message()}")
  }
  assert(len(sum) == 64, "sha256 length ${len(sum)}")
  for ch of []byte(sum) {
    assert(
      (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'),
      "sha256 has a non-hex digit: ${sum}",
    )
  }
}

test "pinValue skips comments and errors on a missing key" {
  let pin = "# sha256=deadbeef\ncommit=abc\n"
  let c = pinValue(pin, "commit") catch e {
    panic("commit: ${e.message()}")
  }
  assert(c == "abc", "commit: ${c}")
  let r = pinValue(pin, "sha256") catch _ {
    return
  }
  panic("pinValue read a commented-out line: ${r}")
}

test "run refuses an input that is not the pinned upstream file" {
  let notUpstream = "${envOr("BIT_REPO", ".")}/tools/gens3/model/PIN"
  let r = run(notUpstream, "/nonexistent-dir/never-written.json") catch e {
    assert(contains(e.message(), "not the pinned upstream file"), "wrong error: ${e.message()}")
    return
  }
  panic("run accepted a file that is not the pinned upstream: ${r.operations}")
}
