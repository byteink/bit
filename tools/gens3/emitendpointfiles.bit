// tools/gens3 — the file half of the endpoint emitter (#6592, epic #6565): the
// partition table, the test cases as data, the packing of the condition and
// result functions into files under the line cap, and the `endpoint`
// subcommand. See emitendpoint.bit for what is written and why.

import { Builder, contains, hasPrefix, hasSuffix } from "std/strings"
import { Json, jsonEncode, jsonParse } from "std/json"
import { writeFile, readDir, remove } from "std/fs"
import { join } from "std/path"
import { exit } from "std/os"

const epPartitionsName: string = "gen_partitions.bit"
const epCasesName: string = "gen_endpoint_cases.bit"
const epWalkName: string = "gen_endpoint.bit"

fn epStrList(items: []string, at: string): string! {
  let out = []string(0)
  for it of items {
    out = append(out, epStringLit(it, at)?)
  }
  return "[\n${epIndentLines(out, "      ")}    ]"
}

// `items` one per line at `indent`, each followed by a comma.
fn epIndentLines(items: []string, indent: string): string {
  let b = Builder()
  for it of items {
    b.write("${indent}${it},\n")
  }
  return b.toString()
}

// The keys of an object, in file order.
fn epKeys(j: Json, at: string): []string! {
  let out = []string(0)
  for e of needObject(j, at)? {
    out = append(out, e.key)
  }
  return out
}

// One partition of partitions.json as a `partitionRow<n>` function. A region
// entry may carry only a description: aws.partition returns the partition's
// outputs, and a per-region override would need a field the table lacks.
fn epPartitionRow(p: Json, n: int): string! {
  let id = needString(needKey(p, "id", "partition")?, "id")?
  let at = "partition ${id}"
  let out = needKey(p, "outputs", at)?
  onlyKeys(
    needObject(out, at)?,
    [
      "dnsSuffix",
      "dualStackDnsSuffix",
      "implicitGlobalRegion",
      "name",
      "supportsDualStack",
      "supportsFIPS",
    ],
    at,
  )?
  if (needString(needKey(out, "name", at)?, at)? != id) {
    fail newError("${at}: outputs.name differs from id")
  }
  let regions = []string(0)
  for e of needObject(needKey(p, "regions", at)?, at)? {
    onlyKeys(needObject(e.value, at)?, ["description"], "${at} region ${e.key}")?
    regions = append(regions, e.key)
  }
  let s = Builder()
  s.write("// The ${id} partition.\n")
  s.write("fn partitionRow${n}(): PartitionRow {\n  return PartitionRow{\n")
  s.write("    name = ${epStringLit(id, at)?},\n")
  s.write("    regionRegex = ${epStringLit(needString(needKey(p, "regionRegex", at)?, at)?, at)?},\n")
  s.write("    regions = ${epStrList(regions, at)?},\n")
  for f of ["dnsSuffix", "dualStackDnsSuffix", "implicitGlobalRegion"] {
    s.write("    ${f} = ${epStringLit(needString(needKey(out, f, at)?, at)?, at)?},\n")
  }
  for f of ["supportsFIPS", "supportsDualStack"] {
    s.write("    ${f} = ${needBool(needKey(out, f, at)?, at)?},\n")
  }
  s.write("  }\n}\n\n")
  return s.toString()
}

// `gen_partitions.bit`: the partition table of partitions.json, in file order.
fn epRenderPartitions(inp: EpInputs): GenFile! {
  let j = jsonParse(inp.partitions)?
  let version = needString(needKey(j, "version", "partitions.json")?, "version")?
  if (version != "1.1") {
    fail newError("partitions.json: version ${version}, the generator reads 1.1")
  }
  let rows = needArray(needKey(j, "partitions", "partitions.json")?, "partitions")?
  let s = Builder()
  s.write("// Code generated by tools/gens3 from the AWS partition table; DO NOT EDIT.\n")
  s.write(
    "// Source: ${pinValue(inp.pin, "partitions.repo")?} at commit ${pinValue(
      inp.pin,
      "partitions.commit",
    )?},\n",
  )
  s.write(
    "// ${pinValue(inp.pin, "partitions.path")?} (sha256 ${pinValue(inp.pin, "partitions.sha256")?}).\n",
  )
  s.write("// Regenerate with: bit run tools/gens3 -- endpoint\n\n")
  s.write("// One partition: the regions it names, the pattern the others are matched\n")
  s.write("// against and what `aws.partition` returns for them.\n")
  s.write("class PartitionRow {\n  name: string,\n  regionRegex: string,\n  regions: []string,\n")
  s.write("  dnsSuffix: string,\n  dualStackDnsSuffix: string,\n  implicitGlobalRegion: string,\n")
  s.write("  supportsFIPS: bool,\n  supportsDualStack: bool,\n}\n\n")
  s.write("// The partitions in the order partitions.json lists them.\n")
  let calls = []string(0)
  let n = 0
  for p of rows {
    s.write(epPartitionRow(p, n)?)
    calls = append(calls, "partitionRow${n}()")
    n = n + 1
  }
  s.write("fn partitionRows(): []PartitionRow {\n  return [\n${epIndentLines(calls, "    ")}  ]\n}\n")
  return GenFile{ name = epPartitionsName, text = s.toString() }
}

// `gen_endpoint_cases.bit`: every test case as one compact JSON object.
fn epRenderCases(inp: EpInputs, cases: []Json): GenFile! {
  let s = Builder()
  s.write(epHeader(inp.pin, "endpoint-tests.json", pinValue(inp.pin, "endpoint-tests.sha256")?)?)
  s.write("// The endpoint tests of the S3 model (smithy.rules#endpointTests), one JSON\n")
  s.write("// object a row: documentation, params, expect and operationInputs as the\n")
  s.write("// model has them.\n")
  s.write("const endpointCaseRows: []string = [\n")
  for c of cases {
    s.write("  ${epStringLit(jsonEncode(c), "test case")?},\n")
  }
  s.write("]\n")
  return GenFile{ name = epCasesName, text = s.toString() }
}

fn epFileName(kind: string, n: int): string {
  if (n < 10) {
    return "${epFilePrefix}_${kind}_0${n}.bit"
  }
  return "${epFilePrefix}_${kind}_${n}.bit"
}

fn epFinishFile(kind: string, n: int, head: string, blocks: []string): GenFile {
  let b = Builder()
  b.write(head)
  let uses = false
  for blk of blocks {
    uses = uses || contains(blk, "split(")
  }
  if (uses) {
    b.write("import { split } from \"std/strings\"\n\n")
  }
  let i = 0
  while (i < len(blocks)) {
    b.write(blocks[i])
    if (i + 1 < len(blocks)) {
      b.write("\n")
    }
    i = i + 1
  }
  return GenFile{ name = epFileName(kind, n), text = b.toString() }
}

// `blocks` filled greedily into `gen_endpoint_<kind>_NN.bit` files under the cap.
fn epPack(kind: string, head: string, blocks: []string): []GenFile {
  let files = []GenFile(0)
  let cur = []string(0)
  let lines = 0
  for block of blocks {
    let n = countLines(block) + 1
    if (len(cur) > 0 && lines + n > epMaxBlockLines) {
      files = append(files, epFinishFile(kind, len(files) + 1, head, cur))
      cur = []string(0)
      lines = 0
    }
    cur = append(cur, block)
    lines = lines + n
  }
  if (len(cur) > 0) {
    files = append(files, epFinishFile(kind, len(files) + 1, head, cur))
  }
  return files
}

fn epCondBlocks(sc: EpScope, b: EpBdd): []string! {
  let out = []string(0)
  let i = 0
  for c of b.conditions {
    out = append(out, epCondFn(sc, c, i)?)
    i = i + 1
  }
  let leaves = EpLeaves{
    root = "endpointCondAt",
    leaf = "endpointCond",
    first = 0,
    count = len(b.conditions),
    ret = "bool",
    ask = "",
  }
  for f of epDispatchTree(leaves) {
    out = append(out, f)
  }
  return out
}

fn epResultBlocks(sc: EpScope, b: EpBdd): []string! {
  let out = []string(0)
  let k = 1
  for r of b.results {
    out = append(out, epResultFn(sc, r, k)?)
    k = k + 1
  }
  let leaves = EpLeaves{
    root = "endpointResultAt",
    leaf = "endpointResult",
    first = 1,
    count = len(b.results),
    ret = "EndpointResult!",
    ask = "?",
  }
  for f of epDispatchTree(leaves) {
    out = append(out, f)
  }
  return out
}

// `gen_endpoint.bit`: parameters, state, node table and the walk.
fn epRenderWalk(inp: EpInputs, b: EpBdd, vars: []EpVar): GenFile! {
  let s = Builder()
  s.write(epHeader(inp.pin, "endpoint-bdd.json", pinValue(inp.pin, "endpoint-bdd.sha256")?)?)
  s.write(epParamsClass(b))
  s.write("\n")
  s.write(epDefaultParams(b))
  s.write("\n")
  s.write(epStateClass(vars))
  s.write("\n")
  s.write(epNodesConst(b))
  s.write("\n")
  s.write(epWalker())
  return GenFile{ name = epWalkName, text = s.toString() }
}

// Every generated file for the vendored inputs, and what they hold.
fn epRender(inp: EpInputs): []GenFile! {
  let b = epLoadBdd(inp.bdd)?
  let cases = epCases(inp.tests)?
  let sc = EpScope{ params = b.params, vars = []EpVar(0) }
  let vars = epVarsOf(sc, b.conditions)?
  let full = EpScope{ params = b.params, vars = vars }
  let head = epHeader(inp.pin, "endpoint-bdd.json", pinValue(inp.pin, "endpoint-bdd.sha256")?)?
  let files = []GenFile(0)
  files = append(files, epRenderWalk(inp, b, vars)?)
  for f of epPack("conds", head, epCondBlocks(full, b)?) {
    files = append(files, f)
  }
  for f of epPack("results", head, epResultBlocks(full, b)?) {
    files = append(files, f)
  }
  files = append(files, epRenderCases(inp, cases)?)
  files = append(files, epRenderPartitions(inp)?)
  files = append(files, epRenderOperations(loadModel(inp.model)?, inp.pin)?)
  return files
}

// Whether `name` is a generated endpoint file that `files` no longer has.
fn epIsStale(name: string, files: []GenFile): bool {
  if (!hasPrefix(name, epFilePrefix) || !hasSuffix(name, ".bit") || hasSuffix(name, ".test.bit")) {
    return false
  }
  for f of files {
    if (f.name == name) {
      return false
    }
  }
  return true
}

fn epWrite(dir: string, files: []GenFile): ()! {
  for f of files {
    writeFile(join(dir, f.name), f.text)?
  }
  for name of readDir(dir)? {
    if (epIsStale(name, files)) {
      remove(join(dir, name))?
    }
  }
}

fn endpointMain(a: []string) {
  if (len(a) > 2) {
    eprint("usage: gens3 endpoint [out-dir]\n")
    exit(2)
    return
  }
  let out = defaultShapesOut
  if (len(a) == 2) {
    out = a[1]
  }
  let files = epRenderVendored() catch e {
    eprint("gens3 endpoint: ${e.message()}\n")
    exit(1)
    return
  }
  epWrite(out, files) catch e {
    eprint("gens3 endpoint: ${e.message()}\n")
    exit(1)
    return
  }
  eprint("gens3 endpoint: ${len(files)} files\n")
}

fn epRenderVendored(): []GenFile! {
  return epRender(epReadInputs()?)?
}
