// tools/gens3 — the checksum half of the shapes output (#6619, epic #6565):
// `pkg/s3/gen_checksum_ops.bit`, the table of the operations that carry the
// `aws.protocols#httpChecksum` trait and what each does with it. `shapes`
// writes it beside the `gen_shapes_NN.bit` files; run:
//
//   bit run tools/gens3 -- shapes [out-dir]
//
// One row an operation of the model that has the trait, `Name|flags`, in model
// order. A: the operation takes a `ChecksumAlgorithm` and so can carry a request
// checksum. R: that checksum is required (`requestChecksumRequired`). V: the
// operation takes a `ChecksumMode` and so validates a response checksum. The
// member names are closed: a model that points the trait at another member is
// an error naming the operation, never a row the runtime reads wrongly.

import { Builder } from "std/strings"

const checksumOpsName: string = "gen_checksum_ops.bit"

// The members the trait names, which the runtime hard-wires.
const algorithmMember: string = "ChecksumAlgorithm"
const modeMember: string = "ChecksumMode"

// The flags of one operation's trait, in the order A, R, V.
fn checksumFlags(op: Operation): string! {
  let c = op.checksum
  let flags = ""
  if (c.requestAlgorithmMember != "") {
    if (c.requestAlgorithmMember != algorithmMember) {
      fail newError("${op.name}: requestAlgorithmMember ${c.requestAlgorithmMember}, the generator reads ${algorithmMember}")
    }
    flags = flags + "A"
  }
  if (c.requestChecksumRequired) {
    if (c.requestAlgorithmMember == "") {
      fail newError("${op.name}: requestChecksumRequired without a requestAlgorithmMember")
    }
    flags = flags + "R"
  }
  if (c.requestValidationModeMember != "") {
    if (c.requestValidationModeMember != modeMember) {
      fail newError("${op.name}: requestValidationModeMember ${c.requestValidationModeMember}, the generator reads ${modeMember}")
    }
    flags = flags + "V"
  }
  return flags
}

// The rows, one an operation with the trait, in model order.
fn checksumRows(m: Model): []string! {
  let rows = []string(0)
  for op of m.operations {
    if (op.checksum.present) {
      rows = append(rows, "${op.name}|${checksumFlags(op)?}")
    }
  }
  return rows
}

// `gen_checksum_ops.bit`: the httpChecksum table of the vendored model.
fn renderChecksumOps(m: Model, commit: string, sha: string): GenFile! {
  let rows = checksumRows(m)?
  let s = Builder()
  s.write(headerLines("shapes", commit, sha))
  s.write("\n")
  s.write("// Every operation of the model with the httpChecksum trait, as `Name|flags`.\n")
  s.write("// A: the operation takes a ChecksumAlgorithm, so it can carry a request\n")
  s.write("// checksum. R: that checksum is required. V: the operation takes a\n")
  s.write("// ChecksumMode, so it validates a response checksum.\n")
  s.write("const checksumOperations: []string = [\n")
  for r of rows {
    s.write("  \"${r}\",\n")
  }
  s.write("]\n")
  return GenFile{ name = checksumOpsName, text = s.toString() }
}
