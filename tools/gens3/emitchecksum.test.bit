// tools/gens3/emitchecksum.test.bit — #6619. The httpChecksum table
// (`gen_checksum_ops.bit`) against the vendored model: one row for each of the
// 33 operations that carry the trait (counts re-derived from the loaded model,
// "N of N"), the flags the model sets, the pin in the header, byte-identical
// renders, and the failure paths on small fixtures.
//
// Run from the repo root: bit test tools/gens3

import { split } from "std/strings"

fn checksumFile(m: Model): GenFile {
  return renderChecksumOps(m, testCommit, testSha) catch e {
    panic("renderChecksumOps: ${e.message()}")
  }
}

// The text of `src` with `trait` spliced in as the operation's httpChecksum.
fn withChecksum(json: string): string {
  let src = miniIn("{\"target\":\"a#T\"}")
  return replace(
    src,
    "\"smithy.api#http\":",
    "\"aws.protocols#httpChecksum\":${json},\"smithy.api#http\":",
  )
}

fn rowsOf(f: GenFile): []string {
  let rows = []string(0)
  for line of split(f.text, "\n") {
    if (hasPrefix(line, "  \"")) {
      rows = append(rows, line)
    }
  }
  return rows
}

fn rowsWithFlag(rows: []string, flag: string): int {
  let n = 0
  for r of rows {
    if (contains(r, "|") && contains(split(r, "|")[1], flag)) {
      n = n + 1
    }
  }
  return n
}

test "every operation with the httpChecksum trait has a row" {
  let m = loadedModel()
  let want = 0
  for op of m.operations {
    if (op.checksum.present) {
      want = want + 1
    }
  }
  let rows = rowsOf(checksumFile(m))
  assert(want == 33, "operations with the trait: ${want}, want 33")
  assert(len(rows) == want, "rows ${len(rows)} of ${want}")
  println("checksum rows: ${len(rows)} of ${want}")
}

test "the flags are the ones the model sets" {
  let m = loadedModel()
  let rows = rowsOf(checksumFile(m))
  let a = 0
  let r = 0
  let v = 0
  for op of m.operations {
    if (op.checksum.requestAlgorithmMember != "") {
      a = a + 1
    }
    if (op.checksum.requestChecksumRequired) {
      r = r + 1
    }
    if (op.checksum.requestValidationModeMember != "") {
      v = v + 1
    }
  }
  assert(rowsWithFlag(rows, "A") == a, "A rows ${rowsWithFlag(rows, "A")} of ${a}")
  assert(rowsWithFlag(rows, "R") == r, "R rows ${rowsWithFlag(rows, "R")} of ${r}")
  assert(rowsWithFlag(rows, "V") == v, "V rows ${rowsWithFlag(rows, "V")} of ${v}")
  assert(a == 31 && r == 25 && v == 2, "A ${a} R ${r} V ${v}, want 31 25 2")
}

test "the file is headed with the pin and renders byte-identically" {
  let m = loadedModel()
  let f = checksumFile(m)
  assert(f.name == "gen_checksum_ops.bit", "named ${f.name}")
  assert(contains(f.text, "api-models-aws at commit ${testCommit}"), "no commit")
  assert(contains(f.text, "sha256 ${testSha}"), "no model hash")
  assert(contains(f.text, "const checksumOperations: []string = ["), "no table")
  assert(f.text == checksumFile(m).text, "two renders differ")
}

test "a trait that names another member is an error naming the operation" {
  let bad = loadModel(withChecksum("{\"requestAlgorithmMember\":\"Other\"}")) catch e {
    panic("fixture: ${e.message()}")
  }
  let _ = renderChecksumOps(bad, testCommit, testSha) catch e {
    assert(contains(e.message(), "Op: requestAlgorithmMember Other"), "error ${e.message()}")
    return
  }
  panic("renderChecksumOps accepted a trait on another member")
}

test "a required checksum without an algorithm member is an error" {
  let bad = loadModel(withChecksum("{\"requestChecksumRequired\":true}")) catch e {
    panic("fixture: ${e.message()}")
  }
  let _ = renderChecksumOps(bad, testCommit, testSha) catch e {
    assert(contains(e.message(), "requestChecksumRequired without"), "error ${e.message()}")
    return
  }
  panic("renderChecksumOps accepted a required checksum without a member")
}
