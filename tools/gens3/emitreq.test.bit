// tools/gens3/emitreq.test.bit — #6620. The request emitter against the
// vendored model: every operation has its serializer ("112 of 112"), every enum
// a header or the query writes has its wire writer, every file stays under the
// 800-line ceiling, two renders are byte-identical, and the checked-in
// pkg/s3/gen_req_*.bit files are what the generator renders now (the freshness
// check). Then the spellings the design fixes, the failure paths on small
// fixtures, and the restXml request vectors: the filter's N of N, one
// generated test per vector, and the checked-in gen_reqvec.test.bit being what
// the generator renders now. The behaviour of the emitted code is
// pkg/s3/request.test.bit and the vectors in pkg/s3/gen_reqvec.test.bit.
//
// Run from the repo root: bit test tools/gens3

const reqVectorCommit: string = "bd0ed9e054b29874a5bec389e16d8c4db9dc9b94"
const checkedInReqVectors: string = "pkg/s3/gen_reqvec.test.bit"

fn renderedReq(m: Model): []GenFile {
  return renderReq(m, testCommit, testSha) catch e {
    panic("renderReq: ${e.message()}")
  }
}

fn expectReqError(m: Model, want: string) {
  let _ = renderReq(m, testCommit, testSha) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("renderReq accepted the model, want an error containing ${want}")
}

// A model whose one operation takes `a#In` with the members `members`, has the
// URI `uri` and the further shapes `extra` (each shape a `"a#X":{...}` entry,
// comma-led).
fn reqMini(members: string, extra: string, uri: string): Model {
  let src = "{\"smithy\":\"2.0\",\"shapes\":{" +
    "\"a#Svc\":{\"type\":\"service\",\"version\":\"1\",\"operations\":[{\"target\":\"a#Op\"}],\"traits\":{}}," +
    "\"a#Op\":{\"type\":\"operation\",\"input\":{\"target\":\"a#In\"},\"output\":{\"target\":\"smithy.api#Unit\"},\"traits\":{\"smithy.api#http\":{\"method\":\"PUT\",\"uri\":\"" +
    uri +
    "\"}}}," +
    "\"a#In\":{\"type\":\"structure\",\"members\":{" +
    members +
    "},\"traits\":{}},\"a#T\":{\"type\":\"string\"}" +
    extra +
    "}}"
  return loadModel(src) catch e {
    panic("loadModel: ${e.message()}")
  }
}

fn labelOf(name: string): string {
  return "\"" +
    name +
    "\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpLabel\":{},\"smithy.api#required\":{}}}"
}

fn reqFile(files: []GenFile, name: string): string {
  for f of files {
    if (f.name == name) {
      return f.text
    }
  }
  panic("no generated file ${name}")
}

test "every operation has its serializer: N of N" {
  let m = loadedModel()
  let text = allText(renderedReq(m))
  let serializers = textCount(text, "\nfn serialize")
  assert(serializers == len(m.operations), "serializers ${serializers} of ${len(m.operations)}")
  assert(serializers == 112, "operations: ${serializers} of 112")
  let xml = textCount(text, "\n// body: xml")
  let streams = textCount(text, "\n// body: stream")
  let texts = textCount(text, "\n// body: text")
  println("request emitter: ${serializers} of 112 operations, ${xml} with an XML body left to #6621, ${streams} streaming, ${texts} string payload")
}

fn shapeOrEmpty(m: Model, id: string): Shape {
  return unwrapOr(findShape(m, id), Shape{})
}

// Whether some operation's input has a header or query member of shape `id`,
// or a list of it.
fn isWrittenByAnInput(m: Model, id: string): bool {
  for op of m.operations {
    for mem of shapeOrEmpty(m, op.input).members {
      let list = shapeOrEmpty(m, mem.target)
      let elem = ""
      if (list.kind == ShapeKind.List) {
        elem = list.members[0].target
      }
      if ((mem.header != "" || mem.query != "") && (mem.target == id || elem == id)) {
        return true
      }
    }
  }
  return false
}

test "every enum an input writes to a header or the query has its wire writer" {
  let m = loadedModel()
  let text = allText(renderedReq(m))
  let wanted = 0
  for s of m.shapes {
    if (s.kind == ShapeKind.Enum && isWrittenByAnInput(m, s.id)) {
      wanted = wanted + 1
      assert(contains(text, "\nfn wire${shortName(s.id)}("), "no wire writer for ${s.id}")
    }
  }
  assert(wanted == 23, "enums written: ${wanted} of 23")
  assert(textCount(text, "\n// com.amazonaws.s3#") >= wanted, "enum blocks")
  assert(!contains(text, "\nfn wireArchiveStatus("), "an enum only an output carries has no writer")
}

test "request files are numbered from 01, under 800 lines, headed with the pin" {
  let files = renderedReq(loadedModel())
  assert(len(files) == 5, "files: ${len(files)} of 5")
  for f of files {
    assert(
      hasPrefix(f.name, "gen_req_enums_0") || hasPrefix(f.name, "gen_req_ops_0"),
      "name ${f.name}",
    )
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    assert(contains(f.text, testCommit), "${f.name} does not name the model commit")
    assert(contains(f.text, "bit run tools/gens3 -- req\n"), "${f.name} does not name its command")
  }
}

test "two renders are byte-identical" {
  let m = loadedModel()
  let a = renderedReq(m)
  let b = renderedReq(m)
  assert(len(a) == len(b), "file counts differ")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == b[i].name && a[i].text == b[i].text, "${a[i].name} differs between renders")
    i = i + 1
  }
}

test "the checked-in gen_req files are what the generator renders now" {
  let files = renderedReq(loadedModel())
  for f of files {
    let disk = readFile(join("pkg/s3", f.name)) catch e {
      panic("read ${f.name}: ${e.message()}")
    }
    assert(disk == f.text, "${f.name} is stale, regenerate with: bit run tools/gens3 -- req")
  }
  let onDisk = 0
  for name of readDir("pkg/s3") catch e {
    panic("readDir pkg/s3: ${e.message()}")
  } {
    if (hasPrefix(name, "gen_req_") && !hasSuffix(name, ".test.bit")) {
      onDisk = onDisk + 1
    }
  }
  assert(
    onDisk == len(files),
    "pkg/s3 holds ${onDisk} gen_req files, the generator renders ${len(files)}",
  )
}

test "PutObject: greedy key, literal x-id, user metadata, Expires date, streaming body" {
  let text = allText(renderedReq(loadedModel()))
  let at = indexOfFrom(text, "// com.amazonaws.s3#PutObjectRequest: ", 0)
  assert(at >= 0, "no PutObject block")
  let end = indexOfFrom(text, "\n// com.amazonaws.s3#", at + 10)
  let body = text[at:end]
  assert(contains(body, "  let req = requestHead(\"PUT\")\n"), "method")
  assert(contains(body, "  pathLabel(req, \"Bucket\", input.bucket)?\n"), "bucket label")
  assert(contains(body, "  pathGreedy(req, \"Key\", input.key)?\n"), "greedy key")
  assert(contains(body, "  queryLiteral(req, \"x-id\", \"PutObject\")\n"), "literal query")
  assert(
    contains(body, "  addPrefixHeaders(req, \"x-amz-meta-\", input.metadata)?\n"),
    "user metadata prefix",
  )
  assert(
    contains(body, "  addHeaderTime(req, \"expires\", input.expires, httpDateText)?\n"),
    "Expires as an HTTP-date",
  )
  assert(
    contains(
      body,
      "  addHeaderEnum(req, \"x-amz-storage-class\", input.storageClass, wireStorageClass)?\n",
    ),
    "storage class by wire value",
  )
  assert(
    contains(text, "  setBody(req, Option.Some(input.body), \"\")?\n"),
    "PutObject body, its own Content-Type member",
  )
  assert(
    contains(text, "  setBody(req, Option.Some(input.body), \"application/octet-stream\")?\n"),
    "UploadPart body, the blob default Content-Type",
  )
  assert(
      contains(text, "  setTextBody(req, input.policy, \"text/plain\")?\n") ||
      contains(text, "  setTextBody(req, Option.Some(input.policy), \"text/plain\")?\n"),
    "the string payload",
  )
}

test "WriteGetObjectResponse: the host prefix label, the forwarded Expires; RenameObject: the token" {
  let text = allText(renderedReq(loadedModel()))
  assert(contains(text, "  hostLabel(req, \"RequestRoute\", input.requestRoute)?\n"), "host label")
  assert(contains(text, "  hostLiteral(req, \".\")\n"), "host literal")
  assert(
      contains(
        text,
        "  addHeaderTime(\n    req,\n    \"x-amz-fwd-header-expires\",\n    input.expires,\n    httpDateText,\n  )?\n",
      ) ||
      contains(
        text,
        "  addHeaderTime(req, \"x-amz-fwd-header-expires\", input.expires, httpDateText)?\n",
      ),
    "forwarded Expires as an HTTP-date",
  )
  assert(
    contains(text, "  addHeaderToken(req, \"x-amz-client-token\", input.clientToken)?\n"),
    "token",
  )
}

test "a long enum is written by chained functions, each under the complexity ceiling" {
  let text = allText(renderedReq(loadedModel()))
  assert(contains(text, "\nfn wireStorageClass2(e: StorageClass): string {"), "second function")
  assert(contains(text, "\nfn wireStorageClass3(e: StorageClass): string {"), "third function")
  assert(contains(text, "    _ => wireStorageClass2(e)\n"), "hand-over")
  assert(contains(text, "    _ => unreachableWire(\"StorageClass\")\n"), "catch-all of the last")
  assert(!contains(text, "\nfn wireRequestPayer2("), "a short enum is one function")
}

test "a label the URI does not name, a label that is not a required string, an unknown template name are errors" {
  expectReqError(reqMini(labelOf("A"), "", "/x"), "an httpLabel the URI does not name")
  expectReqError(reqMini("", "", "/{B}"), "the template names a member the input does not have")
  expectReqError(
    reqMini("\"A\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpLabel\":{}}}", "", "/{A}"),
    "a label must be a required string",
  )
  expectReqError(reqMini("", "", "/{A"), "has an unclosed {")
}

test "a list in the query, a list of strings in a header, a map that is not prefix headers, a bound default are errors" {
  expectReqError(
    reqMini(
      "\"Q\":{\"target\":\"a#L\",\"traits\":{\"smithy.api#httpQuery\":\"q\"}}",
      ",\"a#L\":{\"type\":\"list\",\"member\":{\"target\":\"a#T\"}}",
      "/",
    ),
    "a list is written only as an enum list header",
  )
  expectReqError(
    reqMini(
      "\"H\":{\"target\":\"a#L\",\"traits\":{\"smithy.api#httpHeader\":\"x-h\"}}",
      ",\"a#L\":{\"type\":\"list\",\"member\":{\"target\":\"a#T\"}}",
      "/",
    ),
    "a list is written only as an enum list header",
  )
  expectReqError(
    reqMini(
      "\"M\":{\"target\":\"a#M\",\"traits\":{\"smithy.api#httpHeader\":\"x-m\"}}",
      ",\"a#M\":{\"type\":\"map\",\"key\":{\"target\":\"a#T\"},\"value\":{\"target\":\"a#T\"}}",
      "/",
    ),
    "a map is written only as prefix headers",
  )
  expectReqError(
    reqMini(
      "\"D\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpHeader\":\"x-d\",\"smithy.api#default\":\"\"}}",
      "",
      "/",
    ),
    "a bound member with a default is not one the generator writes",
  )
  expectReqError(
    reqMini(
      "\"B\":{\"target\":\"a#B\",\"traits\":{\"smithy.api#httpHeader\":\"x-b\"}}",
      ",\"a#B\":{\"type\":\"blob\"}",
      "/",
    ),
    "a header or query of this kind is not one the generator writes",
  )
}

test "a hostLabel the endpoint trait does not name is an error, an unlabelled operation emits none" {
  let m = reqMini(
    "\"H\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#hostLabel\":{},\"smithy.api#required\":{},\"smithy.api#httpHeader\":\"x-h\"}}",
    "",
    "/",
  )
  expectReqError(m, "a hostLabel the host prefix does not name")
}

test "timestamps: header HTTP-date, query and label date-time, a member or target format wins" {
  let m = reqMini(
      "\"H\":{\"target\":\"a#S\",\"traits\":{\"smithy.api#httpHeader\":\"x-h\"}}," +
      "\"Q\":{\"target\":\"a#S\",\"traits\":{\"smithy.api#httpQuery\":\"q\"}}," +
      "\"E\":{\"target\":\"a#S\",\"traits\":{\"smithy.api#httpQuery\":\"e\",\"smithy.api#timestampFormat\":\"epoch-seconds\"}}," +
      "\"D\":{\"target\":\"a#D\",\"traits\":{\"smithy.api#httpHeader\":\"x-d\"}}",
    ",\"a#S\":{\"type\":\"timestamp\"},\"a#D\":{\"type\":\"timestamp\",\"traits\":{\"smithy.api#timestampFormat\":\"date-time\"}}",
    "/",
  )
  let text = allText(renderedReq(m))
  assert(
    contains(text, "  addHeaderTime(req, \"x-h\", input.h, httpDateText)?\n"),
    "header default",
  )
  assert(contains(text, "  addQueryTime(req, \"q\", input.q, dateTimeText)\n"), "query default")
  assert(contains(text, "  addQueryTime(req, \"e\", input.e, epochSecondsText)\n"), "member format")
  assert(contains(text, "  addHeaderTime(req, \"x-d\", input.d, dateTimeText)?\n"), "target format")
}

fn reqVectorText(): string {
  return readFile(reqVecFile) catch e {
    panic("read ${reqVecFile}: ${e.message()}")
  }
}

fn renderedReqVectors(): GenFile {
  return renderReqVectors(reqVectorText(), testCommit, testSha) catch e {
    panic("renderReqVectors: ${e.message()}")
  }
}

fn reqVectorRoot(): Json {
  return jsonParse(reqVectorText()) catch e {
    panic("parse ${reqVecFile}: ${e.message()}")
  }
}

test "restXml request vectors: the filter keeps 27 of 60 request tests, every other is excluded with a reason" {
  let root = reqVectorRoot()
  let cases = arrayLen(root, "cases")
  let excluded = arrayLen(root, "excluded")
  let total = needInt(
    needKey(root, "total", "vectors") catch e {
      panic(e.message())
    },
    "total",
  ) catch e {
    panic(e.message())
  }
  assert(total == 60, "request tests in the nine files: ${total} of 60")
  assert(cases == 27, "applicable: ${cases} of 27")
  assert(cases + excluded == total, "applicable ${cases} + excluded ${excluded} != ${total}")
  assert(
    contains(reqVectorText(), reqVectorCommit),
    "the vectors do not name the pinned smithy commit",
  )
  let filter = needString(
    needKey(root, "filter", "vectors") catch e {
      panic(e.message())
    },
    "filter",
  ) catch e {
    panic(e.message())
  }
  println("restXml request vectors at smithy ${reqVectorCommit}: ${cases} of ${total} apply, ${excluded} excluded")
  println("filter: ${filter}")
}

test "every excluded request test names its reason and every case its dropped members" {
  let root = reqVectorRoot()
  for e of needArray(
    needKey(root, "excluded", "vectors") catch err {
      panic(err.message())
    },
    "excluded",
  ) catch err {
    panic(err.message())
  } {
    let reason = needString(
      needKey(e, "reason", "excluded") catch err {
        panic(err.message())
      },
      "reason",
    ) catch err {
      panic(err.message())
    }
    assert(len(reason) > 10, "an excluded test has no reason")
  }
}

test "every request vector becomes one generated test: N of N" {
  let text = renderedReqVectors().text
  let n = textCount(text, "\ntest \"restXml request vector ")
  assert(n == 27, "tests: ${n} of 27")
  assert(contains(text, "restXml request vector 27 of 27: EmptyInputAndEmptyOutput"), "last vector")
  assert(
    contains(text, "\"/HttpRequestWithLabels/%20%25%3A%2F"),
    "the escaping vector is there",
  )
  assert(contains(text, "map<string, string>{ \"abc\""), "a vector builds a map")
}

test "the checked-in gen_reqvec.test.bit is what the generator renders now" {
  let disk = readFile(checkedInReqVectors) catch e {
    panic("read ${checkedInReqVectors}: ${e.message()}")
  }
  assert(
    disk == renderedReqVectors().text,
    "${checkedInReqVectors} is stale, regenerate with: bit run tools/gens3 -- reqvec",
  )
}
