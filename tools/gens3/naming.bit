// tools/gens3 — how Smithy names become Bit names (#6614, epic #6565).
//
// Smithy member names are PascalCase (`ContentMD5`, `SSEKMSKeyId`); Bit fields
// are lower camel case. The leading run of capitals is lowered, keeping the
// last capital of the run when a lower-case letter follows it, so the word
// that starts the next part survives: `SSEKMSKeyId` -> `ssekmsKeyId`, `ETag`
// -> `eTag`, `ID` -> `id`, `ContentMD5` -> `contentMD5`. A name that comes out
// as a Bit keyword (`Type` -> `type`) gets a trailing underscore: `type_`.
//
// Smithy enum values come in three spellings (`STANDARD_IA`, `af_south_1`,
// `Enabled`). A variant is the PascalCase of its words: split at `_`, upper the
// first letter of each word, and lower the rest of a word that is all capitals
// (`STANDARD_IA` -> `StandardIa`, `af_south_1` -> `AfSouth1`, `Enabled` stays).

import { Builder, split } from "std/strings"

fn isUpperByte(c: byte): bool {
  return c >= 'A' && c <= 'Z'
}

fn isLowerByte(c: byte): bool {
  return c >= 'a' && c <= 'z'
}

fn isDigitByte(c: byte): bool {
  return c >= '0' && c <= '9'
}

fn lowerByte(c: byte): byte {
  if (isUpperByte(c)) {
    return c + 32
  }
  return c
}

fn upperByte(c: byte): byte {
  if (isLowerByte(c)) {
    return c - 32
  }
  return c
}

// The words Bit reserves (spec/SPEC.md section 5.2); a field cannot take one.
fn isBitKeyword(s: string): bool {
  for k of [
    "as", "asm", "break", "case", "catch", "chan", "class", "const", "continue",
    "default", "defer", "else", "enum", "export", "fail", "false", "fn", "for",
    "if", "import", "in", "interface", "let", "map", "match", "nil", "of",
    "return", "select", "spawn", "switch", "this", "trait", "true", "type", "while",
  ] {
    if (k == s) {
      return true
    }
  }
  return false
}

// How many leading bytes of `name` to lower: the whole leading capital run,
// less its last capital when a lower-case letter follows (the next word's
// initial), and all of it when the name is nothing but capitals.
fn lowerPrefixLen(name: string): int {
  let run = 0
  while (run < len(name) && isUpperByte(name[run])) {
    run = run + 1
  }
  if (run == len(name) || run <= 1) {
    return run
  }
  if (isLowerByte(name[run])) {
    return run - 1
  }
  return run
}

// `ContentMD5` -> `contentMD5`; no keyword handling (see `fieldName`).
fn lowerCamel(name: string): string {
  let b = Builder()
  let n = lowerPrefixLen(name)
  let i = 0
  while (i < len(name)) {
    if (i < n) {
      b.writeByte(lowerByte(name[i]))
    } else {
      b.writeByte(name[i])
    }
    i = i + 1
  }
  return b.toString()
}

// The Bit field for Smithy member `name`.
fn fieldName(name: string): string {
  let f = lowerCamel(name)
  if (isBitKeyword(f)) {
    return f + "_"
  }
  return f
}

fn isAllCapsWord(w: string): bool {
  let i = 0
  while (i < len(w)) {
    if (isLowerByte(w[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn pascalWord(w: string): string {
  let b = Builder()
  let caps = isAllCapsWord(w)
  let i = 0
  while (i < len(w)) {
    if (i == 0) {
      b.writeByte(upperByte(w[i]))
    } else if (caps) {
      b.writeByte(lowerByte(w[i]))
    } else {
      b.writeByte(w[i])
    }
    i = i + 1
  }
  return b.toString()
}

// The variant name for enum value or union member `name`; an error when the
// result is not an identifier, so a new spelling in a model bump stops here.
fn variantName(name: string): string! {
  let b = Builder()
  for w of split(name, "_") {
    b.write(pascalWord(w))
  }
  let v = b.toString()
  if (len(v) == 0 || isDigitByte(v[0])) {
    fail newError("enum value \"${name}\" does not make a Bit variant name (\"${v}\")")
  }
  let i = 0
  while (i < len(v)) {
    let c = v[i]
    if (!isUpperByte(c) && !isLowerByte(c) && !isDigitByte(c)) {
      fail newError("enum value \"${name}\" has a character a variant name cannot hold")
    }
    i = i + 1
  }
  return v
}
