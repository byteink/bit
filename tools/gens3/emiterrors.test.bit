// tools/gens3/emiterrors.test.bit — #6615. The error-table emitter against the
// vendored model and tools/gens3/unmodeled.txt: the 21 modeled error shapes
// all have a kind and a row ("21 of 21"), every code of the S3 API reference's
// "List of error codes" table maps to a kind ("N of N"), the retry classes
// follow the SDK's rules, two renders are byte-identical, and the checked-in
// pkg/s3/gen_errors.bit is what the generator renders now (the freshness
// check: edit the model, the pin or unmodeled.txt without regenerating and this
// goes red). Then the failure paths on small fixtures. The runtime behaviour of
// the emitted file is pkg/s3/gen_errors.test.bit.
//
// Run from the repo root: bit test tools/gens3

import { readFile } from "std/fs"

// The reference table, re-derived from the pinned page named in unmodeled.txt:
// The base table has 134 rows and 132 codes; included tables add 121 codes.
// Eight reference codes are error shapes of the model.
const referenceRows: int = 134
const referenceCodes: int = 253
const referenceModeled: []string = [
  "AccessDenied",
  "BucketAlreadyExists",
  "BucketAlreadyOwnedByYou",
  "InvalidObjectState",
  "InvalidRequest",
  "NoSuchBucket",
  "NoSuchKey",
  "NoSuchUpload",
]
const checkedInErrors: []string = ["gen_errors.bit", "gen_errors_data.bit"]

fn unmodeledText(): string {
  return readFile(unmodeledFile) catch e {
    panic("read ${unmodeledFile}: ${e.message()}")
  }
}

fn renderedErrorFiles(m: Model, unmodeled: string): []GenFile {
  return renderErrors(m, unmodeled, testCommit, testSha) catch e {
    panic("renderErrors: ${e.message()}")
  }
}

fn renderedErrors(m: Model, unmodeled: string): GenFile {
  let files = renderedErrorFiles(m, unmodeled)
  return GenFile{ name = files[0].name, text = files[0].text + files[1].text }
}

fn wireRowsOf(m: Model, unmodeled: string): []ErrRow {
  return wireRows(m, unmodeled) catch e {
    panic("wireRows: ${e.message()}")
  }
}

fn rowOf(rows: []ErrRow, code: string): ErrRow {
  for r of rows {
    if (r.code == code) {
      return r
    }
  }
  panic("no row for ${code}")
}

// Whether the rendered table has a row for `code`, written on one line or wrapped.
fn hasTableRow(text: string, code: string): bool {
  return contains(text, "\n  ErrorInfo(\"${code}\", ErrorKind.") ||
    contains(text, "\n  ErrorInfo(\n    \"${code}\",\n    ErrorKind.")
}

fn expectErrorsError(m: Model, unmodeled: string, want: string) {
  let _ = renderErrors(m, unmodeled, testCommit, testSha) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("renderErrors accepted the input, want an error containing ${want}")
}

fn tinyModel(): Model {
  return miniLoaded(
      "\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}}," +
      "\"a#Boom\":{\"type\":\"structure\",\"members\":{},\"traits\":{\"smithy.api#error\":\"client\",\"smithy.api#httpError\":418}}",
  )
}

test "the 21 modeled error shapes all have a kind and a row: 21 of 21" {
  let m = loadedModel()
  let text = renderedErrors(m, unmodeledText()).text
  let shapes = 0
  let found = 0
  for s of m.shapes {
    if (s.errorKind != "") {
      shapes = shapes + 1
      let code = shortName(s.id)
      if (hasTableRow(text, code) && contains(text, "\n  ${code},\n")) {
        found = found + 1
      }
    }
  }
  assert(shapes == 21, "error shapes in the model: ${shapes} of 21")
  assert(found == shapes, "modeled errors with a kind and a row: ${found} of ${shapes}")
  println("modeled error shapes with a kind and a row: ${found} of ${shapes}")
}

test "every code of the S3 error reference maps to a kind: N of N" {
  let m = loadedModel()
  let text = unmodeledText()
  let un = unmodeledRows(text) catch e {
    panic("unmodeledRows: ${e.message()}")
  }
  assert(
    contains(text, "The table has ${referenceRows} rows for 132 codes."),
    "unmodeled.txt does not state the base table counts",
  )
  assert(
    len(un) + len(referenceModeled) == referenceCodes,
    "${len(un)} unmodeled + ${len(referenceModeled)} modeled != ${referenceCodes}",
  )
  let rows = wireRowsOf(m, text)
  let out = renderedErrors(m, text).text
  let mapped = 0
  for r of un {
    if (hasTableRow(out, r.code) && contains(out, "\n  ${r.variant},\n")) {
      mapped = mapped + 1
    }
  }
  for code of referenceModeled {
    assert(rowOf(rows, code).modeled, "${code} is in the reference but is not a modeled error")
    if (hasTableRow(out, code)) {
      mapped = mapped + 1
    }
  }
  assert(mapped == referenceCodes, "reference codes mapped: ${mapped} of ${referenceCodes}")
  println("reference codes mapped to a kind: ${mapped} of ${referenceCodes} (${len(un)} unmodeled + ${len(referenceModeled)} modeled)")
}

test "the rows are sorted by code, unique, and the client kinds are not wire rows" {
  let rows = wireRowsOf(loadedModel(), unmodeledText())
  assert(len(rows) == 21 + 245, "wire rows: ${len(rows)} of 266")
  let i = 1
  while (i < len(rows)) {
    assert(rows[i - 1].code < rows[i].code, "${rows[i - 1].code} is not before ${rows[i].code}")
    i = i + 1
  }
  for c of clientRows() {
    assert(c.code == "" && c.status == 0, "client kind ${c.variant} carries a wire code")
  }
}

test "retry classes follow the SDK: throttling, transient 5xx and timeouts, the rest is not retried" {
  let rows = wireRowsOf(loadedModel(), unmodeledText())
  assert(rowOf(rows, "SlowDown").retry == "Throttling", "SlowDown")
  assert(rowOf(rows, "RequestTimeout").retry == "Transient", "RequestTimeout")
  assert(rowOf(rows, "InternalError").retry == "Transient", "InternalError (500)")
  assert(rowOf(rows, "ServiceUnavailable").retry == "Transient", "ServiceUnavailable (503)")
  assert(rowOf(rows, "NotImplemented").retry == "Server", "NotImplemented (501)")
  assert(rowOf(rows, "NoSuchKey").retry == "Client", "NoSuchKey")
  assert(rowOf(rows, "AccessDenied").retry == "Client", "AccessDenied")
  assert(retryClassName("Anything", 429) == "Throttling", "429")
  assert(retryClassName("Anything", 504) == "Transient", "504")
  assert(retryClassName("Anything", 0) == "Client", "no status")
}

test "a code with a dot drops it, a code the model also models is an error" {
  let v = errorVariant("KMS.NotFoundException") catch e {
    panic("errorVariant: ${e.message()}")
  }
  assert(v == "KMSNotFoundException", "dot dropped: ${v}")
  expectErrorsError(tinyModel(), "Boom 400\n", "Boom is listed twice")
}

test "a malformed unmodeled.txt line is an error naming the line" {
  let m = tinyModel()
  expectErrorsError(m, "# c\n\nOne\n", "unmodeled.txt line 3")
  expectErrorsError(m, "One two\n", "status \"two\" is not a number")
  expectErrorsError(m, "One 99\n", "HTTP status 99 out of range")
  expectErrorsError(m, "bad 400\n", "PascalCase")
  expectErrorsError(m, "Bad-Name 400\n", "a variant name cannot hold")
  expectErrorsError(m, "Unknown 400\n", "the variant Unknown is taken")
  expectErrorsError(m, "Timeout 400\n", "the variant Timeout is taken")
  expectErrorsError(m, "Two 400\nTwo 404\n", "Two is listed twice")
  expectErrorsError(m, "Two 400\nTwo 400\n", "Two is listed twice")
}

test "a small model renders its error shape, its status and the unmodeled rows sorted" {
  let f = renderedErrors(tinyModel(), "Zed 503\nAlpha 0\n")
  assert(f.name == "gen_errors.bit", "file name ${f.name}")
  assert(
    contains(f.text, "\n  ErrorInfo(\"Alpha\", ErrorKind.Alpha, 0, RetryClass.Client),\n"),
    "Alpha",
  )
  assert(
    contains(f.text, "\n  ErrorInfo(\"Boom\", ErrorKind.Boom, 418, RetryClass.Client),\n"),
    "Boom",
  )
  assert(
    contains(f.text, "\n  ErrorInfo(\"Zed\", ErrorKind.Zed, 503, RetryClass.Transient),\n"),
    "Zed",
  )
  assert(
      indexOfFrom(f.text, "\"Alpha\"", 0) < indexOfFrom(f.text, "\"Boom\"", 0) &&
      indexOfFrom(f.text, "\"Boom\"", 0) < indexOfFrom(f.text, "\"Zed\"", 0),
    "rows are not sorted by code",
  )
}

test "a row that does not fit 100 columns is wrapped one argument per line, as bit fmt leaves it" {
  let long = "InvalidBucketAclWithObjectOwnership"
  let r = ErrRow{ code = long, variant = long, status = 400, retry = "Client", modeled = false }
  assert(
      tableRow(r) ==
      "  ErrorInfo(\n    \"${long}\",\n    ErrorKind.${long},\n    400,\n    RetryClass.Client,\n  ),\n",
    "wrapped row ${tableRow(r)}",
  )
  let short = ErrRow{
    code = "Short",
    variant = "Short",
    status = 400,
    retry = "Client",
    modeled = false,
  }
  assert(
    tableRow(short) == "  ErrorInfo(\"Short\", ErrorKind.Short, 400, RetryClass.Client),\n",
    "one-line row ${tableRow(short)}",
  )
}

test "both files have the pin, stay under 800 lines, and render identically twice" {
  let m = loadedModel()
  let a = renderedErrorFiles(m, unmodeledText())
  let b = renderedErrorFiles(m, unmodeledText())
  assert(len(a) == 2 && len(b) == 2, "two error files")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == checkedInErrors[i] && a[i].name == b[i].name, "file order")
    assert(a[i].text == b[i].text, "two renders differ: ${a[i].name}")
    assert(countLines(a[i].text) <= 800, "${a[i].name} has ${countLines(a[i].text)} lines")
    assert(
      hasPrefix(
        a[i].text,
        "// Code generated by tools/gens3 from the S3 Smithy model; DO NOT EDIT.\n",
      ),
      "header",
    )
    assert(contains(a[i].text, "api-models-aws at commit ${testCommit}"), "no commit")
    assert(contains(a[i].text, "sha256 ${testSha}"), "no model hash")
    assert(contains(a[i].text, "Regenerate with: bit run tools/gens3 -- errors\n"), "regenerate")
    assert(contains(a[i].text, "tools/gens3/unmodeled.txt (sha256 "), "no input hash")
    i = i + 1
  }
}

test "freshness: both error files match the model and unmodeled.txt" {
  let files = renderedErrorFiles(loadedModel(), unmodeledText())
  assert(len(files) == 2, "two error files")
  for f of files {
    let path = "pkg/s3/${f.name}"
    let have = readFile(path) catch e {
      panic("read ${path}: ${e.message()}")
    }
    assert(have == f.text, "${path} is stale: regenerate with bit run tools/gens3 -- errors")
  }
}

test "error regeneration preserves the handwritten tests" {
  let files = renderedErrorFiles(tinyModel(), "")
  assert(!isStaleFile("gen_errors_", "gen_errors.test.bit", files), "handwritten tests")
  assert(!isStaleFile("gen_errors_", "errors_select.test.bit", files), "SELECT tests")
  assert(isStaleFile("gen_errors_", "gen_errors_old.bit", files), "old generated data")
}

test "every excluded table has its endpoint reason in the source inventory" {
  let text = unmodeledText()
  for reason of [
    "Excluded List of Tagging-related error codes (5 rows):",
    "Excluded List of Amazon S3 Storage Lens error codes (38 rows):",
    "Storage Lens groups (20 rows), also uses s3control.",
    "Excluded List of Amazon S3 asynchronous error codes (10 rows):",
    "DescribeMultiRegionAccessPointOperation (s3control)",
    "Excluded List of Amazon S3 Access Grants error codes (25 rows):",
    "GetDataAccess operations use s3control",
    "Excluded List of Amazon S3 Tables error codes (7 rows):",
    "use the separate s3tables service",
    "NoSuchOutpost (an Outpost control resource)",
    "endpoint eligibility is unresolved",
  ] {
    assert(contains(text, reason), "missing source scope: ${reason}")
  }
}
