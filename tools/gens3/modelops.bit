// tools/gens3 — operation loading for model.bit (#6604): the REST binding
// (`http`), checksum, pagination and waiter traits, the endpoint context
// traits and the S3 customization flags. Every trait value is read with its
// keys checked (`onlyKeys`): a key the generator does not know is an error
// naming the operation, never dropped.

const traitHttp: string = "smithy.api#http"
const traitHttpChecksum: string = "aws.protocols#httpChecksum"
const traitPaginated: string = "smithy.api#paginated"
const traitWaitable: string = "smithy.waiters#waitable"
const traitStaticParams: string = "smithy.rules#staticContextParams"

// `smithy.api#http`: {"method", "uri", "code"}; code defaults to 200 as in
// Smithy.
fn readHttp(op: Operation, v: Json, what: string): ()! {
  onlyKeys(needObject(v, what)?, ["method", "uri", "code"], what)?
  op.method = needNonEmpty(needKey(v, "method", what)?, what)?
  op.uri = needNonEmpty(needKey(v, "uri", what)?, what)?
  op.code = 200
  if (hasKey(v, "code")) {
    op.code = needInt(optKey(v, "code"), what)?
  }
}

fn readChecksum(op: Operation, v: Json, what: string): ()! {
  let keys = [
    "requestAlgorithmMember",
    "requestChecksumRequired",
    "requestValidationModeMember",
    "responseAlgorithms",
  ]
  onlyKeys(needObject(v, what)?, keys, what)?
  let c = HttpChecksum{ present = true }
  if (hasKey(v, "requestAlgorithmMember")) {
    c.requestAlgorithmMember = needNonEmpty(optKey(v, "requestAlgorithmMember"), what)?
  }
  if (hasKey(v, "requestChecksumRequired")) {
    c.requestChecksumRequired = needBool(optKey(v, "requestChecksumRequired"), what)?
  }
  if (hasKey(v, "requestValidationModeMember")) {
    c.requestValidationModeMember = needNonEmpty(optKey(v, "requestValidationModeMember"), what)?
  }
  if (hasKey(v, "responseAlgorithms")) {
    c.responseAlgorithms = needStringList(optKey(v, "responseAlgorithms"), what)?
  }
  op.checksum = c
}

// `smithy.api#paginated`: both tokens are required; `items` is not (ListObjectsV2
// pages without one) and neither is `pageSize`.
fn readPaginated(op: Operation, v: Json, what: string): ()! {
  onlyKeys(needObject(v, what)?, ["inputToken", "outputToken", "items", "pageSize"], what)?
  let p = Paginated{ present = true }
  p.inputToken = needNonEmpty(needKey(v, "inputToken", what)?, what)?
  p.outputToken = needNonEmpty(needKey(v, "outputToken", what)?, what)?
  if (hasKey(v, "items")) {
    p.items = needNonEmpty(optKey(v, "items"), what)?
  }
  if (hasKey(v, "pageSize")) {
    p.pageSize = needNonEmpty(optKey(v, "pageSize"), what)?
  }
  op.paginated = p
}

// `smithy.rules#staticContextParams`: {"Name": {"value": <json>}}, kept as the
// parameter name and the value's compact JSON text.
fn readStaticParams(op: Operation, v: Json, what: string): ()! {
  let out = []StaticParam(0)
  for e of needObject(v, what)? {
    let at = "${what}.${e.key}"
    onlyKeys(needObject(e.value, at)?, ["value"], at)?
    out = append(
      out,
      StaticParam{ name = e.key, valueText = jsonEncode(needKey(e.value, "value", at)?) },
    )
  }
  op.staticParams = out
}

fn readEndpoint(op: Operation, v: Json, what: string): ()! {
  onlyKeys(needObject(v, what)?, ["hostPrefix"], what)?
  op.hostPrefix = needNonEmpty(needKey(v, "hostPrefix", what)?, what)?
}

// A matcher is exactly one of {"success": bool} or {"errorType": string}; the
// path matchers (output, inputOutput) are not in the S3 model and not read.
fn readMatcher(v: Json, what: string): Matcher! {
  let entries = needObject(v, what)?
  if (len(entries) != 1) {
    fail newError("${what}: a matcher holds exactly one key, got ${jsonEncode(v)}")
  }
  let e = entries[0]
  if (e.key == "success") {
    return Matcher.Success(needBool(e.value, what)?)
  }
  if (e.key == "errorType") {
    return Matcher.ErrorType(needNonEmpty(e.value, what)?)
  }
  fail newError("${what}: unknown matcher \"${e.key}\"")
}

fn readAcceptor(v: Json, what: string): Acceptor! {
  onlyKeys(needObject(v, what)?, ["matcher", "state"], what)?
  let state = needString(needKey(v, "state", what)?, what)?
  if (state != "success" && state != "failure" && state != "retry") {
    fail newError("${what}: unknown acceptor state \"${state}\"")
  }
  let matcher = readMatcher(needKey(v, "matcher", what)?, what)?
  return Acceptor{ matcher = matcher, state = state }
}

// One waiter; minDelay defaults to 2 and maxDelay to 120 seconds as in the
// Smithy waiter spec.
fn readWaiter(name: string, v: Json, what: string): Waiter! {
  onlyKeys(needObject(v, what)?, ["acceptors", "minDelay", "maxDelay"], what)?
  let w = Waiter{ name = name, minDelay = 2, maxDelay = 120 }
  if (hasKey(v, "minDelay")) {
    w.minDelay = needInt(optKey(v, "minDelay"), what)?
  }
  if (hasKey(v, "maxDelay")) {
    w.maxDelay = needInt(optKey(v, "maxDelay"), what)?
  }
  let acceptors = []Acceptor(0)
  for a of needArray(needKey(v, "acceptors", what)?, what)? {
    acceptors = append(acceptors, readAcceptor(a, what)?)
  }
  if (len(acceptors) == 0) {
    fail newError("${what}: a waiter needs at least one acceptor")
  }
  w.acceptors = acceptors
  return w
}

fn readWaiters(op: Operation, v: Json, what: string): ()! {
  let out = []Waiter(0)
  for e of needObject(v, what)? {
    out = append(out, readWaiter(e.key, e.value, "${what}.${e.key}")?)
  }
  op.waiters = out
}

// The traits that shape the request and response.
fn operationWireTrait(op: Operation, key: string, v: Json, what: string): bool! {
  if (key == traitHttp) {
    readHttp(op, v, what)?
    return true
  }
  if (key == traitHttpChecksum) {
    readChecksum(op, v, what)?
    return true
  }
  if (key == traitPaginated) {
    readPaginated(op, v, what)?
    return true
  }
  if (key == traitWaitable) {
    readWaiters(op, v, what)?
    return true
  }
  return false
}

// Endpoint, signing and S3 customization traits.
fn operationRuntimeTrait(op: Operation, key: string, v: Json, what: string): bool! {
  if (key == traitStaticParams) {
    readStaticParams(op, v, what)?
    return true
  }
  if (key == "smithy.api#endpoint") {
    readEndpoint(op, v, what)?
    return true
  }
  if (key == "aws.customizations#s3UnwrappedXmlOutput") {
    needMarker(v, what)?
    op.unwrappedXmlOutput = true
    return true
  }
  if (key == "aws.auth#unsignedPayload") {
    needMarker(v, what)?
    op.unsignedPayload = true
    return true
  }
  if (key == "smithy.api#auth") {
    op.auth = needStringList(v, what)?
    return true
  }
  return false
}

fn applyOperationTrait(op: Operation, key: string, v: Json, what: string): ()! {
  if (operationWireTrait(op, key, v, what)?) {
    return
  }
  if (operationRuntimeTrait(op, key, v, what)?) {
    return
  }
  fail newError("${what}: ${unknownTraitHint}")
}

fn readTargets(j: Json, what: string): []string! {
  let out = []string(0)
  for t of needArray(j, what)? {
    out = append(out, needNonEmpty(needKey(t, "target", what)?, what)?)
  }
  return out
}

// One operation shape. `input` and `output` are required; `errors` is not.
fn loadOperation(id: string, j: Json): Operation! {
  let entries = needObject(j, id)?
  onlyKeys(entries, ["type", "input", "output", "errors", "traits"], id)?
  let op = Operation{ id = id, name = shortName(id) }
  op.input = needNonEmpty(needKey(needKey(j, "input", id)?, "target", id)?, id)?
  op.output = needNonEmpty(needKey(needKey(j, "output", id)?, "target", id)?, id)?
  if (hasKey(j, "errors")) {
    op.errors = readTargets(optKey(j, "errors"), "${id}: errors")?
  }
  for t of needObject(needKey(j, "traits", id)?, id)? {
    applyOperationTrait(op, t.key, t.value, "${id}: trait ${t.key}")?
  }
  if (op.method == "") {
    fail newError("${id}: no smithy.api#http trait, the operation has no REST binding")
  }
  return op
}
