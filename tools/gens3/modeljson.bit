// tools/gens3 — strict readers over the model's JSON for model.bit and
// modeltraits.bit (#6604, epic #6565). Every reader takes `what`, a path
// such as "com.amazonaws.s3#PutObjectRequest.Body: trait smithy.api#http", and
// names it in the error: a value in a shape the generator does not read is a
// hard error that says where, never a silent default.

import { jsonEncode, jsonAsInt } from "std/json"

fn needObject(j: Json, what: string): []JsonEntry! {
  match (j) {
    JsonObject(entries) => return entries
    _ => fail newError("${what}: expected an object, got ${jsonEncode(j)}")
  }
}

fn needArray(j: Json, what: string): []Json! {
  match (j) {
    JsonArray(items) => return items
    _ => fail newError("${what}: expected an array, got ${jsonEncode(j)}")
  }
}

fn needString(j: Json, what: string): string! {
  match (j) {
    JsonString(s) => return s
    _ => fail newError("${what}: expected a string, got ${jsonEncode(j)}")
  }
}

// A string that is not empty: "" is how the loader spells "absent", so a
// real empty value would be read as missing.
fn needNonEmpty(j: Json, what: string): string! {
  let s = needString(j, what)?
  if (s == "") {
    fail newError("${what}: expected a non-empty string")
  }
  return s
}

fn needBool(j: Json, what: string): bool! {
  match (j) {
    JsonBool(b) => return b
    _ => fail newError("${what}: expected a boolean, got ${jsonEncode(j)}")
  }
}

fn needInt(j: Json, what: string): int! {
  match (jsonAsInt(j)) {
    Some(v) => return int(v)
    None => fail newError("${what}: expected an integer, got ${jsonEncode(j)}")
  }
}

// A marker trait: the empty object `{}`. Anything else is a shape the
// generator has not been taught.
fn needMarker(j: Json, what: string): ()! {
  match (j) {
    JsonObject(entries) => {
      if (len(entries) == 0) {
        return
      }
    }
    _ => {}
  }
  fail newError("${what}: expected {}, got ${jsonEncode(j)}")
}

fn needStringList(j: Json, what: string): []string! {
  let out = []string(0)
  for item of needArray(j, what)? {
    out = append(out, needNonEmpty(item, what)?)
  }
  return out
}

// `entries` may only hold keys from `allowed`; the first stranger is named.
fn onlyKeys(entries: []JsonEntry, allowed: []string, what: string): ()! {
  for e of entries {
    let known = false
    for a of allowed {
      if (a == e.key) {
        known = true
      }
    }
    if (!known) {
      fail newError("${what}: unknown key \"${e.key}\"")
    }
  }
}

// `key` of the object `j`, which must be there.
fn needKey(j: Json, key: string, what: string): Json! {
  match (jsonGet(j, key)) {
    Some(v) => return v
    None => fail newError("${what}: missing \"${key}\"")
  }
}

fn optKey(j: Json, key: string): Json {
  return match (jsonGet(j, key)) {
    Some(v) => v
    None => Json.JsonNull
  }
}

fn hasKey(j: Json, key: string): bool {
  return match (jsonGet(j, key)) {
    Some(_) => true
    None => false
  }
}
