// tools/gens3/emitxmlde.test.bit — #6628. The XML deserializer emitter against
// the vendored model: every output whose body is XML has its deserializer ("48
// of 48"), files stay under the 800-line ceiling, two renders are
// byte-identical, and the checked-in gen_xmlde_*.bit and gen_xmldevec_*.test.bit
// are what the generator renders now (the freshness check). Then the spellings
// the design fixes (wrapped and flattened lists, attributes, unions, required
// members, the unwrapped output) and the failure paths on small fixtures. The
// behaviour of the emitted code is pkg/s3/xmlde.test.bit and the restXml body
// vectors in pkg/s3/gen_xmldevec_*.test.bit.
//
// Run from the repo root: bit test tools/gens3

fn renderedXml(m: Model): []GenFile {
  return renderXmlDe(m, testCommit, testSha) catch e {
    panic("renderXmlDe: ${e.message()}")
  }
}

fn expectXmlError(m: Model, want: string) {
  let _ = renderXmlDe(m, testCommit, testSha) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("renderXmlDe accepted the model, want an error containing ${want}")
}

test "every output whose body is XML has its deserializer: N of N" {
  let m = loadedModel()
  let xmlOutputs = textCount(allText(renderedResp(m)), "\n// body: xml")
  let text = allText(renderedXml(m))
  let built = textCount(text, "\nfn deserialize")
  assert(built == xmlOutputs, "deserializers: ${built} of ${xmlOutputs} xml outputs")
  assert(built == 48, "xml outputs: ${built} of 48")
  let readers = textCount(text, "\nfn xmlRead")
  println("xml emitter: ${built} of ${xmlOutputs} deserializers, ${readers} shape readers")
}

test "xml files are numbered from 01, under 800 lines, headed with the pin" {
  let files = renderedXml(loadedModel())
  assert(len(files) == 3, "files: ${len(files)} of 3")
  for f of files {
    assert(hasPrefix(f.name, "gen_xmlde_0"), "name ${f.name}")
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    assert(
      contains(f.text, "bit run tools/gens3 -- xmlde\n"),
      "${f.name} names no regenerate command",
    )
    assert(contains(f.text, "api-models-aws at commit ${testCommit}"), "${f.name} names no commit")
  }
}

test "two xml renders are byte-identical" {
  let m = loadedModel()
  let a = renderedXml(m)
  let b = renderedXml(m)
  assert(len(a) == len(b), "file counts differ")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == b[i].name && a[i].text == b[i].text, "${a[i].name} differs between renders")
    i = i + 1
  }
}

fn diskText(name: string): string {
  return readFile(join("pkg/s3", name)) catch e {
    panic("read ${name}: ${e.message()}")
  }
}

// How many files `pkg/s3` holds whose name starts with `prefix`.
fn filesWith(prefix: string): int {
  let n = 0
  for name of readDir("pkg/s3") catch e {
    panic("readDir pkg/s3: ${e.message()}")
  } {
    if (hasPrefix(name, prefix)) {
      n = n + 1
    }
  }
  return n
}

test "the checked-in gen_xmlde files are what the generator renders now" {
  let files = renderedXml(loadedModel())
  for f of files {
    assert(
      diskText(f.name) == f.text,
      "${f.name} is stale, regenerate with: bit run tools/gens3 -- xmlde",
    )
  }
  assert(
    filesWith("gen_xmlde_") == len(files),
    "pkg/s3 holds ${filesWith("gen_xmlde_")} gen_xmlde files, the generator renders ${len(files)}",
  )
}

const bodyVecFile: string = "tools/gens3/model/restxml-body-vectors.json"

fn bodyVectorText(): string {
  return readFile(bodyVecFile) catch e {
    panic("read ${bodyVecFile}: ${e.message()}")
  }
}

fn renderedBodyVectors(): []GenFile {
  return renderXmlVectors(bodyVectorText(), testCommit, testSha) catch e {
    panic("renderXmlVectors: ${e.message()}")
  }
}

test "restXml body vectors: the filter keeps 48 of 67 response tests, every other is excluded with a reason" {
  let root = jsonParse(bodyVectorText()) catch e {
    panic("parse ${bodyVecFile}: ${e.message()}")
  }
  let cases = arrayLen(root, "cases")
  let excluded = arrayLen(root, "excluded")
  let total = needInt(
    needKey(root, "total", "vectors") catch e {
      panic(e.message())
    },
    "total",
  ) catch e {
    panic(e.message())
  }
  assert(total == 67, "response tests in the restXml files: ${total} of 67")
  assert(cases == 48, "applicable: ${cases} of 48")
  assert(cases + excluded == total, "applicable ${cases} + excluded ${excluded} != ${total}")
  assert(
    contains(bodyVectorText(), vectorCommit),
    "the vectors do not name the pinned smithy commit",
  )
  let filter = needString(
    needKey(root, "filter", "vectors") catch e {
      panic(e.message())
    },
    "filter",
  ) catch e {
    panic(e.message())
  }
  println("restXml body vectors at smithy ${vectorCommit}: ${cases} of ${total} apply, ${excluded} excluded")
  println("filter: ${filter}")
}

test "every body vector becomes one generated test: N of N, each file under 800 lines" {
  let files = renderedBodyVectors()
  let tests = 0
  for f of files {
    assert(hasSuffix(f.name, ".test.bit"), "${f.name} is not a test file")
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    tests = tests + textCount(f.text, "\ntest \"restXml body vector ")
  }
  assert(tests == 48, "tests: ${tests} of 48")
  let text = allText(files)
  assert(
    contains(text, "restXml body vector 48 of 48: GetBucketLocationUnwrappedOutput"),
    "last vector",
  )
  assert(
    contains(text, "restXml body vector 1 of 48: XmlLists"),
    "first vector",
  )
}

test "the checked-in gen_xmldevec files are what the generator renders now" {
  let files = renderedBodyVectors()
  for f of files {
    assert(
      diskText(f.name) == f.text,
      "${f.name} is stale, regenerate with: bit run tools/gens3 -- xmldevec",
    )
  }
  assert(
    filesWith("gen_xmldevec_") == len(files),
    "pkg/s3 holds ${filesWith("gen_xmldevec_")} gen_xmldevec files, the generator renders ${len(files)}",
  )
}

test "spellings: flattened and wrapped lists, attributes, unions, required members, the unwrapped output" {
  let text = allText(renderedXml(loadedModel()))
  assert(
    contains(text, "    contents = xmlFlat(root, \"Contents\", xmlReadObject)?,\n"),
    "flattened list",
  )
  assert(
    contains(text, "    buckets = xmlList(root, \"Buckets\", \"Bucket\", xmlReadBucket)?,\n"),
    "wrapped list",
  )
  assert(
    contains(
      text,
      "xmlAttrEnum(e, \"type\", \"http://www.w3.org/2001/XMLSchema-instance\", parseType)",
    ),
    "attribute through the prefix declared on Grant.Grantee",
  )
  assert(
    contains(
      text,
      "  if (c.local == \"Prefix\") {\n    return AnalyticsFilter.Prefix(xmlStr(c)?)\n  }\n",
    ),
    "union branch",
  )
  assert(contains(text, "  return AnalyticsFilter.Unknown(c.local)\n"), "union Unknown")
  assert(
    contains(text, "    id = unwrapOr(xmlOpt(e, \"Id\", xmlStr)?, \"\"),\n"),
    "a required string reads as empty when absent",
  )
  assert(
    contains(
      text,
      "    storageClassAnalysis = xmlNeed(\n      xmlOpt(e, \"StorageClassAnalysis\", xmlReadStorageClassAnalysis)?,\n",
    ),
    "a required structure fails when absent",
  )
  assert(
    contains(
      text,
      "    locationConstraint = xmlRootOpt(root, xmlReadBucketLocationConstraint)?,\n",
    ),
    "unwrapped output reads the root text",
  )
  assert(contains(text, "  fillListObjectsV2Output(h, out)?\n"), "fill after the body")
}

test "a blob, a non-string attribute, a non-string map key, a wide union are errors" {
  expectXmlError(
    respMini("\"B\":{\"target\":\"a#B\"}", ",\"a#B\":{\"type\":\"blob\"}"),
    "a blob in an XML body",
  )
  expectXmlError(
    respMini(
      "\"A\":{\"target\":\"a#I\",\"traits\":{\"smithy.api#xmlAttribute\":{}}}",
      ",\"a#I\":{\"type\":\"integer\"}",
    ),
    "an attribute of this kind",
  )
  expectXmlError(
    respMini(
      "\"A\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#xmlAttribute\":{},\"smithy.api#xmlName\":\"zz:x\"}}",
      "",
    ),
    "declared nowhere",
  )
  expectXmlError(
    respMini(
      "\"M\":{\"target\":\"a#M\"}",
      ",\"a#I\":{\"type\":\"integer\"},\"a#M\":{\"type\":\"map\",\"key\":{\"target\":\"a#I\"},\"value\":{\"target\":\"a#T\"}}",
    ),
    "keyed by strings",
  )
  expectXmlError(
    respMini(
      "\"U\":{\"target\":\"a#U\"}",
      ",\"a#U\":{\"type\":\"union\",\"members\":{\"A\":{\"target\":\"a#T\"},\"B\":{\"target\":\"a#T\"},\"C\":{\"target\":\"a#T\"},\"D\":{\"target\":\"a#T\"},\"E\":{\"target\":\"a#T\"},\"F\":{\"target\":\"a#T\"},\"G\":{\"target\":\"a#T\"},\"H\":{\"target\":\"a#T\"},\"I\":{\"target\":\"a#T\"}}}",
    ),
    "a union reader holds 8",
  )
}

test "a flattened map, a wrapped map and an epoch-seconds timestamp read through the runtime helpers" {
  let m = respMini(
      "\"F\":{\"target\":\"a#M\",\"traits\":{\"smithy.api#xmlFlattened\":{},\"smithy.api#xmlName\":\"KVP\"}}," +
      "\"W\":{\"target\":\"a#M\"},\"E\":{\"target\":\"a#Ep\"}",
      ",\"a#M\":{\"type\":\"map\",\"key\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#xmlName\":\"K\"}},\"value\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#xmlName\":\"V\"}}}," +
      "\"a#Ep\":{\"type\":\"timestamp\",\"traits\":{\"smithy.api#timestampFormat\":\"epoch-seconds\"}}",
  )
  let text = allText(renderedXml(m))
  assert(
    contains(text, "    f = xmlFlatMap(root, \"KVP\", \"K\", \"V\", xmlStr)?,\n"),
    "flattened map",
  )
  assert(contains(text, "    w = xmlOpt(root, \"W\", xmlReadM)?,\n"), "wrapped map")
  assert(contains(text, "    e = xmlOpt(root, \"E\", xmlEpoch)?,\n"), "epoch seconds")
  assert(
    contains(
      text,
      "fn xmlReadM(e: Element): map<string, string>! {\n  return xmlMap(e, \"K\", \"V\", xmlStr)?\n}\n",
    ),
    "map reader",
  )
}
