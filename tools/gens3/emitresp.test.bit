// tools/gens3/emitresp.test.bit — #6622. The response emitter against the
// vendored model: every operation with an output has its `fill` ("71 of 71"),
// every enum its wire parser ("76 of 76"), every file stays under the 800-line
// ceiling, two renders are byte-identical, and the checked-in
// pkg/s3/gen_resp_*.bit files are what the generator renders now (the freshness
// check). Then the spellings the design fixes and the failure paths on small
// fixtures. The behaviour of the emitted code is pkg/s3/response.test.bit and
// the restXml vectors in pkg/s3/gen_respvec.test.bit.
//
// Run from the repo root: bit test tools/gens3

import { readFile, readDir } from "std/fs"
import { join } from "std/path"
import { Json, jsonParse } from "std/json"

fn renderedResp(m: Model): []GenFile {
  return renderResp(m, testCommit, testSha) catch e {
    panic("renderResp: ${e.message()}")
  }
}

fn respFile(files: []GenFile, name: string): string {
  for f of files {
    if (f.name == name) {
      return f.text
    }
  }
  panic("no generated file ${name}")
}

fn expectRespError(m: Model, want: string) {
  let _ = renderResp(m, testCommit, testSha) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    return
  }
  panic("renderResp accepted the model, want an error containing ${want}")
}

// A model whose one operation returns `a#Out` with the members `members` and
// the further shapes `extra` (each shape a `"a#X":{...}` entry, comma-led).
fn respMini(members: string, extra: string): Model {
  let src = "{\"smithy\":\"2.0\",\"shapes\":{" +
    "\"a#Svc\":{\"type\":\"service\",\"version\":\"1\",\"operations\":[{\"target\":\"a#Op\"}],\"traits\":{}}," +
    "\"a#Op\":{\"type\":\"operation\",\"input\":{\"target\":\"a#In\"},\"output\":{\"target\":\"a#Out\"},\"traits\":{\"smithy.api#http\":{\"method\":\"GET\",\"uri\":\"/\"}}}," +
    "\"a#In\":{\"type\":\"structure\",\"members\":{},\"traits\":{}}," +
    "\"a#Out\":{\"type\":\"structure\",\"members\":{" +
    members +
    "},\"traits\":{}},\"a#T\":{\"type\":\"string\"}" +
    extra +
    "}}"
  return loadModel(src) catch e {
    panic("loadModel: ${e.message()}")
  }
}

test "every operation with an output has its fill and every enum its parser: N of N" {
  let m = loadedModel()
  let text = allText(renderedResp(m))
  let fills = textCount(text, "\n// body: ")
  assert(fills == 71, "operations with an output: ${fills} of 71")
  let parsers = textCount(text, "\nfn parse")
  assert(
    parsers == kindCount(m, ShapeKind.Enum),
    "parsers ${parsers} of ${kindCount(m, ShapeKind.Enum)}",
  )
  assert(parsers == 76, "enum parsers: ${parsers} of 76")
  let standalone = textCount(text, "\nfn deserialize")
  println("response emitter: ${fills} of 71 outputs, ${parsers} of 76 enum parsers, ${standalone} standalone deserializers")
}

test "response files are numbered from 01, under 800 lines, headed with the pin" {
  let files = renderedResp(loadedModel())
  assert(len(files) == 4, "files: ${len(files)} of 4")
  for f of files {
    assert(
      hasPrefix(f.name, "gen_resp_enums_0") || hasPrefix(f.name, "gen_resp_ops_0"),
      "name ${f.name}",
    )
    assert(countLines(f.text) < 800, "${f.name} has ${countLines(f.text)} lines")
    assert(
      contains(f.text, "bit run tools/gens3 -- resp\n"),
      "${f.name} names no regenerate command",
    )
    assert(contains(f.text, "api-models-aws at commit ${testCommit}"), "${f.name} names no commit")
  }
}

test "two renders are byte-identical" {
  let m = loadedModel()
  let a = renderedResp(m)
  let b = renderedResp(m)
  assert(len(a) == len(b), "file counts differ")
  let i = 0
  while (i < len(a)) {
    assert(a[i].name == b[i].name && a[i].text == b[i].text, "${a[i].name} differs between renders")
    i = i + 1
  }
}

test "the checked-in gen_resp files are what the generator renders now" {
  let files = renderedResp(loadedModel())
  for f of files {
    let disk = readFile(join("pkg/s3", f.name)) catch e {
      panic("read ${f.name}: ${e.message()}")
    }
    assert(disk == f.text, "${f.name} is stale, regenerate with: bit run tools/gens3 -- resp")
  }
  let onDisk = 0
  for name of readDir("pkg/s3") catch e {
    panic("readDir pkg/s3: ${e.message()}")
  } {
    if (hasPrefix(name, "gen_resp_") && !hasSuffix(name, ".test.bit")) {
      onDisk = onDisk + 1
    }
  }
  assert(
    onDisk == len(files),
    "pkg/s3 holds ${onDisk} gen_resp files, the generator renders ${len(files)}",
  )
}

test "HeadObject fills its metadata map, typed headers, Expires pair and the metadata" {
  let text = allText(renderedResp(loadedModel()))
  assert(
    contains(text, "  out.metadata = Option.Some(prefixedHeaders(h, \"x-amz-meta-\"))\n"),
    "metadata",
  )
  assert(contains(text, "  out.contentLength = headerInt(h, \"content-length\")?\n"), "int header")
  assert(
    contains(text, "  out.deleteMarker = headerBool(h, \"x-amz-delete-marker\")?\n"),
    "bool header",
  )
  assert(
    contains(text, "  out.lastModified = headerHttpDate(h, \"last-modified\")?\n"),
    "http-date default",
  )
  assert(
    contains(
      text,
      "  out.objectLockRetainUntilDate = headerDateTime(h, \"x-amz-object-lock-retain-until-date\")?\n",
    ),
    "date-time member",
  )
  assert(
    contains(
      text,
      "  out.expires = headerExpires(h)\n  out.expiresString = headerText(h, \"expires\")\n",
    ),
    "Expires pair",
  )
  assert(
    contains(
      text,
      "  out.storageClass = headerEnum(h, \"x-amz-storage-class\", parseStorageClass)\n",
    ),
    "enum header",
  )
  assert(contains(text, "  out.responseMetadata = responseMetadataOf(h)\n"), "metadata line")
}

test "bodies: a stream and a string are built here, xml and event streams are left to their deserializer" {
  let text = allText(renderedResp(loadedModel()))
  assert(
    contains(text, "  let out = GetObjectOutput{ body = emptyStream() }\n"),
    "GetObject construction",
  )
  assert(contains(text, "  out.body = ByteStream{ source = h.stream }\n"), "stream payload")
  assert(contains(text, "  out.policy = Option.Some(h.text)\n"), "string payload")
  assert(contains(text, "fn deserializeGetBucketPolicyOutput("), "string payload deserializer")
  assert(!contains(text, "fn deserializeListObjectsV2Output("), "an xml output is not built here")
  assert(contains(text, "fn fillListObjectsV2Output("), "an xml output is still filled")
  assert(
    !contains(text, "fn deserializeSelectObjectContentOutput("),
    "an event stream output is not built here",
  )
}

test "a header member that is required, a payload the generator does not read, a prefix on a string are errors" {
  expectRespError(
    respMini(
      "\"H\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpHeader\":\"X-H\",\"smithy.api#required\":{}}}",
      "",
    ),
    "a header member must be optional",
  )
  expectRespError(
    respMini(
      "\"P\":{\"target\":\"a#B\",\"traits\":{\"smithy.api#httpPayload\":{}}}",
      ",\"a#B\":{\"type\":\"blob\"}",
    ),
    "a payload of this kind is not one the generator reads",
  )
  expectRespError(
    respMini(
      "\"M\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpPrefixHeaders\":\"x-m-\"}}",
      "",
    ),
    "prefix headers must be a map",
  )
  expectRespError(
    respMini("\"S\":{\"target\":\"a#T\",\"traits\":{\"smithy.api#httpResponseCode\":{}}}", ""),
    "the response code member must be an integer",
  )
}

test "timestamp formats: the member's, then the target's, then HTTP-date; enums parse through their table" {
  let m = respMini(
      "\"A\":{\"target\":\"a#S\",\"traits\":{\"smithy.api#httpHeader\":\"X-A\",\"smithy.api#timestampFormat\":\"date-time\"}}," +
      "\"B\":{\"target\":\"a#Ep\",\"traits\":{\"smithy.api#httpHeader\":\"X-B\"}}," +
      "\"C\":{\"target\":\"a#S\",\"traits\":{\"smithy.api#httpHeader\":\"X-C\"}}," +
      "\"D\":{\"target\":\"a#E\",\"traits\":{\"smithy.api#httpHeader\":\"X-D\"}}," +
      "\"R\":{\"target\":\"a#I\",\"traits\":{\"smithy.api#httpResponseCode\":{}}}",
      ",\"a#S\":{\"type\":\"timestamp\"},\"a#Ep\":{\"type\":\"timestamp\",\"traits\":{\"smithy.api#timestampFormat\":\"epoch-seconds\"}}," +
      "\"a#I\":{\"type\":\"integer\"}," +
      "\"a#E\":{\"type\":\"enum\",\"members\":{\"V\":{\"target\":\"smithy.api#Unit\",\"traits\":{\"smithy.api#enumValue\":\"v\"}}}}",
  )
  let text = allText(renderedResp(m))
  assert(contains(text, "  out.a = headerDateTime(h, \"x-a\")?\n"), "member format")
  assert(contains(text, "  out.b = headerEpoch(h, \"x-b\")?\n"), "target format")
  assert(contains(text, "  out.c = headerHttpDate(h, \"x-c\")?\n"), "default format")
  assert(contains(text, "  out.d = headerEnum(h, \"x-d\", parseE)\n"), "enum")
  assert(contains(text, "  out.r = Option.Some(h.status)\n"), "status code")
  assert(contains(text, "    (\"v\", E.V),\n"), "enum table row")
}

const vectorCommit: string = "bd0ed9e054b29874a5bec389e16d8c4db9dc9b94"
const checkedInVectors: string = "pkg/s3/gen_respvec.test.bit"

fn vectorText(): string {
  return readFile(respVecFile) catch e {
    panic("read ${respVecFile}: ${e.message()}")
  }
}

fn vectorRoot(): Json {
  return jsonParse(vectorText()) catch e {
    panic("parse ${respVecFile}: ${e.message()}")
  }
}

fn renderedVectors(): GenFile {
  return renderRespVectors(vectorText(), testCommit, testSha) catch e {
    panic("renderRespVectors: ${e.message()}")
  }
}

fn arrayLen(root: Json, key: string): int {
  let a = needArray(
    needKey(root, key, "vectors") catch e {
      panic("${key}: ${e.message()}")
    },
    key,
  ) catch e {
    panic("${key}: ${e.message()}")
  }
  return len(a)
}

test "restXml response vectors: the filter keeps 9 of 28 response tests, every other is excluded with a reason" {
  let root = vectorRoot()
  let cases = arrayLen(root, "cases")
  let excluded = arrayLen(root, "excluded")
  let total = needInt(
    needKey(root, "total", "vectors") catch e {
      panic(e.message())
    },
    "total",
  ) catch e {
    panic(e.message())
  }
  assert(total == 28, "response tests in the five files: ${total} of 28")
  assert(cases == 9, "applicable: ${cases} of 9")
  assert(cases + excluded == total, "applicable ${cases} + excluded ${excluded} != ${total}")
  let src = vectorText()
  assert(contains(src, vectorCommit), "the vectors do not name the pinned smithy commit")
  let filter = needString(
    needKey(root, "filter", "vectors") catch e {
      panic(e.message())
    },
    "filter",
  ) catch e {
    panic(e.message())
  }
  println("restXml response vectors at smithy ${vectorCommit}: ${cases} of ${total} apply, ${excluded} excluded")
  println("filter: ${filter}")
}

test "every vector becomes one generated test: N of N" {
  let text = renderedVectors().text
  assert(
    textCount(text, "\ntest \"restXml response vector ") == 9,
    "tests: ${textCount(text, "\ntest \"restXml response vector ")} of 9",
  )
  assert(
    contains(text, "restXml response vector 9 of 9: RestXmlStringPayloadResponse"),
    "last vector",
  )
  assert(
    contains(
      text,
      "  vecMap(out.fooMap, [\"abc\", \"def\"], [\"Abc value\", \"Def value\"], \"fooMap\")\n",
    ),
    "prefix map",
  )
  assert(contains(text, "  vecSome(out.headerEnum, FooEnum.Foo, \"headerEnum\")\n"), "enum")
  assert(
    contains(text, "  vecNone(out.headerString, \"headerString\")\n"),
    "an unnamed header stays unset",
  )
}

test "the checked-in gen_respvec.test.bit is what the generator renders now" {
  let disk = readFile(checkedInVectors) catch e {
    panic("read ${checkedInVectors}: ${e.message()}")
  }
  assert(
    disk == renderedVectors().text,
    "${checkedInVectors} is stale, regenerate with: bit run tools/gens3 -- respvec",
  )
}
