// tools/gens3 — the model loader (#6604, epic #6565): reads
// `tools/gens3/model/s3.json` (trim.bit's output) into typed shapes, members
// and operations carrying exactly the Smithy traits the later generator
// stages read. Nothing here emits code.
//
// Strictness is the point. A trait the loader does not know is an error
// naming the trait and the shape id, not a skipped key: a model bump that
// brings a new trait (or an old one in a new shape) stops here, where a person
// decides whether the generator must read it. The traits the generator does
// not read are named in `isUnreadShapeTrait` (modeltraits.bit), each with the
// reason, so "ignored" is a decision on the page and never a fall-through.
//
// Layout (data first): `Model.shapes` is every shape except operations and the
// service, sorted by id, so `findShape` is a binary search; `Model.operations`
// is sorted by id. Structure, union and enum shapes hold their members in
// `members`; a list holds its one member named "member", a map "key" and
// "value", so every member of the model is a `Member` and the XML
// traits on a list element or a map entry sit where the serializer looks.
// An absent string trait is "" (the readers reject an empty value, so the
// two cannot be confused); an absent flag is false.

// Smithy shape kinds the S3 model uses. Any other `type` is an error.
enum ShapeKind {
  Structure,
  Union,
  Enum,
  List,
  Map,
  String,
  Blob,
  Boolean,
  Integer,
  Long,
  Timestamp,
}

// One member of a structure, union, enum, list or map. `streaming` is not
// here: it is a trait of the member's TARGET shape, answered by `isStreaming`.
class Member {
  name: string,
  target: string,
  required: bool,
  deprecated: bool,
  hasDefault: bool,
  defaultText: string,
  header: string,
  query: string,
  queryParams: bool,
  label: bool,
  payload: bool,
  prefixHeaders: string,
  responseCode: bool,
  hostLabel: bool,
  eventPayload: bool,
  idempotencyToken: bool,
  timestampFormat: string,
  xmlName: string,
  xmlFlattened: bool,
  xmlAttribute: bool,
  xmlNsUri: string,
  xmlNsPrefix: string,
  enumValue: string,
  contextParam: string,
}

class Shape {
  id: string,
  kind: ShapeKind,
  members: []Member,
  xmlName: string,
  xmlNsUri: string,
  xmlNsPrefix: string,
  errorKind: string,
  httpError: int,
  streaming: bool,
  sensitive: bool,
  timestampFormat: string,
}

class HttpChecksum {
  present: bool,
  requestAlgorithmMember: string,
  requestChecksumRequired: bool,
  requestValidationModeMember: string,
  responseAlgorithms: []string,
}

class Paginated {
  present: bool,
  inputToken: string,
  outputToken: string,
  items: string,
  pageSize: string,
}

// What a waiter acceptor matches: a successful response, or an error code.
enum Matcher {
  Success(bool),
  ErrorType(string),
}

class Acceptor { matcher: Matcher, state: string }

class Waiter {
  name: string,
  minDelay: int,
  maxDelay: int,
  acceptors: []Acceptor,
}

class StaticParam { name: string, valueText: string }

class Operation {
  id: string,
  name: string,
  input: string,
  output: string,
  errors: []string,
  method: string,
  uri: string,
  code: int,
  checksum: HttpChecksum = HttpChecksum{},
  paginated: Paginated = Paginated{},
  waiters: []Waiter,
  staticParams: []StaticParam,
  hostPrefix: string,
  unwrappedXmlOutput: bool,
  unsignedPayload: bool,
  auth: []string,
}

class Model {
  shapes: []Shape,
  operations: []Operation,
  serviceId: string,
  serviceVersion: string,
  serviceXmlNsUri: string,
  serviceOperations: []string,
}

// The shape named `id`, by binary search over the id-sorted `shapes`.
fn findShape(m: Model, id: string): Option<Shape> {
  let lo = 0
  let hi = len(m.shapes)
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2
    let s = m.shapes[mid]
    if (s.id == id) {
      return Option.Some(s)
    }
    if (s.id < id) {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return Option.None
}

fn findOperation(m: Model, id: string): Option<Operation> {
  for op of m.operations {
    if (op.id == id) {
      return Option.Some(op)
    }
  }
  return Option.None
}

// Whether the member's target shape is a streaming blob or union.
fn isStreaming(m: Model, mem: Member): bool {
  return match (findShape(m, mem.target)) {
    Some(s) => s.streaming
    None => false
  }
}

// How many structure and union members the model holds: the figure epic
// #6565 states (enum values are not members).
fn countMembers(m: Model): int {
  let n = 0
  for s of m.shapes {
    if (s.kind == ShapeKind.Structure || s.kind == ShapeKind.Union) {
      n = n + len(s.members)
    }
  }
  return n
}

// The short name after '#': "com.amazonaws.s3#PutObject" -> "PutObject".
fn shortName(id: string): string {
  let i = len(id)
  while (i > 0) {
    if (id[i - 1] == '#') {
      return id[i:len(id)]
    }
    i = i - 1
  }
  return id
}
