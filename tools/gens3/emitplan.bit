// tools/gens3 — which Bit types the shapes become, and under what names
// (#6614, epic #6565). Nothing here renders text; emitshapes.bit does.
//
// One type per structure, enum and union of the model. Lists, maps, strings,
// numbers, booleans, timestamps and blobs are not types of their own: a member
// that targets one is written with the Bit type it stands for.
//
// Operation shapes are renamed to the SDK-facing pair `<Op>Input` and
// `<Op>Output` (the model says `PutObjectRequest`). An operation's input is
// only ever that input, so it is renamed in place. An output is renamed in
// place too, unless the model also uses the shape elsewhere (as another
// member's target, or as the output of a second operation): then the shape
// keeps its own name and the operation gets a separate `<Op>Output` type with
// the same members, because only outputs carry `metadata`. The model has one
// such shape, NotificationConfiguration, which is both the output of
// GetBucketNotificationConfiguration and the body of the matching Put.

// How a type is used: it decides the body type of a streaming member
// (`Body` in an input, `ByteStream` in an output) and whether `metadata` is
// appended.
enum Role {
  Plain,
  Input,
  Output,
}

// One emitted type. `shape` is the model shape whose members it carries.
class Unit {
  name: string,
  shape: Shape,
  role: Role,
}

class Plan {
  m: Model,
  units: []Unit,
  // The emitted name of each model shape, parallel to `m.shapes`; "" for a
  // shape that is not a type (string, list, ...).
  names: []string,
}

fn isTypeKind(k: ShapeKind): bool {
  return k == ShapeKind.Structure || k == ShapeKind.Enum || k == ShapeKind.Union
}

// The index of shape `id` in `m.shapes` (id-sorted), or -1.
fn shapeIndex(m: Model, id: string): int {
  let lo = 0
  let hi = len(m.shapes)
  while (lo < hi) {
    let mid = lo + (hi - lo) / 2
    let sid = m.shapes[mid].id
    if (sid == id) {
      return mid
    }
    if (sid < id) {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  return -1
}

// How many members of the model's shapes (lists and maps included) target `id`.
fn targetCount(m: Model, id: string): int {
  let n = 0
  for s of m.shapes {
    for mem of s.members {
      if (mem.target == id) {
        n = n + 1
      }
    }
  }
  return n
}

// How many operations name `id` as their output.
fn outputCount(m: Model, id: string): int {
  let n = 0
  for op of m.operations {
    if (op.output == id) {
      n = n + 1
    }
  }
  return n
}

fn inputCount(m: Model, id: string): int {
  let n = 0
  for op of m.operations {
    if (op.input == id) {
      n = n + 1
    }
  }
  return n
}

// Rename an operation's input shape in place: only that operation may use it.
fn planInput(p: Plan, op: Operation): ()! {
  let i = shapeIndex(p.m, op.input)
  if (i < 0 || p.m.shapes[i].kind != ShapeKind.Structure) {
    fail newError("${op.id}: input ${op.input} is not a structure of the model")
  }
  if (inputCount(p.m, op.input) != 1 ||
    targetCount(p.m, op.input) != 0 ||
    outputCount(p.m, op.input) != 0) {
    fail newError("${op.input}: input shape of ${op.id} is used elsewhere, the generator renames it in place")
  }
  p.names[i] = op.name + "Input"
}

fn isUnitOutput(op: Operation): bool {
  return op.output == unitShape
}

// The separate `<Op>Output` type when the output shape cannot be renamed in
// place, None after renaming it.
fn planOutput(p: Plan, op: Operation): Option<Unit>! {
  let i = shapeIndex(p.m, op.output)
  if (i < 0 || p.m.shapes[i].kind != ShapeKind.Structure) {
    fail newError("${op.id}: output ${op.output} is not a structure of the model")
  }
  let shared = outputCount(p.m, op.output) != 1 ||
    targetCount(p.m, op.output) != 0 ||
    inputCount(p.m, op.output) != 0
  if (shared) {
    return Option.Some(Unit{ name = op.name + "Output", shape = p.m.shapes[i], role = Role.Output })
  }
  p.names[i] = op.name + "Output"
  return Option.None
}

// Unit for each type-kind shape, role from the operations that name it.
fn collectUnits(p: Plan): []Unit {
  let units = []Unit{}
  let i = 0
  while (i < len(p.m.shapes)) {
    let s = p.m.shapes[i]
    if (isTypeKind(s.kind)) {
      units = append(units, Unit{ name = p.names[i], shape = s, role = roleOf(p.m, s.id) })
    }
    i = i + 1
  }
  return units
}

fn roleOf(m: Model, id: string): Role {
  if (inputCount(m, id) > 0) {
    return Role.Input
  }
  if (outputCount(m, id) == 1 && targetCount(m, id) == 0) {
    return Role.Output
  }
  return Role.Plain
}

// Insertion sort by name, in place. `sortInPlace` would build a `[]Unit(n)`
// scratch slice, and a Unit holds a class, so it has no zero value (SPEC 13.4).
fn sortUnits(units: []Unit) {
  let i = 1
  while (i < len(units)) {
    let j = i
    while (j > 0 && units[j].name < units[j - 1].name) {
      let t = units[j]
      units[j] = units[j - 1]
      units[j - 1] = t
      j = j - 1
    }
    i = i + 1
  }
}

fn checkUniqueNames(units: []Unit): ()! {
  let i = 1
  while (i < len(units)) {
    if (units[i].name == units[i - 1].name) {
      fail newError("two types would be named ${units[i].name} (${units[i - 1].shape.id} and ${units[i].shape.id})")
    }
    i = i + 1
  }
}

// The plan for model `m`.
fn planShapes(m: Model): Plan! {
  let p = Plan{ m = m, units = []Unit{}, names = []string(0) }
  for s of m.shapes {
    if (isTypeKind(s.kind)) {
      p.names = append(p.names, shortName(s.id))
    } else {
      p.names = append(p.names, "")
    }
  }
  let derived = []Unit{}
  for op of m.operations {
    planInput(p, op)?
    if (!isUnitOutput(op)) {
      match (planOutput(p, op)?) {
        Some(u) => derived = append(derived, u)
        None => {}
      }
    }
  }
  p.units = collectUnits(p)
  for u of derived {
    p.units = append(p.units, u)
  }
  sortUnits(p.units)
  checkUniqueNames(p.units)?
  return p
}
