// tools/gentzdata — renders `stdlib/tz/data.bit`, the timezone extension
// blob `time.extend` (stdlib/time/extend.bit) consumes, from a zoneinfo
// directory (#5097). Checking in the full IANA database and wiring
// `std/tz` is #5098 -- this tool only proves the blob format round-trips.
//
// Run (from the repo root):
//
//   bit run tools/gentzdata/main.bit -- [zoneinfo-dir] [out-file]
//
// `zoneinfo-dir` defaults to `/usr/share/zoneinfo`; `out-file` defaults to
// `stdlib/tz/data.bit`. The second argument exists so a test can point the
// tool at a small fixture directory and a scratch output path without ever
// touching the real generated file.

import { args, exit } from "std/os"
import { join, clean } from "std/path"

const defaultZoneinfoRoot: string = "/usr/share/zoneinfo"
const defaultOutPath: string = "stdlib/tz/data.bit"

// The IANA release id, exactly as `<root>/+VERSION` holds it -- never
// trimmed, so the emitted `release` const is byte-identical to the source
// file's contents.
fn readRelease(root: string): string! {
  return readFile(join(root, "+VERSION"))?
}

fn main() {
  let a = args()
  if (len(a) > 3) {
    eprint("usage: gentzdata [zoneinfo-dir] [out-file]\n")
    exit(2)
    return
  }
  let root = defaultZoneinfoRoot
  if (len(a) >= 2) {
    root = a[1]
  }
  let out = defaultOutPath
  if (len(a) == 3) {
    out = a[2]
  }
  let cleanRoot = clean(root)
  let release = readRelease(cleanRoot) catch e {
    panic("gentzdata: reading +VERSION under ${cleanRoot}: ${e.message()}")
  }
  let entries = collectZones(cleanRoot) catch e {
    panic("gentzdata: walking ${cleanRoot}: ${e.message()}")
  }
  let blob = buildBlob(entries)
  writeGenerated(out, emitDataFile(cleanRoot, release, blob))
}
