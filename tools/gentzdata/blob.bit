// tools/gentzdata — the BITTZ blob format. `stdlib/time/extend.bit`'s own
// header comment is the parser and the authority; this file follows it
// exactly, byte for byte:
//
//   magic   8 bytes   'B' 'I' 'T' 'T' 'Z' 0x00 0x00 <version>
//   count   4 bytes   big-endian u32, number of zones
//   index   count * (2 + name + 4 + 4): u16 BE name length, name bytes,
//           u32 BE payload offset, u32 BE payload length -- both measured
//           from the START of the blob.
//   payload concatenated TZif images, in index order.
//
// Version 1 is the only version `tzExtendParse` accepts.

import { Builder } from "std/strings"

const blobVersion: int = 1

// One zone: its IANA name ("America/New_York") and its raw TZif image,
// exactly as read from disk -- unmodified, since `tzifParse` is handed this
// content byte for byte.
class zoneEntry {
  name: string,
  content: string,
}

fn byteStr(v: int): string {
  return string([u8(v)])
}

// Big-endian u16/u32 encodings: two and four raw bytes.
fn beU16(v: int): string {
  return byteStr((v >> 8) & 0xFF) + byteStr(v & 0xFF)
}

fn beU32(v: int): string {
  return byteStr((v >> 24) & 0xFF) +
    byteStr((v >> 16) & 0xFF) +
    byteStr((v >> 8) & 0xFF) +
    byteStr(v & 0xFF)
}

fn blobMagic(): string {
  return "BITTZ" + byteStr(0) + byteStr(0) + byteStr(blobVersion)
}

// The index (name length + name + offset + length per zone) followed by the
// concatenated payload, in `entries` order. `entries` must already be
// sorted by name -- this only lays out what it is given (zones.bit's
// `collectZones` does the sorting).
fn buildIndexAndPayload(entries: []zoneEntry): string {
  let indexSize = 0
  for e of entries {
    indexSize = indexSize + 2 + len(e.name) + 4 + 4
  }
  let payloadStart = 12 + indexSize
  let index = ""
  let payload = ""
  let offset = payloadStart
  for e of entries {
    index = index + beU16(len(e.name)) + e.name + beU32(offset) + beU32(len(e.content))
    payload = payload + e.content
    offset = offset + len(e.content)
  }
  return index + payload
}

// The full blob: magic, count, index, payload.
fn buildBlob(entries: []zoneEntry): string {
  return blobMagic() + beU32(len(entries)) + buildIndexAndPayload(entries)
}

// Whether `b` can stand raw inside a Bit string literal: printable ASCII,
// excluding the two characters the literal syntax reserves for itself.
fn isSafeByte(b: byte): bool {
  return b >= 32 && b <= 126 && b != '"' && b != '\\'
}

fn hexChar(v: int): byte {
  if (v < 10) {
    return u8(int('0') + v)
  }
  return u8(int('a') + v - 10)
}

// `\xNN` for one byte -- always two hex digits, matching what
// `compiler/lower.bit`'s `decodeEscapes` reads back as exactly that one
// byte, never a UTF-8 encoding of it.
fn hexEscape(x: byte): string {
  let v = int(x)
  return "\\x" + string([hexChar((v >> 4) & 0xF)]) + string([hexChar(v & 0xF)])
}

// Appends `s` to `b`, `\xNN`-escaping every unsafe byte. Runs of safe bytes
// are copied with one `.write` each rather than one call per byte.
fn appendEscaped(b: Builder, s: string) {
  let n = len(s)
  let start = 0
  let i = 0
  // Bounded by `n`: `i` strictly increases every iteration.
  while (i < n) {
    if (isSafeByte(s[i])) {
      i = i + 1
      continue
    }
    if (i > start) {
      b.write(s[start:i])
    }
    b.write(hexEscape(s[i]))
    i = i + 1
    start = i
  }
  if (start < n) {
    b.write(s[start:n])
  }
}
