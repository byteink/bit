// tools/gentzdata — renders the generated `stdlib/tz/data.bit` text
// (blob.bit builds the blob; zones.bit collects the zones).
//
// The `data` and `release` consts below are each written as ONE `.write`
// call producing ONE string literal -- never assembled as a `+`-chained
// const -- because the checker's compile-time constant folder caps
// recursion at `vConstMaxDepth` (64, compiler/validateconst.bit).
// tools/genunicode/emit.bit's own header comment hit the same ceiling first.

import { newBuilder, trimSpace } from "std/strings"
import { writeFile } from "std/fs"

// The header every generated file carries, naming this tool and the exact
// IANA release + source path the blob came from -- so a stale file against
// a newer release is visible without decoding the blob.
fn writeGeneratedHeader(b: Builder, root: string, release: string) {
  b.write("//\n")
  b.write("// GENERATED — do not hand-edit. Produced by tools/gentzdata from the\n")
  b.write("// IANA time zone database, release " + trimSpace(release) + " (" + root + "/+VERSION).\n")
  b.write("//\n")
}

// The full `stdlib/tz/data.bit` text: header, then the two module consts
// `time.extend` (stdlib/time/extend.bit) and `std/tz` (#5098) read.
fn emitDataFile(root: string, release: string, blob: string): string {
  let b = newBuilder()
  writeGeneratedHeader(b, root, release)
  b.write("export const data: string = \"")
  appendEscaped(b, blob)
  b.write("\"\n")
  b.write("export const release: string = \"")
  appendEscaped(b, release)
  b.write("\"\n")
  return b.toString()
}

fn writeGenerated(path: string, content: string) {
  writeFile(path, content) catch e {
    panic("gentzdata: writing ${path}: ${e.message()}")
  }
}
