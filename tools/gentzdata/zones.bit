// tools/gentzdata — walks a zoneinfo directory and collects the TZif zones
// to pack into the blob (blob.bit builds it; main.bit orchestrates). Zones
// come back sorted by name so re-running the tool on an unchanged input
// produces byte-identical output regardless of directory order (#5097).

import { walk, readFile, isSymlink } from "std/fs"
import { sortInPlace } from "std/sort"

// Top-level zoneinfo entries that are never zones: the release stamp, the
// POSIX-rules fallback, the leap-second table and the raw zone.tab-style
// index. Named explicitly so a run reports why each was skipped instead of
// lumping every skip into "not a TZif file".
fn isNonZoneName(name: string): bool {
  return name == "+VERSION" || name == "posixrules" || name == "leapseconds" || name == "tzdata.zi"
}

// Whether `content`'s first four bytes are the TZif magic.
fn hasTzifMagic(content: string): bool {
  if (len(content) < 4) {
    return false
  }
  return content[0] == 'T' && content[1] == 'Z' && content[2] == 'i' && content[3] == 'f'
}

// `path`'s name relative to `root`. `root` is a `clean`-ed prefix of every
// path `walk(root)` returns (main.bit cleans it once before either is
// called), so this is a plain slice -- no path-library round trip needed.
fn zoneNameFor(root: string, path: string): string {
  return path[len(root) + 1:len(path)]
}

// Every real TZif file under `root`, sorted by zone name, plus a kept/
// skipped report on stderr so a silently empty run cannot pass for a good
// one (#5097's acceptance).
fn collectZones(root: string): []zoneEntry! {
  let paths = walk(root)?
  let entries: []zoneEntry = []zoneEntry(0)
  let skipped = 0
  for p of paths {
    let name = zoneNameFor(root, p)
    if (isNonZoneName(name)) {
      skipped = skipped + 1
      continue
    }
    if (isSymlink(p)) {
      eprint("gentzdata: skip ${name}: symlink, not a regular file\n")
      skipped = skipped + 1
      continue
    }
    let content = readFile(p)?
    if (!hasTzifMagic(content)) {
      eprint("gentzdata: skip ${name}: not a TZif file\n")
      skipped = skipped + 1
      continue
    }
    entries = append(entries, zoneEntry{ name: name, content: content })
  }
  sortInPlace(entries, (a, b) => a.name < b.name)
  eprint("gentzdata: kept=${len(entries)} skipped=${skipped}\n")
  return entries
}
