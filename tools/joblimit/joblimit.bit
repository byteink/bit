// Shared compile-job limits for the build driver and its std-free harnesses.
// Runtime worker contracts and paired compiler comparisons remain independent.

export fn parseCpuBudget(raw: string): int {
  if (len(raw) == 0) {
    return 0
  }
  if (len(raw) > 10) {
    return -1
  }
  let n = 0
  let i = 0
  while (i < len(raw)) {
    let c = raw[i]
    if (c < '0' || c > '9') {
      return -1
    }
    n = n * 10 + int(c) - 48
    i = i + 1
  }
  if (n < 1 || n > 2147483647) {
    return -1
  }
  return n
}

export fn cpuBudget(): int {
  let n = parseCpuBudget(osEnv("BIT_MAKE_CPU_BUDGET"))
  if (n < 0) {
    eprint("make: BIT_MAKE_CPU_BUDGET must be an integer between 1 and 2147483647\n")
    osExit(2)
  }
  return n
}

export fn budgetJobs(requested: int, budget: int): int {
  assert(requested > 0 && budget >= 0)
  if (budget > 0 && requested > budget) {
    return budget
  }
  return requested
}

export fn pairJobs(requested: int, budget: int): int {
  if (requested < 1) {
    return 1
  }
  let limit = budget / 2
  if (budget > 0 && limit < 1) {
    limit = 1
  }
  return budgetJobs(requested, limit)
}

export fn nestedJobs(requested: int, budget: int): int {
  return budgetJobs(requested, budget)
}

export fn fanoutJobs(requested: int, count: int, budget: int): int {
  assert(requested > 0 && count > 0 && budget >= 0)
  if (budget == 0) {
    return requested
  }
  return budgetJobs(budgetJobs(requested, count), budget)
}

export fn budgetShare(budget: int, siblings: int): int {
  assert(budget >= 0 && siblings > 0)
  if (budget == 0) {
    return 0
  }
  return budget / budgetJobs(siblings, budget)
}

export fn budgetEnvScript(budget: int): string {
  assert(budget >= 0)
  if (budget == 0) {
    return ""
  }
  return "BIT_MAKE_CPU_BUDGET=${budget}\nexport BIT_MAKE_CPU_BUDGET\n"
}

export fn nestedEnvScript(requested: int, budget: int): string {
  return budgetEnvScript(budgetShare(budget, nestedJobs(requested, budget)))
}

export fn hostJobsScript(budget: int): string {
  if (budget > 0) {
    return "N=${budget}\n" + budgetEnvScript(1)
  }
  return "N=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)\n"
}
