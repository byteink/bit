// tools/fuzz/regexdifffuzz/subject.bit — the five subject kinds #2057's own
// text specifies, one set per generated pattern. Sibling of gen.bit, same
// directory module, no `import` (uses `newBuilder`/`repeat` from gen.bit's
// imports, `genLiteralChar`/`Rand` likewise — shared module scope, same
// shape as corpus.bit's header explains).

class Subject {
  kind: string,
  text: string,
}

// Bounds on the two randomised kinds below — generous enough to exercise
// real matches without letting one pattern's subjects dominate total
// corpus size (gen.bit's --count is patterns, not bytes).
const maxAsciiLen: int = 40
const maxUtf8Pieces: int = 15

// A small, fixed set of multi-byte runes spanning 2, 3 and 4-byte UTF-8
// encodings, so genUtf8Subject exercises all three widths, not just one.
fn utf8Sample(): []string {
  return []string{ "é", "ñ", "€", "λ", "中", "文", "🙂", "🚀" }
}

fn genAsciiSubject(r: Rand): string {
  let n = r.intn(maxAsciiLen + 1)
  let b = newBuilder()
  let i = 0
  while (i < n) {
    b.writeByte(byte(32 + r.intn(95))) // printable ASCII 0x20..0x7e
    i = i + 1
  }
  return b.toString()
}

fn genUtf8Subject(r: Rand): string {
  let sample = utf8Sample()
  let n = 1 + r.intn(maxUtf8Pieces)
  let b = newBuilder()
  let i = 0
  while (i < n) {
    if (r.intn(2) == 0) {
      b.write(genLiteralChar(r))
    } else {
      b.write(sample[r.intn(len(sample))])
    }
    i = i + 1
  }
  return b.toString()
}

// Every RE2 metacharacter/escape/group-syntax byte, as a lookup string
// rather than a long `||` chain — the chain form tripped E0204 (complexity
// 16, limit 10; spec/LINT.md:186).
const metaBytes: string = "\\()[]{}|*+?.^$:,"

// Whether `c` is one of `metaBytes` above — stripped out when building a
// subject from a pattern's own literal content (literalsFromPattern
// below), so what remains is plausible literal text a real match against
// this pattern is likely to hit.
fn isMetaByte(c: byte): bool {
  let i = 0
  while (i < len(metaBytes)) {
    if (metaBytes[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

const literalSubjectTarget: int = 40
const literalSubjectCap: int = 200

// "text built from the pattern's own literal characters so hits are
// common" (#2057's own words): strips regex syntax bytes out of `pattern`
// and repeats what is left up to a reasonable subject length. A pattern
// with no literal content at all (e.g. pure `.` / `\d`) falls back to a
// fixed word so the row is never empty.
fn literalsFromPattern(pattern: string): string {
  let b = newBuilder()
  let i = 0
  while (i < len(pattern)) {
    let c = pattern[i]
    if (!isMetaByte(c)) {
      b.writeByte(c)
    }
    i = i + 1
  }
  let residue = b.toString()
  if (len(residue) == 0) {
    return "sample"
  }
  if (len(residue) >= literalSubjectCap) {
    return residue[0:literalSubjectCap]
  }
  let times = 1 + literalSubjectTarget / (len(residue) + 1)
  return repeat(residue, times)
}

// A fixed ~4 KiB repetitive block, identical for every pattern (#2057:
// "a 4 KiB repetitive block").
fn block4k(): string {
  return repeat("The quick brown fox jumps over the lazy dog 0123456789. ", 71)
}

// The five subject kinds, in the fixed order both engines' result files
// key on (subjects.hex's row order is the only thing that ties a Go result
// line back to a Bit one — see gen.bit's header).
fn genSubjects(r: Rand, pattern: string): []Subject {
  let out = []Subject(0)
  out = append(out, Subject{ kind: "empty", text: "" })
  out = append(out, Subject{ kind: "ascii", text: genAsciiSubject(r) })
  out = append(out, Subject{ kind: "utf8", text: genUtf8Subject(r) })
  out = append(out, Subject{ kind: "literal", text: literalsFromPattern(pattern) })
  out = append(out, Subject{ kind: "block4k", text: block4k() })
  return out
}
