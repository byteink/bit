// tools/fuzz/regexdifffuzz/answer.bit — runs std/regex over one generated
// pattern's five subjects and writes bit-results.tsv lines in the exact
// format scripts/regex-oracle/main.go's Go side produces, so
// scripts/regex-difffuzz.sh can diff the two files line for line.
//
// Sibling of gen.bit, same directory module (no `import` — see corpus.bit's
// header). Line format, one per (patternIdx, subjectKind):
//
//   IDX  KIND  COMPILEOK  MATCHED  SUBMATCH  FINDALL  REPLACEHEX  SPLITHEX
//
// A pattern that fails to compile still emits exactly one line per subject
// (COMPILEOK=0, every other field "-") so the two engines' result files
// always have the SAME LINE COUNT regardless of outcome — the orchestrator
// diffs them as plain text, never a counted comparison.

// `compile`/`newBuilder` etc. are already imported by gen.bit (module-wide
// scope, per corpus.bit's header) — but a TYPE name needs its own import
// even when a constructor function for it is already in scope, so these
// two are new imports, not duplicates of gen.bit's.
import { Match, Regex } from "std/regex"
import { Builder } from "std/strings"

// The replaceAll template, driven by the pattern's own group count so both
// engines are asked the identical question — mirrored exactly in
// scripts/regex-oracle/main.go's replaceTemplate. `${N}` (braced,
// by-index) is unambiguous in both engines regardless of what follows.
//
// `\$` IS LOAD-BEARING, NOT A TYPO — checked live after it produced a false
// positive. A bare `"${1}"` in BIT SOURCE is Bit's OWN string
// interpolation (SPEC): the compiler evaluates the expression `1` at
// compile time and the string becomes the literal two characters "1"
// wrapped in "<" ">", i.e. "<1>" — never reaching replaceAll's template
// parser at all. `\$` is this module's own escape for a literal `$` byte
// (tests/imports/regexreplace/main.bit uses the identical escape), so the
// STRING VALUE this function returns is the six/four/four characters
// `<`,`$`,`{`,`1`,`}`,`>` etc. — what replaceAll's template parser
// (stdlib/regex/replace.bit) actually expects to see.
fn replaceTemplate(groupCount: int): string {
  if (groupCount >= 2) {
    return "<\${1}|\${2}>"
  }
  if (groupCount == 1) {
    return "<\${1}>"
  }
  return "<\${0}>"
}

// "s:e,s:e,..." for group 0 (whole match) through `groupCount`, "-1:-1"
// for a group that did not participate — mirrors Go's own
// FindStringSubmatchIndex convention exactly (main.go's submatchCsv).
fn submatchCsv(m: Match, groupCount: int): string {
  let b = newBuilder()
  let g = 0
  while (g <= groupCount) {
    if (g > 0) {
      b.write(",")
    }
    let opt = m.group(g)
    match (opt) {
      Some(sub) => b.write("${sub.start}:${sub.end}")
      None => b.write("-1:-1")
    }
    g = g + 1
  }
  return b.toString()
}

fn findAllCsv(matches: []Match): string {
  if (len(matches) == 0) {
    return "-"
  }
  let b = newBuilder()
  let i = 0
  while (i < len(matches)) {
    if (i > 0) {
      b.write(",")
    }
    b.write("${matches[i].start}:${matches[i].end}")
    i = i + 1
  }
  return b.toString()
}

fn splitHexCsv(pieces: []string): string {
  if (len(pieces) == 0) {
    return "-"
  }
  let b = newBuilder()
  let i = 0
  while (i < len(pieces)) {
    if (i > 0) {
      b.write(",")
    }
    b.write(hexOf(pieces[i]))
    i = i + 1
  }
  return b.toString()
}

// One (pattern, subject) result line for a SUCCESSFULLY compiled pattern.
fn answerLine(idx: int, kind: string, re: Regex, subject: string): string {
  let groupCount = re.groupCount()
  let found = re.find(subject)
  let matchedFlag = 0
  let submatch = "-"
  match (found) {
    Some(m) => {
      matchedFlag = 1
      submatch = submatchCsv(m, groupCount)
    }
    None => {}
  }
  let findAll = findAllCsv(re.findAll(subject, 0 - 1))
  let repl = hexOf(re.replaceAll(subject, replaceTemplate(groupCount)))
  let split = splitHexCsv(re.split(subject, 0 - 1))
  return "${idx}\t${kind}\t1\t${matchedFlag}\t${submatch}\t${findAll}\t${repl}\t${split}"
}

fn failLine(idx: int, kind: string): string {
  return "${idx}\t${kind}\t0\t-\t-\t-\t-\t-"
}

// Generates this pattern's five subjects, writes them to `subjectsOut` and
// writes one result line per subject to `resultsOut` — a compile failure
// still writes all five subjects (so the Go side, which reads subjects.hex
// unconditionally, always has a subject to answer against) and all five
// results as failLine.
fn writeSubjectsAndAnswers(
  r: Rand,
  idx: int,
  pattern: string,
  subjectsOut: Builder,
  resultsOut: Builder,
) {
  let subjects = genSubjects(r, pattern)
  let compiled = compile(pattern) catch _ {
    writeFailedPattern(idx, subjects, subjectsOut, resultsOut)
    return
  }
  let j = 0
  while (j < len(subjects)) {
    subjectsOut.write("${idx}\t${subjects[j].kind}\t${hexOf(subjects[j].text)}\n")
    resultsOut.write(answerLine(idx, subjects[j].kind, compiled, subjects[j].text) + "\n")
    j = j + 1
  }
}

fn writeFailedPattern(idx: int, subjects: []Subject, subjectsOut: Builder, resultsOut: Builder) {
  let j = 0
  while (j < len(subjects)) {
    subjectsOut.write("${idx}\t${subjects[j].kind}\t${hexOf(subjects[j].text)}\n")
    resultsOut.write(failLine(idx, subjects[j].kind) + "\n")
    j = j + 1
  }
}
