// tools/fuzz/regexdifffuzz/corpus.bit — the fixed seed corpus the mutation
// half of gen.bit's generator perturbs, and the known-divergent-construct
// check scripts/regex-difffuzz.sh needs a per-pattern flag for.
//
// Sibling of gen.bit in the same directory module: no `import` here, one
// shared scope (same shape as _tests_/bit/benchgate/baselines.bit).
//
// Every pattern below is valid RE2 syntax that BOTH std/regex and Go's
// regexp accept — the corpus itself must never be a source of expected
// divergence, only the mutations gen.bit applies to it can be.
fn corpusPatterns(): []string {
  return []string{
    "a+b*",
    "(foo|bar)+",
    "[a-z]{2,4}",
    "(?P<num>[0-9]+)-(?P<word>[a-z]+)",
    "\\bfoo\\b",
    "a.*?b",
    "(?i)hello",
    "x{3}",
    "(ab)+c?",
    "^[A-Z][a-z]*$",
    "\\s+\\S+",
    "(cat|dog|bird)",
    "[^0-9]+",
    "(a(b(c)))",
    "\\d{3}-\\d{4}",
    "(?:foo|bar){2}",
    "[[:alpha:]]+",
    "a|",
    "()",
    "\\p{L}+",
  }
}

// KNOWN-DIVERGENT CONSTRUCTS, per #2057's own constraint: this list is only
// for a construct the two engines deliberately parse differently BY DESIGN
// — never for silencing a real matching disagreement. Today that is
// exactly one thing: std/regex accepts BOTH `(?P<name>...)` and
// `(?<name>...)` for a named group (#2029); Go's regexp/syntax accepts
// only the former. A pattern containing `(?<` followed by a name character
// (never `=` or `!`, which would be lookbehind — unsupported and REJECTED
// by both engines identically, so that is not a divergence) is expected to
// disagree on compileOk alone. Extending this list to cover a MATCHING
// disagreement, rather than a compile-time syntax difference, would be
// exactly the thing #2057's Constraints section forbids.
fn isKnownDivergent(pattern: string): bool {
  let marker = "(?<"
  let idx = indexOfBitOnlyNamedGroup(pattern, marker)
  return idx >= 0
}

// Finds `(?<` followed by a name-start character (letter or underscore),
// distinguishing the Bit-only named-group spelling from `(?<=`/`(?<!`
// (lookbehind — unsupported by both engines, not a divergence).
fn indexOfBitOnlyNamedGroup(pattern: string, marker: string): int {
  let i = 0
  let limit = len(pattern) - len(marker) - 1
  // Bounded by `len(pattern)`, itself bounded by gen.bit's genRandomPattern
  // depth cap and the fixed-length corpus above.
  while (i <= limit) {
    if (pattern[i:i + len(marker)] == marker) {
      let c = pattern[i + len(marker)]
      if (isNameStart(c)) {
        return i
      }
    }
    i = i + 1
  }
  return 0 - 1
}

fn isNameStart(c: byte): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}
