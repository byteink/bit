// tools/genunicode — renders `stdlib/strings/gen_normalize.bit` (#6877), the
// Unicode normalization data NFC/NFKC need: canonical combining class,
// single-level canonical and compatibility decompositions, and primary
// composition.
//
// Layout: every table is ONE string constant of fixed-width uppercase-hex
// records sorted by key, so a lookup is a binary search straight over the
// constant — O(log n), no decode step, no allocation, no module state. A
// codepoint is five hex digits (`maxNormCodepoint`, ucdparse.bit).
//
//   ccc      lo(5) hi(5) ccc(2)       one record per run of one class
//   canon /  key(5) off(5)            `off` indexes the paired data string in
//   compat   runes; a final sentinel record gives the last entry's end
//   data     rune(5)...               every mapping, concatenated
//   compose  a(5) b(5) composite(5)   keyed by a*2^20+b
//
// Hangul syllables are algorithmic and appear in none of these.
//
// `Builder` (std/strings) and `sortInPlace` (std/sort) are imported by
// emit.bit and rangeutil.bit; imports are per module.

class ComposePair { key: int, composite: int }

// `v` as exactly `width` uppercase hex digits.
fn hexPad(v: int, width: int): string {
  let h = toHex(v)
  if (len(h) > width) {
    panic("genunicode: U+${h} needs more than ${width} hex digits")
  }
  let pad = ""
  let i = len(h)
  // Bounded by `width`, a small constant.
  while (i < width) {
    pad = pad + "0"
    i = i + 1
  }
  return pad + h
}

fn writeNormHeader(b: Builder) {
  b.write("// Bit standard library — strings module, Unicode normalization data (#6877).\n")
  b.write("//\n")
  b.write("// GENERATED — do not hand-edit. Produced by tools/genunicode from the\n")
  b.write("// Unicode Character Database, version 17.0.0:\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/DerivedNormalizationProps.txt\n")
  b.write("// Regenerate with:\n")
  b.write("//   bit run tools/genunicode -- norm \\\n")
  b.write("//     <UnicodeData.txt> <DerivedNormalizationProps.txt> stdlib/strings\n")
  b.write("//\n")
  b.write("// `ccc` is the canonical combining class. `canonicalDecomp` is the\n")
  b.write("// SINGLE-level canonical mapping (UnicodeData.txt field 5 without a\n")
  b.write("// `<tag>`); `compatDecomp` is the single-level mapping of characters whose\n")
  b.write("// field 5 carries a `<tag>` — the two tables are disjoint, so NFKD takes\n")
  b.write("// `compatDecomp` first and `canonicalDecomp` second, and recurses on the\n")
  b.write("// result. Both return an empty slice when the rune has no such mapping.\n")
  b.write("// `compose` is the primary composite of a canonical pair, or 0: pairs in\n")
  b.write("// Full_Composition_Exclusion are never returned. Hangul syllables are\n")
  b.write("// algorithmic and are not tabled here.\n\n")
}

fn packCcc(ranges: []CccRange): string {
  let b = Builder()
  let i = 0
  // Bounded by `len(ranges)`, fixed before the loop starts.
  while (i < len(ranges)) {
    b.write(hexPad(ranges[i].lo, 5) + hexPad(ranges[i].hi, 5) + hexPad(ranges[i].ccc, 2))
    i = i + 1
  }
  return b.toString()
}

// The key records of `entries`, then the sentinel (key = the largest
// five-digit value, never a real codepoint; offset = total rune count).
fn packDecompKeys(entries: []DecompEntry): string {
  let b = Builder()
  let off = 0
  let i = 0
  // Bounded by `len(entries)`, fixed before the loop starts.
  while (i < len(entries)) {
    b.write(hexPad(entries[i].code, 5) + hexPad(off, 5))
    off = off + len(entries[i].mapping)
    i = i + 1
  }
  b.write(hexPad(maxNormCodepoint, 5) + hexPad(off, 5))
  return b.toString()
}

fn packDecompData(entries: []DecompEntry): string {
  let b = Builder()
  let i = 0
  // Bounded by `len(entries)`, fixed before the loop starts.
  while (i < len(entries)) {
    let m = entries[i].mapping
    let j = 0
    // Bounded by `len(m)`, at most 18 runes in UCD 17.0.0.
    while (j < len(m)) {
      b.write(hexPad(m[j], 5))
      j = j + 1
    }
    i = i + 1
  }
  return b.toString()
}

fn inRanges(rs: []UniRange, c: int): bool {
  let i = 0
  // Bounded by `len(rs)`, fixed before the loop starts.
  while (i < len(rs)) {
    if (c >= rs[i].lo && c <= rs[i].hi) {
      return true
    }
    i = i + 1
  }
  return false
}

fn composePairLess(a: ComposePair, b: ComposePair): bool {
  return a.key < b.key
}

// Every canonical two-rune mapping whose composite is not excluded.
fn collectComposePairs(d: NormData): []ComposePair {
  let out: []ComposePair = []ComposePair(0)
  let i = 0
  // Bounded by `len(d.canon)`, fixed before the loop starts.
  while (i < len(d.canon)) {
    let e = d.canon[i]
    if (len(e.mapping) == 2 && !inRanges(d.excluded, e.code)) {
      out = append(
        out,
        ComposePair{ key = e.mapping[0] * 0x100000 + e.mapping[1], composite = e.code },
      )
    }
    i = i + 1
  }
  sortInPlace(out, composePairLess)
  return out
}

fn packCompose(pairs: []ComposePair): string {
  let b = Builder()
  let i = 0
  // Bounded by `len(pairs)`, fixed before the loop starts.
  while (i < len(pairs)) {
    if (i > 0 && pairs[i].key == pairs[i - 1].key) {
      panic("genunicode: two composites for one pair, key ${toHex(pairs[i].key)}")
    }
    b.write(
        hexPad(pairs[i].key / 0x100000, 5) +
        hexPad(pairs[i].key % 0x100000, 5) +
        hexPad(pairs[i].composite, 5),
    )
    i = i + 1
  }
  return b.toString()
}

fn writeNormConst(b: Builder, name: string, doc: string, packed: string) {
  b.write("// " + doc + "\n")
  b.write("const " + name + ": string = \"" + packed + "\"\n\n")
}

fn emitNormalize(d: NormData): string {
  let b = Builder()
  writeNormHeader(b)
  writeNormConst(
    b,
    "normCccTable",
    "ccc records: lo(5) hi(5) class(2), sorted by lo.",
    packCcc(d.ccc),
  )
  writeNormConst(
    b,
    "normCanonKeys",
    "canonical keys: rune(5) offset(5), sorted, plus a sentinel.",
    packDecompKeys(d.canon),
  )
  writeNormConst(
    b,
    "normCanonData",
    "canonical mappings, five hex digits per rune.",
    packDecompData(d.canon),
  )
  writeNormConst(
    b,
    "normCompatKeys",
    "compatibility keys: rune(5) offset(5), sorted, plus a sentinel.",
    packDecompKeys(d.compat),
  )
  writeNormConst(
    b,
    "normCompatData",
    "compatibility mappings, five hex digits per rune.",
    packDecompData(d.compat),
  )
  writeNormConst(
    b,
    "normComposeTable",
    "compose records: first(5) second(5) composite(5), sorted by (first, second).",
    packCompose(collectComposePairs(d)),
  )
  b.write("// The largest codepoint any table above can hold (five hex digits).\n")
  b.write("const normMaxRune: int = 0xFFFFF\n\n")
  writeNormSearch(b)
  writeNormLookups(b)
  return b.toString()
}

fn writeNormSearch(b: Builder) {
  b.write("// The value of the `n` uppercase hex digits of `s` starting at byte `at`.\n")
  b.write("fn normHex(s: string, at: int, n: int): int {\n")
  b.write("  let v = 0\n")
  b.write("  let i = at\n")
  b.write("  // Bounded by `at + n`.\n")
  b.write("  while (i < at + n) {\n")
  b.write("    let c = int(s[i])\n")
  b.write("    if (c <= int('9')) {\n")
  b.write("      v = v * 16 + c - int('0')\n")
  b.write("    } else {\n")
  b.write("      v = v * 16 + c - int('A') + 10\n")
  b.write("    }\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return v\n")
  b.write("}\n\n")
  b.write("// The index of the last `recLen`-byte record of `tbl` whose leading\n")
  b.write("// `keyLen`-digit key is <= `key`, or -1 when every key is larger. Binary\n")
  b.write("// search: O(log n) probes, no allocation.\n")
  b.write("fn normFloor(tbl: string, recLen: int, keyLen: int, key: int): int {\n")
  b.write("  let lo = 0\n")
  b.write("  let hi = len(tbl) / recLen - 1\n")
  b.write("  let found = -1\n")
  b.write("  // Bounded: `hi - lo` strictly shrinks every iteration.\n")
  b.write("  while (lo <= hi) {\n")
  b.write("    let mid = lo + (hi - lo) / 2\n")
  b.write("    if (normHex(tbl, mid * recLen, keyLen) <= key) {\n")
  b.write("      found = mid\n")
  b.write("      lo = mid + 1\n")
  b.write("    } else {\n")
  b.write("      hi = mid - 1\n")
  b.write("    }\n")
  b.write("  }\n")
  b.write("  return found\n")
  b.write("}\n\n")
}

fn writeNormLookups(b: Builder) {
  b.write("// The canonical combining class of `r`; 0 for a starter.\n")
  b.write("fn ccc(r: rune): int {\n")
  b.write("  let i = normFloor(normCccTable, 12, 5, int(r))\n")
  b.write("  if (i < 0 || int(r) > normHex(normCccTable, i * 12 + 5, 5)) {\n")
  b.write("    return 0\n")
  b.write("  }\n")
  b.write("  return normHex(normCccTable, i * 12 + 10, 2)\n")
  b.write("}\n\n")
  b.write("// The mapping of `r` in the key/data table pair, or an empty slice. The\n")
  b.write("// record after `r`'s (the sentinel at worst) bounds the mapping. The\n")
  b.write("// sentinel's own key, `normMaxRune`, is no real mapping's: the guard keeps\n")
  b.write("// a lookup of exactly that rune (a noncharacter) off the record past it.\n")
  b.write("fn normDecomp(keys: string, data: string, r: rune): []rune {\n")
  b.write("  if (int(r) >= normMaxRune) {\n")
  b.write("    return []rune(0)\n")
  b.write("  }\n")
  b.write("  let i = normFloor(keys, 10, 5, int(r))\n")
  b.write("  if (i < 0 || normHex(keys, i * 10, 5) != int(r)) {\n")
  b.write("    return []rune(0)\n")
  b.write("  }\n")
  b.write("  let out: []rune = []rune(0)\n")
  b.write("  let j = normHex(keys, i * 10 + 5, 5)\n")
  b.write("  let end = normHex(keys, i * 10 + 15, 5)\n")
  b.write("  // Bounded by `end`, at most 18 runes past `j` in UCD 17.0.0.\n")
  b.write("  while (j < end) {\n")
  b.write("    out = append(out, rune(normHex(data, j * 5, 5)))\n")
  b.write("    j = j + 1\n")
  b.write("  }\n")
  b.write("  return out\n")
  b.write("}\n\n")
  b.write("// The single-level canonical decomposition of `r`, or an empty slice.\n")
  b.write("fn canonicalDecomp(r: rune): []rune {\n")
  b.write("  return normDecomp(normCanonKeys, normCanonData, r)\n")
  b.write("}\n\n")
  b.write("// The single-level compatibility (`<tag>`) decomposition of `r`, or an\n")
  b.write("// empty slice.\n")
  b.write("fn compatDecomp(r: rune): []rune {\n")
  b.write("  return normDecomp(normCompatKeys, normCompatData, r)\n")
  b.write("}\n\n")
  b.write("// The primary composite of the pair `a`, `b`, or 0.\n")
  b.write("fn compose(a: rune, b: rune): rune {\n")
  b.write("  if (int(a) > normMaxRune || int(b) > normMaxRune) {\n")
  b.write("    return rune(0)\n")
  b.write("  }\n")
  b.write("  let key = int(a) * 0x100000 + int(b)\n")
  b.write("  let i = normFloor(normComposeTable, 15, 10, key)\n")
  b.write("  if (i < 0 || normHex(normComposeTable, i * 15, 10) != key) {\n")
  b.write("    return rune(0)\n")
  b.write("  }\n")
  b.write("  return rune(normHex(normComposeTable, i * 15 + 10, 5))\n")
  b.write("}\n")
}
