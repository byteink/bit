// tools/genunicode — builds simple case-fold orbits from `CaseFolding.txt`'s
// `C`/`S` rows (`ucdparse.bit`'s `FoldPair`) via union-find, then encodes
// each orbit as a circular "next" chain — the same representation Go's own
// `unicode.SimpleFold` uses internally: `next(r)` is the next rune in `r`'s
// orbit (wrapping back to the smallest), so the whole orbit is recovered by
// following `next` until it returns to where it started. A rune with no
// case variants simply has no entry, and looking one up returns itself.
//
// Union-find is over a `map<int, int>` keyed by rune value, not a dense
// array over the whole 0x110000 scalar range — only ~3000 of those runes
// ever participate (measured against UCD 17.0.0: 1512 C/S rows, 1482
// orbits, largest orbit size 4 — Kelvin sign K/k plus the Greek/Latin
// "long s" family).

// A hard ceiling on a union-find chain's length, generously above anything
// this dataset can produce (its largest orbit is 4 runes) — exists so a
// malformed or unexpectedly large future UCD release fails loudly with a
// panic instead of this tool spinning.
const maxChainSteps: int = 4096

fn ufFind(parent: map<int, int>, x: int): int {
  let cur = x
  let steps = 0
  // Bounded by `maxChainSteps`.
  while (steps < maxChainSteps) {
    let (p, ok) = parent[cur]
    if (!ok || p == cur) {
      return cur
    }
    cur = p
    steps = steps + 1
  }
  panic("genunicode: union-find chain exceeds ${maxChainSteps} steps")
}

fn ufUnion(parent: map<int, int>, a: int, b: int) {
  let ra = ufFind(parent, a)
  let rb = ufFind(parent, b)
  if (ra != rb) {
    parent[ra] = rb
  }
}

// Every rune that participates in some orbit, grouped by its union-find
// root. A root is always itself a participant (union-find roots are always
// chosen from among the values actually unioned, never synthesized), so
// every orbit's own root ends up correctly included in its own group.
fn buildOrbitGroups(pairs: []FoldPair): map<int, []int> {
  let parent = map<int, int>()
  let participants = map<int, bool>()
  let i = 0
  // Bounded by `len(pairs)`, fixed before the loop starts.
  while (i < len(pairs)) {
    ufUnion(parent, pairs[i].code, pairs[i].mapping)
    participants[pairs[i].code] = true
    participants[pairs[i].mapping] = true
    i = i + 1
  }
  let groups = map<int, []int>()
  for (r, _) of participants {
    let root = ufFind(parent, r)
    let (members, ok) = groups[root]
    if (!ok) {
      members = []int(0)
    }
    groups[root] = append(members, r)
  }
  return groups
}

class NextEntry { r: int, next: int }

fn intLess(a: int, b: int): bool {
  return a < b
}

fn nextEntryLess(a: NextEntry, b: NextEntry): bool {
  return a.r < b.r
}

// One `NextEntry` per rune that has case variants (every member of every
// orbit of size >= 2), sorted by `r` for binary search at decode time.
fn buildNextTable(groups: map<int, []int>): []NextEntry {
  let out: []NextEntry = []NextEntry(0)
  for (_, members) of groups {
    out = appendOrbitEntries(out, members)
  }
  sortInPlace(out, nextEntryLess)
  return out
}

// `members` (one orbit, unsorted) appended to `out` as a circular chain: each
// member's `next` is the next-largest member, wrapping from the largest back
// to the smallest. A size-1 "orbit" cannot happen (union-find only ever
// groups a rune with itself alone if it was never paired with anything,
// which `buildOrbitGroups` never records as a group at all), but is still
// skipped defensively rather than assumed away.
fn appendOrbitEntries(out: []NextEntry, members: []int): []NextEntry {
  if (len(members) < 2) {
    return out
  }
  let sorted = clone(members)
  sortInPlace(sorted, intLess)
  let n = len(sorted)
  let j = 0
  // Bounded by `n`, fixed before the loop starts.
  while (j < n) {
    out = append(out, NextEntry{ r: sorted[j], next: sorted[(j + 1) % n] })
    j = j + 1
  }
  return out
}

// `entries` (already sorted by `r`) packed as `"r>next,r>next,..."`, hex —
// decoded once, on first use, by `stdlib/regex/casefold.bit`.
fn encodeFoldTable(entries: []NextEntry): string {
  let out = ""
  let i = 0
  // Bounded by `len(entries)`, fixed before the loop starts.
  while (i < len(entries)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + toHex(entries[i].r) + ">" + toHex(entries[i].next)
    i = i + 1
  }
  return out
}
