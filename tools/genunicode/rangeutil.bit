// tools/genunicode — hex text <-> int, and merging codepoint ranges.
//
// Shared by every parser in this tool (ucdparse.bit) and by the emitter
// (emit.bit): a UCD field is always plain uppercase hex with no "0x"
// prefix, and every property/script/orbit ends up as a sorted, merged list
// of inclusive `[lo, hi]` ranges before it is packed into the tables this
// tool writes.

import { clone } from "std/seq"
import { sortInPlace } from "std/sort"

// One inclusive codepoint range. A local type, not `stdlib/regex/charclass.bit`'s
// `RuneRange` — this tool is not part of the `stdlib/regex` module and does
// not import from it (the generated output is plain text, never a value
// this tool shares in memory with the module it writes for).
class UniRange { lo: int, hi: int }

fn hexDigitValue(b: u8): int {
  if (b >= '0' && b <= '9') {
    return int(b) - int('0')
  }
  if (b >= 'A' && b <= 'F') {
    return int(b) - int('A') + 10
  }
  if (b >= 'a' && b <= 'f') {
    return int(b) - int('a') + 10
  }
  panic("genunicode: not a hex digit: byte ${int(b)}")
}

// Plain hex text (no "0x", any case) to an int. Every UCD codepoint field
// this tool reads is exactly this shape.
fn parseHex(s: string): int {
  let v = 0
  let i = 0
  // Bounded by `len(s)`, a fixed field width in practice (at most 6 hex
  // digits for a codepoint up to 0x10FFFF).
  while (i < len(s)) {
    v = v * 16 + hexDigitValue(s[i])
    i = i + 1
  }
  return v
}

const hexDigits: string = "0123456789ABCDEF"

// `v` as uppercase hex text, no "0x" prefix, no leading zeros (`0` itself
// prints as "0"). The inverse of `parseHex`.
fn toHex(v: int): string {
  if (v == 0) {
    return "0"
  }
  let out = ""
  let n = v
  // Bounded: `n` loses its lowest hex digit each iteration, so this runs at
  // most 6 times for any valid codepoint (up to 0x10FFFF fits in 5 hex
  // digits, but the loop itself is bounded by `n`'s own magnitude, not a
  // separate counter).
  while (n > 0) {
    let d = n % 16
    out = hexDigits[d:d + 1] + out
    n = n / 16
  }
  return out
}

fn rangeLess(a: UniRange, b: UniRange): bool {
  if (a.lo != b.lo) {
    return a.lo < b.lo
  }
  return a.hi < b.hi
}

// `rs`, sorted by `lo` and with overlapping or directly-adjacent runs
// merged — the compact, disjoint form every packed table is written in.
fn mergeRanges(rs: []UniRange): []UniRange {
  let sorted = clone(rs)
  sortInPlace(sorted, rangeLess)
  let out: []UniRange = []UniRange(0)
  let i = 0
  // Bounded by `len(sorted)`, fixed before the loop starts.
  while (i < len(sorted)) {
    out = mergeOne(out, sorted[i])
    i = i + 1
  }
  return out
}

// The complement of `rs` (already merged, e.g. by `mergeRanges`) over the
// inclusive scalar range `[lo, hi]` — used for exactly one derived
// property: `Cn` (unassigned), which `UnicodeData.txt` never lists at all,
// so it has to be computed as "every codepoint not otherwise listed" rather
// than read off any single field (ucdparse.bit's `parseGeneralCategories`).
fn complementRanges(rs: []UniRange, lo: int, hi: int): []UniRange {
  let out: []UniRange = []UniRange(0)
  let next = lo
  let i = 0
  // Bounded by `len(rs)`, fixed before the loop starts.
  while (i < len(rs)) {
    let r = rs[i]
    if (r.lo > next) {
      out = append(out, UniRange{ lo: next, hi: r.lo - 1 })
    }
    if (r.hi + 1 > next) {
      next = r.hi + 1
    }
    i = i + 1
  }
  if (next <= hi) {
    out = append(out, UniRange{ lo: next, hi: hi })
  }
  return out
}

fn mergeOne(out: []UniRange, r: UniRange): []UniRange {
  let n = len(out)
  if (n == 0 || r.lo > out[n - 1].hi + 1) {
    out = append(out, r)
    return out
  }
  if (r.hi > out[n - 1].hi) {
    out[n - 1] = UniRange{ lo: out[n - 1].lo, hi: r.hi }
  }
  return out
}

// `rs` (already merged) packed as `"lo-hi,lo-hi,..."`, hex, sorted — decoded
// once, on first use, by `stdlib/regex/unicodetables.bit`'s
// `decodePackedRanges`. One string constant per property costs exactly one
// PHYSICAL line in the generated file no matter how many ranges it packs,
// which is what keeps a table covering the full UCD under the 800-line
// E0200 ceiling.
fn encodeRanges(rs: []UniRange): string {
  let out = ""
  let i = 0
  // Bounded by `len(rs)`, fixed before the loop starts.
  while (i < len(rs)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + toHex(rs[i].lo) + "-" + toHex(rs[i].hi)
    i = i + 1
  }
  return out
}
