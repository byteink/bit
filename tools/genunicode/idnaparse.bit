// tools/genunicode — parses the files `idnaemit.bit` renders into
// `stdlib/net/gen_idna.bit` (#6880): the UTS #46 `IdnaMappingTable.txt`, the
// Bidi_Class and Joining_Type values UTS #46's validity criteria read, and
// the virama code points (canonical combining class 9) of `UnicodeData.txt`.
//
// Imports are per module: `readFile`, `split`, `hasPrefix`, `indexOf`,
// `trimSpace` and `Builder` come from ucdparse.bit / emit.bit.

// The five UTS #46 statuses. A status's code is its index here; Unicode 16
// removed the `disallowed_STD3_*` statuses (UseSTD3ASCIIRules is a flag now),
// so any other word in the table is an error.
fn idnaStatusNames(): []string {
  return []string{ "valid", "ignored", "mapped", "deviation", "disallowed" }
}

// The names `gen_idna.bit` gives those codes, in the same order.
fn idnaConstNames(): []string {
  return []string{ "idnaValid", "idnaIgnored", "idnaMapped", "idnaDeviation", "idnaDisallowed" }
}

const idnaStMapped: int = 2
const idnaStDeviation: int = 3
const idnaStDisallowed: int = 4

// The Bidi_Class values (UAX #9) as the abbreviations DerivedBidiClass.txt
// writes in its data lines, and the long names its `@missing` lines use. A
// value's code is its index; PropertyValueAliases.txt (UCD 17.0.0, `bc`) is
// the source of both lists.
fn bidiAbbrs(): []string {
  return []string{
    "L", "R", "AL", "EN", "ES", "ET", "AN", "CS", "NSM", "BN", "B", "S",
    "WS", "ON", "LRE", "LRO", "RLE", "RLO", "PDF", "LRI", "RLI", "FSI", "PDI",
  }
}

fn bidiFulls(): []string {
  return []string{
    "Left_To_Right", "Right_To_Left", "Arabic_Letter", "European_Number",
    "European_Separator", "European_Terminator", "Arabic_Number",
    "Common_Separator", "Nonspacing_Mark", "Boundary_Neutral",
    "Paragraph_Separator", "Segment_Separator", "White_Space", "Other_Neutral",
    "Left_To_Right_Embedding", "Left_To_Right_Override",
    "Right_To_Left_Embedding", "Right_To_Left_Override",
    "Pop_Directional_Format", "Left_To_Right_Isolate", "Right_To_Left_Isolate",
    "First_Strong_Isolate", "Pop_Directional_Isolate",
  }
}

// The Joining_Type values (`jt`), same shape. `U` (Non_Joining) is the
// default and is the only value DerivedJoiningType.txt never lists.
fn joinAbbrs(): []string {
  return []string{ "U", "C", "D", "L", "R", "T" }
}

fn joinFulls(): []string {
  return []string{
    "Non_Joining", "Join_Causing", "Dual_Joining", "Left_Joining",
    "Right_Joining", "Transparent",
  }
}

const maxScalar: int = 0x10FFFF

// One line of IdnaMappingTable.txt: the inclusive range, its status code and,
// for mapped and deviation, the sequence every code point in the range maps
// to (empty for the U+200C..U+200D deviation).
class IdnaRun { lo: int, hi: int, status: int, mapping: []int }

class IdnaData {
  runs: []IdnaRun,
  bidi: []int,
  joining: []int,
  viramas: []UniRange,
  marks: []UniRange,
}

fn parseIdnaData(
  idnaPath: string,
  unicodeDataPath: string,
  bidiPath: string,
  joinPath: string,
): IdnaData {
  return IdnaData{
    runs = parseIdnaTable(idnaPath),
    bidi = parseDerivedValues(bidiPath, bidiAbbrs(), bidiFulls()),
    joining = parseDerivedValues(joinPath, joinAbbrs(), joinFulls()),
    viramas = parseViramas(unicodeDataPath),
    marks = parseMarks(unicodeDataPath),
  }
}

fn indexOfName(names: []string, name: string, what: string): int {
  let i = 0
  // Bounded by `len(names)`, fixed before the loop starts.
  while (i < len(names)) {
    if (names[i] == name) {
      return i
    }
    i = i + 1
  }
  panic("genunicode: unknown ${what} '${name}'")
}

// --- IdnaMappingTable.txt -----------------------------------------------------
//
// `<range> ; <status> [; <mapping> [; <idna2008 status>]] # comment`. Only
// the first three fields matter; the IDNA2008 column (NV8, XV8) is dropped.

fn parseIdnaTable(path: string): []IdnaRun {
  let lines = split(mustReadFile(path), "\n")
  let out: []IdnaRun = []IdnaRun(0)
  let i = 0
  // Bounded by `len(lines)`, fixed before the loop starts.
  while (i < len(lines)) {
    out = parseIdnaLine(out, trimSpace(lines[i]))
    i = i + 1
  }
  return out
}

fn parseIdnaLine(out: []IdnaRun, line: string): []IdnaRun {
  if (len(line) == 0 || hasPrefix(line, "#")) {
    return out
  }
  let body = line
  let hash = indexOf(line, "#")
  if (hash >= 0) {
    body = line[0:hash]
  }
  let fields = split(body, ";")
  if (len(fields) < 2) {
    panic("genunicode: malformed IDNA line: ${line}")
  }
  let (lo, hi) = parseCodepointOrRange(trimSpace(fields[0]))
  let status = indexOfName(idnaStatusNames(), trimSpace(fields[1]), "IDNA status")
  let mapping: []int = []int(0)
  if (status == idnaStMapped || status == idnaStDeviation) {
    if (len(fields) < 3) {
      panic("genunicode: mapped line without a mapping: ${line}")
    }
    mapping = parseMapping(trimSpace(fields[2]))
  }
  out = append(out, IdnaRun{ lo = lo, hi = hi, status = status, mapping = mapping })
  return out
}

// An empty field is the empty sequence (U+200C..U+200D, deviation).
fn parseMapping(s: string): []int {
  if (len(s) == 0) {
    return []int(0)
  }
  return parseRuneList(s)
}

// --- DerivedBidiClass.txt, DerivedJoiningType.txt ------------------------------
//
// Both files give a value for every code point twice over: `# @missing:
// <range>; <Long_Name>` lines state the default of a block, in file order
// from the whole space down to the specific blocks, and the data lines
// `<range> ; <ABBR> # comment` override them. The result is one value code
// per scalar value, which `idnaemit.bit` run-length packs.

fn parseDerivedValues(path: string, abbrs: []string, fulls: []string): []int {
  let lines = split(mustReadFile(path), "\n")
  let vals = []int(maxScalar + 1)
  let i = 0
  // Bounded by `maxScalar + 1`.
  while (i <= maxScalar) {
    vals[i] = -1
    i = i + 1
  }
  i = 0
  // Bounded by `len(lines)`, fixed before the loop starts. Defaults first,
  // so a data line always wins whatever its position in the file.
  while (i < len(lines)) {
    applyMissing(vals, trimSpace(lines[i]), fulls)
    i = i + 1
  }
  i = 0
  // Bounded by `len(lines)`.
  while (i < len(lines)) {
    applyDataLine(vals, trimSpace(lines[i]), abbrs)
    i = i + 1
  }
  i = 0
  // Bounded by `maxScalar + 1`.
  while (i <= maxScalar) {
    if (vals[i] < 0) {
      panic("genunicode: ${path}: no value for U+${toHex(i)}")
    }
    i = i + 1
  }
  return vals
}

fn fillValues(vals: []int, lo: int, hi: int, code: int) {
  if (hi > maxScalar || lo > hi) {
    panic("genunicode: bad range U+${toHex(lo)}..U+${toHex(hi)}")
  }
  let c = lo
  // Bounded by `hi`, checked against `maxScalar` above.
  while (c <= hi) {
    vals[c] = code
    c = c + 1
  }
}

const missingPrefix: string = "# @missing:"

fn applyMissing(vals: []int, line: string, fulls: []string) {
  if (!hasPrefix(line, missingPrefix)) {
    return
  }
  let fields = split(line[len(missingPrefix):len(line)], ";")
  if (len(fields) != 2) {
    panic("genunicode: malformed @missing line: ${line}")
  }
  let (lo, hi) = parseCodepointOrRange(trimSpace(fields[0]))
  fillValues(vals, lo, hi, indexOfName(fulls, trimSpace(fields[1]), "property value"))
}

fn applyDataLine(vals: []int, line: string, abbrs: []string) {
  if (len(line) == 0 || hasPrefix(line, "#")) {
    return
  }
  let semi = indexOf(line, ";")
  if (semi < 0) {
    panic("genunicode: malformed data line: ${line}")
  }
  let (lo, hi) = parseCodepointOrRange(trimSpace(line[0:semi]))
  let name = scriptNameField(line[semi + 1:len(line)])
  fillValues(vals, lo, hi, indexOfName(abbrs, name, "property value abbreviation"))
}

// --- UnicodeData.txt: virama (canonical combining class 9) ----------------------

fn parseViramas(path: string): []UniRange {
  let lines = split(mustReadFile(path), "\n")
  let out: []UniRange = []UniRange(0)
  let i = 0
  // Bounded by `len(lines)`, fixed before the loop starts.
  while (i < len(lines)) {
    let fields = split(trimSpace(lines[i]), ";")
    if (len(fields) >= 4 && fields[3] == "9") {
      let code = parseHex(fields[0])
      out = append(out, UniRange{ lo = code, hi = code })
    }
    i = i + 1
  }
  return mergeRanges(out)
}

// --- UnicodeData.txt: combining marks (General_Category M) ----------------------

// The ranges of General_Category=Mark (Mn, Mc and Me): UTS #46 section 4.1
// rejects a label that begins with one.
fn parseMarks(path: string): []UniRange {
  let (marks, ok) = parseGeneralCategories(path)["M"]
  if (!ok) {
    panic("genunicode: no General_Category M in ${path}")
  }
  return mergeRanges(marks)
}
