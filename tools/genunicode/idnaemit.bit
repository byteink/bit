// tools/genunicode — renders `stdlib/net/gen_idna.bit` (#6880, #7151), the
// data UTS #46 processing needs: every code point's IDNA status and mapping,
// the Bidi_Class and Joining_Type of every scalar value, the viramas and the
// combining marks.
//
// Layout (#7151), as in gen_normalize.bit (normemit.bit): a two-stage table
// maps a code point to ONE 8-byte record holding everything the validity
// criteria read, so a lookup is a few byte loads — no hex parsing, no search,
// no allocation, no module state. Every table is a string constant of raw
// bytes.
//
//   idnaStage1   2 bytes per block of 2^shift code points: the block's index
//                in idnaStage2 (identical blocks are stored once)
//   idnaStage2   2 bytes per code point: its record index in idnaInfo
//   idnaInfo     8 bytes per record: status, Bidi_Class, Joining_Type, flags
//                (1 virama, 2 combining mark), mapping length in runes, then
//                the mapping's first rune index in idnaMapData (3 bytes)
//   idnaMapData  3 bytes per rune; identical mappings are stored once
//
// Record 0 is the record of a rune outside 0..10FFFF (disallowed, bidiL,
// joinU); code points at or past `idnaTrieLimit` all have it. A record has a
// mapping only for a mapped or deviation status.

fn writeIdnaHeader(b: Builder) {
  b.write("// Bit standard library — net module, UTS #46 IDNA data (#6880).\n")
  b.write("//\n")
  b.write("// GENERATED — do not hand-edit. Produced by tools/genunicode from\n")
  b.write("// the UTS #46 mapping table and the Unicode Character Database, both\n")
  b.write("// version 17.0.0:\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/idna/IdnaMappingTable.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedBidiClass.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedJoiningType.txt\n")
  b.write("// Regenerate with:\n")
  b.write("//   bit run tools/genunicode -- idna \\\n")
  b.write("//     <IdnaMappingTable.txt> <UnicodeData.txt> <DerivedBidiClass.txt> \\\n")
  b.write("//     <DerivedJoiningType.txt> stdlib/net\n")
  b.write("//\n")
  b.write("// `idnaStatus` is one of the `idna*` codes below: the status UTS #46\n")
  b.write("// section 5 gives the code point (the `disallowed_STD3_*` statuses are gone\n")
  b.write("// since Unicode 16; UseSTD3ASCIIRules is the caller's flag). `idnaMapping`\n")
  b.write("// is the sequence a mapped or deviation code point maps to, and an empty\n")
  b.write("// slice for every other status (and for U+200C and U+200D, whose deviation\n")
  b.write("// maps to nothing). `bidiClass` and `joiningType` are the UAX #9 Bidi_Class\n")
  b.write("// and ArabicShaping Joining_Type values as the `bidi*` and `join*` codes;\n")
  b.write("// every scalar value has one. `isVirama` is canonical combining class 9 and\n")
  b.write("// `isMark` is General_Category M (Mn, Mc, Me). A two-stage table (#7151)\n")
  b.write("// maps a code point to one 8-byte record holding all of them, so a lookup\n")
  b.write("// is a few byte loads, no search and no allocation.\n")
  b.write("// tools/genunicode/idnaemit.bit documents the byte layout.\n")
  b.write("// A rune outside 0..10FFFF is disallowed, `bidiL` and `joinU`.\n\n")
}

fn writeCodes(b: Builder, doc: string, consts: []string) {
  b.write("// " + doc + "\n")
  let i = 0
  // Bounded by `len(consts)`, fixed before the loop starts.
  while (i < len(consts)) {
    b.write("const ${consts[i]}: int = ${i}\n")
    i = i + 1
  }
  b.write("\n")
}

// "bidi" + each abbreviation: bidiL, bidiAL, ...
fn prefixed(prefix: string, abbrs: []string): []string {
  let out: []string = []string(0)
  let i = 0
  // Bounded by `len(abbrs)`, fixed before the loop starts.
  while (i < len(abbrs)) {
    out = append(out, prefix + abbrs[i])
    i = i + 1
  }
  return out
}

// Checks that `runs` are sorted, gap-free and overlap-free over the whole
// scalar range: the lookups rely on it and never test for a miss.
fn checkIdnaCoverage(runs: []IdnaRun) {
  let next = 0
  let i = 0
  // Bounded by `len(runs)`, fixed before the loop starts.
  while (i < len(runs)) {
    if (runs[i].lo != next || runs[i].hi < runs[i].lo) {
      panic("genunicode: IDNA table gap or overlap at U+${toHex(runs[i].lo)}, expected U+${toHex(next)}")
    }
    next = runs[i].hi + 1
    i = i + 1
  }
  if (next != maxScalar + 1) {
    panic("genunicode: IDNA table ends at U+${toHex(next - 1)}, not U+10FFFF")
  }
}

fn hasMapping(status: int): bool {
  return status == idnaStMapped || status == idnaStDeviation
}

// The record size and the flag bits of record byte 3.
const idnaRecSize: int = 8
const idnaFlagVirama: int = 1
const idnaFlagMark: int = 2

// The record index of every scalar value, the record bytes, and the mapping
// data the records index, three bytes per rune.
class IdnaBuild {
  idx: []int,
  recs: []int,
  data: []int,
  recAt: map<int, int>,
  seqAt: map<string, int>,
}

// Sets `bit` in `flags[c]` for every `c` of `rs`.
fn flagRanges(flags: []int, rs: []UniRange, bit: int) {
  let i = 0
  // Bounded by `len(rs)`; the inner loop by each range's width.
  while (i < len(rs)) {
    let c = rs[i].lo
    while (c <= rs[i].hi) {
      flags[c] = flags[c] | bit
      c = c + 1
    }
    i = i + 1
  }
}

// The rune index of the sequence `m` in `ib.data`, adding it once.
fn idnaSeqIndex(ib: IdnaBuild, m: []int): int {
  let key = intsKey(m)
  let (at, ok) = ib.seqAt[key]
  if (ok) {
    return at
  }
  at = len(ib.data) / 3
  ib.seqAt[key] = at
  let i = 0
  // Bounded by `len(m)`, at most 18 runes in UCD 17.0.0.
  while (i < len(m)) {
    ib.data = putBytes(ib.data, m[i], 3)
    i = i + 1
  }
  return at
}

// The index of the record [status, bidi, join, flags, n, at(3)], adding it
// once. Every field but `at` is below 256, so the key is the bytes in order.
fn idnaRecIndex(ib: IdnaBuild, fields: []int, at: int): int {
  if (at >= 0x1000000) {
    panic("genunicode: IDNA mapping data needs more than 24-bit offsets")
  }
  let key = 0
  let i = 0
  // Bounded by `len(fields)`, five.
  while (i < len(fields)) {
    key = key * 256 + fields[i]
    i = i + 1
  }
  key = key * 0x1000000 + at
  let (idx, ok) = ib.recAt[key]
  if (ok) {
    return idx
  }
  idx = len(ib.recs) / idnaRecSize
  ib.recAt[key] = idx
  i = 0
  while (i < len(fields)) {
    ib.recs = append(ib.recs, fields[i])
    i = i + 1
  }
  ib.recs = putBytes(ib.recs, at, 3)
  return idx
}

// One record per scalar value, interned. Record 0 is the one for a rune
// outside 0..10FFFF: disallowed, `bidiL`, `joinU`, no flags, no mapping.
fn buildIdna(d: IdnaData): IdnaBuild {
  checkIdnaCoverage(d.runs)
  let flags = []int(maxScalar + 1)
  flagRanges(flags, d.viramas, idnaFlagVirama)
  flagRanges(flags, d.marks, idnaFlagMark)
  let ib = IdnaBuild{
    idx = []int(maxScalar + 1),
    recs = []int(0),
    data = []int(0),
    recAt = map<int, int>{},
    seqAt = map<string, int>{},
  }
  if (idnaRecIndex(ib, []int{ idnaStDisallowed, 0, 0, 0, 0 }, 0) != 0) {
    panic("genunicode: the out-of-range IDNA record is not record 0")
  }
  let i = 0
  // Bounded by `len(d.runs)`; the inner loop by each run's width.
  while (i < len(d.runs)) {
    let r = d.runs[i]
    let at = 0
    let n = 0
    if (hasMapping(r.status) && len(r.mapping) > 0) {
      at = idnaSeqIndex(ib, r.mapping)
      n = len(r.mapping)
    }
    let c = r.lo
    while (c <= r.hi) {
      let fields = []int{ r.status, d.bidi[c], d.joining[c], flags[c], n }
      ib.idx[c] = idnaRecIndex(ib, fields, at)
      c = c + 1
    }
    i = i + 1
  }
  return ib
}

fn emitIdna(d: IdnaData): string {
  let ib = buildIdna(d)
  if (len(ib.recs) / idnaRecSize >= 0x10000) {
    panic("genunicode: the IDNA records need more than 16-bit indices")
  }
  let t = smallestTrie(ib.idx)
  let b = Builder()
  writeIdnaHeader(b)
  writeCodes(b, "IDNA statuses (UTS #46 section 5).", idnaConstNames())
  writeCodes(b, "Bidi_Class values (UAX #9).", prefixed("bidi", bidiAbbrs()))
  writeCodes(b, "Joining_Type values (ArabicShaping.txt).", prefixed("join", joinAbbrs()))
  b.write("const idnaTrieShift: int = ${t.shift}\n")
  b.write("const idnaTrieMask: int = ${(1 << t.shift) - 1}\n")
  b.write("const idnaTrieLimit: int = 0x${toHex(t.limit)}\n")
  b.write("const idnaFlagVirama: int = ${idnaFlagVirama}\n")
  b.write("const idnaFlagMark: int = ${idnaFlagMark}\n\n")
  writeByteConst(b, "idnaStage1", "Stage 1: a 16-bit block index per block.", t.stage1)
  writeByteConst(b, "idnaStage2", "Stage 2: a 16-bit record index per code point.", t.stage2)
  writeByteConst(
    b,
    "idnaInfo",
    "Records: status, bidi, joining, flags, mapping length, mapping offset(3).",
    ib.recs,
  )
  writeByteConst(b, "idnaMapData", "Mappings: three bytes per rune.", ib.data)
  writeIdnaLookups(b)
  writeIdnaHelpers(b)
  return b.toString()
}

// The lookups `idna.bit` runs per code point.
fn writeIdnaLookups(b: Builder) {
  b.write(
    ticks(
      `// The byte offset of @cp@'s record in @idnaInfo@: two byte-pair loads. A
// rune outside 0..10FFFF has record 0: disallowed, @bidiL@ and @joinU@.
fn idnaRec(cp: int): int {
  if (cp < 0 || cp >= idnaTrieLimit) {
    return 0
  }
  let k = (cp >> idnaTrieShift) * 2
  let blk = (int(idnaStage1[k]) << 8) | int(idnaStage1[k + 1])
  let j = ((blk << idnaTrieShift) | (cp & idnaTrieMask)) * 2
  return ((int(idnaStage2[j]) << 8) | int(idnaStage2[j + 1])) * 8
}

// The number of runes in the mapping of the record at @rec@.
fn idnaMapLen(rec: int): int {
  return int(idnaInfo[rec + 4])
}

// The rune index in @idnaMapData@ where the mapping of the record at @rec@
// starts.
fn idnaMapStart(rec: int): int {
  return (int(idnaInfo[rec + 5]) << 16) | (int(idnaInfo[rec + 6]) << 8) | int(idnaInfo[rec + 7])
}

// Rune @k@ of @idnaMapData@.
fn idnaMapRune(k: int): int {
  let p = k * 3
  return (int(idnaMapData[p]) << 16) | (int(idnaMapData[p + 1]) << 8) | int(idnaMapData[p + 2])
}

// The UTS #46 status of @r@: one of the @idna*@ codes.
fn idnaStatus(r: rune): int {
  return int(idnaInfo[idnaRec(int(r))])
}

// The Bidi_Class of @r@: one of the @bidi*@ codes.
fn bidiClass(r: rune): int {
  return int(idnaInfo[idnaRec(int(r)) + 1])
}

// The Joining_Type of @r@: one of the @join*@ codes.
fn joiningType(r: rune): int {
  return int(idnaInfo[idnaRec(int(r)) + 2])
}

// Whether @r@ has canonical combining class 9 (a virama).
fn isVirama(r: rune): bool {
  return (int(idnaInfo[idnaRec(int(r)) + 3]) & idnaFlagVirama) != 0
}

// Whether @r@ has General_Category M (a combining mark).
fn isMark(r: rune): bool {
  return (int(idnaInfo[idnaRec(int(r)) + 3]) & idnaFlagMark) != 0
}

`,
    ),
  )
}

// The test-facing view of the mapping data; a program that only calls
// `idnaToAscii` or `idnaToUnicode` never references it.
fn writeIdnaHelpers(b: Builder) {
  b.write(
    ticks(
      `// The sequence @r@ maps to when its status is mapped or deviation, else an
// empty slice.
fn idnaMapping(r: rune): []rune {
  let rec = idnaRec(int(r))
  let out = []rune(0)
  let k = idnaMapStart(rec)
  let end = k + idnaMapLen(rec)
  // Bounded by @end@, at most 18 runes past @k@ in UCD 17.0.0.
  while (k < end) {
    out = append(out, rune(idnaMapRune(k)))
    k = k + 1
  }
  return out
}
`,
    ),
  )
}
