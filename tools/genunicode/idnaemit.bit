// tools/genunicode — renders `stdlib/net/gen_idna.bit` (#6880), the data
// UTS #46 processing needs: every code point's IDNA status and mapping, the
// Bidi_Class and Joining_Type of every scalar value, and the viramas.
//
// Layout, as in gen_normalize.bit (normemit.bit): every table is ONE string
// constant of fixed-width uppercase-hex records sorted by their first field,
// binary-searched in place — O(log n), no decode step, no allocation, no
// module state. Code points are SIX hex digits here: U+100000..U+10FFFD is
// private use and appears in the IDNA table, so five do not suffice.
//
//   status   lo(6) status(1) off(5)   a run of one status over [lo, next lo);
//            the table covers 0..10FFFF and ends in a sentinel record
//            (lo = 110000) whose `off` is the total mapping length
//   map      rune(5)...               every mapping, concatenated; a mapped
//            run's mapping is `off` up to the next record's `off`
//   bidi     lo(6) class(2)           a run of one Bidi_Class, covering 0..10FFFF
//   joining  lo(6) type(1)            a run of one Joining_Type, covering 0..10FFFF
//   virama   lo(6) hi(6)              ranges of canonical combining class 9
//
// Adjacent valid, ignored or disallowed runs merge; a mapped or deviation run
// keeps its own record, because its `off` marks where its mapping starts.

const idnaSentinel: int = 0x110000

fn writeIdnaHeader(b: Builder) {
  b.write("// Bit standard library — net module, UTS #46 IDNA data (#6880).\n")
  b.write("//\n")
  b.write("// GENERATED — do not hand-edit. Produced by tools/genunicode from\n")
  b.write("// the UTS #46 mapping table and the Unicode Character Database, both\n")
  b.write("// version 17.0.0:\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/idna/IdnaMappingTable.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedBidiClass.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedJoiningType.txt\n")
  b.write("// Regenerate with:\n")
  b.write("//   bit run tools/genunicode -- idna \\\n")
  b.write("//     <IdnaMappingTable.txt> <UnicodeData.txt> <DerivedBidiClass.txt> \\\n")
  b.write("//     <DerivedJoiningType.txt> stdlib/net\n")
  b.write("//\n")
  b.write("// `idnaStatus` is one of the `idna*` codes below: the status UTS #46\n")
  b.write("// section 5 gives the code point (the `disallowed_STD3_*` statuses are gone\n")
  b.write("// since Unicode 16; UseSTD3ASCIIRules is the caller's flag). `idnaMapping`\n")
  b.write("// is the sequence a mapped or deviation code point maps to, and an empty\n")
  b.write("// slice for every other status (and for U+200C and U+200D, whose deviation\n")
  b.write("// maps to nothing). `bidiClass` and `joiningType` are the UAX #9 Bidi_Class\n")
  b.write("// and ArabicShaping Joining_Type values as the `bidi*` and `join*` codes;\n")
  b.write("// every scalar value has one. `isVirama` is canonical combining class 9.\n")
  b.write("// A rune outside 0..10FFFF is disallowed, `bidiL` and `joinU`.\n\n")
}

fn writeCodes(b: Builder, doc: string, consts: []string) {
  b.write("// " + doc + "\n")
  let i = 0
  // Bounded by `len(consts)`, fixed before the loop starts.
  while (i < len(consts)) {
    b.write("const ${consts[i]}: int = ${i}\n")
    i = i + 1
  }
  b.write("\n")
}

// "bidi" + each abbreviation: bidiL, bidiAL, ...
fn prefixed(prefix: string, abbrs: []string): []string {
  let out: []string = []string(0)
  let i = 0
  // Bounded by `len(abbrs)`, fixed before the loop starts.
  while (i < len(abbrs)) {
    out = append(out, prefix + abbrs[i])
    i = i + 1
  }
  return out
}

// Checks that `runs` are sorted, gap-free and overlap-free over the whole
// scalar range: the lookups rely on it and never test for a miss.
fn checkIdnaCoverage(runs: []IdnaRun) {
  let next = 0
  let i = 0
  // Bounded by `len(runs)`, fixed before the loop starts.
  while (i < len(runs)) {
    if (runs[i].lo != next || runs[i].hi < runs[i].lo) {
      panic("genunicode: IDNA table gap or overlap at U+${toHex(runs[i].lo)}, expected U+${toHex(next)}")
    }
    next = runs[i].hi + 1
    i = i + 1
  }
  if (next != maxScalar + 1) {
    panic("genunicode: IDNA table ends at U+${toHex(next - 1)}, not U+10FFFF")
  }
}

fn hasMapping(status: int): bool {
  return status == idnaStMapped || status == idnaStDeviation
}

// The status records and the mapping data they index.
class IdnaPacked { records: string, data: string }

fn packIdnaStatus(runs: []IdnaRun): IdnaPacked {
  checkIdnaCoverage(runs)
  let rec = Builder()
  let data = Builder()
  let off = 0
  let prev = -1
  let i = 0
  // Bounded by `len(runs)`, fixed before the loop starts.
  while (i < len(runs)) {
    let r = runs[i]
    if (r.status != prev || hasMapping(r.status)) {
      rec.write(hexPad(r.lo, 6) + hexPad(r.status, 1) + hexPad(off, 5))
    }
    prev = r.status
    let j = 0
    // Bounded by `len(r.mapping)`, at most 18 runes in UCD 17.0.0.
    while (j < len(r.mapping)) {
      data.write(hexPad(r.mapping[j], 5))
      j = j + 1
    }
    off = off + len(r.mapping)
    i = i + 1
  }
  rec.write(hexPad(idnaSentinel, 6) + hexPad(len(idnaStatusNames()) - 1, 1) + hexPad(off, 5))
  return IdnaPacked{ records = rec.toString(), data = data.toString() }
}

// `vals` (one value per scalar value) as `lo(6) value(width)` records, one
// per run of equal values.
fn packValueRuns(vals: []int, width: int): string {
  let b = Builder()
  let prev = -1
  let i = 0
  // Bounded by `len(vals)`, fixed before the loop starts.
  while (i < len(vals)) {
    if (vals[i] != prev) {
      b.write(hexPad(i, 6) + hexPad(vals[i], width))
      prev = vals[i]
    }
    i = i + 1
  }
  return b.toString()
}

fn packViramas(rs: []UniRange): string {
  let b = Builder()
  let i = 0
  // Bounded by `len(rs)`, fixed before the loop starts.
  while (i < len(rs)) {
    b.write(hexPad(rs[i].lo, 6) + hexPad(rs[i].hi, 6))
    i = i + 1
  }
  return b.toString()
}

fn emitIdna(d: IdnaData): string {
  let b = Builder()
  let status = packIdnaStatus(d.runs)
  writeIdnaHeader(b)
  writeCodes(b, "IDNA statuses (UTS #46 section 5).", idnaConstNames())
  writeCodes(b, "Bidi_Class values (UAX #9).", prefixed("bidi", bidiAbbrs()))
  writeCodes(b, "Joining_Type values (ArabicShaping.txt).", prefixed("join", joinAbbrs()))
  writeNormConst(
    b,
    "idnaStatusTable",
    "status records: lo(6) status(1) offset(5), sorted, plus a sentinel.",
    status.records,
  )
  writeNormConst(b, "idnaMapData", "mappings, five hex digits per rune.", status.data)
  writeNormConst(
    b,
    "idnaBidiTable",
    "Bidi_Class runs: lo(6) class(2), sorted, covering 0..10FFFF.",
    packValueRuns(d.bidi, 2),
  )
  writeNormConst(
    b,
    "idnaJoiningTable",
    "Joining_Type runs: lo(6) type(1), sorted, covering 0..10FFFF.",
    packValueRuns(d.joining, 1),
  )
  writeNormConst(
    b,
    "idnaViramaTable",
    "virama ranges: lo(6) hi(6), sorted.",
    packViramas(d.viramas),
  )
  writeIdnaSearch(b)
  writeIdnaLookups(b)
  return b.toString()
}

fn writeIdnaSearch(b: Builder) {
  b.write("// The value of the `n` uppercase hex digits of `s` starting at byte `at`.\n")
  b.write("fn idnaHex(s: string, at: int, n: int): int {\n")
  b.write("  let v = 0\n")
  b.write("  let i = at\n")
  b.write("  // Bounded by `at + n`.\n")
  b.write("  while (i < at + n) {\n")
  b.write("    let c = int(s[i])\n")
  b.write("    if (c <= int('9')) {\n")
  b.write("      v = v * 16 + c - int('0')\n")
  b.write("    } else {\n")
  b.write("      v = v * 16 + c - int('A') + 10\n")
  b.write("    }\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return v\n")
  b.write("}\n\n")
  b.write("// The index of the last `recLen`-byte record of `tbl` whose leading six-digit\n")
  b.write("// key is <= `key`, or -1 when every key is larger. Binary search: O(log n)\n")
  b.write("// probes, no allocation.\n")
  b.write("fn idnaFloor(tbl: string, recLen: int, key: int): int {\n")
  b.write("  let lo = 0\n")
  b.write("  let hi = len(tbl) / recLen - 1\n")
  b.write("  let found = -1\n")
  b.write("  // Bounded: `hi - lo` strictly shrinks every iteration.\n")
  b.write("  while (lo <= hi) {\n")
  b.write("    let mid = lo + (hi - lo) / 2\n")
  b.write("    if (idnaHex(tbl, mid * recLen, 6) <= key) {\n")
  b.write("      found = mid\n")
  b.write("      lo = mid + 1\n")
  b.write("    } else {\n")
  b.write("      hi = mid - 1\n")
  b.write("    }\n")
  b.write("  }\n")
  b.write("  return found\n")
  b.write("}\n\n")
  b.write("// Whether `r` is a scalar value in 0..10FFFF, the range every table covers.\n")
  b.write("fn idnaInRange(r: rune): bool {\n")
  b.write("  return int(r) >= 0 && int(r) <= 0x10FFFF\n")
  b.write("}\n\n")
}

fn writeIdnaLookups(b: Builder) {
  b.write("// The UTS #46 status of `r`: one of the `idna*` codes.\n")
  b.write("fn idnaStatus(r: rune): int {\n")
  b.write("  if (!idnaInRange(r)) {\n")
  b.write("    return idnaDisallowed\n")
  b.write("  }\n")
  b.write("  let i = idnaFloor(idnaStatusTable, 12, int(r))\n")
  b.write("  return idnaHex(idnaStatusTable, i * 12 + 6, 1)\n")
  b.write("}\n\n")
  b.write("// The sequence `r` maps to when its status is mapped or deviation, else an\n")
  b.write("// empty slice. The record after `r`'s (the sentinel at worst) bounds it.\n")
  b.write("fn idnaMapping(r: rune): []rune {\n")
  b.write("  let out: []rune = []rune(0)\n")
  b.write("  if (!idnaInRange(r)) {\n")
  b.write("    return out\n")
  b.write("  }\n")
  b.write("  let i = idnaFloor(idnaStatusTable, 12, int(r))\n")
  b.write("  let st = idnaHex(idnaStatusTable, i * 12 + 6, 1)\n")
  b.write("  if (st != idnaMapped && st != idnaDeviation) {\n")
  b.write("    return out\n")
  b.write("  }\n")
  b.write("  let j = idnaHex(idnaStatusTable, i * 12 + 7, 5)\n")
  b.write("  let end = idnaHex(idnaStatusTable, i * 12 + 19, 5)\n")
  b.write("  // Bounded by `end`, at most 18 runes past `j` in UCD 17.0.0.\n")
  b.write("  while (j < end) {\n")
  b.write("    out = append(out, rune(idnaHex(idnaMapData, j * 5, 5)))\n")
  b.write("    j = j + 1\n")
  b.write("  }\n")
  b.write("  return out\n")
  b.write("}\n\n")
  b.write("// The Bidi_Class of `r`: one of the `bidi*` codes.\n")
  b.write("fn bidiClass(r: rune): int {\n")
  b.write("  if (!idnaInRange(r)) {\n")
  b.write("    return bidiL\n")
  b.write("  }\n")
  b.write("  let i = idnaFloor(idnaBidiTable, 8, int(r))\n")
  b.write("  return idnaHex(idnaBidiTable, i * 8 + 6, 2)\n")
  b.write("}\n\n")
  b.write("// The Joining_Type of `r`: one of the `join*` codes.\n")
  b.write("fn joiningType(r: rune): int {\n")
  b.write("  if (!idnaInRange(r)) {\n")
  b.write("    return joinU\n")
  b.write("  }\n")
  b.write("  let i = idnaFloor(idnaJoiningTable, 7, int(r))\n")
  b.write("  return idnaHex(idnaJoiningTable, i * 7 + 6, 1)\n")
  b.write("}\n\n")
  b.write("// Whether `r` has canonical combining class 9 (a virama).\n")
  b.write("fn isVirama(r: rune): bool {\n")
  b.write("  if (!idnaInRange(r)) {\n")
  b.write("    return false\n")
  b.write("  }\n")
  b.write("  let i = idnaFloor(idnaViramaTable, 12, int(r))\n")
  b.write("  return i >= 0 && int(r) <= idnaHex(idnaViramaTable, i * 12 + 6, 6)\n")
  b.write("}\n")
}
