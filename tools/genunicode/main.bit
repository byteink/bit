// tools/genunicode — generates `stdlib/regex/unicodetables.bit` (#2032,
// `\p{...}`/`\P{...}` Unicode property classes) and `stdlib/regex/casefold.bit`
// (#2033, full Unicode simple case folding) from three UCD source files.
//
// Run (from the repo root):
//
//   bit run tools/genunicode/main.bit -- \
//     <UnicodeData.txt> <Scripts.txt> <CaseFolding.txt> stdlib/regex
//
// The three inputs are the UCD release's own files, unmodified — this run
// was against UCD 17.0.0:
//
//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt
//   https://www.unicode.org/Public/17.0.0/ucd/Scripts.txt
//   https://www.unicode.org/Public/17.0.0/ucd/CaseFolding.txt
//
// Neither output file is hand-editable — both carry a "GENERATED" header
// naming this exact command. Regenerating against a newer UCD release is
// the only sanctioned way to change either file; bump the version in this
// file's own doc comment (above) and in `docs/stdlib/regex.md` in the same
// commit as the regenerated tables.

import { args, exit } from "std/os"
import { writeFile } from "std/fs"

const ucdVersion: string = "17.0.0"

// The general categories #2032 documents: every one- and two-letter name
// from the Unicode Character Database's General_Category property. Order
// here is only cosmetic (it becomes the emitted table's row order); lookup
// is a linear scan either way (`charclass.bit`'s `ccUnicodeProperty`).
fn wantedCategories(): []string {
  return []string{
    "C", "Cc", "Cf", "Co", "Cs",
    "L", "Ll", "Lm", "Lo", "Lt", "Lu",
    "M", "Mc", "Me", "Mn",
    "N", "Nd", "Nl", "No",
    "P", "Pc", "Pd", "Pe", "Pf", "Pi", "Po", "Ps",
    "S", "Sc", "Sk", "Sm", "So",
    "Z", "Zl", "Zp", "Zs",
  }
}

// The eleven script names #2032 documents. `Any` is not here — it is
// `0..0x10FFFF` and needs no generated data (`charclass.bit` special-cases
// it directly).
fn wantedScripts(): []string {
  return []string{
    "Latin", "Greek", "Cyrillic", "Han", "Arabic", "Hebrew",
    "Hiragana", "Katakana", "Hangul", "Thai", "Devanagari",
  }
}

fn main() {
  let a = args()
  if (len(a) != 5) {
    eprint("usage: genunicode <UnicodeData.txt> <Scripts.txt> <CaseFolding.txt> <outdir>\n")
    exit(2)
    return
  }
  let categories = parseGeneralCategories(a[1])
  let scripts = parseScripts(a[2], wantedScripts())
  let orbits = buildOrbitGroups(parseCaseFoldPairs(a[3]))
  let outDir = a[4]

  let props = collectPropSpecs(categories, wantedCategories(), scripts, wantedScripts())
  writeGenerated(outDir + "/unicodetables.bit", emitUnicodeTables(props))
  writeGenerated(outDir + "/casefold.bit", emitCaseFold(buildNextTable(orbits)))
}

class propSpec { name: string, packed: string }

// One `propSpec` per requested category then script name, each merged and
// hex-packed — a category or script absent from the parsed UCD data (should
// never happen for any of these 47 names against a real UCD release) packs
// to an empty string rather than failing the whole run, since an empty
// packed table simply matches nothing and `unicodePropertyRanges` still
// resolves the name successfully.
fn collectPropSpecs(
  categories: map<string, []UniRange>,
  categoryNames: []string,
  scripts: map<string, []UniRange>,
  scriptNames: []string,
): []propSpec {
  let out: []propSpec = []propSpec(0)
  out = appendPropSpecs(out, categories, categoryNames)
  out = appendPropSpecs(out, scripts, scriptNames)
  return out
}

fn appendPropSpecs(out: []propSpec, table: map<string, []UniRange>, names: []string): []propSpec {
  let i = 0
  // Bounded by `len(names)`, fixed before the loop starts.
  while (i < len(names)) {
    let (ranges, ok) = table[names[i]]
    if (!ok) {
      ranges = []UniRange(0)
    }
    out = append(out, propSpec{ name: names[i], packed: encodeRanges(mergeRanges(ranges)) })
    i = i + 1
  }
  return out
}

fn writeGenerated(path: string, content: string) {
  writeFile(path, content) catch e {
    panic("genunicode: writing ${path}: ${e.message()}")
  }
}
