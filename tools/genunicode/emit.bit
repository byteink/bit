// tools/genunicode — renders the two generated `.bit` files as text.
//
// Each file is fully self-contained: its own hex-decode helper, its own
// packed data, its own decode function. That is a deliberate duplication
// (see rangeutil.bit's `parseHex`/`toHex`, this tool's own copy used only
// while GENERATING): the decode format is coupled to how this generator
// packs it, so keeping both in the same regenerated file means they can
// never drift out of sync with each other — only regenerating both at once
// changes either.
//
// Every multi-line body below is written directly to the `Builder` one
// `.write` call per line, never assembled as one giant `+`-chained `const`:
// the checker's compile-time constant folder caps recursion at
// `vConstMaxDepth` (64, compiler/validateconst.bit), and a source body this
// long chains far past that.

import { Builder, newBuilder } from "std/strings"

fn writeGeneratedHeader(b: Builder) {
  b.write("//\n")
  b.write("// GENERATED — do not hand-edit. Produced by tools/genunicode from the\n")
  b.write("// Unicode Character Database, version 17.0.0:\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/Scripts.txt\n")
  b.write("//   https://www.unicode.org/Public/17.0.0/ucd/CaseFolding.txt\n")
  b.write("// Regenerate with:\n")
  b.write("//   bit run tools/genunicode/main.bit -- \\\n")
  b.write("//     <UnicodeData.txt> <Scripts.txt> <CaseFolding.txt> stdlib/regex\n")
}

// --- unicodetables.bit -------------------------------------------------------

fn emitUnicodeTables(props: []propSpec): string {
  let b = newBuilder()
  b.write("// Bit standard library — regex module, Unicode property tables (#2032).\n")
  writeGeneratedHeader(b)
  b.write("//\n")
  b.write("// One `\\p{Name}`/`\\P{Name}` general-category or script table per\n")
  b.write("// `unicodePropSpec` below, packed as \"lo-hi,lo-hi,...\" (hex, merged and\n")
  b.write("// sorted), decoded on demand by `decodePackedRanges` — this file has very\n")
  b.write("// few PHYSICAL lines despite covering the full UCD, since the 800-line\n")
  b.write("// E0200 ceiling counts lines, not bytes: one string constant per property\n")
  b.write("// costs one line no matter how many ranges it packs. Resolution\n")
  b.write("// (`ccUnicodeProperty`, including the `Any` special case) lives in\n")
  b.write("// charclass.bit, not here — this file is data plus its own decoder only.\n\n")
  b.write("import { indexOf, split } from \"std/strings\"\n\n")
  b.write("class unicodePropSpec { name: string, packed: string }\n\n")
  emitPropConsts(b, props)
  emitPropTableFn(b, props)
  writeUnicodeTablesDecode(b)
  return b.toString()
}

fn propConstName(name: string): string {
  return "packedProp" + name
}

fn emitPropConsts(b: Builder, props: []propSpec) {
  let i = 0
  // Bounded by `len(props)`, fixed (47 names) before the loop starts.
  while (i < len(props)) {
    b.write("const " + propConstName(props[i].name) + ": string = \"" + props[i].packed + "\"\n")
    i = i + 1
  }
  b.write("\n")
}

fn emitPropTableFn(b: Builder, props: []propSpec) {
  b.write("fn unicodePropTable(): []unicodePropSpec {\n")
  b.write("  return []unicodePropSpec{\n")
  let i = 0
  // Bounded by `len(props)`, fixed before the loop starts.
  while (i < len(props)) {
    b.write(
        "    unicodePropSpec{ name: \"" +
        props[i].name +
        "\", packed: " +
        propConstName(props[i].name) +
        " },\n",
    )
    i = i + 1
  }
  b.write("  }\n")
  b.write("}\n\n")
}

fn writeUnicodeTablesDecode(b: Builder) {
  b.write("// Every general category (one- and two-letter) and script name #2032\n")
  b.write("// documents, resolved to a normalized `CharClass` — `Option.None` for any\n")
  b.write("// other name. Linear scan: 47 rows, and this runs once per `\\p{...}`\n")
  b.write("// appearing in a pattern, at `compile()` time, never per search.\n")
  b.write("fn unicodePropertyRanges(name: string): Option<CharClass> {\n")
  b.write("  let table = unicodePropTable()\n")
  b.write("  let i = 0\n")
  b.write("  // Bounded by `len(table)`, fixed (47) before the loop starts.\n")
  b.write("  while (i < len(table)) {\n")
  b.write("    if (table[i].name == name) {\n")
  b.write("      return Option.Some(ccNormalize(CharClass{ ranges: decodePackedRanges(table[i].packed), negated: false }))\n")
  b.write("    }\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return Option.None\n")
  b.write("}\n\n")
  b.write("fn unicodeHexDigitValue(b: u8): int {\n")
  b.write("  if (b >= '0' && b <= '9') {\n")
  b.write("    return int(b) - int('0')\n")
  b.write("  }\n")
  b.write("  return int(b) - int('A') + 10 // packed hex is always uppercase A-F\n")
  b.write("}\n\n")
  b.write("fn decodeHexToRune(s: string): rune {\n")
  b.write("  let v = 0\n")
  b.write("  let i = 0\n")
  b.write("  // Bounded by `len(s)`, at most 6 hex digits for any valid codepoint.\n")
  b.write("  while (i < len(s)) {\n")
  b.write("    v = v * 16 + unicodeHexDigitValue(s[i])\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return rune(v)\n")
  b.write("}\n\n")
  b.write("// Decodes a packed \"lo-hi,lo-hi,...\" string into ranges. `packed == \"\"`\n")
  b.write("// decodes to no ranges.\n")
  b.write("fn decodePackedRanges(packed: string): []RuneRange {\n")
  b.write("  if (len(packed) == 0) {\n")
  b.write("    return []RuneRange(0)\n")
  b.write("  }\n")
  b.write("  let parts = split(packed, \",\")\n")
  b.write("  let out: []RuneRange = []RuneRange(0)\n")
  b.write("  let i = 0\n")
  b.write("  // Bounded by `len(parts)`, fixed before the loop starts.\n")
  b.write("  while (i < len(parts)) {\n")
  b.write("    let dash = indexOf(parts[i], \"-\")\n")
  b.write("    let lo = decodeHexToRune(parts[i][0:dash])\n")
  b.write("    let hi = decodeHexToRune(parts[i][int(dash) + 1:len(parts[i])])\n")
  b.write("    out = append(out, RuneRange{ lo: lo, hi: hi })\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return out\n")
  b.write("}\n")
}

// --- casefold.bit -------------------------------------------------------

fn emitCaseFold(entries: []NextEntry): string {
  let b = newBuilder()
  b.write("// Bit standard library — regex module, Unicode simple case-fold orbits\n")
  b.write("// (#2033).\n")
  writeGeneratedHeader(b)
  b.write("//\n")
  b.write("// Built from CaseFolding.txt's `C` (common) and `S` (simple) status lines\n")
  b.write("// only — `F` (full, multi-character, e.g. ß -> \"ss\") and `T` (Turkic)\n")
  b.write("// are both out of scope by design (see docs/stdlib/regex.md's Flags\n")
  b.write("// section). Encoded as a circular \"next rune in orbit\" chain, the same\n")
  b.write("// representation Go's `unicode.SimpleFold` uses: walking `next` from any\n")
  b.write("// member of an orbit visits every other member exactly once before\n")
  b.write("// returning to the start. A rune with no case variants has no entry.\n\n")
  b.write("const packedFoldTable: string = \"" + encodeFoldTable(entries) + "\"\n\n")
  writeCaseFoldDecode(b)
  return b.toString()
}

fn writeCaseFoldDecode(b: Builder) {
  writeCaseFoldDecodePart1(b)
  writeCaseFoldDecodePart2(b)
}

// Table decode + binary search — split out of `writeCaseFoldDecode` only to
// keep each function short, not for any semantic reason.
fn writeCaseFoldDecodePart1(b: Builder) {
  b.write("class FoldEntry { r: rune, next: rune }\n\n")
  b.write("fn foldHexDigitValue(b: u8): int {\n")
  b.write("  if (b >= '0' && b <= '9') {\n")
  b.write("    return int(b) - int('0')\n")
  b.write("  }\n")
  b.write("  return int(b) - int('A') + 10 // packed hex is always uppercase A-F\n")
  b.write("}\n\n")
  b.write("fn foldDecodeHexToRune(s: string): rune {\n")
  b.write("  let v = 0\n")
  b.write("  let i = 0\n")
  b.write("  // Bounded by `len(s)`, at most 6 hex digits for any valid codepoint.\n")
  b.write("  while (i < len(s)) {\n")
  b.write("    v = v * 16 + foldHexDigitValue(s[i])\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return rune(v)\n")
  b.write("}\n\n")
  b.write("// The full orbit table, sorted by `r` — decoded fresh on every call, never\n")
  b.write("// cached: folding only ever happens at `compile()` time (building a\n")
  b.write("// `CharClass`), never per search, so a fresh decode here costs nothing a\n")
  b.write("// caller would notice, and keeping this module free of mutable global\n")
  b.write("// state avoids any question of thread safety across the green threads a\n")
  b.write("// compiled `Regex` is shared across (regex.bit's header).\n")
  b.write("fn decodeFoldTable(): []FoldEntry {\n")
  b.write("  if (len(packedFoldTable) == 0) {\n")
  b.write("    return []FoldEntry(0)\n")
  b.write("  }\n")
  b.write("  let parts = split(packedFoldTable, \",\")\n")
  b.write("  let out: []FoldEntry = []FoldEntry(0)\n")
  b.write("  let i = 0\n")
  b.write("  // Bounded by `len(parts)`, fixed before the loop starts.\n")
  b.write("  while (i < len(parts)) {\n")
  b.write("    let gt = indexOf(parts[i], \">\")\n")
  b.write("    let r = foldDecodeHexToRune(parts[i][0:gt])\n")
  b.write("    let next = foldDecodeHexToRune(parts[i][int(gt) + 1:len(parts[i])])\n")
  b.write("    out = append(out, FoldEntry{ r: r, next: next })\n")
  b.write("    i = i + 1\n")
  b.write("  }\n")
  b.write("  return out\n")
  b.write("}\n\n")
  b.write("// The index of `r` in `table` (sorted by `.r`), or `-1`. Binary search —\n")
  b.write("// `table` holds ~3000 entries and this runs per rune folded, so a linear\n")
  b.write("// scan would make folding a large class range visibly slower.\n")
  b.write("fn foldTableIndexOf(table: []FoldEntry, r: rune): int {\n")
  b.write("  let lo = 0\n")
  b.write("  let hi = len(table) - 1\n")
  b.write("  // Bounded: `hi - lo` strictly shrinks every iteration.\n")
  b.write("  while (lo <= hi) {\n")
  b.write("    let mid = lo + (hi - lo) / 2\n")
  b.write("    if (table[mid].r < r) {\n")
  b.write("      lo = mid + 1\n")
  b.write("    } else if (table[mid].r > r) {\n")
  b.write("      hi = mid - 1\n")
  b.write("    } else {\n")
  b.write("      return mid\n")
  b.write("    }\n")
  b.write("  }\n")
  b.write("  return -1\n")
  b.write("}\n\n")
}

// Range lower-bound + orbit walk.
fn writeCaseFoldDecodePart2(b: Builder) {
  b.write("// The first index in `table` whose rune is >= `lo` (`len(table)` if none).\n")
  b.write("// Binary search, the entry point for folding a RANGE without iterating\n")
  b.write("// every rune in it (charclass.bit's `ccFold`): start here and scan forward\n")
  b.write("// only while `.r <= hi`, bounded by how many fold-table entries fall in\n")
  b.write("// the range, never by the range's own width.\n")
  b.write("fn foldTableLowerBound(table: []FoldEntry, lo: rune): int {\n")
  b.write("  let l = 0\n")
  b.write("  let h = len(table)\n")
  b.write("  // Bounded: `h - l` strictly shrinks every iteration.\n")
  b.write("  while (l < h) {\n")
  b.write("    let mid = l + (h - l) / 2\n")
  b.write("    if (table[mid].r < lo) {\n")
  b.write("      l = mid + 1\n")
  b.write("    } else {\n")
  b.write("      h = mid\n")
  b.write("    }\n")
  b.write("  }\n")
  b.write("  return l\n")
  b.write("}\n\n")
  b.write("// A hard ceiling on walking one orbit's circular chain — generously above\n")
  b.write("// the largest real orbit in UCD 17.0.0 (4: Kelvin sign K/k plus a Latin/\n")
  b.write("// Greek \"long s\"/sigma family), so a future release with a larger orbit\n")
  b.write("// fails loudly rather than looping forever on a malformed table.\n")
  b.write("const maxFoldOrbitWalk: int = 16\n\n")
  b.write("// Every OTHER rune in `r`'s orbit (excluding `r` itself), or an empty\n")
  b.write("// slice when `r` has no case variants. `startIdx` is `r`'s own index in\n")
  b.write("// `table` (already found by the caller — this never re-searches).\n")
  b.write("fn foldOrbitOthersAt(table: []FoldEntry, startIdx: int, r: rune): []rune {\n")
  b.write("  let out: []rune = []rune(0)\n")
  b.write("  let cur = table[startIdx].next\n")
  b.write("  let steps = 0\n")
  b.write("  // Bounded by `maxFoldOrbitWalk`.\n")
  b.write("  while (cur != r && steps < maxFoldOrbitWalk) {\n")
  b.write("    out = append(out, cur)\n")
  b.write("    let idx = foldTableIndexOf(table, cur)\n")
  b.write("    cur = table[idx].next\n")
  b.write("    steps = steps + 1\n")
  b.write("  }\n")
  b.write("  return out\n")
  b.write("}\n\n")
  b.write("// Every other rune in `r`'s orbit, or an empty slice when `r` has no case\n")
  b.write("// variants at all. The single-rune entry point (literal folding); range\n")
  b.write("// folding goes through `foldTableLowerBound` + `foldOrbitOthersAt`\n")
  b.write("// directly to avoid this function's own re-search per rune.\n")
  b.write("fn foldOrbitOthers(table: []FoldEntry, r: rune): []rune {\n")
  b.write("  let idx = foldTableIndexOf(table, r)\n")
  b.write("  if (idx < 0) {\n")
  b.write("    return []rune(0)\n")
  b.write("  }\n")
  b.write("  return foldOrbitOthersAt(table, idx, r)\n")
  b.write("}\n")
}
