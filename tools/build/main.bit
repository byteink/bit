// The Bit build driver (#1868, epic #1867) — the replacement for `build.zig`,
// the last `.zig` file in the repository.
//
// Invoked through `./make`, which resolves the pinned stage0, compiles this
// directory with it, and execs the result. See `defs.bit` for the step registry
// and for why every step is declared before any body exists.
//
// SCOPE OF THIS COMMIT: dispatch only. `--list`, argument handling and
// dependency ordering are real; every step BODY exits non-zero saying it is not
// implemented. #1869 fills in the artifact steps and #1870 the test steps.
// `build.zig` is untouched and stays authoritative until #1871's cutover, which
// is the only task allowed to delete it.

import { args, exit } from "std/os"
import { join } from "std/strings"

// `zig build` with no step runs `install`; match that so muscle memory and the
// scripts that call the default both keep working.
function defaultStep(): string { return "install" }

function usage() {
  eprint("usage: ./make [--list] [<step>...]\n")
  eprint("  no step runs '${defaultStep()}', matching `zig build`\n")
  eprint("  --list  print every step and its description\n")
}

function listSteps() {
  for s of steps() {
    // Two columns, padded like `zig build --help`'s Steps section so the two
    // can be diffed by eye as well as mechanically.
    print("${padRight(s.name, 28)} ${s.desc}\n")
  }
}

function padRight(s: string, w: int): string {
  let out = s
  while (len(out) < w) {
    out = out + " "
  }
  return out
}

// Depth-first postorder so a step's dependencies run before it, with `seen`
// making a step that several others depend on run exactly once.
//
// A cycle would otherwise recurse forever. `active` catches it and reports the
// step it closed on, because a build driver that hangs is indistinguishable
// from one doing slow work — and this repo has already paid for that confusion
// once (#1861, where a retry budget with no wall-clock bound read as a hang).
function resolve(name: string, seen: map<string, bool>, active: map<string, bool>, order: []string): ([]string, bool) {
  if (seen[name]) {
    return order, true
  }
  if (active[name]) {
    eprint("make: dependency cycle through step '${name}'\n")
    return order, false
  }
  let (st, ok) = findStep(name)
  if (!ok) {
    eprint("make: unknown step '${name}'\n")
    eprint("make: run `./make --list` for the available steps\n")
    return order, false
  }
  active[name] = true
  let acc = order
  for d of st.deps {
    let (next, dok) = resolve(d, seen, active, acc)
    acc = next
    if (!dok) {
      return acc, false
    }
  }
  active[name] = false
  seen[name] = true
  return append(acc, name), true
}

// Every body is a stub until #1869/#1870. It must EXIT NON-ZERO: a step that
// exists and quietly succeeds is a gate reporting green for an assertion it
// never made, which is the whole failure this driver is being written carefully
// to avoid (defs.bit's header, and scripts/stage0.sh's).
function runStep(name: string): int {
  eprint("make: step '${name}' is not implemented yet\n")
  return 1
}

// Returns the requested step names, and whether the invocation was already
// fully handled (`--list`/`--help` print and stop).
function parseArgs(argv: []string): ([]string, bool) {
  let wanted = []string(0)
  let i = 1
  while (i < len(argv)) {
    let a = argv[i]
    if (a == "--list") {
      listSteps()
      return wanted, true
    }
    if (a == "--help" || a == "-h") {
      usage()
      return wanted, true
    }
    if (len(a) > 0 && a[0] == '-') {
      eprint("make: unknown option '${a}'\n")
      usage()
      exit(2)
    }
    wanted = append(wanted, a)
    i = i + 1
  }
  if (len(wanted) == 0) {
    wanted = append(wanted, defaultStep())
  }
  return wanted, false
}

// Resolve EVERYTHING before running anything, so an unknown step name fails
// immediately instead of after a long dependency has already been built.
function planAll(wanted: []string): ([]string, bool) {
  let seen = map<string, bool>{}
  let active = map<string, bool>{}
  let order = []string(0)
  for w of wanted {
    let (next, ok) = resolve(w, seen, active, order)
    order = next
    if (!ok) {
      return order, false
    }
  }
  return order, true
}

// Stops at the first failure: later steps consume this one's output, and
// running them anyway produces cascading errors that bury the real cause.
function runAll(order: []string): []string {
  let failed = []string(0)
  for s of order {
    print("make: ${s}\n")
    if (runStep(s) != 0) {
      failed = append(failed, s)
      return failed
    }
  }
  return failed
}

function main() {
  let (wanted, done) = parseArgs(args())
  if (done) {
    return
  }
  let (order, ok) = planAll(wanted)
  if (!ok) {
    exit(2)
  }
  let failed = runAll(order)
  if (len(failed) != 0) {
    eprint("make: FAILED: ${join(failed, " ")}\n")
    exit(1)
  }
}
