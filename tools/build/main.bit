// The Bit build driver (#1868, epic #1867).
//
// Invoked through `./make`, which resolves the pinned stage0, compiles this
// directory with it, and execs the result. See `defs.bit` for the step registry
// and for why every step is declared before any body exists.
//
// SCOPE OF THIS COMMIT: dispatch only. `--list`, argument handling and
// dependency ordering are real; every step BODY exits non-zero saying it is not
// implemented. #1869 fills in the artifact steps and #1870 the test steps.
// This driver is authoritative: `./make <step>` is the only supported way to
// build and test this repo.

import { args, exit } from "std/os"
import { join } from "std/strings"
import { monotonic, since, Second } from "std/time"

// `./make` with no step runs `install`, and the scripts that call the default
// rely on that.
fn defaultStep(): string { return "install" }

fn usage() {
  eprint("usage: ./make [--list] [<step>...] [-- <arg>...]\n")
  eprint("  no step runs '${defaultStep()}'\n")
  eprint("  --list  print every step and its description\n")
  eprint("  --      pass the remaining arguments to the step (only `fuzz` takes any)\n")
}

fn listSteps() {
  for s of steps() {
    // Two columns, padded so the list stays scannable as the step count grows.
    print("${padRight(s.name, 28)} ${s.desc}\n")
  }
}

fn padRight(s: string, w: int): string {
  let out = s
  while (len(out) < w) {
    out = out + " "
  }
  return out
}

// Whole minutes and seconds, always both — the shape every consumer of a
// timing line parses (#2561's acceptance is literally `[0-9]+m[0-9]+s`), so a
// sub-minute gate reads "0m3s" rather than switching format underfoot.
fn formatDuration(elapsedNs: int): string {
  let totalSecs = elapsedNs / Second
  let m = totalSecs / 60
  let s = totalSecs % 60
  return "${m}m${s}s"
}

// Depth-first postorder so a step's dependencies run before it, with `seen`
// making a step that several others depend on run exactly once.
//
// A cycle would otherwise recurse forever. `active` catches it and reports the
// step it closed on, because a build driver that hangs is indistinguishable
// from one doing slow work — and this repo has already paid for that confusion
// once (#1861, where a retry budget with no wall-clock bound read as a hang).
fn resolve(
  name: string,
  seen: map<string, bool>,
  active: map<string, bool>,
  order: []string,
): ([]string, bool) {
  if (seen[name]) {
    return order, true
  }
  if (active[name]) {
    eprint("make: dependency cycle through step '${name}'\n")
    return order, false
  }
  let (st, ok) = findStep(name)
  if (!ok) {
    eprint("make: unknown step '${name}'\n")
    eprint("make: run `./make --list` for the available steps\n")
    return order, false
  }
  active[name] = true
  let acc = order
  for d of st.deps {
    let (next, dok) = resolve(d, seen, active, acc)
    acc = next
    if (!dok) {
      return acc, false
    }
  }
  active[name] = false
  seen[name] = true
  return append(acc, name), true
}

// The artifact steps are implemented (#1869); the `test-*` steps land in #1870.
//
// An unimplemented step still EXITS NON-ZERO: a step that exists and quietly
// succeeds is a gate reporting green for an assertion it never made, which is
// the failure this driver is written carefully to avoid (defs.bit's header, and
// scripts/stage0.sh's).
//
// The second return is whether the step did real work, as opposed to a
// fingerprint-matched short-circuit — `runAll` uses it to decide whether its
// timing line reports a duration or labels the step "up to date" (#2565).
// Only `libbitrt`/`selfhost` can ever short-circuit, so every other step
// reports `true` unconditionally.
fn runStep(name: string, extras: []string): (int, bool) {
  if (name == "install") {
    return stepInstall(), true
  }
  if (name == "uninstall") {
    return stepUninstall(), true
  }
  if (name == "libbitrt" || name == "selfhost") {
    return runArtifact(name)
  }
  return runNonArtifactStep(name, extras)
}

// Everything that is not an artifact or a prefix operation: the read-only
// dumps, the two open-ended fuzz steps, the two umbrellas, and the generic
// `runGate` fallback every `test-*` name reaches.
//
// Split out of `runStep` rather than added to it (#3255): that chain was at
// the repo's E0204 complexity ceiling of 10 (spec/LINT.md:186) and one more
// `if` would have crossed it. The cut is on the same line the two policies
// in `runAll` already draw — a failed artifact stops the run, nothing below
// here does.
fn runNonArtifactStep(name: string, extras: []string): (int, bool) {
  if (name == "dump-abi-symbols") {
    return stepDumpAbiSymbols(), true
  }
  if (name == "dump-layout-consts") {
    return stepDumpLayoutConsts(), true
  }
  if (name == "fuzz") {
    return stepFuzz(extras), true
  }
  if (name == "fuzz-regex") {
    return stepFuzzRegex(extras), true
  }
  if (name == "test-prepush") {
    // NOT an umbrella: it owns its own scheduling (gatesprepush.bit), which
    // is the whole point — `deps` cannot express "these two concurrently,
    // those eleven alone afterwards".
    return stepPrepush(), true
  }
  if (name == "test") {
    // Pure umbrella: `planAll` has already scheduled every gate ahead of it.
    // `runAll` never prints a timing line for `test` at all, so this second
    // value is never read.
    return 0, true
  }
  return runGate(name), true
}

// Both artifact steps need stage0, and resolving it can fail (no network, a
// digest mismatch, an unreadable override). Resolve once, here, so neither body
// has to carry the failure path twice.
fn runArtifact(name: string): (int, bool) {
  let (stage0, ok) = resolveStage0()
  if (!ok) {
    return 1, true
  }
  if (name == "libbitrt") {
    return stepLibbitrt(stage0)
  }
  return stepSelfhost(stage0)
}

// Returns the requested step names, the arguments after `--` for the step to
// consume, and whether the invocation was already fully handled (`--list` and
// `--help` print and stop).
fn parseArgs(argv: []string): ([]string, []string, bool) {
  let wanted = []string(0)
  let extras = []string(0)
  let i = 1
  while (i < len(argv)) {
    let a = argv[i]
    if (a == "--") {
      // Everything after is the step's, verbatim — including anything that
      // looks like an option, which is the whole point of the separator.
      extras = argv[i + 1:]
      i = len(argv)
      continue
    }
    if (a == "--list") {
      listSteps()
      return wanted, extras, true
    }
    if (a == "--help" || a == "-h") {
      usage()
      return wanted, extras, true
    }
    if (len(a) > 0 && a[0] == '-') {
      eprint("make: unknown option '${a}'\n")
      usage()
      exit(2)
    }
    wanted = append(wanted, a)
    i = i + 1
  }
  if (len(wanted) == 0) {
    wanted = append(wanted, defaultStep())
  }
  return wanted, extras, false
}

// Resolve EVERYTHING before running anything, so an unknown step name fails
// immediately instead of after a long dependency has already been built.
fn planAll(wanted: []string): ([]string, bool) {
  let seen = map<string, bool>{}
  let active = map<string, bool>{}
  let order = []string(0)
  for w of wanted {
    let (next, ok) = resolve(w, seen, active, order)
    order = next
    if (!ok) {
      return order, false
    }
  }
  return order, true
}

// Is this step one of the gates? Asked of `gateNames()` rather than by matching
// a "test-" prefix, so a gate that is ever named otherwise cannot silently fall
// into the wrong policy below.
fn isGate(name: string): bool {
  for g of gateNames() {
    if (g == name) {
      return true
    }
  }
  return false
}

// Flushes a run of accumulated non-exclusive gate names through
// `runGateBatch`.
//
// #2561 gave this function its own wall-clock print because a flush of
// several gates had no per-gate start/stop visible from here: the batch
// engine (`gatesexec.bit`) fans the batch out into one composed shell script
// and only IT knew when each gate individually started and finished, so
// reporting a made-up per-gate split would have been exactly the
// unverified-number problem this driver exists to avoid.
//
// #2562 closed that gap: `gateBatchUnit` now captures a real start/stop
// around each gate's own `exec` inside its backgrounded subshell, and
// `runGatePool` prints an honest, individually-measured
// "make: <name> — <dur>" line for every gate in the batch it runs —
// including a flush of exactly one. That makes this function's own timer
// redundant in every case (single gate: a second, duplicate line; several
// gates: a `gate batch (...) — total <dur>` line sitting on top of the real
// per-gate lines it used to stand in for), so this no longer measures or
// prints anything of its own; it is purely a name-batching pass-through.
fn flushPending(pending: []string, failed: []string): []string {
  if (len(pending) == 0) {
    return failed
  }
  let next = failed
  for f of runGateBatch(pending) {
    next = append(next, f)
  }
  return next
}

// TWO POLICIES, because the steps are two different kinds of thing.
//
// An ARTIFACT failure stops the run: every later step reads `bit` or
// `libbitrt.a` off disk, so continuing produces a cascade of errors that buries
// the real cause — or worse, runs gates against a stale binary.
//
// A GATE failure does NOT stop it. The gates are independent and `test` reports
// all of them; stopping at the first would mean one red harness hides the state
// of the other twenty-two, so a run would have to be repeated
// once per failure to learn what is actually broken. Every failure is collected
// and named at the end instead.
//
// A gate takes a THIRD path first (#2434, #4706): every non-`exclusive` gate
// is accumulated into `pending` instead of run immediately, and the whole
// accumulation runs as ONE bounded pool (`runGateBatch`, gatesexec.bit) when
// a non-gate step needs to run next, or at the end of the order.
//
// #4706: an `exclusive` gate no longer flushes that pool. It used to, and
// with fourteen of them scattered through `gateNames()` that split the run
// into fifteen pools, each paying its own longest member — the barrier this
// ticket exists to remove, one flush per exclusive gate. They are deferred
// instead and run one at a time AFTER the pool has drained, which is also
// the only time the box is quiet enough for the wall-clock and RSS
// assertions that made them exclusive in the first place. A non-gate step
// still drains everything before it runs, so nothing crosses an artifact
// boundary.
//
// `BIT_MAKE_JOBS=1` keeps today's order exactly: `serial` turns the deferral
// off, so an exclusive gate flushes and runs in place, and the pool itself
// holds one gate at a time in the order given (`poolStartOrder`).

// One step, run in place: the print, the timing line and the verdict shared
// by every step that does not go through the pool. Returns (failed, stop) —
// `stop` is true only for a failed ARTIFACT step, never for a gate. The
// caller owns the failure list and appends the name itself, so nothing here
// appends to an array it does not own (E0214).
fn runStepNow(s: string, extras: []string): (bool, bool) {
  print("make: ${s}\n")
  let start = monotonic()
  let (rc, ran) = runStep(s, extras)
  printStepDone(s, rc, ran, since(start))
  if (rc == 0) {
    return false, false
  }
  return true, !isGate(s)
}

// Drains both accumulators in order: the pool first, then the deferred
// `exclusive` gates one at a time, on the quiet box the drained pool leaves
// behind.
fn drainGates(pending: []string, deferred: []string, extras: []string, failed: []string): []string {
  let next = flushPending(pending, failed)
  for d of deferred {
    let (bad, stop) = runStepNow(d, extras)
    if (bad) {
      next = append(next, d)
    }
    if (stop) {
      // Unreachable by construction: `deferred` holds gate names only, and
      // `runStepNow` reports stop only for a non-gate step. Checked rather
      // than discarded so a future caller cannot silently lose it.
      return next
    }
  }
  return next
}

fn runAll(order: []string, extras: []string): []string {
  let failed = []string(0)
  let pending = []string(0)
  let deferred = []string(0)
  let serial = makeJobs() <= 1
  let i = 0
  let n = len(order)
  while (i < n) {
    let s = order[i]
    i = i + 1
    if (isGate(s)) {
      if (!isExclusiveGate(s)) {
        pending = append(pending, s)
        continue
      }
      if (!serial) {
        deferred = append(deferred, s)
        continue
      }
    }
    failed = drainGates(pending, deferred, extras, failed)
    pending = []string(0)
    deferred = []string(0)
    let (bad, stop) = runStepNow(s, extras)
    if (bad) {
      failed = append(failed, s)
    }
    if (stop) {
      return failed
    }
  }
  return drainGates(pending, deferred, extras, failed)
}

// The line after a non-gate step's body returns. Four cases, not a bare
// duration every time, because "0m0s" reads as "this took no time" no matter
// which of several very different things actually happened (#2565, #2566):
//
//   - `test` is a pure umbrella: `runStep` never gives it any work, and
//     `main()` already prints the one line that matters for it,
//     `make: test — total <dur>`. A second, always-`0m0s` line here would sit
//     immediately above that total and read as "the whole suite was
//     instant".
//   - `install` is the same shape (#2566): `stepInstall()` (artifacts.bit)
//     does nothing itself — all the real work is its dependencies
//     (`libbitrt`, `selfhost`), which already printed their own real
//     durations above it, and `main()` prints `make: install — total <dur>`
//     right after. Guarded on `rc == 0`, unlike `test` above: `stepInstall`
//     is hardcoded to return 0 today, but if that ever changes, a failing
//     `install` must still print its real duration instead of being
//     suppressed as if nothing happened.
//   - `libbitrt`/`selfhost` short-circuit when their rebuild fingerprint
//     already matches (artifacts.bit) — `ran` is `false` exactly then, and
//     only paired with success. A failed short-circuit attempt (unsupported
//     host, a missing archive) still gets its real duration: mislabeling a
//     failure as "up to date" would hide that something is wrong.
//   - Everything else always ran, so it gets its real, meaningful duration —
//     unchanged from before this ticket.
fn printStepDone(name: string, rc: int, ran: bool, elapsedNs: int) {
  if (name == "test") {
    return
  }
  if (name == "install" && rc == 0) {
    return
  }
  if (rc == 0 && !ran) {
    print("make: ${name} — up to date\n")
    return
  }
  print("make: ${name} — ${formatDuration(elapsedNs)}\n")
}

fn main() {
  let (wanted, extras, done) = parseArgs(args())
  if (done) {
    return
  }
  let (order, ok) = planAll(wanted)
  if (!ok) {
    exit(2)
  }
  let start = monotonic()
  let failed = runAll(order, extras)
  print("make: ${join(wanted, " ")} — total ${formatDuration(since(start))}\n")
  if (len(failed) != 0) {
    eprint("make: FAILED: ${join(failed, " ")}\n")
    exit(1)
  }
}
