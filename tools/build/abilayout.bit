// #4189: split out of tools/build/abiarity.bit to stay under the 800-line
// ceiling (spec/LINT.md:186, E0200) once that file's arity parser gained
// #4189's multi-line signature join and hard-fail-on-unparseable behaviour.
// Pure move, no behaviour change — see abiarity.bit's own header for why the
// two checks (declared ARITY vs. object LAYOUT) exist and how they share the
// stage0 runtime extraction `checkRuntimeAbiArity` already performed.
//
// Same module as abiarity.bit (tools/build/), so `trimSpace` and `indexOf`
// (imported there from std/strings) are visible here without a second
// import — re-importing either would be E0042 already declared in this
// scope. `parseInt` is imported below instead of there: this file is its
// only caller in the module.

import { parseInt } from "std/strings"

// #3893: `checkRuntimeAbiArity` above compares declared ARITIES — how many
// words a call passes — against the pinned stage0. It cannot see a LAYOUT
// change: which field lives at which byte offset inside a compiler-emitted
// object. #3891 is what that gap cost: the string header widened from two
// words to three in `runtime/**` while the pinned stage0 still emitted (and
// every other reader still expected) the two-word shape — a hard crash on
// x86_64-linux, and on aarch64-macos a silent miscompile where every
// `BIT_*` environment variable stopped working with no diagnostic anywhere.
//
// Deliberately a short, explicit, hand-picked list — not "every const in
// runtime/root/root.bit". Only fields a compiler-emitted literal (string,
// slice) actually writes, or that codegen itself must agree with the
// runtime on (the GC object header size), are a data contract with the
// pinned compiler in the way an extern arity is. A constant nothing outside
// `runtime/**` reads or writes (e.g. `slcHeaderSize`'s own internal helper
// constants, if any existed) would not belong here even if it happened to
// be a layout number, because stage0 has no baked-in expectation of it to
// diverge from.
class LayoutConst {
  file: string, // relative to `runtime/`
  name: string,
}

fn abiLayoutConsts(): []LayoutConst {
  return [
    LayoutConst{ file: "root/root.bit", name: "strPtr" },
    LayoutConst{ file: "root/root.bit", name: "strLen" },
    LayoutConst{ file: "root/root.bit", name: "strHeaderSize" },
    LayoutConst{ file: "root/root.bit", name: "strBase" },
    LayoutConst{ file: "root/root.bit", name: "strAllocHeader" },
    LayoutConst{ file: "root/root.bit", name: "slcBuf" },
    LayoutConst{ file: "root/root.bit", name: "slcLen" },
    LayoutConst{ file: "root/root.bit", name: "slcOff" },
    LayoutConst{ file: "root/root.bit", name: "slcCap" },
    LayoutConst{ file: "root/root.bit", name: "slcIsRef" },
    LayoutConst{ file: "root/root.bit", name: "slcHeaderSize" },
    LayoutConst{ file: "gc/gc.bit", name: "gcHeaderSize" },
  ]
}

class LayoutMismatch {
  name: string,
  file: string,
  treeValue: int,
  stage0Value: int,
}

fn isConstNameByte(c: byte): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// Finds `const <name>` (with or without a leading `export`) and returns the
// integer literal after its `=`, ignoring any trailing `//` comment on the
// same line. Word-bounded on both sides — via `isConstNameByte` immediately
// before and after the match — so searching for `strLen` cannot match
// inside a hypothetical `strLenExtra`, the same false-match risk this
// file's own `parseArity` already guards against for a different token.
// True when `text[absAt:afterMarker]` (the just-matched "const <name>") is
// not itself a substring of a longer identifier — the char immediately
// before `absAt` and immediately after `afterMarker` must both be absent or
// non-identifier, or e.g. `strLen` would match inside a hypothetical
// `strLenExtra`. Split out of `parseNamedConst` to keep both under the
// complexity-10 ceiling (spec/LINT.md:186, E0204).
fn constNameBoundaryOk(text: string, absAt: int, afterMarker: int): bool {
  let precededOk = absAt == 0 || !isConstNameByte(text[absAt - 1])
  let followedOk = afterMarker >= len(text) || !isConstNameByte(text[afterMarker])
  return precededOk && followedOk
}

// Parses the integer literal after the first `=` on the line starting at
// `afterMarker`, ignoring a trailing `//` comment. `ok` is false when the
// line has no `=` or the text after it is not a valid integer literal.
fn parseConstLineValue(text: string, afterMarker: int): (int, bool) {
  let restOfLine = text[afterMarker:]
  let nlAt = indexOf(restOfLine, "\n")
  let line = restOfLine
  if (nlAt >= 0) {
    line = restOfLine[:nlAt]
  }
  let eqAt = indexOf(line, "=")
  if (eqAt < 0) {
    return 0, false
  }
  let valuePart = trimSpace(line[eqAt + 1:])
  let commentAt = indexOf(valuePart, "//")
  if (commentAt >= 0) {
    valuePart = trimSpace(valuePart[:commentAt])
  }
  let parsedOk = true
  let value = parseInt(valuePart) catch _ {
    parsedOk = false
    0
  }
  return value, parsedOk
}

fn parseNamedConst(text: string, name: string): (int, bool) {
  let marker = "const " + name
  let searchFrom = 0
  while (true) {
    let at = indexOf(text[searchFrom:], marker)
    if (at < 0) {
      return 0, false
    }
    let absAt = searchFrom + at
    let afterMarker = absAt + len(marker)
    searchFrom = afterMarker
    if (!constNameBoundaryOk(text, absAt, afterMarker)) {
      continue
    }
    let (value, ok) = parseConstLineValue(text, afterMarker)
    if (ok) {
      return value, true
    }
  }
}

// Reads `lc`'s value out of `root + "/" + lc.file"` — `root` is `"runtime"`
// for the working tree, or `extractStage0Runtime`'s returned directory for
// the pinned tag, so the same `LayoutConst` table answers both sides.
fn layoutConstValue(root: string, lc: LayoutConst): (int, bool) {
  let text = readFile(root + "/" + lc.file) catch _ {
    return 0, false
  }
  return parseNamedConst(text, lc.name)
}

// Compares `abiLayoutConsts()` between the working tree and the already-
// extracted `stage0RuntimeDir` (`checkRuntimeAbiArity` extracts it once and
// passes it in, reusing the same `git archive` this check needs). Returns
// false — and has already printed the diagnostic — when the build must not
// proceed.
fn checkRuntimeAbiLayout(stage0RuntimeDir: string, tag: string): bool {
  let mismatches = []LayoutMismatch(0)
  for lc of abiLayoutConsts() {
    let (treeValue, tok) = layoutConstValue("runtime", lc)
    let (stage0Value, sok) = layoutConstValue(stage0RuntimeDir, lc)
    // A constant this table expects but cannot find on either side is an
    // infrastructure fact (renamed file, moved constant), not a proven
    // layout mismatch — skip it rather than refuse a build over a check
    // that could not actually run, same posture as the arity check's own
    // "too few symbols parsed" guard above.
    if (!tok || !sok) {
      continue
    }
    if (treeValue != stage0Value) {
      mismatches = append(
        mismatches,
        LayoutMismatch{
          name: lc.name,
          file: lc.file,
          treeValue: treeValue,
          stage0Value: stage0Value,
        },
      )
    }
  }
  if (len(mismatches) == 0) {
    return true
  }
  eprint("make: selfhost: refusing to link — runtime object LAYOUT mismatch against the pinned stage0 (${tag}):\n")
  for m of mismatches {
    eprint("make:   ${m.name} (runtime/${m.file}): stage0 (${tag}) was built expecting ${m.stage0Value}; this tree's runtime/** now declares ${m.treeValue}\n")
  }
  eprint("make: stage0 is the compiler that EMITS this object's layout (string/slice header fields, the GC header size) into every program it builds. It cannot re-read runtime/**'s new constant, so linking would succeed and produce a silent miscompile — a hard crash on one platform, and on another, running code that reads the wrong bytes with no diagnostic anywhere (#3891).\n")
  eprint("make: BIT_LIBBITRT_TREE=1 does NOT fix this — it still builds L0 with the PINNED stage0 compiling THIS tree's runtime source (stepLibbitrtTree, artifactsteps.bit), so L0 carries the identical mismatch.\n")
  eprint("make: land this with the three-pass bootstrap instead (#3891's recipe):\n")
  eprint("make:   BIT_LIBBITRT=<main's libbitrt.a for this host> bit-out/stage0/bit-oracle build compiler -o \$TMPDIR/p1   # a self-consistent compiler: new compiler/** source, OLD (matching) runtime archive\n")
  eprint("make:   BIT=\$TMPDIR/p1 bash scripts/g2archive.sh <target> \$TMPDIR/libbitrt-p1-<target>.a                        # a runtime archive whose layout matches the NEW reader\n")
  eprint("make:   BIT_LIBBITRT=\$TMPDIR/libbitrt-p1-<target>.a \$TMPDIR/p1 build <program> -o <out> -t <target>            # build a program against the matched pair\n")
  return false
}

// #4416: read-only utility for `dist/abitwopass.py`'s LAYOUT-transition
// derivation, mirroring `stepDumpAbiSymbols` (abiarity.bit) exactly. Prints
// `name\tvalue\tfile` for every `abiLayoutConsts()` entry found under
// $BIT_ABI_SCAN_DIR, reusing `layoutConstValue` — the SAME parser
// `checkRuntimeAbiLayout`'s own mismatch detection trusts, rather than a
// second, hand-rolled reader that could silently drift from it. A constant
// this table names but that is not present under the scan dir is silently
// skipped, not an error: the caller (`dist/abitwopass.py`'s
// `layout_value_at_commit`) extracts one historical file at a time into an
// otherwise-empty scratch dir and only ever looks up the one constant it
// asked for. Informational only: never gated, never part of `test`.
fn stepDumpLayoutConsts(): int {
  let dir = env("BIT_ABI_SCAN_DIR")
  if (dir == "") {
    eprint("make: dump-layout-consts: BIT_ABI_SCAN_DIR is not set\n")
    return 1
  }
  for lc of abiLayoutConsts() {
    let (value, ok) = layoutConstValue(dir, lc)
    if (ok) {
      print("${lc.name}\t${value}\t${lc.file}\n")
    }
  }
  return 0
}

// #4435: #4428 folds a slice header's `off` word to the constant 0
// whenever the header is provably a `bit_rt_slice_new` result. That fold
// is sound only because every WRITE this runtime makes to `slcOff` inside
// an EXISTING header stores the literal 0 — a reslice makes a new object
// instead. Today that was asserted only by a comment in
// compiler/optzerooff.bit's header:
//
//   git grep -c 'storeWord(.*slcOff' -- runtime/   ->  runtime/root/slices.bit:4
//
// This makes it checkable: scan `root`'s runtime/** source for every
// `storeWord(<target> + slcOff, <value>)` write site and assert the
// enumerated shape still holds. A fifth writer storing a non-zero value
// into an EXISTING header would make every access the fold fired on read
// `buf[index]` where it should read `buf[off + index]` — a silent wrong
// answer, not a crash, visible only through a view.
class SlcOffWrite {
  file: string, // relative to `root`
  line: int,    // 1-based
  target: string,
  value: string,
  text: string,
}

// True for a line containing a `storeWord(` call whose first argument adds
// `slcOff` — the write-site shape this check enumerates. A plain substring
// test, not a full expression parser: every write site in this corpus is a
// single `storeWord(<target> + slcOff, <value>)` call on one line, and a
// change that splits one across lines or renames the constant must fail
// this check's shape assertion below rather than silently stop finding the
// site.
fn looksLikeSlcOffWrite(line: string): bool {
  return contains(line, "storeWord(") && contains(line, "slcOff")
}

// Parses `storeWord(<target> + slcOff, <value>)` out of `line`. `ok` is
// false when the line matched `looksLikeSlcOffWrite` textually but is not
// in this exact shape (e.g. `slcOff` only appears in a trailing comment) —
// the caller must treat that as an unclassifiable write, never drop it
// silently.
fn parseStoreWordSlcOff(line: string): (string, string, bool) {
  let marker = "storeWord("
  let at = indexOf(line, marker)
  if (at < 0) {
    return "", "", false
  }
  let afterOpen = at + len(marker)
  let rest = line[afterOpen:]
  let plusMarker = " + slcOff,"
  let plusAt = indexOf(rest, plusMarker)
  if (plusAt < 0) {
    return "", "", false
  }
  let target = trimSpace(rest[:plusAt])
  let afterComma = rest[plusAt + len(plusMarker):]
  let closeAt = indexOf(afterComma, ")")
  if (closeAt < 0) {
    return "", "", false
  }
  let value = trimSpace(afterComma[:closeAt])
  return target, value, true
}

// Every `storeWord(... + slcOff, ...)` write site under `root`'s
// runtime/** source, in walk order. `root` is `"runtime"` for the real
// working tree, or a scratch copy for the mutation control this check's
// own acceptance criterion demands (#4435) — never the real
// runtime/root/slices.bit, which this check must never write to.
fn scanSlcOffWrites(root: string): []SlcOffWrite {
  let out = []SlcOffWrite(0)
  let prefix = root + "/"
  for p of walkBit(root) {
    let relPath = p
    if (hasPrefix(p, prefix)) {
      relPath = p[len(prefix):]
    }
    let text = readFile(p) catch _ {
      continue
    }
    let lines = split(text, "\n")
    let i = 0
    while (i < len(lines)) {
      let line = lines[i]
      if (looksLikeSlcOffWrite(line)) {
        out = append(out, slcOffWriteAt(relPath, i + 1, line))
      }
      i = i + 1
    }
  }
  return out
}

// Split out of `scanSlcOffWrites` to keep it under the complexity-10
// ceiling (spec/LINT.md:186, E0204) once the unparsed-shape fallback below
// was added.
fn slcOffWriteAt(relPath: string, lineNo: int, line: string): SlcOffWrite {
  let (target, value, ok) = parseStoreWordSlcOff(line)
  let t = target
  let v = value
  if (!ok) {
    t = "<unparsed>"
    v = "<unparsed>"
  }
  return SlcOffWrite{ file: relPath, line: lineNo, target: t, value: v, text: trimSpace(line) }
}

// Classifies `writes` — already scanned by `scanSlcOffWrites` — against
// #4428's own soundness argument: exactly 4 write sites, all in
// `root/slices.bit`, exactly 3 storing the literal 0, and the 4th storing
// into `nh` (rtSliceSlice's freshly gcAlloc'ed header, never an existing
// one). Returns every violation found, empty when the shape holds. Split
// out of `checkSlcOffWriteSites` to keep both under the complexity-10
// ceiling (E0204).
fn slcOffWriteProblems(writes: []SlcOffWrite): []string {
  let problems = []string(0)
  if (len(writes) != 4) {
    problems = append(problems, "expected exactly 4 write site(s), found ${len(writes)}")
  }
  let zeroCount = 0
  let nonZero = []SlcOffWrite(0)
  for w of writes {
    if (w.file != "root/slices.bit") {
      problems = append(
        problems,
        "${w.file}:${w.line} writes slcOff outside root/slices.bit: ${w.text}",
      )
      continue
    }
    if (w.value == "0") {
      zeroCount = zeroCount + 1
    } else {
      nonZero = append(nonZero, w)
    }
  }
  if (zeroCount != 3) {
    problems = append(
      problems,
      "expected exactly 3 write(s) storing the literal 0, found ${zeroCount}",
    )
  }
  if (len(nonZero) != 1) {
    problems = append(problems, "expected exactly 1 non-zero write, found ${len(nonZero)}")
  } else if (nonZero[0].target != "nh") {
    let w = nonZero[0]
    problems = append(
      problems,
      "${w.file}:${w.line} writes a non-zero, non-'nh' target — expected the reslice's freshly allocated header ('nh'): ${w.text}",
    )
  }
  return problems
}

// The entry point: scans `root`'s runtime/** for `slcOff` write sites and
// refuses when #4428's zero-off fold invariant does not hold. Prints the
// full write-site list on BOTH the pass and the fail path — deliberately: a
// scan that matched nothing must be distinguishable from one that matched
// the expected four, the same trap `ARM64_RELOC_BRANCH26` and the
// `compiler/**/*.bit` glob already caught in this repo (both silently
// returned 0 and read as a clean tree).
fn checkSlcOffWriteSites(root: string): bool {
  let writes = scanSlcOffWrites(root)
  eprint("make: slcoff-writesites: ${len(writes)} storeWord(... + slcOff, ...) write site(s) found under ${root}/:\n")
  for w of writes {
    eprint("make:   ${w.file}:${w.line}: ${w.text}\n")
  }
  let problems = slcOffWriteProblems(writes)
  if (len(problems) == 0) {
    eprint("make: slcoff-writesites: OK — the shape #4428's zero-off fold relies on holds (3 write(s) of the literal 0, 1 write into a freshly allocated header)\n")
    return true
  }
  eprint("make: slcoff-writesites: refusing — #4428's zero-off fold (compiler/optzerooff.bit) is sound only if every write this runtime makes to an EXISTING slice header's off word is 0. A write that violates this makes every folded access read buf[index] where it should read buf[off + index] — a silent wrong answer, not a crash:\n")
  for p of problems {
    eprint("make:   ${p}\n")
  }
  return false
}
