// The step registry for the Bit build driver (#1868, epic #1867).
//
// It is not a rewrite of anything hard: 25 of the 31 steps below only launch a
// `_tests_/bit/*.bit` program, `selfhost` shells out to the pinned stage0, and
// `libbitrt` shells out to `scripts/g2archive.sh`. Every piece of actual
// compilation is already `bit`. What this file contributes is the part that is
// not compilation: step naming, dependency edges, environment variables, the
// rebuild fingerprint, and bounded process fan-out.
//
// WHY EVERY STEP IS REGISTERED NOW, INCLUDING THE ONES WITH NO BODY YET
//
// The bodies land in #1869 (artifacts) and #1870 (tests). They are declared
// here anyway, and an unimplemented one EXITS NON-ZERO rather than doing
// nothing. A driver is the gate every other gate runs behind, so a step that
// exists and silently succeeds reports green for an assertion it never made —
// the failure this repo's tooling is repeatedly written against, from
// `scripts/stage0.sh`'s header ("a gate that cannot reach its oracle and exits
// 0 is worse than no gate") to `pollfree`'s floors to `abimembers`'s demand
// oracle. Registering the full set up front also makes `--list` the checkable
// definition of what steps exist — `scripts/gate.sh` reads it to refuse a
// bucket that names a step this file does not declare.
//
// THE NAMES ARE NOT FREE TO CHANGE. `scripts/gate.sh` validates its per-bucket
// step names against the step list and exits 2 on a stale one, and fifteen
// `scripts/selfhost-diff*.sh` invoke `selfhost` by name. Renaming any of these
// is out of scope here and is called out again on #1871.

class Step {
  name: string,
  desc: string,
  deps: []string,
}

// Every test harness needs the compiler and the runtime archive to exist first.
fn gateDeps(): []string {
  return ["selfhost", "libbitrt"]
}

fn noDeps(): []string {
  return []string(0)
}

// #5603: every step below but a handful of foundational/umbrella ones depends
// on exactly `gateDeps()`, and a `Step{name = "...", desc = "...", deps =
// gateDeps()}` literal reflows to one field per line under canonical `bit
// fmt` the moment the combined line exceeds the 100-column width
// (`fmtMaxWidth`, compiler/fmt.bit) — true of nearly every description here,
// which pushed this file to 1181+ formatted lines. A string literal is never
// reflowed internally, so a "name<TAB>description" row stays on exactly one
// physical line no matter how long the description is. Precedent: #2743
// collapsed six near-identical scripts into one driver plus a declarative
// data table for the same reason — the per-item shape belongs in data, not
// in a construct the formatter is free to re-lay-out. `deps` is not part of
// the row because it does not vary across this class of step; the few steps
// whose deps differ (test, libbitrt, selfhost, uninstall,
// dump-abi-symbols, dump-layout-consts) stay explicit Step{} literals below.
fn gateDepStep(row: string): Step {
  let parts = split(row, "\t")
  if (len(parts) != 2) {
    panic("defs.bit: malformed step row (want name<TAB>desc): ${row}")
  }
  return Step{ name = parts[0], desc = parts[1], deps = gateDeps() }
}

// One entry per step, in the order `--list` prints them, so the list stays
// readable by eye as well as mechanically.
fn steps(): []Step {
  let groups = [
    coreSteps(), allGateSteps(), packageSteps(), packageSurfaceSteps(), redisLiveSteps(),
    webGuidesAppSteps(), s3LiveSteps(), jobsLiveSteps(), ormLiveSteps(), bookInkLiveSteps(),
    relShapesLiveSteps(), mailLiveSteps(),
  ]
  return concatSteps(groups)
}

fn concatSteps(groups: [][]Step): []Step {
  let out = []Step(0)
  for group of groups {
    for s of group {
      out = append(out, s)
    }
  }
  return out
}

// The artifact and umbrella steps. `install` is what `./make` with no argument
// runs.
fn coreSteps(): []Step {
  return concatSteps([coreStepsA(), coreStepsB(), coreStepsC(), coreStepsD()])
}

// The 25 `test-*` gates. Each runs one Bit program; #1870 fills in the bodies
// and the environment each one needs.
fn gateSteps(): []Step {
  return concatSteps(
    [
      gateStepsA(), gateStepsB(), gateStepsC(), gateStepsD(), gateStepsE(), gateStepsF(),
    ],
  )
}

fn gateStepsA(): []Step {
  return [
    gateDepStep("test-fmt\trun the Bit-source fmt-canonical gate (`bit fmt --check`) only"),
    gateDepStep("test-osenv\trun the std/os args+environment round-trip (_tests_/bit/osenv.bit)"),
    gateDepStep("test-stdlib-docs\trun the stdlib doc-coverage gate (_tests_/bit/stdlibdocs.bit) only"),
    gateDepStep("test-stdlib-unit\trun every stdlib `*.test.bit` via `bit test stdlib` (#4212) only"),
    gateDepStep("test-gens3\trun the S3 generator tests and generated-file freshness checks only"),
    gateDepStep("test-version-cli\trun the `bit version` CLI contract (_tests_/bit/version.bit) only"),
    gateDepStep("test-lint\trun the `bit lint` CLI contract (_tests_/bit/lintcmd/lintcmd.bit) only"),
    // #2486, widened to pkg/ by #3806. Enforces a HARD ZERO E0200 findings
    // over PRODUCTION CODE ONLY (runtime/, compiler/, stdlib/, tools/,
    // pkg/) — no test tree in scope. See test-lint-filelines below for the
    // (wider, test-tree-inclusive, one-fixture-tolerant) gate this
    // complements rather than replaces.
    gateDepStep("test-lint-sweep\tenforce zero E0200 findings in runtime/, compiler/, stdlib/, tools/ and pkg/ (_tests_/bit/lintsweep.bit) only"),
    // #2515. Distinct from `test-lint` above: that one tests the `lint`
    // subcommand's own behaviour against a throwaway fixture; this one points
    // it at the tree's own `runtime/` and enforces zero E0211 (unused-local,
    // the discarded-result class #2017/#2506 both shipped). The other six
    // rule codes `bit lint runtime` also reports are deliberately NOT gated
    // here — see the harness header for why.
    gateDepStep("test-lint-runtime\tenforce zero E0211 findings in runtime/ (_tests_/bit/lintruntime.bit) only"),
    // #2747, extended to stdlib/ by #2895; widened to _tests_/stress/ by
    // #2480/#2481 and to examples/, _tests_/bit/ and _tests_/imports/ by #2974
    // (see _tests_/bit/lintfilelines.bit's own SCOPE comment). Enforces zero
    // E0200 (max-file-lines) findings across all seven — the 800-line limit
    // had no gate over any of them, and the file implementing the limit
    // itself drifted 62 lines past its own override before #2470 split it
    // back down. Deliberately E0200 only: #2567's other runtime/ findings
    // are a separate, still-open decision.
    gateDepStep("test-lint-filelines\tenforce zero E0200 findings in compiler/, runtime/, stdlib/, _tests_/stress/, examples/, _tests_/bit/, _tests_/imports/, _tests_/windows/ and _tests_/cases/ (named exemption for its own boundary fixtures) (_tests_/bit/lintfilelines.bit) only"),
    // #2453, epic #2354, rebuilt by #4149. Every rule code over compiler/,
    // runtime/, stdlib/ and tools/, at zero outside the named (code, file)
    // debt list in tools/build/lint-debt.txt (_tests_/bit/lintself),
    // asserted both ways like test-lint-aux and test-lint-tests below. It
    // replaced the tools/build/lint-ceiling.txt count ratchet (#3620's
    // runtime line and #2453's per-rule E0201/E0202 ceilings with it) on the
    // owner's 2026-09-10 ruling that a debt list is a paydown queue to zero,
    // never a count. tools/ is in scope here for the first time.
    gateDepStep("test-lint-self\tenforce zero unnamed lint findings, any rule code (except the named tools/build/lint-debt.txt debt), in compiler/, runtime/, stdlib/ and tools/ (_tests_/bit/lintself) only; also refuses irFuncOf( and an IrFunc{ literal in compiler/ outside ir.bit and *check*.bit files (irfuncctor.bit, #7075)"),
    // #4008. CLAUDE.md's other hard limit (cyclomatic complexity 10/function,
    // E0204) had no gate at all. Same production-only scope as
    // test-lint-sweep above; a downward-only per-function ratchet against
    // tools/build/complexity-debt.txt (282 named functions seeded on landing,
    // paydown tracked by epic #4109), not a hard zero.
    gateDepStep("test-lint-complexity\tenforce the per-function E0204 complexity ratchet in runtime/, compiler/, stdlib/, tools/ and pkg/ (_tests_/bit/lintcomplexity.bit) only"),
    // #4243. test-lint-complexity above and test-lint-filelines below leave
    // a hole between them: E0201/E0202/E0204 (max-fn-lines/max-params/
    // max-complexity) were never checked under _tests_/stress/, _tests_/bit/
    // or _tests_/imports/ — the former is production-only, the latter is
    // E0200-only. A hard zero since epic #4249 paid off the named-file debt
    // list it landed with and deleted BIT_LINTTESTS_DEBT along with it.
    gateDepStep("test-lint-tests\tenforce zero E0201/E0202/E0204 findings in _tests_/stress/, _tests_/bit/, _tests_/imports/ and _tests_/windows/ (_tests_/bit/linttests.bit) only"),
    // #4149. examples/, bench/ and editors/ had ONE rule enforced between
    // them (E0200 over examples/, by test-lint-filelines) and twelve that no
    // gate could fail on. Every spec/LINT.md code, at zero, against the
    // named-file BIT_LINTAUX_DEBT list below — same two-way assertion as
    // test-lint-tests, never a count.
    gateDepStep("test-lint-aux\tenforce zero unnamed lint findings, any rule code (except named debt), in examples/, bench/, editors/ and _tests_/windows/ (_tests_/bit/lintaux.bit) only"),
    // #4156. `bit.json`'s "lint" key: exit codes and diagnostics for both
    // precedence directions, the exclude/allow summary lines, and every
    // malformed-config shape, all against a real bit.json on disk.
    // #6372. Every tracked `.bit` module the tree compiles itself must check
    // with zero compiler warnings (E0098, E0048, ...): `bit check` exits 0 on a
    // warning, so no exit-code gate saw them. Whole-tree scope, declared in the
    // harness header (_tests_/bit/nowarnings.bit), wired into every bucket
    // that owns a tree in scripts/gate-buildsteps.sh.
    gateDepStep("test-no-warnings\tfail on any compiler warning[ line checking every tracked .bit module the tree compiles (_tests_/bit/nowarnings.bit) only"),
    // #6394. Every receiver form x callee kind x argument shape: `bit check`
    // and `bit build` must agree (_tests_/bit/callshapes), so no program the
    // checker accepts can fail lowering; the cells still disagreeing are named,
    // with their tickets, in the harness's known.bit.
    gateDepStep("test-call-shapes\tgenerate the receiver x callee x argument call-shape matrix and fail where bit check and bit build disagree (_tests_/bit/callshapes) only"),
    // #6417. Every expression slot x expression form, parenthesized or not, short
    // or overflowing: `bit fmt` must keep `--dump-ast` and reach its fixpoint in one
    // pass (_tests_/bit/fmtprecmatrix); test-fmt-roundtrip's corpus had no file
    // of the `catch (c ? a : b)` shape.
    gateDepStep("test-fmt-prec-matrix\tgenerate the expression slot x form matrix and fail where bit fmt changes the tree or does not reach its fixpoint (_tests_/bit/fmtprecmatrix) only"),
  ]
}

fn gateStepsB(): []Step {
  return [
    // #7396. Since #7379 map order is per-process, so compiler output that follows
    // it changes from run to run: `bit check` and the three dumps over the
    // checker-diag and golden corpora must be byte-identical under three
    // BIT_HASH_SEED values (_tests_/bit/hashseed.bit).
    gateDepStep("test-hashseed\tcompile the checker-diag and golden corpora under three BIT_HASH_SEED values and fail where check, --dump-ir, --dump-types or --dump-diags differ (_tests_/bit/hashseed.bit) only"),
    // #7751. A program linked against the aarch64-linux libbitrt.a that the TREE
    // compiler builds must run to rc=0 in bit-linux-gate:latest; every other gate
    // links the stage0-built archive, so #7750's startup SIGBUS passed them all
    // (_tests_/bit/treearchive.bit).
    gateDepStep("test-tree-archive\tbuild the aarch64-linux runtime archive with the tree compiler and run a hello-world linked against it in bit-linux-gate:latest (_tests_/bit/treearchive.bit) only"),
    // #7752. The same for x86_64-linux, run in bit-linux-gate-amd64:latest on the
    // x86 host scripts/x64host.sh resolves, under that host's /tmp/benchlock.
    gateDepStep("test-tree-archive-x64\tbuild the x86_64-linux runtime archive with the tree compiler and run a hello-world linked against it in bit-linux-gate-amd64:latest on the x86 host (_tests_/bit/treearchive.bit) only"),
    gateDepStep("test-lint-project\tthe bit.json \"lint\" key's CLI contract (_tests_/bit/lintprojectconfig.bit) only"),
    // #3713 retired the five ceiling-ratchet steps here (formerly onto one
    // shared driver, _tests_/bit/fmtceilingcheck.bit) once the whole tree
    // was reformatted: _tests_/imports/ folds into test-fmt above (zero
    // debt), and the other three trees get a hard-zero-except-named-debt
    // gate each on the new shared driver, _tests_/bit/fmtzerocheck.bit —
    // see its header, and gatesfmtdebt.bit's fmtStrictDebt()/fmtStressDebt()/
    // fmtTestsbitDebt()/fmtCasesDebt().
    gateDepStep("test-fmt-strict\tenforce zero unformatted files (except #4099's named debt) in compiler/+runtime/+tools/ (_tests_/bit/fmtzerocheck.bit) only"),
    gateDepStep("test-fmt-stress\tenforce zero unformatted files (except #4099's named debt) in _tests_/stress/ (_tests_/bit/fmtzerocheck.bit) only"),
    gateDepStep("test-fmt-testsbit\tenforce zero unformatted files (except #4099/#4101's named debt) in _tests_/bit/, tolerating unparseable fixtures (_tests_/bit/fmtzerocheck.bit) only"),
    gateDepStep("test-fmt-cases\tenforce zero unformatted files (except #4101's named debt) in _tests_/cases/, tolerating unparseable fixtures (_tests_/bit/fmtzerocheck.bit) only"),
    gateDepStep("test-fmt-docs\tenforce zero unformatted files in docs/ (_tests_/bit/fmtzerocheck.bit) only"),
    // #3724. Formats every in-scope .bit file into a scratch copy and
    // compares `--dump-ast` of the original against the formatted copy —
    // MEANING preservation, not style (_tests_/bit/fmtroundtrip.bit). Caught
    // both #3718 and #3719 in reconstruction; no other gate does.
    gateDepStep("test-fmt-roundtrip\tenforce that `bit fmt` never changes a file's `--dump-ast`, and reaches its fixpoint in one pass (_tests_/bit/fmtroundtrip.bit) only"),
    gateDepStep("test-runcmd\trun the `bit run` exit-code contract (_tests_/bit/runcmd.bit) only"),
    gateDepStep("test-root-name-collision\trun the E0096 root-module extern-collision gate (_tests_/bit/rootnamecollision.bit) only"),
    gateDepStep("test-doc-import-collision\trun the collectDoc imported-name/exported-method collision gate (_tests_/bit/docimportcollision.bit) only"),
    // #2864/#3071. E0078 (compiler/build.bit's rejectExternForTarget) is
    // gated on `linking` exactly like E0096 beside it, so it can only be
    // observed under `bit build`/`bit run` — neither _tests_/cases/ nor
    // _tests_/bit/checkercases/ can reach it, since both drive `bit check`
    // exclusively. Same bespoke-harness shape as test-root-name-collision
    // above, for the same reason.
    gateDepStep("test-extern-unresolvable\trun the E0078 unresolvable-extern gate (_tests_/bit/externunresolvable.bit) only"),
    gateDepStep("test-pkgdiamond\tprove an app importing two packages that share a third builds and runs, in workspace mode and BIT_WORKSPACE=off (_tests_/bit/pkgdiamond/) only"),
    gateDepStep("test-exec-replace\tprove bit build -o replaces an executable by rename: new inode, exec rc=0, no temp file, -o <dir> fails loudly (_tests_/bit/execreplace/) only"),
    gateDepStep("test-clicmd\trun the shared argv contract (_tests_/bit/clicmd/) only"),
    gateDepStep("test-const-overflow\trun the §15.4 constant-overflow gate (_tests_/bit/constoverflow.bit) only"),
    gateDepStep("test-dupdecl-note\trun the E0042 previously-declared-here note gate (_tests_/bit/dupdeclnote.bit) only"),
    gateDepStep("test-lower-refuse\trun the lowerIndex receiver-kind guard gate (_tests_/bit/lowerrefuse.bit) only"),
    gateDepStep("test-main-exit\trun the §17.4 entry-point exit-code/stderr gate (_tests_/bit/mainexit.bit) only"),
    gateDepStep("test-generic-diag\trun the generic call/instantiation diagnostics gate (_tests_/bit/genericdiag.bit) only"),
    gateDepStep("test-checker-diag\trun the wave-3 checker rejections gate (_tests_/bit/checkerdiag/) only"),
    gateDepStep("test-parser\trun the front-end behaviour gate (_tests_/bit/parsergate.bit) only"),
    gateDepStep("test-fsblock\trun the blocked-fsRead CPU gate (_tests_/bit/fsblock.bit) only"),
    gateDepStep("test-lsp-lifecycle\trun the `bit lsp` lifecycle contract (_tests_/bit/lsplifecycle.bit) only"),
    gateDepStep("test-lsp-resolve\trun the `bit lsp` hover/definition resolution gate (_tests_/bit/lspresolve.bit) only"),
    gateDepStep("test-lsp-cache\trun the `bit lsp` per-request allocation gate (_tests_/bit/lspcache.bit) only"),
    gateDepStep("test-lsp-references\trun the `bit lsp` textDocument/references gate (_tests_/bit/lspreferences.bit) only"),
    gateDepStep("test-lsp-formatting\trun the `bit lsp` textDocument/formatting gate (_tests_/bit/lspformatting.bit) only"),
    gateDepStep("test-lsp-signaturehelp\trun the `bit lsp` textDocument/signatureHelp gate (_tests_/bit/lspsignaturehelp.bit) only"),
    gateDepStep("test-lsp-errortolerant\trun the `bit lsp` best-effort type-checking gate (_tests_/bit/lsperrortolerant.bit) only"),
    gateDepStep("test-lsp-moduledir\trun the `bit lsp` module-directory-scoping gate (_tests_/bit/lspmoduledir.bit) only"),
    gateDepStep("test-lsp-diagnostics\trun the `bit lsp` published-diagnostic shape gate (_tests_/bit/lspdiagnostics.bit) only"),
    gateDepStep("test-pathresolve\trun the install-prefix path-resolution gate (_tests_/bit/pathresolve.bit) only"),
    gateDepStep("test-pmimports\trun the package-manager import-resolution CLI contract (_tests_/bit/pmimports.bit) only"),
    gateDepStep("test-pmvanity\trun the vanity-package `bit add` end-to-end CLI contract (_tests_/bit/pmvanity.bit) only"),
    gateDepStep("test-package-tags-selection\tcheck tagged export selection and broken modules in an isolated repository"),
    gateDepStep("test-pmaddgit\trun the direct git-host `bit add --url` end-to-end CLI contract (_tests_/bit/pmaddgit.bit) only"),
    gateDepStep("test-pmrangegate\trun the caret/tilde/exact/branch/sha resolution + PubGrub-conflict + bit-up CLI contract (_tests_/bit/pmrangegate/) only"),
    gateDepStep("test-examples\trun the examples/*.bit build+run guard (_tests_/bit/examplesgate.bit) only"),
    gateDepStep("test-fuzz\trun XML limit checks + 5s fixed-seed fuzz, then compiler saved-crash replay + 5s fuzz"),
    gateDepStep("test-docs\trun the doc-snippet typecheck gate (_tests_/bit/docs.bit) only"),
    gateDepStep("test-bench-noopt\tbuild and run bench/cases/*/ with --no-optimize, #7145 (_tests_/bit/examplesgate.bit, EXAMPLES_NO_OPTIMIZE) only"),
    gateDepStep("test-docs-examples\trun the docs/examples/shortener build+run guard (_tests_/bit/docsexamplesgate.bit) only"),
    gateDepStep("test-book-ink\tbuild and test docs/book/ink, the Book's Part 1-3 companion app (_tests_/bit/bookinkgate.bit) only"),
  ]
}

fn gateStepsC(): []Step {
  return [
    // #2808. Runs the shipped VS Code extension sample directly, so a defect
    // that only surfaces at lowering (not `bit check`) cannot rot it unnoticed
    // again — see the Gate{} comment in tools/build/gates.bit for the history.
    gateDepStep("test-editor-sample\trun editors/vscode/sample.bit end to end (bit run) only"),
    // #5582. Checks that editors/vscode's declared engines.vscode floor is
    // >= every runtime dependency's own engines.vscode requirement, so a
    // dependency bump (like vscode-languageclient 9->10, #5574) cannot
    // silently outrun the declared floor again — see
    // _tests_/bit/editorenginesfloor.bit for the full history and the Node
    // script it drives.
    gateDepStep("test-editor-engines-floor\trun editors/vscode's engines.vscode-vs-runtime-deps floor check (_tests_/bit/editorenginesfloor.bit) only"),
    gateDepStep("test-imports-bit\trun the Bit import-resolution gate (selfhost half only)"),
    // #2564. Split from one `test-stress` gate so most of the corpus can run
    // concurrently with other gates (#2434's batching): `-exclusive` keeps the
    // four programs whose pass/fail turns on a real elapsed-time floor or
    // ceiling (`BIT_STRESSGATE_PARTITION`, _tests_/bit/stress/); `-batch` is
    // the rest, and is deliberately NOT `exclusive` in gates.bit.
    gateDepStep("test-stress-exclusive\trun the _tests_/stress/* programs whose pass/fail asserts on real elapsed time (_tests_/bit/stress/, BIT_STRESSGATE_PARTITION=exclusive) only"),
    gateDepStep("test-stress-batch\trun the _tests_/stress/* programs that assert only on correctness (_tests_/bit/stress/, BIT_STRESSGATE_PARTITION=batch) only"),
    gateDepStep("test-pollfree\trun the poll-free runtime audit (_tests_/bit/pollfree.bit) only"),
    gateDepStep("test-stwwiring\trun the stop-the-world wiring gate (_tests_/bit/stwwiring/) only"),
    gateDepStep("test-rootabi\trun the runtime-ABI register-class gate (_tests_/bit/rootabi/) only"),
    gateDepStep("test-abimembers\trun the ABI-membership gate (_tests_/bit/abimembers/) only"),
    gateDepStep("test-rootpins\trun the runtime-pin cycle gate (_tests_/bit/rootpins/) only"),
    gateDepStep("test-auxv\trun the getauxval gate (_tests_/bit/auxv.bit) only"),
    gateDepStep("test-waitforsignal\trun the real SIGTERM/SIGINT delivery gate (_tests_/bit/waitforsignal/) only"),
    gateDepStep("test-schedbench\trun the context-switch throughput gate (_tests_/bit/schedbench.bit) only"),
    gateDepStep("test-sched-main-stack\trun the main-stack big-stack identity gate (_tests_/bit/schedmainstack.bit) only"),
    gateDepStep("test-sched-spawn-stack\trun the spawned-task masked-identity stack gate (_tests_/bit/schedspawnstack.bit) only"),
    gateDepStep("test-golden\trun the golden _tests_/cases/*.bit corpus (_tests_/bit/golden/) only"),
    gateDepStep("test-golden-ifchain\trun the golden corpus with BIT_IF_BRANCHCHAIN=1, #5926 (_tests_/bit/golden/) only"),
    gateDepStep("test-classkeyword\trun the class-keyword gate, incl. rejecting the retired spelling (_tests_/bit/classkeyword.bit) only"),
    gateDepStep("test-fieldattrcollision\trun the cross-file field-attribute collision regression gate (_tests_/bit/fieldattrcollision/) only"),
    gateDepStep("test-array-conversion\trun checked slice-to-array native conversion tests only"),
    gateDepStep("test-enum-array-payload\trun boxed enum array payload native regression tests only"),
    gateDepStep("test-typenodecallee\trun the type-node-callee argument-validator gate (_tests_/bit/typenodecallee.bit) only"),
    gateDepStep("test-jsxresync\trun the JSX-text fmt and `?` `<` fixtures the pinned stage0 mis-scores, kept out of _tests_/cases/ by #7380 (_tests_/bit/jsxresync/) only"),
    gateDepStep("test-deferblock\trun the defer-inside-a-bare-block regression gate (_tests_/bit/deferblock.bit) only"),
    gateDepStep("test-baremaplit\trun the bare map literal gate, kept out of _tests_/cases/ by #6016 (_tests_/bit/baremaplit.bit) only"),
    gateDepStep("test-forofarrow\trun the for-of `it?` inside an inferred-parameter arrow gate, kept out of _tests_/cases/ by #5585/#7765 (_tests_/bit/forofarrow.bit) only"),
    gateDepStep("test-jsonfield\trun the Json-typed and enum-typed @json field gates, kept out of _tests_/cases/ by #5585/#7766/#7773 (_tests_/bit/jsonfield/) only"),
    gateDepStep("test-staticmethods\trun the static class method gate, kept out of _tests_/cases/ and checkercases/ by #6091/#6099 (_tests_/bit/staticmethods.bit) only"),
    gateDepStep("test-ifaceassertsig\trun the v.(I) name+signature narrowing gate, #5979 (_tests_/bit/ifaceassertsig.bit) only"),
    gateDepStep("test-leadingdot\trun the leading-dot method chain gate, kept out of _tests_/cases/ by #5585/#7873 (_tests_/bit/leadingdot.bit) only"),
    gateDepStep("test-enumtypeassert\trun the e.(EnumType) cross-module boxed-enum identity gate, #6017 (_tests_/bit/enumtypeassert.bit) only"),
    gateDepStep("test-jsonappend\trun the @json __jsonAppend(out: []byte): []byte gate, #5991 (_tests_/bit/jsonappend.bit) only"),
    gateDepStep("test-staticconst\trun the static closure cell gate, #5990 (_tests_/bit/staticconst.bit) only"),
    gateDepStep("test-dcemethods\trun the method-table slot pruning gate, #6114 (_tests_/bit/dcemethods.bit) only"),
    gateDepStep("test-genericexplode\trun the generic-instance argument explosion gate, #6058 (_tests_/bit/genericexplode.bit) only"),
    gateDepStep("test-testpanic\trun the testpanic_ discovery/verdict regression gate (_tests_/bit/testpanic.bit) only"),
    gateDepStep("test-testloc\trun the caller-location regression gate for std/testing assertions (_tests_/bit/testloc.bit) only"),
    gateDepStep("test-string-explode\trun the BIT_STRING_EXPLODE differential + allocation probe (_tests_/bit/stringexplode/) only"),
    gateDepStep("test-string-keepalive\trun the BIT_GC=stress keepalive differential for an exploded string (_tests_/bit/stringkeepalive.bit) only"),
    gateDepStep("test-gc-decimalstress\trun the BIT_GC=stress regression test for a decimal boxed in an enum payload slot (_tests_/bit/gcdecimalstress.bit) only"),
    // #2931. Builds and runs bench/cases/{collatz,mandelbrot,fib,alloc} and
    // fails when peak RSS or user CPU time (never wall clock) regresses past
    // 1.5x a baseline recorded in _tests_/bit/benchgate.bit — nothing else in
    // `./make test` measures performance, which is how a 4-5x compute and an
    // 18x peak-RSS regression both shipped across many releases.
    gateDepStep("test-benchgate\trun the peak-RSS/user-CPU benchmark regression gate (_tests_/bit/benchgate.bit) only"),
    gateDepStep("test-selfbin\trun the private-copy discipline gate (_tests_/bit/selfbin.bit) only"),
    gateDepStep("test-selfcheck\trun the self-hosted bit self-checks (compiler/selfcheck.bit) only"),
    gateDepStep("test-selfhostcheck\tthe self-hosted bit must check compiler/ clean (#1829)"),
    // #2742. Regression gate for the atomic-width invariant (compiler/
    // lowerprim.bit's lowerAtomic/assertAtomicOperandWidth): an atomic's
    // emitted access width must come from its pointee, never its value
    // operand's own lowered type.
    gateDepStep("test-atomicwidth\trun the atomic access-width regression gate (_tests_/bit/atomicwidth.bit) only"),
    // #2758. `spec/SPEC.md` is this project's stated syntax authority and no
    // gate had ever read it, so it had drifted from itself and from the
    // parser silently and repeatedly. Not a grammar validator (out of scope
    // by design): a symbol-table pass over the EBNF blocks (dangling
    // nonterminals) plus an Appendix-A-vs-defining-section consistency check.
    gateDepStep("test-spec\trun the spec/SPEC.md grammar-consistency gate (_tests_/bit/spec/) only"),
  ]
}

fn gateStepsD(): []Step {
  return [
    // #5101. Zero U+2014 (em dash) in reader-facing prose: docs/**/*.md,
    // spec/*.md, pkg/README.md, pkg/<name>/README.md, README.md,
    // BOOTSTRAP.md and dist/** — never compiler/runtime/stdlib/_tests_/
    // code comments, out of scope by owner ruling. Also #6325: zero
    // citation, anywhere in the repo, of a doc or script that lives only
    // in the maintainer's private `.claude`-prefixed workspace tree.
    gateDepStep("test-no-emdash\trun the reader-facing-prose em-dash gate, and the private-workspace-path gate, in _tests_/bit/noemdash.bit only"),
    // #3072. `spec/FMT.md` cites specific compiler/fmt*.bit:NNN file:line
    // ranges throughout its ten sections, and no gate ever read them — they
    // drifted stale twice (#2954, #3052), each time caught only by a human
    // re-reading the file. Bounds-checks every citation (file exists, line
    // range in bounds) and, where the citation directly names a `fn`/`const`
    // it names, confirms that declaration is still inside the cited range —
    // NOT the prose claim itself, see the harness header for the exact scope.
    gateDepStep("test-fmt-citations\trun the file:line citation-drift gate (_tests_/bit/fmtcitations/) only"),
    // #2793. No gate had ever pointed `bit lint` (or anything else) at
    // `_tests_/bit/` itself, so the 800-line hard limit (docs/development.md,
    // CONTRIBUTING.md, compiler/lint.bit's E0200) drifted unenforced there —
    // seven harness files were already over it. Not `bit lint`: an
    // independent ratchet (_tests_/bit/filesize.bit) with a visible,
    // shrink-only allowlist — emptied by #2867 phase 2's splits, but still
    // live for the next file that outgrows the limit faster than it can be
    // split; any file with no entry must comply with the limit immediately.
    gateDepStep("test-filesize\trun the _tests_/bit/ file-size ratchet gate (_tests_/bit/filesize.bit) only"),
    // #7737. Every write of a slice header's len word either grows it or writes a fresh header: what the
    // unchecked element load of `for x of xs` (compiler/lowerctrl.bit lowerForOfSliceElem) rests on.
    gateDepStep("test-slclen-writesites\trun the slice-header len write-site gate (_tests_/bit/slclenwrites.bit) only"),
    // #4232. Hard-zero 800-line ceiling over scripts/**/*.sh and
    // dist/**/*.sh (_tests_/bit/shellsize.bit) — no gate covered a shell
    // file's size at all before this; unlike test-filesize above, no
    // grandfather list, since every file is checked independently.
    gateDepStep("test-shellsize\trun the scripts/+dist/ shell gate — 800-line hard zero, plus every diffexit/diffrequire caller sources scripts/diffexit.sh (_tests_/bit/shellsize.bit) — only"),
    // #2920. Nothing compared boot's applied GC config against the defaults
    // runtime/gc/gc.bit documents, which is how a 64x-too-low min trigger
    // shipped for two weeks: reads the live post-boot collector state back
    // through rootGcAddr() and asserts it equals gcDefaultMinTrigger/
    // gcDefaultGrowthPct (mark-stack row asserts today's known-divergent
    // value, tracked by #2923).
    gateDepStep("test-gc-defaults\trun the boot-time GC config drift gate (_tests_/bit/gcdefaults.bit) only"),
    // #3623. Reads swept+live around a bounded decode loop and requires a
    // non-ASCII rune to cost no more objects than an ASCII one — the invariant
    // #2448's class-as-return-vehicle split broke in stdlib/strings/utf8.bit.
    gateDepStep("test-rune-alloc\trun the UTF-8 decode allocation gate (_tests_/bit/runealloc.bit) only"),
    // #2546. Builds and execs an allocation-heavy fixture under
    // `BIT_GC=stress`, asserting `abandoned=0` with a printed, asserted
    // `collections > 0` — the darwin boot thread's step-7 park loop (#2543)
    // must stay bracketed with gcBlockingBegin/gcBlockingEnd.
    gateDepStep("test-gc-boot-safepoint\trun the boot-thread safepoint bracket gate (_tests_/bit/gcbootsafepoint.bit) only"),
    // #6060. A runtime environment knob outside its range is fatal at boot: one
    // stderr line naming variable, value and range, exit 64, never a clamp.
    gateDepStep("test-gc-env-range\trun the runtime env-knob range gate (_tests_/bit/gcenvrange.bit) only"),
    // #4456. arm64's stack-map stream desynchronised after a dead block
    // (redundant bounds check panic target) shifted recordSafepoint's
    // running counter — builds and runs the repro plain and under
    // `BIT_GC=stress`, asserting the exact expected output both times.
    gateDepStep("test-safepoint-deadblock\trun the arm64 dead-block stack-map desync gate (_tests_/bit/safepointdeadblock.bit) only"),
    // #4667. computeSkipConstMaterialize must skip a constant every one of
    // whose uses folds into an immediate, not only one with exactly one use —
    // counts `mov #5`/`add #5` inside one function's atom in the emitted
    // __TEXT,__text, and runs the fixture.
    gateDepStep("test-const-immfold\trun the arm64 immediate-fold constant materialization gate (_tests_/bit/constimmfold.bit) only"),
    // #2925's test-pollguardoffsets step is RETIRED BY #4203 along with the
    // mirror it guarded: no backend hardcodes a runtime word offset any more.
    gateDepStep("test-threadtokenbytes\trun the gc thread-token payload drift gate (_tests_/bit/threadtokenbytes.bit) only"),
    // #5045: every schedTaskInit array-base site under _tests_/stress/** and
    // runtime/root/<os>/ must size its array via taskWords
    // (runtime/sched/task.bit) — see the harness's own header.
    gateDepStep("test-taskwords-sizing\trun the schedTaskInit array-size-vs-taskWords drift gate (_tests_/bit/taskwordssizing.bit) only"),
    // #3242. Spawns an allocation-free mutator and asserts the COMPILED
    // back-edge poll actually parks it when a stop is requested -- the one
    // thing no encoding-level check can prove.
    gateDepStep("test-pollguardstopword\trun the worldStopWord inline-poll-clause behavioural gate (_tests_/bit/pollguardstopword.bit) only"),
    // #3564. Same shape as test-pollguardstopword: spawns an allocation-free
    // mutator and asserts the COMPILED back-edge poll actually observes and
    // clears a real preempt request.
    gateDepStep("test-pollguardpreempt\trun the preempt inline-poll-clause behavioural gate (_tests_/bit/pollguardpreempt.bit) only"),
  ]
}

fn gateStepsE(): []Step {
  return [
    // #4134. schedCheckDeadlock stood down unconditionally above
    // BIT_WORKERS=1, so the two gates above hung forever above one worker
    // instead of panicking. Each child program below runs bounded, at its
    // own BIT_WORKERS, via ./childrun's runBounded.
    gateDepStep("test-schedmultideadlock\trun the multi-worker deadlock-detection gate (_tests_/bit/schedmultideadlock.bit) only"),
    // #3189. Pins runtime/gc/stackmap.bit's smFormatVersion export so it
    // cannot drift silently ahead of the compiler-side writer mirror.
    gateDepStep("test-stackmapformatversion\trun the stack-map format-version drift gate (_tests_/bit/stackmapformatversion.bit) only"),
    // #2357. A tracked *.sh file whose first line begins `#!` must be index
    // mode 100755, or running it by the documented `./scripts/foo.sh`
    // spelling fails at rc 126 (c4bf0665 fixed the six scripts that shipped
    // exactly this way; nothing caught the regression before that). Modes
    // are read from the INDEX (`git ls-files -s`), never the working tree,
    // because a core.fileMode=false checkout reports the working tree
    // wrong. See the header of _tests_/bit/shebangmode/shebangmode.bit for the
    // sourced-library exemption (scripts/alarmrun.sh) and why it is decided
    // by a property of the file, never a name list.
    gateDepStep("test-shebang-mode\trun the tracked *.sh executable-bit regression gate (_tests_/bit/shebangmode/) only"),
    // #2949. A zero-initialized module-level global must land in a zero-fill
    // section (Mach-O __DATA,__bss / ELF .bss) rather than costing its own
    // size as literal zero bytes in the binary. Registered by #2956 — #2949
    // left this out of its own fence deliberately.
    gateDepStep("test-globalsbss\trun the zero-fill module-global codegen regression gate (_tests_/bit/globalsbss.bit) only"),
    // #3039. Diffs the stdlib's public surface (`bit doc --fields`) against
    // the pinned previous release and fails on an unallowlisted removal or
    // signature/field change.
    gateDepStep("test-release-surface\trun the stdlib API-surface-vs-previous-release gate (_tests_/bit/releasesurface/) only"),
    // #2853. Every dist/*.sh script and docker/toolchain.Dockerfile can write
    // a Bit program as a `printf` string and hand it straight to the
    // compiler as its OWN smoke test — nothing else ever compiled that text,
    // so it could stop being valid Bit while every other gate stayed green:
    // #2773's `function`-keyword removal did exactly that, for a full day,
    // found only when a human cut a release. #4277: the scan covers dist/*.sh
    // by directory listing, not a hardcoded filename, after a site silently
    // went unverified when #4132 moved it to a new sibling script.
    gateDepStep("test-synth-smoke\tcompile the printf-synthesized smoke programs found across dist/*.sh and docker/toolchain.Dockerfile (_tests_/bit/synthsmoke.bit) only"),
    // #2274. `bit test --timeout` bounds one hung test's process rather
    // than blocking the whole run, and its process group must not survive
    // once the bound expires (no orphan left behind).
    gateDepStep("test-timeout\trun the `bit test --timeout` bound + orphan-cleanup gate (_tests_/bit/testtimeout/) only"),
    // #3653 (2448-fallout). Two-point object-count slope gate for stdlib
    // entry points that must allocate zero heap objects per call — the
    // regression class #3637 (stdlib/strings/parseInt) and #3617
    // (stdlib/json/parse) both shipped unguarded.
    gateDepStep("test-alloc-slope\trun the stdlib allocation-slope gate (_tests_/bit/allocslope.bit) only"),
    // #4408. Two-sided exact pins on the `swept=`/`live=` SPLIT of a
    // BIT_GC_STATS=1 exit summary, where the two gates above pin only the
    // total `swept+live` — the split moved 941,761 objects on #4402 with the
    // total unchanged and every other gate green.
    gateDepStep("test-gc-retention\trun the GC retention (swept/live) pin gate (_tests_/bit/gcretention) only"),
    // #4262. Cross-references every `extern fn` declared under stdlib/**
    // against a Bit-native reader of all three prebuilt
    // bit-out/lib/<target>/libbitrt.a archives, so a symbol present in one
    // target's archive and absent from another's (#3727, #4253's shape)
    // fails here instead of needing a manual scripts/arm64gate.sh/
    // x64gate.sh sweep to surface it. Static and local — no remote host,
    // no docker — because `./make libbitrt` already cross-compiles all
    // three targets on any host.
    gateDepStep("test-extern-archive\tcross-reference stdlib/** extern fn declarations against all three runtime archives (_tests_/bit/externarchive) only"),
    gateDepStep("test-genericparamscope\trun the NOT-last generic type-parameter substitution regression gate (_tests_/bit/genericparamscope.bit) only"),
    gateDepStep("test-openbeneath\trun the openBeneath parent-swap race under BIT_WORKERS=4 (_tests_/bit/openbeneath, #5793) only"),
    gateDepStep("test-staticbeneath\trun pkg/web static serving under the parent-swap race, BIT_WORKERS=4 (_tests_/bit/staticbeneath, #5798) only"),
    gateDepStep("test-walkbeneath\trun walkBeneath's parent-swap race under BIT_WORKERS=4 (_tests_/bit/walkbeneath, #5800) only"),
    gateDepStep("test-removeallbeneath\trun removeAll's parent-swap race under BIT_WORKERS=4 (_tests_/bit/removeallbeneath, #5816) only"),
  ]
}

fn gateStepsF(): []Step {
  return [
    // #5568: `test-packages` (#3271) was excluded from `gateSteps()` on a
    // cost argument — "a package's own compliance corpus must never grow
    // the mandatory suite" (this Step's own history, and
    // _tests_/bit/packagesgate.bit's header) — that no longer holds:
    // measured on this tree, all seven `pkg/<name>/` directories together
    // run in well under a minute against a multi-minute suite (#5568's
    // ticket comments carry the number). Until this moved, nothing on the
    // push path ran a package's own tests at all; the asymmetry
    // _tests_/bit/packagesgate.bit's header explains (a package can never
    // break the language, but the language CAN break a package) is exactly
    // why leaving it out was the wrong default. `BIT_PACKAGE_FILTER` is
    // unset here, same as `./make test-packages`, so this one gate already
    // covers every package that exists — see `packageGates()`
    // (tools/build/gates.bit) for why the per-package `test-package-<name>`
    // gates stay excluded instead of being added here too.
    gateDepStep("test-packages\trun every pkg/<name>/'s own tests at BIT_WORKERS=4 (_tests_/bit/packagesgate.bit, #5812) only"),
    // #5256. Asserts every Gate{} in gateTable() (gates.bit, gatestable2.bit)
    // carries excludeReason iff its name is absent from gateNames() — see
    // class Gate's excludeReason comment (gates.bit) and the harness header
    // (_tests_/bit/gateregistry.bit). In gateSteps(), unlike its sixteen
    // excluded siblings above, precisely because the whole point is that
    // `./make test`/`./make test-prepush` run it on every edit.
    gateDepStep("test-gate-registry\tassert every excluded Gate{} carries a machine-readable excludeReason (_tests_/bit/gateregistry.bit) only"),
  ]
}

// The names `test` depends on — every gate, derived from the table rather than
// restated, so a gate added to `gateSteps` cannot be left out of the umbrella.
// A hand-maintained second list is how a suite quietly stops running something.
// Exported so _tests_/bit/gateregistry.bit can read it directly (#5256).
export fn gateNames(): []string {
  let out = []string(0)
  for s of allGateSteps() {
    out = append(out, s.name)
  }
  return out
}

fn findStep(name: string): (Step, bool) {
  for s of steps() {
    if (s.name == name) {
      return s, true
    }
  }
  return Step{ name = "", desc = "", deps = noDeps() }, false
}

fn allGateSteps(): []Step {
  return append(
    append(
      gateSteps(),
      gateDepStep("test-fntypepresentation\tcheck declaration-owned names in docs and bound-symbol hover"),
    ),
    gateDepStep("test-fnparamtypes\tcheck documentation names in function types and positional function-value calls only"),
  )
}
