// The step registry for the Bit build driver (#1868, epic #1867).
//
// It is not a rewrite of anything hard: 25 of the 31 steps below only launch a
// `_tests_/bit/*.bit` program, `selfhost` shells out to the pinned stage0, and
// `libbitrt` shells out to `scripts/g2archive.sh`. Every piece of actual
// compilation is already `bit`. What this file contributes is the part that is
// not compilation: step naming, dependency edges, environment variables, the
// rebuild fingerprint, and bounded process fan-out.
//
// WHY EVERY STEP IS REGISTERED NOW, INCLUDING THE ONES WITH NO BODY YET
//
// The bodies land in #1869 (artifacts) and #1870 (tests). They are declared
// here anyway, and an unimplemented one EXITS NON-ZERO rather than doing
// nothing. A driver is the gate every other gate runs behind, so a step that
// exists and silently succeeds reports green for an assertion it never made —
// the failure this repo's tooling is repeatedly written against, from
// `scripts/stage0.sh`'s header ("a gate that cannot reach its oracle and exits
// 0 is worse than no gate") to `pollfree`'s floors to `abimembers`'s demand
// oracle. Registering the full set up front also makes `--list` the checkable
// definition of what steps exist — `scripts/gate.sh` reads it to refuse a
// bucket that names a step this file does not declare.
//
// THE NAMES ARE NOT FREE TO CHANGE. `scripts/gate.sh` validates its per-bucket
// step names against the step list and exits 2 on a stale one, and fifteen
// `scripts/selfhost-diff*.sh` invoke `selfhost` by name. Renaming any of these
// is out of scope here and is called out again on #1871.

class Step {
  name: string
  desc: string
  deps: []string
}

// Every test harness needs the compiler and the runtime archive to exist first.
fn gateDeps(): []string {
  return ["selfhost", "libbitrt"]
}

fn noDeps(): []string {
  return []string(0)
}

// One entry per step, in the order `--list` prints them, so the list stays
// readable by eye as well as mechanically.
fn steps(): []Step {
  let out = []Step(0)
  for s of coreSteps() {
    out = append(out, s)
  }
  for s of gateSteps() {
    out = append(out, s)
  }
  for s of packageSteps() {
    out = append(out, s)
  }
  return out
}

// The artifact and umbrella steps. `install` is what `./make` with no argument
// runs.
fn coreSteps(): []Step {
  return [
    Step{name: "install", desc: "Copy build artifacts to prefix path", deps: gateDeps()},
    Step{name: "uninstall", desc: "Remove build artifacts from prefix path", deps: noDeps()},
    Step{name: "test", desc: "Run unit tests", deps: gateNames()},
    Step{name: "libbitrt", desc: "Build libbitrt.a for every target this runtime supports", deps: noDeps()},
    // selfhost NEEDS libbitrt, and the edge has to be declared rather than left
    // to the order gateDeps happens to list them in. `stepSelfhost` links the
    // HOST archive (BIT_LIBBITRT) so `bit` carries this tree's runtime and not
    // the release's (#1857); without the archive it can only refuse. A tree that
    // already had bit-out/lib populated hid this completely — the first clean
    // checkout to run it was the aarch64 gate, where `./make test` died on
    // `missing bit-out/lib/aarch64-linux/libbitrt.a` before a single gate ran.
    Step{name: "selfhost", desc: "Build the self-hosted compiler (compiler/) with the pinned stage0 → bit", deps: []string{"libbitrt"}},
    Step{name: "fuzz", desc: "Mutation-fuzz the lexer+parser (default 60s; pass -- <seconds>)", deps: gateDeps()},
    // #2038, epic #2025. Same shape as `fuzz` above, deliberately a SEPARATE
    // step rather than folded into it: `fuzz`'s classifier treats any
    // non-crash compiler exit as a pass (a diagnostic is a pass), while
    // _tests_/bit/regexfuzzcase.bit has exactly one passing exit code and
    // treats every other one as a finding (regexfuzz.bit's header) — two
    // incompatible classifiers under one flag would have made one harness's
    // semantics a hidden parameter of the other's.
    Step{name: "fuzz-regex", desc: "Mutation-fuzz std/regex's pattern parser and matcher (default 60s; pass -- <seconds>)", deps: gateDeps()},
    // #2416. Deliberately NOT in `gateSteps()`: `gateNames()` is what `test`
    // depends on, and a cold bootstrap — delete bit-out/, re-resolve stage0,
    // rebuild everything — is the single most expensive operation in this
    // repo. It still dispatches through `runGate` (tools/build/main.bit's
    // `runStep` falls through to it for any name not special-cased above),
    // so it needs a `Gate{}` entry in gates.bit exactly like every test-*
    // step, and it still needs `gateDeps()` here: the OUTER `bit-out` must
    // already exist to launch `bit-out/bin/bit run _tests_/bit/coldboot.bit`
    // in the first place — that program is what deletes and rebuilds a
    // SEPARATE, truly-fresh copy in a subprocess and checks its exit code.
    Step{name: "test-coldboot", desc: "delete bit-out/ and re-bootstrap from the pinned stage0 (_tests_/bit/coldboot.bit); not part of `test`", deps: gateDeps()},
    // #2419. Also deliberately NOT in `gateSteps()`: this forces two real
    // `stage0 build compiler` relinks (_tests_/bit/stdlibrebuild.bit shells out
    // to `./make selfhost` three times), which is not free enough for every
    // `./make test` run. Same `Gate{}`-entry-plus-`gateDeps()` shape as
    // `test-coldboot` above, for the same reason: it dispatches through
    // `runGate` and needs an already-built `bit-out` to launch
    // `bit-out/bin/bit run _tests_/bit/stdlibrebuild.bit` in the first place.
    Step{name: "test-stdlib-rebuild", desc: "assert a stdlib/** edit invalidates the selfhost rebuild key (_tests_/bit/stdlibrebuild.bit); not part of `test`", deps: gateDeps()},
    // #2564. The full, unpartitioned _tests_/stress/* corpus in one run — same
    // shape and same reason as the two steps above: `test` runs
    // `test-stress-exclusive`/`test-stress-batch` (gateSteps() below) instead,
    // so this one is deliberately NOT in gateNames().
    Step{name: "test-stress", desc: "run the full _tests_/stress/* corpus, unpartitioned (_tests_/bit/stress/); not part of `test`", deps: gateDeps()},
    // #2538, epic #1253. Deliberately NOT in `gateSteps()`: same shape as
    // `test-stress` above — a dedicated `./make` target, not folded into
    // `test`. Builds each _tests_/stress/parallel/*.bit program once and runs
    // the binary at BIT_WORKERS=8 and BIT_WORKERS=1 (_tests_/bit/stressparallel.bit).
    Step{name: "test-stress-parallel-programs", desc: "run _tests_/stress/parallel/*.bit at BIT_WORKERS=8 and BIT_WORKERS=1 (_tests_/bit/stressparallel.bit); not part of `test`", deps: gateDeps()},
    // #2570. The whole self-host differential family (scripts/selfhost-diffall.sh
    // discovers every scripts/selfhost-*.sh except itself, the *-x64.sh
    // cross-arch variants (owned by x64gate.sh), and the shared
    // selfhost-diffdump.sh driver. DO NOT quote a constituent count here —
    // re-derive it with `ls scripts/selfhost-*.sh | wc -l` minus those three
    // exclusions. It was 17 at #2570, drifted to 18 via #3132
    // (selfhost-ir-signatures.sh), and stayed wrong in this exact comment for
    // three days afterward (#3144) because the fix was a copied integer
    // instead of the derivation. Includes scripts/selfhost-diffruntime.sh,
    // the one this ticket is named for, and two sourced-only helpers
    // (selfhost-ir-canon.sh, selfhost-ir-signatures.sh) that always PASS
    // instantly. Before this Step existed the family was reachable only
    // through scripts/gate.sh's diff-scoped buckets — #2569's divergence
    // shipped through two green pre-push suites this way. Deliberately NOT
    // in gateSteps(): the family runs into the tens
    // of minutes (selfhost-diffcheck.sh alone measured ~524s on 2026-08-15),
    // so folding it into `test` would roughly double the ~19-minute pre-push
    // suite. Same shape as test-coldboot/test-stdlib-rebuild/test-stress
    // above: registered so `--list` shows it and `./make test-differentials`
    // runs it, but `test` does not depend on it.
    Step{name: "test-differentials", desc: "run the whole self-host differential family (scripts/selfhost-diffall.sh, _tests_/bit/selfhostdiff.bit); not part of `test`", deps: gateDeps()},
    // #3118. Regression coverage for the BIT_STAGE0_BIN bootstrap escape
    // hatch (#1857) and fingerprint()'s override-hashing (#1863) —
    // previously zero automated coverage (_tests_/bit/coldboot.bit's own
    // header explicitly says it does NOT use the override). Deliberately NOT
    // in gateSteps(): forces several real `./make libbitrt` relinks
    // (three-target cross-compiles), same shape and same reason as
    // test-stdlib-rebuild above.
    Step{name: "test-stage0override", desc: "assert BIT_STAGE0_BIN is honoured and fingerprint()'s override-hashing invalidates the libbitrt cache on content change (_tests_/bit/stage0override.bit); not part of `test`", deps: gateDeps()},
    // #2609 (epic #1907). Three standalone generated-program fuzz drivers
    // under tools/fuzz/ (#2606/#2607/#2608), each `bit run`, not a
    // _tests_/bit/*.bit harness. Deliberately NOT in `gateSteps()`: measured
    // individually through this same driver on 2026-08-24 at
    // --seed 1 --count 100/100/20 (the counts this ticket specified),
    // `test-fuzz-selfcheck` 11m57s, `test-fuzz-odiff` 18m26s,
    // `test-fuzz-xtarget` 4m57s — 35m20s combined, against a target of
    // "under about 4 minutes added to `./make test`". Folding any one of
    // them in would already blow that budget; same
    // `Gate{}`-entry-plus-`gateDeps()` shape as `test-differentials` above.
    // Seeds pinned so a failure is reproducible: `bit run
    // tools/fuzz/<name>.bit -- --seed 1 --count <n>` reproduces exactly.
    Step{name: "test-fuzz-selfcheck", desc: "run tools/fuzz/selfcheck.bit (100 generated self-checking programs, seed=1); not part of `test`", deps: gateDeps()},
    Step{name: "test-fuzz-odiff", desc: "run tools/fuzz/odiff.bit (--no-optimize vs default, 100 generated programs, seed=1); not part of `test`", deps: gateDeps()},
    // xtarget SKIPs (prints `SKIP: hl-master unreachable`, exits 0) rather
    // than failing when the remote cross-arch host is unreachable — same
    // never-red-on-a-missing-remote contract as test-windows-smoke below.
    Step{name: "test-fuzz-xtarget", desc: "run tools/fuzz/xtarget.bit (aarch64 vs x86_64 via hl-master, 20 generated programs, seed=1; SKIPs if hl-master is unreachable); not part of `test`", deps: gateDeps()},
    // #3341, epic #3322. Deliberately NOT in `gateSteps()`: it depends on a
    // REMOTE HOST (mustafa-desktop-win) reachable only over SSH from this
    // machine, and `./make test` must never be able to fail because a
    // remote box is off or unreachable. Same `Gate{}`-entry-plus-`gateDeps()`
    // shape as `test-differentials`/`test-stage0override` above.
    Step{name: "test-windows-smoke", desc: "cross-build a Bit program for x86_64-windows, ship it to mustafa-desktop-win over SSH, run it and assert native (non-WSL-interop) output (_tests_/bit/windowssmoke.bit); not part of `test`", deps: gateDeps()},
    // #3271: first-party packages (`pkg/<name>/`) — asymmetry explained in
    // _tests_/bit/packagesgate.bit's header. NOT in `gateSteps()`.
    Step{name: "test-packages", desc: "run every pkg/<name>/'s own tests (_tests_/bit/packagesgate.bit); not part of `test`", deps: gateDeps()},
    // #2038, epic #2025. A fixed-seed, 5s regex-fuzz smoke check — same
    // shape as `test-fuzz` (gateSteps() below), but deliberately NOT in
    // `gateSteps()`: `gateSteps()` is the mandatory ~25-minute `./make test`
    // suite and must not grow (bitlang-ws/CLAUDE.md, "The verify loop").
    // Reachable standalone as `./make test-fuzz-regex`, same registration
    // shape as `test-differentials` above (a `Gate{}` record plus a
    // `coreSteps()` entry, dispatched through `runGate`'s generic fallback —
    // tools/build/main.bit's `runStep`).
    Step{name: "test-fuzz-regex", desc: "run the regex saved-crash replay + a 5s fixed-seed fuzz only; not part of `test`", deps: gateDeps()},
    // #2055, epic #2025. Times a fixed std/regex workload and prints
    // ns/op per row against a committed baseline
    // (_tests_/bit/benchregex/{benchregex,baselines}.bit) — NEVER fails the
    // build; see that file's header. Same registration shape as
    // `test-fuzz-regex` above: a `coreSteps()` Step plus a matching
    // `Gate{}` record, dispatched through `runGate`'s generic fallback.
    // Deliberately NOT in `gateSteps()`: that is the mandatory
    // ~25-minute `./make test` suite and a benchmark's numbers are not a
    // merge gate (bitlang-ws/CLAUDE.md, "GATE SPEED OUTRANKS FEATURE
    // WORK").
    Step{name: "bench-regex", desc: "run the std/regex throughput benchmark (_tests_/bit/benchregex); informational only, never fails; not part of `test`", deps: gateDeps()},
  ]
}

// One Step per `pkg/<name>/` directory that exists right now — see
// tools/build/gates.bit's `packageNames()`/`packageGates()`, which this
// mirrors exactly so `./make test-package-<name>` both resolves as a known
// step (`findStep`, main.bit's `resolve`) and runs the matching Gate
// (`findGate`). Deliberately NOT unioned into `gateSteps()`/`gateNames()`:
// these are one-package subsets of `test-packages` above, itself excluded
// from `test` for the same reason, so a per-package run must stay excluded
// too.
fn packageSteps(): []Step {
  let out = []Step(0)
  for p of packageNames() {
    out = append(out, Step{name: "test-package-${p}",
      desc: "run pkg/${p}'s own tests alone (_tests_/bit/packagesgate.bit); not part of `test` or `test-packages`",
      deps: gateDeps()})
  }
  return out
}

// The 25 `test-*` gates. Each runs one Bit program; #1870 fills in the bodies
// and the environment each one needs.
fn gateSteps(): []Step {
  return [
    Step{name: "test-fmt", desc: "run the Bit-source fmt-canonical gate (`bit fmt --check`) only", deps: gateDeps()},
    Step{name: "test-osenv", desc: "run the std/os args+environment round-trip (_tests_/bit/osenv.bit)", deps: gateDeps()},
    Step{name: "test-stdlib-docs", desc: "run the stdlib doc-coverage gate (_tests_/bit/stdlibdocs.bit) only", deps: gateDeps()},
    Step{name: "test-version-cli", desc: "run the `bit version` CLI contract (_tests_/bit/version.bit) only", deps: gateDeps()},
    Step{name: "test-lint", desc: "run the `bit lint` CLI contract (_tests_/bit/lintcmd.bit) only", deps: gateDeps()},
    // #2486, widened to pkg/ by #3806. Enforces a HARD ZERO E0200 findings
    // over PRODUCTION CODE ONLY (runtime/, compiler/, stdlib/, tools/,
    // pkg/) — no test tree in scope. See test-lint-filelines below for the
    // (wider, test-tree-inclusive, one-fixture-tolerant) gate this
    // complements rather than replaces.
    Step{name: "test-lint-sweep", desc: "enforce zero E0200 findings in runtime/, compiler/, stdlib/, tools/ and pkg/ (_tests_/bit/lintsweep.bit) only", deps: gateDeps()},
    // #2515. Distinct from `test-lint` above: that one tests the `lint`
    // subcommand's own behaviour against a throwaway fixture; this one points
    // it at the tree's own `runtime/` and enforces zero E0211 (unused-local,
    // the discarded-result class #2017/#2506 both shipped). The other six
    // rule codes `bit lint runtime` also reports are deliberately NOT gated
    // here — see the harness header for why.
    Step{name: "test-lint-runtime", desc: "enforce zero E0211 findings in runtime/ (_tests_/bit/lintruntime.bit) only", deps: gateDeps()},
    // #2747, extended to stdlib/ by #2895; widened to _tests_/stress/ by
    // #2480/#2481 and to examples/, _tests_/bit/ and _tests_/imports/ by #2974
    // (see _tests_/bit/lintfilelines.bit's own SCOPE comment). Enforces zero
    // E0200 (max-file-lines) findings across all seven — the 800-line limit
    // had no gate over any of them, and the file implementing the limit
    // itself drifted 62 lines past its own override before #2470 split it
    // back down. Deliberately E0200 only: #2567's other runtime/ findings
    // are a separate, still-open decision.
    Step{name: "test-lint-filelines", desc: "enforce zero E0200 findings in compiler/, runtime/, stdlib/, _tests_/stress/, examples/, _tests_/bit/ and _tests_/imports/ (_tests_/bit/lintfilelines.bit) only", deps: gateDeps()},
    // #2453, epic #2354. Count ratchet against tools/build/lint-ceiling.txt
    // for every rule code over compiler/ and stdlib/, plus an unconditional
    // zero-E0214 check independent of the ceiling (_tests_/bit/lintself.bit).
    // #3620 extended the same ratchet to runtime/ (E0211 excluded — it has
    // its own gate above), via the ceiling file's optional third line.
    Step{name: "test-lint-self", desc: "enforce the compiler/+stdlib/+runtime/ lint count ratchet and zero E0214 (_tests_/bit/lintself.bit) only", deps: gateDeps()},
    // #3670/#3693/#3702/#3711/#3703, consolidated by #3703 onto one shared
    // driver (_tests_/bit/fmtceilingcheck.bit) parameterised by env — see its
    // header and gates.bit's five-row table. Each row below enforces one
    // tree's `bit fmt --check` count ratchet against its own ceiling file.
    // test-fmt above is unchanged and stays a hard zero over stdlib/ +
    // examples/ + pkg/ + bench/ + editors/ only.
    Step{name: "test-fmt-ceiling", desc: "enforce the compiler/+runtime/+tools/ `bit fmt --check` count ratchet (_tests_/bit/fmtceilingcheck.bit) only", deps: gateDeps()},
    Step{name: "test-fmt-imports-ceiling", desc: "enforce the _tests_/imports/ `bit fmt --check` count ratchet (_tests_/bit/fmtceilingcheck.bit) only", deps: gateDeps()},
    Step{name: "test-fmt-stress-ceiling", desc: "enforce the _tests_/stress/ `bit fmt --check` count ratchet (_tests_/bit/fmtceilingcheck.bit) only", deps: gateDeps()},
    Step{name: "test-fmt-testsbit-ceiling", desc: "enforce the _tests_/bit/ `bit fmt --check` count ratchet, tolerating unparseable fixtures (_tests_/bit/fmtceilingcheck.bit) only", deps: gateDeps()},
    // #3703. Fifth row of the same table, closing the last uncovered tree.
    Step{name: "test-fmt-cases-ceiling", desc: "enforce the _tests_/cases/ `bit fmt --check` count ratchet, tolerating unparseable fixtures (_tests_/bit/fmtceilingcheck.bit) only", deps: gateDeps()},
    // #3724. Formats every in-scope .bit file into a scratch copy and
    // compares `--dump-ast` of the original against the formatted copy —
    // MEANING preservation, not style (_tests_/bit/fmtroundtrip.bit). Caught
    // both #3718 and #3719 in reconstruction; no other gate does.
    Step{name: "test-fmt-roundtrip", desc: "enforce that `bit fmt` never changes a file's `--dump-ast` (_tests_/bit/fmtroundtrip.bit) only", deps: gateDeps()},
    Step{name: "test-runcmd", desc: "run the `bit run` exit-code contract (_tests_/bit/runcmd.bit) only", deps: gateDeps()},
    Step{name: "test-root-name-collision", desc: "run the E0096 root-module extern-collision gate (_tests_/bit/rootnamecollision.bit) only", deps: gateDeps()},
    Step{name: "test-doc-import-collision", desc: "run the collectDoc imported-name/exported-method collision gate (_tests_/bit/docimportcollision.bit) only", deps: gateDeps()},
    // #2864/#3071. E0078 (compiler/build.bit's rejectExternForTarget) is
    // gated on `linking` exactly like E0096 beside it, so it can only be
    // observed under `bit build`/`bit run` — neither _tests_/cases/ nor
    // _tests_/bit/checkercases/ can reach it, since both drive `bit check`
    // exclusively. Same bespoke-harness shape as test-root-name-collision
    // above, for the same reason.
    Step{name: "test-extern-unresolvable", desc: "run the E0078 unresolvable-extern gate (_tests_/bit/externunresolvable.bit) only", deps: gateDeps()},
    Step{name: "test-clicmd", desc: "run the shared argv contract (_tests_/bit/clicmd/) only", deps: gateDeps()},
    Step{name: "test-const-overflow", desc: "run the §15.4 constant-overflow gate (_tests_/bit/constoverflow.bit) only", deps: gateDeps()},
    Step{name: "test-dupdecl-note", desc: "run the E0042 previously-declared-here note gate (_tests_/bit/dupdeclnote.bit) only", deps: gateDeps()},
    Step{name: "test-lower-refuse", desc: "run the lowerIndex receiver-kind guard gate (_tests_/bit/lowerrefuse.bit) only", deps: gateDeps()},
    Step{name: "test-main-exit", desc: "run the §17.4 entry-point exit-code/stderr gate (_tests_/bit/mainexit.bit) only", deps: gateDeps()},
    Step{name: "test-generic-diag", desc: "run the generic call/instantiation diagnostics gate (_tests_/bit/genericdiag.bit) only", deps: gateDeps()},
    Step{name: "test-checker-diag", desc: "run the wave-3 checker rejections gate (_tests_/bit/checkerdiag.bit) only", deps: gateDeps()},
    Step{name: "test-parser", desc: "run the front-end behaviour gate (_tests_/bit/parsergate.bit) only", deps: gateDeps()},
    Step{name: "test-fsblock", desc: "run the blocked-fsRead CPU gate (_tests_/bit/fsblock.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-lifecycle", desc: "run the `bit lsp` lifecycle contract (_tests_/bit/lsplifecycle.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-resolve", desc: "run the `bit lsp` hover/definition resolution gate (_tests_/bit/lspresolve.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-cache", desc: "run the `bit lsp` per-request allocation gate (_tests_/bit/lspcache.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-references", desc: "run the `bit lsp` textDocument/references gate (_tests_/bit/lspreferences.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-formatting", desc: "run the `bit lsp` textDocument/formatting gate (_tests_/bit/lspformatting.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-signaturehelp", desc: "run the `bit lsp` textDocument/signatureHelp gate (_tests_/bit/lspsignaturehelp.bit) only", deps: gateDeps()},
    Step{name: "test-lsp-errortolerant", desc: "run the `bit lsp` best-effort type-checking gate (_tests_/bit/lsperrortolerant.bit) only", deps: gateDeps()},
    Step{name: "test-pathresolve", desc: "run the install-prefix path-resolution gate (_tests_/bit/pathresolve.bit) only", deps: gateDeps()},
    Step{name: "test-pmimports", desc: "run the package-manager import-resolution CLI contract (_tests_/bit/pmimports.bit) only", deps: gateDeps()},
    Step{name: "test-pmvanity", desc: "run the vanity-package `bit add` end-to-end CLI contract (_tests_/bit/pmvanity.bit) only", deps: gateDeps()},
    Step{name: "test-pmaddgit", desc: "run the direct git-host `bit add --url` end-to-end CLI contract (_tests_/bit/pmaddgit.bit) only", deps: gateDeps()},
    Step{name: "test-pmrangegate", desc: "run the caret/tilde/exact/branch/sha resolution + PubGrub-conflict + bit-up CLI contract (_tests_/bit/pmrangegate/) only", deps: gateDeps()},
    Step{name: "test-examples", desc: "run the examples/*.bit build+run guard (_tests_/bit/examplesgate.bit) only", deps: gateDeps()},
    Step{name: "test-fuzz", desc: "run the saved-crash replay + a 5s fixed-seed fuzz only", deps: gateDeps()},
    Step{name: "test-docs", desc: "run the doc-snippet typecheck gate (_tests_/bit/docs.bit) only", deps: gateDeps()},
    // #2808. Runs the shipped VS Code extension sample directly, so a defect
    // that only surfaces at lowering (not `bit check`) cannot rot it unnoticed
    // again — see the Gate{} comment in tools/build/gates.bit for the history.
    Step{name: "test-editor-sample", desc: "run editors/vscode/sample.bit end to end (bit run) only", deps: gateDeps()},
    Step{name: "test-imports-bit", desc: "run the Bit import-resolution gate (selfhost half only)", deps: gateDeps()},
    // #2564. Split from one `test-stress` gate so most of the corpus can run
    // concurrently with other gates (#2434's batching): `-exclusive` keeps the
    // four programs whose pass/fail turns on a real elapsed-time floor or
    // ceiling (`BIT_STRESSGATE_PARTITION`, _tests_/bit/stress/); `-batch` is
    // the rest, and is deliberately NOT `exclusive` in gates.bit.
    Step{name: "test-stress-exclusive", desc: "run the _tests_/stress/* programs whose pass/fail asserts on real elapsed time (_tests_/bit/stress/, BIT_STRESSGATE_PARTITION=exclusive) only", deps: gateDeps()},
    Step{name: "test-stress-batch", desc: "run the _tests_/stress/* programs that assert only on correctness (_tests_/bit/stress/, BIT_STRESSGATE_PARTITION=batch) only", deps: gateDeps()},
    Step{name: "test-pollfree", desc: "run the poll-free runtime audit (_tests_/bit/pollfree.bit) only", deps: gateDeps()},
    Step{name: "test-stwwiring", desc: "run the stop-the-world wiring gate (_tests_/bit/stwwiring/) only", deps: gateDeps()},
    Step{name: "test-rootabi", desc: "run the runtime-ABI register-class gate (_tests_/bit/rootabi/) only", deps: gateDeps()},
    Step{name: "test-abimembers", desc: "run the ABI-membership gate (_tests_/bit/abimembers/) only", deps: gateDeps()},
    Step{name: "test-rootpins", desc: "run the runtime-pin cycle gate (_tests_/bit/rootpins/) only", deps: gateDeps()},
    Step{name: "test-auxv", desc: "run the getauxval gate (_tests_/bit/auxv.bit) only", deps: gateDeps()},
    Step{name: "test-schedbench", desc: "run the context-switch throughput gate (_tests_/bit/schedbench.bit) only", deps: gateDeps()},
    Step{name: "test-sched-main-stack", desc: "run the main-stack big-stack identity gate (_tests_/bit/schedmainstack.bit) only", deps: gateDeps()},
    Step{name: "test-sched-spawn-stack", desc: "run the spawned-task masked-identity stack gate (_tests_/bit/schedspawnstack.bit) only", deps: gateDeps()},
    Step{name: "test-golden", desc: "run the golden _tests_/cases/*.bit corpus (_tests_/bit/golden/) only", deps: gateDeps()},
    Step{name: "test-classkeyword", desc: "run the class-keyword gate, incl. rejecting the retired spelling (_tests_/bit/classkeyword.bit) only", deps: gateDeps()},
    Step{name: "test-deferblock", desc: "run the defer-inside-a-bare-block regression gate (_tests_/bit/deferblock.bit) only", deps: gateDeps()},
    Step{name: "test-testpanic", desc: "run the testpanic_ discovery/verdict regression gate (_tests_/bit/testpanic.bit) only", deps: gateDeps()},
    Step{name: "test-testloc", desc: "run the caller-location regression gate for std/testing assertions (_tests_/bit/testloc.bit) only", deps: gateDeps()},
    // #2931. Builds and runs bench/cases/{collatz,mandelbrot,fib,alloc} and
    // fails when peak RSS or user CPU time (never wall clock) regresses past
    // 1.5x a baseline recorded in _tests_/bit/benchgate.bit — nothing else in
    // `./make test` measures performance, which is how a 4-5x compute and an
    // 18x peak-RSS regression both shipped across many releases (#2920,
    // #2921, docs/perf-regression-rca.md).
    Step{name: "test-benchgate", desc: "run the peak-RSS/user-CPU benchmark regression gate (_tests_/bit/benchgate.bit) only", deps: gateDeps()},
    Step{name: "test-selfbin", desc: "run the private-copy discipline gate (_tests_/bit/selfbin.bit) only", deps: gateDeps()},
    Step{name: "test-selfcheck", desc: "run the self-hosted bit self-checks (compiler/selfcheck.bit) only", deps: gateDeps()},
    Step{name: "test-selfhostcheck", desc: "the self-hosted bit must check compiler/ clean (#1829)", deps: gateDeps()},
    // #2742. Regression gate for the atomic-width invariant (compiler/
    // lowerprim.bit's lowerAtomic/assertAtomicOperandWidth): an atomic's
    // emitted access width must come from its pointee, never its value
    // operand's own lowered type.
    Step{name: "test-atomicwidth", desc: "run the atomic access-width regression gate (_tests_/bit/atomicwidth.bit) only", deps: gateDeps()},
    // #2758. `spec/SPEC.md` is this project's stated syntax authority and no
    // gate had ever read it, so it had drifted from itself and from the
    // parser silently and repeatedly. Not a grammar validator (out of scope
    // by design): a symbol-table pass over the EBNF blocks (dangling
    // nonterminals) plus an Appendix-A-vs-defining-section consistency check.
    Step{name: "test-spec", desc: "run the spec/SPEC.md grammar-consistency gate (_tests_/bit/spec/) only", deps: gateDeps()},
    // #3072. `spec/FMT.md` cites specific compiler/fmt*.bit:NNN file:line
    // ranges throughout its ten sections, and no gate ever read them — they
    // drifted stale twice (#2954, #3052), each time caught only by a human
    // re-reading the file. Bounds-checks every citation (file exists, line
    // range in bounds) and, where the citation directly names a `fn`/`const`
    // it names, confirms that declaration is still inside the cited range —
    // NOT the prose claim itself, see the harness header for the exact scope.
    Step{name: "test-fmt-citations", desc: "run the file:line citation-drift gate (_tests_/bit/fmtcitations/) only", deps: gateDeps()},
    // #2793. No gate had ever pointed `bit lint` (or anything else) at
    // `_tests_/bit/` itself, so the 800-line hard limit (docs/development.md,
    // CONTRIBUTING.md, compiler/lint.bit's E0200) drifted unenforced there —
    // seven harness files were already over it. Not `bit lint`: an
    // independent ratchet (_tests_/bit/filesize.bit) with a visible,
    // shrink-only allowlist — emptied by #2867 phase 2's splits, but still
    // live for the next file that outgrows the limit faster than it can be
    // split; any file with no entry must comply with the limit immediately.
    Step{name: "test-filesize", desc: "run the _tests_/bit/ file-size ratchet gate (_tests_/bit/filesize.bit) only", deps: gateDeps()},
    // #2920. Nothing compared boot's applied GC config against the defaults
    // runtime/gc/gc.bit documents, which is how a 64x-too-low min trigger
    // shipped for two weeks: reads the live post-boot collector state back
    // through rootGcAddr() and asserts it equals gcDefaultMinTrigger/
    // gcDefaultGrowthPct (mark-stack row asserts today's known-divergent
    // value, tracked by #2923).
    Step{name: "test-gc-defaults", desc: "run the boot-time GC config drift gate (_tests_/bit/gcdefaults.bit) only", deps: gateDeps()},
    // #3623. Reads swept+live around a bounded decode loop and requires a
    // non-ASCII rune to cost no more objects than an ASCII one — the invariant
    // #2448's class-as-return-vehicle split broke in stdlib/strings/utf8.bit.
    Step{name: "test-rune-alloc", desc: "run the UTF-8 decode allocation gate (_tests_/bit/runealloc.bit) only", deps: gateDeps()},
    // #2546. Builds and execs an allocation-heavy fixture under
    // `BIT_GC=stress`, asserting `abandoned=0` with a printed, asserted
    // `collections > 0` — the darwin boot thread's step-7 park loop (#2543)
    // must stay bracketed with gcBlockingBegin/gcBlockingEnd.
    Step{name: "test-gc-boot-safepoint", desc: "run the boot-thread safepoint bracket gate (_tests_/bit/gcbootsafepoint.bit) only", deps: gateDeps()},
    // #2925. compiler/arm64call.bit's emitInlinedPollGuard mirrors
    // runtime/stw/stwpoll.bit's stwPollNeeded by hardcoded word offset
    // rather than by import (§17.6/§11.9: a pinned symbol crosses the
    // compiler/runtime object boundary only for a function, never for
    // module state). This gate pins the runtime's own exported consts
    // against the backend's literals and fails loudly on drift.
    Step{name: "test-pollguardoffsets", desc: "run the arm64 poll-guard word-offset drift gate (_tests_/bit/pollguardoffsets.bit) only", deps: gateDeps()},
    Step{name: "test-threadtokenbytes", desc: "run the gc thread-token payload drift gate (_tests_/bit/threadtokenbytes.bit) only", deps: gateDeps()},
    // #3242. Behavioural counterpart to test-pollguardoffsets above: spawns
    // an allocation-free mutator and asserts the COMPILED inline poll's
    // worldStopWord clause actually parks it, which a word-offset-literal
    // comparison alone cannot prove.
    Step{name: "test-pollguardstopword", desc: "run the worldStopWord inline-poll-clause behavioural gate (_tests_/bit/pollguardstopword.bit) only", deps: gateDeps()},
    // #3564. Behavioural counterpart to test-pollguardoffsets' pgWkIdWord
    // offset: spawns an allocation-free mutator and asserts the COMPILED
    // inline poll's preempt clause actually observes and clears a real
    // preempt request, which a word-offset-literal comparison alone cannot
    // prove.
    Step{name: "test-pollguardpreempt", desc: "run the preempt inline-poll-clause behavioural gate (_tests_/bit/pollguardpreempt.bit) only", deps: gateDeps()},
    // #3189. Pins runtime/gc/stackmap.bit's smFormatVersion export so it
    // cannot drift silently ahead of the compiler-side writer mirror.
    Step{name: "test-stackmapformatversion", desc: "run the stack-map format-version drift gate (_tests_/bit/stackmapformatversion.bit) only", deps: gateDeps()},
    // #2357. A tracked *.sh file whose first line begins `#!` must be index
    // mode 100755, or running it by the documented `./scripts/foo.sh`
    // spelling fails at rc 126 (c4bf0665 fixed the six scripts that shipped
    // exactly this way; nothing caught the regression before that). Modes
    // are read from the INDEX (`git ls-files -s`), never the working tree,
    // because a core.fileMode=false checkout reports the working tree
    // wrong. See the header of _tests_/bit/shebangmode.bit for the
    // sourced-library exemption (scripts/alarmrun.sh) and why it is decided
    // by a property of the file, never a name list.
    Step{name: "test-shebang-mode", desc: "run the tracked *.sh executable-bit regression gate (_tests_/bit/shebangmode.bit) only", deps: gateDeps()},
    // #2949. A zero-initialized module-level global must land in a zero-fill
    // section (Mach-O __DATA,__bss / ELF .bss) rather than costing its own
    // size as literal zero bytes in the binary. Registered by #2956 — #2949
    // left this out of its own fence deliberately.
    Step{name: "test-globalsbss", desc: "run the zero-fill module-global codegen regression gate (_tests_/bit/globalsbss.bit) only", deps: gateDeps()},
    // #3039. Diffs the stdlib's public surface (`bit doc --fields`) against
    // the pinned previous release and fails on an unallowlisted removal or
    // signature/field change.
    Step{name: "test-release-surface", desc: "run the stdlib API-surface-vs-previous-release gate (_tests_/bit/releasesurface/) only", deps: gateDeps()},
    // #2853. dist/release.sh and docker/toolchain.Dockerfile each write a Bit
    // program as a `printf` string and hand it straight to the compiler as
    // their OWN smoke test — nothing else ever compiled that text, so it
    // could stop being valid Bit while every other gate stayed green:
    // #2773's `function`-keyword removal did exactly that, for a full day,
    // found only when a human cut a release.
    Step{name: "test-synth-smoke", desc: "compile the printf-synthesized smoke programs in dist/release.sh and docker/toolchain.Dockerfile (_tests_/bit/synthsmoke.bit) only", deps: gateDeps()},
    // #2274. `bit test --timeout` bounds one hung test's process rather
    // than blocking the whole run, and its process group must not survive
    // once the bound expires (no orphan left behind).
    Step{name: "test-timeout", desc: "run the `bit test --timeout` bound + orphan-cleanup gate (_tests_/bit/testtimeout/) only", deps: gateDeps()},
    // #3653 (2448-fallout). Two-point object-count slope gate for stdlib
    // entry points that must allocate zero heap objects per call — the
    // regression class #3637 (stdlib/strings/parseInt) and #3617
    // (stdlib/json/parse) both shipped unguarded.
    Step{name: "test-alloc-slope", desc: "run the stdlib allocation-slope gate (_tests_/bit/allocslope.bit) only", deps: gateDeps()},
  ]
}

// The names `test` depends on — every gate, derived from the table rather than
// restated, so a gate added to `gateSteps` cannot be left out of the umbrella.
// A hand-maintained second list is how a suite quietly stops running something.
fn gateNames(): []string {
  let out = []string(0)
  for s of gateSteps() {
    out = append(out, s.name)
  }
  return out
}

fn findStep(name: string): (Step, bool) {
  for s of steps() {
    if (s.name == name) {
      return s, true
    }
  }
  return Step{name: "", desc: "", deps: noDeps()}, false
}
