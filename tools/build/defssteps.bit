// The step registry's standalone steps, split out of defs.bit when routine
// additions took it to its 800-line E0200 limit. A pure move: the per-package
// steps and the Docker-backed live steps below are unchanged, and `steps()`
// (defs.bit) still unions them in the same order. None of them is in
// `gateSteps()`/`gateNames()`, which stay in defs.bit because
// scripts/gate-resume.sh reads `gateSteps()` from that file by name.

// One Step per `pkg/<name>/` directory that exists right now — see
// tools/build/gates.bit's `packageNames()`/`packageGates()`, which this
// mirrors exactly so `./make test-package-<name>` both resolves as a known
// step (`findStep`, main.bit's `resolve`) and runs the matching Gate
// (`findGate`). Deliberately NOT unioned into `gateSteps()`/`gateNames()`:
// these are one-package subsets of `test-packages` (gateSteps() above,
// #5568), which already runs every package with `BIT_PACKAGE_FILTER`
// unset — adding the per-package gates too would run each package's tests
// twice on every `./make test`. Kept standalone for a single-package
// release gate (`./make test-package-<name>`).
fn packageSteps(): []Step {
  let out = []Step(0)
  for p of packageNames() {
    out = append(
      out,
      Step{
        name = "test-package-${p}",
        desc = "run pkg/${p}'s own tests alone at BIT_WORKERS=4 (_tests_/bit/packagesgate.bit); not part of `test` or `test-packages`",
        deps = gateDeps(),
      },
    )
  }
  return out
}

// One Step per `pkg/<name>/` directory that exists right now, same
// filesystem-driven shape as `packageSteps()` above — see
// tools/build/gates.bit's `packageSurfaceGates()` for the matching Gate.
// #5120: reports pkg/<name>'s exported-surface delta against its own newest
// `<name>/v*` release tag; never fails a build, so it stays out of
// `gateSteps()`/`gateNames()` regardless of cost — a gate that never fails
// cannot gate anything.
fn packageSurfaceSteps(): []Step {
  let out = []Step(0)
  for p of packageNames() {
    out = append(
      out,
      Step{
        name = "test-package-surface-${p}",
        desc = "report pkg/${p}'s exported-surface delta against its newest ${p}/v* tag (_tests_/bit/packagesurfacegate.bit); not part of `test`",
        deps = gateDeps(),
      },
    )
  }
  return out
}

// #6021 (epic #6013): `test-package-redis-live` provisions its own
// throwaway Docker container rather than depending on a server someone else
// started, but a Docker dependency is still an environment dependency none
// of `gateSteps()`'s other gates have — kept out of `gateSteps()`/
// `gateNames()` for the same reason `packageSteps()` keeps its own
// per-package gates out (that function's own comment, above): explicit
// invocation only, `./make test-package-redis-live`. See
// tools/build/gatestable2.bit's `Gate{}` entry for the harness environment
// and `_tests_/bit/redislive.bit` for what it does without Docker.
fn redisLiveSteps(): []Step {
  return [
    Step{
      name = "test-package-redis-live",
      desc = "provision redis:8.10.2 in Docker and run pkg/redis's *.live.test.bit files (_tests_/bit/redislive.bit); not part of `test`",
      deps = gateDeps(),
    },
  ]
}

