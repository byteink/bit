// Artifact and standalone core records retain coreSteps() order (defs.bit).
fn coreStepsA(): []Step {
  return [
    gateDepStep("install\tCopy build artifacts to prefix path"),
    Step{ name = "uninstall", desc = "Remove build artifacts from prefix path", deps = noDeps() },
    Step{ name = "test", desc = "Run unit tests", deps = gateNames() },
    Step{
      name = "libbitrt",
      desc = "Build libbitrt.a for every target this runtime supports",
      deps = noDeps(),
    },
    // selfhost NEEDS libbitrt, and the edge has to be declared rather than left
    // to the order gateDeps happens to list them in. `stepSelfhost` links the
    // HOST archive (BIT_LIBBITRT) so `bit` carries this tree's runtime and not
    // the release's (#1857); without the archive it can only refuse. A tree that
    // already had bit-out/lib populated hid this completely — the first clean
    // checkout to run it was the aarch64 gate, where `./make test` died on
    // `missing bit-out/lib/aarch64-linux/libbitrt.a` before a single gate ran.
    Step{
      name = "selfhost",
      desc = "Build the self-hosted compiler (compiler/) with the pinned stage0 → bit",
      deps = []string{ "libbitrt" },
    },
    // #4197: read-only, no deps — scans $BIT_ABI_SCAN_DIR for
    // `parseAbiSymbols`, tools/build/abiarity.bit's own arity reader.
    // dist/abitwopass.py's git archaeology for the two-pass ABI-transition
    // bootstrap; never gated, never part of `test`.
    Step{
      name = "dump-abi-symbols",
      desc = "print name/arity/file for every @symbol(...) export under $BIT_ABI_SCAN_DIR",
      deps = noDeps(),
    },
    // #4416: dist/abitwopass.py's git archaeology for the LAYOUT half of a
    // two-pass ABI-transition bootstrap; never gated, never part of `test`.
    Step{
      name = "dump-layout-consts",
      desc = "print name/value/file for every abiLayoutConsts() entry found under $BIT_ABI_SCAN_DIR",
      deps = noDeps(),
    },
    gateDepStep("fuzz\tMutation-fuzz the lexer+parser (default 60s; pass -- <seconds>)"),
    // #2038, epic #2025. Same shape as `fuzz` above, deliberately a SEPARATE
    // step rather than folded into it: `fuzz`'s classifier treats any
    // non-crash compiler exit as a pass (a diagnostic is a pass), while
    // _tests_/bit/regexfuzzcase.bit has exactly one passing exit code and
    // treats every other one as a finding (regexfuzz.bit's header) — two
    // incompatible classifiers under one flag would have made one harness's
    // semantics a hidden parameter of the other's.
    gateDepStep("fuzz-regex\tMutation-fuzz std/regex's pattern parser and matcher (default 60s; pass -- <seconds>)"),
    // #2416. Deliberately NOT in `gateSteps()`: `gateNames()` is what `test`
    // depends on, and a cold bootstrap — delete bit-out/, re-resolve stage0,
    // rebuild everything — is the single most expensive operation in this
    // repo. It still dispatches through `runGate` (tools/build/main.bit's
    // `runStep` falls through to it for any name not special-cased above),
    // so it needs a `Gate{}` entry in gates.bit exactly like every test-*
    // step, and it still needs `gateDeps()` here: the OUTER `bit-out` must
    // already exist to launch `bit-out/bin/bit run _tests_/bit/coldboot.bit`
    // in the first place — that program is what deletes and rebuilds a
    // SEPARATE, truly-fresh copy in a subprocess and checks its exit code.
    gateDepStep("test-coldboot\tdelete bit-out/ and re-bootstrap from the pinned stage0 (_tests_/bit/coldboot.bit); not part of `test`"),
    // #2419. Also deliberately NOT in `gateSteps()`: this forces two real
    // `stage0 build compiler` relinks (_tests_/bit/stdlibrebuild.bit shells out
    // to `./make selfhost` three times), which is not free enough for every
    // `./make test` run. Same `Gate{}`-entry-plus-`gateDeps()` shape as
    // `test-coldboot` above, for the same reason: it dispatches through
    // `runGate` and needs an already-built `bit-out` to launch
    // `bit-out/bin/bit run _tests_/bit/stdlibrebuild.bit` in the first place.
    gateDepStep("test-stdlib-rebuild\tassert a stdlib/** edit invalidates the selfhost rebuild key (_tests_/bit/stdlibrebuild.bit); not part of `test`"),
    // #2564. The full, unpartitioned _tests_/stress/* corpus in one run — same
    // shape and same reason as the two steps above: `test` runs
    // `test-stress-exclusive`/`test-stress-batch` (gateSteps() below) instead,
    // so this one is deliberately NOT in gateNames().
    gateDepStep("test-stress\trun the full _tests_/stress/* corpus, unpartitioned (_tests_/bit/stress/); not part of `test`"),
    // #2538, epic #1253. Deliberately NOT in `gateSteps()`: same shape as
    // `test-stress` above — a dedicated `./make` target, not folded into
    // `test`. Builds each _tests_/stress/parallel/*.bit program once and runs
    // the binary at BIT_WORKERS=8 and BIT_WORKERS=1 (_tests_/bit/stressparallel.bit).
    gateDepStep("test-stress-parallel-programs\trun _tests_/stress/parallel/*.bit at BIT_WORKERS=8 and BIT_WORKERS=1 (_tests_/bit/stressparallel.bit); not part of `test`"),
  ]
}

fn coreStepsB(): []Step {
  return [
    // #2570. The whole self-host differential family (scripts/selfhost-diffall.sh
    // discovers every scripts/selfhost-*.sh except itself, the *-x64.sh
    // cross-arch variants (owned by x64gate.sh), and the shared
    // selfhost-diffdump.sh driver. DO NOT quote a constituent count here —
    // re-derive it with `ls scripts/selfhost-*.sh | wc -l` minus those three
    // exclusions. It was 17 at #2570, drifted to 18 via #3132
    // (selfhost-ir-signatures.sh), and stayed wrong in this exact comment for
    // three days afterward (#3144) because the fix was a copied integer
    // instead of the derivation. Includes scripts/selfhost-diffruntime.sh,
    // the one this ticket is named for, and two sourced-only helpers
    // (selfhost-ir-canon.sh, selfhost-ir-signatures.sh) that always PASS
    // instantly. Before this Step existed the family was reachable only
    // through scripts/gate.sh's diff-scoped buckets — #2569's divergence
    // shipped through two green pre-push suites this way. Deliberately NOT
    // in gateSteps(): the family runs into the tens
    // of minutes (selfhost-diffcheck.sh alone measured ~524s on 2026-08-15),
    // so folding it into `test` would roughly double the ~19-minute pre-push
    // suite. Same shape as test-coldboot/test-stdlib-rebuild/test-stress
    // above: registered so `--list` shows it and `./make test-differentials`
    // runs it, but `test` does not depend on it.
    gateDepStep("test-differentials\trun the whole self-host differential family (scripts/selfhost-diffall.sh, _tests_/bit/selfhostdiff.bit); not part of `test`"),
    // The suite pool and its held gates drain before the differential family
    // starts (#8237). This step owns scheduling; only artifact prerequisites
    // belong in the dependency graph.
    gateDepStep("test-prepush\trun the suite, its held gates alone, then test-differentials after the suite drains (tools/build/gatesprepush.bit); the pre-push gate"),
    // #3118. Regression coverage for the BIT_STAGE0_BIN bootstrap escape
    // hatch (#1857) and fingerprint()'s override-hashing (#1863) —
    // previously zero automated coverage (_tests_/bit/coldboot.bit's own
    // header explicitly says it does NOT use the override). Deliberately NOT
    // in gateSteps(): forces several real `./make libbitrt` relinks
    // (three-target cross-compiles), same shape and same reason as
    // test-stdlib-rebuild above.
    gateDepStep("test-stage0override\tassert BIT_STAGE0_BIN is honoured and fingerprint()'s override-hashing invalidates the libbitrt cache on content change (_tests_/bit/stage0override.bit); not part of `test`"),
    // #4433. A directory scan `walkBit()` (tools/build/artifacts.bit) folds
    // straight into fingerprint()/compilerHash()/stdlibHash() with no count
    // check used to turn a scan failure into an empty list, silently hashed
    // as if it were real content. Deliberately NOT in gateSteps(): chmods a
    // real directory in BIT_REPO, briefly, which would corrupt a concurrent
    // gate's own view of it inside the default batch — same shape as
    // test-stdlib-rebuild/test-stage0override above.
    gateDepStep("test-walkbit-empty-scan\tassert a broken tools/build/ directory scan is refused loudly, not silently hashed as empty (_tests_/bit/walkbitcheck.bit); not part of `test`"),
    // #4434. `stepSelfhost` (tools/build/artifactsteps.bit) used to
    // short-circuit on `exists(binPath)` alone, so a corrupt or
    // SIGKILL-on-exec binary was reported "up to date". Deliberately NOT in
    // gateSteps(): truncates the real bit-out/bin/bit in BIT_REPO, briefly —
    // same shape as test-walkbit-empty-scan above.
    gateDepStep("test-selfhost-liveness\tassert a corrupted bit-out/bin/bit is never reported \"up to date\" (_tests_/bit/selfhostliveness.bit); not part of `test`"),
    // #5671, follow-up to #5624. Deliberately NOT in `gateSteps()`:
    // scratch-copies and rebuilds a whole runtime archive a second time
    // (measured ~6s, _tests_/bit/gcfaultrescan.bit's own header), on top of
    // the one `./make libbitrt` every gate run already pays for once — same
    // shape as test-stage0override/test-windows-smoke, every other gate that
    // builds a runtime archive from a scratch tree rather than reading the
    // one already built. Mechanically runs #5624's hand-verified recipe:
    // proves `recoverOverflow`'s rescan fallback under the debug-only
    // fault-injection seam, asserting `lost=0 checked=<non-zero>
    // stacklen_before==stacklen_after`.
    gateDepStep("test-gc-fault-rescan\tassert recoverOverflow's rescan fallback retains everything when growMarkStack's replacement buffer fails, under a scratch-built debug archive (_tests_/bit/gcfaultrescan.bit); not part of `test`"),
    // #2609 (epic #1907). Three standalone generated-program fuzz drivers
    // under tools/fuzz/ (#2606/#2607/#2608), each `bit run`, not a
    // _tests_/bit/*.bit harness. Deliberately NOT in `gateSteps()`: measured
    // individually through this same driver on 2026-08-24 at
    // --seed 1 --count 100/100/20 (the counts this ticket specified),
    // `test-fuzz-selfcheck` 11m57s, `test-fuzz-odiff` 18m26s,
    // `test-fuzz-xtarget` 4m57s — 35m20s combined, against a target of
    // "under about 4 minutes added to `./make test`". Folding any one of
    // them in would already blow that budget; same
    // `Gate{}`-entry-plus-`gateDeps()` shape as `test-differentials` above.
    // Seeds pinned so a failure is reproducible: `bit run
    // tools/fuzz/<name>.bit -- --seed 1 --count <n>` reproduces exactly.
    gateDepStep("test-fuzz-selfcheck\trun tools/fuzz/selfcheck.bit (100 generated self-checking programs, seed=1); not part of `test`"),
    gateDepStep("test-fuzz-odiff\trun tools/fuzz/odiff.bit (--no-optimize vs default, 100 generated programs, seed=1); not part of `test`"),
    // xtarget SKIPs (prints `SKIP: no x86_64 host reachable`, exits 0) rather
    // than failing when the remote cross-arch host is unreachable — same
    // never-red-on-a-missing-remote contract as test-windows-smoke below.
    gateDepStep("test-fuzz-xtarget\trun tools/fuzz/xtarget.bit (aarch64 vs x86_64 via the x86_64 host scripts/x64host.sh resolves, 20 generated programs, seed=1; SKIPs if none is reachable); not part of `test`"),
  ]
}

fn coreStepsC(): []Step {
  return [
    // #3341, epic #3322. Deliberately NOT in `gateSteps()`: it depends on a
    // REMOTE HOST (the Windows test host) reachable only over SSH from this
    // machine, and `./make test` must never be able to fail because a
    // remote box is off or unreachable. Same `Gate{}`-entry-plus-`gateDeps()`
    // shape as `test-differentials`/`test-stage0override` above.
    gateDepStep("test-windows-smoke\tcross-build a Bit program for x86_64-windows, ship it to the Windows test host over SSH, run it and assert native (non-WSL-interop) output, then run the bit_rt_os_run_captured fixture _tests_/windows/osruncaptured (_tests_/bit/windowssmoke/windowssmoke.bit); not part of `test`"),
    // #4123. Deliberately NOT in `gateSteps()`: the SAME harness as
    // test-pollguardpreempt above (one file, no duplicated waitForClear —
    // see its own comment), registered under this name so it can be
    // addressed on real x86-64 hardware via x64gate.sh's STEP override or
    // boxlock's `--need x86_64-linux`. `bit run` always compiles for the
    // invoking host, so run natively here (aarch64-macos) it only repeats
    // test-pollguardpreempt's own arm64 proof and proves nothing new.
    gateDepStep("test-pollguardpreemptx64\trun the preempt inline-poll-clause behavioural gate on x86-64 (_tests_/bit/pollguardpreempt.bit, same file as test-pollguardpreempt) only; not part of `test`"),
    // #5879, follow-up to #5790: the Gate{} (gatestable2.bit) imports
    // runtime/root/darwin directly, so `bit check` fails outright on any
    // non-Darwin host — found failing `./make test` on real x86_64 Linux
    // hardware via x64gate.sh, since it carried no host guard at all and
    // this suite otherwise only ever ran on the macOS host. Deliberately
    // NOT in `gateSteps()`: same shape as test-windows-smoke/
    // test-pollguardpreemptx64 above, a gate that only proves anything new
    // on one specific host class. The Gate{}'s own `darwinOnly` additionally
    // makes a direct `./make test-osruncap-race`/`STEP=test-osruncap-race`
    // invocation SKIP+exit 0 on a non-Darwin host instead of failing.
    gateDepStep("test-osruncap-race\trun the Darwin pipe()+FD_CLOEXEC capture race regression (_tests_/bit/osruncapraceseamdarwin.bit, #5790) only; not part of `test`"),
    // #5803. Deliberately NOT in `gateSteps()`: generates 6150 functions, builds
    // them for aarch64-linux and runs 3.8M checks in bit-linux-gate:latest, and
    // needs the Docker daemon (darwinOnly) -- same shape as test-tree-archive.
    gateDepStep("test-rem-magic\tcross-build the % by constant divisor differential for aarch64-linux, require the smulh/umulh lowering, and run it in bit-linux-gate:latest (mismatches=0, perturbed run mismatches>0) (_tests_/bit/remmagic.bit) only; not part of `test`"),
    // #5129, closing #5126: asserts every std/ import under pkg/ exists and
    // is exported at the newest v0.* git tag — pure git plus text, no
    // build, no second toolchain; see _tests_/bit/packagereleasegate.bit's
    // header. NOT in `gateSteps()`: a release-drift check against the newest
    // v0.* tag, not a per-edit correctness gate — #5568 moved `test-packages`
    // (below) into `test`, but this one stays out on its own terms.
    gateDepStep("test-package-release-drift\tassert every pkg/ std/ import exists and is exported at the newest v0.* release tag (_tests_/bit/packagereleasegate.bit); not part of `test`"),
    // #5127: no gate anywhere compiled or format-checked a fenced ```bit
    // block under `pkg/<name>/docs/` or `pkg/<name>/README.md` — a page
    // there imports the package by name (`import { App, Config } from
    // "web"`), which `test-docs`'s `BIT_STDLIB`-only harness cannot resolve;
    // see _tests_/bit/pkgdocsgate.bit's header for the local-path dependency
    // this checks each block against instead. NOT in `gateSteps()`: a
    // doc-corpus gate, not a per-edit correctness gate — same reasoning as
    // test-jsx-conformance below, and NOT yet in scripts/gate-buildsteps.sh's
    // `pkg` bucket — see that file's own comment for why.
    gateDepStep("test-package-docs\ttypecheck and fmt-check every fenced ```bit block under pkg/<name>/docs/ and pkg/<name>/README.md (_tests_/bit/pkgdocsgate.bit); not part of `test`"),
    // #5597: 0.20.0 shipped a regression (#5569, compiler/project.bit) that
    // broke `web/v0.5.0` and `yaml/v0.1.0` for every user, and every gate
    // above stayed green because every one of them builds a package from the
    // WORKING TREE, never the already-PUBLISHED git tag `bit add` actually
    // resolves. Resolves each package's newest `<name>/v*` tag through the
    // real, offline `bit add` vanity path and compiles a program against it
    // with the compiler under test — see _tests_/bit/packagetagsgate.bit's own
    // header for the tag-selection and failure-message decisions. Not in
    // `gateSteps()`, same shape as test-package-release-drift/test-package-docs
    // above: a release-drift-class check, not a per-edit correctness gate.
    gateDepStep("test-package-tags\tcompile a program against each package's newest published tag via a real, offline `bit add` (_tests_/bit/packagetagsgate.bit); not part of `test`"),
    // #5339. A census over spec/SPEC.md's own §12.12 grammar block plus a
    // case table (_tests_/bit/jsxconformance.bit): every production must
    // have at least one case, rendered through the real pkg/web, and a
    // character-class production (jsx_text) is enumerated, not sampled.
    // Not part of `test`, same reason test-package-docs is excluded — a
    // grammar-corpus gate, not a per-edit correctness gate.
    gateDepStep("test-jsx-conformance\trun the SPEC 12.12 JSX conformance/census gate (_tests_/bit/jsxconformance.bit) only"),
    // #2038, epic #2025. A fixed-seed, 5s regex-fuzz smoke check — same
    // shape as `test-fuzz` (gateSteps() below), but deliberately NOT in
    // `gateSteps()`: `gateSteps()` is the mandatory ~25-minute `./make test`
    // suite and must not grow (bitlang-ws/CLAUDE.md, "The verify loop").
    // Reachable standalone as `./make test-fuzz-regex`, same registration
    // shape as `test-differentials` above (a `Gate{}` record plus a
    // `coreSteps()` entry, dispatched through `runGate`'s generic fallback —
    // tools/build/main.bit's `runStep`).
    gateDepStep("test-fuzz-regex\trun the regex saved-crash replay + a 5s fixed-seed fuzz only; not part of `test`"),
  ]
}

fn coreStepsD(): []Step {
  return [
    // #2055, epic #2025. Times a fixed std/regex workload and prints
    // ns/op per row against a committed baseline
    // (_tests_/bit/benchregex/{benchregex,baselines}.bit) — NEVER fails the
    // build; see that file's header. Same registration shape as
    // `test-fuzz-regex` above: a `coreSteps()` Step plus a matching
    // `Gate{}` record, dispatched through `runGate`'s generic fallback.
    // Deliberately NOT in `gateSteps()`: that is the mandatory
    // ~25-minute `./make test` suite and a benchmark's numbers are not a
    // merge gate (bitlang-ws/CLAUDE.md, "GATE SPEED OUTRANKS FEATURE
    // WORK").
    gateDepStep("bench-regex\trun the std/regex throughput benchmark (_tests_/bit/benchregex); informational only, never fails; not part of `test`"),
  ]
}
