// The `libbitrt`/`selfhost`/`install`/`uninstall` step bodies for the Bit
// build driver (#1869, epic #1867; split from artifacts.bit by #3442 once
// that file crossed the repo's 800-line E0200 limit — spec/LINT.md:186).
// Pure move: every symbol below is unchanged, only its file changed.
//
// artifacts.bit holds the shell/stage0/fingerprint/host-triple/stack-map
// machinery these steps call; this file is the caller, so it sorts after
// artifacts.bit AND before defs.bit and main.bit (which calls these step
// functions directly), so the inliner sees each callee already lowered
// (#1511).

// --- steps -----------------------------------------------------------------

// `scripts/g2archive.sh` is the ONE recipe for this archive and is called
// rather than reimplemented, for a reason worth keeping: four agents in one
// session each reconstructed the procedure by hand, every reconstruction a
// fresh chance to diverge. It refuses to write the shared
// `bit-out/lib/<t>/libbitrt.a` directly, so each target is built to a scratch
// path and copied into place.
// The second return is whether this call did real work. `main.bit` needs
// that to label a fingerprint-matched skip instead of reporting a bare
// duration for a step that did nothing (#2565) — computed once, here, rather
// than re-derived by the caller, which for `selfhost` below would mean a
// second `uname` subprocess just to answer the question.
fn stepLibbitrt(stage0: string): (int, bool) {
  let fp = fingerprint()
  if (readStamp(stampPath()) == fp && allExist(archivePaths())) {
    print("make:   up to date (fingerprint ${fp[:12]})\n")
    return 0, false
  }
  // #3197: checked here, before either build path below writes a single byte
  // of bit-out/lib/<host>/libbitrt.a. checkRuntimeAbiArity()'s inputs are
  // runtime/**'s declared arities and the pinned tag's arities via `git
  // archive` — neither needs this archive to exist, so nothing forces the
  // check to wait for it. Checking after the write (the old position, in
  // stepSelfhost) let a mismatched build overwrite a good archive and refuse
  // only afterward, corrupting the one artifact the refusal was meant to
  // protect. See tools/build/abiarity.bit's header for what this guards.
  if (!checkRuntimeAbiArity()) {
    return 1, true
  }
  if (env("BIT_LIBBITRT_TREE") != "") {
    return stepLibbitrtTree(stage0, fp)
  }
  for t of targets() {
    print("make:   ${t}\n")
    let scratch = "bit-out/make/libbitrt-${t}.a"
    let dest = "${outDir()}/lib/${t}"
    let script = "set -e\n" +
      "BIT=" +
      shQuote(stage0) +
      "\nexport BIT\n" +
      "rm -f " +
      shQuote(scratch) +
      "\n" +
      "bash scripts/g2archive.sh " +
      shQuote(t) +
      " " +
      shQuote(scratch) +
      "\n" +
      "mkdir -p " +
      shQuote(dest) +
      "\n" +
      "cp " +
      shQuote(scratch) +
      " " +
      shQuote(dest + "/libbitrt.a") +
      "\n"
    let rc = runShell("libbitrt-${t}", script, buildTimeoutMs())
    if (rc != 0) {
      eprint("make: libbitrt ${t} failed (${rc})\n")
      return 1, true
    }
  }
  // #3198: unlike checkRuntimeAbiArity above, this one can only run after
  // the write — it inspects the archive's own bytes, which do not exist
  // until here. See tools/build/artifacts.bit's "stack-map padding" section
  // for what it guards and why a refusal also deletes what it just wrote.
  if (!checkStackMapPadding(hostTriple())) {
    return 1, true
  }
  writeStamp(stampPath(), fp)
  return 0, true
}

// BIT_LIBBITRT_TREE=1 opt-in (#3054, #3117): forces `libbitrt.a` to be
// compiled by THIS TREE's own self-hosted compiler instead of the pinned
// stage0, so a backend codegen fix (e.g. #1852/#1853/#3104/#3105/#3107)
// reaches the GC/allocator/slice/string code the runtime benchmarks spend
// most of their time in — normally frozen at whatever stage0 already emitted
// (see docs/development.md's "Does ./make libbitrt build runtime/** with the
// tree compiler?"). Note precisely what this does and does not change: a
// *source* edit to runtime/** already takes effect under the default,
// stage0-built path too, because stage0 re-reads the current tree's source
// on every build. Only *codegen quality* — the machine code emitted for that
// source — depends on which compiler built the archive.
//
// MUST be set for the SAME invocation that runs `selfhost` (#3126):
// `BIT_LIBBITRT_TREE=1 ./make selfhost` (one command), not
// `BIT_LIBBITRT_TREE=1 ./make libbitrt && ./make selfhost` (two). `selfhost`
// depends on `libbitrt` (`defs.bit`) and re-invokes stepLibbitrt itself, in a
// process where the flag is unset unless it is exported or on that same
// command line — a plain shell scopes `VAR=1 cmd1 && cmd2` to `cmd1` only.
// The two-command form silently overwrites the tree-built archive with a
// stage0-built one and reports no error; see docs/development.md's
// "Correct invocation" paragraph for the measured byte sizes.
//
// Mirrors dist/release.sh's L0/bit1/L1 shape (dist/release.sh:106-202) but
// self-contained and scratch-only, never touching bit-out/bin/bit (the real
// `./make selfhost` output) or performing any release packaging:
//   L0   — one archive, HOST TRIPLE ONLY, built by stage0. All that's needed
//          to link a host-native compiler; the non-host L0 archives release.sh
//          builds are never consumed before being overwritten by L1, so this
//          skips building them at all.
//   bit1 — a throwaway host-native self-hosted compiler, built by stage0,
//          linking L0.
//   L1   — the real archive, all three targets, built by bit1 (this tree's
//          own codegen) via the same scripts/g2archive.sh recipe stepLibbitrt
//          already uses, written to the same bit-out/lib/<target>/libbitrt.a
//          destination as the default path.
//
// If a tree-built archive cannot boot, `BIT_STAGE0_BIN` (docs/development.md,
// #3118 tracks its own missing coverage) is the documented recovery: unset
// BIT_LIBBITRT_TREE and rebuild to fall back to the pinned-stage0 archive.
fn stepLibbitrtTree(stage0: string, fp: string): (int, bool) {
  let host = hostTriple()
  if (host == "unsupported") {
    eprint("make: unsupported host for BIT_LIBBITRT_TREE\n")
    return 1, true
  }
  print("make:   BIT_LIBBITRT_TREE=1 — bootstrapping libbitrt.a with the tree compiler\n")

  print("make:   L0 ${host} (stage0-built, scratch)\n")
  let l0 = "bit-out/make/libbitrt-tree-l0.a"
  let l0Script = "set -e\n" +
    "BIT=" +
    shQuote(stage0) +
    "\nexport BIT\n" +
    "rm -f " +
    shQuote(l0) +
    "\n" +
    "bash scripts/g2archive.sh " +
    shQuote(host) +
    " " +
    shQuote(l0) +
    "\n"
  let rc0 = runShell("libbitrt-tree-l0", l0Script, buildTimeoutMs())
  if (rc0 != 0) {
    eprint("make: BIT_LIBBITRT_TREE L0 bootstrap failed (${rc0})\n")
    return 1, true
  }

  print("make:   bit1 (throwaway host compiler, scratch)\n")
  let bit1 = "bit-out/make/bit1-tree"
  let bit1Script = "set -e\n" +
    "BIT_LIBBITRT=" +
    shQuote(l0) +
    "\nexport BIT_LIBBITRT\n" +
    shQuote(stage0) +
    " build compiler -o " +
    shQuote(bit1) +
    "\n"
  let rc1 = runShell("libbitrt-tree-bit1", bit1Script, buildTimeoutMs())
  if (rc1 != 0) {
    eprint("make: BIT_LIBBITRT_TREE bit1 bootstrap failed (${rc1})\n")
    return 1, true
  }

  for t of targets() {
    print("make:   ${t} (tree-built, L1)\n")
    let scratch = "bit-out/make/libbitrt-${t}.a"
    let dest = "${outDir()}/lib/${t}"
    let script = "set -e\n" +
      "BIT=" +
      shQuote(bit1) +
      "\nexport BIT\n" +
      "rm -f " +
      shQuote(scratch) +
      "\n" +
      "bash scripts/g2archive.sh " +
      shQuote(t) +
      " " +
      shQuote(scratch) +
      "\n" +
      "mkdir -p " +
      shQuote(dest) +
      "\n" +
      "cp " +
      shQuote(scratch) +
      " " +
      shQuote(dest + "/libbitrt.a") +
      "\n"
    let rc = runShell("libbitrt-${t}", script, buildTimeoutMs())
    if (rc != 0) {
      eprint("make: libbitrt ${t} (tree) failed (${rc})\n")
      return 1, true
    }
  }
  // #3198: bit1 was compiled from this tree's own compiler/**, which always
  // carries #1927's padding — expected to pass, checked anyway rather than
  // assumed, for the same reason the class matters more than the instance.
  if (!checkStackMapPadding(host)) {
    return 1, true
  }
  writeStamp(stampPath(), fp)
  return 0, true
}

// LINK THE TREE'S RUNTIME, NOT THE RELEASE'S (#1857). stage0 is an installed
// toolchain and resolves `libbitrt.a` relative to itself, so without
// BIT_LIBBITRT the compiler produced here links the PREVIOUS RELEASE's runtime
// and every `runtime/` change is invisible to the compiler binary. The symptom
// was a fixed `bit_rt_parse_float` that had no effect on `bit`.
// See `stepLibbitrt` above for why this also returns whether it did real
// work: every early return here is a failure that never reached a rebuild, so
// each reports `true` — `main.bit` only prints "up to date" for a `false`
// paired with success, never for an error, so a failure always shows its
// real (near-zero) duration instead of being mislabeled as if nothing were
// wrong.
//
// #3415: the shell line below has `stage0` perform the LINK, not this tree.
// That means a `compiler/**` linker/codegen fix (e.g. #3394's __LINKEDIT
// alignment fix) is compiled INTO the resulting binary's executable code
// immediately, but does NOT change the resulting binary's OWN Mach-O/ELF file
// layout until a stage0 repin — because the bytes of that layout were written
// by stage0's baked-in linker, not by this tree's. Verified: right after this
// step reports "up to date" with #3394 on the tree, `bit-out/bin/bit` itself
// still fails `strip(1)` with the pre-fix "symbol table out of place" error,
// while a program `bit-out/bin/bit` compiles (using its own, fixed, compiled
// code) strips clean. So: never use `bit-out/bin/bit` itself as evidence for
// a linker-level fix to file structure — test a program it compiles instead.
// The release path does not have this gap (dist/release.sh's shipped binary
// is linked by a tree-compiled `bit1`, never by `stage0` directly). Full
// writeup: memory `release-artifacts-built-by-the-PREVIOUS-pin`.
fn stepSelfhost(stage0: string): (int, bool) {
  let host = hostTriple()
  if (host == "unsupported") {
    eprint("make: unsupported host for selfhost\n")
    return 1, true
  }
  let fp = fingerprint()
  let binPath = "${outDir()}/bin/bit"
  let compilerFp = fp + ":" + fpEncodeHex(compilerHash()) + ":" + fpEncodeHex(stdlibHash())
  if (readStamp(selfhostStamp()) == compilerFp && exists(binPath)) {
    print("make:   up to date\n")
    return 0, false
  }
  let archive = "${outDir()}/lib/${host}/libbitrt.a"
  if (!exists(archive)) {
    eprint("make: missing ${archive} — run `./make libbitrt` first\n")
    return 1, true
  }
  // #3152: this step links the tree's runtime against a stage0-compiled
  // compiler — the seam where a runtime ABI arity change silently corrupts
  // instead of failing loudly. See tools/build/abiarity.bit's header.
  //
  // #3197: `stepLibbitrt` above already runs this same check before it
  // writes anything, on the path where the archive was actually (re)built
  // this invocation. This second call is for the OTHER path: `libbitrt`
  // short-circuited as up to date (its own fingerprint matched, so it never
  // reached the check) while `selfhost` still needs to relink — e.g. only
  // `compiler/**` changed. Cheap and idempotent when the earlier call already
  // ran, so calling it unconditionally here costs nothing on the common path
  // and closes the one case `stepLibbitrt` cannot see.
  if (!checkRuntimeAbiArity()) {
    return 1, true
  }
  // #3198: same short-circuit gap checkRuntimeAbiArity's second call closes
  // above — `libbitrt`'s fast path never reaches checkStackMapPadding
  // either, so a compiler-only change that only relinks here would
  // otherwise never re-verify an archive built before this guard existed.
  if (!checkStackMapPadding(host)) {
    return 1, true
  }
  let script = "set -e\n" +
    "BIT_LIBBITRT=" +
    shQuote(archive) +
    "\nexport BIT_LIBBITRT\n" +
    "mkdir -p " +
    shQuote(outDir() + "/bin") +
    "\n" +
    shQuote(stage0) +
    " build compiler -o " +
    shQuote(binPath) +
    "\n"
  let rc = runShell("selfhost", script, buildTimeoutMs())
  if (rc != 0) {
    eprint("make: selfhost failed (${rc})\n")
    return 1, true
  }
  writeStamp(selfhostStamp(), compilerFp)
  return 0, true
}

// `compiler/**` is not in `fingerprint()` because it does not affect the
// runtime archive; the compiler binary depends on it as well as on everything
// the archive does.
fn compilerHash(): []byte {
  let h = newFpHash()
  hashPathList(h, walkBit("compiler"))
  return h.sum()
}

// `stdlib/**` is kept out of `fingerprint()` for the same reason: it does not
// affect `libbitrt.a`. It DOES affect the compiler binary — `stage0 build
// compiler` compiles `compiler/*.bit`'s eleven `std/*` imports straight into
// `bit-out/bin/bit` — so a `stdlib/` edit must still invalidate `compilerFp`
// (#2419). Folded in as a separate hash, alongside `compilerHash()`, rather
// than added to `sourceFiles()`: doing the latter would rebuild every target's
// `libbitrt.a` on every stdlib edit for no reason, since the runtime archive
// never reads `stdlib/`.
fn stdlibHash(): []byte {
  let h = newFpHash()
  hashPathList(h, walkBit("stdlib"))
  return h.sum()
}

// `install` is the default step and exists only to depend on the two
// artifacts. They are produced directly into bit-out, which is the install
// prefix, so there is nothing further to do here.
fn stepInstall(): int {
  return 0
}

fn stepUninstall(): int {
  let rc = runShell(
    "uninstall",
      "rm -rf " +
      shQuote(outDir() + "/bin") +
      " " +
      shQuote(outDir() + "/lib") +
      " " +
      shQuote("bit-out/make") +
      "\n",
    buildTimeoutMs(),
  )
  return rc
}
