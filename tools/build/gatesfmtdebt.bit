// The #3713 fmt-zero known-debt string builders, split out of gates.bit by
// #4157 (spec/LINT.md:186's 800-line E0200 limit) — a pure move, no symbol
// changed. Safe to move: `scripts/gate-filemap.sh`'s `gates_for_file()` and
// `scripts/gate-diffclass.sh`'s `is_additive_registration()` grep
// tools/build/gates.bit and tools/build/gatestable2.bit (#4169 split the
// latter out too) ONLY for `Gate{name:`/`runArgs("...")` table entries —
// see gates.bit's own header — and none of those live here. This file
// holds four plain string-returning helpers `gateTableB()` (gatestable2.bit,
// since #4169) calls by name, resolved through the flat `tools/build/`
// module scope like any other same-directory sibling (no import needed).

// The four #3713 known-debt lists for test-fmt-strict/-stress/-testsbit/-cases
// below, each a single BIT_FMTZERO_DEBT=... string (see
// _tests_/bit/fmtzerocheck.bit's header for the contract). Kept as one string
// literal per function, never `+`-concatenated, so `bit fmt` cannot explode
// them across dozens of wrapped lines the way it does a concatenation chain —
// verified: an earlier draft using `+` took this file from 777 to 1001 lines.
// Each list shrinks, and is removed here, only as its tracking ticket closes.
fn fmtStrictDebt(): string {
  return "BIT_FMTZERO_DEBT=compiler/fmt.bit compiler/lowercall.bit compiler/machoexecpatchcheck.bit compiler/pmfetchresolvevanitycheck.bit compiler/validateoperator.bit compiler/x64framecheckwin.bit compiler/x64selcheckovf.bit runtime/root/linux/boot.bit runtime/root/windows/osrun.bit runtime/root/windows/osruncmdline.bit tools/build/gates.bit tools/build/gatestable2.bit compiler/arm64check.bit compiler/arm64checkbounds.bit compiler/arm64checkframe.bit compiler/arm64checkoperands.bit compiler/arm64checkrelocs.bit compiler/arm64selcheckgen.bit compiler/ast.bit compiler/build.bit compiler/checkexprcall.bit compiler/ircheck.bit" // #4099 (24 E0200) + #4103 (26 E0201) + #4169 (1: gatestable2.bit, `Gate{name:` literal must not reflow); validatecall.bit split into validatecall/validateoperator.bit by #4548, both still unformatted at the time; validatecall.bit split again into validatecall.bit + validatecallargs.bit by #5601 (642/296 fmt, both canonical), removed -- validateoperator.bit unchanged, still on this list. runtime/alloc/alloc.bit split into alloc.bit + freelist.bit by #5602, both canonical tools/build/defs.bit table-driven by #5603 (654->702 fmt, was 654->1196), now canonical -- removed. compiler/pmfetchresolve.bit split into pmfetchresolve.bit + pmfetchresolvevanity.bit by #5600 (622/228 fmt, both canonical), now canonical -- removed lower.bit/lowerprim.bit split by #5598, both canonical compiler/pelink.bit, pereadercheck.bit and peexceptioncheck.bit split by #5599 into pewalk.bit / pereaderfixture.bit / peunwindderiskcheck.bit, all six canonical -- removed. compiler/projectcheck.bit (800 raw -> 806 fmt with #3842's sweep applied) split into projectcheck.bit + pmmanifestcheck.bit by #5475, swept and both canonical (455/358 fmt) -- removed. compiler/arm64check.bit split by #5643 into arm64check.bit + arm64checkrelocs.bit + arm64checkframe.bit + arm64checkmoves.bit + arm64checkoperands.bit + arm64checkbounds.bit, all six still unformatted, all added. compiler/machoexeccheck.bit, compiler/machocheck.bit, compiler/machosymscheck.bit and compiler/codesigncheck.bit formatted and split by #5676 (0 E0201/E0200), all four canonical -- removed. compiler/elfcheck.bit, compiler/elflinkcheck.bit and compiler/elfreadercheck.bit formatted and split by #5677 (0 E0200/E0201), all three canonical -- removed. compiler/elflink.bit formatted by #5677 too (0 E0200), also removed -- its own E0201 finding (linkElfExecutable, over the file's pre-existing `bit:lint max-fn-lines=361` directive once reflowed to 373 lines) is tracked instead in tools/build/lint-debt.txt, split declined per #2450. compiler/lexer.bit, lexinvisible.bit, parser.bit and parserstmt.bit formatted by #5679 (0 E0201/E0200): lexer.bit split keywordKind and scanTokenCmpAndDelim into 8-arm-group chains (708 fmt); lexinvisible.bit split classifyInvisible (161 lines) and scanInvisibleRun (82 lines, nesting 5) into byte-dispatch/concern chains, the latter via a new BidiTrack class carrying the two bidi-stack counters by reference (436 fmt); parser.bit split describe into a 5-link chain (530 fmt); parserstmt.bit split parseStatement into a 3-link chain (755 fmt) -- all four canonical, removed
}

fn fmtStressDebt(): string {
  return "BIT_FMTZERO_DEBT=_tests_/stress/rootbit/rootbit.bit" // #4099
}

fn fmtTestsbitDebt(): string {
  return "BIT_FMTZERO_DEBT=_tests_/bit/clicmd/cases.bit _tests_/bit/lintcmd/lintcmd.bit _tests_/bit/lintcmd/lintcmdchecks.bit _tests_/bit/lowerrefuse.bit _tests_/bit/lspresolve.bit _tests_/bit/pmvanity.bit" // #4099 (5); lintcmd.bit split into lintcmd/{lintcmd,lintcmdchecks}.bit by #4308, both still unformatted
}

fn fmtCasesDebt(): string {
  return "BIT_FMTZERO_DEBT=" // #3842 landed the formatter flip to `=`; run_field_init_eq_form.bit and catch_composite_default_single_field.bit were parked here solely because the pre-flip formatter still emitted `:`, and are canonical now that it doesn't
}
