// The #3713 fmt-zero known-debt string builders, split out of gates.bit by
// #4157 (spec/LINT.md:186's 800-line E0200 limit) — a pure move, no symbol
// changed. Safe to move: `scripts/gate.sh`'s `gates_for_file()`/
// `is_additive_registration()` (scripts/gate-filemap.sh) grep
// tools/build/gates.bit and tools/build/gatestable2.bit (#4169 split the
// latter out too) ONLY for `Gate{name:`/`runArgs("...")` table entries —
// see gates.bit's own header — and none of those live here. This file
// holds four plain string-returning helpers `gateTableB()` (gatestable2.bit,
// since #4169) calls by name, resolved through the flat `tools/build/`
// module scope like any other same-directory sibling (no import needed).

// The four #3713 known-debt lists for test-fmt-strict/-stress/-testsbit/-cases
// below, each a single BIT_FMTZERO_DEBT=... string (see
// _tests_/bit/fmtzerocheck.bit's header for the contract). Kept as one string
// literal per function, never `+`-concatenated, so `bit fmt` cannot explode
// them across dozens of wrapped lines the way it does a concatenation chain —
// verified: an earlier draft using `+` took this file from 777 to 1001 lines.
// Each list shrinks, and is removed here, only as its tracking ticket closes.
fn fmtStrictDebt(): string {
  return "BIT_FMTZERO_DEBT=compiler/doc.bit compiler/elflink.bit compiler/fmt.bit compiler/ir.bit compiler/lower.bit compiler/lowercall.bit compiler/lowerprim.bit compiler/machoexeccheck.bit compiler/optfold.bit compiler/peexceptioncheck.bit compiler/pelink.bit compiler/pereadercheck.bit compiler/pmfetchresolve.bit compiler/pmfetchresolvecheck.bit compiler/validateattr.bit compiler/validatecall.bit compiler/x64framecheck.bit compiler/x64selcheck.bit runtime/alloc/alloc.bit runtime/root/linux/boot.bit runtime/root/windows/osrun.bit runtime/sched/worker.bit tools/build/defs.bit tools/build/gates.bit tools/build/gatestable2.bit compiler/archivecheck.bit compiler/arm64check.bit compiler/arm64selcheckgen.bit compiler/ast.bit compiler/build.bit compiler/checkexpr.bit compiler/checktype.bit compiler/codegenlive.bit compiler/codesigncheck.bit compiler/elfcheck.bit compiler/elflinkcheck.bit compiler/elfreadercheck.bit compiler/emitpecheck.bit compiler/ircheck.bit compiler/lexer.bit compiler/lexinvisible.bit compiler/linkobjcheck.bit compiler/lowerfail.bit compiler/machocheck.bit compiler/machosymscheck.bit compiler/parser.bit compiler/parserstmt.bit compiler/pelinkcheck.bit compiler/pmclicheck.bit compiler/testgen.bit compiler/types.bit" // #4099 (24 E0200) + #4103 (26 E0201) + #4169 (1: gatestable2.bit, `Gate{name:` literal must not reflow)
}

fn fmtStressDebt(): string {
  return "BIT_FMTZERO_DEBT=_tests_/stress/rootbit/rootbit.bit _tests_/stress/stwcollect/stwcollect.bit" // #4099
}

fn fmtTestsbitDebt(): string {
  return "BIT_FMTZERO_DEBT=_tests_/bit/clicmd/cases.bit _tests_/bit/lintcmd/lintcmd.bit _tests_/bit/lintcmd/lintcmdchecks.bit _tests_/bit/lowerrefuse.bit _tests_/bit/lspresolve.bit _tests_/bit/pmvanity.bit" // #4099 (5); lintcmd.bit split into lintcmd/{lintcmd,lintcmdchecks}.bit by #4308, both still unformatted
}

fn fmtCasesDebt(): string {
  return "BIT_FMTZERO_DEBT=_tests_/cases/run_field_init_eq_form.bit" // #3840: deliberately uses `field = value` and mixes it with `field: value` in one literal, to exercise the dual-form parser; the formatter still emits only `:`, so this file can never be canonical until #3840's sweep step flips it, at which point revisit
}
