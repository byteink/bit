// The gate pool's START ORDER (#4706): a static, per-gate cost hint and the
// stable longest-first sort `gatesexec.bit`'s `runGatePool`/`batchScript`
// order their dispatch by. Kept out of `gatesexec.bit` because that file was
// already at 736 of the repo's 800-line E0200 limit (spec/LINT.md:186) and
// this is data plus one sort, not execution machinery.
//
// Named `gatesbatchorder.bit` so it sorts AFTER `gates.bit` (whose `Gate`
// class it takes) and BEFORE `gatesexec.bit` (which calls `poolStartOrder`),
// so the inliner sees each callee already lowered (#1511) — the same rule
// `gates.bit` -> `gatesexec.bit` -> `main.bit` already follows.
//
// Nothing here decides WHICH gates run: that is `gateNames()`
// (tools/build/defs.bit) and the `Gate{}` records in `gates.bit` /
// `gatestable2.bit`. A name absent from the table below still runs.

// #4706: a STATIC HINT, in seconds, used only to decide which gate the pool
// STARTS first — never which gates run, and never what any of them report.
// The pool is bounded by its longest member, so the long tail has to be
// already running while the short gates fill in behind it: starting
// `test-golden` (280s) last would add most of its own length to the batch.
//
// A name missing from the table gets `poolHintUnknownSeconds`, i.e. it
// sorts into the middle — after the measured long gates, before the
// measured short ones. That is the whole cost of a stale entry: some
// scheduling quality. Re-measure it from a `make: <name> — <dur>` column of
// an IDLE `./make test` (kb gate-speed-history.md); a number taken off a
// loaded box is not evidence.
const poolHintUnknownSeconds: int = 20

// Rows are "<seconds> <gate name>", measured on this Mac (18 cores,
// `makeJobs()` = 16) from the idle run recorded on #4706. Gates whose cost
// has since been changed deliberately by a ticket carry that ticket, so the
// next reader can tell a stale number from a measured one.
fn poolHintTable(): []string {
  return [
    // #3255: not a `test` gate at all — `./make test-prepush` puts the whole
    // differential family into this pool as one member, and it has to be the
    // first thing into a slot or the overlap it exists to create starts late.
    // 468s = one drained solo run at f9850d60 (#3255's own control). Inside
    // the pool the same family took 905s, so this hint understates it by
    // design: it only has to be the largest number in the table for the
    // family to be the first thing into a slot.
    "468 test-differentials",
    "280 test-golden",
    "220 test-stress-batch",
    "130 test-string-explode",
    "121 test-imports-bit",
    "73 test-fmt-roundtrip",
    "70 test-clicmd",
    "66 test-main-exit",
    "61 test-lower-refuse",
    "55 test-root-name-collision",
    "54 test-pmvanity",
    "54 test-const-overflow",
    "53 test-stdlib-unit",
    "48 test-timeout",
    "46 test-pmaddgit",
    "40 test-string-keepalive",
    "37 test-lint-filelines",
    "37 test-examples",
    "34 test-runcmd",
    "33 test-fsblock",
    "31 test-rootpins",
    "28 test-generic-diag",
    "27 test-lint-tests",
    "25 test-lint-self",
    "25 test-fmt-strict",
    "21 test-release-surface", // #4691 cut it from 144s
    "1 test-stdlib-docs",      // #4702, was 44s
    "1 test-gc-retention",     // #4702, was 18s
    "1 test-selfbin",          // #4702, was 17s
    "1 test-synth-smoke",      // #4702, was 13s
  ]
}

fn gateHintSeconds(name: string): int {
  for row of poolHintTable() {
    let sp = indexOfByte(row, ' ')
    if (sp > 0 && row[sp + 1:] == name) {
      return parseIntOr(row[:sp], poolHintUnknownSeconds)
    }
  }
  return poolHintUnknownSeconds
}

// The heaviest gate not yet started. Strictly `>`, so equal weights keep the
// caller's own order — the emitted start order stays a deterministic
// function of the name list and the table, never of a previous run's timing.
// Returns -1 only when every slot is already used, which `poolStartOrder`
// treats as its loop's end condition rather than indexing on it.
fn pickLongestUnused(weights: []int, used: []bool): int {
  let best = 0 - 1
  let i = 0
  while (i < len(weights)) {
    if (!used[i] && (best < 0 || weights[i] > weights[best])) {
      best = i
    }
    i = i + 1
  }
  return best
}

// Longest-hinted first, EXCEPT at `jobs <= 1`: the serial escape hatch has to
// reproduce today's order byte for byte (it is this ticket's own A/B
// control, and #2434's before that), and with one slot a reordering is the
// only thing the pool could still change.
fn poolStartOrder(gates: []Gate, jobs: int): []Gate {
  if (jobs <= 1) {
    return gates
  }
  let n = len(gates)
  let weights = []int(n)
  let used = []bool(n)
  let i = 0
  while (i < n) {
    weights[i] = gateHintSeconds(gates[i].name)
    i = i + 1
  }
  let out = []Gate(0)
  while (len(out) < n) {
    let k = pickLongestUnused(weights, used)
    if (k < 0) {
      return out
    }
    used[k] = true
    out = append(out, gates[k])
  }
  return out
}
