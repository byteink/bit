// The second half of the `test-*` gate TABLE — `gateTableB()`, moved out of
// `gates.bit` by #4169 (spec/LINT.md:186's 800-line E0200 limit): that file
// grew 758 -> 799 in a week purely from routine `Gate{}` additions and had
// one line of headroom left. Pure move, no symbol changed: `gateTableA()`
// and `gateTableB()` were already split apart by #1511 to stay under the
// per-function line limit, so this relocates an existing, self-contained
// function rather than cutting a new seam. `gateTable()` (gates.bit) still
// calls `gateTableB()` with no import — same `tools/build/` module scope as
// every other sibling here (see gatesfmtdebt.bit's header for the same
// reasoning).
//
// NOT safe to move silently, unlike gatesfmtdebt.bit's four string builders:
// this file's `Gate{name = ..., argv = runArgs(...)}` entries are exactly what
// `scripts/gate-filemap.sh`'s `gates_for_file()` and gate-diffclass.sh's
// `is_additive_registration()` grep BY NAME to map a changed file to a gate and
// to bucket-scope a diff instead of forcing the 18-25 min `./make test`. Both
// were updated in this same commit to read `tools/build/gates.bit` AND this
// file — see gates.bit's header for gates.bit's own half of that change.
// `is_additive_registration()`'s case arm also lists this file, so a future
// purely-additive `Gate{}` entry landing HERE stays scoped, not `full`.

fn gateTableB(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    Gate{ name = "test-pollfree", argv = runArgs("_tests_/bit/pollfree"), env = [std] },
    Gate{ name = "test-stwwiring", argv = runArgs("_tests_/bit/stwwiring"), env = [std] },
    Gate{ name = "test-rootabi", argv = runArgs("_tests_/bit/rootabi"), env = [std] },
    Gate{ name = "test-abimembers", argv = runArgs("_tests_/bit/abimembers"), env = [std] },
    Gate{ name = "test-rootpins", argv = runArgs("_tests_/bit/rootpins"), env = [std] },
    Gate{ name = "test-auxv", argv = runArgs("_tests_/bit/auxv.bit"), env = [std] },
    // #6087: a real, externally-delivered SIGTERM and SIGINT, each caught by
    // `std/signal`'s `waitForSignal` before the process exits — see the
    // harness's own header for why this spawns itself through `/bin/sh`
    // rather than a synthetic in-process call.
    Gate{ name = "test-waitforsignal", argv = runArgs("_tests_/bit/waitforsignal"), env = [std] },
    Gate{ name = "test-schedbench", argv = runArgs("_tests_/bit/schedbench.bit"), env = [std] },
    // #2613/#3603. Proves `main`'s dedicated 8 MiB stack end to end: recurse
    // 100000 frames deep, then a channel op at the deepest frame so the path
    // actually exercises `schedCurrentTask()` identity resolution at depth.
    // A broken big-stack identity resolves to task 0, which the runtime
    // treats as fatal (exit 70) rather than panicking cleanly — see the
    // harness header for why the exit code IS the assertion.
    Gate{
      name = "test-sched-main-stack",
      argv = runArgs("_tests_/bit/schedmainstack.bit"),
      env = [std],
    },
    // #2614 (epic #1844), sibling of #2613/#3603's test-sched-main-stack:
    // proves the masked-identity path every non-main task uses
    // (schedTaskOnStack(sp & ~(schedStackBytes - 1))) still resolves
    // correctly at depth on its 256 KiB stack — see the harness header for
    // why the exit code IS the assertion.
    Gate{
      name = "test-sched-spawn-stack",
      argv = runArgs("_tests_/bit/schedspawnstack.bit"),
      env = [std],
    },
    Gate{ name = "test-selfbin", argv = runArgs("_tests_/bit/selfbin.bit"), env = [std] },
    Gate{
      name = "test-golden", argv = runArgs("_tests_/bit/golden"),
      env = [
        std, "BIT_CASES_DIR=${repoRoot()}/_tests_/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}",
      ],
    },
    // #5926: the same corpus with `BIT_IF_BRANCHCHAIN=1`, which every compile
    // the harness drives inherits, so the default-off branch-chain lowering of
    // an `if` condition's `&&` / `||` stays proven until the stage0 repin flips
    // it. An `// ir` case whose IR the flag changes is graded against its
    // `.ifchain.expected` (golden.bit's `ifChainSuffix`). Deleted with the flag.
    Gate{
      name = "test-golden-ifchain", argv = runArgs("_tests_/bit/golden"),
      env = [
        std, "BIT_CASES_DIR=${repoRoot()}/_tests_/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}", "BIT_IF_BRANCHCHAIN=1",
      ],
    },
    // #3427 (epic #3424, final phase): the retired-keyword rejection gate,
    // driven against the compiler CLI directly rather than through
    // _tests_/cases/ — see the harness header for why that corpus is unsuited
    // to a fixture that is EXPECTED to fail compilation.
    Gate{
      name = "test-classkeyword", argv = runArgs("_tests_/bit/classkeyword.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #5393: a field attribute's name resolving to a free function declared
    // in a SIBLING file of the same module (SPEC §17.1) used to leave
    // E0133/E0134/E0135 naming only the attribute, with no path back to the
    // function that captured it — driven against the CLI directly, like
    // test-classkeyword above, since the fixture is two files sharing one
    // module and neither test-checker-diag nor test-golden's corpora support
    // that shape (each walks only top-level `.bit` files as single-file
    // cases). See the harness header for the full mechanism.
    Gate{
      name = "test-fieldattrcollision", argv = runArgs("_tests_/bit/fieldattrcollision"),
      env = [std, "BIT_BIN=${bitBin()}"],
    },
    // #4098: walks the four type-node-callee forms (chan<T>(...), []T(...),
    // map<K,V>(...), [N]T(...)) and asserts each rejects an invalid argument
    // — see the harness header for why a regression in any one validator
    // (compiler/validatezero.bit) reddens this rather than silently shipping.
    Gate{
      name = "test-typenodecallee", argv = runArgs("_tests_/bit/typenodecallee.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #3443: a `defer` with arguments (or a receiver) inside a bare,
    // unconditional block panicked `index out of range` — see the harness
    // header for why the fixture is driven against the CLI directly rather
    // than through _tests_/cases/ (the pinned stage0 oracle panics on it too).
    Gate{
      name = "test-deferblock", argv = runArgs("_tests_/bit/deferblock.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #7380: the JSX-text fixtures the pinned stage0 mis-scores (a `bit fmt`
    // that appends a `;`, a `<` comparison it cannot parse), kept out of
    // _tests_/cases/ under the #5585 rule — see the harness header
    // (_tests_/bit/jsxresync/jsxresync.bit).
    Gate{
      name = "test-jsxresync", argv = runArgs("_tests_/bit/jsxresync"),
      env = [
        std, "BIT_CASES_DIR=${repoRoot()}/_tests_/bit/jsxresync/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}",
      ],
    },
    // #6016: the bare `{k: v, ...}` map literal (SPEC §12.3/§15.2), driven
    // against the CLI directly like test-typenodecallee above — see the harness
    // header for why that surface reddens selfhost-difftypes.sh if left in
    // _tests_/cases/.
    Gate{
      name = "test-baremaplit", argv = runArgs("_tests_/bit/baremaplit.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #5979: `v.(I)` narrowing checks NAME AND SIGNATURE, driven against the
    // CLI directly like test-typenodecallee above — golden/stage0's harnesses
    // run with a fixed environment, no per-fixture env var, so this cannot
    // live in _tests_/cases/.
    Gate{
      name = "test-ifaceassertsig", argv = runArgs("_tests_/bit/ifaceassertsig.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #6017 (epic #6013): `e.(EnumType)` / `let (v, ok) = e.(EnumType)`
    // identity across two same-named boxed enums in SIBLING directory
    // modules, driven against the CLI directly like test-ifaceassertsig
    // above — _tests_/cases/ is a flat single-file corpus and cannot
    // express a multi-module fixture (#6192 moved this gate's other three
    // fixtures there once the pinned stage0 oracle caught up to #6017).
    Gate{
      name = "test-enumtypeassert", argv = runArgs("_tests_/bit/enumtypeassert.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #5991: `@json`'s direct `__jsonAppend(out: []byte): []byte`, driven
    // against the CLI directly like test-ifaceassertsig above — the golden
    // corpus's @json fixtures are compared by stage0 with a fixed
    // environment, so this cannot live in _tests_/cases/.
    Gate{
      name = "test-jsonappend", argv = runArgs("_tests_/bit/jsonappend.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #5990: a bare function value through a static closure cell
    // (compiler/lowerstaticconst.bit's `staticConstEnabled`, unconditional
    // since #6192), driven against the CLI like test-jsonappend above — the
    // golden corpus has no `--dump-ir` step to prove the static-cell path
    // was taken, and no per-fixture `BIT_GC=stress` variant.
    Gate{
      name = "test-staticconst", argv = runArgs("_tests_/bit/staticconst.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #6058: a generic instance's explodable arguments passed as words,
    // unconditional since #6245 deleted the rollout switch (default ON since
    // the 0.32.0 repin), checked under `BIT_GC=stress` too, which the golden
    // corpus's fixed environment cannot do.
    Gate{
      name = "test-genericexplode", argv = runArgs("_tests_/bit/genericexplode.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #2840 (epic #2270): pins both directions of #2839's `testpanic_`
    // support — see the harness header for why a main-less fixture cannot
    // go through _tests_/cases/ (golden.bit's checkRun requires `bit build`
    // to produce a runnable binary). BIT_REPO locates the harness's own
    // sidecar _tests_/bit/testpanic.expected.
    Gate{
      name = "test-testpanic", argv = runArgs("_tests_/bit/testpanic.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}", "BIT_REPO=${repoRoot()}"],
    },
    // #4422: on by default since the owner ruling 2026-09-23 (#5755, #4411),
    // so this is the ONLY gate that runs the OFF path
    // (`BIT_STRING_EXPLODE=0`). Compiles eight string-heavy fixtures
    // twice, gate off and gate on, and requires byte-identical stdout and
    // exit code — the off run IS the oracle, so a new fixture costs no
    // sidecar. Also asserts the slice-in-a-loop probe allocates strictly
    // fewer objects with the gate on, because a differential alone cannot
    // tell "explodes correctly" from "no longer explodes at all".
    Gate{
      name = "test-string-explode", argv = runArgs("_tests_/bit/stringexplode"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #4425: the GC-POLICY differential for the same flip — test-string-explode
    // above runs both representations under the DEFAULT collector only. Adds a
    // BIT_GC=stress arm and a collection-count assert; kills the mutant that
    // empties `extendKeepAlive`. Why, in that harness's own header.
    Gate{
      name = "test-string-keepalive", argv = runArgs("_tests_/bit/stringkeepalive.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #5426: the permanent BIT_GC=stress regression test for #5424's GC
    // pointer-map fix — a decimal boxed into an enum payload slot must stay
    // in the object's ptr_offsets or the collector frees it out from under a
    // live value. Same shape as test-string-keepalive above (a differential
    // that only diverges under the stress policy); see the harness header.
    Gate{
      name = "test-gc-decimalstress", argv = runArgs("_tests_/bit/gcdecimalstress.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #2252: `bit test` must name the CALLER's file:line for a failed
    // std/testing assertion (a helper, a loop, and a direct in-body
    // failure) — see the harness header for why a main-less, `bit
    // test`-driven fixture cannot go through _tests_/cases/, same reasoning
    // as test-testpanic above. BIT_REPO locates the harness's own sidecar
    // _tests_/bit/testloc.expected.
    Gate{
      name = "test-testloc", argv = runArgs("_tests_/bit/testloc.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}", "BIT_REPO=${repoRoot()}"],
    },
    // #2931. Peak-RSS/user-CPU regression gate over bench/cases/{collatz,
    // mandelbrot,fib,alloc} — see the header of
    // _tests_/bit/benchgate/benchgate.bit for why those two metrics and not
    // wall clock (#2401/#2415/#2422 are open on exactly that failure mode).
    // BIT_BENCH_DIR points it at bench/cases rather than letting it default
    // and silently walk the wrong directory, matching BIT_CASES_DIR above.
    // #3023 split this into a directory module
    // (_tests_/bit/benchgate/{benchgate,baselines}.bit); the case arm this
    // registration needs is scripts/gate-filemap.sh's gates_for_file().
    // #3869: asserts on user CPU and peak RSS, so a co-scheduled neighbour
    // changes what it reports — `exclusive: true` keeps it out of the
    // concurrent batch, same reason as every other wall-clock/RSS gate below.
    Gate{
      name = "test-benchgate", argv = runArgs("_tests_/bit/benchgate"),
      env = [
        std, "BIT_BENCH_DIR=${repoRoot()}/bench/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}",
      ], exclusive = true,
    },
    // Not `bit run` — these drive a subcommand of the compiler itself.
    // #3699/#3700/#3701 added pkg/, bench/ and editors/ alongside stdlib/ and
    // examples/: all three were measured 100%/100%/100% clean once #3700 and
    // #3701 reformatted bench/'s 4 and editors/vscode/sample.bit's 1 dirty
    // file (pure reformatting, verified by identical before/after run
    // output), so each is a hard zero like the original two rather than a
    // ratchet.
    // #3713 reformatted the whole tree once, so _tests_/imports/ (#3693,
    // previously its own ceiling gate) folds in here at a hard zero: no
    // unparseable fixtures, no post-reformat E0200 debt.
    // #4681 added _tests_/freestanding/ (3 files) and _tests_/testproj/ (1),
    // the only two `.bit`-holding trees no fmt gate named at all — so `./make
    // test` never formatted them either. Both measured clean at 664a94a4
    // (`bit fmt --check` rc=0, and rc=1 naming the file once one is dirtied),
    // so neither needed a reformat and both are hard zeros like the rest of
    // this argv. Neither tree has a gate.sh bucket: a diff touching one
    // resolves to `full`, which runs this gate via the aggregate `test` step —
    // named as such in argvliteral_bucket_for_dir() (scripts/gate-envscope.sh).
    Gate{
      name = "test-fmt", argv = [
        "fmt", "--check", "${repoRoot()}/stdlib", "${repoRoot()}/examples",
        "${repoRoot()}/pkg", "${repoRoot()}/bench", "${repoRoot()}/editors",
        "${repoRoot()}/_tests_/imports", "${repoRoot()}/_tests_/freestanding",
        "${repoRoot()}/_tests_/testproj",
      ],
      env = [std],
    },
    // #3713 replaced five ceiling-ratchet gates (formerly
    // _tests_/bit/fmtceilingcheck.bit, tools/build/fmt-ceiling*.txt) with
    // four zero-tolerance gates on the shared driver
    // _tests_/bit/fmtzerocheck.bit — see its header for the contract. A
    // ceiling survives debt it cannot yet fix; the tree is now reformatted
    // once, so each demands zero except a short, NAMED, ticket-linked debt
    // list (fmtStrictDebt() etc. above) that can only shrink.
    //
    // compiler/+runtime/+tools/ (originally #3670): 50 files #3713's
    // reformat would push over a Power-of-10-style ceiling — 24 over the
    // 800-line E0200 file limit (#4099), 26 over the 80-line E0201
    // function limit (#4103, found via test-lint-self's SEPARATE check — then
    // a count ratchet, tools/build/lint-ceiling.txt, going 482 -> 512
    // findings on a pure reformat with no ceiling raised to compensate; #4149
    // replaced it with the named tools/build/lint-debt.txt, where the same
    // reformat would surface as 30 unlisted findings).
    Gate{
      name = "test-fmt-strict", argv = runArgs("_tests_/bit/fmtzerocheck.bit"),
      env = [
        "BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-strict",
        "BIT_FMTZERO_TREES=compiler:compiler runtime:runtime tools:tools",
        fmtStrictDebt(),
      ],
    },
    // _tests_/stress/ (originally #3702): 2 files, same E0200 shape — #4099.
    Gate{
      name = "test-fmt-stress", argv = runArgs("_tests_/bit/fmtzerocheck.bit"),
      env = [
        "BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-stress",
        "BIT_FMTZERO_TREES=stress:_tests_/stress",
        fmtStressDebt(),
      ],
    },
    // _tests_/bit/ (originally #3711): carries deliberately-malformed
    // fixtures bit fmt refuses outright (BIT_FMTZERO_TOLERATE_DIAG=1, same
    // exit-code classification the ceiling gate used), plus 20 debt files:
    // 5 E0200 (#4099) and 15 in checkercases/ whose paired .expected asserts
    // a line:col that reformatting moved — never touched by #3713, #4101.
    Gate{
      name = "test-fmt-testsbit", argv = runArgs("_tests_/bit/fmtzerocheck.bit"),
      env = [
        "BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-testsbit",
        "BIT_FMTZERO_TREES=testsbit:_tests_/bit",
        "BIT_FMTZERO_TOLERATE_DIAG=1",
        fmtTestsbitDebt(),
      ],
    },
    // _tests_/cases/ (originally #3703): same malformed-fixture shape, plus
    // 15 files of the same moved-diagnostic debt as checkercases above —
    // #4101. Not in #3713's must-be-zero tree list (it flagged this tree as
    // the one most likely to carry unavoidable debt, correctly), but a
    // zero-except-debt gate beats no gate at all.
    Gate{
      name = "test-fmt-cases", argv = runArgs("_tests_/bit/fmtzerocheck.bit"),
      env = [
        "BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-cases",
        "BIT_FMTZERO_TREES=cases:_tests_/cases",
        "BIT_FMTZERO_TOLERATE_DIAG=1",
        fmtCasesDebt(),
      ],
    },
    // #5298: `docs` (originally #5268's docs/examples/shortener/, 10 files)
    // was the one `.bit`-source tree assert_fmt_gate_per_bucket()
    // (scripts/gate-bucketasserts.sh, #4328) found with no fmt gate at all —
    // `scripts/gate.sh --full` refused outright rather than pass silently.
    // All ten measured `bit fmt --check` clean at 73fd1c6b, so this is a
    // hard zero like test-fmt-stress: no BIT_FMTZERO_DEBT entry.
    Gate{
      name = "test-fmt-docs", argv = runArgs("_tests_/bit/fmtzerocheck.bit"),
      env = [
        "BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-docs",
        "BIT_FMTZERO_TREES=docs:docs",
      ],
    },
    // #3724: no gate checked that `bit fmt` PRESERVES program meaning — see
    // the harness header (_tests_/bit/fmtroundtrip.bit) for the full design.
    // Measured on this branch: 69s over 1596 `.bit` files (MATCH=1558
    // MISMATCH=0 SKIP=38), cheaper than test-lint-filelines — in gateSteps()
    // (below), not coreSteps(), on that basis: it is correctness coverage no
    // other gate provides, at a cost `./make test` already tolerates for
    // similarly-priced gates.
    Gate{
      name = "test-fmt-roundtrip", argv = runArgs("_tests_/bit/fmtroundtrip.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"],
    },
    Gate{ name = "test-selfcheck", argv = ["selfcheck"], env = [std] },
    Gate{ name = "test-selfhostcheck", argv = ["check", "${repoRoot()}/compiler"], env = [std] },
    // #2416. BIT_REPO IS REQUIRED: the harness refuses rather than default to
    // "." and rebuild whatever directory it happened to be invoked from — see
    // the header of _tests_/bit/coldboot.bit. Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make test-coldboot`
    // does.
    Gate{
      name = "test-coldboot", argv = runArgs("_tests_/bit/coldboot.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "cost: deletes and rebuilds bit-out/ from the pinned stage0, the single most expensive operation in this repo (defs.bit's test-coldboot Step{} comment); run via ./make test-coldboot",
    },
    // #2419. BIT_REPO IS REQUIRED for the same reason as test-coldboot above:
    // the harness shells out to `./make selfhost` against the repo root and
    // must not silently default to ".". Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make
    // test-stdlib-rebuild` does.
    Gate{
      name = "test-stdlib-rebuild", argv = runArgs("_tests_/bit/stdlibrebuild.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "cost: forces three real `./make selfhost` relinks, not free enough for every ./make test run (defs.bit's test-stdlib-rebuild Step{} comment); run via ./make test-stdlib-rebuild",
    },
    // #2564. The FULL, unpartitioned corpus (no `BIT_STRESSGATE_PARTITION`) —
    // for `scripts/gate.sh`'s `runtime` bucket and manual/debugging use, where
    // the whole point is every program in one run. Not in `gateNames()`, same
    // reason and same shape as `test-coldboot`/`test-stdlib-rebuild` above: `test`
    // runs the two split gates in `gateTableA` instead; `./make test-stress` does
    // this one.
    //
    // exclusive: true, DELIBERATELY, even though it is unreachable from `test`
    // (not in `gateNames()`, so `runAll`'s batching never sees it there). This
    // gate still runs the FULL corpus, including `parkdarwin`/`parklinux` — a 3x
    // discriminator margin, the tightest in the corpus. `scripts/gate.sh`'s
    // `runtime` bucket invokes this exact name (line 402) alongside five other
    // gates, and `main.bit`'s `runAll` decides concurrency from THIS flag, not
    // from `gateNames()` membership — so dropping it here would let that bucket
    // co-schedule the tightest-margin discriminators in this corpus with five
    // other gates, exactly the false-red risk this whole ticket exists to close.
    Gate{
      name = "test-stress", argv = runArgs("_tests_/bit/stress"), env = [std], exclusive = true,
      excludeReason = "cost: the full, unpartitioned corpus — `test` runs the two split gates (test-stress-exclusive/test-stress-batch, gateTableA) instead (this file's own comment above); run via ./make test-stress",
    },
    // #2538, epic #1253. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness reads _tests_/stress/parallel/*.bit
    // straight off disk and must not silently default to ".". Not in
    // `gateNames()` (tools/build/defs.bit), so `test` never runs it; `./make
    // test-stress-parallel-programs` does. `exclusive: false` — see the
    // harness's own header for why co-scheduling cannot corrupt its verdict.
    Gate{
      name = "test-stress-parallel-programs", argv = runArgs("_tests_/bit/stressparallel.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}", "BIT_REPO=${repoRoot()}"],
      excludeReason = "cost: builds every _tests_/stress/parallel/*.bit program twice, not free enough for every ./make test run (this file's own comment above); run via ./make test-stress-parallel-programs",
    },
    // #2570. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness shells out to
    // `bash scripts/selfhost-diffall.sh` against the repo root and must not
    // silently default to ".". Not in `gateNames()` (tools/build/defs.bit),
    // so `test` never runs it; `./make test-differentials` does.
    Gate{
      name = "test-differentials", argv = runArgs("_tests_/bit/selfhostdiff.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "cost: the whole self-host differential family runs into the tens of minutes (defs.bit's test-differentials Step{} comment); run via ./make test-differentials, and it IS re-added by name inside ./make test-prepush (prepushDifferentialsName, gatesprepush.bit)",
    },
    // #3118. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness shells out to `./make libbitrt`
    // and `sh scripts/stage0.sh` against the repo root and must not silently
    // default to ".". Not in `gateNames()` (tools/build/defs.bit), so `test`
    // never runs it; `./make test-stage0override` does.
    Gate{
      name = "test-stage0override", argv = runArgs("_tests_/bit/stage0override.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "cost: forces several real cross-compile ./make libbitrt relinks (defs.bit's test-stage0override Step{} comment); run via ./make test-stage0override",
    },
    // #4433. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness shells out to `./make selfhost`
    // against the repo root and must not silently default to ".". Not in
    // `gateNames()` (tools/build/defs.bit), so `test` never runs it — it
    // chmods a real directory in BIT_REPO, briefly, which would corrupt a
    // concurrent gate's own view of it inside the default batch. `./make
    // test-walkbit-empty-scan` does.
    Gate{
      name = "test-walkbit-empty-scan", argv = runArgs("_tests_/bit/walkbitcheck.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "destructive: chmods a real directory in BIT_REPO, briefly, which would corrupt a concurrent gate's own view of it inside the default batch (this file's own comment above); run via ./make test-walkbit-empty-scan",
    },
    // #4434. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness shells out to `./make selfhost`
    // against the repo root and must not silently default to ".". Not in
    // `gateNames()` (tools/build/defs.bit), so `test` never runs it — it
    // truncates the real bit-out/bin/bit in BIT_REPO, briefly, which would
    // corrupt a concurrent gate's own view of it inside the default batch.
    // `./make test-selfhost-liveness` does.
    Gate{
      name = "test-selfhost-liveness", argv = runArgs("_tests_/bit/selfhostliveness.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "destructive: truncates the real bit-out/bin/bit in BIT_REPO, briefly, which would corrupt a concurrent gate's own view of it inside the default batch (this file's own comment above); run via ./make test-selfhost-liveness",
    },
    // #5671, follow-up to #5624. BIT_REPO IS REQUIRED, same reason as
    // test-coldboot above: the harness shells out to `scripts/g2archive.sh`
    // and `bit run` against the repo root and must not silently default to
    // ".". Not in `gateNames()` (tools/build/defs.bit), so `test` never runs
    // it: it scratch-copies and rebuilds a whole runtime archive a second
    // time (measured ~6s, this harness's own header), on top of the one
    // `./make libbitrt` every gate run already pays for once. `./make
    // test-gc-fault-rescan` does.
    Gate{
      name = "test-gc-fault-rescan", argv = runArgs("_tests_/bit/gcfaultrescan.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "cost: rebuilds a scratch runtime archive from a flipped copy on top of the one ./make libbitrt already built (this file's own comment above); run via ./make test-gc-fault-rescan",
    },
    // #3341, epic #3322. BIT_REPO IS REQUIRED, same reason as test-coldboot
    // above: the harness shells out to `scripts/g2archive.sh` and `bit
    // build` against the repo root and must not silently default to ".".
    // BIT_WINDOWS_HOST overridable (default: scripts/x64host.sh --windows) so the
    // gate's own unreachable-host path is testable without a real outage.
    // Not in `gateNames()` (tools/build/defs.bit), so `test` never runs it;
    // `./make test-windows-smoke` does.
    Gate{
      name = "test-windows-smoke", argv = runArgs("_tests_/bit/windowssmoke.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "remote: depends on the Windows test host over SSH, and ./make test must never fail because a remote box is off or unreachable (defs.bit's test-windows-smoke Step{} comment); run via ./make test-windows-smoke",
    },
    // #3271, epic: first-party packages (`pkg/<name>/`). The whole package
    // family in one run, `BIT_PACKAGE_FILTER` unset. #5568: IN `gateNames()`
    // (tools/build/defs.bit's `gateSteps()`) as of this ticket — see that
    // Step{}'s own comment for the cost measurement that reversed the
    // original exclusion. No `excludeReason`: `test-gate-registry`
    // (_tests_/bit/gateregistry.bit) asserts one is absent exactly when the
    // name is present in `gateNames()`. scripts/gate.sh's
    // `selfhost`/`runtime`/`stdlib`/`full` buckets still add this name
    // explicitly alongside their own steps (their own comments, not this
    // ticket's scope) — now redundant for `full` (`test`'s own deps already
    // include it) but still needed for the narrower buckets, which do not
    // run the whole suite.
    Gate{
      name = "test-packages", argv = runArgs("_tests_/bit/packagesgate.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", packageWorkers()],
    },
    // #5129, closing #5126: web/v0.2.0 shipped importing std/runtime, which
    // no released compiler has, and every gate was green because every gate
    // (including test-packages above) builds packages with THIS TREE's
    // compiler. This one never builds anything — pure git plus text, see
    // _tests_/bit/packagereleasegate.bit's own header for why it reads the
    // newest `v0.*` tag's stdlib via `git archive` rather than any
    // installed or pinned compiler. Not in `gateNames()`: a release-drift
    // check is not a per-edit correctness gate and must never grow
    // `./make test` — unlike test-packages above (#5568), that reason does
    // not depend on measuring its cost, so it stays excluded on its own.
    Gate{
      name = "test-package-release-drift", argv = runArgs("_tests_/bit/packagereleasegate.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
      excludeReason = "release-only: a release-drift check against the newest v0.* tag, not a per-edit correctness gate (this file's own comment above); run via ./make test-package-release-drift",
    },
    // #5127: the doc-block coverage gap `test-docs` leaves for `pkg/**` —
    // see `tools/build/defs.bit`'s `test-package-docs` Step{} comment and
    // _tests_/bit/pkgdocsgate.bit's own header. `BIT_BIN` names the
    // compiler each scratch check project also runs `fmt --check` with.
    Gate{
      name = "test-package-docs", argv = runArgs("_tests_/bit/pkgdocsgate.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}"],
      excludeReason = "doc-corpus: fenced-block coverage over pkg/<name>/docs and README, not a per-edit correctness gate (defs.bit's test-package-docs Step{} comment); run via ./make test-package-docs",
    },
    // #5597: see defs.bit's `test-package-tags` Step{} comment and
    // _tests_/bit/packagetagsgate.bit's own header. `BIT_WORKERS=2` is
    // required — the harness's local vanity-document server runs on a
    // spawned green thread while the main thread blocks inside the `bit add`
    // child, same requirement test-pmvanity below already has.
    Gate{
      name = "test-package-tags", argv = runArgs("_tests_/bit/packagetagsgate.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", "BIT_WORKERS=2"],
      excludeReason = "release-drift-class: builds against each package's newest published TAG, not a per-edit correctness gate over the working tree (defs.bit's test-package-tags Step{} comment); run via ./make test-package-tags",
    },
    // #2742. Reads the emitted access back out through the memory an
    // oversized atomic width would have clobbered, rather than disassembling
    // (portable across all three targets without a host `objdump`); the
    // compile-time assert in compiler/lowerprim.bit is the primary defense —
    // this is the independent execution-level check.
    Gate{
      name = "test-atomicwidth", argv = runArgs("_tests_/bit/atomicwidth.bit"),
      env = [std],
    },
    // #2758. `BIT_REPO` so the harness resolves spec/SPEC.md against the
    // tree under test rather than searching relative to its own cwd.
    // Directory, not a single file, since #2973 split it into
    // `_tests_/bit/spec/{spec,specgrammar}.bit` — a bare `.bit` path loads only
    // that one file (compiler/build.bit's `moduleRootProblem`/`buildIr`), so
    // this must name the directory for both siblings to load as one module.
    Gate{
      name = "test-spec", argv = runArgs("_tests_/bit/spec"),
      env = ["BIT_REPO=${repoRoot()}"],
    },
    // #5339: JSX has shipped three defects behind fully green gates
    // (#3944, #5155, #5333), all the same shape — a hand-picked case list
    // cannot fail the way the grammar's own unconsidered corner fails. This
    // reads spec/SPEC.md's own §12.12 grammar block, censuses every
    // production against the case table in _tests_/bit/jsxconformance.bit,
    // and fails, naming it, when one has zero cases — see that file's own
    // header. `BIT_BIN` names the compiler every scratch check project runs
    // (`pkgdocsgate.bit`'s own local-path-dependency shape); `BIT_REPO` so
    // the harness resolves spec/SPEC.md, _tests_/cases/ and pkg/web against
    // the tree under test.
    Gate{
      name = "test-jsx-conformance", argv = runArgs("_tests_/bit/jsxconformance.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}"],
      excludeReason = "grammar-corpus gate, same asymmetric-design reason as test-package-docs above; run via ./make test-jsx-conformance",
    },
    // #5101. `BIT_REPO` so the harness resolves docs/, spec/, pkg/ and
    // dist/ against the tree under test, same reason as test-spec above.
    // Fails on any U+2014 (em dash) in docs/**/*.md, spec/*.md,
    // pkg/README.md, pkg/<name>/README.md, README.md, BOOTSTRAP.md or
    // dist/** — reader-facing prose only, never compiler/runtime/stdlib/
    // _tests_/ comments.
    Gate{
      name = "test-no-emdash", argv = runArgs("_tests_/bit/noemdash.bit"),
      env = ["BIT_REPO=${repoRoot()}"],
    },
    // #3072. `BIT_REPO` so the harness resolves spec/FMT.md and the cited
    // compiler/fmt*.bit files against the tree under test, same reason as
    // test-spec above.
    Gate{
      name = "test-fmt-citations", argv = runArgs("_tests_/bit/fmtcitations"),
      env = ["BIT_REPO=${repoRoot()}"],
    },
    // #2793. Independent of `bit lint`/E0200 by design (see the harness
    // header) — fails if any _tests_/bit/*.bit file is over the 800-line
    // limit, or if a grandfathered one (its allowlist emptied by #2867 phase
    // 2's splits, but the mechanism stays live for the next offender) grows
    // past its recorded count. `BIT_REPO` so the harness resolves _tests_/bit/
    // against the tree under test rather than searching relative to its own
    // cwd.
    Gate{
      name = "test-filesize", argv = runArgs("_tests_/bit/filesize.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
    },
    // #2920. No env override: the whole point is the UNSET path, the one
    // `boot.bit`'s local copy of the min-trigger default silently regressed.
    Gate{ name = "test-gc-defaults", argv = runArgs("_tests_/bit/gcdefaults.bit"), env = [std] },
    // #3623. Non-ASCII UTF-8 decoding must not allocate more objects than
    // ASCII decoding does. #2448's E0204 splits returned `class` values as
    // multiple-return vehicles, and a class is a heap object, so a pure-looking
    // refactor took every multi-byte decode from 1 object to 3 with no gate
    // able to see it — nothing in bench/cases/ decodes a non-ASCII rune. No
    // `exclusive`: the counter is swept+live, exactly deterministic and not
    // load-sensitive, unlike the wall-clock and RSS gates.
    Gate{ name = "test-rune-alloc", argv = runArgs("_tests_/bit/runealloc.bit"), env = [std] },
    // #2546 (epic #1660). Builds an allocation-heavy fixture and execs it
    // under `BIT_GC=stress`, asserting `abandoned=0` alongside a printed,
    // asserted `collections > 0` — the darwin boot thread's step-7 park loop
    // (#2543) must stay bracketed. `BIT_SELF_EXE` locates the compiler under
    // test; `exclusive: true` because `abandoned` counts a rendezvous that
    // gave up under CPU contention, so a co-scheduled neighbour can
    // manufacture one that has nothing to do with this bracket — see the
    // harness header.
    Gate{
      name = "test-gc-boot-safepoint", argv = runArgs("_tests_/bit/gcbootsafepoint.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", std], exclusive = true,
    },
    // #6060. A runtime environment knob (BIT_GC_GROWTH_PCT, BIT_GC_MIN_KB,
    // BIT_GC_MARKSTACK, BIT_WORKERS, the on/off flags) set outside its range
    // must end the program at boot with one stderr line and exit 64, never be
    // clamped or ignored; builds one tiny fixture and runs it once per case.
    // `BIT_SELF_EXE` locates the compiler; the knob is set only on the probe.
    Gate{
      name = "test-gc-env-range", argv = runArgs("_tests_/bit/gcenvrange.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
    // #4456: arm64's stack-map stream desynchronised after #4430 made a
    // redundant bounds check's panic block dead — recordSafepoint's running
    // counter handed every later safepoint another safepoint's live-register
    // set. Builds and runs the ticket's own repro plain and under
    // `BIT_GC=stress`, asserting the exact expected output both times; not
    // `exclusive`, the checks are correctness (exit code + stdout), not
    // wall-clock or load-sensitive.
    Gate{
      name = "test-safepoint-deadblock", argv = runArgs("_tests_/bit/safepointdeadblock.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
    // #4667: computeSkipConstMaterialize used `useCount == 1` as a proxy for
    // "every use folds this constant as an immediate", so a literal with two
    // folding uses got a dead `mov` and a live register anyway. Cross-emits an
    // aarch64-macos object on any host and counts instructions inside one
    // function's atom in __TEXT,__text; also builds and runs the fixture
    // natively. Correctness only, nothing timed, so not `exclusive`.
    Gate{
      name = "test-const-immfold", argv = runArgs("_tests_/bit/constimmfold.bit"),
      env = ["BIT=${bitBin()}", std],
    },
    // #2925/#3241 pinned runtime/gc + runtime/alloc consts against
    // compiler/codegen.bit's own pg*Word() literals here. RETIRED BY #4203:
    // the backends no longer mirror any runtime word offset -- they fetch one
    // address and read the word at offset 0 -- so there is nothing left for
    // that gate to compare. The behavioural gates below are what survive, and
    // they are the ones that actually run a compiled program.
    // #3434. The same coupling test-pollguardoffsets used to guard, one level
    // down and still live after #4203 retired that gate: both backends
    // emit bit_rt_port_gc_thread_token's instructions at the call site instead
    // of calling it, so the same machine code exists in the compiler and in
    // runtime/gc/{linux,darwin,windows}/gcthread.bit with no way to import one
    // from the other. Drift there is silent -- it builds, it links, no golden
    // output moves, and compiled code just disagrees with the runtime about
    // which thread is asking (#1650). BIT_REPO IS REQUIRED, same reason as
    // test-lint-runtime: the harness reads ${BIT_REPO}/compiler/*.bit and
    // ${BIT_REPO}/runtime/gc/**, and must not silently default to ".".
    Gate{
      name = "test-threadtokenbytes", argv = runArgs("_tests_/bit/threadtokenbytes.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
    },
    // #5045: every `schedTaskInit(<expr>, ...)` call site under
    // `_tests_/stress/**` and `runtime/root/<os>/` must resolve `<expr>` back
    // to a module-level array sized via `taskWords` (runtime/sched/task.bit)
    // — see the harness's own header for why #5042/#5034's 35 hand-fixed
    // sites needed this. BIT_REPO IS REQUIRED, same reason as
    // test-threadtokenbytes just above: the harness reads
    // `${BIT_REPO}/_tests_/stress/**` and `${BIT_REPO}/runtime/root/**` and
    // must not silently default to ".".
    Gate{
      name = "test-taskwords-sizing", argv = runArgs("_tests_/bit/taskwordssizing.bit"),
      env = [std, "BIT_REPO=${repoRoot()}"],
    },
    // #3242. `BIT_WORKERS=4` IS REQUIRED, not stylistic: this gate spawns an
    // allocation-free mutator and controls it from a second, concurrently
    // running task, and boot's scheduler default of one OS worker thread
    // leaves the two unable to run concurrently at all (see the harness's
    // own header). Behaviourally exercises the worldStopWord clause of the
    // back-edge poll guard no encoding-level check can prove: #4203 made the
    // compiled fast path a single word read, so only running a program shows
    // the runtime actually publishes into that word.
    Gate{
      name = "test-pollguardstopword", argv = runArgs("_tests_/bit/pollguardstopword.bit"),
      env = [std, "BIT_WORKERS=4"],
    },
    // #3564. Same shape and same reason as test-pollguardstopword above:
    // spawns an allocation-free mutator and, from a second concurrently
    // running task, drives a real preempt request through preemptStamp/
    // sysmonTick, asserting the COMPILED inline poll's preempt clause
    // actually observes and clears it — a word-offset-literal comparison
    // alone cannot prove that. BIT_WORKERS=4 IS REQUIRED, same reason as
    // test-pollguardstopword: the harness controls a second, concurrently
    // running task and boot's single-OS-worker default leaves the two
    // unable to run concurrently at all.
    Gate{
      name = "test-pollguardpreempt", argv = runArgs("_tests_/bit/pollguardpreempt.bit"),
      env = [std, "BIT_WORKERS=4"],
    },
    // #4123: same file/gate as above under a distinct name (dedup — see
    // waitForClear's own comment); meaningful only via x64gate.sh/boxlock's
    // --need x86_64-linux on real x86-64 hardware, since `bit run` compiles native.
    Gate{
      name = "test-pollguardpreemptx64", argv = runArgs("_tests_/bit/pollguardpreempt.bit"),
      env = [std, "BIT_WORKERS=4"],
      excludeReason = "arch-specific: `bit run` compiles native, so this only proves anything new on real x86-64 hardware (this file's own comment above); run via ./make test-pollguardpreemptx64, addressed via x64gate.sh or boxlock --need x86_64-linux",
    },
    // #4134. schedCheckDeadlock (runtime/sched/worker.bit) stood down
    // unconditionally above BIT_WORKERS=1, so the three gates above this one
    // hung forever instead of panicking. No env override here: the harness
    // runs each child program bounded, with its OWN BIT_WORKERS.
    Gate{
      name = "test-schedmultideadlock", argv = runArgs("_tests_/bit/schedmultideadlock.bit"),
      env = [std],
    },
    // #6733: `bit build -o` installs an executable by rename (#6697's
    // `writeFileAtomic`), so an exec'd signed Mach-O is never rewritten in
    // place. Needs a real exec and `ls -i`, which no golden can express; see
    // the harness header.
    Gate{
      name = "test-exec-replace", argv = runArgs("_tests_/bit/execreplace"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
    // #7558: a diamond of packages (two importing a third that declares its own
    // `Json`, an `@json` class and a `__field` subject) builds and runs, in
    // workspace mode and with BIT_WORKSPACE=off. Two app directories and a
    // bit.work, so neither the golden nor the checker-diag corpus can express
    // it; see the harness header.
    Gate{
      name = "test-pkgdiamond", argv = runArgs("_tests_/bit/pkgdiamond"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #3189. No env override: pins runtime/gc/stackmap.bit's smFormatVersion
    // export now, and is the place to extend once compiler/codegen.bit
    // carries its own mirror of the same literal.
    Gate{
      name = "test-stackmapformatversion",
      argv = runArgs("_tests_/bit/stackmapformatversion.bit"),
      env = [std],
    },
    // #6078/#6104 (epic #4027): provisions SeaweedFS's `weed mini -s3` in a
    // throwaway Docker container and runs pkg/s3's *.live.test.bit files
    // against it — see _tests_/bit/s3live.bit's own header for the image
    // pin (chosen over MinIO: no maintained image is freely pullable as of
    // 2026-09-27, #6104), the without-Docker failure, and the standalone-binary
    // peak-RSS proof for streaming put/get. Same BIT_REPO/BIT_BIN
    // requirement as test-package-redis-live (gatestable3.bit).
    Gate{
      name = "test-package-s3-live", argv = runArgs("_tests_/bit/s3live.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", packageWorkers()],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-package-s3-live",
    },
    // #6281: provisions postgres:18.6 AND mysql:8.4 in throwaway Docker
    // containers and runs `bit test pkg/orm` against both, failing on any
    // live test that skips (its `ORM_TEST_LIVE_PG_URI`/
    // `ORM_TEST_LIVE_MYSQL_URI` are always set here) — see
    // _tests_/bit/ormlive.bit's own header for the image pins, the
    // without-Docker failure, and what "always removes the containers" covers.
    // Same BIT_REPO/BIT_BIN requirement as test-package-redis-live
    // (gatestable3.bit).
    Gate{
      name = "test-package-orm-live", argv = runArgs("_tests_/bit/ormlive.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", packageWorkers()],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-package-orm-live",
    },
  ]
}
