// Shell/stage0/fingerprint/host-triple/stack-map-padding machinery for the
// Bit build driver (#1869, epic #1867). The `libbitrt`/`selfhost`/`install`/
// `uninstall` step BODIES that call this live in artifactsteps.bit — split
// out by #3442 once this file crossed the repo's 800-line E0200 limit
// (spec/LINT.md:186); pure move, no symbol here changed.
//
// Sorts before `defs.bit`, `artifactsteps.bit` and `main.bit` so the inliner
// has already lowered these by the time their callers are lowered (#1511).

import { readFile, writeFile, exists, mkdir, walk, remove } from "std/fs"
import { env } from "std/os"
import { hasSuffix } from "std/strings"

// The three CLI targets built by the PINNED stage0 (resolveStage0() below).
// x86_64-macos is deliberately absent, matching dist/package.sh's list.
//
// x86_64-windows is deliberately NOT here (#3341, epic #3322). `bit
// build --target x86_64-windows` is only understood by THIS TREE's own
// compiler.bit source — the pinned stage0 predates the whole Windows port
// and cannot be repinned to one until a Windows release ships (#3344, which
// is itself gated on this ticket). Verified 2026-08-21: adding
// "x86_64-windows" here makes the DEFAULT `./make libbitrt` (which always
// builds with resolveStage0()'s pinned compiler, never the tree's) fail on
// every invocation with "bit: unknown target 'x86_64-windows'" for every
// module, breaking the mandatory build for all three real targets too,
// since stepLibbitrt aborts its whole loop on first non-zero rc. Windows
// libbitrt.a is cross-built instead by _tests_/bit/windowssmoke.bit's own
// "test-windows-smoke" gate (tools/build/gates.bit), which shells out to
// scripts/g2archive.sh directly with BIT=bit-out/bin/bit — the tree's own
// already-built compiler (the same mechanism BIT_LIBBITRT_TREE=1 opts the
// other three into) — independent of this list and of stepLibbitrt's loop.
fn targets(): []string {
  return ["x86_64-linux", "aarch64-linux", "aarch64-macos"]
}

fn outDir(): string { return "bit-out" }
fn stampPath(): string { return "bit-out/make/fp-libbitrt.stamp" }
fn selfhostStamp(): string { return "bit-out/make/fp-selfhost.stamp" }

// --- shell -----------------------------------------------------------------

// Wraps `s` as exactly one POSIX `/bin/sh` word. Same rule golden.bit uses:
// single-quote everything and escape embedded quotes by closing, escaping,
// reopening.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '\'') {
      out = out + "'\\''"
    } else {
      out = out + string([]byte{ c })
    }
    i = i + 1
  }
  return out + "'"
}

// Runs `script` through /bin/sh and returns its exit code, or -2 on timeout.
//
// A generated wrapper rather than a direct exec because the runtime's process
// primitive takes one executable path, and every one of these needs an
// environment and sometimes a redirect. This is the same shape `golden.bit`
// and the other harnesses use.
fn runShell(name: string, script: string, timeoutMs: int): int {
  let path = "bit-out/make/run-${name}.sh"
  if (!ensureDir("bit-out/make")) {
    eprint("make: cannot create bit-out/make\n")
    return 1
  }
  writeFile(path, "#!/bin/sh\n" + script) catch _ {
    eprint("make: cannot write ${path}\n")
    return 1
  }
  if (fsChmod(path, 448) != 0) { // 0o700
    eprint("make: cannot chmod ${path}\n")
    return 1
  }
  return osRunBounded(path, timeoutMs)
}

// Generous: a cold three-target archive build is minutes, not seconds. A bound
// exists at all so a wedged child fails loudly instead of hanging the driver —
// a hang is a failure, not a stall (#1637/#1652).
fn buildTimeoutMs(): int { return 1800000 }

// --- stage0 ----------------------------------------------------------------

// Resolves the pinned stage0 exactly as every differential does, so there is
// ONE answer to "which compiler builds this tree". Prints the wrapper path.
fn resolveStage0(): (string, bool) {
  let outPath = "bit-out/make/stage0.path"
  let rc = runShell("stage0", "sh scripts/stage0.sh > " + shQuote(outPath) + "\n", buildTimeoutMs())
  if (rc != 0) {
    eprint("make: cannot resolve stage0 (scripts/stage0.sh exited ${rc})\n")
    return "", false
  }
  let text = readFile(outPath) catch _ {
    eprint("make: cannot read ${outPath}\n")
    return "", false
  }
  return trimNewline(text), true
}

fn trimNewline(s: string): string {
  let end = len(s)
  while (end > 0 && (s[end - 1] == '\n' || s[end - 1] == '\r')) {
    end = end - 1
  }
  return s[:end]
}

// --- fingerprint -----------------------------------------------------------

// What decides `libbitrt.a`'s bytes: the runtime sources, this driver, and THE
// COMPILER THAT READS THEM.
//
// The compiler half is the part that has already gone wrong once. The
// fingerprint covers `dist/stage0/SHA256SUMS`, which identifies the PINNED
// stage0 exactly — but `BIT_STAGE0_BIN` overrides which compiler is used without
// touching that file, so an overridden run reuses the stale archive. That is
// #1863, and it matters precisely because the override's only purpose is
// replacing a stage0 that MISCOMPILES the runtime (#1857): the stale archive
// would be the broken one the override existed to avoid.
//
// So both are folded in: the pin, and — when set — the bytes of the overriding
// binary itself.
//
// A third input, `BIT_LIBBITRT_TREE` (#3054, #3117): when set, `libbitrt.a` is
// compiled by THIS TREE's own self-hosted compiler rather than stage0, so
// `compiler/**` now decides the archive's bytes too — the exact reason it is
// otherwise excluded (see `compilerHash()` below) stops holding. Folding it in
// only under the flag keeps the default fingerprint, and therefore the default
// archive, byte-for-byte unchanged; this is the same stale-archive shape
// `fingerprint()` already guards for `BIT_STAGE0_BIN` (#1863).
fn fingerprint(): string {
  let h = newFpHash()
  h.write(bytes("v1\n"))
  hashPathList(h, sourceFiles())
  hashOne(h, "dist/stage0/SHA256SUMS")
  let override = env("BIT_STAGE0_BIN")
  if (override != "") {
    h.write(bytes("override:" + override + "\n"))
    hashOne(h, override)
  }
  let tree = env("BIT_LIBBITRT_TREE")
  if (tree != "") {
    h.write(bytes("tree:" + tree + "\n"))
    hashPathList(h, walkBit("compiler"))
  }
  return fpEncodeHex(h.sum())
}

fn bytes(s: string): []byte {
  let out = []byte(0)
  let i = 0
  while (i < len(s)) {
    out = append(out, s[i])
    i = i + 1
  }
  return out
}

// `runtime/**` decides the archive; `tools/build/**` decides how it is built.
fn sourceFiles(): []string {
  let out = []string(0)
  for p of walkBit("runtime") {
    out = append(out, p)
  }
  for p of walkBit("tools/build") {
    out = append(out, p)
  }
  return out
}

fn walkBit(root: string): []string {
  let out = []string(0)
  let all = walk(root) catch _ {
    return out
  }
  for p of all {
    if (hasSuffix(p, ".bit")) {
      out = append(out, p)
    }
  }
  return out
}

// Path AND content: a rename with identical bytes still changes what compiles.
fn hashPathList(h: FpHash, paths: []string) {
  for p of paths {
    hashOne(h, p)
  }
}

fn hashOne(h: FpHash, path: string) {
  h.write(bytes("path:" + path + "\n"))
  let data = readFile(path) catch _ {
    h.write(bytes("missing\n"))
    return
  }
  h.write(bytes(data))
}

fn readStamp(path: string): string {
  let s = readFile(path) catch _ {
    return ""
  }
  return trimNewline(s)
}

// A stamp that cannot be written is not fatal — the next run simply rebuilds —
// but it must not be silent, or a permanently-unwritable stamp looks like a
// cache that never warms.
fn writeStamp(path: string, fp: string) {
  if (!ensureDir("bit-out/make")) {
    eprint("make: cannot create bit-out/make; not recording ${path}\n")
    return
  }
  writeFile(path, fp + "\n") catch _ {
    eprint("make: cannot write stamp ${path}; the next run will rebuild\n")
    return
  }
}

// `mkdir` on an existing directory fails, and this is called on paths that
// usually already exist.
fn ensureDir(p: string): bool {
  if (exists(p)) {
    return true
  }
  mkdir(p) catch _ {
    return false
  }
  return true
}

// A stamp match is only trustworthy if the outputs it describes still exist —
// a stamp plus a deleted archive would skip the rebuild and leave nothing.
fn allExist(paths: []string): bool {
  for p of paths {
    if (!exists(p)) {
      return false
    }
  }
  return true
}

fn archivePaths(): []string {
  let out = []string(0)
  for t of targets() {
    out = append(out, "${outDir()}/lib/${t}/libbitrt.a")
  }
  return out
}

// --- host triple -----------------------------------------------------------

// Which archive `bit` itself links against. Resolved with `uname` rather than
// assumed: the driver runs on all three targets.
fn hostTriple(): string {
  let outPath = "bit-out/make/host.triple"
  let script = "case \"$(uname -s)-$(uname -m)\" in\n" +
    "  Darwin-arm64)              echo aarch64-macos ;;\n" +
    "  Linux-aarch64|Linux-arm64) echo aarch64-linux ;;\n" +
    "  Linux-x86_64)              echo x86_64-linux ;;\n" +
    "  *) echo unsupported ;;\n" +
    "esac > " +
    shQuote(outPath) +
    "\n"
  if (runShell("host", script, buildTimeoutMs()) != 0) {
    return "unsupported"
  }
  let t = readFile(outPath) catch _ {
    return "unsupported"
  }
  return trimNewline(t)
}

// --- stack-map padding (#3198) ----------------------------------------------
//
// #1927 split the stack-map entry format's writer and reader across two
// build inputs that update on different schedules. The writer
// (`padTo(out, 8)`, compiler/codegen.bit:277) is frozen inside whichever
// compiler emitted this archive's objects; the reader (the `off % 8`
// round-up, runtime/gc/stackmap.bit) is source, so it reaches every rebuild
// immediately. When the host archive is built by a compiler that predates
// #1927 (the pinned stage0, on an ordinary single-pass `./make`), every
// emitted entry is tightly packed with no trailing pad, but the tree's
// reader still rounds its cursor up to the next 8-byte boundary after each
// one — the walk desyncs on the first entry whose own length was not
// already a multiple of 8 and dereferences garbage on the first collection
// (bus error). Measured (#3198): a plain single-pass build's `runtime_gc.o`
// `__bit_gc` section was 5978 bytes (%8 = 2); a correct two-pass build's
// was 6200 bytes (%8 = 0). `BIT_GC=off` on the broken binary runs fine —
// the walk that dereferences garbage never executes.
//
// This inspects bytes already on disk after the archive is written, unlike
// checkRuntimeAbiArity() above, which compares SOURCE before a single byte
// is written — there is nothing to inspect until the archive exists. See
// stepLibbitrt's call site for what a refusal does about that archive.
//
// Every `__bit_gc` (Mach-O) / `.bit_gc` (ELF) section across the archive's
// member objects must be a multiple of 8 bytes. Read directly off the
// platform's own object-inspection tool run against the WHOLE archive in
// one invocation — both `otool -l` (macOS) and `objdump -h` (Linux/binutils)
// walk every member of a `.a` and print its own section headers, so no
// extraction step (`ar x`) is needed.

class StackMapSection { obj: string, sizeBytes: int }

fn isHexDigit(c: u8): bool {
  return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn hexDigitVal(c: u8): int {
  if (c >= '0' && c <= '9') {
    return int(c) - int('0')
  }
  if (c >= 'a' && c <= 'f') {
    return int(c) - int('a') + 10
  }
  return int(c) - int('A') + 10
}

// The integer value of the first "0x"-prefixed hex run on `line`, or -1 —
// otool -l's "size 0x00000000000005fa" field shape.
fn firstHexOnLine(line: string): int {
  let i = 0
  let n = len(line)
  while (i + 1 < n) {
    if (line[i] == '0' && line[i + 1] == 'x') {
      let j = i + 2
      let v = 0
      let saw = false
      while (j < n && isHexDigit(line[j])) {
        v = v * 16 + hexDigitVal(line[j])
        j = j + 1
        saw = true
      }
      if (saw) {
        return v
      }
    }
    i = i + 1
  }
  return 0 - 1
}

// The integer value of the (unprefixed) hex run starting at the first
// non-space character at or after `start`, or -1 — objdump -h's "Size"
// column ("00000cb8", no "0x"), read as the token immediately following the
// matched section name rather than from the start of the line: ".bit_gc"
// itself contains the hex digits 'b' and 'c', so scanning from the line's
// start would misparse the section name as part of the number.
fn hexRunAt(line: string, start: int): int {
  let i = start
  let n = len(line)
  while (i < n && line[i] == ' ') {
    i = i + 1
  }
  let v = 0
  let saw = false
  while (i < n && isHexDigit(line[i])) {
    v = v * 16 + hexDigitVal(line[i])
    i = i + 1
    saw = true
  }
  if (!saw) {
    return 0 - 1
  }
  return v
}

// Parses combined multi-member `otool -l <archive>` text (macOS): a member
// boundary is a line ending "(<member>.o):"; each `sectname __bit_gc` line
// is followed, a few lines later, by its stanza's `size` field (otool's
// fixed Section/sectname/segname/addr/size/... shape — the same window
// _tests_/bit/globalsbss.bit's otoolSectionSize scans, generalized here to
// walk every member instead of stopping at the first match).
fn parseOtoolBitGc(text: string): []StackMapSection {
  let out = []StackMapSection(0)
  let lines = split(text, "\n")
  let n = len(lines)
  let curObj = ""
  let i = 0
  while (i < n) {
    let line = lines[i]
    let openAt = indexOf(line, "(")
    if (openAt >= 0 && contains(line[openAt:], "):")) {
      let closeAt = indexOf(line[openAt:], "):")
      curObj = line[openAt + 1:openAt + closeAt]
    } else if (contains(line, "sectname __bit_gc")) {
      let j = i
      let limit = i + 8
      if (limit > n) {
        limit = n
      }
      while (j < limit) {
        if (hasPrefix(trimSpace(lines[j]), "size ")) {
          out = append(out, StackMapSection{ obj: curObj, sizeBytes: firstHexOnLine(lines[j]) })
          j = limit
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return out
}

// Parses combined multi-member `objdump -h <archive>` text (Linux hosts): a
// member boundary is "<member>:     file format ...", and a section line
// holds the section name immediately followed by its size as a bare hex
// run — objdump -h's fixed Idx/Name/Size/VMA/LMA/File-off/Algn columns.
fn parseObjdumpBitGc(text: string): []StackMapSection {
  let out = []StackMapSection(0)
  let lines = split(text, "\n")
  let curObj = ""
  for line of lines {
    let ffAt = indexOf(line, ":     file format")
    if (ffAt >= 0) {
      curObj = line[:ffAt]
      continue
    }
    let nameAt = indexOf(line, ".bit_gc")
    if (nameAt >= 0) {
      let size = hexRunAt(line, nameAt + len(".bit_gc"))
      if (size >= 0) {
        out = append(out, StackMapSection{ obj: curObj, sizeBytes: size })
      }
    }
  }
  return out
}

// Whether THIS TREE's copy of the stack-map reader — runtime/gc/stackmap.bit,
// compiled into the very runtime_gc.o checkStackMapPadding inspects — expects
// entries padded to 8 bytes (#1927, runtime/ABI.md §4). The archive is
// self-describing: its reader is not an external fact to remember, it is
// source sitting right next to the writer that produced the archive, and
// during pass 1 of the two-pass bootstrap (docs/development.md, "Landing a
// runtime ABI change") that source is deliberately the pre-#1927 revision,
// whose reader never rounds and whose writer (stage0) never padded — self
// consistent, and wrongly refused by a check that assumed padding is always
// required (#3200).
//
// Textual, like checkRuntimeAbiArity's own signature scan above: the round-up
// is one deliberately narrow shape — a remainder computed with "% 8", then
// the cursor advanced past the pad with "+ 8 -". Verified unique to this file
// today (2026-08-16): each substring occurs exactly once in the current
// runtime/gc/stackmap.bit and zero times in the pre-#1927 revision
// (6b92e691). Both must be present — either alone is too weak a signal — for
// this to report the reader as rounding.
fn stackMapReaderRounds(): bool {
  let text = readFile("runtime/gc/stackmap.bit") catch _ {
    return true
  }
  return contains(text, "% 8") && contains(text, "+ 8 -")
}

// After stepLibbitrt writes the host archive, assert every __bit_gc/.bit_gc
// section across its members is 8-aligned, but only when this tree's own
// reader (stackMapReaderRounds, above) actually depends on that padding —
// unpadded entries paired with a non-rounding reader are correct, not a bug
// (#3200). Skips itself (with a warning, not a failure) ONLY when the archive
// cannot be inspected at all — a missing otool/objdump, or a nonzero exit, or
// empty output is an infrastructure gap, not evidence either way, and must
// not manufacture a build failure unrelated to this bug class (mirrors
// checkRuntimeAbiArity's own infra-hiccup skips above).
//
// A successful, non-empty inspector run that the parser then reads as ZERO
// sections is a DIFFERENT case and must NOT skip (#3199): every member built
// from runtime/gc/** carries a __bit_gc/.bit_gc section, so the parser
// finding none in a tool run that itself succeeded means the parser no
// longer understands the inspector's output — a broken instrument, not
// nothing to check. Refuse and name what was inspected and why the parse
// came back empty, the same way reportStackMapPadding refuses for a bad
// section rather than warning about one.
fn checkStackMapPadding(host: string): bool {
  let archive = "${outDir()}/lib/${host}/libbitrt.a"
  if (!exists(archive)) {
    return true
  }
  let outPath = "bit-out/make/stackmap-check.out"
  let macos = contains(host, "macos")
  let tool = "objdump -h"
  if (macos) {
    tool = "otool -l"
  }
  let script = tool + " " + shQuote(archive) + " > " + shQuote(outPath) + " 2>&1\n"
  let rc = runShell("stackmap-check", script, buildTimeoutMs())
  let text = readFile(outPath) catch _ {
    ""
  }
  if (rc != 0 || len(text) == 0) {
    eprint("make: libbitrt: cannot inspect ${archive} with '${tool}' for the stack-map padding check (rc=${rc}); skipping (#3198)\n")
    return true
  }
  let sections = []StackMapSection(0)
  if (macos) {
    sections = parseOtoolBitGc(text)
  } else {
    sections = parseObjdumpBitGc(text)
  }
  if (len(sections) == 0) {
    eprint("make: libbitrt: refusing — '${tool}' on ${archive} exited 0 with output, but no __bit_gc/.bit_gc section was found in it; the parser no longer understands this inspector's output format, so the #3198 stack-map padding check cannot run (#3199).\n")
    eprint("make: this is a broken guard, not a clean archive — every member built from runtime/gc/** carries this section. Fix parseOtoolBitGc/parseObjdumpBitGc in tools/build/artifacts.bit for the current '${tool}' output shape before retrying.\n")
    return false
  }
  print("make:   stack-map padding check: inspected ${len(sections)} __bit_gc/.bit_gc section(s) in ${archive}\n")
  let bad = []StackMapSection(0)
  for s of sections {
    if (s.sizeBytes >= 0 && s.sizeBytes % 8 != 0) {
      bad = append(bad, s)
    }
  }
  return reportStackMapPadding(archive, bad)
}

// Split out of checkStackMapPadding to keep that function's complexity under
// the repo's E0204 limit of 10 (#3200) — a pure decision-and-report step with
// no side effect on `bad` itself: refuse and delete the suspect archives only
// when there ARE misaligned entries AND this tree's own reader depends on
// them being padded (stackMapReaderRounds, above). Unpadded entries paired
// with a non-rounding reader (pass 1 of the two-pass bootstrap) are correct,
// not a bug, and must pass silently.
fn reportStackMapPadding(archive: string, bad: []StackMapSection): bool {
  if (len(bad) == 0) {
    return true
  }
  if (!stackMapReaderRounds()) {
    return true
  }
  eprint("make: libbitrt: refusing — ${archive} carries stack-map entries that are NOT 8-aligned (#1927, runtime/ABI.md §4):\n")
  for s of bad {
    eprint("make:   ${s.obj}: __bit_gc/.bit_gc section is ${s.sizeBytes} bytes (% 8 = ${s.sizeBytes % 8})\n")
  }
  eprint("make: this archive's objects were built by a compiler that predates #1927's entry padding, while runtime/gc/stackmap.bit's reader (source, always current) rounds every entry up to 8 bytes regardless — the walk desyncs on the first unpadded entry and dereferences garbage on the first collection (#3198).\n")
  // NOT scripts/stage0.sh's plain-`./make` pass 1 recipe: that describes
  // #1857, a compiler-only fix where the runtime is unchanged, so it does
  // not generalise here — on a tree whose runtime has moved, a plain `./make`
  // pass 1 is the command that just refused, and following it loops (#3200).
  eprint("make: land this with the two-pass BIT_STAGE0_BIN bootstrap instead (docs/development.md, \"Landing a runtime ABI change\"):\n")
  eprint("make:   rm -rf bit-out && git checkout <commit before the runtime change> -- runtime/\n")
  eprint("make:   ./make                                # pass 1: a compiler self-consistent with the OLD runtime\n")
  eprint("make:   cp bit-out/bin/bit \$TMPDIR/bit1\n")
  eprint("make:   git checkout HEAD -- runtime/          # restore on EVERY exit path, including failure, before anything else reads the tree\n")
  eprint("make:   BIT_STAGE0_BIN=\$TMPDIR/bit1 ./make    # pass 2 — do NOT rm -rf bit-out here: ./make links its own driver against bit-out/lib/<triple>/libbitrt.a and wiping it leaves the driver unbuildable (rc=2)\n")
  removeArchives()
  return false
}

// Deletes every target's archive when checkStackMapPadding refuses, rather
// than leaving them on disk for the next command to link. All three were
// built by the same compiler in the same invocation (the loop in
// stepLibbitrt / stepLibbitrtTree shares one `BIT`/`bit1` for every target),
// so a bad host archive means all three are equally suspect. Mirrors #3197's
// own reasoning for moving checkRuntimeAbiArity() before the write: a
// refusal that leaves a previously-good archive overwritten by a bad one
// reports failure while silently leaving the tree worse than it found it.
// stepLibbitrt never reaches writeStamp() on this path, so a rebuild is
// forced (and re-checked) on the very next invocation regardless of whether
// the archive files themselves still exist — deleting them is about not
// leaving a corrupt-but-looks-built artifact on disk, not about the
// driver's own cache being fooled.
fn removeArchives() {
  for p of archivePaths() {
    if (exists(p)) {
      remove(p) catch _ {
        eprint("make: warning: could not remove suspect archive ${p}; delete it by hand before the next build\n")
      }
    }
  }
}

