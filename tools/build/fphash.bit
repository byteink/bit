// A tiny, dependency-free content digest for tools/build's OWN fingerprinting
// and gate run-IDs. Deliberately NOT `std/crypto` (#3538).
//
// tools/build is bootstrapped by the PINNED stage0 (`scripts/stage0.sh`) — an
// old release, whose bundled `libbitrt.a` is frozen at pin time. Bit modules
// are per-DIRECTORY (SPEC §17.1): importing anything at all from `std/crypto`
// pulls the WHOLE `stdlib/crypto/` directory into this module's checked
// project, including every `extern fn` declared in ANY sibling file there —
// not just the symbols actually named on the `import` line. `stdlib/crypto/
// aes.bit`'s three ARM64 hardware-AES externs (#2526) postdate the 0.1.25
// stage0 pin, so `rejectExternForTarget` (compiler/buildextern.bit) rejects
// the whole driver before it can build a fresh `libbitrt.a` to satisfy them.
//
// PROVED EMPIRICALLY, not reasoned: moving the offending externs to a nested
// submodule under `stdlib/crypto/` does not help. `p.mods` (compiler/
// project.bit's `loadProject`) is the full TRANSITIVE closure of imports from
// the project root, and `rejectExternForTarget` scans every module in it —
// so any sibling file that still needs to CALL those externs (`aes.bit`
// itself, or another AES-mode file like `gcm.bit`) re-imports that submodule,
// which is then transitively included the moment ANYTHING imports
// `std/crypto`, regardless of which specific symbol was wanted. Confirmed with
// two isolated scratch modules under $TMPDIR: an extern nested three levels
// deep, reachable only through an unrelated sibling file's own import chain,
// still fails E0078 on a build that never asked for it — and disappears the
// moment nothing in the transitive closure imports that module at all. The
// only fix immune to a FUTURE `std/crypto` addition is for `tools/build` to
// depend on nothing in it, ever.
//
// Neither use here needs cryptographic properties. `fingerprint()` /
// `compilerHash()` / `stdlibHash()` (artifacts.bit / artifactsteps.bit) are a
// build-cache invalidation key — a collision only costs one spurious rebuild,
// recoverable by `rm -rf bit-out`. `currentGateStamp()`'s run ID
// (gatesexec.bit) only needs to disambiguate concurrent `./make` invocations'
// `.rc`/`.out` files, not resist an attacker. A 128-bit two-lane FNV-1a over
// the content, and a clock-mixed id for the run-ID case, are more than
// adequate for both, and neither needs an `extern fn` at all.

// `monotonic` is already imported module-wide by main.bit; importing it again
// here would be E0042 "already declared in this scope" (imports are per
// MODULE, not per file — see this repo's CLAUDE.md).
import { now } from "std/time"

const fnv64Prime: u64 = 1099511628211
const fnv64OffsetA: u64 = 14695981039346656037
// SplitMix64's golden-ratio increment (0x9E3779B97F4A7C15) — a well-known
// odd spreading constant, used here only as a second, independent FNV lane
// seed so the 128-bit digest is not just the first lane repeated.
const fnv64OffsetB: u64 = 11400714819323198485

// Streaming two-lane FNV-1a. `write` may be called any number of times before
// `sum`, matching `std/crypto`'s `Hash.write`/`sum` shape closely enough that
// callers here read the same as before.
class FpHash {
  a: u64
  b: u64

  write(data: []byte) {
    let i = 0
    while (i < len(data)) {
      let v = u64(data[i])
      this.a = (this.a ^ v) * fnv64Prime
      this.b = (this.b ^ v) * fnv64Prime
      i = i + 1
    }
  }

  // 16-byte (128-bit) digest: the two lanes, big-endian.
  sum(): []byte {
    let out = []byte(16)
    putU64BE8(out, 0, this.a)
    putU64BE8(out, 8, this.b)
    return out
  }
}

fn newFpHash(): FpHash {
  return FpHash{ a: fnv64OffsetA, b: fnv64OffsetB }
}

// Write `v` big-endian into `out[off..off+8]`.
fn putU64BE8(out: []byte, off: int, v: u64) {
  out[off] = u8(v >> 56)
  out[off + 1] = u8(v >> 48)
  out[off + 2] = u8(v >> 40)
  out[off + 3] = u8(v >> 32)
  out[off + 4] = u8(v >> 24)
  out[off + 5] = u8(v >> 16)
  out[off + 6] = u8(v >> 8)
  out[off + 7] = u8(v)
}

const fpHexDigits: string = "0123456789abcdef"

// Lowercase hex, high nibble first — the same shape as `std/crypto`'s
// `encodeHex`, reimplemented locally so this file has zero cross-module
// dependency beyond the already-stable, already-imported `std/time`.
fn fpEncodeHex(b: []byte): string {
  let out = []byte(len(b) * 2)
  let i = 0
  while (i < len(b)) {
    let v = b[i]
    out[i * 2] = fpHexDigits[int(v >> 4)]
    out[i * 2 + 1] = fpHexDigits[int(v & 0x0f)]
    i = i + 1
  }
  return string(out)
}

// A run ID good enough to disambiguate concurrent `./make` invocations'
// `.rc`/`.out` files (gatesexec.bit's `currentGateStamp`) — not a security
// token. Mixes the monotonic clock (guaranteed non-decreasing within this
// boot, per-process) with the wall clock (independent source, defeats a
// same-instant read from two concurrent processes on a coarse monotonic
// clocksource) through one FNV-1a lane, then hex-encodes the 8-byte result —
// the same 16-hex-character shape `encodeHex(randomBytes(8))` produced.
fn fpRunId(): string {
  let h = newFpHash()
  let mono = []byte(8)
  putU64BE8(mono, 0, u64(monotonic().ns))
  h.write(mono)
  let wall = []byte(8)
  putU64BE8(wall, 0, u64(now().ns))
  h.write(wall)
  let sum = h.sum()
  return fpEncodeHex(sum[0:8])
}
