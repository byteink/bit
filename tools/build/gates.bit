// The 23 `test-*` gates for the Bit build driver (#1870, epic #1867).
//
// None of these contains test logic: every one launches a Bit program under
// `tests/bit/` (or drives a `bit` subcommand), and the whole job is handing it
// the right environment. A missing variable is not a crash, it is a SILENTLY
// DIFFERENT TEST — a harness that falls back to a default stdlib or a default
// binary still exits 0 and still reports a pass. So the table below is
// transcribed from the harnesses' actual requirements rather than inferred:
// a gate whose environment is wrong exits 0 and reports a pass anyway.
//
// Sorts after `artifacts.bit` (whose `runShell`/`shQuote`/`hostTriple` it uses)
// and before `main.bit` (which calls it), so the inliner sees each callee
// already lowered (#1511).

import { envOr } from "std/os"

struct Gate {
  name: string
  argv: []string
  env: []string
  // Asserts on wall-clock or memory rather than a fixed expected result, so a
  // co-scheduled neighbour changes the number it reports (#2400, #2401, #2210).
  // Defaults false; set true on exactly the five gates that need the machine
  // to itself. `runAll` (main.bit) keeps these out of the concurrent batch and
  // runs them alone, afterwards.
  exclusive: bool
}

// Absolute, because several harnesses generate a wrapper that `cd`s elsewhere
// before exec'ing; a relative path would resolve against the wrong directory.
// `./make` exports this.
function repoRoot(): string {
  return envOr("BIT_MAKE_ROOT", ".")
}

function bitBin(): string { return "${repoRoot()}/bit-out/bin/bit" }
function stdlibRoot(): string { return "${repoRoot()}/stdlib" }

// The archive `bit` links against on THIS host.
//
// The golden gate's archive path must NOT be hardcoded to one triple. It once
// was — `bit-out/lib/aarch64-macos/libbitrt.a` — which is correct only on macOS
// and broke on the Linux hosts `scripts/x64gate.sh` and `scripts/arm64gate.sh`
// drive. Resolved here
// instead.
function hostArchive(): string {
  return "${repoRoot()}/bit-out/lib/${hostTriple()}/libbitrt.a"
}

function runArgs(src: string): []string {
  return ["run", "${repoRoot()}/${src}"]
}

// One entry per `test-*` step. Split across two functions only to stay under
// the repo's max-fn-lines; the two together are the whole set, and `gateTable`
// is what everything reads.
function gateTable(): []Gate {
  let out = []Gate(0)
  for g of gateTableA() {
    out = append(out, g)
  }
  for g of gateTableB() {
    out = append(out, g)
  }
  return out
}

function gateTableA(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    Gate{name: "test-osenv", argv: runArgs("tests/bit/osenv.bit"), env: [std]},
    Gate{name: "test-stdlib-docs", argv: runArgs("tests/bit/stdlibdocs.bit"),
      env: ["BIT_DOCS_ROOT=${repoRoot()}", std]},
    Gate{name: "test-version-cli", argv: runArgs("tests/bit/version.bit"),
      env: ["BIT_REPO=${repoRoot()}"]},
    Gate{name: "test-lint", argv: runArgs("tests/bit/lintcmd.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    Gate{name: "test-runcmd", argv: runArgs("tests/bit/runcmd.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2107. The layer ABOVE every subcommand: an unrecognised flag must be
    // refused, not consumed as an operand. Lives here rather than in tests/cases
    // because the whole property is argv in / exit code + stderr out, which a
    // golden (single file, stdout only) cannot express.
    Gate{name: "test-clicmd", argv: runArgs("tests/bit/clicmd.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2261. Lives here rather than in tests/cases because it asserts a
    // REJECTION the pinned stage0 oracle does not make, and a golden would put
    // that deliberate divergence inside selfhost-diffcheck.sh's sweep as a
    // FALSEPOS. See the header of tests/bit/constoverflow.bit.
    Gate{name: "test-const-overflow", argv: runArgs("tests/bit/constoverflow.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2129. Needs TWO sibling files in one module and it needs STDERR, so it
    // fits neither tests/cases (single file) nor tests/imports (compares stdout
    // and fails a case whose build fails). See the header of the harness.
    Gate{name: "test-dupdecl-note", argv: runArgs("tests/bit/dupdeclnote.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2385. Same reason as test-const-overflow above: it asserts a REFUSAL the
    // pinned stage0 oracle does not make — the oracle BUILDS all three of its
    // rejection cases, two into a segfault and one into a plausible wrong answer
    // — so a golden would put that deliberate divergence inside
    // selfhost-diffcheck.sh's sweep as a FALSEPOS. See the header of
    // tests/bit/lowerrefuse.bit.
    Gate{name: "test-lower-refuse", argv: runArgs("tests/bit/lowerrefuse.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2235. SPEC §17.4's `main(): ()!` row: the error prints to stderr and the
    // process exits 1. Lives here rather than in tests/cases because a golden
    // cannot express exit 1 plus stderr — `// panic` pins the exit to exactly 2 —
    // and because the fix deliberately changes the IR of every fallible `main`
    // (ABI.md §10), which the pinned oracle predates. See the harness header.
    Gate{name: "test-main-exit", argv: runArgs("tests/bit/mainexit.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2360, #2243, #2148. Same reason as test-const-overflow above: all three
    // assert REJECTIONS the pinned stage0 oracle does not make, and a golden
    // would put that deliberate divergence inside selfhost-diffcheck.sh's
    // sweep as a FALSEPOS. See the header of tests/bit/genericdiag.bit.
    Gate{name: "test-generic-diag", argv: runArgs("tests/bit/genericdiag.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2232/#2123, #2230, #2237, and #2377 which moved them here. Same reason as
    // test-const-overflow above, with one extra turn of the screw: these four
    // fixes are NEWER than the pinned oracle's release, so no repin can clear
    // them. Unlike its two neighbours this gate compares the FULL rendered
    // diagnostic against a `.expected` — the cases arrived from tests/cases with
    // one, and BIT_CHECKER_CASES_DIR is where they now live. See the header of
    // tests/bit/checkerdiag.bit.
    Gate{name: "test-checker-diag", argv: runArgs("tests/bit/checkerdiag.bit"),
      env: [std, "BIT_CHECKER_CASES_DIR=${repoRoot()}/tests/bit/checkercases",
        "BIT_BIN=${bitBin()}"]},
    // #2344, and the front-end behaviour cases after it. Related to
    // test-checker-diag but NOT the same reason: these cases are ACCEPTED by
    // both compilers and PARSED differently, which reddens
    // selfhost-diffast.sh/diffir/difftypes rather than diffcheck. They are built
    // and RUN, because #2344's bug was a clean `bit check` followed by a SIGSEGV
    // from the binary. See the header of tests/bit/parsergate.bit.
    Gate{name: "test-parser", argv: runArgs("tests/bit/parsergate.bit"),
      env: [std, "BIT_PARSER_CASES_DIR=${repoRoot()}/tests/bit/parsercases",
        "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"]},
    Gate{name: "test-fsblock", argv: runArgs("tests/bit/fsblock.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    Gate{name: "test-lsp-lifecycle", argv: runArgs("tests/bit/lsplifecycle.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-resolve", argv: runArgs("tests/bit/lspresolve.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #2326/#2348. Measures ALLOCATION, not RSS, and compares two arms of one
    // run against each other rather than an absolute count — see the header of
    // tests/bit/lspcache.bit for why either alternative cannot work here.
    Gate{name: "test-lsp-cache", argv: runArgs("tests/bit/lspcache.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-pathresolve", argv: runArgs("tests/bit/pathresolve.bit"), env: [std]},
    Gate{name: "test-pmimports", argv: runArgs("tests/bit/pmimports.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    // BIT_WORKERS=2 IS REQUIRED. The harness spawns a green thread to serve
    // one local HTTP request while the main thread blocks inside
    // `osRunBounded` waiting on the `bit add` child it drives — with this
    // runtime's default of exactly one scheduler worker OS thread (ABI.md
    // §9), that spawned thread never runs until the blocking call returns,
    // so the vanity-document fetch always times out. Reproduced directly: a
    // second worker is what turns the accept from "never" into "immediate".
    Gate{name: "test-pmvanity", argv: runArgs("tests/bit/pmvanity.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}", "BIT_WORKERS=2"]},
    Gate{name: "test-pmaddgit", argv: runArgs("tests/bit/pmaddgit.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    Gate{name: "test-examples", argv: runArgs("tests/bit/examplesgate.bit"),
      env: [std, "BIT_EXAMPLES_DIR=${repoRoot()}/examples"]},
    Gate{name: "test-docs", argv: runArgs("tests/bit/docs.bit"), env: [std]},
    // BIT_LIBBITRT IS REQUIRED, and was missing for a long time.
    // `importsrun.bit:254` reads it; without it the gate failed before running a
    // single project, and had done since the harness landed (856d694). The
    // driver sets it rather than reproducing that break, so an equivalence
    // diff must expect this one step to disagree.
    Gate{name: "test-imports-bit", argv: runArgs("tests/bit/importsrun.bit"),
      env: ["BIT_IMPORTS_BIT=${bitBin()}", "BIT_IMPORTS_DIR=${repoRoot()}/tests/imports",
        "BIT_LIBBITRT=${hostArchive()}", std]},
    Gate{name: "test-fuzz", argv: runArgs("tests/bit/fuzz.bit"),
      env: ["BIT_FUZZ_BIN=${bitBin()}", "BIT_FUZZ_CASES=${repoRoot()}/tests/cases",
        "BIT_FUZZ_CRASHES=${repoRoot()}/tests/fuzz/crashes",
        "BIT_FUZZ_SECONDS=5", "BIT_FUZZ_SEED=1", std], exclusive: true},
    Gate{name: "test-stress", argv: runArgs("tests/bit/stress.bit"), env: [std], exclusive: true},
  ]
}

function gateTableB(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    Gate{name: "test-pollfree", argv: runArgs("tests/bit/pollfree.bit"), env: [std]},
    Gate{name: "test-stwwiring", argv: runArgs("tests/bit/stwwiring.bit"), env: [std]},
    Gate{name: "test-rootabi", argv: runArgs("tests/bit/rootabi.bit"), env: [std]},
    Gate{name: "test-abimembers", argv: runArgs("tests/bit/abimembers.bit"), env: [std]},
    Gate{name: "test-rootpins", argv: runArgs("tests/bit/rootpins.bit"), env: [std]},
    Gate{name: "test-auxv", argv: runArgs("tests/bit/auxv.bit"), env: [std]},
    Gate{name: "test-schedbench", argv: runArgs("tests/bit/schedbench.bit"), env: [std]},
    Gate{name: "test-selfbin", argv: runArgs("tests/bit/selfbin.bit"), env: [std]},
    Gate{name: "test-golden", argv: runArgs("tests/bit/golden.bit"),
      env: [std, "BIT_CASES_DIR=${repoRoot()}/tests/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}"]},
    // Not `bit run` — these drive a subcommand of the compiler itself.
    Gate{name: "test-fmt", argv: ["fmt", "--check", "${repoRoot()}/stdlib", "${repoRoot()}/examples"],
      env: [std]},
    Gate{name: "test-selfcheck", argv: ["selfcheck"], env: [std]},
    Gate{name: "test-selfhostcheck", argv: ["check", "${repoRoot()}/compiler"], env: [std]},
    // #2416. BIT_REPO IS REQUIRED: the harness refuses rather than default to
    // "." and rebuild whatever directory it happened to be invoked from — see
    // the header of tests/bit/coldboot.bit. Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make test-coldboot`
    // does.
    Gate{name: "test-coldboot", argv: runArgs("tests/bit/coldboot.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #2419. BIT_REPO IS REQUIRED for the same reason as test-coldboot above:
    // the harness shells out to `./make selfhost` against the repo root and
    // must not silently default to ".". Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make
    // test-stdlib-rebuild` does.
    Gate{name: "test-stdlib-rebuild", argv: runArgs("tests/bit/stdlibrebuild.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
  ]
}

function findGate(name: string): (Gate, bool) {
  for g of gateTable() {
    if (g.name == name) {
      return g, true
    }
  }
  return Gate{name: "", argv: []string(0), env: []string(0)}, false
}

// A harness may run for minutes (`test-stress` is the corpus worst case), so
// the bound is generous. It exists at all because a hang is a failure, not a
// stall (#1637/#1652) — but each harness already carries its OWN per-child
// deadline, so this is only the outer backstop and must stay well above it.
function gateTimeoutMs(): int {
  let s = envOr("BIT_MAKE_GATE_TIMEOUT_S", "5400")
  return parseIntOr(s, 5400) * 1000
}

function parseIntOr(s: string, fallback: int): int {
  let n = 0
  let i = 0
  if (len(s) == 0) {
    return fallback
  }
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return fallback
    }
    n = n * 10 + (int(c) - 48)
    i = i + 1
  }
  return n
}

// THE INSTALL-ORDER HAZARD (#1229/#1644). Every gate reads `bit-out/bin/bit`
// and the host archive off disk, so both must be fully published before any of
// them starts. That is a per-RUN dependency edge — never on a shared parent,
// because a runner may then install and read concurrently, and
// a partially-written binary execs and SIGSEGVs with empty stderr.
//
// The driver runs steps sequentially in dependency order, so `selfhost` and
// `libbitrt` have already completed here. This is the assertion that they
// actually produced their outputs, which is the property the edge existed for.
function gatePrereqsReady(): bool {
  if (!exists(bitBin())) {
    eprint("make: missing ${bitBin()} — run `./make selfhost` first\n")
    return false
  }
  if (!exists(hostArchive())) {
    eprint("make: missing ${hostArchive()} — run `./make libbitrt` first\n")
    return false
  }
  return true
}

// The env-export preamble plus the final `exec` line, shared by the single-
// gate path below and the concurrent batch unit further down — one
// definition of "how a Gate becomes a shell command" so the two paths cannot
// drift apart.
function gateEnvExecScript(g: Gate): string {
  let script = ""
  for kv of g.env {
    let eq = indexOfByte(kv, '=')
    if (eq < 0) {
      continue
    }
    script = script + kv[:eq] + "=" + shQuote(kv[eq + 1:]) + "\nexport " + kv[:eq] + "\n"
  }
  // Passed through rather than set, so a slower host can widen every harness's
  // own internal deadline the documented way.
  let t = envOr("BIT_TEST_TIMEOUT_S", "")
  if (t != "") {
    script = script + "BIT_TEST_TIMEOUT_S=" + shQuote(t) + "\nexport BIT_TEST_TIMEOUT_S\n"
  }
  script = script + "exec " + shQuote(bitBin())
  for a of g.argv {
    script = script + " " + shQuote(a)
  }
  return script + "\n"
}

function runGate(name: string): int {
  let (g, ok) = findGate(name)
  if (!ok) {
    eprint("make: step '${name}' is not implemented yet\n")
    return 1
  }
  if (!gatePrereqsReady()) {
    return 1
  }
  let rc = runShell(name, "set -e\n" + gateEnvExecScript(g), gateTimeoutMs())
  return reportGate(name, rc)
}

// A child killed by a signal is a CRASH, and must not read as a plain non-zero
// exit — the distinction is what tells a segfault apart from a harness that
// simply failed its assertions (#1637).
//
// TWO ENCODINGS, because there are two children. `osRunBounded` runs a /bin/sh
// wrapper and reports ITS fate in the runtime's encoding (ABI.md §19): -1 spawn
// failure, -2 timeout, <= -100 signal death with signo = -rc - 100. The harness
// itself is the wrapper's child, so when IT is killed `sh` survives and exits
// 128+signo in the ordinary shell convention. Both are crashes; reporting only
// one of them would let the common case — a segfaulting harness under an `exec`
// that the shell reports numerically — read as a failed assertion.
function reportGate(name: string, rc: int): int {
  if (rc == 0 - 1) {
    eprint("make: ${name} could not be started (spawn/wait failed)\n")
    return 1
  }
  if (rc == 0 - 2) {
    eprint("make: ${name} TIMED OUT after ${gateTimeoutMs() / 1000}s — this is a hang, not a failed assertion\n")
    return 1
  }
  if (rc <= 0 - 100) {
    eprint("make: ${name} CRASHED — killed by signal ${0 - rc - 100}\n")
    return 1
  }
  if (rc > 128 && rc < 192) {
    eprint("make: ${name} CRASHED — killed by signal ${rc - 128}\n")
    return 1
  }
  if (rc != 0) {
    eprint("make: ${name} failed (exit ${rc})\n")
    return 1
  }
  return 0
}

// --- concurrent batch (#2434) ------------------------------------------------
//
// `main.bit`'s `runAll` hands a run of consecutive non-`exclusive` gate names
// here instead of calling `runGate` on each in turn. The parallelism lives
// entirely in the shell, not in Bit: `osRunBounded` (runtime/root/*/os.bit)
// polls with a raw, `@nosplit` `nanosleep` and never yields, so a spawned Bit
// green thread would never get scheduled until it returned — one gate at a
// time, exactly like today, just with extra machinery. See #2434's ticket for
// why `spawn` and a new runtime primitive were both ruled out.
//
// One composed script launches every gate in the chunk backgrounded with its
// own private killer, each redirected to its own file under `batchDir()`, and
// `wait`s for all of them. Reporting happens back here, from those files, in
// the same `order` position the caller passed them in — never through a pipe,
// and never while two gates could still be racing to write the same fd.

function isExclusiveGate(name: string): bool {
  let (g, ok) = findGate(name)
  return ok && g.exclusive
}

// Reused across every chunk in one `./make` run: redirection truncates each
// gate's own file at launch, and no two gates in a chunk share a name, so
// there is nothing to clean between chunks. Lives under the driver's existing
// scratch area (bit-out/make already holds the fp stamps and run-<name>.sh
// wrappers), not a fresh `mktemp -d` — that path would only be known inside
// the child shell, and the Bit code on this side of `runShell` is what has to
// read it back.
function batchDir(): string { return "bit-out/make/gatebatch" }

// No new runtime primitive (#2152's lesson applies here too): core count
// comes from the shell, the same round-trip `hostTriple()` already uses.
// `nproc` covers Linux; `sysctl -n hw.ncpu` is the Darwin fallback.
function numCPUs(): int {
  let outPath = "bit-out/make/ncpu"
  let script = "{ nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null; } > " + shQuote(outPath) + "\n"
  if (runShell("ncpu", script, buildTimeoutMs()) != 0) {
    return 1
  }
  let n = parseIntOr(trimNewline(readFile(outPath) catch ""), 0)
  if (n < 1) {
    return 1
  }
  return n
}

// Cores minus 2 (headroom for the OS and this driver itself), floor 1.
// BIT_MAKE_JOBS overrides directly; =1 is the escape hatch back to today's
// strict serial order and this ticket's own A/B control.
function makeJobs(): int {
  let s = envOr("BIT_MAKE_JOBS", "")
  if (s == "") {
    let n = numCPUs() - 2
    if (n < 1) {
      return 1
    }
    return n
  }
  let n = parseIntOr(s, 1)
  if (n < 1) {
    return 1
  }
  return n
}

// `gateTimeoutMs()` bounds one `osRunBounded` call today; in a batch that call
// wraps the WHOLE chunk, so it would silently bound every gate in it by the
// slowest one's budget shared across all of them. Each gate instead gets its
// own killer inside the script (macOS ships no `timeout(1)`, hence
// `sleep`+`kill -9`), and this outer bound becomes a backstop only: generous
// slack over the same per-gate budget, since the gates run concurrently, not
// stacked end to end.
function batchOuterTimeoutMs(): int { return gateTimeoutMs() + 60000 }

// One gate's slot inside the batch: backgrounded so N of these overlap, each
// with its own deadline. The `.timedout` marker is written by the killer
// BEFORE it sends `kill -9`, strictly before `wait "$GPID"` in the same slot
// can observe the death — so reading it back afterward can never race, and it
// is what lets a per-gate timeout still read as "TIMED OUT" instead of
// "CRASHED — killed by signal 9" (`runGateChunk` below).
function gateBatchUnit(g: Gate, dir: string, timeoutS: string): string {
  let outFile = shQuote(dir + "/" + g.name + ".out")
  let rcFile = shQuote(dir + "/" + g.name + ".rc")
  let toFile = shQuote(dir + "/" + g.name + ".timedout")
  return "(\n" +
    "(\n" + gateEnvExecScript(g) + ") > " + outFile + " 2>&1 &\n" +
    "GPID=$!\n" +
    "( sleep " + timeoutS + "; : > " + toFile + "; kill -9 \"$GPID\" 2>/dev/null ) &\n" +
    "KPID=$!\n" +
    "wait \"$GPID\"\n" +
    "RC=$?\n" +
    "kill \"$KPID\" 2>/dev/null\n" +
    "echo \"$RC\" > " + rcFile + "\n" +
    ") &\n"
}

// One `osRunBounded`, N backgrounded gates, one `wait` — the whole chunk.
function batchScript(chunk: []Gate, dir: string): string {
  let timeoutS = "${gateTimeoutMs() / 1000}"
  let script = ""
  for g of chunk {
    script = script + gateBatchUnit(g, dir, timeoutS)
  }
  return script + "wait\n"
}

// Runs one concurrent chunk (at most `makeJobs()` gates, none `exclusive`) and
// reports every one of them in `chunk` position, so output never interleaves
// and a run's `make: FAILED:` line is deterministic regardless of which gate
// actually finished first.
function runGateChunk(chunk: []Gate): []string {
  let failed = []string(0)
  if (len(chunk) == 0) {
    return failed
  }
  if (!gatePrereqsReady()) {
    for g of chunk {
      failed = append(failed, g.name)
    }
    return failed
  }
  let dir = batchDir()
  if (!ensureDir(dir)) {
    eprint("make: cannot create ${dir}\n")
    for g of chunk {
      failed = append(failed, g.name)
    }
    return failed
  }
  let outerRc = runShell("gatebatch", batchScript(chunk, dir), batchOuterTimeoutMs())
  for g of chunk {
    print("make: ${g.name}\n")
    let rcPath = "${dir}/${g.name}.rc"
    print(readFile("${dir}/${g.name}.out") catch "")
    if (!exists(rcPath)) {
      // The batch's own outer backstop fired before this gate's slot got to
      // write its rc — attribute the outer failure to it rather than going
      // silent on it.
      if (reportGate(g.name, outerRc) != 0) {
        failed = append(failed, g.name)
      }
      continue
    }
    let rc = parseIntOr(trimNewline(readFile(rcPath) catch ""), 0 - 1)
    if (exists("${dir}/${g.name}.timedout")) {
      rc = 0 - 2
    }
    if (reportGate(g.name, rc) != 0) {
      failed = append(failed, g.name)
    }
  }
  return failed
}

// Splits `names` (all gates, none `exclusive`) into consecutive chunks of at
// most `makeJobs()` and runs them one chunk after another. At `BIT_MAKE_JOBS=1`
// every chunk holds exactly one gate, which is today's serial order exactly —
// the A/B control #2434 asks for.
function runGateBatch(names: []string): []string {
  let failed = []string(0)
  if (len(names) == 0) {
    return failed
  }
  let jobs = makeJobs()
  let i = 0
  while (i < len(names)) {
    let end = i + jobs
    if (end > len(names)) {
      end = len(names)
    }
    let chunk = []Gate(0)
    let j = i
    while (j < end) {
      let (g, ok) = findGate(names[j])
      if (!ok) {
        eprint("make: step '${names[j]}' is not implemented yet\n")
        failed = append(failed, names[j])
      } else {
        chunk = append(chunk, g)
      }
      j = j + 1
    }
    for f of runGateChunk(chunk) {
      failed = append(failed, f)
    }
    i = end
  }
  return failed
}

// `./make fuzz [-- <seconds> [seed]]` — the open-ended run, as opposed to the
// `test-fuzz` gate's fixed 5s replay. The extra arguments are forwarded to
// `scripts/fuzz.sh` and only BIT_FUZZ_BIN is set, so the script stays the
// single definition of what fuzzing does.
function stepFuzz(extras: []string): int {
  if (!gatePrereqsReady()) {
    return 1
  }
  // `bash`, not `sh`: fuzz.sh is `#!/usr/bin/env bash` and uses `[[ ]]` and
  // `pipefail`. Same call shape scripts/g2archive.sh gets in artifacts.bit.
  let script = "set -e\nBIT_FUZZ_BIN=" + shQuote(bitBin()) + "\nexport BIT_FUZZ_BIN\n" +
    "exec bash " + shQuote("${repoRoot()}/scripts/fuzz.sh")
  for a of extras {
    script = script + " " + shQuote(a)
  }
  script = script + "\n"
  return reportGate("fuzz", runShell("fuzz", script, gateTimeoutMs()))
}

function indexOfByte(s: string, c: byte): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}
