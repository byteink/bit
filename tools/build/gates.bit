// The `test-*` gate TABLE for the Bit build driver (#1870, epic #1867).
// Recount with `grep -c '^    Gate{name: "test-' tools/build/gates.bit`
// rather than trust a number here — it goes stale on every gate added or
// removed (43 as of #2423). A bare `grep -c 'Gate{'` overcounts by one: the
// last `Gate{` in this file is `findGate`'s not-found sentinel (empty
// name), not a table entry.
//
// None of these contains test logic: every one launches a Bit program under
// `_tests_/bit/` (or drives a `bit` subcommand), and the whole job is handing it
// the right environment. A missing variable is not a crash, it is a SILENTLY
// DIFFERENT TEST — a harness that falls back to a default stdlib or a default
// binary still exits 0 and still reports a pass. So the table below is
// transcribed from the harnesses' actual requirements rather than inferred:
// a gate whose environment is wrong exits 0 and reports a pass anyway.
//
// Sorts after `artifacts.bit` (whose `runShell`/`shQuote`/`hostTriple` it uses)
// and before `gatesexec.bit` and `main.bit` (which call it), so the inliner
// sees each callee already lowered (#1511).
//
// Split from a single 953-line gates.bit by #3442 (spec/LINT.md:186's
// 800-line E0200 limit): the RUNNING machinery (single-gate path, the
// concurrent batch engine, `./make fuzz`) moved to `gatesexec.bit` — pure
// move, no symbol here changed. This file keeps the name `gates.bit` AND
// every `Gate{}` record deliberately: `scripts/gate.sh`'s `gates_for_file()`
// and `is_additive_registration()` grep `tools/build/gates.bit` BY NAME for
// exactly this table, so renaming or splitting it further would silently
// break that script's gate-scoping.

import { envOr, selfExe } from "std/os"
import { lastIndexOf } from "std/strings"
import { readDir } from "std/fs"

class Gate {
  name: string
  argv: []string
  env: []string
  // Asserts on wall-clock or memory rather than a fixed expected result, so a
  // co-scheduled neighbour changes the number it reports (#2400, #2401, #2210).
  // Defaults false; set true on any gate whose pass/fail depends on timing,
  // CPU, RSS or another load-sensitive measurement — never count them, that
  // count goes stale the moment a new one is added (#3869). `runAll`
  // (main.bit) keeps these out of the concurrent batch and runs them alone,
  // afterwards.
  exclusive: bool
}

// Absolute, because several harnesses generate a wrapper that `cd`s elsewhere
// before exec'ing; a relative path would resolve against the wrong directory.
// `./make` exports this. When unset, derive it from the DRIVER'S OWN resolved
// path rather than falling back to a relative "." — the driver always lives at
// `<root>/bit-out/make/make-driver`, so its directory's grandparent is the
// root (#3430). The old fallback resolved fine from the repo root, so every
// `exists()` check passed and the gate looked healthy; it broke only inside a
// harness that `cd`s elsewhere first, misread as 240 unrelated exit-127
// failures. An explicitly-set but non-absolute override is a misconfiguration,
// not a value to accept silently, so that case refuses instead of guessing.
fn repoRoot(): string {
  let override = envOr("BIT_MAKE_ROOT", "")
  if (len(override) > 0) {
    if (hasPrefix(override, "/")) {
      return override
    }
    eprint("gates: BIT_MAKE_ROOT=\"${override}\" is not absolute; run via './make <step>', which exports it correctly.\n")
    exit(1)
    return override
  }
  let exe = selfExe()
  if (len(exe) > 0) {
    return dirName(dirName(dirName(exe)))
  }
  eprint("gates: BIT_MAKE_ROOT is unset and this binary's own path could not be resolved; run via './make <step>'.\n")
  exit(1)
  return "."
}

// The directory containing `path`, or "." / "/" at the edges. A local
// reimplementation of compiler/mainpaths.bit's pathDir: tools/build/ and
// compiler/ are separate modules, so that one is not reachable here.
fn dirName(path: string): string {
  let cut = lastIndexOf(path, "/")
  if (cut < 0) {
    return "."
  }
  if (cut == 0) {
    return "/"
  }
  return path[0:cut]
}

fn bitBin(): string { return "${repoRoot()}/bit-out/bin/bit" }
fn stdlibRoot(): string { return "${repoRoot()}/stdlib" }

// The archive `bit` links against on THIS host.
//
// The golden gate's archive path must NOT be hardcoded to one triple. It once
// was — `bit-out/lib/aarch64-macos/libbitrt.a` — which is correct only on macOS
// and broke on the Linux hosts `scripts/x64gate.sh` and `scripts/arm64gate.sh`
// drive. Resolved here
// instead.
fn hostArchive(): string {
  return "${repoRoot()}/bit-out/lib/${hostTriple()}/libbitrt.a"
}

fn runArgs(src: string): []string {
  return ["run", "${repoRoot()}/${src}"]
}

// One entry per `test-*` step. Split across two functions only to stay under
// the repo's max-fn-lines; the two together are the whole set, and `gateTable`
// is what everything reads.
fn gateTable(): []Gate {
  let out = []Gate(0)
  for g of gateTableA() {
    out = append(out, g)
  }
  for g of gateTableB() {
    out = append(out, g)
  }
  for g of packageGates() {
    out = append(out, g)
  }
  return out
}

// The `pkg/<name>/` directory names that exist RIGHT NOW — filesystem-driven
// rather than a hand-maintained list, so `packageGates()` below (and
// `packageSteps()`, tools/build/defs.bit) reflect reality with no
// registration edit as a package is added or removed. Sorted (`readDir`'s
// own contract), so `--list` and every log stay reproducible. A missing or
// unreadable `pkg/` reports zero packages rather than failing the whole
// driver — `test-packages` itself is what asserts "0 packages" is only ever
// correct because `pkg/` is genuinely empty.
fn packageNames(): []string {
  let dir = "${repoRoot()}/pkg"
  let names = readDir(dir) catch []string(0)
  let out = []string(0)
  for name of names {
    if (len(name) > 0 && name[0] == '.') {
      continue
    }
    if (fsIsDir("${dir}/${name}")) {
      out = append(out, name)
    }
  }
  return out
}

// One Gate per package that exists, so a release of one package can be
// gated alone (`./make test-package-<name>`) without touching yesterday's
// packages — `BIT_PACKAGE_FILTER` is the only difference from the
// `test-packages` umbrella above, and _tests_/bit/packagesgate.bit is the only
// place that reads it.
fn packageGates(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  let out = []Gate(0)
  for p of packageNames() {
    out = append(out, Gate{name: "test-package-${p}", argv: runArgs("_tests_/bit/packagesgate.bit"),
      env: [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", "BIT_PACKAGE_FILTER=${p}"]})
  }
  return out
}

fn gateTableA(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    Gate{name: "test-osenv", argv: runArgs("_tests_/bit/osenv.bit"), env: [std]},
    Gate{name: "test-stdlib-docs", argv: runArgs("_tests_/bit/stdlibdocs.bit"),
      env: ["BIT_DOCS_ROOT=${repoRoot()}", std]},
    // #4212: no gate ran `bit test`, so every stdlib `*.test.bit` (SPEC
    // §19) was dead code. Direct subcommand argv, not runArgs() — `bit
    // test`'s own exit code already fails on any discovered assertion.
    Gate{name: "test-stdlib-unit", argv: ["test", "${repoRoot()}/stdlib"], env: [std]},
    Gate{name: "test-version-cli", argv: runArgs("_tests_/bit/version.bit"),
      env: ["BIT_REPO=${repoRoot()}"]},
    Gate{name: "test-lint", argv: runArgs("_tests_/bit/lintcmd.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2486, widened to pkg/ by #3806. Distinct from test-lint-filelines
    // below: that gate sweeps compiler/+runtime/+stdlib/ PLUS four test trees
    // (_tests_/stress/, examples/, _tests_/bit/, _tests_/imports/) and tolerates a
    // fixture corpus inside _tests_/bit/; this one sweeps PRODUCTION CODE ONLY
    // — runtime/, compiler/, stdlib/, tools/, pkg/ — at a hard-zero E0200
    // tolerance, with no test tree in scope at all (pkg/'s own inline
    // *.test.bit files ARE swept — see _tests_/bit/lintsweep.bit's header for
    // why). See that same header for why _tests_/ cannot safely be added to
    // this gate's invocation (#3543).
    Gate{name: "test-lint-sweep", argv: runArgs("_tests_/bit/lintsweep.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", "BIT_MAKE_ROOT=${repoRoot()}", std]},
    // #2515. BIT_REPO IS REQUIRED, same reason as test-coldboot below: the
    // harness points `bit lint` at `${BIT_REPO}/runtime` and must not
    // silently default to ".".
    Gate{name: "test-lint-runtime", argv: runArgs("_tests_/bit/lintruntime.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #2747. Distinct from test-lint-runtime above: that one gates E0211
    // (unused-local) over `runtime/` alone; this one gates E0200
    // (max-file-lines) over BOTH `compiler/` and `runtime/` — the file that
    // implements the 800-line limit had itself drifted 62 lines past its own
    // override with nothing to catch it. BIT_REPO IS REQUIRED, same reason as
    // its neighbour: the harness points `bit lint` at `${BIT_REPO}/compiler`
    // and `${BIT_REPO}/runtime` and must not silently default to ".".
    Gate{name: "test-lint-filelines", argv: runArgs("_tests_/bit/lintfilelines.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #2453, epic #2354. The count-ratchet gate: every OTHER rule code across
    // compiler/ and stdlib/ (not just E0211 or E0200 like its two neighbours
    // above) is compared against tools/build/lint-ceiling.txt, and E0214
    // (append-aliasing) is enforced at zero unconditionally, ceiling or not.
    // #3620 extended the ratchet to runtime/ too, via the ceiling file's
    // optional third `runtime <n>` line (E0211 excluded — test-lint-runtime
    // above already owns it at zero). BIT_REPO IS REQUIRED, same reason as
    // its neighbours: the harness reads ${BIT_REPO}/tools/build/lint-ceiling.txt
    // and points `bit lint` at ${BIT_REPO}/compiler, ${BIT_REPO}/stdlib and
    // ${BIT_REPO}/runtime, and must not silently default to ".".
    Gate{name: "test-lint-self", argv: runArgs("_tests_/bit/lintself.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #4008. E0204 (max-complexity) had no gate. Same production-only scope
    // as test-lint-sweep (#3543). A downward-only PER-FUNCTION ratchet
    // against tools/build/complexity-debt.txt (282 seeded, epic #4109), not
    // a hard zero. BIT_REPO IS REQUIRED, same reason as its neighbours.
    Gate{name: "test-lint-complexity", argv: runArgs("_tests_/bit/lintcomplexity.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    Gate{name: "test-runcmd", argv: runArgs("_tests_/bit/runcmd.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2958. E0096 (a root-module function whose bare link name collides
    // with a symbol the linked runtime resolves externally) is gated,
    // linking-only and target-derived, exactly like E0078's
    // rejectExternForTarget beside it in compiler/build.bit — `bit check`
    // never reaches it, so it cannot live under checkercases/ like a normal
    // rejection. See the harness header for why.
    Gate{name: "test-root-name-collision", argv: runArgs("_tests_/bit/rootnamecollision.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #3734. `collectDoc` (compiler/doc.bit) must not list an imported free
    // function as this module's own export merely because its bare name
    // collides with a locally exported method — see the harness header for
    // the stdlib/regex case that found it and the minimal repro used here.
    Gate{name: "test-doc-import-collision", argv: runArgs("_tests_/bit/docimportcollision.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}"]},
    // #2864/#3071. Pins E0078's exact rendered wording (compiler/build.bit's
    // rejectExternForTarget) — see the harness header for why it cannot live
    // in _tests_/cases/ or checkercases/ like a normal rejection.
    Gate{name: "test-extern-unresolvable", argv: runArgs("_tests_/bit/externunresolvable.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2107. The layer ABOVE every subcommand: an unrecognised flag must be
    // refused, not consumed as an operand. Lives here rather than in _tests_/cases
    // because the whole property is argv in / exit code + stderr out, which a
    // golden (single file, stdout only) cannot express.
    Gate{name: "test-clicmd", argv: runArgs("_tests_/bit/clicmd"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2261. Lives here rather than in _tests_/cases because it asserts a
    // REJECTION the pinned stage0 oracle does not make, and a golden would put
    // that deliberate divergence inside selfhost-diffcheck.sh's sweep as a
    // FALSEPOS. See the header of _tests_/bit/constoverflow.bit.
    Gate{name: "test-const-overflow", argv: runArgs("_tests_/bit/constoverflow.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2129. Needs TWO sibling files in one module and it needs STDERR, so it
    // fits neither _tests_/cases (single file) nor _tests_/imports (compares stdout
    // and fails a case whose build fails). See the header of the harness.
    Gate{name: "test-dupdecl-note", argv: runArgs("_tests_/bit/dupdeclnote.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2385. Same reason as test-const-overflow above: it asserts a REFUSAL the
    // pinned stage0 oracle does not make — the oracle BUILDS all three of its
    // rejection cases, two into a segfault and one into a plausible wrong answer
    // — so a golden would put that deliberate divergence inside
    // selfhost-diffcheck.sh's sweep as a FALSEPOS. See the header of
    // _tests_/bit/lowerrefuse.bit.
    Gate{name: "test-lower-refuse", argv: runArgs("_tests_/bit/lowerrefuse.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2235. SPEC §17.4's `main(): ()!` row: the error prints to stderr and the
    // process exits 1. Lives here rather than in _tests_/cases because a golden
    // cannot express exit 1 plus stderr — `// panic` pins the exit to exactly 2 —
    // and because the fix deliberately changes the IR of every fallible `main`
    // (ABI.md §10), which the pinned oracle predates. See the harness header.
    Gate{name: "test-main-exit", argv: runArgs("_tests_/bit/mainexit.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2360, #2243, #2148. Same reason as test-const-overflow above: all three
    // assert REJECTIONS the pinned stage0 oracle does not make, and a golden
    // would put that deliberate divergence inside selfhost-diffcheck.sh's
    // sweep as a FALSEPOS. See the header of _tests_/bit/genericdiag.bit.
    Gate{name: "test-generic-diag", argv: runArgs("_tests_/bit/genericdiag.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2232/#2123, #2230, #2237, and #2377 which moved them here. Same reason as
    // test-const-overflow above, with one extra turn of the screw: these four
    // fixes are NEWER than the pinned oracle's release, so no repin can clear
    // them. Unlike its two neighbours this gate compares the FULL rendered
    // diagnostic against a `.expected` — the cases arrived from _tests_/cases with
    // one, and BIT_CHECKER_CASES_DIR is where they now live. See the header of
    // _tests_/bit/checkerdiag.bit.
    Gate{name: "test-checker-diag", argv: runArgs("_tests_/bit/checkerdiag.bit"),
      env: [std, "BIT_CHECKER_CASES_DIR=${repoRoot()}/_tests_/bit/checkercases",
        "BIT_BIN=${bitBin()}"]},
    // #2344, and the front-end behaviour cases after it. Related to
    // test-checker-diag but NOT the same reason: these cases are ACCEPTED by
    // both compilers and PARSED differently, which reddens
    // selfhost-diffast.sh/diffir/difftypes rather than diffcheck. They are built
    // and RUN, because #2344's bug was a clean `bit check` followed by a SIGSEGV
    // from the binary. See the header of _tests_/bit/parsergate.bit.
    Gate{name: "test-parser", argv: runArgs("_tests_/bit/parsergate.bit"),
      env: [std, "BIT_PARSER_CASES_DIR=${repoRoot()}/_tests_/bit/parsercases",
        "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"]},
    Gate{name: "test-fsblock", argv: runArgs("_tests_/bit/fsblock.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    Gate{name: "test-lsp-lifecycle", argv: runArgs("_tests_/bit/lsplifecycle.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-resolve", argv: runArgs("_tests_/bit/lspresolve.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #2326/#2348. Measures ALLOCATION, not RSS, and compares two arms of one
    // run against each other rather than an absolute count — see the header of
    // _tests_/bit/lspcache.bit for why either alternative cannot work here.
    Gate{name: "test-lsp-cache", argv: runArgs("_tests_/bit/lspcache.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-references", argv: runArgs("_tests_/bit/lspreferences.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-formatting", argv: runArgs("_tests_/bit/lspformatting.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-signaturehelp", argv: runArgs("_tests_/bit/lspsignaturehelp.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #3559: `checkResolved` runs even when the buffer already has a parse
    // error elsewhere, so a query on a well-formed declaration answers real
    // type info instead of null, and the server does not crash on a
    // severely malformed tree.
    Gate{name: "test-lsp-errortolerant", argv: runArgs("_tests_/bit/lsperrortolerant.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #4157: a directory of independent single-file programs (_tests_/bit/
    // itself, among others) must not be built as one module. BIT_REPO locates
    // the real _tests_/bit/allocslope.bit this gate opens read-only.
    Gate{name: "test-lsp-moduledir", argv: runArgs("_tests_/bit/lspmoduledir.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"], exclusive: true},
    // #4176: a NOTE must never publish the fabricated "E0000" code, and must
    // be carried as relatedInformation on its parent, not a second diagnostic.
    Gate{name: "test-lsp-diagnostics", argv: runArgs("_tests_/bit/lspdiagnostics.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-pathresolve", argv: runArgs("_tests_/bit/pathresolve.bit"), env: [std]},
    Gate{name: "test-pmimports", argv: runArgs("_tests_/bit/pmimports.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    // BIT_WORKERS=2 IS REQUIRED. The harness spawns a green thread to serve
    // one local HTTP request while the main thread blocks inside
    // `osRunBounded` waiting on the `bit add` child it drives — with this
    // runtime's default of exactly one scheduler worker OS thread (ABI.md
    // §9), that spawned thread never runs until the blocking call returns,
    // so the vanity-document fetch always times out. Reproduced directly: a
    // second worker is what turns the accept from "never" into "immediate".
    Gate{name: "test-pmvanity", argv: runArgs("_tests_/bit/pmvanity.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}", "BIT_WORKERS=2"]},
    Gate{name: "test-pmaddgit", argv: runArgs("_tests_/bit/pmaddgit.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    Gate{name: "test-pmrangegate", argv: runArgs("_tests_/bit/pmrangegate"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    Gate{name: "test-examples", argv: runArgs("_tests_/bit/examplesgate.bit"),
      env: [std, "BIT_EXAMPLES_DIR=${repoRoot()}/examples"]},
    Gate{name: "test-docs", argv: runArgs("_tests_/bit/docs.bit"), env: [std]},
    // #2808. `editors/vscode/sample.bit` is the syntax-highlighting sample
    // shipped INSIDE the published VS Code extension, and nothing in the tree
    // ever looked at it: it carried three independent defects in turn
    // (#2789 the retired `function` keyword, #2799 a stale prelude-era import,
    // #2805 a free-function `fs.readAll` that never existed) before anyone
    // noticed. Must be `run`, not `check` — #2805's class of error (an
    // undefined member reached through a wildcard-namespace import) type-checks
    // clean and fails only at lowering (#2804), so a check-only gate would
    // have stayed green while the shipped sample was broken.
    Gate{name: "test-editor-sample", argv: runArgs("editors/vscode/sample.bit"), env: [std]},
    // BIT_LIBBITRT IS REQUIRED, and was missing for a long time.
    // `importsrun/importsrun.bit:314` reads it; without it the gate failed
    // before running a single project, and had done since the harness landed
    // (856d694). The driver sets it rather than reproducing that break, so an
    // equivalence diff must expect this one step to disagree. #3593 split the
    // harness into `_tests_/bit/importsrun/` (a directory module, over the
    // 800-line ceiling as one file) — `runArgs` below now names the
    // directory, not a single `.bit` file.
    Gate{name: "test-imports-bit", argv: runArgs("_tests_/bit/importsrun"),
      env: ["BIT_IMPORTS_BIT=${bitBin()}", "BIT_IMPORTS_DIR=${repoRoot()}/_tests_/imports",
        "BIT_LIBBITRT=${hostArchive()}", std]},
    Gate{name: "test-fuzz", argv: runArgs("_tests_/bit/fuzz.bit"),
      env: ["BIT_FUZZ_BIN=${bitBin()}", "BIT_FUZZ_CASES=${repoRoot()}/_tests_/cases",
        "BIT_FUZZ_CRASHES=${repoRoot()}/_tests_/fuzz/crashes",
        "BIT_FUZZ_SECONDS=5", "BIT_FUZZ_SEED=1", std], exclusive: true},
    // #2038, epic #2025. Same shape as `test-fuzz` above. Not in
    // `gateNames()` (tools/build/defs.bit), so `test` never runs it; `./make
    // test-fuzz-regex` does.
    Gate{name: "test-fuzz-regex", argv: runArgs("_tests_/bit/regexfuzz.bit"),
      env: ["BIT_REGEXFUZZ_BIN=${bitBin()}", "BIT_REGEXFUZZ_CASE=${repoRoot()}/_tests_/bit/regexfuzzcase.bit",
        "BIT_REGEXFUZZ_CASES=${repoRoot()}/_tests_/fuzz/regexcases",
        "BIT_REGEXFUZZ_CRASHES=${repoRoot()}/_tests_/fuzz/regexcrashes",
        "BIT_REGEXFUZZ_SECONDS=5", "BIT_REGEXFUZZ_SEED=1", std], exclusive: true},
    // #2055, epic #2025. A pure-Bit in-process benchmark — no subprocess,
    // so it needs only BIT_STDLIB, same minimal env as test-atomicwidth
    // below. Not in `gateNames()` (tools/build/defs.bit), so `test` never
    // runs it; `./make bench-regex` does. Never fails: see
    // _tests_/bit/benchregex/benchregex.bit's own header.
    Gate{name: "bench-regex", argv: runArgs("_tests_/bit/benchregex"), env: [std]},
    // #2609 (epic #1907). Three standalone tools/fuzz/*.bit drivers
    // (#2606/#2607/#2608) that were previously reachable only by hand.
    // Seed and count pinned so a failing run is reproducible: `--seed 1` for
    // all three, `--count 100` for selfcheck/odiff, `--count 20` for
    // xtarget (cross-arch, needs hl-master over ssh — SKIPs, does not fail,
    // when that host is unreachable, per tools/fuzz/xtarget.bit's own
    // contract). `BIT` is the env var these drivers read for the compiler
    // path (`envOr("BIT", "./bit-out/bin/bit")`); set explicitly since the
    // driver's own cwd is not guaranteed to be repoRoot().
    Gate{name: "test-fuzz-selfcheck",
      argv: ["run", "${repoRoot()}/tools/fuzz/selfcheck.bit", "--", "--seed", "1", "--count", "100"],
      env: ["BIT=${bitBin()}", std]},
    Gate{name: "test-fuzz-odiff",
      argv: ["run", "${repoRoot()}/tools/fuzz/odiff.bit", "--", "--seed", "1", "--count", "100"],
      env: ["BIT=${bitBin()}", std]},
    Gate{name: "test-fuzz-xtarget",
      argv: ["run", "${repoRoot()}/tools/fuzz/xtarget.bit", "--", "--seed", "1", "--count", "20"],
      env: ["BIT=${bitBin()}", std]},
    // #2564. Split from the single `test-stress` gate: `BIT_STRESSGATE_PARTITION`
    // (_tests_/bit/stress/) selects the two of the four exclusiveNames() names
    // eligible on this host — those stay `exclusive`, the same reason the whole
    // gate used to be — from the 61 that assert only on correctness and can run
    // alongside any other gate. `test-stress` itself
    // (below, in `gateTableB`) stays unpartitioned for standalone use; these two
    // are what `test`'s dependency list actually runs (`gateNames()`,
    // tools/build/defs.bit).
    Gate{name: "test-stress-exclusive", argv: runArgs("_tests_/bit/stress"),
      env: [std, "BIT_STRESSGATE_PARTITION=exclusive"], exclusive: true},
    Gate{name: "test-stress-batch", argv: runArgs("_tests_/bit/stress"),
      env: [std, "BIT_STRESSGATE_PARTITION=batch"]},
  ]
}

fn gateTableB(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    Gate{name: "test-pollfree", argv: runArgs("_tests_/bit/pollfree"), env: [std]},
    Gate{name: "test-stwwiring", argv: runArgs("_tests_/bit/stwwiring"), env: [std]},
    Gate{name: "test-rootabi", argv: runArgs("_tests_/bit/rootabi"), env: [std]},
    Gate{name: "test-abimembers", argv: runArgs("_tests_/bit/abimembers"), env: [std]},
    Gate{name: "test-rootpins", argv: runArgs("_tests_/bit/rootpins"), env: [std]},
    Gate{name: "test-auxv", argv: runArgs("_tests_/bit/auxv.bit"), env: [std]},
    Gate{name: "test-schedbench", argv: runArgs("_tests_/bit/schedbench.bit"), env: [std]},
    // #2613/#3603. Proves `main`'s dedicated 8 MiB stack end to end: recurse
    // 100000 frames deep, then a channel op at the deepest frame so the path
    // actually exercises `schedCurrentTask()` identity resolution at depth.
    // A broken big-stack identity resolves to task 0, which the runtime
    // treats as fatal (exit 70) rather than panicking cleanly — see the
    // harness header for why the exit code IS the assertion.
    Gate{name: "test-sched-main-stack", argv: runArgs("_tests_/bit/schedmainstack.bit"), env: [std]},
    // #2614 (epic #1844), sibling of #2613/#3603's test-sched-main-stack:
    // proves the masked-identity path every non-main task uses
    // (schedTaskOnStack(sp & ~(schedStackBytes - 1))) still resolves
    // correctly at depth on its 256 KiB stack — see the harness header for
    // why the exit code IS the assertion.
    Gate{name: "test-sched-spawn-stack", argv: runArgs("_tests_/bit/schedspawnstack.bit"), env: [std]},
    Gate{name: "test-selfbin", argv: runArgs("_tests_/bit/selfbin.bit"), env: [std]},
    Gate{name: "test-golden", argv: runArgs("_tests_/bit/golden"),
      env: [std, "BIT_CASES_DIR=${repoRoot()}/_tests_/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}"]},
    // #3427 (epic #3424, final phase): the retired-keyword rejection gate,
    // driven against the compiler CLI directly rather than through
    // _tests_/cases/ — see the harness header for why that corpus is unsuited
    // to a fixture that is EXPECTED to fail compilation.
    Gate{name: "test-classkeyword", argv: runArgs("_tests_/bit/classkeyword.bit"),
      env: [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"]},
    // #4098: walks the four type-node-callee forms (chan<T>(...), []T(...),
    // map<K,V>(...), [N]T(...)) and asserts each rejects an invalid argument
    // — see the harness header for why a regression in any one validator
    // (compiler/validatezero.bit) reddens this rather than silently shipping.
    Gate{name: "test-typenodecallee", argv: runArgs("_tests_/bit/typenodecallee.bit"),
      env: [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"]},
    // #3443: a `defer` with arguments (or a receiver) inside a bare,
    // unconditional block panicked `index out of range` — see the harness
    // header for why the fixture is driven against the CLI directly rather
    // than through _tests_/cases/ (the pinned stage0 oracle panics on it too).
    Gate{name: "test-deferblock", argv: runArgs("_tests_/bit/deferblock.bit"),
      env: [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"]},
    // #2840 (epic #2270): pins both directions of #2839's `testpanic_`
    // support — see the harness header for why a main-less fixture cannot
    // go through _tests_/cases/ (golden.bit's checkRun requires `bit build`
    // to produce a runnable binary). BIT_REPO locates the harness's own
    // sidecar _tests_/bit/testpanic.expected.
    Gate{name: "test-testpanic", argv: runArgs("_tests_/bit/testpanic.bit"),
      env: [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}", "BIT_REPO=${repoRoot()}"]},
    // #2252: `bit test` must name the CALLER's file:line for a failed
    // std/testing assertion (a helper, a loop, and a direct in-body
    // failure) — see the harness header for why a main-less, `bit
    // test`-driven fixture cannot go through _tests_/cases/, same reasoning
    // as test-testpanic above. BIT_REPO locates the harness's own sidecar
    // _tests_/bit/testloc.expected.
    Gate{name: "test-testloc", argv: runArgs("_tests_/bit/testloc.bit"),
      env: [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}", "BIT_REPO=${repoRoot()}"]},
    // #2931. Peak-RSS/user-CPU regression gate over bench/cases/{collatz,
    // mandelbrot,fib,alloc} — see the header of
    // _tests_/bit/benchgate/benchgate.bit for why those two metrics and not
    // wall clock (#2401/#2415/#2422 are open on exactly that failure mode).
    // BIT_BENCH_DIR points it at bench/cases rather than letting it default
    // and silently walk the wrong directory, matching BIT_CASES_DIR above.
    // #3023 split this into a directory module
    // (_tests_/bit/benchgate/{benchgate,baselines}.bit); the case arm this
    // registration needs is scripts/gate.sh's gates_for_file().
    // #3869: asserts on user CPU and peak RSS, so a co-scheduled neighbour
    // changes what it reports — `exclusive: true` keeps it out of the
    // concurrent batch, same reason as every other wall-clock/RSS gate below.
    Gate{name: "test-benchgate", argv: runArgs("_tests_/bit/benchgate"),
      env: [std, "BIT_BENCH_DIR=${repoRoot()}/bench/cases", "BIT_BIN=${bitBin()}",
        "BIT_LIBBITRT=${hostArchive()}"], exclusive: true},
    // Not `bit run` — these drive a subcommand of the compiler itself.
    // #3699/#3700/#3701 added pkg/, bench/ and editors/ alongside stdlib/ and
    // examples/: all three were measured 100%/100%/100% clean once #3700 and
    // #3701 reformatted bench/'s 4 and editors/vscode/sample.bit's 1 dirty
    // file (pure reformatting, verified by identical before/after run
    // output), so each is a hard zero like the original two rather than a
    // ratchet.
    // #3713 reformatted the whole tree once, so _tests_/imports/ (#3693,
    // previously its own ceiling gate) folds in here at a hard zero: no
    // unparseable fixtures, no post-reformat E0200 debt.
    Gate{name: "test-fmt", argv: ["fmt", "--check", "${repoRoot()}/stdlib", "${repoRoot()}/examples",
        "${repoRoot()}/pkg", "${repoRoot()}/bench", "${repoRoot()}/editors",
        "${repoRoot()}/_tests_/imports"],
      env: [std]},
    // #3713 replaced five ceiling-ratchet gates (formerly
    // _tests_/bit/fmtceilingcheck.bit, tools/build/fmt-ceiling*.txt) with
    // four zero-tolerance gates on the shared driver
    // _tests_/bit/fmtzerocheck.bit — see its header for the contract. A
    // ceiling survives debt it cannot yet fix; the tree is now reformatted
    // once, so each demands zero except a short, NAMED, ticket-linked debt
    // list (fmtStrictDebt() etc. above) that can only shrink.
    //
    // compiler/+runtime/+tools/ (originally #3670): 50 files #3713's
    // reformat would push over a Power-of-10-style ceiling — 24 over the
    // 800-line E0200 file limit (#4099), 26 over the 80-line E0201
    // function limit (#4103, found via test-lint-self's SEPARATE ratchet,
    // tools/build/lint-ceiling.txt, going 482 -> 512 findings on a pure
    // reformat with no ceiling raised to compensate).
    Gate{name: "test-fmt-strict", argv: runArgs("_tests_/bit/fmtzerocheck.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-strict",
        "BIT_FMTZERO_TREES=compiler:compiler runtime:runtime tools:tools",
        fmtStrictDebt()]},
    // _tests_/stress/ (originally #3702): 2 files, same E0200 shape — #4099.
    Gate{name: "test-fmt-stress", argv: runArgs("_tests_/bit/fmtzerocheck.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-stress",
        "BIT_FMTZERO_TREES=stress:_tests_/stress",
        fmtStressDebt()]},
    // _tests_/bit/ (originally #3711): carries deliberately-malformed
    // fixtures bit fmt refuses outright (BIT_FMTZERO_TOLERATE_DIAG=1, same
    // exit-code classification the ceiling gate used), plus 20 debt files:
    // 5 E0200 (#4099) and 15 in checkercases/ whose paired .expected asserts
    // a line:col that reformatting moved — never touched by #3713, #4101.
    Gate{name: "test-fmt-testsbit", argv: runArgs("_tests_/bit/fmtzerocheck.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-testsbit",
        "BIT_FMTZERO_TREES=testsbit:_tests_/bit",
        "BIT_FMTZERO_TOLERATE_DIAG=1",
        fmtTestsbitDebt()]},
    // _tests_/cases/ (originally #3703): same malformed-fixture shape, plus
    // 15 files of the same moved-diagnostic debt as checkercases above —
    // #4101. Not in #3713's must-be-zero tree list (it flagged this tree as
    // the one most likely to carry unavoidable debt, correctly), but a
    // zero-except-debt gate beats no gate at all.
    Gate{name: "test-fmt-cases", argv: runArgs("_tests_/bit/fmtzerocheck.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_FMTZERO_LABEL=fmt-cases",
        "BIT_FMTZERO_TREES=cases:_tests_/cases",
        "BIT_FMTZERO_TOLERATE_DIAG=1",
        fmtCasesDebt()]},
    // #3724: no gate checked that `bit fmt` PRESERVES program meaning — see
    // the harness header (_tests_/bit/fmtroundtrip.bit) for the full design.
    // Measured on this branch: 69s over 1596 `.bit` files (MATCH=1558
    // MISMATCH=0 SKIP=38), cheaper than test-lint-filelines — in gateSteps()
    // (below), not coreSteps(), on that basis: it is correctness coverage no
    // other gate provides, at a cost `./make test` already tolerates for
    // similarly-priced gates.
    Gate{name: "test-fmt-roundtrip", argv: runArgs("_tests_/bit/fmtroundtrip.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    Gate{name: "test-selfcheck", argv: ["selfcheck"], env: [std]},
    Gate{name: "test-selfhostcheck", argv: ["check", "${repoRoot()}/compiler"], env: [std]},
    // #2416. BIT_REPO IS REQUIRED: the harness refuses rather than default to
    // "." and rebuild whatever directory it happened to be invoked from — see
    // the header of _tests_/bit/coldboot.bit. Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make test-coldboot`
    // does.
    Gate{name: "test-coldboot", argv: runArgs("_tests_/bit/coldboot.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #2419. BIT_REPO IS REQUIRED for the same reason as test-coldboot above:
    // the harness shells out to `./make selfhost` against the repo root and
    // must not silently default to ".". Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make
    // test-stdlib-rebuild` does.
    Gate{name: "test-stdlib-rebuild", argv: runArgs("_tests_/bit/stdlibrebuild.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #2564. The FULL, unpartitioned corpus (no `BIT_STRESSGATE_PARTITION`) —
    // for `scripts/gate.sh`'s `runtime` bucket and manual/debugging use, where
    // the whole point is every program in one run. Not in `gateNames()`, same
    // reason and same shape as `test-coldboot`/`test-stdlib-rebuild` above: `test`
    // runs the two split gates in `gateTableA` instead; `./make test-stress` does
    // this one.
    //
    // exclusive: true, DELIBERATELY, even though it is unreachable from `test`
    // (not in `gateNames()`, so `runAll`'s batching never sees it there). This
    // gate still runs the FULL corpus, including `parkdarwin`/`parklinux` — a 3x
    // discriminator margin, the tightest in the corpus. `scripts/gate.sh`'s
    // `runtime` bucket invokes this exact name (line 402) alongside five other
    // gates, and `main.bit`'s `runAll` decides concurrency from THIS flag, not
    // from `gateNames()` membership — so dropping it here would let that bucket
    // co-schedule the tightest-margin discriminators in this corpus with five
    // other gates, exactly the false-red risk this whole ticket exists to close.
    Gate{name: "test-stress", argv: runArgs("_tests_/bit/stress"), env: [std], exclusive: true},
    // #2538, epic #1253. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness reads _tests_/stress/parallel/*.bit
    // straight off disk and must not silently default to ".". Not in
    // `gateNames()` (tools/build/defs.bit), so `test` never runs it; `./make
    // test-stress-parallel-programs` does. `exclusive: false` — see the
    // harness's own header for why co-scheduling cannot corrupt its verdict.
    Gate{name: "test-stress-parallel-programs", argv: runArgs("_tests_/bit/stressparallel.bit"),
      env: [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}", "BIT_REPO=${repoRoot()}"]},
    // #2570. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness shells out to
    // `bash scripts/selfhost-diffall.sh` against the repo root and must not
    // silently default to ".". Not in `gateNames()` (tools/build/defs.bit),
    // so `test` never runs it; `./make test-differentials` does.
    Gate{name: "test-differentials", argv: runArgs("_tests_/bit/selfhostdiff.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #3118. BIT_REPO IS REQUIRED, same reason as test-coldboot/
    // test-stdlib-rebuild above: the harness shells out to `./make libbitrt`
    // and `sh scripts/stage0.sh` against the repo root and must not silently
    // default to ".". Not in `gateNames()` (tools/build/defs.bit), so `test`
    // never runs it; `./make test-stage0override` does.
    Gate{name: "test-stage0override", argv: runArgs("_tests_/bit/stage0override.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #3341, epic #3322. BIT_REPO IS REQUIRED, same reason as test-coldboot
    // above: the harness shells out to `scripts/g2archive.sh` and `bit
    // build` against the repo root and must not silently default to ".".
    // BIT_WINDOWS_HOST overridable (default mustafa-desktop-win) so the
    // gate's own unreachable-host path is testable without a real outage.
    // Not in `gateNames()` (tools/build/defs.bit), so `test` never runs it;
    // `./make test-windows-smoke` does.
    Gate{name: "test-windows-smoke", argv: runArgs("_tests_/bit/windowssmoke.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #3271, epic: first-party packages (`pkg/<name>/`). The whole package
    // family in one run — see tools/build/defs.bit's `test-packages` Step{}
    // comment for the asymmetry this whole design rests on
    // (bitlang-ws/CLAUDE.md, "First-party packages"). Not in `gateNames()`
    // (tools/build/defs.bit), so `test` never runs it; `./make test-packages`
    // does, and scripts/gate.sh's `pkg`/`selfhost`/`runtime`/`stdlib`/`full`
    // buckets add it explicitly — the one entry in that script whose
    // inclusion is NOT argv/env-path intersection, because a package can
    // never break the language but the language can break a package.
    Gate{name: "test-packages", argv: runArgs("_tests_/bit/packagesgate.bit"),
      env: [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}"]},
    // #2742. Reads the emitted access back out through the memory an
    // oversized atomic width would have clobbered, rather than disassembling
    // (portable across all three targets without a host `objdump`); the
    // compile-time assert in compiler/lowerprim.bit is the primary defense —
    // this is the independent execution-level check.
    Gate{name: "test-atomicwidth", argv: runArgs("_tests_/bit/atomicwidth.bit"),
      env: [std]},
    // #2758. `BIT_REPO` so the harness resolves spec/SPEC.md against the
    // tree under test rather than searching relative to its own cwd.
    // Directory, not a single file, since #2973 split it into
    // `_tests_/bit/spec/{spec,specgrammar}.bit` — a bare `.bit` path loads only
    // that one file (compiler/build.bit's `moduleRootProblem`/`buildIr`), so
    // this must name the directory for both siblings to load as one module.
    Gate{name: "test-spec", argv: runArgs("_tests_/bit/spec"),
      env: ["BIT_REPO=${repoRoot()}"]},
    // #3072. `BIT_REPO` so the harness resolves spec/FMT.md and the cited
    // compiler/fmt*.bit files against the tree under test, same reason as
    // test-spec above.
    Gate{name: "test-fmt-citations", argv: runArgs("_tests_/bit/fmtcitations"),
      env: ["BIT_REPO=${repoRoot()}"]},
    // #2793. Independent of `bit lint`/E0200 by design (see the harness
    // header) — fails if any _tests_/bit/*.bit file is over the 800-line
    // limit, or if a grandfathered one (its allowlist emptied by #2867 phase
    // 2's splits, but the mechanism stays live for the next offender) grows
    // past its recorded count. `BIT_REPO` so the harness resolves _tests_/bit/
    // against the tree under test rather than searching relative to its own
    // cwd.
    Gate{name: "test-filesize", argv: runArgs("_tests_/bit/filesize.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #2920. No env override: the whole point is the UNSET path, the one
    // `boot.bit`'s local copy of the min-trigger default silently regressed.
    Gate{name: "test-gc-defaults", argv: runArgs("_tests_/bit/gcdefaults.bit"), env: [std]},
    // #3623. Non-ASCII UTF-8 decoding must not allocate more objects than
    // ASCII decoding does. #2448's E0204 splits returned `class` values as
    // multiple-return vehicles, and a class is a heap object, so a pure-looking
    // refactor took every multi-byte decode from 1 object to 3 with no gate
    // able to see it — nothing in bench/cases/ decodes a non-ASCII rune. No
    // `exclusive`: the counter is swept+live, exactly deterministic and not
    // load-sensitive, unlike the wall-clock and RSS gates.
    Gate{name: "test-rune-alloc", argv: runArgs("_tests_/bit/runealloc.bit"), env: [std]},
    // #2546 (epic #1660). Builds an allocation-heavy fixture and execs it
    // under `BIT_GC=stress`, asserting `abandoned=0` alongside a printed,
    // asserted `collections > 0` — the darwin boot thread's step-7 park loop
    // (#2543) must stay bracketed. `BIT_SELF_EXE` locates the compiler under
    // test; `exclusive: true` because `abandoned` counts a rendezvous that
    // gave up under CPU contention, so a co-scheduled neighbour can
    // manufacture one that has nothing to do with this bracket — see the
    // harness header.
    Gate{name: "test-gc-boot-safepoint", argv: runArgs("_tests_/bit/gcbootsafepoint.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #2925/#3241 pinned runtime/gc + runtime/alloc consts against
    // compiler/codegen.bit's own pg*Word() literals here. RETIRED BY #4203:
    // the backends no longer mirror any runtime word offset -- they fetch one
    // address and read the word at offset 0 -- so there is nothing left for
    // that gate to compare. The behavioural gates below are what survive, and
    // they are the ones that actually run a compiled program.
    // #3434. The same coupling test-pollguardoffsets used to guard, one level
    // down and still live after #4203 retired that gate: both backends
    // emit bit_rt_port_gc_thread_token's instructions at the call site instead
    // of calling it, so the same machine code exists in the compiler and in
    // runtime/gc/{linux,darwin,windows}/gcthread.bit with no way to import one
    // from the other. Drift there is silent -- it builds, it links, no golden
    // output moves, and compiled code just disagrees with the runtime about
    // which thread is asking (#1650). BIT_REPO IS REQUIRED, same reason as
    // test-lint-runtime: the harness reads ${BIT_REPO}/compiler/*.bit and
    // ${BIT_REPO}/runtime/gc/**, and must not silently default to ".".
    Gate{name: "test-threadtokenbytes", argv: runArgs("_tests_/bit/threadtokenbytes.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #3242. `BIT_WORKERS=4` IS REQUIRED, not stylistic: this gate spawns an
    // allocation-free mutator and controls it from a second, concurrently
    // running task, and boot's scheduler default of one OS worker thread
    // leaves the two unable to run concurrently at all (see the harness's
    // own header). Behaviourally exercises the worldStopWord clause of the
    // back-edge poll guard no encoding-level check can prove: #4203 made the
    // compiled fast path a single word read, so only running a program shows
    // the runtime actually publishes into that word.
    Gate{name: "test-pollguardstopword", argv: runArgs("_tests_/bit/pollguardstopword.bit"),
      env: [std, "BIT_WORKERS=4"]},
    // #3564. Same shape and same reason as test-pollguardstopword above:
    // spawns an allocation-free mutator and, from a second concurrently
    // running task, drives a real preempt request through preemptStamp/
    // sysmonTick, asserting the COMPILED inline poll's preempt clause
    // actually observes and clears it — a word-offset-literal comparison
    // alone cannot prove that. BIT_WORKERS=4 IS REQUIRED, same reason as
    // test-pollguardstopword: the harness controls a second, concurrently
    // running task and boot's single-OS-worker default leaves the two
    // unable to run concurrently at all.
    Gate{name: "test-pollguardpreempt", argv: runArgs("_tests_/bit/pollguardpreempt.bit"),
      env: [std, "BIT_WORKERS=4"]},
    // #4123: same file/gate as above under a distinct name (dedup — see
    // waitForClear's own comment); meaningful only via x64gate.sh/boxlock's
    // --need x86_64-linux on real x86-64 hardware, since `bit run` compiles native.
    Gate{name: "test-pollguardpreemptx64", argv: runArgs("_tests_/bit/pollguardpreempt.bit"),
      env: [std, "BIT_WORKERS=4"]},
    // #4134. schedCheckDeadlock (runtime/sched/worker.bit) stood down
    // unconditionally above BIT_WORKERS=1, so the three gates above this one
    // hung forever instead of panicking. No env override here: the harness
    // runs each child program bounded, with its OWN BIT_WORKERS.
    Gate{name: "test-schedmultideadlock", argv: runArgs("_tests_/bit/schedmultideadlock.bit"),
      env: [std]},
    // #3189. No env override: pins runtime/gc/stackmap.bit's smFormatVersion
    // export now, and is the place to extend once compiler/codegen.bit
    // carries its own mirror of the same literal.
    Gate{name: "test-stackmapformatversion", argv: runArgs("_tests_/bit/stackmapformatversion.bit"), env: [std]},
    // #2357. Regression gate for the executable bit on tracked *.sh files —
    // see the header of _tests_/bit/shebangmode.bit for the full rationale and
    // the sourced-library exemption. BIT_REPO IS REQUIRED: unlike
    // test-spec/test-filesize above, which only resolve paths against the
    // tree under test, this harness shells out to `git -C` against the repo
    // root and must not silently default to ".".
    Gate{name: "test-shebang-mode", argv: runArgs("_tests_/bit/shebangmode.bit"),
      env: [std, "BIT_REPO=${repoRoot()}"]},
    // #2949/#2956. Builds two near-identical programs with the compiler
    // under test (`bit build`, not `bit run`) to compare the linked
    // binaries and the object's own section headers, so BIT_STDLIB is
    // required the same way test-atomicwidth needs it.
    Gate{name: "test-globalsbss", argv: runArgs("_tests_/bit/globalsbss.bit"),
      env: [std]},
    // #3039. BIT_REPO IS REQUIRED, same reason as test-spec/test-filesize
    // above: the harness locates stdlib/, scripts/stage0.sh and its own
    // allowlist relative to it. See the harness header for why this is the
    // one gate in this table that can touch the network (only on a cold
    // `bit-out/stage0` cache; every later run is offline).
    Gate{name: "test-release-surface", argv: runArgs("_tests_/bit/releasesurface"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #2853. BIT_REPO IS REQUIRED, same reason as test-spec/test-filesize
    // above: the harness reads dist/release.sh and
    // docker/toolchain.Dockerfile relative to it. No BIT_STDLIB: the
    // extracted programs use only predeclared builtins (print/println).
    Gate{name: "test-synth-smoke", argv: runArgs("_tests_/bit/synthsmoke.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", "BIT_REPO=${repoRoot()}"]},
    // #2274. Lives here rather than _tests_/cases (single golden file, stdout
    // only) for the same reason test-clicmd does: the property is argv in /
    // wall-clock + exit code + a live-process check out. The hung fixture
    // this harness runs is written to a scratch directory at run time, never
    // committed — a permanently-hanging source file under _tests_/ would hang
    // any harness that walks every directory (_tests_/bit/stress/, `bit test`'s
    // own recursive walk at a project root).
    Gate{name: "test-timeout", argv: runArgs("_tests_/bit/testtimeout"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #3653 (2448-fallout). Builds and execs a stdlib entry point's fixture
    // at N and 2N calls (BIT_GC_STATS=1) and asserts the marginal
    // swept+live slope is exactly the row's declared objects/call —
    // #3637/#3617's class-as-multiple-return-vehicle regression class. Not
    // exclusive: object counts are exactly deterministic, never load-
    // sensitive (see _tests_/bit/benchgate/baselines.bit's `objects` field).
    Gate{name: "test-alloc-slope", argv: runArgs("_tests_/bit/allocslope.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
  ]
}

fn findGate(name: string): (Gate, bool) {
  for g of gateTable() {
    if (g.name == name) {
      return g, true
    }
  }
  return Gate{name: "", argv: []string(0), env: []string(0)}, false
}
