// The `test-*` gate TABLE for the Bit build driver (#1870, epic #1867).
// Recount with `grep -c '^    Gate{name: "test-' tools/build/gates.bit`
// rather than trust a number here — it goes stale on every gate added or
// removed (43 as of #2423). A bare `grep -c 'Gate{'` overcounts by one: the
// last `Gate{` in this file is `findGate`'s not-found sentinel (empty
// name), not a table entry.
//
// None of these contains test logic: every one launches a Bit program under
// `_tests_/bit/` (or drives a `bit` subcommand), and the whole job is handing it
// the right environment. A missing variable is not a crash, it is a SILENTLY
// DIFFERENT TEST — a harness that falls back to a default stdlib or a default
// binary still exits 0 and still reports a pass. So the table below is
// transcribed from the harnesses' actual requirements rather than inferred:
// a gate whose environment is wrong exits 0 and reports a pass anyway.
//
// Sorts after `artifacts.bit` (whose `runShell`/`shQuote`/`hostTriple` it uses)
// and before `gatesexec.bit` and `main.bit` (which call it), so the inliner
// sees each callee already lowered (#1511).
//
// Split from a single 953-line gates.bit by #3442 (spec/LINT.md:186's
// 800-line E0200 limit): the RUNNING machinery (single-gate path, the
// concurrent batch engine, `./make fuzz`) moved to `gatesexec.bit` — pure
// move, no symbol here changed.
//
// This file hit the same 800-line wall again five months later (758 -> 799
// in one week, #4169) purely from routine `Gate{}` additions, so the table
// itself is now split too: `gateTableB()` moved to the sibling
// `gatestable2.bit`, `gateTableA()` and everything else stayed here.
// `gateTable()` below still returns the union of both, called with no
// import — same `tools/build/` module scope as every sibling file. The
// OLD version of this comment said splitting the table further would
// silently break `scripts/gate.sh`'s gate-scoping; that objection no longer
// applies because `gates_for_file()` and `is_additive_registration()`
// (scripts/gate-filemap.sh, scripts/gate.sh) were updated in the same
// commit to grep BOTH `tools/build/gates.bit` AND `tools/build/gatestable2.bit`
// BY NAME for `Gate{name:`/`runArgs(...)` table entries — see
// scripts/gate-filemap.sh's `gates_for_file()` and scripts/gate.sh's
// `is_additive_registration()`. Adding a THIRD file needs the same two call
// sites updated again; there is no single point that auto-discovers new
// gate-table files.

import { envOr, selfExe } from "std/os"
import { lastIndexOf } from "std/strings"
import { readDir } from "std/fs"

class Gate {
  name: string
  argv: []string
  env: []string
  // Asserts on wall-clock or memory rather than a fixed expected result, so a
  // co-scheduled neighbour changes the number it reports (#2400, #2401, #2210).
  // Defaults false; set true on any gate whose pass/fail depends on timing,
  // CPU, RSS or another load-sensitive measurement — never count them, that
  // count goes stale the moment a new one is added (#3869). `runAll`
  // (main.bit) keeps these out of the concurrent batch and runs them alone,
  // afterwards.
  exclusive: bool
}

// Absolute, because several harnesses generate a wrapper that `cd`s elsewhere
// before exec'ing; a relative path would resolve against the wrong directory.
// `./make` exports this. When unset, derive it from the DRIVER'S OWN resolved
// path rather than falling back to a relative "." — the driver always lives at
// `<root>/bit-out/make/make-driver`, so its directory's grandparent is the
// root (#3430). The old fallback resolved fine from the repo root, so every
// `exists()` check passed and the gate looked healthy; it broke only inside a
// harness that `cd`s elsewhere first, misread as 240 unrelated exit-127
// failures. An explicitly-set but non-absolute override is a misconfiguration,
// not a value to accept silently, so that case refuses instead of guessing.
fn repoRoot(): string {
  let override = envOr("BIT_MAKE_ROOT", "")
  if (len(override) > 0) {
    if (hasPrefix(override, "/")) {
      return override
    }
    eprint("gates: BIT_MAKE_ROOT=\"${override}\" is not absolute; run via './make <step>', which exports it correctly.\n")
    exit(1)
    return override
  }
  let exe = selfExe()
  if (len(exe) > 0) {
    return dirName(dirName(dirName(exe)))
  }
  eprint("gates: BIT_MAKE_ROOT is unset and this binary's own path could not be resolved; run via './make <step>'.\n")
  exit(1)
  return "."
}

// The directory containing `path`, or "." / "/" at the edges. A local
// reimplementation of compiler/mainpaths.bit's pathDir: tools/build/ and
// compiler/ are separate modules, so that one is not reachable here.
fn dirName(path: string): string {
  let cut = lastIndexOf(path, "/")
  if (cut < 0) {
    return "."
  }
  if (cut == 0) {
    return "/"
  }
  return path[0:cut]
}

fn bitBin(): string { return "${repoRoot()}/bit-out/bin/bit" }
fn stdlibRoot(): string { return "${repoRoot()}/stdlib" }

// The archive `bit` links against on THIS host.
//
// The golden gate's archive path must NOT be hardcoded to one triple. It once
// was — `bit-out/lib/aarch64-macos/libbitrt.a` — which is correct only on macOS
// and broke on the Linux hosts `scripts/x64gate.sh` and `scripts/arm64gate.sh`
// drive. Resolved here
// instead.
fn hostArchive(): string {
  return "${repoRoot()}/bit-out/lib/${hostTriple()}/libbitrt.a"
}

fn runArgs(src: string): []string {
  return ["run", "${repoRoot()}/${src}"]
}

// One entry per `test-*` step. Split across two functions only to stay under
// the repo's max-fn-lines; the two together are the whole set, and `gateTable`
// is what everything reads.
fn gateTable(): []Gate {
  let out = []Gate(0)
  for g of gateTableA() {
    out = append(out, g)
  }
  for g of gateTableB() {
    out = append(out, g)
  }
  for g of packageGates() {
    out = append(out, g)
  }
  return out
}

// The `pkg/<name>/` directory names that exist RIGHT NOW — filesystem-driven
// rather than a hand-maintained list, so `packageGates()` below (and
// `packageSteps()`, tools/build/defs.bit) reflect reality with no
// registration edit as a package is added or removed. Sorted (`readDir`'s
// own contract), so `--list` and every log stay reproducible. A missing or
// unreadable `pkg/` reports zero packages rather than failing the whole
// driver — `test-packages` itself is what asserts "0 packages" is only ever
// correct because `pkg/` is genuinely empty.
fn packageNames(): []string {
  let dir = "${repoRoot()}/pkg"
  let names = readDir(dir) catch []string(0)
  let out = []string(0)
  for name of names {
    if (len(name) > 0 && name[0] == '.') {
      continue
    }
    if (fsIsDir("${dir}/${name}")) {
      out = append(out, name)
    }
  }
  return out
}

// One Gate per package that exists, so a release of one package can be
// gated alone (`./make test-package-<name>`) without touching yesterday's
// packages — `BIT_PACKAGE_FILTER` is the only difference from the
// `test-packages` umbrella above, and _tests_/bit/packagesgate.bit is the only
// place that reads it.
fn packageGates(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  let out = []Gate(0)
  for p of packageNames() {
    out = append(out, Gate{name: "test-package-${p}", argv: runArgs("_tests_/bit/packagesgate.bit"),
      env: [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", "BIT_PACKAGE_FILTER=${p}"]})
  }
  return out
}

fn gateTableA(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    Gate{name: "test-osenv", argv: runArgs("_tests_/bit/osenv.bit"), env: [std]},
    Gate{name: "test-stdlib-docs", argv: runArgs("_tests_/bit/stdlibdocs.bit"),
      env: ["BIT_DOCS_ROOT=${repoRoot()}", std]},
    // #4212: no gate ran `bit test`, so every stdlib `*.test.bit` (SPEC
    // §19) was dead code. Direct subcommand argv, not runArgs() — `bit
    // test`'s own exit code already fails on any discovered assertion.
    Gate{name: "test-stdlib-unit", argv: ["test", "${repoRoot()}/stdlib"], env: [std]},
    Gate{name: "test-version-cli", argv: runArgs("_tests_/bit/version.bit"),
      env: ["BIT_REPO=${repoRoot()}"]},
    Gate{name: "test-lint", argv: runArgs("_tests_/bit/lintcmd"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2486, widened to pkg/ by #3806. Distinct from test-lint-filelines
    // below: that gate sweeps compiler/+runtime/+stdlib/ PLUS four test trees
    // (_tests_/stress/, examples/, _tests_/bit/, _tests_/imports/) and tolerates a
    // fixture corpus inside _tests_/bit/; this one sweeps PRODUCTION CODE ONLY
    // — runtime/, compiler/, stdlib/, tools/, pkg/ — at a hard-zero E0200
    // tolerance, with no test tree in scope at all (pkg/'s own inline
    // *.test.bit files ARE swept — see _tests_/bit/lintsweep.bit's header for
    // why). See that same header for why _tests_/ cannot safely be added to
    // this gate's invocation (#3543).
    Gate{name: "test-lint-sweep", argv: runArgs("_tests_/bit/lintsweep.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", "BIT_MAKE_ROOT=${repoRoot()}", std]},
    // #2515. BIT_REPO IS REQUIRED, same reason as test-coldboot below: the
    // harness points `bit lint` at `${BIT_REPO}/runtime` and must not
    // silently default to ".".
    Gate{name: "test-lint-runtime", argv: runArgs("_tests_/bit/lintruntime.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #2747. Distinct from test-lint-runtime above: that one gates E0211
    // (unused-local) over `runtime/` alone; this one gates E0200
    // (max-file-lines) over BOTH `compiler/` and `runtime/` — the file that
    // implements the 800-line limit had itself drifted 62 lines past its own
    // override with nothing to catch it. BIT_REPO IS REQUIRED, same reason as
    // its neighbour: the harness points `bit lint` at `${BIT_REPO}/compiler`
    // and `${BIT_REPO}/runtime` and must not silently default to ".".
    Gate{name: "test-lint-filelines", argv: runArgs("_tests_/bit/lintfilelines.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #2453, epic #2354. The count-ratchet gate: every OTHER rule code across
    // compiler/ and stdlib/ (not just E0211 or E0200 like its two neighbours
    // above) is compared against tools/build/lint-ceiling.txt, and E0214
    // (append-aliasing) is enforced at zero unconditionally, ceiling or not.
    // #3620 extended the ratchet to runtime/ too, via the ceiling file's
    // optional third `runtime <n>` line (E0211 excluded — test-lint-runtime
    // above already owns it at zero). BIT_REPO IS REQUIRED, same reason as
    // its neighbours: the harness reads ${BIT_REPO}/tools/build/lint-ceiling.txt
    // and points `bit lint` at ${BIT_REPO}/compiler, ${BIT_REPO}/stdlib and
    // ${BIT_REPO}/runtime, and must not silently default to ".".
    Gate{name: "test-lint-self", argv: runArgs("_tests_/bit/lintself.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #4008. E0204 (max-complexity) had no gate. Same production-only scope
    // as test-lint-sweep (#3543). A downward-only PER-FUNCTION ratchet
    // against tools/build/complexity-debt.txt (282 seeded, epic #4109), not
    // a hard zero. BIT_REPO IS REQUIRED, same reason as its neighbours.
    Gate{name: "test-lint-complexity", argv: runArgs("_tests_/bit/lintcomplexity.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"]},
    // #4243. E0201/E0202/E0204 over _tests_/stress/, _tests_/bit/ and
    // _tests_/imports/ -- the hole between test-lint-complexity above
    // (production-only) and test-lint-filelines below (E0200-only). A
    // NAMED-file debt list (96 files, 167 findings measured on merged
    // `main` @ acd69411), never a count -- see _tests_/bit/linttests.bit's
    // own header for the two-way-assertion contract. BIT_REPO IS REQUIRED,
    // same reason as its neighbours.
    Gate{name: "test-lint-tests", argv: runArgs("_tests_/bit/linttests.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}",
        "BIT_LINTTESTS_DEBT=_tests_/stress/alloc/alloc.bit _tests_/stress/alloc/props/props.bit _tests_/stress/alloc/spanaccounting.bit _tests_/stress/alloc/spancache.bit _tests_/stress/chan/chan.bit _tests_/stress/chan/props/propstail.bit _tests_/stress/chanmakeroots/chanmakeroots.bit _tests_/stress/chanroots/chanroots.bit _tests_/stress/gcbit/gcbit.bit _tests_/stress/gcgrow/gcgrow.bit _tests_/stress/gcidxfree/gcidxfree.bit _tests_/stress/gcindexchurn/gcindexchurn.bit _tests_/stress/gclarge/gclarge.bit _tests_/stress/gcreserve/gcreserve.bit _tests_/stress/gcspanfree/gcspanfree.bit _tests_/stress/gcworld/gcworld.bit _tests_/stress/modstate/modstate.bit _tests_/stress/netcore/netcore.bit _tests_/stress/netsockdarwin/netsockdarwin.bit _tests_/stress/netsocklinux/netsocklinux.bit _tests_/stress/parallel/chanhammer.bit _tests_/stress/park/props/props.bit _tests_/stress/quicwire/quicwire.bit _tests_/stress/rootbit/rootbit.bit _tests_/stress/rootbit/rootbitnull.bit _tests_/stress/rootfloat/rootfloat.bit _tests_/stress/rootio/props/props.bit _tests_/stress/sched/sched.bit _tests_/stress/schedpool/props/props.bit _tests_/stress/schedtimer/schedtimer.bit _tests_/stress/spinlock/spinlock.bit _tests_/stress/stwcollect/stwcollect.bit _tests_/stress/stwownstack/stwownstack.bit _tests_/stress/thread/exitprops/props.bit _tests_/stress/thread/gcprops/props.bit _tests_/stress/thread/props/props.bit _tests_/stress/threadpool/threadpool.bit _tests_/stress/tlsthread/tlsthread.bit"]},
    // #4156. bit.json's "lint" key -- exit codes, both precedence
    // directions, and every malformed-config shape, against a real file.
    Gate{name: "test-lint-project", argv: runArgs("_tests_/bit/lintprojectconfig.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    Gate{name: "test-runcmd", argv: runArgs("_tests_/bit/runcmd.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2958. E0096 (a root-module function whose bare link name collides
    // with a symbol the linked runtime resolves externally) is gated,
    // linking-only and target-derived, exactly like E0078's
    // rejectExternForTarget beside it in compiler/build.bit — `bit check`
    // never reaches it, so it cannot live under checkercases/ like a normal
    // rejection. See the harness header for why.
    Gate{name: "test-root-name-collision", argv: runArgs("_tests_/bit/rootnamecollision.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #3734. `collectDoc` (compiler/doc.bit) must not list an imported free
    // function as this module's own export merely because its bare name
    // collides with a locally exported method — see the harness header for
    // the stdlib/regex case that found it and the minimal repro used here.
    Gate{name: "test-doc-import-collision", argv: runArgs("_tests_/bit/docimportcollision.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}"]},
    // #2864/#3071. Pins E0078's exact rendered wording (compiler/build.bit's
    // rejectExternForTarget) — see the harness header for why it cannot live
    // in _tests_/cases/ or checkercases/ like a normal rejection.
    Gate{name: "test-extern-unresolvable", argv: runArgs("_tests_/bit/externunresolvable.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2107. The layer ABOVE every subcommand: an unrecognised flag must be
    // refused, not consumed as an operand. Lives here rather than in _tests_/cases
    // because the whole property is argv in / exit code + stderr out, which a
    // golden (single file, stdout only) cannot express.
    Gate{name: "test-clicmd", argv: runArgs("_tests_/bit/clicmd"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2261. Lives here rather than in _tests_/cases because it asserts a
    // REJECTION the pinned stage0 oracle does not make, and a golden would put
    // that deliberate divergence inside selfhost-diffcheck.sh's sweep as a
    // FALSEPOS. See the header of _tests_/bit/constoverflow.bit.
    Gate{name: "test-const-overflow", argv: runArgs("_tests_/bit/constoverflow.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2129. Needs TWO sibling files in one module and it needs STDERR, so it
    // fits neither _tests_/cases (single file) nor _tests_/imports (compares stdout
    // and fails a case whose build fails). See the header of the harness.
    Gate{name: "test-dupdecl-note", argv: runArgs("_tests_/bit/dupdeclnote.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2385. Same reason as test-const-overflow above: it asserts a REFUSAL the
    // pinned stage0 oracle does not make — the oracle BUILDS all three of its
    // rejection cases, two into a segfault and one into a plausible wrong answer
    // — so a golden would put that deliberate divergence inside
    // selfhost-diffcheck.sh's sweep as a FALSEPOS. See the header of
    // _tests_/bit/lowerrefuse.bit.
    Gate{name: "test-lower-refuse", argv: runArgs("_tests_/bit/lowerrefuse.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2235. SPEC §17.4's `main(): ()!` row: the error prints to stderr and the
    // process exits 1. Lives here rather than in _tests_/cases because a golden
    // cannot express exit 1 plus stderr — `// panic` pins the exit to exactly 2 —
    // and because the fix deliberately changes the IR of every fallible `main`
    // (ABI.md §10), which the pinned oracle predates. See the harness header.
    Gate{name: "test-main-exit", argv: runArgs("_tests_/bit/mainexit.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2360, #2243, #2148. Same reason as test-const-overflow above: all three
    // assert REJECTIONS the pinned stage0 oracle does not make, and a golden
    // would put that deliberate divergence inside selfhost-diffcheck.sh's
    // sweep as a FALSEPOS. See the header of _tests_/bit/genericdiag.bit.
    Gate{name: "test-generic-diag", argv: runArgs("_tests_/bit/genericdiag.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    // #2232/#2123, #2230, #2237, and #2377 which moved them here. Same reason as
    // test-const-overflow above, with one extra turn of the screw: these four
    // fixes are NEWER than the pinned oracle's release, so no repin can clear
    // them. Unlike its two neighbours this gate compares the FULL rendered
    // diagnostic against a `.expected` — the cases arrived from _tests_/cases with
    // one, and BIT_CHECKER_CASES_DIR is where they now live. See the header of
    // _tests_/bit/checkerdiag.bit.
    Gate{name: "test-checker-diag", argv: runArgs("_tests_/bit/checkerdiag.bit"),
      env: [std, "BIT_CHECKER_CASES_DIR=${repoRoot()}/_tests_/bit/checkercases",
        "BIT_BIN=${bitBin()}"]},
    // #2344, and the front-end behaviour cases after it. Related to
    // test-checker-diag but NOT the same reason: these cases are ACCEPTED by
    // both compilers and PARSED differently, which reddens
    // selfhost-diffast.sh/diffir/difftypes rather than diffcheck. They are built
    // and RUN, because #2344's bug was a clean `bit check` followed by a SIGSEGV
    // from the binary. See the header of _tests_/bit/parsergate.bit.
    Gate{name: "test-parser", argv: runArgs("_tests_/bit/parsergate.bit"),
      env: [std, "BIT_PARSER_CASES_DIR=${repoRoot()}/_tests_/bit/parsercases",
        "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"]},
    Gate{name: "test-fsblock", argv: runArgs("_tests_/bit/fsblock.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std]},
    Gate{name: "test-lsp-lifecycle", argv: runArgs("_tests_/bit/lsplifecycle.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-resolve", argv: runArgs("_tests_/bit/lspresolve.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #2326/#2348. Measures ALLOCATION, not RSS, and compares two arms of one
    // run against each other rather than an absolute count — see the header of
    // _tests_/bit/lspcache.bit for why either alternative cannot work here.
    Gate{name: "test-lsp-cache", argv: runArgs("_tests_/bit/lspcache.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-references", argv: runArgs("_tests_/bit/lspreferences.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-formatting", argv: runArgs("_tests_/bit/lspformatting.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-lsp-signaturehelp", argv: runArgs("_tests_/bit/lspsignaturehelp.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #3559: `checkResolved` runs even when the buffer already has a parse
    // error elsewhere, so a query on a well-formed declaration answers real
    // type info instead of null, and the server does not crash on a
    // severely malformed tree.
    Gate{name: "test-lsp-errortolerant", argv: runArgs("_tests_/bit/lsperrortolerant.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    // #4157: a directory of independent single-file programs (_tests_/bit/
    // itself, among others) must not be built as one module. BIT_REPO locates
    // the real _tests_/bit/allocslope.bit this gate opens read-only.
    Gate{name: "test-lsp-moduledir", argv: runArgs("_tests_/bit/lspmoduledir.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"], exclusive: true},
    // #4176: a NOTE must never publish the fabricated "E0000" code, and must
    // be carried as relatedInformation on its parent, not a second diagnostic.
    Gate{name: "test-lsp-diagnostics", argv: runArgs("_tests_/bit/lspdiagnostics.bit"),
      env: ["BIT_SELF_EXE=${bitBin()}", std], exclusive: true},
    Gate{name: "test-pathresolve", argv: runArgs("_tests_/bit/pathresolve.bit"), env: [std]},
    Gate{name: "test-pmimports", argv: runArgs("_tests_/bit/pmimports.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    // BIT_WORKERS=2 IS REQUIRED. The harness spawns a green thread to serve
    // one local HTTP request while the main thread blocks inside
    // `osRunBounded` waiting on the `bit add` child it drives — with this
    // runtime's default of exactly one scheduler worker OS thread (ABI.md
    // §9), that spawned thread never runs until the blocking call returns,
    // so the vanity-document fetch always times out. Reproduced directly: a
    // second worker is what turns the accept from "never" into "immediate".
    Gate{name: "test-pmvanity", argv: runArgs("_tests_/bit/pmvanity.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}", "BIT_WORKERS=2"]},
    Gate{name: "test-pmaddgit", argv: runArgs("_tests_/bit/pmaddgit.bit"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    Gate{name: "test-pmrangegate", argv: runArgs("_tests_/bit/pmrangegate"),
      env: ["BIT_STDLIB_UNDER_TEST=${stdlibRoot()}"]},
    Gate{name: "test-examples", argv: runArgs("_tests_/bit/examplesgate.bit"),
      env: [std, "BIT_EXAMPLES_DIR=${repoRoot()}/examples"]},
    Gate{name: "test-docs", argv: runArgs("_tests_/bit/docs.bit"), env: [std]},
    // #2808. `editors/vscode/sample.bit` is the syntax-highlighting sample
    // shipped INSIDE the published VS Code extension, and nothing in the tree
    // ever looked at it: it carried three independent defects in turn
    // (#2789 the retired `function` keyword, #2799 a stale prelude-era import,
    // #2805 a free-function `fs.readAll` that never existed) before anyone
    // noticed. Must be `run`, not `check` — #2805's class of error (an
    // undefined member reached through a wildcard-namespace import) type-checks
    // clean and fails only at lowering (#2804), so a check-only gate would
    // have stayed green while the shipped sample was broken.
    Gate{name: "test-editor-sample", argv: runArgs("editors/vscode/sample.bit"), env: [std]},
    // BIT_LIBBITRT IS REQUIRED, and was missing for a long time.
    // `importsrun/importsrun.bit:314` reads it; without it the gate failed
    // before running a single project, and had done since the harness landed
    // (856d694). The driver sets it rather than reproducing that break, so an
    // equivalence diff must expect this one step to disagree. #3593 split the
    // harness into `_tests_/bit/importsrun/` (a directory module, over the
    // 800-line ceiling as one file) — `runArgs` below now names the
    // directory, not a single `.bit` file.
    Gate{name: "test-imports-bit", argv: runArgs("_tests_/bit/importsrun"),
      env: ["BIT_IMPORTS_BIT=${bitBin()}", "BIT_IMPORTS_DIR=${repoRoot()}/_tests_/imports",
        "BIT_LIBBITRT=${hostArchive()}", std]},
    Gate{name: "test-fuzz", argv: runArgs("_tests_/bit/fuzz.bit"),
      env: ["BIT_FUZZ_BIN=${bitBin()}", "BIT_FUZZ_CASES=${repoRoot()}/_tests_/cases",
        "BIT_FUZZ_CRASHES=${repoRoot()}/_tests_/fuzz/crashes",
        "BIT_FUZZ_SECONDS=5", "BIT_FUZZ_SEED=1", std], exclusive: true},
    // #2038, epic #2025. Same shape as `test-fuzz` above. Not in
    // `gateNames()` (tools/build/defs.bit), so `test` never runs it; `./make
    // test-fuzz-regex` does.
    Gate{name: "test-fuzz-regex", argv: runArgs("_tests_/bit/regexfuzz.bit"),
      env: ["BIT_REGEXFUZZ_BIN=${bitBin()}", "BIT_REGEXFUZZ_CASE=${repoRoot()}/_tests_/bit/regexfuzzcase.bit",
        "BIT_REGEXFUZZ_CASES=${repoRoot()}/_tests_/fuzz/regexcases",
        "BIT_REGEXFUZZ_CRASHES=${repoRoot()}/_tests_/fuzz/regexcrashes",
        "BIT_REGEXFUZZ_SECONDS=5", "BIT_REGEXFUZZ_SEED=1", std], exclusive: true},
    // #2055, epic #2025. A pure-Bit in-process benchmark — no subprocess,
    // so it needs only BIT_STDLIB, same minimal env as test-atomicwidth
    // below. Not in `gateNames()` (tools/build/defs.bit), so `test` never
    // runs it; `./make bench-regex` does. Never fails: see
    // _tests_/bit/benchregex/benchregex.bit's own header.
    Gate{name: "bench-regex", argv: runArgs("_tests_/bit/benchregex"), env: [std]},
    // #2609 (epic #1907). Three standalone tools/fuzz/*.bit drivers
    // (#2606/#2607/#2608) that were previously reachable only by hand.
    // Seed and count pinned so a failing run is reproducible: `--seed 1` for
    // all three, `--count 100` for selfcheck/odiff, `--count 20` for
    // xtarget (cross-arch, needs hl-master over ssh — SKIPs, does not fail,
    // when that host is unreachable, per tools/fuzz/xtarget.bit's own
    // contract). `BIT` is the env var these drivers read for the compiler
    // path (`envOr("BIT", "./bit-out/bin/bit")`); set explicitly since the
    // driver's own cwd is not guaranteed to be repoRoot().
    Gate{name: "test-fuzz-selfcheck",
      argv: ["run", "${repoRoot()}/tools/fuzz/selfcheck.bit", "--", "--seed", "1", "--count", "100"],
      env: ["BIT=${bitBin()}", std]},
    Gate{name: "test-fuzz-odiff",
      argv: ["run", "${repoRoot()}/tools/fuzz/odiff.bit", "--", "--seed", "1", "--count", "100"],
      env: ["BIT=${bitBin()}", std]},
    Gate{name: "test-fuzz-xtarget",
      argv: ["run", "${repoRoot()}/tools/fuzz/xtarget.bit", "--", "--seed", "1", "--count", "20"],
      env: ["BIT=${bitBin()}", std]},
    // #2564. Split from the single `test-stress` gate: `BIT_STRESSGATE_PARTITION`
    // (_tests_/bit/stress/) selects the two of the four exclusiveNames() names
    // eligible on this host — those stay `exclusive`, the same reason the whole
    // gate used to be — from the 61 that assert only on correctness and can run
    // alongside any other gate. `test-stress` itself
    // (below, in `gateTableB`) stays unpartitioned for standalone use; these two
    // are what `test`'s dependency list actually runs (`gateNames()`,
    // tools/build/defs.bit).
    Gate{name: "test-stress-exclusive", argv: runArgs("_tests_/bit/stress"),
      env: [std, "BIT_STRESSGATE_PARTITION=exclusive"], exclusive: true},
    Gate{name: "test-stress-batch", argv: runArgs("_tests_/bit/stress"),
      env: [std, "BIT_STRESSGATE_PARTITION=batch"]},
  ]
}

fn findGate(name: string): (Gate, bool) {
  for g of gateTable() {
    if (g.name == name) {
      return g, true
    }
  }
  return Gate{name: "", argv: []string(0), env: []string(0)}, false
}
