// How a `Gate{}` (gates.bit) actually runs: the single-gate path, the
// concurrent batch engine (#2434), and `./make fuzz`. Split out of gates.bit
// by #3442 once that file crossed the repo's 800-line E0200 limit
// (spec/LINT.md:186) — pure move, no symbol below changed. Named
// `gatesexec.bit` rather than `gaterun.bit` so it sorts AFTER `gates.bit`
// (whose `Gate` class and `findGate` it calls) and still before `main.bit`
// (which calls `runGate`/`runGateBatch`/`stepFuzz` here), so the inliner
// sees each callee already lowered (#1511).
//
// scripts/gate.sh greps `tools/build/gates.bit` BY NAME for `Gate{name:`
// entries and `runArgs(...)` calls (its `gates_for_file()` and
// `is_additive_registration()`) — that file keeps its name and keeps every
// `Gate{}` record for exactly this reason; only the execution machinery
// that never appears in that grep moved here.

import { randomBytes } from "std/crypto"
import { killTreeFnDef, pgrepPreflightScript } from "../killtree"

// A harness may run for minutes (`test-stress` is the corpus worst case), so
// the bound is generous. It exists at all because a hang is a failure, not a
// stall (#1637/#1652) — but each harness already carries its OWN per-child
// deadline, so this is only the outer backstop and must stay well above it.
fn gateTimeoutMs(): int {
  let s = envOr("BIT_MAKE_GATE_TIMEOUT_S", "5400")
  return parseIntOr(s, 5400) * 1000
}

fn parseIntOr(s: string, fallback: int): int {
  let n = 0
  let i = 0
  if (len(s) == 0) {
    return fallback
  }
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return fallback
    }
    n = n * 10 + (int(c) - 48)
    i = i + 1
  }
  return n
}

// THE INSTALL-ORDER HAZARD (#1229/#1644). Every gate reads `bit-out/bin/bit`
// and the host archive off disk, so both must be fully published before any of
// them starts. That is a per-RUN dependency edge — never on a shared parent,
// because a runner may then install and read concurrently, and
// a partially-written binary execs and SIGSEGVs with empty stderr.
//
// The driver runs steps sequentially in dependency order, so `selfhost` and
// `libbitrt` have already completed here. This is the assertion that they
// actually produced their outputs, which is the property the edge existed for.
fn gatePrereqsReady(): bool {
  if (!exists(bitBin())) {
    eprint("make: missing ${bitBin()} — run `./make selfhost` first\n")
    return false
  }
  if (!exists(hostArchive())) {
    eprint("make: missing ${hostArchive()} — run `./make libbitrt` first\n")
    return false
  }
  return true
}

// The env-export preamble plus the final `exec` line, shared by the single-
// gate path below and the concurrent batch unit further down — one
// definition of "how a Gate becomes a shell command" so the two paths cannot
// drift apart.
fn gateEnvExecScript(g: Gate): string {
  let script = ""
  for kv of g.env {
    let eq = indexOfByte(kv, '=')
    if (eq < 0) {
      continue
    }
    script = script + kv[:eq] + "=" + shQuote(kv[eq + 1:]) + "\nexport " + kv[:eq] + "\n"
  }
  // Passed through rather than set, so a slower host can widen every harness's
  // own internal deadline the documented way.
  let t = envOr("BIT_TEST_TIMEOUT_S", "")
  if (t != "") {
    script = script + "BIT_TEST_TIMEOUT_S=" + shQuote(t) + "\nexport BIT_TEST_TIMEOUT_S\n"
  }
  script = script + "exec " + shQuote(bitBin())
  for a of g.argv {
    script = script + " " + shQuote(a)
  }
  return script + "\n"
}

fn runGate(name: string): int {
  let (g, ok) = findGate(name)
  if (!ok) {
    eprint("make: step '${name}' is not implemented yet\n")
    return 1
  }
  if (!gatePrereqsReady()) {
    return 1
  }
  let rc = runShell(name, "set -e\n" + gateEnvExecScript(g), gateTimeoutMs())
  return reportGate(name, rc)
}

// A child killed by a signal is a CRASH, and must not read as a plain non-zero
// exit — the distinction is what tells a segfault apart from a harness that
// simply failed its assertions (#1637).
//
// TWO ENCODINGS, because there are two children. `osRunBounded` runs a /bin/sh
// wrapper and reports ITS fate in the runtime's encoding (ABI.md §19): -1 spawn
// failure, -2 timeout, <= -100 signal death with signo = -rc - 100. The harness
// itself is the wrapper's child, so when IT is killed `sh` survives and exits
// 128+signo in the ordinary shell convention. Both are crashes; reporting only
// one of them would let the common case — a segfaulting harness under an `exec`
// that the shell reports numerically — read as a failed assertion.
fn reportGate(name: string, rc: int): int {
  if (rc == 0 - 1) {
    eprint("make: ${name} could not be started (spawn/wait failed)\n")
    return 1
  }
  if (rc == 0 - 2) {
    eprint("make: ${name} TIMED OUT after ${gateTimeoutMs() / 1000}s — this is a hang, not a failed assertion\n")
    return 1
  }
  if (rc <= 0 - 100) {
    eprint("make: ${name} CRASHED — killed by signal ${0 - rc - 100}\n")
    return 1
  }
  if (rc > 128 && rc < 192) {
    eprint("make: ${name} CRASHED — killed by signal ${rc - 128}\n")
    return 1
  }
  if (rc != 0) {
    eprint("make: ${name} failed (exit ${rc})\n")
    return 1
  }
  return 0
}

// --- concurrent batch (#2434) ------------------------------------------------
//
// `main.bit`'s `runAll` hands a run of consecutive non-`exclusive` gate names
// here instead of calling `runGate` on each in turn. The parallelism lives
// entirely in the shell, not in Bit: `osRunBounded` (runtime/root/*/os.bit)
// polls with a raw, `@nosplit` `nanosleep` and never yields, so a spawned Bit
// green thread would never get scheduled until it returned — one gate at a
// time, exactly like today, just with extra machinery. See #2434's ticket for
// why `spawn` and a new runtime primitive were both ruled out.
//
// One composed script launches every gate in the chunk backgrounded with its
// own private killer, each redirected to its own file under `batchDir()`, and
// `wait`s for all of them. Reporting happens back here, from those files, in
// the same `order` position the caller passed them in — never through a pipe,
// and never while two gates could still be racing to write the same fd.

fn isExclusiveGate(name: string): bool {
  let (g, ok) = findGate(name)
  return ok && g.exclusive
}

// Reused across every chunk in one `./make` run: redirection truncates each
// gate's own file at launch, and no two gates in a chunk share a name, so
// there is nothing to clean between chunks. Lives under the driver's existing
// scratch area (bit-out/make already holds the fp stamps and run-<name>.sh
// wrappers), not a fresh `mktemp -d` — that path would only be known inside
// the child shell, and the Bit code on this side of `runShell` is what has to
// read it back.
fn batchDir(): string { return "bit-out/make/gatebatch" }

// #3256. Every gate's rc file lives at ONE fixed path per worktree
// (`batchDir()`), so a killed or aborted run's rc file survives on disk and
// the next run cannot tell it apart from its own by looking at the path
// alone — the orphan is also NEWER than any earlier good write, so mtime
// cannot help either. `runGateBatch` calls this ONCE per invocation and
// threads the result through every chunk it runs, so every rc file this
// process writes carries the same identity: the tree's HEAD sha (an orphan
// from a different commit is instantly recognisable) plus a fresh
// `randomBytes` nonce (an orphan from an earlier run AT THE SAME sha —
// exactly the "killed then relaunched immediately" case that motivated this
// ticket — is recognisable too, since the nonce cannot repeat by chance).
// `runGateChunk` refuses to trust any rc file whose stamp does not match
// both fields exactly, including a pre-#3256 rc file with no stamp at all.
//
// #3485: the sha half is a nice-to-have, not a requirement — the nonce alone
// already makes every invocation's stamp unique (a fresh random 8 bytes
// cannot repeat by chance; that is the exact property the comment above
// already relies on for "an earlier run AT THE SAME sha"). So a tree with no
// HEAD to resolve — both hardware gates run the suite over
// `git archive HEAD | tar x`, which by design produces a tree with no `.git`
// at all — still gets a fully working stamp: real rc-file identity, every
// gate actually runs, PASS/FAIL is real. `noGitSha()` mirrors git's own
// all-zero null-OID convention (used e.g. in pre-receive hooks for "no such
// commit"), so a reader recognises it as "no real commit" on sight rather
// than a fabricated hash, and it stays plain hex — safe to embed unescaped
// in the generated shell script exactly like a real sha (`gateBatchUnit`).
// This used to return a third `stampOk` bool and `runGateBatch` marked every
// gate in the batch FAILED when it came back false, with no way for the
// final report to tell "this gate failed" apart from "the batch never ran"
// — silently true for every hardware-gate run since #3256 landed.
fn noGitSha(): string { return "0000000000000000000000000000000000000000" }

fn currentGateStamp(): (string, string) {
  let outPath = "bit-out/make/gatebatch-headsha.out"
  let rc = runShell("gatebatch-headsha",
    "git -C " + shQuote(repoRoot()) + " rev-parse HEAD > " + shQuote(outPath) + "\n",
    buildTimeoutMs())
  if (rc != 0) {
    eprint("make: cannot resolve HEAD sha for gate-batch stamping (git rev-parse HEAD exited ${rc}); running the batch anyway with a placeholder stamp\n")
    return noGitSha(), encodeHex(randomBytes(8))
  }
  let sha = trimNewline(readFile(outPath) catch "")
  if (sha == "") {
    eprint("make: git rev-parse HEAD produced no output; running the batch anyway with a placeholder stamp\n")
    return noGitSha(), encodeHex(randomBytes(8))
  }
  return sha, encodeHex(randomBytes(8))
}

// No new runtime primitive (#2152's lesson applies here too): core count
// comes from the shell, the same round-trip `hostTriple()` already uses.
// `nproc` covers Linux; `sysctl -n hw.ncpu` is the Darwin fallback.
fn numCPUs(): int {
  let outPath = "bit-out/make/ncpu"
  let script = "{ nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null; } > " + shQuote(outPath) + "\n"
  if (runShell("ncpu", script, buildTimeoutMs()) != 0) {
    return 1
  }
  let n = parseIntOr(trimNewline(readFile(outPath) catch ""), 0)
  if (n < 1) {
    return 1
  }
  return n
}

// Cores minus 2 (headroom for the OS and this driver itself), floor 1.
// BIT_MAKE_JOBS overrides directly; =1 is the escape hatch back to today's
// strict serial order and this ticket's own A/B control.
fn makeJobs(): int {
  let s = envOr("BIT_MAKE_JOBS", "")
  if (s == "") {
    let n = numCPUs() - 2
    if (n < 1) {
      return 1
    }
    return n
  }
  let n = parseIntOr(s, 1)
  if (n < 1) {
    return 1
  }
  return n
}

// `gateTimeoutMs()` bounds one `osRunBounded` call today; in a batch that call
// wraps the WHOLE chunk, so it would silently bound every gate in it by the
// slowest one's budget shared across all of them. Each gate instead gets its
// own killer inside the script (macOS ships no `timeout(1)`, hence
// `sleep`+`kill -9`), and this outer bound becomes a backstop only: generous
// slack over the same per-gate budget, since the gates run concurrently, not
// stacked end to end.
fn batchOuterTimeoutMs(): int { return gateTimeoutMs() + 60000 }

// One gate's slot inside the batch: backgrounded so N of these overlap, each
// with its own deadline. The `.timedout` marker is written by the killer
// BEFORE it sends `kill -9`, strictly before `wait "$GPID"` in the same slot
// can observe the death — so reading it back afterward can never race, and it
// is what lets a per-gate timeout still read as "TIMED OUT" instead of
// "CRASHED — killed by signal 9" (`runGateChunk` below).
//
// The killer subshell (`</dev/null >/dev/null 2>&1`) never inherits this
// slot's own stdio (#2514): without it, a caller piping `./make <gate>` puts
// its pipe's write end in the subshell's fd table, and a leaked descendant
// still holding that fd would block a read-until-EOF caller (`tail`,
// `$(...)`) long after the gate itself finished.
//
// #2563: the killer used to be one `sleep timeoutS; ...`. `kill "$KPID"` on
// the success path reaches only the killer subshell, not the `sleep` it
// forked — sh cannot exec-replace into `sleep` here because two more
// statements follow it, so the shell survives as the direct parent until
// `sleep` returns. A SIGTERM'd shell does not propagate to that child, so
// `sleep` reparented to pid 1 and ran out its own clock, up to `timeoutS`
// later — 269 measured orphaned in a single worktree. It now POLLS instead
// of sleeping once: `kill -0 "$GPID"` every second, so on the success path
// the loop itself notices `$GPID` is gone and exits within ~1s — normally
// before `kill "$KPID"` below even runs — and even a lost race leaves only a
// `sleep 1` behind, which finishes and exits on its own within that same
// ~1s rather than `timeoutS`. Each poll runs the renamed `sleep` binary
// `watchdogSetupScript` creates below, so a straggler is attributable
// (`pgrep -fl bit-gate-watchdog`) instead of showing as an anonymous
// `sleep 1` nobody can trace back here. The loop's own iteration count is
// bounded by `timeoutS` (Power of 10 rule 2) — the same deadline as before,
// just paid in one-second polls instead of one long wait.
//
// #3227: the poll used to be `( exec -a bit-gate-watchdog sleep 1 )`.
// `exec -a` (rename argv[0] before exec) is a bash/ksh extension; dash —
// Debian's `/bin/sh`, and therefore this project's own x64 gate image
// (`bit-linux-gate-amd64`, `FROM debian:bookworm`) — rejects `-a` outright,
// so the subshell errored out INSTANTLY instead of sleeping, `n` raced to
// `timeoutS` in a fraction of a real second, and the watchdog killed every
// gate almost immediately. `-a`'s only job was giving the poll's `sleep`
// process the argv[0] `pgrep -fl bit-gate-watchdog` above relies on — a
// symlink named `bit-gate-watchdog` pointing at the real `sleep` binary gets
// the identical argv[0] rename through a plain, extension-free `exec`
// (POSIX: argv[0] is whatever name you invoke, symlink or not), so both
// dash and bash now take the same code path with no shell-detection branch.
//
// #3066: `kill -9 "$GPID"` on the deadline branch only ever killed `$GPID`
// itself — a gate whose own command forks a subtree (`test-imports-bit`'s
// `find | xargs -P N` compile/run wave is the clearest case) left every
// live descendant running orphaned, bounded only by ITS OWN deadline rather
// than this gate's. `killtree()` (imported below, `../killtree`) walks
// `$GPID`'s descendants by PPID via `pgrep -P` and kills each one
// individually, instead of `kill`ing a process GROUP. Process groups were
// tried and rejected: giving `$GPID` its own group (`set -m`) is exactly
// what makes it unreachable from `batchOuterTimeoutMs()`'s runtime-level
// backstop, which kills by the single shared group `osForkExecWaitBounded`
// already put every descendant of THIS WHOLE SCRIPT into (`osKillGroup`,
// runtime/root/*/os.bit) — verified empirically: isolating `$GPID` into its
// own group left a live subtree unreached by a simulated outer group-kill.
// A PPID walk touches no process group at all, so it cannot narrow that
// backstop's reach. `killTreeFnDef`'s own comment (`tools/killtree/`) has
// the full walk-ordering rationale (why three passes, why snapshot before
// killing); it is shared verbatim by `tests/bit/importsrun.bit` (#3238).
//
// `sha`/`runId` (from `currentGateStamp()`) are plain hex, so they are
// embedded directly into the generated `echo` line the same way `timeoutS`
// and `dir` already are — no shell metacharacters to escape.
fn gateBatchUnit(g: Gate, dir: string, timeoutS: string, sha: string, runId: string): string {
  let outFile = shQuote(dir + "/" + g.name + ".out")
  let rcFile = shQuote(dir + "/" + g.name + ".rc")
  let toFile = shQuote(dir + "/" + g.name + ".timedout")
  let wdPath = shQuote(watchdogPath(dir))
  return "(\n" +
    "(\n" + gateEnvExecScript(g) + ") > " + outFile + " 2>&1 &\n" +
    "GPID=$!\n" +
    "( n=0; while kill -0 \"$GPID\" 2>/dev/null; do if [ \"$n\" -ge " + timeoutS + " ]; then echo \"" + sha + " " + runId + "\" > " + toFile + "; killtree \"$GPID\"; break; fi; " + wdPath + " 1 || sleep 1; n=$((n + 1)); done ) </dev/null >/dev/null 2>&1 &\n" +
    "KPID=$!\n" +
    "wait \"$GPID\"\n" +
    "RC=$?\n" +
    "kill \"$KPID\" 2>/dev/null\n" +
    "wait \"$KPID\" 2>/dev/null\n" +
    "echo \"$RC " + sha + " " + runId + "\" > " + rcFile + "\n" +
    ") &\n"
}

// Where the poll's renamed `sleep` symlink lives: one per batch dir, created
// once by `watchdogSetupScript`, read (never written) by every concurrent
// gate unit's poll.
fn watchdogPath(dir: string): string { return dir + "/bit-gate-watchdog" }

// #3227: creates the `bit-gate-watchdog` -> `sleep` symlink `gateBatchUnit`'s
// poll execs, so N concurrent gate units share one symlink instead of racing
// to create their own. Written once, before any unit's `&`-backgrounded
// subshell starts, so this line always finishes first — `batchScript` builds
// one literal top-to-bottom script, not concurrent text. `dir` already
// exists by the time this runs (`runGateChunk` calls `ensureDir(dir)` before
// `runShell` executes this script). The `2>/dev/null` only swallows the
// vanishingly unlikely case where `sleep` itself is missing from `$PATH`;
// `gateBatchUnit`'s own `|| sleep 1` fallback keeps the poll correct (just
// unattributed) even then.
fn watchdogSetupScript(dir: string): string {
  return "ln -sf \"$(command -v sleep)\" " + shQuote(watchdogPath(dir)) + " 2>/dev/null\n"
}

// #3236: `killtree()`'s BFS loop (`kids=$(pgrep -P ... 2>/dev/null)`) cannot
// tell "pgrep is not installed" (exit 127) apart from "no descendants" (exit
// 1, also empty stdout) — both leave `kids` empty, so a host missing `pgrep`
// silently degrades every timed-out gate to killing only its own direct PID
// (#3230 was exactly this, on the linux gate image before it gained
// `procps`). A per-call check inside that BFS loop is the wrong shape — it
// is the hot path, run once per level of every gate's kill path, and must
// stay simple. This checks ONCE per chunk script, before any gate unit
// starts — same placement and granularity as `watchdogSetupScript` above.
// `pgrepPreflightScript` (imported below, `../killtree`) is shared verbatim
// with `tests/bit/importsrun.bit`'s own preflight (#3238); this call site's
// `"gate"`/`"the outer batch timeout"` arguments are the only thing that
// differs from that file's `"case"`/`"the outer run bound"`. The message
// goes to this script's own stderr, not any gate's redirected `.out` file,
// so it reaches the terminal immediately instead of waiting for that gate's
// turn in `runGateChunk`'s report loop — and it fires once per chunk, not
// deduped away, so it cannot scroll off during a long batch.

// One `osRunBounded`, N backgrounded gates, one `wait` — the whole chunk.
// `killTreeFnDef`, the pgrep preflight and the watchdog symlink are written
// once; every gate unit's subshell inherits the function (a POSIX subshell
// inherits its parent's function definitions) and reads the same symlink
// path.
fn batchScript(chunk: []Gate, dir: string, sha: string, runId: string): string {
  let timeoutS = "${gateTimeoutMs() / 1000}"
  let script = killTreeFnDef() + pgrepPreflightScript("gate", "the outer batch timeout") + watchdogSetupScript(dir)
  for g of chunk {
    script = script + gateBatchUnit(g, dir, timeoutS, sha, runId)
  }
  return script + "wait\n"
}

// Runs one concurrent chunk (at most `makeJobs()` gates, none `exclusive`) and
// reports every one of them in `chunk` position, so output never interleaves
// and a run's `make: FAILED:` line is deterministic regardless of which gate
// actually finished first.
fn runGateChunk(chunk: []Gate, sha: string, runId: string): []string {
  let failed = []string(0)
  if (len(chunk) == 0) {
    return failed
  }
  if (!gatePrereqsReady()) {
    for g of chunk {
      failed = append(failed, g.name)
    }
    return failed
  }
  let dir = batchDir()
  if (!ensureDir(dir)) {
    eprint("make: cannot create ${dir}\n")
    for g of chunk {
      failed = append(failed, g.name)
    }
    return failed
  }
  let outerRc = runShell("gatebatch", batchScript(chunk, dir, sha, runId), batchOuterTimeoutMs())
  for g of chunk {
    print("make: ${g.name}\n")
    let rcPath = "${dir}/${g.name}.rc"
    print(readFile("${dir}/${g.name}.out") catch "")
    if (!exists(rcPath)) {
      // `batchScript` ends in a bare `wait`, so `outerRc` is 0 for every
      // batch the outer backstop did not itself kill — it cannot carry an
      // inner gate's failure. Only attribute it when it is itself non-zero
      // (the outer backstop genuinely fired); a missing rc with a zero
      // outerRc means the slot simply never reported, and that is a
      // failure on its own, not a silent pass (#3058).
      if (outerRc != 0) {
        if (reportGate(g.name, outerRc) != 0) {
          failed = append(failed, g.name)
        }
      } else {
        eprint("make: ${g.name} DID NOT REPORT — no rc file written\n")
        failed = append(failed, g.name)
      }
      continue
    }
    // #3256: `rcPath` is a fixed path, so a killed run's rc file (or a
    // pre-#3256 rc with no stamp at all) can still be sitting there. Trust
    // it only when it carries THIS run's exact stamp — a mismatch or a
    // missing stamp means "did not run", never "passed".
    let fields = split(trimNewline(readFile(rcPath) catch ""), " ")
    if (len(fields) != 3 || fields[1] != sha || fields[2] != runId) {
      eprint("make: ${g.name} rc is STALE — its stamp does not match this run (a killed or earlier run's leftover at the fixed path ${rcPath}); refusing to count it as a pass. Re-run: ./make ${g.name}\n")
      failed = append(failed, g.name)
      continue
    }
    let rc = parseIntOr(fields[0], 0 - 1)
    // Same fixed-path staleness as `rcPath` above (#3259, follow-up to
    // #3256): the marker is never removed on the non-timeout path, so a gate
    // that timed out once in an earlier run leaves it sitting there forever.
    // Trust it only when it carries THIS run's exact stamp; a missing or
    // foreign stamp means "not this run's timeout" and the already-verified
    // rc above is the real verdict.
    let toPath = "${dir}/${g.name}.timedout"
    if (exists(toPath)) {
      let toFields = split(trimNewline(readFile(toPath) catch ""), " ")
      if (len(toFields) == 2 && toFields[0] == sha && toFields[1] == runId) {
        rc = 0 - 2
      }
    }
    if (reportGate(g.name, rc) != 0) {
      failed = append(failed, g.name)
    }
  }
  return failed
}

// Splits `names` (all gates, none `exclusive`) into consecutive chunks of at
// most `makeJobs()` and runs them one chunk after another. At `BIT_MAKE_JOBS=1`
// every chunk holds exactly one gate, which is today's serial order exactly —
// the A/B control #2434 asks for.
fn runGateBatch(names: []string): []string {
  let failed = []string(0)
  if (len(names) == 0) {
    return failed
  }
  // One stamp for the whole flush: every chunk below writes rc files that
  // read back as belonging to THIS invocation (#3256). Always usable now
  // (#3485) — see `currentGateStamp`'s own comment for why a tree with no
  // resolvable HEAD no longer aborts the whole batch before a gate runs.
  let (sha, runId) = currentGateStamp()
  let jobs = makeJobs()
  let i = 0
  while (i < len(names)) {
    let end = i + jobs
    if (end > len(names)) {
      end = len(names)
    }
    let chunk = []Gate(0)
    let j = i
    while (j < end) {
      let (g, ok) = findGate(names[j])
      if (!ok) {
        eprint("make: step '${names[j]}' is not implemented yet\n")
        failed = append(failed, names[j])
      } else {
        chunk = append(chunk, g)
      }
      j = j + 1
    }
    for f of runGateChunk(chunk, sha, runId) {
      failed = append(failed, f)
    }
    i = end
  }
  return failed
}

// `./make fuzz [-- <seconds> [seed]]` — the open-ended run, as opposed to the
// `test-fuzz` gate's fixed 5s replay. The extra arguments are forwarded to
// `scripts/fuzz.sh` and only BIT_FUZZ_BIN is set, so the script stays the
// single definition of what fuzzing does.
fn stepFuzz(extras: []string): int {
  if (!gatePrereqsReady()) {
    return 1
  }
  // `bash`, not `sh`: fuzz.sh is `#!/usr/bin/env bash` and uses `[[ ]]` and
  // `pipefail`. Same call shape scripts/g2archive.sh gets in artifacts.bit.
  let script = "set -e\nBIT_FUZZ_BIN=" + shQuote(bitBin()) + "\nexport BIT_FUZZ_BIN\n" +
    "exec bash " + shQuote("${repoRoot()}/scripts/fuzz.sh")
  for a of extras {
    script = script + " " + shQuote(a)
  }
  script = script + "\n"
  return reportGate("fuzz", runShell("fuzz", script, gateTimeoutMs()))
}

fn indexOfByte(s: string, c: byte): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}
