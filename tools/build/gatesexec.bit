// How a `Gate{}` (gates.bit) actually runs: the single-gate path and the
// concurrent batch engine (#2434, #4706). Split out of gates.bit by #3442
// once that file crossed the repo's 800-line E0200 limit
// (spec/LINT.md:186) — pure move, no symbol below changed. Named
// `gatesexec.bit` rather than `gaterun.bit` so it sorts AFTER `gates.bit`
// (whose `Gate` class and `findGate` it calls) and still before `main.bit`
// (which calls `runGate`/`runGateBatch` here), so the inliner
// sees each callee already lowered (#1511). The two open-ended fuzz steps
// moved on to `gatesfuzz.bit` (#4706) for the same 800-line reason; that
// file sorts after this one and keeps the same callee-first rule.
//
// `scripts/gate-filemap.sh`'s `gates_for_file()` and `scripts/gate-diffclass.sh`'s
// `is_additive_registration()` grep `tools/build/gates.bit` BY NAME for
// `Gate{name:` entries and `runArgs(...)` calls — that file keeps its name and
// keeps every `Gate{}` record for exactly this reason; only the execution
// machinery that never appears in that grep moved here.

import { killTreeFnDef, pgrepPreflightScript } from "../killtree"

// A harness may run for minutes (`test-stress` is the corpus worst case), so
// the bound is generous. It exists at all because a hang is a failure, not a
// stall (#1637/#1652) — but each harness already carries its OWN per-child
// deadline, so this is only the outer backstop and must stay well above it.
fn gateTimeoutMs(): int {
  let s = envOr("BIT_MAKE_GATE_TIMEOUT_S", "5400")
  return parseIntOr(s, 5400) * 1000
}

// `osRunBounded`'s own ceiling (runtime/root/*/os.bit `osBoundedMaxMs`,
// runtime/ABI.md §19). Every bound this driver hands to `osRunBounded` —
// directly via `runShell`, or indirectly through the outer batch call in
// `batchOuterTimeoutMs()` — is silently clamped to this by the runtime, so
// this driver has to compute and report the SAME effective value rather
// than the number it asked for (#3706). There is no shared symbol to import
// across the compiler/runtime boundary (`osRunBounded` is a compiler
// primitive lowered straight to `bit_rt_os_run_bounded`, not an ordinary
// function this side could call into), so this mirrors the constant the way
// every other caller in the repo already does — e.g.
// _tests_/bit/golden/golden.bit's `maxTimeoutMs`, _tests_/bit/parsergate.bit's
// `maxTimeoutMs`.
const gateBoundedMaxMs: int = 6000000

// The bound actually in effect once the runtime's ceiling applies. This is
// the only number safe to print in a timeout message or compare against an
// observed wall clock — `requestedMs` alone is what the caller ASKED for,
// which `osRunBounded` may have silently reduced.
fn effectiveTimeoutMs(requestedMs: int): int {
  if (requestedMs > gateBoundedMaxMs) {
    return gateBoundedMaxMs
  }
  return requestedMs
}

// A loud, distinct line the moment a requested bound gets silently reduced
// by the runtime ceiling, printed right before the call that will be
// clamped (#3706) — so the reduction is visible up front instead of only
// inferable later from a timeout message that used to report the wrong
// number.
fn warnIfTimeoutReduced(label: string, requestedMs: int) {
  let eff = effectiveTimeoutMs(requestedMs)
  if (eff == requestedMs) {
    return
  }
  eprint("make: WARNING: ${label} requested a ${requestedMs / 1000}s bound, reduced to ${eff / 1000}s by osRunBounded's 100-minute ceiling (runtime/root/*/os.bit osBoundedMaxMs)\n")
}

fn parseIntOr(s: string, fallback: int): int {
  let n = 0
  let i = 0
  if (len(s) == 0) {
    return fallback
  }
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return fallback
    }
    n = n * 10 + (int(c) - 48)
    i = i + 1
  }
  return n
}

// THE INSTALL-ORDER HAZARD (#1229/#1644). Every gate reads `bit-out/bin/bit`
// and the host archive off disk, so both must be fully published before any of
// them starts. That is a per-RUN dependency edge — never on a shared parent,
// because a runner may then install and read concurrently, and
// a partially-written binary execs and SIGSEGVs with empty stderr.
//
// The driver runs steps sequentially in dependency order, so `selfhost` and
// `libbitrt` have already completed here. This is the assertion that they
// actually produced their outputs, which is the property the edge existed for.
fn gatePrereqsReady(): bool {
  if (!exists(bitBin())) {
    eprint("make: missing ${bitBin()} — run `./make selfhost` first\n")
    return false
  }
  if (!exists(hostArchive())) {
    eprint("make: missing ${hostArchive()} — run `./make libbitrt` first\n")
    return false
  }
  return true
}

// The env-export preamble plus the final `exec` line, shared by the single-
// gate path below and the concurrent batch unit further down — one
// definition of "how a Gate becomes a shell command" so the two paths cannot
// drift apart.
fn gateEnvExecScript(g: Gate): string {
  let script = ""
  for kv of g.env {
    let eq = indexOfByte(kv, '=')
    if (eq < 0) {
      continue
    }
    script = script + kv[:eq] + "=" + shQuote(kv[eq + 1:]) + "\nexport " + kv[:eq] + "\n"
  }
  // Passed through rather than set, so a slower host can widen every harness's
  // own internal deadline the documented way.
  let t = envOr("BIT_TEST_TIMEOUT_S", "")
  if (t != "") {
    script = script + "BIT_TEST_TIMEOUT_S=" + shQuote(t) + "\nexport BIT_TEST_TIMEOUT_S\n"
  }
  script = script + "exec " + shQuote(bitBin())
  for a of g.argv {
    script = script + " " + shQuote(a)
  }
  return script + "\n"
}

fn runGate(name: string): int {
  let (g, ok) = findGate(name)
  if (!ok) {
    eprint("make: step '${name}' is not implemented yet\n")
    return 1
  }
  if (!gatePrereqsReady()) {
    return 1
  }
  warnIfTimeoutReduced("gate '${name}'", gateTimeoutMs())
  let rc = runShell(name, "set -e\n" + gateEnvExecScript(g), effectiveTimeoutMs(gateTimeoutMs()))
  return reportGate(name, rc, gateTimeoutMs())
}

// A child killed by a signal is a CRASH, and must not read as a plain non-zero
// exit — the distinction is what tells a segfault apart from a harness that
// simply failed its assertions (#1637).
//
// TWO ENCODINGS, because there are two children. `osRunBounded` runs a /bin/sh
// wrapper and reports ITS fate in the runtime's encoding (ABI.md §19): -1 spawn
// failure, -2 timeout, <= -100 signal death with signo = -rc - 100. The harness
// itself is the wrapper's child, so when IT is killed `sh` survives and exits
// 128+signo in the ordinary shell convention. Both are crashes; reporting only
// one of them would let the common case — a segfaulting harness under an `exec`
// that the shell reports numerically — read as a failed assertion.
fn reportGate(name: string, rc: int, requestedMs: int): int {
  if (rc == 0 - 1) {
    eprint("make: ${name} could not be started (spawn/wait failed)\n")
    return 1
  }
  if (rc == 0 - 2) {
    eprint("make: ${name} TIMED OUT after ${effectiveTimeoutMs(requestedMs) / 1000}s — this is a hang, not a failed assertion\n")
    return 1
  }
  if (rc <= 0 - 100) {
    eprint("make: ${name} CRASHED — killed by signal ${0 - rc - 100}\n")
    return 1
  }
  if (rc > 128 && rc < 192) {
    eprint("make: ${name} CRASHED — killed by signal ${rc - 128}\n")
    return 1
  }
  if (rc != 0) {
    eprint("make: ${name} failed (exit ${rc})\n")
    return 1
  }
  return 0
}

// --- concurrent batch (#2434) ------------------------------------------------
//
// `main.bit`'s `runAll` hands a run of consecutive non-`exclusive` gate names
// here instead of calling `runGate` on each in turn. The parallelism lives
// entirely in the shell, not in Bit: `osRunBounded` (runtime/root/*/os.bit)
// polls with a raw, `@nosplit` `nanosleep` and never yields, so a spawned Bit
// green thread would never get scheduled until it returned — one gate at a
// time, exactly like today, just with extra machinery. See #2434's ticket for
// why `spawn` and a new runtime primitive were both ruled out.
//
// One composed script launches every gate backgrounded with its own private
// killer, each redirected to its own file under `batchDir()`, and `wait`s for
// all of them. How many run at once is bounded by the token FIFO
// (`poolPrologue`, #4706), not by cutting the list into chunks. Reporting
// happens back here, from those files, in the same `order` position the
// caller passed them in — never through a pipe, and never while two gates
// could still be racing to write the same fd.

fn isExclusiveGate(name: string): bool {
  let (g, ok) = findGate(name)
  return ok && g.exclusive
}

// Reused by every gate in one `./make` run: redirection truncates each
// gate's own file at launch, and no two gates in a batch share a name, so
// there is nothing to clean between them. Lives under the driver's existing
// scratch area (bit-out/make already holds the fp stamps and run-<name>.sh
// wrappers), not a fresh `mktemp -d` — that path would only be known inside
// the child shell, and the Bit code on this side of `runShell` is what has to
// read it back.
fn batchDir(): string { return "bit-out/make/gatebatch" }

// #3256. Every gate's rc file lives at ONE fixed path per worktree
// (`batchDir()`), so a killed or aborted run's rc file survives on disk and
// the next run cannot tell it apart from its own by looking at the path
// alone — the orphan is also NEWER than any earlier good write, so mtime
// cannot help either. `runGateBatch` calls this ONCE per invocation and
// threads the result through every gate it runs, so every rc file this
// process writes carries the same identity: the tree's HEAD sha (an orphan
// from a different commit is instantly recognisable) plus a fresh
// `fpRunId()` nonce (an orphan from an earlier run AT THE SAME sha —
// exactly the "killed then relaunched immediately" case that motivated this
// ticket — is recognisable too, since the nonce is derived from the wall and
// monotonic clocks at the moment of the call and cannot repeat across two
// separate invocations; #3538 replaced the original `std/crypto` random bytes
// with this dependency-free clock-mixed id — see tools/build/fphash.bit).
// `reportPoolVerdict` refuses to trust any rc file whose stamp does not match
// both fields exactly, including a pre-#3256 rc file with no stamp at all.
//
// #3485: the sha half is a nice-to-have, not a requirement — the nonce alone
// already makes every invocation's stamp unique (two calls to `fpRunId()`
// cannot land on the same clock reading in practice; that is the exact
// property the comment above already relies on for "an earlier run AT THE
// SAME sha"). So a tree with no
// HEAD to resolve — both hardware gates run the suite over
// `git archive HEAD | tar x`, which by design produces a tree with no `.git`
// at all — still gets a fully working stamp: real rc-file identity, every
// gate actually runs, PASS/FAIL is real. `noGitSha()` mirrors git's own
// all-zero null-OID convention (used e.g. in pre-receive hooks for "no such
// commit"), so a reader recognises it as "no real commit" on sight rather
// than a fabricated hash, and it stays plain hex — safe to embed unescaped
// in the generated shell script exactly like a real sha (`gateBatchUnit`).
// This used to return a third `stampOk` bool and `runGateBatch` marked every
// gate in the batch FAILED when it came back false, with no way for the
// final report to tell "this gate failed" apart from "the batch never ran"
// — silently true for every hardware-gate run since #3256 landed.
//
// #3523: `.out` is NOT stamped like `.rc`/`.timedout` above — it cannot be,
// since its bytes are the gate's own stdout+stderr and prepending a stamp
// line would pollute output a caller may be grepping verbatim. Instead
// `gateBatchUnit` puts `runId` directly in the `.out` FILENAME
// (`<name>.<runId>.out`), so a foreign writer (an orphaned subshell from a
// killed run, or a second concurrent `./make` in this worktree) resolves to
// a different path entirely and cannot overlay this run's bytes at the
// byte-offset level the way two independent `>` opens on one fixed path do.
fn noGitSha(): string { return "0000000000000000000000000000000000000000" }

fn currentGateStamp(): (string, string) {
  let outPath = "bit-out/make/gatebatch-headsha.out"
  let rc = runShell(
    "gatebatch-headsha",
    "git -C " + shQuote(repoRoot()) + " rev-parse HEAD > " + shQuote(outPath) + "\n",
    buildTimeoutMs(),
  )
  if (rc != 0) {
    eprint("make: cannot resolve HEAD sha for gate-batch stamping (git rev-parse HEAD exited ${rc}); running the batch anyway with a placeholder stamp\n")
    return noGitSha(), fpRunId()
  }
  let sha = trimNewline(readFile(outPath) catch "")
  if (sha == "") {
    eprint("make: git rev-parse HEAD produced no output; running the batch anyway with a placeholder stamp\n")
    return noGitSha(), fpRunId()
  }
  return sha, fpRunId()
}

// No new runtime primitive (#2152's lesson applies here too): core count
// comes from the shell, the same round-trip `hostTriple()` already uses.
// `nproc` covers Linux; `sysctl -n hw.ncpu` is the Darwin fallback.
fn numCPUs(): int {
  let outPath = "bit-out/make/ncpu"
  let script = "{ nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null; } > " +
    shQuote(outPath) +
    "\n"
  if (runShell("ncpu", script, buildTimeoutMs()) != 0) {
    return 1
  }
  let n = parseIntOr(trimNewline(readFile(outPath) catch ""), 0)
  if (n < 1) {
    return 1
  }
  return n
}

// Cores minus 2 (headroom for the OS and this driver itself), floor 1.
// BIT_MAKE_JOBS overrides directly; =1 is the escape hatch back to today's
// strict serial order and this ticket's own A/B control.
fn makeJobs(): int {
  let s = envOr("BIT_MAKE_JOBS", "")
  if (s == "") {
    let n = numCPUs() - 2
    if (n < 1) {
      return 1
    }
    return n
  }
  let n = parseIntOr(s, 1)
  if (n < 1) {
    return 1
  }
  return n
}

// `gateTimeoutMs()` bounds one `osRunBounded` call on the single-gate path;
// in a batch that call wraps the WHOLE script, so it would silently bound
// every gate in it by the slowest one's budget shared across all of them.
// Each gate instead gets its own killer inside the script (macOS ships no
// `timeout(1)`, hence `sleep`+`kill -9`), and this outer bound is a backstop
// only: it exists so a wedged SCRIPT — a lost pool token, a watchdog that
// never fires — fails loudly instead of hanging the driver.
//
// #4706 made it one backstop for the whole pooled batch rather than one per
// chunk of `makeJobs()`, so it is now the ceiling on the batch's total wall
// clock, not on one wave of it. That is 90 minutes by default against a
// measured whole-suite batch of ~5 minutes at 16 slots and ~40 at
// `BIT_MAKE_JOBS=1`; `BIT_MAKE_GATE_TIMEOUT_S` widens both this and every
// gate's own killer together, which is the documented knob for a host slow
// enough to need it.
fn batchOuterTimeoutMs(): int { return gateTimeoutMs() + 60000 }

// One gate's slot inside the batch: backgrounded so N of these overlap, each
// with its own deadline. The `.timedout` marker is written by the killer
// BEFORE it sends `kill -9`, strictly before `wait "$GPID"` in the same slot
// can observe the death — so reading it back afterward can never race, and it
// is what lets a per-gate timeout still read as "TIMED OUT" instead of
// "CRASHED — killed by signal 9" (`reportPoolVerdict` below).
//
// The killer subshell (`</dev/null >/dev/null 2>&1`) never inherits this
// slot's own stdio (#2514): without it, a caller piping `./make <gate>` puts
// its pipe's write end in the subshell's fd table, and a leaked descendant
// still holding that fd would block a read-until-EOF caller (`tail`,
// `$(...)`) long after the gate itself finished.
//
// #2563: the killer used to be one `sleep timeoutS; ...`. `kill "$KPID"` on
// the success path reaches only the killer subshell, not the `sleep` it
// forked — sh cannot exec-replace into `sleep` here because two more
// statements follow it, so the shell survives as the direct parent until
// `sleep` returns. A SIGTERM'd shell does not propagate to that child, so
// `sleep` reparented to pid 1 and ran out its own clock, up to `timeoutS`
// later — 269 measured orphaned in a single worktree. It now POLLS instead
// of sleeping once: `kill -0 "$GPID"` every second, so on the success path
// the loop itself notices `$GPID` is gone and exits within ~1s — normally
// before `kill "$KPID"` below even runs — and even a lost race leaves only a
// `sleep 1` behind, which finishes and exits on its own within that same
// ~1s rather than `timeoutS`. Each poll runs the renamed `sleep` binary
// `watchdogSetupScript` creates below, so a straggler is attributable
// (`pgrep -fl bit-gate-watchdog`) instead of showing as an anonymous
// `sleep 1` nobody can trace back here. The loop's own iteration count is
// bounded by `timeoutS` (Power of 10 rule 2) — the same deadline as before,
// just paid in one-second polls instead of one long wait.
//
// #3227: the poll used to be `( exec -a bit-gate-watchdog sleep 1 )`.
// `exec -a` (rename argv[0] before exec) is a bash/ksh extension; dash —
// Debian's `/bin/sh`, and therefore this project's own x64 gate image
// (`bit-linux-gate-amd64`, `FROM debian:bookworm`) — rejects `-a` outright,
// so the subshell errored out INSTANTLY instead of sleeping, `n` raced to
// `timeoutS` in a fraction of a real second, and the watchdog killed every
// gate almost immediately. `-a`'s only job was giving the poll's `sleep`
// process the argv[0] `pgrep -fl bit-gate-watchdog` above relies on — a
// symlink named `bit-gate-watchdog` pointing at the real `sleep` binary gets
// the identical argv[0] rename through a plain, extension-free `exec`
// (POSIX: argv[0] is whatever name you invoke, symlink or not), so both
// dash and bash now take the same code path with no shell-detection branch.
//
// #3066: `kill -9 "$GPID"` on the deadline branch only ever killed `$GPID`
// itself — a gate whose own command forks a subtree (`test-imports-bit`'s
// `find | xargs -P N` compile/run wave is the clearest case) left every
// live descendant running orphaned, bounded only by ITS OWN deadline rather
// than this gate's. `killtree()` (imported below, `../killtree`) walks
// `$GPID`'s descendants by PPID via `pgrep -P` and kills each one
// individually, instead of `kill`ing a process GROUP. Process groups were
// tried and rejected: giving `$GPID` its own group (`set -m`) is exactly
// what makes it unreachable from `batchOuterTimeoutMs()`'s runtime-level
// backstop, which kills by the single shared group `osForkExecWaitBounded`
// already put every descendant of THIS WHOLE SCRIPT into (`osKillGroup`,
// runtime/root/*/os.bit) — verified empirically: isolating `$GPID` into its
// own group left a live subtree unreached by a simulated outer group-kill.
// A PPID walk touches no process group at all, so it cannot narrow that
// backstop's reach. `killTreeFnDef`'s own comment (`tools/killtree/`) has
// the full walk-ordering rationale (why three passes, why snapshot before
// killing); it is shared verbatim by `_tests_/bit/importsrun/importsrun.bit` (#3238).
//
// `sha`/`runId` (from `currentGateStamp()`) are plain hex, so they are
// embedded directly into the generated `echo` line the same way `timeoutS`
// and `dir` already are — no shell metacharacters to escape.
fn gateBatchUnit(g: Gate, dir: string, timeoutS: string, sha: string, runId: string): string {
  let outFile = shQuote(dir + "/" + g.name + "." + runId + ".out")
  let rcFile = shQuote(dir + "/" + g.name + ".rc")
  let toFile = shQuote(dir + "/" + g.name + ".timedout")
  let durFile = shQuote(dir + "/" + g.name + ".dur")
  let wdPath = shQuote(watchdogPath(dir))
  return "(\n" +
    // #2562: wall-clock start, taken right before the gate's own exec is
    // backgrounded. macOS ships no `timeout(1)` (see the watchdog comment
    // above) and no monotonic-clock builtin reachable from `/bin/sh`, so
    // `date +%s` is the same primitive the watchdog's own poll already
    // relies on — one-second granularity, which is all `formatDuration`
    // ever prints.
    "START=$(date +%s)\n" +
    "(\n" +
    gateEnvExecScript(g) +
    ") > " +
    outFile +
    // `9<&-`: fd 9 is the pool's token FIFO (`poolPrologue`), owned by this
    // script and its unit subshells. The gate itself is arbitrary code that
    // has no business holding it — closing it here keeps a leaked
    // descendant of the harness out of the pool's own plumbing entirely,
    // the same reasoning #2514 applied to the killer subshell's stdio.
    " 2>&1 9<&- &\n" +
    "GPID=$!\n" +
    "( n=0; while kill -0 \"$GPID\" 2>/dev/null; do if [ \"$n\" -ge " +
    timeoutS +
    " ]; then echo \"" +
    sha +
    " " +
    runId +
    "\" > " +
    toFile +
    "; killtree \"$GPID\"; break; fi; " +
    wdPath +
    " 1 || sleep 1; n=$((n + 1)); done ) </dev/null >/dev/null 2>&1 9<&- &\n" +
    "KPID=$!\n" +
    "wait \"$GPID\"\n" +
    "RC=$?\n" +
    // #2562: stop right where the gate itself finished, before the
    // watchdog's own teardown — so a slow `kill`/`wait` on `$KPID` never
    // inflates this gate's own reported duration.
    "END=$(date +%s)\n" +
    "kill \"$KPID\" 2>/dev/null\n" +
    "wait \"$KPID\" 2>/dev/null\n" +
    // Written after `wait "$GPID"` and before the `.rc` write below, same
    // ordering the `.rc`/`.timedout` marker files already use. Not stamped
    // with sha/runId like those two: this file and `rcFile` are written
    // back-to-back, in order, by this one gate unit's own subshell, so
    // `.rc` reading back as fresh for THIS run (`reportPoolVerdict`'s
    // stamp check) already proves `.dur` was written by this same
    // invocation, moments earlier.
    "echo \"$((END - START))\" > " +
    durFile +
    "\n" +
    "echo \"$RC " +
    sha +
    " " +
    runId +
    "\" > " +
    rcFile +
    "\n" +
    // #4706: hand the slot back, LAST — strictly after this gate's `.rc` is
    // on disk, so the token means "this gate is fully reported", never
    // "this gate is nearly done". The dispatcher below blocks on a token
    // before it starts the next gate, so this single line is what bounds
    // the whole batch to `makeJobs()` gates at a time.
    //
    // A unit that is itself SIGKILLed never reaches here and its slot is
    // lost for the rest of the batch (the pool narrows; it cannot
    // deadlock unless every slot is lost, and `batchOuterTimeoutMs()` is
    // the backstop for that). The per-gate watchdog kills the GATE, not
    // this subshell, so a timing-out gate still releases normally.
    "echo t >&9\n" +
    ") &\n"
}

// Where the poll's renamed `sleep` symlink lives: one per batch dir, created
// once by `watchdogSetupScript`, read (never written) by every concurrent
// gate unit's poll.
fn watchdogPath(dir: string): string { return dir + "/bit-gate-watchdog" }

// #3227: creates the `bit-gate-watchdog` -> `sleep` symlink `gateBatchUnit`'s
// poll execs, so N concurrent gate units share one symlink instead of racing
// to create their own. Written once, before any unit's `&`-backgrounded
// subshell starts, so this line always finishes first — `batchScript` builds
// one literal top-to-bottom script, not concurrent text. `dir` already
// exists by the time this runs (`runGatePool` calls `ensureDir(dir)` before
// `runShell` executes this script). The `2>/dev/null` only swallows the
// vanishingly unlikely case where `sleep` itself is missing from `$PATH`;
// `gateBatchUnit`'s own `|| sleep 1` fallback keeps the poll correct (just
// unattributed) even then.
fn watchdogSetupScript(dir: string): string {
  return "ln -sf \"$(command -v sleep)\" " + shQuote(watchdogPath(dir)) + " 2>/dev/null\n"
}

// #3236: `killtree()`'s BFS loop (`kids=$(pgrep -P ... 2>/dev/null)`) cannot
// tell "pgrep is not installed" (exit 127) apart from "no descendants" (exit
// 1, also empty stdout) — both leave `kids` empty, so a host missing `pgrep`
// silently degrades every timed-out gate to killing only its own direct PID
// (#3230 was exactly this, on the linux gate image before it gained
// `procps`). A per-call check inside that BFS loop is the wrong shape — it
// is the hot path, run once per level of every gate's kill path, and must
// stay simple. This checks ONCE per batch script, before any gate unit
// starts — same placement and granularity as `watchdogSetupScript` above.
// `pgrepPreflightScript` (imported below, `../killtree`) is shared verbatim
// with `_tests_/bit/importsrun/importsrun.bit`'s own preflight (#3238); this call site's
// `"gate"`/`"the outer batch timeout"` arguments are the only thing that
// differs from that file's `"case"`/`"the outer run bound"`. The message
// goes to this script's own stderr, not any gate's redirected `.out` file,
// so it reaches the terminal immediately instead of waiting for that gate's
// turn in `runGatePool`'s report loop — and it fires once per batch, not
// deduped away, so it cannot scroll off during a long batch.

// #4706: the pool's semaphore. `runGateBatch` used to cut the names into
// consecutive chunks of `makeJobs()` and run one chunk after another, which
// made every chunk boundary a BARRIER: 94 gates summing 2555s of work took
// 16m50s on 16 slots, because a chunk holding the 280s `test-golden` left
// its other 15 slots idle for most of that. This is the same bounded pool
// `scripts/selfhost-diffall.sh` runs in bash (#3769), written for the
// `/bin/sh` this script actually gets: no arrays, no `wait -n` (bash 4.3+,
// and this Mac's /bin/sh is bash 3.2 while Debian's is dash).
//
// A FIFO holds one token per free slot. The dispatcher `read`s one — which
// BLOCKS until some running gate hands its slot back — immediately before
// starting the next gate, so a slot is refilled the moment any gate
// finishes rather than when the slowest of sixteen does. Opened read-write
// (`9<>`) so the pre-loading writes below cannot block on a missing reader,
// then unlinked at once: the open fd keeps it alive, and nothing is left on
// disk for the next run to inherit (the fixed-path staleness #3256 had to
// defend against for the rc files). The name still carries `runId` so two
// concurrent `./make` invocations in one worktree cannot collide in the
// window before the unlink.
fn poolPrologue(dir: string, runId: string, jobs: int): string {
  let fifo = shQuote(dir + "/pool." + runId + ".fifo")
  return "POOLFIFO=" +
    fifo +
    "\n" +
    "rm -f \"$POOLFIFO\"\n" +
    "mkfifo \"$POOLFIFO\" || { echo \"make: cannot create the gate pool FIFO $POOLFIFO\" >&2; exit 1; }\n" +
    "exec 9<>\"$POOLFIFO\"\n" +
    "rm -f \"$POOLFIFO\"\n" +
    "POOLN=0\n" +
    "while [ \"$POOLN\" -lt ${jobs} ]; do echo t >&9; POOLN=$((POOLN + 1)); done\n"
}

// One `osRunBounded`, one bounded pool, one `wait` — the whole batch.
// `killTreeFnDef`, the pgrep preflight and the watchdog symlink are written
// once; every gate unit's subshell inherits the function (a POSIX subshell
// inherits its parent's function definitions) and reads the same symlink
// path.
//
// `order` is the START order (longest-hinted first, `poolStartOrder`), which
// is deliberately NOT the report order: `runGatePool` reports in the
// caller's own order, so what the terminal shows does not depend on which
// gate happened to finish first.
fn batchScript(order: []Gate, dir: string, sha: string, runId: string, jobs: int): string {
  let timeoutS = "${gateTimeoutMs() / 1000}"
  let script = killTreeFnDef() +
    pgrepPreflightScript("gate", "the outer batch timeout") +
    watchdogSetupScript(dir) +
    poolPrologue(dir, runId, jobs)
  for g of order {
    // Blocks here, in the dispatcher, when every slot is busy. Straight-line
    // `read`/unit pairs rather than a loop over a name list: `/bin/sh` has no
    // arrays, and the emitted order is then exactly the order this Bit code
    // decided, visible in `bit-out/make/run-gatebatch.sh` as written.
    script = script + "read POOLTOK <&9\n" + gateBatchUnit(g, dir, timeoutS, sha, runId)
  }
  return script + "wait\nexec 9>&-\n"
}

// The two "could not even start the batch" paths below both fail every gate
// in `gates` by name, with no per-gate detail to add — pulled out so
// `runGatePool` states each precondition once instead of repeating the loop.
fn namesOf(gates: []Gate): []string {
  let names = []string(0)
  for g of gates {
    names = append(names, g.name)
  }
  return names
}

// The "no rc file" fallback for one gate slot (#3058). `batchScript` ends in
// a bare `wait`, so `outerRc` is 0 for every batch the outer backstop did not
// itself kill — it cannot carry an inner gate's failure. Only attribute it
// when it is itself non-zero (the outer backstop genuinely fired); a missing
// rc with a zero outerRc means the slot simply never reported, and that is a
// failure on its own, not a silent pass. Returns true when the gate counts
// as failed.
fn reportMissingRc(name: string, outerRc: int, boundMs: int): bool {
  if (outerRc != 0) {
    return reportGate(name, outerRc, boundMs) != 0
  }
  eprint("make: ${name} DID NOT REPORT — no rc file written\n")
  return true
}

// #3256: `rcPath` is a fixed path, so a killed run's rc file (or a
// pre-#3256 rc with no stamp at all) can still be sitting there. Trust it
// only when it carries THIS run's exact stamp — a mismatch or a missing
// stamp means "did not run", never "passed". #3259, follow-up to #3256: the
// `.timedout` marker is never removed on the non-timeout path either, so a
// gate that timed out once in an earlier run leaves it sitting there
// forever — same fixed-path staleness, same stamp check, and it is trusted
// only when it too carries THIS run's exact stamp; a missing or foreign
// stamp means "not this run's timeout" and the already-verified rc is the
// real verdict. Returns true when the gate counts as failed.
fn reportPoolVerdict(g: Gate, dir: string, sha: string, runId: string, rcPath: string): bool {
  let fields = split(trimNewline(readFile(rcPath) catch ""), " ")
  if (len(fields) != 3 || fields[1] != sha || fields[2] != runId) {
    eprint("make: ${g.name} rc is STALE — its stamp does not match this run (a killed or earlier run's leftover at the fixed path ${rcPath}); refusing to count it as a pass. Re-run: ./make ${g.name}\n")
    return true
  }
  let rc = parseIntOr(fields[0], 0 - 1)
  let toPath = "${dir}/${g.name}.timedout"
  if (exists(toPath)) {
    let toFields = split(trimNewline(readFile(toPath) catch ""), " ")
    if (len(toFields) == 2 && toFields[0] == sha && toFields[1] == runId) {
      rc = 0 - 2
    }
  }
  return reportGate(g.name, rc, gateTimeoutMs()) != 0
}

// #2562: reads back the `.dur` marker `gateBatchUnit` writes (whole seconds,
// wall clock) and prints an individually-measured `make: <name> — <dur>`
// line, in `formatDuration`'s own `XmYs` shape (`main.bit`) — the same
// format every other timing line in this driver uses, so a downstream
// consumer parses one shape regardless of which path produced it. Missing
// or unparsable is silent here, not an error: a gate that never reached
// that line in its own script already gets its failure named by
// `reportMissingRc`/`reportPoolVerdict` above, and this must not print a
// second, contradictory report for the same gate.
fn printGateDuration(name: string, durPath: string) {
  if (!exists(durPath)) {
    return
  }
  let secs = parseIntOr(trimNewline(readFile(durPath) catch ""), 0 - 1)
  if (secs < 0) {
    return
  }
  print("make: ${name} — ${formatDuration(secs * Second)}\n")
}

// Runs every gate in `gates` (none `exclusive`) through one bounded pool of
// `jobs` slots, and reports every one of them in `gates` position — so
// output never interleaves and a run's `make: FAILED:` line is deterministic
// regardless of which gate actually finished first. The START order is
// `poolStartOrder`'s, which is a different list on purpose.
fn runGatePool(gates: []Gate, sha: string, runId: string, jobs: int): []string {
  let failed = []string(0)
  if (len(gates) == 0) {
    return failed
  }
  if (!gatePrereqsReady()) {
    return namesOf(gates)
  }
  let dir = batchDir()
  if (!ensureDir(dir)) {
    eprint("make: cannot create ${dir}\n")
    return namesOf(gates)
  }
  warnIfTimeoutReduced(
    "gate batch (${len(gates)} gate(s), ${jobs} at a time)",
    batchOuterTimeoutMs(),
  )
  let outerRc = runShell(
    "gatebatch",
    batchScript(poolStartOrder(gates, jobs), dir, sha, runId, jobs),
    effectiveTimeoutMs(batchOuterTimeoutMs()),
  )
  for g of gates {
    print("make: ${g.name}\n")
    let rcPath = "${dir}/${g.name}.rc"
    print(readFile("${dir}/${g.name}.${runId}.out") catch "")
    let isFailed = false
    if (!exists(rcPath)) {
      isFailed = reportMissingRc(g.name, outerRc, batchOuterTimeoutMs())
    } else {
      isFailed = reportPoolVerdict(g, dir, sha, runId, rcPath)
    }
    printGateDuration(g.name, "${dir}/${g.name}.dur")
    if (isFailed) {
      failed = append(failed, g.name)
    }
  }
  return failed
}

// Runs `names` (all gates, none `exclusive`) as ONE pool, `makeJobs()` at a
// time. Before #4706 this cut them into consecutive chunks of `makeJobs()`
// and ran chunk after chunk, so every chunk waited for its slowest member
// before the next one started.
fn runGateBatch(names: []string): []string {
  let failed = []string(0)
  if (len(names) == 0) {
    return failed
  }
  // One stamp for the whole flush: every gate below writes rc files that
  // read back as belonging to THIS invocation (#3256). Always usable now
  // (#3485) — see `currentGateStamp`'s own comment for why a tree with no
  // resolvable HEAD no longer aborts the whole batch before a gate runs.
  let (sha, runId) = currentGateStamp()
  let gates = []Gate(0)
  for n of names {
    let (g, ok) = findGate(n)
    if (!ok) {
      eprint("make: step '${n}' is not implemented yet\n")
      failed = append(failed, n)
      continue
    }
    gates = append(gates, g)
  }
  for f of runGatePool(gates, sha, runId, makeJobs()) {
    failed = append(failed, f)
  }
  return failed
}

fn indexOfByte(s: string, c: byte): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}
