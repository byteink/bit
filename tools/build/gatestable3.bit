// The rest of the `test-*` gate table, `gateTableC/D/E()`, split out of
// gatestable2.bit when routine `Gate{}` additions took that file past the
// 800-line E0200 limit. A pure move: every entry below is unchanged, and
// `gateTable()` (gates.bit) concatenates A through E in that order, so the
// run order is the same. The scripts that grep this table by file name
// (gate-diffclass.sh, gate-envscope.sh, gate-bucketasserts.sh) list this
// file too; see gatestable2.bit's header for why that matters.

fn gateTableC(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    // #2357. Regression gate for the executable bit on tracked *.sh files —
    // see the header of _tests_/bit/shebangmode/shebangmode.bit for the full rationale and
    // the sourced-library exemption. BIT_REPO IS REQUIRED: unlike
    // test-spec/test-filesize above, which only resolve paths against the
    // tree under test, this harness shells out to `git -C` against the repo
    // root and must not silently default to ".".
    Gate{
      name = "test-shebang-mode", argv = runArgs("_tests_/bit/shebangmode"),
      env = [std, "BIT_REPO=${repoRoot()}"],
    },
    // #2949/#2956. Builds two near-identical programs with the compiler
    // under test (`bit build`, not `bit run`) to compare the linked
    // binaries and the object's own section headers, so BIT_STDLIB is
    // required the same way test-atomicwidth needs it.
    Gate{
      name = "test-globalsbss", argv = runArgs("_tests_/bit/globalsbss.bit"),
      env = [std],
    },
    // #3039. BIT_REPO IS REQUIRED, same reason as test-spec/test-filesize
    // above: the harness locates stdlib/, scripts/stage0.sh and its own
    // allowlist relative to it. See the harness header for why this is the
    // one gate in this table that can touch the network (only on a cold
    // `bit-out/stage0` cache; every later run is offline).
    Gate{
      name = "test-release-surface", argv = runArgs("_tests_/bit/releasesurface"),
      env = ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"],
    },
    // #2853. BIT_REPO IS REQUIRED, same reason as test-spec/test-filesize
    // above: the harness lists dist/'s own `.sh` files and reads
    // docker/toolchain.Dockerfile relative to it. No BIT_STDLIB: the
    // extracted programs use only predeclared builtins (print/println).
    Gate{
      name = "test-synth-smoke", argv = runArgs("_tests_/bit/synthsmoke.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", "BIT_REPO=${repoRoot()}"],
    },
    // #2274. Lives here rather than _tests_/cases (single golden file, stdout
    // only) for the same reason test-clicmd does: the property is argv in /
    // wall-clock + exit code + a live-process check out. The hung fixture
    // this harness runs is written to a scratch directory at run time, never
    // committed — a permanently-hanging source file under _tests_/ would hang
    // any harness that walks every directory (_tests_/bit/stress/, `bit test`'s
    // own recursive walk at a project root).
    Gate{
      name = "test-timeout", argv = runArgs("_tests_/bit/testtimeout"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
    // #3653 (2448-fallout). Builds and execs a stdlib entry point's fixture
    // at N and 2N calls (BIT_GC_STATS=1) and asserts the marginal
    // swept+live slope is exactly the row's declared objects/call —
    // #3637/#3617's class-as-multiple-return-vehicle regression class. Not
    // exclusive: object counts are exactly deterministic, never load-
    // sensitive (see _tests_/bit/benchgate/baselines.bit's `objects` field).
    Gate{
      name = "test-alloc-slope", argv = runArgs("_tests_/bit/allocslope.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
  ]
}

fn gateTableD(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    // #4408. Pins GC RETENTION — the `swept=`/`live=` SPLIT of a
    // BIT_GC_STATS=1 exit summary — where test-alloc-slope above and
    // test-benchgate's `objects` field both pin only the TOTAL, `swept+live`.
    // The distinction is the whole gate: across #4402's two builds
    // `swept+live` was identical (5,400,062) while the split moved by 941,761
    // objects, so a total-allocation pin is structurally blind to the 22%
    // `live` / 79% `swept` move that every differential, golden, stress and
    // benchgate arm passed through.
    // Not exclusive, for the reason test-alloc-slope above is not: the
    // counters are exactly deterministic and NOT load-sensitive — measured
    // byte-identical 7/7 on each bench case and 5/5 on each owned fixture at
    // load average 67 on 18 cores, in the same runs where `collections`
    // itself varied (sort read 4,4,5,5,5) and `peakbytes` did not repeat.
    // BIT_BENCH_DIR points it at bench/cases rather than letting it default,
    // matching test-benchgate above; the harness FAILS when it is unset.
    Gate{
      name = "test-gc-retention", argv = runArgs("_tests_/bit/gcretention"),
      env = [std, "BIT_BENCH_DIR=${repoRoot()}/bench/cases", "BIT_SELF_EXE=${bitBin()}"],
    },
    // #4232. Hard-zero 800-line ceiling over every scripts/**/*.sh and
    // dist/**/*.sh file — no gate covered shell file size at all before
    // this (E0200 only reaches .bit files). No grandfather list, unlike
    // test-filesize above: every file is checked independently against the
    // limit, so there is nothing to seed. `BIT_REPO` so the harness
    // resolves scripts/ and dist/ against the tree under test.
    // #4724 widened the same walk (not the name, which nine scripts and
    // defs.bit cross-reference): every shell file calling the sourced-only
    // `diffexit`/`diffrequire` must also source scripts/diffexit.sh, since a
    // caller that does not gets `command not found` on stderr and CARRIES ON,
    // scoring a differential with its exit-2 refusal gone. Still one Gate row
    // and one argv — the second check reads the same bytes.
    Gate{
      name = "test-shellsize", argv = runArgs("_tests_/bit/shellsize.bit"),
      env = ["BIT_REPO=${repoRoot()}"],
    },
    // #4262. BIT_REPO IS REQUIRED, same reason as test-shellsize above: the
    // harness locates stdlib/ and bit-out/lib/<target>/libbitrt.a relative
    // to it and must not silently default to ".". No BIT_STDLIB: this
    // harness only reads raw file bytes (std/fs, std/os, std/strings) and
    // never builds or runs anything under stdlib/.
    Gate{
      name = "test-extern-archive", argv = runArgs("_tests_/bit/externarchive"),
      env = ["BIT_REPO=${repoRoot()}"],
    },
    // #5763: `_tests_/bit/genericparamscope.bit` (#5701, epic #4602) had no
    // Gate{} entry at all, so it never ran in the suite. Driven against the
    // CLI directly, like test-classkeyword/test-typenodecallee above, since
    // it exercises a NOT-last generic's own type-parameter substitution —
    // not suited to _tests_/cases/ for the same reason those harnesses give.
    // Only `std` in env, like test-selfbin above: the harness resolves the
    // compiler itself via `BIT_SELF_EXE`, falling back to the repo-root-
    // relative `bit-out/bin/bit` candidate when unset.
    Gate{
      name = "test-genericparamscope", argv = runArgs("_tests_/bit/genericparamscope.bit"),
      env = [std],
    },
    // #5790: the Darwin capture race (pipe()+FD_CLOEXEC against a concurrent
    // fork). Darwin-only: it imports runtime/root/darwin directly, so `bit
    // check` itself fails on any other host (E0078, the darwin externs are
    // absent from a non-Darwin runtime archive by design) — #5879 found this
    // failing `./make test` via x64gate.sh's real x86_64 Linux hardware,
    // since the Gate{} carried no host guard at all. `darwinOnly` makes
    // `gateEnvExecScript` (gatesexec.bit) SKIP+exit 0 before `bit` is
    // invoked, on any host `uname -s` does not report as Darwin.
    // `excludeReason` (defs.bit's coreSteps(), not gateSteps()) additionally
    // keeps it out of the default `test` bucket, same shape as
    // test-windows-smoke above: it can still only prove anything new run
    // directly on a Darwin host, via `./make test-osruncap-race`.
    Gate{
      name = "test-osruncap-race", argv = runArgs("_tests_/bit/osruncapraceseamdarwin.bit"),
      env = [std], darwinOnly = true,
      excludeReason = "arch-specific: imports runtime/root/darwin directly, so `bit check` fails outright on any non-Darwin host (this file's own comment above); run via ./make test-osruncap-race on a Darwin host, or STEP=test-osruncap-race x64gate.sh/arm64gate.sh, which SKIP cleanly",
    },
  ]
}

fn gateTableE(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    // #5793: openBeneath under a live parent-swap race. BIT_WORKERS=4 is
    // required: at the default of 1 the swapper never interleaves with the
    // opens, and the harness refuses that as a vacuous pass.
    Gate{
      name = "test-openbeneath", argv = runArgs("_tests_/bit/openbeneath"),
      env = [std, "BIT_WORKERS=4"],
    },
    // #5798: pkg/web static serving under the same live parent-swap race,
    // through `app.handle`. Same BIT_WORKERS=4 requirement as above.
    Gate{
      name = "test-staticbeneath", argv = runArgs("_tests_/bit/staticbeneath"),
      env = [std, "BIT_WORKERS=4"],
    },
    // #5800: `std/fs/secure`'s `walkBeneath` under the same live parent-swap
    // race `openBeneath` above closes for a single file open — this one is
    // `std/fs`'s `walk`'s OTHER TOCTOU (`isRealDir(p)` then `readDir(p)` BY
    // PATH). Same BIT_WORKERS=4 requirement.
    Gate{
      name = "test-walkbeneath", argv = runArgs("_tests_/bit/walkbeneath"),
      env = [std, "BIT_WORKERS=4"],
    },
    // #5816: `std/fs/secure`'s `removeAll` under the same live parent-swap
    // race `walkBeneath` above closes for reading a tree -- this one is a
    // hand-written recursive DELETE's TOCTOU (the CVE-2022-21658 shape: a
    // directory swapped for a symlink between the check and the `readDir`/
    // `remove` is followed and deletes outside the tree). Same
    // BIT_WORKERS=4 requirement.
    Gate{
      name = "test-removeallbeneath", argv = runArgs("_tests_/bit/removeallbeneath"),
      env = [std, "BIT_WORKERS=4"],
    },
    // #6021 (epic #6013): provisions redis:8.10.2 in a throwaway Docker
    // container (plain + TLS) and runs pkg/redis/client.live.test.bit
    // against it — see _tests_/bit/redislive.bit's own header for the image
    // pin, the without-Docker failure, and what "always removes the
    // containers" covers. BIT_REPO IS REQUIRED, same reason as
    // test-packages/packagesgate.bit: the harness points at
    // ${BIT_REPO}/pkg/redis and must not silently default to ".".
    // excludeReason (defs.bit's redisLiveSteps(), not gateSteps()) keeps
    // this out of the default `test` bucket: unlike every other gate here,
    // it depends on an external Docker daemon, not just this tree.
    Gate{
      name = "test-package-redis-live", argv = runArgs("_tests_/bit/redislive.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", packageWorkers()],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-package-redis-live",
    },
  ]
}

// Split from gateTableE (#6082): that function would otherwise pass
// spec/LINT.md's 80-line ceiling. `gates.bit`'s `gateTable()` unions this
// exactly like every other gateTableX.
fn gateTableF(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    // #6062 (epic #6061): provisions postgres:18.6 in a throwaway Docker
    // container and runs pkg/web/guides/inkwell/app.test.bit against it —
    // see _tests_/bit/webguidesapp.bit's own header for the image pin, the
    // without-Docker failure, and what "always removes the container" covers.
    // BIT_REPO IS REQUIRED, same reason as test-package-redis-live above:
    // the harness points at ${BIT_REPO}/pkg/web/guides/inkwell and must not
    // silently default to ".". excludeReason (defs.bit's
    // webGuidesAppSteps(), not gateSteps()) keeps this out of the default
    // `test` bucket for the identical Docker-dependency reason.
    Gate{
      name = "test-web-guides-app", argv = runArgs("_tests_/bit/webguidesapp.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}"],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-web-guides-app",
    },
    // #6082 (epic #4023), #7320: provisions postgres:18.6 and mysql:8.4 in
    // throwaway Docker containers and runs pkg/jobs's live proof against both — see
    // _tests_/bit/jobslive.bit's own header for the image pin, the
    // without-Docker failure, what "always removes the container" covers, and
    // the generated scratch project a `bit.lock` resolves "jobs"/"postgres"/"mysql"
    // against. BIT_REPO IS REQUIRED, same reason as test-package-redis-live
    // above. excludeReason (defs.bit's jobsLiveSteps(), not gateSteps())
    // keeps this out of the default `test` bucket for the identical
    // Docker-dependency reason.
    Gate{
      name = "test-package-jobs-live", argv = runArgs("_tests_/bit/jobslive.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", packageWorkers()],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-package-jobs-live",
    },
    // #6356: provisions postgres:18.6 in a throwaway Docker container and runs
    // `bit test docs/book/ink` with INK_TEST_LIVE_PG_URI set, so the Book's
    // SqlStore test runs (test-book-ink, gates.bit, runs it without a
    // database and skips it). Fails without Docker — see
    // _tests_/bit/bookinklive.bit's own header. BIT_REPO IS REQUIRED, same
    // reason as test-package-redis-live above. excludeReason (defs.bit's
    // bookInkLiveSteps(), not gateSteps()) keeps this out of the default
    // `test` bucket for the identical Docker-dependency reason.
    Gate{
      name = "test-book-ink-live", argv = runArgs("_tests_/bit/bookinklive.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}"],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-book-ink-live",
    },
    // #6397: relation-proof matrix. Provisions postgres:18.6 in a throwaway
    // Docker container (one database, tables per cell) and, for every relation
    // x row source x flow in _tests_/bit/relshapes/cells.bit, checks the
    // generated program: it must either fail E0300 with a hint that fixes it
    // or build and print the loaded relation; the runtime panic is the oracle.
    // Fails without Docker, see the harness header. BIT_REPO IS REQUIRED, same
    // reason as test-package-redis-live above. excludeReason (defs.bit's
    // relShapesLiveSteps(), not gateSteps()) keeps this out of the default
    // `test` bucket for the identical Docker-dependency reason.
    Gate{
      name = "test-relation-shapes", argv = runArgs("_tests_/bit/relshapes"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}"],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-relation-shapes",
    },
  ]
}

// Split from gateTableF (#6414): #6394 and #6397 each added one gate there,
// green alone, and together took it past spec/LINT.md's 80-line ceiling.
// `gateTable()` (gates.bit) unions this right after F, so the run order is
// unchanged.
fn gateTableG(): []Gate {
  let std = "BIT_STDLIB=${stdlibRoot()}"
  return [
    // #6091/#6099: `static fn` class methods (SPEC §10.4.1), driven against
    // the CLI directly like test-baremaplit (gatestable2.bit) above — see
    // the harness header for why that surface reddens selfhost-difftypes.sh
    // and cannot use checkerdiag.bit's fixed-environment `bit check` corpus.
    Gate{
      name = "test-staticmethods", argv = runArgs("_tests_/bit/staticmethods.bit"),
      env = [std, "BIT_BIN=${bitBin()}", "BIT_LIBBITRT=${hostArchive()}"],
    },
    // #6372. `bit check` exits 0 on a warning, so nothing failed on the 16
    // E0098/E0048 warnings main carried. Checks every tracked `.bit` module
    // the tree compiles itself (2045 of 3233 files on f62b89949, the rest
    // being named fixture corpora) and fails on any `warning[` line; the file
    // set, the exclusions and the eight exempt units are in the harness header.
    // BIT_REPO IS REQUIRED: the file list comes from `git ls-files` there, and
    // a "." default would resolve against $TMPDIR. BIT_SELF_EXE is the dev
    // compiler under test, like every sibling lint gate.
    Gate{
      name = "test-no-warnings", argv = runArgs("_tests_/bit/nowarnings.bit"),
      env = ["BIT_SELF_EXE=${bitBin()}", std, "BIT_REPO=${repoRoot()}"],
    },
    // #6394. The call-shape matrix: for every receiver form x callee kind x
    // argument shape the harness generates one program into $TMPDIR and asks
    // `bit check` and `bit build`; a program check accepts and build cannot emit
    // fails the gate naming the cell. Cells that still disagree are on the
    // known-failure list (_tests_/bit/callshapes/known.bit), asserted both ways.
    // BIT_SELF_EXE is the dev compiler under test.
    Gate{
      name = "test-call-shapes", argv = runArgs("_tests_/bit/callshapes"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
    // #6417. The formatter's precedence matrix: for every expression slot x form x
    // parenthesized-or-not x operand width the harness formats a generated
    // function and demands the same `--dump-ast` and a one-pass fixpoint, naming
    // the cell. Cells that still disagree are on _tests_/bit/fmtprecmatrix/known.bit,
    // asserted both ways. BIT_SELF_EXE is the dev compiler under test.
    Gate{
      name = "test-fmt-prec-matrix", argv = runArgs("_tests_/bit/fmtprecmatrix"),
      env = ["BIT_SELF_EXE=${bitBin()}", std],
    },
    // #7396. The compiler's output must not depend on the per-process map hash
    // seed (#7379): `bit check`, `--dump-ir`, `--dump-types` and `--dump-diags`
    // over _tests_/bit/checkercases and _tests_/cases, run under BIT_SEEDS (default
    // three), must be byte-identical. BIT_BIN is the dev compiler under test.
    Gate{
      name = "test-hashseed", argv = runArgs("_tests_/bit/hashseed.bit"),
      env = [
        std, "BIT_BIN=${bitBin()}", "BIT_CASES_DIR=${repoRoot()}/_tests_/cases",
        "BIT_CHECKER_CASES_DIR=${repoRoot()}/_tests_/bit/checkercases",
      ],
    },
    // #6929 (epic #6855): provisions three Mailpit containers (plain,
    // STARTTLS-required, implicit TLS) and runs pkg/mail/smoke.live.test.bit
    // against them, including the first proof that pkg/mail's open() completes
    // a STARTTLS upgrade. See _tests_/bit/maillive.bit's header for the image
    // pin, the without-Docker failure and the cleanup. BIT_REPO IS REQUIRED,
    // same reason as test-package-redis-live. excludeReason (defs.bit's
    // mailLiveSteps(), not gateSteps()) keeps this out of the default `test`
    // bucket for the identical Docker-dependency reason.
    Gate{
      name = "test-package-mail-live", argv = runArgs("_tests_/bit/maillive.bit"),
      env = [std, "BIT_REPO=${repoRoot()}", "BIT_BIN=${bitBin()}", packageWorkers()],
      excludeReason = "environment-scoped: needs a Docker daemon, which no other gate in this table depends on; run via ./make test-package-mail-live",
    },
  ]
}
