// The pre-push suite drains completely before differential compiler checks.
// Suite gates may each start their own CPU-sized process pool, so counting
// gate wrappers does not bound native work. Sharing those pools with the
// checker's fixed wall alarm can prevent an otherwise valid comparison.
// Keep suite fan-out, held-gate isolation and differential width unchanged;
// the phase boundary removes only their overlap (#8237).

// The gates #4711 named: not `exclusive: true` today, but each adjudicates
// on a hardcoded wall clock that `BIT_TEST_TIMEOUT_S` cannot widen, and all
// three reddened at 16 pool slots on #4706's own measurement. Held out here
// for that measured reason; the day they read the knob, delete the row.
// Kept as a list rather than folded into `exclusive` because that field
// means "this gate's own assertion is load-sensitive", which is a claim
// about the harness, and #4711 is the ticket that owes those three the fix.
fn prepushHeldExtraNames(): []string {
  return ["test-osenv", "test-fsblock", "test-pmaddgit"]
}

fn prepushDifferentialsName(): string { return "test-differentials" }

fn hasName(names: []string, want: string): bool {
  for n of names {
    if (n == want) {
      return true
    }
  }
  return false
}

fn concatNames(a: []string, b: []string): []string {
  let out = []string(0)
  for x of a {
    out = append(out, x)
  }
  for x of b {
    out = append(out, x)
  }
  return out
}

// True when `name` must not run inside the overlap. Asked of the `Gate{}`
// record in the invocation's snapshot rather than another list, so a
// gate that gains `exclusive: true` tomorrow is held out here without
// anyone remembering this file exists.
fn prepushHeldOut(table: []Gate, name: string): bool {
  let (g, ok) = findGateIn(table, name)
  return (ok && g.exclusive) || hasName(prepushHeldExtraNames(), name)
}

// `gateNames()` split into (overlap, held), in `gateNames()` order on both
// sides so the report order stays a deterministic function of the registry.
fn prepushSplit(table: []Gate): ([]string, []string) {
  let overlap = []string(0)
  let held = []string(0)
  for n of gateNames() {
    if (prepushHeldOut(table, n)) {
      held = append(held, n)
      continue
    }
    overlap = append(overlap, n)
  }
  return overlap, held
}

// Retain the differential family's established width. This counts constituent
// wrappers, not native compiler processes; the suite has already drained.
fn prepushDiffallJobs(jobs: int): int {
  let n = numCPUs() - jobs - 1
  if (n < 1) {
    return 1
  }
  return n
}

// The differentials as one member of the pool, carrying the `DIFFALL_JOBS`
// bound above. The env array is COPIED rather than appended to in place: the
// `Gate` came out of `gateTable()`, this function does not own its arrays,
// and growing one in place is how a caller's data silently changes under it.
fn prepushDiffGate(table: []Gate, jobs: int): (Gate, bool) {
  let (g, ok) = findGateIn(table, prepushDifferentialsName())
  if (!ok) {
    eprint("make: no Gate{} record for '${prepushDifferentialsName()}' — cannot run the pre-push gate\n")
    return g, false
  }
  let env = []string(0)
  for e of g.env {
    env = append(env, e)
  }
  env = append(env, "DIFFALL_JOBS=${prepushDiffallJobs(jobs)}")
  return Gate{ name = g.name, argv = g.argv, env = env, exclusive = g.exclusive }, true
}

// Resolve every suite gate before starting work. Missing registry members
// refuse the whole step rather than silently dropping part of its coverage.
fn prepushSuiteGates(table: []Gate, names: []string): ([]Gate, bool) {
  let out = []Gate(0)
  for n of names {
    let (g, gok) = findGateIn(table, n)
    if (!gok) {
      eprint("make: step '${n}' is not implemented yet — refusing to run the pre-push gate\n")
      return out, false
    }
    out = append(out, g)
  }
  return out, true
}

// One held gate, run alone once the pool has drained. Deliberately not
// `runStepNow` (main.bit): that function also owns the artifact/gate stop
// policy and the `up to date` short-circuit, neither of which applies to a
// name this file has already proved is a gate. The printed shape is the
// same, so a downstream consumer parses one format either way.
fn runHeldGate(name: string): bool {
  print("make: ${name}\n")
  let start = monotonic()
  let rc = runGate(name)
  print("make: ${name} — ${formatDuration(since(start))}\n")
  return rc != 0
}

fn prepushSuiteReport(total: int, failed: []string) {
  if (len(failed) == 0) {
    print("make: test-prepush suite: ${total} gate(s), 0 failed\n")
    return
  }
  print("make: test-prepush suite: ${total} gate(s), ${len(failed)} FAILED: ${join(failed, " ")}\n")
}

fn prepushDiffReport(failed: bool) {
  if (failed) {
    print("make: test-prepush differentials: FAILED — ${prepushDifferentialsName()}\n")
    return
  }
  print("make: test-prepush differentials: 1 gate, 0 failed\n")
}

// Runs the held gates one at a time and names the ones that failed.
fn runHeldGates(names: []string): []string {
  let failed = []string(0)
  for h of names {
    if (runHeldGate(h)) {
      failed = append(failed, h)
    }
  }
  return failed
}

fn stepPrepush(): int {
  let table = gateTable()
  let (suiteNames, heldNames) = prepushSplit(table)
  let jobs = makeJobs()
  let (gates, suiteOk) = prepushSuiteGates(table, suiteNames)
  let (_, heldOk) = prepushSuiteGates(table, heldNames)
  let (diff, diffOk) = prepushDiffGate(table, jobs)
  if (!suiteOk || !heldOk || !diffOk) {
    return 1
  }
  print("make: test-prepush — ${len(suiteNames)} suite gate(s) at ${jobs} at a time, then ${len(heldNames)} wall-clock-sensitive gate(s) one at a time; after the suite drains, ${prepushDifferentialsName()} at DIFFALL_JOBS=${prepushDiffallJobs(jobs)}\n")
  let (sha, runId) = currentGateStamp()
  let suiteFailed = runGatePool(gates, sha, runId, jobs)
  let heldFailed = runHeldGates(heldNames)
  let allSuite = concatNames(suiteFailed, heldFailed)
  let (diffSha, diffRunId) = currentGateStamp()
  let diffFailed = len(runGatePool([diff], diffSha, diffRunId, 1)) != 0
  prepushSuiteReport(len(suiteNames) + len(heldNames), allSuite)
  prepushDiffReport(diffFailed)
  if (diffFailed || len(allSuite) != 0) {
    return 1
  }
  return 0
}
