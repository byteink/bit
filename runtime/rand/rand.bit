// Portable half of the Stage-2 port of runtime/rand/ (#1368): the
// optimizer-proof buffer wipe. Both source trees exist during the port; #1369
//
// WHY THIS MODULE IS SPLIT FOUR WAYS. A single file would pick
// its entropy source with a `switch (builtin.os.tag)` at comptime. Bit has no
// arch- or OS-conditional compilation, and the three entropy sources need
// primitives that are mutually exclusive *per target*: Darwin's needs
// `extern function` (§11.7), which is rejected outright when targeting Linux
// (E0078); Linux's needs `syscall` (§11.8), which is rejected when targeting
// Darwin or Windows; and Windows' needs `extern function` bound to a DLL
// Linux and Darwin don't admit. A single module containing all three fails to
// compile for every target but the one it happens to match — verified for the
// Linux/Darwin pair, not assumed. Sibling `.bit` files are one module, so the
// split has to be by directory:
//
//   runtime/rand/rand.bit           this file — portable, no OS primitive
//   runtime/rand/linux/entropy.bit  getrandom(2) + the /dev/urandom fallback
//   runtime/rand/darwin/entropy.bit arc4random_buf(3)
//   runtime/rand/windows/entropy.bit BCryptGenRandom (bcrypt.dll)
//
// A consumer imports this module plus exactly one of the three platform
// modules. That per-target selection is the build's job, and is what
// `builtin.os.tag` was doing before the split.
//
// WINDOWS (#3338, epic #3322) IS WRITTEN BUT NOT YET RUNNABLE. Bit's compiler
// recognises exactly three CLI-buildable targets — x86_64-linux, aarch64-linux
// and aarch64-macos (`compiler/build.bit`'s `refuseWindowsTarget()`, pending
// #3349) — so `runtime/rand/windows/entropy.bit` compiles (`bit check`) but
// cannot be linked into a runnable x86_64-windows binary yet, and there is no
// `libbitrt-x86_64-windows.a` to link it into either (#3341). It is
// compile-checked only until both land; ABI.md §21 records the same caveat.
//
// BUFFERS ARE RAW POINTERS, NOT SLICES. A slice would be a pointer to packed
// bytes. A Bit slice stores one 8-byte word per element, so `ptrOf` on a
// `[]u8` does not address packed bytes (§11.8), and `[]u8` cannot name the
// region this code actually fills: the payload of an `RtBytes` (ABI.md §21),
// which is packed. So the port takes a raw `*u8` and a byte count. This is a
// required deviation, not a preference — there is no Bit type that names a
// packed byte region.

// Zeroes the `n` packed bytes at `p`, then issues a compiler barrier so the
// writes cannot be elided.
//
// A plain clearing loop may be dropped entirely by dead-store elimination once
// the optimizer proves the buffer is never read afterwards — the classic way a
// "cleared" key survives in memory. The barrier declares memory clobbered,
// which forbids that. This backs `bit_rt_secure_zero` (ABI.md §21), for wiping
// key material.
//
// The zeroes could be written with a memset and the barrier with
// `asm volatile ("" ::: .{ .memory = true })`. Bit has no `@memset`, so the
// loop is explicit; the barrier is the same construct — an `asm` block (§11.6)
// with an empty instruction payload on both architectures and `memory` in the
// clobber list. Empty payload is the point: it emits no instruction at all and
// exists purely to constrain the optimizer.
//
// `@nosplit` (#1667). The claim this file used to make — "`@nosplit` rejects
// `asm` (E0075, §10.3)" — is false as of §10.3.1, which admits `asm` precisely
// because its payload is emitted inline verbatim and so can neither allocate nor
// reach a safepoint (_tests_/cases/run_nosplit_asm_arch.bit pins the nesting).
//
// The annotation is REQUIRED, not tidy. `p` is an interior pointer into a
// GC-managed `[]byte`'s backing (`rtSecureZero` derives it from a slice header),
// and this loop's back edge would otherwise carry `bl bit_rt_safepoint`. Nothing
// on the stack names the owning object at that poll — the runtime holds it only
// as a raw address, which E0079 forces — so a collection there sweeps the buffer
// out from under the wipe (#1656). A key wipe that runs against recycled memory
// is the worst possible form of this bug: it reports success having cleared
// someone else's block while the key survives.
export @nosplit fn secureZero(p: *u8, n: int) {
  let i = 0
  while (i < n) { // bounded by `n`; the body always advances `i`
    let q = p + i
    *q = u8(0)
    i = i + 1
  }
  asm volatile {
    x64 { }
    arm64 { }
    clobber x64 { memory }
    clobber arm64 { memory }
  }
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §21) — `bit_rt_secure_zero`
// ---------------------------------------------------------------------------
//
// PIN CARRIES THE BARE ABI NAME, for the reason every other ported pin does:
// G2 (#1583) dropped the `_root` infix, so this IS the real `bit_rt_secure_zero`
// symbol every caller links.
//
// `loadWord` is `runtime/gc`'s pinned raw-memory glue and the three `slc*`
// offsets are `runtime/root`'s object-layout constants (ABI.md §2) — both
// cross-module references resolve to pinned symbols / compile-time constants,
// never to an unpinned mangled name.
import { loadWord } from "../gc"
import { slcBuf, slcLen, slcOff } from "../root"

// `bit_rt_secure_zero` (ABI.md §21): wipe a `[]byte`'s `len` PACKED bytes to
// zero with a barrier the optimizer cannot elide — `std/crypto` clears key
// material through it (`stdlib/crypto/subtle.bit`'s `secureZero(b: []byte)`
// is the only caller anywhere in this tree, and ABI.md §21 documents the
// contract as `[]byte`-specific).
//
// THE WIPE IS `len` PACKED BYTES, NOT `len * 8` (#3121/#3226): a `[]byte` is
// the packed, 1-byte-per-element case (ABI.md §2), so the region the slice
// views is the BYTE range `buf[off .. off+len]` starting at `buf + off`.
// Wiping `len * 8` bytes — the pre-#3226 formula, correct back when every
// slice was word-per-element — would now zero 7 bytes of ADJACENT heap past
// the buffer's end for every logical byte it holds: a silent
// memory-corruption bug in code whose entire job is wiping key material
// safely (epic #2941's reviewer note; mutation-tested, see
// `_tests_/bit/rootabi`).
//
// A NULL header views no bytes and returns early (#1564) — a zeroed class's
// slice field is the null word, not an empty slice, and dereferencing it faults.
//
// `@nosplit` (#1667): `buf` is a live GC object held here only as a raw `int`,
// which the ABI boundary forces (E0079). See `secureZero` above.
export @nosplit @symbol("bit_rt_secure_zero") fn rtSecureZero(h: int) {
  if (h == 0) {
    return
  }
  let buf = loadWord(h + slcBuf)
  let off = loadWord(h + slcOff)
  let n = loadWord(h + slcLen)
  let nilb: *u8 = nil
  let p = nilb + (buf + off)
  secureZero(p, n)
}
