// Portable half of the Stage-2 port of runtime/rand.zig (#1368): the
// optimizer-proof buffer wipe. Both source trees exist during the port; #1369
// retires the Zig original, and #1400 swaps the Bit source into libbitrt.a.
//
// WHY THIS MODULE IS SPLIT THREE WAYS. The Zig original is one file that picks
// its entropy source with a `switch (builtin.os.tag)` at comptime. Bit has no
// arch- or OS-conditional compilation, and the two entropy sources need
// primitives that are mutually exclusive *per target*: Darwin's needs
// `extern function` (§11.7), which is rejected outright when targeting Linux
// (E0078), and Linux's needs `syscall` (§11.8), which is rejected when
// targeting Darwin. A single module containing both fails to compile for BOTH
// targets — verified, not assumed. Sibling `.bit` files are one module, so the
// split has to be by directory:
//
//   runtime/rand/rand.bit          this file — portable, no OS primitive
//   runtime/rand/linux/entropy.bit getrandom(2) + the /dev/urandom fallback
//   runtime/rand/darwin/entropy.bit arc4random_buf(3)
//
// A consumer imports this module plus exactly one of the two platform modules.
// That per-target selection is the build's job, and is what `builtin.os.tag`
// was doing in the Zig.
//
// WINDOWS IS NOT PORTED. The Zig has a third arm, `BCryptGenRandom` (ABI.md
// §21), but Bit's compiler recognises exactly three targets — x86_64-linux,
// aarch64-linux and aarch64-macos — so there is no Windows target to build it
// for, no way to run it, and therefore no way to verify it. It is deliberately
// left out rather than written blind and left untested; it belongs with
// whatever task first gives Bit a PE/COFF target.
//
// BUFFERS ARE RAW POINTERS, NOT SLICES. Zig takes `[]u8` — a pointer to packed
// bytes. A Bit slice stores one 8-byte word per element, so `ptrOf` on a
// `[]u8` does not address packed bytes (§11.8), and `[]u8` cannot name the
// region this code actually fills: the payload of an `RtBytes` (ABI.md §21),
// which is packed. So the port takes a raw `*u8` and a byte count. This is a
// required deviation, not a preference — there is no Bit type that names a
// packed byte region.

// Zeroes the `n` packed bytes at `p`, then issues a compiler barrier so the
// writes cannot be elided.
//
// A plain clearing loop may be dropped entirely by dead-store elimination once
// the optimizer proves the buffer is never read afterwards — the classic way a
// "cleared" key survives in memory. The barrier declares memory clobbered,
// which forbids that. This backs `bit_rt_secure_zero` (ABI.md §21), for wiping
// key material.
//
// The Zig writes the zeroes with `@memset` and the barrier with
// `asm volatile ("" ::: .{ .memory = true })`. Bit has no `@memset`, so the
// loop is explicit; the barrier is the same construct — an `asm` block (§11.6)
// with an empty instruction payload on both architectures and `memory` in the
// clobber list. Empty payload is the point: it emits no instruction at all and
// exists purely to constrain the optimizer, exactly as the Zig's `""` does.
//
// NOT `@nosplit`: `@nosplit` rejects `asm` (E0075, §10.3), and unlike the
// spinlock this is not lock machinery that a safepoint could deadlock against.
// The Zig original carries no equivalent attribute either.
export function secureZero(p: *u8, n: int) {
  let i = 0
  while (i < n) { // bounded by `n`; the body always advances `i`
    let q = p + i
    *q = u8(0)
    i = i + 1
  }
  asm volatile {
    x64 { }
    arm64 { }
    clobber x64 { memory }
    clobber arm64 { memory }
  }
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §21) — `bit_rt_root_` placeholder pin
// ---------------------------------------------------------------------------
//
// PIN CARRIES THE `bit_rt_root_` PREFIX for the reason every other ported pin
// does: `runtime/root.zig` is still linked into every binary and already owns
// `bit_rt_secure_zero`, so claiming the real name here fails every link with
// DuplicateSymbol. G2 (#1583) drops the `_root` infix and nothing else changes.
//
// `loadWord` is `runtime/gc`'s pinned raw-memory glue and the three `slc*`
// offsets are `runtime/root`'s object-layout constants (ABI.md §2) — both
// cross-module references resolve to pinned symbols / compile-time constants,
// never to an unpinned mangled name.
import { loadWord } from "../gc"
import { slcBuf, slcLen, slcOff } from "../root"

// `bit_rt_secure_zero` (ABI.md §21): wipe a `[]byte`'s element words to zero
// with a barrier the optimizer cannot elide — `std/crypto` clears key material
// through it. `root.zig`'s `bit_rt_secure_zero`, byte range for byte range.
//
// THE WIPE IS `len * 8` PACKED BYTES, NOT `len`. A Bit slice stores one byte per
// 8-byte word (ABI.md §2), so the region the slice views is the WORD range
// `buf[off .. off+len]`, which is `len * 8` packed bytes starting at the word
// address `buf + off * 8`. That is exactly what the Zig's
// `sliceAsBytes(s.buf[s.off .. s.off + s.len])` computes; wiping only `len`
// bytes would leave every logical byte past the first word untouched.
//
// A NULL header views no bytes and returns early (#1564) — a zeroed struct's
// slice field is the null word, not an empty slice, and dereferencing it faults.
export @symbol("bit_rt_root_secure_zero") function rtSecureZero(h: int) {
  if (h == 0) {
    return
  }
  let buf = loadWord(h + slcBuf)
  let off = loadWord(h + slcOff)
  let n = loadWord(h + slcLen)
  let nilb: *u8 = nil
  let p = nilb + (buf + off * 8)
  secureZero(p, n * 8)
}
