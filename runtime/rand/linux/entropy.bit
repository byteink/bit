// Linux entropy source for the Stage-2 port of runtime/rand/ (#1368).
// See ../rand.bit for why the port is split by directory rather than switching
// on the OS inside one file.
//
// ENTROPY POLICY IS DELIBERATELY STRICT, and is inherited verbatim from the
// Fill ONLY from the OS CSPRNG. Never a userspace PRNG, never a weak or
// zero fallback. On failure report it and let the one caller turn that into a
// fatal panic — silently handing back predictable "random" bytes is a security
// defect far worse than a crash.
//
// Raw syscalls (§11.8) rather than a libc, for the reason the whole runtime
// uses them: the binary is fully static with no libc to call into.
//
// EVERY CONSTANT BELOW WAS READ OUT OF THE KERNEL UAPI HEADERS
// (the kernel syscall tables and `<sys/random.h>`), NOT from memory. A wrong
// syscall number here is a silent
// wrong-syscall, not a compile error.

// THE HOST-TARGET ORDINAL, AS AN `asm` IMMEDIATE RATHER THAN `hostTarget()`
// (#1659, applied here by #1667). Everything in this file has to be `@nosplit`
// — see `entropyFill` — and §10.3.1 deliberately REFUSES `hostTarget()` inside
// a poll-free body: it is a seed `prim_rt_fns` entry, so it lowers to a real
// `call bit_rt_host_target` (tests/cases/check_nosplit_host_target.bit pins the
// refusal). An `asm` block is inline by construction, so it is admitted, and
// §11.6 selects the sub-block per architecture at codegen.
//
// This is `runtime/root/linux/os.bit`'s `rtHostTarget` verbatim, duplicated
// rather than imported for the reason `nr` itself is already duplicated across
// `runtime/{net,park,sched,rand,thread}/linux`: each is a separate module, and
// a cross-module call here would make `runtime/rand/linux`'s freestanding emit
// depend on `runtime/root/linux`'s. tests/cases/run_nosplit_asm_arch.bit is the
// independent oracle for the immediates — it checks this exact pair against
// `hostTarget()` at run time, so a flipped arch mapping (which assembles fine
// either way and would silently issue the wrong syscall number) reddens there.

import { sysClose, sysGetrandom, sysOpenX64, sysOpenatArm64, sysRead } from "../../syscalls"

@nosplit function randHostTarget(): int {
  return asm {
    arm64 { 0xD2800020 }                    // movz x0, #1   -> aarch64-linux
    x64   { 0xB8, 0x00, 0x00, 0x00, 0x00 }  // mov  eax, 0   -> x86_64-linux
    result arm64 x0 x64 rax : int
  }
}

// Syscall numbers are per-architecture and Bit has no arch-conditional
// compilation, so the number is selected at run time (§11.8). `randHostTarget()`
// is 0 for x86_64-linux and 1 for aarch64-linux; this module is only ever
// built for a Linux target, so the two cases are exhaustive.

// x86_64 still has the legacy `open`; aarch64 never had it and must use
// `openat` with `AT_FDCWD`. This is the split the kernel forces
// with `if (@hasField(SYS, "open"))`, so the port issues the same syscall the
// each architecture provides, rather than normalising both onto `openat`.
@nosplit function atFdcwd(): int { return -100 }

// O_CLOEXEC is bit 19 on both x86_64 and aarch64 (the `O` packed struct in
// The kernel orders the earlier fields differently per architecture, but
// CLOEXEC lands on the same bit in both).
@nosplit function oCloexec(): int { return 524288 }

// Negated errno values, as a raw syscall returns them. The `else` branch of
// `<asm-generic/errno.h>` — which covers both x86_64 and aarch64 — has
// INTR = 4 and NOSYS = 38. (The MIPS and SPARC tables differ; neither is a
// target here.)
@nosplit function errIntr(): int { return -4 }
@nosplit function errNosys(): int { return -38 }

// Fills the `n` packed bytes at `p` from the OS CSPRNG. Returns true on
// success; false means the draw failed. The buffer is not guaranteed
// untouched on failure: a short draw is possible
// before an error — and the caller aborts either way.
//
// The natural signature is `fill(buf) !void`. Bit's `!` error type is
// GC-managed, which the unmanaged subset cannot use, so failure is reported as
// a plain `bool`: the honest unmanaged equivalent of a single-error union. The
// caller (`bit_rt_random_bytes`, #1367) turns false into the same fatal panic
// that `catch fatal("random_bytes: OS CSPRNG failed")` produces today.
//
// `@nosplit` (#1667), and REQUIRED rather than tidy. `p` is an interior pointer
// into the fresh `string` `../linux/random.bit`'s `rtRandomBytes` just
// allocated and holds only as a raw `int` (E0079 forbids the pin naming a
// managed type). ABI.md §5 walks the RUNNING task's stack PRECISELY, so no
// stack map names that object; without this annotation the `while` below
// carries a compiler-synthesized `bl bit_rt_safepoint` at its back edge and a
// collection there sweeps the buffer the kernel is filling (#1656). §10.3.1
// admits `syscall`, which is all this subtree needs besides the `asm` immediate
// in `randHostTarget`.
export @nosplit function entropyFill(p: *u8, n: int): bool {
  if (n <= 0) { // a zero-length fill is a no-op, not an error
    return true
  }
  let off = 0
  // Bounded by `n`: every branch either advances `off`, retries a signal
  // interruption, or returns.
  while (off < n) {
    // flags = 0: draw from the same pool as /dev/urandom and *block* until it
    // has been seeded. Never GRND_RANDOM (drains the blocking pool for no
    // security gain) nor GRND_NONBLOCK (would fail early rather than wait).
    let rc = int(syscall(sysGetrandom(), i64(p + off), i64(n - off), 0))
    if (rc > 0) {
      off = off + rc // may be a short draw; the loop finishes it
    } else if (rc == 0) {
      // Unreachable on a conforming kernel: getrandom never returns 0 for a
      // non-zero request. Treated as failure rather than looping forever, so
      // every branch of this loop provably advances or returns. The
      // /dev/urandom loop makes the same defensive check.
      return false
    } else if (rc == errIntr()) {
      // A signal interrupted the wait for entropy: retry.
    } else if (rc == errNosys()) {
      // Pre-3.17 kernel: the syscall does not exist. Fall back, restarting
      // from the beginning of the buffer — `off` is necessarily still 0, since
      // ENOSYS can only come from the very first call.
      return fillUrandom(p, n)
    } else {
      // EFAULT/EINVAL here would be a bug in this code, not a runtime
      // condition; either way the caller must not get weak bytes.
      return false
    }
  }
  return true
}

// The NUL-terminated `/dev/urandom` path scratch. MODULE-LEVEL AND SCALAR, not
// the per-call `[]i64(2)` this used to build, and that is what makes
// `fillUrandom` `@nosplit`-able (#1667): `@nosplit` forbids allocation outright
// (E0075), so neither a per-call slice nor the `[]int{...}` character literal
// can stay on this path. It is the shape `runtime/root/fs.bit`'s `fsPathBuf`
// and `runtime/root/*/io.bit`'s `ioConstBuf` already use, for the same reason.
//
// A scalar array is never scanned by the collector (ABI.md §5, rule 1), which
// is required here and harmless: it holds a fixed ASCII path, never an object
// address. Unlocked, sound under the ABI's single-worker contract (§5) on the
// same terms as `fsPathBuf` — it is filled and handed to `open` inside one
// poll-free call, so no second caller can interleave. 2 words = 16 bytes holds
// the 12-byte path plus its NUL.
let randPathBuf: [2]i64

// Store the packed byte `c` at `base + i`. A helper rather than 13 inline
// pointer expressions, and unrolled by its caller rather than looped, because
// the source of the characters used to be a `[]int` literal — an allocation.
@nosplit function putPathByte(base: int, i: int, c: int) {
  let nilb: *u8 = nil
  let q = nilb + (base + i)
  *q = u8(c)
}

// Pre-3.17 fallback: `/dev/urandom`, the same CSPRNG source `getrandom(0)`
// wraps. Only reached when the syscall itself is absent (ENOSYS).
@nosplit function fillUrandom(p: *u8, n: int): bool {
  // "/dev/urandom\0" as packed bytes. The kernel wants a NUL-terminated byte
  // string, and a Bit slice stores one 8-byte word per element (§11.8), so the
  // path is written byte-by-byte through a raw pointer rather than held as a
  // `[]u8` or a `string`. Written out per character rather than as two i64 word
  // stores deliberately: a packed word constant would be endianness-dependent
  // and unreadable, and this runs at most once per process.
  let path = int(ptrOf(randPathBuf))
  putPathByte(path, 0, 47) //  '/'
  putPathByte(path, 1, 100) // 'd'
  putPathByte(path, 2, 101) // 'e'
  putPathByte(path, 3, 118) // 'v'
  putPathByte(path, 4, 47) //  '/'
  putPathByte(path, 5, 117) // 'u'
  putPathByte(path, 6, 114) // 'r'
  putPathByte(path, 7, 97) //  'a'
  putPathByte(path, 8, 110) // 'n'
  putPathByte(path, 9, 100) // 'd'
  putPathByte(path, 10, 111) // 'o'
  putPathByte(path, 11, 109) // 'm'
  putPathByte(path, 12, 0) //   NUL

  let fdrc = 0
  if (randHostTarget() == 0) {
    fdrc = int(syscall(sysOpenX64(), i64(path), i64(oCloexec()), 0))
  } else {
    fdrc = int(syscall(sysOpenatArm64(), i64(atFdcwd()), i64(path), i64(oCloexec()), 0))
  }
  if (fdrc < 0) {
    return false
  }
  let fd = fdrc

  let ok = true
  let off = 0
  // Bounded by `n`: every branch advances `off`, retries, or leaves the loop.
  while (off < n) {
    let rc = int(syscall(sysRead(), i64(fd), i64(p + off), i64(n - off)))
    if (rc > 0) {
      off = off + rc
    } else if (rc == 0) {
      ok = false // unexpected EOF on the device
      break
    } else if (rc == errIntr()) {
      // retry
    } else {
      ok = false
      break
    }
  }

  // A `defer` would close it; this is the same unconditional close on every
  // exit path after a successful open. The result is deliberately ignored —
  // there is nothing useful to do about a failed close, and the entropy has
  // already been read.
  syscall(sysClose(), i64(fd))
  return ok
}
