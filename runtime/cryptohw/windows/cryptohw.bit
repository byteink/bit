// x86_64 crypto hardware-capability detection for Windows (#3588, epic #3322
// Windows port — the x86_64-windows sibling of ../linux/cryptohw.bit and
// ../darwin/cryptohw.bit).
//
// `bit_rt_crypto_hwcaps() -> u64` is a bitmask: bit 0 = AES, bit 1 = PMULL,
// bit 2 = SHA2. This project has no aarch64-windows target
// (`compiler/build.bit`'s `BuildTarget` names four targets total, one of
// them Windows, and it is always x86_64 — `isWindowsTarget` has no
// architecture split the way ../linux/cryptohw.bit's `onX64()` does), so
// there is no per-architecture branch to make here.
//
// REPORTS NO ACCELERATION, DELIBERATELY, and this mirrors reality rather than
// under-implementing: ../linux/cryptohw.bit's OWN x86_64 arm
// (`detectHwcaps`'s `if (onX64()) { return 0 }`) already answers 0 on every
// x86_64-linux build today, because no x86_64 CPUID-based AES-NI/PCLMULQDQ/
// SHA-NI probe exists anywhere in this tree yet (there is no "cpuid" in any
// `.bit` file to port — checked, not assumed). So there is no existing
// x86_64 capability probe to mirror; the answer that keeps x86_64-windows
// and x86_64-linux consistent with each other is the one x86_64-linux
// already gives. `stdlib/crypto` treats 0 as "use the constant-time software
// path" (../cryptohw.bit's header: the three `hwAvailable*` placeholders
// answering `false` are correct and safe for exactly this reason), which is
// the same path x86_64-linux runs today.
//
// A real CPUID-based probe is future work — performance only, never
// correctness, per ../cryptohw.bit's header — and is out of scope here: this
// file exists to resolve the E0078 link failure blocking any `std/tls`
// program from building for x86_64-windows, not to add new capability
// detection. Hand-written CPUID/asm on this target would also risk the exact
// class of bug #3503 and #3554 found in shared x86_64 payloads that assumed
// SysV's register bank instead of Win64's.
//
// CACHED, not recomputed per call, for the same reason ../linux/cryptohw.bit
// and ../darwin/cryptohw.bit cache: a constant answer costs nothing to
// recompute, but keeping the same shape as both siblings means a future real
// probe slots in here without restructuring the caller-visible symbol.

let hwcapsCache: int = -1

export @symbol("bit_rt_crypto_hwcaps") fn rtCryptoHwcaps(): uint {
  if (hwcapsCache >= 0) {
    return uint(hwcapsCache)
  }
  hwcapsCache = 0
  return uint(0)
}
