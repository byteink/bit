// x86-64 hardware GHASH via PCLMULQDQ (#7385): the x86-64 half of the two
// pins `armghash.bit` exports, `bit_rt_ghash_hw_blocks` and
// `bit_rt_ghash_hw_mul`, which route here when `onX64()`. Same contract as
// the arm64 path: state = (state XOR block) * H once per 16-byte block, in
// GF(2^128) under GCM's bit order (NIST SP 800-38D §6.3), checked against the
// constant-time software path in `stdlib/crypto/gcm.bit` by the cryptogcm
// differential.
//
// THE ALGORITHM is Intel's "Carry-Less Multiplication and Its Usage for
// Computing the GCM Mode" (Gueron and Kounavis): PSHUFB byte-reverses each
// block, which makes the register the bit-reflected field element; one
// Karatsuba multiply (three PCLMULQDQ: lo, hi, and (a0^a1)(b0^b1)) gives the
// 256-bit product; it is shifted left one bit, because the product of two
// reflected 128-bit values is reflected over 255 bits; and it is reduced
// modulo x^128 + x^7 + x^2 + x + 1 by the paper's shift-and-xor reduction:
// A,B,C = X0<<63, X0<<62, X0<<57, D = X1^A^B^C, then [D:X0] >> 1, 2 and 7
// folded into the high half. Every step is data-independent: no branch and
// no memory index depends on H or the data.
//
// DETECTION. `x64ClmulCaps` reads CPUID leaf 1 ECX for PCLMULQDQ (bit 1) and
// SSSE3 (bit 9, for PSHUFB) and answers bit 1 of the `bit_rt_crypto_hwcaps`
// mask, which `runtime/cryptohw/{linux,windows}/cryptohw.bit` report on
// x86-64. Bits 0 (AES) and 2 (SHA2) stay clear there: they name the ARMv8
// primitives `armaes.bit` and `armsha256.bit` run, which have no x86-64 arm.
//
// REGISTERS. Only xmm0..xmm5 are used: Win64 preserves xmm6..xmm15 across a
// call, SysV preserves none, and one x64 payload serves both. `clobber` has no
// spelling for a vector register, so the block also names r9 (caller-saved,
// and the scratch it builds the PSHUFB mask in), which makes it a clobber
// point that keeps every live value, a float included, out of the
// caller-saved file (SPEC §11.6).
//
// ENCODING PROVENANCE. No text assembler exists in this compiler (SPEC
// §11.6): every byte below was assembled from the mnemonic in its comment
// with this Mac's toolchain (`clang -c -arch x86_64`) and read back with
// `objdump -d`. The payload holds no `E8` byte and no `FF` whose ModRM reg
// field is 2 or 3, so SPEC §11.6's call decoder reads none of it as a call.
// The loop's back edge is a hand-computed rel32, as SPEC §11.6 allows.
// `x64GhashKeys` and `x64GhashRun8` (#7446) were assembled whole, back edges
// included, and their bytes checked against the assembler's output.
//
// CHUNKED FOR THE COLLECTOR. The block is opaque and holds no safepoint, so
// one call folds at most `ghashX64Chunk` blocks (64 KiB) and a large buffer
// still reaches the Bit loop's back edge, and its safepoint, every few
// microseconds.
//
// AGGREGATION (#7446). One block per multiply leaves the state waiting on a
// full multiply and reduction before the next block can start, about 26
// cycles per 16 bytes. A run of at least `ghashX64AggMin` blocks folds
// eight at a time instead: for state S and blocks D0..D7 the next state is
// (S^D0)H^8 ^ D1 H^7 ^ ... ^ D7 H, and since the multiply, the one-bit
// shift and the reduction are all linear over GF(2), the eight Karatsuba
// products are XORed unreduced and reduced once. Only block 0 waits on the
// previous state, so one reduction's latency is spread over 128 bytes.
// `x64GhashKeys` computes H^2..H^8 with the same multiply as the one-block
// loop; leftover blocks take the one-block loop. The key table, and the
// byte-reversal mask stored after it so xmm5 is free for a temporary, are
// read as memory operands, which legacy SSE requires to be 16-byte
// aligned, so `x64GhashBlocks` aligns it.

const ghashX64Chunk: int = 4096

// Runs this long take the eight-block loop: the key schedule is seven
// serial multiplies, about what eight blocks cost one at a time.
const ghashX64AggMin: int = 16

// `x64GhashKeys`'s table: H^k in the loop's byte-reversed form at 32(k-1)
// and its Karatsuba key (low half XOR high half) at 32(k-1)+16, k = 1..8,
// then the 16-byte PSHUFB mask at 256.
const ghashX64KeysLen: int = 272

// CPUID leaf 1 ECX bits: PCLMULQDQ and SSSE3.
const cpuidPclmul: u64 = 2
const cpuidSsse3: u64 = 512

// Bit 1 (carry-less multiply) of the `bit_rt_crypto_hwcaps` mask when this
// x86-64 CPU has PCLMULQDQ and SSSE3, else 0. Called only on x86-64.
export @symbol("bit_rt_crypto_x64_clmul_caps") fn x64ClmulCaps(): uint {
  let want = cpuidPclmul | cpuidSsse3
  if ((x64CpuidLeaf1Ecx() & want) != want) {
    return 0
  }
  return 2
}

// CPUID leaf 1, sub-leaf 0, ECX. The arm64 arm is a placeholder that no
// caller reaches.
fn x64CpuidLeaf1Ecx(): u64 {
  return asm {
    arm64 { 0xD2800000 } // mov x0, #0
    x64 { 0x0F, 0xA2 }   // cpuid
    result arm64 x0 x64 rcx : u64
    input arm64 x0 x64 rax = 1
    input arm64 x1 x64 rcx = 0
    clobber x64 { rbx, rdx }
  }
}

// Fold `blocks` (> 0, <= ghashX64Chunk) 16-byte blocks at `data` into the
// 16-byte GHASH state at `state`, under the subkey at `h`. The arm64 arm is a
// trap: `rtGhashHwBlocks` only routes here when `onX64()`.
fn x64GhashRun(h: int, state: int, data: int, blocks: int) {
  asm volatile {
    arm64 { 0xD4200000 } // brk #0
    x64 {
      0x49, 0xB9, 0x0F, 0x0E, 0x0D, 0x0C, 0x0B, 0x0A, 0x09, 0x08, // movabs r9, 0x8090a0b0c0d0e0f
      0x66, 0x49, 0x0F, 0x6E, 0xE9,                               // movq xmm5, r9
      0x49, 0xB9, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00, // movabs r9, 0x1020304050607
      0x66, 0x49, 0x0F, 0x6E, 0xD9,                               // movq xmm3, r9
      0x66, 0x0F, 0x6C, 0xEB,                                     // punpcklqdq xmm5, xmm3
      0xF3, 0x0F, 0x6F, 0x20,                                     // movdqu xmm4, [rax]
      0x66, 0x0F, 0x38, 0x00, 0xE5,                               // pshufb xmm4, xmm5
      0xF3, 0x0F, 0x6F, 0x01,                                     // movdqu xmm0, [rcx]
      0x66, 0x0F, 0x38, 0x00, 0xC5,                               // pshufb xmm0, xmm5
      0xF3, 0x0F, 0x6F, 0x0A,                                     // loop: movdqu xmm1, [rdx]
      0x66, 0x0F, 0x38, 0x00, 0xCD,                               // pshufb xmm1, xmm5
      0x66, 0x0F, 0xEF, 0xC1,                                     // pxor xmm0, xmm1
      0x66, 0x0F, 0x6F, 0xC8, 0x66, 0x0F, 0x3A, 0x44, 0xCC, 0x00, // movdqa xmm1, xmm0; pclmulqdq xmm1, xmm4, 0x0
      0x66, 0x0F, 0x6F, 0xD0, 0x66, 0x0F, 0x3A, 0x44, 0xD4, 0x11, // movdqa xmm2, xmm0; pclmulqdq xmm2, xmm4, 0x11
      0x66, 0x0F, 0x70, 0xD8, 0x4E,                               // pshufd xmm3, xmm0, 0x4e
      0x66, 0x0F, 0xEF, 0xD8,                                     // pxor xmm3, xmm0
      0x66, 0x0F, 0x70, 0xC4, 0x4E,                               // pshufd xmm0, xmm4, 0x4e
      0x66, 0x0F, 0xEF, 0xC4,                                     // pxor xmm0, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xD8, 0x00,                         // pclmulqdq xmm3, xmm0, 0x0
      0x66, 0x0F, 0xEF, 0xD9,                                     // pxor xmm3, xmm1
      0x66, 0x0F, 0xEF, 0xDA,                                     // pxor xmm3, xmm2
      0x66, 0x0F, 0x6F, 0xC3, 0x66, 0x0F, 0x73, 0xF8, 0x08,       // movdqa xmm0, xmm3; pslldq xmm0, 0x8
      0x66, 0x0F, 0xEF, 0xC8,                                     // pxor xmm1, xmm0
      0x66, 0x0F, 0x73, 0xDB, 0x08,                               // psrldq xmm3, 0x8
      0x66, 0x0F, 0xEF, 0xD3,                                     // pxor xmm2, xmm3
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xD0, 0x3F,       // movdqa xmm0, xmm1; psrlq xmm0, 0x3f
      0x66, 0x0F, 0x6F, 0xDA, 0x66, 0x0F, 0x73, 0xD3, 0x3F,       // movdqa xmm3, xmm2; psrlq xmm3, 0x3f
      0x66, 0x0F, 0x73, 0xF1, 0x01,                               // psllq xmm1, 0x1
      0x66, 0x0F, 0x73, 0xF2, 0x01,                               // psllq xmm2, 0x1
      0x66, 0x0F, 0x73, 0xFB, 0x08,                               // pslldq xmm3, 0x8
      0x66, 0x0F, 0xEB, 0xD3,                                     // por xmm2, xmm3
      0x66, 0x0F, 0x6F, 0xD8, 0x66, 0x0F, 0x73, 0xDB, 0x08,       // movdqa xmm3, xmm0; psrldq xmm3, 0x8
      0x66, 0x0F, 0xEB, 0xD3,                                     // por xmm2, xmm3
      0x66, 0x0F, 0x73, 0xF8, 0x08,                               // pslldq xmm0, 0x8
      0x66, 0x0F, 0xEB, 0xC8,                                     // por xmm1, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xF0, 0x3F,       // movdqa xmm0, xmm1; psllq xmm0, 0x3f
      0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x3E,       // movdqa xmm3, xmm1; psllq xmm3, 0x3e
      0x66, 0x0F, 0xEF, 0xC3,                                     // pxor xmm0, xmm3
      0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x39,       // movdqa xmm3, xmm1; psllq xmm3, 0x39
      0x66, 0x0F, 0xEF, 0xC3,                                     // pxor xmm0, xmm3
      0x66, 0x0F, 0x73, 0xF8, 0x08,                               // pslldq xmm0, 0x8
      0x66, 0x0F, 0xEF, 0xC8,                                     // pxor xmm1, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xD0, 0x01,       // movdqa xmm0, xmm1; psrlq xmm0, 0x1
      0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xD3, 0x02,       // movdqa xmm3, xmm1; psrlq xmm3, 0x2
      0x66, 0x0F, 0xEF, 0xC3,                                     // pxor xmm0, xmm3
      0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xD3, 0x07,       // movdqa xmm3, xmm1; psrlq xmm3, 0x7
      0x66, 0x0F, 0xEF, 0xC3,                                     // pxor xmm0, xmm3
      0x66, 0x0F, 0xEF, 0xD0,                                     // pxor xmm2, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xF0, 0x3F,       // movdqa xmm0, xmm1; psllq xmm0, 0x3f
      0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x3E,       // movdqa xmm3, xmm1; psllq xmm3, 0x3e
      0x66, 0x0F, 0xEF, 0xC3,                                     // pxor xmm0, xmm3
      0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x39,       // movdqa xmm3, xmm1; psllq xmm3, 0x39
      0x66, 0x0F, 0xEF, 0xC3,                                     // pxor xmm0, xmm3
      0x66, 0x0F, 0x73, 0xD8, 0x08,                               // psrldq xmm0, 0x8
      0x66, 0x0F, 0xEF, 0xD0,                                     // pxor xmm2, xmm0
      0x66, 0x0F, 0xEF, 0xD1,                                     // pxor xmm2, xmm1
      0x66, 0x0F, 0x6F, 0xC2, 0x48, 0x83, 0xC2, 0x10,             // movdqa xmm0, xmm2; add rdx, 0x10
      0x49, 0xFF, 0xC8,                                           // dec r8
      0x0F, 0x85, 0xDA, 0xFE, 0xFF, 0xFF,                         // jne loop (rel32 -294, back to the movdqu xmm1 above)
      0x66, 0x0F, 0x38, 0x00, 0xC5,                               // pshufb xmm0, xmm5
      0xF3, 0x0F, 0x7F, 0x01,                                     // movdqu [rcx], xmm0
    }
    input arm64 x0 x64 rax = h
    input arm64 x1 x64 rcx = state
    input arm64 x2 x64 rdx = data
    input arm64 x3 x64 r8 = blocks
    clobber arm64 { memory }
    clobber x64 { r9, memory }
  }
}

// Writes `x64GhashKeys`'s table at the 16-byte-aligned `keys` from the 16
// wire bytes of H at `h`: H^k and its Karatsuba key at 32(k-1) and
// 32(k-1)+16 for k = 1..8, each power the one-block loop's multiply by H,
// then the PSHUFB byte-reversal mask at 256. The arm64 arm is a trap:
// `rtGhashHwBlocks` only routes here when `onX64()`.
fn x64GhashKeys(h: int, keys: int) {
  asm volatile {
    arm64 { 0xD4200000 } // brk #0
    x64 {
      0x49, 0xB9, 0x0F, 0x0E, 0x0D, 0x0C, 0x0B, 0x0A, 0x09, 0x08, 0x66, 0x49, 0x0F, 0x6E, 0xE9, // movabs r9, 0x8090a0b0c0d0e0f; movq xmm5, r9
      0x49, 0xB9, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x00, 0x66, 0x49, 0x0F, 0x6E, 0xD9, // movabs r9, 0x1020304050607; movq xmm3, r9
      0x66, 0x0F, 0x6C, 0xEB, 0xF3, 0x0F, 0x7F, 0xA9, 0x00, 0x01, 0x00, 0x00,                   // punpcklqdq xmm5, xmm3; movdqu [rcx + 0x100], xmm5
      0xF3, 0x0F, 0x6F, 0x20, 0x66, 0x0F, 0x38, 0x00, 0xE5, 0xF3, 0x0F, 0x7F, 0x21,             // movdqu xmm4, [rax]; pshufb xmm4, xmm5; movdqu [rcx], xmm4
      0x66, 0x0F, 0x70, 0xD4, 0x4E, 0x66, 0x0F, 0xEF, 0xD4, 0xF3, 0x0F, 0x7F, 0x51, 0x10,       // pshufd xmm2, xmm4, 0x4e; pxor xmm2, xmm4; movdqu [rcx + 0x10], xmm2
      0x66, 0x0F, 0x6F, 0xC4, 0x41, 0xB9, 0x07, 0x00, 0x00, 0x00,                               // movdqa xmm0, xmm4; mov r9d, 0x7
      0x66, 0x0F, 0x6F, 0xC8, 0x66, 0x0F, 0x3A, 0x44, 0xCC, 0x00, 0x66, 0x0F, 0x6F, 0xD0,       // kloop: movdqa xmm1, xmm0; pclmulqdq xmm1, xmm4, 0x0; movdqa xmm2, xmm0
      0x66, 0x0F, 0x3A, 0x44, 0xD4, 0x11, 0x66, 0x0F, 0x70, 0xD8, 0x4E, 0x66, 0x0F, 0xEF, 0xD8, // pclmulqdq xmm2, xmm4, 0x11; pshufd xmm3, xmm0, 0x4e; pxor xmm3, xmm0
      0x66, 0x0F, 0x70, 0xC4, 0x4E, 0x66, 0x0F, 0xEF, 0xC4, 0x66, 0x0F, 0x3A, 0x44, 0xD8, 0x00, // pshufd xmm0, xmm4, 0x4e; pxor xmm0, xmm4; pclmulqdq xmm3, xmm0, 0x0
      0x66, 0x0F, 0xEF, 0xD9, 0x66, 0x0F, 0xEF, 0xDA, 0x66, 0x0F, 0x6F, 0xC3,                   // pxor xmm3, xmm1; pxor xmm3, xmm2; movdqa xmm0, xmm3
      0x66, 0x0F, 0x73, 0xF8, 0x08, 0x66, 0x0F, 0xEF, 0xC8, 0x66, 0x0F, 0x73, 0xDB, 0x08,       // pslldq xmm0, 0x8; pxor xmm1, xmm0; psrldq xmm3, 0x8
      0x66, 0x0F, 0xEF, 0xD3, 0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xD0, 0x3F,             // pxor xmm2, xmm3; movdqa xmm0, xmm1; psrlq xmm0, 0x3f
      0x66, 0x0F, 0x6F, 0xDA, 0x66, 0x0F, 0x73, 0xD3, 0x3F, 0x66, 0x0F, 0x73, 0xF1, 0x01,       // movdqa xmm3, xmm2; psrlq xmm3, 0x3f; psllq xmm1, 0x1
      0x66, 0x0F, 0x73, 0xF2, 0x01, 0x66, 0x0F, 0x73, 0xFB, 0x08, 0x66, 0x0F, 0xEB, 0xD3,       // psllq xmm2, 0x1; pslldq xmm3, 0x8; por xmm2, xmm3
      0x66, 0x0F, 0x6F, 0xD8, 0x66, 0x0F, 0x73, 0xDB, 0x08, 0x66, 0x0F, 0xEB, 0xD3,             // movdqa xmm3, xmm0; psrldq xmm3, 0x8; por xmm2, xmm3
      0x66, 0x0F, 0x73, 0xF8, 0x08, 0x66, 0x0F, 0xEB, 0xC8, 0x66, 0x0F, 0x6F, 0xC1,             // pslldq xmm0, 0x8; por xmm1, xmm0; movdqa xmm0, xmm1
      0x66, 0x0F, 0x73, 0xF0, 0x3F, 0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x3E,       // psllq xmm0, 0x3f; movdqa xmm3, xmm1; psllq xmm3, 0x3e
      0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x39,             // pxor xmm0, xmm3; movdqa xmm3, xmm1; psllq xmm3, 0x39
      0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x73, 0xF8, 0x08, 0x66, 0x0F, 0xEF, 0xC8,             // pxor xmm0, xmm3; pslldq xmm0, 0x8; pxor xmm1, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xD0, 0x01, 0x66, 0x0F, 0x6F, 0xD9,             // movdqa xmm0, xmm1; psrlq xmm0, 0x1; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xD3, 0x02, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x6F, 0xD9,             // psrlq xmm3, 0x2; pxor xmm0, xmm3; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xD3, 0x07, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0xEF, 0xD0,             // psrlq xmm3, 0x7; pxor xmm0, xmm3; pxor xmm2, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xF0, 0x3F, 0x66, 0x0F, 0x6F, 0xD9,             // movdqa xmm0, xmm1; psllq xmm0, 0x3f; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xF3, 0x3E, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x6F, 0xD9,             // psllq xmm3, 0x3e; pxor xmm0, xmm3; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xF3, 0x39, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x73, 0xD8, 0x08,       // psllq xmm3, 0x39; pxor xmm0, xmm3; psrldq xmm0, 0x8
      0x66, 0x0F, 0xEF, 0xD0, 0x66, 0x0F, 0xEF, 0xD1, 0x66, 0x0F, 0x6F, 0xC2,                   // pxor xmm2, xmm0; pxor xmm2, xmm1; movdqa xmm0, xmm2
      0xF3, 0x0F, 0x7F, 0x41, 0x20, 0x66, 0x0F, 0x70, 0xD0, 0x4E, 0x66, 0x0F, 0xEF, 0xD0,       // movdqu [rcx + 0x20], xmm0; pshufd xmm2, xmm0, 0x4e; pxor xmm2, xmm0
      0xF3, 0x0F, 0x7F, 0x51, 0x30,                                                             // movdqu [rcx + 0x30], xmm2
      0x48, 0x83, 0xC1, 0x20, 0x49, 0xFF, 0xC9,                                                 // add rcx, 0x20; dec r9
      0x0F, 0x85, 0xD4, 0xFE, 0xFF, 0xFF,                                                       // jne kloop (rel32 -300, back to the movdqa xmm1, xmm0 above)
    }
    input arm64 x0 x64 rax = h
    input arm64 x1 x64 rcx = keys
    clobber arm64 { memory }
    clobber x64 { r9, memory }
  }
}

// Fold `groups` (> 0) eight-block groups at `data` into the 16-byte state at
// `state`, under the 16-byte-aligned table at `keys` (`x64GhashKeys`). Blocks
// 7..1 are multiplied first and only block 0 waits on the state. The arm64
// arm is a trap.
fn x64GhashRun8(keys: int, state: int, data: int, groups: int) {
  asm volatile {
    arm64 { 0xD4200000 } // brk #0
    x64 {
      0xF3, 0x0F, 0x6F, 0x01, 0x66, 0x0F, 0x38, 0x00, 0x80, 0x00, 0x01, 0x00, 0x00,             // movdqu xmm0, [rcx]; pshufb xmm0, [rax + 0x100]
      0xF3, 0x0F, 0x6F, 0x62, 0x70, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // loop8: movdqu xmm4, [rdx + 0x70]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xCC, 0x66, 0x0F, 0x3A, 0x44, 0x08, 0x00, 0x66, 0x0F, 0x6F, 0xD4,       // movdqa xmm1, xmm4; pclmulqdq xmm1, [rax], 0x0; movdqa xmm2, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0x10, 0x11, 0x66, 0x0F, 0x70, 0xDC, 0x4E, 0x66, 0x0F, 0xEF, 0xDC, // pclmulqdq xmm2, [rax], 0x11; pshufd xmm3, xmm4, 0x4e; pxor xmm3, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0x58, 0x10, 0x00,                                                 // pclmulqdq xmm3, [rax + 0x10], 0x0
      0xF3, 0x0F, 0x6F, 0x62, 0x60, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // movdqu xmm4, [rdx + 0x60]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0x68, 0x20, 0x00, 0x66, 0x0F, 0xEF, 0xCD, // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x20], 0x0; pxor xmm1, xmm5
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0x68, 0x20, 0x11, 0x66, 0x0F, 0xEF, 0xD5, // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x20], 0x11; pxor xmm2, xmm5
      0x66, 0x0F, 0x70, 0xEC, 0x4E, 0x66, 0x0F, 0xEF, 0xEC,                                     // pshufd xmm5, xmm4, 0x4e; pxor xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0x68, 0x30, 0x00, 0x66, 0x0F, 0xEF, 0xDD,                         // pclmulqdq xmm5, [rax + 0x30], 0x0; pxor xmm3, xmm5
      0xF3, 0x0F, 0x6F, 0x62, 0x50, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // movdqu xmm4, [rdx + 0x50]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0x68, 0x40, 0x00, 0x66, 0x0F, 0xEF, 0xCD, // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x40], 0x0; pxor xmm1, xmm5
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0x68, 0x40, 0x11, 0x66, 0x0F, 0xEF, 0xD5, // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x40], 0x11; pxor xmm2, xmm5
      0x66, 0x0F, 0x70, 0xEC, 0x4E, 0x66, 0x0F, 0xEF, 0xEC,                                     // pshufd xmm5, xmm4, 0x4e; pxor xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0x68, 0x50, 0x00, 0x66, 0x0F, 0xEF, 0xDD,                         // pclmulqdq xmm5, [rax + 0x50], 0x0; pxor xmm3, xmm5
      0xF3, 0x0F, 0x6F, 0x62, 0x40, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // movdqu xmm4, [rdx + 0x40]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0x68, 0x60, 0x00, 0x66, 0x0F, 0xEF, 0xCD, // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x60], 0x0; pxor xmm1, xmm5
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0x68, 0x60, 0x11, 0x66, 0x0F, 0xEF, 0xD5, // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x60], 0x11; pxor xmm2, xmm5
      0x66, 0x0F, 0x70, 0xEC, 0x4E, 0x66, 0x0F, 0xEF, 0xEC,                                     // pshufd xmm5, xmm4, 0x4e; pxor xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0x68, 0x70, 0x00, 0x66, 0x0F, 0xEF, 0xDD,                         // pclmulqdq xmm5, [rax + 0x70], 0x0; pxor xmm3, xmm5
      0xF3, 0x0F, 0x6F, 0x62, 0x30, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // movdqu xmm4, [rdx + 0x30]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0xA8, 0x80, 0x00, 0x00, 0x00, 0x00,       // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0x80], 0x0
      0x66, 0x0F, 0xEF, 0xCD, 0x66, 0x0F, 0x6F, 0xEC,                                           // pxor xmm1, xmm5; movdqa xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xA8, 0x80, 0x00, 0x00, 0x00, 0x11, 0x66, 0x0F, 0xEF, 0xD5,       // pclmulqdq xmm5, [rax + 0x80], 0x11; pxor xmm2, xmm5
      0x66, 0x0F, 0x70, 0xEC, 0x4E, 0x66, 0x0F, 0xEF, 0xEC,                                     // pshufd xmm5, xmm4, 0x4e; pxor xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xA8, 0x90, 0x00, 0x00, 0x00, 0x00, 0x66, 0x0F, 0xEF, 0xDD,       // pclmulqdq xmm5, [rax + 0x90], 0x0; pxor xmm3, xmm5
      0xF3, 0x0F, 0x6F, 0x62, 0x20, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // movdqu xmm4, [rdx + 0x20]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0xA8, 0xA0, 0x00, 0x00, 0x00, 0x00,       // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0xa0], 0x0
      0x66, 0x0F, 0xEF, 0xCD, 0x66, 0x0F, 0x6F, 0xEC,                                           // pxor xmm1, xmm5; movdqa xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xA8, 0xA0, 0x00, 0x00, 0x00, 0x11, 0x66, 0x0F, 0xEF, 0xD5,       // pclmulqdq xmm5, [rax + 0xa0], 0x11; pxor xmm2, xmm5
      0x66, 0x0F, 0x70, 0xEC, 0x4E, 0x66, 0x0F, 0xEF, 0xEC,                                     // pshufd xmm5, xmm4, 0x4e; pxor xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xA8, 0xB0, 0x00, 0x00, 0x00, 0x00, 0x66, 0x0F, 0xEF, 0xDD,       // pclmulqdq xmm5, [rax + 0xb0], 0x0; pxor xmm3, xmm5
      0xF3, 0x0F, 0x6F, 0x62, 0x10, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,       // movdqu xmm4, [rdx + 0x10]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0x6F, 0xEC, 0x66, 0x0F, 0x3A, 0x44, 0xA8, 0xC0, 0x00, 0x00, 0x00, 0x00,       // movdqa xmm5, xmm4; pclmulqdq xmm5, [rax + 0xc0], 0x0
      0x66, 0x0F, 0xEF, 0xCD, 0x66, 0x0F, 0x6F, 0xEC,                                           // pxor xmm1, xmm5; movdqa xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xA8, 0xC0, 0x00, 0x00, 0x00, 0x11, 0x66, 0x0F, 0xEF, 0xD5,       // pclmulqdq xmm5, [rax + 0xc0], 0x11; pxor xmm2, xmm5
      0x66, 0x0F, 0x70, 0xEC, 0x4E, 0x66, 0x0F, 0xEF, 0xEC,                                     // pshufd xmm5, xmm4, 0x4e; pxor xmm5, xmm4
      0x66, 0x0F, 0x3A, 0x44, 0xA8, 0xD0, 0x00, 0x00, 0x00, 0x00, 0x66, 0x0F, 0xEF, 0xDD,       // pclmulqdq xmm5, [rax + 0xd0], 0x0; pxor xmm3, xmm5
      0xF3, 0x0F, 0x6F, 0x22, 0x66, 0x0F, 0x38, 0x00, 0xA0, 0x00, 0x01, 0x00, 0x00,             // movdqu xmm4, [rdx]; pshufb xmm4, [rax + 0x100]
      0x66, 0x0F, 0xEF, 0xC4, 0x66, 0x0F, 0x6F, 0xE0,                                           // pxor xmm0, xmm4; movdqa xmm4, xmm0
      0x66, 0x0F, 0x3A, 0x44, 0xA0, 0xE0, 0x00, 0x00, 0x00, 0x00, 0x66, 0x0F, 0xEF, 0xCC,       // pclmulqdq xmm4, [rax + 0xe0], 0x0; pxor xmm1, xmm4
      0x66, 0x0F, 0x6F, 0xE0, 0x66, 0x0F, 0x3A, 0x44, 0xA0, 0xE0, 0x00, 0x00, 0x00, 0x11,       // movdqa xmm4, xmm0; pclmulqdq xmm4, [rax + 0xe0], 0x11
      0x66, 0x0F, 0xEF, 0xD4, 0x66, 0x0F, 0x70, 0xE0, 0x4E, 0x66, 0x0F, 0xEF, 0xE0,             // pxor xmm2, xmm4; pshufd xmm4, xmm0, 0x4e; pxor xmm4, xmm0
      0x66, 0x0F, 0x3A, 0x44, 0xA0, 0xF0, 0x00, 0x00, 0x00, 0x00, 0x66, 0x0F, 0xEF, 0xDC,       // pclmulqdq xmm4, [rax + 0xf0], 0x0; pxor xmm3, xmm4
      0x66, 0x0F, 0xEF, 0xD9, 0x66, 0x0F, 0xEF, 0xDA, 0x66, 0x0F, 0x6F, 0xC3,                   // pxor xmm3, xmm1; pxor xmm3, xmm2; movdqa xmm0, xmm3
      0x66, 0x0F, 0x73, 0xF8, 0x08, 0x66, 0x0F, 0xEF, 0xC8, 0x66, 0x0F, 0x73, 0xDB, 0x08,       // pslldq xmm0, 0x8; pxor xmm1, xmm0; psrldq xmm3, 0x8
      0x66, 0x0F, 0xEF, 0xD3, 0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xD0, 0x3F,             // pxor xmm2, xmm3; movdqa xmm0, xmm1; psrlq xmm0, 0x3f
      0x66, 0x0F, 0x6F, 0xDA, 0x66, 0x0F, 0x73, 0xD3, 0x3F, 0x66, 0x0F, 0x73, 0xF1, 0x01,       // movdqa xmm3, xmm2; psrlq xmm3, 0x3f; psllq xmm1, 0x1
      0x66, 0x0F, 0x73, 0xF2, 0x01, 0x66, 0x0F, 0x73, 0xFB, 0x08, 0x66, 0x0F, 0xEB, 0xD3,       // psllq xmm2, 0x1; pslldq xmm3, 0x8; por xmm2, xmm3
      0x66, 0x0F, 0x6F, 0xD8, 0x66, 0x0F, 0x73, 0xDB, 0x08, 0x66, 0x0F, 0xEB, 0xD3,             // movdqa xmm3, xmm0; psrldq xmm3, 0x8; por xmm2, xmm3
      0x66, 0x0F, 0x73, 0xF8, 0x08, 0x66, 0x0F, 0xEB, 0xC8, 0x66, 0x0F, 0x6F, 0xC1,             // pslldq xmm0, 0x8; por xmm1, xmm0; movdqa xmm0, xmm1
      0x66, 0x0F, 0x73, 0xF0, 0x3F, 0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x3E,       // psllq xmm0, 0x3f; movdqa xmm3, xmm1; psllq xmm3, 0x3e
      0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x6F, 0xD9, 0x66, 0x0F, 0x73, 0xF3, 0x39,             // pxor xmm0, xmm3; movdqa xmm3, xmm1; psllq xmm3, 0x39
      0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x73, 0xF8, 0x08, 0x66, 0x0F, 0xEF, 0xC8,             // pxor xmm0, xmm3; pslldq xmm0, 0x8; pxor xmm1, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xD0, 0x01, 0x66, 0x0F, 0x6F, 0xD9,             // movdqa xmm0, xmm1; psrlq xmm0, 0x1; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xD3, 0x02, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x6F, 0xD9,             // psrlq xmm3, 0x2; pxor xmm0, xmm3; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xD3, 0x07, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0xEF, 0xD0,             // psrlq xmm3, 0x7; pxor xmm0, xmm3; pxor xmm2, xmm0
      0x66, 0x0F, 0x6F, 0xC1, 0x66, 0x0F, 0x73, 0xF0, 0x3F, 0x66, 0x0F, 0x6F, 0xD9,             // movdqa xmm0, xmm1; psllq xmm0, 0x3f; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xF3, 0x3E, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x6F, 0xD9,             // psllq xmm3, 0x3e; pxor xmm0, xmm3; movdqa xmm3, xmm1
      0x66, 0x0F, 0x73, 0xF3, 0x39, 0x66, 0x0F, 0xEF, 0xC3, 0x66, 0x0F, 0x73, 0xD8, 0x08,       // psllq xmm3, 0x39; pxor xmm0, xmm3; psrldq xmm0, 0x8
      0x66, 0x0F, 0xEF, 0xD0, 0x66, 0x0F, 0xEF, 0xD1, 0x66, 0x0F, 0x6F, 0xC2,                   // pxor xmm2, xmm0; pxor xmm2, xmm1; movdqa xmm0, xmm2
      0x48, 0x81, 0xC2, 0x80, 0x00, 0x00, 0x00, 0x49, 0xFF, 0xC8,                               // add rdx, 0x80; dec r8
      0x0F, 0x85, 0xF7, 0xFC, 0xFF, 0xFF,                                                       // jne loop8 (rel32 -777, back to the movdqu xmm4, [rdx + 0x70] above)
      0x66, 0x0F, 0x38, 0x00, 0x80, 0x00, 0x01, 0x00, 0x00, 0xF3, 0x0F, 0x7F, 0x01,             // pshufb xmm0, [rax + 0x100]; movdqu [rcx], xmm0
    }
    input arm64 x0 x64 rax = keys
    input arm64 x1 x64 rcx = state
    input arm64 x2 x64 rdx = data
    input arm64 x3 x64 r8 = groups
    clobber arm64 { memory }
    clobber x64 { r9, memory }
  }
}

// `state` = GHASH fold of `blocks` 16-byte blocks at `data` under H at `h`:
// eight at a time when the run is long enough, the rest one at a time.
fn x64GhashBlocks(h: int, state: int, data: int, blocks: u64) {
  let left = int(blocks)
  let p = data
  if (left >= ghashX64AggMin) {
    let tbl = []byte(ghashX64KeysLen + 15)
    let keys = (int(ptrOf(tbl)) + 15) & (0 - 16)
    x64GhashKeys(h, keys)
    let groups = left / 8
    x64GhashGroups(keys, state, p, groups)
    keepAlive(tbl)
    p = p + groups * 128
    left = left - groups * 8
  }
  x64GhashSingles(h, state, p, left)
}

// `x64GhashRun8` over `groups` groups, at most `ghashX64Chunk` blocks per
// opaque asm call.
fn x64GhashGroups(keys: int, state: int, data: int, groups: int) {
  let left = groups
  let p = data
  while (left > 0) {
    let n = left
    if (n > ghashX64Chunk / 8) {
      n = ghashX64Chunk / 8
    }
    x64GhashRun8(keys, state, p, n)
    p = p + n * 128
    left = left - n
  }
}

// `x64GhashRun` over `blocks` blocks, at most `ghashX64Chunk` per opaque
// asm call.
fn x64GhashSingles(h: int, state: int, data: int, blocks: int) {
  let left = blocks
  let p = data
  while (left > 0) {
    let n = left
    if (n > ghashX64Chunk) {
      n = ghashX64Chunk
    }
    x64GhashRun(h, state, p, n)
    p = p + n * 16
    left = left - n
  }
}

// `out` = H*X for H at `h`, X at `x`: one fold of X into a zero state, so
// `out` may alias `h` or `x`; both are read before `out` is written.
fn x64GhashMul(h: int, x: int, out: int) {
  let acc = []byte(16)
  let accAddr = int(ptrOf(acc))
  x64GhashRun(h, accAddr, x, 1)
  let i = 0
  while (i < 16) {
    *ghashByteAt(out + i) = acc[i]
    i = i + 1
  }
}
