// ARM64 crypto hardware-capability detection for Linux (#2520, epic #1224 —
// the ARM64 mirror of ../cryptohw.bit's x86-64 AES-NI/PCLMULQDQ/SHA-NI probes).
//
// `bit_rt_crypto_hwcaps() -> u64` is a bitmask: bit 0 = AES, bit 1 = PMULL,
// bit 2 = SHA2. On aarch64-linux the answer comes from `AT_HWCAP` in the ELF
// auxiliary vector (`runtime/auxv`'s `getauxval`), testing the three ARMv8
// Cryptographic Extension bits Linux's arch/arm64/include/uapi/asm/hwcap.h
// defines: `HWCAP_AES` (1<<3), `HWCAP_PMULL` (1<<4), `HWCAP_SHA2` (1<<6).
//
// x86_64-linux SHARES this OS pair with aarch64-linux — both compile to the
// SAME "linux" archive member per `scripts/g2archive.sh`'s target->PLAT
// mapping, so this one source file is built twice, once per architecture
// (SPEC §11.8: "Bit has no arch-conditional compilation ... a program that
// targets both architectures selects ... at run time"). An x86-64 `AT_HWCAP`
// value has nothing to do with ARM crypto extensions — testing bits 3/4/6 of
// it would be a coincidence, never a fact — so `onX64()` (`runtime/syscalls`,
// the same check `runtime/root/linux/signal.bit` already uses for the
// identical reason) must gate the real read. On x86_64-linux, and on every
// target this module has not been taught, the answer is 0.
//
// CACHED, not recomputed per call: `hwcapsCache` starts at -1 ("not yet
// computed" — a real answer is always in [0, 7], so -1 cannot be confused
// with one) and is set once. Racing writers are harmless, the same "stale
// hint, never wrong" argument `runtime/park/darwin/wait.bit`'s cached mach
// timebase makes: every racing OS thread reads the identical `AT_HWCAP` word
// and computes the identical answer, so the worst a race costs is one
// redundant `getauxval` walk, never a wrong cached value.

import { getauxval, atHwcap } from "../../auxv"
import { onX64 } from "../../syscalls"

const hwcapAes: int = 8    // 1 << 3
const hwcapPmull: int = 16 // 1 << 4
const hwcapSha2: int = 64  // 1 << 6

let hwcapsCache: int = -1

export @symbol("bit_rt_crypto_hwcaps") fn rtCryptoHwcaps(): uint {
  if (hwcapsCache >= 0) {
    return uint(hwcapsCache)
  }
  let caps = detectHwcaps()
  hwcapsCache = caps
  return uint(caps)
}

// The one-time computation `rtCryptoHwcaps` caches. Split out so the caching
// wrapper above stays a two-branch function.
fn detectHwcaps(): int {
  if (onX64()) {
    return 0
  }
  let hw = getauxval(atHwcap)
  let caps = 0
  if ((hw & hwcapAes) != 0) {
    caps = caps | 1
  }
  if ((hw & hwcapPmull) != 0) {
    caps = caps | 2
  }
  if ((hw & hwcapSha2) != 0) {
    caps = caps | 4
  }
  return caps
}
