// ARM64 crypto hardware-capability detection for Darwin (#2520, epic #1224 —
// the ARM64 mirror of ../cryptohw.bit's x86-64 AES-NI/PCLMULQDQ/SHA-NI probes).
//
// `bit_rt_crypto_hwcaps() -> u64` is a bitmask: bit 0 = AES, bit 1 = PMULL,
// bit 2 = SHA2. This project has no x86_64-macos target (`compiler/build.bit`'s
// `BuildTarget` names three targets total, one of them Darwin), so — unlike
// ../linux/cryptohw.bit — no per-architecture branch is needed here: every
// build of this file is aarch64-macos, where Apple Silicon carries the whole
// ARMv8 Cryptographic Extension.
//
// Each flag comes from `sysctlbyname`, read as an `int32_t` exactly like
// `runtime/park/darwin/wait.bit`'s existing `hw.logicalcpu` probe
// (`bit_rt_port_park_cpu_count`) — a present, true feature sysctl reads back
// 1; absent or false reads back 0 or a nonzero `sysctlbyname` return (ENOENT).
// `sysctlFlag` below is that same idiom, generalised to any boolean CPU
// sysctl name and built with a byte-packed `[]byte` (a `[]u8` slice's buffer
// is byte-packed since #3121/#3226 — the older `[]i64`-plus-`writeByte`
// construction `parkCpuCount` uses predates that and is no longer needed).
//
// CACHED, not recomputed per call — see ../linux/cryptohw.bit's header for why
// a racing recompute is harmless (three independent, idempotent syscalls here
// instead of one auxv walk, same argument).

extern fn sysctlbyname(name: *u8, oldp: *i32, oldlenp: *i64, newp: *u8, newlen: i64): i32

let hwcapsCache: int = -1

export @symbol("bit_rt_crypto_hwcaps") fn rtCryptoHwcaps(): uint {
  if (hwcapsCache >= 0) {
    return uint(hwcapsCache)
  }
  let caps = 0
  if (sysctlFlag("hw.optional.arm.FEAT_AES")) {
    caps = caps | 1
  }
  if (sysctlFlag("hw.optional.arm.FEAT_PMULL")) {
    caps = caps | 2
  }
  if (sysctlFlag("hw.optional.arm.FEAT_SHA256")) {
    caps = caps | 4
  }
  hwcapsCache = caps
  return uint(caps)
}

// True when `sysctlbyname(name)` reads back exactly 1, Apple's convention for
// a boolean CPU-feature sysctl. BOUNDED by `len(name)`, a compile-time-known
// literal at every call site above.
fn sysctlFlag(name: string): bool {
  let n = len(name)
  let store = []byte(n + 1)
  let i = 0
  while (i < n) {
    store[i] = name[i]
    i = i + 1
  }
  store[n] = 0

  let out = []i32(1)
  out[0] = 0
  let outLen = []i64(1)
  outLen[0] = 4
  let none: *u8 = nil
  let rc = int(sysctlbyname(ptrOf(store), ptrOf(out), ptrOf(outLen), none, i64(0)))
  if (rc != 0) {
    return false
  }
  return out[0] == 1
}
