// Bit providers for `runtime/cryptohw/`'s 8 ABI symbols (#1811, over #1223's
// x86-64 AES-NI/SHA-NI fast paths). ABI.md §20.
//
// These are ABI-MEMBERSHIP PLACEHOLDERS, not a port. `tests/bit/abimembers.bit`
// requires every `bit_rt_*` the ABI names to have a Bit provider under
// runtime/, one-way and on purpose: a Zig export with no Bit counterpart is exactly
// what G3 would have dropped on the floor. #1223
// predates that gate, which is why its two commits redden `./make test` on a
// tree that is otherwise fine.
//
// PINNED `bit_rt_root_crypto_*`, NOT the bare ABI name. `runtime/root/` still
// defines the real names and claiming them here is a DuplicateSymbol at every link
// (#1624). G2 (#1583) drops the `_root` infix, as for every other pin in this tree.
//
// ---------------------------------------------------------------------------
// READ THIS BEFORE #1583 DROPS THE INFIX
// ---------------------------------------------------------------------------
//
// The bodies below are NOT implementations. While the Zig is live they are dead
// code — nothing reaches them, because every caller links `bit_rt_crypto_*` from
// runtime/root/. The moment the `_root` infix is dropped they become the real symbols,
// and then:
//
//   - the three `hwAvailable*` providers answering `false` are CORRECT and safe:
//     `stdlib/crypto` treats a false answer as "use the constant-time software
//     path", which is the same code every non-x86-64 target already runs.
//   - the five compute providers PANIC rather than returning wrong bytes. They can
//     only be called if something asked for the hardware path after being told it
//     was unavailable, which is a bug in the caller. A panic says so; a zero-filled
//     `out` buffer would be a silent AES that encrypts to garbage, and a silently
//     wrong cipher is the worst failure this file could have.
//
// So porting `runtime/cryptohw/` to Bit is a prerequisite of the rename for PERFORMANCE
// (x86-64 loses its AES-NI/GHASH/SHA-NI acceleration until it happens), never for
// correctness. That tradeoff is deliberate and is the reason these are safe to land
// now: the alternative — forwarding to the Zig symbol via `extern function` — turns
// into infinite recursion the day the infix drops, since the pin and its target
// become the same name.

// `bit_rt_crypto_aes_hw_available`: whether this CPU has the AES instruction set.
// False here means "no Bit-side hardware AES", so callers take the software path.
export @symbol("bit_rt_crypto_aes_hw_available") function rtCryptoAesHwAvailable(): bool {
  return false
}

// `bit_rt_crypto_ghash_hw_available`: carry-less multiply (PCLMULQDQ / PMULL).
export @symbol("bit_rt_crypto_ghash_hw_available") function rtCryptoGhashHwAvailable(): bool {
  return false
}

// `bit_rt_crypto_sha256_hw_available`: the SHA extensions.
export @symbol("bit_rt_crypto_sha256_hw_available") function rtCryptoSha256HwAvailable(): bool {
  return false
}

// `bit_rt_crypto_aes_encrypt_hw(round_keys, nr, block, out)`: one AES block.
// Pointers are raw addresses (`int`), as every other pin in this tree passes them.
export @symbol("bit_rt_crypto_aes_encrypt_hw") function rtCryptoAesEncryptHw(roundKeys: int, nr: int, block: int, out: int) {
  panic("bit_rt_crypto_aes_encrypt_hw: hardware AES requested but unavailable (see runtime/cryptohw/cryptohw.bit)")
}

// `bit_rt_crypto_aes_decrypt_hw(dec_round_keys, nr, block, out)`.
export @symbol("bit_rt_crypto_aes_decrypt_hw") function rtCryptoAesDecryptHw(decRoundKeys: int, nr: int, block: int, out: int) {
  panic("bit_rt_crypto_aes_decrypt_hw: hardware AES requested but unavailable (see runtime/cryptohw/cryptohw.bit)")
}

// `bit_rt_crypto_aes_invert_schedule_hw(enc_round_keys, nr, out)`: the equivalent
// inverse cipher key schedule, for the decrypt path.
export @symbol("bit_rt_crypto_aes_invert_schedule_hw") function rtCryptoAesInvertScheduleHw(encRoundKeys: int, nr: int, out: int) {
  panic("bit_rt_crypto_aes_invert_schedule_hw: hardware AES requested but unavailable (see runtime/cryptohw/cryptohw.bit)")
}

// `bit_rt_crypto_ghash_mul_hw(acc0, acc1, b0, b1, h0, h1, out_hi) -> u64`: one
// GF(2^128) multiply-accumulate. Returns the low word and stores the high word
// through `outHi`, because the ABI has no two-word return.
export @symbol("bit_rt_crypto_ghash_mul_hw") function rtCryptoGhashMulHw(acc0: uint, acc1: uint, b0: uint, b1: uint, h0: uint, h1: uint, outHi: int): uint {
  panic("bit_rt_crypto_ghash_mul_hw: hardware GHASH requested but unavailable (see runtime/cryptohw/cryptohw.bit)")
  return 0
}

// `bit_rt_crypto_sha256_compress_hw(state, block)`: one 64-byte compression.
export @symbol("bit_rt_crypto_sha256_compress_hw") function rtCryptoSha256CompressHw(state: int, block: int) {
  panic("bit_rt_crypto_sha256_compress_hw: hardware SHA-256 requested but unavailable (see runtime/cryptohw/cryptohw.bit)")
}
