// ARM64 counter-mode AES for GCM (#7397): the arm64 arm of
// `bit_rt_crypto_aes_ctr32_hw` (x64aes.bit), the same contract the AES-NI
// arm runs (ABI.md §21b): `blocks` blocks of `dst` = `src` XOR
// AES(counter), the counter and round count read from the caller's 24-byte
// CTR block.
//
// PIPELINING. AESE+AESMC is a fused pair with a multi-cycle latency and
// several issue slots per cycle, so one block per round leaves the units
// idle. The loop runs eight independent counter blocks (v0..v7) through each
// round key, every AESE immediately followed by its own AESMC so the pair
// fuses. Round keys rk[0..nr-2] stream through v16, one load per eight
// pairs; rk[nr-1] and rk[nr] stay in v27/v28 for the whole call. The data is
// XORed with rk[nr] before the last AESE, so the final AddRoundKey and the
// keystream XOR are one EOR per block. v29 holds the counter block; lane 3
// of each block is the 32-bit count in w6, byte-reversed into place, and
// `add w6, w6, #1` wraps modulo 2^32, which is GCM's inc32.
//
// KEY MATERIAL. `rk` is the FIPS-197 forward schedule (`aes.bit`'s
// `roundKeys`, built by `bit_rt_aes_hw_expand_key`), round key i at 16*i
// in FIPS byte order, the order AESE reads its key operand in after LD1.
//
// REGISTERS. v0..v7 and v16..v29 are caller-saved under AAPCS64. The block
// names the caller-saved x6..x8 in `clobber`, so it is a clobber point and
// no live value, a float included, sits in a caller-saved register across it
// (SPEC §11.6). The block rewrites its inputs x1, x4 and x5, which an input
// pins out of the allocator for the whole function.
//
// ENCODING PROVENANCE. No text assembler exists in this compiler (SPEC
// §11.6): every word was assembled from the mnemonic in its comment with
// this Mac's toolchain (`as -arch arm64`) and read back with
// `objdump -d --triple=arm64-apple-darwin`. No word is a `bl` or `blr`.
// Both back edges are `b.ne` with assembler-computed displacements.

// Panics unless this CPU has the ARMv8 AES instructions and `nr` is an AES
// round count: the round loop runs nr-1 times and never ends on nr = 1.
fn armAesCtrRequire(nr: int) {
  aesRequireHwSupport()
  aesRoundsRequire(nr)
}

// `groups` (> 0) eight-block groups of counter mode: block j of the run is
// `dst[16j..]` = `src[16j..]` XOR AES_rk(counter + j), the counter being the
// first 16 bytes of the CTR block at `ctr`. Reads `ctr` and leaves it
// unchanged; the caller advances it. `dst` may equal `src`. Called only
// after `armAesCtrRequire` passed. The x64 arm is a trap: `onX64()` routes
// x86-64 to `x64AesCtrRun`.
fn armAesCtrRun(rk: int, ctr: int, src: int, dst: int, groups: int) {
  let nr = aesCtrRounds(ctr)
  asm volatile {
    x64 { 0x0F, 0x0B } // ud2
    arm64 {
      0x4c40703d,             // ld1.16b {v29}, [x1]
      0xb9400c26,             // ldr w6, [x1, #0xc]
      0x5ac008c6,             // rev w6, w6
      0xd10004a5,             // sub x5, x5, #0x1
      0x8b051008,             // add x8, x0, x5, lsl #4
      0x4c40a11b,             // ld1.16b {v27, v28}, [x8]
      0x5ac008c7, 0x4ebd1fa0, // group: rev w7, w6; mov.16b v0, v29
      0x4e1c1ce0, 0x110004c6, // mov.s v0[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa1, // rev w7, w6; mov.16b v1, v29
      0x4e1c1ce1, 0x110004c6, // mov.s v1[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa2, // rev w7, w6; mov.16b v2, v29
      0x4e1c1ce2, 0x110004c6, // mov.s v2[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa3, // rev w7, w6; mov.16b v3, v29
      0x4e1c1ce3, 0x110004c6, // mov.s v3[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa4, // rev w7, w6; mov.16b v4, v29
      0x4e1c1ce4, 0x110004c6, // mov.s v4[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa5, // rev w7, w6; mov.16b v5, v29
      0x4e1c1ce5, 0x110004c6, // mov.s v5[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa6, // rev w7, w6; mov.16b v6, v29
      0x4e1c1ce6, 0x110004c6, // mov.s v6[3], w7; add w6, w6, #0x1
      0x5ac008c7, 0x4ebd1fa7, // rev w7, w6; mov.16b v7, v29
      0x4e1c1ce7, 0x110004c6, // mov.s v7[3], w7; add w6, w6, #0x1
      0xaa0003e8, 0xaa0503e1, // mov x8, x0; mov x1, x5
      0x4cdf7110,             // round: ld1.16b {v16}, [x8], #16
      0x4e284a00, 0x4e286800, // aese.16b v0, v16; aesmc.16b v0, v0
      0x4e284a01, 0x4e286821, // aese.16b v1, v16; aesmc.16b v1, v1
      0x4e284a02, 0x4e286842, // aese.16b v2, v16; aesmc.16b v2, v2
      0x4e284a03, 0x4e286863, // aese.16b v3, v16; aesmc.16b v3, v3
      0x4e284a04, 0x4e286884, // aese.16b v4, v16; aesmc.16b v4, v4
      0x4e284a05, 0x4e2868a5, // aese.16b v5, v16; aesmc.16b v5, v5
      0x4e284a06, 0x4e2868c6, // aese.16b v6, v16; aesmc.16b v6, v6
      0x4e284a07, 0x4e2868e7, // aese.16b v7, v16; aesmc.16b v7, v7
      0xf1000421,             // subs x1, x1, #0x1
      0x54fffdc1,             // b.ne round (-18 words)
      0x4cdf2050,             // ld1.16b {v16, v17, v18, v19}, [x2], #64
      0x4cdf2054,             // ld1.16b {v20, v21, v22, v23}, [x2], #64
      0x6e3c1e10, 0x6e3c1e31, // eor.16b v16, v16, v28; eor.16b v17, v17, v28
      0x6e3c1e52, 0x6e3c1e73, // eor.16b v18, v18, v28; eor.16b v19, v19, v28
      0x6e3c1e94, 0x6e3c1eb5, // eor.16b v20, v20, v28; eor.16b v21, v21, v28
      0x6e3c1ed6, 0x6e3c1ef7, // eor.16b v22, v22, v28; eor.16b v23, v23, v28
      0x4e284b60, 0x4e284b61, // aese.16b v0, v27; aese.16b v1, v27
      0x4e284b62, 0x4e284b63, // aese.16b v2, v27; aese.16b v3, v27
      0x4e284b64, 0x4e284b65, // aese.16b v4, v27; aese.16b v5, v27
      0x4e284b66, 0x4e284b67, // aese.16b v6, v27; aese.16b v7, v27
      0x6e301c00, 0x6e311c21, // eor.16b v0, v0, v16; eor.16b v1, v1, v17
      0x6e321c42, 0x6e331c63, // eor.16b v2, v2, v18; eor.16b v3, v3, v19
      0x6e341c84, 0x6e351ca5, // eor.16b v4, v4, v20; eor.16b v5, v5, v21
      0x6e361cc6, 0x6e371ce7, // eor.16b v6, v6, v22; eor.16b v7, v7, v23
      0x4c9f2060,             // st1.16b {v0, v1, v2, v3}, [x3], #64
      0x4c9f2064,             // st1.16b {v4, v5, v6, v7}, [x3], #64
      0xf1000484,             // subs x4, x4, #0x1
      0x54fff5c1,             // b.ne group (-82 words)
    }
    input arm64 x0 x64 rax = rk
    input arm64 x1 x64 rcx = ctr
    input arm64 x2 x64 rdx = src
    input arm64 x3 x64 r8 = dst
    input arm64 x4 x64 r9 = groups
    input arm64 x5 x64 r10 = nr
    clobber arm64 { x6, x7, x8, memory }
  }
}
