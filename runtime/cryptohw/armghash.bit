// ARM64 hardware GHASH via the ARMv8 Cryptographic Extension: PMULL/PMULL2,
// the 64x64 -> 128-bit carry-less multiply, for GCM's GF(2^128) universal
// hash (NIST SP 800-38D §6.3). #2523 added the pins; #7403 made the fold one
// asm loop.
//
//   bit_rt_ghash_hw_mul(h: int, x: int, out: int)
//   bit_rt_ghash_hw_blocks(h: int, state: int, data: int, blocks: u64)
//
// Every pointer is a raw address (`int`). `stdlib/crypto/gcm.bit`'s
// `gcmAbsorbHw` and `gcmGhashHw` call them, gated on `AesGcm.pmull`.
//
// PLATFORM-FREE: no OS service is needed, so this file compiles once per
// TARGET (SPEC §11.8). On x86_64 both pins route to the PCLMULQDQ code in
// `x64ghash.bit` (#7385); `onX64()` folds to the target's answer, so the
// untaken arch's arm is deleted. Every pin first calls
// `ghashRequireHwSupport`, because PMULL and PCLMULQDQ are optional.
//
// THE ALGORITHM. `LD1` then `REV64` then `EXT #8` turns 16 wire bytes into
// the bit-reflected field element: lane 0 holds bytes 8..15 and lane 1 bytes
// 0..7, each as a big-endian u64. The product of two reflected 128-bit values
// is reflected over 255 bits, one short of the 256-bit register pair, so H is
// multiplied by x once up front ("twisted": shifted left one bit, the carry
// reduced by 0xc2 << 56 in the high lane) and every product comes out
// aligned. A product is Karatsuba: PMULL lo*lo, PMULL2 hi*hi and one PMULL of
// (lo^hi)(lo^hi), the last against a precomputed lo^hi of the key. The 256-bit
// result is reduced modulo x^128 + x^7 + x^2 + x + 1 by two PMULLs against
// 0xc200000000000000 (the reflected polynomial's low terms), each folding 64
// bits. This is the construction of Gueron and Kounavis's Intel GCM paper, as
// the Linux arm64 ghash-ce and OpenSSL ghashv8 code run it.
//
// AGGREGATION. Four blocks fold with one reduction: for state S and blocks
// D0..D3, the next state is (S^D0)H^4 ^ D1 H^3 ^ D2 H^2 ^ D3 H, the four
// unreduced Karatsuba products XORed lane-wise first. `armGhashKeys` computes
// the twisted H^2..H^4 with the same multiply: twisted A times twisted B
// yields twisted AB, because the multiply removes one factor of x. A run
// shorter than four blocks skips the powers.
//
// REGISTERS. Only v0..v7 and v16..v27, all AAPCS64 caller-saved. Each block
// names a caller-saved GPR in `clobber`, so it is a clobber point and no live
// value, a float included, sits in a caller-saved register across it (SPEC
// §11.6). The blocks advance their pointer and count inputs in place, which an
// input pins out of the allocator for the whole function.
//
// ENCODING PROVENANCE. No text assembler exists in this compiler (SPEC
// §11.6): every word was assembled from the mnemonic in its comment with
// this Mac's toolchain (`as -arch arm64`) and read back with
// `objdump -d --triple=arm64-apple-darwin`. No word is a `bl` or `blr`;
// every branch displacement is the assembler's.
//
// CHUNKED FOR THE COLLECTOR. The run block is opaque and holds no safepoint,
// so one call folds at most `ghashArmChunk` blocks (64 KiB) and a large
// buffer still reaches the Bit loop's back edge, and its safepoint.

const ghashArmChunk: int = 4096

fn ghashRequireHwSupport() {
  if ((bit_rt_crypto_hwcaps() & 2) == 0) {
    panic("bit_rt_ghash_hw: carry-less multiply (PMULL or PCLMULQDQ) not available on this CPU")
  }
}

// A `*byte` at raw address `addr`: the "nil plus byte offset" idiom
// `armaes.bit`'s `aesByteAt` uses; `x64ghash.bit` reads through it too.
fn ghashByteAt(addr: int): *byte {
  let z: *byte = nil
  return z + addr
}

// Writes the 64-byte key table at `keys`: twisted H (from the 16 wire bytes
// at `h`), then twisted H^2, H^3 and H^4 when `blocks` >= 4, each in the
// reflected lane layout the run loop loads. The x64 arm is a trap.
fn armGhashKeys(h: int, keys: int, blocks: int) {
  asm volatile {
    x64 { 0x0F, 0x0B } // ud2
    arm64 {
      0x4c407000, 0x4e200800, // ld1.16b {v0}, [x0]; rev64.16b v0, v0
      0x6e004000, 0x4f07e427, // ext.16b v0, v0, v0, #8; movi.16b v7, #0xe1
      0x4f7954e7, 0x6f410402, // shl.2d v7, v7, #57; ushr.2d v2, v0, #63
      0x4e1c0403, 0x4f210463, // dup.4s v3, v0[3]; sshr.4s v3, v3, #31
      0x6e024042, 0x4f415400, // ext.16b v2, v2, v2, #8; shl.2d v0, v0, #1
      0x4ea21c00, 0x6f00e404, // orr.16b v0, v0, v2; movi.2d v4, #0
      0x6e074084, 0x4e231c84, // ext.16b v4, v4, v7, #8; and.16b v4, v4, v3
      0x6e241c00, 0x4c9f7020, // eor.16b v0, v0, v4; st1.16b {v0}, [x1], #16
      0xf100105f, 0x54000743, // cmp x2, #4; b.lo end (+58 words)
      0x6e004006, 0x6e201cc6, // ext.16b v6, v0, v0, #8; eor.16b v6, v6, v0
      0x4ea01c01, 0x6e014022, // mov.16b v1, v0; ext.16b v2, v1, v1, #8
      0x6e211c42, 0x4ee0e024, // eor.16b v2, v2, v1; pmull2.1q v4, v1, v0
      0x0ee0e021, 0x0ee6e045, // pmull.1q v1, v1, v0; pmull.1q v5, v2, v6
      0x6e044022, 0x6e241c23, // ext.16b v2, v1, v4, #8; eor.16b v3, v1, v4
      0x6e231ca5, 0x6e221ca5, // eor.16b v5, v5, v3; eor.16b v5, v5, v2
      0x0ee7e023, 0x6e0844a4, // pmull.1q v3, v1, v7; mov.d v4[0], v5[1]
      0x6e180425, 0x6e231ca1, // mov.d v5[1], v1[0]; eor.16b v1, v5, v3
      0x6e014023, 0x0ee7e021, // ext.16b v3, v1, v1, #8; pmull.1q v1, v1, v7
      0x6e241c63, 0x6e231c21, // eor.16b v3, v3, v4; eor.16b v1, v1, v3
      0x4c9f7021, 0x6e014022, // st1.16b {v1}, [x1], #16; ext.16b v2, v1, v1, #8
      0x6e211c42, 0x4ee0e024, // eor.16b v2, v2, v1; pmull2.1q v4, v1, v0
      0x0ee0e021, 0x0ee6e045, // pmull.1q v1, v1, v0; pmull.1q v5, v2, v6
      0x6e044022, 0x6e241c23, // ext.16b v2, v1, v4, #8; eor.16b v3, v1, v4
      0x6e231ca5, 0x6e221ca5, // eor.16b v5, v5, v3; eor.16b v5, v5, v2
      0x0ee7e023, 0x6e0844a4, // pmull.1q v3, v1, v7; mov.d v4[0], v5[1]
      0x6e180425, 0x6e231ca1, // mov.d v5[1], v1[0]; eor.16b v1, v5, v3
      0x6e014023, 0x0ee7e021, // ext.16b v3, v1, v1, #8; pmull.1q v1, v1, v7
      0x6e241c63, 0x6e231c21, // eor.16b v3, v3, v4; eor.16b v1, v1, v3
      0x4c9f7021, 0x6e014022, // st1.16b {v1}, [x1], #16; ext.16b v2, v1, v1, #8
      0x6e211c42, 0x4ee0e024, // eor.16b v2, v2, v1; pmull2.1q v4, v1, v0
      0x0ee0e021, 0x0ee6e045, // pmull.1q v1, v1, v0; pmull.1q v5, v2, v6
      0x6e044022, 0x6e241c23, // ext.16b v2, v1, v4, #8; eor.16b v3, v1, v4
      0x6e231ca5, 0x6e221ca5, // eor.16b v5, v5, v3; eor.16b v5, v5, v2
      0x0ee7e023, 0x6e0844a4, // pmull.1q v3, v1, v7; mov.d v4[0], v5[1]
      0x6e180425, 0x6e231ca1, // mov.d v5[1], v1[0]; eor.16b v1, v5, v3
      0x6e014023, 0x0ee7e021, // ext.16b v3, v1, v1, #8; pmull.1q v1, v1, v7
      0x6e241c63, 0x6e231c21, // eor.16b v3, v3, v4; eor.16b v1, v1, v3
      0x4c007021,             // st1.16b {v1}, [x1]
    }
    input arm64 x0 x64 rax = h
    input arm64 x1 x64 rcx = keys
    input arm64 x2 x64 rdx = blocks
    clobber arm64 { x3, memory }
  }
}

// Folds `blocks` (> 0, <= ghashArmChunk) 16-byte blocks at `data` into the
// 16-byte state at `state`, under the table `armGhashKeys` wrote at `keys`
// for a run at least this long: four blocks per reduction while four remain,
// then one at a time. The x64 arm is a trap.
fn armGhashRun(keys: int, state: int, data: int, blocks: int) {
  asm volatile {
    x64 { 0x0F, 0x0B } // ud2
    arm64 {
      0x4c402010, 0x4f07e427, // ld1.16b {v16, v17, v18, v19}, [x0]; movi.16b v7, #0xe1
      0x4f7954e7, 0x6e104206, // shl.2d v7, v7, #57; ext.16b v6, v16, v16, #8
      0x6e301cc6, 0x4ed12a14, // eor.16b v6, v6, v16; trn1.2d v20, v16, v17
      0x4ed16a02, 0x6e221e94, // trn2.2d v2, v16, v17; eor.16b v20, v20, v2
      0x4ed32a55, 0x4ed36a42, // trn1.2d v21, v18, v19; trn2.2d v2, v18, v19
      0x6e221eb5, 0x4c407021, // eor.16b v21, v21, v2; ld1.16b {v1}, [x1]
      0x4e200821, 0x6e014021, // rev64.16b v1, v1; ext.16b v1, v1, v1, #8
      0xf100107f, 0x54000703, // cmp x3, #4; b.lo one (+56 words)
      0x4cdf2058, 0x4e200b18, // four: ld1.16b {v24, v25, v26, v27}, [x2], #64; rev64.16b v24, v24
      0x6e184318, 0x4e200b39, // ext.16b v24, v24, v24, #8; rev64.16b v25, v25
      0x6e194339, 0x4e200b5a, // ext.16b v25, v25, v25, #8; rev64.16b v26, v26
      0x6e1a435a, 0x4e200b7b, // ext.16b v26, v26, v26, #8; rev64.16b v27, v27
      0x6e1b437b, 0x6e211f18, // ext.16b v27, v27, v27, #8; eor.16b v24, v24, v1
      0x6e184302, 0x6e381c42, // ext.16b v2, v24, v24, #8; eor.16b v2, v2, v24
      0x0ef3e301, 0x4ef3e304, // pmull.1q v1, v24, v19; pmull2.1q v4, v24, v19
      0x4ef5e045, 0x6e194322, // pmull2.1q v5, v2, v21; ext.16b v2, v25, v25, #8
      0x6e391c42, 0x0ef2e323, // eor.16b v2, v2, v25; pmull.1q v3, v25, v18
      0x6e231c21, 0x4ef2e323, // eor.16b v1, v1, v3; pmull2.1q v3, v25, v18
      0x6e231c84, 0x0ef5e043, // eor.16b v4, v4, v3; pmull.1q v3, v2, v21
      0x6e231ca5, 0x6e1a4342, // eor.16b v5, v5, v3; ext.16b v2, v26, v26, #8
      0x6e3a1c42, 0x0ef1e343, // eor.16b v2, v2, v26; pmull.1q v3, v26, v17
      0x6e231c21, 0x4ef1e343, // eor.16b v1, v1, v3; pmull2.1q v3, v26, v17
      0x6e231c84, 0x4ef4e043, // eor.16b v4, v4, v3; pmull2.1q v3, v2, v20
      0x6e231ca5, 0x6e1b4362, // eor.16b v5, v5, v3; ext.16b v2, v27, v27, #8
      0x6e3b1c42, 0x0ef0e363, // eor.16b v2, v2, v27; pmull.1q v3, v27, v16
      0x6e231c21, 0x4ef0e363, // eor.16b v1, v1, v3; pmull2.1q v3, v27, v16
      0x6e231c84, 0x0ef4e043, // eor.16b v4, v4, v3; pmull.1q v3, v2, v20
      0x6e231ca5, 0x6e044022, // eor.16b v5, v5, v3; ext.16b v2, v1, v4, #8
      0x6e241c23, 0x6e231ca5, // eor.16b v3, v1, v4; eor.16b v5, v5, v3
      0x6e221ca5, 0x0ee7e023, // eor.16b v5, v5, v2; pmull.1q v3, v1, v7
      0x6e0844a4, 0x6e180425, // mov.d v4[0], v5[1]; mov.d v5[1], v1[0]
      0x6e231ca1, 0x6e014023, // eor.16b v1, v5, v3; ext.16b v3, v1, v1, #8
      0x0ee7e021, 0x6e241c63, // pmull.1q v1, v1, v7; eor.16b v3, v3, v4
      0x6e231c21, 0xd1001063, // eor.16b v1, v1, v3; sub x3, x3, #4
      0xf100107f, 0x54fff962, // cmp x3, #4; b.hs four (-53 words)
      0xb4000303,             // cbz x3, done (+24 words)
      0x4cdf7042, 0x4e200842, // one: ld1.16b {v2}, [x2], #16; rev64.16b v2, v2
      0x6e024042, 0x6e221c21, // ext.16b v2, v2, v2, #8; eor.16b v1, v1, v2
      0x6e014022, 0x6e211c42, // ext.16b v2, v1, v1, #8; eor.16b v2, v2, v1
      0x4ef0e024, 0x0ef0e021, // pmull2.1q v4, v1, v16; pmull.1q v1, v1, v16
      0x0ee6e045, 0x6e044022, // pmull.1q v5, v2, v6; ext.16b v2, v1, v4, #8
      0x6e241c23, 0x6e231ca5, // eor.16b v3, v1, v4; eor.16b v5, v5, v3
      0x6e221ca5, 0x0ee7e023, // eor.16b v5, v5, v2; pmull.1q v3, v1, v7
      0x6e0844a4, 0x6e180425, // mov.d v4[0], v5[1]; mov.d v5[1], v1[0]
      0x6e231ca1, 0x6e014023, // eor.16b v1, v5, v3; ext.16b v3, v1, v1, #8
      0x0ee7e021, 0x6e241c63, // pmull.1q v1, v1, v7; eor.16b v3, v3, v4
      0x6e231c21, 0xf1000463, // eor.16b v1, v1, v3; subs x3, x3, #1
      0x54fffd41,             // b.ne one (-22 words)
      0x6e014021, 0x4e200821, // done: ext.16b v1, v1, v1, #8; rev64.16b v1, v1
      0x4c007021,             // st1.16b {v1}, [x1]
    }
    input arm64 x0 x64 rax = keys
    input arm64 x1 x64 rcx = state
    input arm64 x2 x64 rdx = data
    input arm64 x3 x64 r8 = blocks
    clobber arm64 { x4, memory }
  }
}

// `state` = GHASH fold of `blocks` blocks at `data` under H at `h`, at most
// `ghashArmChunk` blocks per opaque asm call. The key table is built once.
fn armGhashBlocks(h: int, state: int, data: int, blocks: int) {
  let keys = []byte(64)
  let k = int(ptrOf(keys))
  armGhashKeys(h, k, blocks)
  let left = blocks
  let p = data
  while (left > 0) {
    let n = left
    if (n > ghashArmChunk) {
      n = ghashArmChunk
    }
    armGhashRun(k, state, p, n)
    p = p + n * 16
    left = left - n
  }
  keepAlive(keys)
}

// `bit_rt_ghash_hw_mul(h, x, out)`: `out` = H*X in GF(2^128), GCM bit order,
// as one fold of X into a zero state, so `out` may alias `h` or `x`: both
// are read before `out` is written.
export @symbol("bit_rt_ghash_hw_mul") fn rtGhashHwMul(h: int, x: int, out: int) {
  ghashRequireHwSupport()
  if (onX64()) {
    x64GhashMul(h, x, out)
    return
  }
  let acc = []byte(16)
  armGhashBlocks(h, int(ptrOf(acc)), x, 1)
  let i = 0
  while (i < 16) {
    *ghashByteAt(out + i) = acc[i]
    i = i + 1
  }
}

// `bit_rt_ghash_hw_blocks(h, state, data, blocks)`: folds `blocks` 16-byte
// blocks at `data` into the GHASH state at `state` (mutated in place), under
// subkey H at `h`: state = (state XOR block) * H, once per block, in order,
// the recurrence `stdlib/crypto/gcm.bit`'s software `gcmAbsorb` implements.
export @symbol("bit_rt_ghash_hw_blocks") fn rtGhashHwBlocks(
  h: int,
  state: int,
  data: int,
  blocks: u64,
) {
  ghashRequireHwSupport()
  if (onX64()) {
    x64GhashBlocks(h, state, data, blocks)
    return
  }
  armGhashBlocks(h, state, data, int(blocks))
}
