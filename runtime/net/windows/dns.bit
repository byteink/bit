// Windows DNS resolution for the Stage-2 port of runtime/net/ (#3589, epic
// #3322). Split out of ./sock.bit, mirroring ../darwin/dns.bit's own split;
// same module, so the constants, buffers and helpers there (and in
// ./sock.bit, ./udp.bit) are in scope unchanged.
//
// TWO HALVES, AND ONLY ONE OF THEM IS NEW. `netDnsSocket`/`netResolveHost`
// below are the identical shape as ../linux/udp.bit's and
// ../darwin/dns.bit's own twins: a blocking UDP socket with a receive
// timeout, speaking ../../net's already platform-free DNS wire codec
// (`netBuildQuery`/`netParseAnswer`) to a nameserver passed in as a
// parameter. NONE of that is touched or reimplemented here.
//
// `nameserversFromAdapters` is what is actually new (#3589's whole point):
// Windows has no `/etc/resolv.conf` for ../linux/netabi.bit's
// `readResolvConf` + ../../net's `netFirstNameserver` to read. The
// equivalent is `GetAdaptersAddresses` (iphlpapi.dll) -- a linked list of
// Windows-specific structures, not a text file, so this is genuinely new
// provider code rather than a file-read swap.

import {
  netDnsId, netBuildQuery, netParseAnswer, netMaxDnsMsg,
  netNsTimeoutOff, netNsPortOff, netNsPortStepOff, netNsAttemptsOff, netNsConfOff,
  netNsConfLenOff, netAdapterDnsStride, dnsBytes, getU64Le, netAdapterDnsServers,
  netMaxAdapterDns, netAdapterEntryScopeOff, netSa6ScopeOff,
} from "../../net"

// ---------------------------------------------------------------------------
// The DNS socket and resolver (unchanged shape from ../darwin/dns.bit)
// ---------------------------------------------------------------------------

// SOL_SOCKET/SO_RCVTIMEO (winsock2.h). WINDOWS-SPECIFIC SHAPE: `optval` is a
// raw DWORD of MILLISECONDS here, NOT a `struct timeval` -- the BSD shape
// ../linux and ../darwin's `class timeval`/`tvBytes` machinery builds.
// Getting this wrong does not fail to compile or fail loudly: it reads a
// timeval-shaped buffer's first four bytes as a millisecond count, which for
// the caller's `timeoutMs` (a small number of milliseconds, written as
// the timeval's SECONDS field by mistake) would silently install a timeout
// of a few milliseconds instead of a few seconds -- so the value is written
// with `putU32Le` directly, never through `tvBytes()`.
@nosplit fn soRcvTimeo(): int { return 0x1006 }

// WSAETIMEDOUT (winerror.h) -- what a BLOCKING socket's SO_RCVTIMEO
// expiring actually reports on Windows. `wsaEwouldblock` (./udp.bit) is
// the NON-blocking-socket "try again" error and does not apply to this
// socket, which is never put into non-blocking mode; both are accepted
// below purely as defence in depth.
@nosplit fn wsaEtimedout(): int { return 10060 }

// A BLOCKING UDP socket of address `family` (`afInet()` or `afInet6()`) with
// SO_RCVTIMEO, matching ../darwin/dns.bit's own rationale exactly: DNS is an
// occasional millisecond cost, so a bounded receive timeout buys a real error on
// packet loss without putting timer-driven wakes on the poller. Blocks the
// calling worker for up to `timeoutMs` on a lost packet.
export @symbol("bit_rt_port_net_dns_socket") @nosplit fn netDnsSocket(
  family: int,
  timeoutMs: int,
): int {
  let fd = wsaRc(int(socket(i32(family), i32(sockDgram()), i32(ipprotoUdp()))))
  if (fd < 0) {
    return 0 - 1
  }
  putU32Le(optBytes(), 0, timeoutMs)
  if (wsaRc(
      int(
        setsockopt(
          i64(fd), i32(solSocket()), i32(soRcvTimeo()),
          optBytes(), i32(4),
        ),
      ),
    ) <
    0) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// True when the list entry at `e` (`netAdapterDnsStride` bytes, ../adapters.bit)
// is an IPv4 server: the IPv4-mapped form `::ffff:a.b.c.d`.
@nosplit fn netEntryIsV4(e: *u8): bool {
  let k = 0
  while (k < 10) {
    if (getU8(e, k) != 0) {
      return false
    }
    k = k + 1
  }
  return getU8(e, 10) == 255 && getU8(e, 11) == 255
}

// Lays the nameserver `entry` out as a `sockaddr_in` or `sockaddr_in6` asked on
// `port`, in the per-worker scratch `sa6Bytes()`. Returns the address's length,
// the `namelen` `sendto` wants. A link-local server's scope id rides along, or
// the datagram has no interface to leave on.
@nosplit fn netEntrySockAddr(entry: *u8, port: int): int {
  if (netEntryIsV4(entry)) {
    netFillSockAddr(sa6Bytes(), entry + 12, port)
    return saLen
  }
  netFillSockAddr6(sa6Bytes(), entry, port)
  putU32Le(sa6Bytes(), netSa6ScopeOff, getU32Le(entry, netAdapterEntryScopeOff))
  return sa6Len
}

// Sends the query to the address `netEntrySockAddr` laid out and waits for the
// one reply on `fd`. True when an answer carries an A record, written to `out`.
// A timeout, a hard error, a malformed answer and one with no A record all leave
// it false: the caller's next pass is the retry.
@nosplit fn netDnsExchange(fd: int, qlen: int, salen: int, out: *u8): bool {
  let query = dnsBytes()
  if (wsaRc(int(sendto(i64(fd), query, i32(qlen), i32(0), sa6Bytes(), i32(salen)))) < 0) {
    return false
  }
  let reply = dnsBytes() + netMaxDnsMsg
  let noneAddr: *u8 = nil
  let noneLen: *i32 = nil
  let got = wsaRc(int(recvfrom(i64(fd), reply, i32(netMaxDnsMsg), i32(0), noneAddr, noneLen)))
  return got >= 0 && netParseAnswer(reply, got, netDnsId, out)
}

// Resolve `host` to an IPv4 address, written to `out`. A dotted quad passes
// straight through; a hostname is queried against the nameserver `entry` (one
// entry of the list `nameserversFromAdapters` fills, IPv4 or IPv6), asked on the
// port the resolve block `ns` carries at `netNsPortOff` and waiting at most the
// window it carries after its address (`netNsTimeoutOff`, `std/net`'s, #6350),
// ONE attempt. Still an A-record query over either transport. The attempt count
// is the caller's (`netResolvePasses`, ./netabi.bit), which goes round the
// nameserver list once per attempt.
//
// THE NAMESERVER AND ITS PORT ARE PARAMETERS RATHER THAN DISCOVERED HERE,
// matching ../linux/udp.bit's and ../darwin/dns.bit's identical contract:
// discovery is a platform call (`nameserversFromAdapters`, below), kept out of
// this function so it can be pointed at an in-process fake nameserver on an
// ephemeral port for testing without depending on the real network
// (`_tests_/bit/windowssmoke.bit` does).
export @symbol("bit_rt_port_net_resolve") @nosplit fn netResolveHost(
  host: *u8,
  hostLen: int,
  ns: *u8,
  entry: *u8,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let qlen = netBuildQuery(dnsBytes(), netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  let family = afInet6()
  if (netEntryIsV4(entry)) {
    family = afInet()
  }
  let fd = netDnsSocket(family, getU64Le(ns, netNsTimeoutOff))
  if (fd < 0) {
    return false
  }
  let salen = netEntrySockAddr(entry, getU64Le(ns, netNsPortOff))
  let ok = netDnsExchange(fd, qlen, salen, out)
  netClose(fd)
  return ok
}

// ---------------------------------------------------------------------------
// Nameserver discovery (#3589) -- the genuinely new half. Windows has no
// /etc/resolv.conf; the equivalent is GetAdaptersAddresses (iphlpapi.dll),
// admitted as a FIFTH DLL alongside kernel32/bcrypt/kernelbase/ws2_32
// (compiler/pesyms.bit).
//
// GetAdaptersAddresses OVER THE OLDER GetNetworkParams: Microsoft's own
// reference for GetNetworkParams documents it as returning at most one
// machine-wide primary/secondary DNS server with no per-adapter context, so
// it "may not return the correct value" on a machine with more than one
// adapter. GetAdaptersAddresses returns every adapter's own configured
// server list AND its OperStatus, which is what lets this function skip a
// disabled/disconnected adapter's stale configuration -- GetNetworkParams
// has no such signal at all.
// ---------------------------------------------------------------------------

// GetAdaptersAddresses(family, flags, reserved, addresses, sizePointer) ->
// ULONG (0 == ERROR_SUCCESS, 111 == ERROR_BUFFER_OVERFLOW). iphlpapi.dll.
extern fn GetAdaptersAddresses(
  family: i32,
  flags: i32,
  reserved: *byte,
  addresses: *byte,
  sizePointer: *i32,
): i32

@nosplit fn afUnspec(): i32 { return i32(0) }

// GAA_FLAG_SKIP_UNICAST | GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST
// (iptypes.h): this call only ever reads FirstDnsServerAddress, so every
// other linked list GetAdaptersAddresses would otherwise populate is
// skipped -- less work for the OS, and one fewer list this file has no use
// for and therefore does not need to walk correctly.
@nosplit fn gaaSkipFlags(): i32 { return i32(0x0007) }

const errorBufferOverflow: int = 111

// Buffer sizing for the retry loop below (Power of 10 rule 3: bounded,
// never grows without limit). 16 KiB is Microsoft's own documented starting
// guess; 256 KiB is a hard ceiling far past any real adapter count.
const gaaInitialWords: int = 2048
const gaaMaxWords: int = 32768
const gaaMaxAttempts: int = 3

// Every DNS server address, IPv4 or IPv6, configured on any UP adapter,
// deduplicated, in adapter order, written to `list` as packed
// `netAdapterDnsStride`-byte entries (room for `capacity`). Returns how many; 0 when
// the call fails or no adapter has one. The
// parse is `netAdapterDnsServers` (../adapters.bit), a platform-free walk
// `_tests_/stress/netadapters` runs over a hand-built chain.
//
// POLL-FREE (#1658/#3924): refused `@nosplit` purely because it allocates the
// MANAGED `[]i64(words)`/`[]i64(1)` scratch below -- E0075 forbids allocation
// outright, and that is the whole reason, not a raw address surviving
// anything. `buf`/`bufPtr` are read within THIS iteration only: the two paths
// that use `bufPtr` (`return netAdapterDnsServers(...)` on success, `return 0`
// on a fatal GetAdaptersAddresses error) both leave the function without taking
// the loop's back edge again, and the one path that DOES take the back edge
// (ERROR_BUFFER_OVERFLOW, to retry with a bigger `words`) never reads
// `buf`/`bufPtr` again -- it discards them and allocates a fresh, larger buffer
// next iteration. So no poll is ever reached while a live use of the raw
// address remains outstanding; see `pollFreeExceptions`'s (g4b) group in
// `_tests_/bit/pollfree/exceptions2.bit`, the identical shape.
fn nameserversFromAdapters(list: *u8, capacity: int): int {
  let words = gaaInitialWords
  let attempt = 0
  // Bounded (Power of 10): the adapter list can change between two calls
  // (Microsoft's own documented reason ERROR_BUFFER_OVERFLOW can recur), so
  // this retries with the OS-reported size rather than looping forever.
  while (attempt < gaaMaxAttempts) {
    let buf = []i64(words)
    let bufPtr = int(ptrOf(buf))
    let sizeBuf = []i64(1)
    let sizeBytes = bytesAtI64(ptrOf(sizeBuf))
    putU32Le(sizeBytes, 0, words * 8)
    let rc = int(
      GetAdaptersAddresses(
        afUnspec(), gaaSkipFlags(), nilByte(),
        bytesAt(bufPtr), i32PtrAt(int(ptrOf(sizeBuf))),
      ),
    )
    if (rc == 0) {
      return netAdapterDnsServers(bufPtr, list, capacity)
    }
    if (rc != errorBufferOverflow) {
      return 0
    }
    let needed = getU32Le(sizeBytes, 0)
    words = (needed + 7) / 8
    if (words > gaaMaxWords) {
      words = gaaMaxWords
    }
    attempt = attempt + 1
  }
  return 0
}
