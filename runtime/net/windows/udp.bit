// The UDP section of the Windows socket provider, split out of ./sock.bit
// (#3340), mirroring ../linux/udp.bit's own split. Sibling file, same
// module.
//
// UDP NEEDS NONE OF THIS FILE'S TCP SIBLING'S MACHINERY — no AcceptEx (no
// connection to accept), no ConnectEx (a bound, unconnected socket sends to
// whatever address each `sendto` names), so the ordinary non-blocking
// `sendto`/`recvfrom` plus the readiness-translation poller (`netAwaitReady`,
// ./sock.bit) is both sufficient and the simpler path — the SAME shape
// ../linux/udp.bit and ../darwin/udp.bit already use, just with `ioctlsocket
// (FIONBIO)` standing in for Linux's `SOCK_NONBLOCK`-at-creation flag.

// `netParseIpv4`/`netMaxStalls`/`saBytes`/`ipBytes` are already imported by
// ../tcp.bit (imports are module-scoped); only the names it does NOT bring
// in are imported here.
import { netMaxSpins, saBytes2 } from "../../net"
import { pollRead, pollWrite } from "../../sched"

// FIONBIO (winsock2.h) — set non-blocking mode. Windows has no equivalent
// of Linux's `SOCK_NONBLOCK` creation flag or Darwin's `fcntl`, so this is
// the one way to get there, applied right after `socket()`.
fn fionbio(): i32 { return i32(0x8004667E) }

// WSAEWOULDBLOCK (winsock2.h) — the non-blocking-socket "try again" error,
// Windows' analogue of `EAGAIN`.
fn wsaEwouldblock(): int { return 10035 }

fn netSetNonBlockUdp(fd: int): bool {
  let one = []i64(1)
  one[0] = i64(1)
  return wsaRc(int(ioctlsocket(i64(fd), fionbio(), bytesAtI64(ptrOf(one))))) >= 0
}

export @symbol("bit_rt_port_net_bind_udp") fn netBindUdp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(true)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netSetNonBlockUdp(fd)) {
    netClose(fd)
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// One datagram of `data[0..dataLen]` to `host:port` from `fd`. Returns the
// byte count, or -1.
export @symbol("bit_rt_port_net_send_to") fn netSendTo(fd: int, host: *u8, hostLen: int, port: int, data: *u8, dataLen: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  netFillSockAddr(saBytes2(), ip, port)
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let n = wsaRc(int(sendto(i64(fd), data, i32(dataLen), i32(0), saBytes2(), i32(16))))
    if (n >= 0) {
      return n
    }
    if (lastErr() != wsaEwouldblock()) {
      return 0 - 1
    }
    if (netAwaitReady(fd, pollWrite)) {
      stalls = stalls + 1
    } else {
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Up to `bufCap` bytes of the next datagram on `fd`, parking until one
// arrives, writing the sender's raw sockaddr to `peer` (which must hold
// `netSockAddrLen()` bytes, matching ../linux/udp.bit's contract). Returns
// the byte count, or -1.
export @symbol("bit_rt_port_net_recv_from") fn netRecvFrom(fd: int, buf: *u8, bufCap: int, peer: *u8): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let lenBuf = []i64(1)
    lenBuf[0] = i64(16)
    let n = wsaRc(int(recvfrom(i64(fd), buf, i32(bufCap), i32(0), peer, i32PtrAt(int(ptrOf(lenBuf))))))
    if (n >= 0) {
      return n
    }
    if (lastErr() != wsaEwouldblock()) {
      return 0 - 1
    }
    if (netAwaitReady(fd, pollRead)) {
      stalls = stalls + 1
    } else {
      spins = spins + 1
    }
  }
  return 0 - 1
}
