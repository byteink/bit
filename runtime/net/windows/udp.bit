// UDP uses real overlapped operations: a zero-byte readiness receive consumes
// a datagram, and a zero-byte readiness send emits one (#8023).
extern fn WSARecvFrom(
  sock: i64, buffers: *byte, count: i32, bytes: *byte, flags: *byte,
  from: *u8, fromLen: *i32, overlapped: *byte, completion: *byte,
): i32
extern fn WSASendTo(
  sock: i64, buffers: *byte, count: i32, bytes: *byte, flags: i32,
  to: *u8, toLen: i32, overlapped: *byte, completion: *byte,
): i32

// FIONBIO (winsock2.h) — set non-blocking mode. Windows has no equivalent
// of Linux's `SOCK_NONBLOCK` creation flag or Darwin's `fcntl`, so this is
// the one way to get there, applied right after `socket()`.
@nosplit fn fionbio(): i32 { return i32(0x8004667E) }

// Also used by the deadline-bounded DNS exchange in dns.bit.
@nosplit fn wsaEwouldblock(): int { return 10035 }

fn netSetNonBlockUdp(fd: int): bool {
  let one = []i64(1)
  one[0] = i64(1)
  return wsaRc(int(ioctlsocket(i64(fd), fionbio(), bytesAtI64(ptrOf(one))))) >= 0
}

export @symbol("bit_rt_port_net_bind_udp") fn netBindUdp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(true)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netSetNonBlockUdp(fd)) {
    netClose(fd)
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// All terminal paths read the result before releasing its static IOCP slot.
// A synchronous failure has no completion packet and must disarm the park.
fn udpFinish(slot: int, posted: bool): int {
  if (!posted) {
    pollOpAbort(slot)
    let _ = schedParkDisarm()
    return 0 - 1
  }
  pollOpCommit(slot)
  schedPark()
  let n = pollOpBytes(slot)
  let status = pollOpStatus(slot)
  pollOpRelease(slot)
  if (status != 0) {
    return 0 - 1
  }
  return n
}

fn udpSend(fd: int, data: *u8, dataLen: int, target: *u8): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 1
  }
  let slot = armAndClaim(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 1
  }
  fillWsabuf(pollOpWsabuf(slot), data, dataLen)
  let rc = int(
    WSASendTo(
      i64(fd), pollOpWsabuf(slot), i32(1), nilByte(), i32(0),
      target, i32(saLen), pollOpOverlapped(slot), nilByte(),
    ),
  )
  // Capture the thread-local error before an ordinary call can grow or migrate.
  let posted = rc == 0 || int(WSAGetLastError()) == wsaIoPending()
  let n = udpFinish(slot, posted)
  if (n != dataLen) {
    return 0 - 1
  }
  return n
}

export @symbol("bit_rt_port_net_send_to") fn netSendTo(
  fd: int, host: *u8, hostLen: int, port: int, data: *u8, dataLen: int,
): int {
  let ip = []i64(1)
  let target = []i64(2)
  if (!netParseIpv4(host, hostLen, bytesAtI64(ptrOf(ip)))) {
    return 0 - 1
  }
  netFillSockAddr(bytesAtI64(ptrOf(target)), bytesAtI64(ptrOf(ip)), port)
  let n = udpSend(fd, data, dataLen, bytesAtI64(ptrOf(target)))
  keepAlive(target)
  return n
}

// The caller roots payload and peer. Managed flags/length remain live until
// terminal completion, including zero-length datagrams and truncation errors.
export @symbol("bit_rt_port_net_recv_from") fn netRecvFrom(
  fd: int, buf: *u8, bufCap: int, peer: *u8,
): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 1
  }
  let state = []i64(2)
  state[1] = i64(saLen)
  let slot = armAndClaim(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 1
  }
  fillWsabuf(pollOpWsabuf(slot), buf, bufCap)
  let rc = int(
    WSARecvFrom(
      i64(fd), pollOpWsabuf(slot), i32(1), nilByte(), bytesAtI64(ptrOf(state)),
      peer, i32PtrAt(int(ptrOf(state) + 1)), pollOpOverlapped(slot), nilByte(),
    ),
  )
  // Capture the thread-local error before an ordinary call can grow or migrate.
  let posted = rc == 0 || int(WSAGetLastError()) == wsaIoPending()
  let n = udpFinish(slot, posted)
  keepAlive(state)
  return n
}
