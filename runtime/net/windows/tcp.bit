// The TCP section of the Windows socket provider, split out of ./sock.bit
// (#3340), mirroring ../linux/tcp.bit's own split. Sibling file, same
// module: the raw calls, GUID-resolved AcceptEx/ConnectEx, the error shim
// and the address layout all live in ./sock.bit and need no import here.
//
// EVERY REAL OP (accept/dial/read/write) FOLLOWS THE IDENTICAL FIVE-STEP
// SHAPE, because it is the one correct way to keep an OVERLAPPED alive for
// its whole async window (trap #5) while still being able to unwind
// cleanly on every failure branch:
//
//   1. schedParkArm() — opens the window a completion cannot race past
//      unnoticed (../linux/sock.bit's "THE ARM/REGISTER/PARK ORDER IS THE
//      PROTOCOL" applies here identically, one layer up).
//   2. pollClaimOp(pollFd, sock, task) — claims a slot from
//      ../../sched/windows/poll.bit's pool; ITS OVERLAPPED now has a fixed
//      address that will not move or be reused until step 5's
//      pollOpRelease.
//   3. Issue the real Win32 call (AcceptEx/ConnectEx/WSARecv/WSASend) with
//      that OVERLAPPED. `rc == 0 || WSAGetLastError() == wsaIoPending()` is
//      success (trap #4); anything else is a HARD failure that never
//      reached the OS, so `pollOpAbort` (not `pollOpRelease`) is correct —
//      the slot was never counted as outstanding.
//   4. pollOpCommit(slot); schedPark() — sleep until the completion port
//      wakes this task.
//   5. pollOpBytes(slot) / pollOpStatus(slot) — read the result — THEN
//      pollOpRelease(slot). Reading before releasing is what makes trap #5
//      hold on the completion path: another claimer cannot reuse the slot
//      while this task still owns its result.
//
// A hard failure at step 3 closes whatever socket it just created/claimed
// itself; a completion-time failure (`pollOpStatus(slot) != 0`) is handled
// by each entry point's own caller-visible contract, matching the sibling
// providers' "an error reads as empty/failure" convention.

import { netParseIpv4, netMaxStalls, netClampDeadline, netDeadlineMaxWaitNs } from "../../net"
import { saBytes, ipBytes, netSockAddrPort } from "../../net"
import {
  pollClaimOp, pollOpOverlapped, pollOpWsabuf, pollOpCommit,
  pollOpAbort, pollOpBytes, pollOpStatus, pollOpRelease, pollAssociate,
  pollDrain,
} from "../../sched/windows"
import { parkMonoNs } from "../../park/windows"

// `CancelIoEx` (ioapiset.h, kernel32.dll — admitted at compiler/pesyms.bit,
// #3590) cancels one specific outstanding OVERLAPPED on a handle without
// disturbing any other op in flight on it — unlike the deprecated `CancelIo`,
// it can cancel an op issued by a different thread than the one calling it,
// which is what lets the deadline-bounded trio below cancel from the SAME
// task that posted the op (no cross-thread call here, but the same property
// is what makes the technique sound in general).
extern fn CancelIoEx(hFile: i64, lpOverlapped: *byte): i32

// ---------------------------------------------------------------------------
// TCP
// ---------------------------------------------------------------------------

export @symbol("bit_rt_port_net_listen_tcp") @nosplit fn netListenTcp(
  host: *u8,
  hostLen: int,
  port: int,
  backlog: int,
): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - lastErr()
  }
  if (!netSetReuseAddr(fd)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  if (!netSysListen(fd, backlog)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  return fd
}

export @symbol("bit_rt_port_net_local_port") fn netSockLocalPort(fd: int): int {
  let lenBuf = []i64(1)
  lenBuf[0] = i64(saLenConst())
  if (wsaRc(int(getsockname(i64(fd), saBytes(), i32PtrAt(int(ptrOf(lenBuf)))))) < 0) {
    return 0 - 1
  }
  return netSockAddrPort(saBytes())
}

// `saLen` (../../net's core const) under a local name: ../net.bit's
// `saLen` clashes with nothing here, but a fresh accessor avoids adding yet
// another cross-module import for one constant only this function needs.
@nosplit fn saLenConst(): int { return 16 }

// Claim a slot and arm the park for `sock` — the shared prefix of every
// real-op entry point below (steps 1-2 of this file's header). Returns the
// slot, or `-1` if EITHER step failed, in which case the park is already
// correctly disarmed and nothing further should be attempted.
fn armAndClaim(pollFd: int, sock: int, taskAddr: int): int {
  if (!schedParkArm()) {
    return 0 - 1
  }
  let slot = pollClaimOp(pollFd, sock, taskAddr)
  if (slot < 0) {
    let _ = schedParkDisarm()
    return 0 - 1
  }
  return slot
}

// Accept one connection via AcceptEx, parking until it completes. Returns
// the accepted socket, or a negative value on failure.
// Issue AcceptEx on `accSock` (already created, unbound) and park for its
// completion — steps 2-5 of this file's header. Returns `0` on success, else
// a negative diagnostic code; the caller closes `accSock` on any failure.
fn acceptIssue(pollFd: int, taskAddr: int, lfd: int, accSock: int): int {
  // MANAGED scratch (#1668-style — see ../linux/sock.bit's "WHY THE BUFFERS
  // HERE ARE MANAGED" for the general rule this file also follows): every
  // buffer AcceptEx's OVERLAPPED op can still be writing to, or that the
  // trampoline call still needs to read from, must survive the park below
  // as a stack-map-visible local, not a raw address.
  //
  // AcceptEx's own output buffer: 2 * (sockaddr_in(16) + 16 slack) = 64
  // bytes — required by AcceptEx even though this file never reads it (no
  // caller here wants the pre-received-data or peer-address feature).
  let outBuf = []i64(8)
  let recvBytes = []i64(1)
  let args = []i64(4)

  let slot = armAndClaim(pollFd, accSock, taskAddr)
  if (slot < 0) {
    return 0 - 5
  }
  args[0] = i64(32)
  args[1] = i64(32)
  args[2] = i64(int(bytesAtI64(ptrOf(recvBytes))))
  args[3] = i64(int(pollOpOverlapped(slot)))
  let rc = acceptExCall(int(acceptExPtr), lfd, accSock, int(ptrOf(outBuf)), int(ptrOf(args)))
  if (rc == 0 && int(WSAGetLastError()) != wsaIoPending()) {
    let we = int(WSAGetLastError())
    pollOpAbort(slot)
    return 0 - (6000 + we)
  }
  pollOpCommit(slot)
  schedPark()
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0 - (7000 + st % 100000)
  }
  return 0
}

export @symbol("bit_rt_port_net_accept_tcp") fn netAcceptTcp(lfd: int): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 2
  }
  if (!resolveExtensionFns(lfd)) {
    return 0 - (3000 + lastErr())
  }
  // AcceptEx's completion is posted via the LISTENING socket's own IOCP
  // association, not the accept socket's — `pollClaimOp` (inside
  // `acceptIssue`) associates ONLY `accSock` (correctly, for the read/write
  // ops that come after a successful accept), so `lfd` needs its own,
  // separate, idempotent association here. MUTATION-FOUND BUG, kept as a
  // comment: without this call AcceptEx's OVERLAPPED never completes at
  // all — `schedPark()` inside `acceptIssue` then hangs forever, because
  // nothing was ever going to post to `pollFd` for `lfd`. Reproduced on
  // real hardware (mustafa-desktop-win): the accept task parked
  // indefinitely and the peer's own `ConnectEx` still completed (the
  // kernel's SYN backlog needs no application-level accept to finish the
  // handshake), so only the accept side visibly hung.
  if (!pollAssociate(pollFd, lfd)) {
    return 0 - (9000 + lastErr())
  }
  let accSock = netSysSocket(false)
  if (accSock < 0) {
    return 0 - (4000 + lastErr())
  }
  let issueRc = acceptIssue(pollFd, taskAddr, lfd, accSock)
  if (issueRc != 0) {
    netClose(accSock)
    return issueRc
  }
  if (!netSetUpdateAcceptContext(accSock, lfd)) {
    let we = lastErr()
    netClose(accSock)
    return 0 - (8000 + we)
  }
  return accSock
}

// Trap #2: bind the socket to the wildcard address before ConnectEx can be
// resolved/called at all — split out of `netDialTcp` to keep its own
// complexity under the lint ceiling.
fn dialPrep(fd: int): int {
  let zero = []i64(2)
  netFillSockAddr(bytesAtI64(ptrOf(zero)), zeroIp(), 0)
  if (!netSysBind(fd, bytesAtI64(ptrOf(zero)))) {
    return 0 - (1000 + lastErr())
  }
  if (!resolveExtensionFns(fd)) {
    return 0 - (2000 + lastErr())
  }
  return 0
}

// Issue ConnectEx and park for its completion (steps 2-5 of this file's
// header), once `fd` is already bound. Returns `0` on a successful
// handshake, else a negative diagnostic code — the caller closes `fd`
// either way.
fn dialConnect(pollFd: int, taskAddr: int, fd: int, ip: *u8, port: int): int {
  // MANAGED scratch, same reasoning as `netAcceptTcp`'s: `target` (the
  // sockaddr ConnectEx connects to) is read by the OS for the whole async
  // window, not just at the call.
  let target = []i64(2)
  netFillSockAddr(bytesAtI64(ptrOf(target)), ip, port)
  let sentBytes = []i64(1)
  let args = []i64(3)

  let slot = armAndClaim(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 3
  }
  args[0] = i64(0)
  args[1] = i64(int(bytesAtI64(ptrOf(sentBytes))))
  args[2] = i64(int(pollOpOverlapped(slot)))
  let rc = connectExCall(
    int(connectExPtr),
    fd,
    int(bytesAtI64(ptrOf(target))),
    16,
    int(ptrOf(args)),
  )
  if (rc == 0 && int(WSAGetLastError()) != wsaIoPending()) {
    let we = int(WSAGetLastError())
    pollOpAbort(slot)
    return 0 - (4000 + we)
  }
  pollOpCommit(slot)
  schedPark()
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0 - (5000 + st % 100000)
  }
  return 0
}

// Connect to `host:port` via ConnectEx, parking until the handshake
// finishes.
export @symbol("bit_rt_port_net_dial_tcp") fn netDialTcp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 2
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - (6000 + lastErr())
  }
  let prepRc = dialPrep(fd)
  if (prepRc != 0) {
    netClose(fd)
    return prepRc
  }
  let connectRc = dialConnect(pollFd, taskAddr, fd, ip, port)
  if (connectRc != 0) {
    netClose(fd)
    return connectRc
  }
  let _ = netSetUpdateConnectContext(fd)
  return fd
}

// Four zero octets — `netDialTcp`'s bind target is the wildcard address.
fn zeroIp(): *u8 {
  let z = []i64(1)
  return bytesAtI64(ptrOf(z))
}

// Read up to `bufCap` bytes into `buf` via WSARecv, parking until some
// arrive. `0` means the peer closed OR an I/O error occurred — this
// provider does not distinguish them at the completion boundary (poll.bit's
// own header: a zero-byte-transferred completion cannot tell "closed" from
// "errored" apart either), matching every other provider's documented "an
// I/O error reads as empty too" convention.
export @symbol("bit_rt_port_net_read_sock") fn netReadSock(fd: int, buf: *u8, bufCap: int): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 1
  }
  let slot = armAndClaim(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 1
  }
  fillWsabuf(pollOpWsabuf(slot), buf, bufCap)
  let flags = []i64(1)
  let bytesOut = []i64(1)
  let rc = int(
    WSARecv(
      i64(fd), pollOpWsabuf(slot), i32(1), bytesAtI64(ptrOf(bytesOut)),
      bytesAtI64(ptrOf(flags)), pollOpOverlapped(slot), nilByte(),
    ),
  )
  if (rc != 0 && int(WSAGetLastError()) != wsaIoPending()) {
    pollOpAbort(slot)
    return 0 - 1
  }
  pollOpCommit(slot)
  schedPark()
  let n = pollOpBytes(slot)
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0
  }
  return n
}

// Writes {len, buf} into the WSABUF at `wb` — a plain 16-byte struct
// (`ULONG len; char *buf;`, matching ../../sched/windows/poll.bit's own
// `wsabufWords` layout: word 0 is len+pad, word 1 is buf).
@nosplit fn fillWsabuf(wb: *byte, buf: *u8, n: int) {
  let words = i64PtrAt(int(wb))
  *words = i64(n)
  *(words + 1) = i64(int(buf))
}

@nosplit fn i64PtrAt(addr: int): *i64 {
  let z: *i64 = nil
  return z + addr / 8
}

// SHUT_BOTH (winsock2.h) — matches ../linux/tcp.bit's `netShutRdwr`, same
// value (2) and the same reason: tearing down a connection always means
// both directions.
const netShutBoth: int = 2

export @symbol("bit_rt_port_net_shutdown_sock") @nosplit fn netShutdownSock(fd: int): bool {
  return wsaRc(int(shutdown(i64(fd), i32(netShutBoth)))) >= 0
}

// Write all `n` bytes of `buf` via WSASend, parking whenever the send
// buffer is full. A short completion is retried, mirroring
// ../linux/tcp.bit's `netWriteSock` loop shape exactly, one overlapped op
// per iteration instead of one non-blocking retry.
export @symbol("bit_rt_port_net_write_sock") fn netWriteSock(fd: int, buf: *u8, n: int): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 1
  }
  let off = 0
  let stalls = 0
  while (off < n && stalls < netMaxStalls) {
    let wrote = writeOnce(pollFd, taskAddr, fd, buf + off, n - off)
    if (wrote <= 0) {
      return 0 - 1
    }
    off = off + wrote
    stalls = stalls + 1
  }
  if (off < n) {
    return 0 - 1
  }
  return off
}

// One WSASend op, the five-step shape from this file's header. Returns the
// bytes actually sent, or `-1` on any failure (post-time or completion-time).
fn writeOnce(pollFd: int, taskAddr: int, fd: int, buf: *u8, want: int): int {
  let slot = armAndClaim(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 1
  }
  fillWsabuf(pollOpWsabuf(slot), buf, want)
  let bytesOut = []i64(1)
  let rc = int(
    WSASend(
      i64(fd), pollOpWsabuf(slot), i32(1), bytesAtI64(ptrOf(bytesOut)),
      i32(0), pollOpOverlapped(slot), nilByte(),
    ),
  )
  if (rc != 0 && int(WSAGetLastError()) != wsaIoPending()) {
    pollOpAbort(slot)
    return 0 - 1
  }
  pollOpCommit(slot)
  schedPark()
  let n = pollOpBytes(slot)
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0 - 1
  }
  return n
}

// ---------------------------------------------------------------------------
// Deadline-bounded dial/read/write (#2291, in-flight wait bounded by #3590)
// ---------------------------------------------------------------------------
//
// A caller that dials/reads/writes with an already-past deadline gets
// `netDeadlineTimedOut` immediately, exactly as the other providers do for
// that case (unchanged). What #3590 fixes: once ConnectEx/WSARecv/WSASend is
// posted, the wait is now ALSO bounded — before, this file parked unbounded
// from there (the plain entry points' own `schedPark()` behaviour), so a
// peer that accepted but never wrote left a caller's short read deadline
// meaningless.
//
// THE FIX ADDS NO SCHEDULER PRIMITIVE (the ticket's approach (a), left to
// its own design pass — racing a real timed park against a completion-port
// wake for the SAME task risks a double-wake on `taskState`, per
// `schedParkArm`'s own header in ../../sched/task.bit). Approach (b) instead:
// the three entry points below never call `schedParkArm`/`schedPark` at all,
// so they never enter that arm/park state machine and there is nothing to
// race. Each drives `pollDrain` DIRECTLY on its own thread in a bounded loop,
// reading completion straight off the claimed slot's own OVERLAPPED
// (`Internal`, the same field the documented `HasOverlappedIoCompleted`
// macro checks) instead of waiting to be woken — a completion racing this
// loop is simply observed on the next iteration, never lost, because nothing
// here depends on a one-shot wake edge. Once the deadline elapses with the
// op still pending, `CancelIoEx` cancels exactly that OVERLAPPED, and the
// loop keeps draining (bounded separately) until the cancellation's own
// completion has been collected — REQUIRED by Win32: a cancelled overlapped
// op still posts to the completion port (`ERROR_OPERATION_ABORTED`), and not
// draining it leaks that completion packet forever. Only once that drain
// finishes is the slot released: releasing while cancellation is merely
// REQUESTED (not yet synchronously complete) would free memory the kernel
// might still be writing into — the same "OVERLAPPED must outlive the op"
// hazard this file's header already calls out for the ordinary path.
//
// A genuine completion racing the cancel (the op finished a moment before
// `CancelIoEx` reached the kernel) is not forced into a false timeout: the
// drained result's own `pollOpStatus` is what the caller reads either way,
// so a benign win in that race reports the real bytes, not a manufactured
// `netDeadlineTimedOut`.

// The deadline elapsed before the operation completed — matches
// ../linux/tcp.bit's `netDeadlineTimedOut` sentinel exactly.
const netDeadlineTimedOut: int = 0 - 2

fn netClockNowNs(): int {
  let scratch = []i64(2)
  return parkMonoNs(ptrOf(scratch))
}

// STATUS_PENDING (ntstatus.h) — the value Windows writes into an OVERLAPPED's
// `Internal` field the moment an async op is accepted, and the only value
// the documented `HasOverlappedIoCompleted` macro treats as "still
// outstanding" (`((DWORD)(lpOverlapped)->Internal) != STATUS_PENDING`).
// `pollClaimOp` zeroes the slot's OVERLAPPED before the real Win32 call is
// issued; the OS overwrites word 0 with this sentinel as part of accepting
// the op, before ever returning `WSA_IO_PENDING` to the caller.
const winStatusPending: int = 0x103

// True while `slot`'s op is still outstanding — read directly off its own
// OVERLAPPED rather than through `pollOpStatus`, which is meaningless until
// the op is known complete (a genuine `STATUS_SUCCESS` completion and "not
// completed yet" both read as `0` there).
fn opPending(slot: int): bool {
  return *i64PtrAt(int(pollOpOverlapped(slot))) == i64(winStatusPending)
}

// The scheduler-struct address `pollDrain` expects — the same raw address
// `currentPollFd` derives one field over, kept un-wrapped (not `taskAt`) to
// match `pollDrain`'s own `let s = taskAt(schedAddr)` parameter contract.
// `0` means no scheduler is bound, exactly as `currentPollFd`/
// `currentTaskAddr` already report it. `@nosplit`: calls only
// `schedCurrentTask`/`taskAt`, the same two `currentPollFd`/`currentTaskAddr`
// (#3595) already call as `@nosplit` — confirmed against the compiler, not
// assumed (`bit check` reports zero E0075 findings once marked).
@nosplit fn currentSchedAddr(): int {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return 0
  }
  let wAddr = *(taskAt(taskAddr) + taskWorker)
  if (wAddr == 0) {
    return 0
  }
  return *(taskAt(wAddr) + wkSched)
}

// Poll interval for the drain loops below, in ms — the
// `GetQueuedCompletionStatusEx` timeout per iteration, matching
// ../linux/tcp.bit's own `netDeadlinePollNs` (2ms) granularity.
const netDeadlinePollMs: int = 2

// Worst-case iterations of the wait loop before the deadline itself must
// have elapsed (Power of 10 rule 2, no `while (true)`): the ceiling
// `netClampDeadline` ever allows, divided by the poll interval, plus slack —
// the deadline check inside the loop is what actually ends every real call.
const netDeadlineMaxPolls: int = netDeadlineMaxWaitNs / (netDeadlinePollMs * 1000000) + 16

// Iterations to wait for a CANCELLED op's own completion to drain, once
// `CancelIoEx` has been issued. Generous but bounded: Windows guarantees a
// cancelled overlapped op still posts to the completion port, so this is not
// expected to run to its limit — it exists only so a kernel-level anomaly
// cannot wedge this call forever.
const netCancelDrainMaxPolls: int = 500

// Request cancellation of `slot`'s op on `sock` and drain until its (now
// aborted) completion has been collected — REQUIRED before the caller may
// release the slot; see this section's header for why. Returns false in the
// one case that must NOT release: `netCancelDrainMaxPolls` exhausted with
// the OVERLAPPED still reporting pending. Windows guarantees a cancelled (or
// already-completed) op always posts to the completion port, so this is not
// expected to fire — but if it ever did, releasing anyway would let a NEW
// claimer's WSARecv/WSASend reuse this OVERLAPPED while the OS might still
// be writing into it, a genuine use-after-free the GC cannot see. The
// alternative this function chooses instead is to sacrifice the one slot
// permanently (never released, never reused) rather than risk that.
fn cancelAndDrain(schedAddr: int, slot: int, sock: int): bool {
  let _ = CancelIoEx(i64(sock), pollOpOverlapped(slot))
  let polls = 0
  while (polls < netCancelDrainMaxPolls && opPending(slot)) {
    polls = polls + 1
    let _ = pollDrain(schedAddr, netDeadlinePollMs)
  }
  return !opPending(slot)
}

// `awaitSlotDeadline`'s three outcomes — a plain `int` sentinel, not a tuple:
// this module builds `--freestanding` (`g2archive.sh`) and a multi-value
// return allocates on the managed heap, which that build forbids (`bit:
// this module allocates on the managed heap`, caught by actually building
// the target rather than assumed — `bit check` alone does not catch it).
const awaitCompleted: int = 0
const awaitTimedOutSafe: int = 1
const awaitTimedOutUnsafe: int = 2

// Wait for `slot`'s completion, bounded by `deadlineNs` (absolute monotonic
// ns) — the deadline-bounded replacement for this file's ordinary
// `pollOpCommit(slot); schedPark()` step 4, used only by the three deadline
// entry points below.
//   awaitCompleted      a genuine completion landed before the deadline —
//                       `pollOpBytes`/`pollOpStatus` are safe to read, then
//                       release.
//   awaitTimedOutSafe   the deadline elapsed; the op was cancelled and its
//                       completion drained — release, do not read a result.
//   awaitTimedOutUnsafe the deadline elapsed AND the cancelled completion
//                       never drained within `cancelAndDrain`'s own bound —
//                       the caller must NOT release (see `cancelAndDrain`'s
//                       header).
fn awaitSlotDeadline(slot: int, sock: int, deadlineNs: int): int {
  let schedAddr = currentSchedAddr()
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    if (!opPending(slot)) {
      return awaitCompleted
    }
    if (netClockNowNs() >= deadlineNs) {
      if (cancelAndDrain(schedAddr, slot, sock)) {
        return awaitTimedOutSafe
      }
      return awaitTimedOutUnsafe
    }
    let _ = pollDrain(schedAddr, netDeadlinePollMs)
  }
  if (cancelAndDrain(schedAddr, slot, sock)) {
    return awaitTimedOutSafe
  }
  return awaitTimedOutUnsafe
}

// Issue ConnectEx and wait, bounded by `deadline` — the deadline twin of
// `dialConnect` above, sharing its exact shape except step 4. Derives
// `pollFd`/`taskAddr` itself (E0202: a 6th param over the limit) rather than
// taking them from the caller, which already re-derives them once anyway
// for its own precondition check — cheap and idempotent, same as
// `netReadSockDeadline` already does inline.
fn dialConnectDeadline(fd: int, ip: *u8, port: int, deadline: int): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  let target = []i64(2)
  netFillSockAddr(bytesAtI64(ptrOf(target)), ip, port)
  let sentBytes = []i64(1)
  let args = []i64(3)

  let slot = pollClaimOp(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 3
  }
  args[0] = i64(0)
  args[1] = i64(int(bytesAtI64(ptrOf(sentBytes))))
  args[2] = i64(int(pollOpOverlapped(slot)))
  let rc = connectExCall(
    int(connectExPtr),
    fd,
    int(bytesAtI64(ptrOf(target))),
    16,
    int(ptrOf(args)),
  )
  if (rc == 0 && int(WSAGetLastError()) != wsaIoPending()) {
    let we = int(WSAGetLastError())
    pollOpAbort(slot)
    return 0 - (4000 + we)
  }
  pollOpCommit(slot)
  let awaited = awaitSlotDeadline(slot, fd, deadline)
  if (awaited != awaitCompleted) {
    if (awaited == awaitTimedOutSafe) {
      pollOpRelease(slot)
    }
    return netDeadlineTimedOut
  }
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0 - (5000 + st % 100000)
  }
  return 0
}

export @symbol("bit_rt_port_net_dial_tcp_deadline") fn netDialTcpDeadline(
  host: *u8,
  hostLen: int,
  port: int,
  deadlineNs: int,
): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 2
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - (6000 + lastErr())
  }
  let prepRc = dialPrep(fd)
  if (prepRc != 0) {
    netClose(fd)
    return prepRc
  }
  let connectRc = dialConnectDeadline(fd, ip, port, deadline)
  if (connectRc != 0) {
    netClose(fd)
    return connectRc
  }
  let _ = netSetUpdateConnectContext(fd)
  return fd
}

export @symbol("bit_rt_port_net_read_sock_deadline") fn netReadSockDeadline(
  fd: int,
  buf: *u8,
  bufCap: int,
  deadlineNs: int,
): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 1
  }
  let slot = pollClaimOp(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 1
  }
  fillWsabuf(pollOpWsabuf(slot), buf, bufCap)
  let flags = []i64(1)
  let bytesOut = []i64(1)
  let rc = int(
    WSARecv(
      i64(fd), pollOpWsabuf(slot), i32(1), bytesAtI64(ptrOf(bytesOut)),
      bytesAtI64(ptrOf(flags)), pollOpOverlapped(slot), nilByte(),
    ),
  )
  if (rc != 0 && int(WSAGetLastError()) != wsaIoPending()) {
    pollOpAbort(slot)
    return 0 - 1
  }
  pollOpCommit(slot)
  let awaited = awaitSlotDeadline(slot, fd, deadline)
  if (awaited != awaitCompleted) {
    if (awaited == awaitTimedOutSafe) {
      pollOpRelease(slot)
    }
    return netDeadlineTimedOut
  }
  let n = pollOpBytes(slot)
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0
  }
  return n
}

// One WSASend op bounded by `deadline` — the deadline twin of `writeOnce`
// above, sharing its exact shape except step 4. Derives `pollFd`/`taskAddr`
// itself, same reason as `dialConnectDeadline`'s own header note (E0202).
fn writeOnceDeadline(fd: int, buf: *u8, want: int, deadline: int): int {
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  let slot = pollClaimOp(pollFd, fd, taskAddr)
  if (slot < 0) {
    return 0 - 1
  }
  fillWsabuf(pollOpWsabuf(slot), buf, want)
  let bytesOut = []i64(1)
  let rc = int(
    WSASend(
      i64(fd), pollOpWsabuf(slot), i32(1), bytesAtI64(ptrOf(bytesOut)),
      i32(0), pollOpOverlapped(slot), nilByte(),
    ),
  )
  if (rc != 0 && int(WSAGetLastError()) != wsaIoPending()) {
    pollOpAbort(slot)
    return 0 - 1
  }
  pollOpCommit(slot)
  let awaited = awaitSlotDeadline(slot, fd, deadline)
  if (awaited != awaitCompleted) {
    if (awaited == awaitTimedOutSafe) {
      pollOpRelease(slot)
    }
    return netDeadlineTimedOut
  }
  let m = pollOpBytes(slot)
  let st = pollOpStatus(slot)
  pollOpRelease(slot)
  if (st != 0) {
    return 0 - 1
  }
  return m
}

export @symbol("bit_rt_port_net_write_sock_deadline") fn netWriteSockDeadline(
  fd: int,
  buf: *u8,
  n: int,
  deadlineNs: int,
): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  let pollFd = currentPollFd()
  let taskAddr = currentTaskAddr()
  if (pollFd == 0 || taskAddr == 0) {
    return 0 - 1
  }
  let off = 0
  let stalls = 0
  while (off < n && stalls < netMaxStalls) {
    if (netClockNowNs() >= deadline) {
      return netDeadlineTimedOut
    }
    let wrote = writeOnceDeadline(fd, buf + off, n - off, deadline)
    if (wrote == netDeadlineTimedOut) {
      return netDeadlineTimedOut
    }
    if (wrote <= 0) {
      return 0 - 1
    }
    off = off + wrote
    stalls = stalls + 1
  }
  if (off < n) {
    return 0 - 1
  }
  return off
}
