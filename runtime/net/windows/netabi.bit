// SEAM 1 of the Windows runtime port (#3340, epic #3322): the `bit_rt_net_*`
// ABI wrappers (ABI.md §20) over this provider's socket engine (./sock.bit,
// ./tcp.bit, ./udp.bit, and, since #3589, ./dns.bit for hostname
// resolution). Byte-for-byte the same shape as ../linux/netabi.bit and
// ../darwin/netabi.bit — see either for the full rationale (why the
// wrappers live per-platform, why the buffers here are managed `[]i64`
// rather than raw `rtStrAlloc` addresses across a park). This file
// duplicates their marshalling body rather than sharing it, for the
// identical reason: the only thing that differs between the three is which
// socket/resolver engine the sibling names resolve to.

import { loadByte, storeByte } from "../../gc"
import {
  emptyStr, u8At, scratchWords, strData, strSizeOf,
  strFromPacked, netDnsArgsOk, netNsBlockBytes, putU64Le, netFormatOctets,
} from "../../net"

// ---------------------------------------------------------------------------
// TCP (ABI.md §20)
// ---------------------------------------------------------------------------

export @symbol("bit_rt_net_listen") @nosplit fn netAbiListen(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netListenTcp(strData(host), strSizeOf(host), port, 512)
}

export @symbol("bit_rt_net_local_port") fn netAbiLocalPort(fd: int): int {
  return netSockLocalPort(fd)
}

// `@nosplit`, unlike `netAbiLocalPort` above it: ./sock.bit's `netSockPeerAddr`
// is itself `@nosplit` (it uses the module-static `lenBytes()` scratch for its
// out-parameter, where ./tcp.bit's `netSockLocalPort` allocates a `[]i64(1)`),
// so E0075's transitive closure holds here and this wrapper needs no
// `_tests_/bit/pollfree` exception. Writes the 16-byte wire form, ABI.md §20;
// `_w` because `std/net` reaches it by `extern fn`, see ../darwin/netabi.bit.
export @symbol("bit_rt_net_peer_addr_w") @nosplit fn netAbiPeerAddrW(fd: int, outWords: int): int {
  if (outWords == 0) {
    return 0 - 1
  }
  return netSockPeerAddr(fd, u8At(outWords))
}

export @symbol("bit_rt_net_accept") fn netAbiAccept(fd: int): int {
  return netAcceptTcp(fd)
}

export @symbol("bit_rt_net_dial") fn netAbiDial(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netDialTcp(strData(host), strSizeOf(host), port)
}

export @symbol("bit_rt_net_read") fn netAbiRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let scratch = []i64(scratchWords(max))
  let n = netReadSock(fd, u8At(int(ptrOf(scratch))), max)
  if (n <= 0) {
    return emptyStr()
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

export @symbol("bit_rt_net_write") fn netAbiWrite(fd: int, s: int): int {
  return netWriteSock(fd, strData(s), strSizeOf(s))
}

// ---------------------------------------------------------------------------
// Deadline-bounded dial/read/write (#2291) — see ../tcp.bit's own header for
// this provider's documented gap (pre-flight deadline check only, an
// in-flight async wait is not bounded).
// ---------------------------------------------------------------------------

const netAbiMaxHost: int = 255
const netAbiMaxBody: int = 67108864

export @symbol("bit_rt_net_dial_deadline_w") fn netAbiDialDeadlineW(
  hostWords: int,
  hostLen: int,
  port: int,
  deadlineNs: int,
): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  if (hostWords == 0 || hostLen <= 0 || hostLen > netAbiMaxHost) {
    return 0 - 1
  }
  let scratch = []i64(scratchWords(hostLen))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < hostLen) {
    storeByte(packed + i, loadByte(hostWords + i))
    i = i + 1
  }
  return netDialTcpDeadline(u8At(packed), hostLen, port, deadlineNs)
}

export @symbol("bit_rt_net_read_deadline_w") fn netAbiReadDeadlineW(
  fd: int,
  outWords: int,
  bufCap: int,
  deadlineNs: int,
): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  let scratch = []i64(scratchWords(bufCap))
  let packed = int(ptrOf(scratch))
  let n = netReadSockDeadline(fd, u8At(packed), bufCap, deadlineNs)
  if (n <= 0) {
    return n
  }
  let i = 0
  while (i < n) {
    storeByte(outWords + i, loadByte(packed + i))
    i = i + 1
  }
  return n
}

export @symbol("bit_rt_net_write_deadline_w") fn netAbiWriteDeadlineW(
  fd: int,
  words: int,
  n: int,
  deadlineNs: int,
): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  let scratch = []i64(scratchWords(n))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < n) {
    storeByte(packed + i, loadByte(words + i))
    i = i + 1
  }
  return netWriteSockDeadline(fd, u8At(packed), n, deadlineNs)
}

// `bit_rt_net_write_bytes_w` (#5928): `bit_rt_net_write`'s byte-taking
// sibling, same `words`/`n` shape as `bit_rt_net_write_deadline_w` above —
// but unlike that one, this needs no MANAGED scratch copy: `netAbiWrite`
// just above hands `strData(s)` straight to the SAME `netWriteSock` this
// calls, with no copy either, because a synchronous blocking send completes
// before this function returns, unlike the deadline engine's overlapped
// wait, which must keep its buffer alive across more than one poll. So
// `std/net`'s `Conn.writeBytes` gets the same true-blocking, never-give-up
// no-deadline fast path `Conn.write(s: string)` already has.
export @symbol("bit_rt_net_write_bytes_w") fn netAbiWriteBytesW(fd: int, words: int, n: int): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  return netWriteSock(fd, u8At(words), n)
}

// `bit_rt_net_read_bytes_w` (#7389): `bit_rt_net_read`'s byte-taking sibling.
// Unlike `netAbiReadDeadlineW` above, no MANAGED scratch copy, for
// `netAbiWriteBytesW`'s reason: `netAbiRead` hands its buffer to the SAME
// `netReadSock` this calls, which parks until the completion port reports the
// WSARecv done, so the kernel has finished writing `outWords` before this
// returns. The caller keeps that buffer live across the park with
// `keepAlive(buf)`. Byte count, `0` peer closed, `-1` hard error.
export @symbol("bit_rt_net_read_bytes_w") fn netAbiReadBytesW(
  fd: int,
  outWords: int,
  bufCap: int,
): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  return netReadSock(fd, u8At(outWords), bufCap)
}

export @symbol("bit_rt_net_shutdown_sock_w") @nosplit fn netAbiShutdownSockW(fd: int): bool {
  return netShutdownSock(fd)
}

// `bit_rt_net_close_w` (#5865): the platform-neutral binding `std/net`'s
// `close()` methods now call on every platform (darwin's own `netClose`
// gained real bookkeeping — see that provider's `netabi.bit`; windows' has
// not, out of scope here — this is a pure passthrough to the SAME
// `closesocket` call `close()` made directly before, no behavior change).
export @symbol("bit_rt_net_close_w") @nosplit fn netAbiCloseW(fd: int) {
  netClose(fd)
}

// ---------------------------------------------------------------------------
// UDP (ABI.md §20)
// ---------------------------------------------------------------------------

export @symbol("bit_rt_net_udp_bind") fn netAbiUdpBind(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netBindUdp(strData(host), strSizeOf(host), port)
}

export @symbol("bit_rt_net_udp_send") fn netAbiUdpSend(
  fd: int,
  host: int,
  port: int,
  data: int,
): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netSendTo(fd, strData(host), strSizeOf(host), port, strData(data), strSizeOf(data))
}

// `bit_rt_net_udp_recv_from_w` (#7746): same contract as
// ../linux/netabi.bit's — the datagram into the caller's `outWords` buffer, the
// sender's raw `sockaddr_in` into the caller's `peerWords` (16 bytes), the byte
// count or -1 returned, no sender state kept in the runtime.
export @symbol("bit_rt_net_udp_recv_from_w") fn netAbiUdpRecvFromW(
  fd: int,
  outWords: int,
  bufCap: int,
  peerWords: int,
): int {
  if (bufCap <= 0 || outWords == 0 || peerWords == 0) {
    return 0 - 1
  }
  return netRecvFrom(fd, u8At(outWords), bufCap, u8At(peerWords))
}

// ---------------------------------------------------------------------------
// DNS (ABI.md §20)
// ---------------------------------------------------------------------------

// resolv.conf(5) `attempts` (#6350): pass 1 asks EVERY nameserver Windows
// reports (`nameserversFromAdapters`, ./dns.bit), then pass 2 asks every one
// again, up to the block's attempt count, and the first A record wins. With the
// first server unreachable the second is asked after ONE window, not after all
// the first's attempts -- the walk `netResolvePasses` has on Linux and Darwin
// (../linux/netabi.bit), over the address list instead of a conf text.
//
// The list is the resolve block's own: `netNsConfOff` points at packed
// `netAdapterDnsStride`-byte entries (IPv4 and IPv6 servers alike,
// ../adapters.bit) and `netNsConfLenOff` is their byte length, where the other
// providers keep resolv.conf text. `netResolveHost` (./dns.bit) is handed each
// entry in turn, on the port the block carries: it starts at `netNsPortOff` and
// moves by `netNsPortStepOff` after each server, as on the other providers
// (production passes 53 and 0). The current port is written back into the
// block's own `netNsPortOff` slot, which `netResolveHost` reads, so the walk
// keeps the starting port in a local.
export @symbol("bit_rt_port_net_resolve_passes") fn netResolvePasses(
  host: *u8,
  hostLen: int,
  ns: *u8,
  out: *u8,
): bool {
  let list = u8At(getU64Le(ns, netNsConfOff))
  let count = getU64Le(ns, netNsConfLenOff) / netAdapterDnsStride
  let passes = getU64Le(ns, netNsAttemptsOff)
  let step = getU64Le(ns, netNsPortStepOff)
  let firstPort = getU64Le(ns, netNsPortOff)
  let pass = 0
  // Bounded (Power of 10): `passes` is at most `netDnsArgMax` and `count` at
  // most `netMaxAdapterDns`.
  while (pass < passes) {
    pass = pass + 1
    let at = 0
    while (at < count) {
      putU64Le(ns, netNsPortOff, firstPort + at * step)
      if (netResolveHost(host, hostLen, ns, list + at * netAdapterDnsStride, out)) {
        return true
      }
      at = at + 1
    }
  }
  return false
}

// True when the arguments of `netAbiResolveW` describe a lookup this runtime
// will run: a host of 1..255 bytes, both buffers present, and a budget
// `netDnsArgsOk` accepts.
@nosplit fn netAbiResolveArgsOk(
  hostWords: int,
  hostLen: int,
  timeoutMs: int,
  attempts: int,
  outWords: int,
): bool {
  if (hostWords == 0 || outWords == 0) {
    return false
  }
  if (hostLen <= 0 || hostLen > netAbiMaxHost) {
    return false
  }
  return netDnsArgsOk(timeoutMs, attempts)
}

// Every real nameserver speaks DNS on this port.
const netDnsPort: int = 53

// The hostname path of `netAbiResolveW`: discovers the nameservers, then walks
// them (`netResolvePasses`). The resolve block holds the per-attempt window, the
// attempt count and the discovered list, all in this frame's MANAGED scratch,
// rooted across the GC-safe deadline waits below.
fn netResolveAdapters(host: *u8, hostLen: int, timeoutMs: int, attempts: int, out: *u8): bool {
  let listBuf = []i64(scratchWords(netMaxAdapterDns * netAdapterDnsStride))
  let list = u8At(int(ptrOf(listBuf)))
  let count = nameserversFromAdapters(list, netMaxAdapterDns)
  if (count == 0) {
    keepAlive(listBuf)
    return false
  }
  // Allocated after the discovery, which allocates itself, so no allocation
  // sits between this block's address and its last use below.
  let nsBuf = []i64(scratchWords(netNsBlockBytes))
  let ns = u8At(int(ptrOf(nsBuf)))
  putU64Le(ns, netNsTimeoutOff, timeoutMs)
  putU64Le(ns, netNsAttemptsOff, attempts)
  putU64Le(ns, netNsConfOff, int(list))
  putU64Le(ns, netNsPortOff, netDnsPort)
  putU64Le(ns, netNsPortStepOff, 0)
  putU64Le(ns, netNsConfLenOff, count * netAdapterDnsStride)
  let ok = netResolvePasses(host, hostLen, ns, out)
  keepAlive(nsBuf)
  keepAlive(listBuf)
  return ok
}

// `bit_rt_net_dns_servers_w` (#7480): how many nameservers `bit_rt_net_resolve_w`
// walks, counted by the SAME discovery (`nameserversFromAdapters`, ./dns.bit)
// so `std/net`'s `resolveBudgetMs` budgets what the runtime spends. Windows has
// no /etc/resolv.conf for `std/net` to count lines of. 0 when the call fails or
// no adapter that is up has a server.
export @symbol("bit_rt_net_dns_servers_w") fn netAbiDnsServersW(): int {
  let listBuf = []i64(scratchWords(netMaxAdapterDns * netAdapterDnsStride))
  let n = nameserversFromAdapters(u8At(int(ptrOf(listBuf))), netMaxAdapterDns)
  keepAlive(listBuf)
  return n
}

// `bit_rt_net_resolve_w`: the first IPv4 A-record for the host
// `hostWords[0..hostLen)` as a dotted quad written into the caller's own
// `outWords` buffer (at least 16 bytes), the byte count returned, or -1 on
// failure or a refused argument. A dotted-quad host passes straight back with
// no nameserver lookup at all -- `netParseIpv4` needs no network and no
// discovery step, so this fast path is unchanged from #3340.
//
// `timeoutMs` is the receive window of ONE attempt and `attempts` how many the
// nameserver gets: `std/net` owns both (#6350). Windows has no
// `/etc/resolv.conf`, so `std/net` passes its defaults here.
//
// Anything else needs a real nameserver. Windows has no `/etc/resolv.conf`
// for ../linux/netabi.bit's `readResolvConf` to read; the equivalent is
// `GetAdaptersAddresses` (#3589 -- see ./dns.bit's `nameserversFromAdapters`
// for the discovery, genuinely new provider code rather than a file-read
// swap) feeding ./dns.bit's `netResolveHost`, the same platform-free DNS
// wire codec (../../net's `netBuildQuery`/`netParseAnswer`) every other
// provider already speaks. The buffers cross as packed `[]byte` backings the
// caller holds live with `keepAlive` (ABI.md section 2).
export @symbol("bit_rt_net_resolve_w") fn netAbiResolveW(
  hostWords: int,
  hostLen: int,
  timeoutMs: int,
  attempts: int,
  outWords: int,
): int {
  if (!netAbiResolveArgsOk(hostWords, hostLen, timeoutMs, attempts, outWords)) {
    return 0 - 1
  }
  let octets = []i64(1)
  let out = u8At(int(ptrOf(octets)))
  let host = u8At(hostWords)
  if (!netParseIpv4(host, hostLen, out) &&
    !netResolveAdapters(host, hostLen, timeoutMs, attempts, out)) {
    keepAlive(octets)
    return 0 - 1
  }
  let n = netFormatOctets(out, u8At(outWords))
  keepAlive(octets)
  return n
}

// Validate the packed request before the transport can read its body.
@nosplit fn netTxtArgsOk(inWords: int, hostLen: int, nsLen: int, outWords: int): bool {
  if (inWords == 0 || outWords == 0) {
    return false
  }
  if (hostLen <= 0 || hostLen > netAbiMaxHost) {
    return false
  }
  if (nsLen < 0 || nsLen > netTxtMaxNsText) {
    return false
  }
  let head = u8At(inWords)
  return netDnsArgsOk(getU64Le(head, 0), getU64Le(head, 8))
}

@nosplit fn netTxtLoad(work: *u8, src: *u8, hostLen: int, nsLen: int) {
  let ns = work + netTxtNsOff
  putU64Le(ns, netNsTimeoutOff, getU64Le(src, 0))
  putU64Le(ns, netNsAttemptsOff, getU64Le(src, 8))
  netTxtCopy(work + netTxtHostOff, src + netTxtHeaderBytes, hostLen)
  netTxtCopy(work + netTxtNsTextOff, src + netTxtHeaderBytes + hostLen, nsLen)
}

// Explicit servers use the same mapped-address entry as adapter discovery.
@nosplit fn netTxtFixedEntry(work: *u8, nsLen: int): bool {
  let entry = work + netTxtEntryOff
  let text = work + netTxtNsTextOff
  if (netParseIpv4(text, nsLen, entry + 12)) {
    putU8(entry, 10, 255)
    putU8(entry, 11, 255)
    return true
  }
  return netParseIpv6(text, nsLen, entry)
}

fn netTxtAdapters(work: *u8, hostLen: int, nsLen: int, port: int, out: *u8): int {
  let listBuf = []i64(scratchWords(netMaxAdapterDns * netAdapterDnsStride))
  let list = u8At(int(ptrOf(listBuf)))
  let ns = work + netTxtNsOff
  let count = 1
  if (nsLen > 0) {
    if (port < 1 || port > 65535 || !netTxtFixedEntry(work, nsLen)) {
      return netTxtTransient
    }
    netTxtCopy(list, work + netTxtEntryOff, netAdapterDnsStride)
  } else {
    count = nameserversFromAdapters(list, netMaxAdapterDns)
    port = netDnsPort
  }
  putU64Le(ns, netNsConfOff, int(list))
  putU64Le(ns, netNsConfLenOff, count * netAdapterDnsStride)
  putU64Le(ns, netNsPortOff, port)
  putU64Le(ns, netNsPortStepOff, 0)
  let r = netTxtWalk(work, hostLen, out)
  keepAlive(listBuf)
  return r
}

// UDP and a framed TCP retry share the original per-server deadline (#7153).
export @symbol("bit_rt_net_lookup_txt_w") fn netAbiLookupTxtW(
  inWords: int,
  hostLen: int,
  nsLen: int,
  port: int,
  outWords: int,
): int {
  if (!netTxtArgsOk(inWords, hostLen, nsLen, outWords)) {
    return netTxtTransient
  }
  let scratch = []i64(scratchWords(netTxtWorkBytes))
  let work = u8At(int(ptrOf(scratch)))
  netTxtLoad(work, u8At(inWords), hostLen, nsLen)
  let r = netTxtAdapters(work, hostLen, nsLen, port, u8At(outWords))
  keepAlive(scratch)
  return r
}
