// SEAM 1 of the Windows runtime port (#3340, epic #3322): the `bit_rt_net_*`
// ABI wrappers (ABI.md §20) over this provider's socket engine (./sock.bit,
// ./tcp.bit, ./udp.bit, and, since #3589, ./dns.bit for hostname
// resolution). Byte-for-byte the same shape as ../linux/netabi.bit and
// ../darwin/netabi.bit — see either for the full rationale (why the
// wrappers live per-platform, why the buffers here are managed `[]i64`
// rather than raw `rtStrAlloc` addresses across a park). This file
// duplicates their marshalling body rather than sharing it, for the
// identical reason: the only thing that differs between the three is which
// socket/resolver engine the sibling names resolve to.

import { loadByte, storeByte } from "../../gc"
import {
  emptyStr, u8At, scratchWords, strData, strSizeOf,
  strFromPacked, formatQuad, udpSenderSlot, udpValidAt, udpSenderWordAt,
  copySockAddrWords,
} from "../../net"

// ---------------------------------------------------------------------------
// TCP (ABI.md §20)
// ---------------------------------------------------------------------------

export @symbol("bit_rt_net_listen") @nosplit fn netAbiListen(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netListenTcp(strData(host), strSizeOf(host), port, 512)
}

export @symbol("bit_rt_net_local_port") fn netAbiLocalPort(fd: int): int {
  return netSockLocalPort(fd)
}

// `@nosplit`, unlike `netAbiLocalPort` above it: ./sock.bit's `netSockPeerAddr`
// is itself `@nosplit` (it uses the module-static `lenBytes()` scratch for its
// out-parameter, where ./tcp.bit's `netSockLocalPort` allocates a `[]i64(1)`),
// so E0075's transitive closure holds here and this wrapper needs no
// `_tests_/bit/pollfree` exception. Writes the 16-byte wire form, ABI.md §20;
// `_w` because `std/net` reaches it by `extern fn`, see ../darwin/netabi.bit.
export @symbol("bit_rt_net_peer_addr_w") @nosplit fn netAbiPeerAddrW(fd: int, outWords: int): int {
  if (outWords == 0) {
    return 0 - 1
  }
  return netSockPeerAddr(fd, u8At(outWords))
}

export @symbol("bit_rt_net_accept") fn netAbiAccept(fd: int): int {
  return netAcceptTcp(fd)
}

export @symbol("bit_rt_net_dial") fn netAbiDial(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netDialTcp(strData(host), strSizeOf(host), port)
}

export @symbol("bit_rt_net_read") fn netAbiRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let scratch = []i64(scratchWords(max))
  let n = netReadSock(fd, u8At(int(ptrOf(scratch))), max)
  if (n <= 0) {
    return emptyStr()
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

export @symbol("bit_rt_net_write") fn netAbiWrite(fd: int, s: int): int {
  return netWriteSock(fd, strData(s), strSizeOf(s))
}

// ---------------------------------------------------------------------------
// Deadline-bounded dial/read/write (#2291) — see ../tcp.bit's own header for
// this provider's documented gap (pre-flight deadline check only, an
// in-flight async wait is not bounded).
// ---------------------------------------------------------------------------

const netAbiMaxHost: int = 255
const netAbiMaxBody: int = 67108864

export @symbol("bit_rt_net_dial_deadline_w") fn netAbiDialDeadlineW(
  hostWords: int,
  hostLen: int,
  port: int,
  deadlineNs: int,
): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  if (hostWords == 0 || hostLen <= 0 || hostLen > netAbiMaxHost) {
    return 0 - 1
  }
  let scratch = []i64(scratchWords(hostLen))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < hostLen) {
    storeByte(packed + i, loadByte(hostWords + i))
    i = i + 1
  }
  return netDialTcpDeadline(u8At(packed), hostLen, port, deadlineNs)
}

export @symbol("bit_rt_net_read_deadline_w") fn netAbiReadDeadlineW(
  fd: int,
  outWords: int,
  bufCap: int,
  deadlineNs: int,
): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  let scratch = []i64(scratchWords(bufCap))
  let packed = int(ptrOf(scratch))
  let n = netReadSockDeadline(fd, u8At(packed), bufCap, deadlineNs)
  if (n <= 0) {
    return n
  }
  let i = 0
  while (i < n) {
    storeByte(outWords + i, loadByte(packed + i))
    i = i + 1
  }
  return n
}

export @symbol("bit_rt_net_write_deadline_w") fn netAbiWriteDeadlineW(
  fd: int,
  words: int,
  n: int,
  deadlineNs: int,
): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  let scratch = []i64(scratchWords(n))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < n) {
    storeByte(packed + i, loadByte(words + i))
    i = i + 1
  }
  return netWriteSockDeadline(fd, u8At(packed), n, deadlineNs)
}

// `bit_rt_net_write_bytes_w` (#5928): `bit_rt_net_write`'s byte-taking
// sibling, same `words`/`n` shape as `bit_rt_net_write_deadline_w` above —
// but unlike that one, this needs no MANAGED scratch copy: `netAbiWrite`
// just above hands `strData(s)` straight to the SAME `netWriteSock` this
// calls, with no copy either, because a synchronous blocking send completes
// before this function returns, unlike the deadline engine's overlapped
// wait, which must keep its buffer alive across more than one poll. So
// `std/net`'s `Conn.writeBytes` gets the same true-blocking, never-give-up
// no-deadline fast path `Conn.write(s: string)` already has.
export @symbol("bit_rt_net_write_bytes_w") fn netAbiWriteBytesW(fd: int, words: int, n: int): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  return netWriteSock(fd, u8At(words), n)
}

// `bit_rt_net_read_bytes_w` (#7389): `bit_rt_net_read`'s byte-taking sibling.
// Unlike `netAbiReadDeadlineW` above, no MANAGED scratch copy, for
// `netAbiWriteBytesW`'s reason: `netAbiRead` hands its buffer to the SAME
// `netReadSock` this calls, which parks until the completion port reports the
// WSARecv done, so the kernel has finished writing `outWords` before this
// returns. The caller keeps that buffer live across the park with
// `keepAlive(buf)`. Byte count, `0` peer closed, `-1` hard error.
export @symbol("bit_rt_net_read_bytes_w") fn netAbiReadBytesW(
  fd: int,
  outWords: int,
  bufCap: int,
): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  return netReadSock(fd, u8At(outWords), bufCap)
}

export @symbol("bit_rt_net_shutdown_sock_w") @nosplit fn netAbiShutdownSockW(fd: int): bool {
  return netShutdownSock(fd)
}

// `bit_rt_net_close_w` (#5865): the platform-neutral binding `std/net`'s
// `close()` methods now call on every platform (darwin's own `netClose`
// gained real bookkeeping — see that provider's `netabi.bit`; windows' has
// not, out of scope here — this is a pure passthrough to the SAME
// `closesocket` call `close()` made directly before, no behavior change).
export @symbol("bit_rt_net_close_w") @nosplit fn netAbiCloseW(fd: int) {
  netClose(fd)
}

// ---------------------------------------------------------------------------
// UDP (ABI.md §20)
// ---------------------------------------------------------------------------

export @symbol("bit_rt_net_udp_bind") fn netAbiUdpBind(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netBindUdp(strData(host), strSizeOf(host), port)
}

export @symbol("bit_rt_net_udp_send") fn netAbiUdpSend(
  fd: int,
  host: int,
  port: int,
  data: int,
): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netSendTo(fd, strData(host), strSizeOf(host), port, strData(data), strSizeOf(data))
}

export @symbol("bit_rt_net_udp_recv") fn netAbiUdpRecv(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let scratch = []i64(scratchWords(max))
  let peer = []i64(4)
  let n = netRecvFrom(fd, u8At(int(ptrOf(scratch))), max, u8At(int(ptrOf(peer))))

  let slot = udpSenderSlot()
  if (n < 0) {
    if (slot >= 0) {
      *udpValidAt(slot) = 0
    }
    return emptyStr()
  }
  if (slot >= 0) {
    copySockAddrWords(ptrOf(peer), udpSenderWordAt(slot))
    *udpValidAt(slot) = 1
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

// ---------------------------------------------------------------------------
// DNS (ABI.md §20)
// ---------------------------------------------------------------------------

// `bit_rt_net_resolve`: the first IPv4 A-record for `host` as a dotted
// quad, or "" on failure. A dotted-quad `host` passes straight back with no
// nameserver lookup at all -- `netParseIpv4` needs no network and no
// discovery step, so this fast path is unchanged from #3340.
//
// Anything else needs a real nameserver. Windows has no `/etc/resolv.conf`
// for ../linux/netabi.bit's `readResolvConf` to read; the equivalent is
// `GetAdaptersAddresses` (#3589 -- see ./dns.bit's `nameserverFromAdapters`
// for the discovery, genuinely new provider code rather than a file-read
// swap) feeding ./dns.bit's `netResolveHost`, the same platform-free DNS
// wire codec (../../net's `netBuildQuery`/`netParseAnswer`) every other
// provider already speaks.
export @symbol("bit_rt_net_resolve") fn netAbiResolve(host: int): int {
  let hostPtr = strData(host)
  let hostLen = strSizeOf(host)
  let outBuf = []i64(1)
  let outPtr = u8At(int(ptrOf(outBuf)))

  // A literal address never needs the network -- return it verbatim,
  // exactly as `netResolveHost` would, but without touching the adapter
  // list.
  if (netParseIpv4(hostPtr, hostLen, outPtr)) {
    return formatQuad(outPtr)
  }

  let nsBuf = []i64(1)
  let nsPtr = u8At(int(ptrOf(nsBuf)))
  if (!nameserverFromAdapters(nsPtr)) {
    return emptyStr()
  }
  if (!netResolveHost(hostPtr, hostLen, nsPtr, outPtr)) {
    return emptyStr()
  }
  return formatQuad(outPtr)
}

// `bit_rt_net_lookup_txt_w` (#6882): NOT IMPLEMENTED on Windows, and it says
// so. The Linux/Darwin entry (../{linux,darwin}/txt.bit) retries a truncated
// reply over a deadline-bounded TCP connection; this provider's DNS is a
// blocking UDP socket with `SO_RCVTIMEO` (./dns.bit) and a nameserver taken
// from the adapter list, with no TCP deadline path to retry on, and a 2048-bit
// DKIM key is the case that needs it. Returning a lookup that silently drops
// truncated answers would be worse than none. Always -3, which `std/net`'s
// `lookupTxt` reports as "not supported on this platform"; the symbol exists
// so a program using `std/net` links.
export @symbol("bit_rt_net_lookup_txt_w") @nosplit fn netAbiLookupTxtW(
  inWords: int,
  hostLen: int,
  nsLen: int,
  port: int,
  outWords: int,
): int {
  return 0 - 3
}
