// Darwin UDP calls for the Stage-2 port of runtime/net/ (#1366): datagram
// sockets, send and receive. Split out of sock.bit (#1503); same module, so the
// constants, buffers and helpers there are in scope unchanged.

// ---------------------------------------------------------------------------
// UDP
// ---------------------------------------------------------------------------

// A datagram socket bound to `host:port`. `port == 0` lets the kernel pick one
// (recover it with `netLocalPort`, exactly like a TCP listener). Connectionless:
// unlike TCP there is no listen/accept — send and receive straight off the fd.
// #2343: same convention as `netListenTcp` (../tcp.bit) — a failure after a
// syscall returns `0 - lastErr()`, captured immediately on the failing
// branch, before `netClose` runs.
export @symbol("bit_rt_port_net_bind_udp") @nosplit fn netBindUdp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(true)
  if (fd < 0) {
    return 0 - lastErr()
  }
  if (!netSetReuseAddr(fd)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  return fd
}

// Send one datagram to `host:port`. Parks on writability if the socket buffer is
// momentarily full. A DATAGRAM IS ALL-OR-NOTHING: a partial send is an error,
// never a short count, so there is no write loop as there is for TCP.
export @symbol("bit_rt_port_net_send_to") fn netSendTo(fd: int, host: *u8, hostLen: int, port: int,
                          data: *u8, n: int): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // THE ADDRESS IS REBUILT EVERY ATTEMPT, NOT REUSED — see `tcp.bit`'s
    // `netDialTcp` for the identical comment. `ipBytes()`/`saBytes2()` are
    // per-worker (#3273): `netAwaitReady` below parks, so a retry can resume
    // on a different worker, and re-deriving+refilling here, with no park
    // between the fill and the `sendto` call, keeps the fill and the syscall
    // on the same slot.
    let ip = ipBytes()
    if (!netParseIpv4(host, hostLen, ip)) {
      return 0 - 1
    }
    netFillSockAddr(saBytes2(), ip, port)
    let sent = int(sendto(i32(fd), data, i64(n), i32(0), saBytes2(), i32(saLen)))
    if (sent >= 0) {
      return sent
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollWrite)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Receive one datagram into `buf`, parking until one arrives, and write the
// sender's address into `peer` (which must hold `netSockAddrLen()` bytes, or be
// nil to discard it). Returns the byte count: A ZERO-LENGTH DATAGRAM IS LEGAL,
// so 0 is NOT end-of-stream here — UDP has no stream to end.
//
// The out-parameter is `peer`, not `from`: `from` is a KEYWORD (import ... from)
// and is rejected as an identifier.
export @symbol("bit_rt_port_net_recv_from") fn netRecvFrom(fd: int, buf: *u8, cap: int, peer: *u8): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // `salen` is IN/OUT and must be re-armed on EVERY attempt: the kernel writes
    // the address size back into it, so a retry that reused the previous value
    // would be passing whatever the last call left there.
    //
    // This fill (`lenBytes()`), the syscall's own kernel write into
    // `saBytes()`, and the copy-out loop below all happen inside ONE
    // iteration with no park between them, so all three land on the SAME
    // per-worker slot (#3273) regardless of which worker this task is on —
    // the property that makes `saBytes()`/`lenBytes()` safe to call fresh at
    // each use rather than caching a pointer across the retry loop's park.
    putU32Le(lenBytes(), 0, saLen)
    let got = int(recvfrom(i32(fd), buf, i64(cap), i32(0), saBytes(), lenBytes()))
    if (got >= 0) {
      if (int(peer) != 0) {
        let k = 0
        while (k < saLen) {
          putU8(peer, k, getU8(saBytes(), k))
          k = k + 1
        }
      }
      return got
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}
