// Darwin TCP calls for the Stage-2 port of runtime/net/ (#1366): listeners,
// dials and stream I/O. Split out of sock.bit (#1503); same module, so the
// constants, buffers and helpers there are in scope unchanged.
//
// `schedSleepUntil` and `parkMonoNs` are the two names this file's siblings
// (sock.bit) do not already bring into the module — see the "Deadline-bounded
// connect/read/write" section below (#2291) for what they are for.
import { schedSleepUntil } from "../../sched"
import { parkMonoNs } from "../../park/darwin"
import { netClampDeadline, netDeadlineMaxWaitNs } from "../../net"
// `taskDeadline`/`schedTimerPush`/`schedTimerCancel` back
// `netAwaitReadyOrDeadline` below, the readiness-vs-timer race (#5865). `pdCancel`
// is the one polldesc primitive ../sock.bit does not already import for this
// module (imports are per-module, not per-file, so its `pdWait`/`pdDirRead`/etc.
// are already in scope here).
import { taskDeadline, schedTimerPush, schedTimerCancel } from "../../sched"
import { pdCancel } from "../../sched"
// Per-fd reference counting (#5886) -- every blocking loop in this file
// acquires once at entry (`netFdAcquire`, `./sock.bit`) and releases on
// every exit path (`netFdRelease`); `pdFdClosing` (also imported by
// `./sock.bit` -- imports are per-module, not per-file) is the after-wake
// check that stops a retry once `netClose` has run, without another syscall.

// ---------------------------------------------------------------------------
// TCP
// ---------------------------------------------------------------------------

// A listening socket bound to `host:port`. `port == 0` lets the kernel pick one;
// recover it with `netLocalPort`. Returns a negative value on failure.
//
// #2343: A FAILURE AFTER A SYSCALL RETURNS `0 - lastErr()`, not a flat `-1` —
// so a caller can tell EADDRINUSE from EACCES from ECONNREFUSED. `lastErr()`
// is read IMMEDIATELY on the failing branch, before `netClose` runs (same
// discipline `runtime/root/darwin/fs.bit`'s `readAllErrno` documents: "read
// immediately after the call that set it, before anything else touches
// libSystem") — `netClose` itself does not reach `__error()` on this
// platform's success path, but capturing first costs nothing and removes the
// question. `netParseIpv4` rejecting the host is NOT a kernel errno, so that
// branch keeps the fixed `-1` sentinel — the one case where this collides
// with a real errno is EPERM (1 on both platforms), a pre-existing ambiguity
// #2314 owns, not introduced here: every existing caller of this primitive
// only tests `fd < 0`, never `fd == -1`, so the collision changes no
// behaviour today.
export @symbol("bit_rt_port_net_listen_tcp") @nosplit fn netListenTcp(
  host: *u8,
  hostLen: int,
  port: int,
  backlog: int,
): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - lastErr()
  }
  if (!netSetReuseAddr(fd)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  if (!netSysListen(fd, backlog)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  return fd
}

// The port `fd` is actually bound to — the whole point of binding to port 0.
export @symbol("bit_rt_port_net_local_port") @nosplit fn netSockLocalPort(fd: int): int {
  putU32Le(lenBytes(), 0, saLen)
  if (int(getsockname(i32(fd), saBytes(), lenBytes())) < 0) {
    return 0 - 1
  }
  return netSockAddrPort(saBytes())
}

// Accept one connection, parking until a peer arrives. The returned socket is
// non-blocking, like every socket here. Negative on failure.
//
// #5886: a ref on `lfd` is held for the WHOLE call (acquired once here,
// before the first syscall, released on every exit from `netAcceptTcpLoop`)
// so `netClose(lfd)` from another task can never actually release the fd
// number while this accept is still retrying on it -- see
// `../../sched/polldesc.bit`'s header. Split into a thin wrapper plus
// `netAcceptTcpLoop` to keep both under the complexity ceiling.
export @symbol("bit_rt_port_net_accept_tcp") fn netAcceptTcp(lfd: int): int {
  let gen = *netFdGenAddr(lfd)
  if (!netFdAcquire(lfd, gen)) {
    return 0 - 1
  }
  let fd = netAcceptTcpLoop(lfd, gen)
  netFdRelease(lfd)
  return fd
}

fn netAcceptTcpLoop(lfd: int, gen: int): int {
  let stalls = 0
  let spins = 0
  // Two bounds, both static (Power of 10): `stalls` counts parked waits and
  // `spins` counts unscheduled retries, and neither can run away.
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let none: *u8 = nil
    let fd = int(accept(i32(lfd), none, none))
    if (fd >= 0) {
      if (!netSetNonBlock(fd)) {
        netClose(fd)
        return 0 - 1
      }
      netPollDescOpen(fd)
      return fd
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(lfd, pollRead, gen)) {
        // The wake may have been `netClose` rather than a real connection
        // (#5886) -- checked BEFORE retrying `accept`, so a close never lets
        // this loop's next syscall land on a reused fd number.
        if (pdFdClosing(lfd)) {
          return 0 - 1
        }
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      // A peer that vanished between the poll and the accept is routine, and
      // not this listener's problem. EINTR likewise.
      if (e != eConnAborted() && e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Connect to `host:port`, parking until the handshake finishes.
//
// A non-blocking `connect` reports EINPROGRESS and finishes in the background.
// The socket then becomes WRITABLE whether it succeeded or failed, so the
// outcome has to be read back from SO_ERROR. Skipping that read is the classic
// bug: a refused connection looks connected until some later `write` fails far
// away from the cause.
// #5886: a ref on `fd` is held for the connect-wait loop (acquired once
// right after the socket is created, released on every exit) — split into a
// thin wrapper plus `netDialTcpConnect` to keep both under the complexity
// ceiling, same shape as `netAcceptTcp`/`netAcceptTcpLoop` above.
export @symbol("bit_rt_port_net_dial_tcp") fn netDialTcp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - lastErr()
  }
  let gen = *netFdGenAddr(fd)
  if (!netFdAcquire(fd, gen)) {
    netClose(fd)
    return 0 - 1
  }
  let rc = netDialTcpConnect(fd, gen, host, hostLen, port)
  netFdRelease(fd)
  return rc
}

// A negative `netDialTcpCheckDone` sentinel would collide with the errno
// results it also has to carry (`0 - errno` and `0 - 1` are both plausible),
// so completion is reported through an out-parameter instead — the same
// shape `../../sched/polldesc.bit`'s `pdClose` uses for the identical
// reason. Per-worker scratch (`./sock.bit`'s `netCloseOutBuf` is the same
// pattern): `ptrOf` needs a slice or module-level state, not a local fixed
// array, and a shared buffer would let two workers dialing concurrently
// stomp each other's result.
let netDialDoneBuf: [66]i64

@nosplit fn netDialDoneAddr(): *i64 {
  return ptrOf(netDialDoneBuf) + sockScratchSlot()
}

fn netDialTcpCheckDone(fd: int, rc2: int, ce: int, outResult: *i64): bool {
  if (rc2 >= 0 || ce == eIsConn()) {
    // Connected as far as the handshake is concerned; SO_ERROR is now the
    // authority on whether it succeeded. `netSocketError` returns the
    // deferred connect's own errno directly (SO_ERROR IS an errno value,
    // e.g. ECONNREFUSED) — that is a stronger signal than `lastErr()` here,
    // since no syscall this thread made just failed. A negative
    // `netSocketError` result is its OWN getsockopt call failing, in which
    // case `lastErr()` (read immediately, no syscall in between) is the
    // right source instead.
    let soErr = netSocketError(fd)
    if (soErr != 0) {
      netClose(fd)
      if (soErr > 0) {
        *outResult = i64(0 - soErr)
      } else {
        *outResult = i64(0 - lastErr())
      }
      return true
    }
    *outResult = i64(fd)
    return true
  }
  if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
    netClose(fd)
    *outResult = i64(0 - ce)
    return true
  }
  return false
}

fn netDialTcpConnect(fd: int, gen: int, host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  netFillSockAddr(saBytes(), ip, port)
  let rc = int(connect(i32(fd), saBytes(), i32(saLen)))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - e
  }
  let spins = 0
  // Bounded (Power of 10). One parked wait suffices when there is a scheduler;
  // the loop exists for the unscheduled caller, which must poll for completion.
  //
  // `SO_ERROR == 0` DOES NOT MEAN CONNECTED — it means "no error HAS BEEN
  // RECORDED YET", and immediately after EINPROGRESS that is the state of every
  // handshake, including the ones about to be refused. Reading it before the
  // handshake finishes therefore reports success for a connection that has not
  // happened, which is the very bug the comment above warns about, one step
  // further in. This was invisible until #1462: `fcntl`'s misplaced variadic
  // argument left every socket BLOCKING, so `connect` completed synchronously
  // and this loop was never entered at all — the test's own notes record
  // `refusedDial` as "passing for the wrong reason" and the SO_ERROR readback as
  // an unexercised gap. Both are now real.
  //
  // So completion is established FIRST, by re-issuing `connect` — the BSD way to
  // ask a pending handshake how it went, and one that needs no poller, which
  // matters because the unscheduled caller has none:
  //
  //   EALREADY / EINPROGRESS   still running; keep waiting
  //   EISCONN (or success)     finished and connected
  //   anything else            the deferred failure, reported here
  //
  // SO_ERROR is then read on the completed socket, where it IS meaningful, and
  // is what turns a handshake that completed-but-failed into an error.
  while (spins < netMaxSpins) {
    if (netAwaitReady(fd, pollWrite, gen)) {
      spins = netMaxSpins
    } else {
      spins = spins + 1
    }
    // THE ADDRESS IS REBUILT EVERY ATTEMPT, NOT REUSED. `saBytes()`/`ipBytes()`
    // are PER-WORKER scratch (#3273), shared by every entry point that resumes
    // on the same worker, and `netAwaitReady` above PARKS the calling green
    // thread — so either another task runs a `netListenTcp`/`netBindUdp`/
    // `netDialTcp` of its own on this worker and leaves its address in this
    // worker's slot, or this task itself resumes on a DIFFERENT worker whose
    // slot was never filled for this call. Reconnecting to whatever is there
    // either way would be a silent cross-connection. Re-deriving from the
    // caller's own `host`/`port` and refilling here, with no park between the
    // fill and the call, is what makes this safe regardless of which worker
    // resumed it.
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = int(connect(i32(fd), saBytes(), i32(saLen)))
    let ce = lastErr()
    if (netDialTcpCheckDone(fd, rc2, ce, netDialDoneAddr())) {
      return int(*netDialDoneAddr())
    }
  }
  // Spin bound exhausted with the handshake still pending (EALREADY/
  // EINPROGRESS/EINTR every time): not a kernel-reported cause, so this stays
  // the fixed `-1` sentinel rather than a stale errno from an attempt that
  // never actually failed.
  netClose(fd)
  return 0 - 1
}

// Read up to `bufCap` bytes into `buf`, parking until some arrive. `0` means the
// peer closed: an orderly end of stream, not an error. Negative on failure.
//
// #5886: this is the exact shape `_tests_/stress/netclosereuse`'s read-side
// case exercises -- a ref on `fd` is held for the whole call so a `netClose`
// racing this read can defer the real `close(2)` rather than hand the fd
// number to a new connection while this loop might still retry on it.
export @symbol("bit_rt_port_net_read_sock") fn netReadSock(fd: int, buf: *u8, bufCap: int): int {
  let gen = *netFdGenAddr(fd)
  if (!netFdAcquire(fd, gen)) {
    return 0 - 1
  }
  let n = netReadSockLoop(fd, gen, buf, bufCap)
  netFdRelease(fd)
  return n
}

fn netReadSockLoop(fd: int, gen: int, buf: *u8, bufCap: int): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let n = int(read(i32(fd), buf, i64(bufCap)))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead, gen)) {
        if (pdFdClosing(fd)) {
          return 0 - 1
        }
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e == eIntr()) {
        spins = spins + 1
      } else {
        // A reset peer has no more bytes for us. Report end of stream so a
        // caller's read loop terminates instead of erroring.
        if (e == eConnReset()) {
          return 0
        }
        return 0 - 1
      }
    }
  }
  return 0 - 1
}

// SHUT_RDWR (<sys/socket.h>) — the only direction this runtime ever asks for
// (#3016): tearing down a connection means both, so there is no half-close
// caller yet to justify exposing SHUT_RD/SHUT_WR separately.
const netShutRdwr: int = 2

// Shut both directions of `fd` down WITHOUT releasing the fd number — unlike
// `netClose`, a later `netListenTcp`/`netDialTcp`/`netAcceptTcp` cannot reuse
// it until an explicit `netClose` follows this. `false` on a hard failure
// (an already-closed or invalid fd); the caller decides whether that is
// worth reporting.
//
// THIS IS NOT `netClose`, AND THE DIFFERENCE IS WHY IT EXISTS: closing a
// still-open fd tears the descriptor down without waking a green thread
// already parked in `netAwaitReady` for it (kqueue silently drops a knote
// when its fd closes, delivering no event — confirmed empirically, not
// assumed: a `netAwaitReady`-parked reader outlives a same-fd `netClose` from
// another thread indefinitely in a from-scratch reproducer). Shutting a
// socket down, by contrast, is a real state transition on the OPEN
// descriptor the parked reader is still registered against — the kernel
// reports it as newly readable (an orderly EOF), which is exactly the
// existing knote firing. `std/http2`'s reader green thread
// (`stdlib/http2/loop.bit`'s `h2connReader`) is the caller this exists for:
// see `stdlib/http/h2.bit`'s `h2clientExchange` for the close-then-reuse race
// a bare `netClose` here left open.
export @symbol("bit_rt_port_net_shutdown_sock") @nosplit fn netShutdownSock(fd: int): bool {
  return int(shutdown(i32(fd), i32(netShutRdwr))) >= 0
}

// Write all `n` bytes of `buf`, parking whenever the send buffer is full. A
// short write is normal on a socket and is not an error — hence the loop.
//
// #5886: same ref-holding shape as `netReadSock` above.
export @symbol("bit_rt_port_net_write_sock") fn netWriteSock(fd: int, buf: *u8, n: int): int {
  let gen = *netFdGenAddr(fd)
  if (!netFdAcquire(fd, gen)) {
    return 0 - 1
  }
  let wrote = netWriteSockLoop(fd, gen, buf, n)
  netFdRelease(fd)
  return wrote
}

// One EAGAIN/EINTR/hard-error outcome from a `write` that made no progress.
// `1` a stall (parked and woke, keep going), `0` a spin (nothing to retry
// the syscall on yet), `-1` stop the caller's loop entirely -- a hard error,
// or `netClose` having landed while this task waited (#5886). Split out of
// `netWriteSockLoop` to keep it under the complexity ceiling.
fn netWriteSockWaitStep(fd: int, gen: int): int {
  if (lastErr() == eIntr()) {
    return 0
  }
  if (lastErr() != eAgain()) {
    return 0 - 1
  }
  if (!netAwaitReady(fd, pollWrite, gen)) {
    return 0
  }
  if (pdFdClosing(fd)) {
    return 0 - 1
  }
  return 1
}

fn netWriteSockLoop(fd: int, gen: int, buf: *u8, n: int): int {
  let off = 0
  let stalls = 0
  let spins = 0
  while (off < n && stalls < netMaxStalls && spins < netMaxSpins) {
    let wrote = int(write(i32(fd), buf + off, i64(n - off)))
    if (wrote > 0) {
      off = off + wrote
      // PROGRESS RESETS THE STALL BOUND: the bound is on CONSECUTIVE stalls, not
      // on writes, so a large transfer that legitimately blocks many times is
      // not mistaken for a wedged socket.
      stalls = 0
      spins = 0
    } else if (wrote == 0) {
      return 0 - 1
    } else {
      let step = netWriteSockWaitStep(fd, gen)
      if (step < 0) {
        return 0 - 1
      } else if (step == 1) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    }
  }
  if (off < n) {
    return 0 - 1
  }
  return off
}

