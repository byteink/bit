// Darwin TCP calls for the Stage-2 port of runtime/net/ (#1366): listeners,
// dials and stream I/O. Split out of sock.bit (#1503); same module, so the
// constants, buffers and helpers there are in scope unchanged.
//
// `schedSleepUntil` and `parkMonoNs` are the two names this file's siblings
// (sock.bit) do not already bring into the module — see the "Deadline-bounded
// connect/read/write" section below (#2291) for what they are for.
import { schedSleepUntil } from "../../sched"
import { parkMonoNs } from "../../park/darwin"

// ---------------------------------------------------------------------------
// TCP
// ---------------------------------------------------------------------------

// A listening socket bound to `host:port`. `port == 0` lets the kernel pick one;
// recover it with `netLocalPort`. Returns a negative value on failure.
export @symbol("bit_rt_port_net_listen_tcp") @nosplit fn netListenTcp(host: *u8, hostLen: int, port: int, backlog: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netSetReuseAddr(fd)) {
    netClose(fd)
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    netClose(fd)
    return 0 - 1
  }
  if (!netSysListen(fd, backlog)) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// The port `fd` is actually bound to — the whole point of binding to port 0.
export @symbol("bit_rt_port_net_local_port") @nosplit fn netLocalPort(fd: int): int {
  putU32Le(lenBytes(), 0, saLen)
  if (int(getsockname(i32(fd), saBytes(), lenBytes())) < 0) {
    return 0 - 1
  }
  return netSockAddrPort(saBytes())
}

// Accept one connection, parking until a peer arrives. The returned socket is
// non-blocking, like every socket here. Negative on failure.
export @symbol("bit_rt_port_net_accept_tcp") fn netAcceptTcp(lfd: int): int {
  let stalls = 0
  let spins = 0
  // Two bounds, both static (Power of 10): `stalls` counts parked waits and
  // `spins` counts unscheduled retries, and neither can run away.
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let none: *u8 = nil
    let fd = int(accept(i32(lfd), none, none))
    if (fd >= 0) {
      if (!netSetNonBlock(fd)) {
        netClose(fd)
        return 0 - 1
      }
      return fd
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(lfd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      // A peer that vanished between the poll and the accept is routine, and
      // not this listener's problem. EINTR likewise.
      if (e != eConnAborted() && e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Connect to `host:port`, parking until the handshake finishes.
//
// A non-blocking `connect` reports EINPROGRESS and finishes in the background.
// The socket then becomes WRITABLE whether it succeeded or failed, so the
// outcome has to be read back from SO_ERROR. Skipping that read is the classic
// bug: a refused connection looks connected until some later `write` fails far
// away from the cause.
export @symbol("bit_rt_port_net_dial_tcp") fn netDialTcp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  let rc = int(connect(i32(fd), saBytes(), i32(saLen)))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - 1
  }
  let spins = 0
  // Bounded (Power of 10). One parked wait suffices when there is a scheduler;
  // the loop exists for the unscheduled caller, which must poll for completion.
  //
  // `SO_ERROR == 0` DOES NOT MEAN CONNECTED — it means "no error HAS BEEN
  // RECORDED YET", and immediately after EINPROGRESS that is the state of every
  // handshake, including the ones about to be refused. Reading it before the
  // handshake finishes therefore reports success for a connection that has not
  // happened, which is the very bug the comment above warns about, one step
  // further in. This was invisible until #1462: `fcntl`'s misplaced variadic
  // argument left every socket BLOCKING, so `connect` completed synchronously
  // and this loop was never entered at all — the test's own notes record
  // `refusedDial` as "passing for the wrong reason" and the SO_ERROR readback as
  // an unexercised gap. Both are now real.
  //
  // So completion is established FIRST, by re-issuing `connect` — the BSD way to
  // ask a pending handshake how it went, and one that needs no poller, which
  // matters because the unscheduled caller has none:
  //
  //   EALREADY / EINPROGRESS   still running; keep waiting
  //   EISCONN (or success)     finished and connected
  //   anything else            the deferred failure, reported here
  //
  // SO_ERROR is then read on the completed socket, where it IS meaningful, and
  // is what turns a handshake that completed-but-failed into an error.
  while (spins < netMaxSpins) {
    if (netAwaitReady(fd, pollWrite)) {
      spins = netMaxSpins
    } else {
      spins = spins + 1
    }
    // THE ADDRESS IS REBUILT EVERY ATTEMPT, NOT REUSED. `saBytes()`/`ipBytes()`
    // are module scratch shared by every entry point here, and `netAwaitReady`
    // above PARKS the calling green thread — so another task can run a
    // `netListenTcp`/`netBindUdp`/`netDialTcp` of its own and leave its address
    // in the buffer. Reconnecting to whatever it left would be a silent
    // cross-connection. Re-deriving from the caller's own `host`/`port`, with no
    // park between the fill and the call, is what makes this safe.
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = int(connect(i32(fd), saBytes(), i32(saLen)))
    let ce = lastErr()
    if (rc2 >= 0 || ce == eIsConn()) {
      // Connected as far as the handshake is concerned; SO_ERROR is now the
      // authority on whether it succeeded.
      if (netSocketError(fd) != 0) {
        netClose(fd)
        return 0 - 1
      }
      return fd
    }
    if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
      netClose(fd)
      return 0 - 1
    }
  }
  netClose(fd)
  return 0 - 1
}

// Read up to `cap` bytes into `buf`, parking until some arrive. `0` means the
// peer closed: an orderly end of stream, not an error. Negative on failure.
export @symbol("bit_rt_port_net_read_sock") fn netReadSock(fd: int, buf: *u8, cap: int): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let n = int(read(i32(fd), buf, i64(cap)))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e == eIntr()) {
        spins = spins + 1
      } else {
        // A reset peer has no more bytes for us. Report end of stream so a
        // caller's read loop terminates instead of erroring.
        if (e == eConnReset()) {
          return 0
        }
        return 0 - 1
      }
    }
  }
  return 0 - 1
}

// Write all `n` bytes of `buf`, parking whenever the send buffer is full. A
// short write is normal on a socket and is not an error — hence the loop.
export @symbol("bit_rt_port_net_write_sock") fn netWriteSock(fd: int, buf: *u8, n: int): int {
  let off = 0
  let stalls = 0
  let spins = 0
  while (off < n && stalls < netMaxStalls && spins < netMaxSpins) {
    let wrote = int(write(i32(fd), buf + off, i64(n - off)))
    if (wrote > 0) {
      off = off + wrote
      // PROGRESS RESETS THE STALL BOUND: the bound is on CONSECUTIVE stalls, not
      // on writes, so a large transfer that legitimately blocks many times is
      // not mistaken for a wedged socket.
      stalls = 0
      spins = 0
    } else {
      if (wrote == 0) {
        return 0 - 1
      }
      let e = lastErr()
      if (e == eAgain()) {
        if (netAwaitReady(fd, pollWrite)) {
          stalls = stalls + 1
        } else {
          spins = spins + 1
        }
      } else {
        if (e == eIntr()) {
          spins = spins + 1
        } else {
          return 0 - 1
        }
      }
    }
  }
  if (off < n) {
    return 0 - 1
  }
  return off
}

// ---------------------------------------------------------------------------
// Deadline-bounded connect/read/write (#2291)
// ---------------------------------------------------------------------------
//
// A server that completes the handshake (or accepts) and then never writes
// parks `netReadSock`/`netDialTcp` above forever — nothing bounds
// `netAwaitReady`'s park. These siblings bound the wait instead, resolving
// ONE absolute monotonic deadline before the first poll and never restarting
// it — the same shape `runtime/root/*/os.bit`'s `osForkExecWaitBounded`
// documents at ABI.md §19.
//
// WHY THIS DOES NOT REUSE `netAwaitReady`: that primitive parks until the
// kernel poller reports readiness, with no timeout of its own, and this
// runtime has no primitive that races a poll registration against a timer for
// the SAME task — adding one would touch `runtime/sched/**`, which three
// other tickets are live in this week and which carries the
// arm/register/park ordering invariants ../../sched.bit's "arming a park"
// section documents; a half-tested change there is worse than not making it.
// So instead of registering for readiness at all, `netAwaitDeadlineTick`
// below parks the calling task on the scheduler's TIMER queue for a short,
// bounded slice (`netDeadlinePollNs`) and returns, so the retry loop below
// re-tries the non-blocking syscall itself — exactly the "poll, sleep,
// recheck the deadline" shape `osForkExecWaitBounded` uses for a wait POSIX
// itself gives no "select" for (there, waiting on a child's exit; here,
// waiting on a peer that may never speak). The cost is up to one
// `netDeadlinePollNs` of latency on an otherwise-fast wakeup; the benefit is
// zero new scheduler surface.
//
// NO GC BRACKET: every syscall touched here (`read`/`write`/`connect`) runs
// on the non-blocking sockets this provider always creates (`netSetNonBlock`
// in `netAcceptTcp`/this file's dial path), so each call returns immediately
// — EAGAIN or a result — rather than holding the OS thread in the kernel.
// `netReadSock`/`netWriteSock`/`netDialTcp` above call the identical syscalls
// with no `gcSyscallBegin`/`gcSyscallEnd` bracket for the same reason; the
// bracket is for a call that genuinely blocks the OS thread (`rtFsRead`'s
// worked example), which none of these are. The actual wait happens in
// `schedSleepUntil`, a cooperative park that yields the OS thread to the
// scheduler, not a blocking syscall.
//
// `@nosplit` (#3000, tests/bit/pollfree.bit): unlike `netAwaitReady` above —
// which calls `pollRegister`, not itself `@nosplit` — `schedSleepUntil` IS
// `@nosplit` (`runtime/sched/timer.bit`), because it is the scheduler's own
// timer-queue park, the same primitive the idle loop uses. Choosing the
// timer queue over a poll registration (the WHY above) is what makes this
// whole section provably poll-free: `netClockNowNs`, `netClampDeadline`,
// `netAwaitDeadlineTick` and the three `*Deadline` entry points below carry
// no raw GC address across `schedSleepUntil`'s park because they hold none —
// same as `netReadSock`/`netWriteSock`/`netDialTcp` — AND the compiler
// proves it, so none of the six needs a `pollFreeExceptions` entry.

// Poll interval while waiting for readiness or the deadline, whichever comes
// first: 2ms, the same value `runtime/root/*/os.bit`'s `osPollNs` uses for an
// analogous bounded wait.
const netDeadlinePollNs: int = 2000000

// Ceiling on how far past "now" a deadline is honoured: one hour, matching
// `os_run_bounded_max_ms` (ABI.md §19) — a caller typo (nanoseconds where
// milliseconds was meant, say) must not reinstate an unbounded wait.
const netDeadlineMaxWaitNs: int = 3600000000000

// Worst-case iterations of the retry loops below: the wait ceiling divided by
// the poll interval, plus slack (Power of 10 rule 2, no `while (true)`) — the
// monotonic-deadline check inside each loop is what actually ends every real
// call, well before this bound is reached.
const netDeadlineMaxPolls: int = netDeadlineMaxWaitNs / netDeadlinePollNs + 16

// The deadline elapsed before the operation completed — `osForkExecWaitBounded`'s
// `-2` "timed out" sentinel, reused here for the same reason: one convention
// for "a bounded wait gave up" across the runtime.
const netDeadlineTimedOut: int = 0 - 2

// The monotonic clock these deadlines are measured against — `runtime/park/darwin`'s
// `parkMonoNs`, the same clock `std/time`'s `monotonic()` reaches. `@nosplit`
// (#3000): `parkMonoNs` is now `@nosplit` too (pure arithmetic and `extern fn`
// calls, no allocation), so the annotation closes here rather than needing a
// `pollFreeExceptions` entry.
@nosplit fn netClockNowNs(): int {
  return parkMonoNs()
}

// The deadline a bounded call actually waits against: `deadlineNs <= 0` is
// `std/net`'s "no deadline" sentinel (a `Conn`'s zero value) and clamps to
// `netDeadlineMaxWaitNs` from now rather than truly forever, for the same
// reason `os_run_bounded_max_ms` clamps a caller's `timeoutMs`. A deadline
// already in the past clamps up to `now`, so the very first check reports the
// timeout instead of the loop spinning on a negative budget.
@nosplit fn netClampDeadline(deadlineNs: int, now: int): int {
  let cap = now + netDeadlineMaxWaitNs
  if (deadlineNs <= 0 || deadlineNs > cap) {
    return cap
  }
  if (deadlineNs < now) {
    return now
  }
  return deadlineNs
}

// Wait a short, bounded slice toward `deadlineNs`, or report there was nobody
// to wait on — mirrors `netAwaitReady`'s `false` contract for an unscheduled
// caller (a driver program the scheduler is not running), so that caller's
// own `polls` bound below still protects it; there is no cooperative sleep
// without a scheduler to drive `schedTimerExpire`; retrying tightly is thus
// the correct fallback, and it can never run past `deadlineNs` because the
// caller checks the clock again on every iteration.
@nosplit fn netAwaitDeadlineTick(deadlineNs: int): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let now = netClockNowNs()
  let wake = now + netDeadlinePollNs
  if (wake > deadlineNs) {
    wake = deadlineNs
  }
  schedSleepUntil(wake)
  return true
}

// Read up to `cap` bytes into `buf`, bounded by `deadlineNs` (absolute
// monotonic ns) rather than parking forever. Same three-way result shape as
// `osForkExecWaitBounded`: `n >= 0` bytes read (`0` — the peer closed, an
// orderly end of stream, exactly as `netReadSock` reports it), `-1` a hard
// I/O error, `-2` (`netDeadlineTimedOut`) the deadline elapsed first.
export @symbol("bit_rt_port_net_read_sock_deadline") @nosplit fn netReadSockDeadline(fd: int, buf: *u8, cap: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let n = int(read(i32(fd), buf, i64(cap)))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netClockNowNs() >= deadline) {
        return netDeadlineTimedOut
      }
      let _ = netAwaitDeadlineTick(deadline)
    } else if (e == eIntr()) {
      // Interrupted; retry immediately, same as `netReadSock`.
    } else if (e == eConnReset()) {
      return 0
    } else {
      return 0 - 1
    }
  }
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  return 0 - 1
}

// Write all `n` bytes of `buf`, bounded by `deadlineNs`. Same result shape as
// `netReadSockDeadline`: `>= 0` bytes written (always `n` on success — a
// short write is retried internally, exactly as `netWriteSock` does), `-1` a
// hard error, `-2` the deadline elapsed first.
export @symbol("bit_rt_port_net_write_sock_deadline") @nosplit fn netWriteSockDeadline(fd: int, buf: *u8, n: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let off = 0
  let polls = 0
  while (off < n && polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let wrote = int(write(i32(fd), buf + off, i64(n - off)))
    if (wrote > 0) {
      off = off + wrote
    } else if (wrote == 0) {
      return 0 - 1
    } else {
      let e = lastErr()
      if (e == eAgain()) {
        if (netClockNowNs() >= deadline) {
          return netDeadlineTimedOut
        }
        let _ = netAwaitDeadlineTick(deadline)
      } else if (e != eIntr()) {
        return 0 - 1
      }
    }
  }
  if (off < n) {
    if (netClockNowNs() >= deadline) {
      return netDeadlineTimedOut
    }
    return 0 - 1
  }
  return off
}

// Connect to `host:port`, bounded by `deadlineNs`. Same shape as
// `netDialTcp` above (SO_ERROR read back only once the handshake has
// completed one way or the other — see that function's comment for why),
// with the unbounded spin loop there replaced by a deadline check.
export @symbol("bit_rt_port_net_dial_tcp_deadline") @nosplit fn netDialTcpDeadline(host: *u8, hostLen: int, port: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  let rc = int(connect(i32(fd), saBytes(), i32(saLen)))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - 1
  }
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    if (netClockNowNs() >= deadline) {
      netClose(fd)
      return netDeadlineTimedOut
    }
    let _ = netAwaitDeadlineTick(deadline)
    // THE ADDRESS IS REBUILT EVERY ATTEMPT — see `netDialTcp`'s identical
    // comment; `netAwaitDeadlineTick` parks, so another task can leave its own
    // address in the shared `saBytes()`/`ipBytes()` scratch meanwhile.
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = int(connect(i32(fd), saBytes(), i32(saLen)))
    let ce = lastErr()
    if (rc2 >= 0 || ce == eIsConn()) {
      if (netSocketError(fd) != 0) {
        netClose(fd)
        return 0 - 1
      }
      return fd
    }
    if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
      netClose(fd)
      return 0 - 1
    }
  }
  netClose(fd)
  return 0 - 1
}
