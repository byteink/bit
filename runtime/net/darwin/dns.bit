// Darwin DNS resolution for the Stage-2 port of runtime/net/ (#1366). Split
// out of sock.bit (#1503); same module, so the constants, buffers and helpers
// there are in scope unchanged.

// ---------------------------------------------------------------------------
// DNS
// ---------------------------------------------------------------------------

// DNS I/O rides the same non-blocking socket + netpoller path TCP and UDP
// use (#6341). A lookup used to be a raw blocking `sendto`/`recvfrom` with
// SO_RCVTIMEO inside `@nosplit` code: the OS thread sat in the kernel for up
// to the attempt's window with no safepoint, so every stop-the-world
// attempted meanwhile stalled, and the thread could do nothing else. Now the
// resolving task parks on readability with the attempt's deadline
// (`netAwaitReadyOrDeadline`, ./tcpdeadline.bit), the OS thread returns to the
// scheduler, and the collector sees an ordinary parked task.
//
// The socket is registered with `pdOpen` (`netSysSocketFamily`, ./sock.bit)
// and released with `netClose` like every other socket. That also retires the
// raw-close workaround #6338 needed for its unregistered fd: `netClose`'s
// closing/closed bits are cleared by the next `pdOpen` on the same fd number.
//
// NO RAW SCRATCH POINTER IS HELD ACROSS A PARK. `dnsBytes()`/`saBytes2()`/
// `sa6Bytes()` are per-worker slots, and a task may resume on another worker
// (or share its old worker with a second resolving task) after a park, so each
// is re-derived at the point of use: the query is rebuilt and sent, and the
// reply parsed, with no park between the buffer write and the syscall or
// parse that consumes it.

// A non-blocking datagram socket for `family` (`afInet()` or `afInet6()`,
// #6338), registered with the poller, or -1.
@nosplit fn netDnsSocketFamily(family: int): int {
  return netSysSocketFamily(family, true)
}

export @symbol("bit_rt_port_net_dns_socket") @nosplit fn netDnsSocket(): int {
  return netDnsSocketFamily(afInet())
}

// #6338: the IPv6 twin, used when a nameserver's own address is IPv6 (e.g.
// Tailscale MagicDNS's `fd7a:...` entry). Still only ever asks for an A
// record — `../net.bit`'s DNS section header is explicit that AAAA answers
// are out of scope — this only changes which TRANSPORT reaches the server.
export @symbol("bit_rt_port_net_dns_socket6") @nosplit fn netDnsSocket6(): int {
  return netDnsSocketFamily(afInet6())
}

// Points the datagram socket `fd` at the nameserver `ns` (four bytes, or
// sixteen when `v6`) on `port`. A UDP `connect` is a local bookkeeping call
// that never blocks, and it means every later send needs no address (so none
// is held across a park) and the kernel drops replies from any other source.
@nosplit fn netDnsConnect(fd: int, v6: bool, ns: *u8, port: int): bool {
  if (v6) {
    netFillSockAddr6(sa6Bytes(), ns, port)
    return int(connect(i32(fd), sa6Bytes(), i32(sa6Len))) >= 0
  }
  netFillSockAddr(saBytes2(), ns, port)
  return int(connect(i32(fd), saBytes2(), i32(saLen))) >= 0
}

// Builds the query for `host` in this worker's `dnsBytes()` slot and sends it
// on the connected `fd`. False when the name does not fit the wire format or
// the kernel refuses the datagram.
@nosplit fn netDnsSend(fd: int, host: *u8, hostLen: int, qtype: int): bool {
  let query = dnsBytes()
  let qlen = netBuildQuery(query, netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  // The query is built as A; its QTYPE is the last four bytes' first two.
  netWriteU16Be(query, qlen - 4, qtype)
  let none: *u8 = nil
  return int(sendto(i32(fd), query, i64(qlen), i32(0), none, i32(0))) >= 0
}

// Waits for readability or the attempt's deadline. Returns the slice for the
// next tick: the parked path leaves it alone, and the fallback (an unscheduled
// caller, or no poller bound) sleeps or re-tries one slice, the same fallback
// `netReadSockDeadlineLoop` (./tcpdeadline.bit) uses.
@nosplit fn netDnsWait(fd: int, gen: int, deadline: int, slice: int): int {
  if (netAwaitReadyOrDeadline(fd, pollRead, gen, deadline)) {
    return slice
  }
  let _ = netAwaitDeadlineTick(deadline, slice)
  return netDeadlineNextSliceNs(slice)
}

// One datagram into this worker's reply slot (`dnsBytes() + netMaxDnsMsg`),
// waiting at most `timeoutMs`. Returns its length, `netDeadlineTimedOut`
// when nothing arrived in time, or -1 on a hard error. Bounded by
// `netDeadlineMaxPolls` (Power of 10); the monotonic deadline is what ends a
// real wait.
@nosplit fn netDnsRecv(fd: int, gen: int, timeoutMs: int): int {
  let deadline = netClockNowNs() + timeoutMs * 1000000
  let slice = netDeadlineFastPollNs
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let none: *u8 = nil
    let got = int(
      recvfrom(i32(fd), dnsBytes() + netMaxDnsMsg, i64(netMaxDnsMsg), i32(0), none, none),
    )
    if (got >= 0) {
      return got
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netClockNowNs() >= deadline) {
        return netDeadlineTimedOut
      }
      slice = netDnsWait(fd, gen, deadline, slice)
    } else if (e != eIntr()) {
      return 0 - 1
    }
  }
  return netDeadlineTimedOut
}

// Up to `attempts` query/reply exchanges over the connected `fd`, each waiting
// at most the window `ns`'s block carries (`netNsTimeoutOff`). A lost
// or late reply, a failed send and a malformed answer (or one with no A
// record) each cost an attempt and retransmit; a hard receive error, such as
// the nameserver's port refusing the datagram, ends the lookup.
@nosplit fn netDnsAttempts(fd: int, host: *u8, hostLen: int, out: *u8, ns: *u8): bool {
  let gen = *netFdGenAddr(fd)
  let timeoutMs = getU64Le(ns, netNsTimeoutOff)
  let attempts = getU64Le(ns, netNsAttemptsOff)
  let attempt = 0
  // Bounded retransmits (Power of 10): a lost query is retried a fixed number
  // of times and then reported, never waited on forever.
  while (attempt < attempts) {
    attempt = attempt + 1
    if (netDnsSend(fd, host, hostLen, 1)) {
      let got = netDnsRecv(fd, gen, timeoutMs)
      if (got == 0 - 1) {
        return false
      }
      if (got >= 0 && netParseAnswer(dnsBytes() + netMaxDnsMsg, got, netDnsId, out)) {
        return true
      }
    }
  }
  return false
}

// A datagram socket connected to the nameserver, or -1 when the name cannot
// be encoded (checked first, so no socket is opened for it) or the socket
// cannot be made.
@nosplit fn netDnsOpen(host: *u8, hostLen: int, ns: *u8, port: int, v6: bool): int {
  if (netBuildQuery(dnsBytes(), netMaxDnsMsg, host, hostLen, netDnsId) < 0) {
    return 0 - 1
  }
  let family = afInet()
  if (v6) {
    family = afInet6()
  }
  let fd = netDnsSocketFamily(family)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netDnsConnect(fd, v6, ns, port)) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// Runs the exchange on `fd` and always closes it.
@nosplit fn netDnsFinish(fd: int, host: *u8, hostLen: int, out: *u8, ns: *u8): bool {
  let ok = netDnsAttempts(fd, host, hostLen, out, ns)
  netClose(fd)
  return ok
}

// Resolve `host` to an IPv4 address, written to `out`. A dotted quad passes
// straight through; a hostname is queried against the nameserver at
// `ns[0..4]:port`. `ns` is a nameserver block (`netNsBlockBytes`, ../../net):
// the address, then the per-attempt window and the attempt count `std/net`
// chose. Each attempt waits up to that window, parked on the poller.
//
// THE NAMESERVER IS A PARAMETER RATHER THAN READ FROM /etc/resolv.conf HERE.
// The parse of that file is `netFirstNameserver` in ../net.bit, split out so it
// is testable without a filesystem; reading the file is a platform call, and
// keeping it out of here means `netResolveHost` can be pointed at a nameserver in
// the same process — which is the only way to test a resolver without depending
// on the network being up.
//
// `port` IS ALSO A PARAMETER, NOT A LITERAL 53, for the same testability
// reason (#6338): every real nameserver speaks port 53, which the ONE
// caller (`../netabi.bit`'s `netAbiResolve`) passes, but binding port 53
// for a local test stub needs root -- `_tests_/stress/netdnsfallback` points
// this at an ephemeral-port stub instead.
export @symbol("bit_rt_port_net_resolve") @nosplit fn netResolveHost(
  host: *u8,
  hostLen: int,
  ns: *u8,
  port: int,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let fd = netDnsOpen(host, hostLen, ns, port, false)
  return fd >= 0 && netDnsFinish(fd, host, hostLen, out, ns)
}

// #6338: `netResolveHost`'s IPv6 twin -- `ns` is sixteen bytes (an address
// `../dns.bit`'s `netParseIpv6`, via `../netabi.bit`'s `netAbiResolve`,
// already parsed) rather than four, and the socket dials AF_INET6/
// `sockaddr_in6`. Still an A-record query: this only changes which
// transport reaches the nameserver, not what it is asked for.
export @symbol("bit_rt_port_net_resolve6") @nosplit fn netResolveHost6(
  host: *u8,
  hostLen: int,
  ns: *u8,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let fd = netDnsOpen(host, hostLen, ns, 53, true)
  return fd >= 0 && netDnsFinish(fd, host, hostLen, out, ns)
}
