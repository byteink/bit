// Darwin DNS resolution for the Stage-2 port of runtime/net/ (#1366). Split
// out of sock.bit (#1503); same module, so the constants, buffers and helpers
// there are in scope unchanged.

// ---------------------------------------------------------------------------
// DNS
// ---------------------------------------------------------------------------

// A BLOCKING socket with SO_RCVTIMEO, ON PURPOSE. DNS is an
// occasional millisecond cost, so a bounded receive timeout buys a real error on
// packet loss without putting timer-driven wakes on the poller. It blocks the
// calling worker for up to `netDnsTimeoutMs` on a lost packet; move it onto the
// poller if resolution ever sits on a hot path.
export @symbol("bit_rt_port_net_dns_socket") @nosplit fn netDnsSocket(): int {
  let fd = int(socket(i32(afInet()), i32(sockDgram()), i32(0)))
  if (fd < 0) {
    return 0 - 1
  }
  // `tv_usec` IS 32 BITS HERE. The whole struct is zeroed first so the four
  // bytes of tail padding after it are defined.
  let k = 0
  while (k < tvSize) {
    putU8(tvBytes(), k, 0)
    k = k + 1
  }
  putU64Le(tvBytes(), tvSecOff, netDnsTimeoutMs / 1000)
  putU32Le(tvBytes(), tvUsecOff, netDnsTimeoutMs % 1000 * 1000)
  if (int(setsockopt(i32(fd), i32(solSocket()), i32(soRcvTimeo()),
                     tvBytes(), i32(tvSize))) < 0) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// The receive timeout configured on `fd`, in milliseconds, or -1 if the query
// fails. Zero means no timeout is set.
//
// EXISTS TO BE ASSERTED ON, and deliberately so — the same argument
// runtime/park/linux's `parkTimerSlackNs` makes. `struct timeval` is one of the
// three real layout differences between this file and its twin (`tv_usec` is 32
// bits on Darwin and 64 on Linux), and the ONLY behavioural guard for getting it
// wrong is that a DNS query hangs instead of timing out. A guard whose failure
// mode is a hang is not a guard: the harness reports a wedged suite rather than
// a verdict, which is the trap this project has already hit once. Reading the
// value back cannot hang and cannot flake.
export @symbol("bit_rt_port_net_rcv_timeo_ms") @nosplit fn netRcvTimeoMs(fd: int): int {
  let k = 0
  while (k < tvSize) {
    putU8(tvBytes(), k, 0)
    k = k + 1
  }
  putU32Le(lenBytes(), 0, tvSize)
  if (int(getsockopt(i32(fd), i32(solSocket()), i32(soRcvTimeo()),
                     tvBytes(), lenBytes())) < 0) {
    return 0 - 1
  }
  // `tv_usec` IS 32 BITS HERE, so only four bytes are read back.
  return getU64Le(tvBytes(), tvSecOff) * 1000 + getU32Le(tvBytes(), tvUsecOff) / 1000
}

// Resolve `host` to an IPv4 address, written to `out`. A dotted quad passes
// straight through; a hostname is queried against the nameserver at `ns[0..4]`.
//
// THE NAMESERVER IS A PARAMETER RATHER THAN READ FROM /etc/resolv.conf HERE.
// The parse of that file is `netFirstNameserver` in ../net.bit, split out so it
// is testable without a filesystem; reading the file is a platform call, and
// keeping it out of here means `netResolveHost` can be pointed at a nameserver in
// the same process — which is the only way to test a resolver without depending
// on the network being up.
export @symbol("bit_rt_port_net_resolve") @nosplit fn netResolveHost(host: *u8, hostLen: int, ns: *u8, out: *u8): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let query = dnsBytes()
  let qlen = netBuildQuery(query, netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  let fd = netDnsSocket()
  if (fd < 0) {
    return false
  }
  let reply = dnsBytes() + netMaxDnsMsg
  let attempt = 0
  // Laid out INSIDE the loop rather than once before it: `saBuf2` is shared with
  // `netSendTo`, so anything that ran in between may have overwritten it. The
  // first draft filled it at the END of the body, which left the FIRST send
  // aimed at whatever the previous caller had left there.
  // Bounded retransmits (Power of 10): a lost query is retried a fixed number
  // of times and then reported, never waited on forever.
  while (attempt < netDnsRetries) {
    netFillSockAddr(saBytes2(), ns, 53)
    if (int(sendto(i32(fd), query, i64(qlen), i32(0), saBytes2(), i32(saLen))) < 0) {
      attempt = attempt + 1
    } else {
      let none: *u8 = nil
      let got = int(recvfrom(i32(fd), reply, i64(netMaxDnsMsg), i32(0), none, none))
      if (got < 0) {
        // Timed out or interrupted: retransmit. Anything else is fatal.
        let e = lastErr()
        if (e != eAgain() && e != eIntr()) {
          netClose(fd)
          return false
        }
        attempt = attempt + 1
      } else {
        if (netParseAnswer(reply, got, netDnsId, out)) {
          netClose(fd)
          return true
        }
        // Malformed, or an answer with no A record: retry.
        attempt = attempt + 1
      }
    }
  }
  netClose(fd)
  return false
}
