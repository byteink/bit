// Darwin DNS resolution for the Stage-2 port of runtime/net/ (#1366). Split
// out of sock.bit (#1503); same module, so the constants, buffers and helpers
// there are in scope unchanged.

// ---------------------------------------------------------------------------
// DNS
// ---------------------------------------------------------------------------

// Closes a DNS socket's fd directly, bypassing `netClose` (../sock.bit).
//
// #6338: `netDnsSocket` below never calls `netPollDescOpen`/`pdOpen` -- this
// socket is deliberately raw and blocking (see its own header) and never
// parks, so it has no poll-descriptor registration to unregister. `netClose`
// assumes every fd it is given WAS `pdOpen`'d: it routes through
// `pdFdMarkClosing`/`pdFdRelease` (../../sched/polldesc.bit), which marks
// `pdRefWord[fd]`'s `closing`/`closed` bits and leaves them set until a
// FUTURE `pdOpen` on that same fd number clears them. A DNS socket's fd is
// never `pdOpen`'d going IN, so those bits are never cleared coming OUT
// either -- the very next unrelated caller to inherit this fd number from
// the kernel (observed: `../netabi.bit`'s `readResolvConf`, reading
// `/etc/resolv.conf` on the NEXT `resolve()` call, via `netReadSock`'s own
// `netFdAcquire`) finds `closing` already set and is refused before it
// issues a single syscall. That reproduced as 9 of 10 real lookups failing
// instantly (0ms, no network wait) after the first succeeded: call 1's DNS
// socket fd got reused for call 2's resolv.conf read, which inherited the
// poisoned bits and was refused. `bit_rt_fs_close` (sock.bit, the same
// close primitive `../../sched/darwin/poll.bit` uses for its own
// never-`pdOpen`'d kqueue fd) is the correct close for a resource that was
// never registered with that bookkeeping in the first place.
@nosplit fn netDnsCloseFd(fd: int) {
  let _ = int(bit_rt_fs_close(i64(fd)))
}

// A BLOCKING socket with SO_RCVTIMEO, ON PURPOSE, for `family` (`afInet()`
// or `afInet6()`, #6338). DNS is an occasional millisecond cost, so a
// bounded receive timeout buys a real error on packet loss without putting
// timer-driven wakes on the poller. It blocks the calling worker for up to
// `netDnsTimeoutMs` on a lost packet; move it onto the poller if resolution
// ever sits on a hot path.
@nosplit fn netDnsSocketFamily(family: int): int {
  let fd = int(socket(i32(family), i32(sockDgram()), i32(0)))
  if (fd < 0) {
    return 0 - 1
  }
  // `tv_usec` IS 32 BITS HERE. The whole class is zeroed first so the four
  // bytes of tail padding after it are defined.
  let k = 0
  while (k < tvSize) {
    putU8(tvBytes(), k, 0)
    k = k + 1
  }
  putU64Le(tvBytes(), tvSecOff, netDnsTimeoutMs / 1000)
  putU32Le(tvBytes(), tvUsecOff, netDnsTimeoutMs % 1000 * 1000)
  if (int(
      setsockopt(
        i32(fd), i32(solSocket()), i32(soRcvTimeo()),
        tvBytes(), i32(tvSize),
      ),
    ) <
    0) {
    netDnsCloseFd(fd)
    return 0 - 1
  }
  return fd
}

export @symbol("bit_rt_port_net_dns_socket") @nosplit fn netDnsSocket(): int {
  return netDnsSocketFamily(afInet())
}

// #6338: the IPv6 twin, used when a nameserver's own address is IPv6 (e.g.
// Tailscale MagicDNS's `fd7a:...` entry). Still only ever asks for an A
// record — `../net.bit`'s DNS section header is explicit that AAAA answers
// are out of scope — this only changes which TRANSPORT reaches the server.
export @symbol("bit_rt_port_net_dns_socket6") @nosplit fn netDnsSocket6(): int {
  return netDnsSocketFamily(afInet6())
}

// The receive timeout configured on `fd`, in milliseconds, or -1 if the query
// fails. Zero means no timeout is set.
//
// EXISTS TO BE ASSERTED ON, and deliberately so — the same argument
// runtime/park/linux's `parkTimerSlackNs` makes. `class timeval` is one of the
// three real layout differences between this file and its twin (`tv_usec` is 32
// bits on Darwin and 64 on Linux), and the ONLY behavioural guard for getting it
// wrong is that a DNS query hangs instead of timing out. A guard whose failure
// mode is a hang is not a guard: the harness reports a wedged suite rather than
// a verdict, which is the trap this project has already hit once. Reading the
// value back cannot hang and cannot flake.
export @symbol("bit_rt_port_net_rcv_timeo_ms") @nosplit fn netRcvTimeoMs(fd: int): int {
  let k = 0
  while (k < tvSize) {
    putU8(tvBytes(), k, 0)
    k = k + 1
  }
  putU32Le(lenBytes(), 0, tvSize)
  if (int(
      getsockopt(
        i32(fd), i32(solSocket()), i32(soRcvTimeo()),
        tvBytes(), lenBytes(),
      ),
    ) <
    0) {
    return 0 - 1
  }
  // `tv_usec` IS 32 BITS HERE, so only four bytes are read back.
  return getU64Le(tvBytes(), tvSecOff) * 1000 + getU32Le(tvBytes(), tvUsecOff) / 1000
}

// Resolve `host` to an IPv4 address, written to `out`. A dotted quad passes
// straight through; a hostname is queried against the nameserver at
// `ns[0..4]:port`.
//
// THE NAMESERVER IS A PARAMETER RATHER THAN READ FROM /etc/resolv.conf HERE.
// The parse of that file is `netFirstNameserver` in ../net.bit, split out so it
// is testable without a filesystem; reading the file is a platform call, and
// keeping it out of here means `netResolveHost` can be pointed at a nameserver in
// the same process — which is the only way to test a resolver without depending
// on the network being up.
//
// `port` IS ALSO A PARAMETER, NOT A LITERAL 53, for the same testability
// reason (#6338): every real nameserver speaks port 53, which the ONE
// caller (`../netabi.bit`'s `netAbiResolve`) passes, but binding port 53
// for a local test stub needs root -- `_tests_/stress/netsockdarwin` points
// this at an ephemeral-port stub instead.
export @symbol("bit_rt_port_net_resolve") @nosplit fn netResolveHost(
  host: *u8,
  hostLen: int,
  ns: *u8,
  port: int,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let query = dnsBytes()
  let qlen = netBuildQuery(query, netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  let fd = netDnsSocket()
  if (fd < 0) {
    return false
  }
  let reply = dnsBytes() + netMaxDnsMsg
  let attempt = 0
  // Laid out INSIDE the loop rather than once before it: `saBuf2` is shared with
  // `netSendTo`, so anything that ran in between may have overwritten it. The
  // first draft filled it at the END of the body, which left the FIRST send
  // aimed at whatever the previous caller had left there.
  // Bounded retransmits (Power of 10): a lost query is retried a fixed number
  // of times and then reported, never waited on forever.
  while (attempt < netDnsRetries) {
    netFillSockAddr(saBytes2(), ns, port)
    if (int(sendto(i32(fd), query, i64(qlen), i32(0), saBytes2(), i32(saLen))) < 0) {
      attempt = attempt + 1
    } else {
      let none: *u8 = nil
      let got = int(recvfrom(i32(fd), reply, i64(netMaxDnsMsg), i32(0), none, none))
      if (got < 0) {
        // Timed out or interrupted: retransmit. Anything else is fatal.
        let e = lastErr()
        if (e != eAgain() && e != eIntr()) {
          netDnsCloseFd(fd)
          return false
        }
        attempt = attempt + 1
      } else {
        if (netParseAnswer(reply, got, netDnsId, out)) {
          netDnsCloseFd(fd)
          return true
        }
        // Malformed, or an answer with no A record: retry.
        attempt = attempt + 1
      }
    }
  }
  netDnsCloseFd(fd)
  return false
}

// #6338: `netResolveHost`'s IPv6 twin -- `ns` is sixteen bytes (an address
// `../dns.bit`'s `netParseIpv6`, via `../netabi.bit`'s `netAbiResolve`,
// already parsed) rather than four, and the socket dials AF_INET6/
// `sockaddr_in6`. Still an A-record query: this only changes which
// transport reaches the nameserver, not what it is asked for.
export @symbol("bit_rt_port_net_resolve6") @nosplit fn netResolveHost6(
  host: *u8,
  hostLen: int,
  ns: *u8,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let query = dnsBytes()
  let qlen = netBuildQuery(query, netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  let fd = netDnsSocket6()
  if (fd < 0) {
    return false
  }
  let reply = dnsBytes() + netMaxDnsMsg
  let attempt = 0
  while (attempt < netDnsRetries) {
    netFillSockAddr6(sa6Bytes(), ns, 53)
    if (int(sendto(i32(fd), query, i64(qlen), i32(0), sa6Bytes(), i32(sa6Len))) < 0) {
      attempt = attempt + 1
    } else {
      let none: *u8 = nil
      let got = int(recvfrom(i32(fd), reply, i64(netMaxDnsMsg), i32(0), none, none))
      if (got < 0) {
        let e = lastErr()
        if (e != eAgain() && e != eIntr()) {
          netDnsCloseFd(fd)
          return false
        }
        attempt = attempt + 1
      } else {
        if (netParseAnswer(reply, got, netDnsId, out)) {
          netDnsCloseFd(fd)
          return true
        }
        attempt = attempt + 1
      }
    }
  }
  netDnsCloseFd(fd)
  return false
}
