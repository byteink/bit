// Darwin TCP deadline-bounded connect/read/write (#2291), split out of
// tcp.bit (#5886, E0200: tcp.bit crossed 800 lines once this file's
// `netFdAcquire`/`netFdRelease` ref-count wiring landed there) -- same
// module as sock.bit/tcp.bit/udp.bit, so every constant, scratch buffer and
// helper those files import or define (`lastErr`, `eAgain`, `ipBytes`,
// `pdFdAcquire`/`pdFdRelease`/`pdFdClosing`, etc.) is in scope here
// unchanged; nothing below needs its own import line. PURE MOVE: this is
// exactly tcp.bit's prior "Deadline-bounded connect/read/write" section,
// byte-for-byte, with no logic change from the split itself.
// ---------------------------------------------------------------------------
// Deadline-bounded connect/read/write (#2291)
// ---------------------------------------------------------------------------
//
// A server that completes the handshake (or accepts) and then never writes
// parks `netReadSock`/`netDialTcp` above forever — nothing bounds
// `netAwaitReady`'s park. These siblings bound the wait instead, resolving
// ONE absolute monotonic deadline before the first poll and never restarting
// it — the same shape `runtime/root/*/os.bit`'s `osForkExecWaitBounded`
// documents at ABI.md §19.
//
// WHY THIS DOES NOT REUSE `netAwaitReady`: that primitive parks until the
// kernel poller reports readiness, with no timeout of its own, and this
// runtime has no primitive that races a poll registration against a timer for
// the SAME task — adding one would touch `runtime/sched/**`, which three
// other tickets are live in this week and which carries the
// arm/register/park ordering invariants ../../sched/task.bit's "arming a park"
// section documents; a half-tested change there is worse than not making it.
// So instead of registering for readiness at all, `netAwaitDeadlineTick`
// below parks the calling task on the scheduler's TIMER queue for a short,
// bounded slice (`netDeadlinePollNs`) and returns, so the retry loop below
// re-tries the non-blocking syscall itself — exactly the "poll, sleep,
// recheck the deadline" shape `osForkExecWaitBounded` uses for a wait POSIX
// itself gives no "select" for (there, waiting on a child's exit; here,
// waiting on a peer that may never speak). The cost is up to one slice of
// latency on an otherwise-fast wakeup; the benefit is zero new scheduler
// surface. #5428 is what that cost is worth when a wait is SHORT and
// repeated, and why the slice is no longer a single value — see
// `netDeadlineFastPollNs` below.
//
// NO GC BRACKET: every syscall touched here (`read`/`write`/`connect`) runs
// on the non-blocking sockets this provider always creates (`netSetNonBlock`
// in `netAcceptTcp`/this file's dial path), so each call returns immediately
// — EAGAIN or a result — rather than holding the OS thread in the kernel.
// `netReadSock`/`netWriteSock`/`netDialTcp` above call the identical syscalls
// with no `gcSyscallBegin`/`gcSyscallEnd` bracket for the same reason; the
// bracket is for a call that genuinely blocks the OS thread (`rtFsRead`'s
// worked example), which none of these are. The actual wait happens in
// `schedSleepUntil`, a cooperative park that yields the OS thread to the
// scheduler, not a blocking syscall.
//
// `@nosplit` (#3000, _tests_/bit/pollfree.bit): unlike `netAwaitReady` above —
// which calls `pollRegister`, not itself `@nosplit` — `schedSleepUntil` IS
// `@nosplit` (`runtime/sched/timer.bit`), because it is the scheduler's own
// timer-queue park, the same primitive the idle loop uses. Choosing the
// timer queue over a poll registration (the WHY above) is what makes this
// whole section provably poll-free: `netClockNowNs`, `netClampDeadline`,
// `netAwaitDeadlineTick` and the three `*Deadline` entry points below carry
// no raw GC address across `schedSleepUntil`'s park because they hold none —
// same as `netReadSock`/`netWriteSock`/`netDialTcp` — AND the compiler
// proves it, so none of the six needs a `pollFreeExceptions` entry.

// Poll interval while waiting for readiness or the deadline, whichever comes
// first: 2ms, the same value `runtime/root/*/os.bit`'s `osPollNs` uses for an
// analogous bounded wait. This is the STEADY-STATE slice, not the first one —
// `netDeadlineFastPollNs` below is what a wait starts at.
const netDeadlinePollNs: int = 2000000

// TWO TIERS, AND WHY (#5428). A single 2ms slice makes every miss cost 2ms,
// so a request/response protocol whose peer answers in microseconds — an
// HTTP/1.1 keep-alive connection waiting for its next request is the case
// that found this — is capped at 1/0.002s = 500 exchanges per second no
// matter how far away the configured deadline is. Measured on a same-process
// ping-pong over one reused loopback connection, 2000 exchanges: 466/s with a
// deadline armed against 39,625/s with the identical read taking `netReadSock`
// instead. The 2ms was never a latency budget; it was picked as a cheap
// heartbeat for a wait that was expected to be long.
//
// NOT SOLVED BY LOWERING `netDeadlinePollNs`. That constant is also what makes
// a GENUINELY idle wait nearly free: a 60s idle timeout costs 30,000 wakeups at
// 2ms and 60 million at 1us, and it would be paid for the whole wait rather
// than for the window where a byte is plausibly already in flight. So the
// slice starts at `netDeadlineFastPollNs` and DOUBLES toward
// `netDeadlinePollNs` instead of being short everywhere: a peer that is about
// to speak is answered within one short slice, a peer that is not reaches the
// cheap steady state within ~4ms and pays exactly the old cost from there on.
//
// NOW WIRED IN AS A READINESS RACE, for `netReadSockDeadline` only (#5865):
// `netAwaitReadyOrDeadline` above races a register-once poll wait
// (`pdWait`/`pdWake`, `../../sched/polldesc.bit`) against `schedTimerPush`,
// with the loser retracted via `schedTimerCancel`'s return (`pdCancel` on the
// poll side). `netWriteSockDeadline`/`netDialTcpDeadline` below still use the
// ramp, per the ticket that wired this in — they are not blocked on anything,
// just not yet done. This paragraph's history (`schedtimer`'s retraction
// proof, #5430/#5433/#5438 landing `@nosplit` on both retraction primitives)
// is why the wiring below was reachable without giving up `@nosplit`; it is
// no longer the reason it is undone, since it is not undone.
//
// AND NOT BY SPINNING ON `schedYield`, which looks like the obvious way to
// make the first retry free. A yielding task stays RUNNABLE, so
// `schedFindWorkAt` hands it straight back and `workerBody` never reaches the
// `pollDrain` it only runs when find-work returns 0 — a spin here starves the
// poll drain that wakes the peer this read is waiting for. Parking, even for
// a microsecond, is what lets the worker get to that drain, which is why the
// fast tier is a short sleep rather than no sleep.
//
// WHAT THE SLICE POLICY IS WORTH, AND WHAT IT IS NOT. Three policies were
// measured on the harness above, interleaved: a flat 1us first tier
// (28,128/29,868/29,169 exchanges per second), a flat 2us one
// (29,683/29,442/29,050), and the doubling ramp this file ships
// (24,856/27,921/27,301), against a plain-`read` control of 36,028-39,617 on
// the same runs. They are the same number. So what a miss COSTS is the
// park/unpark round trip, not the nanoseconds slept — which is also why the
// remaining ~8us per exchange against the control does not close by making
// the slice smaller, and why the only thing that closes it is not polling at
// all — a deadline-bound read parking on readiness the way `netReadSock`
// does, which `netAwaitReadyOrDeadline` above now is (#5865); the ramp below
// remains the fallback for an unscheduled caller or one with no poller bound.
//
// THE RAMP IS THE TIE-BREAK, not the win: among policies that measure the
// same it is the one that needs no window constant fitted to one workload,
// and it reaches the cheap steady state on its own for a wait that turns out
// to be long. Same shape and same reason as `runtime/park`'s
// `parkNextBackoff`, which ramps an idle worker for this identical problem;
// kept local rather than imported because that ramp's ceiling is
// `parkMaxBackoffNs` (1ms) and the ceiling here has to stay
// `netDeadlinePollNs`.
const netDeadlineFastPollNs: int = 1000

// The slice after `cur`: double it, never past the steady-state interval.
@nosplit fn netDeadlineNextSliceNs(cur: int): int {
  let next = cur * 2
  if (next > netDeadlinePollNs) {
    return netDeadlinePollNs
  }
  return next
}

// Doublings from `netDeadlineFastPollNs` to `netDeadlinePollNs` (1us to 2ms
// is 11), rounded up with slack: the extra iterations the ramp costs the
// bound below over a loop that waited the full interval every time.
const netDeadlineRampPolls: int = 16

// Worst-case iterations of the retry loops below: the ramp in full, plus the
// wait ceiling divided by the steady-state interval, plus slack (Power of 10
// rule 2, no `while (true)`) — the monotonic-deadline check inside each loop
// is what actually ends every real call, well before this bound is reached.
const netDeadlineMaxPolls: int = netDeadlineRampPolls +
  netDeadlineMaxWaitNs / netDeadlinePollNs +
  16

// The deadline elapsed before the operation completed — `osForkExecWaitBounded`'s
// `-2` "timed out" sentinel, reused here for the same reason: one convention
// for "a bounded wait gave up" across the runtime.
const netDeadlineTimedOut: int = 0 - 2

// The monotonic clock these deadlines are measured against — `runtime/park/darwin`'s
// `parkMonoNs`, the same clock `std/time`'s `monotonic()` reaches. `@nosplit`
// (#3000): `parkMonoNs` is now `@nosplit` too (pure arithmetic and `extern fn`
// calls, no allocation), so the annotation closes here rather than needing a
// `pollFreeExceptions` entry.
@nosplit fn netClockNowNs(): int {
  return parkMonoNs()
}

// `netClampDeadline`/`netDeadlineMaxWaitNs` are core now (../net.bit, #2552)
// — pure deadline-vs-now arithmetic, no OS call.

// Wait a short, bounded slice toward `deadlineNs`, or report there was nobody
// to wait on — mirrors `netAwaitReady`'s `false` contract for an unscheduled
// caller (a driver program the scheduler is not running), so that caller's
// own `polls` bound below still protects it; there is no cooperative sleep
// without a scheduler to drive `schedTimerExpire`; retrying tightly is thus
// the correct fallback, and it can never run past `deadlineNs` because the
// caller checks the clock again on every iteration.
@nosplit fn netAwaitDeadlineTick(deadlineNs: int, sliceNs: int): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let now = netClockNowNs()
  let wake = now + sliceNs
  if (wake > deadlineNs) {
    wake = deadlineNs
  }
  schedSleepUntil(wake)
  return true
}

// Park until `fd` is ready for `interest` OR `deadlineNs` passes, whichever
// comes first (#5865) — the register-once model's readiness-vs-timer race.
// Same `false` contract as `netAwaitReady`: nobody to park on (unscheduled
// caller, no poller bound, or the fd's generation moved / its slot is held
// by another waiter) — the caller's own bounded fallback
// (`netAwaitDeadlineTick` below) takes over exactly as it does when
// `netAwaitReady` itself declines.
//
// EXACTLY-ONE-WAKEUP, told apart by `schedTimerCancel`'s return, same rule
// as the pre-#5864 version of this function used: `true` means the timer
// entry was still linked, so the POLL side woke this task — `pdWake`
// (`../../sched/darwin/poll.bit`'s drain) already removed it from the slot,
// nothing left to retract. `false` means the timer already fired
// (`schedTimerExpire` unlinked it first), so the still-claimed poll slot is
// retracted here, via `pdCancel`, before this task is touched again.
// `gen` is the caller's entry-time generation (#5886) — same contract as
// `../sock.bit`'s `netAwaitReady`.
@nosplit fn netAwaitReadyOrDeadline(fd: int, interest: int, gen: int, deadlineNs: int): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return false
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return false
  }
  let dir = pdDirWrite
  if (interest == pollRead) {
    dir = pdDirRead
  }
  if (!schedParkArm()) {
    return false
  }
  let r = pdWait(fd, dir, gen, taskAddr)
  if (r == pdAlreadyReady) {
    let _ = schedParkDisarm()
    return true
  }
  if (r != pdClaimed) {
    // `pdStaleGen` reports ready, not not-ready (#5934, see `../sock.bit`'s
    // `netAwaitReady` header): the close IS the wake, and the caller's
    // retry finds `pdFdClosing` instead of falling back to
    // `netAwaitDeadlineTick` and waiting out the deadline. `pdBusy`
    // (another waiter already holds this direction's slot) reports
    // not-ready — nothing will wake this task.
    let _ = schedParkDisarm()
    return r == pdStaleGen
  }
  schedPollPendingInc()
  *(t + taskDeadline) = deadlineNs
  schedTimerPush(s, taskAddr)
  schedPark()
  if (!schedTimerCancel(s, taskAddr)) {
    if (pdCancel(fd, dir, taskAddr, gen)) {
      schedPollPendingDec()
    }
  }
  return true
}

// Read up to `bufCap` bytes into `buf`, bounded by `deadlineNs` (absolute
// monotonic ns) rather than parking forever. Same three-way result shape as
// `osForkExecWaitBounded`: `n >= 0` bytes read (`0` — the peer closed, an
// orderly end of stream, exactly as `netReadSock` reports it), `-1` a hard
// I/O error, `-2` (`netDeadlineTimedOut`) the deadline elapsed first.
export @symbol("bit_rt_port_net_read_sock_deadline") @nosplit fn netReadSockDeadline(
  fd: int,
  buf: *u8,
  bufCap: int,
  deadlineNs: int,
): int {
  let gen = *netFdGenAddr(fd)
  if (!netFdAcquire(fd, gen)) {
    return 0 - 1
  }
  let n = netReadSockDeadlineLoop(fd, gen, buf, bufCap, deadlineNs)
  netFdRelease(fd)
  return n
}

@nosplit fn netReadSockDeadlineLoop(
  fd: int,
  gen: int,
  buf: *u8,
  bufCap: int,
  deadlineNs: int,
): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let polls = 0
  let slice = netDeadlineFastPollNs
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let n = int(read(i32(fd), buf, i64(bufCap)))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netClockNowNs() >= deadline) {
        return netDeadlineTimedOut
      }
      // Race readiness against the deadline (#5865) rather than the ramp;
      // fall back to the tick only when there is no current task or no
      // poller bound (`netAwaitReadyOrDeadline`'s own `false` contract) —
      // the unscheduled/no-poller case the ramp was written for.
      if (netAwaitReadyOrDeadline(fd, pollRead, gen, deadline)) {
        if (pdFdClosing(fd)) {
          return 0 - 1
        }
      } else {
        let _ = netAwaitDeadlineTick(deadline, slice)
        slice = netDeadlineNextSliceNs(slice)
      }
    } else if (e == eIntr()) {
      // Interrupted; retry immediately, same as `netReadSock`.
    } else if (e == eConnReset()) {
      return 0
    } else {
      return 0 - 1
    }
  }
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  return 0 - 1
}

// Write all `n` bytes of `buf`, bounded by `deadlineNs`. Same result shape as
// `netReadSockDeadline`: `>= 0` bytes written (always `n` on success — a
// short write is retried internally, exactly as `netWriteSock` does), `-1` a
// hard error, `-2` the deadline elapsed first.
export @symbol("bit_rt_port_net_write_sock_deadline") @nosplit fn netWriteSockDeadline(
  fd: int,
  buf: *u8,
  n: int,
  deadlineNs: int,
): int {
  if (!netFdAcquire(fd, *netFdGenAddr(fd))) {
    return 0 - 1
  }
  let wrote = netWriteSockDeadlineLoop(fd, buf, n, deadlineNs)
  netFdRelease(fd)
  return wrote
}

// Waits one ramp slice toward `deadline`, then reports what the caller's
// next `slice` should be. Negative means stop: `netDeadlineTimedOut` (`-2`)
// or `-1` for a `netClose` that landed during the wait (#5886) — never
// confusable with a real slice, which is always a positive nanosecond count.
@nosplit fn netWriteSockDeadlineWait(fd: int, deadline: int, slice: int): int {
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  let _ = netAwaitDeadlineTick(deadline, slice)
  if (pdFdClosing(fd)) {
    return 0 - 1
  }
  return netDeadlineNextSliceNs(slice)
}

@nosplit fn netWriteSockDeadlineLoop(fd: int, buf: *u8, n: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let off = 0
  let polls = 0
  let slice = netDeadlineFastPollNs
  while (off < n && polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let wrote = int(write(i32(fd), buf + off, i64(n - off)))
    if (wrote > 0) {
      off = off + wrote
    } else if (wrote == 0) {
      return 0 - 1
    } else if (lastErr() == eAgain()) {
      let next = netWriteSockDeadlineWait(fd, deadline, slice)
      if (next < 0) {
        return next
      }
      slice = next
    } else if (lastErr() != eIntr()) {
      return 0 - 1
    }
  }
  if (off < n) {
    if (netClockNowNs() >= deadline) {
      return netDeadlineTimedOut
    }
    return 0 - 1
  }
  return off
}

// Connect to `host:port`, bounded by `deadlineNs`. Same shape as
// `netDialTcp` above (SO_ERROR read back only once the handshake has
// completed one way or the other — see that function's comment for why),
// with the unbounded spin loop there replaced by a deadline check.
export @symbol("bit_rt_port_net_dial_tcp_deadline") @nosplit fn netDialTcpDeadline(
  host: *u8,
  hostLen: int,
  port: int,
  deadlineNs: int,
): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netFdAcquire(fd, *netFdGenAddr(fd))) {
    netClose(fd)
    return 0 - 1
  }
  let rc = netDialTcpDeadlineConnect(fd, host, hostLen, port, deadlineNs)
  netFdRelease(fd)
  return rc
}

// Same out-parameter shape as `./tcp.bit`'s `netDialTcpCheckDone`, and for
// the identical reason (a negative sentinel would collide with a real
// errno). Kept as its own copy rather than shared: this variant's failure
// path is a flat `-1` (deadline callers do not preserve errno), the
// non-deadline one's is `0 - errno`.
@nosplit fn netDialTcpDeadlineCheckDone(fd: int, rc2: int, ce: int, outResult: *i64): bool {
  if (rc2 >= 0 || ce == eIsConn()) {
    if (netSocketError(fd) != 0) {
      netClose(fd)
      *outResult = i64(0 - 1)
      return true
    }
    *outResult = i64(fd)
    return true
  }
  if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
    netClose(fd)
    *outResult = i64(0 - 1)
    return true
  }
  return false
}

@nosplit fn netDialTcpDeadlineConnect(
  fd: int,
  host: *u8,
  hostLen: int,
  port: int,
  deadlineNs: int,
): int {
  let ip = ipBytes()
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  netFillSockAddr(saBytes(), ip, port)
  let rc = int(connect(i32(fd), saBytes(), i32(saLen)))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - 1
  }
  let polls = 0
  let slice = netDeadlineFastPollNs
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    if (netClockNowNs() >= deadline) {
      netClose(fd)
      return netDeadlineTimedOut
    }
    let _ = netAwaitDeadlineTick(deadline, slice)
    slice = netDeadlineNextSliceNs(slice)
    if (pdFdClosing(fd)) {
      netClose(fd)
      return 0 - 1
    }
    // THE ADDRESS IS REBUILT EVERY ATTEMPT — see `netDialTcp`'s identical
    // comment; `netAwaitDeadlineTick` parks, so another task can leave its own
    // address in this worker's `saBytes()`/`ipBytes()` slot, or this task can
    // resume on a different worker's (unfilled) slot (#3273).
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = int(connect(i32(fd), saBytes(), i32(saLen)))
    let ce = lastErr()
    if (netDialTcpDeadlineCheckDone(fd, rc2, ce, netDialDoneAddr())) {
      return int(*netDialDoneAddr())
    }
  }
  netClose(fd)
  return 0 - 1
}
