// SEAM 1 of the runtime port (#1574, reshaped by #1600): the 12
// `bit_rt_net_*` ABI wrappers (ABI.md §20) over the ported Darwin socket
// engine. This is `runtime/root/`'s `bit_rt_net_*` block expressed in Bit —
// pure marshalling between the managed `string` boundary the compiler emits and
// the `*u8 + length` boundary the socket engine speaks.
//
// ---------------------------------------------------------------------------
// WHY THE WRAPPERS LIVE PER-PLATFORM NOW (io.bit / fs.bit shape, #1600)
// ---------------------------------------------------------------------------
//
// SEAM 1 first kept these wrappers in the platform-FREE parent (`net/netabi.bit`)
// and reached the socket engine by `extern function`. On aarch64-macos that is
// fine — an `extern` is a load-time dyld import — but a Linux `--emit-obj` rejects
// any `extern function` naming a symbol absent from `libbitrt.a` (E0078), and
// because the parent module is imported by `net/{linux,darwin}` a single such
// `extern` broke the providers' Linux build too. G3 (#1584) assembles
// `libbitrt.a` per module on both Linux triples, so it would have hit exactly
// this. See ../linux/netabi.bit's header for the full account.
//
// The fix is the `root/{linux,darwin}/fs.bit` shape (#1606): the wrappers live IN
// each platform provider, calling the socket engine functions (`bit_rt_port_net_*`)
// as module-scoped SIBLINGS by their Bit name — a local call, never an `extern` —
// and reaching the platform-free glue by ordinary `import`. This Darwin half is
// a byte-for-byte mirror of the Linux one save this header; only the socket engine
// the sibling names resolve to differs (libSystem calls vs raw syscalls).
//
// ---------------------------------------------------------------------------
// PINS CARRY THE BARE ABI NAME
// ---------------------------------------------------------------------------
//
// These ARE `bit_rt_net_listen` and the rest — G2 (#1583) dropped the `_root`
// infix, so there is exactly one definition and every call lands here. The net
// suites (`_tests_/imports/net{tcp,udp,dns,http,tcpbulk}`) exercise these bodies
// directly; they are not a staging area.
//
// ---------------------------------------------------------------------------
// NO PATH TO A NET RtFn, SO NO PIN CYCLE
// ---------------------------------------------------------------------------
//
// The wrappers call the port-internal socket functions (`netListenTcp`/…, pinned
// `bit_rt_port_net_*` by #1366), never the `netListen`/`netDial`/… BUILTINS that
// would lower to `bit_rt_net_*` and self-recurse after G2's rename. `./make
// test-rootpins` proves it at the object level, with `runtime/net/darwin` in its list.
//
// ---------------------------------------------------------------------------
// WHY THE BUFFERS HERE ARE MANAGED `[]i64`, NOT RAW `rtStrAlloc` ADDRESSES
// (#1668 — and THE COMMENT THIS REPLACES WAS WRONG)
// ---------------------------------------------------------------------------
//
// What stood here claimed: "`netAbiRead`/`netAbiUdpRecv` allocate, park in a
// socket call (a safepoint), then trim. The collector scans stacks
// CONSERVATIVELY (ABI.md §5), so the object address in a plain `int`/`*u8` local
// pins the object across the park."
//
// ABI.md §5 says the opposite of what that read it to say, and the difference is
// #1656 — an s0 that cost four G3 attempts. §5: "the running task's stack is
// walked PRECISELY (§4); every *other* registered task's stack is scanned
// conservatively". A runtime frame holding a GC object as a raw `int` is named
// by no stack map, so while this task is the RUNNING one the precise walk does
// not see it at all. The identical false premise was in
// `runtime/root/{darwin,linux}/io.bit` and #1658 corrected it there.
//
// AND THE PARK IS NOT EVEN THE DANGEROUS PART. `netReadSock`'s retry loop
// (../tcp.bit) carries a compiler-synthesized `bl bit_rt_safepoint` at its back
// edge, and when `netAwaitReady` finds no task to park on it SPINS — staying
// `running` across that poll. So a collection can run with this frame's raw
// address invisible without any park occurring.
//
// `@nosplit` is the usual fix and IS NOT AVAILABLE HERE: E0075 makes the
// guarantee transitive over the whole callee subtree, and that subtree reaches
// `schedPark`. The port layer must be able to park; that is not negotiable.
//
// So this file takes the OTHER half of what #1658 requires — not the annotation
// but the property behind it: NO RAW GC ADDRESS MAY BE HELD ACROSS A POLL. Every
// receive buffer here is now a MANAGED `[]i64` local, which is a real stack-map
// slot the precise walk names, and whose backing the non-moving collector never
// relocates — so `ptrOf` on it is stable across any number of polls and parks.
// The socket engine already takes its buffers as `*u8` parameters, so it needs
// no change: the caller's managed local is what keeps them alive, exactly the
// contract `runtime/root/floats.bit`'s `packLowBytes` documents.
//
// `[]i64` rather than `[]byte`: `[]i64(k)` is `k` contiguous 8-byte words,
// i.e. `k * 8` bytes of scratch, sized independently of the transfer's own
// element width. (`[]u8`/`[]byte` packs one byte per element too, as of
// #3121/#3226, but this scratch mechanism is about a stable, GC-tracked
// pointer across a park — orthogonal to which type names the bytes — so it is
// left as `[]i64` rather than restructured.)
//
// The allocate-and-copy that turns a filled scratch into the returned `string`
// is the one place a raw address still appears, and it lives inside the
// `@nosplit` helper `strFromPacked`, pulled up to ../netabi.bit (#2552) along
// with the rest of this file's byte/string marshalling — none of it touches
// the kernel, so no collection can occur there either.

import { loadByte, storeByte } from "../../gc"
// `netParseIpv4`, `netMax*` and the DNS codec are already imported from
// "../../net" by this module's sibling sock.bit (imports are module-scoped), so
// re-importing them here is an E0042 redeclaration — only the name sock.bit
// does NOT bring in is imported. `emptyStr`, `u8At`, `scratchWords`,
// `strData`, `strSizeOf`, `strFromPacked`, `formatQuad` and the UDP
// last-sender slot accessors are core (../netabi.bit, #2552) too,
// module-scoped the same way.
import { netFirstNameserver, emptyStr, u8At, scratchWords, strData, strSizeOf,
         strFromPacked, formatQuad, udpSenderSlot, udpValidAt, udpSenderWordAt,
         copySockAddrWords } from "../../net"

// ---------------------------------------------------------------------------
// Marshalling helpers
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// TCP (ABI.md §20)
// ---------------------------------------------------------------------------

// `bit_rt_net_listen`: a listening TCP socket on `host:port`, or -1. `port == 0`
// asks the kernel to choose one; read it back with `net_local_port`.
export @symbol("bit_rt_net_listen") @nosplit fn netAbiListen(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netListenTcp(strData(host), strSizeOf(host), port, 512)
}

// `bit_rt_net_local_port`: the port `fd` is bound to, or -1.
export @symbol("bit_rt_net_local_port") @nosplit fn netAbiLocalPort(fd: int): int {
  return netSockLocalPort(fd)
}

// `bit_rt_net_accept`: the next connection on listener `fd`, or -1. Parks the
// calling green thread until a peer arrives.
export @symbol("bit_rt_net_accept") fn netAbiAccept(fd: int): int {
  return netAcceptTcp(fd)
}

// `bit_rt_net_dial`: a connected TCP socket to `host:port`, or -1. Parks until
// the handshake completes.
export @symbol("bit_rt_net_dial") fn netAbiDial(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netDialTcp(strData(host), strSizeOf(host), port)
}

// `bit_rt_net_read`: up to `max` bytes from `fd`, parking until some arrive.
// Empty means the peer closed — an orderly end of stream. An I/O error reads as
// empty too, exactly as `runtime/root/` documents.
export @symbol("bit_rt_net_read") fn netAbiRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  // MANAGED scratch, not `rtStrAlloc(max)` (#1668). `netReadSock` loops, polls
  // and may park; `scratch` is a stack-map slot so the precise walk names it
  // throughout, and the non-moving collector keeps `ptrOf` valid.
  let scratch = []i64(scratchWords(max))
  let n = netReadSock(fd, u8At(int(ptrOf(scratch))), max)
  if (n <= 0) {
    return emptyStr()
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

// `bit_rt_net_write`: all of `s` to `fd`, parking whenever the send buffer is
// full. Returns the byte count, or -1. The port layer retries a short write.
export @symbol("bit_rt_net_write") fn netAbiWrite(fd: int, s: int): int {
  return netWriteSock(fd, strData(s), strSizeOf(s))
}

// ---------------------------------------------------------------------------
// Deadline-bounded dial/read/write (#2291)
// ---------------------------------------------------------------------------
//
// `std/net`'s `dialDeadline`/`readDeadline`/`writeDeadline` reach these through
// a plain `extern fn`, not the compiler-recognized `netDial`/`netRead`/`netWrite`
// builtins above — so a `string` may not cross the boundary at all (SPEC
// §11.7 admits only scalars and raw pointers), the same constraint `std/fs`'s
// `bit_rt_fs_is_symlink_w` documents. `std/net` packs a `string` into a
// caller-owned `[]byte` first and passes its address as `words`/length; a Bit
// `[]byte` is byte-packed (ABI.md §2, #3121/#3226), so each entry point below
// COPIES it into its own MANAGED `*u8` scratch (see "WHY THE BUFFERS HERE ARE
// MANAGED" — the scratch is about a stable, GC-tracked pointer across a park,
// not about a format conversion) before handing it to the packed-byte socket
// engine in ../tcp.bit.

// Bound on a packed host/body the entry points below will unpack, so the
// copy loops are statically provable (Power of 10 rule 2). 255 matches the
// longest legal DNS name; a caller with a longer `host` was never going to
// resolve anyway.
const netAbiMaxHost: int = 255

// Bound on a written body: generous rather than tight — this is a request's
// wire bytes (line, headers, body), not a socket-buffer size — so an ordinary
// POST is nowhere near it while the copy loop below still has a fixed ceiling.
const netAbiMaxBody: int = 67108864

// `bit_rt_net_dial_deadline_w`: like `bit_rt_net_dial`, but bounded by an
// ABSOLUTE monotonic deadline rather than parking forever. Returns the
// connected fd, or a negative sentinel: -1 hard failure, -2 the deadline
// elapsed first.
export @symbol("bit_rt_net_dial_deadline_w") fn netAbiDialDeadlineW(hostWords: int, hostLen: int, port: int, deadlineNs: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  if (hostWords == 0 || hostLen <= 0 || hostLen > netAbiMaxHost) {
    return 0 - 1
  }
  // MANAGED scratch (#1668): `netDialTcpDeadline` polls and may park, and only
  // a stack-map slot survives that — see this file's "WHY THE BUFFERS HERE
  // ARE MANAGED" section.
  let scratch = []i64(scratchWords(hostLen))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < hostLen) { // bounded by `hostLen`, itself bounded by `netAbiMaxHost`
    storeByte(packed + i, loadByte(hostWords + i))
    i = i + 1
  }
  return netDialTcpDeadline(u8At(packed), hostLen, port, deadlineNs)
}

// `bit_rt_net_read_deadline_w`: like `bit_rt_net_read`, but bounded, and
// writing into the caller's own packed `outWords` buffer (a `[]byte(max)`'s
// backing, ABI.md §2, #3121/#3226) rather than returning a fresh `string` — an
// `extern fn` cannot return one either (SPEC §11.7). Returns the byte count
// written (`0` — the peer closed, an orderly end of stream), or a negative
// sentinel: -1 hard I/O error, -2 the deadline elapsed first.
export @symbol("bit_rt_net_read_deadline_w") fn netAbiReadDeadlineW(fd: int, outWords: int, bufCap: int, deadlineNs: int): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  let scratch = []i64(scratchWords(bufCap))
  let packed = int(ptrOf(scratch))
  let n = netReadSockDeadline(fd, u8At(packed), bufCap, deadlineNs)
  if (n <= 0) {
    return n
  }
  let i = 0
  while (i < n) { // bounded by `n`, itself bounded by `bufCap`
    storeByte(outWords + i, loadByte(packed + i))
    i = i + 1
  }
  return n
}

// `bit_rt_net_write_deadline_w`: like `bit_rt_net_write`, but bounded — `s`
// crosses as `words`/`n` for the same reason `dial`'s `host` does above.
// Returns the byte count written, or a negative sentinel: -1 hard failure,
// -2 the deadline elapsed first.
export @symbol("bit_rt_net_write_deadline_w") fn netAbiWriteDeadlineW(fd: int, words: int, n: int, deadlineNs: int): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  let scratch = []i64(scratchWords(n))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < n) { // bounded by `n`, itself bounded by `netAbiMaxBody`
    storeByte(packed + i, loadByte(words + i))
    i = i + 1
  }
  return netWriteSockDeadline(fd, u8At(packed), n, deadlineNs)
}

// `bit_rt_net_shutdown_sock_w`: shut both directions of `fd` down without
// releasing it for reuse (#3016) — see `netShutdownSock`'s doc comment
// (../tcp.bit) for why this exists alongside plain `close`. No buffer, so
// unlike its siblings above this needs no packed-byte scratch. `true` on
// success.
export @symbol("bit_rt_net_shutdown_sock_w") @nosplit fn netAbiShutdownSockW(fd: int): bool {
  return netShutdownSock(fd)
}

// ---------------------------------------------------------------------------
// UDP (ABI.md §20)
// ---------------------------------------------------------------------------
//
// THE LAST-SENDER STATE AND ITS SLOT ACCESSORS (`udpSenderSlot`, `udpValidAt`,
// `udpSenderWordAt`, `copySockAddrWords`) ARE CORE NOW (../netabi.bit, #2552)
// — they are pure per-worker scratch bookkeeping with no OS call. What stays
// here is `netAbiUdpBind`/`Send`/`Recv`, because each calls the OS-specific
// socket engine (`netBindUdp`, `netSendTo`, `netRecvFrom`).
//
// WHY PER-WORKER (not one shared slot, #3272): a second task on a second OS
// thread racing `netAbiUdpRecv` would otherwise clobber the first task's
// just-recorded sender. `netAbiUdpRecv` below writes the raw `recvfrom`
// result into a throwaway per-call scratch (`peer`), and only once
// `netRecvFrom` returns — the task's own worker id can change across that
// park — does it ask `udpSenderSlot()` for the CURRENT worker's slot and copy
// into it. See ../netabi.bit's header for the rest of the argument.

// `bit_rt_net_udp_bind`: a datagram socket bound to `host:port`, or -1.
export @symbol("bit_rt_net_udp_bind") @nosplit fn netAbiUdpBind(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netBindUdp(strData(host), strSizeOf(host), port)
}

// `bit_rt_net_udp_send`: one datagram of `data` to `host:port` from `fd`.
// Returns the byte count, or -1.
export @symbol("bit_rt_net_udp_send") fn netAbiUdpSend(fd: int, host: int, port: int, data: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netSendTo(fd, strData(host), strSizeOf(host), port, strData(data), strSizeOf(data))
}

// `bit_rt_net_udp_recv`: up to `max` bytes of the next datagram on `fd`, parking
// until one arrives. Records the sender, in THIS TASK'S OWN worker's slot, for
// `udp_sender_host`/`_port` — see the header comment above for why the slot is
// decided only after `netRecvFrom` returns. On error returns empty and marks
// that slot invalid; a zero-length datagram returns empty with a valid sender
// (UDP has no end-of-stream).
export @symbol("bit_rt_net_udp_recv") fn netAbiUdpRecv(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  // MANAGED scratch (#1668), both of them: `scratch` (the datagram) and `peer`
  // (the raw sockaddr `netRecvFrom` fills) must be managed locals rather than
  // raw addresses, because `netRecvFrom` parks on the same engine as
  // `netAbiRead`. `peer` is deliberately NOT slot-indexed yet — see the header
  // comment on why the slot can only be decided after the park is over.
  let scratch = []i64(scratchWords(max))
  let peer = []i64(4)
  let n = netRecvFrom(fd, u8At(int(ptrOf(scratch))), max, u8At(int(ptrOf(peer))))

  let slot = udpSenderSlot()
  if (n < 0) {
    if (slot >= 0) {
      *(udpValidAt(slot)) = 0
    }
    return emptyStr()
  }
  if (slot >= 0) {
    copySockAddrWords(ptrOf(peer), udpSenderWordAt(slot))
    *(udpValidAt(slot)) = 1
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

// `bit_rt_net_udp_sender_host`/`_port` (the last recv's sender, read back on
// THIS task's own worker slot) are core now too (../netabi.bit, #2552) — pure
// accessors over the per-worker state above, no OS call.

// ---------------------------------------------------------------------------
// DNS (ABI.md §20)
// ---------------------------------------------------------------------------

// `/etc/resolv.conf` is read into a fixed, bounded scratch (Power of 10 rule 3,
// no unbounded growth): a nameserver directive lives at the top of the file, so
// the first page bounds every real config. `runtime/root/` reads the whole file with a
// growing buffer; this reads at most `resolvConfMax` and finds the first
// `nameserver` line within it, behaviourally identical for every practical
// `resolv.conf`.
const resolvConfMax: int = 4096

// Read up to `bufCap` bytes of `/etc/resolv.conf` into `bufPtr`, returning the byte
// count or -1 if the file cannot be opened. `fsOpen`/`fsClose` are language
// builtins (they lower to RtFn calls, not `extern function` declarations);
// `netReadSock` is this module's socket-read sibling, and `read(2)` is generic
// across a socket and a regular file — a blocking regular file never returns
// EAGAIN, so its poller path is never taken.
//
// BOUNDED (Power of 10 rule 2): `total` rises by at least 1 each iteration (a
// `n <= 0` sets `done`) and the loop also exits at `total >= bufCap`.
fn readResolvConf(bufPtr: *u8, bufCap: int): int {
  let fd = fsOpen("/etc/resolv.conf", false)
  if (fd < 0) {
    return 0 - 1
  }
  let total = 0
  let done = false
  while (!done && total < bufCap) {
    let n = netReadSock(fd, bufPtr + total, bufCap - total)
    if (n <= 0) {
      done = true
    } else {
      total = total + n
    }
  }
  fsClose(fd)
  return total
}

// `bit_rt_net_resolve`: the first IPv4 A-record for `host` as a dotted quad, or
// "" on failure. A dotted-quad `host` passes straight back. Uses the first
// nameserver in /etc/resolv.conf (ABI.md §20).
//
// `netResolveHost` (this module's socket sibling) takes the nameserver as a
// parameter, so this wrapper owns the file read. A missing or nameserver-less
// file resolves to "", which the caller reports as a bad address.
export @symbol("bit_rt_net_resolve") fn netAbiResolve(host: int): int {
  let hostPtr = strData(host)
  let hostLen = strSizeOf(host)

  // EVERY scratch below is a MANAGED `[]i64` local (#1668). They used to be raw
  // `rtStrAlloc` addresses held across `readResolvConf`, which loops, polls and
  // parks in `netReadSock`, and across `netResolveHost`, which parks on a DNS
  // round trip. Managed locals are stack-map slots, so the precise walk names
  // them for the whole of both.
  let outBuf = []i64(1)
  let outPtr = u8At(int(ptrOf(outBuf)))

  // A literal address never needs the network — return it verbatim, exactly as
  // `netResolveHost` would, but without touching /etc/resolv.conf.
  if (netParseIpv4(hostPtr, hostLen, outPtr)) {
    return formatQuad(outPtr)
  }

  let confBuf = []i64(scratchWords(resolvConfMax))
  let confPtr = u8At(int(ptrOf(confBuf)))
  let confLen = readResolvConf(confPtr, resolvConfMax)
  if (confLen <= 0) {
    return emptyStr()
  }

  let nsBuf = []i64(1)
  let nsPtr = u8At(int(ptrOf(nsBuf)))
  if (!netFirstNameserver(confPtr, confLen, nsPtr)) {
    return emptyStr()
  }
  if (!netResolveHost(hostPtr, hostLen, nsPtr, outPtr)) {
    return emptyStr()
  }
  return formatQuad(outPtr)
}
