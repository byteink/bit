// Darwin socket provider for the Stage-2 port of runtime/net/ (#1366): every
// call in that file that the kernel sees. See ../net.bit for the half that it
// does not, and for why `sockaddr_in` is HERE rather than there.
//
// Everything goes through libSystem (§11.7) rather than raw traps: Apple
// publishes no stable syscall numbers and reserves the right to renumber them,
// so a C call is the supported path — the same choice runtime/alloc/darwin,
// runtime/rand/darwin, runtime/park/darwin and runtime/sched/darwin all make.
//
// EVERY CONSTANT AND EVERY STRUCT OFFSET BELOW WAS READ OUT OF THE PLATFORM
// STDLIB, NOT FROM MEMORY. A wrong number here is a silently wrong socket option
// or a silently misparsed address, never a compile error. Three of them differ
// from the Linux twin in ways that a reader guessing from Linux would get wrong,
// and each is recorded at its definition: `SOL_SOCKET` is 0xFFFF and not 1,
// `SO_ERROR` is 0x1007 and not 4, and `struct timeval`'s `tv_usec` is 32 bits
// here and 64 on Linux.
//
// EVERY BUFFER CROSSES AS `*u8` PLUS A BYTE COUNT. A Bit slice or array stores
// one 8-BYTE WORD per element (§11.8), so `[]u8` is strided rather than packed
// and cannot describe a wire message or a kernel struct.

import { netParseIpv4, netMaxStalls, netMaxSpins } from "../../net"
import { netDnsId, netBuildQuery, netParseAnswer, netMaxDnsMsg } from "../../net"
import { netDnsTimeoutMs, netDnsRetries } from "../../net"
import { taskAt, schedCurrentTask, taskWorker, wkSched, scPollFd } from "../../sched"
import { schedParkArm, schedParkDisarm, schedPark, pollRead, pollWrite } from "../../sched"
import { pollRegister } from "../../sched/darwin"

// int socket(int, int, int); int bind(int, const struct sockaddr *, socklen_t);
// int listen(int, int); int accept(int, struct sockaddr *, socklen_t *);
// int connect(int, const struct sockaddr *, socklen_t);
// ssize_t read(int, void *, size_t); ssize_t write(int, const void *, size_t);
// ssize_t sendto(int, const void *, size_t, int, const struct sockaddr *, socklen_t);
// ssize_t recvfrom(int, void *, size_t, int, struct sockaddr *, socklen_t *);
// int getsockname(int, struct sockaddr *, socklen_t *);
// int setsockopt(int, int, int, const void *, socklen_t);
// int getsockopt(int, int, int, void *, socklen_t *);
// int fcntl(int, int, ...);  int *__error(void);
//
// Only C-representable types cross the boundary (§11.7), so every struct
// travels as a `*u8` over a region this module lays out by hand.
extern function socket(domain: i32, ty: i32, proto: i32): i32
extern function bind(fd: i32, sa: *u8, salen: i32): i32
extern function listen(fd: i32, backlog: i32): i32
extern function accept(fd: i32, sa: *u8, salen: *u8): i32
extern function connect(fd: i32, sa: *u8, salen: i32): i32
extern function read(fd: i32, buf: *u8, n: i64): i64
extern function write(fd: i32, buf: *u8, n: i64): i64
extern function sendto(fd: i32, buf: *u8, n: i64, flags: i32, sa: *u8, salen: i32): i64
extern function recvfrom(fd: i32, buf: *u8, n: i64, flags: i32, sa: *u8, salen: *u8): i64
extern function getsockname(fd: i32, sa: *u8, salen: *u8): i32
extern function setsockopt(fd: i32, lvl: i32, name: i32, val: *u8, len: i32): i32
extern function getsockopt(fd: i32, lvl: i32, name: i32, val: *u8, len: *u8): i32
// THE ONE VARIADIC C FUNCTION THIS MODULE CALLS, AND THE ONLY ONE IN THE WHOLE
// BIT RUNTIME — `int fcntl(int fd, int cmd, ...)`. Declaring it with a plain
// third parameter is SILENTLY WRONG ON APPLE ARM64, and that mistake is what
// #1462 was: Apple's ARM64 ABI passes every VARIADIC argument on the STACK
// (unlike AAPCS64, which puts the first eight in registers), so a fixed-arity
// declaration leaves the value in `x2` where the callee never looks. `F_SETFL`
// then received whatever the stack happened to hold, RETURNED 0 FOR SUCCESS,
// and `O_NONBLOCK` was never set — so every socket this module produced was
// BLOCKING while every retry loop below was written believing otherwise.
//
// SPEC §11.7 forbids a variadic `extern` outright ("a variadic C function needs
// per-call ABI classification this path does not implement"), so the argument
// has to be placed by hand. It is passed TWICE, and that is what makes this
// correct on both Darwin architectures rather than only the one we test on:
//
//   - `argReg` occupies the third integer register (`x2` / `rdx`). SysV x86-64
//     passes variadic integer arguments in registers, so this is the slot a
//     future x86_64-macOS build's callee reads.
//   - `pad3`..`pad7` consume the remaining argument registers so that
//     `argStack` — the ninth parameter — lands in the FIRST STACK SLOT, which
//     is where Apple ARM64's callee reads its first variadic argument.
//
// Callers pass the same value for both. A C variadic callee ignores arguments
// past the ones it consumes, so the duplicate is inert on whichever platform
// does not use it. `netSetNonBlock` verifies the result rather than trusting
// this reasoning — see there.
extern function fcntl(fd: i32, cmd: i32, argReg: i64, pad3: i64, pad4: i64, pad5: i64, pad6: i64, pad7: i64, argStack: i64): i32

// THE ERRNO ACCESSOR, WHICH A RAW-SYSCALL PLATFORM DOES NOT NEED. A Linux
// syscall returns `-errno` in its result register, so its provider reads the
// reason straight off the return value. libSystem returns -1 and puts the reason
// in thread-local `errno`, reached through this function — `std.c._errno` is
// `__error` on Darwin, which is where this spelling comes from.
extern function __error(): *i32

// THE DESCRIPTOR IS CLOSED THROUGH THE RUNTIME, NOT THROUGH libSystem, AND THAT
// IS A WORKAROUND FOR A COMPILER BUG (#1436) — not a design preference. See
// ../../sched/darwin/poll.bit, which documents it in full: `extern function
// close` builds cleanly and then SIGSEGVs under the SELF-HOSTED compiler only,
// because it emits `_close$NOCANCEL` and silently drops the `_close` import.
//
// `read`, `write`, `accept`, `connect`, `sendto` and `recvfrom` ALL have the
// same `$NOCANCEL` twin, so they are the obvious candidates for the same defect.
// They were probed under both compilers before this file was written and all of
// them import and call correctly; `close` remains the only one affected. That is
// measured, not assumed, and it is the reason the rest of this file uses plain
// externs rather than routing everything through libbitrt.
extern function bit_rt_fs_close(fd: i64): i64

// AF_INET, SOCK_STREAM, SOCK_DGRAM, from the macOS SDK `<sys/socket.h>`.
//
// Darwin has NO `SOCK_NONBLOCK` and NO `SOCK_CLOEXEC` creation flag, which the
// Linux twin does use — so a socket here is created blocking and made
// non-blocking by a second `fcntl` call, leaving a window the Linux side does
// not have. The asymmetry is real rather
// than an oversight in one of the two.
@nosplit function afInet(): int { return 2 }
@nosplit function sockStream(): int { return 1 }
@nosplit function sockDgram(): int { return 2 }

// F_GETFL / F_SETFL and O_NONBLOCK. O_NONBLOCK is bit 2 here (value 4) and bit
// 11 on Linux (value 2048) — the same name, a different bit, and nothing about
// the source spelling reveals it.
@nosplit function fGetFl(): int { return 3 }
@nosplit function fSetFl(): int { return 4 }
@nosplit function oNonBlock(): int { return 4 }

// SOL_SOCKET IS 0xFFFF ON DARWIN, NOT 1. Linux uses 1. Passing Linux's value
// here does not fail to compile and does not fail loudly — `setsockopt` returns
// ENOPROTOOPT and the option is silently not applied, so a listener would simply
// refuse to rebind during TIME_WAIT some minutes later.
@nosplit function solSocket(): int { return 65535 }

// SO_REUSEADDR 0x0004, SO_ERROR 0x1007, SO_RCVTIMEO 0x1006 — from Darwin's
// Darwin `SO`. Only REUSEADDR happens to agree in spirit with Linux's numbering;
// ERROR is 4 on Linux and 4103 here, which is precisely the pair a reader is
// most likely to transcribe wrongly, because Linux's SO_ERROR and Darwin's
// SO_REUSEADDR are both 4.
@nosplit function soReuseAddr(): int { return 4 }
@nosplit function soError(): int { return 4103 }
@nosplit function soRcvTimeo(): int { return 4102 }

// errno values, from Darwin's `<sys/errno.h>`. ALL FIVE DIFFER FROM LINUX except
// EINTR: EAGAIN is 35 here and 11 there, EINPROGRESS 36 vs 115, ECONNABORTED 53
// vs 103, ECONNRESET 54 vs 104.
@nosplit function eAgain(): int { return 35 }
@nosplit function eIntr(): int { return 4 }
@nosplit function eInProgress(): int { return 36 }
@nosplit function eConnAborted(): int { return 53 }
@nosplit function eConnReset(): int { return 54 }
// The two answers a RE-ISSUED `connect` gives about a handshake already under
// way: EALREADY "still running", EISCONN "finished, and it succeeded". See
// `netDialTcp`, which needs them to know when SO_ERROR has become meaningful.
@nosplit function eAlready(): int { return 37 }
@nosplit function eIsConn(): int { return 56 }

// `struct sockaddr_in` ON DARWIN, from `<netinet/in.h>` — AND THIS IS THE STRUCT THAT
// FORCED THE CORE/PROVIDER SPLIT:
//
//     sin_len:    0   (u8)     <- DOES NOT EXIST ON LINUX
//     sin_family: 1   (u8)     <- SIXTEEN BITS AT OFFSET 0 ON LINUX
//     sin_port:   2   (u16, big-endian)
//     sin_addr:   4   (u32, four octets in wire order)
//     sin_zero:   8   (8 bytes)
//
// Total 16 bytes on both systems, which is exactly what makes the difference
// dangerous: a "portable" layout with a 16-bit family at offset 0 is the same
// SIZE here and writes AF_INET into `sin_len`, leaving `sin_family` zero. The
// kernel then reads family AF_UNSPEC and the bind fails — or worse, on a path
// that does not check, it succeeds against the wrong address family.
const saLen: int = 16
const saLenOff: int = 0
const saFamilyOff: int = 1
const saPortOff: int = 2
const saAddrOff: int = 4

// `struct timeval` ON DARWIN: `tv_sec` is 64 bits and `tv_usec` is 32
// (`suseconds_t`), where Linux has 64 and 64. The struct is 16 bytes on both
// because of tail padding, so a 64-bit write to `tv_usec` here would scribble
// over the padding rather than fail — silently, and with the right total size.
const tvSize: int = 16
const tvSecOff: int = 0
const tvUsecOff: int = 8

// Scratch regions for the kernel structs.
//
// MODULE-LEVEL, AND NOT PROTECTED BY A LOCK — unlike the netpoller's drain
// buffer, which is guarded by `schedPollTryEnter`. That is sound only because
// each of these is written and read within a single call with no park in
// between, and this runtime's green threads on one worker are not preemptive.
// A multi-worker consumer calling these concurrently would need them per-worker;
// the same note is on the Linux twin, deliberately, so the two stay in step.
let saBuf: [2]i64
let saBuf2: [2]i64
let optBuf: [1]i64
let lenBuf: [1]i64
let ipBuf: [1]i64
let tvBuf: [2]i64
// TWO messages, not one: the query and the reply are both live across the same
// `recvfrom`, so the region is 2 * netMaxDnsMsg = 1024 bytes = 128 words.
let dnsBuf: [128]i64

@nosplit function bytesAt(a: int): *u8 {
  let z: *u8 = nil
  return z + a
}

@nosplit function saBytes(): *u8 { return bytesAt(int(ptrOf(saBuf))) }
@nosplit function saBytes2(): *u8 { return bytesAt(int(ptrOf(saBuf2))) }
@nosplit function optBytes(): *u8 { return bytesAt(int(ptrOf(optBuf))) }
@nosplit function lenBytes(): *u8 { return bytesAt(int(ptrOf(lenBuf))) }
@nosplit function ipBytes(): *u8 { return bytesAt(int(ptrOf(ipBuf))) }
@nosplit function tvBytes(): *u8 { return bytesAt(int(ptrOf(tvBuf))) }
@nosplit function dnsBytes(): *u8 { return bytesAt(int(ptrOf(dnsBuf))) }

@nosplit function putU8(base: *u8, off: int, v: int) {
  let p = base + off
  *p = u8(v % 256)
}

@nosplit function getU8(base: *u8, off: int): int {
  let p = base + off
  return int(*p)
}

// Big-endian, because `sin_port` is in network byte order. Written byte-wise
// rather than through a wider pointer for the reason the whole runtime does it:
// a Bit array is word-strided, so a kernel struct is only ever a byte region.
@nosplit function putU16Be(base: *u8, off: int, v: int) {
  putU8(base, off, v / 256)
  putU8(base, off + 1, v)
}

@nosplit function getU16Be(base: *u8, off: int): int {
  return getU8(base, off) * 256 + getU8(base, off + 1)
}

@nosplit function putU32Le(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 4) {
    putU8(base, off + k, v / (1 << (8 * k)))
    k = k + 1
  }
}

@nosplit function getU32Le(base: *u8, off: int): int {
  let v = 0
  let k = 3
  while (k >= 0) {
    v = v * 256 + getU8(base, off + k)
    k = k - 1
  }
  return v
}

@nosplit function getU64Le(base: *u8, off: int): int {
  let v = 0
  let k = 7
  while (k >= 0) {
    v = v * 256 + getU8(base, off + k)
    k = k - 1
  }
  return v
}

@nosplit function putU64Le(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 8) {
    putU8(base, off + k, v / (1 << (8 * k)))
    k = k + 1
  }
}

// The errno of the call that just failed. Positive, matching the Linux twin's
// convention, so the two providers' retry logic reads identically.
@nosplit function lastErr(): int {
  let p = __error()
  return int(*p)
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

// The kernel's `sockaddr_in` size — the `socklen_t` every call here passes.
export @symbol("bit_rt_port_net_sock_addr_len") @nosplit function netSockAddrLen(): int {
  return saLen
}

// Lay out a `sockaddr_in` for `ip[0..4]` and `port` in the region at `sa`, which
// must hold `netSockAddrLen()` bytes. `sin_zero` is cleared: the kernel does not
// read it, but a stale eight bytes from a previous call would make an address
// comparison in a caller answer wrongly.
export @symbol("bit_rt_port_net_fill_sock_addr") @nosplit function netFillSockAddr(sa: *u8, ip: *u8, port: int) {
  let k = 0
  while (k < saLen) {
    putU8(sa, k, 0)
    k = k + 1
  }
  putU8(sa, saLenOff, saLen)
  putU8(sa, saFamilyOff, afInet())
  putU16Be(sa, saPortOff, port)
  let j = 0
  while (j < 4) {
    putU8(sa, saAddrOff + j, getU8(ip, j))
    j = j + 1
  }
}

// The port of a `sockaddr_in`, host byte order.
export @symbol("bit_rt_port_net_sock_addr_port") @nosplit function netSockAddrPort(sa: *u8): int {
  return getU16Be(sa, saPortOff)
}

// The address family of a `sockaddr_in`, read at THIS platform's offset.
//
// EXISTS TO MAKE THE ONE REAL LAYOUT DIFFERENCE OBSERVABLE, and it was added
// because mutation proved it was not. Darwin puts an 8-bit `sin_len` at offset
// 0 and the family at 1; Linux puts a 16-bit family at 0. Moving
// `saFamilyOff` to the Linux value here SURVIVED the whole socket suite: the
// Darwin kernel does not enforce `sin_len` on these calls, and every readback
// the tests performed (`port`, `octets`) lives at an offset the mutation does
// not touch. So the difference this file's header calls the reason for the
// core/provider split was, in fact, guarded by nothing.
//
// Pointed at a sockaddr the KERNEL filled in (a `recvfrom` peer), this reads
// AF_INET only if our declared offset agrees with the kernel's layout — under
// the Linux-layout mutant it reads `sin_len` (16) instead and the test fails.
export @symbol("bit_rt_port_net_sock_addr_family") @nosplit function netSockAddrFamily(sa: *u8): int {
  return getU8(sa, saFamilyOff)
}

// The four address octets of a `sockaddr_in`, in wire order, written to `out`.
export @symbol("bit_rt_port_net_sock_addr_octets") @nosplit function netSockAddrOctets(sa: *u8, out: *u8) {
  let j = 0
  while (j < 4) {
    putU8(out, j, getU8(sa, saAddrOff + j))
    j = j + 1
  }
}

// ---------------------------------------------------------------------------
// Raw calls
// ---------------------------------------------------------------------------

// A non-blocking socket. Returns a negative value on failure.
export @symbol("bit_rt_port_net_sys_socket") @nosplit function netSysSocket(dgram: bool): int {
  let ty = sockStream()
  if (dgram) {
    ty = sockDgram()
  }
  let fd = int(socket(i32(afInet()), i32(ty), i32(0)))
  if (fd < 0) {
    return 0 - 1
  }
  // Darwin has no creation-time NONBLOCK, so there IS a window here in which
  // the socket is blocking. Nothing else can reach the fd yet, so the window is
  // not observable — but it is why the Linux twin's one-syscall form is not
  // merely a micro-optimisation.
  if (!netSetNonBlock(fd)) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// True when `fd`'s descriptor flags carry `O_NONBLOCK`. Split out because it is
// needed twice: once to decide whether to set the bit, and once to CHECK that
// setting it worked.
export @symbol("bit_rt_port_net_is_non_block") @nosplit function netIsNonBlock(fd: int): bool {
  let flags = int(fcntl(i32(fd), i32(fGetFl()), 0, 0, 0, 0, 0, 0, 0))
  if (flags < 0) {
    return false
  }
  return flags / oNonBlock() % 2 != 0
}

export @symbol("bit_rt_port_net_set_non_block") @nosplit function netSetNonBlock(fd: int): bool {
  let flags = int(fcntl(i32(fd), i32(fGetFl()), 0, 0, 0, 0, 0, 0, 0))
  if (flags < 0) {
    return false
  }
  // Bit-or spelled as an add guarded by a test: the flag is either already set,
  // in which case adding it again would corrupt an unrelated bit, or it is not.
  let want = flags
  if (flags / oNonBlock() % 2 == 0) {
    want = flags + oNonBlock()
  }
  if (int(fcntl(i32(fd), i32(fSetFl()), i64(want), 0, 0, 0, 0, 0, i64(want))) < 0) {
    return false
  }
  // THE RETURN VALUE OF `fcntl` IS NOT EVIDENCE THAT THE FLAG WAS SET, and this
  // readback is the whole guard against #1462 recurring. A misplaced variadic
  // argument makes `F_SETFL` apply some other value and still report success,
  // which is precisely how every socket here came to be blocking while the code
  // above read as correct. Reading the flags back is the only check that cannot
  // be fooled by getting the ABI wrong, because it observes the KERNEL's state
  // rather than our own call. Cost is one syscall per socket, paid once at
  // creation; the failure it converts from silent to loud costs hours.
  return netIsNonBlock(fd)
}

export @symbol("bit_rt_port_net_close") @nosplit function netClose(fd: int) {
  let rc = int(bit_rt_fs_close(i64(fd)))
}

export @symbol("bit_rt_port_net_sys_bind") @nosplit function netSysBind(fd: int, sa: *u8): bool {
  return int(bind(i32(fd), sa, i32(saLen))) >= 0
}

export @symbol("bit_rt_port_net_sys_listen") @nosplit function netSysListen(fd: int, backlog: int): bool {
  return int(listen(i32(fd), i32(backlog))) >= 0
}

// SO_REUSEADDR so a restart is not refused while the previous socket's
// connections sit in TIME_WAIT. Deliberately NOT SO_REUSEPORT, which would let a
// second process silently steal traffic from this one.
export @symbol("bit_rt_port_net_set_reuse_addr") @nosplit function netSetReuseAddr(fd: int): bool {
  putU32Le(optBytes(), 0, 1)
  return int(setsockopt(i32(fd), i32(solSocket()), i32(soReuseAddr()),
                        optBytes(), i32(4))) >= 0
}

// The pending error on a socket, as SO_ERROR. Zero means the operation
// succeeded; a negative return means the query itself failed.
export @symbol("bit_rt_port_net_socket_error") @nosplit function netSocketError(fd: int): int {
  putU32Le(optBytes(), 0, 0)
  putU32Le(lenBytes(), 0, 4)
  if (int(getsockopt(i32(fd), i32(solSocket()), i32(soError()),
                     optBytes(), lenBytes())) < 0) {
    return 0 - 1
  }
  return getU32Le(optBytes(), 0)
}

// ---------------------------------------------------------------------------
// Parking on readiness
// ---------------------------------------------------------------------------

// Park the calling green thread until `fd` is ready for `interest`. Returns true
// when the caller was parked and has since been woken, i.e. the fd is ready.
//
// FALSE MEANS "THERE WAS NOBODY TO PARK ON", NOT "THE FD IS READY". A caller off
// a green stack — a driver program, or any code the ported scheduler is not
// running — has no task to suspend, so this reports that and the retry loops
// below spin instead. That is why they carry TWO bounds: `netMaxStalls` for a
// parked wait, and `netMaxSpins` for the unscheduled one,
// which exists only because this runtime has an unscheduled caller.
//
// THE ARM/REGISTER/PARK ORDER IS THE PROTOCOL, NOT A PREFERENCE. `runtime/sched/`
// registers from a `ParkFn` on the worker's side of the switch; that is a call
// through a function value and `@nosplit` rejects it, so this must register
// BEFORE parking and close the resulting window with `schedParkArm`. See
// ../../sched.bit's "arming a park" section for the state machine and
// tests/stress/netpark for the property.
export @symbol("bit_rt_port_net_await_ready") function netAwaitReady(fd: int, interest: int): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return false
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return false
  }
  if (!schedParkArm()) {
    return false
  }
  if (!pollRegister(pollFd, fd, interest, taskAddr)) {
    // Nothing will ever wake this task, so it must not park. `schedParkDisarm`
    // also consumes a wake that a drain handed over while we were registering —
    // its answer is ignored here because either way the caller keeps running.
    let owed = schedParkDisarm()
    return false
  }
  schedPark()
  return true
}
