// Darwin socket provider for the Stage-2 port of runtime/net/ (#1366): every
// call in that file that the kernel sees. See ../net.bit for the half that it
// does not, and for why `sockaddr_in` is HERE rather than there.
//
// Everything goes through libSystem (§11.7) rather than raw traps: Apple
// publishes no stable syscall numbers and reserves the right to renumber them,
// so a C call is the supported path — the same choice runtime/alloc/darwin,
// runtime/rand/darwin, runtime/park/darwin and runtime/sched/darwin all make.
//
// EVERY CONSTANT AND EVERY C STRUCTURE OFFSET BELOW WAS READ OUT OF THE PLATFORM
// STDLIB, NOT FROM MEMORY. A wrong number here is a silently wrong socket option
// or a silently misparsed address, never a compile error. Three of them differ
// from the Linux twin in ways that a reader guessing from Linux would get wrong,
// and each is recorded at its definition: `SOL_SOCKET` is 0xFFFF and not 1,
// `SO_ERROR` is 0x1007 and not 4, and `timeval`'s (POSIX) `tv_usec` is 32 bits
// here and 64 on Linux.
//
// EVERY BUFFER CROSSES AS `*u8` PLUS A BYTE COUNT. A Bit slice or array stores
// one 8-BYTE WORD per element (§11.8), so `[]u8` is strided rather than packed
// and cannot describe a wire message or a kernel structure.

import { netParseIpv4, netMaxStalls, netMaxSpins } from "../../net"
import { netDnsId, netBuildQuery, netParseAnswer, netMaxDnsMsg } from "../../net"
import { netDnsTimeoutMs, netDnsRetries } from "../../net"
import { taskAt, schedCurrentTask, taskWorker, wkSched, scPollFd } from "../../sched"
import { schedParkArm, schedParkDisarm, schedPark, pollRead, pollWrite } from "../../sched"
import { schedPollUnpark, schedPollPendingInc, schedPollPendingDec } from "../../sched"
import { pollDescRegister, pollDescRegisterWrite, pollDescUnregister } from "../../sched/darwin"
// pollDesc (#5864/#5865): the register-once model's per-fd table --
// `netPollDescOpen` below (accept/connect/listen) and `netClose` are this
// file's two lifecycle ends, `netAwaitReady` and `../tcp.bit`'s deadline race
// are the two waiters.
import {
  pdOpen, pdWait, pdClose, pdDirRead, pdDirWrite,
  pdClaimed, pdAlreadyReady, pdEmpty,
} from "../../sched"
// Per-fd in-flight reference counting (#5886): the Go-style `fdMutex` that
// defers a real `close(2)` until the last acquired op releases, so a task
// woken by `netClose` never retries a syscall on an fd number the kernel has
// already handed to a new socket. `netFdAcquire`/`netFdRelease` below are the
// thin platform wrappers -- the CAS protocol itself is OS-neutral and lives
// in `../../sched/polldesc.bit`.
import {
  pdFdAcquire, pdFdRelease, pdFdMarkClosing, pdFdClosing,
  pdFdAcquired, pdFdRefusedLast,
  pdFdCloseNow, pdFdCloseDeferred,
} from "../../sched"
// `schedCurrentWorker`, `wkId` and `schedMaxWorkers` are already imported by
// ../netabi.bit (same module — an import is per-module, not per-file).
// Byte/wire-format marshalling and the sockaddr fields that read the same on
// both platforms are core now (../sock.bit, #2552) — only `saLenOff`/
// `saFamilyOff` (this file's own consts above) genuinely differ per OS.
// Module-scoped, so this one import line also covers ../tcp.bit's and
// ../udp.bit's uses of `ipBytes`/`saBytes2`/`saLen`/etc.
import {
  afInet, sockStream, sockDgram, fGetFl, fSetFl, eIntr, saLen, saPortOff,
  saAddrOff, saBytes, saBytes2, optBytes,
  lenBytes, ipBytes, tvBytes, dnsBytes, putU8, getU8, putU16Be,
  putU32Le, getU32Le, getU64Le, putU64Le,
  netSockAddrIpv4, netSockAddrPort, sockScratchSlot,
} from "../../net"

// int socket(int, int, int); int bind(int, const sockaddr *, socklen_t);
// int listen(int, int); int accept(int, sockaddr *, socklen_t *);
// int connect(int, const sockaddr *, socklen_t);
// ssize_t read(int, void *, size_t); ssize_t write(int, const void *, size_t);
// ssize_t sendto(int, const void *, size_t, int, const sockaddr *, socklen_t);
// ssize_t recvfrom(int, void *, size_t, int, sockaddr *, socklen_t *);
// int getsockname(int, sockaddr *, socklen_t *);
// int getpeername(int, sockaddr *, socklen_t *);
// int setsockopt(int, int, int, const void *, socklen_t);
// int getsockopt(int, int, int, void *, socklen_t *);
// int fcntl(int, int, ...);  int *__error(void);
//
// Only C-representable types cross the boundary (§11.7), so every class
// travels as a `*u8` over a region this module lays out by hand.
extern fn socket(domain: i32, ty: i32, proto: i32): i32
extern fn bind(fd: i32, sa: *u8, salen: i32): i32
extern fn listen(fd: i32, backlog: i32): i32
extern fn accept(fd: i32, sa: *u8, salen: *u8): i32
extern fn connect(fd: i32, sa: *u8, salen: i32): i32
extern fn read(fd: i32, buf: *u8, n: i64): i64
extern fn write(fd: i32, buf: *u8, n: i64): i64
extern fn sendto(fd: i32, buf: *u8, n: i64, flags: i32, sa: *u8, salen: i32): i64
extern fn recvfrom(fd: i32, buf: *u8, n: i64, flags: i32, sa: *u8, salen: *u8): i64
extern fn getsockname(fd: i32, sa: *u8, salen: *u8): i32
// THE PEER SIDE OF THE SAME CALL, and the only way anything above this layer
// can name the client on an accepted socket: `netAcceptTcp` passes NULL for
// `accept`'s `sockaddr` out-parameter, so the address the kernel already had
// is discarded there. Asked per fd instead, which needs no change to that
// accept loop and answers for a dialed socket too (#4525).
extern fn getpeername(fd: i32, sa: *u8, salen: *u8): i32
extern fn setsockopt(fd: i32, lvl: i32, name: i32, val: *u8, len: i32): i32
extern fn getsockopt(fd: i32, lvl: i32, name: i32, val: *u8, len: *u8): i32
// int shutdown(int, int); <sys/socket.h>. `how` is SHUT_RD(0)/SHUT_WR(1)/
// SHUT_RDWR(2) — identical values on Darwin and Linux (`net/tcp.bit`'s
// `netShutRdwr` names the one this runtime uses).
extern fn shutdown(fd: i32, how: i32): i32
// THE ONE VARIADIC C FUNCTION THIS MODULE CALLS, AND THE ONLY ONE IN THE WHOLE
// BIT RUNTIME — `int fcntl(int fd, int cmd, ...)`. Declaring it with a plain
// third parameter is SILENTLY WRONG ON APPLE ARM64, and that mistake is what
// #1462 was: Apple's ARM64 ABI passes every VARIADIC argument on the STACK
// (unlike AAPCS64, which puts the first eight in registers), so a fixed-arity
// declaration leaves the value in `x2` where the callee never looks. `F_SETFL`
// then received whatever the stack happened to hold, RETURNED 0 FOR SUCCESS,
// and `O_NONBLOCK` was never set — so every socket this module produced was
// BLOCKING while every retry loop below was written believing otherwise.
//
// SPEC §11.7 forbids a variadic `extern` outright ("a variadic C function needs
// per-call ABI classification this path does not implement"), so the argument
// has to be placed by hand. It is passed TWICE, and that is what makes this
// correct on both Darwin architectures rather than only the one we test on:
//
//   - `argReg` occupies the third integer register (`x2` / `rdx`). SysV x86-64
//     passes variadic integer arguments in registers, so this is the slot a
//     future x86_64-macOS build's callee reads.
//   - `pad3`..`pad7` consume the remaining argument registers so that
//     `argStack` — the ninth parameter — lands in the FIRST STACK SLOT, which
//     is where Apple ARM64's callee reads its first variadic argument.
//
// Callers pass the same value for both. A C variadic callee ignores arguments
// past the ones it consumes, so the duplicate is inert on whichever platform
// does not use it. `netSetNonBlock` verifies the result rather than trusting
// this reasoning — see there.
extern fn fcntl(
  fd: i32,
  cmd: i32,
  argReg: i64,
  pad3: i64,
  pad4: i64,
  pad5: i64,
  pad6: i64,
  pad7: i64,
  argStack: i64,
): i32

// THE ERRNO ACCESSOR, WHICH A RAW-SYSCALL PLATFORM DOES NOT NEED. A Linux
// syscall returns `-errno` in its result register, so its provider reads the
// reason straight off the return value. libSystem returns -1 and puts the reason
// in thread-local `errno`, reached through this function — `std.c._errno` is
// `__error` on Darwin, which is where this spelling comes from.
extern fn __error(): *i32

// THE DESCRIPTOR IS CLOSED THROUGH THE RUNTIME, NOT THROUGH libSystem, AND THAT
// IS A WORKAROUND FOR A COMPILER BUG (#1436) — not a design preference. See
// ../../sched/darwin/poll.bit, which documents it in full: `extern function
// close` builds cleanly and then SIGSEGVs under the SELF-HOSTED compiler only,
// because it emits `_close$NOCANCEL` and silently drops the `_close` import.
//
// `read`, `write`, `accept`, `connect`, `sendto` and `recvfrom` ALL have the
// same `$NOCANCEL` twin, so they are the obvious candidates for the same defect.
// They were probed under both compilers before this file was written and all of
// them import and call correctly; `close` remains the only one affected. That is
// measured, not assumed, and it is the reason the rest of this file uses plain
// externs rather than routing everything through libbitrt.
extern fn bit_rt_fs_close(fd: i64): i64

// AF_INET, SOCK_STREAM, SOCK_DGRAM, F_GETFL/F_SETFL and EINTR are core now
// (../sock.bit, #2552) — POSIX-standard values, identical on both platforms.
//
// Darwin has NO `SOCK_NONBLOCK` and NO `SOCK_CLOEXEC` creation flag, which the
// Linux twin does use — so a socket here is created blocking and made
// non-blocking by a second `fcntl` call, leaving a window the Linux side does
// not have. The asymmetry is real rather than an oversight in one of the two.

// O_NONBLOCK. Bit 2 here (value 4) and bit 11 on Linux (value 2048) — the
// same name, a different bit, and nothing about the source spelling reveals
// it.
@nosplit fn oNonBlock(): int { return 4 }

// SOL_SOCKET IS 0xFFFF ON DARWIN, NOT 1. Linux uses 1. Passing Linux's value
// here does not fail to compile and does not fail loudly — `setsockopt` returns
// ENOPROTOOPT and the option is silently not applied, so a listener would simply
// refuse to rebind during TIME_WAIT some minutes later.
@nosplit fn solSocket(): int { return 65535 }

// SO_REUSEADDR 0x0004, SO_ERROR 0x1007, SO_RCVTIMEO 0x1006 — from Darwin's
// Darwin `SO`. Only REUSEADDR happens to agree in spirit with Linux's numbering;
// ERROR is 4 on Linux and 4103 here, which is precisely the pair a reader is
// most likely to transcribe wrongly, because Linux's SO_ERROR and Darwin's
// SO_REUSEADDR are both 4.
@nosplit fn soReuseAddr(): int { return 4 }
@nosplit fn soError(): int { return 4103 }
@nosplit fn soRcvTimeo(): int { return 4102 }

// errno values, from Darwin's `<sys/errno.h>`. ALL FIVE DIFFER FROM LINUX.
// (EINTR, the one POSIX errno that agrees with Linux, is core now —
// ../sock.bit, #2552.) EAGAIN is 35 here and 11 there, EINPROGRESS 36 vs 115,
// ECONNABORTED 53 vs 103, ECONNRESET 54 vs 104.
@nosplit fn eAgain(): int { return 35 }
@nosplit fn eInProgress(): int { return 36 }
@nosplit fn eConnAborted(): int { return 53 }
@nosplit fn eConnReset(): int { return 54 }
// The two answers a RE-ISSUED `connect` gives about a handshake already under
// way: EALREADY "still running", EISCONN "finished, and it succeeded". See
// `netDialTcp`, which needs them to know when SO_ERROR has become meaningful.
@nosplit fn eAlready(): int { return 37 }
@nosplit fn eIsConn(): int { return 56 }

// `sockaddr_in` (POSIX) ON DARWIN, from `<netinet/in.h>` — AND THIS IS THE STRUCTURE THAT
// FORCED THE CORE/PROVIDER SPLIT:
//
//     sin_len:    0   (u8)     <- DOES NOT EXIST ON LINUX
//     sin_family: 1   (u8)     <- SIXTEEN BITS AT OFFSET 0 ON LINUX
//     sin_port:   2   (u16, big-endian)  <- core now, ../sock.bit (#2552)
//     sin_addr:   4   (u32, four octets in wire order)  <- core now, ../sock.bit
//     sin_zero:   8   (8 bytes)
//
// Total 16 bytes on both systems (`netSockAddrLen`, also core now), which is
// exactly what makes the difference dangerous: a "portable" layout with a
// 16-bit family at offset 0 is the same SIZE here and writes AF_INET into
// `sin_len`, leaving `sin_family` zero. `saLenOff`/`saFamilyOff` are the two
// fields of this struct that stay provider-local — Darwin has no `sin_len` on
// Linux at all, and the family byte itself sits at a different offset (1 vs
// 0), so a shared core copy would read/write the wrong byte on one platform.
const saLenOff: int = 0
const saFamilyOff: int = 1

// `timeval` (POSIX) ON DARWIN: `tv_sec` is 64 bits and `tv_usec` is 32
// (`suseconds_t`), where Linux has 64 and 64. The structure is 16 bytes on both
// because of tail padding, so a 64-bit write to `tv_usec` here would scribble
// over the padding rather than fail — silently, and with the right total size.
const tvSize: int = 16
const tvSecOff: int = 0
const tvUsecOff: int = 8

// The errno of the call that just failed. Positive, matching the Linux twin's
// convention, so the two providers' retry logic reads identically.
@nosplit fn lastErr(): int {
  let p = __error()
  return int(*p)
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

// Lay out a `sockaddr_in` for `ip[0..4]` and `port` in the region at `sa`, which
// must hold `netSockAddrLen()` bytes. `sin_zero` is cleared: the kernel does not
// read it, but a stale eight bytes from a previous call would make an address
// comparison in a caller answer wrongly.
export @symbol("bit_rt_port_net_fill_sock_addr") @nosplit fn netFillSockAddr(
  sa: *u8,
  ip: *u8,
  port: int,
) {
  let k = 0
  while (k < saLen) {
    putU8(sa, k, 0)
    k = k + 1
  }
  putU8(sa, saLenOff, saLen)
  putU8(sa, saFamilyOff, afInet())
  putU16Be(sa, saPortOff, port)
  let j = 0
  while (j < 4) {
    putU8(sa, saAddrOff + j, getU8(ip, j))
    j = j + 1
  }
}

// The address family of a `sockaddr_in`, read at THIS platform's offset.
//
// EXISTS TO MAKE THE ONE REAL LAYOUT DIFFERENCE OBSERVABLE, and it was added
// because mutation proved it was not. Darwin puts an 8-bit `sin_len` at offset
// 0 and the family at 1; Linux puts a 16-bit family at 0. Moving
// `saFamilyOff` to the Linux value here SURVIVED the whole socket suite: the
// Darwin kernel does not enforce `sin_len` on these calls, and every readback
// the tests performed (`port`, `octets`) lives at an offset the mutation does
// not touch. So the difference this file's header calls the reason for the
// core/provider split was, in fact, guarded by nothing.
//
// Pointed at a sockaddr the KERNEL filled in (a `recvfrom` peer), this reads
// AF_INET only if our declared offset agrees with the kernel's layout — under
// the Linux-layout mutant it reads `sin_len` (16) instead and the test fails.
export @symbol("bit_rt_port_net_sock_addr_family") @nosplit fn netSockAddrFamily(sa: *u8): int {
  return getU8(sa, saFamilyOff)
}

// `bit_rt_port_net_peer_ip`: the connected peer's IPv4 address for `fd`, packed
// first octet in the high byte (127.0.0.1 -> 0x7F000001), or -1. Same shape as
// `netSockLocalPort` (./tcp.bit) one layer up, and the same scratch: the
// caller's own worker slot of `saBytes`, refilled by this call.
//
// -1 IS EVERY "THERE IS NO PEER": an unconnected or listening socket
// (ENOTCONN), a closed one (EBADF) — and, deliberately, a peer that is not
// AF_INET. The family is CHECKED rather than assumed, because the four bytes at
// `saAddrOff` mean something else in every other family: `getpeername` truncates
// a `sockaddr_in6` into this 16-byte buffer and reports the full length, so
// reading it as IPv4 would hand back four bytes out of the middle of a v6
// address with nothing downstream able to tell. Every socket THIS runtime
// creates is AF_INET; `fd` is the caller's and need not be.
export @symbol("bit_rt_port_net_peer_ip") @nosplit fn netSockPeerIp(fd: int): int {
  putU32Le(lenBytes(), 0, saLen)
  if (int(getpeername(i32(fd), saBytes(), lenBytes())) < 0) {
    return 0 - 1
  }
  if (netSockAddrFamily(saBytes()) != afInet()) {
    return 0 - 1
  }
  return netSockAddrIpv4(saBytes())
}

// ---------------------------------------------------------------------------
// Raw calls
// ---------------------------------------------------------------------------

// A non-blocking socket. Returns a negative value on failure.
export @symbol("bit_rt_port_net_sys_socket") @nosplit fn netSysSocket(dgram: bool): int {
  let ty = sockStream()
  if (dgram) {
    ty = sockDgram()
  }
  let fd = int(socket(i32(afInet()), i32(ty), i32(0)))
  if (fd < 0) {
    return 0 - 1
  }
  // Darwin has no creation-time NONBLOCK, so there IS a window here in which
  // the socket is blocking. Nothing else can reach the fd yet, so the window is
  // not observable — but it is why the Linux twin's one-syscall form is not
  // merely a micro-optimisation.
  if (!netSetNonBlock(fd)) {
    netClose(fd)
    return 0 - 1
  }
  netPollDescOpen(fd)
  return fd
}

// True when `fd`'s descriptor flags carry `O_NONBLOCK`. Split out because it is
// needed twice: once to decide whether to set the bit, and once to CHECK that
// setting it worked.
export @symbol("bit_rt_port_net_is_non_block") @nosplit fn netIsNonBlock(fd: int): bool {
  let flags = int(fcntl(i32(fd), i32(fGetFl()), 0, 0, 0, 0, 0, 0, 0))
  if (flags < 0) {
    return false
  }
  return flags / oNonBlock() % 2 != 0
}

export @symbol("bit_rt_port_net_set_non_block") @nosplit fn netSetNonBlock(fd: int): bool {
  let flags = int(fcntl(i32(fd), i32(fGetFl()), 0, 0, 0, 0, 0, 0, 0))
  if (flags < 0) {
    return false
  }
  // Bit-or spelled as an add guarded by a test: the flag is either already set,
  // in which case adding it again would corrupt an unrelated bit, or it is not.
  let want = flags
  if (flags / oNonBlock() % 2 == 0) {
    want = flags + oNonBlock()
  }
  if (int(fcntl(i32(fd), i32(fSetFl()), i64(want), 0, 0, 0, 0, 0, i64(want))) < 0) {
    return false
  }
  // THE RETURN VALUE OF `fcntl` IS NOT EVIDENCE THAT THE FLAG WAS SET, and this
  // readback is the whole guard against #1462 recurring. A misplaced variadic
  // argument makes `F_SETFL` apply some other value and still report success,
  // which is precisely how every socket here came to be blocking while the code
  // above read as correct. Reading the flags back is the only check that cannot
  // be fooled by getting the ABI wrong, because it observes the KERNEL's state
  // rather than our own call. Cost is one syscall per socket, paid once at
  // creation; the failure it converts from silent to loud costs hours.
  return netIsNonBlock(fd)
}

// This connection's OWN generation, cached at `netPollDescOpen` time and
// read (never re-fetched live) by every later wait on the same fd — see
// that function's header for why a live `pdGen(fd)` read at wait time is
// unsafe. 65536 is `pdCapacity` (`../../sched/polldesc.bit`) written as a
// literal: a fixed-array length must be one (E0021), matching that file's
// own `pdGenTable` for the identical reason. 65536 * 8 = 512KiB of `.bss`,
// paid once at load, never resized.
let netFdGen: [65536]i64

@nosplit fn netFdGenAddr(fd: int): *i64 {
  return ptrOf(netFdGen) + fd
}

// Whether `fd`'s WRITE filter has been armed with the kernel yet (#5865) — 0
// (the `.bss` zero value, and what `netPollDescOpen` resets it to for a
// reused fd number) until the first write on this connection actually
// blocks. See `pollDescRegisterWrite`'s header (`../../sched/darwin/poll.bit`)
// for why write is lazy where read is not. Plain load/store, not atomic: two
// writers racing to arm the same fd is unusual but not forbidden, and
// `EV_ADD` re-arming an already-armed filter is idempotent (that file's own
// `pollRegister` header), so the only cost of losing that race is one
// redundant `kevent` call, never a wrong final state.
let netFdWriteArmed: [65536]i64

@nosplit fn netFdWriteArmedAddr(fd: int): *i64 {
  return ptrOf(netFdWriteArmed) + fd
}

// Register `fd`'s READ filter with the kernel poller ONCE, for its whole
// life (#5865) — called right after the runtime makes a socket non-blocking
// (accept, connect, listen; `netAcceptTcp`/`netSysSocket` are the two call
// sites). Write is armed lazily instead, by `netAwaitReady` the first time a
// write actually blocks (`pollDescRegisterWrite`'s own header,
// `../../sched/darwin/poll.bit`, has the measured reason). A no-op when
// there is no current task or no poller bound: an unscheduled caller's
// retry loops never park (`netAwaitReady`'s own `false` path), so nothing
// needs a kernel registration to wake them.
//
// CACHES `gen` INTO `netFdGen`, AND THAT IS LOAD-BEARING, NOT A
// CONVENIENCE. A wait that instead re-read `pdGen(fd)` live raced a
// concurrent `netClose` on the SAME fd: `pdClose` bumps the generation
// before it sweeps, so a wait whose `pdGen(fd)` read landed just after that
// bump would claim the slot under the NEW generation with `pdWait` — a
// legal CAS, since nothing else is contending at that instant — and then
// park forever (or until its own long deadline) waiting for a kernel event
// that will never come, because the fd this generation belongs to is
// already closed. Caught empirically by
// `_tests_/stress/netclosewhileparkeddarwin` at `BIT_WORKERS=8`: ~1-2 of 40
// connections rode out the full deadline instead of waking on close, before
// this cache replaced the live `pdGen(fd)` read in `netAwaitReady`/
// `netAwaitReadyOrDeadline`. Reading the generation `pdOpen` mints HERE,
// once, and never again, removes the window: a wait racing a close always
// uses the generation that connection's `pdOpen` actually claimed, so
// `pdWait`'s CAS fails with `pdStaleGen` the instant `pdClose` has run,
// exactly the fast, correct outcome invariant 3 promises.
@nosplit fn netPollDescOpen(fd: int) {
  // The generation and the ref word are reset for EVERY new socket, polled or
  // not (#5886): `netFdAcquire` checks them on every op, so a socket opened
  // off a green stack must not inherit a previous owner's closed state.
  let gen = pdOpen(fd)
  *netFdGenAddr(fd) = gen
  *netFdWriteArmedAddr(fd) = 0
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return
  }
  let _ = pollDescRegister(pollFd, fd, gen)
}

// Retract `fd`'s kernel registration and wake anything still parked on it
// BEFORE `close(fd)` (#5865) — a closed-and-reused fd number must never
// deliver a stale knote or a stale wake into a new connection's slots.
// `netShutdownSock`'s own header is the reason `netClose` is where this has
// to happen rather than in `pdClose`'s caller further up: this IS the one
// place the fd number is actually released back to the kernel.
// Per-worker scratch for `pdClose`'s two out-parameters (#5865) — same shape
// as `../sock.bit`'s `saBuf`/`sockScratchSlot()`: this is `@nosplit` code, so
// a heap-allocated `[]i64(2)` is not available, and a shared buffer would let
// two workers closing different fds concurrently stomp each other's result.
let netCloseOutBuf: [66]i64

@nosplit fn netCloseOutR(): *i64 {
  return ptrOf(netCloseOutBuf) + sockScratchSlot() * 2
}

@nosplit fn netCloseOutW(): *i64 {
  return netCloseOutR() + 1
}

// #5886: `close(2)` itself is deferred, not just the wake. `pdFdMarkClosing`
// decides whether ANY op still holds a ref on `fd` -- if one does, that op's
// own `netFdRelease` (below) runs the real close when it drops the last ref,
// and this call only wakes it so it stops retrying rather than actually
// releasing the fd number out from under it. A second `netClose` on an
// already-closing fd is `pdFdCloseAlready`: idempotent, matching `Conn.close`/
// `Listener.close`'s own idempotence one layer up.
export @symbol("bit_rt_port_net_close") @nosplit fn netClose(fd: int) {
  let decision = pdFdMarkClosing(fd)
  if (decision != pdFdCloseNow && decision != pdFdCloseDeferred) {
    return
  }
  let taskAddr = schedCurrentTask()
  if (taskAddr != 0) {
    let t = taskAt(taskAddr)
    let wAddr = *(t + taskWorker)
    if (wAddr != 0) {
      let s = taskAt(*(taskAt(wAddr) + wkSched))
      let pollFd = *(s + scPollFd)
      if (pollFd != 0) {
        let _ = pollDescUnregister(pollFd, fd)
        let outR = netCloseOutR()
        let outW = netCloseOutW()
        let _ = pdClose(fd, outR, outW)
        if (*outR != pdEmpty) {
          schedPollPendingDec()
          let _ = schedPollUnpark(s, *outR)
        }
        if (*outW != pdEmpty) {
          schedPollPendingDec()
          let _ = schedPollUnpark(s, *outW)
        }
      }
    }
  }
  if (decision == pdFdCloseNow) {
    let _ = int(bit_rt_fs_close(i64(fd)))
  }
}

// Acquire one in-flight ref on `fd` for `gen` (the caller's entry-time,
// cached generation -- see `netFdGen`'s header). Every blocking retry loop
// in this file/`../darwin/tcp.bit` calls this ONCE, before its first
// syscall, and must not reach a syscall at all when it fails.
@nosplit fn netFdAcquire(fd: int, gen: int): bool {
  let r = pdFdAcquire(fd, gen)
  if (r == pdFdRefusedLast) {
    let _ = int(bit_rt_fs_close(i64(fd)))
  }
  return r == pdFdAcquired
}

// Release the ref `netFdAcquire` took. THIS caller runs the real `close(2)`
// when it turns out to be the last one out while `fd` is closing -- the
// other half of `netClose`'s deferred close above.
@nosplit fn netFdRelease(fd: int) {
  if (pdFdRelease(fd)) {
    let _ = int(bit_rt_fs_close(i64(fd)))
  }
}

export @symbol("bit_rt_port_net_sys_bind") @nosplit fn netSysBind(fd: int, sa: *u8): bool {
  return int(bind(i32(fd), sa, i32(saLen))) >= 0
}

export @symbol("bit_rt_port_net_sys_listen") @nosplit fn netSysListen(fd: int, backlog: int): bool {
  return int(listen(i32(fd), i32(backlog))) >= 0
}

// SO_REUSEADDR so a restart is not refused while the previous socket's
// connections sit in TIME_WAIT. Deliberately NOT SO_REUSEPORT, which would let a
// second process silently steal traffic from this one.
export @symbol("bit_rt_port_net_set_reuse_addr") @nosplit fn netSetReuseAddr(fd: int): bool {
  putU32Le(optBytes(), 0, 1)
  return int(
      setsockopt(
        i32(fd), i32(solSocket()), i32(soReuseAddr()),
        optBytes(), i32(4),
      ),
    ) >=
    0
}

// The pending error on a socket, as SO_ERROR. Zero means the operation
// succeeded; a negative return means the query itself failed.
export @symbol("bit_rt_port_net_socket_error") @nosplit fn netSocketError(fd: int): int {
  putU32Le(optBytes(), 0, 0)
  putU32Le(lenBytes(), 0, 4)
  if (int(
      getsockopt(
        i32(fd), i32(solSocket()), i32(soError()),
        optBytes(), lenBytes(),
      ),
    ) <
    0) {
    return 0 - 1
  }
  return getU32Le(optBytes(), 0)
}

// ---------------------------------------------------------------------------
// Parking on readiness
// ---------------------------------------------------------------------------

// Park the calling green thread until `fd` is ready for `interest`. Returns true
// when the caller was parked and has since been woken, i.e. the fd is ready.
//
// FALSE MEANS "THERE WAS NOBODY TO PARK ON", NOT "THE FD IS READY". A caller off
// a green stack — a driver program, or any code the ported scheduler is not
// running — has no task to suspend, so this reports that and the retry loops
// below spin instead. That is why they carry TWO bounds: `netMaxStalls` for a
// parked wait, and `netMaxSpins` for the unscheduled one,
// which exists only because this runtime has an unscheduled caller.
//
// THE ARM/REGISTER/PARK ORDER IS THE PROTOCOL, NOT A PREFERENCE. `runtime/sched/`
// registers from a `ParkFn` on the worker's side of the switch; that is a call
// through a function value and `@nosplit` rejects it, so this must register
// BEFORE parking and close the resulting window with `schedParkArm`. See
// ../../sched/task.bit's "arming a park" section for the state machine and
// _tests_/stress/netpark for the property.
// `gen` is the caller's ENTRY-TIME generation (#5886): every retry loop in
// `../darwin/tcp.bit`/`../darwin/udp.bit` reads it once, before its first
// syscall, alongside its `netFdAcquire`, and passes the SAME value on every
// call this loop makes here -- never a fresh `*netFdGenAddr(fd)` read, which
// would (once the loop holds its own ref) always read as still-current and
// so could never itself detect a close the way the entry-time value can.
export @symbol("bit_rt_port_net_await_ready") fn netAwaitReady(
  fd: int,
  interest: int,
  gen: int,
): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return false
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return false
  }
  let dir = pdDirWrite
  if (interest == pollRead) {
    dir = pdDirRead
  }
  // Write is armed LAZILY, here, the first time a write actually blocks —
  // see `pollDescRegisterWrite`'s header for why. Read needs no such check:
  // `netPollDescOpen` already armed it at open time.
  if (dir == pdDirWrite && *netFdWriteArmedAddr(fd) == 0) {
    let _ = pollDescRegisterWrite(pollFd, fd, gen)
    *netFdWriteArmedAddr(fd) = 1
  }
  if (!schedParkArm()) {
    return false
  }
  let r = pdWait(fd, dir, gen, taskAddr)
  if (r == pdAlreadyReady) {
    // An edge was already recorded (register-once/EV_CLEAR, #5865) — no
    // kernel call needed, no park needed, the caller retries the syscall now.
    let _ = schedParkDisarm()
    return true
  }
  if (r != pdClaimed) {
    // `pdStaleGen` (the fd was closed and reused since it was opened) or
    // `pdBusy` (another waiter already holds this direction's slot) — either
    // way nothing will wake this task, so it must not park.
    let _ = schedParkDisarm()
    return false
  }
  schedPollPendingInc()
  schedPark()
  return true
}
