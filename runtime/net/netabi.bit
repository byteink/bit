// Core (platform-free) half of the `bit_rt_net_*` ABI marshalling that used to
// be duplicated byte-for-byte in runtime/net/{linux,darwin}/netabi.bit (#2552,
// #1710's provider-duplication sweep; see docs/development/provider-duplication.md's
// `net` section for the full inventory). Pulled up here: string/byte-pointer
// accessors over the managed `string` representation. All pure arithmetic and
// byte marshalling, no OS call anywhere. (The per-worker UDP last-sender
// scratch that used to live here is gone, #7746: `bit_rt_net_udp_recv_from_w`
// hands the sender back in the caller's own buffer.)
//
// STILL split per provider, and correctly so: the ABI wrapper functions
// (`netAbiAccept`, `netAbiListen`, `netAbiRead`, `netAbiUdpRecvFromW`, ...) forward
// to the socket ENGINE (`netAcceptTcp`, `netListenTcp`, `netReadSock`,
// `netRecvFrom`, ...), which is genuinely OS-specific — a raw `syscall()` on
// Linux, a libSystem `extern fn` on Darwin — and stays in each provider. Their
// SOURCE TEXT is also byte-identical between the two providers, which is what
// made #2550's audit list them as candidates, but a textual match is not
// sufficient: a platform-free file cannot reach a provider-only symbol without
// either an `extern fn` (which would need a call-site rename to the provider's
// pinned `bit_rt_port_*` ABI name — a real body change, not a pure move) or
// reintroducing the SEAM 1 architecture linux/netabi.bit's own header warns
// against. See the #2552 ticket comment for the full 19-function list this
// excludes and why.

// `rtStrAlloc` is already imported from "../root" by this module's sibling
// net.bit (imports are module-scoped, same rule ../linux/netabi.bit's own
// header documents) — importing it again here would be an E0042 redeclaration.
import { strPtr, strLen } from "../root"
import { loadWord, loadByte, storeByte } from "../gc"
// Used by ./sock.bit's `sockScratchSlot` (imports are module-scoped, and this
// file's import is the one that module has).
import { schedCurrentWorker, wkId, schedMaxWorkers, taskAt } from "../sched"

// ---------------------------------------------------------------------------
// Marshalling helpers
// ---------------------------------------------------------------------------

// A raw byte pointer at `addr`. `base + addr` on a nil `*u8` is the project's
// idiom for turning an address held as `int` back into a pointer.
export @symbol("bit_rt_port_net_u8_at") @nosplit fn u8At(addr: int): *u8 {
  let base: *u8 = nil
  return base + addr
}

// A `string` object's inline byte pointer and its length (ABI.md §2: a
// `{ptr, len}` header whose `ptr` addresses the object's own bytes).
export @symbol("bit_rt_port_net_str_data") @nosplit fn strData(s: int): *u8 {
  return u8At(loadWord(s + strPtr))
}

export @symbol("bit_rt_port_net_str_size_of") @nosplit fn strSizeOf(s: int): int {
  return loadWord(s + strLen)
}

// `n` packed bytes at raw address `src`, copied into a fresh `string`. Returns 0
// on heap exhaustion.
//
// `@nosplit`, and that is the whole point of the function existing (#1668): the
// entire raw lifetime — allocate, take the interior pointer, fill — is inside
// this one poll-free body, so no collection can happen between the allocation
// and the last write to it. `src` must point into memory the CALLER keeps alive,
// which for every caller here is a managed `[]i64` local. Same contract, and the
// same reason, as `runtime/root/floats.bit`'s `packLowBytes`.
export @symbol("bit_rt_port_net_str_from_packed") @nosplit fn strFromPacked(src: int, n: int): int {
  let out = rtStrAlloc(n)
  if (out == 0) {
    return 0
  }
  let dst = loadWord(out + strPtr)
  let i = 0
  while (i < n) { // bounded by `n`; the body always advances `i`
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  return out
}

// Words of `[]i64` scratch needed to hold `nbytes` packed bytes.
export @symbol("bit_rt_port_net_scratch_words") @nosplit fn scratchWords(nbytes: int): int {
  return (nbytes + 7) / 8
}

// Whether a caller's DNS budget is one the resolver will run: a per-attempt
// window of 1..`netDnsArgMax` milliseconds and 1..`netDnsArgMax` attempts. The
// numbers themselves are `std/net`'s to choose (#6350); a zero or a value past
// the sanity bound is a caller bug, refused rather than replaced by a default
// of the runtime's own.
export @symbol("bit_rt_port_net_dns_args_ok") @nosplit fn netDnsArgsOk(
  timeoutMs: int,
  attempts: int,
): bool {
  return timeoutMs >= 1 && timeoutMs <= netDnsArgMax && attempts >= 1 && attempts <= netDnsArgMax
}
