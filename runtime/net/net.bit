// Stage-2 port of runtime/net/ (#1366): the platform-free half.
//
// What lives here is everything in `runtime/net/` that touches no kernel: IPv4
// literal parsing and formatting, and the DNS message codec. What does NOT live
// here is every socket call, because a socket is a `syscall` on Linux and an
// `extern` call on Darwin and §11.7/§11.8 reject even an uncalled declaration of
// the wrong one — the same forced provider split the netpoller has, for the same
// reason. See `runtime/net/{linux,darwin}` for that half.
//
// THE SPLIT IS NOT ARBITRARY, AND THE LINE IS "DOES THE KERNEL SEE THIS BYTE".
// `sockaddr_in` is a kernel ABI class and is therefore NOT here even though it
// looks platform-free: its first two bytes differ between the two systems (Linux
// has a 16-bit `sin_family`; Darwin has an 8-bit `sin_len` followed by an 8-bit
// `sin_family`), so a single "portable" layout would be wrong on one of them.
// The DNS message format, by contrast, is defined by RFC 1035 rather than by a
// kernel, so it is identical everywhere and belongs here.
//
// EVERY BUFFER CROSSES AS `*u8` PLUS A BYTE COUNT, NEVER AS A SLICE. A Bit slice
// or array stores one 8-BYTE WORD per element (§11.8), so `[]u8` is strided
// rather than packed and cannot describe a wire-format message or a kernel
// class. This is the trap the brief records as having bitten five agents, and
// DNS is exactly its shape.

// ---------------------------------------------------------------------------
// Policy the two providers share
// ---------------------------------------------------------------------------
//
// These are numbers, not calls, so they are kernel-independent by the split rule
// above and belong here rather than being written twice. Both providers import
// them, and a divergence between the two platforms' retry behaviour is therefore
// impossible by construction rather than by review.
//
// ---------------------------------------------------------------------------
// WHY EVERY EXPORTED FUNCTION BELOW IS `@symbol`-PINNED, INCLUDING THE ONES
// NOTHING CURRENTLY CALLS ACROSS A MODULE BOUNDARY
// ---------------------------------------------------------------------------
//
// ABI.md §9: every runtime function another module calls MUST be pinned. A
// non-root module's symbols are emitted as `m<id>$name`, where `<id>` is an
// ordinal the IMPORTING build assigns — a property of the consuming build, not
// of this module — so the same source compiled into two separately emitted
// objects gets two different names and the link fails or, worse, resolves to
// the wrong one.
//
// This file was unpinned while its only consumers were tests, which is a state
// that reads as fine and is not: the socket providers (`net/darwin`,
// `net/linux`) now call `netParseIpv4`, `netBuildQuery` and `netParseAnswer`
// across a module boundary, which is exactly what the rule covers.
//
// ALL EIGHT ARE PINNED, NOT THE THREE THE CURRENT CALL GRAPH SHOWS, AND THAT IS
// DELIBERATE. The required pin set cannot be derived from the imports: `-O1`
// splices callee bodies into their callers, so which names survive as real
// cross-object references depends on inlining decisions, and those decisions
// DIFFER BETWEEN THE SEED AND THE SELF-HOSTED COMPILER. The safe set is the
// UNION over both compilers at both optimisation levels, and the only stable
// way to spell that union is "every exported function". Pinning one that turns
// out not to need it costs a symbol name; missing one costs a link failure that
// appears under one compiler and not the other.
//
// The `const`s above need no pin — a constant is materialised at its use site
// and never becomes a call.

// Upper bound on consecutive would-block retries for ONE operation, from the
// A stall budget. A poller that reports ready and then hands back EAGAIN
// forever is broken; failing beats spinning (Power of 10: every loop is bounded).
export const netMaxStalls: int = 1024

// The same bound for a caller that is NOT on a green thread and so has nothing
// to park on — a driver program, or any code the ported scheduler is not
// running. This exists only because there IS an unscheduled caller: every
// socket call there is made from a task. A stall there is one readiness edge; a
// stall here is one immediately-retried syscall, so the count has to be much
// larger to cover the same wall-clock wait, and it is still static.
export const netMaxSpins: int = 1000000

// The DNS message buffer size and the retransmit policy.
export const netMaxDnsMsg: int = 512
export const netDnsTimeoutMs: int = 2000
export const netDnsRetries: int = 3

import { rtStrAlloc } from "../root"

// The empty string, the failure value for every string-returning entry point
// (matching `runtime/root/`'s `stringFromBytes("")`).
export @symbol("bit_rt_port_net_empty_str") @nosplit fn emptyStr(): int {
  return rtStrAlloc(0)
}

// ---------------------------------------------------------------------------
// Byte access
// ---------------------------------------------------------------------------

// Read one byte as 0..255. `*p` on a `*u8` is already unsigned, but the result
// is used in arithmetic throughout, so it is widened once here.
@nosplit fn byteAt(base: *u8, off: int): int {
  let p = base + off
  return int(*p)
}

@nosplit fn putByte(base: *u8, off: int, v: int) {
  let p = base + off
  *p = u8(v % 256)
}

// DNS is big-endian on the wire ("network byte order"), and so is `sin_port`.
// Written out byte-wise rather than through an `*i64` because these fields are
// 16-bit and unaligned — the answer section puts a u16 at whatever offset the
// preceding name ended on.
export @symbol("bit_rt_port_net_read_u16_be") @nosplit fn netReadU16Be(base: *u8, off: int): int {
  return byteAt(base, off) * 256 + byteAt(base, off + 1)
}

export @symbol("bit_rt_port_net_write_u16_be") @nosplit fn netWriteU16Be(base: *u8, off: int, v: int) {
  putByte(base, off, v / 256 % 256)
  putByte(base, off + 1, v % 256)
}

// ---------------------------------------------------------------------------
// IPv4 literals
// ---------------------------------------------------------------------------

// Parses a dotted-quad IPv4 literal from `host[0..hostLen]`, writing the four
// octets to `out`. Returns false — writing nothing — for anything else.
//
// DELIBERATELY STRICT: no DNS, no IPv6, no shorthand. A caller
// wanting a hostname resolves it first (`netResolve` is the layer above). The
// strictness is load-bearing rather than fussy: `netResolve` uses THIS FUNCTION'S
// REJECTION as the signal to fall through to a DNS query, so a parser that
// accepted "localhost" as some address would silently skip resolution.
//
// Hand-rolled for one reason: the obvious `split` + `parseInt`
// spelling goes through SIMD `indexOfScalar`, whose vector constants this
// project's own AArch64 linker mis-resolved (#1157) — `indexOfScalar` answered 0
// instead of 3 for the first '.' in "127.0.0.1". Four fields and three digits do
// not need SIMD, and a freestanding runtime is better off not depending on it.
export @symbol("bit_rt_port_net_parse_ipv4") @nosplit fn netParseIpv4(host: *u8, hostLen: int, out: *u8): bool {
  if (hostLen <= 0) {
    return false
  }
  // Four octets, each at most three digits plus a separator: a 15-byte upper
  // bound on any input this can accept, which also bounds every loop below.
  if (hostLen > 15) {
    return false
  }
  let i = 0
  let field = 0
  while (field < 4) {
    let v = 0
    let digits = 0
    // Bounded by `hostLen`, which is bounded above (Power of 10).
    while (i < hostLen && byteAt(host, i) != 46) {
      let c = byteAt(host, i)
      if (c < 48 || c > 57) {
        return false
      }
      v = v * 10 + (c - 48)
      digits = digits + 1
      // Checked INSIDE the loop, not after it, so `v` cannot run away on a long
      // digit run before the range test sees it.
      if (digits > 3 || v > 255) {
        return false
      }
      i = i + 1
    }
    if (digits == 0) {
      return false
    }
    putByte(out, field, v)
    if (field < 3) {
      // A separator must be present and is stepped over.
      //
      // DEFENSIVE DEPTH, NOT AN OBSERVABLE GUARD, and that was established by
      // mutation rather than assumed: deleting this check changes no answer,
      // because the two inputs that reach it are already rejected downstream.
      // A non-'.' byte here is a non-digit, so the digit loop above returns
      // false before this runs; and a name that ends early ("1.2.3") leaves the
      // next field with `digits == 0`, which is rejected on the following pass.
      // It stays because a parser reading untrusted network input should refuse
      // on the first thing that is wrong rather than on a later consequence.
      if (i >= hostLen || byteAt(host, i) != 46) {
        return false
      }
      i = i + 1
    }
    field = field + 1
  }
  // Trailing junk, e.g. "1.2.3.4.5" or "1.2.3.4x". Without this the fourth
  // field's loop would simply stop early and the remainder go unnoticed.
  if (i != hostLen) {
    return false
  }
  return true
}

// Writes the dotted quad for four octets into `buf`, returning the byte count.
// `buf` must hold the longest form, "255.255.255.255" = 15 bytes.
//
// Hand-rolled for the same reason as `netParseIpv4`, and with no leading zeros:
// `formatOctets` must round-trip through `netParseIpv4`, which rejects a
// four-digit field, so "010" would not survive the trip.
export @symbol("bit_rt_port_net_format_octets") @nosplit fn netFormatOctets(octets: *u8, buf: *u8): int {
  let n = 0
  let i = 0
  while (i < 4) {
    if (i != 0) {
      putByte(buf, n, 46)
      n = n + 1
    }
    let o = byteAt(octets, i)
    if (o >= 100) {
      putByte(buf, n, 48 + o / 100)
      n = n + 1
    }
    if (o >= 10) {
      putByte(buf, n, 48 + o / 10 % 10)
      n = n + 1
    }
    putByte(buf, n, 48 + o % 10)
    n = n + 1
    i = i + 1
  }
  return n
}

// ---------------------------------------------------------------------------
// DNS: the message codec
// ---------------------------------------------------------------------------
//
// A minimal stub resolver's wire format: one A query
// to one nameserver over UDP/53, first A record wins. No search domains, no
// caching, no AAAA, no TCP fallback for a truncated reply. A hostname needing any
// of those is out of scope for v1, and widening it here rather than in the resolver
// would be an improvement dressed as a port.

// The DNS transaction id. A FIXED id is sound here and the reason
// is worth keeping: the socket is connectionless and used for exactly one
// exchange, so there is no second reply to correlate against. `netParseAnswer`
// still verifies it, because a stray datagram from an unrelated sender can
// arrive on a bound UDP port and must not be mistaken for the answer.
export const netDnsId: int = 6935

// Writes a DNS A-record query for `host[0..hostLen]` into `out`, returning the
// length, or -1 if the name does not fit the format.
//
// The QNAME is the host split on '.', each label length-prefixed, then a zero
// root label. `outCap` bounds every write — the same bound is checked inside
// its label loop, and it must be checked there rather than up front because the
// encoded length is not a function of `hostLen` alone.
export @symbol("bit_rt_port_net_build_query") @nosplit fn netBuildQuery(out: *u8, outCap: int, host: *u8, hostLen: int, id: int): int {
  // 253 is the RFC 1035 limit on a domain name's presentation length.
  if (hostLen <= 0 || hostLen > 253) {
    return 0 - 1
  }
  if (outCap < 12) {
    return 0 - 1
  }
  // Header: id, flags = RD (recursion desired), qdcount 1, the rest zero.
  netWriteU16Be(out, 0, id)
  netWriteU16Be(out, 2, 256)
  netWriteU16Be(out, 4, 1)
  let z = 6
  while (z < 12) {
    putByte(out, z, 0)
    z = z + 1
  }
  let n = 12

  // QNAME. `start` marks the current label's first byte; a '.' or the end of the
  // host closes it. Bounded by `hostLen` (Power of 10).
  let start = 0
  let i = 0
  while (i <= hostLen) {
    let atEnd = i == hostLen
    if (atEnd || byteAt(host, i) == 46) {
      let labelLen = i - start
      // Rejects both an empty label ("a..b", or a trailing dot) and an
      // over-long one.
      if (labelLen == 0 || labelLen > 63) {
        return 0 - 1
      }
      // 1 length byte + the label + the root label + QTYPE + QCLASS.
      if (n + 1 + labelLen + 5 > outCap) {
        return 0 - 1
      }
      putByte(out, n, labelLen)
      n = n + 1
      let k = 0
      while (k < labelLen) {
        putByte(out, n + k, byteAt(host, start + k))
        k = k + 1
      }
      n = n + labelLen
      start = i + 1
    }
    i = i + 1
  }
  putByte(out, n, 0)
  n = n + 1
  netWriteU16Be(out, n, 1)
  netWriteU16Be(out, n + 2, 1)
  return n + 4
}

// Advances past the DNS name at `msg[off]`, returning the offset just past it,
// or -1 if the name runs off the end of the message.
//
// COMPRESSION IS SKIPPED, NEVER FOLLOWED — and that is a correctness property,
// not a shortcut. A caller here never needs the name's text, only its length, so
// there is nothing to gain by following the pointer; and following it is how a
// DNS parser gets a compression LOOP (a pointer to itself), which is a classic
// hang in exactly the code that must not hang. A pointer is two bytes and always
// ends the name, so this terminates by construction.
export @symbol("bit_rt_port_net_skip_name") @nosplit fn netSkipName(msg: *u8, msgLen: int, off: int): int {
  if (off < 0) {
    return 0 - 1
  }
  let i = off
  // `i` strictly increases every iteration, so `msgLen` bounds the trip count.
  while (i < msgLen) {
    let labelLen = byteAt(msg, i)
    if (labelLen == 0) {
      return i + 1
    }
    // 0xC0 in the top two bits marks a compression pointer.
    if (labelLen / 64 == 3) {
      return i + 2
    }
    i = i + 1 + labelLen
  }
  return 0 - 1
}

// Parses a DNS response, writing the first A record's four octets to `out`.
// Returns false on a mismatched id, an error RCODE, a malformed message, or an
// answer with no A record in it.
//
// The id and RCODE checks are the ones worth not dropping: a reply for a
// different query, or a SERVFAIL, otherwise reaches the answer walk and is read
// as though it carried an address.
export @symbol("bit_rt_port_net_parse_answer") @nosplit fn netParseAnswer(msg: *u8, msgLen: int, wantId: int, out: *u8): bool {
  // A MEMORY-SAFETY GUARD, AND IT CANNOT BE OBSERVED FROM THE OUTSIDE — worth
  // stating so the next reader does not delete it as untested. The four header
  // reads below are the only ones in this function NOT bounded by `msgLen`, so
  // without this a 4-byte datagram is read twelve bytes deep. Every later read
  // is bounded, which is exactly why deleting this line still produces `false`
  // for every input and why the mutation survives: what it prevents is an
  // out-of-bounds read, not a wrong answer.
  if (msgLen < 12) {
    return false
  }
  if (netReadU16Be(msg, 0) != wantId) {
    return false
  }
  let flags = netReadU16Be(msg, 2)
  // RCODE is the low four bits: non-zero is NXDOMAIN, SERVFAIL, REFUSED, ...
  if (flags % 16 != 0) {
    return false
  }
  let qd = netReadU16Be(msg, 4)
  let an = netReadU16Be(msg, 6)

  let off = 12
  // The question section is skipped, not parsed: its only use here is to find
  // where the answers start.
  let q = 0
  while (q < qd) {
    off = netSkipName(msg, msgLen, off)
    if (off < 0) {
      return false
    }
    // QTYPE + QCLASS.
    off = off + 4
    q = q + 1
  }
  let a = 0
  while (a < an) {
    off = netSkipName(msg, msgLen, off)
    if (off < 0) {
      return false
    }
    // TYPE(2) CLASS(2) TTL(4) RDLENGTH(2) — ten bytes of fixed record header
    // that must be present before any of them is read.
    if (off + 10 > msgLen) {
      return false
    }
    let rtype = netReadU16Be(msg, off)
    let rdlen = netReadU16Be(msg, off + 8)
    off = off + 10
    if (off + rdlen > msgLen) {
      return false
    }
    // TYPE 1 is A, and an A record's RDATA is exactly the four address bytes.
    // Both halves are checked: a CNAME or AAAA in the same answer set has a
    // different length, and reading its RDATA as an address is the bug this
    // guard exists for.
    if (rtype == 1 && rdlen == 4) {
      let k = 0
      while (k < 4) {
        putByte(out, k, byteAt(msg, off + k))
        k = k + 1
      }
      return true
    }
    off = off + rdlen
    a = a + 1
  }
  return false
}

// Finds the first `nameserver <dotted-quad>` line in a resolv.conf held in
// `buf[0..bufLen]`, writing its address to `out`. Returns false when there is no
// usable one.
//
// Split out from the file read so that the parsing half is testable without a
// filesystem — resolving a nameserver needs both, and the read is a
// platform call this module cannot make.
export @symbol("bit_rt_port_net_first_nameserver") @nosplit fn netFirstNameserver(buf: *u8, bufLen: int, out: *u8): bool {
  let lineStart = 0
  let i = 0
  // One pass over the file; `i` strictly increases (Power of 10).
  while (i <= bufLen) {
    if (i == bufLen || byteAt(buf, i) == 10) {
      if (netNameserverLine(buf, lineStart, i, out)) {
        return true
      }
      lineStart = i + 1
    }
    i = i + 1
  }
  return false
}

// One resolv.conf line, `buf[lo..hi]`: true when it is a `nameserver` line
// carrying an address this runtime can use.
@nosplit fn netNameserverLine(buf: *u8, lo: int, hi: int, out: *u8): bool {
  let s = lo
  let e = hi
  // Trim leading and trailing space, tab and CR. The CR matters: a file with
  // CRLF endings otherwise leaves "\r" glued to the address and every line is
  // rejected.
  while (s < e && netIsSpace(byteAt(buf, s))) {
    s = s + 1
  }
  while (e > s && netIsSpace(byteAt(buf, e - 1))) {
    e = e - 1
  }
  // "nameserver" is ten bytes and must be followed by separating space —
  // without that check a directive like "nameserverfoo" would match.
  if (e - s < 11) {
    return false
  }
  let key = 0
  while (key < 10) {
    if (byteAt(buf, s + key) != netNameserverByte(key)) {
      return false
    }
    key = key + 1
  }
  let v = s + 10
  if (!netIsSpace(byteAt(buf, v))) {
    return false
  }
  while (v < e && netIsSpace(byteAt(buf, v))) {
    v = v + 1
  }
  return netParseIpv4(buf + v, e - v, out)
}

@nosplit fn netIsSpace(c: int): bool {
  // space, tab, CR.
  return c == 32 || c == 9 || c == 13
}

// The bytes of "nameserver". Spelled as a function over an index rather than as
// a string constant because this module is compared byte-wise against a `*u8`
// cursor and never holds a managed string.
@nosplit fn netNameserverByte(i: int): int {
  if (i == 0) { return 110 }
  if (i == 1) { return 97 }
  if (i == 2) { return 109 }
  if (i == 3) { return 101 }
  if (i == 4) { return 115 }
  if (i == 5) { return 101 }
  if (i == 6) { return 114 }
  if (i == 7) { return 118 }
  if (i == 8) { return 101 }
  return 114
}

// ---------------------------------------------------------------------------
// Deadline arithmetic (pulled up from runtime/net/{linux,darwin}/tcp.bit,
// #2552 — pure deadline-vs-now math, no OS call). `netAwaitDeadlineTick` and
// the retry loops that consume `netClampDeadline`'s result stay
// provider-local: they call the OS-specific `netClockNowNs`/`schedSleepUntil`
// chain.
// ---------------------------------------------------------------------------

// Ceiling on how far past "now" a deadline is honoured: one hour — a caller
// typo (nanoseconds where milliseconds was meant, say) must not reinstate an
// unbounded wait. #3720: this used to equal `os_run_bounded_max_ms` (ABI.md
// §19) by coincidence, not by requirement — that ceiling governs test/gate
// wall-clock capacity and was raised to 100 minutes as the differential suite
// grew; this one bounds a caller's own deadline input against a unit typo in
// production network code, a different reason with no tie to gate timing.
// Kept independent at one hour on purpose; do not re-couple it to
// `os_run_bounded_max_ms`.
export const netDeadlineMaxWaitNs: int = 3600000000000

// The deadline a bounded call actually waits against: `deadlineNs <= 0` is
// `std/net`'s "no deadline" sentinel (a `Conn`'s zero value) and clamps to
// `netDeadlineMaxWaitNs` from now rather than truly forever, for the same
// reason `os_run_bounded_max_ms` clamps a caller's `timeoutMs`. A deadline
// already in the past clamps up to `now`, so the very first check reports the
// timeout instead of the loop spinning on a negative budget.
export @symbol("bit_rt_port_net_clamp_deadline") @nosplit fn netClampDeadline(deadlineNs: int, now: int): int {
  let deadlineCeiling = now + netDeadlineMaxWaitNs
  if (deadlineNs <= 0 || deadlineNs > deadlineCeiling) {
    return deadlineCeiling
  }
  if (deadlineNs < now) {
    return now
  }
  return deadlineNs
}
