// The TCP section of the Linux socket provider, split out of ./sock.bit (#1503).
// Sibling file, so the same module: the syscall numbers, kernel-struct
// constants, scratch buffers, `sysRc`/`lastErr` and `netAwaitReady` it uses all
// live there and need no import in either direction.
//
// `schedSleepUntil` and `parkMonoNs` are the two names sock.bit does not
// already bring into the module — see the "Deadline-bounded connect/read/write"
// section below (#2291) for what they are for. Byte-for-byte mirror of
// ../darwin/tcp.bit's own section save the platform glue (raw `syscall()`
// here, libSystem `extern fn` there, and `parkMonoNs`'s scratch argument).
import { schedSleepUntil } from "../../sched"
import { parkMonoNs } from "../../park/linux"

// ---------------------------------------------------------------------------
// TCP
// ---------------------------------------------------------------------------

// A listening socket bound to `host:port`. `port == 0` lets the kernel pick one;
// recover it with `netLocalPort`. Returns a negative value on failure.
//
// #2343: A FAILURE AFTER A SYSCALL RETURNS `0 - lastErr()`, not a flat `-1` —
// see ../darwin/tcp.bit's identical header note for the full rationale. Here
// `lastErr()` reads the module-level `errWord` `sysRc` (./sock.bit) just set,
// captured before `netClose` runs — `netClose` on this provider is a raw
// `syscall(sysClose(), ...)` that deliberately bypasses `sysRc`, so it cannot
// clobber `errWord` even on success, but capturing first keeps this file's
// discipline identical to the Darwin twin's, where that guarantee is weaker.
// `netParseIpv4` rejecting the host is NOT a kernel errno, so that branch
// keeps the fixed `-1` sentinel.
export @symbol("bit_rt_port_net_listen_tcp") @nosplit fn netListenTcp(host: *u8, hostLen: int, port: int, backlog: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - lastErr()
  }
  if (!netSetReuseAddr(fd)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  if (!netSysListen(fd, backlog)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  return fd
}

// The port `fd` is actually bound to — the whole point of binding to port 0.
export @symbol("bit_rt_port_net_local_port") @nosplit fn netLocalPort(fd: int): int {
  putU32Le(lenBytes(), 0, saLen)
  if (sysRc(int(syscall(sysGetSockName(), i64(fd), i64(int(saBytes())),
                        i64(int(lenBytes()))))) < 0) {
    return 0 - 1
  }
  return netSockAddrPort(saBytes())
}

// Accept one connection, parking until a peer arrives. The returned socket is
// non-blocking, like every socket here. Negative on failure.
export @symbol("bit_rt_port_net_accept_tcp") fn netAcceptTcp(lfd: int): int {
  let stalls = 0
  let spins = 0
  // Two bounds, both static (Power of 10): `stalls` counts parked waits and
  // `spins` counts unscheduled retries, and neither can run away.
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // `accept4` WITH THE FLAGS, not `accept` plus an `fcntl`: the accepted
    // socket is non-blocking and close-on-exec from the instant it exists.
    // Darwin has no `accept4`, so its twin does the two-step.
    let fd = sysRc(int(syscall(sysAccept4(), i64(lfd), 0, 0,
                               i64(sockNonBlock() + sockCloExec()))))
    if (fd >= 0) {
      return fd
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(lfd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      // A peer that vanished between the poll and the accept is routine, and
      // not this listener's problem. EINTR likewise.
      if (e != eConnAborted() && e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Connect to `host:port`, parking until the handshake finishes.
//
// A non-blocking `connect` reports EINPROGRESS and finishes in the background.
// The socket then becomes WRITABLE whether it succeeded or failed, so the
// outcome has to be read back from SO_ERROR. Skipping that read is the classic
// bug: a refused connection looks connected until some later `write` fails far
// away from the cause.
export @symbol("bit_rt_port_net_dial_tcp") fn netDialTcp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - lastErr()
  }
  netFillSockAddr(saBytes(), ip, port)
  let rc = sysRc(int(syscall(sysConnect(), i64(fd), i64(int(saBytes())), i64(saLen))))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - e
  }
  let spins = 0
  // Bounded (Power of 10). One parked wait suffices when there is a scheduler;
  // the loop exists for the unscheduled caller, which must poll for completion.
  //
  // `SO_ERROR == 0` DOES NOT MEAN CONNECTED — it means "no error HAS BEEN
  // RECORDED YET", and immediately after EINPROGRESS that is the state of every
  // handshake, including the ones about to be refused. Reading it before the
  // handshake finishes therefore reports success for a connection that has not
  // happened, which is the very bug the comment above warns about, one step
  // further in.
  //
  // FOUND ON THE DARWIN TWIN (#1462) AND FIXED HERE TOO, BUT THE TWO ARE NOT
  // EQUALLY EXPOSED, so the same code was failing differently on each platform.
  // Darwin's `fcntl` never actually applied `O_NONBLOCK` (a variadic-ABI bug),
  // so `connect` completed synchronously there and this loop was DEAD CODE. This
  // provider takes `SOCK_NONBLOCK` at creation and has always been genuinely
  // non-blocking, so here the loop runs and the early read is LIVE — it is a
  // race that loopback usually wins (a refused connect records ECONNREFUSED
  // almost at once) and therefore usually looks correct. Same defect, opposite
  // reasons for going unnoticed.
  //
  // So completion is established FIRST, by re-issuing `connect` — the way to ask
  // a pending handshake how it went that needs no poller, which matters because
  // the unscheduled caller has none:
  //
  //   EALREADY / EINPROGRESS   still running; keep waiting
  //   EISCONN (or success)     finished and connected
  //   anything else            the deferred failure, reported here
  //
  // SO_ERROR is then read on the completed socket, where it IS meaningful.
  while (spins < netMaxSpins) {
    if (netAwaitReady(fd, pollWrite)) {
      spins = netMaxSpins
    } else {
      spins = spins + 1
    }
    // THE ADDRESS IS REBUILT EVERY ATTEMPT, NOT REUSED. `saBytes()`/`ipBytes()`
    // are PER-WORKER scratch (#3273), shared by every entry point that resumes
    // on the same worker, and `netAwaitReady` above PARKS the calling green
    // thread — so either another task runs a `netListenTcp`/`netBindUdp`/
    // `netDialTcp` of its own on this worker and leaves its address in this
    // worker's slot, or this task itself resumes on a DIFFERENT worker whose
    // slot was never filled for this call. Reconnecting to whatever is there
    // either way would be a silent cross-connection.
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = sysRc(int(syscall(sysConnect(), i64(fd), i64(int(saBytes())), i64(saLen))))
    let ce = lastErr()
    if (rc2 >= 0 || ce == eIsConn()) {
      // Connected as far as the handshake is concerned; SO_ERROR is now the
      // authority on whether it succeeded. Same reasoning as the Darwin twin:
      // `netSocketError` returns the deferred connect's own errno directly
      // when it is positive; a negative result is its OWN getsockopt call
      // failing, reported through `lastErr()` instead.
      let soErr = netSocketError(fd)
      if (soErr != 0) {
        netClose(fd)
        if (soErr > 0) {
          return 0 - soErr
        }
        return 0 - lastErr()
      }
      return fd
    }
    if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
      netClose(fd)
      return 0 - ce
    }
  }
  // Spin bound exhausted with the handshake still pending: not a
  // kernel-reported cause, so this stays the fixed `-1` sentinel — see the
  // identical branch in the Darwin twin.
  netClose(fd)
  return 0 - 1
}

// Read up to `cap` bytes into `buf`, parking until some arrive. `0` means the
// peer closed: an orderly end of stream, not an error. Negative on failure.
export @symbol("bit_rt_port_net_read_sock") fn netReadSock(fd: int, buf: *u8, cap: int): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let n = sysRc(int(syscall(sysRead(), i64(fd), i64(int(buf)), i64(cap))))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e == eIntr()) {
        spins = spins + 1
      } else {
        // A reset peer has no more bytes for us. Report end of stream so a
        // caller's read loop terminates instead of erroring.
        if (e == eConnReset()) {
          return 0
        }
        return 0 - 1
      }
    }
  }
  return 0 - 1
}

// SHUT_RDWR (<sys/socket.h>) — the only direction this runtime ever asks for
// (#3016): tearing down a connection means both, so there is no half-close
// caller yet to justify exposing SHUT_RD/SHUT_WR separately. Same value as
// the Darwin twin (2) — POSIX pins SHUT_RD/WR/RDWR at 0/1/2 on every
// platform this runtime targets.
const netShutRdwr: int = 2

// Shut both directions of `fd` down WITHOUT releasing the fd number — unlike
// `netClose`, a later `netListenTcp`/`netDialTcp`/`netAcceptTcp` cannot reuse
// it until an explicit `netClose` follows this. `false` on a hard failure
// (an already-closed or invalid fd); the caller decides whether that is
// worth reporting.
//
// THIS IS NOT `netClose`, AND THE DIFFERENCE IS WHY IT EXISTS — ported from
// `../darwin/tcp.bit`'s `netShutdownSock` (#3016/#3025). That file's own
// comment records the mechanism VERIFIED THERE: closing a still-open fd tears
// the descriptor down without waking a green thread already parked in
// `netAwaitReady` for it, but shutting it down is a real state transition on
// the still-open descriptor the parked reader is registered against, which
// the poller reports as newly readable (an orderly EOF). This provider was
// not independently run — there is no Linux hardware in this session — but
// the syscall is the same one, POSIX specifies the same observable behaviour
// (a pending `read`/`poll`/`epoll_wait` for readability unblocks on a peer or
// local `shutdown`), and `netAwaitReady`'s `epoll`-based provider
// (`../../sched/linux/poll.bit`) uses the identical edge-triggered readiness
// model `netAwaitReady`'s Darwin `kqueue` twin does, so the mechanism this
// exists for is expected to hold identically. `std/http2`'s reader green
// thread (`stdlib/http2/loop.bit`'s `h2connReader`) is the caller this exists
// for: see `stdlib/http/h2.bit`'s `h2clientExchange` for the close-then-reuse
// race a bare `netClose` here left open.
export @symbol("bit_rt_port_net_shutdown_sock") @nosplit fn netShutdownSock(fd: int): bool {
  return sysRc(int(syscall(sysShutdown(), i64(fd), i64(netShutRdwr)))) >= 0
}

// Write all `n` bytes of `buf`, parking whenever the send buffer is full. A
// short write is normal on a socket and is not an error — hence the loop.
export @symbol("bit_rt_port_net_write_sock") fn netWriteSock(fd: int, buf: *u8, n: int): int {
  let off = 0
  let stalls = 0
  let spins = 0
  while (off < n && stalls < netMaxStalls && spins < netMaxSpins) {
    let wrote = sysRc(int(syscall(sysWrite(), i64(fd), i64(int(buf + off)), i64(n - off))))
    if (wrote > 0) {
      off = off + wrote
      // PROGRESS RESETS THE STALL BOUND: the bound is on CONSECUTIVE stalls, not
      // on writes, so a large transfer that legitimately blocks many times is
      // not mistaken for a wedged socket.
      stalls = 0
      spins = 0
    } else {
      if (wrote == 0) {
        return 0 - 1
      }
      let e = lastErr()
      if (e == eAgain()) {
        if (netAwaitReady(fd, pollWrite)) {
          stalls = stalls + 1
        } else {
          spins = spins + 1
        }
      } else {
        if (e == eIntr()) {
          spins = spins + 1
        } else {
          return 0 - 1
        }
      }
    }
  }
  if (off < n) {
    return 0 - 1
  }
  return off
}

// ---------------------------------------------------------------------------
// Deadline-bounded connect/read/write (#2291)
// ---------------------------------------------------------------------------
//
// A server that completes the handshake (or accepts) and then never writes
// parks `netReadSock`/`netDialTcp` above forever — nothing bounds
// `netAwaitReady`'s park. These siblings bound the wait instead, resolving
// ONE absolute monotonic deadline before the first poll and never restarting
// it — the same shape `runtime/root/*/os.bit`'s `osForkExecWaitBounded`
// documents at ABI.md §19. Byte-for-byte mirror of ../darwin/tcp.bit's
// section of the same name; see there for the full rationale, including why
// this does not touch `runtime/sched/**` to add a poll/timer race primitive.
//
// NO GC BRACKET, for the same reason as the Darwin twin: every syscall here
// (`read`/`write`/`connect`) runs on the non-blocking sockets this provider
// always creates (`SOCK_NONBLOCK` at `netSysSocket`/`accept4`), so each
// returns immediately rather than holding the OS thread in the kernel. The
// actual wait is `schedSleepUntil`, a cooperative park.
//
// `@nosplit` (#3000, tests/bit/pollfree.bit): unlike `netAwaitReady` above —
// which calls `pollRegister`, not itself `@nosplit` — `schedSleepUntil` IS
// `@nosplit` (`runtime/sched/timer.bit`), the scheduler's own timer-queue
// park. `netClockNowNs`, `netClampDeadline`, `netAwaitDeadlineTick` and the
// three `*Deadline` entry points below are all `@nosplit`, compiler-proved,
// with no `pollFreeExceptions` entry needed — see ../darwin/tcp.bit's twin
// for the full account.

// PER-WORKER SLOTS, NOT ONE SHARED REGION (#3288 — this comment used to claim
// a single module-level `[2]i64` was sound under a "single-worker-per-call
// sharing contract"; it was not — ABI.md §5.1 documents why #1900 deleted
// that contract rather than merely weakening it). Same shape as ./sock.bit's
// `saBuf`/`sockScratchSlot` (#3273): index by wkId, double-bounded against
// schedMaxWorkers and this array's own literal capacity, plus a fallback slot
// for a caller with no current task — `netClockNowNs`'s callers are reachable
// from an unscheduled driver (`netAwaitDeadlineTick`'s `taskAddr == 0` case
// above), so, unlike `../netabi.bit`'s `udpSenderSlot`, this cannot report
// "no slot" and skip tracking; it needs a slot regardless. `netClockNowNs`
// never parks between filling and reading its own scratch (`parkMonoNs` is a
// raw syscall plus arithmetic, no call to anything that parks), so unlike
// `netabi.bit`'s UDP sender slot this needs no "decide after the park"
// handling — the slot is fetched fresh inside every call, which is also what
// keeps a later call correct after a park elsewhere in the same retry loop.
// A scalar array, never scanned (rule 1).
const netClockScratchSlots: int = 32

@nosplit fn netClockScratchSlot(): int {
  let w = schedCurrentWorker()
  if (w == 0) {
    return netClockScratchSlots
  }
  let id = *(taskAt(w) + wkId)
  if (id < 0 || id >= schedMaxWorkers || id >= netClockScratchSlots) {
    return netClockScratchSlots
  }
  return id
}

// (netClockScratchSlots + 1) slots of 2 words (a timespec) each: 66 = 33 * 2.
let netClockScratch: [66]i64

@nosplit fn netClockScratchAt(): *i64 {
  return ptrOf(netClockScratch) + netClockScratchSlot() * 2
}

// Poll interval while waiting for readiness or the deadline, whichever comes
// first: 2ms, the same value `runtime/root/*/os.bit`'s `osPollNs` uses for an
// analogous bounded wait.
const netDeadlinePollNs: int = 2000000

// Ceiling on how far past "now" a deadline is honoured: one hour, matching
// `os_run_bounded_max_ms` (ABI.md §19) — a caller typo (nanoseconds where
// milliseconds was meant, say) must not reinstate an unbounded wait.
const netDeadlineMaxWaitNs: int = 3600000000000

// Worst-case iterations of the retry loops below: the wait ceiling divided by
// the poll interval, plus slack (Power of 10 rule 2, no `while (true)`) — the
// monotonic-deadline check inside each loop is what actually ends every real
// call, well before this bound is reached.
const netDeadlineMaxPolls: int = netDeadlineMaxWaitNs / netDeadlinePollNs + 16

// The deadline elapsed before the operation completed — `osForkExecWaitBounded`'s
// `-2` "timed out" sentinel, reused here for the same reason: one convention
// for "a bounded wait gave up" across the runtime.
const netDeadlineTimedOut: int = 0 - 2

// The monotonic clock these deadlines are measured against — `runtime/park/linux`'s
// `parkMonoNs`, the same clock `std/time`'s `monotonic()` reaches. `@nosplit`
// (#3000): `parkMonoNs` is `@nosplit` too (a raw `syscall` — admitted by
// E0075 on proof, it is not a call at all — plus arithmetic and a pointer
// deref), so the annotation closes here rather than needing a
// `pollFreeExceptions` entry.
@nosplit fn netClockNowNs(): int {
  return parkMonoNs(netClockScratchAt())
}

// The deadline a bounded call actually waits against: `deadlineNs <= 0` is
// `std/net`'s "no deadline" sentinel (a `Conn`'s zero value) and clamps to
// `netDeadlineMaxWaitNs` from now rather than truly forever, for the same
// reason `os_run_bounded_max_ms` clamps a caller's `timeoutMs`. A deadline
// already in the past clamps up to `now`, so the very first check reports the
// timeout instead of the loop spinning on a negative budget.
@nosplit fn netClampDeadline(deadlineNs: int, now: int): int {
  let cap = now + netDeadlineMaxWaitNs
  if (deadlineNs <= 0 || deadlineNs > cap) {
    return cap
  }
  if (deadlineNs < now) {
    return now
  }
  return deadlineNs
}

// Wait a short, bounded slice toward `deadlineNs`, or report there was nobody
// to wait on — mirrors `netAwaitReady`'s `false` contract for an unscheduled
// caller (a driver program the scheduler is not running), so that caller's
// own `polls` bound below still protects it; there is no cooperative sleep
// without a scheduler to drive `schedTimerExpire`; retrying tightly is thus
// the correct fallback, and it can never run past `deadlineNs` because the
// caller checks the clock again on every iteration.
@nosplit fn netAwaitDeadlineTick(deadlineNs: int): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let now = netClockNowNs()
  let wake = now + netDeadlinePollNs
  if (wake > deadlineNs) {
    wake = deadlineNs
  }
  schedSleepUntil(wake)
  return true
}

// Read up to `cap` bytes into `buf`, bounded by `deadlineNs` (absolute
// monotonic ns) rather than parking forever. Same three-way result shape as
// `osForkExecWaitBounded`: `n >= 0` bytes read (`0` — the peer closed, an
// orderly end of stream, exactly as `netReadSock` reports it), `-1` a hard
// I/O error, `-2` (`netDeadlineTimedOut`) the deadline elapsed first.
export @symbol("bit_rt_port_net_read_sock_deadline") @nosplit fn netReadSockDeadline(fd: int, buf: *u8, cap: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let n = sysRc(int(syscall(sysRead(), i64(fd), i64(int(buf)), i64(cap))))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netClockNowNs() >= deadline) {
        return netDeadlineTimedOut
      }
      let _ = netAwaitDeadlineTick(deadline)
    } else if (e == eIntr()) {
      // Interrupted; retry immediately, same as `netReadSock`.
    } else if (e == eConnReset()) {
      return 0
    } else {
      return 0 - 1
    }
  }
  if (netClockNowNs() >= deadline) {
    return netDeadlineTimedOut
  }
  return 0 - 1
}

// Write all `n` bytes of `buf`, bounded by `deadlineNs`. Same result shape as
// `netReadSockDeadline`: `>= 0` bytes written (always `n` on success — a
// short write is retried internally, exactly as `netWriteSock` does), `-1` a
// hard error, `-2` the deadline elapsed first.
export @symbol("bit_rt_port_net_write_sock_deadline") @nosplit fn netWriteSockDeadline(fd: int, buf: *u8, n: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let off = 0
  let polls = 0
  while (off < n && polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let wrote = sysRc(int(syscall(sysWrite(), i64(fd), i64(int(buf + off)), i64(n - off))))
    if (wrote > 0) {
      off = off + wrote
    } else if (wrote == 0) {
      return 0 - 1
    } else {
      let e = lastErr()
      if (e == eAgain()) {
        if (netClockNowNs() >= deadline) {
          return netDeadlineTimedOut
        }
        let _ = netAwaitDeadlineTick(deadline)
      } else if (e != eIntr()) {
        return 0 - 1
      }
    }
  }
  if (off < n) {
    if (netClockNowNs() >= deadline) {
      return netDeadlineTimedOut
    }
    return 0 - 1
  }
  return off
}

// Connect to `host:port`, bounded by `deadlineNs`. Same shape as
// `netDialTcp` above (SO_ERROR read back only once the handshake has
// completed one way or the other — see that function's comment for why),
// with the unbounded spin loop there replaced by a deadline check.
export @symbol("bit_rt_port_net_dial_tcp_deadline") @nosplit fn netDialTcpDeadline(host: *u8, hostLen: int, port: int, deadlineNs: int): int {
  let deadline = netClampDeadline(deadlineNs, netClockNowNs())
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  let rc = sysRc(int(syscall(sysConnect(), i64(fd), i64(int(saBytes())), i64(saLen))))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - 1
  }
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    if (netClockNowNs() >= deadline) {
      netClose(fd)
      return netDeadlineTimedOut
    }
    let _ = netAwaitDeadlineTick(deadline)
    // THE ADDRESS IS REBUILT EVERY ATTEMPT — see `netDialTcp`'s identical
    // comment; `netAwaitDeadlineTick` parks, so another task can leave its own
    // address in this worker's `saBytes()`/`ipBytes()` slot, or this task can
    // resume on a different worker's (unfilled) slot (#3273).
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = sysRc(int(syscall(sysConnect(), i64(fd), i64(int(saBytes())), i64(saLen))))
    let ce = lastErr()
    if (rc2 >= 0 || ce == eIsConn()) {
      if (netSocketError(fd) != 0) {
        netClose(fd)
        return 0 - 1
      }
      return fd
    }
    if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
      netClose(fd)
      return 0 - 1
    }
  }
  netClose(fd)
  return 0 - 1
}
