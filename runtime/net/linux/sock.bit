// Linux socket provider for the Stage-2 port of runtime/net/ (#1366): every
// call in that file that the kernel sees. See ../net.bit for the half that it
// does not, and for why `sockaddr_in` is HERE rather than there.
//
// Raw syscalls (§11.8) rather than libc, for the reason the whole runtime uses
// them: the ELF output is fully static with no libc to call into.
//
// EVERY CONSTANT AND EVERY SYSCALL NUMBER BELOW WAS READ OUT OF THE KERNEL UAPI
// STDLIB, NOT FROM MEMORY. A wrong number here is a silent wrong-syscall or a
// silently misparsed address, never a compile error. The numbers are also
// PER-ARCHITECTURE and wildly different between the two — `read` is 0 on x86-64
// and 63 on aarch64 — so a single hard-coded table would be wrong on one target
// and would still link.
//
// KEPT DELIBERATELY IN THE SAME SHAPE AS ../darwin/sock.bit, function for
// function, so that a divergence between the two means a REAL platform
// difference rather than a spelling one. That is why the raw calls below funnel
// through `sysRc`, which converts a Linux `-errno` return into the -1-plus-
// `lastErr()` convention libSystem gives Darwin for free: with that one shim the
// retry logic in both files is textually identical and can be compared by eye.
//
// EVERY BUFFER CROSSES AS `*u8` PLUS A BYTE COUNT. A Bit slice or array stores
// one 8-BYTE WORD per element (§11.8), so `[]u8` is strided rather than packed
// and cannot describe a wire message or a kernel structure.

import { netParseIpv4, netMaxStalls, netMaxSpins } from "../../net"
import { netDnsId, netBuildQuery, netParseAnswer, netMaxDnsMsg } from "../../net"
import { netDnsTimeoutMs, netDnsRetries } from "../../net"
// Byte/wire-format marshalling and the sockaddr fields that read the same on
// both platforms are core now (../sock.bit, #2552) — only `saFamilyOff`
// (this file's own const above) genuinely differs per OS. Module-scoped, so
// this one import line also covers ../tcp.bit's and ../udp.bit's uses of
// `ipBytes`/`saBytes2`/`saLen`/etc.
import {
  afInet, sockStream, sockDgram, fGetFl, fSetFl, eIntr, saLen, saPortOff,
  saAddrOff, sockScratchSlot, saBytes, saBytes2, optBytes,
  lenBytes, ipBytes, tvBytes, dnsBytes, putU8, getU8, putU16Be,
  putU32Le, getU32Le, getU64Le, putU64Le,
  netSockAddrIpv4, netSockAddrPort,
} from "../../net"
import { taskAt, schedCurrentTask, taskWorker, wkSched, scPollFd } from "../../sched"
import { schedParkArm, schedParkDisarm, schedPark, pollRead, pollWrite } from "../../sched"
// `schedCurrentWorker`/`wkId`/`schedMaxWorkers` also back this file's own
// `sockScratchSlot` and ../tcp.bit's `netClockScratchSlot` (module-scoped).
import { schedCurrentWorker, wkId, schedMaxWorkers } from "../../sched"
import { schedPollUnpark, schedPollPendingInc, schedPollPendingDec } from "../../sched"
// pollDesc (#5864/#5866): the register-once model's per-fd table --
// `netPollDescOpen` below (`netSysSocket`, and `../tcp.bit`'s `netAcceptTcp`)
// and `netClose` are this file's two lifecycle ends, `netAwaitReady` and
// `../tcp.bit`'s deadline race are the two waiters.
import {
  pdOpen, pdWait, pdClose, pdDirRead, pdDirWrite,
  pdClaimed, pdAlreadyReady, pdEmpty,
} from "../../sched"
// Per-fd in-flight reference counting (#5886): the Go-style `fdMutex` that
// defers a real `close(2)` until the last acquired op releases, so a task
// woken by `netClose` never retries a syscall on an fd number the kernel has
// already handed to a new socket. `netFdAcquire`/`netFdRelease` below are the
// thin platform wrappers -- the CAS protocol itself is OS-neutral and lives
// in `../../sched/polldesc.bit`.
import {
  pdFdAcquire, pdFdRelease, pdFdMarkClosing, pdFdClosing,
  pdFdAcquired, pdFdRefusedLast,
  pdFdCloseNow, pdFdCloseDeferred,
} from "../../sched"
import { pollDescRegister, pollDescRegisterWrite, pollDescUnregister } from "../../sched/linux"
import {
  sysAccept4,
  sysBind,
  sysClose,
  sysConnect,
  sysFcntl,
  sysGetPeerName,
  sysGetSockName,
  sysGetSockOpt,
  sysListen,
  sysRead,
  sysRecvFrom,
  sysSendTo,
  sysSetSockOpt,
  sysShutdown,
  sysSocket,
  sysWrite,
} from "../../syscalls"

// THE HOST-TARGET ORDINAL, AS AN `asm` IMMEDIATE RATHER THAN `hostTarget()`
// (#1659, applied here by #1668). Everything in this file except `netAwaitReady`
// is `@nosplit`, and §10.3.1 deliberately REFUSES `hostTarget()` inside a
// poll-free body: it is a seed `prim_rt_fns` entry, so it lowers to a real
// `call bit_rt_host_target` (_tests_/cases/check_nosplit_host_target.bit pins the
// refusal). An `asm` block is inline by construction, so it is admitted, and
// §11.6 selects the sub-block per architecture at codegen.
//
// This is `runtime/root/linux/os.bit`'s `rtHostTarget` verbatim, duplicated
// rather than imported for the reason `nr` itself is already duplicated across
// `runtime/{net,park,sched,rand,thread}/linux`: each is a separate module, and a
// cross-module call would make this module's freestanding emit depend on
// `runtime/root/linux`'s. _tests_/cases/run_nosplit_asm_arch.bit is the
// independent oracle for the immediates — it checks this exact pair against
// `hostTarget()` at run time, so a flipped arch mapping (which assembles fine
// either way and would silently issue the wrong syscall) reddens there.
@nosplit fn netHostTarget(): int {
  return asm {
    arm64 { 0xD2800020 }                 // movz x0, #1   -> aarch64-linux
    x64 { 0xB8, 0x00, 0x00, 0x00, 0x00 } // mov  eax, 0   -> x86_64-linux
    result arm64 x0 x64 rax : int
  }
}

// Syscall numbers are per-architecture and Bit has no arch-conditional
// compilation, so the number is selected at run time (§11.8). `netHostTarget()`
// is 0 for x86_64-linux and 1 for aarch64-linux; this module is only ever built
// for a Linux target, so the two cases are exhaustive. Same shape as
// ../../sched/linux/poll.bit and runtime/park/linux/wait.bit.

// SOCK_NONBLOCK (0o4000) and SOCK_CLOEXEC (0o2000000), OR-ed into the socket
// type at creation. DARWIN HAS NEITHER, so its twin creates the socket blocking
// and issues a second `fcntl` — one syscall more, and a window in which the
// socket is blocking. This form is the reason `accept4` is used below instead of
// `accept`: it applies the same two flags to the accepted socket atomically.
@nosplit fn sockNonBlock(): int { return 2048 }
@nosplit fn sockCloExec(): int { return 524288 }

// O_NONBLOCK. BIT 11 here (value 2048) and bit 2 on Darwin (value 4) — the
// same name, a different bit, and nothing about the source spelling reveals
// it. (F_GETFL/F_SETFL, the fcntl COMMANDS this flag is set through, are core
// now — ../sock.bit, #2552 — since 3 and 4 are POSIX-standard on both OSes.)
@nosplit fn oNonBlock(): int { return 2048 }

// SOL_SOCKET IS 1 ON LINUX, not Darwin's 0xFFFF.
@nosplit fn solSocket(): int { return 1 }

// SO_REUSEADDR 2, SO_ERROR 4, SO_RCVTIMEO 20 — from `<asm-generic/socket.h>`.
// NONE of the three agrees with Darwin, and the trap is SO_ERROR: it is 4 here
// and Darwin's SO_REUSEADDR is also 4, so transcribing the wrong file's number
// asks the kernel a completely different question and gets an answer.
@nosplit fn soReuseAddr(): int { return 2 }
@nosplit fn soError(): int { return 4 }
@nosplit fn soRcvTimeo(): int { return 20 }

// errno values, from `<asm-generic/errno.h>`. ALL FOUR DIFFER FROM DARWIN.
// (EINTR, the one POSIX errno that agrees with Darwin, is core now —
// ../sock.bit, #2552.) EAGAIN is 11 here and 35 there, EINPROGRESS 115 vs 36,
// ECONNABORTED 103 vs 53, ECONNRESET 104 vs 54.
@nosplit fn eAgain(): int { return 11 }
@nosplit fn eInProgress(): int { return 115 }
@nosplit fn eConnAborted(): int { return 103 }
@nosplit fn eConnReset(): int { return 104 }
// The two answers a RE-ISSUED `connect` gives about a handshake already under
// way: EALREADY "still running", EISCONN "finished, and it succeeded". See
// `netDialTcp`, which needs them to know when SO_ERROR has become meaningful.
@nosplit fn eAlready(): int { return 114 }
@nosplit fn eIsConn(): int { return 106 }

// `sockaddr_in` (POSIX) ON LINUX, from `<netinet/in.h>` — AND THIS IS THE STRUCTURE
// THAT FORCED THE CORE/PROVIDER SPLIT:
//
//     sin_family: 0   (u16)    <- AN 8-BIT sin_len THEN AN 8-BIT FAMILY ON DARWIN
//     sin_port:   2   (u16, big-endian)  <- core now, ../sock.bit (#2552)
//     sin_addr:   4   (u32, four octets in wire order)  <- core now, ../sock.bit
//     sin_zero:   8   (8 bytes)
//
// Total 16 bytes on both systems (`netSockAddrLen`, also core now), which is
// exactly what makes the `sin_family` difference dangerous: Darwin's layout is
// the same SIZE and would put AF_INET in `sin_len`, leaving `sin_family` zero.
// `saFamilyOff` is the one field of this struct that stays provider-local —
// it is genuinely 0 here and 1 on Darwin, so a shared core copy would read the
// wrong byte on one of the two platforms.
const saFamilyOff: int = 0

// `timeval` (POSIX) ON LINUX: `tv_sec` AND `tv_usec` are both 64 bits, where
// Darwin's `tv_usec` is 32 (`suseconds_t`). The structure is 16 bytes on both, so
// writing Darwin's 32-bit field here would leave the top half of `tv_usec`
// holding whatever was in the buffer — a receive timeout of some absurd value,
// with no error from the kernel.
const tvSize: int = 16
const tvSecOff: int = 0
const tvUsecOff: int = 8

// PER-WORKER, LIKE the marshalling scratch buffers now in ../sock.bit (#2552,
// same #3273/#3296 fix) — but unlike them, `errWordBuf` is not filled once
// and read back inside one call: `sysRc` writes it on EVERY raw syscall this
// file makes, ON SUCCESS AS WELL AS FAILURE (the success path zeroes it). So
// the window is not just two failures racing: a worker B syscall that
// SUCCEEDS can stomp worker A's just-recorded errno before A's own
// `lastErr()` reads it back, a few instructions later with no park in between
// (checked directly: `sysRc`/`lastErr` and every caller of them in this file
// are `@nosplit`, and the call sites capture `lastErr()` into a local before
// anything that parks). One `i64` slot, not a byte buffer.
//
// Reproduced on real native aarch64 Linux (Docker, no qemu): two families of
// tasks each looping `bit_rt_port_net_listen_tcp`, one always hitting
// EADDRINUSE (98, a pre-bound port) and the other always EADDRNOTAVAIL (99,
// binding a syntactically valid but non-local address, `8.8.8.8` — needs no
// responder and sends no packet, bind() only consults the local interface
// table). BIT_WORKERS=1: 0 mismatches across 48000 calls (2 runs). BIT_WORKERS
// =2/4/8: dense corruption every run (2 runs each) — either the OTHER
// family's errno (`stolenFromA`/`stolenFromB`) or 0 (`other`, the
// success-zeroes-it half of the hazard: `lastErr()` reads back a concurrent
// SUCCESSFUL socket()/setsockopt() call's zero instead of the failing bind's
// own errno). Zero at w=1, nonzero on every w>1 run.
let errWordBuf: [33]i64

@nosplit fn errWordAt(): *i64 {
  return ptrOf(errWordBuf) + sockScratchSlot()
}

@nosplit fn putU16Le(base: *u8, off: int, v: int) {
  putU8(base, off, v)
  putU8(base, off + 1, v / 256)
}

// TRANSLATE A LINUX SYSCALL RETURN INTO DARWIN'S CONVENTION, so that every
// retry loop below is textually identical to its twin's.
//
// A Linux syscall reports failure as a small NEGATIVE errno in the result
// register; libSystem returns -1 and puts the reason in thread-local `errno`.
// Both are exact and neither is more correct — but two providers written in two
// conventions cannot be diffed against each other, and diffing them by eye is
// the only review this pair of files gets. So the shim is here, once.
@nosplit fn sysRc(rc: int): int {
  if (rc < 0) {
    *errWordAt() = i64(0 - rc)
    return 0 - 1
  }
  *errWordAt() = 0
  return rc
}

// The errno of the call that just failed. Positive, matching the Darwin twin.
@nosplit fn lastErr(): int {
  return int(*errWordAt())
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

// Lay out a `sockaddr_in` for `ip[0..4]` and `port` in the region at `sa`, which
// must hold `netSockAddrLen()` bytes. `sin_zero` is cleared: the kernel does not
// read it, but a stale eight bytes from a previous call would make an address
// comparison in a caller answer wrongly.
export @symbol("bit_rt_port_net_fill_sock_addr") @nosplit fn netFillSockAddr(
  sa: *u8,
  ip: *u8,
  port: int,
) {
  let k = 0
  while (k < saLen) {
    putU8(sa, k, 0)
    k = k + 1
  }
  // SIXTEEN BITS, LITTLE-ENDIAN, AT OFFSET 0 — the one line in this file that a
  // reader copying from the Darwin twin would get wrong, because there it is an
  // 8-bit length followed by an 8-bit family.
  putU16Le(sa, saFamilyOff, afInet())
  putU16Be(sa, saPortOff, port)
  let j = 0
  while (j < 4) {
    putU8(sa, saAddrOff + j, getU8(ip, j))
    j = j + 1
  }
}

// The address family of a `sockaddr_in`, read at THIS platform's offset.
//
// EXISTS TO MAKE THE ONE REAL LAYOUT DIFFERENCE OBSERVABLE, and it was added
// because mutation proved it was not on the Darwin side. Linux puts a 16-bit
// family at offset 0; Darwin puts an 8-bit `sin_len` there and the family at 1.
// Every other readback the tests perform (`port`, `octets`) lives at an offset
// that difference does not touch, so without this accessor the layout the
// core/provider split exists FOR was guarded by nothing.
//
// Reads only the low byte, which is sufficient and is what keeps this twin
// textually parallel: AF_INET is 2, and on a little-endian target the low byte
// of the 16-bit family is byte 0 — the same byte the Darwin twin reads at its
// own offset. Every target this runtime supports is little-endian.
export @symbol("bit_rt_port_net_sock_addr_family") @nosplit fn netSockAddrFamily(sa: *u8): int {
  return getU8(sa, saFamilyOff)
}

// `bit_rt_port_net_peer_ip`: the connected peer's IPv4 address for `fd`, packed
// first octet in the high byte (127.0.0.1 -> 0x7F000001), or -1. The Darwin
// twin (../darwin/sock.bit) carries the full argument for the family check and
// for the -1 encoding; this is that function over `getpeername(2)` as a raw
// syscall (§11.8) instead of a libSystem call, exactly as `netSockLocalPort`
// (./tcp.bit) is `getsockname`'s.
export @symbol("bit_rt_port_net_peer_ip") @nosplit fn netSockPeerIp(fd: int): int {
  putU32Le(lenBytes(), 0, saLen)
  if (sysRc(
      int(
        syscall(
          sysGetPeerName(), i64(fd), i64(int(saBytes())),
          i64(int(lenBytes())),
        ),
      ),
    ) <
    0) {
    return 0 - 1
  }
  if (netSockAddrFamily(saBytes()) != afInet()) {
    return 0 - 1
  }
  return netSockAddrIpv4(saBytes())
}

// ---------------------------------------------------------------------------
// Raw calls
// ---------------------------------------------------------------------------

// A non-blocking socket. Returns a negative value on failure.
export @symbol("bit_rt_port_net_sys_socket") @nosplit fn netSysSocket(dgram: bool): int {
  let ty = sockStream()
  if (dgram) {
    ty = sockDgram()
  }
  // NONBLOCK AT CREATION: one syscall, and NO window in which the socket is
  // blocking. Darwin has no such flag, hence the `fcntl` in its twin.
  let flags = ty + sockNonBlock() + sockCloExec()
  let fd = sysRc(int(syscall(sysSocket(), i64(afInet()), i64(flags), 0)))
  if (fd < 0) {
    return 0 - 1
  }
  netPollDescOpen(fd)
  return fd
}

export @symbol("bit_rt_port_net_set_non_block") @nosplit fn netSetNonBlock(fd: int): bool {
  let flags = sysRc(int(syscall(sysFcntl(), i64(fd), i64(fGetFl()), 0)))
  if (flags < 0) {
    return false
  }
  // Bit-or spelled as an add guarded by a test: the flag is either already set,
  // in which case adding it again would corrupt an unrelated bit, or it is not.
  let want = flags
  if (flags / oNonBlock() % 2 == 0) {
    want = flags + oNonBlock()
  }
  return sysRc(int(syscall(sysFcntl(), i64(fd), i64(fSetFl()), i64(want)))) >= 0
}

// This connection's OWN generation, cached at `netPollDescOpen` time and read
// (never re-fetched live) by every later wait on the same fd — see that
// function's header for why a live `pdGen(fd)` read at wait time is unsafe.
// 65536 is `pdCapacity` (`../../sched/polldesc.bit`) written as a literal: a
// fixed-array length must be one (E0021), matching that file's own
// `pdGenTable` for the identical reason.
let netFdGen: [65536]i64

@nosplit fn netFdGenAddr(fd: int): *i64 {
  return ptrOf(netFdGen) + fd
}

// Whether `fd`'s WRITE interest has been armed with the kernel yet (#5866) —
// 0 (the `.bss` zero value, and what `netPollDescOpen` resets it to for a
// reused fd number) until the first write on this connection actually
// blocks. See `pollDescRegisterWrite`'s header (`../../sched/linux/pollonce.bit`)
// for why write is armed lazily where read is not.
let netFdWriteArmed: [65536]i64

@nosplit fn netFdWriteArmedAddr(fd: int): *i64 {
  return ptrOf(netFdWriteArmed) + fd
}

// Register `fd`'s read interest with the kernel poller ONCE, for its whole
// life (#5866) — called right after the runtime makes a socket non-blocking
// (`netSysSocket` above; `../tcp.bit`'s `netAcceptTcp` after `accept4`). A
// no-op when there is no current task or no poller bound: an unscheduled
// caller's retry loops never park (`netAwaitReady`'s own `false` path), so
// nothing needs a kernel registration to wake them.
//
// CACHES `gen` INTO `netFdGen`, AND THAT IS LOAD-BEARING, NOT A
// CONVENIENCE — same race `../darwin/sock.bit`'s identical comment documents
// and `_tests_/stress/netclosewhileparkeddarwin` caught there: a wait that
// instead re-read the generation live could claim a slot under a generation a
// concurrent `netClose` had already bumped past, and then park forever.
@nosplit fn netPollDescOpen(fd: int) {
  // The generation and the ref word are reset for EVERY new socket, polled or
  // not (#5886): `netFdAcquire` checks them on every op, so a socket opened
  // off a green stack must not inherit a previous owner's closed state.
  let gen = pdOpen(fd)
  *netFdGenAddr(fd) = gen
  *netFdWriteArmedAddr(fd) = 0
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return
  }
  let _ = pollDescRegister(pollFd, fd, gen)
}

// Retract `fd`'s kernel registration and wake anything still parked on it
// BEFORE `close(fd)` (#5866) — a closed-and-reused fd number must never
// deliver a stale event or a stale wake into a new connection's slots.
// Per-worker scratch for `pdClose`'s two out-parameters — same shape as
// `sockScratchSlot()`/`saBuf`: this is `@nosplit` code, so a heap-allocated
// `[]i64(2)` is not available, and a shared buffer would let two workers
// closing different fds concurrently stomp each other's result.
let netCloseOutBuf: [66]i64

@nosplit fn netCloseOutR(): *i64 {
  return ptrOf(netCloseOutBuf) + sockScratchSlot() * 2
}

@nosplit fn netCloseOutW(): *i64 {
  return netCloseOutR() + 1
}

// #5886: `close(2)` itself is deferred, not just the wake. `pdFdMarkClosing`
// takes ITS OWN ref before `closing` becomes visible (see its own comment),
// so `pdFdCloseDeferred` means this call is the first closer: it must run
// unregister/`pdClose` to wake any parked op, THEN release that ref and run
// `close(2)` only if the release says it was the last one out (some op may
// still be holding a ref at that point -- its own `netFdRelease`, below,
// runs the real close when it drops the last ref instead). `pdFdCloseNow`
// means a second, concurrent `netClose` on this fd (defensive only --
// `Conn.close`/`Listener.close`'s own idempotence one layer up already
// prevents a real double-close) found it was the last ref out and must
// close(2) directly, without repeating unregister/`pdClose`. `pdFdCloseAlready`
// is the ordinary idempotent no-op second close.
export @symbol("bit_rt_port_net_close") @nosplit fn netClose(fd: int) {
  let decision = pdFdMarkClosing(fd)
  if (decision == pdFdCloseNow) {
    let _ = int(syscall(sysClose(), i64(fd)))
    return
  }
  if (decision != pdFdCloseDeferred) {
    return
  }
  let taskAddr = schedCurrentTask()
  if (taskAddr != 0) {
    let t = taskAt(taskAddr)
    let wAddr = *(t + taskWorker)
    if (wAddr != 0) {
      let s = taskAt(*(taskAt(wAddr) + wkSched))
      let pollFd = *(s + scPollFd)
      if (pollFd != 0) {
        let _ = pollDescUnregister(pollFd, fd)
        let outR = netCloseOutR()
        let outW = netCloseOutW()
        let _ = pdClose(fd, outR, outW)
        if (*outR != pdEmpty) {
          schedPollPendingDec()
          let _ = schedPollUnpark(s, *outR)
        }
        if (*outW != pdEmpty) {
          schedPollPendingDec()
          let _ = schedPollUnpark(s, *outW)
        }
      }
    }
  }
  if (pdFdRelease(fd)) {
    let _ = int(syscall(sysClose(), i64(fd)))
  }
}

// Acquire one in-flight ref on `fd` for `gen` (the caller's entry-time,
// cached generation -- see `netFdGen`'s header). Every blocking retry loop
// in this file/`../linux/tcp.bit` calls this ONCE, before its first
// syscall, and must not reach a syscall at all when it fails.
@nosplit fn netFdAcquire(fd: int, gen: int): bool {
  let r = pdFdAcquire(fd, gen)
  if (r == pdFdRefusedLast) {
    let _ = int(syscall(sysClose(), i64(fd)))
  }
  return r == pdFdAcquired
}

// Release the ref `netFdAcquire` took. THIS caller runs the real `close(2)`
// when it turns out to be the last one out while `fd` is closing -- the
// other half of `netClose`'s deferred close above.
@nosplit fn netFdRelease(fd: int) {
  if (pdFdRelease(fd)) {
    let _ = int(syscall(sysClose(), i64(fd)))
  }
}

export @symbol("bit_rt_port_net_sys_bind") @nosplit fn netSysBind(fd: int, sa: *u8): bool {
  return sysRc(int(syscall(sysBind(), i64(fd), i64(int(sa)), i64(saLen)))) >= 0
}

export @symbol("bit_rt_port_net_sys_listen") @nosplit fn netSysListen(fd: int, backlog: int): bool {
  return sysRc(int(syscall(sysListen(), i64(fd), i64(backlog)))) >= 0
}

// SO_REUSEADDR so a restart is not refused while the previous socket's
// connections sit in TIME_WAIT. Deliberately NOT SO_REUSEPORT, which would let a
// second process silently steal traffic from this one.
export @symbol("bit_rt_port_net_set_reuse_addr") @nosplit fn netSetReuseAddr(fd: int): bool {
  putU32Le(optBytes(), 0, 1)
  return sysRc(
      int(
        syscall(
          sysSetSockOpt(), i64(fd), i64(solSocket()), i64(soReuseAddr()),
          i64(int(optBytes())), i64(4),
        ),
      ),
    ) >=
    0
}

// The pending error on a socket, as SO_ERROR. Zero means the operation
// succeeded; a negative return means the query itself failed.
export @symbol("bit_rt_port_net_socket_error") @nosplit fn netSocketError(fd: int): int {
  putU32Le(optBytes(), 0, 0)
  putU32Le(lenBytes(), 0, 4)
  if (sysRc(
      int(
        syscall(
          sysGetSockOpt(), i64(fd), i64(solSocket()), i64(soError()),
          i64(int(optBytes())), i64(int(lenBytes())),
        ),
      ),
    ) <
    0) {
    return 0 - 1
  }
  return getU32Le(optBytes(), 0)
}

// ---------------------------------------------------------------------------
// Parking on readiness
// ---------------------------------------------------------------------------

// Park the calling green thread until `fd` is ready for `interest`. Returns true
// when the caller was parked and has since been woken, i.e. the fd is ready.
//
// FALSE MEANS "THERE WAS NOBODY TO PARK ON", NOT "THE FD IS READY". A caller off
// a green stack — a driver program, or any code the ported scheduler is not
// running — has no task to suspend, so this reports that and the retry loops
// below spin instead. That is why they carry TWO bounds: `netMaxStalls` for a
// parked wait, and `netMaxSpins` for the unscheduled one,
// which exists only because this runtime has an unscheduled caller.
//
// THE ARM/REGISTER/PARK ORDER IS THE PROTOCOL, NOT A PREFERENCE. `runtime/sched/`
// registers from a `ParkFn` on the worker's side of the switch; that is a call
// through a function value and `@nosplit` rejects it, so this must register
// BEFORE parking and close the resulting window with `schedParkArm`. See
// ../../sched/task.bit's "arming a park" section for the state machine and
// _tests_/stress/netpark for the property.
// `gen` is the caller's ENTRY-TIME generation (#5886): every retry loop in
// `../linux/tcp.bit`/`../linux/udp.bit` reads it once, before its first
// syscall, alongside its `netFdAcquire`, and passes the SAME value on every
// call this loop makes here -- never a fresh `*netFdGenAddr(fd)` read, which
// would (once the loop holds its own ref) always read as still-current and
// so could never itself detect a close the way the entry-time value can.
export @symbol("bit_rt_port_net_await_ready") fn netAwaitReady(
  fd: int,
  interest: int,
  gen: int,
): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return false
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return false
  }
  let dir = pdDirWrite
  if (interest == pollRead) {
    dir = pdDirRead
  }
  // Write is armed LAZILY, here, the first time a write actually blocks —
  // see `pollDescRegisterWrite`'s header for why. Read needs no such check:
  // `netPollDescOpen` already armed it at open time. ONE epoll registration
  // covers both directions on this fd (#5866, unlike the pre-register-once
  // design this replaces, which kept read and write interest on two separate
  // epoll descriptors to stop `EPOLL_CTL_MOD` evicting one from the other) —
  // `pollDescRegisterWrite` re-asserts read's bits alongside write's own.
  if (dir == pdDirWrite && *netFdWriteArmedAddr(fd) == 0) {
    let _ = pollDescRegisterWrite(pollFd, fd, gen)
    *netFdWriteArmedAddr(fd) = 1
  }
  if (!schedParkArm()) {
    return false
  }
  let r = pdWait(fd, dir, gen, taskAddr)
  if (r == pdAlreadyReady) {
    // An edge was already recorded (register-once/EPOLLET, #5866) — no
    // kernel call needed, no park needed, the caller retries the syscall now.
    let _ = schedParkDisarm()
    return true
  }
  if (r != pdClaimed) {
    // `pdStaleGen` (the fd was closed and reused since it was opened) or
    // `pdBusy` (another waiter already holds this direction's slot) — either
    // way nothing will wake this task, so it must not park.
    let _ = schedParkDisarm()
    return false
  }
  schedPollPendingInc()
  schedPark()
  return true
}
