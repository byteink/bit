// Linux socket provider for the Stage-2 port of runtime/net.zig (#1366): every
// call in that file that the kernel sees. See ../net.bit for the half that it
// does not, and for why `sockaddr_in` is HERE rather than there.
//
// Raw syscalls (§11.8) rather than libc, for the reason the whole runtime uses
// them: the ELF output is fully static with no libc to call into.
//
// EVERY CONSTANT AND EVERY SYSCALL NUMBER BELOW WAS READ OUT OF THE PINNED ZIG
// STDLIB, NOT FROM MEMORY. A wrong number here is a silent wrong-syscall or a
// silently misparsed address, never a compile error. The numbers are also
// PER-ARCHITECTURE and wildly different between the two — `read` is 0 on x86-64
// and 63 on aarch64 — so a single hard-coded table would be wrong on one target
// and would still link.
//
// KEPT DELIBERATELY IN THE SAME SHAPE AS ../darwin/sock.bit, function for
// function, so that a divergence between the two means a REAL platform
// difference rather than a spelling one. That is why the raw calls below funnel
// through `sysRc`, which converts a Linux `-errno` return into the -1-plus-
// `lastErr()` convention libSystem gives Darwin for free: with that one shim the
// retry logic in both files is textually identical and can be compared by eye.
//
// EVERY BUFFER CROSSES AS `*u8` PLUS A BYTE COUNT. A Bit slice or array stores
// one 8-BYTE WORD per element (§11.8), so `[]u8` is strided rather than packed
// and cannot describe a wire message or a kernel struct.

import { netParseIpv4, netMaxStalls, netMaxSpins } from "../../net"
import { netDnsId, netBuildQuery, netParseAnswer, netMaxDnsMsg } from "../../net"
import { netDnsTimeoutMs, netDnsRetries } from "../../net"
import { taskAt, schedCurrentTask, taskWorker, wkSched, scPollFd } from "../../sched"
import { schedParkArm, schedParkDisarm, schedPark, pollRead, pollWrite } from "../../sched"
import { pollRegister } from "../../sched/linux"

// Syscall numbers are per-architecture and Bit has no arch-conditional
// compilation, so the number is selected at run time (§11.8). `hostTarget()` is
// 0 for x86_64-linux and 1 for aarch64-linux; this module is only ever built for
// a Linux target, so the two cases are exhaustive. Same shape as
// ../../sched/linux/poll.bit and runtime/park/linux/wait.bit.
function nr(x64: int, arm64: int): int {
  if (hostTarget() == 0) {
    return x64
  }
  return arm64
}

function nrSocket(): int { return nr(41, 198) }
function nrBind(): int { return nr(49, 200) }
function nrListen(): int { return nr(50, 201) }
function nrAccept4(): int { return nr(288, 242) }
function nrConnect(): int { return nr(42, 203) }
function nrRead(): int { return nr(0, 63) }
function nrWrite(): int { return nr(1, 64) }
function nrSendTo(): int { return nr(44, 206) }
function nrRecvFrom(): int { return nr(45, 207) }
function nrGetSockName(): int { return nr(51, 204) }
function nrSetSockOpt(): int { return nr(54, 208) }
function nrGetSockOpt(): int { return nr(55, 209) }
function nrClose(): int { return nr(3, 57) }
function nrFcntl(): int { return nr(72, 25) }

// AF_INET, SOCK_STREAM, SOCK_DGRAM, from std/os/linux.zig.
function afInet(): int { return 2 }
function sockStream(): int { return 1 }
function sockDgram(): int { return 2 }

// SOCK_NONBLOCK (0o4000) and SOCK_CLOEXEC (0o2000000), OR-ed into the socket
// type at creation. DARWIN HAS NEITHER, so its twin creates the socket blocking
// and issues a second `fcntl` — one syscall more, and a window in which the
// socket is blocking. This form is the reason `accept4` is used below instead of
// `accept`: it applies the same two flags to the accepted socket atomically.
function sockNonBlock(): int { return 2048 }
function sockCloExec(): int { return 524288 }

// F_GETFL / F_SETFL and O_NONBLOCK. O_NONBLOCK is BIT 11 here (value 2048) and
// bit 2 on Darwin (value 4) — the same name, a different bit, and nothing about
// the source spelling reveals it.
function fGetFl(): int { return 3 }
function fSetFl(): int { return 4 }
function oNonBlock(): int { return 2048 }

// SOL_SOCKET IS 1 ON LINUX, not Darwin's 0xFFFF.
function solSocket(): int { return 1 }

// SO_REUSEADDR 2, SO_ERROR 4, SO_RCVTIMEO 20 — from std/os/linux.zig's `SO`.
// NONE of the three agrees with Darwin, and the trap is SO_ERROR: it is 4 here
// and Darwin's SO_REUSEADDR is also 4, so transcribing the wrong file's number
// asks the kernel a completely different question and gets an answer.
function soReuseAddr(): int { return 2 }
function soError(): int { return 4 }
function soRcvTimeo(): int { return 20 }

// errno values, from std/os/linux.zig's `E`. ALL FOUR DIFFER FROM DARWIN except
// EINTR: EAGAIN is 11 here and 35 there, EINPROGRESS 115 vs 36, ECONNABORTED
// 103 vs 53, ECONNRESET 104 vs 54.
function eAgain(): int { return 11 }
function eIntr(): int { return 4 }
function eInProgress(): int { return 115 }
function eConnAborted(): int { return 103 }
function eConnReset(): int { return 104 }
// The two answers a RE-ISSUED `connect` gives about a handshake already under
// way: EALREADY "still running", EISCONN "finished, and it succeeded". See
// `netDialTcp`, which needs them to know when SO_ERROR has become meaningful.
function eAlready(): int { return 114 }
function eIsConn(): int { return 106 }

// `struct sockaddr_in` ON LINUX, from std/os/linux.zig — AND THIS IS THE STRUCT
// THAT FORCED THE CORE/PROVIDER SPLIT:
//
//     sin_family: 0   (u16)    <- AN 8-BIT sin_len THEN AN 8-BIT FAMILY ON DARWIN
//     sin_port:   2   (u16, big-endian)
//     sin_addr:   4   (u32, four octets in wire order)
//     sin_zero:   8   (8 bytes)
//
// Total 16 bytes on both systems, which is exactly what makes the difference
// dangerous: Darwin's layout is the same SIZE and would put AF_INET in
// `sin_len`, leaving `sin_family` zero. One "portable" `sockaddr_in` in ../net.bit
// would therefore be silently wrong on one of the two platforms.
const saLen: int = 16
const saFamilyOff: int = 0
const saPortOff: int = 2
const saAddrOff: int = 4

// `struct timeval` ON LINUX: `tv_sec` AND `tv_usec` are both 64 bits, where
// Darwin's `tv_usec` is 32 (`suseconds_t`). The struct is 16 bytes on both, so
// writing Darwin's 32-bit field here would leave the top half of `tv_usec`
// holding whatever was in the buffer — a receive timeout of some absurd value,
// with no error from the kernel.
const tvSize: int = 16
const tvSecOff: int = 0
const tvUsecOff: int = 8

// Scratch regions for the kernel structs.
//
// MODULE-LEVEL, AND NOT PROTECTED BY A LOCK — unlike the netpoller's drain
// buffer, which is guarded by `schedPollTryEnter`. That is sound only because
// each of these is written and read within a single call with no park in
// between, and this runtime's green threads on one worker are not preemptive.
// A multi-worker consumer calling these concurrently would need them per-worker;
// the same note is on the Darwin twin, deliberately, so the two stay in step.
let saBuf: [2]i64
let saBuf2: [2]i64
let optBuf: [1]i64
let lenBuf: [1]i64
let ipBuf: [1]i64
let tvBuf: [2]i64
// TWO messages, not one: the query and the reply are both live across the same
// `recvfrom`, so the region is 2 * netMaxDnsMsg = 1024 bytes = 128 words.
let dnsBuf: [128]i64

// The errno of the last raw call, in Darwin's positive convention. See `sysRc`.
let errWord: i64 = 0

function bytesAt(a: int): *u8 {
  let z: *u8 = nil
  return z + a
}

function saBytes(): *u8 { return bytesAt(int(ptrOf(saBuf))) }
function saBytes2(): *u8 { return bytesAt(int(ptrOf(saBuf2))) }
function optBytes(): *u8 { return bytesAt(int(ptrOf(optBuf))) }
function lenBytes(): *u8 { return bytesAt(int(ptrOf(lenBuf))) }
function ipBytes(): *u8 { return bytesAt(int(ptrOf(ipBuf))) }
function tvBytes(): *u8 { return bytesAt(int(ptrOf(tvBuf))) }
function dnsBytes(): *u8 { return bytesAt(int(ptrOf(dnsBuf))) }

function putU8(base: *u8, off: int, v: int) {
  let p = base + off
  *p = u8(v % 256)
}

function getU8(base: *u8, off: int): int {
  let p = base + off
  return int(*p)
}

// Big-endian, because `sin_port` is in network byte order. Written byte-wise
// rather than through a wider pointer for the reason the whole runtime does it:
// a Bit array is word-strided, so a kernel struct is only ever a byte region.
function putU16Be(base: *u8, off: int, v: int) {
  putU8(base, off, v / 256)
  putU8(base, off + 1, v)
}

function getU16Be(base: *u8, off: int): int {
  return getU8(base, off) * 256 + getU8(base, off + 1)
}

function putU16Le(base: *u8, off: int, v: int) {
  putU8(base, off, v)
  putU8(base, off + 1, v / 256)
}

function putU32Le(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 4) {
    putU8(base, off + k, v / (1 << (8 * k)))
    k = k + 1
  }
}

function getU32Le(base: *u8, off: int): int {
  let v = 0
  let k = 3
  while (k >= 0) {
    v = v * 256 + getU8(base, off + k)
    k = k - 1
  }
  return v
}

function getU64Le(base: *u8, off: int): int {
  let v = 0
  let k = 7
  while (k >= 0) {
    v = v * 256 + getU8(base, off + k)
    k = k - 1
  }
  return v
}

function putU64Le(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 8) {
    putU8(base, off + k, v / (1 << (8 * k)))
    k = k + 1
  }
}

// TRANSLATE A LINUX SYSCALL RETURN INTO DARWIN'S CONVENTION, so that every
// retry loop below is textually identical to its twin's.
//
// A Linux syscall reports failure as a small NEGATIVE errno in the result
// register; libSystem returns -1 and puts the reason in thread-local `errno`.
// Both are exact and neither is more correct — but two providers written in two
// conventions cannot be diffed against each other, and diffing them by eye is
// the only review this pair of files gets. So the shim is here, once.
function sysRc(rc: int): int {
  if (rc < 0) {
    errWord = i64(0 - rc)
    return 0 - 1
  }
  errWord = 0
  return rc
}

// The errno of the call that just failed. Positive, matching the Darwin twin.
function lastErr(): int {
  return int(errWord)
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

// The kernel's `sockaddr_in` size — the `socklen_t` every call here passes.
export @symbol("bit_rt_port_net_sock_addr_len") function netSockAddrLen(): int {
  return saLen
}

// Lay out a `sockaddr_in` for `ip[0..4]` and `port` in the region at `sa`, which
// must hold `netSockAddrLen()` bytes. `sin_zero` is cleared: the kernel does not
// read it, but a stale eight bytes from a previous call would make an address
// comparison in a caller answer wrongly.
export @symbol("bit_rt_port_net_fill_sock_addr") function netFillSockAddr(sa: *u8, ip: *u8, port: int) {
  let k = 0
  while (k < saLen) {
    putU8(sa, k, 0)
    k = k + 1
  }
  // SIXTEEN BITS, LITTLE-ENDIAN, AT OFFSET 0 — the one line in this file that a
  // reader copying from the Darwin twin would get wrong, because there it is an
  // 8-bit length followed by an 8-bit family.
  putU16Le(sa, saFamilyOff, afInet())
  putU16Be(sa, saPortOff, port)
  let j = 0
  while (j < 4) {
    putU8(sa, saAddrOff + j, getU8(ip, j))
    j = j + 1
  }
}

// The port of a `sockaddr_in`, host byte order.
export @symbol("bit_rt_port_net_sock_addr_port") function netSockAddrPort(sa: *u8): int {
  return getU16Be(sa, saPortOff)
}

// The address family of a `sockaddr_in`, read at THIS platform's offset.
//
// EXISTS TO MAKE THE ONE REAL LAYOUT DIFFERENCE OBSERVABLE, and it was added
// because mutation proved it was not on the Darwin side. Linux puts a 16-bit
// family at offset 0; Darwin puts an 8-bit `sin_len` there and the family at 1.
// Every other readback the tests perform (`port`, `octets`) lives at an offset
// that difference does not touch, so without this accessor the layout the
// core/provider split exists FOR was guarded by nothing.
//
// Reads only the low byte, which is sufficient and is what keeps this twin
// textually parallel: AF_INET is 2, and on a little-endian target the low byte
// of the 16-bit family is byte 0 — the same byte the Darwin twin reads at its
// own offset. Every target this runtime supports is little-endian.
export @symbol("bit_rt_port_net_sock_addr_family") function netSockAddrFamily(sa: *u8): int {
  return getU8(sa, saFamilyOff)
}

// The four address octets of a `sockaddr_in`, in wire order, written to `out`.
export @symbol("bit_rt_port_net_sock_addr_octets") function netSockAddrOctets(sa: *u8, out: *u8) {
  let j = 0
  while (j < 4) {
    putU8(out, j, getU8(sa, saAddrOff + j))
    j = j + 1
  }
}

// ---------------------------------------------------------------------------
// Raw calls
// ---------------------------------------------------------------------------

// A non-blocking socket. Returns a negative value on failure.
export @symbol("bit_rt_port_net_sys_socket") function netSysSocket(dgram: bool): int {
  let ty = sockStream()
  if (dgram) {
    ty = sockDgram()
  }
  // NONBLOCK AT CREATION: one syscall, and NO window in which the socket is
  // blocking. Darwin has no such flag, hence the `fcntl` in its twin.
  let flags = ty + sockNonBlock() + sockCloExec()
  let fd = sysRc(int(syscall(nrSocket(), i64(afInet()), i64(flags), 0)))
  if (fd < 0) {
    return 0 - 1
  }
  return fd
}

export @symbol("bit_rt_port_net_set_non_block") function netSetNonBlock(fd: int): bool {
  let flags = sysRc(int(syscall(nrFcntl(), i64(fd), i64(fGetFl()), 0)))
  if (flags < 0) {
    return false
  }
  // Bit-or spelled as an add guarded by a test: the flag is either already set,
  // in which case adding it again would corrupt an unrelated bit, or it is not.
  let want = flags
  if (flags / oNonBlock() % 2 == 0) {
    want = flags + oNonBlock()
  }
  return sysRc(int(syscall(nrFcntl(), i64(fd), i64(fSetFl()), i64(want)))) >= 0
}

export @symbol("bit_rt_port_net_close") function netClose(fd: int) {
  let rc = int(syscall(nrClose(), i64(fd)))
}

export @symbol("bit_rt_port_net_sys_bind") function netSysBind(fd: int, sa: *u8): bool {
  return sysRc(int(syscall(nrBind(), i64(fd), i64(int(sa)), i64(saLen)))) >= 0
}

export @symbol("bit_rt_port_net_sys_listen") function netSysListen(fd: int, backlog: int): bool {
  return sysRc(int(syscall(nrListen(), i64(fd), i64(backlog)))) >= 0
}

// SO_REUSEADDR so a restart is not refused while the previous socket's
// connections sit in TIME_WAIT. Deliberately NOT SO_REUSEPORT, which would let a
// second process silently steal traffic from this one.
export @symbol("bit_rt_port_net_set_reuse_addr") function netSetReuseAddr(fd: int): bool {
  putU32Le(optBytes(), 0, 1)
  return sysRc(int(syscall(nrSetSockOpt(), i64(fd), i64(solSocket()), i64(soReuseAddr()),
                           i64(int(optBytes())), i64(4)))) >= 0
}

// The pending error on a socket, as SO_ERROR. Zero means the operation
// succeeded; a negative return means the query itself failed.
export @symbol("bit_rt_port_net_socket_error") function netSocketError(fd: int): int {
  putU32Le(optBytes(), 0, 0)
  putU32Le(lenBytes(), 0, 4)
  if (sysRc(int(syscall(nrGetSockOpt(), i64(fd), i64(solSocket()), i64(soError()),
                        i64(int(optBytes())), i64(int(lenBytes()))))) < 0) {
    return 0 - 1
  }
  return getU32Le(optBytes(), 0)
}

// ---------------------------------------------------------------------------
// Parking on readiness
// ---------------------------------------------------------------------------

// Park the calling green thread until `fd` is ready for `interest`. Returns true
// when the caller was parked and has since been woken, i.e. the fd is ready.
//
// FALSE MEANS "THERE WAS NOBODY TO PARK ON", NOT "THE FD IS READY". A caller off
// a green stack — a driver program, or any code the ported scheduler is not
// running — has no task to suspend, so this reports that and the retry loops
// below spin instead. That is why they carry TWO bounds: `netMaxStalls` for a
// parked wait, which is the Zig's, and `netMaxSpins` for the unscheduled one,
// which the Zig has no equivalent of because it has no unscheduled caller.
//
// THE ARM/REGISTER/PARK ORDER IS THE PROTOCOL, NOT A PREFERENCE. `sched.zig`
// registers from a `ParkFn` on the worker's side of the switch; that is a call
// through a function value and `@nosplit` rejects it, so this must register
// BEFORE parking and close the resulting window with `schedParkArm`. See
// ../../sched.bit's "arming a park" section for the state machine and
// tests/stress/netpark for the property.
export @symbol("bit_rt_port_net_await_ready") function netAwaitReady(fd: int, interest: int): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  let wAddr = *(t + taskWorker)
  if (wAddr == 0) {
    return false
  }
  let s = taskAt(*(taskAt(wAddr) + wkSched))
  let pollFd = *(s + scPollFd)
  if (pollFd == 0) {
    return false
  }
  if (!schedParkArm()) {
    return false
  }
  if (!pollRegister(pollFd, fd, interest, taskAddr)) {
    // Nothing will ever wake this task, so it must not park. `schedParkDisarm`
    // also consumes a wake that a drain handed over while we were registering —
    // its answer is ignored here because either way the caller keeps running.
    let owed = schedParkDisarm()
    return false
  }
  schedPark()
  return true
}

// ---------------------------------------------------------------------------
// TCP
// ---------------------------------------------------------------------------

// A listening socket bound to `host:port`. `port == 0` lets the kernel pick one;
// recover it with `netLocalPort`. Returns a negative value on failure.
export @symbol("bit_rt_port_net_listen_tcp") function netListenTcp(host: *u8, hostLen: int, port: int, backlog: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netSetReuseAddr(fd)) {
    netClose(fd)
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    netClose(fd)
    return 0 - 1
  }
  if (!netSysListen(fd, backlog)) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// The port `fd` is actually bound to — the whole point of binding to port 0.
export @symbol("bit_rt_port_net_local_port") function netLocalPort(fd: int): int {
  putU32Le(lenBytes(), 0, saLen)
  if (sysRc(int(syscall(nrGetSockName(), i64(fd), i64(int(saBytes())),
                        i64(int(lenBytes()))))) < 0) {
    return 0 - 1
  }
  return netSockAddrPort(saBytes())
}

// Accept one connection, parking until a peer arrives. The returned socket is
// non-blocking, like every socket here. Negative on failure.
export @symbol("bit_rt_port_net_accept_tcp") function netAcceptTcp(lfd: int): int {
  let stalls = 0
  let spins = 0
  // Two bounds, both static (Power of 10): `stalls` counts parked waits and
  // `spins` counts unscheduled retries, and neither can run away.
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // `accept4` WITH THE FLAGS, not `accept` plus an `fcntl`: the accepted
    // socket is non-blocking and close-on-exec from the instant it exists.
    // Darwin has no `accept4`, so its twin does the two-step.
    let fd = sysRc(int(syscall(nrAccept4(), i64(lfd), 0, 0,
                               i64(sockNonBlock() + sockCloExec()))))
    if (fd >= 0) {
      return fd
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(lfd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      // A peer that vanished between the poll and the accept is routine, and
      // not this listener's problem. EINTR likewise.
      if (e != eConnAborted() && e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Connect to `host:port`, parking until the handshake finishes.
//
// A non-blocking `connect` reports EINPROGRESS and finishes in the background.
// The socket then becomes WRITABLE whether it succeeded or failed, so the
// outcome has to be read back from SO_ERROR. Skipping that read is the classic
// bug: a refused connection looks connected until some later `write` fails far
// away from the cause.
export @symbol("bit_rt_port_net_dial_tcp") function netDialTcp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(false)
  if (fd < 0) {
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  let rc = sysRc(int(syscall(nrConnect(), i64(fd), i64(int(saBytes())), i64(saLen))))
  if (rc >= 0) {
    return fd
  }
  let e = lastErr()
  if (e != eInProgress() && e != eAgain() && e != eIntr()) {
    netClose(fd)
    return 0 - 1
  }
  let spins = 0
  // Bounded (Power of 10). One parked wait suffices when there is a scheduler;
  // the loop exists for the unscheduled caller, which must poll for completion.
  //
  // `SO_ERROR == 0` DOES NOT MEAN CONNECTED — it means "no error HAS BEEN
  // RECORDED YET", and immediately after EINPROGRESS that is the state of every
  // handshake, including the ones about to be refused. Reading it before the
  // handshake finishes therefore reports success for a connection that has not
  // happened, which is the very bug the comment above warns about, one step
  // further in.
  //
  // FOUND ON THE DARWIN TWIN (#1462) AND FIXED HERE TOO, BUT THE TWO ARE NOT
  // EQUALLY EXPOSED, so the same code was failing differently on each platform.
  // Darwin's `fcntl` never actually applied `O_NONBLOCK` (a variadic-ABI bug),
  // so `connect` completed synchronously there and this loop was DEAD CODE. This
  // provider takes `SOCK_NONBLOCK` at creation and has always been genuinely
  // non-blocking, so here the loop runs and the early read is LIVE — it is a
  // race that loopback usually wins (a refused connect records ECONNREFUSED
  // almost at once) and therefore usually looks correct. Same defect, opposite
  // reasons for going unnoticed.
  //
  // So completion is established FIRST, by re-issuing `connect` — the way to ask
  // a pending handshake how it went that needs no poller, which matters because
  // the unscheduled caller has none:
  //
  //   EALREADY / EINPROGRESS   still running; keep waiting
  //   EISCONN (or success)     finished and connected
  //   anything else            the deferred failure, reported here
  //
  // SO_ERROR is then read on the completed socket, where it IS meaningful.
  while (spins < netMaxSpins) {
    if (netAwaitReady(fd, pollWrite)) {
      spins = netMaxSpins
    } else {
      spins = spins + 1
    }
    // THE ADDRESS IS REBUILT EVERY ATTEMPT, NOT REUSED. `saBytes()`/`ipBytes()`
    // are module scratch shared by every entry point here, and `netAwaitReady`
    // above PARKS the calling green thread — so another task can run a
    // `netListenTcp`/`netBindUdp`/`netDialTcp` of its own and leave its address
    // in the buffer. Reconnecting to whatever it left would be a silent
    // cross-connection.
    if (!netParseIpv4(host, hostLen, ip)) {
      netClose(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes(), ip, port)
    let rc2 = sysRc(int(syscall(nrConnect(), i64(fd), i64(int(saBytes())), i64(saLen))))
    let ce = lastErr()
    if (rc2 >= 0 || ce == eIsConn()) {
      // Connected as far as the handshake is concerned; SO_ERROR is now the
      // authority on whether it succeeded.
      if (netSocketError(fd) != 0) {
        netClose(fd)
        return 0 - 1
      }
      return fd
    }
    if (ce != eAlready() && ce != eInProgress() && ce != eIntr()) {
      netClose(fd)
      return 0 - 1
    }
  }
  netClose(fd)
  return 0 - 1
}

// Read up to `cap` bytes into `buf`, parking until some arrive. `0` means the
// peer closed: an orderly end of stream, not an error. Negative on failure.
export @symbol("bit_rt_port_net_read_sock") function netReadSock(fd: int, buf: *u8, cap: int): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let n = sysRc(int(syscall(nrRead(), i64(fd), i64(int(buf)), i64(cap))))
    if (n >= 0) {
      return n
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e == eIntr()) {
        spins = spins + 1
      } else {
        // A reset peer has no more bytes for us. Report end of stream so a
        // caller's read loop terminates instead of erroring.
        if (e == eConnReset()) {
          return 0
        }
        return 0 - 1
      }
    }
  }
  return 0 - 1
}

// Write all `n` bytes of `buf`, parking whenever the send buffer is full. A
// short write is normal on a socket and is not an error — hence the loop.
export @symbol("bit_rt_port_net_write_sock") function netWriteSock(fd: int, buf: *u8, n: int): int {
  let off = 0
  let stalls = 0
  let spins = 0
  while (off < n && stalls < netMaxStalls && spins < netMaxSpins) {
    let wrote = sysRc(int(syscall(nrWrite(), i64(fd), i64(int(buf + off)), i64(n - off))))
    if (wrote > 0) {
      off = off + wrote
      // PROGRESS RESETS THE STALL BOUND: the bound is on CONSECUTIVE stalls, not
      // on writes, so a large transfer that legitimately blocks many times is
      // not mistaken for a wedged socket.
      stalls = 0
      spins = 0
    } else {
      if (wrote == 0) {
        return 0 - 1
      }
      let e = lastErr()
      if (e == eAgain()) {
        if (netAwaitReady(fd, pollWrite)) {
          stalls = stalls + 1
        } else {
          spins = spins + 1
        }
      } else {
        if (e == eIntr()) {
          spins = spins + 1
        } else {
          return 0 - 1
        }
      }
    }
  }
  if (off < n) {
    return 0 - 1
  }
  return off
}

// ---------------------------------------------------------------------------
// UDP
// ---------------------------------------------------------------------------

// A datagram socket bound to `host:port`. `port == 0` lets the kernel pick one
// (recover it with `netLocalPort`, exactly like a TCP listener). Connectionless:
// unlike TCP there is no listen/accept — send and receive straight off the fd.
export @symbol("bit_rt_port_net_bind_udp") function netBindUdp(host: *u8, hostLen: int, port: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(true)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netSetReuseAddr(fd)) {
    netClose(fd)
    return 0 - 1
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// Send one datagram to `host:port`. Parks on writability if the socket buffer is
// momentarily full. A DATAGRAM IS ALL-OR-NOTHING: a partial send is an error,
// never a short count, so there is no write loop as there is for TCP.
export @symbol("bit_rt_port_net_send_to") function netSendTo(fd: int, host: *u8, hostLen: int, port: int,
                          data: *u8, n: int): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  netFillSockAddr(saBytes2(), ip, port)
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    let sent = sysRc(int(syscall(nrSendTo(), i64(fd), i64(int(data)), i64(n), 0,
                                 i64(int(saBytes2())), i64(saLen))))
    if (sent >= 0) {
      return sent
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollWrite)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// Receive one datagram into `buf`, parking until one arrives, and write the
// sender's address into `peer` (which must hold `netSockAddrLen()` bytes, or be
// nil to discard it). Returns the byte count: A ZERO-LENGTH DATAGRAM IS LEGAL,
// so 0 is NOT end-of-stream here — UDP has no stream to end.
//
// The out-parameter is `peer`, not `from`: `from` is a KEYWORD (import ... from)
// and is rejected as an identifier.
export @symbol("bit_rt_port_net_recv_from") function netRecvFrom(fd: int, buf: *u8, cap: int, peer: *u8): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // `salen` is IN/OUT and must be re-armed on EVERY attempt: the kernel writes
    // the address size back into it, so a retry that reused the previous value
    // would be passing whatever the last call left there.
    putU32Le(lenBytes(), 0, saLen)
    let got = sysRc(int(syscall(nrRecvFrom(), i64(fd), i64(int(buf)), i64(cap), 0,
                                i64(int(saBytes())), i64(int(lenBytes())))))
    if (got >= 0) {
      if (int(peer) != 0) {
        let k = 0
        while (k < saLen) {
          putU8(peer, k, getU8(saBytes(), k))
          k = k + 1
        }
      }
      return got
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead)) {
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// ---------------------------------------------------------------------------
// DNS
// ---------------------------------------------------------------------------

// A BLOCKING socket with SO_RCVTIMEO, ON PURPOSE, matching the Zig. DNS is an
// occasional millisecond cost, so a bounded receive timeout buys a real error on
// packet loss without putting timer-driven wakes on the poller. It blocks the
// calling worker for up to `netDnsTimeoutMs` on a lost packet; move it onto the
// poller if resolution ever sits on a hot path.
export @symbol("bit_rt_port_net_dns_socket") function netDnsSocket(): int {
  let fd = sysRc(int(syscall(nrSocket(), i64(afInet()),
                             i64(sockDgram() + sockCloExec()), 0)))
  if (fd < 0) {
    return 0 - 1
  }
  // BOTH fields are 64 bits here, unlike Darwin's 32-bit `tv_usec`.
  let k = 0
  while (k < tvSize) {
    putU8(tvBytes(), k, 0)
    k = k + 1
  }
  putU64Le(tvBytes(), tvSecOff, netDnsTimeoutMs / 1000)
  putU64Le(tvBytes(), tvUsecOff, netDnsTimeoutMs % 1000 * 1000)
  if (sysRc(int(syscall(nrSetSockOpt(), i64(fd), i64(solSocket()), i64(soRcvTimeo()),
                        i64(int(tvBytes())), i64(tvSize)))) < 0) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// The receive timeout configured on `fd`, in milliseconds, or -1 if the query
// fails. Zero means no timeout is set.
//
// EXISTS TO BE ASSERTED ON, and deliberately so — the same argument
// runtime/park/linux's `parkTimerSlackNs` makes. `struct timeval` is one of the
// three real layout differences between this file and its twin (`tv_usec` is 32
// bits on Darwin and 64 on Linux), and the ONLY behavioural guard for getting it
// wrong is that a DNS query hangs instead of timing out. A guard whose failure
// mode is a hang is not a guard: the harness reports a wedged suite rather than
// a verdict, which is the trap this project has already hit once. Reading the
// value back cannot hang and cannot flake.
export @symbol("bit_rt_port_net_rcv_timeo_ms") function netRcvTimeoMs(fd: int): int {
  let k = 0
  while (k < tvSize) {
    putU8(tvBytes(), k, 0)
    k = k + 1
  }
  putU32Le(lenBytes(), 0, tvSize)
  if (sysRc(int(syscall(nrGetSockOpt(), i64(fd), i64(solSocket()), i64(soRcvTimeo()),
                        i64(int(tvBytes())), i64(int(lenBytes()))))) < 0) {
    return 0 - 1
  }
  // BOTH fields are 64 bits here.
  return getU64Le(tvBytes(), tvSecOff) * 1000 + getU64Le(tvBytes(), tvUsecOff) / 1000
}

// Resolve `host` to an IPv4 address, written to `out`. A dotted quad passes
// straight through; a hostname is queried against the nameserver at `ns[0..4]`.
//
// THE NAMESERVER IS A PARAMETER, WHERE THE ZIG READS /etc/resolv.conf ITSELF.
// The parse of that file is `netFirstNameserver` in ../net.bit, split out so it
// is testable without a filesystem; reading the file is a platform call, and
// keeping it out of here means `netResolve` can be pointed at a nameserver in
// the same process — which is the only way to test a resolver without depending
// on the network being up.
export @symbol("bit_rt_port_net_resolve") function netResolve(host: *u8, hostLen: int, ns: *u8, out: *u8): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let query = dnsBytes()
  let qlen = netBuildQuery(query, netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  let fd = netDnsSocket()
  if (fd < 0) {
    return false
  }
  let reply = dnsBytes() + netMaxDnsMsg
  let attempt = 0
  // Laid out INSIDE the loop rather than once before it: `saBuf2` is shared with
  // `netSendTo`, so anything that ran in between may have overwritten it. The
  // first draft filled it at the END of the body, which left the FIRST send
  // aimed at whatever the previous caller had left there.
  // Bounded retransmits (Power of 10): a lost query is retried a fixed number
  // of times and then reported, never waited on forever.
  while (attempt < netDnsRetries) {
    netFillSockAddr(saBytes2(), ns, 53)
    if (sysRc(int(syscall(nrSendTo(), i64(fd), i64(int(query)), i64(qlen), 0,
                          i64(int(saBytes2())), i64(saLen)))) < 0) {
      attempt = attempt + 1
    } else {
      let got = sysRc(int(syscall(nrRecvFrom(), i64(fd), i64(int(reply)),
                                  i64(netMaxDnsMsg), 0, 0, 0)))
      if (got < 0) {
        // Timed out or interrupted: retransmit. Anything else is fatal.
        let e = lastErr()
        if (e != eAgain() && e != eIntr()) {
          netClose(fd)
          return false
        }
        attempt = attempt + 1
      } else {
        if (netParseAnswer(reply, got, netDnsId, out)) {
          netClose(fd)
          return true
        }
        // Malformed, or an answer with no A record: retry.
        attempt = attempt + 1
      }
    }
  }
  netClose(fd)
  return false
}
