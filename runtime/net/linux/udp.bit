// The UDP and DNS sections of the Linux socket provider, split out of
// ./sock.bit (#1503). Sibling file, so the same module: the syscall numbers,
// kernel-class constants, scratch buffers, `sysRc`/`lastErr` and
// `netAwaitReady` it uses all live there and need no import in either
// direction.
//
// DNS RIDES ALONG WITH UDP RATHER THAN GETTING ITS OWN FILE, AND THE REASON IS
// LOAD ORDER, NOT TASTE. A module's files are concatenated in BYTEWISE SORTED
// name order (see compiler/project.bit), and this compiler's inliner only
// inlines a callee it has already lowered — so a `dns.bit` would sort BEFORE
// `sock.bit` and its resolver would emit CALLS to `tvBytes`/`putU64Le` where
// the pre-split file inlined them. Same behaviour, different machine code, on a
// provider that no native macOS build ever compiles. Keeping DNS here holds the
// declaration order the single file had — sock, tcp, udp — which makes the
// emitted object BYTE-IDENTICAL to the pre-split one on both Linux arches, and
// that byte-identity is the only strong evidence this move changed nothing.

// ---------------------------------------------------------------------------
// UDP
// ---------------------------------------------------------------------------

// A datagram socket bound to `host:port`. `port == 0` lets the kernel pick one
// (recover it with `netLocalPort`, exactly like a TCP listener). Connectionless:
// unlike TCP there is no listen/accept — send and receive straight off the fd.

// #2343: same convention as `netListenTcp` (./tcp.bit) — a failure after a
// syscall returns `0 - lastErr()`, captured immediately on the failing
// branch, before `netClose` runs.
export @symbol("bit_rt_port_net_bind_udp") @nosplit fn netBindUdp(
  host: *u8,
  hostLen: int,
  port: int,
): int {
  let ip = ipBytes()
  if (!netParseIpv4(host, hostLen, ip)) {
    return 0 - 1
  }
  let fd = netSysSocket(true)
  if (fd < 0) {
    return 0 - lastErr()
  }
  if (!netSetReuseAddr(fd)) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  netFillSockAddr(saBytes(), ip, port)
  if (!netSysBind(fd, saBytes())) {
    let e = lastErr()
    netClose(fd)
    return 0 - e
  }
  return fd
}

// Send one datagram to `host:port`. Parks on writability if the socket buffer is
// momentarily full. A DATAGRAM IS ALL-OR-NOTHING: a partial send is an error,
// never a short count, so there is no write loop as there is for TCP.
//
// #5886: kept as ONE function (not a wrapper/loop split) so it stays at 6
// params -- this function's existing, pre-#5886 baseline finding on `main`,
// not a new 7-param one a split (`fd`+`gen`+4 address fields+2 payload
// fields) would add.
export @symbol("bit_rt_port_net_send_to") fn netSendTo(
  fd: int, host: *u8, hostLen: int, port: int,
  data: *u8, n: int,
): int {
  let gen = *netFdGenAddr(fd)
  if (!netFdAcquire(fd, gen)) {
    return 0 - 1
  }
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // THE ADDRESS IS REBUILT EVERY ATTEMPT, NOT REUSED — see `tcp.bit`'s
    // `netDialTcp` for the identical comment. `ipBytes()`/`saBytes2()` are
    // per-worker (#3273): `netAwaitReady` below parks, so a retry can resume
    // on a different worker, and re-deriving+refilling here, with no park
    // between the fill and the `sendto` call, keeps the fill and the syscall
    // on the same slot.
    let ip = ipBytes()
    if (!netParseIpv4(host, hostLen, ip)) {
      netFdRelease(fd)
      return 0 - 1
    }
    netFillSockAddr(saBytes2(), ip, port)
    let sent = sysRc(
      int(
        syscall(
          sysSendTo(), i64(fd), i64(int(data)), i64(n), 0,
          i64(int(saBytes2())), i64(saLen),
        ),
      ),
    )
    if (sent >= 0) {
      netFdRelease(fd)
      return sent
    }
    if (lastErr() == eIntr()) {
      spins = spins + 1
    } else if (lastErr() != eAgain()) {
      netFdRelease(fd)
      return 0 - 1
    } else if (!netAwaitReady(fd, pollWrite, gen)) {
      spins = spins + 1
    } else if (pdFdClosing(fd)) {
      netFdRelease(fd)
      return 0 - 1
    } else {
      stalls = stalls + 1
    }
  }
  netFdRelease(fd)
  return 0 - 1
}

// Receive one datagram into `buf`, parking until one arrives, and write the
// sender's address into `peer` (which must hold `netSockAddrLen()` bytes, or be
// nil to discard it). Returns the byte count: A ZERO-LENGTH DATAGRAM IS LEGAL,
// so 0 is NOT end-of-stream here — UDP has no stream to end.
//
// The out-parameter is `peer`, not `from`: `from` is a KEYWORD (import ... from)
// and is rejected as an identifier.
export @symbol("bit_rt_port_net_recv_from") fn netRecvFrom(
  fd: int,
  buf: *u8,
  bufCap: int,
  peer: *u8,
): int {
  let gen = *netFdGenAddr(fd)
  if (!netFdAcquire(fd, gen)) {
    return 0 - 1
  }
  let got = netRecvFromLoop(fd, gen, buf, bufCap, peer)
  netFdRelease(fd)
  return got
}

fn netRecvFromLoop(fd: int, gen: int, buf: *u8, bufCap: int, peer: *u8): int {
  let stalls = 0
  let spins = 0
  while (stalls < netMaxStalls && spins < netMaxSpins) {
    // `salen` is IN/OUT and must be re-armed on EVERY attempt: the kernel writes
    // the address size back into it, so a retry that reused the previous value
    // would be passing whatever the last call left there.
    //
    // This fill (`lenBytes()`), the syscall's own kernel write into
    // `saBytes()`, and the copy-out loop below all happen inside ONE
    // iteration with no park between them, so all three land on the SAME
    // per-worker slot (#3273) regardless of which worker this task is on —
    // the property that makes `saBytes()`/`lenBytes()` safe to call fresh at
    // each use rather than caching a pointer across the retry loop's park.
    putU32Le(lenBytes(), 0, saLen)
    let got = sysRc(
      int(
        syscall(
          sysRecvFrom(), i64(fd), i64(int(buf)), i64(bufCap), 0,
          i64(int(saBytes())), i64(int(lenBytes())),
        ),
      ),
    )
    if (got >= 0) {
      if (int(peer) != 0) {
        let k = 0
        while (k < saLen) {
          putU8(peer, k, getU8(saBytes(), k))
          k = k + 1
        }
      }
      return got
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netAwaitReady(fd, pollRead, gen)) {
        if (pdFdClosing(fd)) {
          return 0 - 1
        }
        stalls = stalls + 1
      } else {
        spins = spins + 1
      }
    } else {
      if (e != eIntr()) {
        return 0 - 1
      }
      spins = spins + 1
    }
  }
  return 0 - 1
}

// ---------------------------------------------------------------------------
// DNS
// ---------------------------------------------------------------------------

// DNS I/O rides the same non-blocking socket + netpoller path TCP and UDP
// use (#6341). A lookup used to be a raw blocking `sendto`/`recvfrom` with
// SO_RCVTIMEO inside `@nosplit` code: the OS thread sat in the kernel for up
// to the attempt's window with no safepoint, so every stop-the-world
// attempted meanwhile stalled, and the thread could do nothing else. Now the
// resolving task parks on readability with the attempt's deadline
// (`netAwaitReadyOrDeadline`, ./tcpdeadline.bit), the OS thread returns to the
// scheduler, and the collector sees an ordinary parked task.
//
// The socket is registered with `pdOpen` (`netSysSocketFamily`, ./sock.bit)
// and released with `netClose` like every other socket. That also retires the
// raw-close workaround #6338 needed for its unregistered fd: `netClose`'s
// closing/closed bits are cleared by the next `pdOpen` on the same fd number.
//
// NO RAW SCRATCH POINTER IS HELD ACROSS A PARK. `dnsBytes()`/`saBytes2()`/
// `sa6Bytes()` are per-worker slots, and a task may resume on another worker
// (or share its old worker with a second resolving task) after a park, so each
// is re-derived at the point of use: the query is rebuilt and sent, and the
// reply parsed, with no park between the buffer write and the syscall or
// parse that consumes it.

// A non-blocking datagram socket for `family` (`afInet()` or `afInet6()`,
// #6338), registered with the poller, or -1.
@nosplit fn netDnsSocketFamily(family: int): int {
  return netSysSocketFamily(family, true)
}

export @symbol("bit_rt_port_net_dns_socket") @nosplit fn netDnsSocket(): int {
  return netDnsSocketFamily(afInet())
}

// #6338: the IPv6 twin, used when a nameserver's own address is IPv6 (e.g.
// Tailscale MagicDNS's `fd7a:...` entry). Still only ever asks for an A
// record — `../net.bit`'s DNS section header is explicit that AAAA answers
// are out of scope — this only changes which TRANSPORT reaches the server.
export @symbol("bit_rt_port_net_dns_socket6") @nosplit fn netDnsSocket6(): int {
  return netDnsSocketFamily(afInet6())
}

// Points the datagram socket `fd` at the nameserver `ns` (four bytes, or
// sixteen when `v6`) on `port`. A UDP `connect` is a local bookkeeping call
// that never blocks, and it means every later send needs no address (so none
// is held across a park) and the kernel drops replies from any other source.
@nosplit fn netDnsConnect(fd: int, v6: bool, ns: *u8, port: int): bool {
  if (v6) {
    netFillSockAddr6(sa6Bytes(), ns, port)
    return sysRc(int(syscall(sysConnect(), i64(fd), i64(int(sa6Bytes())), i64(sa6Len)))) >= 0
  }
  netFillSockAddr(saBytes2(), ns, port)
  return sysRc(int(syscall(sysConnect(), i64(fd), i64(int(saBytes2())), i64(saLen)))) >= 0
}

// Builds the query for `host` in this worker's `dnsBytes()` slot and sends it
// on the connected `fd`. False when the name does not fit the wire format or
// the kernel refuses the datagram.
@nosplit fn netDnsSend(fd: int, host: *u8, hostLen: int, qtype: int): bool {
  let query = dnsBytes()
  let qlen = netBuildQuery(query, netMaxDnsMsg, host, hostLen, netDnsId)
  if (qlen < 0) {
    return false
  }
  // The query is built as A; its QTYPE is the last four bytes' first two.
  netWriteU16Be(query, qlen - 4, qtype)
  return sysRc(int(syscall(sysSendTo(), i64(fd), i64(int(query)), i64(qlen), 0, 0, 0))) >= 0
}

// Waits for readability or the attempt's deadline. Returns the slice for the
// next tick: the parked path leaves it alone, and the fallback (an unscheduled
// caller, or no poller bound) sleeps or re-tries one slice, the same fallback
// `netReadSockDeadlineLoop` (./tcpdeadline.bit) uses.
@nosplit fn netDnsWait(fd: int, gen: int, deadline: int, slice: int): int {
  if (netAwaitReadyOrDeadline(fd, pollRead, gen, deadline)) {
    return slice
  }
  let _ = netAwaitDeadlineTick(deadline, slice)
  return netDeadlineNextSliceNs(slice)
}

// One datagram into this worker's reply slot (`dnsBytes() + netMaxDnsMsg`),
// waiting at most `timeoutMs`. Returns its length, `netDeadlineTimedOut`
// when nothing arrived in time, or -1 on a hard error. Bounded by
// `netDeadlineMaxPolls` (Power of 10); the monotonic deadline is what ends a
// real wait.
@nosplit fn netDnsRecv(fd: int, gen: int, timeoutMs: int): int {
  let deadline = netClockNowNs() + timeoutMs * 1000000
  let slice = netDeadlineFastPollNs
  let polls = 0
  while (polls < netDeadlineMaxPolls) {
    polls = polls + 1
    let got = sysRc(
      int(
        syscall(
          sysRecvFrom(), i64(fd), i64(int(dnsBytes() + netMaxDnsMsg)),
          i64(netMaxDnsMsg), 0, 0, 0,
        ),
      ),
    )
    if (got >= 0) {
      return got
    }
    let e = lastErr()
    if (e == eAgain()) {
      if (netClockNowNs() >= deadline) {
        return netDeadlineTimedOut
      }
      slice = netDnsWait(fd, gen, deadline, slice)
    } else if (e != eIntr()) {
      return 0 - 1
    }
  }
  return netDeadlineTimedOut
}

// ONE query/reply exchange over the connected `fd`, waiting at most the window
// `ns`'s block carries (`netNsTimeoutOff`). A failed send, a lost or late reply,
// a malformed answer (or one with no A record) and a hard receive error, such as
// the nameserver's port refusing the datagram, each end it with false. Retrying
// is the caller's: `netResolvePasses` (./netabi.bit) goes round the whole
// nameserver list once per attempt, so a dead first server costs one window
// before the second is asked (resolv.conf(5) `attempts`, #6350).
@nosplit fn netDnsAttempt(fd: int, host: *u8, hostLen: int, out: *u8, ns: *u8): bool {
  let gen = *netFdGenAddr(fd)
  if (!netDnsSend(fd, host, hostLen, 1)) {
    return false
  }
  let got = netDnsRecv(fd, gen, getU64Le(ns, netNsTimeoutOff))
  return got >= 0 && netParseAnswer(dnsBytes() + netMaxDnsMsg, got, netDnsId, out)
}

// A datagram socket connected to the nameserver, or -1 when the name cannot
// be encoded (checked first, so no socket is opened for it) or the socket
// cannot be made.
@nosplit fn netDnsOpen(host: *u8, hostLen: int, ns: *u8, port: int, v6: bool): int {
  if (netBuildQuery(dnsBytes(), netMaxDnsMsg, host, hostLen, netDnsId) < 0) {
    return 0 - 1
  }
  let family = afInet()
  if (v6) {
    family = afInet6()
  }
  let fd = netDnsSocketFamily(family)
  if (fd < 0) {
    return 0 - 1
  }
  if (!netDnsConnect(fd, v6, ns, port)) {
    netClose(fd)
    return 0 - 1
  }
  return fd
}

// Runs one attempt on `fd` and always closes it.
@nosplit fn netDnsFinish(fd: int, host: *u8, hostLen: int, out: *u8, ns: *u8): bool {
  let ok = netDnsAttempt(fd, host, hostLen, out, ns)
  netClose(fd)
  return ok
}

// Resolve `host` to an IPv4 address, written to `out`. A dotted quad passes
// straight through; a hostname is queried against the nameserver at
// `ns[0..4]:port`, ONE attempt: `ns` is a resolve block (`netNsBlockBytes`,
// ../../net) whose window `std/net` chose bounds the wait, parked on the
// poller. The attempt count is `netResolvePasses`'s.
//
// THE NAMESERVER IS A PARAMETER RATHER THAN READ FROM /etc/resolv.conf HERE.
// The parse of that file is `netFirstNameserver` in ../net.bit, split out so it
// is testable without a filesystem; reading the file is a platform call, and
// keeping it out of here means `netResolveHost` can be pointed at a nameserver in
// the same process — which is the only way to test a resolver without depending
// on the network being up.
//
// `port` IS ALSO A PARAMETER, NOT A LITERAL 53, for the same testability
// reason (#6338): every real nameserver speaks port 53, which the ONE
// caller (`../netabi.bit`'s `netResolveConf`) passes, but binding port 53
// for a local test stub needs root -- a stub would point this at an
// ephemeral port instead (see the Darwin twin's own stress test).
export @symbol("bit_rt_port_net_resolve") @nosplit fn netResolveHost(
  host: *u8,
  hostLen: int,
  ns: *u8,
  port: int,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let fd = netDnsOpen(host, hostLen, ns, port, false)
  return fd >= 0 && netDnsFinish(fd, host, hostLen, out, ns)
}

// #6338: `netResolveHost`'s IPv6 twin -- `ns` is sixteen bytes (an address
// `../dns.bit`'s `netParseIpv6`, via `../netabi.bit`'s `netResolveConf`,
// already parsed) rather than four, and the socket dials AF_INET6/
// `sockaddr_in6`. Still an A-record query: this only changes which
// transport reaches the nameserver, not what it is asked for.
export @symbol("bit_rt_port_net_resolve6") @nosplit fn netResolveHost6(
  host: *u8,
  hostLen: int,
  ns: *u8,
  port: int,
  out: *u8,
): bool {
  if (netParseIpv4(host, hostLen, out)) {
    return true
  }
  let fd = netDnsOpen(host, hostLen, ns, port, true)
  return fd >= 0 && netDnsFinish(fd, host, hostLen, out, ns)
}
