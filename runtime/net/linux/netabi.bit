// SEAM 1 of the runtime port (#1574, reshaped by #1600): the 12
// `bit_rt_net_*` ABI wrappers (ABI.md §12/§20) over the ported Linux socket
// engine. This is `runtime/root/`'s `bit_rt_net_*` block expressed in Bit —
// pure marshalling between the managed `string` boundary the compiler emits and
// the `*u8 + length` boundary the socket engine speaks.
//
// ---------------------------------------------------------------------------
// WHY THE WRAPPERS LIVE PER-PLATFORM NOW (io.bit / fs.bit shape, #1600)
// ---------------------------------------------------------------------------
//
// SEAM 1 first kept these wrappers in the platform-FREE parent (`net/netabi.bit`)
// and reached the socket engine (`net/linux`, `net/darwin`) by `extern function`.
// That is admissible on aarch64-macos, where an `extern` is a load-time dyld
// import, but a Linux `--emit-obj` REJECTS any `extern function` naming a symbol
// not already inside `libbitrt.a` (E0078, `rejectExternForTarget`) — and the
// socket engine, the very code the port defines, is not. Worse, the parent module
// is imported by `net/{linux,darwin}` (for `netParseIpv4` and friends), so a
// single such `extern` in the parent reddened the Linux build of the providers
// too. G3 (#1584) assembles `libbitrt.a` per module on both Linux triples, so it
// would have hit exactly this.
//
// The fix is the shape `root/{linux,darwin}/fs.bit` uses (#1606): the wrappers
// live IN each platform provider, where the socket engine functions
// (`bit_rt_port_net_*`) are ordinary module-scoped SIBLINGS reached by their Bit
// name — a local call, never an `extern` — and the platform-free glue is reached
// by ordinary `import` (a cross-module *call*, never E0078). Nothing here is an
// `extern`, so this compiles clean for a Linux `--emit-obj`.
//
// The marshalling body is duplicated with ../darwin/netabi.bit rather than shared,
// for the same reason fs.bit gives: the only thing that differs between the two is
// which socket engine the sibling names resolve to, and there is no platform-free
// home a wrapper-over-per-platform-sibling could live in without reintroducing the
// `extern`.
//
// ---------------------------------------------------------------------------
// PINS CARRY THE BARE ABI NAME
// ---------------------------------------------------------------------------
//
// These ARE the ABI symbols the RtFn lowering calls by fixed name
// (`bit_rt_net_listen` and the rest) — G2 (#1583) retired the old
// `runtime/root/`-owned duplicate definitions and dropped the `_root` infix.
// The net suites exercise these bodies directly.
//
// ---------------------------------------------------------------------------
// NO PATH TO A NET RtFn, SO NO PIN CYCLE
// ---------------------------------------------------------------------------
//
// A wrapper that reached the socket by calling the `netListen`/`netDial`/…
// BUILTINS would lower each to `ir.RtFn.net_*`, which codegen emits as a call to
// `bit_rt_net_*` — the very symbol being pinned — and after G2's rename that is
// self-recursion. This file never touches those builtins: it calls the
// port-internal socket functions (`netListenTcp`/…, pinned `bit_rt_port_net_*` by
// #1366), which are no RtFn's target. `./make test-rootpins` is the object-level
// proof, with `runtime/net/linux` in its module list.
//
// ---------------------------------------------------------------------------
// WHY THE BUFFERS HERE ARE MANAGED `[]i64`, NOT RAW `rtStrAlloc` ADDRESSES
// (#1668 — and THE COMMENT THIS REPLACES WAS WRONG)
// ---------------------------------------------------------------------------
//
// What stood here claimed: "`netAbiRead`/`netAbiUdpRecv` allocate, park in a
// socket call (a safepoint), then trim. The collector scans stacks
// CONSERVATIVELY (ABI.md §5), so the object address in a plain `int`/`*u8` local
// pins the object across the park."
//
// ABI.md §5 says the opposite of what that read it to say, and the difference is
// #1656 — an s0 that cost four G3 attempts. §5: "the running task's stack is
// walked PRECISELY (§4); every *other* registered task's stack is scanned
// conservatively". A runtime frame holding a GC object as a raw `int` is named
// by no stack map, so while this task is the RUNNING one the precise walk does
// not see it at all. The identical false premise was in
// `runtime/root/{darwin,linux}/io.bit` and #1658 corrected it there.
//
// AND THE PARK IS NOT EVEN THE DANGEROUS PART. `netReadSock`'s retry loop
// (../tcp.bit) carries a compiler-synthesized `bl bit_rt_safepoint` at its back
// edge, and when `netAwaitReady` finds no task to park on it SPINS — staying
// `running` across that poll. So a collection can run with this frame's raw
// address invisible without any park occurring.
//
// `@nosplit` is the usual fix and IS NOT AVAILABLE HERE: E0075 makes the
// guarantee transitive over the whole callee subtree, and that subtree reaches
// `schedPark`. The port layer must be able to park; that is not negotiable.
//
// So this file takes the OTHER half of what #1658 requires — not the annotation
// but the property behind it: NO RAW GC ADDRESS MAY BE HELD ACROSS A POLL. Every
// receive buffer here is now a MANAGED `[]i64` local, which is a real stack-map
// slot the precise walk names, and whose backing the non-moving collector never
// relocates — so `ptrOf` on it is stable across any number of polls and parks.
// The socket engine already takes its buffers as `*u8` parameters, so it needs
// no change: the caller's managed local is what keeps them alive, exactly the
// contract `runtime/root/floats.bit`'s `packLowBytes` documents.
//
// `[]i64` and not `[]byte` because a Bit `[]byte` is WORD-STRIDED (one byte per
// 8-byte word, ABI.md §2) and the kernel writes packed bytes. `[]i64(k)` is `k`
// contiguous 8-byte words, i.e. `k * 8` packed bytes, which is the only managed
// Bit type that names a packed byte region.
//
// The allocate-and-copy that turns a filled scratch into the returned `string`
// is the one place a raw address still appears, and it lives inside the
// `@nosplit` helper `strFromPacked` below, where no collection can occur.

import { strPtr, strLen, rtStrAlloc, rtStringSlice } from "../../root"
import { loadWord, loadByte, storeByte } from "../../gc"
// `netParseIpv4`, `netMax*` and the DNS codec are already imported from
// "../../net" by this module's sibling sock.bit (imports are module-scoped), so
// re-importing them here is an E0042 redeclaration — only the two names sock.bit
// does NOT bring in are imported.
import { netFormatOctets, netFirstNameserver } from "../../net"

// ---------------------------------------------------------------------------
// Marshalling helpers
// ---------------------------------------------------------------------------

// A raw byte pointer at `addr`. `base + addr` on a nil `*u8` is the project's
// idiom for turning an address held as `int` back into a pointer.
@nosplit fn u8At(addr: int): *u8 {
  let base: *u8 = nil
  return base + addr
}

// A `string` object's inline byte pointer and its length (ABI.md §2: a
// `{ptr, len}` header whose `ptr` addresses the object's own bytes).
@nosplit fn strData(s: int): *u8 {
  return u8At(loadWord(s + strPtr))
}

@nosplit fn strSizeOf(s: int): int {
  return loadWord(s + strLen)
}

// The empty string, the failure value for every string-returning entry point
// (matching `runtime/root/`'s `stringFromBytes("")`).
@nosplit fn emptyStr(): int {
  return rtStrAlloc(0)
}

// `n` packed bytes at raw address `src`, copied into a fresh `string`. Returns 0
// on heap exhaustion.
//
// `@nosplit`, and that is the whole point of the function existing (#1668): the
// entire raw lifetime — allocate, take the interior pointer, fill — is inside
// this one poll-free body, so no collection can happen between the allocation
// and the last write to it. `src` must point into memory the CALLER keeps alive,
// which for every caller here is a managed `[]i64` local. Same contract, and the
// same reason, as `runtime/root/floats.bit`'s `packLowBytes`.
@nosplit fn strFromPacked(src: int, n: int): int {
  let out = rtStrAlloc(n)
  if (out == 0) {
    return 0
  }
  let dst = loadWord(out + strPtr)
  let i = 0
  while (i < n) { // bounded by `n`; the body always advances `i`
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  return out
}

// Words of `[]i64` scratch needed to hold `nbytes` packed bytes.
@nosplit fn scratchWords(nbytes: int): int {
  return (nbytes + 7) / 8
}

// A dotted quad from four packed octets, as a fresh string. `netFormatOctets`
// writes at most 15 bytes into a scratch; the result is trimmed to its report.
//
// `@nosplit` (#1668): `fmt` is a fresh GC string held only as a raw `int` and
// `strData(fmt)` is an interior pointer into it. `netFormatOctets` is pure
// formatting over `*u8` — it never parks and never allocates — so the whole
// sequence closes poll-free and the string cannot be swept mid-format.
@nosplit fn formatQuad(octets: *u8): int {
  let fmt = rtStrAlloc(15)
  if (fmt == 0) {
    return emptyStr()
  }
  let flen = netFormatOctets(octets, strData(fmt))
  return rtStringSlice(fmt, 0, flen)
}

// ---------------------------------------------------------------------------
// TCP (ABI.md §12)
// ---------------------------------------------------------------------------

// `bit_rt_net_listen`: a listening TCP socket on `host:port`, or -1. `port == 0`
// asks the kernel to choose one; read it back with `net_local_port`.
export @symbol("bit_rt_net_listen") @nosplit fn netAbiListen(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netListenTcp(strData(host), strSizeOf(host), port, 512)
}

// `bit_rt_net_local_port`: the port `fd` is bound to, or -1.
export @symbol("bit_rt_net_local_port") @nosplit fn netAbiLocalPort(fd: int): int {
  return netLocalPort(fd)
}

// `bit_rt_net_accept`: the next connection on listener `fd`, or -1. Parks the
// calling green thread until a peer arrives.
export @symbol("bit_rt_net_accept") fn netAbiAccept(fd: int): int {
  return netAcceptTcp(fd)
}

// `bit_rt_net_dial`: a connected TCP socket to `host:port`, or -1. Parks until
// the handshake completes.
export @symbol("bit_rt_net_dial") fn netAbiDial(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netDialTcp(strData(host), strSizeOf(host), port)
}

// `bit_rt_net_read`: up to `max` bytes from `fd`, parking until some arrive.
// Empty means the peer closed — an orderly end of stream. An I/O error reads as
// empty too, exactly as `runtime/root/` documents.
export @symbol("bit_rt_net_read") fn netAbiRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  // MANAGED scratch, not `rtStrAlloc(max)` (#1668). `netReadSock` loops, polls
  // and may park; `scratch` is a stack-map slot so the precise walk names it
  // throughout, and the non-moving collector keeps `ptrOf` valid.
  let scratch = []i64(scratchWords(max))
  let n = netReadSock(fd, u8At(int(ptrOf(scratch))), max)
  if (n <= 0) {
    return emptyStr()
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

// `bit_rt_net_write`: all of `s` to `fd`, parking whenever the send buffer is
// full. Returns the byte count, or -1. The port layer retries a short write.
export @symbol("bit_rt_net_write") fn netAbiWrite(fd: int, s: int): int {
  return netWriteSock(fd, strData(s), strSizeOf(s))
}

// ---------------------------------------------------------------------------
// UDP (ABI.md §12)
// ---------------------------------------------------------------------------
//
// THE LAST SENDER IS MODULE STATE, NOT A THREADLOCAL. `runtime/root/` keeps it in a
// `threadlocal`; that lives in module state here, sound under the ABI's
// single-worker contract (ABI.md §5) and the adjacency the lowering gives
// `udp_recv` then `udp_sender_host`/`_port` with no yield between. A scalar array
// is never scanned by the collector (rule 1), which is required here: it holds a
// raw `sockaddr`, not an object.
let udpSenderBuf: [4]i64
let udpSenderValid: i64 = 0

// The stored sender as a `*u8`, re-derived each call (module-state address).
@nosplit fn udpSenderAddr(): *u8 {
  return u8At(int(ptrOf(udpSenderBuf)))
}

// `bit_rt_net_udp_bind`: a datagram socket bound to `host:port`, or -1.
export @symbol("bit_rt_net_udp_bind") @nosplit fn netAbiUdpBind(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netBindUdp(strData(host), strSizeOf(host), port)
}

// `bit_rt_net_udp_send`: one datagram of `data` to `host:port` from `fd`.
// Returns the byte count, or -1.
export @symbol("bit_rt_net_udp_send") fn netAbiUdpSend(fd: int, host: int, port: int, data: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netSendTo(fd, strData(host), strSizeOf(host), port, strData(data), strSizeOf(data))
}

// `bit_rt_net_udp_recv`: up to `max` bytes of the next datagram on `fd`, parking
// until one arrives. Records the sender for `udp_sender_host`/`_port`. On error
// returns empty and marks the sender invalid; a zero-length datagram returns
// empty with a valid sender (UDP has no end-of-stream).
export @symbol("bit_rt_net_udp_recv") fn netAbiUdpRecv(fd: int, max: int): int {
  udpSenderValid = 0
  if (max <= 0) {
    return emptyStr()
  }
  // MANAGED scratch — see `netAbiRead`. `netRecvFrom` parks on the same engine.
  let scratch = []i64(scratchWords(max))
  let n = netRecvFrom(fd, u8At(int(ptrOf(scratch))), max, udpSenderAddr())
  if (n < 0) {
    return emptyStr()
  }
  udpSenderValid = 1
  return strFromPacked(int(ptrOf(scratch)), n)
}

// `bit_rt_net_udp_sender_host`: dotted-quad of the last recv's sender, or "".
export @symbol("bit_rt_net_udp_sender_host") fn netAbiUdpSenderHost(): int {
  if (udpSenderValid == 0) {
    return emptyStr()
  }
  // MANAGED scratch for the four octets (#1668): `octStr` used to be a raw
  // `rtStrAlloc` address held across `netSockAddrOctets`.
  let oct = []i64(1)
  netSockAddrOctets(udpSenderAddr(), u8At(int(ptrOf(oct))))
  return formatQuad(u8At(int(ptrOf(oct))))
}

// `bit_rt_net_udp_sender_port`: the last recv's sender port, or -1.
export @symbol("bit_rt_net_udp_sender_port") @nosplit fn netAbiUdpSenderPort(): int {
  if (udpSenderValid == 0) {
    return 0 - 1
  }
  return netSockAddrPort(udpSenderAddr())
}

// ---------------------------------------------------------------------------
// DNS (ABI.md §20)
// ---------------------------------------------------------------------------

// `/etc/resolv.conf` is read into a fixed, bounded scratch (Power of 10 rule 3,
// no unbounded growth): a nameserver directive lives at the top of the file, so
// the first page bounds every real config. `runtime/root/` reads the whole file with a
// growing buffer; this reads at most `resolvConfMax` and finds the first
// `nameserver` line within it, behaviourally identical for every practical
// `resolv.conf`.
const resolvConfMax: int = 4096

// Read up to `cap` bytes of `/etc/resolv.conf` into `bufPtr`, returning the byte
// count or -1 if the file cannot be opened. `fsOpen`/`fsClose` are language
// builtins (they lower to RtFn calls, not `extern function` declarations, so they
// pass `rejectExternForTarget`); `netReadSock` is this module's socket-read
// sibling, and `read(2)` is generic across a socket and a regular file — a
// blocking regular file never returns EAGAIN, so its poller path is never taken.
//
// BOUNDED (Power of 10 rule 2): `total` rises by at least 1 each iteration (a
// `n <= 0` sets `done`) and the loop also exits at `total >= cap`.
fn readResolvConf(bufPtr: *u8, cap: int): int {
  let fd = fsOpen("/etc/resolv.conf", false)
  if (fd < 0) {
    return 0 - 1
  }
  let total = 0
  let done = false
  while (!done && total < cap) {
    let n = netReadSock(fd, bufPtr + total, cap - total)
    if (n <= 0) {
      done = true
    } else {
      total = total + n
    }
  }
  fsClose(fd)
  return total
}

// `bit_rt_net_resolve`: the first IPv4 A-record for `host` as a dotted quad, or
// "" on failure. A dotted-quad `host` passes straight back. Uses the first
// nameserver in /etc/resolv.conf (ABI.md §20).
//
// `netResolve` (this module's socket sibling) takes the nameserver as a
// parameter, so this wrapper owns the file read. A missing or nameserver-less
// file resolves to "", which the caller reports as a bad address.
export @symbol("bit_rt_net_resolve") fn netAbiResolve(host: int): int {
  let hostPtr = strData(host)
  let hostLen = strSizeOf(host)

  // EVERY scratch below is a MANAGED `[]i64` local (#1668). They used to be raw
  // `rtStrAlloc` addresses held across `readResolvConf`, which loops, polls and
  // parks in `netReadSock`, and across `netResolve`, which parks on a DNS
  // round trip. Managed locals are stack-map slots, so the precise walk names
  // them for the whole of both.
  let outBuf = []i64(1)
  let outPtr = u8At(int(ptrOf(outBuf)))

  // A literal address never needs the network — return it verbatim, exactly as
  // `netResolve` would, but without touching /etc/resolv.conf.
  if (netParseIpv4(hostPtr, hostLen, outPtr)) {
    return formatQuad(outPtr)
  }

  let confBuf = []i64(scratchWords(resolvConfMax))
  let confPtr = u8At(int(ptrOf(confBuf)))
  let confLen = readResolvConf(confPtr, resolvConfMax)
  if (confLen <= 0) {
    return emptyStr()
  }

  let nsBuf = []i64(1)
  let nsPtr = u8At(int(ptrOf(nsBuf)))
  if (!netFirstNameserver(confPtr, confLen, nsPtr)) {
    return emptyStr()
  }
  if (!netResolve(hostPtr, hostLen, nsPtr, outPtr)) {
    return emptyStr()
  }
  return formatQuad(outPtr)
}
