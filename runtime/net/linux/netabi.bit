// SEAM 1 of the runtime port (#1574, reshaped by #1600): the 12
// `bit_rt_net_*` ABI wrappers (ABI.md §20) over the ported Linux socket
// engine. This is `runtime/root/`'s `bit_rt_net_*` block expressed in Bit —
// pure marshalling between the managed `string` boundary the compiler emits and
// the `*u8 + length` boundary the socket engine speaks.
//
// ---------------------------------------------------------------------------
// WHY THE WRAPPERS LIVE PER-PLATFORM NOW (io.bit / fs.bit shape, #1600)
// ---------------------------------------------------------------------------
//
// SEAM 1 first kept these wrappers in the platform-FREE parent (`net/netabi.bit`)
// and reached the socket engine (`net/linux`, `net/darwin`) by `extern function`.
// That is admissible on aarch64-macos, where an `extern` is a load-time dyld
// import, but a Linux `--emit-obj` REJECTS any `extern function` naming a symbol
// not already inside `libbitrt.a` (E0078, `rejectExternForTarget`) — and the
// socket engine, the very code the port defines, is not. Worse, the parent module
// is imported by `net/{linux,darwin}` (for `netParseIpv4` and friends), so a
// single such `extern` in the parent reddened the Linux build of the providers
// too. G3 (#1584) assembles `libbitrt.a` per module on both Linux triples, so it
// would have hit exactly this.
//
// The fix is the shape `root/{linux,darwin}/fs.bit` uses (#1606): the wrappers
// live IN each platform provider, where the socket engine functions
// (`bit_rt_port_net_*`) are ordinary module-scoped SIBLINGS reached by their Bit
// name — a local call, never an `extern` — and the platform-free glue is reached
// by ordinary `import` (a cross-module *call*, never E0078). Nothing here is an
// `extern`, so this compiles clean for a Linux `--emit-obj`.
//
// The marshalling body is duplicated with ../darwin/netabi.bit rather than shared,
// for the same reason fs.bit gives: the only thing that differs between the two is
// which socket engine the sibling names resolve to, and there is no platform-free
// home a wrapper-over-per-platform-sibling could live in without reintroducing the
// `extern`.
//
// ---------------------------------------------------------------------------
// PINS CARRY THE BARE ABI NAME
// ---------------------------------------------------------------------------
//
// These ARE the ABI symbols the RtFn lowering calls by fixed name
// (`bit_rt_net_listen` and the rest) — G2 (#1583) retired the old
// `runtime/root/`-owned duplicate definitions and dropped the `_root` infix.
// The net suites exercise these bodies directly.
//
// ---------------------------------------------------------------------------
// NO PATH TO A NET RtFn, SO NO PIN CYCLE
// ---------------------------------------------------------------------------
//
// A wrapper that reached the socket by calling the `netListen`/`netDial`/…
// BUILTINS would lower each to `ir.RtFn.net_*`, which codegen emits as a call to
// `bit_rt_net_*` — the very symbol being pinned — and after G2's rename that is
// self-recursion. This file never touches those builtins: it calls the
// port-internal socket functions (`netListenTcp`/…, pinned `bit_rt_port_net_*` by
// #1366), which are no RtFn's target. `./make test-rootpins` is the object-level
// proof, with `runtime/net/linux` in its module list.
//
// ---------------------------------------------------------------------------
// WHY THE BUFFERS HERE ARE MANAGED `[]i64`, NOT RAW `rtStrAlloc` ADDRESSES
// (#1668 — and THE COMMENT THIS REPLACES WAS WRONG)
// ---------------------------------------------------------------------------
//
// What stood here claimed: "`netAbiRead`/`netAbiUdpRecv` allocate, park in a
// socket call (a safepoint), then trim. The collector scans stacks
// CONSERVATIVELY (ABI.md §5), so the object address in a plain `int`/`*u8` local
// pins the object across the park."
//
// ABI.md §5 says the opposite of what that read it to say, and the difference is
// #1656 — an s0 that cost four G3 attempts. §5: "the running task's stack is
// walked PRECISELY (§4); every *other* registered task's stack is scanned
// conservatively". A runtime frame holding a GC object as a raw `int` is named
// by no stack map, so while this task is the RUNNING one the precise walk does
// not see it at all. The identical false premise was in
// `runtime/root/{darwin,linux}/io.bit` and #1658 corrected it there.
//
// AND THE PARK IS NOT EVEN THE DANGEROUS PART. `netReadSock`'s retry loop
// (../tcp.bit) carries a compiler-synthesized `bl bit_rt_safepoint` at its back
// edge, and when `netAwaitReady` finds no task to park on it SPINS — staying
// `running` across that poll. So a collection can run with this frame's raw
// address invisible without any park occurring.
//
// `@nosplit` is the usual fix and IS NOT AVAILABLE HERE: E0075 makes the
// guarantee transitive over the whole callee subtree, and that subtree reaches
// `schedPark`. The port layer must be able to park; that is not negotiable.
//
// So this file takes the OTHER half of what #1658 requires — not the annotation
// but the property behind it: NO RAW GC ADDRESS MAY BE HELD ACROSS A POLL. Every
// receive buffer here is now a MANAGED `[]i64` local, which is a real stack-map
// slot the precise walk names, and whose backing the non-moving collector never
// relocates — so `ptrOf` on it is stable across any number of polls and parks.
// The socket engine already takes its buffers as `*u8` parameters, so it needs
// no change: the caller's managed local is what keeps them alive, exactly the
// contract `runtime/root/floats.bit`'s `packLowBytes` documents.
//
// THE DEADLINE READ AND WRITE HOLD NO SCRATCH AT ALL (#5890). Their buffer is
// already a MANAGED `[]byte` in the compiled Bit caller — `std/net`'s
// `readDeadline`, `readDeadlineInto` and `writeDeadline` — and that caller
// calls `keepAlive` on it (SPEC §11.5, #5807) after the extern returns. So
// the caller's own stack-map slot names the buffer across the whole call,
// every poll and park included, and the non-moving collector never relocates
// its backing: the caller's managed buffer is what pins the memory the kernel
// reads and writes. `outWords`/`words` are raw here, but this frame returns
// before the caller's does, so no raw address outlives the caller's frame. A
// second managed copy in this frame pinned nothing the caller did not already
// pin, and cost an allocation the size of the transfer, its zeroing and a
// byte loop per call. With no allocation left both wrappers are `@nosplit`,
// so E0075 proves they neither allocate nor reach a safepoint poll.
// `netAbiDialDeadlineW` keeps its copy: `dialDeadline` does not `keepAlive`
// its host bytes, and the copy is taken before the first poll.
//
// `[]i64` rather than `[]byte`: `[]i64(k)` is `k` contiguous 8-byte words,
// i.e. `k * 8` bytes of scratch, sized independently of the transfer's own
// element width. (`[]u8`/`[]byte` packs one byte per element too, as of
// #3121/#3226, but this scratch mechanism is about a stable, GC-tracked
// pointer across a park — orthogonal to which type names the bytes — so it is
// left as `[]i64` rather than restructured.)
//
// The allocate-and-copy that turns a filled scratch into the returned `string`
// is the one place a raw address still appears, and it lives inside the
// `@nosplit` helper `strFromPacked`, pulled up to ../netabi.bit (#2552) along
// with the rest of this file's byte/string marshalling — none of it touches
// the kernel, so no collection can occur there either.

import { loadByte, storeByte } from "../../gc"
// `netParseIpv4`, `netMax*` and the DNS codec are already imported from
// "../../net" by this module's sibling sock.bit (imports are module-scoped), so
// re-importing them here is an E0042 redeclaration — only the name sock.bit
// does NOT bring in is imported. `emptyStr`, `u8At`, `scratchWords`,
// `strData`, `strSizeOf` and `strFromPacked` are core (../netabi.bit, #2552)
// too, module-scoped the same way.
import {
  netNextNameserver, emptyStr, u8At, scratchWords, strData, strSizeOf,
  strFromPacked, netDnsArgsOk,
} from "../../net"

// ---------------------------------------------------------------------------
// TCP (ABI.md §20)
// ---------------------------------------------------------------------------

// `bit_rt_net_listen`: a listening TCP socket on `host:port`, or -1. `port == 0`
// asks the kernel to choose one; read it back with `net_local_port`.
export @symbol("bit_rt_net_listen") @nosplit fn netAbiListen(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netListenTcp(strData(host), strSizeOf(host), port, 512)
}

// `bit_rt_net_local_port`: the port `fd` is bound to, or -1.
export @symbol("bit_rt_net_local_port") @nosplit fn netAbiLocalPort(fd: int): int {
  return netSockLocalPort(fd)
}

// `bit_rt_net_peer_addr_w`: the connected peer's address for `fd` written to the
// caller's own 16-byte `outWords` buffer in the IPv6 wire form (an IPv4 peer as
// its IPv4-mapped `::ffff:a.b.c.d`); 0, or -1 when there is no peer —
// unconnected or listening, closed, or a peer that is neither AF_INET nor
// AF_INET6. Raw bytes rather than text, and not allocating a string, keeps
// this wrapper `@nosplit` (ABI.md §20); `std/net`'s `Conn.peerIp` renders them.
//
// `outWords` crosses as a packed `[]byte` backing the caller holds live with
// `keepAlive`, and is written before this frame returns, so no raw address
// outlives the caller's frame (the argument `netAbiReadBytesW` below makes).
//
// `_w`, like `bit_rt_net_shutdown_sock_w` below and unlike `net_local_port`
// above: `std/net` reaches it through a plain `extern fn`, not through a
// compiler-recognized builtin (see `bit_rt_net_peer_addr_w` in ABI.md §20).
export @symbol("bit_rt_net_peer_addr_w") @nosplit fn netAbiPeerAddrW(fd: int, outWords: int): int {
  if (outWords == 0) {
    return 0 - 1
  }
  return netSockPeerAddr(fd, u8At(outWords))
}

// `bit_rt_net_accept`: the next connection on listener `fd`, or -1. Parks the
// calling green thread until a peer arrives.
export @symbol("bit_rt_net_accept") fn netAbiAccept(fd: int): int {
  return netAcceptTcp(fd)
}

// `bit_rt_net_dial`: a connected TCP socket to `host:port`, or -1. Parks until
// the handshake completes.
export @symbol("bit_rt_net_dial") fn netAbiDial(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netDialTcp(strData(host), strSizeOf(host), port)
}

// `bit_rt_net_read`: up to `max` bytes from `fd`, parking until some arrive.
// Empty means the peer closed — an orderly end of stream. An I/O error reads as
// empty too, exactly as `runtime/root/` documents.
export @symbol("bit_rt_net_read") fn netAbiRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  // MANAGED scratch, not `rtStrAlloc(max)` (#1668). `netReadSock` loops, polls
  // and may park; `scratch` is a stack-map slot so the precise walk names it
  // throughout, and the non-moving collector keeps `ptrOf` valid.
  let scratch = []i64(scratchWords(max))
  let n = netReadSock(fd, u8At(int(ptrOf(scratch))), max)
  if (n <= 0) {
    return emptyStr()
  }
  return strFromPacked(int(ptrOf(scratch)), n)
}

// `bit_rt_net_write`: all of `s` to `fd`, parking whenever the send buffer is
// full. Returns the byte count, or -1. The port layer retries a short write.
export @symbol("bit_rt_net_write") fn netAbiWrite(fd: int, s: int): int {
  return netWriteSock(fd, strData(s), strSizeOf(s))
}

// ---------------------------------------------------------------------------
// Deadline-bounded dial/read/write (#2291)
// ---------------------------------------------------------------------------
//
// `std/net`'s `dialDeadline`/`readDeadline`/`writeDeadline` reach these through
// a plain `extern fn`, not the compiler-recognized `netDial`/`netRead`/`netWrite`
// builtins above — so a `string` may not cross the boundary at all (SPEC
// §11.7 admits only scalars and raw pointers), the same constraint `std/fs`'s
// `bit_rt_fs_is_symlink_w` documents. `std/net` packs a `string` into a
// caller-owned `[]byte` first and passes its address as `words`/length; a Bit
// `[]byte` is byte-packed (ABI.md §2, #3121/#3226), the `*u8` shape the
// socket engine in ../tcp.bit takes. `dial` copies its host into a MANAGED
// scratch before the first poll; `read` and `write` hand the caller's own
// buffer straight to the engine, pinned by the caller's `keepAlive` (see "WHY
// THE BUFFERS HERE ARE MANAGED"). Byte-for-byte mirror of ../darwin/netabi.bit's
// section of the same name.

// Bound on a packed host/body the entry points below will unpack, so the
// copy loops are statically provable (Power of 10 rule 2). 255 matches the
// longest legal DNS name; a caller with a longer `host` was never going to
// resolve anyway.
const netAbiMaxHost: int = 255

// Bound on a written body: generous rather than tight — this is a request's
// wire bytes (line, headers, body), not a socket-buffer size — so an ordinary
// POST is nowhere near it. It first bounded a copy loop #5890 removed; it
// stays so a single deadline write keeps the same ceiling and the same `-1`
// past it.
const netAbiMaxBody: int = 67108864

// `bit_rt_net_dial_deadline_w`: like `bit_rt_net_dial`, but bounded by an
// ABSOLUTE monotonic deadline rather than parking forever. Returns the
// connected fd, or a negative sentinel: -1 hard failure, -2 the deadline
// elapsed first.
export @symbol("bit_rt_net_dial_deadline_w") fn netAbiDialDeadlineW(
  hostWords: int,
  hostLen: int,
  port: int,
  deadlineNs: int,
): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  if (hostWords == 0 || hostLen <= 0 || hostLen > netAbiMaxHost) {
    return 0 - 1
  }
  // MANAGED scratch (#1668): `netDialTcpDeadline` polls and may park, and only
  // a stack-map slot survives that — see this file's "WHY THE BUFFERS HERE
  // ARE MANAGED" section.
  let scratch = []i64(scratchWords(hostLen))
  let packed = int(ptrOf(scratch))
  let i = 0
  while (i < hostLen) { // bounded by `hostLen`, itself bounded by `netAbiMaxHost`
    storeByte(packed + i, loadByte(hostWords + i))
    i = i + 1
  }
  return netDialTcpDeadline(u8At(packed), hostLen, port, deadlineNs)
}

// `bit_rt_net_read_deadline_w`: like `bit_rt_net_read`, but bounded, and
// writing into the caller's own packed `outWords` buffer (a `[]byte(max)`'s
// backing, ABI.md §2, #3121/#3226) rather than returning a fresh `string` — an
// `extern fn` cannot return one either (SPEC §11.7). Returns the byte count
// written (`0` — the peer closed, an orderly end of stream), or a negative
// sentinel: -1 hard I/O error, -2 the deadline elapsed first.
export @symbol("bit_rt_net_read_deadline_w") @nosplit fn netAbiReadDeadlineW(
  fd: int,
  outWords: int,
  bufCap: int,
  deadlineNs: int,
): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  return netReadSockDeadline(fd, u8At(outWords), bufCap, deadlineNs)
}

// `bit_rt_net_write_deadline_w`: like `bit_rt_net_write`, but bounded — `s`
// crosses as `words`/`n` for the same reason `dial`'s `host` does above.
// Returns the byte count written, or a negative sentinel: -1 hard failure,
// -2 the deadline elapsed first.
export @symbol("bit_rt_net_write_deadline_w") @nosplit fn netAbiWriteDeadlineW(
  fd: int,
  words: int,
  n: int,
  deadlineNs: int,
): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  return netWriteSockDeadline(fd, u8At(words), n, deadlineNs)
}

// `bit_rt_net_write_bytes_w` (#5928): `bit_rt_net_write`'s byte-taking
// sibling — `words`/`n` cross exactly as they do above, but this calls the
// SAME true-blocking, never-give-up `netWriteSock` `netAbiWrite` does, not
// the deadline-bounded engine, so `std/net`'s `Conn.writeBytes` behaves
// exactly like `Conn.write(s: string)`'s own no-deadline fast path: a slow
// peer that eventually drains its socket buffer is not bounded by
// `netDeadlineMaxWaitNs` the way an armed deadline is. `netAbiWrite` is not
// `@nosplit` (`net/linux:netAbiWrite`, `_tests_/bit/pollfree/exceptions2.bit`)
// for the identical reason: `netWriteSock` can park, and this wrapper holds
// no raw address of its own across that park, only `words` — a raw `int`
// rooted by the CALLING Bit frame's own stack-map slot, pinned there by
// `std/net`'s `keepAlive(b)` after this call returns.
export @symbol("bit_rt_net_write_bytes_w") fn netAbiWriteBytesW(fd: int, words: int, n: int): int {
  if (n <= 0) {
    return 0
  }
  if (words == 0 || n > netAbiMaxBody) {
    return 0 - 1
  }
  return netWriteSock(fd, u8At(words), n)
}

// `bit_rt_net_read_bytes_w` (#7389): `bit_rt_net_read`'s byte-taking sibling,
// the read-side twin of `netAbiWriteBytesW` above. The kernel reads straight
// into the caller's packed `outWords` buffer through the SAME parking,
// never-give-up `netReadSock` `netAbiRead` uses, so an undeadlined
// `Conn.readInto` waits exactly as `Conn.read` does, with no scratch and no
// `string` allocated per call. Not `@nosplit` for `netAbiWriteBytesW`'s
// reason: `netReadSock` can park, and `outWords` is rooted by the calling Bit
// frame, pinned by `std/net`'s `keepAlive(buf)`. Byte count, `0` peer closed,
// `-1` hard error.
export @symbol("bit_rt_net_read_bytes_w") fn netAbiReadBytesW(
  fd: int,
  outWords: int,
  bufCap: int,
): int {
  if (bufCap <= 0 || outWords == 0) {
    return 0
  }
  return netReadSock(fd, u8At(outWords), bufCap)
}

// `bit_rt_net_shutdown_sock_w`: shut both directions of `fd` down without
// releasing it for reuse (#3016/#3025) — see `netShutdownSock`'s doc comment
// (../tcp.bit) for why this exists alongside plain `close`. No buffer, so
// unlike its siblings above this needs no packed-byte scratch. `true` on
// success.
export @symbol("bit_rt_net_shutdown_sock_w") @nosplit fn netAbiShutdownSockW(fd: int): bool {
  return netShutdownSock(fd)
}

// `bit_rt_net_close_w` (#5865): the platform-neutral binding `std/net`'s
// `close()` methods now call on every platform (darwin's own `netClose`
// gained real bookkeeping — see that provider's `netabi.bit` — linux's has
// not, #5866; this is a pure passthrough to the SAME raw `syscall(sysClose,
// fd)` `close()` called directly before, no behavior change here).
export @symbol("bit_rt_net_close_w") @nosplit fn netAbiCloseW(fd: int) {
  netClose(fd)
}

// ---------------------------------------------------------------------------
// UDP (ABI.md §20)
// ---------------------------------------------------------------------------
//
// SEND AND RECEIVE ARE EACH ONE RUNTIME CALL (#7746). `netAbiUdpRecvFromW`
// returns the datagram AND the sender's sockaddr in buffers the CALLER owns,
// the way recvfrom(2) does. The runtime keeps no "last sender" state: a slot
// read back by a second call afterwards (the per-worker `udpSenderBuf` this
// replaced, #3272/#2552) is only the right slot while nothing between the write
// and the read yields, and a poll can: the task then read another task's
// sender, or none (0.0.0.0:0). See ABI.md section 20.
// What stays here is `netAbiUdpBind`/`Send`/`RecvFromW`, because each calls the
// OS-specific socket engine (`netBindUdp`, `netSendTo`, `netRecvFrom`).

// `bit_rt_net_udp_bind`: a datagram socket bound to `host:port`, or -1.
export @symbol("bit_rt_net_udp_bind") @nosplit fn netAbiUdpBind(host: int, port: int): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netBindUdp(strData(host), strSizeOf(host), port)
}

// `bit_rt_net_udp_send`: one datagram of `data` to `host:port` from `fd`.
// Returns the byte count, or -1.
export @symbol("bit_rt_net_udp_send") fn netAbiUdpSend(
  fd: int,
  host: int,
  port: int,
  data: int,
): int {
  if (port < 0 || port > 65535) {
    return 0 - 1
  }
  return netSendTo(fd, strData(host), strSizeOf(host), port, strData(data), strSizeOf(data))
}

// `bit_rt_net_udp_recv_from_w` (#7746): the next datagram on `fd`, parking until
// one arrives, written into the caller's own packed `outWords` buffer (`bufCap`
// bytes) with the sender's raw `sockaddr_in` written into the caller's own
// `peerWords` buffer (at least `netSockAddrLen()` = 16 bytes). Returns the byte
// count, or -1 on error (a closed fd, a null or empty buffer, an I/O failure);
// a ZERO-LENGTH DATAGRAM returns 0 with a valid sender, UDP having no
// end-of-stream. `std/net`'s `UdpSocket.recv` decodes the address.
//
// Raw bytes in the caller's storage rather than a `string` and a slot: an
// `extern fn` cannot return a string (SPEC §11.7), and nothing the runtime
// holds between this call and the caller's read can be another task's.
// Both buffers are packed `[]byte` backings the caller holds live across the
// call with `keepAlive`, rooted by the calling Bit frame through the park
// (the argument `netAbiReadBytesW` makes); this frame holds no raw address of
// its own.
export @symbol("bit_rt_net_udp_recv_from_w") fn netAbiUdpRecvFromW(
  fd: int,
  outWords: int,
  bufCap: int,
  peerWords: int,
): int {
  if (bufCap <= 0 || outWords == 0 || peerWords == 0) {
    return 0 - 1
  }
  return netRecvFrom(fd, u8At(outWords), bufCap, u8At(peerWords))
}

// ---------------------------------------------------------------------------
// DNS (ABI.md §20)
// ---------------------------------------------------------------------------

// `/etc/resolv.conf` is read into a fixed, bounded scratch (Power of 10 rule 3,
// no unbounded growth): a nameserver directive lives at the top of the file, so
// the first page bounds every real config. `runtime/root/` reads the whole file with a
// growing buffer; this reads at most `resolvConfMax` and finds the first
// `nameserver` line within it, behaviourally identical for every practical
// `resolv.conf`.
const resolvConfMax: int = 4096

// Read up to `bufCap` bytes of `/etc/resolv.conf` into `bufPtr`, returning the byte
// count or -1 if the file cannot be opened. `fsOpen`/`fsClose` are language
// builtins (they lower to RtFn calls, not `extern function` declarations, so they
// pass `rejectExternForTarget`); `netReadSock` is this module's socket-read
// sibling, and `read(2)` is generic across a socket and a regular file — a
// blocking regular file never returns EAGAIN, so its poller path is never taken.
//
// BOUNDED (Power of 10 rule 2): `total` rises by at least 1 each iteration (a
// `n <= 0` sets `done`) and the loop also exits at `total >= bufCap`.
fn readResolvConf(bufPtr: *u8, bufCap: int): int {
  let fd = fsOpen("/etc/resolv.conf", false)
  if (fd < 0) {
    return 0 - 1
  }
  // `netReadSock` acquires a ref on `fd`, and `netClose` (a DNS or TCP socket
  // that held this fd number before) leaves that fd's closing bit set until
  // the next `pdOpen` on the number. `fsOpen` never calls it, so without this
  // reset the read is refused before its first syscall and the lookup fails
  // (#6338's 9-of-10 failure; #6341's DNS sockets close through `netClose`).
  // Not `netPollDescOpen`: a file has no readiness edge to park on.
  let _ = netFdResetState(fd)
  let total = 0
  let done = false
  while (!done && total < bufCap) {
    let n = netReadSock(fd, bufPtr + total, bufCap - total)
    if (n <= 0) {
      done = true
    } else {
      total = total + n
    }
  }
  fsClose(fd)
  return total
}

// True when the arguments of `netAbiResolveW` describe a lookup this runtime
// will run: a host of 1..`netAbiMaxHost` bytes, both buffers present, and a
// budget `netDnsArgsOk` accepts.
@nosplit fn netAbiResolveArgsOk(
  hostWords: int,
  hostLen: int,
  timeoutMs: int,
  attempts: int,
  outWords: int,
): bool {
  if (hostWords == 0 || outWords == 0) {
    return false
  }
  if (hostLen <= 0 || hostLen > netAbiMaxHost) {
    return false
  }
  return netDnsArgsOk(timeoutMs, attempts)
}

// Asks the nameservers of the conf text the resolve block `ns` points at
// (`netNsConfOff`), in order, IPv4 and IPv6, ONCE PER ATTEMPT: pass 1 asks every
// server, then pass 2 asks every server again, up to the block's attempt count,
// and the first A record, written to `out` (four octets), wins. That is
// resolv.conf(5)'s `attempts` ("the number of times the resolver will send a
// query to its name servers before giving up"), so with the first server dead
// the second is asked after ONE window, not after all the first's attempts.
// Each try waits a fixed window (`netNsTimeoutOff`); there is no retrans back-off.
// False once every pass has failed.
//
// #6338: EVERY nameserver, not the first line only -- a single
// `netResolveHost` call used to stop there, so a resolv.conf whose first server
// was unreachable never got a second chance. `netResolveHost`/
// `netResolveHost6` (this module's socket siblings) make ONE attempt against a
// server they are given, so this function owns the walk.
//
// `port` starts at the block's port and moves by its step after each server:
// production passes 53 and 0, a test with several fake servers on one address
// gives each its own port. The conf text, `ns` and `out` are the caller's
// MANAGED scratch (#1668), held across the parks below; `addrLenBuf` is ours.
export @symbol("bit_rt_port_net_resolve_passes") fn netResolvePasses(
  host: *u8,
  hostLen: int,
  ns: *u8,
  out: *u8,
): bool {
  let conf = u8At(getU64Le(ns, netNsConfOff))
  let confLen = getU64Le(ns, netNsConfLenOff)
  let passes = getU64Le(ns, netNsAttemptsOff)
  let step = getU64Le(ns, netNsPortStepOff)
  // `addrLenBuf` reports which address `netNextNameserver` wrote into `ns`:
  // 4 or 16 bytes. The words after byte 16 are never touched.
  let addrLenBuf = []i64(1)
  let addrLenPtr = ptrOf(addrLenBuf)
  let pass = 0
  // Bounded (Power of 10): `passes` is at most `netDnsArgMax`, and
  // `netNextNameserver` returns a position strictly past where it started, so
  // each walk of the conf ends within `confLen`.
  while (pass < passes) {
    pass = pass + 1
    let port = getU64Le(ns, netNsPortOff)
    let at = 0
    while (at >= 0) {
      at = netNextNameserver(conf, confLen, at, ns, addrLenPtr)
      if (at >= 0) {
        let resolved = false
        if (*addrLenPtr == 4) {
          resolved = netResolveHost(host, hostLen, ns, port, out)
        } else {
          resolved = netResolveHost6(host, hostLen, ns, port, out)
        }
        if (resolved) {
          return true
        }
        port = port + step
      }
    }
  }
  return false
}

// Reads /etc/resolv.conf into managed scratch and runs `netResolvePasses` over
// it on port 53.
fn netResolveConf(host: *u8, hostLen: int, ns: *u8, out: *u8): bool {
  let confBuf = []i64(scratchWords(resolvConfMax))
  let confPtr = u8At(int(ptrOf(confBuf)))
  let confLen = readResolvConf(confPtr, resolvConfMax)
  if (confLen <= 0) {
    return false
  }
  putU64Le(ns, netNsConfOff, int(confPtr))
  putU64Le(ns, netNsConfLenOff, confLen)
  putU64Le(ns, netNsPortOff, 53)
  putU64Le(ns, netNsPortStepOff, 0)
  let ok = netResolvePasses(host, hostLen, ns, out)
  keepAlive(confBuf)
  return ok
}

// `bit_rt_net_dns_servers_w` (#7480): how many nameservers the resolver walks
// that `std/net` cannot count itself. Always 0 here: this provider's list IS
// /etc/resolv.conf, which `std/net` reads and counts (`parseDnsPolicy`,
// stdlib/net/dnsconf.bit). Windows has no such file and reports its adapters'
// servers through this entry (../windows/netabi.bit).
export @symbol("bit_rt_net_dns_servers_w") @nosplit fn netAbiDnsServersW(): int {
  return 0
}

// `bit_rt_net_resolve_w`: the first IPv4 A-record for the host
// `hostWords[0..hostLen)` as a dotted quad written into the caller's own
// `outWords` buffer (at least 16 bytes), the byte count returned, or -1 once
// every nameserver has failed or an argument is refused (ABI.md section 20).
// A dotted-quad host passes straight back.
//
// `timeoutMs` is the receive window of ONE attempt and `attempts` how many a
// nameserver gets: `std/net` owns both (#6350, resolv.conf's
// `options timeout:N attempts:N`), the runtime has no default of its own.
// `hostWords` and `outWords` cross as packed `[]byte` backings (ABI.md section
// 2) that the caller holds live with `keepAlive`, as `bit_rt_net_read_deadline_w`
// documents; an `extern fn` cannot take or return a `string` (SPEC section 11.7).
export @symbol("bit_rt_net_resolve_w") fn netAbiResolveW(
  hostWords: int,
  hostLen: int,
  timeoutMs: int,
  attempts: int,
  outWords: int,
): int {
  if (!netAbiResolveArgsOk(hostWords, hostLen, timeoutMs, attempts, outWords)) {
    return 0 - 1
  }
  // MANAGED scratch (#1668), held across every park below: the four result
  // octets, and the nameserver block (address, then the budget).
  let octets = []i64(1)
  let out = u8At(int(ptrOf(octets)))
  let nsBuf = []i64(scratchWords(netNsBlockBytes))
  let ns = u8At(int(ptrOf(nsBuf)))
  putU64Le(ns, netNsTimeoutOff, timeoutMs)
  putU64Le(ns, netNsAttemptsOff, attempts)
  let host = u8At(hostWords)
  // A literal address never needs the network, so /etc/resolv.conf stays unread.
  if (!netParseIpv4(host, hostLen, out) && !netResolveConf(host, hostLen, ns, out)) {
    return 0 - 1
  }
  return netFormatOctets(out, u8At(outWords))
}
