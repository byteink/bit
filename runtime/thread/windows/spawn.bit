// Windows OS-thread provider for the Stage-2 port of runtime/sched/'s worker
// pool (#1403). See ../thread.bit for the shared contract, the seam against
// #1364, and the three rules a child thread's body must obey.
//
// `CreateThread` through kernel32 (§11.7's admitted Windows import surface,
// `compiler/pesyms.bit`), the same shape ../darwin/spawn.bit uses
// `pthread_create` for and for the same reason: there is no stable raw
// syscall interface to encode against on Windows either.
//
// THIS PROVIDER MIRRORS ../darwin/spawn.bit's SHAPE — a fixed trampoline-cell
// pool, no allocator, a claim/release CAS — because `CreateThread`, like
// `pthread_create`, hands the child exactly ONE `void*`-shaped parameter and
// allocates/guards the child's stack itself (`STACK_SIZE_PARAM_IS_A_RESERVATION`
// in `runtime/root/windows/boot.bit` makes the same reservation-not-commit
// choice this provider inherits).
//
// This module is a LEAF with no imports, exactly as the other two providers
// are — `../thread.bit`'s sentinel and this provider's own constants are
// duplicated rather than imported, the same choice ../darwin/spawn.bit's
// header explains.
//
// ---------------------------------------------------------------------------
// THE PER-THREAD IDENTITY TOKEN — NO LONGER THIS PROVIDER'S PROBLEM (#3412)
// ---------------------------------------------------------------------------
//
// A worker OS thread this provider starts needs a valid `gcThreadToken()`
// before it can reach the collector (#1650: two threads sharing one identity
// is invisible to the rendezvous and correctness-destroying, not merely a
// crash). This provider used to solve that itself, claiming a cell from a
// `tokenPool` and WRFSBASE-ing a self-referential word into FS_BASE at
// thread entry — mirroring `runtime/root/windows/boot.bit`'s equivalent
// install for the main thread.
//
// #3410/#3391 then measured, on real hardware, that a WRFSBASE-installed
// FS_BASE does NOT survive a Windows context switch (non-zero immediately
// before a deschedule, `0000000000000000` after) — so that install was
// never actually safe past a worker's first park, which is the common case,
// not an edge case, for a worker in this scheduler.
//
// #3420 fixed it at the source instead: `gcThreadToken()`'s Windows body
// (`runtime/gc/windows/gcthread.bit`) now reads the TEB self-pointer at
// `gs:[0x30]` (`NT_TIB.Self`), which is OS-allocated before a thread's first
// instruction runs and is restored by Windows on every context switch by
// construction — the same guarantee `GetLastError`/SEH/FLS/TLS already rest
// on. That answers the question for EVERY thread, including ones this
// provider starts, with no install call at all. So the `tokenPool`/
// `tokenClaim`/`winInstallThreadToken`/`winSetFsBase` machinery that used to
// live here is deleted — a second, unused path documenting a disproven
// design is worse than no path.

extern fn CreateThread(
  attrs: *byte, stackSize: i64, startAddr: *byte,
  param: *byte, flags: i32, threadIdOut: *i32,
): *byte
extern fn CloseHandle(handle: *byte): i32

// `dwCreationFlags`: interpret `stackSize` as the RESERVE size, not the
// initial commit — matches `runtime/root/windows/boot.bit`'s own worker
// bring-up exactly, so a thread started through this provider gets the same
// budget as one started by boot.bit's own (soon to be replaced) inline loop.
const STACK_SIZE_PARAM_IS_A_RESERVATION: i32 = 0x00010000

// ../thread.bit's `threadStackBytes` (16MiB), duplicated per the leaf-provider
// convention — matches ../linux/spawn.bit's actual worker budget; the mapping
// is anonymous and reserved-not-committed on both platforms, so a worker
// occupies address space rather than memory (../thread.bit's own comment on
// the constant).
const threadStackBytes: i64 = 16777216

// `CreateThread`'s `lpThreadId` out-param: no caller ever reads it (the
// HANDLE, not the id, is what a caller joins on), so ONE shared scratch word
// is safe even across CONCURRENT `threadStart` calls — a race on its write is
// harmless because nothing ever reads the result. Same reasoning
// `runtime/root/windows/boot.bit`'s own `winThreadIdScratch` comment gives,
// extended here from "safe across one loop's sequential calls" to "safe
// across any number of concurrent callers", which holds for the identical
// reason: the value is write-only from this module's perspective.
let winThreadIdScratch: i32 = 0

// See ../thread.bit's `threadRunning`. Duplicated, not imported — a
// provider is a leaf.
fn runningSentinel(): int { return 1 }

extern fn bit_rt_gc_thread_exit()

// `int` -> `*i64` and `int` -> `*byte`. A leaf may not import ../../sched's
// `taskAt`, so both casts are spelled here — identical to ../darwin/spawn.bit's.
@nosplit fn wordsAt(addr: int): *i64 {
  let z: *i64 = nil
  return z + addr / 8
}

@nosplit fn bytesAt(addr: int): *byte {
  let z: *byte = nil
  return z + addr
}

// Call the raw code address `entry` with `arg` in the first-argument
// register (rdi on SysV, rcx on Win64 — `input` pins the value into rdi/rcx
// regardless of which register the calling convention itself used to place
// it, exactly the same mechanism `runtime/sched/sched.bit`'s header explains
// at length for `schedSwitch`'s own `old`/`new` pins). A verbatim copy of
// ../darwin/spawn.bit's `invokeRaw` — same encoding, same reason: `entry` is
// a bare code pointer, not a `(code, env)` function value, so no
// `call_value` reaches it.
//
// The clobber list names every caller-saved GPR the call destroys (#3916),
// same reasoning as ../darwin/spawn.bit's copy. `entry`/`arg` occupy x9/x0
// (rax/rcx on this file's Win64 pin) and are excluded as inputs, not
// re-listed as clobbers — rdi is NOT an input here, unlike the SysV copy, so
// it joins this file's x64 clobber list instead.
@nosplit fn invokeRaw(entry: int, arg: int) {
  asm {
    arm64 { 0xD63F0120 } // blr x9 (unreached — x86_64-windows is the
    // only Windows target this toolchain builds;
    // kept for parity, SPEC §11.6 requires both
    // arches in every asm block)
    x64 { 0xFF, 0xD0 } // call rax
    input arm64 x9 x64 rax = entry
    input arm64 x0 x64 rcx = arg
    clobber arm64 {
      x1,
      x2,
      x3,
      x4,
      x5,
      x6,
      x7,
      x8,
      x10,
      x11,
      x12,
      x13,
      x14,
      x15,
      x16,
      x17,
      x18,
      x30,
      memory,
    }
    clobber x64 { rdx, rsi, rdi, r8, r9, r10, r11, memory }
  }
}

// `CreateThread` carries ONE `void *` to the child (`lpParameter`), and the
// trampoline needs three words — the real entry, the real argument, and
// `done`'s address. A fixed pool, not an allocator, for the same reason
// ../darwin/spawn.bit's `trampCells` is one: a provider is a leaf with no
// allocator to call, and a static pool keeps this off the "no unbounded
// allocation after startup" list.
//
// WORD 0 IS STILL THE CLAIM FLAG (`start`, which no real `entryOf` is ever
// 0), exactly as ../darwin/spawn.bit's cells — same three-word stride,
// `trampMax * 3 = 192`.
const trampMax: int = 64
let trampCells: [192]i64

fn trampClaim(start: int, arg: int, doneAddr: int): int {
  let p: *i64 = ptrOf(trampCells)
  let i = 0
  while (i < trampMax) {
    if (atomicCmpxchg(p + i * 3, 0, start)) {
      // Safe unsynchronised: the CAS above makes this cell ours until the
      // child releases it, and the child cannot run before `CreateThread`.
      *(p + i * 3 + 1) = arg
      *(p + i * 3 + 2) = doneAddr
      return int(p) + i * 24
    }
    i = i + 1
  }
  return 0
}

fn trampRelease(cell: int, start: int) {
  let p = wordsAt(cell)
  atomicCmpxchg(p, start, 0)
}

// `*i64` -> `*i32` for the `done` word, the same re-addressing
// `runtime/sched/sched.bit`'s `lockOf` uses for a lock cell: a `*i32` scales
// by 4, so the byte address divided by 4 off the null pointer names the same
// cell (§11.4, low half of the word — both targets are little-endian).
@nosplit fn wordsAtI32(addr: int): *i32 {
  let z: *i32 = nil
  return z + addr / 4
}

// Every OS thread this provider starts enters here, not at the caller's body.
// No token install runs before `invokeRaw` — `gcThreadToken()`'s Windows
// body (#3420, `gs:[0x30]`) is valid from this thread's first instruction
// with no action from this provider at all (see the header). Unlike
// ../darwin/spawn.bit, this trampoline ALSO clears `done` once the body
// returns (see the header's note on #3375: the Darwin provider promises this
// in its own comment but the code has no path to deliver it, because its
// cell carries no `done` pointer at all — this provider's does, precisely so
// `../thread.bit`'s shared `threadJoin` works here without that gap).
//
// NOT `@nosplit`: that attribute forbids the `extern` call
// (`bit_rt_gc_thread_exit`) this exists to make, the same reason
// ../darwin/spawn.bit's own `threadTrampoline` is not `@nosplit` either.
fn threadTrampoline(cell: *byte): *byte {
  let addr = int(cell)
  let p = wordsAt(addr)
  let start = *p
  let arg = *(p + 1)
  let doneAddr = *(p + 2)
  trampRelease(addr, start)

  invokeRaw(start, arg)

  // The last two things this thread does: publish that it is finished, then
  // release its mutator slot so a rendezvous no longer waits on a thread
  // that has gone. Order matches ../darwin/spawn.bit's own
  // `bit_rt_gc_thread_exit()` placement (last Bit code the thread runs).
  if (doneAddr != 0) {
    atomicStore(wordsAtI32(doneAddr), i32(0))
  }
  bit_rt_gc_thread_exit()
  let z: *byte = nil
  return z
}

// Start an OS thread running `start(arg)`. Returns an opaque handle (> 0) for
// `threadRelease`, or 0 on failure.
//
// `start` must be `entryOf(f)` for a named `function f(arg: *byte): *byte`
// obeying the child rules in ../thread.bit. `done` is a caller-owned word
// this function arms; the child clears it before returning (see
// `threadTrampoline` above — this is the one place this provider's contract
// is STRONGER than ../darwin/spawn.bit's identically-worded promise, per
// #3375).
//
// The handle is the raw `HANDLE` `CreateThread` returns. That is what
// actually has to be released on this platform — see ../thread.bit on why
// the handle is opaque and why a caller must not read meaning into the
// number.
export @symbol("bit_rt_port_thread_start") fn threadStart(
  start: *byte,
  arg: *byte,
  done: *i32,
): int {
  // Armed BEFORE the create, not after: the child can run to completion and
  // clear this word before `CreateThread` has even returned. Arming it
  // afterwards would overwrite the child's 0 with 1 and strand every joiner
  // until its deadline — same ordering ../darwin/spawn.bit uses.
  atomicStore(done, i32(runningSentinel()))

  let cell = trampClaim(int(start), int(arg), int(done))
  if (cell == 0) {
    // Pool exhausted: `trampMax` starts are already in flight. Refused
    // rather than started unwrapped, same as ../darwin/spawn.bit.
    atomicStore(done, i32(0))
    return 0
  }

  let nullAttrs: *byte = nil
  let handle = CreateThread(
    nullAttrs, threadStackBytes, entryOf(threadTrampoline),
    bytesAt(cell), STACK_SIZE_PARAM_IS_A_RESERVATION, ptrOf(winThreadIdScratch),
  )
  if (int(handle) == 0) {
    // No thread exists, so nothing will ever clear `done`. Disarm it so a
    // caller that joins anyway gets `threadJoinDone` immediately rather than
    // waiting out a full deadline for a thread that was never created;
    // release the trampoline cell so a later start can reuse it.
    trampRelease(cell, int(start))
    atomicStore(done, i32(0))
    return 0
  }
  return int(handle)
}

// Release a finished thread's resources. Call only after `threadJoin` has
// reported `threadJoinDone` (or after directly polling `done`/waiting on the
// handle some other way).
//
// `CloseHandle` on a `CreateThread` handle does not block — unlike
// `pthread_join`, which is why ../darwin/spawn.bit's analogous function
// documents a residual wait. Nothing here can hang: by the time this is
// called the thread has already published its completion (`threadTrampoline`
// cleared `done` before returning), so reclaiming the handle is immediate.
export @symbol("bit_rt_port_thread_release") fn threadRelease(handle: int): bool {
  if (handle == 0) {
    return false
  }
  let z: *byte = nil
  return int(CloseHandle(z + handle)) != 0
}

// ---------------------------------------------------------------------------
// Publishing a thread's real stack top (#3492, unblocks #2649)
// ---------------------------------------------------------------------------
//
// #2649 added a cross-module call from the platform-free `../../gc/gcworldsync.bit`
// to `bit_rt_port_thread_stack_top`, exported by ../linux/spawn.bit and
// ../darwin/spawn.bit (#2647/#2648) but not here, which fails the
// x86_64-windows PE link (the symbol is genuinely absent from the archive,
// surfaced through `compiler/peimport.bit`'s admitted-import-surface check
// rather than as a plain undefined-symbol error). THIS IS A REAL
// IMPLEMENTATION, NOT A STUB: NT_TIB.StackBase, at `gs:[0x08]` on x64
// Windows, is the OS-maintained highest address of the calling thread's own
// stack (Windows stacks grow down, so StackBase is the top, matching what
// ../linux/spawn.bit's registration table and ../darwin/spawn.bit's
// `pthread_get_stackaddr_np` both answer for their platforms). It answers
// for ANY thread — the boot thread and every `CreateThread`'d worker alike —
// because the TEB is OS-allocated before the thread's first instruction
// runs, the exact same property `../../gc/windows/gcthread.bit`'s
// `gcThreadToken` already relies on for `gs:[0x30]` (`NT_TIB.Self`). That
// file's `gs:[0x30]` load and this one's `gs:[0x08]` load are the SAME
// instruction shape at a different NT_TIB offset (layout: ExceptionList
// 0x00, StackBase 0x08, StackLimit 0x10, SubSystemTib 0x18, FiberData 0x20,
// ArbitraryUserPointer 0x28, Self 0x30) — one segment-relative load, no
// call, satisfying this function's `@nosplit` contract exactly the way
// `gcThreadToken`'s does.
//
// `65 48 8B 04 25 08 00 00 00` = `movq %gs:0x08, %rax`: GS segment-override
// prefix (0x65), REX.W (0x48), MOV r64,r/m64 (0x8B), ModRM 0x04 (mod=00,
// reg=rax, rm=100=SIB-follows), SIB 0x25 (no index, disp32-only base), then
// 0x08 as a little-endian disp32.
//
// Pinned like every other cross-module door in this file
// (`bit_rt_port_thread_start`/`_release`): its one intended caller,
// `../../gc/gcworldsync.bit`'s claim path (#2649), is a different module,
// and an unpinned export there would be emitted as `m<N>$threadStackTop`, a
// name no separately emitted object can define (SPEC §11.9). x64 only —
// ARM64 Windows is out of scope for this port (epic #3322's Details:
// "Target is x86_64-windows only"), so there is no arm64 payload to carry;
// `result arm64 x0` is a nominal register name never reached by codegen for
// an x86_64-windows build, matching ../../gc/windows/gcthread.bit's own
// shape.
export @nosplit @symbol("bit_rt_port_thread_stack_top") fn threadStackTop(): int {
  return asm {
    x64 { 0x65, 0x48, 0x8B, 0x04, 0x25, 0x08, 0x00, 0x00, 0x00 }
    result arm64 x0 x64 rax : int
  }
}

// This thread's real stack BASE — NT_TIB.StackLimit at `gs:[0x10]` (#3516),
// the low end of the same mapping StackBase above names the high end of
// (layout in the header comment above: ExceptionList 0x00, StackBase 0x08,
// StackLimit 0x10, ...). Same segment-relative load shape as StackBase, no
// Win32 call, so this needs no new entry in the admitted PE import surface
// (`compiler/peimport.bit`) — the exact hazard #2649/#3492 hit for
// `threadStackTop` itself.
//
// `65 48 8B 04 25 10 00 00 00` = `movq %gs:0x10, %rax`: identical encoding to
// StackBase's load above, disp32 0x10 in place of 0x08.
export @nosplit @symbol("bit_rt_port_thread_stack_base") fn threadStackBase(): int {
  return asm {
    x64 { 0x65, 0x48, 0x8B, 0x04, 0x25, 0x10, 0x00, 0x00, 0x00 }
    result arm64 x0 x64 rax : int
  }
}
