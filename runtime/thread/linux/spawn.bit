// Linux OS-thread provider for the Stage-2 port of runtime/sched.zig's worker
// pool (#1403). See ../thread.bit for the shared contract, the seam against
// #1364, and — importantly — the three rules a child thread's body must obey.
//
// Raw `clone(2)` (§11.8) rather than `pthread_create`, for the reason the whole
// runtime uses syscalls: the ELF output is fully static, with no libc to call
// into. `extern function` is rejected outright on both Linux targets (E0078),
// so there is no other path even in principle.
//
// EVERY CONSTANT BELOW WAS READ OUT OF THE PINNED ZIG STDLIB, NOT FROM MEMORY —
// syscall numbers from std/os/linux/syscalls.zig (`X64`/`Arm64` enums), the
// clone flags from std/os/linux.zig's `CLONE`, and the per-architecture
// argument ORDER from the hand-written `clone` in std/os/linux/{x86_64,
// aarch64}.zig. A wrong number here is a silent wrong-syscall, not a compile
// error; tests/stress/threadlinux issues every one of them against the real
// kernel.
//
// This file imports nothing, exactly as runtime/alloc's, runtime/rand's and
// runtime/park's providers do not — so the two status literals it shares with
// ../thread.bit are duplicated here rather than imported.
// tests/stress/thread/props pins the two spellings against each other so the
// duplication cannot drift. Its sibling ./tls.bit is the same module, so the TLS
// block this file installs needs no import either; only that file reaches out,
// to ../../auxv, and only for the auxv accessor `getauxval`.

// Syscall numbers are per-architecture and Bit has no arch-conditional
// compilation, so the number is selected at run time (§11.8). `hostTarget()` is
// 0 for x86_64-linux and 1 for aarch64-linux; this module is only ever built
// for a Linux target, so the two cases are exhaustive. Same shape as
// runtime/alloc/linux/pages.bit.
function nr(x64: int, arm64: int): int {
  if (hostTarget() == 0) {
    return x64
  }
  return arm64
}

function nrClone(): int { return nr(56, 220) }
function nrMmap(): int { return nr(9, 222) }
function nrMunmap(): int { return nr(11, 215) }
function nrMprotect(): int { return nr(10, 226) }

// PROT_NONE (0) for the whole reservation, then PROT_READ|PROT_WRITE (3) for
// everything above the guard page.
function protNone(): int { return 0 }
function protReadWrite(): int { return 3 }

// MAP_PRIVATE (0x02) | MAP_ANONYMOUS (0x20). Anonymous mappings ignore the fd,
// which is passed as -1 by convention.
function mapPrivateAnon(): int { return 34 }

// 4096 on both x86_64 and aarch64 Linux, the same value and the same
// justification as runtime/alloc/linux/pages.bit's `pageSize`. Used here only
// as the size of the guard page, where being too small is the only thing that
// could matter — and it is not, because a guard is a lower bound on protection,
// not an exact requirement.
function pageSize(): int { return 4096 }

// See ../thread.bit's `threadRunning`. Duplicated, not imported, because a
// provider is a leaf.
function runningSentinel(): int { return 1 }

// ---- the child's exit path (#1801) ---------------------------------------
//
// `bit_rt_gc_thread_exit` releases this OS thread's mutator slot (ABI.md §6). A
// child that ALLOCATES claims one lazily (#1431), and a leaked slot stays
// `running` forever — which corrupts nothing but makes every later rendezvous
// expire, i.e. collection quietly stops. Measured on native x86_64 linux: 247 of
// `tests/stress/gcthreadslinux`'s 292 abandoned collections were blocked on an
// exited child's slot.
//
// THE OBLIGATION BELONGS HERE, NOT IN THE CHILD BODY. ABI.md §6 used to ask
// "user code that starts a raw OS thread" to make this call itself, which is a
// rule every future caller has to remember and whose penalty for forgetting is
// silent: collection stops, nothing fails. This provider owns the child's whole
// exit path — the `asm` below is the only code that runs after the body returns
// — so it is the one place that can discharge it unconditionally.
//
// Declared and called directly rather than imported from `../../gc`: the live
// registry in a normally linked program is `root.zig`'s, not the Bit module's,
// whose `worldAddr` is bound only by `runtime/root`'s own boot. The symbol IS in
// the linked archive (E0078 admits it, #1444) — the same call and the same
// reason as tests/stress/chan/race/race.bit's.
extern function bit_rt_gc_thread_exit()

// The child's epilogue: the last Bit code an OS thread started here ever runs.
//
// Reached by an indirect `call`/`blr` from `cloneChild`'s child path, through the
// word `threadStart` parked at the top of the child's own stack — see
// `exitCellBytes`. It takes no arguments and returns normally; the `asm` clears
// the on-stack flag and issues `SYS_exit` immediately afterwards.
//
// NOT `@nosplit`, because that attribute forbids the `extern` call this exists
// to make. It contains no loop and allocates nothing, so codegen emits no
// safepoint in it — which matters: a poll here would re-claim through the lazy
// registration door the release just closed and leak the slot again.
function threadEpilogue() {
  bit_rt_gc_thread_exit()
}

// Bytes taken off the top of the child's usable stack for the two words the
// child's exit path needs. Sixteen, which is also the alignment both ABIs
// require at a function entry, so the child's initial stack pointer stays
// conforming.
//
// The cell sits ABOVE that stack pointer, so every frame the body pushes —
// starting with the return address `call`/`blr` writes — lands below it and
// neither word can be overwritten while the body runs.
//
//   [childSp + 0]  `threadEpilogue`'s entry address, written before the clone.
//   [childSp + 8]  the ON-STACK FLAG, `threadRelease`'s gate. See `stillOnStack`.
function exitCellBytes(): int { return 16 }

function onStackFlagOffset(): int { return 8 }

// A `*i32` for a raw address. The flag is 32-bit rather than a full word so it
// can be read with `atomicLoad`, whose operand is a typed pointer — a plain load
// in `threadRelease`'s poll would be a load the optimiser may hoist out of the
// loop, i.e. a spin on a value that can never change.
function i32Ptr(addr: int): *i32 {
  let z: *i32 = nil
  return z + (addr / 4)
}

// Whether the child may still touch its own stack mapping.
//
// WHY THIS WORD EXISTS AT ALL, and why `done` cannot serve. `threadRelease`
// unmaps the child's stack, so it must not run while the child is still standing
// on it. Its previous licence to do so was that `done` is the CLONE_CHILD_CLEARTID
// word, cleared by the kernel during teardown — after the child has left user
// space. But a child BODY may also clear `done` itself (the Darwin half of the
// contract requires it, so bodies shared between platforms do it unconditionally),
// and then the signal is indistinguishable from the kernel's while the child is
// still running. Before #1801 the child had two register-only instructions left
// at that point and survived being unmapped; it now has a whole call to make, so
// the window had to be closed rather than narrowed.
//
// The flag is armed before the clone and cleared by the `asm` AFTER the epilogue
// returns, as the child's LAST memory access of any kind — everything past it is
// `SYS_exit` in registers. So a zero here means the mapping is provably idle,
// whoever cleared `done` and whenever.
function stillOnStack(childSp: int): bool {
  return int(atomicLoad(i32Ptr(childSp + onStackFlagOffset()))) != 0
}

// Iterations `threadRelease` waits for the flag to clear.
//
// This is not a timeout on the child's WORK: it is only ever reached after the
// child's body has returned, so what it waits for is the epilogue's handful of
// atomic operations plus one store. Sized far above that, and bounded rather than
// unbounded because a Power-of-10 loop must be — expiry means refusing to unmap
// rather than unmapping unsafely, which costs address space and nothing else.
function onStackSpinBound(): int { return 1000000 }

// ../thread.bit's `threadStackBytes` (16MiB — Zig's `default_stack_size`, which
// is what `sched.zig`'s `std.Thread.spawn(.{}, ...)` takes by default).
// Duplicated for the same leaf reason; tests/stress/thread/props pins the two
// spellings against each other so they cannot drift.
function stackBytes(): int { return 16777216 }

// The whole reservation: one leading guard page, the usable stack, and the
// thread's TLS area above it. Named once because `threadStart` and
// `threadRelease` MUST agree on it — an munmap length that disagreed with the
// mmap length would unmap the wrong extent.
//
// `tlsAreaBytes()` (./tls.bit) is a pure function of the running image's PT_TLS,
// which cannot change while the process lives, so the two calls below are the
// same number even though the two functions never communicate. Folding TLS into
// the stack's own mapping — as Zig's `LinuxThreadImpl.spawn` also does — is what
// makes a thread's TLS block impossible to leak: releasing the stack releases it.
//
// Returns `tlsUnavailable` when the geometry could not be derived, which
// `threadStart` turns into a refused spawn. It never guesses a size.
function reservationBytes(): int {
  let tls = tlsAreaBytes()
  if (tls == tlsUnavailable) {
    return tlsUnavailable
  }
  return pageSize() + stackBytes() + tls
}

// The clone flags for a THREAD (as opposed to a process): one address space,
// one file-descriptor table, one signal-handler table, one thread group.
//
//   CLONE_VM        0x00000100   share the address space
//   CLONE_FS        0x00000200   share cwd / umask / root
//   CLONE_FILES     0x00000400   share the fd table
//   CLONE_SIGHAND   0x00000800   share signal handlers (requires VM)
//   CLONE_THREAD    0x00010000   same thread group (requires SIGHAND)
//   CLONE_SYSVSEM   0x00040000   share SysV semaphore undo state
//   CLONE_SETTLS    0x00080000   set the child's thread pointer from arg 4/5
//   CLONE_CHILD_CLEARTID 0x00200000  clear+wake the ctid word at thread exit
//
// = 0x2D0F00 = 2952960.
//
// CLONE_SETTLS IS WHAT GIVES THE CHILD ITS OWN TLS BLOCK (#1417). Without it a
// child inherits the parent's thread pointer and the two SHARE one block, which
// is why this file omitted the flag until the block could actually be built, and
// why ../thread.bit used to forbid a child `!`/`fail`/`?` — those lower to a
// thread-local error slot, and the child would have written the parent's.
// ./tls.bit builds the block and hands back the thread pointer to pass here; see
// that file for how the geometry is derived from `PT_TLS` rather than guessed.
//
// ONE OF ZIG'S FLAGS IS STILL DELIBERATELY ABSENT:
//
//   CLONE_PARENT_SETTID is dropped because `clone` already RETURNS the child's
//   tid to the parent. Zig wants the tid in a fixed field of its `Instance`;
//   this contract hands back an opaque handle instead, so there is nothing for
//   the kernel to write and no word to allocate for it.
//
// CLONE_DETACHED is also absent: modern kernels ignore it entirely (it was
// removed in 2.6), and Zig passes it only as inherited habit.
//
// The value of CLONE_SETTLS, like every other flag here, was read out of the
// pinned Zig stdlib (`std/os/linux.zig`'s `CLONE` struct), not from memory.
function cloneThreadFlags(): int { return 2952960 }

// Reserve a guarded stack and return its base, or 0 if the kernel refuses.
//
// This is `sched.zig`'s `mapGuardedStack`: reserve `guard + usable` as
// PROT_NONE, then make everything above the guard page readable and writable.
// The guard page is the whole point — without it a stack overflow silently
// walks into whatever mapping happens to sit below, which on a thread that the
// collector does not know about would be corruption with no symptom. With it,
// the same overflow is an immediate SIGSEGV at a known address.
//
// The reservation is mapped PROT_NONE first and opened up second, rather than
// mapped RW and then closed off, so there is never a window in which the guard
// page is writable.
function mapStack(usable: int): int {
  let total = pageSize() + usable
  let base = int(syscall(nrMmap(), 0, i64(total), i64(protNone()),
                         i64(mapPrivateAnon()), 0 - 1, 0))
  if (base <= 0) {
    return 0
  }
  let rc = int(syscall(nrMprotect(), i64(base + pageSize()), i64(usable),
                       i64(protReadWrite())))
  if (rc != 0) {
    // The reservation exists but is unusable; hand it straight back rather
    // than leaking address space on a path that is about to report failure.
    let dead = int(syscall(nrMunmap(), i64(base), i64(total)))
    return 0
  }
  return base
}

// `clone(2)` with a child that branches to `entry` instead of returning.
//
// WHY THIS MUST BE `asm` AND CANNOT BE A `syscall` EXPRESSION. The child of a
// raw `clone` resumes with the stack pointer set to `stackTop` — a fresh
// mapping that holds none of this function's frame. It therefore cannot return
// to its caller, and it cannot execute any Bit code that addresses a local,
// because every one of those addresses belongs to the parent's stack. The
// child's very first action has to be a branch to somewhere that expects a bare
// stack. `syscall` is an expression whose value flows back into the enclosing
// frame, so it cannot express that; a single `asm` block that tests the return
// value and diverges can.
//
// It needs no relocation and therefore nothing §11.6 lacks: the branch target
// arrives in a REGISTER (`entryOf`, §11.10), so this is a register-indirect
// `blr`/`call`, not a symbolic one. That was the open question when #1403's
// first half stopped here, and it is settled — `tests/stress/entryof` proved
// the identical "load an address, branch to it" pattern on all three targets
// before this file was written.
//
// THE PER-ARCHITECTURE ARGUMENT ORDER IS THE TRAP IN THIS FUNCTION. The kernel
// swaps clone's 4th and 5th arguments between the two architectures — x86_64
// selects CONFIG_CLONE_BACKWARDS, arm64 does not:
//
//   x86_64:  clone(flags, stack, ptid, CTID, TLS)   rdi rsi rdx r10 r8
//   aarch64: clone(flags, stack, ptid, TLS, CTID)   x0  x1  x2  x3  x4
//
// Read out of the hand-written asm in std/os/linux/x86_64.zig and
// std/os/linux/aarch64.zig, whose register shuffles state it unambiguously.
// The `input` lines below pair registers BY MEANING rather than by position,
// which is what absorbs the swap: the `ctid` line names r10 on x64 and x4 on
// arm64, and the `tls` line names r8 and x3. Getting this backwards would pass
// a pointer where the kernel expects a TLS base — a silently wrong thread
// rather than a failed call.
//
// Registers the CHILD destroys (the frame pointer it zeroes, the link register
// `blr` overwrites) are deliberately NOT in the clobber list. A clobber is a
// statement about the code path that CONTINUES, and only the parent does: the
// parent executes the syscall, sees a nonzero result, and jumps clear of the
// child block without touching either register. The child never returns to Bit
// code at all, so what it destroys is unobservable. Declaring the frame pointer
// clobbered would instead evict it from the enclosing function for no reason.
//
// The child zeroes its frame pointer for the same reason Zig's `clone` does: it
// terminates any stack walk cleanly at the thread's base rather than letting a
// walker follow an inherited pointer into the parent's stack.
//
// AFTER THE BODY RETURNS THE CHILD CALLS ONE MORE THING (#1801), and it reaches
// it through MEMORY rather than a register: `[stackTop]` holds the epilogue
// address `threadStart` parked there. A register would not do — the clone copies
// the parent's registers into the child, but the body is an ordinary C-ABI
// callee, so only the callee-saved ones survive it, and naming one of those here
// would evict it from the enclosing function for the whole call. The word above
// the child's own stack pointer is untouched by every frame the body pushes, so
// it survives by construction. See `epilogueCell`.
//
// Returns the child's tid (> 0) in the parent, or a negative errno.
function cloneChild(flags: int, stackTop: int, ctid: *i32,
                    entry: *byte, arg: *byte, tls: int): int {
  return asm {
    // arm64, one 32-bit word per instruction:
    //   svc  #0            issue clone
    //   cbnz x0, +11       parent (x0 = child tid) -> skip the 10 child words
    //   mov  x29, #0       child: terminate the frame-pointer chain
    //   mov  x0, x6        child: arg -> first C argument
    //   blr  x5            child: enter the body
    //   ldr  x9, [sp]      child: the epilogue address `threadStart` parked there
    //   blr  x9            child: release this thread's mutator slot
    //   add  x9, sp, #8    child: the on-stack flag's address
    //   stlr wzr, [x9]     child: LAST memory access — the stack is now idle
    //   mov  x8, #93       child: SYS_exit
    //   mov  x0, #0        child: status 0
    //   svc  #0            child: never returns
    //
    // `stlr` rather than a plain `str` so the release above cannot be reordered
    // after the publication of it; x86-64's store is already ordered against the
    // stores before it, which is why its arm needs no counterpart.
    arm64 { 0xD4000001, 0xB5000160, 0xD280001D, 0xAA0603E0, 0xD63F00A0,
            0xF94003E9, 0xD63F0120, 0x910023E9, 0x889FFD3F,
            0xD2800BA8, 0xD2800000, 0xD4000001 }
    // x64, one byte per element:
    //   0F 05              syscall
    //   48 85 C0           test rax, rax
    //   75 1C              jnz +28 (parent -> skip the 28 child bytes)
    //   31 ED              xor ebp, ebp
    //   4C 89 EF           mov rdi, r13     (arg -> first C argument)
    //   41 FF D4           call r12         (enter the body)
    //   FF 14 24           call [rsp]       (release this thread's mutator slot)
    //   C7 44 24 08 ...    mov dword [rsp+8], 0   (LAST memory access)
    //   B8 3C 00 00 00     mov eax, 60      (SYS_exit)
    //   31 FF              xor edi, edi
    //   0F 05              syscall
    x64 { 0x0F, 0x05, 0x48, 0x85, 0xC0, 0x75, 0x1C,
          0x31, 0xED, 0x4C, 0x89, 0xEF, 0x41, 0xFF, 0xD4,
          0xFF, 0x14, 0x24,
          0xC7, 0x44, 0x24, 0x08, 0x00, 0x00, 0x00, 0x00,
          0xB8, 0x3C, 0x00, 0x00, 0x00, 0x31, 0xFF, 0x0F, 0x05 }
    result arm64 x0 x64 rax : int
    input arm64 x8 x64 rax = nrClone()
    input arm64 x0 x64 rdi = flags
    input arm64 x1 x64 rsi = stackTop
    input arm64 x2 x64 rdx = 0
    // ctid: clone argument 4 on x86_64, argument 5 on aarch64.
    input arm64 x4 x64 r10 = int(ctid)
    // tls: clone argument 5 on x86_64, argument 4 on aarch64. The child's
    // thread pointer, which CLONE_SETTLS tells the kernel to install — into
    // TPIDR_EL0 on aarch64 and FS_BASE on x86-64. Built by ./tls.bit.
    input arm64 x3 x64 r8 = tls
    // Carried across the syscall for the child's use only. The kernel copies
    // the parent's registers into the child, so these survive into it.
    input arm64 x5 x64 r12 = int(entry)
    input arm64 x6 x64 r13 = int(arg)
    // The x86_64 `syscall` instruction destroys rcx and r11 architecturally.
    // `memory` is a compiler barrier, not a register: the child writes through
    // `ctid` and `arg` behind the optimiser's back.
    clobber x64 { rcx, r11, memory }
    clobber arm64 { memory }
  }
}

// Start an OS thread running `entry(arg)`. Returns an opaque handle (> 0) for
// `threadRelease`, or 0 on failure.
//
// `entry` must be `entryOf(f)` for a named `function f(arg: *byte): *byte`
// obeying the child rules in ../thread.bit. `done` is a caller-owned word this
// function arms; the KERNEL clears it at thread exit, via CLONE_CHILD_CLEARTID.
//
// The handle is the stack mapping's base address. That is what actually has to
// be released on this platform, and the caller never needs the tid — see
// ../thread.bit on why the handle is opaque.
//
// THE TWO EXIT SIGNALS ARE ORDERED, and in the direction a joiner needs: the
// child runs `threadEpilogue` — releasing its mutator slot — while still in user
// space, and the kernel clears `done` afterwards, during teardown. So a caller
// that observes `done == 0` also observes a released slot, and the collection it
// runs next cannot be held up by the child that just finished (#1801).
export @symbol("bit_rt_port_thread_start") function threadStart(entry: *byte, arg: *byte, done: *i32): int {
  // Refuse before mapping anything if this image's TLS geometry cannot be read.
  // A thread without a correct TLS block is not a degraded thread, it is a
  // corrupting one — it would write its thread-locals over another thread's —
  // so this reports failure rather than falling back to a guessed layout or to
  // sharing the parent's block.
  let tlsBytes = tlsAreaBytes()
  if (tlsBytes == tlsUnavailable) {
    return 0
  }
  let base = mapStack(stackBytes() + tlsBytes)
  if (base == 0) {
    return 0
  }
  // The top of the STACK, which is what the child's stack grows DOWN from.
  // Page-aligned by construction, so it — and `childSp` below, a multiple of 16
  // beneath it — satisfies both ABIs' 16-byte alignment requirement at a function
  // entry. The TLS area occupies `[top, top + tlsBytes)` — above the stack, which
  // grows away from it, so the two can never collide.
  let top = base + pageSize() + stackBytes()

  // Build this child's TLS block before the clone: it must be complete the
  // instant the child runs, since the child's very first Bit code may touch a
  // thread-local.
  let tp = tlsPrepare(top)
  if (tp == 0) {
    let dead = int(syscall(nrMunmap(), i64(base), i64(reservationBytes())))
    return 0
  }

  // The child's initial stack pointer, one cell below the top of the usable
  // stack — and the cell that opens up carries the two words its exit path needs
  // (#1801): how to reach `threadEpilogue`, and the flag that says it is still
  // standing here. Both are written BEFORE the clone, because the child can run
  // to completion before `clone` has even returned in this frame.
  let childSp = top - exitCellBytes()
  storeWord(childSp, int(entryOf(threadEpilogue)))
  atomicStore(i32Ptr(childSp + onStackFlagOffset()), i32(1))

  // Armed BEFORE the clone, not after: the child can exit and the kernel can
  // clear this word before `clone` has even returned in the parent. Arming it
  // afterwards would overwrite the kernel's 0 with 1 and strand every joiner
  // until its deadline.
  atomicStore(done, i32(runningSentinel()))

  let tid = cloneChild(cloneThreadFlags(), childSp, done, entry, arg, tp)
  if (tid <= 0) {
    // No thread exists, so nothing will ever clear `done`. Disarm it so a
    // caller that joins anyway gets `threadJoinDone` immediately instead of
    // waiting out a full deadline for a thread that was never created.
    atomicStore(done, i32(0))
    let dead = int(syscall(nrMunmap(), i64(base), i64(reservationBytes())))
    return 0
  }
  return base
}

// Release a finished thread's resources. Call only after `threadJoin` has
// reported `threadJoinDone`.
//
// IT NO LONGER TAKES `done` AT ITS WORD (#1801). Unmapping the child's stack is
// safe only once the child has stopped standing on it, and `done` does not prove
// that — a child body may clear it itself, and one written against the Darwin
// half of the contract does. So this gates on the provider's own on-stack flag,
// which only the child's exit path clears and only as its final memory access.
// See `stillOnStack`.
export @symbol("bit_rt_port_thread_release") function threadRelease(handle: int): bool {
  if (handle <= 0) {
    return false
  }
  // Same extent `threadStart` mapped, including the TLS area above the stack —
  // see `reservationBytes` on why recomputing it here provably agrees. A thread
  // that was started at all had a derivable geometry, so this cannot be
  // `tlsUnavailable`; the guard is a refusal to unmap a wrong length rather than
  // a reachable path.
  let total = reservationBytes()
  if (total == tlsUnavailable) {
    return false
  }
  let childSp = handle + pageSize() + stackBytes() - exitCellBytes()
  let spins = 0
  while (stillOnStack(childSp)) {
    if (spins >= onStackSpinBound()) {
      // The child is still on this stack, so unmapping it would be a
      // use-after-free. Leaking the reservation is the only safe answer, and it
      // is reported as a failed release rather than hidden.
      return false
    }
    spins = spins + 1
  }
  return int(syscall(nrMunmap(), i64(handle), i64(total))) == 0
}
