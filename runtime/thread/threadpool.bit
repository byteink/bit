// Bringing a scheduler's worker pool UP and DOWN on real OS threads: the
// `Scheduler.start()`/`.join()` composition (#1607). Sibling of `thread.bit`, so
// the same module — it reaches `threadJoin`/`threadRunning`/`threadJoinDone`
// with no import.
//
// ---------------------------------------------------------------------------
// WHAT THIS OWNS, AND WHY IT LIVES HERE RATHER THAN IN runtime/sched
// ---------------------------------------------------------------------------
//
// `runtime/sched` already exports every PIECE — `schedInit`, `schedSpawn`,
// `schedWorkerRun`, `schedWorkerAt`, `schedShutdown` — and `runtime/thread`
// exports `threadStart`/`threadJoin`/`threadRelease`. What did not exist as
// callable runtime Bit is the loop that COMPOSES them: iterate the worker array,
// spawn one OS thread per worker each entering `schedWorkerRun`, then reap
// exactly the threads that were started. That glue lived only inside stress
// drivers (`_tests_/stress/chanracelinux`, `_tests_/stress/schedpoollinux`,
// `_tests_/stress/thread/props`); `Scheduler.start` (runtime/sched/:966+) and `.join`
// (runtime/sched/:1283) are where that composition lives on the sched side. This
// file is that loop and nothing more — no run-queue, work-stealing,
// context-switch or park decision, which all live in `runtime/sched`.
//
// It lives on runtime/thread's consumer side (one of the three homes #1607
// names) rather than in runtime/sched for a concrete reason: `schedJoin` reaps
// through `threadJoin`, and `runtime/sched` may not CALL `threadJoin` and stay
// freestanding-emittable. A freestanding module can reference a cross-module
// runtime function only by a stable `@symbol` name, but `threadJoin` takes
// function-value parameters (`sleepFn`/`monoFn`), which `@symbol` refuses (E0079:
// "the C ABI has no representation for a GC-managed Bit value"). So the reaper
// belongs in `threadJoin`'s own module, where the call is same-module and needs
// no pin. `schedStart` reaches `runtime/sched` only through the two CONSTS that
// describe the worker array's layout — `scWorkers`, `workerWords` — which inline
// as compile-time values and so keep this file freestanding-emittable too.
//
// ---------------------------------------------------------------------------
// THE BOOT CONTRACT (#1608 sequences against this)
// ---------------------------------------------------------------------------
//
// PRECONDITION of `schedStart`: the scheduler is fully populated on the calling
// (boot) thread BEFORE any worker thread exists:
//
//   - the heap and collector are up (boot owns that step, not this one), and
//   - `schedInit(s, workersAddr, n)` has run, so every worker block AND its
//     deque are initialized, and
//   - every initial task has been placed and registered (`schedSpawn`, or the
//     `schedRegister` + `dqPushBottom` pair the stress harnesses use), so no
//     worker can ever steal a task that is not yet on the registry.
//
// That ordering is why there is no register-before-steal race to manage HERE:
// `schedInit` publishes every deque synchronously on one thread before
// `schedStart` creates the first OS thread, so a worker that steals on its very
// first `schedFindWork` reads a deque built happens-before its thread existed.
// The register-before-steal invariant is the CALLER's (populate fully, THEN
// start); `schedStart` enforces the "then" by being the only thing that makes a
// worker runnable on hardware.
//
// POSTCONDITION of `schedStart`: it returns the number of workers actually
// brought up (== `n` on success). Each started worker runs `schedWorkerRun` on
// its own OS thread and will drive green tasks until `schedShutdown(s)` is
// signalled and no work remains. The scheduler is ready to run the first green
// thread the instant the first worker is up.
//
// `schedJoin` WAITS ON every started worker's `done` word reaching 0, which
// `runtime/thread`'s contract guarantees means the worker has left
// `schedWorkerRun` for good. It returns only once every started thread has both
// joined and released, so a caller that has called `schedShutdown` then
// `schedJoin` knows no worker still touches scheduler or task state — the
// precondition for reading a final verdict or tearing the heap down.
//
// ---------------------------------------------------------------------------
// THE STARTED-ONLY REAP SET
// ---------------------------------------------------------------------------
//
// `schedJoin` is driven by the COUNT `schedStart` returned, not by the size of
// the worker array. A caller may hold an array of `k` workers and bring up only
// `n < k` of them (or `schedStart` may stop early at the first spawn failure);
// either way `join` must touch exactly the threads that were started and must
// not read a `done` word or handle for a worker that never ran. Mirroring
// `Scheduler.join`'s "reap only what `start` spawned", the returned count is
// that set, and `schedJoin` walks `[0, started)` and no further.
//
// ---------------------------------------------------------------------------
// THE WORKER ENTRY IS CONSUMER-PROVIDED, BY NECESSITY
// ---------------------------------------------------------------------------
//
// `entry` is `entryOf(f)` for a worker body the CONSUMER declares — the shape
// `raceWorkerEntry`/`poolWorkerEntry` already have. This module cannot supply a
// generic one, and the reason is structural: a worker body calls
// `schedWorkerRun(w, nowFn, pollFn)`, and its `nowFn`/`pollFn` are the platform
// clock and poller. A child thread receives only a `*byte` argument, so it
// cannot be handed those as function values — it must NAME them, which a
// pure-scheduler embedding does as `schedNoTimers`/`schedNoPoller` and a
// consumer with I/O does as `parkMonoNs`/`pollDrain`. Materialising a function
// value that way also allocates a closure on the managed heap, which is exactly
// what a freestanding module may not do. So the entry stays where the seam is
// chosen, and this file only spawns and reaps it. The entry MUST unpack the
// two-word argument block below and clear its `done` word on the way out.
//
// ---------------------------------------------------------------------------
// THE PLATFORM SEAM
// ---------------------------------------------------------------------------
//
// `threadStart`/`threadRelease` reach the OS through `syscall` (Linux) or
// `extern` (Darwin), which §11.7/§11.8 reject even as an uncalled declaration in
// the wrong module — so this file, like the scheduler core, imports NEITHER
// provider and takes the two as function VALUES (`startFn`/`releaseFn`). The
// consumer binds its platform's pair. `threadJoin` is platform-free (same
// module), so it is called directly, and `sleepFn`/`monoFn` are the clock pair
// it needs (`runtime/park`'s `parkSleepNs`/`parkMonoNs`).

import { scWorkers, workerWords, WorkerLaunch } from "../sched"

// The per-worker argument block is two words — {worker address, done-word
// address} — the shape a worker entry unpacks from its `*byte` argument.
const argWords: int = 2

// Arm worker `i`'s start block and done word, and return the `*byte` argument
// its OS thread entry will unpack. Everything `schedStart` does per worker
// EXCEPT the platform spawn itself, split out so a caller that cannot spell a
// function value — the runtime's own boot path, which must emit `--freestanding`
// (§17.6) and so may not build the `(code, env)` cell `startFn` would need —
// still shares this arming with `schedStart` instead of copying it.
//
// Pinned port-internal (`bit_rt_port_thread_start_arm`): `runtime/root/<os>`
// calls it across a module boundary and a freestanding object can name a
// cross-module callee only through a stable `@symbol` (§11.9, ABI.md §9).
// `bit_rt_port_` marks it non-ABI and temporary, so #1369's rename skips it.
export @symbol("bit_rt_port_thread_start_arm")
fn schedStartArm(s: *i64, i: int, argArea: *i64, doneArea: *i32): *byte {
  let block = argArea + i * argWords
  // The worker block's address — `schedWorkerAt(s, i)` computed inline off the
  // layout consts, so no cross-module call breaks a freestanding emit.
  *block = *(s + scWorkers) + i * workerWords * 8
  let done = doneArea + i
  *(block + 1) = int(done)

  // Arm the done word BEFORE the thread can clear it, so a later join that
  // observes 0 always means the worker finished rather than never started.
  atomicStore(done, i32(threadRunning))
  let bp: *byte = nil
  return bp + int(block)
}

// Bring up `n` OS worker threads, one per worker block `[0, n)`, each entering
// `launch.entry` on its own OS thread. Returns the number actually started:
// `n` on success, or the index of the first failed spawn (so `[0, that)` are
// up).
//
// `launch` (`WorkerLaunch`, `../sched`, #2567 — grouped to clear E0202 without
// a new allocation: every call site already builds this recipe as five loose
// locals, so the composite literal there replaces five arguments with one
// rather than this function constructing anything itself) owns the three
// caller-owned areas, each sized for `n` and filled/armed here:
//   argArea    `n` blocks of `argWords` i64 — {worker address, done-word address}
//   doneArea   `n` i32 done words — each armed to `threadRunning`
//   handleArea `n` i64 handle slots — each spawn's handle, for `schedJoin`
//
// `launch.entry` is `entryOf(workerBody)` (see the header). `launch.startFn`
// is the platform `threadStart`.
//
// NOT `@nosplit`: this runs on the boot/parent thread, an ordinary registered
// thread that may allocate and reach safepoints. Only the CHILD is constrained,
// and that constraint is on `entry`, not on this.
export fn schedStart(s: *i64, n: int, launch: WorkerLaunch): int {
  let i = 0
  while (i < n) {
    let h = launch.startFn(
      launch.entry,
      schedStartArm(s, i, launch.argArea, launch.doneArea),
      launch.doneArea + i,
    )
    *(launch.handleArea + i) = h
    if (h == 0) {
      return i
    }
    i = i + 1
  }
  return n
}

// The platform join operations `schedJoin` needs: the clock pair `threadJoin`
// itself takes (`sleepFn`/`monoFn`, `runtime/park`'s `parkSleepNs`/
// `parkMonoNs`) plus the platform `threadRelease` (`releaseFn`). A distinct
// class from `WorkerLaunch` (#2567) — `schedJoin` needs no `entry`/`argArea`/
// launch-side `startFn`, and needs this trio `schedStart` does not, so one
// struct covering both would carry unused fields either way — grouped for the
// same zero-allocation reason: every call site already builds this trio as
// three loose locals.
export class ThreadJoinOps {
  sleepFn: (int) => (),
  monoFn: () => int,
  releaseFn: (int) => bool,
}

// Reap the `started` workers `schedStart` brought up: join each on its done word
// (bounded by `timeoutNs`, `threadJoin`'s deadline+trip-bound contract), then
// release its handle. Returns true only if every started thread both joined and
// released.
//
// Walks `[0, started)` and touches no slot beyond it — the started-only reap set
// (see the header). The caller signals `schedShutdown(s)` first; without it the
// workers never leave `schedWorkerRun` and every join spends its full timeout.
//
// `ops` is the platform clock+release trio (`ThreadJoinOps` above). NOT
// `@nosplit`, same reason as `schedStart`.
export fn schedJoin(
  started: int, doneArea: *i32, handles: *i64, timeoutNs: int,
  ops: ThreadJoinOps,
): bool {
  let ok = true
  let i = 0
  while (i < started) {
    if (threadJoin(doneArea + i, timeoutNs, ops.sleepFn, ops.monoFn) != threadJoinDone) {
      ok = false
    }
    if (!ops.releaseFn(*(handles + i))) {
      ok = false
    }
    i = i + 1
  }
  return ok
}
