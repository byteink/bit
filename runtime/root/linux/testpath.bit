// runtime/root/linux/testpath.bit — the outstanding-`bit test`-binary
// tracker (#5765) and its scratch-directory cleanup (#5789 follow-up), split
// out of ./os.bit (#5789: os.bit was 843 lines against this house's 800-line
// ceiling once the #5789 addition landed there). PURE MOVE of the #5765
// block plus the #5789 addition already made to it — no wording or
// behaviour change from what #5765 proved on real Linux (both architectures,
// see #5765's own comment 2) or what #5789 proved locally. Same module as
// os.bit and fs.bit (a sibling `.bit` file in this directory), so every name
// this file uses — `osScratchSlot`/`osScratchSlots` (os.bit's own
// "../../root" import), `storeWord` (os.bit's own "../../gc" import),
// `loadByte`/`storeByte`/`loadWord` (fs.bit/io.bit), `isX64`/`atFdCwd`/
// `atRemoveDir`/`sysRmdirX64`/`sysUnlinkX64`/`sysUnlinkatArm64` (fs.bit) —
// is already module-scoped and reused here, not re-declared (a
// redeclaration is E0042).
//
// `termHandler` (./signal.bit) calls `osUnlinkAllOutstandingTestPaths`
// alongside `osKillAllOutstandingChildren()`; `rtOsRunTestBounded` (./os.bit)
// calls `osMarkTestPathOutstanding` right after it resolves the child's
// path. Both call sites are unchanged by this move — Bit's module-wide
// binding means neither needs to import from this file.

// #5765: outstanding `bit test` binary path per worker slot, 0 = none, same
// single-writer shape as `osOutstandingChildPid` above — written ONLY by
// `rtOsRunTestBounded`, never `rtOsRunBounded`. Full reasoning: ../darwin/os.bit.
let osOutstandingTestPath: [33]i64 // (osScratchSlots+1) * 1

// Remove the fresh, private per-run directory `p`'s test binary was
// created in (#5789: `createScratchExecutable` puts it at `<dir>/<name>`,
// one `mkdir`'d 0700 directory per test run) — a follow-up to #5765, whose
// own unlink left that now-empty directory behind, the exact leftover
// #5765 fixed for the file. Finds the LAST '/' by scanning forward from
// `p` (BOUNDED at 4096, `../fs.bit`'s `fsMaxPath`: `p` is a NUL-terminated
// path in a slot of exactly that size, so the scan cannot run past it
// regardless of what the bytes hold). Temporarily writes a NUL at the
// slash — safe, since this process is exiting via the caller's `rootExit`
// and nothing reads `p` again — `rmdir`s the prefix, then restores the
// '/'. A failed `rmdir` (`ENOTEMPTY`, because something else landed
// inside, or any other reason) simply leaves the directory: a leftover
// empty-or-not directory is a harmless cost, exactly this function's own
// existing contract for the file it unlinks. `@nosplit`-safe: no
// allocation, no Bit string op, the raw C-string scan and one syscall.
@nosplit fn osRmdirParentOf(p: int) {
  let i = 0
  let lastSlash = -1
  while (i < 4096) {
    let b = loadByte(p + i)
    if (b == 0) {
      break
    }
    if (b == 47) { // '/'
      lastSlash = i
    }
    i = i + 1
  }
  if (lastSlash <= 0) {
    return
  }
  storeByte(p + lastSlash, 0)
  if (isX64()) {
    syscall(sysRmdirX64(), i64(p))
  } else {
    syscall(sysUnlinkatArm64(), i64(atFdCwd), i64(p), i64(atRemoveDir))
  }
  storeByte(p + lastSlash, 47)
}

// Unlink every slot's test binary (#5765) so a killed `bit test` runner does
// not orphan it — ../darwin/os.bit has the full reasoning. `@nosplit`: no
// allocation, no Bit string op, the raw pointer into `rtFsRemove`'s split.
// `osRmdirParentOf` (#5789 follow-up) then removes the now-empty directory
// the binary was created in.
@nosplit fn osUnlinkAllOutstandingTestPaths() {
  let base = int(ptrOf(osOutstandingTestPath))
  let i = 0
  while (i <= osScratchSlots) {
    let p = loadWord(base + i * 8)
    if (p != 0) {
      if (isX64()) {
        syscall(sysUnlinkX64(), i64(p))
      } else {
        syscall(sysUnlinkatArm64(), i64(atFdCwd), i64(p), i64(0))
      }
      osRmdirParentOf(p)
    }
    i = i + 1
  }
}

// Publish `p` as this worker's test binary path (#5765), same split as
// `osMarkChildOutstanding` above.
@nosplit fn osMarkTestPathOutstanding(p: int): int {
  let addr = int(ptrOf(osOutstandingTestPath)) + osScratchSlot() * 8
  storeWord(addr, p)
  return addr
}
