// Linux filesystem provider for the SEAM 3 remainder (#1606): the 13
// `bit_rt_fs_*` ABI wrappers (ABI.md §14) and the raw per-arch syscalls behind
// them. This is the Bit form of `runtime/root/`'s `fs_*` block plus the Linux
// branch of the deleted native runtime's `openFd`/`readFd`/`writeFd`/`closeFd`/
// `mkdirAt`/`removeAt`/`chmodAt`/`fileSize`/`listDir`/`statPath`, fused into one
// self-contained module member — lineage only; no surviving `runtime/sched/`
// path carries these names today.
//
// SELF-CONTAINED (the io.bit shape), NOT parent-wrappers-over-extern-primitives
// (the netabi shape): see ../fs.bit's header for why the netabi shape breaks the
// x86_64-linux `rejectExternForTarget` gate here. The wrappers call their
// syscalls as LOCAL functions and reach `runtime/root`'s string glue by ordinary
// `import`. The platform-free `fsPathZ` and the `.`/`..`-skipping listing logic
// are the only pieces shared with ../darwin/fs.bit; everything numeric below is
// Linux-only.
//
// EVERY SYSCALL NUMBER, `open` FLAG, `dirent64` OFFSET AND `AT_*` CONSTANT BELOW
// WAS READ OUT OF THE KERNEL UAPI HEADERS (the syscall tables, `<fcntl.h>`'s
// `O`/`AT`/`dirent64`), NOT FROM MEMORY. A wrong number here is a silent
// wrong-syscall or wrong-field, never a compile error.
//
// PER-ARCH SHAPE, NOT JUST PER-ARCH NUMBER. `std.os.linux.open`/`mkdir`/`unlink`/
// `rmdir`/`chmod` use the bare syscall on x86_64 (which HAS it) and the `*at`
// variant on aarch64 (which does NOT), and the `*at` form takes an extra leading
// `AT_FDCWD` dirfd. This file mirrors that choice exactly rather than normalising
// both arches onto `openat`, as the task and rand/linux/entropy.bit require.
//
// ALL FUNCTIONS IN THIS FILE ARE `@nosplit` TODAY, WRAPPERS INCLUDED —
// `sysOpen`, `sysList`, and every exported `bit_rt_fs_*` entry point below.
// `rtFsReadAll`/`rtFsWrite` moved to the sibling `./fsrw.bit` (also fully
// `@nosplit`) when this file was split for size. `@nosplit` no longer
// categorically rejects `syscall` (E0075) — #1640 admitted it to §10.3.1's
// allowlist on proof (§11.8 emits the trap inline, so it is not a call) —
// and #1659 removed the last blocker on this file's chain by routing
// `isX64` through ./os.bit's `rtHostTarget` asm immediate instead of the
// `hostTarget()` rt_call. #1658 then closed the remaining #1656 defect
// class the wrappers used to carry — each held a freshly allocated GC
// object as a raw `int` address across a loop, so the synthesized back-edge
// poll could let a collection sweep it under a live reference — under the
// `BIT_GC=stress` gate #1658 added for exactly that.

// checkedPathZ/checkedPathZ2/cstrLen/emptyStr/fsScratchSlot/isDotName/strData/
// wordsPathZ pulled up to core (#2551,
// docs/development/provider-duplication.md's `root` -> `fs.bit` section): no
// OS call in any of their bodies. `fsPathZ`/`fsPathZ2` are NOT imported here
// any more: `checkedPathZ`/`checkedPathZ2`, their only callers in this file,
// moved to core too, and reach them there directly (same module, no
// import). `fsPathZ` is still needed in this MODULE by ./os.bit's
// `rtOsRun`/etc, which now imports it directly. `fsPathZ2` has no remaining
// caller anywhere in this module. `rtFsReadAllFailedSet`/`strLenOf`/
// `fsLinkMaxPath` are NOT imported here either: ./fsrw.bit, their only
// caller in this module, now imports them directly.
import {
  rtStrAlloc, rtStringSlice,
  checkedPathZ, checkedPathZ2, cstrLen, emptyStr, fsScratchSlot, isDotName,
  strData, wordsPathZ,
} from "../../root"
// `gcSyscallBegin`/`gcSyscallEnd` are NOT imported here: ./os.bit already imports
// them, and a sibling .bit file is the same module, so a second import is E0042.
import { loadByte, storeByte } from "../../gc"
// `taskAt`/`wkId` are NOT imported here: ./boot.bit already imports them, and
// `schedCurrentWorker` is NOT imported here either: ./time.bit already does
// (same module, so a second import is E0042). `schedMaxWorkers` no longer
// needed here: its only caller, `fsScratchSlot`, moved to core (#2551).
// `sysStatX64`/`sysLstatX64`/`sysNewfstatatArm64` (#2153): NOT already carried
// by ./io.bit's own large `../../syscalls` import (that list predates this
// change), so a second import of the SAME MODULE for DIFFERENT names — the
// same shape ../darwin/{fs,io,os}.bit already use against `../../root` — not
// a re-import of a name already in scope, which is what E0042 actually
// forbids.
//
// PASS 1 OF 2 (#2153 was reverted at `0dd25c35`: the pinned stage0 that
// compiles `tools/build/` links its OWN frozen release runtime, and no
// release has ever shipped `bit_rt_fs_stat_w`/`bit_rt_fs_lstat_w`, so a
// `std/fs` consumer breaks `./make`'s driver bootstrap with E0078 on every
// fresh clone until a release ships this commit and the pin moves to it).
// This commit adds the runtime primitives with NO `stdlib/` consumer, the
// #3065 pattern, so nothing on the driver's import path references them yet.
import { sysStatX64, sysLstatX64, sysNewfstatatArm64 } from "../../syscalls"

// `nr`, `nrWrite`, `strPtr`, `strLen` and `loadWord` are already imported/defined
// by this module's sibling io.bit (imports and top-level decls are module-scoped
// in Bit), so they are NOT re-declared here — doing so is an E0042 redeclaration.

// Same-shape syscalls (identical arguments on both arches, only the number
// differs). `nr`/`nrWrite` come from io.bit; the rest are read/close/lseek/
// getdents64.

// `rtHostTarget()` rather than the `hostTarget()` primitive, for the reason
// ./io.bit's `nr` documents: the primitive is an `rt_call`, which §10.3.1
// refuses inside `@nosplit`; `rtHostTarget` is a sibling in this module whose
// body is one inline `asm` immediate. Same answer, provable route (#1659).
@nosplit fn isX64(): bool { return rtHostTarget() == 0 }

// `AT_FDCWD` (= -100): the dirfd every `*at` variant uses to mean "resolve
// against the current directory". `AT_REMOVEDIR` (= 0x200) makes `unlinkat`
// behave as `rmdir`.
const atFdCwd: int = 0 - 100
const atRemoveDir: int = 512

// `open` flags (`<asm-generic/fcntl.h>`, identical bit positions on x86_64 and aarch64):
// O_WRONLY=1, O_RDWR=2, O_CREAT=0o100=64, O_TRUNC=0o1000=512, O_APPEND=0o2000=1024.
// A read open is O_RDONLY=0. Default perms: file 0o644=420, directory 0o755=493.
const oWrite: int = 577
const oAppend: int = 1089
// O_RDWR|O_CREAT, deliberately WITHOUT O_TRUNC (#3533, see ./fsopenrw.bit).
const oReadWrite: int = 66
const permFile: int = 420
const permDir: int = 493

// `dirent64` (`<linux/dirent.h>`): d_ino(u64)@0, d_off(u64)@8, d_reclen(u16)@16,
// d_type(u8)@18, d_name@19, the name NUL-terminated within the record.
const direntReclenOff: int = 16
const direntNameOff: int = 19

// getdents64 / stat-probe scratch. (`fsScratchSlots` + 1) slots of 1024 words
// (8192 bytes) each = 33 * 1024 = 33792 words, one region per worker plus the
// fallback; `fsDirBufBytes` stays the PER-SLOT capacity (the syscall's own
// `count` argument). A scalar array is never scanned by the collector
// (rule 1). Each slot matches `runtime/sched/`'s `listDir` buffer size;
// 8-byte aligned, which `dirent64` requires.
let fsDirBuf: [33792]i64
const fsDirBufBytes: int = 8192

// The `readlink` sink for the symlink probe, kept separate from `fsDirBuf`
// rather than sharing it so the two can never alias if either grows a caller.
// ONE WORD PER SLOT, deliberately: the probe reads only whether the call
// SUCCEEDED, never the target's text, so the buffer exists solely because
// `readlink` with a `bufsiz` of 0 is EINVAL on Linux. `fsLinkBufBytes` stays
// the per-slot capacity passed to the syscall; per-worker anyway (rather than
// left shared) so two concurrent probes' writes into it can never race each
// other at the C level even though neither ever reads the content back.
let fsLinkBuf: [33]i64
const fsLinkBufBytes: int = 1

// The `stat`/`lstat`/`newfstatat` sink for `bit_rt_fs_stat_w`/
// `bit_rt_fs_lstat_w` (#2153). This is the KERNEL's `stat` structure (the raw
// syscall ABI these calls fill directly — this file issues no libc), verified
// via `offsetof` in a throwaway `gcc:latest` container rather than transcribed
// from a header by eye:
//   x86_64:  sizeof=144, st_mode@24 (u32), st_size@48, st_mtim.tv_sec@88
//   aarch64: sizeof=128, st_mode@16 (u32), st_size@48, st_mtim.tv_sec@88
// size/mtime offsets are identical on both arches; only `st_mode`'s offset and
// the structure's total size differ. Each SLOT is sized to the LARGER (x86_64's
// 144 bytes = 18 words): this file's own header rule is that the source is
// shared between both Linux targets and each build carries the other arch's
// branch as dead code, so the slot must fit whichever branch a given build
// actually takes.
// PER-WORKER SLOTS, not one shared region — the same shape `fsLinkBuf`/
// `fsLinkPathBuf`/`fsDirBuf` above already use (#3274): (`fsScratchSlots` + 1)
// slots of 18 words each = 594 words total, one region per worker plus the
// fallback. A scalar array so the collector never scans it (rule 1).
let fsStatBuf: [594]i64
const fsStatSlotWords: int = 18
const statSizeOff: int = 48
const statMtimeSecOff: int = 88
const statModeOffX64: int = 24
const statModeOffArm64: int = 16

// `AT_SYMLINK_NOFOLLOW` (`<linux/fcntl.h>`, identical on both arches): makes
// `newfstatat` behave as `lstat` rather than `stat`. Read alongside
// `SYS_newfstatat` in the same container pass this file's `sysNewfstatatArm64`
// import documents.
const atSymlinkNofollow: int = 256

// `S_IFMT`/`S_IFDIR`/`S_IFLNK` (`<bits/stat.h>`): POSIX-standard values,
// confirmed identical to ../darwin/fs.bit's copy by the same measurement pass
// — a real divergence between the two platform copies would be a genuine bug,
// not a style choice.
const sIfmt: int = 61440  // 0o170000
const sIfdir: int = 16384 // 0o040000
const sIflnk: int = 40960 // 0o120000

// ---------------------------------------------------------------------------
// String glue: a string object's inline byte pointer and length (ABI.md §2).
// `strPtr`/`strLen` are io.bit's module-scoped imports; `loadWord` too.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Raw syscalls (the runtime/sched/ helpers)
// ---------------------------------------------------------------------------

// Open `pathPtr` (NUL-terminated): mode 0=read-only, 1=create+truncate
// write-only, 2=create+append write-only, 3=create+read-write no truncate
// (#3533). Returns the fd or -1. x86_64 uses bare `open` (nr 2); aarch64 has
// no `open` and uses `openat(AT_FDCWD, …)` (nr 56) with the extra dirfd —
// mirroring `std.os.linux.open`.
@nosplit fn sysOpen(pathPtr: int, mode: int): int {
  let flags = 0
  if (mode == 1) {
    flags = oWrite
  }
  if (mode == 2) {
    flags = oAppend
  }
  if (mode == 3) {
    flags = oReadWrite
  }
  if (isX64()) {
    let rc = int(syscall(sysOpenX64(), i64(pathPtr), i64(flags), i64(permFile)))
    if (rc < 0) {
      return 0 - 1
    }
    return rc
  }
  let rc = int(syscall(sysOpenatArm64(), i64(atFdCwd), i64(pathPtr), i64(flags), i64(permFile)))
  if (rc < 0) {
    return 0 - 1
  }
  return rc
}

// Errno numbers (`<asm-generic/errno-base.h>`, identical on x86_64 and
// aarch64): a path that genuinely does not resolve.
const errnoNoEnt: int = 0 - 2
const errnoNotDir: int = 0 - 20

// Like `sysOpen(pathPtr, 0)` but returns the open syscall's RAW return value
// instead of `sysOpen`'s own normalized `-1`. This runtime's `syscall`
// builtin is a raw trap (§11.8), not glibc's wrapper, so a failed syscall's
// negative result on Linux IS `-errno` directly (syscall(2)) — no
// translation happens. Used only by `rtFsExists` (#2114), which needs to
// tell `ENOENT`/`ENOTDIR` (genuinely missing) apart from `EACCES`/`EMFILE`/
// `ELOOP`/`ENAMETOOLONG` (exists, just not currently openable this way).
// `sysOpen`'s other callers only ever check `< 0` and must keep seeing the
// exact `bit_rt_fs_*` ABI contract of `-1` on failure, so this does not
// change `sysOpen` itself.
@nosplit fn sysOpenErrno(pathPtr: int): int {
  if (isX64()) {
    return int(syscall(sysOpenX64(), i64(pathPtr), i64(0), i64(permFile)))
  }
  return int(syscall(sysOpenatArm64(), i64(atFdCwd), i64(pathPtr), i64(0), i64(permFile)))
}

// #2711: the raw `rename(2)` primitive — two NUL-terminated C string
// pointers in, 0 on success or -1 on error, exactly `unlink`'s own shape
// above (and `rtFsRemove` below) just with a second pointer. `oldPathPtr`/
// `newPathPtr` must already be encoded (`checkedPathZ`/`fsPathZ`) by the
// caller, same contract as every raw syscall in this section. x86_64 keeps
// the bare `rename` syscall (nr 82, `arch/x86/entry/syscalls/syscall_64.tbl`
// — immediately beside `mkdir`=83/`rmdir`=84/`unlink`=87/`readlink`=89/
// `chmod`=90, all four already used above); aarch64 dropped it in favor of
// `renameat(AT_FDCWD, old, AT_FDCWD, new)` (nr 38,
// `include/uapi/asm-generic/unistd.h` — beside `unlinkat`=35/`fchmodat`=53/
// `openat`=56/`readlinkat`=78, likewise already used above), so it takes
// `atFdCwd` for BOTH paths, mirroring the single-dirfd pattern `sysOpen`'s
// aarch64 branch already uses. NOT exported itself — `bit_rt_fs_rename`
// below (#2712) is the exported wrapper that encodes both paths and calls
// this.
@nosplit fn sysRename(oldPathPtr: int, newPathPtr: int): int {
  if (isX64()) {
    if (int(syscall(sysRenameX64(), i64(oldPathPtr), i64(newPathPtr))) == 0) {
      return 0
    }
    return 0 - 1
  }
  if (int(syscall(sysRenameatArm64(), i64(atFdCwd), i64(oldPathPtr), i64(atFdCwd), i64(newPathPtr))) ==
    0) {
    return 0
  }
  return 0 - 1
}

@nosplit fn sysRenameX64(): int { return 82 }
@nosplit fn sysRenameatArm64(): int { return 38 }

// The little-endian u16 at `addr` (`dirent64.d_reclen`; both Linux arches are
// little-endian).
@nosplit fn loadU16(addr: int): int {
  return loadByte(addr) + loadByte(addr + 1) * 256
}

// List `pathPtr`'s entries, snprintf-shaped: write up to `cap` bytes of
// NUL-terminated names (`.`/`..` omitted) to `outPtr` and return the TOTAL bytes
// needed (a `cap == 0` call measures), or -1 if the directory cannot be read.
// The getdents64 loop is `runtime/sched/`'s `listDir` on Linux.
//
// BOUNDED: the outer loop consumes the directory a batch at a time and stops when
// getdents64 returns 0 — a directory has finitely many entries and each call
// makes forward progress. The inner loop advances by `d_reclen`, which the kernel
// guarantees positive; the `reclen <= 0` guard keeps it bounded even against a
// malformed record.
@nosplit fn sysList(pathPtr: int, outPtr: int, outCap: int): int {
  let fd = sysOpen(pathPtr, 0)
  if (fd < 0) {
    return 0 - 1
  }
  let dbuf = int(ptrOf(fsDirBuf)) + fsScratchSlot() * fsDirBufBytes
  let total = 0
  let done = false
  while (!done) {
    let rc = int(syscall(sysGetdents64(), i64(fd), i64(dbuf), i64(fsDirBufBytes)))
    if (rc < 0) {
      syscall(sysClose(), i64(fd))
      return 0 - 1
    }
    if (rc == 0) {
      done = true
    }
    let off = 0
    while (off < rc) {
      let reclen = loadU16(dbuf + off + direntReclenOff)
      if (reclen <= 0) {
        off = rc
      } else {
        let nameAddr = dbuf + off + direntNameOff
        let nlen = cstrLen(nameAddr)
        if (!isDotName(nameAddr, nlen)) {
          let j = 0
          while (j < nlen) {
            if (total + j < outCap) {
              storeByte(outPtr + total + j, loadByte(nameAddr + j))
            }
            j = j + 1
          }
          if (total + nlen < outCap) {
            storeByte(outPtr + total + nlen, 0)
          }
          total = total + nlen + 1
        }
        off = off + reclen
      }
    }
  }
  syscall(sysClose(), i64(fd))
  return total
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §14)
// ---------------------------------------------------------------------------
//
// PINS CARRY THE BARE `bit_rt_fs_*` ABI NAME, for the reason io.bit documents:
// G2/#1583 dropped the `_root` infix. The
// wrapper functions are named `rtFs*` (not `fs*`) to avoid shadowing the `fsOpen`
// / `fsRead` / … language builtins, the same reason netabi names its wrappers
// `netAbi*`.

// Whether the already-open `fd` names a directory: `getdents64` succeeds on a
// directory fd and answers `ENOTDIR` (rc < 0) on a regular file. Factored out
// of `rtFsIsDir` so `rtFsOpen` can reuse the fd it already has instead of
// opening the path a second time.
@nosplit fn isDirFd(fd: int): bool {
  let dbuf = int(ptrOf(fsDirBuf)) + fsScratchSlot() * fsDirBufBytes
  let rc = int(syscall(sysGetdents64(), i64(fd), i64(dbuf), i64(fsDirBufBytes)))
  return rc >= 0
}

// `bit_rt_fs_open`: open `path` read-only (`write == false`) or create+truncate
// write-only (`write == true`). Returns the fd, or -1. Rejects a directory
// (#2149): `open(O_RDONLY)` on a directory succeeds on Linux with no
// `O_DIRECTORY` guard, handing out a `File` nothing can actually read.
// Without this guard, `readAll`'s first `read()` on that fd would fail
// immediately (n < 0, not `EINTR`), and post-#2990 (see `rtFsReadAll` below)
// that returns the empty string trimmed to the 0 bytes actually read -- not
// the zero-padded full-length string the old code used to fabricate. Checked
// here anyway, once, as defense in depth against a future platform's
// directory-fd read behaving differently, so every caller (`readFile`,
// `open`) fails the same way a missing path does.
export @nosplit @symbol("bit_rt_fs_open") fn rtFsOpen(path: int, write: bool): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let mode = 0
  if (write) {
    mode = 1
  }
  let fd = sysOpen(p, mode)
  if (fd < 0) {
    return 0 - 1
  }
  if (isDirFd(fd)) {
    syscall(sysClose(), i64(fd))
    return 0 - 1
  }
  return fd
}

// `bit_rt_fs_append`: open `path` create+append write-only. Returns the fd, or -1.
export @nosplit @symbol("bit_rt_fs_append") fn rtFsAppend(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  return sysOpen(p, 2)
}

// `bit_rt_fs_read`/`bit_rt_fs_read_all`/`bit_rt_fs_write` — the fd-oriented
// (not path-oriented) trio — live in ./fsrw.bit now (#3274, pure move, split
// out to bring this file under spec/LINT.md §4's 800-line limit). Sibling in
// the same module, so nothing here needed to change to keep calling them.

// `bit_rt_fs_exists`: whether `path` names anything at all, per its own
// `std/fs` doc comment — NOT merely "did `open(O_RDONLY)` succeed" (#2114).
// A mode-000 file, or a directory hit while another process has exhausted
// its fd table, still exists; only `ENOENT`/`ENOTDIR` mean genuinely absent.
export @nosplit @symbol("bit_rt_fs_exists") fn rtFsExists(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  let rc = sysOpenErrno(p)
  if (rc >= 0) {
    syscall(sysClose(), i64(rc))
    return true
  }
  if (rc == errnoNoEnt || rc == errnoNotDir) {
    return false
  }
  return true
}

// `bit_rt_fs_is_dir`: false for a missing path or a non-directory. A directory
// answers `getdents64`; a regular file answers `ENOTDIR`.
export @nosplit @symbol("bit_rt_fs_is_dir") fn rtFsIsDir(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  let fd = sysOpen(p, 0)
  if (fd < 0) {
    return false
  }
  let isDir = isDirFd(fd)
  syscall(sysClose(), i64(fd))
  return isDir
}

// `bit_rt_fs_is_symlink_w`: whether the `n` path bytes at `words` name a
// symbolic LINK itself, asked of the link and never of what it resolves to.
// `false` for a missing path, a non-link, and a path that cannot be probed.
//
// THE ONLY `bit_rt_fs_*` ENTRY POINT NOT TAKING A BIT `string` OBJECT — hence
// the `_w` suffix, for the raw `words`/`n` pair `wordsPathZ` above copies. It
// has to be: its caller is `std/fs`, which can reach a runtime symbol only
// through an `extern function` (SPEC §11.7), and §11.7 admits no `string`
// across that boundary.
//
// `readlink` AND NOT `newfstatat` + `S_IFLNK`. Both answer the question; only
// one of them hard-codes a `stat` structure layout, and this file's header note is
// explicit that a wrong offset there is a silent wrong ANSWER rather than a
// build error. `readlink` needs no layout at all: it succeeds on a symbolic
// link and fails with `-EINVAL` on everything else. A DANGLING link still
// answers true, which is correct — the link exists whether its target does or
// not, and it is exactly the link a walk must refuse to descend.
//
// PER-ARCH SHAPE, the file's standing rule: x86_64 has bare `readlink` (nr 89),
// aarch64 has only `readlinkat` (nr 78) with the leading `AT_FDCWD` — the same
// split ../linux/os.bit's `/proc/self/exe` resolution already carries.
export @nosplit @symbol("bit_rt_fs_is_symlink_w") fn rtFsIsSymlinkW(
  words: int,
  n: int,
): bool {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return false
  }
  // One word (8 bytes) per slot, matching `fsLinkBuf`'s `[33]i64` declaration
  // — NOT `fsLinkBufBytes`, which is the syscall's `bufsiz` cap (1), a
  // different number that happens to also bound how much of the slot the
  // kernel may write.
  let buf = int(ptrOf(fsLinkBuf)) + fsScratchSlot() * 8
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysReadlinkX64(), i64(p), i64(buf), i64(fsLinkBufBytes)))
  } else {
    rc = int(syscall(sysReadlinkatArm64(), i64(atFdCwd), i64(p), i64(buf), i64(fsLinkBufBytes)))
  }
  return rc >= 0
}

// Runs `stat(2)`/`newfstatat` (`follow == true`) or `lstat(2)`/
// `newfstatat(AT_SYMLINK_NOFOLLOW)` (`follow == false`) on the already-copied
// C path `p`, filling `out` (5 words: size, mtime seconds, mode, isDir,
// isSymlink — ABI.md §14) from this worker's `fsStatBuf` slot. x86_64 has
// bare `stat`/`lstat`; aarch64 has neither and uses `newfstatat`, the file's
// standing per-arch rule (`rtFsMkdir` etc. below already split the same way).
// Returns 0 on success; a raw syscall failure on Linux IS `-errno` directly
// (this file's header), so it is returned as-is — the same "signed distance
// from zero" convention #2343 gives the net primitives (#2153), letting
// `std/fs` tell a missing path (`ENOENT`) from a permission error (`EACCES`)
// apart, once a `stdlib/` consumer exists (pass 2, see the import's note
// above).
@nosplit fn fillStat(p: int, out: int, follow: bool): int {
  let buf = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  let rc = 0
  if (isX64()) {
    if (follow) {
      rc = int(syscall(sysStatX64(), i64(p), i64(buf)))
    } else {
      rc = int(syscall(sysLstatX64(), i64(p), i64(buf)))
    }
  } else {
    let flags = 0
    if (!follow) {
      flags = atSymlinkNofollow
    }
    rc = int(syscall(sysNewfstatatArm64(), i64(atFdCwd), i64(p), i64(buf), i64(flags)))
  }
  if (rc < 0) {
    return rc
  }
  let modeOff = statModeOffX64
  if (!isX64()) {
    modeOff = statModeOffArm64
  }
  let mode = loadWord(buf + modeOff) & 4294967295 // low 32 bits: u32 st_mode
  storeWord(out, loadWord(buf + statSizeOff))
  storeWord(out + 8, loadWord(buf + statMtimeSecOff))
  storeWord(out + 16, mode & 4095) // low 12 bits: perm + setuid/setgid/sticky
  let isDir = 0
  if ((mode & sIfmt) == sIfdir) {
    isDir = 1
  }
  storeWord(out + 24, isDir)
  let isSymlink = 0
  if ((mode & sIfmt) == sIflnk) {
    isSymlink = 1
  }
  storeWord(out + 32, isSymlink)
  return 0
}

// `bit_rt_fs_stat_w`: `stat(2)`-shaped — FOLLOWS a trailing symlink, so
// `out`'s isSymlink word is always 0 (a followed link is indistinguishable
// from its target). `words`/`n` are the symlink probe's word-per-byte path
// encoding (see `wordsPathZ` above); `out` is the caller's 5-word sink.
// NO `stdlib/` CALLER YET — see the import's note above.
export @nosplit @symbol("bit_rt_fs_stat_w") fn rtFsStatW(words: int, n: int, out: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return errnoNoEnt // rejected path (too long / embedded NUL) reads as absent, same contract checkedPathZ's callers already carry
  }
  return fillStat(p, out, true)
}

// `bit_rt_fs_lstat_w`: `lstat(2)`-shaped — does NOT follow a trailing
// symlink, so `out`'s isSymlink word reflects `words` itself.
export @nosplit @symbol("bit_rt_fs_lstat_w") fn rtFsLstatW(words: int, n: int, out: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return errnoNoEnt
  }
  return fillStat(p, out, false)
}

// `bit_rt_fs_mkdir`: 0 on success, -1 on failure (including "already exists").
// x86_64 `mkdir` (nr 83) / aarch64 `mkdirat(AT_FDCWD, …)` (nr 34), mode 0o755.
export @nosplit @symbol("bit_rt_fs_mkdir") fn rtFsMkdir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysMkdirX64(), i64(p), i64(permDir)))
  } else {
    rc = int(syscall(sysMkdiratArm64(), i64(atFdCwd), i64(p), i64(permDir)))
  }
  if (rc == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_remove`: 0 on success, -1 on failure. Deletes a file or an *empty*
// directory: `unlink` then `rmdir` — `runtime/sched/`'s `removeAt`. aarch64 folds both
// into `unlinkat`, the second carrying `AT_REMOVEDIR`.
export @nosplit @symbol("bit_rt_fs_remove") fn rtFsRemove(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (isX64()) {
    if (int(syscall(sysUnlinkX64(), i64(p))) == 0) {
      return 0
    }
    if (int(syscall(sysRmdirX64(), i64(p))) == 0) {
      return 0
    }
    return 0 - 1
  }
  if (int(syscall(sysUnlinkatArm64(), i64(atFdCwd), i64(p), i64(0))) == 0) {
    return 0
  }
  if (int(syscall(sysUnlinkatArm64(), i64(atFdCwd), i64(p), i64(atRemoveDir))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_rename` (#2712): rename `oldPath` to `newPath`. 0 on success, -1
// on failure — the exact shape `bit_rt_fs_remove` above already returns,
// copied rather than invented, per the ticket's own instruction. `oldPath` is
// encoded through `checkedPathZ` into `fsPathBuf` and `newPath` through
// `checkedPathZ2` into `fsPathBuf2`: TWO DIFFERENT buffer addresses, so the
// two pointers `sysRename` receives can never alias — see ../fs.bit's
// `fsPathBuf2` note for why one buffer would be wrong here.
export @nosplit @symbol("bit_rt_fs_rename") fn rtFsRename(oldPath: int, newPath: int): int {
  let op = checkedPathZ(oldPath)
  if (op == 0) {
    return 0 - 1
  }
  let np = checkedPathZ2(newPath)
  if (np == 0) {
    return 0 - 1
  }
  return sysRename(op, np)
}

// `bit_rt_fs_list_dir`: `path`'s entries, each terminated by a NUL byte, `.`/`..`
// omitted. Empty string when the directory is empty or unreadable (`std/fs`
// checks `isDir` first to tell those apart). Two passes — measure, then fill a
// string sized to it (Power of 10 rule 3, no unbounded growth) — rather than
// `runtime/root/`'s growing `ArrayList`. A directory that shrinks between passes
// yields fewer bytes than measured, so the result is trimmed to what pass 2 wrote
// (`rtStringSlice` rejects `hi > len`, so the clamp also guards the allocation).
export @nosplit @symbol("bit_rt_fs_list_dir") fn rtFsListDir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return emptyStr()
  }
  let needed = sysList(p, 0, 0)
  if (needed <= 0) {
    return emptyStr()
  }
  let out = rtStrAlloc(needed)
  if (out == 0) {
    return emptyStr()
  }
  let got = sysList(p, strData(out), needed)
  if (got <= 0) {
    return emptyStr()
  }
  if (got > needed) {
    got = needed
  }
  return rtStringSlice(out, 0, got)
}

// `bit_rt_fs_read_all`/`bit_rt_fs_write` moved to ./fsrw.bit (#3274, pure
// move, see that file's header) alongside `bit_rt_fs_read` above.

// `bit_rt_fs_chmod`: set `path`'s permission bits to `mode`. 0 on success, -1 on
// any error. x86_64 `chmod` (nr 90) / aarch64 `fchmodat(AT_FDCWD, …)` (nr 53).
export @nosplit @symbol("bit_rt_fs_chmod") fn rtFsChmod(path: int, mode: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysChmodX64(), i64(p), i64(mode)))
  } else {
    rc = int(syscall(sysFchmodatArm64(), i64(atFdCwd), i64(p), i64(mode)))
  }
  if (rc == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_close`: close `fd`. Always reports success, matching `runtime/root/`.
export @nosplit @symbol("bit_rt_fs_close") fn rtFsClose(fd: int): int {
  syscall(sysClose(), i64(fd))
  return 0
}

// `bit_rt_fs_sync_dir_w` (ABI.md §14, #4017, PASS 1 OF 2 -- no `stdlib/`
// caller yet, see the #3065 pattern this module's other pass-1 landings
// already use). Packed-bytes `(words, n)`, like `rtFsIsSymlinkW`/`rtFsStatW`
// below -- a path-taking primitive with no compiler-builtin call form must
// take this shape rather than the compiler-recognized `path: int`
// `fsOpen`/`fsRead` convention, since §11.7 admits no `string` across a
// plain `extern fn` boundary and this one has no reason to earn a new
// compiler builtin. Durability for a directory ENTRY, not a file's
// contents: creating a file and `bit_rt_fs_sync`ing it only guarantees that
// file's OWN blocks survive a crash -- on ext4 and several other
// filesystems the directory entry that gives the file its name is separate
// metadata and needs its own fsync, which is why SQLite fsyncs its
// database's containing directory after creating the journal file. Opens
// the directory read-only via `sysOpen` (`open(O_RDONLY)` on a directory
// succeeds on Linux, same fact `rtFsIsDir` above relies on), reuses
// `rtFsSync` (./fsrw.bit, same module, no import needed) for the raw
// `fsync(2)` syscall -- it works identically on a directory fd -- then
// closes via `rtFsClose` above. 0 on success, -1 if the path is malformed
// or either the open or the fsync fails; the close always runs once open
// succeeds, regardless of the fsync result, matching `rtFsClose`'s own
// always-succeeds contract.
export @nosplit @symbol("bit_rt_fs_sync_dir_w") fn rtFsSyncDirW(words: int, n: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  let fd = sysOpen(p, 0)
  if (fd < 0) {
    return 0 - 1
  }
  let rc = rtFsSync(fd)
  let _ = rtFsClose(fd)
  return rc
}
