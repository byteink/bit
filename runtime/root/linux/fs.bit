// Linux filesystem provider for the SEAM 3 remainder (#1606): the 12
// `bit_rt_fs_*` ABI wrappers (ABI.md §14) and the raw per-arch syscalls behind
// them. This is the Bit form of `runtime/root/`'s `fs_*` block plus the Linux
// branch of `runtime/sched/`'s `openFd`/`readFd`/`writeFd`/`closeFd`/
// `mkdirAt`/`removeAt`/`chmodAt`/`fileSize`/`listDir`/`statPath`, fused into one
// self-contained module member.
//
// SELF-CONTAINED (the io.bit shape), NOT parent-wrappers-over-extern-primitives
// (the netabi shape): see ../fs.bit's header for why the netabi shape breaks the
// x86_64-linux `rejectExternForTarget` gate here. The wrappers call their
// syscalls as LOCAL functions and reach `runtime/root`'s string glue by ordinary
// `import`. The platform-free `fsPathZ` and the `.`/`..`-skipping listing logic
// are the only pieces shared with ../darwin/fs.bit; everything numeric below is
// Linux-only.
//
// EVERY SYSCALL NUMBER, `open` FLAG, `dirent64` OFFSET AND `AT_*` CONSTANT BELOW
// WAS READ OUT OF THE KERNEL UAPI HEADERS (the syscall tables, `<fcntl.h>`'s
// `O`/`AT`/`dirent64`), NOT FROM MEMORY. A wrong number here is a silent
// wrong-syscall or wrong-field, never a compile error.
//
// PER-ARCH SHAPE, NOT JUST PER-ARCH NUMBER. `std.os.linux.open`/`mkdir`/`unlink`/
// `rmdir`/`chmod` use the bare syscall on x86_64 (which HAS it) and the `*at`
// variant on aarch64 (which does NOT), and the `*at` form takes an extra leading
// `AT_FDCWD` dirfd. This file mirrors that choice exactly rather than normalising
// both arches onto `openat`, as the task and rand/linux/entropy.bit require.
//
// `@nosplit`: THE SYSCALL-NUMBER HELPERS CARRY IT, THE WRAPPERS DO NOT YET.
// The old claim here — "nothing here is `@nosplit`, because `@nosplit` REJECTS
// `syscall`" — is obsolete: #1640 admitted `syscall` to §10.3.1's allowlist on
// proof (§11.8 emits the trap inline, so it is not a call), and #1659 removed
// the last blocker on this file's chain by routing `isX64` through ./os.bit's
// `rtHostTarget` asm immediate instead of the `hostTarget()` rt_call. So
// `nrRead`/`nrClose`/`nrLseek`/`nrGetdents64`/`isX64` are poll-free now.
//
// The WRAPPERS (`sysOpen`, `sysList`, `rtFsReadAll`, `rtFsWrite`, …) are still
// plain functions and that is #1658's work, not this file's: they are the
// #1656 defect class — each holds a freshly allocated GC object as a raw `int`
// address across a loop, so the synthesized back-edge poll lets a collection
// sweep it under a live reference. Marking them is a runtime behaviour change
// that needs the `BIT_GC=stress` gate #1658 owns. #1659 proved the wall is
// gone: with these five marked, adding `@nosplit` to `sysOpen`/`rtFsReadAll`/
// `rtFsWrite`/`sysList` and their remaining helpers compiles clean on both ELF
// targets.

import { fsPathZ, rtStrAlloc, rtStringSlice } from "../../root"
// `gcSyscallBegin`/`gcSyscallEnd` are NOT imported here: ./os.bit already imports
// them, and a sibling .bit file is the same module, so a second import is E0042.
import { loadByte, storeByte } from "../../gc"

// `nr`, `nrWrite`, `strPtr`, `strLen` and `loadWord` are already imported/defined
// by this module's sibling io.bit (imports and top-level decls are module-scoped
// in Bit), so they are NOT re-declared here — doing so is an E0042 redeclaration.

// Same-shape syscalls (identical arguments on both arches, only the number
// differs). `nr`/`nrWrite` come from io.bit; the rest are read/close/lseek/
// getdents64.

// `rtHostTarget()` rather than the `hostTarget()` primitive, for the reason
// ./io.bit's `nr` documents: the primitive is an `rt_call`, which §10.3.1
// refuses inside `@nosplit`; `rtHostTarget` is a sibling in this module whose
// body is one inline `asm` immediate. Same answer, provable route (#1659).
@nosplit fn isX64(): bool { return rtHostTarget() == 0 }

// `AT_FDCWD` (= -100): the dirfd every `*at` variant uses to mean "resolve
// against the current directory". `AT_REMOVEDIR` (= 0x200) makes `unlinkat`
// behave as `rmdir`.
const atFdCwd: int = 0 - 100
const atRemoveDir: int = 512

// `open` flags (`<asm-generic/fcntl.h>`, identical bit positions on x86_64 and aarch64):
// O_WRONLY=1, O_CREAT=0o100=64, O_TRUNC=0o1000=512, O_APPEND=0o2000=1024. A read
// open is O_RDONLY=0. Default perms: file 0o644=420, directory 0o755=493.
const oWrite: int = 577
const oAppend: int = 1089
const permFile: int = 420
const permDir: int = 493

// `dirent64` (`<linux/dirent.h>`): d_ino(u64)@0, d_off(u64)@8, d_reclen(u16)@16,
// d_type(u8)@18, d_name@19, the name NUL-terminated within the record.
const direntReclenOff: int = 16
const direntNameOff: int = 19

// getdents64 / stat-probe scratch. MODULE-LEVEL and unlocked, sound only under
// the single-worker contract (ABI.md §5), exactly as net/linux/sock.bit's
// `saBuf`. A scalar array is never scanned by the collector (rule 1). 1024 words
// = 8192 bytes, matching `runtime/sched/`'s `listDir` buffer; 8-byte aligned, which
// `dirent64` requires.
let fsDirBuf: [1024]i64
const fsDirBufBytes: int = 8192

// The `readlink` sink for the symlink probe, kept separate from `fsDirBuf`
// rather than sharing it so the two can never alias if either grows a caller.
// One WORD, deliberately: the probe reads only whether the call SUCCEEDED,
// never the target's text, so the buffer exists solely because `readlink` with
// a `bufsiz` of 0 is EINVAL on Linux. Same single-worker contract (ABI.md §5)
// and same scalar-array-is-never-scanned property as `fsDirBuf`.
let fsLinkBuf: [1]i64
const fsLinkBufBytes: int = 1

// The packed NUL-terminated path for the symlink probe. A SECOND buffer rather
// than ../fs.bit's `fsPathBuf`, which is a different module's private state and
// is reachable here only through `fsPathZ`, whose argument is a Bit `string`
// object — the one thing the probe's `extern` boundary cannot carry. 512 words
// = 4096 bytes = `max_path`, so the longest accepted path (4095 bytes) plus its
// NUL fits exactly.
let fsLinkPathBuf: [512]i64

// ../fs.bit's `fsMaxPath`, which is that module's private const. Mirrored here
// rather than shared because this module cannot see it; it is `runtime/root/`'s
// `max_path = 4096` and must move with it.
const fsLinkMaxPath: int = 4096

// ---------------------------------------------------------------------------
// String glue: a string object's inline byte pointer and length (ABI.md §2).
// `strPtr`/`strLen` are io.bit's module-scoped imports; `loadWord` too.
// ---------------------------------------------------------------------------

@nosplit fn strData(s: int): int { return loadWord(s + strPtr) }
@nosplit fn strLenOf(s: int): int { return loadWord(s + strLen) }
@nosplit fn emptyStr(): int { return rtStrAlloc(0) }

// `fsPathZ` copies a Bit string's bytes verbatim and appends its own NUL
// terminator (#2146): a string carrying an embedded NUL byte (legal per
// SPEC §21) would let the copy stop early from the syscall's point of view
// while every Bit-side check — `len`, `==`, `hasSuffix`, `ext` — still sees
// the full string, so the syscall opens a different path than the one that
// was validated. Reject up front, same "reject, not truncate" contract
// `fsPathZ` already applies to `n >= fsMaxPath`. Every one of the 8
// path-taking `bit_rt_fs_*` entry points below routes through this instead
// of calling `fsPathZ` directly.
//
// BOUNDED (Power of 10 rule 2): the scan is bounded by the string's own
// length, exactly as `fsPathZ`'s copy loop it precedes.
@nosplit fn checkedPathZ(path: int): int {
  let n = strLenOf(path)
  let base = strData(path)
  let i = 0
  while (i < n) {
    if (loadByte(base + i) == 0) {
      return 0
    }
    i = i + 1
  }
  return fsPathZ(path)
}

// ---------------------------------------------------------------------------
// Raw syscalls (the runtime/sched/ helpers)
// ---------------------------------------------------------------------------

// Open `pathPtr` (NUL-terminated): mode 0=read-only, 1=create+truncate
// write-only, 2=create+append write-only. Returns the fd or -1. x86_64 uses bare
// `open` (nr 2); aarch64 has no `open` and uses `openat(AT_FDCWD, …)` (nr 56)
// with the extra dirfd — mirroring `std.os.linux.open`.
@nosplit fn sysOpen(pathPtr: int, mode: int): int {
  let flags = 0
  if (mode == 1) {
    flags = oWrite
  }
  if (mode == 2) {
    flags = oAppend
  }
  if (isX64()) {
    let rc = int(syscall(sysOpenX64(), i64(pathPtr), i64(flags), i64(permFile)))
    if (rc < 0) {
      return 0 - 1
    }
    return rc
  }
  let rc = int(syscall(sysOpenatArm64(), i64(atFdCwd), i64(pathPtr), i64(flags), i64(permFile)))
  if (rc < 0) {
    return 0 - 1
  }
  return rc
}

// Errno numbers (`<asm-generic/errno-base.h>`, identical on x86_64 and
// aarch64): a path that genuinely does not resolve.
const errnoNoEnt: int = 0 - 2
const errnoNotDir: int = 0 - 20

// Like `sysOpen(pathPtr, 0)` but returns the open syscall's RAW return value
// instead of `sysOpen`'s own normalized `-1`. This runtime's `syscall`
// builtin is a raw trap (§11.8), not glibc's wrapper, so a failed syscall's
// negative result on Linux IS `-errno` directly (syscall(2)) — no
// translation happens. Used only by `rtFsExists` (#2114), which needs to
// tell `ENOENT`/`ENOTDIR` (genuinely missing) apart from `EACCES`/`EMFILE`/
// `ELOOP`/`ENAMETOOLONG` (exists, just not currently openable this way).
// `sysOpen`'s other callers only ever check `< 0` and must keep seeing the
// exact `bit_rt_fs_*` ABI contract of `-1` on failure, so this does not
// change `sysOpen` itself.
@nosplit fn sysOpenErrno(pathPtr: int): int {
  if (isX64()) {
    return int(syscall(sysOpenX64(), i64(pathPtr), i64(0), i64(permFile)))
  }
  return int(syscall(sysOpenatArm64(), i64(atFdCwd), i64(pathPtr), i64(0), i64(permFile)))
}

// The length of the NUL-terminated name at `addr`, capped at NAME_MAX+1 (256) so
// the scan is provably bounded (Power of 10 rule 2).
@nosplit fn cstrLen(addr: int): int {
  let i = 0
  while (i < 256) {
    if (loadByte(addr + i) == 0) {
      return i
    }
    i = i + 1
  }
  return 256
}

// The little-endian u16 at `addr` (`dirent64.d_reclen`; both Linux arches are
// little-endian).
@nosplit fn loadU16(addr: int): int {
  return loadByte(addr) + loadByte(addr + 1) * 256
}

// `.` or `..` — the two entries `list_dir` omits.
@nosplit fn isDotName(addr: int, nlen: int): bool {
  if (nlen == 1 && loadByte(addr) == 46) {
    return true
  }
  if (nlen == 2 && loadByte(addr) == 46 && loadByte(addr + 1) == 46) {
    return true
  }
  return false
}

// List `pathPtr`'s entries, snprintf-shaped: write up to `cap` bytes of
// NUL-terminated names (`.`/`..` omitted) to `outPtr` and return the TOTAL bytes
// needed (a `cap == 0` call measures), or -1 if the directory cannot be read.
// The getdents64 loop is `runtime/sched/`'s `listDir` on Linux.
//
// BOUNDED: the outer loop consumes the directory a batch at a time and stops when
// getdents64 returns 0 — a directory has finitely many entries and each call
// makes forward progress. The inner loop advances by `d_reclen`, which the kernel
// guarantees positive; the `reclen <= 0` guard keeps it bounded even against a
// malformed record.
@nosplit fn sysList(pathPtr: int, outPtr: int, cap: int): int {
  let fd = sysOpen(pathPtr, 0)
  if (fd < 0) {
    return 0 - 1
  }
  let dbuf = int(ptrOf(fsDirBuf))
  let total = 0
  let done = false
  while (!done) {
    let rc = int(syscall(sysGetdents64(), i64(fd), i64(dbuf), i64(fsDirBufBytes)))
    if (rc < 0) {
      syscall(sysClose(), i64(fd))
      return 0 - 1
    }
    if (rc == 0) {
      done = true
    }
    let off = 0
    while (off < rc) {
      let reclen = loadU16(dbuf + off + direntReclenOff)
      if (reclen <= 0) {
        off = rc
      } else {
        let nameAddr = dbuf + off + direntNameOff
        let nlen = cstrLen(nameAddr)
        if (!isDotName(nameAddr, nlen)) {
          let j = 0
          while (j < nlen) {
            if (total + j < cap) {
              storeByte(outPtr + total + j, loadByte(nameAddr + j))
            }
            j = j + 1
          }
          if (total + nlen < cap) {
            storeByte(outPtr + total + nlen, 0)
          }
          total = total + nlen + 1
        }
        off = off + reclen
      }
    }
  }
  syscall(sysClose(), i64(fd))
  return total
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §14)
// ---------------------------------------------------------------------------
//
// PINS CARRY THE BARE `bit_rt_fs_*` ABI NAME, for the reason io.bit documents:
// G2/#1583 dropped the `_root` infix. The
// wrapper functions are named `rtFs*` (not `fs*`) to avoid shadowing the `fsOpen`
// / `fsRead` / … language builtins, the same reason netabi names its wrappers
// `netAbi*`.

// Whether the already-open `fd` names a directory: `getdents64` succeeds on a
// directory fd and answers `ENOTDIR` (rc < 0) on a regular file. Factored out
// of `rtFsIsDir` so `rtFsOpen` can reuse the fd it already has instead of
// opening the path a second time.
@nosplit fn isDirFd(fd: int): bool {
  let rc = int(syscall(sysGetdents64(), i64(fd), i64(int(ptrOf(fsDirBuf))), i64(fsDirBufBytes)))
  return rc >= 0
}

// `bit_rt_fs_open`: open `path` read-only (`write == false`) or create+truncate
// write-only (`write == true`). Returns the fd, or -1. Rejects a directory
// (#2149): `open(O_RDONLY)` on a directory succeeds on Linux with no
// `O_DIRECTORY` guard, handing out a `File` nothing can actually read.
// Without this guard, `readAll`'s first `read()` on that fd would fail
// immediately (n < 0, not `EINTR`), and post-#2990 (see `rtFsReadAll` below)
// that returns the empty string trimmed to the 0 bytes actually read -- not
// the zero-padded full-length string the old code used to fabricate. Checked
// here anyway, once, as defense in depth against a future platform's
// directory-fd read behaving differently, so every caller (`readFile`,
// `open`) fails the same way a missing path does.
export @nosplit @symbol("bit_rt_fs_open") fn rtFsOpen(path: int, write: bool): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let mode = 0
  if (write) {
    mode = 1
  }
  let fd = sysOpen(p, mode)
  if (fd < 0) {
    return 0 - 1
  }
  if (isDirFd(fd)) {
    syscall(sysClose(), i64(fd))
    return 0 - 1
  }
  return fd
}

// `bit_rt_fs_append`: open `path` create+append write-only. Returns the fd, or -1.
export @nosplit @symbol("bit_rt_fs_append") fn rtFsAppend(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  return sysOpen(p, 2)
}

// `bit_rt_fs_read`: up to `max` bytes from `fd` into a fresh string, shorter than
// `max` at EOF (empty exactly at EOF). Allocates `max`, reads, trims to what
// arrived — `runtime/root/`'s `stringFromBytes(tmp[0..n])`, one allocation.
export @nosplit @symbol("bit_rt_fs_read") fn rtFsRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let big = rtStrAlloc(max)
  if (big == 0) {
    return emptyStr()
  }
  // THE `syscall` BRACKET IS LOAD-BEARING (#2207), for the same reason
  // ../os.bit's `wait4` has one. `fd` may be a pipe, a tty or a socket, so this
  // `read` blocks until somebody writes — indefinitely, for a server or an LSP
  // sitting on stdin. Unbracketed, the reading thread never reaches a safepoint,
  // so a thread that requests a stop-the-world spins in its wait loop for the
  // whole duration: measured at ~77% of a core, continuously, in
  // `bit lsp --stdio`.
  //
  // `syscall` and NOT `blocked`: `big` is a live reference held across this
  // call, and `blocked` would let it be swept. `syscall` publishes the stack
  // bound and register file so it is scanned in place.
  gcSyscallBegin()
  let n = int(syscall(sysRead(), i64(fd), i64(strData(big)), i64(max)))
  gcSyscallEnd()
  if (n <= 0) {
    return emptyStr()
  }
  return rtStringSlice(big, 0, n)
}

// `bit_rt_fs_exists`: whether `path` names anything at all, per its own
// `std/fs` doc comment — NOT merely "did `open(O_RDONLY)` succeed" (#2114).
// A mode-000 file, or a directory hit while another process has exhausted
// its fd table, still exists; only `ENOENT`/`ENOTDIR` mean genuinely absent.
export @nosplit @symbol("bit_rt_fs_exists") fn rtFsExists(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  let rc = sysOpenErrno(p)
  if (rc >= 0) {
    syscall(sysClose(), i64(rc))
    return true
  }
  if (rc == errnoNoEnt || rc == errnoNotDir) {
    return false
  }
  return true
}

// `bit_rt_fs_is_dir`: false for a missing path or a non-directory. A directory
// answers `getdents64`; a regular file answers `ENOTDIR`.
export @nosplit @symbol("bit_rt_fs_is_dir") fn rtFsIsDir(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  let fd = sysOpen(p, 0)
  if (fd < 0) {
    return false
  }
  let isDir = isDirFd(fd)
  syscall(sysClose(), i64(fd))
  return isDir
}

// Copy the `n` path bytes at `words` — a Bit `[]byte`'s backing store, so ONE
// 8-BYTE WORD PER ELEMENT (SPEC §11.8), not packed bytes — into
// `fsLinkPathBuf`, NUL-terminated, and return the buffer address. 0 when the
// path may not be handed to a syscall at all.
//
// This is `checkedPathZ` for a caller that has no Bit `string` to offer, and it
// applies the identical two rules, so `rtFsIsSymlinkW` refuses exactly the
// paths every other entry point refuses:
//   - at or over `max_path`: REJECTED, never truncated, so a lie about the
//     prefix cannot reach the kernel.
//   - an embedded NUL (legal in a Bit string, SPEC §21): REJECTED, because the
//     syscall would stop early while every Bit-side check still saw the whole
//     string — a different path probed than the one that was validated (#2146).
//
// BOUNDED (Power of 10 rule 2): by `n`, itself bounded by the `< fsLinkMaxPath`
// guard above the loop.
@nosplit fn wordsPathZ(words: int, n: int): int {
  if (words == 0 || n <= 0 || n >= fsLinkMaxPath) {
    return 0
  }
  let dst = int(ptrOf(fsLinkPathBuf))
  let i = 0
  while (i < n) {
    let b = loadWord(words + i * 8)
    if (b == 0) {
      return 0
    }
    storeByte(dst + i, b)
    i = i + 1
  }
  storeByte(dst + n, 0)
  return dst
}

// `bit_rt_fs_is_symlink_w`: whether the `n` path bytes at `words` name a
// symbolic LINK itself, asked of the link and never of what it resolves to.
// `false` for a missing path, a non-link, and a path that cannot be probed.
//
// THE ONLY `bit_rt_fs_*` ENTRY POINT NOT TAKING A BIT `string` OBJECT — hence
// the `_w` suffix, for the word-per-byte argument `wordsPathZ` above unpacks.
// It has to be: its caller is `std/fs`, which can reach a runtime symbol only
// through an `extern function` (SPEC §11.7), and §11.7 admits no `string`
// across that boundary.
//
// `readlink` AND NOT `newfstatat` + `S_IFLNK`. Both answer the question; only
// one of them hard-codes a `struct stat` layout, and this file's header note is
// explicit that a wrong offset there is a silent wrong ANSWER rather than a
// build error. `readlink` needs no layout at all: it succeeds on a symbolic
// link and fails with `-EINVAL` on everything else. A DANGLING link still
// answers true, which is correct — the link exists whether its target does or
// not, and it is exactly the link a walk must refuse to descend.
//
// PER-ARCH SHAPE, the file's standing rule: x86_64 has bare `readlink` (nr 89),
// aarch64 has only `readlinkat` (nr 78) with the leading `AT_FDCWD` — the same
// split ../linux/os.bit's `/proc/self/exe` resolution already carries.
export @nosplit @symbol("bit_rt_fs_is_symlink_w") fn rtFsIsSymlinkW(
  words: int,
  n: int,
): bool {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return false
  }
  let buf = int(ptrOf(fsLinkBuf))
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysReadlinkX64(), i64(p), i64(buf), i64(fsLinkBufBytes)))
  } else {
    rc = int(syscall(sysReadlinkatArm64(), i64(atFdCwd), i64(p), i64(buf), i64(fsLinkBufBytes)))
  }
  return rc >= 0
}

// `bit_rt_fs_mkdir`: 0 on success, -1 on failure (including "already exists").
// x86_64 `mkdir` (nr 83) / aarch64 `mkdirat(AT_FDCWD, …)` (nr 34), mode 0o755.
export @nosplit @symbol("bit_rt_fs_mkdir") fn rtFsMkdir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysMkdirX64(), i64(p), i64(permDir)))
  } else {
    rc = int(syscall(sysMkdiratArm64(), i64(atFdCwd), i64(p), i64(permDir)))
  }
  if (rc == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_remove`: 0 on success, -1 on failure. Deletes a file or an *empty*
// directory: `unlink` then `rmdir` — `runtime/sched/`'s `removeAt`. aarch64 folds both
// into `unlinkat`, the second carrying `AT_REMOVEDIR`.
export @nosplit @symbol("bit_rt_fs_remove") fn rtFsRemove(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (isX64()) {
    if (int(syscall(sysUnlinkX64(), i64(p))) == 0) {
      return 0
    }
    if (int(syscall(sysRmdirX64(), i64(p))) == 0) {
      return 0
    }
    return 0 - 1
  }
  if (int(syscall(sysUnlinkatArm64(), i64(atFdCwd), i64(p), i64(0))) == 0) {
    return 0
  }
  if (int(syscall(sysUnlinkatArm64(), i64(atFdCwd), i64(p), i64(atRemoveDir))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_list_dir`: `path`'s entries, each terminated by a NUL byte, `.`/`..`
// omitted. Empty string when the directory is empty or unreadable (`std/fs`
// checks `isDir` first to tell those apart). Two passes — measure, then fill a
// string sized to it (Power of 10 rule 3, no unbounded growth) — rather than
// `runtime/root/`'s growing `ArrayList`. A directory that shrinks between passes
// yields fewer bytes than measured, so the result is trimmed to what pass 2 wrote
// (`rtStringSlice` rejects `hi > len`, so the clamp also guards the allocation).
export @nosplit @symbol("bit_rt_fs_list_dir") fn rtFsListDir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return emptyStr()
  }
  let needed = sysList(p, 0, 0)
  if (needed <= 0) {
    return emptyStr()
  }
  let out = rtStrAlloc(needed)
  if (out == 0) {
    return emptyStr()
  }
  let got = sysList(p, strData(out), needed)
  if (got <= 0) {
    return emptyStr()
  }
  if (got > needed) {
    got = needed
  }
  return rtStringSlice(out, 0, got)
}

// Linux errno for an interrupted syscall (`<asm-generic/errno-base.h>`,
// identical on x86_64 and aarch64, and identical to Darwin's `EINTR` too —
// see ../../net/darwin/sock.bit's note that EINTR is the one errno that does
// NOT differ between the two). A raw `syscall` failure IS `-errno` directly
// (this file's header), so no accessor is needed the way Darwin's `__error()`
// is: the value is already sitting in the return register.
const errnoIntr: int = 0 - 4

// A large but PROVABLY BOUNDED retry budget (Power of 10 rule 2) for a `read`
// interrupted by a signal (`EINTR`): POSIX says retry, and under concurrent
// process/signal load (#2980) more than a handful of interruptions across one
// file's read is plausible, so this is generous rather than tight.
const maxReadAllRetries: int = 1000

// `bit_rt_fs_read_all`: the whole file as a fresh string. Sized from the file
// offset (`lseek` to end, then rewind); a seek error, an allocation failure
// and a genuine empty file all currently yield the empty string --
// deliberately for the genuine-empty case, conflated with the other two only
// because `string` has no sentinel that could tell them apart (see the
// `end < 0` / `s == 0` branches' comments, #2996).
//
// A short read NEVER fabricates content (#2990). `read` returning `n <= 0`
// before `off` reaches `end` is one of three things: (a) `EINTR` — a signal
// landed mid-call, not a failure, retried below; (b) `n == 0` — the file
// shrank between the `lseek` probe and this read (a TOCTOU race, not this
// runtime's error to report); (c) any other negative result — a genuine I/O
// error. (b) and (c) both stop the read and return the string TRIMMED to the
// `off` bytes actually verified read. The old code returned the full-length
// string with its un-filled tail left as the zero bytes `rtStrAlloc` clears
// memory to — indistinguishable from a file that genuinely contains NULs,
// which made this silent corruption rather than an honest short read. Matches
// ../darwin/fs.bit's `rtFsReadAll`, per this file's per-arch-shape rule.
//
// BOUNDED (Power of 10 rule 2): every iteration that continues the loop
// advances `off` by at least 1 (a successful partial read) OR advances
// `retries` by 1 (an `EINTR` retry) — both counters are capped by the loop
// condition itself, so the loop runs at most `end + maxReadAllRetries` times.
export @nosplit @symbol("bit_rt_fs_read_all") fn rtFsReadAll(fd: int): int {
  let end = int(syscall(sysLseek(), i64(fd), i64(0), i64(2)))
  if (end < 0) {
    // `lseek` FAILED (fd is a pipe, a closed descriptor, etc.) -- a genuine
    // I/O error, unambiguous: lseek's own failure return is negative and a
    // file's size never is (#2996). Currently indistinguishable from the
    // `end == 0` branch below to a CALLER, because `bit_rt_fs_read_all`
    // returns `string`, and `string` has no nil sentinel to carry the
    // difference (SPEC SS5.7/SS13.4: `string`'s zero value is the empty
    // string, not `nil` -- unlike the reference types that do have one).
    // Surfacing this to a caller needs an out-of-band channel, exactly what
    // #2994 added (`bit_rt_fs_read_all_failed`, a companion query symbol) and
    // was reverted for: `std/fs` sits on `tools/build/artifacts.bit`'s import
    // path, and the pinned stage0's `libbitrt.a` predates that symbol, so
    // linking `tools/build/artifacts.bit` with stage0 died E0078 on a clean
    // tree. Re-adding it needs a stage0 repin first (or a design that adds no
    // new `std/fs`-reachable ABI surface) -- tracked on #2996, not fixed here.
    return emptyStr()
  }
  if (end == 0) {
    // `lseek` succeeded and reported 0: a genuinely empty file. Unambiguous,
    // and this is the correct, safe result -- `string`'s zero value IS the
    // empty string (SPEC SS13.4), so no sentinel is needed or possible here.
    return emptyStr()
  }
  syscall(sysLseek(), i64(fd), i64(0), i64(0))
  let s = rtStrAlloc(end)
  if (s == 0) {
    // Allocation failed for a file we already know is non-empty (`end > 0`
    // above). A genuine failure, distinct in cause from both branches above,
    // but conflated with them in the return value for the identical reason:
    // no nil sentinel exists for `string` (#2996). Same blocker, same fix
    // shape as the `end < 0` branch's comment.
    return emptyStr()
  }
  let base = strData(s)
  let off = 0
  let retries = 0
  while (off < end && retries < maxReadAllRetries) {
    // Bracketed for the same reason `rtFsRead` above is (#2207, and #2990's
    // investigation found this call was NOT bracketed): `fd` may be a pipe or
    // a slow device, so this can block indefinitely, and `base` points into a
    // live string held across the call, so `syscall`, not `blocked`.
    gcSyscallBegin()
    let n = int(syscall(sysRead(), i64(fd), i64(base + off), i64(end - off)))
    gcSyscallEnd()
    if (n > 0) {
      off = off + n
    } else if (n == errnoIntr) {
      retries = retries + 1
    } else {
      return rtStringSlice(s, 0, off)
    }
  }
  if (off < end) {
    return rtStringSlice(s, 0, off)
  }
  return s
}

// `bit_rt_fs_write`: write all of `s`'s bytes to `fd`. Returns the byte count, or
// -1 on any write error.
//
// BOUNDED (Power of 10 rule 2): `off` rises by at least 1 each iteration (a zero
// write breaks, an error returns) and the loop exits at `off >= len`.
export @nosplit @symbol("bit_rt_fs_write") fn rtFsWrite(fd: int, s: int): int {
  let total = strLenOf(s)
  let base = strData(s)
  let off = 0
  while (off < total) {
    // Bracketed for the same reason as `rtFsRead` above (#2207): a write to a
    // full pipe or a slow tty blocks until the far end drains, and an
    // unbracketed block spins whichever thread wants a stop-the-world. `base`
    // points into a live string held across the call, so `syscall`, not
    // `blocked`.
    gcSyscallBegin()
    let n = int(syscall(sysWrite(), i64(fd), i64(base + off), i64(total - off)))
    gcSyscallEnd()
    if (n < 0) {
      return 0 - 1
    }
    if (n == 0) {
      return off
    }
    off = off + n
  }
  return off
}

// `bit_rt_fs_chmod`: set `path`'s permission bits to `mode`. 0 on success, -1 on
// any error. x86_64 `chmod` (nr 90) / aarch64 `fchmodat(AT_FDCWD, …)` (nr 53).
export @nosplit @symbol("bit_rt_fs_chmod") fn rtFsChmod(path: int, mode: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysChmodX64(), i64(p), i64(mode)))
  } else {
    rc = int(syscall(sysFchmodatArm64(), i64(atFdCwd), i64(p), i64(mode)))
  }
  if (rc == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_close`: close `fd`. Always reports success, matching `runtime/root/`.
export @nosplit @symbol("bit_rt_fs_close") fn rtFsClose(fd: int): int {
  syscall(sysClose(), i64(fd))
  return 0
}
