// `bit_rt_os_hostname` (ABI.md §19, #7192): the local host name, for
// `std/os`'s `hostname`. Same module as ./fs.bit and ./os.bit (an import is
// per module, not per file), so `fsScratchSlot`, `loadByte` and `storeByte`
// are already in scope; only `sysUname` needs an import. Its own file because
// ./os.bit sits at 768 lines and `spec/LINT.md` §4 caps a file at 800.
//
// `uname(2)` and its `nodename` field, not a libc `gethostname` (this runtime
// issues no libc): glibc's `gethostname` is `uname` plus a copy, so the name is
// the same. `struct utsname` is six NUL-terminated 65-byte fields on both
// architectures (`<sys/utsname.h>`'s `_UTSNAME_LENGTH`), 390 bytes, with
// `nodename` second. A node name therefore never exceeds 64 bytes, the kernel's
// own `__NEW_UTS_LEN`.
import { sysUname } from "../../syscalls"

const utsFieldBytes: int = 65
const utsNodenameOff: int = 65
// 390 bytes = 49 words per slot, (`fsScratchSlots` + 1) = 33 slots: one region
// per worker plus the fallback, the shape `fsStatBuf` (./fs.bit) uses. A scalar
// array so the collector never scans it. No park lies between the syscall and
// the copy-out below, so a worker's slot is never shared (#3274's argument).
let osUtsBuf: [1617]i64
const osUtsSlotWords: int = 49

// Write the host name at `buf` (room for `room` bytes) NUL-terminated and return
// its length, which is always < `room`. `0 - 1` when `uname` fails or the name
// plus its NUL does not fit: rejected, never truncated.
export @nosplit @symbol("bit_rt_os_hostname") fn rtOsHostname(buf: int, room: int): int {
  if (buf == 0 || room < 2) {
    return 0 - 1
  }
  let uts = int(ptrOf(osUtsBuf)) + fsScratchSlot() * osUtsSlotWords * 8
  if (int(syscall(sysUname(), i64(uts))) < 0) {
    return 0 - 1
  }
  let src = uts + utsNodenameOff
  let n = 0
  while (n < utsFieldBytes - 1) {
    let c = loadByte(src + n)
    if (c == 0) {
      break
    }
    if (n + 1 >= room) {
      return 0 - 1
    }
    storeByte(buf + n, c)
    n = n + 1
  }
  storeByte(buf + n, 0)
  return n
}
