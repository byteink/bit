// Linux signal-disposition provider for the SEAM 3 remainder: the one process-
// wide `sigaction` `boot` (#1608) needs — ignoring SIGPIPE so a `write` to a
// socket whose peer has closed its read end returns EPIPE instead of raising
// SIGPIPE, whose default disposition kills the process with no output. This is
// the Bit form of `runtime/root/`'s `ignoreSigpipe` (runtime/root/:1965), and
// every networked runtime installs it at startup (Go, libuv).
//
// SELF-CONTAINED (the io.bit/fs.bit/os.bit shape), NOT parent-wrappers-over-
// extern (the netabi shape): a raw `rt_sigaction` trap here, because `extern
// function` targeting Linux is rejected by `rejectExternForTarget` on a
// `--emit-obj` with no archive (E0078) — see ../fs.bit's header. The Darwin
// sibling makes the libSystem `sigaction` call instead, the same §11.7/§11.8
// split every other provider in this tree uses.
//
// EVERY NUMBER AND STRUCT OFFSET BELOW IS THE KERNEL'S, NOT THIS PROJECT'S:
// the `class sigaction` the kernel actually reads (its `k_sigaction`, NOT
// libc's), the `SIG`/`SA` constants from include/uapi/asm-generic/signal.h, and
// `rt_sigaction`'s number from the per-arch syscall table. NOT FROM MEMORY. A wrong number or offset here is a SILENT
// wrong-syscall: the build stays green and the process still dies on a broken
// pipe, a defect only a closed-socket write reveals.
//
// ALL 11 FUNCTIONS BELOW ARE `@nosplit` TODAY (`ignoreSigpipe`,
// `ucontextSpOffset`, `installAltStackForThisWorker`, `segvHandler`,
// `classifyOverflowTrap`, `trapHandler`, `emitMainStackOverflow`,
// `emitSpawnedStackOverflow`, `emitFatalSignal`, `sigReturnTrampoline`,
// `installFatalSignalHandlers`) — `@nosplit` no longer categorically rejects
// `syscall` (E0075): #1640 admitted it to §10.3.1's allowlist on PROOF, the
// same argument ../linux/io.bit's header now makes for its own write path.
// This directory already builds `--freestanding --emit-obj` (io.bit's header
// again), so the old "cannot become freestanding until #1369" framing is
// gone too.

// `storeWord`/`loadWord` are imported from ../../gc by ./os.bit; module-
// scoped (siblings are one module), so they are reused here, not
// re-declared — a redeclaration is E0042. The syscall numbers come from
// `runtime/syscalls/syscalls.bit`'s `sysRtSigaction`/`sysSigaltstack`
// (imported below), not from a local `nr()` selector — #1897 moved every
// per-arch syscall-number function there and none is named `nr` any more.

import { onX64, sysSigaltstack } from "../../syscalls"

// `rt_sigaction` (the per-arch syscall tables): 13 on x86_64, 134 on aarch64.
// `rt_sigaction`, NOT the legacy `sigaction`: the kernel's real-time variant is
// the only one the modern ABI exposes and is what `std.posix.sigaction` traps.

// SIG.PIPE = 13 and SIG.IGN = 1 on every non-MIPS/non-SPARC Linux ABI, x86_64
// and aarch64 included (include/uapi/asm-generic/signal.h). SIG_IGN's numeric
// handler value is the sentinel pointer 1, stored where a real handler address
// would go.

const sigPipe: int = 13
const sigIgn: int = 1

// The kernel `class sigaction` (`k_sigaction`, NOT libc's) for x86_64 and
// aarch64 — both take the `else` branch, identical layout:
//
//     offset  0 : handler   (8 bytes)  <- SIG_IGN = 1
//     offset  8 : flags     (c_ulong)  <- 0
//     offset 16 : restorer  (8 bytes)  <- 0
//     offset 24 : mask      (sigset_t) <- 0  (sigset_t = [1]c_ulong, NSIG=65)
//
// = 32 bytes = 4 words. RESTORER LEFT NULL AND SA_RESTORER UNSET IS CORRECT FOR
// SIG_IGN: the restorer trampoline is consulted only when a real handler
// RETURNS (to invoke rt_sigreturn), which never happens for an ignored signal,
// so the kernel never reads it. `std.posix.sigaction` installs one because it
// must serve real handlers too; ignoring one signal does not.
const sigActionWords: int = 4

// `sigsetsize`, the mandatory 4th argument to `rt_sigaction`: the byte width of
// the kernel's `sigset_t`. `std.posix.sigaction` passes `@sizeOf(mask)` = 8
// (include/uapi/asm-generic/signal.h) — the kernel rejects any other value with EINVAL.
const sigSetSize: int = 8

// The `class sigaction` scratch, MODULE-LEVEL and unlocked. SAFE AT ANY
// WORKER COUNT, but NOT by the single-worker/adjacency argument this used to
// cite — that argument does not hold for a genuinely shared buffer (#3279,
// ABI.md §5.1/§22). What makes it safe: `boot`'s step 1 calls `ignoreSigpipe`
// exactly once, before step 2 maps the heap and before the scheduler seats
// any worker — ABI.md §22's "write-once-before-any-worker-exists" category.
// `ignoreSigpipe`'s only other caller in the tree, _tests_/stress/sigpipelinux's
// `main`, runs a single sequential call after `boot` has already returned —
// still one writer at a time, never two. A scalar array is never scanned by
// the collector (rule 1).
let sigActBuf: [4]i64

// `bit_rt_ignore_sigpipe` (post-#1369 name): install SIG_IGN for SIGPIPE
// process-wide. Returns the raw `rt_sigaction` result — 0 on success, a small
// negative errno on failure — so `boot` and the test can observe it, though
// `runtime/root/`'s `ignoreSigpipe` discards it (there is no recovery from a failed
// disposition change on the boot path). Idempotent: re-installing SIG_IGN over
// SIG_IGN is a no-op.
//
// PINNED under the bare ABI name, NOT `bit_rt_port_`: this is a real ABI
// name `boot` (#1608) calls, bare since G2 (#1583) — the same convention
// ./io.bit documents for `bit_rt_panic` and the rest.
export @nosplit @symbol("bit_rt_ignore_sigpipe") fn ignoreSigpipe(): int {
  let base = int(ptrOf(sigActBuf))
  let i = 0
  while (i < sigActionWords) {
    storeWord(base + i * 8, 0)
    i = i + 1
  }
  storeWord(base, sigIgn)
  return int(syscall(sysRtSigaction(), i64(sigPipe), i64(base), i64(0), i64(sigSetSize)))
}

// ---------------------------------------------------------------------------
// #2246: a diagnosable SIGSEGV/SIGBUS instead of a silent exit 139
// ---------------------------------------------------------------------------
//
// KEPT FUNCTION-FOR-FUNCTION WITH ../darwin/signal.bit — see its header for
// the two defects #2246 named and why this is only the second one (the
// undiagnosed death, not the stack's fixed size, which is #2613's). The
// differences here are exactly the ones the rest of this file already has:
// raw `syscall`s instead of libSystem `extern function` calls, and the
// kernel's class layouts instead of Darwin's.

// SIGSEGV = 11, SIGBUS = 7 on every non-MIPS/non-SPARC Linux ABI, x86_64 and
// aarch64 included (include/uapi/asm-generic/signal.h, and confirmed neither
// arch's own asm/signal.h overrides it) — NOT Darwin's SIGBUS (10,
// ../darwin/signal.bit): the two are unrelated historical-Unix numberings
// that happen to share SIGPIPE's number and nothing else nearby.
const sigSegv: int = 11
const sigBus: int = 7

// SIGILL = 4, SIGTRAP = 5 on every non-MIPS/non-SPARC Linux ABI, x86_64 and
// aarch64 included (`include/uapi/asm-generic/signal.h`, the same header
// already cited above for SIGBUS/SIGSEGV/SIGPIPE) — UNLIKE SIGBUS these two
// are the SAME number as Darwin's (../darwin/signal.bit): the classic low
// signals 1-6 predate the BSD/SysV split that gave SIGBUS its two numbers.
// #2946: the OTHER shape #2432's inline `ud2` (x86_64)/`brk #0` (aarch64)
// traps raise when `schedCurrentTask` returns 0 — see `classifyOverflowTrap`
// below.
const sigIll: int = 4
const sigTrap: int = 5

// SA_SIGINFO = 0x4, SA_ONSTACK = 0x08000000 (`include/uapi/asm-generic/
// signal-defs.h`, included by both x86_64's and aarch64's `asm/signal.h`
// unchanged — verified, not from memory). SA_SIGINFO selects the
// three-argument `void (*)(int, siginfo_t *, void *)` handler form
// `segvHandler` below is written to. SA_ONSTACK runs it on the alternate
// stack `installAltStackForThisWorker` installs below — REQUIRED, not
// optional: the fault this exists to catch is, most often, a green thread's
// OWN stack having just run out, and a handler sharing that stack would fault
// again before writing a single byte.
const saSiginfo: int = 4
const saOnstack: int = 134217728

// SA_RESTORER = 0x04000000 (`include/uapi/asm-generic/signal-defs.h`, same
// header as SA_SIGINFO/SA_ONSTACK above). REQUIRED on x86_64, not optional
// (#2988): `arch/x86/kernel/signal.c`'s `__setup_rt_frame` for a native
// 64-bit process starts with
//
//     /* x86-64 should always use SA_RESTORER. */
//     if (!(ksig->ka.sa.sa_flags & SA_RESTORER))
//         return -EFAULT;
//
// and refuses BEFORE it ever writes `regs->ip = handler` — so a registration
// missing this flag is accepted by `rt_sigaction` (which only validates the
// arguments, not the eventual delivery) and then silently never fires: the
// frame build fails, `force_sigsegv` resets the disposition to SIG_DFL and
// re-raises, and the process dies with the ORIGINAL fault's `rip` still
// showing, no handler ever entered, nothing on stderr. That is `bit: stack
// overflow in a spawned task` never printing and exit 139 with empty stderr —
// confirmed on real x86_64 hardware (`ssh hl-master`) with a core dump: the
// crashed thread's `NT_PRSTATUS` showed `rip` still at the user program's own
// faulting instruction, never having moved to `segvHandler`'s address, and
// the second (fatal) SIGSEGV carried `si_code=SI_KERNEL si_addr=NULL` —
// exactly `force_sigsegv`'s synthetic siginfo, not a real fault.
//
// The restorer this flag names is `sigReturnTrampoline` below. It is
// EFFECTIVELY DEAD CODE for `segvHandler`/`trapHandler`, which never return —
// every path ends in `rootExit` — so the kernel never actually jumps to it.
// The flag and a VALID pointer must still be present at REGISTRATION time
// regardless: the check above is unconditional on `sa_flags`, checked once
// when the signal is delivered, with no dependency on whether the handler
// later returns.
const saRestorer: int = 67108864

// `sigaltstack(2)`'s `stack_t` — `{ void *ss_sp; int ss_flags; size_t
// ss_size; }`, 24 bytes. THE FIELD ORDER IS LINUX'S OWN: Darwin puts
// `ss_size` second and `ss_flags` last (../darwin/signal.bit). Verified with
// a cross-compiled `offsetof` against this kernel's own
// `include/uapi/asm-generic/signal.h`, identical on x86_64 and aarch64, not
// from memory. `installAltStackForThisWorker` below writes it directly (three
// `storeWord`s, 24 bytes), so there is no separate word-count const to keep
// in sync with the field layout comment.

// `siginfo_t.si_addr` — the faulting address SA_SIGINFO hands the handler,
// `segvHandler`'s second argument. Verified with a cross-compiled `offsetof`
// against glibc's `<signal.h>`, identical on x86_64 and aarch64: offset 16,
// `sizeof(siginfo_t)` = 128. This is the layout the KERNEL constructs on the
// signal stack — glibc's typedef exists to match it exactly, which is what a
// raw `rt_sigaction` handler (this file's whole reason to exist, see the
// header) actually receives.
const siAddrOffset: int = 16

// The saved stack pointer inside the `ucontext_t` SA_SIGINFO hands the
// handler as its third argument, unlike Darwin's `ucontext_t`
// (../darwin/signal.bit) this is INLINE, not a second pointer to follow.
// Verified with a cross-compiled `offsetof(ucontext_t, uc_mcontext.gregs[
// REG_RSP])` / `offsetof(ucontext_t, uc_mcontext.sp)` against glibc's
// `sys/ucontext.h` for each arch — NOT from memory, and the two differ enough
// that guessing one from the other would be wrong: x86_64's `uc_mcontext` is
// INLINE at offset 40 with `gregs[REG_RSP=15]` at 15*8=120 more (160 total);
// aarch64's `sigcontext`-shaped `uc_mcontext` is 16-byte-aligned, which
// inserts 8 bytes of padding the naive sum misses (176, not 168) before
// `fault_address(8) + regs[31](248)` = 256 more (432 total).
@nosplit fn ucontextSpOffset(): int {
  if (onX64()) {
    return 160
  }
  return 432
}

// The floor both `segvHandler` and `classifyOverflowTrap` gate every
// alignment match against: it rules out a degenerate near-zero reading (e.g.
// both inputs landing on unmapped/zeroed memory) agreeing with itself, or an
// uninitialized `mainStackBaseAddr` (0 before step 5 of `boot`) matching a
// coincidentally-zero candidate. Every real stack mapping on this platform
// sits far above it. Named rather than left as the two functions' own inline
// literal so the two attribution paths cannot silently drift apart. Identical
// to ../darwin/signal.bit's.
const stackAddrFloor: int = 268435456

// One alternate signal stack per worker OS thread, 64 KiB — comfortably above
// `MINSIGSTKSZ` (2048 on x86_64, 5120 on aarch64 per each arch's own
// `asm/signal.h`) and a round number matching the granule this runtime
// already reasons in. `boot` maps `bootMaxWorkers * sigAltStackBytes` once, before
// any worker starts (`sigAltStackBase`, ./boot.bit); each worker OS thread
// claims one slice for itself below, because `sigaltstack` is per-THREAD, not
// per-process — two workers sharing one alternate stack would corrupt each
// other's crash message if they ever overflowed at the same instant.
const sigAltStackBytes: int = 65536

// `installAltStackForThisWorker`'s claim table: 0 = free, 1 = claimed, sized
// for `bootMaxWorkers` (../boot.bit) and never released — workers do not exit
// before process teardown. Same claim-then-use shape as
// `../../thread/linux/spawn.bit`'s per-slot claim: an atomic CAS per slot,
// bounded, first-free wins.
let sigAltStackClaimed: [32]i64

// Per-slot scratch for the `stack_t` `sigaltstack` argument, three words per
// worker (24 bytes) — NOT the shared `sigActBuf` module scratch that buffer's
// own doc documents as single-writer, because MULTIPLE worker OS threads call
// `installAltStackForThisWorker` concurrently at startup, and a shared buffer
// would race. Each worker writes only its own `[claimedIndex*3,
// claimedIndex*3+3)` slice, which no other worker's claimed index can ever
// overlap.
let sigAltStackScratch: [96]i64

// The kernel `class sigaction` buffer `installFatalSignalHandlers` builds
// for SIGSEGV/SIGBUS — same 4-word shape `sigActBuf` uses (see its comment
// above), a separate buffer for clarity. Same boot-order safety as
// `sigActBuf` (#3279, ABI.md §22), not adjacency or the single-worker
// contract: `boot`'s step 1b calls `installFatalSignalHandlers` exactly
// once, and it is the ONLY caller anywhere in the tree.
let segvActBuf: [4]i64

// The SAME shape, for SIGTRAP/SIGILL (#2946) — a separate buffer because it
// carries a DIFFERENT handler entry (`entryOf(trapHandler)` vs
// `entryOf(segvHandler)`), written once from the same call in
// `installFatalSignalHandlers`.
let trapActBuf: [4]i64

// Claim a slot from the pool above and install THIS OS thread's slice of
// `sigAltStackBase` as its alternate signal stack. A no-op if `boot` never
// mapped one (`sigAltStackBase == 0` — a setup failure `boot` already treats
// as fatal, so this is defensive, not an expected path) or if the pool is
// exhausted (cannot happen: `boot` never starts more than `bootMaxWorkers`
// workers, ../boot.bit). Call once, from the very top of `workerBody`, before
// any task can run on this thread.
@nosplit fn installAltStackForThisWorker() {
  if (sigAltStackBase == 0) {
    return
  }
  let tbl: *i64 = ptrOf(sigAltStackClaimed)
  let scratch = int(ptrOf(sigAltStackScratch))
  let i = 0
  while (i < bootMaxWorkers) {
    if (atomicCmpxchg(tbl + i, 0, 1)) {
      let sp = scratch + i * 24
      storeWord(sp, sigAltStackBase + i * sigAltStackBytes)
      storeWord(sp + 8, 0)
      storeWord(sp + 16, sigAltStackBytes)
      syscall(sysSigaltstack(), i64(sp), i64(0))
      return
    }
    i = i + 1
  }
}

// The alternate-stack SIGSEGV/SIGBUS handler. See ../darwin/signal.bit's
// `segvHandler` for the full reasoning (why `@nosplit`, the attribution and
// its one direction of possible error, and why an unattributed fault gets a
// plain message and a clean exit rather than a pass-through to the OS
// default) — identical here except for the platform offsets above.
@nosplit fn segvHandler(sig: i32, info: *u8, ctx: *u8) {
  let faultAddr = loadWord(int(info) + siAddrOffset)
  let sp = loadWord(int(ctx) + ucontextSpOffset())

  let fromFault = alignUpStack(faultAddr)
  let fromSp = alignUpStack(sp)
  if (fromFault == fromSp && fromFault > stackAddrFloor) {
    if (fromFault == mainStackBaseAddr) {
      emitMainStackOverflow()
    } else {
      emitSpawnedStackOverflow()
    }
    return
  }
  emitFatalSignal(int(sig))
}

// ---------------------------------------------------------------------------
// #2946: the OTHER undiagnosed shape — SIGTRAP (aarch64)/SIGILL (x86_64)
// from #2432's inline traps, not SIGSEGV/SIGBUS
// ---------------------------------------------------------------------------
//
// See ../darwin/signal.bit's matching section header for the full reasoning
// (the corruption mechanism, the debugger-interference trade-off this ticket
// requires stating explicitly, the retired "how close to the floor" first
// attempt and why it under-attributed roughly a quarter of runs in testing,
// and why the working check instead re-reads the tag AT the floor rather
// than reasoning about `sp`'s current offset within the granule) —
// identical here except for the platform offsets/syscalls already
// established above.
const overflowNone: int = 0
const overflowMain: int = 1
const overflowSpawned: int = 2

@nosplit fn classifyOverflowTrap(sp: int): int {
  let floorBase = alignDownStack(sp)
  if (floorBase <= stackAddrFloor) {
    return overflowNone
  }
  if (floorBase == mainStackBaseAddr) {
    return overflowMain
  }
  if (schedTaskOnStack(floorBase) != 0) {
    return overflowNone
  }
  return overflowSpawned
}

// The alternate-stack SIGTRAP/SIGILL handler — same ABI shape as
// `segvHandler` (SA_SIGINFO selects this three-argument form), same
// `@nosplit` discipline for the same reason. Identical to
// ../darwin/signal.bit's `trapHandler`.
@nosplit fn trapHandler(sig: i32, info: *u8, ctx: *u8) {
  let sp = loadWord(int(ctx) + ucontextSpOffset())
  let verdict = classifyOverflowTrap(sp)
  if (verdict == overflowMain) {
    emitMainStackOverflow()
    return
  }
  if (verdict == overflowSpawned) {
    emitSpawnedStackOverflow()
    return
  }
  emitFatalSignal(int(sig))
}

// "bit: stack overflow\n" — packed constants, computed not hand-derived, the
// same technique every alloc-free panic message in ./io.bit uses.
//
// `writeConstSignalSafe`, NEVER `writeConst` (#3728): this runs on the
// alternate signal stack, where `writeConst`'s per-worker slot lookup reads
// memory at the masked-down CURRENT (alt-stack) stack pointer — genuinely
// unmapped often enough on Linux to second-fault and kill the process
// before this message reaches stderr. See `ioConstScratchSlotSignalSafe`'s
// header (../io.bit) for the full mechanism.
@nosplit fn emitMainStackOverflow() {
  writeConstSignalSafe(stderrFd, 7022364301234301282, 8) // "bit: sta"
  writeConstSignalSafe(stderrFd, 7382074298558606179, 8) // "ck overf"
  writeConstSignalSafe(stderrFd, 175599468, 4)           // "low\n"
  rootExit(2)
}

// "bit: stack overflow in a spawned task\n" — see `emitMainStackOverflow`
// above for why this must be `writeConstSignalSafe`, not `writeConst`.
@nosplit fn emitSpawnedStackOverflow() {
  writeConstSignalSafe(stderrFd, 7022364301234301282, 8) // "bit: sta"
  writeConstSignalSafe(stderrFd, 7382074298558606179, 8) // "ck overf"
  writeConstSignalSafe(stderrFd, 6998715218729070444, 8) // "low in a"
  writeConstSignalSafe(stderrFd, 7234309835455492896, 8) // " spawned"
  writeConstSignalSafe(stderrFd, 11456613544992, 6)      // " task\n"
  rootExit(2)
}

// "bit: fatal signal: segmentation fault\n" / "bit: fatal signal: bus error\n"
// / "bit: fatal signal: trace trap\n" / "bit: fatal signal: illegal
// instruction\n" — the honest fallback when the signal cannot be placed on a
// stack boundary. The last two are #2946's: a SIGTRAP/SIGILL that
// `classifyOverflowTrap` could not attribute to one of #2432's four sites.
//
// `writeConstSignalSafe`, NEVER `writeConst` (#3728) — see
// `emitMainStackOverflow` above.
@nosplit fn emitFatalSignal(sig: int) {
  writeConstSignalSafe(stderrFd, 8386096269746268514, 8) // "bit: fat"
  writeConstSignalSafe(stderrFd, 7020662571717913697, 8) // "al signa"
  if (sig == sigSegv) {
    writeConstSignalSafe(stderrFd, 7308611455713032812, 8) // "l: segme"
    writeConstSignalSafe(stderrFd, 2336927755366659182, 8) // "ntation "
    writeConstSignalSafe(stderrFd, 11495152116070, 6)      // "fault\n"
  } else if (sig == sigTrap) {
    writeConstSignalSafe(stderrFd, 7305790164727511660, 8) // "l: trace"
    writeConstSignalSafe(stderrFd, 11477787505696, 6)      // " trap\n"
  } else if (sig == sigIll) {
    writeConstSignalSafe(stderrFd, 7450480371430341228, 8) // "l: illeg"
    writeConstSignalSafe(stderrFd, 8247343735669550177, 8) // "al instr"
    writeConstSignalSafe(stderrFd, 2936174556767093, 7)    // "uction\n"
  } else {
    writeConstSignalSafe(stderrFd, 7286951145080109676, 8) // "l: bus e"
    writeConstSignalSafe(stderrFd, 44869579378, 5)         // "rror\n"
  }
  rootExit(2)
}

// The `sa_restorer` `installFatalSignalHandlers` registers (#2988, see
// `saRestorer` above for why a real one is mandatory on x86_64 even though
// neither `segvHandler` nor `trapHandler` ever returns through it). Two
// instructions, `mov $__NR_rt_sigreturn, %eax; syscall` on x64 — the classic
// libc trampoline shape — `mov x8, #__NR_rt_sigreturn; svc #0` on arm64. Both
// architectures' numbers are from the per-arch kernel syscall table, not from
// memory: 15 on x86_64 (`arch/x86/entry/syscalls/syscall_64.tbl`), 139 on
// aarch64 (`include/uapi/asm-generic/unistd.h`, `__NR_rt_sigreturn`).
//
// Provided on BOTH architectures even though the mandatory check above is
// documented only for x86_64: a valid restorer is always correct to supply,
// and #2988's hardware reproduction is x86_64-only (`ssh hl-master`) — this
// aarch64-linux arm is unverified on real hardware and should be confirmed
// there before being relied on.
@nosplit fn sigReturnTrampoline() {
  asm {
    arm64 { 0xD2801168, 0xD4000001 }                 // mov x8, #139; svc #0
    x64 { 0xB8, 0x0F, 0x00, 0x00, 0x00, 0x0F, 0x05 } // mov eax, 15; syscall
  }
}

// Register `segvHandler` for SIGSEGV/SIGBUS and `trapHandler` for
// SIGTRAP/SIGILL (#2946), process-wide, SA_SIGINFO | SA_ONSTACK | SA_RESTORER.
// Same 4-word kernel `class sigaction` shape `ignoreSigpipe` builds, in two
// separate buffers (`segvActBuf`/`trapActBuf`, one per handler entry) written
// once, from `boot`, before any worker thread exists — call this before step 6
// starts any worker, so both dispositions are live before the first task can
// run.
@nosplit fn installFatalSignalHandlers() {
  let restorer = int(entryOf(sigReturnTrampoline))

  let base = int(ptrOf(segvActBuf))
  storeWord(base, int(entryOf(segvHandler)))
  storeWord(base + 8, i64(saSiginfo | saOnstack | saRestorer))
  storeWord(base + 16, restorer)
  storeWord(base + 24, 0)
  syscall(sysRtSigaction(), i64(sigSegv), i64(base), i64(0), i64(sigSetSize))
  syscall(sysRtSigaction(), i64(sigBus), i64(base), i64(0), i64(sigSetSize))

  let trapBase = int(ptrOf(trapActBuf))
  storeWord(trapBase, int(entryOf(trapHandler)))
  storeWord(trapBase + 8, i64(saSiginfo | saOnstack | saRestorer))
  storeWord(trapBase + 16, restorer)
  storeWord(trapBase + 24, 0)
  syscall(sysRtSigaction(), i64(sigTrap), i64(trapBase), i64(0), i64(sigSetSize))
  syscall(sysRtSigaction(), i64(sigIll), i64(trapBase), i64(0), i64(sigSetSize))
}

// ---------------------------------------------------------------------------
// #3507: SIGTERM/SIGINT must not orphan a `bit test`/`bit run --timeout`
// child. See ../darwin/signal.bit's matching section header for the full
// reasoning — identical here except for the platform registration mechanics
// (raw `rt_sigaction`, the kernel's `class sigaction` layout, and the
// mandatory `SA_RESTORER` #2988 already documents above).
// ---------------------------------------------------------------------------

// SIGINT = 2, SIGTERM = 15 on every non-MIPS/non-SPARC Linux ABI
// (`include/uapi/asm-generic/signal.h`), same numbers as Darwin's
// (../darwin/signal.bit), like SIGILL/SIGTRAP above.
const sigInt: int = 2
const sigTerm: int = 15

// The kernel `class sigaction` buffer for SIGTERM/SIGINT — same 4-word shape
// as `segvActBuf`/`trapActBuf` above, a separate buffer because it carries a
// DIFFERENT handler entry. Written once, from `boot`, alongside
// `installFatalSignalHandlers`.
let termActBuf: [4]i64

// The SIGTERM/SIGINT handler. See ../darwin/signal.bit's `termHandler` for
// the full reasoning (why it does not try to return through the interrupted
// context, and why `128 + sig` rather than resetting the disposition and
// re-raising), including #4172's `osKillAllUnboundedChildren` (plain `bit
// run`'s own child, tracked separately from a bounded child).
@nosplit fn termHandler(sig: i32, info: *u8, ctx: *u8) {
  osKillAllOutstandingChildren()
  osKillAllUnboundedChildren()
  rootExit(128 + int(sig))
}

// Register `termHandler` for SIGTERM and SIGINT, process-wide, SA_SIGINFO |
// SA_RESTORER — SA_RESTORER is mandatory on x86_64 regardless of SA_SIGINFO
// (#2988, see `saRestorer` above), so it is supplied on both architectures
// like `installFatalSignalHandlers` already does. No SA_ONSTACK: unlike a
// stack overflow, nothing about receiving SIGTERM implies this thread's own
// stack is in trouble. Call from `boot` alongside `installFatalSignalHandlers`,
// before any worker exists.
@nosplit fn installTerminationHandlers() {
  let restorer = int(entryOf(sigReturnTrampoline))

  let base = int(ptrOf(termActBuf))
  storeWord(base, int(entryOf(termHandler)))
  storeWord(base + 8, i64(saSiginfo | saRestorer))
  storeWord(base + 16, restorer)
  storeWord(base + 24, 0)
  syscall(sysRtSigaction(), i64(sigTerm), i64(base), i64(0), i64(sigSetSize))
  syscall(sysRtSigaction(), i64(sigInt), i64(base), i64(0), i64(sigSetSize))
}
