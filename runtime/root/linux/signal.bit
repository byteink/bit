// Linux signal-disposition provider for the SEAM 3 remainder: the one process-
// wide `sigaction` `boot` (#1608) needs — ignoring SIGPIPE so a `write` to a
// socket whose peer has closed its read end returns EPIPE instead of raising
// SIGPIPE, whose default disposition kills the process with no output. This is
// the Bit form of `runtime/root/`'s `ignoreSigpipe` (runtime/root/:1965), and
// every networked runtime installs it at startup (Go, libuv).
//
// SELF-CONTAINED (the io.bit/fs.bit/os.bit shape), NOT parent-wrappers-over-
// extern (the netabi shape): a raw `rt_sigaction` trap here, because `extern
// function` targeting Linux is rejected by `rejectExternForTarget` on a
// `--emit-obj` with no archive (E0078) — see ../fs.bit's header. The Darwin
// sibling makes the libSystem `sigaction` call instead, the same §11.7/§11.8
// split every other provider in this tree uses.
//
// EVERY NUMBER AND STRUCT OFFSET BELOW IS THE KERNEL'S, NOT THIS PROJECT'S:
// the `struct sigaction` the kernel actually reads (its `k_sigaction`, NOT
// libc's), the `SIG`/`SA` constants from include/uapi/asm-generic/signal.h, and
// `rt_sigaction`'s number from the per-arch syscall table. NOT FROM MEMORY. A wrong number or offset here is a SILENT
// wrong-syscall: the build stays green and the process still dies on a broken
// pipe, a defect only a closed-socket write reveals.
//
// Nothing here is `@nosplit`: `@nosplit` REJECTS `syscall` (E0075), the same
// reason ./io.bit gives — so this path cannot become a freestanding archive
// member until #1369, exactly like the write path.

// `nr` (per-arch syscall selector via `hostTarget()`) is defined in ./io.bit and
// `storeWord` is imported from ../../gc by ./os.bit; both are module-scoped
// (siblings are one module), so they are reused here, not re-declared — a
// redeclaration is E0042.

// `rt_sigaction` (the per-arch syscall tables): 13 on x86_64, 134 on aarch64.
// `rt_sigaction`, NOT the legacy `sigaction`: the kernel's real-time variant is
// the only one the modern ABI exposes and is what `std.posix.sigaction` traps.

// SIG.PIPE = 13 and SIG.IGN = 1 on every non-MIPS/non-SPARC Linux ABI, x86_64
// and aarch64 included (include/uapi/asm-generic/signal.h). SIG_IGN's numeric
// handler value is the sentinel pointer 1, stored where a real handler address
// would go.

const sigPipe: int = 13
const sigIgn: int = 1

// The kernel `struct sigaction` (`k_sigaction`, NOT libc's) for x86_64 and
// aarch64 — both take the `else` branch, identical layout:
//
//     offset  0 : handler   (8 bytes)  <- SIG_IGN = 1
//     offset  8 : flags     (c_ulong)  <- 0
//     offset 16 : restorer  (8 bytes)  <- 0
//     offset 24 : mask      (sigset_t) <- 0  (sigset_t = [1]c_ulong, NSIG=65)
//
// = 32 bytes = 4 words. RESTORER LEFT NULL AND SA_RESTORER UNSET IS CORRECT FOR
// SIG_IGN: the restorer trampoline is consulted only when a real handler
// RETURNS (to invoke rt_sigreturn), which never happens for an ignored signal,
// so the kernel never reads it. `std.posix.sigaction` installs one because it
// must serve real handlers too; ignoring one signal does not.
const sigActionWords: int = 4

// `sigsetsize`, the mandatory 4th argument to `rt_sigaction`: the byte width of
// the kernel's `sigset_t`. `std.posix.sigaction` passes `@sizeOf(mask)` = 8
// (include/uapi/asm-generic/signal.h) — the kernel rejects any other value with EINVAL.
const sigSetSize: int = 8

// The `struct sigaction` scratch, MODULE-LEVEL and unlocked, sound only under
// the single-worker contract (ABI.md §5) exactly as ../os.bit's `osArgvBuf`:
// `boot` installs this once, before the scheduler's workers exist, so there is
// no concurrent writer. A scalar array is never scanned by the collector
// (rule 1).
let sigActBuf: [4]i64

// `bit_rt_ignore_sigpipe` (post-#1369 name): install SIG_IGN for SIGPIPE
// process-wide. Returns the raw `rt_sigaction` result — 0 on success, a small
// negative errno on failure — so `boot` and the test can observe it, though
// `runtime/root/`'s `ignoreSigpipe` discards it (there is no recovery from a failed
// disposition change on the boot path). Idempotent: re-installing SIG_IGN over
// SIG_IGN is a no-op.
//
// PINNED `bit_rt_root_` (ABI placeholder), NOT `bit_rt_port_`: this is a real
// ABI name `boot` (#1608) calls, waiting on #1369's rename to `bit_rt_
// ignore_sigpipe` — the same convention ./io.bit documents for `bit_rt_root_
// panic` and the rest.
export @nosplit @symbol("bit_rt_ignore_sigpipe") function ignoreSigpipe(): int {
  let base = int(ptrOf(sigActBuf))
  let i = 0
  while (i < sigActionWords) {
    storeWord(base + i * 8, 0)
    i = i + 1
  }
  storeWord(base, sigIgn)
  return int(syscall(sysRtSigaction(), i64(sigPipe), i64(base), i64(0), i64(sigSetSize)))
}
