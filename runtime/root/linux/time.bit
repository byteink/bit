// Linux time provider for the SEAM 3 remainder (#1604): the three `bit_rt_time_*`
// ABI symbols (ABI.md §18). This is the Bit form of `runtime/root/`'s time
// block (`bit_rt_time_mono_ns`/`_unix_ns`/`_sleep_ns`) plus the Linux branch of
// `runtime/sched/`'s `realtimeNs`, fused into one self-contained module member.
//
// THE THREE ARE NOT EQUAL WORK, and each is deliberately a different mechanism:
//
//   - `mono_ns` is a PIN, not a port. The monotonic clock is already read by
//     `runtime/park/linux`'s `parkMonoNs` (clock_gettime CLOCK_MONOTONIC); this
//     wrapper reuses that exact body rather than opening a second copy of the
//     syscall, so the two can never drift. `runtime/sched/`'s `bit_rt_time_mono_ns`
//     likewise just forwards to `sched.monoNs()`.
//   - `unix_ns` is a REAL port: CLOCK_REALTIME does not exist anywhere in the Bit
//     runtime yet (only CLOCK_MONOTONIC), so this opens a new clock_gettime with
//     a new clock id. It is the same shape as `parkMonoNs`, differing only in the
//     clock constant (0 vs 1) — the one line `realtimeNs` and `monoNs` differ by.
//   - `sleep_ns` is MARSHALLING to the scheduler, not a new timer. It parks the
//     green thread on `runtime/sched`'s `schedSleepUntil`, which links the task on
//     the `TimerQueue` and yields the worker (ABI.md §18: "park this green thread
//     for >= ns"). It must NOT touch `parkSleepNs`, which blocks the OS thread.
//
// EVERY SYSCALL NUMBER AND CLOCK CONSTANT BELOW IS THE KERNEL'S, NOT THIS
// PROJECT'S: `clock_gettime` from the per-arch syscall tables, and the
// clockid_t REALTIME/MONOTONIC values from include/uapi/linux/time.h. NOT FROM
// MEMORY. A wrong clock id here is a
// silent wrong-TIME hazard — it compiles and runs, it just reports the wrong
// clock — which is exactly the failure the mutation test forces and observes.
//
// SELF-CONTAINED (the io.bit/fs.bit shape), NOT the netabi extern shape: see
// ../fs.bit's header for why `rejectExternForTarget` breaks the netabi shape on a
// Linux `--emit-obj`. `sysClockGettime` (`runtime/syscalls/syscalls.bit`'s
// per-arch syscall-number function, used below) is imported into this module
// by ./io.bit and reused here, not re-imported (E0042) — an import is per-
// MODULE, not per-file. The two cross-module reaches this file DOES import
// directly — `parkMonoNs` for the clock and `schedSleepUntil`/`schedYield`
// for the park — are ordinary `import`s, exactly as ../fs.bit reaches root/gc.
//
// `timeScratch` below IS `@nosplit` (it only resolves a per-worker scratch
// slot; no syscall, no park). The three exported ABI wrappers are NOT:
// `rtTimeMonoNs`, `rtTimeUnixNs`, `rtTimeSleepNs` all reach bodies that trap
// or context-switch. `@nosplit` no longer categorically rejects `syscall`
// (E0075) — #1640 admitted it to §10.3.1's allowlist on PROOF — and this
// directory already builds `--freestanding --emit-obj` (../linux/io.bit's
// header documents both), so neither of the old blanket claims holds any
// more.

import { parkMonoNs } from "../../park/linux"
import { schedSleepUntil, schedYield } from "../../sched"
// `timeScratch` pulled up to core (#2551,
// docs/development/provider-duplication.md's `root` -> `time.bit` section):
// no OS call in its body. `schedCurrentWorker` was only imported here for
// `timeScratch`'s own use and is no longer needed in this module.
import { timeScratch } from "../../root"

// clock_gettime: x86_64 228, aarch64 113 (the kernel syscall tables, the same
// pair `runtime/park/linux/wait.bit` reads for CLOCK_MONOTONIC). Reached via
// `sysClockGettime()`, `runtime/syscalls/syscalls.bit`'s per-arch selector
// for this syscall — not a local `nr()`, which #1897 (`3d4c652b`) removed.

// CLOCK_REALTIME = 0 (`<linux/time.h>` clockid_t). CLOCK_MONOTONIC = 1 is `parkMonoNs`'s
// clock and is not opened here — the one constant that separates a wall clock
// that can jump from a monotonic one that cannot.
const clockRealtime: int = 0

// Nanoseconds per second — named because the timespec split is easy to get subtly
// wrong spelled as a bare literal (../../park/linux/wait.bit names it for the same
// reason).
const nsPerSec: int = 1000000000


// `bit_rt_time_mono_ns` (ABI.md §18): monotonic nanoseconds; never jumps, measures
// elapsed. A PIN over `parkMonoNs` — the same clock_gettime CLOCK_MONOTONIC read,
// reused rather than duplicated. `runtime/root/`'s body is `sched.monoNs()`, the twin
// of `parkMonoNs`.
export @symbol("bit_rt_time_mono_ns") fn rtTimeMonoNs(): int {
  return parkMonoNs(timeScratch())
}

// `bit_rt_time_unix_ns` (ABI.md §18): wall-clock nanoseconds since the Unix epoch.
// Can jump (NTP, clock set), so it dates events and never measures durations.
// clock_gettime(CLOCK_REALTIME) into a `timespec` {sec, nsec} — two 64-bit words,
// at the same caller-owned scratch `parkMonoNs` uses (#2318; this used to be a
// fresh `[]i64(2)` heap slice on every call, identical to that ticket's defect).
//
// Returns 0 if the kernel refuses, matching `parkMonoNs`'s failure report rather
// than reading back an uninitialised buffer (`realtimeNs` ignores the return code
// like `monoNs`; reporting 0 is the one strictly-safer deviation both share).
export @symbol("bit_rt_time_unix_ns") fn rtTimeUnixNs(): int {
  let ts = timeScratch()
  let rc = int(syscall(sysClockGettime(), i64(clockRealtime), i64(int(ts))))
  if (rc != 0) {
    return 0
  }
  return int(*(ts + 0)) * nsPerSec + int(*(ts + 1))
}

// `bit_rt_time_sleep_ns` (ABI.md §18): park the calling green thread for at least
// `ns`, leaving its worker free to run other tasks. `runtime/root/`'s `bit_rt_time_
// sleep_ns`: a non-positive duration just yields the worker (`schedYield`), and a
// positive one parks on the scheduler's timer queue until the absolute deadline.
//
// `schedSleepUntil` takes an ABSOLUTE deadline on the monotonic clock that a
// worker's idle path drives `schedTimerExpire` with — which is `parkMonoNs`
// (runtime/sched/worker.bit's `nowFn`). So the deadline is `parkMonoNs() + ns`,
// computed here because `schedSleepUntil` has no clock of its own to add to. This
// is the one line `runtime/sched/` folds inside `sleepTask` (`monoNs() + ns`).
//
// NOT `parkSleepNs`: that blocks the OS thread and would freeze the worker's other
// tasks, defeating the whole point of a green-thread sleep (ABI.md §18: "Never
// blocks the OS thread").
export @symbol("bit_rt_time_sleep_ns") fn rtTimeSleepNs(ns: int) {
  if (ns <= 0) {
    schedYield()
    return
  }
  let now = parkMonoNs(timeScratch())
  // The deadline handed to schedSleepUntil is ABSOLUTE (now + ns), so a
  // relative duration close to i64max overflows that addition and wraps
  // negative, waking the green thread almost immediately instead of after
  // ~292 years. Clamp the deadline to i64max rather than let it wrap.
  let deadline = 9223372036854775807
  if (ns <= 9223372036854775807 - now) {
    deadline = now + ns
  }
  schedSleepUntil(deadline)
}
