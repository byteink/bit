// Linux write/exit provider for the Stage-2 port of runtime/root/ (#1367):
// SEAM 3's kernel-facing half — the bytes `panic`, `assert`, `print` and
// `eprint` put on a file descriptor, and the exit that ends the process.
//
// See ../root.bit for why the port is split by directory rather than switching
// on the OS inside one file. The split line #1366 sharpened is "does the kernel
// see this byte": a `write` and an `exit_group` are definitionally kernel-facing
// and cannot be core, while the shape of the panic line ("panic: " + msg + "\n")
// is kernel-independent — and is therefore duplicated across the two providers
// rather than shared, exactly as `mapPages`' error check is in runtime/alloc.
// Three lines of formatting in two files beats a function-pointer indirection
// through the core for something on the panic path.
//
// Raw syscalls (§11.8) rather than libc, for the reason the whole runtime uses
// them: the ELF output is fully static with no libc to call into.
//
// EVERY NUMBER BELOW IS THE KERNEL'S, NOT THIS PROJECT'S, and was read out of
// the kernel syscall tables (x86_64: arch/x86/entry/syscalls/syscall_64.tbl;
// aarch64: the generic table in include/uapi/asm-generic/unistd.h), NOT from
// memory. A wrong number here is a silent wrong-syscall, never a compile error.
//
// ---------------------------------------------------------------------------
// `@nosplit` IN THIS FILE: EVERY FUNCTION CARRIES IT — HOW THAT CAME TO BE
// ---------------------------------------------------------------------------
//
// THE BLOCK THAT USED TO STAND HERE IS OBSOLETE IN BOTH ITS CLAIMS, and both
// were fixed by later work rather than by this file:
//
//   - "`@nosplit` REJECTS `syscall`" — no longer true. #1640 admitted `syscall`
//     to §10.3.1's allowlist on PROOF, on exactly the argument that block made:
//     §11.8 has both backends emit the kernel trap inline (`0F 05` / `svc #0`),
//     the `.syscall` IR op reaches neither `emitCall` nor either backend's
//     safepoint recorder, so it is not a call and cannot reach a safepoint.
//   - "the write path can never be a freestanding member" — it is one. All 63
//     runtime module dirs build `--freestanding --emit-obj` today.
//
// What remained after #1640 was `hostTarget()`, and #1659 closed that for the
// short-named syscall-number selector functions this file used to define
// locally, by reaching the ordinal through ./os.bit's `rtHostTarget` (an
// `asm` immediate) instead of the `hostTarget()` primitive (an `rt_call`).
// #1897 (`3d4c652b`) then moved those selectors out of this file entirely, to
// `runtime/syscalls/syscalls.bit` as one `sys<Name>()` function per syscall
// (`sysWrite`, `sysExitGroup`, `sysRead`, and 23 others — imported below) —
// see that module's own header for the current mechanism, which no longer
// routes through `rtHostTarget` at all.
//
// ALL `@nosplit` TODAY, and have been since #1658 landed (`728bf1cb`):
// `rootWriteAll`, `writeConst`, `panicWrite`, and the four exported ABI
// wrappers that hold a string as a raw address — `rootPanic`, `rootAssert`,
// `rootPrint`, `rootEprint`. #1656 is the defect class this guards against,
// not a still-open gap: a `bit_rt_*` function NOT marked `@nosplit` takes a
// synthesized back-edge safepoint poll, so a collection can run inside the
// runtime while it holds a GC object as a raw `int` no stack map names.
// `rootWriteAll` loops but reaches no such poll — `@nosplit` suppresses poll
// emission outright (§10.3.1), and E0075 makes that transitive over the whole
// callee subtree, which is why every function in this list had to close
// together. `writeConst` could not simply be annotated — it used to allocate
// a per-call `[]int(1)`, which `@nosplit` forbids (E0075) — so it was
// restructured onto module-level scratch instead; see `writeConst` below
// (and #3276) for the current shape and why it stays sound with more than
// one worker running.

import { strPtr, strLen, dynTypeOf } from "../../root"
import { loadWord, gcTiNamePtr, gcTiNameLen } from "../../gc"
import { sysChmodX64, sysClockGettime, sysClone, sysClose, sysExecve, sysExitGroup, sysFchmodatArm64, sysForkX64, sysGetdents64, sysKill, sysLseek, sysMkdirX64, sysMkdiratArm64, sysNanosleep, sysOpenX64, sysOpenatArm64, sysRead, sysReadlinkX64, sysReadlinkatArm64, sysRmdirX64, sysRtSigaction, sysSetpgid, sysUnlinkX64, sysUnlinkatArm64, sysWait4, sysWrite } from "../../syscalls"
// `taskAt`, `wkId` and `schedCurrentWorker` are already imported into this
// module by ./boot.bit and ./time.bit, and `schedMaxWorkers` by ./fs.bit — an
// import is per-MODULE, not per-file, so a second one here is E0042.

// The syscall numbers this file uses (`sysWrite`, `sysExitGroup`, `sysRead`,
// and 23 others, imported above from `../../syscalls`) no longer have a
// local selector to document here. #1897 (`3d4c652b`) moved every
// short-named per-arch selector this file used to define locally into
// `runtime/syscalls/syscalls.bit`, one exported `sys<Name>()` function per
// syscall — and removed every OTHER directory's own local selector the same
// way (net, park, sched, rand, thread, alloc/linux), so there is exactly one
// definition of each number now, not several hand-kept-in-agreement ones.
// None of those old, short local selector names exist anywhere in
// `runtime/**` today.
//
// EACH `sys<Name>()` IS `@nosplit`, uniformly — `runtime/syscalls/syscalls.bit`'s
// own header explains why: these are reached from the collector's allocation
// path and from panic handling, where a safepoint poll would let a
// collection run inside the runtime (#1656). That module imports nothing —
// importing `../../root` back would cycle with ./os.bit's `rtHostTarget`,
// which needs these numbers — so each selector carries its OWN inline `asm`
// immediate via its own `onX64()`, not this file's `rtHostTarget()`. That is
// a different mechanism from the local selector this block used to document
// pre-#1897, for the same reason (§11.6 guarantees `asm` is emitted inline,
// so it is legal inside `@nosplit`).
//
// `@nosplit` MATTERS HERE RATHER THAN BEING TIDINESS: #1656 established that a
// `bit_rt_*` function written in Bit and not marked `@nosplit` carries a
// synthesized back-edge safepoint poll, so a collection can run inside the
// runtime — where GC objects are held only as raw `int` addresses the ABI
// boundary forces (E0079) and no stack map names them. E0075 makes the
// guarantee transitive over the callee subtree, so every link in
// `rtFsReadAll -> sysOpen -> isX64 -> rtHostTarget` (./fs.bit) and
// `rootWriteAll -> sysWrite -> onX64` (this file) has to carry it for the
// wrapper to.

// exit_group(2), NOT exit(2) — and the difference is load-bearing rather than
// stylistic. `exit` (60 / 93) terminates the CALLING THREAD only; `exit_group`
// (231 / 94) terminates every thread in the process. The runtime is
// multi-threaded by the time any of this can be reached (the scheduler has
// started its workers), so `exit` would leave the remaining workers running and
// the process alive after a panic. `runtime/root/`'s `rawExit` calls `exit_group` for
// exactly this reason; both numbers are listed here so the near-miss is visible
// at the point where picking the wrong one would be silent.

// The two descriptors this module writes to. `print` goes to stdout so a
// program's real output can be piped; everything diagnostic goes to stderr so it
// does not mix in (runtime/root/'s `bit_rt_eprint` doc comment).
const stdoutFd: int = 1
const stderrFd: int = 2

// "panic: ", packed little-endian into one 8-byte word:
//
//     'p' 112 | 'a' 97 | 'n' 110 | 'i' 105 | 'c' 99 | ':' 58 | ' ' 32
//
// A Bit slice stores ONE 8-BYTE WORD PER ELEMENT, so `ptrOf([]int)` addresses
// words and a `[]byte` would NOT give the kernel seven packed bytes — it would
// give seven words. Packing the prefix into a single cell and writing its low
// seven bytes is the same technique tests/stress/syscall uses for its own raw
// `write`, and it is why the prefix is seven characters rather than eight: it
// has to fit in one word.
//
// Computed, not hand-derived: 0x203a63696e6170.
const panicPrefixWord: int = 9071397899755888
const panicPrefixLen: int = 7

// '\n', the byte a panic line ends with.
const newlineWord: int = 10
const newlineLen: int = 1

// "out of memory", packed into two immediate words for `bit_rt_oom` below
// (#1662) — the same one-word-at-a-time device `panicPrefixWord` uses, and for
// the same reason: the exhaustion path must not allocate the string it needs in
// order to say that allocation failed. Computed, not hand-derived.
//
//     "out of m" = 0x6d20666f2074756f   (8 bytes)
//     "emory"    = 0x79726f6d65         (5 bytes)
const oomWord0: int = 7863397576860792175
const oomWord1: int = 521610947941

// "type assertion failed: " / " is not " / "nil", packed the same way as
// `oomWord0`/`oomWord1` above — for `bit_rt_iface_assert` below (#1715).
// Each cell holds up to 8 bytes, little-endian. Computed, not hand-derived.
//
//     "type ass" = 0x7373612065707974   (8 bytes)
//     "ertion f" = 0x66206e6f69747265   (8 bytes)
//     "ailed: "  = 0x203a64656c6961     (7 bytes)
//     " is not " = 0x20746f6e20736920   (8 bytes)
//     "nil"      = 0x6c696e             (3 bytes)
const taFailWord0: int = 8319099728452155764
const taFailWord1: int = 7359003215913054821
const taFailWord2: int = 9071402127485281
const taFailLen2: int = 7
const isNotWord: int = 2338616625293650208
const isNotLen: int = 8
const nilWord: int = 7104878
const nilLen: int = 3

// "integer division by zero", packed the same alloc-free way as
// `oomWord0`/`oomWord1` above — for `bit_rt_panic_div_zero` below (ABI.md
// §12.1, #2016). Computed, not hand-derived.
const divZeroWord0: int = 2338042651316874857
const divZeroWord1: int = 7957695010998479204
const divZeroWord2: int = 8030592660760257056

// "call of a nil function", packed the same alloc-free way — for
// `bit_rt_panic_nil_call` below (ABI.md §12.1, #2018). Computed, not
// hand-derived.
const nilCallWord0: int = 2334675641886859619
const nilCallWord1: int = 8459484600059437153
const nilCallWord2: int = 121424789660526
const nilCallLen2: int = 6

// "method call on a nil interface value", packed the same alloc-free way —
// for `bit_rt_panic_nil_iface` below (ABI.md §12.1, #2240). Computed, not
// hand-derived.
const nilIfaceWord0: int = 7142819438666212717
const nilIfaceWord1: int = 6998715244498152545
const nilIfaceWord2: int = 8389758743816531488
const nilIfaceWord3: int = 8511914773240509029
const nilIfaceWord4: int = 1702194273
const nilIfaceLen4: int = 4

// ---------------------------------------------------------------------------
// The write path
// ---------------------------------------------------------------------------

// Write exactly `n` bytes from `addr` to `fd`, or give up. The Bit form of
// `runtime/root/`'s `writeAllFd`.
//
// BEST-EFFORT BY CONTRACT: a short write is
// retried from where it stopped, but an error gives up silently. There is
// nowhere left to report a write failure to — this IS the reporting path — so
// it is swallowed rather than reported.
//
// There are two distinct give-up exits (an error, and `if (n ==
// 0) return` on a zero-byte write); a raw syscall returns a small NEGATIVE errno
// where `writeFd` would have raised, so the single `wrote <= 0` test below is
// exactly those two exits merged, not a weakened check.
//
// NOTE THERE IS NO EINTR RETRY, deliberately: `sched.writeFd` does not retry
// either (it maps every non-SUCCESS errno to `error.WriteFailed`), and this port
// is behavioural equivalence, not improvement.
//
// BOUNDED (Power of 10 rule 2): `off` starts at 0, strictly increases by at
// least 1 per iteration (any `wrote <= 0` returns instead), and the loop exits
// at `off >= n` — so it runs at most `n` times.
//
// The `bit_rt_port_root_io_` pin prefix marks a PORT-INTERNAL helper, as
// distinct from the bare `bit_rt_*` pins below, which are the real ABI names
// (G2/#1583 already dropped the `_root` infix). This one is not an ABI symbol
// and never will be; it is pinned because a sibling module (the stress
// program) calls it and `-O1` splices bodies across the boundary. Same
// convention as
// runtime/sched/linux/poll.bit's `bit_rt_port_sched_poll_*`.
export @nosplit @symbol("bit_rt_port_root_io_write_all")
fn rootWriteAll(fd: int, addr: int, n: int) {
  let off = 0
  while (off < n) {
    let wrote = int(syscall(sysWrite(), i64(fd), i64(addr + off), i64(n - off)))
    if (wrote <= 0) {
      return
    }
    off = off + wrote
  }
}

// The one-word scratch `writeConst` hands the kernel. MODULE-LEVEL AND SCALAR,
// not a per-call `[]int(1)`, and that is what makes `writeConst` `@nosplit`-able
// (#1658): `@nosplit` forbids allocation outright (E0075), so a per-call GC slice
// cannot stay on the panic path. It is also the strictly safer shape for its own
// sake — the panic path must work when allocation is what failed.
//
// A scalar array is never scanned by the collector (ABI.md §5, rule 1). That is
// required here and harmless: this holds a packed byte constant, never an object
// address.
//
// PER-WORKER SLOTS, NOT ONE SHARED WORD (#3276 — this comment used to claim a
// single module-level word was sound "under the ABI's single-worker contract
// (§5)"; #1900 booted more than one worker and that contract no longer holds,
// same class as #3272/#3273). Two panics on two different workers both calling
// `writeConst` at the same real time can interleave on the SAME shared word: A
// stores its byte(s), B's concurrent call overwrites them before A's
// `rootWriteAll` reads the address back for the syscall, and A's stderr line
// is spliced with B's bytes.
//
// WHY PER-WORKER IS SOUND HERE: `writeConst` below resolves its slot's address
// ONCE into a local and uses that SAME address for both the store and the
// read, and the whole span between them takes no park. `rootWriteAll` is
// `@nosplit`, so it emits no back-edge safepoint poll (§10.3.1; ABI.md
// already states this for this exact function: "`rootWriteAll` ... is
// `@nosplit`, so no safepoint is ever reached"), and neither it nor
// `writeConst` calls `schedPark`/`schedSwitch` — checked by reading the
// callee chain, not inferred from `@nosplit` alone. So the slot resolved for
// the write is the slot resolved for the read, whichever worker that is.
//
// The double bound (`schedMaxWorkers` AND `ioConstScratchSlots`) is #3272's
// `udpSenderSlot` shape: `let a: [N]i64` needs `N` to be a literal (E0021), so
// this file's array capacity and the scheduler's advertised worker count are
// two independent numbers with nothing tying them together.
const ioConstScratchSlots: int = 32

@nosplit fn ioConstScratchSlot(): int {
  let w = schedCurrentWorker()
  if (w == 0) {
    return ioConstScratchSlots
  }
  let id = *(taskAt(w) + wkId)
  if (id < 0 || id >= schedMaxWorkers || id >= ioConstScratchSlots) {
    return ioConstScratchSlots
  }
  return id
}

// (ioConstScratchSlots + 1) slots: one per worker plus a fallback slot for a
// caller with no current task/worker — mirrors ./time.bit's `timeScratch`,
// which needs the identical fallback for the identical reason (a driver
// program, or code the ported scheduler is not running, has no task to index
// by).
let ioConstBuf: [33]i64

// Write `nbytes` low bytes of the packed constant `word` to `fd`.
//
// THE COMMENT THIS REPLACES WAS WRONG, AND WRONG IN THE EXACT WAY #1656 COST A
// G3 ATTEMPT. It argued that a raw object address in a stack slot is pinned
// because "the collector scans stacks CONSERVATIVELY (ABI.md §5)", and cited a
// mutation (deleting a `buf[0]` read-back, with 20,000 forced collections) that
// failed to reproduce a fault. ABI.md §5 says the opposite of what it was read to
// say: the RUNNING task's stack is walked PRECISELY, and only every *other*
// registered task's is scanned conservatively. A runtime frame holding a GC
// object as a raw `int` is named by no stack map, so the precise walk does not
// see it — which is the whole of #1656. The mutation did not disprove the hazard;
// it failed to hit it, because this buffer's live range happens to end before the
// poll inside `rootWriteAll` could matter.
//
// The rule that survives is the one about module state, and it now applies to
// this function itself: the buffer below is module state, so the collector never
// scans it, which is exactly why it must never hold an object address.
@nosplit fn writeConst(fd: int, word: int, nbytes: int) {
  let addr = int(ptrOf(ioConstBuf)) + ioConstScratchSlot() * 8
  storeWord(addr, word)
  rootWriteAll(fd, addr, nbytes)
}

// ---------------------------------------------------------------------------
// Whole-line assembly (#3295)
// ---------------------------------------------------------------------------
//
// Every panic function below used to make 3-5 SEPARATE `writeConst`/
// `rootWriteAll` calls (prefix, one-or-more message words, newline) with no
// lock or ordering guarantee spanning them. Each call is content-safe on its
// own (`ioConstBuf` above is per-worker), but with `BIT_WORKERS>1` two tasks
// panicking on two different workers at close to the same real time can
// interleave AT THE CALL BOUNDARY: A's prefix write, B's prefix write, A's
// message write, ... land in the kernel in whatever order the two workers'
// syscalls actually happen to reach it, splicing two complete, correctly-
// formed messages into one unreadable line. Reproduced directly: BIT_WORKERS=
// 4/8, ~400 tasks racing div-zero vs nil-call panics, spliced lines in 33-40%
// of runs (0/155 at exactly BIT_WORKERS=2 in the same repro — the window
// needs at least one OTHER worker already mid-panic-write, which is rarer
// with only one other worker to race against).
//
// A LOCK spanning the write sequence is the obvious fix and the dangerous
// one: a panic path that blocks on a lock already held by the panicking
// worker itself, or by one mid-teardown, turns a diagnosable crash into a
// hang. Assembling the WHOLE line into a per-worker buffer and issuing ONE
// `rootWriteAll` needs no lock at all, and it is the identical shape
// `ioConstBuf`/`ioConstScratchSlot` above already establishes and proves
// sound — module state, one slot per worker, resolved once into a local used
// for both every store and the final read, with no park anywhere in the span
// (that block's comment carries the full argument; it applies unchanged
// here, since nothing below calls `schedPark`/`schedSwitch` either).
//
// `ioLineCap` (128 bytes/slot) covers every FIXED panic message in this file
// today with room to spare (the longest, nil-iface, assembles to 44 bytes)
// plus `../slices.bit`'s three bounds messages (longest 26) and the
// overwhelming majority of real `panic(msg)` literals, once routed through
// `panicWrite` below. A message that does not fit falls back to the original
// multi-syscall shape — this buffer never truncates, it only narrows the
// race window for the case that fits.
const ioLineCap: int = 128
let ioLineBuf: [528]i64 // 33 slots (ioConstScratchSlots + 1) * 16 words (128B)

@nosplit fn ioLineSlotAddr(): int {
  return int(ptrOf(ioLineBuf)) + ioConstScratchSlot() * ioLineCap
}

// Appends the low `n` (<=8) little-endian bytes of `word` to `addr`, one byte
// at a time. NOT `storeWord`: `../../gc`'s `wordAt` computes `addr / 8` to
// index its `*i64` view, so an `addr` that is not 8-byte aligned silently
// indexes the WRONG word rather than faulting — and every offset here after
// the very first is unaligned by construction (`panicPrefixLen` is 7).
// Bounded (Power of 10 rule 2): every caller below passes a literal `n <= 8`.
@nosplit fn ioLineAppendWord(addr: int, word: int, n: int) {
  let i = 0
  while (i < n) {
    storeByte(addr + i, (word >> (i * 8)) & 255)
    i = i + 1
  }
}

// Copies `n` bytes from `src` to `addr`, one at a time — the dynamic-length
// counterpart of `ioLineAppendWord` above, for a message that already lives
// in memory this buffer does not own. `runtime/root/root.bit`'s own
// `copyBytes` does the identical thing but is a different module's private
// (importing it would mean exporting it there, out of #3295's file scope),
// so this is the same six lines rather than a cross-module reach.
@nosplit fn ioLineCopyBytes(addr: int, src: int, n: int) {
  let i = 0
  while (i < n) {
    storeByte(addr + i, loadByte(src + i))
    i = i + 1
  }
}

// Appends `word`'s low `min(remaining, 8)` bytes and returns how many it
// wrote, so a caller can chain several without re-deriving the clamp.
@nosplit fn ioLineAppendClamped(addr: int, word: int, remaining: int): int {
  let n = remaining
  if (n > 8) {
    n = 8
  }
  ioLineAppendWord(addr, word, n)
  return n
}

// Assembles "panic: " + up to 5 constant words (packed little-endian the same
// way `panicPrefixWord`/`oomWord0`/etc. already are; `msgLen` is the exact
// total byte count across w0..w4, and a short last word — e.g. nil-call's
// `nilCallWord2`, 6 of its 8 bytes — is simply never reached, same contract
// `writeConst`'s callers already relied on) + "\n" into this worker's line
// slot, and sends it as ONE `rootWriteAll` call. Replaces what used to be up
// to 7 separate `writeConst` calls (prefix + up to 5 message words +
// newline) in each of the four constant-message panics below.
@nosplit fn writeConstLine(fd: int, w0: int, w1: int, w2: int, w3: int, w4: int, msgLen: int) {
  let addr = ioLineSlotAddr()
  let off = panicPrefixLen
  ioLineAppendWord(addr, panicPrefixWord, panicPrefixLen)
  let remaining = msgLen
  let n = ioLineAppendClamped(addr + off, w0, remaining)
  off = off + n
  remaining = remaining - n
  if (remaining > 0) {
    n = ioLineAppendClamped(addr + off, w1, remaining)
    off = off + n
    remaining = remaining - n
  }
  if (remaining > 0) {
    n = ioLineAppendClamped(addr + off, w2, remaining)
    off = off + n
    remaining = remaining - n
  }
  if (remaining > 0) {
    n = ioLineAppendClamped(addr + off, w3, remaining)
    off = off + n
    remaining = remaining - n
  }
  if (remaining > 0) {
    n = ioLineAppendClamped(addr + off, w4, remaining)
    off = off + n
    remaining = remaining - n
  }
  ioLineAppendWord(addr + off, newlineWord, newlineLen)
  off = off + newlineLen
  rootWriteAll(fd, addr, off)
}

// The bytes of the port-heap `string` at `s` (ABI.md §2: a `{ptr, len}` header
// whose `ptr` addresses the object's own inline bytes).
//
// A NULL HEADER READS AS `""` (#1564/#1570). `runtime/root/` gives `bit_rt_print` and
// `bit_rt_eprint` an OPTIONAL header and funnels both through its `strBytes`,
// because a zeroed struct's `string` field is the null word (SPEC §13.4) and
// `print(z.label)` is ordinary Bit code. This pair is that funnel for this
// module — `../root.bit`'s own `strBytes`/`strSize` are a different module's
// privates and cannot be reached from here, so the guard is duplicated rather
// than shared. Length 0 makes `rootWriteAll` write nothing at all, so the null
// address is never handed to the kernel.
@nosplit fn strBytesOf(s: int): int {
  if (s == 0) {
    return 0
  }
  let p = loadWord(s + strPtr)
  return p
}

@nosplit fn strSizeOf(s: int): int {
  if (s == 0) {
    return 0
  }
  let n = loadWord(s + strLen)
  return n
}

// `panic: <msg>\n` on `fd`. `runtime/root/`'s `panicWrite`.
//
// ONE syscall when `msg` fits in the shared per-worker line slot (`ioLineBuf`
// above, #3295) — ALLOCATES NOTHING to get there, unlike assembling into a
// fresh heap buffer would: the slot is module state, resolved and reused, not
// a per-call allocation, so the panic path still works when allocation is
// what failed. Falls back to the original three-syscall shape when `msg`
// does not fit — never truncates, only narrows the race window for the
// (overwhelmingly common) case that fits.
//
// TAKES THE FD rather than hardcoding stderr. That is the one deliberate
// signature deviation in this file and it exists for testability: `rootPanic`
// cannot be observed from a test because it exits the process, so the FORMAT and
// the EXIT have to be separable to be checked at all. `runtime/root/` makes the same
// concession — its own `panicWrite` test drives `writeAllFd(fds[1], ...)` down a
// pipe rather than calling `panicWrite`. Exposing the fd is the smaller of the
// two, since the one caller below still fixes it to stderr.
export @nosplit @symbol("bit_rt_port_root_io_panic_write")
fn panicWrite(fd: int, s: int) {
  let msgAddr = strBytesOf(s)
  let msgLen = strSizeOf(s)
  if (msgLen <= ioLineCap - panicPrefixLen - newlineLen) {
    let addr = ioLineSlotAddr()
    ioLineAppendWord(addr, panicPrefixWord, panicPrefixLen)
    ioLineCopyBytes(addr + panicPrefixLen, msgAddr, msgLen)
    ioLineAppendWord(addr + panicPrefixLen + msgLen, newlineWord, newlineLen)
    rootWriteAll(fd, addr, panicPrefixLen + msgLen + newlineLen)
    return
  }
  writeConst(fd, panicPrefixWord, panicPrefixLen)
  rootWriteAll(fd, msgAddr, msgLen)
  writeConst(fd, newlineWord, newlineLen)
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §12)
// ---------------------------------------------------------------------------
//
// PINS CARRY THE BARE ABI NAME, for the reason ../root.bit documents at
// length: G2 (#1583) dropped the `_root` infix, so `bit_rt_panic`,
// `bit_rt_print` and the rest below ARE the real names every caller links.

// Terminate the process immediately with `code`. `runtime/root/`'s `rawExit`.
//
// The code is masked to its low 8 bits, which is what `rawExit`'s
// `@bitCast(@as(i8, @truncate(code)))` computes: a truncation to i8 keeps the
// low byte and the bitcast to u8 reinterprets the same bits. Wait(2) only ever
// reports 8 bits to the parent regardless, so this is the kernel's own rounding
// made explicit rather than a choice.
export @nosplit @symbol("bit_rt_os_exit") fn rootExit(code: int) {
  syscall(sysExitGroup(), i64(code & 255))
}

// `bit_rt_panic` (ABI.md §12): prints `panic: <msg>` and exits 2 (SPEC §18.4).
// Backs the `panic` builtin and every implicit panic source — index and slice
// range, divide by zero, nil-channel misuse, a failed `assert`.
//
// No stack trace: codegen makes no frame-pointer-chain
// promise, and there is no debug-info format to symbolize one with yet.
export @nosplit @symbol("bit_rt_panic") fn rootPanic(s: int) {
  panicWrite(stderrFd, s)
  rootExit(2)
}

// `bit_rt_assert` (ABI.md §12): backs `assert(cond)` / `assert(cond, msg)`.
// Fixed 2-arg — lowering always supplies a message, since this symbol has one
// frozen native signature whichever surface form the program used.
export @nosplit @symbol("bit_rt_assert") fn rootAssert(cond: bool, s: int) {
  if (cond) {
    return
  }
  rootPanic(s)
}

// `bit_rt_print` (ABI.md §12): the `print` builtin — a string's bytes on
// stdout, no trailing newline.
export @nosplit @symbol("bit_rt_print") fn rootPrint(s: int) {
  rootWriteAll(stdoutFd, strBytesOf(s), strSizeOf(s))
}

// `bit_rt_eprint` (ABI.md §12): `print`'s sibling on fd 2.
export @nosplit @symbol("bit_rt_eprint") fn rootEprint(s: int) {
  rootWriteAll(stderrFd, strBytesOf(s), strSizeOf(s))
}

// `bit_rt_oom` (#1642/#1662): the heap-exhaustion door `runtime/gc/mem.bit`
// reaches through by `extern function bit_rt_oom()`. NEVER RETURNS — it writes
// `panic: out of memory` to fd 2 and exits 2, which is `runtime/root/`'s
// `fatal("out of memory")` (`panicWrite` then `rawExit(2)`) byte for byte. The
// `int` result exists only because the unmanaged subset has no `noreturn`; no
// caller may use it.
//
// NOT ROUTED THROUGH `rootPanic`, and that is the whole point of writing it out
// longhand. `rootPanic` takes a Bit STRING OBJECT — a managed-heap allocation —
// so reaching it here would mean allocating in order to report that allocation
// failed. `writeConst` needs no heap at all: the message is packed into two
// immediate words, exactly as the `panic: ` prefix and the newline already are.
//
//     "out of m" = 0x6d20666f2074756f, "emory" = 0x79726f6d65
//
// Both computed, not hand-derived. `panicPrefixLen` is 7 and the two message
// words carry 8 and 5 bytes, so 7 + 13 + 1 = the 21 bytes of
// `panic: out of memory\n`.
export @nosplit @symbol("bit_rt_oom") fn rootOom(): int {
  writeConstLine(stderrFd, oomWord0, oomWord1, 0, 0, 0, 13)
  rootExit(2)
  return 0
}

// `bit_rt_panic_div_zero` (ABI.md §12.1, #2016): a check a backend inserts
// directly at the divide that would otherwise fault (a zero divisor), rather
// than through the RtBytes/`panic` builtin convention. Written out longhand
// exactly like `bit_rt_oom` above and for the same reason: allocating a
// message to report a broken invariant is itself something that must not be
// able to fail on this path.
export @nosplit @symbol("bit_rt_panic_div_zero") fn rootPanicDivZero() {
  writeConstLine(stderrFd, divZeroWord0, divZeroWord1, divZeroWord2, 0, 0, 24)
  rootExit(2)
}

// `bit_rt_panic_nil_call` (ABI.md §12.1, #2018): the sibling check for an
// indirect call through a nil function value, same alloc-free shape.
export @nosplit @symbol("bit_rt_panic_nil_call") fn rootPanicNilCall() {
  writeConstLine(stderrFd, nilCallWord0, nilCallWord1, nilCallWord2, 0, 0, 22)
  rootExit(2)
}

// `bit_rt_panic_nil_iface` (ABI.md §12.1, #2240): the sibling check for a
// method call dispatched through a nil interface value, same alloc-free
// shape.
export @nosplit @symbol("bit_rt_panic_nil_iface") fn rootPanicNilIface() {
  writeConstLine(stderrFd, nilIfaceWord0, nilIfaceWord1, nilIfaceWord2, nilIfaceWord3, nilIfaceWord4, 36)
  rootExit(2)
}

// The WRITE half of `bit_rt_iface_assert`, split out fd-first the same
// way `panicWrite` is split from `rootPanic` — the fixed ABI signature has no
// fd to hand a test, so this is what tests/stress/rootiolinux's `ioProps`
// drives instead. Writes nothing and returns `recv` on a match. On a mismatch
// it writes `panic: type assertion failed: <got> is not <want>\n` to `fd` —
// `<got>`/`<want>` straight out of the `TypeInfo` descriptors' own bytes,
// never copied into a heap string, so this stays as alloc-free as `rootOom` —
// and returns 0.
//
// EXPORTED AND PINNED for tests/stress/rootiolinux's `ioProps` (P7, #1715) —
// same cross-module-call-stability reason as `bit_rt_port_root_io_write_all`.
// Port-internal, not ABI.
export @nosplit @symbol("bit_rt_port_root_io_iface_assert_write")
fn ifaceAssertWrite(fd: int, recv: int, want: int): int {
  let info = dynTypeOf(recv)
  if (info != 0 && info == want) {
    return recv
  }
  writeConst(fd, panicPrefixWord, panicPrefixLen)
  writeConst(fd, taFailWord0, 8)
  writeConst(fd, taFailWord1, 8)
  writeConst(fd, taFailWord2, taFailLen2)
  if (info == 0) {
    writeConst(fd, nilWord, nilLen)
  } else {
    rootWriteAll(fd, loadWord(info + gcTiNamePtr), loadWord(info + gcTiNameLen))
  }
  writeConst(fd, isNotWord, isNotLen)
  rootWriteAll(fd, loadWord(want + gcTiNamePtr), loadWord(want + gcTiNameLen))
  writeConst(fd, newlineWord, newlineLen)
  return 0
}

// `bit_rt_iface_assert` (ABI.md §2.2, pinned bare here since G2/#1583): the
// one-result assertion `iface.(T)` (SPEC §14.4),
// panicking on a mismatch (§18.4) (#1715). `../iface.bit`'s `dynTypeOf`
// decides across the module boundary exactly as `bit_rt_oom` reaches
// `runtime/gc`'s allocator from this file; `ifaceAssertWrite` above formats
// and writes, and this fixes the fd to stderr and raises.
export @nosplit @symbol("bit_rt_iface_assert")
fn rootIfaceAssert(recv: int, want: int): int {
  let r = ifaceAssertWrite(stderrFd, recv, want)
  if (r == 0) {
    rootExit(2)
  }
  return r
}
