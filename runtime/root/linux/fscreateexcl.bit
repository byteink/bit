// `bit_rt_fs_create_excl_w` (#5797, epic #5787): pkg/kv's `create` checked
// `exists(path)` then opened without `O_EXCL`, so two concurrent creates on
// one path both succeeded and a planted symlink at the target got followed
// and overwritten instead of refused. Sibling file, not added to ./fs.bit:
// that file sits at 762 of the 800-line spec/LINT.md §4 ceiling (E0200),
// the same reason `bit_rt_fs_open_rw_w` moved to ./fsopenrw.bit (#3533).
//
// `wordsPathZ`, `errnoNoEnt`, `oReadWrite`, `isX64`, `sysOpenX64`,
// `sysOpenatArm64`, `atFdCwd` are NOT imported here: ./fs.bit, a sibling in
// this same module, already declares every one of them; a second import or
// redeclaration would be E0042.

// `O_EXCL` = 0o200 = 128 (`<asm-generic/fcntl.h>`, identical on x86_64 and
// aarch64 — unlike `O_NOFOLLOW` below, this bit is NOT arch-split; see
// ./fs.bit's own O_* header comment for the ones that are). OR'd onto
// `O_CREAT`, it makes the open FAIL instead of succeeding when the final
// path component already exists, of any type — closing the window
// pkg/kv's separate `exists(path)` check-then-open left open.
const oExcl: int = 128 // 0o200

// `EEXIST` = 17 (`<asm-generic/errno-base.h>`), the same POSIX value
// `runtime/sched/linux/poll.bit`'s `eExist()` already relies on for
// `EPOLL_CTL_ADD`'s own EEXIST case.
const errnoEexist: int = 17

// Owner-only 0600 is the caller's default (pkg/kv passes it explicitly);
// this primitive itself takes `mode` as an argument rather than hardcoding
// it, so it is not itself the guarantee — see `std/fs/secure`'s
// `createExclusive` doc comment for why 0600 matters to that caller.

// `bit_rt_fs_create_excl_w` (ABI.md §14, #5797): open the `n` path bytes at
// `words` `O_RDWR|O_CREAT|O_EXCL|O_NOFOLLOW` at permission bits `mode` in
// ONE syscall. `O_EXCL` refuses the open outright if the final component
// already exists (any type, including a symlink — the link itself
// "exists"); `O_NOFOLLOW` closes the same hazard belt-and-suspenders for
// any kernel/filesystem combination where `O_EXCL` alone would still
// traverse an existing link before failing, the identical pairing
// `bit_rt_fs_open_nofollow_w` already uses for its own read-only case.
// Returns the fd on success; `-2` specifically for `EEXIST`, so a caller
// can tell "already there" apart from every other failure; `-1` otherwise
// — the same normalized three-way shape `bit_rt_fs_lock`/`bit_rt_fs_unlock`
// already use in place of a raw errno. Packed-bytes `(words, n)`, same
// convention as `bit_rt_fs_open_rw_w`/`bit_rt_fs_open_nofollow_w`.
export @nosplit @symbol("bit_rt_fs_create_excl_w") fn rtFsCreateExclW(
  words: int,
  n: int,
  mode: i64,
): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  let noFollow = oNoFollowX64
  if (!isX64()) {
    noFollow = oNoFollowArm64
  }
  let flags = oReadWrite | oExcl | noFollow
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysOpenX64(), i64(p), i64(flags), mode))
  } else {
    rc = int(syscall(sysOpenatArm64(), i64(atFdCwd), i64(p), i64(flags), mode))
  }
  if (rc >= 0) {
    return rc
  }
  if (rc == 0 - errnoEexist) {
    return 0 - 2
  }
  return 0 - 1
}
