// The read-write, non-truncating open primitive (#3533), split into its own
// file rather than living beside `sysOpen`/`rtFsOpen`/`rtFsAppend` in
// `./fs.bit` (a sibling in this same directory, so this module already sees
// `wordsPathZ`/`sysOpen` with no import): `fs.bit` sits at exactly the
// 800-line ceiling (spec/LINT.md's E0200) once the `oReadWrite` flag and
// `sysOpen`'s new mode-3 branch land there, leaving no room for another
// exported function in that file. See ../darwin/fs.bit for the identical
// primitive, which had headroom to stay inline.

// `bit_rt_fs_open_rw_w`: open the `n` path bytes at `words` create+
// read-write, WITHOUT truncating any existing content (`sysOpen` mode 3,
// `./fs.bit`). Packed-bytes `(words, n)`, like `rtFsIsSymlinkW`/`rtFsStatW`
// in `./fs.bit` -- NOT a Bit `string` object: `std/fs` reaches a runtime
// symbol only through an `extern function` (SPEC §11.7), which admits no
// `string`, so this cannot be a compiler-recognized `fsOpen`-shaped
// primitive the way `rtFsOpen`/`rtFsAppend` are. Unlike `rtFsOpen`'s
// read-only path, no extra directory guard is needed: `open(2)` on Linux
// already fails a directory with EISDIR whenever O_WRONLY or O_RDWR is
// requested, and `sysOpen` already turns any negative syscall return into
// -1. fd or -1.
export @nosplit @symbol("bit_rt_fs_open_rw_w") fn rtFsOpenReadWriteW(words: int, n: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  return sysOpen(p, 3)
}
