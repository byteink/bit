// Linux process provider for the SEAM 3 remainder (#1605): the kernel-facing
// `bit_rt_os_*` ABI wrappers (ABI.md §19) that need real syscalls —
// `os_self_exe`, `os_run`, `os_run_test` — plus the raw per-arch traps behind
// them. This is the Bit form of `runtime/root/`'s `bit_rt_os_run`/
// `bit_rt_os_run_test`/`bit_rt_os_self_exe` and `runtime/sched/`'s
// `selfExePath`. `os_argc`/`os_arg_at`/`os_env` are platform-free and live in
// ../os.bit; `os_exit` already lives in ./io.bit as `bit_rt_os_exit`.
//
// SELF-CONTAINED (the io.bit/fs.bit shape), NOT parent-wrappers-over-extern
// (the netabi shape): see ../fs.bit's header for why the netabi shape trips the
// x86_64-linux `rejectExternForTarget` gate here. The wrappers call their
// syscalls as LOCAL traps and reach `runtime/root`'s glue by ordinary `import`.
//
// EVERY SYSCALL NUMBER BELOW IS THE KERNEL'S, NOT THIS PROJECT'S, and was read
// out of the kernel syscall tables (x86_64:
// arch/x86/entry/syscalls/syscall_64.tbl; aarch64: the generic table in
// include/uapi/asm-generic/unistd.h) with the `W`/`E`/`SIG` constants from
// include/uapi/linux/wait.h and include/uapi/asm-generic/signal.h. NOT FROM MEMORY. Per-arch, and per-arch SHAPE, not
// just number: x86_64 has `fork` (57) and `readlink` (89); aarch64 has NEITHER
// and uses `clone(SIGCHLD,0)` (220) and `readlinkat(AT_FDCWD,…)` (78) — the
// generic table simply has no `fork`/`readlink` entry, so the at-suffixed call
// is the only spelling, as ../fs.bit also finds for `open`/`mkdir`.
//
// EVERY FUNCTION IN THIS FILE IS `@nosplit` TODAY, wrappers included
// (`rtOsSelfExe`, `rtOsRun`, `rtOsRunTest`, `rtOsRunBounded`,
// `rtOsRunTestBounded`, `rtHostTarget` and every local helper below).
// `@nosplit` no longer categorically rejects `syscall` (E0075) — #1640
// admitted it to §10.3.1's allowlist on proof, the same admission
// ../linux/io.bit's header documents for its own write path — and this
// directory already builds `--freestanding --emit-obj` (io.bit's header
// again), so the old "cannot become freestanding until #1369" framing is
// gone too.

import { storeWord, gcSyscallBegin, gcSyscallEnd } from "../../gc"
import { osEnvp, osBuildRunArgv } from "../../root"

// `nr`, `isX64`, `atFdCwd`, `fsPathZ`, `rtStrAlloc`, `rtStringSlice`, `strData`,
// `emptyStr`, `rootExit`, `loadByte`, `storeByte`, `loadWord` are already
// imported/defined by this module's siblings ./io.bit and ./fs.bit (module-scoped
// in Bit), so they are reused, not re-declared — a redeclaration is E0042.

// `max_path` (runtime/root/): the ceiling on a `/proc/self/exe` result. A readlink
// result that fills the buffer exactly is treated as truncated and rejected,
// never resolved against a prefix that is a lie.
const osMaxPath: int = 4096

// `SIG.CHLD` (= 17 on every non-MIPS, non-SPARC Linux ABI, aarch64 included —
// include/uapi/asm-generic/signal.h). The flag word `clone` gets on aarch64 so the
// child behaves as a plain fork: SIGCHLD to the parent on exit, nothing shared.
const osSigChld: int = 17

// wait(2)'s status decode (include/uapi/linux/wait.h, identical to Darwin's BSD layout):
// WIFEXITED = (status & 0x7f) == 0; WEXITSTATUS = (status >> 8) & 0xff.
const osWStatusMask: int = 127
const osWExitShift: int = 256

// `execve` / `wait4`, same argument shape on both arches so only the number
// differs (`nr` is ./io.bit's per-arch selector). `fork` (x86_64) vs
// `clone` (aarch64) DIFFER IN ARGUMENT COUNT, so they are branched inline below,
// not folded here.

// ---------------------------------------------------------------------------
// os_self_exe
// ---------------------------------------------------------------------------

// "/proc/self/exe" scratch, NUL-terminated. MODULE-LEVEL AND SHARED, but SAFE
// AT ANY WORKER COUNT for the same reason `runtime/rand/linux/entropy.bit`'s
// `randPathBuf` is (#3277): the 15 bytes this buffer ever holds are a
// COMPILE-TIME CONSTANT, "/proc/self/exe\0", written ONLY by the 15 hardcoded
// `storeByte` calls in `osFillProcSelfExe` below and nothing else ever writes
// it. Two callers racing `osFillProcSelfExe` on different workers write those
// identical 15 bytes in either order -- the race is idempotent, there is no
// value one caller could observe that the other did not also just write. NOT
// a single-worker/adjacency argument (that contract no longer holds -- #1900,
// ABI.md §5.1) and NOT a per-worker conversion either: content invariance is
// what makes this one safe. Contrast ../darwin/os.bit's `osRawExe` et al,
// which hold the SAME process-constant path but are filled by opaque
// libSystem calls rather than hardcoded stores, so that side gets the
// per-worker treatment instead. A scalar array is never scanned by the
// collector (rule 1). 16 bytes hold the 14-byte literal plus its NUL.
let osProcSelfExe: [2]i64

// Fill `osProcSelfExe` with "/proc/self/exe\0" and return its address. Written
// byte-literal (not a Bit string literal) to keep this a raw C string the kernel
// reads directly, with no managed-object lifetime crossing the syscall.
@nosplit fn osFillProcSelfExe(): int {
  let b = int(ptrOf(osProcSelfExe))
  storeByte(b + 0, 47)    // '/'
  storeByte(b + 1, 112)   // 'p'
  storeByte(b + 2, 114)   // 'r'
  storeByte(b + 3, 111)   // 'o'
  storeByte(b + 4, 99)    // 'c'
  storeByte(b + 5, 47)    // '/'
  storeByte(b + 6, 115)   // 's'
  storeByte(b + 7, 101)   // 'e'
  storeByte(b + 8, 108)   // 'l'
  storeByte(b + 9, 102)   // 'f'
  storeByte(b + 10, 47)   // '/'
  storeByte(b + 11, 101)  // 'e'
  storeByte(b + 12, 120)  // 'x'
  storeByte(b + 13, 101)  // 'e'
  storeByte(b + 14, 0)    // NUL
  return b
}

// `bit_rt_os_self_exe`: the running executable's own path, symlinks resolved, or
// the empty string when unknown. `/proc/self/exe` is already fully resolved, so
// unlike Darwin no `realpath` pass is needed. `readlink` writes into the result
// string's own byte buffer and the result is trimmed to the byte count — one
// spare allocation, the ../fs.bit `rtFsRead` pattern. A result that fills the
// buffer exactly is rejected (readlink neither NUL-terminates nor reports
// truncation), matching `runtime/sched/`'s `selfExePath`.
export @nosplit @symbol("bit_rt_os_self_exe") fn rtOsSelfExe(): int {
  let pathPtr = osFillProcSelfExe()
  let big = rtStrAlloc(osMaxPath)
  if (big == 0) {
    return emptyStr()
  }
  let buf = strData(big)
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysReadlinkX64(), i64(pathPtr), i64(buf), i64(osMaxPath)))
  } else {
    rc = int(syscall(sysReadlinkatArm64(), i64(atFdCwd), i64(pathPtr), i64(buf), i64(osMaxPath)))
  }
  if (rc < 0 || rc >= osMaxPath) {
    return emptyStr()
  }
  return rtStringSlice(big, 0, rc)
}

// ---------------------------------------------------------------------------
// os_run / os_run_test — fork + execve + wait4
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Per-worker scratch slot (#3277): #1900 booted more than one worker, so every
// buffer below that used to read "sound under the single-worker contract" is a
// real race at BIT_WORKERS>1 -- two workers calling `bit_rt_os_run`/`_test`/
// `_bounded` at the same real time clobber each other's scratch. Shared by
// the run and clock scratch below, the same shape `runtime/net/darwin/sock.bit`'s
// `sockScratchSlot` (#3273) and ./io.bit's `ioConstScratchSlot` (#3276)
// established. Double-bounded (`schedMaxWorkers` AND `osScratchSlots`, since
// `let a: [N]i64` needs a literal `N` -- the two numbers have nothing tying
// them together).
// ---------------------------------------------------------------------------
const osScratchSlots: int = 32

@nosplit fn osScratchSlot(): int {
  let w = schedCurrentWorker()
  if (w == 0) {
    return osScratchSlots
  }
  let id = *(taskAt(w) + wkId)
  if (id < 0 || id >= schedMaxWorkers || id >= osScratchSlots) {
    return osScratchSlots
  }
  return id
}

// child `argv` = [path, NULL] and the wait(2) status cell. PER-WORKER (#3277):
// nothing serialises `bit_rt_os_run`/`_test`/`_bounded` -- two workers can call
// the predeclared `osRun` builtin (or `bit_rt_os_run_bounded`) at the same real
// time, and "a run fully completes before another can begin" was asserted,
// never enforced -- grep found no lock anywhere near these call sites. Each
// caller resolves the slot ONCE (`osScratchSlot`) and reuses it through
// fork/exec/wait: neither `osForkExecWait` nor `osForkExecWaitBounded` calls
// `schedPark`/`schedSwitch` anywhere in their callee chain (`fork`/`clone`/
// `execve`/`wait4` are raw syscall traps; the `gcSyscallBegin`/`gcSyscallEnd`
// bracket around `wait4`/`nanosleep` only publishes this thread's registers
// for a conservative scan -- traced into `worldBeginSyscall`/`worldEndSyscall`,
// neither of which parks either), so the task never migrates workers
// mid-call. Scalars, never scanned (rule 1).
let osArgvBuf: [66]i64      // (osScratchSlots+1) * 2
let osStatusBuf: [33]i64    // (osScratchSlots+1) * 1

// child env for `os_run_test`: "BIT_TEST_INDEX=<idx>" prepended to the inherited
// entries. `max_env` (runtime/root/) = 1024 inherited + the prepended var + the NULL
// terminator = 1026 words. `osIdxBuf` holds the prepended string: 15-byte key +
// up to 20 decimal digits + NUL fits in 64 bytes. PER-WORKER (#3301): the same
// race and the same no-park proof as `osArgvBuf`/`osStatusBuf` above --
// `osFillTestIndex` resolves the slot once for `osIdxBuf`, and `rtOsRunTest`/
// `rtOsRunTestBounded` resolve it again immediately after for `osChildEnvp`;
// both land on the same slot because nothing in between parks (`osEnvp()`,
// runtime/root/os.bit, is a bare field read, and `osWriteDecimal` is a pure
// loop). Scalars, never scanned (rule 1).
const osMaxEnv: int = 1024
let osChildEnvp: [33858]i64  // (osScratchSlots+1) * 1026
let osIdxBuf: [264]i64       // (osScratchSlots+1) * 8

// Write the decimal text of `v` at `dst` and return the byte count. Two passes
// (count, then fill from the end) — `rtStringFromInt`'s technique, no scratch.
// BOUNDED: at most 19 digits for an i64 magnitude.
@nosplit fn osWriteDecimal(dst: int, v: int): int {
  let neg = v < 0
  let mag = v
  if (neg) {
    mag = 0 - v
  }
  let ndigits = 1
  let probe = mag / 10
  while (probe > 0) {
    ndigits = ndigits + 1
    probe = probe / 10
  }
  let total = ndigits
  if (neg) {
    total = total + 1
    storeByte(dst, 45)
  }
  let at = total
  let rest = mag
  let k = 0
  while (k < ndigits) {
    let q = rest / 10
    let r = rest - q * 10
    at = at - 1
    storeByte(dst + at, 48 + r)
    rest = q
    k = k + 1
  }
  return total
}

// Fill the current worker's slot of `osIdxBuf` with "BIT_TEST_INDEX=<idx>\0"
// and return its address.
@nosplit fn osFillTestIndex(idx: int): int {
  let b = int(ptrOf(osIdxBuf)) + osScratchSlot() * 64
  storeByte(b + 0, 66)    // 'B'
  storeByte(b + 1, 73)    // 'I'
  storeByte(b + 2, 84)    // 'T'
  storeByte(b + 3, 95)    // '_'
  storeByte(b + 4, 84)    // 'T'
  storeByte(b + 5, 69)    // 'E'
  storeByte(b + 6, 83)    // 'S'
  storeByte(b + 7, 84)    // 'T'
  storeByte(b + 8, 95)    // '_'
  storeByte(b + 9, 73)    // 'I'
  storeByte(b + 10, 78)   // 'N'
  storeByte(b + 11, 68)   // 'D'
  storeByte(b + 12, 69)   // 'E'
  storeByte(b + 13, 88)   // 'X'
  storeByte(b + 14, 61)   // '='
  let n = osWriteDecimal(b + 15, idx)
  storeByte(b + 15 + n, 0)
  return b
}

// fork + execve the child at `pathPtr` with `argvPtr`/`envpPtr`, wait for it, and
// return its result in `osForkExecWaitBounded`'s encoding minus the `-2` case this
// has no deadline to produce (ABI.md §19): >= 0 exit code, -1 spawn/wait failure,
// <= -100 killed by signal `-(result) - 100`. `runtime/root/`'s
// `bit_rt_os_run` body, shared by both wrappers.
//
// fork + immediate exec is the ONLY work between fork and exec (`fsPathZ`/env
// already ran), so it is safe with scheduler workers live: the child touches only
// async-signal-safe syscalls. On exec failure the child `exit_group`s 127 (the
// shell's "command not found"), never returning into forked runtime state.
//
// BOUNDED (Power of 10 rule 2): the EINTR retry runs at most 256 times.
@nosplit fn osForkExecWait(pathPtr: int, argvPtr: int, envpPtr: int): int {
  let forked = 0
  if (isX64()) {
    forked = int(syscall(sysForkX64()))
  } else {
    forked = int(syscall(sysClone(), i64(osSigChld), i64(0)))
  }
  if (forked < 0) {
    return 0 - 1
  }
  if (forked == 0) {
    syscall(sysExecve(), i64(pathPtr), i64(argvPtr), i64(envpPtr))
    rootExit(127)
  }
  let sb = int(ptrOf(osStatusBuf)) + osScratchSlot() * 8
  storeWord(sb, 0)
  let tries = 0
  let ok = false
  while (tries < 256) {
    // The `syscall` bracket matters MORE here than on the polling path (#1904):
    // this `wait4` blocks for the child's entire lifetime, so without it every
    // collection attempted for however long the child runs is abandoned. Same
    // reasoning as `osPollSleep` — the caller holds live references (the path,
    // argv and envp arrays) across this, so `blocked` would sweep them, while
    // `syscall` publishes the bound and register file for a scan in place.
    // Inside the EINTR retry loop, so a signal-interrupted wait re-enters the
    // state rather than sitting in it across the retry.
    gcSyscallBegin()
    let w = int(syscall(sysWait4(), i64(forked), i64(sb), i64(0), i64(0)))
    gcSyscallEnd()
    if (w >= 0) {
      ok = true
      tries = 256
    } else {
      if ((0 - w) != 4) {
        return 0 - 1
      }
      tries = tries + 1
    }
  }
  if (!ok) {
    return 0 - 1
  }
  let status = loadWord(sb)
  let sig = status & osWStatusMask
  if (sig == 0) {
    return (status / osWExitShift) & 255
  }
  // 0x7f is "stopped", not "terminated" — no death signal to report, so it keeps
  // the -1 sentinel. Same split as `osForkExecWaitBounded` below.
  if (sig == osWStatusMask) {
    return 0 - 1
  }
  return 0 - 100 - sig
}

// `bit_rt_os_run`: run the executable at `path` as a child inheriting this
// process's environment, with `argv` (a `[]string`, or a null header for the
// empty/default slice) appended to its own argv after `path` — `bit run <src>
// [args...]`'s launcher (#2399). Return its exit code, -1 on failure or a
// rejected `argv` (`osBuildRunArgv`'s bounds, documented on
// `runtime/root/os.bit`'s `osRunMaxArgv`), or -(sig) - 100.
//
// SIGNATURE CHANGED IN PLACE, not a new symbol beside it — every caller is
// updated in the same commit: `compiler/build.bit`'s `runCmd`,
// `compiler/pmfetchtail.bit`'s `runGit` (both part of `compiler/`'s own
// self-hosting source), and the three fixtures that call the predeclared
// `osRun(path, argv)` builtin directly (`tests/cases/fs_walk_symlink.bit`,
// `tests/imports/pmadd_e2e/main.bit`, `examples/staticserver/staticserver.bit`).
// A NEW symbol was tried first and reverted: `compiler/build.bit` is compiled
// by the PINNED stage0 (a published release, `dist/stage0/SHA256SUMS`) during
// `./make selfhost`, and stage0 has no idea a new predeclared name exists —
// every self-hosting build would fail `E0040: undefined name` on the new call
// site until the NEXT stage0 repin, which needs a published release first
// (circular). Reusing the ALREADY-recognized `osRun` identifier sidesteps
// that entirely: this compiler validates no builtin call's arity
// (`compiler/validatecall.bit`'s `vCall`), so stage0 accepts a 2-argument
// call to the same name it has always known, with no changes to its own
// predeclared-name table required.
export @nosplit @symbol("bit_rt_os_run") fn rtOsRun(path: int, argv: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = osBuildRunArgv(p, argv)
  if (ab == 0) {
    return 0 - 1
  }
  return osForkExecWait(p, ab, osEnvp())
}

// `bit_rt_os_run_test(path, idx)`: like `os_run`, but execs the child with
// `BIT_TEST_INDEX=<idx>` PREPENDED to the inherited environment so its synthetic
// `main` dispatches to test `idx`. Prepending makes it win over any inherited
// var (getenv returns the first match). BOUNDED copy (rule 3): a process with
// more than `max_env` vars loses the overflow, never corrupts.
export @nosplit @symbol("bit_rt_os_run_test") fn rtOsRunTest(path: int, idx: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = int(ptrOf(osArgvBuf)) + osScratchSlot() * 16
  storeWord(ab, p)
  storeWord(ab + 8, 0)

  let idxStr = osFillTestIndex(idx)
  let ce = int(ptrOf(osChildEnvp)) + osScratchSlot() * 8208
  storeWord(ce, idxStr)

  // Copy the inherited entries into ce[1..copied], leaving ce[0] the prepended
  // var. `copied` survives the loop so the NULL terminator lands after the last
  // entry placed. BOUNDED by `osMaxEnv`.
  let src = osEnvp()
  let copied = 0
  while (copied < osMaxEnv) {
    let e = loadWord(src + copied * 8)
    if (e == 0) {
      break
    }
    storeWord(ce + (copied + 1) * 8, e)
    copied = copied + 1
  }
  storeWord(ce + (copied + 1) * 8, 0)
  return osForkExecWait(p, ab, ce)
}

// ---------------------------------------------------------------------------
// os_run_bounded / os_run_test_bounded — fork + execve + a DEADLINE, not a
// blocking wait4 (#1744)
// ---------------------------------------------------------------------------
//
// `osForkExecWait`'s `wait4` blocks the calling green thread (and hence the
// calling `bit`/`bit test` process) forever if the child never exits — exactly
// the hazard every harness's wall-clock deadline exists to close (#1637/#1652,
// #1591): a hang must read as a failure, never as a run that sits looking busy.
// `os_run`/`os_run_test` stay exactly as they are — real user programs
// depend on their unbounded semantics — so this is a NEW pair, not a change to
// the existing two.
//
// Same fork+exec as `osForkExecWait`, but the parent polls `wait4(WNOHANG)` on
// a short interval instead of blocking, checking a monotonic deadline resolved
// from `timeoutMs` ONCE before the first poll — one absolute instant, so a
// CPU-bound child cannot restart the clock — one absolute instant, never a
// per-iteration duration that each slow poll silently extends. If it elapses
// first, the parent SIGKILLs the child and reaps it before returning, so a
// timed-out call never leaves a zombie or a stray process.
//
// Must stay `@nosplit` like every other top-level declaration in this file
// (tests/bit/pollfree.bit): the raw child pid and the timespec scratch
// below must never cross a safepoint. That is also why the poll delay is a
// raw `nanosleep` syscall rather than `rtTimeSleepNs` (../linux/time.bit) —
// that call parks the green thread on the scheduler, which is NOT `@nosplit`.

// timespec scratch for `osMonoNs`/`osPollSleep` -- PER-WORKER (#3277), the
// same shape and the same no-park proof as `osStatusBuf` above (`osMonoNs` is
// a plain `clock_gettime` syscall; `osPollSleep`'s `nanosleep` is bracketed by
// `gcSyscallBegin`/`gcSyscallEnd`, which does not park). Scalars, never
// scanned (rule 1).
let osClockBuf: [66]i64      // (osScratchSlots+1) * 2
let osSleepReqBuf: [66]i64   // (osScratchSlots+1) * 2

// CLOCK_MONOTONIC = 1 (include/uapi/linux/time.h; `runtime/park/linux`'s clock, the
// one `rtTimeMonoNs`/`parkMonoNs` read). Opened directly here rather than
// through either of those: neither is `@nosplit` (both reach the scheduler's
// module), and this function must stay `@nosplit`. `nrClockGettime`
// (../linux/time.bit, same module) already IS `@nosplit`, so only the clock id
// and the read are duplicated, not the syscall-number lookup.
const osClockMonotonic: int = 1
const osNsPerSec: int = 1000000000

@nosplit fn osMonoNs(): int {
  let ts = int(ptrOf(osClockBuf)) + osScratchSlot() * 16
  let rc = int(syscall(sysClockGettime(), i64(osClockMonotonic), i64(ts)))
  if (rc != 0) {
    return 0
  }
  return loadWord(ts) * osNsPerSec + loadWord(ts + 8)
}

// nanosleep(2): x86_64 nr 35, aarch64 nr 101 (the per-arch syscall tables, read
// the same way every other number in this file was).

// Poll interval: 2ms. Short enough that a caller's bound is honored within a
// couple percent; long enough not to spin a core between polls.
const osPollNs: int = 2000000

// Bracketed with `bit_rt_gc_syscall_begin`/`_end` (#1904), NOT with
// `blocking_begin`/`_end` — see ../darwin/os.bit's counterpart for the full
// argument. Short version: `blocked` claims no frame holds a live Bit reference,
// and the caller `osRunBounded` holds several across this (argv, the paths, the
// captured output buffer); bracketing it as `blocked` was tried and swept them.
// `syscall` publishes this thread's stack pointer and callee-saved registers so
// the collector scans the wait in place instead of waiting for a safepoint that
// `@nosplit` code cannot reach.
//
// The bracket is around the SLEEP alone, so the shared `osStatusBuf` write in
// the non-blocking `waitpid(WNOHANG)` stays on the `running` side of the state.
@nosplit fn osPollSleep() {
  let req = int(ptrOf(osSleepReqBuf)) + osScratchSlot() * 16
  storeWord(req, 0)
  storeWord(req + 8, osPollNs)
  gcSyscallBegin()
  syscall(sysNanosleep(), i64(req), i64(0))
  gcSyscallEnd()
}

// kill(2): x86_64 nr 62, aarch64 nr 129 (the per-arch syscall tables).
const osSigKill: int = 9

// Signals the whole PROCESS GROUP `pid` leads, not just `pid` itself (#2986).
// `osForkExecWaitBounded` puts the bounded child in its own group (`setpgid`,
// both sides, right after fork) with pgid == its own pid, so this is exactly
// that group. A negative first argument to `kill(2)` is POSIX for "every
// process whose pgid is -that value" — the shell-script children `bit
// test`/`bit run` fork under a wrapper script (e.g. runcmd.bit's `shell()`)
// inherit that same group unless they detach themselves, so a grandchild that
// outlives the direct child's own death is reached by this call, closing the
// orphan #2986 observed: `osKill`'s old single-pid form killed the direct
// child (a wrapper `/bin/sh`) while the actual hung compile it had spawned
// kept running, reparented to pid 1.
@nosplit fn osKillGroup(pid: int) {
  syscall(sysKill(), i64(0 - pid), i64(osSigKill))
}

// #3507: the bounded child currently outstanding, one slot per worker
// (`osScratchSlots+1`, the same sizing every other per-worker scratch buffer
// above uses), 0 = none outstanding. Written ONLY by the thread inside
// `osForkExecWaitBounded`'s own call below — the same single-writer-per-slot
// argument `osStatusBuf` above already makes, since a worker never migrates
// mid-call. The one OTHER reader is `osKillAllOutstandingChildren` below,
// called from ../signal.bit's SIGTERM/SIGINT handler, which the kernel may
// deliver to ANY thread in this process, not necessarily the one that owns
// the slot — so it reads every slot, not just its own. A signal landing in
// the few instructions between the fork syscall returning and the
// `storeWord` below simply means that one child is not yet reachable by this
// sweep; nothing downstream depends on the race being closed, because the
// handler's own `rootExit` ends the process either way.
let osOutstandingChildPid: [33]i64  // (osScratchSlots+1) * 1

// Kill every bounded child still outstanding, across every worker slot
// (#3507). `@nosplit`: called from a signal handler, so it must not allocate
// or touch anything the interrupted code's own invariants might be mid-way
// through.
@nosplit fn osKillAllOutstandingChildren() {
  let base = int(ptrOf(osOutstandingChildPid))
  let i = 0
  while (i <= osScratchSlots) {
    let pid = loadWord(base + i * 8)
    if (pid != 0) {
      osKillGroup(pid)
    }
    i = i + 1
  }
}

// Publish `pid` as this worker's outstanding bounded child (#3507) and
// return the slot address, so `osForkExecWaitBounded` below can clear it
// later with a single `storeWord` rather than recomputing the slot. Split
// out purely to keep that function's own body under the house line limit
// (E0201) — see `osOutstandingChildPid`'s comment for the safety argument.
@nosplit fn osMarkChildOutstanding(pid: int): int {
  let addr = int(ptrOf(osOutstandingChildPid)) + osScratchSlot() * 8
  storeWord(addr, pid)
  return addr
}

// Ceiling on `timeoutMs`: one hour. This is the `os_run_bounded_max_ms` clamp
// ABI.md §19 specifies, and every harness clamps to match — a caller typo must
// not reinstate an unbounded wait.
const osBoundedMaxMs: int = 3600000

// Worst-case poll count: the clamp ceiling divided by the poll interval, plus
// slack. A hard ceiling on the loop below (Power of 10 rule 2, no
// `while (true)`); the monotonic-deadline check inside the loop is what
// actually ends every real call, this only bounds it if the clock is wrong.
const osBoundedMaxPolls: int = (osBoundedMaxMs * 1000000) / osPollNs + 16

// WNOHANG (include/uapi/linux/wait.h): return immediately instead of blocking
// when the child has not yet changed state.
const osWnohang: int = 1

// fork + execve, then poll instead of block (`osForkExecWait`'s body). Result
// encoding (ABI.md §19, matching `runtime/root/`'s `osRunBoundedImpl`):
//   >= 0     child exited normally with this code (0-255)
//   -1       spawn/wait failure — same sentinel as `osForkExecWait`
//   -2       timed out: the deadline elapsed, so the child was SIGKILLed
//   <= -100  child was killed by a signal seen during a poll;
//            signal number = -(result) - 100
// The forked CHILD's own branch: own process group, pgid == this process's
// pid, BEFORE exec (#2986) — membership survives execve, so a wrapper shell
// (e.g. runcmd.bit's `shell()`) and everything IT forks inherits this group
// too, unless one of them detaches on its own. That is what makes
// `osKillGroup` reach a grandchild, not just this direct child. `setpgid` is
// on POSIX's async-signal-safe list, so it is sound between fork and exec.
// Never returns — either `execve` replaces this process's image, or it
// fails and `rootExit(127)` reports it the same way a shell reports a bad
// exec. Split out purely to keep `osForkExecWaitBounded`'s own body under
// the house line limit (E0201).
@nosplit fn osExecChild(pathPtr: int, argvPtr: int, envpPtr: int) {
  syscall(sysSetpgid(), i64(0), i64(0))
  syscall(sysExecve(), i64(pathPtr), i64(argvPtr), i64(envpPtr))
  rootExit(127)
}

@nosplit fn osForkExecWaitBounded(pathPtr: int, argvPtr: int, envpPtr: int, timeoutMs: int): int {
  let clamped = timeoutMs
  if (clamped < 0) {
    clamped = 0
  }
  if (clamped > osBoundedMaxMs) {
    clamped = osBoundedMaxMs
  }
  let deadline = osMonoNs() + clamped * 1000000

  let forked = 0
  if (isX64()) {
    forked = int(syscall(sysForkX64()))
  } else {
    forked = int(syscall(sysClone(), i64(osSigChld), i64(0)))
  }
  if (forked < 0) {
    return 0 - 1
  }
  if (forked == 0) {
    osExecChild(pathPtr, argvPtr, envpPtr)
  }
  // Mirrors the child's own call above so the group exists no matter which
  // side runs first (the standard fork/setpgid race fix): once the child has
  // exec'd, a parent-side `setpgid` on it fails (EACCES) but is by then a
  // no-op — the child's own call already set it.
  syscall(sysSetpgid(), i64(forked), i64(forked))

  // #3507, cleared before every return below — see `osMarkChildOutstanding`.
  let outstanding = osMarkChildOutstanding(forked)
  let sb = int(ptrOf(osStatusBuf)) + osScratchSlot() * 8
  let polls = 0
  let result = 0 - 1
  let done = false
  while (!done && polls <= osBoundedMaxPolls) {
    storeWord(sb, 0)
    let w = int(syscall(sysWait4(), i64(forked), i64(sb), i64(osWnohang), i64(0)))
    if (w == forked) {
      let status = loadWord(sb)
      let sig = status & osWStatusMask
      if (sig == 0) {
        result = (status / osWExitShift) & 255
      } else {
        if (sig == 127) {
          result = 0 - 1
        } else {
          result = 0 - 100 - sig
        }
      }
      done = true
    } else {
      if (w < 0 && (0 - w) != 4) {
        result = 0 - 1
        done = true
      } else {
        if (w == 0 && osMonoNs() >= deadline) {
          osKillGroup(forked)
          storeWord(sb, 0)
          syscall(sysWait4(), i64(forked), i64(sb), i64(0), i64(0))
          result = 0 - 2
          done = true
        } else {
          if (w == 0) {
            osPollSleep()
          }
        }
      }
    }
    polls = polls + 1
  }
  if (!done) {
    osKillGroup(forked)
    storeWord(sb, 0)
    syscall(sysWait4(), i64(forked), i64(sb), i64(0), i64(0))
    result = 0 - 2
  }
  storeWord(outstanding, 0)
  return result
}

// `bit_rt_os_run_bounded(path, timeoutMs)`: like `os_run`, but killed and
// reported rather than blocked forever once `timeoutMs` elapses.
export @nosplit @symbol("bit_rt_os_run_bounded") fn rtOsRunBounded(path: int, timeoutMs: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = int(ptrOf(osArgvBuf)) + osScratchSlot() * 16
  storeWord(ab, p)
  storeWord(ab + 8, 0)
  return osForkExecWaitBounded(p, ab, osEnvp(), timeoutMs)
}

// `bit_rt_os_run_test_bounded(path, idx, timeoutMs)`: like `os_run_test`, with
// the same bounded wait as `bit_rt_os_run_bounded`.
export @nosplit @symbol("bit_rt_os_run_test_bounded") fn rtOsRunTestBounded(path: int, idx: int, timeoutMs: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = int(ptrOf(osArgvBuf)) + osScratchSlot() * 16
  storeWord(ab, p)
  storeWord(ab + 8, 0)

  let idxStr = osFillTestIndex(idx)
  let ce = int(ptrOf(osChildEnvp)) + osScratchSlot() * 8208
  storeWord(ce, idxStr)

  let src = osEnvp()
  let copied = 0
  while (copied < osMaxEnv) {
    let e = loadWord(src + copied * 8)
    if (e == 0) {
      break
    }
    storeWord(ce + (copied + 1) * 8, e)
    copied = copied + 1
  }
  storeWord(ce + (copied + 1) * 8, 0)
  return osForkExecWaitBounded(p, ab, ce, timeoutMs)
}

// ---------------------------------------------------------------------------
// host_target (ABI.md §19) — the LAST symbol only `runtime/root/` defined
// ---------------------------------------------------------------------------

// `bit_rt_host_target`: the `BuildTarget` ordinal this archive was compiled for
// — 0 `x86_64-linux`, 1 `aarch64-linux`, 2 `aarch64-macos`, the enum in
// compiler/build.bit. It is the default `bit build`/`bit run` target when
// `--target` is absent, so an off-by-one here silently mis-targets the compiler.
//
// THE TWO REASONS THIS LOOKED UNPORTABLE, AND WHY NEITHER HOLDS.
//
//   1. "Bit has no compile-time `builtin`." It does not need one. The answer is
//      a property of the EMIT, and the emit already carries both axes it needs:
//      the OS comes from WHICH PROVIDER DIRECTORY this file is in, and the arch
//      comes from the `asm` block's per-arch sub-blocks (§11.6), which the
//      backend selects at codegen. `runtime/root/linux` cannot be built for
//      Darwin at all (a Darwin `--emit-obj` refuses `syscall`, E0075/E0078, even
//      on an uncalled declaration) and `../darwin/os.bit` cannot be built for
//      Linux (`extern function`), so the OS half is a COMPILE ERROR when
//      mis-selected, never a wrong answer. x86_64 exists only on Linux among the
//      three recognised targets and Darwin is aarch64-only, so (provider, arch)
//      names all three exactly.
//
//   2. "A Bit body would be self-recursive after G2." That is true only of the
//      obvious body. `hostTarget()` is a seed `prim_rt_fns` entry, so
//      `return hostTarget()` lowers to `call bit_rt_host_target` — this very
//      symbol once #1583 drops the `_root` infix, i.e. unbounded recursion that
//      builds, links and passes every differential (../floats.bit's SEAM 6 trap;
//      `./make test-rootpins` is the gate). An `asm` immediate is inline BY
//      CONSTRUCTION: no `rt_call`, no callee, nothing for the rename to redirect.
//      This is `runtime/sched/sched.bit`'s `entryBias` shape exactly, for exactly
//      the same reason — a one-instruction immediate is the arch discriminator
//      that needs no runtime call.
//
// Note the direction of the dependency inside this module: ./fs.bit's `isX64()`
// and ./io.bit's `nr()` call THIS function BY NAME — one asm immediate deep,
// and never the reverse. They used to ask `hostTarget()` and reach the same
// place by relocation once #1583 renames the pin; naming it directly is the
// same code with the cycle risk removed, and it is what makes them `@nosplit`-
// able (#1659).
//
// `@nosplit` (#1659), and on PROOF rather than assertion. §10.3.1 admits a form
// when it "lowers to inline machine instructions rather than a call and so can
// neither allocate nor reach a safepoint"; §11.6 guarantees an `asm` block's
// payload is emitted inline verbatim, and the payload here is one immediate
// move. So this body contains no call, no allocation and no safepoint site, and
// a poll-free caller can obtain the ordinal without one.
//
// `hostTarget()` itself is NOT admissible inside `@nosplit` and was deliberately
// left rejected: it is an `ir.RtFn` (`compiler/lower.bit`'s `prim_rt_fns`) and
// codegen emits it through `rtSymbol` as a real `call bit_rt_host_target`. Every
// form already on §10.3.1's allowlist is there because it is NOT a call
// (`syscall`, the atomics, `ptrOf`, `entryOf`, `fsqrt`); the sole
// assertion-based entry, `extern function` (§11.7), rests on that keyword being
// itself an unmanaged-subset marker. A predeclared builtin usable from any
// managed Bit code carries no such marker, so admitting it would widen the
// guard on nothing but convenience. tests/cases/check_nosplit_host_target.bit
// pins the refusal.
export @nosplit @symbol("bit_rt_host_target") fn rtHostTarget(): int {
  return asm {
    arm64 { 0xD2800020 }                    // movz x0, #1   -> aarch64-linux
    x64   { 0xB8, 0x00, 0x00, 0x00, 0x00 }  // mov  eax, 0   -> x86_64-linux
    result arm64 x0 x64 rax : int
  }
}
