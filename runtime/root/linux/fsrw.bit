// The byte-oriented half of the Linux filesystem provider (SEAM 3, #1606):
// `bit_rt_fs_read`, `bit_rt_fs_read_all` and `bit_rt_fs_write` — the three
// `bit_rt_fs_*` ABI wrappers (ABI.md §14) that operate on an already-open fd
// rather than a path. Split out of ./fs.bit by #3274, which pushed that file
// to 824 lines (spec/LINT.md §4's 800-line limit, E0200): a PURE MOVE, no
// logic changed, verified with `comm -23` against the concatenation of both
// halves before landing. Sibling of ./fs.bit in the same directory, so this
// is the SAME MODULE (an import is per-module, not per-file) — at the time
// of the split, nothing here needed a new import; every name (`strData`,
// `emptyStr`, `rtStrAlloc`, `rtStringSlice`, `gcSyscallBegin`/`gcSyscallEnd`,
// `sysRead`/`sysWrite`/`sysLseek`, `rtFsReadAllFailedSet`) was already in
// scope via ./fs.bit's and ./io.bit's own imports. `rtFsReadAllFailedSet`/
// `strLenOf`/`fsLinkMaxPath` now need their own import below (#2551):
// ./fs.bit stopped importing them once `checkedPathZ`/`checkedPathZ2`,
// ./fs.bit's own callers, moved to core — this file is their only remaining
// caller in the module.
import { rtFsReadAllFailedSet, strLenOf, fsLinkMaxPath } from "../../root"
//
// WHY THIS SPLIT AND NOT ANOTHER: path-taking operations (open, exists,
// isDir, mkdir, remove, rename, listDir, the symlink probe) stay in ./fs.bit;
// the three functions that instead take an already-open `fd` and move bytes
// move here. A real, nameable seam — not an arbitrary line cut — matching
// this project's rule that a split needs a real criterion, not just size.
//
// `bit_rt_fs_cwd` (#3501) is the one exception to that fd-vs-path split: it
// takes NO argument at all. It lands here rather than in ./fs.bit purely for
// line budget (./fs.bit was at 794/800 with no room), matching
// ../darwin/fsrw.bit's identical placement rationale for its own copy.
// `sysGetcwd` (`runtime/syscalls/syscalls.bit`) and `loadByte`
// (`../../gc`, already imported by ./fs.bit) are both already in scope.
//
// `sysPread64`/`sysPwrite64` (#3463) ARE imported here, on their own line
// below -- unlike every other syscall number this file uses, these two are
// new names not already pulled in by ./io.bit's shared `"../../syscalls"`
// import, and ./io.bit is owned by a sibling ticket in this batch. A second
// `import` line from the same source module is fine (only importing the
// SAME name twice within one module is E0042); this line adds names, it
// does not duplicate any.
import { sysPread64, sysPwrite64 } from "../../syscalls"

// Linux errno for an interrupted syscall (`<asm-generic/errno-base.h>`,
// identical on x86_64 and aarch64, and identical to Darwin's `EINTR` too —
// see ../../net/darwin/sock.bit's note that EINTR is the one errno that does
// NOT differ between the two). A raw `syscall` failure IS `-errno` directly
// (../fs.bit's header), so no accessor is needed the way Darwin's `__error()`
// is: the value is already sitting in the return register.
const errnoIntr: int = 0 - 4

// A large but PROVABLY BOUNDED retry budget (Power of 10 rule 2) for a `read`
// interrupted by a signal (`EINTR`): POSIX says retry, and under concurrent
// process/signal load (#2980) more than a handful of interruptions across one
// file's read is plausible, so this is generous rather than tight.
const maxReadAllRetries: int = 1000

// `bit_rt_fs_read`: up to `max` bytes from `fd` into a fresh string, shorter than
// `max` at EOF (empty exactly at EOF). Allocates `max`, reads, trims to what
// arrived — `runtime/root/`'s `stringFromBytes(tmp[0..n])`, one allocation.
export @nosplit @symbol("bit_rt_fs_read") fn rtFsRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let big = rtStrAlloc(max)
  if (big == 0) {
    return emptyStr()
  }
  // THE `syscall` BRACKET IS LOAD-BEARING (#2207), for the same reason
  // ../os.bit's `wait4` has one. `fd` may be a pipe, a tty or a socket, so this
  // `read` blocks until somebody writes — indefinitely, for a server or an LSP
  // sitting on stdin. Unbracketed, the reading thread never reaches a safepoint,
  // so a thread that requests a stop-the-world spins in its wait loop for the
  // whole duration: measured at ~77% of a core, continuously, in
  // `bit lsp --stdio`.
  //
  // `syscall` and NOT `blocked`: `big` is a live reference held across this
  // call, and `blocked` would let it be swept. `syscall` publishes the stack
  // bound and register file so it is scanned in place.
  gcSyscallBegin()
  let n = int(syscall(sysRead(), i64(fd), i64(strData(big)), i64(max)))
  gcSyscallEnd()
  if (n <= 0) {
    return emptyStr()
  }
  // `big` is `max`-byte throwaway scratch: nothing else ever references it
  // again after this call returns. Since #3897 `rtStringSlice` allocates a
  // header-only VIEW, so slicing it here would retain the whole `max` bytes
  // for as long as the returned string lives, not just `n` (#3902) — the
  // exact opposite of what a scratch buffer is for. Copy the `n` bytes
  // actually read into an exactly-sized string instead, so `big` becomes
  // garbage immediately; this is the pre-#3897 behaviour for this one call
  // site, restored deliberately. It does not reintroduce #3897's cost
  // anywhere else: ordinary `s[lo:hi]` on a live string still shares.
  let out = rtStrAlloc(n)
  if (out == 0) {
    return rtStringSlice(big, 0, n)
  }
  let dst = strData(out)
  let src = strData(big)
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  return out
}

// `bit_rt_fs_read_all`: the whole file as a fresh string. Sized from the file
// offset (`lseek` to end, then rewind). `bit_rt_fs_read_all` itself stays a
// single non-fallible, `string`-returning primitive (ABI.md §14) -- a seek
// error and an allocation failure are now reported through the out-of-band
// companion symbol `bit_rt_fs_read_all_failed()` instead (wired here, #2996
// pass 2), which is what lets a caller tell them apart from a genuine empty
// file, which never reports a failure (see the `end < 0` / `end == 0` /
// `s == 0` branches' comments below). The read loop's own I/O-error paths
// further down are NOT wired to the flag -- out of this ticket's scope; a
// short read they produce still trims to the bytes actually verified read
// (#2990) and is silent about why it stopped short, same as before.
//
// A short read NEVER fabricates content (#2990). `read` returning `n <= 0`
// before `off` reaches `end` is one of three things: (a) `EINTR` — a signal
// landed mid-call, not a failure, retried below; (b) `n == 0` — the file
// shrank between the `lseek` probe and this read (a TOCTOU race, not this
// runtime's error to report); (c) any other negative result — a genuine I/O
// error. (b) and (c) both stop the read and return the string TRIMMED to the
// `off` bytes actually verified read. The old code returned the full-length
// string with its un-filled tail left as the zero bytes `rtStrAlloc` clears
// memory to — indistinguishable from a file that genuinely contains NULs,
// which made this silent corruption rather than an honest short read. Matches
// ../darwin/fs.bit's `rtFsReadAll`, per that file's per-arch-shape rule.
//
// BOUNDED (Power of 10 rule 2): every iteration that continues the loop
// advances `off` by at least 1 (a successful partial read) OR advances
// `retries` by 1 (an `EINTR` retry) — both counters are capped by the loop
// condition itself, so the loop runs at most `end + maxReadAllRetries` times.
export @nosplit @symbol("bit_rt_fs_read_all") fn rtFsReadAll(fd: int): int {
  // Cleared at entry so a PRIOR call's outcome (on this task) never leaks
  // into this one -- `bit_rt_fs_read_all_failed` must reflect only the read
  // this call just performed.
  rtFsReadAllFailedSet(false)
  let end = int(syscall(sysLseek(), i64(fd), i64(0), i64(2)))
  if (end < 0) {
    // `lseek` FAILED (fd is a pipe, a closed descriptor, etc.) -- a genuine
    // I/O error, unambiguous: lseek's own failure return is negative and a
    // file's size never is (#2996). Distinguishable from the `end == 0`
    // branch below via the out-of-band flag, because `bit_rt_fs_read_all`
    // returns `string`, and `string` has no nil sentinel to carry the
    // difference in-band (SPEC SS5.7/SS13.4: `string`'s zero value is the
    // empty string, not `nil` -- unlike the reference types that do have one).
    rtFsReadAllFailedSet(true)
    return emptyStr()
  }
  if (end == 0) {
    // `lseek` succeeded and reported 0: a genuinely empty file. Unambiguous,
    // and this is the correct, safe result -- `string`'s zero value IS the
    // empty string (SPEC SS13.4), so no sentinel is needed or possible here.
    // The flag stays `false` from the entry-clear above: a genuinely empty
    // file must never be reported as a read failure (#2996's own
    // constraint).
    return emptyStr()
  }
  syscall(sysLseek(), i64(fd), i64(0), i64(0))
  let s = rtStrAlloc(end)
  if (s == 0) {
    // Allocation failed for a file we already know is non-empty (`end > 0`
    // above). A genuine failure, distinct in cause from the `end < 0` branch
    // above but reported the identical way.
    rtFsReadAllFailedSet(true)
    return emptyStr()
  }
  let base = strData(s)
  let off = 0
  let retries = 0
  while (off < end && retries < maxReadAllRetries) {
    // Bracketed for the same reason `rtFsRead` above is (#2207, and #2990's
    // investigation found this call was NOT bracketed): `fd` may be a pipe or
    // a slow device, so this can block indefinitely, and `base` points into a
    // live string held across the call, so `syscall`, not `blocked`.
    gcSyscallBegin()
    let n = int(syscall(sysRead(), i64(fd), i64(base + off), i64(end - off)))
    gcSyscallEnd()
    if (n > 0) {
      off = off + n
    } else if (n == errnoIntr) {
      retries = retries + 1
    } else {
      return rtStringSlice(s, 0, off)
    }
  }
  if (off < end) {
    return rtStringSlice(s, 0, off)
  }
  return s
}

// `bit_rt_fs_write`: write all of `s`'s bytes to `fd`. Returns the byte count, or
// -1 on any write error.
//
// BOUNDED (Power of 10 rule 2): `off` rises by at least 1 each iteration (a zero
// write breaks, an error returns) and the loop exits at `off >= len`.
export @nosplit @symbol("bit_rt_fs_write") fn rtFsWrite(fd: int, s: int): int {
  let total = strLenOf(s)
  let base = strData(s)
  let off = 0
  while (off < total) {
    // Bracketed for the same reason as `rtFsRead` above (#2207): a write to a
    // full pipe or a slow tty blocks until the far end drains, and an
    // unbracketed block spins whichever thread wants a stop-the-world. `base`
    // points into a live string held across the call, so `syscall`, not
    // `blocked`.
    gcSyscallBegin()
    let n = int(syscall(sysWrite(), i64(fd), i64(base + off), i64(total - off)))
    gcSyscallEnd()
    if (n < 0) {
      return 0 - 1
    }
    if (n == 0) {
      return off
    }
    off = off + n
  }
  return off
}

// `bit_rt_fs_pread_w`: up to `max` bytes from `fd` at absolute offset `off`
// into the caller-owned buffer at `buf` -- a `[]byte`'s packed backing store
// (ABI.md §2, #3121/#3226), the same convention `../darwin/fs.bit`'s
// `bit_rt_fs_is_symlink_w` uses, not a Bit `string`. Byte count transferred,
// or a negative value on any I/O error -- a raw `syscall` failure IS
// `-errno` directly (this file's header), already negative, so no extra sign
// flip is needed. A SHORT count (including 0 at end of file) is NOT an
// error.
export @nosplit @symbol("bit_rt_fs_pread_w") fn rtFsPreadW(
  fd: int,
  buf: int,
  max: int,
  off: int,
): int {
  if (max <= 0) {
    return 0
  }
  // Bracketed for the same reason `rtFsRead` above is (#2207): `buf` is the
  // live `[]byte` backing store the caller (`std/fs`'s eventual
  // `File.readAt`) still holds a reference to across this call, so
  // `syscall`, not `blocked` -- `blocked` would let it be swept.
  gcSyscallBegin()
  let n = int(syscall(sysPread64(), i64(fd), i64(buf), i64(max), i64(off)))
  gcSyscallEnd()
  return n
}

// `bit_rt_fs_pwrite_w`: write `n` bytes from `buf` (same packed-backing
// convention as `bit_rt_fs_pread_w` above) to `fd` at absolute offset `off`.
// Byte count transferred, or a negative value on any I/O error.
export @nosplit @symbol("bit_rt_fs_pwrite_w") fn rtFsPwriteW(
  fd: int,
  buf: int,
  n: int,
  off: int,
): int {
  if (n <= 0) {
    return 0
  }
  // Bracketed for the same reason `rtFsWrite` above is (#2207): `buf` is the
  // live `[]byte` backing store the caller still holds a reference to across
  // this call, so `syscall`, not `blocked`.
  gcSyscallBegin()
  let written = int(syscall(sysPwrite64(), i64(fd), i64(buf), i64(n), i64(off)))
  gcSyscallEnd()
  return written
}

// `bit_rt_fs_sync`: flush `fd`'s already-written bytes to stable storage. 0
// on success, -1 on any failure -- a caller must not treat a successful
// `bit_rt_fs_write` as durable until this also returns 0. A raw `syscall`
// failure IS `-errno` directly (../fs.bit's header), so any non-zero result
// is a genuine error; no fallback path is needed the way Darwin's
// `F_FULLFSYNC`/`ENOTSUP` device is (`fsync(2)` is already the durable call
// on Linux).
export @nosplit @symbol("bit_rt_fs_sync") fn rtFsSync(fd: int): int {
  if (int(syscall(sysFsync(), i64(fd))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_cwd`: the process's current working directory, or the empty
// string on any failure. Takes no path -- unlike every other `bit_rt_fs_*`
// primitive in ./fs.bit, there is nothing to encode through `fsPathZ`.
// `fsLinkMaxPath` (../fs.bit's mirrored `max_path` = 4096) sizes the
// scratch, the same technique `rtFsRead` above uses: allocate a fresh Bit
// string via `rtStrAlloc` and hand the raw `getcwd(2)` syscall its own
// backing store directly.
//
// The raw `getcwd` syscall (kernel `fs/d_path.c`'s `SYSCALL_DEFINE2`, read
// from source, not memory) returns the byte count written INCLUDING the
// terminating NUL on success -- unlike a POSIX `read`, whose count excludes
// nothing because it never NUL-terminates -- or a negative `-errno` on any
// failure (`ERANGE` too small, `ENOENT` the cwd was unlinked). `n - 1` trims
// that trailing NUL off the returned string.
export @nosplit @symbol("bit_rt_fs_cwd") fn rtFsCwd(): int {
  let big = rtStrAlloc(fsLinkMaxPath)
  if (big == 0) {
    return emptyStr()
  }
  let n = int(syscall(sysGetcwd(), i64(strData(big)), i64(fsLinkMaxPath)))
  if (n <= 0) {
    return emptyStr()
  }
  return rtStringSlice(big, 0, n - 1)
}
