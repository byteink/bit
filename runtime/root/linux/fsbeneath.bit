// `bit_rt_fs_open_beneath_w`/`bit_rt_fs_fstat_w` (ABI.md §14 addendum, #5793):
// close the TOCTOU #5787 found through pkg/web's static file server — it
// validates every path component with `lstat` and then opens by path, so a
// parent directory swapped for a symlink to outside the served root between
// the check and the open is followed. `./fs.bit`'s `rtFsOpenNoFollowW`
// (#4720) only refuses a symlink in the FINAL component; every ancestor is
// still an unguarded lookup.
//
// Sibling file to ./fs.bit rather than added there for the same reason
// ../darwin/fsbeneath.bit's header states: these two symbols are wired to
// Bit through "std/fs/secure", NOT "std/fs" itself, which compiler/ and
// tools/build import and which the pinned 0.24.0 stage0's libbitrt cannot
// link against until a release repins.
//
// `root` AND `rel` ARRIVE SEPARATELY, NOT PRE-JOINED, the same reason
// ../darwin/fsbeneath.bit gives: `root` is opened normally, following its
// own symlinks (a real static-file root is routinely reached through one —
// this machine's own `$TMPDIR` on Darwin, `/tmp` in some container setups
// on Linux); only `rel`'s resolution against `root`'s dirfd is walked with
// `O_NOFOLLOW` refusing every component.
//
// TWO PATHS, ONE POLICY (#5809). The FAST path is one `openat2(2)` syscall
// with `RESOLVE_BENEATH|RESOLVE_NO_SYMLINKS|RESOLVE_NO_MAGICLINKS` (Linux
// 5.6+): the kernel resolves all of `rel` against `root`'s dirfd and refuses
// a `..` that climbs out, a symlink in ANY component (the leaf included) and
// a magic link, atomically. The FALLBACK is the per-component `openat` walk
// `openBeneathWalk` below, run when the kernel cannot answer: `ENOSYS`
// (< 5.6), `EPERM` (a seccomp filter that denies unknown syscalls, the old
// docker default), `E2BIG` (a struct size the kernel rejects) or `EAGAIN`
// (the kernel could not rule out a racing rename; the walk can). The walk
// opens each component against the fd the PREVIOUS component's own open
// returned, so it is exactly as race-free as `openat2`'s single syscall,
// just more syscalls per open, and it meets the race and containment
// acceptance on kernels with no `openat2` at all. Any OTHER `openat2` error
// is a refusal, never a reason to retry through the walk: the two paths
// share one policy (refuse every symlink and every `..`), so they agree on
// what to refuse and a fallback adds no new way to succeed. `rtFsOpenBeneathWalkW`
// exports the walk alone so a test can run both paths on any kernel.
//
// `atFdCwd`, `wordsPathZ`, `isX64`, `sysClose`, `sysFstat`, `sysOpen`,
// `fsStatBuf`, `fsScratchSlot`, `fsStatSlotWords`, `statSizeOff`,
// `statMtimeSecOff`, `statModeOffX64`, `statModeOffArm64`, `sIfmt`,
// `sIfdir`, `loadWord`, `storeWord`, `loadByte`, `storeByte`, `permFile`,
// `permDir` are NOT imported here: ./fs.bit and ./fsrw.bit, siblings in
// this same module, already declare/import every one of them, and Bit's
// imports and top-level declarations are module-scoped — a second import
// or a redeclaration here would be E0042.
import { sysOpenatX64, sysUnlinkatX64 } from "../../syscalls"

// `O_DIRECTORY`: NOT the shared `asm-generic/fcntl.h` bit the header comment
// here first assumed — an ACTUAL divergence, same as `O_NOFOLLOW`
// (./fs.bit's `oNoFollowX64`/`oNoFollowArm64`) has, just not documented
// anywhere this file's author could find by memory. Measured with a throwaway
// C probe (`openat(AT_FDCWD, dir, O_DIRECTORY|O_RDONLY)`, printing the
// macro) built and run via `gcc:latest --platform linux/{amd64,arm64}`,
// NOT transcribed from a header: x86-64 `0o200000` = 65536
// (`asm-generic/fcntl.h`'s value, which glibc/musl on x86-64 use directly),
// aarch64 `0o040000` = 16384 (ARM's own `bits/fcntl-linux.h` numbering,
// same file `arch/arm64/include/uapi/asm/fcntl.h` gives `O_NOFOLLOW`). The
// FIRST version of this constant used 65536 on both arches and made every
// `openBeneath` call on aarch64-linux fail `EINVAL` on the root open alone
// — caught by this ticket's own race-test run in the `bit-linux-gate`
// docker image, not by review.
const oDirectoryX64: int = 65536   // 0o200000
const oDirectoryArm64: int = 16384 // 0o040000

// `S_IFREG` (POSIX-common, same value on x86-64 and aarch64, and the same
// value ../darwin/fsbeneath.bit's sibling constant uses): `0o100000`.
// `rtFsFstatW` below uses this to tell a plain file apart from a FIFO,
// device or socket placed directly under a served root (none of which
// `rtFsOpenBeneathW`/`openBeneathWalk` reject — only a directory or a
// symlink anywhere in `rel`'s resolution is refused there) so a caller
// like `std/fs/secure`'s `statOpen` can answer "is this safe to read"
// without a second, racy path lookup (#5798).
const sIfreg: int = 32768 // 0o100000

// `O_NONBLOCK` (`0o4000` = `2048`, matching ../linux/osruncap.bit's own
// `osCapNonBlock` — no per-arch split the way `O_DIRECTORY` above needs,
// re-declared locally for the same layering reason that file gives). OR'd
// onto the WALK'S LEAF component only, below: a plain POSIX `open()` on a
// FIFO with no writer on the other end BLOCKS AT OPEN TIME, before this
// walk has even returned an fd for `statOpen` to answer "is this regular"
// about (#5798) — `O_NONBLOCK` makes that open return immediately instead,
// at which point the caller's `isRegular` check refuses it with no read
// ever attempted. Harmless on a regular file or a directory: `O_NONBLOCK`
// only changes read()/open() blocking behaviour on a FIFO, device or
// socket. Not applied to intermediate components — those are always
// `O_DIRECTORY`, which `O_NONBLOCK` cannot affect either way.
const oNonBlock: int = 2048

// `openat2(2)` (#5809). Every value below was measured with a throwaway C
// probe (`<linux/openat2.h>`, `<sys/syscall.h>`, `offsetof`) built and run in
// `gcc:latest` on x86_64-linux, NOT transcribed from memory: `SYS_openat2` =
// 437 (the asm-generic table, so the same number on aarch64, which has no
// legacy table), `sizeof(struct open_how)` = 24 with `flags`@0 `mode`@8
// `resolve`@16 (three u64), `RESOLVE_NO_MAGICLINKS` = 2,
// `RESOLVE_NO_SYMLINKS` = 4, `RESOLVE_BENEATH` = 8. `RESOLVE_NO_SYMLINKS`
// is the policy the walk already has (`O_NOFOLLOW` on every component:
// ANY symlink refused, in-root ones too, not just escaping ones) and implies
// `RESOLVE_NO_MAGICLINKS`; both are passed so the intent survives a reader
// who forgets the implication.
const sysOpenat2: int = 437
const openHowBytes: int = 24
const resolveNoMagicLinks: int = 2
const resolveNoSymlinks: int = 4
const resolveBeneath: int = 8

// `-errno` values `openat2` answers that mean "this kernel cannot answer,
// use the walk" (see the header): EPERM, E2BIG, EAGAIN, ENOSYS. Identical on
// x86-64 and aarch64 (`asm-generic/errno-base.h`, `errno.h`).
const errPerm: int = 1
const errE2big: int = 7
const errAgain: int = 11
const errNoSys: int = 38

// `openBeneathFast`'s "not answered, run the walk" result: distinct from -1
// (refused) and from every fd.
const openFallback: int = 0 - 2

@nosplit fn oDirectoryVal(): int {
  if (isX64()) {
    return oDirectoryX64
  }
  return oDirectoryArm64
}

// `openat(dirfd, pathPtr, flags)`, permissions defaulting to `permFile`
// (irrelevant without `O_CREAT`, which this walk never sets). Raw syscall
// return: the new fd, or `-errno`.
@nosplit fn sysOpenAt(dirfd: int, pathPtr: int, flags: int): int {
  if (isX64()) {
    return int(syscall(sysOpenatX64(), i64(dirfd), i64(pathPtr), i64(flags), i64(permFile)))
  }
  return int(syscall(sysOpenatArm64(), i64(dirfd), i64(pathPtr), i64(flags), i64(permFile)))
}

// The per-arch `O_NOFOLLOW` value ./fs.bit's `sysOpen` mode 4 already picks
// the same way.
@nosplit fn oNoFollowVal(): int {
  if (isX64()) {
    return oNoFollowX64
  }
  return oNoFollowArm64
}

// Whether the open fd `fd` names a directory — `fstat(2)`, not `O_DIRECTORY`
// on the leaf open itself: a bare `openat` with no `O_DIRECTORY` on a
// directory SUCCEEDS on Linux (./fs.bit's header, `#2149`), so this is the
// same after-the-fact guard `rtFsOpen`/`rtFsOpenNoFollowW` apply there via
// `isDirAtP`, applied here to an fd instead of a path.
@nosplit fn fdIsDir(fd: int): bool {
  let slotBase = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  if (int(syscall(sysFstat(), i64(fd), i64(slotBase))) < 0) {
    return false
  }
  let modeOff = statModeOffX64
  if (!isX64()) {
    modeOff = statModeOffArm64
  }
  let mode = loadWord(slotBase + modeOff) & 4294967295
  return (mode & sIfmt) == sIfdir
}

// Whether the NUL-terminated C path `p` (`n` bytes, not counting the NUL)
// contains a bare `..` COMPONENT anywhere, or an EMPTY component before its
// last (`a//b`). `..` is an ordinary directory entry, never a symlink, so
// the walk's `O_NOFOLLOW` does not stop it: it resolves straight through and
// would climb out of `root` with no symlink involved at all (`RESOLVE_BENEATH`
// catches it on the fast path; this check is the walk's only defence, and
// keeps the two paths agreeing). `a//b` is refused so the two paths agree on
// it as well: the walk's `openat(fd, "")` fails `ENOENT`, while `openat2`
// collapses repeated slashes and would serve it. A single trailing slash is
// not refused here: both paths then end on a directory and `fdIsDir` refuses
// it. This is the runtime's OWN containment check, independent of
// `stdlib/fs/secure/secure.bit`'s lexical `std/path.contains` call: a
// security primitive does not get to assume every future caller remembers to
// run that check first. BOUNDED (Power of 10 rule 2): by `n`, `p`'s own
// length.
@nosplit fn hasUnsafeComponent(p: int, n: int): bool {
  let i = 0
  let start = 0
  while (i <= n) {
    if (i == n || loadByte(p + i) == 47) {
      let clen = i - start
      if (clen == 2 && loadByte(p + start) == 46 && loadByte(p + start + 1) == 46) {
        return true
      }
      if (clen == 0 && i < n) {
        return true
      }
      start = i + 1
    }
    i = i + 1
  }
  return false
}

// Whether `rc`, a raw `openat2` return, says the kernel could not answer
// (header: ENOSYS, EPERM, E2BIG, EAGAIN) rather than refused.
@nosplit fn at2Unavailable(rc: int): bool {
  return rc == 0 - errNoSys || rc == 0 - errPerm || rc == 0 - errE2big || rc == 0 - errAgain
}

// The fast path: ONE `openat2(rootFd, rel, {O_NOFOLLOW|O_NONBLOCK, 0,
// BENEATH|NO_SYMLINKS|NO_MAGICLINKS}, 24)`. The `open_how` is marshaled into
// this worker's `fsStatBuf` slot (18 words, three used; free here, `fdIsDir`
// below reuses it only after the syscall returned). `O_NOFOLLOW|O_NONBLOCK`
// are the walk's own leaf flags (`O_NONBLOCK` so a FIFO leaf cannot block the
// open, #5798); `mode` must be 0 without `O_CREAT`. Returns `openFallback`
// with `rootFd` STILL OPEN when the kernel cannot answer; otherwise closes
// `rootFd` and returns the fd, or -1 for any refusal, a directory result
// included.
@nosplit fn openBeneathFast(rootFd: int, rel: int): int {
  let how = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  storeWord(how, oNoFollowVal() | oNonBlock)
  storeWord(how + 8, 0)
  storeWord(how + 16, resolveBeneath | resolveNoSymlinks | resolveNoMagicLinks)
  let rc = int(syscall(sysOpenat2, i64(rootFd), i64(rel), i64(how), i64(openHowBytes)))
  if (at2Unavailable(rc)) {
    return openFallback
  }
  syscall(sysClose(), i64(rootFd))
  if (rc < 0) {
    return 0 - 1
  }
  if (fdIsDir(rc)) {
    syscall(sysClose(), i64(rc))
    return 0 - 1
  }
  return rc
}

// Walk the NUL-terminated, RELATIVE C path `rel` (`n` bytes) against the
// already-open directory fd `rootFd` one component at a time,
// `O_NOFOLLOW`ing and (for every component but the last) `O_DIRECTORY`ing
// each — opening a component against the fd the PREVIOUS component's own
// open just returned, rather than re-resolving the remaining suffix from
// `rootFd` each time, is what makes this race-free. `rel` is `wordsPathZ`'s
// per-worker scratch copy, so temporarily overwriting its `/` bytes to
// isolate one component at a time is safe — no other call reads this slot
// until this one returns. BOUNDED (Power of 10 rule 2): by `n`. fd, or -1
// for any open failure or a directory result. Always closes `rootFd`.
@nosplit fn openBeneathWalk(rootFd: int, rel: int, n: int): int {
  let curFd = rootFd
  let i = 0
  while (i < n) {
    let start = i
    while (i < n && loadByte(rel + i) != 47) {
      i = i + 1
    }
    let isLast = i >= n
    let saved = loadByte(rel + i)
    if (i < n) {
      storeByte(rel + i, 0)
    }
    let flags = oNoFollowVal()
    if (!isLast) {
      flags = flags | oDirectoryVal()
    } else {
      flags = flags | oNonBlock
    }
    let nextFd = sysOpenAt(curFd, rel + start, flags)
    if (i < n) {
      storeByte(rel + i, saved)
    }
    syscall(sysClose(), i64(curFd))
    if (nextFd < 0) {
      return 0 - 1
    }
    curFd = nextFd
    i = i + 1
  }
  if (fdIsDir(curFd)) {
    syscall(sysClose(), i64(curFd))
    return 0 - 1
  }
  return curFd
}

// Open the already-scratch-copied, NUL-terminated C path `p` as a
// directory, FOLLOWING its own symlinks — `rtFsOpenBeneathW`'s root-open
// step, factored out so `rtFsOpenDirW` below (`walkBeneath`'s root open,
// #5800) shares it instead of repeating the `sysOpenAt(atFdCwd, ...)` call.
@nosplit fn openDirFollowingP(p: int): int {
  return sysOpenAt(atFdCwd, p, oDirectoryVal())
}

// Shared body of the two exports below: open `root` (the `rootN`-byte packed
// path at `rootWords`, following its own symlinks, via `openDirFollowingP`'s
// `O_DIRECTORY` open) then resolve `rel` (the `relN`-byte packed path at
// `relWords`) beneath it, refusing a symlink or a `..` in any component.
// `useFast` selects `openBeneathFast` first (falling back to the walk when
// the kernel cannot answer) or the walk alone. The caller —
// `stdlib/fs/secure/secure.bit`'s `openBeneath` — has already run
// `std/path`'s `join`+`contains` on `root`/`rel` to refuse a lexical `..`
// escape before this call reaches the kernel at all; `hasUnsafeComponent`
// is this primitive's own second, independent check, and runs before either
// path so neither can be handed one. fd, or -1.
@nosplit fn openBeneathImpl(
  rootWords: int, rootN: int, relWords: int, relN: int, useFast: bool,
): int {
  let rootP = wordsPathZ(rootWords, rootN)
  if (rootP == 0) {
    return 0 - 1
  }
  let rootFd = openDirFollowingP(rootP)
  if (rootFd < 0) {
    return 0 - 1
  }
  // `wordsPathZ` reuses ONE per-worker scratch slot -- `rootP`'s bytes are
  // already consumed by `sysOpenAt` above, so computing `relP` into the
  // same slot next is safe reuse, not a clobber.
  let relP = wordsPathZ(relWords, relN)
  if (relP == 0 || loadByte(relP) == 47 || hasUnsafeComponent(relP, relN)) {
    syscall(sysClose(), i64(rootFd))
    return 0 - 1
  }
  let fd = openFallback
  if (useFast) {
    fd = openBeneathFast(rootFd, relP)
  }
  if (fd == openFallback) {
    fd = openBeneathWalk(rootFd, relP, relN)
  }
  if (fd < 0) {
    return 0 - 1
  }
  return fd
}

// `bit_rt_fs_open_beneath_w`: `openBeneathImpl` with the `openat2` fast path
// (one syscall for `rel` on Linux 5.6+, the walk otherwise).
export @nosplit @symbol("bit_rt_fs_open_beneath_w") fn rtFsOpenBeneathW(
  rootWords: int, rootN: int, relWords: int, relN: int,
): int {
  return openBeneathImpl(rootWords, rootN, relWords, relN, true)
}

// `bit_rt_fs_open_beneath_walk_w` (#5809): the same primitive forced onto the
// per-component walk, so `stdlib/fs/secure/secure.test.bit` can prove every
// escape shape against the fallback on a kernel that has `openat2`. Not
// declared by `std/fs/secure` itself; only that test file declares it.
export @nosplit @symbol("bit_rt_fs_open_beneath_walk_w") fn rtFsOpenBeneathWalkW(
  rootWords: int, rootN: int, relWords: int, relN: int,
): int {
  return openBeneathImpl(rootWords, rootN, relWords, relN, false)
}

// `bit_rt_fs_fstat_w`: `fd`'s metadata via `fstat(2)` — the same 6-word
// `out` shape ./fs.bit's `fillStat` fills from a path (size, mtime, mode,
// isDir, isSymlink) PLUS one word `fillStat` does not carry, `isRegular`,
// read from the already-open handle so a caller never re-resolves a name
// that could have moved since `open` returned. `isSymlink` is always
// `false`: `fstat` on an fd reports the target a followed fd already is.
// 0 on success, -1 on failure.
export @nosplit @symbol("bit_rt_fs_fstat_w") fn rtFsFstatW(fd: int, out: int): int {
  let slotBase = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  if (int(syscall(sysFstat(), i64(fd), i64(slotBase))) < 0) {
    return 0 - 1
  }
  let modeOff = statModeOffX64
  if (!isX64()) {
    modeOff = statModeOffArm64
  }
  let mode = loadWord(slotBase + modeOff) & 4294967295
  storeWord(out, loadWord(slotBase + statSizeOff))
  storeWord(out + 8, loadWord(slotBase + statMtimeSecOff))
  storeWord(out + 16, mode & 4095)
  let isDir = 0
  if ((mode & sIfmt) == sIfdir) {
    isDir = 1
  }
  storeWord(out + 24, isDir)
  storeWord(out + 32, 0)
  let isRegular = 0
  if ((mode & sIfmt) == sIfreg) {
    isRegular = 1
  }
  storeWord(out + 40, isRegular)
  return 0
}

// `bit_rt_fs_open_dir_w`/`bit_rt_fs_open_dir_beneath_fd_w`/
// `bit_rt_fs_list_dir_fd_w` (#5800): the three primitives `std/fs/secure`'s
// `walkBeneath` needs to close #5787's OTHER TOCTOU — `std/fs`'s own `walk`
// (stdlib/fs/fs.bit) checks `isRealDir(p)` then calls `readDir(p)` BY PATH,
// so a directory swapped for a symlink to outside the tree between the two
// calls is followed, exactly the race `openBeneath` above closes for a
// single file open. `walkBeneath` never re-resolves a path once it has an
// fd: it lists each directory FROM the fd it already opened no-follow, and
// descends into a child only by opening it no-follow relative to that SAME
// fd — a swap of any ancestor after this walk holds its fd can no longer
// change what that fd names, the same invariant `rtFsOpenBeneathW`'s
// per-component walk above relies on.

// `bit_rt_fs_open_dir_w`: open the `n`-byte packed path at `words` as a
// directory, FOLLOWING its own symlinks — `walkBeneath`'s ROOT open. `root`
// is the trusted boundary the caller named, exactly like `openBeneath`'s
// `root` argument, so it is opened normally; only the DESCENT below it
// (`rtFsOpenDirBeneathFdW`) refuses a symlink. fd, or -1 for a malformed
// path, a non-directory, or any other open failure.
export @nosplit @symbol("bit_rt_fs_open_dir_w") fn rtFsOpenDirW(words: int, n: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  return openDirFollowingP(p)
}

// Whether the NUL-terminated `n`-byte name at `p` is safe to open as a
// SINGLE path component: no `/` anywhere (a real directory entry can never
// contain one; this only guards a future caller that hands this primitive
// something other than one listed name), and not `.`/`..` (`walkBeneath`'s
// own listing, `rtFsListDirFdW` below, already excludes both, the same
// defense-in-depth reasoning `hasUnsafeComponent` above gives for
// `rtFsOpenBeneathW`'s `rel`). BOUNDED (Power of 10 rule 2): by `n`.
@nosplit fn isSingleSafeComponent(p: int, n: int): bool {
  if (n == 0) {
    return false
  }
  if (n == 1 && loadByte(p) == 46) {
    return false
  }
  if (n == 2 && loadByte(p) == 46 && loadByte(p + 1) == 46) {
    return false
  }
  let i = 0
  while (i < n) {
    if (loadByte(p + i) == 47) {
      return false
    }
    i = i + 1
  }
  return true
}

// `bit_rt_fs_open_dir_beneath_fd_w`: open the SINGLE path component
// `nameWords[0:nameN)` relative to the already-open directory `dirFd`,
// refusing a symlink (`O_NOFOLLOW`) and requiring the result to be a
// directory (`O_DIRECTORY`) — `walkBeneath`'s DESCENT step. `dirFd` is
// already open and pinned by this process's own fd table, so a rename or
// symlink-swap of an entry after `walkBeneath` LISTED `dirFd`
// (`rtFsListDirFdW`) cannot change what `dirFd` itself names; only what the
// CHILD resolves to, which `O_NOFOLLOW` catches here. fd of the child
// directory, or -1 for a symlink, a non-directory, `.`/`..`/an embedded `/`,
// or any other open failure — `walkBeneath` reports every one of these as a
// LEAF path, the same contract `std/fs`'s path-based `walk` gives a symlink
// or a plain file.
export @nosplit @symbol("bit_rt_fs_open_dir_beneath_fd_w") fn rtFsOpenDirBeneathFdW(
  dirFd: int, nameWords: int, nameN: int,
): int {
  let nameP = wordsPathZ(nameWords, nameN)
  if (nameP == 0 || !isSingleSafeComponent(nameP, nameN)) {
    return 0 - 1
  }
  let fd = sysOpenAt(dirFd, nameP, oNoFollowVal() | oDirectoryVal())
  if (fd < 0) {
    return 0 - 1
  }
  return fd
}

// `bit_rt_fs_list_dir_fd_w`: the already-open directory `fd`'s entries
// (`.`/`..` omitted), snprintf-shaped exactly like `./fs.bit`'s path-based
// `bit_rt_fs_list_dir` (measure with `outCap == 0`, then fill) — but listed
// straight off `fd` via `getdents64`, never by re-resolving a path, so a
// rename or symlink-swap of the directory itself after `walkBeneath` opened
// it cannot change what gets listed. Does NOT close `fd`: unlike
// `./fs.bit`'s `sysList` (which opened the fd itself and owns it),
// `walkBeneath` still needs `dirFd` open afterward, to open each child
// beneath it (`rtFsOpenDirBeneathFdW`). Total bytes needed, or -1 if `fd`
// does not name a directory. BOUNDED (Power of 10 rule 2): the same
// argument `./fs.bit`'s `sysList` gives — `getdents64` returns 0 at the end
// of a directory with finitely many entries, and the inner loop advances by
// `d_reclen`, which the kernel guarantees positive (the `reclen <= 0` guard
// keeps it bounded even against a malformed record).
// Copy one already-fetched `getdents64` batch (`dbuf[0:batchLen)`) into
// `outPtr[0:outCap)`, skipping `.`/`..`, and return the updated running
// total. Split out of `rtFsListDirFdW` below to keep that function's nesting
// under spec/LINT.md's limit — inlined, this batch-decode loop plus the
// outer `getdents64` retry loop put it two levels past `./fs.bit`'s own
// `sysList`, which already carries that depth as undocumented debt; this one
// does not repeat it. A `reclen <= 0` record ends THIS batch only (the
// kernel guarantees a positive `d_reclen` for every real record, so this is
// a malformed-buffer guard, not a real directory shape) — the outer loop's
// next `getdents64` call still runs. BOUNDED (Power of 10 rule 2): by
// `batchLen`, which the kernel itself bounds to `fsDirBufBytes`.
@nosplit fn copyDirBatch(dbuf: int, batchLen: int, outPtr: int, outCap: int, totalIn: int): int {
  let total = totalIn
  let off = 0
  while (off < batchLen) {
    let reclen = loadU16(dbuf + off + direntReclenOff)
    if (reclen <= 0) {
      return total
    }
    let nameAddr = dbuf + off + direntNameOff
    let nlen = cstrLen(nameAddr)
    if (isDotName(nameAddr, nlen)) {
      off = off + reclen
      continue
    }
    let j = 0
    while (j < nlen) {
      if (total + j < outCap) {
        storeByte(outPtr + total + j, loadByte(nameAddr + j))
      }
      j = j + 1
    }
    if (total + nlen < outCap) {
      storeByte(outPtr + total + nlen, 0)
    }
    total = total + nlen + 1
    off = off + reclen
  }
  return total
}

export @nosplit @symbol("bit_rt_fs_list_dir_fd_w") fn rtFsListDirFdW(
  fd: int, outPtr: int, outCap: int,
): int {
  // `getdents64` reads from `fd`'s own kernel-tracked directory position:
  // without this reset, a first (measuring, #5800) call already reading
  // `fd` to EOF left the SECOND (filling) call starting from that same EOF
  // position and returning 0 every time, no matter how many entries `fd`
  // actually names. `lseek` back to the start so every call to this
  // primitive is independent of how many times it (or a caller reusing
  // `fd`) has been called before. Harmless to `fd`'s later use:
  // `walkBeneath` only ever opens children relative to `fd` afterward,
  // which does not care about its read offset.
  syscall(sysLseek(), i64(fd), i64(0), i64(0))
  let dbuf = int(ptrOf(fsDirBuf)) + fsScratchSlot() * fsDirBufBytes
  let total = 0
  let done = false
  while (!done) {
    let rc = int(syscall(sysGetdents64(), i64(fd), i64(dbuf), i64(fsDirBufBytes)))
    if (rc < 0) {
      return 0 - 1
    }
    if (rc == 0) {
      done = true
    }
    total = copyDirBatch(dbuf, rc, outPtr, outCap, total)
  }
  return total
}

// `bit_rt_fs_unlink_at_w` (#5816): remove the SINGLE path component
// `nameWords[0:nameN)` relative to the already-open directory `dirFd`, via
// the `unlinkat` syscall — never by re-resolving a path, so a rename or
// symlink-swap of an ancestor after `removeAll` opened `dirFd` cannot change
// what this removes. `isDir` OR's in `atRemoveDir` (./fs.bit's constant,
// already module-scoped here — see this file's header note on why it is not
// re-imported), selecting the `rmdir`-shaped removal versus a plain
// file/symlink unlink; the caller decides which by whether
// `rtFsOpenDirBeneathFdW` on the same name just succeeded no-follow — this
// primitive does not stat or classify `name` itself. 0 on success, -1 for a
// malformed name, `.`/`..`, an embedded `/`, or any other failure alike.
export @nosplit @symbol("bit_rt_fs_unlink_at_w") fn rtFsUnlinkAtW(
  dirFd: int, nameWords: int, nameN: int, isDir: bool,
): int {
  let nameP = wordsPathZ(nameWords, nameN)
  if (nameP == 0 || !isSingleSafeComponent(nameP, nameN)) {
    return 0 - 1
  }
  let flags = 0
  if (isDir) {
    flags = atRemoveDir
  }
  let rc = 0
  if (isX64()) {
    rc = int(syscall(sysUnlinkatX64(), i64(dirFd), i64(nameP), i64(flags)))
  } else {
    rc = int(syscall(sysUnlinkatArm64(), i64(dirFd), i64(nameP), i64(flags)))
  }
  if (rc == 0) {
    return 0
  }
  return 0 - 1
}
