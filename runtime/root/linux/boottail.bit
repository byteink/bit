// ---------------------------------------------------------------------------
// The `BIT_GC_STATS` line (#1639) — kept identical in ../darwin/boot.bit
// ---------------------------------------------------------------------------
//
// `runtime/gc/`'s `collect` prints `[bit-gc] collection N: ...` per collection. THIS
// PORT CANNOT PRINT FROM THERE: every function on the collection path is
// `@nosplit`, which admits no `print`, no `extern` call and no `syscall`
// (`runtime/gc` deviation 6, E0075). So the flag's OWNER is boot, which is
// ordinary Bit sitting next to ./io.bit's write primitive, and the shape becomes
// one SUMMARY line at exit instead of one line per collection.
//
// That deviation is worth naming precisely, because #1639 measured the missing
// output and the missing collections together: a Bit-runtime binary printed
// nothing under `BIT_GC_STATS=1` for TWO independent reasons, and fixing only
// the wiring would still have printed nothing. `swept=` and `live=` are on the
// line for the same reason — a count alone cannot tell a collector that
// reclaims from one that marks everything.
//
// Text is emitted through `writeConst` (packed byte constants) rather than
// string literals: this module is `--freestanding` (#1628) and builds no
// managed string. The decimals go through ./os.bit's `osWriteDecimal`, a
// sibling.

// The line is assembled in MODULE STATE and written in ONE call, and it
// allocates nothing. That is a hard requirement, not tidiness: this runs on the
// boot thread after the worker is joined, i.e. after a whole run's worth of
// collection, and `[]int(n)` there returned 0 on roughly 40% of runs at
// 65k-collection density — a null the decimal writer then stored through
// (`strb w19, [x20]`, x20 = 4). ../io.bit's `writeConst` allocates too, so it is
// not used here either. `panicWrite` states the same rule for the same reason:
// the one path that must work when allocation is what failed cannot allocate.
// The residual question the null raised — whether a boot-thread allocation can
// fail after a heavy collected run — is filed separately (#1643); it is not
// reached from here any more.
//
// 224 bytes, and the size is a SUM to redo whenever a field is added, not a
// round number (#3046 recomputed this when ` chunks=`/` chunkbytes=` were
// added): the fixed text below is 76 bytes (56 for the original five fields
// plus 8 for " chunks=" and 12 for " chunkbytes=") and SEVEN i64 decimals are
// at most 140 (20 bytes each, i64's own worst case), so 216 is the worst
// case — 27 whole words, rounded up to 28 for a word of slack. `statsConst`/
// `statsNum` write through a raw `ptrOf`, so an undersized block runs off the
// end in silence (#1682).
let statsBuf: [28]i64

// Append `nbytes` low bytes of the packed constant `word` at byte offset `at`,
// returning the new offset. Packed constants rather than string literals because
// this module is `--freestanding` (#1628) and builds no managed string.
@nosplit fn statsConst(at: int, word: int, nbytes: int): int {
  let base = int(ptrOf(statsBuf))
  let w = word
  let i = 0
  while (i < nbytes) {
    storeByte(base + at + i, w & 255)
    w = w >> 8
    i = i + 1
  }
  return at + nbytes
}

// Append `v` in decimal at byte offset `at`, returning the new offset.
@nosplit fn statsNum(at: int, v: int): int {
  return at + osWriteDecimal(int(ptrOf(statsBuf)) + at, v)
}

// `[bit-gc] collections=<n> swept=<n> live=<n> abandoned=<n> oom=<n> bad=<n>
// chunks=<n> chunkbytes=<n>`, on stderr, once, only under `BIT_GC_STATS`.
// Called after `main` has finished and the worker is reaped, so nothing can
// be collecting while it reads.
@nosplit fn statsReport() {
  let at = statsConst(0, 6729335713145905755, 8)   // "[bit-gc]"
  at = statsConst(at, 8386658447444108064, 8)      // " collect"
  at = statsConst(at, 263929622377, 5)             // "ions="
  at = statsNum(at, stwCollections())
  at = statsConst(at, 17297999666836256, 7)        // " swept="
  at = statsNum(at, stwSwept())
  at = statsConst(at, 67505987611680, 6)           // " live="
  at = statsNum(at, stwLiveObjects())
  at = statsConst(at, 7957689491829973280, 8)      // " abandon"
  at = statsConst(at, 4023397, 3)                  // "ed="
  at = statsNum(at, stwAbandonedCount())
  at = statsConst(at, 28448, 2)                    // " o"
  at = statsConst(at, 4025711, 3)                  // "om="
  at = statsNum(at, rootStatOom())
  // Pointer-map offsets the tracer refused and SKIPPED (#1682): a skipped field
  // is a reference never marked, and that degraded trace is indistinguishable
  // from a healthy one everywhere else.
  at = statsConst(at, 263677108768, 5)             // " bad="
  at = statsNum(at, stwBadOffsets())
  // The span reserve's chunk count and total mapped bytes (#3046) — the
  // number that would have root-caused #2803's month-long RSS investigation
  // in one run, where RSS itself and per-class occupancy both pointed the
  // wrong way. `stwSpanChunks`/`stwSpanChunkBytes` are the same pinned
  // forwarders `runtime/gc/mem.bit`'s `reserveChunkCount`/
  // `reserveChunkBytesMapped` reach through `runtime/stw`.
  at = statsConst(at, 4428000980795679520, 8)      // " chunks="
  at = statsNum(at, stwSpanChunks())
  at = statsConst(at, 8746671548467274528, 8)      // " chunkby"
  at = statsConst(at, 1030972788, 4)               // "tes="
  at = statsNum(at, stwSpanChunkBytes())
  at = statsConst(at, 10, 1)                       // "\n"
  rootWriteAll(stderrFd, int(ptrOf(statsBuf)), at)
}

// The OS page seam `runtime/gc/mem.bit` reaches through to grow the heap
// (#1638). The collector must compile for all three targets, so it cannot
// contain a `syscall` or a platform `extern function` of its own; it names this
// symbol and lets the link resolve it.
//
// PINNED (ABI.md §9) with the real ABI name. This IS the definition the
// collector binds to — there is no second one. It carried a `bit_rt_root_`
// placeholder while two archives coexisted; G2 (#1583) stripped the infix.
//
// A wrapper rather than pinning `../../alloc/{linux,darwin}`'s `mapPages`
// directly: that module is compiled from source by any program importing this
// one, so a pin there would be defined twice in the same link
// (`tests/stress/roothostdarwin` is such a program, and is how that was found).
// Keeping the ABI name here, on a wrapper, is what avoids it.
export @nosplit @symbol("bit_rt_map_pages") fn rtMapPages(nbytes: int): int {
  return mapPages(nbytes)
}

// The release half of the same seam (#1641/#1662). `runtime/gc/mem.bit` frees a
// direct-mapped large object by naming `bit_rt_unmap_pages`, and this answers it.
// Non-zero on success, 0 when there is nothing to release. The caller ignores it,
// because a `munmap` of a range the allocator itself mapped cannot fail for any
// reason a caller could act on.
//
// A wrapper over `../../alloc/{linux,darwin}`'s `unmapPages` for the identical
// reason `rtMapPages` wraps `mapPages` rather than pinning it: pinning inside
// the page provider is defined twice in any link that compiles that module from
// source alongside this one.
export @nosplit @symbol("bit_rt_unmap_pages") fn rtUnmapPages(addr: int, nbytes: int): int {
  if (unmapPages(addr, nbytes)) {
    return 1
  }
  return 0
}

// Boot the collector and scheduler, run `bit_main` as the first green thread,
// wait for it, tear down, and return the process exit code. THE ORDER IS
// LOAD-BEARING and mirrors `runtime/root/`'s `boot` (runtime/root/:1974-2011) exactly:
// heap before collector (the collector takes the heap's address), collector
// before scheduler, scheduler populated on the boot thread before any worker
// exists, then start -> wait -> shutdown -> join. A wrong order is a hang or
// heap corruption, not a compile error. 70 (EX_SOFTWARE) on any setup failure,
// the boot path's non-recoverable exit code.
fn boot(): int {
  // 1. Ignore SIGPIPE process-wide (./signal.bit, this module).
  ignoreSigpipe()
  // 1b. Install the SIGSEGV/SIGBUS/SIGTRAP/SIGILL diagnostics (#2246, #2946,
  //     ./signal.bit). Before anything else that can allocate or run user
  //     code, matching where SIGPIPE's own disposition is installed.
  installFatalSignalHandlers()

  // 2. Map and bind the heap, then start the collector and type descriptors.
  let spanBytes = arenaWords * 8
  let idxBytes = indexWords * 8
  let span = mapPages(spanBytes)
  let idx = mapPages(idxBytes)
  if (span == 0 || idx == 0) {
    return 70
  }
  rootBindMemory(span, spanBytes, idx, idxBytes, pageSize)
  if (!rootInit(rootEnvMarkStack(gcDefaultMarkStack))) {
    return 70
  }

  // 3. GC config from the environment (BIT_GC/BIT_GC_MIN_KB/BIT_GC_GROWTH_PCT/
  //    BIT_GC_STATS over the defaults), the Bit port of `runtime/root/`'s
  //    `configFromEnv`. `osSetArgs` ran in `rtStartMain` before `boot`, so `envp`
  //    is captured by now. `gcDefaultMinTrigger` (not a local const, #2920) is
  //    the "unset" default `gcEnvMinTrigger` returns unchanged.
  rootConfigureFromEnv(true, false, gcDefaultMinTrigger, gcDefaultGrowthPct, false)

  // 4. Scheduler over the worker blocks. Publish it for `bit_rt_spawn`
  //    the moment it exists, so a `spawn` from anywhere in the program can find
  //    it — the Bit form of `runtime/root/` assigning the module-global `g_sched`.
  //
  //    WORKER COUNT (#1900/#1902, ABI.md §9 step 2). THE DEFAULT IS 1, AND IT
  //    STAYS 1 EVEN THOUGH #1902 MADE AN IDLE WORKER FREE.
  //
  //    #1900 measured the first reason: an idle worker ran its
  //    find-work/steal/backoff loop at a 1ms ceiling, so 18 idle workers burned
  //    84x the CPU of one to do nothing. #1902 fixed exactly that — workers
  //    1..N-1 now park on the futex — and the same measurement is flat at 0.05s
  //    for every count from 1 to 18, with four CPU-bound tasks still scaling to
  //    383%. So the stated blocker is gone.
  //
  //    A SECOND ONE WAS FOUND WHEN THE FLIP WAS TRIED, and it is not about idle
  //    cost at all: NESTED PARALLELISM. A CPU-count default is a claim on the
  //    whole machine, and it is wrong for a process that is itself one of N run
  //    at once. `tests/bit/docs.bit` runs 12 `bit` invocations concurrently by
  //    design; at 18 workers each that is 216 worker threads on 18 cores, and a
  //    batch that takes ~48s blew its 300s deadline. The threads were genuinely
  //    parked (sampled at 0:00.00 CPU), so this is not the spin #1902 removed —
  //    it is oversubscription, and no amount of making idle workers cheaper
  //    fixes a pool sized against cores the process does not have to itself.
  //
  //    `BIT_WORKERS=<n>` opts in, and after #1902 opting in is genuinely cheap.
  //    The default flips when the runtime can size a pool against the machine's
  //    ACTUAL free capacity rather than its core count.
  //
  let nworkers = rootEnvWorkers(1)
  if (nworkers < 1) {
    nworkers = 1
  }
  if (nworkers > bootMaxWorkers) {
    nworkers = bootMaxWorkers
  }
  let sched: *i64 = ptrOf(schedBlock)
  schedInit(sched, int(ptrOf(workerBlock)), nworkers)
  spawnBindScheduler(int(sched))

  // 4b. Create the netpoller and bind it into the scheduler (#1673). This is
  //     `runtime/sched/`'s `Scheduler.init`, which does `poller = try NetPoller.init()`
  //     inline; the port cannot, because `runtime/sched` may import neither
  //     provider, so the consumer that already is per-platform makes the call.
  //     Nothing else in the tree did, which is why `scPollFd` read back 0 for
  //     every socket in every Bit-sourced `libbitrt.a` ever built.
  //
  //     A FAILURE IS FATAL, and deliberately not a degrade-to-no-poller. A
  //     runtime with no poll descriptor still links, still boots and still runs
  //     every non-networking program correctly — it just returns "" from any read
  //     that has to wait, which reads as an orderly peer close. Refusing to boot
  //     is the only answer that is not silent. 70 = EX_SOFTWARE, the same code the
  //     heap and channel-reserve map failures use.
  //     `pollCreate` already reports a descriptor of 0 as a failure — the
  //     scheduler block spells "no poller bound" as a `scPollFd` of 0, so a
  //     descriptor 0 could not be told apart from an unbound one — so a single
  //     `< 0` test here covers both.
  let pollFd = pollCreate()
  if (pollFd < 0) {
    return 70
  }
  bootPollFd = pollFd
  schedSetPollFd(sched, pollFd)

  //     A SECOND DESCRIPTOR, CARRYING WRITE INTEREST ONLY (#1910). epoll keys a
  //     registration on the fd alone and `EPOLL_CTL_MOD` replaces both the event
  //     mask and the task, so a socket with a concurrent reader and writer had
  //     the second registration destroy the first and the losing task was never
  //     woken — measured as `tests/imports/nettcpbulk` passing at 2.30 MB and
  //     hanging forever at 3.07 MB, the point where the send buffer fills and
  //     the writer starts parking too. Two descriptors cannot evict each other,
  //     which is the property kqueue already has by keying on `(fd, filter)`.
  //
  //     Fatal on failure for the same reason as the first: a runtime with only
  //     half a poller would hang exactly where this bug did, which is the
  //     silent failure this whole path refuses.
  let pollFdWrite = pollCreate()
  if (pollFdWrite < 0) {
    return 70
  }
  bootPollFdWrite = pollFdWrite
  schedSetPollFdWrite(sched, pollFdWrite)

  // 4c. Provision the channel reserve + root-scan registry for
  //     `bit_rt_chan_make` (#1613), the caller-owned-block pattern. Done AFTER the
  //     scheduler exists because `chan_make` stores it into every channel; map
  //     the process-lifetime reserve pages and hand chan the reserve descriptor,
  //     the registry block and the scheduler. A map failure is unrecoverable, the
  //     same 70 (EX_SOFTWARE) as the heap map above.
  let chanMem = mapPages(chanReserveBytes)
  if (chanMem == 0) {
    return 70
  }
  chanBootBind(int(ptrOf(chanReserveDesc)), chanMem, chanReserveBytes,
               int(ptrOf(chanRegBlock)), int(sched))

  // 4d. Arm the STOP-THE-WORLD (#1639). `runtime/stw`'s poll — the body the
  //     `bit_rt_safepoint` shim every loop back edge calls hands its snapshot to
  //     — refuses to collect until all three root sources are reachable
  //     (`stwCanCollect`), so without this call the collector half is present,
  //     linked, and permanently dormant: 0 collections, no diagnostic, correct
  //     output. Must come after `chanBootBind` (the registry block is only
  //     meaningful once chan owns it) and after `schedInit`. `runtime/root`
  //     itself cannot make this call — `runtime/chan` imports it, so importing
  //     `runtime/stw` from there is an import cycle (E0044) — which is why the
  //     bind lives in the platform boot, the leaf that already imports all three.
  //     Identical to ../darwin/boot.bit's.
  stwBind(rootGcAddr(), int(sched), int(ptrOf(chanRegBlock)), rootWorldAddr())

  // 4e. Map the alternate signal stacks `segvHandler` needs to run after a
  //     green thread's own stack has just run out (#2246, ./signal.bit).
  //     Sized to `nworkers`, not `bootMaxWorkers`: every worker this process
  //     actually starts gets one slice, and none of the rest cost anything.
  //     A FAILURE IS FATAL, the same posture step 4b/4c already take for a
  //     mapping this runtime cannot run correctly without.
  sigAltStackBase = mapPages(nworkers * sigAltStackBytes)
  if (sigAltStackBase == 0) {
    return 70
  }

  // 5. Place `bit_main`'s task on worker 0's deque. Register BEFORE queueing so
  //    the worker can never steal a task the registry does not yet know (the
  //    collector must find every live stack).
  //    A MAPPING, NOT A MODULE ARRAY (#1843). This was carved out of a
  //    `[16384]i64` in `__DATA`, which cannot be guarded — an overflow ran
  //    straight into neighbouring module state. `main` runs user code and is the
  //    deepest recursion in any program, so it is the last stack that should be
  //    unguarded.
  let stackBase = mapGuardedStack(mainStackBytes)
  if (stackBase == 0) {
    return 70
  }
  // Published for `segvHandler` (#2246, ./signal.bit) to name a main-stack
  // overflow exactly rather than by heuristic.
  mainStackBaseAddr = stackBase
  let task = int(ptrOf(mainTaskBlock))
  let t: *i64 = ptrOf(mainTaskBlock)
  schedTaskInit(t, stackBase, mainStackBytes, entryOf(mainTrampoline), 0)
  if (!schedRegisterBigStack(stackBase, mainStackBytes, task)) {
    return 70
  }

  schedRegister(sched, task)
  if (!dqPushBottom(schedWorkerAt(sched, 0) + wkDeque, task)) {
    return 70
  }

  // 6. Bring the workers up on real OS threads. `schedStart`'s per-worker arming
  //    (`schedStartArm`) then this platform's `threadStart` called DIRECTLY —
  //    `schedStart` itself takes the spawner as a function value, which this
  //    module may not build (see `workerBody`), so its loop is written out here.
  //
  //    A FAILED SPAWN IS NOT FATAL PAST THE FIRST (#1900). Worker 0 must come up
  //    or nothing runs; beyond that, a kernel refusing the 12th thread should
  //    leave a program running on 11, not kill it. `started` is the count that
  //    actually exists, and it — never `nworkers` — is what step 8 reaps, so a
  //    partial pool cannot make the join wait on a thread that was never created.
  let started = 0
  let wi = 0
  while (wi < nworkers) {
    let startArg = schedStartArm(sched, wi, ptrOf(startArgs), ptrOf(startDones))
    let handle = threadStart(entryOf(workerBody), startArg, ptrOf(startDones) + wi)
    *(ptrOf(startHandles) + wi) = handle
    if (handle == 0) {
      if (wi == 0) {
        return 70
      }
      wi = nworkers
    } else {
      started = started + 1
      wi = wi + 1
    }
  }

  // 7. This OS thread is not a worker, so it waits for `main` the way any
  //    external caller would: poll with bounded exponential backoff, the same
  //    shape as `runtime/sched/`'s idle loop. Unbounded by design — it waits for the
  //    program itself to finish. THE SLEEP IS BRACKETED `blocked` — see "THE BOOT
  //    THREAD AND THE RENDEZVOUS" above. Identical in ../darwin/boot.bit.
  let backoff = 1000
  while (atomicLoad(ptrOf(mainDone)) == i32(0)) {
    gcBlockingBegin()
    parkSleepNs(backoff, ptrOf(bootSleepReq))
    gcBlockingEnd()
    backoff = backoff * 2
    if (backoff > 1000000) {
      backoff = 1000000
    }
  }

  // 8. Signal shutdown, reap the worker, and report the code. The join after
  //    `schedShutdown` guarantees no worker still touches scheduler or task
  //    state, the precondition for reading `mainExitCode`. `schedJoin`'s body
  //    for one worker, with this platform's clock/sleep/release called directly
  //    rather than passed (see `workerBody`).
  schedShutdown(sched)
  let ji = 0
  while (ji < started) {
    joinWorker(ptrOf(startDones) + ji, joinTimeoutNs)
    threadRelease(*(ptrOf(startHandles) + ji))
    ji = ji + 1
  }

  // 8b. Close the netpoller — `runtime/sched/`'s `NetPoller.deinit`, called from its
  //     `Scheduler.deinit`. AFTER the join, because the worker calls `pollDrain`
  //     on this descriptor from its own loop and closing it under a live poller
  //     is a use-after-close, not a leak. The process is about to exit either way,
  //     so this buys no resource back; it is here because the teardown ordering is
  //     the part that has to be right if this boot is ever reused.
  if (bootPollFd > 0) {
    pollClose(bootPollFd)
    bootPollFd = 0
  }
  // The write-interest descriptor, on the same terms (#1910): `pollDrain` reads
  // both, so both must outlive the join and both must be closed here.
  if (bootPollFdWrite > 0) {
    pollClose(bootPollFdWrite)
    bootPollFdWrite = 0
  }

  // 9. `BIT_GC_STATS`. After the join, so the worker cannot be mid-collection
  //    while the counters are read, and before the exit code goes back to the
  //    entry so it lands on stderr while the process still has one.
  if (rootEnvVerbose(false)) {
    statsReport()
  }
  return mainExitCode
}

// ---------------------------------------------------------------------------
// bit_rt_spawn — the whole spawn job (#1611)
// ---------------------------------------------------------------------------

// Publish the scheduler `boot` created so `bit_rt_spawn` can reach it. The
// SINGLE write path for `gSched` (mirroring `osSetArgs`), so the invariant
// "`gSched` names the live scheduler" is established in exactly one place.
// Exported so a driver that runs its own scheduler (the #1611 end-to-end test)
// can bind it before spawning.
export @nosplit fn spawnBindScheduler(schedAddr: int) {
  gSched = schedAddr
}

// `bit_rt_spawn(fn_ptr, arg)` — the WHOLE spawn job, under its bare ABI name
// since G2 (#1583). Codegen lowers the `spawn` keyword to
// `bit_rt_spawn(trampoline_code_ptr, thunk_data_ptr)` (compiler/lower.bit
// `lowerSpawn`): a code pointer plus one opaque data word — exactly this
// 2-argument signature (`entry: *byte`, `arg: int`; both C-representable, so no
// E0079). `runtime/root/`'s `bit_rt_spawn` is `g_sched.spawn(fn_ptr, arg)` =
// `Task.create` (map a stack + allocate the Task + build its entry context) then
// register and queue (runtime/sched/:1205). This is that composition in Bit:
//
//   1. recover the scheduler from `gSched` (`bit_rt_spawn` gets no `s`);
//   2. map the task's stack and carve its `schedStackBytes`-aligned window;
//   3. allocate the task control block;
//   4. `schedTaskInit` it with (entry, arg) — entry becomes the resume pc, arg
//      the `taskArg` word, the same pair `Task.create` records;
//   5. hand it to the scheduler (`schedSpawn` = register + queue).
//
// NOT `@nosplit`: it maps, and `mmap` is a `syscall` that E0075 forbids in a
// nosplit body. The stack and task block are RAW mappings (`mapPages`), never
// the GC heap — like `runtime/root/`'s `page_allocator.create(Task)`, and because the
// scheduler holds both by raw address and the collector reaches the task through
// the registry (`schedSpawn`'s `schedRegister`), not as a heap object. Each is
// mapped per spawn and not reclaimed here; a stack/task freelist is the
// sanctioned optimization (#1422), out of this wrapper's scope. A map failure or
// an unbound scheduler is unrecoverable, so — like `runtime/root/`'s
// `catch fatal("out of memory")` — this aborts rather than silently dropping the
// green thread.
export @nosplit @symbol("bit_rt_spawn") fn rtSpawn(entry: *byte, arg: int) {
  if (gSched == 0) {
    rootExit(70)
  }
  let s = taskAt(gSched)

  // A `schedStackBytes` usable stack, guarded below — the same carve `boot` uses
  // for the main task's stack, done dynamically here.
  let stackBase = mapGuardedStack(schedStackBytes)
  if (stackBase == 0) {
    rootExit(70)
  }

  // The task control block, off the GC heap (runtime/root/'s `page_allocator`). One
  // word wider than a plain block: `taskSpawnEntry` holds the real compiler
  // entry so `schedSpawnTrampoline` can call it with `arg` in the first-argument
  // register (#1622). The pc slot goes to that trampoline, not to `entry` — a
  // compiler `spawn$trampoline` takes its thunk in a register and returns, which
  // a bare direct branch cannot satisfy.
  let taskAddr = mapPages((taskWords + 1) * 8)
  if (taskAddr == 0) {
    rootExit(70)
  }

  *(taskAt(taskAddr) + taskSpawnEntry) = int(entry)
  schedTaskInit(taskAt(taskAddr), stackBase, schedStackBytes,
                entryOf(schedSpawnTrampoline), arg)
  schedSpawn(s, taskAddr)
}

// Upper bound on the envp walk (Power of 10 rule 2). A well-formed `envp` hits
// its NULL terminator far sooner; this only caps a malformed (unterminated)
// block, matching `../os.bit`'s `osMaxEnvCount`. Reaching it means no terminator
// was found, so there is no trustworthy auxv and 0 ("none") is returned.
const maxEnvpWalk: int = 65536

// The auxv array's address, found by walking `envp` (pointer-width entries from
// `envpBase`) to its NULL terminator: the auxv starts at the word immediately
// after it. `runtime/root/` gets the same address from `std.mem.span(envp).len`; this
// is that span, done explicitly. Returns 0 if no terminator is found within the
// bound — a malformed stack, where refusing to hand back a wild pointer is the
// safe answer (`runtime/auxv` then reports every key "absent").
@nosplit fn auxvFromEnvp(envpBase: int): int {
  let i = 0
  while (i < maxEnvpWalk) {
    if (loadWord(envpBase + i * 8) == 0) {
      return envpBase + (i + 1) * 8
    }
    i = i + 1
  }
  return 0
}

// Install the MAIN thread's static TLS block, so any `@threadlocal` the main
// green thread reads — and, before the #1369 archive swap, every thread-local
// the previous runtime carried (`runtime/root/`'s `g_mutator`/`pending_err`/...
// and `runtime/sched/`'s `Worker.tls`) — resolves against a real thread pointer.
// This is `initLinuxTls`, which installs the static TLS block.
//
// `initStatic` folds four steps together; they are explicit here because this
// runtime's `tlsPrepare` (../../thread/linux/tls.bit) already exists for the
// worker path and takes a caller-supplied area rather than allocating one:
//   1. size the block from this image's `PT_TLS` (`tlsAreaBytes`);
//   2. allocate it — a RAW `mmap`, not the GC heap, since this runs before
//      `rootBindMemory`; a permanent mapping, since the main thread lives for the
//      whole process (`runtime/root/` uses a static buffer / permanent mmap likewise);
//   3. fill it and derive the thread pointer (`tlsPrepare`, the exact routine a
//      worker uses — one layout for both);
//   4. install the thread pointer (`setThreadPointer`, arch-specific asm).
//
// MUST run AFTER `osSetAuxv` (steps 1 and 3 read `AT_PHDR`/`AT_PHNUM` out of the
// auxv cell) and BEFORE any worker OS thread or any `@threadlocal` access. On a
// well-formed image produced by this project's linker `PT_TLS` is always present,
// so this always installs; a `tlsUnavailable` result means the auxv/phdr table
// could not be read — a malformed stack the process cannot run on regardless — so
// it returns without installing rather than mapping against a guessed geometry,
// the same refuse-don't-guess stance `tlsAreaBytes` takes.
fn initLinuxTls() {
  let bytes = tlsAreaBytes()
  if (bytes == tlsUnavailable) {
    return
  }
  let area = mapPages(bytes)
  if (area == 0) {
    return
  }
  let tp = tlsPrepare(area)
  if (tp == 0) {
    return
  }
  setThreadPointer(tp)
}

// The Linux stack-walk entry `_start` tail-calls. `sp` points at the raw initial
// stack the kernel built: `[argc][argv0]..[argvN-1][NULL][envp0]..[NULL][auxv]`.
// Captures argc/argv/envp through the SINGLE sanctioned path
// (`bit_rt_port_root_os_set_args`), installs the main thread's static TLS from the
// captured auxv, boots, and exits with the returned code. `runtime/root/`'s
// `rtStartMain` (runtime/root/:2040) in full.
//
// Reached by `_start` taking `entryOf(rtStartMain)` as an `asm` input operand —
// a real reference, not a symbolic branch target (§11.6 forbids those) — which
// is what keeps this function (and thus `bit_main`) live under `_start`'s own
// liveness, exactly as `runtime/root/` ties the two with `"r" (&rtStartMain)`.
fn rtStartMain(sp: int) {
  let argc = loadWord(sp)
  let argvBase = sp + 8
  // envp starts past argv[0..argc) and its own NULL terminator.
  let envpBase = argvBase + (argc + 1) * 8
  osSetArgs(argc, argvBase, envpBase)
  // The ELF auxv array follows envp's own NULL terminator immediately — standard
  // Linux ABI, no padding, both plain pointer-width arrays (`runtime/root/`'s
  // `initLinuxTls` auxv_addr derivation). This is a CONTINUATION of the single
  // capture above, not a second path: the same stack walk, one step further.
  osSetAuxv(auxvFromEnvp(envpBase))
  // Install the main thread's TLS from the auxv just captured — BEFORE `boot`
  // brings up any worker or reaches any `@threadlocal`. `runtime/root/` orders these
  // identically (`initLinuxTls` immediately after the auxv address is known).
  initLinuxTls()
  let code = boot()
  rootExit(code)
}

// `_start`: the process entry the linker points `e_entry` at. Naked — there is
// no caller, no return address, no valid frame — so it hands off to the ordinary
// `rtStartMain` before anything the C convention assumes is set up. Hand-encoded
// instruction bytes (x64) / words (arm64), verified by disassembly, NOT the
// build going green (§11.6: no text assembler exists).
//
// x86_64:  31 ED        xor  ebp, ebp     ; mark outermost frame
//          48 89 E7     mov  rdi, rsp     ; capture kernel sp (-> argc) BEFORE realign
//          48 83 E4 F0  and  rsp, -16     ; ABI 16-byte stack alignment
//          FF D0        call rax          ; rax = entryOf(rtStartMain)
//          F4           hlt               ; rtStartMain is noreturn; unreachable
//
// aarch64: 910003E0     mov  x0, sp       ; add x0, sp, #0 — pass kernel sp
//          D63F0020     blr  x1           ; x1 = entryOf(rtStartMain)
//          D4200000     brk  #0           ; unreachable
//
// The `input` materialises `entryOf(rtStartMain)` into rax (x64) / x1 (arm64)
// before the block; the compiler's naked epilogue (a dead ret) trails the
// hlt/brk, matching `runtime/root/`'s `hlt`/`brk #0` + unreachable.
//
// PINNED to the literal `_start`, and that is a documented special case rather
// than an ordinary ABI name: the linker designates the entry point BY NAME,
// resolving `_start` into `e_entry` (ABI.md §9). It cannot go under a
// `bit_rt_root_` prefix like every other runtime export, because the prefixed
// name would no longer be the one the linker looks for.
//
// This was a placeholder until G2 (#1583) dropped the `_root` infix. Before
// that a second `_start` lived in the archive, so a literal pin here was a
// DuplicateSymbol for any program importing this module (tests/stress/sigpipe*).
@naked @symbol("_start") fn startEntry() {
  return asm volatile {
    x64   { 0x31, 0xED, 0x48, 0x89, 0xE7, 0x48, 0x83, 0xE4, 0xF0, 0xFF, 0xD0, 0xF4 }
    arm64 { 0x910003E0, 0xD63F0020, 0xD4200000 }
    input arm64 x1 x64 rax = entryOf(rtStartMain)
  }
}
