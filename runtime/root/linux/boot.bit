// Linux process entry and boot sequence for the SEAM 3 remainder (#1608): the
// `_start` stub, the `rtStartMain` stack-walker it tail-calls, and `boot` — the
// Bit form of `runtime/root.zig`'s `startEntry`/`rtStartMain`/`boot`
// (root.zig:1974-2130). This file OWNS the process from the first instruction
// the kernel jumps to until the collector and scheduler are up, the user's
// `bit_main` has run as the first green thread, and the runtime is torn down.
//
// ---------------------------------------------------------------------------
// WHY THIS LIVES IN THE PLATFORM MODULE, NOT PLATFORM-FREE `runtime/root`
// ---------------------------------------------------------------------------
//
// `boot` names platform seams a platform-free module may not even DECLARE:
// `mapPages` (raw `mmap`), `threadStart`/`threadRelease` (raw `clone`),
// `parkSleepNs`/`parkMonoNs` (raw `clock_nanosleep`/`clock_gettime`) — all
// `syscall`, which SPEC §11.8 rejects targeting Darwin. So `boot` cannot sit in
// `runtime/root` (that module is emitted for aarch64-macos too) and is instead
// duplicated function-for-function with ../darwin/boot.bit, exactly as
// ./signal.bit is duplicated with ../darwin/signal.bit: a divergence between
// the two is then a real platform difference, not a spelling one. The two boots
// differ in precisely two places — the entry ABI (`_start` reads the raw kernel
// stack; `machoMain` gets C args in registers) and the seam bindings.
//
// THIS MODULE EMITS `--freestanding` (#1628), which costs it two things and is
// worth stating because both look like gratuitous verbosity otherwise:
//
//   - IT BUILDS NO FUNCTION VALUE. A function value is a `(code, env)` cell on
//     the managed heap, so a module that makes one needs a `TypeInfo` descriptor
//     that a freestanding object may not carry (§17.6). Every platform seam here
//     is therefore bound by DIRECT CALL — `schedWorkerRunBare` not
//     `schedWorkerRun(w, schedNoTimers, schedNoPoller)`, `schedStartArm` +
//     `threadStart` not `schedStart(..., threadStart)`, `joinWorker` not
//     `schedJoin(..., parkSleepNs, parkMonoNs, threadRelease)`.
//   - EVERY CROSS-MODULE CALLEE IT NAMES IS `@symbol`-PINNED (SPEC §11.9,
//     ABI.md §9), under port-internal `bit_rt_port_*` names: a freestanding
//     object may leave a reference undefined only under a name the callee's own
//     object defines, and a mangled `m<id>$f` is never that name.
//
// ---------------------------------------------------------------------------
// AUXV CAPTURE (#1617) AND MAIN-THREAD STATIC-TLS INSTALL (#1608)
// ---------------------------------------------------------------------------
//
// `root.zig`'s `rtStartMain` does two auxv-adjacent things: it CAPTURES the ELF
// auxiliary vector off the initial stack, and it INSTALLS the main thread's
// static TLS from it (`initLinuxTls`: AT_PHDR/AT_PHNUM -> PT_TLS ->
// `tls.initStatic`). #1617 landed the first: `rtStartMain` below walks past
// `envp`'s NULL to the auxv array and stores its address through the single
// sanctioned setter `bit_rt_port_root_os_set_auxv`, into the Bit cell
// `../os.bit`'s `gAuxv` owns. The ABI reader `bit_rt_auxv` (now Bit-provided,
// ABI.md §19) hands it back, so `runtime/auxv`'s `getauxval` and a spawned
// thread's `tlsPrepare` (../../thread/linux/tls.bit) read real auxv data.
//
// #1608 landed the second: `initLinuxTls` below sizes, maps, fills and installs
// the MAIN thread's own static TLS block from that captured auxv, reusing the
// worker path's `tlsAreaBytes`/`tlsPrepare` and a new `setThreadPointer`
// (arch_prctl on x86_64, `msr tpidr_el0` on aarch64 — ../../thread/linux/tls.bit).
// `rtStartMain` calls it after the auxv capture and before `boot`, mirroring
// `root.zig` exactly. With that, both the main thread and every worker thread run
// on a correctly-installed thread pointer.
//
// The archive swap (#1369) is what makes THIS the live entry; before it, the Zig
// `rtStartMain`/`g_auxv`/`initLinuxTls` remain live and this path is exercised by
// freestanding emit + the `getauxval` read-back + the TP-set disassembly + the
// PT_TLS-parse logic isolation, not by a running binary.
//
// Nothing here is `@nosplit`: `boot` allocates (it maps the heap) and runs
// before the stack-guard machinery exists, and `@nosplit` rejects `syscall`
// anyway (E0075). `mainTrampoline` calls the user's `bit_main`, arbitrary work
// that must reach safepoints, so it is not `@nosplit` either.

import { mapPages } from "../../alloc/linux"
import { threadStart, threadRelease } from "../../thread/linux"
import { tlsAreaBytes, tlsPrepare, tlsUnavailable, setThreadPointer } from "../../thread/linux"
import { schedStartArm } from "../../thread"
import { parkSleepNs } from "../../park/linux"
import { parkMinBackoffNs, parkNextBackoff } from "../../park"
import {
  schedInit, schedTaskInit, schedRegister, schedSpawn, schedShutdown,
  schedWorkerAt, schedWorkerRunBare,
  schedTaskExit, dqPushBottom, taskAt, taskWords,
  schedStackBytes, schedStackAligned, wkDeque,
  schedSpawnTrampoline, taskSpawnEntry,
} from "../../sched"
import { rootBindMemory, rootInit, rootConfigureFromEnv, rootEnvMarkStack, rootEnvVerbose, rootStatOom, osSetArgs, osSetAuxv } from "../../root"
import { rootGcAddr } from "../../root"
import { chanBootBind } from "../../chan"
import { stwBind, stwCollections, stwSwept, stwLiveObjects, stwAbandonedCount } from "../../stw"

// `loadWord` (../../gc) and `parkMonoNs` (../../park/linux) are already imported
// by sibling ./io.bit and ./time.bit; siblings share one module scope, so they
// are used here directly — re-importing either is E0042.

// The per-program entry the compiled user object defines (ABI.md §10). Reachable
// as an `extern function` since #1614 whitelisted `bit_main` in the E0078
// archive gate; it resolves to `U bit_main` at final program link, exactly as
// `root.zig`'s `extern fn bit_main` does. This is the ONE sanctioned extern in
// the root tree that names no archive-resident symbol.
extern function bit_main(): i32

// ---------------------------------------------------------------------------
// Boot-time storage (single-worker, ABI.md §5)
// ---------------------------------------------------------------------------
//
// ABI.md §5 pins the scheduler to one worker, so exactly one worker block, one
// green-task block and one task stack are needed. All are module-level and
// unlocked, sound because `boot` fills them once on the boot thread BEFORE the
// single worker's OS thread exists (the register-before-steal precondition
// `schedStart` documents). Scalar `i64`/`i32` arrays are never scanned by the
// collector (rule 1). Sizes are the exported layout widths: `schedWords` = 16,
// `workerWords` = 292, a task block = 32 words.
let schedBlock: [16]i64
let workerBlock: [292]i64
let mainTaskBlock: [32]i64

// The main green thread's stack: one 64KiB stack, 64KiB-aligned. Carved from a
// 128KiB region so an aligned 64KiB window always fits wherever the array
// landed — the ../../../tests/stress/schedpool carve, applied to a single stack.
let taskStackArea: [16384]i64

// The three areas `schedStart`/`schedJoin` fill and reap, sized for one worker:
// one 2-word argument block, one done word, one handle slot.
let startArgs: [2]i64
let startDones: [1]i32
let startHandles: [1]i64

// The main green thread's result, published across the boot thread's poll-wait.
// `mainExitCode` is the process exit code; `mainDone` is the release flag the
// poll loop acquires on — the Bit form of `root.zig`'s `MainRun{exit_code,done}`.
let mainExitCode: int = 0
let mainDone: i32 = 0

// The process-global scheduler address, the Bit form of `sched.zig`'s `g_sched`.
// The rest of this runtime is strictly caller-owned — every scheduler path takes
// an explicit `s` — but `bit_rt_spawn(fn_ptr, arg)` carries no scheduler
// argument (ABI.md §10), so the wrapper that implements it must recover the
// scheduler from process-global state, exactly as `root.zig`'s
// `g_sched.spawn(fn_ptr, arg)` does. `boot` publishes the block address here
// once `schedInit` has run (via `spawnBindScheduler`); `rtSpawn` reads it.
// Untraced scalar module state (rule 1) — it holds a raw block address, never a
// GC object.
let gSched: int = 0

// The channel reserve descriptor (`reserveWords` = 3) and root-scan registry
// block (`chanRegWords` = 2) `runtime/chan`'s `chan_make` allocates and registers
// through. Owned here — `boot` can `ptrOf` a module array, chan's `@nosplit`/
// freestanding module cannot (E0075) — and their addresses bound into chan once
// at boot via `chanBootBind` (the `worldBind` pattern). Untraced scalar arrays,
// never scanned (rule 1). Sizes are chan's exported layout widths, hardcoded as
// literals exactly as `schedBlock`/`workerBlock` above are.
let chanReserveDesc: [3]i64
let chanRegBlock: [2]i64

// Heap geometry. 8 MiB object arena + 128 KiB span index, `runtime/root`'s own
// proven bring-up sizes (tests/stress/rootbit). `mapPages` rounds to the true
// page size; 4096 is passed as the nominal page size `rootBindMemory` records,
// matching every other bring-up.
const arenaWords: int = 1048576
const indexWords: int = 16384
const pageSize: int = 4096
const markStack: int = 4096

// GC tuning defaults (`gc.zig`'s `Config{}`). `root.zig`'s `configFromEnv` reads
// BIT_GC/BIT_GC_STATS/BIT_GC_MIN_KB/... over these; that env parse needs a
// string-construction helper on the boot path and is a documented follow-up, so
// `boot` installs the defaults in the same sequence slot for now.
const minTrigger: int = 65536
const growthPct: int = 200

// Backing size of the channel reserve `chan_make` bump-allocates handles and
// rings out of: 1 MiB, process-lifetime. v1 has no channel-free primitive
// (ABI.md §11), so this is the process's whole channel budget — a fixed,
// startup-mapped pool (Power-of-10 rule 3: no unbounded allocation after boot),
// generous next to any realistic channel population. `mapPages` rounds to the
// true page size.
const chanReserveBytes: int = 1048576

// Join deadline: generous next to real teardown (a worker leaves `schedWorkerRun`
// microseconds after shutdown is signalled) and finite so a wedge fails rather
// than hangs. Matches the stress harnesses' `WAIT_NS`.
const joinTimeoutNs: int = 15000000000

// Round `addr` up to the next 64KiB stack boundary (`schedStackAligned`'s
// contract). One add-and-mask, no allocation.
function alignUpStack(addr: int): int {
  let bumped = addr + schedStackBytes - 1
  return bumped - bumped % schedStackBytes
}

// The worker OS-thread entry: unpack the {worker address, done-word address}
// block `schedStart` armed, drive green tasks until shutdown, then clear the
// done word so `joinWorker` observes the worker has left. The no-timer/no-poller
// seam is the proven single-worker configuration (the netpoller is unported —
// #1600); wiring real timers/netpoll through `schedWorkerRun`'s `nowFn`/`pollFn`
// is a follow-up the scheduler core already admits. Same shape as
// `poolWorkerEntry`.
//
// `schedWorkerRunBare` rather than `schedWorkerRun(w, schedNoTimers,
// schedNoPoller)`: the two are behaviourally identical, but the seam-carrying
// form takes function VALUES, and a function value is a `(code, env)` cell on
// the managed heap — which is exactly what `--freestanding` refuses to emit a
// descriptor for (§17.6, #1628). Every seam in this file is bound by DIRECT
// CALL for that reason.
function workerBody(arg: *byte): *byte {
  let block = taskAt(int(arg))
  let workerAddr = *block
  let doneAddr = *(block + 1)

  schedWorkerRunBare(taskAt(workerAddr))

  let z: *i32 = nil
  atomicStore(z + doneAddr / 4, i32(0))
  return nil
}

// Trip bound for `joinWorker`, `runtime/thread`'s `JOIN_MAX_POLLS` unchanged:
// the join is finite by construction even if the deadline clock misbehaves, so
// a wedged worker fails the boot rather than hanging it (Power of 10, rule 2).
const joinMaxPolls: int = 100000

// `runtime/thread`'s `threadJoin` for THE one worker this runtime starts, with
// the platform clock and sleep called directly instead of taken as function
// values — this module must emit `--freestanding` and so cannot build one (see
// `workerBody`). Same contract: poll the done word against a monotonic deadline
// with bounded exponential backoff; true iff the worker finished in time.
function joinWorker(done: *i32, timeoutNs: int): bool {
  // A non-positive timeout still gets one look at the word, so a join on an
  // already-finished worker succeeds rather than reporting a spurious timeout.
  if (atomicLoad(done) == i32(0)) {
    return true
  }
  let deadline = parkMonoNs() + timeoutNs
  let backoff = parkMinBackoffNs
  let i = 0
  while (i < joinMaxPolls) {
    if (atomicLoad(done) == i32(0)) {
      return true
    }
    if (parkMonoNs() >= deadline) {
      return false
    }
    parkSleepNs(backoff)
    backoff = parkNextBackoff(backoff)
    i = i + 1
  }
  return false
}

// The first green thread: run the user's `bit_main`, publish its exit code, then
// leave the task through `schedTaskExit`. `root.zig`'s `mainTrampoline`. Not
// `@nosplit` — `bit_main` is the whole user program and must reach safepoints.
function mainTrampoline() {
  mainExitCode = int(bit_main())
  atomicStore(ptrOf(mainDone), i32(1))
  schedTaskExit()
}

// ---------------------------------------------------------------------------
// The `BIT_GC_STATS` line (#1639) — kept identical in ../darwin/boot.bit
// ---------------------------------------------------------------------------
//
// `gc.zig`'s `collect` prints `[bit-gc] collection N: ...` per collection. THIS
// PORT CANNOT PRINT FROM THERE: every function on the collection path is
// `@nosplit`, which admits no `print`, no `extern` call and no `syscall`
// (`runtime/gc` deviation 6, E0075). So the flag's OWNER is boot, which is
// ordinary Bit sitting next to ./io.bit's write primitive, and the shape becomes
// one SUMMARY line at exit instead of one line per collection.
//
// That deviation is worth naming precisely, because #1639 measured the missing
// output and the missing collections together: a Bit-runtime binary printed
// nothing under `BIT_GC_STATS=1` for TWO independent reasons, and fixing only
// the wiring would still have printed nothing. `swept=` and `live=` are on the
// line for the same reason — a count alone cannot tell a collector that
// reclaims from one that marks everything.
//
// Text is emitted through `writeConst` (packed byte constants) rather than
// string literals: this module is `--freestanding` (#1628) and builds no
// managed string. The decimals go through ./os.bit's `osWriteDecimal`, a
// sibling.

// The line is assembled in MODULE STATE and written in ONE call, and it
// allocates nothing. That is a hard requirement, not tidiness: this runs on the
// boot thread after the worker is joined, i.e. after a whole run's worth of
// collection, and `[]int(n)` there returned 0 on roughly 40% of runs at
// 65k-collection density — a null the decimal writer then stored through
// (`strb w19, [x20]`, x20 = 4). ../io.bit's `writeConst` allocates too, so it is
// not used here either. `panicWrite` states the same rule for the same reason:
// the one path that must work when allocation is what failed cannot allocate.
// The residual question the null raised — whether a boot-thread allocation can
// fail after a heavy collected run — is filed separately (#1643); it is not
// reached from here any more.
//
// 128 bytes: the fixed text is 46, and four i64 decimals are at most 80.
let statsBuf: [16]i64

// Append `nbytes` low bytes of the packed constant `word` at byte offset `at`,
// returning the new offset. Packed constants rather than string literals because
// this module is `--freestanding` (#1628) and builds no managed string.
function statsConst(at: int, word: int, nbytes: int): int {
  let base = int(ptrOf(statsBuf))
  let w = word
  let i = 0
  while (i < nbytes) {
    storeByte(base + at + i, w & 255)
    w = w >> 8
    i = i + 1
  }
  return at + nbytes
}

// Append `v` in decimal at byte offset `at`, returning the new offset.
function statsNum(at: int, v: int): int {
  return at + osWriteDecimal(int(ptrOf(statsBuf)) + at, v)
}

// `[bit-gc] collections=<n> swept=<n> live=<n> abandoned=<n>`, on stderr, once,
// only under `BIT_GC_STATS`. Called after `main` has finished and the worker is
// reaped, so nothing can be collecting while it reads.
function statsReport() {
  let at = statsConst(0, 6729335713145905755, 8)   // "[bit-gc]"
  at = statsConst(at, 8386658447444108064, 8)      // " collect"
  at = statsConst(at, 263929622377, 5)             // "ions="
  at = statsNum(at, stwCollections())
  at = statsConst(at, 17297999666836256, 7)        // " swept="
  at = statsNum(at, stwSwept())
  at = statsConst(at, 67505987611680, 6)           // " live="
  at = statsNum(at, stwLiveObjects())
  at = statsConst(at, 7957689491829973280, 8)      // " abandon"
  at = statsConst(at, 4023397, 3)                  // "ed="
  at = statsNum(at, stwAbandonedCount())
  at = statsConst(at, 28448, 2)                    // " o"
  at = statsConst(at, 4025711, 3)                  // "om="
  at = statsNum(at, rootStatOom())
  at = statsConst(at, 10, 1)                       // "\n"
  rootWriteAll(stderrFd, int(ptrOf(statsBuf)), at)
}

// The OS page seam `runtime/gc/mem.bit` reaches through to grow the heap
// (#1638). The collector must compile for all three targets, so it cannot
// contain a `syscall` or a platform `extern function` of its own; it names this
// symbol and lets the link resolve it.
//
// PINNED (ABI.md §9) with the `bit_rt_root_` placeholder every Bit port of a
// `root.zig` symbol carries, for exactly the reason that prefix exists: while
// `root.zig` is still in `libbitrt.a` its own `bit_rt_map_pages` holds the real
// name, and claiming it here would fail every link with DuplicateSymbol. G2's
// rename (#1583) strips the infix, at which point THIS becomes the definition
// the collector binds to and the Zig one is gone.
//
// A wrapper rather than pinning `../../alloc/{linux,darwin}`'s `mapPages`
// directly: that module is compiled from source by any program importing this
// one, so a pin there would collide with `root.zig`'s definition in the same
// link (`tests/stress/roothostdarwin` is such a program, and is how that was
// found). Here the collision cannot arise, because this module and `root.zig`
// are the two halves the prefix already keeps apart.
export @nosplit @symbol("bit_rt_root_map_pages") function rtMapPages(nbytes: int): int {
  return mapPages(nbytes)
}

// Boot the collector and scheduler, run `bit_main` as the first green thread,
// wait for it, tear down, and return the process exit code. THE ORDER IS
// LOAD-BEARING and mirrors `root.zig`'s `boot` (root.zig:1974-2011) exactly:
// heap before collector (the collector takes the heap's address), collector
// before scheduler, scheduler populated on the boot thread before any worker
// exists, then start -> wait -> shutdown -> join. A wrong order is a hang or
// heap corruption, not a compile error. 70 (EX_SOFTWARE) on any setup failure,
// the boot path's non-recoverable exit code.
function boot(): int {
  // 1. Ignore SIGPIPE process-wide (./signal.bit, this module).
  ignoreSigpipe()

  // 2. Map and bind the heap, then start the collector and type descriptors.
  let spanBytes = arenaWords * 8
  let idxBytes = indexWords * 8
  let span = mapPages(spanBytes)
  let idx = mapPages(idxBytes)
  if (span == 0 || idx == 0) {
    return 70
  }
  rootBindMemory(span, spanBytes, idx, idxBytes, pageSize)
  if (!rootInit(rootEnvMarkStack(markStack))) {
    return 70
  }

  // 3. GC config from the environment (BIT_GC/BIT_GC_MIN_KB/BIT_GC_GROWTH_PCT/
  //    BIT_GC_STATS over the defaults), the Bit port of `root.zig`'s
  //    `configFromEnv`. `osSetArgs` ran in `rtStartMain` before `boot`, so `envp`
  //    is captured by now.
  rootConfigureFromEnv(true, false, minTrigger, growthPct, false)

  // 4. Scheduler over the single worker block. Publish it for `bit_rt_root_spawn`
  //    the moment it exists, so a `spawn` from anywhere in the program can find
  //    it — the Bit form of `root.zig` assigning the module-global `g_sched`.
  let sched: *i64 = ptrOf(schedBlock)
  schedInit(sched, int(ptrOf(workerBlock)), 1)
  spawnBindScheduler(int(sched))

  // 4b. Provision the channel reserve + root-scan registry for
  //     `bit_rt_root_chan_make` (#1613), the worldBind pattern. Done AFTER the
  //     scheduler exists because `chan_make` stores it into every channel; map
  //     the process-lifetime reserve pages and hand chan the reserve descriptor,
  //     the registry block and the scheduler. A map failure is unrecoverable, the
  //     same 70 (EX_SOFTWARE) as the heap map above.
  let chanMem = mapPages(chanReserveBytes)
  if (chanMem == 0) {
    return 70
  }
  chanBootBind(int(ptrOf(chanReserveDesc)), chanMem, chanReserveBytes,
               int(ptrOf(chanRegBlock)), int(sched))

  // 4c. Arm the STOP-THE-WORLD (#1639). `runtime/stw`'s poll — the body the
  //     `bit_rt_safepoint` shim every loop back edge calls hands its snapshot to
  //     — refuses to collect until all three root sources are reachable
  //     (`stwCanCollect`), so without this call the collector half is present,
  //     linked, and permanently dormant: 0 collections, no diagnostic, correct
  //     output. Must come after `chanBootBind` (the registry block is only
  //     meaningful once chan owns it) and after `schedInit`. `runtime/root`
  //     itself cannot make this call — `runtime/chan` imports it, so importing
  //     `runtime/stw` from there is an import cycle (E0044) — which is why the
  //     bind lives in the platform boot, the leaf that already imports all three.
  //     Identical to ../darwin/boot.bit's.
  stwBind(rootGcAddr(), int(sched), int(ptrOf(chanRegBlock)))

  // 5. Place `bit_main`'s task on worker 0's deque. Register BEFORE queueing so
  //    the worker can never steal a task the registry does not yet know (the
  //    collector must find every live stack).
  let stackBase = alignUpStack(int(ptrOf(taskStackArea)))
  if (!schedStackAligned(stackBase)) {
    return 70
  }
  let task = int(ptrOf(mainTaskBlock))
  let t: *i64 = ptrOf(mainTaskBlock)
  schedTaskInit(t, stackBase, schedStackBytes, entryOf(mainTrampoline), 0)
  schedRegister(sched, task)
  if (!dqPushBottom(schedWorkerAt(sched, 0) + wkDeque, task)) {
    return 70
  }

  // 6. Bring the worker up on a real OS thread. `schedStart`'s per-worker arming
  //    (`schedStartArm`) then this platform's `threadStart` called DIRECTLY —
  //    `schedStart` itself takes the spawner as a function value, which this
  //    module may not build (see `workerBody`). One worker, so the pool's loop
  //    collapses to a single iteration and nothing else of it is needed.
  let startArg = schedStartArm(sched, 0, ptrOf(startArgs), ptrOf(startDones))
  let handle = threadStart(entryOf(workerBody), startArg, ptrOf(startDones))
  *ptrOf(startHandles) = handle
  if (handle == 0) {
    return 70
  }

  // 7. This OS thread is not a worker, so it waits for `main` the way any
  //    external caller would: poll with bounded exponential backoff, the same
  //    shape as `sched.zig`'s idle loop. Unbounded by design — it waits for the
  //    program itself to finish.
  let backoff = 1000
  while (atomicLoad(ptrOf(mainDone)) == i32(0)) {
    parkSleepNs(backoff)
    backoff = backoff * 2
    if (backoff > 1000000) {
      backoff = 1000000
    }
  }

  // 8. Signal shutdown, reap the worker, and report the code. The join after
  //    `schedShutdown` guarantees no worker still touches scheduler or task
  //    state, the precondition for reading `mainExitCode`. `schedJoin`'s body
  //    for one worker, with this platform's clock/sleep/release called directly
  //    rather than passed (see `workerBody`).
  schedShutdown(sched)
  joinWorker(ptrOf(startDones), joinTimeoutNs)
  threadRelease(*ptrOf(startHandles))

  // 9. `BIT_GC_STATS`. After the join, so the worker cannot be mid-collection
  //    while the counters are read, and before the exit code goes back to the
  //    entry so it lands on stderr while the process still has one.
  if (rootEnvVerbose(false)) {
    statsReport()
  }
  return mainExitCode
}

// ---------------------------------------------------------------------------
// bit_rt_spawn — the whole spawn job (#1611)
// ---------------------------------------------------------------------------

// Publish the scheduler `boot` created so `bit_rt_root_spawn` can reach it. The
// SINGLE write path for `gSched` (mirroring `osSetArgs`), so the invariant
// "`gSched` names the live scheduler" is established in exactly one place.
// Exported so a driver that runs its own scheduler (the #1611 end-to-end test)
// can bind it before spawning.
export function spawnBindScheduler(schedAddr: int) {
  gSched = schedAddr
}

// `bit_rt_spawn(fn_ptr, arg)` — the WHOLE spawn job, under the ABI placeholder
// G2 (#1583) renames to `bit_rt_spawn`. Codegen lowers the `spawn` keyword to
// `bit_rt_spawn(trampoline_code_ptr, thunk_data_ptr)` (selfhost/lower.bit
// `lowerSpawn`): a code pointer plus one opaque data word — exactly this
// 2-argument signature (`entry: *byte`, `arg: int`; both C-representable, so no
// E0079). `root.zig`'s `bit_rt_spawn` is `g_sched.spawn(fn_ptr, arg)` =
// `Task.create` (map a stack + allocate the Task + build its entry context) then
// register and queue (sched.zig:1205). This is that composition in Bit:
//
//   1. recover the scheduler from `gSched` (`bit_rt_spawn` gets no `s`);
//   2. map the task's stack and carve its `schedStackBytes`-aligned window;
//   3. allocate the task control block;
//   4. `schedTaskInit` it with (entry, arg) — entry becomes the resume pc, arg
//      the `taskArg` word, the same pair `Task.create` records;
//   5. hand it to the scheduler (`schedSpawn` = register + queue).
//
// NOT `@nosplit`: it maps, and `mmap` is a `syscall` that E0075 forbids in a
// nosplit body. The stack and task block are RAW mappings (`mapPages`), never
// the GC heap — like `root.zig`'s `page_allocator.create(Task)`, and because the
// scheduler holds both by raw address and the collector reaches the task through
// the registry (`schedSpawn`'s `schedRegister`), not as a heap object. Each is
// mapped per spawn and not reclaimed here; a stack/task freelist is the
// sanctioned optimization (#1422), out of this wrapper's scope. A map failure or
// an unbound scheduler is unrecoverable, so — like `root.zig`'s
// `catch fatal("out of memory")` — this aborts rather than silently dropping the
// green thread.
export @symbol("bit_rt_root_spawn") function rtSpawn(entry: *byte, arg: int) {
  if (gSched == 0) {
    rootExit(70)
  }
  let s = taskAt(gSched)

  // A `schedStackBytes` usable stack, carved 64KiB-aligned from a 2x region so an
  // aligned window fits wherever `mapPages` landed — the same carve `boot` uses
  // for the main task's stack, done dynamically here.
  let region = mapPages(schedStackBytes * 2)
  if (region == 0) {
    rootExit(70)
  }
  let stackBase = alignUpStack(region)
  if (!schedStackAligned(stackBase)) {
    rootExit(70)
  }

  // The task control block, off the GC heap (root.zig's `page_allocator`). One
  // word wider than a plain block: `taskSpawnEntry` holds the real compiler
  // entry so `schedSpawnTrampoline` can call it with `arg` in the first-argument
  // register (#1622). The pc slot goes to that trampoline, not to `entry` — a
  // compiler `spawn$trampoline` takes its thunk in a register and returns, which
  // a bare direct branch cannot satisfy.
  let taskAddr = mapPages((taskWords + 1) * 8)
  if (taskAddr == 0) {
    rootExit(70)
  }

  *(taskAt(taskAddr) + taskSpawnEntry) = int(entry)
  schedTaskInit(taskAt(taskAddr), stackBase, schedStackBytes,
                entryOf(schedSpawnTrampoline), arg)
  schedSpawn(s, taskAddr)
}

// Upper bound on the envp walk (Power of 10 rule 2). A well-formed `envp` hits
// its NULL terminator far sooner; this only caps a malformed (unterminated)
// block, matching `../os.bit`'s `osMaxEnvCount`. Reaching it means no terminator
// was found, so there is no trustworthy auxv and 0 ("none") is returned.
const maxEnvpWalk: int = 65536

// The auxv array's address, found by walking `envp` (pointer-width entries from
// `envpBase`) to its NULL terminator: the auxv starts at the word immediately
// after it. `root.zig` gets the same address from `std.mem.span(envp).len`; this
// is that span, done explicitly. Returns 0 if no terminator is found within the
// bound — a malformed stack, where refusing to hand back a wild pointer is the
// safe answer (`runtime/auxv` then reports every key "absent").
function auxvFromEnvp(envpBase: int): int {
  let i = 0
  while (i < maxEnvpWalk) {
    if (loadWord(envpBase + i * 8) == 0) {
      return envpBase + (i + 1) * 8
    }
    i = i + 1
  }
  return 0
}

// Install the MAIN thread's static TLS block, so any `@threadlocal` the main
// green thread reads — and, before the #1369 archive swap, every `threadlocal`
// the live Zig runtime carries (`root.zig`'s `g_mutator`/`pending_err`/... and
// `sched.zig`'s `Worker.tls`) — resolves against a real thread pointer. The Bit
// form of `root.zig`'s `initLinuxTls` -> `std.os.linux.tls.initStatic`.
//
// `initStatic` folds four steps together; they are explicit here because this
// runtime's `tlsPrepare` (../../thread/linux/tls.bit) already exists for the
// worker path and takes a caller-supplied area rather than allocating one:
//   1. size the block from this image's `PT_TLS` (`tlsAreaBytes`);
//   2. allocate it — a RAW `mmap`, not the GC heap, since this runs before
//      `rootBindMemory`; a permanent mapping, since the main thread lives for the
//      whole process (`root.zig` uses a static buffer / permanent mmap likewise);
//   3. fill it and derive the thread pointer (`tlsPrepare`, the exact routine a
//      worker uses — one layout for both);
//   4. install the thread pointer (`setThreadPointer`, arch-specific asm).
//
// MUST run AFTER `osSetAuxv` (steps 1 and 3 read `AT_PHDR`/`AT_PHNUM` out of the
// auxv cell) and BEFORE any worker OS thread or any `@threadlocal` access. On a
// well-formed image produced by this project's linker `PT_TLS` is always present,
// so this always installs; a `tlsUnavailable` result means the auxv/phdr table
// could not be read — a malformed stack the process cannot run on regardless — so
// it returns without installing rather than mapping against a guessed geometry,
// the same refuse-don't-guess stance `tlsAreaBytes` takes.
function initLinuxTls() {
  let bytes = tlsAreaBytes()
  if (bytes == tlsUnavailable) {
    return
  }
  let area = mapPages(bytes)
  if (area == 0) {
    return
  }
  let tp = tlsPrepare(area)
  if (tp == 0) {
    return
  }
  setThreadPointer(tp)
}

// The Linux stack-walk entry `_start` tail-calls. `sp` points at the raw initial
// stack the kernel built: `[argc][argv0]..[argvN-1][NULL][envp0]..[NULL][auxv]`.
// Captures argc/argv/envp through the SINGLE sanctioned path
// (`bit_rt_port_root_os_set_args`), installs the main thread's static TLS from the
// captured auxv, boots, and exits with the returned code. `root.zig`'s
// `rtStartMain` (root.zig:2040) in full.
//
// Reached by `_start` taking `entryOf(rtStartMain)` as an `asm` input operand —
// a real reference, not a symbolic branch target (§11.6 forbids those) — which
// is what keeps this function (and thus `bit_main`) live under `_start`'s own
// liveness, exactly as `root.zig` ties the two with `"r" (&rtStartMain)`.
function rtStartMain(sp: int) {
  let argc = loadWord(sp)
  let argvBase = sp + 8
  // envp starts past argv[0..argc) and its own NULL terminator.
  let envpBase = argvBase + (argc + 1) * 8
  osSetArgs(argc, argvBase, envpBase)
  // The ELF auxv array follows envp's own NULL terminator immediately — standard
  // Linux ABI, no padding, both plain pointer-width arrays (`root.zig`'s
  // `initLinuxTls` auxv_addr derivation). This is a CONTINUATION of the single
  // capture above, not a second path: the same stack walk, one step further.
  osSetAuxv(auxvFromEnvp(envpBase))
  // Install the main thread's TLS from the auxv just captured — BEFORE `boot`
  // brings up any worker or reaches any `@threadlocal`. `root.zig` orders these
  // identically (`initLinuxTls` immediately after the auxv address is known).
  initLinuxTls()
  let code = boot()
  rootExit(code)
}

// `_start`: the process entry the linker points `e_entry` at. Naked — there is
// no caller, no return address, no valid frame — so it hands off to the ordinary
// `rtStartMain` before anything the C convention assumes is set up. Hand-encoded
// instruction bytes (x64) / words (arm64), verified by disassembly, NOT the
// build going green (§11.6: no text assembler exists).
//
// x86_64:  31 ED        xor  ebp, ebp     ; mark outermost frame
//          48 89 E7     mov  rdi, rsp     ; capture kernel sp (-> argc) BEFORE realign
//          48 83 E4 F0  and  rsp, -16     ; ABI 16-byte stack alignment
//          FF D0        call rax          ; rax = entryOf(rtStartMain)
//          F4           hlt               ; rtStartMain is noreturn; unreachable
//
// aarch64: 910003E0     mov  x0, sp       ; add x0, sp, #0 — pass kernel sp
//          D63F0020     blr  x1           ; x1 = entryOf(rtStartMain)
//          D4200000     brk  #0           ; unreachable
//
// The `input` materialises `entryOf(rtStartMain)` into rax (x64) / x1 (arm64)
// before the block; the compiler's naked epilogue (a dead ret) trails the
// hlt/brk, matching `root.zig`'s `hlt`/`brk #0` + unreachable.
//
// PINNED `bit_rt_root_start` (ABI placeholder), NOT the literal `_start`: the
// live `libbitrt.a` is still the Zig runtime, which already defines `_start`
// (root.zig's `machoMain`/`startEntry` export). Any program that imports this
// platform module (e.g. tests/stress/sigpipe* for `ignoreSigpipe`) links that
// archive, so a literal `_start` here is a DuplicateSymbol at link — the exact
// reason every ABI name in this tree waits under a `bit_rt_root_` placeholder.
// G2 (#1583) / the #1369 archive swap claims the real `_start` entry name; the
// entry is a documented special case there (the linker designates `_start` as
// `e_entry` by name — ABI.md §9), not the plain `_root`-infix drop.
@naked @symbol("bit_rt_root_start") function startEntry() {
  return asm volatile {
    x64   { 0x31, 0xED, 0x48, 0x89, 0xE7, 0x48, 0x83, 0xE4, 0xF0, 0xFF, 0xD0, 0xF4 }
    arm64 { 0x910003E0, 0xD63F0020, 0xD4200000 }
    input arm64 x1 x64 rax = entryOf(rtStartMain)
  }
}
