// SEAM 5a of the runtime port (#1578): the arbitrary-precision unsigned
// integers backing the Dragon4 float-text formatter (`floatfmt.bit`) and the
// correctly-rounded parser (`floatparse.bit`). Ported verbatim from the
// `bench/fptext` experiment (#1539, 0 mismatches / 1,000,000 both directions,
// mutation-tested) — the algorithm is unchanged; only its home moved.
//
// Sibling file, same module as `root.bit` — no imports, no namespace change.
// Named to sort before `floatfmt`/`floatparse` so the module's bytewise
// filename concatenation (#1511) lowers these helpers before their callers.
//
// A bignum is a `[]u32` of little-endian limbs plus an explicit limb count that
// travels alongside it: every operation takes the count and returns the new one.
// Slices are passed by reference and mutated in place, so the count cannot live
// inside the slice without a second allocation per operation.
//
// `bigLimbs` is sized for the widest intermediate either direction needs: the
// parser shifts a 10^308-scaled numerator left by ~54 bits before dividing by a
// 10^324-scaled denominator, which is the worst case at roughly 2400 bits.

// Limb capacity of every bignum in this module.
export fn bigLimbs(): i64 { return 128 }

// A zeroed bignum of the standard capacity.
export fn bigNew(): []u32 { return []u32(bigLimbs()) }

// Sets `a` to `v`, returning the limb count.
export fn bigSetU64(a: []u32, v: u64): i64 {
  let i = 0
  while (i < len(a)) { a[i] = u32(0); i = i + 1 }
  a[0] = u32(v & u64(4294967295))
  a[1] = u32((v >> u64(32)) & u64(4294967295))
  return bigNorm(a, 2)
}

// Drops leading zero limbs. A zero value normalizes to a count of 0.
export fn bigNorm(a: []u32, an: i64): i64 {
  let n = an
  while (n > 0 && a[n - 1] == u32(0)) { n = n - 1 }
  return n
}

// Copies `src[0:n]` into `dst`, zeroing the rest. Returns `n`.
export fn bigCopy(dst: []u32, src: []u32, n: i64): i64 {
  let i = 0
  while (i < n) { dst[i] = src[i]; i = i + 1 }
  while (i < len(dst)) { dst[i] = u32(0); i = i + 1 }
  return n
}

// Compares `a` and `b`: -1 if a < b, 0 if equal, 1 if a > b.
export fn bigCmp(a: []u32, an: i64, b: []u32, bn: i64): i64 {
  if (an != bn) {
    if (an < bn) { return -1 }
    return 1
  }
  let i = an - 1
  while (i >= 0) {
    if (a[i] != b[i]) {
      if (a[i] < b[i]) { return -1 }
      return 1
    }
    i = i - 1
  }
  return 0
}

// `a += b`. Returns the new limb count.
export fn bigAdd(a: []u32, an: i64, b: []u32, bn: i64): i64 {
  let n = an
  if (bn > n) { n = bn }
  let carry = u64(0)
  let i = 0
  while (i < n || carry != u64(0)) {
    assert(i < len(a))
    let s = carry
    if (i < an) { s = s + u64(a[i]) }
    if (i < bn) { s = s + u64(b[i]) }
    a[i] = u32(s & u64(4294967295))
    carry = s >> u64(32)
    i = i + 1
  }
  if (i > n) { n = i }
  return bigNorm(a, n)
}

// `a -= b`, which requires `a >= b`. Returns the new limb count.
export fn bigSub(a: []u32, an: i64, b: []u32, bn: i64): i64 {
  assert(bigCmp(a, an, b, bn) >= 0)
  let borrow = u64(0)
  let i = 0
  while (i < an) {
    let av = u64(a[i])
    // Fold the borrow into the subtrahend rather than subtracting it from `av`
    // first: `av - borrow` wraps when the limb is zero, and the wrapped value
    // then compares as larger than the subtrahend, silently losing the borrow.
    // The sum is at most 2^32, so it cannot overflow the u64 it is held in.
    let sub = borrow
    if (i < bn) { sub = sub + u64(b[i]) }
    if (av < sub) {
      a[i] = u32((av + u64(4294967296) - sub) & u64(4294967295))
      borrow = u64(1)
    } else {
      a[i] = u32((av - sub) & u64(4294967295))
      borrow = u64(0)
    }
    i = i + 1
  }
  assert(borrow == u64(0))
  return bigNorm(a, an)
}

// `a *= m` for a single-limb `m`. Returns the new limb count.
export fn bigMulSmall(a: []u32, an: i64, m: u32): i64 {
  let carry = u64(0)
  let i = 0
  while (i < an) {
    let p = u64(a[i]) * u64(m) + carry
    a[i] = u32(p & u64(4294967295))
    carry = p >> u64(32)
    i = i + 1
  }
  let n = an
  while (carry != u64(0)) {
    assert(n < len(a))
    a[n] = u32(carry & u64(4294967295))
    carry = carry >> u64(32)
    n = n + 1
  }
  return bigNorm(a, n)
}

// `a = a * mul + add` for single-limb operands. Returns the new limb count.
// Folding the add into the multiply lets the decimal parser consume nine digits
// per pass, which is the most that fits in a limb.
export fn bigMulAddSmall(a: []u32, an: i64, mul: u32, add: u32): i64 {
  let carry = u64(add)
  let i = 0
  while (i < an) {
    let p = u64(a[i]) * u64(mul) + carry
    a[i] = u32(p & u64(4294967295))
    carry = p >> u64(32)
    i = i + 1
  }
  let n = an
  while (carry != u64(0)) {
    assert(n < len(a))
    a[n] = u32(carry & u64(4294967295))
    carry = carry >> u64(32)
    n = n + 1
  }
  return bigNorm(a, n)
}

// `a <<= bits`. Returns the new limb count.
export fn bigShl(a: []u32, an: i64, bits: i64): i64 {
  if (bits == 0 || an == 0) { return an }
  let limbShift = bits / 32
  let bitShift = bits - limbShift * 32
  let n = an + limbShift + 1
  assert(n <= len(a))
  // Walk downward so a source limb is read before its destination overwrites it.
  let i = n - 1
  while (i >= 0) {
    let hi = u64(0)
    let lo = u64(0)
    let src = i - limbShift
    if (src >= 0 && src < an) { lo = u64(a[src]) }
    if (src - 1 >= 0 && src - 1 < an) { hi = u64(a[src - 1]) }
    let v = lo << u64(bitShift)
    if (bitShift > 0) { v = v | (hi >> u64(32 - bitShift)) }
    a[i] = u32(v & u64(4294967295))
    i = i - 1
  }
  return bigNorm(a, n)
}

// `a >>= 1`. Returns the new limb count.
export fn bigShr1(a: []u32, an: i64): i64 {
  let i = 0
  while (i < an) {
    let v = u64(a[i]) >> u64(1)
    if (i + 1 < an) { v = v | ((u64(a[i + 1]) & u64(1)) << u64(31)) }
    a[i] = u32(v & u64(4294967295))
    i = i + 1
  }
  return bigNorm(a, an)
}

// The number of significant bits in `a`; 0 for zero.
export fn bigBitLen(a: []u32, an: i64): i64 {
  if (an == 0) { return 0 }
  let top = u64(a[an - 1])
  let bits = 0
  while (top != u64(0)) { bits = bits + 1; top = top >> u64(1) }
  return (an - 1) * 32 + bits
}

// True when `a` is zero.
export fn bigIsZero(an: i64): bool { return an == 0 }

// `a *= 10^p`. Returns the new limb count. Multiplying by 10^9 at a time keeps
// every partial product inside one limb, which is the largest power of ten that
// fits in a u32.
export fn bigMulPow10(a: []u32, an: i64, p: i64): i64 {
  assert(p >= 0)
  let n = an
  let left = p
  while (left >= 9) {
    n = bigMulSmall(a, n, u32(1000000000))
    left = left - 9
  }
  if (left > 0) {
    let m = u32(1)
    let i = 0
    while (i < left) { m = m * u32(10); i = i + 1 }
    n = bigMulSmall(a, n, m)
  }
  return n
}
