// runtime/root/decimal.bit — #3982: rendering a `decimal` (§11.1) as text.
// Sibling file, same module — see `root.bit` for the port's header and seams.
//
// THE VALUE. Two i64 words, sign-magnitude, laid out as .NET `System.Decimal`:
// `lo` is mantissa bits 0..63, `hi` carries mantissa bits 64..95 in its bits
// 0..31, the scale (0..28) in its bits 32..39 and the sign in its bit 63. The
// text is therefore the 96-bit MAGNITUDE's digits with a point inserted `scale`
// digits from the right, and it is exact by construction: no float ever holds
// the value, which is the whole reason the type exists.

// The last decimal digit of the 96-bit magnitude `m2:m0` (`m2` is the top 32
// bits). 2^64 is 6 mod 10, so the digit needs no division of the pair.
@nosplit fn decDigitOf(m2: u64, m0: u64): int {
  let a = m2 - m2 / u64(10) * u64(10)
  let b = m0 - m0 / u64(10) * u64(10)
  let s = a * u64(6) + b
  return int(s - s / u64(10) * u64(10))
}

// The low word of `m2:m0` divided by ten. Long division in 32-bit limbs: each
// step's remainder is under 10, so `rem << 32 | limb` cannot overflow a u64 and
// the quotient limb stays 32 bits wide. The high word divides on its own
// (`decDivTenHi`), and its remainder is what enters here.
@nosplit fn decDivTenLo(m2: u64, m0: u64): u64 {
  let carry = m2 - m2 / u64(10) * u64(10)
  let t1 = (carry << u64(32)) | (m0 >> u64(32))
  let q1 = t1 / u64(10)
  let t0 = ((t1 - q1 * u64(10)) << u64(32)) | (m0 & u64(4294967295))
  return (q1 << u64(32)) | (t0 / u64(10))
}

// The high word of `m2:m0` divided by ten. `m2` is 32 bits, so this is one
// division; the remainder it drops is picked up by `decDivTenLo`.
@nosplit fn decDivTenHi(m2: u64): u64 {
  return m2 / u64(10)
}

// How many decimal digits the magnitude `m2:m0` has — 1 for zero, so `0` at
// scale 2 still renders `0.00`.
@nosplit fn decDigitCount(m2: u64, m0: u64): int {
  let hi = m2
  let lo = m0
  let n = 0
  let more = true
  // Bounded: a 96-bit magnitude is at most 29 decimal digits, and each pass
  // divides by ten.
  while (more) {
    n = n + 1
    let nlo = decDivTenLo(hi, lo)
    hi = decDivTenHi(hi)
    lo = nlo
    more = hi != u64(0) || lo != u64(0)
  }
  return n
}

// Writes the magnitude `m2:m0`'s digits backwards from byte `end`, laying the
// point down once `scale` fraction digits are behind it.
//
// The digit count is not a parameter: it is `max(digits(m2:m0), scale + 1)`,
// the same rule `rtStringFromDecimal` sizes the string by, recomputed from the
// loop's own state. One rule in two places would be one rule too many — a
// count that disagreed with the allocation writes outside the string — so the
// loop runs until the magnitude is spent AND the scale is covered. The
// magnitude runs out first exactly when the value is under 1 (`0.05` is
// mantissa 5 at scale 2), and the division then yields the leading zeros.
@nosplit fn decEmit(dst: int, end: int, m2: u64, m0: u64, scale: int) {
  let hi = m2
  let lo = m0
  let at = end
  let k = 0
  let more = true
  // Bounded: `scale` is at most 28 and a 96-bit magnitude is at most 29
  // digits, so at most 30 passes, each dividing the magnitude by ten.
  while (more) {
    if (k == scale && scale > 0) {
      at = at - 1
      storeByte(dst + at, 46) // '.'
    }
    let d = decDigitOf(hi, lo)
    let nlo = decDivTenLo(hi, lo)
    hi = decDivTenHi(hi)
    lo = nlo
    at = at - 1
    storeByte(dst + at, 48 + d)
    k = k + 1
    more = hi != u64(0) || lo != u64(0) || k < scale + 1
  }
}

// `bit_rt_string_from_decimal` (ABI.md §2): the exact decimal text of the
// two-word value `(lo, hi)`.
export @nosplit @symbol("bit_rt_string_from_decimal") fn rtStringFromDecimal(
  lo: u64,
  hi: u64,
): int {
  let scale = int((hi >> u64(32)) & u64(255))
  let neg = ((hi >> u64(63)) & u64(1)) == u64(1)
  let m2 = hi & u64(4294967295)
  // The digits the text carries: the magnitude's own, but never fewer than
  // `scale + 1`, because a value under 1 still needs its `0.` and its leading
  // fraction zeros.
  let ndigits = decDigitCount(m2, lo)
  if (ndigits < scale + 1) {
    ndigits = scale + 1
  }
  let total = ndigits
  if (scale > 0) {
    total = total + 1
  }
  if (neg) {
    total = total + 1
  }
  let out = allocString(total)
  if (out == 0) {
    return 0
  }
  let dst = strBytes(out)
  if (neg) {
    storeByte(dst, 45) // '-'
  }
  decEmit(dst, total, m2, lo, scale)
  return out
}
