// Core (platform-free) half of runtime/root/{linux,darwin}/time.bit (#2551,
// #1710's provider-duplication sweep; see
// docs/development/provider-duplication.md's `root` -> `time.bit` section).
// The per-task/fallback scratch cell `parkMonoNs`/`clock_gettime` write their
// `timespec` into has no OS call in its body; both providers' copies were
// byte-identical.
//
// STILL split per provider: `rtTimeMonoNs`/`rtTimeSleepNs` themselves call
// `parkMonoNs` with this scratch as an argument on Linux (`clock_gettime`
// needs an output buffer) and with no argument at all on Darwin
// (`mach_absolute_time` needs none) — `parkMonoNs` genuinely differs per OS
// in `park/wait.bit`, and its callers stay with it.

// `schedCurrentWorker`/`taskAt` are already imported into this module by
// `./fs.bit`'s "../sched" import (module-scoped); only `wkSleepReq` is new.
import { wkSleepReq } from "../sched"

// The fallback scratch for a caller with no current task/worker — mirrors
// `./io.bit`'s `ioConstBuf`/`./os.bit`'s per-worker buffers, which need the
// identical fallback for the identical reason (a driver program, or code the
// ported scheduler is not running, has no task to index by). A scalar array,
// never scanned by the collector (rule 1).
let timeFallbackScratch: [2]i64

// The 2-word scratch `parkMonoNs`/`clock_gettime` write their `timespec` into
// (#2318) — the caller-owned-block pattern `parkSleepNs` already uses: the
// current task's own worker's `wkSleepReq`, or the shared fallback when there
// is no current task.
export @nosplit @symbol("bit_rt_port_root_time_scratch") fn timeScratch(): *i64 {
  let w = schedCurrentWorker()
  if (w == 0) {
    return ptrOf(timeFallbackScratch)
  }
  return taskAt(w) + wkSleepReq
}
