// The per-process map hash seed (#7379). Sibling of `maps.bit`, same module.
//
// WHY A SEED. Map keys in a server are often chosen by the peer: query
// parameters, headers, JSON object keys. Under one fixed seed in every process
// an attacker precomputes keys that share a probe chain offline and turns each
// lookup into a scan of the whole chain (hash flooding). `boot` draws this word
// from the OS CSPRNG before `bit_main` runs, so the colliding set is different
// in every process and cannot be computed ahead of time.
//
// `BIT_HASH_SEED=<n>` replaces the draw with `n`, to reproduce a run whose
// behaviour depended on slot order (ABI.md §7). `0` is the seed every process
// used before #7379.
//
// Written once by `rootHashSeedInit`, before any worker thread exists and
// before `bit_main` (ABI.md §9), and only read after that, so a plain load sees
// the final value on every worker: the thread starts that follow the store are
// the publication.
let hashSeed: u64 = 0

// `BIT_HASH_SEED` as a number, or -1 when it is unset or empty. `gcEnvCheckAll`
// has already refused every other value. Pinned for the reason rootconfig.bit's
// readers are: its caller is small enough to be spliced into `boot`.
@symbol("bit_rt_port_root_hash_seed_env") fn hashSeedEnv(): int {
  let vp = gcEnvSet("BIT_HASH_SEED")
  if (vp < 0) {
    return -1
  }
  return gcCstrUsize(vp)
}

// Install the seed: `BIT_HASH_SEED` when set, else `entropy`, the word `boot`
// drew from the OS CSPRNG (`drawn` false when that draw failed). Once, before
// any map exists: a map filled under one seed and probed under another misses
// every key it holds.
export @symbol("bit_rt_port_root_hash_seed_init") fn rootHashSeedInit(entropy: u64, drawn: bool) {
  let n = hashSeedEnv()
  if (n >= 0) {
    hashSeed = u64(n)
    return
  }
  if (!drawn) {
    hashSeedFail()
  }
  hashSeed = entropy
}

// A failed draw with no `BIT_HASH_SEED` is fatal at boot, never a silent fixed
// seed: exit `gcEnvExitCode` with one line on stderr, as a refused knob does.
// Pinned for the reason `hashSeedEnv` is.
@symbol("bit_rt_port_root_hash_seed_fail") fn hashSeedFail() {
  let buf = int(ptrOf(gcEnvErrBuf))
  let pos = gcEnvAppend(buf, 0, "bit: cannot seed the map hash: the OS CSPRNG failed\n")
  bit_rt_port_root_io_write_all(2, buf, pos)
  bit_rt_os_exit(gcEnvExitCode)
}
