// Split out of `floats.bit` (#1503, #1609): the std.math `atan2(f64)` port and
// its scalar `atan(f64)` (musl atan2.c / atan.c, the bodies `fatan2` lowers to).
// Sibling of `floats.bit` — same module (runtime/root). See `floats.bit` SEAM 5b
// for the seam header and the pin-cycle rule.
//
// `atan` needs two 4-entry tables (atanhi/atanlo, indexed by the reduction
// region 0..3) held as `const [4]f64` rodata (#1231; #1625 opened the @nosplit
// read); its 11 polynomial coefficients are constant-indexed, so they are plain
// scalars. `@abs`/negate are expressed as exact bit operations (mask/flip the
// sign bit via `floatBits`/`bitsToFloat`, both inline ops) so the whole port is
// `@nosplit`-clean — the rootpins proof it is no rt_call cycle. Measured
// bit-exact vs the shipping `fatan2` at 0 mismatches over the `bench/translog`
// corpus (structural edges + every biased exponent both signs + a 500k xorshift
// sweep of (y, x) pairs + all four quadrants, the axes, and the signed-zero
// rules), NaN matched by class; mutation-tested.

const ATAN_HI: [4]f64 = [4]f64{
  4.63647609000806093515e-01, 7.85398163397448278999e-01,
  9.82793723247329054082e-01, 1.57079632679489655800e+00,
}
const ATAN_LO: [4]f64 = [4]f64{
  2.26987774529616870924e-17, 3.06161699786838301793e-17,
  1.39033110312309984516e-17, 6.12323399573676603587e-17,
}

// `math.isNan` for a raw u64 pattern: max exponent and a nonzero mantissa.
@nosplit fn atanIsNanBits(b: u64): bool {
  return (b & u64(0x7FF0000000000000)) == u64(0x7FF0000000000000) &&
    (b & u64(0x000FFFFFFFFFFFFF)) != 0
}

// Exact IEEE-754 |v| — clear the sign bit; a register move, no rounding.
@nosplit fn atanAbs(v: f64): f64 {
  return bitsToFloat(floatBits(v) & u64(0x7FFFFFFFFFFFFFFF))
}

// Scalar `atan(f64)` — musl atan.c / atanBinary64. Range-reduce into one of four
// regions, evaluate an 11-term odd/even split polynomial, recombine through the
// region's (hi, lo) constants.
@nosplit fn atanInner(x: f64): f64 {
  let aT0 = 3.33333333333329318027e-01
  let aT1 = -1.99999999998764832476e-01
  let aT2 = 1.42857142725034663711e-01
  let aT3 = -1.11111104054623557880e-01
  let aT4 = 9.09088713343650656196e-02
  let aT5 = -7.69187620504482999495e-02
  let aT6 = 6.66107313738753120669e-02
  let aT7 = -5.83357013379057348645e-02
  let aT8 = 4.97687799461593236017e-02
  let aT9 = -3.65315727442169155270e-02
  let aT10 = 1.62858201153657823623e-02
  let hx = floatBits(x)
  let ix = (hx >> 32) & u64(0x7fffffff)
  let sign = (hx >> 63) != 0
  // |x| >= 2^66
  if (ix >= u64(0x44100000)) {
    if (atanIsNanBits(hx)) { return x }
    let z = ATAN_HI[3] + 0x1p-120
    if (sign) { return -z }
    return z
  }
  let id = -1
  let xr = x
  // |x| < 0.4375
  if (ix < u64(0x3fdc0000)) {
    // |x| < 2^(-27): atan(x) ~= x
    if (ix < u64(0x3e400000)) {
      return x
    }
    id = -1
    xr = x
  } else {
    xr = atanAbs(x)
    // |x| < 1.1875
    if (ix < u64(0x3ff30000)) {
      // 7/16 <= |x| < 11/16
      if (ix < u64(0x3fe60000)) {
        id = 0
        xr = (2.0 * xr - 1.0) / (2.0 + xr)
      } else {
        // 11/16 <= |x| < 19/16
        id = 1
        xr = (xr - 1.0) / (xr + 1.0)
      }
    } else {
      // |x| < 2.4375
      if (ix < u64(0x40038000)) {
        id = 2
        xr = (xr - 1.5) / (1.0 + 1.5 * xr)
      } else {
        // 2.4375 <= |x| < 2^66
        id = 3
        xr = -1.0 / xr
      }
    }
  }
  let z = xr * xr
  let w = z * z
  let s1 = z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))))
  let s2 = w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))))
  if (id < 0) {
    return xr - xr * (s1 + s2)
  }
  let zz = ATAN_HI[id] - (xr * (s1 + s2) - ATAN_LO[id] - xr)
  if (sign) { return -zz }
  return zz
}

// `bit_rt_atan2` (ABI.md §17): std.math `atan2(y, x)` (musl atan2.c). Dispatches
// the four sign quadrants and the inf/zero axes, then folds `atan(|y/x|)` into
// the right region. `@nosplit`-clean — the rootpins proof it is no rt_call cycle.
export @nosplit @symbol("bit_rt_atan2")
fn rtAtan2(y: f64, x: f64): f64 {
  let pi = 3.1415926535897931160e+00
  let piLo = 1.2246467991473531772e-16
  let bx = floatBits(x)
  let by = floatBits(y)
  if (atanIsNanBits(bx) || atanIsNanBits(by)) { return x + y }
  let ix = (bx >> 32) & u64(0xffffffff)
  let lx = bx & u64(0xffffffff)
  let iy = (by >> 32) & u64(0xffffffff)
  let ly = by & u64(0xffffffff)
  // x == 1.0
  if (ix == u64(0x3ff00000) && lx == 0) { return atanInner(y) }
  // m = 2*sign(x) + sign(y)  in {0,1,2,3}
  let m = int(((iy >> 31) & u64(1)) | ((ix >> 30) & u64(2)))
  ix = ix & u64(0x7fffffff)
  iy = iy & u64(0x7fffffff)
  // y == 0
  if ((iy | ly) == 0) {
    if (m == 0 || m == 1) { return y }
    if (m == 2) { return pi }
    return -pi
  }
  // x == 0
  if ((ix | lx) == 0) {
    if ((m & 1) != 0) { return -pi / 2.0 }
    return pi / 2.0
  }
  // x == +-inf
  if (ix == u64(0x7ff00000)) {
    if (iy == u64(0x7ff00000)) {
      if (m == 0) { return pi / 4.0 }
      if (m == 1) { return -pi / 4.0 }
      if (m == 2) { return 3.0 * pi / 4.0 }
      return -3.0 * pi / 4.0
    }
    if (m == 0) { return 0.0 }
    if (m == 1) { return -0.0 }
    if (m == 2) { return pi }
    return -pi
  }
  // |y / x| > 0x1p64
  if ((ix + (u64(64) << 20)) < iy || iy == u64(0x7ff00000)) {
    if ((m & 1) != 0) { return -pi / 2.0 }
    return pi / 2.0
  }
  // z = atan(|y / x|), with correct underflow to 0
  let z = 0.0
  if ((m & 2) != 0 && (iy + (u64(64) << 20)) < ix) {
    z = 0.0
  } else {
    z = atanInner(atanAbs(y / x))
  }
  if (m == 0) { return z }
  if (m == 1) { return -z }
  if (m == 2) { return pi - (z - piLo) }
  return (z - piLo) - pi
}
