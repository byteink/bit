// Split out of `root.bit` (#1503): the `string` entry points (ABI.md §2).
// Sibling file, same module — see `root.bit` for the port's header and seams.

// `bit_rt_string_concat` (ABI.md §2): a fresh string holding `a` then `b`.
// Binary. Backs string `+`, and the two-part end of an interpolation; a wider
// interpolation goes to `rtStringConcat5` below (#4037).
export @nosplit @symbol("bit_rt_string_concat") fn rtStringConcat(a: int, b: int): int {
  let an = strSize(a)
  let bn = strSize(b)
  let out = allocString(an + bn)
  if (out == 0) {
    return 0
  }
  let dst = strBytes(out)
  copyBytes(dst, strBytes(a), an)
  copyBytes(dst + an, strBytes(b), bn)
  return out
}

// One operand of an N-ary concat: `s`'s bytes copied to `dst`, and the position
// just past them. Extracted so `rtStringConcat5` carries ONE copy of the
// per-operand logic instead of five. A 0 handle reads as `""` through
// `root.bit`'s string funnel, so an absent operand needs no guard here.
@nosplit fn strCopyPart(dst: int, s: int): int {
  let n = strSize(s)
  copyBytes(dst, strBytes(s), n)
  return dst + n
}

// `bit_rt_string_concat5` (ABI.md §2): a fresh string holding `a` through `e`
// in order — ONE sized allocation and one pass over the bytes.
//
// #4037: interpolation folded its parts through the binary `string_concat`
// above, so a k-part literal cost k-1 allocations and copied O(k^2) bytes. Five
// operands at once lets lowering absorb four new parts per allocation.
//
// FIVE, not eight, for two independent reasons. The linter's `max-params` is 5
// (spec/LINT.md, E0202) and nothing under `compiler/`, `runtime/`, `stdlib/` or
// `tools/` carries a `bit:lint` override — a wider entry point would be the
// first. Five is also the widest arity that stays entirely in registers on
// x86-64 SysV, which has six integer argument registers.
//
// Operands past the last real part are the empty string: lowering pads with a
// pooled `const_string ""`, which contributes no length and no bytes.
export @nosplit @symbol("bit_rt_string_concat5") fn rtStringConcat5(
  a: int,
  b: int,
  c: int,
  d: int,
  e: int,
): int {
  let n = strSize(a) + strSize(b) + strSize(c) + strSize(d) + strSize(e)
  let out = allocString(n)
  if (out == 0) {
    return 0
  }
  let p = strBytes(out)
  p = strCopyPart(p, a)
  p = strCopyPart(p, b)
  p = strCopyPart(p, c)
  p = strCopyPart(p, d)
  p = strCopyPart(p, e)
  return out
}

// `bit_rt_string_eq` (ABI.md §2): byte-wise equality; backs string `==`/`!=`.
export @nosplit @symbol("bit_rt_string_eq") fn rtStringEq(a: int, b: int): bool {
  let an = strSize(a)
  let bn = strSize(b)
  if (an != bn) {
    return false
  }
  let pa = strBytes(a)
  let pb = strBytes(b)
  let i = 0
  while (i < an) {
    let x = loadByte(pa + i)
    let y = loadByte(pb + i)
    if (x != y) {
      return false
    }
    i = i + 1
  }
  return true
}

// `bit_rt_string_cmp` (ABI.md §2): three-way lexicographic order, backing
// string `<`/`<=`/`>`/`>=` (SPEC §14.6). Negative when `a < b`, 0 when equal,
// positive when `a > b`. Bytes compare UNSIGNED (`loadByte` zero-extends) and a
// common prefix is broken by length, shorter first — which is also code-point
// order for UTF-8. Length-driven, never NUL-terminated.
export @nosplit @symbol("bit_rt_string_cmp") fn rtStringCmp(a: int, b: int): int {
  let an = strSize(a)
  let bn = strSize(b)
  let n = an
  if (bn < n) {
    n = bn
  }
  let pa = strBytes(a)
  let pb = strBytes(b)
  let i = 0
  while (i < n) {
    let x = loadByte(pa + i)
    let y = loadByte(pb + i)
    if (x != y) {
      return x - y
    }
    i = i + 1
  }
  if (an == bn) {
    return 0
  }
  if (an < bn) {
    return -1
  }
  return 1
}

// `bit_rt_string_byte` (ABI.md §2): the byte at `index`, backing `s[i]` (SPEC
// §12.2 — result type `u8`). OUT OF RANGE PANICS (SPEC §12.6, #2014).
//
// It used to return -1 "a value no byte can take", which is exactly what made it
// the worst of the five to debug: the result type is `u8`, so -1 was handed back
// as 0xFFFFFFFFFFFFFFFF and rendered `18446744073709551615` after #2011 — a
// plausible-looking number rather than an obvious sentinel, in a `byte`-typed
// value. `panicBounds` lives in the sibling `slices.bit` (same module); see its
// header for why raising a panic from a `@nosplit` body is now possible, and why
// the kind travels as one immediate rather than as the packed words.
//
// A null header reads as `""` through `strSize` (root.bit's funnel), so length 0
// and every index panics.
export @nosplit @symbol("bit_rt_string_byte") fn rtStringByte(s: int, index: int): int {
  let n = strSize(s)
  if (index < 0 || index >= n) {
    panicBounds(oobIndex)
    return -1
  }
  let b = loadByte(strBytes(s) + index)
  return b
}

// `bit_rt_string_slice` (ABI.md §2): `s[lo:hi]` (SPEC §12.6) — a string holding
// bytes `[lo, hi)`. SHARES `s`'s bytes: a 24-byte header only, `ptr = ptr(s) +
// lo`, `base = s` (#3897, ABI.md §2.3). It copied until the `{ptr, len, base}`
// header landed, because a view's `ptr` is an interior pointer with no way to
// keep the backing alive; `base` is that way, and it is the collector's one
// traced field on a string.
//
// PANICS unless `0 <= lo <= hi <= len` (#2014, where it used to return 0 —
// indistinguishable from `""`, so an over-long substring silently produced the
// empty string).
//
// Note the upper bound is `len`, not `cap` as on a slice: a string carries no
// spare capacity to reslice into, and a view must never reach past what its
// source could already read. That is why this raises `string bounds out of
// range` and `rtSliceSlice` raises `slice bounds out of range` — different
// limits.
//
// NO ALIASING HAZARD, unlike `[]T`: `string` has SPEC §13.3 read-only value
// semantics and no mutation path, so two views of one backing can never
// disagree. The accepted cost is RETENTION — a tiny long-lived view keeps its
// whole backing alive, exactly as `[]T` reslicing already accepts (ABI.md §2).
//
// The `out == 0` exit below is EXHAUSTION and stays a 0 return (constraint 3):
// the range was legal and the heap could not honour it.
export @nosplit @symbol("bit_rt_string_slice") fn rtStringSlice(s: int, lo: int, hi: int): int {
  let n = strSize(s)
  if (lo < 0 || lo > hi || hi > n) {
    panicBounds(oobStringRange)
    return 0
  }
  let out = allocStringView(s, lo, hi - lo)
  if (out == 0) {
    return 0
  }
  return out
}

// `bit_rt_string_from_int`: the decimal text of `v`.
//
// The magnitude is taken in u64, so i64's most negative value — which has no
// positive counterpart — is handled without a special case.
//
// Doing the negation in `int` instead (`u64(0 - v)`) turns out to be EXACTLY
// EQUIVALENT, not a bug: `0 - (-2^63)` wraps back to `-2^63`, whose u64 bit
// pattern is 2^63, which is the magnitude wanted. Recorded because it was
// asserted here as a hazard on first writing and mutation testing disproved it
// (M15 survived, correctly). The u64 form is kept for saying plainly what it
// means, not because the alternative is wrong.
export @nosplit @symbol("bit_rt_string_from_int") fn rtStringFromInt(v: int): int {
  let neg = v < 0
  let mag: u64 = u64(v)
  if (neg) {
    mag = u64(0) - u64(v)
  }

  // Count the digits first, then write them into the string from the END
  // backwards. Digits generate least-significant-first into a scratch buffer and
  // reverses; that needs an addressable local array, which Bit does not have
  // (`ptrOf` takes a slice or module state, E0053) — and a module-state scratch
  // would make this entry point non-reentrant for the sake of a buffer. Two
  // passes over at most 20 digits is the cheaper trade and needs no storage.
  let ndigits = 1
  let probe = mag / u64(10)
  // Bounded: at most 20 decimal digits fit in a u64.
  while (probe > u64(0)) {
    ndigits = ndigits + 1
    probe = probe / u64(10)
  }
  let total = ndigits
  if (neg) {
    total = total + 1
  }

  let out = allocString(total)
  if (out == 0) {
    return 0
  }
  let dst = strBytes(out)
  if (neg) {
    storeByte(dst, 45)
  }
  let at = total
  let rest = mag
  // Bounded by `ndigits`, computed above from the same value.
  let k = 0
  while (k < ndigits) {
    let q = rest / u64(10)
    let r = rest - q * u64(10)
    at = at - 1
    storeByte(dst + at, 48 + int(r))
    rest = q
    k = k + 1
  }
  return out
}

// `bit_rt_string_from_uint`: the decimal text of `v` read as UNSIGNED.
//
// A separate entry point rather than a signedness flag on the one above,
// because the caller already knows the answer statically — the prim tag says
// whether the value is unsigned — and a runtime branch would pay for that on
// every interpolation. Without it a `u64` above 2^63 renders as the i64 with
// the same bit pattern: `18446744073709551615` printed `-1` (#2011).
//
// `u8`/`u16`/`u32` reach here zero-extended into the 64-bit argument, so this
// body prints them exactly as the signed one did.
export @nosplit @symbol("bit_rt_string_from_uint") fn rtStringFromUint(v: u64): int {
  // Count the digits first, then write them from the END backwards — the same
  // two-pass shape as `rtStringFromInt`, and for the same reason: reversing a
  // least-significant-first scratch buffer needs an addressable local array,
  // which Bit does not have.
  let ndigits = 1
  let probe = v / u64(10)
  // Bounded: at most 20 decimal digits fit in a u64.
  while (probe > u64(0)) {
    ndigits = ndigits + 1
    probe = probe / u64(10)
  }

  let out = allocString(ndigits)
  if (out == 0) {
    return 0
  }
  let dst = strBytes(out)
  let at = ndigits
  let rest = v
  // Bounded by `ndigits`, computed above from the same value.
  let k = 0
  while (k < ndigits) {
    let q = rest / u64(10)
    let r = rest - q * u64(10)
    at = at - 1
    storeByte(dst + at, 48 + int(r))
    rest = q
    k = k + 1
  }
  return out
}

// `bit_rt_string_from_bool`.
export @nosplit @symbol("bit_rt_string_from_bool") fn rtStringFromBool(v: bool): int {
  if (v) {
    let t = allocString(4)
    if (t == 0) {
      return 0
    }
    let p = strBytes(t)
    storeByte(p + 0, 116)
    storeByte(p + 1, 114)
    storeByte(p + 2, 117)
    storeByte(p + 3, 101)
    return t
  }
  let f = allocString(5)
  if (f == 0) {
    return 0
  }
  let q = strBytes(f)
  storeByte(q + 0, 102)
  storeByte(q + 1, 97)
  storeByte(q + 2, 108)
  storeByte(q + 3, 115)
  storeByte(q + 4, 101)
  return f
}

// `bit_rt_bytes_from_string` (ABI.md §2): `[]byte(s)` (SPEC §12.9) — a fresh
// PACKED `[]u8` whose byte `i` is `s[i]`.
//
// PACKED (elemSize 1), NOT `rtSliceNew(n, n, 0, 8)` (#3121/#3226 -- this was
// deliberately left word-per-element by #3121's own scope note until the
// compiler side landed): that reason no longer applies. The compiler's inline
// read path (`compiler/loweraccess.bit`'s `emitInlineSliceGet`) and every
// other `[]u8` slice call site now pass `elemSize == 1` for a `u8` element
// (`compiler/lowerlayout.bit`'s `sliceElemSizeFor`, #3226), so a packed body
// here is read correctly by ordinary compiled `xs[i]`. A bulk `copyBytes`
// replaces the old word-expanding loop since both sides are byte-addressed now.
export @nosplit @symbol("bit_rt_bytes_from_string") fn rtBytesFromString(s: int): int {
  let n = strSize(s)
  let h = rtSliceNew(n, n, 0, 1)
  if (h == 0) {
    return 0
  }
  let buf = loadWord(h + slcBuf)
  copyBytes(buf, strBytes(s), n)
  return h
}

// An uninitialised `string` object of `nbytes` bytes, or 0 on exhaustion — a
// packed writable byte region (the object's inline bytes) reachable by
// `strPtr`. The marshalling glue SEAM 1 (#1574) needs: `runtime/net`'s socket
// wrappers must read a syscall's PACKED bytes into a SINGLE object and hand
// back a `string` directly. A `[]u8` — packed as of #3121/#3226, but still a
// two-object value (a header plus a separately `gc_alloc`'d buffer, §2) —
// cannot serve that in one allocation the way a string's own inline bytes can.
//
// PORT-INTERNAL, not ABI: pinned `bit_rt_port_root_*` like `darwin/io.bit`'s
// `bit_rt_port_root_io_write_all`, because ABI.md names no such symbol and
// #1369's rename must not touch it. It exists only so a sibling runtime module
// can reach `allocString` across the object boundary (§11.9) — `-O1` splices
// bodies across it, so the reference must be pinned.
export @nosplit @symbol("bit_rt_port_root_str_alloc") fn rtStrAlloc(nbytes: int): int {
  return allocString(nbytes)
}

// `bit_rt_string_from_bytes` (ABI.md §2): `string(b)` for a `[]u8` (SPEC §12.9)
// — a fresh string holding `b`'s bytes.
//
// Takes a SLICE header, so `strBytes`/`strSize` do not cover it: the null case
// is guarded here, exactly as `runtime/root/` does (`h orelse return allocString(0)`).
// A null `[]u8` converts to `""`.
//
// PACKED (#3121/#3226): every `[]u8` this runtime constructs is now
// byte-packed (`sliceElemSizeFor` in the compiler, `rtSliceGet`/`Set`/`Append`'s
// packed arm here), so `off`/`n` are already counted in bytes and a bulk
// `copyBytes` replaces the old per-element word-unpack loop.
export @nosplit @symbol("bit_rt_string_from_bytes") fn rtStringFromBytes(h: int): int {
  if (h == 0) {
    return allocString(0)
  }
  let n = loadWord(h + slcLen)
  let off = loadWord(h + slcOff)
  let buf = loadWord(h + slcBuf)
  let out = allocString(n)
  if (out == 0) {
    return 0
  }
  copyBytes(strBytes(out), buf + off, n)
  return out
}
