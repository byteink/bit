// GC tuning from the environment (#1618): the Bit port of `runtime/gc/`'s
// `configFromEnv` (runtime/gc/:895). `runtime/root/` builds its collector config with
// `Gc.init(&g_heap, configFromEnv(environ))`; this file is the `configFromEnv`
// half, and `boot` (../{linux,darwin}/boot.bit) is the `Gc.init` call site that
// hands the parsed values into `rootConfigure`/`rootInit`.
//
// Sibling of `os.bit` (same module, SPEC §17.1), so it reaches the process-entry
// `envp` through `osEnvp` and reuses the two scan bounds `osMaxEnvCount`/
// `osMaxCstr` and the raw `loadByte`/`loadWord` glue directly — the same raw
// int-handle style as `os.bit`'s `rtOsEnv`, deliberately NOT the `string`-typed
// world: the value bytes come straight off the kernel `envp` block, and going
// through a `string` object would either allocate before the collector is up or
// route the lookup back through `bit_rt_os_env` (defeating the point).
//
// The five variables are exactly `configFromEnv`'s (runtime/gc/:882-887):
//
//   BIT_GC=off|0            disable automatic collection  (enabled = false)
//   BIT_GC=stress           collect at every safepoint    (stress  = true)
//   BIT_GC_MIN_KB=<n>       min live KiB before collection (min_trigger = n*1024)
//   BIT_GC_GROWTH_PCT=<n>   heap growth percent, >= 100    (growth_pct)
//   BIT_GC_MARKSTACK=<n>    mark worklist entries, > 0     (mark_stack_len)
//   BIT_GC_STATS=1|on       one line per collection        (verbose = true)
//
// EACH PARSE IS OVER A DEFAULT, not over `runtime/gc/`'s `Config{}`: the same
// layering `configFromEnv` does over `Config{}`. None of the three defaults
// is a local copy here: `boot` passes `gcDefaultMinTrigger`,
// `gcDefaultGrowthPct` and `gcDefaultMarkStack` (`runtime/gc/gc.bit`) straight
// through as the "unset" values, because a second copy of a default is
// exactly what silently drifted 64x too low for two weeks (#2920) and 2x low
// with no observed damage (#2923) — #2924 removed the growth-percent copy
// pre-emptively, before it had drifted. An unset variable, or one whose value
// fails to parse, leaves the default untouched, byte-for-byte the
// `if (envUsize(...)) |v|` / `if (lookupEnv(...)) |v|` guards this replaced.
//
// `rtOsEnv` returns the empty string for an absent variable, and here an absent
// variable returns the sentinel -1 "not found"; both collapse to "no override"
// because an empty value matches none of the string tests and parses as no
// integer — identical to `configFromEnv` treating `null` and `""` alike.
//
// Not `@nosplit`: called from `boot` before the scheduler is up but after the
// heap is mapped, doing only bounded pointer reads — no allocation, no safepoint.

// Pointer to the value bytes of environment variable `name` (the bytes just past
// its `=`), or -1 when it is unset. The `rtOsEnv` walk (os.bit), but returning a
// raw pointer into the `envp` block instead of a fresh `string` — no allocation.
// BOUNDED by `osMaxEnvCount` (Power of 10 rule 2), the same cap `rtOsEnv` uses.
fn gcEnvValuePtr(name: string): int {
  let base = osEnvp()
  let n = len(name)
  let i = 0
  while (i < osMaxEnvCount) {
    let entry = loadWord(base + i * 8)
    if (entry == 0) {
      return -1
    }
    if (gcEnvKeyMatch(entry, name)) {
      return entry + n + 1
    }
    i = i + 1
  }
  return -1
}

// True if the `envp` entry at `entry` has key exactly `name`, i.e. the `len(name)`
// bytes match and the byte right after is `=` (61). `os.bit`'s `osEnvMatch`, but
// taking the key as a literal `string` (read with `name[j]`) rather than a raw
// (pointer, length) pair. BOUNDED by `len(name)`.
fn gcEnvKeyMatch(entry: int, name: string): bool {
  let n = len(name)
  let j = 0
  while (j < n) {
    if (loadByte(entry + j) != int(name[j])) {
      return false
    }
    j = j + 1
  }
  return loadByte(entry + n) == 61
}

// True if the NUL-terminated C string at `vp` equals the literal `lit`. Backs the
// `std.mem.eql(u8, v, "off")` tests in `configFromEnv`. BOUNDED by `len(lit)`.
fn gcCstrEq(vp: int, lit: string): bool {
  let n = len(lit)
  let i = 0
  while (i < n) {
    if (loadByte(vp + i) != int(lit[i])) {
      return false
    }
    i = i + 1
  }
  return loadByte(vp + n) == 0
}

// Parse the NUL-terminated decimal at `vp` as a non-negative integer, or -1 when
// it is empty or holds a non-digit — `configFromEnv`'s `std.fmt.parseInt(usize,
// v, 10) catch null`, whose failure the caller reads as "no override". Only ASCII
// digits are accepted (no sign, no whitespace), which is every value the five
// tuning knobs take. BOUNDED by `osMaxCstr`, the kernel's single-string ceiling.
fn gcCstrUsize(vp: int): int {
  let acc = 0
  let i = 0
  while (i < osMaxCstr) {
    let c = loadByte(vp + i)
    if (c == 0) {
      if (i == 0) {
        return -1
      }
      return acc
    }
    if (c < 48 || c > 57) {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  return -1
}

// THE SIX `gcEnv*` READERS BELOW ARE `@symbol`-PINNED THOUGH NOTHING IMPORTS
// THEM, and the reason is the #1627 shape: their only caller,
// `rootConfigureFromEnv`, is small enough that `-O1` splices it into
// `runtime/root/<os>`'s `boot`, so the reference that survives into THAT
// module's object is to these callees, under mangled `m<id>$gcEnv*` names no
// sibling object can define. `boot`'s module must emit `--freestanding`
// (#1628), which refuses exactly that. Pinning the callee is what a pin on the
// inlinable wrapper cannot do. `bit_rt_port_` marks them non-ABI and temporary,
// so #1369's rename skips them; they stay module-private otherwise.

// `configFromEnv`'s `BIT_GC` disable test: `off` or `0` clears `enabled`; anything
// else (including unset) keeps the default.
@symbol("bit_rt_port_root_gc_env_enabled") fn gcEnvEnabled(def: bool): bool {
  let vp = gcEnvValuePtr("BIT_GC")
  if (vp < 0) {
    return def
  }
  if (gcCstrEq(vp, "off") || gcCstrEq(vp, "0")) {
    return false
  }
  return def
}

// `configFromEnv`'s `BIT_GC=stress` test: `stress` sets torture mode; anything
// else (including unset) keeps the default.
@symbol("bit_rt_port_root_gc_env_stress") fn gcEnvStress(def: bool): bool {
  let vp = gcEnvValuePtr("BIT_GC")
  if (vp < 0) {
    return def
  }
  if (gcCstrEq(vp, "stress")) {
    return true
  }
  return def
}

// `configFromEnv`'s `BIT_GC_MIN_KB`: a parsed value overrides with `kb * 1024`
// (KiB to bytes); a parse failure or unset keeps the default. No lower bound, so
// `BIT_GC_MIN_KB=0` sets a min trigger of 0, which is a meaningful setting.
@symbol("bit_rt_port_root_gc_env_min_trigger") fn gcEnvMinTrigger(def: int): int {
  let vp = gcEnvValuePtr("BIT_GC_MIN_KB")
  if (vp < 0) {
    return def
  }
  let kb = gcCstrUsize(vp)
  if (kb < 0) {
    return def
  }
  return kb * 1024
}

// `configFromEnv`'s `BIT_GC_GROWTH_PCT`: overrides only when parsed AND >= 100
// (`if (g >= 100)`), so the heap is always allowed to grow between collections; a
// smaller value, a parse failure, or unset keeps the default.
@symbol("bit_rt_port_root_gc_env_growth_pct") fn gcEnvGrowthPct(def: int): int {
  let vp = gcEnvValuePtr("BIT_GC_GROWTH_PCT")
  if (vp < 0) {
    return def
  }
  let g = gcCstrUsize(vp)
  if (g < 100) {
    return def
  }
  return g
}

// `configFromEnv`'s `BIT_GC_MARKSTACK`: overrides only when parsed AND > 0
// (`if (n > 0)`); a parse failure (-1), zero, or unset keeps the default. Applied
// at `rootInit` time (the mark worklist is sized once at `gcInit`), so `boot`
// reads this before `rootInit`, not through `rootConfigure`.
@symbol("bit_rt_port_root_gc_env_mark_stack") fn gcEnvMarkStack(def: int): int {
  let vp = gcEnvValuePtr("BIT_GC_MARKSTACK")
  if (vp < 0) {
    return def
  }
  let n = gcCstrUsize(vp)
  if (n <= 0) {
    return def
  }
  return n
}

// `BIT_WORKERS` (#1900, ABI.md §9 step 2): how many scheduler worker OS threads
// `boot` starts. Unset or unparseable keeps `def`, which every caller today
// passes as the literal 1 (`runtime/root/<os>/boot{,tail,worker}.bit`) — the
// pool grows past that at run time on demand (`runtime/sched/grow.bit`,
// #2593/#3569/#3583) rather than `def` ever being sized against the CPU
// count.
//
// CLAMPED BY THE CALLER, NOT HERE: this returns whatever the user wrote, so the
// clamp and its ceiling live at the one place that knows the static block sizes.
// Returning a pre-clamped value would let a caller with smaller blocks trust a
// number sized for someone else's.
@symbol("bit_rt_port_root_gc_env_workers") fn gcEnvWorkers(def: int): int {
  let vp = gcEnvValuePtr("BIT_WORKERS")
  if (vp < 0) {
    return def
  }
  let n = gcCstrUsize(vp)
  if (n <= 0) {
    return def
  }
  return n
}

// #4313: whether `BIT_WORKERS` was an EXPLICIT, validly-parsed override,
// distinct from `gcEnvWorkers`'s return value alone — an explicit
// `BIT_WORKERS=1` and an absent variable both return 1 from that function
// when `def` is 1 (every caller's literal), so the int alone cannot tell
// the two apart. `runtime/sched/grow.bit`'s `schedGrowArm`/`schedMaybeGrow`
// need that distinction to turn an explicit setting into a hard ceiling on
// growth while leaving the implicit default free to grow exactly as before.
// Unset or unparseable (same failure shape `gcEnvWorkers` falls back to
// `def` on) reads as NOT explicit, for the identical reason: a value the
// runtime silently ignored must not then cap anything.
@symbol("bit_rt_port_root_gc_env_workers_explicit") fn gcEnvWorkersExplicit(): bool {
  let vp = gcEnvValuePtr("BIT_WORKERS")
  if (vp < 0) {
    return false
  }
  return gcCstrUsize(vp) > 0
}

// `configFromEnv`'s `BIT_GC_STATS`: `1` or `on` enables the per-collection line;
// anything else (including unset) keeps the default.
@symbol("bit_rt_port_root_gc_env_verbose") fn gcEnvVerbose(def: bool): bool {
  let vp = gcEnvValuePtr("BIT_GC_STATS")
  if (vp < 0) {
    return def
  }
  if (gcCstrEq(vp, "1") || gcCstrEq(vp, "on")) {
    return true
  }
  return def
}

// `Gc.init(&g_heap, configFromEnv(environ))`, the config half: parse the four
// `rootConfigure` knobs over the defaults `boot` supplies and apply them through
// the existing `rootConfigure` (which keeps the "values handed in" contract). One
// pinned port-internal entry `boot` reaches by import — the reference must resolve
// to a pinned symbol, the `bit_rt_port_root_*` gap #1612 records — never renamed,
// as it names no ABI.md symbol — `configFromEnv` is internal.
export @symbol("bit_rt_port_root_configure_env") fn rootConfigureFromEnv(
  enabled: bool,
  stress: bool,
  minTrigger: int,
  growthPct: int,
  verbose: bool,
) {
  rootConfigure(
    gcEnvEnabled(enabled), gcEnvStress(stress),
    gcEnvMinTrigger(minTrigger), gcEnvGrowthPct(growthPct),
    gcEnvVerbose(verbose),
  )
}

// The `BIT_GC_STATS` half, split out for the same cross-module reason as
// `rootEnvMarkStack`: the boot code needs the ANSWER as well as the effect,
// because the `[bit-gc]` line the flag asks for is printed by boot (#1639) — the
// collector itself is `@nosplit` all the way down and cannot emit a byte
// (`runtime/gc` deviation 6). `rootConfigureFromEnv` still applies it; this only
// reports what it decided.
export @symbol("bit_rt_port_root_env_verbose") fn rootEnvVerbose(def: bool): bool {
  return gcEnvVerbose(def)
}

// The `BIT_GC_MARKSTACK` half, split out because the mark worklist is sized at
// `gcInit` (`rootInit`), before `rootConfigure` runs. Pinned port-internal for the
// same cross-module reason as `rootConfigureFromEnv`.
export @symbol("bit_rt_port_root_env_mark_stack") fn rootEnvMarkStack(def: int): int {
  return gcEnvMarkStack(def)
}

// The `BIT_WORKERS` half (#1900). Same cross-module pinning reason as the two
// above: `boot` is a `--freestanding` emit and may not name a mangled callee.
export @symbol("bit_rt_port_root_env_workers") fn rootEnvWorkers(def: int): int {
  return gcEnvWorkers(def)
}

// #4313: whether `BIT_WORKERS` was explicit, so `boot`/`bootworker` can turn
// that into a hard growth ceiling. Same cross-module pinning reason as
// `rootEnvWorkers` above.
export @symbol("bit_rt_port_root_env_workers_explicit") fn rootEnvWorkersExplicit(): bool {
  return gcEnvWorkersExplicit()
}

// #4325: the `workersCeiling` decision `boot`'s step 4 makes, extracted so
// both platform copies (../darwin/boot.bit, ../linux/boottail.bit) share ONE
// branch instead of each carrying an identical `if (workersExplicit) {
// workersCeiling = nworkers }` — that duplicated branch is what pushed both
// past their `tools/build/complexity-debt.txt` baseline when #4313 added it.
// `clamped` is `nworkers` after boot's own `< 1`/`> bootMaxWorkers` clamp;
// this returns 0 ("no ceiling") unless `BIT_WORKERS` was explicit.
export @symbol("bit_rt_port_root_workers_ceiling") @nosplit fn rootWorkersCeiling(
  explicit: bool,
  clamped: int,
): int {
  if (explicit) {
    return clamped
  }
  return 0
}
