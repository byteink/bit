// Split out of slices.bit (#6092/epic #6160, spec/LINT.md's 800-line ceiling:
// slices.bit hit 812 with this block inline). Sibling file, same module —
// see slices.bit for the port's header and seams, `appendTarget`, `gcAddr`,
// `infoAddr`, `riSlice`, `slcBuf`/`slcLen`/`slcOff`/`slcCap`/`slcIsRef` and
// the rest of the ABI-offset constants it needs.
//
// ---------------------------------------------------------------------------
// #6092 / BIT_APPEND_FRESH (flag rollout, epic #6160)
// ---------------------------------------------------------------------------
//
// `rtSliceAppend`/`rtSliceAppendStr` above mutate a non-null `hIn`'s own
// header in place and return that same object — so two independent
// `append()` calls sharing a base that is never reassigned in between end up
// aliasing one header, and the later call's growth silently changes
// `len()` of the earlier call's already-returned result (#6092's repro:
// `x := append(base, 1); y := append(base, 1)` changes `len(x)`).
//
// `rtSliceAppendFresh`/`rtSliceAppendStrFresh` below fix it: a non-null
// `hIn` never has its own header fields written — only a freshly `gcAlloc`'d
// header carries the grown `buf`/`off`/`cap`/`len`, so `hIn` (and any
// earlier `append` result built from it) keeps reading its own length. The
// backing BUFFER can still be shared on a fit-in-capacity append (SPEC
// §12.6's documented hazard, unchanged): two results built from the same
// base can still clobber each other's newly written ELEMENT DATA in unused
// capacity. What the clone removes is only the header/length aliasing.
//
// TWO ENTRY POINTS, NOT ONE FLAG-CHECKING FUNCTION, because the choice is
// made at COMPILE TIME, not at run time: `compiler/lowerappend.bit` emits a
// call to the `_fresh` symbol when `BIT_APPEND_FRESH=1` (a compiler-side
// env read, `appendFreshEnabled()`, compiler/lowerappend.bit) and to the
// unchanged symbol above otherwise. This runtime file has no env-reading of
// its own — a `@nosplit` leaf calling `bit_rt_port_getenv` mid-append would
// be new surface with nothing to gain, since the compiler already knows
// which behaviour a given binary wants for the whole build.
//
// FLAG OFF MUST BE BYTE-IDENTICAL TO MAIN: `rtSliceAppend`/`rtSliceAppendStr`
// above are UNCHANGED from before #6092 (verified by `cmp` against a
// pre-#6092 build, task-6092's report). Every difference #6092 makes lives
// only in these two new symbols and in the compiler's choice to call them,
// both gated on the flag — never in the two symbols every existing binary
// already calls.
//
// DEFAULT OFF UNTIL THE STAGE0 REPIN, the same two-step rollout shape #6245's
// three deleted flags used while the pinned oracle still defaulted them off:
// the pinned 0.31.0 oracle emits the OLD in-place-mutate IR shape for
// `append`, so a compiler that always chose
// `_fresh` would diverge from it on every corpus file with a spare-capacity
// append, and the selfhost object differentials (`scripts/selfhost-diffall.sh`)
// would read every one of those as a regression instead of the intentional
// fix it is. `BIT_APPEND_FRESH=1` turns it on; `_tests_/bit/appendfresh.bit`
// (test-appendfresh, tools/build/gates.bit) is the flag-on regression
// coverage, built and run outside the stage0-compiled `_tests_/cases/`
// corpus for the identical reason `_tests_/bit/dcemethods.bit` is.
//
// Delete both this block and `rtSliceAppend`/`rtSliceAppendStr`'s in-place
// mutation above once the flip ticket lands `_fresh` as the only behaviour.

// `bit_rt_slice_append_fresh`: `rtSliceAppend`'s #6092 fix, appending one
// word and DOUBLING FROM 1 when full exactly as the unchanged version above
// does, but returning an INDEPENDENT header whenever `hIn` is non-null.
//
// A NULL HEADER APPENDS INTO A FRESH SLICE (#1564/#1570) exactly as above:
// that fresh header (from `appendTarget`/`rtSliceNew`) is mutated in place
// below — safely, since nothing else can hold a reference to a header this
// same call just allocated.
export @nosplit @symbol("bit_rt_slice_append_fresh") fn rtSliceAppendFresh(
  hIn: int,
  word: int,
  isRef: int,
  elemSize: int,
): int {
  let h = appendTarget(hIn, isRef, elemSize)
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let bufIsRef = loadWord(h + slcIsRef)
  let packed = elemSize != 8 && bufIsRef == 0
  let buf = loadWord(h + slcBuf)
  // Every field read above comes from `h` BEFORE any write below touches
  // anything — `h` itself is never mutated past this point: the grow copy
  // and the new element land in local `buf`/`off`/`vcap`, and only the
  // header this function returns (`h` itself when `hIn == 0`, a fresh clone
  // otherwise, below) ever observes them.
  if (vlen == vcap) {
    let newcap = vcap * 2
    if (vcap == 0) {
      newcap = 1
    }
    let nb = allocBuf(newcap, bufIsRef != 0, elemSize)
    if (packed) {
      copyBytes(nb, buf + off * elemSize, vlen * elemSize)
    } else {
      let i = 0
      while (i < vlen) {
        let w = loadWord(buf + (off + i) * 8)
        storeWord(nb + i * 8, w)
        i = i + 1
      }
    }
    buf = nb
    off = 0
    vcap = newcap
  }
  if (packed) {
    if (elemSize == 1) {
      storeByte(buf + off + vlen, word)
    } else {
      storeWord(buf + (off + vlen) * elemSize, word)
    }
  } else {
    storeWord(buf + (off + vlen) * 8, word)
  }
  // `hIn == 0`: `h` is the header `appendTarget` just allocated for THIS
  // call alone, unreachable from anywhere else — safe to finish filling in
  // place. `hIn != 0`: `h` is the caller's own header, already reachable
  // through whatever binding named it, so a second live result (another
  // `append` call on the same `hIn`, never reassigned in between) must not
  // observe this call's growth through it. Clone instead (`rtSliceNew`/
  // `rtSliceSlice` allocate the identical way).
  let nh = h
  if (hIn != 0) {
    let g = wordAt(gcAddr)
    let base = infoAddr
    nh = gcAlloc(g, base + riSlice * 8)
    storeWord(nh + slcIsRef, bufIsRef)
  }
  storeWord(nh + slcBuf, buf)
  storeWord(nh + slcOff, off)
  storeWord(nh + slcCap, vcap)
  storeWord(nh + slcLen, vlen + 1)
  return nh
}

// `bit_rt_slice_append_str_fresh`: `rtSliceAppendStr`'s #6092 fix, same
// clone-when-shared rule as `rtSliceAppendFresh` above. `n == 0` returns the
// unmodified header — sound for the identical reason: nothing has appended
// anything for anyone to alias, so `hIn` reappearing in the result observes
// no state that was not already there.
export @nosplit @symbol("bit_rt_slice_append_str_fresh") fn rtSliceAppendStrFresh(
  hIn: int,
  s: int,
): int {
  let h = appendTarget(hIn, 0, 1)
  let n = strSize(s)
  if (n == 0) {
    return h
  }
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let bufIsRef = loadWord(h + slcIsRef)
  let buf = loadWord(h + slcBuf)
  let want = vlen + n
  if (want > vcap) {
    let newcap = vcap * 2
    if (newcap < want) {
      newcap = want
    }
    let nb = allocBuf(newcap, bufIsRef != 0, 1)
    copyBytes(nb, buf + off, vlen)
    buf = nb
    off = 0
    vcap = newcap
  }
  copyBytes(buf + off + vlen, strBytes(s), n)
  // Same clone-when-shared rule as `rtSliceAppendFresh` — see its comment.
  let nh = h
  if (hIn != 0) {
    let g = wordAt(gcAddr)
    let base = infoAddr
    nh = gcAlloc(g, base + riSlice * 8)
    storeWord(nh + slcIsRef, bufIsRef)
  }
  storeWord(nh + slcBuf, buf)
  storeWord(nh + slcOff, off)
  storeWord(nh + slcCap, vcap)
  storeWord(nh + slcLen, want)
  return nh
}

// `bit_rt_slice_append_slice_fresh`: `rtSliceAppendSlice`'s #6092 twin (#7377),
// same grow-once and overlap-safe move, same clone-when-shared rule as
// `rtSliceAppendFresh` above. `h` is never written, so when `src` is `h` its
// `buf`/`off` still name the original elements after a grow.
export @nosplit @symbol("bit_rt_slice_append_slice_fresh") fn rtSliceAppendSliceFresh(
  hIn: int,
  src: int,
  isRef: int,
  elemSize: int,
): int {
  let h = appendTarget(hIn, isRef, elemSize)
  let n = sliceLenOrZero(src)
  if (n == 0) {
    return h
  }
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let bufIsRef = loadWord(h + slcIsRef)
  let buf = loadWord(h + slcBuf)
  let st = sliceStride(bufIsRef, elemSize)
  let want = vlen + n
  if (want > vcap) {
    let newcap = vcap * 2
    if (newcap < want) {
      newcap = want
    }
    let nb = allocBuf(newcap, bufIsRef != 0, elemSize)
    copyBytes(nb, buf + off * st, vlen * st)
    buf = nb
    off = 0
    vcap = newcap
  }
  let from = loadWord(src + slcBuf) + loadWord(src + slcOff) * st
  moveBytes(buf + (off + vlen) * st, from, n * st)
  // Same clone-when-shared rule as `rtSliceAppendFresh` — see its comment.
  let nh = h
  if (hIn != 0) {
    let g = wordAt(gcAddr)
    let base = infoAddr
    nh = gcAlloc(g, base + riSlice * 8)
    storeWord(nh + slcIsRef, bufIsRef)
  }
  storeWord(nh + slcBuf, buf)
  storeWord(nh + slcOff, off)
  storeWord(nh + slcCap, vcap)
  storeWord(nh + slcLen, want)
  return nh
}
