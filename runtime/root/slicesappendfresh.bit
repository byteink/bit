// Split out of slices.bit (#6092/epic #6160, spec/LINT.md's 800-line ceiling:
// slices.bit hit 812 with this block inline). Sibling file, same module —
// see slices.bit for the port's header and seams, `appendTarget`, `gcAddr`,
// `infoAddr`, `riSlice`, `slcBuf`/`slcLen`/`slcOff`/`slcCap`/`slcIsRef` and
// the rest of the ABI-offset constants it needs.
//
// #6092/#6175: append preserves an existing destination header. The backing
// buffer may still be shared when spare capacity fits (SPEC §12.6); only the
// header is independent. These entry points never overwrite a non-null
// caller's header, so a saved slice keeps its own length after another append.
//
// Lowering always emits these fresh names. The ownership pass may instead
// choose the corresponding mutating runtime name when no other holder can
// observe the header mutation. Both kinds may occur in one binary, with no
// compiler or runtime environment selector. All six runtime symbols remain.
//
// `_tests_/cases/run_append_headers.bit` pins saved-header behavior for element,
// string and spread appends, escapes, owned fields, and loop bounds.

// `bit_rt_slice_append_fresh`: `rtSliceAppend`'s #6092 fix, appending one
// word and DOUBLING FROM 1 when full exactly as the unchanged version above
// does, but returning an INDEPENDENT header whenever `hIn` is non-null.
//
// A NULL HEADER APPENDS INTO A FRESH SLICE (#1564/#1570) exactly as above:
// that fresh header (from `appendTarget`/`rtSliceNew`) is mutated in place
// below — safely, since nothing else can hold a reference to a header this
// same call just allocated.
export @nosplit @symbol("bit_rt_slice_append_fresh") fn rtSliceAppendFresh(
  hIn: int,
  word: int,
  isRef: int,
  elemSize: int,
): int {
  let h = appendTarget(hIn, isRef, elemSize)
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let bufIsRef = loadWord(h + slcIsRef)
  let packed = elemSize != 8 && bufIsRef == 0
  let buf = loadWord(h + slcBuf)
  // Every field read above comes from `h` BEFORE any write below touches
  // anything — `h` itself is never mutated past this point: the grow copy
  // and the new element land in local `buf`/`off`/`vcap`, and only the
  // header this function returns (`h` itself when `hIn == 0`, a fresh clone
  // otherwise, below) ever observes them.
  if (vlen == vcap) {
    let newcap = vcap * 2
    if (vcap == 0) {
      newcap = 1
    }
    let nb = allocBuf(newcap, bufIsRef != 0, elemSize)
    if (packed) {
      copyBytes(nb, buf + off * elemSize, vlen * elemSize)
    } else {
      let i = 0
      while (i < vlen) {
        let w = loadWord(buf + (off + i) * 8)
        storeWord(nb + i * 8, w)
        i = i + 1
      }
    }
    buf = nb
    off = 0
    vcap = newcap
  }
  if (packed) {
    if (isPackedScalar(elemSize)) {
      storePacked(buf + (off + vlen) * elemSize, word, elemSize)
    } else {
      storeWord(buf + (off + vlen) * elemSize, word)
    }
  } else {
    storeWord(buf + (off + vlen) * 8, word)
  }
  // `hIn == 0`: `h` is the header `appendTarget` just allocated for THIS
  // call alone, unreachable from anywhere else — safe to finish filling in
  // place. `hIn != 0`: `h` is the caller's own header, already reachable
  // through whatever binding named it, so a second live result (another
  // `append` call on the same `hIn`, never reassigned in between) must not
  // observe this call's growth through it. Clone instead (`rtSliceNew`/
  // `rtSliceSlice` allocate the identical way).
  let nh = h
  if (hIn != 0) {
    let g = wordAt(gcAddr)
    let base = infoAddr
    nh = gcAlloc(g, base + riSlice * 8)
    storeWord(nh + slcIsRef, bufIsRef)
  }
  storeWord(nh + slcBuf, buf)
  storeWord(nh + slcOff, off)
  storeWord(nh + slcCap, vcap)
  storeWord(nh + slcLen, vlen + 1)
  return nh
}

// `bit_rt_slice_append_str_fresh`: `rtSliceAppendStr`'s #6092 fix, same
// clone-when-shared rule as `rtSliceAppendFresh` above. `n == 0` returns the
// unmodified header — sound for the identical reason: nothing has appended
// anything for anyone to alias, so `hIn` reappearing in the result observes
// no state that was not already there.
export @nosplit @symbol("bit_rt_slice_append_str_fresh") fn rtSliceAppendStrFresh(
  hIn: int,
  s: int,
): int {
  let h = appendTarget(hIn, 0, 1)
  let n = strSize(s)
  if (n == 0) {
    return h
  }
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let bufIsRef = loadWord(h + slcIsRef)
  let buf = loadWord(h + slcBuf)
  let want = vlen + n
  if (want > vcap) {
    let newcap = vcap * 2
    if (newcap < want) {
      newcap = want
    }
    let nb = allocBuf(newcap, bufIsRef != 0, 1)
    copyBytes(nb, buf + off, vlen)
    buf = nb
    off = 0
    vcap = newcap
  }
  copyBytes(buf + off + vlen, strBytes(s), n)
  // Same clone-when-shared rule as `rtSliceAppendFresh` — see its comment.
  let nh = h
  if (hIn != 0) {
    let g = wordAt(gcAddr)
    let base = infoAddr
    nh = gcAlloc(g, base + riSlice * 8)
    storeWord(nh + slcIsRef, bufIsRef)
  }
  storeWord(nh + slcBuf, buf)
  storeWord(nh + slcOff, off)
  storeWord(nh + slcCap, vcap)
  storeWord(nh + slcLen, want)
  return nh
}

// `bit_rt_slice_append_slice_fresh`: `rtSliceAppendSlice`'s #6092 twin (#7377),
// same grow-once and overlap-safe move, same clone-when-shared rule as
// `rtSliceAppendFresh` above. `h` is never written, so when `src` is `h` its
// `buf`/`off` still name the original elements after a grow.
export @nosplit @symbol("bit_rt_slice_append_slice_fresh") fn rtSliceAppendSliceFresh(
  hIn: int,
  src: int,
  isRef: int,
  elemSize: int,
): int {
  let h = appendTarget(hIn, isRef, elemSize)
  let n = sliceLenOrZero(src)
  if (n == 0) {
    return h
  }
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let bufIsRef = loadWord(h + slcIsRef)
  let buf = loadWord(h + slcBuf)
  let st = sliceStride(bufIsRef, elemSize)
  let want = vlen + n
  if (want > vcap) {
    let newcap = vcap * 2
    if (newcap < want) {
      newcap = want
    }
    let nb = allocBuf(newcap, bufIsRef != 0, elemSize)
    copyBytes(nb, buf + off * st, vlen * st)
    buf = nb
    off = 0
    vcap = newcap
  }
  let from = loadWord(src + slcBuf) + loadWord(src + slcOff) * st
  moveBytes(buf + (off + vlen) * st, from, n * st)
  // Same clone-when-shared rule as `rtSliceAppendFresh` — see its comment.
  let nh = h
  if (hIn != 0) {
    let g = wordAt(gcAddr)
    let base = infoAddr
    nh = gcAlloc(g, base + riSlice * 8)
    storeWord(nh + slcIsRef, bufIsRef)
  }
  storeWord(nh + slcBuf, buf)
  storeWord(nh + slcOff, off)
  storeWord(nh + slcCap, vcap)
  storeWord(nh + slcLen, want)
  return nh
}
