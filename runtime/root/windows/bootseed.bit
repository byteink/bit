// The map hash seed draw (#7379), split out of `boot` to keep that file under
// the line ceiling. Same module as `boot`, so the call is module-scoped.
import { entropyFill } from "../../rand/windows"
import { rootHashSeedInit } from "../../root"

// The 8 CSPRNG bytes the seed is made of. Module state because a local is not
// addressable; written once, while boot is still the only thread.
let bootSeedWord: [1]i64

// Initialized once before workers start; fatal paths only read these words.
let workerLifetimeMsg: [7]i64

// Draw the seed and install it (../hashseed.bit). Runs before anything can
// build a map; a failed draw is fatal there unless `BIT_HASH_SEED` names the
// seed, because a fixed seed is the hash flooding hole the draw closes.
fn bootSeedHash() {
  let seedBytes: *u8 = nil
  let drawn = entropyFill(seedBytes + int(ptrOf(bootSeedWord)), 8)
  rootHashSeedInit(u64(bootSeedWord[0]), drawn)
  let msg: *i64 = ptrOf(workerLifetimeMsg)
  *msg = int(msg) + 16
  *(msg + 1) = 35
  *(msg + 2) = 7308345369373991795
  *(msg + 3) = 8243112832212082802
  *(msg + 4) = 7883960601547467808
  *(msg + 5) = 8319662987961245797
  *(msg + 6) = 6579572
}

@nosplit fn workerCheckExit(s: *i64, stopped: bool) {
  // mainDone closes the race before the boot thread publishes scStopping.
  if (stopped || atomicLoad(s + scStopping) != 0 || atomicLoad(ptrOf(mainDone)) != i32(0)) {
    return
  }
  rootFatal(int(ptrOf(workerLifetimeMsg)))
}

fn workerRetireTask(w: *i64) {
  let doneTask = *(w + wkLastDone)
  if (doneTask != 0 && doneTask != int(ptrOf(mainTaskBlock))) {
    let dt = taskAt(doneTask)
    // #3992: `winRetireTaskStack` (./bootstack.bit) releases the WHOLE
    // reservation `mapGuardedStack` made for this task, using the
    // pre-alignment base `rtSpawn` recorded at `winTaskStackRegion` — see
    // that function's own header for why this replaces, rather than adds
    // to, the `unmapPages(taskStackBase, taskStackBytes)` decommit this
    // branch used to make. Kept out of this branch's own body, matching
    // `mapGuardHole`/`guardedStackBase`'s precedent, so a `workerBody`
    // already over its complexity/line ceilings on `main` does not climb
    // further because of this fix.
    winRetireTaskStack(int(*(dt + winTaskStackRegion)))
    // #4120: same fix, the task block's own reservation — see
    // `winRetireTaskBlock`'s own header.
    winRetireTaskBlock(doneTask)
  }
}
