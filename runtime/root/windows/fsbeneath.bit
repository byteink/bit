// `bit_rt_fs_open_beneath_w`/`bit_rt_fs_fstat_w` (ABI.md §14, #5793) for
// Windows: FAIL-CLOSED STUBS until #5808 implements them for real.
//
// They exist because the Windows admission check (E0078) validates every
// extern a program's included modules declare, not just the ones it calls:
// without these two symbols, anything importing `std/fs/secure`, and
// therefore every program importing pkg/web (its static serving uses
// `openBeneath`), would stop building for `--target x86_64-windows`.
//
// Both return -1, the same "refused" result a symlink or `..` gets on POSIX,
// so `openBeneath` fails and pkg/web's static serving answers 404 on
// Windows. Nothing falls back to an unsafe path-based open. Same module as
// `./fs.bit`: a sibling file in this directory, so no import is needed.
export @nosplit @symbol("bit_rt_fs_open_beneath_w") fn rtFsOpenBeneathW(
  rootWords: int, rootN: int, relWords: int, relN: int,
): int {
  return 0 - 1
}

export @nosplit @symbol("bit_rt_fs_fstat_w") fn rtFsFstatW(fd: int, out: int): int {
  return 0 - 1
}
