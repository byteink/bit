// `bit_rt_fs_open_beneath_w`/`bit_rt_fs_fstat_w` (ABI.md §14, #5793) for
// Windows: FAIL-CLOSED STUBS until #5808 implements them for real.
//
// They exist because the Windows admission check (E0078) validates every
// extern a program's included modules declare, not just the ones it calls:
// without these two symbols, anything importing `std/fs/secure`, and
// therefore every program importing pkg/web (its static serving uses
// `openBeneath`), would stop building for `--target x86_64-windows`.
//
// Both return -1, the same "refused" result a symlink or `..` gets on POSIX,
// so `openBeneath` fails and pkg/web's static serving answers 404 on
// Windows. Nothing falls back to an unsafe path-based open. Same module as
// `./fs.bit`: a sibling file in this directory, so no import is needed.
export @nosplit @symbol("bit_rt_fs_open_beneath_w") fn rtFsOpenBeneathW(
  rootWords: int, rootN: int, relWords: int, relN: int,
): int {
  return 0 - 1
}

export @nosplit @symbol("bit_rt_fs_fstat_w") fn rtFsFstatW(fd: int, out: int): int {
  return 0 - 1
}

// `bit_rt_fs_open_dir_w`/`bit_rt_fs_open_dir_beneath_fd_w`/
// `bit_rt_fs_list_dir_fd_w` (#5800) for Windows: FAIL-CLOSED STUBS, same
// reason and same shape as the two above — `walkBeneath` (std/fs/secure)
// fails every call, so `walk` and any caller of `walkBeneath` gets an
// error, never an unsafe path-based directory listing. New ground, not a
// regression: no Windows leg existed for this before #5800 either.
export @nosplit @symbol("bit_rt_fs_open_dir_w") fn rtFsOpenDirW(words: int, n: int): int {
  return 0 - 1
}

export @nosplit @symbol("bit_rt_fs_open_dir_beneath_fd_w") fn rtFsOpenDirBeneathFdW(
  dirFd: int, nameWords: int, nameN: int,
): int {
  return 0 - 1
}

export @nosplit @symbol("bit_rt_fs_list_dir_fd_w") fn rtFsListDirFdW(
  fd: int, outPtr: int, outCap: int,
): int {
  return 0 - 1
}

// `bit_rt_fs_unlink_at_w` (#5816) for Windows: FAIL-CLOSED STUB, same reason
// and same shape as the four above — `removeAll` (std/fs/secure) fails every
// call, so a caller gets an error, never a partially-completed or unsafe
// removal. New ground, not a regression: no Windows leg existed for this
// before #5816 either.
export @nosplit @symbol("bit_rt_fs_unlink_at_w") fn rtFsUnlinkAtW(
  dirFd: int, nameWords: int, nameN: int, isDir: bool,
): int {
  return 0 - 1
}
