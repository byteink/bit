// Windows time provider for the SEAM 3 remainder (#3333, epic #3322): the
// two `bit_rt_time_*` ABI symbols (ABI.md §18) Windows can support today —
// `bit_rt_time_mono_ns` and `bit_rt_time_unix_ns`. This is the Bit form of
// ../linux/time.bit's and ../darwin/time.bit's time block, for the two of
// its three members Windows has the machinery for; see "TWO SYMBOLS, NOT
// THREE" below for the third.
//
// READ ../linux/time.bit's HEADER FIRST — same shape, same reasoning per
// symbol; this header only states where Windows differs.
//
// ---------------------------------------------------------------------------
// TWO SYMBOLS, NOT THREE
// ---------------------------------------------------------------------------
//
// `bit_rt_time_sleep_ns` (ABI.md §18) is deliberately NOT exported from this
// file. ../linux and ../darwin's version parks the task on the scheduler's
// timer queue via `schedSleepUntil`, relying on a worker's IDLE path to
// drive `schedTimerExpire` (`runtime/sched/worker.bit`'s `schedFindWorkIdle`,
// which takes a `nowFn`) and release it. ../windows/boot.bit's worker runs
// the always-busy-poll `schedFindWorkAt`/`schedWorkerStepAt` loop instead —
// its own header says so: "EXACTLY ONE WORKER, ALWAYS... there is no
// ../../park/windows (#3336) idle-wake primitive to park on yet." Nothing
// today drives that timer queue on Windows, so wiring `bit_rt_time_sleep_ns`
// onto `schedSleepUntil` now would park a task that never wakes.
// ../windows/boot.bit's own `winSleepNs` (OS-thread-blocking
// WaitForSingleObject) is its acknowledged stand-in until #3336 lands the
// real park and boot.bit's loop moves to the timer-driven
// `schedWorkerRun`/`schedFindWorkIdle` shape. Wiring the real cooperative
// sleep belongs to whoever lands #3336 (its own acceptance criteria require
// a working `sleep`) — #3333's acceptance names only the monotonic and wall
// clocks.
//
// ---------------------------------------------------------------------------
// MONOTONIC: PIN, not a port — same disposition as ../linux and ../darwin
// ---------------------------------------------------------------------------
//
// `winMonoNs()` already exists, in ../windows/boot.bit, as (boot.bit's own
// words) "this file's own minimal stand-in for... ../windows/time.bit
// (#3333)": QueryPerformanceCounter scaled by a QueryPerformanceFrequency
// read once and cached in `winQpcFreq`, reused by this module's own
// worker/idle-wait loop. `bit_rt_time_mono_ns` below PINS that existing
// implementation rather than opening a second QPC read — the same move
// ../linux/time.bit makes over `parkMonoNs`. Redeclaring
// `extern fn QueryPerformanceCounter`/`QueryPerformanceFrequency` here would
// also be a straight E0042 module-scope redeclaration: both are already
// declared in boot.bit, and this directory is one module. See
// boot.bit's `winMonoNs` for the scaling arithmetic and its overflow
// argument (ticks split into whole seconds and remainder before the
// multiply by 1e9, so it cannot exceed i64 even after weeks of uptime at a
// realistic QPC frequency) — this file does not repeat that reasoning, only
// exports it under the ABI name.
//
// ---------------------------------------------------------------------------
// WALL CLOCK: a real port, the one new declaration this file adds
// ---------------------------------------------------------------------------
//
// GetSystemTimeAsFileTime (admitted, compiler/pesyms.bit) writes an
// unsigned 64-bit FILETIME — 100-nanosecond intervals since 1601-01-01
// 00:00:00 UTC, a Windows/OLE convention with no relation to the Unix
// epoch — as two adjacent 32-bit words, low then high. On this
// little-endian target those two words are already the 64-bit integer when
// read through a `*i64`, the same "read the struct at its natural width"
// move ../darwin/time.bit makes for `timespec`. GetSystemTimeAsFileTime is
// documented to never fail (it has no return value at all), so unlike
// clock_gettime on the other two platforms there is no error path to check.
//
// ---------------------------------------------------------------------------
// SELF-CONTAINED — the only cross-file reach is a same-module sibling
// ---------------------------------------------------------------------------
//
// `winMonoNs` is declared in ../windows/boot.bit with no `export` on it (nor
// on `winQpcFreq`/`winQpcScratch`), and needs none: cross-file visibility
// inside one module does not require `export` — see ../linux/boottail.bit's
// un-exported `mainExitCode`, declared in ../linux/boot.bit and read back
// from a sibling file the same way. `GetSystemTimeAsFileTime`, the one new
// declaration this file adds, is not declared anywhere else in this module.
// No `import` statement of any kind is needed by this file.

extern fn GetSystemTimeAsFileTime(ft: *i64)

// 1601-01-01 to 1970-01-01, in seconds — derived, not pasted, so a transposed
// digit is checkable by re-deriving rather than by trusting a citation:
//
//   1970 - 1601 = 369 years
//   leap years among them (Gregorian rule): years divisible by 4, except a
//   century year unless also divisible by 400.
//     divisible by 4 in (1600, 1969]: floor(1969/4) - floor(1600/4)
//                                   = 492 - 400 = 92
//     minus the century years in range that are NOT divisible by 400:
//       1700, 1800, 1900 (1600 and 2000 are outside (1601, 1969]) -> 3
//     92 - 3 = 89 leap years
//   369 * 365 + 89 = 134685 + 89 = 134774 days
//   134774 * 86400 = 11644473600 seconds
//
// This matches the widely-cited Win32 epoch-offset constant (e.g. Go's
// syscall_windows.go `epochDiff = 116444736000000000`, the same value in
// FILETIME's own 100ns unit: 11644473600 * 10000000), which is corroboration
// of the derivation above, not the source of it.
const winEpochDiffSec: int = 11644473600
const hundredNsPerSec: int = 10000000
const nsPer100ns: int = 100

// `bit_rt_time_mono_ns` (ABI.md §18): monotonic nanoseconds; never jumps,
// measures elapsed. A PIN over `winMonoNs` — see the header above for why
// this is not a fresh QueryPerformanceCounter read. `@nosplit` because its
// only callee, `winMonoNs`, already is (boot.bit) — unlike ../linux and
// ../darwin, whose equivalent wrapper is NOT `@nosplit` because their own
// clock read (`parkMonoNs`) is not either. A Windows port diverging from
// both platforms needs a stated reason (the lesson #3356 left on this
// module): this is it, and `bit check` on this file is the proof — E0075
// would refuse the attribute outright if `winMonoNs` were not already safe.
export @nosplit @symbol("bit_rt_time_mono_ns") fn rtTimeMonoNs(): int {
  return winMonoNs()
}

// Scratch FILETIME word `GetSystemTimeAsFileTime` writes into. A single
// module-level cell, not the per-worker slot ../linux and ../darwin's
// `timeScratch` uses: this module runs exactly one worker today
// (../windows/boot.bit's own "EXACTLY ONE WORKER, ALWAYS"), so nothing else
// can be mid-write here when a task calls this function — the same premise
// boot.bit's own `winQpcScratch` already relies on for the identical reason.
// Revisit alongside #3336, which is what makes a second worker possible.
let winFiletimeScratch: i64 = 0

// `bit_rt_time_unix_ns` (ABI.md §18): wall-clock nanoseconds since the Unix
// epoch. Can jump (NTP, clock set), so it dates events and never measures
// durations. GetSystemTimeAsFileTime's 100ns-since-1601 ticks, shifted to
// the Unix epoch (`winEpochDiffSec`'s derivation above) and then scaled to
// nanoseconds — a subtract then a multiply, never a divide, so this loses no
// precision at any interval. The final multiply is the same order of
// magnitude ../linux and ../darwin's own `unix_ns` already returns
// (nanoseconds since 1970 fits `int` until the year 2262 — the same
// inherent limit every nanosecond-since-epoch clock in this runtime has,
// not a new one Windows introduces). `@nosplit` for the same reason as
// `rtTimeMonoNs` above: its only non-builtin callee is the single leaf
// kernel32 call `GetSystemTimeAsFileTime`, no park and no allocation, and
// `bit check` on this file is the proof.
export @nosplit @symbol("bit_rt_time_unix_ns") fn rtTimeUnixNs(): int {
  GetSystemTimeAsFileTime(ptrOf(winFiletimeScratch))
  let ticks100ns = int(winFiletimeScratch)
  let unixTicks100ns = ticks100ns - winEpochDiffSec * hundredNsPerSec
  return unixTicks100ns * nsPer100ns
}
