// Windows time provider for the SEAM 3 remainder (#3333, epic #3322) plus
// the real `bit_rt_time_sleep_ns` #3336 owed (see "SLEEP: NOW A REAL PORT"
// below): all three `bit_rt_time_*` ABI symbols (ABI.md §18). This is the
// Bit form of ../linux/time.bit's and ../darwin/time.bit's time block.
//
// READ ../linux/time.bit's HEADER FIRST — same shape, same reasoning per
// symbol; this header only states where Windows differs.
//
// ---------------------------------------------------------------------------
// SLEEP: NOW A REAL PORT (#3336), NOT A PLACEHOLDER
// ---------------------------------------------------------------------------
//
// `bit_rt_time_sleep_ns` used to be withheld here because "nothing today
// drives that timer queue on Windows" — WRONG, or at least imprecise: the
// worker loop has always called `schedFindWorkAt(w, now)` on every idle
// turn (../windows/boot.bit's `workerBody`, both before and after #3336),
// and `schedFindWorkAt` itself calls `schedTimerExpire(s, now)` internally
// — the timer queue was already driven, unconditionally, regardless of
// whether a worker parks or polls. What #3336 actually adds that this
// symbol needs is `runtime/park/windows`'s real `parkMonoNs`/`parkWait`, so
// a task parked on `schedSleepUntil` has a real wake path once its
// deadline's worker-side timer check fires. Same shape as ../linux and
// ../darwin: `schedSleepUntil`/`schedYield` park/yield the GREEN thread,
// never the OS thread — `parkSleepNs` (../../park/windows) remains the
// worker's own idle-backoff primitive and is never called from here.
//
// ---------------------------------------------------------------------------
// MONOTONIC: PIN, not a port — same disposition as ../linux and ../darwin
// ---------------------------------------------------------------------------
//
// `bit_rt_time_mono_ns` below PINS `../../park/windows`'s `parkMonoNs`
// (QueryPerformanceCounter scaled by a QueryPerformanceFrequency read once
// and cached) rather than opening a second QPC read — the same move
// ../linux/time.bit makes over its own `parkMonoNs`. This file used to pin
// a private `winMonoNs` that lived in ../windows/boot.bit; that function
// moved to the park provider with #3336 (see its own header for why: a
// module-level scratch word raced under a real multi-worker pool, which a
// single-worker Windows port never exercised).
//
// ---------------------------------------------------------------------------
// WALL CLOCK: a real port
// ---------------------------------------------------------------------------
//
// GetSystemTimeAsFileTime (admitted, compiler/pesyms.bit) writes an
// unsigned 64-bit FILETIME — 100-nanosecond intervals since 1601-01-01
// 00:00:00 UTC, a Windows/OLE convention with no relation to the Unix
// epoch — as two adjacent 32-bit words, low then high. On this
// little-endian target those two words are already the 64-bit integer when
// read through a `*i64`, the same "read the class at its natural width"
// move ../darwin/time.bit makes for `timespec`. GetSystemTimeAsFileTime is
// documented to never fail (it has no return value at all), so unlike
// clock_gettime on the other two platforms there is no error path to check.
//
// Reads into `timeScratch()` below rather than a private module-level word:
// `bit_rt_time_unix_ns` is callable concurrently by every worker, same
// hazard as `parkMonoNs`'s own header describes, so it needs the identical
// per-worker scratch rather than a second shared cell.

import { schedSleepUntil, schedYield } from "../../sched"
// `parkMonoNs` (from "../../park/windows") and `wkId`/`schedCurrentWorker`/
// `schedMaxWorkers` (from "../../sched") are already imported into this
// module by ./boot.bit and ./io.bit respectively; `taskAt` and `wkSleepReq`
// (from "../../sched") likewise by ./boot.bit — an import is per-MODULE,
// not per-file, so re-importing any of them here would be E0042.

extern fn GetSystemTimeAsFileTime(ft: *i64)

// A dedicated `[2]i64` fallback, used only when the caller is not running on
// a task (`schedCurrentWorker() == 0`) and so has no per-worker `wkSleepReq`
// scratch to reach — the same rare, kept-total-rather-than-undefined case
// ../linux/time.bit's own `timeFallbackScratch` documents.
let timeFallbackScratch: [2]i64

// The 2-word scratch `parkMonoNs`/QueryPerformanceCounter and
// `GetSystemTimeAsFileTime` write into (#2318's caller-owned-block pattern):
// the current task's own worker's `wkSleepReq`, or the shared fallback when
// there is no current task. Verbatim ../linux/time.bit's `timeScratch`.
@nosplit fn timeScratch(): *i64 {
  let w = schedCurrentWorker()
  if (w == 0) {
    return ptrOf(timeFallbackScratch)
  }
  return taskAt(w) + wkSleepReq
}

// 1601-01-01 to 1970-01-01, in seconds — derived, not pasted, so a transposed
// digit is checkable by re-deriving rather than by trusting a citation:
//
//   1970 - 1601 = 369 years
//   leap years among them (Gregorian rule): years divisible by 4, except a
//   century year unless also divisible by 400.
//     divisible by 4 in (1600, 1969]: floor(1969/4) - floor(1600/4)
//                                   = 492 - 400 = 92
//     minus the century years in range that are NOT divisible by 400:
//       1700, 1800, 1900 (1600 and 2000 are outside (1601, 1969]) -> 3
//     92 - 3 = 89 leap years
//   369 * 365 + 89 = 134685 + 89 = 134774 days
//   134774 * 86400 = 11644473600 seconds
//
// This matches the widely-cited Win32 epoch-offset constant (e.g. Go's
// syscall_windows.go `epochDiff = 116444736000000000`, the same value in
// FILETIME's own 100ns unit: 11644473600 * 10000000), which is corroboration
// of the derivation above, not the source of it.
const winEpochDiffSec: int = 11644473600
const hundredNsPerSec: int = 10000000
const nsPer100ns: int = 100

// `bit_rt_time_mono_ns` (ABI.md §18): monotonic nanoseconds; never jumps,
// measures elapsed. A PIN over `../../park/windows`'s `parkMonoNs` — see the
// header above for why this is not a fresh QueryPerformanceCounter read.
// `@nosplit` because `parkMonoNs` and `timeScratch` both already are — same
// disposition as ../linux/time.bit's own `rtTimeMonoNs` over its
// `parkMonoNs`; `bit check` on this file is the proof, since E0075 would
// refuse the attribute outright if either callee were not already safe.
export @nosplit @symbol("bit_rt_time_mono_ns") fn rtTimeMonoNs(): int {
  return parkMonoNs(timeScratch())
}

// `bit_rt_time_unix_ns` (ABI.md §18): wall-clock nanoseconds since the Unix
// epoch. Can jump (NTP, clock set), so it dates events and never measures
// durations. GetSystemTimeAsFileTime's 100ns-since-1601 ticks, shifted to
// the Unix epoch (`winEpochDiffSec`'s derivation above) and then scaled to
// nanoseconds — a subtract then a multiply, never a divide, so this loses no
// precision at any interval. The final multiply is the same order of
// magnitude ../linux and ../darwin's own `unix_ns` already returns
// (nanoseconds since 1970 fits `int` until the year 2262 — the same
// inherent limit every nanosecond-since-epoch clock in this runtime has,
// not a new one Windows introduces).
//
// Writes into `timeScratch()`'s buffer rather than a private module cell —
// see the header above: this is callable concurrently by every worker, and
// only the caller-owned scratch is race-free under that. `@nosplit` for the
// same reason as `rtTimeMonoNs`: its only non-builtin callees are
// `timeScratch` and the single leaf kernel32 call
// `GetSystemTimeAsFileTime` — no park, no allocation.
export @nosplit @symbol("bit_rt_time_unix_ns") fn rtTimeUnixNs(): int {
  let scratch = timeScratch()
  GetSystemTimeAsFileTime(scratch)
  let ticks100ns = int(*scratch)
  let unixTicks100ns = ticks100ns - winEpochDiffSec * hundredNsPerSec
  return unixTicks100ns * nsPer100ns
}

// `bit_rt_time_sleep_ns` (ABI.md §18): park the calling GREEN thread for at
// least `ns`, leaving its worker free to run other tasks. Verbatim
// ../linux/time.bit's `rtTimeSleepNs` — see the header above for why this
// symbol can now be exported at all. NOT `parkSleepNs`: that blocks the OS
// thread and would freeze the worker's other tasks, defeating the point of a
// green-thread sleep (ABI.md §18: "Never blocks the OS thread").
export @symbol("bit_rt_time_sleep_ns") fn rtTimeSleepNs(ns: int) {
  if (ns <= 0) {
    schedYield()
    return
  }
  let now = parkMonoNs(timeScratch())
  // The deadline handed to schedSleepUntil is ABSOLUTE (now + ns), so a
  // relative duration close to i64max overflows that addition and wraps
  // negative, waking the green thread almost immediately instead of after
  // ~292 years. Clamp the deadline to i64max rather than let it wrap.
  let deadline = 9223372036854775807
  if (ns <= 9223372036854775807 - now) {
    deadline = now + ns
  }
  schedSleepUntil(deadline)
}
