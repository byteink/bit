// The byte-oriented half of the Windows filesystem provider (#3334, epic
// #3322): `bit_rt_fs_read`, `bit_rt_fs_read_all` and `bit_rt_fs_write` — the
// three `bit_rt_fs_*` ABI wrappers (ABI.md §14) that operate on an
// already-open handle rather than a path. Split out of ./fs.bit at write
// time (816 lines, `spec/LINT.md` §4's 800-line limit, E0200), matching
// ../linux/fsrw.bit's own #3274 split exactly: path-taking operations (open,
// exists, isDir, mkdir, remove, rename, listDir, the symlink probe) stay in
// ./fs.bit; the three functions that instead take an already-open handle and
// move bytes move here. A real, nameable seam, not an arbitrary line cut —
// see ../linux/fsrw.bit's own header for why this is the established
// criterion in this file family.
//
// Sibling of ./fs.bit in the same directory, so this is the SAME MODULE (an
// import is per-module, not per-file) — nothing here needs a new import:
// `emptyStr`, `hAt`, `u8At`, `strData`, `strLenOf`, `fsScratchSlot`,
// `fsIoWordScratch`, `fsSizeScratch`, `fsPathBufW`, `fsWinPathUnits`,
// `fsWinPathBytes`, `fsNameScratchBytes` are ./fs.bit's own module-scoped
// declarations; `rtStrAlloc`/`rtStringSlice`/`rtFsReadAllFailedSet` and
// `gcSyscallBegin`/`gcSyscallEnd` are ./fs.bit's own imports; `ReadFile`/
// `GetFileSizeEx` are ./fs.bit's own `extern fn` declarations; `WriteFile` is
// ./io.bit's; `winUtf16ToUtf8` is ./os.bit's. All already in scope with no
// `import` line here at all.
//
// See ./fs.bit's header for the full argument behind every device used
// below: HANDLEs are not fds (reinterpreted as `int` via `hAt`/`int()`), the
// `syscall`-not-`blocked` bracket choice (#2207), and why `rtFsReadAll` has
// no `EINTR`-retry loop on Windows.
//
// `bit_rt_fs_cwd` (#3501) is the one export below that takes no path at
// all — placed here, alongside `bit_rt_fs_sync`, purely for the same
// fd-vs-path split precedent ../linux/fsrw.bit and ../darwin/fsrw.bit both
// record for their own copies.
//
// ONE EXCEPTION to the "path-taking stays in ./fs.bit" line above (#3920):
// `bit_rt_fs_open_rw_w` IS path-taking and belongs beside `rtFsOpen`/
// `rtFsAppend` by that rule, but by the time it was added ./fs.bit sat at
// 741 of the 800-line ceiling with no room left. Kept here rather than
// opening a third file for one function.

// `bit_rt_fs_open_rw_w` (#3920): open the `n` packed-bytes path at `words`
// create+read-write, WITHOUT truncating existing content — same contract as
// `../linux/fsopenrw.bit` and `../darwin/fs.bit`'s `rtFsOpenReadWriteW`.
// Packed-bytes `(words, n)`, decoded via `wordsPathW` (`./fs.bit`, the
// Windows analogue of `../darwin/fs.bit`'s `wordsPathZ`) — not a Bit
// `string`, for the same SPEC §11.7 `extern fn` reason those siblings' own
// headers give.
//
// Combines two existing templates in `./fs.bit`: `rtFsOpen`'s (`:543`)
// access/disposition shape with `rtFsAppend`'s (`:576`) `winOpenAlways`
// disposition ("create if absent, keep existing content"). Access is
// `winGenericRead | winGenericWrite` (`:200-201`, OR'd the same way
// `rtFsChmod` OR's `winFileAttrReadonly` at `:725`).
//
// UNLIKE the POSIX siblings, no extra guard is free here: `open(2)` on
// Linux/Darwin already fails a directory with EISDIR for O_WRONLY/O_RDWR,
// but `CreateFileW` does not reject a directory the same way, so this
// applies the same explicit `isDirAtW` guard `rtFsOpen` uses (`./fs.bit`
// `:546-548`) before calling `CreateFileW` at all. Handle (as `int`) or -1.
export @nosplit @symbol("bit_rt_fs_open_rw_w") fn rtFsOpenReadWriteW(words: int, n: int): int {
  let p = wordsPathW(words, n)
  if (p == 0) {
    return 0 - 1
  }
  if (isDirAtW(p)) {
    return 0 - 1
  }
  let nilSec: *byte = nil
  let nilTemplate: *byte = nil
  let handle = CreateFileW(
    hAt(p),
    i32(winGenericRead | winGenericWrite),
    i32(winShareAll),
    nilSec,
    i32(winOpenAlways),
    i32(winFileAttrNormal),
    nilTemplate,
  )
  if (int(handle) == winInvalidHandle) {
    return 0 - 1
  }
  return int(handle)
}

// `bit_rt_fs_read`: up to `max` bytes from `fd` into a fresh string, trimmed
// to what arrived (empty at EOF — `ReadFile` reports success with 0 bytes
// transferred at end of file, unlike POSIX `read` returning 0 directly).
export @nosplit @symbol("bit_rt_fs_read") fn rtFsRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let big = rtStrAlloc(max)
  if (big == 0) {
    return emptyStr()
  }
  let handle = hAt(fd)
  let readPtr = ptrOf(fsIoWordScratch) + fsScratchSlot()
  let nilOverlapped: *byte = nil
  // THE `syscall` BRACKET IS LOAD-BEARING (#2207) — see ./fs.bit's header.
  // `big` is a live reference held across the call, so `syscall`, not
  // `blocked`.
  gcSyscallBegin()
  let ok = ReadFile(handle, u8At(strData(big)), i32(max), readPtr, nilOverlapped)
  let n = int(atomicLoad(readPtr))
  gcSyscallEnd()
  if (ok == i32(0) || n <= 0) {
    return emptyStr()
  }
  // `big` is `max`-byte throwaway scratch: nothing else ever references it
  // again after this call returns. Since #3897 `rtStringSlice` allocates a
  // header-only VIEW, so slicing it here would retain the whole `max` bytes
  // for as long as the returned string lives, not just `n` (#3902) — the
  // exact opposite of what a scratch buffer is for. Copy the `n` bytes
  // actually read into an exactly-sized string instead, so `big` becomes
  // garbage immediately; this is the pre-#3897 behaviour for this one call
  // site, restored deliberately. It does not reintroduce #3897's cost
  // anywhere else: ordinary `s[lo:hi]` on a live string still shares.
  let out = rtStrAlloc(n)
  if (out == 0) {
    return rtStringSlice(big, 0, n)
  }
  let dst = strData(out)
  let src = strData(big)
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  return out
}

// `bit_rt_fs_read_all`: the whole file as a fresh string, sized by
// `GetFileSizeEx` — simpler than the POSIX providers' `lseek(SEEK_END)` +
// `lseek(SEEK_SET, 0)` pair, since `GetFileSizeEx` never moves the handle's
// file pointer. Failure and allocation-exhaustion both report through the
// out-of-band `bit_rt_fs_read_all_failed()` companion (`rtFsReadAllFailedSet`,
// `runtime/root/slots.bit`), exactly as `../darwin/fs.bit`'s own
// `rtFsReadAll` does — a genuine empty file never sets it.
//
// A short read (an I/O error partway through) is NEVER zero-padded (#2990):
// the result is the string TRIMMED to the bytes actually verified read. No
// `EINTR`-retry loop — see ./fs.bit's header scope note for why Windows
// needs none here.
//
// BOUNDED (Power of 10 rule 2): `off` strictly increases by at least 1 each
// iteration that continues the loop, capped by `end`.
export @nosplit @symbol("bit_rt_fs_read_all") fn rtFsReadAll(fd: int): int {
  rtFsReadAllFailedSet(false)
  let handle = hAt(fd)
  let sizePtr = ptrOf(fsSizeScratch) + fsScratchSlot()
  let sizeOk = GetFileSizeEx(handle, sizePtr)
  let end = int(atomicLoad(sizePtr))
  if (sizeOk == i32(0)) {
    rtFsReadAllFailedSet(true)
    return emptyStr()
  }
  if (end == 0) {
    return emptyStr()
  }
  let s = rtStrAlloc(end)
  if (s == 0) {
    rtFsReadAllFailedSet(true)
    return emptyStr()
  }
  let base = strData(s)
  let off = 0
  let nilOverlapped: *byte = nil
  while (off < end) {
    let readPtr = ptrOf(fsIoWordScratch) + fsScratchSlot()
    // Bracketed for the same reason `rtFsRead` above is (#2207): `base`
    // points into a live string held across the call, so `syscall`.
    gcSyscallBegin()
    let ok = ReadFile(handle, u8At(base + off), i32(end - off), readPtr, nilOverlapped)
    let n = int(atomicLoad(readPtr))
    gcSyscallEnd()
    if (ok != i32(0) && n > 0) {
      off = off + n
    } else {
      // `s` is `end`-sized scratch; a short read here means `off < end`.
      // Since #3897 `rtStringSlice` allocates a header-only VIEW, so
      // trimming with it would retain the WHOLE `end`-sized buffer for as
      // long as the truncated result lives, not just the `off` bytes
      // actually read (#4089) — the same #3897 shape #3902 fixed for
      // `rtFsRead` above. Copy the `off` bytes into an exactly-sized
      // string instead, falling back to the view only if that allocation
      // itself fails.
      let out = rtStrAlloc(off)
      if (out == 0) {
        return rtStringSlice(s, 0, off)
      }
      let dst = strData(out)
      let i = 0
      while (i < off) {
        storeByte(dst + i, loadByte(base + i))
        i = i + 1
      }
      return out
    }
  }
  return s
}

// `bit_rt_fs_write`: write all of `s`'s bytes to `fd`. Byte count, or -1.
//
// BOUNDED (Power of 10 rule 2): `off` rises by at least 1 each iteration.
export @nosplit @symbol("bit_rt_fs_write") fn rtFsWrite(fd: int, s: int): int {
  let handle = hAt(fd)
  let total = strLenOf(s)
  let base = strData(s)
  let off = 0
  let nilOverlapped: *byte = nil
  while (off < total) {
    let writtenPtr = ptrOf(fsIoWordScratch) + fsScratchSlot()
    // Bracketed for the same reason as `rtFsRead` above (#2207): a write to
    // a full pipe or a slow device blocks, and `base` is a live reference
    // held across the call, so `syscall`.
    gcSyscallBegin()
    let ok = WriteFile(handle, u8At(base + off), i32(total - off), writtenPtr, nilOverlapped)
    let n = int(atomicLoad(writtenPtr))
    gcSyscallEnd()
    if (ok == i32(0)) {
      return 0 - 1
    }
    if (n <= 0) {
      return off
    }
    off = off + n
  }
  return off
}

// `OVERLAPPED`'s scratch (#3463), one 32-byte (4-word) slot per worker plus
// the fallback -- the identical PER-WORKER reasoning `fsIoWordScratch` above
// carries: two workers each mid-positional-call at the same real time must
// not share the struct the OS reads the requested offset from. 33 * 4 = 132
// words.
let fsOverlappedScratch: [132]i64

// Fills a fresh synchronous-mode `OVERLAPPED` at this worker's slot with
// `off` as the byte offset and every other field zeroed (`Internal`,
// `InternalHigh`, `hEvent` -- all unused for a synchronous handle) and
// returns its address. `Offset`/`OffsetHigh` are two adjacent little-endian
// DWORDs starting at struct byte 16 -- on a little-endian target (this
// runtime's only targets) that is exactly the low/high halves of one 64-bit
// store, so `off` (never negative -- a real file offset) writes both in one
// `storeWord`.
//
// A HANDLE OPENED WITHOUT `FILE_FLAG_OVERLAPPED` (`../fs.bit`'s single
// `CreateFileW` call, this whole module) STILL HONORS a non-NULL
// `lpOverlapped`'s offset: per MSDN's ReadFile/WriteFile remarks, passing
// one on a synchronous handle performs the I/O at that byte offset without
// moving the handle's own current file position, and still completes
// synchronously -- the call blocks and reports its result through
// `lpNumberOfBytesTransferred` directly, exactly like every other call in
// this file already relies on. This is the standard Win32 substitute for
// POSIX `pread`/`pwrite`; nothing here requires reopening the file.
@nosplit fn overlappedAt(off: int): int {
  let base = int(ptrOf(fsOverlappedScratch)) + fsScratchSlot() * 32
  storeWord(base, 0)
  storeWord(base + 8, 0)
  storeWord(base + 16, off)
  storeWord(base + 24, 0)
  return base
}

// `bit_rt_fs_pread_w`: up to `max` bytes from `fd` at absolute offset `off`
// into the caller-owned buffer at `buf` -- a `[]byte`'s packed backing store
// (ABI.md §2, #3121/#3226), the same convention `../linux/fsrw.bit`'s
// `bit_rt_fs_pread_w` uses. Byte count transferred, or -1 on any I/O error.
// A SHORT count (including 0 at end of file, which `ReadFile` reports as
// success with 0 bytes transferred rather than a POSIX-style negative/zero
// return) is NOT an error.
export @nosplit @symbol("bit_rt_fs_pread_w") fn rtFsPreadW(
  fd: int,
  buf: int,
  max: int,
  off: int,
): int {
  if (max <= 0) {
    return 0
  }
  let handle = hAt(fd)
  let readPtr = ptrOf(fsIoWordScratch) + fsScratchSlot()
  let ov = overlappedAt(off)
  // Bracketed for the same reason `rtFsRead` above is (#2207): `buf` is the
  // live `[]byte` backing store the caller still holds a reference to across
  // this call, so `syscall`, not `blocked`.
  gcSyscallBegin()
  let ok = ReadFile(handle, u8At(buf), i32(max), readPtr, hAt(ov))
  let n = int(atomicLoad(readPtr))
  gcSyscallEnd()
  if (ok == i32(0)) {
    return 0 - 1
  }
  return n
}

// `bit_rt_fs_pwrite_w`: write `n` bytes from `buf` (same packed-backing
// convention as `bit_rt_fs_pread_w` above) to `fd` at absolute offset `off`.
// Byte count transferred, or -1 on any I/O error.
export @nosplit @symbol("bit_rt_fs_pwrite_w") fn rtFsPwriteW(
  fd: int,
  buf: int,
  n: int,
  off: int,
): int {
  if (n <= 0) {
    return 0
  }
  let handle = hAt(fd)
  let writtenPtr = ptrOf(fsIoWordScratch) + fsScratchSlot()
  let ov = overlappedAt(off)
  // Bracketed for the same reason as above: `buf` is a live reference held
  // across the call.
  gcSyscallBegin()
  let ok = WriteFile(handle, u8At(buf), i32(n), writtenPtr, hAt(ov))
  let written = int(atomicLoad(writtenPtr))
  gcSyscallEnd()
  if (ok == i32(0)) {
    return 0 - 1
  }
  return written
}

// BOOL FlushFileBuffers(HANDLE hFile) -- the Win32 equivalent of POSIX
// `fsync`/Darwin `F_FULLFSYNC`: per MSDN it forces the OS's file system
// cache AND any intermediate hardware cache to the physical device.
// Nonzero on success, 0 on failure -- the same BOOL convention as
// `WriteFile`/`ReadFile` above.
extern fn FlushFileBuffers(handle: *byte): i32

// `bit_rt_fs_sync`: flush `fd`'s already-written bytes to stable storage. 0
// on success, -1 on any failure -- a caller must not treat a successful
// `bit_rt_fs_write` as durable until this also returns 0.
export @nosplit @symbol("bit_rt_fs_sync") fn rtFsSync(fd: int): int {
  let handle = hAt(fd)
  if (int(FlushFileBuffers(handle)) != 0) {
    return 0
  }
  return 0 - 1
}

// `FILE_BEGIN`/`FILE_CURRENT` (`<fileapi.h>`): `SetFilePointerEx`'s
// `dwMoveMethod` values, 0 and 1 respectively per MSDN.
const winFileBegin: i32 = 0
const winFileCurrent: i32 = 1

// `BOOL SetFilePointerEx(HANDLE, LARGE_INTEGER, PLARGE_INTEGER, DWORD)`:
// moves `hFile`'s current file position; `lpNewFilePointer` may be NULL when
// the resulting position is not needed. Admitted at `compiler/pesyms.bit`
// with no runtime consumer until now (#4016).
extern fn SetFilePointerEx(handle: *byte, distance: i64, newPos: *i64, moveMethod: i32): i32

// `BOOL SetEndOfFile(HANDLE hFile)` (#4016): sets `hFile`'s length to its
// CURRENT file position. Win32 has no single "set length" call, so this is
// always paired with `SetFilePointerEx` moving the position there first.
extern fn SetEndOfFile(handle: *byte): i32

// `bit_rt_fs_truncate` (ABI.md §14, #4016): set `fd`'s length to `size` --
// `SetFilePointerEx(FILE_BEGIN, size)` then `SetEndOfFile`. Growing
// zero-fills the new bytes without reserving disk space (documented NTFS
// behaviour; a later write can still fail if the volume is full) -- a
// hole, not a reservation, deliberately out of scope, matching the POSIX
// providers.
//
// UNLIKE `ftruncate(2)`, Win32 has no length call independent of the
// handle's current position -- `SetEndOfFile` always acts at "wherever the
// pointer is now". So this SAVES the position with
// `SetFilePointerEx(FILE_CURRENT, 0)` first and RESTORES it after, making
// the net effect on `fd`'s cursor the same as the POSIX providers: none.
// The restore's own result is deliberately not checked -- by the time it
// runs, the length change has already succeeded or this has already
// returned -1, and a handle that just answered two calls failing a third
// synchronously (no other thread touches this handle between them) is not
// a case this runtime can usefully recover from differently.
export @nosplit @symbol("bit_rt_fs_truncate") fn rtFsTruncate(fd: int, size: int): int {
  let handle = hAt(fd)
  let posPtr = ptrOf(fsSizeScratch) + fsScratchSlot()
  let nilOut: *i64 = nil
  if (int(SetFilePointerEx(handle, i64(0), posPtr, winFileCurrent)) == 0) {
    return 0 - 1
  }
  let saved = int(atomicLoad(posPtr))
  if (int(SetFilePointerEx(handle, i64(size), nilOut, winFileBegin)) == 0) {
    return 0 - 1
  }
  let endOk = int(SetEndOfFile(handle))
  let _ = SetFilePointerEx(handle, i64(saved), nilOut, winFileBegin)
  if (endOk == 0) {
    return 0 - 1
  }
  return 0
}

// `bit_rt_fs_size`: `fd`'s current length in bytes via `GetFileSizeEx` --
// the same call `rtFsReadAll` above uses to size its allocation, and it
// never moves the handle's current position (unlike `SetFilePointerEx`
// above). The file's length itself, or -1 on any failure.
export @nosplit @symbol("bit_rt_fs_size") fn rtFsSize(fd: int): int {
  let handle = hAt(fd)
  let sizePtr = ptrOf(fsSizeScratch) + fsScratchSlot()
  if (int(GetFileSizeEx(handle, sizePtr)) == 0) {
    return 0 - 1
  }
  return int(atomicLoad(sizePtr))
}

// `BOOL LockFileEx(HANDLE, DWORD flags, DWORD reserved, DWORD bytesLow,
// DWORD bytesHigh, LPOVERLAPPED)` / `BOOL UnlockFileEx(HANDLE, DWORD
// reserved, DWORD bytesLow, DWORD bytesHigh, LPOVERLAPPED)` (#4014): Win32's
// byte-range lock pair -- there is no separate "lock the whole file" call.
// `reserved` must be 0 per MSDN. Admitted at `compiler/pesyms.bit`, not
// hardware-probed.
extern fn LockFileEx(
  handle: *byte,
  flags: i32,
  reserved: i32,
  bytesLow: i32,
  bytesHigh: i32,
  overlapped: *byte,
): i32
extern fn UnlockFileEx(
  handle: *byte,
  reserved: i32,
  bytesLow: i32,
  bytesHigh: i32,
  overlapped: *byte,
): i32

// `DWORD GetLastError(void)`: the calling thread's last error code, the
// Win32 analogue of `errno`. Admitted at `compiler/pesyms.bit` already (used
// descriptively by `GetCurrentDirectoryW`'s doc comment above); this is the
// first `extern fn` declaration for it in this module.
extern fn GetLastError(): i32

// `LockFileEx`'s `dwFlags` (`<fileapi.h>`): `LOCKFILE_EXCLUSIVE_LOCK`=2
// requests an exclusive lock (absent means shared);
// `LOCKFILE_FAIL_IMMEDIATELY`=1 is the `LOCK_NB` equivalent -- OR'd in for a
// non-blocking attempt.
const winLockfileExclusiveLock: int = 2
const winLockfileFailImmediately: int = 1

// `MAXDWORD` = 0xFFFFFFFF, written as the positive 64-bit `int` and
// `i32()`-cast at the call site -- the same device `winGenericRead` above
// uses for a value whose top bit is set. Per MSDN's own documented
// convention, passing `MAXDWORD` for both the low and high byte-range
// bounds locks the entire file regardless of its current or future size,
// the closest Win32 equivalent to `flock`'s true whole-file semantics (the
// ticket's own "no byte-range locking" constraint rules out asking for
// anything narrower).
const winMaxDword: int = 4294967295

// `ERROR_LOCK_VIOLATION` (`<winerror.h>`) = 33: the specific code
// `GetLastError` reports when `LockFileEx` fails because
// `LOCKFILE_FAIL_IMMEDIATELY` was set and the region is already locked by
// someone else -- Windows's equivalent of Darwin/Linux's `EWOULDBLOCK`.
const errLockViolation: int = 33

// `ERROR_NOT_LOCKED` (`<winerror.h>`) = 158: the specific code
// `GetLastError` reports when `UnlockFileEx` is asked to release a range
// that was never locked. See `bit_rt_fs_unlock` below for why this is
// folded into success rather than left as an error.
const errNotLocked: int = 158

// `bit_rt_fs_lock` (ABI.md §14, #4014): take a WHOLE-FILE advisory lock on
// `fd` -- exclusive or shared, blocking or non-blocking. Reuses
// `overlappedAt(0)` above: a synchronous handle still requires a non-NULL
// `OVERLAPPED` for `LockFileEx`/`UnlockFileEx` (unlike `ReadFile`/
// `WriteFile`, which tolerate NULL), and locking at offset 0 for
// `winMaxDword` bytes both ways is this provider's whole-file convention
// (see `winMaxDword` above).
//
// Bracketed with `gcSyscallBegin`/`gcSyscallEnd` for the same #2207 reason
// `bit_rt_fs_pread_w` above is: a BLOCKING call (no
// `LOCKFILE_FAIL_IMMEDIATELY`) waits for another process to release the
// lock, potentially indefinitely. A non-blocking call returns immediately
// either way, so that path is unbracketed, matching `rtFsTruncate`/
// `rtFsSize` above's treatment of fast, bounded calls -- there is also no
// signal/`EINTR` concept on Windows to retry.
//
// Three-way return, matching ../darwin/fsrw.bit's `rtFsLock` and
// ../linux/fsrw.bit's copy exactly, so `std/fs`'s eventual caller needs no
// per-platform knowledge: 0 on success; -1 only when `blocking` is false
// and `GetLastError` reports `ERROR_LOCK_VIOLATION` -- the expected outcome
// for `tryLock`/`tryLockShared`, not a failure; -2 for any other error.
export @nosplit @symbol("bit_rt_fs_lock") fn rtFsLock(
  fd: int,
  exclusive: bool,
  blocking: bool,
): int {
  let flags = 0
  if (exclusive) {
    flags = flags | winLockfileExclusiveLock
  }
  if (!blocking) {
    flags = flags | winLockfileFailImmediately
  }
  let handle = hAt(fd)
  let ov = overlappedAt(0)
  let dword = i32(winMaxDword)
  if (!blocking) {
    if (int(LockFileEx(handle, i32(flags), i32(0), dword, dword, hAt(ov))) != 0) {
      return 0
    }
    if (int(GetLastError()) == errLockViolation) {
      return 0 - 1
    }
    return 0 - 2
  }
  gcSyscallBegin()
  let ok = int(LockFileEx(handle, i32(flags), i32(0), dword, dword, hAt(ov)))
  gcSyscallEnd()
  if (ok != 0) {
    return 0
  }
  return 0 - 2
}

// `bit_rt_fs_unlock`: release `fd`'s advisory lock via `UnlockFileEx` over
// the identical offset-0/`winMaxDword` whole-file range `bit_rt_fs_lock`
// above locks. A no-op success if `fd` did not hold a lock -- `winerror.h`'s
// `ERROR_NOT_LOCKED`=158 is treated as success here specifically so this
// primitive has the same "safe to call unconditionally" contract as
// ../darwin/fsrw.bit's and ../linux/fsrw.bit's `flock(fd, LOCK_UN)`, which
// is a genuine no-op on an unlocked fd rather than a Windows-only special
// case a caller would need to know about. 0 on success, -2 on any other
// error; -1 has no meaning here.
export @nosplit @symbol("bit_rt_fs_unlock") fn rtFsUnlock(fd: int): int {
  let handle = hAt(fd)
  let ov = overlappedAt(0)
  let dword = i32(winMaxDword)
  if (int(UnlockFileEx(handle, i32(0), dword, dword, hAt(ov))) != 0) {
    return 0
  }
  if (int(GetLastError()) == errNotLocked) {
    return 0
  }
  return 0 - 2
}

// `DWORD GetCurrentDirectoryW(DWORD nBufferLength, LPWSTR lpBuffer)`: fills
// `lpBuffer` with the process's current directory as NUL-terminated UTF-16LE.
// Per MSDN: on success, returns the unit count copied EXCLUDING the NUL; if
// `lpBuffer` is too small, returns the required unit count INCLUDING the NUL
// (always > `nBufferLength` in that case); on any other failure, returns 0
// (`GetLastError` for detail). Admitted to the Windows import surface at
// `compiler/pesyms.bit`, hardware-verified via
// `GetProcAddress(LoadLibrary("kernel32.dll"), "GetCurrentDirectoryW")` on
// real Windows (non-null) rather than assumed from documentation alone —
// #2649's own lesson for this exact surface.
extern fn GetCurrentDirectoryW(bufferLength: i32, buffer: *byte): i32

// `bit_rt_fs_cwd`: the process's current working directory as UTF-8, or the
// empty string on any failure -- including a result that would not fit
// `fsWinPathUnits` (MAX_PATH), rejected rather than truncated, the same
// contract every other path-taking entry in ./fs.bit applies. Reuses
// `fsPathBufW`'s current-worker slot as raw UTF-16LE scratch: safe because
// this call never encodes a Bit path into it and nothing else touches that
// slot between the `GetCurrentDirectoryW` write and the decode immediately
// below -- no park happens in between.
export @nosplit @symbol("bit_rt_fs_cwd") fn rtFsCwd(): int {
  let wide = int(ptrOf(fsPathBufW)) + fsScratchSlot() * fsWinPathBytes
  let units = int(GetCurrentDirectoryW(i32(fsWinPathUnits), hAt(wide)))
  if (units <= 0 || units >= fsWinPathUnits) {
    return emptyStr()
  }
  let big = rtStrAlloc(fsNameScratchBytes)
  if (big == 0) {
    return emptyStr()
  }
  let base = strData(big)
  let nb = winUtf16ToUtf8(wide, units, base, fsNameScratchBytes)
  if (nb < 0) {
    return emptyStr()
  }
  // `big` is `fsNameScratchBytes`-byte throwaway scratch: nothing else ever
  // references it again after this call returns. Since #3897
  // `rtStringSlice` allocates a header-only VIEW, so slicing it here would
  // retain the whole scratch for as long as the returned string lives, not
  // just the actual cwd length `nb` (#4088) — the exact opposite of what a
  // scratch buffer is for. Copy the `nb` bytes actually decoded into an
  // exactly-sized string instead, so `big` becomes garbage immediately —
  // the same fix #3902 applied to `rtFsRead` above.
  let out = rtStrAlloc(nb)
  if (out == 0) {
    return rtStringSlice(big, 0, nb)
  }
  let dst = strData(out)
  let i = 0
  while (i < nb) {
    storeByte(dst + i, loadByte(base + i))
    i = i + 1
  }
  return out
}
