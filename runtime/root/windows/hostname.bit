// `bit_rt_os_hostname` (ABI.md §19, #7192): the local host name, for
// `std/os`'s `hostname`. Same module as ./os.bit (an import is per module, not
// per file): `osScratchSlot`, `hAt`, `loadByte`/`storeByte` and
// `winUtf16ToUtf8` are already in scope. Its own file because ./os.bit sits at
// 715 lines and `spec/LINT.md` §4 caps a file at 800.
//
// `GetComputerNameExW(ComputerNameDnsHostname, ...)` (sysinfoapi.h,
// kernel32.dll; learn.microsoft.com/windows/win32/api/sysinfoapi/
// nf-sysinfoapi-getcomputernameexw), the call Go's `os.Hostname` makes on
// Windows. `BOOL GetComputerNameExW(COMPUTER_NAME_FORMAT, LPWSTR, LPDWORD)`:
// `*size` is the buffer's capacity in units on entry; on success it holds the
// units copied, EXCLUDING the NUL; if the buffer is too small the call fails
// with ERROR_MORE_DATA and returns 0. A DNS host label is at most 63 units, so
// 256 units never truncates a real name and a failure is reported as one.
extern fn GetComputerNameExW(nameType: i32, buffer: *byte, size: *byte): i32

// `COMPUTER_NAME_FORMAT::ComputerNameDnsHostname` (winbase.h): the DNS host
// name of the local computer, without the domain, which is what POSIX
// `gethostname` returns.
const winComputerNameDnsHostname: i32 = 1

const hostUnits: int = 256
// One slot is 65 words: 64 for the 512-byte UTF-16 buffer and 1 for the
// 4-byte size cell `GetComputerNameExW` reads and writes. (`osScratchSlots` + 1)
// = 33 slots, one region per worker plus the fallback; 33 * 65 = 2145 words.
// A scalar array so the collector never scans it.
const hostSlotWords: int = 65
const hostSizeCellWord: int = 64
let osHostBufW: [2145]i64

// Write the host name at `buf` (room for `room` bytes) as NUL-terminated UTF-8
// and return its length, which is always < `room`. `0 - 1` when the call fails
// or the UTF-8 name plus its NUL does not fit: rejected, never truncated. A
// fast local kernel32 call that never parks, like `rtOsSelfExe` above.
export @nosplit @symbol("bit_rt_os_hostname") fn rtOsHostname(buf: int, room: int): int {
  if (buf == 0 || room < 2) {
    return 0 - 1
  }
  let slotBase = int(ptrOf(osHostBufW)) + osScratchSlot() * hostSlotWords * 8
  let cell = slotBase + hostSizeCellWord * 8
  storeByte(cell, hostUnits & 255)
  storeByte(cell + 1, (hostUnits >> 8) & 255)
  storeByte(cell + 2, 0)
  storeByte(cell + 3, 0)
  if (GetComputerNameExW(winComputerNameDnsHostname, hAt(slotBase), hAt(cell)) == 0) {
    return 0 - 1
  }
  let units = loadByte(cell) | (loadByte(cell + 1) << 8)
  if (units >= hostUnits) {
    return 0 - 1
  }
  return winUtf16ToUtf8(slotBase, units, buf, room)
}
