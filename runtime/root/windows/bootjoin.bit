// runtime/root/windows/bootjoin.bit: `boot()` step 8's worker join (#7829). A
// sibling of ./boot.bit, same module as every other file in this directory, so
// boot.bit's `startHandles`, `bootSleepReq`, its `WaitForSingleObject` and
// `CloseHandle` externs and its `gcBlockingBegin`/`gcBlockingEnd` and
// `parkMonoNs` imports are visible here with no re-import (a second import or
// extern of any of them is E0042).
//
// THE JOIN IS A COURTESY, NOT A CONTRACT. `main` has returned, so the process is
// ending: `winMain` (./boot.bit) calls `ExitProcess`, which terminates every
// thread still running (Microsoft Learn, ExitProcess), exactly as `exit_group`
// does on linux and `exit` on darwin. What the join buys is that a worker which
// can wind down does so first, so the BIT_GC_STATS report (step 9) does not read
// the counters of a worker in mid-collection and the poller is not closed under a
// worker that still drains it (step 8b). A worker that cannot reach the
// scheduler's shutdown check, because it sits in a raw Winsock `recvfrom` or any
// other syscall that polls nothing, is not waited for: a 15 s bound per worker made
// the process outlive `main` by 15.0 s for one such worker (measured on the
// Windows test box, BIT_WORKERS=4, `_tests_/stress/thread/exitblockedwindows`).
// A worker that is winding down takes microseconds: a whole run of that fixture
// with no blocked worker ends 0 to 3 ms after `main` returns.
//
// ONE DEADLINE FOR THE WHOLE JOIN, not one per worker, so N unresponsive workers
// cost `joinGraceNs` once. Each wait is `blocked` (#5931): the wait reaches no
// safepoint, and `boot` holds no live Bit reference here (./boot.bit header), so a
// stop-the-world requested meanwhile passes this thread instead of burning its
// `stwSpinBound` on it.

const joinGraceNs: int = 100000000
const waitObject0: int = 0

// Joins the `started` workers' CreateThread HANDLEs until `joinGraceNs` is spent
// and closes them. True when every worker finished, false when the deadline
// passed with one still running (its handle is closed all the same; CloseHandle
// never unmaps the stack).
fn bootJoinWorkers(started: int): bool {
  let deadline = parkMonoNs(ptrOf(bootSleepReq)) + joinGraceNs
  let allJoined = true
  let ji = 0
  while (ji < started) {
    let h = *(ptrOf(startHandles) + ji)
    let hp: *byte = nil
    let leftNs = deadline - parkMonoNs(ptrOf(bootSleepReq))
    let waitMs = i32(0)
    if (leftNs > 0) {
      waitMs = i32((leftNs + 999999) / 1000000)
    }
    gcBlockingBegin()
    let wait = int(WaitForSingleObject(hp + h, waitMs))
    gcBlockingEnd()
    if (wait != waitObject0) {
      allJoined = false
    }
    let _ = CloseHandle(hp + h)
    ji = ji + 1
  }
  return allJoined
}
