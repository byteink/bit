// The `BIT_GC_STATS` line (#1639), Windows twin of ../darwin/boot.bit's and
// ../linux/boottail.bit's `statsReport` — same packed-constant bytes, same
// buffer sizing, split into its own file rather than folded into ./boot.bit
// (#3725) to stay clear of that file's 800-line ceiling.
//
// Text is emitted through `storeByte` (packed byte constants) rather than
// string literals: this module is `--freestanding` (#1628) and builds no
// managed string. The decimals go through `../../root`'s `osWriteDecimal`.
// `storeByte`, `stderrFd` and `rootWriteAll` are already imported/declared by
// ./io.bit — an import is per-MODULE, not per-file, so this file uses them
// directly rather than re-importing.
//
// 297 bytes worst case (ten i64 decimals at 20 bytes each, 97 bytes of packed
// text) rounds up to 38 whole words, 39 for a word of slack — see
// ../darwin/boot.bit's comment on this same constant for the full accounting;
// it applies unchanged here since the line is byte-identical on every
// platform.
let statsBuf: [39]i64

import { osWriteDecimal, rootStatOom } from "../../root"
import {
  stwCollections, stwSwept, stwLiveObjects, stwAbandonedCount, stwBadOffsets,
  stwSpanChunks, stwSpanChunkBytes, stwIdxChunks, stwIdxChunkBytes,
} from "../../stw"

// Append `nbytes` low bytes of the packed constant `word` at byte offset `at`,
// returning the new offset.
@nosplit fn statsConst(at: int, word: int, nbytes: int): int {
  let base = int(ptrOf(statsBuf))
  let w = word
  let i = 0
  while (i < nbytes) {
    storeByte(base + at + i, w & 255)
    w = w >> 8
    i = i + 1
  }
  return at + nbytes
}

// Append `v` in decimal at byte offset `at`, returning the new offset.
@nosplit fn statsNum(at: int, v: int): int {
  return at + osWriteDecimal(int(ptrOf(statsBuf)) + at, v)
}

// `[bit-gc] collections=<n> swept=<n> live=<n> abandoned=<n> oom=<n> bad=<n>
// chunks=<n> chunkbytes=<n> idxchunks=<n> idxbytes=<n>`, on stderr, once,
// only under `BIT_GC_STATS`. Called after `main` has finished and the worker
// is reaped, so nothing can be collecting while it reads.
@nosplit fn statsReport() {
  let at = statsConst(0, 6729335713145905755, 8) // "[bit-gc]"
  at = statsConst(at, 8386658447444108064, 8)    // " collect"
  at = statsConst(at, 263929622377, 5)           // "ions="
  at = statsNum(at, stwCollections())
  at = statsConst(at, 17297999666836256, 7) // " swept="
  at = statsNum(at, stwSwept())
  at = statsConst(at, 67505987611680, 6) // " live="
  at = statsNum(at, stwLiveObjects())
  at = statsConst(at, 7957689491829973280, 8) // " abandon"
  at = statsConst(at, 4023397, 3)             // "ed="
  at = statsNum(at, stwAbandonedCount())
  at = statsConst(at, 28448, 2)   // " o"
  at = statsConst(at, 4025711, 3) // "om="
  at = statsNum(at, rootStatOom())
  at = statsConst(at, 263677108768, 5) // " bad="
  at = statsNum(at, stwBadOffsets())
  at = statsConst(at, 4428000980795679520, 8) // " chunks="
  at = statsNum(at, stwSpanChunks())
  at = statsConst(at, 8746671548467274528, 8) // " chunkby"
  at = statsConst(at, 1030972788, 4)          // "tes="
  at = statsNum(at, stwSpanChunkBytes())
  at = statsConst(at, 7959382692878117152, 8) // " idxchun"
  at = statsConst(at, 4027243, 3)             // "ks="
  at = statsNum(at, stwIdxChunks())
  at = statsConst(at, 7310601558962759968, 8) // " idxbyte"
  at = statsConst(at, 15731, 2)               // "s="
  at = statsNum(at, stwIdxChunkBytes())
  at = statsConst(at, 10, 1) // "\n"
  rootWriteAll(stderrFd, int(ptrOf(statsBuf)), at)
}
