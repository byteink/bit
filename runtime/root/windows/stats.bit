// The `BIT_GC_STATS` line (#1639), Windows twin of ../darwin/bootstats.bit's
// and ../linux/bootstats.bit's `statsReport` — same packed-constant bytes,
// same buffer sizing, split into its own file rather than folded into
// ./boot.bit (#3725) to stay clear of that file's 800-line ceiling — the same
// reason ../darwin/bootstats.bit was split out under #4094.
//
// Text is emitted through `storeByte` (packed byte constants) rather than
// string literals: this module is `--freestanding` (#1628) and builds no
// managed string. The decimals go through `../../root`'s `osWriteDecimal`.
// `storeByte`, `stderrFd` and `rootWriteAll` are already imported/declared by
// ./io.bit — an import is per-MODULE, not per-file, so this file uses them
// directly rather than re-importing.
//
// 714 bytes worst case (twenty-four i64 decimals at 20 bytes each, 234 bytes
// of packed text -- #4057 added the four byte figures, #5228 added
// `giveups=`, #5834 added the seven pause fields, #5837 added `helpers=`)
// rounds up to 90 whole words, 91 for a word of slack -- see
// ../darwin/bootstats.bit's comment on this same constant for the full
// accounting; it applies unchanged here since the line is byte-identical on
// every platform.
let statsBuf: [91]i64

import { osWriteDecimal, rootStatOom } from "../../root"
import {
  stwCollections, stwSwept, stwLiveObjects, stwAbandonedCount, stwResumeGiveUp, stwBadOffsets,
  stwSpanChunks, stwSpanChunkBytes, stwIdxChunks, stwIdxChunkBytes, stwIdxOk,
} from "../../stw"
import { stwLiveBytes, stwMappedBytes, stwPeakMappedBytes, stwAllocBytes } from "../../stw"
import {
  stwPauses, stwPauseNs, stwPauseMaxNs, stwRdvNs, stwRootsNs, stwDrainNs, stwSweepNs,
  stwGangJoins,
} from "../../stw"

// Append `nbytes` low bytes of the packed constant `word` at byte offset `at`,
// returning the new offset.
@nosplit fn statsConst(at: int, word: int, nbytes: int): int {
  let base = int(ptrOf(statsBuf))
  let w = word
  let i = 0
  while (i < nbytes) {
    storeByte(base + at + i, w & 255)
    w = w >> 8
    i = i + 1
  }
  return at + nbytes
}

// Append `v` in decimal at byte offset `at`, returning the new offset.
@nosplit fn statsNum(at: int, v: int): int {
  return at + osWriteDecimal(int(ptrOf(statsBuf)) + at, v)
}

// `[bit-gc] collections=<n> swept=<n> live=<n> abandoned=<n> giveups=<n>
// oom=<n> bad=<n> chunks=<n> chunkbytes=<n> idxchunks=<n> idxbytes=<n>
// indexok=<n> livebytes=<n> mappedbytes=<n> peakbytes=<n> allocbytes=<n>
// pauses=<n> pausens=<n> pausemaxns=<n> rdvns=<n> rootsns=<n> drainns=<n>
// sweepns=<n> helpers=<n>`, on stderr, once, only under `BIT_GC_STATS`. Called
// after `main` has finished and the worker is reaped, so nothing can be
// collecting while it reads.
//
// `giveups=` (#5228) is `stwResumeGiveUp`, the deviation-5 counter forwarded
// from `../gc/gcworldsync.bit`'s `worldResumeGiveUp`; see
// ../darwin/bootstats.bit's `statsReport` header for what nonzero means.
//
// THE LAST FOUR ARE BYTES, NOT OBJECTS (#4057) — see
// ../darwin/bootstats.bit's `statsReport` header for the full reasoning; it
// applies unchanged here.
//
// `pauses=`..`sweepns=` (#5834) are the world-stop split, and `helpers=`
// (#5837) is the helper-gang join count — see ../darwin/bootstats.bit's
// `statsReport` header for what each field is; both apply unchanged here.
@nosplit fn statsReport() {
  let at = statsConst(0, 6729335713145905755, 8) // "[bit-gc]"
  at = statsConst(at, 8386658447444108064, 8)    // " collect"
  at = statsConst(at, 263929622377, 5)           // "ions="
  at = statsNum(at, stwCollections())
  at = statsConst(at, 17297999666836256, 7) // " swept="
  at = statsNum(at, stwSwept())
  at = statsConst(at, 67505987611680, 6) // " live="
  at = statsNum(at, stwLiveObjects())
  at = statsConst(at, 7957689491829973280, 8) // " abandon"
  at = statsConst(at, 4023397, 3)             // "ed="
  at = statsNum(at, stwAbandonedCount())
  at = statsConst(at, 8318277590392071968, 8) // " giveups"
  at = statsConst(at, 61, 1)                  // "="
  at = statsNum(at, stwResumeGiveUp())
  at = statsConst(at, 28448, 2)   // " o"
  at = statsConst(at, 4025711, 3) // "om="
  at = statsNum(at, rootStatOom())
  at = statsConst(at, 263677108768, 5) // " bad="
  at = statsNum(at, stwBadOffsets())
  at = statsConst(at, 4428000980795679520, 8) // " chunks="
  at = statsNum(at, stwSpanChunks())
  at = statsConst(at, 8746671548467274528, 8) // " chunkby"
  at = statsConst(at, 1030972788, 4)          // "tes="
  at = statsNum(at, stwSpanChunkBytes())
  at = statsConst(at, 7959382692878117152, 8) // " idxchun"
  at = statsConst(at, 4027243, 3)             // "ks="
  at = statsNum(at, stwIdxChunks())
  at = statsConst(at, 7310601558962759968, 8) // " idxbyte"
  at = statsConst(at, 15731, 2)               // "s="
  at = statsNum(at, stwIdxChunkBytes())
  // The index's live/disabled flag (#4094) — see ../gc/gcindex.bit's
  // `idxDisable` comment for what 0 costs (Theta(live) lookups from then on).
  at = statsConst(at, 7741538661345159456, 8) // " indexok"
  at = statsConst(at, 61, 1)                  // "="
  at = statsNum(at, stwIdxOk())
  // The four byte figures (#4057) — see this function's own header for which
  // is exact and which is class-rounded.
  at = statsConst(at, 8392847568499469344, 8) // " livebyt"
  at = statsConst(at, 4027237, 3)             // "es="
  at = statsNum(at, stwLiveBytes())
  at = statsConst(at, 7089903246984178976, 8) // " mappedb"
  at = statsConst(at, 263929033849, 5)        // "ytes="
  at = statsNum(at, stwMappedBytes())
  at = statsConst(at, 8392847593916690464, 8) // " peakbyt"
  at = statsConst(at, 4027237, 3)             // "es="
  at = statsNum(at, stwPeakMappedBytes())
  at = statsConst(at, 8746662756518486304, 8) // " allocby"
  at = statsConst(at, 1030972788, 4)          // "tes="
  at = statsNum(at, stwAllocBytes())
  at = statsReportPauses(at)
  at = statsConst(at, 10, 1) // "\n"
  rootWriteAll(stderrFd, int(ptrOf(statsBuf)), at)
}

// The pause-time split (#5834), continuing at byte offset `at` — split out of
// `statsReport` above to keep that function under spec/LINT.md's
// max-fn-lines (80). See `statsReport`'s own header for what each field is.
@nosplit fn statsReportPauses(at: int): int {
  let a = statsConst(at, 4427994405200293920, 8) // " pauses="
  a = statsNum(a, stwPauses())
  a = statsConst(a, 8317697108364849184, 8) // " pausens"
  a = statsConst(a, 61, 1)                  // "="
  a = statsNum(a, stwPauseNs())
  a = statsConst(a, 7020378940705435680, 8) // " pausema"
  a = statsConst(a, 1030975096, 4)          // "xns="
  a = statsNum(a, stwPauseMaxNs())
  a = statsConst(a, 17296891849241120, 7) // " rdvns="
  a = statsNum(a, stwRdvNs())
  a = statsConst(a, 8317712505722860064, 8) // " rootsns"
  a = statsConst(a, 61, 1)                  // "="
  a = statsNum(a, stwRootsNs())
  a = statsConst(a, 8317706960685392928, 8) // " drainns"
  a = statsConst(a, 61, 1)                  // "="
  a = statsNum(a, stwDrainNs())
  a = statsConst(a, 8317709142596219680, 8) // " sweepns"
  a = statsConst(a, 61, 1)                  // "="
  a = statsNum(a, stwSweepNs())
  // `helpers=` (#5837) — total joins into the helper gang, whole run.
  a = statsConst(a, 8318822995236055072, 8) // " helpers"
  a = statsConst(a, 61, 1)                  // "="
  a = statsNum(a, stwGangJoins())
  return a
}
