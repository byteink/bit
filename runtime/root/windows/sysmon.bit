// runtime/root/windows/sysmon.bit — the preemption monitor thread (#6469;
// ../linux/sysmon.bit and ../darwin/boot.bit's `sysmonRun` are the twins). A
// sibling of ./boot.bit rather than part of it: boot.bit is within seven lines
// of the 800-line cap. Same module as every other file in this directory, so
// boot.bit's imports (`WORKER_MAX_STEPS`, `gcBlockingBegin`, `parkSleepNs`,
// `threadStackBytes`) and its `CreateThread`/`CloseHandle` externs and
// `STACK_SIZE_PARAM_IS_A_RESERVATION` are visible here with no re-import (a
// second import or extern of any of them is E0042).
//
// WHAT WAS MISSING. `sysmonTick` (`../../sched/preempt.bit`) is the only thing
// that sets a task's preempt request, and before this file Windows had no
// caller for it: a compute-bound green task ran to completion while its
// worker's other tasks starved (#6469; the fixture is
// `_tests_/stress/schedpreempt`, run on Windows by `test-windows-smoke`).
//
// ALL THE SCHEDULING LOGIC IS SHARED. This file supplies only the three things
// that are OS-specific, exactly as the other two platforms do: the thread
// start (`sysmonStart`), the period sleep (`parkSleepNs`, a high-resolution
// waitable timer here, `../../park/windows`) and the idle park
// (`sysmonIdleWait`, which reaches `WaitOnAddress` through the same
// `bit_rt_port_park_wait` every idle worker uses; #6008). No second copy of
// the budget, the stamp handshake or the tick lives here.
//
// THE SLEEP MUST BE A REAL `sysmonPeriodNs` (2ms). `preemptBudgetTicks` is
// derived from that constant, so a coarser real period silently rescales the
// 10ms budget. `parkSleepNs` at or above `parkMaxBackoffNs` is one
// `CreateWaitableTimerExW(HIGH_RESOLUTION)` wait with no spin, falling back to
// a millisecond wait under the 1ms tick `boot()` step 1b raises.
//
// THE MUTATOR-REGISTRY DECISION IS ../linux/sysmon.bit's, for the same reason:
// `@nosplit` end to end (no back-edge poll), and PERMANENTLY `blocked` via
// `gcBlockingBegin` because this thread holds no GC reference in any frame:
// `sysmonTick` and `sysmonIdleWait` touch only their own `@nosplit` atomic
// words and the park word, never the heap. The stop-the-world rendezvous passes
// a `mBlocked` slot without scanning its stack.

import { sysmonTick, sysmonPeriodNs, sysmonIdleWait } from "../../sched"

let sysmonSleepReq: [2]i64

// `CreateThread`'s `lpThreadId` out-param for this one thread; never read.
let sysmonThreadId: i32 = 0

@nosplit fn sysmonRun(arg: *byte): *byte {
  gcBlockingBegin()
  let n = 0
  while (n < WORKER_MAX_STEPS) {
    let _ = sysmonIdleWait(ptrOf(sysmonSleepReq))
    parkSleepNs(int(sysmonPeriodNs), ptrOf(sysmonSleepReq))
    let _ = sysmonTick()
    n = n + 1
  }
  return nil
}

// Start the monitor, once, from `boot()` right after the worker bring-up
// loop. The thread outlives the program (`ExitProcess` ends it), so its HANDLE
// is closed here and never joined. A failed start is not fatal: the program
// then runs with cooperative scheduling only, as Windows did before #6469.
@nosplit fn sysmonStart() {
  let nullAttrs: *byte = nil
  let nullArg: *byte = nil
  let handle = CreateThread(
    nullAttrs, i64(threadStackBytes),
    entryOf(sysmonRun), nullArg, STACK_SIZE_PARAM_IS_A_RESERVATION,
    ptrOf(sysmonThreadId),
  )
  if (int(handle) != 0) {
    let _ = CloseHandle(handle)
  }
}
