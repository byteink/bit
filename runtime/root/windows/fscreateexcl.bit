// `bit_rt_fs_create_excl_w` (#5797, epic #5787): see ../linux/fscreateexcl.bit
// for the full rationale (pkg/kv's `create` checked `exists(path)` then
// opened without `O_EXCL`, so two concurrent creates both succeeded and a
// planted symlink got followed and overwritten). Sibling file in this
// directory, matching the other two platforms' own `fscreateexcl.bit`.
//
// `wordsPathW`, `hAt`, `winGenericRead`, `winGenericWrite`, `winShareAll`,
// `winFileAttrNormal`, `winInvalidHandle`, `CreateFileW`, `GetLastError`
// are NOT imported here: ./fs.bit and ./fsrw.bit, siblings in this same
// module, already declare every one of them; a second import or
// redeclaration would be E0042.

// `CREATE_NEW` (`fileapi.h`'s `dwCreationDisposition`): fail with
// `ERROR_FILE_EXISTS` if `path` already names ANYTHING, including a
// reparse point — unlike POSIX, no separate `O_NOFOLLOW` is needed:
// `CreateFileW`'s existence check is by name, before any dereference of
// what that name might point to, so a planted symlink at `path` refuses
// the same way a planted regular file does.
const winCreateNew: int = 1

// `ERROR_FILE_EXISTS` (`winerror.h`): `GetLastError`'s value when
// `CREATE_NEW` refused because `path` already exists.
const errWinFileExists: int = 80

// `bit_rt_fs_create_excl_w` (ABI.md §14, #5797): open the `n` packed-bytes
// path at `words` with `CREATE_NEW`. `mode` is accepted for ABI parity with
// the darwin/linux siblings but unused — Windows has no POSIX permission
// bits; `CreateFileW`'s own ACL model applies instead. Handle (as `int`) on
// success; `-2` specifically for `ERROR_FILE_EXISTS`, so a caller can tell
// "already there" apart from every other failure; `-1` otherwise — the
// same normalized three-way shape `bit_rt_fs_lock`/`bit_rt_fs_unlock`
// already use in place of a raw platform error code.
export @nosplit @symbol("bit_rt_fs_create_excl_w") fn rtFsCreateExclW(
  words: int,
  n: int,
  mode: i64,
): int {
  let p = wordsPathW(words, n)
  if (p == 0) {
    return 0 - 1
  }
  let nilSec: *byte = nil
  let nilTemplate: *byte = nil
  let handle = CreateFileW(
    hAt(p),
    i32(winGenericRead | winGenericWrite),
    i32(winShareAll),
    nilSec,
    i32(winCreateNew),
    i32(winFileAttrNormal),
    nilTemplate,
  )
  if (int(handle) != winInvalidHandle) {
    return int(handle)
  }
  if (int(GetLastError()) == errWinFileExists) {
    return 0 - 2
  }
  return 0 - 1
}
