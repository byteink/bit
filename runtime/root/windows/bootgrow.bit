// The shared grow protocol keeps publication and shutdown under one registry
// lock. Only thread creation differs by platform; reuse the Windows provider
// that also owns each worker's GC registration and completion word.
import { schedGrowArm, schedGrowCommit, schedFinalWorkerCount } from "../../sched"
import { rootRetakeScan, rootRetakeConfirm, rootEnvWorkersExplicit, rootWorkersCeiling } from "../../root"
import { schedStartArm } from "../../thread"
import { threadStart } from "../../thread/windows"

let startArgs: [64]i64
let startDones: [32]i32
let workersCeiling: int = 0

@nosplit fn tryGrowPoolAt(sched: *i64, ceiling: int, retake: bool) {
  let startArg = schedGrowArm(sched, ptrOf(startArgs), ptrOf(startDones), ceiling)
  if (int(startArg) == 0) {
    return
  }
  if (retake && !rootRetakeConfirm(sched)) {
    let _ = schedGrowCommit(sched, ptrOf(startHandles), 0)
    return
  }
  let block = taskAt(int(startArg))
  let doneWordAddr = *(block + 1)
  let dz: *i32 = nil
  let handle = threadStart(entryOf(workerBody), startArg, dz + doneWordAddr / 4)
  let _ = schedGrowCommit(sched, ptrOf(startHandles), handle)
}

// The explicit worker ceiling counts running workers, not blocked ones.
@nosplit fn sysmonRetake() {
  let sched: *i64 = ptrOf(schedBlock)
  let blocked = rootRetakeScan(sched)
  if (blocked == 0) {
    return
  }
  let ceiling = workersCeiling
  if (ceiling > 0) {
    ceiling = ceiling + blocked
  }
  tryGrowPoolAt(sched, ceiling, true)
}
