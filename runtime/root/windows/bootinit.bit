// Fixed bootstrap steps; the entry keeps their initialization and shutdown order.
@nosplit fn bootWorkerCount(requested: int): int {
  let nworkers = requested
  if (nworkers < 1) {
    nworkers = 1
  }
  if (nworkers > bootMaxWorkers) {
    nworkers = bootMaxWorkers
  }
  return nworkers
}

@nosplit fn bootQueueMain(sched: *i64): bool {
  let stackBase = mapGuardedStack(schedMainStackBytes, ptrOf(winMainStackRegionScratch))
  if (stackBase == 0) {
    return false
  }
  // Published for `vehHandler` (#3337, ./signal.bit) to name a main-stack
  // overflow exactly rather than by heuristic.
  mainStackBaseAddr = stackBase
  let task = int(ptrOf(mainTaskBlock))
  let t: *i64 = ptrOf(mainTaskBlock)
  schedTaskInit(t, stackBase, schedMainStackBytes, entryOf(mainTrampoline), 0)
  if (!schedRegisterBigStack(stackBase, schedMainStackBytes, task)) {
    return false
  }
  schedRegister(sched, task)
  if (!dqPushBottom(schedWorkerAt(sched, 0) + wkDeque, task)) {
    return false
  }

  return true
}

@nosplit fn bootStartWorkers(sched: *i64, nworkers: int): int {
  let started = 0
  let wi = 0
  while (wi < nworkers) {
    let arg = schedStartArm(sched, wi, ptrOf(startArgs), ptrOf(startDones))
    let handle = threadStart(entryOf(workerBody), arg, ptrOf(startDones) + wi)
    *(ptrOf(startHandles) + wi) = int(handle)
    if (int(handle) == 0) {
      if (wi == 0) {
        return 0
      }
      wi = nworkers
    } else {
      started = started + 1
      wi = wi + 1
    }
  }

  return started
}

// A timed-out join leaves the live poller to ExitProcess.
@nosplit fn bootClosePoller(joined: bool) {
  if (joined && bootPollFd > 0) {
    pollClose(bootPollFd)
    bootPollFd = 0
  }
}
