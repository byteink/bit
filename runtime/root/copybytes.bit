// `copyBytes`'s path for ends that are not both 8-aligned (#7446). Sibling
// file, same module: see root.bit's `copyBytes` for the contract and the
// "Bit has no unaligned word load" constraint this file works within.
//
// THE COST IT REMOVES. A TLS record's fragment sits 5 bytes into its record,
// so sealing one and serving its plaintext are each a 16 KiB copy with ends
// at different alignments. Bytewise, that was about as costly on x86-64 as
// the whole AES-GCM pass over the same record.
//
// THE SHAPE. Peel bytes until `dst` is 8-aligned. If `src` is then aligned
// too, move whole words. Otherwise build each destination word from two
// ALIGNED source words: the high `8 - r` bytes of one and the low `r` bytes
// of the next, `r = src & 7`, little-endian on both targets. Every load is an
// aligned word that holds at least one byte of the source, so no load crosses
// a page boundary that the bytes being copied do not already touch. Peeled
// tail bytes finish the copy.
//
// OVERLAP. Taken only when the regions are disjoint or `dst <= src`. For
// `dst <= src` the aligned destination word written in step k never lies
// above the aligned source word read in step k, so no source byte is
// overwritten before it is read: the result is the bytewise loop's result.

import { onX64 } from "../syscalls"

// ON X86-64 A LONG COPY IS ONE `rep movsb`. With ERMSB/FSRM the string unit
// moves a cache line per step at any alignment of either end, where the word
// loops in `copyBytes` move eight bytes; below `repMovsbMin` its startup costs
// more than it saves. `rep movsb` is defined as the ascending byte loop, so its
// result is the byte loop's for every overlap `copyBytes` admits. DF is clear
// at every call boundary on both x86-64 ABIs. `onX64()` folds to the target,
// so arm64 keeps the word loops and never reaches the trap.
const repMovsbMin: int = 512

// Whether `copyBytes(dst, src, n)` takes `copyBytesRepMovsb`.
@nosplit fn copyBytesWantsRepMovsb(n: int): bool {
  return n >= repMovsbMin && onX64()
}

// `rep movsb`: `n` bytes from `src` to `dst`, ascending. Encoding checked
// with `clang -c -arch x86_64` and `objdump -d`: `f3 a4`. The arm64 arm is a
// trap.
@nosplit fn copyBytesRepMovsb(dst: int, src: int, n: int) {
  asm volatile {
    arm64 { 0xD4200000 } // brk #0
    x64 { 0xF3, 0xA4 }   // rep movsb
    input arm64 x0 x64 rdi = dst
    input arm64 x1 x64 rsi = src
    input arm64 x2 x64 rcx = n
    clobber arm64 { memory }
    clobber x64 { memory }
  }
}

// Whether `copyBytes(dst, src, n)` takes `copyBytesUnaligned`: at least two
// words to move, an end off alignment, and an overlap the upward walk
// already handles.
@nosplit fn copyBytesWantsUnaligned(dst: int, src: int, n: int): bool {
  if (n < 16 || ((dst | src) & 7) == 0) {
    return false
  }
  return dst <= src || dst >= src + n
}

// Copies `n` (>= 16) bytes from `src` to `dst` as the header describes.
@nosplit fn copyBytesUnaligned(dst: int, src: int, n: int) {
  let head = (8 - (dst & 7)) & 7
  let i = 0
  while (i < head) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  let words = (n - head) >> 3
  copyWordsShifted(dst + head, src + head, words)
  i = head + words * 8
  while (i < n) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
}

// Moves `words` words to the 8-aligned `dst` from `src`, which may sit at
// any offset `r` within its aligned word.
@nosplit fn copyWordsShifted(dst: int, src: int, words: int) {
  let d = wordAt(dst)
  let e = d + words
  let s = wordAt(src)
  let r = src & 7
  if (r == 0) {
    while (d != e) {
      *d = *s
      d = d + 1
      s = s + 1
    }
    return
  }
  let rs = u64(r * 8)
  let ls = u64(64 - r * 8)
  let lo = u64(*s)
  while (d != e) {
    s = s + 1
    let hi = u64(*s)
    *d = i64((lo >> rs) | (hi << ls))
    lo = hi
    d = d + 1
  }
}
