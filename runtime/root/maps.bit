// Split out of `root.bit` (#1503): Wyhash and the `map<K,V>` entry points
// (SPEC §11.2, §13.5; ABI.md §15). Sibling file, same module — see `root.bit`
// for the port's header and seams.

// ---------------------------------------------------------------------------
// Wyhash (final version 4) — the string-key hash
// ---------------------------------------------------------------------------
//
// Wyhash FINAL VERSION 4 specifically, which `runtime/root/`'s `mapHash` calls.
// The version matters and must not be "upgraded" casually: successive wyhash
// revisions produce different digests, so a different version is a different
// slot order. `_tests_/stress/rootmap` checks this against the SEVEN OFFICIAL TEST
// VECTORS from wangyi-fudan's `test_vector.cpp` — an oracle outside this
// codebase, which is the only kind worth having here.
//
// Only the one-shot `hash(seed, input)` path is ported. The streaming
// `update`/`final` half exists for incremental hashing, which no map key needs.

const wySecret0: u64 = 0xa0761d6478bd642f
const wySecret1: u64 = 0xe7037ed1a0b428db
const wySecret2: u64 = 0x8ebc6af09c88c6e3
const wySecret3: u64 = 0x589965cc75374cc3

// The high 64 bits of the 128-bit product `a * b`, via 32-bit limbs.
//
// Bit has no u128 and no widening multiply, so the schoolbook decomposition is
// the only route. The carry out of the middle sum is the step that is easy to
// drop — and dropping it is invisible on small inputs, which is exactly why the
// test vectors (all four length classes) are the guard rather than a spot check.
@nosplit fn mulHi(a: u64, b: u64): u64 {
  let lo32: u64 = 0xffffffff
  let a0 = a & lo32
  let a1 = a >> 32
  let b0 = b & lo32
  let b1 = b >> 32
  let p00 = a0 * b0
  let p01 = a0 * b1
  let p10 = a1 * b0
  let p11 = a1 * b1
  let mid = (p00 >> 32) + (p01 & lo32) + (p10 & lo32)
  return p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
}

// wyhash's `mix`: the low and high halves of the 128-bit product, xored.
@nosplit fn wyMix(a: u64, b: u64): u64 {
  let lo = a * b
  let hi = mulHi(a, b)
  return lo ^ hi
}

// `n` little-endian bytes at `addr`, zero-extended. `n <= 8`.
@nosplit fn readLe(addr: int, n: int): u64 {
  let v: u64 = 0
  let i = 0
  while (i < n) {
    let b = loadByte(addr + i)
    v = v | (u64(b) << u64(i * 8))
    i = i + 1
  }
  return v
}

// Wyhash over the `len` bytes at `addr`, seed 0 — the exact call `runtime/root/`'s
// `mapHash` makes.
//
// The state is three cells rather than a `[3]u64` because a local fixed array
// is not addressable the way module state is; the round below is unrolled over
// them, which is what an unrolled 3-iteration loop compiles to anyway.
@nosplit fn wyhash(addr: int, vlen: int, seed: u64): u64 {
  let s0 = seed ^ wyMix(seed ^ wySecret0, wySecret1)
  let s1 = s0
  let s2 = s0
  let a: u64 = 0
  let b: u64 = 0

  if (vlen <= 16) {
    // smallKey
    if (vlen >= 4) {
      let end = vlen - 4
      let quarter = (vlen >> 3) << 2
      a = (readLe(addr, 4) << 32) | readLe(addr + quarter, 4)
      b = (readLe(addr + end, 4) << 32) | readLe(addr + end - quarter, 4)
    } else if (vlen > 0) {
      let c0 = loadByte(addr)
      let c1 = loadByte(addr + (vlen >> 1))
      let c2 = loadByte(addr + vlen - 1)
      a = (u64(c0) << 16) | (u64(c1) << 8) | u64(c2)
      b = 0
    } else {
      a = 0
      b = 0
    }
  } else {
    let i = 0
    if (vlen >= 48) {
      // round(): three independent lanes per 48-byte block.
      while (i + 48 < vlen) {
        let r0 = readLe(addr + i + 0, 8)
        let r1 = readLe(addr + i + 8, 8)
        s0 = wyMix(r0 ^ wySecret1, r1 ^ s0)
        let r2 = readLe(addr + i + 16, 8)
        let r3 = readLe(addr + i + 24, 8)
        s1 = wyMix(r2 ^ wySecret2, r3 ^ s1)
        let r4 = readLe(addr + i + 32, 8)
        let r5 = readLe(addr + i + 40, 8)
        s2 = wyMix(r4 ^ wySecret3, r5 ^ s2)
        i = i + 48
      }
      // final0
      s0 = s0 ^ (s1 ^ s2)
    }
    // final1, with `start_pos = i` over the whole input.
    let j = i
    while (j + 16 < vlen) {
      let x = readLe(addr + j, 8)
      let y = readLe(addr + j + 8, 8)
      s0 = wyMix(x ^ wySecret1, y ^ s0)
      j = j + 16
    }
    a = readLe(addr + vlen - 16, 8)
    b = readLe(addr + vlen - 8, 8)
  }

  // final2
  a = a ^ wySecret1
  b = b ^ s0
  let lo = a * b
  let hi = mulHi(a, b)
  a = lo
  b = hi
  return wyMix(a ^ wySecret0 ^ u64(vlen), b ^ wySecret1)
}

// ---------------------------------------------------------------------------
// Maps (SPEC §11.2, §13.5; ABI.md §15)
// ---------------------------------------------------------------------------

// Wyhash over the bytes of a `string`, at an explicit seed. Exists so the
// official test vectors can drive the exact routine `mapHash` uses, rather than
// a copy of it that could drift.
export @nosplit @symbol("bit_rt_wyhash_string")
fn rtWyhashString(s: int, seed: u64): u64 {
  let p = strBytes(s)
  let n = strSize(s)
  return wyhash(p, n, seed)
}

// splitmix64's finalizer: cheap avalanche so low-entropy integer keys (0,1,2,…)
// do not cluster in the low probe bins. The published splitmix64 constants.
@nosplit fn scalarHash(key: u64): u64 {
  let x = key
  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9
  x = (x ^ (x >> 27)) * 0x94d049bb133111eb
  return x ^ (x >> 31)
}

// ---------------------------------------------------------------------------
// Structural comparison of composite values (SPEC §14.6)
// ---------------------------------------------------------------------------
//
// A class or tuple value IS a heap box, so comparing the word compares the
// ALLOCATION and not the value: two separately built `P{x:1}` came out unequal
// (#2105, #2113), and a `map<P,int>` hashed every insert into its own slot, so
// re-inserting an equal key GREW the map instead of overwriting (#2111). §14.6
// says a class compares field-wise and a tuple element-wise, so both need a
// walk of the box.
//
// THE RUNTIME CANNOT DERIVE THE SHAPE ON ITS OWN. The GC's `TypeInfo` says which
// words hold references, never what KIND of reference — a `string` and a nested
// class are both one traced word — and a string LITERAL is a static `{ptr,len}`
// pair in `.data` with no GC header at all, so there is nothing to read a
// descriptor out of. The compiler therefore hands the shape down as a DESCRIPTOR
// PROGRAM: a string constant it emits at the comparison site and at `map_new`.
//
// THE GRAMMAR — one byte per body word, in body order:
//
//   '{' item* '}'  an aggregate. Its items describe consecutive 8-byte words of
//                  the box's body.
//   'w'            a raw word, compared and hashed BY VALUE. Integers, bools,
//                  runes, C-like enums, raw pointers, floats, and any packed
//                  sub-word fields that share the word.
//   's'            a `string` handle, compared and hashed BY ITS BYTES.
//   'r'            an opaque reference — slice, map, chan, function, interface,
//                  payload enum — compared and hashed BY IDENTITY, which is what
//                  those types have in place of a value equality.
//   '{' ... '}'    a nested class or tuple: dereferenced and walked.
//
// WHY ONE WALK AND NOT TWO. `descEqAgg` and `descHashAgg` read the SAME program
// and take the SAME cases in the SAME order, so `eq(a,b) => hash(a)==hash(b)`
// holds case by case rather than by review: 'w' equal words hash the same word,
// 's' equal bytes hash the same bytes, 'r' equal handles hash the same handle,
// and a nested aggregate is the induction step. Two implementations that merely
// agreed today would give a map that silently loses entries the day they drift,
// which is worse than either original bug.
//
// FLOATS COMPARE BY BIT PATTERN inside a composite, where a bare `f64 ==` is
// IEEE. Deliberate: it is the only rule that keeps composite equality REFLEXIVE,
// and a key not equal to itself is a key that can never be found or deleted. It
// also matches what a bare `map<f64,int>` key already does here. The cost is
// that `+0.0` and `-0.0` differ in a field; the gain is that a NaN field does
// not strand a map entry.
//
// A FIELD WHOSE TYPE IS NOT COMPARABLE AT ALL (a slice, a map) compares by
// identity via 'r' rather than making the whole comparison fail. `vComparable`
// is deliberately permissive on structs, so `P { tags: []string } == P {...}`
// still reaches lowering; identity is the answer that is total, bounded and
// consistent with the hash.

// The deepest nesting either walk will follow. The compiler's generator stops
// well short of this (`descMaxDepth` in compiler/lowerprim.bit), so this is the
// backstop that keeps a malformed or recursive program from running away —
// Power of 10 rule 2, a statically provable bound on every loop.
const descMaxDepth: int = 8

const descAgg: int = 123    // '{'
const descEnd: int = 125    // '}'
const descStr: int = 115    // 's'

// The `key_is_string` header slot (ABI.md §15) now carries the key DESCRIPTOR:
// 0 for a word-sized scalar key, 1 for a `string` key, and otherwise the handle
// of the descriptor program for a composite key. The slot is UNTRACED, which is
// exactly right for all three — a program is a string CONSTANT, static for the
// life of the process, so nothing has to keep it alive.
const mapKeyDesc: int = mapKeyIsString
const mapKeyScalar: int = 0
const mapKeyString: int = 1

// The index just past the `}` matching the `{` at `p`, or `plen` when the
// program is malformed. Bounded by the program's length.
@nosplit fn descSkipAgg(prog: int, plen: int, p: int): int {
  let nest = 0
  let i = p
  while (i < plen) {
    let c = loadByte(prog + i)
    if (c == descAgg) {
      nest = nest + 1
    } else if (c == descEnd) {
      nest = nest - 1
      if (nest == 0) {
        return i + 1
      }
    }
    i = i + 1
  }
  return plen
}

// ---- the equality half -----------------------------------------------------
//
// Three functions, and the hash half below mirrors them one for one:
// `descEqAgg`/`descHashAgg` walk an aggregate, `descEqChild`/`descHashChild`
// take a nested `{...}` item, `descEqLeaf`/`descHashLeaf` take a single word.
// Reading a pair side by side is how the `eq => same hash` implication is
// checked, so the split is load-bearing, not cosmetic.

// A NON-aggregate descriptor item over the two body words at the same offset.
// `'s'` compares a string's BYTES; everything else — `'w'` by value, `'r'` by
// identity, and any unrecognised byte — compares the raw word, so a malformed
// program can only UNDER-report equality, never over-report it.
//
// `strSize(0)` is 0, so a null handle is the empty string here, the same reading
// `bit_rt_string_eq` already takes (ABI.md §2).
@nosplit fn descEqLeaf(c: int, wa: int, wb: int): bool {
  if (wa == wb) {
    return true
  }
  if (c == descStr) {
    return rtStringEq(wa, wb)
  }
  return false
}

// The `{...}` item at `prog[p]`, whose two words are handles to nested
// aggregates. Returns the index just past the item, or -1 when they differ.
@nosplit fn descEqChild(wa: int, wb: int, desc: int, p: int, depth: int): int {
  if (wa == wb) {
    // The same box on each side, or both null: equal without a walk, and
    // `descHashChild` reaches the identical value for the identical reason.
    return descSkipAgg(strBytes(desc), strSize(desc), p)
  }
  if (wa == 0 || wb == 0) {
    return -1
  }
  return descEqAgg(wa, wb, desc, p, depth + 1)
}

// Compares the aggregates at `a` and `b` against the descriptor program `desc`
// from index `p`, where `prog[p]` is the opening `{`. Returns the index just past
// the matching `}` when they are equal, -1 when they are not. Bounded by the
// program's length at each level and by `descMaxDepth` levels.
@nosplit fn descEqAgg(a: int, b: int, desc: int, p: int, depth: int): int {
  if (depth > descMaxDepth) {
    return -1
  }
  let prog = strBytes(desc)
  let plen = strSize(desc)
  let i = p + 1
  let off = 0
  while (i < plen) {
    let c = loadByte(prog + i)
    if (c == descEnd) {
      return i + 1
    }
    let wa = loadWord(a + off)
    let wb = loadWord(b + off)
    off = off + 8
    if (c == descAgg) {
      i = descEqChild(wa, wb, desc, i, depth)
    } else if (descEqLeaf(c, wa, wb)) {
      i = i + 1
    } else {
      i = -1
    }
    if (i < 0) {
      return -1
    }
  }
  return -1
}

// `bit_rt_value_eq` (ABI.md §15.1): `a == b` for a class or tuple, field-wise per
// SPEC §14.6. `desc` is the descriptor program the compiler emitted for the
// operand type.
export @nosplit @symbol("bit_rt_value_eq")
fn rtValueEq(a: int, b: int, desc: int): bool {
  if (a == b) {
    return true
  }
  if (a == 0 || b == 0) {
    return false
  }
  return descEqAgg(a, b, desc, 0, 0) >= 0
}

// ---- the hash half, mirroring the three above ------------------------------

// Folds one component hash into the running value. Sequential, so the fold is
// ORDER-SENSITIVE and `(1, 2)` does not collide with `(2, 1)`.
@nosplit fn descMixIn(h: u64, x: u64): u64 {
  return wyMix(h ^ x, wySecret2)
}

// The hash of a non-aggregate item — the mirror of `descEqLeaf`. `'s'` hashes the
// BYTES `descEqLeaf` compares (`wyhash(0, 0, 0)` reads no memory, so a null
// handle hashes as the empty string it compares as); everything else hashes the
// raw word `descEqLeaf` compares.
@nosplit fn descHashLeaf(c: int, w: int): u64 {
  if (c == descStr) {
    return wyhash(strBytes(w), strSize(w), u64(0))
  }
  return scalarHash(u64(w))
}

// The hash of a nested `{...}` item — the mirror of `descEqChild`. A null handle
// contributes 0, which is what makes the two-nulls case agree with the equality
// side's "same box" answer.
@nosplit fn descHashChild(w: int, desc: int, p: int, depth: int): u64 {
  if (w == 0) {
    return 0
  }
  return descHashAgg(w, desc, p, depth + 1)
}

// The value hash of the aggregate at `v` under `desc` from index `p`. Takes the
// same cases in the same order as `descEqAgg` — that correspondence is what makes
// `eq(a,b) => hash(a)==hash(b)` true, so the two must be edited together.
@nosplit fn descHashAgg(v: int, desc: int, p: int, depth: int): u64 {
  if (depth > descMaxDepth) {
    return scalarHash(u64(v))
  }
  let prog = strBytes(desc)
  let plen = strSize(desc)
  let h = wySecret0
  let i = p + 1
  let off = 0
  while (i < plen) {
    let c = loadByte(prog + i)
    if (c == descEnd) {
      return h
    }
    let w = loadWord(v + off)
    off = off + 8
    if (c == descAgg) {
      h = descMixIn(h, descHashChild(w, desc, i, depth))
      i = descSkipAgg(prog, plen, i)
    } else {
      h = descMixIn(h, descHashLeaf(c, w))
      i = i + 1
    }
  }
  return h
}

// A key's hash: a `string` key hashes its BYTES (so two equal strings at
// different addresses collide correctly), a composite key hashes its CONTENTS
// through its descriptor program, a scalar hashes by value.
@nosplit fn mapHash(m: int, key: int): u64 {
  let d = loadWord(m + mapKeyDesc)
  if (d == mapKeyScalar) {
    return scalarHash(u64(key))
  }
  if (d == mapKeyString) {
    let p = strBytes(key)
    let n = strSize(key)
    return wyhash(p, n, u64(0))
  }
  if (key == 0) {
    return 0
  }
  return descHashAgg(key, d, 0, 0)
}

// Key equality, matching `mapHash`'s notion of identity case for case.
@nosplit fn mapKeyEq(m: int, a: int, b: int): bool {
  let d = loadWord(m + mapKeyDesc)
  if (d == mapKeyScalar) {
    return a == b
  }
  if (d == mapKeyString) {
    return rtStringEq(a, b)
  }
  return rtValueEq(a, b, d)
}

// Locates `key`'s slot AND reports presence in ONE returned value: a key that
// is present returns its slot index, always >= 0; a key that is absent returns
// `-1 - slot`, where `slot` is where it BELONGS — the first tombstone the walk
// saw, else the EMPTY slot that stopped it. `mapProbeFound` and `mapProbeSlot`
// decode it.
//
// ONE VALUE, NOT SHARED SCRATCH (#4020, replacing #3297's per-worker slot).
// The found flag used to be stored into a per-worker word that the caller read
// back on its very next statement. That cost a second worker-identity walk —
// `schedCurrentWorker` -> `schedCurrentTask` -> `schedTaskOnStack`, 97
// instructions — on every probe, and its soundness rested on an adjacency
// argument about where a safepoint may land. A value returned in a register is
// private to the calling task by construction: there is no argument left to
// make and no buffer left to clobber. #3297's actual defect — one
// process-wide `probeFound` word that two GENUINELY CONCURRENT workers
// overwrote for each other, no yield involved — cannot recur without shared
// state for it to recur in.
//
// The encoding is `~slot` (`-1 - slot`), chosen so a HIT needs no decoding at
// all: the returned value already is the slot. Only `rtMapSet`, which inserts
// at the miss slot, pays the subtraction.
@nosplit fn mapProbeFound(r: int): bool {
  return r >= 0
}

// The slot `r` names, hit or miss — see the encoding note on `mapProbe`.
@nosplit fn mapProbeSlot(r: int): int {
  if (r >= 0) {
    return r
  }
  return -1 - r
}

@nosplit fn mapProbe(m: int, key: int): int {
  let vcap = loadWord(m + mapCap)
  let mask = vcap - 1
  let ctrl = loadWord(m + mapCtrl)
  let keys = loadWord(m + mapKeys)
  let i = int(mapHash(m, key) & u64(mask))
  let firstTomb = vcap    // sentinel: "none seen"
  let steps = 0
  // Bounded by `cap`: the 7/8 load factor guarantees an EMPTY slot exists.
  while (steps < vcap) {
    let c = loadByte(ctrl + i)
    if (c == ctrlEmpty) {
      if (firstTomb != vcap) {
        return -1 - firstTomb
      }
      return -1 - i
    }
    if (c == ctrlTomb) {
      if (firstTomb == vcap) {
        firstTomb = i
      }
    } else {
      let k = loadWord(keys + i * 8)
      if (mapKeyEq(m, k, key)) {
        return i
      }
    }
    i = (i + 1) & mask
    steps = steps + 1
  }
  // Unreachable: the load factor guarantees an EMPTY slot. Reporting
  // "not found" at the last slot is the non-panicking answer and
  // cannot corrupt — a caller inserting there overwrites one entry rather than
  // running off the buffer.
  return -1 - (vcap - 1)
}

// Exhaustion is fatal here, not a returned 0 (root.bit constraint 3):
// `gcAllocRaw` reaches `bit_rt_oom` directly on an exhausted heap and never
// returns.
@nosplit fn allocCtrl(vcap: int): int {
  let g = wordAt(gcAddr)
  let base = infoAddr
  // Zeroed by gcAllocRaw, so every slot starts CtrlEmpty.
  return gcAllocRaw(g, vcap, base + riMapCtrl * 8)
}

// Rehashes every FULL slot and drops all tombstones, doubling `cap` only when
// the live count itself needs the room. #3447: `rtMapSet` triggers this off
// `used` (FULL+TOMB), not the live count, so advancing keys with a pinned
// live count tripped it on tombstone buildup alone, and always doubling grew
// capacity with total insertions rather than the live set.
//
// Reinsertion probes the new table linearly from the key's hash and stops at
// the first non-FULL slot; it cannot hit a tombstone (ctrl starts zeroed).
//
// VOID, NOT `bool` (#3022): exhaustion through `allocBuf`/`allocCtrl` is
// fatal via `gcAlloc`/`gcAllocRaw` -> `bit_rt_oom` (root.bit constraint 3),
// never a returned 0, so this cannot fail today and had no `false` left to
// return (#3014); a later real failure mode has to widen past `void` to
// report it, a compile error every caller faces rather than a stale comment.
@nosplit fn mapGrow(m: int) {
  let vcap = loadWord(m + mapCap)
  let liveN = loadWord(m + mapLen)
  // Same 7/8 test as `rtMapSet`, against the live count, not `used`.
  let newcap = vcap
  if ((liveN + 1) * 8 >= vcap * 7) {
    newcap = vcap * 2
  }
  let keyDesc = loadWord(m + mapKeyDesc)
  let valIsRef = loadWord(m + mapValIsRef)
  // Any non-scalar key is a reference the key buffer has to KEEP ALIVE, not just
  // a `string` one: a composite key is a GC box, and an untraced key buffer let
  // it be collected out from under the map.
  // `elemSize` is explicit 8: maps stay word-per-element regardless of key/value
  // type (ABI.md §2/#3119) -- there is no compiler-computed width to forward here.
  let nkeys = allocBuf(newcap, keyDesc != mapKeyScalar, 8)
  let nvals = allocBuf(newcap, valIsRef != 0, 8)
  let nctrl = allocCtrl(newcap)
  let mask = newcap - 1
  let keys = loadWord(m + mapKeys)
  let vals = loadWord(m + mapVals)
  let ctrl = loadWord(m + mapCtrl)
  let i = 0
  // Bounded by the old capacity.
  while (i < vcap) {
    let c = loadByte(ctrl + i)
    if (c == ctrlFull) {
      let key = loadWord(keys + i * 8)
      let j = int(mapHash(m, key) & u64(mask))
      // Bounded: `newcap` above leaves >=1 EMPTY slot for `liveN` FULL ones.
      while (loadByte(nctrl + j) == ctrlFull) {
        j = (j + 1) & mask
      }
      storeWord(nkeys + j * 8, key)
      storeWord(nvals + j * 8, loadWord(vals + i * 8))
      storeByte(nctrl + j, ctrlFull)
    }
    i = i + 1
  }
  storeWord(m + mapKeys, nkeys)
  storeWord(m + mapVals, nvals)
  storeWord(m + mapCtrl, nctrl)
  storeWord(m + mapCap, newcap)
  // Tombstones reclaimed: `used` falls back to the live count.
  storeWord(m + mapUsed, loadWord(m + mapLen))
}

// `bit_rt_map_new`: an empty map. `keyDesc` and `valIsRef` are fixed by K/V at
// the call site and decide hashing, equality and GC tracing. `keyDesc` is 0 for
// a scalar key, 1 for a `string` key, and otherwise the descriptor program for a
// composite key (see the descriptor header above).
export @nosplit @symbol("bit_rt_map_new")
fn rtMapNew(keyDesc: int, valIsRef: int): int {
  let g = wordAt(gcAddr)
  let base = infoAddr
  // Exhaustion in any of the four allocations below is fatal, not a returned
  // 0 (root.bit constraint 3): `gcAlloc`/`gcAllocRaw` reach `bit_rt_oom`
  // directly and never come back from an exhausted heap.
  let m = gcAlloc(g, base + riMap * 8)
  let keys = allocBuf(mapInitCap, keyDesc != mapKeyScalar, 8)
  let vals = allocBuf(mapInitCap, valIsRef != 0, 8)
  let ctrl = allocCtrl(mapInitCap)
  storeWord(m + mapKeys, keys)
  storeWord(m + mapVals, vals)
  storeWord(m + mapCtrl, ctrl)
  storeWord(m + mapLen, 0)
  storeWord(m + mapCap, mapInitCap)
  storeWord(m + mapUsed, 0)
  storeWord(m + mapKeyDesc, keyDesc)
  storeWord(m + mapValIsRef, valIsRef)
  return m
}

// The nil-map-write panic (SPEC §12.6, §18.4): reading a nil map yields the
// zero value (`rtMapGet` below), but writing one panics — unlike `rtMapGet`'s
// early return, this is a deliberate divergence, not a shared one. Routed
// through `bit_rt_panic` rather than a new ABI symbol, for the same reason
// `slices.bit`'s bounds panics are (see its header comment above `panicBounds`):
// this check lives inside an existing runtime entry point, not injected by a
// backend at an operation, so `bit_rt_panic`'s extern declaration there
// already covers this sibling file in the same module.
//
// The message, packed little-endian into i64 words exactly as `slices.bit`'s
// are, and for the identical reason: the panic path must not allocate
// (root.bit constraint 3, E0075). Computed, not hand-derived.
//
//   "nil map write" (13) = "nil map " "write"
const nilMapWriteWord0: int = 2337475327928592750
const nilMapWriteWord1: int = 435744764535
const nilMapWriteLen: int = 13

// The `{ptr, len}` string header plus the inline message bytes that
// `bit_rt_panic` reads, assembled on the panic path — mirrors `slices.bit`'s
// `boundsMsg`. MODULE STATE, NOT A LOCAL: `ptrOf` needs an addressable object
// and `@nosplit` forbids allocating one per call. Scalar, so the collector
// never scans it. Two header words plus two text words: 16 bytes of text,
// enough for the 13-byte message.
let nilMapMsg: [4]i64

// Report "nil map write" and abort. NEVER RETURNS.
@nosplit fn panicNilMapWrite() {
  let base = int(ptrOf(nilMapMsg))
  let text = base + strHeaderSize
  storeWord(base + strPtr, text)
  storeWord(base + strLen, nilMapWriteLen)
  storeWord(text + 0, nilMapWriteWord0)
  storeWord(text + 8, nilMapWriteWord1)
  bit_rt_panic(base)
}

// `bit_rt_map_set`: insert or overwrite `m[key] = val`.
//
// THE GROW TEST RUNS BEFORE THE PROBE, and the order
// is observable: growing first means the slot the probe returns is a slot in the
// NEW table. Probing first and then growing would insert at a stale index.
// Reusing a TOMB keeps `used` unchanged — only an EMPTY slot is newly consumed,
// which is what makes tombstones cost capacity until the next grow rather than
// forever.
export @nosplit @symbol("bit_rt_map_set")
fn rtMapSet(m: int, key: int, val: int) {
  if (m == 0) {
    panicNilMapWrite()
    return
  }
  let used = loadWord(m + mapUsed)
  let vcap = loadWord(m + mapCap)
  if ((used + 1) * 8 >= vcap * 7) {
    mapGrow(m)
  }
  let r = mapProbe(m, key)
  let slot = mapProbeSlot(r)
  if (!mapProbeFound(r)) {
    let ctrl = loadWord(m + mapCtrl)
    if (loadByte(ctrl + slot) == ctrlEmpty) {
      storeWord(m + mapUsed, loadWord(m + mapUsed) + 1)
    }
    storeByte(ctrl + slot, ctrlFull)
    storeWord(m + mapLen, loadWord(m + mapLen) + 1)
  }
  storeWord(loadWord(m + mapKeys) + slot * 8, key)
  storeWord(loadWord(m + mapVals) + slot * 8, val)
}

// `bit_rt_map_get`: `m[key]`, or the zero word when absent (SPEC §11.2 — an
// absent key reads as V's zero value). A nil map reads as empty.
export @nosplit @symbol("bit_rt_map_get")
fn rtMapGet(m: int, key: int): int {
  if (m == 0) {
    return 0
  }
  if (loadWord(m + mapLen) == 0) {
    return 0
  }
  let slot = mapProbe(m, key)
  if (!mapProbeFound(slot)) {
    return 0
  }
  let v = loadWord(loadWord(m + mapVals) + slot * 8)
  return v
}

// `bit_rt_map_has`: presence test (backs the two-result form and `delete`).
export @nosplit @symbol("bit_rt_map_has")
fn rtMapHas(m: int, key: int): bool {
  if (m == 0) {
    return false
  }
  if (loadWord(m + mapLen) == 0) {
    return false
  }
  return mapProbeFound(mapProbe(m, key))
}

// `bit_rt_map_delete`: `delete(m, key)` — a no-op if absent.
//
// Leaves a TOMBSTONE (reclaimed at the next grow) and DROPS THE SLOT'S KEY AND
// VALUE WORDS. The drop is not tidiness: those words live in traced ref buffers,
// so leaving them would keep a removed key or value reachable and unreclaimable
// for the lifetime of the map.
export @nosplit @symbol("bit_rt_map_delete")
fn rtMapDelete(m: int, key: int) {
  if (m == 0) {
    return
  }
  if (loadWord(m + mapLen) == 0) {
    return
  }
  let slot = mapProbe(m, key)
  if (!mapProbeFound(slot)) {
    return
  }
  storeByte(loadWord(m + mapCtrl) + slot, ctrlTomb)
  storeWord(loadWord(m + mapKeys) + slot * 8, 0)
  storeWord(loadWord(m + mapVals) + slot * 8, 0)
  storeWord(m + mapLen, loadWord(m + mapLen) - 1)
}

// `bit_rt_map_len`: `len(m)` — live entry count (nil map => 0).
export @nosplit @symbol("bit_rt_map_len")
fn rtMapLen(m: int): int {
  if (m == 0) {
    return 0
  }
  let n = loadWord(m + mapLen)
  return n
}

// Iteration (`for k of m`, §13.5): `iterInit` yields the first FULL slot or -1,
// `iterNext` the next FULL slot after `prev` or -1. Slot order is unspecified
// and a concurrent insert may rehash — iteration assumes no mutation, per spec.
export @nosplit @symbol("bit_rt_map_iter_init")
fn rtMapIterInit(m: int): int {
  return rtMapIterNext(m, -1)
}

export @nosplit @symbol("bit_rt_map_iter_next")
fn rtMapIterNext(m: int, prev: int): int {
  if (m == 0) {
    return -1
  }
  let vcap = loadWord(m + mapCap)
  let ctrl = loadWord(m + mapCtrl)
  let i = prev + 1
  while (i < vcap) {
    if (loadByte(ctrl + i) == ctrlFull) {
      return i
    }
    i = i + 1
  }
  return -1
}

export @nosplit @symbol("bit_rt_map_key_at")
fn rtMapKeyAt(m: int, slot: int): int {
  let k = loadWord(loadWord(m + mapKeys) + slot * 8)
  return k
}

export @nosplit @symbol("bit_rt_map_val_at")
fn rtMapValAt(m: int, slot: int): int {
  let v = loadWord(loadWord(m + mapVals) + slot * 8)
  return v
}
