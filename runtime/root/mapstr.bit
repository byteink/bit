// Map reads keyed by a `string` the caller holds as WORDS (#5906; ABI.md §15).
//
// Since #4424 a `string` parameter or fresh local lives as three words
// (`ptr`, `len`, `base`), not as a header. `bit_rt_map_get`/`bit_rt_map_slot`
// read their key through a header, so every read keyed by such a string had
// the compiler build a 24-byte box first, only to be read back apart here.
// The `_str` entries below take the two words the probe compares, so the
// caller passes them and builds nothing. Neither needs `base`: both are
// `@nosplit` and allocate nothing, so no collection can run inside them, and
// keeping `base` live across the call is the caller's job (the #4406
// keepalive edges `unboxStringWords` records).
//
// The compiler emits these only for a `map<string, _>`, so the key
// descriptor is `mapKeyString` and `mapKeyEq` takes its string arm. The hash
// is `mapHash`'s string arm over the same bytes, so a key inserted through a
// header is found through its words and the other way round.

// `mapProbe` for a caller holding the key as a header or a scalar word: the
// two words `mapKeyEq` compares, `(ptr, len)` for a `string` key and
// `(key, 0)` otherwise. `strBytes`/`strSize` read a null header as the empty
// string, as `mapHash` does.
@nosplit fn mapProbeKey(m: int, ctrl: int, key: int, h: u64): int {
  if (loadWord(m + mapKeyDesc) == mapKeyString) {
    return mapProbe(m, ctrl, strBytes(key), strSize(key), h)
  }
  return mapProbe(m, ctrl, key, 0, h)
}

// `bit_rt_map_get_str`: `m[k]` for the string `k` whose bytes are
// `ptr[0:n]`, or the zero word when absent — `bit_rt_map_get`'s contract.
export @nosplit @symbol("bit_rt_map_get_str") fn rtMapGetStr(m: int, ptr: int, n: int): int {
  if (m == 0) {
    return 0
  }
  if (loadWord(m + mapLen) == 0) {
    return 0
  }
  let ctrl = mapTable(m)
  let slot = mapProbe(m, ctrl, ptr, n, wyhash(ptr, n, u64(0)))
  if (!mapProbeFound(slot)) {
    return 0
  }
  return loadWord(loadWord(ctrl + tblVals) + slot * 8)
}

// `bit_rt_map_slot_str`: `bit_rt_map_slot`'s token for the string `k` whose
// bytes are `ptr[0:n]`, or -1 when absent. The token is the same value-word
// address `bit_rt_map_val_at` dereferences (maptable.bit).
export @nosplit @symbol("bit_rt_map_slot_str") fn rtMapSlotStr(m: int, ptr: int, n: int): int {
  if (m == 0) {
    return -1
  }
  if (loadWord(m + mapLen) == 0) {
    return -1
  }
  let ctrl = mapTable(m)
  let r = mapProbe(m, ctrl, ptr, n, wyhash(ptr, n, u64(0)))
  if (!mapProbeFound(r)) {
    return -1
  }
  return mapValToken(ctrl, r)
}
