// Map reads keyed by a `string` the caller holds as WORDS (#5906; ABI.md §15).
//
// Since #4424 a `string` parameter or fresh local lives as three words
// (`ptr`, `len`, `base`), not as a header. `bit_rt_map_get`/`bit_rt_map_slot`
// read their key through a header, so every read keyed by such a string had
// the compiler build a 24-byte box first, only to be read back apart here.
// The `_str` entries below take the two words the probe compares, so the
// caller passes them and builds nothing. Neither needs `base`: both are
// `@nosplit` and allocate nothing, so no collection can run inside them, and
// keeping `base` live across the call is the caller's job (the #4406
// keepalive edges `unboxStringWords` records).
//
// The compiler emits these only for a `map<string, _>`, so the key
// descriptor is `mapKeyString`: the compare is `mapKeyEq`'s string arm and
// the hash is `mapHash`'s, over the same bytes, so a key inserted through a
// header is found through its words and the other way round.
//
// OWN PROBE, NOT `mapProbe`'s. Taking `(ptr, len)` through `mapProbe` meant
// widening its key to two words for every caller, and the handle reads paid
// for it: +1.1..1.5% instructions on `bench/cases/strmap` and a 0x40 frame
// for `rtMapGet`'s int path. So the handle entries keep `mapProbe` as it was
// and these walk the same chain themselves. A read needs only hit or miss,
// so neither walk tracks the tombstone an insert would claim. The compare is
// written out in both walks rather than put in a helper: one extra frame per
// comparison is what `mapKeyEq` measured at +1.73% instructions on strmap.

// `bit_rt_map_get_str`: `m[k]` for the string `k` whose bytes are
// `ptr[0:n]`, or the zero word when absent — `bit_rt_map_get`'s contract.
export @nosplit @symbol("bit_rt_map_get_str") fn rtMapGetStr(m: int, ptr: int, n: int): int {
  if (m == 0) {
    return 0
  }
  if (loadWord(m + mapLen) == 0) {
    return 0
  }
  let ctrl = mapTable(m)
  let slot = mapProbeStr(ctrl, ptr, n, wyhash(ptr, n, u64(0)))
  if (slot < 0) {
    return 0
  }
  return loadWord(loadWord(ctrl + tblVals) + slot * 8)
}

// `bit_rt_map_slot_str`: `bit_rt_map_slot`'s token for the string `k` whose
// bytes are `ptr[0:n]`, or -1 when absent. The token is the same value-word
// address `bit_rt_map_val_at` dereferences (maptable.bit).
export @nosplit @symbol("bit_rt_map_slot_str") fn rtMapSlotStr(m: int, ptr: int, n: int): int {
  if (m == 0) {
    return -1
  }
  if (loadWord(m + mapLen) == 0) {
    return -1
  }
  let ctrl = mapTable(m)
  let slot = mapProbeStr(ctrl, ptr, n, wyhash(ptr, n, u64(0)))
  if (slot < 0) {
    return -1
  }
  return mapValToken(ctrl, slot)
}

// The slot of the key `ptr[0:n]` in the table `ctrl`, or -1: `mapProbe`'s
// byte loop for `probeInlineSteps` steps, then `mapProbeSwarStr` from where it
// stopped, exactly as `mapProbe` hands over to `mapProbeSwar`.
@nosplit fn mapProbeStr(ctrl: int, ptr: int, n: int, h: u64): int {
  let mask = loadWord(ctrl + tblCap) - 1
  let keys = loadWord(ctrl + tblKeys)
  let i = int(h & u64(mask))
  let tag = mapCtrlTag(h)
  let steps = 0
  while (steps < probeInlineSteps) {
    let c = loadByte(ctrl + i)
    if (c == ctrlEmpty) {
      return -1
    }
    if (c == tag) {
      let k = loadWord(keys + i * 8)
      if (rtStringEqWords(strBytes(k), strSize(k), ptr, n)) {
        return i
      }
    }
    i = (i + 1) & mask
    steps = steps + 1
  }
  return mapProbeSwarStr(ctrl, ptr, n, h, i)
}

// `mapProbeSwar`'s group walk (mapswar.bit, where the skip test and the bound
// are argued) resumed at `start`, for the key `ptr[0:n]`. `-1` on a miss.
@nosplit fn mapProbeSwarStr(ctrl: int, ptr: int, n: int, h: u64, start: int): int {
  let vcap = loadWord(ctrl + tblCap)
  let mask = vcap - 1
  let keys = loadWord(ctrl + tblKeys)
  let i = start
  let tag = mapCtrlTag(h)
  let tagRep = u64(tag) * swarOnes
  let steps = 0
  while (steps < vcap) {
    if (i + 8 <= vcap && mapGroupClean(loadLe8(ctrl + i), tagRep)) {
      i = (i + 8) & mask
      steps = steps + 8
      continue
    }
    let c = loadByte(ctrl + i)
    if (c == ctrlEmpty) {
      return -1
    }
    if (c == tag) {
      let k = loadWord(keys + i * 8)
      if (rtStringEqWords(strBytes(k), strSize(k), ptr, n)) {
        return i
      }
    }
    i = (i + 1) & mask
    steps = steps + 1
  }
  return -1
}
