// SEAM 3 remainder (#1605): the platform-FREE half of the `bit_rt_os_*` provider
// (ABI.md §19) — the three process-entry globals every `os.*` primitive reads,
// and the three ABI wrappers that need nothing but them (`os_argc`, `os_arg_at`,
// `os_env`). The kernel-facing four — `os_self_exe`, `os_run`, `os_run_test` (and
// `os_exit`, which lives in `{linux,darwin}/io.bit` as
// `bit_rt_os_exit`) — are per-OS in `root/{linux,darwin}/os.bit`, exactly as
// the fs provider splits `root/fs.bit` from `root/{linux,darwin}/fs.bit`.
//
// ---------------------------------------------------------------------------
// THIS FILE OWNS g_argc / g_argv / g_envp / gAuxv — AND ONLY DECLARES THEM
// (#1608 writes the arg triple; #1617 writes gAuxv)
// ---------------------------------------------------------------------------
//
// The kernel hands `argc`, `argv` and `envp` to the process on the initial stack
// (ABI.md §19; SEAM 6/#1580 records that the Linux `_start` is the SINGLE capture
// path, the same fact that makes it the only auxv writer). The boot/entry task
// (#1608, `_start`/`machoMain`) captures them ONCE and stores them here through
// `bit_rt_port_root_os_set_args`. There is NO second capture path in this file —
// it only DECLARES the storage and hands it back out, so the dependency points
// boot -> this (boot references a pinned setter), never this -> boot. That keeps
// this provider compiling and pinning standalone before boot exists.
//
// gAuxv (#1617) is the fourth process-entry global, and the SAME single-writer
// story: the ELF auxiliary vector sits on the initial stack just past `envp`'s
// NUL terminator, so only the Linux entry can find it, and it captures it once
// through `bit_rt_port_root_os_set_auxv`. The ABI reader `bit_rt_auxv` (ABI.md
// §19) hands the captured address back to `runtime/auxv`, whose own scan is
// `getauxval`. This is the
// move ABI.md §19 promised — "when SEAM 3 ports the entry the cell moves to the
// boot layer" — so the provider is this module's own `gAuxv` cell.
// Darwin has no auxv: `machoMain` never calls the setter, gAuxv stays 0, and the
// reader honestly reports "none" (the reader is platform-free precisely so the
// portable `runtime/auxv` resolves `bit_rt_auxv` on Darwin too).
//
// THE READER READS gAuxv DIRECTLY, never through the `auxv()` primitive: that
// primitive lowers to a call to this very symbol, `bit_rt_auxv`, so a body
// calling `auxv()` would be unbounded self-recursion (the pin cycle
// tests/bit/rootpins/ guards).
//
// The three storage cells are raw scalars, never GC objects: `gArgvPtr`/`gEnvpPtr`
// point into the kernel-provided initial stack, not the managed heap, and module
// state is never scanned by the collector (ABI.md §5, rule 1) — which is both
// required (they must not be walked as heap pointers) and free (no rooting).
//
// SHAPE: self-contained (the io.bit/fs.bit shape), NOT the netabi `extern` shape.
// This module carries no `syscall`/`extern function`, so it is trivially portable;
// the platform providers reach `gEnvpPtr` through the pinned `os_envp` accessor
// below (a cross-module CALL to a PINNED symbol, never an unpinned reference —
// #1612 warns root already carries one such gap via `slots.bit`; this adds none).
//
// PINS: the three ABI wrappers carry the bare `bit_rt_os_*` ABI name, exactly
// like `bit_rt_os_exit` in io.bit. The setter and the envp accessor carry
// `bit_rt_port_root_os_*` instead: ABI.md names no such symbol, so no rename
// ever touches them — the same distinction io.bit draws between `bit_rt_panic`
// and `bit_rt_port_root_io_write_all`.

// Bounds on the two byte scans below, both statically fixed (Power of 10 rule 2).
// `osMaxCstr` is Linux's `MAX_ARG_STRLEN` (128 KiB) — the kernel's own ceiling on
// a single argv/env string, so no real entry is truncated. `osMaxEnvCount` bounds
// the environment walk; a well-formed `envp` hits its NUL terminator far sooner,
// this only caps a malformed (unterminated) block.
const osMaxCstr: int = 131072
const osMaxEnvCount: int = 65536

// The three process-entry globals (ABI.md §19). `gArgc` is the argument count;
// `gArgvPtr` is the address of the `argv` pointer array (one C-string pointer per
// word); `gEnvpPtr` is the address of the NUL-terminated `envp` pointer array.
// All three are 0 until `bit_rt_port_root_os_set_args` runs at process entry, so
// a wrapper called before boot reports "no args / empty env" rather than faulting.
let gArgc: int = 0
let gArgvPtr: int = 0
let gEnvpPtr: int = 0

// The ELF auxiliary vector's address (ABI.md §19, `bit_rt_auxv`), captured once
// by the Linux entry (#1617) past `envp`'s NUL terminator, or 0 where there is
// none — Darwin has no auxv, and any caller before boot reads "none" rather than
// faulting. `runtime/auxv` walks the `(a_type, a_val)` pairs from here.
let gAuxv: int = 0

// Store the process-entry triple. Called ONCE by boot/entry (#1608) with the
// values the kernel placed on the initial stack. Pinned port-internal so boot (a
// different module) can reach it without an unpinned cross-module reference.
export @nosplit @symbol("bit_rt_port_root_os_set_args")
fn osSetArgs(argc: int, argvPtr: int, envpPtr: int) {
  gArgc = argc
  gArgvPtr = argvPtr
  gEnvpPtr = envpPtr
}

// Store the process's ELF auxv address. Called ONCE by the Linux entry (#1617)
// with the address it found on the initial stack past `envp`'s NUL terminator.
// Pinned port-internal (never renamed; ABI.md names no such symbol) so boot — a
// different module — reaches it without an unpinned cross-module reference, the
// same shape as `osSetArgs`. Darwin's `machoMain` never calls it, so gAuxv stays
// 0 there and the reader below reports "none".
export @nosplit @symbol("bit_rt_port_root_os_set_auxv")
fn osSetAuxv(addr: int) {
  gAuxv = addr
}

// The captured `envp` array address, for the platform `os_run`/`os_run_test`
// providers to hand to `execve` (a child must inherit the environment). Pinned
// port-internal: `root/{linux,darwin}/os.bit` reach it by `import`, and the
// reference must resolve to a pinned symbol, not the `slots.bit`-style unpinned
// gap #1612 records.
export @nosplit @symbol("bit_rt_port_root_os_envp")
fn osEnvp(): int {
  return gEnvpPtr
}

// The length of the NUL-terminated C string at `ptr`, capped at `osMaxCstr`
// (Power of 10 rule 2). `strBytes`/`loadByte` are `runtime/root`'s module-scoped
// glue (root.bit), in scope because this file is their sibling.
@nosplit fn osCstrLen(ptr: int): int {
  let i = 0
  while (i < osMaxCstr) {
    if (loadByte(ptr + i) == 0) {
      return i
    }
    i = i + 1
  }
  return osMaxCstr
}

// A fresh Bit `string` holding the bytes of the NUL-terminated C string at `ptr`.
// `runtime/root/`'s `stringFromBytes(std.mem.span(p))`, one allocation. BOUNDED by the
// string's own length, itself bounded by `osCstrLen`.
@nosplit fn osCstrToStr(ptr: int): int {
  let n = osCstrLen(ptr)
  let s = rtStrAlloc(n)
  if (s == 0) {
    return rtStrAlloc(0)
  }
  let dst = strBytes(s)
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(ptr + i))
    i = i + 1
  }
  return s
}

// True if the `envp` entry at `entry` is exactly `KEY=` for the `nameLen` bytes at
// `nameBytes`, i.e. the byte after the key is `=` (61). BOUNDED by `nameLen`.
@nosplit fn osEnvMatch(entry: int, nameBytes: int, nameLen: int): bool {
  let j = 0
  while (j < nameLen) {
    if (loadByte(entry + j) != loadByte(nameBytes + j)) {
      return false
    }
    j = j + 1
  }
  return loadByte(entry + nameLen) == 61
}

// ---------------------------------------------------------------------------
// os_run argv scratch (#2399: `bit run <src> [args...]`) — shared by the
// platform `os_run` providers (`../{linux,darwin}/os.bit`)
// ---------------------------------------------------------------------------
//
// `bit_rt_os_run`'s SIGNATURE CHANGED IN PLACE to take this `argv`, rather
// than a new symbol beside it: every caller needed updating either way
// (`compiler/build.bit`'s `runCmd`, `compiler/pmfetchtail.bit`'s `runGit`,
// and the fixtures that call the predeclared `osRun` builtin directly —
// `tests/cases/fs_walk_symlink.bit`, `tests/imports/pmadd_e2e/main.bit`,
// `examples/staticserver/staticserver.bit`), and a NEW name was tried first
// and reverted because `compiler/build.bit` is compiled by the PINNED stage0
// (a published release, `dist/stage0/SHA256SUMS`) during `./make selfhost` —
// stage0 has no idea a brand-new predeclared name exists, so a call to one
// fails `E0040: undefined name` on every clean build until the next stage0
// repin, which itself needs a published release first (circular). Reusing
// the ALREADY-recognized `osRun` identifier sidesteps that: this compiler
// validates no builtin call's arity (`compiler/validatecall.bit`'s `vCall`
// returns before the arity/type checks for a callee with no declaration), so
// stage0 accepts a 2-argument call to a name it has always known, with
// nothing new required of its own predeclared-name table.

// The ceiling the forwarded argv is willing to build a real execve(2) vector
// for: a CLI argument the caller wants to hand a CHILD process, not the
// unbounded record `bit_rt_os_arg_at` reads back at THIS process's own entry
// (`osMaxCstr` above). Both are STATED and FIXED so the scratch below is
// bounded at compile time (Power of 10 rules 2/3); above either,
// `osBuildRunArgv` REJECTS (returns 0) rather than truncating an argument or
// dropping one — the same failure #2023 closed for a silently dropped
// argument, now for an oversized argv. `compiler/build.bit`'s
// `runMaxForwardedArgs` mirrors the count: a compiler-side .bit file cannot
// see into `runtime/`'s tree, the same reason `../darwin/fs.bit`'s
// `fsLinkMaxPath` mirrors `fsMaxPath` — keep the two literals equal.
const osRunMaxArgv: int = 64
const osRunMaxArgLen: int = 4096

// `bit_rt_os_run`'s child argv scratch: one pointer slot per
// `[path, forwarded[0..n), NULL]` (osRunMaxArgv + 2 words) and a flat
// NUL-terminated byte arena, one osRunMaxArgLen-byte row per forwarded
// argument. MODULE-LEVEL and unlocked, sound under the same single-worker
// contract each platform os.bit's `osArgvBuf` documents (a `run` completes —
// fork through wait — before another can begin, with no park in between).
// Never scanned by the collector (rule 1): both hold raw bytes and pointers
// into themselves, never object references.
let osRunArgvPtrs: [66]i64
let osRunArgvBytes: [32768]i64

// Build `bit_rt_os_run`'s child argv vector: `[pathPtr, forwarded[0..n),
// NULL]`, where `pathPtr` is the caller's own already-NUL-terminated path
// (`fsPathZ`'s result) and each forwarded element is copied out of `argv` — a
// `[]string` SliceHeader address, or 0 for the empty/default slice (the same
// null-header convention `rtSliceGet` documents) — into a fresh
// NUL-terminated row of `osRunArgvBytes`. Returns the argv pointer-array
// address, or 0 if `argv` has more than `osRunMaxArgv` elements or any one is
// `osRunMaxArgLen` bytes or longer (one byte reserved for the row's own NUL,
// the same off-by-one `fsPathZ` uses against `fsMaxPath`): REJECTED, never
// truncated — see `osRunMaxArgv`'s comment above.
//
// BOUNDED (Power of 10 rule 2): the element loop runs at most `osRunMaxArgv`
// times and each element's byte copy at most `osRunMaxArgLen` times.
//
// Pinned port-internal (`bit_rt_port_root_os_*`, not `bit_rt_os_*`): ABI.md
// names no such symbol, so no rename ever touches it — the same distinction
// `fsPathZ` (../fs.bit) and `osEnvp` above draw. A freestanding build (the
// runtime archive itself) links each module separately and requires every
// cross-module reference to be `@symbol`-pinned (SPEC §11.9, ABI.md §9);
// `export` alone is enough for ordinary Bit-to-Bit calls but not for this.
export @nosplit @symbol("bit_rt_port_root_os_build_run_argv") fn osBuildRunArgv(pathPtr: int, argv: int): int {
  let n = 0
  if (argv != 0) {
    n = loadWord(argv + slcLen)
  }
  if (n > osRunMaxArgv) {
    return 0
  }
  let ptrs = int(ptrOf(osRunArgvPtrs))
  storeWord(ptrs, pathPtr)
  if (n == 0) {
    storeWord(ptrs + 8, 0)
    return ptrs
  }
  let off = loadWord(argv + slcOff)
  let buf = loadWord(argv + slcBuf)
  let arena = int(ptrOf(osRunArgvBytes))
  let i = 0
  while (i < n) {
    let s = loadWord(buf + (off + i) * 8)
    let slen = 0
    let sbytes = 0
    if (s != 0) {
      slen = strSize(s)
      sbytes = strBytes(s)
    }
    if (slen >= osRunMaxArgLen) {
      return 0
    }
    let dst = arena + i * osRunMaxArgLen
    let j = 0
    while (j < slen) {
      storeByte(dst + j, loadByte(sbytes + j))
      j = j + 1
    }
    storeByte(dst + slen, 0)
    storeWord(ptrs + (i + 1) * 8, dst)
    i = i + 1
  }
  storeWord(ptrs + (n + 1) * 8, 0)
  return ptrs
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §19) — bare `bit_rt_os_*` pins.
// ---------------------------------------------------------------------------

// `bit_rt_os_argc`: the process argument count (`argv[0]` is the program).
export @nosplit @symbol("bit_rt_os_argc") fn rtOsArgc(): int {
  return gArgc
}

// `bit_rt_os_arg_at`: argument `i`, or the empty string when out of range
// (`i < 0` or `i >= argc`) or the slot is NULL. `runtime/root/`'s `os_arg_at`, bounds
// check and all — Bit has no nil string, so out-of-range is the empty string.
export @nosplit @symbol("bit_rt_os_arg_at") fn rtOsArgAt(i: int): int {
  if (i < 0 || i >= gArgc) {
    return rtStrAlloc(0)
  }
  let p = loadWord(gArgvPtr + i * 8)
  if (p == 0) {
    return rtStrAlloc(0)
  }
  return osCstrToStr(p)
}

// `bit_rt_os_env`: the value of environment variable `name`, or the empty string
// when unset (Bit has no nil string; `std/os` maps empty to absent). Walks the
// raw `envp` array for the first `name=` entry and returns the bytes after `=` —
// getenv's own "first match wins" semantics, the reason `os_run_test` can shadow
// an inherited var by prepending its own.
export @nosplit @symbol("bit_rt_os_env") fn rtOsEnv(name: int): int {
  let nameLen = strSize(name)
  let nameBytes = strBytes(name)
  let i = 0
  while (i < osMaxEnvCount) {
    let entry = loadWord(gEnvpPtr + i * 8)
    if (entry == 0) {
      return rtStrAlloc(0)
    }
    if (osEnvMatch(entry, nameBytes, nameLen)) {
      return osCstrToStr(entry + nameLen + 1)
    }
    i = i + 1
  }
  return rtStrAlloc(0)
}

// `bit_rt_auxv`: the address of this process's ELF auxiliary vector, or 0 when
// there is none (Darwin, or before the Linux entry captured it). The reader
// used to live in `runtime/root/root.bit`; its provider moved here in #1617.
// Reads gAuxv DIRECTLY, NOT through the `auxv()` primitive: `auxv()` lowers to
// a call to this very symbol, so routing the body through it would be
// unbounded self-recursion — the pin cycle tests/bit/rootpins/ guards.
// `runtime/auxv` does the scan over what this returns.
export @nosplit @symbol("bit_rt_auxv") fn rtAuxv(): int {
  return gAuxv
}
