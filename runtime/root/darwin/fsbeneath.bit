// `bit_rt_fs_open_beneath_w`/`bit_rt_fs_fstat_w` (ABI.md §14 addendum, #5793):
// close the TOCTOU #5787 found through pkg/web's static file server — it
// validates every path component with `lstat` and then opens by path, so a
// parent directory swapped for a symlink to outside the served root between
// the check and the open is followed. `./fs.bit`'s `rtFsOpenNoFollowW`
// (#4720) only refuses a symlink in the FINAL component; every ancestor is
// still an unguarded lookup.
//
// Sibling file to ./fs.bit rather than added there so this module's other
// `bit_rt_fs_*` symbols keep compiling unchanged; the two new symbols are
// wired to Bit through "std/fs/secure" (stdlib/fs/secure/secure.bit), NOT
// "std/fs" itself. compiler/ and tools/build import "std/fs" and are built
// by the pinned 0.24.0 stage0, whose libbitrt lacks these two symbols; a
// release that ships this commit repins the stage0 and folds them into
// "std/fs" then (#2153's bootstrap trap, restated on this ticket).
//
// `root` AND `rel` ARRIVE SEPARATELY, NOT PRE-JOINED — this is load-bearing,
// not just API shape. `root` is opened NORMALLY (following its own
// symlinks), exactly like `open` does: a real deployment's configured
// static-file root is routinely reached through a symlinked ancestor (this
// machine's own `$TMPDIR`, `/var` -> `/private/var` — see
// pkg/web/static.test.bit's "root reached through a symlinked parent" test)
// and O_NOFOLLOW_ANY below refuses EVERY symlink in whatever path it is
// given, root's own ancestors included. Only `rel`, resolved via `openat`
// against `root`'s already-open dirfd, gets the no-follow treatment — this
// was tried the other way first (one `open` call on the joined path) and
// failed exactly this way against a `$TMPDIR`-rooted fixture.
//
// `wordsPathZ`, `isDirAtP`, `u8At`, `fstat`, `fsStatBuf`, `fsScratchSlot`,
// `fsStatSlotWords`, `statModeOff`, `loadU16LE`, `sIfmt`, `sIfdir` are NOT
// imported here: ./fs.bit and ./fsrw.bit, siblings in this same module,
// already declare/import every one of them, and Bit's imports and top-level
// declarations are module-scoped — a second import or a redeclaration here
// would be E0042. `open`/`close` (./fs.bit) are reused the same way.

// `O_DIRECTORY` (`<sys/fcntl.h>`, confirmed on this machine's SDK):
// `0x00100000`. OR'd onto `root`'s open so a non-directory `root` fails
// outright rather than handing back a useless fd.
const oDirectory: int = 1048576 // 0x00100000

// `O_NOFOLLOW_ANY` (`<sys/fcntl.h>`, confirmed on this machine's SDK, not
// memory): "no symlinks allowed in path" — unlike `O_NOFOLLOW`
// (./fs.bit's `oNoFollow`, final component only), the kernel refuses a
// symlink anywhere in the path it resolves `rel` against `root`'s dirfd.
// One `openat` call is therefore race-free end to end for `rel`: no
// per-component walk is needed the way ../linux/fsbeneath.bit's walk needs
// one (Linux has no single-flag equivalent outside `openat2`).
const oNoFollowAny: int = 536870912 // 0x20000000

// `S_IFREG` (`<sys/stat.h>`, POSIX-common, same value darwin and linux):
// `0o100000`. `rtFsFstatW` below uses this to tell a plain file apart from
// a FIFO, device or socket placed directly under a served root (none of
// which `rtFsOpenBeneathW` rejects — only a directory or a symlink in
// `rel`'s resolution is refused there) so a caller like `std/fs/secure`'s
// `statOpen` can answer "is this safe to read" without a second, racy path
// lookup (#5798).
const sIfreg: int = 32768 // 0o100000

// `O_NONBLOCK` (`<sys/fcntl.h>`, Darwin bit 2 — value `4`, matching
// `runtime/root/darwin/osruncap.bit`'s own `osCapNonBlock` and
// `runtime/net/darwin/sock.bit`'s `oNonBlock()`, re-declared locally for
// the same layering reason those two give). OR'd onto `rel`'s leaf open
// below: a plain POSIX `open()` on a FIFO with no writer on the other end
// BLOCKS AT OPEN TIME, before this function has even returned an fd for
// `statOpen` to answer "is this regular" about (#5798) — `O_NONBLOCK`
// makes that open return immediately instead, at which point the caller's
// `isRegular` check refuses it with no read ever attempted. Harmless on a
// regular file or a directory: `O_NONBLOCK` only changes read()/open()
// blocking behaviour on a FIFO, device or socket.
const oNonBlock: int = 4

// `fdopendir(int): DIR *` / `dup(int): int` (`<dirent.h>`/`<unistd.h>`),
// needed by `bit_rt_fs_list_dir_fd_w` below (#5800): `fdopendir` is the only
// libSystem way to `readdir()`-enumerate an ALREADY-OPEN fd instead of
// re-opening by path, and `dup` exists because `closedir` closes whatever
// `fdopendir` wraps — `walkBeneath` still needs its own `dirFd` open
// afterward to descend into each child, so listing operates on a DUP, never
// the caller's fd itself.
extern fn fdopendir(fd: i32): *u8
extern fn dup(fd: i32): i32

// `openat(int, const char *, int, ...)` — VARIADIC exactly like ./fs.bit's
// `open`, and for the identical reason: `mode` is the single variadic
// argument, and arm64 Apple's calling convention puts every variadic
// argument on the stack regardless of how many named ones precede it, so
// `modeStack` (the 10th argument) is where `openat` actually reads it; the
// register copy (`modeReg`) is inert. `root`'s own open below reuses
// ./fs.bit's `open` extern instead of this one, since it is NOT relative
// to any dirfd.
extern fn openat(
  dirfd: i32,
  path: *u8,
  flags: i32,
  modeReg: i64,
  pad4: i64,
  pad5: i64,
  pad6: i64,
  pad7: i64,
  pad8: i64,
  modeStack: i64,
): i32

// Whether the NUL-terminated C path `p` (`n` bytes, not counting the NUL)
// contains a bare `..` COMPONENT anywhere. `O_NOFOLLOW_ANY`/`openat` refuse
// a symlink in `rel`'s resolution, but `..` is an ordinary directory entry,
// never a symlink — it resolves straight through `O_NOFOLLOW_ANY` and would
// climb out of `root` with no symlink involved at all. This is the runtime's
// OWN containment check, independent of `stdlib/fs/secure/secure.bit`'s
// lexical `std/path.contains` call: a security primitive does not get to
// assume every future caller remembers to run that check first. BOUNDED
// (Power of 10 rule 2): by `n`, `p`'s own length.
@nosplit fn hasDotDotComponent(p: int, n: int): bool {
  let i = 0
  let start = 0
  while (i <= n) {
    if (i == n || loadByte(p + i) == 47) {
      let clen = i - start
      if (clen == 2 && loadByte(p + start) == 46 && loadByte(p + start + 1) == 46) {
        return true
      }
      start = i + 1
    }
    i = i + 1
  }
  return false
}

// Whether the open fd `fd` names a directory — `fstat(2)`, the fd-based
// twin of ./fs.bit's `isDirAtP`, needed here because `rel`'s open has no
// path left to re-probe by the time it succeeds.
@nosplit fn fdIsDir(fd: int): bool {
  let slotBase = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  if (int(fstat(i32(fd), u8At(slotBase))) < 0) {
    return false
  }
  let mode = loadU16LE(slotBase + statModeOff)
  return (mode & sIfmt) == sIfdir
}

// Open the already-scratch-copied, NUL-terminated C path `p` as a
// directory, FOLLOWING its own symlinks — `rtFsOpenBeneathW`'s root-open
// step, factored out so `rtFsOpenDirW` below (`walkBeneath`'s root open,
// #5800) shares it instead of repeating the `open(..., oDirectory, ...)`
// call.
@nosplit fn openDirFollowingP(p: int): int {
  return int(open(u8At(p), i32(oDirectory), i64(0), 0, 0, 0, 0, 0, i64(0)))
}

// `bit_rt_fs_open_beneath_w`: open `root` (the `rootN`-byte packed path at
// `rootWords`, following its own symlinks) as a directory, then `rel` (the
// `relN`-byte packed path at `relWords`) against it via `openat` with
// `O_NOFOLLOW_ANY`, refusing a symlink anywhere `rel` resolves. The caller —
// `stdlib/fs/secure/secure.bit`'s `openBeneath` — has already run
// `std/path`'s `join`+`contains` on `root`/`rel` to refuse a lexical `..`
// escape before this call reaches the kernel at all. Directories are
// rejected via `fdIsDir` above. fd, or -1 for a malformed `root` or `rel`, a
// directory, a symlink anywhere in `rel`'s resolution (`openat` answering
// ELOOP), or any other open failure alike.
export @nosplit @symbol("bit_rt_fs_open_beneath_w") fn rtFsOpenBeneathW(
  rootWords: int, rootN: int, relWords: int, relN: int,
): int {
  let rootP = wordsPathZ(rootWords, rootN)
  if (rootP == 0) {
    return 0 - 1
  }
  let rootFd = openDirFollowingP(rootP)
  if (rootFd < 0) {
    return 0 - 1
  }
  // `wordsPathZ` reuses ONE per-worker scratch slot -- `rootP`'s bytes are
  // already consumed by `open` above, so computing `relP` into the same
  // slot next is safe reuse, not a clobber.
  let relP = wordsPathZ(relWords, relN)
  if (relP == 0 || loadByte(relP) == 47 || hasDotDotComponent(relP, relN)) {
    let _ = close(i32(rootFd))
    return 0 - 1
  }
  let fd = int(
    openat(i32(rootFd), u8At(relP), i32(oNoFollowAny | oNonBlock), i64(0), 0, 0, 0, 0, 0, i64(0)),
  )
  let _ = close(i32(rootFd))
  if (fd < 0) {
    return 0 - 1
  }
  if (fdIsDir(fd)) {
    let _ = close(i32(fd))
    return 0 - 1
  }
  return fd
}

// `bit_rt_fs_fstat_w`: `fd`'s metadata via `fstat(2)` — the same 6-word
// `out` shape ./fs.bit's `fillStat` fills from a path (size, mtime, mode,
// isDir, isSymlink) PLUS one word `fillStat` does not carry, `isRegular`,
// but read from the already-open handle so a caller never re-resolves a
// name that could have moved since `open` returned. `isSymlink` is always
// `false`: `fstat` reports the target a followed fd already is, same as
// `fillStat`'s `follow = true` path. 0 on success, -1 on failure.
export @nosplit @symbol("bit_rt_fs_fstat_w") fn rtFsFstatW(fd: int, out: int): int {
  let slotBase = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  if (int(fstat(i32(fd), u8At(slotBase))) < 0) {
    return 0 - 1
  }
  let mode = loadU16LE(slotBase + statModeOff)
  storeWord(out, loadWord(slotBase + statSizeOff))
  storeWord(out + 8, loadWord(slotBase + statMtimeSecOff))
  storeWord(out + 16, mode & 4095)
  let isDir = 0
  if ((mode & sIfmt) == sIfdir) {
    isDir = 1
  }
  storeWord(out + 24, isDir)
  storeWord(out + 32, 0)
  let isRegular = 0
  if ((mode & sIfmt) == sIfreg) {
    isRegular = 1
  }
  storeWord(out + 40, isRegular)
  return 0
}

// `bit_rt_fs_open_dir_w`/`bit_rt_fs_open_dir_beneath_fd_w`/
// `bit_rt_fs_list_dir_fd_w` (#5800): the three primitives `std/fs/secure`'s
// `walkBeneath` needs to close #5787's OTHER TOCTOU — `std/fs`'s own `walk`
// (stdlib/fs/fs.bit) checks `isRealDir(p)` then calls `readDir(p)` BY PATH,
// so a directory swapped for a symlink to outside the tree between the two
// calls is followed, exactly the race `openBeneath` above closes for a
// single file open. `walkBeneath` never re-resolves a path once it has an
// fd: it lists each directory FROM the fd it already opened no-follow, and
// descends into a child only by opening it no-follow relative to that SAME
// fd — a swap of any ancestor after this walk holds its fd can no longer
// change what that fd names, the same invariant `rtFsOpenBeneathW`'s
// `O_NOFOLLOW_ANY` open relies on.

// `bit_rt_fs_open_dir_w`: open the `n`-byte packed path at `words` as a
// directory, FOLLOWING its own symlinks — `walkBeneath`'s ROOT open. `root`
// is the trusted boundary the caller named, exactly like `openBeneath`'s
// `root` argument, so it is opened normally; only the DESCENT below it
// (`rtFsOpenDirBeneathFdW`) refuses a symlink. fd, or -1 for a malformed
// path, a non-directory, or any other open failure.
export @nosplit @symbol("bit_rt_fs_open_dir_w") fn rtFsOpenDirW(words: int, n: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  return openDirFollowingP(p)
}

// Whether the NUL-terminated `n`-byte name at `p` is safe to open as a
// SINGLE path component: no `/` anywhere (a real directory entry can never
// contain one; this only guards a future caller that hands this primitive
// something other than one listed name), and not `.`/`..` (`walkBeneath`'s
// own listing, `rtFsListDirFdW` below, already excludes both, the same
// defense-in-depth reasoning `hasDotDotComponent` above gives for
// `rtFsOpenBeneathW`'s `rel`). BOUNDED (Power of 10 rule 2): by `n`.
@nosplit fn isSingleSafeComponent(p: int, n: int): bool {
  if (n == 0) {
    return false
  }
  if (n == 1 && loadByte(p) == 46) {
    return false
  }
  if (n == 2 && loadByte(p) == 46 && loadByte(p + 1) == 46) {
    return false
  }
  let i = 0
  while (i < n) {
    if (loadByte(p + i) == 47) {
      return false
    }
    i = i + 1
  }
  return true
}

// `bit_rt_fs_open_dir_beneath_fd_w`: open the SINGLE path component
// `nameWords[0:nameN)` relative to the already-open directory `dirFd`,
// refusing a symlink (`O_NOFOLLOW_ANY`, same flag `rtFsOpenBeneathW` uses)
// and requiring the result to be a directory (`O_DIRECTORY`) —
// `walkBeneath`'s DESCENT step. `dirFd` is already open and pinned by this
// process's own fd table, so a rename or symlink-swap of an entry after
// `walkBeneath` LISTED `dirFd` (`rtFsListDirFdW`) cannot change what
// `dirFd` itself names; only what the CHILD resolves to, which
// `O_NOFOLLOW_ANY` catches here. fd of the child directory, or -1 for a
// symlink, a non-directory, `.`/`..`/an embedded `/`, or any other open
// failure — `walkBeneath` reports every one of these as a LEAF path, the
// same contract `std/fs`'s path-based `walk` gives a symlink or a plain
// file.
export @nosplit @symbol("bit_rt_fs_open_dir_beneath_fd_w") fn rtFsOpenDirBeneathFdW(
  dirFd: int, nameWords: int, nameN: int,
): int {
  let nameP = wordsPathZ(nameWords, nameN)
  if (nameP == 0 || !isSingleSafeComponent(nameP, nameN)) {
    return 0 - 1
  }
  let fd = int(
    openat(i32(dirFd), u8At(nameP), i32(oNoFollowAny | oDirectory), i64(0), 0, 0, 0, 0, 0, i64(0)),
  )
  if (fd < 0) {
    return 0 - 1
  }
  return fd
}

// Copy ONE `readdir` entry (`nameAddr`, NUL-terminated) into `outPtr[0:outCap)`
// at offset `totalIn`, skipping `.`/`..`, and return the updated total.
// Split out of `rtFsListDirFdW` below to keep that function's nesting under
// spec/LINT.md's limit — inlined, the copy loop plus the `.`/`..` guard put
// it one level past `./fs.bit`'s own `sysList`, which already carries that
// depth as undocumented debt; this one does not repeat it.
@nosplit fn copyDirentName(nameAddr: int, outPtr: int, outCap: int, totalIn: int): int {
  let nlen = cstrLen(nameAddr)
  if (isDotName(nameAddr, nlen)) {
    return totalIn
  }
  let total = totalIn
  let j = 0
  while (j < nlen) {
    if (total + j < outCap) {
      storeByte(outPtr + total + j, loadByte(nameAddr + j))
    }
    j = j + 1
  }
  if (total + nlen < outCap) {
    storeByte(outPtr + total + nlen, 0)
  }
  return total + nlen + 1
}

// `bit_rt_fs_list_dir_fd_w`: the already-open directory `fd`'s entries
// (`.`/`..` omitted), snprintf-shaped exactly like `./fs.bit`'s path-based
// `bit_rt_fs_list_dir` (measure with `outCap == 0`, then fill) — but listed
// straight off `fd` via `fdopendir`, never by re-resolving a path, so a
// rename or symlink-swap of the directory itself after `walkBeneath` opened
// it cannot change what gets listed. `fd` is `dup`'d first (see the extern
// declarations' comment above): `closedir` closes whatever `fdopendir`
// wraps, and `walkBeneath` still needs its own `fd` open afterward to
// descend into each child (`rtFsOpenDirBeneathFdW`). Total bytes needed, or
// -1 if `fd` does not name a directory or `dup`/`fdopendir` fails. BOUNDED
// (Power of 10 rule 2): the same argument `./fs.bit`'s `sysList` gives —
// `readdir` returns nil at end of directory (or on error, treated
// identically), and a directory has finitely many entries.
export @nosplit @symbol("bit_rt_fs_list_dir_fd_w") fn rtFsListDirFdW(
  fd: int, outPtr: int, outCap: int,
): int {
  let dupFd = int(dup(i32(fd)))
  if (dupFd < 0) {
    return 0 - 1
  }
  let dir = fdopendir(i32(dupFd))
  if (int(dir) == 0) {
    let _ = close(i32(dupFd))
    return 0 - 1
  }
  let total = 0
  let done = false
  while (!done) {
    let ent = readdir(dir)
    if (int(ent) == 0) {
      done = true
    } else {
      total = copyDirentName(int(ent) + direntNameOff, outPtr, outCap, total)
    }
  }
  let _ = closedir(dir)
  return total
}
