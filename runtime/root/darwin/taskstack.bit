// runtime/root/darwin/taskstack.bit — split out of ./bootworker.bit (#7128)
// to bring both files under the 800-line limit after #6007's task-block cache
// and #7128's retake landed together. A pure move: guarded stack mapping
// (#2579) and the task-block take/release pair (#6007). Same module as every
// sibling here, so callers in ./boot.bit and ./bootworker.bit reach these with
// no import.

// ---------------------------------------------------------------------------
// Guarded stack mapping — moved from ./boot.bit by #2579 (see the header note
// above). Unchanged verbatim.
// ---------------------------------------------------------------------------
// Round `addr` up to the next `schedStackBytes` boundary (`schedStackAligned`).
@nosplit fn alignUpStack(addr: int): int {
  let bumped = addr + schedStackBytes - 1
  return bumped - bumped % schedStackBytes
}

// Round `addr` down to the `schedStackBytes` boundary at or below it — the
// complement of `alignUpStack` above. `./signal.bit`'s `classifyOverflowTrap`
// uses this to find the candidate stack BASE below an arbitrary `sp` reading,
// where `alignUpStack` would instead round UP past it: a SIGSEGV/SIGBUS fault
// address sits BELOW a stack's base (in the guard hole), so rounding up lands
// on the base, but `sp` at a #2432 inline-trap site sits AT OR ABOVE the base
// (the corrupting frame lands ON the self-pointer/tag words, never past them —
// see task.bit's "A task that reaches here"), so rounding up would overshoot
// to the NEXT granule entirely.
@nosplit fn alignDownStack(addr: int): int {
  return addr - addr % schedStackBytes
}

// `main`'s own stack size is `schedMainStackBytes` (`../../sched`, imported by
// ./boot.bit into this module's scope) — NOT `schedStackBytes` (#1843). See
// that const's own comment for why 8 MiB, and why masking cannot name a stack
// this size, so it is named through `schedRegisterBigStack` instead.

// One task stack, aligned as `schedStackAligned` requires and GUARDED BELOW.
// Returns the base (lowest address, where the tag and the chan scratch live), or
// 0 on failure. Identical to ../linux/boot.bit's.
//
// THE GUARD IS THE POINT, and it costs no extra syscall (#1843). The alignment
// contract already forces mapping extra granules so a correctly-aligned window
// can be carved out of them; that leaves slop BELOW the chosen base which was
// previously left mapped and writable. PROT_NONE-ing it turns it into a hole, so a
// stack that grows past its base faults instead of scribbling over whatever the
// allocator put next. `runtime/root/` had this as `mapGuardedStack`; the port shipped
// without it, and the difference is measurable rather than theoretical: with the
// hole, a recursion past the limit dies at the boundary having printed NOTHING;
// without it, the same program printed a plausible checksum and died later
// (`_tests_/stress/deeprecursion`, mutation-tested both ways).
//
// #2433: THE HEAD HOLE IS `protectPages`'d, NOT `unmapPages`'d. It used to be
// unmapped, which frees the address range back to the kernel's free list —
// and `rtSpawn` (below) maps the task control block two statements after
// calling this function. A first-fit `mmap` regularly landed inside the hole
// it had just freed: measured on 40 live spawned tasks, 8 (20%) had NO guard
// left at all, because the task block had consumed the entire hole. Making
// the hole PROT_NONE instead keeps it a live, occupied mapping — still
// inaccessible, so an overflow still faults exactly as before, but no later
// `mapPages` can ever be handed the same address.
//
// #2433 (width, this change): the head hole above used to BE `base -
// region` — a stated maximum of one granule, but no floor: whatever the
// alignment carve left, which could be as little as a single OS page
// (4 KiB on Linux/x86, 16 KiB on aarch64-macOS). One oversized frame is
// then enough to step clean over the hole into whatever mapping follows it,
// silently, instead of faulting. The head hole is now FLOORED to exactly
// `schedStackBytes` (256 KiB) below `base`, every call, regardless of where
// the allocator's alignment landed `region`. `schedStackBytes` is the floor
// rather than an arbitrary new constant because it was already this hole's
// observed MAXIMUM before this change — the alignment carve never left
// more — so the floor never makes a guard narrower than the strongest case
// this function already produced by luck, only removes the luck, and it
// keeps every distance in this file in the one granule the masked-identity
// scheme already uses. It costs 256 KiB of reserved, PROT_NONE VIRTUAL
// ADDRESS SPACE per spawned task — never resident, since PROT_NONE pages
// are never faulted in.
//
// To guarantee a full granule below `base` regardless of alignment, the
// mapped region is now `bytes + 2 * schedStackBytes` (one granule wider
// than before) and `base = alignUpStack(region + schedStackBytes)` rather
// than `alignUpStack(region + 1)`, forcing `base` at least one whole
// granule above `region` so `[base - schedStackBytes, base)` is always
// entirely inside the mapping. The leftover below that fixed guard (0 to
// `schedStackBytes - 1` bytes, still alignment-dependent) is freed via
// `unmapPages`: safe, because it sits further from `base` than the guard,
// so a downward overflow always reaches the fixed guard first, regardless
// of what a later allocation does with the freed sliver.
//
// THE TAIL HOLE (#2167 follow-up) is unrelated to downward-overflow
// detection — the stack grows DOWN from `base + bytes`
// (`schedTaskContext`'s call site below) — but is sized off the same
// mapping and moves with it: the freed head sliver plus the fixed head
// guard together take `schedStackBytes` of the `bytes + 2 * schedStackBytes`
// total (by construction), so what remains above `base` is `bytes` plus a
// tail of `schedStackBytes - headSlop` bytes — never touched, never shows
// up as RSS, but still a live, counted VMA for as long as the process runs,
// one per call. `rtSpawn` calls this once per `spawn`, and Linux caps live
// VMAs per process at `vm.max_map_count` (default 65530): left unmapped, a
// long-running server would trade a slow OOM kill for an abrupt
// `rootExit(70)` at roughly 65k live spawns, which is not this ticket's
// fix, only a different failure mode for the same unbounded growth.
@nosplit fn mapGuardedStack(bytes: int): int {
  if (bytes <= 0) {
    return 0
  }
  // `bytes + 2 * schedStackBytes`: one granule so an aligned base can always
  // be carved (as before), a second so a FULL granule is always available
  // below that base to dedicate as the guard, regardless of alignment
  // (#2433 — see header). Aligning to the granule even for an oversized
  // stack keeps one code path: masking will miss inside it either way (its
  // interior boundaries hold ordinary frame data, not the tag), and the
  // oversized-stack registry is what names it.
  let region = mapPages(bytes + 2 * schedStackBytes)
  if (region == 0) {
    return 0
  }
  // `alignUpStack(region + schedStackBytes)` rather than `+ 1`: forces base
  // at least one whole granule above region, so the fixed-width guard below
  // it (immediately below) is always entirely inside the mapping.
  let base = alignUpStack(region + schedStackBytes)
  if (!schedStackAligned(base) ||
    base < region + schedStackBytes ||
    base - region >= 2 * schedStackBytes) {
    return 0
  }
  // The head guard (#2433: floored to exactly one schedStackBytes granule,
  // PROT_NONE, not unmapped — see the header). A failure here is not fatal
  // — the stack above is intact and usable, it just has no guard — but it
  // is never expected, so it is not silent.
  if (!protectPages(base - schedStackBytes, schedStackBytes)) {
    return 0
  }
  if (!trimStackSlop(region, base, bytes)) {
    return 0
  }
  return base
}

// Frees what `mapGuardedStack` over-mapped around the guarded stack at `base`.
// False when either unmap fails.
@nosplit fn trimStackSlop(region: int, base: int, bytes: int): bool {
  // The unneeded leftover below the fixed guard (0 to schedStackBytes - 1
  // bytes, still alignment-dependent) is freed back — safe, since it sits
  // further from base than the guard, so a downward overflow always
  // reaches the guard first regardless of what reuses this sliver.
  let headSlop = base - schedStackBytes - region
  if (headSlop > 0 && !unmapPages(region, headSlop)) {
    return false
  }
  // The tail hole. See the header: the freed head sliver plus the fixed
  // head guard together take schedStackBytes of the mapping, so what
  // remains above base is bytes plus this leftover tail.
  let tailSlop = schedStackBytes - headSlop
  if (tailSlop > 0 && !unmapPages(base + bytes, tailSlop)) {
    return false
  }
  return true
}

// The task block and guarded stack for one `rtSpawn` (#6007): a retired pair
// from `runtime/sched/stackcache.bit` when one is cached, else a fresh
// `mapGuardedStack` stack and a task block one word wider than a plain one
// (`taskSpawnEntry`, #1622). The block's `taskStackBase` names the stack. 0
// when a mapping fails, which `rtSpawn` treats as fatal.
@nosplit fn spawnTaskBlock(): int {
  let cached = schedStackCacheTake()
  if (cached != 0) {
    return cached
  }
  let stackBase = mapGuardedStack(schedStackBytes)
  if (stackBase == 0) {
    return 0
  }
  let taskAddr = mapPages((taskWords + 1) * 8)
  if (taskAddr == 0) {
    return 0
  }
  *(taskAt(taskAddr) + taskStackBase) = stackBase
  return taskAddr
}

// Release a retired spawned task (#2167): back to the cache (#6007), or, when
// the cache is full, its stack, its head guard (#3990, permanent since #2433)
// and its block are unmapped. Safe: the task is already off the registry, and
// #2433's hazard was reuse by the SAME task's own next allocation — a later
// task's guard is always protected first.
@nosplit fn releaseTask(doneTask: int) {
  if (schedStackCachePut(doneTask)) {
    return
  }
  let dt = taskAt(doneTask)
  let stackBase = *(dt + taskStackBase)
  unmapPages(stackBase, *(dt + taskStackBytes))
  unmapPages(stackBase - schedStackBytes, schedStackBytes)
  unmapPages(doneTask, (taskWords + 1) * 8)
}

