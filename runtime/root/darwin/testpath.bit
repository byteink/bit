// runtime/root/darwin/testpath.bit — the outstanding-`bit test`-binary
// tracker (#5765) and its scratch-directory cleanup (#5789 follow-up), split
// out of ./os.bit (#5789: os.bit was 805 lines against this house's
// 800-line ceiling once the #5789 addition landed there). PURE MOVE of the
// #5765 block plus the #5789 addition already made to it — no wording or
// behaviour change from what #5765 proved (darwin's own signal-delivery
// tests) or what #5789 proved locally. Same module as os.bit and fs.bit (a
// sibling `.bit` file in this directory), so every name this file uses —
// `osScratchSlot`/`osScratchSlots` (os.bit's own "../../root" import),
// `storeWord` (os.bit's own "../../gc" import), `loadByte`/`storeByte`/
// `loadWord`/`u8At` (fs.bit/io.bit), `rmdir`/`unlink` (extern, fs.bit) — is
// already module-scoped and reused here, not re-declared (a redeclaration
// is E0042).
//
// `termHandler` (./signal.bit) calls `osUnlinkAllOutstandingTestPaths`
// alongside `osKillAllOutstandingChildren()`; `rtOsRunTestBounded` (./os.bit)
// calls `osMarkTestPathOutstanding` right after it resolves the child's
// path. Both call sites are unchanged by this move — Bit's module-wide
// binding means neither needs to import from this file.

// #5765: the CURRENT `bit test` binary's path outstanding per worker slot —
// a raw C-string pointer, the same value `fsPathZ` returns, 0 = none. Same
// single-writer-per-slot shape as `osOutstandingChildPid` above: written ONLY
// by `rtOsRunTestBounded` below, right after it resolves the child's path,
// and cleared once `osForkExecWaitBounded` returns. Never written from
// `rtOsRunBounded`: that primitive's own callers (`osRunBounded` and its
// `_tests_/bit/testtimeout/testtimeout.bit` teardown scripts) are NOT test
// binaries and must never be auto-deleted on kill. `termHandler`
// (./signal.bit) reads every slot for the same reason
// `osKillAllOutstandingChildren`'s comment gives: the kernel may deliver the
// signal to any thread, not necessarily the one that owns the slot.
let osOutstandingTestPath: [33]i64 // (osScratchSlots+1) * 1

// Remove the fresh, private per-run directory `p`'s test binary was
// created in (#5789: `createScratchExecutable` puts it at `<dir>/<name>`,
// one `mkdir`'d 0700 directory per test run) — see ../linux/os.bit's
// identical function for the full reasoning (a follow-up to #5765, whose
// own unlink left this now-empty directory behind). Finds the LAST '/' by
// scanning forward from `p`, BOUNDED at 4096 (`../fs.bit`'s `fsMaxPath`:
// `p` is a NUL-terminated path in a slot of exactly that size). Temporarily
// NULs the slash — safe, this process is exiting and nothing reads `p`
// again — `rmdir`s the prefix, restores the '/'. A failed `rmdir` just
// leaves the directory, the same harmless-leftover contract `unlink`
// already has for the file. `@nosplit`-safe: no allocation, no Bit string
// op, the raw C-string scan and one libSystem call.
@nosplit fn osRmdirParentOf(p: int) {
  let i = 0
  let lastSlash = -1
  while (i < 4096) {
    let b = loadByte(p + i)
    if (b == 0) {
      break
    }
    if (b == 47) { // '/'
      lastSlash = i
    }
    i = i + 1
  }
  if (lastSlash <= 0) {
    return
  }
  storeByte(p + lastSlash, 0)
  let _ = rmdir(u8At(p))
  storeByte(p + lastSlash, 47)
}

// Unlink every worker slot's outstanding test binary (#5765), so a `bit
// test` runner killed directly by SIGTERM/SIGINT does not leave the Mach-O
// executable `compiler/testrun.bit` compiled it into behind in `$TMPDIR` —
// `osForkExecWaitBounded`'s own poll loop, which has no unlink of its own
// either, never runs once the process dies at `rootExit` below. `@nosplit`,
// called from the signal handler: no allocation, no Bit string op, just the
// raw pointer straight into `unlink(2)`. `osRmdirParentOf` (#5789
// follow-up) then removes the now-empty directory the binary was created in.
@nosplit fn osUnlinkAllOutstandingTestPaths() {
  let base = int(ptrOf(osOutstandingTestPath))
  let i = 0
  while (i <= osScratchSlots) {
    let p = loadWord(base + i * 8)
    if (p != 0) {
      let _ = unlink(u8At(p))
      osRmdirParentOf(p)
    }
    i = i + 1
  }
}

// Publish `p` as this worker's outstanding test binary path (#5765) and
// return the slot address, so `rtOsRunTestBounded` below can clear it with a
// single `storeWord` once `osForkExecWaitBounded` returns — same split as
// `osMarkChildOutstanding` above.
@nosplit fn osMarkTestPathOutstanding(p: int): int {
  let addr = int(ptrOf(osOutstandingTestPath)) + osScratchSlot() * 8
  storeWord(addr, p)
  return addr
}
