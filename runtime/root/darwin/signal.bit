// Darwin signal-disposition provider for the SEAM 3 remainder: the process-wide
// `sigaction` `boot` (#1608) needs — ignoring SIGPIPE so a `write` to a socket
// whose peer has closed its read end returns EPIPE instead of raising SIGPIPE,
// whose default disposition kills the process with no output. The Bit form of
// `runtime/root/`'s `ignoreSigpipe` (runtime/root/:1965); every networked runtime
// installs it at startup (Go, libuv).
//
// KEPT FUNCTION-FOR-FUNCTION WITH ../linux/signal.bit so a divergence is a real
// platform difference, not a stylistic one. The two differences: (1) the call
// goes through libSystem `sigaction` via `extern function` (§11.7) rather than a
// raw trap, because Apple publishes no stable syscall numbers (../darwin/io.bit);
// (2) the Darwin `class sigaction` is a different, smaller layout than Linux's
// kernel class.
//
// EVERY STRUCT OFFSET AND CONSTANT BELOW WAS READ OUT OF THE macOS SDK HEADERS
// (`<sys/signal.h>`'s `class sigaction`, `SIG*` and `sigset_t`), NOT
// FROM MEMORY. A wrong offset here is a SILENT wrong-disposition: the build stays
// green and the process still dies on a broken pipe.
//
// #1436 IS NOT A HAZARD HERE, unlike ../darwin/io.bit's `write`: `sigaction` is
// NOT a POSIX cancellation point, so libSystem exports no `sigaction$NOCANCEL`
// variant for the self-hosted compiler to prefer and drop the plain import over.
//
// ALL 9 FUNCTIONS BELOW ARE `@nosplit` TODAY (`ignoreSigpipe`,
// `installAltStackForThisWorker`, `segvHandler`, `classifyOverflowTrap`,
// `trapHandler`, `emitMainStackOverflow`, `emitSpawnedStackOverflow`,
// `emitFatalSignal`, `installFatalSignalHandlers`) — including
// `ignoreSigpipe`, which makes the `extern` `sigaction` call below. `@nosplit`
// no longer categorically rejects an `extern function` call: it IS legal in a
// `@nosplit` body (#1640), the same admission ../linux/io.bit's header
// documents for `syscall`. This directory already builds `--freestanding
// --emit-obj` (io.bit's header again), so the old "cannot become freestanding
// until #1369" framing is gone too.

// `storeWord` is imported from ../../gc by ./os.bit and is module-scoped
// (siblings are one module), so it is reused here, not re-imported — a
// redeclaration is E0042.

// libSystem `int sigaction(int sig, const class sigaction *act, class
// sigaction *oact)` (§11.7). Only C-representable types cross the boundary: the
// two class pointers travel as `*u8`, the signal and result as `i32`. This is
// the PUBLIC `sigaction`, whose 16-byte `class sigaction` libsystem wraps around
// the raw `__sigaction` trap and its trampoline — so no `sa_tramp` field is ours
// to fill (it is only ever installed for a real handler, never for SIG_IGN).
extern fn sigaction(sig: i32, act: *u8, oact: *u8): i32

// SIGPIPE = 13 and SIG_IGN = 1 on Darwin (`<sys/signal.h>`).
const sigPipe: int = 13
const sigIgn: int = 1

// The Darwin `class sigaction` (`<sys/signal.h>`):
//
//     offset  0 : handler (8 bytes)  <- SIG_IGN = 1
//     offset  8 : mask    (sigset_t) <- 0   (sigset_t = u32, 4 bytes)
//     offset 12 : flags   (c_uint)   <- 0
//
// = 16 bytes = 2 words. Zeroing both words then setting the handler word covers
// mask and flags in one pass — the layout packs mask and flags into the second
// word.
const sigActionWords: int = 2

// The `class sigaction` scratch, MODULE-LEVEL and unlocked. SAFE AT ANY
// WORKER COUNT, but NOT by the single-worker/adjacency argument this used to
// cite — that argument does not hold for a genuinely shared buffer (#3279,
// ABI.md §5.1/§22). What makes it safe: `boot`'s step 1 calls `ignoreSigpipe`
// exactly once, before step 2 maps the heap and before the scheduler seats
// any worker — ABI.md §22's "write-once-before-any-worker-exists" category.
// `ignoreSigpipe`'s only other caller in the tree, _tests_/stress/sigpipedarwin's
// `main`, runs a single sequential call after `boot` has already returned —
// still one writer at a time, never two. A scalar array is never scanned by
// the collector (rule 1).
let sigActBuf: [2]i64

// `bit_rt_ignore_sigpipe` (post-#1369 name): install SIG_IGN for SIGPIPE
// process-wide. Returns libSystem `sigaction`'s result — 0 on success, -1 on
// failure — so `boot` and the test can observe it, though `runtime/root/`'s
// `ignoreSigpipe` discards it. Idempotent.
//
// PINNED under the bare ABI name, NOT `bit_rt_port_`: a real ABI name `boot`
// (#1608) calls, bare since G2 (#1583) — the convention ./io.bit documents
// for `bit_rt_panic` and the rest.
export @nosplit @symbol("bit_rt_ignore_sigpipe") fn ignoreSigpipe(): int {
  let base = int(ptrOf(sigActBuf))
  let i = 0
  while (i < sigActionWords) {
    storeWord(base + i * 8, 0)
    i = i + 1
  }
  storeWord(base, sigIgn)
  let nilp: *u8 = nil
  return int(sigaction(i32(sigPipe), nilp + base, nilp))
}

// ---------------------------------------------------------------------------
// #2246: a diagnosable SIGSEGV/SIGBUS instead of a silent exit 139
// ---------------------------------------------------------------------------
//
// `mapGuardedStack` (../boot.bit) already turns a stack overflow into a real
// hardware fault instead of silent corruption (#1843). What was still missing
// is the OTHER half: nothing in this runtime installs a disposition for
// SIGSEGV or SIGBUS, so that fault reaches the process default and a user
// gets exit 139 with NOTHING on either stream — measured on a built binary,
// not just `bit run`, which at least prints "killed by SIGSEGV" itself.
//
// THE TWO DEFECTS #2246 NAMED, AND WHICH ONE THIS IS. (1) a green thread's
// stack is fixed and ~32x smaller than main's — that is `schedStackBytes`
// (../../sched/sched.bit) and #2613's to raise; not touched here. (2) the
// death is undiagnosed — this section, in full.
//
// WHY THIS CANNOT PROMISE THE FAULT REACHES ITS HANDLER AT ALL, ONLY THAT
// WHEN IT DOES THE MESSAGE IS HONEST. `mapGuardedStack`'s guard hole is a
// VARIABLE width (#2433 — `base - region`, whatever the allocator's alignment
// carve happens to leave), so a frame larger than the hole can step clean
// past it into unrelated memory before anything faults. That is #2433's
// defect, not this one's, and fixing it would make the attribution below
// MORE reliable, not required for it to be honest today.
//
// THE ALTERNATE STACK IS NOT OPTIONAL. The fault this exists to catch is,
// most often, exactly a green thread's OWN 256 KiB stack running out — so the
// handler cannot run on the stack that just overflowed; SA_ONSTACK plus a
// per-OS-thread `sigaltstack` (below) is the only way a handler can reliably
// get CPU time after that.

// SIGSEGV = 11, SIGBUS = 10 (`<sys/signal.h>`). Darwin's SIGBUS number is NOT
// Linux's (7, ../linux/signal.bit) — the two are BSD- and historical-Unix-
// derived respectively and diverge here, unlike SIGPIPE (13 on both).
const sigSegv: int = 11
const sigBus: int = 10

// SIGILL = 4, SIGTRAP = 5 (`<sys/signal.h>`, verified against this SDK's
// header, 2026-08-13) — UNLIKE SIGBUS these two are the same number on both
// platforms (Linux `include/uapi/asm-generic/signal.h` agrees, already cited
// by ../linux/signal.bit for SIGBUS/SIGSEGV/SIGPIPE): the classic low
// signals 1-6 predate the BSD/SysV split that gave SIGBUS its two numbers.
// #2946: the OTHER shape #2432's inline `brk #0` (arm64, this platform)/`ud2`
// (x64) traps raise when `schedCurrentTask` returns 0 — see
// `classifyOverflowTrap` below.
const sigIll: int = 4
const sigTrap: int = 5

// SA_SIGINFO = 0x40, SA_ONSTACK = 0x1 (`<sys/signal.h>`). SA_SIGINFO selects
// the three-argument `void (*)(int, siginfo_t *, void *)` handler form
// `segvHandler` below is written to, over the one-argument SIG_IGN form
// `ignoreSigpipe` installs. Verified with `offsetof`/a real build against this
// SDK's headers (2026-08-13), not from memory.
const saSiginfo: int = 64
const saOnstack: int = 1

// `int sigaltstack(const stack_t *ss, stack_t *oss)` (`<signal.h>`). `stack_t`
// here is `{ void *ss_sp; size_t ss_size; int ss_flags; }` — 24 bytes, THREE
// words, and the field ORDER is Darwin's own: Linux's `stack_t` puts
// `ss_flags` second and `ss_size` last (../linux/signal.bit). Verified with
// `offsetof` against this SDK's `<signal.h>`: ss_sp@0, ss_size@8, ss_flags@16.
extern fn sigaltstack(ss: *u8, oss: *u8): i32

// `siginfo_t.si_addr` — the faulting address SA_SIGINFO hands the handler,
// `segvHandler`'s second argument. Verified with `offsetof` against this
// SDK's `<signal.h>`, not from memory: offset 24, `sizeof(siginfo_t)` = 104.
const siAddrOffset: int = 24

// The `ucontext_t` this SDK's SA_SIGINFO handler receives as its third
// argument is 56 bytes and carries `uc_mcontext` as a POINTER (not inline,
// unlike Linux's) at offset 48 — verified with `offsetof`/`sizeof`, not from
// memory. `*(ctx + 48)` is the live `mcontext_t` (really
// `_STRUCT_MCONTEXT64*`): exception state first (16 bytes), then the thread
// state (`__ss`) at offset 16, and inside THAT, `__sp` at offset 248 and
// `__pc` at 256 (`offsetof(class __darwin_arm_thread_state64, __sp/__pc)`).
// So the saved stack pointer at the moment of the fault is
// `*(*(ctx + 64bit ptr @ ucMcontextOffset) + mcontextSpOffset)`.
const ucMcontextOffset: int = 48
const mcontextSpOffset: int = 264

// The floor both `segvHandler` and `classifyOverflowTrap` gate every
// alignment match against: it rules out a degenerate near-zero reading (e.g.
// both inputs landing on unmapped/zeroed memory) agreeing with itself, or an
// uninitialized `mainStackBaseAddr` (0 before step 5 of `boot`) matching a
// coincidentally-zero candidate. Every real stack mapping on this platform
// sits far above it. Named rather than left as the two functions' own inline
// literal so the two attribution paths cannot silently drift apart.
const stackAddrFloor: int = 268435456

// One alternate signal stack per worker OS thread, 64 KiB — comfortably above
// `MINSIGSTKSZ` (32768 on this SDK, verified with `sizeof`/a real run, not
// from memory) and a round number matching the granule this runtime already
// reasons in. `boot` maps `bootMaxWorkers * sigAltStackBytes` once, before any
// worker starts (`sigAltStackBase`, ./boot.bit); each worker OS thread claims
// one slice for itself below, because `sigaltstack` is per-THREAD, not
// per-process — two workers sharing one alternate stack would corrupt each
// other's crash message if they ever overflowed at the same instant.
const sigAltStackBytes: int = 65536

// `installAltStackForThisWorker`'s claim table: 0 = free, 1 = claimed, sized
// for `bootMaxWorkers` (../boot.bit) and never released — workers do not exit
// before process teardown. Same claim-then-use shape as
// `../../thread/darwin/spawn.bit`'s `trampClaim`: an atomic CAS per slot,
// bounded, first-free wins.
let sigAltStackClaimed: [32]i64

// Per-slot scratch for the `stack_t` `sigaltstack` argument, three words per
// worker (24 bytes) — NOT the shared `sigActBuf`/`ioConstBuf` module
// scratch those single-writer buffers document, because MULTIPLE worker OS
// threads call `installAltStackForThisWorker` concurrently at startup, and a
// shared buffer would race. Each worker writes only its own
// `[claimedIndex*3, claimedIndex*3+3)` slice, which no other worker's claimed
// index can ever overlap.
let sigAltStackScratch: [96]i64

// The `class sigaction` buffer `installFatalSignalHandlers` builds for
// SIGSEGV/SIGBUS — separate from `sigActBuf` even though both are 2 words,
// for clarity. Same boot-order safety as `sigActBuf` above (#3279, ABI.md
// §22), not the single-worker contract this used to cite: `boot`'s step 1b
// calls `installFatalSignalHandlers` exactly once, and it is the ONLY caller
// anywhere in the tree — no test or other path re-invokes it.
let segvActBuf: [2]i64

// The SAME shape, for SIGTRAP/SIGILL (#2946) — a separate buffer because it
// carries a DIFFERENT handler entry (`entryOf(trapHandler)` vs
// `entryOf(segvHandler)`), written once from the same call in
// `installFatalSignalHandlers`.
let trapActBuf: [2]i64

// Claim a slot from the pool above and install THIS OS thread's slice of
// `sigAltStackBase` as its alternate signal stack. A no-op if `boot` never
// mapped one (`sigAltStackBase == 0` — a setup failure `boot` already treats
// as fatal, so this is defensive, not an expected path) or if the pool is
// exhausted (cannot happen: `boot` never starts more than `bootMaxWorkers`
// workers, ../boot.bit). Call once, from the very top of `workerBody`, before
// any task can run on this thread.
@nosplit fn installAltStackForThisWorker() {
  if (sigAltStackBase == 0) {
    return
  }
  let tbl: *i64 = ptrOf(sigAltStackClaimed)
  let scratch = int(ptrOf(sigAltStackScratch))
  let i = 0
  while (i < bootMaxWorkers) {
    if (atomicCmpxchg(tbl + i, 0, 1)) {
      let sp = scratch + i * 24
      storeWord(sp, sigAltStackBase + i * sigAltStackBytes)
      storeWord(sp + 8, sigAltStackBytes)
      storeWord(sp + 16, 0)
      let nilp: *u8 = nil
      let _ = sigaltstack(nilp + sp, nilp)
      return
    }
    i = i + 1
  }
}

// The alternate-stack SIGSEGV/SIGBUS handler — ABI `void (*)(int, siginfo_t
// *, void *)`, matched by this function's own three-argument signature, which
// is what SA_SIGINFO selects over the plain `void (*)(int)` `ignoreSigpipe`
// installs.
//
// WHAT THIS CAN DO, AND WHY IT IS @nosplit. It runs on the alternate stack
// `installAltStackForThisWorker` armed for this OS thread, at an arbitrary
// point in whatever Bit code that thread was running when the fault
// happened — which, for the fault this exists to catch, is a green thread
// whose OWN stack has just run out. `@nosplit` is the same discipline every
// panic path in ./io.bit already carries ("the one path that must work when
// allocation is what failed cannot allocate"), for a stronger reason here:
// this was not scheduled, it was DELIVERED, mid-instruction, by the kernel,
// so there is no way to check what state the collector or the interrupted
// task's own invariants are in.
//
// THE ATTRIBUTION, AND WHY IT CAN MISS IN ONE DIRECTION ONLY. Every stack
// this runtime hands out — a green task's granule-sized stack and main's
// oversized one alike — is mapped by `mapGuardedStack`, which always aligns
// the base to `schedStackBytes` (#1843, ../../sched/sched.bit). So a fault
// immediately below a `schedStackBytes`-ALIGNED address, at BOTH the
// faulting address (`si_addr`) and the saved stack pointer at the instant of
// the fault, is structurally consistent with "this thread's stack ran out
// downward" — and nothing else this runtime does deliberately produces that
// shape. It is not a proof: `../../sched/sched.bit`'s own doc on
// `schedStackBytes` already states there is no registry of live green-thread
// stack bases to check a candidate against (masked identity is the whole
// point, #1843) — unlike `main`'s stack, which IS registered
// (`mainStackBaseAddr`, ./boot.bit) and so gets an exact, not heuristic,
// match. A coincidental 256 KiB-aligned fault in unrelated memory, with `sp`
// also (coincidentally) sitting just below the same boundary, is the
// false-positive this cannot rule out — and #2433 records the matching gap
// on the OTHER side: the guard hole below that boundary is not a fixed width
// either, so an overflow does not always reach it before running into
// something else. Both are the cost of masked-identity stacks with no
// registry, a design decision already made and documented elsewhere; fixing
// either is not this ticket's.
//
// WHEN IT CANNOT ATTRIBUTE THE FAULT, IT DOES NOT GUESS. `emitFatalSignal`
// names the raw signal and exits — it does not claim "stack overflow" for a
// fault it cannot place on a stack boundary, because a fabricated diagnosis
// is worse than a plain one. What it deliberately does NOT do is reset the
// disposition to SIG_DFL and let the fault recur so the OS's own crash
// reporter sees it: that pass-through needs this handler to RETURN through
// the interrupted context, which needs machinery this file does not build.
// Every path below calls `rootExit` directly and never returns. The cost,
// stated rather than hidden: an unattributed SIGSEGV/SIGBUS now gets one
// stderr line and a clean exit instead of the OS's own `.ips` crash report —
// a real trade, made deliberately, in exchange for every fault getting SOME
// message instead of most getting none.
@nosplit fn segvHandler(sig: i32, info: *u8, ctx: *u8) {
  let faultAddr = loadWord(int(info) + siAddrOffset)
  let mcontextPtr = loadWord(int(ctx) + ucMcontextOffset)
  let sp = loadWord(mcontextPtr + mcontextSpOffset)

  let fromFault = alignUpStack(faultAddr)
  let fromSp = alignUpStack(sp)
  if (fromFault == fromSp && fromFault > stackAddrFloor) {
    if (fromFault == mainStackBaseAddr) {
      emitMainStackOverflow()
    } else {
      emitSpawnedStackOverflow()
    }
    return
  }
  emitFatalSignal(int(sig))
}

// ---------------------------------------------------------------------------
// #2946: the OTHER undiagnosed shape — SIGTRAP (arm64)/SIGILL (x64) from
// #2432's inline traps, not SIGSEGV/SIGBUS
// ---------------------------------------------------------------------------
//
// `runtime/sched/task.bit`'s `schedYield`/`schedPark`/`schedTaskExit` and
// `runtime/sched/timer.bit`'s `schedSleepUntil` each trap (inline `brk #0` on
// arm64) when `schedCurrentTask()` returns 0 — which happens when a green
// thread's stack overflow silently corrupts the self-pointer/tag words
// `schedCurrentTask` reads at its own stack's BASE, landing exactly ON them
// rather than crossing into the guard hole below (task.bit's own "A task
// that reaches here" comment). Measured on merged main: #2246's own repro
// hits this shape roughly 1 run in 5-20, as exit 133 (SIGTRAP) with ZERO
// output — `segvHandler` above is never invoked for it, because nothing
// faults; the trap is executed deliberately, on purpose, once
// `schedCurrentTask` has already given up.
//
// THE TRADE-OFF THIS TICKET REQUIRES STATING EXPLICITLY, NOT SILENTLY
// ACCEPTING. SIGTRAP is the signal both lldb and gdb use to stop a process at
// a breakpoint or after a single step. Installing ANY process-wide SIGTRAP
// disposition risks intercepting a debugger's own trap ahead of the
// debugger seeing it, on whichever debugging path delivers breakpoints as an
// ordinary Unix signal rather than intercepting them upstream. (On macOS,
// `lldb` normally attaches via a Mach exception port, which gets first
// refusal ahead of this `sigaction` disposition — EXC_BREAKPOINT is an
// exception before it is ever converted to a Unix SIGTRAP — so an ordinary
// interactive `lldb` session is not expected to lose its own breakpoints to
// this handler. That is a property of the OS's exception delivery order,
// though, not a guarantee this file can make for every debugging
// configuration, e.g. a ptrace-style attach that does rely on the delivered
// signal.) This runtime accepts that cost deliberately: the alternative is
// every SIGTRAP-shaped overflow staying exit 133 with zero output for every
// user who is NOT running under a debugger, which is the overwhelmingly
// common case and the one #2246/#2432 exist to fix. SIGILL carries no such
// conflict — nothing on this platform raises it deliberately except x64's
// `ud2` twin of the same four sites (unreachable from arm64-macos code, but
// installed anyway for a genuinely corrupted/illegal jump elsewhere, which
// is worth diagnosing too) — so it is always safe to intercept.
//
// THE ATTRIBUTION NEEDS A DIFFERENT CHECK THAN `segvHandler`'s, because
// `brk #0`/`ud2` do not fault on memory: there is no `si_addr` here that
// means anything, only the saved `sp`. See `classifyOverflowTrap` for the
// replacement, and the retired first attempt below it: `sp`'s DISTANCE from
// the floor is not the discriminator it looks like, because by the time one
// of these four sites runs, the corrupting call chain has usually already
// UNWOUND — `schedTaskExit` fires once `down()` has returned all the way
// back to `worker()`, with `sp` back near the TOP of the (still
// single-granule, `schedStackBytes`-sized) spawned stack, not near the
// bottom where the corruption happened. A "how close to the floor" gate
// rejected roughly a quarter of #2432's own repro runs in testing here
// (30-run distribution, 8/30 fell through to the honest-but-imprecise
// `emitFatalSignal` fallback instead of `emitSpawnedStackOverflow`) for
// exactly that reason, before being removed.
//
// WHAT ACTUALLY DISCRIMINATES: the corruption is a property of the MEMORY at
// the stack's floor, not of `sp`'s instantaneous offset within the granule.
// `schedTaskOnStack` (`../../sched`, already `@symbol`-pinned as
// `bit_rt_port_sched_task_on_stack` — no new cross-module surface, this
// calls the SAME check `schedCurrentTask` itself just made and failed) reads
// the tag AT the floor, and a spawned task's whole stack fits inside ONE
// `schedStackBytes` granule, so `alignDownStack(sp)` lands on that SAME
// floor regardless of where in the granule `sp` currently sits. If the tag
// is gone there, `schedCurrentTask` could not have succeeded from ANYWHERE
// on this stack — including wherever `sp` is now — which is exactly why one
// of the four sites trapped. If the tag is still intact, `schedCurrentTask`
// would have succeeded and none of the four sites could have trapped at
// all, so an intact tag here proves this SIGTRAP/SIGILL did not come from
// one of them (the debugger-breakpoint case this file's header discusses)
// and must not be reported as an overflow.
//
// `main`'s case needs neither the floor read nor the tag: `mainStackBaseAddr`
// is REGISTERED (../boot.bit step 5), not guessed, so an exact match against
// it is already as strong as `segvHandler`'s own main-stack check.
const overflowNone: int = 0
const overflowMain: int = 1
const overflowSpawned: int = 2

@nosplit fn classifyOverflowTrap(sp: int): int {
  let floorBase = alignDownStack(sp)
  if (floorBase <= stackAddrFloor) {
    return overflowNone
  }
  if (floorBase == mainStackBaseAddr) {
    return overflowMain
  }
  if (schedTaskOnStack(floorBase) != 0) {
    return overflowNone
  }
  return overflowSpawned
}

// The alternate-stack SIGTRAP/SIGILL handler — same ABI shape as
// `segvHandler` (SA_SIGINFO selects this three-argument form), same
// `@nosplit` discipline for the same reason (this may run with the
// collector or the interrupted task's own invariants in an unknown state).
// See the section header above for the full attribution and debugger-
// interference reasoning.
@nosplit fn trapHandler(sig: i32, info: *u8, ctx: *u8) {
  let mcontextPtr = loadWord(int(ctx) + ucMcontextOffset)
  let sp = loadWord(mcontextPtr + mcontextSpOffset)
  let verdict = classifyOverflowTrap(sp)
  if (verdict == overflowMain) {
    emitMainStackOverflow()
    return
  }
  if (verdict == overflowSpawned) {
    emitSpawnedStackOverflow()
    return
  }
  emitFatalSignal(int(sig))
}

// "bit: stack overflow\n" — packed constants, computed not hand-derived, the
// same technique every alloc-free panic message in ./io.bit uses.
@nosplit fn emitMainStackOverflow() {
  writeConst(stderrFd, 7022364301234301282, 8) // "bit: sta"
  writeConst(stderrFd, 7382074298558606179, 8) // "ck overf"
  writeConst(stderrFd, 175599468, 4)           // "low\n"
  rootExit(2)
}

// "bit: stack overflow in a spawned task\n"
@nosplit fn emitSpawnedStackOverflow() {
  writeConst(stderrFd, 7022364301234301282, 8) // "bit: sta"
  writeConst(stderrFd, 7382074298558606179, 8) // "ck overf"
  writeConst(stderrFd, 6998715218729070444, 8) // "low in a"
  writeConst(stderrFd, 7234309835455492896, 8) // " spawned"
  writeConst(stderrFd, 11456613544992, 6)      // " task\n"
  rootExit(2)
}

// "bit: fatal signal: segmentation fault\n" / "bit: fatal signal: bus error\n"
// / "bit: fatal signal: trace trap\n" / "bit: fatal signal: illegal
// instruction\n" — the honest fallback when the signal cannot be placed on a
// stack boundary. The last two are #2946's: a SIGTRAP/SIGILL that
// `classifyOverflowTrap` could not attribute to one of #2432's four sites.
@nosplit fn emitFatalSignal(sig: int) {
  writeConst(stderrFd, 8386096269746268514, 8) // "bit: fat"
  writeConst(stderrFd, 7020662571717913697, 8) // "al signa"
  if (sig == sigSegv) {
    writeConst(stderrFd, 7308611455713032812, 8) // "l: segme"
    writeConst(stderrFd, 2336927755366659182, 8) // "ntation "
    writeConst(stderrFd, 11495152116070, 6)      // "fault\n"
  } else if (sig == sigTrap) {
    writeConst(stderrFd, 7305790164727511660, 8) // "l: trace"
    writeConst(stderrFd, 11477787505696, 6)      // " trap\n"
  } else if (sig == sigIll) {
    writeConst(stderrFd, 7450480371430341228, 8) // "l: illeg"
    writeConst(stderrFd, 8247343735669550177, 8) // "al instr"
    writeConst(stderrFd, 2936174556767093, 7)    // "uction\n"
  } else {
    writeConst(stderrFd, 7286951145080109676, 8) // "l: bus e"
    writeConst(stderrFd, 44869579378, 5)         // "rror\n"
  }
  rootExit(2)
}

// Register `segvHandler` for SIGSEGV/SIGBUS and `trapHandler` for
// SIGTRAP/SIGILL (#2946), process-wide, SA_SIGINFO | SA_ONSTACK. Same 2-word
// `class sigaction` shape `ignoreSigpipe` builds (`sigActionWords`), in two
// separate buffers (`segvActBuf`/`trapActBuf`, one per handler entry)
// written once, from `boot`, before any worker thread exists — call this
// before step 6 starts any worker, so both dispositions are live before the
// first task can run.
@nosplit fn installFatalSignalHandlers() {
  let base = int(ptrOf(segvActBuf))
  storeWord(base, int(entryOf(segvHandler)))
  // mask (low 32 bits) = 0, flags (high 32 bits) = SA_SIGINFO | SA_ONSTACK —
  // the same word layout `ignoreSigpipe`'s header documents for this SDK.
  storeWord(base + 8, (saSiginfo | saOnstack) << 32)
  let nilp: *u8 = nil
  let _ = sigaction(i32(sigSegv), nilp + base, nilp)
  let _ = sigaction(i32(sigBus), nilp + base, nilp)

  let trapBase = int(ptrOf(trapActBuf))
  storeWord(trapBase, int(entryOf(trapHandler)))
  storeWord(trapBase + 8, (saSiginfo | saOnstack) << 32)
  let _ = sigaction(i32(sigTrap), nilp + trapBase, nilp)
  let _ = sigaction(i32(sigIll), nilp + trapBase, nilp)
}

// ---------------------------------------------------------------------------
// #3507: SIGTERM/SIGINT must not orphan a `bit test`/bounded `bit run`
// child. `osForkExecWaitBounded` (./os.bit, this module) only kills and
// reaps its child from inside its OWN poll loop — code that runs in THIS
// process. SIGTERM's/SIGINT's default disposition terminates the process
// immediately with no user code running at all, so that poll loop, and the
// `osKillGroup` call inside it, never runs. SIGKILL is explicitly out of
// scope: no userspace handler can ever intercept it, on any OS.
//
// #4172 widens this to PLAIN `bit run` too: its own child (`osForkExecWait`,
// unbounded) was never tracked here at all, so a `bit run` process that
// receives SIGTERM/SIGINT directly — not via an outer `osRunBounded` wrapper,
// which already reaches it through #2986's process-group kill — reaped
// nothing. `osKillAllUnboundedChildren` closes that; see `osUnboundedChildPid`
// (./os.bit) for why it kills by PID rather than by group.
// ---------------------------------------------------------------------------

// SIGINT = 2, SIGTERM = 15 (`<sys/signal.h>`) — the same numbers as Linux
// (../linux/signal.bit): both predate the BSD/SysV split that gave SIGBUS
// its two numbers, like SIGILL/SIGTRAP above.
const sigInt: int = 2
const sigTerm: int = 15

// The `class sigaction` buffer for SIGTERM/SIGINT — same 2-word shape as
// `segvActBuf`/`trapActBuf` above, a separate buffer because it carries a
// DIFFERENT handler entry. Written once, from `boot`, alongside
// `installFatalSignalHandlers`.
let termActBuf: [2]i64

// The SIGTERM/SIGINT handler: reap nothing itself (that would need to run
// arbitrary Bit code with the interrupted process's own invariants in an
// unknown state, the same reasoning `segvHandler`'s header gives) — just kill
// every outstanding bounded child's whole process group
// (`osKillAllOutstandingChildren`, ./os.bit), every outstanding unbounded
// child by PID (`osKillAllUnboundedChildren`, #4172), and exit. `128 + sig` matches
// the shell convention for a signal-terminated process (143 for SIGTERM, 130
// for SIGINT) without needing to reset the disposition and re-raise, which
// would require returning through the interrupted context — machinery this
// file does not build, the same trade `segvHandler`/`trapHandler` already
// make.
@nosplit fn termHandler(sig: i32, info: *u8, ctx: *u8) {
  osKillAllOutstandingChildren()
  osKillAllUnboundedChildren()
  rootExit(128 + int(sig))
}

// Register `termHandler` for SIGTERM and SIGINT, process-wide, SA_SIGINFO —
// no SA_ONSTACK: unlike a stack overflow, nothing about receiving SIGTERM
// implies this thread's own stack is in trouble, so running on it is fine
// and avoids depending on `installAltStackForThisWorker` having already run
// on whichever thread the kernel happens to deliver the signal to. Call from
// `boot` alongside `installFatalSignalHandlers`, before any worker exists.
@nosplit fn installTerminationHandlers() {
  let base = int(ptrOf(termActBuf))
  storeWord(base, int(entryOf(termHandler)))
  storeWord(base + 8, saSiginfo << 32)
  let nilp: *u8 = nil
  let _ = sigaction(i32(sigTerm), nilp + base, nilp)
  let _ = sigaction(i32(sigInt), nilp + base, nilp)
}
