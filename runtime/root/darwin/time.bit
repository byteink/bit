// Darwin time provider for the SEAM 3 remainder (#1604): the three `bit_rt_time_*`
// ABI symbols (ABI.md §18). This is the Bit form of `runtime/root/`'s time
// block plus the Darwin branch of `runtime/sched/`'s `realtimeNs`.
//
// KEPT DELIBERATELY IN THE SAME FUNCTION-FOR-FUNCTION SHAPE AS ../linux/time.bit,
// so a divergence between the two is a real platform difference rather than a
// stylistic one. The disposition of the three is identical (see ../linux/time.bit
// for the reasoning): `mono_ns` PINS `parkMonoNs`, `unix_ns` is a real port, and
// `sleep_ns` marshals to `runtime/sched`'s `schedSleepUntil`.
//
// The one platform difference is the mechanism of `unix_ns`: this side goes
// through libSystem's `clock_gettime` (§11.7) rather than a raw trap, because
// Apple publishes no stable syscall numbers (../darwin/io.bit). `runtime/sched/`'s
// `realtimeNs` makes the same split — `std.c.clock_gettime(.REALTIME, &ts)` on
// Darwin against the raw `std.os.linux.clock_gettime` on Linux — so this mirrors
// the seed exactly. `mono_ns` still PINS `parkMonoNs`, which on Darwin is
// mach_absolute_time scaled by the timebase, not a clock_gettime.
//
// THE Darwin CLOCK_REALTIME id (0) AND THE `timespec` LAYOUT WERE READ OUT OF THE
// THE macOS SDK HEADERS (`<time.h>`'s `clockid_t`, `struct timespec` {sec, nsec}
// as two 64-bit words), NOT FROM MEMORY. A wrong clock id is a silent wrong-time,
// never a compile error — the failure the mutation test forces and observes.
//
// See ../fs.bit's header for why each provider is self-contained rather than the
// netabi extern shape. The two cross-module reaches (`parkMonoNs` for the clock,
// `schedSleepUntil`/`schedYield` for the park) are ordinary `import`s.

import { parkMonoNs } from "../../park/darwin"
import { schedSleepUntil, schedYield } from "../../sched"
import { schedCurrentWorker } from "../../sched"

// clock_gettime(2) from libSystem: `int clock_gettime(clockid_t, struct timespec *)`.
// clockid_t is a 32-bit enum, so it crosses as `i32`; the `timespec` is two 64-bit
// words on 64-bit Darwin (§11.7 — only C-representable types cross the boundary),
// so it travels as `*i64` for the reason ../darwin/io.bit takes `mach_timebase_
// info` as `*i64`: a Bit slice stores one 8-BYTE word per element (§11.8), and a
// `[]i64(2)` is exactly the 16-byte {tv_sec, tv_nsec} the call fills.
extern function clock_gettime(clk: i32, ts: *i64): i32

// CLOCK_REALTIME = 0 (Darwin `<time.h>` clockid_t; MONOTONIC there is 6, not
// Linux's 1 — but the monotonic clock is `parkMonoNs`'s job via mach time, not
// opened here).
const clockRealtime: int = 0

// Nanoseconds per second — named for the same reason ../linux/time.bit names it.
const nsPerSec: int = 1000000000

// `bit_rt_time_mono_ns` (ABI.md §18): monotonic nanoseconds; never jumps. A PIN
// over `parkMonoNs` (mach_absolute_time scaled by the timebase), reused rather
// than duplicated. `runtime/root/`'s body is `sched.monoNs()`, `parkMonoNs`'s twin.
export @symbol("bit_rt_time_mono_ns") function rtTimeMonoNs(): int {
  return parkMonoNs()
}

// A dedicated `[2]i64` fallback for `rtTimeUnixNs`, used only when the caller
// is not running on a task (`schedCurrentWorker() == 0`) and so has no
// per-worker `wkSleepReq` scratch to reach — a case ABI.md §18's entry points
// are not expected to hit (only compiled user code, always running as a task,
// calls them), kept only so the fallback path is total. Sharing it across that
// rare path is safe for the same reason ./wait.bit's `tbScratch` is: nothing
// races it in the ordinary case.
let timeFallbackScratch: [2]i64

// The 2-word scratch `clock_gettime` writes its `timespec` into (#2318) — the
// caller-owned-block pattern `parkSleepNs` already uses: the current task's
// own worker's `wkSleepReq`, or the shared fallback when there is no current
// task.
@nosplit function timeScratch(): *i64 {
  let w = schedCurrentWorker()
  if (w == 0) {
    return ptrOf(timeFallbackScratch)
  }
  return taskAt(w) + wkSleepReq
}

// `bit_rt_time_unix_ns` (ABI.md §18): wall-clock nanoseconds since the Unix epoch.
// Can jump (NTP, clock set), so it dates events and never measures durations.
// clock_gettime(CLOCK_REALTIME) into a `timespec` {sec, nsec}, then sec*1e9+nsec.
// `ts` used to be a fresh `[]i64(2)` heap slice on every call (#2318), identical
// to the defect that ticket names in `parkMonoNs`/`parkSleepNs`.
//
// Returns 0 if the call fails, matching `parkMonoNs`'s failure report rather than
// reading back an uninitialised buffer (`realtimeNs` ignores the return code; 0 is
// the one strictly-safer deviation both providers share).
export @symbol("bit_rt_time_unix_ns") function rtTimeUnixNs(): int {
  let ts = timeScratch()
  *(ts + 0) = 0
  *(ts + 1) = 0
  let rc = int(clock_gettime(i32(clockRealtime), ts))
  if (rc != 0) {
    return 0
  }
  return int(*(ts + 0)) * nsPerSec + int(*(ts + 1))
}

// `bit_rt_time_sleep_ns` (ABI.md §18): park the calling green thread for at least
// `ns`, leaving its worker free. A non-positive duration yields; a positive one
// parks on the scheduler's timer queue until `parkMonoNs() + ns` — the absolute
// deadline on the monotonic clock a worker's idle path drives `schedTimerExpire`
// with. See ../linux/time.bit for why this is `schedSleepUntil`, not `parkSleepNs`
// (which would block the OS thread and freeze the worker's other tasks).
export @symbol("bit_rt_time_sleep_ns") function rtTimeSleepNs(ns: int) {
  if (ns <= 0) {
    schedYield()
    return
  }
  schedSleepUntil(parkMonoNs() + ns)
}
