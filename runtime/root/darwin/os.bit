// Darwin process provider for the SEAM 3 remainder (#1605): the kernel-facing
// `bit_rt_os_*` ABI wrappers (ABI.md §19) that need real system calls —
// `os_self_exe`, `os_run`, `os_run_test` — reached through libSystem (§11.7)
// rather than raw traps, because Apple publishes no stable syscall numbers
// (../darwin/io.bit). This is the Bit form of `runtime/root/`'s
// `bit_rt_os_run`/`bit_rt_os_run_test`/`bit_rt_os_self_exe` and
// `runtime/sched/`'s Darwin `selfExePath`. `os_argc`/`os_arg_at`/`os_env` are
// platform-free (../os.bit); `os_exit` already lives in ./io.bit as
// `bit_rt_os_exit`.
//
// KEPT DELIBERATELY IN THE SAME FUNCTION-FOR-FUNCTION SHAPE AS ../linux/os.bit, so
// a divergence is a real platform difference, not a stylistic one. The two real
// differences: (1) self_exe uses `_NSGetExecutablePath` + `realpath` (the reported
// path is symlink-and-all, so it must be resolved), where Linux's `/proc/self/exe`
// is pre-resolved; (2) fork/exec/wait go through libSystem `extern`s.
//
// #1436 HAZARD (same as ../darwin/fs.bit's `close`): under the SELF-HOSTED
// compiler a libSystem cancellation-point import can be dropped for its
// `$NOCANCEL` variant. `fork`/`execve`/`waitpid` are the exposure here. This body
// is not executed until the archive swap (#1369) — the freestanding-emit and
// rootpins proofs never run it — so it is recorded, not fixable inside this port,
// exactly as fs.bit records its `close`.

import { storeWord, gcSyscallBegin, gcSyscallEnd } from "../../gc"
// osFillTestIndex/osScratchSlot pulled up to core (#2551,
// docs/development/provider-duplication.md's `root` -> `os.bit` section): no
// OS call in any of their bodies. `strData` is NOT imported here: ./fs.bit's
// own "../../root" import already brings it into this module's scope
// (module-scoped, so a second import is E0042). `fsPathZ` IS imported here
// (was ./fs.bit's, moved: `checkedPathZ`, ./fs.bit's own caller, moved to
// core too and no longer needs it locally, leaving this file the only
// remaining consumer in the module). `osWriteDecimal` is NOT imported here:
// its only caller in this file, `osFillTestIndex`, moved to core too; this
// module's remaining caller is ./boot.bit, which imports it directly.
import { osEnvp, osBuildRunArgv, osFillTestIndex, osFillBacktraceEnv, osScratchSlot, osScratchSlots, fsPathZ, btEnvKeyMatch } from "../../root"

// `u8At`, `cstrLen`, `strData`, `emptyStr`, `fsPathZ`, `rtStrAlloc`,
// `rtStringSlice`, `loadByte`, `storeByte`, `loadWord`, `rootExit` are already
// imported/defined by this module's siblings ./io.bit and ./fs.bit (module-scoped
// in Bit), so they are reused, not re-declared — a redeclaration is E0042.

// libSystem process calls. Only C-representable types cross the boundary (§11.7):
// pointers travel as `*u8`, counts/codes as `i32`/`i64`.
//
// `_NSGetExecutablePath(buf, *bufsize)` writes the exec path and returns 0 on
// success. `realpath(path, resolved)` canonicalises it (resolving symlinks) into
// `resolved` and returns `resolved`, or NULL on error.
extern fn fork(): i32
extern fn execve(path: *u8, argv: *u8, envp: *u8): i32
extern fn waitpid(pid: i32, status: *u8, options: i32): i32
extern fn setpgid(pid: i32, pgid: i32): i32
extern fn _NSGetExecutablePath(buf: *u8, size: *u8): i32
extern fn realpath(path: *u8, resolved: *u8): *u8

// `max_path`/`PATH_MAX` (runtime/root/ / runtime/sched/): the ceiling for the exec path and
// its resolution. `realpath` writes up to PATH_MAX; a smaller buffer would be an
// overrun, so both scratch buffers are sized to it.
const osMaxPath: int = 4096

// wait(2)'s status decode (std.c's Darwin `W`, the BSD layout — identical to
// Linux for these two): WIFEXITED = (status & 0o177) == 0; WEXITSTATUS =
// (status >> 8) & 0xff.
const osWStatusMask: int = 127
const osWExitShift: int = 256


// ---------------------------------------------------------------------------
// os_self_exe
// ---------------------------------------------------------------------------

// `_NSGetExecutablePath` result, `realpath` result, and the 4-byte size cell it
// is handed. PER-WORKER (#3277). Unlike `runtime/rand/linux/entropy.bit`'s
// `randPathBuf`-style exception, this is NOT treated as content-invariant even
// though the path it holds is process-constant: it is filled by opaque
// libSystem calls
// (`_NSGetExecutablePath`, `realpath`), not hardcoded byte stores, so nothing
// here guarantees their internal write sequence (e.g. a defensive clear before
// the copy) is itself free of an observable intermediate state -- unlike
// ../linux/os.bit's `osProcSelfExe`, whose 15 bytes come from 15 literal
// `storeByte` calls and nothing else. `rtOsSelfExe` resolves the slot ONCE
// (`osScratchSlot`) and reuses it for every read/write below -- nothing it
// calls parks (`_NSGetExecutablePath`/`realpath` are plain libSystem calls;
// `osPathToStr`'s `rtStrAlloc` traces through `gcAllocRaw`/`gcHeapAlloc`,
// which spin-locks the heap but never calls `schedPark`/`schedSwitch`), so the
// task never migrates workers mid-call. 512 words = 4096 bytes = `max_path`,
// times (osScratchSlots + 1) slots: one per worker plus the fallback for a
// caller with no current task. Scalars, never scanned (rule 1).
let osRawExe: [16896]i64        // (osScratchSlots+1) * 512
let osResolvedExe: [16896]i64   // (osScratchSlots+1) * 512
let osSizeCell: [33]i64         // (osScratchSlots+1) * 1

// The NUL-terminated C string at `addr` as a fresh Bit `string`, capped at
// `osMaxPath` (Power of 10 rule 2). ../fs.bit's `cstrLen` caps at 256 (NAME_MAX),
// too small for a resolved path, so this scan is local.
@nosplit fn osPathToStr(addr: int): int {
  let n = 0
  while (n < osMaxPath) {
    if (loadByte(addr + n) == 0) {
      break
    }
    n = n + 1
  }
  let s = rtStrAlloc(n)
  if (s == 0) {
    return emptyStr()
  }
  let dst = strData(s)
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(addr + i))
    i = i + 1
  }
  return s
}

// `bit_rt_os_self_exe`: the running executable's own path with symlinks resolved,
// or the empty string when unknown. `_NSGetExecutablePath` reports the exec path
// symlink-and-all, so it is run through `realpath` — `runtime/sched/`'s Darwin branch.
export @nosplit @symbol("bit_rt_os_self_exe") fn rtOsSelfExe(): int {
  let slot = osScratchSlot()
  let raw = int(ptrOf(osRawExe)) + slot * 4096
  let sizePtr = int(ptrOf(osSizeCell)) + slot * 8
  storeWord(sizePtr, osMaxPath)
  if (int(_NSGetExecutablePath(u8At(raw), u8At(sizePtr))) != 0) {
    return emptyStr()
  }
  let resolved = int(ptrOf(osResolvedExe)) + slot * 4096
  let rp = realpath(u8At(raw), u8At(resolved))
  if (int(rp) == 0) {
    return emptyStr()
  }
  return osPathToStr(resolved)
}

// ---------------------------------------------------------------------------
// os_run / os_run_test — fork + execve + waitpid
// ---------------------------------------------------------------------------

// child `argv` = [path, NULL] and the wait(2) status cell. PER-WORKER (#3277):
// nothing serialises `bit_rt_os_run`/`_test`/`_bounded` -- two workers can call
// the predeclared `osRun` builtin (or `bit_rt_os_run_bounded`) at the same real
// time, and "a run completes before another can begin" was asserted, never
// enforced -- grep found no lock anywhere near these call sites. Each caller
// resolves the slot ONCE (`osScratchSlot`) and reuses it through
// fork/exec/wait: neither `osForkExecWait` nor `osForkExecWaitBounded` calls
// `schedPark`/`schedSwitch` anywhere in their callee chain (`fork`/`execve`/
// `waitpid` are libSystem externs; the `gcSyscallBegin`/`gcSyscallEnd` bracket
// around `waitpid`/`nanosleep` only publishes this thread's registers for a
// conservative scan -- traced into `worldBeginSyscall`/`worldEndSyscall`,
// neither of which parks either), so the task never migrates workers
// mid-call. Scalars, never scanned (rule 1).
let osArgvBuf: [66]i64      // (osScratchSlots+1) * 2
let osStatusBuf: [33]i64    // (osScratchSlots+1) * 1

// child env for `os_run_test`: "BIT_TEST_INDEX=<idx>" prepended to the inherited
// entries. `max_env` (runtime/root/) = 1024 inherited + the var + the NULL = 1026
// words, plus ONE more reserved (1027 total) for `rtOsRunTestBounded`'s
// conditional `BIT_BACKTRACE=1` injection (#3826) — never added by
// `rtOsRunTest`, but the two functions share this buffer and MUST agree on
// its per-slot stride, so both are sized off the wider figure. `osIdxBuf`
// holds the prepended string. PER-WORKER (#3301): the same race and the same
// no-park proof as `osArgvBuf`/`osStatusBuf` above -- `osFillTestIndex`
// resolves the slot once for `osIdxBuf`, and `rtOsRunTest`/
// `rtOsRunTestBounded` resolve it again immediately after for `osChildEnvp`;
// both land on the same slot because nothing in between parks (`osEnvp()`,
// runtime/root/os.bit, is a bare field read, `osWriteDecimal` is a pure
// loop, and `btEnvKeyMatch`/`osFillBacktraceEnv` are the same shape).
// Scalars, never scanned (rule 1).
const osMaxEnv: int = 1024
let osChildEnvp: [33891]i64  // (osScratchSlots+1) * 1027


// fork + execve the child at `pathPtr` with `argvPtr`/`envpPtr`, wait for it, and
// return its result in `osForkExecWaitBounded`'s encoding minus the `-2` case this
// has no deadline to produce (ABI.md §19): >= 0 exit code, -1 spawn/wait failure,
// <= -100 killed by signal `-(result) - 100`. `runtime/root/`'s Darwin
// `bit_rt_os_run` body. fork + immediate exec is the only work between fork
// and exec; on exec failure the child `_exit`s 127.
//
// BOUNDED (Power of 10 rule 2): the wait is a single call, deliberately with
// NO EINTR retry, unlike ../linux/os.bit's `osForkExecWait` (#1904). THIS IS
// NOT because libSystem's `waitpid` is incapable of surfacing EINTR — it is
// (verified 2026-08-22 on this Darwin kernel: a `SA_RESTART`-less `sigaction`
// whose handler RETURNS makes a blocking `waitpid` return -1/errno 4, exactly
// like the raw Linux syscall; a prior version of this comment claimed
// otherwise and was wrong, #3460).
//
// It is because NOTHING this runtime installs process-wide can ever put a
// RETURNING handler in front of a signal that reaches this wait. `sigaction`
// disposition table, in full (./signal.bit, installed by `boot` before any
// worker exists): SIGPIPE is `SIG_IGN` (`ignoreSigpipe`), which per POSIX
// never interrupts a blocked syscall at all — confirmed empirically, #3460.
// SIGSEGV/SIGBUS/SIGTRAP/SIGILL are caught, without `SA_RESTART`
// (`installFatalSignalHandlers`), but every path through `segvHandler` and
// `trapHandler` ends in `rootExit()`, which never returns (../boot.bit's
// `rootExit` is `bit_rt_port_syscalls_exit_group`-backed and does not come
// back) — so even a genuine fault mid-`waitpid` terminates the process
// instead of resuming it with EINTR to retry. Every other signal is
// `SIG_DFL`: either process-terminating (again no resumption to retry) or,
// for `SIGSTOP`/`SIGCONT` job control, empirically produced NO EINTR on this
// kernel either (#3460's probe). If a FUTURE signal handler is ever added
// here that returns normally instead of exiting, this reasoning must be
// re-examined and a retry loop added to match Linux's.
@nosplit fn osForkExecWait(pathPtr: int, argvPtr: int, envpPtr: int): int {
  let pid = int(fork())
  if (pid < 0) {
    return 0 - 1
  }
  if (pid == 0) {
    let _ = execve(u8At(pathPtr), u8At(argvPtr), u8At(envpPtr))
    rootExit(127)
  }
  let sb = int(ptrOf(osStatusBuf)) + osScratchSlot() * 8
  storeWord(sb, 0)
  // The `syscall` bracket matters MORE here than on the polling path (#1904):
  // this `waitpid` blocks for the child's entire lifetime, so without it every
  // collection attempted for however long the child runs is abandoned. Same
  // reasoning as `osPollSleep` — the caller holds live references (the path,
  // argv and envp arrays) across this, so `blocked` would sweep them, while
  // `syscall` publishes the bound and register file for a scan in place.
  gcSyscallBegin()
  let w = int(waitpid(i32(pid), u8At(sb), i32(0)))
  gcSyscallEnd()
  if (w < 0) {
    return 0 - 1
  }
  let status = loadWord(sb)
  let sig = status & osWStatusMask
  if (sig == 0) {
    return (status / osWExitShift) & 255
  }
  // 0x7f is "stopped", not "terminated" — no death signal to report, so it keeps
  // the -1 sentinel. Same split as `osForkExecWaitBounded` below.
  if (sig == osWStatusMask) {
    return 0 - 1
  }
  return 0 - 100 - sig
}

// `bit_rt_os_run`: run the executable at `path` as a child inheriting this
// process's environment, with `argv` (a `[]string`, or a null header for the
// empty/default slice) appended to its own argv after `path` — `bit run <src>
// [args...]`'s launcher (#2399). Return its exit code, -1 on failure or a
// rejected `argv` (`osBuildRunArgv`'s bounds, documented on
// `runtime/root/os.bit`'s `osRunMaxArgv`), or -(sig) - 100.
//
// SIGNATURE CHANGED IN PLACE, not a new symbol beside it — every caller is
// updated in the same commit: `compiler/build.bit`'s `runCmd`,
// `compiler/pmfetchtail.bit`'s `runGit` (both part of `compiler/`'s own
// self-hosting source), and the three fixtures that call the predeclared
// `osRun(path, argv)` builtin directly (`_tests_/cases/fs_walk_symlink.bit`,
// `_tests_/imports/pmadd_e2e/main.bit`, `examples/staticserver/staticserver.bit`).
// A NEW symbol was tried first and reverted: `compiler/build.bit` is compiled
// by the PINNED stage0 (a published release, `dist/stage0/SHA256SUMS`) during
// `./make selfhost`, and stage0 has no idea a new predeclared name exists —
// every self-hosting build would fail `E0040: undefined name` on the new call
// site until the NEXT stage0 repin, which needs a published release first
// (circular). Reusing the ALREADY-recognized `osRun` identifier sidesteps
// that entirely: this compiler validates no builtin call's arity
// (`compiler/validatecall.bit`'s `vCall`), so stage0 accepts a 2-argument
// call to the same name it has always known, with no changes to its own
// predeclared-name table required.
export @nosplit @symbol("bit_rt_os_run") fn rtOsRun(path: int, argv: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = osBuildRunArgv(p, argv)
  if (ab == 0) {
    return 0 - 1
  }
  return osForkExecWait(p, ab, osEnvp())
}

// `bit_rt_os_run_test(path, idx)`: like `os_run`, but execs the child with
// `BIT_TEST_INDEX=<idx>` PREPENDED to the inherited environment. Prepending makes
// it win over any inherited var (getenv returns the first match). BOUNDED copy
// (rule 3): more than `max_env` vars lose the overflow, never corrupt.
export @nosplit @symbol("bit_rt_os_run_test") fn rtOsRunTest(path: int, idx: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = int(ptrOf(osArgvBuf)) + osScratchSlot() * 16
  storeWord(ab, p)
  storeWord(ab + 8, 0)

  let idxStr = osFillTestIndex(idx)
  let ce = int(ptrOf(osChildEnvp)) + osScratchSlot() * 8216
  storeWord(ce, idxStr)

  // Copy the inherited entries into ce[1..copied]; `copied` survives the loop so
  // the NULL terminator lands after the last entry placed. BOUNDED by `osMaxEnv`.
  let src = osEnvp()
  let copied = 0
  while (copied < osMaxEnv) {
    let e = loadWord(src + copied * 8)
    if (e == 0) {
      break
    }
    storeWord(ce + (copied + 1) * 8, e)
    copied = copied + 1
  }
  storeWord(ce + (copied + 1) * 8, 0)
  return osForkExecWait(p, ab, ce)
}

// ---------------------------------------------------------------------------
// os_run_bounded / os_run_test_bounded — fork + execve + a DEADLINE, not a
// blocking waitpid (#1744)
// ---------------------------------------------------------------------------
//
// See ../linux/os.bit's counterpart for the full argument (`osForkExecWait`'s
// `waitpid` blocks forever on a hung child, which is the hazard this function
// exists to close). Same fork+exec as `osForkExecWait`, but the parent polls
// `waitpid(WNOHANG)` against a monotonic deadline resolved from `timeoutMs`
// once, before the first poll, and SIGKILLs + reaps the child if the deadline
// wins. `os_run`/`os_run_test` are unchanged; this is a new, separate pair.
//
// Must stay `@nosplit` like every other declaration in this file
// (_tests_/bit/pollfree.bit): the raw child pid and timespec scratch below
// must never cross a safepoint — which is why the poll delay is a raw
// `nanosleep` libSystem call rather than `rtTimeSleepNs` (../darwin/time.bit),
// which parks the green thread on the scheduler and is NOT `@nosplit`.

// `nanosleep`/`kill` from libSystem (§11.7); `clock_gettime` is already
// declared by ./time.bit (same module, reused not re-declared — E0042).
extern fn nanosleep(req: *u8, rem: *u8): i32
extern fn kill(pid: i32, sig: i32): i32

// timespec scratch for `osMonoNs`/`osPollSleep` -- PER-WORKER (#3277), the
// same shape and the same no-park proof as `osStatusBuf` above (`osMonoNs` is
// a plain `clock_gettime` libSystem call; `osPollSleep`'s `nanosleep` is
// bracketed by `gcSyscallBegin`/`gcSyscallEnd`, which does not park). Scalars,
// never scanned (rule 1).
let osClockBuf: [66]i64      // (osScratchSlots+1) * 2
let osSleepReqBuf: [66]i64   // (osScratchSlots+1) * 2

// CLOCK_MONOTONIC = 6 on Darwin (`<time.h>` clockid_t — NOT Linux's 1;
// ../darwin/time.bit's header names the same trap). Read directly here rather
// than through `rtTimeMonoNs`: it is not `@nosplit`, and this function must
// stay `@nosplit`. (`parkMonoNs`, `runtime/park/darwin/wait.bit`, is
// `@nosplit` itself today and writes into its own `tbScratch` — this
// paragraph used to cite it as a second non-`@nosplit` reason; it no longer
// is one.)
const osClockMonotonic: int = 6
const osNsPerSec: int = 1000000000

@nosplit fn osMonoNs(): int {
  let tsPtr = ptrOf(osClockBuf) + osScratchSlot() * 2
  let rc = int(clock_gettime(i32(osClockMonotonic), tsPtr))
  if (rc != 0) {
    return 0
  }
  let ts = int(tsPtr)
  return loadWord(ts) * osNsPerSec + loadWord(ts + 8)
}

// Poll interval: 2ms. Short enough that a caller's bound is honored within a
// couple percent; long enough not to spin a core between polls.
const osPollNs: int = 2000000

// Bracketed with `bit_rt_gc_syscall_begin`/`_end` (#1904), NOT with
// `blocking_begin`/`_end`. The distinction is the whole ticket: `blocked` claims
// no frame holds a live Bit reference, and the caller `osRunBounded` holds
// several across this — argv, the paths, the captured output buffer. Bracketing
// it as `blocked` was tried and swept them. `syscall` makes no such claim: it
// publishes this thread's stack pointer and callee-saved registers so the
// collector scans the wait in place instead of waiting for a safepoint that
// cannot arrive from `@nosplit` code.
//
// Without it every collection triggered while a subprocess is outstanding spun
// `stwSpinBound` and was abandoned — 21 abandoned per completed collection under
// `./make test`, which is both the CPU burn and, worse, a run during which
// almost nothing was swept.
//
// The bracket is around the SLEEP alone, not the whole poll loop. The
// intervening `waitpid(WNOHANG)` is non-blocking and returns in microseconds, so
// the thread is in the kernel for essentially the entire interval, and the
// rendezvous — which re-scans from the top and needs one clean pass — finds it
// there. Keeping `waitpid` outside also keeps the shared `osStatusBuf` write on
// the `running` side of the state, where the single-worker sharing contract
// documented above still describes it.
@nosplit fn osPollSleep() {
  let req = int(ptrOf(osSleepReqBuf)) + osScratchSlot() * 16
  storeWord(req, 0)
  storeWord(req + 8, osPollNs)
  gcSyscallBegin()
  let _ = nanosleep(u8At(req), u8At(0))
  gcSyscallEnd()
}

const osSigKill: int = 9

// Signals the whole PROCESS GROUP `pid` leads, not just `pid` itself (#2986).
// `osForkExecWaitBounded` puts the bounded child in its own group (`setpgid`,
// both sides, right after fork) with pgid == its own pid, so this is exactly
// that group. A negative first argument to `kill(2)` is POSIX for "every
// process whose pgid is -that value" — the shell-script children `bit
// test`/`bit run` fork under a wrapper script (e.g. runcmd.bit's `shell()`)
// inherit that same group unless they detach themselves, so a grandchild that
// outlives the direct child's own death is reached by this call, closing the
// orphan #2986 observed: `osKill`'s old single-pid form killed the direct
// child (a wrapper `/bin/sh`) while the actual hung compile it had spawned
// kept running, reparented to pid 1.
@nosplit fn osKillGroup(pid: int) {
  let _ = kill(i32(0 - pid), i32(osSigKill))
}

// #3507: the bounded child currently outstanding, one slot per worker
// (`osScratchSlots+1`, the same sizing every other per-worker scratch buffer
// above uses), 0 = none outstanding. Written ONLY by the thread inside
// `osForkExecWaitBounded`'s own call below — the same single-writer-per-slot
// argument `osStatusBuf` above already makes, since a worker never migrates
// mid-call. The one OTHER reader is `osKillAllOutstandingChildren` below,
// called from ../signal.bit's SIGTERM/SIGINT handler, which the kernel may
// deliver to ANY thread in this process, not necessarily the one that owns
// the slot — so it reads every slot, not just its own. A signal landing in
// the few instructions between `fork` returning and the `storeWord` below
// simply means that one child is not yet reachable by this sweep; nothing
// downstream depends on the race being closed, because the handler's own
// `rootExit` ends the process either way.
let osOutstandingChildPid: [33]i64  // (osScratchSlots+1) * 1

// Kill every bounded child still outstanding, across every worker slot
// (#3507). `@nosplit`: called from a signal handler, so it must not allocate
// or touch anything the interrupted code's own invariants might be mid-way
// through.
@nosplit fn osKillAllOutstandingChildren() {
  let base = int(ptrOf(osOutstandingChildPid))
  let i = 0
  while (i <= osScratchSlots) {
    let pid = loadWord(base + i * 8)
    if (pid != 0) {
      osKillGroup(pid)
    }
    i = i + 1
  }
}

// Publish `pid` as this worker's outstanding bounded child (#3507) and
// return the slot address, so `osForkExecWaitBounded` below can clear it
// later with a single `storeWord` rather than recomputing the slot. Split
// out purely to keep that function's own body under the house line limit
// (E0201) — see `osOutstandingChildPid`'s comment for the safety argument.
@nosplit fn osMarkChildOutstanding(pid: int): int {
  let addr = int(ptrOf(osOutstandingChildPid)) + osScratchSlot() * 8
  storeWord(addr, pid)
  return addr
}

// Ceiling on `timeoutMs`: 100 minutes. This is the `os_run_bounded_max_ms` clamp
// ABI.md §19 specifies, and every harness clamps to match — a caller typo must
// not reinstate an unbounded wait.
const osBoundedMaxMs: int = 6000000

// Worst-case poll count: the clamp ceiling divided by the poll interval, plus
// slack (Power of 10 rule 2, no `while (true)`); the monotonic-deadline check
// inside the loop is what actually ends every real call.
const osBoundedMaxPolls: int = (osBoundedMaxMs * 1000000) / osPollNs + 16

// WNOHANG (std.c's Darwin `W.NOHANG`): return immediately instead of blocking
// when the child has not yet changed state.
const osWnohang: int = 1

// fork + execve, then poll instead of block (`osForkExecWait`'s body). Result
// encoding (ABI.md §19, matching `runtime/root/`'s `osRunBoundedImpl`):
//   >= 0     child exited normally with this code (0-255)
//   -1       spawn/wait failure — same sentinel as `osForkExecWait`
//   -2       timed out: the deadline elapsed, so the child was SIGKILLed
//   <= -100  child was killed by a signal seen during a poll;
//            signal number = -(result) - 100
//
// The `w < 0` branch below has NO EINTR retry either, deliberately, unlike
// ../linux/os.bit's poll loop excluding errno 4 (#1904). Same reasoning as
// `osForkExecWait` above, in full there (#3460): this process's own signal
// disposition table has no path that returns a RETURNING handler to a
// blocked-or-polling `waitpid` — the only caught signals are fatal and never
// return, SIGPIPE is ignored and never interrupts, and everything else is
// `SIG_DFL`. Applies equally to the non-blocking `WNOHANG` poll here.
// The forked CHILD's own branch: own process group, pgid == this process's
// pid, BEFORE exec (#2986) — membership survives execve, so a wrapper shell
// (e.g. runcmd.bit's `shell()`) and everything IT forks inherits this group
// too, unless one of them detaches on its own. That is what makes
// `osKillGroup` reach a grandchild, not just this direct child. `setpgid` is
// on POSIX's async-signal-safe list, so it is sound between fork and exec.
// Never returns — either `execve` replaces this process's image, or it
// fails and `rootExit(127)` reports it the same way a shell reports a bad
// exec. Split out purely to keep `osForkExecWaitBounded`'s own body under
// the house line limit (E0201).
@nosplit fn osExecChild(pathPtr: int, argvPtr: int, envpPtr: int) {
  let _ = setpgid(i32(0), i32(0))
  let _ = execve(u8At(pathPtr), u8At(argvPtr), u8At(envpPtr))
  rootExit(127)
}

@nosplit fn osForkExecWaitBounded(pathPtr: int, argvPtr: int, envpPtr: int, timeoutMs: int): int {
  let clamped = timeoutMs
  if (clamped < 0) {
    clamped = 0
  }
  if (clamped > osBoundedMaxMs) {
    clamped = osBoundedMaxMs
  }
  let deadline = osMonoNs() + clamped * 1000000

  let pid = int(fork())
  if (pid < 0) {
    return 0 - 1
  }
  if (pid == 0) {
    osExecChild(pathPtr, argvPtr, envpPtr)
  }
  // Mirrors the child's own call above so the group exists no matter which
  // side runs first (the standard fork/setpgid race fix): once the child has
  // exec'd, a parent-side `setpgid` on it fails (EACCES) but is by then a
  // no-op — the child's own call already set it.
  let _ = setpgid(i32(pid), i32(pid))

  // #3507, cleared before every return below — see `osMarkChildOutstanding`.
  let outstanding = osMarkChildOutstanding(pid)
  let sb = int(ptrOf(osStatusBuf)) + osScratchSlot() * 8
  let polls = 0
  let result = 0 - 1
  let done = false
  while (!done && polls <= osBoundedMaxPolls) {
    storeWord(sb, 0)
    let w = int(waitpid(i32(pid), u8At(sb), i32(osWnohang)))
    if (w == pid) {
      let status = loadWord(sb)
      let sig = status & osWStatusMask
      if (sig == 0) {
        result = (status / osWExitShift) & 255
      } else {
        if (sig == 127) {
          result = 0 - 1
        } else {
          result = 0 - 100 - sig
        }
      }
      done = true
    } else {
      if (w < 0) {
        result = 0 - 1
        done = true
      } else {
        if (w == 0 && osMonoNs() >= deadline) {
          osKillGroup(pid)
          storeWord(sb, 0)
          let _ = waitpid(i32(pid), u8At(sb), i32(0))
          result = 0 - 2
          done = true
        } else {
          if (w == 0) {
            osPollSleep()
          }
        }
      }
    }
    polls = polls + 1
  }
  if (!done) {
    osKillGroup(pid)
    storeWord(sb, 0)
    let _ = waitpid(i32(pid), u8At(sb), i32(0))
    result = 0 - 2
  }
  storeWord(outstanding, 0)
  return result
}

// `bit_rt_os_run_bounded(path, timeoutMs)`: like `os_run`, but killed and
// reported rather than blocked forever once `timeoutMs` elapses.
export @nosplit @symbol("bit_rt_os_run_bounded") fn rtOsRunBounded(path: int, timeoutMs: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = int(ptrOf(osArgvBuf)) + osScratchSlot() * 16
  storeWord(ab, p)
  storeWord(ab + 8, 0)
  return osForkExecWaitBounded(p, ab, osEnvp(), timeoutMs)
}

// `bit_rt_os_run_test_bounded(path, idx, timeoutMs)`: like `os_run_test`, with
// the same bounded wait as `bit_rt_os_run_bounded`. Also gives the child a
// location on panic by default (#3826): unless the parent's own environment
// already sets `BIT_BACKTRACE` (to any value -- an explicit
// `BIT_BACKTRACE=0` opt-out must never be overridden), `BIT_BACKTRACE=1` is
// appended after the copied entries. Scoped to THIS builtin only -- `bit
// run`/`bit build` never call it, so `_tests_/cases/*.bit`'s `// panic`
// golden mode (which compares stderr exactly) is unaffected.
export @nosplit @symbol("bit_rt_os_run_test_bounded") fn rtOsRunTestBounded(path: int, idx: int, timeoutMs: int): int {
  let p = fsPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  let ab = int(ptrOf(osArgvBuf)) + osScratchSlot() * 16
  storeWord(ab, p)
  storeWord(ab + 8, 0)

  let idxStr = osFillTestIndex(idx)
  let ce = int(ptrOf(osChildEnvp)) + osScratchSlot() * 8216
  storeWord(ce, idxStr)

  let src = osEnvp()
  let copied = 0
  let hasBacktrace = false
  while (copied < osMaxEnv) {
    let e = loadWord(src + copied * 8)
    if (e == 0) {
      break
    }
    if (btEnvKeyMatch(e)) {
      hasBacktrace = true
    }
    storeWord(ce + (copied + 1) * 8, e)
    copied = copied + 1
  }
  let next = copied + 1
  if (!hasBacktrace) {
    storeWord(ce + next * 8, osFillBacktraceEnv())
    next = next + 1
  }
  storeWord(ce + next * 8, 0)
  return osForkExecWaitBounded(p, ab, ce, timeoutMs)
}

// ---------------------------------------------------------------------------
// host_target (ABI.md §19) — the LAST symbol only `runtime/root/` defined
// ---------------------------------------------------------------------------

// `bit_rt_host_target`: the `BuildTarget` ordinal this archive was compiled for
// — 0 `x86_64-linux`, 1 `aarch64-linux`, 2 `aarch64-macos`, the enum in
// compiler/build.bit. See ../linux/os.bit's counterpart for the full argument;
// the short form is that the ordinal is a property of the EMIT, and the emit
// carries both axes: the OS is WHICH PROVIDER DIRECTORY the file sits in, the
// arch is an `asm` per-arch sub-block.
//
// Darwin needs neither an `asm` block nor a branch: `aarch64-macos` is the only
// Darwin target the compiler recognises, and this file cannot be built for a
// Linux target at all (a Linux `--emit-obj` refuses `extern function`, E0078,
// even on an uncalled declaration — ../fs.bit's header), so the constant is
// exhaustive rather than assumed. An `x86_64-macos` target (deferred; see the
// aarch64-linux backend notes) would need its OWN `BuildTarget` ordinal before
// it could need a branch here — adding it without one would be the mis-target.
//
// It does NOT call `hostTarget()`: that primitive lowers to a call to this very
// symbol once #1583 drops the `_root` infix, which is the pin cycle
// `./make test-rootpins` guards (../floats.bit's SEAM 6 trap). A literal has no
// callee at all.
//
// `@nosplit` (#1659) so a poll-free caller can ask for the ordinal. That is the
// whole point of expressing it as a literal rather than as `hostTarget()`: the
// primitive is an `ir.RtFn` and lowers to a real `call bit_rt_host_target`, so
// §10.3.1's default-deny allowlist refuses it — correctly, since a call is a
// call. An `int` literal is a materialized immediate: nothing to allocate, no
// safepoint to reach, no callee for the collector to run inside. The mirror in
// ../linux/os.bit qualifies on the same proof one step out, via `asm`.
export @nosplit @symbol("bit_rt_host_target") fn rtHostTarget(): int {
  return 2
}
