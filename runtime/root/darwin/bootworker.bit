// runtime/root/darwin/bootworker.bit — split out of ./boot.bit (#2882) to
// bring both files under the 800-line limit. Holds the worker OS-thread
// body (workerBody), its bounded join (joinWorker), and the first green
// thread's trampoline (mainTrampoline) — the three things boot() starts
// running on a live OS thread or green task once setup is done. ./boot.bit
// keeps the setup sequence itself (boot()), the BIT_GC_STATS report, the
// bit_rt_map_pages/bit_rt_unmap_pages/bit_rt_spawn seams, and the process
// entry (machoMain).
//
// #2579 MOVED THE GUARDED-STACK-MAPPING UTILITIES HERE (alignUpStack,
// alignDownStack, mapGuardedStack; now in ./taskstack.bit, #7128) for the exact
// #2882 reason above: adding sysmonRun's definition to ./boot.bit — required
// there by #2579's own acceptance test — left no room under 800 lines
// otherwise. A pure move, verified by `comm -23` against the pre-move
// concatenation of both files. Both of `mapGuardedStack`'s callers
// (`boot()`'s step 5, `rtSpawn`) stay in ./boot.bit and reach it the same
// order-independent, no-import way described below.
//
// Same module as every sibling here (module files share one scope), so
// boot.bit's imports and module state — schedBlock, mainTaskBlock,
// bootSleepReq, mainExitCode, mainDone — are visible below with no
// re-import, and boot.bit calls back into workerBody/joinWorker/
// mainTrampoline the same way it always did. Named for readability only:
// the checker types every top-level declaration before any function body,
// so name resolution between sibling files is order-independent either way
// (verified on 838c1dc0; the earlier claim that a forward reference here
// could miscompile was wrong and is withdrawn).

// #3739 revives #3726's growth fix; ./boot.bit is at the 800-line ceiling with
// no headroom for a new import, so this one lives here instead, next to its
// only caller (workerBody, below) rather than beside boot.bit's other sched
// imports.
import { schedGrowObserveBacklog, schedPollerArm, schedPollerDisarm, schedPollerHandoff } from "../../sched"
import { wkSlot } from "../../sched"
import { currentMutator } from "../../gc"
import { rootRetakeScan } from "../../root"
import { worker0SpinTurns, worker0SpinWindowNs } from "../../sched"
import { schedPollerDrain, schedW0WaitBegin, schedW0WaitEnd } from "../../sched"

// The ceiling on worker 0's idle wait (#5722, epic #3913) — see its call
// site in `workerBody` below for the full enumeration of what this bounds.
// 1s, not `sleep.bit`'s `idleParkMaxNs` (100ms): that constant bounds a
// missed wake on workers 1..N-1, where `schedWakeIdle` is the normal path
// and the timeout is a rarely-hit safety net; here it is the ONLY bound for
// three of the four wake sources until a producer calls #5717's `pollWake`,
// so it is sized off #3913's own stated target instead — a 2-second idle
// process should retire about 2 wakes.
const worker0WaitCeilingNs: int = 1000000000

// One idle turn's wait (#6429): the token holder blocks in the poller until the
// next deadline, every other worker parks on its own word. The holder disarms its
// park word first, so a producer's one wake goes to a real parked peer and not to
// the thread that is already in the poller, which `schedWakePoller` reaches
// through the token cell instead. `schedPollerDisarm` is the token's release.
// Declared above `workerBody` for the inlining reason `spinForWork` states.
@nosplit fn idleWait(s: *i64, w: *i64, holder: bool, burst: bool, now: int) {
  gcBlockingBegin()
  if (holder) {
    schedIdleDisarm(w)
    worker0Wait(s, w, burst, now)
    schedPollerDisarm(s)
  } else {
    schedIdlePark(s, w)
  }
  gcBlockingEnd()
}

// The idle worker's bounded userspace retry (#3260): up to `idleSpinTurns`
// further find-work passes, returning the first task found, or 0 when the
// budget runs out and the caller must go to the kernel. See "THE IDLE SPIN" in
// `workerBody`'s comment below for why this exists and why it is sound; the
// Linux twin is identical.
//
// DECLARED ABOVE ITS CALLER ON PURPOSE: the inliner only splices a callee it has
// already lowered, and lowering follows declaration order, so a definition below
// `workerBody` would leave this as a real call on the idle path.
//
// The bound is the loop's own (Power of 10 rule 2): `idleSpinTurns` passes and
// no more, whatever the scheduler is doing. It cannot lengthen `workerBody`'s
// `WORKER_MAX_STEPS` budget either — the whole burst happens inside ONE turn of
// that loop, so the trip count still advances once per turn exactly as before.
//
// `schedWorkPending` GATES EACH PASS, and it is not an optimisation — it is what
// makes the spin worth having at all. A burst that called find-work
// unconditionally took the global-queue spinlock, the timer lock and a CAS on
// every peer's deque head on every turn, and measured 0.26s -> 0.45s at four
// workers on the repro: the park syscalls went away and cache-line contention
// with the worker that HAD the work replaced them. Reading first keeps a
// spinning worker entirely in shared state until there is something to take.
//
// `@nosplit`, AND THAT IS THE SAFETY ARGUMENT, NOT A SPEED ONE (#1658). `addr`
// here is a task address held as a raw `int` that no stack map names, so a
// back-edge safepoint poll inside this loop is exactly the shape `test-pollfree`
// exists to refuse — the collector would be free to run with that address live
// and unreported. The annotation removes the poll mechanically instead of
// claiming the property in a review list, and E0075 then proves every callee
// has it too. It is what forces the callee below to be `schedFindWork` (the
// `@nosplit` three-queue probe) rather than `schedFindWorkAt`, which is not
// annotatable — no loss, since the timer expiry and the deadlock check it adds
// are driven by the outer idle turn on both sides of this burst. It also costs
// the burst its clock read, which a queue probe never needed.
@nosplit fn spinForWork(w: *i64): int {
  let k = 0
  while (k < idleSpinTurns) {
    k = k + 1
    if (schedWorkPending(w)) {
      let addr = schedFindWork(w)
      if (addr != 0) {
        return addr
      }
    }
  }
  return 0
}

// Worker 0's idle wait (#5722, epic #3913): ONE wait on the next known
// deadline, or `worker0WaitCeilingNs` when none is armed — no ramp, no per-ms
// recheck. `pollDrain` blocks in `kevent`, which is what makes this safe to do
// at all: it watches every registered fd AND #5717's EVFILT_USER wake filter
// in the SAME syscall this worker must keep making anyway (`sleep.bit`'s
// "worker 0 is the only thread guaranteed to be looking").
//
// EVERY WAY THIS WAIT CAN END, enumerated because a wait this long turns a
// missed wake into a hang, not a delay:
//   - THE DEADLINE JUST COMPUTED needs no signal: the wait's own duration ends
//     exactly then, same as the `parkSleepNs` this replaces.
//   - NETPOLLER READINESS is delivered by the kernel straight into this
//     `kevent` call.
//   - SHUTDOWN is signalled: `./boot.bit`'s teardown triggers `pollWake` on
//     this descriptor (#5735).
//   - A NEWER, EARLIER DEADLINE armed after `workerBody`'s `schedFindWorkAt`
//     read the old one, and WORK PUBLISHED to the global queue or a spawn,
//     trigger it too since #5744: `armForWork` published this worker's intent
//     to wait BEFORE that find-work pass, and `sleep.bit`'s `schedWakePoller`
//     — reached from `schedTimerPush` and `schedWakeIdle` — claims the word
//     and fires the filter. Left unwired by #5722, they rode the ceiling alone
//     and cost a 200us sleep 15.4ms at the default worker count (measured on
//     52703111c).
//
// `worker0WaitCeilingNs` stays the backstop for anything not yet wired: worst
// case one more `schedFindWorkAt` a fixed 1s later.
//
// THE PRE-BLOCK POLL BURST (#5884) is the Linux twin's, line for line: on a
// turn that followed work (`burst`), and only while worker 0 last went idle
// less than `worker0SpinWindowNs` before `now`, up to `worker0SpinTurns`
// probes of `schedWorkPending` and a zero-timeout drain run first, and any
// hit ends the wait unslept so the caller's next turn re-arms and looks
// again. See ../linux/bootworker.bit's `worker0Wait` for why.
//
// DECLARED ABOVE ITS CALLER, same reason `spinForWork` above is.
@nosplit fn worker0Wait(s: *i64, w: *i64, burst: bool, now: int) {
  // The take (#6429) follows the failed find-work pass, so re-check for work
  // now that a producer's claim can reach this wait. The deadline bound is read
  // below, after the take, so it already includes any deadline published before
  // it.
  if (schedWorkPending(w)) {
    worker0IdleSet(now)
    return
  }
  let k = 0
  if (!burst || now - *ptrOf(worker0IdleAt) >= worker0SpinWindowNs) {
    k = worker0SpinTurns
  }
  while (k < worker0SpinTurns) {
    k = k + 1
    if (schedWorkPending(w) || pollDrain(int(s), 0) != 0) {
      worker0IdleSet(now)
      return
    }
  }
  let t = parkMonoNs()
  worker0IdleSet(t)
  let bound = schedParkBoundNs(worker0WaitCeilingNs, t)
  schedW0WaitBegin(bound)
  let drained = pollDrain(int(s), bound)
  schedW0WaitEnd(drained)
}

// When worker 0 last went idle: the start of its last blocking wait, or the
// turn a burst caught work on. Plain loads and stores from whichever worker holds the token; a heuristic window, so a stale value only skips or runs one burst.
let worker0IdleAt: [1]i64

@nosplit fn worker0IdleSet(t: int) {
  let q = ptrOf(worker0IdleAt)
  *q = t
}

// One grow-on-demand attempt (#2593/#3569) — the Linux twin, line for line;
// see ../linux/boot.bit's `tryGrowPool` for the full argument. This module
// emits `--freestanding` too, so it cannot hand `schedMaybeGrow` a `startFn`
// and instead calls the freestanding-safe split: `schedGrowArm` (arms a slot
// or returns nil), this platform's `threadStart` DIRECTLY, then
// `schedGrowCommit` (publishes or abandons).
//
// `workersCeiling` (./boot.bit, #4313) reaches `schedGrowArm` here exactly
// the way `schedMaxWorkers` always has — read directly, no parameter needed
// to get it here, since this file is the same module as `boot.bit`: 0 (the
// implicit-default case) tells `schedGrowArm` to keep checking only against
// `schedMaxWorkers`; a non-zero value is the explicit `BIT_WORKERS` ceiling.
//
// DECLARED ABOVE ITS CALLER, same reason `spinForWork` above is.
//
// THE BODY IS `tryGrowPoolAt`, `@nosplit`, because the monitor thread runs it too
// (#7128, `sysmonRetake`): that thread is permanently `blocked` and `@nosplit`
// end to end, and a safepoint poll on it would move its registry slot out of
// `blocked`. It takes the ceiling as a parameter because a retake passes
// `workersCeiling` plus the workers blocked in the kernel.
@nosplit fn tryGrowPoolAt(sched: *i64, ceiling: int) {
  let startArg = schedGrowArm(sched, ptrOf(startArgs), ptrOf(startDones), ceiling)
  if (int(startArg) == 0) {
    return
  }
  let block = taskAt(int(startArg))
  let doneWordAddr = *(block + 1)
  let dz: *i32 = nil
  let h = threadStart(entryOf(workerBody), startArg, dz + doneWordAddr / 4)
  schedGrowCommit(sched, ptrOf(startHandles), h)
}

fn tryGrowPool(sched: *i64) {
  tryGrowPoolAt(sched, workersCeiling)
}

// The monitor thread's retake (#7128, `../../sched/retake.bit`): when a worker
// has sat in a syscall bracket past the budget with work queued behind it, start
// one more worker through the same recipe. `BIT_WORKERS` bounds RUNNING workers,
// so the explicit ceiling is widened by the number of blocked ones; 0 (no
// explicit ceiling) stays 0.
@nosplit fn sysmonRetake() {
  let s: *i64 = ptrOf(schedBlock)
  let blocked = rootRetakeScan(s)
  if (blocked == 0) {
    return
  }
  let ceiling = workersCeiling
  if (ceiling > 0) {
    ceiling = ceiling + blocked
  }
  tryGrowPoolAt(s, ceiling)
}

// The worker OS-thread entry — same as ../linux/boot.bit's `workerBody`,
// including its reason for driving the find/drain/step trio in a local loop
// rather than passing the `nowFn`/`pollFn` seam to `schedWorkerRun`: a function
// value is a managed-heap `(code, env)` cell and this module must emit
// `--freestanding` (§17.6, #1628).
//
// THE DRAIN IS NOT OPTIONAL, AND ITS ABSENCE WAS #1673. This loop used to be a
// bare `schedWorkerStepNow`, which probes the three queues and the timer list and
// NOTHING ELSE. So this — the only worker the runtime starts — never called
// `pollDrain`, and a green thread parked on the netpoller by `netAwaitReady` had
// no thread in the process that could ever wake it. It did not hang: the poll fd
// was never created either (see `boot` step 4b), so `netAwaitReady` bailed at its
// `pollFd == 0` guard, `netReadSock` fell through to the unscheduled-caller spin,
// exhausted it, and returned -1 — which `bit_rt_net_read` reports as an EMPTY
// READ, indistinguishable from an orderly peer close. Every socket read that had
// to wait for a packet silently returned "". Both halves are needed and neither
// is sufficient: a poll fd nothing drains parks the reader forever, and a drain
// with no poll fd returns 0 on its first line.
//
// THE ORDER IS `schedFindWorkIdle`'s, which is `runtime/sched/`'s: queues, then
// timers, then — only if all of those came up empty — the poller, whose woken
// tasks land on the global queue, which `schedWorkerStepAt` pops from when the
// drain reports a non-zero wake count. Polling
// only when idle is what keeps a `kevent` syscall off the task-dispatch hot path;
// polling AFTER the timers is what stops a busy fd from starving a sleeper.
//
// `parkMonoNs()` IS THE POINT OF THE LOCAL LOOP (#1648). Timer deadlines are set
// by sibling ./time.bit's `bit_rt_time_sleep_ns` as `parkMonoNs() + ns`, so the
// worker that expires them must read the SAME clock. The previous
// `schedWorkerRunBare` folded the clock away to a constant 0, against which no
// positive deadline is ever due — `println/sleep/println` printed its first line
// and hung forever. Nothing else in this file may supply the clock: it is read
// here, once per turn, and passed straight through.
//
// ---------------------------------------------------------------------------
// THE IDLE SLEEP (#1665) — kept identical in ../linux/boot.bit
// ---------------------------------------------------------------------------
//
// `runtime/sched`'s `schedWorkerStep` cannot reach a platform sleep for idle
// (that module may import neither park provider, and the providers' pinned
// `bit_rt_port_park_sleep_ns` is not a member of `libbitrt.a`, so `worker.bit`'s
// own comment states it is unreachable there — E0078, verified on both Linux
// triples). Its no-work branch instead burns `spinBackoff`, a busy spin, which
// is why an idle worker pegged a whole core.
//
// `addr == 0 && woke == 0` is EXACTLY `schedWorkerStep`'s own no-work predicate
// — `schedFindWorkAt` found nothing and `pollDrain` woke nothing — and this
// loop already computes both before calling into the step, so the idle case is
// distinguished HERE, by the caller, with no change to `runtime/sched`'s pinned
// `bit_rt_port_sched_worker_step_at` API. This is sound only because this
// runtime starts exactly ONE worker (ABI.md §5): `woke > 0` with nothing to pop
// off the global queue would mean another consumer raced this thread for it,
// which cannot happen here. When work IS found, `schedWorkerStepAt` is called
// exactly as before and runs it.
//
// The sleep is bracketed with `bit_rt_gc_blocking_begin`/`_end` (ABI.md §5),
// `runtime/sched/`'s own idle path and this file's `boot`/`joinWorker` sleeps: no
// frame here holds a live Bit reference while parked, so the collector may pass
// this worker's slot without waiting for a safepoint it will not reach until
// `parkSleepNs` returns. `scStopping` is checked first and by hand, matching
// `schedWorkerStep`'s own order, so a shutdown signalled while idle is still
// seen within one backoff step rather than after a sleep starts.
//
// ---------------------------------------------------------------------------
// THE IDLE SPIN (#3260) — kept identical in ../linux/boot.bit
// ---------------------------------------------------------------------------
//
// The loop above used to park after ONE failed find-work pass, and that is one
// pass too few for the workload every blocking lock produces. `std/sync`'s
// `Mutex.lock()` is `<- m.token` on a capacity-1 channel, so N green threads
// serialise onto ONE runnable task: the instant a worker finishes a critical
// section the runnable count is zero, and it is non-zero again microseconds
// later when `unlock()` republishes the token. Parking into that gap charges
// every handoff a full OS round trip — `__ulock_wake` from the releasing side,
// `__ulock_wait` to re-park — so the cost per acquisition grew with the worker
// count instead of staying flat (15.6 ns at one worker, 406 ns at four,
// 1172 ns at eight, with 88% of thread time in park/wake leaves; #2321).
//
// `spinForWork` below is the answer: one BOUNDED burst of extra find-work
// passes, in userspace, before the kernel is involved at all. Three properties
// make it safe rather than a return of the spin #1902 deleted:
//
//   - THE BUDGET IS RE-ARMED ONLY BY FOUND WORK, never by a park. A worker with
//     nothing left to do spins exactly once and then sleeps, so an idle pool
//     costs what it costs today — the measurement that pinned the worker
//     default at 1 (`sleep(3s)` burning 0.84s of CPU at 18 workers) cannot come
//     back through this path.
//   - THE BURST DOES NOT `pollDrain`. That drain is a `kevent` syscall, the very
//     cost this is avoiding, and skipping it is already an outcome every caller
//     handles: `schedPollTryEnter` admits one worker at a time, so "somebody
//     else has it" is a normal return today. Worker 0 never parks and drains on
//     every one of its own turns, so nothing stops being polled.
//   - THE ARM STAYS SET THROUGH THE BURST, and no wake can be lost by it. A
//     producer that claims a spinning worker spends its wake on a thread that is
//     already awake and `parkWake` on an unparked word is a no-op — but the work
//     was published BEFORE the claim (sleep.bit's arm order), so this worker's
//     very next pass finds it without a syscall. If the burst runs out first,
//     `schedIdlePark`'s own compare reads the claimed word as 0, not 1, and
//     returns immediately rather than sleeping through the wake. The worst case
//     is that a wake is absorbed by the worker that was going to take the task
//     anyway.
//
//
// THE PARK IS BOUNDED BY THE NEXT KNOWN DEADLINE (#3911). The sweeps
// immediately above publish that deadline; the wait is never longer than it.
// Full argument for the bound itself: `schedParkBoundNs` (`runtime/sched/
// timer.bit`) — it lives with the mechanism rather than being copied into
// both platform leaves. The clock is read HERE, not reused from the pass
// above: a stale `now` lengthens the wait by however long that pass took.
// `schedCheckDeadlock` is reached through `schedFindWorkAt` here exactly as
// it is on the outer turn, and its verdict cannot change with the number of
// passes: it acts only at `nworkers == 1`, where the burst asks the same
// question the outer turn just asked and gets the same answer.
//
// #5722 (epic #3913) CHANGED WHAT THE FIRST ARGUMENT TO `schedParkBoundNs`
// IS, FOR WORKER 0 ONLY. `backoff` used to be a BLIND ramp that knew nothing
// about what this worker was idle for, doubling from `parkMinBackoffNs` up
// to a `parkMaxBackoffNs` floor of 1ms — so an idle process woke worker 0 at
// up to 1000 Hz forever, whether or not anything was ever going to happen.
// Worker 0's own wait, `worker0Wait` above, now passes a fixed
// `worker0WaitCeilingNs` instead of the ramped `backoff`, through `pollDrain`
// (#5717's EVFILT_USER wake channel, #5730's nanosecond unit) rather than
// `parkSleepNs` — see that function for what wakes it and why the fixed
// ceiling is still needed. `backoff` itself is untouched and still ramps: `workers 1..N-1`
// never read it (they use `idleParkMaxNs`, `sleep.bit`), and it still feeds
// `schedWorkerStepAt`'s race-loss retry below, unrelated to this change.
// ../linux/bootworker.bit is NOT part of this ticket and still bounds its
// own worker 0 with the ramped `backoff` exactly as before.
fn workerBody(arg: *byte): *byte {
  // ARM THIS THREAD'S CRASH DIAGNOSTIC FIRST (#2246, ./signal.bit): every
  // green task this worker will ever run executes below this line, so the
  // alternate signal stack must be live before any of them can fault.
  installAltStackForThisWorker()

  // CLAIM THE MUTATOR SLOT EAGERLY, BEFORE ANY BIT CODE RUNS (#1677/#1699).
  // Second only to arming the crash diagnostic above — installAltStackForThisWorker()
  // allocates nothing and touches no safepoint, so the window this call closes
  // is still shut. This is the thread's ENTRY function — the same place
  // `gcThreadExit` below runs at exit, and `runtime/sched/`'s `Worker.run` calls
  // `gc_hooks.threadEnter()` at the matching point. Lazy registration (claiming
  // a slot on first allocation or first safepoint poll) leaves a real window:
  // `schedWorkerStepAt`'s very first task dispatch can `schedSwitch` into a
  // green task body BEFORE this thread's own loop back edge is ever reached,
  // and #1677's reproducer proved a task that reads a live reference out of
  // shared state before its own first allocation/loop is invisible to the
  // rendezvous for that whole window — the object was swept 20/20 runs.
  // Calling `gcThreadEnter()` here closes it: this thread is a mutator before
  // it ever runs Bit code.
  gcThreadEnter()

  let block = taskAt(int(arg))
  let workerAddr = *block
  let doneAddr = *(block + 1)

  let w = taskAt(workerAddr)
  // Record this thread's registry slot for the monitor's retake scan (#7128).
  *(w + wkSlot) = currentMutator(0)
  let s: *i64 = ptrOf(schedBlock)
  let backoff = parkMinBackoffNs
  // ANY IDLE WORKER MAY POLL (#6429, was "worker 0 polls, the rest park",
  // #1902). The poller role is the token `schedPollerArm` takes
  // (`runtime/sched/sleep.bit`): the idle worker that wins it blocks in
  // `worker0Wait` until the next deadline, every other idle worker parks on its
  // own word as before. A missed wake still costs latency, never a hang: the
  // park backstop and the wait's ceiling bound every wake source not wired.
  // The token holder leaves the poller before it runs a task (#6429).
  let owed = false
  // The spin budget (#3260, "THE IDLE SPIN" above). Starts false: a worker that
  // has run nothing yet has no reason to believe work is moments away, and boot
  // is exactly when N-1 workers find an empty scheduler.
  let spin = false
  let n = 0
  while (n < WORKER_MAX_STEPS) {
    n = n + 1
    // GROW-ON-DEMAND (#2593/#3569/#3726). At the TOP of the turn, not after the
    // step it used to follow: a green task is not preemptible, so a worker that
    // has committed to a long CPU-bound one does not reach the bottom of this
    // loop again until that task ends. Growing first is what lets a freshly
    // started worker pass the signal on before it takes work of its own, which
    // turns a ramp of one doubling per task duration into a chain bounded by
    // thread-create latency. Both calls are no-ops with no backlog: the
    // observer walks peers with plain loads, and `schedGrowArm` returns on its
    // first compare without taking a lock.
    schedGrowObserveBacklog(w)
    tryGrowPool(s)
    // Arm BEFORE looking for work; see the Linux twin for the window this closes.
    schedIdleArm(w)
    let now = parkMonoNs()
    let addr = schedFindWorkAt(w, now)
    let woke = 0
    if (addr == 0) {
      woke = schedPollerDrain(s)
    }
    // `woke == 0`, NOT `woke <= 0`: a drain whose only event was this worker's
    // own wake returns `pollDrainWakeOnly` (negative), and the whole point of
    // that answer is that this branch must NOT be taken — the wake has already
    // been consumed and `scPollWait` already claimed, so the wait below could
    // only end on its ceiling.
    if (addr == 0 && woke == 0) {
      if (atomicLoad(s + scStopping) != 0) {
        break
      }
      // THE TOKEN (#6429): the first idle worker to win the CAS blocks in the
      // poller until the next deadline; the rest spin once and park. Taking it
      // AFTER the failed pass is safe because `worker0Wait` re-checks for work
      // and reads the deadline bound once the token is held: a producer that
      // published before the take is seen there, one that publishes after finds
      // the cell armed and claims it (`schedWakePoller`).
      let holder = schedPollerArm(s)
      // One bounded burst of userspace retries before the park — see "THE IDLE
      // SPIN" above. Cleared FIRST, so the burst runs at most once per turn
      // that found work, whichever way this turn ends.
      if (!holder && spin) {
        spin = false
        addr = spinForWork(w)
      }
      if (addr == 0) {
        idleWait(s, w, holder, spin, now)
        spin = false
        owed = holder
        backoff = parkNextBackoff(backoff)
        continue
      }
    }
    // Running instead of parking: clear the arm so a producer does not spend
    // its one wake on a worker that is already busy.
    schedIdleDisarm(w)
    // This worker just left the poller to run a task: hand the token to a
    // parked peer if something still needs a poller (#6429).
    if (owed) {
      owed = false
      schedPollerHandoff(s)
    }
    // Work found — re-arm the budget for the next idle stretch (#3260).
    spin = true
    backoff = schedWorkerStepAt(w, addr, woke, backoff)
    // TEARDOWN (#2167). `schedWorkerStep`, inside `schedWorkerStepAt`, already
    // unregistered the retired task from the collector's root set before
    // returning, so its stack and task block are unreachable and safe to
    // release here. `wkLastDone` — not `addr` — names the retired task,
    // because the netpoller-drain path picks its own task internally when
    // `addr == 0` (see `wkLastDone`'s own comment in `runtime/sched/worker.bit`).
    //
    // `mainTaskBlock` IS EXCLUDED, ALWAYS. It is a fixed module array
    // registered through `schedRegisterBigStack`, never `mapPages`'d, and it
    // reaches this identical `taskDone` transition through this identical
    // loop when `bit_main` returns. Unmapping it would `munmap` memory this
    // module never `mmap`'d.
    let doneTask = *(w + wkLastDone)
    if (doneTask != 0 && doneTask != int(ptrOf(mainTaskBlock))) {
      releaseTask(doneTask)
    }
    if (backoff == workerStepStop) {
      break
    }
  }
  // Leaving for good, by any of the three exits. Drop the arm (#5744): a stale
  // 1 in worker 0's word would have producers trigger a descriptor teardown is
  // about to close.
  schedIdleDisarm(w)

  // RELEASE THE MUTATOR SLOT (#1666). `runtime/sched/`'s `Worker.run` — the oracle
  // this function ports — carries `gc_hooks.threadEnter()` /
  // `defer gc_hooks.threadExit()`, and the exit half was missing here. The
  // worker registers lazily at its first safepoint poll and then died without
  // ever releasing slot 1, which stayed `mRunning` forever; from that moment
  // every rendezvous the boot thread started waited out `stwSpinBound` for a
  // thread that no longer existed and abandoned. `../../gc/gcworld.bit` states
  // the consequence on `gcThreadExit` itself: "a leaked slot stays `running`
  // forever, which corrupts nothing but makes every later rendezvous expire,
  // i.e. collection quietly stops." Measured at ~160 abandoned collections per
  // run regardless of workload size, and 0 with this call.
  //
  // PLACEMENT IS LOAD-BEARING, and it is the oracle's: AFTER the run loop, so
  // no Bit code runs on this thread again, and BEFORE the done store, whose
  // tail is raw pointer arithmetic holding no managed reference. That is
  // `gcThreadExit`'s precondition. This is NOT the #1650/#1651 shape — nothing
  // is suppressed while the thread can still run Bit code; the slot is released
  // only once the thread is leaving. Releasing it any earlier would let a
  // rendezvous proceed past a thread that is still running, which is the defect
  // that sweeps live objects.
  gcThreadExit()

  let z: *i32 = nil
  atomicStore(z + doneAddr / 4, i32(0))
  return nil
}

// Trip bound for `joinWorker`, `runtime/thread`'s `JOIN_MAX_POLLS` unchanged, so
// the join is finite even if the deadline clock misbehaves (Power of 10, rule 2).
const joinMaxPolls: int = 100000

// `runtime/thread`'s `threadJoin` for THE one worker this runtime starts, with
// the platform clock and sleep called directly instead of taken as function
// values (see `workerBody`). Identical to ../linux/boot.bit's.
fn joinWorker(done: *i32, timeoutNs: int): bool {
  // A non-positive timeout still gets one look at the word, so a join on an
  // already-finished worker succeeds rather than reporting a spurious timeout.
  if (atomicLoad(done) == i32(0)) {
    return true
  }
  let deadline = parkMonoNs() + timeoutNs
  let backoff = parkMinBackoffNs
  let i = 0
  while (i < joinMaxPolls) {
    if (atomicLoad(done) == i32(0)) {
      return true
    }
    if (parkMonoNs() >= deadline) {
      return false
    }
    parkSleepNs(backoff, ptrOf(bootSleepReq))
    backoff = parkNextBackoff(backoff)
    i = i + 1
  }
  return false
}

// The boot thread's step-7 wait for `main` (`./boot.bit`), placed here because
// the two halves of that rendezvous only make sense read together: this waits
// on `mainDone`, and `mainTrampoline` below is its only writer.
//
// #3717: THIS WAS AN OPEN-CODED 1ms POLL AND IT COST A FIFTH OF A CORE FOREVER.
// The loop ramped `parkSleepNs` from 1us and capped the ramp at
// `parkMaxBackoffNs`, so after ~10 turns it saturated and this thread woke 1000
// times a second for the whole life of the process, running a
// `gcBlockingBegin`/`gcBlockingEnd` pair and a safepoint poll on every wake. A
// 30-hour `bit lsp` had done roughly 108 million of them, with 8492 of 8508
// `sample` hits inside the sleep.
//
// `parkWait` is the primitive the loop always wanted. It is a COMPARE-and-wait
// (`__ulock_wait` here, `futex(FUTEX_WAIT)` on ../linux, `WaitOnAddress` on
// ../windows), so the kernel re-reads `mainDone` under its own lock: a store
// landing between this thread's own load and the wait is caught by that compare
// and returns immediately instead of being missed. There is no separate
// double-check to write. `mainTrampoline` issues the matching `parkWake`.
//
// THE TIMEOUT IS 0 — WAIT FOREVER — a genuine indefinite wait, not a
// workaround: ../linux's `parkWait` used to build its `timespec` as
// `[]i64(2)`, a HEAP slice, violating `gcBlockingBegin`'s precondition that
// this thread hold no live Bit reference for the whole bracketed region
// (#3914). It now takes a caller-owned `scratch` (`bootSleepReq`, the same
// buffer `parkSleepNs` below already uses on this thread, never
// concurrently) instead, so a real timeout would be safe here too — 0 stays
// because main's completion has no natural poll interval. The re-check below
// is the net regardless.
//
// THAT RE-CHECK IS THE SPIN GUARD AND IT IS LOAD-BEARING. `parkWait` reports
// "re-read the word" for a real wake, a spurious wake, a failed compare AND an
// error — ../../park/park.bit's contract deliberately conflates them, and
// ../windows additionally declines to block at all when its 32-slot scratch
// pool is full. So a `parkWait` that returns without ever blocking would make
// this a hot spin. One `parkMaxBackoffNs` sleep when `main` is still running
// makes the worst case exactly the 1ms poll this replaced, and never worse.
//
// THE BRACKET STAYS (#2542, `runtime/gc/gcworldsync.bit`): the collector must
// see this thread as `blocked` for the whole wait, or it spins on a thread that
// will never reach a safepoint.
fn bootWaitForMain() {
  while (atomicLoad(ptrOf(mainDone)) == i32(0)) {
    gcBlockingBegin()
    let _ = parkWait(ptrOf(mainDone), i32(0), 0, ptrOf(bootSleepReq))
    if (atomicLoad(ptrOf(mainDone)) == i32(0)) {
      parkSleepNs(parkMaxBackoffNs, ptrOf(bootSleepReq))
    }
    gcBlockingEnd()
  }
}

// The first green thread: run `bit_main`, publish its exit code, leave the task.
fn mainTrampoline() {
  mainExitCode = int(bit_main())
  atomicStore(ptrOf(mainDone), i32(1))
  // #3717: the boot thread is PARKED on this word in `bootWaitForMain` above,
  // not polling it, so it needs waking. STRICTLY AFTER the store — `parkWait`'s
  // compare is what closes the race, and it can only act on a value already
  // published. `all` rather than one: the boot thread is the sole waiter today,
  // a wake with no waiter is a no-op on every platform, so waking all costs the
  // same and cannot silently miss a second observer if one is ever added.
  let _ = parkWake(ptrOf(mainDone), true)
  schedTaskExit()
}

