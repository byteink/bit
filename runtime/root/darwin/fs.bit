// Darwin filesystem provider for the SEAM 3 remainder (#1606): the 12
// `bit_rt_fs_*` ABI wrappers (ABI.md §14) and the libSystem calls behind them.
// This is the Bit form of `runtime/root/`'s `fs_*` block plus the Darwin
// branch of `runtime/sched/`'s `openFd`/`readFd`/`writeFd`/`closeFd`/
// `mkdirAt`/`removeAt`/`chmodAt`/`fileSize`/`listDir`/`statPath`.
//
// Goes through libSystem (§11.7) rather than raw traps: Apple publishes no stable
// syscall numbers (../darwin/io.bit). KEPT DELIBERATELY IN THE SAME FUNCTION-FOR-
// FUNCTION SHAPE AS ../linux/fs.bit, so a divergence between the two is a real
// platform difference rather than a stylistic one. See ../fs.bit's header for why
// each provider is self-contained rather than the netabi extern shape.
//
// EVERY `open` FLAG, PERMISSION AND `dirent` OFFSET BELOW WAS READ OUT OF THE
// THE macOS SDK HEADERS (`<fcntl.h>`'s `O_*`, `<dirent.h>`'s `struct dirent`),
// NOT FROM MEMORY. The
// Darwin `O` bits DIFFER FROM LINUX (O_CREAT=0x0200 vs 0o100, O_TRUNC=0x0400 vs
// 0o1000, O_APPEND=0x0008 vs 0o2000) and the `dirent` name field sits at a
// different offset — a wrong constant is a silent wrong-behaviour, never a
// compile error.

import { fsPathZ, rtStrAlloc, rtStringSlice } from "../../root"
// `gcSyscallBegin`/`gcSyscallEnd` are NOT imported here: ./os.bit already imports
// them, and a sibling .bit file is the same module, so a second import is E0042.
import { loadByte, storeByte } from "../../gc"

// `write`, `strPtr`, `strLen` and `loadWord` are already declared/imported by this
// module's sibling ../darwin/io.bit (module-scoped in Bit), so they are reused,
// not re-declared — a redeclaration is E0042.

// libSystem filesystem calls. Only C-representable types cross the boundary
// (§11.7): a path/buffer travels as `*u8` and counts as `i64`.
//
// `open` IS VARIADIC (`int open(const char *, int, ...)`) and its `mode` is the
// single variadic argument. On arm64 Apple every variadic argument is passed on
// the STACK regardless of how many named ones precede, so `mode` must land there:
// `modeReg` fills x2 and the five pads fill x3–x7 (all ignored by the callee),
// and `modeStack` is the 9th argument, which lands on the stack where `open`
// reads its vararg. Callers pass `mode` in both slots — the register copy is
// inert. This is the exact device net/darwin/sock.bit uses for `fcntl`.
extern fn open(path: *u8, flags: i32, modeReg: i64, pad3: i64, pad4: i64, pad5: i64, pad6: i64, pad7: i64, modeStack: i64): i32
extern fn read(fd: i32, buf: *u8, n: i64): i64
extern fn lseek(fd: i32, offset: i64, whence: i32): i64
extern fn mkdir(path: *u8, mode: i32): i32
extern fn unlink(path: *u8): i32
extern fn rmdir(path: *u8): i32
extern fn chmod(path: *u8, mode: i32): i32
extern fn opendir(path: *u8): *u8
extern fn readdir(dirp: *u8): *u8
extern fn closedir(dirp: *u8): i32
extern fn access(path: *u8, mode: i32): i32
// `readlink` is the SYMLINK PROBE, not a way to read a link's target here: it is
// the one libSystem call that asks about the LINK rather than what the link
// resolves to, and it fails with `EINVAL` on everything that is not one. See
// `rtFsIsSymlinkZ` for why that is preferred over `lstat` + `S_IFLNK`.
extern fn readlink(path: *u8, buf: *u8, bufsize: i64): i64

// `close` GOES THROUGH libSystem HERE AND CARRIES A KNOWN #1436 HAZARD. Under the
// SEED compiler (which builds this runtime today and links every user binary
// until G3) `extern function close` binds `_close` and works. Under the
// SELF-HOSTED compiler, #1436 makes it emit only `_close$NOCANCEL` and drop the
// `_close` import, SIGSEGV at run time — the defect sched/darwin/poll.bit sidesteps
// by routing through libbitrt's `bit_rt_fs_close`. That workaround CANNOT apply
// here: this IS `bit_rt_fs_close`'s implementation once G2/G3 rename the wrapper.
// So the Darwin close path is blocked on #1436 landing before the archive swap
// (#1369) — recorded, not fixable inside this port. It does not affect the
// freestanding-emit or rootpins proofs, which never execute this body.
extern fn close(fd: i32): i32

// Darwin `O_*` flags (`<sys/fcntl.h>`): O_WRONLY=1, O_CREAT=0x0200=512, O_TRUNC=0x0400=
// 1024, O_APPEND=0x0008=8. A read open is O_RDONLY=0. Default perms: file
// 0o644=420, directory 0o755=493.
const oWrite: int = 1537
const oAppend: int = 521
const permFile: int = 420
const permDir: int = 493

// SEEK_END / SEEK_SET for `lseek` (universal: 2 and 0).
const seekEnd: int = 2
const seekSet: int = 0

// F_OK (`<unistd.h>`): existence only, no read/write/execute bit — `access`
// needs no permission on the target itself, only search permission on its
// parent directories, unlike `open`/`opendir` (#2114).
const fOk: int = 0

// Darwin `struct dirent` (`<sys/dirent.h>`): ino(u64)@0, seekoff(u64)@8, reclen(u16)@16,
// namlen(u16)@18, type(u8)@20, name@21. `readdir` on arm64 returns this 64-bit
// -inode layout directly (no `$INODE64` variant — that is x86_64 only).
const direntNameOff: int = 21

// The `readlink` sink for the symlink probe. One WORD, deliberately: the probe
// reads only whether the call SUCCEEDED, never the target's text, so the buffer
// exists solely because a `bufsiz` of 0 is not portable (POSIX leaves it
// unspecified; Linux answers EINVAL). MODULE-LEVEL and unlocked, sound under
// the same single-worker contract (ABI.md §5) ../fs.bit's `fsPathBuf` documents,
// and a scalar array so the collector never scans it (rule 1).
let fsLinkBuf: [1]i64
const fsLinkBufBytes: int = 1

// The packed NUL-terminated path for the symlink probe. A SECOND buffer rather
// than ../fs.bit's `fsPathBuf`, which is a different module's private state and
// is reachable here only through `fsPathZ`, whose argument is a Bit `string`
// object — the one thing the probe's `extern` boundary cannot carry. Same size
// and same reasoning: 512 words = 4096 bytes = `max_path`, so the longest
// accepted path (4095 bytes) plus its NUL fits exactly, and the same
// single-worker contract makes it safe unlocked.
let fsLinkPathBuf: [512]i64

// ../fs.bit's `fsMaxPath`, which is that module's private const. Mirrored here
// rather than shared because this module cannot see it; it is `runtime/root/`'s
// `max_path = 4096` and must move with it.
const fsLinkMaxPath: int = 4096

// ---------------------------------------------------------------------------
// Pointer / string glue
// ---------------------------------------------------------------------------

// A raw byte pointer at `addr` — `base + addr` on a nil `*u8`, the project idiom
// (root/darwin/io.bit's `rootWriteAll`).
@nosplit fn u8At(addr: int): *u8 {
  let base: *u8 = nil
  return base + addr
}

// A string object's inline byte pointer and length (ABI.md §2). `strPtr`/`strLen`
// and `loadWord` are io.bit's module-scoped decls.
@nosplit fn strData(s: int): int { return loadWord(s + strPtr) }
@nosplit fn strLenOf(s: int): int { return loadWord(s + strLen) }
@nosplit fn emptyStr(): int { return rtStrAlloc(0) }

// `fsPathZ` copies a Bit string's bytes verbatim and appends its own NUL
// terminator (#2146): a string carrying an embedded NUL byte (legal per
// SPEC §21) would let the copy stop early from the syscall's point of view
// while every Bit-side check — `len`, `==`, `hasSuffix`, `ext` — still sees
// the full string, so the syscall opens a different path than the one that
// was validated. Reject up front, same "reject, not truncate" contract
// `fsPathZ` already applies to `n >= fsMaxPath`. Every one of the 8
// path-taking `bit_rt_fs_*` entry points below routes through this instead
// of calling `fsPathZ` directly.
//
// BOUNDED (Power of 10 rule 2): the scan is bounded by the string's own
// length, exactly as `fsPathZ`'s copy loop it precedes.
@nosplit fn checkedPathZ(path: int): int {
  let n = strLenOf(path)
  let base = strData(path)
  let i = 0
  while (i < n) {
    if (loadByte(base + i) == 0) {
      return 0
    }
    i = i + 1
  }
  return fsPathZ(path)
}

// ---------------------------------------------------------------------------
// libSystem calls (the runtime/sched/ helpers)
// ---------------------------------------------------------------------------

// Open `pathPtr` (NUL-terminated): mode 0=read-only, 1=create+truncate write-only,
// 2=create+append write-only. Returns the fd or -1.
@nosplit fn sysOpen(pathPtr: int, mode: int): int {
  let flags = 0
  if (mode == 1) {
    flags = oWrite
  }
  if (mode == 2) {
    flags = oAppend
  }
  let fd = int(open(u8At(pathPtr), i32(flags), i64(permFile), 0, 0, 0, 0, 0, i64(permFile)))
  if (fd < 0) {
    return 0 - 1
  }
  return fd
}

// The length of the NUL-terminated name at `addr`, capped at NAME_MAX+1 (256) so
// the scan is provably bounded (Power of 10 rule 2).
@nosplit fn cstrLen(addr: int): int {
  let i = 0
  while (i < 256) {
    if (loadByte(addr + i) == 0) {
      return i
    }
    i = i + 1
  }
  return 256
}

// `.` or `..` — the two entries `list_dir` omits.
@nosplit fn isDotName(addr: int, nlen: int): bool {
  if (nlen == 1 && loadByte(addr) == 46) {
    return true
  }
  if (nlen == 2 && loadByte(addr) == 46 && loadByte(addr + 1) == 46) {
    return true
  }
  return false
}

// List `pathPtr`'s entries, snprintf-shaped: write up to `cap` bytes of
// NUL-terminated names (`.`/`..` omitted) to `outPtr` and return the TOTAL bytes
// needed (a `cap == 0` call measures), or -1 if the directory cannot be opened.
// The readdir loop is `runtime/sched/`'s `listDir` on Darwin.
//
// BOUNDED: `readdir` returns nil at end of directory (or on error, which callers
// treats identically), and a directory has finitely many entries.
@nosplit fn sysList(pathPtr: int, outPtr: int, cap: int): int {
  let dir = opendir(u8At(pathPtr))
  if (int(dir) == 0) {
    return 0 - 1
  }
  let total = 0
  let done = false
  while (!done) {
    let ent = readdir(dir)
    if (int(ent) == 0) {
      done = true
    } else {
      let nameAddr = int(ent) + direntNameOff
      let nlen = cstrLen(nameAddr)
      if (!isDotName(nameAddr, nlen)) {
        let j = 0
        while (j < nlen) {
          if (total + j < cap) {
            storeByte(outPtr + total + j, loadByte(nameAddr + j))
          }
          j = j + 1
        }
        if (total + nlen < cap) {
          storeByte(outPtr + total + nlen, 0)
        }
        total = total + nlen + 1
      }
    }
  }
  closedir(dir)
  return total
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §14) — bare `bit_rt_fs_*` pins, `rtFs*`
// names to avoid shadowing the `fsOpen`/`fsRead`/… builtins. See ../linux/fs.bit.
// ---------------------------------------------------------------------------

// Whether the already-copied C path `p` names a directory. Factored out of
// `rtFsIsDir` so `rtFsOpen` can reuse it without a second `checkedPathZ` copy.
@nosplit fn isDirAtP(p: int): bool {
  let dir = opendir(u8At(p))
  if (int(dir) == 0) {
    return false
  }
  closedir(dir)
  return true
}

// `bit_rt_fs_open`: open `path` read-only or create+truncate write-only. fd or
// -1. Rejects a directory (#2149): `open(2)` on a directory succeeds with
// `O_RDONLY` and no `O_DIRECTORY`/`fstat` guard, handing out a `File` nothing
// can actually read — `readAll` then fabricates a zero-filled string sized by
// the directory's on-disk size instead of failing. Checked here, once, so
// every caller (`readFile`, `open`) fails the same way a missing path does.
export @nosplit @symbol("bit_rt_fs_open") fn rtFsOpen(path: int, write: bool): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (isDirAtP(p)) {
    return 0 - 1
  }
  let mode = 0
  if (write) {
    mode = 1
  }
  return sysOpen(p, mode)
}

// `bit_rt_fs_append`: open `path` create+append write-only. fd or -1.
export @nosplit @symbol("bit_rt_fs_append") fn rtFsAppend(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  return sysOpen(p, 2)
}

// `bit_rt_fs_read`: up to `max` bytes from `fd` into a fresh string, trimmed to
// what arrived (empty at EOF).
export @nosplit @symbol("bit_rt_fs_read") fn rtFsRead(fd: int, max: int): int {
  if (max <= 0) {
    return emptyStr()
  }
  let big = rtStrAlloc(max)
  if (big == 0) {
    return emptyStr()
  }
  // THE `syscall` BRACKET IS LOAD-BEARING (#2207), for the same reason
  // ../os.bit's `waitpid` has one. `fd` may be a pipe, a tty or a socket, so
  // this `read` blocks until somebody writes — indefinitely, for a server or an
  // LSP sitting on stdin. Unbracketed, the reading thread never reaches a
  // safepoint, so a thread that requests a stop-the-world spins in its wait loop
  // for the whole duration: measured at ~77% of a core, continuously, in
  // `bit lsp --stdio`.
  //
  // `syscall` and NOT `blocked`: `big` is a live reference held across this
  // call, and `blocked` would let it be swept. `syscall` publishes the stack
  // bound and register file so it is scanned in place.
  gcSyscallBegin()
  let n = int(read(i32(fd), u8At(strData(big)), i64(max)))
  gcSyscallEnd()
  if (n <= 0) {
    return emptyStr()
  }
  return rtStringSlice(big, 0, n)
}

// `bit_rt_fs_exists`: whether `path` names anything at all, per its own
// `std/fs` doc comment. `access(F_OK)` is the direct probe for exactly that
// question and needs no permission on the target — unlike the old
// `opendir`-then-`open` probe, which reported a mode-000 file (or a
// directory an unrelated fd-exhausted process couldn't open) as ABSENT
// instead of ACCESS-DENIED (#2114). Also drops the fd allocation the old
// probe needed, so `exists` can no longer contribute to fd exhaustion.
export @nosplit @symbol("bit_rt_fs_exists") fn rtFsExists(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  return int(access(u8At(p), i32(fOk))) == 0
}

// `bit_rt_fs_is_dir`: false for a missing path or a non-directory. `opendir`
// distinguishes a directory directly.
export @nosplit @symbol("bit_rt_fs_is_dir") fn rtFsIsDir(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  return isDirAtP(p)
}

// Copy the `n` path bytes at `words` — a Bit `[]byte`'s backing store, so ONE
// 8-BYTE WORD PER ELEMENT (SPEC §11.8), not packed bytes — into
// `fsLinkPathBuf`, NUL-terminated, and return the buffer address. 0 when the
// path may not be handed to a syscall at all.
//
// This is `checkedPathZ` for a caller that has no Bit `string` to offer, and it
// applies the identical two rules, so `fsIsSymlinkW` refuses exactly the paths
// every other entry point refuses:
//   - at or over `max_path`: REJECTED, never truncated, so a lie about the
//     prefix cannot reach the kernel.
//   - an embedded NUL (legal in a Bit string, SPEC §21): REJECTED, because the
//     syscall would stop early while every Bit-side check still saw the whole
//     string — a different path probed than the one that was validated (#2146).
//
// BOUNDED (Power of 10 rule 2): by `n`, itself bounded by the `< fsLinkMaxPath`
// guard above the loop.
@nosplit fn wordsPathZ(words: int, n: int): int {
  if (words == 0 || n <= 0 || n >= fsLinkMaxPath) {
    return 0
  }
  let dst = int(ptrOf(fsLinkPathBuf))
  let i = 0
  while (i < n) {
    let b = loadWord(words + i * 8)
    if (b == 0) {
      return 0
    }
    storeByte(dst + i, b)
    i = i + 1
  }
  storeByte(dst + n, 0)
  return dst
}

// `bit_rt_fs_is_symlink_w`: whether the `n` path bytes at `words` name a
// symbolic LINK itself, asked of the link and never of what it resolves to.
// `false` for a missing path, a non-link, and a path that cannot be probed.
//
// THE ONLY `bit_rt_fs_*` ENTRY POINT NOT TAKING A BIT `string` OBJECT — hence
// the `_w` suffix, for the word-per-byte argument `wordsPathZ` above unpacks.
// It has to be: its caller is `std/fs`, which can reach a runtime symbol only
// through an `extern function` (SPEC §11.7), and §11.7 admits no `string`
// across that boundary.
//
// `readlink(2)` AND NOT `lstat` + `S_IFLNK`. Both answer the question; only one
// of them hard-codes a `struct stat` layout, and this file's header note is
// explicit that a wrong offset there is a silent wrong ANSWER rather than a
// build error. `readlink` needs no layout at all: it succeeds on a symbolic
// link and fails with `EINVAL` on everything else. A DANGLING link still
// answers true, which is correct — the link exists whether its target does or
// not, and it is exactly the link a walk must refuse to descend.
export @nosplit @symbol("bit_rt_fs_is_symlink_w") fn rtFsIsSymlinkW(
  words: int,
  n: int,
): bool {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return false
  }
  return int(readlink(u8At(p), u8At(int(ptrOf(fsLinkBuf))), i64(fsLinkBufBytes))) >= 0
}

// `bit_rt_fs_mkdir`: 0 on success, -1 on failure, mode 0o755.
export @nosplit @symbol("bit_rt_fs_mkdir") fn rtFsMkdir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (int(mkdir(u8At(p), i32(permDir))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_remove`: 0 on success, -1 on failure. `unlink` then `rmdir`.
export @nosplit @symbol("bit_rt_fs_remove") fn rtFsRemove(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (int(unlink(u8At(p))) == 0) {
    return 0
  }
  if (int(rmdir(u8At(p))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_list_dir`: `path`'s entries, NUL-terminated, `.`/`..` omitted. Empty
// when the directory is empty or unreadable. Two passes (measure, then fill a
// string sized to it), trimmed to what pass 2 wrote. See ../linux/fs.bit.
export @nosplit @symbol("bit_rt_fs_list_dir") fn rtFsListDir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return emptyStr()
  }
  let needed = sysList(p, 0, 0)
  if (needed <= 0) {
    return emptyStr()
  }
  let out = rtStrAlloc(needed)
  if (out == 0) {
    return emptyStr()
  }
  let got = sysList(p, strData(out), needed)
  if (got <= 0) {
    return emptyStr()
  }
  if (got > needed) {
    got = needed
  }
  return rtStringSlice(out, 0, got)
}

// Darwin errno for an interrupted syscall (`<sys/errno.h>`), shared by every
// libSystem call in this runtime — see ../../net/darwin/sock.bit's identical
// constant. `read()` sets thread-local `errno` and returns -1 on ANY failure;
// `__error()` is `std.c._errno`'s `__error` symbol, the only way Bit code
// reaches it (#2990's investigation — no accessor existed in this module).
const eIntr: int = 4

// A large but PROVABLY BOUNDED retry budget (Power of 10 rule 2) for a `read`
// interrupted by a signal (`EINTR`): POSIX says retry, and under concurrent
// process/signal load (#2980) more than a handful of interruptions across one
// file's read is plausible, so this is generous rather than tight.
const maxReadAllRetries: int = 1000

extern fn __error(): *i32

// The errno of the `read` that just failed. Read IMMEDIATELY after the call
// that set it (`rtFsReadAll` does), before anything else touches libSystem.
@nosplit fn readAllErrno(): int {
  let p = __error()
  return int(*p)
}

// `bit_rt_fs_read_all`: the whole file as a fresh string, sized by `lseek` to the
// end and back. A seek error, an allocation failure and a genuine empty file
// all currently yield the empty string -- deliberately for the genuine-empty
// case, conflated with the other two only because `string` has no sentinel
// that could tell them apart (see the `end < 0` / `s == 0` branches' comments,
// #2996).
//
// A short read NEVER fabricates content (#2990). `read` returning `n <= 0`
// before `off` reaches `end` is one of three things: (a) `EINTR` — a signal
// landed mid-call, not a failure, retried below; (b) `n == 0` — the file
// shrank between the `lseek` probe and this read (a TOCTOU race, not this
// runtime's error to report); (c) any other negative result — a genuine I/O
// error. (b) and (c) both stop the read and return the string TRIMMED to the
// `off` bytes actually verified read. The old code returned the full-length
// string with its un-filled tail left as the zero bytes `rtStrAlloc` clears
// memory to — indistinguishable from a file that genuinely contains NULs,
// which made this silent corruption rather than an honest short read.
//
// BOUNDED (Power of 10 rule 2): every iteration that continues the loop
// advances `off` by at least 1 (a successful partial read) OR advances
// `retries` by 1 (an `EINTR` retry) — both counters are capped by the loop
// condition itself, so the loop runs at most `end + maxReadAllRetries` times.
export @nosplit @symbol("bit_rt_fs_read_all") fn rtFsReadAll(fd: int): int {
  let end = int(lseek(i32(fd), i64(0), i32(seekEnd)))
  if (end < 0) {
    // `lseek` FAILED (fd is a pipe, a closed descriptor, etc.) -- a genuine
    // I/O error, unambiguous: lseek's own failure return is negative and a
    // file's size never is (#2996). Currently indistinguishable from the
    // `end == 0` branch below to a CALLER, because `bit_rt_fs_read_all`
    // returns `string`, and `string` has no nil sentinel to carry the
    // difference (SPEC SS5.7/SS13.4: `string`'s zero value is the empty
    // string, not `nil` -- unlike the reference types that do have one).
    // Surfacing this to a caller needs an out-of-band channel, exactly what
    // #2994 added (`bit_rt_fs_read_all_failed`, a companion query symbol) and
    // was reverted for: `std/fs` sits on `tools/build/artifacts.bit`'s import
    // path, and the pinned stage0's `libbitrt.a` predates that symbol, so
    // linking `tools/build/artifacts.bit` with stage0 died E0078 on a clean
    // tree. Re-adding it needs a stage0 repin first (or a design that adds no
    // new `std/fs`-reachable ABI surface) -- tracked on #2996, not fixed here.
    return emptyStr()
  }
  if (end == 0) {
    // `lseek` succeeded and reported 0: a genuinely empty file. Unambiguous,
    // and this is the correct, safe result -- `string`'s zero value IS the
    // empty string (SPEC SS13.4), so no sentinel is needed or possible here.
    return emptyStr()
  }
  lseek(i32(fd), i64(0), i32(seekSet))
  let s = rtStrAlloc(end)
  if (s == 0) {
    // Allocation failed for a file we already know is non-empty (`end > 0`
    // above). A genuine failure, distinct in cause from both branches above,
    // but conflated with them in the return value for the identical reason:
    // no nil sentinel exists for `string` (#2996). Same blocker, same fix
    // shape as the `end < 0` branch's comment.
    return emptyStr()
  }
  let base = strData(s)
  let off = 0
  let retries = 0
  while (off < end && retries < maxReadAllRetries) {
    // Bracketed for the same reason `rtFsRead` above is (#2207, and #2990's
    // investigation found this call was NOT bracketed): `fd` may be a pipe or
    // a slow device, so this can block indefinitely, and `base` points into a
    // live string held across the call, so `syscall`, not `blocked`.
    gcSyscallBegin()
    let n = int(read(i32(fd), u8At(base + off), i64(end - off)))
    let err = 0
    if (n < 0) {
      err = readAllErrno()
    }
    gcSyscallEnd()
    if (n > 0) {
      off = off + n
    } else if (n < 0 && err == eIntr) {
      retries = retries + 1
    } else {
      return rtStringSlice(s, 0, off)
    }
  }
  if (off < end) {
    return rtStringSlice(s, 0, off)
  }
  return s
}

// `bit_rt_fs_write`: write all of `s`'s bytes to `fd`. Byte count, or -1.
// `write` is ../darwin/io.bit's module-scoped extern.
//
// BOUNDED (Power of 10 rule 2): `off` rises by at least 1 each iteration.
export @nosplit @symbol("bit_rt_fs_write") fn rtFsWrite(fd: int, s: int): int {
  let total = strLenOf(s)
  let base = strData(s)
  let off = 0
  while (off < total) {
    // Bracketed for the same reason as `rtFsRead` above (#2207): a write to a
    // full pipe or a slow tty blocks until the far end drains, and an
    // unbracketed block spins whichever thread wants a stop-the-world. `base`
    // points into a live string held across the call, so `syscall`, not
    // `blocked`.
    gcSyscallBegin()
    let n = int(write(i32(fd), u8At(base + off), i64(total - off)))
    gcSyscallEnd()
    if (n < 0) {
      return 0 - 1
    }
    if (n == 0) {
      return off
    }
    off = off + n
  }
  return off
}

// `bit_rt_fs_chmod`: set `path`'s permission bits to `mode`. 0 on success, -1 on
// any error.
export @nosplit @symbol("bit_rt_fs_chmod") fn rtFsChmod(path: int, mode: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (int(chmod(u8At(p), i32(mode))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_close`: close `fd`. Always reports success. See the #1436 note above.
export @nosplit @symbol("bit_rt_fs_close") fn rtFsClose(fd: int): int {
  close(i32(fd))
  return 0
}
