// Darwin filesystem provider for the SEAM 3 remainder (#1606): the 13
// `bit_rt_fs_*` ABI wrappers (ABI.md §14) and the libSystem calls behind them.
// This is the Bit form of `runtime/root/`'s `fs_*` block plus the Darwin
// branch of the deleted native runtime's `openFd`/`readFd`/`writeFd`/`closeFd`/
// `mkdirAt`/`removeAt`/`chmodAt`/`fileSize`/`listDir`/`statPath` — lineage
// only; no surviving `runtime/sched/` path carries these names today.
//
// Goes through libSystem (§11.7) rather than raw traps: Apple publishes no stable
// syscall numbers (../darwin/io.bit). KEPT DELIBERATELY IN THE SAME FUNCTION-FOR-
// FUNCTION SHAPE AS ../linux/fs.bit, so a divergence between the two is a real
// platform difference rather than a stylistic one. See ../fs.bit's header for why
// each provider is self-contained rather than the netabi extern shape.
//
// EVERY `open` FLAG, PERMISSION AND `dirent` OFFSET BELOW WAS READ OUT OF THE
// THE macOS SDK HEADERS (`<fcntl.h>`'s `O_*`, `<dirent.h>`'s `dirent` structure),
// NOT FROM MEMORY. The
// Darwin `O` bits DIFFER FROM LINUX (O_CREAT=0x0200 vs 0o100, O_TRUNC=0x0400 vs
// 0o1000, O_APPEND=0x0008 vs 0o2000) and the `dirent` name field sits at a
// different offset — a wrong constant is a silent wrong-behaviour, never a
// compile error.

// checkedPathZ/checkedPathZ2/cstrLen/emptyStr/fsScratchSlot/isDotName/strData/
// wordsPathZ pulled up to core (#2551,
// docs/development/provider-duplication.md's `root` -> `fs.bit` section): no
// OS call in any of their bodies. `fsPathZ`/`fsPathZ2` are NOT imported here
// any more: `checkedPathZ`/`checkedPathZ2`, their only callers in this file,
// moved to core too, and reach them there directly (same module, no
// import). `fsPathZ` is still needed in this MODULE by ./os.bit's
// `rtOsRun`/etc, which now imports it directly. `fsPathZ2` has no remaining
// caller anywhere in this module. `rtFsReadAllFailedSet`/`strLenOf`/
// `fsLinkMaxPath` are NOT imported here either: ./fsrw.bit, their only
// caller in this module, now imports them directly.
import {
  rtStrAlloc, rtStringSlice,
  checkedPathZ, checkedPathZ2, cstrLen, emptyStr, fsScratchSlot, isDotName,
  strData, wordsPathZ,
} from "../../root"
// `gcSyscallBegin`/`gcSyscallEnd` are NOT imported here: ./os.bit already imports
// them, and a sibling .bit file is the same module, so a second import is E0042.
import { loadByte, storeByte } from "../../gc"
// `taskAt`/`wkId`/`schedCurrentWorker` are NOT imported here: ./bootworker.bit
// and ./time.bit already import them (same module). `schedMaxWorkers` no
// longer needed here: its only caller, `fsScratchSlot`, moved to core (#2551).

// `write`, `strPtr`, `strLen` and `loadWord` are already declared/imported by this
// module's sibling ../darwin/io.bit (module-scoped in Bit), so they are reused,
// not re-declared — a redeclaration is E0042.

// libSystem filesystem calls. Only C-representable types cross the boundary
// (§11.7): a path/buffer travels as `*u8` and counts as `i64`.
//
// `open` IS VARIADIC (`int open(const char *, int, ...)`) and its `mode` is the
// single variadic argument. On arm64 Apple every variadic argument is passed on
// the STACK regardless of how many named ones precede, so `mode` must land there:
// `modeReg` fills x2 and the five pads fill x3–x7 (all ignored by the callee),
// and `modeStack` is the 9th argument, which lands on the stack where `open`
// reads its vararg. Callers pass `mode` in both slots — the register copy is
// inert. This is the exact device net/darwin/sock.bit uses for `fcntl`.
extern fn open(
  path: *u8,
  flags: i32,
  modeReg: i64,
  pad3: i64,
  pad4: i64,
  pad5: i64,
  pad6: i64,
  pad7: i64,
  modeStack: i64,
): i32
extern fn read(fd: i32, buf: *u8, n: i64): i64
extern fn lseek(fd: i32, offset: i64, whence: i32): i64
extern fn mkdir(path: *u8, mode: i32): i32
extern fn unlink(path: *u8): i32
extern fn rename(old: *u8, new: *u8): i32
extern fn rmdir(path: *u8): i32
extern fn chmod(path: *u8, mode: i32): i32
extern fn opendir(path: *u8): *u8
extern fn readdir(dirp: *u8): *u8
extern fn closedir(dirp: *u8): i32
extern fn access(path: *u8, mode: i32): i32
// `readlink` is the SYMLINK PROBE, not a way to read a link's target here: it is
// the one libSystem call that asks about the LINK rather than what the link
// resolves to, and it fails with `EINVAL` on everything that is not one. See
// `rtFsIsSymlinkZ` for why that is preferred over `lstat` + `S_IFLNK`.
extern fn readlink(path: *u8, buf: *u8, bufsize: i64): i64
// `stat`/`lstat` (#2153): fill a `stat` structure at `buf`, following/not
// following a trailing symlink. Both names are already admitted by the
// compiler's libSystem membership table (`compiler/machosyms.bit`). A failed
// call sets a POSITIVE errno reachable through `__error()` (declared further
// down, reused by `fillStat` below via `readAllErrno()`) — unlike Linux's raw
// syscall convention, whose failing return IS `-errno` directly.
//
// PASS 1 OF 2, NO `stdlib/` CONSUMER YET (the #3065 pattern): #2153 was
// reverted at `0dd25c35` because the pinned stage0 that compiles
// `tools/build/` links its OWN frozen release runtime, which has never
// shipped these symbols — a `stdlib/` reference breaks the driver bootstrap
// with E0078 on every fresh clone until a release ships this commit and the
// pin moves. Verified against `bit-out/stage0/`'s bundled archive first.
extern fn stat(path: *u8, buf: *u8): i32
extern fn lstat(path: *u8, buf: *u8): i32

// `close` GOES THROUGH libSystem HERE AND CARRIES A KNOWN #1436 HAZARD. Under the
// SEED compiler (which builds this runtime today and links every user binary
// until G3) `extern function close` binds `_close` and works. Under the
// SELF-HOSTED compiler, #1436 makes it emit only `_close$NOCANCEL` and drop the
// `_close` import, SIGSEGV at run time — the defect sched/darwin/poll.bit sidesteps
// by routing through libbitrt's `bit_rt_fs_close`. That workaround CANNOT apply
// here: this IS `bit_rt_fs_close`'s implementation once G2/G3 rename the wrapper.
// So the Darwin close path is blocked on #1436 landing before the archive swap
// (#1369) — recorded, not fixable inside this port. It does not affect the
// freestanding-emit or rootpins proofs, which never execute this body.
extern fn close(fd: i32): i32

// Darwin `O_*` flags (`<sys/fcntl.h>`): O_WRONLY=1, O_RDWR=2, O_CREAT=0x0200=512,
// O_TRUNC=0x0400=1024, O_APPEND=0x0008=8. A read open is O_RDONLY=0. Default
// perms: file 0o644=420, directory 0o755=493.
const oWrite: int = 1537
const oAppend: int = 521
// O_RDWR|O_CREAT, deliberately WITHOUT O_TRUNC (#3533) -- create-if-absent,
// read-write, never destroys existing content on open.
const oReadWrite: int = 514
const permFile: int = 420
const permDir: int = 493

// SEEK_END / SEEK_SET for `lseek` (universal: 2 and 0).
const seekEnd: int = 2
const seekSet: int = 0

// F_OK (`<unistd.h>`): existence only, no read/write/execute bit — `access`
// needs no permission on the target itself, only search permission on its
// parent directories, unlike `open`/`opendir` (#2114).
const fOk: int = 0

// Darwin `dirent` structure (`<sys/dirent.h>`): ino(u64)@0, seekoff(u64)@8, reclen(u16)@16,
// namlen(u16)@18, type(u8)@20, name@21. `readdir` on arm64 returns this 64-bit
// -inode layout directly (no `$INODE64` variant — that is x86_64 only).
const direntNameOff: int = 21

// The `readlink` sink for the symlink probe. ONE WORD PER SLOT, deliberately:
// the probe reads only whether the call SUCCEEDED, never the target's text,
// so the buffer exists solely because a `bufsiz` of 0 is not portable (POSIX
// leaves it unspecified; Linux answers EINVAL). (`fsScratchSlots` + 1) slots
// of one word each = 33 words, one per worker plus the fallback; per-worker
// anyway (rather than left shared) so two concurrent probes' writes into it
// can never race each other at the C level even though neither ever reads
// the content back. A scalar array so the collector never scans it (rule 1).
let fsLinkBuf: [33]i64
const fsLinkBufBytes: int = 1

// `stat`/`lstat` sink for `bit_rt_fs_stat_w`/`bit_rt_fs_lstat_w` (#2153).
// `stat` structure on aarch64-macos (`<sys/stat.h>`'s 64-bit-inode form, the
// only Darwin target this runtime supports): `sizeof == 144`, measured with
// `offsetof` via native `clang -arch arm64` on this machine, not transcribed.
// 18 words = 144 bytes. PER-WORKER SLOTS, same shape as `fsLinkBuf`/
// `fsLinkPathBuf` above (#3274): (`fsScratchSlots` + 1) * 18 = 594 words, one
// region per worker plus the fallback. Scalar array, never GC-scanned (rule 1).
let fsStatBuf: [594]i64
const fsStatSlotWords: int = 18

// Field offsets inside ONE slot, same `offsetof` measurement: `st_mode@4`
// (u16, the one field not 8-byte aligned — hence `loadU16LE` not `loadWord`),
// `st_size@96`, `st_mtimespec.tv_sec@48`.
const statModeOff: int = 4
const statSizeOff: int = 96
const statMtimeSecOff: int = 48

// `S_IFMT`/`S_IFDIR`/`S_IFLNK` (`<sys/stat.h>`): POSIX-standard, confirmed
// identical to ../linux/fs.bit's copy by the same measurement pass.
const sIfmt: int = 61440  // 0o170000
const sIfdir: int = 16384 // 0o040000
const sIflnk: int = 40960 // 0o120000

// ---------------------------------------------------------------------------
// Pointer / string glue
// ---------------------------------------------------------------------------

// A raw byte pointer at `addr` — `base + addr` on a nil `*u8`, the project idiom
// (root/darwin/io.bit's `rootWriteAll`).
@nosplit fn u8At(addr: int): *u8 {
  let base: *u8 = nil
  return base + addr
}

// ---------------------------------------------------------------------------
// libSystem calls (the runtime/sched/ helpers)
// ---------------------------------------------------------------------------

// Open `pathPtr` (NUL-terminated): mode 0=read-only, 1=create+truncate write-only,
// 2=create+append write-only, 3=create+read-write, no truncate (#3533). Returns
// the fd or -1.
@nosplit fn sysOpen(pathPtr: int, mode: int): int {
  let flags = 0
  if (mode == 1) {
    flags = oWrite
  }
  if (mode == 2) {
    flags = oAppend
  }
  if (mode == 3) {
    flags = oReadWrite
  }
  let fd = int(open(u8At(pathPtr), i32(flags), i64(permFile), 0, 0, 0, 0, 0, i64(permFile)))
  if (fd < 0) {
    return 0 - 1
  }
  return fd
}

// List `pathPtr`'s entries, snprintf-shaped: write up to `outCap` bytes of
// NUL-terminated names (`.`/`..` omitted) to `outPtr` and return the TOTAL bytes
// needed (a `outCap == 0` call measures), or -1 if the directory cannot be opened.
// The readdir loop is `runtime/sched/`'s `listDir` on Darwin.
//
// BOUNDED: `readdir` returns nil at end of directory (or on error, which callers
// treats identically), and a directory has finitely many entries.
@nosplit fn sysList(pathPtr: int, outPtr: int, outCap: int): int {
  let dir = opendir(u8At(pathPtr))
  if (int(dir) == 0) {
    return 0 - 1
  }
  let total = 0
  let done = false
  while (!done) {
    let ent = readdir(dir)
    if (int(ent) == 0) {
      done = true
    } else {
      let nameAddr = int(ent) + direntNameOff
      let nlen = cstrLen(nameAddr)
      if (!isDotName(nameAddr, nlen)) {
        let j = 0
        while (j < nlen) {
          if (total + j < outCap) {
            storeByte(outPtr + total + j, loadByte(nameAddr + j))
          }
          j = j + 1
        }
        if (total + nlen < outCap) {
          storeByte(outPtr + total + nlen, 0)
        }
        total = total + nlen + 1
      }
    }
  }
  let _ = closedir(dir)
  return total
}

// ---------------------------------------------------------------------------
// The exported ABI surface (ABI.md §14) — bare `bit_rt_fs_*` pins, `rtFs*`
// names to avoid shadowing the `fsOpen`/`fsRead`/… builtins. See ../linux/fs.bit.
// ---------------------------------------------------------------------------

// Whether the already-copied C path `p` names a directory. Factored out of
// `rtFsIsDir` so `rtFsOpen` can reuse it without a second `checkedPathZ` copy.
@nosplit fn isDirAtP(p: int): bool {
  let dir = opendir(u8At(p))
  if (int(dir) == 0) {
    return false
  }
  let _ = closedir(dir)
  return true
}

// `bit_rt_fs_open`: open `path` read-only or create+truncate write-only. fd or
// -1. Rejects a directory (#2149): `open(2)` on a directory succeeds with
// `O_RDONLY` and no `O_DIRECTORY`/`fstat` guard, handing out a `File` nothing
// can actually read. Without this guard, `readAll`'s first `read()` on that
// fd would fail immediately (n < 0, not `EINTR`), and post-#2990 (see
// `rtFsReadAll`, now in ./fsrw.bit) that returns the empty string trimmed to
// the 0 bytes actually read -- not the zero-padded full-length string the
// old code used to fabricate. Checked here anyway, once, as defense in depth
// against a future platform's directory-fd read behaving differently, so
// every caller (`readFile`, `open`) fails the same way a missing path does.
export @nosplit @symbol("bit_rt_fs_open") fn rtFsOpen(path: int, write: bool): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (isDirAtP(p)) {
    return 0 - 1
  }
  let mode = 0
  if (write) {
    mode = 1
  }
  return sysOpen(p, mode)
}

// `bit_rt_fs_append`: open `path` create+append write-only. fd or -1.
export @nosplit @symbol("bit_rt_fs_append") fn rtFsAppend(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  return sysOpen(p, 2)
}

// `bit_rt_fs_open_rw_w` (#3533): open the `n` path bytes at `words`
// create+read-write, WITHOUT truncating any existing content -- `sysOpen`
// mode 3. Packed-bytes `(words, n)`, like `rtFsIsSymlinkW`/`rtFsStatW` above
// -- NOT a Bit `string` object: `std/fs`'s stdlib wrapper (once it can land,
// #3536's stage0-bootstrap cycle applies identically here) reaches a runtime
// symbol only through an `extern function` (SPEC §11.7), which admits no
// `string`, so this cannot be a compiler-recognized `fsOpen`-shaped
// primitive the way `rtFsOpen`/`rtFsAppend` are.
//
// The `pkg/kv`-shaped consumer this exists for opens its store file ONCE and
// then `readAt`/`writeAt`s arbitrary pages on that same fd for the process's
// life; neither `rtFsOpen` (read-only xor create+truncate write-only) nor
// `rtFsAppend` (O_APPEND, which also breaks positional writes on Linux) can
// produce that fd. Unlike `rtFsOpen`'s read-only path, no extra directory
// guard is needed: `open(2)` on both Darwin and Linux already fails a
// directory with EISDIR whenever O_WRONLY or O_RDWR is requested, and
// `sysOpen` already turns any negative syscall return into -1. fd or -1.
export @nosplit @symbol("bit_rt_fs_open_rw_w") fn rtFsOpenReadWriteW(words: int, n: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  return sysOpen(p, 3)
}

// `bit_rt_fs_exists`: whether `path` names anything at all, per its own
// `std/fs` doc comment. `access(F_OK)` is the direct probe for exactly that
// question and needs no permission on the target — unlike the old
// `opendir`-then-`open` probe, which reported a mode-000 file (or a
// directory an unrelated fd-exhausted process couldn't open) as ABSENT
// instead of ACCESS-DENIED (#2114). Also drops the fd allocation the old
// probe needed, so `exists` can no longer contribute to fd exhaustion.
export @nosplit @symbol("bit_rt_fs_exists") fn rtFsExists(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  return int(access(u8At(p), i32(fOk))) == 0
}

// `bit_rt_fs_is_dir`: false for a missing path or a non-directory. `opendir`
// distinguishes a directory directly.
export @nosplit @symbol("bit_rt_fs_is_dir") fn rtFsIsDir(path: int): bool {
  let p = checkedPathZ(path)
  if (p == 0) {
    return false
  }
  return isDirAtP(p)
}

// `bit_rt_fs_is_symlink_w`: whether the `n` path bytes at `words` name a
// symbolic LINK itself, asked of the link and never of what it resolves to.
// `false` for a missing path, a non-link, and a path that cannot be probed.
//
// THE ONLY `bit_rt_fs_*` ENTRY POINT NOT TAKING A BIT `string` OBJECT — hence
// the `_w` suffix, for the raw `words`/`n` pair `wordsPathZ` above copies. It
// has to be: its caller is `std/fs`, which can reach a runtime symbol only
// through an `extern function` (SPEC §11.7), and §11.7 admits no `string`
// across that boundary.
//
// `readlink(2)` AND NOT `lstat` + `S_IFLNK`. Both answer the question; only one
// of them hard-codes a `stat` structure layout, and this file's header note is
// explicit that a wrong offset there is a silent wrong ANSWER rather than a
// build error. `readlink` needs no layout at all: it succeeds on a symbolic
// link and fails with `EINVAL` on everything else. A DANGLING link still
// answers true, which is correct — the link exists whether its target does or
// not, and it is exactly the link a walk must refuse to descend.
export @nosplit @symbol("bit_rt_fs_is_symlink_w") fn rtFsIsSymlinkW(
  words: int,
  n: int,
): bool {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return false
  }
  // One word (8 bytes) per slot, matching `fsLinkBuf`'s `[33]i64` declaration
  // — NOT `fsLinkBufBytes`, which is the syscall's `bufsiz` cap (1), a
  // different number that happens to also bound how much of the slot the
  // kernel may write.
  let linkBuf = u8At(int(ptrOf(fsLinkBuf)) + fsScratchSlot() * 8)
  return int(readlink(u8At(p), linkBuf, i64(fsLinkBufBytes))) >= 0
}

// The little-endian u16 at `addr` (`st_mode`'s width, not 8-byte aligned).
// Same technique ../linux/fs.bit's `loadU16` uses for `dirent64`.
@nosplit fn loadU16LE(addr: int): int {
  return loadByte(addr) + loadByte(addr + 1) * 256
}

// `stat(2)` (`follow`) or `lstat(2)` (`!follow`) on the already-copied C path
// `p`, filling `out` (5 words: size, mtime seconds, mode, isDir, isSymlink —
// ABI.md §14) from this worker's `fsStatBuf` slot. 0 on success, `-errno` on
// failure (#2153, #2343's convention) — no `stdlib/` consumer yet, see above.
@nosplit fn fillStat(p: int, out: int, follow: bool): int {
  let rc = 0
  let slotBase = int(ptrOf(fsStatBuf)) + fsScratchSlot() * fsStatSlotWords * 8
  let buf = u8At(slotBase)
  if (follow) {
    rc = int(stat(u8At(p), buf))
  } else {
    rc = int(lstat(u8At(p), buf))
  }
  if (rc < 0) {
    return 0 - readAllErrno()
  }
  let mode = loadU16LE(slotBase + statModeOff)
  storeWord(out, loadWord(slotBase + statSizeOff))
  storeWord(out + 8, loadWord(slotBase + statMtimeSecOff))
  storeWord(out + 16, mode & 4095) // low 12 bits: perm + setuid/setgid/sticky
  let isDir = 0
  if ((mode & sIfmt) == sIfdir) {
    isDir = 1
  }
  storeWord(out + 24, isDir)
  let isSymlink = 0
  if ((mode & sIfmt) == sIflnk) {
    isSymlink = 1
  }
  storeWord(out + 32, isSymlink)
  return 0
}

// `bit_rt_fs_stat_w`: `stat(2)`-shaped — FOLLOWS a trailing symlink, so
// `out`'s isSymlink word is always 0. `words`/`n` are `wordsPathZ`'s
// word-per-byte path encoding; `out` is the caller's 5-word sink. No
// `stdlib/` caller yet — see the extern declarations' note above.
export @nosplit @symbol("bit_rt_fs_stat_w") fn rtFsStatW(words: int, n: int, out: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 2 // ENOENT-shaped: same "rejected path reads as absent" contract checkedPathZ's callers already carry
  }
  return fillStat(p, out, true)
}

// `bit_rt_fs_lstat_w`: `lstat(2)`-shaped — does NOT follow a trailing
// symlink, so `out`'s isSymlink word reflects `words` itself.
export @nosplit @symbol("bit_rt_fs_lstat_w") fn rtFsLstatW(words: int, n: int, out: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 2
  }
  return fillStat(p, out, false)
}

// `bit_rt_fs_mkdir`: 0 on success, -1 on failure, mode 0o755.
export @nosplit @symbol("bit_rt_fs_mkdir") fn rtFsMkdir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (int(mkdir(u8At(p), i32(permDir))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_remove`: 0 on success, -1 on failure. `unlink` then `rmdir`.
export @nosplit @symbol("bit_rt_fs_remove") fn rtFsRemove(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (int(unlink(u8At(p))) == 0) {
    return 0
  }
  if (int(rmdir(u8At(p))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_rename` (#2712): rename `oldPath` to `newPath`. 0 on success, -1
// on failure — the exact shape `bit_rt_fs_remove` above already returns,
// copied rather than invented, per the ticket's own instruction. `oldPath` is
// encoded through `checkedPathZ` into `fsPathBuf` and `newPath` through
// `checkedPathZ2` into `fsPathBuf2`: TWO DIFFERENT buffer addresses, so the
// two `*u8` pointers `rename` receives can never alias — see this file's
// `fsPathBuf2` note in ../fs.bit for why one buffer would be wrong here.
export @nosplit @symbol("bit_rt_fs_rename") fn rtFsRename(oldPath: int, newPath: int): int {
  let op = checkedPathZ(oldPath)
  if (op == 0) {
    return 0 - 1
  }
  let np = checkedPathZ2(newPath)
  if (np == 0) {
    return 0 - 1
  }
  if (int(rename(u8At(op), u8At(np))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_list_dir`: `path`'s entries, NUL-terminated, `.`/`..` omitted. Empty
// when the directory is empty or unreadable. Two passes (measure, then fill a
// string sized to it), trimmed to what pass 2 wrote. See ../linux/fs.bit.
export @nosplit @symbol("bit_rt_fs_list_dir") fn rtFsListDir(path: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return emptyStr()
  }
  let needed = sysList(p, 0, 0)
  if (needed <= 0) {
    return emptyStr()
  }
  let out = rtStrAlloc(needed)
  if (out == 0) {
    return emptyStr()
  }
  let got = sysList(p, strData(out), needed)
  if (got <= 0) {
    return emptyStr()
  }
  if (got > needed) {
    got = needed
  }
  return rtStringSlice(out, 0, got)
}

extern fn __error(): *i32

// The errno of the `read` that just failed. Read IMMEDIATELY after the call
// that set it (`rtFsReadAll` does), before anything else touches libSystem.
@nosplit fn readAllErrno(): int {
  let p = __error()
  return int(*p)
}

// `bit_rt_fs_chmod`: set `path`'s permission bits to `mode`. 0 on success, -1 on
// any error.
export @nosplit @symbol("bit_rt_fs_chmod") fn rtFsChmod(path: int, mode: int): int {
  let p = checkedPathZ(path)
  if (p == 0) {
    return 0 - 1
  }
  if (int(chmod(u8At(p), i32(mode))) == 0) {
    return 0
  }
  return 0 - 1
}

// `bit_rt_fs_close`: close `fd`. Always reports success. See the #1436 note above.
export @nosplit @symbol("bit_rt_fs_close") fn rtFsClose(fd: int): int {
  let _ = close(i32(fd))
  return 0
}

// `bit_rt_fs_sync_dir_w` (ABI.md §14, #4017, PASS 1 OF 2 -- no `stdlib/`
// caller yet, see the #3065 pattern this module's other pass-1 landings
// already use). Packed-bytes `(words, n)`, like `rtFsOpenReadWriteW` above --
// a path-taking primitive with no compiler-builtin call form must take this
// shape rather than the compiler-recognized `path: int` `fsOpen`/`fsRead`
// convention, since §11.7 admits no `string` across a plain `extern fn`
// boundary and this one has no reason to earn a new compiler builtin.
// Durability for a directory ENTRY, not a file's contents: creating a file
// and `bit_rt_fs_sync`ing it only guarantees that file's OWN blocks survive
// a crash -- on ext4 and several other filesystems the directory entry that
// gives the file its name is separate metadata and needs its own fsync,
// which is why SQLite fsyncs its database's containing directory after
// creating the journal file. Opens the directory read-only (a directory
// opens fine `O_RDONLY`, same as `rtFsIsDir`'s `opendir` probe relies on
// elsewhere in this file), reuses `rtFsSync` (./fsrw.bit, same module, no
// import needed) for the fsync itself -- a directory fd answers the
// identical `F_FULLFSYNC`/`ENOTSUP`-fallback `fcntl` `rtFsSync` already
// implements for a regular file -- then closes via `rtFsClose` above. 0 on
// success, -1 if the path is malformed or either the open or the fsync
// fails; the close always runs once open succeeds, regardless of the fsync
// result, matching `rtFsClose`'s own always-succeeds contract.
export @nosplit @symbol("bit_rt_fs_sync_dir_w") fn rtFsSyncDirW(words: int, n: int): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  let fd = sysOpen(p, 0)
  if (fd < 0) {
    return 0 - 1
  }
  let rc = rtFsSync(fd)
  let _ = rtFsClose(fd)
  return rc
}
