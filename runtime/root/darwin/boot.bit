// Darwin process entry and boot sequence for the SEAM 3 remainder (#1608): the
// `machoMain` entry and `boot` — the Bit form of `runtime/root/`'s
// `machoMain`/`boot` (runtime/root/:1974-2011, 2145). This file OWNS the process from
// dyld's transfer of control until the collector and scheduler are up,
// `bit_main` has run as the first green thread, and the runtime is torn down.
//
// ---------------------------------------------------------------------------
// KEPT FUNCTION-FOR-FUNCTION WITH ../linux/boot.bit
// ---------------------------------------------------------------------------
//
// `boot` here is the same sequence as ../linux/boot.bit's, so a divergence
// between the two is a real platform difference rather than a stylistic one —
// exactly as ./signal.bit is kept in lockstep with ../linux/signal.bit. The two
// boots differ in precisely two places:
//
//   1. THE ENTRY ABI. Linux `_start` is a `@naked` stub that reads the raw
//      initial stack the kernel built and tail-calls `rtStartMain`. Darwin has
//      no such stub: dyld's `LC_MAIN` calls `machoMain` with the ordinary C
//      `main(argc, argv, envp)` ABI — args in registers, a valid aligned frame
//      already set up — and calls `exit()` with the returned code. So there is
//      no naked body and no stack walk here; `machoMain` is an ordinary function.
//
//   2. NO auxv, NO static-TLS install. Darwin has no ELF auxiliary vector, and
//      libSystem's initializer has already installed the main thread's TLV/
//      pthread state before dyld transfers control (the runtime reaches TLS
//      through libSystem on macOS — ABI.md §9). So `machoMain` captures no auxv,
//      unlike the Linux entry, and needs none — the auxv entanglement the Linux
//      file documents does not exist on this platform.
//
// The seams `boot` binds are Darwin's (`mmap`/`pthread`/`clock` via libSystem
// `extern function`, §11.7), reached by ordinary import. Like ../linux/boot.bit
// THIS MODULE EMITS `--freestanding` (#1628), so it builds no function VALUE —
// every seam is bound by direct call — and every cross-module callee it names is
// `@symbol`-pinned. See ../linux/boot.bit's header for the full argument.
//
// Nothing here is `@nosplit`: `boot` allocates (maps the heap) and runs before
// the stack-guard machinery, and `@nosplit` rejects `extern function` (E0075).
// `mainTrampoline` calls the user's `bit_main`, arbitrary work that must reach
// safepoints, so it is not `@nosplit` either.
//
// ---------------------------------------------------------------------------
// THE BOOT THREAD AND THE RENDEZVOUS (#1660) — kept identical in ../linux/boot.bit
// ---------------------------------------------------------------------------
//
// This is the ONE place the Bit boot diverges from `runtime/root/`'s by construction
// rather than by choice, so the reasoning is recorded here in full.
//
// The boot thread never appears in the mutator registry: code
// carries no back-edge safepoint polls, so that thread cannot take a safepoint,
// never calls `currentMutator`, and its `World` slot stays `mFree` — which
// `stoppedFor` counts as stopped. `boot` here is ordinary Bit, so codegen puts a
// `bl bit_rt_safepoint` on step 7's back edge and on `joinWorker`'s. The thread
// therefore DOES claim a slot and DOES go `mRunning`. It then sleeps up to 1 ms
// per iteration while the collector burns its whole `stwSpinBound` (1e6) waiting
// for it, so the rendezvous expires and the collection is abandoned: 165-168
// abandoned collections in a measured 200k-collection `BIT_GC=stress` run.
//
// THE FIX IS NOT "DO NOT REGISTER". A thread that reaches safepoints must be
// visible to the rendezvous for as long as it can run Bit code, and suppressing
// its poll is the exact shape #1650/#1651 had to delete (`schedCurrentTask() == 0`
// suppressed a worker's own OS-thread stack, whose closure cells were then swept
// while live). Nor is it "poll promptly instead of sleeping": that pegs a core
// for the whole program.
//
// It is the ABI's own `blocked` contract (ABI.md §5), applied exactly where
// `runtime/sched/` applies it to its idle sleep: bracket THE SLEEP, and nothing else,
// with `bit_rt_gc_blocking_begin`/`_end`. `blocked` means "holds no live Bit
// reference for the whole bracketed region", and the collector then passes the
// slot without waiting for it and without scanning its stack.
//
// THE PRECONDITION HOLDS, AND IT IS THE WHOLE SAFETY ARGUMENT — a partial root
// enumeration sweeps live objects, so this is not an optimisation to hand-wave.
// `boot` allocates NOTHING on the managed heap, at any point: the heap, the
// scheduler block, the task block, the channel reserve and the stats buffer are
// `mapPages` mappings and module-state arrays (untraced scalars, rule 1), the
// GC config is parsed straight off `environ` as raw pointers
// (`../rootconfig.bit`'s `gcEnvValuePtr`/`gcCstrUsize` build no string), and
// `statsReport` writes packed byte constants into `statsBuf` for the reason its
// own comment gives. Every local live across the bracketed sleep is an `int` or
// a `*i64` into module state, i.e. outside the heap bounds `gcMarkConservative`
// tests. The one managed object this file's control flow ever creates belongs to
// `bit_main`, which runs on the WORKER's green task, not here.
//
// Outside the bracket the thread is `mRunning` and polls normally, which is what
// keeps the registration honest: the running window is the handful of
// instructions between the sleep returning and the loop's back edge, and the
// poll there publishes a real snapshot as any mutator does.

import { mapPages, unmapPages } from "../../alloc/darwin"
import { threadStart, threadRelease } from "../../thread/darwin"
import { schedStartArm } from "../../thread"
import { parkSleepNs } from "../../park/darwin"
import { parkMinBackoffNs, parkNextBackoff } from "../../park"
import {
  schedInit, schedTaskInit, schedRegister, schedSpawn, schedShutdown,
  schedWorkerAt, workerStepStop, WORKER_MAX_STEPS, scStopping,
  schedFindWorkAt, schedWorkerStepAt, schedSetPollFd,
  schedTaskExit, dqPushBottom, taskAt, taskWords,
  schedStackBytes, schedStackAligned, schedRegisterBigStack, wkDeque,
  schedSpawnTrampoline, taskSpawnEntry,
  schedIdleSeq, schedIdlePark, wkId,
} from "../../sched"
// The netpoller provider (#1673). `runtime/sched` may not import it — kqueue
// against epoll is the platform split the parent module exists to stay clear of
// — so the binding is made here, in the leaf that is already per-platform, by
// direct call to the three pinned entries. ../linux/boot.bit binds the epoll
// twin at exactly the same three points.
import { pollCreate, pollClose, pollDrain } from "../../sched/darwin"
import { rootBindMemory, rootInit, rootConfigureFromEnv, rootEnvMarkStack, rootEnvVerbose, rootEnvWorkers, rootStatOom, osSetArgs } from "../../root"
import { rootGcAddr, rootWorldAddr } from "../../root"
import { chanBootBind } from "../../chan"
import { gcBlockingBegin, gcBlockingEnd, gcThreadEnter, gcThreadExit } from "../../gc"
import { stwBind, stwCollections, stwSwept, stwLiveObjects, stwAbandonedCount } from "../../stw"
import { stwBadOffsets } from "../../stw"

// `parkMonoNs` (../../park/darwin) is already imported by sibling ./time.bit;
// siblings share one module scope, so it is used here directly — re-importing it
// is E0042.

// The per-program entry the compiled user object defines (ABI.md §10). Reachable
// as an `extern function` since #1614 whitelisted `bit_main`; it resolves to
// `U bit_main` at final program link, exactly as `runtime/root/`'s `extern fn
// bit_main` does.
extern function bit_main(): i32

// ---------------------------------------------------------------------------
// Boot-time storage, sized for `bootMaxWorkers` (#1900, ABI.md §8 step 2) —
// identical to ../linux/boot.bit, including the reason the sizes are literals:
// an array size must be an integer literal, so `[workerWords * bootMaxWorkers]`
// does not parse and the arithmetic is by hand (292 x32 = 9344, 2 x32 = 64).
// ---------------------------------------------------------------------------
let schedBlock: [16]i64
let workerBlock: [9344]i64
let mainTaskBlock: [32]i64
let startArgs: [64]i64
let startDones: [32]i32
let startHandles: [32]i64

// The netpoller descriptor `boot` creates, kept so teardown can close it —
// `runtime/sched/`'s `NetPoller.deinit`, which its `Scheduler.deinit` calls. Same
// cell, same reason, as ../linux/boot.bit's.
let bootPollFd: int = 0

let mainExitCode: int = 0
let mainDone: i32 = 0

// The process-global scheduler address (`runtime/sched/`'s `g_sched`) — see
// ../linux/boot.bit's `gSched` for why the otherwise caller-owned runtime needs
// one: `bit_rt_spawn(fn_ptr, arg)` carries no scheduler argument. Untraced
// scalar module state (rule 1).
let gSched: int = 0

// The channel reserve descriptor (`reserveWords` = 3) and root-scan registry
// block (`chanRegWords` = 2) `runtime/chan`'s `chan_make` uses — owned here and
// bound into chan at boot via `chanBootBind` (the `worldBind` pattern). Untraced
// scalar arrays (rule 1). Identical to ../linux/boot.bit.
let chanReserveDesc: [3]i64
let chanRegBlock: [2]i64

const arenaWords: int = 1048576
const indexWords: int = 16384
const pageSize: int = 4096
const markStack: int = 4096
const minTrigger: int = 65536
const growthPct: int = 200

// Worker-pool ceiling (#1900) — kept identical to ../linux/boot.bit.
const bootMaxWorkers: int = 32
const joinTimeoutNs: int = 15000000000

// Backing size of the channel reserve `chan_make` bump-allocates out of: 1 MiB,
// process-lifetime, mapped once at boot (v1 has no channel-free primitive, §11).
// Identical to ../linux/boot.bit.
const chanReserveBytes: int = 1048576

// Round `addr` up to the next `schedStackBytes` boundary (`schedStackAligned`).
@nosplit function alignUpStack(addr: int): int {
  let bumped = addr + schedStackBytes - 1
  return bumped - bumped % schedStackBytes
}

// `main`'s own stack, and it is NOT `schedStackBytes` (#1843). `runtime/sched/` gives
// `main` `main_stack_size` = 8 MiB against a goroutine's `stack_size`, because
// `main` is where user code recurses; the port shipped it at 64KiB, which
// `tests/stress/deeprecursion` caught by overflowing into neighbouring module
// state and still printing the right answer. Too large for masked identity, so it
// is named through `schedRegisterBigStack` instead. Identical to the sibling
// platform's.
const mainStackBytes: int = 8388608

// One task stack, aligned as `schedStackAligned` requires and GUARDED BELOW.
// Returns the base (lowest address, where the tag and the chan scratch live), or
// 0 on failure. Identical to ../linux/boot.bit's.
//
// THE GUARD IS THE POINT, and it costs no extra syscall (#1843). The alignment
// contract already forces mapping 2x the granule so a correctly-aligned window
// can be carved out of it; that leaves slop BELOW the chosen base which was
// previously left mapped and writable. Unmapping it turns it into a hole, so a
// stack that grows past its base faults instead of scribbling over whatever the
// allocator put next. `runtime/root/` had this as `mapGuardedStack`; the port shipped
// without it, and the difference is measurable rather than theoretical: with the
// hole, a recursion past the limit dies at the boundary having printed NOTHING;
// without it, the same program printed a plausible checksum and died later
// (`tests/stress/deeprecursion`, mutation-tested both ways).
//
// `alignUpStack(region + 1)` rather than `alignUpStack(region)`: `mapPages`
// returns a page-aligned address that may ALREADY be granule-aligned, in which
// case aligning it to itself leaves zero slop and therefore no guard. The `+ 1`
// forces the base strictly above the region, so the hole is never empty — at
// least one page, at most the whole granule — and the remainder above the base is
// still a full `schedStackBytes` either way.
@nosplit function mapGuardedStack(bytes: int): int {
  if (bytes <= 0) {
    return 0
  }
  // `bytes + schedStackBytes` so an aligned base can always be carved, and so the
  // slop below it is never empty. Aligning to the granule even for an oversized
  // stack keeps one code path: masking will miss inside it either way (its
  // interior boundaries hold ordinary frame data, not the tag), and the
  // oversized-stack registry is what names it.
  let region = mapPages(bytes + schedStackBytes)
  if (region == 0) {
    return 0
  }
  let base = alignUpStack(region + 1)
  if (!schedStackAligned(base) || base <= region || base - region > schedStackBytes) {
    return 0
  }
  // The hole. A failure here is not fatal — the stack above is intact and usable,
  // it just has no guard — but it is never expected, so it is not silent.
  if (!unmapPages(region, base - region)) {
    return 0
  }
  return base
}

// The worker OS-thread entry — same as ../linux/boot.bit's `workerBody`,
// including its reason for driving the find/drain/step trio in a local loop
// rather than passing the `nowFn`/`pollFn` seam to `schedWorkerRun`: a function
// value is a managed-heap `(code, env)` cell and this module must emit
// `--freestanding` (§17.6, #1628).
//
// THE DRAIN IS NOT OPTIONAL, AND ITS ABSENCE WAS #1673. This loop used to be a
// bare `schedWorkerStepNow`, which probes the three queues and the timer list and
// NOTHING ELSE. So this — the only worker the runtime starts — never called
// `pollDrain`, and a green thread parked on the netpoller by `netAwaitReady` had
// no thread in the process that could ever wake it. It did not hang: the poll fd
// was never created either (see `boot` step 4b), so `netAwaitReady` bailed at its
// `pollFd == 0` guard, `netReadSock` fell through to the unscheduled-caller spin,
// exhausted it, and returned -1 — which `bit_rt_net_read` reports as an EMPTY
// READ, indistinguishable from an orderly peer close. Every socket read that had
// to wait for a packet silently returned "". Both halves are needed and neither
// is sufficient: a poll fd nothing drains parks the reader forever, and a drain
// with no poll fd returns 0 on its first line.
//
// THE ORDER IS `schedFindWorkIdle`'s, which is `runtime/sched/`'s: queues, then
// timers, then — only if all of those came up empty — the poller, whose woken
// tasks land on the global queue, which `schedWorkerStepAt` pops from when the
// drain reports a non-zero wake count. Polling
// only when idle is what keeps a `kevent` syscall off the task-dispatch hot path;
// polling AFTER the timers is what stops a busy fd from starving a sleeper.
//
// `parkMonoNs()` IS THE POINT OF THE LOCAL LOOP (#1648). Timer deadlines are set
// by sibling ./time.bit's `bit_rt_time_sleep_ns` as `parkMonoNs() + ns`, so the
// worker that expires them must read the SAME clock. The previous
// `schedWorkerRunBare` folded the clock away to a constant 0, against which no
// positive deadline is ever due — `println/sleep/println` printed its first line
// and hung forever. Nothing else in this file may supply the clock: it is read
// here, once per turn, and passed straight through.
//
// ---------------------------------------------------------------------------
// THE IDLE SLEEP (#1665) — kept identical in ../linux/boot.bit
// ---------------------------------------------------------------------------
//
// `runtime/sched`'s `schedWorkerStep` cannot reach a platform sleep for idle
// (that module may import neither park provider, and the providers' pinned
// `bit_rt_port_park_sleep_ns` is not a member of `libbitrt.a`, so `worker.bit`'s
// own comment states it is unreachable there — E0078, verified on both Linux
// triples). Its no-work branch instead burns `spinBackoff`, a busy spin, which
// is why an idle worker pegged a whole core.
//
// `addr == 0 && woke == 0` is EXACTLY `schedWorkerStep`'s own no-work predicate
// — `schedFindWorkAt` found nothing and `pollDrain` woke nothing — and this
// loop already computes both before calling into the step, so the idle case is
// distinguished HERE, by the caller, with no change to `runtime/sched`'s pinned
// `bit_rt_port_sched_worker_step_at` API. This is sound only because this
// runtime starts exactly ONE worker (ABI.md §5): `woke > 0` with nothing to pop
// off the global queue would mean another consumer raced this thread for it,
// which cannot happen here. When work IS found, `schedWorkerStepAt` is called
// exactly as before and runs it.
//
// The sleep is bracketed with `bit_rt_gc_blocking_begin`/`_end` (ABI.md §5),
// `runtime/sched/`'s own idle path and this file's `boot`/`joinWorker` sleeps: no
// frame here holds a live Bit reference while parked, so the collector may pass
// this worker's slot without waiting for a safepoint it will not reach until
// `parkSleepNs` returns. `scStopping` is checked first and by hand, matching
// `schedWorkerStep`'s own order, so a shutdown signalled while idle is still
// seen within one backoff step rather than after a sleep starts.
function workerBody(arg: *byte): *byte {
  // CLAIM THE MUTATOR SLOT EAGERLY, BEFORE ANYTHING ELSE (#1677/#1699). This is
  // the thread's ENTRY function — the same place `gcThreadExit` below runs at
  // exit, and `runtime/sched/`'s `Worker.run` calls `gc_hooks.threadEnter()` at the
  // matching point. Lazy registration (claiming a slot on first allocation or
  // first safepoint poll) leaves a real window: `schedWorkerStepAt`'s very
  // first task dispatch can `schedSwitch` into a green task body BEFORE this
  // thread's own loop back edge is ever reached, and #1677's reproducer proved
  // a task that reads a live reference out of shared state before its own
  // first allocation/loop is invisible to the rendezvous for that whole
  // window — the object was swept 20/20 runs. Calling `gcThreadEnter()` here
  // closes it: this thread is a mutator from its very first instruction.
  gcThreadEnter()

  let block = taskAt(int(arg))
  let workerAddr = *block
  let doneAddr = *(block + 1)

  let w = taskAt(workerAddr)
  let s: *i64 = ptrOf(schedBlock)
  let backoff = parkMinBackoffNs
  // WORKER 0 POLLS, THE REST PARK (#1902). The Linux twin, line for line — see
  // `runtime/sched/sleep.bit` for why, and ../linux/boot.bit for the same code.
  // The park itself is `__ulock_wait` here and `futex(2)` there, which is the
  // only difference and is entirely inside `runtime/park/<os>`.
  let parks = *(w + wkId) != 0
  let n = 0
  while (n < WORKER_MAX_STEPS) {
    n = n + 1
    // Read the seq BEFORE looking for work; see the Linux twin for the window
    // this closes.
    let seq = schedIdleSeq(s)
    let addr = schedFindWorkAt(w, parkMonoNs())
    let woke = 0
    if (addr == 0) {
      woke = pollDrain(int(s), 0)
    }
    if (addr == 0 && woke == 0) {
      if (atomicLoad(s + scStopping) != 0) {
        break
      }
      gcBlockingBegin()
      if (parks) {
        schedIdlePark(s, seq)
      } else {
        parkSleepNs(backoff)
      }
      gcBlockingEnd()
      backoff = parkNextBackoff(backoff)
      continue
    }
    backoff = schedWorkerStepAt(w, addr, woke, backoff)
    if (backoff == workerStepStop) {
      break
    }
  }

  // RELEASE THE MUTATOR SLOT (#1666). `runtime/sched/`'s `Worker.run` — the oracle
  // this function ports — carries `gc_hooks.threadEnter()` /
  // `defer gc_hooks.threadExit()`, and the exit half was missing here. The
  // worker registers lazily at its first safepoint poll and then died without
  // ever releasing slot 1, which stayed `mRunning` forever; from that moment
  // every rendezvous the boot thread started waited out `stwSpinBound` for a
  // thread that no longer existed and abandoned. `../../gc/gcworld.bit` states
  // the consequence on `gcThreadExit` itself: "a leaked slot stays `running`
  // forever, which corrupts nothing but makes every later rendezvous expire,
  // i.e. collection quietly stops." Measured at ~160 abandoned collections per
  // run regardless of workload size, and 0 with this call.
  //
  // PLACEMENT IS LOAD-BEARING, and it is the oracle's: AFTER the run loop, so
  // no Bit code runs on this thread again, and BEFORE the done store, whose
  // tail is raw pointer arithmetic holding no managed reference. That is
  // `gcThreadExit`'s precondition. This is NOT the #1650/#1651 shape — nothing
  // is suppressed while the thread can still run Bit code; the slot is released
  // only once the thread is leaving. Releasing it any earlier would let a
  // rendezvous proceed past a thread that is still running, which is the defect
  // that sweeps live objects.
  gcThreadExit()

  let z: *i32 = nil
  atomicStore(z + doneAddr / 4, i32(0))
  return nil
}

// Trip bound for `joinWorker`, `runtime/thread`'s `JOIN_MAX_POLLS` unchanged, so
// the join is finite even if the deadline clock misbehaves (Power of 10, rule 2).
const joinMaxPolls: int = 100000

// `runtime/thread`'s `threadJoin` for THE one worker this runtime starts, with
// the platform clock and sleep called directly instead of taken as function
// values (see `workerBody`). Identical to ../linux/boot.bit's.
function joinWorker(done: *i32, timeoutNs: int): bool {
  // A non-positive timeout still gets one look at the word, so a join on an
  // already-finished worker succeeds rather than reporting a spurious timeout.
  if (atomicLoad(done) == i32(0)) {
    return true
  }
  let deadline = parkMonoNs() + timeoutNs
  let backoff = parkMinBackoffNs
  let i = 0
  while (i < joinMaxPolls) {
    if (atomicLoad(done) == i32(0)) {
      return true
    }
    if (parkMonoNs() >= deadline) {
      return false
    }
    parkSleepNs(backoff)
    backoff = parkNextBackoff(backoff)
    i = i + 1
  }
  return false
}

// The first green thread: run `bit_main`, publish its exit code, leave the task.
function mainTrampoline() {
  mainExitCode = int(bit_main())
  atomicStore(ptrOf(mainDone), i32(1))
  schedTaskExit()
}

// ---------------------------------------------------------------------------
// The `BIT_GC_STATS` line (#1639) — kept identical in ../linux/boot.bit
// ---------------------------------------------------------------------------
//
// `runtime/gc/`'s `collect` prints `[bit-gc] collection N: ...` per collection. THIS
// PORT CANNOT PRINT FROM THERE: every function on the collection path is
// `@nosplit`, which admits no `print`, no `extern` call and no `syscall`
// (`runtime/gc` deviation 6, E0075). So the flag's OWNER is boot, which is
// ordinary Bit sitting next to ./io.bit's write primitive, and the shape becomes
// one SUMMARY line at exit instead of one line per collection.
//
// That deviation is worth naming precisely, because #1639 measured the missing
// output and the missing collections together: a Bit-runtime binary printed
// nothing under `BIT_GC_STATS=1` for TWO independent reasons, and fixing only
// the wiring would still have printed nothing. `swept=` and `live=` are on the
// line for the same reason — a count alone cannot tell a collector that
// reclaims from one that marks everything.
//
// Text is emitted through `writeConst` (packed byte constants) rather than
// string literals: this module is `--freestanding` (#1628) and builds no
// managed string. The decimals go through ./os.bit's `osWriteDecimal`, a
// sibling.

// The line is assembled in MODULE STATE and written in ONE call, and it
// allocates nothing. That is a hard requirement, not tidiness: this runs on the
// boot thread after the worker is joined, i.e. after a whole run's worth of
// collection, and `[]int(n)` there returned 0 on roughly 40% of runs at
// 65k-collection density — a null the decimal writer then stored through
// (`strb w19, [x20]`, x20 = 4). ../io.bit's `writeConst` allocates too, so it is
// not used here either. `panicWrite` states the same rule for the same reason:
// the one path that must work when allocation is what failed cannot allocate.
// The residual question the null raised — whether a boot-thread allocation can
// fail after a heavy collected run — is filed separately (#1643); it is not
// reached from here any more.
//
// 160 bytes, and the size is a SUM to redo whenever a field is added, not a
// round number: the fixed text below is 56 bytes and FIVE i64 decimals are at
// most 100, so 156 is the worst case. `statsConst`/`statsNum` write through a
// raw `ptrOf`, so an undersized block runs off the end in silence (#1682).
let statsBuf: [20]i64

// Append `nbytes` low bytes of the packed constant `word` at byte offset `at`,
// returning the new offset. Packed constants rather than string literals because
// this module is `--freestanding` (#1628) and builds no managed string.
@nosplit function statsConst(at: int, word: int, nbytes: int): int {
  let base = int(ptrOf(statsBuf))
  let w = word
  let i = 0
  while (i < nbytes) {
    storeByte(base + at + i, w & 255)
    w = w >> 8
    i = i + 1
  }
  return at + nbytes
}

// Append `v` in decimal at byte offset `at`, returning the new offset.
@nosplit function statsNum(at: int, v: int): int {
  return at + osWriteDecimal(int(ptrOf(statsBuf)) + at, v)
}

// `[bit-gc] collections=<n> swept=<n> live=<n> abandoned=<n>`, on stderr, once,
// only under `BIT_GC_STATS`. Called after `main` has finished and the worker is
// reaped, so nothing can be collecting while it reads.
@nosplit function statsReport() {
  let at = statsConst(0, 6729335713145905755, 8)   // "[bit-gc]"
  at = statsConst(at, 8386658447444108064, 8)      // " collect"
  at = statsConst(at, 263929622377, 5)             // "ions="
  at = statsNum(at, stwCollections())
  at = statsConst(at, 17297999666836256, 7)        // " swept="
  at = statsNum(at, stwSwept())
  at = statsConst(at, 67505987611680, 6)           // " live="
  at = statsNum(at, stwLiveObjects())
  at = statsConst(at, 7957689491829973280, 8)      // " abandon"
  at = statsConst(at, 4023397, 3)                  // "ed="
  at = statsNum(at, stwAbandonedCount())
  at = statsConst(at, 28448, 2)                    // " o"
  at = statsConst(at, 4025711, 3)                  // "om="
  at = statsNum(at, rootStatOom())
  // Pointer-map offsets the tracer refused and SKIPPED (#1682): a skipped field
  // is a reference never marked, and that degraded trace is indistinguishable
  // from a healthy one everywhere else.
  at = statsConst(at, 263677108768, 5)             // " bad="
  at = statsNum(at, stwBadOffsets())
  at = statsConst(at, 10, 1)                       // "\n"
  rootWriteAll(stderrFd, int(ptrOf(statsBuf)), at)
}

// The OS page seam `runtime/gc/mem.bit` reaches through to grow the heap
// (#1638). The collector must compile for all three targets, so it cannot
// contain a `syscall` or a platform `extern function` of its own; it names this
// symbol and lets the link resolve it.
//
// PINNED (ABI.md §9) with the real ABI name. This IS the definition the
// collector binds to — there is no second one. It carried a `bit_rt_root_`
// placeholder while two archives coexisted; G2 (#1583) stripped the infix.
//
// A wrapper rather than pinning `../../alloc/{linux,darwin}`'s `mapPages`
// directly: that module is compiled from source by any program importing this
// one, so a pin there would be defined twice in the same link
// (`tests/stress/roothostdarwin` is such a program, and is how that was found).
// Keeping the ABI name here, on a wrapper, is what avoids it.
export @nosplit @symbol("bit_rt_map_pages") function rtMapPages(nbytes: int): int {
  return mapPages(nbytes)
}

// The release half of the same seam (#1641/#1662). `runtime/gc/mem.bit` frees a
// direct-mapped large object by naming `bit_rt_unmap_pages`, and this answers it.
// Non-zero on success, 0 when there is nothing to release. The caller ignores it,
// because a `munmap` of a range the allocator itself mapped cannot fail for any
// reason a caller could act on.
//
// A wrapper over `../../alloc/{linux,darwin}`'s `unmapPages` for the identical
// reason `rtMapPages` wraps `mapPages` rather than pinning it: pinning inside
// the page provider is defined twice in any link that compiles that module from
// source alongside this one.
export @nosplit @symbol("bit_rt_unmap_pages") function rtUnmapPages(addr: int, nbytes: int): int {
  if (unmapPages(addr, nbytes)) {
    return 1
  }
  return 0
}

// Boot the collector and scheduler, run `bit_main` as the first green thread,
// wait for it, tear down, and return the process exit code. THE ORDER IS
// LOAD-BEARING and mirrors `runtime/root/`'s `boot` exactly: heap before collector,
// collector before scheduler, scheduler populated before any worker exists,
// then start -> wait -> shutdown -> join. 70 on any setup failure.
function boot(): int {
  // 1. Ignore SIGPIPE process-wide (./signal.bit, this module).
  ignoreSigpipe()

  // 2. Map and bind the heap, then start the collector and type descriptors.
  let spanBytes = arenaWords * 8
  let idxBytes = indexWords * 8
  let span = mapPages(spanBytes)
  let idx = mapPages(idxBytes)
  if (span == 0 || idx == 0) {
    return 70
  }
  rootBindMemory(span, spanBytes, idx, idxBytes, pageSize)
  if (!rootInit(rootEnvMarkStack(markStack))) {
    return 70
  }

  // 3. GC config from the environment (BIT_GC/BIT_GC_MIN_KB/BIT_GC_GROWTH_PCT/
  //    BIT_GC_STATS over the defaults), the Bit port of `runtime/root/`'s
  //    `configFromEnv`. `osSetArgs` ran in `machoMain` before `boot`, so `envp`
  //    is captured by now.
  rootConfigureFromEnv(true, false, minTrigger, growthPct, false)

  // 4. Scheduler over the worker blocks. Publish it for `bit_rt_root_spawn`
  //    the moment it exists (the Bit form of `runtime/root/` assigning `g_sched`).
  //
  //    WORKER COUNT (#1900, ABI.md §8 step 2), identical to ../linux/boot.bit:
  //    the default is 1 and `BIT_WORKERS=<n>` opts in. See that file for the
  //    measurement that rejected defaulting to the CPU count — an idle worker
  //    is not free, so a pool wider than the runnable work is a net loss.
  let nworkers = rootEnvWorkers(1)
  if (nworkers < 1) {
    nworkers = 1
  }
  if (nworkers > bootMaxWorkers) {
    nworkers = bootMaxWorkers
  }
  let sched: *i64 = ptrOf(schedBlock)
  schedInit(sched, int(ptrOf(workerBlock)), nworkers)
  spawnBindScheduler(int(sched))

  // 4b. Create the netpoller and bind it into the scheduler (#1673). This is
  //     `runtime/sched/`'s `Scheduler.init`, which does `poller = try NetPoller.init()`
  //     inline; the port cannot, because `runtime/sched` may import neither
  //     provider, so the consumer that already is per-platform makes the call.
  //     Nothing else in the tree did, which is why `scPollFd` read back 0 for
  //     every socket in every Bit-sourced `libbitrt.a` ever built.
  //
  //     A FAILURE IS FATAL, and deliberately not a degrade-to-no-poller: a
  //     runtime with no poll descriptor still boots and still runs every
  //     non-networking program correctly, it just returns "" from any read that
  //     has to wait, which reads as an orderly peer close. Refusing to boot is the
  //     only answer that is not silent. `pollCreate` already reports a descriptor
  //     of 0 as a failure — the scheduler block spells "no poller bound" as a
  //     `scPollFd` of 0 — so a single `< 0` test here covers both.
  let pollFd = pollCreate()
  if (pollFd < 0) {
    return 70
  }
  bootPollFd = pollFd
  schedSetPollFd(sched, pollFd)

  // 4c. Provision the channel reserve + registry for `bit_rt_root_chan_make`
  //     (#1613), the worldBind pattern — after the scheduler exists, since
  //     `chan_make` stores it into every channel. Identical to ../linux/boot.bit.
  let chanMem = mapPages(chanReserveBytes)
  if (chanMem == 0) {
    return 70
  }
  chanBootBind(int(ptrOf(chanReserveDesc)), chanMem, chanReserveBytes,
               int(ptrOf(chanRegBlock)), int(sched))

  // 4d. Arm the STOP-THE-WORLD (#1639). `runtime/stw`'s poll — the body the
  //     `bit_rt_safepoint` shim every loop back edge calls hands its snapshot to
  //     — refuses to collect until all three root sources are reachable
  //     (`stwCanCollect`), so without this call the collector half is present,
  //     linked, and permanently dormant: 0 collections, no diagnostic, correct
  //     output. Must come after `chanBootBind` (the registry block is only
  //     meaningful once chan owns it) and after `schedInit`. `runtime/root`
  //     itself cannot make this call — `runtime/chan` imports it, so importing
  //     `runtime/stw` from there is an import cycle (E0044) — which is why the
  //     bind lives in the platform boot, the leaf that already imports all three.
  //     Identical to ../linux/boot.bit's.
  stwBind(rootGcAddr(), int(sched), int(ptrOf(chanRegBlock)), rootWorldAddr())

  // 5. Place `bit_main`'s task on worker 0's deque; register before queueing.
  // A MAPPING, NOT A MODULE ARRAY (#1843). This was carved out of a
  // `[16384]i64` in `__DATA`, which cannot be guarded — an overflow ran straight
  // into neighbouring module state. `main` runs user code and is the deepest
  // recursion in any program, so it is the last stack that should be unguarded.
  let stackBase = mapGuardedStack(mainStackBytes)
  if (stackBase == 0) {
    return 70
  }
  let task = int(ptrOf(mainTaskBlock))
  let t: *i64 = ptrOf(mainTaskBlock)
  schedTaskInit(t, stackBase, mainStackBytes, entryOf(mainTrampoline), 0)
  if (!schedRegisterBigStack(stackBase, mainStackBytes, task)) {
    return 70
  }

  schedRegister(sched, task)
  if (!dqPushBottom(schedWorkerAt(sched, 0) + wkDeque, task)) {
    return 70
  }

  // 6. Bring the workers up on real OS threads: `schedStart`'s per-worker arming
  //    (`schedStartArm`) then this platform's `threadStart` called DIRECTLY,
  //    since `schedStart` takes the spawner as a function value this module may
  //    not build, so its loop is written out here.
  //
  //    A FAILED SPAWN IS NOT FATAL PAST THE FIRST (#1900): worker 0 must come up
  //    or nothing runs, but beyond that a program should keep the workers it
  //    got. `started`, never `nworkers`, is what step 8 reaps.
  let started = 0
  let wi = 0
  while (wi < nworkers) {
    let startArg = schedStartArm(sched, wi, ptrOf(startArgs), ptrOf(startDones))
    let handle = threadStart(entryOf(workerBody), startArg, ptrOf(startDones) + wi)
    *(ptrOf(startHandles) + wi) = handle
    if (handle == 0) {
      if (wi == 0) {
        return 70
      }
      wi = nworkers
    } else {
      started = started + 1
      wi = wi + 1
    }
  }

  // 7. Poll-wait for `main` with bounded exponential backoff (not a worker).
  //    THE SLEEP IS BRACKETED `blocked` — see "THE BOOT THREAD AND THE
  //    RENDEZVOUS" above. Identical in ../linux/boot.bit.
  let backoff = 1000
  while (atomicLoad(ptrOf(mainDone)) == i32(0)) {
    gcBlockingBegin()
    parkSleepNs(backoff)
    gcBlockingEnd()
    backoff = backoff * 2
    if (backoff > 1000000) {
      backoff = 1000000
    }
  }

  // 8. Signal shutdown, reap the worker, report the code — `schedJoin`'s body
  //    for one worker, with the platform clock/sleep/release called directly.
  schedShutdown(sched)
  let ji = 0
  while (ji < started) {
    joinWorker(ptrOf(startDones) + ji, joinTimeoutNs)
    threadRelease(*(ptrOf(startHandles) + ji))
    ji = ji + 1
  }

  // 8b. Close the netpoller — `runtime/sched/`'s `NetPoller.deinit`, called from its
  //     `Scheduler.deinit`. AFTER the join, because the worker calls `pollDrain`
  //     on this descriptor from its own loop and closing it under a live poller is
  //     a use-after-close, not a leak. Identical to ../linux/boot.bit's.
  if (bootPollFd > 0) {
    pollClose(bootPollFd)
    bootPollFd = 0
  }

  // 9. `BIT_GC_STATS`. After the join, so the worker cannot be mid-collection
  //    while the counters are read, and before the exit code goes back to the
  //    entry so it lands on stderr while the process still has one.
  if (rootEnvVerbose(false)) {
    statsReport()
  }
  return mainExitCode
}

// ---------------------------------------------------------------------------
// bit_rt_spawn — the whole spawn job (#1611). Kept function-for-function with
// ../linux/boot.bit; see its section header for the full rationale.
// ---------------------------------------------------------------------------

// Publish the scheduler `boot` created so `bit_rt_root_spawn` can reach it — the
// single write path for `gSched`. Exported so the #1611 end-to-end test can bind
// a scheduler it drives itself.
export @nosplit function spawnBindScheduler(schedAddr: int) {
  gSched = schedAddr
}

// `bit_rt_spawn(fn_ptr, arg)` — the whole spawn job under the ABI placeholder G2
// (#1583) renames. Recover the scheduler (`gSched`), map the task's stack and
// carve its 64KiB-aligned window, allocate the task block, `schedTaskInit` it
// with (entry, arg), then `schedSpawn` (register + queue). NOT `@nosplit` (it
// maps). Stack and task block are raw `mapPages` mappings, never the GC heap,
// exactly as ../linux/boot.bit's `rtSpawn` and `runtime/root/`'s `Task.create`.
export @nosplit @symbol("bit_rt_spawn") function rtSpawn(entry: *byte, arg: int) {
  if (gSched == 0) {
    rootExit(70)
  }
  let s = taskAt(gSched)

  let stackBase = mapGuardedStack(schedStackBytes)
  if (stackBase == 0) {
    rootExit(70)
  }

  // One word wider than a plain task block: `taskSpawnEntry` holds the real
  // compiler entry so `schedSpawnTrampoline` can call it with `arg` in the
  // first-argument register (#1622). The pc slot goes to that trampoline, not
  // to `entry` — a compiler `spawn$trampoline` takes its thunk in a register
  // and returns, which a bare direct branch cannot satisfy.
  let taskAddr = mapPages((taskWords + 1) * 8)
  if (taskAddr == 0) {
    rootExit(70)
  }

  *(taskAt(taskAddr) + taskSpawnEntry) = int(entry)
  schedTaskInit(taskAt(taskAddr), stackBase, schedStackBytes,
                entryOf(schedSpawnTrampoline), arg)
  schedSpawn(s, taskAddr)
}

// The macOS entry point. dyld's `LC_MAIN` (the Mach-O writer, #345) calls this
// with the C `main(argc, argv, envp)` ABI — a valid aligned frame already set up
// — and calls `exit()` with the returned code. Captures argc/argv/envp through
// the SINGLE sanctioned path (`bit_rt_port_root_os_set_args`); Darwin has no
// auxv to capture. `runtime/root/`'s `machoMain`.
//
// PINNED with the literal `_start`, which is a documented special case: the
// linker designates the entry point BY NAME (ABI.md §9), so this pin cannot be
// spelled anything else. This is the process entry for every Mach-O this
// toolchain links, and the only definition of it. Mirrors ../linux/boot.bit's
// `startEntry`.
export @symbol("_start") function machoMain(argc: i32, argv: *byte, envp: *byte): i32 {
  osSetArgs(int(argc), int(argv), int(envp))
  return i32(boot())
}
