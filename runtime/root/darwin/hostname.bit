// `bit_rt_os_hostname` (ABI.md §19, #7192): the local host name, for
// `std/os`'s `hostname`. Same module as ./os.bit (an import is per module, not
// per file): `u8At` is ./fs.bit's, `loadByte`/`storeByte` come from
// ./fs.bit's `../../gc` import, so nothing here needs an `import`. Its own
// file because ./os.bit sits at 739 lines and `spec/LINT.md` §4 caps a file
// at 800.
//
// `gethostname(2)` through libSystem (§11.7), the POSIX call Go's `os.Hostname`
// and Python's `socket.gethostname` make. POSIX leaves a name that does not
// fit either truncated without a NUL (glibc) or an error (Darwin), so this
// does not trust the return value for that. Darwin (the BSD copy) NUL-terminates
// a truncated name inside the buffer, so a shortened name looks exactly like a
// name that fitted; the only name it can tell apart is one that leaves a byte
// to spare. So a length of `room - 1` (the longest a `room`-byte buffer can hold)
// is refused as possibly truncated, and a name is accepted only when it is at
// most `room - 2` bytes. With `std/os`'s 257-byte buffer that is POSIX
// `HOST_NAME_MAX` (255) exactly.
extern fn gethostname(name: *u8, len: i32): i32

// Write the host name at `buf` (room for `room` bytes) NUL-terminated and return
// its length, which is at most `room - 2` here. `0 - 1` when the call fails or
// the name may have been cut: rejected, never truncated, so a caller never
// holds a shortened name. A plain libSystem call that reads a kernel string, so
// no `gcSyscallBegin` bracket (nothing here parks), like `rtOsSelfExe`'s.
export @nosplit @symbol("bit_rt_os_hostname") fn rtOsHostname(buf: int, room: int): int {
  if (buf == 0 || room < 2) {
    return 0 - 1
  }
  if (gethostname(u8At(buf), i32(room)) != 0) {
    return 0 - 1
  }
  let n = 0
  while (n < room - 1) {
    if (loadByte(buf + n) == 0) {
      return n
    }
    n = n + 1
  }
  return 0 - 1
}
