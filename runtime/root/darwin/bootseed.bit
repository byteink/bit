// The map hash seed draw (#7379), split out of `boot` to keep that file under
// the line ceiling. Same module as `boot`, so the call is module-scoped.
import { entropyFill } from "../../rand/darwin"
import { rootHashSeedInit } from "../../root"

// The 8 CSPRNG bytes the seed is made of. Module state because a local is not
// addressable; written once, while boot is still the only thread.
let bootSeedWord: [1]i64

// Draw the seed and install it (../hashseed.bit). Runs before anything can
// build a map; a failed draw is fatal there unless `BIT_HASH_SEED` names the
// seed, because a fixed seed is the hash flooding hole the draw closes.
fn bootSeedHash() {
  let seedBytes: *u8 = nil
  let drawn = entropyFill(seedBytes + int(ptrOf(bootSeedWord)), 8)
  rootHashSeedInit(u64(bootSeedWord[0]), drawn)
  workerLifetimeInit()
}

// The bounded spin changes no caller state; a park clears the budget.
@nosplit fn workerSpin(w: *i64, holder: bool, spin: bool): int {
  if (!holder && spin) {
    return spinForWork(w)
  }
  return 0
}

@nosplit fn workerRunTask(
  w: *i64, addr: int, woke: int, backoff: int, owed: bool,
): int {
  // Running instead of parking: clear the arm so a producer does not spend
  // its one wake on a worker that is already busy.
  schedIdleDisarm(w)
  // This worker just left the poller to run a task: hand the token to a
  // parked peer if something still needs a poller (#6429).
  if (owed) {
    schedPollerHandoff(taskAt(*(w + wkSched)))
  }
  let next = schedWorkerStepAt(w, addr, woke, backoff)
  // TEARDOWN (#2167). `schedWorkerStep`, inside `schedWorkerStepAt`, already
  // unregistered the retired task from the collector's root set before
  // returning, so its stack and task block are unreachable and safe to
  // release here. `wkLastDone` — not `addr` — names the retired task,
  // because the netpoller-drain path picks its own task internally when
  // `addr == 0` (see `wkLastDone`'s own comment in `runtime/sched/worker.bit`).
  //
  // `mainTaskBlock` IS EXCLUDED, ALWAYS. It is a fixed module array
  // registered through `schedRegisterBigStack`, never `mapPages`'d, and it
  // reaches this identical `taskDone` transition through this identical
  // loop when `bit_main` returns. Unmapping it would `munmap` memory this
  // module never `mmap`'d.
  let doneTask = *(w + wkLastDone)
  if (doneTask != 0 && doneTask != int(ptrOf(mainTaskBlock))) {
    releaseTask(doneTask)
  }
  return next
}

// Initialized before boot starts workers; all fatal paths only read the message.
let workerLifetimeMsg: [7]i64

@nosplit fn workerLifetimeInit() {
  let msg: *i64 = ptrOf(workerLifetimeMsg)
  *msg = int(msg) + 16
  *(msg + 1) = 35
  *(msg + 2) = 7308345369373991795
  *(msg + 3) = 8243112832212082802
  *(msg + 4) = 7883960601547467808
  *(msg + 5) = 8319662987961245797
  *(msg + 6) = 6579572
}

@nosplit fn workerCheckExit(s: *i64, stopped: bool) {
  // mainDone closes the race before the boot thread publishes scStopping.
  if (stopped || atomicLoad(s + scStopping) != 0 || atomicLoad(ptrOf(mainDone)) != i32(0)) {
    return
  }
  rootFatal(int(ptrOf(workerLifetimeMsg)))
}
