// The map hash seed draw (#7379), split out of `boot` to keep that file under
// the line ceiling. Same module as `boot`, so the call is module-scoped.
import { entropyFill } from "../../rand/darwin"
import { rootHashSeedInit } from "../../root"

// The 8 CSPRNG bytes the seed is made of. Module state because a local is not
// addressable; written once, while boot is still the only thread.
let bootSeedWord: [1]i64

// Draw the seed and install it (../hashseed.bit). Runs before anything can
// build a map; a failed draw is fatal there unless `BIT_HASH_SEED` names the
// seed, because a fixed seed is the hash flooding hole the draw closes.
fn bootSeedHash() {
  let seedBytes: *u8 = nil
  let drawn = entropyFill(seedBytes + int(ptrOf(bootSeedWord)), 8)
  rootHashSeedInit(u64(bootSeedWord[0]), drawn)
}
