// `bit_rt_fs_create_excl_w` (#5797, epic #5787): see ../linux/fscreateexcl.bit
// for the full rationale (pkg/kv's `create` checked `exists(path)` then
// opened without `O_EXCL`, so two concurrent creates both succeeded and a
// planted symlink got followed and overwritten). Sibling file, not added to
// ./fs.bit, matching ../linux/fscreateexcl.bit's own split choice even
// though this file has more headroom under the 800-line ceiling — keeping
// the primitive's two platform copies at the same filename in each
// directory is the established convention (./fsbeneath.bit, ./fsopenrw.bit
// vs ../linux/fsopenrw.bit).
//
// `wordsPathZ`, `oReadWrite`, `oNoFollow`, `permFile`, `u8At`, `open`,
// `readAllErrno` are NOT imported here: ./fs.bit, a sibling in this same
// module, already declares/imports every one of them; a second import or
// redeclaration would be E0042.

// `O_EXCL` = 0x0800 = 2048 (`<sys/fcntl.h>`, Darwin's own numbering — this
// bit does NOT share Linux's `0o200`, the same kind of platform divergence
// ./fs.bit's own O_* header comment already documents for `O_CREAT`/
// `O_TRUNC`/`O_APPEND`). OR'd onto `O_CREAT`, it makes `open(2)` FAIL
// instead of succeeding when the final path component already exists.
const oExcl: int = 2048 // 0x0800

// `EEXIST` = 17 (`<sys/errno.h>`), the same POSIX value as Linux's — read
// via `__error()` after the call fails, exactly like `fillStat`'s own
// `readAllErrno()` use above in ./fs.bit.
const errnoEexist: int = 17

// `bit_rt_fs_create_excl_w` (ABI.md §14, #5797): open the `n` path bytes at
// `words` `O_RDWR|O_CREAT|O_EXCL|O_NOFOLLOW` at permission bits `mode` in
// one `open(2)` call. Returns the fd on success; `-2` specifically for
// `EEXIST`, so a caller can tell "already there" apart from every other
// failure; `-1` otherwise — the same normalized three-way shape
// `bit_rt_fs_lock`/`bit_rt_fs_unlock` already use in place of a raw errno.
// Packed-bytes `(words, n)`, same convention as `bit_rt_fs_open_rw_w`/
// `bit_rt_fs_open_nofollow_w` above.
export @nosplit @symbol("bit_rt_fs_create_excl_w") fn rtFsCreateExclW(
  words: int,
  n: int,
  mode: i64,
): int {
  let p = wordsPathZ(words, n)
  if (p == 0) {
    return 0 - 1
  }
  let flags = oReadWrite | oExcl | oNoFollow
  let fd = int(open(u8At(p), i32(flags), mode, 0, 0, 0, 0, 0, mode))
  if (fd >= 0) {
    return fd
  }
  if (readAllErrno() == errnoEexist) {
    return 0 - 2
  }
  return 0 - 1
}
