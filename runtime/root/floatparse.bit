// SEAM 5a of the runtime port (#1578): correctly-rounded decimal text -> f64,
// returning the raw bit pattern. This is the body of `bit_rt_parse_float` (the
// pinned wrapper lives in `floats.bit`).
//
// Ported verbatim from `bench/fptext/parse.bit` (#1539): round-trip bit-exact
// over 1,000,000 f64 patterns, mutation-tested. Sibling file, same module as
// `root.bit`; depends on `floatbig.bit` and `floatfmt.bit` (`u64BitLen`).
//
// Like the formatter it works in exact rational arithmetic rather than with a
// fast path plus a fallback: the decimal is held as an exact ratio and the
// quotient's bits are produced by long division, so the round-to-nearest-even
// decision is made on the true remainder and never on an approximation. There
// is no accuracy shortcut to get wrong — which is the property this seam needs,
// since a 1-ULP miss reads back as a different f64 and flips the printed
// shortest string.
//
// Returns bits rather than an `f64` because Bit has no bits->float primitive,
// and because bit equality is exactly what the round-trip check asserts. The
// pinned wrapper returns these bits directly (the caller-side word bitcast that
// reconstructs the `f64` lands with #1369's rename).

fn parseMaxDigits(): i64 { return 800 }

// SPEC 5.4: "`_` is a digit separator; it may appear between digits only,
// never leading, trailing, or doubled." §5.5's DIGITS/HEX_DIGITS productions
// (`DIGIT { ['_'] DIGIT }` / `HEX_DIGIT { ['_'] HEX_DIGIT }`) instantiate that
// rule separately for each digit group a float literal has (the integer part,
// the fraction, an exponent, a hex mantissa on either side of its `.`) — a
// group boundary is exactly a non-digit byte, so checking only the two bytes
// immediately around `_` is enough: it is automatically "leading" if the byte
// before is `.`/a sign/the string start, "trailing" if the byte after is
// `.`/`e`/`p`/the string end, and "doubled" if the byte on either side is
// another `_`. No group-boundary bookkeeping needed.
//
// #3067: every digit loop below used to strip `_` unconditionally with no
// adjacency check at all, so "1__0", "_1" and "1_" all parsed as if the
// separator were not there.
//
// POLL-FREEDOM (tests/bit/pollfree #1658): `isDecDigit` takes only a `byte`
// and does two comparisons — no call, no loop, no allocation — so E0075 can
// PROVE it poll-free and it is `@nosplit` outright, the same proof this
// file's `nanBits` already rests on. `decUnderscoreOk`/`hexUnderscoreOk`
// cannot follow: both index the caller's `[]byte` at `i-1`/`i+1`, and a slice
// read lowers to `rt_call slice_get` (compiler/loweraccess.bit), which E0075
// rejects unconditionally — its Index case admits only a fixed-array base
// (`compiler/validateattr.bit`, the `TypeKind.Array` check), never a slice.
// Both are reviewed exceptions instead (`tests/bit/pollfree/exceptions.bit`,
// group (a)): they hold no raw GC address at all, only the same MANAGED `b`
// their non-`@nosplit` callers `parseBits`/`parseHexBits` already carry —
// the identical property that already excuses `hexDigitVal`, which those two
// callers index through directly.
@nosplit fn isDecDigit(c: byte): bool { return c >= byte(48) && c <= byte(57) }
fn decUnderscoreOk(b: []byte, i: int, n: int): bool {
  return i > 0 && isDecDigit(b[i - 1]) && i + 1 < n && isDecDigit(b[i + 1])
}
fn hexUnderscoreOk(b: []byte, i: int, n: int): bool {
  return i > 0 && hexDigitVal(b[i - 1]) >= 0 && i + 1 < n && hexDigitVal(b[i + 1]) >= 0
}

// Parses `s` as a decimal float, returning the bit pattern of the nearest f64.
// Underscore separators are stripped (SPEC 5.4). UNPARSABLE TEXT YIELDS A QUIET
// NaN (SPEC 5.3), which `nanBits` spells and every rejection path below returns.
//
// IT USED TO YIELD 0, AND THAT WAS #2138: `parseFloat("nonsense")` and
// `parseFloat("0")` were the same value, so a bad parse was indistinguishable
// from a successful zero with no error, no second result and no way to ask.
// `parseFloat` is predeclared in every program's scope, and `std/strings` has no
// float parser, so the name a developer reaches for silently turned every
// malformed field into 0 — data loss with a clean `bit check` and 0 lint
// findings. NaN is observable with what the language already has (`v != v`) and
// needs no signature change, so no caller had to move.
//
// It also cost this file a whole capability once already, in the same shape and
// for the same reason: hex floats (#1857, the block below) silently parsed as
// +-0.0 for as long as they did precisely BECAUSE rejection was spelled as a
// value the caller could not tell from a real answer. A NaN would have named it
// the first time `bit_rt_log`'s coefficient table was read back.
export fn parseBits(s: string): u64 {
  let b = []byte(s)
  let i = 0
  let n = len(b)

  let neg = false
  if (i < n && (b[i] == byte(45) || b[i] == byte(43))) {
    neg = b[i] == byte(45)
    i = i + 1
  }

  // HEX FLOATS (#1857). `0x1.5555555555577p-2` and friends: the seed got these
  // from the reference parser, and this implementation only ever covered the
  // decimal half. Because unparsable text yields 0 rather than an error, every
  // hex literal silently became +-0.0 — the leading `-0` was consumed, the `x`
  // ended the digit loop. That zeroed `bit_rt_log`'s entire coefficient table
  // and made `log(x)` return 0 for every input, undetected until #1593 first
  // asked the self-hosted compiler to build the runtime.
  //
  // Split out rather than folded into the loop below because the two share
  // nothing: base 16 needs no big-integer ratio at all. A hex float is EXACT —
  // mantissa is an integer, exponent is a power of two — so the only rounding
  // is the final fit into 53 bits, which `assembleBits` already does.
  if (i + 1 < n && b[i] == byte(48) && (b[i + 1] == byte(120) || b[i + 1] == byte(88))) {
    return parseHexBits(b, i + 2, n, neg)
  }

  let num = bigNew()
  let nn = 0
  let nd = 0 // significant digits accumulated
  let seenDigit = false
  let fracDigits = 0
  let inFrac = false
  let leading = true // still skipping leading zeros

  // Nine digits at a time; `pend`/`pcount` hold the partial group.
  let pend = u64(0)
  let pcount = 0

  while (i < n) {
    let c = b[i]
    if (c == byte(95)) {
      if (!decUnderscoreOk(b, i, n)) {
        return nanBits()
      }
      i = i + 1
      continue
    }
    if (c == byte(46)) {
      if (inFrac) {
        return nanBits()
      }
      inFrac = true
      i = i + 1
      continue
    }
    if (c < byte(48) || c > byte(57)) {
      break
    }
    seenDigit = true
    let d = i64(c) - 48
    if (inFrac) {
      fracDigits = fracDigits + 1
    }
    if (leading && d == 0) {
      // A leading zero contributes no significant digit, but a zero after the
      // point still shifts the exponent, which `fracDigits` already counted.
      i = i + 1
      continue
    }
    leading = false
    assert(nd < parseMaxDigits())
    pend = pend * u64(10) + u64(d)
    pcount = pcount + 1
    nd = nd + 1
    if (pcount == 9) {
      nn = bigMulAddSmall(num, nn, u32(1000000000), u32(pend))
      pend = u64(0)
      pcount = 0
    }
    i = i + 1
  }
  if (pcount > 0) {
    let m = u32(1)
    let j = 0
    while (j < pcount) {
      m = m * u32(10)
      j = j + 1
    }
    nn = bigMulAddSmall(num, nn, m, u32(pend))
  }
  if (!seenDigit) {
    return nanBits()
  }

  let exp = 0
  if (i < n && (b[i] == byte(101) || b[i] == byte(69))) {
    i = i + 1
    let esign = 1
    if (i < n && (b[i] == byte(45) || b[i] == byte(43))) {
      if (b[i] == byte(45)) {
        esign = -1
      }
      i = i + 1
    }
    let any = false
    while (i < n) {
      let c = b[i]
      if (c == byte(95)) {
        if (!decUnderscoreOk(b, i, n)) {
          return nanBits()
        }
        i = i + 1
        continue
      }
      if (c < byte(48) || c > byte(57)) {
        break
      }
      exp = exp * 10 + (i64(c) - 48)
      // Clamp rather than overflow: anything past this saturates to inf or zero
      // and the exact magnitude no longer changes the result.
      if (exp > 100000) {
        exp = 100000
      }
      any = true
      i = i + 1
    }
    if (!any) {
      return nanBits()
    }
    exp = exp * esign
  }
  if (i != n) {
    return nanBits()
  }

  let sign = u64(0)
  if (neg) {
    sign = u64(1) << u64(63)
  }
  if (nn == 0) {
    return sign
  }

  // value = num * 10^q, held exactly as num/den.
  let q = exp - fracDigits
  let den = bigNew()
  let dn = bigSetU64(den, u64(1))
  if (q > 0) {
    if (q > 400) {
      return sign | infBits()
    }
    nn = bigMulPow10(num, nn, q)
  } else if (q < 0) {
    if (-q > 400) {
      return sign
    }
    dn = bigMulPow10(den, dn, -q)
  }

  // Line the operands up so the quotient lands in [2^53, 2^55): 54 or 55 bits,
  // one or two more than the significand, which is what rounding needs.
  let shift = 54 - (bigBitLen(num, nn) - bigBitLen(den, dn))
  let e = -shift
  if (shift > 0) {
    nn = bigShl(num, nn, shift)
  } else if (shift < 0) {
    dn = bigShl(den, dn, -shift)
  }

  // Binary long division, most significant quotient bit first. Only ~55 steps
  // run because the alignment above fixed the operands' bit-length gap.
  let bs = bigNew()
  let d = bigBitLen(num, nn) - bigBitLen(den, dn)
  assert(d >= 0 && d < 64)
  let bsn = bigCopy(bs, den, dn)
  bsn = bigShl(bs, bsn, d)

  let quo = u64(0)
  let step = d
  while (step >= 0) {
    quo = quo << u64(1)
    if (bigCmp(num, nn, bs, bsn) >= 0) {
      nn = bigSub(num, nn, bs, bsn)
      quo = quo | u64(1)
    }
    bsn = bigShr1(bs, bsn)
    step = step - 1
  }
  let sticky = nn != 0

  return assembleBits(sign, quo, e, sticky)
}

// `sign | round(quo * 2^e)` as an f64 bit pattern. Split out of `parseBits`
// (#1857) so the hex-float path reuses this rounding rather than restating it:
// the subnormal grid and the carry-out-of-53-bits case are exactly the parts
// worth having only one copy of.
//
// `quo` must carry at least 54 significant bits so there is a real rounding bit
// below the 53 that survive; both callers guarantee that by construction.
fn assembleBits(sign: u64, quo: u64, e: i64, sticky: bool): u64 {
  // Choose the target grid BEFORE rounding. Rounding to 53 bits and then
  // re-rounding onto the subnormal grid is a double rounding, and double
  // rounding is wrong by one ulp exactly on the half-way inputs this seam has
  // to get right.
  let bl = u64BitLen(quo)
  assert(bl >= 54)
  let dropNorm = bl - 53
  let expIfNormal = e + dropNorm + 1075

  if (expIfNormal < 1) {
    // Subnormal: land on the fixed 2^-1074 grid in one rounding step. A carry
    // out of the top bit lands in the exponent field, which is exactly the
    // smallest normal — the encoding makes that transition for free.
    let dsub = -e - 1074
    if (dsub > 64) {
      return sign
    }
    let mant = quo
    if (dsub > 0) {
      mant = roundShiftRight(quo, dsub, sticky)
    } else if (dsub < 0) {
      mant = quo << u64(-dsub)
    }
    return sign | mant
  }

  let mant = roundShiftRight(quo, dropNorm, sticky)
  let expField = expIfNormal
  if (mant == u64(9007199254740992)) {
    mant = mant >> u64(1)
    expField = expField + 1
  }
  if (expField >= 2047) {
    return sign | infBits()
  }
  return sign | (u64(expField) << u64(52)) | (mant - u64(4503599627370496))
}

// The value of one hex digit, or -1 if `c` is not one.
fn hexDigitVal(c: byte): i64 {
  if (c >= byte(48) && c <= byte(57)) {
    return i64(c) - 48
  }
  if (c >= byte(97) && c <= byte(102)) {
    return i64(c) - 87
  }
  if (c >= byte(65) && c <= byte(70)) {
    return i64(c) - 55
  }
  return -1
}

// `b[i:n]` after the `0x`, as an f64 bit pattern. SPEC 5.5: hex digits, an
// optional `.` and fraction, then a MANDATORY `p` exponent in decimal.
//
// Accumulates at most 60 significant bits. That is comfortably more than the 53
// that survive plus the round and guard bits, and stopping there keeps `mant`
// inside a u64 no matter how long the literal is; everything past it only has
// to move `sticky`, which is all the rounding needs to know about it.
fn parseHexBits(b: []byte, start: i64, n: i64, neg: bool): u64 {
  let sign = u64(0)
  if (neg) {
    sign = u64(1) << u64(63)
  }

  let mant = u64(0)
  let bits = 0 // significant bits currently in `mant`
  let e2 = 0 // binary exponent to apply to `mant`
  let sticky = false
  let seenDigit = false
  let inFrac = false
  let i = start

  while (i < n) {
    let c = b[i]
    if (c == byte(95)) {
      if (!hexUnderscoreOk(b, i, n)) {
        return nanBits()
      }
      i = i + 1
      continue
    }
    if (c == byte(46)) {
      if (inFrac) {
        return nanBits()
      }
      inFrac = true
      i = i + 1
      continue
    }
    let d = hexDigitVal(c)
    if (d < 0) {
      break
    }
    seenDigit = true
    if (bits == 0 && d == 0) {
      // A leading zero carries no significant bit, but a zero AFTER the point
      // still scales the value once anything significant follows it.
      if (inFrac) {
        e2 = e2 - 4
      }
      i = i + 1
      continue
    }
    if (bits <= 56) {
      mant = (mant << u64(4)) | u64(d)
      bits = bits + 4
      if (inFrac) {
        e2 = e2 - 4
      }
    } else {
      // Past the precision we keep: the digit only contributes stickiness, and
      // an INTEGER digit still scales the value.
      if (d != 0) {
        sticky = true
      }
      if (!inFrac) {
        e2 = e2 + 4
      }
    }
    i = i + 1
  }

  if (!seenDigit) {
    return nanBits()
  }
  // The `p` exponent is mandatory — `0x1.8` alone is not a float literal.
  if (i >= n || (b[i] != byte(112) && b[i] != byte(80))) {
    return nanBits()
  }
  i = i + 1

  let pneg = false
  if (i < n && (b[i] == byte(45) || b[i] == byte(43))) {
    pneg = b[i] == byte(45)
    i = i + 1
  }
  let pdig = false
  let pexp = 0
  while (i < n) {
    let c = b[i]
    if (c == byte(95)) {
      if (!decUnderscoreOk(b, i, n)) {
        return nanBits()
      }
      i = i + 1
      continue
    }
    if (c < byte(48) || c > byte(57)) {
      return nanBits()
    }
    pdig = true
    // Clamp rather than overflow: any exponent past this is inf or zero anyway,
    // and `assembleBits` already handles both ends.
    if (pexp < 100000) {
      pexp = pexp * 10 + (i64(c) - 48)
    }
    i = i + 1
  }
  if (!pdig) {
    return nanBits()
  }
  if (pneg) {
    pexp = -pexp
  }

  if (mant == u64(0)) {
    return sign
  }

  // `assembleBits` needs at least 54 significant bits so a real rounding bit
  // exists below the surviving 53. Short literals (`0x1p0` carries one) are
  // shifted up; the exponent absorbs the shift exactly, since this is base 2.
  let bl = u64BitLen(mant)
  if (bl < 54) {
    let up = 54 - bl
    mant = mant << u64(up)
    e2 = e2 - up
  }
  return assembleBits(sign, mant, e2 + pexp, sticky)
}

// `v >> k`, rounded to nearest with ties going to even. `sticky` reports that
// nonzero bits were already discarded below `v`.
fn roundShiftRight(v: u64, k: i64, sticky: bool): u64 {
  assert(k > 0 && k < 64)
  let mask = (u64(1) << u64(k)) - u64(1)
  let dropped = v & mask
  let half = u64(1) << u64(k - 1)
  let r = v >> u64(k)
  if (dropped > half || (dropped == half && (sticky || (r & u64(1)) == u64(1)))) {
    r = r + u64(1)
  }
  return r
}

fn infBits(): u64 { return u64(2047) << u64(52) }

// The QUIET NaN every rejection path in this file returns (SPEC 5.3, #2138):
// all-ones exponent with the mantissa's top bit set, sign clear —
// `0x7FF8000000000000`, IEEE 754's canonical quiet NaN.
//
// A LITERAL PATTERN, NOT THE HARDWARE'S DEFAULT, and that distinction is what
// makes it pinnable in a golden. `tests/cases/run_parse_float_bits.bit` records
// that a NaN *produced by an invalid operation* has a different sign on the two
// architectures (`0xFFF8...` on x86-64, `0x7FF8...` on AArch64), so a pinned
// constant would read as a codegen divergence. This value is built here in u64
// arithmetic and reaches the caller through `bitsToFloat`, an inline bitcast with
// no numeric conversion (`floats.bit`), so the bits that leave this function are
// the bits that arrive — identically on both.
//
// The sign bit stays CLEAR even for rejected text that began with `-`: a NaN's
// sign is not part of its meaning, and every rejection path returns this value
// whole rather than OR-ing in the `sign` it may already have computed.
//
// `@nosplit` where `infBits` above is instead carried on `tests/bit/pollfree.bit`'s
// reviewed exception list, and the difference is deliberate: this body is two
// shifts and an `or` with no call, no loop and no allocation, so E0075 can PROVE
// the poll-freedom the exception list can only assert. The rest of this file is
// listed because it genuinely cannot be `@nosplit` — it allocates big-integer
// limbs and takes a managed `string`. Nothing else changes: a non-`@nosplit`
// caller may call a `@nosplit` callee, exactly as `floats.bit`'s `rtParseFloat`
// already calls `unpackToWords`.
@nosplit fn nanBits(): u64 { return (u64(2047) << u64(52)) | (u64(1) << u64(51)) }
