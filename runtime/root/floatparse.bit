// SEAM 5a of the runtime port (#1578): correctly-rounded decimal text -> f64,
// returning the raw bit pattern. This is the body of `bit_rt_parse_float` (the
// pinned wrapper lives in `floats.bit`).
//
// Ported verbatim from `bench/fptext/parse.bit` (#1539): round-trip bit-exact
// over 1,000,000 f64 patterns, mutation-tested. Sibling file, same module as
// `root.bit`; depends on `floatbig.bit` and `floatfmt.bit` (`u64BitLen`).
//
// Like the formatter it works in exact rational arithmetic rather than with a
// fast path plus a fallback: the decimal is held as an exact ratio and the
// quotient's bits are produced by long division, so the round-to-nearest-even
// decision is made on the true remainder and never on an approximation. There
// is no accuracy shortcut to get wrong — which is the property this seam needs,
// since a 1-ULP miss reads back as a different f64 and flips the printed
// shortest string.
//
// Returns bits rather than an `f64` because Bit has no bits->float primitive,
// and because bit equality is exactly what the round-trip check asserts. The
// pinned wrapper returns these bits directly (the caller-side word bitcast that
// reconstructs the `f64` lands with #1369's rename).

function parseMaxDigits(): i64 { return 800 }

// Parses `s` as a decimal float, returning the bit pattern of the nearest f64.
// Underscore separators are stripped (SPEC 5.4). Unparsable text yields 0, which
// matches the Zig implementation's contract.
export function parseBits(s: string): u64 {
  let b = []byte(s)
  let i = 0
  let n = len(b)

  let neg = false
  if (i < n && (b[i] == byte(45) || b[i] == byte(43))) {
    neg = b[i] == byte(45)
    i = i + 1
  }

  // HEX FLOATS (#1857). `0x1.5555555555577p-2` and friends: the seed got these
  // from Zig's `std.fmt.parseFloat`, and this port only ever implemented the
  // decimal half. Because unparsable text yields 0 rather than an error, every
  // hex literal silently became +-0.0 — the leading `-0` was consumed, the `x`
  // ended the digit loop. That zeroed `bit_rt_log`'s entire coefficient table
  // and made `log(x)` return 0 for every input, undetected until #1593 first
  // asked the self-hosted compiler to build the runtime.
  //
  // Split out rather than folded into the loop below because the two share
  // nothing: base 16 needs no big-integer ratio at all. A hex float is EXACT —
  // mantissa is an integer, exponent is a power of two — so the only rounding
  // is the final fit into 53 bits, which `assembleBits` already does.
  if (i + 1 < n && b[i] == byte(48) && (b[i + 1] == byte(120) || b[i + 1] == byte(88))) {
    return parseHexBits(b, i + 2, n, neg)
  }

  let num = bigNew()
  let nn = 0
  let nd = 0            // significant digits accumulated
  let seenDigit = false
  let fracDigits = 0
  let inFrac = false
  let leading = true    // still skipping leading zeros

  // Nine digits at a time; `pend`/`pcount` hold the partial group.
  let pend = u64(0)
  let pcount = 0

  while (i < n) {
    let c = b[i]
    if (c == byte(95)) { i = i + 1; continue }
    if (c == byte(46)) {
      if (inFrac) { return u64(0) }
      inFrac = true
      i = i + 1
      continue
    }
    if (c < byte(48) || c > byte(57)) { break }
    seenDigit = true
    let d = i64(c) - 48
    if (inFrac) { fracDigits = fracDigits + 1 }
    if (leading && d == 0) {
      // A leading zero contributes no significant digit, but a zero after the
      // point still shifts the exponent, which `fracDigits` already counted.
      i = i + 1
      continue
    }
    leading = false
    assert(nd < parseMaxDigits())
    pend = pend * u64(10) + u64(d)
    pcount = pcount + 1
    nd = nd + 1
    if (pcount == 9) {
      nn = bigMulAddSmall(num, nn, u32(1000000000), u32(pend))
      pend = u64(0)
      pcount = 0
    }
    i = i + 1
  }
  if (pcount > 0) {
    let m = u32(1)
    let j = 0
    while (j < pcount) { m = m * u32(10); j = j + 1 }
    nn = bigMulAddSmall(num, nn, m, u32(pend))
  }
  if (!seenDigit) { return u64(0) }

  let exp = 0
  if (i < n && (b[i] == byte(101) || b[i] == byte(69))) {
    i = i + 1
    let esign = 1
    if (i < n && (b[i] == byte(45) || b[i] == byte(43))) {
      if (b[i] == byte(45)) { esign = -1 }
      i = i + 1
    }
    let any = false
    while (i < n && b[i] >= byte(48) && b[i] <= byte(57)) {
      exp = exp * 10 + (i64(b[i]) - 48)
      // Clamp rather than overflow: anything past this saturates to inf or zero
      // and the exact magnitude no longer changes the result.
      if (exp > 100000) { exp = 100000 }
      any = true
      i = i + 1
    }
    if (!any) { return u64(0) }
    exp = exp * esign
  }
  if (i != n) { return u64(0) }

  let sign = u64(0)
  if (neg) { sign = u64(1) << u64(63) }
  if (nn == 0) { return sign }

  // value = num * 10^q, held exactly as num/den.
  let q = exp - fracDigits
  let den = bigNew()
  let dn = bigSetU64(den, u64(1))
  if (q > 0) {
    if (q > 400) { return sign | infBits() }
    nn = bigMulPow10(num, nn, q)
  } else if (q < 0) {
    if (-q > 400) { return sign }
    dn = bigMulPow10(den, dn, -q)
  }

  // Line the operands up so the quotient lands in [2^53, 2^55): 54 or 55 bits,
  // one or two more than the significand, which is what rounding needs.
  let shift = 54 - (bigBitLen(num, nn) - bigBitLen(den, dn))
  let e = -shift
  if (shift > 0) {
    nn = bigShl(num, nn, shift)
  } else if (shift < 0) {
    dn = bigShl(den, dn, -shift)
  }

  // Binary long division, most significant quotient bit first. Only ~55 steps
  // run because the alignment above fixed the operands' bit-length gap.
  let bs = bigNew()
  let d = bigBitLen(num, nn) - bigBitLen(den, dn)
  assert(d >= 0 && d < 64)
  let bsn = bigCopy(bs, den, dn)
  bsn = bigShl(bs, bsn, d)

  let quo = u64(0)
  let step = d
  while (step >= 0) {
    quo = quo << u64(1)
    if (bigCmp(num, nn, bs, bsn) >= 0) {
      nn = bigSub(num, nn, bs, bsn)
      quo = quo | u64(1)
    }
    bsn = bigShr1(bs, bsn)
    step = step - 1
  }
  let sticky = nn != 0

  return assembleBits(sign, quo, e, sticky)
}

// `sign | round(quo * 2^e)` as an f64 bit pattern. Split out of `parseBits`
// (#1857) so the hex-float path reuses this rounding rather than restating it:
// the subnormal grid and the carry-out-of-53-bits case are exactly the parts
// worth having only one copy of.
//
// `quo` must carry at least 54 significant bits so there is a real rounding bit
// below the 53 that survive; both callers guarantee that by construction.
function assembleBits(sign: u64, quo: u64, e: i64, sticky: bool): u64 {
  // Choose the target grid BEFORE rounding. Rounding to 53 bits and then
  // re-rounding onto the subnormal grid is a double rounding, and double
  // rounding is wrong by one ulp exactly on the half-way inputs this seam has
  // to get right.
  let bl = u64BitLen(quo)
  assert(bl >= 54)
  let dropNorm = bl - 53
  let expIfNormal = e + dropNorm + 1075

  if (expIfNormal < 1) {
    // Subnormal: land on the fixed 2^-1074 grid in one rounding step. A carry
    // out of the top bit lands in the exponent field, which is exactly the
    // smallest normal — the encoding makes that transition for free.
    let dsub = -e - 1074
    if (dsub > 64) { return sign }
    let mant = quo
    if (dsub > 0) {
      mant = roundShiftRight(quo, dsub, sticky)
    } else if (dsub < 0) {
      mant = quo << u64(-dsub)
    }
    return sign | mant
  }

  let mant = roundShiftRight(quo, dropNorm, sticky)
  let expField = expIfNormal
  if (mant == u64(9007199254740992)) { mant = mant >> u64(1); expField = expField + 1 }
  if (expField >= 2047) { return sign | infBits() }
  return sign | (u64(expField) << u64(52)) | (mant - u64(4503599627370496))
}

// The value of one hex digit, or -1 if `c` is not one.
function hexDigitVal(c: byte): i64 {
  if (c >= byte(48) && c <= byte(57)) { return i64(c) - 48 }
  if (c >= byte(97) && c <= byte(102)) { return i64(c) - 87 }
  if (c >= byte(65) && c <= byte(70)) { return i64(c) - 55 }
  return -1
}

// `b[i:n]` after the `0x`, as an f64 bit pattern. SPEC 5.5: hex digits, an
// optional `.` and fraction, then a MANDATORY `p` exponent in decimal.
//
// Accumulates at most 60 significant bits. That is comfortably more than the 53
// that survive plus the round and guard bits, and stopping there keeps `mant`
// inside a u64 no matter how long the literal is; everything past it only has
// to move `sticky`, which is all the rounding needs to know about it.
function parseHexBits(b: []byte, start: i64, n: i64, neg: bool): u64 {
  let sign = u64(0)
  if (neg) { sign = u64(1) << u64(63) }

  let mant = u64(0)
  let bits = 0          // significant bits currently in `mant`
  let e2 = 0            // binary exponent to apply to `mant`
  let sticky = false
  let seenDigit = false
  let inFrac = false
  let i = start

  while (i < n) {
    let c = b[i]
    if (c == byte(95)) { i = i + 1; continue }
    if (c == byte(46)) {
      if (inFrac) { return u64(0) }
      inFrac = true
      i = i + 1
      continue
    }
    let d = hexDigitVal(c)
    if (d < 0) { break }
    seenDigit = true
    if (bits == 0 && d == 0) {
      // A leading zero carries no significant bit, but a zero AFTER the point
      // still scales the value once anything significant follows it.
      if (inFrac) { e2 = e2 - 4 }
      i = i + 1
      continue
    }
    if (bits <= 56) {
      mant = (mant << u64(4)) | u64(d)
      bits = bits + 4
      if (inFrac) { e2 = e2 - 4 }
    } else {
      // Past the precision we keep: the digit only contributes stickiness, and
      // an INTEGER digit still scales the value.
      if (d != 0) { sticky = true }
      if (!inFrac) { e2 = e2 + 4 }
    }
    i = i + 1
  }

  if (!seenDigit) { return u64(0) }
  // The `p` exponent is mandatory — `0x1.8` alone is not a float literal.
  if (i >= n || (b[i] != byte(112) && b[i] != byte(80))) { return u64(0) }
  i = i + 1

  let pneg = false
  if (i < n && (b[i] == byte(45) || b[i] == byte(43))) {
    pneg = b[i] == byte(45)
    i = i + 1
  }
  let pdig = false
  let pexp = 0
  while (i < n) {
    let c = b[i]
    if (c == byte(95)) { i = i + 1; continue }
    if (c < byte(48) || c > byte(57)) { return u64(0) }
    pdig = true
    // Clamp rather than overflow: any exponent past this is inf or zero anyway,
    // and `assembleBits` already handles both ends.
    if (pexp < 100000) { pexp = pexp * 10 + (i64(c) - 48) }
    i = i + 1
  }
  if (!pdig) { return u64(0) }
  if (pneg) { pexp = -pexp }

  if (mant == u64(0)) { return sign }

  // `assembleBits` needs at least 54 significant bits so a real rounding bit
  // exists below the surviving 53. Short literals (`0x1p0` carries one) are
  // shifted up; the exponent absorbs the shift exactly, since this is base 2.
  let bl = u64BitLen(mant)
  if (bl < 54) {
    let up = 54 - bl
    mant = mant << u64(up)
    e2 = e2 - up
  }
  return assembleBits(sign, mant, e2 + pexp, sticky)
}

// `v >> k`, rounded to nearest with ties going to even. `sticky` reports that
// nonzero bits were already discarded below `v`.
function roundShiftRight(v: u64, k: i64, sticky: bool): u64 {
  assert(k > 0 && k < 64)
  let mask = (u64(1) << u64(k)) - u64(1)
  let dropped = v & mask
  let half = u64(1) << u64(k - 1)
  let r = v >> u64(k)
  if (dropped > half || (dropped == half && (sticky || (r & u64(1)) == u64(1)))) {
    r = r + u64(1)
  }
  return r
}

function infBits(): u64 { return u64(2047) << u64(52) }
