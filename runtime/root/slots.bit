// Split out of `root.bit` (SEAM 4, #1577): the per-task slots the seed carried
// in `@threadlocal`s (ABI.md §11, §13). Sibling file, same module — see
// `root.bit` for the port's header and seams.
//
// ---------------------------------------------------------------------------
// WHY THIS IS A DESIGN CHANGE, NOT A TRANSCRIPTION
// ---------------------------------------------------------------------------
//
// `runtime/root/` keeps three goroutine-local values — the pending fallible-call
// error (`bit_rt_set_err`/`get_err`, §13) and the `ok` of the last channel
// receive (`bit_rt_chan_recv_ok`, §11) — in `@threadlocal`s. **Mach-O refuses
// `@threadlocal` in the freestanding emit** (root.bit's deviation list, §11.11),
// so the port cannot copy the mechanism.
//
// The home is per-task scratch at the base of the running task's own stack — the
// exact mechanism `runtime/sched`'s `schedCurrentTask` and `scratchOf`
// already establish. This is strictly STRONGER than the seed's
// per-worker slot, not merely a workaround: #1248 records that the error slot
// must be per-task, not per-OS-thread, because the M:N scheduler can migrate a
// goroutine between workers. A per-task slot survives that migration; a
// per-worker one silently reads another goroutine's error after a park.
//
// The layout is the task block's contract (`chanScratchWords`, in
// `runtime/sched/scratch.bit`): `scrErr` is word 7 and `scrRecvOk` is word 264 —
// imported below rather than duplicated, so #1581's `bit_rt_chan_recv` wrapper
// and these readers name the same words.
//
// MUST BE CALLED FROM TASK CODE. Off a task `schedCurrentTask` returns 0 and the
// scratch lookup faults — the same stated contract as every chan function that
// touches scratch. The port runs all user code, `main` included, on a task, so
// a fallible call or a channel receive always has a current task by construction.
//
// `@nosplit` is not optional: these hold no managed references, but a safepoint
// firing between a fallible call's return and the caller's `get_err` — or
// between a receive and its `recv_ok` — is exactly the adjacency the slot relies
// on staying closed (ABI.md §11, §13). Codegen emits each pair back to back.

import { schedCurrentTask } from "../sched"
import { scratchOf, scrErr, scrRecvOk, scrFsReadFailed } from "../sched"

// ---------------------------------------------------------------------------
// Fallible-result error slot (ABI.md §13, SPEC §18)
// ---------------------------------------------------------------------------

// `bit_rt_set_err` (§13): `fail e` / `?`-propagation store the error here; a
// zero argument clears it (an ok return, or `catch` consuming it). The value is
// an `error`-interface object pointer, carried as a plain `int` address exactly
// as the other reference-shaped ABI arguments in this module are.
export @nosplit @symbol("bit_rt_set_err")
fn rtSetErr(e: int) {
  let scr = scratchOf(schedCurrentTask())
  *(scr + scrErr) = e
}

// `bit_rt_get_err` (§13): the caller reads the pending error right after a
// fallible call. A non-zero result means the call failed.
export @nosplit @symbol("bit_rt_get_err")
fn rtGetErr(): int {
  let scr = scratchOf(schedCurrentTask())
  return *(scr + scrErr)
}

// ---------------------------------------------------------------------------
// Channel receive `ok` (ABI.md §11)
// ---------------------------------------------------------------------------

// `bit_rt_chan_recv_ok` (§11): the `ok` of the `bit_rt_chan_recv` immediately
// preceding it, for the two-result form `let (v, ok) = <- c`. `false` means the
// channel was closed and drained, with the zero word delivered. This is
// load-bearing, not tidiness: a reference element's zero word on a closed
// channel is a NULL pointer, so a receiver must be able to tell "closed" from a
// real value before dereferencing it.
//
// The writer is #1581's `bit_rt_chan_recv` ABI wrapper, which publishes the
// receive's outcome into `scrRecvOk` on every path (buffered fast path
// included); this only reads it. Until that wrapper lands the slot reads zero,
// which is the correct default for "no receive performed".
export @nosplit @symbol("bit_rt_chan_recv_ok")
fn rtChanRecvOk(): bool {
  let scr = scratchOf(schedCurrentTask())
  return *(scr + scrRecvOk) != 0
}

// ---------------------------------------------------------------------------
// `bit_rt_fs_read_all` out-of-band I/O-error flag (ABI.md §14, #2994)
// ---------------------------------------------------------------------------
//
// Reintroduced runtime-only by #3065 — pass 1 of #2996's two-pass escape from
// the stage0-pin cycle: `bit_rt_fs_read_all_failed` was reverted (`1313d14d`)
// before it ever reached a pinned release, so a `std/fs` reference to it made
// the clean-tree driver build fail `E0078` against the OLD pinned
// `libbitrt.a`. Pass 1 added the symbol with no caller anywhere on the
// driver's import path. The stage0 pin moved to 0.1.17 (which contains pass
// 1) the same day, unblocking pass 2: `runtime/root/{darwin,linux}/fs.bit`'s
// `rtFsReadAll` now calls the setter below on its two genuine-failure paths
// (`end < 0`, `s == 0`), and `stdlib/fs/fs.bit`'s `File.readAll` now calls the
// getter, so `scrFsReadFailed` carries real per-call state.

// Publishes whether the `bit_rt_fs_read_all` just performed by this task
// stopped on a genuine I/O error (`true`) rather than completing or hitting a
// genuine early EOF (`false`). PORT-INTERNAL, not ABI: called only from the
// two platform `rtFsReadAll` providers, which are sibling runtime modules
// reaching across the object boundary (§11.9), so the reference needs a pin
// the way `rtStrAlloc`
// (`runtime/root/strings.bit:294`) does — `-O1` splices bodies across it
// otherwise.
export @nosplit @symbol("bit_rt_port_root_fs_read_failed_set")
fn rtFsReadAllFailedSet(v: bool) {
  let scr = scratchOf(schedCurrentTask())
  if (v) {
    *(scr + scrFsReadFailed) = 1
  } else {
    *(scr + scrFsReadFailed) = 0
  }
}

// `bit_rt_fs_read_all_failed` (ABI.md §14): the real ABI-facing accessor,
// reached from `stdlib/fs/fs.bit`'s `File.readAll` via a plain `extern fn`
// (SPEC §11.7) rather than through a compiler-recognized builtin —
// `bit_rt_fs_read_all` itself stays a single non-fallible `int`-returning
// primitive; this is the second symbol beside it. Must be read immediately
// after `fsReadAll` returns, with no yield between: the same adjacency
// `bit_rt_chan_recv_ok` above relies on.
export @nosplit @symbol("bit_rt_fs_read_all_failed")
fn rtFsReadAllFailed(): bool {
  let scr = scratchOf(schedCurrentTask())
  return *(scr + scrFsReadFailed) != 0
}
