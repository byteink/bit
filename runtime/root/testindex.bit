// `bit_rt_test_index` (ABI.md §16), the reader half of `bit test`'s per-test
// exec protocol (#1626). The WRITER — `os_run_test`, which prepends
// `BIT_TEST_INDEX=<n>` to the child's environment — is already ported in
// `{linux,darwin}/os.bit`; this is what the test binary itself calls to find out
// which single test it was spawned to run.
//
// `bit test` execs the test binary once per test rather than looping in-process
// because a failed `assert` panics the process — that isolation is what lets the
// runner attribute the failure and still run the remaining tests. A binary run
// directly inherits no such variable, reads -1, and runs nothing.
//
// SIBLING OF `rootconfig.bit`, AND SORTS AFTER IT (`r` < `t`). It reuses that
// file's `gcEnvValuePtr` — the one raw `envp` walk in this module, itself a
// no-allocation variant of `os.bit`'s `rtOsEnv` — rather than adding a third
// walker. Module files concatenate in bytewise filename order and the inliner
// only inlines a callee it has already lowered (#1511), so the filename has to
// sort after the file holding the helper.
//
// NO ALLOCATION, deliberately: the value is parsed straight off the `envp` block
// through a raw pointer. Routing it through a `string` would allocate, and going
// through the `os_env` primitive would lower to a call to `bit_rt_os_env` — the
// Zig, not this port (the same reasoning `rootconfig.bit` records).
//
// PIN CARRIES THE `bit_rt_root_` PREFIX: `runtime/root/` is still linked into
// every binary and already owns `bit_rt_test_index`, so claiming the real name
// now fails every link with DuplicateSymbol. G2 (#1583) drops the `_root` infix.

// The sentinel this ABI reports for "no test selected": unset, empty, or
// unparseable. Named because it is returned from four places and is a contract
// value, not an arbitrary error code — `runtime/testing` runs nothing on -1.
const testIndexNone: int = -1

// Parse the NUL-terminated decimal at `vp` as a signed integer, or -1 on any
// failure — `std.fmt.parseInt(i64, v, 10) catch -1`. An optional leading `+`/`-`
// is accepted because `parseInt` accepts one; the sign alone (no digits) is a
// failure there and here. `rootconfig.bit`'s `gcCstrUsize` is the unsigned twin,
// kept separate because it must NOT accept a sign (a negative heap size is not a
// parse failure to recover from, it is nonsense) and because its -1 means "no
// override" rather than a value a caller could legitimately hold.
//
// BOUNDED by `osMaxCstr` (Power of 10 rule 2), the kernel's ceiling on a single
// environment string, so a malformed unterminated block cannot spin.
function testIndexParse(vp: int): int {
  let i = 0
  let neg = false
  let c0 = loadByte(vp)
  if (c0 == 43 || c0 == 45) { // '+' / '-'
    neg = c0 == 45
    i = 1
  }
  let digits = 0
  let acc = 0
  while (i < osMaxCstr) {
    let c = loadByte(vp + i)
    if (c == 0) {
      break
    }
    if (c < 48 || c > 57) {
      return testIndexNone
    }
    acc = acc * 10 + (c - 48)
    digits = digits + 1
    i = i + 1
  }
  if (digits == 0) { // empty value, or a sign with nothing after it
    return testIndexNone
  }
  if (neg) {
    return 0 - acc
  }
  return acc
}

// `bit_rt_test_index` (ABI.md §16): the 0-based index of the one test this
// process should run, read from `BIT_TEST_INDEX`; -1 when unset, so a test
// binary run directly is a no-op rather than running an arbitrary test.
export @symbol("bit_rt_test_index") function rtTestIndex(): int {
  let vp = gcEnvValuePtr("BIT_TEST_INDEX")
  if (vp < 0) {
    return testIndexNone
  }
  return testIndexParse(vp)
}
