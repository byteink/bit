// THE SLOT TABLE (#5796): everything one map operation indexes, as ONE object.
// Sibling of `maps.bit` (hash, probe, grow, the ABI surface), `mapscalar.bit`
// (the four hot entry points), `mapswar.bit` and `mapcaps.bit`, same module.
//
// WHAT WAS WRONG. The header used to carry `cap`, `ctrl`, `keys` and `vals` as
// four separate words, and `mapGrow` replaced them with four plain stores. A
// reader on another worker loaded them as four plain loads, with nothing
// ordering either side, so it could pair a NEW `ctrl` with an OLD `cap` (a
// probe from the wrong home slot: a false miss), an old `cap` with a new
// `keys`, or a NEW `cap` with an OLD `ctrl` — an index up to `2*cap - 1` into a
// `cap`-byte array, which is a read past the allocation. And the comma-ok read
// is TWO calls, `bit_rt_map_slot` then `bit_rt_map_val_at`, each loading
// `vals` afresh: a grow between them indexed the NEW `vals` with the OLD slot,
// so `ok=true` came back carrying another key's value. `_tests_/stress/maprace`
// measured both on main at BIT_WORKERS=4.
//
// THE LAYOUT. A table is one GC object: a fixed prefix `{cap, keys, vals}` and
// then `cap` ctrl bytes inline. `riMapTbl` (root.bit) traces `keys` and `vals`
// in the prefix and leaves the ctrl bytes untraced, the same fixed-prefix-plus-
// raw-tail shape `riString` uses. The ctrl bytes are INLINE rather than a third
// buffer so a probe reaches them in the same number of dependent loads as
// before (`m` -> table -> byte, where it was `m` -> ctrl -> byte): the one
// pointer costs no extra load on the path every lookup takes.
//
// CODE HOLDS A TABLE BY ITS CTRL BYTES, `c`, not by its object base: `mapTable`
// returns `base + tblPrefix`, the prefix words sit at the NEGATIVE offsets
// `tblCap`/`tblKeys`/`tblVals` from it, and slot `i`'s ctrl byte is `c + i`.
// One register then names the whole table. Holding the base as well as the
// ctrl pointer made every probe loop one value wider, and the server A/B on
// b6375a61d paid for it: `mapProbe`'s loop spilled `m` and reloaded it on
// every tag match, `rtMapSet`'s frame grew 0x90 -> 0xa0, and strmap retired
// 2.02% more instructions on Graviton3 (+4.17% cycles on a Xeon 8168). The
// base is seen only by `mapPublish`, the collector, and the first two loads of
// the read-only scalar entry points (`mapTableBase`, below).
//
// THE INVARIANT. A table's prefix is written before it is published and never
// after, and every buffer it names holds exactly `cap` slots. The header's
// `mapTbl` word is written by `mapPublish` alone (a release store, after the
// rehash has filled the new buffers) and read only by `mapTable` and
// `mapTableBase` (plain loads, whose ordering the note on `mapTable` argues). So a reader that loads
// the table word ONCE and derives `cap`, the
// ctrl bytes, `keys` and `vals` from that one table sees a table that was
// complete when it was published, and every index it computes is `h & (cap-1)`
// or bounded by `< cap` of THAT table: in bounds by construction, whatever a
// writer on another worker publishes meanwhile. Every entry point below and in
// `mapscalar.bit`/`mapswar.bit` loads the table once and threads it through
// its helpers (`mapProbe`, `mapProbeSwar`, `mapClaimSlot`) instead of letting
// them reload it.
//
// A table's slot CONTENTS are still written in place by `m[k] = v` and
// `delete`, exactly as before; what is immutable is the prefix, which is what
// every bound is computed from.
//
// THE CALL PAIR, AND WHY NO INDEX CROSSES IT. `bit_rt_map_slot` cannot hand an
// index to `bit_rt_map_val_at`: the second call would have to load the table
// again, and a grow in between moves the key to a different slot of a
// different table. No index encoding repairs that without the key, and the key
// is not an argument of `map_val_at` (ABI.md §15; adding it is an ABI change
// the pinned stage0 cannot build). So a HIT returns a TOKEN instead: the
// address of the key's value word in the table the probe used, tagged with
// `mapTokenBit`. `map_val_at` dereferences it without touching the header, so
// it reads the value word of the table the slot came from — by construction,
// not by a re-check.
//
// WHY THE TOKEN'S TABLE IS STILL THERE. The token is an untraced interior
// address, so it is safe exactly as long as nothing can free or move that
// table between the two calls. The collector never moves an object (ABI.md
// §5). It frees only after a stop-the-world mark, and a mutator reaches a stop
// only at a back-edge poll (§5: "at loop back-edges, and nowhere else").
// `emitMapCommaOk` (compiler/lowermapaccess.bit) emits the two calls back to
// back with no back edge between them, both callees are `@nosplit` and call
// nothing that parks — the adjacency contract (§5.1). So no collection can
// begin between the calls, the table the probe used is intact when
// `map_val_at` reads it, and the token addresses `vals + i*8` with `i < cap`
// of that table: in bounds. The word it names holds a value some write
// actually stored for that key (SPEC §13.7) — the rehash copy or a later `set`
// on that table; once a grow has retired it, no `set` writes it again.
//
// ITERATION STILL PASSES INDICES. `map_iter_next` returns a plain slot index
// and the loop body runs between it and `map_key_at`/`map_val_at` — a body
// with back-edge polls, where an address would not survive. An index cannot
// collide with a token: an index is below its table's `cap`, far below 2^62,
// and a token is 2^62 plus a user address, which is below 2^57 on both targets
// even under x86-64 five-level paging. So `map_val_at` tells the two apart by
// magnitude, and the index path bounds-checks against the table it loads.
// That check is not redundant with "grow never shrinks": two concurrent
// WRITERS can each rehash the same old table and publish out of order, which
// does shrink `cap`, and a racing iteration must still read in bounds (SPEC
// §13.5 leaves its RESULT unspecified, never its memory safety).
//
// No imports: the helpers here use only what the root module already brings
// in (SPEC §17.1; a duplicate import is E0042).

// The prefix: `tblPrefix` bytes from the object base to the ctrl bytes, and
// `riMapTbl`'s declared size, since the traced part ends there. The three
// prefix words, as offsets from the ctrl pointer `c` that code holds.
export const tblPrefix: int = 24
export const tblCap: int = -24
export const tblKeys: int = -16
export const tblVals: int = -8

// `cap` and `keys` again, as offsets from the object BASE (`mapTableBase`).
// The read-only scalar entry points read both straight after loading the table
// word, and `base + 24` followed by `c - 24` is two instructions this backend
// does not fold away (#1853): one per lookup on the hottest path there is.
// `rtMapSet` does NOT use them: its probe loop spans a call, so everything
// live in it is callee-saved, and holding the base beside the ctrl pointer
// cost it a 0x90 -> 0xa0 frame, more than the one instruction saved.
const baseCap: int = tblPrefix + tblCap
const baseKeys: int = tblPrefix + tblKeys
const baseVals: int = tblPrefix + tblVals

// 1 << 62: marks a `bit_rt_map_slot` hit token. Bit 63 stays clear, so a token
// is still `>= 0` and the compiler's `ok = slot >= 0` holds unchanged, and a
// token is `>= mapTokenBit` where every iteration index is below it.
// `bit_rt_map_val_at` tests `slot < 0` first, which keeps a comma-ok MISS at
// main's five instructions (bench/cases/strmap's comma-ok reads are all
// misses), then `slot >= mapTokenBit`, the form b6375a61d used: e2461f835's
// bit test (`and`/`cbz`, then `eor`) is one of the two changes to the arm64
// comma-ok hit path that measured +5.7-7.3% on Graviton3 (mapscalar.bit).
const mapTokenBit: int = 4611686018427387904

// The current table's ctrl pointer. With `mapTableBase` below, the only reads
// of `mapTbl`.
//
// A PLAIN LOAD, NOT AN ACQUIRE, and the ordering still holds. Every read a
// caller makes through the result — the prefix words, the ctrl bytes, the
// `keys`/`vals` buffers through the prefix's pointers, and the value word a
// `bit_rt_map_slot` token names, whose address `bit_rt_map_val_at` receives in
// a register — takes its ADDRESS from this load's value. Both targets order a load after the load its address
// depends on: x86-64 orders every load after every earlier load (TSO), and
// ARMv8 orders an address-dependent read after the read that produced the
// address (the architecture's dependency ordering, the same guarantee Linux's
// `rcu_dereference` is a plain load for). Paired with `mapPublish`'s release,
// a reader that sees the new pointer sees everything written before it. The
// backend keeps that dependency: it computes each address from the loaded
// register and never predicts a loaded value. `atomicLoad` was an `ldar` on
// arm64, whose RCsc ordering against every earlier store-release this path
// never needed; x86 already emitted a plain `mov` for it.
@nosplit fn mapTable(m: int): int {
  return loadWord(m + mapTbl) + tblPrefix
}

// The same load, returning the object base: for the scalar entry points,
// which read `cap` and `keys` at `baseCap`/`baseKeys` from it and then hold
// only the ctrl pointer, `base + tblPrefix`. Not written as a call from
// `mapTable` or into it: the inliner splices one level, and a nested call left
// `mapTable` out of line, which gave `bit_rt_map_val_at` a frame.
@nosplit fn mapTableBase(m: int): int {
  return loadWord(m + mapTbl)
}

// The ONLY write of `mapTbl`: a release store of the object base, after the
// table at ctrl pointer `c` is filled.
@nosplit fn mapPublish(m: int, c: int) {
  atomicStoreRelease(wordAt(m + mapTbl), c - tblPrefix)
}

// A `*u8` at the ctrl byte of slot `i` of table `c`.
@nosplit fn mapCtrlAt(c: int, i: int): *u8 {
  let n: *u8 = nil
  return n + (c + i)
}

// The ONLY write of a FULL ctrl tag into a published table: a release store,
// after the caller wrote the slot's key and value words (#5813). A plain
// `storeByte` lets arm64 make the tag visible before the value word, so a
// reader that matched the new tag and key loaded the zero a fresh table holds.
//
// PLAIN WHILE `mapPeers` READS 0 (#7784): the `stlrb` cost bench/cases/map
// 7-12% cycles on one worker, where no other core reads. Only worker threads
// run Bit code, and every thread holding a stale 0 here is worker 0 (any other
// worker starts after `mapPeersMark`, thread creation ordering it), so the
// question is only whether worker 0 can plain-store while a peer reads. The
// mark has three writers' paths: boot (`schedInit`, before any worker thread),
// worker 0's own grow (program order), and the monitor's retake, which runs
// while worker 0 sits in a syscall/blocked bracket. That last one is a Dekker
// pair, each side's store and load split by a `dmb ish` (`worldFence`):
//   monitor: `mapPeersMark` store; fence; load worker 0's registry state
//            (`rootRetakeConfirm`, ../root/retake.bit); start only if it is
//            still `mSyscall`/`mBlocked`, else abandon (`schedGrowCommit` 0).
//   worker 0: the bracket exit's `mRunning` store (`worldResumeWhenClear`);
//            fence (`gcSyscallEnd`/`gcBlockingEnd`); every later load here.
// Both loads cannot read the old value. So either the monitor abandons, or
// worker 0 reads 1 from its first store after the bracket. Its plain stores
// before the bracket precede the bracket's `atomicStore` of the state, which
// the monitor's `atomicLoad` reads before it creates the thread, so the peer
// starts with them visible. x86-64 orders stores anyway and never asks.
@nosplit fn mapCtrlPublish(c: int, i: int, tag: int) {
  if (onX64() || loadWord(int(ptrOf(mapPeers))) == 0) {
    storeByte(c + i, tag)
    return
  }
  atomicStoreRelease(mapCtrlAt(c, i), u8(tag))
}

// The ACQUIRE half, as an ADDRESS DEPENDENCY, not an acquire load. A probe
// that matched `tag` in `c`, its plain load of slot `i`'s ctrl byte, adds this
// to the address of every word it loads from the slot (the key, and the value
// or the token naming it): `c - tag` is zero there, but the register carries
// the ctrl load's result into those addresses, and ARMv8 orders a load after
// the load its address depends on, whatever the value (the guarantee
// `mapTable` argues for the table pointer). Observing the tag
// `mapCtrlPublish` released then makes the key and value words written before
// it visible. The first version re-loaded the byte with `atomicLoad` (an
// `ldarb`): correct, and +12% cycles on bench/cases/map, whose loop is bound by
// cache misses that an acquire stops overlapping. x86-64 orders loads anyway,
// so it adds nothing there. A hit returns `i + d` for the same reason: the
// caller loads the value through the returned slot.
//
// ONLY WHILE A SECOND WORKER CAN EXIST. The dependency still cost bench/cases/map
// +10% cycles: the key and value misses wait for the ctrl miss instead of
// overlapping it. A program on one worker thread cannot see another core's
// reordering, so this returns 0 there, and the `+ d` loads carry no
// dependency. `mapPeers` is checked AFTER the tag matched, through an address
// that depends on `c` too, which is what makes a stale 0 safe: the flag load is
// ordered after the ctrl load, so a probe that reads 0 read a ctrl byte older
// than `mapPeersMark`'s store, and every worker thread but the reader's own is
// started after that store (thread creation orders it first), so the byte was
// written by the reader's own thread, whose key and value stores precede it in
// program order. A probe that reads 1 takes the dependency. Never a branch-free
// select here: that would make `d` depend on the flag load as well and put the
// load latency on every hit.
@nosplit fn mapTagDep(c: int, tag: int): int {
  if (onX64()) {
    return 0
  }
  let d = c - tag
  if (loadWord(int(ptrOf(mapPeers)) + d) == 0) {
    return 0
  }
  return d
}

// Whether slot `i` of table `c` still holds the key a probe just matched, for
// the one match the plain compare cannot vouch for: a key WORD of 0 (#7772).
// `mapDropKey` (mapscalar.bit) zeroes a deleted string or composite key, and 0
// compares equal to "" and to the zero composite, so a probe that loaded the
// FULL tag before the delete and the key word after it matched a lookup key
// that was never in the map and went on to return the deleted key's value. The
// delete stores the TOMB first and the zero with release; this loads the key
// word with acquire and then the tag, so a zero read from the delete's store
// is followed by a tag read that sees the TOMB. A tag still `tag` means the key
// really is 0 (a stored "" or nil), or the delete has not begun, and either
// answer is allowed. A non-zero acquire read is a key written after the plain
// read, a writer racing the reader, whose key is the answer. Both loads are
// `atomicLoad` rather than plain so the optimizer cannot fold the tag read into
// the probe's earlier one. Callers test `k != 0` first: a stored key word is 0 only
// for "", a nil key or the scalar 0, so the common hit pays one compare and no
// call. And they test it BEFORE the key compare, not after: the string compare
// is a call, and a test after it kept `k` and the ctrl byte live across it, two
// more callee-saved registers in every probe loop (#7812: `mapProbeStr` 0x60 ->
// 0x70, `mapProbeSwar`/`mapProbeSwarStr` 0x70 -> 0x80). A dead slot matches no
// key, so the order changes no answer.
@nosplit fn mapKeyLive(c: int, keys: int, i: int, tag: int): bool {
  if (atomicLoad(wordAt(keys + i * 8)) != 0) {
    return true
  }
  return int(atomicLoad(mapCtrlAt(c, i))) == tag
}

// 1 once a second worker slot has been prepared, set before its thread is
// created and never cleared; 0 for the whole life of a one-worker program.
let mapPeers: [1]i64

// The only writer of `mapPeers`: `schedInitWorkerSlot` (../sched/worker.bit)
// calls it for every slot past the first, at boot when `BIT_WORKERS` > 1 and
// on every later grow, before that slot's thread exists. Pinned because
// `runtime/sched` cannot import this module and reaches it through `extern`.
export @nosplit @symbol("bit_rt_port_root_map_peers_mark") fn mapPeersMark() {
  atomicStore(ptrOf(mapPeers), 1)
}

// A fresh `vcap`-slot table for map `m`, every ctrl byte EMPTY (`gcAllocRaw`
// zeroes); returns its ctrl pointer. Tracing of `keys`/`vals` follows the
// header's key descriptor and value flag, as `rtMapNew` documents. Exhaustion
// is fatal inside `gcAlloc*` (root.bit constraint 3), never a returned 0.
@nosplit fn allocTable(m: int, vcap: int): int {
  let g = wordAt(gcAddr)
  let base = infoAddr
  // `elemSize` is explicit 8: maps stay word-per-element regardless of key/value
  // type (ABI.md §2/#3119).
  let keys = allocBuf(vcap, loadWord(m + mapKeyDesc) != mapKeyScalar, 8)
  let vals = allocBuf(vcap, loadWord(m + mapValIsRef) != 0, 8)
  let c = gcAllocRaw(g, tblPrefix + vcap, base + riMapTbl * 8) + tblPrefix
  storeWord(c + tblCap, vcap)
  storeWord(c + tblKeys, keys)
  storeWord(c + tblVals, vals)
  return c
}

// The token `bit_rt_map_slot` returns for a hit at slot `i` of table `c`.
@nosplit fn mapValToken(c: int, i: int): int {
  return (loadWord(c + tblVals) + i * 8) | mapTokenBit
}

// The same token from the table's BASE `tb`, in the form b6375a61d built it
// at the hit inside the arm64 probe loop (`rtMapSlot`, mapscalar.bit): the bit
// added rather than or-ed. Identical value, since the address is below 2^62.
@nosplit fn mapValTokenBase(tb: int, i: int): int {
  return mapTokenBit + loadWord(tb + baseVals) + i * 8
}

// The seed every map hash starts from, and the ONE place it is read: `mapHash`
// and `scalarHash` (maps.bit), the `_str` probes (mapstr.bit) and the compiler's
// synthesized `__valueHash` (SPEC §14.3, via `rtMapHashSeed`) all take it from
// here. `hashSeed` is the per-process word boot draws (hashseed.bit, #7379).
@nosplit fn mapHashSeed(): u64 {
  return hashSeed
}

export @nosplit @symbol("bit_rt_map_hash_seed") fn rtMapHashSeed(): u64 {
  return mapHashSeed()
}
