// Split out of `root.bit` (#1503): the `[]T` entry points (ABI.md §2).
// Sibling file, same module — see `root.bit` for the port's header and seams.

// ---------------------------------------------------------------------------
// Slices (ABI.md §2)
// ---------------------------------------------------------------------------

// `bit_rt_slice_new`: a fresh `[]T` of length `len`, capacity `max(len, cap)`,
// elements zeroed. Backs slice literals (`len == cap == N`) and `[]T(n[, m])`.
export @nosplit @symbol("bit_rt_slice_new")
function rtSliceNew(want: int, capWant: int, isRef: int): int {
  let c = capWant
  if (c < want) {
    c = want
  }
  let g = wordAt(gcAddr)
  let base = infoAddr
  let h = gcAlloc(g, base + riSlice * 8)
  if (h == 0) {
    statOom = statOom + 1
    return 0
  }
  let buf = allocBuf(c, isRef != 0)
  if (buf == 0) {
    return 0
  }
  storeWord(h + slcBuf, buf)
  storeWord(h + slcLen, want)
  storeWord(h + slcOff, 0)
  storeWord(h + slcCap, c)
  storeWord(h + slcIsRef, isRef)
  return h
}

// `bit_rt_slice_append`: appends one word, DOUBLING FROM 1 when full. A grow
// reallocates from the current view and resets `off` to 0. Mutates the header in
// place and returns it, so `s = append(s, x)` observes the new length and buffer
// through the same value — which is also why `append` aliases its argument's
// backing, a documented hazard for callers.
//
// A NULL HEADER APPENDS INTO A FRESH SLICE rather than mutating through null
// (#1564/#1570): a zeroed struct's slice field is the null word (SPEC §13.4),
// and `append` must treat it as the empty slice. It cannot reuse a shared empty
// — `append` grows the header IN PLACE, so a process-wide empty would be
// corrupted by the first append anywhere (#1557). `rtSliceNew` can itself return
// 0 on exhaustion (constraint 3), which the caller already has to handle here.
//
// `isRef` is UNRECOVERABLE from a null header — there is no header to read it
// from, and the element type never made the wire — so it travels as a third
// argument instead (ABI.md §2, #1569), exactly as `runtime/root/`'s `appendTarget`
// takes it. A non-null header ignores it and keeps its own `isRef`, set once
// at `rtSliceNew`.
@nosplit function appendTarget(h: int, isRef: int): int {
  if (h == 0) {
    return rtSliceNew(0, 0, isRef)
  }
  return h
}

export @nosplit @symbol("bit_rt_slice_append")
function rtSliceAppend(hIn: int, word: int, isRef: int): int {
  let h = appendTarget(hIn, isRef)
  if (h == 0) {
    return 0
  }
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  if (vlen == vcap) {
    let newcap = vcap * 2
    if (vcap == 0) {
      newcap = 1
    }
    let bufIsRef = loadWord(h + slcIsRef)
    let nb = allocBuf(newcap, bufIsRef != 0)
    if (nb == 0) {
      return 0
    }
    let old = loadWord(h + slcBuf)
    let i = 0
    while (i < vlen) {
      let w = loadWord(old + (off + i) * 8)
      storeWord(nb + i * 8, w)
      i = i + 1
    }
    storeWord(h + slcBuf, nb)
    storeWord(h + slcOff, 0)
    storeWord(h + slcCap, newcap)
    off = 0
  }
  let buf = loadWord(h + slcBuf)
  storeWord(buf + (off + vlen) * 8, word)
  storeWord(h + slcLen, vlen + 1)
  return h
}

// `bit_rt_slice_get`: bounds-checked element read. A panic is the natural
// answer out of range;
// see constraint 3 — `ok` is reported through `rtSliceInBounds` for a caller that
// must distinguish, and the value reads 0.
//
// A null header (a zeroed struct's slice field, #1564/#1570) has LENGTH 0, so
// every index is out of range — the identical answer an empty slice gives, and
// the same one `runtime/root/` reaches by panicking on both.
export @nosplit @symbol("bit_rt_slice_get")
function rtSliceGet(h: int, index: int): int {
  if (h == 0) {
    return 0
  }
  let vlen = loadWord(h + slcLen)
  if (index < 0 || index >= vlen) {
    return 0
  }
  let off = loadWord(h + slcOff)
  let buf = loadWord(h + slcBuf)
  let w = loadWord(buf + (off + index) * 8)
  return w
}

// Whether `index` is a legal element of `h`. The predicate the bounds check
// panics on, exposed so the panic can be raised by the layer that owns the
// write path (SEAM 3) rather than swallowed here.
//
// A null header is length 0, so NO index is in bounds — which is exactly how the
// caller that owns the panic learns that indexing a zeroed struct's slice field
// must fault, matching `runtime/root/`'s `fatal("index out of range")` on null.
export @nosplit @symbol("bit_rt_slice_in_bounds")
function rtSliceInBounds(h: int, index: int): bool {
  if (h == 0) {
    return false
  }
  let vlen = loadWord(h + slcLen)
  return index >= 0 && index < vlen
}

// `bit_rt_slice_set`: bounds-checked element write. Out of range is a no-op
// (constraint 3); `rtSliceInBounds` is the check a caller raises on.
//
// Null is the length-0 case again: no index is writable, so the write is
// dropped rather than stored through null.
export @nosplit @symbol("bit_rt_slice_set")
function rtSliceSet(h: int, index: int, word: int) {
  if (h == 0) {
    return
  }
  let vlen = loadWord(h + slcLen)
  if (index < 0 || index >= vlen) {
    return
  }
  let off = loadWord(h + slcOff)
  let buf = loadWord(h + slcBuf)
  storeWord(buf + (off + index) * 8, word)
}

// `bit_rt_slice_slice`: `s[lo:hi]` (SPEC §12.6). SHARES `s`'s buffer; the new
// view is `buf[off+lo .. off+hi]` with capacity extending to the old end
// (`cap - lo`, Go semantics). Returns 0 unless `0 <= lo <= hi <= cap`.
//
// A null header (#1564/#1570) is the empty slice: capacity 0, so `[0:0]` is the
// ONLY in-bounds reslice of it. Its result is a FRESH empty slice, never a view
// onto a shared body — the same rule `rtSliceAppend` obeys, and for the same
// reason (a later `append` grows a view's header in place). Any other range is
// out of bounds and returns 0, which is this port's form of `runtime/root/`'s
// `fatal("slice bounds out of range")` (constraint 3).
export @nosplit @symbol("bit_rt_slice_slice")
function rtSliceSlice(h: int, lo: int, hi: int): int {
  if (h == 0) {
    if (lo != 0 || hi != 0) {
      return 0
    }
    return rtSliceNew(0, 0, 0)
  }
  let vcap = loadWord(h + slcCap)
  if (lo < 0 || lo > hi || hi > vcap) {
    return 0
  }
  let g = wordAt(gcAddr)
  let base = infoAddr
  let nh = gcAlloc(g, base + riSlice * 8)
  if (nh == 0) {
    statOom = statOom + 1
    return 0
  }
  let off = loadWord(h + slcOff)
  storeWord(nh + slcBuf, loadWord(h + slcBuf))
  storeWord(nh + slcLen, hi - lo)
  storeWord(nh + slcOff, off + lo)
  storeWord(nh + slcCap, vcap - lo)
  storeWord(nh + slcIsRef, loadWord(h + slcIsRef))
  return nh
}
