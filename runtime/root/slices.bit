// Split out of `root.bit` (#1503): the `[]T` entry points (ABI.md §2).
// Sibling file, same module — see `root.bit` for the port's header and seams.

// ---------------------------------------------------------------------------
// THE BOUNDS PANICS (SPEC §12.6, §18.4, #2014)
// ---------------------------------------------------------------------------
//
// SPEC §12.6 requires an out-of-range index or re-slice to PANIC, and this port
// swallowed all five: `rtSliceGet` returned 0, `rtSliceSet` dropped the write,
// `rtSliceSlice` returned 0, `rtStringByte` returned -1 and `rtStringSlice`
// returned 0. So `xs[9]` on a 3-element slice evaluated to 0 and the program ran
// on with fabricated data and exited 0 — a memory-safety net turned into a wrong
// answer, which is strictly worse than the crash it replaced. Every release
// through 0.1.8 shipped that way and no golden covered it.
//
// The four comments that documented the swallow all deferred the panic to "the
// layer that owns the write path", and `rtSliceInBounds` was exported so that
// layer could raise it. NO SUCH CALLER WAS EVER WRITTEN — nothing in `compiler/`
// references `slice_in_bounds` at all, so lowering emitted bare `slice_get`/
// `slice_set` and the panic was lost end to end. The check was always here; only
// the report was missing. That is why the fix belongs here and needs no compiler
// change: these five entry points already compute the predicate.
//
// `root.bit` constraint 3 says `@nosplit` cannot panic. That was true when it was
// written and is not any more — `bit_rt_panic` is itself `@nosplit` (`<os>/io.bit`),
// and #2016/#2018/#2240 have since raised three argument-free panics from exactly
// this position (ABI.md §12.1). What `@nosplit` still forbids is ALLOCATING
// (E0075), so the message cannot be a heap string. Constraint 3's OOM rule is
// FATAL, NOT A RETURNED 0 (#1642): `gcAlloc` reaches `bit_rt_oom` directly on
// exhaustion — it writes `panic: out of memory` to fd 2, exits 2, and NEVER
// RETURNS — so none of this file's allocating entry points can observe a 0 body
// any more, and none carries an OOM check (#3013 removed the pre-#1642
// `if (h == 0) { statOom = statOom + 1 }` branches this file used to have,
// matching `root.bit`'s #2750).

// `bit_rt_panic` (ABI.md §12) reached by ABI symbol rather than by import: it is
// defined in `<os>/io.bit`, a different module, and `runtime/root` is
// platform-free so it cannot define the write path itself. This is the same door
// `runtime/chan/chanwrap.bit` opens for `bit_rt_oom`, legal inside a `@nosplit`
// body (SPEC §11.7, #1640), and it is what makes the port's platform-split panic
// wall irrelevant here.
//
// Routed through `bit_rt_panic` rather than through three new
// `bit_rt_panic_*_out_of_range` symbols beside §12.1's: these three panics are
// raised INSIDE an existing runtime entry point, not injected by a backend at an
// operation, so no new ABI surface is needed and the rendering (`panic: <msg>\n`,
// exit 2) is literally the same code path as `panic("x")` rather than a second
// spelling of it.
extern fn bit_rt_panic(msg: int)

// The three messages, packed little-endian into i64 words exactly as
// `<os>/io.bit`'s `oomWord0`/`divZeroWord0` are, and for the identical reason:
// the panic path must not allocate. Computed, not hand-derived. A trailing
// partial word is zero-padded and its real length carried alongside, so only the
// message bytes are ever written.
//
//   "index out of range"         (18) = "index ou" "t of ran" "ge"
//   "slice bounds out of range"  (25) = "slice bo" "unds out" " of rang" "e"
//   "string bounds out of range" (26) = "string b" "ounds ou" "t of ran" "ge"
//
// The wording is 0.1.2's, the last release that panicked here, and it is also
// what the four swallow comments this fix replaces each named as the answer they
// owed.
const idxOobWord0: int = 8462017926321696361
const idxOobWord1: int = 7953763900396085364
const idxOobWord2: int = 25959
const idxOobLen: int = 18

const slcOobWord0: int = 8026013105759284339
const slcOobWord1: int = 8391735665840385653
const slcOobWord2: int = 7453001576142499616
const slcOobWord3: int = 101
const slcOobLen: int = 25

const strOobWord0: int = 7070765138884850803
const strOobWord1: int = 8462017904830739823
const strOobWord2: int = 7953763900396085364
const strOobWord3: int = 25959
const strOobLen: int = 26

// The `{ptr, len}` string header (ABI.md §2) plus the inline message bytes that
// `bit_rt_panic` reads, assembled on the panic path. Two header words plus four
// text words: 32 bytes of text, and the longest message is 26.
//
// MODULE STATE, NOT A LOCAL, for the same reason `<os>/io.bit`'s `ioConstBuf` and
// `fs.bit`'s `fsPathBuf` are: `ptrOf` needs an addressable object and `@nosplit`
// forbids allocating one per call (E0075) — and the panic path is precisely the
// path that must still work when allocation is what failed. Scalar, so the
// collector never scans it (root.bit constraint 1, ABI.md §5 rule 1), which is
// required and not merely allowed: it holds a byte address, never an object
// reference. Length 6 is a literal because a module-state array's length must be
// (root.bit's note on `gcState`).
//
// UNLOCKED AND NON-REENTRANT, and that is sound here in a way it would not be
// anywhere else in this file: the only writer never returns. `bit_rt_panic`
// exits the process, so no second caller can observe a half-filled buffer and
// there is no window for one to interleave.
let boundsMsg: [6]i64

// Which of the three messages to report. ONE ARGUMENT, SELECTED INSIDE, NOT FIVE
// PACKED WORDS PASSED IN, and the reason is measured rather than stylistic.
//
// `bit_rt_slice_get` is the hottest symbol in the language — every `xs[i]` in
// every program is a call to it. The first draft of this fix passed the words as
// arguments through a per-message wrapper; `compiler/optinline.bit`'s 8-instruction
// budget then spliced that wrapper into `rtSliceGet`, so its cold branch
// materialized five 64-bit immediates (`movk` x3 apiece) inside the hot function.
// That is what the cost showed up as: with a call anywhere in the body regalloc
// promotes the function's values to CALLEE-SAVED registers, and the extra live
// constants took the saved set from x29/x30 to x19-x27 — the frame grew 0x10 ->
// 0x60 and the prologue from 2 stores to 11, on the FAST path, which pays for a
// panic it never takes. Measured at +8% on a pure-index loop.
//
// Selecting on a small immediate keeps the whole cold path out of line: the guard
// branch is now `mov` of one constant plus a `bl`, and the words are materialized
// in a function that is about to exit the process anyway.
const oobIndex: int = 0
const oobSliceRange: int = 1
const oobStringRange: int = 2

// Report the `kind` message and abort. NEVER RETURNS.
//
// Writes all four text words unconditionally — a short message zero-pads, and
// `nbytes` is what bounds the kernel write, so the padding is never emitted.
// Four stores are cheaper than branching on the length on a path that is about
// to make a syscall and exit.
//
// An unrecognised `kind` cannot happen (all three callers pass a const above),
// and reports `index out of range` rather than asserting: this is the panic path,
// and a wrong message beats a second panic inside the first.
@nosplit fn panicBounds(kind: int) {
  let w0 = idxOobWord0
  let w1 = idxOobWord1
  let w2 = idxOobWord2
  let w3 = 0
  let nbytes = idxOobLen
  if (kind == oobSliceRange) {
    w0 = slcOobWord0
    w1 = slcOobWord1
    w2 = slcOobWord2
    w3 = slcOobWord3
    nbytes = slcOobLen
  } else if (kind == oobStringRange) {
    w0 = strOobWord0
    w1 = strOobWord1
    w2 = strOobWord2
    w3 = strOobWord3
    nbytes = strOobLen
  }
  let base = int(ptrOf(boundsMsg))
  let text = base + strHeaderSize
  storeWord(base + strPtr, text)
  storeWord(base + strLen, nbytes)
  storeWord(text + 0, w0)
  storeWord(text + 8, w1)
  storeWord(text + 16, w2)
  storeWord(text + 24, w3)
  bit_rt_panic(base)
}

// ---------------------------------------------------------------------------
// Slices (ABI.md §2)
// ---------------------------------------------------------------------------

// `bit_rt_slice_new`: a fresh `[]T` of length `len`, capacity `max(len, cap)`,
// elements zeroed. Backs slice literals (`len == cap == N`) and `[]T(n[, m])`.
// `elemSize` is the static element type's byte stride (ABI.md §9, #3119/#3120)
// and needs no change here: `allocBuf` already sizes the body as
// `words * elemSize` (#3120), so a packed `[]u8`'s body is the right number of
// bytes the moment a caller passes `elemSize == 1` — which the compiler now
// does for every `[]u8` (`sliceElemSizeFor`, #3121/#3226); `rtSliceGet`/
// `rtSliceSet`/`rtSliceAppend` below address it byte-for-byte to match.
export @nosplit @symbol("bit_rt_slice_new")
fn rtSliceNew(want: int, capWant: int, isRef: int, elemSize: int): int {
  let c = capWant
  if (c < want) {
    c = want
  }
  let g = wordAt(gcAddr)
  let base = infoAddr
  let h = gcAlloc(g, base + riSlice * 8)
  let buf = allocBuf(c, isRef != 0, elemSize)
  storeWord(h + slcBuf, buf)
  storeWord(h + slcLen, want)
  storeWord(h + slcOff, 0)
  storeWord(h + slcCap, c)
  storeWord(h + slcIsRef, isRef)
  return h
}

// `bit_rt_slice_append`: appends one word, DOUBLING FROM 1 when full. A grow
// reallocates from the current view and resets `off` to 0. Mutates the header in
// place and returns it, so `s = append(s, x)` observes the new length and buffer
// through the same value — which is also why `append` aliases its argument's
// backing, a documented hazard for callers.
//
// A NULL HEADER APPENDS INTO A FRESH SLICE rather than mutating through null
// (#1564/#1570): a zeroed class's slice field is the null word (SPEC §13.4),
// and `append` must treat it as the empty slice. It cannot reuse a shared empty
// — `append` grows the header IN PLACE, so a process-wide empty would be
// corrupted by the first append anywhere (#1557). `rtSliceNew` can no longer
// return 0 on exhaustion (constraint 3, #1642/#3013): exhaustion through
// `gcAlloc` is fatal, so its result here needs no OOM check either.
//
// `isRef` is UNRECOVERABLE from a null header — there is no header to read it
// from, and the element type never made the wire — so it travels as a third
// argument instead (ABI.md §2, #1569), exactly as `runtime/root/`'s `appendTarget`
// takes it. A non-null header ignores it and keeps its own `isRef`, set once
// at `rtSliceNew`.
@nosplit fn appendTarget(h: int, isRef: int, elemSize: int): int {
  if (h == 0) {
    return rtSliceNew(0, 0, isRef, elemSize)
  }
  return h
}

// `elemSize` travels alongside `isRef` for the same reason (#1569): a null `h`
// has no header to read it from either.
//
// PACKED `[]u8` (elemSize == 1, non-ref, #3121/#3226): the grow-copy and the
// new element both address byte-for-byte instead of the word stride. Live as
// of #3226: the compiler now passes `elemSize == 1` for every `[]u8`
// (`compiler/lowercall.bit`'s `sliceElemSizeFor`). Every other elemSize/isRef
// combination is unchanged (`* 8`, gated on isRef per epic #2941's
// constraint — a ref buffer stays word-per-element regardless of elemSize,
// since the collector's tracing loop walks it word by word).
export @nosplit @symbol("bit_rt_slice_append")
fn rtSliceAppend(hIn: int, word: int, isRef: int, elemSize: int): int {
  let h = appendTarget(hIn, isRef, elemSize)
  let vlen = loadWord(h + slcLen)
  let vcap = loadWord(h + slcCap)
  let off = loadWord(h + slcOff)
  let packed = elemSize == 1 && loadWord(h + slcIsRef) == 0
  if (vlen == vcap) {
    let newcap = vcap * 2
    if (vcap == 0) {
      newcap = 1
    }
    let bufIsRef = loadWord(h + slcIsRef)
    let nb = allocBuf(newcap, bufIsRef != 0, elemSize)
    let old = loadWord(h + slcBuf)
    if (packed) {
      copyBytes(nb, old + off, vlen)
    } else {
      let i = 0
      while (i < vlen) {
        let w = loadWord(old + (off + i) * 8)
        storeWord(nb + i * 8, w)
        i = i + 1
      }
    }
    storeWord(h + slcBuf, nb)
    storeWord(h + slcOff, 0)
    storeWord(h + slcCap, newcap)
    off = 0
  }
  let buf = loadWord(h + slcBuf)
  if (packed) {
    storeByte(buf + off + vlen, word)
  } else {
    storeWord(buf + (off + vlen) * 8, word)
  }
  storeWord(h + slcLen, vlen + 1)
  return h
}

// `bit_rt_slice_get`: bounds-checked element read. OUT OF RANGE PANICS (SPEC
// §12.6, #2014). `rtSliceInBounds` below is still the predicate for a caller
// that must ask rather than fault.
//
// A null header (a zeroed class's slice field, #1564/#1570) has LENGTH 0, so
// every index is out of range and panics — the identical answer an empty slice
// gives, and the same one `runtime/root/` reached by `fatal("index out of range")`.
//
// The `return 0` after each panic is unreachable: Bit has no `noreturn`, so the
// type checker still wants a value on that path.
// PACKED `[]u8` (elemSize == 1, non-ref, #3121/#3226): addressed byte-for-byte
// instead of the word stride below. Every other elemSize/isRef combination
// takes the unchanged `* 8` path. Live as of #3226: the compiler passes
// `elemSize == 1` for every `[]u8` (`compiler/lowerlit.bit`,
// `lowerassign.bit`, `loweraccess.bit` and `lowerprim.bit`, via
// `compiler/lowercall.bit`'s `sliceElemSizeFor`) — that flip landed atomically
// with this addressing arm, in the same commit, because either half without
// the other corrupts the heap: a packed allocation sized `n` read/written at
// a word stride walks off the end of the buffer. Gated on isRef too: a ref
// buffer stays word-per-element unconditionally regardless of elemSize (epic
// #2941's constraint), because the collector's tracing loop walks it word by
// word.
export @nosplit @symbol("bit_rt_slice_get")
fn rtSliceGet(h: int, index: int, elemSize: int): int {
  if (h == 0) {
    panicBounds(oobIndex)
    return 0
  }
  let vlen = loadWord(h + slcLen)
  if (index < 0 || index >= vlen) {
    panicBounds(oobIndex)
    return 0
  }
  let off = loadWord(h + slcOff)
  let buf = loadWord(h + slcBuf)
  if (elemSize == 1 && loadWord(h + slcIsRef) == 0) {
    return loadByte(buf + off + index)
  }
  let w = loadWord(buf + (off + index) * 8)
  return w
}

// Whether `index` is a legal element of `h`. The same predicate `rtSliceGet` and
// `rtSliceSet` panic on, exposed for a caller that must ASK instead of faulting.
//
// It was once exported so "the layer that owns the write path" could raise the
// panic these two swallowed; that caller was never written and the panic is now
// raised here, where the predicate already is (#2014). Nothing in `compiler/`
// references `slice_in_bounds`, so this has no in-tree caller today — it stays
// because a bounds question with no answer is worse than an unused entry point,
// and because removing an exported ABI symbol is not this fix's business.
//
// A null header is length 0, so NO index is in bounds.
export @nosplit @symbol("bit_rt_slice_in_bounds")
fn rtSliceInBounds(h: int, index: int): bool {
  if (h == 0) {
    return false
  }
  let vlen = loadWord(h + slcLen)
  return index >= 0 && index < vlen
}

// `bit_rt_slice_set`: bounds-checked element write. OUT OF RANGE PANICS (SPEC
// §12.6, #2014), where it used to be a silent no-op — the worse half of the pair,
// since a dropped write leaves the program reading a stale value it believes it
// has just replaced.
//
// Null is the length-0 case again: no index is writable, so every index panics.
// PACKED `[]u8` (elemSize == 1, non-ref, #3121/#3226): addressed byte-for-byte
// instead of the word stride below. See `rtSliceGet`'s comment for the full
// rationale and the ordering constraint this arm was activated under.
export @nosplit @symbol("bit_rt_slice_set")
fn rtSliceSet(h: int, index: int, word: int, elemSize: int) {
  if (h == 0) {
    panicBounds(oobIndex)
    return
  }
  let vlen = loadWord(h + slcLen)
  if (index < 0 || index >= vlen) {
    panicBounds(oobIndex)
    return
  }
  let off = loadWord(h + slcOff)
  let buf = loadWord(h + slcBuf)
  if (elemSize == 1 && loadWord(h + slcIsRef) == 0) {
    storeByte(buf + off + index, word)
    return
  }
  storeWord(buf + (off + index) * 8, word)
}

// `bit_rt_slice_slice`: `s[lo:hi]` (SPEC §12.6). SHARES `s`'s buffer; the new
// view is `buf[off+lo .. off+hi]` with capacity extending to the old end
// (`cap - lo`, Go semantics). PANICS unless `0 <= lo <= hi <= cap` (#2014, where
// it used to hand back 0 — which reads as an empty slice, so `xs[0:99]` silently
// became `[]` and every element the caller expected simply vanished).
//
// A null header (#1564/#1570) is the empty slice: capacity 0, so `[0:0]` is the
// ONLY in-bounds reslice of it, and its result is NULL AGAIN (#3648). Any other
// range panics, exactly as `runtime/root/`'s `fatal("slice bounds out of range")`
// did.
//
// THAT ARM USED TO RETURN `rtSliceNew(0, 0, 0, 8)`, AND IT WAS A BUG, not just
// two wasted objects. The fabricated header hard-codes `isRef = 0` — there is no
// receiver to copy the real answer from — and `rtSliceAppend` keeps a NON-NULL
// header's own `isRef` and ignores its argument. So `append(xs[0:0], someRef)`
// on a null `xs` allocated its buffer under the LEAF `slice_buf_info` descriptor
// instead of the traced `ref_array_info` one: the collector never walked the
// buffer and swept referents the program still held. `Bag{}.xs[0:0]` plus two
// appends plus heap churn printed empty strings, and
// `tests/cases/run_empty_slice_null_header.bit` is that reproduction.
//
// Returning null keeps the invariant the fresh header was there to provide — the
// result is never a view onto a shared body, so a later in-place `append` growth
// cannot reach anyone else's backing — and routes the append through
// `appendTarget`, which takes `isRef` from the COMPILER-SUPPLIED argument, the
// element type's true answer (ABI.md §2).
//
// The two checks above are the only ways out of this function without a fresh
// header: once both pass, `gcAlloc` below either succeeds or is fatal
// (constraint 3, #1642/#3013) — exhaustion never surfaces as a 0 return here.
export @nosplit @symbol("bit_rt_slice_slice")
fn rtSliceSlice(h: int, lo: int, hi: int): int {
  // A null receiver reslices to null (#3648) — see the header above for why the
  // fabricated header it used to return was a GC bug, not merely an allocation.
  if (h == 0) {
    if (lo != 0 || hi != 0) {
      panicBounds(oobSliceRange)
      return 0
    }
    return 0
  }
  let vcap = loadWord(h + slcCap)
  if (lo < 0 || lo > hi || hi > vcap) {
    panicBounds(oobSliceRange)
    return 0
  }
  let g = wordAt(gcAddr)
  let base = infoAddr
  let nh = gcAlloc(g, base + riSlice * 8)
  let off = loadWord(h + slcOff)
  storeWord(nh + slcBuf, loadWord(h + slcBuf))
  storeWord(nh + slcLen, hi - lo)
  storeWord(nh + slcOff, off + lo)
  storeWord(nh + slcCap, vcap - lo)
  storeWord(nh + slcIsRef, loadWord(h + slcIsRef))
  return nh
}
