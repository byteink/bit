// Split out of `root.bit` (#1503): the float entry points and SEAM 6
// (ABI.md §2, §17, §19). Sibling file, same module — see `root.bit` for the port's
// header and seams.

// ---------------------------------------------------------------------------
// Floats and host identity (ABI.md §2, §17, §19)
// ---------------------------------------------------------------------------

// SEAM 6 — THE PRIMITIVE-BACKED SYMBOLS. Mostly CLEARED by #1442; what is left
//   is named at the bottom of this block.
//
//   THE TRAP THIS BLOCK EXISTS TO RECORD, because it caught this file once and
//   very nearly caught a second agent porting the math six the same way: a Bit
//   "primitive" is NOT automatically a hardware instruction. Most entries in
//   compiler/lower.bit's primitive table lower to an `ir.RtFn`, which
//   compiler/arm64compile.bit and compiler/x64value.bit's `rtSymbol` emits as **a call to the very
//   `bit_rt_*` symbol being ported**. So
//
//       export @symbol("bit_rt_host_target")
//       function rtHostTarget(): int { return hostTarget() }
//
//   compiles to "call bit_rt_host_target" — and the moment #1369 drops
//   the `_root` infix it becomes A CALL TO ITSELF. It builds, links, passes
//   every golden and every differential, and detonates as a stack overflow only
//   after the rename. `--freestanding` does not catch it either: the reference
//   IS pinned, and `refuseUnpinnedImports` checks pinning, not identity.
//
//   GUARDED, not just documented: tests/bit/rootpins.bit re-emits this module,
//   performs #1369's rename symbolically on the emitted object, and fails on any
//   definition that would then reference itself. That gate — not this comment —
//   is what tells you whether a given primitive is safe to build a port on.
//
//   WHAT #1442 CHANGED. `fsqrt`, `floatBits`, `float32Bits`, `ffloor`, `fceil`,
//   `ftrunc` and `fround` were moved OUT of `prim_rt_fns` and into
//   `prim_unary_ops` in BOTH compilers (compiler/lower.bit `prim_unary_ops`,
//   compiler/lower.bit `primUnaryOp`). They are now inline IR ops — `FMOV` /
//   `FSQRT` / `FRINTM` / `FRINTP` / `FRINTZ` / `FRINTA` on AArch64 and an SSE2
//   expansion on x86-64 — so no `rt_call`, no cycle, and (being pure and
//   safepoint-free) they are admitted inside `@nosplit`. The seven exports below
//   are therefore real ports, and `./make test-rootpins` is the proof rather than
//   this paragraph.
//
//   THE MAGIC-CONSTANT IDENTITY IS NOT USED, and deliberately so. `(x + 2^52) -
//   2^52` was measured over 20 points and gives badFloor=0
//   badCeil=1 badTrunc=1, both failures being NEGATIVE ZERO: IEEE-754 makes
//   `ceil(-1e-300)` equal `-0.0` while the identity yields `+0.0`. That is
//   INVISIBLE to `==` (the two zeroes compare equal) and visible only in
//   `floatBits`, and it flips the printed string "-0" -> "0" — exactly what a
//   `const_float` golden compares. The rounding ops carry the correct sign of
//   zero natively, so the identity is not needed; the measurement is kept here
//   because the same trap applies to any future numeric reconstruction, and
//   because it is why `tests/stress/rootfloat` compares BIT PATTERNS, never
//   values.
//
//   THE RESIDUE OF SEAM 6 IS NOW EMPTY. It was two symbols, `bit_rt_auxv` and
//   `bit_rt_host_target`, and this block used to say neither was expressible in
//   Bit. Both are now ported, and NEITHER needed the compiler-side constant this
//   paragraph predicted — both stay `prim_rt_fns` entries, so `auxv()` and
//   `hostTarget()` still lower to a call to the symbol being ported, and each
//   provider simply gets the answer WITHOUT asking the primitive:
//
//   - `bit_rt_auxv` (#1617): a process-entry fact owned by the boot layer
//     (SEAM 3). The Linux entry captures the address once and the reader
//     `../root/os.bit`'s `rtAuxv` hands back the module cell DIRECTLY.
//   - `bit_rt_host_target` (#1635): a property of the emit, and the emit carries
//     both axes it needs. The OS is which provider directory the source sits in
//     (`root/linux/os.bit` vs `root/darwin/os.bit`, and the wrong one is a
//     compile error, not a wrong answer); the arch is an `asm` per-arch
//     immediate, `runtime/sched/sched.bit`'s `entryBias` shape, which is inline
//     by construction and so is not the `rt_call` this block warns about.
//
//   The warning above still stands for anything ported here NEXT: what changed
//   is that "the primitive is the only way to know" turned out to be false
//   twice, not that the cycle stopped being real.

// `bit_rt_sqrt` (ABI.md §17): IEEE-754 square root, backing std/math. One
// `FSQRT`/`sqrtsd`; correctly rounded by the hardware, which is why this cannot
// be a numeric reconstruction (see above).
export @nosplit @symbol("bit_rt_sqrt")
fn rtSqrt(x: f64): f64 {
  return fsqrt(x)
}

// `bit_rt_floor`/`ceil`/`round`/`trunc` (ABI.md §17): round an f64 to an
// integral f64. `fround` is ties-AWAY-from-zero, matching C99 `round()` and
// specifically NOT `FRINTN` / `roundsd` mode 0 (ties-to-even) — the two differ
// on every exact half, so they are not interchangeable.
export @nosplit @symbol("bit_rt_floor")
fn rtFloor(x: f64): f64 {
  return ffloor(x)
}

export @nosplit @symbol("bit_rt_ceil")
fn rtCeil(x: f64): f64 {
  return fceil(x)
}

export @nosplit @symbol("bit_rt_round")
fn rtRound(x: f64): f64 {
  return fround(x)
}

export @nosplit @symbol("bit_rt_trunc")
fn rtTrunc(x: f64): f64 {
  return ftrunc(x)
}

// `bit_rt_float_bits`/`bit_rt_float32_bits` (not in ABI.md's §9 pin table or
// anywhere else in the doc): the IEEE-754 encoding of a float as an unsigned
// integer, with no value conversion. This is the ONLY
// way a Bit program can observe -0.0 or distinguish two NaNs, and therefore the
// only sound basis for a float test — `==` reports `-0.0 == +0.0` as true and
// `NaN == NaN` as false, so it both passes broken implementations and fails
// correct ones. THE INVERSE EXISTS: `bitsToFloat(v: u64) -> f64` landed with
// #1609 and is documented in the SEAM 5b block below, so a float CAN be
// reconstructed from a manipulated pattern, not merely inspected. This comment
// asserted the opposite until #1661, and that stale claim is not harmless — the
// identical sentence in the `bit_rt_parse_float` note below is why that pin
// returned `u64` instead of `f64` and shipped the s0 register-class mismatch of
// #1655.
export @nosplit @symbol("bit_rt_float_bits")
fn rtFloatBits(v: f64): u64 {
  return floatBits(v)
}

export @nosplit @symbol("bit_rt_float32_bits")
fn rtFloat32Bits(v: f32): u32 {
  return float32Bits(v)
}

// ---------------------------------------------------------------------------
// SEAM 5a — FLOAT TEXT (ABI.md §2, #1578)
// ---------------------------------------------------------------------------
//
// `bit_rt_string_from_float` and `bit_rt_parse_float`: the shortest-round-trip
// f64->text formatter and the correctly-rounded text->f64 parser, both exact
// (Dragon4 / long division over bignums). The bodies live in the sibling files
// `floatbig.bit` (bignum), `floatfmt.bit` (`fmtBits`) and `floatparse.bit`
// (`parseBits`), ported verbatim from `bench/fptext` (#1539), measured at 0
// mismatches / 1,000,000 f64 patterns in both directions and mutation-tested.
//
// These two are the one pair in `runtime/root` that CANNOT simply take
// `@nosplit`, and #1658 restructured them instead. They allocate the digit
// buffers, the bignum limb arrays and the result string, and `@nosplit` forbids
// allocation outright (E0075), so the annotation is not available to them. What
// #1658 requires of every runtime ABI function is not the annotation but the
// property behind it: NO RAW GC ADDRESS MAY BE HELD ACROSS A POLL. So each of
// these two now keeps every raw address inside a small `@nosplit` helper
// (`packLowBytes` / `unpackToWords`) where no collection can occur, and holds
// only MANAGED values — which the stack map names and the precise walk finds —
// in the outer body. See #1656 for the mechanism; the members of this file's
// class were `out`/`dst` in `rtStringFromFloat` and `s`/`src` in `rtParseFloat`,
// each held raw across a byte-copy loop's back-edge poll.
//
// This is also why they are not the pin-cycle hazard SEAM 6 records —
// `fmtBits`/`parseBits` never reach the ABI name these wrappers become
// (`bit_rt_string_from_float` / `bit_rt_parse_float`); the only float bitcast in
// play is `floatBits`, a `prim_unary_op` (inline FMOV) since #1442, not an
// `RtFn`. `./make test-rootpins` is the proof.

// Pack `n` word-strided bytes at `src` into a fresh `string` object, returning
// its address (0 on exhaustion). The whole raw lifetime — allocate, take the
// interior pointer, fill — is inside this one `@nosplit` body, so no collection
// can happen between the allocation and the last write to it.
//
// `src` must be the buffer of a MANAGED `[]byte` that the CALLER still holds:
// the caller's slice is what keeps those bytes alive, and it can only do that
// because a `[]byte` local is a stack-map slot while a raw `int` is not.
@nosplit fn packLowBytes(src: int, n: int): int {
  let out = allocString(n)
  if (out == 0) {
    return 0
  }
  let dst = strBytes(out)
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadWord(src + i * 8) & 255)
    i = i + 1
  }
  return out
}

// The inverse: spread the `n` packed bytes of the `string` at raw address `s`
// one-per-word into the caller's managed `[]byte` buffer at `dst`. Same
// contract, same reason — `s` is a raw address, so it must not outlive a
// poll-free region, and this body has none.
@nosplit fn unpackToWords(dst: int, s: int, n: int) {
  let src = strBytes(s)
  let i = 0
  while (i < n) {
    storeWord(dst + i * 8, loadByte(src + i))
    i = i + 1
  }
}

// `bit_rt_string_from_float` (ABI.md §2, confirmed by the §9 pin table): the exact `{d}` decimal of `v`,
// returned as a `string` object address (an `int` at the C ABI — a pinned
// symbol cannot name a GC-managed type, E0079, so the boundary is raw exactly
// as `bit_rt_string_concat` returns `int`).
//
// TRAP #1 (the one the standalone experiment did not have to solve): the
// formatter works on a raw bit pattern, not an `f64`, because Bit has no
// bits->float primitive and the algorithm decomposes to sign/exponent/mantissa
// immediately. `floatBits` supplies the inverse at the boundary — a
// register-class transfer (`FMOV`/`movq`), not a numeric conversion, so `-0.0`,
// the infinities and every NaN survive intact. `fmtBits` then stays entirely in
// the integer domain and hands back a managed `string`; the loop copies its
// bytes into a fresh runtime string so no managed value crosses the pin.
//
// TRAP #2 (#1658): the copy loop used to be written out here, holding `out` and
// `dst` — a fresh GC string and an interior pointer into it — as raw `int`s
// across the loop's back-edge poll. No stack map named them, so a collection at
// that poll swept the string this function was in the middle of filling. The
// loop now lives in `packLowBytes`, which is `@nosplit` and therefore poll-free;
// what is left here holds only `s` and `bytes`, both MANAGED and so both real
// stack-map slots.
export @symbol("bit_rt_string_from_float")
fn rtStringFromFloat(v: f64): int {
  let s = fmtBits(floatBits(v))
  // `[]byte(s)` is word-strided (one byte per 8-byte word, ABI.md §2), so each
  // byte is the low octet of its word rather than a packed run — hence the
  // per-word read rather than a `copyBytes`.
  let bytes = []byte(s)
  return packLowBytes(int(ptrOf(bytes)), len(bytes))
}

// `bit_rt_parse_float` (not in ABI.md's §9 pin table or anywhere else in the
// doc): the nearest f64 to the decimal text at
// string address `s`. `_` separators are stripped inside `parseBits` (SPEC
// §5.4); unparsable text yields a quiet NaN (SPEC §5.3).
//
// THAT SENTENCE USED TO READ "unparsable text yields 0, as the spec requires",
// and the second half of it was false — SPEC had no `parseFloat` entry at all,
// so nothing required 0. The contract was invented here at the implementation
// and then cited as if specified, which is how a data-losing failure mode
// survived review twice (#2138). §5.3 now states the real contract, and
// `parseBits` returns the NaN this sentence promises.
//
// RETURNS `f64`, NOT THE RAW u64 PATTERN — and that is the whole of #1655.
// A `u64` return travels in the INTEGER return register (x0/rax); the `f64`
// `runtime/root/`'s `bit_rt_parse_float` declares, and that the IR types the
// `parse_float` RtFn as, travels in the FLOAT one (d0/xmm0). While this pin
// returned `u64` the two disagreed, so against a Bit-sourced `libbitrt.a` every
// caller read a float register the callee never wrote and EVERY FLOAT LITERAL
// FOLDED TO 0.0 — silently, since integers were unaffected.
//
// An earlier draft of this comment deferred the repair to a caller-side bitcast
// (`parse_float` joining `rtReturnsWord`) because Bit then had no bits->float
// primitive to spend here. #1609 landed one: `bitsToFloat` is the inverse of
// `floatBits`, an inline `bitcast` op (`FMOV`/`movq`, no numeric conversion, no
// rt_call, so still no pin cycle — `./make test-rootpins` is the proof). Spending
// it HERE fixes the mismatch at its source and is correct in both worlds: the
// pin now matches `runtime/root/` symbol-for-symbol, so it needs no compiler change
// and no ordering against G2's rename. Compensating in the caller instead would
// have been correct only AFTER the rename and a regression before it.
//
// `s` arrives as a raw `int` (E0079 again). Its packed bytes are lifted into a
// managed `string` so `parseBits` can consume them; the round trip through
// `[]byte` is cheap on the ~24-char inputs a float literal ever spans.
//
// AND THE LIFT MUST BE POLL-FREE (#1658), for the same reason as its twin above:
// the loop that used to stand here held `s` and `src` — the caller's string and
// an interior pointer into it — as raw `int`s across a back-edge poll, so a
// collection there could sweep the very text being parsed. `unpackToWords` is
// `@nosplit`, so nothing can collect while those raw values are live, and after
// it returns only the managed `bytes` is needed.
export @symbol("bit_rt_parse_float")
fn rtParseFloat(s: int): f64 {
  let n = strSize(s)
  let bytes = []byte(n)
  unpackToWords(int(ptrOf(bytes)), s, n)
  return bitsToFloat(parseBits(string(bytes)))
}

// ---------------------------------------------------------------------------
// SEAM 5b — THE FIVE TRANSCENDENTALS (ABI.md §17, #1609)
// ---------------------------------------------------------------------------
//
// The bits->float primitive #1579 named as the prerequisite is now LANDED:
// `bitsToFloat(v: u64) -> f64` mirrors `floatBits`, lowering to the same inline
// `bitcast` op (an `FMOV`/`movq`) in the int->float direction, in BOTH compilers
// and differential-gated byte-identical. It is what lets these musl algorithms
// reconstruct an f64 from a manipulated bit pattern mid-computation
// (`z = @bitCast(iz)`) with no numeric conversion.
//
// STATUS PER SYMBOL (#1609):
//
//   log2 / log10  — PORTED HERE, bit-exact. Both are compiler-rt's table-FREE
//     musl bodies for `log2`/`log10`: a range reduction into
//     [sqrt(2)/2, sqrt(2)], a degree-7 `Lg1..Lg7` polynomial, and a two-word
//     (`hi`/`lo`) reconstruction. Pure arithmetic + `floatBits`/`bitsToFloat`
//     (both inline ops), so both compile clean under `@nosplit` — the proof, per
//     rootpins, that no primitive here is an rt_call that would recurse after
//     G2's rename. Measured against the shipping `flog2`/`flog10` at 0 mismatches
//     over 504,108 f64 inputs (structural edges + every biased exponent, both
//     signs + a 500k xorshift sweep), NaN matched by class; mutation-tested.
//     THE 1-ULP TRAP that cost the port a debugging cycle: musl's
//     `val_lo += (y - ww) + val_hi` groups its whole RHS — `x += a + b` is
//     `x = x + (a + b)`, NOT `x = x + a + b`. f64 add is non-associative, so the
//     naive left-associative expansion drifts exactly 1 ULP, pervasively.
//     Parenthesize the RHS. (Oracle: `bench/translog`.)
//
//   log  — PORTED in sibling `floatslog.bit`, bit-exact. compiler-rt's `log` is
//     the 128-entry-table variant (`{invc,logc}` + `{chi,clo}`, 512 f64
//     constants). #1231 landed the `const [N]T` rodata storage and #1625 opened
//     the fixed-array read to `@nosplit` bodies (a static `index_get`, no
//     allocation/safepoint), so the four tables live as `const [128]f64` images
//     and `rtLog` reads them in place. Measured 0 mismatches / 504,110 inputs vs
//     `flog` (`bench/translog`), mutation-tested.
//
//   pow / atan2  — PORTED, bit-exact. `pow` (sibling `floatspow.bit`, Go/musl)
//     reuses `rtLog` for `@log`, ports compiler-rt's table-FREE `exp` for `@exp`,
//     and reconstructs via `frexp`/`scalbn`/`modf`; its `-inf` case is inlined as
//     `pow(-0,-y)` rather than recursing so the pin never references itself.
//     `atan2` (sibling `floatsatan.bit`, musl) ports the scalar `atan` with two
//     `const [4]f64` region tables. Both measured 0 mismatches over the
//     `bench/translog` (x, y) corpus, mutation-tested. All three compile
//     `@nosplit`-clean (rootpins = 0).
//
// Every transcendental now has exactly one implementation: the bit-exact Bit
// pin described above. The parallel set these were measured against is gone.

// `bit_rt_log2` (ABI.md §17): base-2 log, compiler-rt/musl `log2(f64)`. Table
// free, so `@nosplit`-clean — the rootpins proof it is no rt_call cycle.
export @nosplit @symbol("bit_rt_log2")
fn rtLog2(x0: f64): f64 {
  let ivln2hi = 1.44269504072144627571e+00
  let ivln2lo = 1.67517131648865118353e-10
  let Lg1 = 6.666666666666735130e-01
  let Lg2 = 3.999999999940941908e-01
  let Lg3 = 2.857142874366239149e-01
  let Lg4 = 2.222219843214978396e-01
  let Lg5 = 1.818357216161805012e-01
  let Lg6 = 1.531383769920937332e-01
  let Lg7 = 1.479819860511658591e-01
  let x = x0
  let ix = floatBits(x)
  let hx = ix >> 32
  let k = 0
  if (hx < u64(0x00100000) || (hx >> 31) != 0) {
    if ((ix << 1) == 0) { return -1.0 / (x * x) }
    if ((hx >> 31) != 0) { return (x - x) / 0.0 }
    k = k - 54
    x = x * 18014398509481984.0
    hx = floatBits(x) >> 32
  } else {
    if (hx >= u64(0x7FF00000)) { return x }
    if (hx == u64(0x3FF00000) && (ix << 32) == 0) { return 0.0 }
  }
  hx = hx + u64(0x3FF00000) - u64(0x3FE6A09E)
  k = k + int(hx >> 20) - 0x3FF
  hx = (hx & u64(0x000FFFFF)) + u64(0x3FE6A09E)
  ix = (hx << 32) | (ix & u64(0xFFFFFFFF))
  x = bitsToFloat(ix)
  let f = x - 1.0
  let hfsq = 0.5 * f * f
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let t1 = w * (Lg2 + w * (Lg4 + w * Lg6))
  let t2 = z * (Lg1 + w * (Lg3 + w * (Lg5 + w * Lg7)))
  let R = t2 + t1
  let hi = f - hfsq
  let hii = floatBits(hi) & (u64(0xFFFFFFFF) << 32)
  hi = bitsToFloat(hii)
  let lo = f - hi - hfsq + s * (hfsq + R)
  let valHi = hi * ivln2hi
  let valLo = (lo + hi) * ivln2lo + lo * ivln2hi
  let y = f64(k)
  let ww = y + valHi
  // RHS grouped exactly as musl's `+=` (non-associative; see header).
  valLo = valLo + ((y - ww) + valHi)
  valHi = ww
  return valLo + valHi
}

// `bit_rt_log10` (ABI.md §17): base-10 log, compiler-rt/musl `log10(f64)`. Same
// table-free reduction as `log2`; only the final scaling constants differ.
export @nosplit @symbol("bit_rt_log10")
fn rtLog10(x0: f64): f64 {
  let ivln10hi = 4.34294481878168880939e-01
  let ivln10lo = 2.50829467116452752298e-11
  let log10_2hi = 3.01029995663611771306e-01
  let log10_2lo = 3.69423907715893078616e-13
  let Lg1 = 6.666666666666735130e-01
  let Lg2 = 3.999999999940941908e-01
  let Lg3 = 2.857142874366239149e-01
  let Lg4 = 2.222219843214978396e-01
  let Lg5 = 1.818357216161805012e-01
  let Lg6 = 1.531383769920937332e-01
  let Lg7 = 1.479819860511658591e-01
  let x = x0
  let ix = floatBits(x)
  let hx = ix >> 32
  let k = 0
  if (hx < u64(0x00100000) || (hx >> 31) != 0) {
    if ((ix << 1) == 0) { return -1.0 / (x * x) }
    if ((hx >> 31) != 0) { return (x - x) / 0.0 }
    k = k - 54
    x = x * 18014398509481984.0
    hx = floatBits(x) >> 32
  } else {
    if (hx >= u64(0x7FF00000)) { return x }
    if (hx == u64(0x3FF00000) && (ix << 32) == 0) { return 0.0 }
  }
  hx = hx + u64(0x3FF00000) - u64(0x3FE6A09E)
  k = k + int(hx >> 20) - 0x3FF
  hx = (hx & u64(0x000FFFFF)) + u64(0x3FE6A09E)
  ix = (hx << 32) | (ix & u64(0xFFFFFFFF))
  x = bitsToFloat(ix)
  let f = x - 1.0
  let hfsq = 0.5 * f * f
  let s = f / (2.0 + f)
  let z = s * s
  let w = z * z
  let t1 = w * (Lg2 + w * (Lg4 + w * Lg6))
  let t2 = z * (Lg1 + w * (Lg3 + w * (Lg5 + w * Lg7)))
  let R = t2 + t1
  let hi = f - hfsq
  let hii = floatBits(hi) & (u64(0xFFFFFFFF) << 32)
  hi = bitsToFloat(hii)
  let lo = f - hi - hfsq + s * (hfsq + R)
  let valHi = hi * ivln10hi
  let dk = f64(k)
  let y = dk * log10_2hi
  let valLo = dk * log10_2lo + (lo + hi) * ivln10lo + lo * ivln10hi
  let ww = y + valHi
  // RHS grouped exactly as musl's `+=` (non-associative; see header).
  valLo = valLo + ((y - ww) + valHi)
  valHi = ww
  return valLo + valHi
}
