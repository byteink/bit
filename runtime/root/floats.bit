// Split out of `root.bit` (#1503): the float entry points and SEAM 6
// (ABI.md §14, §19). Sibling file, same module — see `root.bit` for the port's
// header and seams.

// ---------------------------------------------------------------------------
// Floats and host identity (ABI.md §14, §19)
// ---------------------------------------------------------------------------

// SEAM 6 — THE PRIMITIVE-BACKED SYMBOLS. Mostly CLEARED by #1442; what is left
//   is named at the bottom of this block.
//
//   THE TRAP THIS BLOCK EXISTS TO RECORD, because it caught this file once and
//   very nearly caught a second agent porting the math six the same way: a Bit
//   "primitive" is NOT automatically a hardware instruction. Most entries in
//   seed/lower.zig's primitive table lower to an `ir.RtFn`, which
//   seed/codegen/{arm64,x64}.zig's `rtSymbol` emits as **a call to the very
//   `bit_rt_*` symbol being ported**. So
//
//       export @symbol("bit_rt_root_host_target")
//       function rtHostTarget(): int { return hostTarget() }
//
//   compiles to "call bit_rt_host_target" — the Zig — and the moment #1369 drops
//   the `_root` infix it becomes A CALL TO ITSELF. It builds, links, passes
//   every golden and every differential, and detonates as a stack overflow only
//   after the rename. `--freestanding` does not catch it either: the reference
//   IS pinned, and `refuseUnpinnedImports` checks pinning, not identity.
//
//   GUARDED, not just documented: tests/rootpins.zig re-emits this module,
//   performs #1369's rename symbolically on the emitted object, and fails on any
//   definition that would then reference itself. That gate — not this comment —
//   is what tells you whether a given primitive is safe to build a port on.
//
//   WHAT #1442 CHANGED. `fsqrt`, `floatBits`, `float32Bits`, `ffloor`, `fceil`,
//   `ftrunc` and `fround` were moved OUT of `prim_rt_fns` and into
//   `prim_unary_ops` in BOTH compilers (seed/lower.zig `prim_unary_ops`,
//   selfhost/lower.bit `primUnaryOp`). They are now inline IR ops — `FMOV` /
//   `FSQRT` / `FRINTM` / `FRINTP` / `FRINTZ` / `FRINTA` on AArch64 and an SSE2
//   expansion on x86-64 — so no `rt_call`, no cycle, and (being pure and
//   safepoint-free) they are admitted inside `@nosplit`. The seven exports below
//   are therefore real ports, and `zig build rootpins` is the proof rather than
//   this paragraph.
//
//   THE MAGIC-CONSTANT IDENTITY IS NOT USED, and deliberately so. `(x + 2^52) -
//   2^52` was measured against the Zig over 20 points and gives badFloor=0
//   badCeil=1 badTrunc=1, both failures being NEGATIVE ZERO: IEEE-754 makes
//   `ceil(-1e-300)` equal `-0.0` while the identity yields `+0.0`. That is
//   INVISIBLE to `==` (the two zeroes compare equal) and visible only in
//   `floatBits`, and it flips the printed string "-0" -> "0" — exactly what a
//   `const_float` golden compares. The rounding ops carry the correct sign of
//   zero natively, so the identity is not needed; the measurement is kept here
//   because the same trap applies to any future numeric reconstruction, and
//   because it is why `tests/stress/rootfloat` compares BIT PATTERNS, never
//   values.
//
//   STILL COMPILER-PROVIDED (the residue of SEAM 6, 2 symbols):
//   `bit_rt_host_target` and `bit_rt_auxv`. Both remain `prim_rt_fns` entries,
//   so `hostTarget()`/`auxv()` still lower to a call to the symbol being ported.
//   Neither is expressible otherwise: `hostTarget` is a property of the emit
//   (the compiler knows the target; the running program has no portable way to
//   ask) and `auxv` is a process-entry fact owned by the boot layer, SEAM 3.
//   The fix for both is the same shape as #1442 — a compiler-side constant /
//   boot-owned cell, not a runtime stub — and it belongs to #1369.

// `bit_rt_sqrt` (ABI.md §14): IEEE-754 square root, backing std/math. One
// `FSQRT`/`sqrtsd`; correctly rounded by the hardware, which is why this cannot
// be a numeric reconstruction (see above).
export @nosplit @symbol("bit_rt_root_sqrt")
function rtSqrt(x: f64): f64 {
  return fsqrt(x)
}

// `bit_rt_floor`/`ceil`/`round`/`trunc` (ABI.md §14): round an f64 to an
// integral f64. `fround` is ties-AWAY-from-zero, matching Zig's `@round` and
// specifically NOT `FRINTN` / `roundsd` mode 0 (ties-to-even) — the two differ
// on every exact half, so they are not interchangeable.
export @nosplit @symbol("bit_rt_root_floor")
function rtFloor(x: f64): f64 {
  return ffloor(x)
}

export @nosplit @symbol("bit_rt_root_ceil")
function rtCeil(x: f64): f64 {
  return fceil(x)
}

export @nosplit @symbol("bit_rt_root_round")
function rtRound(x: f64): f64 {
  return fround(x)
}

export @nosplit @symbol("bit_rt_root_trunc")
function rtTrunc(x: f64): f64 {
  return ftrunc(x)
}

// `bit_rt_float_bits`/`bit_rt_float32_bits` (ABI.md §14): the IEEE-754 encoding
// of a float as an unsigned integer, with no value conversion. This is the ONLY
// way a Bit program can observe -0.0 or distinguish two NaNs, and therefore the
// only sound basis for a float test — `==` reports `-0.0 == +0.0` as true and
// `NaN == NaN` as false, so it both passes broken implementations and fails
// correct ones. There is still no inverse (`bitsToFloat` does not exist), so a
// float cannot be RECONSTRUCTED from a manipulated pattern; only inspected.
export @nosplit @symbol("bit_rt_root_float_bits")
function rtFloatBits(v: f64): u64 {
  return floatBits(v)
}

export @nosplit @symbol("bit_rt_root_float32_bits")
function rtFloat32Bits(v: f32): u32 {
  return float32Bits(v)
}

// ---------------------------------------------------------------------------
// SEAM 5a — FLOAT TEXT (ABI.md §14, #1578)
// ---------------------------------------------------------------------------
//
// `bit_rt_string_from_float` and `bit_rt_parse_float`: the shortest-round-trip
// f64->text formatter and the correctly-rounded text->f64 parser, both exact
// (Dragon4 / long division over bignums). The bodies live in the sibling files
// `floatbig.bit` (bignum), `floatfmt.bit` (`fmtBits`) and `floatparse.bit`
// (`parseBits`), ported verbatim from `bench/fptext` (#1539), measured at 0
// mismatches / 1,000,000 f64 patterns in both directions and mutation-tested.
//
// These two are NOT `@nosplit`: they allocate the digit buffers, the bignum
// limb arrays and the result string, so they pass a safepoint. That is also why
// they are not the pin-cycle hazard SEAM 6 records — `fmtBits`/`parseBits` never
// reach the ABI name these wrappers become (`bit_rt_string_from_float` /
// `bit_rt_parse_float`); the only float bitcast in play is `floatBits`, a
// `prim_unary_op` (inline FMOV) since #1442, not an `RtFn`. `zig build rootpins`
// is the proof.

// `bit_rt_string_from_float` (ABI.md §14): the exact `{d}` decimal of `v`,
// returned as a `string` object address (an `int` at the C ABI — a pinned
// symbol cannot name a GC-managed type, E0079, so the boundary is raw exactly
// as `bit_rt_string_concat` returns `int`).
//
// TRAP #1 (the one the standalone experiment did not have to solve): the
// formatter works on a raw bit pattern, not an `f64`, because Bit has no
// bits->float primitive and the algorithm decomposes to sign/exponent/mantissa
// immediately. `floatBits` supplies the inverse at the boundary — a
// register-class transfer (`FMOV`/`movq`), not a numeric conversion, so `-0.0`,
// the infinities and every NaN survive intact. `fmtBits` then stays entirely in
// the integer domain and hands back a managed `string`; the loop copies its
// bytes into a fresh runtime string so no managed value crosses the pin.
export @symbol("bit_rt_root_string_from_float")
function rtStringFromFloat(v: f64): int {
  let s = fmtBits(floatBits(v))
  // `[]byte(s)` is word-strided (one byte per 8-byte word, ABI.md §2), so each
  // byte is the low octet of its word rather than a packed run — hence the
  // per-word read rather than a `copyBytes`.
  let bytes = []byte(s)
  let n = len(bytes)
  let out = allocString(n)
  if (out == 0) {
    return 0
  }
  let dst = strBytes(out)
  let src = int(ptrOf(bytes))
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadWord(src + i * 8) & 255)
    i = i + 1
  }
  return out
}

// `bit_rt_parse_float` (ABI.md §14): the nearest f64 to the decimal text at
// string address `s`, returned as its raw bit pattern. `_` separators are
// stripped inside `parseBits` (SPEC §5.4); unparsable text yields 0, matching
// the Zig contract.
//
// Returns the u64 pattern rather than an `f64`: Bit has no bits->float
// primitive, so the value stays in the integer domain here. The caller-side
// word bitcast that turns this u64 (in the integer return register) back into
// the `f64` a `parseFloat` call expects is the "read half of the container word
// ABI" and lands with #1369's rename, when `parse_float` joins `rtReturnsWord`.
//
// `s` arrives as a raw `int` (E0079 again). Its packed bytes are lifted into a
// managed `string` so `parseBits` can consume them; the round trip through
// `[]byte` is cheap on the ~24-char inputs a float literal ever spans.
export @symbol("bit_rt_root_parse_float")
function rtParseFloat(s: int): u64 {
  let n = strSize(s)
  let bytes = []byte(n)
  let src = strBytes(s)
  let i = 0
  while (i < n) {
    bytes[i] = byte(loadByte(src + i))
    i = i + 1
  }
  return parseBits(string(bytes))
}
