// SEAM 3 remainder (#1606): the platform-FREE shared dispatch for the 13
// `bit_rt_fs_*` ABI symbols (ABI.md §14). The kernel-facing halves — the raw
// syscalls and the 13 ABI wrappers themselves — live per-OS in
// `root/{linux,darwin}/fs.bit`, exactly as the `panic`/`print` write path lives
// per-OS in `root/{linux,darwin}/io.bit`. This file holds only what is genuinely
// OS-independent and worth sharing rather than duplicating: copying a Bit path
// into a bounded, NUL-terminated buffer.
//
// ---------------------------------------------------------------------------
// WHY THE 12 WRAPPERS ARE NOT HERE (and net's `netabi.bit` shape is not usable)
// ---------------------------------------------------------------------------
//
// `net/netabi.bit` keeps its 12 ABI wrappers in the platform-free parent and
// reaches the socket providers by `extern function`. That works for net because
// the only pin-cycle gate that builds it (`_tests_/bit/rootpins/`) targets
// aarch64-macos, where an `extern` is a load-time dyld import and admissible
// (§11.7). It is NOT usable here: rootpins builds `runtime/root` AND
// `runtime/root/linux` for x86_64-linux, and a Linux `--emit-obj` REJECTS any
// `extern function` naming a symbol not already in `libbitrt.a` (E0078,
// `rejectExternForTarget`) — which the fs syscall primitives, being the very
// thing this port defines, are not. `root/{linux,darwin}` also import this
// module (for `fsPathZ` and the string helpers), so a single `extern` placed
// here would break that x86_64-linux build too. So the wrappers reach their
// syscalls as LOCAL calls inside each provider, and reach this module's helpers
// and root's string glue by ordinary `import` (a cross-module *call*, not an
// `extern`, and so never E0078).
//
// This is `pathZ` from `runtime/root/`, shared by every path-taking primitive. It is
// pinned PORT-INTERNAL (`bit_rt_port_root_fs_*`, not `bit_rt_fs_*`): ABI.md
// names no such symbol, so no rename ever touches it — the same distinction
// io.bit draws between `bit_rt_panic` and `bit_rt_port_root_io_write_all`.

// `schedCurrentWorker`/`wkId`/`schedMaxWorkers`/`taskAt`, for `fsScratchSlot`
// below — see its own comment for why this module needs its own copy rather
// than sharing `runtime/root/linux`'s or `runtime/root/darwin`'s (three
// different modules; an import is per-module, not shared across them).
import { schedCurrentWorker, wkId, schedMaxWorkers, taskAt } from "../sched"

// `runtime/root/`'s `max_path = 4096`. A path at or over it is rejected, not
// truncated, so a lie about the prefix never reaches the kernel.
const fsMaxPath: int = 4096

// PER-WORKER SLOTS, NOT ONE SHARED REGION (#3274 — this comment used to claim
// a single module-level buffer was sound "under the ABI's single-worker
// contract"; #1900 booted more than one worker, and that claim is false at
// BIT_WORKERS>1). Same shape as `runtime/net/{darwin,linux}/sock.bit`'s
// `sockScratchSlot` (#3273): index by the CURRENT worker's `wkId`, double
// bounded against `schedMaxWorkers` and this file's own literal slot count
// (`let a: [N]i64` needs `N` to be a literal, E0021), plus a dedicated
// fallback slot for a caller with no current task/worker.
//
// WHY THE OLD SHAPE BROKE: `fsPathZ` fills the buffer and the caller's
// syscall (`sysOpen`, `mkdir`, …) reads it back with no park in between — true
// FOR ONE WORKER, where a second fs caller could only run once this one
// yielded. At BIT_WORKERS>1 a second worker's green thread runs on another
// core AT THE SAME REAL TIME, so its `fsPathZ` call can overwrite this one's
// bytes between the fill and the syscall — silently opening (or `stat`ing, or
// removing) the OTHER caller's path. Confirmed by running readFile on two
// distinct files concurrently at BIT_WORKERS=4/8: dense, correctly-shaped
// cross-caller content mismatches, zero at BIT_WORKERS=1 (#3274).
//
// WHY PER-WORKER IS SOUND: every path-taking `bit_rt_fs_*` wrapper in
// ../linux/fs.bit and ../darwin/fs.bit fills the slot via `fsPathZ`/`fsPathZ2`
// and reads it back through the SAME resolved address with no explicit park
// anywhere in that call chain (checked directly by grep for `schedPark`/
// `schedSwitch` — never inferred from `@nosplit` alone, since `@nosplit` only
// forbids an auto-inserted back-edge poll and does NOT forbid an explicit
// park call; `schedPark`/`schedSwitch` are themselves `@nosplit`). None of
// this module's callers retry across a park, so there is no #3273-style
// "refill inside the loop" hazard here.
const fsScratchSlots: int = 32

// The NUL-terminated path scratch. (`fsScratchSlots` + 1) slots of `fsMaxPath`
// (4096) bytes = 512 words each: 33 * 512 = 16896 words, one region per
// worker plus the fallback. A scalar array is never scanned by the collector
// (ABI.md §5, rule 1), which is required here: it holds raw path bytes, not
// an object.
let fsPathBuf: [16896]i64

// Copy the Bit `string` at `s` into the CURRENT worker's slot of `fsPathBuf`,
// NUL-terminated, and return the slot's address — or 0 if the path is at/over
// `max_path` (rejected, not truncated). `strSize`/`strBytes` are
// `runtime/root`'s own module-private string accessors (root.bit), in scope
// because this file is their sibling; `loadByte`/`storeByte` are the gc
// imports root.bit already brings into the module. Bounded by the path
// length, itself bounded by the `< fsMaxPath` guard.
export @nosplit @symbol("bit_rt_port_root_fs_pathz") fn fsPathZ(s: int): int {
  let n = strSize(s)
  if (n >= fsMaxPath) {
    return 0
  }
  let src = strBytes(s)
  let dst = int(ptrOf(fsPathBuf)) + fsScratchSlot() * fsMaxPath
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  storeByte(dst + n, 0)
  return dst
}

// A SECOND NUL-terminated path scratch (#2712), same size and per-worker
// shape as `fsPathBuf`, for the one entry point that must have two encoded
// paths live at once: `bit_rt_fs_rename(oldPath, newPath)`. `fsPathZ` above
// writes into `fsPathBuf`, so calling it a second time to encode `newPath`
// would overwrite `oldPath` before `rename(2)`/`sysRename` ever reads it,
// handing the syscall the SAME pointer for both arguments. A distinct buffer,
// not a bigger one (the ticket's own constraint): growing `fsPathBuf` would
// still alias the two paths into one region. Same per-worker soundness
// argument as `fsPathBuf` and same scalar-array-never-scanned property
// (rule 1).
let fsPathBuf2: [16896]i64

// `fsPathZ`, encoding into `fsPathBuf2` instead of `fsPathBuf` — otherwise an
// exact duplicate of `fsPathZ`'s body, deliberately, so `fsPathZ` itself keeps
// its existing signature and behaviour for every existing single-path caller.
// PORT-INTERNAL like `fsPathZ` (`bit_rt_port_root_fs_pathz2`, not
// `bit_rt_fs_*`): ABI.md names no such symbol.
export @nosplit @symbol("bit_rt_port_root_fs_pathz2") fn fsPathZ2(s: int): int {
  let n = strSize(s)
  if (n >= fsMaxPath) {
    return 0
  }
  let src = strBytes(s)
  let dst = int(ptrOf(fsPathBuf2)) + fsScratchSlot() * fsMaxPath
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  storeByte(dst + n, 0)
  return dst
}

// ---------------------------------------------------------------------------
// Pull-up from runtime/root/{linux,darwin}/fs.bit (#2551, #1710's
// provider-duplication sweep; docs/development/provider-duplication.md's
// `root` -> `fs.bit` section). Path-scratch validation, the per-worker
// scratch-slot arithmetic and the managed-string accessors below have no OS
// call anywhere in their bodies; both providers' copies were byte-identical.
//
// STILL split per provider: the actual `open`/`list`/`stat` syscalls
// (`sysOpen`, `sysList`, ...) are genuinely OS-specific and stay there, along
// with every wrapper (`rtFsAppend`, `rtFsListDir`, ...) that calls one of them
// directly by name — reaching a provider-only symbol from here would need
// either an extern/ABI-name rename at the call site (a real body change, not
// a pure move) or reintroducing the per-OS dispatch this split exists to avoid.
// ---------------------------------------------------------------------------

// (`fsScratchSlots` + 1) slots of `fsLinkMaxPath` (4096) bytes = 512 words
// each: 33 * 512 = 16896 words, one region per worker plus the fallback.
let fsLinkPathBuf: [16896]i64

// This module's own `fsMaxPath` (4096), under `wordsPathZ`'s original name —
// mirrored rather than renamed so the moved body stays byte-identical, and
// exported because `../linux/fsrw.bit`/`../darwin/fsrw.bit` also read it.
export const fsLinkMaxPath: int = 4096

// `fsPathZ` copies a Bit string's bytes verbatim and appends its own NUL
// terminator (#2146): a string carrying an embedded NUL byte (legal per
// SPEC §21) would let the copy stop early from the syscall's point of view
// while every Bit-side check — `len`, `==`, `hasSuffix`, `ext` — still sees
// the full string, so the syscall opens a different path than the one that
// was validated. Reject up front, same "reject, not truncate" contract
// `fsPathZ` already applies to `n >= fsMaxPath`. Every one of the 8
// path-taking `bit_rt_fs_*` entry points below routes through this instead
// of calling `fsPathZ` directly.
//
// BOUNDED (Power of 10 rule 2): the scan is bounded by the string's own
// length, exactly as `fsPathZ`'s copy loop it precedes.
export @nosplit @symbol("bit_rt_port_root_fs_checked_pathz") fn checkedPathZ(path: int): int {
  let n = strLenOf(path)
  let base = strData(path)
  let i = 0
  while (i < n) {
    if (loadByte(base + i) == 0) {
      return 0
    }
    i = i + 1
  }
  return fsPathZ(path)
}

// `checkedPathZ`, encoding into `fsPathZ2`'s buffer (`fsPathBuf2`) instead of
// `fsPathZ`'s (#2712). The only caller today is `rtFsRename`'s `newPath`: a
// rename needs both its paths encoded and live at the same time, and
// `checkedPathZ` alone would overwrite `oldPath` with `newPath` before
// `sysRename` ever reads the first pointer. Same embedded-NUL and
// `>= fsMaxPath` rejection rules as `checkedPathZ`, applied identically.
export @nosplit @symbol("bit_rt_port_root_fs_checked_pathz2") fn checkedPathZ2(path: int): int {
  let n = strLenOf(path)
  let base = strData(path)
  let i = 0
  while (i < n) {
    if (loadByte(base + i) == 0) {
      return 0
    }
    i = i + 1
  }
  return fsPathZ2(path)
}

// The length of the NUL-terminated name at `addr`, capped at NAME_MAX+1 (256) so
// the scan is provably bounded (Power of 10 rule 2).
export @nosplit @symbol("bit_rt_port_root_fs_cstr_len") fn cstrLen(addr: int): int {
  let i = 0
  while (i < 256) {
    if (loadByte(addr + i) == 0) {
      return i
    }
    i = i + 1
  }
  return 256
}

export @nosplit @symbol("bit_rt_port_root_fs_empty_str") fn emptyStr(): int { return rtStrAlloc(0) }

export @nosplit @symbol("bit_rt_port_root_fs_scratch_slot") fn fsScratchSlot(): int {
  let w = schedCurrentWorker()
  if (w == 0) {
    return fsScratchSlots
  }
  let id = *(taskAt(w) + wkId)
  if (id < 0 || id >= schedMaxWorkers || id >= fsScratchSlots) {
    return fsScratchSlots
  }
  return id
}

// `.` or `..` — the two entries `list_dir` omits.
export @nosplit @symbol("bit_rt_port_root_fs_is_dot_name") fn isDotName(
  addr: int,
  nlen: int,
): bool {
  if (nlen == 1 && loadByte(addr) == 46) {
    return true
  }
  if (nlen == 2 && loadByte(addr) == 46 && loadByte(addr + 1) == 46) {
    return true
  }
  return false
}

export @nosplit @symbol("bit_rt_port_root_fs_str_data") fn strData(s: int): int {
  return loadWord(s + strPtr)
}

export @nosplit @symbol("bit_rt_port_root_fs_str_len_of") fn strLenOf(s: int): int {
  return loadWord(s + strLen)
}

// Copy the `n` path bytes at `words` — a Bit `[]byte`'s backing store, PACKED
// one byte per element (#3121/#3226) — into `fsLinkPathBuf`, NUL-terminated,
// and return the buffer address. 0 when the path may not be handed to a
// syscall at all.
//
// This is `checkedPathZ` for a caller that has no Bit `string` to offer, and it
// applies the identical two rules, so `rtFsIsSymlinkW` refuses exactly the
// paths every other entry point refuses:
//   - at or over `max_path`: REJECTED, never truncated, so a lie about the
//     prefix cannot reach the kernel.
//   - an embedded NUL (legal in a Bit string, SPEC §21): REJECTED, because the
//     syscall would stop early while every Bit-side check still saw the whole
//     string — a different path probed than the one that was validated (#2146).
//
// BOUNDED (Power of 10 rule 2): by `n`, itself bounded by the `< fsLinkMaxPath`
// guard above the loop.
export @nosplit @symbol("bit_rt_port_root_fs_words_pathz") fn wordsPathZ(words: int, n: int): int {
  if (words == 0 || n <= 0 || n >= fsLinkMaxPath) {
    return 0
  }
  let dst = int(ptrOf(fsLinkPathBuf)) + fsScratchSlot() * fsLinkMaxPath
  let i = 0
  while (i < n) {
    let b = loadByte(words + i)
    if (b == 0) {
      return 0
    }
    storeByte(dst + i, b)
    i = i + 1
  }
  storeByte(dst + n, 0)
  return dst
}

