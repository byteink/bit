// SEAM 3 remainder (#1606): the platform-FREE shared dispatch for the 12
// `bit_rt_fs_*` ABI symbols (ABI.md §14). The kernel-facing halves — the raw
// syscalls and the 12 ABI wrappers themselves — live per-OS in
// `root/{linux,darwin}/fs.bit`, exactly as the `panic`/`print` write path lives
// per-OS in `root/{linux,darwin}/io.bit`. This file holds only what is genuinely
// OS-independent and worth sharing rather than duplicating: copying a Bit path
// into a bounded, NUL-terminated buffer.
//
// ---------------------------------------------------------------------------
// WHY THE 12 WRAPPERS ARE NOT HERE (and net's `netabi.bit` shape is not usable)
// ---------------------------------------------------------------------------
//
// `net/netabi.bit` keeps its 12 ABI wrappers in the platform-free parent and
// reaches the socket providers by `extern function`. That works for net because
// the only pin-cycle gate that builds it (`tests/bit/rootpins.bit`) targets
// aarch64-macos, where an `extern` is a load-time dyld import and admissible
// (§11.7). It is NOT usable here: rootpins builds `runtime/root` AND
// `runtime/root/linux` for x86_64-linux, and a Linux `--emit-obj` REJECTS any
// `extern function` naming a symbol not already in `libbitrt.a` (E0078,
// `rejectExternForTarget`) — which the fs syscall primitives, being the very
// thing this port defines, are not. `root/{linux,darwin}` also import this
// module (for `fsPathZ` and the string helpers), so a single `extern` placed
// here would break that x86_64-linux build too. So the wrappers reach their
// syscalls as LOCAL calls inside each provider, and reach this module's helpers
// and root's string glue by ordinary `import` (a cross-module *call*, not an
// `extern`, and so never E0078).
//
// This is `pathZ` from `runtime/root/`, shared by every path-taking primitive. It is
// pinned PORT-INTERNAL (`bit_rt_port_root_fs_*`, not `bit_rt_root_fs_*`): ABI.md
// names no such symbol, so no rename ever touches it — the same distinction
// io.bit draws between `bit_rt_root_panic` and `bit_rt_port_root_io_write_all`.

// `runtime/root/`'s `max_path = 4096`. A path at or over it is rejected, not
// truncated, so a lie about the prefix never reaches the kernel.
const fsMaxPath: int = 4096

// The NUL-terminated path scratch. MODULE-LEVEL and NOT locked, sound only under
// the ABI's single-worker contract (ABI.md §5: the scheduler starts with exactly
// one worker OS thread, `nthreads = 1`): `fsPathZ` fills it and the syscall reads
// it back within one fs call, with no park in between, so no second fs caller can
// interleave. A multi-worker consumer would need it per-worker — the same note
// net's `saBuf` carries, kept in the same shape deliberately. A scalar array is
// never scanned by the collector (ABI.md §5, rule 1), which is required here: it
// holds raw path bytes, not an object. 512 words = 4096 bytes = `max_path`, so
// the longest accepted path (4095 bytes) plus its NUL fits exactly.
let fsPathBuf: [512]i64

// Copy the Bit `string` at `s` into `fsPathBuf`, NUL-terminated, and return the
// buffer address — or 0 if the path is at/over `max_path` (rejected, not
// truncated). `strSize`/`strBytes` are `runtime/root`'s own module-private string
// accessors (root.bit), in scope because this file is their sibling;
// `loadByte`/`storeByte` are the gc imports root.bit already brings into the
// module. Bounded by the path length, itself bounded by the `< fsMaxPath` guard.
export @nosplit @symbol("bit_rt_port_root_fs_pathz") function fsPathZ(s: int): int {
  let n = strSize(s)
  if (n >= fsMaxPath) {
    return 0
  }
  let src = strBytes(s)
  let dst = int(ptrOf(fsPathBuf))
  let i = 0
  while (i < n) {
    storeByte(dst + i, loadByte(src + i))
    i = i + 1
  }
  storeByte(dst + n, 0)
  return dst
}
