// Split out of `root.bit` (#1503): the interface entry points (ABI.md §2.1,
// §2.2). Sibling file, same module — see `root.bit` for the port's header and
// seams.

// ---------------------------------------------------------------------------
// Interfaces (ABI.md §2.1, §2.2)
// ---------------------------------------------------------------------------

// One method-table entry: `{id, fn_ptr}`.
const miId: int = 0
const miFn: int = 8
const miStride: int = 16

// `bit_rt_iface_lookup` (ABI.md §2.1): resolve an interface method call to a
// concrete method's code address. LINEARLY scans the receiver type's method
// table — types have few methods, so this is a short, allocation-free walk, and
// the linear order is part of the contract (a table with duplicate ids resolves
// to the first, on both implementations).
//
// The checker guarantees the receiver satisfies the interface, so a miss is a
// COMPILER BUG. Making it fatal is not possible under `@nosplit`, so it returns 0 — which
// faults immediately at the indirect call rather than dispatching to something
// arbitrary. Loud either way, and never silently wrong.
export @nosplit @symbol("bit_rt_iface_lookup")
fn rtIfaceLookup(infoAddr: int, id: int): int {
  let base = loadWord(infoAddr + gcTiMethodsPtr)
  let n = loadWord(infoAddr + gcTiMethodsLen)
  let i = 0
  while (i < n) {
    let at = base + i * miStride
    if (loadWord(at + miId) == id) {
      let f = loadWord(at + miFn)
      return f
    }
    i = i + 1
  }
  return 0
}

// The dynamic type of an interface value, or 0 if it does not name a live
// managed object.
//
// An interface value IS its receiver pointer (ABI.md §2.1), so its dynamic type
// is the `TypeInfo` in that object's GC header. But a nil interface is a null
// word, and a reference-typed value NEED NOT BE A GC OBJECT AT ALL — a `chan`
// is not — so the header is only safe to read once `gcOwns` confirms this
// address is exactly a live object's body. Skipping that check is the difference
// between a type assertion and reading arbitrary memory as a descriptor.
//
// EXPORTED for `../{linux,darwin}/io.bit` (SEAM 3's write half, see
// `root.bit`): `bit_rt_iface_assert` must panic on a mismatch (ABI.md §2.2),
// which needs the write path this module cannot reach, so the real entry
// point lives there and calls back in here to decide. Port-internal, not ABI
// (ABI.md names no such symbol) — pinned for the same cross-module-call
// stability reason as `bit_rt_port_root_io_write_all`.
export @nosplit @symbol("bit_rt_port_root_iface_dyn_type")
fn dynTypeOf(recv: int): int {
  if (recv == 0) {
    return 0
  }
  let g = wordAt(gcAddr)
  if (!gcOwns(g, recv)) {
    return 0
  }
  // ABI.md §1: the header sits immediately below the body, `info` at its base.
  let info = loadWord(recv - gcHeaderSize + gcHdrInfo)
  return info
}

// `bit_rt_iface_as` (ABI.md §2.2): the two-result assertion
// `let (v, ok) = iface.(T)` (SPEC §14.4). `TypeInfo`s are per concrete type, so
// DESCRIPTOR IDENTITY IS TYPE IDENTITY.
//
// NULL ON A MISMATCH IS LOAD-BEARING, not tidiness: the result is typed `T`, so
// handing back the un-narrowed receiver would let a caller that ignores `ok`
// read a `Square` as a `Circle`. Null is `T`'s zero value.
export @nosplit @symbol("bit_rt_iface_as")
fn rtIfaceAs(recv: int, want: int): int {
  let info = dynTypeOf(recv)
  if (info == 0) {
    ifaceOk = 0
    return 0
  }
  if (info == want) {
    ifaceOk = 1
    return recv
  }
  ifaceOk = 0
  return 0
}

// `bit_rt_iface_as_ok` (ABI.md §2.2): the `ok` of the `bit_rt_iface_as`
// immediately preceding it. Lowering emits the two back to back, so no other
// assertion can land in between — see constraint 6 for why that adjacency is
// carrying more weight than usual here.
export @nosplit @symbol("bit_rt_iface_as_ok")
fn rtIfaceAsOk(): bool {
  return ifaceOk != 0
}

// The one-result assertion's DECISION only — NOT the real ABI entry point.
// Kept as a testable helper for tests/stress/rootbit's differential (#1367
// phase I), which needs the decision (gcOwns, descriptor identity) exercised
// without exiting the test process. `bit_rt_iface_assert` (ABI.md §2.2, SPEC
// §14.4/§18.4) must panic on a mismatch, and that needs the write path this
// module cannot reach (#1715) — the real, panicking symbol is
// `../{linux,darwin}/io.bit`'s `rootIfaceAssert`, pinned bare as
// `bit_rt_iface_assert` since G2 (#1583). Port-internal, not ABI.
export @nosplit @symbol("bit_rt_port_root_iface_assert_decide")
fn rtIfaceAssert(recv: int, want: int): int {
  let info = dynTypeOf(recv)
  if (info != 0 && info == want) {
    return recv
  }
  return 0
}

// Whether the last `rtIfaceAssert` would have panicked. Same adjacency
// contract as `rtIfaceAsOk`, and the same test-only status as `rtIfaceAssert`
// above — ABI.md defines no `bit_rt_iface_assert_failed` symbol.
export @nosplit @symbol("bit_rt_port_root_iface_assert_failed")
fn rtIfaceAssertFailed(recv: int, want: int): bool {
  let info = dynTypeOf(recv)
  return info == 0 || info != want
}

// The name a descriptor carries, as a fresh `string`. 0 when the descriptor is
// nameless. Test-only like the two functions above — ABI.md defines no
// `bit_rt_type_name` symbol, and the real panic message writes straight out
// of the descriptor's bytes (`../{linux,darwin}/io.bit`) rather than
// allocating a `string` to hold them.
export @nosplit @symbol("bit_rt_port_root_type_name")
fn rtTypeName(infoAddr: int): int {
  if (infoAddr == 0) {
    return 0
  }
  let p = loadWord(infoAddr + gcTiNamePtr)
  let n = loadWord(infoAddr + gcTiNameLen)
  let out = allocString(n)
  if (out == 0) {
    return 0
  }
  copyBytes(strBytes(out), p, n)
  return out
}
