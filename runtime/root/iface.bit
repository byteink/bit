// Split out of `root.bit` (#1503): the interface entry points (ABI.md §2.1,
// §2.2). Sibling file, same module — see `root.bit` for the port's header and
// seams.

import { scrIfaceOk } from "../sched"

// ---------------------------------------------------------------------------
// Interfaces (ABI.md §2.1, §2.2)
// ---------------------------------------------------------------------------

// One method-table entry: `{id, fn_ptr}`.
const miId: int = 0
const miFn: int = 8
const miStride: int = 16

// `bit_rt_iface_lookup` (ABI.md §2.1): resolve an interface method call to a
// concrete method's code address. LINEARLY scans the receiver type's method
// table — types have few methods, so this is a short, allocation-free walk, and
// the linear order is part of the contract (a table with duplicate ids resolves
// to the first, on both implementations).
//
// The checker guarantees the receiver satisfies the interface, so a miss is a
// COMPILER BUG. Making it fatal is not possible under `@nosplit`, so it returns 0 — which
// faults immediately at the indirect call rather than dispatching to something
// arbitrary. Loud either way, and never silently wrong.
export @nosplit @symbol("bit_rt_iface_lookup") fn rtIfaceLookup(infoAddr: int, id: int): int {
  let base = loadWord(infoAddr + gcTiMethodsPtr)
  let n = loadWord(infoAddr + gcTiMethodsLen)
  let i = 0
  while (i < n) {
    let at = base + i * miStride
    if (loadWord(at + miId) == id) {
      let f = loadWord(at + miFn)
      return f
    }
    i = i + 1
  }
  return 0
}

// One call site's inline cache (ABI.md §2.1): `{info, fn}`, zero until bound.
const icInfo: int = 0
const icFn: int = 8

// `bit_rt_iface_lookup_ic` (ABI.md §2.1): a `call_iface` site's miss path
// while its cell looked empty. Resolves like `rtIfaceLookup`, then binds the
// cell if it is still empty. The CAS on `fn` elects ONE writer per cell for
// the program's whole life, and only that writer stores `info`, after `fn`,
// with release: a reader that acquires a non-zero `info` therefore reads the
// `fn` stored for exactly that type, and no later write can change either
// word. A losing writer leaves the cell alone. The site itself calls
// `rtIfaceLookup` once it sees the cell bound, so only a miss racing the bind
// gets here with a bound cell; the plain load keeps that one off the CAS,
// which is a full barrier that takes the line exclusive even when it fails.
export @nosplit @symbol("bit_rt_iface_lookup_ic") fn rtIfaceLookupIc(
  infoAddr: int,
  id: int,
  cell: int,
): int {
  let f = rtIfaceLookup(infoAddr, id)
  if (f != 0 && loadWord(cell + icFn) == 0 && atomicCmpxchg(wordAt(cell + icFn), 0, f)) {
    atomicStoreRelease(wordAt(cell + icInfo), infoAddr)
  }
  return f
}

// The dynamic type of an interface value, or 0 if it does not name a live
// managed object.
//
// An interface value IS its receiver pointer (ABI.md §2.1), so its dynamic type
// is the `TypeInfo` in that object's GC header. But a nil interface is a null
// word, and a reference-typed value NEED NOT BE A GC OBJECT AT ALL — a `chan`
// is not — so the header is only safe to read once `gcOwns` confirms this
// address is exactly a live object's body. Skipping that check is the difference
// between a type assertion and reading arbitrary memory as a descriptor.
//
// EXPORTED for `../{linux,darwin}/io.bit` (SEAM 3's write half, see
// `root.bit`): `bit_rt_iface_assert` must panic on a mismatch (ABI.md §2.2),
// which needs the write path this module cannot reach, so the real entry
// point lives there and calls back in here to decide. Port-internal, not ABI
// (ABI.md names no such symbol) — pinned for the same cross-module-call
// stability reason as `bit_rt_port_root_io_write_all`.
export @nosplit @symbol("bit_rt_port_root_iface_dyn_type") fn dynTypeOf(recv: int): int {
  if (recv == 0) {
    return 0
  }
  let g = wordAt(gcAddr)
  if (!gcOwns(g, recv)) {
    return 0
  }
  // ABI.md §1: the header sits immediately below the body, `info` at its base.
  let info = loadWord(recv - gcHeaderSize + gcHdrInfo)
  return info
}

// `bit_rt_iface_as` (ABI.md §2.2): the two-result assertion
// `let (v, ok) = iface.(T)` (SPEC §14.4). `TypeInfo`s are per concrete type, so
// DESCRIPTOR IDENTITY IS TYPE IDENTITY.
//
// NULL ON A MISMATCH IS LOAD-BEARING, not tidiness: the result is typed `T`, so
// handing back the un-narrowed receiver would let a caller that ignores `ok`
// read a `Square` as a `Circle`. Null is `T`'s zero value.
//
// The `ok` flag is per-task scratch (`scrIfaceOk`, #3280), not module state:
// a process-wide word would let a second, concurrently-running OS thread's own
// assertion overwrite this task's result between this call and
// `rtIfaceAsOk`'s read.
export @nosplit @symbol("bit_rt_iface_as") fn rtIfaceAs(recv: int, want: int): int {
  let scr = schedCurrentScratch()
  let info = dynTypeOf(recv)
  if (info == 0) {
    *(scr + scrIfaceOk) = 0
    return 0
  }
  if (info == want) {
    *(scr + scrIfaceOk) = 1
    return recv
  }
  *(scr + scrIfaceOk) = 0
  return 0
}

// `bit_rt_iface_as_ok` (ABI.md §2.2): the `ok` of the `bit_rt_iface_as`
// immediately preceding it. Lowering emits the two back to back, so no other
// assertion on THIS task can land in between; the per-task scratch slot
// (`scrIfaceOk`) is what also keeps a different, concurrently-running task's
// own assertion from landing in the same window (#3280).
export @nosplit @symbol("bit_rt_iface_as_ok") fn rtIfaceAsOk(): bool {
  let scr = schedCurrentScratch()
  return *(scr + scrIfaceOk) != 0
}

// `bit_rt_iface_as_enum` (ABI.md §2.2a, #6017): the ENUM-target two-result
// assertion `let (v, ok) = e.(EnumType)` (SPEC §14.4). A BOXED enum's object
// size is `8 + 8*argc` bytes, ONE SHAPE PER VARIANT (SPEC §14.7) — unlike a
// class, whose layout is fixed once at the declaration — so two objects of
// the SAME enum type can carry TWO DIFFERENT `TypeInfo` addresses, and
// `bit_rt_iface_as`'s descriptor-POINTER identity (§2.2) does not hold.
//
// NOT a name comparison: `TypeInfo.name` is documented "debug/stats only"
// (ABI.md §2) and is the bare DECLARED name with no module/package
// qualification (`typeName`, compiler/types.bit) — two distinct enum types
// (different modules, different packages, even different payload shapes)
// can share one declared name, which a name-based compare would have
// confused as the same type and then read a payload word with the wrong
// layout. `gcTiTypeId` is the compiler's own TypeId, unique across the
// WHOLE compiled program regardless of module or package, so this compares
// that word instead — `want`'s descriptor need not be the address of any
// REAL allocation's, only one carrying the target's type id
// (`lowerEnumTypeInfo`, compiler/lowerexpr.bit).
export @nosplit @symbol("bit_rt_iface_as_enum") fn rtIfaceAsEnum(recv: int, want: int): int {
  let scr = schedCurrentScratch()
  let info = dynTypeOf(recv)
  if (info == 0 || want == 0 || loadWord(info + gcTiTypeId) != loadWord(want + gcTiTypeId)) {
    *(scr + scrIfaceOk) = 0
    return 0
  }
  *(scr + scrIfaceOk) = 1
  return recv
}

// `bit_rt_iface_has` (ABI.md §2.2, #4512): one conjunct of an INTERFACE-target
// assertion `let (v, ok) = iface.(I)` (SPEC §14.4). `recv` when its dynamic
// type's method table carries dispatch id `id` — the same id `call_iface`
// resolves through `bit_rt_iface_lookup` — else null. It writes the same
// per-task `ok` slot `bit_rt_iface_as` writes, so `bit_rt_iface_as_ok` reads
// either.
//
// A method SET is tested by CHAINING these: lowering emits one call per method
// of `I` and feeds each call's result to the next, so a miss anywhere yields
// null, `dynTypeOf(0)` is 0 in every later call, and the last call leaves the
// conjunction of all of them in the slot. That is what makes a set test out of
// a per-method primitive without materializing an id list in `.rodata`.
//
// NULL ON A MISS IS LOAD-BEARING for a sharper reason than in `rtIfaceAs`: the
// result is typed `I`, so handing back the un-narrowed receiver would let a
// caller that ignores `ok` dispatch a method the object does not have, and
// `bit_rt_iface_lookup` answers a miss with 0 — an indirect call to address 0.
export @nosplit @symbol("bit_rt_iface_has") fn rtIfaceHas(recv: int, id: int): int {
  let scr = schedCurrentScratch()
  let info = dynTypeOf(recv)
  if (info == 0 || rtIfaceLookup(info, id) == 0) {
    *(scr + scrIfaceOk) = 0
    return 0
  }
  *(scr + scrIfaceOk) = 1
  return recv
}

// ---------------------------------------------------------------------------
// `bit_rt_iface_implements` (ABI.md §2.2b, #7406): the INTERFACE-target
// assertion `x.(I)` as ONE call, with the verdict cached per (dynamic type,
// interface) pair.
// ---------------------------------------------------------------------------

// The verdict cache: `ifvSlots` two-word entries `{info, ids*2 + verdict}`, in
// `.bss` — no GC allocation, nothing to trace. Every word is WRITE-ONCE: a
// writer claims an empty slot by CAS on `info`, then publishes the second word
// with a release store, so a reader never sees a torn pair; a reader that finds
// the first word set and the second still 0 just probes on. `ids` is the
// address of the pooled string the lowerer built for `I` (its identity IS the
// interface's key, and equal method sets share one string). The cache is only
// ever an accelerator: a full probe window computes the answer and leaves it
// uncached.
const ifvSlots: int = 1024
const ifvProbes: int = 8
const ifvStride: int = 16
let ifvTable: [2048]i64

// Whether `info`'s method table carries every dispatch id in `ids`, a pooled
// string of decimal ids separated by `,` (`lowerIfaceNarrow`,
// compiler/lowertypeassert.bit). The pre-cache cost; BOUNDED by the string's
// length. An empty string is the empty method set: always true.
@nosplit fn ifvHasAll(info: int, ids: int): bool {
  let p = strBytes(ids)
  let n = strSize(ids)
  let id = 0
  let i = 0
  while (i < n) {
    let b = loadByte(p + i)
    if (b == 44) {
      if (rtIfaceLookup(info, id) == 0) {
        return false
      }
      id = 0
    } else {
      id = id * 10 + (b - 48)
    }
    i = i + 1
  }
  return n == 0 || rtIfaceLookup(info, id) != 0
}

// The slot holding the verdict for (info, ids), else the first empty slot of
// the probe window, else 0 when the window is full. A slot whose first word is
// 0 is empty; one whose first word is `info` and second names `ids` is a hit.
@nosplit fn ifvFind(info: int, ids: int): int {
  let base = int(ptrOf(ifvTable))
  let start = (info >> 4) * 31 + (ids >> 3)
  let i = 0
  while (i < ifvProbes) {
    let slot = base + ((start + i) & (ifvSlots - 1)) * ifvStride
    let a = atomicLoad(wordAt(slot))
    if (a == 0) {
      return slot
    }
    let b = atomicLoad(wordAt(slot + 8))
    if (a == info && b != 0 && (b >> 1) == ids) {
      return slot
    }
    i = i + 1
  }
  return 0
}

// `bit_rt_iface_implements(recv, ids) -> ref` (ABI.md §2.2b): `recv` when its
// dynamic type carries every method id of `ids`, else null; null for a nil or
// non-object `recv`, which has no dynamic type. Leaves the per-task `ok` slot
// alone: the caller's `ok` is `result != nil` (#7408).
export @nosplit @symbol("bit_rt_iface_implements") fn rtIfaceImplements(recv: int, ids: int): int {
  let info = dynTypeOf(recv)
  if (info == 0) {
    return 0
  }
  let slot = ifvFind(info, ids)
  if (slot != 0 && atomicLoad(wordAt(slot)) != 0) {
    let b = atomicLoad(wordAt(slot + 8))
    if (b != 0 && (b >> 1) == ids) {
      return recv * (b & 1)
    }
  }
  let yes = ifvHasAll(info, ids)
  let v = 0
  if (yes) {
    v = 1
  }
  if (slot != 0 && atomicCmpxchg(wordAt(slot), 0, info)) {
    atomicStoreRelease(wordAt(slot + 8), ids * 2 + v)
  }
  return recv * v
}

// The one-result assertion's DECISION only — NOT the real ABI entry point.
// Kept as a testable helper for _tests_/stress/rootbit's differential (#1367
// phase I), which needs the decision (gcOwns, descriptor identity) exercised
// without exiting the test process. `bit_rt_iface_assert` (ABI.md §2.2, SPEC
// §14.4/§18.4) must panic on a mismatch, and that needs the write path this
// module cannot reach (#1715) — the real, panicking symbol is
// `../{linux,darwin}/io.bit`'s `rootIfaceAssert`, pinned bare as
// `bit_rt_iface_assert` since G2 (#1583). Port-internal, not ABI.
export @nosplit @symbol("bit_rt_port_root_iface_assert_decide") fn rtIfaceAssert(
  recv: int,
  want: int,
): int {
  let info = dynTypeOf(recv)
  if (info != 0 && info == want) {
    return recv
  }
  return 0
}

// Whether the last `rtIfaceAssert` would have panicked. Same adjacency
// contract as `rtIfaceAsOk`, and the same test-only status as `rtIfaceAssert`
// above — ABI.md defines no `bit_rt_iface_assert_failed` symbol.
export @nosplit @symbol("bit_rt_port_root_iface_assert_failed") fn rtIfaceAssertFailed(
  recv: int,
  want: int,
): bool {
  let info = dynTypeOf(recv)
  return info == 0 || info != want
}

// The name a descriptor carries, as a fresh `string`. 0 when the descriptor is
// nameless. Test-only like the two functions above — ABI.md defines no
// `bit_rt_type_name` symbol, and the real panic message writes straight out
// of the descriptor's bytes (`../{linux,darwin}/io.bit`) rather than
// allocating a `string` to hold them.
export @nosplit @symbol("bit_rt_port_root_type_name") fn rtTypeName(infoAddr: int): int {
  if (infoAddr == 0) {
    return 0
  }
  let p = loadWord(infoAddr + gcTiNamePtr)
  let n = loadWord(infoAddr + gcTiNameLen)
  let out = allocString(n)
  if (out == 0) {
    return 0
  }
  copyBytes(strBytes(out), p, n)
  return out
}
