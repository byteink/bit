//
// map<K,V> SIZING AND SLOT-STATE POLICY.
//
// A sibling of root.bit (the map object model: header offsets and layout) and
// maps.bit (the algorithms: probe, grow, insert, delete). What lives here is
// the POLICY those two share -- how big a table is, when it grows, and what a
// single ctrl byte means -- because the probe loops in maps.bit are only bounded
// if the ceiling here holds, and a policy split across two large files is a
// policy that drifts.
//
// Split out of root.bit by #4024, which needed room to record the load-factor
// decision below and found root.bit and maps.bit both within five lines of the
// 800-line ceiling. Nothing here changed in the move.
//
// No imports: this file declares constants and two pure functions over `int`
// and `u64`. Imports are module-scoped (SPEC §17.1), so re-importing anything
// runtime/root already brings in would be an E0042 redeclaration.

// Per-slot state, one byte per slot. Linear probing with tombstones; the
// load-factor grow below guarantees an EMPTY slot always exists, which is what
// makes every probe loop terminate in at most `cap` steps.
//
// A FULL slot stores `ctrlFullBit | tag`, not a bare marker: `c >= ctrlFullBit`
// IS the full test, and a probe stepping over an occupied slot whose tag
// differs rejects it from this byte alone -- no key load, no `mapKeyEq` call.
// EMPTY and TOMB sit below the bit so a tag can never be mistaken for one, and
// EMPTY stays 0 because `allocCtrl` takes its zeroing from `gcAllocRaw`.
const ctrlEmpty: int = 0
const ctrlTomb: int = 1
const ctrlFullBit: int = 128

// The ctrl byte for a key whose hash is `h`: the TOP 7 bits, under
// `ctrlFullBit`. From the top because the LOW bits already chose the slot -- a
// tag correlated with the index would agree wherever the probe looks, and so
// reject nothing.
@nosplit fn mapCtrlTag(h: u64): int {
  return int(h >> 57) | ctrlFullBit
}

// The initial slot count. Power of two, so `& (cap - 1)` is the modulus.
const mapInitCap: int = 8

// The load-factor ceiling: a table grows once `used/cap` would reach
// `mapLoadNum/mapLoadDen`. ONE definition for all three tests that read it --
// `mapCapForHint` below, and `rtMapSet`/`mapGrow` in maps.bit -- because a
// probe bound proved against one ratio is unsound under another, and three
// hand-inlined copies of `* 7`/`* 8` could drift apart silently.
//
// 7/8 IS A DECISION, NOT A DEFAULT, and #4024 measured the trade rather than
// arguing it. bench/cases/map, 1.5M i64 keys, interleaved 15 rounds on a quiet
// box, trimmed mean of cycles (min in brackets):
//
//   ceiling  table  presized: cycles / instrs / peak RSS   grow path: cycles / RSS
//   7/8      2^21   566.5M [538.0M] / 1714.9M / 36.3 MB    433.7M [420.8M] / 62.6 MB
//   5/8      2^22   591.7M [574.0M] / 1503.8M / 70.3 MB    512.0M [507.1M] / 105.1 MB
//
// So halving the ceiling costs 4.4% more cycles presized and 18.1% more on the
// grow path, for 94% and 68% more memory. It is a loss on BOTH axes, which is
// not what linear-probing theory alone predicts: 5/8 really does execute fewer
// instructions (1503.8M against 1714.9M), and still loses, because the pages
// the bigger table touches cost more than the probe steps it saves.
//
// The reason the chains are affordable at 0.875 is `mapCtrlTag` above: a probe
// rejects a non-matching slot from its ctrl byte, so a longer chain stays in
// the 1-byte-per-slot ctrl array instead of walking the 8-byte key array. The
// same sweep against a runtime WITHOUT the tag reads 635.4M [607.7M] at 7/8
// and 614.0M [587.1M] at 5/8 -- there, a lower ceiling was a 3.4% win, and
// buying it still cost 94% more memory.
//
// C's hand-rolled table in bench/cases/map/map.c, same key set, isolates the
// load factor from everything else: 175.4M cycles at 2^23 (load 0.179) against
// 433.2M at 2^21 (load 0.715) -- 2.47x for the same source and 8% FEWER
// instructions. Bit does not pay that curve, because Bit's probe step is
// instructions rather than stalls (IPC 3.03 against C's 1.37). Do not port a
// conclusion from that C experiment to this table without re-measuring here.
const mapLoadNum: int = 7
const mapLoadDen: int = 8

// PROBE SCAN POLICY (#4373). `mapProbe` -- the `string` and composite-key
// probe in maps.bit -- walks the ctrl array one byte per slot until it has
// taken `probeInlineSteps` steps; past that it hands off to `mapProbeSwar`
// (mapswar.bit), which tests EIGHT slots per 8-byte load.
//
// THE FOUR SCALAR ENTRY POINTS DO NOT USE IT, and that is the finding this
// constant exists to record. Their loops in mapscalar.bit are untouched. Six
// different ways of giving them the same threshold were built and measured, and
// every one cost the benchmark's own shape more cycles than the scanner won
// there. Instructions retired and CPU cycles, trimmed mean of 15 interleaved
// runs per arm, against an unmodified build, on `bench/cases/map`'s workload
// (1.5M i64 keys at load 0.715, all-hit lookups then a comma-ok pass over a
// quarter-deleted table):
//
//   spelling of the bound                    instrs    cycles
//   counter vs the literal                   +2.16%    +2.9%
//   counter down to zero                     +2.16%    +2.9%
//   stop at (start+T) & mask                 -0.21%    +3.3 to +5.3%
//   min(cap,T) in a new register             +5.4%     +6.0%
//   count down to cap-T                      +2.0%     +3.3 to +4.7%
//   branchless min into cap's own register   +3.7%     +4.0 to +8.0%
//
// TWO CONTROLS SAY THAT IS THE LOOP AND NOT THE BOX. Building the same source
// twice moved cycles 0.13%/-0.11%; adding 24-26 instructions of NEVER-TAKEN
// code to the same four functions -- more growth than any row above -- moved
// them -0.14%/+1.12%/-1.36%, straddling zero. And a build with `mapProbeSwar`
// fully linked in but the four loops left exactly as they are reads +0.00%
// instructions and -0.4% cycles, so the scanner costs nothing by existing.
//
// The row to read is the third: it retires FEWER instructions and takes 4% more
// cycles. That loop is register-pressure bound -- it already calls out to
// `bit_rt_port_mem_load_byte` every step -- so any extra live value spills, and
// bounding by the index puts the exit branch on the same dependency chain as
// the `ctrl[i]` load instead of on an induction variable the core can resolve
// ahead of it. This is a codegen limit, not an algorithmic one, and it is the
// same limit epic #4342 is about; the scalar half of #4373 is filed to return
// once whole-function register allocation lands.
//
// WHAT IT BUYS WHERE IT IS USED. Same method, a `map<string, i64>` at load
// 0.858 with 1.35M hits and 1.35M misses replayed over prebuilt keys:
// instructions -5.6% to -6.1%, cycles -4.5% to -7.4%.
//
// WHY A THRESHOLD AND NOT ALWAYS. The group test costs ~8 extra instructions on
// a step it cannot skip, and short chains are the overwhelming majority: a
// simulation of `bench/cases/map`'s own key set puts the MEDIAN probe at 1 step
// and the mean at 2.26, with 4.7% of hit probes reaching 8 steps. The same
// table at load 0.858 misses in a mean of 25.7 steps with a p90 of 69, which is
// where a group skip pays.
//
// It is not a correctness parameter: `mapProbeSwar` re-derives everything it
// needs from `(start, tomb0)`, so any value >= 0 gives the same answer, and
// `_tests_/cases/run_map_swar_scan.bit` drives chains on both sides of it -- 0
// (group scan from the first step) and 10^9 (never) both reproduce its
// expectation exactly.
const probeInlineSteps: int = 32

// The two SWAR broadcast constants: one 0x01 per byte and one 0x80 per byte.
const swarOnes: u64 = 0x0101010101010101
const swarHigh: u64 = 0x8080808080808080

// Smallest power-of-two table holding capacity HINT `n` (`map<K,V>(n)`,
// §11.2/§12.9, #4064) without an immediate `mapGrow`: the smallest `cap` with
// `cap*mapLoadNum > n*mapLoadDen`.
// ADVISORY: `n <= 0` (mirroring `chan_make`'s `capacity > 0`), an `n*8`
// overflow (wraps small/negative, SPEC §11.1), or `n` past
// `mapHintMaxEntries` (below) all fall back to `mapInitCap` and grow
// normally.
//
// `mapHintMaxEntries` BOUNDS THE ALLOCATION, NOT JUST THE LOOP (#4190,
// #4303). A garbage `n` (e.g. #4189's arity-mismatch register) must not be
// honoured at all: `rtMapNew` below backs one `cap` with THREE buffers (keys
// 8B/slot, vals 8B/slot, ctrl 1B/slot = 17B/slot), so an unbounded `n` walked
// `cap` to 8*2^56 = 5.7e17 slots -- a 9.8-exabyte ask, and in practice the
// process reached 101.81 GB resident before the run was stopped (#4189).
//
// #4190's first fix CLAMPED the loop to 15 doublings (`cap` capped at
// `mapInitCap*2^15` = 262144) instead of rejecting the hint, derived from the
// boot-time arena reservation (`arenaWords*8` = 8388608 bytes). That premise
// was false -- the arena is not a heap ceiling, and the same benchmark that
// motivated it maps 4.4x the arena during a normal run (#4299) -- and the
// clamp silently truncated every legitimate hint at or above 229376 entries,
// so a caller asking for 1.5M entries got a 262144-slot table and paid three
// full rehashes it explicitly pre-sized to avoid.
//
// #4303 IGNORES an implausible hint instead of truncating it, mirroring the
// `n <= 0` arm above. `mapHintMaxEntries` is the largest `n` whose honoured
// table stays under a 4 GiB backing allocation: `cap*17 <= 4*1024*1024*1024`
// bounds `cap` at 2^27 (2^27*17 = 2281701376; 2^28*17 = 4563402752 exceeds
// 4 GiB). The loop below only stops doubling once
// `cap*mapLoadNum > n*mapLoadDen` -- a strict `>`, computed by continuing to
// double on `<=` -- so `n` exactly equal to `2^27*mapLoadNum/mapLoadDen`
// (117440512) would still force one MORE doubling to 2^28; the bound is one
// less than that product to keep `cap` at 2^27.
const mapHintMaxEntries: int = 117440511

export @nosplit fn mapCapForHint(n: int): int {
  if (n <= 0 || n > mapHintMaxEntries) {
    return mapInitCap
  }
  let cap = mapInitCap
  while (cap * mapLoadNum <= n * mapLoadDen) {
    cap = cap * 2
  }
  return cap
}
