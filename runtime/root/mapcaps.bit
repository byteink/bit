//
// map<K,V> SIZING AND SLOT-STATE POLICY.
//
// A sibling of root.bit (the map object model: header offsets and layout) and
// maps.bit (the algorithms: probe, grow, insert, delete). What lives here is
// the POLICY those two share -- how big a table is, when it grows, and what a
// single ctrl byte means -- because the probe loops in maps.bit are only bounded
// if the ceiling here holds, and a policy split across two large files is a
// policy that drifts.
//
// Split out of root.bit by #4024, which needed room to record the load-factor
// decision below and found root.bit and maps.bit both within five lines of the
// 800-line ceiling. Nothing here changed in the move.
//
// No imports: this file declares constants and two pure functions over `int`
// and `u64`. Imports are module-scoped (SPEC §17.1), so re-importing anything
// runtime/root already brings in would be an E0042 redeclaration.

// Per-slot state, one byte per slot. Linear probing with tombstones; the
// load-factor grow below guarantees an EMPTY slot always exists, which is what
// makes every probe loop terminate in at most `cap` steps.
//
// A FULL slot stores `ctrlFullBit | tag`, not a bare marker: `c >= ctrlFullBit`
// IS the full test, and a probe stepping over an occupied slot whose tag
// differs rejects it from this byte alone -- no key load, no `mapKeyEq` call.
// EMPTY and TOMB sit below the bit so a tag can never be mistaken for one, and
// EMPTY stays 0 because `allocCtrl` takes its zeroing from `gcAllocRaw`.
const ctrlEmpty: int = 0
const ctrlTomb: int = 1
const ctrlFullBit: int = 128

// The ctrl byte for a key whose hash is `h`: the TOP 7 bits, under
// `ctrlFullBit`. From the top because the LOW bits already chose the slot -- a
// tag correlated with the index would agree wherever the probe looks, and so
// reject nothing.
@nosplit fn mapCtrlTag(h: u64): int {
  return int(h >> 57) | ctrlFullBit
}

// The initial slot count. Power of two, so `& (cap - 1)` is the modulus.
const mapInitCap: int = 8

// The load-factor ceiling: a table grows once `used/cap` would reach
// `mapLoadNum/mapLoadDen`. ONE definition for all three tests that read it --
// `mapCapForHint` below, and `rtMapSet`/`mapGrow` in maps.bit -- because a
// probe bound proved against one ratio is unsound under another, and three
// hand-inlined copies of `* 7`/`* 8` could drift apart silently.
//
// 7/8 IS A DECISION, NOT A DEFAULT, and #4024 measured the trade rather than
// arguing it. bench/cases/map, 1.5M i64 keys, interleaved 15 rounds on a quiet
// box, trimmed mean of cycles (min in brackets):
//
//   ceiling  table  presized: cycles / instrs / peak RSS   grow path: cycles / RSS
//   7/8      2^21   566.5M [538.0M] / 1714.9M / 36.3 MB    433.7M [420.8M] / 62.6 MB
//   5/8      2^22   591.7M [574.0M] / 1503.8M / 70.3 MB    512.0M [507.1M] / 105.1 MB
//
// So halving the ceiling costs 4.4% more cycles presized and 18.1% more on the
// grow path, for 94% and 68% more memory. It is a loss on BOTH axes, which is
// not what linear-probing theory alone predicts: 5/8 really does execute fewer
// instructions (1503.8M against 1714.9M), and still loses, because the pages
// the bigger table touches cost more than the probe steps it saves.
//
// The reason the chains are affordable at 0.875 is `mapCtrlTag` above: a probe
// rejects a non-matching slot from its ctrl byte, so a longer chain stays in
// the 1-byte-per-slot ctrl array instead of walking the 8-byte key array. The
// same sweep against a runtime WITHOUT the tag reads 635.4M [607.7M] at 7/8
// and 614.0M [587.1M] at 5/8 -- there, a lower ceiling was a 3.4% win, and
// buying it still cost 94% more memory.
//
// C's hand-rolled table in bench/cases/map/map.c, same key set, isolates the
// load factor from everything else: 175.4M cycles at 2^23 (load 0.179) against
// 433.2M at 2^21 (load 0.715) -- 2.47x for the same source and 8% FEWER
// instructions. Bit does not pay that curve, because Bit's probe step is
// instructions rather than stalls (IPC 3.03 against C's 1.37). Do not port a
// conclusion from that C experiment to this table without re-measuring here.
const mapLoadNum: int = 7
const mapLoadDen: int = 8

// Smallest power-of-two table holding capacity HINT `n` (`map<K,V>(n)`,
// §11.2/§12.9, #4064) without an immediate `mapGrow`: the smallest `cap` with
// `cap*mapLoadNum > n*mapLoadDen`.
// ADVISORY: `n <= 0` (mirroring `chan_make`'s `capacity > 0`) or an `n*8`
// overflow (wraps small/negative, SPEC §11.1) fall back to `mapInitCap` and
// grow normally.
//
// `mapCapMaxSteps` BOUNDS THE ALLOCATION, NOT JUST THE LOOP (#4190). The
// original 56 was only a loop-termination proof (Power of 10 rule 2) -- it
// said nothing about the ALLOCATION `cap` drives. A garbage `n` (e.g.
// #4189's arity-mismatch register) walked `cap` to 8*2^56 = 5.7e17 slots;
// `rtMapNew` below backs one `cap` with THREE buffers (keys 8B/slot, vals
// 8B/slot, ctrl 1B/slot = 17B/slot), so that is a 9.8-exabyte ask. In
// practice the process reached 101.81 GB resident before the run was
// stopped (#4189) -- real memory, not a theoretical number.
//
// 15 is derived, not chosen. `arenaWords * 8` (identical across
// root/{darwin,linux,windows}/boot.bit: `arenaWords = 1048576`) is
// 8388608 bytes -- the ONE `mapPages` span every Bit process reserves
// before any allocation runs at all. A single pre-size hint whose backing
// exceeds that whole boot-time reservation is not a legitimate hint by
// construction. The largest power-of-two `cap` whose 17B/slot backing
// (`262144 * 17 = 4456448` bytes, 53% of the arena) still fits is 2^18 =
// 262144; `cap` starts at `mapInitCap` = 8 = 2^3, so reaching 2^18 takes
// exactly 15 doublings.
//
// This bounds the allocation regardless of how `n*mapLoadDen` overflows --
// unlike the `n<=0` fallback above, which only works because a garbage `n`
// happens to wrap negative or small. An `n` that instead wraps large and
// positive would still satisfy the loop condition on every step; the step
// count, not the comparison, is what stops it.
const mapCapMaxSteps: int = 15

export @nosplit fn mapCapForHint(n: int): int {
  if (n <= 0) {
    return mapInitCap
  }
  let cap = mapInitCap
  let steps = 0
  while (steps < mapCapMaxSteps && cap * mapLoadNum <= n * mapLoadDen) {
    cap = cap * 2
    steps = steps + 1
  }
  return cap
}
