// The NUL-terminated scan behind the `strlen` shim (#1368), in its own module.
//
// WHY IT IS NOT SIMPLY A FUNCTION IN ../shims.bit. That module pins its export
// to the exact symbol `strlen` (§11.9), and a pinned export is always emitted —
// it cannot be dead-stripped, which is the whole point of a pin. `libbitrt.a`
// already defines `strlen` on every target (from `runtime/shims/` on Linux, from
// bundled compiler-rt on Darwin), so *any* program importing the pinned module
// fails to link with a duplicate definition until #1400 removes the Zig
// original. Verified, not assumed.
//
// Splitting the scan into this module keeps the behaviour reachable — and
// therefore testable against the real source rather than a copy of it — while
// the pin is verified separately by inspecting the emitted object's symbol
// table. One copy of the scan, both properties checked.

// The number of bytes before the NUL terminator at `s`.
//
// Zig's version is `std.mem.len(s)`, a plain sentinel scan; this is that same
// scan written out. The parameter is `[*:0]const u8` there and a raw `*u8`
// here — Bit has no sentinel-terminated pointer type, and `*u8` is what the C
// ABI passes anyway.
// PINNED PORT-INTERNAL (`bit_rt_port_shims_strlen_scan`, not `strlen` — that
// name is ../shims.bit's and claiming it twice is a duplicate definition). The
// pin is required because `../shims.bit`'s `strlen` is a one-line wrapper: at
// `-O1` the inliner splices this body's CALL across the module boundary, so
// what survives into the `runtime/shims` object is a reference to THIS
// function, and `--freestanding` refuses an unpinned cross-module reference
// (#1627, SPEC §11.9). `bit_rt_port_` marks it temporary and non-ABI, so
// #1369's rename never touches it — same convention as `runtime/gc`'s
// `bit_rt_port_mem_*`.
export @symbol("bit_rt_port_shims_strlen_scan")
function strlenScan(s: *u8): i64 {
  let n = 0
  // Bounded by the caller's NUL terminator. This is the C contract: an
  // unterminated buffer is undefined behaviour in libc's `strlen` too, and the
  // callers here are std's own startup paths passing real C strings.
  while (true) {
    let p = s + n
    if (*p == u8(0)) {
      return i64(n)
    }
    n = n + 1
  }
}
