// `stwSafepoint`'s preemption check (#2577) below is the only new caller of
// this in this module — everything else here already reaches `taskAt`,
// `gcAddr`/`worldAddr`/`schedAddr` etc. through `stw.bit`'s own imports in
// this same module. The actual `maybePreempt`/`schedYield` logic lives in
// `../sched/preempt.bit` (see its own comment on why the split matters), so
// this one pinned entry point is all `stwSafepoint` needs.
//
// #3560 also reaches into `../sched` from `stwPollNeeded` itself, below, for
// `schedCurrentWorker`/`preemptRequested`/`wkId` — see that clause's own
// comment for why, and for the leaf cost it pays.
//
// #4203 REPLACED `schedCurrentWorker`/`preemptRequested`/`wkId` with the
// summary `preemptAnyPending`, and added `pollRequest`/`pollConsume`
// (../sched/pollreq.bit) — the word a compiled mutator now reads at its back
// edge instead of re-deriving this whole predicate.
import { schedMaybeYieldForPreempt, preemptAnyPending } from "../sched"
import { pollRequest, pollConsume } from "../sched"

// ---------------------------------------------------------------------------
// `bit_rt_safepoint_needed` — the SPEC, not what compiled code runs (#2921, #2925/#3169)
// ---------------------------------------------------------------------------
//
// #2921 had the arm64 backend call this before the unconditional
// `bl bit_rt_safepoint` it used to emit at every loop back edge. #2925
// (arm64) and #3169 (x64) then INLINED this function's own condition
// directly into each backend's codegen instead of calling it —
// compiler/codegen.bit:322: "NO BACKEND EMITS `bit_rt_safepoint_needed` ANY
// MORE". Confirmed empirically on #3560: `nm` on a compiled program with a
// hot loop shows no `bit_rt_safepoint_needed` symbol at all (dead-stripped,
// zero callers, zero relocations to it), and the same binary's only
// safepoint call, at every back edge, is `bl _bit_rt_safepoint`.
//
// So THIS FUNCTION IS THE SPEC both backends' inlined ladders MUST MIRROR
// EXACTLY (compiler/codegen.bit's header on the shared word-offset table),
// not the code a compiled program executes. A change here changes nothing
// about a running program until the two mirrors are updated to match —
// #3560 found this the hard way: the preempt clause below, alone, does NOT
// make cooperative preemption observable in a compiled program, because
// nothing compiled calls this function. The two backends' own mirrors need
// the identical clause; that is deliberately a separate ticket (bigger,
// touches two architectures, its own #3359-style regression risk to
// measure) rather than folded in here.
//
// Every condition below except the preempt clause is still a TRUE LEAF (no
// calls of its own, so no stack frame at all): #2921's own measurement is
// that removing the poll entirely gets collatz from 2.09s to 0.36s against a
// 1.0s acceptance bar, so a leaf guard only needs to be cheap, not
// branch-free. THE PREEMPT CLAUSE IS NOT A LEAF — `schedCurrentWorker` and
// `preemptRequested` are real cross-module calls into `../sched`
// (`optimizeModule` only inlines within one module, compiler/opt.bit:612),
// so the moment that clause exists in this function's body, the WHOLE
// FUNCTION stops being a leaf: a function's prologue is emitted once at
// entry and charged to every return, including the early ones that never
// reach the call. See that clause's own comment for the measured cost.
//
// THE LEAF WAS ALSO LOST ONCE BEFORE FOR A DIFFERENT REASON, AND THE FIX WAS
// TO STOP ADDING BRANCHES, NOT TO STOP ADDING CONDITIONS. #3292 appended the
// object trigger to the tail below as an `if`-ladder with an
// overflow-guarded `nextBytes + nextBytes` ceiling. Nothing about that was
// wrong as a predicate — but it put three more values live across a branch,
// and this function is register-allocated with a full block-parameter
// shuffle at EVERY edge, so each one added a `mov` to every edge until the
// caller-saved budget ran out and x19/x20/x21 spilled. The result was a
// `sub sp, sp, #0x30` prologue and a five-register reload at every one of
// the seven returns — charged to the EARLY returns too, which are the whole
// point of the function. 102 -> 230 instructions, and `matrix`'s 805M back
// edges paid 168.5 G of them (#3359). That regression was reachable WITHOUT
// any call at all, purely from live-value pressure in an if-ladder — a
// different mechanism than #3560's clause below, which loses the leaf via a
// real call regardless of ladder-vs-single-expression form.
//
// So the byte/object trigger tail is deliberately ONE `return` expression
// rather than an `if` ladder: the same three comparisons written as an
// `if`/`return` chain measured 190 and kept the frame, the single expression
// measured 125 without one. That is a fact about this backend's
// block-parameter shuffle (#1852 is the missing copy-propagation that would
// make the two forms equal), so re-measure rather than assume if you rewrite
// it.
//
// THE CHECK, cheap enough to run on any change to this function — since
// #3560 it is EXPECTED to show a prologue (`sub sp, sp, #N`), not absent
// one; re-run this after any further change and compare the instruction
// count and prologue size against #3560's own recorded numbers rather than
// expecting zero output:
//
//   otool -tvV bit-out/lib/aarch64-macos/libbitrt.a ... runtime_stw.o
//     | sed -n '/^_bit_rt_safepoint_needed:/,/^_[a-zA-Z]/p' | grep 'sub.*sp, sp, #'
//
// MUST BE A SAFE OVER-APPROXIMATION of `stwPollOn`'s early-return ladder
// below: returning false here must be provably a no-op there, in EVERY state
// including pre-boot and GC-disabled. Returning true more often than strictly
// necessary only costs one real poll's price; returning false when a stop is
// pending or a collection is due breaks the STW handshake silently (ABI.md
// §5) — exactly the failure a green timing benchmark cannot catch, so this
// function is mutation-tested in both directions, not just measured.
//
// It does NOT re-derive `worldEnsureSelfOn`'s registration on every call, the
// way the real poll's own hint-based fast path does (`mutatorSlot`, below) —
// that is what buys back the four frames on top of `bit_rt_safepoint`'s own
// naked shim. That omission is safe: registration is find-or-claim, not
// re-claimed, and a thread that has never allocated (so never reached the
// allocation door's own registration, ../gc/gcalloc.bit `registerAllocator`)
// still registers and parks correctly the first time this function observes a
// pending stop — the one fact it checks unconditionally on every call, which
// is the fact the rendezvous actually depends on.
export @nosplit @symbol("bit_rt_safepoint_needed") fn stwPollNeeded(): bool {
  let waddr = worldAddr
  if (waddr == 0) {
    return true // pre-boot / racing bind: let the real poll sort it out
  }
  // `>> 3`, not `/ 8` (#3904): `waddr` is `worldAddr`, the module-global World
  // struct address bound once at boot from a real allocation (never 0 past
  // the guard above), so it is never negative and the shift agrees with the
  // division on every value it can hold — the same trade `worker` below
  // already makes.
  let worldNil: *i64 = nil
  let world = worldNil + (waddr >> 3)
  // MUST MIRROR stwPollOn's own first check below — unconditional every call,
  // same as there, because this is the fact the STW rendezvous depends on.
  if (atomicLoad(world + worldStopWord) != 0) {
    return true // a stop is pending
  }
  // #3560 -- clause 3: a preempt is pending. Orthogonal to GC state entirely
  // (a task must stay preemptible even with GC disabled), so this runs before
  // the GC-specific checks below, not folded into their tail.
  //
  // #4203 ASKS THE SUMMARY, NOT THIS WORKER. The clause used to call
  // `schedCurrentWorker()` and then `preemptRequested(workerId)` -- two real
  // cross-module calls, which is what cost this function its leaf status (see
  // the header above). `preemptAnyPending` (../sched/preempt.bit) is the
  // conservative form of the same question: it can read 1 with nothing pending
  // for THIS worker, and can never read 0 with something pending for it. This
  // function's own contract is "a safe over-approximation" (header above), so
  // widening a clause from one worker to any worker stays inside it -- a false
  // positive costs one real poll, and `schedMaybeYieldForPreempt`
  // (`stwSafepoint`, below) still makes the per-worker decision about whether
  // to actually yield. #4203 needs the global form regardless: the word this
  // predicate republishes is read by every thread, so a per-worker answer
  // would be wrong to store in it.
  if (preemptAnyPending()) {
    return true // a preempt is pending somewhere
  }
  let gA = gcAddr
  if (gA == 0) {
    return true // paranoia: the same pre-boot race, the other global
  }
  // `>> 3`, not `/ 8` (#3904): `gA` is the module-global GC struct address,
  // bound once at boot from a real allocation, never negative.
  let gNil: *i64 = nil
  let g = gNil + (gA >> 3)
  if (*(g + gcCfgStress) != 0) {
    return true // stress mode always wants the real poll (../gc/gc.bit gcConfigure)
  }
  if (*(g + gcCfgEnabled) == 0) {
    return false // disabled: stwPollOn returns without acting
  }
  // MUST MIRROR stwPollOn's trigger check below, which MUST MIRROR
  // `gcShouldCollect` (../gc/gccollect.bit, #3292): the byte trigger alone is
  // necessary but no longer sufficient once mark cost is paced on objects
  // too. Returning true when the real predicate would say no is still SAFE —
  // the slow path re-checks under the lock and just returns without
  // collecting — but it is not free: it is the whole locked slow path, on
  // every back edge, for as long as the byte trigger stays crossed and the
  // object trigger has not caught up. So this checks both, the same O(1)
  // loads-and-compares `gcShouldCollect` does (never a division here: both
  // triggers are precomputed once per collection, not derived per call).
  // `>> 3`, not `/ 8` (#3904): `*(g + gcHeapAddr)` is the heap state block's
  // address, written once in `gcInit` from a real allocation (../gc/gc.bit),
  // never negative.
  let hNil: *i64 = nil
  let hb = hNil + (*(g + gcHeapAddr) >> 3)
  let liveBytes = atomicLoad(hb + heapLiveWord)
  let nextBytes = *(g + gcNextBytes)
  // `liveBytes - nextBytes >= nextBytes` IS the second-growth-cycle ceiling
  // `liveBytes >= nextBytes * 2`, exactly, for every non-negative pair — and
  // it needs neither the overflow guard nor `gcAddrMax`, because the doubling
  // was the only thing that could overflow and this does not double. It is
  // also exact when the byte trigger is NOT crossed (`liveBytes - nextBytes`
  // goes negative, which is < a non-negative `nextBytes`), so the `&&` is a
  // short-circuit for speed, not a guard the subtraction depends on.
  //
  // The one state where this differs from #3292's saturating form is
  // `liveBytes == gcAddrMax` with `nextBytes > gcAddrMax / 2`, where that form
  // clamped the ceiling to `gcAddrMax` and so fired at exactly 2^63-1 live
  // bytes. That is 8 EiB of live heap and it is unreachable; clamping meant
  // "this arm cannot fire", and not firing is what this form encodes.
  // `gcShouldCollect` and `stwPollOn` below carry the identical expression.
  return liveBytes >= nextBytes &&
    (liveBytes - nextBytes >= nextBytes || *(g + gcNumObjectsIdx) >= *(g + gcNextObjects))
}

// ---------------------------------------------------------------------------
// The poll body — `safepointImpl` (runtime/root/:638), IN FULL
// ---------------------------------------------------------------------------
//
// `snap` is the address of the caller's `SafepointFrame` (ABI.md §4), which the
// naked shim below reserved on THIS thread's own stack. Per-thread by
// construction — no TLS, no registration, no ordering — which is the #1429 fix;
// the frame used to be one process-wide global and two workers polling at once
// overwrote each other's registers and then both collected.
//
// The frame is valid for exactly as long as this call: it lives below the
// shim's `sp`, so publishing it (`worldPark`) is sound only while this thread
// stays inside the shim, which parking guarantees.
//
// Exactly one of three things happens (ABI.md §5):
//
//  1. Someone else is collecting -> park here until they finish. A mutator that
//     ignored this would run behind the collector's back.
//  2. Nobody is collecting and the trigger is not crossed -> return. The hot
//     path: one atomic load plus the trigger test.
//  3. The trigger is crossed -> try to become the collector.
//
// The `tryAcquire` LOSER PARKS rather than spinning on the lock. That is the
// deadlock-freedom argument, and it is why `worldLockTry` exists alongside the
// spinning `worldLockAcquire`: a thread the collector is waiting for is never
// itself waiting for the collector.
//
// `@nosplit` is REQUIRED, not stylistic — see the pin-cycle note above.
export @nosplit @symbol("bit_rt_port_stw_poll") fn stwPoll(snap: int) {
  stwPollOn(gcAddr, schedAddr, chanRegAddr, worldAddr, snap)
}

// The same poll over CALLER-SUPPLIED bindings (#1836).
//
// The live path above must read module state: the safepoint shim is `@naked` and
// calls this with nothing but a snapshot, so there is nowhere else for the four
// addresses to come from. A program driving a PRIVATE collector has no such
// constraint, and calling `stwBind` to get one is not "private" at all — that
// sets process-wide bindings, so it replaces the live runtime's for every
// thread. (`worldBind` was the other half of this hazard and no longer exists:
// #2184 removed it, so a private World can ONLY be reached through the
// parameterised doors now.) `_tests_/stress/stwcollect` did exactly that and the live worker
// joined the test's registry as a mutator the test never created and could not
// schedule; the rendezvous waited on it and abandoned (#1833).
//
// This is the line Go draws too. Components owning process-global state are
// tested against the live runtime; components taking their state as a parameter
// get real private instances, and those never write the global — `NewPageAlloc`
// is handed `new(mutex)` and its own stats (`src/runtime/export_test.go`). Go
// has no way to disable runtime startup at all, which is why the alternative of
// an env-gated inert mode was rejected.
//
// Every binding is a parameter, including the World, so a caller can hold one
// the live runtime has never heard of.
export @nosplit @symbol("bit_rt_port_stw_poll_on") fn stwPollOn(
  gcA: int,
  schedA: int,
  chanRegA: int,
  worldA: int,
  snap: int,
) {
  // Registers this thread if it has not registered yet, and parks it there if a
  // stop is already pending. Publishes the REAL snapshot: `runtime/root/`'s
  // `currentMutator` passes 0 from the allocation door (runtime code, no stack
  // map) but its real frame from the safepoint door, and parking with 0 would
  // hide exactly the references this poll's stack map names.
  let mu = worldEnsureSelfOn(worldA, snap)

  // Inlined `worldBlockAddr` + `wordAt` (#1700): `worldAddr` is this module's
  // own cache (`stwBind`'s 4th param), so this is a plain load instead of a
  // cross-module call.
  let waddr = worldA
  if (waddr == 0) {
    return // pre-boot: `worldSetReady` has not run, so the registry is closed
  }
  // `>> 3`, not `/ 8` (#3904): `waddr` is `worldA`, a caller-supplied World
  // struct address — the live runtime's `worldAddr` or a private caller's own
  // `ptrOf`-derived block (every call site: ../root/*, _tests_/stress/stw*) —
  // never negative, so the shift agrees with the division on every value.
  let worldNil: *i64 = nil
  let world = worldNil + (waddr >> 3)

  // MUST MIRROR `worldStopRequested` (../gc/gcworldstop.bit) — inlined to skip
  // a cross-module call on this hot path.
  if (atomicLoad(world + worldStopWord) != 0) {
    // Someone is collecting. Park until they finish. `worldPark` returns at
    // once if the stop cleared in the gap, which is what makes this safe to
    // call speculatively. A thread with no slot has nothing to publish and
    // nothing waits for it.
    if (mu != 0) {
      worldPark(world, mu - 1, snap)
    }
    return
  }

  // MUST MIRROR the former `stwCanCollect` (see its note above) — inlined for
  // the same reason.
  if (gcA == 0) {
    return
  }
  if (schedA == 0) {
    return
  }
  if (chanRegA == 0) {
    return
  }
  // `>> 3`, not `/ 8` (#3904): `gcA` is a caller-supplied GC struct address,
  // same provenance argument as `worldA` above, never negative.
  let gNil: *i64 = nil
  let g = gNil + (gcA >> 3)

  // MUST MIRROR `gcShouldCollect` (../gc/gccollect.bit, #3292) — inlined for
  // the same reason. DRIFT HERE SILENTLY DISABLES COLLECTION: keep this
  // predicate exactly in step with the real one (the cold path below still
  // calls the real function, so both must agree). Returning here early is
  // just as important as returning true correctly: this runs BEFORE
  // `worldLockTry` below, so a wrong "not due yet" costs nothing, but a wrong
  // "due" that reaches the lock pays for an atomic CAS and release for no
  // reason — exactly the cost `stwPollNeeded` above exists to avoid.
  if (*(g + gcCfgEnabled) == 0) {
    return
  }
  if (*(g + gcCfgStress) == 0) {
    // `>> 3`, not `/ 8` (#3904): same argument as `stwPollNeeded`'s identical
    // load above — `gcHeapAddr` is written once in `gcInit` from a real
    // allocation, never negative.
    let hNil: *i64 = nil
    let hb = hNil + (*(g + gcHeapAddr) >> 3)
    let liveBytes = atomicLoad(hb + heapLiveWord)
    let nextBytes = *(g + gcNextBytes)
    if (liveBytes < nextBytes) {
      return
    }
    // The de Morgan of `stwPollNeeded`'s tail above and `gcShouldCollect`'s,
    // in the same overflow-free subtraction form (#3359): neither the second
    // growth cycle nor the object trigger is due, so nothing to do.
    if (liveBytes - nextBytes < nextBytes && *(g + gcNumObjectsIdx) < *(g + gcNextObjects)) {
      return
    }
  }

  // A thread with no slot must not collect: `worldRendezvous` skips only the
  // collector's own slot, so a slotless collector would wait for itself forever.
  if (mu == 0) {
    return
  }
  let selfSlot = mu - 1

  if (!worldLockTry(world)) {
    // Another thread is collecting, or is about to. Park speculatively — a
    // no-op if it turns out no stop is pending.
    worldPark(world, selfSlot, snap)
    return
  }

  // Re-test UNDER THE LOCK: the thread that just released it may have collected
  // everything we were about to collect for.
  if (gcShouldCollect(g)) {
    if (worldRendezvous(world, selfSlot)) {
      stwCollect(g, world, selfSlot, snap, schedA, chanRegA)
    } else {
      // Could not stop the world within the bound. ABANDON — never force.
      // Skipping a collection only costs heap growth; collecting while a mutator
      // runs costs correctness.
      // Atomic (#3299): see the comment on `stwAbandonedCount` (stw.bit).
      let _ = atomicAdd(ptrOf(stwAbandoned), 1)
    }
    // Restart on BOTH paths: `rendezvous` sets the stop flag before it waits, so
    // an expired rendezvous leaves it set and every mutator that already parked
    // would never resume.
    worldRestart(world)
  }
  worldLockRelease(world)
}

// ---------------------------------------------------------------------------
// The LIVE entry — AND THE GATE THAT USED TO BE HERE (#1639, removed by #1650)
// ---------------------------------------------------------------------------
//
// This is what the shim below actually calls. For years it added NOTHING to
// `stwPoll`, and the fact that it added nothing was the fix, so the removed
// code is recorded here rather than deleted silently — read on for the one
// thing #2577 now adds, and why it is safe to add here rather than in
// `stwPollOn`/`stwPoll`.
//
// It used to read `if (schedCurrentTask() == 0) { return }` — poll only from a
// green task's stack. That was never a policy; it was a workaround for
// `gcworld.bit` keeping ONE process-wide `curMut` where `runtime/root/` keeps a
// `threadlocal g_mutator`. With one shared cache, letting the boot thread and a
// worker thread both poll meant both would read and write one slot, and the
// consequence was not a lost collection but a corrupted heap: the boot thread
// would collect using the worker's slot as "its own", and `worldRendezvous` and
// the parked-frame walk both SKIP the collector's own slot, so the worker's
// published frame — the only precise record of the running task's references —
// would never be scanned and every reference in it would be swept.
//
// THE GATE'S OWN COST WAS THE SAME CLASS OF BUG, one level up, and that is #1650.
// `schedCurrentTask()` returns 0 on a worker's OWN OS-thread stack, so a worker's
// run loop never polled. But `schedWorkerRun`'s `nowFn`/`pollFn` are function
// VALUES — `(code, env)` cells on the managed heap (§11.10) — and they live in
// that loop's frames, on exactly the stack the gate excluded. None of
// `stwCollect`'s five root classes covers a worker's own off-task stack, so
// those cells were swept while live and the next call through one branched into
// freed memory: `_tests_/stress/chanracelinux` faulted 20 runs out of 20 on both
// ELF targets. The pre-port `safepointImpl` had no gate, and its control run
// keeps `survivors=4` — the four cells (two threads x two closures) an ungated
// poll holds alive.
//
// So the claim "that set is EXACTLY the set the thread-local admits" was wrong,
// and wrong in the unsafe direction: an ungated poll admits EVERY thread that
// reaches a safepoint, and a worker's scheduling loop is compiled Bit code that reaches
// plenty. `../gc/gcthread.bit` now supplies a real per-OS-thread token, so the
// registry is keyed rather than shared and the gate has nothing left to protect.
//
// KEPT AS A SEPARATE FUNCTION even though it was a pure forward for years,
// because it is the pinned symbol the naked shim below materializes with
// `entryOf` and the name the ABI names. Collapsing it into `stwPoll` would
// also re-merge the split `_tests_/stress/stwcollect` (#1633) depends on, which
// drives `stwPoll` directly with a collector block of its own.
//
// #2577 — COOPERATIVE PREEMPTION, CHECKED STRICTLY AFTER `stwPoll` RETURNS.
//
// `stwPoll` above has, by the time it returns here, already done everything
// the STW rendezvous requires for this call: registered this thread
// (`worldEnsureSelfOn`), parked if a stop was pending, and collected if this
// thread won the race to. Only once ALL of that is settled does
// `schedMaybeYieldForPreempt` (`../sched/preempt.bit` — see its own comment
// for the full design, including a real bug this ordering and split caught)
// get to ask whether this task has burned its budget and, if so, hand the
// CPU back the same way an ordinary voluntary yield already does. That
// ordering is why this call sits here and not inside `stwPollOn`/`stwPoll`: a
// pending preempt can never be observed before, or instead of, the
// rendezvous check above — only once the rendezvous has nothing left to ask
// of this call.
//
// WHY HERE AND NOT IN `stwPollOn`: `stwPollOn` is also driven directly, with
// a caller-supplied private world/gc/sched block, by `_tests_/stress/stwcollect`
// (see `stwPoll`'s own comment above) — exactly the kind of private instance
// #1833 warns is not safe to cross with the LIVE global scheduler.
// `schedMaybeYieldForPreempt` reads the one live, global scheduler
// unconditionally, regardless of which bindings a caller passed to
// `stwPollOn`, so putting this call there would make a private collector's
// poll silently reach into the live task registry — the same class of bug
// #1833 found, one layer up. This function is the live entry ONLY (never
// called with private bindings), so it is the correct — and only safe —
// place for it.
//
// NO NEW CONTEXT SWITCH: the yield `schedMaybeYieldForPreempt` takes is
// `schedYield`, unmodified, the same path an ordinary cooperative yield
// already uses (`../sched/task.bit`), so this reuses whatever already keeps a
// yielded task's stack registered and conservatively scannable (#1562) — the
// requirement is inherited, not re-proven here.
export @nosplit @symbol("bit_rt_port_stw_safepoint") fn stwSafepoint(snap: int) {
  // #4203: CONSUME FIRST, REPUBLISH LAST, and both halves are load-bearing.
  //
  // The clear must precede every read of the state it summarises. A slow path
  // that worked and then cleared would lose a request published in between;
  // this order cannot, because every writer stores its state before it stores
  // the word (../sched/pollreq.bit's `pollConsume` carries the interleaving
  // proof). So a request landing after this line survives into the word and the
  // next back edge polls again, and one landing before it is seen by the work
  // below.
  pollConsume()
  stwPoll(snap)
  schedMaybeYieldForPreempt()
  // Republish if a reason still holds -- which is the normal case under
  // `BIT_GC=stress` (`gcShouldCollect` is unconditionally true there, so every
  // back edge polls exactly as it did before the word existed) and the case
  // that keeps the collector moving when this call could not collect: a lost
  // `worldLockTry`, or a thread with no mutator slot. This only ever SETS, so
  // it cannot undo a request that arrived while `stwPoll` ran.
  if (stwPollNeeded()) {
    pollRequest()
  }
}

// ---------------------------------------------------------------------------
// `bit_rt_safepoint` — the naked register/frame snapshot shim (ABI.md §4)
// ---------------------------------------------------------------------------
//
// Zero-arg, `callconv(.c)`, emitted by both backends at every loop back edge.
// Naked so it runs with NO prologue: it captures the caller's return address,
// frame pointer and callee-saved register file BEFORE any compiled code could
// overwrite them, then hands that snapshot to `stwPoll` as its first C argument.
//
// The `SafepointFrame` layout it builds is runtime/root/'s, field for field:
//   +0   ret        the caller's return address (0 would mean "not captured")
//   +8   fp         the caller's frame pointer
//   +16  regs[32]   regs[n] at +16+8n, physical register n's live value
// `regs` is deliberately NOT zeroed — this runs at every back edge and clearing
// 32 words per poll is not free. Sound because ABI.md §4 restricts the registers
// a stack map may name at a safepoint to exactly the callee-saved file saved
// here, and because every word the walk reads goes through the validating
// `gcMarkRoot`.
//
// The reservation is 8 bytes larger than the 272-byte class on x86-64 and 16
// larger on AArch64, purely to keep the stack ABI-aligned at the call. A function
// containing a safepoint is non-leaf by construction (it calls this), so it may
// not rely on the x86-64 red zone and overlapping that zone costs nothing.
//
// THE PAYLOAD IS HAND-ENCODED AND DISASSEMBLY-CHECKED — there is no text
// assembler in the toolchain (§11.6), and a wrong offset here does not fail a
// build, it publishes the wrong register as a root.
//
//   x86-64 (rbx=3, r13=13, r14=14, r15=15, rsi=6, rdi=7 ->
//   +40,+120,+128,+136,+64,+72):
//     48 81 EC 18 01 00 00        subq  $280, %rsp
//     4C 8B 84 24 18 01 00 00     movq  280(%rsp), %r8    # the caller's ret addr
//     4C 89 04 24                 movq  %r8, 0(%rsp)
//     48 89 6C 24 08              movq  %rbp, 8(%rsp)
//     48 89 5C 24 28              movq  %rbx, 40(%rsp)
//     4C 89 6C 24 78              movq  %r13, 120(%rsp)
//     4C 89 B4 24 80 00 00 00     movq  %r14, 128(%rsp)
//     4C 89 BC 24 88 00 00 00     movq  %r15, 136(%rsp)
//     48 89 74 24 40              movq  %rsi, 64(%rsp)
//     48 89 7C 24 48              movq  %rdi, 72(%rsp)    # rdi's ORIGINAL value, before it is overwritten below
//     48 89 E7                    movq  %rsp, %rdi        # arg 0 = the frame (SysV: RDI)
//     48 89 E1                    movq  %rsp, %rcx        # arg 0 = the frame (Win64: RCX)
//     FF D0                       call  *%rax
//     48 8B 7C 24 48              movq  72(%rsp), %rdi    # restore rdi — see #3592 below
//     48 81 C4 18 01 00 00        addq  $280, %rsp
//     C3                          ret
//   At entry `rsp % 16 == 8` (the caller's `call` pushed the return address), so
//   subtracting 280 restores `rsp % 16 == 0` for the call while leaving the
//   return address at 280(%rsp). `rbp` is still the caller's frame pointer — no
//   prologue ran. `rcx`/`r8`/`rax` are caller-saved under both x64 conventions,
//   so materializing them cannot destroy a callee-saved value before it is
//   saved; `rdi` is NOT (#3592, below) and `rsi` is only ever read, never
//   written, by this payload.
//
//   #3554: this shim is emitted identically for every x64 target (ELF, Mach-O
//   AND PE), but SysV (ELF/Mach-O) and Win64 (PE) disagree on which register
//   carries a call's first integer argument — RDI vs RCX
//   (compiler/x64call.bit's `xArg0`). The payload used to write the frame
//   pointer into RDI only and call through RCX (which under Win64 is the
//   CALL TARGET register, not an argument register) — `stwSafepoint`, compiled
//   `XCallConv.Win64` for x86_64-windows (compiler/emitpecode.bit:112), read
//   its `snap` argument out of RCX, i.e. out of its own entry address, not the
//   frame pointer. `stwPoll` then walked garbage instead of the real
//   SafepointFrame, so a live-only-in-a-register root at a back-edge safepoint
//   was silently invisible to the scan on x86_64-windows specifically — the
//   ordinary allocation-triggered collector never hits this path (it walks the
//   real, ABI-correct call chain from inside `bit_rt_gc_alloc` instead), so
//   only `BIT_GC=stress`, which forces a poll at every back edge, exposed it.
//   Fixed by writing the frame pointer into BOTH RDI and RCX and moving the
//   call-target materialization off RCX onto RAX (caller-saved and unused by
//   either convention's argument bank), so the same bytes are correct under
//   both ABIs with no target-OS branch needed.
//
//   #3592: a THIRD instance of the same SysV-assumption class, in this same
//   payload, and #3554's own fix comment states the wrong premise —
//   "rdi/rcx/r8/rax are all caller-saved under both x64 conventions" is true
//   for rcx/r8/rax but false for rdi. Under Win64, `rdi` (and `rsi`) are
//   CALLEE-SAVED (compiler/x64.bit's `xIsCalleeSavedInt`), so a Windows build
//   of a function with a back-edge safepoint may allocate a live-across-the-poll
//   GC reference into either — `compiler/x64frame.bit`'s `xBuildSavedGpr`
//   derives the allocator's callee-saved file straight from `xIsCalleeSavedInt`,
//   with no exemption for this call site. Before this fix the payload (a) wrote
//   `%rsp` into `rdi` UNCONDITIONALLY, permanently destroying any live value a
//   Windows caller had there regardless of whether a collection ever ran, and
//   (b) never wrote regs[6]/regs[7] (rsi/rdi) into the snapshot at all, so even
//   when rdi/rsi survived untouched, a collection reached from a NESTED call
//   (`gc_alloc`, not this shim's own poll) would read `runtime/gc/stackmap.bit`
//   `gcScanSnapshot`'s uninitialized regs[6]/regs[7] slots — leftover stack
//   bytes, not the real pointer — and silently fail to root the object,
//   letting it be freed and reused while a live Bit reference still pointed at
//   it. Reproduced on real Windows hardware, `std/os`'s `args()` under
//   `BIT_GC=stress` (`stdlib/os/os.bit`'s `append`-in-a-loop is exactly a
//   back-edge safepoint with `out` live across it): `len(args())` printed a
//   different garbage number every run (3/3), and `args()[0]` segfaulted
//   (3/3). Fixed by saving rsi/rdi into the snapshot alongside the other four,
//   and by saving rdi's ORIGINAL value before overwriting it and restoring it
//   after the call returns — harmless extra work under SysV (where rdi was
//   already volatile and a caller never expected it preserved), load-bearing
//   under Win64.
//
//   #3604: reached this same fix independently, via a different
//   reproduction that hit the same two failures far more than occasionally —
//   `stdlib/crypto/bigintmodexp.bit`'s constant-time Montgomery ladder
//   (`bigintModExpMont`/`bigintMontMul`, the RSA CRT private-key path), whose
//   long, allocation-heavy loops cross this safepoint constantly with a live
//   value in exactly the registers above: ~66% of fresh `bigintModExp` calls
//   returned a wrong result under real (non-stress) collection on native
//   x86_64-windows, and 0% with `BIT_GC=off` — which skips the call to this
//   shim entirely (`compiler/x64controlflow.bit`'s `xEmitInlinedPollGuard`,
//   the "disabled -> skip" clause), the same mutation-tested signature #3554
//   used. #3592 merged first with the byte-identical fix; #3604 closed as a
//   duplicate, but its reproduction is recorded here since nothing else in
//   the tree carries it.
//
//   AArch64 (x19..x28 -> +168..+240):
//     D10483FF   sub  sp, sp, #288
//     F90003FE   str  x30, [sp, #0]        # x30 = the caller's return address
//     F90007FD   str  x29, [sp, #8]        # x29 = the caller's frame pointer
//     A90AD3F3   stp  x19, x20, [sp, #168]
//     A90BDBF5   stp  x21, x22, [sp, #184]
//     A90CE3F7   stp  x23, x24, [sp, #200]
//     A90DEBF9   stp  x25, x26, [sp, #216]
//     A90EF3FB   stp  x27, x28, [sp, #232]
//     910003E0   mov  x0, sp               # arg 0 = the frame
//     F81F0FFE   str  x30, [sp, #-16]!
//     D63F0020   blr  x1
//     F84107FE   ldr  x30, [sp], #16
//     910483FF   add  sp, sp, #288
//     D65F03C0   ret
//   288 keeps `sp` 16-aligned (the hardware enforces it). `x0`/`x1` are the first
//   argument and caller-saved scratch, so neither disturbs the saved file. `x30`
//   is preserved across the call by its own push, NOT by the frame copy, so the
//   return path does not depend on the callee leaving the frame untouched.
//
// `input` materializes `entryOf(stwSafepoint)` into `rax`/`x1` ahead of the
// payload — the gated live entry, not `stwPoll` itself; see its comment —
// the only compiler-emitted instruction in this function, an inline address
// materialization against a link-time constant (§11.10) that touches no other
// register and no memory. `entryOf` rather than a direct call because §11.6 has
// no relocation for a branch OUT of an `asm` block. `rax` rather than `rcx`
// (#3554) so `rcx` is free to carry the Win64 argument alongside `rdi`'s SysV
// one — see the x86-64 payload comment above.
//
// PINNED `bit_rt_safepoint`, its bare ABI name: G2 (#1583) dropped the `_root`
// infix, as for every other pin in this tree (#1624).
@naked @symbol("bit_rt_safepoint") fn safepointEntry() {
  return asm volatile {
    x64 {
      0x48, 0x81, 0xEC, 0x18, 0x01, 0x00, 0x00,
      0x4C, 0x8B, 0x84, 0x24, 0x18, 0x01, 0x00, 0x00,
      0x4C, 0x89, 0x04, 0x24,
      0x48, 0x89, 0x6C, 0x24, 0x08,
      0x48, 0x89, 0x5C, 0x24, 0x28,
      0x4C, 0x89, 0x6C, 0x24, 0x78,
      0x4C, 0x89, 0xB4, 0x24, 0x80, 0x00, 0x00, 0x00,
      0x4C, 0x89, 0xBC, 0x24, 0x88, 0x00, 0x00, 0x00,
      0x48, 0x89, 0x74, 0x24, 0x40,
      0x48, 0x89, 0x7C, 0x24, 0x48,
      0x48, 0x89, 0xE7,
      0x48, 0x89, 0xE1,
      0xFF, 0xD0,
      0x48, 0x8B, 0x7C, 0x24, 0x48,
      0x48, 0x81, 0xC4, 0x18, 0x01, 0x00, 0x00,
      0xC3,
    }
    arm64 {
      0xD10483FF,
      0xF90003FE,
      0xF90007FD,
      0xA90AD3F3,
      0xA90BDBF5,
      0xA90CE3F7,
      0xA90DEBF9,
      0xA90EF3FB,
      0x910003E0,
      0xF81F0FFE,
      0xD63F0020,
      0xF84107FE,
      0x910483FF,
      0xD65F03C0,
    }
    input arm64 x1 x64 rax = entryOf(stwSafepoint)
    // rdi is written mid-payload but RESTORED before `ret` (#3592) — its
    // value at function exit equals its value at entry, so it is no longer
    // listed here. rsi is only ever read (into the snapshot), never written.
    clobber x64 { rcx, r8, memory }
    clobber arm64 { x0, memory }
  }
}
