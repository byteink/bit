// Darwin page provider for the Stage-2 port of runtime/alloc.zig (#1362).
// See ../alloc.bit for why the port is split by directory rather than
// switching on the OS inside one file.
//
// This is the Bit form of `alloc.zig`'s `mapPages`/`unmapPages` on the POSIX
// branch. Unlike the Linux side it goes through libSystem (§11.7) rather than
// raw traps: Apple publishes no stable syscall numbers and reserves the right
// to renumber them, so the supported path is a C call — the same reason
// `extern function` exists at all.
//
// EVERY CONSTANT BELOW WAS READ OUT OF THE SDK'S <sys/mman.h> AT THE VALUES
// THIS MACHINE COMPILES AGAINST, NOT from memory. Note they differ from Linux:
// Darwin's MAP_ANON is 0x1000, where Linux's MAP_ANONYMOUS is 0x20.

// mmap(2) / munmap(2) from libSystem. Only C-representable types cross the
// boundary (§11.7), so addresses travel as `*u8` and lengths as `i64`.
extern function mmap(addr: *u8, nbytes: i64, prot: i32, flags: i32, fd: i32, offset: i64): *u8
extern function munmap(addr: *u8, nbytes: i64): i32

// getpagesize(3). Queried rather than named, because the answer is not the
// obvious one: aarch64-macOS uses 16384-byte pages, four times the Linux value
// (confirmed with `getconf PAGESIZE`). Hardcoding 4096 here would make the
// allocator round direct-mapped requests to a sub-page granule.
extern function getpagesize(): i32

// PROT_READ (0x01) | PROT_WRITE (0x02).
@nosplit function protReadWrite(): int { return 3 }

// MAP_PRIVATE (0x0002) | MAP_ANON (0x1000) = 4098.
@nosplit function mapPrivateAnon(): int { return 4098 }

// The page size the allocator rounds direct-mapped requests up to.
export @nosplit function pageSize(): int { return int(getpagesize()) }

// Map `nbytes` bytes of zeroed, writable, private memory. Returns the base
// address, or 0 when the kernel refuses — the Bit form of the Zig's `?[*]u8`
// null.
//
// mmap reports failure as MAP_FAILED, which is `(void *)-1` — NOT null, and not
// a negative errno as the Linux raw syscall returns. That difference is the
// whole reason these two files cannot share an error check.
export @nosplit @symbol("bit_rt_port_alloc_map_pages") function mapPages(nbytes: int): int {
  if (nbytes <= 0) {
    return 0
  }
  let hint: *u8 = nil
  let p = mmap(hint, i64(nbytes), i32(protReadWrite()), i32(mapPrivateAnon()), i32(0 - 1), i64(0))
  let addr = int(p)
  if (addr == 0 || addr == 0 - 1) {   // NULL or MAP_FAILED
    return 0
  }
  return addr
}

// Return `nbytes` bytes at `addr` to the kernel. True on success.
//
// The Zig's `unmapPages` returns void and ignores failure. The bool is reported
// here rather than swallowed so the stress test can assert the mapping really
// went back — a leaked mapping is invisible otherwise.
//
// PINNED (#1662), as its `mapPages` sibling already is: `runtime/root/{linux,
// darwin}`'s `bit_rt_root_unmap_pages` wrapper calls it across the module
// boundary, and `-O1` splices this body into that caller, so the reference that
// survives into the root object is THIS callee. An unpinned mangled callee is
// exactly what `--freestanding` refuses (SPEC §11.9). `bit_rt_port_alloc_`, not
// `bit_rt_`: this is the page provider's own port-internal name, never an ABI
// symbol, so #1369's rename must not touch it.
export @nosplit @symbol("bit_rt_port_alloc_unmap_pages") function unmapPages(addr: int, nbytes: int): bool {
  if (addr == 0 || nbytes <= 0) {
    return false
  }
  let base: *u8 = nil
  return int(munmap(base + addr, i64(nbytes))) == 0
}
