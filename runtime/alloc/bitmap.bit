// #3147/#3176: the per-span occupied-slot bitmap — sizing, addressing and a
// test-only reader. Sibling of `./alloc.bit`, same module (SPEC §17.1):
// `allocSpanBytes`, `allocSpanHdrWords`, `allocSpanOf`, `allocWordAt`,
// `allocClassSize`, `allocSpanSlots` and `spanSkip` are all declared there and
// visible here with no import, exactly as `./classify.bit` and
// `./spancache.bit` already rely on. Split out purely to keep `alloc.bit`
// under `tests/bit/lintfilelines.bit`'s 800-line gate (E0200) — it was
// already at exactly that limit before #3176 (see `./spancache.bit`'s
// header). This seam declares no const, struct or type of its own, so there
// is no ordering question, only the diagnostic-order one the differentials
// cover (`bitlang-ws/CLAUDE.md`, "Splitting a file").
//
// THE FULL DESIGN, INCLUDING WHY WRITES LIVE IN `runtime/gc/` AND NOT HERE, IS
// `../gc/gcindex.bit`'s design comment. In one line: the bitmap is a
// per-class extension of the span's reserved header prefix (`spanSkip`,
// `./alloc.bit`), sized off the slot count BEFORE the bitmap's own bytes
// remove any (avoiding a circular sizing dependency), and it is set/cleared
// only by `runtime/gc/`'s `linkObject`/`freeObject` — `runtime/alloc/` cannot
// tell a real object from `gcInit`'s mark worklist, which allocates through
// this heap without ever becoming a tracked object.

// ---------------------------------------------------------------------------
// PREREQUISITE FOR ANY READER: THE BITMAP IS NOT ZEROED AT CARVE TIME (#3177)
// ---------------------------------------------------------------------------
//
// `heapRefillLocked` (`./alloc.bit`) initialises the ten header words and the
// free list and stops. Nothing zeroes the bitmap, so a span that has been
// through the #3045 cache and is re-carved FOR A DIFFERENT CLASS starts life
// with stale bits set. That is harmless only because nothing reads the bitmap;
// #3177's reader is reverted (see `../gc/gcindex.bit`), and the FIRST thing the
// next attempt must do is fix this.
//
// WHY IT HAPPENS. The bitmap sits at a fixed offset and its extent depends on
// the class: `allocBitmapWords` is LARGEST for the SMALLEST class (class 0: 256
// words, ending at byte 2128) and smallest for the largest (class 36: 1 word,
// ending at byte 88). A class's first slot, `spanSkip(cs) * cs`, starts as low
// as byte 192 (class 10). So for 24 of the 37 classes the old slot area
// overlaps a subsequent class-0 bitmap — and a reclaimed span's slots hold
// free-list `next` POINTERS, never zeroes. Overlaps, in bytes, against class
// 0's 2128-byte bitmap: class 1 1024, class 2 1520, class 3 1696, class 4 1744,
// class 10 1936 (the worst), ... class 24 80. Classes 25-36 do not overlap.
//
// WHAT IT COSTS IF UNFIXED. Those stale bits read as OCCUPIED, so `gcOwns`
// answers true for slots that hold nothing, `gcMarkRoot` decodes a header 32
// bytes below a free-list link, and the collector marks and later sweeps
// garbage as if it were an object. Measured with #3177's reader attached:
// `bench/cases/json` crashed on roughly 70% of runs, layout-dependent.
//
// WHY `tests/stress/gcslotbitmap` CANNOT CATCH IT. It keeps one object alive
// per span precisely so no span is ever reclaimed, and its arena is
// caller-bound, so `reserveHeadOwns` reports `owned = 0` and
// `heapReclaimSpansLocked` skips every span it owns. No span in that fixture is
// ever re-carved for a different class. Any guard for this needs spans the
// RESERVE mapped.
//
// WHY IT IS NOT FIXED HERE. The obvious fix — zero `allocBitmapWords(cs)` words
// in `heapRefillLocked` — is correct and was measured on `bench/cases/json`
// against the same tree without it, interleaved run-by-run so both saw the same
// machine. json's retired-instruction count is BIMODAL at roughly 99G and 124G
// (the cheap mode is the run where the index grows one step less). The minimum
// barely moves (+0.4% to +0.9% over 24 paired runs), but the zeroing roughly
// HALVES the probability of the cheap mode — 17 of 24 paired runs cheap without
// it, 7 of 24 with it — which is about +25% on the median. Paying that for a
// structure nothing reads is the wrong trade, so it belongs in the commit that
// lands the reader. Scope it to spans that came from the span CACHE: a span
// straight from `reserveGrow` is fresh `mmap` memory and already zero, and a
// span from a caller-bound arena is never reclaimed (`owned = 0`), so REUSE is
// the only path that needs it.

// 64-bit words needed for class `cs`'s occupied-slot bitmap (one bit per
// slot). Sized off `naive(cs) = allocSpanBytes / cs`, the slot count BEFORE
// `spanSkip`'s reservation removes any — sizing off the post-reservation
// count would be circular, and `naive(cs)` is a safe upper bound because
// `spanSkip` only ever shrinks the usable count further.
@nosplit fn allocBitmapWords(cs: int): int {
  let naive = allocSpanBytes / cs
  return (naive + 63) / 64
}

// The pure addressing primitive the occupied-slot bitmap is built on —
// mirrors `allocSpanOf` in taking a raw address and nothing else the caller
// must already know except which class it belongs to. Returns the slot index
// of `addr` within its span for class `idx`, or -1 when `addr` is NOT the
// exact base of a slot (out of the span's carved range, or an interior offset
// into one).
//
// THE REMAINDER CHECK IS LOAD-BEARING, NOT DEFENSIVE. Floor division alone
// (`off / cs`) aliases every interior address inside a slot's `cs` bytes onto
// that slot's own index — an interior pointer and its slot's base would
// otherwise test identically. `gcOwns`'s contract (ABI.md §3, and the design
// note in `../gc/gcindex.bit`) requires interior pointers to answer false, so
// the `off % cs != 0` check must run BEFORE the bit is trusted by any future
// caller. This ticket's own callers (`linkObject`/`freeObject`, always exact
// slot bases from the allocator itself) never hit the -1 case; a future
// `gcOwns` caller (#3177) reading an arbitrary candidate pointer will.
export @nosplit @symbol("bit_rt_alloc_slot_index") fn allocSlotIndex(addr: int, idx: int): int {
  let cs = allocClassSize(idx)
  let carveStart = allocSpanOf(addr) + spanSkip(cs) * cs
  let off = addr - carveStart
  if (off < 0) { return -1 }
  if (off % cs != 0) { return -1 }
  let n = off / cs
  if (n >= allocSpanSlots(idx)) { return -1 }
  return n
}

// Word `wordIdx` of the span's occupied-slot bitmap, immediately after the
// 10-word header — the same "read by address, so a test can compute occupancy
// independently" pattern `allocSpanClass`/`allocSpanTotal`/`allocSpanFree`
// (`./alloc.bit`) already use. `gcOwns` does not read this yet (#3177); this
// exists solely so a test can compute a popcount over the bitmap and compare
// it against `spanTotal - spanFree`, which the allocator already maintains
// through an entirely separate path.
export @nosplit fn allocSpanBitmapWord(spanAddr: int, wordIdx: int): int {
  let w = allocWordAt(spanAddr + allocSpanHdrWords * 8 + wordIdx * 8)
  return *w
}
