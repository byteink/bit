// The size-class table and the size -> class mapping. Sibling of `./alloc.bit`,
// same module (SPEC §17.1) — `allocNumClasses` and `allocMaxSmall` are declared
// there at module scope and are visible here with no import, exactly as
// `./spancache.bit`'s counterpart in `_tests_/stress/alloc` relies on.
//
// Split out to keep `alloc.bit` under `_tests_/bit/lintfilelines.bit`'s 800-line
// gate (E0200): it sat at exactly 800, with no room for a line. See
// `bitlang-ws/CLAUDE.md`'s "Splitting a file" section — this seam declares no
// const, class or type of its own, so there is no ordering question at all,
// only the diagnostic-order one the differentials cover.
//
// WHY THIS SEAM AND NOT ANOTHER. Everything here is a PURE FUNCTION of its
// arguments: no heap word is read, no lock is taken, nothing is mutated. That
// is what makes an exhaustive equivalence check over the whole input domain
// possible, with no state to set up.

// --- Size classes -----------------------------------------------------------

// Size of class `i`.
//
// Bit cannot index a literal table here: a bracket literal is a
// SLICE (a top-level `const` array is not a compile-time constant, E0064), and
// slice indexing lowers to `bit_rt_slice_get`, which `@nosplit` rejects (E0075)
// because it can allocate and reach a safepoint. So the table is computed.
//
// From index 4 up the table is four classes per octave — base, +1/4, +2/4, +3/4
// — which is exactly `base + r * (base/4)` for `base = 64 << g`. The first four
// entries predate that regular structure and are named outright.
//
// This is the one place the port replaces data with arithmetic, so it is the
// one place a typo would be invisible: `_tests_/stress/alloc`'s property (a)
// dumps all 37 entries as a position-weighted checksum and pins the result
// (`tbl=106248/3375880` in `_tests_/stress/alloc/alloc.expected`), which
// changes if any single entry is wrong or if two are transposed.
export @nosplit fn allocClassSize(i: int): int {
  if (i < 4) {
    if (i == 0) { return 8 }
    if (i == 1) { return 16 }
    if (i == 2) { return 32 }
    return 48
  }
  let g = (i - 4) / 4
  let r = (i - 4) % 4
  let base = 64 << g
  return base + r * (base / 4)
}

// --- Pure helpers -----------------------------------------------------------

// Round `n` up to a multiple of the power of two `a`, by mask.
export @nosplit fn allocAlignUp(n: int, a: int): int {
  return (n + a - 1) & ~(a - 1)
}

// A zero-byte request still consumes one page on the large path.
export @nosplit @symbol("bit_rt_alloc_non_zero") fn allocNonZero(n: int): int {
  if (n == 0) { return 1 }
  return n
}

// Index of the highest set bit of `v`, for `v >= 1`. An unrolled binary
// search, not a loop: four compares cover the whole 64-bit range, and this is
// called once per `allocClassify` on the fast path.
//
// `>>` and not `/`, and it is sound rather than merely faster (#3904): every
// caller here passes a positive `needed`, so there is no negative-dividend
// rounding question to get wrong.
@nosplit fn allocMsb(v: int): int {
  let x = v
  let k = 0
  if (x >= 256) {
    x = x >> 8
    k = k + 8
  }
  if (x >= 16) {
    x = x >> 4
    k = k + 4
  }
  if (x >= 4) {
    x = x >> 2
    k = k + 2
  }
  if (x >= 2) { k = k + 1 }
  return k
}

// The size-class index for an already-aligned `needed`, in CLOSED FORM: the
// smallest class at least as large as `needed`, computed rather than searched.
//
// PRECONDITION, established by the caller and NOT rechecked here:
// `112 < needed <= allocMaxSmall`, and the request's alignment is a power of
// two no larger than 8. Every class size is a multiple of 8, so under that
// alignment the scan's `cs % alignment == 0` filter is vacuous and "first class
// that fits" IS the scan's answer.
//
// WHY THE ARITHMETIC WORKS. From index 4 up, every class size is `k * 2^j`
// with `k` in 4..7 — that is `allocClassSize`'s `base + r * (base/4)` for
// `base = 64 << g`, read as a 3-bit mantissa `k = 4 + r` and an exponent
// `j = g + 4`. So rounding `needed` up to a class is just rounding it up to
// three significant bits:
//
//   s = msb(needed) - 2                  the weight of the lowest kept bit
//   q = ceil(needed / 2^s)               the 3-bit mantissa, in 4..8
//   q == 8 is the carry case             renormalise to q = 4, s = s + 1
//   index = 4 + 4*(s - 4) + (q - 4)      = 4*s + q - 16, and 4*s - 8 on carry
//
// The formula is correct from class 4 (64 bytes) up, but the caller answers
// everything through class 7 (112 bytes) by a cheaper route, so `needed > 112`
// is the domain that reaches here.
//
// EXHAUSTIVELY EQUIVALENT TO THE SCAN, not argued to be:
// `_tests_/stress/alloc/classify.bit` runs this against a verbatim copy of the
// pre-#3100 scan over every (size, alignment) pair in the domain.
@nosplit fn allocClassIndexOf(needed: int): int {
  let s = allocMsb(needed) - 2
  let q = (needed + (1 << s) - 1) >> s
  if (q > 7) { return 4 * s - 8 }
  return 4 * s + q - 16
}

// The pre-#3100 linear scan, still the answer for every alignment the fast
// path's guard turns away: not a power of two, larger than 8, or zero or
// negative (where `cs % alignment` traps, and must keep trapping).
//
// Split out of `allocClassify` for E0204 headroom, not for speed — it is one
// `bl` on a path no caller in this repo takes.
@nosplit fn allocClassifyScan(needed: int, alignment: int): int {
  let i = 0
  while (i < allocNumClasses) {          // bounded: <= allocNumClasses iterations
    let cs = allocClassSize(i)
    // `cs % alignment == 0` plus a page-aligned span base means every slot in
    // the class is `alignment`-aligned.
    if (cs >= needed && cs % alignment == 0) { return i }
    i = i + 1
  }
  return -1                              // unreachable for alignment <= allocMaxSmall
}

// Map a request to a size-class index, or -1 if it must be direct-mapped.
// There is no optional int in this subset, and -1 is not a valid
// class index, so it carries "none" unambiguously.
//
// ON THE HOT PATH TWICE PER OBJECT. `gcHeapAlloc` (runtime/gc/gc.bit) calls it
// on every allocation and `gcHeapFree` on every free, and `linkObject` and
// `freeObject` each call it once more, so it runs four times per object
// lifecycle. #3098 measured the scan at 10.5% of the `alloc` benchmark's
// cycles for a 48-byte object — more than every seq-cst atomic in the
// allocator put together — and #4041 measured it at 278.07 instructions per
// call for a 56-byte one, 50.2% of the whole 2214.7-instruction lifecycle,
// because #3100's ladder stopped at class 3 and the scan below is LINEAR in
// the class index: 64 instructions at 40 bytes, 670 at 232, 1062 at 1000.
// #4042 replaced the ladder with a closed form covering every class, so the
// cost no longer grows with the request.
export @nosplit @symbol("bit_rt_alloc_classify") fn allocClassify(size: int, alignment: int): int {
  let needed = allocAlignUp(size, alignment)
  if (needed > allocMaxSmall) { return -1 }

  // FAST PATH, #3100 and #4042. Every class size is a multiple of 8, so when
  // `alignment` divides 8 the scan's `cs % alignment` filter is vacuous and the
  // scan's answer is exactly the first class at least as large as `needed` —
  // which is what `allocClassIndexOf` returns, for the WHOLE range rather than
  // #3100's first four classes. An EQUIVALENCE, not an approximation: no size
  // class, no span layout and no safety check changes, and
  // `_tests_/stress/alloc/classify.bit` proves the two halves agree on EVERY
  // (size, alignment) pair in range rather than on a sample.
  //
  // BOTH HALVES OF THE GUARD ARE LOAD-BEARING, and neither is obvious.
  //   - the power-of-two test, because for `alignment` 3, 5, 6 or 7 the filter
  //     is NOT vacuous: 8 % 6 != 0 while 48 % 6 == 0, so the scan answers class
  //     3 where a bare `alignment <= 8` fast path answers class 0. Those
  //     alignments are nonsense — `allocAlignUp` is a power-of-two mask — and
  //     no caller passes one, but "nonsense in, DIFFERENT nonsense out" is
  //     still a behaviour change, and this function's failure mode is silent
  //     heap corruption, so it is not a licence worth taking.
  //   - `alignment > 0`, because `cs % 0` traps in the scan below today. The
  //     fast path must keep trapping rather than quietly start answering.
  //
  // CLASSES 0-7 ARE ANSWERED IN THIS FRAME, and that is measured rather than
  // stylistic: routing the small classes through `allocClassIndexOf` instead
  // cost 64.01 -> 81.01 instructions per call at 40 bytes, because the
  // inliner takes only single-block callees under 8 instructions
  // (`compiler/optinline.bit`) and no branching helper can ever qualify — so a
  // 2-field class would have paid a whole call frame it did not pay before. A
  // 2-field class is 49% of the declarations in compiler+stdlib+runtime; that
  // is a regression on the commonest object in the language, bought with a win
  // on larger ones.
  //
  // `ceil(needed / 16)` IS the class index from 16 through 112, because those
  // seven classes are exactly the multiples of 16 in order: 16, 32, 48, 64, 80,
  // 96, 112 at indices 1..7. Two compares and three arithmetic operations
  // therefore replace #3100's four-rung ladder AND reach three classes further,
  // covering every object up to a ten-field class. `needed - 1` is safe to
  // shift here — the `needed <= 8` rung above has already taken every zero and
  // negative request.
  if (alignment > 0 && alignment <= 8 && (alignment & (alignment - 1)) == 0) {
    if (needed <= 8) { return 0 }
    if (needed <= 112) { return ((needed - 1) >> 4) + 1 }
    return allocClassIndexOf(needed)
  }

  return allocClassifyScan(needed, alignment)
}
