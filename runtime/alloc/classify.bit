// The size-class table and the size -> class mapping. Sibling of `./alloc.bit`,
// same module (SPEC §17.1) — `allocNumClasses` and `allocMaxSmall` are declared
// there at module scope and are visible here with no import, exactly as
// `./spancache.bit`'s counterpart in `tests/stress/alloc` relies on.
//
// Split out to keep `alloc.bit` under `tests/bit/lintfilelines.bit`'s 800-line
// gate (E0200): it sat at exactly 800, with no room for a line. See
// `bitlang-ws/CLAUDE.md`'s "Splitting a file" section — this seam declares no
// const, struct or type of its own, so there is no ordering question at all,
// only the diagnostic-order one the differentials cover.
//
// WHY THIS SEAM AND NOT ANOTHER. Everything here is a PURE FUNCTION of its
// arguments: no heap word is read, no lock is taken, nothing is mutated. That
// is what makes an exhaustive equivalence check over the whole input domain
// possible, with no state to set up.

// --- Size classes -----------------------------------------------------------

// Size of class `i`.
//
// Bit cannot index a literal table here: a bracket literal is a
// SLICE (a top-level `const` array is not a compile-time constant, E0064), and
// slice indexing lowers to `bit_rt_slice_get`, which `@nosplit` rejects (E0075)
// because it can allocate and reach a safepoint. So the table is computed.
//
// From index 4 up the table is four classes per octave — base, +1/4, +2/4, +3/4
// — which is exactly `base + r * (base/4)` for `base = 64 << g`. The first four
// entries predate that regular structure and are named outright.
//
// This is the one place the port replaces data with arithmetic, so it is the
// one place a typo would be invisible: `tests/stress/alloc`'s property (a)
// dumps all 37 entries as a position-weighted checksum and pins the result
// (`tbl=106248/3375880` in `tests/stress/alloc/alloc.expected`), which
// changes if any single entry is wrong or if two are transposed.
export @nosplit fn allocClassSize(i: int): int {
  if (i < 4) {
    if (i == 0) { return 8 }
    if (i == 1) { return 16 }
    if (i == 2) { return 32 }
    return 48
  }
  let g = (i - 4) / 4
  let r = (i - 4) % 4
  let base = 64 << g
  return base + r * (base / 4)
}

// --- Pure helpers -----------------------------------------------------------

// Round `n` up to a multiple of the power of two `a`, by mask.
export @nosplit fn allocAlignUp(n: int, a: int): int {
  return (n + a - 1) & ~(a - 1)
}

// A zero-byte request still consumes one page on the large path.
export @nosplit @symbol("bit_rt_alloc_non_zero") fn allocNonZero(n: int): int {
  if (n == 0) { return 1 }
  return n
}

// Map a request to a size-class index, or -1 if it must be direct-mapped.
// There is no optional int in this subset, and -1 is not a valid
// class index, so it carries "none" unambiguously.
export @nosplit @symbol("bit_rt_alloc_classify") fn allocClassify(size: int, alignment: int): int {
  let needed = allocAlignUp(size, alignment)
  if (needed > allocMaxSmall) { return -1 }
  let i = 0
  while (i < allocNumClasses) {          // bounded: <= allocNumClasses iterations
    let cs = allocClassSize(i)
    // `cs % alignment == 0` plus a page-aligned span base means every slot in
    // the class is `alignment`-aligned.
    if (cs >= needed && cs % alignment == 0) { return i }
    i = i + 1
  }
  return -1                              // unreachable for alignment <= allocMaxSmall
}
