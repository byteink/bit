// The #3045 span cache. Sibling of `./alloc.bit`, same module (SPEC §17.1),
// split out purely to keep `alloc.bit` under `_tests_/bit/lintfilelines.bit`'s
// 800-line gate (E0200) — no semantic reason for the split, see
// `bitlang-ws/CLAUDE.md`'s "Splitting a file" section: filename order affects
// diagnostic order only, never correctness, for a seam with no declarations
// of its own (this file adds none — only functions over the sibling's).
//
// #2803's mechanism in one line: reclaiming a span returns its PAGES but
// throws away its ADDRESS RANGE, because `runtime/gc/mem.bit`'s reserve is a
// pure bump allocator with no free list — so every reclaim forces the next
// refill to burn a fresh chunk, and the better the collector reclaims, the
// faster the reserve burns (up to tens of GB of abandoned chunks in a
// long-lived process). This is the fix: a bounded list of spans reclaimed but
// not yet unmapped, so a refill can reuse an address instead of asking the
// reserve for a new one.
//
// Threaded through the span's own FIRST WORD (`spanClass`), the same trick
// `reserveGrow` uses for its chunk list (`chunkNextOff` = 0 there too):
// `spanClass` is meaningless on a span that is off every class list, which a
// cached span always is, so overwriting it costs nothing and needs no
// eleventh header word.
//
// AN IDLE CACHED SPAN GOES BACK TO THE OS (#6050). The cache only bounds what
// a peak leaves resident, at `allocSpanCache` spans; it never gave any of it
// back: a pkg/web soak's RSS stepped up at two rare peaks and stayed. So the
// cache ages like `./largecache.bit`, on the same GC epoch: a push stamps the
// span, the list is newest-first so the stale spans are a suffix, and
// `heapSpanCacheAgeLocked` unlinks the oldest of them once no refill has taken
// them for `allocSpanCacheAge` collections, at most `allocSpanCacheTrim` per
// collection. `runtime/gc` decommits each onto the reserve's span free list
// (`spanFreeListPush`), which keeps the address for the next refill.

// Collections a cached span may sit untaken before it is released, and the
// most released by one collection. The age keeps a heap that swings by a few
// spans from one cycle to the next from paying a decommit and its refaults
// every cycle; the cap bounds the syscalls one stopped-world sweep pays, so
// a full cache drains over eight collections rather than in one pause.
export const allocSpanCacheAge: int = 16
export const allocSpanCacheTrim: int = 8

// A cached span's stamp lives in `spanTotal`'s word, which means nothing off
// every class list and which `heapRefillLocked` rewrites on the way back out.
const spanCacheStamp: int = 1

// Push `spanAddr` onto the cache. CALLER MUST HOLD THE LOCK. Returns 1 if
// cached, 0 if the cache is already at `allocSpanCache` — the caller's cue
// that it must still unmap the span itself.
export @nosplit @symbol("bit_rt_heap_span_cache_push_locked") fn heapSpanCachePushLocked(
  h: *i64,
  spanAddr: int,
): int {
  let count = *(h + heapSpanCacheCountWord)
  if (count >= allocSpanCache) {
    return 0
  }
  let sp = allocWordAt(spanAddr)
  *sp = *(h + heapSpanCacheWord)
  *(sp + spanCacheStamp) = *(h + heapLargeCacheEpochWord)
  *(h + heapSpanCacheWord) = spanAddr
  *(h + heapSpanCacheCountWord) = count + 1
  return 1
}

// Pop a span address off the cache, or 0 when it is empty. CALLER MUST HOLD
// THE LOCK. Every span this returns was pushed by `heapSpanCachePushLocked`,
// which only ever receives spans `heapReclaimSpansLocked` marked doomed —
// and that pass only takes spans with `spanOwned != 0` — so a cached span is
// always one the caller may pass `owned = true` for.
//
// #3925: ZERO THE #3176 OCCUPIED-SLOT BITMAP HERE, ON THE WAY OUT OF THE
// CACHE — not in `heapRefillLocked`. The only caller of this function
// (`gcHeapAlloc`, `runtime/gc/gcheap.bit`) always carries a cached span straight
// into `heapRefillLocked` for a NEW class, and that class need not be the one
// this span last held: the bitmap's extent is per-class (`allocBitmapWords`,
// `./bitmap.bit`), so re-carving for a different class can read the old
// class's slot area — free-list `next` POINTERS, never zeroes — as the new
// class's bitmap. A span from `reserveGrow` (fresh mmap) or from the #3868
// free list (`spanFreeListPush` remaps it) already arrives zeroed, so only
// this path needs it (`./bitmap.bit`'s header has the full argument and the
// measured cost of doing it unconditionally instead).
//
// `heapRefillLocked` does not know which of those three sources handed it a
// span, and threading that through would mean widening its signature and
// every call site's — including `runtime/gc/gc.bit`, which is not this
// module. Here, `heapSpanCacheTakeLocked` KNOWS it is the cache path by
// construction, with no new parameter and no other caller to update.
//
// Zero class 0's width, not the destination class's: class 0 has the fewest
// bytes per slot (`allocClassSize(0)` is the smallest) and so the MOST slots
// and the WIDEST bitmap of any of the 37 classes, and every class's bitmap
// starts at the same offset (`allocSpanHdrWords * 8`) — so class 0's region
// is a superset of whichever class this span is refilled for next, computed
// here where the destination class is not yet known.
export @nosplit @symbol("bit_rt_heap_span_cache_take_locked") fn heapSpanCacheTakeLocked(h: *i64): int {
  let head = *(h + heapSpanCacheWord)
  if (head == 0) {
    return 0
  }
  let sp = allocWordAt(head)
  *(h + heapSpanCacheWord) = *sp
  *(h + heapSpanCacheCountWord) = *(h + heapSpanCacheCountWord) - 1
  let bwords = allocBitmapWords(allocClassSize(0))
  let bi = 0
  // Bounded: 256 words (class 0's width), independent of the destination class.
  while (bi < bwords) {
    let bw = allocWordAt(head + allocSpanHdrWords * 8 + bi * 8)
    *bw = 0
    bi = bi + 1
  }
  return head
}

// The cache's scavenger, once per collection with the sweep's lock held.
// Unlinks the oldest spans no refill has taken for `allocSpanCacheAge`
// collections, at most `allocSpanCacheTrim` of them, and returns them as a
// chain through each span's first word. `runtime/gc` decommits the chain.
export @nosplit @symbol("bit_rt_heap_span_cache_age_locked") fn heapSpanCacheAgeLocked(h: *i64): int {
  let minStamp = *(h + heapLargeCacheEpochWord) - allocSpanCacheAge
  let count = *(h + heapSpanCacheCountWord)
  let link = h + heapSpanCacheWord
  let fresh = 0
  // Bounded: at most `allocSpanCache` entries, in both loops together.
  while (*link != 0 && *(allocWordAt(*link) + spanCacheStamp) >= minStamp) {
    link = allocWordAt(*link)
    fresh = fresh + 1
  }
  let cut = count - fresh
  if (cut > allocSpanCacheTrim) {
    cut = allocSpanCacheTrim
  }
  let skip = count - fresh - cut
  while (skip > 0) {
    link = allocWordAt(*link)
    skip = skip - 1
  }
  let chain = *link
  *link = 0
  *(h + heapSpanCacheCountWord) = count - cut
  return chain
}

// Spans the cache holds now: what `_tests_/stress/gcspanage` reads to prove
// `heapSpanCacheAgeLocked` releases them.
export @nosplit fn heapSpanCacheLen(h: *i64): int {
  return *(h + heapSpanCacheCountWord)
}
