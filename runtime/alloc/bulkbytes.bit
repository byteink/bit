// Bulk byte primitives for a Bit-level byte-scanning loop to call INSTEAD of
// iterating one byte per back edge (#3207).
//
// WHY THIS EXISTS. Under `BIT_GC=stress`, `gcShouldCollect` returns `true`
// unconditionally and the check runs at every loop back edge in every
// compiled function (runtime/gc/gccollect.bit, runtime/gc/gcworld.bit) — so a
// plain Bit `while` loop copying, comparing, or scanning one byte per
// iteration pays one full stop-the-world collection PER BYTE. `stdlib/crypto`'s
// DER/ASN.1 and PEM parsers are exactly that shape (asn1.bit's per-primitive
// content copy, pem.bit's marker search and whitespace strip), so parsing the
// 128-certificate system trust store costs ~1.4-1.7M collections (#2299).
//
// These three collapse an N-byte Bit-level loop into ONE call each. A call is
// a safepoint site in the stack map regardless of `@nosplit` (SPEC §10.3.1: "a
// call is a safepoint site... whether or not the enclosing function is
// @nosplit"), so the N per-byte polls a Bit loop would have taken become the
// ONE poll already implicit at this call's own return address — nothing is
// hidden from the collector, the same root set is walkable at that one point
// that would have been walkable at every one of the N.
//
// BOUNDEDNESS (SPEC §10.3.1 / #2207's family: an unbounded no-poll primitive
// would let a mutator run arbitrarily long without ever reaching a safepoint).
// These are NOT capped to a compile-time constant; each is bounded by the
// caller-supplied `n`, exactly the shape `runtime/root/root.bit:574`'s
// `copyBytes` already ships with — that function backs EVERY string
// concatenation and slice expression in the language today, `@nosplit`,
// bounded only by its own `n`, no internal poll. This is that established
// precedent applied to a second caller (stdlib, across the `extern fn`
// boundary, SPEC §11.7's "a runtime symbol (bit_rt_*) is the case this rule
// admits"), not a new risk class: a copy/compare/scan of one already-resident,
// already-allocated byte range is bounded by how much memory the process
// could plausibly hold, and every real caller here is one DER/PEM field from
// a single certificate (a few KB at most).
//
// `*byte` arithmetic scales by 1 (sizeOf(byte) == 1, SPEC §11.4), so `p + i`
// addresses byte `i` directly — no division or stride needed, unlike
// `allocWordAt`'s `*i64` (../alloc.bit).

// Copies `n` bytes from `src` to `dst`. The two regions must be disjoint —
// every call site here copies into a freshly allocated destination, never
// overlapping its own source, so no overlap handling is needed (mirrors
// `copyBytes`'s identical assumption, root.bit:571-573).
export @nosplit @symbol("bit_rt_bytes_copy")
fn bytesCopy(dst: *byte, src: *byte, n: int) {
  let i = 0
  while (i < n) {
    *(dst + i) = *(src + i)
    i = i + 1
  }
}

// Whether the `n` bytes at `a` and the `n` bytes at `b` are identical.
export @nosplit @symbol("bit_rt_bytes_equal")
fn bytesEqual(a: *byte, b: *byte, n: int): bool {
  let i = 0
  while (i < n) {
    if (*(a + i) != *(b + i)) {
      return false
    }
    i = i + 1
  }
  return true
}

// The index (0-based, within `[0, n)`) of the first occurrence of `b` at or
// after `p`, or -1 if `b` does not occur in the first `n` bytes.
export @nosplit @symbol("bit_rt_bytes_indexbyte")
fn bytesIndexByte(p: *byte, n: int, b: byte): int {
  let i = 0
  while (i < n) {
    if (*(p + i) == b) {
      return i
    }
    i = i + 1
  }
  return -1
}
