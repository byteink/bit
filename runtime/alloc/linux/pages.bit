// Linux page provider for the Stage-2 port of runtime/alloc/ (#1362).
// See ../alloc.bit for why the port is split by directory rather than
// switching on the OS inside one file.
//
// This is the Bit form of `runtime/alloc/`'s `mapPages`/`unmapPages` on the POSIX
// branch: anonymous, private, read-write pages straight from the kernel. Raw
// syscalls (§11.8) rather than a libc, for the reason the whole runtime uses
// them — the ELF output is fully static with no libc to call into.
//
// EVERY CONSTANT BELOW WAS READ OUT OF THE KERNEL UAPI HEADERS
// (the kernel syscall table for the numbers, `<sys/mman.h>` for PROT/MAP),
// NOT from memory, and each is exercised by tests/stress/syscall, which issues
// this exact 6-argument mmap. A wrong number here is a silent wrong-syscall,
// not a compile error.

// The syscall numbers come from `runtime/syscalls` (#1897), which owns every
// one this runtime uses and picks per architecture (§11.8: Bit has no
// arch-conditional compilation, so the choice happens at run time). They used to
// be a local `nr()` here, and `mmap`/`munmap` were spelled identically in
// ../../thread/linux/spawn.bit with nothing checking the two agreed.
//
// The whole file is `@nosplit` since #1638, because `mapPages` is now called
// from the collector's allocation path, which is `@nosplit` throughout — so
// every callee it names must be `@nosplit` too (E0075), which those are.

import { sysMmap, sysMunmap } from "../../syscalls"

// PROT_READ (0x1) | PROT_WRITE (0x2).
@nosplit function protReadWrite(): int { return 3 }

// MAP_PRIVATE (0x02) | MAP_ANONYMOUS (0x20). Anonymous mappings ignore the fd,
// which is passed as -1 by convention.
@nosplit function mapPrivateAnon(): int { return 34 }

// The page size the allocator rounds direct-mapped requests up to.
//
// 4096 on both x86_64 and aarch64 Linux — verified with `getconf PAGESIZE` on
// both a native aarch64 container and the x86_64 test box, not assumed. The
// reads this from `std.heap.pageSize()`, which resolves the same value from
// auxv; a static Bit binary has no auxv accessor yet, so it is named here.
//
// A larger true page size would still be SAFE rather than wrong: mmap rounds a
// request up internally and munmap rounds a length up to a whole page, so the
// mapping and the unmapping stay paired. It would only make `mappedBytes`
// under-report, which is why this is pinned to the measured value.
export @nosplit function pageSize(): int { return 4096 }

// Map `nbytes` bytes of zeroed, writable, private memory. Returns the base address,
// or 0 when the kernel refuses — null as zero.
//
// `nbytes` is expected to be a multiple of `pageSize()`; the allocator's two
// callers (a span, and a direct-mapped request already rounded by
// `allocLargeLen`) both satisfy that.
//
// A raw syscall returns a small negative errno on failure. Anything else is a
// real address, so the sign test is the whole error check: the kernel never
// hands back a valid mapping in the top half of the address space for an
// unhinted anonymous request.
export @nosplit @symbol("bit_rt_port_alloc_map_pages") function mapPages(nbytes: int): int {
  if (nbytes <= 0) {
    return 0
  }
  let rc = int(syscall(sysMmap(), 0, i64(nbytes), i64(protReadWrite()),
                       i64(mapPrivateAnon()), 0 - 1, 0))
  if (rc <= 0) {
    return 0
  }
  return rc
}

// Return `nbytes` bytes at `addr` to the kernel. True on success.
//
// Failure is not actionable by a caller (a munmap of a range this module mapped
// panics only on a programming error). The bool is reported here rather than
// swallowed so the stress test can assert the mapping really went back —
// a leaked mapping is invisible otherwise.
//
// PINNED (#1662), as its `mapPages` sibling already is: `runtime/root/{linux,
// darwin}`'s `bit_rt_unmap_pages` wrapper calls it across the module
// boundary, and `-O1` splices this body into that caller, so the reference that
// survives into the root object is THIS callee. An unpinned mangled callee is
// exactly what `--freestanding` refuses (SPEC §11.9). `bit_rt_port_alloc_`, not
// `bit_rt_`: this is the page provider's own port-internal name, never an ABI
// symbol, so #1369's rename must not touch it.
export @nosplit @symbol("bit_rt_port_alloc_unmap_pages") function unmapPages(addr: int, nbytes: int): bool {
  if (addr == 0 || nbytes <= 0) {
    return false
  }
  return int(syscall(sysMunmap(), i64(addr), i64(nbytes))) == 0
}
