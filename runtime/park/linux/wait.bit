// Linux parking provider for the Stage-2 port of runtime/sched/'s idle path
// (#1403). See ../park.bit for why the port is split by directory rather than
// switching on the OS inside one file, and for what this module deliberately
// does NOT contain (OS thread creation, blocked on #1404).
//
// Raw syscalls (§11.8) rather than a libc, for the reason the whole runtime uses
// them: the ELF output is fully static with no libc to call into.
//
// EVERY CONSTANT BELOW WAS READ OUT OF THE KERNEL UAPI HEADERS, NOT FROM MEMORY —
// syscall numbers from the kernel's per-arch syscall tables, the futex
// operation encoding from `<linux/futex.h>`, which is a
// `packed class(u32) { cmd: u7, private: bool, ... }` — so the private flag is
// bit 7, i.e. 128. A wrong number here is a silent wrong-syscall, not a compile
// error; _tests_/stress/park issues each of these against the real kernel and
// asserts the documented return code.

// Syscall numbers are per-architecture and Bit has no arch-conditional
// compilation, so the number is selected at run time (§11.8). `hostTarget()` is
// 0 for x86_64-linux and 1 for aarch64-linux; this module is only ever built for
// a Linux target, so the two cases are exhaustive. Same shape as
// runtime/alloc/linux/pages.bit.

// PR_SET_TIMERSLACK / PR_GET_TIMERSLACK, from `<linux/prctl.h>` —
// read out of the pinned stdlib like every other constant in this file, not from
// memory.

import { sysClockGettime, sysFutex, sysNanosleep, sysPrctl, sysSchedGetaffinity } from "../../syscalls"
import { nsPerSec } from "../../park"

fn prSetTimerslack(): int { return 29 }
fn prGetTimerslack(): int { return 30 }

// The slack to ask for, in nanoseconds. 1 is the smallest accepted non-zero
// value (0 means "restore the inherited default", which is the opposite of what
// is wanted here), so this asks the kernel for the finest granularity it will
// give and lets the hardware timer decide the real floor — measured at ~9us on
// aarch64, against a 50us default slack.
fn timerslackNs(): int { return 1 }

// FUTEX_WAIT (cmd 0) and FUTEX_WAKE (cmd 1), both with FUTEX_PRIVATE_FLAG
// (bit 7 = 128).
//
// PRIVATE is not an optimisation detail — it is a correctness statement. It
// tells the kernel the futex word is never shared with another process, which
// lets it skip the mmap-semantics lookup and key the wait queue on the virtual
// address alone. The scheduler's worker words live in the process's own
// bookkeeping (allocated straight from the OS, never shared), so PRIVATE is
// accurate. It also matches Darwin, where `__ulock` is process-private by
// construction and has no shared mode at all — so the two providers implement
// the same contract rather than merely similar ones.
fn futexWaitPrivate(): int { return 128 }
fn futexWakePrivate(): int { return 129 }

// CLOCK_MONOTONIC.
@nosplit fn clockMonotonic(): int { return 1 }

// Errno values the futex path returns, negated (a raw syscall reports failure as
// a small negative errno). Only the two that carry contract meaning are named.
fn eAgain(): int { return 11 }
fn eTimedOut(): int { return 110 }

// Monotonic clock in nanoseconds.
//
// This is `runtime/sched/`'s `monoNs()`: it reads CLOCK_MONOTONIC directly rather
// than through any timer abstraction. A `timespec` is two 64-bit words
// {sec, nsec}, built at `scratch` (at least 2 words, CALLER-owned — see
// ../darwin/wait.bit's `parkSleepNs` header for why this cannot carve its own:
// unlike Darwin's timebase ratio, a clock reading cannot be cached, so every
// call needs a fresh buffer, and this used to be a fresh `[]i64(2)` heap slice
// (#2318) — the ONE call site `schedFindWorkAt`'s clock argument reaches on
// every turn of every worker's find-work loop, so under real lock contention
// it fired millions of times over a program's life.
//
// Returns 0 if the kernel refuses. The return code is not actionable
// (`_ = std.os.linux.clock_gettime(...)`); reporting 0 rather than reading back
// an uninitialised buffer is the one deviation, and it is strictly safer — a
// caller measuring an interval sees a nonsensical 0 rather than stack garbage.
//
// `@nosplit` (#3000): a raw `syscall` (E0075 admits it on proof — an inline
// kernel trap, not a call), `sysClockGettime`/`clockMonotonic` are themselves
// `@nosplit`, and the rest is arithmetic and a pointer deref. No allocation, no
// park. `runtime/net/linux/tcp.bit`'s `netClockNowNs` calls this directly and
// needs it to close poll-free without an exception entry.
export @symbol("bit_rt_port_park_mono_ns") @nosplit fn parkMonoNs(scratch: *i64): int {
  let rc = int(syscall(sysClockGettime(), i64(clockMonotonic()), i64(int(scratch))))
  if (rc != 0) {
    return 0
  }
  return int(*(scratch + 0)) * nsPerSec() + int(*(scratch + 1))
}

// Sleep the calling OS thread for at least `ns` nanoseconds.
//
// THIS IS THE CURRENT PARK PRIMITIVE — `runtime/sched/`'s `sleepNs`, which
// `Worker.run` calls with the backoff delay. Porting the idle loop against this
// reproduces today's behaviour exactly.
//
// A non-positive request returns without a syscall: nanosleep rejects a negative
// tv_nsec with EINVAL, and sleeping for zero is a pure waste of a trap. This
// is never called with one (its argument is always a clamped backoff), so this
// only hardens a boundary a higher-level API would not have to defend.
//
// Short sleeps are NOT restarted on EINTR: the remaining time is discarded
// the result (`_ = std.os.linux.nanosleep(&req, null)`). Restarting would be a
// behaviour change: the idle loop's whole contract is "wait a bounded time, then
// re-check", and an interrupted sleep that re-checks early is correct, merely
// less patient.
//
// WHY THIS DROPS THE THREAD'S TIMER SLACK FIRST, WHICH LOOKS LIKE AN UNRELATED
// SIDE EFFECT AND IS NOT (#1439).
//
// Linux rounds every `nanosleep` UP by the calling thread's timer slack, which
// defaults to 50us. A caller asking for 1us therefore sleeps ~75us — MEASURED
// on aarch64-linux, 10000 iterations: 74615ns mean for a 1000ns request. Darwin
// has no such rounding, which is why the two providers had silently different
// floors while claiming one contract.
//
// That 75x error is not cosmetic, and it is not merely "a slow sleep":
//
//   1. IT FALSIFIES THE BACKOFF POLICY THIS MODULE EXISTS TO SERVE. `sched.bit`
//      doubles its idle backoff from 1us to 1ms, and `parkNextBackoff` is shared
//      so there is one copy of that policy. On Linux the bottom SIX doublings
//      were indistinguishable — every one of them slept ~75us — so the ported
//      policy simply was not the policy on this platform.
//   2. IT IS PAID BY EVERY CONCURRENT COLLECTION, NOT JUST BY THE SLEEPER. A
//      thread inside `nanosleep` holds no `blocked` bracket (ABI.md §5; calling
//      `bit_rt_gc_blocking_begin` here was blocked by E0078 until #1444 narrowed
//      it to archive membership — wiring it up is #1433), so it reads as
//      `running` and stop-the-world waits it out. Once #1431 took `@nosplit`
//      off the worker loop, `_tests_/stress/chanracelinux` began attempting
//      ~300000 collections under `BIT_GC=stress`, and each one waited out this
//      slack: 23.3s of wall time against the program's own 10s deadline, versus
//      3.6s for the identical work and the identical 300000 collections on
//      Darwin. That is the whole of #1439 — nothing was lost or miscollected,
//      the program was 11x too slow to finish and reported partial counts.
//
// Set unconditionally rather than once, because it is per-THREAD state and a
// thread that sleeps may have been cloned before any other thread set it (the
// kernel copies `timer_slack_ns` at clone time, so "set it once on the main
// thread" is order-dependent and wrong). The extra syscall is already counted in
// the 9us measured above, and it is idempotent.
//
// This narrows the residual GC tax; it does not remove it, and the difference
// matters. A caller that sleeps for milliseconds still holds up every concurrent
// collection for its whole sleep. Closing that needs the `blocked` contract or a
// published conservative stack range (ABI.md §5), which is #1433, not this.
// `scratch` addresses (at least) 2 words the CALLER owns, to build the
// `timespec` this hands the kernel — the caller-owned-block pattern every
// other runtime structure here uses, and forced by the same rule the Darwin
// twin's header explains: `ptrOf` requires a slice or module-level state
// (E0053), never a function-local, so this cannot carve its own two words
// without either heap-allocating them (the #2318 defect this replaces) or
// naming module state a second concurrent caller could collide with.
export @symbol("bit_rt_port_park_sleep_ns") fn parkSleepNs(ns: int, scratch: *i64) {
  if (ns <= 0) {
    return
  }
  let _ = int(syscall(sysPrctl(), i64(prSetTimerslack()), i64(timerslackNs())))
  // THIS USED TO BE `let req = []i64(2)` (#2318): a fresh heap slice on every
  // call. See ../darwin/wait.bit's header for the full measurement — worker
  // 0's idle backoff reaches this on every turn that finds no runnable task,
  // which under real lock contention is millions of times over a program's
  // life.
  *(scratch + 0) = i64(ns / nsPerSec())
  *(scratch + 1) = i64(ns % nsPerSec())
  let _ = int(syscall(sysNanosleep(), i64(int(scratch)), 0))
}

// This thread's current timer slack in nanoseconds, or -1 if the kernel refuses.
//
// EXISTS TO BE ASSERTED ON, and deliberately so. The behavioural guard for the
// slack drop above is `_tests_/stress/chanracelinux` under `BIT_GC=stress`, which
// is a whole-system test costing seconds; this is the direct one, and it is a
// pure read with no timing in it. A timing assertion ("a 1us sleep returns in
// under Nus") was the obvious alternative and was rejected: the margin between
// broken (75us) and fixed (9us) is real but the ceiling would have to survive a
// loaded CI box and an emulated container, and a guard that flakes is worse than
// no guard. Reading the state back cannot flake.
//
// PR_GET_TIMERSLACK returns the value directly rather than through a pointer,
// and it can never return 0 — the kernel treats a request of 0 as "restore the
// default" — so a non-negative return is always the live value.
export fn parkTimerSlackNs(): int {
  let rc = int(syscall(sysPrctl(), i64(prGetTimerslack()), 0))
  if (rc < 0) {
    return -1
  }
  return rc
}

// Block while the 32-bit word at `p` still holds `expected`, for at most
// `timeoutNs` (0 means block indefinitely). Returns `parkWaitReady` or
// `parkWaitTimedOut` (../park.bit).
//
// FUTEX_WAIT's compare-then-sleep is atomic with respect to FUTEX_WAKE: the
// kernel re-reads the word under the futex queue lock, so a wake that lands
// after the caller's own check but before the sleep is not lost — it makes the
// compare fail and the call returns immediately. That atomicity is the entire
// reason this is a kernel primitive rather than a check plus a sleep, and it is
// what a hand-rolled "if (word == expected) sleep()" cannot reproduce.
//
// RETURN MAPPING. -EAGAIN means the word already differed (no wait happened) and
// -EINTR means a signal cut the wait short; both, like a real wake, mean only
// "re-read the word", so all three map to `parkWaitReady`. -ETIMEDOUT is the one
// distinguishable outcome. Any other negative errno is a programming error
// (EINVAL from a malformed timespec, EFAULT from a bad address) — reported as
// `parkWaitReady` so the caller re-checks and makes progress rather than
// treating a bug as a timeout and silently waiting again.
//
// The status codes are duplicated as literals here rather than imported from
// ../park.bit so that a provider stays a leaf with no imports, exactly as
// runtime/alloc's and runtime/rand's providers do. _tests_/stress/park pins the
// two spellings against each other so the duplication cannot drift.
//
// `scratch` addresses (at least) 2 words the CALLER owns, to build the
// `timespec` this hands the kernel when `timeoutNs > 0` — the SAME
// caller-owned-block pattern `parkSleepNs` below already uses for the
// identical reason (#2318), applied here one function late (#3914).
//
// THIS USED TO BE `let ts = []i64(2)`: a fresh GC-managed heap slice on every
// timed park. `schedIdlePark` (`runtime/sched/sleep.bit`) is called ONLY
// inside a `gcBlockingBegin`/`gcBlockingEnd` bracket — `worldBeginBlocking`'s
// own precondition (`runtime/gc/gcworldsync.bit`) is that the caller holds NO
// live references for the whole bracketed region, because a blocked thread is
// not scanned at all. `ts` was exactly such a reference: live, freshly linked
// into the collector's object list, and reachable only from this thread's own
// stack while that thread was told the collector would never look at it. A
// concurrent `BIT_GC=stress` collection swept it — cleared its occupied-slot
// bit and unlinked it from the object list — while this call was still
// building the timespec or had already handed its address to the kernel
// (#3914's own repro: `_tests_/stress/spawnjoin`, ~1 in 7000-9600 runs,
// invisible without stress mode because normal collection is too rare to hit
// the window). Moving the words to caller-owned storage removes the reference
// from the heap entirely, the same fix #2318 already gave `parkSleepNs`.
export @symbol("bit_rt_port_park_wait") fn parkWait(
  p: *i32,
  expected: i32,
  timeoutNs: int,
  scratch: *i64,
): int {
  let rc = 0
  if (timeoutNs <= 0) {
    // A null timespec is futex's "wait forever".
    rc = int(syscall(sysFutex(), i64(int(p)), i64(futexWaitPrivate()), i64(expected), 0))
  } else {
    *(scratch + 0) = i64(timeoutNs / nsPerSec())
    *(scratch + 1) = i64(timeoutNs % nsPerSec())
    rc = int(
      syscall(
        sysFutex(), i64(int(p)), i64(futexWaitPrivate()), i64(expected),
        i64(int(scratch)),
      ),
    )
  }
  if (rc == 0 - eTimedOut()) {
    return 1 // parkWaitTimedOut
  }
  return 0 // parkWaitReady
}

// Wake waiters blocked in `parkWait` on the word at `p`. Wakes one waiter when
// `all` is false, every waiter when true. Returns how many were woken (0 is
// normal and not an error — it simply means nobody was waiting).
//
// Waking ONE is the scheduler's normal case: handing a single task to a single
// idle worker. Waking all is for a state change every worker must observe, which
// is what shutdown is — and a shutdown that woke only one worker while the rest
// stayed blocked is precisely the "closing peer strands its waiters" deadlock
// this project has already paid for once (the QUIC teardown hang). Both forms
// exist here so that a caller never has to express "wake everyone" as a loop
// whose bound it would have to invent.
//
// FUTEX_WAKE's count argument is the maximum number to wake; the all-waiters
// spelling is INT32_MAX rather than a loop, which is the kernel's own idiom.
export @symbol("bit_rt_port_park_wake") fn parkWake(p: *i32, all: bool): int {
  let n = 1
  if (all) {
    n = 2147483647
  }
  let rc = int(syscall(sysFutex(), i64(int(p)), i64(futexWakePrivate()), i64(n), 0))
  if (rc < 0) {
    return 0
  }
  return rc
}

// Number of CPUs available to this process — the value `Scheduler.init(0)` uses
// to size the worker pool (`std.Thread.getCpuCount()`).
//
// sched_getaffinity, not the raw CPU count: it reports the cores this process is
// actually PERMITTED to run on, so a container with a restricted cpuset or a
// process under `taskset` sizes its pool to its real allowance instead of
// oversubscribing the box. A CPU-count helper uses the same syscall for the
// same reason.
//
// The kernel fills a bitmask and returns the number of BYTES written; the answer
// is that many bytes' worth of set bits. 128 bytes covers 1024 CPUs, which is
// also the upper bound `Scheduler.init` already asserts.
//
// RETURNS 0 — NOT 1 — WHEN THE QUERY FAILS. See the Darwin twin for why: the
// A `getCpuCount() catch 1` shape makes "1" both a plausible answer and the error
// value, which renders the test of this function vacuous. Reporting 0 for
// "unavailable" keeps failure distinguishable and leaves the `catch 1` default
// to the consumer.
export @symbol("bit_rt_port_park_cpu_count") fn parkCpuCount(): int {
  // THE MASK MUST BE PACKED BYTES. A Bit slice stores one 8-BYTE word per
  // element (§11.8), so a `[]u8(128)` is 1024 bytes read with an 8-byte stride —
  // the bit walk would sample every eighth byte of the kernel's bitmask and
  // count the wrong CPUs. The region is allocated as `[]i64` (whose elements ARE
  // 8 contiguous bytes) and walked through a `*u8` cursor, the same bridge
  // _tests_/stress/rand/props documents. 16 words = 128 bytes = 1024 CPUs, which
  // is also the upper bound `Scheduler.init` asserts.
  let words = 16
  let setBytes = words * 8
  let store = []i64(words)
  let i = 0
  while (i < words) {
    store[i] = 0
    i = i + 1
  }
  let nilb: *u8 = nil
  let mask = nilb + int(ptrOf(store))

  let rc = int(syscall(sysSchedGetaffinity(), 0, i64(setBytes), i64(int(ptrOf(store)))))
  if (rc <= 0) {
    return 0
  }
  // The walk is bounded by the buffer, not by the kernel's answer, so a bogus
  // oversized `rc` cannot run off the end (Power of 10: statically bounded).
  let limit = rc
  if (limit > setBytes) {
    limit = setBytes
  }
  let count = 0
  let b = 0
  while (b < limit) {
    let p = mask + b
    let bits = int(*p)
    let bit = 0
    while (bit < 8) {
      if (bits / (1 << bit) % 2 == 1) {
        count = count + 1
      }
      bit = bit + 1
    }
    b = b + 1
  }
  return count
}
