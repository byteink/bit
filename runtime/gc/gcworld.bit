// SEAM 2 (#1575): the stop-the-world World/Mutator registry — the port of
// `runtime/gc/:176-479` that the #1363 collector port deliberately left out
// (`gc.bit` mentions `World` nowhere but in comments). This is the multi-thread
// rendezvous, ABI.md §5: the machinery a collector uses to bring every other
// mutator to a safe stop, and the machinery a mutator uses to yield to — or step
// out of the way of — that stop.
//
// `gcworld` sorts AFTER `gcmark` and BEFORE `mem` in bytewise filename order, so
// module concatenation (#1511) places it past every helper it inlines from the
// earlier `gc*` files and before `mem.bit`'s low-level word accessors; those it
// reaches by import-of-self (same module) with no inlining dependency in either
// direction, because the atomics lower inline and `wordAt`/`spinCellAt` are
// leaf address-fabrication.
//
// ---------------------------------------------------------------------------
// THE CONSTRAINTS THAT SHAPE THIS FILE (the complete list)
// ---------------------------------------------------------------------------
//
// 1. STATE IS CALLER-OWNED — identical to `gc.bit`'s constraint 1. A `World`
//    is a `class` with an embedded `[max_mutators]Mutator` array; Bit has no
//    way to hand back a class that lives outside the managed heap, so the
//    registry is a block of `worldWords` machine words the caller provides and
//    every entry point takes as its first parameter. Field-for-field the block
//    IS the registry: slot `i`'s three atomics sit at words `i*muWords + {0,1,
//    2}`, then `stop`, `epoch` and the serialization `lock` follow. The
//    process-wide instance belongs to `runtime/root` (`g_world` in `runtime/root/`),
//    exactly as the collector state does; see the `worldBind`/wrapper note below.
//
// 2. ALL ATOMICS ARE SEQUENTIALLY CONSISTENT. Hand-picked orderings would be
//    (`.acq_rel` on `claim`, `.release` on `release`/`beginBlocking`, `.seq_cst`
//    only on the Dekker pair in `resumeWhenClear`/`rendezvous`). Bit's atomics
//    (§11.5) expose ONLY seq_cst. seq_cst is strictly stronger than every
//    ordering it replaces, so no new interleaving is admitted — the
//    load-bearing seq_cst fences the algorithm's correctness depends on are
//    present, and the rest are merely stronger than they need to be. The cost is
//    a few extra fences on the park/stop paths, which already spin; it changes
//    behaviour not at all.
//
// 3. A MUTATOR IS A SLOT INDEX, NOT A POINTER. A pointer would be natural; the
//    caller-owned block makes the natural handle the slot ordinal (0..maxMutators
//    -1), from which `wMut` recovers the three word pointers. `worldClaim`
//    returns -1 for "registry full", there being no optional to return.
//
// 4. THE SPIN-LOOP HINT IS OMITTED. A hint belongs in
//    every wait body; it is an `asm` block, and `@nosplit` rejects `asm` (E0075,
//    §10.3) — the same omission `spinlock.bit` documents. The hint is a
//    power/scheduling advisory with no memory-ordering or outcome content, so
//    dropping it preserves correctness exactly.
//
// 5. A NEVER-CLEARING STOP IS COUNTED, NOT PANICKED. The
//    `resumeWhenClear` spins `stw_park_bound` times and `@panic`s if the stop
//    never clears (a runtime bug, not a slow collection). `@nosplit` cannot call
//    `panic`, so — exactly as `gc.bit`'s deviation 5 turns an assert into
//    `gcStatBadOffset` — the bound expiry is counted in `worldStatResumeGiveUp`
//    and the thread is released. On every sound run the counter is zero, which a
//    test asserts; the signal survives into a release
//    build instead of compiling out.
//
// 6. THE PER-ARCH SPIN BOUND IS A SINGLE VALUE. Sizing `stw_spin_bound`
//    differently on x86-64 (200_000) and elsewhere (1_000_000) because the hint
//    costs ~70x more on x86-64 (see runtime/gc/'s essay). With the hint omitted
//    (constraint 4) that asymmetry is gone, and the bound is throughput-only:
//    ABI.md §5 makes an EXPIRED rendezvous abandon the collection, which is
//    always safe (the heap grows to the next trigger), so no correctness rides on
//    the figure. One conservative value is used; a per-target split is a pure
//    throughput refinement and is deferred until this registry is actually linked
//    (#1400) and can be measured.
//
// 7. `forEachParkedFrame` IS NOT PORTED HERE. It takes a function pointer and
//    feeds published frames to the root scan, which is `runtime/root`'s precise
//    walk (§4) — SEAM 3 territory, and inexpressible in the unmanaged subset
//    (a Bit function value is a GC object) exactly as `gc.bit`'s deviation 2
//    inverted `RootScanner` into a phase API. The registry it iterates lives
//    here; the iteration belongs with the scanner that consumes it.
//
// Every function is `@nosplit` (§10.3): a registry operation must not itself
// reach a safepoint or allocate, or a thread answering the collector's stop
// would re-enter the very handshake it is trying to complete.

// `spinAcquire`/`spinRelease` are already imported by the sibling `gc.bit` into
// this shared module scope; only `spinCellAt` is new here.
import { spinCellAt, spinTryAcquire } from "../"

// ---------------------------------------------------------------------------
// Layout — the caller-owned `World` block, field for field with runtime/gc/'s class
// ---------------------------------------------------------------------------

// One mutator occupies four consecutive words. The natural class is
// `{state: u32, frame: usize, acked: u64}`; all three are represented as i64
// words here (the state's 0..3 enum and the epoch/frame values all fit, and a
// uniform width lets one `*i64` atomic address every field). The registry is
// runtime-internal — it appears nowhere in ABI.md — so the widths are free to
// differ, the same licence `spinlock.bit` took to widen a 1-byte lock to i32.
//
// THE FOURTH WORD IS #1650, and has no counterpart in a pointer-based design,
// which finds a thread's
// `*Mutator` through `threadlocal var g_mutator`, so its slots need not say who
// owns them; this port has no threadlocal (§11.11 refuses one for Mach-O) and
// must therefore find a thread's slot BY SEARCH, keyed on `../gc/gcthread.bit`'s
// per-OS-thread token. Storing the key in the slot is what makes that search
// exact, and an exact search is the whole fix: the previous stand-in was one
// process-wide `curMut`, which handed the second Bit thread the first thread's
// slot and left it invisible to both the rendezvous and the root scan.
const muState = 0     // MutatorState (atomic)
const muFrame = 1     // published safepoint-snapshot address while parked, else 0
// `muFrame`'s value is also a valid stack pointer for that thread, not merely a
// pointer to the frame's fields — root class 10 reads it as such (ABI.md §4).
const muAcked = 2     // the stop epoch this slot last parked FOR
const muOwner = 3     // `gcThreadToken()` of the owning OS thread, 0 when free
// The `syscall` state's stack-pointer publication (#1904), meaningless in any
// other state and zero outside one. A thread parked in a syscall cannot reach a
// safepoint, so it has no stack map and cannot publish a precise `muFrame` — it
// publishes what a CONSERVATIVE scan needs instead: where its live stack starts.
//
// ONE WORD, AND THE SECOND HALF LIVES ELSEWHERE (#1904). The saved callee-saved
// register file this state also needs is `muRegWords` words per slot;
// `../root/root.bit` owns it as a separate block rather than folding it in here.
//
// THAT SPLIT IS NO LONGER FORCED, and the note that said it was is withdrawn
// (#1991). It read: folding them in makes the block `maxMutators * 17 + 5` =
// 4357 words, "which SIGSEGVs every binary under the collector, while an equally
// large SEPARATE module array does not". Both halves of that were wrong. The
// SIGSEGV was `tests/stress/gcworld` binding its own GC-HEAP slice as the
// process-wide registry and never unbinding it, so the runtime read the block
// after it had been swept; `worldWords` sized that slice as well as the module
// array, which is what made a test bug look like a size limit on this constant.
// Measured on a clean tree: `muWords = 17` with `worldBlock: [4357]i64` builds
// and runs green once the test holds its registry in module state.
//
// So a per-mutator field is a plain cost decision — 256x the words — and not a
// crash. The split stays because 12 words per slot for a state only a syscall-
// parked thread uses is a poor trade, not because the alternative is unsafe.
const muSp = 4        // stack pointer at entry to the syscall region, else 0
const muStackTop = 5  // highest address of the owning OS-thread's own stack, 0 when unknown (#2646)
// Written once by the owning thread, before the slot is used by anything
// else (`worldClaimFor`), so `worldStackTop`/`worldSetStackTop` below are a
// plain load and a plain store — no atomic, because there is never a
// concurrent writer to synchronize against.
//
// EXPORTED because a test that pokes the registry directly must not carry its
// own copy: `tests/stress/stwcollect` hardcoded `MU_WORDS = 4`, and when #1904
// made it 5 the test kept writing a slot's state at the old stride, so the slot
// never looked parked and three of its phases reported an abandoned collection.
// That reads exactly like a collector regression and is not one.
export const muWords = 6

// Words of callee-saved register file saved per syscall-parked thread: arm64
// x19..x28 + fp + lr. x64 has six (rbx, rbp, r12..r15) and leaves the rest zero,
// which a conservative scan rejects harmlessly.
export const muRegWords = 12

// Hard cap on concurrently registered mutator OS threads, from runtime/gc/'s
// `max_mutators`. Fixed at startup (Power-of-10 rule 2): no allocation on the
// safepoint path and every walk over the registry is statically bounded.
export const maxMutators = 256

// The trailing words, past the slot array. `worldStopWord` is exported
// (#1700): stwPoll inlines worldStopRequested's one-load body on its hot path
// to avoid a cross-module call, and needs the offset to do it.
export const worldStopWord = maxMutators * muWords   // 1536: atomic bool, 0/1
const worldEpochWord = maxMutators * muWords + 1     // 1537: atomic stop counter
const worldLockWord = maxMutators * muWords + 2      // 1538: i32 serialization lock
// Deviation 5's counter: times `worldResumeWhenClear` gave up on a stop that
// never cleared. A panicking design needs no such field; it is a leaf stat here.
const worldStatResumeGiveUp = maxMutators * muWords + 3   // 1539

// One past the highest slot index ever claimed — a monotonic high-water mark,
// and a PURE THROUGHPUT device with no correctness content.
//
// `worldFindOwner` runs at every safepoint poll, i.e. at every loop back edge in
// every compiled function, and a full `maxMutators` sweep there would put 256
// atomic loads on the hottest path in the runtime. Bounding the search by the
// high-water mark makes it 2-4 loads in a real process, because slots are
// claimed lowest-free-first and a process has as many mutators as it has OS
// threads.
//
// It may only ever be too LARGE, never too small: too large costs a few wasted
// loads over free slots, too small would hide a live thread's own slot from it
// and hand that thread a second one — the two-slots-one-thread wedge. That is
// why the bump below is a bounded compare-and-exchange loop rather than the
// load-max-store it reads as: two threads claiming slots 0 and 1 concurrently
// can otherwise interleave so that the 2 is written first and then clobbered by
// the 1, which loses slot 1 permanently.
//
// Nothing else reads it. `worldRendezvous` and the parked-frame walk sweep the
// FULL registry deliberately (see `worldRendezvous`'s re-scan note), so a stale
// or lagging high-water mark can never shrink a collection's root set.
const worldHighWater = maxMutators * muWords + 4          // 1540

// Words the caller must provide for the World block.
export const worldWords = maxMutators * muWords + 5        // 1541

// MutatorState (runtime/gc/'s enum). `free == 0` is the zero value, so a World block
// carved from zeroed memory starts every slot free with no init step — matching
// the `free` state as the initial value, and `stop`/`epoch` likewise
// start 0.
export const mFree = 0        // slot unused
export const mRunning = 1     // executing Bit code; the collector waits for this
export const mParked = 2      // stopped at a safepoint, snapshot published
export const mBlocked = 3     // in a region holding NO live Bit references (§5)
// #1904. The state the registry was missing, and the whole of that ticket: a
// thread parked in a syscall runs no Bit code, so the collector must not WAIT
// for it, yet it still holds live references, so the collector must still SCAN
// it. `running` gives the second without the first and hangs the rendezvous;
// `blocked` gives the first without the second and sweeps live objects. Neither
// is a lie a subprocess wait can afford, which is why every collection during
// one was abandoned (measured 21 abandoned per completed, `BIT_GC_STATS=1`).
//
// Counts as stopped like `blocked` does, and is scanned conservatively from
// `muSp`/`muRegs` rather than precisely from `muFrame`, because @nosplit code
// publishes no stack map. Resumes through `worldResumeWhenClear` like `blocked`,
// for the same reason: rendezvous passed it without an acknowledgement.
export const mSyscall = 4     // parked in a syscall; holds live refs, scan it (#1904)

// Iterations the collector spins waiting for the world to stop. Deviation 6:
// throughput-only, one value across targets. Expiry abandons the collection,
// which ABI.md §5 makes always-safe.
const stwSpinBound = 1000000

// Iterations a waiting mutator spins before declaring the stop hung. The
// `stw_park_bound = 1 << 32`. NOT a timeout — a collector ALWAYS clears its stop
// (on success or on abandonment), so reaching this means a runtime bug, and the
// bound exists only to turn a hang into a diagnosable one (constraint 5 counts
// it). Sized so a legitimately long mark/sweep cannot reach it.
const stwParkBound = 4294967296

// Bound on `worldResumeWhenClear`'s OUTER retry, which would otherwise be unbounded.
// The outer body re-runs only when a fresh stop that may already have counted
// this slot lands in the gap between publishing `running` and re-checking — a
// real but rare race, one extra pass per intervening collection. Power-of-10
// forbids an unbounded loop, so it carries a static cap; exhausting it is the
// same "runtime broken" signal as the inner bound and is counted, not panicked.
const worldResumeOuterBound = 1073741824

// ---------------------------------------------------------------------------
// Slot addressing
// ---------------------------------------------------------------------------

// The three-word `Mutator` record for slot `slot`, as a `*i64` at its `state`
// word; `frame` and `acked` are `+muFrame`/`+muAcked` from it. `world` is the
// caller's block base; slot `slot` begins `slot*muWords` words in.
@nosplit fn wMut(world: *i64, slot: int): *i64 {
  return world + slot * muWords
}

// ---------------------------------------------------------------------------
// Registration — `World.claim` / `World.release`
// ---------------------------------------------------------------------------

// Raise the high-water mark to at least `n`. Bounded compare-and-exchange loop;
// see `worldHighWater` for why a plain load-max-store is not sufficient.
@nosplit fn worldRaiseHighWater(world: *i64, n: int) {
  let p = world + worldHighWater
  let i = 0
  // Bounded: each failed exchange means another thread raised it, and it is
  // monotonic and capped at `maxMutators`, so this cannot spin indefinitely.
  while (i < maxMutators) {
    let cur = atomicLoad(p)
    if (cur >= n) {
      return
    }
    if (atomicCmpxchg(p, cur, n)) {
      return
    }
    i = i + 1
  }
}

// Claim a slot for the OS thread identified by `token`, or -1 if all
// `maxMutators` are taken. Starts the slot `running`: a thread is assumed to be
// executing Bit code from the moment it registers, the conservative direction (a
// spurious `running` costs an abandoned collection; a spurious `stopped`
// corrupts the heap).
//
// THE OWNER IS PUBLISHED AFTER THE STATE, AND THAT ORDER IS LOAD-BEARING. The
// compare-and-exchange is what takes the slot; until it succeeds no other thread
// may write the slot's owner. Between the exchange and the owner store the slot
// reads `{running, owner 0}`, and `worldFindOwner` matches on the OWNER alone —
// so another thread searching for its own (never-zero) token cannot match this
// half-built slot. The mirror-image rule is in `worldRelease`.
export @nosplit @symbol("bit_rt_port_gc_world_claim_for") fn worldClaimFor(world: *i64, token: int): int {
  let i = 0
  // Bounded: exactly `maxMutators` probes.
  while (i < maxMutators) {
    let m = wMut(world, i)
    if (atomicCmpxchg(m, mFree, mRunning)) {
      atomicStore(m + muOwner, token)
      worldRaiseHighWater(world, i + 1)
      return i
    }
    i = i + 1
  }
  return -1
}

// `worldClaimFor` with no owner — an ANONYMOUS slot, findable by nobody.
//
// Kept because it is the pinned shape `tests/stress/gcworld` drives the state
// machine through, which registers no real threads and asks only that claim,
// park, rendezvous and release compose. Registration by the collector's own
// doors goes through `worldClaimFor`; a 0 owner can never match a lookup,
// because `gcThreadToken()` returning 0 means "no token" and is refused before
// any search is made.
export @nosplit @symbol("bit_rt_port_gc_world_claim") fn worldClaim(world: *i64): int {
  return worldClaimFor(world, 0)
}

// The slot owned by `token`, or -1 if that thread holds none.
//
// Matches on the owner word ALONE, never on the state: a slot can be `running`,
// `parked` or `blocked` and still be this thread's, and reading two words would
// need them to be consistent with each other, which claim and release
// deliberately arrange NOT to require (see their ordering notes).
//
// Bounded by the high-water mark, which is why that word exists — this runs at
// every safepoint poll.
//
// Exported so `tests/stress/gcworld` can drive the LOOKUP and not just its
// effects. That matters more here than for any other accessor in this file: the
// defect this replaces (#1650) was a lookup that returned another thread's slot,
// and its only symptom was a swept live object faulting somewhere else entirely
// — no assertion anywhere in the suite could see it. A test that asks "which
// slot does token B resolve to" can.
export @nosplit @symbol("bit_rt_port_gc_world_owner_slot") fn worldFindOwner(world: *i64, token: int): int {
  let hw = atomicLoad(world + worldHighWater)
  let i = 0
  // Bounded twice over: by the high-water mark, and by `maxMutators` regardless.
  while (i < hw && i < maxMutators) {
    if (atomicLoad(wMut(world, i) + muOwner) == token) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Release a slot. The thread must not touch Bit objects afterwards.
//
// THE OWNER IS CLEARED FIRST, and that order is the mirror of `worldClaimFor`'s.
// Freeing the state first would leave a window in which another thread could
// claim this slot and start using it while it still carries the DEPARTED
// thread's token — and a third thread searching for that token would then be
// handed a slot it does not own. Clearing the owner first makes the slot
// unfindable before it becomes claimable. The published frame goes next, so no
// stale snapshot can be scanned, and the state last.
export @nosplit @symbol("bit_rt_port_gc_world_release") fn worldRelease(world: *i64, slot: int) {
  let m = wMut(world, slot)
  atomicStore(m + muOwner, 0)
  atomicStore(m + muFrame, 0)
  atomicStore(m, mFree)
}

// The highest address of slot `slot`'s owning OS-thread's own stack, or 0 if
// never published (#2646). Plain load, not atomic: `muStackTop` is written
// only by the owning thread, and only before the slot is used by anything
// else, so there is no concurrent writer for this word to synchronize
// against.
export @nosplit @symbol("bit_rt_port_gc_world_stack_top") fn worldStackTop(world: *i64, slot: int): int {
  let p = wMut(world, slot) + muStackTop
  return *p
}

// Publish `top` as slot `slot`'s owning-thread stack top. Plain store, for
// the same reason `worldStackTop` is a plain load.
export @nosplit @symbol("bit_rt_port_gc_world_set_stack_top") fn worldSetStackTop(world: *i64, slot: int, top: int) {
  let p = wMut(world, slot) + muStackTop
  *p = top
}

