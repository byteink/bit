// The PRECISE stack-map root walk — `runtime/root/`'s `scanFrame`/`scanSnapshot`
// (runtime/root/:303-377), ported (#1633).
//
// ---------------------------------------------------------------------------
// WHAT THIS IS FOR
// ---------------------------------------------------------------------------
//
// Codegen records, for every safepoint call site, exactly which stack slots and
// which callee-saved registers hold a live GC reference at that site (ABI.md
// §4). The table is emitted into the image between the two LINKER-DEFINED data
// symbols `bit_stack_maps` and `bit_stack_maps_end`, which `stackMapsBegin()`/
// `stackMapsEnd()` (SPEC §11.12, #1632) name — that language gap is why this
// walk could not be written in Bit until now.
//
// Given one thread's `SafepointFrame` snapshot (§4: `ret` at +0, `fp` at +8,
// `regs[32]` at +16+8n) this marks every reference every Bit frame on that
// thread names, walking outward along the frame-pointer chain. It is called once
// for the collecting thread's own snapshot and once per PARKED mutator's
// published snapshot — the walk is identical, only the starting frame differs.
//
// ---------------------------------------------------------------------------
// WHY THE REGISTER FILE IS MODULE STATE AND NOT A LOCAL
// ---------------------------------------------------------------------------
//
// A copy of the snapshot's registers would be REWRITTEN in that
// copy as it unwinds: each frame restores the caller's callee-saved values from
// the slots it spilled them into, so the next frame out reads the right ones.
// A `@nosplit` body cannot hold a 32-word array local (no composites, §10.3), so
// the working copy is module state.
//
// It must be a COPY and not the snapshot itself. Rewriting a parked mutator's
// published frame in place would leave that frame holding the OUTERMOST frame's
// register values; a later collection that scanned the same still-parked
// snapshot (`worldMustStayPut` can hold a slot parked across epochs) would then
// walk with corrupted registers and MISS a live reference — the one failure
// direction that loses objects rather than retaining them.
//
// One shared copy is sound because the world lock serializes collectors: exactly
// one thread is inside a collection at a time, and this walk runs only from
// inside one.
//
// This file sorts AFTER `gcmark.bit` and `mem.bit` (#1511), so `gcMarkRoot`,
// `loadWord` and `loadByte` are already lowered when the module concatenates and
// keep being inlined here.

// Statically bounded frame-walk depth (Power of 10): a runaway backstop far
// above any real Bit call depth on a 64KB task stack. `runtime/root/`'s
// `max_walk_frames`.
const smMaxFrames = 65536

// Statically bounded entry count for one merged stack-map scan (Power of 10),
// far above any real program's function count. `runtime/root/`'s
// `max_stackmap_entries`. Entries are self-delimiting and carry no count, so the
// walk is bounded by the extent; this makes the bound static as well, so a
// corrupt length costs at most a bounded scan.
const smMaxEntries = 4194304

// `SafepointFrame` (ABI.md §4), in BYTES from the frame address.
const sfRet = 0
const sfFp = 8
const sfRegs = 16

// Physical registers a stack map may name (§4). The snapshot carries exactly
// this many and the working copy below is exactly this wide.
const smNumRegs = 32

// The working register file described in the header. Written only under the
// world lock, from inside a collection.
let scanRegs: [32]i64

// ---------------------------------------------------------------------------
// Unaligned little-endian blob readers — `runtime/root/`'s `blobU16`/`U32`/`U64`/`I32`
// ---------------------------------------------------------------------------
//
// Byte-wise on purpose: within one entry, its fields are 8+4+2+6n+... bytes
// from the entry's start, so no field past the first is guaranteed any
// alignment, and a widened load would fault on a target that traps unaligned
// access. `std.mem.readInt(..., .little)` is the table layout, and both object
// writers emit it little-endian on every supported target. Only ENTRY
// BOUNDARIES are 8-aligned (#1927, ABI.md §4) — the fields inside one entry
// are not, which is why this stays byte-wise rather than switching to a
// widened load now that entries are padded.

@nosplit fn blobU16(base: int, off: int): int {
  return loadByte(base + off) | (loadByte(base + off + 1) << 8)
}

@nosplit fn blobU32(base: int, off: int): int {
  return blobU16(base, off) | (blobU16(base, off + 2) << 16)
}

@nosplit fn blobU64(base: int, off: int): int {
  return blobU32(base, off) | (blobU32(base, off + 4) << 32)
}

// A stack slot offset is SIGNED and relative to `fp` — negative for locals below
// the frame record. `int` is 64-bit, so the u32 must be sign-extended by hand.
@nosplit fn blobI32(base: int, off: int): int {
  let v = blobU32(base, off)
  if (v >= 2147483648) {
    return v - 4294967296
  }
  return v
}

// ---------------------------------------------------------------------------
// Bounds checking (#1839)
// ---------------------------------------------------------------------------
//
// `scanFrame` used to check `off < tblLen` once per entry and then advance
// `off` and read up to eleven more times using counts (`numSaved`, `numSps`,
// `numSlots`, `numRegs`) read OUT OF the table it is walking. A truncated,
// corrupt, or writer/reader-mismatched blob desynchronises one of those counts
// and every read after it is unbounded — it reads whatever follows the table
// in the process image. Every read below is checked against `inBlob` first,
// not just the entry's first.

// Whether `need` bytes starting at `off` are still inside `[0, tblLen)`. The
// caller must check this before EVERY read, not only the first per entry —
// `off` may already be corrupt by the time it gets here, having been advanced
// by a count this same walk just read out of the table.
//
// A single comparison, deliberately not `off >= 0 && need >= 0 && ...`: every
// call site below passes an `off` this same function has already proven `>= 0`
// (0 at the first call, and only ever advanced by a `need` this check just
// approved) and a `need` that is either a fixed non-negative literal or a u16
// blob read (`blobU16` returns `loadByte | loadByte << 8`, always `[0,
// 65535]`) times a small constant — never negative. `&&` compiles to a
// multi-block short-circuit, which disqualifies a callee from
// `compiler/optinline.bit`'s single-block inliner (confirmed: zero `bl
// _inBlob` relocations into `scanFrame` with this single-comparison form,
// against nonzero with the `&&` form).
//
// Even fully inlined, this is NOT free on `scanFrame`'s hot path: `#1839`'s
// own measurement is `tests/bit/stress/quicwire` under `BIT_GC=stress` going
// from ~182s (baseline, no bounds check) to ~420-450s wall / ~670s user CPU
// with every read checked — a real ~2.4x, not contention noise (reproduced
// across multiple runs, `user` CPU time from `time` rather than wall clock).
// `BIT_GC=stress` collects at EVERY safepoint, so it multiplies this
// function's per-entry cost by an amount no non-stress program pays; see
// #1839's ticket comments for the full measurement and the open question of
// whether `test-stress-batch`'s deadline should change for this mode.
@nosplit fn inBlob(off: int, need: int, tblLen: int): bool {
  return off + need <= tblLen
}

// The fixed message a failed `inBlob` check panics with: "gc: stack-map entry
// runs past table extent" (42 bytes), packed little-endian exactly as
// `runtime/root/slices.bit`'s `panicBounds` packs its three messages.
const smBoundsMsgWord0: int = 7161132920306557799
const smBoundsMsgWord1: int = 7954799983862820203
const smBoundsMsgWord2: int = 8317714694831436404
const smBoundsMsgWord3: int = 7022273403501506592
const smBoundsMsgWord4: int = 7310600470859705442
const smBoundsMsgWord5: int = 29806
const smBoundsMsgLen: int = 42

// `bit_rt_panic` (ABI.md §12), defined per-platform in `<os>/io.bit` and
// reached here by symbol, the same door `runtime/root/slices.bit`,
// `runtime/root/maps.bit`, `runtime/sched/worker.bit` and
// `runtime/chan/chanwrap.bit` each already open with their own copy of this
// same declaration. Legal inside `@nosplit` (SPEC §11.7, #1640): it takes an
// already-built string header and never allocates.
extern fn bit_rt_panic(msg: int)

// The `{ptr, len}` string header (ABI.md §2) plus 6 inline text words: 48
// bytes of text budget for the 42-byte message above, laid out exactly as
// `slices.bit`'s `boundsMsg`. The header fields (`ptr` at +0, `len` at +8,
// text at +16) are inlined as literals rather than imported from
// `runtime/root/root.bit`'s `strPtr`/`strLen`/`strHeaderSize`: `runtime/root`
// imports FROM `runtime/gc`, not the reverse, so importing here would invert
// the module graph. MODULE STATE, not a local: `ptrOf` needs an addressable
// object and `@nosplit` forbids allocating one per call (E0075).
let smBoundsMsg: [8]i64

// A failed bounds check: refuse the read rather than perform it. Per the
// ticket's constraint, this must not silently skip the frame — a skip leaves
// it unscanned, which is a missed GC root, strictly worse than the
// out-of-bounds read this prevents. NEVER RETURNS.
@nosplit fn panicStackMapBounds() {
  let base = int(ptrOf(smBoundsMsg))
  let text = base + 16
  storeWord(base + 0, text)
  storeWord(base + 8, smBoundsMsgLen)
  storeWord(text + 0, smBoundsMsgWord0)
  storeWord(text + 8, smBoundsMsgWord1)
  storeWord(text + 16, smBoundsMsgWord2)
  storeWord(text + 24, smBoundsMsgWord3)
  storeWord(text + 32, smBoundsMsgWord4)
  storeWord(text + 40, smBoundsMsgWord5)
  bit_rt_panic(base)
}

// ---------------------------------------------------------------------------
// One frame — `runtime/root/`'s `scanFrame`
// ---------------------------------------------------------------------------
//
// Finds the entry whose code range contains `pc` and, if found, (a) marks every
// live reference the safepoint at `pc` names — stack slots via `fp`, registers
// via the working file — and (b) rewrites the working file to the CALLER's
// callee-saved values this frame spilled, so the next frame out reads them
// correctly. Returns false when `pc` is in no Bit function, which is the top of
// the Bit portion of the stack and stops the walk.
@nosplit fn scanFrame(g: *i64, base: int, tblLen: int, pc: int, fp: int): bool {
  let regs = ptrOf(scanRegs)
  let off = 0
  let fi = 0
  // Bounded by the extent AND by `smMaxEntries`.
  while (off < tblLen && fi < smMaxEntries) {
    // One check for the whole fixed-size entry header (codeAddr 8 + codeSize
    // 4 + numSaved 2 = 14 bytes): none of these three offsets depends on a
    // count read out of the table, so they cannot desync from each other —
    // only from `tblLen` itself, which this single check already covers for
    // all three reads below.
    if (!inBlob(off, 14, tblLen)) {
      panicStackMapBounds()
      return false
    }
    let codeAddr = blobU64(base, off)
    off = off + 8
    let codeSize = blobU32(base, off)
    off = off + 4
    let numSaved = blobU16(base, off)
    off = off + 2
    let savedOff = off
    // Checks the WHOLE saved-register table span at once (`numSaved * 6`
    // bytes), before advancing past it: every per-element read of it below,
    // at `savedOff + k * 6` for `k < numSaved`, then lands inside the span
    // this already proved is in-bounds, with no per-element check needed.
    if (!inBlob(savedOff, numSaved * 6, tblLen)) {
      panicStackMapBounds()
      return false
    }
    off = off + numSaved * 6      // u16 reg + i32 fp_off
    if (!inBlob(off, 2, tblLen)) {
      panicStackMapBounds()
      return false
    }
    let numSps = blobU16(base, off)
    off = off + 2

    let hit = pc >= codeAddr && pc < codeAddr + codeSize

    let si = 0
    // Bounded: this entry's safepoint count. The body must run even when this
    // is not the hit entry — it is what advances `off` past the entry.
    while (si < numSps) {
      // Same reasoning as the entry header above: retOff (4) + numSlots (2)
      // = 6 fixed bytes, one check covers both reads.
      if (!inBlob(off, 6, tblLen)) {
        panicStackMapBounds()
        return false
      }
      let retOff = blobU32(base, off)
      off = off + 4
      let numSlots = blobU16(base, off)
      off = off + 2
      let slotsOff = off
      // Same whole-span check as the saved-register table above: covers
      // every `blobI32(base, slotsOff + k * 4)` read under `hit` below.
      if (!inBlob(slotsOff, numSlots * 4, tblLen)) {
        panicStackMapBounds()
        return false
      }
      off = off + numSlots * 4
      if (!inBlob(off, 2, tblLen)) {
        panicStackMapBounds()
        return false
      }
      let numRegs = blobU16(base, off)
      off = off + 2
      let regsOff = off
      // Same whole-span check, for every `blobU16(base, regsOff + k * 2)`
      // read under `hit` below.
      if (!inBlob(regsOff, numRegs * 2, tblLen)) {
        panicStackMapBounds()
        return false
      }
      off = off + numRegs * 2
      if (hit && codeAddr + retOff == pc) {
        let k = 0
        // Bounded: this safepoint's slot count.
        while (k < numSlots) {
          gcMarkRoot(g, loadWord(fp + blobI32(base, slotsOff + k * 4)))
          k = k + 1
        }
        k = 0
        // Bounded: this safepoint's register count.
        while (k < numRegs) {
          let rn = blobU16(base, regsOff + k * 2)
          // §4 restricts a stack map to the callee-saved file, all below
          // `smNumRegs`, so this cannot fire for a table this toolchain emitted.
          // It is here because the alternative to skipping an impossible entry
          // is READING PAST a 32-word module-state array — an in-bounds `regs[n]` is a
          // bounds-checked array access and this is the same check, not a
          // weakened one.
          if (rn < smNumRegs) {
            gcMarkRoot(g, *(regs + rn))
          }
          k = k + 1
        }
      }
      si = si + 1
    }

    // Round the cursor up past this entry's trailing pad (#1927, ABI.md §4):
    // the writer pads every entry to a multiple of 8 bytes so every atom is
    // 8-aligned, and the walk must round up by the same rule or it lands
    // inside this entry's padding instead of at the next entry's start.
    let rem = off % 8
    if (rem != 0) {
      off = off + 8 - rem
    }

    if (hit) {
      let k = 0
      // Bounded: this entry's saved-register count. Reads land inside the
      // `savedOff` span the entry header already checked above; no
      // per-element check needed here.
      while (k < numSaved) {
        let rn = blobU16(base, savedOff + k * 6)
        let foff = blobI32(base, savedOff + k * 6 + 2)
        if (rn < smNumRegs) {
          *(regs + rn) = loadWord(fp + foff)
        }
        k = k + 1
      }
      return true
    }
    fi = fi + 1
  }
  return false
}

// ---------------------------------------------------------------------------
// One thread — `runtime/root/`'s `scanSnapshot`
// ---------------------------------------------------------------------------
//
// PINNED (ABI.md §9): `runtime/stw`'s collector is a separately-emitted object
// and reaches this by its emitted symbol (SPEC §11.9). `bit_rt_port_` is the
// placeholder prefix #1369 strips.
//
// A `ret` of 0 means the snapshot was never captured (the allocation and
// thread_enter doors publish 0 — they hold no stack map), and an empty extent
// means no stack-map table is linked into this image at all. Both are "nothing
// precise to walk", not an error.
export @nosplit @symbol("bit_rt_port_gc_scan_snapshot") fn gcScanSnapshot(g: *i64, snapAddr: int) {
  if (snapAddr == 0) {
    return
  }
  let ret = loadWord(snapAddr + sfRet)
  if (ret == 0) {
    return
  }
  let base = int(stackMapsBegin())
  let tblLen = int(stackMapsEnd()) - base
  if (tblLen <= 0) {
    return
  }

  let regs = ptrOf(scanRegs)
  let i = 0
  // Bounded: exactly `smNumRegs` words.
  while (i < smNumRegs) {
    *(regs + i) = loadWord(snapAddr + sfRegs + i * 8)
    i = i + 1
  }

  let pc = ret
  let fp = loadWord(snapAddr + sfFp)
  let frame = 0
  // Bounded by `smMaxFrames`; the real exits are "pc left the Bit call graph"
  // and the frame-pointer sanity test below.
  while (frame < smMaxFrames) {
    if (!scanFrame(g, base, tblLen, pc, fp)) {
      break
    }
    let nextRet = loadWord(fp + 8)
    let nextFp = loadWord(fp)
    // Frame pointers grow toward higher addresses; anything else is the
    // boundary of the Bit portion of this stack, not another frame.
    if (nextFp <= fp) {
      break
    }
    pc = nextRet
    fp = nextFp
    frame = frame + 1
  }
}
