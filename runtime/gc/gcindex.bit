// runtime/gc/gcindex.bit — split out of ./gc.bit (#1503), then split further
// (#5647): gcindexmutate.bit carries idxPlace/idxDisable/idxGrow/
// idxReclaimRetired/idxInsert/idxRemove/idxInsertSpan/idxRemoveSpan plus the
// bitmap-replacement design record; gcindexrebuild.bit carries the
// post-collection rebuild pass. Sibling of gc.bit: same module, so this
// needs no imports and no call-site changes. What is left: hashing/slot
// addressing (idxHash, idxSlotAddr, idxTableBytes, idxSpanCacheSlotAddr) and
// membership lookup (idxSpanPresent, idxContains) — the address->object
// membership index's read path.

// splitmix64's finalizer. Computed in `u64` because it relies on modular
// multiplication; `i64` overflow only wraps in v0.1 -- a debug build traps
// instead (§11.1, #3076).
@nosplit fn idxHash(addr: int, ncap: int): int {
  let x = u64(addr)
  x = x ^ (x >> 30)
  x = x * 13787848793156543929
  x = x ^ (x >> 27)
  x = x * 10723151780598845931
  x = x ^ (x >> 31)
  let mask = u64(ncap - 1)
  return int(x & mask)
}

@nosplit fn idxSlotAddr(table: int, i: int): int {
  return table + i * 8
}

// #5584: THE SPAN-PRESENCE CACHE in front of ONE query -- `gcOwns`'
// (`./gcalloc.bit`) "is the 2^17-aligned span this address falls in currently
// carved?", once per traced reference, and through `idxContains` below 10.91%
// of a `pkg/yaml` parse's self time over 77,432,288 calls: 22.8 cycles for a
// 43-instruction hit, IPC 1.89 against the program's 5.35. Not the
// instructions -- `idxHash`'s serial multiplies feed a load whose ADDRESS they
// compute, so a mix latency plus a scattered table load sit on the dependent
// chain of every call. A hit is a shift, a mask and one 4 KiB load.
//
// POSITIVE ANSWERS ONLY, INVALIDATED EXACTLY. A stale NEGATIVE would drop a
// live object; a stale POSITIVE would let `allocSpanClass` dereference an
// unmapped span. An entry is written only where `idxContains` answered TRUE,
// and a positive for span S lives in one slot, `(S >> 17) & mask`, tagged with
// S -- so clearing it in `idxRemoveSpan`, the one site that turns a presence
// answer false, clears every answer for S. The other three mutation points owe
// nothing: `idxInsertSpan` only turns false into true (negatives are never
// cached), `idxGrow` zeroes the region below before publishing it, and
// `idxDisable` zeroes `gcIndexCap`, which readers return on. STORAGE IS THE
// TABLE'S OWN TAIL, NOT NEW STATE (`gcWords` is 39, boot-pinned): allocated,
// zeroed, reclaimed and abandoned with the table it follows.
const idxSpanCacheSlots: int = 512
const idxSpanCacheMask: int = 511
// `1 << idxSpanShift == allocSpanBytes` (131072); only the DISTRIBUTION
// depends on it, the tag compare is exact for any index function.
const idxSpanShift: int = 17

// Bytes for a table of `ncap` slots: the table plus its cache, and 0 for the
// empty table so `idxReclaimRetired` protects nothing for an absent spare.
@nosplit fn idxTableBytes(ncap: int): int {
  if (ncap == 0) {
    return 0
  }
  return (ncap + idxSpanCacheSlots) * 8
}

@nosplit fn idxSpanCacheSlotAddr(g: *i64, ncap: int, span: int): int {
  return idxSlotAddr(*(g + gcIndexAddr), ncap + ((span >> idxSpanShift) & idxSpanCacheMask))
}

// `gcOwns`' span-presence query, identical in ANSWER to `idxContains(g, span +
// 1)`, which it still calls on a miss.
@nosplit fn idxSpanPresent(g: *i64, span: int): bool {
  let ncap = *(g + gcIndexCap)
  // `span == 0` is refused for the reason `idxContains` refuses `idxTombstone`
  // above -- THE SENTINEL GUARD IS ABOUT THE QUERY: an empty slot reads 0, so
  // span 0 (any `body` under `allocSpanBytes`, which a conservative scan does
  // present) matches an untouched slot and answers TRUE. Measured:
  // `gcbit`/`gcindexchurn`/`gcslotbitmap` faulted at `allocSpanClass(0)`.
  if (ncap == 0 || span == 0) {
    return false
  }
  let slot = idxSpanCacheSlotAddr(g, ncap, span)
  if (loadWord(slot) == span) {
    return true
  }
  if (!idxContains(g, span + 1)) {
    return false
  }
  storeWord(slot, span)
  return true
}

// True if `addr` is present. Probes until an empty slot, which terminates
// because the load factor is held below 100%. Bounded by `ncap` regardless.
//
// THE SENTINEL GUARD IS ABOUT THE QUERY, NOT THE ENTRIES, and that distinction
// is the whole bug it fixes (found by #3177's enumerated differential, present
// on every build before it). `idxEmpty`/`idxTombstone`'s own comment argues
// that 0 and 1 "cannot collide with a real entry" — true, and irrelevant here:
// `idxContains` is asked about ARBITRARY integers, not about entries. A query
// for 1 walks the probe chain comparing `v == addr`, and the first TOMBSTONE it
// meets stores exactly 1 — so `gcOwns(g, 1)` answered TRUE against a table that
// had ever had a removal, disagreeing with `gcOwnsLinear`. `gcMarkRoot`'s
// `[gcLoAddr, gcHiAddr)` gate hides it from the mark path, but
// `runtime/root/iface.bit`'s `dynTypeOf` calls `gcOwns` with no bound at all
// and would go on to read a header at `1 - gcHeaderSize`.
//
// Rejecting both values up front is exact rather than conservative: a real key
// is a body or span address, 8-aligned and non-zero, so neither can be one.
//
// THE PROBE STEP MASKS, IT DOES NOT DIVIDE (#5570). `ncap` is a power of two
// on every path that sets it: `idxGrow` starts at `idxMinCap` (16) or the old
// capacity and only ever doubles, and `idxDisable`/`gcInit` set it to 0, which
// the guard above returns on. `idxHash` right above already depends on exactly
// that property — it masks with `ncap - 1` rather than dividing — so `(i + 1) &
// (ncap - 1)` is the same wrap the hash already assumes, not a new assumption.
// This is the #1 self-time function in a `pkg/yaml` parse (11.43%), reached
// once per traced reference through `gcOwns`.
@nosplit fn idxContains(g: *i64, addr: int): bool {
  let ncap = *(g + gcIndexCap)
  if (ncap == 0 || addr == idxTombstone) {
    return false
  }
  let table = *(g + gcIndexAddr)
  let mask = ncap - 1
  let i = idxHash(addr, ncap)
  let probes = 0
  while (probes < ncap) {
    let v = loadWord(idxSlotAddr(table, i))
    if (v == idxEmpty) {
      return false
    }
    if (v == addr) {
      return true
    }
    i = (i + 1) & mask
    probes = probes + 1
  }
  return false
}
