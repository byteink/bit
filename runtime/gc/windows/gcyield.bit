// Windows's `worldYield` provider (#2415). See ../gcyield.bit for why this
// exists as a paired module and what it fixes.
//
// `SwitchToThread` (kernel32.dll): the documented Windows analogue of POSIX
// `sched_yield` — yields the remainder of the calling thread's timeslice to
// another ready thread on the same processor. Verified via
// `GetProcAddress(LoadLibrary("kernel32.dll"), "SwitchToThread")` on
// `mustafa-desktop-win` (Windows NT 10.0.26200.0, native): non-null, matching
// Microsoft's own documented DllExport location. `compiler/pesyms.bit`'s
// `windowsImports` table carries the entry.
extern fn SwitchToThread(): i32

export @nosplit @symbol("bit_rt_port_gc_world_yield") fn gcWorldYield(): int {
  return int(SwitchToThread())
}
