// Darwin's `worldYield` provider (#2415). See ../gcyield.bit for why this
// exists as a paired module and what it fixes.
//
// `sched_yield` from libSystem — already admitted: `compiler/machosyms.bit`'s
// `libsystemSymbols` table already lists it (verified against a live
// `dlsym(RTLD_DEFAULT, ...)` per that file's own header), so no compiler-side
// change was needed for this half of the port.
extern fn sched_yield(): i32

export @nosplit @symbol("bit_rt_port_gc_world_yield") fn gcWorldYield(): int {
  return int(sched_yield())
}
