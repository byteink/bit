// Split out of ./gc.bit (#1503): collection driver and observability.

// ---------------------------------------------------------------------------
// Collection
// ---------------------------------------------------------------------------

// Begin a collection: reset the mark worklist. The caller then marks its roots
// (`gcMarkRoot` / `gcMarkConservative`) and calls `gcCollectFinish`. This pair
// is the collect loop with root scanning pushed rather than pulled — see constraint 2.
//
// PINNED (ABI.md §9): `runtime/chan`'s `chanDriveCollection` (#1610) brackets
// the chan-registry root scan with this phase pair across the object boundary,
// so — like `gcMarkConservative` — the pair needs the emitted-symbol contract a
// separately-emitted object links against; an unpinned export would be
// `m<N>$gcMarkBegin`, which no other object can reference (SPEC §11.9). The
// `bit_rt_port_` prefix is the placeholder #1369 strips.
export @nosplit @symbol("bit_rt_port_gc_mark_begin") fn gcMarkBegin(g: *i64) {
  *(g + gcStackTop) = 0
  *(g + gcOverflow) = 0
}

// Finish a collection: drain the worklist, recover from any overflow, sweep,
// and reschedule the next trigger relative to the surviving live set. PINNED for
// the same reason as `gcMarkBegin` (the other half of the phase pair
// `chanDriveCollection` drives, #1610).
export @nosplit @symbol("bit_rt_port_gc_collect_finish") fn gcCollectFinish(g: *i64) {
  drain(g)
  recoverOverflow(g)

  let swept = sweep(g)

  let live = heapLiveBytes(heapBlock(g))
  let pct = *(g + gcCfgGrowthPct)
  // The multiply must saturate rather than wrap. Guarding
  // before the multiply is the same thing without relying on i64 overflow,
  // which only wraps in v0.1 -- a debug build mode that traps instead is
  // specified but not yet implemented (§11.1, task #3076).
  let grown = gcAddrMax
  if (pct == 0 || live <= gcAddrMax / pct) {
    grown = (live * pct) / 100
  }
  let next = *(g + gcCfgMinTrigger)
  if (grown > next) {
    next = grown
  }
  *(g + gcNextBytes) = next

  *(g + gcStCollections) = *(g + gcStCollections) + 1
  *(g + gcStTotalSwept) = *(g + gcStTotalSwept) + swept
  *(g + gcStSurvivorsLast) = *(g + gcNumObjectsIdx)
}

// Run a full stop-the-world mark-sweep rooted at the `n` body addresses stored
// contiguously at `rootsAddr`. This is the `RootArray` scanner runtime/gc/'s own
// tests use, and the form the differential drives both collectors through.
export @nosplit fn gcCollectRoots(g: *i64, rootsAddr: int, n: int) {
  gcMarkBegin(g)
  let i = 0
  // Bounded: exactly `n` roots.
  while (i < n) {
    gcMarkRoot(g, loadWord(rootsAddr + i * 8))
    i = i + 1
  }
  gcCollectFinish(g)
}

// Whether a poll right now should collect: the collector is enabled and either
// stress mode is on or the live heap has crossed the trigger. `runtime/gc/`'s
// `shouldCollect`, and the SAME policy `gcSafepointRoots` below now reads
// through — one copy, so the two paths can never drift.
//
// Split out for one reason: the multi-threaded poll
// tests the trigger TWICE — once on the hot path, before paying for the
// stop-the-world handshake, and again after taking the world lock, because the
// thread that just released that lock may have collected everything this one was
// about to collect for. Two call sites, one predicate.
//
// PINNED (ABI.md §9): `runtime/stw`'s poll is a separately-emitted object and
// reaches this by its emitted symbol (SPEC §11.9), like every other cross-object
// runtime call. `bit_rt_port_` is the placeholder prefix #1369 strips.
export @nosplit @symbol("bit_rt_port_gc_should_collect") fn gcShouldCollect(g: *i64): bool {
  if (*(g + gcCfgEnabled) == 0) {
    return false
  }
  if (*(g + gcCfgStress) != 0) {
    return true
  }
  return heapLiveBytes(heapBlock(g)) >= *(g + gcNextBytes)
}

// Poll point for automatic collection. A mutator calls this where the stack
// maps make the roots precise; if the live heap has crossed the trigger the
// world stops and a collection runs.
//
// Under `stress` every safepoint collects, ignoring the byte trigger — which
// turns the stress suite into a precise-rooting oracle: any root the caller
// fails to report is swept on the very next poll.
export @nosplit fn gcSafepointRoots(g: *i64, rootsAddr: int, n: int) {
  if (!gcShouldCollect(g)) {
    return
  }
  gcCollectRoots(g, rootsAddr, n)
}

// ---------------------------------------------------------------------------
// Observability: the collector stats, plus the state a test needs to check invariants
// ---------------------------------------------------------------------------
//
// Most of these are read in-module or by a same-target stress program, so they
// carry no `@symbol` pin. THREE DO, and only because `runtime/stw` forwards them
// to the boot code that prints the `BIT_GC_STATS` line (#1639): a
// `--freestanding` module may reference a cross-module function only through a
// pin (#1628, SPEC §11.9). The pins name no ABI.md symbol and are never renamed,
// exactly like `bit_rt_port_gc_should_collect` above.

export @nosplit @symbol("bit_rt_port_gc_num_objects") fn gcNumObjects(g: *i64): int {
  let v = *(g + gcNumObjectsIdx)
  return v
}

export @nosplit @symbol("bit_rt_port_gc_stat_collections") fn gcStatCollections(g: *i64): int {
  let v = *(g + gcStCollections)
  return v
}

export @nosplit fn gcStatTotalAllocated(g: *i64): int {
  let v = *(g + gcStTotalAllocated)
  return v
}

export @nosplit @symbol("bit_rt_port_gc_stat_total_swept") fn gcStatTotalSwept(g: *i64): int {
  let v = *(g + gcStTotalSwept)
  return v
}

export @nosplit fn gcStatSurvivorsLast(g: *i64): int {
  let v = *(g + gcStSurvivorsLast)
  return v
}

// Non-zero only if a pointer map declared an offset that is misaligned or runs
// past the body — the invariant constraint 5 counts rather than asserts.
export @nosplit fn gcStatBadOffsets(g: *i64): int {
  let v = *(g + gcStBadOffset)
  return v
}

export @nosplit fn gcLiveBytes(g: *i64): int {
  return heapLiveBytes(heapBlock(g))
}

export @nosplit fn gcNextTrigger(g: *i64): int {
  let v = *(g + gcNextBytes)
  return v
}

export @nosplit fn gcIndexEnabled(g: *i64): bool {
  let ok = *(g + gcIndexOk)
  return ok == 1
}

// Live entries currently in the membership index. The stress test checks this
// against `gcNumObjects` — they must agree exactly, which is what proves the
// index stays in step with the all-objects list.
// Bytes still unused in the index reserve. A long alloc/free workload must
// leave this essentially flat: if it falls, tombstone-driven rehashing is
// leaking storage and the index will eventually be disabled — see `idxGrow`.
export @nosplit fn gcIndexReserveLeft(g: *i64): int {
  return reserveRemaining(g + gcIdxRes)
}

export @nosplit fn gcIndexEntries(g: *i64): int {
  let v = *(g + gcIndexLive)
  return v
}

// Chunks the SPAN reserve has mapped from the OS right now, and their total
// mapped bytes (#3046) — read through `reserveChunkCount`/`reserveChunkBytesMapped`
// (`./mem.bit`, sibling in this module) over `gcSpanRes`, the same three-word
// descriptor `gcHeapAlloc` grows through `reserveGrow`. See those functions'
// own comment for why this is a walk rather than a stored counter, and why it
// is the number that would have root-caused #2803 in one run where RSS and
// per-class occupancy could not.
export @nosplit fn gcSpanChunks(g: *i64): int {
  return reserveChunkCount(g + gcSpanRes)
}

export @nosplit fn gcSpanChunkBytes(g: *i64): int {
  return reserveChunkBytesMapped(g + gcSpanRes)
}

// The same walk over the INDEX reserve (`gcIdxRes`, `./gcindex.bit`'s
// address->object membership table), never reported before #3146. `idxGrow`
// grows this reserve through the same `reserveGrow` `gcHeapAlloc` uses for
// spans, but it never shrinks and never frees back to the OS: three tables are
// resident at once by design (the live one, the one-slot spare `idxGrow`
// caches in `gcIdxSpareAddr` to avoid re-taking storage on every rehash that
// only clears tombstones, and every smaller table ever superseded, since a
// bump reserve has no free list). So this reserve's bytes are not a bug to
// fix — they are a real, load-bearing cost the collector accepts on purpose —
// and until now `chunks=`/`chunkbytes=` (#3046) reported only `gcSpanRes`,
// leaving this one invisible to `BIT_GC_STATS` entirely.
export @nosplit fn gcIdxChunks(g: *i64): int {
  return reserveChunkCount(g + gcIdxRes)
}

export @nosplit fn gcIdxChunkBytes(g: *i64): int {
  return reserveChunkBytesMapped(g + gcIdxRes)
}
