// Split out of ./gcworld.bit (#1653): the lock, observers, and ABI doors.

// ---------------------------------------------------------------------------
// The serialization lock — `World.lock`
// ---------------------------------------------------------------------------
//
// Held for the whole stop-the-world window so only one collector runs at a time.
// The lock is the i32 at `worldLockWord`, reached
// through `spinCellAt` (the low half of the word, both targets little-endian) —
// the same bridge `runtime/chan` and `runtime/sched` use for a lock living
// inside a word-indexed block.

// Take the collector lock, spinning until won.
export @nosplit @symbol("bit_rt_port_gc_world_lock") function worldLockAcquire(world: *i64) {
  spinAcquire(spinCellAt(world, worldLockWord))
}

// Release the collector lock.
export @nosplit @symbol("bit_rt_port_gc_world_unlock") function worldLockRelease(world: *i64) {
  spinRelease(spinCellAt(world, worldLockWord))
}

// `SpinLock.tryAcquire` — take the collector lock if it is free, else report
// failure WITHOUT spinning. This is the door `runtime/root/`'s `safepointImpl` uses
// (`if (!g_world.lock.tryAcquire())`), and the non-spinning half is the whole
// deadlock-freedom argument: the loser PARKS instead of waiting, so a thread the
// collector is waiting for is never itself waiting for the collector.
// `worldLockAcquire` (spinning) is the wrong primitive there and is kept for the
// callers that genuinely must serialize.
export @nosplit @symbol("bit_rt_port_gc_world_trylock") function worldLockTry(world: *i64): bool {
  return spinTryAcquire(spinCellAt(world, worldLockWord))
}

// The snapshot slot `slot` published when it parked, or 0 if it is not parked.
//
// The collector's cursor over `runtime/root/`'s `forEachParkedFrame`: with the world
// stopped, every OTHER registered mutator is parked at its own safepoint with a
// `SafepointFrame` published on ITS stack, and that frame stays valid for exactly
// as long as it stays parked — which is until this collection ends. Scanning it
// is how a second OS thread's precise roots are found (ABI.md §5).
//
// A cursor rather than a callback, for the reason every other traversal
// in this tree is one: `@nosplit` refuses a call through a function value
// (E0075). The caller skips its own slot.
//
// Reads state and frame as two atomic loads and re-checks the state is still
// `parked` — a slot that leaves `parked` between the two loads would hand back a
// frame that is no longer published. Under a stopped world nothing may leave
// `parked`, so this cannot fire today; it costs one load and removes the
// dependence of a HEAP-CORRUPTING read on a caller-side precondition.
export @nosplit @symbol("bit_rt_port_gc_world_parked_frame") function worldParkedFrame(world: *i64, slot: int): int {
  let m = wMut(world, slot)
  if (atomicLoad(m) != mParked) {
    return 0
  }
  let f = atomicLoad(m + muFrame)
  if (atomicLoad(m) != mParked) {
    return 0
  }
  return f
}

// The deviation-5 counter: nonzero means a stop never cleared (a runtime bug).
// Exposed so a test can assert it stayed 0 across a whole run.
export @nosplit @symbol("bit_rt_port_gc_world_resume_giveup") function worldResumeGiveUp(world: *i64): int {
  return atomicLoad(world + worldStatResumeGiveUp)
}

// The raw `MutatorState` of slot `slot` (`mFree`/`mRunning`/`mParked`/`mBlocked`).
// A pure observer over the registry, so a test can assert a transition landed
// where the state machine says it should.
export @nosplit @symbol("bit_rt_port_gc_world_slot_state") function worldSlotState(world: *i64, slot: int): int {
  return atomicLoad(wMut(world, slot))
}

// The per-OS-thread token that owns slot `slot`, or 0 if it is unowned (#1650).
//
// A pure observer, exported for the same reason `worldSlotState` is: it is the
// only way a test can assert that two OS threads took TWO DISTINCT SLOTS rather
// than merely that the program stopped crashing. The defect this word exists to
// fix was invisible to the whole suite precisely because its symptom — a swept
// live object — is a fault somewhere else entirely, so the registry has to be
// observable directly. `tests/stress/gcworld` drives exactly that.
export @nosplit @symbol("bit_rt_port_gc_world_slot_owner") function worldSlotOwner(world: *i64, slot: int): int {
  return atomicLoad(wMut(world, slot) + muOwner)
}

// How many slots the registry has ever handed out (`worldHighWater`). With one
// thread per slot and slots claimed lowest-free-first, this is the number of OS
// threads that have registered — the count a test asserts is 2 and not 1.
export @nosplit @symbol("bit_rt_port_gc_world_high_water") function worldHighWaterMark(world: *i64): int {
  return atomicLoad(world + worldHighWater)
}

// ---------------------------------------------------------------------------
// The four ABI symbols (ABI.md §5/§6) — `bit_rt_gc_thread_enter/thread_exit/
// blocking_begin/blocking_end`
// ---------------------------------------------------------------------------
//
// These are the zero-argument C entry points `runtime/sched` calls (by symbol,
// to break the import cycle — see runtime/sched/'s `gc_hooks`). Pinned under
// the bare ABI name since G2 (#1583) stripped the `_root` infix. Do NOT
// call these by name from another module; they are the ABI boundary, reached
// from outside the Bit tree.
//
// THE SINGLETON AND THE CURRENT-MUTATOR CACHE. The singleton is `g_world` (the World
// instance) and a `threadlocal g_mutator` (this OS thread's slot). Two adaptations,
// both forced and both matching conventions already in this tree:
//
//   - `g_world` is THIS MODULE'S OWN module state (#2184). It was caller-owned,
//     with `runtime/root` holding the array and `worldBind` handing the address
//     over, because `@nosplit` rejected `ptrOf` — #1421 fixed that on
//     2026-07-19 and the design outlived the constraint. What remains of the
//     door is `worldSetReady`, which carries no address: until `rootInit` calls
//     it every wrapper below is a safe no-op, exactly as before.
//
//   - `g_mutator` USED TO NOT BE CACHED AT ALL (#1698) — every poll re-derived
//     the slot via `gcThreadToken()` (a real call) then `worldFindOwner` (a real
//     call, plus a bounded atomic-load search), where a `threadlocal
//     g_mutator` costs one plain load after the first poll. Measured on real
//     x86-64: a tight, allocation-free, crypto-free integer loop
//     ran ~10.4x slower against this `libbitrt.a` than against one built by an
//     optimising backend (epic #1851), and restructuring the SAME arithmetic to
//     hit ~2000x fewer safepoint
//     polls collapsed the ratio to ~1.03x — direct confirmation the per-poll
//     cost, not the arithmetic, was the term.
//
//     A genuine `threadlocal`-shaped fix is unavailable for the reason stated
//     above (`@threadlocal` refused for Mach-O) — but so is the OBVIOUS
//     workaround of reserving an extra word in the per-OS-thread TLS block
//     `./gcthread.bit`'s token is read from: on Linux that block is one this
//     runtime builds itself (`../thread/linux/tls.bit`) and could be extended,
//     but on Darwin `TPIDRRO_EL0` is the OS's own opaque per-thread pointer
//     (measured non-writable, kernel-managed) — this runtime does not own the
//     memory at that address and must not write past it. Any fix expressed only
//     in THIS architecture-independent Bit source (no platform seam, matching
//     every other function in this file) therefore cannot dereference the token
//     as a base address; it may only use it as an opaque comparison key.
//
//     `mutHintSlot` below is that: a single process-wide HINT — the last slot
//     any thread resolved — re-verified against the registry's own atomic owner
//     word before ever being trusted. A hit costs one token read (already paid,
//     unavoidable) plus one atomic load, no call, no loop. A miss (a different
//     thread's poll clobbered the hint since this thread's own last poll, or the
//     hint is stale after a release) costs exactly what today's full search
//     costs — never worse, never wrong, only sometimes not the fast path. This
//     is NOT the #1650 defect returning: #1650's `curMut` was TRUSTED without
//     re-checking the registry, so a second thread inherited the first thread's
//     slot outright. Every read of `mutHintSlot` here is re-verified against
//     `wMut(...)+muOwner` before being returned, so a stale, torn, or
//     another-thread's hint can only ever cost a fallback to the exact search,
//     never a wrong slot. (A naturally aligned 64-bit load/store does not tear
//     on either target this runtime supports, so "stale" is the only failure
//     mode a concurrent writer can produce here, not "corrupt".)
//
//     Plain module-state reads/writes, not atomics, and that is now a choice
//     rather than a constraint. It used to cite `@nosplit` rejecting `ptrOf` on
//     module state; #1421 fixed that on 2026-07-19 and the note went stale. A
//     hint that only ever gets safer, never worse, by being re-verified has no
//     correctness need for atomics in the first place, so it stays as it is.
//
//     `gcThreadExit` clears the hint when it currently names the slot being
//     released, so a departed thread's slot cannot linger as a stale guess
//     (belt-and-braces: the owner-word re-check above already makes a stale hint
//     harmless, since a released slot's owner reads 0, which matches no live
//     token).

// THE REGISTRY, OWNED HERE (#2184). It was caller-owned — `runtime/root` held
// the array and handed the address over through `worldBind` — for one reason:
// `@nosplit` rejected `ptrOf`, so this module could not take an address at all.
// #1421 fixed that on 2026-07-19; the design outlived its cause by 628 commits.
//
// Owning it deletes a whole failure mode rather than checking for it. A bind
// door takes an address as a plain `int`, so the collector cannot see the
// binding, cannot trace it and never rewrites it, and there is no unbind — hand
// it managed memory and every safepoint poll in the process reads a swept object
// the moment that memory dies. That is exactly what #1991 was, and it cost three
// sessions to find because the symptom (a fault on another thread, after all
// output, sensitive to an unrelated array's size) names nothing.
//
// Module state cannot be collected and outlives every thread, so the invariant
// now holds by construction. Nothing to enforce, nothing to get wrong.
//
// 1285 = `worldWords` (`gcworld.bit`). An array length must be a literal, so the
// two cannot be written as one; `rootInit` asserts the relation at boot and
// exits 70 on drift, which is where that guard already lived.
let worldBlock: [1285]i64

// Zero until `rootInit` says the runtime is up. NOT an address — the block above
// is this module's own module state, so there is nothing to hand over, which is
// the whole point of #2184. What the callers below actually needed from
// `worldAddr == 0` was never the address; it was "has boot run yet", and this
// says exactly that and nothing else.
//
// Load-bearing on x86-64, see `currentMutator`: the thread token is a load
// through `%fs:0` that FAULTS on a thread whose FS base is not installed, so
// every door must refuse on this word before it reads a token.
let worldReady: i64 = 0

// Publish readiness. Called once by `rootInit`, after `gcInit` and after the
// platform boot has installed the thread pointer.
export @nosplit @symbol("bit_rt_port_gc_world_ready") function worldSetReady() {
  worldReady = 1
}

// The steady-state poll hint (#1698) — see the header note above. A slot
// number BIASED BY ONE (0 = empty), naming the last slot ANY thread resolved.
// Never trusted on its own: every read is re-verified against the registry's
// own atomic owner word before being returned, so a stale or another-thread's
// value can only ever fall through to the exact search, never mislead one.
let mutHintSlot: i64 = 0

// #1904's saved callee-saved register file, `muRegWords` words per mutator slot,
// slot `i` at `i * muRegWords`. Owned here alongside the registry and for the
// same reason (#2184).
//
// A SEPARATE BLOCK, NOT MORE WORDS PER SLOT, and that is a cost decision. The
// note here used to say folding it into the slot "SIGSEGVs every binary under
// the collector"; #1991 closed on that being a test's heap-allocated registry,
// not a limit on either array. 12 words x 256 slots for a state only a
// syscall-parked thread uses is simply a poor trade.
//
// 3072 = `maxMutators * muRegWords` (`gcworld.bit`), a literal for the same
// reason `worldBlock` is, and asserted by `rootInit` for the same reason.
let syscallRegBlock: [3072]i64

// Address of slot `slot`'s saved callee-saved register file. Valid only while
// that slot is in `mSyscall`; callers gate on `worldSyscallSp` first.
export @nosplit @symbol("bit_rt_port_gc_world_syscall_regs") function worldSyscallRegs(slot: int): int {
  return int(ptrOf(syscallRegBlock)) + slot * muRegWords * 8
}

// This thread's slot BIASED BY ONE (0 = none), registering it first if it holds
// none — `runtime/root/`'s `currentMutator` exactly: find or claim a slot, and if a
// stop is already pending, park immediately so a thread joining mid-collection
// does not run behind the mark. `frame` is the safepoint snapshot address (0
// from the thread_enter/blocking_begin/allocation doors, which publish no
// snapshot).
//
// THE ORDER OF THE TWO REFUSALS MATTERS ON x86-64. `mutatorSlot` tests its
// `waddr` argument BEFORE reading the token, because the x64 token is a load
// through `%fs:0` and a thread whose FS base has not been installed yet would
// fault on it rather than read 0. `worldBlockAddr()` answers 0 until
// `worldSetReady`, which `rootInit` calls after `../../root/linux/boot.bit`'s
// `initLinuxTls` — so a non-zero answer implies an installed thread pointer.
// Testing in the other order would make every pre-boot safepoint a segfault.
// That is why this passes `worldBlockAddr()` rather than the block's address
// directly: the readiness gate lives inside it and must not be bypassed.
// PINNED, though nothing outside this module calls it by name. `worldEnsureSelf`
// below forwards to it and `runtime/stw` inlines THAT, which drags a reference to
// this body into a separately-emitted object; `--freestanding` refuses a mangled
// `m2$currentMutator` outright (SPEC §11.9, ABI.md §9) — measured, not guessed.
// The predecessor was small enough to be inlined away entirely; #1650 gave this
// one a search loop, so it stays a real call and needs a real name.
export @nosplit @symbol("bit_rt_port_gc_current_mutator") function currentMutator(frame: int): int {
  return mutatorSlot(worldBlockAddr(), frame, true)
}

// The same find-or-claim over a CALLER-SUPPLIED registry (#1836).
//
// This exists so a program can drive a PRIVATE World. There used to be a way to
// get one wrong — `worldBind`, which replaced this process's registry for every
// thread, including the live runtime's own workers. #2184 deleted it, so this is
// now the ONLY way, but the hazard is worth keeping on record. That is not hypothetical: it is
// exactly what `tests/stress/stwcollect` did, and the live worker joined the
// test's registry as a mutator the test never created and could not schedule,
// so the rendezvous waited on it and abandoned (#1833, measured as 2 claimed
// slots where the program had registered 1).
//
// Modelled on Go, which draws the same line: components owning process-global
// state are tested against the LIVE runtime, while components taking their
// state as a parameter get real private instances — `NewPageAlloc` is handed
// `new(mutex)` and its own stats and never writes the live allocator's pointer
// (`src/runtime/export_test.go`). The global path above is untouched; this only
// adds the parameterised one beside it.
//
// NO HINT CACHE on this path, deliberately. `mutHintSlot` is one per-thread word
// and cannot mean a slot in two different registries at once. The validating
// load below would make a cross-world hint MISS rather than answer wrongly, so
// sharing it would be safe but would thrash; skipping it costs a search on a
// path only a test takes.
export @nosplit @symbol("bit_rt_port_gc_current_mutator_on") function currentMutatorOn(waddr: int, frame: int): int {
  return mutatorSlot(waddr, frame, false)
}

// PINNED for the same reason `currentMutator` is, and the reason is recorded
// two comments up: both wrappers above are called from another object, the
// inliner pulls this body along with them, and `--freestanding` refuses a
// mangled `m2$mutatorSlot` no sibling object can define (SPEC §11.9, ABI.md §9).
// Measured, not guessed — the emit failed exactly that way before this pin.
@nosplit @symbol("bit_rt_port_gc_mutator_slot")
function mutatorSlot(waddr: int, frame: int, useHint: bool): int {
  if (waddr == 0) {
    return 0
  }
  let token = gcThreadToken()
  if (token == 0) {
    // No thread pointer installed: this thread cannot be told from any other, so
    // it gets no slot. Not registering is the safe direction — an unregistered
    // thread is never counted as stopped, so no collection proceeds believing it
    // has parked.
    return 0
  }
  let world = wordAt(waddr)

  // FAST PATH (#1698): re-derived fresh every call (nothing here survives a
  // possible migration between this read and the last one — there is no
  // registration between two SEPARATE calls to re-derive across), so this is
  // safe against the #1466 TLS-hoisting shape by construction: there is no
  // threadlocal, and no value is trusted without checking it against the
  // registry's own atomic word first. A hit costs one extra atomic load and no
  // call; a miss costs nothing more than today's full search below.
  if (useHint) {
    let hint = mutHintSlot
    if (hint != 0) {
      let hintSlot = hint - 1
      if (atomicLoad(wMut(world, hintSlot) + muOwner) == token) {
        return hint
      }
    }
  }

  let found = worldFindOwner(world, token)
  if (found >= 0) {
    if (useHint) {
      mutHintSlot = found + 1
    }
    return found + 1
  }
  let slot = worldClaimFor(world, token)
  if (slot < 0) {
    return 0
  }
  if (worldStopRequested(world)) {
    worldPark(world, slot, frame)
  }
  if (useHint) {
    mutHintSlot = slot + 1
  }
  return slot + 1
}

// ---------------------------------------------------------------------------
// The two doors the SAFEPOINT POLL needs, and why they are exported (#1633)
// ---------------------------------------------------------------------------
//
// `worldAddr` is this module's `g_world` stand-in and stays private: nothing
// outside may set it, or two callers would disagree about which registry this
// process has. What the poll needs is that READ, and `currentMutator`'s
// find-or-claim-and-park-on-entry, so exactly those are published.
//
// This is what lets the collector half (`runtime/stw`) live in a module that can
// also see `runtime/chan` and `runtime/sched`, whose roots a collection must
// enumerate. `runtime/gc` cannot import either (`chan` imports `../gc`, so the
// reverse edge is an import cycle, E0044), and the registration path must not be
// duplicated there — a thread holding two slots is a thread the rendezvous waits
// for forever. Publishing the two accessors keeps ONE registry with ONE owner
// and moves only the composition.

// This module's own registry block, or 0 before `worldSetReady` — the value the
// poll tests before touching the registry at all, and the gate that keeps a
// pre-boot door from reading an uninstalled x64 thread pointer.
export @nosplit @symbol("bit_rt_port_gc_world_addr") function worldBlockAddr(): int {
  if (worldReady == 0) {
    return 0
  }
  return int(ptrOf(worldBlock))
}

// Register this thread if it has not registered (parking immediately if a stop
// is already pending, so a thread joining mid-collection cannot run behind the
// mark) and return its slot BIASED BY ONE — 0 means "no slot", and `runtime/root/`'s
// `currentMutator` returns `?*Mutator` for the same distinction.
//
// `frame` is the caller's `SafepointFrame` address, published on park. The
// safepoint door passes its real frame; the thread_enter/blocking/allocation
// doors pass 0 (they hold no stack map).
export @nosplit @symbol("bit_rt_port_gc_world_ensure_self") function worldEnsureSelf(frame: int): int {
  return currentMutator(frame)
}

// The same door over a caller-supplied registry — `stwPollOn`'s counterpart to
// this one, for a program driving a private World (#1836). See `currentMutatorOn`.
export @nosplit @symbol("bit_rt_port_gc_world_ensure_self_on") function worldEnsureSelfOn(waddr: int, frame: int): int {
  return currentMutatorOn(waddr, frame)
}

// `bit_rt_gc_thread_enter` (ABI.md §5/§6): register this OS thread as a mutator.
// Idempotent. NOT merely preferred — soundness DOES depend on it being called at
// every OS-thread entry that can run Bit code before its first allocation or
// safepoint poll (#1677/#1699). Lazy registration (the allocation and safepoint
// doors also register on first touch) leaves a real pre-registration window: a
// thread that becomes the sole holder of a live reference before touching either
// door is invisible to the rendezvous, and #1677's reproducer swept such an
// object 20/20 runs. `runtime/root/<os>/boot.bit`'s `workerBody` calls this as
// its first statement for exactly that reason.
export @nosplit @symbol("bit_rt_gc_thread_enter") function gcThreadEnter() {
  let mu = currentMutator(0)
}

// `bit_rt_gc_thread_exit` (ABI.md §5/§6): release this thread's slot. NOT
// optional — a leaked slot stays `running` forever, which corrupts nothing but
// makes every later rendezvous expire, i.e. collection quietly stops.
//
// OWED BY THIS ARCHIVE AT SWAP TIME (#1801): `runtime/root/` no longer waits to be
// asked. On Darwin it arms a pthread TSD destructor at the moment the slot is
// claimed (`exit_hook`, and note the measured trap recorded there — the
// destructor may not read a `threadlocal`), which is the hook this module's
// `currentMutator` will have to arm in its place once G2/G3 swap the archive.
// The Linux side needs nothing here: its provider calls this from the child's
// own exit path.
//
// Looks the slot up rather than registering: a thread that never registered has
// nothing to release, and CLAIMING one here just to free it would be a pure
// waste (and, under a pending stop, would park a thread that is on its way out).
export @nosplit @symbol("bit_rt_gc_thread_exit") function gcThreadExit() {
  if (worldReady == 0) {
    return
  }
  let token = gcThreadToken()
  if (token == 0) {
    return
  }
  let world = ptrOf(worldBlock)
  let slot = worldFindOwner(world, token)
  if (slot < 0) {
    return
  }
  worldRelease(world, slot)
  // Invalidate the fast-path hint if it currently names this slot (#1698):
  // belt-and-braces, since `currentMutator`'s owner re-check already makes a
  // stale hint harmless (a released slot's owner reads 0, matching no live
  // token) — this just keeps the hint from pointing at a dead slot any longer
  // than it has to.
  if (mutHintSlot == slot + 1) {
    mutHintSlot = 0
  }
}

// `bit_rt_gc_blocking_begin` (ABI.md §5/§6). PRECONDITION: the calling thread
// holds NO live Bit references in any frame for the whole bracketed region.
// Registers first (a thread may block before ever allocating), then hands its
// slot to the collector's "pass without waiting" contract.
export @nosplit @symbol("bit_rt_gc_blocking_begin") function gcBlockingBegin() {
  let mu = currentMutator(0)
  if (mu == 0) {
    return
  }
  let world = ptrOf(worldBlock)
  worldBeginBlocking(world, mu - 1)
}

// `bit_rt_gc_blocking_end` (ABI.md §5/§6). Blocks while a stop is pending rather
// than resuming behind the collector's back (`worldEndBlocking`).
export @nosplit @symbol("bit_rt_gc_blocking_end") function gcBlockingEnd() {
  if (worldReady == 0) {
    return
  }
  let token = gcThreadToken()
  if (token == 0) {
    return
  }
  let world = ptrOf(worldBlock)
  let slot = worldFindOwner(world, token)
  if (slot < 0) {
    return
  }
  worldEndBlocking(world, slot)
}

// ---------------------------------------------------------------------------
// `bit_rt_gc_syscall_begin` / `_end` (#1904)
// ---------------------------------------------------------------------------
//
// The pair a thread about to block in the kernel uses instead of
// blocking_begin/end. See `mSyscall` (./gcworld.bit) for why neither `running`
// nor `blocked` can express this, and `worldBeginSyscall` (./gcworldstop.bit)
// for the contract.

// This thread's live stack pointer — the same one-instruction form as
// `../stw/stw.bit`'s `stwReadSp` and `../sched/sched.bit`'s `readSp`, inline by
// construction and so legal in a `@nosplit` body. Duplicated rather than
// imported for the reason the other two are: each is module private and the
// instruction, not the function, is the contract.
@nosplit function gcReadSp(): int {
  return asm {
    arm64 { 0x910003E0 }              // mov x0, sp
    x64   { 0x48, 0x89, 0xE0 }        // mov rax, rsp
    result arm64 x0 x64 rax : int
  }
}

// Save this thread's callee-saved integer registers into `muRegWords` words at
// `dst`, the store half of `../sched/sched.bit`'s `schedSwitch` with a plain
// return instead of a context load.
//
// THE FLOATING-POINT FILE IS DELIBERATELY OMITTED, unlike `schedSwitch`, which
// saves d8..d15 because it must RESTORE them. Nothing is restored here — this is
// a root snapshot, and an f64 is not a reference — so saving them would only
// hand `gcMarkConservative` eight more words to reject.
//
// Saving from inside a Bit function is sound for the same reason `schedSwitch`
// is, and that reason is worth stating because it is not obvious: if the
// compiler clobbers a callee-saved register anywhere between the caller and
// here, the ABI required it to spill the original into a frame first, and every
// such frame lies ABOVE the `sp` published alongside this file — so the value is
// covered by the conservative stack walk even when the copy captured here is the
// clobbered one. The two publications overlap on purpose; neither alone is
// enough.
@nosplit function gcSaveCalleeRegs(dst: int) {
  asm {
    arm64 {
      0xF9000013, 0xF9000414, 0xF9000815, 0xF9000C16, // str x19..x22, [x0, #0..24]
      0xF9001017, 0xF9001418, 0xF9001819, 0xF9001C1A, // str x23..x26, [x0, #32..56]
      0xF900201B, 0xF900241C,                         // str x27, x28, [x0, #64..72]
      0xF900281D, 0xF9002C1E                          // str x29, x30, [x0, #80..88]
    }
    x64 {
      0x48, 0x89, 0x5F, 0x00,       // mov [rdi+0x00], rbx
      0x48, 0x89, 0x6F, 0x08,       // mov [rdi+0x08], rbp
      0x4C, 0x89, 0x67, 0x10,       // mov [rdi+0x10], r12
      0x4C, 0x89, 0x6F, 0x18,       // mov [rdi+0x18], r13
      0x4C, 0x89, 0x77, 0x20,       // mov [rdi+0x20], r14
      0x4C, 0x89, 0x7F, 0x28        // mov [rdi+0x28], r15
    }
    input arm64 x0 x64 rdi = dst
    clobber arm64 { memory }
    clobber x64 { memory }
  }
}

// `bit_rt_gc_syscall_begin`. Registers first (a thread may reach a subprocess
// wait before ever allocating), captures `sp` BEFORE saving the registers so the
// save's own frame lies below the published bound, then publishes both.
export @nosplit @symbol("bit_rt_gc_syscall_begin") function gcSyscallBegin() {
  let mu = currentMutator(0)
  if (mu == 0) {
    return
  }
  let slot = mu - 1
  // No "is the block bound yet" refusal here since #2184: the register file is
  // this module's own module state, so its address is always real. The only
  // thing that could make it meaningless is an unregistered thread, and
  // `currentMutator` above already answered that.
  let regs = worldSyscallRegs(slot)
  let world = ptrOf(worldBlock)
  let sp = gcReadSp()
  gcSaveCalleeRegs(regs)
  worldBeginSyscall(world, slot, sp)
}

// `bit_rt_gc_syscall_end`. Mirrors `gcBlockingEnd` exactly, including its
// refusal order: `worldAddr` before the token, because the x64 token is a load
// through `%fs:0` that faults on a thread whose FS base is not installed yet.
export @nosplit @symbol("bit_rt_gc_syscall_end") function gcSyscallEnd() {
  if (worldReady == 0) {
    return
  }
  let token = gcThreadToken()
  if (token == 0) {
    return
  }
  let world = ptrOf(worldBlock)
  let slot = worldFindOwner(world, token)
  if (slot < 0) {
    return
  }
  worldEndSyscall(world, slot)
}
