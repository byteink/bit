// Split out of ./gcworld.bit (#1653): the lock, observers, and ABI doors.

// ---------------------------------------------------------------------------
// The serialization lock — `World.lock`
// ---------------------------------------------------------------------------
//
// Held for the whole stop-the-world window so only one collector runs at a time.
// Zig embeds a `SpinLock` field; here it is the i32 at `worldLockWord`, reached
// through `spinCellAt` (the low half of the word, both targets little-endian) —
// the same bridge `runtime/chan` and `runtime/sched` use for a lock living
// inside a word-indexed block.

// Take the collector lock, spinning until won.
export @nosplit @symbol("bit_rt_port_gc_world_lock") function worldLockAcquire(world: *i64) {
  spinAcquire(spinCellAt(world, worldLockWord))
}

// Release the collector lock.
export @nosplit @symbol("bit_rt_port_gc_world_unlock") function worldLockRelease(world: *i64) {
  spinRelease(spinCellAt(world, worldLockWord))
}

// `SpinLock.tryAcquire` — take the collector lock if it is free, else report
// failure WITHOUT spinning. This is the door `root.zig`'s `safepointImpl` uses
// (`if (!g_world.lock.tryAcquire())`), and the non-spinning half is the whole
// deadlock-freedom argument: the loser PARKS instead of waiting, so a thread the
// collector is waiting for is never itself waiting for the collector.
// `worldLockAcquire` (spinning) is the wrong primitive there and is kept for the
// callers that genuinely must serialize.
export @nosplit @symbol("bit_rt_port_gc_world_trylock") function worldLockTry(world: *i64): bool {
  return spinTryAcquire(spinCellAt(world, worldLockWord))
}

// The snapshot slot `slot` published when it parked, or 0 if it is not parked.
//
// The collector's cursor over `root.zig`'s `forEachParkedFrame`: with the world
// stopped, every OTHER registered mutator is parked at its own safepoint with a
// `SafepointFrame` published on ITS stack, and that frame stays valid for exactly
// as long as it stays parked — which is until this collection ends. Scanning it
// is how a second OS thread's precise roots are found (ABI.md §5).
//
// A cursor rather than Zig's callback form for the reason every other traversal
// in this tree is one: `@nosplit` refuses a call through a function value
// (E0075). The caller skips its own slot.
//
// Reads state and frame as two atomic loads and re-checks the state is still
// `parked` — a slot that leaves `parked` between the two loads would hand back a
// frame that is no longer published. Under a stopped world nothing may leave
// `parked`, so this cannot fire today; it costs one load and removes the
// dependence of a HEAP-CORRUPTING read on a caller-side precondition.
export @nosplit @symbol("bit_rt_port_gc_world_parked_frame") function worldParkedFrame(world: *i64, slot: int): int {
  let m = wMut(world, slot)
  if (atomicLoad(m) != mParked) {
    return 0
  }
  let f = atomicLoad(m + muFrame)
  if (atomicLoad(m) != mParked) {
    return 0
  }
  return f
}

// The deviation-5 counter: nonzero means a stop never cleared (a runtime bug).
// Exposed so a test can assert it stayed 0 across a whole run.
export @nosplit @symbol("bit_rt_port_gc_world_resume_giveup") function worldResumeGiveUp(world: *i64): int {
  return atomicLoad(world + worldStatResumeGiveUp)
}

// The raw `MutatorState` of slot `slot` (`mFree`/`mRunning`/`mParked`/`mBlocked`).
// A pure observer over the registry, so a test can assert a transition landed
// where the state machine says it should.
export @nosplit @symbol("bit_rt_port_gc_world_slot_state") function worldSlotState(world: *i64, slot: int): int {
  return atomicLoad(wMut(world, slot))
}

// The per-OS-thread token that owns slot `slot`, or 0 if it is unowned (#1650).
//
// A pure observer, exported for the same reason `worldSlotState` is: it is the
// only way a test can assert that two OS threads took TWO DISTINCT SLOTS rather
// than merely that the program stopped crashing. The defect this word exists to
// fix was invisible to the whole suite precisely because its symptom — a swept
// live object — is a fault somewhere else entirely, so the registry has to be
// observable directly. `tests/stress/gcworld` drives exactly that.
export @nosplit @symbol("bit_rt_port_gc_world_slot_owner") function worldSlotOwner(world: *i64, slot: int): int {
  return atomicLoad(wMut(world, slot) + muOwner)
}

// How many slots the registry has ever handed out (`worldHighWater`). With one
// thread per slot and slots claimed lowest-free-first, this is the number of OS
// threads that have registered — the count a test asserts is 2 and not 1.
export @nosplit @symbol("bit_rt_port_gc_world_high_water") function worldHighWaterMark(world: *i64): int {
  return atomicLoad(world + worldHighWater)
}

// ---------------------------------------------------------------------------
// The four ABI symbols (ABI.md §5/§6) — `bit_rt_gc_thread_enter/thread_exit/
// blocking_begin/blocking_end`
// ---------------------------------------------------------------------------
//
// These are the zero-argument C entry points `runtime/sched` calls (by symbol,
// to break the import cycle — see sched.zig's `gc_hooks`). Pinned with the
// `bit_rt_root_` PLACEHOLDER infix, not the bare ABI name: `runtime/root.zig` is
// still linked into `libbitrt.a` and would collide (`DuplicateSymbol`) — G2
// (#1583) strips the `_root` infix when it retires the Zig originals. Do NOT
// call these by name from another module; they are the ABI boundary, reached
// from outside the Bit tree.
//
// THE SINGLETON AND THE CURRENT-MUTATOR CACHE. Zig keeps `g_world` (the World
// instance) and a `threadlocal g_mutator` (this OS thread's slot). Two adaptations,
// both forced and both matching conventions already in this tree:
//
//   - `g_world` is CALLER-OWNED, exactly as the collector state is (deviation 1):
//     `runtime/root` owns the block and its address is bound here once via
//     `worldBind`. `@nosplit` rejects `ptrOf` (E0075, measured — the same gap
//     `root.bit` documents), so this module cannot take the address of a
//     module-state array itself; the owner passes it in, `wordAt` recovers the
//     pointer. Until `worldBind` runs, `worldAddr == 0` and every wrapper is a
//     safe no-op.
//
//   - `g_mutator` USED TO NOT BE CACHED AT ALL (#1698) — every poll re-derived
//     the slot via `gcThreadToken()` (a real call) then `worldFindOwner` (a real
//     call, plus a bounded atomic-load search), where Zig's `threadlocal
//     g_mutator` costs one plain load after the first poll. Measured on real
//     x86-64: a tight, allocation-free, crypto-free integer loop
//     ran ~10.4x slower against a Bit-sourced `libbitrt.a` than against the Zig
//     one, and restructuring the SAME arithmetic to hit ~2000x fewer safepoint
//     polls collapsed the ratio to ~1.03x — direct confirmation the per-poll
//     cost, not the arithmetic, was the term.
//
//     A genuine `threadlocal`-shaped fix is unavailable for the reason stated
//     above (`@threadlocal` refused for Mach-O) — but so is the OBVIOUS
//     workaround of reserving an extra word in the per-OS-thread TLS block
//     `./gcthread.bit`'s token is read from: on Linux that block is one this
//     runtime builds itself (`../thread/linux/tls.bit`) and could be extended,
//     but on Darwin `TPIDRRO_EL0` is the OS's own opaque per-thread pointer
//     (measured non-writable, kernel-managed) — this runtime does not own the
//     memory at that address and must not write past it. Any fix expressed only
//     in THIS architecture-independent Bit source (no platform seam, matching
//     every other function in this file) therefore cannot dereference the token
//     as a base address; it may only use it as an opaque comparison key.
//
//     `mutHintSlot` below is that: a single process-wide HINT — the last slot
//     any thread resolved — re-verified against the registry's own atomic owner
//     word before ever being trusted. A hit costs one token read (already paid,
//     unavoidable) plus one atomic load, no call, no loop. A miss (a different
//     thread's poll clobbered the hint since this thread's own last poll, or the
//     hint is stale after a release) costs exactly what today's full search
//     costs — never worse, never wrong, only sometimes not the fast path. This
//     is NOT the #1650 defect returning: #1650's `curMut` was TRUSTED without
//     re-checking the registry, so a second thread inherited the first thread's
//     slot outright. Every read of `mutHintSlot` here is re-verified against
//     `wMut(...)+muOwner` before being returned, so a stale, torn, or
//     another-thread's hint can only ever cost a fallback to the exact search,
//     never a wrong slot. (A naturally aligned 64-bit load/store does not tear
//     on either target this runtime supports, so "stale" is the only failure
//     mode a concurrent writer can produce here, not "corrupt".)
//
//     Plain module-state reads/writes, not atomics: `@nosplit` is measured to
//     reject `ptrOf` even on module state despite SPEC §11.11 saying it is
//     legal there (`root.bit`'s own documented gap, #1421) — the same reason
//     `worldAddr` below is a plain scalar and not something the atomics touch.
//     A hint that only ever gets safer, never worse, by being re-verified has
//     no correctness need for atomics in the first place.
//
//     `gcThreadExit` clears the hint when it currently names the slot being
//     released, so a departed thread's slot cannot linger as a stale guess
//     (belt-and-braces: the owner-word re-check above already makes a stale hint
//     harmless, since a released slot's owner reads 0, which matches no live
//     token).

// Address of the caller-owned World block, or 0 before `worldBind`.
let worldAddr: i64 = 0

// The steady-state poll hint (#1698) — see the header note above. A slot
// number BIASED BY ONE (0 = empty), naming the last slot ANY thread resolved.
// Never trusted on its own: every read is re-verified against the registry's
// own atomic owner word before being returned, so a stale or another-thread's
// value can only ever fall through to the exact search, never mislead one.
let mutHintSlot: i64 = 0

// Bind the process-wide World block. Called once at boot by `runtime/root`,
// after it has `ptrOf`'d its own `g_world` array (which this `@nosplit` module
// cannot do for it). Idempotent-friendly: re-binding the same address is a
// no-op, and the block is expected zeroed (every slot free, no stop, epoch 0).
export @nosplit @symbol("bit_rt_port_gc_world_bind") function worldBind(addr: int) {
  worldAddr = addr
}

// This thread's slot BIASED BY ONE (0 = none), registering it first if it holds
// none — `root.zig`'s `currentMutator` exactly: find or claim a slot, and if a
// stop is already pending, park immediately so a thread joining mid-collection
// does not run behind the mark. `frame` is the safepoint snapshot address (0
// from the thread_enter/blocking_begin/allocation doors, which publish no
// snapshot).
//
// THE ORDER OF THE TWO REFUSALS MATTERS ON x86-64. `worldAddr == 0` is tested
// BEFORE the token is read, because the x64 token is a load through `%fs:0` and
// a thread whose FS base has not been installed yet would fault on it rather
// than read 0. `worldBind` runs after `../../root/linux/boot.bit`'s
// `initLinuxTls`, so a bound World implies an installed thread pointer; testing
// in the other order would make every pre-boot safepoint a segfault.
// PINNED, though nothing outside this module calls it by name. `worldEnsureSelf`
// below forwards to it and `runtime/stw` inlines THAT, which drags a reference to
// this body into a separately-emitted object; `--freestanding` refuses a mangled
// `m2$currentMutator` outright (SPEC §11.9, ABI.md §9) — measured, not guessed.
// The predecessor was small enough to be inlined away entirely; #1650 gave this
// one a search loop, so it stays a real call and needs a real name.
export @nosplit @symbol("bit_rt_port_gc_current_mutator") function currentMutator(frame: int): int {
  if (worldAddr == 0) {
    return 0
  }
  let token = gcThreadToken()
  if (token == 0) {
    // No thread pointer installed: this thread cannot be told from any other, so
    // it gets no slot. Not registering is the safe direction — an unregistered
    // thread is never counted as stopped, so no collection proceeds believing it
    // has parked.
    return 0
  }
  let world = wordAt(worldAddr)

  // FAST PATH (#1698): re-derived fresh every call (nothing here survives a
  // possible migration between this read and the last one — there is no
  // registration between two SEPARATE calls to re-derive across), so this is
  // safe against the #1466 TLS-hoisting shape by construction: there is no
  // threadlocal, and no value is trusted without checking it against the
  // registry's own atomic word first. A hit costs one extra atomic load and no
  // call; a miss costs nothing more than today's full search below.
  let hint = mutHintSlot
  if (hint != 0) {
    let hintSlot = hint - 1
    if (atomicLoad(wMut(world, hintSlot) + muOwner) == token) {
      return hint
    }
  }

  let found = worldFindOwner(world, token)
  if (found >= 0) {
    mutHintSlot = found + 1
    return found + 1
  }
  let slot = worldClaimFor(world, token)
  if (slot < 0) {
    return 0
  }
  if (worldStopRequested(world)) {
    worldPark(world, slot, frame)
  }
  mutHintSlot = slot + 1
  return slot + 1
}

// ---------------------------------------------------------------------------
// The two doors the SAFEPOINT POLL needs, and why they are exported (#1633)
// ---------------------------------------------------------------------------
//
// `worldAddr` is this module's `g_world` stand-in and stays private: nothing
// outside may set it, or two callers would disagree about which registry this
// process has. What the poll needs is that READ, and `currentMutator`'s
// find-or-claim-and-park-on-entry, so exactly those are published.
//
// This is what lets the collector half (`runtime/stw`) live in a module that can
// also see `runtime/chan` and `runtime/sched`, whose roots a collection must
// enumerate. `runtime/gc` cannot import either (`chan` imports `../gc`, so the
// reverse edge is an import cycle, E0044), and the registration path must not be
// duplicated there — a thread holding two slots is a thread the rendezvous waits
// for forever. Publishing the two accessors keeps ONE registry with ONE owner
// and moves only the composition.

// The bound World block address, or 0 before `worldBind` — the value the poll
// tests before touching the registry at all (pre-boot there is no registry).
export @nosplit @symbol("bit_rt_port_gc_world_addr") function worldBlockAddr(): int {
  let a = worldAddr
  return a
}

// Register this thread if it has not registered (parking immediately if a stop
// is already pending, so a thread joining mid-collection cannot run behind the
// mark) and return its slot BIASED BY ONE — 0 means "no slot", and `root.zig`'s
// `currentMutator` returns `?*Mutator` for the same distinction.
//
// `frame` is the caller's `SafepointFrame` address, published on park. The
// safepoint door passes its real frame; the thread_enter/blocking/allocation
// doors pass 0 (they hold no stack map).
export @nosplit @symbol("bit_rt_port_gc_world_ensure_self") function worldEnsureSelf(frame: int): int {
  return currentMutator(frame)
}

// `bit_rt_gc_thread_enter` (ABI.md §5/§6): register this OS thread as a mutator.
// Idempotent. Preferred over lazy registration so the claim stays off the first
// allocation's path, but soundness does not depend on it being called (the
// allocation and safepoint doors register lazily too).
export @nosplit @symbol("bit_rt_root_gc_thread_enter") function gcThreadEnter() {
  let mu = currentMutator(0)
}

// `bit_rt_gc_thread_exit` (ABI.md §5/§6): release this thread's slot. NOT
// optional — a leaked slot stays `running` forever, which corrupts nothing but
// makes every later rendezvous expire, i.e. collection quietly stops.
//
// OWED BY THIS ARCHIVE AT SWAP TIME (#1801): `root.zig` no longer waits to be
// asked. On Darwin it arms a pthread TSD destructor at the moment the slot is
// claimed (`exit_hook`, and note the measured trap recorded there — the
// destructor may not read a `threadlocal`), which is the hook this module's
// `currentMutator` will have to arm in its place once G2/G3 swap the archive.
// The Linux side needs nothing here: its provider calls this from the child's
// own exit path.
//
// Looks the slot up rather than registering: a thread that never registered has
// nothing to release, and CLAIMING one here just to free it would be a pure
// waste (and, under a pending stop, would park a thread that is on its way out).
export @nosplit @symbol("bit_rt_root_gc_thread_exit") function gcThreadExit() {
  if (worldAddr == 0) {
    return
  }
  let token = gcThreadToken()
  if (token == 0) {
    return
  }
  let world = wordAt(worldAddr)
  let slot = worldFindOwner(world, token)
  if (slot < 0) {
    return
  }
  worldRelease(world, slot)
  // Invalidate the fast-path hint if it currently names this slot (#1698):
  // belt-and-braces, since `currentMutator`'s owner re-check already makes a
  // stale hint harmless (a released slot's owner reads 0, matching no live
  // token) — this just keeps the hint from pointing at a dead slot any longer
  // than it has to.
  if (mutHintSlot == slot + 1) {
    mutHintSlot = 0
  }
}

// `bit_rt_gc_blocking_begin` (ABI.md §5/§6). PRECONDITION: the calling thread
// holds NO live Bit references in any frame for the whole bracketed region.
// Registers first (a thread may block before ever allocating), then hands its
// slot to the collector's "pass without waiting" contract.
export @nosplit @symbol("bit_rt_root_gc_blocking_begin") function gcBlockingBegin() {
  let mu = currentMutator(0)
  if (mu == 0) {
    return
  }
  let world = wordAt(worldAddr)
  worldBeginBlocking(world, mu - 1)
}

// `bit_rt_gc_blocking_end` (ABI.md §5/§6). Blocks while a stop is pending rather
// than resuming behind the collector's back (`worldEndBlocking`).
export @nosplit @symbol("bit_rt_root_gc_blocking_end") function gcBlockingEnd() {
  if (worldAddr == 0) {
    return
  }
  let token = gcThreadToken()
  if (token == 0) {
    return
  }
  let world = wordAt(worldAddr)
  let slot = worldFindOwner(world, token)
  if (slot < 0) {
    return
  }
  worldEndBlocking(world, slot)
}
