// Split out of ./gc.bit (#1503): allocation and membership.

// ---------------------------------------------------------------------------
// Allocation
// ---------------------------------------------------------------------------

// Widen the monotonic address window used by `gcMarkRoot`'s O(1) reject.
// Never shrinks on sweep: shrinking only widens the reject
// window slightly and costs nothing in correctness.
@nosplit fn noteBody(g: *i64, addr: int) {
  if (addr < *(g + gcLoAddr)) {
    *(g + gcLoAddr) = addr
  }
  if (addr + 1 > *(g + gcHiAddr)) {
    *(g + gcHiAddr) = addr + 1
  }
}

// ---------------------------------------------------------------------------
// #3147/#3176: the span's own occupied-slot bitmap
// ---------------------------------------------------------------------------
//
// WRITE-ONLY IN THIS TICKET — `gcOwns` does not read this yet (#3177). Set and
// cleared at the SAME two call sites `idxInsert`/`idxRemove` already use
// (`linkObject` below, `freeObject` in `./gcmark.bit`), never inside
// `runtime/alloc/`'s take/give: `gcInit`'s mark worklist allocates straight
// through `gcHeapAlloc` without ever reaching `linkObject` (design note in
// `./gcindex.bit`), and only THIS layer knows that take is not a real object.
//
// `idx` is recomputed from `size`/`alignment` with the SAME pure
// `allocClassify` call `gcHeapAlloc`/`gcHeapFree` already made internally
// (alignment is always 8 for a GC object), so this needs no read of the
// allocator's own span state and no extra lock beyond the one already held
// here. `idx < 0` is the large/direct-mapped path — not span-backed, so the
// bitmap does not apply and both helpers below no-op.
//
// ATOMIC, NOT A PLAIN READ-MODIFY-WRITE: two mutator threads can concurrently
// link or free two different slots that land in the SAME 64-bit bitmap word
// (`linkObject`/`freeObject` hold only the object-list lock, not the heap
// lock the allocator's own span writes are under), so a non-atomic store here
// would lose a concurrent sibling's bit.
@nosplit fn setSlotBit(addr: int, idx: int) {
  if (idx < 0) { return }
  let n = allocSlotIndex(addr, idx)
  if (n < 0) { return }
  let w = wordAt(allocSpanOf(addr) + allocSpanHdrWords * 8 + (n / 64) * 8)
  let mask = 1 << (n % 64)
  let _ = atomicOr(w, mask)
}

@nosplit fn clearSlotBit(addr: int, idx: int) {
  if (idx < 0) { return }
  let n = allocSlotIndex(addr, idx)
  if (n < 0) { return }
  let w = wordAt(allocSpanOf(addr) + allocSpanHdrWords * 8 + (n / 64) * 8)
  let mask = 1 << (n % 64)
  let _ = atomicAnd(w, ~mask)
}

// Thread a freshly-allocated header onto the all-objects list and bump the
// counters and address bounds under the list lock, so concurrent allocators on
// different workers cannot corrupt the list. Prepends, so the list is
// newest-first — which is what fixes the SWEEP ORDER, and this port keeps it.
@nosplit fn linkObject(g: *i64, h: int, infoAddr: int, total: int, bodyAddr: int) {
  spinAcquire(lockPtr(g))
  storeWord(h + gcHdrInfo, infoAddr)
  storeWord(h + gcHdrNext, *(g + gcAll))
  storeWord(h + gcHdrSize, total)
  storeByte(h + gcHdrMarked, 0)
  *(g + gcAll) = h
  *(g + gcNumObjectsIdx) = *(g + gcNumObjectsIdx) + 1
  *(g + gcStTotalAllocated) = *(g + gcStTotalAllocated) + 1
  noteBody(g, bodyAddr)
  idxInsert(g, bodyAddr)
  setSlotBit(h, allocClassify(total, 8))
  spinRelease(lockPtr(g))
}

// Zero `n` bytes at `addr`. `n` is always a multiple of 8 here (bodies are
// whole words), but the tail is handled bytewise so a raw body size that is not
// word-aligned still zeroes completely.
@nosplit fn zeroBytes(addr: int, n: int) {
  let words = n / 8
  let i = 0
  while (i < words) {
    storeWord(addr + i * 8, 0)
    i = i + 1
  }
  let b = words * 8
  while (b < n) {
    storeByte(addr + b, 0)
    b = b + 1
  }
}

// ---------------------------------------------------------------------------
// THE ALLOCATION DOOR REGISTERS THE CALLING THREAD (#1651)
// ---------------------------------------------------------------------------
//
// `runtime/gc/`'s `currentMutator` carries the reason, and states it as measured
// rather than reasoned:
//
//   CALLED FROM EVERY DOOR INTO THE COLLECTOR — the safepoint poll and all eight
//   allocation sites, via `gcAlloc`/`gcAllocRaw`. The allocation door is the one
//   that matters: a thread registering only at its first safepoint is invisible
//   for the whole window between starting and reaching a loop back edge, and it
//   can allocate in that window — `let keep = []i64(16)` before the first loop is
//   exactly that shape. Another thread collecting there finds no snapshot for
//   this one and sweeps a live object out from under it. Measured, not theorised:
//   it is what made `_tests_/stress/gcthreads*` panic with `index out of range`.
//
// This port had only the SAFEPOINT door until #1650 gave `../gc/gcworld.bit` an
// exact per-OS-thread token; before that there was nothing to key a registration
// on here, which is why the omission was filed rather than fixed.
//
// `currentMutator` is a sibling-file private, reached in-module. It is called
// BEFORE `gcHeapAlloc`, so no lock is held across it: a thread that arrives
// while a stop is pending PARKS here, and parking with the object-list lock in
// hand would deadlock the collector that is waiting for it.
//
// `frame` is 0 — an allocating thread publishes no snapshot, as the
// allocation door passes none. It is registered, so the rendezvous WAITS for it;
// it parks at its next safepoint, where it does have a stack map to publish.
@nosplit fn registerAllocator() {
  let _ = currentMutator(0)
}

// ---------------------------------------------------------------------------
// EXHAUSTION IS FATAL AT THE DOOR (#1642)
// ---------------------------------------------------------------------------
//
// The invariant: the runtime must NEVER hand a null object back to compiled
// code. `runtime/root/`'s allocating doors — `rtGcAlloc`/`allocString`/
// `allocBuf` (root.bit), `rtSliceNew`/`rtSliceSlice` (slices.bit) and
// `rtMapNew`/`allocCtrl` (maps.bit) — used to carry a pre-#1642
// `if (body == 0) { statOom = statOom + 1 }` check and return the null. That
// dated from when a `@nosplit` body could not call `panic`, so `../root/
// root.bit` constraint 3 settled for returning 0 and bumping `statOom`.
// #2750 (root.bit), #3013 (slices.bit) and #3014 (maps.bit) removed those
// checks: every one of those doors now reaches `bit_rt_oom` — through this
// file's own `gcAlloc`/`gcAllocRaw` below — on exhaustion and never returns,
// so none of them can observe a 0 body any more.
//
// That deviation was not merely weaker, it was unsafe. Nothing reads `statOom`
// and codegen does not null-check an allocation result, so exhaustion did not
// surface as a diagnostic — it surfaced as a WRONG-BUT-ALIVE window: string
// interpolations degraded to empty, a well-formed archive read back as garbage
// and was reported as `BadLongName`, and only several `println`s later did a
// null store finally fault. A user files that as a linker bug.
//
// `memOutOfMemory` closes the deviation without touching `@nosplit`: #1640 made
// an `extern function` call legal in a `@nosplit` body, so the door can reach
// the same `fatal` path. It never returns, so the `return 0` below is
// unreachable — see `../gc/mem.bit` for why it is still written.
//
// THE FAILURE MUST NOT BE ABSORBED ANYWHERE EARLIER. `gcHeapAlloc` stays
// fallible on purpose: `gcInit` allocates the mark worklist through it and must
// still be able to report a failed init as `false`, which is what the
// `Gc.init` returning `error{OutOfMemory}` does. The index reserve is likewise
// untouched — a failed index allocation DISABLES the index in both
// implementations, it is not a fatal condition.

// Allocate a managed object of type `infoAddr`. Returns the address of the
// ZEROED object body; heap exhaustion terminates the process rather than
// returning. Never auto-collects: collection happens only at safepoints where
// the roots are known.
//
// The body is zeroed so pointer fields read as null until assigned — required
// by ABI.md §1, because a collection between allocation and initialization must
// never trace garbage.
export @nosplit @symbol("bit_rt_port_gc_alloc") fn gcAlloc(g: *i64, infoAddr: int): int {
  registerAllocator()
  let size = loadWord(infoAddr + gcTiSize)
  let total = gcHeaderSize + size
  let raw = gcHeapAlloc(g, total, 8)
  if (raw == 0) {
    memOutOfMemory()
    return 0
  }
  let body = bodyFromHeader(raw)
  linkObject(g, raw, infoAddr, total, body)
  zeroBytes(body, size)
  return body
}

// Like `gcAlloc`, but for objects whose body size is not fixed by their
// `TypeInfo` (strings, byte buffers). `bodySize` is the real body length;
// `infoAddr` must name a leaf descriptor (empty `ptr_offsets`), because
// `scanObject` never reads `info.size` for one and the descriptor is shared
// across lengths.
//
// Exhaustion is fatal here for the same reason as in `gcAlloc` above, and this
// is the door #1642's repro actually goes through: a growing `[]int` reaches it
// via `bit_rt_slice_append` -> `allocBuf`.
export @nosplit @symbol("bit_rt_port_gc_alloc_raw") fn gcAllocRaw(g: *i64, bodySize: int, infoAddr: int): int {
  registerAllocator()
  let total = gcHeaderSize + bodySize
  let raw = gcHeapAlloc(g, total, 8)
  if (raw == 0) {
    memOutOfMemory()
    return 0
  }
  let body = bodyFromHeader(raw)
  linkObject(g, raw, infoAddr, total, body)
  zeroBytes(body, bodySize)
  return body
}

// ---------------------------------------------------------------------------
// Membership
// ---------------------------------------------------------------------------

// True iff `body` is the body base of a live managed object. Interior and
// foreign pointers return false — the contract (ABI.md §3) requires references
// to point at an object base, and this is how that is checked.
export @nosplit @symbol("bit_rt_port_gc_owns") fn gcOwns(g: *i64, body: int): bool {
  if (*(g + gcIndexOk) == 1) {
    return idxContains(g, body)
  }
  return gcOwnsLinear(g, body)
}

// The authoritative O(objects) membership scan the index mirrors. The fallback
// when the index is unavailable, and the oracle the index is tested against.
export @nosplit fn gcOwnsLinear(g: *i64, body: int): bool {
  let o = *(g + gcAll)
  // Bounded: at most `num_objects` links.
  while (o != 0) {
    if (bodyFromHeader(o) == body) {
      return true
    }
    o = loadWord(o + gcHdrNext)
  }
  return false
}
