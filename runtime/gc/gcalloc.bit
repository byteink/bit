// Split out of ./gc.bit (#1503): allocation and membership.

import { allocSpanClass, allocSpanBitmapWord } from "../alloc"
// An import is per-MODULE, so this one line serves every `runtime/gc` file that
// publishes a back-edge poll request: ./gcworldstop.bit (stop-the-world) and
// ./gc.bit (gcConfigure) as well as this one. Re-importing it in either would
// be E0042.
import { pollRequest } from "../sched"

// ---------------------------------------------------------------------------
// Allocation
// ---------------------------------------------------------------------------

// How many exchanges a bound may lose before it is widened to its extreme
// instead. #5440: the give-up arm is NOT "leave the bound alone" — a bound
// narrower than the live set makes `gcMarkRoot` reject a live root and the
// collector free a reachable object, so the only safe surrender is the widest
// possible value. `0` for the low bound and `gcAddrMax` for the high one cost
// the O(1) reject its precision (every candidate then goes to the exact
// `gcOwns` test) and cost correctness nothing. They are also self-stable: a
// later `noteBody` reading an extreme bound takes its early return and never
// exchanges it back to something narrower.
const gcBoundTries = 64

// Lower `*p` to `want`, or to 0 if the exchange keeps losing. Cold half of
// `noteBody` below; see `worldRaiseHighWater` (`./gcworld.bit`) for the same
// shape on a monotonic counter.
@nosplit fn lowerBound(p: *i64, want: int) {
  let i = 0
  // Bounded: `gcBoundTries` exchanges, then the extreme. Each failed exchange
  // means another allocator moved the bound, and it only ever moves DOWN.
  while (i < gcBoundTries) {
    let cur = atomicLoad(p)
    if (cur <= want) {
      return
    }
    if (atomicCmpxchg(p, cur, want)) {
      return
    }
    i = i + 1
  }
  atomicStore(p, 0)
}

// Raise `*p` to `want`, or to `gcAddrMax` if the exchange keeps losing.
@nosplit fn raiseBound(p: *i64, want: int) {
  let i = 0
  // Bounded, and monotonic upward, for the same reason as `lowerBound`.
  while (i < gcBoundTries) {
    let cur = atomicLoad(p)
    if (cur >= want) {
      return
    }
    if (atomicCmpxchg(p, cur, want)) {
      return
    }
    i = i + 1
  }
  atomicStore(p, gcAddrMax)
}

// Widen the monotonic address window used by `gcMarkRoot`'s O(1) reject.
// Never shrinks on sweep: shrinking only widens the reject
// window slightly and costs nothing in correctness.
//
// #5440: COMPARE-AND-EXCHANGE, NOT A PLAIN READ-MODIFY-WRITE. This ran under
// `linkObject`'s object-list lock, which serialised it; that lock is off the
// small-object path now. Two allocators racing a plain load-compare-store LOSE
// the wider of two widenings — A reads lo=100 and stores 50, B reads the same
// 100 and stores 80, and the object at 50 is now outside the window the mark
// phase trusts. That is a collected live object, not a slow one, which is why
// the exchange loops above surrender to the extreme rather than to no-op.
//
// THE UNCONTENDED PATH IS STILL TWO LOADS AND TWO COMPARES. A bound moves only
// while the heap's address range is growing — a handful of times per program,
// not once per allocation — so the exchange is in a cold callee and the hot
// path pays no atomic at all.
@nosplit fn noteBody(g: *i64, addr: int) {
  let lo = g + gcLoAddr
  if (addr < *lo) {
    lowerBound(lo, addr)
  }
  let hi = g + gcHiAddr
  if (addr + 1 > *hi) {
    raiseBound(hi, addr + 1)
  }
}

// ---------------------------------------------------------------------------
// #3147/#3176: the span's own occupied-slot bitmap
// ---------------------------------------------------------------------------
//
// #3177: `gcOwns` now reads this for every span-backed query, below. Set and
// cleared at the SAME two call sites `idxInsert`/`idxRemove` already use
// (`linkObject` below, `freeObject` in `./gcmark.bit`), never inside
// `runtime/alloc/`'s take/give: `gcInit`'s mark worklist allocates straight
// through `gcHeapAlloc` without ever reaching `linkObject` (design note in
// `./gcindex.bit`), and only THIS layer knows that take is not a real object.
//
// `idx` is recomputed from `size`/`alignment` with the SAME pure
// `allocClassify` call `gcHeapAlloc`/`gcHeapFree` already made internally
// (alignment is always 8 for a GC object), so this needs no read of the
// allocator's own span state and no lock at all. `idx < 0` is the
// large/direct-mapped path — not span-backed, so the bitmap does not apply and
// both helpers below no-op.
//
// ATOMIC READ-MODIFY-WRITE, AND #4320's STANDING OBLIGATION IS WHY (#5440).
// #4320 made this a plain `*w = *w | mask` on an argument that was explicit
// about what it rested on: "`linkObject` -> `setSlotBit` runs between
// `spinAcquire(lockPtr(g))` and `spinRelease(lockPtr(g))`, so two sets can
// never overlap", with the obligation that "if that lock is ever removed, the
// atomicity must come back here". #5440 removed that lock from the small-object
// path, so the atomicity is back, exactly as promised. The premise it rested on
// is now false and two mutators DO concurrently set two bits in one 64-bit
// bitmap word: a span's slots are handed out to whichever threads ask, and
// #5436's per-thread slot cache refills 64 at a time from a shared free list.
// A lost `|` is a live object with no bit, which `./gcwalk.bit` never
// enumerates and `sweep` never frees — a leak — and worse, `gcOwns` answers
// false for it, so a reference to it is not traced.
//
// THE OTHER BIT-WRITING CALL SITE STILL NEEDS NOTHING, and its argument never
// rested on the lock. `gcVisitWord`'s batched clear (`./gcwalk.bit`) is reached
// only through `sweep`/`gcDeinit`, which have exactly two callers: `sweep`,
// reached only from `gcCollectFinish` inside `stwCollect` (`../stw/stw.bit`)
// AFTER `worldRendezvous` returned true — every other mutator parked and
// acknowledged this epoch, and `linkObject` is `@nosplit` with no poll in it,
// so no thread can be inside it — and `gcDeinit` (`./gc.bit`), at shutdown. An
// expired rendezvous ABANDONS rather than collecting (`../stw/stwpoll.bit`), so
// there is no forced-collection arm. `../alloc/spancache.bit`'s
// `heapSpanCacheTakeLocked` writes these same words with plain full-word stores
// under the HEAP lock, and may: the span it is zeroing came off the span cache
// with every slot free, so no slot of it is in any thread's hand yet.
//
// WHAT THE ATOMIC DOES NOT BUY IS ORDERING, and #4320 was right about that.
// The only off-stop-the-world reader, `gcOwns` below via `dynTypeOf`
// (`../root/iface.bit`), reads through `allocSpanBitmapWord`
// (`../alloc/bitmap.bit`), which is a plain load with no acquire — a release
// here would pair with nothing. This is wanted for the single-word atomicity of
// the `|` and for nothing else.
@nosplit fn setSlotBit(addr: int, idx: int) {
  if (idx < 0) {
    return
  }
  let n = allocSlotIndex(addr, idx)
  if (n < 0) {
    return
  }
  // n >= 0 is proven above (the `n < 0` guard returns), so `n / 64` and
  // `n % 64` are `n >> 6` and `n & 63` — #4317, the #3898 lesson applied here.
  let w = wordAt(allocSpanOf(addr) + allocSpanHdrWords * 8 + (n >> 6) * 8)
  let mask = 1 << (n & 63)
  let _ = atomicOr(w, mask)
}

// Publish a freshly-allocated header to the collector: write its own header
// words, bump the two shared counters, widen the address window, set its
// occupied-slot bit, and — for a large object only — thread it onto the large
// list and the hash index under the list lock. Prepends, so that list is
// newest-first — which is what fixes the SWEEP ORDER, and this port keeps it.
//
// #5440: THE SMALL PATH TAKES NO LOCK. It opened with `spinAcquire(lockPtr(g))`
// and held it to the end, which made ONE address in the process-wide GC block a
// serialization point for every allocation by every thread. Once #5436 batched
// `heapLock` off this path that was the whole remaining convoy: `sample` of
// `pkg/web/bench/apps/bit` at 8 workers, c=16, ranked `bit_rt_spin_acquire` the
// top leaf at 29,560 samples, 27,567 of them under this function against 1,987
// under `gcHeapAlloc`. The four things it protected are now protected
// individually, and the lock is kept for exactly the one that needs it:
//
//   the two header stores — the object is reachable by no other thread yet, so
//   they need nothing and never did;
//   `gcNumObjectsIdx` — `atomicAdd`. It is only ever decremented or reset from
//   stop-the-world code (`gcVisitSlot` in `./gcwalk.bit`, `gcInit`), and every
//   reader is a plain aligned 64-bit load, which does not tear. `#5440` bumped
//   `gcStTotalAllocated` here the same way; #5454 removed that one outright by
//   deriving the statistic, see the single `atomicAdd` below;
//   `noteBody` — a compare-and-exchange per bound, see its own header;
//   `setSlotBit` — `atomicOr`, which is #4320's standing obligation coming due;
//   the `idx < 0` arm — KEEPS THE LOCK. The large list head and `idxInsert`'s
//   open-addressed table are genuinely shared mutable structure with no atomic
//   form, and large allocations are rare enough that serializing them costs
//   nothing measurable. `idxInsert`/`idxRemove` (`./gcindexmutate.bit`) are the only
//   other holders of this lock and both are on that same large path, so its
//   mutual exclusion is unbroken — it simply no longer covers the small path.
//
// #5710: BOTH ATOMICS WERE PRICED FOR PER-THREAD OWNERSHIP AND BOTH ARE
// STAYING. They were measured at their CEILING — each replaced by a plain
// read-modify-write, which no ownership scheme can beat, since owning a word
// costs a private slot, a charge and a flush ON TOP of the plain add — and the
// ceiling is not a win in either regime this suite has an instrument for.
//
//   `bench/cases/alloc`, one mutator, IPC ~7.7, so instructions are the
//   currency and the whole prize is ONE of them per object: this function goes
//   62 -> 60 instructions, `setSlotBit` above goes 37 -> 38 (a plain `|` is a
//   load, an `orr` and a store where `ldsetal` is one instruction), and the
//   pair measures -0.14% instructions and -0.55% cycles against a null control
//   — two builds with a byte-identical `__TEXT,__text` — spreading 0.39%.
//
//   `bench/cases/allocpar`, 8 mutators, IPC ~2.0, so stalls are the currency:
//   deleting the `atomicAdd` below and charging NOTHING in its place measured
//   27.5G and 27.2G cycles against this tree's 24.3G and 24.1G, two
//   independent interleaved passes, at equal instructions (46-48G both sides)
//   and equal collector work (162 collections against 161, `BIT_GC_STATS=1`).
//   A contended `ldaddal` completes as ONE far-atomic operation; the load, add
//   and store that would replace it take the line exclusive twice and can lose
//   it in between. Under contention the atomic is the cheap form, not the
//   expensive one — which is also why the 16-18 ns figure above prices a
//   contended atomic and not the saving from removing one.
//
// `setSlotBit` CANNOT MOVE ITS BIT TO THE BATCH REFILL, and the blocker is not
// two batches straddling one bitmap word. A bit set when a slot is spliced
// into a thread's cache (`allocCacheFillLocked`, `./gcalloccache.bit`) marks a
// slot that holds no object yet, and `./gcwalk.bit` enumerates the whole small
// population from exactly these bits: `sweep` would read a free-list link as a
// header and free a slot its owner is still holding. Correct only if every
// cache were drained at every stop-the-world — a collection-time cost paid to
// remove an instruction the paragraph above measures as free.
//
// NOTHING HERE IS ORDERED AGAINST A CONCURRENT COLLECTOR, and nothing needs to
// be: this function is `@nosplit` with no poll in it, so a thread inside it
// cannot acknowledge a stop-the-world epoch, and `worldRendezvous` therefore
// cannot return true until every allocator has left. Mark and sweep see whole
// `linkObject`s or none, exactly as they did under the lock.
//
// #3178: THE HASH INDEX ONLY TRACKS LARGE (NOT SPAN-BACKED) OBJECTS NOW.
// `gcOwns` (`gcOwns` below) has answered every span-backed address from
// #3176's per-span bitmap since #3177 — `idxContains(g, body)` was never
// read for one — so inserting its body key here bought nothing but table
// growth (`idxGrow`'s `24 x cap`, #3147). `idx < 0` is exactly
// `allocClassify`'s large/direct-mapped case (`./classify.bit`, `needed >
// allocMaxSmall`); a large object has no span to hold a bitmap, so it keeps
// going through the hash path exactly as before (#3175's design,
// `./gcindex.bit`). `setSlotBit` still runs unconditionally — it already
// no-ops for `idx < 0` (its own `if (idx < 0) { return }`) — so span-backed
// objects lose only the redundant hash entry, never the bitmap bit.
//
// #4043: `idx` IS A PARAMETER NOW. This function's own comment used to defend
// recomputing it — "no extra heap state or lock" — which was true and cost
// `allocClassify` a second time on the same `(total, 8)` the caller had already
// classified one frame earlier to reach `gcHeapAlloc`. `allocObject` computes
// it once and hands it to both. No state and no lock were needed to do that: it
// is an argument, not a cache.
//
// `bodyAddr` WAS a sixth parameter and is now derived: `bodyFromHeader(h)` is
// `h + gcHeaderSize`, one add, against a parameter every caller had to pass
// and E0202's five-param limit had to be widened for.
@nosplit fn linkObject(g: *i64, h: int, infoAddr: int, total: int, idx: int) {
  let bodyAddr = bodyFromHeader(h)
  storeWord(h + gcHdrInfo, infoAddr)
  // `total` is positive, so this one store writes the size AND leaves the mark
  // clear (#4083). The separate mark store is gone, not moved.
  storeWord(h + gcHdrSize, total)
  // #5454: ONE atomic here, not two. `gcStTotalAllocated` was the second, and
  // it is now derived (`gcStatTotalAllocated`, `./gccollect.bit`) from this
  // count plus the free count `gcVisitSlot` keeps under the stopped world. A
  // contended `ldaddal` costs 16-18 ns on this host against 0.1-0.6 ns for a
  // plain read-modify-write on an uncontended line, so the one that had no
  // reader outside a statistic was the one to delete rather than to shard.
  let _ = atomicAdd(g + gcNumObjectsIdx, 1)
  noteBody(g, bodyAddr)
  // #4059: A SMALL OBJECT IS RECORDED ONLY BY `setSlotBit` BELOW. The global
  // all-objects list is gone; `./gcwalk.bit` enumerates the small population
  // straight out of the per-span occupied-slot bitmap this already maintains,
  // which is what frees header word 8 for #4086.
  //
  // A LARGE ONE HAS NO SPAN AND SO NO BIT, so it keeps a list -- link word in
  // the prologue `gcHeapAlloc` mapped in front of the header, NOT in the header
  // itself (`gcLargePrologue`, `./gc.bit`). Same `idx < 0` gate the hash-index
  // insert below already uses, so the two records cannot disagree about which
  // population an object is in.
  if (idx < 0) {
    spinAcquire(lockPtr(g))
    storeWord(h - gcLargePrologueLink, *(g + gcLargeAll))
    *(g + gcLargeAll) = h
    idxInsert(g, bodyAddr)
    spinRelease(lockPtr(g))
  }
  setSlotBit(h, idx)
}

// Zero `n` bytes at `addr`. `n` is always a multiple of 8 here (bodies are
// whole words), but the tail is handled bytewise so a raw body size that is not
// word-aligned still zeroes completely.
//
// FOUR WORDS PER ITERATION, WITH THE 0-3 REMAINDER PEELED (#4045). The old
// shape was one word per iteration, indexed as `storeWord(addr + i * 8, 0)`,
// which recomputed the address from scratch every time: `lsl`+`add`+`and`+`mov`
// per store, on top of a three-instruction loop head. Measured on the emitted
// `_zeroBytes` for the 24-byte body of `bench/cases/alloc`'s `Node`, that was
// 51 executed instructions for 3 stores; this shape is 32, and a 1024-byte body
// goes 1551 -> 506.
//
// The three source-level changes that buy it, in order of what each removes:
//
//   1. `p` is a `*i64` walked forward, not an index re-scaled per store. The
//      `and` that `wordAt` costs is then paid ONCE, hoisted out of the loop,
//      instead of once per word.
//   2. `z` holds the zero. The backend rematerialises a literal `0` into a
//      register before EVERY store (there is no constant CSE yet), so a live
//      variable is what keeps `mov xN, #0` out of the loop body.
//   3. Four stores per iteration, remainder peeled by bit test. Loop overhead —
//      the `cmp`/`b.cc`/`b` head plus the loop-carried copies — is 7 of the 12
//      instructions a one-word iteration costs, so it is the dominant term
//      until the body does real work.
//
// `>> 3` and `<< 3`, NOT `/ 8` and `* 8` (#3898, and see `./mem.bit`'s header):
// `/` is a SIGNED division and pays a three-instruction bias correction
// (`asr #63`, `lsr #61`, `add`) that a shift does not. `n` is never negative.
//
// THE BYTEWISE TAIL STAYS AND MUST: `gcAllocRaw` passes a raw `bodySize` — a
// string length — which is not word-aligned, and ABI.md §1 requires the body to
// be FULLY zeroed before the allocator returns, so a collection landing between
// the allocation and the field stores never traces an uninitialised word as a
// reference. Rounding `n` up to a whole word would write outside the requested
// body; not zeroing the last bytes would leave the collector a garbage pointer.
// Neither is a trade this function may make.
@nosplit fn zeroBytes(addr: int, n: int) {
  let z = 0
  let p = wordAt(addr)
  let w = n >> 3
  let q = w >> 2
  while (q > z) {
    *p = z
    *(p + 1) = z
    *(p + 2) = z
    *(p + 3) = z
    p = p + 4
    q = q - 1
  }
  if ((w & 2) != z) {
    *p = z
    *(p + 1) = z
    p = p + 2
  }
  if ((w & 1) != z) {
    *p = z
    p = p + 1
  }
  let b = w << 3
  while (b < n) {
    storeByte(addr + b, 0)
    b = b + 1
  }
}

// ---------------------------------------------------------------------------
// REGISTRATION IS EAGER AT OS-THREAD ENTRY, NOT PER ALLOCATION (#4060)
// ---------------------------------------------------------------------------
//
// This door used to open with `registerAllocator()` — `currentMutator(0)`,
// i.e. `mutatorSlot(worldBlockAddr(), 0, true)` — on EVERY allocation. What
// that established is worth stating exactly, because it is a soundness
// property and not a nicety: the calling OS thread is present in the mutator
// registry with its real stack top and base published
// (`worldSetStackTop`/`worldSetStackBase`, `../gc/gcworld.bit`) before it
// can hold the sole reference to a fresh object. Two consumers depend on it —
// the stop-the-world rendezvous (`worldStoppedFor`, `./gcworldstop.bit`, which
// counts an UNCLAIMED slot as stopped and therefore never waits for it) and
// the root scan (`stwScanOwnStack`, which needs the published range). An
// unregistered allocator is a stack neither waited for nor scanned; ABI.md §5
// records #1677's reproducer sweeping such an object 20/20 runs.
//
// THE PAYLOAD FIRES EXACTLY ONCE PER THREAD, AND WAS PAID ONCE PER OBJECT.
// `mutatorSlot` claims, publishes and (only on that first claim) parks on a
// pending stop. On every later call it re-verifies a fact that cannot have
// changed — a slot is released only by `gcThreadExit`, on that same thread's
// own exit path — for one `bl` into a function whose prologue spills x19-x28,
// one `ldar`, and the `bl bit_rt_port_gc_world_addr` beside it. Measured at
// **79 instructions and 11-15 cycles per object** on `bench/cases/alloc`.
//
// So the registration moved to where it belongs: the entry point of every OS
// thread that can run allocating Bit code, which is Go's shape (a P owns its
// mcache, so thread identity is structural). Every such thread now registers
// before its first Bit statement:
//
//   - scheduler workers, and the ones `../sched/grow.bit` adds later:
//     `workerBody`'s first statement is `gcThreadEnter()`
//     (`../root/{linux,darwin}/bootworker.bit`, `../root/windows/boot.bit`),
//     eager since #1677/#1699.
//   - raw OS threads started through `../thread/<os>`'s `threadStart`: the
//     provider owns the child's entry and now calls `gcThreadEnter()` there,
//     symmetrically with the `bit_rt_gc_thread_exit()` it already made at the
//     child's exit (#1801/#1846). `_tests_/stress/thread/gcprops`'s `gcChild`
//     is the in-tree program that needs this: its first statement is
//     `let keep = []i64(16)`, an allocation before any back edge, which is
//     the exact shape the old note here named.
//   - the boot thread: allocates nothing managed at any point (the argument is
//     in `../root/darwin/boot.bit`'s header) and registers through
//     `gcBlockingBegin` around its step-7 sleep.
//   - sysmon: `@nosplit` end to end, never touches the heap, and must NEVER
//     register — `../root/linux/sysmon.bit` states why. Unchanged by this.
//
// WHAT IS NO LONGER COVERED, stated rather than discovered later: a thread
// this runtime did not create. ABI.md §5/§6 already puts
// `bit_rt_gc_thread_enter` on such a caller as an obligation, and nothing in
// this tree creates one (`../thread/<os>`'s `threadStart` is the only thread
// primitive and a Bit binary embeds no foreign thread source). Before this
// change the allocation door caught it and degraded the failure from "a live
// object is swept" to "collections are abandoned"; it no longer does.

// ---------------------------------------------------------------------------
// EXHAUSTION IS FATAL AT THE DOOR (#1642)
// ---------------------------------------------------------------------------
//
// The invariant: the runtime must NEVER hand a null object back to compiled
// code. `runtime/root/`'s allocating doors — `rtGcAlloc`/`allocString`/
// `allocBuf` (root.bit), `rtSliceNew`/`rtSliceSlice` (slices.bit) and
// `rtMapNew`/`allocCtrl` (maps.bit) — used to carry a pre-#1642
// `if (body == 0) { statOom = statOom + 1 }` check and return the null. That
// dated from when a `@nosplit` body could not call `panic`, so `../root/
// root.bit` constraint 3 settled for returning 0 and bumping `statOom`.
// #2750 (root.bit), #3013 (slices.bit) and #3014 (maps.bit) removed those
// checks: every one of those doors now reaches `bit_rt_oom` — through this
// file's own `gcAlloc`/`gcAllocRaw` below — on exhaustion and never returns,
// so none of them can observe a 0 body any more.
//
// That deviation was not merely weaker, it was unsafe. Nothing reads `statOom`
// and codegen does not null-check an allocation result, so exhaustion did not
// surface as a diagnostic — it surfaced as a WRONG-BUT-ALIVE window: string
// interpolations degraded to empty, a well-formed archive read back as garbage
// and was reported as `BadLongName`, and only several `println`s later did a
// null store finally fault. A user files that as a linker bug.
//
// `memOutOfMemory` closes the deviation without touching `@nosplit`: #1640 made
// an `extern function` call legal in a `@nosplit` body, so the door can reach
// the same `fatal` path. It never returns, so the `return 0` below is
// unreachable — see `../gc/mem.bit` for why it is still written.
//
// THE FAILURE MUST NOT BE ABSORBED ANYWHERE EARLIER. `gcHeapAlloc` stays
// fallible on purpose: `gcInit` allocates the mark worklist through it and must
// still be able to report a failed init as `false`, which is what the
// `Gc.init` returning `error{OutOfMemory}` does. The index reserve is likewise
// untouched — a failed index allocation DISABLES the index in both
// implementations, it is not a fatal condition.

// Allocate a managed object of type `infoAddr`. Returns the address of the
// ZEROED object body; heap exhaustion terminates the process rather than
// returning. Never auto-collects: collection happens only at safepoints where
// the roots are known.
//
// The body is zeroed so pointer fields read as null until assigned — required
// by ABI.md §1, because a collection between allocation and initialization must
// never trace garbage.
export @nosplit @symbol("bit_rt_port_gc_alloc") fn gcAlloc(g: *i64, infoAddr: int): int {
  let size = loadWord(infoAddr + gcTiSize)
  return allocObject(g, infoAddr, gcHeaderSize + size, size)
}

// The whole of `gcAlloc` and `gcAllocRaw`. They differ only in where the body
// length comes from — a `TypeInfo` field or an argument — and were otherwise
// the same eight lines twice.
//
// THE SIZE CLASS IS COMPUTED HERE AND NOWHERE ELSE ON THE ALLOCATION PATH
// (#4043). `gcHeapAlloc` needs it to pick a free list and `linkObject` needs it
// to address the occupied-slot bitmap; both used to derive it independently
// from the same `(total, 8)`. It is one value, so it is computed once and
// passed down.
@nosplit fn allocObject(g: *i64, infoAddr: int, total: int, bodySize: int): int {
  let idx = allocClassify(total, 8)
  // THIS THREAD'S CACHE ENTRY, RESOLVED ONCE (#5472). Two things below want it
  // — the free-slot cache inside `gcHeapAlloc` and the trigger budget at the
  // bottom — and it is 0 for every program that has never contended for the
  // heap lock, which is what keeps the single-mutator path the one it was.
  let entry = allocCacheArm(g)
  let raw = gcHeapAlloc(g, total, 8, idx, entry)
  if (raw == 0) {
    memOutOfMemory()
    return 0
  }
  let body = bodyFromHeader(raw)
  linkObject(g, raw, infoAddr, total, idx)
  zeroBytes(body, bodySize)
  // #4203: THE ALLOCATION DOOR IS THE ONLY PLACE THE GC TRIGGER CAN BECOME
  // TRUE, so it is where the back-edge poll's request is published. `heapLive`
  // and `gcNumObjectsIdx` rise here and nowhere else; a free only lowers them
  // and a collection only raises the trigger they are compared against, so no
  // other writer can turn `gcShouldCollect` from false to true.
  //
  // This does NOT collect — collection still happens only at a safepoint, where
  // the roots are precise (this door has no stack map, see `stwPollOn`'s note
  // on `currentMutator`). It records the fact so the next back edge can act on
  // it in three instructions instead of re-deriving it in eighteen.
  //
  // The predicate is the real `gcShouldCollect`, not the byte half alone: the
  // byte trigger on its own is crossed for as long as the object trigger has
  // not caught up (#3359), and requesting on it would put the whole locked slow
  // path on every back edge in that window — exactly the cost this ticket is
  // removing. On the overwhelmingly common path it is three loads and a
  // compare, against an allocation that has just taken a lock, linked an
  // object, and zeroed a body.
  //
  // THE PREDICATE IS THE SAME ONE; ONLY HOW OFTEN IT IS ASKED CHANGED (#5472).
  // Its first load is `heapLiveBytes`, an acquire load of the word every
  // allocating thread also atomically adds to, so on a single mutator it is
  // three loads and on N mutators it is N threads taking turns on one dirty
  // line. A thread with an entry charges a private budget instead and reaches
  // the shared words only when that budget runs out; a thread without one —
  // every program that has never contended, which is every single-mutator
  // program in the corpus — asks exactly what it asked before, on exactly the
  // allocations it asked on.
  if (entry == 0) {
    if (gcShouldCollect(g)) {
      pollRequest()
    }
  } else if (gcAllocBudgetSpend(g, entry, total)) {
    pollRequest()
  }
  return body
}

// Like `gcAlloc`, but for objects whose body size is not fixed by their
// `TypeInfo` (strings, byte buffers). `bodySize` is the real body length;
// `infoAddr` must name a leaf descriptor (empty `ptr_offsets`), because
// `scanObject` never reads `info.size` for one and the descriptor is shared
// across lengths.
//
// Exhaustion is fatal here for the same reason as in `gcAlloc` above, and this
// is the door #1642's repro actually goes through: a growing `[]int` reaches it
// via `bit_rt_slice_append` -> `allocBuf`.
export @nosplit @symbol("bit_rt_port_gc_alloc_raw") fn gcAllocRaw(
  g: *i64,
  bodySize: int,
  infoAddr: int,
): int {
  return allocObject(g, infoAddr, gcHeaderSize + bodySize, bodySize)
}

// ---------------------------------------------------------------------------
// Membership
// ---------------------------------------------------------------------------

// True iff `body` is the body base of a live managed object. Interior and
// foreign pointers return false — the contract (ABI.md §3) requires references
// to point at an object base, and this is how that is checked.
//
// #3854: REJECT A NON-8-ALIGNED QUERY BEFORE EITHER MEMBERSHIP PATH RUNS.
// ABI.md §1 ("Object base is 8-aligned; body is therefore 8-aligned") makes
// this exact, not conservative — no legitimate query is ever rejected. It
// exists for `./gcindex.bit`'s span-presence keys (`idxInsertSpan`/
// `idxRemoveSpan`): those are tagged `spanAddr + 1`, deliberately NOT
// 8-aligned, so a live object body can never collide with one. But the tag
// alone is not enough — the tagged literal is itself computed into a
// register or stack slot around the insert/remove call and can leak onto the
// stack as an ordinary conservative-scan candidate later, exactly like any
// other stale word. PROVEN, not assumed (#3854/#3388): tagging with no query
// guard still faulted `bench/cases/json` 16/16, with the fault address
// tracking the tag exactly (`spanBase + 1`) across three ASLR-enabled runs.
// Only tagging PLUS this guard reached 32/32 clean. Guard the query, not the
// entries — the table's reader is a boolean membership predicate with no way
// to tell which population a hit came from, so rejecting bad queries at the
// door is the only place this can be fixed.
//
// #3177: SPAN-BACKED ADDRESSES ANSWER FROM THE #3176 BITMAP, NEVER FROM
// `idxContains`/`gcOwnsLinear`. `allocSpanOf`/`allocSlotIndex` work in the
// allocator's own SLOT-BASE space, which is the HEADER address, not the
// body — `setSlotBit` above passes `h` for exactly this reason,
// and `linkObject`'s `h` is literally the raw address the allocator handed
// back. So the query is converted the same way BEFORE either is called:
// `headerFromBody(body)`. `allocSpanOf` is a pure mask (no dereference), so
// it is safe to compute for any integer, including a wholly foreign one. The
// presence check `idxContains(g, span + 1)` gates every read that DOES
// dereference the span (`allocSpanClass`, `allocSlotIndex`, the bitmap word)
// — exactly the O(1) "is this address inside a currently-mapped span"
// structure finding 1 of the reverted attempt (`./gcindex.bit`) said the
// runtime had no way to answer; the tagged presence key #3854 landed is it.
// Only when that gate is false (large object or foreign address — no owning
// span is currently carved) does the query fall to the object-key table /
// linear oracle, exactly as it did before this ticket. `cls < 0` covers a
// span mid-reclaim (`heapReclaimSpansLocked` marks it doomed before the
// caller removes its presence key) as a defensive belt, avoiding an
// `allocClassSize(-1)` misclassification. NOT because an empty span
// (`spanFree == spanTotal`) always reads an all-zero bitmap regardless — it
// does only for the class it currently holds. #3925: a span re-carved out of
// the #3045 cache for a DIFFERENT class can start that new class with a
// dirty bitmap (fixed at `heapSpanCacheTakeLocked`, `../alloc/spancache.bit`,
// not here — this belt covers the doomed-but-not-yet-recarved window only).
export @nosplit @symbol("bit_rt_port_gc_owns") fn gcOwns(g: *i64, body: int): bool {
  if ((body & 7) != 0) {
    return false
  }
  let h = headerFromBody(body)
  let span = allocSpanOf(h)
  if (idxSpanPresent(g, span)) {
    let cls = allocSpanClass(span)
    if (cls < 0) {
      return false
    }
    let n = allocSlotIndex(h, cls)
    if (n < 0) {
      return false
    }
    // n >= 0 is proven above (the `n < 0` guard returns) -- see setSlotBit.
    let w = allocSpanBitmapWord(span, n >> 6)
    return (w & (1 << (n & 63))) != 0
  }
  if (*(g + gcIndexOk) == 1) {
    return idxContains(g, body)
  }
  return gcOwnsLinear(g, body)
}

// The authoritative membership scan the index mirrors. The fallback when the
// index is unavailable, and the oracle the index is tested against.
//
// #4059: DERIVED FROM THE HEAP'S OWN STRUCTURE, NOT FROM A SIDE LIST, and the
// four answers `./gcindex.bit`'s design note pins are unchanged:
//
//   - EXACT BASE of a live object: true. Small -- the span is carved, the slot
//     index is exact and its bit is set. Large -- it is on the large list.
//   - INTERIOR: false. `allocSlotIndex` returns -1 for any address that is not
//     an exact slot base (its remainder check, `../alloc/bitmap.bit`), and the
//     large list holds bases and is compared by equality.
//   - FREED: false. `freeObject` clears the slot bit before the allocator gets
//     the slot back, and unlinks the large object before unmapping it.
//   - FOREIGN: false. Its span is on no class list, and it is on no list.
//
// It also keeps the one exclusion the list gave for free: `gcInit`'s mark
// worklist allocates straight through `gcHeapAlloc` without ever reaching
// `linkObject`, so no bit is ever set for it and it is on no list -- false,
// exactly as before.
//
// O(spans) rather than O(all objects), so the disabled-index degradation
// `idxDisable` documents (27x-494x, #3930) gets strictly less bad. It is still
// the slow path and still not one to rely on.
export @nosplit fn gcOwnsLinear(g: *i64, body: int): bool {
  if ((body & 7) != 0) {
    return false
  }
  let h = headerFromBody(body)
  let span = allocSpanOf(h)
  let cls = gcSpanCarvedClass(g, span)
  if (cls >= 0) {
    let n = allocSlotIndex(h, cls)
    if (n < 0) {
      return false
    }
    return (allocSpanBitmapWord(span, n >> 6) & (1 << (n & 63))) != 0
  }
  let o = *(g + gcLargeAll)
  // Bounded: one link per large object.
  while (o != 0) {
    if (bodyFromHeader(o) == body) {
      return true
    }
    o = loadWord(o - gcLargePrologueLink)
  }
  return false
}
