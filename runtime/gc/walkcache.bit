// The alloc cache past a thread's home entry (#7139), split out of
// ./gcalloccache.bit, which holds the entry layout and the home hit.
//
// THIS FILE SORTS AFTER EVERY OTHER FILE OF THE MODULE ON PURPOSE. A module's
// functions are emitted file by file in name order, and the linker places them
// in that order behind the archive members before this one, so code added to
// ./gcalloccache.bit moves every function emitted after it, the allocator's
// and the sweep's hottest among them (./gcheap.bit, ./gcwalk.bit). Here the
// walk and its two test hooks move no function of this module; what they
// still move is the archive members linked after it (#7139).

// `allocCacheEntry` past the home entry: this thread's entry among the other
// `acProbes - 1` when it is bound to `g`'s heap, else `allocCacheProbe`, which
// starts again at probe 0, so the answer is the one its loop alone gives. AN
// ENTRY IS NEVER RELEASED, so the positions before this thread's own stay
// owned by other threads and the walk always reaches it: the claim walked the
// same positions in the same order. Before #7139 such a thread took
// `allocCacheProbe` and, from it, `allocCacheFor` on every allocation; this is
// one call with no exchange and no store.
@nosplit fn allocCacheWalk(g: *i64, token: int, home: int): int {
  let base = int(ptrOf(allocCacheBlock))
  let i = 1
  // Bounded: `acProbes - 1` iterations.
  while (i < acProbes) {
    let addr = base + ((home + i) & (acEntries - 1)) * acEntryBytes
    let e = wordAt(addr)
    if (atomicLoad(e + acOwner) == token && *(e + acHeap) == *(g + gcHeapAddr)) {
      return addr
    }
    i = i + 1
  }
  let found = allocCacheProbe(g, token, home)
  if (found != 0) {
    let e = wordAt(found)
    *(e + acSlow) = *(e + acSlow) + 1
  }
  return found
}

// The `acSlow` count of `token`'s entry, or -1 when it holds none. For
// `_tests_/stress/thread/alloccollide`, which proves a thread whose home another
// thread holds never takes `allocCacheProbe` once its entry is bound.
export @nosplit fn gcAllocCacheSlowHits(token: int): int {
  let home = allocCacheHome(token)
  let i = 0
  // Bounded: exactly `acProbes` iterations.
  while (i < acProbes) {
    let idx = (home + i) & (acEntries - 1)
    let e = wordAt(int(ptrOf(allocCacheBlock)) + idx * acEntryBytes)
    if (atomicLoad(e + acOwner) == token) {
      return *(e + acSlow)
    }
    i = i + 1
  }
  return -1
}

// Claim or find `token`'s entry for `g`'s heap, exactly as the thread whose
// token it is would. The hook that lets one thread take another's home
// (`_tests_/stress/thread/alloccollide`).
export @nosplit fn gcAllocCacheClaimFor(g: *i64, token: int): int {
  return allocCacheProbe(g, token, allocCacheHome(token))
}
