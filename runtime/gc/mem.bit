// Raw-memory primitives and the page reserve the collector (`./gc.bit`, #1363)
// is built on. Sibling file, so the same module — no import needed.
//
// WHY A RESERVE EXISTS
// --------------------
// `runtime/alloc/alloc.bit` (#1362) is the real allocator and the collector
// calls it, exactly as `gc.zig` calls `alloc.zig`. But that port pushed the OS
// page fetch OUT to its caller on purpose: `syscall` is Linux-only and
// `extern function` Darwin-only, and both are rejected on the DECLARATION, so a
// module containing either cannot compile for the other target. The allocator's
// core is therefore platform-free and `heapRefillLocked` takes a span address
// rather than calling mmap.
//
// The collector inherits that constraint unchanged. Bit has no function
// pointers in the unmanaged subset, so a platform-free `gc.bit` cannot be
// handed a page-mapping CALLBACK — the only thing it can be handed is MEMORY.
// So the caller maps pages (binding `runtime/alloc/linux` or
// `runtime/alloc/darwin`, whichever its target wants) and hands the collector a
// contiguous reserve; the collector bumps spans out of it to refill size
// classes. That keeps `gc.bit` compiling for all three targets while the real
// size-class allocator does all the actual allocation policy.
//
// The reserve is bump-only: it never takes memory back. That matches the Zig,
// where a span, once carved into a size class, is never unmapped either
// (`alloc.zig` unmaps only direct-mapped LARGE blocks). Reclaimed object memory
// is recycled by the allocator's free lists, not by the reserve, so a churning
// program is bounded by its live set exactly as it is in the Zig.
//
// WHAT THE RESERVE IS NOT: A CAP (#1638)
// --------------------------------------
// It was one, and that was a bug, not a design. `boot` mapped a single fixed
// 8 MiB arena, `reserveTake` returned 0 the moment the bump hit its end, and
// nothing anywhere mapped another page — so the heap's capacity was a compile
// time constant while `alloc.zig`'s is the machine's. Four 2 MiB slices was
// enough to hit it; the first succeeded and the rest silently came back null.
//
// The fix is not a larger constant — that only moves the cliff. `reserveGrow`
// below restores the Zig's actual behaviour: when the reserve cannot satisfy a
// request, map a fresh chunk from the OS and bump out of that instead. The
// reserve becomes what its name says, a batching buffer over `mapPages`, and
// the boot arena becomes merely the first chunk.
//
// A DISCONTIGUOUS HEAP IS SAFE, and that is worth stating because a bump arena
// invites the opposite assumption. Nothing in the collector requires one span:
// `gcLoAddr`/`gcHiAddr` (../gc/gcalloc.bit) is a monotonic min/max REJECT
// window that is allowed to span holes, the address->object index is a hash
// table keyed on the exact body address, and `heapRefillLocked` already takes
// an arbitrary span address. Chunks are simply new spans in a different place.
//
// Everything here is `@nosplit` (§10.3): it is the memory the collector and
// allocator are built on, so it must not allocate through the managed heap and
// must not reach a safepoint.

// A reserve descriptor is three words: base, end, bump.
export const reserveWords = 3
const resBase = 0
const resEnd = 1
const resBump = 2

// The `*i64` addressing the 8-aligned machine word at `addr`. `*i64` arithmetic
// scales by 8, so stepping that many elements off the null pointer lands
// exactly on `addr` (§11.4). This is the inverse of `int(p)` and the only way
// to turn an address back into a pointer — Bit has no pointer-to-pointer cast.
//
// `addr` MUST be 8-aligned. Every address the collector fabricates is: object
// bases come from the allocator (page-aligned spans carved into 8-multiple
// classes) and every offset added to one is a multiple of 8.
//
// PINNED (ABI.md §9). A sibling runtime object spells a cross-module call by the
// callee's emitted symbol, and an unpinned export is emitted as `m<N>$name`
// where N is assigned by the IMPORTING build — a name no separately emitted
// object can ever define. `runtime/root` calls these, so they must be pinned or
// its freestanding emit is refused (SPEC §11.9).
//
// The `bit_rt_port_` prefix is deliberate and TEMPORARY, for the same reason
// `../root/root.bit` carries `bit_rt_root_`: `root.zig` is still linked into
// `libbitrt.a`, so claiming a real ABI name here fails every link with
// DuplicateSymbol. #1369 owns the rename, which is a mechanical strip of the
// `port_` infix — the tail of each name is already the real ABI spelling.
export @nosplit @symbol("bit_rt_port_mem_word_at") function wordAt(addr: int): *i64 {
  let n: *i64 = nil
  return n + (addr / 8)
}

export @nosplit @symbol("bit_rt_port_mem_load_word") function loadWord(addr: int): int {
  let p = wordAt(addr)
  let v = *p
  return v
}

export @nosplit @symbol("bit_rt_port_mem_store_word") function storeWord(addr: int, v: int) {
  let p = wordAt(addr)
  *p = v
}

// A `*u8` addressing the byte at `addr`. `*u8` arithmetic scales by 1, so the
// offset IS the address. Used only for the header's 1-byte mark flag, which is
// written as a byte rather than a word so the header's bit pattern matches the
// Zig's exactly (ABI.md §1: `marked` is 1 byte at +24, followed by padding).
@nosplit function byteAt(addr: int): *u8 {
  let n: *u8 = nil
  return n + addr
}

export @nosplit @symbol("bit_rt_port_mem_load_byte") function loadByte(addr: int): int {
  let p = byteAt(addr)
  let v = *p
  return int(v)
}

export @nosplit @symbol("bit_rt_port_mem_store_byte") function storeByte(addr: int, v: int) {
  let p = byteAt(addr)
  *p = u8(v)
}

// Round `n` up to the next multiple of `m`.
@nosplit function memRoundUp(n: int, m: int): int {
  let r = n % m
  if (r == 0) {
    return n
  }
  return n + (m - r)
}

// Initialise a reserve over `[addr, addr + bytes)`. The caller owns the
// storage and must have obtained it from the OS (mapped pages) or from memory
// that is already resident for the process lifetime.
//
// PINNED (ABI.md §9): `runtime/chan`'s `chan_make` reserve is provisioned by
// this primitive from `boot` (via chan's `chanBootBind`), a cross-module call a
// freestanding chan emit spells by the callee's emitted symbol — an unpinned
// export is `m<N>$name`, a name no separately emitted object can define (#1613).
// Same `bit_rt_port_` placeholder as every other cross-module runtime helper.
export @nosplit @symbol("bit_rt_port_mem_reserve_init") function reserveInit(r: *i64, addr: int, bytes: int) {
  *(r + resBase) = addr
  *(r + resEnd) = addr + bytes
  *(r + resBump) = addr
}

// Take `n` bytes, 8-aligned, from the reserve. Returns 0 when exhausted — the
// same "out of memory" sentinel the allocator uses, and the one `gcAlloc`
// propagates as `gc.zig`'s `?[*]u8` null.
//
// PINNED (ABI.md §9): `runtime/chan`'s `chan_make` carves each channel handle
// and (buffered) ring out of the boot-provisioned reserve with this call, across
// the object boundary — so it needs the emitted-symbol contract every
// cross-module runtime call relies on (#1613). See `reserveInit`'s pin note.
export @nosplit @symbol("bit_rt_port_mem_reserve_take") function reserveTake(r: *i64, n: int): int {
  if (n <= 0) {
    return 0
  }
  let want = memRoundUp(n, 8)
  let bump = *(r + resBump)
  let end = *(r + resEnd)
  if (bump + want > end) {
    return 0
  }
  *(r + resBump) = bump + want
  return bump
}

// ---------------------------------------------------------------------------
// The OS page seam (#1638)
// ---------------------------------------------------------------------------
//
// `runtime/gc` must compile for all three targets, so it cannot contain a
// `syscall` (Linux-only) or a libc `extern function` with a Darwin-only symbol
// — both are rejected on the DECLARATION, for the whole module, even uncalled
// (SPEC §11.7/§11.8). The page mapper therefore lives per-OS and this module
// reaches it as an ordinary undefined symbol resolved at link.
//
// That shape only became legal in the last two commits and both were needed:
// #1640 admitted `extern function` calls inside a `@nosplit` body (the whole
// allocator is `@nosplit`, so without it nothing on the allocation path could
// call this), and #1645 stopped `--emit-obj` rejecting an `extern` whose
// definition is not in an archive it never reads. Do not "simplify" this into
// a direct call to `mapPages`: importing either provider makes `runtime/gc`
// single-platform and fails 42 of the 63 freestanding emits.
//
// TWO DEFINITIONS ANSWER TO THIS NAME, AND NEVER BOTH IN ONE LINK. While the
// Zig `libbitrt.a` is the runtime it is `runtime/alloc.zig`'s `bit_rt_map_pages`
// (#1369 drops that half); in a Bit-sourced archive it is
// `runtime/root/{linux,darwin}`'s `rtMapPages`, pinned `bit_rt_root_map_pages`,
// which G2's rename (#1583) strips to this exact spelling.
//
// That prefix dance is not decoration — it is the same mechanism the whole
// `runtime/root` port uses to sit in a link beside the `root.zig` it replaces.
// Spelling this `bit_rt_port_alloc_map_pages`, the Bit page provider's own pin,
// looks like the obvious choice and is wrong: the two definitions then collide
// the moment a program compiles `runtime/alloc/darwin` from source AND links
// the Zig archive. `tests/stress/roothostdarwin` does exactly that, and is how
// the first attempt was caught (DuplicateSymbol).
extern function bit_rt_map_pages(nbytes: i64): i64

// Bytes the reserve asks the OS for when it has to grow. Chosen the way
// `allocSpanBytes` is: large enough that growth is amortised to roughly one
// syscall per chunk rather than one per span, small enough that a program with
// a small live set does not reserve address space it will never touch.
const reserveChunkBytes = 4194304

// Take `n` bytes from the reserve, mapping a fresh chunk from the OS when it
// no longer fits. Returns 0 only when the OS itself refuses.
//
// This is the growth `reserveTake` deliberately does not have, kept separate so
// the plain bump take stays available to callers who own a fixed arena and must
// not silently outgrow it (`runtime/chan`'s channel reserve is one).
//
// Rebasing abandons whatever is left in the current chunk. That is bounded by
// the largest single request the reserve serves and happens at most once per
// chunk, so it is a rounding error against `reserveChunkBytes` — and it keeps
// the descriptor three words, with no chunk list to walk or free.
@nosplit function reserveGrow(r: *i64, n: int): int {
  let addr = reserveTake(r, n)
  if (addr != 0) {
    return addr
  }
  if (n <= 0) {
    return 0
  }
  // A request larger than a chunk gets its own exactly-sized chunk.
  let want = memRoundUp(n, 8)
  let chunk = reserveChunkBytes
  if (want > chunk) {
    chunk = memRoundUp(want, reserveChunkBytes)
  }
  let base = int(bit_rt_map_pages(i64(chunk)))
  if (base == 0) {
    return 0
  }
  reserveInit(r, base, chunk)
  return reserveTake(r, n)
}

// Map `nbytes` bytes straight from the OS, bypassing the reserve. This is the
// direct-mapped (large) allocation path, and it is direct for the same reason
// `alloc.zig`'s `allocLarge` is: the block is page-granular and individually
// unmappable, so routing it through a bump reserve would make it permanently
// unreclaimable (#1641).
@nosplit function memMapPages(nbytes: int): int {
  if (nbytes <= 0) {
    return 0
  }
  return int(bit_rt_map_pages(i64(nbytes)))
}

// Bytes still available. Reported so a test can prove a churning workload is
// bounded by its live set rather than by the reserve slowly draining — which is
// the property that distinguishes real free-list recycling from a leak.
export @nosplit function reserveRemaining(r: *i64): int {
  let end = *(r + resEnd)
  let bump = *(r + resBump)
  return end - bump
}
