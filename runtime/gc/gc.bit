// The precise stop-the-world mark-and-sweep collector.
//
// The algorithm is what it is deliberately. Header layout (ABI.md §1), the
// pointer-map contract (§2), the intrusive all-objects list and therefore the
// sweep ORDER, the mark-worklist overflow/rescan recovery, the address->object
// membership index, and the growth trigger are all load-bearing. A collector is
// the one component where a "cleaner" restructuring is silent heap corruption
// rather than a crash, so every constraint below says why it is shaped that way.
//
// THE CONSTRAINTS THAT SHAPE THIS FILE (the complete list)
// -------------------------------------------------------
// 1. STATE IS CALLER-OWNED. There is no mutable module-level state (#1402) and
//    no way to return a class living outside the managed heap, so the
//    collector's state is a block of `gcWords` machine words the caller provides
//    and every entry point takes as its first parameter. This is the shape #1361
//    (spinlock) and #1362 (allocator) both settled on; the process-wide instance
//    belongs to `runtime/root/` (#1367). The block's layout is fixed — see the
//    `gc*` word-index constants below.
//
// 2. ROOT SCANNING IS PUSHED, NOT PULLED. The unmanaged subset has no function
//    pointers (a Bit function value is a GC object, which the collector cannot
//    depend on), so there is no scanner callback for `collect` to invoke.
//    Instead the phases are explicit: `gcMarkBegin` / <caller marks its roots> /
//    `gcCollectFinish`. `gcCollectRoots` wraps the two around a root ARRAY,
//    which is what `runtime/gc/`'s own tests use. The operation ORDER is fixed —
//    seed roots, drain, recover overflow, sweep, reschedule.
//
// 3. PAGES COME FROM A CALLER-SUPPLIED RESERVE. The heap itself is the REAL
//    allocator — `runtime/alloc/alloc.bit` (#1362) — so all size-class policy,
//    the free-list shape and the byte counters are the allocator's, not
//    reinvented here. But the allocator pushes the OS page fetch out to ITS
//    caller (`syscall` is Linux-only, `extern function` Darwin-only, and both
//    are rejected on the declaration), and with no function pointers a
//    platform-free `gc.bit` cannot be handed a mapping callback — only memory.
//    So the caller maps pages and hands in a reserve, and `gcHeapAlloc` bumps
//    spans out of it to refill classes. See `./mem.bit`. This is what keeps this
//    file compiling for all three targets.
//
// 4. ADDRESSES ARE SIGNED, because Bit's `int` is `i64` (§11.1). Every address
//    comparison here (`lo_addr`/`hi_addr` bounds, index probing) is therefore
//    signed. Userspace addresses on all three supported targets are far below
//    2^63, so the ordering is identical to an unsigned comparison. The one place
//    it shows is `gcAddrMax` as the initial `lo_addr`.
//
// 5. INVARIANT VIOLATIONS ARE COUNTED, NOT ASSERTED. Each pointer-map offset
//    must be 8-aligned and inside the body. `@nosplit` cannot call `panic`, so a
//    violating offset increments `gcStatBadOffset` and the slot is SKIPPED
//    rather than read out of bounds. The stress test asserts the counter is
//    zero. Counting beats asserting here for a reason worth keeping: a violation
//    stays visible in a RELEASE build, where a compiled-out assert would not.
//
// 6. `verbose` IS STORED, NOT EMITTED. `@nosplit` cannot call `print`, and the
//    freestanding runtime has no stderr primitive of its own, so the flag is
//    kept readable and emitting the line belongs to the caller (#1367 owns I/O).
//    Every stat such a line would report is exposed as an accessor.
//
// 7. ENV READING AND ENV POLICY ARE SPLIT. Reading the environment is the
//    caller's (#1367); the POLICY — the clamps that make a bad setting harmless
//    — is here, as `gcConfigure`. That is the part with behaviour worth testing.
//
// 8. THE `ref_array_info` SENTINEL IS CALLER-PROVIDED. With no module-level
//    state there is no static whose address can serve as the sentinel, so the
//    address is passed to `gcInit` and stored. It is address identity either way.
//
// Everything is `@nosplit` (§10.3): the collector must not allocate through the
// managed heap and must not reach a safepoint, or it would re-enter itself.

// `./mem.bit` is a SIBLING file, so it is the same module as this one and needs
// no import — its functions are already in scope.
import { spinAcquire, spinRelease } from "../"
import {
  allocClassify,
  allocLargeLen,
  allocSpanBytes,
  allocSpanNext,
  allocSpanOf,
  allocSpanHdrWords,
  allocSpanSlots,
  allocSlotIndex,
  allocCarveStart,
  allocClassSize,
  heapTakeSmallLocked,
  heapGiveSmallLocked,
  heapRefillLocked,
  heapReclaimSpansLocked,
  heapLargeAllocLocked,
  heapLargeFreeLocked,
  heapLiveBytes,
  heapMappedBytes,
  heapPeakMappedBytes,
  heapAllocBytes,
  heapSpansReleasedLocked,
  heapCheckSpansLocked,
  heapSpanViolations,
  heapSpanCachePushLocked,
  heapSpanCacheTakeLocked,
} from "../alloc"

// ---------------------------------------------------------------------------
// ABI constants (runtime/ABI.md §1, §2) — frozen, shared with codegen.
// ---------------------------------------------------------------------------

// Object header size. The body begins at `base + gcHeaderSize` and the
// reference the compiler works with is the BODY pointer (ABI.md §1).
//
// 16 SINCE #4086: two live words, `info` and `size|mark`, and nothing else.
// #4083 packed the mark bit into the size word's sign bit and #4059 retired the
// all-objects list link, which emptied the two words this shrink deleted.
//
// THIS CONSTANT IS A RUNTIME ABI SURFACE, NOT A TUNABLE. Codegen loads a
// receiver's descriptor at a hardcoded `recv - 16` (`compiler/arm64call.bit`,
// `compiler/x64call.bit`), so a compiler and a runtime that disagree about it
// read the wrong word at every interface dispatch — a silent wrong answer, not
// a link error. `tools/build/abiarity.bit` lists `gcHeaderSize` in
// `abiLayoutConsts` to catch exactly that against the pinned stage0 and print
// the two-pass recipe; moving it again owes a MINOR release and a stage0 repin
// (`docs/release/VERSIONING.md` — `runtime/ABI.md` is one of the four surfaces).
export const gcHeaderSize = 16

// Bytes mapped in FRONT of a large object's header to hold its list link
// (#4059). Large objects are >16384 bytes and come straight from `memMapPages`,
// so one word is under 0.05% of the smallest of them and the mapping was
// page-rounded anyway; `allocLargeLen` is given `size + gcLargePrologue` on both
// the map and the unmap side so the two lengths cannot drift.
//
// A PROLOGUE, NOT A HEADER FIELD, AND THAT IS THE WHOLE POINT. The header stays
// uniform at `gcHeaderSize` for every object, so codegen -- which only ever
// computes `recv - gcHeaderSize` (`compiler/arm64call.bit`,
// `compiler/x64call.bit`) -- cannot see this and does not have to. The collector
// reaches it by already knowing the object is large, which it must anyway:
// `allocClassify(...) < 0` is what gates `setSlotBit` and `idxInsert` today.
//
// 8, so the header stays 8-aligned behind a page-aligned mapping (ABI.md 1:
// "Object base is 8-aligned", and v1 bodies need at most 8-byte alignment).
const gcLargePrologue = 8

// Header field offsets, in bytes from the object base.
export const gcHdrInfo = 0
// THE HEADER IS FULL AT TWO WORDS (#4086). `gcHdrNext`'s word and the mark
// word were deleted, not vacated: `gcHeaderSize` is 16 and there is no third
// offset to hand out. Small objects are enumerated from their span's
// occupied-slot bitmap and large ones from a list whose link sits in a prologue
// word AHEAD of the header (`gcLargePrologue` above, `./gcwalk.bit`), which is
// what keeps the header uniform and invisible to codegen. A new per-object word
// costs one size class on every allocation from 8 to 48 bytes of body — measure
// that before proposing one.
// The total allocation size AND the mark bit share this word (#4083). `size` is
// one allocation's byte count, so it is positive and far below 2^63: bit 63 is
// free BY CONSTRUCTION rather than by luck, and `gcAddrMax` below is exactly the
// mask that separates the two.
//
// READ IT ONLY THROUGH `hdrSize`/`hdrMarked`, NEVER WITH A BARE `loadWord`. A
// marked object's raw word is NEGATIVE, so a forgotten mask does not fail
// loudly -- it computes a negative body word count (`scanObject` then traces
// nothing, which is UNDER-tracing and a silent wrong answer) or frees with a
// negative size. That is why the four accessors exist instead of four masks.
export const gcHdrSize = 8

// `TypeInfo` field offsets, in bytes (ABI.md §2, 56 bytes total).
export const gcTiSize = 0
export const gcTiPtrOffsetsPtr = 8
export const gcTiPtrOffsetsLen = 16
export const gcTiNamePtr = 24
export const gcTiNameLen = 32
export const gcTiMethodsPtr = 40
export const gcTiMethodsLen = 48

// Largest i64 — stands in for `std.math.maxInt(usize)` as the initial
// `lo_addr`, so the first `noteBody` always lowers it. See constraint 4.
export const gcAddrMax = 9223372036854775807

// ---------------------------------------------------------------------------
// Collector state block layout, in words. Fixed: `runtime/root/` allocates the
// block by `gcWords` and every accessor indexes it by these constants.
// ---------------------------------------------------------------------------

// gcHeapAddr/gcCfgEnabled/gcCfgStress/gcNextBytes are exported (#1700): stwPoll
// inlines gcShouldCollect's predicate on its hot path to avoid a cross-module
// call, and needs these offsets to do it. gcStackLen/gcCfgGrowthPct are also
// exported (#2920): _tests_/bit/gcdefaults.bit reads them back through
// `rootGcAddr` to prove the EFFECTIVE config a real boot() applied, rather
// than re-deriving what it should have applied — the whole reason the
// min-trigger default drifted 64x for two weeks unnoticed is that nothing
// read the applied value back. Every other field stays private.
export const gcHeapAddr = 0 // address of the allocator's heap block
const gcHeapLockAddr = 1    // address of the i32 word guarding that heap block
const gcLockAddr = 2        // address of the i32 list-lock word
// Head of the LARGE-object list, 0 = null (#4059). Was the head of the
// all-objects list; large objects are the only population the per-span
// occupied-slot bitmap cannot reach, so they are the only one that still needs
// a list. The word is REUSED rather than freed because `gcWords` is boot-pinned
// (`tools/build/abiarity.bit`) and renumbering it would be a runtime ABI change
// for no gain.
const gcLargeAll = 3
// Exported (#3292): `runtime/stw`'s poll inlines `gcShouldCollect`'s object
// half the same way it already inlines the byte half, to avoid taking the
// expensive locked slow path on every back edge while the byte trigger has
// fired but the object trigger has not caught up.
export const gcNumObjectsIdx = 4
const gcStackAddr = 5 // mark worklist base address
export const gcStackLen = 6
const gcStackTop = 7
const gcOverflow = 8
export const gcCfgEnabled = 9
export const gcCfgStress = 10
const gcCfgMinTrigger = 11
export const gcCfgGrowthPct = 12
const gcCfgVerbose = 13
export const gcNextBytes = 14
// The object-count trigger (#3292), paced and stored the same way as
// `gcNextBytes` but in objects rather than bytes -- mark cost is per-object,
// so this is what stops a packing win from raising collection frequency.
// Exported for the same reason as `gcNumObjectsIdx` above.
export const gcNextObjects = 37
const gcLoAddr = 15
const gcHiAddr = 16
const gcStCollections = 17
const gcStTotalAllocated = 18
const gcStTotalSwept = 19
const gcStSurvivorsLast = 20
const gcIndexOk = 21
const gcIndexAddr = 22
const gcIndexCap = 23
const gcIndexLive = 24
const gcIndexUsed = 25    // live entries + tombstones, for the load factor
const gcRefArrayInfo = 26 // address of the `ref_array_info` sentinel
const gcStBadOffset = 27  // constraint 5
const gcPageSize = 28     // for the direct-mapped (large) path only
// Span reserve: pages the caller mapped, which `gcHeapAlloc` carves into size
// classes. Three words (base/end/bump) inline, see ./mem.bit.
const gcSpanRes = 29
// A SEPARATE reserve for the address->object index, kept apart from the
// `index_alloc = std.heap.page_allocator`: index bytes must never count toward
// the heap's `liveBytes`, or they would perturb the growth trigger.
const gcIdxRes = 32
// One-slot cache of the most recently abandoned index table, so a rehash at an
// unchanged capacity reuses storage instead of draining the reserve. See
// `idxGrow`.
const gcIdxSpareAddr = 35
const gcIdxSpareCap = 36
// Head of the span reserve's free list (#3868): released spans the #3045
// cache had no room for, recovered by address instead of abandoned. See
// `./mem.bit`'s `spanFreeListPush`/`spanFreeListTake` — this word is exactly
// what those take as `head`, and it is a dedicated word here rather than a
// 4th `reserveWords` word because only `gcSpanRes` ever needs one (see that
// const's own comment in `./mem.bit`). 38, not 37: `gcNextObjects` above
// already owns 37 — the two constants are declared out of numeric order
// because `gcNextObjects` was appended by #3292 next to its sibling
// `gcNextBytes` rather than at the end of the block.
const gcSpanFree = 38

// Words the caller must provide for the state block.
export const gcWords = 39

// Defaults, matching `Config`'s field defaults in runtime/gc/.
export const gcDefaultMinTrigger = 4194304 // 4 * 1024 * 1024
export const gcDefaultGrowthPct = 200
// 8192 (measured, #3292): with the object trigger above making collections
// less frequent and each one bigger, a wide-frontier workload (e.g.
// `bench/cases/json`'s root array) overflows an 8192-word worklist repeatedly,
// and `recoverOverflow`'s O(all-objects) rescan on every overflow dominated
// the cost enough to erase the trigger fix's own win: measured on
// `bench/cases/json` with only the trigger changed, instructions retired went
// UP 11-15% despite 40% fewer collections. Bumping to 65536 (512 KiB, still a
// fixed, bounded, one-time allocation -- Power of 10 constraint 3 is not
// about the number, it is about the allocation being upfront and static, and
// it stays that) measured 20-46% FEWER instructions retired and 24-46% less
// wall clock than the 8192 baseline at matching pct, across a 32768-262144
// sweep; 32768 (4x) was not enough, 65536 (8x) was where the regression
// cleared.
export const gcDefaultMarkStack = 65536

// Index slot sentinels. A body address is 8-aligned and never 0, so neither
// value can collide with a real entry.
const idxEmpty = 0
const idxTombstone = 1
const idxMinCap = 16
const idxLoadPct = 80 // grow at 80% occupancy, the conventional open-addressing load factor

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

@nosplit fn bodyFromHeader(h: int): int {
  return h + gcHeaderSize
}

// The size word's two fields (#4083, ABI.md §1). One definition of the packing,
// so the mask cannot drift between the six readers that used to open-code it.
//
// `~gcAddrMax` is the sign bit and nothing else: `gcAddrMax` is 2^63-1, so its
// complement is i64's minimum, which has bit 63 set and every other bit clear.
// Spelled that way rather than as `1 << 63` because shifting a literal into the
// sign bit is a question about the shift, and this is not.
@nosplit fn hdrSize(h: int): int {
  return loadWord(h + gcHdrSize) & gcAddrMax
}

@nosplit fn hdrMarked(h: int): bool {
  return loadWord(h + gcHdrSize) < 0
}

@nosplit fn hdrSetMark(h: int) {
  storeWord(h + gcHdrSize, loadWord(h + gcHdrSize) | ~gcAddrMax)
}

@nosplit fn hdrClearMark(h: int) {
  storeWord(h + gcHdrSize, loadWord(h + gcHdrSize) & gcAddrMax)
}

// The sweep's whole per-survivor test: clear the mark if it is set, and say
// whether it WAS. A fifth accessor rather than a `hdrMarked` + `hdrClearMark`
// pair at the one call site that does both (#4059), because that pair addresses
// the word FOUR times and loads it twice — `loadWord`/`storeWord` each
// recompute `h + gcHdrSize` and re-mask it, and this backend has no CSE across
// them. It lives here, beside its four siblings, for the reason the block
// comment above gives: the packing gets exactly one definition, and the sweep
// does not open-code a mask.
//
// THE STORE IS UNCONDITIONAL, which is not a slip: for an object that was not
// marked, `v & gcAddrMax` IS `v`, so the store writes the value back unchanged.
// It buys a branchless body of four statements, which is what lets this be
// inlined into the sweep's inner loop rather than reached by `bl` per object,
// and it dirties no line the sweep was not already about to touch — an unmarked
// object is on its way to `heapGiveSmallLocked`, which writes the same slot.
@nosplit fn hdrTakeMark(h: int): bool {
  let p = wordAt(h + gcHdrSize)
  let v = *p
  *p = v & gcAddrMax
  return v < 0
}

@nosplit fn headerFromBody(body: int): int {
  return body - gcHeaderSize
}

// The list lock as a `*i32`. Stored as an address because the state block is a
// word array; `*i32` arithmetic scales by 4, so the address must be 4-aligned
// (it is: the caller's lock word comes from `ptrOf` on an `[]i32`).
//
// `>> 2`, not `/ 4` (#3904): `addr` is that `ptrOf`-derived lock word address
// (`gcInit`'s `listLockAddr` parameter, every call site an `int(ptrOf(...))`
// or an equivalent live-global address), never negative.
@nosplit fn lockPtr(g: *i64): *i32 {
  let n: *i32 = nil
  let addr = *(g + gcLockAddr)
  return n + (addr >> 2)
}

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------
//
// The exports below are `@symbol`-pinned because `runtime/root` calls them
// across a module boundary; see `./mem.bit` for why the pin is required and why
// the `bit_rt_port_` prefix is temporary (#1369 owns the rename).

// Create a collector over `heapRegion`. Allocates the fixed mark worklist up
// front (startup allocation — never grows afterwards), from the OBJECT heap,
// exactly as `Gc.init` does; that is deliberate, because it means the worklist
// counts toward `liveBytes` in both implementations and the trigger schedules
// identically.
//
// `markStackLen` of 0 becomes 1: a zero-length worklist would make every mark overflow.
// Returns false if the worklist could not be allocated (the
// `error{OutOfMemory}`).
//
// #3177: `heapLockAddr` AND `listLockAddr` MUST BE DIFFERENT WORDS. Before this
// ticket the two were never nested (`gcHeapAlloc` always released the heap
// lock before `linkObject` took the list lock), so a caller aliasing them to
// one word was harmless. `idxInsertSpan` (`./gcindex.bit`) now takes the list
// lock from INSIDE `gcHeapAlloc`'s class-empty path, still holding the heap
// lock — including on THIS function's own worklist allocation below, its very
// first call. A shared word makes that a self-deadlock on a non-reentrant
// spinlock: the worklist allocation never returns and `gcInit` never
// completes. Found this way, reproducibly, in three private-collector stress
// fixtures that had aliased them (`_tests_/stress/chanmakeroots`,
// `stwcollect`, `stwownstack`) — each hung indefinitely on its first run,
// `lldb bt` showing thread stuck in `bit_rt_spin_acquire` under
// `bit_rt_port_gc_init`. Fixed there by giving each its own list-lock word;
// do the same for any new caller.
export @nosplit @symbol("bit_rt_port_gc_init") fn gcInit(
  g: *i64,
  heapAddr: int,
  heapLockAddr: int,
  listLockAddr: int,
  refArrayInfoAddr: int,
  markStackLen: int,
): bool {
  // `gcBindMemory` must have run first, because the mark worklist below is
  // allocated through the heap and the heap draws its spans from the reserve.
  // Checked rather than documented-and-hoped: an unbound reserve would other-
  // wise hand out spans carved from whatever the caller's block happened to
  // contain, which is silent heap corruption rather than a failure.
  //
  // The reserve's LIMIT is what says "bound", not its first word: since #2373
  // that word is the chunk list head, which is legitimately 0 for a reserve
  // that has never had to grow. A zeroed block reads 0 here either way, and a
  // reserve released by `gcDeinit` reads 0 again — so a re-init after teardown
  // is refused unless the caller rebinds memory, which is the honest answer.
  let spanEnd = *(g + gcSpanRes + resEnd)
  if (spanEnd == 0 || heapAddr == 0 || heapLockAddr == 0 || listLockAddr == 0) {
    return false
  }

  let ncap = markStackLen
  if (ncap == 0) {
    ncap = 1
  }
  let bytes = ncap * 8

  *(g + gcHeapAddr) = heapAddr
  *(g + gcHeapLockAddr) = heapLockAddr
  *(g + gcLockAddr) = listLockAddr
  *(g + gcLargeAll) = 0
  *(g + gcNumObjectsIdx) = 0
  *(g + gcStackAddr) = 0
  *(g + gcStackLen) = ncap
  *(g + gcStackTop) = 0
  *(g + gcOverflow) = 0
  *(g + gcCfgEnabled) = 1
  *(g + gcCfgStress) = 0
  *(g + gcCfgMinTrigger) = gcDefaultMinTrigger
  *(g + gcCfgGrowthPct) = gcDefaultGrowthPct
  *(g + gcCfgVerbose) = 0
  *(g + gcNextBytes) = gcDefaultMinTrigger
  // 0, not a byte budget divided by `gcHeaderSize` (#3358): nothing has been
  // marked yet, so there is no live object count to pace against, and the
  // first collection must be the byte trigger's call alone. Any non-zero seed
  // here is a floor in the wrong unit — see `gcCollectFinish`'s comment.
  *(g + gcNextObjects) = 0
  *(g + gcLoAddr) = gcAddrMax
  *(g + gcHiAddr) = 0
  *(g + gcStCollections) = 0
  *(g + gcStTotalAllocated) = 0
  *(g + gcStTotalSwept) = 0
  *(g + gcStSurvivorsLast) = 0
  *(g + gcIndexOk) = 1
  *(g + gcIndexAddr) = 0
  *(g + gcIndexCap) = 0
  *(g + gcIndexLive) = 0
  *(g + gcIndexUsed) = 0
  *(g + gcRefArrayInfo) = refArrayInfoAddr
  *(g + gcStBadOffset) = 0
  *(g + gcIdxSpareAddr) = 0
  *(g + gcIdxSpareCap) = 0
  *(g + gcSpanFree) = 0

  // The mark worklist is allocated from the OBJECT heap, exactly as `Gc.init`
  // does. That is deliberate rather than incidental: it means the worklist
  // counts toward `liveBytes` in both implementations, so the growth trigger
  // schedules identically. It is therefore allocated LAST, once the reserve and
  // page size the allocator needs are in place.
  // NOT an object lifecycle — once per process, so the classify here is not on
  // any hot path and is spelled out rather than threaded from anywhere.
  let stack = gcHeapAlloc(g, bytes, 8, allocClassify(bytes, 8))
  if (stack == 0) {
    return false
  }
  *(g + gcStackAddr) = stack
  return true
}

// Bind the page reserve and page size. MUST be called before `gcInit`, because
// `gcInit` allocates the mark worklist through the heap.
//
// `spanAddr`/`spanBytes` is memory the CALLER mapped from the OS — the
// collector cannot map it itself and stay platform-free (see constraint 3).
// `idxAddr`/`idxBytes` backs the address->object index and is kept separate so
// index bytes never reach the heap's `liveBytes`.
export @nosplit @symbol("bit_rt_port_gc_bind_memory") fn gcBindMemory(
  g: *i64,
  spanAddr: int,
  spanBytes: int,
  idxAddr: int,
  idxBytes: int,
  pageSize: int,
) {
  reserveInit(g + gcSpanRes, spanAddr, spanBytes)
  reserveInit(g + gcIdxRes, idxAddr, idxBytes)
  *(g + gcPageSize) = pageSize
}

// Span-bookkeeping violations the allocator has recorded (#2374). Zero unless
// something drove `heapCheckSpansLocked`, which under this collector means
// `BIT_GC=stress` — so a program asserting this is 0 must ALSO have configured
// stress, or it is asserting that a check it never ran found nothing.
//
// It lives here rather than beside the other stats in `./gccollect.bit` because
// the number is the ALLOCATOR's, not the collector's: it is read straight out of
// the heap block and is meaningful for a heap with no collector at all.
export @nosplit fn gcSpanViolations(g: *i64): int {
  return heapSpanViolations(heapBlock(g))
}

// Free every remaining object and the mark worklist. The collector is unusable
// afterwards. This is `Gc.deinit` (ABI.md §6), and it is what makes `liveBytes`
// a LEAK METRIC: after it, every byte the collector took from the heap has been
// given back, so `gcLiveBytes` returns to whatever it was before `gcInit` — 0
// for a fresh heap. A test asserting that is checking the whole
// alloc/link/sweep/free path at once.
//
// The index is dropped up front and disabled so the per-object
// `freeObject` removals below become no-ops instead of O(n) probes; this does
// the same.
//
// THE RESERVE'S OWN CHUNKS ARE NOW RETURNED TOO (#2373). The memory the CALLER
// bound is still not — it is the caller's, and only the caller can unmap it —
// but every chunk `reserveGrow` mapped once the caller's arena ran out is this
// collector's, was previously unknowable (the descriptor rebased and dropped
// the address), and is unmapped here. On a long-lived process that is nearly
// all of the collector's footprint.
export @nosplit fn gcDeinit(g: *i64) {
  idxDisable(g)
  // ONE acquire for the whole walk (#4319), not one per object. Deinit is
  // single-threaded by contract, and nothing between here and the release
  // re-acquires `heapLock` -- `./gcmark.bit`'s `sweep` states that argument in
  // full and it is the same one.
  //
  // #4059: the walk is `./gcwalk.bit`'s, in free-everything mode -- the same
  // enumeration `sweep` uses, with the mark test removed rather than a second
  // copy of the traversal.
  spinAcquire(heapLock(g))
  let _ = gcWalkHeap(g, gcWalkFreeAll)
  spinRelease(heapLock(g))
  *(g + gcLargeAll) = 0
  *(g + gcNumObjectsIdx) = 0
  let stack = *(g + gcStackAddr)
  if (stack != 0) {
    let slen = *(g + gcStackLen) * 8
    gcHeapFree(g, stack, slen, 8, allocClassify(slen, 8))
    *(g + gcStackAddr) = 0
  }

  // Every object and the worklist are gone, so every direct-mapped block has
  // been unmapped and its bytes are already off `mappedBytes`. What the counter
  // still holds is therefore EXACTLY the spans carved out of the reserve —
  // which is how the span total is recovered without a counter of its own, and
  // it needs none: `gcWords` is full, every one of its 39 words assigned, and
  // `runtime/root/root.bit` refuses to boot if that width moves.
  //
  // Release the accounting first, then the pages: a window where the counter
  // says "mapped" and the pages are gone is the honest direction to be wrong in
  // while the lock is held, and this is the last thing the heap ever does.
  spinAcquire(heapLock(g))
  heapSpansReleasedLocked(heapBlock(g), heapMappedBytes(heapBlock(g)))
  spinRelease(heapLock(g))
  let _ = reserveRelease(g + gcSpanRes)
  let _ = reserveRelease(g + gcIdxRes)
}

// Apply collector policy. The clamps are `configFromEnv`'s, ported verbatim:
// a growth percent below 100 is IGNORED (the heap must be allowed to grow
// between collections) and a mark-stack length of 0 is ignored. `minTrigger`
// also reschedules `nextGcBytes`, because `Gc.init` seeds it from the config
// and this port configures after init (constraint 7).
//
// `minTrigger >= 0`, NOT `> 0` (#2920): a caller reaching this function always
// carries a real value by now — env parsing (`rootconfig.bit`'s
// `gcEnvMinTrigger`) already resolved "unset" to a default before this is
// called, so there is no "leave it alone" case left for this guard to protect.
// `> 0` silently discarded `BIT_GC_MIN_KB=0`, which `rootconfig.bit:150-152`
// documents as a real setting (no floor — collect as soon as anything is
// live): every caller, including that explicit-zero one, always MEANS to set
// `gcCfgMinTrigger`/`gcNextBytes` to exactly what it passed. `>= 0` still
// rejects a negative value, which is not a value any caller produces.
export @nosplit @symbol("bit_rt_port_gc_configure") fn gcConfigure(
  g: *i64,
  enabled: bool,
  stress: bool,
  minTrigger: int,
  growthPct: int,
  verbose: bool,
) {
  if (enabled) {
    *(g + gcCfgEnabled) = 1
  } else {
    *(g + gcCfgEnabled) = 0
  }
  if (stress) {
    *(g + gcCfgStress) = 1
  } else {
    *(g + gcCfgStress) = 0
  }
  if (minTrigger >= 0) {
    *(g + gcCfgMinTrigger) = minTrigger
    *(g + gcNextBytes) = minTrigger
    // Reschedule the object trigger the same way (#3292): a caller that
    // lowers minTrigger to force frequent collections (every gcConfigure
    // call in _tests_/stress/**) must not be blocked by a stale object trigger
    // left over from gcInit's default. 0 rather than `minTrigger /
    // gcHeaderSize` (#3358) for the same reason gcInit seeds 0: the object
    // trigger is only meaningful once a collection has measured a live set,
    // and a byte budget converted to objects is a floor in the wrong unit.
    *(g + gcNextObjects) = 0
  }
  if (growthPct >= 100) {
    *(g + gcCfgGrowthPct) = growthPct
  }
  if (verbose) {
    *(g + gcCfgVerbose) = 1
  } else {
    *(g + gcCfgVerbose) = 0
  }
  // #4203: the configuration IS one of the conditions the back-edge poll
  // summarises (../sched/pollreq.bit), so installing it publishes a request —
  // AFTER the stores above, like every other writer of that word.
  //
  // Load-bearing for `BIT_GC=stress` specifically, whose entire meaning is
  // "collect at every safepoint": the allocation door's own request
  // (./gcalloc.bit) covers a stress program that allocates, but a stress
  // program whose hot loop allocates nothing has no other publisher, and
  // without this its back edges would never poll and the precise-rooting oracle
  // would be silently off. The republish at the end of every safepoint
  // (../stw/stwpoll.bit) keeps it set from here on, because `gcShouldCollect`
  // is unconditionally true under stress.
  pollRequest()
}
