// Returning the parallel mark pool's idle pages to the OS (#6050). Sibling of
// `./gcmarkpar.bit`, same module.
//
// The pool is one side mapping, reused by every collection, and a segment's
// pages become resident the first time a member writes to one. Nothing gave
// them back: one deep mark left its whole frontier's worth resident for the
// life of the process. A burst holding 800K entries in flight is 6.4 MB.
//
// THE TOUCHED SEGMENTS ARE A PREFIX of the mapping. `gcMkSeed` stacks the free
// list lowest index on top, a returned segment goes back on top, and
// `gcMkGrow` carves past `gcMkSegs` only with the list empty. So a phase
// touches segments [0, `gcMkSegs` - `gcMkFreeMin`), where `gcMkFreeMin` is the
// shallowest the free list got (`gcMkSwap`, ./gcmarkpar.bit, or
// `gcMkTakeFree`, ./gcmark.bit).
//
// THE POLICY is the one Go applies to its own idle GC memory (mgcscavenge.go):
// keep what recent cycles needed, return the rest. Every `gcMkTrimPhases`
// phases, the pages past the most any phase of that window touched are reset
// in place (`bit_rt_remap_pages`, ./mem.bit), so they cost no RSS until a
// later phase writes them again. A segment holds nothing between phases, so
// any reset is safe; the window only keeps a heap whose need swings from one
// phase to the next from refaulting every phase. Runs with the pool held and
// the world stopped, after `gcMarkPar` closes and drains its helper phase
// (./gcmarkpar.bit), at most one syscall per window.

// Phases a page must go untouched before it is returned, and the alignment of
// a reset: the largest page of any target (arm64 macOS), a multiple of all.
const gcMkTrimPhases = 64
const gcMkTrimAlign = 16384

let gcMkFreeMin: i64 = 0 // shallowest free list this phase (M2)
let gcMkTouched: i64 = 0 // segments [0, n) that may be resident
let gcMkNeed: i64 = 0    // most segments one phase of this window touched
let gcMkWin: i64 = 0     // phases in this window

// End of a phase. CALLER HOLDS THE POOL (`gcMkOwner`) and no helper is in the
// phase (M5), so no member holds or reads a segment.
@nosplit fn gcMkTrim() {
  let used = gcMkSegs - gcMkFreeMin
  if (used > gcMkTouched) {
    gcMkTouched = used
  }
  if (used > gcMkNeed) {
    gcMkNeed = used
  }
  gcMkWin = gcMkWin + 1
  if (gcMkWin < gcMkTrimPhases) {
    return
  }
  let lo = memAlignUp(gcMkNeed * gcMkSegBytes, gcMkTrimAlign)
  let hi = memAlignUp(gcMkTouched * gcMkSegBytes, gcMkTrimAlign)
  gcMkTouched = gcMkNeed
  gcMkNeed = 0
  gcMkWin = 0
  if (hi <= lo || bit_rt_remap_pages(i64(gcMkBase + lo), i64(hi - lo)) != 0) {
    return
  }
  // The OS refused a reset of a range this runtime mapped: should not happen.
  // The range may no longer be mapped, so drop the whole pool; the next phase
  // maps a fresh one (`gcMkReserve`) or runs the serial `drain`.
  memUnmapPages(gcMkBase, gcMkMapBytes)
  gcMkBase = 0
  gcMkTouched = 0
}
