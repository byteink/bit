// Split out of ./gcworld.bit (#1653): the park/rendezvous state machine.

// ---------------------------------------------------------------------------
// The stop flag — `World.stopRequested`
// ---------------------------------------------------------------------------

// Whether a stop is pending. One atomic load; the overwhelmingly common
// safepoint answer.
export @nosplit @symbol("bit_rt_port_gc_world_stop_requested") fn worldStopRequested(world: *i64): bool {
  return atomicLoad(world + worldStopWord) != 0
}

// ---------------------------------------------------------------------------
// Yielding to a stop — `World.park` / `mustStayPut` / `resumeWhenClear`
// ---------------------------------------------------------------------------

// Whether slot `slot` must stay in its `waiting` state rather than run Bit code.
//
// No stop pending: free to run. A `blocked` slot: `rendezvous` passed it WITHOUT
// an acknowledgement, so any pending stop may already have counted it — it must
// stay put until the stop clears outright. A `parked` slot: may resume as soon as
// the pending stop is one it has NOT acknowledged (its ack names an older epoch),
// because that stop's rendezvous is still waiting for this slot, so nothing has
// marked behind it. Without the parked test the thread STARVES under stress (a
// stop pending at every safepoint would re-park it forever); measured in runtime/gc/.
@nosplit fn worldMustStayPut(world: *i64, slot: int, waiting: int): bool {
  if (atomicLoad(world + worldStopWord) == 0) {
    return false
  }
  if (waiting == mBlocked || waiting == mSyscall) {
    return true
  }
  let m = wMut(world, slot)
  return atomicLoad(m + muAcked) == atomicLoad(world + worldEpochWord)
}

// Sleep until the pending stop clears, or until `stwWaitTimeoutUs` elapses.
// `worldResumeWhenClear`'s tail past the first burst, and the whole of #5750.
//
// THE LOST WAKE IS THE ONLY WAY THIS SHAPE FAILS, AND IT IS CLOSED BY A DEKKER
// PAIR, not by ordering luck. Against `worldRestart` below:
//
//     waiter:    atomicAdd(waiters, +1)  then  atomicLoad(stop)
//     restarter: atomicStore(stop, 0)    then  atomicLoad(waiters)
//
// Both accesses on both sides are seq_cst (constraint 2, ../gc/gcworld.bit), so
// the two cannot both read the stale value: either this waiter loads 0 from the
// stop word and never sleeps, or the restarter loads a non-zero waiter count and
// issues the wake. That is the SAME store-then-load argument
// `worldResumeWhenClear` and `worldRendezvous` already pair on, applied to a
// second pair of cells, and it is why the counter is incremented BEFORE the
// stop word is read rather than after.
//
// THE COMPARE IS THE THIRD GUARD AND THE REASON THE COMPARAND IS THE WORD'S OWN
// VALUE. `bit_rt_port_gc_world_stop_wait` sleeps only if the word still holds
// `v`, atomically against the wake — so a restart landing in the gap between
// the load below and the kernel enqueue is caught by the kernel's own read, not
// missed. A separate "someone may sleep" flag would have no such compare and
// would need a lock to be correct.
//
// ONE WINDOW SURVIVES ALL THREE AND IS BOUNDED, NOT ARGUED AWAY: the stop word
// is 0/1, so a restart followed by a FRESH stop inside that same gap restores
// the very value `v` this waiter is comparing against, and the kernel sleeps on
// the new collection. Safe — `worldMustStayPut` above would have released this
// thread, and the new collection's rendezvous simply does not count a `parked`
// slot whose ack names the older epoch, so it abandons rather than marking
// behind a running mutator (ABI.md §5, always safe) — but it is latency, which
// is what `stwWaitTimeoutUs` caps. Every path that sets the stop word reaches
// `worldRestart`, on success AND on abandonment (`../stw/stwpoll.bit` restarts
// on both), so the sleep is bounded twice over.
//
// The counter is decremented on EVERY exit path, including the one that never
// slept, because the guard in `worldRestart` reads it as "is a wake worth a
// syscall" and a leaked increment would make every later restart pay for one.
@nosplit fn worldWaitForStop(world: *i64) {
  let w = world + worldWaiters
  let _ = atomicAdd(w, 1)
  let v = atomicLoad(world + worldStopWord)
  if (v != 0) {
    let _ = bit_rt_port_gc_world_stop_wait(world + worldStopWord, v, stwWaitTimeoutUs)
  }
  let _ = atomicAdd(w, 0 - 1)
}

// Sit in `waiting` until this thread may run Bit code again.
//
// THE NAIVE VERSION ("wait for `stop` to clear, then store `running`") IS
// UNSOUND — a thread that saw `stop == false` while still publishing
// `parked`/`blocked` is read by the NEXT collector as already stopped, passed,
// and marked behind while it resumes and mutates. This is the #1431 shape runtime/gc/
// documents at length. The close differs by state and BOTH accesses are seq_cst,
// paired with `worldRendezvous` (Dekker): store own flag, then load the other's.
//
//   - `parked` is closed by the EPOCH: acknowledge the epoch being parked for
//     BEFORE publishing `parked`, so a collector that reads `parked` also reads a
//     matching (or older) ack. A resuming thread's ack names an older stop, so
//     the next collector waits for it rather than passing it.
//   - `blocked` has no ack — rendezvous passes it unconditionally, the whole
//     point of the contract — so the re-check below is load-bearing there:
//     publish `running`, re-read `stop`, and go back if one is pending.
//
// PAST THE FIRST BURST THE WAIT SLEEPS ON THE STOP WORD (#5750), where #5748
// yielded on every check and #2415 before it yielded once per `stwSpinBurst`.
// The burst itself is untouched through all three, so #2415's "a mutator that
// acks within the first burst never reaches an OS call at all" still holds:
// what changed is the TAIL, and the tail is not a handshake, it is a whole
// mark and sweep.
//
// Measured on `bench/cases/allocpar` (8 mutators, 10,002,000 objects,
// `BIT_GC_STATS=1` with the wait loop's iterations counted): 726,120,821
// iterations per run across 163 collections, 636k per waiting thread per stop,
// of which one in a thousand yielded. The heap lock's own spin burns 59.9 M
// iterations over the same run, so this loop is 12x it and is where the
// parallel allocator's instructions actually go.
//
// WHAT THAT IS WORTH, taken from the A/B itself rather than from a
// per-iteration estimate: 44239 M -> 22135 M instructions over 21 interleaved
// reps, sign 21/21. That is 22.1 G, which is 60% of the 36.6 G gap between one
// mutator (7626 M) and eight, NOT the whole of it. The remaining 14.5 G is not
// this loop and is still unattributed; do not read this as having closed it.
//
// AND IT DID NOT MAKE allocpar FASTER. Cycles were unchanged: 22468 M ->
// 22457 M, per-rep sign 9/21, which is exactly the byte-identical null
// control's own 9/21. A yielding thread still owns its core, so the cycles
// moved into the yield syscall instead of disappearing — which is why #5750
// replaced the yield with a blocking wait on `worldStopWord` itself
// (`worldWaitForStop` below, `./gcstopwait.bit`) and was accepted on cycles
// rather than on instructions.
// The helper-gang join attempt (#5837), one turn of `worldResumeWhenClear`'s
// own wait loop. `m` is that thread's own `wMut(world, slot)`, already in the
// caller's hands.
//
// GATED ON THE EPOCH, NOT ON "OPEN" ALONE. A gang open for an epoch this slot
// has not acknowledged is not one it may join — the same reason
// `worldMustStayPut` compares `muAcked` to `worldEpochWord` rather than
// trusting a bare stop flag: a straggler still parked FOR an older stop must
// not be counted into (or, here, do work for) a newer one it was never
// admitted to.
//
// THE RE-CHECK AFTER THE ADD IS WHAT #5837 MEANS BY "HANDLE A HELPER THAT
// RACES THE CLOSE". `worldGangClose` stores 0 into `worldGangWord` BEFORE it
// waits for `worldGangIn` to drain, so a helper that read the OLD epoch and
// is about to `atomicAdd(worldGangIn, +1)` can land after that close store.
// Without the second load below, such a helper would be counted into
// `worldGangIn` AFTER the coordinator already observed 0 there and moved on
// to `worldRestart` — exactly the race the drain wait exists to prevent. The
// second load closes it: seq_cst orders the add-then-load here against the
// coordinator's store-then-load in `worldGangClose` the same way every other
// Dekker pair in this file does, so a helper that still sees the old epoch
// here is guaranteed the coordinator's own wait has not yet returned.
@nosplit fn worldGangTryHelp(world: *i64, m: *i64) {
  let e = atomicLoad(world + worldGangWord)
  if (e == 0 || e != atomicLoad(m + muAcked)) {
    return
  }
  let _ = atomicAdd(world + worldGangIn, 1)
  if (atomicLoad(world + worldGangWord) != e) {
    // Lost the race with the close: undo the add and go back to waiting
    // rather than call into a collector block the coordinator may already be
    // past. `gcGangHelp` never ran, so there is nothing else to unwind.
    let _ = atomicAdd(world + worldGangIn, 0 - 1)
    return
  }
  // `g` is the collector block the coordinator published in `worldGangOpen`,
  // below, before it opened the gang for `e`. Bounded work (#5838).
  gcGangHelp(wordAt(atomicLoad(ptrOf(gcGangBlock))))
  let _ = atomicAdd(world + worldGangIn, 0 - 1)
}

@nosplit fn worldResumeWhenClear(world: *i64, slot: int, waiting: int) {
  let m = wMut(world, slot)
  let outer = 0
  // Bounded (constraint 5/outer bound): normally one pass; each extra pass costs
  // one intervening collection, and exhaustion is counted as "runtime broken".
  while (outer < worldResumeOuterBound) {
    // Acknowledge the stop being parked FOR before publishing the state that
    // lets rendezvous count us. A collector reading `parked` must read the ack.
    if (waiting == mParked) {
      atomicStore(m + muAcked, atomicLoad(world + worldEpochWord))
    }
    atomicStore(m, waiting)

    let spins = 0
    // Bounded by `stwParkBound`; expiry means the stop never cleared. #2415
    // gave `worldRendezvous`'s spin the same pulse for the same reason: a pure
    // busy-spin here starves the collector thread it is waiting on exactly as
    // a pure busy-spin there starved this one — see that function's header.
    // Same primitive (`worldYield`), and the same first burst, so the
    // handshake still carries one spin/yield policy rather than two.
    //
    // THE FIRST BURST SPINS, EVERYTHING AFTER IT SLEEPS (#5750, after #5748's
    // yield); the numbers, and what they do and do not prove, are in this
    // function's header.
    //
    // THE BOUND IS UNCHANGED AND STAYS CONSERVATIVE: still exactly
    // `stwParkBound` checks before "the stop never cleared" is declared,
    // counted the same way, and each of those checks now costs a bounded sleep
    // rather than a few cycles, so the wall clock the bound represents only
    // grows. `>=` rather than `%` also drops a signed modulo from every
    // iteration of the loop it guards.
    while (spins < stwParkBound) {
      if (!worldMustStayPut(world, slot, waiting)) {
        break
      }
      // #5837: only a `parked` slot has an ack to match a gang epoch against
      // — `blocked`/`syscall` pass without one (see `worldMustStayPut`'s own
      // header) and so can never legally join. Tried every turn, including
      // during the busy-spin burst above the sleep, so a mutator that parks
      // into an already-open gang helps at once rather than waiting out a
      // full burst first.
      if (waiting == mParked) {
        worldGangTryHelp(world, m)
      }
      spins = spins + 1
      if (spins >= stwSpinBurst) {
        worldWaitForStop(world)
      }
    }
    if (spins >= stwParkBound) {
      // The stop never cleared: a runtime bug. Rather than panic, count it and release
      // (constraint 5). Leaving the slot `running` is the same result @panic's
      // process teardown would reach, minus the abort.
      let c = atomicLoad(world + worldStatResumeGiveUp)
      atomicStore(world + worldStatResumeGiveUp, c + 1)
      atomicStore(m, mRunning)
      return
    }

    atomicStore(m, mRunning)
    if (!worldMustStayPut(world, slot, waiting)) {
      return
    }
    // A stop that may already have counted us landed in the gap. Nothing above
    // touched the heap, so going back is always safe.
    outer = outer + 1
  }
  // Outer bound exhausted: same "runtime broken" signal, counted not panicked.
  let c = atomicLoad(world + worldStatResumeGiveUp)
  atomicStore(world + worldStatResumeGiveUp, c + 1)
  atomicStore(m, mRunning)
}

// Yield to an in-progress collection: publish this thread's snapshot (`frame`,
// so the collector walks this stack precisely), go `parked`, wait for the stop
// to clear, then drop the snapshot. Returns immediately if no stop is pending,
// which is what makes it safe to call speculatively at a safepoint.
export @nosplit @symbol("bit_rt_port_gc_world_park") fn worldPark(
  world: *i64,
  slot: int,
  frame: int,
) {
  let m = wMut(world, slot)
  atomicStore(m + muFrame, frame)
  worldResumeWhenClear(world, slot, mParked)
  atomicStore(m + muFrame, 0)
}

// ---------------------------------------------------------------------------
// The `blocked` contract — `World.beginBlocking` / `endBlocking`
// ---------------------------------------------------------------------------

// Enter a region that holds NO live Bit references in any frame (ABI.md §5).
// The collector then neither waits for this thread nor scans it. PRECONDITION:
// the caller genuinely holds no live references for the whole bracketed region —
// one held across this is invisible and will be swept. Clears the frame so no
// snapshot is left to be walked.
export @nosplit @symbol("bit_rt_port_gc_world_begin_blocking") fn worldBeginBlocking(
  world: *i64,
  slot: int,
) {
  let m = wMut(world, slot)
  atomicStore(m + muFrame, 0)
  atomicStore(m, mBlocked)
}

// Leave that region. Stays `blocked` while a stop is pending rather than
// resuming behind the collector's back — a `blocked` slot was passed without
// acknowledging, so it must re-check the flag (`worldResumeWhenClear`) before it
// runs. Staying blocked longer is free: nothing waits on it.
export @nosplit @symbol("bit_rt_port_gc_world_end_blocking") fn worldEndBlocking(
  world: *i64,
  slot: int,
) {
  worldResumeWhenClear(world, slot, mBlocked)
}

// ---------------------------------------------------------------------------
// The `syscall` contract — `World.beginSyscall` / `endSyscall` (#1904)
// ---------------------------------------------------------------------------

// Enter a region that runs no Bit code but DOES hold live Bit references — a
// thread about to block in the kernel. Unlike `beginBlocking` this makes NO
// claim about liveness; it publishes what a conservative scan needs instead.
//
// `sp` is the caller's stack pointer and `regs` the address of `muRegWords`
// saved callee-saved registers, both captured by `gcSyscallBegin`
// (../gc/gcworldsync.bit) BEFORE this call. The register file is the half that
// memory alone cannot supply and is not optional: a live reference the register
// allocator parked in a callee-saved register across the syscall is invisible to
// any walk of the stack, which is #1742 exactly — found there as a `string`
// pointer held across a `sleep()` and silently collected.
//
// PRECONDITION: the caller really does block, and does not run Bit code or move
// `sp` below `sp` until `endSyscall`. Both publications are read by a collector
// that assumes they describe a thread frozen in the kernel; a thread that kept
// running under this state would be scanned from a stale bound, which is the
// `blocked`-shaped bug this state exists to avoid.
//
// Ordering mirrors `worldPark`: publish the snapshot BEFORE the state, so a
// collector that reads `syscall` also reads a complete snapshot.
export @nosplit @symbol("bit_rt_port_gc_world_begin_syscall") fn worldBeginSyscall(
  world: *i64,
  slot: int,
  sp: int,
) {
  let m = wMut(world, slot)
  atomicStore(m + muFrame, 0)
  atomicStore(m + muSp, sp)
  atomicStore(m, mSyscall)
}

// Leave it. Same re-check as `endBlocking` and for the same reason — this slot
// was passed without acknowledging — then drops the snapshot, so a later
// collection cannot read a stale bound.
export @nosplit @symbol("bit_rt_port_gc_world_end_syscall") fn worldEndSyscall(
  world: *i64,
  slot: int,
) {
  worldResumeWhenClear(world, slot, mSyscall)
  atomicStore(wMut(world, slot) + muSp, 0)
}

// The stack pointer slot `slot` published on entering a syscall, or 0 if it is
// not in one. Same double-read of the state as `worldParkedFrame`, for the same
// reason: a bound that outlived its state would send a conservative scan over
// stack words that have since been reused.
export @nosplit @symbol("bit_rt_port_gc_world_syscall_sp") fn worldSyscallSp(
  world: *i64,
  slot: int,
): int {
  let m = wMut(world, slot)
  if (atomicLoad(m) != mSyscall) {
    return 0
  }
  let s = atomicLoad(m + muSp)
  if (atomicLoad(m) != mSyscall) {
    return 0
  }
  return s
}

// How many words `worldSyscallRegs` (../gc/gcworldsync.bit) points at.
export @nosplit @symbol("bit_rt_port_gc_world_syscall_reg_words") fn worldSyscallRegWords(): int {
  return muRegWords
}

// ---------------------------------------------------------------------------
// The collector side — `World.rendezvous` / `stoppedFor` / `restart`
// ---------------------------------------------------------------------------

// Whether slot `slot` counts as stopped for the collection at epoch `e`. A free
// or blocked slot always counts (blocked holds no live references by contract, so
// needs no ack). A parked slot counts only once it has acknowledged THIS epoch:
// a slot parked for an earlier stop is on its way out (see `worldMustStayPut`),
// so treating it as stopped would be the very race the epoch pair exists to close.
export @nosplit @symbol("bit_rt_port_gc_world_stopped_for") fn worldStoppedFor(
  world: *i64,
  slot: int,
  e: int,
): bool {
  let m = wMut(world, slot)
  let s = atomicLoad(m)
  if (s == mFree) {
    return true
  }
  if (s == mBlocked) {
    return true
  }
  // Like `blocked`, passed without an acknowledgement — but UNLIKE it, this slot
  // is still scanned (`worldSyscallSp`, ../stw/stw.bit). The thread is stopped
  // in the kernel, so its stack and saved registers cannot change while the
  // collection runs, which is what makes passing it safe (#1904).
  if (s == mSyscall) {
    return true
  }
  if (s == mParked) {
    return atomicLoad(m + muAcked) == e
  }
  return false
}

// Request a stop and wait until a WHOLE pass over the registry finds no other
// mutator still `running`. Returns false if the bounded wait expired, in which
// case the caller must abandon the collection (ABI.md §5). Caller holds the
// world lock (`worldLockAcquire`), so collectors cannot race each other.
//
// RE-SCANNING FROM THE TOP each pass is load-bearing, not defensive: a thread
// claims its slot on its first allocation or poll, which can land after this walk
// already passed that slot. Requiring one clean sweep makes registration order
// irrelevant; `claim` starting a slot `running` under a pending stop lets a
// registering thread park at its next safepoint rather than run behind the mark.
export @nosplit @symbol("bit_rt_port_gc_world_rendezvous") fn worldRendezvous(
  world: *i64,
  selfSlot: int,
): bool {
  // #5322: bump the epoch and (re)publish the stop only when this is a FRESH
  // collection. `stwPollOn`'s retry loop (../stw/stwpoll.bit) calls back in
  // here without ever calling `worldRestart` between rounds — same lock
  // holder, same collection — so the stop flag is already 1 on a retry, and
  // that is the signal to reuse. Reusing the epoch is what keeps every ack
  // already banked for it valid: `worldStoppedFor` below only counts a parked
  // slot whose ack matches the CURRENT epoch, so bumping here on a retry
  // would silently un-stop every slot the earlier round already collected —
  // exactly the livelock this ticket is about. A slot that has not yet acked
  // this epoch is unaffected either way, since it was never going to pass
  // `worldStoppedFor` until it does. seq_cst, paired with
  // `worldResumeWhenClear` — the Dekker store-then-load. `atomicAdd` returns
  // the PREVIOUS value, so +1 is this stop's epoch; epochs start at 1
  // (initial 0 acknowledges nothing).
  let e: int
  if (atomicLoad(world + worldStopWord) != 0) {
    e = atomicLoad(world + worldEpochWord)
  } else {
    e = atomicAdd(world + worldEpochWord, 1) + 1
    atomicStore(world + worldStopWord, 1)
    // #4203: tell every compiled mutator to look, AFTER the flag it must look at
    // — the release half of the back-edge poll's message-passing pair
    // (../sched/pollreq.bit). Without it a mutator in an allocation-free loop
    // never reaches the check below's rendezvous and this walk spins out its
    // whole `stwSpinBound` budget and abandons. Not re-issued on a retry: every
    // mutator that already passed through `stwSafepoint` (../stw/stwpoll.bit)
    // once re-derives and re-publishes this word itself, via `pollConsume`
    // (../sched/pollreq.bit), for as long as `stwPollNeeded`
    // (../stw/stwpoll.bit) still sees the stop pending, so it is already hot.
    pollRequest()
  }
  let spins = 0
  // Bounded by `stwSpinBound`; expiry returns false (abandon). #2415: every
  // `stwSpinBurst` checks, yield the CPU (`worldYield`, ./gcyield.bit) instead
  // of only spinning. A pure busy-spin measures this thread's own CPU
  // throughput, which is a proxy for wall-clock time only while the host is
  // idle — under contention it starves the very mutator it is waiting on,
  // because it never gives the scheduler an opening to run anything else.
  // Yielding periodically converts the same total budget into real scheduling
  // opportunities for that mutator, without weakening the bound: it is still
  // exactly `stwSpinBound` checks, still Power-of-10 bounded, and expiry still
  // abandons exactly as before (ABI.md §5) — see ./gcyield.bit's header for
  // the measurements this replaces.
  while (spins < stwSpinBound) {
    let stillRunning = false
    let i = 0
    // Bounded: exactly `maxMutators` slots.
    while (i < maxMutators) {
      if (i != selfSlot) {
        if (!worldStoppedFor(world, i, e)) {
          stillRunning = true
          break
        }
      }
      i = i + 1
    }
    if (!stillRunning) {
      return true
    }
    spins = spins + 1
    if (spins % stwSpinBurst == 0) {
      worldYield()
    }
  }
  return false
}

// Let every parked mutator go. Clears the stop; every waiter's
// `worldResumeWhenClear` observes it and resumes.
//
// THE WAKE IS GATED ON THE WAITER COUNT AND THAT GATE IS NOT AN OPTIMISATION
// DETAIL (#5750). This used to be one `atomicStore` and nothing else, and it
// runs on EVERY collection of EVERY program — including the single-mutator ones
// where nobody has ever waited out a stop. An unconditional `__ulock_wake`
// there would buy `bench/cases/allocpar` its parallel win by charging a syscall
// to `bench/cases/alloc` and to every other case in the suite, which is the
// #5722 shape exactly: a mechanism sized for the workload being thought about
// and wrong everywhere else. With the gate, the no-waiter restart costs one
// seq_cst load of a word in a cache line nothing on the poll path touches (see
// `worldWaiters`, ../gc/gcworld.bit) and a not-taken branch.
//
// A STALE READ IS SAFE IN BOTH DIRECTIONS, which is what makes a plain load
// enough: too high costs one wake on an empty queue (the provider reports 0
// woken), and too low cannot lose a wake, because a waiter that had not yet
// published its count had also not yet read the stop word — see the Dekker pair
// in `worldWaitForStop` above.
export @nosplit @symbol("bit_rt_port_gc_world_restart") fn worldRestart(world: *i64) {
  atomicStore(world + worldStopWord, 0)
  if (atomicLoad(world + worldWaiters) == 0) {
    return
  }
  let _ = bit_rt_port_gc_world_stop_wake(world + worldStopWord)
}

// ---------------------------------------------------------------------------
// The helper gang (#5837) — `World.gangOpen` / `gangClose`
// ---------------------------------------------------------------------------

// The collector block the currently open gang belongs to — plain module
// state (like `worldBlock`/`worldReady`/`mutHintSlot`, ./gcworldsync.bit,
// #2184: `@nosplit` may take an address of module state, so there is no need
// to thread this through the World block itself). Published by `worldGangOpen`
// as a seq_cst store BEFORE the epoch it gates on, and read by
// `worldGangTryHelp` only after that epoch's own seq_cst load confirms the
// gang is open — the same store-then-load order every publish/consume pair in
// this file uses, so a helper that observes the open epoch is guaranteed to
// observe THIS write, never a stale or torn one.
let gcGangBlock: i64 = 0

// Open the helper gang for the collection `stwRetryRendezvous` just won
// (`../stw/stwpoll.bit`'s `stwPollOn`, called only once rendezvous succeeds).
// `g` is the collector block `gcGangHelp` (../gc/gccollect.bit) will read.
//
// STORING 2 INTO `worldStopWord`, NOT LEAVING IT AT 1, is deliberate and is
// what #5837 means by keeping every reader of that word honest: every
// existing reader (`worldMustStayPut`, `worldStopRequested`, `stwPollNeeded`,
// `stwPollOn`'s inlined mirror) tests `!= 0`, never `== 1`, so a gang-open
// stop is stopped exactly as a plain one is. The distinct value only matters
// to `worldWaitForStop`'s blocking wait: a thread mid-way into that call reads
// the word BEFORE it sleeps and passes what it read as the kernel's own
// compare-and-wait value, so a value that visibly changed underneath it
// (rather than being restored to the same 1 a plain restart-then-restop could
// produce, see that function's own header) can never be mistaken for the
// stop this thread already knows about.
export @nosplit @symbol("bit_rt_port_gc_world_gang_open") fn worldGangOpen(world: *i64, g: int) {
  atomicStore(ptrOf(gcGangBlock), g)
  atomicStore(ptrOf(gcGangWorld), int(world))
  let e = atomicLoad(world + worldEpochWord)
  atomicStore(world + worldGangWord, e)
  atomicStore(world + worldStopWord, 2)
  let _ = bit_rt_port_gc_world_stop_wake(world + worldStopWord)
}

// The World block the last `worldGangOpen` opened a gang on, so a phase of
// the collection that has no `world` in hand (`sweep`, ./gcmark.bit) can
// wake the gang for new work (`worldGangKick`). Same publication order as
// `gcGangBlock`.
let gcGangWorld: i64 = 0

// Wake the helpers of the gang open on `g` because work was just published
// for them (#5838: the parallel sweep's span table, ./gcsweeppar.bit). A
// no-op when no gang is open on `g`: the caller then does all the work alone.
//
// A helper that found nothing to do in the mark phase went back to sleep on
// `worldStopWord` holding 2. Storing 3 is the same move `worldGangOpen`
// makes with 2: a sleeper's kernel compare now fails, and a thread between
// its load and its sleep reads the new value. That thread then compares
// against 3 and may sleep out one `stwWaitTimeoutUs`, which costs the sweep
// one helper for at most 1 ms and never correctness: the coordinator claims
// spans itself and needs no helper at all. The wake is gated on the waiter
// count exactly as `worldRestart`'s is, and for its reason.
@nosplit fn worldGangKick(g: *i64) {
  let world = wordAt(atomicLoad(ptrOf(gcGangWorld)))
  if (world == nil || atomicLoad(ptrOf(gcGangBlock)) != int(g)) {
    return
  }
  if (atomicLoad(world + worldGangWord) == 0) {
    return
  }
  atomicStore(world + worldStopWord, 3)
  if (atomicLoad(world + worldWaiters) == 0) {
    return
  }
  let _ = bit_rt_port_gc_world_stop_wake(world + worldStopWord)
}

// How long a drain may take before it is a runtime bug, and the static
// iteration cap under it (Power of 10 rule 2). See `worldDrainOrDie`.
const worldDrainBudgetNs = 10000000000
const worldDrainSpinBound = 1099511627776

// "gc: a collector helper never finished" (37), packed little-endian the way
// `stackmap.bit`'s messages are; module state so the fatal path allocates
// nothing.
const worldDrainMsgWord0: int = 8026294562428969831
const worldDrainMsgWord1: int = 2338053702233189484
const worldDrainMsgWord2: int = 7935468323430229352
const worldDrainMsgWord3: int = 7956002506270930533
const worldDrainMsgWord4: int = 431198073705
const worldDrainMsgLen: int = 37
let worldDrainMsg: [7]i64

// Wait until the counter at `p` reads 0, or die. `p` counts helpers inside a
// region the caller must not run past: `worldGangIn` for the whole gang, and
// the parallel sweep's claim-loop count (./gcsweeppar.bit).
//
// THERE IS NO GIVE-UP THAT PROCEEDS (#5838). Up to #5837 an expired drain was
// counted and the world restarted anyway, harmless while a helper only counted
// its join. Once a helper sweeps, running past it is heap corruption: a
// mutator allocating from a span a helper is still rebuilding. So expiry is
// `bit_rt_fatal`, the runtime's own-invariant door (see `stackmap.bit`).
//
// EXPIRY IS UNREACHABLE WITHOUT A BUG because every region counted here is
// bounded work: a helper inside the claim loop finishes the one span it holds
// (at most `allocSpanBytes / 16` slots), finds the cursor spent and leaves;
// outside that loop a join is a handful of loads. No helper blocks, sleeps or
// takes a lock while counted. What is left is the OS descheduling a helper,
// which is why the budget is wall-clock (10 s) rather than a spin count: a
// spin count is a few milliseconds on an idle core, well inside one
// scheduler quantum on a loaded box.
@nosplit fn worldDrainOrDie(p: *i64) {
  let t0 = gcTicks()
  let spins = 0
  while (spins < worldDrainSpinBound) { // bounded: worldDrainSpinBound checks
    if (atomicLoad(p) == 0) {
      return
    }
    spins = spins + 1
    if (spins % stwSpinBurst == 0) {
      if (gcTicks() - t0 > worldDrainBudgetNs) {
        break
      }
      worldYield()
    }
  }
  worldHelperFatal()
}

// End the process: a collector helper did not finish work the caller is
// about to run past. NEVER RETURNS. Also the parallel sweep's own check that
// every span it applies was swept (`gcSwApply`, ./gcsweeppar.bit).
@nosplit fn worldHelperFatal() {
  let msg: *i64 = ptrOf(worldDrainMsg)
  *msg = int(msg) + 16
  *(msg + 1) = worldDrainMsgLen
  *(msg + 2) = worldDrainMsgWord0
  *(msg + 3) = worldDrainMsgWord1
  *(msg + 4) = worldDrainMsgWord2
  *(msg + 5) = worldDrainMsgWord3
  *(msg + 6) = worldDrainMsgWord4
  bit_rt_fatal(int(msg))
}

// Close the helper gang and wait for every joined helper to leave, before the
// caller (`../stw/stwstats.bit`'s `stwFinishPause`) calls `worldRestart`.
//
// SAFE TO CALL UNCONDITIONALLY, including when the gang was never opened (an
// abandoned rendezvous never calls `worldGangOpen` at all): storing 0 into an
// already-0 `worldGangWord` is a no-op, and `worldGangIn` is then already 0,
// so the wait below returns on its very first check.
//
// INVARIANT, enforced here: `worldRestart` never runs with a helper inside.
// The store below stops new joins (`worldGangTryHelp`'s re-check), and the
// drain either reads 0 or ends the process (`worldDrainOrDie`).
export @nosplit @symbol("bit_rt_port_gc_world_gang_close") fn worldGangClose(world: *i64) {
  atomicStore(world + worldGangWord, 0)
  worldDrainOrDie(world + worldGangIn)
}
