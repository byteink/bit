// Linux's stop-wait provider (#5750). See ../gcstopwait.bit for the contract.
//
// DELIBERATELY STILL THE YIELD PATH, unchanged from what #5748 shipped: this
// body is one `gcWorldYield()` (./gcyield.bit, same module) and the wake is a
// no-op, so `worldResumeWhenClear` behaves on this target exactly as it did
// before #5750. The blocking wait is `futex(2)` here and would be a
// straightforward twin of the Darwin provider — `../../park/linux/wait.bit`
// already carries the FUTEX_WAIT/FUTEX_WAKE encoding this would use — but a win
// measured on one architecture is not a win until it is measured on the other,
// and #5750's numbers are aarch64-macos only. Porting it is its own ticket with
// its own A/B on Linux hardware.
//
// The sibling's `gcWorldYield` is called rather than re-declaring
// `sysSchedYield` here: a directory is one module (§17.1), so a second
// declaration of the same name would be E0042.
//
// `p`, `expected` and `timeoutUs` are accepted and unused, exactly as
// `parkWait`'s `scratch` is on the providers that do not need it: the ONE
// extern declaration in ../gcstopwait.bit must have a single signature every
// platform's provider satisfies.
export @nosplit @symbol("bit_rt_port_gc_world_stop_wait") fn gcWorldStopWait(
  p: *i64,
  expected: int,
  timeoutUs: int,
): int {
  return gcWorldYield()
}

// No waiter ever sleeps on this target, so there is never one to wake. Reports
// 0 woken, which is the same answer the Darwin provider gives for an empty
// wait queue and is what its caller already treats as normal.
export @nosplit @symbol("bit_rt_port_gc_world_stop_wake") fn gcWorldStopWake(p: *i64): int {
  return 0
}
