// Linux's `worldYield` provider (#2415). See ../gcyield.bit for why this
// exists as a paired module and what it fixes.
//
// `sched_yield(2)`: the raw Linux route, matching every other kernel call this
// runtime makes on this OS. `../../syscalls/syscalls.bit`'s `sysSchedYield`
// carries the per-architecture number — see that file's header for why the
// numbers live in one place rather than inlined here, and for the source
// tables (`syscall_64.tbl` / `unistd.h`) they come from.
import { sysSchedYield } from "../../syscalls"

export @nosplit @symbol("bit_rt_port_gc_world_yield") fn gcWorldYield(): int {
  return int(syscall(sysSchedYield()))
}
