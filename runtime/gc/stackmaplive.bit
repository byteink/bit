// Dead saved-register words at a back-edge poll, zeroed before a collection
// reads them (#7304, ABI.md §4).
//
// WHY. `bit_rt_safepoint` dumps the whole allocatable file into its
// `SafepointFrame`'s `regs[32]` (../stw/stwpoll.bit), and that frame lies
// inside the conservative ranges `stwScanTasks` walks (classes 8 and 10). A
// register the code after the poll no longer needs still holds its last value
// there, and a stale heap address keeps its object alive: #7294 measured
// x86_64-linux `bench/cases/strmap` marking 1.93x the objects because a dead
// `rdi` held a buffer `bit_rt_slice_append` had abandoned.
//
// WHICH WORDS. A word is dead when the poll's `live_regs` mask (#7303,
// `smLiveRegsIn`) leaves its bit clear AND it holds no caller's value. A
// register the target ABI preserves across calls that this function never
// saves still carries a caller's value, which the precise walk reads for the
// frames further out, so it is kept. One the prologue saved is dead here: the
// caller's value sits in the save slot, where `smRestoreSaved` and the stack
// scan both find it.
//
// ZEROED, NOT SKIPPED. The shim reloads its caller-saved words on the way out,
// so a mask that misses a live register zeroes it and the program fails under
// `BIT_GC=stress`, instead of a live object being freed in silence. An unknown
// mask (version-1 entry, call safepoint, `ret` 0) zeroes nothing.

// The `BuildTarget` ordinal of this archive (compiler/build.bit): 0
// x86_64-linux, 1 aarch64-linux, 2 aarch64-macos, 3 x86_64-windows.
extern fn bit_rt_host_target(): int

// The registers the target ABI preserves across a call, as a mask over
// `regs[n]`. An unknown target answers all 32, which keeps every word the
// function did not save: the sound default.
@nosplit fn smCalleeSavedRegs(): int {
  let t = bit_rt_host_target()
  if (t == 0) {
    return 0xF028 // SysV: rbx, rbp, r12..r15
  }
  if (t == 3) {
    return 0xF0E8 // Win64: SysV's set plus rsi, rdi
  }
  if (t == 1 || t == 2) {
    return 0x1FF80000 // AAPCS64: x19..x28
  }
  return 0xFFFFFFFF
}

// The registers the prologue of the entry at `off` saved, as a mask over
// `regs[n]`. The caller has proven the saved span through `smSpsStart`.
@nosplit fn smSavedRegs(base: int, off: int): int {
  let numSaved = blobU16(base, off + 14)
  let m = 0
  let k = 0
  // Bounded: this entry's saved-register count.
  while (k < numSaved) {
    let rn = blobU16(base, off + 16 + k * 6)
    if (rn < smNumRegs) {
      m = m | (1 << rn)
    }
    k = k + 1
  }
  return m
}

// The `regs[n]` words of a poll frame returning to `pc` that hold nothing
// live: clear in the poll's mask and no caller's value. 0 when `pc` records no
// mask.
export @nosplit fn smDeadRegsAt(pc: int): int {
  let off = smFindEntry(pc)
  if (off < 0) {
    return 0
  }
  let live = smLiveRegsIn(smTblBase(), smTblLen(), off, pc)
  if (live == smLiveUnknown) {
    return 0
  }
  let callers = smCalleeSavedRegs() & ~smSavedRegs(smTblBase(), off)
  return ~(live | callers) & 0xFFFFFFFF
}

// PINNED: `runtime/stw`'s collector reaches this across a module boundary
// (SPEC §11.9), as it reaches `gcScanSnapshot`. Zeroes the dead `regs[n]`
// words of the `SafepointFrame` at `snapAddr`; run before the precise walk and
// the conservative scans read the frame.
export @nosplit @symbol("bit_rt_port_gc_zero_dead_regs") fn gcZeroDeadRegs(snapAddr: int) {
  if (snapAddr == 0) {
    return
  }
  let ret = loadWord(snapAddr + sfRet)
  if (ret == 0) {
    return
  }
  let dead = smDeadRegsAt(ret)
  let n = 0
  // Bounded: exactly `smNumRegs` words.
  while (n < smNumRegs) {
    if (((dead >> n) & 1) != 0) {
      storeWord(snapAddr + sfRegs + n * 8, 0)
    }
    n = n + 1
  }
}
