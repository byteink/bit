// A rendezvous that gave up names the slot that never answered (#6423).
//
// WHY THIS EXISTS. `worldRendezvous` (./gcworldstop.bit) waits for every other
// slot to reach a stopped state, and the only thing that keeps a slot from ever
// doing so is a thread that stopped polling without saying so: a kernel wait
// or foreign call that no `gcBlockingBegin`/`gcBlockingEnd` brackets, which is
// the ABI.md section 5 contract. The cost used to be silent: #6412's stub held
// a slot `running` across a blocking `recvfrom` and every other thread was
// frozen 20-24 s per collection attempt, found only through two red push
// gates. An abandoned collection is safe by design, so nothing ever said which
// thread caused it. This file is that statement: once per process, on stderr,
// the first time a rendezvous gives up with a slot still unstopped.
//
// WHAT IT CAN AND CANNOT SAY. The slot id and its last published state are
// read straight from the registry. "How long" is the time the stop has been
// pending with this slot unanswered, which is a LOWER bound on how long the
// thread has been out of Bit code: the registry keeps no per-slot timestamp,
// and adding one would put a clock read on every `gcBlockingBegin`/`End`,
// which a scheduler worker executes once per idle spell.
//
// TWO STEPS, NOT ONE. `worldStuckNote` runs while the world is still stopped
// and only composes the text into module state, because a `write` to a blocked
// stderr pipe would otherwise hold every parked thread behind it.
// `worldStuckEmit` runs after `worldRestart` and writes it. Both are called
// by the world-lock holder only, so the buffer has one writer; the once-guard
// is an atomic anyway so a private world driven from a test cannot double it.
//
// The two externs are the root module's own pinned helpers (the same
// per-OS bodies `BIT_GC_STATS` uses, one symbol on all three targets), so this
// file needs no per-OS provider.
extern fn bit_rt_port_root_io_write_all(fd: int, addr: int, n: int)
extern fn bit_rt_port_root_os_write_decimal(dst: int, v: int): int

// Rendezvous that gave up with a named slot, whole run (`stuck=`, BIT_GC_STATS).
let worldStuckCount: i64 = 0
// 0 until the first report claims it; the claimer alone composes the text.
let worldStuckClaim: i64 = 0
// Bytes of composed text waiting for `worldStuckEmit`, 0 when none.
let worldStuckLen: i64 = 0
// Fixed text is 227 bytes at its longest (the state name is 7) plus five
// decimals of at most 20 bytes each: 327 bytes. 48 words is 384. `storeByte`
// writes through a raw address, so an undersized block would run off the end
// in silence (#1682).
let worldStuckBuf: [48]i64

@nosplit fn stuckConst(at: int, word: int, nbytes: int): int {
  let base = int(ptrOf(worldStuckBuf))
  let w = word
  let i = 0
  while (i < nbytes) {
    storeByte(base + at + i, w & 255)
    w = w >> 8
    i = i + 1
  }
  return at + nbytes
}

@nosplit fn stuckNum(at: int, v: int): int {
  return at + bit_rt_port_root_os_write_decimal(int(ptrOf(worldStuckBuf)) + at, v)
}

// The name of a mutator state. The registry has exactly these five; anything
// else is a layout bug and reads "unknown" rather than being guessed at.
@nosplit fn stuckState(at: int, state: int): int {
  if (state == mRunning) {
    return stuckConst(at, 29113321704551794, 7) // "running"
  }
  if (state == mParked) {
    return stuckConst(at, 110386757132656, 6) // "parked"
  }
  if (state == mFree) {
    return stuckConst(at, 1701147238, 4) // "free"
  }
  if (state == mBlocked) {
    return stuckConst(at, 28259009575218274, 7) // "blocked"
  }
  if (state == mSyscall) {
    return stuckConst(at, 30518463020890483, 7) // "syscall"
  }
  return stuckConst(at, 31093567915781749, 7) // "unknown"
}

// The first slot other than `selfSlot` that is not stopped for epoch `e`, or -1.
// Bounded: exactly `maxMutators` slots.
@nosplit fn stuckFirst(world: *i64, selfSlot: int, e: int): int {
  let i = 0
  while (i < maxMutators) {
    if (i != selfSlot && !worldStoppedFor(world, i, e)) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Compose the line for slot `slot`; returns its length.
@nosplit fn stuckCompose(world: *i64, slot: int, waitedNs: int): int {
  let m = wMut(world, slot)
  let at = 0
  at = stuckConst(at, 6729335713145905755, 8) // "[bit-gc]"
  at = stuckConst(at, 7526690838172431136, 8) // " stop-th"
  at = stuckConst(at, 2334109745636912485, 8) // "e-world "
  at = stuckConst(at, 7308901722408182369, 8) // "abandone"
  at = stuckConst(at, 2338042707166961764, 8) // "d after "
  at = stuckNum(at, waitedNs / 1000000)
  at = stuckConst(at, 8028918817951542560, 8) // " ms: slo"
  at = stuckConst(at, 8308, 2)                // "t "
  at = stuckNum(at, slot)
  at = stuckConst(at, 7233174018586847264, 8) // " (thread"
  at = stuckConst(at, 9128581127959584, 7)    // " token "
  at = stuckNum(at, atomicLoad(m + muOwner))
  at = stuckConst(at, 7598825054493286441, 8) // ") is sti"
  at = stuckConst(at, 2124908, 3)             // "ll "
  at = stuckState(at, atomicLoad(m))
  at = stuckConst(at, 2334102018787977248, 8) // " (acked "
  at = stuckConst(at, 35632716935269, 6)      // "epoch "
  at = stuckNum(at, atomicLoad(m + muAcked))
  at = stuckConst(at, 7286947821082845228, 8) // ", stop e"
  at = stuckConst(at, 139190300528, 5)        // "poch "
  at = stuckNum(at, atomicLoad(world + worldEpochWord))
  at = stuckConst(at, 7308814860989571113, 8) // ") and ne"
  at = stuckConst(at, 7161116423340844406, 8) // "ver reac"
  at = stuckConst(at, 7021991845528102248, 8) // "hed a sa"
  at = stuckConst(at, 4284170544656442726, 8) // "fepoint;"
  at = stuckConst(at, 8387227955628237344, 8) // " bracket"
  at = stuckConst(at, 2336353831738501920, 8) // " kernel "
  at = stuckConst(at, 7310027629596536417, 8) // "and fore"
  at = stuckConst(at, 7812726531954730857, 8) // "ign call"
  at = stuckConst(at, 7431054234356228211, 8) // "s with g"
  at = stuckConst(at, 7956008291541992035, 8) // "cBlockin"
  at = stuckConst(at, 7435282908797289063, 8) // "gBegin/g"
  at = stuckConst(at, 7956008291541992035, 8) // "cBlockin"
  at = stuckConst(at, 4774141199578449255, 8) // "gEnd (AB"
  at = stuckConst(at, 7162257365363666505, 8) // "I.md sec"
  at = stuckConst(at, 732174827832437108, 8)  // "tion 5)\n"
  return at
}

// Called by the collector (world lock held, stop still pending) when the
// rendezvous has just given up after `waitedNs`. Counts the event and, the
// first time in the process, composes the line for `worldStuckEmit`. A
// rendezvous that gave up but now finds every slot stopped (the straggler
// answered in the gap) names nobody and counts nothing.
export @nosplit @symbol("bit_rt_port_gc_world_stuck_note") fn worldStuckNote(
  world: *i64,
  selfSlot: int,
  waitedNs: int,
) {
  let slot = stuckFirst(world, selfSlot, atomicLoad(world + worldEpochWord))
  if (slot < 0) {
    return
  }
  let _ = atomicAdd(ptrOf(worldStuckCount), 1)
  if (atomicAdd(ptrOf(worldStuckClaim), 1) != 0) {
    return
  }
  atomicStore(ptrOf(worldStuckLen), stuckCompose(world, slot, waitedNs))
}

// Write the line `worldStuckNote` composed, if any. Called by the collector
// after `worldRestart`, so no thread is held behind the write.
export @nosplit @symbol("bit_rt_port_gc_world_stuck_emit") fn worldStuckEmit() {
  let n = atomicLoad(ptrOf(worldStuckLen))
  if (n == 0) {
    return
  }
  atomicStore(ptrOf(worldStuckLen), 0)
  bit_rt_port_root_io_write_all(2, int(ptrOf(worldStuckBuf)), n)
}

// `stuck=` (BIT_GC_STATS): rendezvous that gave up with a slot still unstopped.
export @nosplit @symbol("bit_rt_port_gc_world_stuck_count") fn worldStuckTotal(): int {
  return atomicLoad(ptrOf(worldStuckCount))
}
