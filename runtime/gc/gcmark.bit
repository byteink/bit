// Split out of ./gc.bit (#1503): the mark phase and the sweep.

import { schedStackHeadroom } from "../sched"

// The green-stack-exhaustion door — see ../root/darwin/io.bit's own comment
// on the implementation (kept function-for-function across all three
// platform ports) for the full reasoning. Declared `extern` rather than
// imported: `runtime/root/{linux,darwin,windows}` is platform-specific (three
// separate definitions), and this module must stay buildable without picking
// one, exactly the argument `./mem.bit`'s `bit_rt_oom` seam already makes for
// the same shape.
extern fn bit_rt_gc_mark_stack_overflow(): i64

// ---------------------------------------------------------------------------
// Marking
// ---------------------------------------------------------------------------

// Bytes of stack headroom the mark path insists on before it will queue and
// trace another object (#3374). `schedStackHeadroom` (`../sched/headroom.bit`)
// answers the distance from the live `sp` down to the point where further
// growth starts overwriting the current task's OWN self-pointer/tag instead
// of faulting — the real edge for a task, not the guard page below it, which
// a small, steady chain of frames like this one's can cross into without
// ever touching. #3177's bitmap reader is the sizing reference: it added
// ~224 bytes to this exact chain and took bench/cases/json from clean to
// crashing on roughly half its runs. This floor is 18x that, so the present
// chain and a comparable future addition both clear it with room to spare.
//
// RE-DERIVED (#3749) against a workload that actually runs ON A MASKED TASK
// STACK, not `main`'s: a scratch probe (`spawn`ed, `descend()` recursing with
// a 64-word touched local, same technique as `_tests_/stress/deeprecursion.bit`)
// measured real, monotonic headroom on a 256KiB masked stack —
// `schedStackHeadroom()` read 259576 bytes at depth 0 and 4088 at depth 998,
// a real, reproducible ~256 bytes/frame for that recursion shape. The floor
// sits 16 such frames above zero at that rate, comfortably inside the small,
// FIXED (non-recursive across objects — `drain()` below is a loop, not
// recursion) `drain`/`scanObject`/`gcMarkRoot`/`markObject` chain's own frame
// budget, which is what the 18x-of-224-bytes margin above actually bounds.
// The SAME probe run against `main`'s own (registered, oversized) stack
// measured the identical ~256 bytes/frame (8385992 bytes at depth 0, 4040 at
// depth 32742) — confirming the per-frame cost is a property of the code, not
// of which physical stack it runs on, exactly as `schedStackHeadroom`'s
// header (`../sched/headroom.bit`) now states. Both runs' `markStackTight()`
// flipped true exactly once, at the transition, with the overflow panic never
// reached (this probe calls `markStackTight()` directly, bypassing
// `markObject`'s panic branch by construction). `bench/cases/json` reruns
// identically before and after the `../sched/headroom.bit` fix —
// 5,832,947 calls, 0 true, 0 overflow both times — because its own recursion
// never comes remotely close to either stack's floor; the fix makes the
// guard ABLE to fire on `main`, not more likely to.
const markStackMinHeadroom: int = 4096

// True if the current stack does not have `markStackMinHeadroom` bytes to
// spare for another step of marking. `schedHeadroomUnknown` covers the one way
// `schedStackHeadroom` legitimately reports "not a threat" that is not a real
// headroom value at or above the floor: a boot thread or an idle worker's own
// OS thread stack, which owns no task at all (see `schedStackHeadroom`'s own
// header, `../sched/headroom.bit`, #3749). Both compare TRUE here without a
// separate branch, because the sentinel is deliberately many times larger
// than `markStackMinHeadroom` could ever be raised to.
@nosplit fn markStackTight(): bool {
  return schedStackHeadroom() < markStackMinHeadroom
}

@nosplit fn markObject(g: *i64, h: int) {
  if (hdrMarked(h)) {
    return
  }
  if (markStackTight()) {
    let _ = bit_rt_gc_mark_stack_overflow()
  }
  hdrSetMark(h)
  let top = *(g + gcStackTop)
  if (top < *(g + gcStackLen)) {
    storeWord(*(g + gcStackAddr) + top * 8, h)
    *(g + gcStackTop) = top + 1
  } else {
    // Worklist full: the object is marked (so it survives) but its children are
    // not yet traced. A rescan pass will scan it.
    *(g + gcOverflow) = 1
  }
}

// Mark a single reference, marking it ONLY IF it is exactly the body base of a
// live managed object. Null, interior pointers, and foreign pointers are
// ignored.
//
// The validation is not defensive nicety. The type system calls several
// single-word pointers "references" that are NOT GC objects — a `chan` handle is
// page-allocated and process-lifetime, a bare function value is a code address —
// and both the stack maps (ABI.md §4) and object pointer maps (§2) legitimately
// list them. Feeding one to a blind mark would decode `ptr - 32` as a bogus
// header and corrupt or crash. The O(1) address-bounds gate rejects the common
// foreign pointer; `gcOwns` is the exact backstop.
export @nosplit fn gcMarkRoot(g: *i64, ref: int) {
  if (ref == 0) {
    return
  }
  if (ref < *(g + gcLoAddr) || ref >= *(g + gcHiAddr)) {
    return
  }
  if (gcOwns(g, ref)) {
    markObject(g, headerFromBody(ref))
  }
}

// Mark one raw machine word from a conservative root source (a parked task's
// stack scan, ABI.md §5; a buffered channel word, §11). A front door for
// `gcMarkRoot`, which does the actual validation — sound because the collector
// is non-moving, so a false positive only retains garbage.
//
// PINNED (ABI.md §9), unlike its `gcMarkRoot` sibling: it is the mark entry
// point a SEPARATE module calls across the object boundary — `runtime/chan`'s
// `chanScanRegistryRoots` (#1602) pushes every buffered reference word through
// it, mirroring `runtime/root/`'s `markChanWord`, and `chanDriveCollection` (#1610)
// uses it for the precise roots it enumerates alongside the registry. A sibling
// object spells that cross-module call by the callee's emitted symbol, and an
// unpinned export would be `m<N>$gcMarkConservative`, a name no separately
// emitted object can define (SPEC §11.9). (`gcMarkBegin`/`gcCollectFinish` are
// likewise pinned now, as the phase pair `chanDriveCollection` brackets the scan
// with; `gcMarkRoot` stays unpinned — no separate object calls it directly.) The
// `bit_rt_port_` prefix is the placeholder every ported symbol carries until
// #1369 strips `port_`.
export @nosplit @symbol("bit_rt_port_gc_mark_conservative") fn gcMarkConservative(
  g: *i64,
  word: int,
) {
  if (word != 0) {
    gcMarkRoot(g, word)
  }
}

// Trace one object's reference fields.
@nosplit fn scanObject(g: *i64, h: int) {
  let body = bodyFromHeader(h)
  let infoAddr = loadWord(h + gcHdrInfo)

  // A reference element buffer has no static pointer map: trace every word of
  // the (dynamically sized) body as a potential root. Trailing/unset words read
  // as null and are skipped by `gcMarkRoot`. Bounded by the buffer's word count.
  if (infoAddr == *(g + gcRefArrayInfo)) {
    // `hdrSize`, not a bare `loadWord`: `scanObject` only ever runs on objects
    // `markObject` has already marked, so the raw word is NEGATIVE here and an
    // unmasked read gives a negative `nwords`, skips the loop entirely and
    // leaves every element of a reference buffer untraced (#4083).
    let nwords = (hdrSize(h) - gcHeaderSize) / 8
    let w = 0
    while (w < nwords) {
      gcMarkRoot(g, loadWord(body + w * 8))
      w = w + 1
    }
    return
  }

  let offs = loadWord(infoAddr + gcTiPtrOffsetsPtr)
  let n = loadWord(infoAddr + gcTiPtrOffsetsLen)
  let size = loadWord(infoAddr + gcTiSize)
  let i = 0
  // Bounded: the number of pointer fields this type declares.
  while (i < n) {
    let off = loadWord(offs + i * 8)
    // Constraint 5: rather than assert, a violating offset is counted and
    // skipped rather than read out of bounds.
    if (off % 8 != 0 || off + 8 > size) {
      *(g + gcStBadOffset) = *(g + gcStBadOffset) + 1
    } else {
      gcMarkRoot(g, loadWord(body + off))
    }
    i = i + 1
  }
}

// Trace every queued object's reference fields until the worklist drains.
@nosplit fn drain(g: *i64) {
  // Bounded: each object is queued at most once (guarded by the mark bit), so
  // total pops across the whole mark phase is <= num_objects.
  while (*(g + gcStackTop) > 0) {
    let top = *(g + gcStackTop) - 1
    *(g + gcStackTop) = top
    scanObject(g, loadWord(*(g + gcStackAddr) + top * 8))
  }
}

// After a worklist overflow, some marked objects were never traced. Rescan all
// marked objects, re-queueing their children, until no overflow remains.
// Terminates because every overflow pass marks at least one new object and the
// mark count is bounded by `num_objects`.
@nosplit fn recoverOverflow(g: *i64) {
  let passes = 0
  let maxPasses = *(g + gcNumObjectsIdx) + 1
  while (*(g + gcOverflow) == 1 && passes < maxPasses) {
    *(g + gcOverflow) = 0
    let o = *(g + gcAll)
    // Bounded: num_objects links.
    while (o != 0) {
      if (hdrMarked(o)) {
        scanObject(g, o)
      }
      o = loadWord(o + gcHdrNext)
    }
    drain(g)
    passes = passes + 1
  }
}

// ---------------------------------------------------------------------------
// Sweep
// ---------------------------------------------------------------------------

// PRECONDITION: the caller holds `heapLock(g)` (#4319). Both call sites —
// `sweep` below and `gcDeinit`'s object loop (`./gc.bit`) — take it once around
// their whole loop, so this reaches `gcHeapFreeLocked` rather than the
// acquire/release form. Nothing else here touches that lock: `idxRemove`
// (`./gcindex.bit`) takes none at all and cannot grow the table, and
// `clearSlotBit` (`./gcalloc.bit`) is a lone `atomicAnd`.
@nosplit fn freeObject(g: *i64, h: int) {
  let size = hdrSize(h)
  let idx = allocClassify(size, 8)
  // #3178: mirror `linkObject`'s insert gate — only a large (non-span-backed)
  // object ever had a hash-index body key to remove.
  if (idx < 0 && *(g + gcIndexOk) == 1) {
    idxRemove(g, bodyFromHeader(h))
  }
  // #3147/#3176: clear the occupied-slot bitmap bit BEFORE the allocator gets
  // the slot back — see `setSlotBit`/`clearSlotBit` in `./gcalloc.bit`.
  clearSlotBit(h, idx)
  // #4043: `gcHeapFree` used to re-derive `idx` from the same `size`. It is one
  // value; it is computed once, here, and passed down.
  gcHeapFreeLocked(g, h, size, 8, idx)
}

// Free every unmarked object and clear the mark on survivors. Returns the
// number of objects reclaimed.
//
// A pointer-to-pointer walk would be natural here; Bit has
// no `&`, so the equivalent is an explicit `prev` (0 meaning "the list head").
// Same traversal, same order, same result.
//
// ONE HEAP-LOCK ACQUIRE FOR THE WHOLE LOOP (#4319), NOT ONE PER OBJECT.
// `gcHeapFree` took and released it per freed object — ~55,000 acquire/release
// pairs per collection on `bench/cases/alloc` (10,002,000 objects over 181
// collections), four barriers each, for a lock that is uncontended by
// construction.
//
// THE WORLD IS STOPPED HERE, AND THAT IS THE INVARIANT THE HOIST RESTS ON.
// `sweep` has exactly one caller, `gcCollectFinish` (`./gccollect.bit`), and
// that has exactly three:
//
//   1. `stwCollect` (`../stw/stw.bit`), reached only from `../stw/stwpoll.bit`
//      after `worldLockTry` AND `worldRendezvous` both succeed — every other
//      mutator is parked at a safepoint. A rendezvous that times out abandons
//      the collection instead of forcing it, so this path never runs with a
//      mutator live. This is the only path a real program takes.
//   2. `chanDriveCollection` (`../chan/chanreg.bit`) — pinned for the
//      single-threaded `_tests_/stress/chan*` harnesses, which drive it by hand.
//   3. `gcCollectRoots` (`./gccollect.bit`), the root-ARRAY entry the
//      `_tests_/stress/gc*` harnesses and the differential drive, likewise
//      single-threaded.
//
// So no other thread can be inside `gcHeapAlloc` — the only other acquirer of
// this lock (`./gc.bit`, three acquire sites in the whole runtime) — while this
// runs. The lock is kept rather than deleted because the invariant is a
// property of the CALLERS, which nothing mechanically enforces: a future
// non-stopped caller would find the free path still mutually excluded.
//
// NO SELF-DEADLOCK: the spinlock is not recursive, and nothing reachable from
// this loop acquires `heapLock` again. `freeObject`'s own header lists what it
// reaches; `gcHeapFreeLocked` nests only the object-list lock (via
// `idxRemoveSpan`), which is the sanctioned order (`./gc.bit`, `./gcindex.bit`:
// nothing reachable under the list lock ever takes the heap lock) and is
// already what `gcHeapFree` did today. Nothing here allocates, so nothing can
// reach `reserveGrow`. Every function on the path is `@nosplit`, so no
// safepoint poll can run with the lock held.
@nosplit fn sweep(g: *i64): int {
  let swept = 0
  let prev = 0
  let h = *(g + gcAll)
  spinAcquire(heapLock(g))
  // Bounded: num_objects links.
  while (h != 0) {
    let next = loadWord(h + gcHdrNext)
    if (hdrMarked(h)) {
      hdrClearMark(h)
      prev = h
    } else {
      // Unlink before freeing.
      if (prev == 0) {
        *(g + gcAll) = next
      } else {
        storeWord(prev + gcHdrNext, next)
      }
      *(g + gcNumObjectsIdx) = *(g + gcNumObjectsIdx) - 1
      swept = swept + 1
      freeObject(g, h)
    }
    h = next
  }
  spinRelease(heapLock(g))
  return swept
}
