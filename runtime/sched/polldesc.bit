// Per-fd waiter-slot table (#5864, epic #5849): the register-once,
// edge-triggered netpoller's core data structure, proven here with NO wiring
// into `./linux/poll.bit`, `./darwin/poll.bit` or `runtime/net/**` -- those
// are #5865 (darwin) and #5866 (linux). This file owns only the table and its
// claim/wake/cancel/close protocol.
//
// THE SHAPE (#5861 comment 3's design): a socket fd is registered with the
// kernel poller ONCE, for its whole life, edge-triggered. What used to be a
// register-then-retract syscall pair on every wait becomes one word of
// bookkeeping here instead -- a "slot" per (fd, direction) that a task parks
// itself into, and that a kernel readiness event, a timer race, or a close
// resolves. Same role as Go's `pollDesc`/`runtime_pollWait` or .NET's
// `SocketAsyncEngine` registration table.
//
// NO GC HEAP, NO LOCK ON THE WAIT/WAKE PATH (ticket constraint). The table is
// three fixed-size module-level arrays (`.bss`, allocated once at program
// load, never resized -- Power of 10's "no unbounded allocation after
// startup"), and every operation below is a bounded number of
// `atomicCmpxchg`/`atomicLoad` calls, never a spin-lock.
//
// ---------------------------------------------------------------------------
// The packed slot word, and why the generation lives INSIDE it
// ---------------------------------------------------------------------------
//
// `pdRSlot[fd]` / `pdWSlot[fd]` each hold ONE 64-bit word: the fd's
// generation in the high `pdGenBits` bits, and the slot's own state in the
// low `pdTaskBits` bits (`pdPack`/`pdTaskOf`/`pdGenOf`). The low field is one
// of pdEmpty (0, nobody waiting), pdReady (all `pdTaskBits` bits set, a
// readiness edge arrived with nobody parked to catch it), or a task id
// (1..pdReady-1, exactly one task parked here).
//
// Packing them together means every state transition below is ONE
// compare-and-swap whose EXPECTED value already carries the generation, so a
// stale generation makes the CAS itself fail -- there is no separate
// recheck, and therefore no window in which a transition is transiently
// visible before being undone. `pdTaskBits`=44 gives 16 TiB of task-id range,
// far past any address this runtime's green-thread stacks or heap can reach;
// the remaining `pdGenBits`=20 wraps a single fd's generation only after
// 1,048,576 open/close cycles -- even a sustained, unrealistic 100k
// reopens/sec would need ten seconds of continuous scheduling starvation on
// ONE stale operation to collide with it, far past any pause `BIT_GC=stress`
// or a real GC produces.
//
// TWO EARLIER DESIGNS, BOTH REPLACED. #5864's original shipped a separate
// `pdGenTable[fd]` word, checked by re-reading it immediately after a plain
// CAS and undoing the write if it had moved. That left a real window: a
// `pdClose` racing the tail of that undo could read the slot back-to-empty
// before the undo landed, and (since it trusted a single "empty" read as
// final) report "nobody was waiting" for a task about to be restored right
// behind it -- caught live under `BIT_WORKERS=8 BIT_GC=stress`
// (`resolved 9599 bad 1` on the #5864 stress program). The first attempted
// fix reordered `pdClose`/`pdOpen` to sweep before bumping the separate gen
// word, which closed that window but opened its mirror: a `pdWait` racing a
// sweep that had ALREADY run could still CAS its task in under the
// not-yet-bumped generation and park with nobody left to ever wake it --
// caught by `waitCloseDriver` below, added for exactly this case (27/30
// failures at `BIT_WORKERS=8 BIT_GC=stress` on that reorder alone). Packing
// the generation into the SAME word the state transition CASes removes the
// two-word gap both designs still had, rather than reordering around it.
//
// ---------------------------------------------------------------------------
// The invariants
// ---------------------------------------------------------------------------
//
// INVARIANT 1 (exactly-once wake): a parked task id is removed from a slot by
// exactly one of `pdWake`, `pdCancel` or `pdSweep` (`pdClose`'s sweep) --
// all three transition the slot only through a single `atomicCmpxchg` on the
// full packed word, so at most one of them can ever observe the task id and
// swap it out.
//
// INVARIANT 2 (no lost edge): an edge that arrives before any waiter is
// recorded (`pdEmpty` -> `pdReady`, same generation) rather than dropped, and
// the next `pdWait` on that slot consumes it immediately instead of parking.
// Enforced by `pdWaitStep`'s `pdReady` branch and `pdWakeStep`'s `pdEmpty`
// branch.
//
// INVARIANT 3 (stale-gen events are ignored, never corrupt a live slot): the
// generation packed into a slot word is bumped by every `pdOpen`/`pdClose`
// (`pdGenTable[fd]`, the source of the NEXT generation number, masked into
// `pdGenBits` when packed -- see `pdGenTag`). Every transition's CAS expects
// the caller's generation packed alongside the old state, so a stale
// generation makes the CAS fail outright, before any state is ever written.
// This is what lets a wake or cancel computed against a closed-and-reused fd
// number touch nothing.
//
// INVARIANT 4 (close wakes every waiter): `pdClose` unconditionally
// transitions both slots to the new generation's empty state (`pdSweep`,
// looping past ordinary CAS contention from a concurrent wake/cancel/wait,
// never past a generation mismatch since `pdSweep` sets the target
// generation itself) and reports whatever task id it displaced. A task
// parked in either direction is therefore always reported to the caller
// closing the fd.
//
// ---------------------------------------------------------------------------
// What is deliberately NOT here
// ---------------------------------------------------------------------------
//
// No call to `schedPark`, `schedParkArm`, `schedTimerPush` or either
// platform's `pollRegister`/`pollDrain` -- this file has no scheduler or
// syscall dependency at all (zero imports), so it is buildable and testable
// standalone. #5865/#5866 combine `pdWait`'s return with the task-parking
// protocol and the one-time kernel registration; this file only has to be
// correct about who owns a slot and when an edge is delivered.

// Read/write direction, matching `pollRead`'s sense in `../sched.bit` (0 =
// read) so a caller does not need a second mapping between the two modules.
export const pdDirRead: int = 0
export const pdDirWrite: int = 1

// Slot contents: 0 = empty. Never a valid task id (task addresses are
// non-zero pointers cast to `int`, and this table's own caller-chosen ids in
// tests/wiring must follow the same rule -- `pdWait`/`pdCancel` reject a
// non-positive `taskId`).
export const pdEmpty: int = 0

// `pdWait`'s answer.
export const pdClaimed: int = 0      // the slot now holds `taskId`; go park.
export const pdAlreadyReady: int = 1 // an edge was already there; consumed.
export const pdStaleGen: int = 2     // `gen` is no longer this fd's generation.
export const pdBusy: int = 3         // the slot is held by a different waiter.

// Fd range this table covers. A literal, not `pdCapacity`, because a
// fixed-array length must be a literal (E0021 -- see `./preempt.bit`'s
// `preemptSlots` for the same constraint). 65536 is generous headroom over
// every default and raised `ulimit -n` this runtime is likely to run under,
// and the three tables below cost 65536 * 3 * 8 = 1.5MiB of `.bss`, paid once
// at load, never reallocated.
export const pdCapacity: int = 65536

let pdGenTable: [65536]i64
let pdRSlot: [65536]i64
let pdWSlot: [65536]i64

// Packed slot word layout: `pdTaskBits` low bits for state, `pdGenBits` high
// bits for generation -- see the header's "packed slot word" section for the
// width reasoning. `pdReady` is the low field's all-ones value, distinct from
// 0 (empty) and from every real task id, which is masked to fewer bits.
const pdTaskBits: int = 44
const pdGenBits: int = 64 - pdTaskBits
const pdTaskMask: int = (1 << pdTaskBits) - 1
const pdGenLimit: int = 1 << pdGenBits
const pdReady: int = pdTaskMask

// CAS retry bound for a single slot under real contention: at most a handful
// of actors ever touch one (fd, direction) at once -- the parking task, one
// drain, one timer cancel, one close -- so this is generous rather than
// tuned, and it is what keeps every loop below statically bounded (Power of
// 10). Exhausting it returns `pdBusy`/`pdEmpty` rather than looping forever.
const pdMaxRetries: int = 8

// Per-step retry sentinels, distinct from every real return value: `pdWait`'s
// codes are 0-3, `pdWake`'s are 0 or a positive task id.
const pdWaitRetry: int = 0 - 1
const pdWakeRetry: int = 0 - 1

@nosplit fn pdValidFd(fd: int): bool {
  return fd >= 0 && fd < pdCapacity
}

@nosplit fn pdValidDir(dir: int): bool {
  return dir == pdDirRead || dir == pdDirWrite
}

@nosplit fn pdGenAddr(fd: int): *i64 {
  return ptrOf(pdGenTable) + fd
}

@nosplit fn pdSlotAddr(fd: int, dir: int): *i64 {
  if (dir == pdDirRead) {
    return ptrOf(pdRSlot) + fd
  }
  return ptrOf(pdWSlot) + fd
}

// Mask a raw, ever-growing `pdGenTable` value down to the `pdGenBits` a
// packed word actually carries. `pdGenTable` itself never wraps (a plain
// `int` counter); only the packed representation is bounded width, which is
// the wraparound headroom the header's width reasoning is about.
@nosplit fn pdGenTag(gen: int): int {
  return gen & (pdGenLimit - 1)
}

@nosplit fn pdPack(genTag: int, taskOrTag: int): int {
  return (genTag << pdTaskBits) | (taskOrTag & pdTaskMask)
}

@nosplit fn pdTaskOf(word: int): int {
  return word & pdTaskMask
}

@nosplit fn pdGenOf(word: int): int {
  return (word >> pdTaskBits) & (pdGenLimit - 1)
}

// Unconditionally transition `slot` to `(targetGenTag, pdEmpty)` and report
// whatever task id it displaced (`pdEmpty` for none, whether the slot was
// truly empty or only held an unclaimed ready edge). Used by `pdOpen` and
// `pdClose`, both of which own `targetGenTag` outright (they just minted it),
// so no generation check is needed here -- only ordinary CAS contention from
// a concurrent `pdWait`/`pdWake`/`pdCancel` still racing the OLD generation,
// which this loop's retry absorbs exactly like `pdWaitStep`/`pdWakeStep` do.
@nosplit fn pdSweep(slot: *i64, targetGenTag: int): int {
  let k = 0
  while (k < pdMaxRetries) {
    let cur = atomicLoad(slot)
    if (atomicCmpxchg(slot, cur, pdPack(targetGenTag, pdEmpty))) {
      let tag = pdTaskOf(cur)
      if (tag == pdReady) {
        return pdEmpty
      }
      return tag
    }
    k = k + 1
  }
  return pdEmpty
}

// Open (or reopen) `fd`: mint a new generation and transition both slots to
// it, empty. Returns the new generation, or -1 for an out-of-range fd. Must
// be called before any `pdWait`/`pdWake`/`pdCancel` against this fd, and
// again every time the underlying kernel fd number is reused for a new
// connection -- the new generation is what makes a straggler from the
// PREVIOUS connection's waits inert (invariant 3).
export @nosplit fn pdOpen(fd: int): int {
  if (!pdValidFd(fd)) {
    return 0 - 1
  }
  let g = atomicAdd(pdGenAddr(fd), 1) + 1
  let genTag = pdGenTag(g)
  let _ = pdSweep(pdSlotAddr(fd, pdDirRead), genTag)
  let _ = pdSweep(pdSlotAddr(fd, pdDirWrite), genTag)
  return g
}

// One attempt at `pdWait`'s slot transition. Returns a terminal `pdWait`
// code, or `pdWaitRetry` when the CAS lost to ordinary contention (not a
// generation mismatch, which is terminal on its own) and the caller should
// reread and try again.
@nosplit fn pdWaitStep(genTag: int, slot: *i64, taskId: int): int {
  let cur = atomicLoad(slot)
  if (pdGenOf(cur) != genTag) {
    return pdStaleGen
  }
  let tag = pdTaskOf(cur)
  if (tag == pdEmpty) {
    if (atomicCmpxchg(slot, cur, pdPack(genTag, taskId))) {
      return pdClaimed
    }
    return pdWaitRetry
  }
  if (tag == pdReady) {
    if (atomicCmpxchg(slot, cur, pdPack(genTag, pdEmpty))) {
      return pdAlreadyReady
    }
    return pdWaitRetry
  }
  return pdBusy
}

// Claim `fd`'s `dir` slot for `taskId`, or consume an edge that is already
// there. `gen` must be the value `pdOpen` (or a prior successful `pdWait` on
// this fd) returned; a mismatch against the fd's CURRENT generation is
// answered with `pdStaleGen`, decided by the SAME compare-and-swap that
// claims the slot -- there is no separate check to race.
//
// `taskId` MUST be a caller-chosen non-zero positive value stable for the
// whole time this task may be parked -- #5865/#5866 pass a real task address;
// this file assigns it no other meaning.
export @nosplit fn pdWait(fd: int, dir: int, gen: int, taskId: int): int {
  if (!pdValidFd(fd) || !pdValidDir(dir) || taskId <= 0) {
    return pdBusy
  }
  let genTag = pdGenTag(gen)
  let slot = pdSlotAddr(fd, dir)
  let k = 0
  while (k < pdMaxRetries) {
    let r = pdWaitStep(genTag, slot, taskId)
    if (r != pdWaitRetry) {
      return r
    }
    k = k + 1
  }
  return pdBusy
}

// One attempt at `pdWake`'s slot transition. Returns a task id (deliver the
// wake), `pdEmpty` (nothing to deliver -- recorded as ready, already ready,
// or the gen was stale), or `pdWakeRetry` to reread and try again.
@nosplit fn pdWakeStep(genTag: int, slot: *i64): int {
  let cur = atomicLoad(slot)
  if (pdGenOf(cur) != genTag) {
    return pdEmpty // a stale-generation wake touches nothing
  }
  let tag = pdTaskOf(cur)
  if (tag == pdEmpty) {
    if (atomicCmpxchg(slot, cur, pdPack(genTag, pdReady))) {
      return pdEmpty
    }
    return pdWakeRetry
  }
  if (tag == pdReady) {
    return pdEmpty
  }
  if (atomicCmpxchg(slot, cur, pdPack(genTag, pdEmpty))) {
    return tag
  }
  return pdWakeRetry
}

// Called from a drain when `fd` reports readiness in direction `dir`. `gen`
// is whatever the caller registered the kernel event under (#5865/#5866
// decide where that is stashed -- e.g. packed alongside `fd` in the kernel
// event's user data), so a readiness event that outlived a close-and-reopen
// of this fd number is ignored (invariant 3) instead of waking the wrong
// connection.
//
// Returns the task id to unpark, or `pdEmpty` when there is nothing to do
// right now (the edge was recorded for a future waiter, or the event was
// stale).
export @nosplit fn pdWake(fd: int, dir: int, gen: int): int {
  if (!pdValidFd(fd) || !pdValidDir(dir)) {
    return pdEmpty
  }
  let genTag = pdGenTag(gen)
  let slot = pdSlotAddr(fd, dir)
  let k = 0
  while (k < pdMaxRetries) {
    let r = pdWakeStep(genTag, slot)
    if (r != pdWakeRetry) {
      return r
    }
    k = k + 1
  }
  return pdEmpty
}

// The timer side of a deadline race won: retract `taskId` from `fd`'s `dir`
// slot. Returns true only when this call is the one that removed it -- false
// means it was already resolved by a `pdWake`, a `pdClose`, was never
// claimed, `gen` is stale, or a DIFFERENT task is now parked there (a later
// wait within the same generation -- checking the exact task id, not just
// the generation, is what keeps a stale cancel from evicting it). The caller
// must not touch the task again on a `false` return.
export @nosplit fn pdCancel(fd: int, dir: int, taskId: int, gen: int): bool {
  if (!pdValidFd(fd) || !pdValidDir(dir) || taskId <= 0) {
    return false
  }
  let genTag = pdGenTag(gen)
  let slot = pdSlotAddr(fd, dir)
  let cur = atomicLoad(slot)
  if (pdGenOf(cur) != genTag || pdTaskOf(cur) != taskId) {
    return false
  }
  return atomicCmpxchg(slot, cur, pdPack(genTag, pdEmpty))
}

// Close `fd`: mint a new generation and unconditionally transition both
// slots to it, empty (invariant 4), so a task parked in either one sees the
// close rather than hanging until a syscall that will never come. The task
// id woken on each direction (`pdEmpty` for none) is written through
// `outR`/`outW` rather than returned as a pair -- no tuple return, no
// allocation; a caller not interested in one direction may pass `nil` for
// it. Returns the new generation, or -1 for an out-of-range fd (both outputs
// left at `pdEmpty`).
export @nosplit fn pdClose(fd: int, outR: *i64, outW: *i64): int {
  if (!pdValidFd(fd)) {
    if (outR != nil) {
      *outR = pdEmpty
    }
    if (outW != nil) {
      *outW = pdEmpty
    }
    return 0 - 1
  }
  let g = atomicAdd(pdGenAddr(fd), 1) + 1
  let genTag = pdGenTag(g)
  let r = pdSweep(pdSlotAddr(fd, pdDirRead), genTag)
  let w = pdSweep(pdSlotAddr(fd, pdDirWrite), genTag)
  if (outR != nil) {
    *outR = r
  }
  if (outW != nil) {
    *outW = w
  }
  return g
}
