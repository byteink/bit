// The timer queue and the netpoller's scheduler-side half, split out of
// `sched.bit` (#1503). Sibling file, so the same module - nothing here changed
// but its home.

// ---------------------------------------------------------------------------
// Netpoller: the scheduler-side half
// ---------------------------------------------------------------------------
//
// The poller ITSELF is platform code and lives in `runtime/sched/{linux,darwin}`
// — epoll against kqueue is the least reconcilable split in the whole runtime,
// and §11.7/§11.8 reject even an uncalled declaration for the other platform.
// What stays here is the part that is the same on both: where the descriptor is
// kept, and the mutual exclusion around the poll call.
//
// WHY THE TRY-LOCK EXISTS — this is `runtime/sched/`'s `polling` flag, and it is not
// an optimisation. Every idle worker calls the drain from its own loop. Without
// exclusion two workers can sit inside `epoll_wait`/`kevent` on the same shared
// oneshot descriptor exactly as an fd becomes ready, and the kernel can report
// that one event to both before oneshot disarms it. Both then unpark the same
// task: the second delivery lands on a `Task` the first delivery's worker has
// already run to completion and freed — a use-after-free, not a double-wake.
//
// It is a TRY-lock, never a blocking one, and deliberately so:
// losing the race costs nothing, because the loser has the rest of its idle
// pass to look for work and will poll on the next cycle anyway. A blocking lock
// here would park a worker behind a poll it does not need.
// Bind a created poll descriptor into the scheduler. The consumer's boot calls
// this once, because `runtime/sched` may import neither provider and so cannot
// create the descriptor itself — `runtime/root/<os>`'s `boot` does, right after
// `schedInit`. #1673 is what happens when nothing calls it: `scPollFd` stays 0,
// `netAwaitReady` reads that as "no poller", and every socket read that must wait
// silently returns an empty string.
//
// A NON-POSITIVE `fd` IS REFUSED. 0 is this block's own "no poller bound"
// sentinel (`schedInit` writes it), so binding 0 would be a no-op that reads as
// success, and binding a negative value would hand `epoll_wait`/`kevent` a
// fabricated descriptor on every idle pass. The providers' `pollCreate` already
// reports both as -1; this is the second half of the same invariant, on the
// storing side, so no caller can install a descriptor the readers cannot use.
//
// The guard is also what keeps this body out of its caller's object: the inliner
// splices single-block callees (`compiler/optinline.bit`), and an inlined store
// leaves no relocation naming this function — which makes the wiring edge in
// `_tests_/bit/stwwiring/`'s `checkEdge` unverifiable, since there is nothing left
// in `boot` to point at. See the providers' `pollCreate` for the same constraint.
export @nosplit @symbol("bit_rt_port_sched_set_poll_fd") fn schedSetPollFd(s: *i64, fd: int) {
  if (fd <= 0) {
    return
  }
  *(s + scPollFd) = fd
}

// The write-interest descriptor's setter (#1910). Separate from the one above
// rather than an extra parameter, because only the Linux consumer binds it and
// the Darwin boot path must not have to pass a 0 it does not have.
export @nosplit @symbol("bit_rt_port_sched_set_poll_fd_write") fn schedSetPollFdWrite(
  s: *i64,
  fd: int,
) {
  if (fd <= 0) {
    return
  }
  *(s + scPollFdWrite) = fd
}

export @nosplit @symbol("bit_rt_port_sched_poll_try_enter") fn schedPollTryEnter(s: *i64): bool {
  return atomicCmpxchg(s + scPollLock, 0, 1)
}

export @nosplit @symbol("bit_rt_port_sched_poll_leave") fn schedPollLeave(s: *i64) {
  atomicStore(s + scPollLock, 0)
}

// Interest constants, shared by both providers so a caller names the same value
// whichever platform it is built for. The providers map these onto
// `EPOLLIN`/`EPOLLOUT` and `EVFILT_READ`/`EVFILT_WRITE`; the numbers here are
// this runtime's own, deliberately NOT either kernel's, so that neither
// provider's constants leak into a caller.
export const pollRead: int = 0
export const pollWrite: int = 1

// ---------------------------------------------------------------------------
// Outstanding one-shot registrations (#2530)
// ---------------------------------------------------------------------------
//
// How many `pollRegister` calls (either provider) have succeeded but not yet
// had their one-shot edge consumed by `pollDrain`. `schedFindWorkAt`'s deadlock
// check (`../worker.bit`) reads this: a live registration is a live promise
// that a worker will have something to run later, even though nothing is
// runnable, timed or running RIGHT NOW — a server parked on `accept()` is the
// case this exists to protect.
//
// PROCESS-GLOBAL, NOT A `Scheduler` FIELD, AND THAT IS A DELIBERATE, NARROWER
// CHOICE THAN THE REST OF THIS FILE MAKES. `pollRegister` is called from
// outside any task in at least one real caller —
// `_tests_/stress/schedpolldarwin`'s own comment: "Register BEFORE the tasks
// run... Doing it from inside a task would need the task to reach the
// provider, which a `@nosplit` body cannot" — so there is no `Task.worker` to
// recover a `Scheduler*` from at the call site, and `pollRegister`'s signature
// is pinned ABI (ABI.md §9) called from `runtime/net` and five stress
// harnesses outside `runtime/sched/**`'s boundary; threading a scheduler
// pointer through it reaches all of them. In production there is exactly one
// live poller per process (`runtime/root`'s boot), so a single counter names
// it correctly. The only case this conflates is a stress harness that builds
// a SECOND, private `Scheduler` + poller pair alongside root's real one for
// its own isolated test — and only in the safe direction: a stray count left
// over from that private poller can only make `schedFindWorkAt`'s check MORE
// conservative (skip firing), never trigger it on a program that is not
// actually stuck.
let schedPollPending: [1]i64

@nosplit fn pollPendingAddr(): *i64 {
  return ptrOf(schedPollPending)
}

// PINNED (ABI.md §9): called across a module boundary by both
// `runtime/sched/darwin` and `runtime/sched/linux`, each emitted
// `--freestanding` (SPEC §11.9), which refuses an unpinned reference.

// Called by `pollRegister` on a successful registration.
export @nosplit @symbol("bit_rt_port_sched_poll_pending_inc") fn schedPollPendingInc() {
  atomicAdd(pollPendingAddr(), 1)
}

// Called by `pollDrain`/`pollDrainOne` once per dispatched event — the
// one-shot edge is consumed by the kernel reporting it, whether or not
// `schedPollUnpark` finds a task to hand it to.
export @nosplit @symbol("bit_rt_port_sched_poll_pending_dec") fn schedPollPendingDec() {
  atomicSub(pollPendingAddr(), 1)
}

export @nosplit @symbol("bit_rt_port_sched_poll_pending_count") fn schedPollPendingCount(): int {
  return atomicLoad(pollPendingAddr())
}

// ---------------------------------------------------------------------------
// The timer queue
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `TimerQueue`: sleeping green threads waiting on a deadline.
//
// An UNSORTED intrusive list, kept deliberately
// — `push` is O(1) and `expire` is one bounded pass. Sorting would only pay off
// with many sleepers AND frequent expiry checks, and the check runs solely on a
// worker's idle path, so the scan is cheaper than maintaining the order. The
// The upgrade path is a 4-ary heap if a
// program ever holds enough concurrent sleepers for the scan to show in a
// profile. Porting the "better" structure would have been a behaviour change
// dressed as an improvement.
//
// THIS SECTION HOLDS NO CLOCK, AND THAT IS THE SEAM. `expire` takes `now` as a
// parameter exactly as `runtime/sched/`'s does; the caller reads the clock. A
// monotonic clock is `clock_gettime` — a `syscall` on Linux and an `extern` call
// on Darwin — and this file must contain neither (§11.7/§11.8 reject even an
// uncalled declaration for the other platform, and a module is a directory). So
// the whole timer queue is platform-free core, and `runtime/park`'s already
// shipped `parkMonoNs` is what the consumer passes in. Same shape as
// `runtime/thread`'s `threadJoin`, which takes its clock as a function value for
// this identical reason.

// Link `task` onto the sleeping list. Its `taskDeadline` must already be set.
//
// ORDERING CONTRACT — READ BEFORE MOVING THIS CALL. `runtime/sched/` links the task
// on from a `ParkFn`, i.e. on the worker's side of the switch, strictly AFTER
// the task's context has been saved. That hook is not expressible here: it is a
// call through a function value, which `@nosplit` rejects (E0075), and
// `schedPark` is `@nosplit`. So `schedSleepUntil` below links the task on
// BEFORE it parks, and the resulting window — a task on the timer list whose
// context is not yet saved — is closed on the OTHER side instead, in `expire`:
// a due task is only ever woken through `schedUnpark`, whose compare-and-exchange
// requires `taskParked`, and `taskParked` is stored by the worker only after
// `schedSwitch` has saved the context. A task found due before it is genuinely
// parked is therefore RETAINED, not woken, and retried on the next idle pass.
//
// That is the same race `runtime/sched/`'s hook exists to close, closed at the
// consumer end rather than the producer end. It costs at most one idle cycle of
// extra latency in a window that is a few instructions wide.
export @nosplit @symbol("bit_rt_port_sched_timer_push") fn schedTimerPush(s: *i64, task: int) {
  let t = taskAt(task)
  spinAcquire(lockOf(s, scTimerLock))
  *(t + taskTimerNext) = *(s + scTimerHead)
  *(s + scTimerHead) = task
  spinRelease(lockOf(s, scTimerLock))
}

// ---------------------------------------------------------------------------
// The next known deadline, and what it is for (#3911)
// ---------------------------------------------------------------------------
//
// The earliest FUTURE deadline each sweep below saw, or 0 when that queue had
// none. `runtime/root/<os>`'s `workerBody` reads it through `schedParkBoundNs`
// to bound its idle park, instead of waiting a blind doubling that knows
// nothing about when the next thing is actually due.
//
// WHY A BLIND RAMP IS NOT ENOUGH, and why this is a fix rather than a tuning
// knob. `parkNextBackoff` doubles to `parkMaxBackoffNs` on a stretch of idle
// turns, so a worker whose only pending work is a timer sleeps past that
// timer's deadline by however far the ramp happened to have climbed — up to
// 1ms, for a deadline it already knows the exact value of. #3736 measured the
// consequence directly: a nominal 200us sleep achieved 338,163ns on average
// there, tracking the ramp's own maximum rather than the nominal. Nothing
// caps the overshoot at a value related to the workload, which is why making
// the idle turn CHEAPER made the latency WORSE — more turns per unit time
// means the ramp climbs further before the timer fires.
//
// The bound below is the deadline itself, so it costs nothing to compute here
// and carries no fitted constant: with no timer armed both cells read 0 and
// the park is exactly today's `backoff`, and with one armed the park is
// exactly as long as it can be without being late.
//
// TWO CELLS, NOT ONE, and each writer owns exactly one of them. A single cell
// would need one sweep to min-merge into the other's write, which makes the
// answer depend on the order the two happen to be called in — they are
// separate functions with separate call sites (`schedFindWorkAt`,
// `schedFindWorkIdle`), and an ordering constraint nothing in either body can
// state is the shape this file already refuses elsewhere. Each cell is
// overwritten wholesale on every pass of its own sweep, so neither can hold a
// value its queue no longer justifies.
//
// PROCESS-GLOBAL for the same reason `schedPollPending` above is, and wrong in
// the same safe direction: a stress harness's private second scheduler writes
// these cells too, and a value it publishes can only make some other worker's
// park SHORTER than it needed to be — one extra idle turn, never a missed
// wake. A too-short park costs a turn; a too-long one is the defect.
const dlTasks: int = 0
const dlChans: int = 1
let schedNextDeadline: [2]i64

@nosplit fn nextDeadlineAddr(): *i64 {
  return ptrOf(schedNextDeadline)
}

// The earlier of two deadlines under the "0 means none" encoding, which plain
// `min` gets wrong in exactly the case that matters (one queue empty).
@nosplit fn earlierDeadline(a: int, b: int): int {
  if (a == 0) {
    return b
  }
  if (b == 0) {
    return a
  }
  if (b < a) {
    return b
  }
  return a
}

// How long an idle worker may park, given the blind backoff it would otherwise
// have used and the clock it just read: never longer than that backoff, never
// past the next deadline this scheduler knows about, and never shorter than
// `parkMinBackoffNs` — the module's own existing floor, so a deadline that has
// already gone by while this turn ran costs one short sleep rather than a
// spin.
//
// `now` IS THE CALLER'S, deliberately, exactly as `schedTimerExpire`'s is:
// this module holds no clock (see the timer queue's section header), and the
// caller has to read the same one the deadlines were computed against or the
// subtraction below is meaningless.
//
// PINNED (ABI.md §9): called from `runtime/root/<os>`'s `workerBody`, emitted
// `--freestanding` (SPEC §11.9), which refuses an unpinned reference.
export @nosplit @symbol("bit_rt_port_sched_park_bound_ns") fn schedParkBoundNs(
  backoffNs: int,
  now: int,
): int {
  let due = earlierDeadline(
    atomicLoad(nextDeadlineAddr() + dlTasks),
    atomicLoad(nextDeadlineAddr() + dlChans),
  )
  if (due == 0) {
    return backoffNs
  }
  let wait = due - now
  if (wait < parkMinBackoffNs) {
    return parkMinBackoffNs
  }
  if (wait < backoffNs) {
    return wait
  }
  return backoffNs
}

// Split the sleeping list at `now` under the timer lock: the due ones come
// back as a list for the caller to unpark OUTSIDE the lock (see
// `schedTimerExpire`), the rest go back onto `scTimerHead`, and the earliest
// of the rest is published for the park bound above. Extracted from
// `schedTimerExpire` so that neither half carries the other's branches.
//
// The earliest deadline falls out of the `keep` branch for free — this walk
// already reads every entry's deadline and already decides which side of `now`
// it is on, so the only added work is one compare and one store per pass.
@nosplit fn timerPartition(s: *i64, now: int): int {
  spinAcquire(lockOf(s, scTimerLock))
  let due = 0
  let keep = 0
  let earliest = 0
  let it = *(s + scTimerHead)
  let n = 0
  while (it != 0 && n < schedMaxRegistered) {
    n = n + 1
    let t = taskAt(it)
    let next = *(t + taskTimerNext)
    let deadline = *(t + taskDeadline)
    if (deadline <= now) {
      *(t + taskTimerNext) = due
      due = it
    } else {
      *(t + taskTimerNext) = keep
      keep = it
      earliest = earlierDeadline(earliest, deadline)
    }
    it = next
  }
  *(s + scTimerHead) = keep
  spinRelease(lockOf(s, scTimerLock))
  atomicStore(nextDeadlineAddr() + dlTasks, earliest)
  return due
}

// Wake every sleeper whose deadline has passed. Returns how many actually woke.
//
// `runtime/sched/`'s `expire`, including its two-list partition and its rule that the
// unparking happens OUTSIDE the lock — `schedUnpark` pushes onto the global run
// queue and another worker may pick the task up immediately, so holding the
// timer lock across it would order a run queue behind a timer.
//
// A task whose deadline has passed but which has not yet reached `taskParked`
// goes back on the list rather than being dropped or spun on; see
// `schedTimerPush`'s ordering contract for why that case exists at all. Such a
// task is due, not future, so it never contributes to the published deadline —
// the worker retries it on its next idle turn exactly as it always has.
//
// Both walks are bounded by `schedMaxRegistered` (Power of 10) — the same
// runaway backstop the registry walk uses, for the same reason: a corrupted link
// must terminate the loop rather than hang the worker.
export @nosplit @symbol("bit_rt_port_sched_timer_expire") fn schedTimerExpire(
  s: *i64,
  now: int,
): int {
  let due = timerPartition(s, now)
  let woken = 0
  let m = 0
  while (due != 0 && m < schedMaxRegistered) {
    m = m + 1
    let t = taskAt(due)
    let next = *(t + taskTimerNext)
    *(t + taskTimerNext) = 0
    if (schedUnpark(s, due)) {
      woken = woken + 1
    } else {
      // Due, but its context is not saved yet. Put it back and retry next pass.
      schedTimerPush(s, due)
    }
    due = next
  }
  return woken
}

// How many tasks are asleep. A bounded walk, for tests and for a consumer that
// wants to know whether an idle scheduler still has a wake pending — the
// distinction between "nothing to do" and "nothing to do YET", which is what
// makes a shutdown that drains timers expressible.
export @nosplit @symbol("bit_rt_port_sched_timer_count") fn schedTimerCount(s: *i64): int {
  spinAcquire(lockOf(s, scTimerLock))
  let n = 0
  let it = *(s + scTimerHead)
  while (it != 0 && n < schedMaxRegistered) {
    n = n + 1
    it = *(taskAt(it) + taskTimerNext)
  }
  spinRelease(lockOf(s, scTimerLock))
  return n
}

// Park the calling task until `deadlineNs` on the same monotonic clock the
// consumer drives `schedTimerExpire` with. `runtime/sched/`'s `sleepTask`, split at
// the clock: rather than computing `monoNs() + ns` internally, this takes the
// absolute deadline, because it has no clock to add to (see the section header).
//
// MAY ONLY BE CALLED FROM TASK CODE, like `schedYield`/`schedPark` beside it.
//
// A deadline already in the past still parks and is woken by the next expiry
// pass, rather than returning immediately. Parking unconditionally keeps the
// function's contract single-valued: it always yields the worker, so a task cannot starve its
// worker by sleeping zero in a loop.
export @nosplit @symbol("bit_rt_port_sched_sleep_until") fn schedSleepUntil(deadlineNs: int) {
  let taskAddr = schedCurrentTask()
  // Inlined, not a shared callee — see task.bit's "THE TRAP IS COPIED INLINE
  // AT EACH OF THE FOUR SITES" for why a call here is too costly on this hot a
  // path, and "THE TEST LIVES IN THE `asm` BLOCK" for why the compare is in
  // the payload rather than in an `if`.
  asm volatile {
    arm64 {
      0xB5000049, // cbnz x9, +8 -> skip the trap: a task owns this stack
      0xD4200000, // brk #0      -> SIGTRAP / EXC_BREAKPOINT
    }
    x64 {
      0x48, 0x85, 0xC9, // test rcx, rcx
      0x75, 0x02,       // jne +2      -> skip the trap
      0x0F, 0x0B,       // ud2         -> SIGILL / EXC_BAD_INSTRUCTION
    }
    input arm64 x9 x64 rcx = taskAddr
  }
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  let s = taskAt(*(w + wkSched))
  *(t + taskDeadline) = deadlineNs
  schedTimerPush(s, taskAddr)
  *(w + wkDisposition) = taskParked
  schedSwitch(t, w + wkCtx)
}

// ---------------------------------------------------------------------------
// Channel timers — expiry SENDS on a channel instead of waking a task (#2665)
// ---------------------------------------------------------------------------
//
// A second entry kind, deliberately NOT an addition to the `TimerQueue`
// above: that queue is intrusive on `Task` fields (`taskTimerNext`,
// `taskDeadline`) and a channel-timer entry has no task and no stack to be
// intrusive INTO. It also cannot live on the `Scheduler` block itself —
// `schedWords` (16) is asserted exactly by
// `_tests_/stress/schedspawnowner.bit`'s `schedWords == 16 && workerWords ==
// 292`, so growing it moves every caller's raw offset arithmetic. Storage is
// instead a fixed, PROCESS-GLOBAL pool, the same shape `schedPollPending`
// above already uses and for the same reason: there is one live scheduler
// per production process, and a stress harness's private second one only
// makes a stale entry MORE conservative (it just occupies a slot), never
// wrong.
//
// A FIXED CAP, not a GC-backed growable list: `runtime/sched` cannot import
// `runtime/gc`'s bump reserve either — `runtime/gc/gcmark.bit` imports
// `schedStackHeadroom` from here, so the reverse is the identical E0044 cycle
// `runtime/chan` hits (verified directly, the same way). `schedTimerChanArm`
// RETURNS 0 ON EXHAUSTION rather than growing — see its own comment; that is
// the documented contract, not a shortfall.
//
// THE ARM/CANCEL/RESET SPLIT ACROSS TWO MECHANISMS is deliberate, not
// inconsistent: only `schedTimerChanArm` takes a `chan<T>` argument, and a
// `chan<T>` value cannot cross a plain `extern fn` boundary at all (E0077 —
// "the C ABI has no representation for a GC-managed Bit value"), so it has to
// be a compiler-recognized builtin, reached the same way `close(c)` is
// (`compiler/lowerprim.bit`'s `primRtName`). Cancel and reset take only
// scalars and are reached the plain way `bit_rt_net_dial_deadline_w` is: an
// `extern fn` declared wherever they are called.

// One entry, `ctEntryWords` apart in `chanTimerPool`.
const ctEntryWords: int = 6
const ctState: int = 0 // 0 free, 1 pending
const ctDeadline: int = 1
const ctPeriod: int = 2
const ctChan: int = 3 // raw channel handle (int), opaque here — never
// dereferenced in this file, only forwarded to
// `bit_rt_port_chan_try_send_drop`
const ctGen: int = 4 // bumped on every arm; guards a cancel/reset call
// against an id from a slot that has since been
// cancelled and reused by a DIFFERENT timer
const ctNext: int = 5 // free-list link while ctState == 0, 1-based (0 = end)

// 32768 slots * 6 words: ~1.5 MB of zero-initialized process memory, reserved
// once at link time rather than grown — comfortably above the epic's own
// 20000-concurrent-timer measurement, and a slot is ~48 bytes against the
// ~110 KB a spawned-thread timeout costs today.
const ctCap: int = 32768
let chanTimerPool: [196608]i64
let chanTimerFreeHead: [1]i64
let chanTimerHigh: [1]i64
let chanTimerLockWord: [1]i64
// How many slots are currently pending (state == 1). A dedicated counter
// rather than a scan: `schedCheckDeadlock` (worker.bit) reads this on every
// idle turn a single-worker program takes, the same frequency
// `schedTimerCount`/`schedPollPendingCount` are already read at, so this
// answers in O(1) rather than re-deriving it from `chanTimerHigh` each time.
let chanTimerPendingCount: [1]i64

@nosplit fn chanTimerPendingAddr(): *i64 {
  return ptrOf(chanTimerPendingCount)
}

// A program parked ONLY on a channel timer (no task on the sleeping-task
// list `schedTimerCount` sees, since a channel timer has no task) must not
// read as deadlocked. `schedCheckDeadlock` checks this exactly where it
// checks `schedTimerCount`/`schedPollPendingCount` — see its own header.
export @nosplit @symbol("bit_rt_port_sched_timer_chan_count") fn schedTimerChanCount(): int {
  return atomicLoad(chanTimerPendingAddr())
}

@nosplit fn chanTimerLockAddr(): *i32 {
  return lockOf(ptrOf(chanTimerLockWord), 0)
}

@nosplit fn chanTimerFreeHeadAddr(): *i64 {
  return ptrOf(chanTimerFreeHead)
}

@nosplit fn chanTimerHighAddr(): *i64 {
  return ptrOf(chanTimerHigh)
}

@nosplit fn ctEntryAt(slot: int): *i64 {
  return ptrOf(chanTimerPool) + slot * ctEntryWords
}

// Always > 0, so 0 stays the documented "arm failed" sentinel. Decodable back
// to `(slot, gen)` by `ctLookupPending` without a lookup table.
@nosplit fn ctMakeId(slot: int, gen: int): int {
  return gen * ctCap + slot + 1
}

// Claim a free slot under `chanTimerLockAddr()`. Prefers the free list (O(1),
// recycles a cancelled/fired slot) and falls back to extending the
// never-shrinks high-water mark. -1 when the pool is exhausted.
@nosplit fn chanTimerClaimSlot(): int {
  let head = *chanTimerFreeHeadAddr()
  if (head != 0) {
    let slot = head - 1
    *chanTimerFreeHeadAddr() = *(ctEntryAt(slot) + ctNext)
    return slot
  }
  let high = atomicLoad(chanTimerHighAddr())
  if (high >= ctCap) {
    return -1
  }
  atomicStore(chanTimerHighAddr(), high + 1)
  return high
}

// `runtime/sched/timer.bit`'s half of #2665: inserts a queue entry that, at
// expiry, does a non-blocking send of `true` on `c` (dropped if `c` is full —
// see `chanTrySendDrop`'s header, `runtime/chan/chanops.bit`). If `periodNs`
// is positive the entry re-arms itself at `deadline + periodNs` on every
// expiry instead of being freed (`schedTimerChanExpire` below); a
// non-positive `periodNs` fires once and frees its slot. Returns a timer id
// greater than 0, or 0 if the pool is exhausted (`ctCap` slots all pending).
//
// `c` is `int` here — the raw channel handle `compiler/lowercall.bit`'s
// generic `primRtName` path hands an `Op.RtCall` argument as, exactly like
// `chan_close`'s `cv`. This function is never called through an ordinary Bit
// call expression (only the compiler's own lowering reaches it by this
// symbol), so a `chan<bool>`-typed signature here would be misleading rather
// than safe.
export @nosplit @symbol("bit_rt_sched_timer_chan_arm") fn rtSchedTimerChanArm(
  deadlineNs: int,
  c: int,
  periodNs: int,
): int {
  let cell = chanTimerLockAddr()
  spinAcquire(cell)
  let slot = chanTimerClaimSlot()
  if (slot < 0) {
    spinRelease(cell)
    return 0
  }
  let e = ctEntryAt(slot)
  let gen = *(e + ctGen) + 1
  *(e + ctGen) = gen
  *(e + ctState) = 1
  *(e + ctDeadline) = deadlineNs
  *(e + ctPeriod) = periodNs
  *(e + ctChan) = c
  atomicAdd(chanTimerPendingAddr(), 1)
  spinRelease(cell)
  return ctMakeId(slot, gen)
}

// The slot `id` names, iff it is still pending AND `id`'s generation matches
// the slot's current occupant — -1 for an unknown id, an id whose slot has
// since fired-and-freed-and-been-reused, or an id whose slot is still free.
// MUST BE CALLED WITH `chanTimerLockAddr()` HELD: the generation/state check
// and the caller's use of the result must be one atomic read, or a concurrent
// cancel between the check and the use would race exactly the bug this
// guards against.
@nosplit fn ctLookupPending(id: int): int {
  if (id <= 0) {
    return -1
  }
  let idx = id - 1
  let slot = idx % ctCap
  let gen = idx / ctCap
  let e = ctEntryAt(slot)
  if (*(e + ctState) != 1 || *(e + ctGen) != gen) {
    return -1
  }
  return slot
}

// Frees `slot` onto the head of the free list. Caller holds the lock.
// Caller holds `chanTimerLockAddr()` and has already verified the slot was
// PENDING (state == 1) — freeing an already-free slot would double-count the
// decrement below against `schedTimerChanArm`'s single increment.
@nosplit fn ctFreeSlot(slot: int) {
  *(ctEntryAt(slot) + ctState) = 0
  *(ctEntryAt(slot) + ctNext) = *chanTimerFreeHeadAddr()
  *chanTimerFreeHeadAddr() = slot + 1
  atomicSub(chanTimerPendingAddr(), 1)
}

// Removes the entry `id` names. Returns `true` when it was still pending
// (and is now cancelled), `false` when it already fired or `id` is unknown —
// exactly the race `cancel` racing `expire` must resolve one way or the
// other, never both.
export @nosplit @symbol("bit_rt_sched_timer_chan_cancel") fn schedTimerChanCancel(id: int): bool {
  let cell = chanTimerLockAddr()
  spinAcquire(cell)
  let slot = ctLookupPending(id)
  if (slot < 0) {
    spinRelease(cell)
    return false
  }
  ctFreeSlot(slot)
  spinRelease(cell)
  return true
}

// Moves a pending entry to a new absolute deadline. `false` when `id` is
// unknown (already fired, or never valid) — the same lookup `cancel` uses, so
// the two report unknown-ness identically.
export @nosplit @symbol("bit_rt_sched_timer_chan_reset") fn schedTimerChanReset(
  id: int,
  deadlineNs: int,
): bool {
  let cell = chanTimerLockAddr()
  spinAcquire(cell)
  let slot = ctLookupPending(id)
  if (slot < 0) {
    spinRelease(cell)
    return false
  }
  *(ctEntryAt(slot) + ctDeadline) = deadlineNs
  spinRelease(cell)
  return true
}

// PINNED (ABI.md §9), reached the same way `bit_rt_panic` is from this
// module (see `worker.bit`): `runtime/chan` already imports `runtime/sched`,
// so the reverse `import` is the E0044 cycle this avoids by never taking one.
extern fn bit_rt_port_chan_try_send_drop(ch: int, value: int): bool

// One entry's worth of work, done under the pool lock only for the
// state/deadline read and whatever mutation follows — the send itself runs
// OUTSIDE the lock, matching `schedTimerExpire`'s own rule that unparking (an
// operation that can wake a peer) never happens while a timer lock is held.
// A one-shot entry (`period <= 0`) is freed before the send, not after: the
// send cannot fail as far as this pool is concerned (`chanTrySendDrop` drops
// rather than erroring), so there is no outcome that should leave it pending.
//
// RETURNS THIS SLOT'S REMAINING FUTURE DEADLINE, or 0 when it has none — free,
// or a one-shot that just fired and was released. A periodic entry reports the
// deadline it was just re-armed to, not the one that expired, so the sweep's
// answer is what is still owed rather than what has already been paid. This is
// the same read the state/deadline check above already does, under the same
// acquisition of the same lock; see the next-known-deadline section above for
// what the caller does with it.
@nosplit fn chanTimerExpireSlot(slot: int, now: int): int {
  let cell = chanTimerLockAddr()
  spinAcquire(cell)
  let e = ctEntryAt(slot)
  if (*(e + ctState) != 1) {
    spinRelease(cell)
    return 0
  }
  let deadline = *(e + ctDeadline)
  if (deadline > now) {
    spinRelease(cell)
    return deadline
  }
  let c = *(e + ctChan)
  let period = *(e + ctPeriod)
  let rearmed = 0
  if (period > 0) {
    rearmed = now + period
    *(e + ctDeadline) = rearmed
  } else {
    ctFreeSlot(slot)
  }
  spinRelease(cell)
  let _ = bit_rt_port_chan_try_send_drop(c, 1)
  return rearmed
}

// Sweeps every slot ever claimed (`[0, chanTimerHigh)`) for one due, sends its
// `true` and re-arms or frees it, and publishes the earliest deadline still
// owed by this pool for the park bound (see the next-known-deadline section
// above — a channel timer is as much a known deadline as a sleeping task's,
// and bounding only one of the two queues would leave the same defect standing
// in the other). Called from the same idle-path call sites
// `schedTimerExpire` is (`schedFindWorkIdle`/`schedFindWorkAt`, worker.bit) —
// it has no task to hand back, so unlike `schedTimerExpire` there is nothing
// for the caller to `gqPop` afterward. Bounded by `ctCap` (Power of 10): a
// corrupted `chanTimerHigh` cannot walk past the pool's own extent.
export @nosplit @symbol("bit_rt_port_sched_timer_chan_expire") fn schedTimerChanExpire(now: int) {
  let high = atomicLoad(chanTimerHighAddr())
  if (high > ctCap) {
    high = ctCap
  }
  let earliest = 0
  let slot = 0
  while (slot < high) {
    earliest = earlierDeadline(earliest, chanTimerExpireSlot(slot, now))
    slot = slot + 1
  }
  atomicStore(nextDeadlineAddr() + dlChans, earliest)
}
