// Split out of ./sched.bit (#3374, kept the 800-line cap): a number a caller
// close to the floor can act on, rather than a fact it has to re-derive.
// Same module as sched.bit/scratch.bit — no import needed for
// `schedStackBytes`, `chanScratchWords`, `readSp`, `schedTaskOnStack` or
// `schedBigStackBaseFor`.

// STACK HEADROOM. `schedStackBytes`'s own comment states the hazard: the
// lowest `chanScratchWords` words of a task's stack hold its own
// self-pointer/tag, not guard-page memory, so a call chain that grows into
// them corrupts its own identity SILENTLY (ordinary mapped stack, not the
// `mapGuardedStack` guard below `base`). The scratch floor, not the guard,
// is the edge a caller wants to know about before it happens. Both an
// ordinary masked task and an OVERSIZED one (`main`, `sched.bit`'s
// "OVERSIZED STACKS" section) get this scratch area written by the same
// `schedTaskInit`, at the same relative offset from their own base — so one
// formula, `sp - (base + chanScratchWords * 8)`, answers both, once `base` is
// found by whichever mechanism applies.
//
// Sentinel answer when NEITHER mechanism below names a task — a boot thread or
// an idle worker's own OS thread stack, same reason `schedCurrentTask` answers
// 0 there. Far larger than any real headroom this function can otherwise
// return (bounded by `schedStackBytes` for a masked task, by the registered
// size for an oversized one), so a caller that skips the check fails safe.
//
// #3749: this used to be main's answer too — masking cannot name main's 8 MiB
// stack (interior 256KiB boundaries have no scratch and no tag, so the masked
// check alone would either miss it or false-alarm), and nothing else was tried,
// so `markStackTight()` (`../gc/gcmark.bit`) could never see real headroom on
// it. Confirmed by instrumented count before this fix: 5,832,947 of 5,832,947
// `markStackTight()` calls under `bench/cases/json` (single-threaded, all on
// `main`'s stack) returned false, 0 ever reached the overflow panic. Fixed by
// reading the SAME registry `schedCurrentTask` already falls back to for an
// oversized stack (`schedBigStackBaseFor`, `./sched.bit`) instead of masking —
// `main` is registered there at boot (`schedRegisterBigStack`, every
// `runtime/root/*/boot{,tail}.bit`), so its real base is already known, not
// guessed.
const schedHeadroomUnknown: int = 1000000000

// Bytes of headroom above the scratch floor on an ordinary masked task or a
// registered oversized one (`main`), or `schedHeadroomUnknown` off neither —
// see above.
export @nosplit @symbol("bit_rt_port_sched_stack_headroom") fn schedStackHeadroom(): int {
  let sp = readSp()
  let maskedBase = sp & ~(schedStackBytes - 1)
  if (schedTaskOnStack(maskedBase) != 0) {
    return sp - (maskedBase + chanScratchWords * 8)
  }
  let bigBase = schedBigStackBaseFor(sp)
  if (bigBase != 0) {
    return sp - (bigBase + chanScratchWords * 8)
  }
  return schedHeadroomUnknown
}
