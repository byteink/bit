// Split out of ./sched.bit (#3374, kept the 800-line cap): a number a caller
// close to the floor can act on, rather than a fact it has to re-derive.
// Same module as sched.bit/scratch.bit — no import needed for
// `schedStackBytes`, `chanScratchWords`, `readSp` or `schedTaskOnStack`.

// STACK HEADROOM. `schedStackBytes`'s own comment states the hazard: the
// lowest `chanScratchWords` words of a masked stack hold this task's own
// self-pointer/tag, not guard-page memory, so a call chain that grows into
// them corrupts its own identity SILENTLY (ordinary mapped stack, not the
// `mapGuardedStack` guard below `base`). The scratch floor, not the guard,
// is the edge a caller wants to know about before it happens.
//
// Sentinel answer off an ordinary masked stack — far larger than any real
// headroom (bounded by `schedStackBytes`), so a caller that skips the check
// fails safe. `main`'s 8 MiB stack is masking-blind by construction (this
// arithmetic would false-alarm on an interior 256KiB boundary with no scratch
// and no guard) and is covered exactly elsewhere (`../root/{linux,darwin}/
// signal.bit`'s `segvHandler`, matched against `mainStackBaseAddr`); a
// boot/idle-worker native stack answers the sentinel too, same reason
// `schedCurrentTask` answers 0 there.
const schedHeadroomUnknown: int = 1000000000

// Bytes of headroom above the scratch floor on an ordinary masked task, or
// `schedHeadroomUnknown` off one — see above.
export @nosplit @symbol("bit_rt_port_sched_stack_headroom") fn schedStackHeadroom(): int {
  let sp = readSp()
  let base = sp & ~(schedStackBytes - 1)
  if (schedTaskOnStack(base) == 0) {
    return schedHeadroomUnknown
  }
  return sp - (base + chanScratchWords * 8)
}
