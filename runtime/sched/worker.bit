// The worker and scheduler blocks, the all-live-tasks registry, work discovery
// and the M:N run loop, split out of `sched.bit` (#1503). Sibling file, so the
// same module - nothing here changed but its home.

// ---------------------------------------------------------------------------
// Worker: one OS thread running the scheduling loop
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `Worker`, as a caller-owned word-indexed block. The saved
// context occupies the prefix for the same reason a task's does — the switch
// takes the block address unchanged.
//
//   0..21    sched_ctx   this worker's own context while a task runs
//   22       id
//   23       running     the task currently switched-to, 0 between tasks
//   24       disposition how the running task last left the CPU
//   25       sched       the owning scheduler block's address
//   26       park        the worker's own futex word: 1 = armed to park or
//                        parked, 0 = awake or claimed by a waker (#1902)
//   27..28   sleepReq    scratch for this worker's own `parkSleepNs` timespec
//                        (#2318) — PER WORKER so two OS threads calling it
//                        concurrently (a worker's idle path and the boot
//                        thread's own poll-wait) never share a buffer.
//   29       lastDone    the task retired THIS step, 0 if none (#2167)
//   30       runNext     the one-task next-run slot (#3264)
//   31..33   reserved
//   34..291  deque       this worker's local run queue (`dqWords`)
export const wkCtx: int = 0
export const wkId: int = 22
export const wkRunning: int = 23
export const wkDisposition: int = 24
export const wkSched: int = 25

// This worker's park word. PER WORKER, not one shared cell for the pool, and
// that is the whole design — see `sleep.bit`. An i32, because that is what
// `futex(2)` and `__ulock_wait` compare.
export const wkPark: int = 26

// This worker's own two-word scratch for `parkSleepNs`'s `timespec` (#2318).
// Passing it as a caller-owned block — the same pattern every other runtime
// structure here uses — is what lets `parkSleepNs` avoid a `[]i64(2)` heap
// slice: that allocation ran on EVERY idle turn that found no work, which
// under real contention (`BIT_WORKERS` > 1) is millions of times over a
// program's life, and it is why RSS climbed independently of any live set.
export const wkSleepReq: int = 27

// The address of the task `schedWorkerStep` just retired (transitioned to
// `taskDone`) on THIS call, or 0 when no task finished this step (#2167).
//
// `wkRunning` cannot serve this: it is cleared to 0 right after `schedSwitch`
// returns, before disposition is even read (line below). A caller outside
// this module also cannot reconstruct which task ran from its own `addr`
// argument alone — `schedWorkerStepAt`'s netpoller-drain path (`addr == 0`,
// `woke > 0`) picks a DIFFERENT task via its own internal `gqPop`, invisible
// to the caller. This field is the seam: `../root/<os>/boot.bit`'s
// `workerBody`, the only place that may call `unmapPages`/`mapGuardedStack`
// (platform-specific; this module is not), reads it right after
// `schedWorkerStepAt` returns to learn which stack and task block, if any,
// it must release. One of the five words previously reserved above —
// `workerWords` is unchanged.
export const wkLastDone: int = 29

// This worker's NEXT-RUN SLOT: one task handed to it by a wake that happened on
// this very worker, so a lock handoff stays on the core that already owns the
// cache lines (#3264). `queue.bit`'s `rnTake`/`rnPut`/`rnNonEmpty` own the
// discipline — read that header for why a peer may reach this only from the slow
// idle turn, and why `schedFindWork` consults it AFTER the ring rather than
// before. One of the four words previously reserved above; `workerWords` is
// unchanged, which `_tests_/stress/schedspawnowner` asserts (`workerWords == 292`).
export const wkRunNext: int = 30

export const wkDeque: int = 34
export const workerWords: int = 292

// ---------------------------------------------------------------------------
// Scheduler
// ---------------------------------------------------------------------------
//
//   0        nworkers
//   1        workers     base address of the worker array (stride `workerWords`)
//   2        stopping    set once by `schedShutdown`, polled by every worker
//   3        regHead     head of the all-live-tasks registry (ABI.md §5)
//   4        regLock     an i32 cell, addressed via `lockOf`
//   5        timerHead   head of the sleeping-task list (`TimerQueue` below)
//   6        timerLock   an i32 cell, addressed via `lockOf`
//   7        pollFd      the netpoller's epoll/kqueue descriptor, 0 when the
//                        consumer bound no poller (see the netpoller section)
//   8..10    global      the overflow queue (`gqWords`)
//   11       pollLock    the netpoller's try-lock (an i32 cell)
//   12       pollFdWrite the SECOND epoll descriptor, carrying write interest
//                        only. LINUX ONLY — 0 everywhere else (#1910)
//   13       reserved
//   14       idleCount   how many workers are parked (#1902)
//   15       growStreak  consecutive `schedSpawn` calls that observed the
//                        global queue non-empty (#2593, `./grow.bit`)
export const scNWorkers: int = 0
export const scWorkers: int = 1
export const scStopping: int = 2
export const scRegHead: int = 3
const scRegLock: int = 4
export const scTimerHead: int = 5
const scTimerLock: int = 6
export const scPollFd: int = 7
export const scGlobal: int = 8
const scPollLock: int = 11

// THE SECOND POLL DESCRIPTOR, and why one is not enough on Linux (#1910).
//
// epoll keys a registration on the FD ALONE: one event mask, one 64-bit `data`
// word. `EPOLL_CTL_MOD` replaces both. kqueue keys on `(fd, filter)`, so
// EVFILT_READ and EVFILT_WRITE coexist on one socket with a separate task in
// each `udata`.
//
// So a socket with a concurrent reader and writer — a proxy, a bidirectional
// stream, or `_tests_/imports/nettcpbulk` — had the second registration silently
// destroy the first on Linux, and the losing task was never woken again.
// Measured: the transfer passes at 2.30 MB and hangs forever at 3.07 MB, the
// point where the send buffer fills and the writer starts parking too.
//
// Splitting the descriptors restores kqueue's property without a per-fd table:
// read interest registers in `scPollFd`, write interest in `scPollFdWrite`, so
// the two can never evict each other, `EPOLLONESHOT` keeps its unambiguous wake
// edge per direction, and `data` still holds the task address so dispatch is
// unchanged. `pollDrain` drains both.
//
// 0 on every platform that does not need it: kqueue already keys per filter, so
// the Darwin provider leaves this unset and reads only `scPollFd`.
export const scPollFdWrite: int = 12

// How many workers are parked (#1902). Read by `schedWakeIdle` to skip its scan
// when nobody is asleep; the park words themselves are per WORKER (`wkPark`),
// which is the whole design — see `sleep.bit`.
export const scIdleCount: int = 14

// The grow-on-demand streak (#2593, `./grow.bit`): consecutive `schedSpawn`
// calls that found the global queue still non-empty. Reset to 0 the moment a
// check finds it empty. Lives here, not in `grow.bit`, because it is part of
// the caller-owned scheduler block like every other `sc*` field; `grow.bit`
// only defines the offset's meaning and the policy that reads/writes it.
export const scGrowStreak: int = 15
export const schedWords: int = 16

// The worker block at index `i`.
export @nosplit @symbol("bit_rt_port_sched_worker_at") fn schedWorkerAt(s: *i64, i: int): *i64 {
  let base = *(s + scWorkers)
  return taskAt(base + i * workerWords * 8)
}

// One worker block, reset to a fresh, idle, empty state. The per-index body
// `schedInit`'s boot-time loop below and `schedStartWorker`'s post-boot growth
// (#2592) share, so a worker started after boot is bit-for-bit the same shape
// as one started at boot. `@nosplit` because `schedInit` is and may not call a
// non-`@nosplit` Bit function (E0075); `schedStartWorker` is not `@nosplit`
// itself but may still call this one.
@nosplit fn schedInitWorkerSlot(s: *i64, i: int) {
  let w = schedWorkerAt(s, i)
  *(w + wkId) = i
  atomicStore(lockOf(w, wkPark), 0)
  atomicStore(w + wkRunning, 0)
  *(w + wkDisposition) = taskRunning
  *(w + wkSched) = int(s)
  // The next-run slot starts empty (#3264). Explicit rather than relying on a
  // zeroed block: every other field here is initialised too, and a stale
  // address in this word would be dispatched as a task.
  atomicStore(w + wkRunNext, 0)
  dqInit(w + wkDeque)
}

// Prepare a scheduler over `nworkers` caller-owned worker blocks laid out
// contiguously at `workersAddr`.
export @nosplit @symbol("bit_rt_port_sched_init") fn schedInit(s: *i64, workersAddr: int, nworkers: int) {
  *(s + scNWorkers) = nworkers
  *(s + scWorkers) = workersAddr
  atomicStore(s + scStopping, 0)
  *(s + scRegHead) = 0
  atomicStore(lockOf(s, scRegLock), 0)
  *(s + scTimerHead) = 0
  atomicStore(lockOf(s, scTimerLock), 0)
  *(s + scPollFd) = 0
  // 0 means "not bound", and the Darwin provider never binds it (#1910).
  *(s + scPollFdWrite) = 0
  atomicStore(s + scIdleCount, 0)
  atomicStore(s + scGrowStreak, 0)
  gqInit(s + scGlobal)

  let i = 0
  while (i < nworkers) {
    schedInitWorkerSlot(s, i)
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// Starting ONE worker after boot (#2592)
// ---------------------------------------------------------------------------
//
// `schedInit`'s loop above brings up workers `[0, nworkers)` once, on the boot
// thread, before any worker OS thread exists — the precondition
// `runtime/thread/threadpool.bit`'s header calls "populate fully, then start".
// This is the other case: a single additional worker, started at any later
// point while `nworkers - 1` others may already be running green tasks,
// parking or unparking concurrently. The grow-on-demand POLICY (when to call
// this) is #2593's; this is only the mechanism, and it must be safe standing
// alone.
//
// `scNWorkers` moves from "write-once at boot, plain reads forever after"
// (ABI.md §22) to a field one thread may still be mutating while others read
// it, so every read of it in this module — `schedFindWork`, `schedWorkPending`,
// `schedStealRunNext` and `schedCheckDeadlock` below, and `schedWakeIdle`/
// `schedWakeIdleAll` in `sleep.bit` — now goes through `atomicLoad`, matching
// the `atomicStore` this function publishes through. A plain load paired with
// an atomic store is not actually ordered on a weak memory model (ARM64):
// the store is a release, and only an `atomicLoad` on the other side is a
// matching acquire, which is what guarantees a reader that sees the new count
// also sees this function's prior writes to that worker's block.
//
// LOCKING: the slot claim, the new worker's full initialization, and the
// thread create all happen under `scRegLock` — reused rather than a new lock,
// per the ticket. This is not a hot path (worker starts are rare relative to
// task scheduling), so holding the lock across `startFn` is cheap, and it has
// to span the whole sequence rather than just the claim: if the count were
// published before the thread create is known to succeed, a second concurrent
// caller could observe the bumped count and claim the next slot, and this
// call's own failure path would then have no safe way to give its slot back —
// decrementing could erase that second caller's legitimate claim. Publishing
// only on success, under one lock held throughout, avoids that hole entirely:
// on failure nothing is published and nothing needs unwinding.
//
// Sound against a concurrent stop-the-world for the same reason
// `schedRegister`/`schedUnregister` already are: this function has no loop, so
// it emits no safepoint poll (codegen emits one only at a loop back-edge) and
// cannot be asked to park while holding the lock. The collector's own registry
// walk takes this same lock only after every mutator — this one included — has
// already reached ITS OWN next safepoint, which for a straight-line function is
// the first one after it returns.
//
// `launch`'s fields (`WorkerLaunch`, `./grow.bit`) are the same shapes
// `runtime/thread/threadpool.bit`'s `schedStart` already takes — this module
// cannot import that composition (`runtime/thread` imports `runtime/sched`;
// the reverse is circular, E0044), so the two-word `{worker address,
// done-word address}` arm block is built here again, in the same shape,
// rather than reused. `launch.argArea`/`launch.doneArea`/`launch.handleArea`
// are caller-owned arrays sized for at least `schedMaxWorkers` entries each,
// exactly as `runtime/root/<os>`'s own `startArgs`/`startDones`/
// `startHandles` already are.
export fn schedStartWorker(s: *i64, launch: WorkerLaunch): bool {
  spinAcquire(lockOf(s, scRegLock))
  let i = atomicLoad(s + scNWorkers)
  if (i >= schedMaxWorkers) {
    spinRelease(lockOf(s, scRegLock))
    return false
  }

  schedInitWorkerSlot(s, i)

  let block = launch.argArea + i * 2
  *block = int(schedWorkerAt(s, i))
  let done = launch.doneArea + i
  *(block + 1) = int(done)
  // 1 is `runtime/thread`'s `threadRunning` sentinel, mirrored rather than
  // imported for the same reason the arg block shape is above. Armed before
  // the thread can possibly clear it, so a join that later observes 0 always
  // means the worker finished rather than never started — same requirement,
  // same ordering, as `schedStartArm`.
  atomicStore(done, i32(1))

  let bp: *byte = nil
  let h = launch.startFn(launch.entry, bp + int(block), done)
  *(launch.handleArea + i) = h
  if (h == 0) {
    spinRelease(lockOf(s, scRegLock))
    return false
  }

  atomicStore(s + scNWorkers, i + 1)
  spinRelease(lockOf(s, scRegLock))
  return true
}

// ---------------------------------------------------------------------------
// The all-live-tasks registry (ABI.md §5)
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `registerTask`/`unregisterTask`: an intrusive doubly-linked
// list of every task from spawn until its `.done` teardown, so the collector
// can find every parked or runnable stack to scan. Distinct from the run
// queues' `next` link, because a task is on the registry for its whole life
// while simultaneously moving between queues.
export @nosplit @symbol("bit_rt_port_sched_register") fn schedRegister(s: *i64, task: int) {
  let t = taskAt(task)
  spinAcquire(lockOf(s, scRegLock))
  let head = *(s + scRegHead)
  *(t + taskRegPrev) = 0
  *(t + taskRegNext) = head
  if (head != 0) {
    *(taskAt(head) + taskRegPrev) = task
  }
  *(s + scRegHead) = task
  spinRelease(lockOf(s, scRegLock))
}

export @nosplit fn schedUnregister(s: *i64, task: int) {
  let t = taskAt(task)
  spinAcquire(lockOf(s, scRegLock))
  let prev = *(t + taskRegPrev)
  let next = *(t + taskRegNext)
  if (prev != 0) {
    *(taskAt(prev) + taskRegNext) = next
  } else {
    *(s + scRegHead) = next
  }
  if (next != 0) {
    *(taskAt(next) + taskRegPrev) = prev
  }
  *(t + taskRegPrev) = 0
  *(t + taskRegNext) = 0
  spinRelease(lockOf(s, scRegLock))
}

// Upper bound on a registry walk. `runtime/sched/`'s `max_registered_tasks`, which
// is a runaway-loop backstop rather than a real capacity — the scheduler caps
// concurrent OS threads, not green threads.
export const schedMaxRegistered: int = 16777216

// ---------------------------------------------------------------------------
// The registry cursor the GC root scan drives (#1633)
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `forEachOtherStack` and `forEachTaskArg` (runtime/sched/:1243/1264)
// are the two root sources ABI.md §5 funnels through the scheduler: every OTHER
// registered task's stack, scanned conservatively, and EVERY registered task's
// opaque `arg`. Both take a callback, which `@nosplit` cannot express (a call
// through a value is E0075), so — exactly as `runtime/chan`'s registry scan did
// for the same reason — the traversal is exposed as a CURSOR and the collector
// drives it: `schedRegLock`, then `schedRegHead` plus `schedRegNext` until 0,
// then `schedRegUnlock`.
//
// The lock is handed out rather than taken per element because the caller holds it
// across the WHOLE walk (`defer self.reg_lock.release()`), and a cursor cannot.
// Under stop-the-world nothing else can be holding it: a mutator holds the
// registry lock only across the straight-line register/unregister bodies above.
//
// PINNED (ABI.md §9): `runtime/stw`'s collector is a separately-emitted object
// and reaches these by their emitted symbols (SPEC §11.9). `bit_rt_port_` is the
// placeholder prefix #1369 strips.

// Take the registry lock for the length of a walk.
//
// `spinCellAt` rather than the sibling `lockOf` — they compute the identical
// address (see `lockOf`'s comment), but `lockOf` is module-private and UNPINNED,
// and a cross-object caller that inlines this body would then reference
// `m<N>$lockOf`, a mangled name no sibling object can define. `--freestanding`
// refuses exactly that (SPEC §11.9), which is how this was found rather than
// guessed.
export @nosplit @symbol("bit_rt_port_sched_reg_lock") fn schedRegLock(s: *i64) {
  spinAcquire(spinCellAt(s, scRegLock))
}

// Release it.
export @nosplit @symbol("bit_rt_port_sched_reg_unlock") fn schedRegUnlock(s: *i64) {
  spinRelease(spinCellAt(s, scRegLock))
}

// First registered task address, or 0. Caller holds the registry lock.
export @nosplit @symbol("bit_rt_port_sched_reg_head") fn schedRegHead(s: *i64): int {
  let h = *(s + scRegHead)
  return h
}

// The next registered task after `t`, or 0. Caller holds the registry lock.
export @nosplit @symbol("bit_rt_port_sched_reg_next") fn schedRegNext(t: *i64): int {
  let n = *(t + taskRegNext)
  return n
}

// How many tasks are on the registry. Built from the same cursor.
export @nosplit fn schedRegCount(s: *i64): int {
  spinAcquire(lockOf(s, scRegLock))
  let n = 0
  let it = *(s + scRegHead)
  while (it != 0 && n < schedMaxRegistered) {
    n = n + 1
    it = *(taskAt(it) + taskRegNext)
  }
  spinRelease(lockOf(s, scRegLock))
  return n
}

// ---------------------------------------------------------------------------
// Work discovery moved to `workerfind.bit` (#4322)
// ---------------------------------------------------------------------------
//
// `schedFindWork`, `schedWorkPending`, `schedFindWorkIdle`, `schedFindWorkAt`
// and `schedStealRunNext` were moved verbatim into the sibling
// `workerfind.bit`. This file was 791 lines against the hard 800-line E0200
// ceiling. Same module, same imports, no resolution change; the pinned
// `bit_rt_port_sched_find_work*` symbols are unchanged.

// ---------------------------------------------------------------------------
// Deadlock detection (#2530, multi-worker #4134)
// ---------------------------------------------------------------------------
//
// Go panics `fatal error: all goroutines are asleep - deadlock!` when no
// goroutine can ever run again. This runtime used to just sit there, burning
// ~1% of a core on the idle spin forever — silent, no exit code, no message.
//
// THE STATES WHERE THERE IS NO RUNNABLE TASK AND THE PROGRAM IS FINE, and
// which of them this check can and cannot see from `runtime/sched/**` alone:
//
//   - a task parked on a TIMER that has not yet fired — SEEN: `schedTimerCount`
//     (`../sched/timer.bit`) counts the whole sleeping-task list, not just due
//     entries, so a sleeper excludes this check for its entire wait, not only
//     at the instant it wakes.
//   - a task parked on the NETPOLLER with a live registration (a server on
//     `accept()`, a client waiting on a response) — SEEN: `schedPollPendingCount`
//     (`../sched/timer.bit`) counts one-shot registrations armed with the
//     kernel but not yet drained; see its own comment for the one thing it
//     cannot see (a second, private scheduler+poller in the same process,
//     stress-harness only, and safe in the direction it is wrong).
//   - a task blocked in a genuine BLOCKING SYSCALL (unbracketed, off the
//     scheduler entirely) — SEEN, BY CONSTRUCTION, NOT BY A FLAG: the OS
//     thread performing that syscall cannot also be executing this function,
//     since it is inside the kernel; only a worker that has reached its own
//     idle turn ever evaluates this, so a thread mid-syscall is simply never
//     the one asking.
//   - ANOTHER OS WORKER THREAD still holding a runnable or running task —
//     above one worker this is now SEEN, in `./deadlockpool.bit`, which is
//     why `wkRunning` is an `atomicStore`/`atomicLoad` pair rather than the
//     plain access this file used before #4134. Read that file's header for
//     the one race atomics alone do not close and why a bounded confirmation
//     window, not a memory fence, is what closes it.
//
// THE FOURTH INPUT, AND WHY IT IS NOT OPTIONAL: `schedRegCount(s) > 0`. main's
// own `schedTaskExit` (`../sched/task.bit`) now sets `scStopping` SYNCHRONOUSLY
// with its own exit for exactly this reason — without it, an ordinary program
// that returns from `main` while a fire-and-forget spawned task is still
// alive but permanently parked (legitimate: an unwaited goroutine is simply
// abandoned when `main` returns) would satisfy every other condition below on
// the very next idle turn, before `runtime/root`'s separate boot thread ever
// gets to notice `mainDone` and call `schedShutdown` itself. `scStopping` is
// therefore checked FIRST, and is what makes that window closed rather than
// merely narrow.
//
// PANICS RATHER THAN REPORTS, matching Go's shape and SPEC §18.4's "panics are
// fatal by design": there is no `recover` in this language, so a caller who
// wants to distinguish this from an ordinary crash can only do so from the
// message on stderr, exactly as a Go program does from `recover`'s absence
// facing its own fatal errors.
//
// SPLIT AT `nworkers == 1`. The solo path below is #2530's original four
// checks, unchanged in order or behaviour — still sound for exactly the
// reason its own comment gave: this call is the only worker there is,
// so reaching an idle turn already proves nothing else in the process is
// running. Above one worker, `schedCheckDeadlockPool` (`./deadlockpool.bit`)
// takes over with the extra machinery the header above describes.
fn schedCheckDeadlock(s: *i64) {
  let n = atomicLoad(s + scNWorkers)
  if (n != 1) {
    schedCheckDeadlockPool(s, n)
    return
  }
  if (schedDeadlockBusy(s)) {
    return
  }
  panicDeadlock()
}

// `bit_rt_panic` (ABI.md §12): prints `panic: <msg>` and exits 2 (SPEC §18.4).
// Declared `extern` exactly as `runtime/chan/chanwrap.bit` and
// `runtime/root/slices.bit` already do from their own modules — it is a
// `libbitrt.a` member, so E0078 admits the declaration regardless of which
// module reaches for it, and `@nosplit` may call an `extern function` (E0075
// only forbids a non-`@nosplit` Bit one).
extern fn bit_rt_panic(msg: int)

// "all tasks are asleep - deadlock!" (32), Go's own wording with this
// runtime's vocabulary. Packed little-endian into i64 words exactly as
// `chanwrap.bit`'s panic messages are, and for the identical reason: computed,
// not hand-derived, and a module-static buffer so the panic path allocates
// nothing.
const deadlockMsgWord0: int = 7742639335768091745
const deadlockMsgWord1: int = 8313962007185399923
const deadlockMsgWord2: int = 7214816220395431276
const deadlockMsgWord3: int = 2408127755970699621
const deadlockMsgLen: int = 32

// The `{ptr, len}` string header (ABI.md §2) is words 0 and 1; `deadlockStrHeaderSize`
// is its size in BYTES, used only to compute where the text starts. Mirrored
// locally rather than imported: `runtime/sched` may import neither platform
// provider, and `runtime/root` (where these are normally exported from)
// imports `runtime/sched`, not the reverse — importing it back would be
// circular. Two header words plus four text words: 32 bytes of text, exactly
// `deadlockMsgLen`.
const deadlockStrHeaderSize: int = 16
let deadlockMsg: [6]i64

// Report the deadlock and abort. NEVER RETURNS.
fn panicDeadlock() {
  let msg: *i64 = ptrOf(deadlockMsg)
  let base = int(msg)
  *msg = base + deadlockStrHeaderSize
  *(msg + 1) = deadlockMsgLen
  *(msg + 2) = deadlockMsgWord0
  *(msg + 3) = deadlockMsgWord1
  *(msg + 4) = deadlockMsgWord2
  *(msg + 5) = deadlockMsgWord3
  bit_rt_panic(base)
}

// The two seam arguments for a consumer that drives NEITHER timers nor I/O —
// a pure-scheduler embedding, which is what every scheduler stress program is.
//
// They are named for what they DISABLE, not for what they return, because the
// dangerous mistake is passing `schedNoTimers` to a scheduler that does use
// `schedSleepUntil`: a deadline is `parkMonoNs() + ns`, so against a clock frozen
// at 0 NOTHING is ever due and every sleeper parks forever. That is #1648, and it
// is why the runtime's own boot path no longer takes this pair — see
// `schedWorkerStepNow`. A consumer with timers must pass a real monotonic clock
// (`runtime/park`'s `parkMonoNs`).
export @nosplit fn schedNoTimers(): int {
  return 0
}

export @nosplit fn schedNoPoller(schedAddr: int, timeoutMs: int): int {
  return 0
}

