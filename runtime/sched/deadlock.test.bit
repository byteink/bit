fn deadlockClaimAttempt(claim: *i64, winners: *i64, done: chan<bool>) {
  if (claimDeadlockReport(claim)) {
    atomicAdd(winners, 1)
  }
  done <- true
}

test "concurrent deadlock reporters elect exactly one winner" {
  let claim = []i64(1)
  let winners = []i64(1)
  let done = chan<bool>(16)
  let i = 0
  while (i < 16) {
    spawn deadlockClaimAttempt(ptrOf(claim), ptrOf(winners), done)
    i = i + 1
  }
  i = 0
  while (i < 16) {
    assert(<- done)
    i = i + 1
  }
  assert(winners[0] == 1, "deadlock report winners=${winners[0]}")
  assert(claim[0] == 1)
}

test "a deadlock report claim cannot be taken twice" {
  let claim = []i64(1)
  assert(claimDeadlockReport(ptrOf(claim)))
  assert(!claimDeadlockReport(ptrOf(claim)))
  assert(claim[0] == 1)
}
