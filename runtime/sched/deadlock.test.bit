test "deadlock report claim has one winner across repeated attempts" {
  let claim = []i64(1)
  let winners = 0
  let i = 0
  while (i < 16) {
    if (claimDeadlockReport(ptrOf(claim))) {
      winners = winners + 1
    }
    i = i + 1
  }
  assert(winners == 1, "deadlock report winners=${winners}")
  assert(claim[0] == 1)
}

test "a deadlock report claim cannot be taken twice" {
  let claim = []i64(1)
  assert(claimDeadlockReport(ptrOf(claim)))
  assert(!claimDeadlockReport(ptrOf(claim)))
  assert(claim[0] == 1)
}
