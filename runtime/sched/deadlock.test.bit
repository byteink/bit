class deadlockClaimProbe {
  claim: []i64,
  winners: []i64,
  done: chan<bool>,
}

fn deadlockClaimAttempt(probe: deadlockClaimProbe) {
  if (claimDeadlockReport(ptrOf(probe.claim))) {
    atomicAdd(ptrOf(probe.winners), 1)
  }
  probe.done <- true
}

test "concurrent deadlock reporters elect exactly one winner" {
  let probe = deadlockClaimProbe{
    claim = []i64(1),
    winners = []i64(1),
    done = chan<bool>(16),
  }
  let i = 0
  while (i < 16) {
    spawn deadlockClaimAttempt(probe)
    i = i + 1
  }
  i = 0
  while (i < 16) {
    assert(<- probe.done)
    i = i + 1
  }
  assert(probe.winners[0] == 1, "deadlock report winners=${probe.winners[0]}")
  assert(probe.claim[0] == 1)
}

test "a deadlock report claim cannot be taken twice" {
  let claim = []i64(1)
  assert(claimDeadlockReport(ptrOf(claim)))
  assert(!claimDeadlockReport(ptrOf(claim)))
  assert(claim[0] == 1)
}
