// The spinner half of the idle wake (#7404), split out of `sleep.bit`, which
// is at the 800-line limit. Same module. Sorts after `sleep.bit` and before
// `task.bit` and `workerrun.bit`, so `schedUnpark` still inlines its wake.
//
// Go's `ready` -> `wakep` rule: a task made runnable where only its waker's
// worker can see it wakes ONE parked peer, and none while a woken peer is
// still looking. `wkPark` holds `parkSpinner` on a worker so woken; worker 0's
// `wkSpinning` counts them. `sleep.bit`'s `schedIdlePark` carries the
// no-lost-wakeup argument.

// The scheduler's spinner count, on worker 0 (`wkSpinning`).
@nosplit fn schedSpinAddr(s: *i64): *i64 {
  return schedWorkerAt(s, 0) + wkSpinning
}

// A spinner found work (Go's `resetspinning`). A ready that saw this spinner
// skipped its own wake, and its publish is ordered before this decrement, so
// the probe after it sees that work; hand it to a parked peer, or it would
// wait for a park timeout while this worker runs something else.
@nosplit fn schedSpinDone(s: *i64) {
  atomicSub(schedSpinAddr(s), 1)
  if (schedWorkVisible(s)) {
    schedWakeSpinner(s)
  }
}

// A task was made runnable where only the running worker can see it — its own
// next-run slot (`schedUnpark`) — so wake one parked peer that may steal it,
// unless a woken peer is already looking (Go's `ready` -> `wakep`, #7404).
// Without it the task waited until its waker blocked or a parked peer's
// `idleParkMaxNs` timeout ran, measured at up to 190ms for a waker that keeps
// running. One spinner at a time is what keeps a lock handoff from paying a
// wake per handoff: the spinner releases its unit in `schedSpinDone` or
// `schedIdlePark`, and both hand on any work a skipped ready left.
@nosplit fn schedWakeSpinner(s: *i64) {
  if (atomicLoad(s + scIdleCount) <= 0) {
    return
  }
  let c = schedSpinAddr(s)
  if (atomicLoad(c) != 0 || !atomicCmpxchg(c, 0, 1)) {
    return
  }
  if (!schedWakePeerAs(s, parkSpinner)) {
    atomicSub(c, 1)
  }
}
