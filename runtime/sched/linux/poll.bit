// Linux netpoller provider for the Stage-2 port of runtime/sched/ (#1364):
// `NetPoller` on epoll. See ../sched.bit's netpoller section for what stays in
// core (the descriptor slot and the try-lock) and why the poller itself cannot.
//
// Raw syscalls (§11.8) rather than libc, for the reason the whole runtime uses
// them: the ELF output is fully static with no libc to call into.
//
// EVERY CONSTANT AND EVERY STRUCT OFFSET BELOW WAS READ OUT OF THE PLATFORM
// STDLIB, NOT FROM MEMORY. A wrong number here is a silent wrong-syscall or a
// silently misparsed event, never a compile error. Two of them would have been
// wrong from memory, and both are recorded at their definitions below:
// `epoll_wait` DOES NOT EXIST on aarch64, and `class epoll_event` is a
// DIFFERENT SIZE on the two architectures.

import { taskAt, schedPollUnpark, scPollFd, scPollFdWrite, pollRead } from "../../sched"
import { schedPollTryEnter, schedPollLeave } from "../../sched"
import { schedPollPendingInc, schedPollPendingDec, schedPollPendingCount } from "../../sched"
import { pollDrainWakeOnly, schedPollerWaitNs } from "../../sched"
import { schedCurrentWorker, wkId, schedMaxWorkers } from "../../sched"
import { sysClose, sysEpollCreate1, sysEpollCtl, sysEpollPwait } from "../../syscalls"
import { sysEpollPwait2 } from "../../syscalls"
import { sysRead, sysWrite, sysEventfd2 } from "../../syscalls"
// `pollWaitEvents`'s timer-slack drop. Imported from the park provider rather
// than re-issuing the prctl here, so `PR_SET_TIMERSLACK` and the slack this
// runtime asks for have one definition; `runtime/net/linux/tcp.bit` already
// reaches into this module the same way, and neither park module imports
// `runtime/sched/`, so the dependency stays one-directional.
import { parkLowerTimerSlack } from "../../park/linux"
// pollDesc (#5864/#5866): the register-once model's per-fd table.
// `pollDrainOne` below routes a register-once event (`./pollonce.bit`'s
// `pollDrainDescEvent`) through `pdWake` to find whichever task is CURRENTLY
// parked in that (fd, dir) slot, instead of the kernel event itself carrying
// a task pointer — same shape as the darwin twin's identical import.
import { pdWake, pdDirRead, pdDirWrite, pdEmpty } from "../../sched"

// Syscall numbers are per-architecture and Bit has no arch-conditional
// compilation, so the number is selected at run time (§11.8). `hostTarget()` is
// 0 for x86_64-linux and 1 for aarch64-linux; this module is only ever built
// for a Linux target, so the two cases are exhaustive. Same shape as
// runtime/park/linux/wait.bit.

// EPOLL_PWAIT, NOT EPOLL_WAIT — and this is the trap this module exists to
// avoid. `epoll_wait` has NO aarch64 syscall number at all: the arm64 table in
// The generic syscall table has `epoll_pwait = 22` and no `epoll_wait` entry,
// because arm64 is a "new" architecture that only ever got the pwait form.
// Number 22 on arm64 is a completely different call, so the obvious spelling
// would not fail to build — it would trap into the wrong syscall at run time.
// One form is used on both arches with a null signal mask, which is exactly
// what glibc's `epoll_wait` is a wrapper for.

// EPOLL_CTL_ADD / EPOLL_CTL_MOD / EPOLL_CTL_DEL, from
// include/uapi/linux/eventpoll.h.
//
// `@nosplit` (#5438): `pollRegister`/`pollUnregister` must be, so every
// function they call must be too (E0075 is transitive over user-function
// calls, not just over what a function itself does).
@nosplit fn ctlAdd(): int { return 1 }
@nosplit fn ctlDel(): int { return 2 }
@nosplit fn ctlMod(): int { return 3 }

// EPOLLIN / EPOLLOUT / EPOLLONESHOT (1 << 30). Same source.
@nosplit fn epollIn(): int { return 1 }
@nosplit fn epollOut(): int { return 4 }
@nosplit fn epollOneshot(): int { return 1073741824 }

// -EEXIST, the one errno with contract meaning here (see `pollRegister`).
@nosplit fn eExist(): int { return 17 }

// EFD_NONBLOCK (0o4000 = 2048, from <sys/eventfd.h>) — the same bit as
// O_NONBLOCK/SOCK_NONBLOCK (`../../net/linux/sock.bit`'s `oNonBlock`, every
// non-blocking flag on Linux shares this bit) — set at `eventfd2` creation so
// `pollDrainWakeEvent`'s drain read can never block a worker inside a syscall
// no other worker can preempt. The counter is guaranteed non-zero when that
// read runs (the kernel only reported the fd ready because it is), so this is
// a safety net against a future caller of this file, not a case the current
// one can reach.
@nosplit fn efdNonBlock(): int { return 2048 }

// `class epoll_event` IS NOT THE SAME SIZE ON THE TWO ARCHITECTURES, and
// nothing about the source spelling reveals that. The UAPI header declares it
//
//     pub const epoll_event = extern class {
//         events: u32,
//         data: epoll_data align(switch (native_arch) { .x86_64 => 4, else => 8 }),
//     };
//
// so x86-64 packs it to 12 bytes with `data` at offset 4 (the kernel's
// `EPOLL_PACKED`, which exists so 32-bit and 64-bit x86 agree), while every
// other architecture gets natural alignment: 16 bytes with `data` at offset 8.
//
// Getting this wrong is invisible in a single-architecture test — the stride is
// only used to walk the kernel's answer, so a wrong one silently reads garbage
// as task pointers and unparks whatever it finds. Both values are asserted
// against the running kernel by _tests_/stress/schedpolllinux.
fn eventStride(): int {
  if (hostTarget() == 0) {
    return 12
  }
  return 16
}

fn eventDataOff(): int {
  if (hostTarget() == 0) {
    return 4
  }
  return 8
}

// `eventDataOff`'s answer, cached once a poll descriptor exists so
// `pollRegister` (#5438, `@nosplit`) can read it without calling
// `hostTarget()` — a real `bit_rt_host_target` runtime call, not (unlike
// `syscall`, an inline trap) on the compiler's `@nosplit` allowlist, so
// calling it from a `@nosplit` body is E0075. `eventDataOff` above stays the
// source of truth for `pollDrainOne`, which is not `@nosplit`; this is a
// one-word cache of its answer for the one caller that needs it nosplit-safe.
//
// SAFE TO CACHE, BECAUSE THE ARCHITECTURE CANNOT CHANGE MID-PROCESS: every
// `pollFd` a caller can ever pass to `pollRegister` was handed out by
// `pollCreate`, which fills this cache before returning it, so no nosplit
// caller can reach `pollRegister` with a valid descriptor before the cache is
// filled. `pollCreate` may run more than once (one poll descriptor per
// worker); re-deriving the identical value each time is redundant, never
// wrong.
let eventDataOffCache: [1]i64

@nosplit fn layoutBytes(): *u8 {
  let z: *u8 = nil
  return z + int(ptrOf(eventDataOffCache))
}

fn cacheEventDataOff() {
  writeU64(layoutBytes(), 0, eventDataOff())
}

@nosplit fn eventDataOffNosplit(): int {
  return readU64(layoutBytes(), 0)
}

// Ready events drained per call. `runtime/sched/`'s `max_batch`; more ready events
// simply wait for the next poll, which bounds the work one idle pass can do
// (Power of 10).
const maxBatch: int = 64

// The drain buffer, sized for the larger of the two strides (64 * 16 = 1024
// bytes = 128 words).
//
// MODULE-LEVEL, AND THAT IS SAFE ONLY BECAUSE OF THE TRY-LOCK. `pollDrain` runs
// on every idle pass of every worker, so allocating a fresh buffer per call
// would put a GC allocation on the scheduler's idle path. A shared static
// buffer is sound here precisely because `schedPollTryEnter` admits exactly one
// worker at a time — the same exclusion that stops two workers double-waking a
// task. If that try-lock is ever removed, this buffer must become per-worker in
// the same change.
let evBuf: [128]i64

// A byte cursor over a word-aligned region. A Bit slice or array stores one
// 8-BYTE WORD per element (§11.8), so an `[]u8` would be strided, not packed —
// the kernel's structs must be read and written through a `*u8` walking a
// region that really is contiguous bytes, which an `[N]i64` is.
@nosplit fn bytesOf(): *u8 {
  let z: *u8 = nil
  return z + int(ptrOf(evBuf))
}

// Read a little-endian u64 at `off`. Done byte-wise rather than through an
// `*i64` because `data` sits at offset 4 on x86-64 — a 4-byte-aligned address
// that pointer arithmetic on a `*i64` (which scales by 8) cannot even name.
//
// The top byte is included for completeness; a user-space task address never
// sets bit 63 on either target, so the reassembly cannot overflow `int`.
// `@nosplit` (#5438): all three are called from `pollRegister`/
// `eventDataOffNosplit` (`readU64`) or `pollRegister` directly (`writeU64`,
// `writeU32`).
@nosplit fn readU64(base: *u8, off: int): int {
  let v = 0
  let k = 7
  while (k >= 0) {
    let p = base + off + k
    v = v * 256 + int(*p)
    k = k - 1
  }
  return v
}

@nosplit fn writeU32(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 4) {
    let p = base + off + k
    *p = u8(v / (1 << (8 * k)) % 256)
    k = k + 1
  }
}

@nosplit fn writeU64(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 8) {
    let p = base + off + k
    *p = u8(v / (1 << (8 * k)) % 256)
    k = k + 1
  }
}

// Create the poll descriptor. `runtime/sched/`'s `createPollFd`. Returns -1 on
// failure, which the caller must check — there is no errno to consult.
//
// A DESCRIPTOR OF 0 IS REPORTED AS FAILURE, and that rule belongs here rather
// than in the caller. `../worker.bit`'s scheduler block spells "no poller bound"
// as a `scPollFd` of 0, so `netAwaitReady` and `pollDrain` both read 0 as "there
// is no poller" — a descriptor 0 would be indistinguishable from an unbound one
// at every site that matters. The kernel only hands out 0 when stdin is closed,
// which this runtime never does, so this rejects nothing real; it is here so the
// sentinel cannot be forged.
//
// THE BRANCH IS ALSO WHAT KEEPS THIS FUNCTION OUT OF ITS CALLER'S OBJECT, and
// that is load-bearing rather than incidental. `compiler/optinline.bit` inlines a
// callee only when it is a SINGLE BLOCK, and the one-line form this used to have
// was duly spliced into `runtime/root/linux`'s `boot` — which then referenced the
// module-private `nr` under a mangled `m<N>$nr` that no sibling object defines,
// and `--freestanding` refuses exactly that (SPEC §11.9). Every pinned entry a
// freestanding consumer calls must either carry a branch or reference nothing
// private; `pollClose` below is the same case.
export @symbol("bit_rt_port_sched_poll_create") fn pollCreate(): int {
  let rc = int(syscall(sysEpollCreate1(), 0))
  if (rc <= 0) {
    return 0 - 1
  }
  // Fills `eventDataOffCache` before handing out a descriptor any caller
  // could pass to `pollRegister` — see that cache's own comment.
  cacheEventDataOff()
  // ARMED BEFORE THIS RETURNS (#5718), same ordering argument as darwin's
  // twin: `rc` is not published anywhere a producer can reach until
  // `schedSetPollFd`/`schedSetPollFdWrite` runs, always this call's very
  // next step (`runtime/root/linux/boottail.bit`), so no `pollWake` can run
  // against this descriptor before the wake eventfd exists on it. A
  // registration failure closes the epoll descriptor rather than handing
  // back one whose wake side would silently do nothing.
  if (!pollArmWake(rc)) {
    let _ = int(syscall(sysClose(), i64(rc)))
    return 0 - 1
  }
  return rc
}

// Close it. A non-positive descriptor is "never created" and closing it would
// hand the kernel a fabricated fd, so the guard is a real precondition and not
// only the anti-inlining branch `pollCreate` documents.
//
// THE WAKE EVENTFD'S AND THE NESTING'S LIFETIMES ARE TIED TO THIS `pollFd`'S
// HERE (#5718, #5736), and
// that is load-bearing rather than tidiness. The kernel reuses closed fd
// numbers for the next `open`-family call on the same process, so a
// `pollClose` that left `wakeSlotFor(pollFd)` pointing at the now-closed
// eventfd would have a LATER, unrelated `pollCreate()` call receive that
// same `pollFd` number back and silently inherit a stale table entry —
// `pollWake` would then trigger a closed descriptor, and `pollDrainOne`
// would read from one, both undetectable failures. Closing and removing the
// entry here, before the descriptor itself is closed, keeps the number free
// of any stale binding by the time the kernel can hand it out again.
export @symbol("bit_rt_port_sched_poll_close") @nosplit fn pollClose(pollFd: int) {
  if (pollFd <= 0) {
    return
  }
  let slot = wakeSlotFor(pollFd)
  if (slot >= 0) {
    let _ = int(syscall(sysClose(), i64(readU64(wakeEfdBytes(), slot * 8))))
    wakeSlotRemove(pollFd)
  }
  // The nested write descriptor (#5736), on exactly the terms above: an entry
  // left behind would have a LATER `pollCreate()` handed this same fd number
  // back and silently inherit it, so `pollNestWrite` would report a pair that
  // does not exist and `pollDrainOne` would read this file's sentinel for a
  // descriptor nobody nested. Matched on EITHER end, because boot closes the
  // parent first and the child second.
  pollNestClear(pollFd)
  let _ = int(syscall(sysClose(), i64(pollFd)))
}

// Per-worker scratch for the `epoll_event` struct `pollRegister`/
// `pollUnregister` build (#5438). NOT `evBuf` above: that buffer is sound
// shared state only because `schedPollTryEnter`'s try-lock admits one worker
// at a time, and register/unregister are not behind that lock — several
// green tasks on several workers call either concurrently, so one shared
// buffer would let two of them stomp each other's struct mid-build.
//
// One slot per worker (not per task) is enough: only one task runs per
// worker at a time (cooperative M:N), and neither function yields or reaches
// a safepoint mid-body, so within a single worker a register and an
// unregister can never be mid-flight together. Same shape as
// `runtime/net/sock.bit`'s `sockScratchSlot()`/`saBuf` and the Darwin twin's
// identical buffer — (schedMaxWorkers + 1) slots, the extra one a fallback
// for a caller off a green stack, sized with its own literal because a
// fixed-array length must be one (E0021, the same constraint `preempt.bit`
// documents for `preemptSlots`).
const pollScratchSlots: int = 32

@nosplit fn pollScratchSlot(): int {
  let w = schedCurrentWorker()
  if (w == 0) {
    return pollScratchSlots
  }
  let id = *(taskAt(w) + wkId)
  if (id < 0 || id >= schedMaxWorkers || id >= pollScratchSlots) {
    return pollScratchSlots
  }
  return id
}

// (pollScratchSlots + 1) slots of 2 words (16 bytes) each = 66 words — sized
// for the LARGER `epoll_event` (aarch64, 16 bytes; x86-64 packs to 12 and
// uses only the first 12 of each 16-byte slot).
let pollRegScratch: [66]i64

@nosplit fn pollScratchBytes(): *u8 {
  let z: *u8 = nil
  return z + int(ptrOf(pollRegScratch)) + pollScratchSlot() * 16
}

// Register `task` to be woken when `fd` is ready for `interest`.
//
// ONESHOT: the fd is disarmed on the first event, so a woken
// task must re-register before parking on it again. That is what makes the
// wake edge unambiguous — without it a level-triggered fd would re-report
// readiness on every poll until the task got round to draining it, and every
// one of those reports would try to unpark an already-running task.
//
// THE ADD/MOD SPLIT IS NOT AN OPTIMISATION. ONESHOT disarms the fd but leaves
// it in the epoll set, so the NEXT registration of the same open fd must re-arm
// with CTL_MOD — CTL_ADD returns EEXIST. kqueue's EV_ADD re-arms in place, so
// this split is Linux-only and has no Darwin twin. It is also the common path,
// not an edge case: a socket typically waits for `write` on connect and then
// `read` on first use, which re-registers within one fd's lifetime. `runtime/sched/`
// records this as a regression fix for a real epoll hang.
export @symbol("bit_rt_port_sched_poll_register") @nosplit fn pollRegister(
  pollFd: int,
  fd: int,
  interest: int,
  task: int,
): bool {
  let base = pollScratchBytes()

  let io = epollOut()
  if (interest == pollRead) {
    io = epollIn()
  }
  writeU32(base, 0, io + epollOneshot())
  writeU64(base, eventDataOffNosplit(), task)

  let evAddr = i64(int(base))
  let add = int(syscall(sysEpollCtl(), i64(pollFd), i64(ctlAdd()), i64(fd), evAddr))
  if (add == 0) {
    // Counted only once armed with the kernel — see `schedPollPendingInc`'s
    // own comment for why this is a process-global rather than a `Scheduler`
    // field.
    schedPollPendingInc()
    return true
  }
  if (add != 0 - eExist()) {
    return false
  }
  let mod = int(syscall(sysEpollCtl(), i64(pollFd), i64(ctlMod()), i64(fd), evAddr))
  if (mod != 0) {
    return false
  }
  schedPollPendingInc()
  return true
}

// Retract a registration before it fires (#5430). This is the primitive that
// closes the race ../../sched.bit's netpoller section and ../timer.bit's
// `schedTimerPush` describe: a task linked on BOTH the poller and
// `scTimerHead` leaves the loser of that race holding a `Task` address the
// winner may already have run to completion and freed. A caller that wins the
// other side of such a race (a timer firing, or a second interest on the same
// task) must retract this side before touching the task again.
//
// `interest` IS UNUSED HERE, and that asymmetry with the Darwin twin is real:
// `EPOLL_CTL_DEL` removes the fd's whole epoll registration, because unlike
// kqueue epoll keys a registration on the fd alone (see `pollRegister`'s "ADD/MOD
// split" comment) — there is no separate read/write knote to pick between. The
// parameter stays so both providers share one call shape.
//
// UNLIKE THE DARWIN TWIN, a successful return here does NOT prove the kernel
// had not already reported the edge. `EPOLLONESHOT` only clears the event
// mask on delivery; it does not remove the fd from the epoll set the way
// kqueue's `EV_ONESHOT` auto-deletes the knote. So `EPOLL_CTL_DEL` still
// succeeds after the registration has already fired, and this primitive alone
// cannot tell that case apart from a genuine retraction — a caller on Linux
// that needs to know which side won a race needs an ordering argument beyond
// this return value, which is exactly why the net-side race itself is a
// separate ticket from this retraction primitive.
export @symbol("bit_rt_port_sched_poll_unregister") @nosplit fn pollUnregister(
  pollFd: int,
  fd: int,
  interest: int,
): bool {
  if (pollFd <= 0 || fd < 0) {
    return false
  }
  // The kernel does not read this struct for `EPOLL_CTL_DEL` (it only needs a
  // non-null pointer, a pre-2.6.9 kernel bug workaround libc callers still
  // carry) — the scratch slot's leftover bytes from whatever last wrote it
  // are never inspected, so nothing needs zeroing here.
  let evAddr = i64(int(pollScratchBytes()))

  let del = int(syscall(sysEpollCtl(), i64(pollFd), i64(ctlDel()), i64(fd), evAddr))
  if (del != 0) {
    return false
  }
  // The one-shot edge this registration owed will now never be reported by
  // the kernel, so the outstanding count this call is retracting must drop
  // here — `schedPollPendingDec`'s own comment ties it to the kernel reporting
  // the edge, and a retracted registration is the one path where that never
  // happens.
  schedPollPendingDec()
  return true
}

// True when this drain can answer without entering the kernel — either there
// is no poller at all, or nothing is armed on it. Same shape and same contract
// as the darwin and windows twins.
//
// NOTHING ARMED => NOTHING CAN BE READY (#3736). Every registration is
// one-shot (`EPOLLONESHOT`) and counted by `schedPollPendingInc` on the
// success paths of `pollRegister` — the only paths that arm one — and
// decremented only when the kernel reports its one edge. A zero count means
// no armed registration exists on EITHER descriptor (`scPollFd` and
// `scPollFdWrite` are both fed by that same counter), so an `epoll_pwait` with
// a zero timeout can only return 0 events; skipping it returns what the call
// was going to return rather than approximating it.
//
// ONLY FOR THE NON-BLOCKING DRAIN. A positive `timeoutNs` is a request to
// WAIT, and `pollDrain`'s own header says so ("a non-worker caller may
// legitimately want to wait"); answering that with an immediate 0 turns a
// bounded park into a hot spin. See the darwin twin for the full argument and
// for why a stale count can only err toward doing the syscall.
//
// NOT SKIPPABLE FOR A WAKE ALONE. The wake eventfd `pollArmWake` registers is
// deliberately NOT counted by `schedPollPendingInc`/`schedPollPendingCount`
// (see `pollArmWake`'s own comment) — a zero count still means no READ/WRITE
// event can be ready, and that is the only question this skip answers. For
// `timeoutNs == 0` a caller has already said "do not wait", so whether the
// wake fd happens to be armed is irrelevant either way.
@nosplit fn pollDrainSkippable(pollFd: int, timeoutNs: int): bool {
  if (pollFd == 0) {
    return true
  }
  return timeoutNs == 0 && schedPollPendingCount() == 0
}

// Drain ready events and unpark the waiting task for each. Returns how many
// were woken, or `pollDrainWakeOnly` when the only event was worker 0's wake.
// `runtime/sched/`'s `pollReady`.
//
// NANOSECONDS (#5718) — darwin's twin was widened first, by #5717, under the
// same exported linker name, `bit_rt_port_sched_poll_drain`; that symbol
// links three different functions for stop-the-world interposition only
// (`_tests_/bit/stwwiring`), never a cross-platform call, so nothing but the
// parameter's OWN name enforces its unit here. Read it before writing a
// call; never copy an argument expression out of another provider's file.
// WINDOWS IS NOW THE LONE MILLISECOND PROVIDER — darwin and linux agree;
// widening windows is unplanned (see its own file for the current note).
//
// A sub-millisecond deadline used to truncate to 0 under the old millisecond
// parameter, which `pollDrainSkippable` reads as the non-blocking form —
// hot-spinning a caller that asked to wait a few hundred microseconds rather
// than blocking it. `pollDrainOne`'s `nsToEpollMs` is where that conversion
// now happens, once, at the one syscall boundary that still counts in
// milliseconds.
//
// THE RUN LOOP CALLS THIS WITH `timeoutNs` 0 TODAY — a non-blocking drain,
// which is what `runtime/sched/` passes too. That is what keeps the poller
// compatible with stop-the-world: a worker never blocks in `epoll_pwait`, so
// it is never sitting in a syscall where it is neither `running` nor
// `parked` and cannot answer the collector's rendezvous. A caller wiring in
// a genuinely blocking `timeoutNs` (the dependent ticket this one unblocks)
// takes on that obligation — nothing here relaxes it.
export @symbol("bit_rt_port_sched_poll_drain") fn pollDrain(schedAddr: int, timeoutNs: int): int {
  let s = taskAt(schedAddr)
  let pollFd = *(s + scPollFd)
  if (pollDrainSkippable(pollFd, timeoutNs)) {
    return 0
  }
  // Losing this race is free — the loser looks for work elsewhere this pass and
  // polls on the next one. See ../sched.bit for why it must not block.
  if (!schedPollTryEnter(s)) {
    return 0
  }

  // BOTH descriptors are drained (#1910): read interest lives in `scPollFd` and
  // write interest in `scPollFdWrite`, because epoll keys a registration on the
  // fd alone and `EPOLL_CTL_MOD` would otherwise have the two directions evict
  // each other on a socket with a concurrent reader and writer.
  //
  // The write descriptor is drained with timeout 0 regardless of `timeoutNs`.
  // Only the first wait may block, or a caller asking for a 10ms poll would wait
  // up to 20ms; and the caller's contract is "drain what is ready", which a
  // non-blocking second pass satisfies. `scPollFdWrite` is 0 when unbound, which
  // `pollDrainOne` reads as "nothing to do".
  //
  // THE TWO ANSWERS ARE COMBINED, NOT ADDED. Either may be
  // `pollDrainWakeOnly`, which is a signal and not a count, so adding it to the
  // other descriptor's count would both understate the count and lose the
  // signal. `pollDrainTasks` takes the count half of each and `pollDrainAnswer`
  // re-applies the signal once, for the pair.
  let readAnswer = pollDrainOne(s, pollFd, schedPollerWaitNs(s, timeoutNs))
  let writeAnswer = pollDrainOne(s, *(s + scPollFdWrite), 0)
  schedPollLeave(s)
  return pollDrainAnswer(
    pollDrainTasks(readAnswer) + pollDrainTasks(writeAnswer),
    readAnswer == pollDrainWakeOnly || writeAnswer == pollDrainWakeOnly,
  )
}

// Round a nanosecond deadline UP to whole milliseconds for `epoll_pwait`,
// which takes a plain millisecond `int` rather than a `timespec` (unlike
// kqueue, so darwin's provider has no twin for this function — its
// nanosecond/second split feeds a struct field, not an integer conversion).
//
// THE PRE-5.11 PATH ONLY (#5737). `pollDrainOne` waits in `epoll_pwait2`,
// which takes the `timespec` this rounding exists to avoid needing; this
// conversion is reached only after `sysEpollPwait2` has come back -ENOSYS on
// this kernel once and `pwait2Latch` has recorded it. It is what "degrade to
// today's `epoll_pwait`" means, and it is why this function did not go away
// with the deadline rounding it used to impose on every wait.
//
// CEILING, NEVER TRUNCATION. `timeoutNs / 1000000` alone would turn any
// sub-millisecond, still-positive deadline into `0` — the exact bit pattern
// `pollDrainSkippable` treats as the deliberate non-blocking sentinel. That
// silently converts a bounded wait into a busy, zero-timeout spin: no crash,
// no wrong answer, nothing a gate observes, only a caller doing far more
// `epoll_pwait` calls than it asked for. Rounding up instead costs at most
// 999,999ns of extra wait once per call, and `timeoutNs == 0` is the one
// value this must NOT round away from — it stays exactly `0`, the sentinel
// `pollDrainSkippable` already special-cases before this function is ever
// reached for the read descriptor, and the write descriptor's own `0` literal
// below.
@nosplit fn nsToEpollMs(timeoutNs: int): int {
  if (timeoutNs <= 0) {
    return 0
  }
  let ms = timeoutNs / 1000000
  if (timeoutNs % 1000000 != 0) {
    ms = ms + 1
  }
  return ms
}

// --------------------------------------------------------------------------
// The wait itself (#5737): `epoll_pwait2`, with a one-way degrade to
// `epoll_pwait` on a kernel that does not have it.
// --------------------------------------------------------------------------

// -ENOSYS. 38 on BOTH Linux architectures: aarch64 takes it from
// `include/uapi/asm-generic/errno.h` and x86-64 from
// `arch/x86/include/uapi/asm/errno.h`, which is a one-line include of the
// generic file — every errno below 133 is shared. Read there, not from
// memory, in the same throwaway container that produced `sysEpollPwait2`'s
// number.
@nosplit fn eNoSys(): int { return 38 }

@nosplit fn nsPerSecond(): int { return 1000000000 }

// True once this kernel has answered -ENOSYS to `epoll_pwait2`.
//
// ONE-WAY, SET ONCE, NEVER CLEARED, so a pre-5.11 kernel costs exactly one
// wasted syscall for the whole process rather than one per idle turn. A
// module-level word rather than per-worker state because the answer is a
// property of the running kernel, identical for every worker; two workers
// racing to set it can only both write the same 1, so no atomic is needed
// for the same reason `eventDataOffCache` above needs none.
let pwait2Latch: [1]i64

// The `struct __kernel_timespec` `epoll_pwait2` reads: `tv_sec` then
// `tv_nsec`, two 64-bit words on both architectures — unlike `epoll_event`
// above, which really does differ (see `eventStride`), this one does not, so
// it is written as two plain word stores rather than through a byte cursor.
//
// MODULE-LEVEL AND SHARED, on exactly the argument `evBuf` above makes:
// `schedPollTryEnter`'s try-lock admits one worker at a time into
// `pollDrainOne`, this buffer's only writer. NOT a GC-managed `[]i64`, for
// the reason `runtime/park/linux/wait.bit`'s `parkWait` records at length
// (#3914): worker 0 blocks here inside a `gcBlockingBegin`/`gcBlockingEnd`
// bracket, where the collector is told this thread holds no live reference,
// and a heap slice handed to the kernel across that bracket was swept under
// the syscall.
let waitTs: [2]i64

// Force the pre-5.11 degrade path on a kernel that HAS `epoll_pwait2`.
//
// A TEST SEAM, AND THE ONLY WAY THE FALLBACK CAN BE EXECUTED rather than
// merely read: the box this runtime is developed on runs a kernel new enough
// that `sysEpollPwait2` never returns -ENOSYS, so without this the degrade
// path would ship having run zero times.
// `_tests_/stress/schedpollwait2linux` calls it and then asserts the SAME
// 400us wait rounds up to a real 1ms block — not that it returns instantly,
// which is the failure the degrade must never have. One-way, exactly like
// the latch it sets, so it cannot turn `epoll_pwait2` back on mid-process,
// and no runtime path calls it.
export @nosplit fn pollDisablePwait2() {
  let q = ptrOf(pwait2Latch)
  *q = 1
}

// Wait for ready events on `pollFd`, leaving them in `evBuf`. Returns the
// kernel's own answer: the event count, 0 on timeout, or a negative errno.
//
// NANOSECOND-EXACT, WHICH IS THE WHOLE POINT (#5737). `epoll_pwait`'s timeout
// is a whole-millisecond `int`, so `nsToEpollMs` had to round a 200us
// deadline up to a 1ms wait — a 5x overshoot neither `clock_nanosleep` nor
// kqueue's `timespec` pays, and the reason worker 0
// (`runtime/root/linux/bootworker.bit`) used to send every sub-millisecond
// wait to `parkSleepNs` instead of here, paying a drain-then-sleep PAIR of
// syscalls per idle turn to keep the precision.
//
// THE DEGRADE IS TODAY'S `epoll_pwait`, AND NEVER A ZERO TIMEOUT. A pre-5.11
// kernel has no `epoll_pwait2`; the answer is the millisecond call with
// `nsToEpollMs`'s round-UP, i.e. exactly what this file did before this
// change — a bounded wait that is at worst 999,999ns too long. Degrading to
// a 0 timeout instead would be silent and far worse: `pollDrainSkippable`
// reads 0 as the deliberate non-blocking sentinel, so worker 0's bounded
// wait would become a hot spin, with nothing crashing and no gate observing
// it.
//
// A NULL `timeout` IS `epoll_pwait2`'s "block forever", so a non-positive
// `timeoutNs` must still pass a real, zeroed `timespec` — `pollDrain` drains
// the write descriptor with a literal 0 and must not be parked on it.
//
// THE THREAD'S TIMER SLACK IS DROPPED FIRST, AND THAT IS NOT A `nanosleep`
// DETAIL LEAKING IN (#5749). `timer_slack_ns` is per-THREAD state that floors
// `schedule_hrtimeout_range`'s range through `select_estimate_accuracy()`, so
// it lengthens the deadline of THIS wait exactly as it lengthens
// `parkSleepNs`'s. Worker 0 used to take its sub-millisecond waits through
// `parkSleepNs`, which lowers the slack on every call, and inherited the drop
// for free; sending every wait here instead (above) left its thread on the
// kernel's 50000ns default and cost a flat ~50us on every wake — see
// `parkLowerTimerSlack`'s header for the three-period measurement and for the
// SCHED_FIFO control that isolates the slack from everything else.
//
// ON EVERY BLOCKING WAIT, NOT ONCE, for the reason `parkSleepNs` states and
// one more this path adds. The state is per-thread and the kernel copies it at
// clone time, so any "already lowered" flag would itself have to be per-thread
// or it would skip the call on a worker thread created after the first wait —
// and this function has no thread identity to hang one on, only the poller
// try-lock, which admits a DIFFERENT worker each pass. The call is idempotent,
// it is the same one the pre-#5737 path made per idle turn, and it is paid
// only where the caller is about to block for real.
//
// NOT ON THE NON-BLOCKING DRAIN. `timeoutNs == 0` is `pollDrain`'s write-side
// drain and `runtime/sched/`'s hot idle poll, which return without sleeping;
// a syscall per turn there would be a new steady-state cost in place of the
// one this removes, and a wait of zero has no deadline for slack to move.
@nosplit fn pollWaitEvents(pollFd: int, timeoutNs: int): int {
  if (timeoutNs > 0) {
    parkLowerTimerSlack()
  }
  if (*ptrOf(pwait2Latch) == 0) {
    let ns = timeoutNs
    if (ns < 0) {
      ns = 0
    }
    let ts = ptrOf(waitTs)
    *(ts + 0) = i64(ns / nsPerSecond())
    *(ts + 1) = i64(ns % nsPerSecond())
    // epoll_pwait2(epfd, events, maxevents, timeout, sigmask, sigsetsize) —
    // the same six arguments as `epoll_pwait` below, with a `timespec`
    // POINTER where that one takes a millisecond count.
    let rc2 = int(
      syscall(
        sysEpollPwait2(), i64(pollFd), i64(int(ptrOf(evBuf))),
        i64(maxBatch), i64(int(ts)), 0, 8,
      ),
    )
    if (rc2 != 0 - eNoSys()) {
      return rc2
    }
    let q = ptrOf(pwait2Latch)
    *q = 1
  }
  // epoll_pwait(epfd, events, maxevents, timeout, sigmask, sigsetsize). The
  // null sigmask makes this exactly `epoll_wait`; `sigsetsize` is unread by the
  // kernel when the mask is null, and 8 is the value a real sigset_t would have.
  return int(
    syscall(
      sysEpollPwait(), i64(pollFd), i64(int(ptrOf(evBuf))),
      i64(maxBatch), i64(nsToEpollMs(timeoutNs)), 0, 8,
    ),
  )
}

// `pollDrainOne`/`pollDrain`'s answer, given how many tasks the drain unparked
// and whether it also consumed worker 0's wake. Two independent facts, one
// return value: a positive count wins, because it already sends the caller down
// the find-work path, and `pollDrainWakeOnly` (../../sched/sleep.bit) carries
// the rest — "no task, but something asked you to look again".
@nosplit fn pollDrainAnswer(woken: int, sawWake: bool): int {
  if (woken > 0) {
    return woken
  }
  if (sawWake) {
    return pollDrainWakeOnly
  }
  return 0
}

// The TASK-COUNT half of a `pollDrainOne` answer, so `pollDrain` can add the
// read and write descriptors' counts without `pollDrainWakeOnly` being added to
// one of them. The wake half is recovered by comparing against the sentinel.
@nosplit fn pollDrainTasks(answer: int): int {
  if (answer < 0) {
    return 0
  }
  return answer
}

// Drain one epoll descriptor and unpark the task behind each ready event.
// Returns how many tasks it woke, or `pollDrainWakeOnly` when the only thing it
// drained was the wake eventfd. A non-positive descriptor is "not bound" and
// drains nothing.
//
// Split out of `pollDrain` so the read and write descriptors share this body
// verbatim rather than keeping a copy each that could drift — the two differ
// only in which descriptor and which timeout they are handed. The caller holds
// the poll try-lock across both.
fn pollDrainOne(s: *i64, pollFd: int, timeoutNs: int): int {
  if (pollFd <= 0) {
    return 0
  }
  let rc = pollWaitEvents(pollFd, timeoutNs)
  let woken = 0
  let sawWake = false
  if (rc > 0) {
    // Bounded by the batch, not by the kernel's answer, so a bogus oversized
    // `rc` cannot walk off the buffer (Power of 10).
    let n = rc
    if (n > maxBatch) {
      n = maxBatch
    }
    let base = bytesOf()
    let i = 0
    while (i < n) {
      let off = i * eventStride()
      let data = readU64(base, off + eventDataOff())
      if (data == nestSentinel()) {
        // The nested write descriptor became readable (#5736) — which is the
        // whole job: this event ENDED the blocking wait. `pollDrain` drains
        // `scPollFdWrite` unconditionally on its very next line, so there is
        // nothing to do here, and nothing to decrement: this registration is
        // permanent and level-triggered, never counted by
        // `schedPollPendingInc`.
      } else if (data < 0) {
        // Register-once event (#5866, `./pollonce.bit`): `data` is
        // `0 - (1 + fd*2^pdcGenBits + genTag)`, never a task pointer — a
        // permanent, edge-triggered registration means the kernel event
        // names the (fd, dir) slot, and `pollDrainDescEvent` finds whoever is
        // CURRENTLY parked there (or records the edge for the next waiter).
        // The count this decrements tracks live PARKED WAITERS, not live
        // kernel registrations (`netAwaitReady`/`netReadSockDeadline`
        // increment it on a successful `pdWait`), so it drops only when a
        // `pdWake` inside `pollDrainDescEvent` actually finds a task to
        // remove.
        woken = woken + pollDrainDescEvent(s, base, off, data)
      } else if (data != 0) {
        // The kernel's one-shot edge is consumed here regardless of what
        // `schedPollUnpark` does with it below — the registration this
        // decrements was armed once and the kernel just reported it exactly
        // once, so the count must drop whether or not a task was there to
        // catch it.
        schedPollPendingDec()
        // `schedPollUnpark`, NOT `schedUnpark`: a one-shot registration means
        // this readiness edge is already consumed, so a task caught between
        // registering and parking must be handed the wake rather than have it
        // dropped. See ../task.bit's "arming a park" section.
        if (schedPollUnpark(s, data)) {
          woken = woken + 1
        }
      } else {
        // The wake eventfd. Draining the counter is only half the job: the
        // caller asked "is there anything to do", and a wake IS something to
        // do — it is a producer saying it published work or a deadline after
        // this caller's own find-work pass had already looked. Reporting 0
        // here hands the caller a drained counter and a claimed `scPollWait`
        // and then tells it to sleep, which is the wake dropped AFTER being
        // delivered; `sawWake` is what stops that.
        pollDrainWakeEvent(pollFd)
        sawWake = true
      }
      i = i + 1
    }
  }
  return pollDrainAnswer(woken, sawWake)
}
