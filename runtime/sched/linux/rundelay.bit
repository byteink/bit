// How long the calling thread has spent runnable but not on a CPU (#6427): the
// `run_delay` field of `/proc/thread-self/schedstat`, in nanoseconds. It is what
// lets a late timer wake be ATTRIBUTED. A worker-0 wait that ends 80ms after its
// 2ms bound is one of two things: the thread was asleep and nothing woke it (a
// runtime defect), or its timer fired and the kernel then left it on a run queue
// behind other threads (the host). Only the second grows this counter, by about
// the overshoot, and `schedTimerTraceOsHeld` (`../timertrace.bit`) compares the
// two.
//
// CALLED ONLY WHEN TRACING IS ON (`schedTimerTraceEnable`) and only from worker
// 0's thread, which is why the descriptor is one process-global opened by the
// first caller: `/proc/thread-self` names the thread that opens it, and a
// positional read of that descriptor from the same thread re-renders it every
// time. Two syscalls per worker-0 wait, paid by the stress programs that asked
// for it and nobody else.
//
// 0 when the file cannot be opened or read (a kernel without
// CONFIG_SCHED_INFO, a sandbox without /proc), so the caller's delta is 0 and
// nothing is excused: the failure direction is "a late wake stays a failure".

import { onX64, sysOpenatArm64, sysOpenatX64, sysPread64, sysAtFdCwd } from "../../syscalls"

let rdPath: [4]i64
let rdBuf: [8]i64
// The descriptor plus one: 0 is "not opened yet", so an open that returns fd 0
// (stdin closed) is not mistaken for that and reopened, leaking one per call.
let rdFd: [1]i64

// The first number after the first space of `b[0:n]`, i.e. field 2.
@nosplit fn rdSecondField(b: *u8, n: int): int {
  let i = 0
  while (i < n && *(b + i) != 32) {
    i = i + 1
  }
  i = i + 1
  let v = 0
  while (i < n && *(b + i) >= 48 && *(b + i) <= 57) {
    v = v * 10 + int(*(b + i)) - 48
    i = i + 1
  }
  return v
}

// `openat(AT_FDCWD, "/proc/thread-self/schedstat", O_RDONLY)` as `rdFd` stores
// it: the descriptor plus one, or -1 when it failed, so the next call does not
// retry.
@nosplit fn rdOpen(): int {
  let p = ptrOf(rdPath)
  *(p + 0) = 7526692981360980015
  *(p + 1) = 7810775767538820466
  *(p + 2) = 8314882311052275558
  *(p + 3) = 7627124
  let nr = sysOpenatArm64()
  if (onX64()) {
    nr = sysOpenatX64()
  }
  let fd = int(syscall(nr, i64(sysAtFdCwd()), i64(int(p)), 0, 0))
  if (fd < 0) {
    return -1
  }
  return fd + 1
}

export @nosplit @symbol("bit_rt_port_sched_thread_run_delay") fn schedThreadRunDelay(): int {
  let fdp = ptrOf(rdFd)
  if (*fdp == 0) {
    *fdp = rdOpen()
  }
  if (*fdp < 0) {
    return 0
  }
  let q = ptrOf(rdBuf)
  let n = int(syscall(sysPread64(), i64(*fdp - 1), i64(int(q)), 60, 0))
  if (n <= 0) {
    return 0
  }
  let b: *u8 = nil
  return rdSecondField(b + int(q), n)
}
