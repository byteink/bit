// The task control block, the entry points task code calls, and the park-arming
// rendezvous, split out of `sched.bit` (#1503). Sibling file, so the same
// module - nothing here changed but its home.

// ---------------------------------------------------------------------------
// Task control block
// ---------------------------------------------------------------------------
//
// Word-indexed, laid out so the saved context occupies the prefix — a switch
// takes the task's base address unchanged, with no offset arithmetic on the
// hottest path in the runtime.
//
//   0..21  saved context
//   22     state
//   23     next        intrusive run-queue link (owned by the holding queue)
//   24     arg         opaque word handed to the task body
//   25     stackBase   lowest address of the whole mapping, for teardown
//   26     stackBytes  size of that mapping
//   27     worker      the worker currently running this task (0 when not running)
//   28     regNext     intrusive all-tasks registry links, owned by the
//   29     regPrev       scheduler's registry lock — NOT the run queues' `next`,
//                        because a task is on the registry for its whole life
//                        while simultaneously moving between run queues
//   30     timerNext   intrusive sleeping-task link and its wake deadline, owned
//   31     deadline      by the scheduler's timer lock. A THIRD link distinct
//                        from both `next` and `regNext` for the same reason they
//                        are distinct from each other: a sleeping task is on the
//                        timer list, on the registry, and on no run queue, all at
//                        once. `runtime/sched/`'s `timer_next`/`deadline_ns`.
//
// 30 and 31 were already inside `taskWords`, so adding timers did NOT grow the
// block — no caller's stack arithmetic moved.
export const taskWords: int = 32

export const taskState: int = 22
export const taskNext: int = 23
export const taskArg: int = 24
export const taskStackBase: int = 25
export const taskStackBytes: int = 26
export const taskWorker: int = 27
export const taskRegNext: int = 28
export const taskRegPrev: int = 29
export const taskTimerNext: int = 30
export const taskDeadline: int = 31

// The ONE word past the standard block, present ONLY in the oversized block that
// `bit_rt_spawn` (`runtime/root/<os>`'s `rtSpawn`) maps `taskWords + 1` words
// wide. It carries the REAL compiler-emitted entry — `spawn$trampoline$<fid>`,
// which reads its captured thunk from its FIRST PARAMETER (a register) and
// RETURNS — while `schedTaskContext`'s own pc slot holds the fixed
// `schedSpawnTrampoline` below. This must equal `taskWords`: it is the first
// index beyond the 32-word block every other task allocates, so no plain task
// (mainTrampoline, workerBody, the stress bodies) ever has or touches it.
export const taskSpawnEntry: int = 32

// Task states, matching `runtime/sched/`'s `TaskState` ordinals.
export const taskRunnable: int = 0
export const taskRunning: int = 1
export const taskParked: int = 2
export const taskDone: int = 3

// TWO STATES `runtime/sched/` DOES NOT HAVE, AND THEY EXIST BECAUSE THIS PORT CANNOT
// HAVE ITS `ParkFn` HOOK. See the "arming a park" section below for the whole
// argument; in one line: a Bit task must make itself findable BEFORE it parks,
// and these two states are the rendezvous that stops a wake landing in that
// window from being dropped.
//
// A NEW PATH ON PURPOSE. `schedPark`, `schedUnpark`, the timer queue and every
// channel operation continue to move a task only between the four states above —
// nothing that works today changes behaviour, and a task that never calls
// `schedParkArm` can never be in either of these. That containment is the reason
// to spend two ordinals rather than to rework `schedUnpark`.
export const taskParking: int = 4
export const taskWakePending: int = 5

// Prepare a task control block: build its entry context and clear its links.
//
// `stackBase`/`stackBytes` describe the mapping to release at teardown; the
// usable top is their sum, which is where the context starts. The caller owns
// that mapping — this module never maps or unmaps (see the header).
export @nosplit @symbol("bit_rt_port_sched_task_init") fn schedTaskInit(task: *i64, stackBase: int, stackBytes: int,
                                       entry: *byte, arg: int) {
  schedTaskContext(task, stackBase + stackBytes, entry)
  *(task + taskState) = taskRunnable
  *(task + taskNext) = 0
  *(task + taskArg) = arg
  *(task + taskStackBase) = stackBase
  *(task + taskStackBytes) = stackBytes
  *(task + taskWorker) = 0
  *(task + taskRegNext) = 0
  *(task + taskRegPrev) = 0
  *(task + taskTimerNext) = 0
  *(task + taskDeadline) = 0

  // The self-pointer that makes `schedCurrentTask` O(1), and the tag that lets
  // it tell a task stack from any other stack — see its comment.
  *(taskAt(stackBase)) = int(task)
  *(taskAt(stackBase) + 1) = schedStackTag
}

// A task block at a raw address, as the queues hand it back.
//
// Also used for worker and scheduler blocks: all three are word-indexed blocks
// at a raw address and the conversion is the same arithmetic. Kept under one
// name rather than three aliases that would differ only in what they are called.
// PINNED (ABI.md §9): `runtime/chan` calls this across a module boundary. See
// `../gc/mem.bit` for why the pin is required and why `bit_rt_port_` is
// temporary (#1369 renames).
// `>> 3`, NOT `/ 8` (#3318). This is the runtime's universal
// integer-address-to-pointer conversion and it is inlined at well over a hundred
// call sites, so its lowering is a whole-runtime constant. A SIGNED divide by 8
// must round toward zero, which arm64 spells `asr #63` + `lsr #61` + `add` +
// `asr #3` — four instructions to bias a value that is never negative — where a
// shift is one. `addr` is a byte address of a word-aligned block in the process's
// own address space; a userspace address is non-negative on every target this
// compiler emits for, so the two agree on every value that reaches here. They
// differ only for a negative `addr`, which would be a wild pointer either way.
export @nosplit @symbol("bit_rt_port_sched_task_at") fn taskAt(addr: int): *i64 {
  let z: *i64 = nil
  return z + (addr >> 3)
}

// ---------------------------------------------------------------------------
// What task code calls
// ---------------------------------------------------------------------------

// THE THREE FUNCTIONS BELOW MAY ONLY BE CALLED FROM TASK CODE. Off a task stack
// `schedCurrentTask` returns 0, and each checks for that and traps (see
// "A task that reaches here" below) rather than dereferencing it. That is
// deliberate, and it is the honest equivalent of `runtime/sched/`'s
// `Worker.current()`, which is `tls.?` and panics for the same misuse: a
// scheduler primitive that quietly did nothing would leave the caller believing
// it had yielded or parked when it had not, which is far worse than a crash at
// the call site. `panic` is not reachable from a `@nosplit` body in any case.
//
// `schedSpawn` is the exception and is safe from any thread — see its own comment.

// A task that reaches the `taskAddr == 0` branch below has lost its own
// identity: `schedCurrentTask` returned 0 either because the caller is off any
// task stack (the misuse the header above names) or because a green thread's
// call chain recursed deep enough to overwrite the self-pointer/tag words at
// its own `stackBase` before the guard page below them ever faults (#2432) —
// a deep frame can land exactly on those two words without crossing into the
// unmapped hole, so no OS fault occurs at the point of corruption.
//
// Both cases used to fall through to `taskAt(0) + taskWorker` — a dereference
// at a fixed small offset (0xd8) that looks like a null-task bug in
// `runtime/chan` or the scheduler, three call frames removed from the actual
// cause. Trapping instead puts the crash's PC inside the primitive that
// detected the loss, so a backtrace names it rather than an anonymous low
// address a debugger has to reverse-engineer.
//
// THE TRAP IS COPIED INLINE AT EACH OF THE FOUR SITES, not factored into a
// shared function. `schedYield`/`schedPark`/`schedTaskExit`/`schedSleepUntil`
// are the hottest path in the runtime — every context switch runs one — and
// `BIT_GC=stress` (which safepoints on every loop back edge) multiplies any
// per-call cost by the safepoint count: a shared `@nosplit` callee here forced
// its caller to treat the call site as clobbering every caller-saved register
// (the standard cross-call ABI assumption `asm` inputs/results/clobbers are
// the only way to narrow), which cost tests/stress/quicwire ~20% of its
// `BIT_GC=stress` wall clock — measured (323s/1489198 collections vs
// 260s/1490990 on the unmodified runtime) before this file switched to the
// inline form. Four copies of a two-instruction trap are the cheap trade.
//
// THE TEST LIVES IN THE `asm` BLOCK RATHER THAN IN AN `if` (#2830), and the
// reason is measured, not stylistic. Written as `if (taskAddr == 0) { asm …;
// return }` the arm64 backend emitted THIRTEEN instructions on the path where
// the task IS valid — the compiler materialises the literal 0 into a register
// (`mov x9, #0`) instead of using `xzr` or a `cmp` immediate, `cset`s the
// comparison into a boolean, spills and reloads that boolean, re-tests it
// against `xzr`, and then pays two block-parameter copies across the four
// basic blocks the `if` introduces. Those are the two passes this compiler is
// missing (#1852 copy-propagation, #1853 small-constant immediates); nothing in
// this module can fix them. Folding the compare and the branch into the `asm`
// payload sidesteps both and costs TWO instructions on arm64 (`mov` into the
// pinned input, then `cbnz`) and three on x64 (`mov`, `test`, `jne`). Measured
// on the emitted objects, not estimated — see the ticket for the counts.
//
// THE BRANCH DISPLACEMENT IS HAND-ENCODED, because §11.6 has no block-local
// labels. It is the safest form of that pattern: +8 bytes / +2 bytes, skipping
// exactly the one trap instruction that follows it in the SAME payload list,
// so it depends on nothing the compiler decides around the block (§11.6
// guarantees a payload is emitted contiguously and unmodified). Both encodings
// were verified against a disassembler — `cbnz x9, <next+4>` and
// `jne <next+2>` — rather than reasoned about. Contrast `schedSwitch`'s
// `adr x2, +184`, which spans a 46-word payload and is the fragile case
// `tests/stress/sched`'s header warns about.
//
// THE TRAP NOW FALLS THROUGH INTO THE BODY INSTEAD OF RETURNING, and that is
// equivalent because the trap is not survivable (see the paragraph below): the
// instruction after it is unreachable, exactly as the `return` it replaces
// was. The one case that can observe the difference is a DEBUGGER stepping
// past the trap by hand, which then reaches the same `taskAt(0) + taskWorker`
// dereference this guard was added to replace — the pre-#2432 behaviour, i.e.
// still a crash, not a silent non-yield. The diagnostic deliverable is
// unchanged: the crash PC is inside the primitive that detected the loss, and
// #2946's `trapHandler` attributes it by the FAULTING STACK POINTER
// (`classifyOverflowTrap`, `runtime/root/{darwin,linux}/signal.bit`), never by
// the trap's PC or by the instructions around it — this rewrite leaves the
// frame size of all four functions unchanged, so the attribution it feeds is
// unchanged too.
//
// `@nosplit`-legal because it is two instructions of inline `asm`: no
// allocation, no safepoint poll, no extern call, no syscall. Its `input`
// expression is a plain local, so it stays inside the `@nosplit` allowlist.
// `runtime/sched` may import neither platform's `rootExit`/`print` —
// `runtime/root` imports `runtime/sched`, not the reverse — so a trap
// instruction is the only diagnosable failure this module can raise
// unassisted; `panic` is unreachable from `@nosplit` for the same reason (see
// the header above). NEVER RETURNS, and since #2946 that is stronger than the
// default disposition this comment used to cite: `installFatalSignalHandlers`
// registers `trapHandler` for SIGTRAP/SIGILL on both platforms, and every one
// of its three arms ends in `rootExit(2)`. (The older claim here — that the
// runtime "installs no handler for either" and masks only `SIGPIPE` — went
// stale when #2946 landed.)

// Give the CPU back to this task's worker, staying runnable. `runtime/sched/`'s
// `yield`. Returns when some worker — NOT NECESSARILY THE SAME ONE — resumes it.
export @nosplit @symbol("bit_rt_port_sched_yield") fn schedYield() {
  let taskAddr = schedCurrentTask()
  asm volatile {
    arm64 {
      0xB5000049,                 // cbnz x9, +8 -> skip the trap: a task owns this stack
      0xD4200000                  // brk #0      -> SIGTRAP / EXC_BREAKPOINT
    }
    x64 {
      0x48, 0x85, 0xC9,           // test rcx, rcx
      0x75, 0x02,                 // jne +2      -> skip the trap
      0x0F, 0x0B                  // ud2         -> SIGILL / EXC_BAD_INSTRUCTION
    }
    input arm64 x9 x64 rcx = taskAddr
  }
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  *(w + wkDisposition) = taskRunnable
  schedSwitch(t, w + wkCtx)
}

// #2577 -- THE SAFEPOINT CHECK ITSELF, called from the live safepoint entry.
//
// `runtime/stw/stwpoll.bit`'s `stwSafepoint` calls this, unconditionally,
// once `stwPoll` has fully finished its own stop-the-world duties for this
// call (registration, park-if-stopping, collect-if-due) -- see that
// function's own comment for why the ordering is load-bearing. This function
// is what actually reports and acts on a pending preempt request (`maybePreempt`,
// `preempt.bit`, same module); `stwPoll` never sees it, and this file's own
// `schedYield` just above is the unmodified yield it takes.
//
// PINNED (SPEC §11.9, ABI.md §9): the caller is a different module
// (`runtime/stw`), so this needs a stable cross-module name rather than the
// mangled `m<N>$...` a same-module call would use.
//
// A NO-OP OFF-TASK: the worker's own idle/run loop and the boot thread reach
// this exact safepoint too (`workerrun.bit`'s header -- that loop lost its
// `@nosplit` and now safepoints on its own back edge), and neither has a task
// to hand back to the scheduler. `schedYield` above traps (SIGTRAP/SIGILL) if
// called with no task on the stack, so the `w != 0` guard below is not an
// optimisation, it is what keeps this a correctness no-op there.
// `schedCurrentWorker()`'s return is safe to test against 0 directly for
// that: it is the WORKER BLOCK's address (this file's own `taskWorker` field,
// which every caller here -- `schedYield` above, `schedPark` below,
// `runtime/root/<os>/time.bit`'s `timeScratch` -- re-wraps with `taskAt`
// before indexing a worker field off it), never a small index, and no real
// worker block is ever mapped at address 0.
//
// `maybePreempt` indexes a fixed `[32]i64` by the small `wkId` (`worker.bit`),
// NOT by that address -- mixing the two up (passing the raw worker address
// straight to `maybePreempt`) turned a legitimate address into an array index
// and walked `requested[]` tens of gigabytes past its own storage on the very
// first build this ran (`EXC_BAD_ACCESS` inside `maybePreempt`, caught by
// mutation-testing this change against a reverted tree before trusting the
// build). `taskAt(w) + wkId` recovers the same small index `workerrun.bit`
// already stamps at dispatch (`preemptStamp(*(w + wkId), monoNs())`).
//
// COST ON THE FAST PATH: more than a load and a branch.
// `schedCurrentWorker()` is `schedCurrentTask()` (`readSp` + a mask + a
// direct-indexed table lookup, `schedTaskOnStack` -- O(1), not a scan, but
// not free) plus one more load, and this adds a THIRD load for `wkId` and
// `maybePreempt`'s own atomic load and branch. It is paid only when
// `stwPoll` was already going to run a real poll (a back edge under
// `BIT_GC=stress`, or one where the compiler's inlined poll guard already
// fired), never on the far hotter back edges that guard skips entirely -- so
// it adds to an already-heavier call, not to the true hot path.
export @nosplit @symbol("bit_rt_port_sched_maybe_yield_for_preempt") fn schedMaybeYieldForPreempt() {
  let w = schedCurrentWorker()
  if (w != 0) {
    let workerId = *(taskAt(w) + wkId)
    if (maybePreempt(workerId)) {
      schedYield()
    }
  }
}

// Stop running and do NOT requeue. `runtime/sched/`'s `park`, minus the `ParkFn`
// hook: registering the parked task with its waker is a call through a function
// value, which `@nosplit` rejects (E0075). The caller must therefore make itself
// findable BEFORE parking, which reintroduces the race `runtime/sched/`'s hook exists
// to close — so the safe pattern here is that the unparker discovers the task by
// polling `taskState` for `taskParked`, which is only stored after the context
// is saved. That is what tests/stress/schedpool does, and it is the seam a
// channel implementation (#1365) will need closed properly.
export @nosplit @symbol("bit_rt_port_sched_park") fn schedPark() {
  let taskAddr = schedCurrentTask()
  asm volatile {
    arm64 {
      0xB5000049,                 // cbnz x9, +8 -> skip the trap: a task owns this stack
      0xD4200000                  // brk #0      -> SIGTRAP / EXC_BREAKPOINT
    }
    x64 {
      0x48, 0x85, 0xC9,           // test rcx, rcx
      0x75, 0x02,                 // jne +2      -> skip the trap
      0x0F, 0x0B                  // ud2         -> SIGILL / EXC_BAD_INSTRUCTION
    }
    input arm64 x9 x64 rcx = taskAddr
  }
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  *(w + wkDisposition) = taskParked
  schedSwitch(t, w + wkCtx)
}

// ---------------------------------------------------------------------------
// Arming a park: the rendezvous that replaces `runtime/sched/`'s `ParkFn`
// ---------------------------------------------------------------------------
//
// THE PROBLEM, EXACTLY. `runtime/sched/` hands `park` a `ParkFn` that runs on the
// WORKER's side of the switch — after the context is saved and after the state
// is published as `.parked` — and registers the fd from there. That hook is a
// call through a function value, which `@nosplit` rejects (E0075), so it cannot
// be transcribed. A Bit task must therefore make itself findable BEFORE it
// parks, and a wake that lands in the window between "registered" and "parked"
// finds the task still `taskRunning`, fails `schedUnpark`'s compare-exchange,
// and IS DROPPED.
//
// WHY TIMERS SURVIVE THAT AND A POLLER CANNOT. A dropped timer wake is retried:
// the deadline is still on the timer list, so the next `schedTimerExpire` finds
// the task again. A netpoller registration is ONE-SHOT (EPOLLONESHOT/EV_ONESHOT
// — see the two `poll.bit` providers), so the drain that failed to deliver has
// already consumed the readiness edge. Nothing will ever report that fd again,
// and the task is parked forever. That is the QUIC-teardown shape recorded in
// [[bit-quic-suite-hang]], reached by a much shorter path.
//
// THE PROTOCOL. `taskState` itself is the rendezvous, and both sides drive it
// with a compare-exchange, so exactly one of them wins and the loser is told:
//
//   task:   taskRunning --schedParkArm-->      taskParking
//   waker:  taskParking --schedPollUnpark-->   taskWakePending   (wake owed)
//   worker: taskParking --schedWorkerRun-->    taskParked        (park published)
//
// If the worker's transition lands first the waker finds a properly parked task
// and takes the ordinary `taskParked -> taskRunnable` path. If the waker's lands
// first the worker's compare-exchange fails, it sees `taskWakePending`, and it
// DELIVERS the owed wake by requeueing instead of parking. There is no
// interleaving in which both fail, because both are compare-exchanges against
// the same word and one of them must observe `taskParking`.
//
// Bounded and lock-free by construction: every operation below is a fixed number
// of compare-exchanges with no retry loop (Power of 10).

// Announce that this task is about to register itself somewhere and then park.
// Returns false if the task was not `taskRunning`, which means the caller is not
// a running task and has no business arming.
//
// MUST be followed by either `schedPark` or `schedParkDisarm` on every path. A
// task left in `taskParking` that never parks is invisible to `schedUnpark` —
// which is precisely why `schedParkDisarm` exists rather than being optional.
export @nosplit @symbol("bit_rt_port_sched_park_arm") fn schedParkArm(): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  return atomicCmpxchg(t + taskState, taskRunning, taskParking)
}

// Undo an arm without parking — the path a caller takes when the registration
// it armed for FAILED and so nothing will ever wake it.
//
// Returns true when a wake had already been handed over, i.e. the waker won the
// race while the caller was still registering. That wake is CONSUMED HERE: the
// caller is running, so the wake's only meaning ("do not park") is already
// satisfied, and requeueing an already-running task would put it on a run queue
// twice. A caller that ignores the answer is still correct; it is returned
// because a poller consumer wants to know its registration raced.
export @nosplit @symbol("bit_rt_port_sched_park_disarm") fn schedParkDisarm(): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  if (atomicCmpxchg(t + taskState, taskParking, taskRunning)) {
    return false
  }
  // The only other state an armed task can be in is `taskWakePending`, and the
  // waker that set it is done with the task. A plain store is therefore safe.
  atomicStore(t + taskState, taskRunning)
  return true
}

// Wake a task that may be anywhere in the arm/park protocol. THE POLLER'S
// UNPARK — `pollDrain` calls this where it used to call `schedUnpark`, and the
// difference is only what happens to a task caught mid-park.
//
// Returns true when the wake was delivered or handed over, false when the task
// was in none of the three states a wake can be given to (already runnable,
// running, or done) and the caller should drop it exactly as `schedUnpark` does.
//
// STEP 3 IS NOT REDUNDANT WITH STEP 1, and this is the one claim here that a
// single-core test cannot demonstrate. Between step 1 observing `taskParking`
// and step 2 running, the task's worker may publish `taskParked` — so step 2's
// compare-exchange fails too, and without step 3 a genuinely parked task would
// be left parked with its one-shot edge consumed. It needs two cores to
// interleave that way, so it is kept on the argument rather than on a test, and
// this comment is that argument.
//
// STEPS 1 AND 3 ARE TWO EQUIVALENT MUTANTS, AND THAT WAS MEASURED RATHER THAN
// ASSUMED. Deleting step 1 alone SURVIVES every program in this suite, and so
// does deleting step 3 alone — they are the same transition at two points, so
// each masks the other's removal. Deleting BOTH is caught, by
// ../../tests/stress/schedpoll{darwin,linux}: `woke true -> false`. So the pair
// is guarded, the individual lines are not, and neither may be deleted on the
// strength of a green run. ../../tests/stress/netpark cannot see either one: its
// task is always caught mid-park, so only step 2 ever fires there.
export @nosplit @symbol("bit_rt_port_sched_poll_unpark") fn schedPollUnpark(s: *i64, task: int): bool {
  let t = taskAt(task)
  // 1. Already parked: the ordinary transition, identical to `schedUnpark`.
  if (atomicCmpxchg(t + taskState, taskParked, taskRunnable)) {
    gqPush(s + scGlobal, task)
    schedWakeIdle(s)
    return true
  }
  // 2. Caught mid-park: hand the wake to the worker, which owes its delivery.
  if (atomicCmpxchg(t + taskState, taskParking, taskWakePending)) {
    return true
  }
  // 3. It finished parking between 1 and 2. Retry the parked transition.
  if (atomicCmpxchg(t + taskState, taskParked, taskRunnable)) {
    gqPush(s + scGlobal, task)
    schedWakeIdle(s)
    return true
  }
  return false
}

// Leave for good. Never returns — the worker sees `taskDone` and never queues
// this task again.
//
// MAIN'S OWN EXIT SIGNALS SHUTDOWN SYNCHRONOUSLY, HERE (#2530). `main` is the
// one task registered through `schedRegisterBigStack` rather than the normal
// masked-stack path (see `../sched.bit`'s "oversized stacks" section), so
// `schedTaskOnBigStack` names it unambiguously — nothing else in this runtime
// registers through that table today. Without this, the only thing that calls
// `schedShutdown` is `runtime/root`'s boot thread, ASYNCHRONOUSLY, after it
// notices `mainDone` on its own poll-and-sleep loop (starting at a 1us
// backoff) — a real, if usually short, window in which `main`'s own worker has
// already unregistered `main` and gone back to `schedFindWorkAt` with
// `scStopping` still 0. A program that returns from `main` while a spawned
// task remains alive but permanently parked (an ordinary, legitimate
// fire-and-forget pattern — the spawned task is simply abandoned when `main`
// returns, exactly as an unwaited Go goroutine is) would hit that window on
// the very next loop iteration, deterministically rather than rarely, since
// nothing paces the worker against the sleeping boot thread. Setting
// `scStopping` here, before this task's own `schedSwitch`, closes the window
// instead of narrowing it: by the time this worker (or any other) next reaches
// `schedFindWorkAt`, `scStopping` is already set, and `schedFindWorkAt`'s own
// deadlock check (`../worker.bit`) reads it first and stands down. Calling
// `schedShutdown` twice (boot's step 8 still runs it) is idempotent — a second
// `atomicStore` of the same value and a second wake pass over already-awake
// workers, not a correctness issue.
export @nosplit @symbol("bit_rt_port_sched_task_exit") fn schedTaskExit() {
  let taskAddr = schedCurrentTask()
  asm volatile {
    arm64 {
      0xB5000049,                 // cbnz x9, +8 -> skip the trap: a task owns this stack
      0xD4200000                  // brk #0      -> SIGTRAP / EXC_BREAKPOINT
    }
    x64 {
      0x48, 0x85, 0xC9,           // test rcx, rcx
      0x75, 0x02,                 // jne +2      -> skip the trap
      0x0F, 0x0B                  // ud2         -> SIGILL / EXC_BAD_INSTRUCTION
    }
    input arm64 x9 x64 rcx = taskAddr
  }
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  if (schedTaskOnBigStack(readSp()) != 0) {
    schedShutdown(taskAt(*(w + wkSched)))
  }
  *(w + wkDisposition) = taskDone
  schedSwitch(t, w + wkCtx)
}

// ---------------------------------------------------------------------------
// The fixed green-task trampoline for a COMPILER-EMITTED spawn (#1622)
// ---------------------------------------------------------------------------
//
// THE SEAM THIS CLOSES. Every other task entry in this runtime is a bare
// function reached by a direct branch: it takes no argument, recovers its work
// from scheduler state, and leaves through `schedTaskExit` (mainTrampoline,
// workerBody, the stress bodies). But codegen lowers the `spawn` keyword to
// `bit_rt_spawn(spawn$trampoline$<fid>, thunk)` where `spawn$trampoline$<fid>`
// is an ORDINARY function: it expects the thunk in its FIRST-ARGUMENT REGISTER
// (x0 / rdi) and it RETURNS. Branch straight to it and it reads a garbage
// capture from an undefined register, then returns through a link register left
// 0 — a silently miscompiled spawn (the #1622 mismatch). `runtime/root/`'s live
// `bit_rt_spawn` never had the bug because `runtime/sched/`'s fixed `trampoline` does
// `t.fn_ptr(t.arg)` — a real call, arg in the register. This is that trampoline,
// so the Bit scheduler honours the identical contract post-#1369.
//
// `rtSpawn` stashes the real entry at `taskSpawnEntry` and sets the task's pc to
// this function; on entry it recovers both from the task block and hands them to
// `taskInvoke`, which performs the register-passing call. When that call returns
// (a compiler trampoline always returns) it leaves through `schedTaskExit`,
// exactly as `runtime/sched/`'s trampoline does the done-switch after `fn_ptr`.
export @symbol("bit_rt_port_sched_spawn_trampoline") fn schedSpawnTrampoline() {
  let t = taskAt(schedCurrentTask())
  let entry = *(t + taskSpawnEntry)
  let arg = *(t + taskArg)
  taskInvoke(entry, arg)
  schedTaskExit()
}

// Call the raw code address `entry` with `arg` in the first-argument register
// (x0 / rdi) and return normally. The one operation the language cannot spell:
// `entry` is a bare code pointer (`entryOf` / a `FuncAddr`), not a `(code, env)`
// function value, so no `call_value` reaches it. `blr`/`call` — not a tail
// branch — because the callee returns here and the trampoline above must run on
// after it. The prologue always saves the link register (arm64) / return address
// (x64), so `blr`/`call` clobbering it is recovered by the epilogue; `x64`'s
// `call rax` is 16-byte aligned because every prologue leaves rsp so. Mirrors
// `runtime/sched/`'s `t.fn_ptr(t.arg)`, and the child-side shuffle in
// `runtime/thread/<os>`'s `cloneChild` (`mov x0,x6 ; blr x5`).
@nosplit fn taskInvoke(entry: int, arg: int) {
  asm {
    arm64 { 0xD63F0120 }        // blr x9
    x64   { 0xFF, 0xD0 }        // call rax
    input arm64 x9 x64 rax = entry
    input arm64 x0 x64 rdi = arg
    clobber arm64 { x30, memory }
    clobber x64 { memory }
  }
}
