// The channel-timer producer's wake of worker 0 and its audit (#6418), split
// from `timer.bit` (at its 800-line ceiling) as a sibling, so the same module:
// nothing here changed meaning, only home. `chanTimerWakePoller` moved from
// `timer.bit` verbatim in behaviour; `chanTimerWake` is new.

// The scheduler of the CALLING TASK (`taskWorker` -> `wkSched`, the chain
// `schedSleepUntil` uses), or 0 when no task is running: a channel timer armed
// from a thread that is not a green task has no worker to wake.
@nosplit fn chanTimerSchedAddr(): int {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return 0
  }
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  return *(w + wkSched)
}

// Wakes worker 0 if it is parked in `pollDrain` (#5845). Call AFTER
// `spinRelease(chanTimerLockAddr())`, never while holding it —
// `schedWakePoller` can reach the poll provider's wake syscall, which has no
// business running under this pool's lock. `s` is the calling task's scheduler
// (`chanTimerSchedAddr`).
@nosplit fn chanTimerWakePoller(s: *i64) {
  schedWakePoller(s)
}

// What `rtSchedTimerChanArm` and `schedTimerChanReset` call after releasing the
// pool lock: the wake, bracketed by the missed-wake audit (`schedWakeAuditBegin`,
// `./sleep.bit`). The audit sits HERE and not inside `chanTimerWakePoller` so
// that a wake which is removed or skipped is still caught: the audit's whole
// job is to notice a wake that did not happen, and it cannot live in the code
// that did not run.
@nosplit fn chanTimerWake() {
  let sa = chanTimerSchedAddr()
  if (sa == 0) {
    return
  }
  let s = taskAt(sa)
  let armed = schedWakeAuditBegin(s)
  chanTimerWakePoller(s)
  schedWakeAuditEnd(s, armed)
}
