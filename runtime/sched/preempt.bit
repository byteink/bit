// Preemption state for the M:N scheduler (#1768's remaining half): a green
// thread that never reaches a safepoint runs until it finishes and starves
// every other task on its worker. This file holds the STATE and the PURE
// LOGIC a safepoint check and a monitor thread need to fix that -- nothing
// here is called yet.
//
// WHY NOTHING CALLS THIS YET, ON PURPOSE (#1768's remaining children):
//   #2577 calls `maybePreempt` at the scheduler's existing safepoint check.
//   #2578 calls `preemptStamp` on task dispatch.
//   #2579 / #2580 boot the sysmon OS thread (darwin / linux) that drives
//     `sysmonTick` off a real clock.
// This ticket does none of that -- splitting it out this way means the clock
// source, the safepoint wiring and the dispatch wiring can each be reviewed
// and landed against a state module that is already fixed.
//
// NO OS CALLS HERE, AND SINCE #4736 NO CLOCK AT ALL. The budget is counted in
// SYSMON TICKS rather than nanoseconds: `sysmonTick` bumps this file's own
// `sysmonEpoch` counter once per call, and every stamp records that counter's
// value, so neither the dispatch path nor the monitor thread reads a clock to
// keep preemption working. #2578 stamped `monoNs()` at every dispatch, which
// on Linux is a raw `clock_gettime` trap (`../park/linux/wait.bit`, no vDSO)
// and cost +147 ns on every context switch -- 285 -> 423 ns/switch on the
// arm64-linux `test-schedbench` gate (#4736). A single atomic load of a word
// this file owns replaces it. `sysmonTick` still takes no clock reading as a
// parameter either, so this file makes no kernel trap and declares nothing
// foreign.
//
// Base-pointer arithmetic and deref rather than `startTick[worker]`: indexing
// is forbidden in a `@nosplit` body (E0075 -- see `queue.bit`'s comment on
// the same trade), and every function here is `@nosplit` so a `@nosplit`
// safepoint check can call `maybePreempt` directly once #2577 wires it in --
// a `@nosplit` body may only call other `@nosplit` functions.

// A task that has held its worker longer than this many nanoseconds gets a
// preempt request the next time `sysmonTick` runs. 10ms.
export const preemptBudgetNs: i64 = 10000000

// The monitor thread's sleep between two `sysmonTick` calls, and therefore the
// unit the budget above is actually enforced in. BOTH monitor threads
// (`../root/linux/sysmon.bit`, `../root/darwin/boot.bit`) import this constant
// and sleep exactly this long, rather than each repeating the literal they
// used to: `preemptBudgetTicks` below is only meaningful if the period the
// ticks really arrive at is the period it was derived from.
export const sysmonPeriodNs: i64 = 2000000

// `preemptBudgetNs` expressed in sysmon ticks -- the over-budget test's actual
// threshold -- with one tick added for the granularity of the tick itself.
// A worker stamped while the epoch reads `e` is first seen at age `k` by the
// tick that raises the epoch to `e + k`, and that FIRST tick can land
// arbitrarily soon after the dispatch, so `k` ticks prove only
// `(k - 1) * sysmonPeriodNs` of elapsed real time. Requiring
// `preemptBudgetNs / sysmonPeriodNs + 1` is what preserves the promise
// #2578's `nowNs - started > preemptBudgetNs` made: a worker is never flagged
// before it has genuinely held its task for `preemptBudgetNs`. 6 ticks at
// 2ms = flagged between 10ms and 12ms after dispatch, the same window the
// nanosecond comparison produced.
export const preemptBudgetTicks: i64 = preemptBudgetNs / sysmonPeriodNs + 1

// This file's own array capacity -- the number this file actually trusts for
// its own scan bound. MUST equal the literal length of `startTick`/`requested`
// below, and cannot instead size those arrays directly (`let a: [N]i64`
// requires `N` to be a literal, not a name -- E0021, the same constraint
// `runtime/root/root.bit`'s `gcState`/`heapBlock` document for `gcWords` and
// `heapWords`).
//
// Deliberately a SEPARATE constant from `sleep.bit`'s `schedMaxWorkers`
// rather than reusing it, even though both are 32 today. `schedMaxWorkers` is
// ADVISORY from this file's point of view: it says how many workers the
// scheduler currently intends to run, not how many slots these arrays
// actually have. If `schedMaxWorkers` is ever raised without these arrays
// (and this constant) growing to match, `sysmonTick`'s loop below is bounded
// by BOTH -- the same double-bound shape `sleep.bit`'s own `schedWakeIdle`
// already uses to guard the identical class of drift between a live count
// and a fixed array -- so it clamps to `preemptSlots` and simply stops
// covering the extra workers rather than reading or writing past the arrays.
// A missed preempt request on the un-covered workers, not a corrupted one:
// every access here is raw `ptrOf(base) + worker` deref inside `@nosplit`
// with no bounds check, so a loop bound that could ever exceed the arrays'
// real size is the actual hazard, and this is what closes it.
const preemptSlots: int = 32

// `startTick[w]` is the sysmon-tick epoch (`preemptTickNow`) `preemptStamp`
// last recorded for worker `w`, or 0 if `w` has no task in flight -- either it
// was never stamped, or a later clear zeroed it. `preemptTickNow` never
// returns 0, so 0 keeps that meaning unambiguously even for a worker
// dispatched before the monitor thread's very first tick. `requested[w]` is
// nonzero once `sysmonTick` has observed `w` over budget, and stays set until
// `maybePreempt` clears it. Fixed globals; nothing here is allocated at run
// time.
let startTick: [32]i64
let requested: [32]i64

// The tick epoch: how many `sysmonTick` calls have completed their increment.
// This is the ONLY clock preemption has (#4736). `sysmonTick` is its only
// writer and there is exactly one monitor thread per process, so the
// load-add-store below needs no CAS -- and even a lost update (a second caller
// driving `sysmonTick` by hand, which `_tests_/bit/pollguardpreempt.bit` does)
// can only leave the counter LOWER, i.e. make every age look smaller, which
// delays a preempt request by a tick and can never publish one early.
//
// A `[1]i64` rather than a bare `let epoch: i64` for the reason every other
// global here is an array: `ptrOf` is how a `@nosplit` body addresses module
// state without indexing (E0075).
let sysmonEpoch: [1]i64

// #3746: the SUMMARY of `requested` -- nonzero while any slot may be set, 0
// only when a scan has just observed every slot clear. It exists so the
// compiler-inlined back-edge poll guard can answer "is any preempt pending
// anywhere" with ONE atomic load and no call at all, and reach the two real
// calls (`schedCurrentWorker`, `preemptRequested`) only when the answer is
// yes. #3564 put those two calls on the FAST path of every loop back edge and
// that cost 3.28x on bench/cases/collatz and 2.36x on matrix; the clause
// itself is correct and stays -- this word is what gets it off the fast path.
//
// THE ONLY INVARIANT THIS WORD OWES, and the guard's correctness rests on
// exactly this one: `requested[w] != 0` for any `w` IMPLIES this word is
// nonzero. A false POSITIVE is free (one guard evaluation takes the slow path
// and finds nothing); a false NEGATIVE would drop a preempt request. Which is
// why the two sides are ordered the way they are:
//   - the SETTER (`sysmonTick`, the only writer of `requested` and the only
//     one, single-threaded on its own OS thread) publishes the flag FIRST and
//     this word SECOND;
//   - the CLEARER (`refreshPreemptAny`) writes 0 FIRST and re-scans AFTER.
// A final 0 therefore always comes from a clearer whose scan ran strictly
// after its own 0-store, hence strictly after any setter's write of 1 to this
// word, hence strictly after that setter's earlier write of the flag -- so
// that scan saw the flag and wrote 1 back. There is no interleaving that
// leaves a set flag with a zero summary. `atomicStore` is a release store
// (`stlr` on arm64, an ordered plain store under x86-64 TSO), so the two
// stores in each pair cannot be reordered with each other.
//
// THE SCAN COVERS EVERY SLOT, AND THAT IS LOAD-BEARING, NOT DEFENSIVE. The
// obvious saving -- a clearer knows which worker it just cleared, so why look
// at the other 31 -- is exactly what opens the window: `sysmonTick` can be
// mid-publish for a DIFFERENT worker x while this clearer zeroes the summary,
// and only a scan that reads slot x can put the 1 back. Proof, for a final
// summary of 0: the last write to it must be some clearer's 0-store (a setter
// and a re-scan both write 1), and both orderings die -- if the setter's
// 1-store came first, this clearer's scan runs after it and therefore after
// the flag store, so it sees the flag and writes 1 after; if it came second,
// it is itself the later write. Neither leaves a set flag under a 0 summary.
//
// IT DEPENDS ON TWO CODEGEN FACTS, both currently true and both worth naming
// because "optimising" either one silently reopens the window. The clearer
// needs STORE->LOAD ordering between its 0-store and its scan, which is the
// one ordering neither TSO nor plain release/acquire gives for free:
//   - arm64 emits `ldar` for atomicLoad and `stlr` for atomicStore
//     (compiler/arm64selectmem.bit). That pair is RCsc -- an `ldar` may NOT be
//     hoisted above an `stlr`. Weakening the load to `ldapr` (RCpc), which is
//     otherwise a fair optimisation, breaks this and nothing would catch it.
//   - x86-64 emits a plain `mov` PLUS `mfence` for atomicStore
//     (compiler/x64selectmem.bit's own "a seq-cst store needs a trailing full
//     barrier on x86"). Under TSO a bare store is already a release, so that
//     `mfence` looks redundant and is not -- without it this clearer's scan
//     loads can complete while the 0-store sits in the store buffer, and the
//     0 can drain AFTER a setter's 1. That comment now guards this invariant
//     too, not only whatever motivated it.
//
// A [1]i64 rather than a bare `let any: i64` for the same reason every other
// global here is an array: `ptrOf` is how a `@nosplit` body addresses module
// state without indexing (E0075).
let anyRequested: [1]i64

// `worker` must be `< preemptSlots` -- callers get that for free today
// because the scheduler never hands out a worker id past `schedMaxWorkers`
// (`sleep.bit`), which is in turn never above `preemptSlots` (see the
// constant's own comment for what protects that). Not exported: used only
// within this file, the same shape as `sleep.bit`'s own `workerParkAddr`.
@nosplit fn slotAddr(base: *i64, worker: i64): *i64 {
  return base + worker
}

// The value a dispatch stamps, and the value `sysmonTick` measures ages
// against: one past the number of completed ticks, so it is >= 1 always and 0
// keeps its meaning of "no task in flight" (`startTick`'s own comment).
//
// BOTH SIDES OF THE OVER-BUDGET SUBTRACTION GO THROUGH THIS ONE FUNCTION, and
// that is what makes the subtraction meaningful. The hazard both monitor
// threads' headers warn about -- a stamp taken on one clock compared against a
// reading of another, silently subtracting two unrelated epochs -- cannot be
// expressed once there is exactly one epoch and exactly one accessor for it.
//
// One atomic load and an add. That is the entire cost that replaced the
// `clock_gettime` trap #2578 put on every task dispatch (#4736).
export @nosplit fn preemptTickNow(): i64 {
  return atomicLoad(slotAddr(ptrOf(sysmonEpoch), 0)) + 1
}

// Recompute `anyRequested` after a clear. Writes 0 FIRST, then re-scans -- see
// `anyRequested`'s own header for why that order and not the obvious
// scan-then-store-if-empty, which loses a request to a setter that lands
// mid-scan. Bounded by `preemptSlots`, this file's own array capacity, exactly
// like `sysmonTick`'s scan (Power of 10: a compile-time constant limit).
//
// Called only from the two CLEARING paths and only when they really cleared
// something, so its cost lands on a preempt actually being consumed (once per
// ~10ms budget per worker), never on a back edge.
@nosplit fn refreshPreemptAny() {
  atomicStore(slotAddr(ptrOf(anyRequested), 0), 0)
  let w: i64 = 0
  while (w < preemptSlots) {
    if (atomicLoad(slotAddr(ptrOf(requested), w)) != 0) {
      atomicStore(slotAddr(ptrOf(anyRequested), 0), 1)
      return
    }
    w = w + 1
  }
}

// The address of `anyRequested`, for the one caller that needs it and cannot
// reach it any other way: BOTH backends' inlined back-edge poll guard
// (`compiler/arm64call.bit`'s emitInlinedPreemptCheck,
// `compiler/x64controlflow.bit`'s xEmitPreemptClause) caches it once per
// function entry, in the same poll-address cache `bit_rt_world_addr`
// and `bit_rt_gc_addr` already fill, and then reads the word directly on every
// back edge. Module state cannot be pinned across the compiler/runtime object
// boundary -- only a FUNCTION can (SPEC 11.9) -- so an accessor is the only
// spelling available, exactly as `rootGcAddr`/`rootWorldAddr` are for theirs.
//
// A true leaf: no allocation, no park, no safepoint, and the address is a
// per-process constant for the whole life of the program, which is what makes
// caching it at function entry sound.
export @nosplit @symbol("bit_rt_port_sched_preempt_any_addr") fn preemptAnyAddr(): int {
  return int(ptrOf(anyRequested))
}

// Record that `worker` just picked up a new task at sysmon tick `startedTick`
// (`preemptTickNow`), and drop any preempt request left over from whatever ran
// on `worker` before it -- a freshly dispatched task must not inherit a stale
// flag from its predecessor.
//
// The tick is still a PARAMETER, not read here, for the reason this file's
// header gives: keeping the reading out of the state module is what lets
// `_tests_/bit/pollguardpreempt.bit` backdate one worker deterministically
// instead of waiting out a real budget.
export @nosplit fn preemptStamp(worker: i64, startedTick: i64) {
  atomicStore(slotAddr(ptrOf(startTick), worker), startedTick)
  // The clear stays UNCONDITIONAL -- reading first and skipping the store when
  // the slot is already 0 would let a request `sysmonTick` sets between the
  // read and the store survive into the freshly dispatched task, which is the
  // one thing this function exists to prevent. Only the `anyRequested` refresh
  // (#3746) is conditional, and only on the value observed BEFORE the store:
  // if nothing was set, this call cleared nothing and the summary is still
  // correct; if the race above happens, the summary is merely left reading 1
  // with nothing pending, which the invariant explicitly permits.
  let had = atomicLoad(slotAddr(ptrOf(requested), worker))
  atomicStore(slotAddr(ptrOf(requested), worker), 0)
  if (had != 0) {
    refreshPreemptAny()
  }
}

// Record that `worker` no longer has a task in flight: `schedSwitch` just
// returned control to the run loop (`workerrun.bit`'s `schedWorkerStep`,
// right where it clears `wkRunning` -- see that field's own comment,
// `worker.bit:23`, "0 between tasks", which names exactly the transition
// this call marks), whether the task parked, finished, or is merely being
// requeued for a later turn. Mirrors `preemptStamp`'s unconditional clear of
// `requested` for the identical reason: `startTick` going back to 0 is the
// value `sysmonTick`'s own comment below already promises means "no task is
// currently dispatched on that worker", and before this call existed
// NOTHING made that true for a worker that goes idle, parks a task, or
// blocks rather than being redispatched -- `preemptStamp` runs only at
// dispatch, so a worker with no next dispatch kept its last stamp forever
// and `sysmonTick` flagged it as perpetually over budget, which
// (`stwpoll.bit`'s widened clause, #4203) then held EVERY thread's back
// edge on the safepoint slow path forever too. #4278.
//
// Safe to clear unconditionally: this runs strictly after `schedSwitch` has
// returned, so the task that was running is not executing on the CPU right
// now by construction -- there is nothing left for the CPU half of a
// preempt request to interrupt. A worker immediately redispatched (the
// `taskRunnable` requeue case) simply gets a fresh, correct stamp from the
// very next `preemptStamp` call; a momentary 0 in between is exactly true
// for that instant.
export @nosplit fn preemptClear(worker: i64) {
  atomicStore(slotAddr(ptrOf(startTick), worker), 0)
  let had = atomicLoad(slotAddr(ptrOf(requested), worker))
  atomicStore(slotAddr(ptrOf(requested), worker), 0)
  if (had != 0) {
    refreshPreemptAny()
  }
}

// Advance the tick epoch by one, then scan every worker slot and flag any that
// has held its task for `preemptBudgetTicks` ticks or more (#4736: the epoch
// IS the clock -- this function takes no time reading and makes no OS call, so
// the monitor thread's whole tick is a load, a store and this scan).
// Bounded by `schedMaxWorkers` AND `preemptSlots` --
// `preemptSlots` is the one that actually matters for safety here: it is
// this file's own array capacity, so the scan can never run past
// `startTick`/`requested` even if `schedMaxWorkers` (advisory only from this
// file's point of view; see `preemptSlots`'s comment) drifts ahead of it.
// Both are compile-time constants, so the loop's limit is provable from its
// own body (Power of 10) regardless of either changing independently.
//
// A slot at 0 is skipped rather than read as "dispatched at tick zero" --
// `preemptStamp` is the only writer of a nonzero value (and `preemptTickNow`
// never yields 0), so 0 means no task is currently dispatched on that worker.
//
// Returns the number of workers that met the over-budget condition this
// call, whether or not their flag was already set from an earlier tick.
//
// `@symbol` PINNED (#2579): both darwin's and linux's `boot.bit` build
// `--freestanding` (#1628) and therefore build no function VALUE — every
// cross-module callee they name must be `@symbol`-pinned, exactly like every
// other `runtime/sched` function either platform's boot already calls
// (`schedInit`, `schedFindWork`, `schedTaskExit`, ...; see e.g.
// `worker.bit`'s `bit_rt_port_sched_init`). NOTHING called `sysmonTick`
// across that boundary before #2579/#2580, so nothing forced this pin until
// now; the name matches the `bit_rt_port_sched_*` convention those siblings
// use. Purely an ABI/linkage annotation — no change to the logic below.
export @nosplit @symbol("bit_rt_port_sched_sysmon_tick") fn sysmonTick(): i64 {
  // The epoch advance. Load-add-store rather than a CAS: see `sysmonEpoch`'s
  // own comment for why a lost update here is a delayed preempt request and
  // never an early one.
  let epoch = slotAddr(ptrOf(sysmonEpoch), 0)
  atomicStore(epoch, atomicLoad(epoch) + 1)
  let now = preemptTickNow()
  let count: i64 = 0
  let w: i64 = 0
  while (w < schedMaxWorkers && w < preemptSlots) {
    let started = atomicLoad(slotAddr(ptrOf(startTick), w))
    if (started != 0 &&
      now - started >= preemptBudgetTicks &&
      atomicLoad(slotAddr(ptrOf(startTick), w)) == started) {
      // Re-validated against a second load, immediately before publishing:
      // `preemptClear` can run on `w`'s own thread between the first load
      // above and here, if the task that was over budget finishes or parks
      // in exactly that window. Without the re-check this would publish a
      // request for a worker that, by the time it lands, is running
      // nothing -- and since no safepoint or dispatch is coming to consume
      // it, that republishes the exact permanently-stuck state #4278 fixed.
      atomicStore(slotAddr(ptrOf(requested), w), 1)
      // #3746: publish the summary AFTER the flag, never before -- see
      // `anyRequested`'s own header for the proof that this order (paired with
      // the clearer's opposite one) admits no interleaving that hides a set
      // flag behind a zero summary.
      atomicStore(slotAddr(ptrOf(anyRequested), 0), 1)
      // #4203: and publish the back-edge poll request on the same terms and for
      // the same reason -- AFTER the flag. `anyRequested` is what the runtime's
      // own preempt clause reads; `pollAttention` (./pollreq.bit) is what a
      // compiled mutator reads at its back edge, and without this a flagged
      // worker would run to completion because nothing told it to look.
      pollRequest()
      count = count + 1
    }
    w = w + 1
  }
  return count
}

// Read the flag without clearing it.
//
// `@symbol` PINNED (#3563): #3560's `runtime/stw/stwpoll.bit` calls this
// cross-module (`stwPollNeeded`'s preempt clause), and an unpinned export is
// emitted as a mangled same-module name (`m<N>$preemptRequested`) that no
// sibling object can define (SPEC §11.9, ABI.md §9) — exactly like
// `sysmonTick`'s pin above and `schedCurrentWorker`'s in `sched.bit`. The
// name matches the `bit_rt_port_sched_*` convention those siblings use.
// Purely an ABI/linkage annotation — no change to the logic below.
export @nosplit @symbol("bit_rt_port_sched_preempt_requested") fn preemptRequested(worker: i64): bool {
  return atomicLoad(slotAddr(ptrOf(requested), worker)) != 0
}

// The summary itself, as a value rather than as an address (`preemptAnyAddr`
// above): "is a preempt pending for ANY worker". `@symbol` PINNED for the same
// reason `preemptRequested` above it is -- #4203's `stwPollNeeded`
// (`../stw/stwpoll.bit`) reads it cross-module.
//
// It is the CONSERVATIVE form of `preemptRequested(schedCurrentWorker())`: it
// can read 1 with nothing pending for the asking thread, and can never read 0
// with something pending for it (see `anyRequested`'s own header for that
// invariant's proof). That is what lets a caller which only needs a yes/no
// answer skip `schedCurrentWorker` entirely -- two real cross-module calls, on
// a path that runs to decide whether a slow path is needed at all.
export @nosplit @symbol("bit_rt_port_sched_preempt_any") fn preemptAnyPending(): bool {
  return atomicLoad(slotAddr(ptrOf(anyRequested), 0)) != 0
}

// Report whether `worker` has a pending preempt request, and clear it in the
// same call. This function only REPORTS -- it is the caller's job, at its own
// safepoint, to actually yield to the scheduler. Nothing here touches a task,
// a stack, or the collector's stop-the-world rendezvous.
//
// #2577's actual safepoint-check caller, `schedMaybeYieldForPreempt`, lives in
// `task.bit` beside `schedYield` -- the yield it takes -- rather than here;
// see that function's own comment for the full design, including a real bug
// this file's `worker` parameter caught on its first build.
export @nosplit fn maybePreempt(worker: i64): bool {
  if (atomicLoad(slotAddr(ptrOf(requested), worker)) == 0) {
    return false
  }
  atomicStore(slotAddr(ptrOf(requested), worker), 0)
  // #3746: this is the path that CONSUMES a request, so it is the one that has
  // to hand the summary back to 0 -- without it every back edge on every
  // worker would keep taking the guard's slow path until `sysmonTick`'s next
  // scan (2ms away, against a 10ms budget), which is ~20% of a compute task's
  // life and would give back most of what the summary buys.
  refreshPreemptAny()
  return true
}
