// The register-once model's arm/disarm half (#5865), split out of poll.bit
// (#4428's E0200 800-line ceiling) — pure move, no content change. Same
// module as poll.bit (sibling file), so its `writeU64`/`writeI16`/`writeI64`,
// the `kqIdentOff`/`kqFilterOff`/`kqFlagsOff`/`kqFflagsOff`/`kqDataOff`/
// `kqUdataOff` offsets, `evAddClear`/`evDelete`/`evfiltRead`/`evfiltWrite`,
// `kevent`, and `pollScratchBytes` are all already in scope, imported
// nowhere else.

// NOTE_OOB (0x0002) in EVFILT_READ's fflags; EV_EOF (0x8000) and EV_ERROR
// (0x4000) in its flags, from <sys/event.h>.
const noteOob: int = 2
const evEof: int = 32768
const evError: int = 16384

// Whether the read event at `off` in `base` may stand for a short read that
// did not drain the socket (#5993). A short stream read leaves the receive
// buffer empty except in three cases. It stops at the urgent mark with bytes
// queued behind it (NOTE_OOB). It takes the FIN along with the data (EV_EOF).
// Or it returns buffered data ahead of a pending `so_error`, which XNU's
// `filt_soread_common` reports as readable with no bytes and no flag, so
// `data <= 0`. `data` classifies the event exactly. It is no drain proof for
// the reader, because it was sampled when this drain harvested the event,
// not when the reader read.
@nosplit fn pollDescReadOwed(base: *u8, off: int): bool {
  let flags = readI16(base, off + kqFlagsOff) & 65535
  if ((flags & (evEof + evError)) != 0) {
    return true
  }
  if ((readU64(base, off + kqFflagsOff) & noteOob) != 0) {
    return true
  }
  return readU64(base, off + kqDataOff) <= 0
}

// Register `fd`'s read filter ONCE, for its whole life, EV_CLEAR rather than
// EV_ONESHOT (#5865): the persistent-registration half of the register-once
// model `../polldesc.bit`'s header describes. `gen` is `pdOpen`'s return for
// this fd, stashed in `udata` as `0 - gen` — NEGATIVE, so `pollDrain` can
// tell this event apart from a legacy `pollRegister` one-shot registration's
// `udata` (a real task pointer, always positive) without a second poll
// descriptor or a Scheduler-layout change. `ident` is `fd`, exactly as
// `pollRegister` already writes it, so `pollDrain` needs no new field to
// recover which socket fired.
//
// READ ONLY, AT OPEN. Write is registered LAZILY instead
// (`pollDescRegisterWrite` below), the first time a write actually blocks —
// see `netPollDescOpen`'s header (`../../net/darwin/sock.bit`) for why:
// registering EVFILT_WRITE at open time cost a real, measured ~8%
// regression at `BIT_WORKERS=1 -c64` on the pkg/web bench, because a socket
// is almost always writable and each `write()` re-triggers the knote's
// internal state via `sowakeup` regardless of level, so `pollDrain` decoded
// a spurious write-readiness event on every response.
//
// NOTE_OOB on the read filter (#5993): without it EVFILT_READ reports urgent
// data as plain readability, and `pollDrainDescEvent` could not tell that a
// read stopped at the urgent mark with bytes still queued behind it.
export @symbol("bit_rt_port_sched_poll_desc_register") @nosplit fn pollDescRegister(
  pollFd: int,
  fd: int,
  gen: int,
): bool {
  return pollDescArm(pollFd, fd, gen, evfiltRead(), noteOob)
}

// Arm the write filter, lazily (#5865) — called the FIRST time a write on
// `fd` actually returns EAGAIN and needs to park, not at open. Idempotent at
// the kqueue level (`EV_ADD` re-arms an existing registration in place, this
// file's own header on `pollRegister`), so a caller that races this (two
// writers on the same fd, unusual but not forbidden) never corrupts
// anything by calling it twice.
export @symbol("bit_rt_port_sched_poll_desc_register_write") @nosplit fn pollDescRegisterWrite(
  pollFd: int,
  fd: int,
  gen: int,
): bool {
  return pollDescArm(pollFd, fd, gen, evfiltWrite(), 0)
}

@nosplit fn pollDescArm(pollFd: int, fd: int, gen: int, filter: int, fflags: int): bool {
  let base = pollScratchBytes()
  writeU64(base, kqIdentOff, fd)
  writeI16(base, kqFilterOff, filter)
  writeI16(base, kqFlagsOff, evAddClear())
  writeU32(base, kqFflagsOff, fflags)
  writeU64(base, kqDataOff, 0)
  writeI64(base, kqUdataOff, 0 - gen)
  let none: *u8 = nil
  return int(kevent(i32(pollFd), base, i32(1), none, i32(0), none)) >= 0
}

// Retract both of `fd`'s persistent filters — the close-path half (#5865):
// called BEFORE `close(fd)` so a closed-and-reused fd number cannot deliver a
// stale knote into a new connection's registration. Best-effort on each
// filter independently (mirrors `pollUnregister`: EV_DELETE on a knote the
// kernel has already dropped is not an error to propagate), so one missing
// filter never skips retracting the other.
export @symbol("bit_rt_port_sched_poll_desc_unregister") @nosplit fn pollDescUnregister(
  pollFd: int,
  fd: int,
): bool {
  let r = pollDescDisarm(pollFd, fd, evfiltRead())
  let w = pollDescDisarm(pollFd, fd, evfiltWrite())
  return r && w
}

@nosplit fn pollDescDisarm(pollFd: int, fd: int, filter: int): bool {
  if (pollFd <= 0 || fd < 0) {
    return false
  }
  let base = pollScratchBytes()
  writeU64(base, kqIdentOff, fd)
  writeI16(base, kqFilterOff, filter)
  writeI16(base, kqFlagsOff, evDelete())
  writeU32(base, kqFflagsOff, 0)
  writeU64(base, kqDataOff, 0)
  writeU64(base, kqUdataOff, 0)
  let none: *u8 = nil
  return int(kevent(i32(pollFd), base, i32(1), none, i32(0), none)) >= 0
}
