// `bit_rt_port_sched_thread_run_delay`'s darwin answer: 0, there being no per-thread
// run-queue wait counter to read here (#6427). The linux provider's twin
// (`../linux/rundelay.bit`) says what the number is for; 0 means "nothing to
// excuse", so a late timer wake on this OS is judged by the plain-sleep control
// alone.
export @nosplit @symbol("bit_rt_port_sched_thread_run_delay") fn schedThreadRunDelay(): int {
  return 0
}
