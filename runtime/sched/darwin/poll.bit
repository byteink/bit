// Darwin netpoller provider for the Stage-2 port of runtime/sched/ (#1364):
// `NetPoller` on kqueue. See ../sched.bit's netpoller section for what stays in
// core (the descriptor slot and the try-lock) and why the poller itself cannot.
//
// Everything here goes through libSystem (§11.7) rather than raw traps: Apple
// publishes no stable syscall numbers and reserves the right to renumber them,
// so a C call is the supported path — the same choice runtime/alloc/darwin,
// runtime/rand/darwin and runtime/park/darwin all make.
//
// EVERY STRUCTURE OFFSET BELOW IS DARWIN'S, NOT THIS PROJECT'S, and was read out
// of XNU's <sys/event.h>, NOT from memory. `kevent` (a C structure) is `#pragma pack(4)`
// on macOS, so its fields do NOT sit where natural alignment would put them --
// which is why each offset is written out here rather than computed.

import { taskAt, schedPollUnparkHeld, scPollFd, pollRead } from "../../sched"
import { schedPollTryEnter, schedPollLeave } from "../../sched"
import { schedPollPendingInc, schedPollPendingDec, schedPollPendingCount } from "../../sched"
import { pollDrainWakeOnly, schedPollerWaitNs } from "../../sched"
import { schedCurrentWorker, wkId, schedMaxWorkers } from "../../sched"
// pollDesc (#5864): the register-once model's per-fd table. `pollDescRegister`/
// `pollDescUnregister` below arm/retract the kernel side exactly once per fd
// life; `pollDrain`'s new decode branch routes a readiness event through
// `pdWake` to find whichever task is CURRENTLY parked in that (fd, dir) slot,
// instead of the kernel event itself carrying a task pointer.
import { pdWake, pdDirRead, pdDirWrite, pdEmpty } from "../../sched"

// int kqueue(void);
// int kevent(int kq, const kevent *changelist, int nchanges,
//            kevent *eventlist, int nevents,
//            const timespec *timeout);
// int close(int fd);
//
// Only C-representable types cross the boundary (§11.7), so every class
// travels as a `*u8` over a region this module lays out by hand.
extern fn kqueue(): i32
extern fn kevent(
  kq: i32, changelist: *u8, nchanges: i32,
  eventlist: *u8, nevents: i32, timeout: *u8,
): i32

// THE DESCRIPTOR IS CLOSED THROUGH THE RUNTIME, NOT THROUGH libSystem, AND THAT
// IS A WORKAROUND FOR A COMPILER BUG — not a design preference.
//
// `extern function close(fd: i32): i32` builds cleanly and then SIGSEGVs when
// called, under the SELF-HOSTED compiler only. The seed emits both `_close` and
// libSystem's `_close$NOCANCEL` into the import table; the self-hosted compiler
// emits only `_close$NOCANCEL` and silently drops the `_close` import, so the
// call lands on an unbound stub. Reduced to six lines with no scheduler
// involved, and it is NOT a general `$`-variant collision: `realpath` has the
// same shape (`_realpath$DARWIN_EXTSN` is also imported) and works, with both
// symbols present. `dup` works too, so it is not the signature.
//
// `bit_rt_fs_close` is a STATICALLY LINKED symbol from libbitrt rather than a
// dylib import, so it does not go through the code path that is broken. Its
// behaviour is identical — `runtime/root/`'s `bit_rt_fs_close` is a thin wrapper
// over the same `close(2)`.
//
// Filed rather than fixed here: the defect is in Mach-O import emission, not in
// the scheduler, and a linker change landing as a side effect of a runtime port
// is how two agents produce a hole that exists only in the combination of their
// work. Worth noting for whoever takes it that the existing differential gates
// CANNOT see this class of bug — they compare check and type dumps, not the
// linked image's import table.
extern fn bit_rt_fs_close(fd: i64): i64

// EVFILT_READ / EVFILT_WRITE, from <sys/event.h>. NEGATIVE, and
// they are stored into an i16 field, so they are written as two's-complement
// 16-bit patterns by `writeI16` below rather than as bare integers.
//
// `@nosplit` (#5438): `pollRegister`/`pollUnregister` must be, so every
// function they call must be too (E0075 is transitive over user-function
// calls, not just over what a function itself does).
@nosplit fn evfiltRead(): int { return 0 - 1 }
@nosplit fn evfiltWrite(): int { return 0 - 2 }

// EV_ADD (0x0001) | EV_ONESHOT (0x0010), from <sys/event.h>.
//
// Unlike epoll there is no ADD/MOD split: kqueue's EV_ADD re-arms an existing
// registration in place, so re-registering the same fd is the same call. The
// Linux twin's EEXIST path has no counterpart here, and that asymmetry is real
// rather than an oversight in one of the two.
@nosplit fn evAddOneshot(): int { return 17 }

// EV_DELETE (0x0002), from <sys/event.h>. Removes a knote outright rather than
// re-arming it, which is what `pollUnregister` needs: EV_ADD cannot express
// "stop watching this fd".
@nosplit fn evDelete(): int { return 2 }

// EVFILT_USER (-10), from <sys/event.h> — the real wake source this file was
// missing (#5717, epic #3913): a producer-triggered event this kqueue can
// block on, so `pollDrain`'s timeout can be the whole idle budget instead of
// the 1ms recheck floor `parkMaxBackoffNs` otherwise pins it to.
//
// NOT a file descriptor: EVFILT_USER's `ident` is a namespace private to the
// filter, chosen by the caller and scoped per (kq, filter) pair (XNU keys a
// knote by the pair, not by `ident` alone), so `wakeIdent` below can never
// collide with a real fd's EVFILT_READ/EVFILT_WRITE registration on the same
// kqueue.
@nosplit fn evfiltUser(): int { return 0 - 10 }

// EV_ADD (0x0001) | EV_CLEAR (0x0020), from <sys/event.h>. `pollArmWake`
// below registers the wake filter with these ONCE, not EV_ONESHOT: EV_CLEAR
// is what makes `NOTE_TRIGGER` level-ish rather than a signal that is lost
// when nobody is listening — see `pollWake`'s header for the argument this
// buys.
@nosplit fn evAddClear(): int { return 33 }

// NOTE_TRIGGER (0x01000000), from <sys/event.h> — the only fflag EVFILT_USER
// understands for "fire this filter now". Written as `writeU32`'s `fflags`
// argument, never OR'd with anything else here: this file uses no other
// EVFILT_USER fflag.
const noteTrigger: int = 16777216

// The `ident` `pollArmWake`/`pollWake` always use. Arbitrary — see
// `evfiltUser`'s comment for why any value is safe — one kqueue needs only
// one wake filter, so one fixed ident is all this file ever registers.
const wakeIdent: int = 1

// `kevent` (a C structure) on macOS, from <sys/event.h> — which pins every one of these with
// a comptime `@offsetOf` assertion because `sys/types.h` applies `#pragma
// pack(4)` and the layout is therefore NOT what natural alignment would give:
//
//     ident:  0   (usize, 8)
//     filter: 8   (i16)
//     flags:  10  (u16)
//     fflags: 12  (u32)
//     data:   16  (isize, 8)
//     udata:  24  (usize, 8)
//
// Total 32 bytes. Note `filter` and `flags` are packed into the 8..12 window —
// a natural-alignment guess would put `flags` at 12 and the whole structure at 40,
// which would misparse every event the kernel returned.
const keventSize: int = 32
const kqIdentOff: int = 0
const kqFilterOff: int = 8
const kqFlagsOff: int = 10
const kqFflagsOff: int = 12
const kqDataOff: int = 16
const kqUdataOff: int = 24

// Ready events drained per call. `runtime/sched/`'s `max_batch`; more ready events
// wait for the next poll, which bounds the work one idle pass can do.
const maxBatch: int = 64

// The drain buffer, 64 * 32 = 2048 bytes = 256 words.
//
// MODULE-LEVEL, AND THAT IS SAFE ONLY BECAUSE OF THE TRY-LOCK — see the Linux
// twin for the full argument. `pollDrain` runs on every idle pass of every
// worker, so a per-call allocation would put the GC on the scheduler's idle
// path; `schedPollTryEnter` admits exactly one worker at a time, which is what
// makes one shared buffer sound.
let evBuf: [256]i64

// The timespec `kevent` takes for its timeout: two 64-bit words {sec, nsec}.
// Separate from `evBuf` because both are live across the same call.
let tsBuf: [2]i64

@nosplit fn bufBytes(): *u8 {
  let z: *u8 = nil
  return z + int(ptrOf(evBuf))
}

@nosplit fn tsBytes(): *u8 {
  let z: *u8 = nil
  return z + int(ptrOf(tsBuf))
}

// A Bit array stores one 8-BYTE WORD per element (§11.8), so the kernel's
// packed structs are laid out through a `*u8` cursor over a region that really
// is contiguous bytes. Reading `udata` at offset 24 happens to be 8-aligned,
// but `filter` at 8 and `flags` at 10 are not, so the whole structure is handled
// byte-wise for one consistent rule rather than a per-field special case.
@nosplit fn readU64(base: *u8, off: int): int {
  let v = 0
  let k = 7
  while (k >= 0) {
    let p = base + off + k
    v = v * 256 + int(*p)
    k = k - 1
  }
  return v
}

// `@nosplit` (#5438): both writers below are called from `pollRegister`/
// `pollUnregister`.
@nosplit fn writeU64(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 8) {
    let p = base + off + k
    *p = u8(v / (1 << (8 * k)) % 256)
    k = k + 1
  }
}

// `writeU64` above uses `/`/`%`, which mishandle a NEGATIVE `v` — fine for
// its existing callers (a task pointer or an fd is always positive), but
// `pollDescArm` below deliberately writes a negative `udata`. This sibling
// uses `>>`/`&` instead: exact for either sign, since both only ever touch
// the low 8 bits of `v >> (8 * k)`.
@nosplit fn writeI64(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 8) {
    let p = base + off + k
    *p = u8((v >> (8 * k)) & 255)
    k = k + 1
  }
}

@nosplit fn writeU32(base: *u8, off: int, v: int) {
  let k = 0
  while (k < 4) {
    let p = base + off + k
    *p = u8(v / (1 << (8 * k)) % 256)
    k = k + 1
  }
}

// Store a 16-bit field. `filter` is negative (EVFILT_READ is -1), so the value
// is reduced mod 2^16 first — writing a negative number's low bytes directly
// would depend on how the division below rounds, which is exactly the kind of
// detail that silently registers the wrong filter.
@nosplit fn writeI16(base: *u8, off: int, v: int) {
  let u = v % 65536
  if (u < 0) {
    u = u + 65536
  }
  let p0 = base + off
  *p0 = u8(u % 256)
  let p1 = base + off + 1
  *p1 = u8(u / 256 % 256)
}

// Create the poll descriptor. `runtime/sched/`'s `createPollFd`. Returns -1 on
// failure, which the caller must check.
//
// A DESCRIPTOR OF 0 IS REPORTED AS FAILURE, and that rule belongs here rather
// than in the caller. `../worker.bit`'s scheduler block spells "no poller bound"
// as a `scPollFd` of 0, so `netAwaitReady` and `pollDrain` both read 0 as "there
// is no poller" — a descriptor 0 would be indistinguishable from an unbound one
// at every site that matters. The kernel only hands out 0 when stdin is closed,
// which this runtime never does, so this rejects nothing real; it is here so the
// sentinel cannot be forged.
//
// THE BRANCH IS ALSO WHAT KEEPS THIS FUNCTION OUT OF ITS CALLER'S OBJECT — see
// the Linux twin, where the one-line form was spliced into `boot` and left a
// mangled reference `--freestanding` refuses. Kept in lockstep here so the two
// providers stay function-for-function, which is the whole point of the split.
export @symbol("bit_rt_port_sched_poll_create") @nosplit fn pollCreate(): int {
  let rc = int(kqueue())
  if (rc <= 0) {
    return 0 - 1
  }
  // ARMED BEFORE THIS RETURNS, AND THAT ORDERING IS PART OF THE CORRECTNESS
  // ARGUMENT. `rc` is not published anywhere a producer can reach — nothing
  // outside this call has seen it yet, `schedSetPollFd` is always the
  // caller's very next step (`runtime/root/<os>/boot.bit`) — so no
  // `pollWake` can possibly run against this descriptor before the wake
  // filter exists on it. A registration failure closes the kqueue rather
  // than handing back a descriptor whose wake side silently does nothing.
  if (!pollArmWake(rc)) {
    let _ = int(bit_rt_fs_close(i64(rc)))
    return 0 - 1
  }
  return rc
}

// Register the EVFILT_USER wake filter `pollWake` triggers. Called exactly
// once per descriptor, from `pollCreate` only — see its header for why the
// ordering there matters. `EV_ADD | EV_CLEAR`, not `EV_ONESHOT`: this
// registration must survive being triggered, since `pollWake` may fire many
// times over the descriptor's life.
@nosplit fn pollArmWake(pollFd: int): bool {
  let base = pollScratchBytes()
  writeU64(base, kqIdentOff, wakeIdent)
  writeI16(base, kqFilterOff, evfiltUser())
  writeI16(base, kqFlagsOff, evAddClear())
  writeU32(base, kqFflagsOff, 0)
  writeU64(base, kqDataOff, 0)
  writeU64(base, kqUdataOff, 0)
  let none: *u8 = nil
  return int(kevent(i32(pollFd), base, i32(1), none, i32(0), none)) >= 0
}

// Trigger the wake filter `pollArmWake` armed — the producer side of this
// ticket's primitive, the same role `bit_rt_port_park_wake` plays for a
// parked worker's word, aimed at the poller's kqueue instead.
//
// THE LOST-WAKEUP ARGUMENT. A producer's sequence is "publish work, then call
// this"; a consumer blocked in `pollDrain` is "check for work, then block in
// `kevent`". `NOTE_TRIGGER` is LEVEL-ish, not edge-ish, in the one way that
// matters here: firing it sets the knote's state IN THE KERNEL, independent
// of whether anything is blocked in `kevent` at that instant, and `EV_CLEAR`
// (armed once, not `EV_ONESHOT`) means that state persists until a `kevent`
// call actually retrieves it — it is not consumed by merely being set, the
// way a condition-variable signal with no waiter is. So every interleaving
// of "trigger" against "block" is safe:
//
//   - trigger lands before the consumer's `kevent` call starts: the knote is
//     already active, so `kevent` sees it ready on entry and returns without
//     ever sleeping — this is what makes a sub-millisecond `pollDrain`
//     timeout safe to combine with a trigger that already happened. UNLESS
//     another worker's `kevent` retrieves it first (#5843), which is why
//     `pollDrain` reads the claim itself through `schedPollerWaitNs`.
//   - trigger lands while the consumer is asleep inside `kevent`: the kernel
//     wakes the blocked call directly — the ordinary case this filter exists
//     for.
//   - trigger lands after the consumer's `kevent` call already returned (a
//     stale or spurious trigger): the state persists for the NEXT call, so
//     nothing is lost, only deferred by at most one drain.
//
// The one property this relies on and does not itself provide is memory
// visibility of "publish work" before "call this" — ordinary release
// ordering on whatever queue the producer pushed to, the same requirement
// every `bit_rt_port_park_wake` caller already meets.
export @symbol("bit_rt_port_sched_poll_wake") @nosplit fn pollWake(pollFd: int): bool {
  if (pollFd <= 0) {
    return false
  }
  let base = pollScratchBytes()
  writeU64(base, kqIdentOff, wakeIdent)
  writeI16(base, kqFilterOff, evfiltUser())
  writeI16(base, kqFlagsOff, 0)
  writeU32(base, kqFflagsOff, noteTrigger)
  writeU64(base, kqDataOff, 0)
  writeU64(base, kqUdataOff, 0)
  let none: *u8 = nil
  return int(kevent(i32(pollFd), base, i32(1), none, i32(0), none)) >= 0
}

// Close it. A non-positive descriptor is "never created" and closing it would
// hand the kernel a fabricated fd, so the guard is a real precondition and not
// only the anti-inlining branch `pollCreate` documents.
export @symbol("bit_rt_port_sched_poll_close") @nosplit fn pollClose(pollFd: int) {
  if (pollFd <= 0) {
    return
  }
  let _ = int(bit_rt_fs_close(i64(pollFd)))
}

// Per-worker scratch for the 32-byte `kevent` change struct `pollRegister`/
// `pollUnregister` build (#5438). NOT `evBuf` above: that buffer is sound
// shared state only because `schedPollTryEnter`'s try-lock admits one worker
// at a time, and register/unregister are not behind that lock — several
// green tasks on several workers call either concurrently, so one shared
// buffer would let two of them stomp each other's change struct mid-build.
//
// One slot per worker (not per task) is enough: only one task runs per
// worker at a time (cooperative M:N), and neither function yields or reaches
// a safepoint mid-body, so within a single worker a register and an
// unregister can never be mid-flight together. Same shape as
// `runtime/net/sock.bit`'s `sockScratchSlot()`/`saBuf` — (schedMaxWorkers +
// 1) slots, the extra one a fallback for a caller off a green stack, sized
// with its own literal because a fixed-array length must be one (E0021, the
// same constraint `preempt.bit` documents for `preemptSlots`).
const pollScratchSlots: int = 32

@nosplit fn pollScratchSlot(): int {
  let w = schedCurrentWorker()
  if (w == 0) {
    return pollScratchSlots
  }
  let id = *(taskAt(w) + wkId)
  if (id < 0 || id >= schedMaxWorkers || id >= pollScratchSlots) {
    return pollScratchSlots
  }
  return id
}

// (pollScratchSlots + 1) slots of 4 words (32 bytes) each = 132 words.
let pollRegScratch: [132]i64

@nosplit fn pollScratchBytes(): *u8 {
  let z: *u8 = nil
  return z + int(ptrOf(pollRegScratch)) + pollScratchSlot() * 32
}

// Register `task` to be woken when `fd` is ready for `interest`.
//
// ONESHOT, matching the Linux twin: the registration fires once and
// disarms, so a woken task must re-register before parking on the same fd
// again. That is what makes the wake edge unambiguous.
export @symbol("bit_rt_port_sched_poll_register") @nosplit fn pollRegister(
  pollFd: int,
  fd: int,
  interest: int,
  task: int,
): bool {
  let base = pollScratchBytes()

  let filter = evfiltWrite()
  if (interest == pollRead) {
    filter = evfiltRead()
  }
  writeU64(base, kqIdentOff, fd)
  writeI16(base, kqFilterOff, filter)
  writeI16(base, kqFlagsOff, evAddOneshot())
  writeU32(base, kqFflagsOff, 0)
  writeU64(base, kqDataOff, 0)
  writeU64(base, kqUdataOff, task)

  // Submit one change, collect no events: `nevents` 0 with a null eventlist is
  // kqueue's registration-only form.
  let none: *u8 = nil
  let rc = int(kevent(i32(pollFd), base, i32(1), none, i32(0), none))
  if (rc < 0) {
    return false
  }
  // Counted only once armed with the kernel — see `schedPollPendingInc`'s own
  // comment for why this is a process-global rather than a `Scheduler` field.
  schedPollPendingInc()
  return true
}

// Retract a registration before it fires (#5430). This is the primitive that
// closes the race ../../sched.bit's netpoller section and ../timer.bit's
// `schedTimerPush` describe: a task linked on BOTH the poller and
// `scTimerHead` leaves the loser of that race holding a `Task` address the
// winner may already have run to completion and freed. A caller that wins the
// other side of such a race (a timer firing, or a second interest on the same
// task) must retract this side before touching the task again.
//
// Returns true when the kqueue registration was actually removed here, false
// when there was nothing left to remove — `EV_DELETE` on a filter the kernel
// has ALREADY reported (and therefore already auto-deleted, oneshot) fails
// with the knote simply absent, which reads here as "too late, the other side
// already won" rather than as an error to propagate.
//
// `interest` selects the same `EVFILT_READ`/`EVFILT_WRITE` split `pollRegister`
// arms — kqueue tracks the two directions on one fd as separate knotes, so
// deleting the wrong filter would silently leave the real registration armed.
export @symbol("bit_rt_port_sched_poll_unregister") @nosplit fn pollUnregister(
  pollFd: int,
  fd: int,
  interest: int,
): bool {
  if (pollFd <= 0 || fd < 0) {
    return false
  }
  let base = pollScratchBytes()

  let filter = evfiltWrite()
  if (interest == pollRead) {
    filter = evfiltRead()
  }
  writeU64(base, kqIdentOff, fd)
  writeI16(base, kqFilterOff, filter)
  writeI16(base, kqFlagsOff, evDelete())
  writeU32(base, kqFflagsOff, 0)
  writeU64(base, kqDataOff, 0)
  writeU64(base, kqUdataOff, 0)

  let none: *u8 = nil
  let rc = int(kevent(i32(pollFd), base, i32(1), none, i32(0), none))
  if (rc < 0) {
    return false
  }
  // The one-shot edge this registration owed will now never be reported by
  // the kernel, so the outstanding count this call is retracting must drop
  // here — `schedPollPendingDec`'s own comment ties it to the kernel reporting
  // the edge, and a retracted registration is the one path where that never
  // happens.
  schedPollPendingDec()
  return true
}

// Read a signed 16-bit field — `filter` (EVFILT_READ/WRITE are negative), the
// one field `readU64` cannot serve. Little-endian, matching `writeI16`.
@nosplit fn readI16(base: *u8, off: int): int {
  let p0 = base + off
  let p1 = base + off + 1
  let u = int(*p0) + int(*p1) * 256
  if (u >= 32768) {
    u = u - 65536
  }
  return u
}

// pollDescRegister/pollDescRegisterWrite/pollDescArm/pollDescUnregister/
// pollDescDisarm moved to ./pollonce.bit (#5865, #4428's 800-line ceiling) —
// pure move, same module, no import needed.

// True when this drain can answer without entering the kernel — either there
// is no poller at all, or nothing is armed on it.
//
// NOTHING ARMED => NOTHING CAN BE READY FOR A NON-BLOCKING CALL (#3736,
// narrowed by #5717). `schedPollPendingCount` counts only the EV_ONESHOT
// read/write registrations `pollRegister`/`pollUnregister` own — it does NOT
// count the permanent EVFILT_USER wake filter `pollCreate` arms, which is
// deliberate: a zero count still means no READ/WRITE event can be ready, and
// for `timeoutNs == 0` that is the whole question, since a non-blocking call
// has nothing to gain from the wake filter either way — it only matters to a
// call that would otherwise SLEEP, which this skip path never reaches
// (`timeoutNs == 0` is exactly excluded below). Skipping the syscall here is
// therefore still exact, not an approximation, for the case it covers.
//
// ONLY FOR THE NON-BLOCKING DRAIN, and that condition is load-bearing rather
// than caution. A caller passing a positive `timeoutNs` is asking to WAIT,
// not merely to collect — this platform's own future net-deadline path is
// exactly that caller, and windows already has one today:
// `runtime/net/windows/tcpdeadline.bit`'s deadline threads drive windows'
// OWN `pollDrain` in a bounded loop and depend on it blocking. Returning 0
// immediately here would convert a bounded park into a hot spin, which is a
// worse bug than the syscall this removes.
//
// DO NOT COPY WINDOWS' CONSTANT (#5730). `netDeadlinePollMs` (= 2) is
// MILLISECONDS, matching windows' own `pollDrain(schedAddr, timeoutMs: int)`
// — this file's `pollDrain` takes NANOSECONDS (see its own header below). A
// darwin net-deadline path needs its own nanosecond-named constant, never
// `netDeadlinePollMs` passed straight through; multiplying it by 1000000
// preserves the interval if 2ms is still the desired poll cadence.
//
// A STALE COUNT CANNOT SKIP A NEEDED DRAIN. The count is incremented after the
// filter is armed and decremented when its edge is reported, so it is >= 1 for
// the whole window in which an event is possible; the only documented way it
// is ever wrong (a stress harness's second private poller, see
// `schedPollPendingCount`) leaves it too HIGH, which costs one ordinary
// syscall and skips nothing. A registration armed by another thread
// immediately after this read is picked up by the next idle turn, which is
// bounded by the same `parkMaxBackoffNs` that already bounds how long the
// worker loop may go between drains.
//
// WHY IT MATTERS: this is the idle path of every program, and the kevent fired
// on every idle turn whether or not the program did any I/O at all. Measured
// on 8 green threads sleeping at a 200us cadence, no sockets in the process:
// 159,655 kevent syscalls for 160,000 timer wakes — one full kernel round trip
// per wake, every one of them provably empty.
//
// SEPARATE FUNCTION rather than two `if`s inline because `pollDrain` was
// already at E0204's complexity ceiling of 10; folding both early exits in
// here keeps it there instead of buying the check with a lint suppression.
@nosplit fn pollDrainSkippable(pollFd: int, timeoutNs: int): bool {
  if (pollFd == 0) {
    return true
  }
  return timeoutNs == 0 && schedPollPendingCount() == 0
}

// `pollDrain`'s answer, given how many tasks the drain unparked and whether it
// also consumed worker 0's wake. Two independent facts, one return value: a
// positive count wins, because it already sends the caller down the find-work
// path, and `pollDrainWakeOnly` (../../sched/sleep.bit) carries the rest — "no
// task, but something asked you to look again".
//
// The linux twin (../linux/poll.bit) has the identical body, and there it also
// folds the two epoll descriptors' answers; kqueue keys on `(fd, filter)`, so
// this provider has one descriptor and one call site.
@nosplit fn pollDrainAnswer(woken: int, sawWake: bool): int {
  if (woken > 0) {
    return woken
  }
  if (sawWake) {
    return pollDrainWakeOnly
  }
  return 0
}

// Drain ready events and unpark the waiting task for each. Returns how many
// were woken, or `pollDrainWakeOnly` when the only event was worker 0's wake.
// `runtime/sched/`'s `pollReady`.
//
// NANOSECOND RESOLUTION (#5717), not milliseconds: a sub-millisecond deadline
// used to truncate to 0, which `pollDrainSkippable` reads as the non-blocking
// form — hot-spinning a caller that asked to wait a few hundred microseconds
// rather than blocking it. `secs`/`nsecs` below decompose `timeoutNs`
// directly; nothing upstream of this function scales units anymore.
//
// THIS UNIT DIVERGES FROM ONE SIBLING NOW, NOT TWO (#5718 narrowed #5730).
// linux's `pollDrain(schedAddr, timeoutNs: int)` also takes NANOSECONDS as of
// #5718; windows' still takes MILLISECONDS and widening it is unplanned.
// `bit_rt_port_sched_poll_drain` links three different functions under the
// same symbol for stop-the-world interposition only (`_tests_/bit/stwwiring`);
// it is never called across the platform boundary, so nothing enforces one
// shared meaning even where two providers now agree — the parameter's OWN
// name is the only guard. Read it before writing a call; never copy an
// argument expression out of another provider's file.
//
// MOST CALLERS PASS `timeoutNs` 0 — a non-blocking drain, which is what
// `runtime/sched/` passes. That is what keeps those call sites compatible
// with stop-the-world: a worker never blocks inside `kevent`, so it is never
// sitting in a syscall where it is neither `running` nor `parked` and cannot
// answer the collector's rendezvous.
//
// ONE CALLER NOW BLOCKS HERE, and this comment said otherwise until #5735.
// `../../root/darwin/bootworker.bit`'s worker-0 idle branch passes a real
// deadline (up to `worker0WaitCeilingNs`, one second) as of #5722, so the
// sentence this paragraph used to open with — that the run loop always
// passes 0 — has been false since that merge. Nothing caught it, because no
// gate reads a comment. The obligation the old text put on such a caller is
// met the way it said it must be: that call site brackets the wait in
// `gcBlockingBegin`/`gcBlockingEnd`, so a worker blocked in `kevent` is not
// a running mutator and stop-the-world does not wait it out. A NEW blocking
// caller takes on the same obligation — nothing here relaxes it, and the
// bracket is the mechanism, not the intention.
//
// The linux twin carries the same correction; see `_tests_/bit/pollfree/`'s
// `exceptionsSchedPollLinux`, which rested on the identical claim (#5723).
// One drained event's outcome — folded out of `pollDrain`'s loop body to
// keep it under E0201/E0203/E0204's ceilings after #5865 added a second
// decode branch. Neither constant collides with a real woken-task id: both
// are non-positive, and `schedPollUnparkHeld`'s caller never receives one back.
const pollEventNothing: int = 0
const pollEventWoken: int = 0 - 1
const pollEventSawWake: int = 0 - 2

// Register-once event (#5865): `udata` is `0 - gen`, not a task pointer —
// EV_CLEAR means this filter stays armed, so the kernel event names the
// (fd, dir) slot, and `pdWake` finds whoever is CURRENTLY parked there (or
// records the edge for the next waiter). The count this decrements tracks
// live PARKED WAITERS now, not live kernel registrations
// (`netAwaitReady`/`netReadSockDeadline` increment it on a successful
// `pdWait`), so it drops only when `pdWake` actually finds a task to remove.
@nosplit fn pollDrainDescEvent(s: *i64, base: *u8, off: int, udata: int): int {
  let fd = readU64(base, off + kqIdentOff)
  let filter = readI16(base, off + kqFilterOff)
  let dir = pdDirWrite
  if (filter == evfiltRead()) {
    dir = pdDirRead
  }
  let taskId = pdWake(fd, dir, 0 - udata)
  if (taskId == pdEmpty) {
    return pollEventNothing
  }
  schedPollPendingDec()
  if (schedPollUnparkHeld(s, taskId)) {
    return pollEventWoken
  }
  return pollEventNothing
}

// Legacy one-shot `pollRegister` event: `udata` is the task pointer directly
// (always positive — a real heap address never sets the sign bit), the
// discriminator `pollDescArm`'s negative `udata` relies on. Kept for
// `_tests_/stress/schedpolldarwin` and its siblings, which build their own
// private scheduler+poller pair and call `pollRegister` directly
// (../netpoll.bit's own header).
@nosplit fn pollDrainLegacyEvent(s: *i64, task: int): int {
  // The kernel's one-shot edge is consumed here regardless of what
  // `schedPollUnparkHeld` does with it below — the registration this decrements
  // was armed once and the kernel just reported it exactly once, so the
  // count must drop whether or not a task was there to catch it.
  schedPollPendingDec()
  // `schedPollUnparkHeld`, NOT `schedUnpark`: a one-shot registration means this
  // readiness edge is already consumed, so a task caught between registering
  // and parking must be handed the wake rather than have it dropped. See
  // ../task.bit's "arming a park" section.
  if (schedPollUnparkHeld(s, task)) {
    return pollEventWoken
  }
  return pollEventNothing
}

// One event slot's outcome, `pollEventNothing`/`pollEventWoken`/
// `pollEventSawWake`. `off` is this event's byte offset into `base`.
@nosplit fn pollDrainEvent(s: *i64, base: *u8, off: int): int {
  let udata = readU64(base, off + kqUdataOff)
  if (udata < 0) {
    return pollDrainDescEvent(s, base, off, udata)
  }
  if (udata != 0) {
    return pollDrainLegacyEvent(s, udata)
  }
  // #5717's EVFILT_USER wake filter — `udata` 0, which `pollArmWake` chose
  // precisely because no real registration can carry it. NOT counted by
  // `schedPollPendingDec`: the filter is `EV_CLEAR` and permanent, never one
  // of the `EV_ONESHOT` registrations that counter tracks.
  //
  // Retrieving it here is what CONSUMES it (`EV_CLEAR`), so reporting 0 for
  // a drain whose only event was this hands the caller a spent wake and then
  // tells it to sleep — with `scPollWait` already claimed by the producer,
  // nothing can wake it again before `worker0WaitCeilingNs`.
  return pollEventSawWake
}

export @symbol("bit_rt_port_sched_poll_drain") @nosplit fn pollDrain(
  schedAddr: int,
  timeoutNs: int,
): int {
  let s = taskAt(schedAddr)
  let pollFd = *(s + scPollFd)
  if (pollDrainSkippable(pollFd, timeoutNs)) {
    return 0
  }
  if (!schedPollTryEnter(s)) {
    return 0
  }
  let waitNs = schedPollerWaitNs(s, timeoutNs)

  let ts = tsBytes()
  let secs = waitNs / 1000000000
  if (secs < 0) {
    secs = 0
  }
  let nsecs = waitNs % 1000000000
  if (nsecs < 0) {
    nsecs = 0
  }
  writeU64(ts, 0, secs)
  writeU64(ts, 8, nsecs)

  let base = bufBytes()
  let none: *u8 = nil
  let rc = int(kevent(i32(pollFd), none, i32(0), base, i32(maxBatch), ts))
  let woken = 0
  let sawWake = false
  if (rc > 0) {
    // Bounded by the batch, not by the kernel's answer (Power of 10).
    let n = rc
    if (n > maxBatch) {
      n = maxBatch
    }
    let i = 0
    while (i < n) {
      let outcome = pollDrainEvent(s, base, i * keventSize)
      if (outcome == pollEventWoken) {
        woken = woken + 1
      } else if (outcome == pollEventSawWake) {
        sawWake = true
      }
      i = i + 1
    }
  }
  schedPollLeave(s)
  return pollDrainAnswer(woken, sawWake)
}
