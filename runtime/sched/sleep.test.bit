// Private scheduler blocks isolate these checks from the process's live token.
@nosplit fn wakeAuditScheduler(s: *i64, armed: bool, poller: bool) {
  if (poller) {
    // A non-existent descriptor exercises the claim without waking a live poller.
    *(s + scPollFd) = 2147483647
  }
  if (armed) {
    atomicStore(s + scPollWait, pollWaitEpochStep + pollWaitArmed)
  }
}

test "idle fallback claims an armed poller without a missed wake" {
  let words = []i64(schedWords)
  wakeAuditScheduler(ptrOf(words), true, true)
  let before = schedTimerMissedWake()
  schedWakeIdle(ptrOf(words))
  assert(
    schedTimerMissedWake() == before,
    "idle fallback missed-wake delta=${schedTimerMissedWake() - before}",
  )
  assert((atomicLoad(ptrOf(words) + scPollWait) & pollWaitStateMask) == pollWaitClaimed)
}

test "missed wake audit counts an omitted armed fallback" {
  let words = []i64(schedWords)
  wakeAuditScheduler(ptrOf(words), true, true)
  let before = schedTimerMissedWake()
  let armed = schedWakeAuditBegin(ptrOf(words))
  schedWakeAuditEnd(ptrOf(words), armed)
  assert(schedTimerMissedWake() == before + 1)
}

test "idle fallback owes no wake to an awake or unbound poller" {
  let awake = []i64(schedWords)
  wakeAuditScheduler(ptrOf(awake), false, true)
  let unbound = []i64(schedWords)
  wakeAuditScheduler(ptrOf(unbound), true, false)
  let before = schedTimerMissedWake()
  schedWakeIdle(ptrOf(awake))
  schedWakeIdle(ptrOf(unbound))
  assert(schedTimerMissedWake() == before)
}

test "a claimed parked peer leaves the poller audit untouched" {
  let words = []i64(schedWords)
  wakeAuditScheduler(ptrOf(words), true, true)
  let workers = []i64(2 * workerWords)
  let s = ptrOf(words)
  *(s + scWorkers) = int(ptrOf(workers))
  *(s + scNWorkers) = 2
  atomicStore(s + scIdleCount, 1)
  let peer = schedWorkerAt(s, 1)
  atomicStore(peer + wkPark, 1)
  let before = schedTimerMissedWake()
  schedWakeIdle(s)
  assert(atomicLoad(peer + wkPark) == 0)
  assert((atomicLoad(s + scPollWait) & pollWaitStateMask) == pollWaitArmed)
  assert(schedTimerMissedWake() == before)
}

test "a new arm epoch does not count as the original missed wake" {
  let words = []i64(schedWords)
  wakeAuditScheduler(ptrOf(words), true, true)
  let s = ptrOf(words)
  let before = schedTimerMissedWake()
  let armed = schedWakeAuditBegin(s)
  schedPollerDisarm(s)
  assert(schedPollerArm(s))
  schedWakeAuditEnd(s, armed)
  assert(schedTimerMissedWake() == before)
}
