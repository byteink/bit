// Per-task scratch layout, relocated out of `runtime/chan/chan.bit` (#1612).
// Sibling of `task.bit`, so the same `runtime/sched` module - the scratch area
// is a property of the TASK BLOCK, not of channels: it lives at the base of the
// running task's own stack (the words `schedTaskInit` seeds with the
// self-pointer and tag), and `scratchOf` is the same stack-base indirection
// `schedCurrentTask` already rests on.
//
// ---------------------------------------------------------------------------
// WHY THIS MOVED, AND WHY THE OFFSETS ARE FROZEN
// ---------------------------------------------------------------------------
//
// It used to live in `chan.bit`, which made `runtime/root/slots.bit` import
// `scratchOf`/`scrErr`/`scrRecvOk` from `../chan` while `chan` needed to reach
// `runtime/root`'s GC-traced allocator (#1613) - a module import cycle that
// (a) failed `runtime/root`'s freestanding emit on the mangled `m5$scratchOf`
// (#1612) and (b) induced a spurious `nosplit`-resolution error on the chan
// side. Hosting the layout in `runtime/sched` - which both `chan` and `root`
// already import - makes the graph acyclic: root->sched and chan->sched, with
// no root<->chan edge.
//
// The WORD OFFSETS are an ABI contract shared across `chan`, `root` and #1581's
// `chanwrap` (which reads word 264, `scrRecvOk`). Moving the layout must not
// change a single offset; every value below is exactly what `chan.bit` carried.
//
//   0        task self-pointer      written by `schedTaskInit`
//   1        stack tag              written by `schedTaskInit`
//   2        select seed counter
//   3        select shared: done    the winner-take-all CAS word
//   4        select shared: winner
//   5        elem                   plain send/recv value slot
//   6        ok                     plain send/recv outcome slot
//   7        err                    per-task fallible-call error slot (SEAM 4)
//   8..199   waiter nodes           `chanMaxSelect` waiter nodes (chan-owned)
//   200..263 select index arrays    order + shuffled (chan-owned)
//   264      recv-ok                the SEAM-4 recv-ok flag
//
// 265 words = 2120 bytes out of a 64KiB stack. The area is the LOWEST
// `chanScratchWords` words of the stack, and a stack grows down from its top, so
// the scratch is the last memory a deepening call chain would reach; a task that
// overran it has already overflowed its stack.
export const chanScratchWords: int = 265

export const scrCounter: int = 2
export const scrSelDone: int = 3
export const scrSelWinner: int = 4
export const scrElem: int = 5
export const scrOk: int = 6
// `bit_rt_root_set_err`/`get_err`'s per-task pending-error pointer (ABI.md §13,
// SEAM 4/#1577). Zig carries it in a `@threadlocal`, which Mach-O refuses; this
// scratch word is the per-task home, strictly stronger than a per-worker slot
// because it survives task migration. Read/written only by `runtime/root`'s slot
// pins.
export const scrErr: int = 7
export const scrNodes: int = 8

// The two index arrays select needs, past the waiter nodes: `scrOrder` holds
// the case indices sorted by channel address (the lock order) and `scrShuffled`
// holds them in the random order the poll runs in. They are separate because the
// two orders are answers to different questions — see `chanSelect`.
export const scrOrder: int = 200
export const scrShuffled: int = 232

// The `ok` of the most recent `bit_rt_chan_recv` on this task, read by
// `bit_rt_root_chan_recv_ok` (ABI.md §11, SEAM 4/#1577). Codegen emits recv
// immediately followed by recv_ok with no yield between, so a per-task slot is
// goroutine-correct — the same adjacency the seed's `@threadlocal` relied on.
// Kept DISTINCT from `scrOk` (word 6): that word is the blocking-rendezvous
// outcome the waker writes, this one is the value the ABI wrapper (#1581)
// publishes after every receive, buffered fast path included. A closed
// ref-channel's zero word is a NULL pointer, so this flag is what lets a
// receiver tell "closed" from a real value — it must not alias a slot another
// operation can clobber.
export const scrRecvOk: int = 264

// The scratch area of the task at `task`. PINNED (ABI.md §9): both
// `runtime/root`'s SEAM-4 slot pins and `runtime/chan`'s operations call it
// across a module boundary, so freestanding emit needs a stable symbol rather
// than the module-mangled name (#1612). `bit_rt_port_` is temporary (#1369
// renames); it is NOT an ABI name, so no rename collides it with an RtFn target.
//
// `@nosplit` is not optional: its callers (a fallible call's `get_err`, a
// receive's `recv_ok`) rely on no safepoint firing between the operation and the
// slot read, and a `@nosplit` body may only call `@nosplit` functions.
export @nosplit @symbol("bit_rt_port_sched_scratch_of") function scratchOf(task: int): *i64 {
  let base = *(taskAt(task) + taskStackBase)
  return taskAt(base)
}
