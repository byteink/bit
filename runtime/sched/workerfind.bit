// Work discovery for the M:N scheduler — moved verbatim out of `worker.bit`
// (#4322), which was 791 lines against the hard 800-line E0200 ceiling.
//
// The worker and scheduler word-block layouts (`wk*`, `sc*`), the all-live-
// tasks registry and the deadlock check stay in `worker.bit`; every constant
// used here is declared there and read through the module, not re-declared.
// Read `worker.bit`'s header first.
//
// One module with `sched.bit`, `queue.bit`, `timer.bit`, `idle.bit` and the
// rest of `runtime/sched/`, so `worker.bit`'s imports already cover every
// name used here — re-importing one would be E0042.
// ---------------------------------------------------------------------------
// Work discovery
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `findWork`, with its order of preference unchanged, because the
// order IS the policy: local queue first (warm, uncontended), then the global
// overflow queue (oldest spilled work, so nothing starves), then one bounded
// pass stealing from every other worker.
//
// THE TIMER AND NETPOLLER PROBES ARE NOT IN THIS FUNCTION — they are in
// `schedFindWorkIdle` below, which wraps it. The split is forced, not stylistic:
// both probes need platform code reached through a function value, and a call
// through a value is E0075 in a `@nosplit` body. Keeping this half `@nosplit`
// leaves the hot path (the three queue probes, which is what runs when there IS
// work) free of safepoints and callable from `@nosplit` callers, and confines
// the non-`@nosplit` part to the idle tail — which is exactly where `runtime/sched/`
// puts it too.
// PINNED (ABI.md §9) since #3260: `runtime/root/<os>`'s idle spin calls this
// directly — it is the `@nosplit` half, so a spinning worker takes no safepoint
// poll while holding a raw task address — and that module emits
// `--freestanding`, where an un-pinned callee is a mangled name no archive
// member defines.
export @nosplit @symbol("bit_rt_port_sched_find_work") fn schedFindWork(w: *i64): int {
  let local = dqPopBottom(w + wkDeque)
  if (local != 0) {
    return local
  }
  // THIS WORKER'S OWN NEXT-RUN SLOT (#3264), and its position is load-bearing:
  // after the ring, before the global queue. See `rnTake`'s header — ahead of
  // the ring an unbroken chain of wakes starves a task the ring already holds,
  // which at `BIT_WORKERS=1` no thief can rescue; here the slot inherits exactly
  // the global queue's existing starvation properties and adds no new class.
  // Only the OWNER reaches it from this path, so nothing here is a steal.
  let next = rnTake(w)
  if (next != 0) {
    return next
  }
  let s = taskAt(*(w + wkSched))
  let spilled = gqPop(s + scGlobal)
  if (spilled != 0) {
    return spilled
  }

  // One bounded pass over the worker array (Power of 10: the trip count is the
  // worker count, which `threadMaxWorkers` caps at 1024).
  let n = atomicLoad(s + scNWorkers)
  let me = *(w + wkId)
  let i = 0
  while (i < n) {
    if (i != me) {
      let stolen = dqSteal(schedWorkerAt(s, i) + wkDeque)
      if (stolen != 0) {
        return stolen
      }
    }
    i = i + 1
  }
  return 0
}

// COULD `schedFindWork` FIND ANYTHING RIGHT NOW? A read-only answer: three
// kinds of plain load, no lock, no CAS, no syscall (#3260).
//
// This exists for the idle spin in `runtime/root/<os>`'s `workerBody`, which
// retries find-work a bounded number of times before parking. Retrying the real
// thing is what makes that spin expensive rather than free: every pass takes the
// global queue's spinlock (`gqPop`) and the timer lock (`schedTimerExpire`) and
// CASes each peer's deque head (`dqSteal`) — three exclusive-access operations
// on lines the worker that HAS the work needs. Measured on the 640k-acquisition
// contended-`Mutex` repro, a spin that called `schedFindWorkAt` directly moved
// wall clock at four workers the WRONG way, 0.26s to 0.45s, while sys time fell
// as designed: the syscalls went and cache-line contention replaced them.
//
// Same order as `schedFindWork` so the answer means what the name says, and it
// deliberately does NOT probe timers or the poller: this is the fast negative
// for a spin of a few microseconds, and both of those are driven by the outer
// idle turn, which is unchanged.
//
// PINNED (ABI.md §9) because `runtime/root/<os>` calls it and that module emits
// `--freestanding`: an unpinned callee left as a real call there is a mangled
// name no archive member defines (see `sleep.bit`'s `lockOf` note).
export @nosplit @symbol("bit_rt_port_sched_work_pending") fn schedWorkPending(w: *i64): bool {
  if (dqNonEmpty(w + wkDeque)) {
    return true
  }
  // This worker's own next-run slot (#3264), for the same reason every other
  // probe here is present: the answer must be exactly "could `schedFindWork`
  // return something", and that path takes this slot. A PEER's slot is
  // deliberately NOT probed — `schedFindWork` cannot take one, so reporting it
  // would send the spin into find-work passes that provably come back 0.
  if (rnNonEmpty(w)) {
    return true
  }
  let s = taskAt(*(w + wkSched))
  if (gqNonEmpty(s + scGlobal)) {
    return true
  }
  // The same bounded pass over the worker array `schedFindWork` makes, minus the
  // steal itself (Power of 10: the trip count is the worker count).
  let n = atomicLoad(s + scNWorkers)
  let me = *(w + wkId)
  let i = 0
  while (i < n) {
    if (i != me && dqNonEmpty(schedWorkerAt(s, i) + wkDeque)) {
      return true
    }
    i = i + 1
  }
  return false
}

// `runtime/sched/`'s `findWork` IN FULL: the three queue probes above, then the two
// idle probes — due sleepers first (an expired timer is work), then the poller.
// Both drain onto the global queue rather than returning a task directly, so
// each probe is followed by a global pop:
//
//     if (self.sched.timers.expire(self.sched, monoNs()) > 0) {
//         if (self.sched.global.pop()) |t| return t;
//     }
//     if (self.sched.poller.pollReady(self.sched, 0) > 0) {
//         if (self.sched.global.pop()) |t| return t;
//     }
//
// ORDER IS POLICY, so it is preserved: timers before the poller, and both after
// stealing. A woken timer is already-owed work, and running it before polling
// for new I/O is what stops a busy fd from starving a sleeper.
//
// THE POLLER TIMEOUT IS 0 — a non-blocking drain.
// That is worth stating because it is what makes the poller safe for the
// collector: this thread never blocks in `epoll_wait`/`kevent`, so it is never
// stuck in a syscall where it is neither `running` nor `parked` and cannot
// answer a stop-the-world rendezvous. All the waiting is done by the idle
// backoff below, on the loop's own terms, with a safepoint at every back edge.
//
// THE PLATFORM SEAM. `nowFn` is a monotonic clock in nanoseconds
// (`runtime/park`'s `parkMonoNs`); `pollFn(schedAddr, timeoutMs)` drains ready
// I/O events and returns how many tasks it unparked (`runtime/sched/<os>`'s
// `pollDrain`). Both are taken as function VALUES rather than imported, because
// this file must import neither provider — the same shape, and the same reason,
// as `runtime/thread`'s `threadJoin`. A consumer with no I/O still passes
// `pollDrain`: it returns 0 immediately when no poller was created.
fn schedFindWorkIdle(w: *i64, nowFn: () => int,
                           pollFn: (int, int) => int): int {
  let addr = schedFindWork(w)
  if (addr != 0) {
    return addr
  }
  let s = taskAt(*(w + wkSched))
  let now = nowFn()
  // Channel timers (#2665): a fired entry can wake a receiver task, which
  // needs the same unconditional `gqPop` retry `schedTimerExpire` gets below.
  schedTimerChanExpire(now)
  let chanWoken = gqPop(s + scGlobal)
  if (chanWoken != 0) {
    return chanWoken
  }
  if (schedTimerExpire(s, now) > 0) {
    let t = gqPop(s + scGlobal)
    if (t != 0) {
      return t
    }
  }
  if (pollFn(int(s), 0) > 0) {
    let t = gqPop(s + scGlobal)
    if (t != 0) {
      return t
    }
  }
  return 0
}

// `schedFindWorkIdle` with the POLLER seam folded out but the CLOCK still a
// parameter: the timer probe runs against the `now` the caller read, and no poll
// happens at all. Behaviourally identical to `schedFindWorkIdle(w, <that clock>,
// schedNoPoller)`.
//
// Written out instead of passing the pair because a function VALUE is a heap cell
// (§11.10) and the runtime's own boot module must emit `--freestanding` (§17.6)
// — see `schedWorkerStepNow`, its only caller.
//
// THE CLOCK USED TO BE FOLDED OUT TOO, AND THAT WAS #1648. The timer probe read
// `schedTimerExpire(s, 0)` — `schedNoTimers` — because the boot path was
// described as the "no-timer/no-poller configuration". But it DOES use timers:
// `runtime/root/<os>`'s `bit_rt_time_sleep_ns` parks the calling task on
// `schedSleepUntil` with a deadline of `parkMonoNs() + ns`, which is a large
// positive number and therefore never `<= 0`. Against a Bit-sourced `libbitrt.a`
// a three-line `println/sleep(30ms)/println` printed its first line and hung
// forever: the only task in the process was on the timer list, and the only
// worker asked "is anything due at time 0?" a billion times. The clock is a
// parameter here so that this cannot be reintroduced by folding a seam away —
// there is no longer any find-work path in this file that invents a time.
//
// PINNED AND EXPORTED because it is only HALF of `schedFindWorkIdle` — the
// poller probe is missing, by construction: a drain is platform code this module
// may not import (see `schedFindWorkIdle`'s "THE PLATFORM SEAM"). A caller that
// does drive I/O composes the other half itself, `pollDrain` then
// `schedGlobalPop`, and hands the result to `schedWorkerStepAt`. That is the
// shape ../root/<os>'s `workerBody` uses, and #1673 is what happens without it:
// the boot path drove `schedWorkerStepNow`, which never polls, so a task parked
// on the netpoller had no thread that could ever wake it.
//
// THIS IS THE REAL PRODUCTION IDLE PATH (#2530): every ordinary compiled Bit
// program reaches this function on every idle turn of `runtime/root/<os>`'s
// `workerBody`, which is why `schedCheckDeadlock` is wired in here rather than
// into `schedFindWorkIdle` above — that seam is `schedWorkerRun`'s, and
// `schedWorkerRun`'s only in-tree drivers are `_tests_/stress/sched*` programs
// that embed a PRIVATE scheduler and coordinate with it from outside the
// worker pool (see `schedWorkerRun`'s own header: "six of nine call sites"
// call it directly from a boot thread that then pushes work in from the
// side) — exactly the shape a queue/timer/poll-only check cannot see through,
// so it stays unchecked there rather than guessed at.
export @symbol("bit_rt_port_sched_find_work_at") fn schedFindWorkAt(w: *i64, now: int): int {
  let addr = schedFindWork(w)
  if (addr != 0) {
    return addr
  }
  let s = taskAt(*(w + wkSched))
  // Channel timers (#2665): see `schedFindWorkIdle`'s identical call.
  schedTimerChanExpire(now)
  let chanWoken = gqPop(s + scGlobal)
  if (chanWoken != 0) {
    return chanWoken
  }
  if (schedTimerExpire(s, now) > 0) {
    let t = gqPop(s + scGlobal)
    if (t != 0) {
      return t
    }
  }
  // THE NEXT-RUN SLOT'S SAFETY VALVE (#3264), and it is here — the slow idle
  // turn — rather than in `schedFindWork` on purpose. A peer's slot holds a task
  // its owner will run the moment it stops running the current one, so competing
  // for it is the migration this ticket removes; but an owner that keeps running
  // for a long time (a CPU-bound body, an unbracketed blocking syscall) would
  // otherwise make a peer wait on it while cores sit idle. Reaching it only from
  // here bounds that: this runs once per idle turn, never inside `spinForWork`'s
  // burst, and worker 0 never parks, so an occupied slot is picked up within one
  // `parkMaxBackoffNs` at worst. LAST, after the timer probe, because an expired
  // timer is already-owed work.
  let stolen = schedStealRunNext(w, s)
  if (stolen != 0) {
    return stolen
  }
  schedCheckDeadlock(s)
  return 0
}

// One bounded pass over the worker array, taking the first occupied next-run
// slot that is not this worker's own (Power of 10: the trip count is the worker
// count, which `threadMaxWorkers` caps at 1024). Own slot excluded because
// `schedFindWork` has already emptied it on the path that reaches here.
//
// Cannot disturb `schedCheckDeadlock` below it: at `nworkers == 1` this
// loop's only candidate index is the caller's own and it returns 0 without
// touching a word; above one worker, `schedCheckDeadlockPool`
// (`./deadlockpool.bit`) re-checks every peer's run-next slot itself, so a
// steal here — which only succeeds by taking real work away — can never be
// mistaken for a slot this loop silently missed.
@nosplit fn schedStealRunNext(w: *i64, s: *i64): int {
  let n = atomicLoad(s + scNWorkers)
  let me = *(w + wkId)
  let i = 0
  while (i < n) {
    if (i != me) {
      let t = rnTake(schedWorkerAt(s, i))
      if (t != 0) {
        return t
      }
    }
    i = i + 1
  }
  return 0
}
