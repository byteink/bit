// Green-thread scheduling core: the context switch, a task's saved register
// context, and the two run queues a worker pool draws from.
//
// Stage-2 port of `runtime/sched.zig` (#1364). Both exist during the port;
// #1367/#1369 retire the Zig original.
//
// ---------------------------------------------------------------------------
// THE CONTEXT SWITCH IS SHAPED DIFFERENTLY HERE, AND THE REASON IS FORCED
// ---------------------------------------------------------------------------
//
// `sched.zig`'s switch saves only `sp`/`fp`/`pc` and declares every other GPR
// CLOBBERED, letting LLVM spill and reload the callee-saved registers around
// the block. It can do that because it is an `inline fn`: the asm lands in the
// caller's body, so the caller's allocator sees the clobber and spills to the
// caller's own frame — which `sp` restores on resume.
//
// Bit's `asm` has different semantics, stated in SPEC §11.6: a register named
// by `input`/`result`/`clobber` is "excluded from the register allocator for
// the whole enclosing function". EXCLUDED, not spilled. So a clobber list here
// does not cause the enclosing function to save anything — it merely stops that
// function from using the register, which means the CALLER's live value sits
// in it untouched and the switch would hand it to the resumed side. Clobbering
// is therefore not a substitute for saving, the way it is under LLVM.
//
// Nor can this be an inlined switch: Bit has no inline functions, and a
// per-call-site copy of a hand-encoded block is exactly the duplication that
// makes a hand-encoded block dangerous.
//
// So `schedSwitch` saves and restores the callee-saved file EXPLICITLY, which
// is what every standalone (non-compiler-assisted) context switch does —
// Boost.Context, Go's `gogo`, musl's `swapcontext`. The register sets are taken
// from this compiler's own backends, not from the ABI documents, because it is
// this compiler's allocation that must survive:
//
//   arm64  x19..x28 (`isCalleeSavedInt`), d8..d15 (`isCalleeSavedFloat`),
//          x29 (frame), x30 (link), sp
//   x64    rbx, r12..r15, rbp (frame), rsp; the return address lives on the
//          stack, so there is no link register to save
//
// See seed/codegen/arm64.zig `isCalleeSavedInt`/`isCalleeSavedFloat` and
// seed/codegen/x64.zig's equivalents.
//
// ---------------------------------------------------------------------------
// THE x18 TRAP, AND WHY IT DOES NOT REACH THIS PORT
// ---------------------------------------------------------------------------
//
// `sched.zig` must clobber `x18` on Linux and must NOT on Darwin. AArch64 calls
// x18 the platform register: Darwin reserves it, Linux leaves it
// general-purpose, so LLVM will park a live value there across the block on
// Linux only. A task that parks on one worker and resumes on another whose x18
// differs then faults on the first use — invisible on macOS, corrupting on
// Linux. That bug has already cost this project once.
//
// It cannot arise here, and the reason is structural rather than lucky: this
// compiler's arm64 backend never allocates x18 at all. `master_gprs`
// (seed/codegen/arm64.zig) is x0..x8, x12..x15, x19..x28 — x18 is absent from
// the allocatable file on every target, so no Bit value can ever live in it,
// so there is nothing for a switch to preserve or destroy. The Zig needed a
// clobber because LLVM's allocatable set includes x18; this backend's does not.
//
// This is an argument from the backend's register file, so it is only as good
// as that file. If `master_gprs` ever gains x18, this switch must gain a save
// slot for it in the same change. The comment is the guard; the register list
// above is the thing to re-read.
//
// ---------------------------------------------------------------------------
// DELIBERATE DEVIATIONS FROM THE ZIG, ALL DISCLOSED
// ---------------------------------------------------------------------------
//
// 1. Callee-saved registers are saved explicitly rather than via clobbers.
//    Forced by §11.6's exclusion semantics (above). Behaviourally identical:
//    both preserve the caller's live state across the switch.
//
// 2. d8..d15 ARE preserved here; `sched.zig`'s clobber list names no FP
//    register at all. That is a latent hazard in the original — this backend
//    allocates d8..d15 as callee-saved (`isCalleeSavedFloat`), so a task
//    holding a live float across a park would have it destroyed. Preserving
//    strictly MORE state than the original cannot change queue discipline,
//    ordering, or liveness; it only removes a corruption. Called out because
//    "behavioural equivalence" is the rule and this is the one place this port
//    is a superset.
//
//    THIS HALF IS NOT COVERED BY tests/stress/sched, and the gap is a
//    notational one rather than an oversight. The test pins register
//    preservation by writing sentinels into named physical registers and
//    reserving them against the allocator with a `clobber` list — but §11.6
//    admits only `x0`..`x30`, `sp` and `xzr` there, with no spelling for `d8`.
//    So an FP sentinel cannot be protected from the allocator, and a check
//    built on one would report the allocator's choices rather than the
//    switch's. Mutating the d8 slot away is confirmed NOT to fail the suite.
//    The 16 FP instructions are therefore carried on the strength of the
//    encoding review (disassembled and read back) alone, which is weaker
//    evidence than the rest of this file rests on. Treat them accordingly: the
//    integer file is proven, the FP file is argued.
//
// 3. Atomics are sequentially consistent throughout, because §11.5 exposes no
//    weaker ordering. The Zig mixes `.acquire`/`.release`/`.monotonic`. SC is
//    strictly stronger than every ordering it replaces, so every
//    happens-before the Zig relies on still holds.
//
// ---------------------------------------------------------------------------
// MEMORY MODEL: EVERY STRUCTURE HERE IS CALLER-OWNED
// ---------------------------------------------------------------------------
//
// A task control block, a deque and a global queue are each a WORD-INDEXED
// BLOCK the caller supplies as a `*i64`, exactly as `runtime/alloc` and
// `runtime/gc` take their arenas. Nothing here allocates, and none of this
// memory may live on the GC heap: a `Task` holds a raw stack address with no
// `GcHeader`, so tracing it would decode arbitrary bytes as an object header
// (§11.11 makes the same argument for module state).
//
// It also keeps this file platform-free. Mapping a guarded stack is a syscall
// on Linux and a libSystem call on Darwin, and §11.7/§11.8 reject even an
// uncalled declaration of the wrong one, so the core cannot contain either.
// The consumer maps the memory and hands it over — the same handoff
// `gc/mem.bit` settled on.

import { spinAcquire, spinRelease } from "../"
// `runtime/park`'s CORE only — it holds the backoff policy and no platform code,
// so importing it does not breach the rule that this file imports neither
// provider. `runtime/thread` depends on it the same way and for the same reason.
import { parkMinBackoffNs, parkNextBackoff } from "../park"

// ---------------------------------------------------------------------------
// Saved register context
// ---------------------------------------------------------------------------

// Words in a saved context. The layout is shared by both architectures; each
// uses the prefix it needs, so one `Task` block shape compiles for either.
//
//   0        stack pointer
//   1        resume address
//   2        frame register   (x29 / rbp)
//   3        link register    (x30) / rbx on x64
//   4..13    x19..x28         (x64 uses 4..7 for r12..r15)
//   14..21   d8..d15          (arm64 only)
export const ctxWords: int = 22

export const ctxSp: int = 0
export const ctxPc: int = 1

const stackAlign: int = 16

// The entry-time stack-pointer bias, in bytes, for the architecture being
// compiled: 8 on x86-64, 0 on AArch64.
//
// The two disagree and there is no way to split the difference. x86-64 enters a
// function as though `call` had just pushed an 8-byte return address, so it
// requires `rsp % 16 == 8`; AAPCS64 requires `sp % 16 == 0` and enforces it in
// hardware — a misaligned `sp` faults on the first push. Biasing both alike
// SIGBUSes on arm64, which is exactly how this was found.
//
// The value is read out of a one-instruction `asm` block rather than from
// `hostTarget()` (§11.8) because `hostTarget` lowers to an out-of-line runtime
// call, which a `@nosplit` body may not make. A single immediate move is inline
// by construction, so it is legal in the nosplit callers below, and the
// distinction it draws is architectural rather than per-target: the same answer
// serves x86_64-linux, and both aarch64 targets share the other.
@nosplit function entryBias(): int {
  return asm {
    arm64 { 0xD2800000 }                    // mov x0, #0
    x64   { 0xB8, 0x08, 0x00, 0x00, 0x00 }  // mov eax, 8
    result arm64 x0 x64 rax : int
  }
}

// Save the caller's callee-saved state into the context at `old`, restore the
// context at `new`, and resume there. Returns when some later switch names this
// context as its `new`.
//
// `volatile` is not spelled because §11.6 guarantees an `asm` block is never
// dropped, hoisted or deduplicated regardless.
//
// `@nosplit` (§10.3.1) for two reasons, both load-bearing. A safepoint must
// never land inside a half-saved context — the collector would read a task's
// registers from a slot the switch has not written yet. And a task body that is
// itself `@nosplit` (because the collector does not yet know its stack) can only
// call other `@nosplit` functions, so an ordinary switch would be unreachable
// from exactly the code that needs it. The block qualifies on the same proof as
// the atomics: it is a fixed inline sequence that neither allocates nor calls.
//
// The arm64 `adr` displacement (+184 bytes = 46 words) is the distance from the
// `adr` to the first word past `br`, hand-computed per §11.6 since there are no
// block-local labels. The x64 `lea` displacement (+64) is measured from the end
// of the `lea`. BOTH ARE POSITION-DEPENDENT ON THE INSTRUCTION COUNT: inserting
// or removing any instruction in either block invalidates them silently — the
// program branches into the middle of the block instead of resuming. There is
// no check for this; tests/stress/sched is what catches it.
export @nosplit function schedSwitch(old: *i64, new: *i64) {
  asm {
    arm64 {
      0x910003E2,                                     // mov x2, sp
      0xF9000002,                                     // str x2, [x0, #0]
      0x100005C2,                                     // adr x2, +184 (resume)
      0xF9000402,                                     // str x2, [x0, #8]
      0xF900081D, 0xF9000C1E,                         // str x29, x30
      0xF9001013, 0xF9001414, 0xF9001815, 0xF9001C16, // str x19..x22
      0xF9002017, 0xF9002418, 0xF9002819, 0xF9002C1A, // str x23..x26
      0xF900301B, 0xF900341C,                         // str x27, x28
      0xFD003808, 0xFD003C09, 0xFD00400A, 0xFD00440B, // str d8..d11
      0xFD00480C, 0xFD004C0D, 0xFD00500E, 0xFD00540F, // str d12..d15
      0xF9400022,                                     // ldr x2, [x1, #0]   sp
      0xF9400423,                                     // ldr x3, [x1, #8]   pc
      0xF940083D, 0xF9400C3E,                         // ldr x29, x30
      0xF9401033, 0xF9401434, 0xF9401835, 0xF9401C36, // ldr x19..x22
      0xF9402037, 0xF9402438, 0xF9402839, 0xF9402C3A, // ldr x23..x26
      0xF940303B, 0xF940343C,                         // ldr x27, x28
      0xFD403828, 0xFD403C29, 0xFD40402A, 0xFD40442B, // ldr d8..d11
      0xFD40482C, 0xFD404C2D, 0xFD40502E, 0xFD40542F, // ldr d12..d15
      0x9100005F,                                     // mov sp, x2
      0xD61F0060                                      // br x3
    }
    x64 {
      0x48, 0x8D, 0x05, 0x40, 0x00, 0x00, 0x00,       // lea rax, [rip+64]
      0x48, 0x89, 0x47, 0x08,                         // mov [rdi+8], rax
      0x48, 0x89, 0x27,                               // mov [rdi+0], rsp
      0x48, 0x89, 0x6F, 0x10,                         // mov [rdi+16], rbp
      0x48, 0x89, 0x5F, 0x18,                         // mov [rdi+24], rbx
      0x4C, 0x89, 0x67, 0x20,                         // mov [rdi+32], r12
      0x4C, 0x89, 0x6F, 0x28,                         // mov [rdi+40], r13
      0x4C, 0x89, 0x77, 0x30,                         // mov [rdi+48], r14
      0x4C, 0x89, 0x7F, 0x38,                         // mov [rdi+56], r15
      0x48, 0x8B, 0x26,                               // mov rsp, [rsi+0]
      0x48, 0x8B, 0x6E, 0x10,                         // mov rbp, [rsi+16]
      0x48, 0x8B, 0x5E, 0x18,                         // mov rbx, [rsi+24]
      0x4C, 0x8B, 0x66, 0x20,                         // mov r12, [rsi+32]
      0x4C, 0x8B, 0x6E, 0x28,                         // mov r13, [rsi+40]
      0x4C, 0x8B, 0x76, 0x30,                         // mov r14, [rsi+48]
      0x4C, 0x8B, 0x7E, 0x38,                         // mov r15, [rsi+56]
      0x48, 0x8B, 0x46, 0x08,                         // mov rax, [rsi+8]
      0xFF, 0xE0                                      // jmp rax
    }
    input arm64 x0 x64 rdi = old
    input arm64 x1 x64 rsi = new
    clobber arm64 { x2, x3, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x30, memory }
    clobber x64 { rax, rbx, r12, r13, r14, r15, memory }
  }
}

// Round `addr` DOWN to the arch's entry-time stack alignment.
//
// Rounding down rather than up is deliberate: a stack grows downward from its
// top, so the aligned top must stay inside the mapping. Rounding up would place
// the first push above the last mapped byte — on a guarded mapping that is a
// fault on the first call the task makes, and on an unguarded one it is silent
// corruption of whatever follows.
@nosplit function alignDown(addr: int): int {
  return addr - addr % stackAlign
}

// Build a fresh task's context at `ctx`, entering `entry` on a stack whose
// highest usable address is `stackTop`.
//
// `entry` comes from `entryOf(f)` (§11.10) — a named function's code entry.
// This is the call the whole task could not be constructed without, and the
// reason #1364 sat blocked: `int(f)` yields the closure OBJECT's heap address,
// which differs on every run, so a context built from it branches into the heap.
//
// The entered function is reached by a plain branch, never a call, so it takes
// no arguments and MUST NOT RETURN — there is no return address for it to
// return through (the link register is left 0 on arm64, and the x64 word at the
// initial `sp` is uninitialized stack). It recovers what to run from scheduler
// state and switches away when finished.
export @nosplit function schedTaskContext(ctx: *i64, stackTop: int, entry: *byte) {
  *(ctx + ctxSp) = alignDown(stackTop) - entryBias()
  *(ctx + ctxPc) = int(entry)
  let i = 2
  while (i < ctxWords) {
    *(ctx + i) = 0
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// Per-worker run queue: a bounded work-stealing ring
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `Deque`, unchanged in discipline: the owner appends at `tail`;
// the owner's pop and every other worker's steal contend for `head` by CAS, so
// both take from the OLDEST end and a task is handed to exactly one taker. Go's
// runtime shape, and simpler to prove correct than a full Chase-Lev deque at
// the cost of one uncontended CAS on the owner's pop.
//
// Capacity is fixed and a power of two so the ring index is a mask. Overflow is
// NOT an error: `dqPushBottom` reports false and the caller spills to the
// global queue, which is why capacity need not be provably sufficient.
//
// Block layout, word-indexed:
//   0            head   (monotonic; masked to index)
//   1            tail   (monotonic; masked to index)
//   2 .. 2+cap-1 ring of task addresses
export const dqCapacity: int = 256
const dqMask: int = 255
export const dqWords: int = 258

const dqHead: int = 0
const dqTail: int = 1
const dqBuf: int = 2

// `@nosplit` throughout: these run on the scheduling hot path and inside the
// idle loop, where an allocation or a safepoint would collect against a worker
// mid-handoff. §10.3 forbids INDEXING in a `@nosplit` body (E0075), which is
// why the ring is reached by base-pointer arithmetic and deref rather than
// `buf[i]` — the same shape `runtime/gc` uses for its own tables.
export @nosplit function dqInit(q: *i64) {
  atomicStore(q + dqHead, 0)
  atomicStore(q + dqTail, 0)
}

// Owner-only. False if the ring is full; the caller must then spill to the
// global queue.
export @nosplit function dqPushBottom(q: *i64, task: int): bool {
  let h = atomicLoad(q + dqHead)
  let t = atomicLoad(q + dqTail)
  if (t - h >= dqCapacity) {
    return false
  }
  *(q + dqBuf + t % dqCapacity) = task
  atomicStore(q + dqTail, t + 1)
  return true
}

// Owner-only pop; contends with `dqSteal` on `head`.
//
// The retry loop is bounded by `dqCapacity`, not left open. A CAS loop that
// only exits on success has no statically provable limit (Power of 10), and the
// bound is sound: every losing iteration means some other worker won a steal,
// and at most `dqCapacity` tasks can be stolen from a ring that holds at most
// that many. Exhausting the bound therefore means the ring was drained by
// others, and reporting empty is the correct answer, not a lost task.
export @nosplit function dqPopBottom(q: *i64): int {
  let n = 0
  while (n <= dqCapacity) {
    let h = atomicLoad(q + dqHead)
    let t = atomicLoad(q + dqTail)
    if (h == t) {
      return 0
    }
    let task = *(q + dqBuf + h % dqCapacity)
    if (atomicCmpxchg(q + dqHead, h, h + 1)) {
      return task
    }
    n = n + 1
  }
  return 0
}

// Callable from any other worker. Identical to `dqPopBottom` — both take from
// `head` — and kept as its own name because the CONTRACT differs: this one is
// safe to call on a queue this thread does not own, which is the property a
// work-stealing loop depends on.
export @nosplit function dqSteal(q: *i64): int {
  return dqPopBottom(q)
}

// ---------------------------------------------------------------------------
// Global overflow queue
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `GlobalQueue`: an intrusive FIFO under a spinlock, holding
// spilled local pushes, tasks unparked from another thread, and tasks the
// netpoller woke — everything whose target worker is unknown, or whose waker
// is not a worker at all.
//
// FIFO order is part of the discipline, not an accident: it is what stops a
// task that repeatedly overflows a local ring from being starved behind
// newer work.
//
// Block layout, word-indexed:
//   0  head task address (0 when empty)
//   1  tail task address
//   2  lock word — an i32 cell, addressed as such (see `lockOf`)
export const gqWords: int = 3

const gqHead: int = 0
const gqTail: int = 1
const gqLock: int = 2

// The lock word of a queue block, as the `*i32` `runtime/spinlock` requires.
//
// `spinlock.bit` fixed on i32 because §11.5 needs an integer prim and 32 bits
// is the conventional lock width. These blocks are word-indexed `*i64`, so the
// cell has to be re-addressed at its own width: a `*i32` scales by 4, so the
// byte address divided by 4 off the null pointer names the same cell. This is
// §11.4's stated inverse of pointer arithmetic, and the low half of the word is
// the one the spinlock touches on both targets (both are little-endian).
@nosplit function lockOf(q: *i64, slot: int): *i32 {
  let z: *i32 = nil
  return z + int(q + slot) / 4
}

export @nosplit function gqInit(q: *i64) {
  *(q + gqHead) = 0
  *(q + gqTail) = 0
  atomicStore(lockOf(q, gqLock), 0)
}

// Link `task` on at the tail. `taskNext` of `task` is cleared first, so a task
// carrying a stale link from a previous queue cannot splice foreign tasks in.
export @nosplit function gqPush(q: *i64, task: int) {
  let t: *i64 = nil
  let node = t + task / 8
  *(node + taskNext) = 0
  spinAcquire(lockOf(q, gqLock))
  let tail = *(q + gqTail)
  if (tail == 0) {
    *(q + gqHead) = task
  } else {
    let tailNode = t + tail / 8
    *(tailNode + taskNext) = task
  }
  *(q + gqTail) = task
  spinRelease(lockOf(q, gqLock))
}

// Unlink and return the head task address, or 0 when empty.
export @nosplit function gqPop(q: *i64): int {
  spinAcquire(lockOf(q, gqLock))
  let head = *(q + gqHead)
  if (head == 0) {
    spinRelease(lockOf(q, gqLock))
    return 0
  }
  let t: *i64 = nil
  let node = t + head / 8
  let next = *(node + taskNext)
  *(q + gqHead) = next
  if (next == 0) {
    *(q + gqTail) = 0
  }
  *(node + taskNext) = 0
  spinRelease(lockOf(q, gqLock))
  return head
}

// ---------------------------------------------------------------------------
// Task control block
// ---------------------------------------------------------------------------
//
// Word-indexed, laid out so the saved context occupies the prefix — a switch
// takes the task's base address unchanged, with no offset arithmetic on the
// hottest path in the runtime.
//
//   0..21  saved context
//   22     state
//   23     next        intrusive run-queue link (owned by the holding queue)
//   24     arg         opaque word handed to the task body
//   25     stackBase   lowest address of the whole mapping, for teardown
//   26     stackBytes  size of that mapping
//   27     worker      the worker currently running this task (0 when not running)
//   28     regNext     intrusive all-tasks registry links, owned by the
//   29     regPrev       scheduler's registry lock — NOT the run queues' `next`,
//                        because a task is on the registry for its whole life
//                        while simultaneously moving between run queues
//   30     timerNext   intrusive sleeping-task link and its wake deadline, owned
//   31     deadline      by the scheduler's timer lock. A THIRD link distinct
//                        from both `next` and `regNext` for the same reason they
//                        are distinct from each other: a sleeping task is on the
//                        timer list, on the registry, and on no run queue, all at
//                        once. `sched.zig`'s `timer_next`/`deadline_ns`.
//
// 30 and 31 were already inside `taskWords`, so adding timers did NOT grow the
// block — no caller's stack arithmetic moved.
export const taskWords: int = 32

export const taskState: int = 22
export const taskNext: int = 23
export const taskArg: int = 24
export const taskStackBase: int = 25
export const taskStackBytes: int = 26
export const taskWorker: int = 27
export const taskRegNext: int = 28
export const taskRegPrev: int = 29
export const taskTimerNext: int = 30
export const taskDeadline: int = 31

// Task states, matching `sched.zig`'s `TaskState` ordinals.
export const taskRunnable: int = 0
export const taskRunning: int = 1
export const taskParked: int = 2
export const taskDone: int = 3

// TWO STATES `sched.zig` DOES NOT HAVE, AND THEY EXIST BECAUSE THIS PORT CANNOT
// HAVE ITS `ParkFn` HOOK. See the "arming a park" section below for the whole
// argument; in one line: a Bit task must make itself findable BEFORE it parks,
// and these two states are the rendezvous that stops a wake landing in that
// window from being dropped.
//
// A NEW PATH ON PURPOSE. `schedPark`, `schedUnpark`, the timer queue and every
// channel operation continue to move a task only between the four states above —
// nothing that works today changes behaviour, and a task that never calls
// `schedParkArm` can never be in either of these. That containment is the reason
// to spend two ordinals rather than to rework `schedUnpark`.
export const taskParking: int = 4
export const taskWakePending: int = 5

// Prepare a task control block: build its entry context and clear its links.
//
// `stackBase`/`stackBytes` describe the mapping to release at teardown; the
// usable top is their sum, which is where the context starts. The caller owns
// that mapping — this module never maps or unmaps (see the header).
export @nosplit function schedTaskInit(task: *i64, stackBase: int, stackBytes: int,
                                       entry: *byte, arg: int) {
  schedTaskContext(task, stackBase + stackBytes, entry)
  *(task + taskState) = taskRunnable
  *(task + taskNext) = 0
  *(task + taskArg) = arg
  *(task + taskStackBase) = stackBase
  *(task + taskStackBytes) = stackBytes
  *(task + taskWorker) = 0
  *(task + taskRegNext) = 0
  *(task + taskRegPrev) = 0
  *(task + taskTimerNext) = 0
  *(task + taskDeadline) = 0

  // The self-pointer that makes `schedCurrentTask` O(1), and the tag that lets
  // it tell a task stack from any other stack — see its comment.
  *(taskAt(stackBase)) = int(task)
  *(taskAt(stackBase) + 1) = schedStackTag
}

// A task block at a raw address, as the queues hand it back.
//
// Also used for worker and scheduler blocks: all three are word-indexed blocks
// at a raw address and the conversion is the same arithmetic. Kept under one
// name rather than three aliases that would differ only in what they are called.
// PINNED (ABI.md §9): `runtime/chan` calls this across a module boundary. See
// `../gc/mem.bit` for why the pin is required and why `bit_rt_port_` is
// temporary (#1369 renames).
export @nosplit @symbol("bit_rt_port_sched_task_at") function taskAt(addr: int): *i64 {
  let z: *i64 = nil
  return z + addr / 8
}

// ---------------------------------------------------------------------------
// Finding the current task without thread-local storage
// ---------------------------------------------------------------------------
//
// `sched.zig` reaches the running task through `threadlocal var tls: ?*Worker`.
// THAT MECHANISM IS NOT AVAILABLE TO THIS PORT, and the reason is not effort:
//
//   - `@threadlocal` (§11.11) is implemented on ELF but REJECTED FOR MACH-O at
//     emission, because a Mach-O TLV access calls a resolver thunk instead of
//     doing arithmetic off a thread pointer. So it cannot carry a Darwin worker.
//   - A `pthread_getspecific` shim is an `extern function`, and reading the
//     thread pointer out of `TPIDRRO_EL0` needs a platform seam too (Linux and
//     Darwin use different system registers on the same architecture). Either
//     way `@nosplit` REJECTS BOTH an `extern` call and a `syscall` (E0075,
//     measured), and every function here must be `@nosplit` — see the run
//     loop's comment for why that is forced rather than chosen.
//
// So the task pointer is carried by the one piece of per-thread state that
// needs no operating-system help at all: THE RUNNING TASK'S OWN STACK. Every
// task stack is `schedStackBytes` bytes, aligned to that size, and its lowest
// usable word holds the address of the task that owns it. Masking the live
// stack pointer down to that boundary therefore names the current task in two
// arithmetic instructions, on every target, inside `@nosplit`, with no TLS, no
// syscall and no platform split.
//
// It is also robust in a way a thread-local is not: it is a property of the
// stack rather than of the OS thread, so a task that migrates to another worker
// carries it along automatically and there is no per-switch bookkeeping to
// forget. `sched.zig` has to re-fetch `Worker.current()` after `fn_ptr` returns
// precisely because its answer changes under migration; this one cannot go
// stale.
//
// THE COST IS AN ALIGNMENT CONTRACT, and it is on the caller who maps the
// stack: `schedTaskInit`'s `stackBase` MUST be a multiple of `schedStackBytes`.
// Nothing can check that at compile time, so `schedStackAligned` is provided to
// check it at run time and the mapping code is expected to use it. A misaligned
// stack does not fault — it silently resolves to the wrong task, which is why
// the check exists rather than a comment asking for care.
//
// 64KiB is `sched.zig`'s `stack_size` unchanged, so this is not a fresh choice.
export const schedStackBytes: int = 65536

// Written next to the self-pointer to mark a region as a TASK stack.
//
// Without it this scheme is unsound off a task, and not in a subtle way:
// `sched.zig`'s `Worker.tls` is simply null on a non-worker thread, but masking
// the stack pointer always yields SOME address, so a call from the boot thread
// or from a worker's own loop would read whatever that thread's stack happens to
// hold there and then dereference it as a task. `Scheduler.spawn` is documented
// callable from any thread, so that path is reachable by design rather than by
// misuse.
//
// Checking a tag makes the answer sound: both words live inside the caller's own
// live stack, so reading them is always safe, and a non-task stack matching a
// 64-bit constant at exactly the 64KiB boundary is not a case worth costing
// anything to exclude further. The value is arbitrary and deliberately not a
// plausible pointer, small integer, or ASCII run.
const schedStackTag: int = 0x5CED7A5C5CED7A5C

// Whether `base` satisfies the alignment contract above.
export @nosplit function schedStackAligned(base: int): bool {
  return base % schedStackBytes == 0
}

// The live stack pointer. One instruction, so it is inline by construction and
// legal in a `@nosplit` body.
//
// Reading `sp` inside a callee rather than at the use site is deliberate and
// safe: a callee's prologue only ever moves `sp` DOWN within the same stack, and
// the mask below discards everything below the 64KiB boundary, so the answer is
// the same whichever frame asks.
@nosplit function readSp(): int {
  return asm {
    arm64 { 0x910003E0 }              // mov x0, sp
    x64   { 0x48, 0x89, 0xE0 }        // mov rax, rsp
    result arm64 x0 x64 rax : int
  }
}

// The task running on this thread, or 0 when the caller is not on a task stack.
//
// The zero answer is what a worker's own loop gets, since a worker runs on the
// OS thread stack its `threadStart` mapped, not on a task stack. That word is
// whatever the thread stack happens to hold there, so callers must treat this
// as "ask only from task code" — which is exactly `sched.zig`'s contract for
// `Worker.current()` ("task code only ever runs on a worker OS thread").
// `let` then `return` rather than `return *(...)` throughout this file: a
// dereference is not accepted in return position today (E0021), only in `let`
// and assignment position. Filed on #1421; harmless, but it shapes every
// accessor here.
// The task owning the stack region based at `base`, or 0 if that region is not
// a task stack.
//
// Split out from `schedCurrentTask` so the tag check is REACHABLE BY A TEST.
// Driven only through `schedCurrentTask`, the check cannot be made to fail: a
// fresh thread stack reads 0 at its 64KiB boundary whether or not the tag is
// consulted, so a test asserting "0 off a task" passes even with the check
// deleted — measured, not assumed. Taking the base as a parameter lets a test
// point it at a region it has deliberately filled with garbage, which is the
// only way to tell a working check from an absent one.
export @nosplit @symbol("bit_rt_port_sched_task_on_stack") function schedTaskOnStack(base: int): int {
  let b = taskAt(base)
  let tag = *(b + 1)
  if (tag != schedStackTag) {
    return 0
  }
  let t = *b
  return t
}

export @nosplit @symbol("bit_rt_port_sched_current_task") function schedCurrentTask(): int {
  let sp = readSp()
  return schedTaskOnStack(sp - sp % schedStackBytes)
}

// The worker currently running the calling task. `sched.zig`'s `Worker.current()`.
export @nosplit function schedCurrentWorker(): int {
  let task = schedCurrentTask()
  if (task == 0) {
    return 0
  }
  let w = *(taskAt(task) + taskWorker)
  return w
}

// ---------------------------------------------------------------------------
// Worker: one OS thread running the scheduling loop
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `Worker`, as a caller-owned word-indexed block. The saved
// context occupies the prefix for the same reason a task's does — the switch
// takes the block address unchanged.
//
//   0..21    sched_ctx   this worker's own context while a task runs
//   22       id
//   23       running     the task currently switched-to, 0 between tasks
//   24       disposition how the running task last left the CPU
//   25       sched       the owning scheduler block's address
//   26..33   reserved
//   34..291  deque       this worker's local run queue (`dqWords`)
export const wkCtx: int = 0
export const wkId: int = 22
export const wkRunning: int = 23
export const wkDisposition: int = 24
export const wkSched: int = 25
export const wkDeque: int = 34
export const workerWords: int = 292

// ---------------------------------------------------------------------------
// Scheduler
// ---------------------------------------------------------------------------
//
//   0        nworkers
//   1        workers     base address of the worker array (stride `workerWords`)
//   2        stopping    set once by `schedShutdown`, polled by every worker
//   3        regHead     head of the all-live-tasks registry (ABI.md §5)
//   4        regLock     an i32 cell, addressed via `lockOf`
//   5        timerHead   head of the sleeping-task list (`TimerQueue` below)
//   6        timerLock   an i32 cell, addressed via `lockOf`
//   7        pollFd      the netpoller's epoll/kqueue descriptor, 0 when the
//                        consumer bound no poller (see the netpoller section)
//   8..10    global      the overflow queue (`gqWords`)
//   11..15   reserved
export const scNWorkers: int = 0
export const scWorkers: int = 1
export const scStopping: int = 2
export const scRegHead: int = 3
const scRegLock: int = 4
export const scTimerHead: int = 5
const scTimerLock: int = 6
export const scPollFd: int = 7
export const scGlobal: int = 8
const scPollLock: int = 11
export const schedWords: int = 16

// The worker block at index `i`.
export @nosplit function schedWorkerAt(s: *i64, i: int): *i64 {
  let base = *(s + scWorkers)
  return taskAt(base + i * workerWords * 8)
}

// Prepare a scheduler over `nworkers` caller-owned worker blocks laid out
// contiguously at `workersAddr`.
export @nosplit function schedInit(s: *i64, workersAddr: int, nworkers: int) {
  *(s + scNWorkers) = nworkers
  *(s + scWorkers) = workersAddr
  atomicStore(s + scStopping, 0)
  *(s + scRegHead) = 0
  atomicStore(lockOf(s, scRegLock), 0)
  *(s + scTimerHead) = 0
  atomicStore(lockOf(s, scTimerLock), 0)
  *(s + scPollFd) = 0
  gqInit(s + scGlobal)

  let i = 0
  while (i < nworkers) {
    let w = schedWorkerAt(s, i)
    *(w + wkId) = i
    *(w + wkRunning) = 0
    *(w + wkDisposition) = taskRunning
    *(w + wkSched) = int(s)
    dqInit(w + wkDeque)
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// The all-live-tasks registry (ABI.md §5)
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `registerTask`/`unregisterTask`: an intrusive doubly-linked
// list of every task from spawn until its `.done` teardown, so the collector
// can find every parked or runnable stack to scan. Distinct from the run
// queues' `next` link, because a task is on the registry for its whole life
// while simultaneously moving between queues.
export @nosplit function schedRegister(s: *i64, task: int) {
  let t = taskAt(task)
  spinAcquire(lockOf(s, scRegLock))
  let head = *(s + scRegHead)
  *(t + taskRegPrev) = 0
  *(t + taskRegNext) = head
  if (head != 0) {
    *(taskAt(head) + taskRegPrev) = task
  }
  *(s + scRegHead) = task
  spinRelease(lockOf(s, scRegLock))
}

export @nosplit function schedUnregister(s: *i64, task: int) {
  let t = taskAt(task)
  spinAcquire(lockOf(s, scRegLock))
  let prev = *(t + taskRegPrev)
  let next = *(t + taskRegNext)
  if (prev != 0) {
    *(taskAt(prev) + taskRegNext) = next
  } else {
    *(s + scRegHead) = next
  }
  if (next != 0) {
    *(taskAt(next) + taskRegPrev) = prev
  }
  *(t + taskRegPrev) = 0
  *(t + taskRegNext) = 0
  spinRelease(lockOf(s, scRegLock))
}

// Upper bound on a registry walk. `sched.zig`'s `max_registered_tasks`, which
// is a runaway-loop backstop rather than a real capacity — the scheduler caps
// concurrent OS threads, not green threads.
export const schedMaxRegistered: int = 16777216

// How many tasks are on the registry. The bounded walk `forEachOtherStack` and
// `forEachTaskArg` are built from; those two take a callback, which `@nosplit`
// cannot express (a call through a value is E0075), so the traversal is exposed
// as a cursor instead and the collector drives it. `schedRegHead` plus
// `schedRegNext` is that cursor.
export @nosplit function schedRegCount(s: *i64): int {
  spinAcquire(lockOf(s, scRegLock))
  let n = 0
  let it = *(s + scRegHead)
  while (it != 0 && n < schedMaxRegistered) {
    n = n + 1
    it = *(taskAt(it) + taskRegNext)
  }
  spinRelease(lockOf(s, scRegLock))
  return n
}

// ---------------------------------------------------------------------------
// Netpoller: the scheduler-side half
// ---------------------------------------------------------------------------
//
// The poller ITSELF is platform code and lives in `runtime/sched/{linux,darwin}`
// — epoll against kqueue is the least reconcilable split in the whole runtime,
// and §11.7/§11.8 reject even an uncalled declaration for the other platform.
// What stays here is the part that is the same on both: where the descriptor is
// kept, and the mutual exclusion around the poll call.
//
// WHY THE TRY-LOCK EXISTS — this is `sched.zig`'s `polling` flag, and it is not
// an optimisation. Every idle worker calls the drain from its own loop. Without
// exclusion two workers can sit inside `epoll_wait`/`kevent` on the same shared
// oneshot descriptor exactly as an fd becomes ready, and the kernel can report
// that one event to both before oneshot disarms it. Both then unpark the same
// task: the second delivery lands on a `Task` the first delivery's worker has
// already run to completion and freed — a use-after-free, not a double-wake.
//
// It is a TRY-lock, never a blocking one, and that is also the Zig's choice:
// losing the race costs nothing, because the loser has the rest of its idle
// pass to look for work and will poll on the next cycle anyway. A blocking lock
// here would park a worker behind a poll it does not need.
export @nosplit @symbol("bit_rt_port_sched_set_poll_fd") function schedSetPollFd(s: *i64, fd: int) {
  *(s + scPollFd) = fd
}

export @nosplit @symbol("bit_rt_port_sched_poll_try_enter") function schedPollTryEnter(s: *i64): bool {
  return atomicCmpxchg(s + scPollLock, 0, 1)
}

export @nosplit @symbol("bit_rt_port_sched_poll_leave") function schedPollLeave(s: *i64) {
  atomicStore(s + scPollLock, 0)
}

// Interest constants, shared by both providers so a caller names the same value
// whichever platform it is built for. The providers map these onto
// `EPOLLIN`/`EPOLLOUT` and `EVFILT_READ`/`EVFILT_WRITE`; the numbers here are
// this runtime's own, deliberately NOT either kernel's, so that neither
// provider's constants leak into a caller.
export const pollRead: int = 0
export const pollWrite: int = 1

// ---------------------------------------------------------------------------
// The timer queue
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `TimerQueue`: sleeping green threads waiting on a deadline.
//
// An UNSORTED intrusive list, which is the Zig's choice and is kept deliberately
// — `push` is O(1) and `expire` is one bounded pass. Sorting would only pay off
// with many sleepers AND frequent expiry checks, and the check runs solely on a
// worker's idle path, so the scan is cheaper than maintaining the order. The
// Zig records the same reasoning and the same upgrade path (a 4-ary heap) if a
// program ever holds enough concurrent sleepers for the scan to show in a
// profile. Porting the "better" structure would have been a behaviour change
// dressed as an improvement.
//
// THIS SECTION HOLDS NO CLOCK, AND THAT IS THE SEAM. `expire` takes `now` as a
// parameter exactly as `sched.zig`'s does; the caller reads the clock. A
// monotonic clock is `clock_gettime` — a `syscall` on Linux and an `extern` call
// on Darwin — and this file must contain neither (§11.7/§11.8 reject even an
// uncalled declaration for the other platform, and a module is a directory). So
// the whole timer queue is platform-free core, and `runtime/park`'s already
// shipped `parkMonoNs` is what the consumer passes in. Same shape as
// `runtime/thread`'s `threadJoin`, which takes its clock as a function value for
// this identical reason.

// Link `task` onto the sleeping list. Its `taskDeadline` must already be set.
//
// ORDERING CONTRACT — READ BEFORE MOVING THIS CALL. `sched.zig` links the task
// on from a `ParkFn`, i.e. on the worker's side of the switch, strictly AFTER
// the task's context has been saved. That hook is not expressible here: it is a
// call through a function value, which `@nosplit` rejects (E0075), and
// `schedPark` is `@nosplit`. So `schedSleepUntil` below links the task on
// BEFORE it parks, and the resulting window — a task on the timer list whose
// context is not yet saved — is closed on the OTHER side instead, in `expire`:
// a due task is only ever woken through `schedUnpark`, whose compare-and-exchange
// requires `taskParked`, and `taskParked` is stored by the worker only after
// `schedSwitch` has saved the context. A task found due before it is genuinely
// parked is therefore RETAINED, not woken, and retried on the next idle pass.
//
// That is the same race `sched.zig`'s hook exists to close, closed at the
// consumer end rather than the producer end. It costs at most one idle cycle of
// extra latency in a window that is a few instructions wide.
export @nosplit @symbol("bit_rt_port_sched_timer_push") function schedTimerPush(s: *i64, task: int) {
  let t = taskAt(task)
  spinAcquire(lockOf(s, scTimerLock))
  *(t + taskTimerNext) = *(s + scTimerHead)
  *(s + scTimerHead) = task
  spinRelease(lockOf(s, scTimerLock))
}

// Wake every sleeper whose deadline has passed. Returns how many actually woke.
//
// `sched.zig`'s `expire`, including its two-list partition and its rule that the
// unparking happens OUTSIDE the lock — `schedUnpark` pushes onto the global run
// queue and another worker may pick the task up immediately, so holding the
// timer lock across it would order a run queue behind a timer.
//
// A task whose deadline has passed but which has not yet reached `taskParked`
// goes back on the list rather than being dropped or spun on; see
// `schedTimerPush`'s ordering contract for why that case exists at all.
//
// Both walks are bounded by `schedMaxRegistered` (Power of 10) — the same
// runaway backstop the registry walk uses, for the same reason: a corrupted link
// must terminate the loop rather than hang the worker.
export @nosplit @symbol("bit_rt_port_sched_timer_expire") function schedTimerExpire(s: *i64, now: int): int {
  spinAcquire(lockOf(s, scTimerLock))
  let due = 0
  let keep = 0
  let it = *(s + scTimerHead)
  let n = 0
  while (it != 0 && n < schedMaxRegistered) {
    n = n + 1
    let t = taskAt(it)
    let next = *(t + taskTimerNext)
    if (*(t + taskDeadline) <= now) {
      *(t + taskTimerNext) = due
      due = it
    } else {
      *(t + taskTimerNext) = keep
      keep = it
    }
    it = next
  }
  *(s + scTimerHead) = keep
  spinRelease(lockOf(s, scTimerLock))

  let woken = 0
  let m = 0
  while (due != 0 && m < schedMaxRegistered) {
    m = m + 1
    let t = taskAt(due)
    let next = *(t + taskTimerNext)
    *(t + taskTimerNext) = 0
    if (schedUnpark(s, due)) {
      woken = woken + 1
    } else {
      // Due, but its context is not saved yet. Put it back and retry next pass.
      schedTimerPush(s, due)
    }
    due = next
  }
  return woken
}

// How many tasks are asleep. A bounded walk, for tests and for a consumer that
// wants to know whether an idle scheduler still has a wake pending — the
// distinction between "nothing to do" and "nothing to do YET", which is what
// makes a shutdown that drains timers expressible.
export @nosplit @symbol("bit_rt_port_sched_timer_count") function schedTimerCount(s: *i64): int {
  spinAcquire(lockOf(s, scTimerLock))
  let n = 0
  let it = *(s + scTimerHead)
  while (it != 0 && n < schedMaxRegistered) {
    n = n + 1
    it = *(taskAt(it) + taskTimerNext)
  }
  spinRelease(lockOf(s, scTimerLock))
  return n
}

// Park the calling task until `deadlineNs` on the same monotonic clock the
// consumer drives `schedTimerExpire` with. `sched.zig`'s `sleepTask`, split at
// the clock: the Zig computes `monoNs() + ns` internally, this takes the absolute
// deadline because it has no clock to add to (see the section header).
//
// MAY ONLY BE CALLED FROM TASK CODE, like `schedYield`/`schedPark` beside it.
//
// A deadline already in the past still parks and is woken by the next expiry
// pass, rather than returning immediately. That matches the Zig, whose
// `sleepTask` unconditionally parks too, and it keeps the function's contract
// single-valued: it always yields the worker, so a task cannot starve its
// worker by sleeping zero in a loop.
export @nosplit @symbol("bit_rt_port_sched_sleep_until") function schedSleepUntil(deadlineNs: int) {
  let taskAddr = schedCurrentTask()
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  let s = taskAt(*(w + wkSched))
  *(t + taskDeadline) = deadlineNs
  schedTimerPush(s, taskAddr)
  *(w + wkDisposition) = taskParked
  schedSwitch(t, w + wkCtx)
}

// ---------------------------------------------------------------------------
// The idle backoff
// ---------------------------------------------------------------------------
//
// DEVIATION, AND IT IS A REAL ONE: `sched.zig` SLEEPS between idle cycles
// (`sleepNs(backoff)`); this SPINS. The policy is unchanged — the same doubling
// from 1us to 1ms, taken from `runtime/park`'s `parkNextBackoff` so there is one
// copy of it — but the mechanism is a pause loop rather than `nanosleep`.
//
// It WAS forced rather than preferred: the run loop had to be `@nosplit`, and
// `@nosplit` rejects BOTH a `syscall` and an `extern` call with E0075 —
// measured, not inferred — while `parkSleepNs` is one or the other on every
// target. There was no third spelling; a call through a function value is also
// E0075.
//
// THAT BLOCKER IS GONE: `schedWorkerRun` is no longer `@nosplit` (#1431), so the
// loop may now call `parkSleepNs` directly. THIS FUNCTION HAS NOT BEEN CHANGED
// TO DO SO, and the cost is unchanged and should not be understated: an idle
// worker burns a core instead of yielding it, so N workers on an idle scheduler
// peg N cores. Replacing this spin with a real sleep is now ordinary work rather
// than a language limitation, and it is the next thing to do here.
//
// The iteration count tracks the nanosecond policy so the shape of the backoff
// is preserved: `backoff / parkMinBackoffNs` is 1 at the floor and 1000 at the
// cap. Both architectures' hint instructions are the ones their spin primitives
// use (`yield` on AArch64, `pause` on x86-64) — the same two `runtime/spinlock`
// already spins on.
@nosplit function spinBackoff(backoffNs: int) {
  let iters = backoffNs / parkMinBackoffNs
  let i = 0
  while (i < iters) {
    asm {
      arm64 { 0xD503203F }        // yield
      x64   { 0xF3, 0x90 }        // pause
    }
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// Work discovery
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `findWork`, with its order of preference unchanged, because the
// order IS the policy: local queue first (warm, uncontended), then the global
// overflow queue (oldest spilled work, so nothing starves), then one bounded
// pass stealing from every other worker.
//
// THE TIMER AND NETPOLLER PROBES ARE NOT IN THIS FUNCTION — they are in
// `schedFindWorkIdle` below, which wraps it. The split is forced, not stylistic:
// both probes need platform code reached through a function value, and a call
// through a value is E0075 in a `@nosplit` body. Keeping this half `@nosplit`
// leaves the hot path (the three queue probes, which is what runs when there IS
// work) free of safepoints and callable from `@nosplit` callers, and confines
// the non-`@nosplit` part to the idle tail — which is exactly where `sched.zig`
// puts it too.
export @nosplit function schedFindWork(w: *i64): int {
  let local = dqPopBottom(w + wkDeque)
  if (local != 0) {
    return local
  }
  let s = taskAt(*(w + wkSched))
  let spilled = gqPop(s + scGlobal)
  if (spilled != 0) {
    return spilled
  }

  // One bounded pass over the worker array (Power of 10: the trip count is the
  // worker count, which `threadMaxWorkers` caps at 1024).
  let n = *(s + scNWorkers)
  let me = *(w + wkId)
  let i = 0
  while (i < n) {
    if (i != me) {
      let stolen = dqSteal(schedWorkerAt(s, i) + wkDeque)
      if (stolen != 0) {
        return stolen
      }
    }
    i = i + 1
  }
  return 0
}

// `sched.zig`'s `findWork` IN FULL: the three queue probes above, then the two
// idle probes — due sleepers first (an expired timer is work), then the poller.
// Both drain onto the global queue rather than returning a task directly, so
// each probe is followed by a global pop, which is the Zig's shape exactly:
//
//     if (self.sched.timers.expire(self.sched, monoNs()) > 0) {
//         if (self.sched.global.pop()) |t| return t;
//     }
//     if (self.sched.poller.pollReady(self.sched, 0) > 0) {
//         if (self.sched.global.pop()) |t| return t;
//     }
//
// ORDER IS POLICY, so it is preserved: timers before the poller, and both after
// stealing. A woken timer is already-owed work, and running it before polling
// for new I/O is what stops a busy fd from starving a sleeper.
//
// THE POLLER TIMEOUT IS 0 — a non-blocking drain, which is what the Zig passes.
// That is worth stating because it is what makes the poller safe for the
// collector: this thread never blocks in `epoll_wait`/`kevent`, so it is never
// stuck in a syscall where it is neither `running` nor `parked` and cannot
// answer a stop-the-world rendezvous. All the waiting is done by the idle
// backoff below, on the loop's own terms, with a safepoint at every back edge.
//
// THE PLATFORM SEAM. `nowFn` is a monotonic clock in nanoseconds
// (`runtime/park`'s `parkMonoNs`); `pollFn(schedAddr, timeoutMs)` drains ready
// I/O events and returns how many tasks it unparked (`runtime/sched/<os>`'s
// `pollDrain`). Both are taken as function VALUES rather than imported, because
// this file must import neither provider — the same shape, and the same reason,
// as `runtime/thread`'s `threadJoin`. A consumer with no I/O still passes
// `pollDrain`: it returns 0 immediately when no poller was created.
function schedFindWorkIdle(w: *i64, nowFn: () => int,
                           pollFn: (int, int) => int): int {
  let addr = schedFindWork(w)
  if (addr != 0) {
    return addr
  }
  let s = taskAt(*(w + wkSched))
  if (schedTimerExpire(s, nowFn()) > 0) {
    let t = gqPop(s + scGlobal)
    if (t != 0) {
      return t
    }
  }
  if (pollFn(int(s), 0) > 0) {
    let t = gqPop(s + scGlobal)
    if (t != 0) {
      return t
    }
  }
  return 0
}

// The two seam arguments for a consumer that drives NEITHER timers nor I/O —
// a pure-scheduler embedding, which is what every scheduler stress program is.
//
// They are named for what they DISABLE, not for what they return, because the
// dangerous mistake is passing `schedNoTimers` to a scheduler that does use
// `schedSleepUntil`: a clock frozen at 0 makes every deadline look expired, so
// every sleeper would wake on the first idle pass instead of on time. A consumer
// with timers must pass a real monotonic clock (`runtime/park`'s `parkMonoNs`).
export @nosplit function schedNoTimers(): int {
  return 0
}

export @nosplit function schedNoPoller(schedAddr: int, timeoutMs: int): int {
  return 0
}

// ---------------------------------------------------------------------------
// The M:N run loop
// ---------------------------------------------------------------------------
//
// `sched.zig`'s `Worker.run`. One of these runs per OS thread; each drives green
// tasks until `schedShutdown` is called and no work remains.
//
// THIS LOOP USED TO BE `@nosplit`, AND THAT CONSTRAINT SHAPED THE WHOLE POOL.
// Codegen emits `bl bit_rt_safepoint` at every loop back-edge, and the safepoint
// entry used to snapshot the caller's registers into one PROCESS-WIDE global
// before running an unsynchronized stop-the-world collect. Two workers reaching
// a safepoint together raced that frame and could collect concurrently, so a
// worker loop had to reach no safepoint at all.
//
// That is fixed. #1429 made the snapshot per-thread (the shim reserves it below
// the caller's `sp`) and made stop-the-world a real rendezvous; #1431 then fixed
// the two defects that left the rendezvous unsound in practice — an allocating
// thread that never registered as a mutator, and a parked thread that resumed
// without re-checking the stop. The attribute is therefore GONE from this loop,
// and `tests/stress/schedpool*` now reports a NON-ZERO collection count under
// `BIT_GC=stress` where it previously reported zero (its safepoints were all
// suppressed, so the stress run verified nothing extra — cf. #1409).
//
// OF THE THREE CONSEQUENCES, TWO ARE NOW DONE AND ONE REMAINS:
//   1. TIMERS AND THE NETPOLLER ARE PORTED (#1364) — see `schedFindWorkIdle`.
//      Both are driven from this loop's idle path through function values, and
//      the poller is polled with timeout 0, so neither ever blocks this thread
//      in a syscall where the collector could not stop it.
//   2. THE IDLE WAIT STILL SPINS (see `spinBackoff`), so N idle workers still
//      peg N cores. This is NO LONGER a `@nosplit` limitation — the loop may
//      legally call `parkSleepNs` now — but a plain swap is NOT behaviourally
//      equivalent and was measured rather than assumed. `sched.zig` brackets
//      its idle sleep with `bit_rt_gc_blocking_begin`/`_end` (ABI.md §5) and
//      says why: without it "the collector would wait for a sleeping worker to
//      reach a safepoint it will not reach until work arrives". This USED to be
//      inexpressible: `extern function` was rejected outright for ELF targets.
//      #1444 removed that blanket — E0078 now tests archive membership, and both
//      symbols are defined in `libbitrt.a`, so they are declarable and callable
//      on Linux today (SPEC §11.7). What remains is the scheduler-side work of
//      actually bracketing the sleep, tracked on #1433; measured cost of the
//      naive swap is on #1364. The LANGUAGE gap is closed.
//   3. TASK BODIES ARE STILL `@nosplit` in every caller. Removing the attribute
//      from a task body has not been tested, and a green task's stack is reached
//      by the conservative scan rather than by a published safepoint frame, so
//      that half needs its own verification before it is claimed.
//
// THE TRIP BOUND. `sched.zig` writes `while (true)`. A statically provable bound
// is required here (Power of 10), so the loop carries one, exactly as
// `runtime/thread`'s `threadJoin` does and for the same reason: `stopping` is
// the operative exit in every real run, and the constant exists so that
// termination is provable by READING the loop rather than by trusting that some
// other thread will eventually set a flag. A worker that exhausts it returns,
// which degrades a wedged scheduler into a finishing one instead of a hung one.
const WORKER_MAX_STEPS: int = 1000000000

// Put a runnable task back on a queue: this worker's local ring for locality,
// spilling to the global queue when the ring is full. Both places the run loop
// needs this — an ordinary yield and an owed wake delivered out of the arm/park
// window — want the identical placement, so it is written once.
@nosplit function schedRequeue(s: *i64, w: *i64, addr: int) {
  let queued = dqPushBottom(w + wkDeque, addr)
  if (!queued) {
    gqPush(s + scGlobal, addr)
  }
}

// `nowFn` and `pollFn` are the platform seam; see `schedFindWorkIdle` for what
// each must do and why they are function values rather than imports.
export function schedWorkerRun(w: *i64, nowFn: () => int,
                               pollFn: (int, int) => int) {
  let s = taskAt(*(w + wkSched))
  let backoff = parkMinBackoffNs
  let n = 0
  while (n < WORKER_MAX_STEPS) {
    n = n + 1
    let addr = schedFindWorkIdle(w, nowFn, pollFn)

    if (addr == 0) {
      // No work. Stop if shutdown has been signalled, else back off and retry.
      // Checked AFTER `findWork` so a worker never exits leaving queued work
      // behind — `sched.zig`'s ordering, and the reason shutdown drains.
      let stopping = atomicLoad(s + scStopping)
      if (stopping != 0) {
        return
      }
      spinBackoff(backoff)
      backoff = parkNextBackoff(backoff)
    } else {
      backoff = parkMinBackoffNs
      let t = taskAt(addr)
      *(w + wkRunning) = addr

      // The migration point. A task carries no worker affinity, so the worker
      // that resumes it need not be the one it parked on, and this store is what
      // makes `schedCurrentWorker` correct after a migration. `sched.zig` gets
      // the same effect from its thread-local, which is why its `trampoline`
      // must RE-FETCH the worker after the body returns.
      *(t + taskWorker) = int(w)
      *(t + taskState) = taskRunning

      // Must be overwritten by the task before it switches back; the states
      // below are the only three a task may leave in.
      *(w + wkDisposition) = taskRunning
      schedSwitch(w + wkCtx, t)
      *(w + wkRunning) = 0
      *(t + taskWorker) = 0

      let disp = *(w + wkDisposition)
      if (disp == taskRunnable) {
        schedRequeue(s, w, addr)
      }
      if (disp == taskParked) {
        // Safe only now: `t`'s context was just saved by this same thread, in
        // program order, above. The atomic store is what lets another thread's
        // later load see that write — `sched.zig` makes exactly this argument
        // for its release store, and §11.5's sequential consistency is strictly
        // stronger.
        //
        // THREE CASES, TRIED IN THIS ORDER, AND THE ORDER IS THE PROOF.
        //
        //  1. `taskParking -> taskParked`. The task armed (`schedParkArm`) and
        //     no waker reached it: publish the park, and a later waker finds a
        //     properly parked task. This is the common armed path.
        //  2. `taskWakePending -> taskRunnable`. A waker reached the task inside
        //     its arm/park window and handed the wake here rather than dropping
        //     it. The task must NOT be left parked — nothing will wake it again,
        //     because a one-shot poller registration has already been consumed
        //     by the drain that failed to deliver. So the owed wake is delivered
        //     by requeueing, which is exactly what `schedUnpark` would have done
        //     had it been able to.
        //  3. Neither: the state is `taskRunning`, i.e. an ordinary unarmed park
        //     (`schedPark` alone — timers, channels, `schedYield`'s siblings).
        //     A plain store is correct AND cannot lose a wake, because only the
        //     task itself writes `taskParking` and it is suspended right now, so
        //     no waker can be inside the armed protocol for it.
        //
        // Case 2 is checked BETWEEN 1 and 3 rather than after 3, because a waker
        // may flip `taskParking -> taskWakePending` after 1's compare-exchange
        // has already failed. Once 2 has failed as well the state is `taskRunning`
        // and can no longer change under us, which is what makes 3's plain store
        // safe rather than merely likely.
        if (!atomicCmpxchg(t + taskState, taskParking, taskParked)) {
          if (atomicCmpxchg(t + taskState, taskWakePending, taskRunnable)) {
            schedRequeue(s, w, addr)
          } else {
            atomicStore(t + taskState, taskParked)
          }
        }
      }
      if (disp == taskDone) {
        atomicStore(t + taskState, taskDone)
        schedUnregister(s, addr)
      }
    }
  }
}

// ---------------------------------------------------------------------------
// What task code calls
// ---------------------------------------------------------------------------

// THE THREE FUNCTIONS BELOW MAY ONLY BE CALLED FROM TASK CODE. Off a task stack
// `schedCurrentTask` returns 0 and they fault on the null dereference that
// follows. That is deliberate, and it is the honest equivalent of `sched.zig`'s
// `Worker.current()`, which is `tls.?` and panics for the same misuse: a
// scheduler primitive that quietly did nothing would leave the caller believing
// it had yielded or parked when it had not, which is far worse than a crash at
// the call site. `panic` is not reachable from a `@nosplit` body in any case.
//
// `schedSpawn` is the exception and is safe from any thread, as the Zig's is —
// see its own comment.

// Give the CPU back to this task's worker, staying runnable. `sched.zig`'s
// `yield`. Returns when some worker — NOT NECESSARILY THE SAME ONE — resumes it.
export @nosplit function schedYield() {
  let taskAddr = schedCurrentTask()
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  *(w + wkDisposition) = taskRunnable
  schedSwitch(t, w + wkCtx)
}

// Stop running and do NOT requeue. `sched.zig`'s `park`, minus the `ParkFn`
// hook: registering the parked task with its waker is a call through a function
// value, which `@nosplit` rejects (E0075). The caller must therefore make itself
// findable BEFORE parking, which reintroduces the race `sched.zig`'s hook exists
// to close — so the safe pattern here is that the unparker discovers the task by
// polling `taskState` for `taskParked`, which is only stored after the context
// is saved. That is what tests/stress/schedpool does, and it is the seam a
// channel implementation (#1365) will need closed properly.
export @nosplit @symbol("bit_rt_port_sched_park") function schedPark() {
  let taskAddr = schedCurrentTask()
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  *(w + wkDisposition) = taskParked
  schedSwitch(t, w + wkCtx)
}

// ---------------------------------------------------------------------------
// Arming a park: the rendezvous that replaces `sched.zig`'s `ParkFn`
// ---------------------------------------------------------------------------
//
// THE PROBLEM, EXACTLY. `sched.zig` hands `park` a `ParkFn` that runs on the
// WORKER's side of the switch — after the context is saved and after the state
// is published as `.parked` — and registers the fd from there. That hook is a
// call through a function value, which `@nosplit` rejects (E0075), so it cannot
// be transcribed. A Bit task must therefore make itself findable BEFORE it
// parks, and a wake that lands in the window between "registered" and "parked"
// finds the task still `taskRunning`, fails `schedUnpark`'s compare-exchange,
// and IS DROPPED.
//
// WHY TIMERS SURVIVE THAT AND A POLLER CANNOT. A dropped timer wake is retried:
// the deadline is still on the timer list, so the next `schedTimerExpire` finds
// the task again. A netpoller registration is ONE-SHOT (EPOLLONESHOT/EV_ONESHOT
// — see the two `poll.bit` providers), so the drain that failed to deliver has
// already consumed the readiness edge. Nothing will ever report that fd again,
// and the task is parked forever. That is the QUIC-teardown shape recorded in
// [[bit-quic-suite-hang]], reached by a much shorter path.
//
// THE PROTOCOL. `taskState` itself is the rendezvous, and both sides drive it
// with a compare-exchange, so exactly one of them wins and the loser is told:
//
//   task:   taskRunning --schedParkArm-->      taskParking
//   waker:  taskParking --schedPollUnpark-->   taskWakePending   (wake owed)
//   worker: taskParking --schedWorkerRun-->    taskParked        (park published)
//
// If the worker's transition lands first the waker finds a properly parked task
// and takes the ordinary `taskParked -> taskRunnable` path. If the waker's lands
// first the worker's compare-exchange fails, it sees `taskWakePending`, and it
// DELIVERS the owed wake by requeueing instead of parking. There is no
// interleaving in which both fail, because both are compare-exchanges against
// the same word and one of them must observe `taskParking`.
//
// Bounded and lock-free by construction: every operation below is a fixed number
// of compare-exchanges with no retry loop (Power of 10).

// Announce that this task is about to register itself somewhere and then park.
// Returns false if the task was not `taskRunning`, which means the caller is not
// a running task and has no business arming.
//
// MUST be followed by either `schedPark` or `schedParkDisarm` on every path. A
// task left in `taskParking` that never parks is invisible to `schedUnpark` —
// which is precisely why `schedParkDisarm` exists rather than being optional.
export @nosplit @symbol("bit_rt_port_sched_park_arm") function schedParkArm(): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  return atomicCmpxchg(t + taskState, taskRunning, taskParking)
}

// Undo an arm without parking — the path a caller takes when the registration
// it armed for FAILED and so nothing will ever wake it.
//
// Returns true when a wake had already been handed over, i.e. the waker won the
// race while the caller was still registering. That wake is CONSUMED HERE: the
// caller is running, so the wake's only meaning ("do not park") is already
// satisfied, and requeueing an already-running task would put it on a run queue
// twice. A caller that ignores the answer is still correct; it is returned
// because a poller consumer wants to know its registration raced.
export @nosplit @symbol("bit_rt_port_sched_park_disarm") function schedParkDisarm(): bool {
  let taskAddr = schedCurrentTask()
  if (taskAddr == 0) {
    return false
  }
  let t = taskAt(taskAddr)
  if (atomicCmpxchg(t + taskState, taskParking, taskRunning)) {
    return false
  }
  // The only other state an armed task can be in is `taskWakePending`, and the
  // waker that set it is done with the task. A plain store is therefore safe.
  atomicStore(t + taskState, taskRunning)
  return true
}

// Wake a task that may be anywhere in the arm/park protocol. THE POLLER'S
// UNPARK — `pollDrain` calls this where it used to call `schedUnpark`, and the
// difference is only what happens to a task caught mid-park.
//
// Returns true when the wake was delivered or handed over, false when the task
// was in none of the three states a wake can be given to (already runnable,
// running, or done) and the caller should drop it exactly as `schedUnpark` does.
//
// STEP 3 IS NOT REDUNDANT WITH STEP 1, and this is the one claim here that a
// single-core test cannot demonstrate. Between step 1 observing `taskParking`
// and step 2 running, the task's worker may publish `taskParked` — so step 2's
// compare-exchange fails too, and without step 3 a genuinely parked task would
// be left parked with its one-shot edge consumed. It needs two cores to
// interleave that way, so it is kept on the argument rather than on a test, and
// this comment is that argument.
//
// STEPS 1 AND 3 ARE TWO EQUIVALENT MUTANTS, AND THAT WAS MEASURED RATHER THAN
// ASSUMED. Deleting step 1 alone SURVIVES every program in this suite, and so
// does deleting step 3 alone — they are the same transition at two points, so
// each masks the other's removal. Deleting BOTH is caught, by
// ../../tests/stress/schedpoll{darwin,linux}: `woke true -> false`. So the pair
// is guarded, the individual lines are not, and neither may be deleted on the
// strength of a green run. ../../tests/stress/netpark cannot see either one: its
// task is always caught mid-park, so only step 2 ever fires there.
export @nosplit @symbol("bit_rt_port_sched_poll_unpark") function schedPollUnpark(s: *i64, task: int): bool {
  let t = taskAt(task)
  // 1. Already parked: the ordinary transition, identical to `schedUnpark`.
  if (atomicCmpxchg(t + taskState, taskParked, taskRunnable)) {
    gqPush(s + scGlobal, task)
    return true
  }
  // 2. Caught mid-park: hand the wake to the worker, which owes its delivery.
  if (atomicCmpxchg(t + taskState, taskParking, taskWakePending)) {
    return true
  }
  // 3. It finished parking between 1 and 2. Retry the parked transition.
  if (atomicCmpxchg(t + taskState, taskParked, taskRunnable)) {
    gqPush(s + scGlobal, task)
    return true
  }
  return false
}

// Leave for good. Never returns — the worker sees `taskDone` and never queues
// this task again.
export @nosplit function schedTaskExit() {
  let taskAddr = schedCurrentTask()
  let t = taskAt(taskAddr)
  let w = taskAt(*(t + taskWorker))
  *(w + wkDisposition) = taskDone
  schedSwitch(t, w + wkCtx)
}

// ---------------------------------------------------------------------------
// Scheduler control
// ---------------------------------------------------------------------------

// Queue a runnable task. Prefers the calling worker's local ring when the
// caller is itself on a task (the fast path), and falls back to the global
// queue otherwise — `sched.zig`'s `Scheduler.spawn` placement rule.
//
// Registration happens first, and before the task is visible to any queue, so a
// collector can never observe a runnable task that is not on the registry.
export @nosplit function schedSpawn(s: *i64, task: int) {
  schedRegister(s, task)
  let wAddr = schedCurrentWorker()
  if (wAddr != 0) {
    let queued = dqPushBottom(taskAt(wAddr) + wkDeque, task)
    if (queued) {
      return
    }
  }
  gqPush(s + scGlobal, task)
}

// Make a parked task runnable again, from any thread. Routes through the global
// queue because the caller may not be a worker at all. `sched.zig`'s `unpark`.
//
// The compare-and-exchange both checks the precondition and performs the
// transition, so a double unpark cannot race itself onto the queue twice.
// Returns false when the task was not parked, rather than panicking as the Zig
// does: a panic is not available in a `@nosplit` body, and a caller that can see
// the answer can react to it.
export @nosplit @symbol("bit_rt_port_sched_unpark") function schedUnpark(s: *i64, task: int): bool {
  let t = taskAt(task)
  if (!atomicCmpxchg(t + taskState, taskParked, taskRunnable)) {
    return false
  }
  gqPush(s + scGlobal, task)
  return true
}

// Signal every worker to stop once it next finds no work. `sched.zig`'s
// `shutdown`. Joining the OS threads afterwards is `runtime/thread`'s
// `threadJoin`, which the caller drives — this module creates no threads (see
// the header) and so reaps none.
export @nosplit function schedShutdown(s: *i64) {
  atomicStore(s + scStopping, 1)
}
