// The two run queues, split out of `sched.bit` (#1503): a worker's local
// work-stealing ring and the global overflow queue. Sibling file, so the same
// module - nothing here changed but its home.

// ---------------------------------------------------------------------------
// Per-worker run queue: a bounded work-stealing ring
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `Deque`, unchanged in discipline: the owner appends at `tail`;
// the owner's pop and every other worker's steal contend for `head` by CAS, so
// both take from the OLDEST end and a task is handed to exactly one taker. Go's
// runtime shape, and simpler to prove correct than a full Chase-Lev deque at
// the cost of one uncontended CAS on the owner's pop.
//
// Capacity is fixed and a power of two so the ring index is a mask. Overflow is
// NOT an error: `dqPushBottom` reports false and the caller spills to the
// global queue, which is why capacity need not be provably sufficient.
//
// Block layout, word-indexed:
//   0            head   (monotonic; masked to index)
//   1            tail   (monotonic; masked to index)
//   2 .. 2+cap-1 ring of task addresses
export const dqCapacity: int = 256
const dqMask: int = 255
export const dqWords: int = 258

const dqHead: int = 0
const dqTail: int = 1
const dqBuf: int = 2

// `@nosplit` throughout: these run on the scheduling hot path and inside the
// idle loop, where an allocation or a safepoint would collect against a worker
// mid-handoff. §10.3 forbids INDEXING in a `@nosplit` body (E0075), which is
// why the ring is reached by base-pointer arithmetic and deref rather than
// `buf[i]` — the same shape `runtime/gc` uses for its own tables.
export @nosplit fn dqInit(q: *i64) {
  atomicStore(q + dqHead, 0)
  atomicStore(q + dqTail, 0)
}

// Owner-only. False if the ring is full; the caller must then spill to the
// global queue.
export @nosplit @symbol("bit_rt_port_sched_dq_push_bottom") fn dqPushBottom(q: *i64, task: int): bool {
  let h = atomicLoad(q + dqHead)
  let t = atomicLoad(q + dqTail)
  if (t - h >= dqCapacity) {
    return false
  }
  *(q + dqBuf + t % dqCapacity) = task
  atomicStore(q + dqTail, t + 1)
  return true
}

// Owner-only pop; contends with `dqSteal` on `head`.
//
// The retry loop is bounded by `dqCapacity`, not left open. A CAS loop that
// only exits on success has no statically provable limit (Power of 10), and the
// bound is sound: every losing iteration means some other worker won a steal,
// and at most `dqCapacity` tasks can be stolen from a ring that holds at most
// that many. Exhausting the bound therefore means the ring was drained by
// others, and reporting empty is the correct answer, not a lost task.
export @nosplit fn dqPopBottom(q: *i64): int {
  let n = 0
  while (n <= dqCapacity) {
    let h = atomicLoad(q + dqHead)
    let t = atomicLoad(q + dqTail)
    if (h == t) {
      return 0
    }
    let task = *(q + dqBuf + h % dqCapacity)
    if (atomicCmpxchg(q + dqHead, h, h + 1)) {
      return task
    }
    n = n + 1
  }
  return 0
}

// Callable from any other worker. Identical to `dqPopBottom` — both take from
// `head` — and kept as its own name because the CONTRACT differs: this one is
// safe to call on a queue this thread does not own, which is the property a
// work-stealing loop depends on.
export @nosplit fn dqSteal(q: *i64): int {
  return dqPopBottom(q)
}

// A READ-ONLY, RACY "is there anything here" probe (#3260) — two loads, no CAS.
//
// This is `dqSteal`'s test-and-test-and-set half, and the reason it is worth a
// function is the same reason #2321 rewrote `spinAcquire`: a `dqSteal` that
// misses still issues its CAS on `head`, and an exclusive load STEALS THE CACHE
// LINE FROM THE OWNER, which then has to win it back to push or pop its own
// work. One idle worker doing that is invisible; a pool of them retrying in a
// spin makes the worker with the work the slowest thread in the process. A
// spinning worker therefore reads first and only calls into the real find-work
// path once something looks non-empty.
//
// STALE EITHER WAY IS HARMLESS, and both directions are reached in practice: a
// stale "empty" costs one more turn of the spin (or, at worst, the park the
// caller was about to do anyway, which every wake path already covers), and a
// stale "non-empty" costs one find-work pass that comes back 0 — exactly what an
// unlucky steal race costs today.
export @nosplit fn dqNonEmpty(q: *i64): bool {
  return atomicLoad(q + dqHead) != atomicLoad(q + dqTail)
}

// The current occupancy of `q` (#3583): `tail - head`, two independent
// atomic loads rather than one combined snapshot — racy for the identical
// reason `dqNonEmpty` above is, and sound for the same reason: its one
// caller (`schedGrowObserve`'s local counterpart, `./grow.bit`) only needs
// "roughly this many", never a linearizable count, because a stale read
// costs at most one grow decision made one enqueue early or late, not a
// lost task.
export @nosplit fn dqDepth(q: *i64): int {
  return atomicLoad(q + dqTail) - atomicLoad(q + dqHead)
}

// ---------------------------------------------------------------------------
// The next-run slot: one task the owning worker reaches before the queues (#3264)
// ---------------------------------------------------------------------------
//
// Go's `p.runnext`, and it is here for one measured reason. A contended
// `std/sync` lock is `<- m.token` on a capacity-1 channel, so N green threads
// serialise onto exactly ONE runnable task and every `unlock()` republishes it.
// `schedUnpark` pushed that task to the GLOBAL queue unconditionally, where any
// worker may take it — and the ring above is popped by its owner from the same
// end thieves steal from, so a peer very often wins the race. The one runnable
// task therefore changed core on nearly every handoff, paying a cache-line
// migration for the lock word, the channel and the task record. The unchanged
// binary shows it as a 10x cliff between one worker (0.01s) and two (0.10s), at
// the exact point migration first becomes possible and long before parking cost
// dominates — which is why it is a separate defect from #3260's park/wake one
// and why #3260's bounded idle spin did not move it.
//
// AT MOST ONE TASK, AND DELIBERATELY NOT PART OF THE RING. `dqSteal` cannot see
// this word, so a spinning peer cannot take the task out from under the worker
// that is about to run it. That invisibility IS the mechanism; it is not an
// optimisation on top of one.
//
// STRANDING IS THE RISK, AND IT IS BOUNDED IN TWO PLACES RATHER THAN ARGUED
// AWAY:
//
//   - The slot is filled by the thread that OWNS the worker, from task code
//     (`schedUnpark`'s `schedCurrentWorker` guard), so that worker is awake by
//     construction and takes it on its very next find-work pass. For a lock
//     handoff that is microseconds later, because the waker's next act is to
//     block on the lock itself.
//   - When the waker instead keeps running for a long time — a CPU-bound loop,
//     an unbracketed blocking syscall — the task would wait on it. So
//     `schedFindWorkAt`, the SLOW idle turn and never the `@nosplit` spin, lets
//     a peer steal an occupied slot as its last resort. Worker 0 never parks
//     (see `sleep.bit`'s header), so that probe runs at least once per
//     `parkMaxBackoffNs`, which makes the worst case the same "latency, not a
//     deadlock" bound `sleep.bit` already accepts for a lost wake.
//
// A note on the ORDER this is consulted in, because it is load-bearing and the
// obvious choice is the wrong one: `schedFindWork` takes the local ring FIRST
// and only then this slot. Reversing them would let an unbroken chain of wakes
// starve a task sitting on the ring — reachable at `BIT_WORKERS=1`, where there
// is no thief to rescue it — and would also invert the ordering
// `tests/stress/chan/props`' phase 8 pins ("`schedFindWork` prefers the LOCAL
// ring over the global queue while `schedUnpark` routes to the GLOBAL queue"),
// which is how that suite reaches `claim`'s winner-take-all rule at all. Placed
// after the ring, this slot inherits exactly the global queue's existing
// starvation properties and adds no new class.

// Take `w`'s next-run slot, or 0. Safe from any thread: the compare-exchange is
// what hands the task to exactly one taker, the same way `dqPopBottom`'s does.
//
// ONE ATTEMPT, NO RETRY LOOP (Power of 10 rule 2 — there is no loop to bound). A
// lost exchange means another taker already has the task, and reporting empty is
// then the correct answer rather than a lost task — the identical argument
// `dqPopBottom` makes for exhausting its own bound.
export @nosplit fn rnTake(w: *i64): int {
  let addr = atomicLoad(w + wkRunNext)
  if (addr == 0) {
    return 0
  }
  if (atomicCmpxchg(w + wkRunNext, addr, 0)) {
    return addr
  }
  return 0
}

// Put `task` in `w`'s next-run slot and return whatever it DISPLACED: 0 when the
// slot was empty, the previous occupant when it was not, and `task` itself when
// the exchange was lost to a concurrent taker.
//
// THE RETURNED TASK IS THE CALLER'S TO REQUEUE in both non-zero cases. Dropping
// it loses a runnable task, which is a hang for whoever is waiting on it.
//
// Owner-only, exactly like `dqPushBottom`: the caller must be running on `w`.
export @nosplit fn rnPut(w: *i64, task: int): int {
  let old = atomicLoad(w + wkRunNext)
  if (!atomicCmpxchg(w + wkRunNext, old, task)) {
    return task
  }
  return old
}

// Is `w`'s next-run slot occupied? The read-only half, for `schedWorkPending` —
// one plain load, no exchange, sound for the same reason `dqNonEmpty` is.
export @nosplit fn rnNonEmpty(w: *i64): bool {
  return atomicLoad(w + wkRunNext) != 0
}

// ---------------------------------------------------------------------------
// Global overflow queue
// ---------------------------------------------------------------------------
//
// `runtime/sched/`'s `GlobalQueue`: an intrusive FIFO under a spinlock, holding
// spilled local pushes, tasks unparked from another thread, and tasks the
// netpoller woke — everything whose target worker is unknown, or whose waker
// is not a worker at all.
//
// FIFO order is part of the discipline, not an accident: it is what stops a
// task that repeatedly overflows a local ring from being starved behind
// newer work.
//
// Block layout, word-indexed:
//   0  head task address (0 when empty)
//   1  tail task address
//   2  lock word — an i32 cell, addressed as such (see `lockOf`)
export const gqWords: int = 3

const gqHead: int = 0
const gqTail: int = 1
const gqLock: int = 2

export @nosplit fn gqInit(q: *i64) {
  *(q + gqHead) = 0
  *(q + gqTail) = 0
  atomicStore(lockOf(q, gqLock), 0)
}

// Link `task` on at the tail. `taskNext` of `task` is cleared first, so a task
// carrying a stale link from a previous queue cannot splice foreign tasks in.
export @nosplit fn gqPush(q: *i64, task: int) {
  let t: *i64 = nil
  let node = t + task / 8
  *(node + taskNext) = 0
  spinAcquire(lockOf(q, gqLock))
  let tail = *(q + gqTail)
  if (tail == 0) {
    *(q + gqHead) = task
  } else {
    let tailNode = t + tail / 8
    *(tailNode + taskNext) = task
  }
  *(q + gqTail) = task
  spinRelease(lockOf(q, gqLock))
}

// The global queue's half of `dqNonEmpty` (#3260), and the one that matters
// most: `gqPop` takes the queue's SPINLOCK unconditionally, before it can even
// see that the queue is empty, so an idle worker retrying it in a spin hammers
// a single exclusive word that every producer also needs. A plain load of the
// head answers the same question for free. Racy by construction and sound for
// the same reason as `dqNonEmpty`: the caller re-checks under the lock.
export @nosplit fn gqNonEmpty(q: *i64): bool {
  return *(q + gqHead) != 0
}

// Unlink and return the head task address, or 0 when empty.
export @nosplit fn gqPop(q: *i64): int {
  spinAcquire(lockOf(q, gqLock))
  let head = *(q + gqHead)
  if (head == 0) {
    spinRelease(lockOf(q, gqLock))
    return 0
  }
  let t: *i64 = nil
  let node = t + head / 8
  let next = *(node + taskNext)
  *(q + gqHead) = next
  if (next == 0) {
    *(q + gqTail) = 0
  }
  *(node + taskNext) = 0
  spinRelease(lockOf(q, gqLock))
  return head
}
