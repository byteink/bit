// The C-ABI channel/select entry points codegen calls (ABI.md §11), pinned
// under their `bit_rt_root_*` placeholders (#1581, SEAM 7). Sibling of
// `./chan.bit`, so the same module: the marshalling wrappers here reach the
// blocking operations (`chanSend`/`chanRecv`/`chanClose`/`chanSelect`) and the
// per-task scratch layout (`scratchOf`/`scrElem`/`scrRecvOk`) directly, with no
// import — exactly as `chanops.bit` and `chanselect.bit` do.
//
// ---------------------------------------------------------------------------
// WHAT THESE WRAPPERS DO, AND WHAT THEY DELIBERATELY DO NOT
// ---------------------------------------------------------------------------
//
// Each pins one RtFn's emitted symbol (`seed/codegen/*`'s `rtSymbol`) so a
// separately-emitted user object resolves the call: `chan_send` -> `bit_rt_
// chan_send`, and #1369 later strips the `_root` infix (G2/#1583 owns that
// rename — NOT here). They are NOT `@nosplit`: the established convention for a
// pinned ABI wrapper is an ordinary function (`net/netabi.bit`, `root/floats.bit`
// are the same), and an ordinary caller may call the `@nosplit` internals; the
// reverse is what `@nosplit` forbids.
//
// TWO THINGS ARE OUT OF SCOPE HERE, BY THE MODULE'S OWN DIVISION OF LABOUR:
//
//   - PANIC. `chan.zig` panics on send-on-closed, close-of-closed and
//     close-of-nil; `./chan.bit`'s header records that the ABI wrapper which
//     RAISES those as panics is #1367's half (a `@nosplit` body cannot panic,
//     and the panic entry is `runtime/root`'s platform-split `bit_rt_root_panic`
//     which this cross-platform module cannot name). So the wrappers here mirror
//     the internal boolean result — the operation still does the right thing to
//     the channel — and leave the panic to that later half.
//   - CHAN_MAKE. `chan_make` needs a process-lifetime channel handle and ring
//     that outlive the GC (root.zig uses `page_allocator`, never GC), plus a
//     process registry the collector scans (`chanScanRegistryRoots`) so a
//     buffered `is_ref` channel's payloads are treated as roots. On main today
//     NONE of that is provisioned: no chan reserve or registry block is set up
//     at boot, `reserveInit`/`reserveTake` are unpinned (unreachable from a
//     freestanding chan emit), and the registry scan has no live call site
//     (#1602 defers it to #1610, still pending). The ring GC-reachability model
//     (traced GC object vs. process memory + registry-scanned contents) is also
//     unsettled. Pinning `chan_make` now would emit a shell that allocates from
//     a zero reserve — silent wrongness at G3, not progress — so it stays out
//     until that boot wiring + reachability decision lands (#1613/#1610).
//
// SELECT_ALLOC is now IN (below). Its buffer is transient, not process-lifetime:
// codegen fills it and passes it straight to `bit_rt_select`, holding it in a
// rooted stack slot across the call, so a GC-traced `alloc_buf` object rooted by
// that slot is exactly right — the same shape `root.zig`'s `gcAllocRaw(...,
// ref_array_info)` uses. It needs no reserve, no registry and no boot state, so
// the chan<->root cycle break (#1612) is the only thing it was ever waiting on.
//
// ---------------------------------------------------------------------------
// LIVENESS
// ---------------------------------------------------------------------------
//
// Pre-rename `libbitrt.a` is still assembled from `runtime/root.zig`, so a
// linked binary's channel calls land on the Zig `bit_rt_chan_*`, not on these
// pins. What this file is verified by is therefore the freestanding emit (both
// compilers define the pins, no mangled undefined) and the pin-cycle gate; the
// linked runtime behaviour (QUIC teardown, closed-channel `(v, ok)`) exercises
// the Zig originals until #1369 swaps the archive.
//
// `schedPark`, `schedCurrentTask` and `taskAt` are already imported by
// `./chan.bit` — imports are module-scoped, so this sibling names them directly.
//
// `allocBuf` is root's pinned ref-array allocator (`bit_rt_port_root_alloc_buf`,
// SEAM 3 / #1576). Reaching it from chan is legal now the chan<->root cycle is
// gone (#1612): the graph is root->sched, chan->sched, chan->root, chan->gc —
// still a DAG, root never imports chan. Only `select_alloc` uses it.
import { allocBuf } from "../root"

// `bit_rt_chan_send(ch, value)` (ABI.md §11). A nil channel blocks the caller
// forever (SPEC §16.2): there is nothing that can ever unpark it, matching
// `chan.zig`'s `park(null, null)`. `chanSend`'s `false` return means the channel
// was closed — the point at which `chan.zig` panics; that panic is #1367's half,
// so the value is dropped here rather than raised.
export @symbol("bit_rt_root_chan_send") function rtChanSend(ch: int, value: int) {
  if (ch == 0) {
    schedPark()
    return
  }
  let sent = chanSend(taskAt(ch), value)
}

// `bit_rt_chan_recv(ch) -> value` (ABI.md §11). Codegen lowers `<- c` as this
// RtFn (a SINGLE value word back) immediately followed by `chan_recv_ok`, so the
// received value is returned here and the `ok` is published into the per-task
// `scrRecvOk` slot for `bit_rt_chan_recv_ok` (pinned in `root/slots.bit`, SEAM 4)
// to read. THE `scrRecvOk` WRITE IS ON EVERY PATH — the buffered fast path, the
// blocking path and the closed-channel path all flow through the one
// `chanRecv` call below, and its boolean result is published unconditionally.
// This matters because a closed ref channel delivers the zero word, which for a
// reference element is a NULL pointer: `ok == false` is the only thing that lets
// the receiver tell "closed" from "a real value" before dereferencing it.
//
// The received value lands in the per-task `scrElem` slot: `chanRecv` writes
// through the `*i64` it is handed, and that slot is stable across the park a
// blocking receive performs (a caller frame is not). A nil channel blocks
// forever, as for send.
export @symbol("bit_rt_root_chan_recv") function rtChanRecv(ch: int): int {
  if (ch == 0) {
    schedPark()
    return 0
  }
  let scr = scratchOf(schedCurrentTask())
  let ok = chanRecv(taskAt(ch), scr + scrElem)
  if (ok) {
    *(scr + scrRecvOk) = 1
  } else {
    *(scr + scrRecvOk) = 0
  }
  return *(scr + scrElem)
}

// `bit_rt_chan_close(ch)` (ABI.md §11). Wakes every blocked peer (`chanClose`).
// A nil channel and a double close both panic in `chan.zig`; that panic is
// #1367's half, so a nil channel is a no-op and `chanClose`'s `false` (already
// closed) is dropped here.
export @symbol("bit_rt_root_chan_close") function rtChanClose(ch: int) {
  if (ch == 0) {
    return
  }
  let closed = chanClose(taskAt(ch))
}

// `bit_rt_select(descs, n, has_default) -> fired` (SPEC §16.3). `descs` is the
// `select_alloc`'d, codegen-populated case buffer; the return is the fired case
// index, or `n` for the default clause. Pure marshalling: `chanSelect` reaches
// the scheduler through the first case's channel and drives the whole thing.
export @symbol("bit_rt_root_select") function rtSelect(descs: int, n: int, hasDefault: bool): int {
  return chanSelect(taskAt(descs), n, hasDefault)
}

// `bit_rt_select_alloc(n) -> descs` (ABI.md §11). A zeroed `n`-case descriptor
// buffer for codegen to populate (`dir`/`chan`, and a send case's `word`) before
// calling `bit_rt_select`. `selCaseWords` (=4) words per case, `n` cases.
//
// TRACED, not a leaf: a case's `word` slot holds a live GC reference for a
// `chan<T>` whose `T` is a reference type — a send case's value, or the value a
// recv case just received (`bit_rt_select` writes it back there for codegen to
// read). That reference lives ONLY in this buffer across `bit_rt_select`, which
// may park and let a collection run, so an untraced buffer would sweep a still-
// live received value. `allocBuf(.., true)` selects root's `ref_array_info`
// descriptor, exactly as `root.zig`'s `gcAllocRaw(.., &ref_array_info)` does;
// conservative per-word tracing is exact here because `dir`/`ok` are 0/1 and a
// `chan` handle is not a GC object base, so `gcMarkRoot` skips all three and
// marks only a real `word` reference (ABI.md §11).
//
// No process-lifetime storage, reserve or registry is involved: codegen holds
// this buffer in a rooted stack slot from `select_alloc` to `bit_rt_select`, so
// the collector's stack scan roots it — unlike `chan_make`'s handle/ring, which
// must outlive any caller frame. `allocBuf` zeroes the body (`gcAllocRaw` ->
// `zeroBytes`), satisfying the "zeroed descriptor buffer" contract.
export @symbol("bit_rt_root_select_alloc") function rtSelectAlloc(n: int): int {
  return allocBuf(n * selCaseWords, true)
}
