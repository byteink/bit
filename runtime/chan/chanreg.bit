// The channel registry and the GC root-scanning cursors (#1503), plus the scan
// itself (#1602).
//
// The registry CURSORS below are sibling functions of `./chan.bit` — same
// module, no import — but `chanScanRegistryRoots` reaches ACROSS the object
// boundary into the collector to push each buffered word as a root, so it
// imports the two pinned `runtime/gc` entry points it needs. That direction is
// deliberate and acyclic: `runtime/gc` is a pure collector that knows nothing of
// channels (it never imports `../chan`), exactly as `runtime/gc/` never imports
// `runtime/chan/`; the knowledge that a channel's ring buffer holds roots lives with
// the channel, which PUSHES them into the collector's conservative mark door.
import { gcMarkConservative, gcMarkBegin, gcCollectFinish, loadWord, wordAt } from "../gc"

// ---------------------------------------------------------------------------
// GC root scanning (ABI.md §11)
// ---------------------------------------------------------------------------
//
// A buffered word is reachable ONLY through the ring buffer while it sits
// unreceived — no stack and no register holds it — so the collector must treat
// every `isRef` channel's buffered words as roots or sweep live values.
//
// `runtime/chan/` exposes this as `scanRegistryRoots(mark)` and `forEachBuffered
// (visit)`, both taking a function pointer. `@nosplit` rejects a call through a
// function value (E0075), so the traversal is inverted into a CURSOR the
// collector drives — the same change `runtime/sched` made to
// `forEachOtherStack` for the same reason, and the same one this file made to
// the vtable.
//
// The registry itself is a caller-owned two-word block, so this module keeps no
// mutable module state: registered channels are process-lifetime (v1 has no
// channel-free primitive, ABI.md §11), so nothing is ever unlinked and a plain
// head-insertion under a lock is the whole structure.
//
//   0  head channel address
//   1  lock — an i32 cell
export const chanRegWords: int = 2
const crHead: int = 0
const crLock: int = 1

export @nosplit fn chanRegInit(reg: *i64) {
  *(reg + crHead) = 0
  atomicStore(spinCellAt(reg, crLock), 0)
}

// Opt a channel into root scanning. `runtime/chan/`'s `register`, called only by the
// ABI's channel constructor and only for `is_ref` channels.
export @nosplit fn chanRegister(reg: *i64, ch: *i64) {
  spinAcquire(spinCellAt(reg, crLock))
  *(ch + chRegNext) = *(reg + crHead)
  *(reg + crHead) = int(ch)
  spinRelease(spinCellAt(reg, crLock))
}

export @nosplit fn chanRegHead(reg: *i64): int {
  let h = *(reg + crHead)
  return h
}

export @nosplit fn chanRegNext(ch: *i64): int {
  let nx = *(ch + chRegNext)
  return nx
}

// Whether this channel's buffered words are GC references.
export @nosplit fn chanIsRef(ch: *i64): bool {
  return *(ch + chIsRef) != 0
}

// The `i`th currently-buffered word, in queue order. The collector walks
// `0 .. chanCount(ch)` under the channel's lock, which it takes with
// `chanLockCell` — `runtime/chan/`'s `forEachBuffered` took the lock itself around
// the whole visit, and a cursor cannot, so the lock is handed out instead of
// being taken and released per element.
export @nosplit fn chanBufferedAt(ch: *i64, i: int): int {
  let buf = taskAt(*(ch + chBuf))
  let v = *(buf + (*(ch + chHead) + i) % *(ch + chCap))
  return v
}

// How many words are currently buffered — the bound the collector walks
// `0 .. chanBufferedCount(ch)` over. `runtime/chan/`'s `forEachBuffered` reads
// `self.count` directly; a cursor cannot, so it is exposed. An unbuffered
// (`chCap == 0`) channel never buffers, so this is always 0 there and the
// modular index in `chanBufferedAt` — which would divide by `chCap` — is never
// reached.
export @nosplit fn chanBufferedCount(ch: *i64): int {
  let n = *(ch + chCount)
  return n
}

// This channel's lock cell, for a collector that must hold it across a walk.
export @nosplit fn chanLockCell(ch: *i64): *i32 {
  return spinCellAt(ch, chLock)
}

// Visit every registered `isRef` channel's currently-buffered words as GC roots,
// pushing each through the collector's conservative mark door. Called once per
// collection from the root scan (ABI.md §11), while the world is stopped.
//
// This is the Bit port of `runtime/root/`'s `chan.WordChan.scanRegistryRoots(
// markChanWord)`. `runtime/chan/` passes a `mark` function POINTER; the unmanaged
// subset has none (a Bit function value is a GC object the collector cannot
// depend on), so the registry traversal is a CURSOR walk here and the mark is a
// direct call to `gcMarkConservative` — the same `markConservative` door
// `markChanWord` routes through, chosen because the type system lists a `chan`
// element word as a "reference" that may not be a GC object base at all;
// `gcMarkConservative`/`gcMarkRoot` validate and skip anything that is not one.
//
// The per-channel lock is taken across each channel's walk, mirroring
// `forEachBuffered` exactly. Safe under stop-the-world: a mutator holds a
// channel lock only across straight-line code between safepoints (it publishes
// its waiter and releases the lock BEFORE parking), so no parked thread holds it
// while the collector runs.
//
// PINNED (ABI.md §9): the root orchestrator (`runtime/root`, #1367) calls this
// across the object boundary, so it needs the emitted-symbol contract every
// cross-module runtime call relies on. `bit_rt_port_` is the placeholder prefix
// #1369 strips.
export @nosplit @symbol("bit_rt_port_chan_scan_registry_roots") fn chanScanRegistryRoots(g: *i64, reg: *i64) {
  let addr = chanRegHead(reg)
  // Bounded: one registered channel per link, and the registry is append-only
  // and process-lifetime (v1 has no channel-free primitive, §11), so the list
  // length is monotone and every node is distinct — the walk visits each once.
  while (addr != 0) {
    let ch = wordAt(addr)
    if (chanIsRef(ch)) {
      let lk = chanLockCell(ch)
      spinAcquire(lk)
      let n = chanBufferedCount(ch)
      let i = 0
      // Bounded: the channel's current buffered count, never above its capacity.
      while (i < n) {
        gcMarkConservative(g, chanBufferedAt(ch, i))
        i = i + 1
      }
      spinRelease(lk)
    }
    addr = chanRegNext(ch)
  }
}

// Drive one stop-the-world collection whose root enumeration includes the chan
// registry — the LIVE call site #1602 built `chanScanRegistryRoots` for (#1610).
//
// This is the Bit port of the way `runtime/root/` collects: `runtime/gc/`'s `collect`
// brackets the root scan with begin/finish, and `runtime/root/`'s `scanRoots` marks
// `chan.WordChan.scanRegistryRoots(markChanWord)` FIRST and then the precise
// stack roots. Here the same order is a single driven step: reset the worklist
// (`gcMarkBegin`), push every registered `isRef` channel's buffered payloads
// (`chanScanRegistryRoots`), push the caller's `n` precise roots at `rootsAddr`
// (the stack slots the stack maps name, ABI.md §4 — the collector validates each
// through `gcMarkConservative`), then drain, sweep and reschedule
// (`gcCollectFinish`). Omitting the registry scan here sweeps a live buffered
// channel's payloads out from under it — the exact defect `_tests_/stress/
// chanroots` reddens to when this line is removed.
//
// WHY THIS LIVES WITH THE CHANNEL, NOT THE COLLECTOR. `runtime/gc` is a pure
// collector that never imports `../chan` (so the lean `gcbit`
// freestanding build stays chan-free and the `gc <- chan` direction is not
// inverted), and `runtime/root` cannot import `../chan` either (chan imports
// root's `allocBuf`, and root importing chan back would be a module cycle). The
// only module that can see BOTH the collector's phase pair and its own registry
// scan without a cycle is `chan` itself, which already reaches across into the
// collector's mark door — so the composition the STW quiescent point runs is
// hosted here and PUSHES into the collector, exactly as `chanScanRegistryRoots`
// does. The STW barrier (`runtime/gc/gcworld.bit`'s rendezvous/restart) wraps a
// real call and is the root orchestrator's (#1367) concern; this is the
// enumeration inside it, not a duplicate barrier.
//
// PINNED (ABI.md §9): a separately-emitted object (the interim harness today,
// the Bit root orchestrator at #1584/G3) links this by its emitted symbol.
export @nosplit @symbol("bit_rt_port_chan_drive_collection") fn chanDriveCollection(g: *i64, reg: *i64, rootsAddr: int, n: int) {
  gcMarkBegin(g)
  chanScanRegistryRoots(g, reg)
  let i = 0
  // Bounded: exactly `n` precise roots the caller supplied.
  while (i < n) {
    gcMarkConservative(g, loadWord(rootsAddr + i * 8))
    i = i + 1
  }
  gcCollectFinish(g)
}
