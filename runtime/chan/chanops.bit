// The blocking channel operations — setup, send, receive and close (#1503).
// Split out of `./chan.bit`; sibling file, so the same module — no import needed.

// ---------------------------------------------------------------------------
// Setup
// ---------------------------------------------------------------------------

// Prepare a channel over caller-owned storage. `bufAddr` addresses `cap` words
// and is ignored when `cap` is 0 (the unbuffered case, where `count < cap` is
// `0 < 0` and every value moves by direct handoff — `runtime/chan/` needs no special
// case for it either).
export @nosplit fn chanInit(ch: *i64, bufAddr: int, capacity: int, isRef: bool, s: *i64) {
  atomicStore(spinCellAt(ch, chLock), 0)
  *(ch + chClosed) = 0
  *(ch + chBuf) = bufAddr
  *(ch + chCap) = capacity
  *(ch + chHead) = 0
  *(ch + chCount) = 0
  *(ch + chSendHead) = 0
  *(ch + chSendTail) = 0
  *(ch + chRecvHead) = 0
  *(ch + chRecvTail) = 0
  if (isRef) {
    *(ch + chIsRef) = 1
  } else {
    *(ch + chIsRef) = 0
  }
  *(ch + chRegNext) = 0
  *(ch + chSched) = int(s)
}

// ---------------------------------------------------------------------------
// Blocking send
// ---------------------------------------------------------------------------
//
// Returns false for "send on a closed channel", which `runtime/chan/` reports by
// panicking. See the header: `panic` is not reachable from a `@nosplit` body,
// and the ABI wrapper raises it. Both panic points are checked
// here in the same two places — before attempting, and after being woken by a
// `close` that found this sender queued.
//
// MUST BE CALLED FROM TASK CODE. Off a task `schedCurrentTask` returns 0 and
// the scratch lookup faults, which is `runtime/sched`'s stated contract for
// every function that can park and the honest equivalent of `runtime/chan/`'s
// `sched.park` on a non-task thread.
export @nosplit fn chanSend(ch: *i64, value: int): bool {
  let cell = spinCellAt(ch, chLock)
  spinAcquire(cell)
  if (*(ch + chClosed) != 0) {
    spinRelease(cell)
    return false
  }

  // UNCONTENDED FAST PATH (#3318). Exactly `attemptSend`'s second arm, with the
  // first arm's whole call chain skipped rather than reimplemented: when the
  // receive queue is EMPTY, `tryHandoffToReceiver` can only pop nothing and
  // return false, so `pushBuf` is what runs either way and the answer is
  // identical by construction. The guard is deliberately stricter than
  // "`tryHandoffToReceiver` would fail" — a queue holding only unclaimable
  // (losing-select) waiters also fails, and that case correctly falls through to
  // the general path below rather than being duplicated here.
  //
  // It buys three calls: `attemptSend`, `tryHandoffToReceiver` and its `wqPop`.
  // The scheduler pointer moves down with them: `s` is used only by the arms
  // that can wake a peer, so an uncontended send no longer loads `chSched` and
  // converts it at all.
  if (*(ch + chRecvHead) == 0 && *(ch + chCount) < *(ch + chCap)) {
    pushBuf(ch, value)
    spinRelease(cell)
    return true
  }

  let s = taskAt(*(ch + chSched))
  if (attemptSend(ch, value, s)) {
    spinRelease(cell)
    return true
  }

  // Blocked. Register under the SAME lock acquisition that just observed the
  // channel unable to take the value — that adjacency is what removes the
  // recheck `runtime/chan/` needs inside its park callback (see the header).
  let task = schedCurrentTask()
  let scr = scratchOf(task)
  *(scr + scrElem) = value
  *(scr + scrOk) = 0
  let w = nodeAt(scr, 0)
  *(w + wTask) = task
  *(w + wElem) = int(scr + scrElem)
  *(w + wOk) = int(scr + scrOk)
  *(w + wSelect) = 0
  *(w + wCase) = 0
  wqPush(ch, chSendHead, w)

  // Never hold a spinlock across the context switch: the holder stops running,
  // and every spinner is `@nosplit` and so cannot yield.
  spinRelease(cell)
  schedPark()

  let ok = *(scr + scrOk)
  return ok != 0
}

// ---------------------------------------------------------------------------
// Blocking receive
// ---------------------------------------------------------------------------
//
// Writes the received value through `valueOut` and returns `ok` — false meaning
// the channel was closed and drained, with the zero word written. `runtime/chan/`
// returns both in a `RecvResult` struct; a two-word return is the shape ABI.md
// §11 gives `bit_rt_chan_recv`, and splitting it into an out-parameter plus a
// bool is how that lands on a `@nosplit` Bit signature without a struct return.
//
// ---------------------------------------------------------------------------
// A FAILED RECEIVE PARKS IMMEDIATELY, AND A BOUNDED SPIN WAS MEASURED AND
// REJECTED — #3320. DO NOT ADD ONE BACK WITHOUT REDOING THE MEASUREMENT.
// ---------------------------------------------------------------------------
//
// The proposal was Go's `sync.Mutex` shape: `stdlib/sync`'s Mutex is `<- token`
// on a capacity-1 channel, so every contended acquire pays a full park + wake
// round trip, and a holder releases within a few hundred instructions. Measured
// on f333d877, arm64/macOS, 64 green threads x 10000 acquisitions of one Mutex,
// medians of 9, instructions retired: 2296 per acquisition contended against
// 853 uncontended, flat in worker count, `sys` 0.00 throughout. The 1443
// difference is the round trip.
//
// IT WAS BUILT AND IT LOST AT EVERY BUDGET. Release the lock (holding it across
// a spin livelocks the sender), poll the channel words read-only, re-acquire,
// re-attempt, then fall through to the park below. Instructions retired per
// acquisition, 2-task case — the only shape where the spin is even eligible,
// see the next paragraph:
//
//   no spin  2291   (1 turn x 1 poll)  2682   (1 x 4)  2805
//                   (4 x 24)           7227   (8 x 64) 10591
//
// Strictly increasing. The cheapest possible spin — one re-attempt — already
// costs 391 instructions and catches nothing, so there is no budget to tune
// down to. Cycles agree with instructions (450 -> 1607 per acquisition at
// 8 x 64), so this is not an artifact of counting instructions.
//
// WHY IT CANNOT CATCH, WHICH IS STRUCTURAL AND NOT A TUNING FAILURE. A spinner
// has left the wait queue, and `attemptSend` tries `tryHandoffToReceiver`
// BEFORE `pushBuf` — so while any receiver is queued, every send is consumed by
// the queue and the buffer, the only route a spinner can win by, is never
// reached. Above ~8 contending tasks the queue is never empty and the spin is
// dead code. Below that the queue does empty, and the spin still loses: the
// releasing task re-enters `chanRecv` and pops its own token back out of the
// buffer before a polling peer can see it.
//
// THE RATIO THAT DECIDES IT, and it is the number to re-derive rather than this
// verdict. Parking costs 1443 instructions to cover a 460-cycle wait — 3.1
// instructions per cycle waited. Spinning was measured at 6.6 instructions per
// cycle waited, so it is 2.1x the cost of parking per unit of wait and loses
// even at a 100% catch rate on any wait over ~220 cycles; a Mutex handoff here
// is 460.
//
// AND THAT RATIO IS A CODEGEN NUMBER, WHICH IS WHY THIS MAY BE WORTH REVISITING.
// One poll iteration — three loads, three compares, a `yield` — assembles to
// ~41 instructions (confirmed twice: by `objdump` on `runtime_chan.o`, and as
// the slope between the 1-poll and 4-poll builds). Twelve of those are register
// `mov`s, six are branches to the next address, and the loop bound is
// re-materialised with `mov x0, #0x18` on every iteration. At the 4 instructions
// clang emits for the same loop the ratio inverts and the spin wins outright.
// So the blocker is #1852 (copy-propagate SSA moves) and #1853 (fold small
// constants into immediates), not this function — re-measure after those land.
export @nosplit fn chanRecv(ch: *i64, valueOut: *i64): bool {
  let cell = spinCellAt(ch, chLock)
  spinAcquire(cell)

  // UNCONTENDED FAST PATH (#3318). Exactly `attemptRecv`'s first arm, with the
  // call chain skipped rather than reimplemented: when the send queue is EMPTY,
  // `promoteQueuedSender` can only pop nothing and return, so a buffered value
  // is delivered identically either way. The added `chSendHead == 0` test is
  // what makes that equivalence hold by construction instead of by argument —
  // a non-empty send queue falls through to the general path unchanged, which
  // is also what preserves FIFO across the buffer.
  //
  // It buys three calls: `attemptRecv`, `promoteQueuedSender` and its `wqPop`.
  // `s` moves to the slow path with them — the scheduler is only ever needed to
  // wake a peer, and this arm wakes nobody.
  if (*(ch + chCount) > 0 && *(ch + chSendHead) == 0) {
    *valueOut = popBuf(ch)
    spinRelease(cell)
    return true
  }

  let s = taskAt(*(ch + chSched))
  let st = attemptRecv(ch, valueOut, s)
  if (st != rcvNone) {
    spinRelease(cell)
    return st == rcvValue
  }

  // Only the blocking path needs a task: the value slot moves to the per-task
  // scratch so that the waker has somewhere stable to write it, `valueOut`
  // being a caller frame that is about to be suspended.
  let task = schedCurrentTask()
  let scr = scratchOf(task)
  let w = nodeAt(scr, 0)
  *(w + wTask) = task
  *(w + wElem) = int(scr + scrElem)
  *(w + wOk) = int(scr + scrOk)
  *(w + wSelect) = 0
  *(w + wCase) = 0
  wqPush(ch, chRecvHead, w)
  spinRelease(cell)
  schedPark()

  *valueOut = *(scr + scrElem)
  let ok = *(scr + scrOk)
  return ok != 0
}

// ---------------------------------------------------------------------------
// Close
// ---------------------------------------------------------------------------
//
// Wakes EVERY blocked peer — receivers with `(zero, false)`, senders with the
// `ok` that makes them report "send on closed channel". Returns false for
// "close of a closed channel", the second panic point.
//
// TEARDOWN IS THE POINT OF THIS FUNCTION, and this project has already paid for
// getting it wrong: a QUIC test hung because teardown never released its
// `read`/`finish`/`acceptStream` waiters, and because `finish` drained on
// packets rather than bytes — a condition a departed peer can never satisfy. So
// both loops here drain their queue to empty rather than waking a bounded batch,
// and neither waits on any condition another party must still supply. After
// this returns, both queues are empty and every task that was on them is
// runnable.
//
// Safe from a non-task thread: it never parks, and it reaches the scheduler
// through the channel's own `sched` field rather than through the caller.
export @nosplit fn chanClose(ch: *i64): bool {
  let s = taskAt(*(ch + chSched))
  spinAcquire(spinCellAt(ch, chLock))
  if (*(ch + chClosed) != 0) {
    spinRelease(spinCellAt(ch, chLock))
    return false
  }
  *(ch + chClosed) = 1

  let n = 0
  while (n < chanMaxWaiters) {
    let addr = wqPop(ch, chRecvHead)
    if (addr == 0) {
      n = chanMaxWaiters
    } else {
      let w = taskAt(addr)
      if (claim(w)) {
        *(taskAt(*(w + wElem))) = 0
        *(taskAt(*(w + wOk))) = 0
        finish(s, w)
      }
      n = n + 1
    }
  }

  let m = 0
  while (m < chanMaxWaiters) {
    let addr = wqPop(ch, chSendHead)
    if (addr == 0) {
      m = chanMaxWaiters
    } else {
      let w = taskAt(addr)
      if (claim(w)) {
        *(taskAt(*(w + wOk))) = 0
        finish(s, w)
      }
      m = m + 1
    }
  }

  spinRelease(spinCellAt(ch, chLock))
  return true
}

// Whether the channel is closed. Not a `runtime/chan/` export — added because the
// root-scanning cursor and the tests need to observe the flag without taking
// the lock, and a plain load of a word that only ever goes 0 -> 1 is race-free
// in the only direction that matters.
export @nosplit fn chanClosed(ch: *i64): bool {
  return *(ch + chClosed) != 0
}

// How many values are currently buffered. `len(ch)` in spec terms.
export @nosplit fn chanCount(ch: *i64): int {
  return *(ch + chCount)
}
