// The blocking channel operations — setup, send, receive and close (#1503).
// Split out of `./chan.bit`; sibling file, so the same module — no import needed.

// ---------------------------------------------------------------------------
// Setup
// ---------------------------------------------------------------------------

// Prepare a channel over caller-owned storage. `bufAddr` addresses `cap` words
// and is ignored when `cap` is 0 (the unbuffered case, where `count < cap` is
// `0 < 0` and every value moves by direct handoff — `runtime/chan/` needs no special
// case for it either).
export @nosplit fn chanInit(ch: *i64, bufAddr: int, capacity: int, isRef: bool, s: *i64) {
  atomicStore(spinCellAt(ch, chLock), 0)
  *(ch + chClosed) = 0
  *(ch + chBuf) = bufAddr
  *(ch + chCap) = capacity
  *(ch + chHead) = 0
  *(ch + chCount) = 0
  *(ch + chSendHead) = 0
  *(ch + chSendTail) = 0
  *(ch + chRecvHead) = 0
  *(ch + chRecvTail) = 0
  if (isRef) {
    *(ch + chIsRef) = 1
  } else {
    *(ch + chIsRef) = 0
  }
  *(ch + chRegNext) = 0
  *(ch + chSched) = int(s)
}

// ---------------------------------------------------------------------------
// Blocking send
// ---------------------------------------------------------------------------
//
// Returns false for "send on a closed channel", which `runtime/chan/` reports by
// panicking. See the header: `panic` is not reachable from a `@nosplit` body,
// and the ABI wrapper raises it. Both panic points are checked
// here in the same two places — before attempting, and after being woken by a
// `close` that found this sender queued.
//
// MUST BE CALLED FROM TASK CODE. Off a task `schedCurrentTask` returns 0 and
// the scratch lookup faults, which is `runtime/sched`'s stated contract for
// every function that can park and the honest equivalent of `runtime/chan/`'s
// `sched.park` on a non-task thread.
export @nosplit fn chanSend(ch: *i64, value: int): bool {
  let s = taskAt(*(ch + chSched))
  spinAcquire(spinCellAt(ch, chLock))
  if (*(ch + chClosed) != 0) {
    spinRelease(spinCellAt(ch, chLock))
    return false
  }
  if (attemptSend(ch, value, s)) {
    spinRelease(spinCellAt(ch, chLock))
    return true
  }

  // Blocked. Register under the SAME lock acquisition that just observed the
  // channel unable to take the value — that adjacency is what removes the
  // recheck `runtime/chan/` needs inside its park callback (see the header).
  let task = schedCurrentTask()
  let scr = scratchOf(task)
  *(scr + scrElem) = value
  *(scr + scrOk) = 0
  let w = nodeAt(scr, 0)
  *(w + wTask) = task
  *(w + wElem) = int(scr + scrElem)
  *(w + wOk) = int(scr + scrOk)
  *(w + wSelect) = 0
  *(w + wCase) = 0
  wqPush(ch, chSendHead, w)

  // Never hold a spinlock across the context switch: the holder stops running,
  // and every spinner is `@nosplit` and so cannot yield.
  spinRelease(spinCellAt(ch, chLock))
  schedPark()

  let ok = *(scr + scrOk)
  return ok != 0
}

// ---------------------------------------------------------------------------
// The bounded receive spin (#3320)
// ---------------------------------------------------------------------------
//
// A receive that finds nothing used to park immediately. `stdlib/sync`'s Mutex
// is `<- token` on a capacity-1 channel, so every contended acquire paid a full
// park + wake round trip: measured at 2296 instructions retired per acquisition
// against 853 uncontended, on 64 green threads x 10000 acquisitions of one
// Mutex, arm64/macOS, medians of 9 (#3317's table, reproduced on f333d877).
// The ~1450-instruction difference is the round trip, and `sys` is 0.00, so all
// of it is userspace.
//
// A lock handoff is the case a spin is built for: the holder is about to
// release, and if it does so while we are still looking, `attemptSend` finds no
// queued receiver, puts the value in the buffer, and our next attempt pops it —
// no park, no unpark, no context switch.
//
// WHY A SPINNER CANNOT OVERTAKE A QUEUED RECEIVER, which is the whole reason
// this does not change observable order. `attemptSend` tries
// `tryHandoffToReceiver` FIRST and only reaches `pushBuf` when the receive
// queue holds nothing claimable. So the buffer — the only route a spinner can
// win by — is unreachable while anyone is queued ahead of it. Wait-queue FIFO
// is preserved exactly; the spin only fills a gap where the queue is empty.
//
// WHY THE LOCK IS RELEASED FIRST. Spinning while holding `chLock` would block
// the sender from taking the lock it needs to complete the very handoff being
// waited for: a livelock, not a slow path. The spin therefore holds nothing,
// and the loop re-acquires only to attempt.
//
// WHY IT IS TWO BOUNDS AND NOT ONE. Re-acquiring the lock costs an exclusive
// compare-and-exchange, which takes the cache line away from every other core
// INCLUDING THE HOLDER — the effect #2321 removed from `spinAcquire` itself by
// making it test-and-test-and-set. Doing that on every turn would slow the
// critical section down for everyone. So the outer bound counts lock
// acquisitions and stays small, while the inner wait is a read-only poll of
// words the sender writes; a plain load keeps the line shared and costs the
// holder nothing.
//
// WHY THESE NUMBERS. 4 x 24 is Go's `sync.Mutex` shape (`active_spin` 4,
// `procyield(30)` per turn) at the same order of magnitude, and it is what the
// measurement supports here: the window between our failed attempt and the
// token reaching the buffer is one critical section, ~100 cycles on this
// machine, which 4 acquisitions spaced by 24 hint instructions covers with
// room to spare. Larger budgets do not catch more — past the point where the
// holder would have released, a spinner is waiting on a task that has to be
// SCHEDULED first, which no bounded spin can cover — they only add waste, and
// that waste is paid by every worker at once, so it is the term that would
// reintroduce a scaling cost in worker count. Setting `chanRecvSpinTurns` to 0
// restores the previous behaviour instruction for instruction: the loop below
// then runs its body exactly once and never releases the lock.
const chanRecvSpinTurns: int = 4
const chanRecvSpinPolls: int = 24

// PAUSE (x64) / YIELD (arm64), the spin-wait hint, pre-encoded per SPEC §11.6
// exactly as `chanWake`'s loop in `./chan.bit` carries it. Signals the core and
// touches no register or memory, so the block declares no input, result or
// clobber.
@nosplit fn chanSpinHint() {
  asm volatile {
    arm64 { 0xD503203F }
    x64   { 0xF3, 0x90 }
  }
}

// Read-only wait for the channel to look receivable, bounded by
// `chanRecvSpinPolls`. Takes no lock and writes nothing, so it can be wrong in
// both directions and neither is a race: a stale "not ready" costs one turn of
// the outer loop, and a stale "ready" costs one failed `attemptRecv`. Exclusion
// is still established solely by `chLock` in the caller.
@nosplit fn chanRecvSpinWait(ch: *i64) {
  let n = 0
  while (n < chanRecvSpinPolls) {
    if (*(ch + chCount) > 0 || *(ch + chSendHead) != 0 || *(ch + chClosed) != 0) {
      return
    }
    chanSpinHint()
    n = n + 1
  }
}

// Whether a failed receive should spin before parking. The channel lock must be
// held: the queue head is read under it.
//
// Two refusals, and both are necessary conditions for the spin to be able to
// win at all rather than tuning knobs.
//
// NOT WITH ONE WORKER. A spin waits for another thread to make progress in
// parallel; with a single worker the holder is a green thread on THIS thread,
// which cannot run until we park, so the spin is guaranteed to fail and the
// whole budget is pure loss. Go's `sync_runtime_canSpin` refuses on `ncpu <= 1`
// for the same reason.
//
// NOT WITH A RECEIVER ALREADY QUEUED, which is the load-bearing one and was
// measured, not reasoned. A spinner can only be served through the buffer, and
// `attemptSend` reaches `pushBuf` only after `tryHandoffToReceiver` finds
// nothing claimable — so while anyone is queued, every send is consumed by the
// queue and the spin provably cannot be served. Without this test the 64-thread
// single-Mutex workload (where the queue holds ~63 waiters at all times) went
// from 2296 to 7417 instructions retired per acquisition, 3.2x WORSE: every
// waiter burnt its whole budget, never won, and parked anyway — and the polling
// loads land on the same cache line as `chLock`, so they also stole the line
// back from the holder's compare-and-exchange, which is #2321's finding
// arriving from the other direction. The queue emptiness test is what keeps the
// spin to the case it was built for.
@nosplit fn chanRecvMaySpin(ch: *i64, s: *i64): bool {
  if (*(ch + chRecvHead) != 0) {
    return false
  }
  return *(s + scNWorkers) > 1
}

// ---------------------------------------------------------------------------
// Blocking receive
// ---------------------------------------------------------------------------
//
// Writes the received value through `valueOut` and returns `ok` — false meaning
// the channel was closed and drained, with the zero word written. `runtime/chan/`
// returns both in a `RecvResult` struct; a two-word return is the shape ABI.md
// §11 gives `bit_rt_chan_recv`, and splitting it into an out-parameter plus a
// bool is how that lands on a `@nosplit` Bit signature without a struct return.
export @nosplit fn chanRecv(ch: *i64, valueOut: *i64): bool {
  let s = taskAt(*(ch + chSched))

  // Attempt, then spin and re-attempt up to `chanRecvSpinTurns` times before
  // giving up and parking — see the section above for why the lock is dropped
  // across every wait and why a spinner can never overtake a queued receiver.
  //
  // Bounded by construction: `turns` only ever rises, so the body runs at most
  // `chanRecvSpinTurns + 1` times. The eligibility test is re-read every turn
  // rather than once, so a receiver that queues up while we are spinning ends
  // the spin on the next attempt instead of letting us burn the rest of a
  // budget we can no longer win.
  let turns = 0
  let st = rcvNone
  while (turns <= chanRecvSpinTurns) {
    spinAcquire(spinCellAt(ch, chLock))
    st = attemptRecv(ch, valueOut, s)
    if (st != rcvNone) {
      spinRelease(spinCellAt(ch, chLock))
      return st == rcvValue
    }
    if (turns < chanRecvSpinTurns && chanRecvMaySpin(ch, s)) {
      spinRelease(spinCellAt(ch, chLock))
      chanRecvSpinWait(ch)
      turns = turns + 1
    } else {
      turns = chanRecvSpinTurns + 1
    }
  }

  // The loop falls out still HOLDING the lock, with `rcvNone` observed under
  // that same acquisition. That adjacency is what removes the recheck the park
  // race argument in `./chan.bit` would otherwise need, and it is why the last
  // turn deliberately does not release.
  //
  // Only the blocking path needs a task: the value slot moves to the per-task
  // scratch so that the waker has somewhere stable to write it, `valueOut`
  // being a caller frame that is about to be suspended.
  let task = schedCurrentTask()
  let scr = scratchOf(task)
  let w = nodeAt(scr, 0)
  *(w + wTask) = task
  *(w + wElem) = int(scr + scrElem)
  *(w + wOk) = int(scr + scrOk)
  *(w + wSelect) = 0
  *(w + wCase) = 0
  wqPush(ch, chRecvHead, w)
  spinRelease(spinCellAt(ch, chLock))
  schedPark()

  *valueOut = *(scr + scrElem)
  let ok = *(scr + scrOk)
  return ok != 0
}

// ---------------------------------------------------------------------------
// Close
// ---------------------------------------------------------------------------
//
// Wakes EVERY blocked peer — receivers with `(zero, false)`, senders with the
// `ok` that makes them report "send on closed channel". Returns false for
// "close of a closed channel", the second panic point.
//
// TEARDOWN IS THE POINT OF THIS FUNCTION, and this project has already paid for
// getting it wrong: a QUIC test hung because teardown never released its
// `read`/`finish`/`acceptStream` waiters, and because `finish` drained on
// packets rather than bytes — a condition a departed peer can never satisfy. So
// both loops here drain their queue to empty rather than waking a bounded batch,
// and neither waits on any condition another party must still supply. After
// this returns, both queues are empty and every task that was on them is
// runnable.
//
// Safe from a non-task thread: it never parks, and it reaches the scheduler
// through the channel's own `sched` field rather than through the caller.
export @nosplit fn chanClose(ch: *i64): bool {
  let s = taskAt(*(ch + chSched))
  spinAcquire(spinCellAt(ch, chLock))
  if (*(ch + chClosed) != 0) {
    spinRelease(spinCellAt(ch, chLock))
    return false
  }
  *(ch + chClosed) = 1

  let n = 0
  while (n < chanMaxWaiters) {
    let addr = wqPop(ch, chRecvHead)
    if (addr == 0) {
      n = chanMaxWaiters
    } else {
      let w = taskAt(addr)
      if (claim(w)) {
        *(taskAt(*(w + wElem))) = 0
        *(taskAt(*(w + wOk))) = 0
        finish(s, w)
      }
      n = n + 1
    }
  }

  let m = 0
  while (m < chanMaxWaiters) {
    let addr = wqPop(ch, chSendHead)
    if (addr == 0) {
      m = chanMaxWaiters
    } else {
      let w = taskAt(addr)
      if (claim(w)) {
        *(taskAt(*(w + wOk))) = 0
        finish(s, w)
      }
      m = m + 1
    }
  }

  spinRelease(spinCellAt(ch, chLock))
  return true
}

// Whether the channel is closed. Not a `runtime/chan/` export — added because the
// root-scanning cursor and the tests need to observe the flag without taking
// the lock, and a plain load of a word that only ever goes 0 -> 1 is race-free
// in the only direction that matters.
export @nosplit fn chanClosed(ch: *i64): bool {
  return *(ch + chClosed) != 0
}

// How many values are currently buffered. `len(ch)` in spec terms.
export @nosplit fn chanCount(ch: *i64): int {
  return *(ch + chCount)
}
