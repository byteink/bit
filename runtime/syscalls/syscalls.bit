// --------------------------------------------------------------------------
// THE ASYMMETRIC CALLS
// --------------------------------------------------------------------------
//
// aarch64's generic syscall table carries no `open`, `mkdir`, `unlink`, `rmdir`,
// `chmod` or `readlink`. Only the `*at` forms exist, and each takes a leading
// directory fd, so the ARGUMENT LIST differs — not just the number. A caller
// must therefore branch on the call SHAPE, which is why these are exported
// per-arch rather than folded into one function. `AT_FDCWD` is the dirfd that
// makes an `*at` form behave like its plain counterpart.

// AT_FDCWD: resolve a relative path against the current working directory.
export @nosplit @symbol("bit_rt_port_syscalls_at_fd_cwd")
fn sysAtFdCwd(): int { return -100 }

// open(path, flags, mode) — x86-64 only.
export @nosplit @symbol("bit_rt_port_syscalls_open_x64")
fn sysOpenX64(): int { return 2 }
// openat(dirfd, path, flags, mode) — aarch64.
export @nosplit @symbol("bit_rt_port_syscalls_openat_arm64")
fn sysOpenatArm64(): int { return 56 }

// mkdir(path, mode) — x86-64 only.
export @nosplit @symbol("bit_rt_port_syscalls_mkdir_x64")
fn sysMkdirX64(): int { return 83 }
// mkdirat(dirfd, path, mode) — aarch64.
export @nosplit @symbol("bit_rt_port_syscalls_mkdirat_arm64")
fn sysMkdiratArm64(): int { return 34 }

// unlink(path) and rmdir(path) — x86-64 only, and two distinct calls.
export @nosplit @symbol("bit_rt_port_syscalls_unlink_x64")
fn sysUnlinkX64(): int { return 87 }
export @nosplit @symbol("bit_rt_port_syscalls_rmdir_x64")
fn sysRmdirX64(): int { return 84 }
// unlinkat(dirfd, path, flags) — aarch64 spells BOTH of the above, choosing
// between them with AT_REMOVEDIR in `flags`.
export @nosplit @symbol("bit_rt_port_syscalls_unlinkat_arm64")
fn sysUnlinkatArm64(): int { return 35 }

// chmod(path, mode) — x86-64 only.
export @nosplit @symbol("bit_rt_port_syscalls_chmod_x64")
fn sysChmodX64(): int { return 90 }
// fchmodat(dirfd, path, mode) — aarch64.
export @nosplit @symbol("bit_rt_port_syscalls_fchmodat_arm64")
fn sysFchmodatArm64(): int { return 53 }

// readlink(path, buf, size) — x86-64 only.
export @nosplit @symbol("bit_rt_port_syscalls_readlink_x64")
fn sysReadlinkX64(): int { return 89 }
// readlinkat(dirfd, path, buf, size) — aarch64.
export @nosplit @symbol("bit_rt_port_syscalls_readlinkat_arm64")
fn sysReadlinkatArm64(): int { return 78 }

// fork() — x86-64 only. aarch64 has no `fork`; it spells the same thing as
// `clone(SIGCHLD, 0)`, i.e. `sysClone()` with those arguments.
export @nosplit @symbol("bit_rt_port_syscalls_fork_x64")
fn sysForkX64(): int { return 57 }
