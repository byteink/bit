// setpgid(pid, pgid) — same two-arg shape on both arches, unlike fork/readlink
// above. Used by `../root/linux/os.bit`'s `osForkExecWaitBounded` (#2986) to
// put a bounded child in its own process group so a timeout can signal the
// whole group, not just the direct child.
export @nosplit @symbol("bit_rt_port_syscalls_setpgid")
fn sysSetpgid(): int {
  if (onX64()) { return 109 }
  return 154
}

// exit_group(2), NOT exit(2), and the difference is load-bearing: `exit`
// (60 / 93) terminates the CALLING THREAD only, leaving the other workers
// running and the process alive after a panic.
export @nosplit @symbol("bit_rt_port_syscalls_exit_group")
fn sysExitGroup(): int {
  if (onX64()) { return 231 }
  return 94
}

