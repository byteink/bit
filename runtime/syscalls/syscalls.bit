  if (onX64()) { return 8 }
  return 62
}

export @nosplit @symbol("bit_rt_port_syscalls_fcntl")
fn sysFcntl(): int {
  if (onX64()) { return 72 }
  return 25
}

export @nosplit @symbol("bit_rt_port_syscalls_getdents64")
fn sysGetdents64(): int {
  if (onX64()) { return 217 }
  return 61
}

