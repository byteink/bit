// The default subject for `bench/objprobe/objprobe.sh` (#3847, epic #2945):
// allocation churn whose OBJECT BODY WIDTH is selectable, and nothing else.
//
// WHY THE THREE ARMS ARE SEPARATE CLASSES. A body width is a compile-time
// property of a class, so it cannot be a runtime argument the way the object
// count can. The three `run*` functions below are therefore near-identical on
// purpose, and the duplication is the measurement: `runW2`, `runW6` and `runW8`
// differ ONLY in how many `i64` fields sit between `a` and `o`. Everything else
// -- batch count, per-batch count, allocation site, iteration, and the summed
// checksum -- is byte-for-byte the same, so a difference the probe reports
// between two arms is attributable to the body and to nothing else.
//
// THE CHECKSUM IS THE CONTROL. All three arms sum `a + o.id` and ignore the
// padding fields, so all three print the SAME total for the same argument. The
// probe compares those totals across arms and refuses a mutation proof where
// they differ -- two programs computing different answers are not a controlled
// mutation, they are two programs.
//
// `o: Owner` IS LOAD-BEARING, exactly as in bench/cases/alloc: a class whose
// fields are all scalars is packed inline into the slice's own buffer (#3862),
// so a `[]Node` of pure `i64` fields allocates NO per-element objects at all
// and this program would silently stop measuring the allocator (#3934 is that
// failure, live for a day). A reference field rules packing out structurally --
// runtime/ABI.md SS2, "a buffer whose element type has ANY reference field ...
// stays word-per-element unconditionally". The probe checks it anyway: it reads
// the object count back from `BIT_GC_STATS` rather than trusting the argument.
//
// USAGE: `subject <count> [<width>]`, width in {16, 48, 64} bytes of body,
// default 16. `<count>` is the number of nodes to allocate; 0 is legal and
// allocates none, which is what gives the probe its empty-program floor from
// this very binary rather than from a different one.
import { args, exit } from "std/os"
import { parseInt } from "std/strings"

// The per-batch owner. One per batch, so it is a rounding error against the
// `per`-sized node population it keeps alive.
class Owner { id: i64 }

// 16-byte body: one payload word plus the owner reference.
class W2 { a: i64, o: Owner }
// 48-byte body: the same two fields, four filler words between them.
class W6 { a: i64, p1: i64, p2: i64, p3: i64, p4: i64, o: Owner }
// 64-byte body: the same two fields, six filler words between them.
class W8 { a: i64, p1: i64, p2: i64, p3: i64, p4: i64, p5: i64, p6: i64, o: Owner }

// Batches of this many nodes. The live set is one batch plus its owner, so the
// collector has a real (small, constant) live population to mark on every cycle
// and the run is dominated by allocation and sweep -- the lifecycle epic #2945
// is about. Held at bench/cases/alloc's value so the two are comparable.
const perBatch = 5000

fn runW2(nodes: int): int {
  let total = 0
  let done = 0
  while (done < nodes) {
    let n = batchSize(nodes, done)
    let owner = Owner{ id: done }
    let buf = []W2(0, n)
    let k = 0
    while (k < n) {
      buf = append(buf, W2{ a: done + k, o: owner })
      k = k + 1
    }
    for nd of buf {
      total = total + nd.a + nd.o.id
    }
    done = done + n
  }
  return total
}

fn runW6(nodes: int): int {
  let total = 0
  let done = 0
  while (done < nodes) {
    let n = batchSize(nodes, done)
    let owner = Owner{ id: done }
    let buf = []W6(0, n)
    let k = 0
    while (k < n) {
      buf = append(buf, W6{ a: done + k, p1: k, p2: k, p3: k, p4: k, o: owner })
      k = k + 1
    }
    for nd of buf {
      total = total + nd.a + nd.o.id
    }
    done = done + n
  }
  return total
}

fn runW8(nodes: int): int {
  let total = 0
  let done = 0
  while (done < nodes) {
    let n = batchSize(nodes, done)
    let owner = Owner{ id: done }
    let buf = []W8(0, n)
    let k = 0
    while (k < n) {
      buf = append(buf, W8{ a: done + k, p1: k, p2: k, p3: k, p4: k, p5: k, p6: k, o: owner })
      k = k + 1
    }
    for nd of buf {
      total = total + nd.a + nd.o.id
    }
    done = done + n
  }
  return total
}

// Nodes remaining in this batch, capped at `perBatch`. A trailing partial batch
// is allowed so `<count>` is honoured exactly rather than rounded -- the probe
// divides by the object count it reads back, and a silently rounded count would
// make the marginal-slope isolation compare two populations it did not choose.
fn batchSize(nodes: int, done: int): int {
  let left = nodes - done
  if (left < perBatch) {
    return left
  }
  return perBatch
}

// `args()[0]` is the program name (std/os), so the count is `args()[1]` and the
// width `args()[2]`. Named `argInt` rather than `arg` because `std/os` already
// exports an `arg`, and a local shadowing it would read as that one.
fn argInt(i: int, dflt: int): int {
  let a = args()
  if (len(a) <= i) {
    return dflt
  }
  return parseInt(a[i]) catch _ {
    dflt
  }
}

fn main() {
  let nodes = argInt(1, 0)
  let width = argInt(2, 16)
  let total = 0
  if (width == 16) {
    total = runW2(nodes)
  } else {
    if (width == 48) {
      total = runW6(nodes)
    } else {
      if (width == 64) {
        total = runW8(nodes)
      } else {
        print("subject: unsupported width ${width}, want 16, 48 or 64\n")
        exit(2)
      }
    }
  }
  print("${total}\n")
}
