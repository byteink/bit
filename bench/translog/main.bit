// Transcendental parity oracle (#1609) — the SEAM 5b twin of bench/fptext (#1539).
//
// Proves the Bit ports of log2/log10/log/pow/atan2 (the SHIPPING pins in
// runtime/root/floats*.bit) agree BIT-FOR-BIT with the runtime builtins
// (flog2/flog10/flog/fpow/fatan2 = bit_rt_log2/log10/log/pow/atan2) over a corpus
// of structural edges, every biased exponent (both signs), a 500k xorshift sweep,
// and the function-specific domain edges (log(1)=+0, log(0)=-inf, log(neg)=nan,
// pow(0,0)=1, pow(-1,±inf)=1, negative-base integer/non-integer exponents,
// atan2 all quadrants + axes + signed zeros). NaN results are matched by class
// (both NaN); every finite/infinite result must match exactly. Mutation-tested:
// perturb any coefficient to a different f64 and that function's count goes
// non-zero.
//
// Run:  bit run bench/translog

import { rtLog2, rtLog10, rtLog, rtAtan2, rtPow } from "../../runtime/root"

function isNan(b: u64): bool {
  return (b & u64(0x7FF0000000000000)) == u64(0x7FF0000000000000) && (b & u64(0x000FFFFFFFFFFFFF)) != 0
}
function same(g: u64, e: u64): bool { return g == e || (isNan(g) && isNan(e)) }

let rngState = 0
function nextRand(): u64 {
  let s = u64(rngState)
  s = s ^ (s << 13)
  s = s ^ (s >> 7)
  s = s ^ (s << 17)
  rngState = int(s)
  return s
}

// One log input drives all three log functions; every result compared bit-exact.
function checkLog(x: f64, acc: []int) {
  if (!same(floatBits(rtLog2(x)), floatBits(flog2(x)))) { acc[0] = acc[0] + 1 }
  if (!same(floatBits(rtLog10(x)), floatBits(flog10(x)))) { acc[1] = acc[1] + 1 }
  if (!same(floatBits(rtLog(x)), floatBits(flog(x)))) { acc[2] = acc[2] + 1 }
  acc[3] = acc[3] + 1
}

function checkAtan2(y: f64, x: f64, a2: []int) {
  if (!same(floatBits(rtAtan2(y, x)), floatBits(fatan2(y, x)))) { a2[0] = a2[0] + 1 }
  a2[1] = a2[1] + 1
}

function checkPow(x: f64, y: f64, ap: []int) {
  if (!same(floatBits(rtPow(x, y)), floatBits(fpow(x, y)))) { ap[0] = ap[0] + 1 }
  ap[1] = ap[1] + 1
}

function main() {
  rngState = int(u64(0x243F6A8885A308D3))
  let acc = [0, 0, 0, 0]
  let edges = [u64(0x0), u64(0x8000000000000000), u64(0x1), u64(0x000FFFFFFFFFFFFF),
    u64(0x0010000000000000), u64(0x7FEFFFFFFFFFFFFF), u64(0x3FF0000000000000),
    u64(0xBFF0000000000000), u64(0x7FF0000000000000), u64(0xFFF0000000000000),
    u64(0x4005BF0A8B145769), u64(0x3FE0000000000000), u64(0x3FEFFFFFFFFFFFFF),
    u64(0x3FF0000000000001)]
  let ei = 0
  while (ei < len(edges)) { checkLog(bitsToFloat(edges[ei]), acc); ei = ei + 1 }
  let en = 0
  while (en < 2048) {
    let b = u64(en) << 52
    checkLog(bitsToFloat(b), acc)
    checkLog(bitsToFloat(b | (u64(1) << 63)), acc)
    en = en + 1
  }
  let n = 0
  while (n < 500000) { checkLog(bitsToFloat(nextRand()), acc); n = n + 1 }
  print("log_total=${acc[3]}\n")
  print("log2_mismatches=${acc[0]}\n")
  print("log10_mismatches=${acc[1]}\n")
  print("log_mismatches=${acc[2]}\n")

  // atan2: all quadrants + axes + signed zeros over a special set, then a sweep.
  let a2 = [0, 0]
  let sp = [0.0, -0.0, 1.0, -1.0, 2.0, -2.0, 0.5, -0.5,
    bitsToFloat(u64(0x7FF0000000000000)), bitsToFloat(u64(0xFFF0000000000000)),
    bitsToFloat(u64(0x7FF8000000000000)), 3.0, -3.0, 1e300, -1e300, 1e-300, -1e-300]
  let si = 0
  while (si < len(sp)) {
    let sj = 0
    while (sj < len(sp)) { checkAtan2(sp[si], sp[sj], a2); sj = sj + 1 }
    si = si + 1
  }
  // biased-exponent sweep of (y, x): reuse each exponent as both operands.
  let be = 0
  while (be < 2048) {
    let yb = bitsToFloat(u64(be) << 52)
    let xb = bitsToFloat((u64(be) << 52) | (u64(1) << 63))
    checkAtan2(yb, xb, a2)
    checkAtan2(xb, yb, a2)
    be = be + 1
  }
  // random (y, x) pair sweep.
  let m = 0
  while (m < 500000) {
    checkAtan2(bitsToFloat(nextRand()), bitsToFloat(nextRand()), a2)
    m = m + 1
  }
  print("atan2_total=${a2[1]}\n")
  print("atan2_mismatches=${a2[0]}\n")

  // pow: domain edges (pow(0,0)=1, pow(-1,±inf)=1, negative base with integer and
  // non-integer exponents, signed zeros, inf/nan axes) over a special grid, then
  // a sweep.
  let ap = [0, 0]
  let pb = [0.0, -0.0, 1.0, -1.0, 2.0, -2.0, 0.5, -0.5, 3.0, -3.0, 2.5, -2.5,
    0.1, -0.1, 10.0, -10.0, 100.0, -100.0,
    bitsToFloat(u64(0x7FF0000000000000)), bitsToFloat(u64(0xFFF0000000000000)),
    bitsToFloat(u64(0x7FF8000000000000)), 1e-300, -1e-300, 1e300, -1e300]
  let pi = 0
  while (pi < len(pb)) {
    let pj = 0
    while (pj < len(pb)) { checkPow(pb[pi], pb[pj], ap); pj = pj + 1 }
    pi = pi + 1
  }
  // integer and half-integer exponents against assorted bases (odd/even paths).
  let bi = 0
  while (bi < len(pb)) {
    let e = -20
    while (e <= 20) {
      checkPow(pb[bi], f64(e), ap)
      checkPow(pb[bi], f64(e) + 0.5, ap)
      e = e + 1
    }
    bi = bi + 1
  }
  // random (x, y) pair sweep.
  let pn = 0
  while (pn < 500000) {
    checkPow(bitsToFloat(nextRand()), bitsToFloat(nextRand()), ap)
    pn = pn + 1
  }
  print("pow_total=${ap[1]}\n")
  print("pow_mismatches=${ap[0]}\n")
}
