// Float text parity harness for SEAM 5 of the runtime port (#1369).
//
// Reads a corpus produced by the Zig oracle — one `<16 hex digits> <{d} text>`
// line per f64 bit pattern — and for every entry checks two things:
//
//   1. FORMAT PARITY: `fmtBits` produces the byte-identical string Zig's `{d}`
//      produced. Anything else flips a `const_float` IR dump, which is a
//      self-hosting gate.
//   2. ROUND TRIP: `parseBits` of that string returns the original bit pattern
//      exactly. A 1-ULP miss here is the failure that would not surface until
//      the fixpoint broke, long after the rename landed.
//
// NaN and infinity are excluded by the oracle rather than compared: the default
// NaN sign differs between x86-64 and AArch64, so an absolute bit-pattern
// comparison on them measures the host, not the code.

import { readFile } from "std/fs"
import { args } from "std/os"

function main() {
  let argv = args()
  let path = "corpus.txt"
  if (len(argv) > 1) { path = argv[1] }

  let data = readFile(path) catch e {
    print("cannot read " + path + "\n")
    return
  }
  let b = []byte(data)
  let n = len(b)

  let total = 0
  let fmtBad = 0
  let rtBad = 0
  let shown = 0

  let i = 0
  while (i < n) {
    // Line layout is fixed by the oracle: 16 hex digits, a space, the text.
    let end = i
    while (end < n && b[end] != byte(10)) { end = end + 1 }
    if (end - i < 18) { i = end + 1; continue }

    let bits = hexToU64(b, i)
    let want = string(b[i + 17:end])
    let got = fmtBits(bits)
    total = total + 1

    if (got != want) {
      fmtBad = fmtBad + 1
      if (shown < 20) {
        print("FMT  " + hexOf(bits) + " want=" + want + " got=" + got + "\n")
        shown = shown + 1
      }
    }

    let back = parseBits(want)
    if (back != bits) {
      rtBad = rtBad + 1
      if (shown < 20) {
        print("RT   " + hexOf(bits) + " reparsed=" + hexOf(back) + " text=" + want + "\n")
        shown = shown + 1
      }
    }

    i = end + 1
  }

  print("total=${total}\n")
  print("fmt_mismatches=${fmtBad}\n")
  print("roundtrip_mismatches=${rtBad}\n")
}

// Reads the 16 hex digits starting at `off`.
function hexToU64(b: []byte, off: i64): u64 {
  let v = u64(0)
  let i = 0
  while (i < 16) {
    let c = i64(b[off + i])
    let d = 0
    if (c >= 48 && c <= 57) {
      d = c - 48
    } else if (c >= 97 && c <= 102) {
      d = c - 87
    } else if (c >= 65 && c <= 70) {
      d = c - 55
    }
    v = (v << u64(4)) | u64(d)
    i = i + 1
  }
  return v
}

function hexOf(v: u64): string {
  let out = []byte(16)
  let i = 0
  while (i < 16) {
    let d = i64((v >> u64(60 - i * 4)) & u64(15))
    if (d < 10) { out[i] = byte(48 + d) } else { out[i] = byte(87 + d) }
    i = i + 1
  }
  return string(out)
}
