// Dense 512x512 f64 matrix multiply, C = A * B, i-k-j loop order for
// row-major cache locality -- float throughput and cache behaviour, a
// different axis from mandelbrot's transcendentals. Run for 6 trials (each
// trial's data offset by the trial index) and summed, purely so the fastest
// language clears /usr/bin/time -l's ~10ms measurement floor -- a single
// 512x512 multiply is sub-millisecond in optimized C. A and B hold small
// integer-valued doubles, so every product and partial sum in C stays
// exactly representable in a f64 mantissa (max ~98,304, far under 2^53):
// there is no rounding anywhere, so the result is bit-for-bit identical
// across compilers regardless of FMA contraction, and unlike mandelbrot no
// cross-language tolerance is needed. No BLAS or vectorized library on any
// side -- a plain triple loop in each language, to compare compiled float
// throughput, not a hand-optimized kernel.
fn main() {
  let n = 512
  let trials = 6
  let grandSum: i64 = 0
  let grandTrace: i64 = 0
  let lastFirst: i64 = 0
  let lastLast: i64 = 0

  let t = 0
  while (t < trials) {
    let a: []f64 = []f64(n * n)
    let b: []f64 = []f64(n * n)
    let c: []f64 = []f64(n * n)

    let i = 0
    while (i < n) {
      let j = 0
      while (j < n) {
        a[i * n + j] = f64((i + j + t) % 13)
        b[i * n + j] = f64((i * 2 + j * 3 + t) % 17)
        j = j + 1
      }
      i = i + 1
    }

    i = 0
    while (i < n) {
      let k = 0
      while (k < n) {
        let aik = a[i * n + k]
        let j = 0
        while (j < n) {
          c[i * n + j] = c[i * n + j] + aik * b[k * n + j]
          j = j + 1
        }
        k = k + 1
      }
      i = i + 1
    }

    let sum = 0.0
    let trace = 0.0
    i = 0
    while (i < n * n) {
      sum = sum + c[i]
      i = i + 1
    }
    let d = 0
    while (d < n) {
      trace = trace + c[d * n + d]
      d = d + 1
    }

    grandSum = grandSum + i64(sum)
    grandTrace = grandTrace + i64(trace)
    lastFirst = i64(c[0])
    lastLast = i64(c[n * n - 1])
    t = t + 1
  }

  print("${grandSum} ${grandTrace} ${lastFirst} ${lastLast}\n")
}
