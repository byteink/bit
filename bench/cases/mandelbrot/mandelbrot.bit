// Mandelbrot escape-time over a 1500x1500 grid, 500 max iterations.
// Prints the summed iteration count — a deterministic float-math checksum.
function main() {
  let w = 1500
  let h = 1500
  let maxIter = 500
  let sum = 0
  let py = 0
  while (py < h) {
    let y0 = f64(py) / f64(h) * 2.5 - 1.25
    let px = 0
    while (px < w) {
      let x0 = f64(px) / f64(w) * 3.5 - 2.5
      let x = 0.0
      let y = 0.0
      let iter = 0
      while (iter < maxIter) {
        let x2 = x * x
        let y2 = y * y
        if (x2 + y2 > 4.0) {
          break
        }
        y = 2.0 * x * y + y0
        x = x2 - y2 + x0
        iter = iter + 1
      }
      sum = sum + iter
      px = px + 1
    }
    py = py + 1
  }
  print("${sum}\n")
}
