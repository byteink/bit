// Allocation churn, REFERENCE shape: 2000 batches of 5000 short-lived heap
// nodes (10M total), each an independent heap object. Each batch is summed
// (so nothing is optimized away) then dropped for the GC. This case measures
// the ALLOCATOR: one allocation and one sweep per node, in all three
// languages -- alloc.go holds `[]*Node`, alloc.c mallocs per node.
//
// bench/cases/allocflat is the same program storing the same 10M nodes BY
// VALUE, and prints the same total. The pair is deliberate: the difference
// between the two rows is what per-node heap allocation costs, and the two
// object counts guard each other's representation (#3934).
//
// `owner` is what keeps this one measuring the allocator. A class whose
// fields are ALL scalars is packed inline into the slice's own buffer
// (#3862), so a `[]Node` of `class Node { x: i64, y: i64 }` allocates no
// per-element objects at all -- which is what silently turned this case into
// allocflat and left the row comparing three different programs. A reference
// field rules packing out structurally rather than heuristically:
// runtime/ABI.md §2 -- "a buffer whose element type has ANY reference field
// ... stays word-per-element unconditionally", because the collector traces
// a ref buffer word by word and a struct-wide stride is not representable
// that way.
class Batch { id: i64 }
class Node { x: i64, y: i64, owner: Batch }

fn main() {
  let batches = 2000
  let per = 5000
  let total = 0
  let b = 0
  while (b < batches) {
    let owner = Batch{ id: b }
    let nodes = []Node(0, per)
    let k = 0
    while (k < per) {
      nodes = append(nodes, Node{ x: b + k, y: k + 1, owner: owner })
      k = k + 1
    }
    for nd of nodes {
      total = total + nd.x + nd.y + nd.owner.id
    }
    b = b + 1
  }
  print("${total}\n")
}
