// Allocation churn: 2000 batches of 5000 short-lived heap structs (10M total).
// Each batch is summed (so nothing is optimized away) then dropped for the GC.
class Node { x: i64, y: i64 }

fn main() {
  let batches = 2000
  let per = 5000
  let total = 0
  let b = 0
  while (b < batches) {
    let batch = [Node{ x: b, y: 1 }]
    let k = 1
    while (k < per) {
      batch = append(batch, Node{ x: b + k, y: k + 1 })
      k = k + 1
    }
    for nd of batch {
      total = total + nd.x + nd.y
    }
    b = b + 1
  }
  print("${total}\n")
}
