// Sorts an 800,000-element []i64 and a 150,000-element []string with
// std/sort's stable merge sort (#2704), then checks isSorted and folds each
// result into a position-weighted checksum (mod a prime, so a single
// mis-ordered element changes the printed value).
// Fairness: each language uses the sort it would actually reach for --
// std/sort's merge sort in Bit, Go's sort.Slice (typically a
// pattern-defeating quicksort) and C's qsort (typically an
// introsort/quicksort hybrid). The algorithms differ by design: this
// measures "the sort you'd reach for in each language" over the same data,
// not one algorithm hand-transliterated three times. All three converge on
// the same sorted order regardless of algorithm, so the checksum is
// algorithm-independent and still a fair, exact comparison.
import { sortInPlace, isSorted } from "std/sort"
import { newBuilder } from "std/strings"

fn mix(i: i64): i64 {
  return (i + 1) * 2654435761 % 2147483647
}

fn main() {
  let mod: i64 = 1000000007

  let n = 800000
  let xs: []i64 = []i64(n)
  let i = 0
  while (i < n) {
    xs[i] = mix(i)
    i = i + 1
  }
  sortInPlace(xs, (a, b) => a < b)
  let sortedOk1 = isSorted(xs, (a, b) => a < b)

  let checksum1: i64 = 0
  i = 0
  while (i < n) {
    checksum1 = (checksum1 + xs[i] % mod * (i + 1)) % mod
    i = i + 1
  }

  let m = 150000
  let ss: []string = []string(m)
  i = 0
  while (i < m) {
    let tokLen = 3 + mix(i) % 12
    let b = newBuilder()
    let k = 0
    while (k < tokLen) {
      b.writeByte(u8(97 + mix(i * 37 + k + 1) % 26))
      k = k + 1
    }
    ss[i] = b.toString()
    i = i + 1
  }
  sortInPlace(ss, (a, b) => a < b)
  let sortedOk2 = isSorted(ss, (a, b) => a < b)

  let checksum2: i64 = 0
  i = 0
  while (i < m) {
    let bytesum: i64 = 0
    let k = 0
    while (k < len(ss[i])) {
      bytesum = bytesum + int(ss[i][k])
      k = k + 1
    }
    checksum2 = (checksum2 + bytesum * (i + 1)) % mod
    i = i + 1
  }

  print("${checksum1} ${sortedOk1} ${checksum2} ${sortedOk2}\n")
}
