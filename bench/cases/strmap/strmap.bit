// A STRING-keyed map, next to `map`'s int-keyed one: 400,000 distinct 16-byte
// keys, the first half inserted, then 6,000,000 hit lookups and 6,000,000 miss
// lookups over the two halves, a quarter of the live keys deleted, and one
// final pass counting what is left.
//
// Why this case exists (#4376): `map` is `map<i64,i64>`, which takes the
// splitmix64 scalar hash and the scalar probe path. Nothing in the published
// suite reached the string path — wyhash plus the group probe — so a change
// there read as "no regression" and "no improvement" identically. This case
// reaches it: 12,000,000 of the 12,600,000 map operations below are string
// lookups.
//
// SIZED SO KEY CONSTRUCTION DOES NOT DOMINATE. Building a key per lookup is
// what a naive string-map benchmark does and it measures string construction,
// not the map (#4353 measured such a shape at 79% construction). Here the
// 400,000 keys are built once, up front, and each is then used 30 times, so
// construction is a small fraction of the run and the lookup loops are the
// body of the measurement.
//
// Fairness: Bit's `map<K,V>` and Go's built-in `map` are both native,
// hash-based containers with their own string hashes. C has no built-in map,
// so strmap.c hand-rolls an open-addressing table with linear probing and a
// word-at-a-time string hash of comparable quality — same asymptotic
// behaviour, not the same code, exactly as map.c is to map.bit. All three
// pre-size for the n entries about to be inserted so none pays for a
// growth+rehash the others do not.
//
// Every side holds the key set the same way: one contiguous blob of
// `total*16` bytes plus an array of `total` independently heap-allocated
// string values over it. Bit's per-key object is a 24-byte view header
// sharing the blob (runtime/root/strings.bit's `bit_rt_string_slice`), Go's
// and C's are 16-byte copies — one heap object per key on all three sides,
// which is what the allocation column checks (#3934).
import { newBuilder } from "std/strings"

fn mix(i: i64): i64 {
  return (i + 1) * 2654435761 % 2147483647
}

// One blob of `total` 16-byte keys. The first four bytes are base-26 digits of
// the index, which makes the keys PROVABLY distinct (26^4 = 456976 > 400000)
// rather than distinct with high probability; the other twelve come from
// `mix`, so all sixteen bytes carry entropy and no key is a prefix neighbour
// of the next.
fn buildBlob(total: int, width: int): string {
  let b = newBuilder()
  let i = 0
  while (i < total) {
    let q = i
    let j = 0
    while (j < 4) {
      b.writeByte(u8(97 + q % 26))
      q = q / 26
      j = j + 1
    }
    while (j < width) {
      b.writeByte(u8(97 + mix(i * 37 + j + 1) % 26))
      j = j + 1
    }
    i = i + 1
  }
  return b.toString()
}

// `total` string values over `blob`, one heap object each.
fn sliceKeys(blob: string, total: int, width: int): []string {
  let keys: []string = []string(total)
  let i = 0
  while (i < total) {
    keys[i] = blob[i * width:i * width + width]
    i = i + 1
  }
  return keys
}

// `reps * n` lookups that all hit.
fn hitSum(m: map<string, i64>, keys: []string, n: int, reps: int): i64 {
  let hits: i64 = 0
  let r = 0
  while (r < reps) {
    let i = 0
    while (i < n) {
      hits = hits + m[keys[i]]
      i = i + 1
    }
    r = r + 1
  }
  return hits
}

// `reps * n` lookups that all miss -- the full-probe path, which a hit-only
// loop never walks to its end.
fn missCount(m: map<string, i64>, keys: []string, n: int, total: int, reps: int): i64 {
  let misses: i64 = 0
  let r = 0
  while (r < reps) {
    let i = n
    while (i < total) {
      let (_, ok) = m[keys[i]]
      if (!ok) {
        misses = misses + 1
      }
      i = i + 1
    }
    r = r + 1
  }
  return misses
}

fn main() {
  let n = 200000
  let total = n * 2
  let width = 16
  let reps = 30

  let blob = buildBlob(total, width)
  let keys = sliceKeys(blob, total, width)

  let m = map<string, i64>(n)
  let i = 0
  while (i < n) {
    m[keys[i]] = i * 7
    i = i + 1
  }

  let hits = hitSum(m, keys, n, reps)
  let misses = missCount(m, keys, n, total, reps)

  i = 0
  while (i < n) {
    if (i % 4 == 0) {
      delete(m, keys[i])
    }
    i = i + 1
  }

  let sum2: i64 = 0
  let remaining = 0
  i = 0
  while (i < n) {
    let (v, ok) = m[keys[i]]
    if (ok) {
      sum2 = sum2 + v
      remaining = remaining + 1
    }
    i = i + 1
  }

  print("${hits} ${misses} ${remaining} ${sum2} ${len(m)}\n")
}
