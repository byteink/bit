// Insert 1.5M int64 keys into a map, sum every value, delete a quarter of
// the keys, then re-sum and re-count what is left.
// Fairness: Bit's map<K,V> and Go's built-in map are both native, hash-based
// containers. C has no built-in map, so map.c hand-rolls an open-addressing
// table with linear probing over the same key set -- same asymptotic
// behaviour (average O(1) insert/lookup/delete), not the same code.
// #4064: all three sides pre-size their table for the n entries about to be
// inserted -- map.go's `make(map[int64]int64, n)`, map.c's calloc to >= n*3
// slots, and here map<i64,i64>(n)'s capacity hint -- so none of the three
// pays for growth+rehash that the others do not.
fn main() {
  let n = 1500000
  let m = map<i64, i64>(n)
  let i = 0
  while (i < n) {
    m[i] = i * 7
    i = i + 1
  }

  let sum1: i64 = 0
  i = 0
  while (i < n) {
    sum1 = sum1 + m[i]
    i = i + 1
  }

  i = 0
  while (i < n) {
    if (i % 4 == 0) {
      delete(m, i)
    }
    i = i + 1
  }

  let sum2: i64 = 0
  let remaining = 0
  i = 0
  while (i < n) {
    let (v, ok) = m[i]
    if (ok) {
      sum2 = sum2 + v
      remaining = remaining + 1
    }
    i = i + 1
  }

  print("${sum1} ${remaining} ${sum2} ${len(m)}\n")
}
