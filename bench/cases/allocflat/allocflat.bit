// Allocation churn, VALUE shape: 2000 batches of the same 5000 nodes
// bench/cases/alloc allocates individually (10M total), stored BY VALUE in
// one buffer per batch instead. Each batch is summed (so nothing is
// optimized away) then dropped. This case measures DATA LAYOUT and
// iteration, not the allocator: there are ~2000 heap objects in the whole
// run, not 10M, in all three languages -- allocflat.go holds `[]Node` and
// allocflat.c one `malloc` for the whole batch.
//
// It prints the same total as bench/cases/alloc, whose node is the same 24
// bytes wide and whose arithmetic is identical; the only difference between
// the two programs is whether the third field is a reference to the batch
// header or an inline copy of its id. So the gap between the two rows is
// what per-node heap allocation costs a language, and the two object counts
// guard each other's representation: if Bit ever stopped packing this one,
// its count jumps to 10M and benchgate's ceiling catches it, exactly as
// alloc's floor catches the reverse (#3862, #3934).
class Node { x: i64, y: i64, id: i64 }

fn main() {
  let batches = 2000
  let per = 5000
  let total = 0
  let b = 0
  while (b < batches) {
    let nodes = []Node(0, per)
    let k = 0
    while (k < per) {
      nodes = append(nodes, Node{ x: b + k, y: k + 1, id: b })
      k = k + 1
    }
    for nd of nodes {
      total = total + nd.x + nd.y + nd.id
    }
    b = b + 1
  }
  print("${total}\n")
}
