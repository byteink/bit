// Allocation churn, MULTI-MUTATOR shape: the same 10M short-lived heap nodes
// bench/cases/alloc allocates from one thread, split across a fixed number of
// concurrent workers so the allocator's shared state is genuinely contended.
// Prints the identical total: the 2000 batches are partitioned, not changed,
// so this case and `alloc` are each other's control on the SAME work at two
// different contention levels, exactly as `alloc` and `allocflat` are each
// other's control on the same work at two different representations (#3934).
//
// WHY THIS CASE EXISTS (#5728). Every other case in bench/run.sh's CASES list
// is single-mutator, and the allocator's contended costs are invisible to all
// of them. runtime/gc/gcalloc.bit's `linkObject` header cites 16-18 ns for a
// contended `ldaddal` against 0.1-0.6 ns uncontended, and runtime/gc's
// per-OS-thread allocation cache (gcalloccache.bit) is not even ARMED until a
// `spinTryAcquire` on the heap lock FAILS (gcheap.bit's `allocCacheArmed`) --
// which one mutator never makes happen. So a change that removes a contended
// atomic could land, be correct, and move no published number at all, while a
// regression on the same path would move none either.
//
// THE ARMING IS THE POINT, AND IT IS SELF-INFLICTED HERE. This case needs no
// BIT_GC_ALLOCCACHE=1 and gets none: run.sh's timed runs set no environment,
// and `workers` concurrent allocators lose the heap-lock race within the first
// microseconds, which is what arms the cache. The code under test is therefore
// the same code a real concurrent program reaches by itself.
//
// `owner` is a reference field for the reason alloc.bit's header gives: a
// class whose fields are all scalars is packed inline into the slice's own
// buffer (#3862) and the case stops allocating per node. Do not remove it.
//
// WORKER COUNT IS FIXED IN THE SOURCE, never read from the host's core count:
// bench/history.csv is a time series across boxes and a row whose parallelism
// tracked `hw.ncpu` would not be comparable with its own past.
//
// 8, AND NOT 2, IS MEASURED AND NOT A PREFERENCE. The scheduler boots ONE
// worker thread and grows the pool only after the run queue has stayed
// non-empty for `growStreakThreshold` = 4 enqueues (runtime/sched/grow.bit),
// so a case that spawns 2 workers gets no second OS thread at all: this
// program at `workers = 2` measured 0.25s real against 0.25s user -- one
// thread, no contention, 7996M instructions against single-mutator `alloc`'s
// 7625M, i.e. the same case with a `spawn` in front of it. At 4 it is 1.85s
// user against 0.49s real (3.8 threads) and at 8, 4.73s against 0.66s (7.2
// threads). 8 is the first count with margin over the growth threshold on a
// box of any size, and it is under the 18 logical CPUs of the box these
// numbers were taken on, so the mutators are genuinely concurrent rather
// than time-sliced.

import { WaitGroup, newWaitGroup } from "std/sync"

const workers = 8
const batchesPerWorker = 250 // 8 * 250 * 5000 == alloc's own 10M nodes
const per = 5000

class Batch { id: i64 }
class Node { x: i64, y: i64, owner: Batch }

// One worker's contiguous slice of the batch range. Each worker accumulates
// into a local and publishes once, into its OWN slot of `totals` -- no atomic
// and no lock on the measured path, so what this case times is the allocator's
// contention and nothing the benchmark itself added.
fn allocWorker(w: int, totals: []i64, wg: WaitGroup) {
  let total = 0
  let b = w * batchesPerWorker
  let end = b + batchesPerWorker
  while (b < end) {
    let owner = Batch{ id = b }
    let nodes = []Node(0, per)
    let k = 0
    while (k < per) {
      nodes = append(nodes, Node{ x = b + k, y = k + 1, owner = owner })
      k = k + 1
    }
    for nd of nodes {
      total = total + nd.x + nd.y + nd.owner.id
    }
    b = b + 1
  }
  totals[w] = total
  wg.done()
}

fn main() {
  let totals = []i64(workers)
  let wg = newWaitGroup()
  wg.add(workers)
  let w = 0
  while (w < workers) {
    spawn allocWorker(w, totals, wg)
    w = w + 1
  }
  wg.wait()
  // Summed after the join, so the printed answer is independent of the order
  // the workers finished in -- the verify gate in bench/run.sh compares it
  // byte-for-byte against the C and Go sides.
  let total = 0
  let i = 0
  while (i < workers) {
    total = total + totals[i]
    i = i + 1
  }
  print("${total}\n")
}
