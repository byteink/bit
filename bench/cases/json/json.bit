// Builds a ~9 MB JSON array of 150,000 records in memory (no I/O), parses it
// with std/json's jsonParse -- the generic DOM parser #2293 measured at 16s
// on a 5 MB document with the collector 64% of that, so this is the known
// bad path, kept rather than avoided -- then walks the parsed Json tree by
// key, summing fields.
// Fairness: this is deliberately NOT the same code shape on all three sides.
// Go decodes straight into a typed []Record via encoding/json, and json.c
// parses straight into the same typed shape with a small vendored
// recursive-descent parser: neither Go nor C has, or would realistically
// reach for, a generic DOM builder against a known schema. Bit's std/json
// has only the generic Json-enum DOM parser -- there is no typed decoder --
// so that is what a Bit program parsing this data would actually use. That
// asymmetry, not an identical algorithm, is the comparison #2293 asked for.
import { newBuilder } from "std/strings"
import { jsonParse, jsonAsArray, jsonGet, jsonAsInt, jsonAsBool, jsonAsString } from "std/json"

fn main() {
  let recs = 150000
  let b = newBuilder()
  b.writeByte('[')
  let i = 0
  while (i < recs) {
    if (i > 0) {
      b.writeByte(',')
    }
    let active = "false"
    if (i % 2 == 0) {
      active = "true"
    }
    b.write("{\"id\":${i},\"name\":\"user${i}\",\"active\":${active},\"tags\":[${i % 7},${i % 11},${i % 13}]}")
    i = i + 1
  }
  b.writeByte(']')
  let src = b.toString()

  let doc = jsonParse(src) catch e {
    print("parse failed: ${e.message()}\n")
    return
  }

  let idSum: i64 = 0
  let tagSum: i64 = 0
  let activeCount: i64 = 0
  let nameLenSum: i64 = 0

  match (jsonAsArray(doc)) {
    Some(items) => {
      for item of items {
        match (jsonGet(item, "id")) {
          Some(v) => {
            match (jsonAsInt(v)) {
              Some(n) => idSum = idSum + n
              None => {}
            }
          }
          None => {}
        }
        match (jsonGet(item, "active")) {
          Some(v) => {
            match (jsonAsBool(v)) {
              Some(flag) => {
                if (flag) {
                  activeCount = activeCount + 1
                }
              }
              None => {}
            }
          }
          None => {}
        }
        match (jsonGet(item, "name")) {
          Some(v) => {
            match (jsonAsString(v)) {
              Some(s) => nameLenSum = nameLenSum + len(s)
              None => {}
            }
          }
          None => {}
        }
        match (jsonGet(item, "tags")) {
          Some(v) => {
            match (jsonAsArray(v)) {
              Some(tags) => {
                for t of tags {
                  match (jsonAsInt(t)) {
                    Some(n) => tagSum = tagSum + n
                    None => {}
                  }
                }
              }
              None => {}
            }
          }
          None => {}
        }
      }
    }
    None => {}
  }

  print("${idSum} ${tagSum} ${activeCount} ${nameLenSum}\n")
}
