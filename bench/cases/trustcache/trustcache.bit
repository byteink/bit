// Regression probe for #2298's TLS trust-store cache (stdlib/http/
// trustcache.bit): `newClient()` reaches `defaultClientConfig()` ->
// `defaultRoots()` -> `defaultTrustRoots()` on every construction. Before
// #2298 that call chain re-parsed the whole OS certificate bundle from
// scratch every time (~170ms for ~128 macOS roots -- trustcache.bit's own
// header); after #2298 only the FIRST call parses and every later call
// decodes a small process-wide byte cache instead.
//
// `Client.tls` is module-private (SPEC Sec 11's field-export rule: a class
// field needs its own `export`, and none of Client's do), so this case
// cannot read the resulting root count back out through the public API --
// it exercises the one public entry point that reaches the cache
// (`newClient()`) N times and lets _tests_/bit/benchgate/baselines.bit's
// ALLOCATED OBJECT COUNT band (#3130) carry the regression detection: a
// parse-per-call allocates roughly N times what a cache-hit decode does
// (a full X.509/PEM parse of ~128 certificates against one binary decode
// of an already-flat buffer), which swamps the two-sided [50%,105%] band
// by orders of magnitude -- unlike CPU time under multi-agent contention
// (see benchgate.bit's file header on why object count, not CPU, is this
// gate's load-insensitive signal).
import { newClient } from "std/http"

fn main() {
  let n = 0
  let built = 0
  while (n < 40) {
    let c = newClient()
    c.setHeader("X-Bench", "1") catch _ {}
    built = built + 1
    n = n + 1
  }
  print("${built}\n")
}
