// Builds a ~1.3 MB string from 200,000 small tokens via strings.Builder
// (allocator + std/strings pressure), slices fixed-width windows out of the
// result and counts adjacent-equal windows, then slices a prefix and a
// suffix and concatenates them. Every token, window and slice offset is a
// pure function of an index, so the run is fully deterministic with no
// shared RNG state to keep in sync across languages.
// Fairness: Go's strings.Builder and Bit's std/strings.Builder both grow by
// doubling; C has no built-in growable string type, so strings.c hand-rolls
// one with the same doubling behaviour.
import { newBuilder } from "std/strings"

fn mix(i: i64): i64 {
  return ((i + 1) * 2654435761) % 2147483647
}

fn main() {
  let n = 200000
  let b = newBuilder()
  let i = 0
  while (i < n) {
    let tokLen = 3 + mix(i) % 12
    let k = 0
    while (k < tokLen) {
      b.writeByte(u8(97 + mix(i * 37 + k + 1) % 26))
      k = k + 1
    }
    b.writeByte(32)
    i = i + 1
  }
  let s = b.toString()
  let total = len(s)

  let width = 8
  let windows = total / width
  let matches = 0
  let w = 0
  while (w < windows - 1) {
    let a = s[w * width:w * width + width]
    let c = s[(w + 1) * width:(w + 1) * width + width]
    if (a == c) {
      matches = matches + 1
    }
    w = w + 1
  }

  let prefix = s[0:5000]
  let suffix = s[total - 5000:total]
  let joined = prefix + suffix
  let joinedLen = len(joined)

  print("${total} ${matches} ${joinedLen}\n")
}
