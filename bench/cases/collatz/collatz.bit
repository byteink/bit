// Longest Collatz chain for starts below 1,000,000 — integer div/mod + branches.
function collatz(start: i64): i64 {
  let n = start
  let steps = 0
  while (n != 1) {
    if (n % 2 == 0) {
      n = n / 2
    } else {
      n = 3 * n + 1
    }
    steps = steps + 1
  }
  return steps
}

function main() {
  let limit = 1000000
  let best = 0
  let i = 1
  while (i < limit) {
    let s = collatz(i)
    if (s > best) {
      best = s
    }
    i = i + 1
  }
  print("${best}\n")
}
