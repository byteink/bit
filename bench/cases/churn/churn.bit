// GC index-table leak regression probe (#2756, #2922, #2978). Live set of
// exactly one object per iteration -- the shape that drove
// runtime/gc/gcindex.bit's idxGrow to abandon the whole rehashed
// address->object index table into the bump-only gcIdxRes reserve after
// every sweep, never reusing it. See tests/bit/benchgate.bit's baseline
// comment for the fixed/broken RSS this case guards.
struct Big { a: i64, b: i64 }

fn main() {
  let n = 0
  let sink = 0
  while (n < 4000000) {
    let obj = Big{ a: n, b: n }
    sink = sink + obj.a
    n = n + 1
  }
  print("${sink}\n")
}
