// Closures: a function value that captures its surrounding variables.
function makeAdder(n: i64): (i64) => i64 {
  return (x: i64) => x + n
}
function main() {
  let base = 100
  let addBase = (x: i64) => x + base
  let add10 = makeAdder(10)
  print("addBase(5)=${addBase(5)} add10(5)=${add10(5)}\n")
}
