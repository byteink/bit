// The std/strings module: byte-level search, ASCII case-folding, join/split,
// int parsing, and a concat Builder (whose methods return an updated value, so
// reassign to chain).
import { hasPrefix, toUpper, join, indexOf, split, trimSpace, parseInt, newBuilder } from "std/strings"

// Sum a comma-separated list of integers, tolerating surrounding spaces.
function sumCsv(line: string): int! {
  let total = 0
  for field of split(line, ",") {
    total = total + parseInt(trimSpace(field))?
  }
  return total
}

function main() {
  let words = ["bit", "is", "fast"]

  println(join(words, " "))
  println(toUpper(join(words, " ")))
  println("starts with 'bit': ${hasPrefix("bitlang", "bit")}")
  println("index of 'la': ${indexOf("bitlang", "la")}")

  let parts = split("bit,is,fast", ",")
  println("split count: ${len(parts)}")

  let total = sumCsv(" 10, 20 , 12 ") catch e {
    println("parse error: ${e.message()}")
    return
  }
  println("sum: ${total}")

  let b = newBuilder()
  b = b.write("[")
  b = b.write(join(words, ", "))
  b = b.write("]")
  println(b.toString())
}
