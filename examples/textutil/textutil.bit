// The std/strings module: byte-level search, ASCII case-folding, join, and a
// concat Builder (whose methods return an updated value, so reassign to chain).
import { hasPrefix, toUpper, join, indexOf, newBuilder } from "std/strings"

function main() {
  let words = ["bit", "is", "fast"]

  println(join(words, " "))
  println(toUpper(join(words, " ")))
  println("starts with 'bit': ${hasPrefix("bitlang", "bit")}")
  println("index of 'la': ${indexOf("bitlang", "la")}")

  let b = newBuilder()
  b = b.write("[")
  b = b.write(join(words, ", "))
  b = b.write("]")
  println(b.toString())
}
