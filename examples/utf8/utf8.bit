// UTF-8 rune decoding from std/strings: runeCount counts code points (not
// bytes), runeAt decodes the rune at a byte offset, and runes decodes the whole
// string. Multi-byte input (accents, CJK, emoji) counts fewer runes than bytes.
import { runeCount, runeAt, runes } from "std/strings"

fn main() {
  let samples = ["hello", "héllo", "日本語", "😀"]
  for s of samples {
    println("runes=${runeCount(s)} bytes=${len(s)} first=${runeAt(s, 0)}")
  }
  println("decoded 日本語 into ${len(runes("日本語"))} code points")
}
