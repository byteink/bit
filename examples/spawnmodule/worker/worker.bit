// A worker factored into its own module — the shape that broke. `spawn` of an
// IMPORTED function must emit the callee's module-qualified symbol (`m1$work`),
// not the bare identifier its source span spells.
export function work(x: int, out: chan<int>) {
  out <- x * 3
}

// Imported AND generic: the callee symbol must carry both the declaring
// module's prefix and the monomorphized instance index.
export function relay<T>(v: T, out: chan<T>) {
  out <- v
}
