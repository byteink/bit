// select: take whichever channel is ready, else fall through to default.
function main() {
  let a = chan<i64>(1)
  let b = chan<i64>(1)
  b <- 42
  select {
    case x = <- a:
      print("from a: ${x}\n")
    case y = <- b:
      print("from b: ${y}\n")
  }
  select {
    case z = <- a:
      print("from a: ${z}\n")
    default:
      print("nothing ready\n")
  }
}
