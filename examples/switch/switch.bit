// switch: multi-value cases, a default, and the tagless (condition) form.
fn name(n: i64): string {
  switch (n) {
    case 1, 2:
      return "small"
    case 3:
      return "three"
    default:
      return "big"
  }
}

fn grade(score: i64): string {
  switch {
    case score >= 90:
      return "A"
    case score >= 70:
      return "C"
    default:
      return "F"
  }
}

fn main() {
  print("${name(1)} ${name(3)} ${name(9)}\n")
  print("85 -> ${grade(85)}, 40 -> ${grade(40)}\n")
}
