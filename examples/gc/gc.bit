// Garbage collection is automatic and transparent: allocate as freely as the
// logic wants, keep only what you still reference, and the runtime reclaims the
// rest at safepoints. Here `origin` stays live across the whole loop while each
// iteration's temporary Point becomes garbage the collector sweeps - no manual
// free, no leak.
struct Point { x: i64, y: i64 }

fn main() {
  let origin = Point{ x: 0, y: 0 }
  let sum = 0
  let i = 0
  while (i < 100000) {
    let p = Point{ x: i, y: i * 2 }
    sum = sum + (p.x - origin.x)
    i = i + 1
  }
  print("sum of offsets = ${sum}\n")
}
