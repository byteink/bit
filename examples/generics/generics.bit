// Generic functions: one body, monomorphized per type at each call site.
fn identity<T>(x: T): T {
  return x
}
fn contains<T>(xs: []T, target: T): bool {
  for x of xs {
    if (x == target) {
      return true
    }
  }
  return false
}
fn main() {
  let n = identity(42)
  let flag = identity(true)
  let xs = [10, 20, 30]
  print("n=${n} flag=${flag} has20=${contains(xs, 20)} has99=${contains(xs, 99)}\n")
}
