// A client-side request timeout (#2291). A server that accepts a connection
// and never answers otherwise parks `get()` forever - there is nothing a
// caller can write today to defend itself against a peer that is slow,
// wedged, or simply gone. `getTimeout`/`requestTimeout` give it a bound: a
// whole-request deadline covering connect, send and read together, resolved
// once rather than restarted per operation.
import { listen, Listener, Conn } from "std/net"
import { getTimeout, serve, ok, Server } from "std/http"
import { sleep, Millisecond, Second } from "std/time"

// Accepts, reads the request, then holds the connection open without ever
// writing a response - the "peer accepted then went quiet" failure the
// ticket names as the single most common production failure of an HTTP
// dependency.
fn silent(c: Conn) {
  let _req = c.read(4096)
  sleep(Second * 30)
  c.close()
}

fn acceptSilently(l: Listener) {
  while (true) {
    let c = l.accept() catch _ { return }
    spawn silent(c)
  }
}

// A normal server, for contrast: `getTimeout` must not slow down or break an
// ordinary request just because it is now deadline-aware.
fn answerOnce(s: Server) {
  let ex = s.accept() catch _ { return }
  let req = ex.read() catch _ { return }
  ex.respond(ok("hi")) catch _ {}
}

fn askSilentServer(port: int): ()! {
  let _res = getTimeout("http://127.0.0.1:${port}/", 500)?
  print("silent server: unexpectedly answered\n")
}

fn askLiveServer(port: int): ()! {
  let res = getTimeout("http://127.0.0.1:${port}/", 5000)?
  print("live server: status ${res.status}\n")
}

fn main() {
  // A silent server: getTimeout must return an error, not park.
  let silentListener = listen("127.0.0.1", 0) catch e {
    print("listen failed: ${e.message()}\n")
    return
  }
  let silentPort = silentListener.port() catch _ { 0 }
  spawn acceptSilently(silentListener)

  askSilentServer(silentPort) catch e {
    print("silent server: ${e.message()}\n")
  }
  silentListener.close()

  // A real server: the same call, generously bounded, still succeeds.
  let liveServer = serve("127.0.0.1", 0) catch e {
    print("serve failed: ${e.message()}\n")
    return
  }
  let livePort = liveServer.port() catch _ { 0 }
  spawn answerOnce(liveServer)
  sleep(50 * Millisecond)

  askLiveServer(livePort) catch e {
    print("live server FAILED: ${e.message()}\n")
  }
  liveServer.close()
}
