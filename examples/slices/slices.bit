// Dynamic slices: literal, append with growth, indexing, len/cap, sub-slicing,
// and for..of iteration.
function main() {
  let xs = [1, 2, 3]
  xs = append(xs, 4)
  xs = append(xs, 5)
  print("xs len=${len(xs)} cap=${cap(xs)}\n")

  let mid = xs[1:4]
  print("mid[0]=${mid[0]} len=${len(mid)}\n")

  let total = 0
  for x of xs {
    total = total + x
  }
  print("sum=${total}\n")
}
