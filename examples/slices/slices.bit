// Dynamic slices: literal, append with growth, indexing, len/cap, sub-slicing.
function main() {
  let xs = [1, 2, 3]
  xs = append(xs, 4)
  xs = append(xs, 5)
  print("xs len=${len(xs)} cap=${cap(xs)}\n")

  let mid = xs[1:4]
  print("mid[0]=${mid[0]} len=${len(mid)}\n")

  let total = 0
  let i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    i = i + 1
  }
  print("sum=${total}\n")
}
