// bit lsp (#2326/#2348) — the built-project cache, and the `lspBuildProject`
// every query and every diagnostics publish goes through. Sorts first among the
// `lsp*.bit` siblings, so the handlers that call it are lowered after it.
//
// WHY THIS FILE EXISTS. A query used to rebuild the whole project — load,
// parse, resolve, type-check every module including the stdlib — once per
// message. Measured on the 4-file `bitlab/programs/editing/sample` importing
// std/strings, with `BIT_GC_STATS=1` reading the runtime's own accounting:
//
//   one hover request            62,281 GC objects
//   one `bit check` of that dir  60,460 GC objects
//
// i.e. a keystroke's worth of editor traffic cost a full compile of the project
// (two, in fact: the hover, then the coalesced didChange republish), and the
// stdlib — which cannot change while the editor is open — was 74% of it. That
// volume, multiplied by a small-object allocator that never returns a span to
// the OS (#2325/#2373-#2375), is what took a real session to 12.5 GB in 5h34m.
//
// THE CACHE KEY IS THE INPUT BYTES, so a hit is not an approximation of a
// rebuild — it is what the rebuild would have produced. `lspSnapshotFresh`
// replays the loader's file stage over every module of a cached project (list
// the directory, take the overlay text or read the file, skip what it cannot
// read, concatenate) and reuses the project only when every module's file names
// AND concatenated bytes still compare equal. Nothing is keyed on a timestamp,
// a document version, or a request signature: an editor is not the only writer
// of a project's files, and a stale hover is a confidently wrong answer.
//
// TWO LEVELS, because the two failure shapes are different:
//
//   1. a repeated request against unchanged text (hover after hover, the
//      republish that follows a query, ctrl-click, an outline refresh) reuses
//      the whole checked project and allocates nothing but its own reply;
//   2. an EDIT changes the root module, so level 1 must miss — but every other
//      module's bytes are untouched, and `loadProjectCached` reuses their trees
//      rather than re-parsing them. This is the half that helps the case a
//      request-level cache cannot (#2348's constraint): sustained typing, where
//      no two requests ever see the same buffer.
//
// Resolve and type-check still run for every module on an edit. They are NOT
// cached per module on purpose: every module of a build shares one
// `TypeContext`, and re-checking only the root into a TypeContext carried over
// from the last request would grow that context by the root's types once per
// keystroke — an unbounded leak traded for a bounded one. Reusing checkers
// needs a way to roll a TypeContext back, which does not exist yet.

// A checked project for one directory: the loaded+resolved project and its
// per-module checkers. The checker runs even when `p.diags` already holds a
// parse/resolve error (#3559): the arena-wide sweeps in `checkResolved`
// proved safe against a locally malformed tree (mutation-tested against nine
// distinct malformed-source shapes — an unclosed call, an unclosed brace, a
// truncated token, unbalanced/extra braces, an unterminated string, an
// unterminated comment, a broken generic, a broken struct, a broken match —
// none crashed, and the surviving declarations still typed correctly), so an
// error anywhere in the project must not blank every query for the whole
// file. `len(mods) == 0` alone still gates the one case checking truly cannot
// help: `loadProjectCached` found no root module at all.
class LspProject {
  p: Project,
  mods: []Checker,
}

// How many built projects the server keeps. TWO, not one, because a project is
// a DIRECTORY here (SPEC §17.1): an editor with a file open from each of two
// modules alternates between them — a query on one, then `lspFlushPending`
// republishing the other — and a single slot would make each of those a full
// rebuild. Bounded, and small, because this is a process that runs for a
// working day (Power of 10): a slot costs one whole project's trees and
// checkers, and the third directory is worth far less than the second.
const lspMaxSnapshots = 2

// One cached build. `diagCount`/`errorCount` are `lp.p.diags`' state as the
// build left it: a query re-derives types through `checkExprType` against these
// very checkers (see `lspHoverText`), and while no checker path reports today,
// a reused project must not be able to accumulate a second copy of a
// diagnostic across requests and publish it. Restoring the two on every reuse
// makes that structurally impossible instead of true-by-inspection.
class LspSnapshot {
  dir: string,
  lockText: string,
  lp: LspProject,
  diagCount: int,
  errorCount: int,
}

// The file stage of `loadModuleAt` (project.bit), replayed for one directory:
// the `.bit` names it would take, in the order it would take them, and the
// concatenation it would parse. Deliberately the same four rules — sorted
// listing, overlay text ahead of disk, an unreadable file skipped, a leading
// BOM stripped — because a divergence here would make a cached project look
// fresh when it is not (or, for the BOM rule specifically, never fresh: a
// stale `r.source` carrying three extra bytes would never equal `m.source`).
class LspModRead {
  names: []string,
  source: string,
}

fn lspReadModule(overlays: map<string, string>, dir: string): LspModRead {
  let names = []string(0)
  let source = ""
  for name of listBitFiles(dir) {
    let full = dir + "/" + name
    let (ovr, hasOvr) = overlays[full]
    let text = ""
    if (hasOvr) {
      text = ovr
    } else {
      text = readFile(full) catch e {
        continue // unreadable: skipped, exactly as loadModuleAt does
      }
    }
    text = stripBom(text) // exactly as loadModuleAt does (spec/SPEC.md:68)
    names = append(names, name)
    source = source + text + "\n"
  }
  return LspModRead{ names: names, source: source }
}

// True when rebuilding `lp` right now would read byte-identical input for every
// module it holds — the whole basis for serving a query from it.
//
// A module carrying an UNRESOLVED import (`modNotFound`/`modCycle`/
// `modPkgFail`) refuses the reuse outright. That is the one hole content
// comparison cannot see: `import "./sib"` against a directory that does not
// exist yet resolves to no module, so `./sib` is absent from `lp.p.mods` and
// creating it changes nothing this loop can compare — the importing module's
// own text is exactly as it was. Refusing to cache a project that is already
// reporting "cannot find module" costs nothing (it is broken and the user is
// mid-fix) and removes the whole class.
fn lspSnapshotFresh(overlays: map<string, string>, lp: LspProject): bool {
  let i = 0
  while (i < len(lp.p.mods)) {
    let m = lp.p.mods[i]
    for (_, id) of m.imports {
      if (id < 0) {
        return false
      }
    }
    let r = lspReadModule(overlays, m.dir)
    if (r.source != m.source || !strListEqual(r.names, m.fileNames)) {
      return false
    }
    i = i + 1
  }
  return true
}

// `<dir>/bit.lock` verbatim, or "" when there is none. Part of the cache key
// because package imports resolve through it (#1737): a `bit add` that repoints
// a dependency at a different commit leaves every module's bytes untouched
// while changing which directory the import means.
fn lspLockText(dir: string): string {
  return readFile(dir + "/bit.lock") catch e {
    ""
  }
}

// The cached project for `dir` that is still fresh against `overlays`, if any.
// `found` false means every slot is stale or for another directory.
fn lspFindSnapshot(server: LspServer, overlays: map<string, string>,
    dir: string): (LspProject, bool) {
  let lock = lspLockText(dir)
  let i = 0
  while (i < len(server.snaps)) {
    let s = server.snaps[i]
    if (s.dir == dir && s.lockText == lock && lspSnapshotFresh(overlays, s.lp)) {
      // Roll the shared sink back to what the BUILD left, never to zero: the
      // build's own parse/resolve/check diagnostics are the answer
      // `lspPublishDiagnostics` publishes.
      s.lp.p.diags.list = s.lp.p.diags.list[0:s.diagCount]
      s.lp.p.diags.errorCount = s.errorCount
      return s.lp, true
    }
    i = i + 1
  }
  return LspProject{ p: emptyProject(), mods: []Checker(0) }, false
}

// Records `lp` as the most recent build, dropping the oldest slot past
// `lspMaxSnapshots`.
fn lspStoreSnapshot(server: LspServer, dir: string, lp: LspProject) {
  let fresh = [LspSnapshot{ dir: dir, lockText: lspLockText(dir), lp: lp,
    diagCount: len(lp.p.diags.list), errorCount: lp.p.diags.errorCount }]
  let i = 0
  while (i < len(server.snaps) && len(fresh) < lspMaxSnapshots) {
    // Same directory: the older build for it is what this one supersedes.
    if (server.snaps[i].dir != dir) {
      fresh = append(fresh, server.snaps[i])
    }
    i = i + 1
  }
  server.snaps = fresh
}

// Every module of every cached build that is safe to reuse a TREE from, by
// canonical directory — what `loadProjectCached` consults instead of parsing.
//
// A module with ANY diagnostic against one of its files is left out. Reusing
// its tree would skip the parse that produced its lex/parse diagnostics, so the
// rebuild would silently lose them; excluding those modules is what lets
// `loadModuleAt` treat a cache hit as "contributes nothing to `lw.diags`" with
// no replay machinery at all. It costs only the module the user is actively
// breaking, which is exactly the module that has to be re-parsed anyway.
fn lspParseCache(server: LspServer): map<string, SrcModule> {
  let out = map<string, SrcModule>{}
  let si = 0
  while (si < len(server.snaps)) {
    let lp = server.snaps[si].lp
    si = si + 1
    let dirty = map<int, bool>{}
    for dg of lp.p.diags.list {
      dirty[dg.span.file] = true
    }
    let i = 0
    while (i < len(lp.p.mods)) {
      let m = lp.p.mods[i]
      i = i + 1
      let clean = true
      for f of m.files {
        let (_, bad) = dirty[f]
        if (bad) {
          clean = false
        }
      }
      if (clean) {
        out[m.dir] = m
      }
    }
  }
  return out
}

// Loads, resolves, and type-checks the module rooted at `dir` with `overlays`
// substituted for open documents, serving the whole thing from a previous
// build when nothing that build read has changed.
//
// Type-checking runs UNCONDITIONALLY, even when resolution already reported a
// parse or resolve error somewhere in the project (#3559). It used to run
// only when the whole project was clean, which meant one syntax error
// anywhere — the single most common state while a user is actively typing —
// disabled hover/definition/references/rename/completion for the ENTIRE
// file, including declarations with no relationship to the error. A checker
// error on the still-malformed portion is simply one more diagnostic on the
// same shared `p.diags` sink `lspPublishDiagnostics` already renders; the
// declarations the parser recovered cleanly type exactly as they would in an
// otherwise-valid file.
//
// `store` is false for the `.`-completion splice only. That build is against a
// buffer with a throwaway marker identifier spliced in at the cursor
// (`lspDotCompletion`), which no other request will ever send: keeping it would
// hold a slot for a fictional document and, because slots are keyed by
// directory, push out the snapshot of the real one the next hover wants. It
// still READS the parse cache — the stdlib does not care that the root module
// has a marker in it.
fn lspBuildProjectOverlay(server: LspServer, overlays: map<string, string>,
    dir: string, store: bool): LspProject {
  let (cached, hit) = lspFindSnapshot(server, overlays, dir)
  if (hit) {
    return cached
  }
  let p = loadProjectCached(dir, "", stdRootPath(), overlays, lspParseCache(server))
  if (p.root < 0 || len(p.mods) == 0) {
    return LspProject{ p: p, mods: []Checker(0) }
  }
  let mods = resolveProject(p)
  checkResolved(p, mods)
  let lp = LspProject{ p: p, mods: mods }
  if (store) {
    lspStoreSnapshot(server, dir, lp)
  }
  return lp
}

// The build every handler uses: the server's own open documents, cached.
fn lspBuildProject(server: LspServer, dir: string): LspProject {
  return lspBuildProjectOverlay(server, server.overlays, dir, true)
}

// A Project with no modules — the `found: false` half of `lspFindSnapshot`,
// which has to return one because Bit has no zero value for a class (§13.4).
// Never loaded from and never inspected: every caller checks the flag.
fn emptyProject(): Project {
  let sm = newSourceManager()
  return Project{ mods: []SrcModule(0), root: -1, prelude: -1, sm: sm,
    diags: newDiagnostics(sm) }
}
