class EmMachoFuncsResult {
  acc: EmMachoDbgLines,
  stackmaps: []FuncStackMap,
  debugLines: []FuncDebugLines,
  emittedNames: []string,
  mainVoid: bool,
  haveMain: bool,
}

fn emMachoRefuseSyscalls(
  module: IrModule, freestanding: bool,
): ()! {
  // §11.8: `syscall()` is Linux-only. The arm64 backend is shared with
  // aarch64-linux, so the target-specific rejection belongs here, on the Mach-O
  // path — the one place that knows the OS. Rejecting before any code is
  // emitted keeps the failure a clean diagnostic rather than a partly written
  // object.
  let sf = 0
  while (sf < len(module.funcs)) {
    let sfn = module.funcs[sf]
    // §17.6: only code this object emits can carry the instruction — rejecting
    // on a module not being emitted would fail a valid freestanding build over
    // a sibling's Linux-only code.
    if (!emitsFunction(sfn, freestanding)) {
      sf = sf + 1
      continue
    }
    let si = 0
    while (si < len(sfn.instrs)) {
      if (sfn.instrs[si].op == Op.Syscall) {
        fail newError("'syscall' is not supported on aarch64-macos: Darwin publishes no stable syscall numbers (SPEC §11.8)")
      }
      si = si + 1
    }
    sf = sf + 1
  }

}

fn emMachoTextRelocs(
  fc: FuncCode, off: int, relocs: []MachoRelocation,
): []MachoRelocation {
  let r = 0
  while (r < len(fc.relocs)) {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Text,
        offset = off + fc.relocs[r].offset, symbol = emMac(fc.relocs[r].symbol),
        kind = emRelocKind(fc.relocs[r].kind),
      },
    )
    r = r + 1
  }
  return relocs
}

fn emMachoFuncsToText(
  module: IrModule, freestanding: bool, debug: bool, code: ByteBuf, out: EmMachoFuncsResult,
): EmMachoFuncsResult {
  let symbols = out.acc.symbols
  let relocs = out.acc.relocs
  let defined = out.acc.defined
  let stackmaps = out.stackmaps
  let debugLines = out.debugLines
  let emittedNames = out.emittedNames
  let mainVoid = false
  let haveMain = false
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: an imported module's function belongs to its own object.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    let fc = compileFunction(module, f, debug, BuildTarget.Aarch64Macos)
    let off = len(code.bytes)
    appendBytes(code, fc.code)
    // §11.9/§17.6 (#1631): a freestanding object exports only its @symbol pins;
    // every other definition is module-private and would otherwise collide with
    // a sibling module's same-named private helper in the archive.
    let fnBinding = MachoBinding.Global
    if (definitionIsLocal(freestanding, f.isPinned)) {
      fnBinding = MachoBinding.Local
    }
    symbols = append(
      symbols,
      MachoSymbol{
        name = emMac(f.name), hasSection = true,
        section = MachoSectionKind.Text, offset = off, size = len(fc.code),
        binding = fnBinding,
      },
    )
    defined[emMac(f.name)] = true
    relocs = emMachoTextRelocs(fc, off, relocs)
    stackmaps = append(stackmaps, emStackMapOf(fc))
    debugLines = append(debugLines, emDebugLinesOf(fc))
    emittedNames = append(emittedNames, f.name)
    if (f.name == "main") {
      haveMain = true
      mainVoid = module.ctx.types[f.result].kind == TypeKind.Void
    }
    fi = fi + 1
  }
  out.acc = EmMachoDbgLines{ symbols = symbols, relocs = relocs, defined = defined }
  out.stackmaps = stackmaps
  out.debugLines = debugLines
  out.emittedNames = emittedNames
  out.mainVoid = mainVoid
  out.haveMain = haveMain
  return out
}

fn emMachoAddEntry(
  code: ByteBuf, out: EmMachoFuncsResult, acc: EmMachoDbgLines,
): EmMachoDbgLines! {
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  if (!out.haveMain) {
    // Wording shared with emitelf.bit, defined once in build.bit (#2234).
    fail newError(noMainMessage())
  }

  // ---- _bit_main entry trampoline (AArch64) ----------------------------
  // The runtime calls _bit_main (boot runs it as a green
  // thread); a void `main` still has to return an exit code, so the
  // trampoline supplies 0.
  let tramp = len(code.bytes)
  emitWord(code, 0xA9BF7BFD) // stp x29, x30, [sp, #-16]!
  let callField = len(code.bytes)
  emitWord(code, 0x94000000) // bl _main (placeholder)
  relocs = append(
    relocs,
    MachoRelocation{
      section = MachoSectionKind.Text,
      offset = callField, symbol = "_main", kind = MachoRelocKind.Branch,
    },
  )
  if (out.mainVoid) {
    emitWord(code, 0x52800000) // movz w0, #0
  }
  emitWord(code, 0xA8C17BFD) // ldp x29, x30, [sp], #16
  emitWord(code, 0xD65F03C0) // ret
  symbols = append(
    symbols,
    MachoSymbol{
      name = "_bit_main", hasSection = true,
      section = MachoSectionKind.Text, offset = tramp, size = len(code.bytes) - tramp,
      binding = MachoBinding.Global,
    },
  )
  defined["_bit_main"] = true
  return EmMachoDbgLines{ symbols = symbols, relocs = relocs, defined = defined }
}

