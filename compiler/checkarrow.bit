// compiler/checkarrow.bit — split out of checkexpr.bit (#2749, at 830/800
// lines after this ticket's fix). Sibling of checkexpr.bit: same module, so
// this needs no imports and no call-site changes. Follows the layout recorded
// at tag rescue/task-1689-stale-split.
//
// Every function here seeds `Checker.arrowExpected` (checkexpr.bit's
// `checkArrowFnAt`/`seedArrowParamTypes` are what CONSUME it) for one
// syntactic position an arrow-fn literal can be written in without its own
// parameter annotation: a `let` with a type annotation, a call argument, a
// composite-literal field/element/value, or an assignment target. All four
// are the same rule — SPEC §12.8 lets an arrow appear anywhere a
// function-typed value is expected, so its own unannotated parameter takes
// that expected type — applied at a different node shape.

// `let f: (i32) => i32 = (x) => …` — the annotation is the initializer's
// expected type. Only an ArrowFn initializer is recorded; nothing else reads
// the table.
function seedArrowExpectedBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pattern, type_or_none, init_or_none]
  if (kids[1] == 0 || kids[2] == 0) {
    return
  }
  if (getNode(c.tree, kids[2]).tag != Tag.ArrowFn) {
    return
  }
  let ty = typeFromNode(c, kids[1])
  if (ty != 0 && c.ctx.types[ty].kind == TypeKind.Func) {
    c.arrowExpected[kids[2]] = ty
  }
}

// `apply((x: f32) => 4.5)` — the matching parameter's declared type is the
// argument's expected type.
//
// Resolution is vCall's, guard for guard: a bare-ident callee that no local
// shadows, naming a known free function whose arity matches. Every undecidable
// shape (method, value call, builtin, variadic, spread) records nothing and
// leaves the arrow inferred exactly as before, which is what keeps a wrong
// expectation — the only way this could manufacture a diagnostic the seed does
// not have — out of reach.
//
// A GENERIC callee is decidable one step later, once its type params are bound
// from the other arguments: `seedArrowExpectedGeneric` (#2040).
function seedArrowExpectedCall(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let args = kidsOf(c.tree, kids[2])
  if (!hasArrowArg(c, args)) {
    return
  }
  let cn = getNode(c.tree, kids[0])
  if (cn.tag != Tag.Ident) {
    return
  }
  let name = c.source[cn.span.start:cn.span.end]
  if (shadowedByValue(c, kids[0], name)) {
    return // a local value shadows the free function
  }
  let fr = funcRefAt(c, kids[0], name)
  let decl = fr.decl
  if (decl == 0) {
    return
  }
  let owner = fr.owner
  let plist = declParamListNode(owner, decl)
  if (plist < 0) {
    // Generic: the parameter type is written against type params, so the
    // expectation exists only once the other arguments have bound them (#2040).
    seedArrowExpectedGeneric(c, node, owner, decl, args)
    return
  }
  let params = kidsOf(owner.tree, plist)
  if (len(params) != len(args)) {
    return // variadic, spread, or an arity error: which parameter is undecided
  }
  let i = 0
  while (i < len(args)) {
    let a = argInner(c, args[i])
    if (getNode(c.tree, a).tag == Tag.ArrowFn) {
      let pty = typeFromNode(owner, kidsOf(owner.tree, params[i])[1])
      if (pty != 0 && c.ctx.types[pty].kind == TypeKind.Func) {
        c.arrowExpected[a] = pty
      }
    }
    i = i + 1
  }
}

// The expression an argument node wraps, unwrapping the `Arg` shell.
function argInner(c: Checker, arg: int): int {
  if (getNode(c.tree, arg).tag == Tag.Arg) {
    return kidsOf(c.tree, arg)[0]
  }
  return arg
}

// Whether any argument is an arrow literal — the cheap guard that keeps the
// seeding pass off every call in the program.
function hasArrowArg(c: Checker, args: []int): bool {
  let i = 0
  while (i < len(args)) {
    if (getNode(c.tree, argInner(c, args[i])).tag == Tag.ArrowFn) {
      return true
    }
    i = i + 1
  }
  return false
}

// `Box{ f: (name) => … }`, `[]((T)=>R){ (x) => … }`, `map<K,(T)=>R>{ k: (x) => … }`
// — a composite literal's own type names the field/element/value type an
// arrow written directly inside it is expected against (#2749). The
// composite-literal counterpart of `seedArrowExpectedBinding`'s annotated
// `let`: nothing here can reject a program, only give an arrow that was
// always legal (SPEC §12.8) the parameter type it was missing, which left
// `name` in `Box{ f: (name) => "hi " + name }` typed `<error>` and lowered
// `"hi " + name` as a raw `add` over two string pointers instead of
// `string_concat` — a checker gap, not a lowering one.
//
// A struct literal is visited per FIELD (each may name a different type); a
// map or slice/array literal shares one element type for the whole body, so
// the guard is hoisted once. This function is called once per CompositeLit
// node found anywhere in the tree, so a struct literal NESTED inside another
// composite's field is reached by its own call, not by recursing here.
function seedArrowExpectedComposite(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, body]
  let ty = typeFromNode(c, kids[0])
  if (ty == 0) {
    return
  }
  let kind = c.ctx.types[ty].kind
  if (kind == TypeKind.Struct) {
    for it of kidsOf(c.tree, kids[1]) {
      if (getNode(c.tree, it).tag != Tag.FieldInit) {
        continue
      }
      let fk = kidsOf(c.tree, it)
      if (getNode(c.tree, fk[1]).tag != Tag.ArrowFn) {
        continue
      }
      let fldNode = getNode(c.tree, fk[0])
      let fname = c.source[fldNode.span.start:fldNode.span.end]
      let (fty, isField) = c.ctx.structFields["${ty}.${fname}"]
      if (isField && fty != 0 && c.ctx.types[fty].kind == TypeKind.Func) {
        c.arrowExpected[fk[1]] = fty
      }
    }
    return
  }
  let elemTy = 0
  if (kind == TypeKind.Map) {
    elemTy = c.ctx.types[ty].mapVal
  } else if (kind == TypeKind.Slice || kind == TypeKind.Array) {
    elemTy = c.ctx.types[ty].elem
  } else {
    return
  }
  if (elemTy == 0 || c.ctx.types[elemTy].kind != TypeKind.Func) {
    return
  }
  for it of kidsOf(c.tree, kids[1]) {
    let val = it
    if (kind == TypeKind.Map) {
      val = kidsOf(c.tree, it)[1] // MapEntry [key, value]
    } else {
      val = argInner(c, it) // positional element, Arg-wrapped
    }
    if (getNode(c.tree, val).tag == Tag.ArrowFn) {
      c.arrowExpected[val] = elemTy
    }
  }
}

// `b.f = (name) => …` — a plain assignment's target field, the mutate-in-place
// counterpart of `seedArrowExpectedBinding`'s `let` (#2749). Only the simple
// `ident.field = arrow` shape is decided, matching every other pass in this
// file: a chained member (`a.b.f`), an index target, or a receiver whose
// declared type node did not resolve records nothing and leaves the arrow
// inferred exactly as it was before this function existed.
function seedArrowExpectedAssign(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [LhsList, ExprList]
  let lhss = kidsOf(c.tree, kids[0])
  let rhss = kidsOf(c.tree, kids[1])
  if (len(lhss) != len(rhss)) {
    return // tuple/comma arity mismatch: a real error elsewhere, not ours to guess
  }
  let i = 0
  while (i < len(lhss)) {
    if (getNode(c.tree, rhss[i]).tag == Tag.ArrowFn) {
      let fty = assignTargetFuncType(c, lhss[i])
      if (fty != 0) {
        c.arrowExpected[rhss[i]] = fty
      }
    }
    i = i + 1
  }
}

// The declared type of assignment target `target`, when it is `recv.field`
// and `recv` is a simple identifier whose declared type node `declTypeNodes`
// already resolved (`recordBindingDeclNodes`, seeded by pre-pass 3 ahead of
// this one). 0 for anything undecidable: a chained member, an index target,
// a non-struct receiver, or a field that is not itself function-typed.
function assignTargetFuncType(c: Checker, target: int): int {
  if (getNode(c.tree, target).tag != Tag.Member) {
    return 0
  }
  let mk = kidsOf(c.tree, target)
  let recv = getNode(c.tree, mk[0])
  if (recv.tag != Tag.Ident) {
    return 0
  }
  let rname = c.source[recv.span.start:recv.span.end]
  let (tnode, ok) = c.declTypeNodes[rname]
  if (!ok || tnode == 0) {
    return 0
  }
  let recvTy = typeFromNode(c, tnode)
  if (recvTy == 0 || c.ctx.types[recvTy].kind != TypeKind.Struct) {
    return 0
  }
  let fldNode = getNode(c.tree, mk[1])
  let fname = c.source[fldNode.span.start:fldNode.span.end]
  let (fty, isField) = c.ctx.structFields["${recvTy}.${fname}"]
  if (!isField || fty == 0 || c.ctx.types[fty].kind != TypeKind.Func) {
    return 0
  }
  return fty
}
