// compiler/checkarrow.bit — split out of checkexpr.bit (#2749, at 830/800
// lines after this ticket's fix). Sibling of checkexpr.bit: same module, so
// this needs no imports and no call-site changes. Follows the layout recorded
// at tag rescue/task-1689-stale-split.
//
// Every function here seeds `Checker.arrowExpected` (checkexpr.bit's
// `checkArrowFnAt`/`seedArrowParamTypes` are what CONSUME it) for one
// syntactic position an arrow-fn literal can be written in without its own
// parameter annotation: a `let` with a type annotation, a call argument, a
// composite-literal field/element/value, an assignment target, or a `return`
// from a function whose declared result is itself a function type. All five
// are the same rule — SPEC §12.8 lets an arrow appear anywhere a
// function-typed value is expected, so its own unannotated parameter takes
// that expected type — applied at a different node shape.

// `let f: (i32) => i32 = (x) => …` — the annotation is the initializer's
// expected type. Only an ArrowFn initializer is recorded; nothing else reads
// the table.
fn seedArrowExpectedBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pattern, type_or_none, init_or_none]
  if (kids[1] == 0 || kids[2] == 0) {
    return
  }
  if (getNode(c.tree, kids[2]).tag != Tag.ArrowFn) {
    return
  }
  let ty = typeFromNode(c, kids[1])
  if (ty != 0 && c.ctx.types[ty].kind == TypeKind.Func) {
    c.arrowExpected[kids[2]] = ty
  }
}

// `apply((x: f32) => 4.5)` — the matching parameter's declared type is the
// argument's expected type.
//
// Three callee shapes, in the order the tree can decide them: a METHOD callee
// (`recv.method(...)`) goes to `seedArrowExpectedMethodCall`, guard for guard
// with vMethodCall's (#3029); a bare-ident callee that no local shadows and
// that names a known free function goes to `seedArrowExpectedNamedCall`, guard
// for guard with vCall's; anything else — and any callee either of those paths
// DECLINES — is a call through a function VALUE, whose parameter types come
// from the callee expression's own type (`seedArrowExpectedValueCall`, #4544).
//
// The value path is a fallback, never a widening: an ident naming a free
// function is still resolved through `funcRefAt`, a `recv.name(...)` is still
// resolved through `methodSigLookup`, and those paths returning `false` are
// what say "there is no such free function / method here", not a type lookup
// racing them. The method path declines exactly two `Tag.Member` shapes, and
// both land on the value path because `checkMember` types them: a
// `recv.field(...)` through a func-typed FIELD (#4547), and a
// namespace-qualified `ns.fn(...)`, whose receiver is an alias rather than a
// value (#4576).
//
// A GENERIC callee is decidable one step later, once its type params are bound
// from the other arguments: `seedArrowExpectedGeneric` (#2040).
fn seedArrowExpectedCall(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let args = kidsOf(c.tree, kids[2])
  if (!hasArrowArg(c, args)) {
    return
  }
  let cn = getNode(c.tree, kids[0])
  if (cn.tag == Tag.Member && seedArrowExpectedMethodCall(c, kids[0], args)) {
    return
  }
  if (cn.tag == Tag.Ident && seedArrowExpectedNamedCall(c, node, kids[0], args)) {
    return
  }
  seedArrowExpectedValueCall(c, kids[0], args)
}

// `apply((x) => …)` where `apply` is a bare ident naming a FREE FUNCTION.
// Returns false when this callee is not one — a local value shadows the name
// (SPEC §17.5), or no declaration answers to it — which hands the call to the
// value path above; true when it owns the call, whether or not it seeded
// anything (an arity mismatch here is a spread or a real arity error, not a
// value call, so it must not fall through).
fn seedArrowExpectedNamedCall(c: Checker, node: int, callee: int, args: []int): bool {
  let cn = getNode(c.tree, callee)
  let name = c.source[cn.span.start:cn.span.end]
  if (shadowedByValue(c, callee, name)) {
    return false // a local value shadows the free function: it is a value call
  }
  let fr = funcRefAt(c, callee, name)
  if (fr.decl == 0) {
    return false // no free function of that name: the callee is a value
  }
  let owner = fr.owner
  let plist = declParamListNode(owner, fr.decl)
  if (plist < 0) {
    // Generic: the parameter type is written against type params, so the
    // expectation exists only once the other arguments have bound them (#2040).
    seedArrowExpectedGeneric(c, node, owner, fr.decl, args)
    return true
  }
  let params = kidsOf(owner.tree, plist)
  if (len(params) != len(args)) {
    return true // variadic, spread, or an arity error: which parameter is undecided
  }
  let i = 0
  while (i < len(args)) {
    let a = argInner(c, args[i])
    if (getNode(c.tree, a).tag == Tag.ArrowFn) {
      let pty = typeFromNode(owner, kidsOf(owner.tree, params[i])[1])
      if (pty != 0 && c.ctx.types[pty].kind == TypeKind.Func) {
        c.arrowExpected[a] = pty
      }
    }
    i = i + 1
  }
  return true
}

// `b.each((x) => x + 1)` — a METHOD call's matching parameter type is the
// argument's expected type, resolved exactly as `vMethodCall`
// (validateiface.bit) resolves the same call site to validate its argument
// types: through the receiver's TYPE, not a name lookup, so `methodSigLookup`
// hands back an instantiation's already-substituted signature automatically
// (`copyInstMethod`/`fillInstMembers`, #1540/#1573) — no separate generic-arg
// binding step is needed here, unlike the free-function path's
// `seedArrowExpectedGeneric`. Inside a generic class's OWN body the receiver
// is still the bare template, so a raw type-param member can flow through
// unresolved; every downstream consumer already treats a type param
// permissively (`vHasTypeParam`), matching the free-function generic case.
//
// Every undecidable shape records nothing and leaves the arrow inferred
// exactly as before, mirroring vMethodCall's own bail-outs: an unresolved
// receiver (`checkExprType` returns 0), a variadic signature, or an arity
// mismatch (`seedArrowArgs` rejects it: which parameter is undecided). All of
// those return TRUE — the method path owns the call and decided to seed
// nothing.
//
// Returns FALSE for two answers, both of them "this is not a method call":
//
//  1. `methodSigLookup` knows no method of that name on the receiver, which is
//     what a func-typed FIELD called `recv.field(...)` looks like (#4547).
//  2. The receiver is a NAMESPACE ALIAS. `checkExprType` answers 0 for it as
//     it does for a genuinely unresolved receiver, so the two are told apart
//     the way `checkMember` (checkbind.bit) itself does — `nsQualifiedName`
//     answers non-empty only for a bound alias — and `ns.fn(...)` is a call to
//     a free function of another module, not a method (#4576). The unresolved
//     receiver stays undecided and keeps returning TRUE: a wrong expectation is
//     the one way this pass can manufacture a diagnostic the oracle lacks.
//
// Both land on `seedArrowExpectedValueCall`, where `checkMember` answers with
// the field's or the qualified function's own `TypeKind.Func` type — and where
// a non-Func answer, a variadic signature and an arity mismatch each still seed
// nothing. Nothing about the method path is widened: a real method resolves
// through `methodSigLookup` and never reaches the value path.
fn seedArrowExpectedMethodCall(c: Checker, callee: int, args: []int): bool {
  let mk = kidsOf(c.tree, callee) // [receiver, method_name]
  let recvType = checkExprType(c, mk[0])
  if (recvType == 0) {
    return nsQualifiedName(c, callee) == ""
  }
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  let sig = methodSigLookup(c, "${methodRecvType(c, recvType)}.${mname}")
  if (sig == 0) {
    return false // no method by that name: `recv.field(...)` is a value call
  }
  if (c.ctx.types[sig].variadic) {
    return true
  }
  seedArrowArgs(c, c.ctx.types[sig].members, args)
  return true
}

// `g((t) => t.v())`, `fs[0]((t) => …)`, `mk()((t) => …)` — a call whose callee
// is a function VALUE: a local, a parameter, a slice element, the result of
// another call. There is no declaration to look up, so the parameter types are
// read off the callee EXPRESSION's own `TypeKind.Func` type — the same list
// `seedArrowExpectedMethodCall` reads out of `methodSigLookup`, reached through
// `checkExprType` instead (#4544). Without it `t` below stayed at type 0, and
// `t.v()` reached lowering with a callee that resolves to nothing (E0092)
// while `bit check` exited 0 — the same divergence #4520 closed in `return`
// position, here in the call-argument position this file already owns.
//
// Records nothing for every undecidable shape, mirroring the method path's
// bail-outs: a callee whose type does not resolve (`checkExprType` answers 0
// for any expression whose inference has not landed), one that is not
// function-typed at all (a real E0092 the validator owns), a variadic
// signature, or an argument count other than its member count (a spread or an
// arity error: which parameter is undecided). A wrong expectation is the one
// way this pass can manufacture a diagnostic the oracle does not have, so an
// undecided callee keeps today's inference exactly.
//
// Two `Tag.Member` callees are value calls and arrive here from the method
// path, which declines both: a func-typed FIELD `recv.field(...)`, where
// `checkExprType` reaches `checkMember` and reads the field's own `Func` type
// (#4547), and a NAMESPACE-QUALIFIED call `ns.fn(...)`, where the same
// `checkMember` resolves the dotted key through `envLookup`/`funcSigLookup`
// and hands back the imported function's type (#4576). A qualified name that
// answers nothing, or something that is not a `Func`, hits the first guard
// below. Nothing about the method path is widened by either: a real method
// still resolves through `methodSigLookup` and never reaches this function.
fn seedArrowExpectedValueCall(c: Checker, callee: int, args: []int) {
  let fty = checkExprType(c, callee)
  if (fty == 0 || c.ctx.types[fty].kind != TypeKind.Func) {
    return
  }
  if (c.ctx.types[fty].variadic) {
    return
  }
  seedArrowArgs(c, c.ctx.types[fty].members, args)
}

// Records `want[i]` on each ArrowFn argument, for a callee whose parameter
// types are already resolved to type ids — the method and value paths, which
// both get their `want` from a `Func` type's `members`. The arity check lives
// HERE rather than in each caller so there is exactly one place that can index
// `want` out of step with `args`; a mismatch is undecidable and records
// nothing, never a guess at which parameter a given argument matches.
//
// The named path keeps its own loop: its parameter types come from the
// declaration's type NODES, and `typeFromNode` can mint a type (`Self`,
// checktype.bit), so resolving every parameter up front to build a `want` list
// would move type ids for a program that never needed them — and type-id order
// feeds method-name mangling and the bootstrap fixed point.
fn seedArrowArgs(c: Checker, want: []int, args: []int) {
  if (len(want) != len(args)) {
    return
  }
  let i = 0
  while (i < len(args)) {
    let a = argInner(c, args[i])
    if (getNode(c.tree, a).tag == Tag.ArrowFn) {
      let pty = want[i]
      if (pty != 0 && c.ctx.types[pty].kind == TypeKind.Func) {
        c.arrowExpected[a] = pty
      }
    }
    i = i + 1
  }
}

// The expression an argument node wraps, unwrapping the `Arg` shell.
fn argInner(c: Checker, arg: int): int {
  if (getNode(c.tree, arg).tag == Tag.Arg) {
    return kidsOf(c.tree, arg)[0]
  }
  return arg
}

// Whether any argument is an arrow literal — the cheap guard that keeps the
// seeding pass off every call in the program.
fn hasArrowArg(c: Checker, args: []int): bool {
  let i = 0
  while (i < len(args)) {
    if (getNode(c.tree, argInner(c, args[i])).tag == Tag.ArrowFn) {
      return true
    }
    i = i + 1
  }
  return false
}

// `Box{ f: (name) => … }`, `[]((T)=>R){ (x) => … }`, `map<K,(T)=>R>{ k: (x) => … }`
// — a composite literal's own type names the field/element/value type an
// arrow written directly inside it is expected against (#2749). The
// composite-literal counterpart of `seedArrowExpectedBinding`'s annotated
// `let`: nothing here can reject a program, only give an arrow that was
// always legal (SPEC §12.8) the parameter type it was missing, which left
// `name` in `Box{ f: (name) => "hi " + name }` typed `<error>` and lowered
// `"hi " + name` as a raw `add` over two string pointers instead of
// `string_concat` — a checker gap, not a lowering one.
//
// A class literal is visited per FIELD (each may name a different type); a
// map or slice/array literal shares one element type for the whole body, so
// the guard is hoisted once. This function is called once per CompositeLit
// node found anywhere in the tree, so a class literal NESTED inside another
// composite's field is reached by its own call, not by recursing here.
fn seedArrowExpectedComposite(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, body]
  let ty = typeFromNode(c, kids[0])
  if (ty == 0) {
    return
  }
  let kind = c.ctx.types[ty].kind
  if (kind == TypeKind.Struct) {
    for it of kidsOf(c.tree, kids[1]) {
      if (getNode(c.tree, it).tag != Tag.FieldInit) {
        continue
      }
      let fk = kidsOf(c.tree, it)
      if (getNode(c.tree, fk[1]).tag != Tag.ArrowFn) {
        continue
      }
      let fldNode = getNode(c.tree, fk[0])
      let fname = c.source[fldNode.span.start:fldNode.span.end]
      let (fty, isField) = c.ctx.structFields["${ty}.${fname}"]
      if (isField && fty != 0 && c.ctx.types[fty].kind == TypeKind.Func) {
        c.arrowExpected[fk[1]] = fty
      }
    }
    return
  }
  let elemTy = 0
  if (kind == TypeKind.Map) {
    elemTy = c.ctx.types[ty].mapVal
  } else if (kind == TypeKind.Slice || kind == TypeKind.Array) {
    elemTy = c.ctx.types[ty].elem
  } else {
    return
  }
  if (elemTy == 0 || c.ctx.types[elemTy].kind != TypeKind.Func) {
    return
  }
  for it of kidsOf(c.tree, kids[1]) {
    let val = it
    if (kind == TypeKind.Map) {
      val = kidsOf(c.tree, it)[1] // MapEntry [key, value]
    } else {
      val = argInner(c, it) // positional element, Arg-wrapped
    }
    if (getNode(c.tree, val).tag == Tag.ArrowFn) {
      c.arrowExpected[val] = elemTy
    }
  }
}

// `b.f = (name) => …` — a plain assignment's target field, the mutate-in-place
// counterpart of `seedArrowExpectedBinding`'s `let` (#2749). Only the simple
// `ident.field = arrow` shape is decided, matching every other pass in this
// file: a chained member (`a.b.f`), an index target, or a receiver whose
// declared type node did not resolve records nothing and leaves the arrow
// inferred exactly as it was before this function existed.
fn seedArrowExpectedAssign(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [LhsList, ExprList]
  let lhss = kidsOf(c.tree, kids[0])
  let rhss = kidsOf(c.tree, kids[1])
  if (len(lhss) != len(rhss)) {
    return // tuple/comma arity mismatch: a real error elsewhere, not ours to guess
  }
  let i = 0
  while (i < len(lhss)) {
    if (getNode(c.tree, rhss[i]).tag == Tag.ArrowFn) {
      let fty = assignTargetFuncType(c, lhss[i])
      if (fty != 0) {
        c.arrowExpected[rhss[i]] = fty
      }
    }
    i = i + 1
  }
}

// The declared type of assignment target `target`, when it is `recv.field`
// and `recv` is a simple identifier whose declared type node `declTypeNodes`
// already holds (`recordBindingDeclNodes`, seeded by pre-pass 3 ahead of this
// one). 0 for anything undecidable: a chained member, an index target, a
// non-class receiver, or a field that is not itself function-typed.
//
// Read through the resolver, like every other consumer of that map. #4531 had
// to keep a name-keyed twin here alone, because this runs in pre-pass 3b and
// `--dump-types`/`--dump-ir` reached it with no resolver at all — a node key
// answered 0 for every identifier and `b.f = (name) => …` printed
// `name: <error>` again. #4545 made those entry points resolve, so the name key
// is gone and two functions that each declare a `b` of a DIFFERENT class no
// longer get the last one's type each.
//
// `checkExprType(c, mk[0])` is NOT the way out even now: pre-pass 3 records a
// `let` binding's type in `declTypes[pat]` and writes the flat `env` only in the
// MAIN sweep, which runs after this — so the receiver has no type yet and the
// answer would be `<error>`. Measured on #4531, not assumed.
fn assignTargetFuncType(c: Checker, target: int): int {
  if (getNode(c.tree, target).tag != Tag.Member) {
    return 0
  }
  let mk = kidsOf(c.tree, target)
  if (getNode(c.tree, mk[0]).tag != Tag.Ident) {
    return 0
  }
  let tnode = declTypeNodeOf(c, mk[0])
  if (tnode == 0) {
    return 0
  }
  let recvTy = typeFromNode(c, tnode)
  if (recvTy == 0 || c.ctx.types[recvTy].kind != TypeKind.Struct) {
    return 0
  }
  let fldNode = getNode(c.tree, mk[1])
  let fname = c.source[fldNode.span.start:fldNode.span.end]
  let (fty, isField) = c.ctx.structFields["${recvTy}.${fname}"]
  if (!isField || fty == 0 || c.ctx.types[fty].kind != TypeKind.Func) {
    return 0
  }
  return fty
}

// `fn mk(): M { return (f) => … }` — a function's DECLARED result type is the
// expected type of an arrow written in its `return` (#4513/#4520). The fifth
// syntactic position, alongside the four above and the same SPEC §12.8 rule at
// another node shape: without it the arrow's own unannotated parameters stay at
// 0, and `f(21)` or `t.v()` inside the returned closure then reaches lowering
// with a callee that resolves to nothing (E0092) while `bit check` exits 0.
//
// Dispatched per FuncDecl, not per ReturnStmt, because the tree carries no
// parent link: the enclosing function of a `return` can only be found by
// descending from the declaration. `seedReturnedArrows` therefore stops at any
// nested ArrowFn or FuncDecl — a `return` inside one of those belongs to IT,
// and handing it this function's result type would be a WRONG expectation, the
// one way this pass could manufacture a diagnostic the oracle does not have.
//
// A generic declaration records nothing, matching `declParamListNode`'s -1
// (check.bit): its result type is written against type params that only a
// concrete instantiation binds, which is the same reason
// `seedArrowExpectedCall` hands a generic callee to `seedArrowExpectedGeneric`
// rather than reading its parameter types directly.
fn seedArrowExpectedReturn(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, name, generics, params, result, body]
  if (kids[2] != 0) {
    return // generic: no result type until an instantiation binds its params
  }
  if (kids[4] == 0 || kids[5] == 0) {
    return // no declared result, or no body
  }
  let ty = typeFromNode(c, kids[4])
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.Func) {
    return
  }
  seedReturnedArrows(c, kids[5], ty)
}

// Records `ty` on every arrow literal a `return` in this body hands back,
// descending through blocks, `if`s, loops and `match` arms and stopping at a
// nested ArrowFn or FuncDecl. Only a single-value `return` is decided: a
// multi-value one returns a tuple, which is never a Func type.
fn seedReturnedArrows(c: Checker, node: int, ty: int) {
  for k of kidsOf(c.tree, node) {
    if (k == 0) {
      continue
    }
    let t = getNode(c.tree, k).tag
    if (t == Tag.ArrowFn || t == Tag.FuncDecl) {
      continue
    }
    if (t != Tag.ReturnStmt) {
      seedReturnedArrows(c, k, ty)
      continue
    }
    let rk = kidsOf(c.tree, k)
    if (len(rk) == 1 && getNode(c.tree, rk[0]).tag == Tag.ArrowFn) {
      c.arrowExpected[rk[0]] = ty
    }
  }
}

// Pre-pass 3b's whole dispatch (checkmodule.bit): the seeding function for the
// node shape `tag` names, or nothing for every other tag. Lives here rather
// than as an if-elseif chain inline in `checkModule` because every arm added
// there costs that function +1 McCabe permanently (see vFuncOrTestDecl's
// header, validatefuncdecl.bit) — the fifth position above is the arm that
// made the chain worth moving.
fn seedArrowExpectedAt(c: Checker, node: int, tag: Tag) {
  if (tag == Tag.Binding) {
    seedArrowExpectedBinding(c, node)
  } else if (tag == Tag.Call) {
    seedArrowExpectedCall(c, node)
  } else if (tag == Tag.CompositeLit) {
    seedArrowExpectedComposite(c, node)
  } else if (tag == Tag.Assign) {
    seedArrowExpectedAssign(c, node)
  } else if (tag == Tag.FuncDecl) {
    seedArrowExpectedReturn(c, node)
  }
}
