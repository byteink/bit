// bit lsp (#2335) — textDocument/references, "who calls this" without
// grepping for a substring.
//
// THE GAP THIS FILLS: Bit has no qualified names, so a textual search for a
// method or field spelling cannot tell two same-named members on different
// types apart, and cannot tell a call site from an unrelated identifier that
// happens to share the spelling. This is the read-only half of #2334's
// rename (compiler/lsprename.bit): finding EVERY reference to a symbol is
// exactly the set rename needs to edit, minus the edit — so this file reuses
// `lspRenameTargetAt` (cursor -> target: a bare symbol id, or a member's
// receiver type + name) and `lspRenameSitesFor` (target -> every site,
// declaration included) wholesale rather than re-deriving either.
//
// The one piece rename's own sites list does not need and this does: telling
// the DECLARATION site apart from a use, so `context.includeDeclaration:
// false` can drop exactly one entry. `lspDeclNodeFor` below identifies it —
// for a member, it is `lspMemberRenameSites`' own first-appended
// `lspFindMemberDecl` result; for a bare symbol, it is
// `lspDefNameNode(tree, sym.decl)` (compiler/lspquery.bit), the same
// identifier node resolve.bit's `rInsertModuleSymbol`/`rActivateLocal` bind
// to the symbol's own id alongside every reference.
//
// SCOPED TO THE ROOT MODULE, same restriction as rename and for the same
// reason: `lspFindMemberDecl` and `nodeSymbols` both only ever scan the root
// module's own tree (lsprename.bit's header), so a field/method whose owning
// type — or a bare symbol — is declared in another module (imported,
// prelude, or a builtin) has no sites here at all rather than a false subset
// of them. A future cross-module references query is a separate ticket, not
// a silent partial answer from this one.

// Every site `lspRenameSitesFor` would edit, minus the declaration when
// `includeDeclaration` is false. `sites` always contains the declaration
// exactly once when `target.ok` (lsprename.bit's detectors all validate the
// declaration exists before returning `ok: true`), so `lspDeclNodeFor`'s
// result is never 0 here.
fn lspReferenceSites(c: Checker, target: LspRenameTarget, includeDeclaration: bool): []int {
  let sites = lspRenameSitesFor(c, target)
  if (includeDeclaration) {
    return sites
  }
  let declNode = lspDeclNodeFor(c, target)
  let out = []int(0)
  let i = 0
  while (i < len(sites)) {
    if (sites[i] != declNode) {
      out = append(out, sites[i])
    }
    i = i + 1
  }
  return out
}

// The single site node that IS the declaration, so it can be told apart from
// a use. Mirrors `lspRenameSitesFor`'s own two branches.
fn lspDeclNodeFor(c: Checker, target: LspRenameTarget): int {
  if (target.isMember) {
    return lspFindMemberDecl(c, target.recvType, target.name)
  }
  return lspDefNameNode(c.tree, c.symbols[target.sid].decl)
}

// `sites`' spans as LSP `Location` JSON objects, in `lspRenameSitesFor`'s own
// order (declaration first when included, then usage sites) — deterministic
// across otherwise-identical requests, rather than depending on iteration
// order over a map.
fn lspReferenceLocationsJson(p: Project, tree: Tree, sites: []int): []string {
  let out = []string(0)
  let i = 0
  while (i < len(sites)) {
    out = append(out, lspSpanLocationJson(p, getNode(tree, sites[i]).span))
    i = i + 1
  }
  return out
}

// `context.includeDeclaration` — required by the LSP spec's `ReferenceContext`
// but read as `false` when a client omits it (`jsonBoolOf` on a missing key),
// which is the conservative reading: an editor that forgot the field gets the
// usage sites only, never a silently-included declaration it did not ask for.
fn lspReferencesIncludeDeclaration(d: JsonDoc, params: int): bool {
  return jsonBoolOf(d, jsonGet(d, jsonGet(d, params, "context"), "includeDeclaration"))
}

fn lspOnReferences(server: LspServer, d: JsonDoc, params: int, idText: string) {
  let tdp = lspTextDocPosition(d, params)
  if (!tdp.ok) {
    lspRespond(idText, "[]")
    return
  }
  let path = lspUriToPath(tdp.uri)
  if (path == "") {
    lspRespond(idText, "[]")
    return
  }
  let lp = lspBuildProject(server, pathDir(path))
  if (len(lp.mods) == 0) {
    lspRespond(idText, "[]")
    return
  }
  let loc = lspLocateFile(lp, path)
  if (!loc.found) {
    lspRespond(idText, "[]")
    return
  }
  let c = lp.mods[lp.p.root]
  let offset = loc.fileStart + lspPosToByte(loc.fileSrc, tdp.pos)
  let nodePath = lspNodePath(c.tree, offset)
  let node = nodePath[len(nodePath) - 1]
  if (node == 0) {
    lspRespond(idText, "[]")
    return
  }
  let target = lspRenameTargetAt(c, node, nodePath)
  if (!target.ok) {
    lspRespond(idText, "[]")
    return
  }
  let sites = lspReferenceSites(c, target, lspReferencesIncludeDeclaration(d, params))
  lspRespond(idText, "[" + lspJoinComma(lspReferenceLocationsJson(lp.p, c.tree, sites)) + "]")
}
