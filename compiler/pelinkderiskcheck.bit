// The real de-risk payload: run on mustafa-desktop-win over SSH. Split out
// of pelinkcheck.bit (#5678) to keep that file's line count well under the
// 800-line ceiling; same flat compiler module, so `plWriteProbe`,
// `plObjectInput`, `plErr`, `linkPe`, `plLfanew` and `plFindSection` (all
// defined in pelinkcheck.bit) are visible here without an import.

// _start: GetStdHandle(STD_OUTPUT_HANDLE); GetConsoleMode(handle, &mode);
// print "csl=0\n" or "csl=1\n" depending on whether GetConsoleMode succeeded
// (the "console handle arrangement" the epic's SSH-host comment asks a test
// program to report, chosen because it needs no branch — a
// setnz/movzx/imul/add sequence selects between the two fixed messages);
// ExitProcess(0). Every instruction and every relocation offset below was
// verified with objdump against this exact byte sequence (module comment).
fn plDeriskCode(): []u8 {
  return [
    u8(0x48), u8(0x83), u8(0xE4), u8(0xF0),                                                   // and rsp,-16
    u8(0x48), u8(0x83), u8(0xEC), u8(0x30),                                                   // sub rsp,0x30
    u8(0xB9), u8(0xF5), u8(0xFF), u8(0xFF), u8(0xFF),                                         // mov ecx,STD_OUTPUT_HANDLE
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                                         // call GetStdHandle (off 14)
    u8(0x49), u8(0x89), u8(0xC4),                                                             // mov r12,rax
    u8(0x4C), u8(0x89), u8(0xE1),                                                             // mov rcx,r12
    u8(0x48), u8(0x8D), u8(0x54), u8(0x24), u8(0x20),                                         // lea rdx,[rsp+0x20]
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                                         // call GetConsoleMode (off 30)
    u8(0x85), u8(0xC0),                                                                       // test eax,eax
    u8(0x0F), u8(0x95), u8(0xC0),                                                             // setnz al
    u8(0x0F), u8(0xB6), u8(0xC0),                                                             // movzx eax,al
    u8(0x6B), u8(0xC0), u8(0x06),                                                             // imul eax,eax,6
    u8(0x48), u8(0x8D), u8(0x15), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                     // lea rdx,[rip+msgs] (off 48)
    u8(0x48), u8(0x01), u8(0xC2),                                                             // add rdx,rax
    u8(0x4C), u8(0x89), u8(0xE1),                                                             // mov rcx,r12
    u8(0x41), u8(0xB8), u8(0x06), u8(0x00), u8(0x00), u8(0x00),                               // mov r8d,6
    u8(0x4C), u8(0x8D), u8(0x4C), u8(0x24), u8(0x28),                                         // lea r9,[rsp+0x28]
    u8(0x48), u8(0xC7), u8(0x44), u8(0x24), u8(0x20), u8(0x00), u8(0x00), u8(0x00), u8(0x00), // mov qword[rsp+0x20],0
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                                         // call WriteFile (off 79)
    u8(0x31), u8(0xC9),                                                                       // xor ecx,ecx
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),
  ] // call ExitProcess (off 86)
}

fn plDeriskBytes(): []u8 {
  let code = plDeriskCode()
  let msgs = []byte("csl=0\ncsl=1\n")
  return plWriteProbe(
    [
      PeSection{ kind = PeSectionKind.Text, data = code, size = 0, alignment = 16 },
      PeSection{ kind = PeSectionKind.Rodata, data = msgs, size = 0, alignment = 1 },
    ],
    [
      PeSymbol{
        name = "_start", hasSection = true, section = PeSectionKind.Text,
        offset = 0, size = len(code), binding = PeBinding.Global, kind = PeSymKind.Func,
      },
      PeSymbol{
        name = "msgs", hasSection = true, section = PeSectionKind.Rodata,
        offset = 0, size = len(msgs), binding = PeBinding.Local, kind = PeSymKind.Object,
      },
      PeSymbol{
        name = "GetStdHandle", hasSection = false, section = PeSectionKind.Text,
        offset = 0, size = 0, binding = PeBinding.Global, kind = PeSymKind.Notype,
      },
      PeSymbol{
        name = "GetConsoleMode", hasSection = false, section = PeSectionKind.Text,
        offset = 0, size = 0, binding = PeBinding.Global, kind = PeSymKind.Notype,
      },
      PeSymbol{
        name = "WriteFile", hasSection = false, section = PeSectionKind.Text,
        offset = 0, size = 0, binding = PeBinding.Global, kind = PeSymKind.Notype,
      },
      PeSymbol{
        name = "ExitProcess", hasSection = false, section = PeSectionKind.Text,
        offset = 0, size = 0, binding = PeBinding.Global, kind = PeSymKind.Notype,
      },
    ],
    [
      PeRelocation{
        section = PeSectionKind.Text,
        offset = 14,
        symbol = "GetStdHandle",
        kind = PeRelocKind.Rel32,
      },
      PeRelocation{
        section = PeSectionKind.Text,
        offset = 30,
        symbol = "GetConsoleMode",
        kind = PeRelocKind.Rel32,
      },
      PeRelocation{
        section = PeSectionKind.Text,
        offset = 48,
        symbol = "msgs",
        kind = PeRelocKind.Rel32,
      },
      PeRelocation{
        section = PeSectionKind.Text,
        offset = 79,
        symbol = "WriteFile",
        kind = PeRelocKind.Rel32,
      },
      PeRelocation{
        section = PeSectionKind.Text,
        offset = 86,
        symbol = "ExitProcess",
        kind = PeRelocKind.Rel32,
      },
    ],
  )
}

// #3630: SizeOfStackCommit MUST equal SizeOfStackReserve, so a Windows
// thread's whole stack is committed at creation rather than grown lazily
// behind a guard page.
//
// This is not a tuning knob. `runtime/sched/identity.bit`'s task-identity scheme
// finds the running task by masking the live `sp` down to `schedStackBytes`
// (262144) and dereferencing the tag word there — `schedTaskOnStack`, called
// from `schedCurrentTask`, `schedCurrentScratch` and `schedStackHeadroom`.
// That address is up to `schedStackBytes - 8` bytes BELOW `sp`. On a green
// task stack it is always mapped (one VirtualAlloc MEM_COMMIT region), but on
// a NATIVE OS thread stack — the boot thread and every worker — Windows
// commits lazily behind a single guard page, and a load that skips past that
// guard raises STATUS_ACCESS_VIOLATION rather than growing the stack (the
// same rule that makes MSVC/clang emit __chkstk for frames over one page).
// With the old 0x1000 commit every x86_64-windows program died during boot,
// before `bit_main`, with a misattributed "bit: stack overflow in a spawned
// task" — verified on mustafa-desktop-win: the faulting address was exactly
// `(sp & ~(262144 - 1)) + 8`, `schedTaskOnStack`'s own tag load.
//
// So the floor below is the load-bearing half: the commit must cover the
// identity granule. Equality with the reserve is how it is achieved and is
// asserted too, because a partial commit only moves the cliff rather than
// removing it.
fn checkPeLinkStackCommit() {
  let bytes = plDeriskBytes()
  let inputs = [plObjectInput(bytes)]
  let allowed = ["GetStdHandle", "GetConsoleMode", "WriteFile", "ExitProcess"]
  let exe = linkPe(inputs, allowed) catch _ {
    []u8(0)
  }
  assert(len(exe) > 0)
  let optOff = plLfanew() + 4 + sizeofPeFileHeader()
  let reserve = leAt(exe, optOff + 72, 8)
  let commit = leAt(exe, optOff + 80, 8)
  assert(commit == reserve)
  assert(commit >= 262144) // runtime/sched/identity.bit's schedStackBytes
}

fn checkPeLinkDerisk() {
  let bytes = plDeriskBytes()
  let inputs = [plObjectInput(bytes)]
  let allowed = ["GetStdHandle", "GetConsoleMode", "WriteFile", "ExitProcess"]
  assert(plErr(inputs, allowed) == "")
  let exe = linkPe(inputs, allowed) catch _ {
    []u8(0)
  }
  assert(len(exe) > 0)
  assert(exe[0] == u8(77) && exe[1] == u8(90))
  let optOff = plLfanew() + 4 + sizeofPeFileHeader()
  assert(leAt(exe, optOff, 2) == 0x020B)
  let entryRva = leAt(exe, optOff + 16, 4)
  let textSec = plFindSection(exe, ".text")
  assert(textSec.found)
  let textRva = leAt(exe, textSec.sh + 12, 4)
  let textVsize = leAt(exe, textSec.sh + 8, 4)
  assert(entryRva >= textRva && entryRva < textRva + textVsize)
  let idataSec = plFindSection(exe, ".idata")
  assert(idataSec.found) // GetStdHandle, GetConsoleMode, WriteFile, ExitProcess

  let outPath = envOr("BIT_PE_DERISK_OUT", "")
  if (outPath != "") {
    writeFile(outPath, string(exe)) catch _ {}
  }
}
