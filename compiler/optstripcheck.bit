// compiler/optstripcheck.bit — #4204: the strip-mining predicate, checked
// against the real pipeline rather than against a hand-built IrFunc.
//
// WHY THESE ARE UNIT CHECKS AND NOT A GOLDEN CASE. A golden case compares a
// program's OUTPUT, and this transformation is required to leave output
// unchanged — so a golden case cannot see it working OR see it silently stop
// working. That is the shape this repo already documents for a validator: if a
// rule stops running the tool says LESS, not more, and the build still
// succeeds. What has to be pinned is the DECISION, so each check below asserts
// `IrBlock.pollFreeHeader` after `optimizeModule` on a source that the
// predicate must accept, and on five that it must refuse for five different
// stated reasons.
//
// Each `must refuse` arm is the durable form of the disassembly walk on the
// ticket: with the poll suppressed on a loop the predicate should not have
// admitted, the latency bound in runtime/ABI.md section 5 stops holding, and
// nothing else in the tree would notice.

// How many blocks of `src`'s first function are strip-mined inner headers.
fn stripCheckHeaders(src: string): int {
  let m = lowerSourceModule(src)
  optimizeModule(m, false)
  let n = 0
  let fi = 0
  while (fi < len(m.funcs)) {
    let f = m.funcs[fi]
    let b = 0
    while (b < len(f.blocks)) {
      if (f.blocks[b].pollFreeHeader) {
        n = n + 1
      }
      b = b + 1
    }
    fi = fi + 1
  }
  return n
}

// A body the predicate admits: counted, step one, no call, no allocation, no
// nested back edge. One header must come back marked, and the block it marks
// must be a real loop header — asserted by there being exactly one, since a
// second would mean the outer loop this pass BUILDS was marked too, which
// would suppress the only poll the loop has left.
fn checkStripAcceptsCountedLoop() {
  let src = "fn main() {\n" +
    "  let n = 1000\n" +
    "  let s = 0\n" +
    "  let i = 0\n" +
    "  while (i < n) {\n" +
    "    s = s + i\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  assert(s >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 1, "a plain counted loop must be strip-mined")
}

// A nest: only the INNERMOST loop is admitted. Two marked headers would mean
// the bound composes multiplicatively (stripSize() inner x stripSize() outer),
// which is the reason `stripInnermost` exists.
fn checkStripAcceptsOnlyInnermost() {
  let src = "fn main() {\n" +
    "  let u = 0\n" +
    "  let p = 0\n" +
    "  while (p < 20) {\n" +
    "    let q = 0\n" +
    "    while (q < 20) {\n" +
    "      u = u + 1\n" +
    "      q = q + 1\n" +
    "    }\n" +
    "    p = p + 1\n" +
    "  }\n" +
    "  assert(u >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 1, "only the innermost loop of a nest may be strip-mined")
}

// The refusals, one per rule. Each body differs from `checkStripAcceptsCountedLoop`'s
// in exactly the one property being tested.
fn checkStripRefusesUncounted() {
  // The induction variable is MULTIPLIED: `stripLatchOk` needs `i + 1`.
  let src = "fn main() {\n" +
    "  let a = 1\n" +
    "  let k = 0\n" +
    "  while (a < 1000000) {\n" +
    "    a = a * 3\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  assert(k >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 0, "a multiplicative induction variable must be refused")
}

fn checkStripRefusesNonUnitStep() {
  // Step two: the exit is no longer exact and `o + step` has no room left to
  // test for overflow on the narrow arm.
  let src = "fn main() {\n" +
    "  let s = 0\n" +
    "  let i = 0\n" +
    "  while (i < 100) {\n" +
    "    s = s + i\n" +
    "    i = i + 2\n" +
    "  }\n" +
    "  assert(s >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 0, "a step other than one must be refused")
}

fn checkStripRefusesAllocatingBody() {
  // THE ONE THAT MATTERS MOST: an allocation between polls is what would let
  // the heap overshoot while a strip runs, so the latency argument in
  // runtime/ABI.md section 5 rests on this refusal.
  let src = "fn main() {\n" +
    "  let xs: []i64 = []i64(0)\n" +
    "  let i = 0\n" +
    "  while (i < 50) {\n" +
    "    xs = append(xs, i)\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  assert(len(xs) >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 0, "an allocating loop body must be refused")
}

// The callee below is RECURSIVE, which `inlineEligible`'s `calleeIdx ==
// callerIdx` test refuses outright (optinline.bit), so a real `call` survives
// into the loop body. It allocates nothing and branches on an integer, so the
// only rule this fixture can be refused by is the call rule.
//
// IT USED TO BE A MULTI-BLOCK CALLEE, and this comment used to explain that
// `calleeShapeOk` would not splice one. #4344 lifted that refusal — a callee
// with an early `return` is exactly what it was lifted FOR — so the callee was
// inlined, the loop legitimately qualified, and the check failed loudly. It
// failing is the good outcome: a refusal fixture whose refusal has become
// vacuous asserts nothing and looks identical to one that works.
fn checkStripRefusesCallingBody() {
  let src = "fn f(x: i64): i64 {\n" +
    "  if (x <= 0) {\n" +
    "    return 0\n" +
    "  }\n" +
    "  return f(x - 1) + 1\n" +
    "}\n" +
    "fn main() {\n" +
    "  let t = 0\n" +
    "  let i = 0\n" +
    "  while (i < 50) {\n" +
    "    t = t + f(i)\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  assert(t >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 0, "a loop body that still holds a call must be refused")
}

// #4463: the trip-count floor. The three checks below are the DECISION half of
// that predicate, and they are the only place it is asserted: strip mining is
// required to leave output unchanged, so no golden case can see the floor
// working or see it silently stop working.

// A loop whose trip count is provably BELOW the break-even must be refused.
//
// Eight, against `stripBreakEvenTrips()` of 11. The pair with
// `checkStripAcceptsOnlyInnermost`, whose inner loop runs twenty, is what makes
// this check about the floor and not about anything else: the two sources
// differ in the bound and in nothing else.
fn checkStripRefusesShortTrip() {
  let src = "fn main() {\n" +
    "  let s = 0\n" +
    "  let i = 0\n" +
    "  while (i < 8) {\n" +
    "    s = s + i\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  assert(s >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 0, "a loop below the strip-mining break-even must be refused")
}

// A loop whose trip count cannot be BOUNDED at all must be refused. `len(xs)`
// is the shape that matters in practice: in bench/cases/sort one such loop runs
// 3 to 14 laps and another runs 800,000, and nothing in the IR tells them
// apart, so the pass took the preamble on both and lost 1.16% overall.
//
// The slice is allocated with a literal size on purpose. If this compiler ever
// learns to fold `slice_len` of a constant-sized allocation, this fixture stops
// testing a refusal — and it will say so by FAILING, because the loop would
// then be bounded at 1000 and correctly accepted. A refusal fixture that goes
// vacuous silently is the failure this file's header is about.
fn checkStripRefusesUnboundedTrip() {
  let src = "fn main() {\n" +
    "  let xs: []i64 = []i64(1000)\n" +
    "  let s = 0\n" +
    "  let i = 0\n" +
    "  while (i < len(xs)) {\n" +
    "    s = s + xs[i]\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  assert(s >= 0)\n" +
    "}\n"
  assert(stripCheckHeaders(src) == 0, "a loop with no provable trip count must be refused")
}

// Two loops, one function, and only the bounded one is mined. Neither loop can
// explain the other's verdict: they sit side by side in the same function, over
// the same slice, with the same body shape and the same step — the only
// difference is that one bound is a literal and the other is a `len`.
//
// This is what makes the count of ONE meaningful. `checkStripRefusesUnboundedTrip`
// alone cannot separate "the floor refused it" from "something else in the
// pass refused the whole function", and a check that reads zero for the wrong
// reason is indistinguishable from one that works.
fn checkStripFloorSeparatesTwoLoops() {
  let src = "fn main() {\n" +
    "  let xs: []i64 = []i64(1000)\n" +
    "  let s = 0\n" +
    "  let i = 0\n" +
    "  while (i < 1000) {\n" +
    "    s = s + xs[i]\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  let j = 0\n" +
    "  while (j < len(xs)) {\n" +
    "    s = s + xs[j]\n" +
    "    j = j + 1\n" +
    "  }\n" +
    "  assert(s >= 0)\n" +
    "}\n"
  assert(
    stripCheckHeaders(src) == 1,
    "the bounded loop must be mined and the len-bounded one refused",
  )
}
