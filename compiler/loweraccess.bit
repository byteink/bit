// compiler/loweraccess.bit — split out of lowerlit.bit (#2911) to keep both
// files under the 800-line lint limit; see lowerlit.bit for literal
// construction (class/slice/array/map/chan composites and zero values).
// Sibling of lowerlit.bit: same module, so this needs no imports and no
// call-site changes. Field access (`s.f`, `Enum.Variant`), map get with its
// zero-value miss handling, and indexed read (`a[i]`); reslice (`a[lo:hi]`)
// moved to lowerreslice.bit (#4048), again for the line limit.

// Lowers a class field access `s.f` to `field_get %s[offset] fieldType`, or an
// enum variant reference `Enum.Variant` to its tag constant.
fn lowerFieldAccess(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  // `ns.member` — an exported const/state/function of a namespaced module, not a
  // field of a value. Its dotted key resolves through the ordinary name path.
  let qn = nsQualifiedName(fc.c, node)
  if (qn != "") {
    return lowerNamedValue(fc, node, qn)
  }
  // `Enum.Variant` (receiver is an enum type name): a C-like enum's variant is
  // its bare tag `const_int <Enum> <ordinal>`; a boxed enum's no-payload variant
  // wraps that tag in the `{tag, nil}` object.
  let baseName = typeNodeName(fc.c, kids[0])
  if (baseName != "") {
    let ut = userTypeLookup(fc.c, baseName)
    if (ut != 0 && fc.c.ctx.types[ut].kind == TypeKind.Enum) {
      let mn0 = getNode(fc.c.tree, kids[1])
      let ord = variantOrdinal(fc.c, ut, fc.c.source[mn0.span.start:mn0.span.end])
      if (fc.c.ctx.types[ut].enumBoxed) {
        return buildEnumObj(fc, ut, ord, -1)
      }
      let ci = mkInstr(Op.ConstInt, ut)
      ci.ival = ord
      return builderEmit(fc.b, ci)
    }
  }
  let recvTy = nodeType(fc, kids[0])
  // An uncalled interface method `iface.m` is a closure over the receiver plus a
  // trampoline that dispatches dynamically (call_iface).
  if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Interface) {
    return lowerIfaceMethodValue(fc, node, recvTy)
  }
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fcFail(
      fc,
      getNode(fc.c.tree, node).span,
      "a `.` field access on a receiver that is not a class or interface",
    )
    return 0
  }
  let decl = structDeclOf(fc.c, recvTy)
  if (decl == 0) {
    fcFail(
      fc,
      getNode(fc.c.tree, node).span,
      "a field access on a class with no declaration in scope",
    )
    return 0
  }
  let oc = typeOwner(fc.c, recvTy)
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(fc.c.tree, kids[1])
  let idx = fieldIndexByName(oc, fields, fc.c.source[mn.span.start:mn.span.end])
  if (idx == -1) {
    return lowerStructMethodValue(fc, node, recvTy)
  }
  // Substituted so a generic field's declared `T` is laid out at the
  // instantiation's real argument width. Must stay in step with the matching
  // `field_set` in `lowerFieldStore` — a read and a write of the same field
  // agreeing on a WRONG offset is worse than either alone (#1565).
  let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, recvTy))
  let recvV = lowerMemberReceiver(fc, kids[0], recvTy)
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.FieldGet, fieldAccessType(fc, oc, fields[idx], node))
  ins.lhs = recvV
  ins.ival = layout.offsets[idx]
  return builderEmit(fc.b, ins)
}

// The receiver value for a `.` field access or field assignment (#3862).
// Ordinarily just `lowerExpr` on the receiver node. But when the receiver is
// itself `xs[i]` on a slice using the PACKED element representation
// (`sliceElemSizeFor(fc, recvTy) > 8`), there is no boxed reference to
// lower `xs[i]` to at all — `lowerIndex`/`bit_rt_slice_get` are both
// word-valued and #3861 made the runtime FATAL on a wider stride precisely
// because neither can express one. So this computes the element's own
// address directly and hands that back instead, which `Op.FieldGet`/
// `Op.FieldSet` read and write exactly as they would a normal boxed
// receiver — see `emitPackedElemAddr` for why that address is safe to use
// this way without being independently GC-traced.
fn lowerMemberReceiver(fc: FnCtx, recvNode: int, recvTy: int): int {
  if (getNode(fc.c.tree, recvNode).tag == Tag.Index) {
    let stride = sliceElemSizeFor(fc, recvTy)
    if (stride > 8) {
      let ik = kidsOf(fc.c.tree, recvNode)
      let base = lowerExpr(fc, ik[0])
      let ix = lowerExpr(fc, ik[1])
      if (fc.failed) {
        return 0
      }
      return emitPackedElemAddr(fc, base, ix, stride)
    }
  }
  return lowerExpr(fc, recvNode)
}

// The concrete type of a class field READ. The declared field node is the
// template's answer (`b: T` of a `Pair<T>` is the bare param), so a read off a
// `Pair<i64>` would emit `field_get ... <T>` — wrong width and, worse, wrong
// is_ref, which is a GC-tracing bug rather than a compile error.
//
// `checkMember` already substitutes the receiver's type arguments, so prefer the
// checker's answer for this node. It is only an improvement when it resolves the
// parameter away; when it cannot (an inferred receiver whose args are
// unrecoverable) it hands back a type still mentioning the parameter, and the
// declared type stands. Permissive when undecided: never trade a known type for
// an unknown one.
//
// The openness test is STRUCTURAL (#1556). Testing only whether the declared
// type is ITSELF a bare TypeParam accepted `[]T`, `chan<T>`, `map<string, T>`,
// `[2]T`, `(T) => T` and `Box<T>` verbatim, because none of those is a TypeParam
// at the top level — so a read off a `Shapes<i64>` emitted
// `field_get %0[8] []<T>` where the seed emits `[]i64`. That is the is_ref bug
// this function's comment warns about, reached one level down: a slice of a type
// param classifies as holding GC references.
fn fieldAccessType(fc: FnCtx, oc: Checker, field: int, node: int): int {
  let declTy = typeFromNode(oc, kidsOf(oc.tree, field)[1])
  if (declTy != 0 && !vHasTypeParam(fc.c, declTy, 0)) {
    return declTy
  }
  let checked = nodeType(fc, node)
  if (checked != 0 && !vHasTypeParam(fc.c, checked, 0)) {
    return checked
  }
  return declTy
}

// Does `ty`'s zero value (SPEC §13.4) differ from the null word that `map_get`
// reports a miss with? True for the reference types whose zero is a live object
// — `string` (`""`), slice (empty), class (zeroed instance), `[N]T` (zeroed
// block). False for map/chan/function/interface, whose zero IS `nil`, and for
// every scalar, whose zero IS the word 0.
fn zeroIsObject(fc: FnCtx, ty: int): bool {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    return td.prim == 11
  }
  return td.kind == TypeKind.Slice || td.kind == TypeKind.Array || td.kind == TypeKind.Struct
}

// `m[k]` (SPEC §12.6): a missing key yields the value type's zero value.
// `map_get` can only report a miss as the null word, so where V's zero is a live
// object materialize it on the miss edge — otherwise a miss hands back a null
// header and the first `len`/field read faults (#1557). The zero is built
// lazily, inside the miss block, so a hit allocates nothing.
//
// WHEN V HAS NO ZERO VALUE AT ALL (a class with a class-typed field, §13.4)
// the miss edge cannot be satisfied, and what happens then depends on which form
// the programmer wrote (#1926):
//
//   `let v = m[k]`         -> `missPanics`, and the miss edge PANICS naming the
//                             type. There is no value to hand back and no way
//                             for the caller to have known, so failing loudly at
//                             the read beats returning a null that faults later
//                             somewhere that no longer mentions the map.
//   `let (v, ok) = m[k]`   -> NOT `missPanics`. The comma-ok form exists to ask
//                             whether the key is there; making it panic would
//                             leave such a map unreadable by any means. `v` is
//                             the raw null and `ok` is false, which is the
//                             contract that form already carries.
//
// That split is the same one C++ draws between `operator[]` (requires a
// default-constructible value) and `find`, and the same one this compiler
// already applies to `[]T(n)`: reject or fail loudly on the unchecked form,
// leave the checked form usable.
//
// Every case decidable at compile time is already E0083 from the checker; this
// is only for a key whose presence is not knowable until it runs.
// How emitMapGet handles a missing key, bundled into one param (#2189, E0202):
// `panics` is false only for the comma-ok form, where absence is reported
// through `ok` instead. `span` is the source span of the index/lvalue this
// read came from, for the refusal a value type with no zero value forces.
class MapGetMiss {
  panics: bool,
  span: Span,
}

fn emitMapGet(fc: FnCtx, valTy: int, m: int, key: int, onMiss: MapGetMiss): int {
  let gv = mkInstr(Op.RtCall, valTy)
  gv.name = "map_get"
  gv.args = [m, key]
  return emitMapMiss(fc, valTy, emitRtCall(fc, gv), onMiss)
}

// The miss edge of a map read, given the raw word `v` the read produced — null
// when the key was absent. Shared by `m[k]` above and by `emitMapCommaOk`
// below, which reaches it with `map_val_at`'s word instead of `map_get`'s: one
// miss policy, so the two forms cannot drift apart on a value type whose zero
// is a live object.
fn emitMapMiss(fc: FnCtx, valTy: int, v: int, onMiss: MapGetMiss): int {
  if (!zeroIsObject(fc, valTy)) {
    return v
  }
  // Comma-ok over a value type with no zero value: hand back the null and let
  // `ok` speak. No miss block, so a miss costs nothing.
  if (!onMiss.panics && structHasNoZeroValue(fc, valTy)) {
    return v
  }
  let miss = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = neNil(fc, v, valTy)
  br.ival = join
  br.thenArgs = [v]
  br.ival2 = miss
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, miss)
  if (structHasNoZeroValue(fc, valTy)) {
    // Terminates the miss block; `join` is then reached only from the hit edge,
    // which still carries the parameter below.
    emitNoZeroValuePanic(fc, valTy, "m[k]")
  } else {
    let zero = zeroValue(fc, valTy, onMiss.span)
    if (fc.failed) {
      return 0
    }
    emitJump(fc, join, [zero])
  }
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, valTy)
}

// `let (v, ok) = m[k]` (SPEC §12.6), as ONE probe rather than two.
//
// It used to emit `map_get` and then `map_has` — two exported calls that each
// hashed and walked the same table for one source expression (#4019, 20.0% of
// `bench/cases/map`). `map_slot` probes once and answers both questions: `ok`
// is `slot >= 0`, and `map_val_at` turns the slot into the value word by
// indexing, with no probe at all. A negative slot reads as the zero word
// (ABI.md §15), which is the same null `map_get` reported a miss with, so the
// shared miss edge above needs no change.
//
// `ok` is emitted BEFORE the miss edge splits the block, so it is defined in a
// block that dominates the join — the same way `m` and `key` already outlive
// that split at this call site.
fn emitMapCommaOk(fc: FnCtx, valTy: int, m: int, key: int, span: Span): []int {
  let i64ty = primType(fc.c.ctx, 3)
  let sv = mkInstr(Op.RtCall, i64ty)
  sv.name = "map_slot"
  sv.args = [m, key]
  let slot = emitRtCall(fc, sv)
  let ge = mkInstr(Op.ICmpSge, primType(fc.c.ctx, 10))
  ge.lhs = slot
  ge.rhs = builderEmit(fc.b, mkInstr(Op.ConstInt, i64ty))
  let ok = builderEmit(fc.b, ge)
  let vv = mkInstr(Op.RtCall, valTy)
  vv.name = "map_val_at"
  vv.args = [m, slot]
  let v = emitMapMiss(fc, valTy, emitRtCall(fc, vv), MapGetMiss{ panics: false, span: span })
  if (fc.failed) {
    return []int(0)
  }
  return [v, ok]
}

// The element address of an inline `xs[i]`, once the bounds test has passed:
// `buf` is the buffer base and `slot` the element's WORD INDEX within it
// (`off + index`), so the element lives at `buf + slot * 8`.
class SliceElem {
  buf: int,
  slot: int,
}

// The shared front half of an inline slice element access — the bounds test, the
// out-of-line panic, and the element address — for BOTH the read (#3107,
// `emitInlineSliceGet`) and the write (#3108, `emitInlineSliceSet`). Each of
// those is this plus one final load or store. It is one function on purpose: a
// bounds test or an offset computation that drifted between the two paths would
// be a memory-safety hole on whichever side lost it, and nothing downstream
// would notice — `index_get`/`index_set` are raw word addressing.
//
// WHY INLINE AT ALL. `bit_rt_slice_get` (runtime/root/slices.bit:252) is 190
// instructions, 146 of them on the in-bounds path — 78 `mov`, 24
// prologue/epilogue, and a `runtime/gc/mem.bit` `wordAt` pointer round-trip —
// for what C does in two, and `bit_rt_slice_set` is 193/151 for the same
// reasons. They are the hottest symbols in the language, and #3102 measured
// element access at 90.4% of the matrix benchmark's runtime. This reproduces
// their semantics verbatim at the call site; both runtime entry points stay
// exported (ABI.md §2) for out-of-tree callers.
//
// THE SEMANTICS, from runtime/root/slices.bit:253-267 (`rtSliceGet`) and
// :296-309 (`rtSliceSet`), which differ only in the last line:
//
//   h == 0                      -> panic "index out of range"
//   index < 0 || index >= h.len -> panic "index out of range"
//   addr = h.buf + (h.off + index) * 8
//
// THE NULL HEADER NEEDS NO SEPARATE TEST. A zeroed class's slice field is the
// null word (#1564), and `slice_len` already reads a null header as 0 — both
// backends route it through `emitHeaderWordOrZero`. So a null receiver has
// length 0, every index fails the bounds test, and control reaches the SAME
// panic block. That is exactly the answer `rtSliceGet`'s explicit `h == 0` arm
// gives, reached by one branch instead of two.
//
// ONE UNSIGNED COMPARE COVERS BOTH BOUNDS. `(u64)index < (u64)len` is false for
// a negative index (which reads as a huge unsigned) and for `index >= len`, so
// the check is one `cmp` + one conditional branch — the shape C and Go both
// use. It is exact at every index width because this compiler keeps every
// integer register width-canonical (arm64select.bit's `canonNarrow`: "every
// value in a register is its true value sign/zero-extended to 64 bits") and
// both backends' `icmp` is a full 64-bit compare, so a narrow negative index
// arrives here already sign-extended.
//
// THE PANIC STAYS OUT OF LINE, in a block that ends in `unreachable`. #2014
// measured what happens otherwise: materialising the message words inside the
// hot function took the saved-register set from x29/x30 to x19-x27 and cost +8%
// on a pure-index loop. The message text is the runtime's own, so an
// out-of-range access still exits 2 with `panic: index out of range`.
//
// THE GC HAZARD, AND WHY THIS IS SAFE. `buf` is a GC-managed pointer, and once
// it lives in a vreg the collector can no longer find it through the header: it
// is an `i64` here, so no stack map describes it (ABI.md §4). What makes that
// sound is that `buf`'s LIVE RANGE CONTAINS NO SAFEPOINT — by construction, not
// by luck. Every instruction between the load of `buf` and the element access is
// arithmetic in ONE straight-line block: no call, no allocation, and no back
// edge (`isBackEdge` is `target <= curBlock`, and both blocks minted here have
// ids above the current one, so `emitBackEdgeSafepointIfNeeded` emits nothing).
// Nor can a later pass open that window: `opt.bit` folds constants, deletes dead
// values and prunes blocks, and has no code motion at all — no LICM, no GVN — so
// nothing can be scheduled between the load and the access. Anything that later
// adds cross-block motion to the optimizer must keep this sequence intact or
// describe `buf` in the stack map.
//
// THE STORED VALUE NEEDS NO WRITE BARRIER, and that is a fact about this
// collector rather than an omission (#3108). `runtime/gc/gccollect.bit:53` is a
// full STOP-THE-WORLD MARK-SWEEP: not generational, not incremental, not
// concurrent, and non-moving. There is no barrier anywhere in the tree to drop —
// `grep -rn -i barrier runtime/ compiler/` finds only memory fences — and the
// ordinary reference-field store already emits a bare store on both backends by
// the same reasoning (`arm64selectmem.bit:84`: "no write barrier — the runtime's
// write-barrier contract is not settled yet (the collector is stop-the-world, so
// nothing needs one today)"). `rtSliceSet` itself is a plain `storeWord`, so the
// call this replaces was performing no barrier either. `slcIsRef` (offset 32) is
// NOT what the collector reads: its three uses are all in
// `runtime/root/slices.bit` (set at creation :181, read when growing to pick the
// new buffer's descriptor :223, copied on reslice :348). Ref-ness is baked into
// the buffer object's type-info descriptor at allocation — `allocBuf` picks
// `riRefArray` over `riSliceBuf` (`runtime/root/root.bit:545`) — and a store into
// the buffer cannot change that. When the GC goes incremental, the barrier is
// owed here and at both backends' `field_set` together.
fn emitInlineSliceElem(fc: FnCtx, recv: int, idx: int): SliceElem {
  let i64ty = primType(fc.c.ctx, 3)
  let vlenIns = mkInstr(Op.SliceLen, i64ty)
  vlenIns.lhs = recv
  let cmp = mkInstr(Op.ICmpUlt, primType(fc.c.ctx, 10))
  cmp.lhs = idx
  cmp.rhs = builderEmit(fc.b, vlenIns)
  let inBounds = builderEmit(fc.b, cmp)
  // Minted in emission order, so the ids ascend with the linear schedule the
  // x64 linear-scan allocator's interval numbering assumes.
  let oob = builderNewBlock(fc.b)
  let ok = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = inBounds
  br.ival = ok
  br.ival2 = oob
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, oob)
  let msg = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  msg.sval = "index out of range"
  msg.ival = internPoolString(fc, msg.sval)
  let pn = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  pn.name = "panic"
  pn.args = [builderEmit(fc.b, msg)]
  emitRtCall(fc, pn)
  builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, ok)
  // Header words at ABI.md §2 offsets: `buf` 0, `off` 16. `off` is NOT always
  // zero — a reslice `s[lo:hi]` carries a non-zero view offset — so it is
  // loaded and added rather than assumed away. Both reads go through the
  // null-safe header path (the base is still slice-typed), which costs two
  // never-taken branches and is what `lowerPtrOf` already does.
  let bufIns = mkInstr(Op.FieldGet, i64ty)
  bufIns.lhs = recv
  bufIns.ival = 0
  let buf = builderEmit(fc.b, bufIns)
  let offIns = mkInstr(Op.FieldGet, i64ty)
  offIns.lhs = recv
  offIns.ival = 16
  let add = mkInstr(Op.Add, i64ty)
  add.lhs = builderEmit(fc.b, offIns)
  add.rhs = idx
  return SliceElem{ buf: buf, slot: builderEmit(fc.b, add) }
}

// The address of `xs[idx]`'s PACKED element — `buf + (off+idx)*stride`
// (#3862) — for a `[]T` using the inline element representation
// (`sliceElemSizeFor` returning T's own size rather than 8). Shares
// `emitInlineSliceElem`'s bounds check and buf/off read; only the scale
// differs, since a packed stride need not be 8 or a power of two (a class's
// own 8-aligned size, per `structLayout`).
//
// The returned value is a bare `i64`, deliberately never `T`'s own reference
// type: it addresses the MIDDLE of an untraced, header-less packed buffer,
// and typing it as `T` would mark it a live GC reference wherever it is
// bound to a local (`bindSlotTy`/`isRefType`) — corrupting the exact
// invariant this feature exists to preserve (runtime/ABI.md §1's
// `ptr_offsets` contract). `Op.FieldGet`/`Op.FieldSet` only need an
// integer-classed base address, not a specific IR type, which is the same
// reason `emitInlineSliceGet`'s own non-word-stride arm below types its
// computed address `i64`.
fn emitPackedElemAddr(fc: FnCtx, recv: int, idx: int, stride: int): int {
  let e = emitInlineSliceElem(fc, recv, idx)
  let i64ty = primType(fc.c.ctx, 3)
  let strideI = mkInstr(Op.ConstInt, i64ty)
  strideI.ival = stride
  let mul = mkInstr(Op.Mul, i64ty)
  mul.lhs = e.slot
  mul.rhs = builderEmit(fc.b, strideI)
  let add = mkInstr(Op.Add, i64ty)
  add.lhs = e.buf
  add.rhs = builderEmit(fc.b, mul)
  return builderEmit(fc.b, add)
}

// `xs[i]` on a slice, read INLINE instead of through `rt_call slice_get` (#3107).
// The bounds test and the address are `emitInlineSliceElem`'s; this is the load.
fn emitInlineSliceGet(fc: FnCtx, recv: int, idx: int, ty: int): int {
  let e = emitInlineSliceElem(fc, recv, idx)
  let buf = e.buf
  let slot = e.slot
  let i64ty = primType(fc.c.ctx, 3)
  // A slice buffer stores ONE 8-BYTE WORD PER ELEMENT for every element type
  // EXCEPT a packed `[]u8` (ABI.md §2, #3121/#3226), whose buffer is
  // byte-packed instead (`rtSliceGet`'s packed arm: `loadByte(buf + off +
  // index)`).
  //
  // `index_get` scales by `ty`'s own width, so it is the right op exactly when
  // that width matches the buffer's real stride: 8 for every reference type
  // (`widthOf` gives 8 to everything that is not a prim) plus i64/u64/int/f64,
  // and now 1 for `u8` — the only prim ABI.md authorizes packing for
  // ("packing wider non-ref scalars (i16/i32/bool/...) is explicitly future
  // work; this document does not authorize it"). It folds the whole access
  // into one scaled load on both backends.
  //
  // Every OTHER narrow prim — i8/i16/i32/u16/u32/bool/f32 — stays
  // word-per-element (buffer stride 8) while its own width is 1/2/4, so
  // `index_get` would scale it wrong; those compute the byte address and load
  // at offset 0 instead. Reading the low bytes of the stored word is exact for
  // them for the same width-canonical reason the compare above is, and only
  // prims reach that arm, so `field_get`'s fixed-array case (which yields an
  // interior ADDRESS, not a load) is unreachable from here.
  let w = widthOf(fc.c.ctx, ty)
  if (w.bytes == 8 || sliceElemSizeFor(fc, ty) == 1) {
    let ig = mkInstr(Op.IndexGet, ty)
    ig.lhs = buf
    ig.rhs = slot
    return builderEmit(fc.b, ig)
  }
  let three = mkInstr(Op.ConstInt, i64ty)
  three.ival = 3
  let shl = mkInstr(Op.Shl, i64ty)
  shl.lhs = slot
  shl.rhs = builderEmit(fc.b, three)
  let addr = mkInstr(Op.Add, i64ty)
  addr.lhs = buf
  addr.rhs = builderEmit(fc.b, shl)
  let load = mkInstr(Op.FieldGet, ty)
  load.lhs = builderEmit(fc.b, addr)
  load.ival = 0
  return builderEmit(fc.b, load)
}

// Whether `xs[i] = v` may be emitted inline (#3108). Two conditions, and both
// are narrower than the read's, which is why this is a predicate the call sites
// ask rather than a fallthrough inside the emitter.
//
// THE INDEX must be int-classed, for the reason `lowerIndex` gives: the compare
// and the address arithmetic read an INTEGER register, and nothing rejects
// `xs[1.5]` today.
//
// THE ELEMENT must be exactly 8 bytes wide — every reference type, plus
// i64/u64/int/f64 — because `rtSliceSet` writes a WHOLE WORD (`storeWord`) and a
// narrow store does not. This is NOT the asymmetry it looks like. #3107 could
// give narrow prims an inline arm because a narrow LOAD of a whole word is exact:
// the low bytes are the value. A narrow STORE leaves the other seven bytes of
// that word holding whatever was there before, and the word is still read whole
// by `rtSliceGet` — which `readLvalue` (lowerassign.bit) reaches for the read
// half of `xs[i] += v`, typed as the narrow element. That value would arrive
// non-canonical, and `xs[i] /= 2` on a `[]i8` holding -1 would divide 255
// instead: a wrong answer, silent, in a program with no unsafe construct in it.
// So narrow prims keep the runtime call, which is exactly today's behaviour,
// byte for byte. Widening the stored value to a full word first would lift this,
// and is a separate ticket — it needs `Op.Convert` on pairs (bool -> i64) that
// no source program produces today, which is not a thing to smuggle into a
// perf change.
//
// The VALUE's own IR type is checked as well as the declared element type,
// because it is the value's type that both backends read for `index_set` — for
// the store width AND for the index scale (`arm64compile.bit:179` passes
// `cx.f.instrs[ins.ival].ty`). The two agree for every path that reaches here,
// and if one ever stopped agreeing the mismatch would come out as a wrongly
// scaled address rather than as a diagnostic.
fn canInlineSliceStore(fc: FnCtx, ty: int, idx: int, val: int): bool {
  return regClassOf(fc.c.ctx, fc.b.instrs[idx].ty) == RegClass.Int &&
    widthOf(fc.c.ctx, ty).bytes == 8 &&
    widthOf(fc.c.ctx, fc.b.instrs[val].ty).bytes == 8
}

// `xs[i] = v` on a slice, stored INLINE instead of through `rt_call slice_set`
// (#3108) — the mirror of `emitInlineSliceGet`, sharing its bounds test and its
// address. Only ever called when `canInlineSliceStore` holds, so the element is
// 8 bytes and `index_set`'s scale-by-width IS the buffer's word stride: one
// scaled store, writing the same whole word `rtSliceSet`'s `storeWord` writes.
//
// `recv`, `idx` and `val` must ALL be lowered before this runs. Evaluating the
// stored value can allocate or call, and that is a safepoint; keeping it ahead of
// the sequence is what leaves `buf`'s live range safepoint-free.
fn emitInlineSliceSet(fc: FnCtx, recv: int, idx: int, val: int) {
  let e = emitInlineSliceElem(fc, recv, idx)
  let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
  is.lhs = e.buf
  is.rhs = e.slot
  is.ival = val
  builderEmit(fc.b, is)
}

// Lowers an index read `a[i]`: a slice inline (`emitInlineSliceGet`), a map via
// `map_get`, a string via `string_byte`, a fixed array via the `index_get` op.
//
// The fixed-array arm is a TESTED arm, not a fallthrough (#2385). `index_get` is
// raw word addressing — `base + i*width` — so emitting it against a receiver that
// is not an inline array reads whatever bytes are there: for a slice that is the
// `{ptr, len, cap}` header, and `xs[0]` hands back the DATA POINTER with nothing
// said at any stage (#2275, and `first<T>(5)` where the validator is deliberately
// permissive about a type-param receiver). Refusing is the whole point: the
// checker is the layer that owes a diagnostic here, and when it has a gap the
// lowerer must not paper over it with a wrong answer.
fn lowerIndex(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let ty = defaultType(fc.c, nodeType(fc, node))
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  let rd = fc.c.ctx.types[recvTy]
  if (rd.kind == TypeKind.Slice) {
    // A float-classed index reaches neither the inline compare nor the inline
    // address arithmetic, both of which read an INTEGER register. Nothing
    // rejects `xs[1.5]` today — the checker types the read and the validator
    // only asks whether the RECEIVER is indexable — so keep that (already
    // meaningless) program on the runtime call rather than emitting a sequence
    // that reads a register the value was never placed in.
    if (regClassOf(fc.c.ctx, fc.b.instrs[idx].ty) == RegClass.Int) {
      return emitInlineSliceGet(fc, recv, idx, ty)
    }
    // elem_size (ABI.md §9, #3121/#3226): see `lowerlit.bit`'s
    // `lowerSliceAlloc` for the full rationale; `sliceElemSizeFor` lives in
    // `lowercall.bit`.
    let esI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
    esI.ival = sliceElemSizeFor(fc, ty)
    let esV = builderEmit(fc.b, esI)
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "slice_get"
    ins.args = [recv, idx, esV]
    return emitRtCall(fc, ins)
  }
  if (rd.kind == TypeKind.Map) {
    return emitMapGet(
      fc,
      ty,
      recv,
      idx,
      MapGetMiss{ panics: true, span: getNode(fc.c.tree, node).span },
    )
  }
  if (rd.kind == TypeKind.Prim && rd.prim == 11) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "string_byte"
    ins.args = [recv, idx]
    return emitRtCall(fc, ins)
  }
  if (rd.kind != TypeKind.Array) {
    fcFail(
      fc,
      getNode(fc.c.tree, node).span,
      "an indexed read on a value that is not a slice, array, map or string",
    )
    return 0
  }
  let ins = mkInstr(Op.IndexGet, ty)
  ins.lhs = recv
  ins.rhs = idx
  return builderEmit(fc.b, ins)
}

// `log2(n)` when `n` is a power of two in [2, 2^62], otherwise -1. Used by
// `emitScaledOffset` below to recognize an element size a shift can express.
fn log2Exact(n: int): int {
  if (n < 2 || (n & (n - 1)) != 0) {
    return -1
  }
  let k = 1
  while (k < 63) {
    if ((1 << k) == n) {
      return k
    }
    k = k + 1
  }
  return -1
}

// Whether `v` names an instruction the builder has actually emitted. Every
// operand read below goes through this: a lowering that failed leaves operand
// ids that were never emitted, and indexing `b.instrs` with one would fault
// rather than decline the fold.
fn builderHasValue(b: IrBuilder, v: int): bool {
  return v >= 0 && v < len(b.instrs)
}

// Whether value `v` is an ARITHMETIC right shift of an `i64` by the literal
// amount `k`. Structural, on the already-lowered value: `analyzeConsts` has not
// run yet, so the shift count is recognized only when it is literally a
// `const_int`, which is what `e >> 3` in source lowers to.
//
// `AShr` and not `LShr`, even though the cancellation below holds for both
// directions: `binOpFor` (lower.bit) picks `LShr` only for an UNSIGNED result
// type, so an `LShr` whose type is `i64` cannot be lowered from any source at
// all. Accepting one would be a branch no test could reach and no transform
// signature could cover (scripts/selfhost-ir-signatures.sh).
fn isAShrBy(b: IrBuilder, v: int, k: int, i64ty: int): bool {
  if (!builderHasValue(b, v)) {
    return false
  }
  let ins = b.instrs[v]
  if (ins.op != Op.AShr) {
    return false
  }
  if (ins.ty != i64ty) {
    return false
  }
  if (!builderHasValue(b, ins.lhs) || b.instrs[ins.lhs].ty != i64ty) {
    return false
  }
  if (!builderHasValue(b, ins.rhs)) {
    return false
  }
  return b.instrs[ins.rhs].op == Op.ConstInt && b.instrs[ins.rhs].ival == k
}

// The byte offset of `p ± n` (§11.4): `n` scaled by `sizeOf(elem)`.
//
// STRENGTH REDUCTION (#3898) when the scale is a power of two `2^k` and `n` is
// itself `e >> k` by that SAME k. That is the shape of every address-to-pointer
// bridge in the runtime — `nil + (addr / 8)` on a `*i64` and its `/ 4` twins on
// `*i32` — because §11.4 offers no int-to-pointer conversion, so dividing an
// address down to an element index and having the compiler scale it straight
// back up is the ONLY way to name an address. Emitted naively that is a divide
// and a multiply by the same constant: two instructions, or five when the
// division is signed and pays the round-toward-zero correction (`asr #63`,
// `lsr #64-k`, `add` for the bias, then the shift).
//
// `(e >> k) * 2^k` is `e & ~(2^k - 1)`: one `and`, which both backends encode
// as a logical immediate (arm64 `fitsLogicalImm`, x64 `xLogicalConstSkip`).
//
// THE MASK IS NOT DROPPED, and that is the entire correctness argument. The
// rewrite PRESERVES the truncation, so it asserts nothing about `e` being
// aligned and holds for a misaligned or negative `e` exactly as the shift pair
// did: a right shift discards the low `k` bits and the scale cannot bring them
// back, which is what `& ~(2^k - 1)` also does. An arithmetic shift replicates
// the sign bit into the high end and the scale's left shift discards those same
// replicated bits again, so `(-9 >> 3) * 8` is -16 and so is `-9 & ~7` — while
// `(-9 / 8) * 8` is -8, which is why a signed DIVISION is not a candidate here
// and keeps its round-toward-zero bias. Only a proof that `e` is already
// `2^k`-aligned would license dropping the `and` outright, and nothing at this
// level has one.
//
// The shift's own operand is read from the current block, where the shift just
// read it, so no new value crosses a block boundary and dominance is preserved
// by construction. The shift itself is left in place; `deadCodeElim` drops it
// when nothing else used it.
fn emitScaledOffset(fc: FnCtx, off: int, scale: int, i64ty: int): int {
  let k = log2Exact(scale)
  if (k > 0 && isAShrBy(fc.b, off, k, i64ty)) {
    let mk = mkInstr(Op.ConstInt, i64ty)
    mk.ival = ~(scale - 1)
    let an = mkInstr(Op.BAnd, i64ty)
    an.lhs = fc.b.instrs[off].lhs
    an.rhs = builderEmit(fc.b, mk)
    return builderEmit(fc.b, an)
  }
  let sc = mkInstr(Op.ConstInt, i64ty)
  sc.ival = scale
  let ml = mkInstr(Op.Mul, i64ty)
  ml.lhs = off
  ml.rhs = builderEmit(fc.b, sc)
  return builderEmit(fc.b, ml)
}
