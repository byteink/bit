// The constant-divisor decision, shared by both backends (#4361, #4389).
//
// Moved here verbatim from `x64call.bit`, whose `x` prefix these names still
// carry: none of this is x86-64-specific and never was -- `divplancheck.bit`'s
// own header already described `xDivisorPlan` as backend-neutral. It moved
// because `x64call.bit` was 759 lines against the 800-line limit and #4389's
// magic-number shape did not fit in the 41 that were left.
//
// #4729 took the magic shape back out: the Granlund-Montgomery sequence is
// lowered in the IR now (optdivmagic.bit), so no plan carries a multiplier and
// the divide the planner still describes is a real one. The op a divide is no
// longer part of the decision, which is why `xDivisorPlan` lost its `op`
// parameter.
// log2 of a value already known to be a nonzero power of two. Bounded at 64
// iterations (a u64 has at most 64 bits), never more.
fn xLog2Pow2(raw: u64): int {
  let v = raw
  let k = 0
  while (v > u64(1)) {
    v = v >> u64(1)
    k = k + 1
  }
  return k
}

// The log2 of `v`'s divisor value, or -1 unless it is a KNOWN, POSITIVE,
// power-of-two constant at `w`'s width — used to route SDiv/UDiv around a
// real idiv (#1702). Declining a non-power-of-two or non-positive divisor is
// correct, not merely conservative: those need a different (unimplemented)
// reduction and must keep dividing for real.
fn xConstPow2Divisor(f: IrFunc, v: int, w: Width): int {
  if (f.instrs[v].op != Op.ConstInt) {
    return -1
  }
  let raw = f.instrs[v].ival
  let bits = w.bytes * 8
  let magnitude = u64(0)
  if (w.signed) {
    if (raw <= 0) {
      return -1 // only a positive divisor's quotient is a plain shift
    }
    magnitude = u64(raw)
  } else if (bits >= 64) {
    magnitude = u64(raw)
  } else {
    magnitude = u64(raw) & ((u64(1) << u64(bits)) - u64(1))
  }
  if (magnitude == u64(0) || (magnitude & (magnitude - u64(1))) != u64(0)) {
    return -1 // zero, or not a power of two
  }
  let k = xLog2Pow2(magnitude)
  if (k == 0) {
    return -1 // divisor == 1: quotient is the dividend, no shift needed
  }
  return k
}

// What BOTH backends' div/rem emitters will do with a divisor, decided once.
//
// `pow2K` is `xConstPow2Divisor`'s verdict: the log2 of a known positive
// power-of-two divisor, or -1. `guard` is whether the runtime zero-check and
// its `bit_rt_panic_div_zero` call (#2016, SPEC §13.5) must be emitted.
//
// The two are SEPARATE questions and were previously conflated into the single
// `pow2K` integer threaded through the emitters. A power of two is provably
// non-zero, so it needs no guard — but so is any other non-zero literal, which
// still needs a real divide. One class answers both without a caller having to
// re-derive either.
class DivPlan {
  pow2K: int,
  guard: bool,
}

// The three states, named. A caller that spells the fields out inline can
// write the fourth, nonsensical one (`pow2K >= 0` WITH a guard), which would
// emit a zero-check in front of a shift sequence that never reads the
// divisor register.
fn runtimeDivPlan(): DivPlan {
  return DivPlan{ pow2K: -1, guard: true }
}

fn litDivPlan(): DivPlan {
  return DivPlan{ pow2K: -1, guard: false }
}

fn pow2DivPlan(k: int): DivPlan {
  return DivPlan{ pow2K: k, guard: false }
}

// Whether the emitters still FETCH the divisor into a register -- the one
// question each backend's skip-the-constant-materialization scan asks, and the
// only place the answer is written down.
//
// The reduced shape answers no: a power of two shifts or masks the dividend and
// never looks at the divisor. `litDivPlan()` answers YES -- it still emits a
// real divide, it merely proved the zero-check dead -- and that distinction was
// worth a bug on its own before #4361 separated it.
//
// This must stay true of BOTH backends at once, which is why it is a function
// and not a test either emitter restates: a plan the arm64 emitter reduces and
// the x86-64 emitter does not would leave x86-64 reading an operand nothing
// materialized. `divplancheck.bit` pins it against both emitters' byte output.
fn divPlanReadsDivisor(p: DivPlan): bool {
  return p.pow2K < 0
}

// The single source of truth for that verdict (#4361). Four places must agree
// on it — the two backends' emitters, arm64's `hasDivZeroGuard` frameless
// predicate, and each backend's skip-the-constant-materialization scan — and
// before this they each restated the rule in their own words, with
// `hasDivZeroGuard`'s comment ASSERTING it "can never disagree with what the
// emitter actually does". An assertion is not a proof; asking the same
// function is.
//
// A `const_int` divisor is materialized by `movImm64`/`xEmitConstInt` as its
// RAW 64-bit `ival`, with no truncation to the IR's declared width, and that
// whole 64-bit register is what `cmpZero`/`xTestRR` then compares. So a
// non-zero raw `ival` proves the zero-branch is never taken at EVERY width —
// including a narrow type whose value masks to zero, where the emitted divide
// would equally use the untruncated register. A zero `ival` keeps the guard
// and therefore still panics; it is never folded into a silent 0.
fn xDivisorPlan(f: IrFunc, rhs: int, w: Width): DivPlan {
  let k = xConstPow2Divisor(f, rhs, w)
  if (k >= 0) {
    return pow2DivPlan(k)
  }
  if (f.instrs[rhs].op != Op.ConstInt || f.instrs[rhs].ival == 0) {
    return runtimeDivPlan()
  }
  return litDivPlan()
}
