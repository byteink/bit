// compiler/lowerimplicitsome.bit — the object a variant construction builds,
// split out of `lowerVariantConstruction` (lowerlayout.bit, which sits at the
// 800-line E0200 ceiling) so the implicit `Some` (#6597) can build the SAME
// object from a value it has already lowered, with no call node to read.

// Allocates and fills the boxed enum object `{ tag: i64 @0, payload_0 @8,
// payload_1 @16, ... }` for variant ordinal `tag` of `enumTy`. `vals` are the
// payload values, already lowered; `slotTys[i]` is the type payload `i` is
// stored at (its register class, width and whether the GC traces it), so the
// two slices are the same length. Every payload is lowered BEFORE this runs
// (`variantPayloadValues`, lowercall.bit explains why the order is load-bearing).
fn emitVariantObject(fc: FnCtx, enumTy: int, tag: int, vals: []int, slotTys: []int): int {
  let offs = []int(0)
  let i = 0
  while (i < len(vals)) {
    if (enumPayloadSlotIsPtr(fc.c.ctx, slotTys[i])) {
      offs = append(offs, enumPayloadBase + 8 * i)
    }
    i = i + 1
  }
  let ga = mkInstr(Op.GcAlloc, enumTy)
  ga.ival = enumPayloadBase + 8 * len(vals)
  ga.offsets = offs
  let obj = builderEmit(fc.b, ga)
  let tc = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  tc.ival = tag
  let fs0 = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs0.lhs = obj
  fs0.ival = 0
  fs0.rhs = builderEmit(fc.b, tc)
  fs0.ival2 = primType(fc.c.ctx, 3)
  builderEmit(fc.b, fs0)
  let j = 0
  while (j < len(vals)) {
    let avTy = slotTys[j]
    // #5420: `decimal` (16 bytes, `primWidth`, codegen.bit) never fits one
    // payload word, so `lowerExprH` above already returned the boxed
    // two-i64-tuple POINTER `explodeValueWords`/`buildTuple` produce for a
    // decimal-typed hint (one 8-byte handle, like every other non-prim
    // shape) — never the 16-byte value `avTy` still names. Storing it with
    // `fs.ival2 = avTy` asked `emitFieldSet` to encode a 16-byte store,
    // which used to silently pick `size=3` (right for the 8-byte pointer by
    // coincidence, not by design) and is now refused outright by
    // `gpSizeOpc`'s width guard (#5420). Retyping the store as the tuple
    // `av` actually is — exactly `bindArmPayload`'s (lowerbranch.bit, #5417)
    // fix on the READ side — makes the declared type match the boxed value
    // on the WRITE side too.
    let fty = avTy
    if (isDecimalPrim(fc.c.ctx, avTy)) {
      fty = decimalTupleType(fc.c.ctx)
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = enumPayloadBase + 8 * j
    fs.rhs = vals[j]
    fs.ival2 = fty
    builderEmit(fc.b, fs)
    j = j + 1
  }
  return obj
}

// SPEC §14.2 implicit `Some` (#6566, #6597): the checker accepted `node`, a bare
// `T`, where an `Option<T>` was expected and marked it (`implicitSome`,
// check.bit). `hint` is that expected type, the declared one at the use site:
// the parameter, the field, the `return`'s `fc.resultTy`, the binding's
// annotation — each already substituted for this instantiation, so a generic
// `Option<T>` is the concrete one. The value is lowered exactly once, at the
// PAYLOAD type, then stored as `Option.Some(v)`; an expected type that is not an
// `Option` is a refused build, never a bare `T` handed on as an option.
fn lowerImplicitSome(fc: FnCtx, node: int, hint: int): int {
  let want = substType(fc.c, hint, fc.genEnv, 0)
  let slots = []int(0)
  if (vIsOptionType(fc.c, want)) {
    slots = variantPayloadTypes(fc.c, want, "Some")
  }
  if (len(slots) != 1) {
    fcFail(
      fc, getNode(fc.c.tree, node).span,
      "a value converted to `Option<T>` whose expected type is not an `Option<T>`",
    )
    return 0
  }
  let argTy = defaultType(fc.c, nodeType(fc, node))
  let slot = variantPayloadSlotTy(fc, slots, 0, argTy)
  let v = lowerExprHPlain(fc, node, slot)
  if (fc.failed) {
    return 0
  }
  v = coerceToIface(fc, v, argTy, slot)
  return emitVariantObject(fc, want, variantOrdinal(fc.c, want, "Some"), [v], [slot])
}
