// compiler/checkmodule.bit — split out of check.bit (#1809). Sibling of
// check.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

function checkModule(c: Checker) {
  // Snapshot BEFORE any check-stage diagnostic: anything already recorded came
  // from parsing or resolution (see `Checker.resolveFailed`).
  c.resolveFailed = c.diags.errorCount > 0
  // The predeclared `error` interface's method `message(): string` (§10.6), so
  // `e.message()` on a caught error resolves like any interface method.
  c.ctx.methodResults["${c.ctx.errorId}.message"] = primType(c.ctx, 11)
  // Pre-scan: record every named type's decl node so a forward reference during
  // the collect pass can reserve+resolve it on first touch (§9: order-independent
  // top-level declarations).
  let t = 1
  while (t < len(c.tree.nodes)) {
    let dt = getNode(c.tree, t).tag
    if (dt == Tag.StructDecl || dt == Tag.EnumDecl || dt == Tag.InterfaceDecl || dt == Tag.TypeAlias) {
      c.typeDecls[declName(c, t)] = t
    }
    t = t + 1
  }
  // Collect pass: assign type ids in the seed's source touch order. A top-level
  // decl node's arena index falls between its own children and the next decl's,
  // so ascending iteration visits decls in source order. A type decl reserves its
  // id then resolves members inline (declTypeOf); a func decl interns its
  // signature (collectFuncDecl). Composites dedup; forward-named refs reserve on
  // first touch — reproducing the seed's declTypeOf/collectFuncDecl id order so
  // method-name mangling `name$t{recvId}` lines up.
  let m = 1
  while (m < len(c.tree.nodes)) {
    let mt = getNode(c.tree, m).tag
    if (mt == Tag.StructDecl || mt == Tag.EnumDecl || mt == Tag.InterfaceDecl || mt == Tag.TypeAlias) {
      declTypeOf(c, declName(c, m))
    } else if (mt == Tag.FuncDecl) {
      collectFuncDecl(c, m)
    } else if (mt == Tag.ExternFnDecl) {
      collectExternFnDecl(c, m)
    }
    m = m + 1
  }
  // #1540: mint every nominal instantiation while ids are still being assigned
  // in source touch order, BEFORE the sig wrappers below. The seed reaches a
  // `Name<...>` inside a function BODY during checking and interns it there, and
  // it has nothing competing for ids because it stores a FuncShape rather than a
  // func TypeId for each signature. bit does mint those wrappers, so deferring
  // the instantiations until bodies are checked pushed every one of them past
  // the whole signature block — a drift of exactly one id per function. An
  // ascending arena walk is source order, and `instantiateNamed` is idempotent,
  // so the annotations the collect loop already resolved are simply found.
  let gi = 1
  while (gi < len(c.tree.nodes)) {
    if (getNode(c.tree, gi).tag == Tag.GenericInst) {
      typeFromNode(c, gi)
    }
    gi = gi + 1
  }
  // After every named/composite id is fixed, build the func-type sig wrappers
  // (their ids land past all named types, so they never perturb touch order).
  buildSignatures(c)
  // Record method `export` visibility before instantiations copy their method
  // sets, so `copyInstMethod` carries the flag onto each instance (#1528).
  collectMethodExports(c)
  // #1540: a generic type's methods are declared after the struct, and an
  // instantiation minted while collecting a field or an annotation can predate
  // them — its method set was empty when it was filled. Re-copy now that every
  // result and signature is known (the seed's copyMethodsToInstantiations).
  let bi = 1
  while (bi < len(c.tree.nodes)) {
    let bt = getNode(c.tree, bi).tag
    if (bt == Tag.StructDecl || bt == Tag.EnumDecl || bt == Tag.InterfaceDecl) {
      copyMethodsToInsts(c, declName(c, bi))
    }
    bi = bi + 1
  }
  // #2306: the loop above only reaches generics THIS module declares. An
  // instantiation of an IMPORTED generic is keyed on the module that declared it
  // and minted here, so that module's own copy pass — already run — never saw
  // it, and every method on an imported generic struct was invisible.
  copyImportedMethodsToInsts(c)
  // Pre-pass 3: type params and for-of loop binders into env before the main
  // sweep. A loop header sits *after* its body in arena order, so typing binders
  // in the main sweep would be too late; params precede their loops, so this
  // ascending sweep resolves a param-typed iterable before its loop.
  //
  // FOR-OF IS DEFERRED to pre-pass 3b below, and must stay deferred (#1829). A
  // MatchStmt node also sits after its arm bodies, so this ascending sweep reaches
  // a `for x of payload` header INSIDE an arm before the MatchStmt that binds
  // `payload`. `typeForOfBinder` then resolved its iterable to nothing,
  // `elementType` turned that into 0, and the loop binder was left UNTYPED: every
  // field access on it failed with E0057 where the checker had to infer, and was
  // silently accepted where an expected type let it skip validating.
  // `compiler/pmcli.bit`'s `for e of entries { … e.value }` is exactly that shape,
  // which is why the self-hosted compiler could not check its own source at all.
  let p3 = 1
  while (p3 < len(c.tree.nodes)) {
    let pn = getNode(c.tree, p3)
    if (pn.tag == Tag.GenericParams) {
      bindGenericScope(c, p3)
    } else if (pn.tag == Tag.Param || pn.tag == Tag.ParamRest || pn.tag == Tag.Receiver) {
      // A param `(x: T)` or a method receiver `(s: S)`: bind its name to its
      // declared type so the body resolves it.
      let pk = kidsOf(c.tree, p3)
      let nm = getNode(c.tree, pk[0])
      let pname = c.source[nm.span.start:nm.span.end]
      let ptype = paramBindType(c, pn.tag, pk[1])
      c.env[pname] = ptype
      c.declTypes[pk[0]] = ptype
      // Record the declared type NODE too. A generic scrutinee recovers its type
      // ARGUMENTS from this node — `match (xs)` with `xs: List<i64>` needs the
      // `<i64>` to bind `Cons(h, t)`'s payload at i64 rather than leaving it the
      // bare `T`. Lowering records the same thing for its own pass (lowerFunc),
      // which is why codegen was right while the checker read `h: T`.
      c.declTypeNodes[pname] = pk[1]
    } else if (pn.tag == Tag.Binding) {
      // Seed the decl-path so a binder below resolves its iterable/scrutinee by
      // the binding it refers to, not by the flat env (#1375). Ascending order
      // guarantees a `let xs = …` node precedes the `for x of xs` header.
      seedBindingDeclType(c, p3)
    } else if (pn.tag == Tag.MatchStmt) {
      typeMatchBinders(c, p3)
    } else if (pn.tag == Tag.CatchBind) {
      // `catch e { … }` binds the caught error as the `error` interface.
      envBind(c, kidsOf(c.tree, p3)[1], c.ctx.errorId)
    }
    p3 = p3 + 1
  }
  // Pre-pass 3a: for-of loop binders, AFTER every param, `let` and match-arm
  // payload above is bound (#1829). Everything a for-of header can iterate is in
  // env by now, so `typeForOfBinder` never has to guess — which is what left the
  // binder untyped when this ran inline in the ascending sweep.
  let pf = 1
  while (pf < len(c.tree.nodes)) {
    if (getNode(c.tree, pf).tag == Tag.ForOf) {
      typeForOfBinder(c, pf)
    }
    pf = pf + 1
  }
  // Pre-pass 3b: the expected function type of every arrow literal written
  // against one (#1487) — see `Checker.arrowExpected`. AFTER pre-pass 3, whose
  // env is what `seedArrowExpectedCall` consults to see a local shadowing a
  // free function, and BEFORE every pass that types an expression.
  let ae = 1
  while (ae < len(c.tree.nodes)) {
    let at = getNode(c.tree, ae).tag
    if (at == Tag.Binding) {
      seedArrowExpectedBinding(c, ae)
    } else if (at == Tag.Call) {
      seedArrowExpectedCall(c, ae)
    }
    ae = ae + 1
  }
  // Pre-pass 3c: project each expectation seeded above onto the arrow's own
  // UNANNOTATED parameters (#2275/#2277). Separate from 3b because it reads
  // `arrowExpected` for the whole module, and 3b fills that table as it goes;
  // and before the main pass because the ArrowP handler there is what binds the
  // name the body reads.
  let ap = 1
  while (ap < len(c.tree.nodes)) {
    if (getNode(c.tree, ap).tag == Tag.ArrowFn) {
      seedArrowParamTypes(c, ap)
    }
    ap = ap + 1
  }
  // Pre-pass 4: E0052/E0072 for the type annotations inside a TYPE declaration —
  // struct fields, enum payloads, type aliases, interface method signatures.
  //
  // #1535: `vTypeNodes` had exactly one non-recursive call site, vFuncDecl, so a
  // type node reached by neither the statement walk (function bodies, since
  // #1521) nor the signature sweep was never judged at all. `struct T { m:
  // map<[]int, int> }` was accepted in silence — the same silent-ACCEPTANCE
  // shape as #1522 (the arrow subtree was skipped) and #1529 (calls through a
  // function value never checked their arguments).
  //
  // BEFORE the module bindings below, which is not source order and was measured
  // against the seed rather than assumed (#1489's lesson): the seed resolves
  // every type declaration ahead of every binding, so a struct declared after a
  // `const` still reports first. Arena order gives the rest for free — a decl
  // node follows its own children and precedes the next decl's, so ascending
  // iteration visits declarations in source order, and vTypeNodes is post-order
  // within each (SPEC.md §14.8).
  //
  // A type declaration holds only type nodes — Bit's methods are separate
  // FuncDecls with receivers — so sweeping the whole subtree cannot double-report
  // against the body walk.
  //
  // Function SIGNATURES are swept here too (#1550). The seed has ONE declaration
  // phase covering type declarations and signatures together, so a bad signature
  // is reported among the struct fields and ahead of every module binding.
  // Sweeping it from vFuncDecl instead put it in the main arena pass, i.e. after
  // BOTH pre-passes, so a file pairing a bad signature with a bad module const
  // emitted the identical SET in a different ORDER — and SPEC.md §14.8 makes
  // order normative. Measured against the seed, not assumed.
  //
  // Kid 5 is the BODY, deliberately excluded: the statement walk reaches a body's
  // type nodes where it meets them, so they interleave with that statement's
  // other diagnostics the way the seed's `checkType` does (#1521). Sweeping it
  // here as well would both hoist and double-report.
  let td = 1
  while (td < len(c.tree.nodes)) {
    let tdt = getNode(c.tree, td).tag
    if (tdt == Tag.StructDecl || tdt == Tag.EnumDecl || tdt == Tag.TypeAlias ||
        tdt == Tag.InterfaceDecl) {
      vTypeNodes(c, td, 0)
    }
    if (tdt == Tag.FuncDecl) {
      let sigKids = kidsOf(c.tree, td)
      let si = 0
      while (si < len(sigKids)) {
        if (si != 5) { vTypeNodes(c, sigKids[si], 0) }
        si = si + 1
      }
    }
    td = td + 1
  }
  // Pre-pass 5: annotated module-level `let`/`const` initializers against their
  // annotations. The statement sweep (vStmt) only walks function bodies, so
  // nothing else reaches these — `const c: f32 = "s"` was accepted by the
  // self-hosted compiler and rejected by the seed (#1470's hole, one scope up).
  //
  // A SEPARATE pass, before the main one, purely for DIAGNOSTIC ORDER: the seed
  // checks module-level declarations ahead of function bodies, so a bad `const`
  // declared after `main` is reported before `main`'s errors. Folded into the
  // main arena-order pass instead, it reported last and the two compilers'
  // diagnostic streams diverged in order while agreeing on content.
  let mb = 1
  while (mb < len(c.tree.nodes)) {
    if (getNode(c.tree, mb).tag == Tag.Binding && isTopLevelBinding(c, mb)) {
      // The binding's own type nodes, ahead of its assignability verdict: the
      // seed's checkBinding runs checkType on the annotation and checkExpr on the
      // initializer before `expect`. Sweeping the whole Binding walks [pattern,
      // annotation, initializer] in that order, and must run OUTSIDE vBinding,
      // which returns early for an unannotated or destructuring binding whose
      // initializer still carries type nodes of its own (#1535).
      vTypeNodes(c, mb, 0)
      vBinding(c, mb)
      // E0064 AFTER the assignability verdict: the seed folds the initializer at
      // the tail of checkBinding, once the binding is typed and bound (#1534).
      if (isTopLevelConstBinding(c, mb)) {
        vTopLevelConst(c, mb)
      }
    }
    mb = mb + 1
  }

  // Main pass, in arena (source) order so a param/binding is recorded before the
  // expressions that reference it.
  let i = 1
  while (i < len(c.tree.nodes)) {
    let tag = getNode(c.tree, i).tag
    // Re-apply a DECL's own type into the flat env at its own name node. Pre-pass
    // 3 types params, receivers, and for-of / match / catch binders; every
    // same-named decl bound since has overwritten the module-wide env, and a name
    // node precedes the body that reads it, so this is where the decl's own type
    // goes back in scope. Without it a receiver reads a later param's type and a
    // valid `recv.field` false-misses (#1370/#1373), and a loop binder reads
    // another function's local (#1375).
    //
    // One rebind covers all of them because `declTypes` is now the single
    // per-node decl table (#1502). Ident-only: a tuple pattern's slot is keyed by
    // the pattern node, whose source text is not a name.
    if (tag == Tag.Ident && c.declTypes[i] != 0) {
      let bn = getNode(c.tree, i)
      c.env[c.source[bn.span.start:bn.span.end]] = c.declTypes[i]
    }
    // Same reason as the env rebind above, one table over: put this decl's own
    // `<T>` back in scope before anything it encloses is typed (#1551).
    if (tag == Tag.GenericParams) {
      bindGenericScope(c, i)
    }
    if (tag == Tag.ArrowP) {
      // An annotated closure parameter: type it (and bind it so the body can
      // reference it). Children precede parents in arena order, so this runs
      // before the arrow body and enclosing binding are typed. An arrow
      // speculation that failed (a plain `(expr)`) leaves an orphan untyped
      // ArrowP in the arena; guard the env write so it cannot clobber a real
      // binding of the same name — its dump entry still renders `<error>`,
      // matching the seed.
      let kids = kidsOf(c.tree, i)
      let nm = getNode(c.tree, kids[0])
      // Annotated, or — since #2275 — typed by the expectation pre-pass 3c
      // projected onto it. An unannotated parameter left at 0 is what let
      // `xs => xs[0]` index the slice HEADER instead of its elements.
      let pt = arrowParamType(c, i)
      c.nodeTypes[kids[0]] = pt
      if (pt != 0) {
        c.env[c.source[nm.span.start:nm.span.end]] = pt
        c.declTypes[kids[0]] = pt
      }
    } else if (tag == Tag.Binding) {
      checkBinding(c, i)
      // §11.11: a module-level `let` is mutable state with a static address,
      // not an SSA value. Validate it HERE (the checker), so an invalid form is
      // a real diagnostic rather than a late `cannot lower` refusal. The
      // resolver's `moduleScoped` is what separates it from a local `let` —
      // both are LetBinding.
      if (isModuleStateBinding(c, i)) {
        vModuleState(c, i)
      }
    } else if (tag == Tag.Call) {
      c.nodeTypes[i] = checkCall(c, i)
      // Record a generic-function call's instantiation in source order (its
      // monomorphized index), once, during the check pass.
      let cnode = kidsOf(c.tree, i)[0]
      let callee = getNode(c.tree, cnode)
      if (callee.tag == Tag.Ident) {
        let cname = c.source[callee.span.start:callee.span.end]
        // Node-keyed, exactly as `resolveCallTarget` is: the ledger records the
        // instantiation lowering will later look up, so if the two disagreed
        // about which `f` a call names, lowering would emit a reference to an
        // instance nothing recorded.
        let fr = funcRefAt(c, cnode, cname)
        if (funcRefIsGeneric(fr)) {
          recordInstantiation(c, fr, genericTypeArgs(c, cname, i))
        }
      }
    } else if (tag == Tag.FuncDecl) {
      // Validate this function's body (validate.bit) — everything above only
      // INFERS types. Here and nowhere else: children precede parents in arena
      // order, so at the FuncDecl node the body is fully swept and the flat
      // `env` holds exactly this function's params and locals, with no later
      // function's yet. See validate.bit's header.
      vFuncDecl(c, i)
    } else if (tag == Tag.ExternFnDecl) {
      // §11.7 E0077: the C-ABI restriction on an extern signature. A leaf decl
      // with no body, so unlike a FuncDecl it needs no sweep ordering.
      vExternFnDecl(c, i)
    }
    i = i + 1
  }
}

// One `--dump-types` line's data: the name's start offset, its source text, type.
struct TypeEntry {
  start: int,
  text: string,
  ty: int,
}

// Appends a dump entry per name bound by `pat` (recursing tuple_pat), reading
// the already-typed pattern node (the seed's collectBindingIdents).
function collectBindingIdents(c: Checker, pat: int, entries: []TypeEntry): []TypeEntry {
  let n = getNode(c.tree, pat)
  if (n.tag == Tag.TuplePat) {
    let subs = kidsOf(c.tree, pat)
    let i = 0
    while (i < len(subs)) {
      entries = collectBindingIdents(c, subs[i], entries)
      i = i + 1
    }
    return entries
  }
  return append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[pat] })
}

// Insertion-sort dump entries by source offset (the seed sorts (file, start);
// one file here, so start alone). Bounded by the entry count.
function sortEntries(entries: []TypeEntry): []TypeEntry {
  let i = 1
  while (i < len(entries)) {
    let cur = entries[i]
    let j = i - 1
    while (j >= 0 && entries[j].start > cur.start) {
      entries[j + 1] = entries[j]
      j = j - 1
    }
    entries[j + 1] = cur
    i = i + 1
  }
  return entries
}

// Renders `--dump-types`: one `line:col: text: typename` line per binding name,
// arrow parameter, and call expression, sorted by source position — matching the
// seed's dumpTypesText.
function dumpTypesText(c: Checker): string {
  let entries = []TypeEntry(0)
  let i = 1
  while (i < len(c.tree.nodes)) {
    let n = getNode(c.tree, i)
    if (n.tag == Tag.Binding) {
      entries = collectBindingIdents(c, kidsOf(c.tree, i)[0], entries)
    } else if (n.tag == Tag.ArrowP) {
      let name = kidsOf(c.tree, i)[0]
      let nn = getNode(c.tree, name)
      entries = append(entries, TypeEntry{ start: nn.span.start, text: c.source[nn.span.start:nn.span.end], ty: c.nodeTypes[name] })
    } else if (n.tag == Tag.Call) {
      entries = append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[i] })
    }
    i = i + 1
  }
  entries = sortEntries(entries)
  let out = ""
  let k = 0
  while (k < len(entries)) {
    let e = entries[k]
    let lc = locateOffset(c.source, e.start)
    out = out + "${lc.line + 1}:${lc.col + 1}: " + e.text + ": " + typeName(c.ctx, e.ty) + "\n"
    k = k + 1
  }
  return out
}

// Parses `src`, type-checks it, and returns the `--dump-types` text.
function checkSourceDump(src: string): string {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return dumpTypesText(c)
}
