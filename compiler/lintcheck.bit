// In-Bit self-checks for `bit lint` (#1379/#1380). Run by `selfcheck()` under
// `./make test` and the x86_64 gate; a failed `assert` panics with exit 2.
//
// These cover the directive reader and the rule/render layer, which is
// everything that does not need a process. The CLI contract on top — path walk,
// exit codes, the summary line, `--json`, `--stats` — is execed and asserted
// by `_tests_/bit/lintcmd/lintcmd.bit`, because an exit code cannot be observed from
// inside the process that would produce it.
//
// Split (#2471): this file was 1016 lines against its own §4 `max-file-lines`
// default of 800. Keeps the directive-reader tests (accepted forms, placement,
// error classes) and the max-file-lines/max-fn-lines/max-params/max-nesting
// rule checks. compiler/lintcheckrules.bit keeps every remaining rule check
// (max-complexity onward), rendering, ordering, CLI-arg parsing, and the
// `checkLint()` entry point that calls into both files.

// Reads directives from `src` into a throwaway sink; returns the config. `errs`
// is the caller's sink so a test can assert on what was reported.
fn lintTestRead(src: string, errs: Diagnostics): LintConfig {
  let f = addFile(errs.sm, "t.bit", src)
  return readLintDirectives(src, f, errs)
}

fn lintTestSink(): Diagnostics {
  return newDiagnostics(newSourceManager())
}

// The effective limit for `max-file-lines` under `cfg`.
fn lintTestFileLimit(cfg: LintConfig): int {
  return cfg.limits[lintRuleIndex(lintRules(), "max-file-lines")]
}

fn lintTestFileDisabled(cfg: LintConfig): bool {
  return cfg.disabled[lintRuleIndex(lintRules(), "max-file-lines")]
}

fn checkLintDirectivesAccepted() {
  // No directive: the built-in default, and nothing overridden.
  let d0 = lintTestSink()
  let c0 = lintTestRead("// just a comment\nfn f() {}\n", d0)
  assert(!hasErrors(d0))
  assert(lintTestFileLimit(c0) == 800)
  assert(lintOverrideCount(c0) == 0)
  assert(len(lintOverrideNotes(c0)) == 0)

  // A directive that restates the default is still an override in force: it
  // changes no behaviour but it is a claim about this file, so it must show up
  // in the count and the listing rather than vanishing.
  let dd = lintTestSink()
  let cd = lintTestRead("// bit:lint max-file-lines=800 -- deliberate, not drift\n", dd)
  assert(!hasErrors(dd))
  assert(lintOverrideCount(cd) == 1)
  assert(lintOverrideNotes(cd)[0] == "max-file-lines=800")

  // An assignment.
  let d1 = lintTestSink()
  let c1 = lintTestRead("// bit:lint max-file-lines=1204 -- known debt\nfn f() {}\n", d1)
  assert(!hasErrors(d1))
  assert(lintTestFileLimit(c1) == 1204)
  assert(lintOverrideCount(c1) == 1)
  assert(lintOverrideNotes(c1)[0] == "max-file-lines=1204")

  // A disable.
  let d2 = lintTestSink()
  let c2 = lintTestRead("// bit:lint disable max-file-lines -- generated\n", d2)
  assert(!hasErrors(d2))
  assert(lintTestFileDisabled(c2))
  assert(lintOverrideCount(c2) == 1)
  assert(lintOverrideNotes(c2)[0] == "disable max-file-lines")

  // Multiple directives: the LAST assignment for a rule wins, and both count as
  // one override, because the summary line reports settings in effect.
  let d3 = lintTestSink()
  let c3 = lintTestRead(
    "// bit:lint max-file-lines=100 -- first\n" + "// bit:lint max-file-lines=900 -- second\n",
    d3,
  )
  assert(!hasErrors(d3))
  assert(lintTestFileLimit(c3) == 900)
  assert(lintOverrideCount(c3) == 1)

  // Not pinned to line 1 — a golden case spends line 1 on the harness mode
  // directive, and the lint directive still has to be read.
  let d4 = lintTestSink()
  let c4 = lintTestRead("// lint\n// bit:lint max-file-lines=42 -- after the mode line\n", d4)
  assert(!hasErrors(d4))
  assert(lintTestFileLimit(c4) == 42)

  // Indented, and with no space between `//` and the directive.
  let d5 = lintTestSink()
  let c5 = lintTestRead("  //bit:lint max-file-lines=7 -- tight\n", d5)
  assert(!hasErrors(d5))
  assert(lintTestFileLimit(c5) == 7)

  // A reason may itself contain `--`; only the FIRST `--` after the assignment
  // terminates it.
  let d6 = lintTestSink()
  let c6 = lintTestRead("// bit:lint max-file-lines=9 -- see -- issue #1376\n", d6)
  assert(!hasErrors(d6))
  assert(lintTestFileLimit(c6) == 9)

  // `bit:` is a namespace claim for the whole toolchain. Another tool's
  // directive is skipped, not rejected.
  let d7 = lintTestSink()
  let c7 = lintTestRead(
    "// bit:fmt something entirely else\n" + "// bit:lint max-file-lines=11 -- ours\n",
    d7,
  )
  assert(!hasErrors(d7))
  assert(lintTestFileLimit(c7) == 11)
}

// #2158: a well-formed `bit:lint` directive outside the leading comment block
// is a hard error (E0299), never a silent no-op — every way the leading block
// can end (a blank line, a declaration, whitespace-only) must diagnose it.
fn checkLintDirectivePlacement() {
  // A blank line ends the leading comment block; the directive after it is
  // never applied AND is now reported, pointing at the `bit:lint` line.
  let d0 = lintTestSink()
  let c0 = lintTestRead("// header\n\n// bit:lint max-file-lines=42 -- too late\n", d0)
  assert(hasErrors(d0))
  assert(d0.list[0].code == ecLintBadDirective)
  assert(contains(d0.list[0].message, "leading comment block"))
  assert(lintTestFileLimit(c0) == 800)
  assert(lintOverrideCount(c0) == 0)

  // A declaration ends it too — this used to be silently ignored (neither
  // honoured nor diagnosed); it must now be diagnosed exactly like the
  // blank-line case.
  let d1 = lintTestSink()
  let c1 = lintTestRead("fn f() {}\n// bit:lint max-file-lines=42 -- too late\n", d1)
  assert(hasErrors(d1))
  assert(d1.list[0].code == ecLintBadDirective)
  assert(lintTestFileLimit(c1) == 800)

  // A whitespace-only line counts as blank and ends the block the same way.
  let d2 = lintTestSink()
  let c2 = lintTestRead("// header\n   \n// bit:lint max-file-lines=42 -- too late\n", d2)
  assert(hasErrors(d2))
  assert(d2.list[0].code == ecLintBadDirective)
  assert(lintTestFileLimit(c2) == 800)

  // `bit:` lines for another tool are still SKIPPED wherever they sit — this
  // is specifically about `bit:lint`, not a general trailing-comment check.
  let d3 = lintTestSink()
  let c3 = lintTestRead("fn f() {}\n// bit:fmt something else entirely\n", d3)
  assert(!hasErrors(d3))
  assert(lintTestFileLimit(c3) == 800)
}

// The four error classes of §5.2. Every one is a hard error, never a silent
// no-op: a directive that quietly does nothing is how a lint rule dies.
fn checkLintDirectiveErrors() {
  // 1. Malformed — no `=` and not the `disable` form.
  let d0 = lintTestSink()
  let _ = lintTestRead("// bit:lint max-file-lines 900 -- nope\n", d0)
  assert(hasErrors(d0))
  assert(d0.list[0].code == ecLintBadDirective)

  // 1b. Malformed — nothing at all after the tool name.
  let d1 = lintTestSink()
  let _ = lintTestRead("// bit:lint\n", d1)
  assert(hasErrors(d1))
  assert(d1.list[0].code == ecLintBadDirective)

  // 1c. Malformed — `=` with no integer.
  let d2 = lintTestSink()
  let _ = lintTestRead("// bit:lint max-file-lines= -- nope\n", d2)
  assert(hasErrors(d2))
  assert(d2.list[0].code == ecLintBadDirective)

  // 1d. Malformed — `disable` with no rule name.
  let d3 = lintTestSink()
  let _ = lintTestRead("// bit:lint disable -- nope\n", d3)
  assert(hasErrors(d3))
  assert(d3.list[0].code == ecLintBadDirective)

  // 2. Missing reason — no `--` at all.
  let d4 = lintTestSink()
  let _ = lintTestRead("// bit:lint max-file-lines=900\n", d4)
  assert(hasErrors(d4))
  assert(d4.list[0].code == ecLintBadDirective)

  // 3. Empty reason — whitespace only after `--`.
  let d5 = lintTestSink()
  let _ = lintTestRead("// bit:lint max-file-lines=900 --   \n", d5)
  assert(hasErrors(d5))
  assert(d5.list[0].code == ecLintBadDirective)

  // 4. Unknown rule name. Its own code, because this is the error that keeps a
  // renamed rule from turning every existing override into a no-op.
  let d6 = lintTestSink()
  let _ = lintTestRead("// bit:lint max-fyle-lines=900 -- typo\n", d6)
  assert(hasErrors(d6))
  assert(d6.list[0].code == ecLintUnknownRule)

  // 4b. Unknown rule in the `disable` form takes the same code.
  let d7 = lintTestSink()
  let _ = lintTestRead("// bit:lint disable no-such-rule -- typo\n", d7)
  assert(hasErrors(d7))
  assert(d7.list[0].code == ecLintUnknownRule)

  // A limit past the range guard is rejected rather than wrapped into a small
  // number that would silently TIGHTEN the rule.
  let d8 = lintTestSink()
  let _ = lintTestRead("// bit:lint max-file-lines=99999999999999999999 -- huge\n", d8)
  assert(hasErrors(d8))
  assert(d8.list[0].code == ecLintBadDirective)

  // Every directive error is error severity, so `hasErrors` marks the file and
  // the command exits 2.
  assert(d0.list[0].severity == 0)
}

// The per-finding `allow` reader (spec/LINT.md §5.5, #2438), tested at the
// parser and post-pass level — compiler/lintallow.bit's own layer, mirroring
// how checkLintDirectivesAccepted/checkLintDirectiveErrors above test
// readLintDirectives directly rather than only through _tests_/bit/lintcmd/lintcmd.bit.
fn checkLintAllow() {
  let rules = lintRules()

  // A well-formed, adequately-reasoned directive.
  let s0 = "E0214 -- buf is owned by this function entirely"
  let (ok, okPresent) = lintParseAllow(s0, 0, len(s0), 0, 0, 1, rules)
  assert(okPresent)
  assert(ok.ok)
  assert(ok.code == ecLintAppendAliasing)

  // Reason under the 10-character floor: defective, not a hard error.
  let s1 = "E0214 -- x"
  let (short, shortPresent) = lintParseAllow(s1, 0, len(s1), 0, 0, 1, rules)
  assert(shortPresent)
  assert(!short.ok)
  assert(contains(short.defect, "need at least ${lintAllowMinReasonLen}"))

  // Not `E` + 4 digits.
  let s2 = "E12 -- a reason long enough to pass"
  let (badShape, badShapePresent) = lintParseAllow(s2, 0, len(s2), 0, 0, 1, rules)
  assert(badShapePresent)
  assert(!badShape.ok)
  assert(contains(badShape.defect, "not a diagnostic code"))

  // A well-formed code that names no registered rule.
  let s3 = "E0250 -- a reason long enough to pass here"
  let (unknown, unknownPresent) = lintParseAllow(s3, 0, len(s3), 0, 0, 1, rules)
  assert(unknownPresent)
  assert(!unknown.ok)
  assert(contains(unknown.defect, "not a registered lint rule"))

  // A threshold rule's code is registered but ineligible.
  let s4 = "E0200 -- a reason long enough to pass here"
  let (thresh, threshPresent) = lintParseAllow(s4, 0, len(s4), 0, 0, 1, rules)
  assert(threshPresent)
  assert(!thresh.ok)
  assert(contains(thresh.defect, "cannot be overridden per finding"))

  // A bare directive — nothing after "allow" at all — is not present, and
  // therefore neither a suppression nor a defect.
  let (_, barePresent) = lintParseAllow("", 0, 0, 0, 0, 1, rules)
  assert(!barePresent)

  // End to end: a valid `allow` directly above the aliasing call suppresses
  // it and is counted; the reasonless twin leaves the E0214 standing and adds
  // its own E0297, and neither takes the exit-2 hard-error path.
  let srcOk = "fn f(buf: []byte): int {\n" +
    "  // bit:lint allow E0214 -- buf is owned entirely by this function\n" +
    "  append(buf, 1)\n  return len(buf)\n}\n"
  let dOk = lintTestSink()
  let fOk = addFile(dOk.sm, "allow_ok.bit", srcOk)
  let tOk = parseSourceD(srcOk, fOk, lintTestSink())
  runLintRules(srcOk, fOk, tOk, newLintConfig(), dOk)
  assert(len(dOk.list) == 1) // the raw E0214 before allow is applied
  let suppressedOk = lintApplyAllows(srcOk, fOk, dOk)
  assert(suppressedOk == 1)
  assert(len(dOk.list) == 0)

  let srcBad = "fn f(buf: []byte): int {\n" +
    "  // bit:lint allow E0214 -- x\n" +
    "  append(buf, 1)\n  return len(buf)\n}\n"
  let dBad = lintTestSink()
  let fBad = addFile(dBad.sm, "allow_bad.bit", srcBad)
  let tBad = parseSourceD(srcBad, fBad, lintTestSink())
  runLintRules(srcBad, fBad, tBad, newLintConfig(), dBad)
  assert(len(dBad.list) == 1)
  let suppressedBad = lintApplyAllows(srcBad, fBad, dBad)
  assert(suppressedBad == 0)
  assert(len(dBad.list) == 2) // the E0297 defect AND the still-standing E0214
}

fn checkLintLineCount() {
  assert(lintCountLines("") == 0)
  assert(lintCountLines("a") == 1)
  assert(lintCountLines("a\n") == 1)
  assert(lintCountLines("a\nb") == 2)
  assert(lintCountLines("a\nb\n") == 2)
  // Blank lines count: the cost being bounded is the reader's (§4).
  assert(lintCountLines("\n\n\n") == 3)
}

// E0200 at the boundary: `limit` lines pass, `limit + 1` fails.
fn checkLintMaxFileLines() {
  let three = "a\nb\nc\n"

  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", three)
  lintMaxFileLines(three, f0, 3, d0)
  assert(len(d0.list) == 0)

  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", three)
  lintMaxFileLines(three, f1, 2, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxFileLines)
  // A finding is a WARNING and must not bump errorCount, or a lint hit could
  // fail an unrelated build (diagnostics.bit:93).
  assert(d1.list[0].severity == 1)
  assert(!hasErrors(d1))
  assert(d1.list[0].message == "file is 3 lines, limit is 2")
  // The hint carries the `-- <reason>` placeholder: without it the form it
  // teaches would itself exit 2 on first use.
  assert(
      d1.list[0].hint ==
        "split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>` " +
        "in the file's leading comment block",
  )

  // A disable really suppresses it, through the runner rather than the rule.
  // `three` is not valid Bit syntax — it only needs to be three lines — so its
  // parse is thrown into its own sink, mirroring lintCmd's split between a
  // parse/directive sink and the findings sink it must never pollute.
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "off.bit", three)
  let cfg = newLintConfig()
  cfg.disabled[lintRuleIndex(lintRules(), "max-file-lines")] = true
  let t2 = parseSourceD(three, f2, lintTestSink())
  runLintRules(three, f2, t2, cfg, d2)
  assert(len(d2.list) == 0)

  // And an override raising the limit suppresses it too, end to end from the
  // directive text.
  let src = "// bit:lint max-file-lines=5 -- fixture\n// b\n// c\n"
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "raised.bit", src)
  let c3 = readLintDirectives(src, f3, d3)
  assert(!hasErrors(d3))
  let t3 = parseSourceD(src, f3, lintTestSink())
  runLintRules(src, f3, t3, c3, d3)
  assert(len(d3.list) == 0)
}

// Parses `src` and returns every function-shaped node in it — the fixture
// setup every phase-1 AST rule test shares.
fn lintTestFuncs(src: string, file: int): []int {
  let tree = parseSourceD(src, file, lintTestSink())
  return lintCollectFuncs(tree, tree.root, []int(0))
}

// E0201 at the boundary: `limit` lines pass, `limit + 1` fails. Also covers
// an arrow function, which has no name but is measured the same way.
fn checkLintMaxFnLines() {
  // `function f() {`, `  let x = 1`, `}` — 3 physical lines, start to close.
  let three = "fn f() {\n  let x = 1\n}\n"

  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", three)
  let funcs0 = lintTestFuncs(three, f0)
  assert(len(funcs0) == 1)
  let t0 = parseSourceD(three, f0, lintTestSink())
  lintMaxFnLines(t0, funcs0, f0, 3, d0)
  assert(len(d0.list) == 0)

  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", three)
  let funcs1 = lintTestFuncs(three, f1)
  let t1 = parseSourceD(three, f1, lintTestSink())
  lintMaxFnLines(t1, funcs1, f1, 2, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxFnLines)
  assert(d1.list[0].severity == 1)
  assert(d1.list[0].message == "function is 3 lines, limit is 2")
  assert(
      d1.list[0].hint ==
        "split it, or raise the limit with `// bit:lint max-fn-lines=3 -- <reason>` " +
        "in the file's leading comment block",
  )

  // An arrow function has no name to report, and is measured all the same: 4
  // physical lines from its own start through the closing brace. Nested inside
  // a function (module- and function-scope bindings may not hold a bare
  // closure — §11.11 — so a standalone arrow cannot be top-level source).
  let arrow = "fn outer() {\n" +
    "  let f = (x: int) => {\n" +
    "    let y = x\n" +
    "    return y\n" +
    "  }\n" +
    "}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "arrow.bit", arrow)
  let t2 = parseSourceD(arrow, f2, lintTestSink())
  let all2 = lintCollectFuncs(t2, t2.root, []int(0))
  assert(len(all2) == 2) // the outer function, and the nested arrow
  let arrowFuncs = []int(0)
  for n of all2 {
    if (getNode(t2, n).tag == Tag.ArrowFn) {
      arrowFuncs = append(arrowFuncs, n)
    }
  }
  assert(len(arrowFuncs) == 1)
  lintMaxFnLines(t2, arrowFuncs, f2, 3, d2)
  assert(len(d2.list) == 1)
  assert(d2.list[0].code == ecLintMaxFnLines)
  assert(d2.list[0].message == "function is 4 lines, limit is 3")
}

// E0202 at the boundary, and the receiver exclusion (§4 constraint): a method
// receiver does not count toward the limit.
fn checkLintMaxParams() {
  let five = "fn f(a: int, b: int, c: int, d: int, e: int) {\n  return\n}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", five)
  let funcs0 = lintTestFuncs(five, f0)
  let t0 = parseSourceD(five, f0, lintTestSink())
  lintMaxParams(t0, funcs0, f0, 5, d0)
  assert(len(d0.list) == 0)

  let six = "fn f(a: int, b: int, c: int, d: int, e: int, g: int) {\n  return\n}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", six)
  let funcs1 = lintTestFuncs(six, f1)
  let t1 = parseSourceD(six, f1, lintTestSink())
  lintMaxParams(t1, funcs1, f1, 5, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxParams)
  assert(d1.list[0].message == "function has 6 params, limit is 5")
  assert(
      d1.list[0].hint ==
        "group them into a class, or raise the limit with `// bit:lint max-params=6 -- <reason>` " +
        "in the file's leading comment block",
  )

  // The receiver lives in its own `Receiver` kid, never in `Params` — five
  // declared params plus an in-body method's implicit `this` receiver
  // (SPEC §10.4; the written `fn (r: T)` form this pinned is retired by
  // #3762) must stay quiet at the default limit.
  let method = "class T {\n  m(a: int, b: int, c: int, d: int, e: int) {\n    return\n  }\n}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "method.bit", method)
  let funcs2 = lintTestFuncs(method, f2)
  let t2 = parseSourceD(method, f2, lintTestSink())
  lintMaxParams(t2, funcs2, f2, 5, d2)
  assert(len(d2.list) == 0)
}

// E0203 at the boundary, and the function-boundary reset: a nested arrow
// function starts its own nesting count at 0 rather than inheriting the
// enclosing function's depth.
fn checkLintMaxNesting() {
  let four = "fn f() {\n" +
    "  if (true) {\n" +
    "    if (true) {\n" +
    "      if (true) {\n" +
    "        if (true) {\n" +
    "          let x = 1\n" +
    "        }\n" +
    "      }\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", four)
  let funcs0 = lintTestFuncs(four, f0)
  let t0 = parseSourceD(four, f0, lintTestSink())
  lintMaxNesting(t0, funcs0, f0, 4, d0)
  assert(len(d0.list) == 0)

  let five = "fn f() {\n" +
    "  if (true) {\n" +
    "    if (true) {\n" +
    "      if (true) {\n" +
    "        if (true) {\n" +
    "          if (true) {\n" +
    "            let x = 1\n" +
    "          }\n" +
    "        }\n" +
    "      }\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", five)
  let funcs1 = lintTestFuncs(five, f1)
  let t1 = parseSourceD(five, f1, lintTestSink())
  lintMaxNesting(t1, funcs1, f1, 4, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxNesting)
  assert(d1.list[0].message == "function nests 5 deep, limit is 4")
  assert(
      d1.list[0].hint ==
        "add an early return, or raise the limit with `// bit:lint max-nesting=5 -- <reason>` " +
        "in the file's leading comment block",
  )

  let nestedArrow = "fn f() {\n" +
    "  if (true) {\n" +
    "    if (true) {\n" +
    "      if (true) {\n" +
    "        if (true) {\n" +
    "          let g = () => {\n" +
    "            if (true) {\n" +
    "              if (true) {\n" +
    "                let y = 1\n" +
    "              }\n" +
    "            }\n" +
    "          }\n" +
    "        }\n" +
    "      }\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "nested.bit", nestedArrow)
  let funcs2 = lintTestFuncs(nestedArrow, f2)
  assert(len(funcs2) == 2) // the outer function, and the inner arrow
  let t2 = parseSourceD(nestedArrow, f2, lintTestSink())
  lintMaxNesting(t2, funcs2, f2, 4, d2)
  assert(len(d2.list) == 0) // outer stays at 4; the arrow starts fresh at 2
}

// #2127: an `else if` chain is one flat dispatch, not N nested levels — every
// arm reports the SAME depth no matter how many `else if`s the chain has, and
// a genuinely nested `if` inside one arm's body (including the final `else`)
// still counts normally.
fn checkLintMaxNestingElseIf() {
  // A flat 6-arm chain at the top of the function body: `else if` never adds
  // depth, so even 6 arms report the same depth a lone `if` would.
  let chain = "fn f(s: string): int {\n" +
    "  if (s == \"a\") { return 0 } else if (s == \"b\") { return 1 } " +
    "else if (s == \"c\") { return 2 } else if (s == \"d\") { return 3 } " +
    "else if (s == \"e\") { return 4 } else if (s == \"f\") { return 5 }\n" +
    "  return -1\n" +
    "}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "chain.bit", chain)
  let funcs0 = lintTestFuncs(chain, f0)
  let t0 = parseSourceD(chain, f0, lintTestSink())
  lintMaxNesting(t0, funcs0, f0, 0, d0) // limit 0: even depth 1 would fire
  assert(len(d0.list) == 1)
  assert(d0.list[0].message == "function nests 1 deep, limit is 0")

  // A genuinely nested `if` inside one arm's THEN body still counts — the fix
  // must not blind the rule to real nesting inside a chain arm.
  let nestedInArm = "fn f(s: string): int {\n" +
    "  if (s == \"a\") {\n" +
    "    if (true) {\n" +
    "      return 1\n" +
    "    }\n" +
    "  } else if (s == \"b\") {\n" +
    "    return 2\n" +
    "  }\n" +
    "  return 0\n" +
    "}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "nestedarm.bit", nestedInArm)
  let funcs1 = lintTestFuncs(nestedInArm, f1)
  let t1 = parseSourceD(nestedInArm, f1, lintTestSink())
  lintMaxNesting(t1, funcs1, f1, 1, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].message == "function nests 2 deep, limit is 1")

  // A trailing plain `else { ... }` (not another `if`) is still a real block
  // at the same depth as any other arm — the `else if` exemption must not
  // extend to it.
  let nestedInElse = "fn f(s: string): int {\n" +
    "  if (s == \"a\") {\n" +
    "    return 1\n" +
    "  } else if (s == \"b\") {\n" +
    "    return 2\n" +
    "  } else {\n" +
    "    if (true) {\n" +
    "      return 3\n" +
    "    }\n" +
    "  }\n" +
    "  return 0\n" +
    "}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "nestedelse.bit", nestedInElse)
  let funcs2 = lintTestFuncs(nestedInElse, f2)
  let t2 = parseSourceD(nestedInElse, f2, lintTestSink())
  lintMaxNesting(t2, funcs2, f2, 1, d2)
  assert(len(d2.list) == 1)
  assert(d2.list[0].message == "function nests 2 deep, limit is 1")
}
