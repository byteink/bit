// In-Bit self-checks for `bit lint` (#1379/#1380). Run by `selfcheck()` under
// `./make test` and the x86_64 gate; a failed `assert` panics with exit 2.
//
// These cover the directive reader and the rule/render layer, which is
// everything that does not need a process. The CLI contract on top — path walk,
// exit codes, the summary line, `--json`, `--stats` — is execed and asserted by
// ``, because an exit code cannot be observed from inside the
// process that would produce it.
// bit:lint max-file-lines=928 -- unit tests for 11 rules in one file, growing
// alongside lint.bit's own registry (#1380); split when a 12th rule lands.

// Reads directives from `src` into a throwaway sink; returns the config. `errs`
// is the caller's sink so a test can assert on what was reported.
function lintTestRead(src: string, errs: Diagnostics): LintConfig {
  let f = addFile(errs.sm, "t.bit", src)
  return readLintDirectives(src, f, errs)
}

function lintTestSink(): Diagnostics {
  return newDiagnostics(newSourceManager())
}

// The effective limit for `max-file-lines` under `cfg`.
function lintTestFileLimit(cfg: LintConfig): int {
  return cfg.limits[lintRuleIndex(lintRules(), "max-file-lines")]
}

function lintTestFileDisabled(cfg: LintConfig): bool {
  return cfg.disabled[lintRuleIndex(lintRules(), "max-file-lines")]
}

function checkLintDirectivesAccepted() {
  // No directive: the built-in default, and nothing overridden.
  let d0 = lintTestSink()
  let c0 = lintTestRead("// just a comment\nfunction f() {}\n", d0)
  assert(!hasErrors(d0))
  assert(lintTestFileLimit(c0) == 800)
  assert(lintOverrideCount(c0) == 0)
  assert(len(lintOverrideNotes(c0)) == 0)

  // A directive that restates the default is still an override in force: it
  // changes no behaviour but it is a claim about this file, so it must show up
  // in the count and the listing rather than vanishing.
  let dd = lintTestSink()
  let cd = lintTestRead("// bit:lint max-file-lines=800 -- deliberate, not drift\n", dd)
  assert(!hasErrors(dd))
  assert(lintOverrideCount(cd) == 1)
  assert(lintOverrideNotes(cd)[0] == "max-file-lines=800")

  // An assignment.
  let d1 = lintTestSink()
  let c1 = lintTestRead("// bit:lint max-file-lines=1204 -- known debt\nfunction f() {}\n", d1)
  assert(!hasErrors(d1))
  assert(lintTestFileLimit(c1) == 1204)
  assert(lintOverrideCount(c1) == 1)
  assert(lintOverrideNotes(c1)[0] == "max-file-lines=1204")

  // A disable.
  let d2 = lintTestSink()
  let c2 = lintTestRead("// bit:lint disable max-file-lines -- generated\n", d2)
  assert(!hasErrors(d2))
  assert(lintTestFileDisabled(c2))
  assert(lintOverrideCount(c2) == 1)
  assert(lintOverrideNotes(c2)[0] == "disable max-file-lines")

  // Multiple directives: the LAST assignment for a rule wins, and both count as
  // one override, because the summary line reports settings in effect.
  let d3 = lintTestSink()
  let c3 = lintTestRead("// bit:lint max-file-lines=100 -- first\n" +
    "// bit:lint max-file-lines=900 -- second\n", d3)
  assert(!hasErrors(d3))
  assert(lintTestFileLimit(c3) == 900)
  assert(lintOverrideCount(c3) == 1)

  // Not pinned to line 1 — a golden case spends line 1 on the harness mode
  // directive, and the lint directive still has to be read.
  let d4 = lintTestSink()
  let c4 = lintTestRead("// lint\n// bit:lint max-file-lines=42 -- after the mode line\n", d4)
  assert(!hasErrors(d4))
  assert(lintTestFileLimit(c4) == 42)

  // Indented, and with no space between `//` and the directive.
  let d5 = lintTestSink()
  let c5 = lintTestRead("  //bit:lint max-file-lines=7 -- tight\n", d5)
  assert(!hasErrors(d5))
  assert(lintTestFileLimit(c5) == 7)

  // A reason may itself contain `--`; only the FIRST `--` after the assignment
  // terminates it.
  let d6 = lintTestSink()
  let c6 = lintTestRead("// bit:lint max-file-lines=9 -- see -- issue #1376\n", d6)
  assert(!hasErrors(d6))
  assert(lintTestFileLimit(c6) == 9)

  // `bit:` is a namespace claim for the whole toolchain. Another tool's
  // directive is skipped, not rejected.
  let d7 = lintTestSink()
  let c7 = lintTestRead("// bit:fmt something entirely else\n" +
    "// bit:lint max-file-lines=11 -- ours\n", d7)
  assert(!hasErrors(d7))
  assert(lintTestFileLimit(c7) == 11)
}

function checkLintDirectivePlacement() {
  // A blank line ends the leading comment block, so what follows is invisible.
  let d0 = lintTestSink()
  let c0 = lintTestRead("// header\n\n// bit:lint max-file-lines=42 -- too late\n", d0)
  assert(!hasErrors(d0))
  assert(lintTestFileLimit(c0) == 800)
  assert(lintOverrideCount(c0) == 0)

  // A declaration ends it too. Critically this must NOT report an error: the
  // directive is not recognised at all there, so it is neither honoured nor
  // diagnosed — it is an ordinary comment.
  let d1 = lintTestSink()
  let c1 = lintTestRead("function f() {}\n// bit:lint max-file-lines=42 -- too late\n", d1)
  assert(!hasErrors(d1))
  assert(lintTestFileLimit(c1) == 800)

  // A whitespace-only line counts as blank and ends the block.
  let d2 = lintTestSink()
  let c2 = lintTestRead("// header\n   \n// bit:lint max-file-lines=42 -- too late\n", d2)
  assert(!hasErrors(d2))
  assert(lintTestFileLimit(c2) == 800)
}

// The four error classes of §5.2. Every one is a hard error, never a silent
// no-op: a directive that quietly does nothing is how a lint rule dies.
function checkLintDirectiveErrors() {
  // 1. Malformed — no `=` and not the `disable` form.
  let d0 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines 900 -- nope\n", d0)
  assert(hasErrors(d0))
  assert(d0.list[0].code == ecLintBadDirective)

  // 1b. Malformed — nothing at all after the tool name.
  let d1 = lintTestSink()
  lintTestRead("// bit:lint\n", d1)
  assert(hasErrors(d1))
  assert(d1.list[0].code == ecLintBadDirective)

  // 1c. Malformed — `=` with no integer.
  let d2 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines= -- nope\n", d2)
  assert(hasErrors(d2))
  assert(d2.list[0].code == ecLintBadDirective)

  // 1d. Malformed — `disable` with no rule name.
  let d3 = lintTestSink()
  lintTestRead("// bit:lint disable -- nope\n", d3)
  assert(hasErrors(d3))
  assert(d3.list[0].code == ecLintBadDirective)

  // 2. Missing reason — no `--` at all.
  let d4 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines=900\n", d4)
  assert(hasErrors(d4))
  assert(d4.list[0].code == ecLintBadDirective)

  // 3. Empty reason — whitespace only after `--`.
  let d5 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines=900 --   \n", d5)
  assert(hasErrors(d5))
  assert(d5.list[0].code == ecLintBadDirective)

  // 4. Unknown rule name. Its own code, because this is the error that keeps a
  // renamed rule from turning every existing override into a no-op.
  let d6 = lintTestSink()
  lintTestRead("// bit:lint max-fyle-lines=900 -- typo\n", d6)
  assert(hasErrors(d6))
  assert(d6.list[0].code == ecLintUnknownRule)

  // 4b. Unknown rule in the `disable` form takes the same code.
  let d7 = lintTestSink()
  lintTestRead("// bit:lint disable no-such-rule -- typo\n", d7)
  assert(hasErrors(d7))
  assert(d7.list[0].code == ecLintUnknownRule)

  // A limit past the range guard is rejected rather than wrapped into a small
  // number that would silently TIGHTEN the rule.
  let d8 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines=99999999999999999999 -- huge\n", d8)
  assert(hasErrors(d8))
  assert(d8.list[0].code == ecLintBadDirective)

  // Every directive error is error severity, so `hasErrors` marks the file and
  // the command exits 2.
  assert(d0.list[0].severity == 0)
}

function checkLintLineCount() {
  assert(lintCountLines("") == 0)
  assert(lintCountLines("a") == 1)
  assert(lintCountLines("a\n") == 1)
  assert(lintCountLines("a\nb") == 2)
  assert(lintCountLines("a\nb\n") == 2)
  // Blank lines count: the cost being bounded is the reader's (§4).
  assert(lintCountLines("\n\n\n") == 3)
}

// E0200 at the boundary: `limit` lines pass, `limit + 1` fails.
function checkLintMaxFileLines() {
  let three = "a\nb\nc\n"

  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", three)
  lintMaxFileLines(three, f0, 3, d0)
  assert(len(d0.list) == 0)

  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", three)
  lintMaxFileLines(three, f1, 2, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxFileLines)
  // A finding is a WARNING and must not bump errorCount, or a lint hit could
  // fail an unrelated build (diagnostics.bit:93).
  assert(d1.list[0].severity == 1)
  assert(!hasErrors(d1))
  assert(d1.list[0].message == "file is 3 lines, limit is 2")
  // The hint carries the `-- <reason>` placeholder: without it the form it
  // teaches would itself exit 2 on first use.
  assert(d1.list[0].hint ==
    "split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>`")

  // A disable really suppresses it, through the runner rather than the rule.
  // `three` is not valid Bit syntax — it only needs to be three lines — so its
  // parse is thrown into its own sink, mirroring lintCmd's split between a
  // parse/directive sink and the findings sink it must never pollute.
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "off.bit", three)
  let cfg = newLintConfig()
  cfg.disabled[lintRuleIndex(lintRules(), "max-file-lines")] = true
  let t2 = parseSourceD(three, f2, lintTestSink())
  runLintRules(three, f2, t2, cfg, d2)
  assert(len(d2.list) == 0)

  // And an override raising the limit suppresses it too, end to end from the
  // directive text.
  let src = "// bit:lint max-file-lines=5 -- fixture\n// b\n// c\n"
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "raised.bit", src)
  let c3 = readLintDirectives(src, f3, d3)
  assert(!hasErrors(d3))
  let t3 = parseSourceD(src, f3, lintTestSink())
  runLintRules(src, f3, t3, c3, d3)
  assert(len(d3.list) == 0)
}

// Parses `src` and returns every function-shaped node in it — the fixture
// setup every phase-1 AST rule test shares.
function lintTestFuncs(src: string, file: int): []int {
  let tree = parseSourceD(src, file, lintTestSink())
  return lintCollectFuncs(tree, tree.root, []int(0))
}

// E0201 at the boundary: `limit` lines pass, `limit + 1` fails. Also covers
// an arrow function, which has no name but is measured the same way.
function checkLintMaxFnLines() {
  // `function f() {`, `  let x = 1`, `}` — 3 physical lines, start to close.
  let three = "function f() {\n  let x = 1\n}\n"

  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", three)
  let funcs0 = lintTestFuncs(three, f0)
  assert(len(funcs0) == 1)
  let t0 = parseSourceD(three, f0, lintTestSink())
  lintMaxFnLines(t0, funcs0, f0, 3, d0)
  assert(len(d0.list) == 0)

  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", three)
  let funcs1 = lintTestFuncs(three, f1)
  let t1 = parseSourceD(three, f1, lintTestSink())
  lintMaxFnLines(t1, funcs1, f1, 2, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxFnLines)
  assert(d1.list[0].severity == 1)
  assert(d1.list[0].message == "function is 3 lines, limit is 2")
  assert(d1.list[0].hint ==
    "split it, or raise the limit with `// bit:lint max-fn-lines=3 -- <reason>`")

  // An arrow function has no name to report, and is measured all the same: 4
  // physical lines from its own start through the closing brace. Nested inside
  // a function (module- and function-scope bindings may not hold a bare
  // closure — §11.11 — so a standalone arrow cannot be top-level source).
  let arrow = "function outer() {\n" +
    "  let f = (x: int) => {\n" +
    "    let y = x\n" +
    "    return y\n" +
    "  }\n" +
    "}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "arrow.bit", arrow)
  let t2 = parseSourceD(arrow, f2, lintTestSink())
  let all2 = lintCollectFuncs(t2, t2.root, []int(0))
  assert(len(all2) == 2) // the outer function, and the nested arrow
  let arrowFuncs = []int(0)
  for n of all2 {
    if (getNode(t2, n).tag == Tag.ArrowFn) {
      arrowFuncs = append(arrowFuncs, n)
    }
  }
  assert(len(arrowFuncs) == 1)
  lintMaxFnLines(t2, arrowFuncs, f2, 3, d2)
  assert(len(d2.list) == 1)
  assert(d2.list[0].code == ecLintMaxFnLines)
  assert(d2.list[0].message == "function is 4 lines, limit is 3")
}

// E0202 at the boundary, and the receiver exclusion (§4 constraint): a method
// receiver does not count toward the limit.
function checkLintMaxParams() {
  let five = "function f(a: int, b: int, c: int, d: int, e: int) {\n  return\n}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", five)
  let funcs0 = lintTestFuncs(five, f0)
  let t0 = parseSourceD(five, f0, lintTestSink())
  lintMaxParams(t0, funcs0, f0, 5, d0)
  assert(len(d0.list) == 0)

  let six = "function f(a: int, b: int, c: int, d: int, e: int, g: int) {\n  return\n}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", six)
  let funcs1 = lintTestFuncs(six, f1)
  let t1 = parseSourceD(six, f1, lintTestSink())
  lintMaxParams(t1, funcs1, f1, 5, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxParams)
  assert(d1.list[0].message == "function has 6 params, limit is 5")
  assert(d1.list[0].hint ==
    "group them into a struct, or raise the limit with `// bit:lint max-params=6 -- <reason>`")

  // The receiver lives in its own `Receiver` kid, never in `Params` — five
  // declared params plus a receiver must stay quiet at the default limit.
  let method = "function (r: T) m(a: int, b: int, c: int, d: int, e: int) {\n  return\n}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "method.bit", method)
  let funcs2 = lintTestFuncs(method, f2)
  let t2 = parseSourceD(method, f2, lintTestSink())
  lintMaxParams(t2, funcs2, f2, 5, d2)
  assert(len(d2.list) == 0)
}

// E0203 at the boundary, and the function-boundary reset: a nested arrow
// function starts its own nesting count at 0 rather than inheriting the
// enclosing function's depth.
function checkLintMaxNesting() {
  let four = "function f() {\n" +
    "  if (true) {\n" +
    "    if (true) {\n" +
    "      if (true) {\n" +
    "        if (true) {\n" +
    "          let x = 1\n" +
    "        }\n" +
    "      }\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", four)
  let funcs0 = lintTestFuncs(four, f0)
  let t0 = parseSourceD(four, f0, lintTestSink())
  lintMaxNesting(t0, funcs0, f0, 4, d0)
  assert(len(d0.list) == 0)

  let five = "function f() {\n" +
    "  if (true) {\n" +
    "    if (true) {\n" +
    "      if (true) {\n" +
    "        if (true) {\n" +
    "          if (true) {\n" +
    "            let x = 1\n" +
    "          }\n" +
    "        }\n" +
    "      }\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", five)
  let funcs1 = lintTestFuncs(five, f1)
  let t1 = parseSourceD(five, f1, lintTestSink())
  lintMaxNesting(t1, funcs1, f1, 4, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxNesting)
  assert(d1.list[0].message == "function nests 5 deep, limit is 4")
  assert(d1.list[0].hint ==
    "add an early return, or raise the limit with `// bit:lint max-nesting=5 -- <reason>`")

  let nestedArrow = "function f() {\n" +
    "  if (true) {\n" +
    "    if (true) {\n" +
    "      if (true) {\n" +
    "        if (true) {\n" +
    "          let g = () => {\n" +
    "            if (true) {\n" +
    "              if (true) {\n" +
    "                let y = 1\n" +
    "              }\n" +
    "            }\n" +
    "          }\n" +
    "        }\n" +
    "      }\n" +
    "    }\n" +
    "  }\n" +
    "}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "nested.bit", nestedArrow)
  let funcs2 = lintTestFuncs(nestedArrow, f2)
  assert(len(funcs2) == 2) // the outer function, and the inner arrow
  let t2 = parseSourceD(nestedArrow, f2, lintTestSink())
  lintMaxNesting(t2, funcs2, f2, 4, d2)
  assert(len(d2.list) == 0) // outer stays at 4; the arrow starts fresh at 2
}

// `n` flat (unnested) `if` statements in one function body: complexity is
// `1 + n`, with no other branch point in the way.
function lintTestNIfsSrc(n: int): string {
  let src = "function f() {\n"
  let i = 0
  while (i < n) {
    src = src + "  if (a) {}\n"
    i = i + 1
  }
  return src + "}\n"
}

// The effective limit for `max-complexity` under `cfg`.
function lintTestComplexityLimit(cfg: LintConfig): int {
  return cfg.limits[lintRuleIndex(lintRules(), "max-complexity")]
}

// E0204 at the boundary (default limit 10, spec/LINT.md §4 + §8): `limit`
// passes, `limit + 1` fails. Also covers every counted construct at once —
// each `if`/`while`/`for`(all four forms)/`match` arm/`catch`(both forms)/
// `&&`/`||` contributes exactly one, `else` and the `match` statement itself
// contribute nothing — and the runner wiring (dispatch, disable, override).
function checkLintMaxComplexity() {
  let rules = lintRules()
  let idx = lintRuleIndex(rules, "max-complexity")
  assert(idx >= 0)
  assert(rules[idx].code == ecLintMaxComplexity)
  assert(rules[idx].limit == 10)

  // 9 flat ifs: complexity 1 + 9 = 10, the default limit exactly. Passes.
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", lintTestNIfsSrc(9))
  lintMaxComplexity(parseSource(lintTestNIfsSrc(9)), f0, rules[idx].limit, d0)
  assert(len(d0.list) == 0)

  // 10 flat ifs: complexity 1 + 10 = 11. Fails, and the message carries the
  // score so the author knows the distance.
  let d1 = lintTestSink()
  let src1 = lintTestNIfsSrc(10)
  let f1 = addFile(d1.sm, "bad.bit", src1)
  lintMaxComplexity(parseSource(src1), f1, rules[idx].limit, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxComplexity)
  assert(d1.list[0].severity == 1) // a warning, must not bump errorCount
  assert(d1.list[0].message == "function complexity is 11, limit is 10")
  assert(d1.list[0].hint ==
    "split it, or raise the limit with `// bit:lint max-complexity=11 -- <reason>`")

  // Reported at the function's own declaration span, not the file start —
  // unlike max-file-lines, there can be more than one per file.
  assert(d1.list[0].span.start > 0)

  // Every counted construct, once each, plus one `export`-wrapped function
  // (the export wrapper itself must not block dispatch) with a plain `else`
  // that must NOT add to the score, and a `match` statement whose own node
  // must not add to the score (only its two arms do).
  let everything = "export function everything() {\n" +
    "  if (a) {\n" +
    "  } else {\n" +
    "  }\n" +
    "  while (b) {}\n" +
    "  for v of xs {}\n" +
    "  for v in xs {}\n" +
    "  for (let i = 0; i < 1; i = i + 1) {}\n" +
    "  for {\n" +
    "    break\n" +
    "  }\n" +
    "  match (0) {\n" +
    "    A => {}\n" +
    "    B => {}\n" +
    "  }\n" +
    "  let c1 = d catch 0\n" +
    "  let c2 = e catch err {\n" +
    "  }\n" +
    "  let f = g && h\n" +
    "  let k = m || n\n" +
    "}\n"
  // if(1) + while(1) + for_of(1) + for_in(1) + for_c(1) + for_inf(1) +
  // match_arm(2) + catch_bind(1) + catch_default(1) + &&(1) + ||(1) = 12,
  // plus the base of 1 = 13.
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "everything.bit", everything)
  lintMaxComplexity(parseSource(everything), f2, 13, d2)
  assert(len(d2.list) == 0)
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "everything.bit", everything)
  lintMaxComplexity(parseSource(everything), f3, 12, d3)
  assert(len(d3.list) == 1)
  assert(d3.list[0].message == "function complexity is 13, limit is 12")

  // A disable really suppresses it, through the runner rather than the rule.
  let d4 = lintTestSink()
  let f4 = addFile(d4.sm, "off.bit", src1)
  let cfg = newLintConfig()
  cfg.disabled[idx] = true
  let t4 = parseSourceD(src1, f4, lintTestSink())
  runLintRules(src1, f4, t4, cfg, d4)
  assert(len(d4.list) == 0)

  // And an override raising the limit suppresses it too, end to end from the
  // directive text.
  let src2 = "// bit:lint max-complexity=11 -- fixture\n" + lintTestNIfsSrc(10)
  let d5 = lintTestSink()
  let f5 = addFile(d5.sm, "raised.bit", src2)
  let c5 = readLintDirectives(src2, f5, d5)
  assert(!hasErrors(d5))
  assert(lintTestComplexityLimit(c5) == 11)
  let t5 = parseSourceD(src2, f5, lintTestSink())
  runLintRules(src2, f5, t5, c5, d5)
  assert(len(d5.list) == 0)
}

// The two shapes that motivate the rule (spec/LINT.md §4, task hypothesis):
// line count and branch count catch different failures, so neither rule
// subsumes the other.
function checkLintComplexityShapes() {
  // A long, flat `match`: many arms, each a straight-line body with no
  // further branching. Every arm costs exactly one, so a handful of them
  // keeps the score at or under the default limit even though the function
  // is long — well past `max-fn-lines`' default of 80 (spec/LINT.md §4).
  let arms = 9
  let bodyLines = 10
  let flat = "function flat() {\n  match (0) {\n"
  let i = 0
  while (i < arms) {
    flat = flat + "    A${i} => {\n"
    let j = 0
    while (j < bodyLines) {
      flat = flat + "      let p${i}_${j} = ${j}\n"
      j = j + 1
    }
    flat = flat + "    }\n"
    i = i + 1
  }
  flat = flat + "  }\n}\n"
  assert(lintCountLines(flat) > 80) // would fail a naive line-count rule
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "flat.bit", flat)
  lintMaxComplexity(parseSource(flat), f0, 10, d0)
  assert(len(d0.list) == 0) // 1 + 9 arms = 10: passes complexity

  // A short function with one heavily chained condition: nine `&&` on one
  // `if` is eleven lines shorter than `max-fn-lines`' default but eleven past
  // `max-complexity`'s.
  let chained = "function chained() {\n" +
    "  if (a && b && c && d && e && f && g && h && i && j) {\n" +
    "  }\n" +
    "}\n"
  assert(lintCountLines(chained) <= 80) // passes a line-count rule easily
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "chained.bit", chained)
  lintMaxComplexity(parseSource(chained), f1, 10, d1)
  assert(len(d1.list) == 1) // 1 (base) + 1 (if) + 9 (&&) = 11: fails complexity
  assert(d1.list[0].message == "function complexity is 11, limit is 10")
}

// E0205 `defer-in-loop`: positive (while/for/nested), and the negatives the
// spec calls out by name — top-level, a defer inside a function merely CALLED
// from a loop (lexical scope only, no call-graph analysis), and a defer inside
// an arrow's own body even when the arrow is defined inside a loop.
function checkLintDeferInLoop() {
  // A defer directly inside a `while` is reported, at the `defer` keyword —
  // not the whole `defer print(...)` statement DeferStmt's own span covers.
  let src0 = "function f() {\n  while (true) {\n    defer print(\"x\")\n  }\n}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "t.bit", src0)
  let t0 = parseSourceD(src0, f0, lintTestSink())
  lintDeferInLoop(t0, f0, d0)
  assert(len(d0.list) == 1)
  assert(d0.list[0].code == ecLintDeferInLoop)
  assert(d0.list[0].severity == 1)
  assert(d0.list[0].message == "defer inside a loop runs at function exit, not loop exit")
  assert(d0.list[0].hint == "the enclosing loop starts at line 2")
  let sp0 = d0.list[0].span
  assert(src0[sp0.start:sp0.end] == "defer")

  // A defer inside a `for` loop is reported too.
  let src1 = "function f() {\n  for (let i = 0; i < 3; i = i + 1) {\n    defer print(\"x\")\n  }\n}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "t.bit", src1)
  let t1 = parseSourceD(src1, f1, lintTestSink())
  lintDeferInLoop(t1, f1, d1)
  assert(len(d1.list) == 1)

  // A defer at function top level is not reported.
  let src2 = "function f() {\n  defer print(\"x\")\n}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "t.bit", src2)
  let t2 = parseSourceD(src2, f2, lintTestSink())
  lintDeferInLoop(t2, f2, d2)
  assert(len(d2.list) == 0)

  // A defer inside a function that merely happens to be CALLED from a loop is
  // not reported — this rule is lexical only, never call-graph.
  let src3 = "function g() {\n  defer print(\"x\")\n}\nfunction f() {\n  while (true) {\n    g()\n  }\n}\n"
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "t.bit", src3)
  let t3 = parseSourceD(src3, f3, lintTestSink())
  lintDeferInLoop(t3, f3, d3)
  assert(len(d3.list) == 0)

  // A defer inside a nested loop is reported, against the NEAREST loop.
  let src4 = "function f() {\n  while (true) {\n    for (let i = 0; i < 3; i = i + 1) {\n      defer print(\"x\")\n    }\n  }\n}\n"
  let d4 = lintTestSink()
  let f4 = addFile(d4.sm, "t.bit", src4)
  let t4 = parseSourceD(src4, f4, lintTestSink())
  lintDeferInLoop(t4, f4, d4)
  assert(len(d4.list) == 1)
  assert(d4.list[0].hint == "the enclosing loop starts at line 3")

  // A defer inside an ARROW's body is not reported even when the arrow itself
  // sits inside a loop: the defer binds to the closure's own frame and runs
  // when the arrow returns, not when the enclosing function does.
  let src5 = "function f() {\n  while (true) {\n    let g = (x: i64) => {\n      defer print(\"x\")\n      return x\n    }\n  }\n}\n"
  let d5 = lintTestSink()
  let f5 = addFile(d5.sm, "t.bit", src5)
  let t5 = parseSourceD(src5, f5, lintTestSink())
  lintDeferInLoop(t5, f5, d5)
  assert(len(d5.list) == 0)

  // ...but a defer inside a LOOP that is itself inside the arrow's body still
  // fires — against that inner loop, proving the arrow boundary RESETS the
  // loop context rather than suppressing the rule for the rest of the walk.
  let src6 = "function f() {\n  while (true) {\n    let g = (x: i64) => {\n      while (x > 0) {\n        defer print(\"x\")\n        x = x - 1\n      }\n      return x\n    }\n  }\n}\n"
  let d6 = lintTestSink()
  let f6 = addFile(d6.sm, "t.bit", src6)
  let t6 = parseSourceD(src6, f6, lintTestSink())
  lintDeferInLoop(t6, f6, d6)
  assert(len(d6.list) == 1)
  assert(d6.list[0].hint == "the enclosing loop starts at line 4")

  // Registered disable-only: one of only two boolean rules in phase 1, so an
  // override naming a value must fail through the generic "takes no value"
  // directive error rather than silently applying.
  let de = lintTestSink()
  lintTestRead("// bit:lint defer-in-loop=1 -- nope\n", de)
  assert(hasErrors(de))
  assert(de.list[0].code == ecLintBadDirective)

  // The `disable` form works end to end, through the runner.
  let src7 = "// bit:lint disable defer-in-loop -- generated\n" +
    "function f() {\n  while (true) {\n    defer print(\"x\")\n  }\n}\n"
  let d7 = lintTestSink()
  let f7 = addFile(d7.sm, "t.bit", src7)
  let c7 = readLintDirectives(src7, f7, d7)
  assert(!hasErrors(d7))
  let t7 = parseSourceD(src7, f7, lintTestSink())
  runLintRules(src7, f7, t7, c7, d7)
  assert(len(d7.list) == 0)
}

// E0213 `shadowed-local`: the gap case (an inner `let` hides an outer local),
// the parameter decision (a parameter shadowing an outer name is silent), the
// no-overlap-with-E0042 case (same-scope redeclaration reports only as
// duplicate_declaration), and the no-double-report-with-E0048 cases (a `let`
// hiding a predeclared name, and one hiding a prelude-shaped module import —
// see resolve.bit's `rFindShadowedLocal`).
function checkLintShadowedLocal() {
  // The gap: an outer local `count`, an inner block's own `count` hides it.
  let d0 = lintTestSink()
  let src0 = "function f() {\n  let count = 1\n  {\n    let count = 2\n  }\n}\n"
  let f0 = addFile(d0.sm, "gap.bit", src0)
  lintShadowedLocal(src0, f0, d0)
  assert(len(d0.list) == 1)
  assert(d0.list[0].code == ecLintShadowedLocal)
  assert(d0.list[0].severity == 1)
  assert(!hasErrors(d0))
  assert(d0.list[0].message == "'count' shadows an outer binding of the same name")
  assert(d0.list[0].hint == "outer 'count' declared at gap.bit:2:7")

  // A parameter shadowing a module-level name of the same word: the
  // highest-volume real-world shape, deliberately not reported.
  let d1 = lintTestSink()
  let src1 = "let count = 0\nfunction f(count: int): int {\n  return count\n}\n"
  let f1 = addFile(d1.sm, "param.bit", src1)
  lintShadowedLocal(src1, f1, d1)
  assert(len(d1.list) == 0)

  // Same-scope redeclaration is duplicate_declaration's job (E0042), not this
  // rule's — this pass reports nothing for it (the resolver's own E0042 goes
  // to a throwaway sink lintShadowedLocal never surfaces).
  let d2 = lintTestSink()
  let src2 = "function f() {\n  let x = 1\n  let x = 2\n}\n"
  let f2 = addFile(d2.sm, "dup.bit", src2)
  lintShadowedLocal(src2, f2, d2)
  assert(len(d2.list) == 0)

  // A let hiding a predeclared name: E0048 shadows_predeclared already reports
  // this (via bit check); this rule stays silent so the two never double up.
  let d3 = lintTestSink()
  let src3 = "function f() {\n  let int = 1\n}\n"
  let f3 = addFile(d3.sm, "predecl.bit", src3)
  lintShadowedLocal(src3, f3, d3)
  assert(len(d3.list) == 0)
}

function checkLintRender() {
  let src = "a\nb\nc\n"
  let d = lintTestSink()
  let f = addFile(d.sm, "big.bit", src)
  lintMaxFileLines(src, f, 2, d)

  // Human output goes through the shared renderer — same gutter, caret and
  // hint machinery as `bit check`.
  assert(renderDiags(d) ==
    "warning[E0200]: file is 3 lines, limit is 2\n" +
    " --> big.bit:1:1\n" +
    "  |\n" +
    "1 | a\n" +
    "  | ^ split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>`\n")

  // JSON is the LSP shape `bit check --json` already emits: same keys, same
  // 0-based line/character range.
  assert(lintRenderJson(d) ==
    "[{\"code\":\"E0200\",\"severity\":\"warning\",\"file\":\"big.bit\"," +
    "\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}," +
    "\"message\":\"file is 3 lines, limit is 2\"," +
    "\"hint\":\"split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>`\"}]")

  // Quotes and control bytes are escaped, so a path or message containing one
  // cannot produce unparseable JSON.
  assert(lintJsonString("a\"b") == "\"a\\\"b\"")
  assert(lintJsonString("a\\b") == "\"a\\\\b\"")
  assert(lintJsonString("a\nb") == "\"a\\u000ab\"")
}

// Findings are ordered by file path, then line, then code — golden tests pin
// this order, so a stable one is a correctness property, not a nicety.
function checkLintOrdering() {
  let d = lintTestSink()
  let fb = addFile(d.sm, "b.bit", "x\n")
  let fa = addFile(d.sm, "a.bit", "x\ny\n")
  warn(d, 201, Span{ file: fb, start: 0, end: 0 }, "second file", "")
  warn(d, 201, Span{ file: fa, start: 2, end: 2 }, "line 2", "")
  warn(d, 200, Span{ file: fa, start: 0, end: 0 }, "line 1", "")
  lintSortDiags(d)
  assert(d.list[0].message == "line 1")
  assert(d.list[1].message == "line 2")
  assert(d.list[2].message == "second file")
}

function checkLintArgs() {
  // No paths defaults to ".".
  let a0 = parseLintArgs(["bit", "lint"])
  assert(a0.ok)
  assert(len(a0.paths) == 1)
  assert(a0.paths[0] == ".")
  assert(!a0.json)
  assert(!a0.stats)

  let a1 = parseLintArgs(["bit", "lint", "--json", "--stats", "compiler", "stdlib"])
  assert(a1.ok)
  assert(a1.json)
  assert(a1.stats)
  assert(len(a1.paths) == 2)
  assert(a1.paths[1] == "stdlib")

  // An unknown flag is a usage error, not a path.
  let a2 = parseLintArgs(["bit", "lint", "--quiet"])
  assert(!a2.ok)
  assert(a2.badFlag == "--quiet")
}

// Runs the whole pipeline (parse + resolve + rule dispatch) over `src` under
// the default config, the way `bit lint` itself would for one file.
function lintTestUnused(src: string): Diagnostics {
  let d = lintTestSink()
  let file = addFile(d.sm, "t.bit", src)
  let cfg = newLintConfig()
  let tree = parseSourceD(src, file, lintTestSink())
  runLintRules(src, file, tree, cfg, d)
  return d
}

function lintHasFinding(d: Diagnostics, code: int, message: string): bool {
  let i = 0
  while (i < len(d.list)) {
    if (d.list[i].code == code && d.list[i].message == message) {
      return true
    }
    i = i + 1
  }
  return false
}

// E0210: an import never referenced anywhere is reported; one referenced only
// inside a nested block is not — both read `nodeSymbols` the same way
// regardless of how deep the reference sits, unlike a flat name-keyed env.
function checkLintUnusedImport() {
  let d0 = lintTestUnused("import { foo } from \"./mod\"\n\nfunction main() {\n}\n")
  assert(lintHasFinding(d0, ecLintUnusedImport, "'foo' is imported but never used"))

  let d1 = lintTestUnused(
    "import { foo } from \"./mod\"\n\nfunction main() {\n  if (true) {\n    foo()\n  }\n}\n")
  assert(!lintHasFinding(d1, ecLintUnusedImport, "'foo' is imported but never used"))

  // `import { foo as _ } from "..."` is Bit's spelling of an import kept only
  // for a side effect (SPEC §5.1/§17.2): the blank identifier never binds a
  // real symbol, so it is exempt with no special-casing in the rule itself.
  let d2 = lintTestUnused("import { foo as _ } from \"./mod\"\n\nfunction main() {\n}\n")
  assert(!lintHasFinding(d2, ecLintUnusedImport, "'foo' is imported but never used"))
  assert(len(d2.list) == 0)
}

// E0211: a local declared and never read is reported; a local read only
// inside a closure is not; a local assigned but never subsequently read is
// reported too (a write is not a use).
function checkLintUnusedLocal() {
  let d0 = lintTestUnused("function f() {\n  let x = 1\n}\n")
  assert(lintHasFinding(d0, ecLintUnusedLocal, "'x' is declared but never used"))

  let d1 = lintTestUnused("function f() {\n  let x = 1\n  x = 2\n}\n")
  assert(lintHasFinding(d1, ecLintUnusedLocal, "'x' is declared but never used"))

  let d2 = lintTestUnused(
    "function f() {\n  let x = 1\n  let g = () => { return x }\n  g()\n}\n")
  assert(!lintHasFinding(d2, ecLintUnusedLocal, "'x' is declared but never used"))
  assert(!lintHasFinding(d2, ecLintUnusedLocal, "'g' is declared but never used"))

  // The blank identifier discards deliberately and never binds a symbol.
  let d3 = lintTestUnused("function f() {\n  let _ = 1\n}\n")
  assert(!lintHasFinding(d3, ecLintUnusedLocal, "'_' is declared but never used"))
  assert(len(d3.list) == 0)
}

// E0212 `unreachable-code`. Exercises `lintUnreachableCode` directly, over
// `parseSource` — no resolver, matching the rule's own AST-only dependency
// (spec/LINT.md §4.2).
function checkLintUnreachableCode() {
  // Reported: a statement after a `return` in the same block.
  let d0 = lintTestSink()
  let src0 = "function f(): int {\n  return 1\n  let dead = 2\n  return dead\n}\n"
  let f0 = addFile(d0.sm, "u0.bit", src0)
  lintUnreachableCode(parseSource(src0), src0, f0, d0)
  assert(len(d0.list) == 1)
  assert(d0.list[0].code == ecLintUnreachableCode)
  // A finding is a WARNING and must not bump errorCount (diagnostics.bit:93).
  assert(d0.list[0].severity == 1)
  assert(!hasErrors(d0))
  assert(d0.list[0].message == "unreachable code")

  // NOT reported: only one arm of this `if` diverges (there is no `else`), so
  // `diverges` (and therefore this rule) does not treat it as terminal — the
  // exact partial-divergence case the reuse constraint exists for.
  let d1 = lintTestSink()
  let src1 = "function f(x: bool): int {\n  if (x) {\n    return 1\n  }\n  let after = 2\n  return after\n}\n"
  let f1 = addFile(d1.sm, "u1.bit", src1)
  lintUnreachableCode(parseSource(src1), src1, f1, d1)
  assert(len(d1.list) == 0)

  // Reported: BOTH arms of the `if`/`else` diverge, so the `if` as a whole
  // diverges and what follows it is dead.
  let d2 = lintTestSink()
  let src2 = "function f(x: bool): int {\n  if (x) {\n    return 1\n  } else {\n    return 2\n  }\n  let dead = 3\n}\n"
  let f2 = addFile(d2.sm, "u2.bit", src2)
  lintUnreachableCode(parseSource(src2), src2, f2, d2)
  assert(len(d2.list) == 1)

  // ONE finding per dead run, not one per statement in it.
  let d3 = lintTestSink()
  let src3 = "function f(): int {\n  return 1\n  let a = 1\n  let b = 2\n}\n"
  let f3 = addFile(d3.sm, "u3.bit", src3)
  lintUnreachableCode(parseSource(src3), src3, f3, d3)
  assert(len(d3.list) == 1)

  // The match-arm case: a `return` inside one arm's own block makes the
  // statement after it dead, exactly like a plain function body. The other
  // arm doesn't diverge, so the match as a whole doesn't either and the
  // `return 0` after it stays live.
  let d4 = lintTestSink()
  let src4 = "function f(x: bool): int {\n  match (x) {\n    A => {\n      return 1\n      let dead = 2\n    }\n    B => {\n      let ok = 1\n    }\n  }\n  return 0\n}\n"
  let f4 = addFile(d4.sm, "u4.bit", src4)
  lintUnreachableCode(parseSource(src4), src4, f4, d4)
  assert(len(d4.list) == 1)

  // `break` ends the rest of its own block too, even outside a function that
  // needs to return — `countBrk` is true here, unlike missing-return's caller.
  let d5 = lintTestSink()
  let src5 = "function f() {\n  for {\n    break\n    let dead = 1\n  }\n}\n"
  let f5 = addFile(d5.sm, "u5.bit", src5)
  lintUnreachableCode(parseSource(src5), src5, f5, d5)
  assert(len(d5.list) == 1)

  // A disable really suppresses it, through the runner rather than the rule.
  let d6 = lintTestSink()
  let f6 = addFile(d6.sm, "u6.bit", src0)
  let cfg6 = newLintConfig()
  cfg6.disabled[lintRuleIndex(lintRules(), "unreachable-code")] = true
  let t6 = parseSourceD(src0, f6, lintTestSink())
  runLintRules(src0, f6, t6, cfg6, d6)
  assert(len(d6.list) == 0)
}

function checkLint() {
  checkLintDirectivesAccepted()
  checkLintDirectivePlacement()
  checkLintDirectiveErrors()
  checkLintLineCount()
  checkLintMaxFileLines()
  checkLintMaxFnLines()
  checkLintMaxParams()
  checkLintMaxNesting()
  checkLintMaxComplexity()
  checkLintComplexityShapes()
  checkLintDeferInLoop()
  checkLintUnusedImport()
  checkLintUnusedLocal()
  checkLintUnreachableCode()
  checkLintShadowedLocal()
  checkLintRender()
  checkLintOrdering()
  checkLintArgs()
}
