// Constant 64-bit logical funnel shifts (#8506), same compiler module.
// Like xEmitMulPairAt, early emission is safe only across its own consumed
// operands: skipped constants emit nothing and no other instruction may intervene.

fn xEmitBinaryOrFunnel(cx: XCtx, i: int, ins: IrInstr, w: Width) {
  if (ins.op == Op.BOr && xEmitFunnelAt(cx, i)) {
    return
  }
  xEmitBinaryInt(cx, xArithForOp(ins.op), i, ins.lhs, ins.rhs, w)
}

fn xEmitShiftOrFunnel(cx: XCtx, i: int, ins: IrInstr, w: Width) {
  if (xEmitFunnelAt(cx, i)) {
    return
  }
  xEmitShiftInt(cx, i, ins.lhs, ins.rhs, xShiftPlanFor(cx.f, ins.rhs, xShiftForOp(ins.op), w))
}

fn xFunnelMap(cx: XCtx): []int {
  if (!cx.funnelReady) {
    cx.funnel = xComputeFunnels(cx)
    cx.funnelReady = true
  }
  return cx.funnel
}

fn xComputeFunnels(cx: XCtx): []int {
  let folds = noForwarding(len(cx.f.instrs))
  let uses = xUseCounts(cx.f)
  for b of cx.f.blocks {
    let i = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (i < end) {
      if (xFunnelShape(cx, i, uses, b.instsStart + b.paramCount)) {
        let ins = cx.f.instrs[i]
        folds[ins.lhs] = i
        folds[ins.rhs] = i
        folds[i] = i
      }
      i = i + 1
    }
  }
  return folds
}

fn xFunnelShape(cx: XCtx, i: int, uses: []int, start: int): bool {
  let f = cx.f
  let ins = f.instrs[i]
  if (ins.op != Op.BOr || widthOf(cx.ctx, ins.ty).bytes != 8) {
    return false
  }
  if (!xFunnelOperands(ins, i, start, uses)) {
    return false
  }
  let left = f.instrs[ins.lhs]
  let right = f.instrs[ins.rhs]
  if (left.op == Op.LShr) {
    left = f.instrs[ins.rhs]
    right = f.instrs[ins.lhs]
  }
  if (!xFunnelCounts(cx, left, right)) {
    return false
  }
  let first = xFunnelFirst(ins)
  if (left.lhs >= first || right.lhs >= first) {
    return false
  }
  return xFunnelGap(cx, first, i, ins.lhs, ins.rhs)
}

fn xFunnelFirst(ins: IrInstr): int {
  if (ins.lhs < ins.rhs) {
    return ins.lhs
  }
  return ins.rhs
}

fn xFunnelOperands(ins: IrInstr, i: int, start: int, uses: []int): bool {
  if (ins.lhs < start || ins.rhs < start || ins.lhs >= i || ins.rhs >= i) {
    return false
  }
  return uses[ins.lhs] == 1 && uses[ins.rhs] == 1
}

fn xFunnelCounts(cx: XCtx, left: IrInstr, right: IrInstr): bool {
  if (left.op != Op.Shl || right.op != Op.LShr) {
    return false
  }
  if (widthOf(cx.ctx, left.ty).bytes != 8 || widthOf(cx.ctx, right.ty).bytes != 8) {
    return false
  }
  return xFunnelAmounts(cx.f, left.rhs, right.rhs)
}

fn xFunnelAmounts(f: IrFunc, left: int, right: int): bool {
  let l = xConstIntOf(f, left)
  let r = xConstIntOf(f, right)
  return l.known && r.known && l.ival > 0 && l.ival < 64 && r.ival == 64 - l.ival
}

fn xFunnelGap(cx: XCtx, first: int, end: int, left: int, right: int): bool {
  let i = first
  while (i < end) {
    if (i != left && i != right) {
      if (i >= len(cx.skipConst) || !cx.skipConst[i] || !opIsIntConst(cx.f.instrs[i].op)) {
        return false
      }
    }
    i = i + 1
  }
  return xFunnelNoClears(cx, first, end)
}

// Register clears are emitted outside xEmitInst, even for skipped constants.
fn xFunnelNoClears(cx: XCtx, first: int, end: int): bool {
  let i = first + 1
  while (i <= end) {
    if (xClearsBefore(cx, i) != 0) {
      return false
    }
    i = i + 1
  }
  return true
}

fn xEmitFunnelAt(cx: XCtx, i: int): bool {
  let folds = xFunnelMap(cx)
  if (i >= len(folds) || folds[i] < 0) {
    return false
  }
  let root = cx.f.instrs[folds[i]]
  if (i == xFunnelFirst(root)) {
    let left = cx.f.instrs[root.lhs]
    let right = cx.f.instrs[root.rhs]
    if (left.op == Op.LShr) {
      left = cx.f.instrs[root.rhs]
      right = cx.f.instrs[root.lhs]
    }
    xEmitFunnelValue(cx, folds[i], right.lhs, left.lhs, xConstIntOf(cx.f, right.rhs).ival)
  }
  return true
}

fn xEmitFunnelValue(cx: XCtx, dst: int, lo: int, hi: int, amount: int) {
  let low = xGetInt(cx, lo, xScratch1())
  let high = xGetInt(cx, hi, xScratch2())
  let acc = xIntAcc(cx, dst)
  // The OR result may share the high source's home before its nominal start.
  if (acc == high && acc != low) {
    acc = xScratch1()
  }
  xMovRR(cx.buf, acc, low)
  xShrdImm(cx.buf, acc, high, amount)
  xPutInt(cx, dst, acc)
}
