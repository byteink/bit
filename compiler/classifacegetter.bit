// compiler/classifacegetter.bit — the class half of an interface FIELD
// REQUIREMENT (SPEC §14.3, #6990; the interface half is checkifacefield.bit).
//
//     interface Subject { id: string }
//     class User { export id: string }     // synthesized: __get_id(): string { return this.id }
//
// A class never writes the getter. For each field `f` it declares that some
// interface of the project requires (`interface I { f: T }`), this pass adds
// `[export] __get_f(): <the field's type> { return this.f }` to the class, so
// `vSatisfies` finds the method the interface's requirement was recorded as and
// a read through the interface is an ordinary dispatch. Nothing is generated
// for a project that declares no field requirement, nor for a field no
// requirement names, so an unrelated program's IR and tree are unchanged.
//
// Visibility: an `export` field satisfies from anywhere; one without it only
// for an interface declared in the class's own module (SPEC §10.5). A field
// that fails that gets no getter, and the interface check says so (E0041).
// The getter's type is the field's own type node, cloned; a mismatch with the
// requirement is therefore E0041 too, never a silent coercion.

// Which field names the project's interfaces require. `any` is keyed by the
// bare name, `local` by "<moduleId>:<name>" for the module that declares the
// requiring interface.
class IfaceGetterDemand {
  any: map<string, bool>,
  local: map<string, bool>,
}

// One class field that owes a getter: the class's own name node (cloned for the
// receiver) and generics, the field's name and type nodes, and the `export` flag
// the getter copies from the CLASS.
class IfaceGetter {
  className: int,
  generics: int,
  exported: bool,
  fieldName: int,
  fieldType: int,
  name: string,
}

// The interface declaration behind top-level node `d0`, seeing through `export`,
// or 0.
fn topInterfaceDecl(tree: Tree, d0: int): int {
  let d = d0
  if (d != 0 && getNode(tree, d).tag == Tag.Export) {
    d = kidsOf(tree, d)[0]
  }
  if (d == 0 || getNode(tree, d).tag != Tag.InterfaceDecl) {
    return 0
  }
  return d
}

// Every field requirement any interface in the project declares.
fn collectIfaceGetterDemand(p: Project): IfaceGetterDemand {
  let dm = IfaceGetterDemand{ any = map<string, bool>{}, local = map<string, bool>{} }
  let mid = 0
  while (mid < len(p.mods)) {
    let m = p.mods[mid]
    for d0 of kidsOf(m.tree, m.tree.root) {
      let d = topInterfaceDecl(m.tree, d0)
      if (d == 0) {
        continue
      }
      for sig of kidsOf(m.tree, kidsOf(m.tree, d)[2]) {
        if (getNode(m.tree, sig).main == 2) {
          let name = identText(m.tree, m.source, kidsOf(m.tree, sig)[0])
          dm.any[name] = true
          dm.local["${mid}:${name}"] = true
        }
      }
    }
    mid = mid + 1
  }
  return dm
}

// The field node behind class member `m0` (looking through `export`) and
// whether it was exported, or `(0, false)` for a method, `use` or anything else.
fn getterMemberField(tree: Tree, m0: int): (int, bool) {
  let m = m0
  let exported = getNode(tree, m).tag == Tag.Export
  if (exported) {
    m = kidsOf(tree, m)[0]
  }
  if (getNode(tree, m).tag != Tag.Field) {
    return (0, false)
  }
  return (m, exported)
}

// Does `demand` ask this module's class field `name` for a getter?
fn ifaceGetterWanted(demand: IfaceGetterDemand, mid: int, name: string, exported: bool): bool {
  let (_, wanted) = demand.any[name]
  if (!wanted) {
    return false
  }
  let (_, here) = demand.local["${mid}:${name}"]
  return exported || here
}

// Every field of module `m`'s top-level classes that owes a getter. A class
// that already declares `__get_<name>` is skipped: E0310 names it
// (`vReservedGetterName`), so the user's method is the only one and the error
// points at it.
fn collectIfaceGetters(m: SrcModule, mid: int, demand: IfaceGetterDemand): []IfaceGetter {
  let out = []IfaceGetter(0)
  if (len(demand.any) == 0) {
    return out
  }
  for tc of topClassDecls(m.tree) {
    let k = kidsOf(m.tree, tc.decl)
    for m0 of kidsOf(m.tree, k[2]) {
      let (f, fieldExported) = getterMemberField(m.tree, m0)
      if (f == 0) {
        continue
      }
      let fk = kidsOf(m.tree, f)
      let name = identText(m.tree, m.source, fk[0])
      if (!ifaceGetterWanted(demand, mid, name, fieldExported) ||
        declaredMember(m.tree, m.source, k[2], ifaceGetterPrefix + name) != 0) {
        continue
      }
      out = append(
        out,
        IfaceGetter{
          className = k[0], generics = k[1], exported = tc.exported,
          fieldName = fk[0], fieldType = fk[1], name = name,
        },
      )
    }
  }
  return out
}

// The words the getters need spelled in the module's synthesized text.
fn ifaceGetterSynthWords(getters: []IfaceGetter): []string {
  let out = []string(0)
  if (len(getters) == 0) {
    return out
  }
  out = append(out, synthReceiverName)
  for g of getters {
    out = append(out, ifaceGetterPrefix + g.name)
  }
  return out
}

// `[export] __get_<name>(): <field type> { return this.<name> }`.
fn synthIfaceGetter(tree: Tree, source: string, st: SynthText, g: IfaceGetter): int {
  let sp = getNode(tree, g.className).span
  // Generics BEFORE any node a body or result mentions: `registerGenerics`
  // scopes by ascending node index (checktraitinject.bit's cloneTraitMethod).
  let generics = 0
  if (g.generics != 0) {
    generics = dupGenericParamsTree(tree, g.generics)
  }
  let result = cloneWithSelf(tree, source, g.fieldType, sp)
  let field = addLeaf(tree, Tag.Ident, getNode(tree, g.fieldName).span)
  let read = addNode(tree, Tag.Member, sp, 0, [synthIdent(tree, st, synthReceiverName), field])
  let body = addNode(tree, Tag.Block, sp, 0, [addNode(tree, Tag.ReturnStmt, sp, 0, [read])])
  let recv = addNode(
    tree,
    Tag.Receiver,
    sp,
    0,
    [0, traitClassTypeRef(tree, g.className, g.generics)],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, sp, 0,
    [
      recv, synthIdent(tree, st, ifaceGetterPrefix + g.name), generics,
      addNode(tree, Tag.Params, sp, 0, []int(0)), result, body,
    ],
  )
  if (!g.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, sp, 0, [decl])
}

// Every owed getter, for the caller to attach alongside every other feature's.
fn injectIfaceGetterDecls(
  tree: Tree, source: string, st: SynthText, getters: []IfaceGetter,
): []int {
  let out = []int(0)
  for g of getters {
    out = append(out, synthIfaceGetter(tree, source, st, g))
  }
  return out
}

// E0310 (§14.3): a class declares a method named `__get_...`, the prefix the
// compiler's field-requirement getters own. Reserved on EVERY class, field
// requirement or not, for `__jobName`'s reason (classjobdesc.bit): a hand-written
// one would silently satisfy a field requirement by name alone.
fn vReservedGetterName(tree: Tree, source: string, diags: Diagnostics) {
  for tc of topClassDecls(tree) {
    for m0 of kidsOf(tree, kidsOf(tree, tc.decl)[2]) {
      let m = m0
      if (getNode(tree, m).tag == Tag.Export) {
        m = kidsOf(tree, m)[0]
      }
      if (getNode(tree, m).tag != Tag.FuncDecl) {
        continue
      }
      let nameNode = kidsOf(tree, m)[1]
      let name = identText(tree, source, nameNode)
      if (isIfaceGetterName(name)) {
        report(
          diags, ecIfaceGetterDeclared, getNode(tree, nameNode).span,
          "class '${identText(tree, source, kidsOf(tree, tc.decl)[0])}' declares '${name}', a name the compiler reserves for interface field getters",
          "rename this method — '__get_<field>' is synthesized for a field an interface requires (SPEC §14.3), and a hand-written one would satisfy that requirement by name alone",
        )
      }
    }
  }
}
