// bit — the Bit-in-Bit compiler (self-host).
//
// Early driver. Two modes:
//   `bit --dump-tokens <file>` — lex the file and print the token stream in
//     the seed's exact format, so `bit --dump-tokens` diffs byte-for-byte
//     against `bit --dump-tokens` (the differential harness, #1332).
//   `bit build <file.bit> [-o out]` — compile a Bit program to a native,
//     ad-hoc-signed aarch64-macos executable, using nothing but this compiler:
//     parse -> check -> lower -> opt -> arm64 codegen -> Mach-O object -> link
//     -> sign. No seed compiler, no system toolchain.
//   `bit selfcheck` — self-test the ported modules (compiler/selfcheck.bit).
//     A failed assert panics (exit 2), so `./make test` / the gate catches a
//     regression in any ported subsystem. This was the no-args behaviour until
//     #1827; no args is now a usage error, because a shipped compiler must not
//     run its own test suite when a user types its name with nothing after it.
// The real front/middle/back ends land under this directory per the epic.
import { args, exit, envOr, selfExe } from "std/os"
// `isDir`/`walk` are NOT imported here: sibling files are the same module, so
// `pmfetch.bit`'s and `lint.bit`'s imports already bind them module-wide and a
// second import is a redeclaration (E0042).
import { readFile, writeFile } from "std/fs"
import { hasSuffix } from "std/strings"

// The one file a `--dump-*` command reads, plus false when it could not be read
// (already reported). Every dump had its own copy of this, and every copy wrote
// to STDOUT and returned, so the process exited 0 (#2396).
//
// These six surfaces are the entry points of `scripts/selfhost-diff*.sh`: two
// compilers are handed the same path and their stdout is diffed. So a path that
// had moved made BOTH sides print the identical `bit: cannot read <path>` line on
// stdout and exit 0 — an empty diff, and a differential reporting PASS having
// compared nothing. The false green lived inside the harness family built to
// catch false greens.
//
// The message is unchanged so anything grepping for it still matches; only the
// STREAM and the EXIT CODE change. Exit 1, decided in `main` rather than here so
// this has no non-local exit: the argv was well formed, so this is not the usage
// error 2 means on this tree (and 2 is also what a Bit panic returns), while 1 is
// "the tool ran and could not do the work". `bit fmt` on an unreadable path
// already exits 1.
fn readDumpSource(path: string): (string, bool) {
  let src = readFile(path) catch e {
    eprint("bit: cannot read ${path}\n")
    return "", false
  }
  return src, true
}

// `--dump-tokens`: one line per token, `<kind> <start>..<end>`, including the
// synthesized ASI/eof semicolons and the final eof — matching the seed's
// tokensReport exactly. False iff the input could not be read (already
// reported); the dump itself cannot fail.
fn dumpTokens(path: string): bool {
  let (src, ok) = readDumpSource(path)
  if (!ok) {
    return false
  }
  let toks = lexAll(src)
  let i = 0
  while (i < len(toks)) {
    let t = toks[i]
    print("${kindName(t.kind)} ${t.start}..${t.end}\n")
    i = i + 1
  }
  return true
}

// `--dump-ast`: the parsed tree as an s-expression, matching the seed's
// `ast.dump` byte-for-byte (no trailing newline).
fn dumpAstCmd(path: string): bool {
  let (src, ok) = readDumpSource(path)
  if (!ok) {
    return false
  }
  let tree = parseSource(src)
  print(dumpAst(tree, src))
  return true
}

// `--dump-diags`: run the front-end (lex + parse) and print the rendered
// diagnostics — empty for a clean file — matching the seed's frontend
// diagnostic output for the self-host error differential.
//
// EMPTY STDOUT IS THE CORRECT ANSWER HERE for a clean file, which is exactly why
// the unreadable-input case had to stop using stdout: the two were
// indistinguishable to `scripts/selfhost-diffdiags.sh` and to
// `scripts/selfhost-fuzzdiff.sh`.
fn dumpDiagsCmd(path: string): bool {
  let (src, ok) = readDumpSource(path)
  if (!ok) {
    return false
  }
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  parseSourceD(src, f, d)
  print(renderDiags(d))
  return true
}

// `check <file|dir>`: the front end only — load, parse, type-check, validate,
// and render any diagnostics to stderr, matching `bit check` byte for byte (the
// check differential diffs the two). Exit 1 iff anything was reported; silence
// and exit 0 for a clean module.
//
// The same pipeline `build` uses, deliberately: `check` IS build's front end, so
// anything it accepts or rejects here must be what a build would. A file and a
// directory are both modules (SPEC §17.1); a file's module is that one file.
fn checkCmd(path: string): bool {
  // The operand must EXIST and must contain Bit source, checked before the
  // loader is asked for anything (#2394): `bit check src/` after a rename exited
  // 0 in silence, which is the one failure a verification gate must not have.
  // `moduleRootProblem` (compiler/build.bit) is shared with `buildIr` so `check`
  // and `build` cannot start disagreeing about the same path again.
  let problem = moduleRootProblem(path)
  if (problem != "") {
    eprint("bit check: ${path}: ${problem}\n")
    return false
  }
  let rootDir = path
  let rootOnly = ""
  if (!fsIsDir(path)) {
    rootDir = pathDir(path)
    rootOnly = pathBase(path)
  }
  // #2254: same manifest-vs-lock guard `buildIr` (build.bit) runs, so `check`
  // and `build`/`run` cannot start disagreeing about the same bit.json again
  // — see `manifestLockProblem` (project.bit) for exactly what it checks.
  let (lockEntries, lockErr) = loadLockEntries(rootDir)
  let manifestProblem = manifestLockProblem(rootDir, lockEntries, lockErr)
  if (manifestProblem != "") {
    eprint("bit check: ${manifestProblem}\n")
    return false
  }
  let p = loadProject(rootDir, rootOnly, stdRootPath())
  if (p.root < 0 || len(p.mods) == 0) {
    eprint("bit check: not a module: ${path}\n")
    return false
  }
  // Resolve first: the module graph is decided by the loader, not by types, and
  // the seed reports its resolve errors alongside the parse errors (it resolves
  // as it loads). Gating before this dropped E0044/E0045 whenever the same file
  // also had a parse error — exactly the case a malformed `import` produces.
  let mods = resolveProject(p)
  // THEN parse+resolve errors, together and alone — the type checker would read
  // a recovered tree's holes as real nodes and pile noise on top of the cause.
  if (reportCheckErrors(p.diags)) {
    return false
  }
  checkResolved(p, mods)
  // Final gate: renders a warnings-only sink too (#2491), unlike the
  // parse+resolve gate above.
  return !reportCheckDiagnostics(p.diags)
}

// `--dump-types`: parse + type-check the file and print the binding/param/call
// type dump, matching the seed's `bit --dump-types` for the self-host Stage-2
// differential.
fn dumpTypesCmd(path: string): bool {
  let (src, ok) = readDumpSource(path)
  if (!ok) {
    return false
  }
  print(checkSourceDump(src))
  return true
}

// `--dump-ir`: parse + check + lower the file and print the SSA IR text,
// matching the seed's `bit --dump-ir` for the self-host Stage-2 differential.
fn dumpIrCmd(path: string, optimize: bool): bool {
  let (src, ok) = readDumpSource(path)
  if (!ok) {
    return false
  }
  if (optimize) {
    print(lowerSourceDumpOpt(src))
    return true
  }
  print(lowerSourceDump(src))
  return true
}

// `bit` is itself a Bit program, so a `BIT_GC` policy aimed at the program
// under test lands on THE COMPILER as well. `BIT_GC=stress` collects at every
// loop back-edge, which over a whole compilation is hundreds of thousands of
// collections — a six-line input takes hours and is indistinguishable from a
// hang, with nothing on stderr to say why.
//
// #1438 was filed s1 against self-hosted safepoint emission on exactly that
// reading, and cost two agents a debugging session before an empty
// `print("hi")` program was shown to "hang" identically. The condition is
// legitimate and self-inflicted, so it is diagnosed rather than second-guessed:
// overriding the user's environment would be worse than a slow compile.
//
// Only `stress` is called out. `BIT_GC=off` also reaches the compiler but makes
// it faster, not slower, so warning about it would be noise.
fn warnCompilerUnderStressGc() {
  if (envOr("BIT_GC", "") != "stress") {
    return
  }
  eprint("bit: warning: BIT_GC=stress applies to the compiler itself — bit is a Bit program.\n")
  eprint("bit: this compile will be orders of magnitude slower, and may look like a hang.\n")
  eprint("bit: to stress the program under test, build it first, then set BIT_GC to run it.\n")
}

// True when `s` is a GNU `ar` operation code rather than a plausible output
// path: one of the operation letters `dmpqrtx`, optionally followed only by
// modifier letters. So `t`, `r`, `x`, `rc`, `rcs`, `cru` and `tv` are all
// caught. See the call site for why this is worth rejecting.
//
// DELIBERATELY NARROW. It matches the WHOLE argument, case-sensitively, and
// only when every trailing character is a known modifier — so a real path is
// never mistaken for a code. `bit ar` is called by this repo's own build driver
// with paths that carry no `.a` suffix, which is why the test cannot be "does
// it look like an archive name" (#1896 constraints).
fn isArOperationCode(s: string): bool {
  if (len(s) == 0) {
    return false
  }
  // EVERY character must be an operation or modifier letter, and at least one
  // must be an OPERATION. The first character is not privileged: GNU accepts
  // modifiers before the operation, and `ar cru lib.a *.o` — where `r` is the
  // operation and `c`/`u` are modifiers — is one of the most common spellings
  // there is. An earlier version of this required s[0] to be an operation and
  // therefore missed `cru` entirely, which is the single most likely thing a
  // user types after `t`.
  let sawOp = false
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    let isOp = c == 'd' || c == 'm' || c == 'p' || c == 'q' || c == 'r' ||
      c == 't' || c == 'x'
    // GNU ar's modifier set: abcDilNoPsSTuUv.
    let isMod = c == 'a' || c == 'b' || c == 'c' || c == 'D' || c == 'i' ||
      c == 'l' || c == 'N' || c == 'o' || c == 'P' || c == 's' || c == 'S' ||
      c == 'T' || c == 'u' || c == 'U' || c == 'v'
    if (!isOp && !isMod) {
      return false
    }
    if (isOp) {
      sawOp = true
    }
    i = i + 1
  }
  return sawOp
}

fn main() {
  warnCompilerUnderStressGc()
  let a = args()
  // The shared argv front end (compiler/cli.bit), ahead of every dispatch
  // below. It refuses a flag no subcommand declares, so an unrecognised one can
  // never reach a handler as an OPERAND — which is how `bit check --version
  // <broken-module>` came to exit 0 having checked nothing (#2107). It exits on
  // rejection and returns otherwise, so the dispatch below is unchanged.
  cliFrontEnd(a)
  // a[0] is the program name.
  if (len(a) >= 3 && a[1] == "check") {
    if (checkCmd(a[2])) {
      return
    }
    exit(1)
    return
  }
  // `lint` takes no mandatory operand — with no paths it lints `.` — so it is
  // dispatched on argc >= 2, unlike `check`/`run`/`test`.
  if (len(a) >= 2 && a[1] == "lint") {
    exit(lintCmd(a))
    return
  }
  // `lsp` takes no operand — it speaks the language server protocol over stdio
  // until the client closes the stream. Dispatched on argc >= 2 like `lint`.
  if (len(a) >= 2 && a[1] == "lsp") {
    lspRun()
    return
  }
  // `doc [--json] <module-dir>`: the module's exported symbols, derived from the
  // checker rather than a hand-kept list (#1590). Dispatched on argc >= 2 so a
  // bare `bit doc` reports the usage error rather than the banner, matching the
  // seed. Exactly one operand must remain after an optional `--json`.
  if (len(a) >= 2 && a[1] == "doc") {
    let asJson = false
    let di = 2
    if (di < len(a) && a[di] == "--json") {
      asJson = true
      di = di + 1
    }
    // Exit 2, like every other usage error here — 1 is what a doc run that
    // actually ran and failed returns, and the two were indistinguishable.
    if (di + 1 != len(a)) {
      eprint("usage: bit doc [--json] <module-dir>\n")
      exit(2)
      return
    }
    if (docCmd(a[di], asJson)) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 3 && a[1] == "add") {
    exit(addCmd(a))
    return
  }
  // `up [name]` / `update [name]`: the dependency name is OPTIONAL (refresh
  // everything), unlike `add`'s mandatory spec — dispatched on argc >= 2 like
  // `lint`/`lsp`, not argc >= 3. `update` is an exact alias, routed to the
  // same handler as `up`.
  if (len(a) >= 2 && (a[1] == "up" || a[1] == "update")) {
    exit(upCmd(a))
    return
  }
  if (len(a) >= 3 && a[1] == "remove") {
    exit(removeCmd(a))
    return
  }
  if (len(a) >= 3 && a[1] == "run") {
    exit(runCmd(a[2]))
    return
  }
  if (len(a) >= 3 && a[1] == "test") {
    exit(testCmd(a[2]))
    return
  }
  if (len(a) >= 3 && a[1] == "fmt") {
    exit(fmtCmd(a))
    return
  }
  // Every `--dump-*` returns false iff its input could not be read, and each
  // exits 1 on that — they used to print to stdout and fall off the end of
  // `main` with status 0, which made every differential in
  // `scripts/selfhost-diff*.sh` capable of passing without comparing anything
  // (#2396). The exit lives here rather than in the dump so the handlers keep
  // the one-way-out shape the rest of this dispatch has.
  if (len(a) >= 3 && a[1] == "--dump-tokens") {
    if (dumpTokens(a[2])) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-types") {
    if (dumpTypesCmd(a[2])) {
      return
    }
    exit(1)
    return
  }
  // `--dump-ir-pre` renders the raw lowering; `--dump-ir` renders it after the
  // optimizer, matching the seed's two surfaces (#1338 / #1339 differentials).
  if (len(a) >= 3 && a[1] == "--dump-ir-pre") {
    if (dumpIrCmd(a[2], false)) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-ir") {
    if (dumpIrCmd(a[2], true)) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-ast") {
    if (dumpAstCmd(a[2])) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-diags") {
    if (dumpDiagsCmd(a[2])) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 2 && a[1] == "ar") {
    if (len(a) < 3) {
      eprint("usage: bit ar <out.a> <obj.o...> [--target x86_64-linux|aarch64-linux|aarch64-macos]\n")
      exit(2)
      return
    }
    // `bit ar` is OUTPUT-FIRST; GNU `ar` is operation-first. So `bit ar t lib.a`
    // — muscle memory for "list this archive" — used to silently CREATE a file
    // named `t` whose single member is lib.a, and print nothing. The empty output
    // then reads as "the archive has no members", which is a confidently wrong
    // answer to a question that was never asked (#1896).
    //
    // It is not hypothetical: `t` reached this repo's history three times and was
    // committed twice (afd448f, then again in b336e70 after 499b9f5 removed it).
    // The name is plausible enough to survive review and matches no .gitignore.
    //
    // Rejecting is safe because an operation code is never a sensible output
    // filename and `bit ar` has no listing mode for this to shadow.
    if (isArOperationCode(a[2])) {
      eprint("bit ar: '${a[2]}' is a GNU ar operation code, not an output path.\n")
      eprint("bit ar: usage is output-first: bit ar <out.a> <obj.o...>\n")
      eprint("bit ar: to inspect an existing archive, use `ar t <archive>` or `nm <archive>`.\n")
      eprint("bit ar: to write a file genuinely named '${a[2]}', spell it './${a[2]}'.\n")
      exit(2)
      return
    }
    if (!arCmd(a)) {
      exit(1)
    }
    return
  }
  if (len(a) >= 3 && a[1] == "build") {
    // Parse: one positional <src>, plus `-o <out>`, `--emit-obj` and
    // `--target <t>` in any order after it.
    let out = ""
    let emitObj = false
    let freestanding = false
    let target = hostBuildTarget()
    let ai = 3
    while (ai < len(a)) {
      if (a[ai] == "-o" && ai + 1 < len(a)) {
        out = a[ai + 1]
        ai = ai + 2
      } else if (a[ai] == "--emit-obj" || a[ai] == "-c") {
        emitObj = true
        ai = ai + 1
      } else if (a[ai] == "--freestanding") {
        freestanding = true
        ai = ai + 1
      } else if ((a[ai] == "--target" || a[ai] == "-t") && ai + 1 < len(a)) {
        let ti = parseBuildTarget(a[ai + 1])
        if (ti < 0) {
          eprint("bit: unknown target '${a[ai + 1]}' (x86_64-linux | aarch64-linux | aarch64-macos)\n")
          exit(1)
          return
        }
        target = buildTargetOf(ti)
        ai = ai + 2
      } else {
        // Reached only for a value-taking flag with no value left (`bit build
        // x.bit -o`): cliFrontEnd already refused anything else flag-shaped
        // that `build` does not declare, and any surplus operand. Exit 2 for
        // the same reason it does — a usage error must not share an exit code
        // with a compile failure.
        eprint("bit build: unexpected argument '${a[ai]}'\n")
        exit(2)
        return
      }
    }
    if (out == "") {
      // A directory target (§17.1's project-directory build mode) has no
      // `.bit` suffix for `pathStem` to strip, so that path derives an
      // EMPTY name for ".", "./" and any argument ending in "/" — the
      // directory's own last path component is the empty string after the
      // trailing slash (#2260). Derive it separately instead.
      if (fsIsDir(a[2])) {
        out = buildDirDefaultOut(a[2]) catch e {
          eprint("bit build: ${e.message()}\n")
          exit(2)
          return
        }
      } else {
        out = pathStem(a[2])
      }
      if (emitObj) {
        out = out + ".o"
      }
    }
    // §17.6: freestanding describes an archive MEMBER — a module compiled with
    // no prelude and emitted alone. There is no freestanding executable today
    // (nothing would boot it), so require --emit-obj rather than implying it.
    if (freestanding && !emitObj) {
      eprint("bit: --freestanding emits an archive member: pass --emit-obj\n")
      exit(2)
      return
    }
    let ok = false
    if (emitObj) {
      ok = buildObjCmd(a[2], out, target, freestanding)
    } else {
      ok = buildCmd(a[2], out, target)
    }
    if (ok) {
      return
    }
    exit(1)
    return
  }
  // A real `version` subcommand (#1451). It used to only APPEAR to work: every
  // unrecognized argument fell through to the banner below, so `bit version`
  // and `bit vresion` printed the same thing. The output is one machine-
  // readable line, byte-identical to the seed's, so installers and the
  // differential harnesses can compare the two compilers directly.
  if (len(a) >= 2 && (a[1] == "version" || a[1] == "--version" || a[1] == "-V")) {
    print("bit ${bitVersion}\n")
    return
  }
  // `bit selfcheck`: the in-Bit self-tests, run by `./make test-selfcheck`.
  // EXPLICIT, because this used to be what no-args did. That was right while
  // `bit` was a bootstrap artifact and wrong the moment it shipped: a user who
  // typed `bit` got lock-file test fixtures ("pmlock check: no stale fixture to
  // remove") and a wait long enough to look like a hang, instead of usage.
  if (len(a) >= 2 && a[1] == "selfcheck") {
    selfcheck()
    print("bit ")
    print(bitVersion)
    print(" — selfcheck OK\n")
    return
  }
  if (len(a) >= 2) {
    // Reached only when a known subcommand is missing its operand, or the
    // subcommand is not one we have. Either way it is a usage error (exit 2),
    // never the banner.
    if (isKnownSubcommand(a[1])) {
      eprint("bit: ${a[1]}: missing operand\n")
    } else {
      eprint("bit: unknown subcommand '${a[1]}'\n")
    }
    eprint(bitUsage())
    exit(2)
    return
  }
  // No arguments is a usage error like any other, on stderr with exit 2. It must
  // not run anything: whatever this path does is the first thing a new user sees.
  eprint(bitUsage())
  exit(2)
}

// The subcommands and flags `main` dispatches above. Kept beside the usage text
// so a new subcommand cannot be added to one without the other going stale.
// `selfcheck` is listed here but deliberately NOT in bitUsage(): it is the gate's
// entry point, not something a user runs, yet a typo'd `bit selfchek` should still
// report an unknown subcommand rather than a missing operand.
fn isKnownSubcommand(s: string): bool {
  return s == "build" || s == "run" || s == "check" || s == "test" || s == "ar" ||
    s == "fmt" || s == "doc" || s == "lsp" || s == "lint" || s == "add" ||
    s == "up" || s == "update" || s == "remove" || s == "selfcheck" ||
    s == "--dump-tokens" || s == "--dump-types" || s == "--dump-ir" ||
    s == "--dump-ir-pre" || s == "--dump-ast" || s == "--dump-diags"
}

// The one line an error prints before exiting. It no longer names a
// `<file.bit>` that half these subcommands do not take, nor a bare `[options]`
// that nothing ever expanded (#2233) — `bit --help` lists the subcommands and
// `bit <subcommand> --help` lists that one's flags, so this points there
// instead of pretending to summarise both.
fn bitUsage(): string {
  return "usage: bit <subcommand> [arguments]\n" +
    "Run `bit --help` for the subcommands, `bit <subcommand> --help` for its flags.\n"
}

// `bit fmt [--check] <path>...`: reformats each file to Bit's one canonical
// style (fmt.bit), rewriting it in place only when the canonical text differs
// (idempotent). A file that fails to parse is left untouched and its diagnostics
// go to stderr. `--check` writes nothing and instead names every file that is
// not already canonical. Returns a nonzero exit code iff any file failed or,
// under `--check`, drifted — matching the seed's runFmt per-file independence.
fn fmtCmd(a: []string): int {
  let anyFailed = false
  // `--check` is honoured WHEREVER it appears, and is read in a pass of its
  // own BEFORE any file is touched. cliFrontEnd declares it an accepted flag of
  // this subcommand, and a table that says a flag is accepted while the parser
  // reads it as a path (`bit fmt src --check` used to answer `cannot read
  // --check`) is exactly the drift that layer exists to prevent. Deciding it
  // inline would be worse than the bug: `bit fmt src --check` would rewrite
  // `src` in place and only then learn it was asked to write nothing.
  let checkOnly = false
  let f = 2
  while (f < len(a)) {
    if (a[f] == "--check") {
      checkOnly = true
    }
    f = f + 1
  }
  let i = 2
  while (i < len(a)) {
    if (a[i] == "--check") {
      i = i + 1
      continue
    }
    let paths = fmtPaths(a[i])
    if (len(paths) == 0) {
      anyFailed = true
    }
    for p of paths {
      if (fmtOneFile(p, checkOnly)) {
        anyFailed = true
      }
    }
    i = i + 1
  }
  if (anyFailed) {
    return 1
  }
  return 0
}

// The files one `fmt` argument names. A directory expands to every `.bit`
// source beneath it, in `walk`'s sorted order so a run's output is stable;
// anything else passes through untouched, so naming a file directly still
// works and an unreadable path still reports through `fmtOneFile`.
//
// A directory holding no `.bit` source is an ERROR, not an empty success.
// `bit fmt --check <dir>` is how the repo gates its own sources, and a gate
// that passes over an input set it never populated is worse than no gate —
// this repo has shipped twelve of those. Silently succeeding here would turn
// a mistyped path into a green build.
// Returns EMPTY only on failure, having already said why; a non-directory
// always yields exactly one path, so the caller reads an empty result as
// "this argument failed" without needing to re-test what it was.
fn fmtPaths(arg: string): []string {
  let out = []string(0)
  if (!isDir(arg)) {
    return append(out, arg)
  }
  let all = walk(arg) catch e {
    eprint("bit fmt: cannot read directory ${arg}\n")
    return out
  }
  for p of all {
    if (hasSuffix(p, ".bit")) {
      out = append(out, p)
    }
  }
  if (len(out) == 0) {
    eprint("bit fmt: no .bit sources under ${arg}\n")
  }
  return out
}

// Formats one path. Returns true iff it failed (unreadable, unparseable, or —
// under `--check` — not canonical). Without `--check`, an out-of-date file is
// rewritten in place and an unwritable one fails. Every path is independent, so
// the caller keeps going after a failure (gofmt's contract).
fn fmtOneFile(path: string, checkOnly: bool): bool {
  let readOk = true
  let src = readFile(path) catch e {
    eprint("bit fmt: cannot read ${path}\n")
    readOk = false
    ""
  }
  if (!readOk) {
    return true
  }
  let r = formatSource(path, src)
  if (r.failed) {
    eprint(r.text)
    return true
  }
  if (src == r.text) {
    return false
  }
  if (checkOnly) {
    eprint("${path}\n")
    return true
  }
  writeFile(path, r.text) catch e {
    eprint("bit fmt: cannot write ${path}\n")
    return true
  }
  return false
}

// A path's directory, or "." when it names a bare file in the cwd.
// "examples/hello.bit" -> "examples", "a.bit" -> ".". Mirrors the seed's
// `std.fs.path.dirname(src) orelse "."`.
fn pathDir(path: string): string {
  let b = []byte(path)
  let cut = -1
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(47)) { // '/'
      cut = i
    }
    i = i + 1
  }
  if (cut < 0) {
    return "."
  }
  if (cut == 0) {
    return "/" // a path rooted at "/" has "/" as its directory
  }
  return path[0:cut]
}

// A path's final component. "examples/hello.bit" -> "hello.bit".
fn pathBase(path: string): string {
  let b = []byte(path)
  let start = 0
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(47)) { // '/'
      start = i + 1
    }
    i = i + 1
  }
  return path[start:len(path)]
}

// The module name / default output: a path's basename without its extension.
// "examples/hello.bit" -> "hello", "a.bit" -> "a".
fn pathStem(path: string): string {
  let b = []byte(path)
  let start = 0
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(47)) { // '/'
      start = i + 1
    }
    i = i + 1
  }
  let end = len(b)
  i = start
  while (i < len(b)) {
    if (b[i] == u8(46)) { // '.'
      end = i
    }
    i = i + 1
  }
  return string(b[start:end])
}

// The directory-target default output (`stripTrailingSlashes`,
// `manifestProjectName`, `buildDirDefaultOut`) lives in buildout.bit — a
// sibling file, same module, #2260.

// Where `std/*` imports resolve (#1452), by the same three-step rule as
// libbitrtPath: an explicit override, then this binary's own install prefix,
// then the dev-tree cwd-relative default.
fn stdRootPath(): string {
  let override = envOr("BIT_STDLIB", "")
  if (len(override) > 0) {
    return override
  }
  let near = resolveNearExe("stdlib")
  if (len(near) > 0) {
    return near
  }
  return "stdlib"
}

// `rel` resolved against the install prefix inferred from this binary's OWN
// location, or "" when it is not there (#1452).
//
// This is what lets an unpacked release artifact work from any directory
// through a bare symlink into PATH, with no wrapper script and no environment
// variables — the shipped layout is `<prefix>/bin/bit` beside `<prefix>/stdlib`
// and `<prefix>/lib/<triple>/libbitrt.a`, so the prefix is the parent of the
// binary's directory. A flat unpack (everything beside the binary) is tried
// second.
//
// `selfExe()` resolving symlinks is the load-bearing part: an installer puts a
// symlink in PATH, and the SYMLINK's directory is not the install root. It also
// returns "" rather than guessing when the platform cannot say — `arg(0)` is
// not a fallback, being only whatever the caller passed.
//
// Probing rather than assuming is deliberate too: a build-tree `bit` sits at
// `bit-out/bin/bit`, where `../lib/<triple>/libbitrt.a` really does exist but
// `../stdlib` does not. Each path is answered on its own evidence, so the dev
// tree keeps working without a special case.
fn resolveNearExe(rel: string): string {
  let exe = selfExe()
  if (len(exe) == 0) {
    return ""
  }
  let binDir = pathDir(exe)
  let atPrefix = "${pathDir(binDir)}/${rel}"
  if (fsExists(atPrefix)) {
    return atPrefix
  }
  let beside = "${binDir}/${rel}"
  if (fsExists(beside)) {
    return beside
  }
  return ""
}
