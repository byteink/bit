// Self-host Stage 2 (#1339): the size-budgeted inlining pass. Split out of
// opt.bit (#1503).

// ponytail: size-budget heuristic — small leaf helpers only; retune once a real
// corpus shows the right number.
fn maxInlineInsts(): int {
  return 8
}

// How many levels of callee body one call site may absorb (#3163). Level 1 is
// the callee itself; level 2 is a call INSIDE that spliced body, and so on.
//
// This bound is what makes the pass terminate, and it is the only thing that
// does: `optimizeModule` resolves every callee out of a PRE-INLINING snapshot,
// so a recursive or mutually recursive cycle would otherwise splice forever —
// a call graph with a cycle has no callee-first order and no fixpoint to reach.
// A self-call is refused outright by inlineEligible's `calleeIdx == callerIdx`
// test, which also covers every cycle that runs back through the original
// caller; this bound covers the rest.
//
// 2 rather than 1: the runtime's collector reaches its word loads through
// exactly one intermediate helper (`loadWord` -> `wordAt`), which is the shape
// #3163 was filed for, and rather than 3 because the measured cost of the third
// level is code growth with nothing left to collapse — see the size numbers on
// that ticket. Growth is bounded by maxInlineInsts() per level, so the worst
// case a call site can absorb is maxInlineInsts()^maxInlineDepth() instructions.
fn maxInlineDepth(): int {
  return 2
}

// The index of the function named `name`, or -1. The seed keys calls by FuncId;
// selfhost resolves the callee name into `IrInstr.name`, so the lookup is here.
//
// Takes the function list rather than the module because the inliner must read
// callees out of a snapshot taken before this pass mutated anything (#3163),
// never out of the module it is halfway through rewriting.
fn funcIndexByName(funcs: []IrFunc, name: string): int {
  let i = 0
  while (i < len(funcs)) {
    if (funcs[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// A callee is inlinable when it is straight-line code under budget: exactly one
// block (no branches to re-target, so splicing needs no CFG surgery), terminated
// by a plain `ret` (not `unreachable`, so there is always a value to substitute),
// not fallible (keeps error propagation out of this pass), and not the caller
// itself (never inline a self-call). It must also not carry another module's
// MODULE STATE into this one — see importsForeignState (#1630) — and neither
// side may be @naked (#1636).
//
// §10.3.1 @naked is a codegen contract, not a hint: codegen emits NO prologue
// and NO epilogue, so the body is raw machine code that owns the frame itself
// and ends the call with its own `ret` (usually inside `asm volatile`).
// Splicing such a body into a caller is never correct in either direction:
//
//   - a naked CALLEE spliced into a normal caller drops that raw `ret` in the
//     middle of the caller, which then returns with its callee-saved registers
//     and link register never restored — a hang or a SIGSEGV with a perfectly
//     clean build, and every instruction after the call site left unreachable.
//     That was live: bit_rt_root_safepoint disappeared from every call site
//     (#1636), and it becomes universal at G2 (#1583), when the backends'
//     synthesized back-edge call starts reaching a naked shim.
//   - a normal callee spliced INTO a naked caller adds instructions to a
//     function that has no frame to spend: regalloc runs a naked function on a
//     reduced register set with zero spill slots, so extra pressure trips the
//     "no frame" assertion in both backends at best.
//
// The refusal is on the ATTRIBUTE, not on a cost heuristic — a naked body small
// enough to fit the budget is exactly the dangerous case.
//
// @nosplit is deliberately NOT refused. It only suppresses the BACK-EDGE
// safepoint (codegen.bit's needsNoSafepoints), and an inlinable callee is
// single-block straight-line code with no back edge — so splicing it neither
// introduces a poll into nosplit code nor removes one from a caller that keeps
// its own back edges. Refusing it would also disable inlining across the whole
// runtime, where §17.6 makes every function @nosplit.
//
// Both functions are read from `snap`, the pre-inlining snapshot (#3163): the
// budget must be spent against the callee's ORIGINAL body, or eligibility would
// depend on how much that callee had already absorbed by the time this caller
// was reached — which is exactly the filename-ordering bug.
fn inlineEligible(m: IrModule, snap: []IrFunc, callerIdx: int, calleeIdx: int): bool {
  if (calleeIdx < 0 || calleeIdx == callerIdx) {
    return false
  }
  let g = snap[calleeIdx]
  let f = snap[callerIdx]
  if (g.isNaked || f.isNaked) {
    return false
  }
  if (len(g.blocks) != 1 || g.isFallible) {
    return false
  }
  if (importsForeignState(m, f, g)) {
    return false
  }
  let b = g.blocks[0]
  if (g.instrs[b.instsStart + b.instsLen - 1].op != Op.Ret) {
    return false
  }
  return b.instsLen - b.paramCount - 1 <= maxInlineInsts()
}

// True if splicing `callee` into `caller` would move a reference to a module
// cell across a module boundary (#1630). Mirrors the seed's importsForeignState.
//
// §11.11 state is a per-module cell, and §17.6 gives each module its OWN object:
// the cell is defined by that object and by no other. Inlining is the one thing
// that can put a GlobalAddr naming module M's cell inside code emitted as module
// N's — and then N's object either re-defines M's cell (two cells, one logical
// global, each module updating its own — silent, unbounded wrongness with no
// diagnostic at any stage) or leaves a dangling reference under a name M's own
// object does not use. That was live: the inliner spliced runtime/root's pinned
// rootBindMemory into runtime/root/darwin's boot, so the two objects held
// separate gcAddr and gcState cells and the collector booted against the wrong
// one.
//
// Refused unconditionally rather than only under --freestanding, so the managed
// and freestanding lowerings of one program cannot disagree about which cell a
// function touches. The cost is one un-inlined call in a cross-module helper
// that reads module state.
//
// The comparison is over inRootModule because that is the module identity the IR
// carries. It is coarse — two distinct imported modules both read as "not root"
// — but it composes: a splice into a non-root caller leaves a non-root global
// reference behind, which this then refuses to carry into any root caller.
fn importsForeignState(m: IrModule, caller: IrFunc, callee: IrFunc): bool {
  let i = 0
  while (i < len(callee.instrs)) {
    let ins = callee.instrs[i]
    if (ins.op == Op.GlobalAddr) {
      let gi = 0
      while (gi < len(m.globals)) {
        if (m.globals[gi].name == ins.name &&
            m.globals[gi].inRootModule != caller.inRootModule) {
          return true
        }
        gi = gi + 1
      }
    }
    i = i + 1
  }
  return false
}

// Splices `g`'s single block into `b`'s currently open block: `g`'s params bind
// directly to the already-translated call `args`, its body is emitted in place
// (no folding, no block retargeting — `g` has exactly one block and its only
// terminator is the `ret`, which is read separately rather than spliced).
// Returns the value the call site now yields.
//
// `depth` is how many callee bodies deep this splice already is (1 for a call
// written in the caller's own source). A `Call` inside `g` is spliced too, up
// to maxInlineDepth() (#3163) — without that, the instructions this function
// emits would never be re-examined by anyone: `inlineCalls` walks the OLD
// function's instruction list, so a call carried in on a spliced body used to
// survive to codegen no matter how trivial its callee was.
//
// `callerIdx` stays the ORIGINAL caller at every level, because that is who the
// instructions end up belonging to: it is the function inlineEligible must test
// for self-inlining and whose module identity importsForeignState must compare
// a nested callee's globals against.
fn spliceCallee(b: IrBuilder, m: IrModule, snap: []IrFunc, callerIdx: int,
  g: IrFunc, args: []int, depth: int): int {
  let blk = g.blocks[0]
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(g.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    i = i + 1
  }
  // Never indexed: inlineEligible guarantees the only terminator is the `ret`
  // excluded below, so no jump/br inside the spliced range reads this.
  let dummyBlockMap = [0]
  let idx = blk.instsStart
  let paramsEnd = blk.instsStart + blk.paramCount
  let p = 0
  while (idx < paramsEnd) {
    remap[idx] = args[p]
    p = p + 1
    idx = idx + 1
  }
  let last = blk.instsStart + blk.instsLen - 1
  while (idx < last) {
    let ins = g.instrs[idx]
    let spliced = false
    if (ins.op == Op.Call && depth < maxInlineDepth()) {
      let calleeIdx = funcIndexByName(snap, ins.name)
      if (inlineEligible(m, snap, callerIdx, calleeIdx)) {
        remap[idx] = spliceCallee(b, m, snap, callerIdx, snap[calleeIdx],
          trList(remap, ins.args), depth + 1)
        spliced = true
      }
    }
    if (!spliced) {
      emitTranslated(b, g, noFold, remap, dummyBlockMap, idx)
    }
    idx = idx + 1
  }
  let ret = g.instrs[last]
  if (len(ret.args) == 0) {
    return 0 // void callee: the result is never a usable value, never read
  }
  return remap[ret.args[0]]
}

// Pass 3: simple size-budgeted inlining. Blocks are walked in id order, which is
// emission order here — every preceding pass rebuilds with ids assigned in
// ascending instsStart.
//
// `snap` is the whole module's functions as they stood before ANY of them was
// inlined, and every callee — at this level and at every nested level — is read
// out of it (#3163). Reading them out of `m` instead made the result depend on
// the caller's and callee's relative INDEX, which is their file's position in
// the module's bytewise-sorted file list (compiler/project.bit:7): a callee
// whose file sorted earlier had already been flattened and handed the caller a
// flat body, while a callee whose file sorted later still held its own calls,
// which then survived to codegen. Identical source, renamed files, different
// machine code — 30 un-inlined `wordAt` calls in the collector's mark and sweep
// paths, purely because `gcmark.bit` sorts before `mem.bit`.
fn inlineCalls(m: IrModule, snap: []IrFunc, fidx: int): IrFunc {
  let f = snap[fidx]
  let n = len(f.blocks)
  let blockMap = []int(0)
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    i = i + 1
  }
  let b = newBuilder()
  i = 0
  while (i < n) {
    blockMap = append(blockMap, builderNewBlock(b))
    i = i + 1
  }
  let bi = 0
  while (bi < n) {
    let blk = f.blocks[bi]
    builderBeginBlock(b, blockMap[bi])
    let idx = blk.instsStart
    let paramsEnd = blk.instsStart + blk.paramCount
    while (idx < paramsEnd) {
      remap[idx] = builderAddParam(b, f.instrs[idx].ty)
      idx = idx + 1
    }
    let end = blk.instsStart + blk.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      let handled = false
      if (ins.op == Op.Call) {
        let calleeIdx = funcIndexByName(snap, ins.name)
        if (inlineEligible(m, snap, fidx, calleeIdx)) {
          remap[idx] = spliceCallee(b, m, snap, fidx, snap[calleeIdx],
            trList(remap, ins.args), 1)
          handled = true
        }
      }
      if (!handled) {
        emitTranslated(b, f, noFold, remap, blockMap, idx)
      }
      idx = idx + 1
    }
    builderEndBlock(b)
    bi = bi + 1
  }
  return IrFunc{ name: f.name, paramTypes: f.paramTypes, result: f.result,
    blocks: b.blocks, instrs: b.instrs, isFallible: f.isFallible,
    isNaked: f.isNaked, isNosplit: f.isNosplit,
    // §17.6: carry the module tag across the rebuild. Every pass here builds a
    // fresh IrFunc, and a field left off a literal zero-fills — so omitting
    // this would silently mark the function "not mine" and drop it from a
    // freestanding object. The seed gates the same invariant with a unit test.
    // §11.9: the pin flag rides the same rebuild and has the same failure mode —
    // losing it makes a runtime entry point LOCAL and fails the link loudly.
    inRootModule: f.inRootModule, isPinned: f.isPinned }
}
