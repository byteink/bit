// Self-host Stage 2 (#1339): the size-budgeted inlining pass — the TRANSFORM
// half. Split out of opt.bit (#1503); the DECISION half (budgets, shape rules,
// cross-module refusals, the emitted-cost model and `inlineEligible`) is
// optinlinecost.bit (#4574), which grew past what one file may hold.
//
// The seam is "how a splice is performed" here against "which callee may be
// spliced, and what it costs" there. `splicedNestedIdx` (optinlinecost.bit) is
// the one function on it: `spliceNested` below asks it whether a call will be
// replaced, and the cost model asks the SAME function the same question, so a
// budget can never be spent against a shape the splicer would not produce.

// What one `inlineCalls` run never changes: the builder every block is emitted
// into, the module and the pre-inlining snapshot eligibility is judged against,
// and the ORIGINAL caller's index. `callerIdx` stays the original caller at
// every nesting level because that is who the instructions end up belonging
// to: it is the function inlineEligible must test for self-inlining, and whose
// module identity importsForeignState compares a nested callee's globals
// against.
class InlineCtx {
  b: IrBuilder,
  m: IrModule,
  snap: []IrFunc,
  callerIdx: int,
}

// The per-function tables a walk translates through: `remap` old value id ->
// new, `noFold` the neutral constant map emitTranslated needs (this pass folds
// nothing), `blockMap` old block id -> the builder block minted for it.
//
// `join` is the block every `ret` jumps to, and the block the caller goes on
// emitting into once the splice is done. It is -1 for the CALLER's own state
// and for a single-block callee, and `spliceTerm` reads that as "this
// function's `ret`s are real `ret`s" — one flag instead of two walks.
class SpliceState {
  remap: []int,
  noFold: []ConstVal,
  blockMap: []int,
  join: int,
  // #4405: instruction slots a splice has already consumed and bound — the
  // `Op.CallWord` run of a spliced call. `spliceBlockBody` walks slots one at a
  // time, so without this the words would ALSO be emitted as ordinary
  // instructions, naming a call that the splice replaced.
  done: []bool,
}

// `remap` and `noFold` sized to `g`, with no block mapped yet.
fn newSpliceState(g: IrFunc): SpliceState {
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let done = []bool(0)
  let i = 0
  while (i < len(g.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    done = append(done, false)
    i = i + 1
  }
  return SpliceState{
    remap: remap, noFold: noFold, blockMap: []int(0), join: -1, done: done,
  }
}

// The caller's own state: one fresh builder block per block of `f`, reserved up
// front and in order, so the caller's ids ascend with its linear schedule and a
// forward `jump`/`br` target is already mapped when its terminator is emitted.
fn callerState(ic: InlineCtx, f: IrFunc): SpliceState {
  let st = newSpliceState(f)
  let i = 0
  while (i < len(f.blocks)) {
    st.blockMap = append(st.blockMap, builderNewBlock(ic.b))
    i = i + 1
  }
  return st
}

// A callee's state. The ENTRY block is merged into the caller's currently-open
// block — its params bind straight to the call's arguments and its body
// continues where the call was — so it gets no block of its own; -1 rather than
// 0 so a stray read crashes instead of silently branching to the caller's
// entry. calleeShapeOk refuses any edge back to block 0, so nothing reads it.
//
// Every other block gets one, and a multi-block callee gets the join block its
// `ret`s jump to. These ids do NOT ascend with the linear schedule — they are
// minted mid-block and land after every caller block — and that is safe for the
// same reason optappend.bit's are: `optimizeModule` runs `foldConstantsAndPrune`
// after this pass, and its `rebuild` renumbers blocks into `blockEmissionOrder`,
// which is the invariant `isBackEdge` and the x64 interval numbering assume.
// optloop.bit already handles un-renumbered input explicitly (its `lc.pos` is
// computed from `blockEmissionOrder`, not from the raw ids) and refuses rather
// than mis-detects. Do not move this pass after that fold.
fn calleeState(ic: InlineCtx, g: IrFunc): SpliceState {
  let st = newSpliceState(g)
  st.blockMap = append(st.blockMap, -1)
  let i = 1
  while (i < len(g.blocks)) {
    st.blockMap = append(st.blockMap, builderNewBlock(ic.b))
    i = i + 1
  }
  if (len(g.blocks) > 1) {
    st.join = builderNewBlock(ic.b)
  }
  return st
}

// Emits block `bi`'s params as params of the currently open builder block.
fn spliceBlockParams(ic: InlineCtx, g: IrFunc, st: SpliceState, bi: int) {
  let blk = g.blocks[bi]
  let i = 0
  while (i < blk.paramCount) {
    let p = blk.instsStart + i
    st.remap[p] = builderAddParam(ic.b, g.instrs[p].ty)
    i = i + 1
  }
}

// True if instruction `idx` of `g` was an eligible `Call` and was spliced in
// place of being emitted. `depth` is how many callee bodies deep the splice
// already is (0 for a call written in the caller's own source), bounded by
// maxInlineDepth() (#3163) — without that bound the instructions a splice emits
// would never be re-examined by anyone, since `inlineCalls` walks the OLD
// function's instruction list and a call carried in on a spliced body would
// survive to codegen no matter how trivial its callee was.
fn spliceNested(
  ic: InlineCtx, g: IrFunc, st: SpliceState, idx: int, depth: int,
): bool {
  // #4405: a word of a call the splice already replaced. Nothing to emit — its
  // value was bound with the call's.
  if (st.done[idx]) {
    return true
  }
  // #4574: the op test, the depth bound, the name lookup, the eligibility test
  // and the return-width test all live in `splicedNestedIdx`
  // (optinlinecost.bit), because the COST MODEL has to ask the identical
  // question and a second copy of it would go stale against this one.
  let calleeIdx = splicedNestedIdx(ic, g, idx, depth)
  if (calleeIdx < 0) {
    return false
  }
  bindSplicedResult(
    st, g, idx,
    spliceCallee(
      ic, ic.snap[calleeIdx], trList(st.remap, g.instrs[idx].args), depth + 1,
    ),
  )
  return true
}

// Whether the call at `idx` and the callee it names agree about how many
// values come back. The two facts are derived independently — the call site's
// from its `Op.CallWord` run, the callee's from its own `ret` — so a splice is
// DECLINED rather than trusted when they disagree, the same refusal shape as
// the parameter-count one in `inlineEligible`. Clamping instead would bind a
// result word to a value that does not exist.
//
// A void callee returns no values against a width-1 call site, and that is the
// ordinary case rather than a mismatch: the call's result is simply never
// read. So the widths are compared only once either side is above one.
fn retWidthAgrees(g: IrFunc, idx: int, callee: IrFunc): bool {
  let w = callWordRunLen(g, idx)
  let rets = len(calleeRetArgs(callee))
  if (w == 1 && rets <= 1) {
    return true
  }
  return w == rets
}

// Binds a spliced call's result words. A W-word call occupies W instruction
// slots — the `Op.Call` and its `Op.CallWord` run — and the splice replaces
// all of them: word k becomes the k-th value the callee's `ret` carried, which
// `spliceCallee` delivers as the join block's k-th parameter (or, for a
// single-block callee, as the returned value itself).
fn bindSplicedResult(st: SpliceState, g: IrFunc, idx: int, vals: []int) {
  st.remap[idx] = vals[0]
  let w = callWordRunLen(g, idx)
  let k = 1
  while (k < w) {
    st.remap[idx + k] = vals[k]
    st.done[idx + k] = true
    k = k + 1
  }
}

// Emits block `bi`'s body — everything after its params and before its
// terminator — into the currently open builder block, splicing an eligible
// call rather than emitting it.
fn spliceBlockBody(
  ic: InlineCtx, g: IrFunc, st: SpliceState, bi: int, depth: int,
) {
  let blk = g.blocks[bi]
  let idx = blk.instsStart + blk.paramCount
  let last = blk.instsStart + blk.instsLen - 1
  while (idx < last) {
    if (!spliceNested(ic, g, st, idx, depth)) {
      emitTranslated(ic.b, g, st.noFold, st.remap, st.blockMap, idx)
    }
    idx = idx + 1
  }
}

// Emits block `bi`'s terminator into the currently open builder block.
//
// In a spliced callee (`st.join >= 0`) a `ret` is not a `ret` any more: it is
// the edge that carries the callee's result out to the one block the caller
// resumes in, so it becomes `jump join(v)` and the value arrives as the join
// block's param. Every other terminator — and every terminator of the caller
// itself, which has no join block — is translated like any other instruction,
// through `st.blockMap`.
fn spliceTerm(ic: InlineCtx, g: IrFunc, st: SpliceState, bi: int) {
  let blk = g.blocks[bi]
  let last = blk.instsStart + blk.instsLen - 1
  let t = g.instrs[last]
  if (t.op != Op.Ret || st.join < 0) {
    emitTranslated(ic.b, g, st.noFold, st.remap, st.blockMap, last)
    return
  }
  let j = mkInstr(Op.Jump, t.ty)
  j.ival = st.join
  j.args = trList(st.remap, t.args)
  // #3282: the jump stands in for this `ret`, so it keeps the `ret`'s span.
  j.span = t.span
  builderEmit(ic.b, j)
}

// The result the join block must carry: the `ret` args of `g`'s first returning
// block. calleeShapeOk guarantees there is one. Read off the IR rather than
// from `g.result` so the join param's type is literally the type of a value the
// callee returns, with no assumption about how a void result is spelled.
fn calleeRetArgs(g: IrFunc): []int {
  let i = 0
  while (i < len(g.blocks)) {
    let blk = g.blocks[i]
    let t = g.instrs[blk.instsStart + blk.instsLen - 1]
    if (t.op == Op.Ret) {
      return t.args
    }
    i = i + 1
  }
  return []int(0)
}

// Splices `g` into the builder's currently open block and returns the values
// the call site now yields — one per value the callee's `ret` carries, so a
// W-word result (#4405) comes back as W ids and a void callee as the single
// unusable 0 it always did.
//
// A SINGLE-BLOCK callee is emitted straight into the open block: its params
// bind to the already-translated `args`, its body follows the call site's own
// instructions, and its `ret` is READ rather than emitted — the caller's block
// is never closed and nothing about the CFG changes. That path is unchanged
// from before #4344 and is kept separate on purpose: it is the overwhelming
// majority of splices, and giving it a join block would cost every one of them
// a block and a jump for a value that is already in hand.
//
// A MULTI-BLOCK callee closes the caller's block with the entry block's own
// terminator, emits the rest of the callee's blocks, then opens the join block
// and leaves it open — so the caller resumes there and its next instruction
// lands in the join block, exactly as if the call had returned. Every `ret`
// becomes an edge into that block (`spliceTerm`) and the result arrives as its
// block param, which is how a `ret` on two different paths stays one value
// without any phi construction of our own.
fn spliceCallee(ic: InlineCtx, g: IrFunc, args: []int, depth: int): []int {
  let st = calleeState(ic, g)
  let blk = g.blocks[0]
  let i = 0
  while (i < blk.paramCount) {
    st.remap[blk.instsStart + i] = args[i]
    i = i + 1
  }
  spliceBlockBody(ic, g, st, 0, depth)
  if (st.join < 0) {
    // #4406: the callee's keepalive edges, translated into the caller's value
    // space. Recorded on both exits rather than once at the top, because
    // `st.remap` is only complete after the blocks this path splices.
    builderAddKeepAlive(ic.b, g.keepAlive, st.remap)
    let ret = g.instrs[blk.instsStart + blk.instsLen - 1]
    if (len(ret.args) == 0) {
      return [0] // void callee: the result is never a usable value, never read
    }
    return trList(st.remap, ret.args)
  }
  spliceTerm(ic, g, st, 0)
  builderEndBlock(ic.b)
  let bi = 1
  while (bi < len(g.blocks)) {
    builderBeginBlock(ic.b, st.blockMap[bi])
    spliceBlockParams(ic, g, st, bi)
    spliceBlockBody(ic, g, st, bi, depth)
    spliceTerm(ic, g, st, bi)
    builderEndBlock(ic.b)
    bi = bi + 1
  }
  builderBeginBlock(ic.b, st.join)
  builderAddKeepAlive(ic.b, g.keepAlive, st.remap)
  let retArgs = calleeRetArgs(g)
  if (len(retArgs) == 0) {
    return [0] // void callee: the result is never a usable value, never read
  }
  // #4400: one join-block param PER ret arg, not just the first. `spliceTerm`
  // passes every one of `t.args` on the `jump join(...)` it builds from each
  // `ret`, so the join block must declare the same count or the jump carries
  // more arguments than the block has parameters to receive them — malformed
  // IR that arm64call.bit's `blockArgMoves` does not detect (it indexes an
  // edge's arguments by POSITION with no bound check against the target's
  // paramCount) and that therefore codegens "correctly" purely by landing on
  // whatever instruction slot happens to sit at the right offset. Builder
  // param ids are minted in call order (builderAddParam -> builderEmit
  // appends), so this reproduces exactly the id sequence blockArgMoves
  // expects: the first param is followed immediately by one more per remaining
  // ret arg. #4405 returns all of them rather than only the first, because a
  // multi-word call site has an instruction slot to bind for each.
  let words = [builderAddParam(ic.b, g.instrs[retArgs[0]].ty)]
  let ri = 1
  while (ri < len(retArgs)) {
    words = append(words, builderAddParam(ic.b, g.instrs[retArgs[ri]].ty))
    ri = ri + 1
  }
  return words
}

// Pass 3: simple size-budgeted inlining. Blocks are walked in id order, which is
// emission order here — every preceding pass rebuilds with ids assigned in
// ascending instsStart.
//
// `snap` is the whole module's functions as they stood before ANY of them was
// inlined, and every callee — at this level and at every nested level — is read
// out of it (#3163). Reading them out of `m` instead made the result depend on
// the caller's and callee's relative INDEX, which is their file's position in
// the module's bytewise-sorted file list (compiler/project.bit:7): a callee
// whose file sorted earlier had already been flattened and handed the caller a
// flat body, while a callee whose file sorted later still held its own calls,
// which then survived to codegen. Identical source, renamed files, different
// machine code — 30 un-inlined `wordAt` calls in the collector's mark and sweep
// paths, purely because `gcmark.bit` sorts before `mem.bit`.
//
// The caller is walked with the same three steps a spliced callee's blocks are
// (`spliceBlockParams`/`spliceBlockBody`/`spliceTerm`) rather than a second
// copy of them: `st.join < 0` is the whole difference, and a fix applied to one
// copy does not reach the other.
fn inlineCalls(m: IrModule, snap: []IrFunc, fidx: int): IrFunc {
  let f = snap[fidx]
  let b = newBuilder()
  let ic = InlineCtx{ b: b, m: m, snap: snap, callerIdx: fidx }
  let st = callerState(ic, f)
  let bi = 0
  while (bi < len(f.blocks)) {
    builderBeginBlock(b, st.blockMap[bi])
    spliceBlockParams(ic, f, st, bi)
    spliceBlockBody(ic, f, st, bi, 0)
    spliceTerm(ic, f, st, bi)
    builderEndBlock(b)
    bi = bi + 1
  }
  builderAddKeepAlive(b, f.keepAlive, st.remap)
  return IrFunc{
    name: f.name, paramTypes: f.paramTypes, result: f.result,
    blocks: b.blocks, instrs: b.instrs, isFallible: f.isFallible,
    isNaked: f.isNaked, isNosplit: f.isNosplit,
    // §17.6: carry the module tag across the rebuild. Every pass here builds a
    // fresh IrFunc, and a field left off a literal zero-fills — so omitting
    // this would silently mark the function "not mine" and drop it from a
    // freestanding object. The seed gates the same invariant with a unit test.
    // §11.9: the pin flag rides the same rebuild and has the same failure mode —
    // losing it makes a runtime entry point LOCAL and fails the link loudly.
    inRootModule: f.inRootModule, isPinned: f.isPinned,
    // #4406: the caller's own edges, plus every spliced callee's, which
    // `spliceCallee` has been appending to this builder as it went.
    keepAlive: b.keepAlive,
  }
}
