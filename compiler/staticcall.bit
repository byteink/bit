// compiler/staticcall.bit — a static method called through the BARE name of a
// generic class (`Pair.make(7, "s")`, `Pair.tag(1, "x")`, SPEC §10.4.1, §15.3),
// sibling of classinit.bit (same module, no imports).
//
// A generic class's methods are emitted per INSTANTIATION
// (`lowerMethodInstances`, lowerinstemit.bit), so a call resolved to the bare
// template names a `make$t<template>` symbol nothing defines. The receiver a
// bare-name call names is therefore decided in one place, `staticCallReceiver`,
// which the checker (`checkMemberCallResult`, `recordMethodInstantiation`), the
// validator (`vStaticNamedArgs`, `vMethodCall`) and the lowerer
// (`lowerStaticReceiverType`) all ask, so they cannot name different types:
//
//   - the method mentions a class type parameter and the call's arguments bind
//     every one: the INSTANTIATION they name (`Pair.make(7, "s")` is
//     `Pair<i64, string>.make`), by the binder a generic free call uses;
//   - the method mentions none (`static tag(n: i64): string`): its one body is
//     independent of the instantiation, so it is emitted once on the template
//     itself (`templateStatics`, types.bit) and the call names that;
//   - otherwise a parameter nothing binds is E0068 naming it
//     (`vStaticCallGap`), never an undefined symbol at link time.

// Whether `ut` is a generic class's (or, #6403, a generic enum's) own template:
// a struct or enum that declares type parameters and is not already an
// instantiation (`type IP = Pair<i64, i64>`).
fn isGenericClassTemplate(c: Checker, ut: int): bool {
  if (ut == 0 || !hasStaticMethods(c.ctx.types[ut].kind)) {
    return false
  }
  return structTypeParamCount(c, ut) > 0 && typeInstOfResult(c.ctx, ut) < 0
}

// The class type arguments static call `node` (`Class.mname(...)`) infers from
// its arguments, one per class type parameter in declaration order, 0 where no
// argument binds it: `bindTypeParamAtCall` (checkgeneric.bit) against the static
// method's own parameter list, as `inferInitTypeArgs` does for `init`.
fn inferStaticClassArgs(c: Checker, node: int, ut: int, mname: string): []int {
  let out = []int(0)
  let fr = methodRefAt(c, ut, mname)
  if (fr.decl == 0) {
    return out
  }
  let oc = fr.owner
  let names = declTypeParamNames(oc, fr.decl, structTypeParamCount(c, ut))
  let params = kidsOf(oc.tree, kidsOf(oc.tree, fr.decl)[3])
  let i = 0
  while (i < len(names)) {
    out = append(out, bindTypeParamAtCall(oc, c, node, params, names[i]))
    i = i + 1
  }
  return out
}

// Whether static method `mname` of generic class `ut` mentions none of the
// class's type parameters, nor `Self` (which is the class at its own
// parameters), in its parameters, result or body: its one body then does not
// depend on the instantiation. A name match anywhere in those subtrees counts,
// so a local that happens to share a parameter's name is only a missed
// opportunity (E0068 asks for the written form), never an unsound emission.
fn staticTemplateCallee(c: Checker, ut: int, mname: string): bool {
  let fr = methodRefAt(c, ut, mname)
  if (fr.decl == 0) {
    return false
  }
  let oc = fr.owner
  let names = declTypeParamNames(oc, fr.decl, structTypeParamCount(c, ut))
  names = append(names, "Self")
  let dk = kidsOf(oc.tree, fr.decl)
  return !typeNodeMentionsAny(oc, dk[3], names) &&
    !typeNodeMentionsAny(oc, dk[4], names) &&
    !typeNodeMentionsAny(oc, dk[5], names)
}

// The index of the first 0 in `targs`, or -1.
fn firstUnbound(targs: []int): int {
  let i = 0
  while (i < len(targs)) {
    if (targs[i] == 0) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The type call `node`'s static receiver `recv` names: `staticReceiverType`
// (checkexprcall.bit), except that a bare generic class name whose static
// method's arguments bind every class type parameter names the INSTANTIATION
// they bind. A class whose arguments leave a parameter unbound stays the
// template: emitted once when the method is independent of it
// (`staticTemplateCallee`), E0068 otherwise (`vStaticCallGap`).
fn staticCallReceiver(c: Checker, node: int, recv: int): int {
  let mname = staticCallMethodName(c, node)
  let sst = staticReceiverType(c, recv, mname)
  let tag = getNode(c.tree, recv).tag
  // A class reached through a namespace (`m.G.make(1)`) is never instantiated
  // from its arguments: `instantiateNamed` keys a template by the name its
  // declaring module spells, and `qual_type_name` takes no type arguments
  // (SPEC §11), so the bare template is all there is to name.
  // `vStaticCallGap` refuses the call whenever the method needs the class's
  // parameters.
  if (tag == Tag.GenericInst || tag == Tag.Member || !isGenericClassTemplate(c, sst)) {
    return sst
  }
  if (!staticMethodLookup(c, "${sst}.${mname}")) {
    return sst
  }
  let targs = inferStaticClassArgs(c, node, sst, mname)
  if (firstUnbound(targs) >= 0) {
    return sst
  }
  let inst = instantiateNamed(c, typeNodeName(c, recv), targs)
  if (inst == 0) {
    return sst
  }
  return inst
}

// The method name of call `node`, whose callee is `recv.name`.
fn staticCallMethodName(c: Checker, node: int): string {
  let mn = getNode(c.tree, kidsOf(c.tree, kidsOf(c.tree, node)[0])[1])
  return c.source[mn.span.start:mn.span.end]
}

// E0068 for `Pair.blank(1)`, a static called through a generic class's bare name
// whose arguments leave a class type parameter unbound while the method depends
// on the parameters. Nothing names the instantiation, so the call would name the
// TEMPLATE's symbol, which no one emits: the checker must refuse it rather than
// accept a program the backend cannot link. An argument the checker could not
// type is silence, not a diagnostic (`vGenericGap`'s safety rule).
fn vStaticCallGap(c: Checker, node: int, recv: int) {
  let mname = staticCallMethodName(c, node)
  let sst = staticReceiverType(c, recv, mname)
  if (getNode(c.tree, recv).tag == Tag.GenericInst || !isGenericClassTemplate(c, sst)) {
    return
  }
  if (!staticMethodLookup(c, "${sst}.${mname}") || staticTemplateCallee(c, sst, mname)) {
    return
  }
  let fr = methodRefAt(c, sst, mname)
  let names = declTypeParamNames(fr.owner, fr.decl, structTypeParamCount(c, sst))
  if (getNode(c.tree, recv).tag == Tag.Member) {
    vNsGenericStatic(c, node, recv, mname, names)
    return
  }
  let gap = firstUnbound(inferStaticClassArgs(c, node, sst, mname))
  if (gap < 0 || !vCallArgTypesKnown(c, node)) {
    return
  }
  let cls = typeNodeName(c, recv)
  reportNoHint(
    c.diags, ecCannotInfer, vSpan(c, node),
    "cannot infer type parameter '${names[gap]}' of '${cls}'; write ${cls}<${commaList(names)}>.${mname}(...)",
  )
}

// E0068 for `m.G.make(1)`, a static that depends on its class's type
// parameters, called on a generic class reached through a namespace import.
// `qual_type_name` takes no type arguments (SPEC §11), so the instantiation the
// call needs cannot be written or inferred through `m`: the call would name the
// template's symbol, which no one emits. The class imported by name takes them.
// Reported whatever the argument types are — the refusal does not depend on
// them, and silence here would be an undefined symbol at link time.
fn vNsGenericStatic(c: Checker, node: int, recv: int, mname: string, names: []string) {
  let qn = staticRecvName(c, recv)
  let cls = nodeText(c.tree, c.source, kidsOf(c.tree, recv)[1])
  reportNoHint(
    c.diags, ecCannotInfer, vSpan(c, node),
    "cannot instantiate generic class '${qn}' through its namespace; import it by name and write ${cls}<${commaList(names)}>.${mname}(...)",
  )
}

// Records that static `mname` of `recvTy` is called on the template itself: a
// generic class reached through its bare name whose arguments bound nothing the
// method depends on. `lowerModuleMethods` (lowerinstemit.bit) then emits its one
// body under the template's symbol. A call through an instantiation records
// nothing: that body is emitted per instantiation already.
fn noteTemplateStaticCall(c: Checker, recvTy: int, mname: string) {
  if (isGenericClassTemplate(c, recvTy)) {
    c.ctx.templateStatics["${recvTy}.${mname}"] = true
  }
}

// The receiver's half of a generic method's merged type-argument list
// (`methodTypeArgsRaw`, checkproject.bit): the nominal arguments of `recvTy`,
// except for a static method of a generic class's TEMPLATE that depends on none
// of the class's parameters (`static own<U>(u: U)` called as `Pair.own("s")`).
// The template's own arguments are its rigid parameters, which no ledger entry
// may name, and this method's body ignores the class half, so each is void, the
// same filler `methodTypeArgs` puts in any position nothing binds.
fn recvHalfArgs(c: Checker, oc: Checker, decl: int, recvTy: int, nrecv: int): []int {
  let mn = getNode(oc.tree, kidsOf(oc.tree, decl)[1])
  let mname = oc.source[mn.span.start:mn.span.end]
  let free = staticMethodLookup(c, "${recvTy}.${mname}") &&
    isGenericClassTemplate(c, recvTy) &&
    staticTemplateCallee(c, recvTy, mname)
  if (!free) {
    return nominalArgsOf(c, recvTy)
  }
  let out = []int(0)
  let i = 0
  while (i < nrecv) {
    out = append(out, c.ctx.voidId)
    i = i + 1
  }
  return out
}
