fn peWriteSections(obj: PeObject, present: []bool, byKind: []PeSection): ()! {
  let si = 0
  while (si < len(obj.sections)) {
    let s = obj.sections[si]
    let idx = peKindIndex(s.kind)
    if (present[idx]) {
      fail newError("DuplicateSection")
    }
    if (s.alignment != 0 && (!isPowerOfTwo(s.alignment) || s.alignment > 8192)) {
      fail newError("InvalidSectionAlignment")
    }
    present[idx] = true
    byKind[idx] = s
    si = si + 1
  }
}

fn peWriteSymbolIndex(obj: PeObject, present: []bool, byKind: []PeSection): map<string, int>! {
  let symIdx = map<string, int>{}
  let yi = 0
  while (yi < len(obj.symbols)) {
    let sym = obj.symbols[yi]
    if (!sym.hasSection && sym.binding == PeBinding.Local) {
      fail newError("UndefinedLocalSymbol")
    }
    if (sym.hasSection) {
      let kidx = peKindIndex(sym.section)
      if (!present[kidx]) {
        fail newError("SectionNotPresent")
      }
      if (sym.offset + sym.size > peSectionBytes(byKind[kidx])) {
        fail newError("SymbolOutOfBounds")
      }
    }
    let (_, dup) = symIdx[sym.name]
    if (dup) {
      fail newError("DuplicateSymbol")
    }
    symIdx[sym.name] = yi
    yi = yi + 1
  }
  return symIdx
}

fn peWriteRelocCounts(
  target: PeTarget,
  obj: PeObject,
  sections: ([]bool, []PeSection),
  symIdx: map<string, int>,
  relocCount: []int,
): ()! {
  let (present, byKind) = sections
  let ri = 0
  while (ri < len(obj.relocations)) {
    let r = obj.relocations[ri]
    let kidx = peKindIndex(r.section)
    if (!present[kidx]) {
      fail newError("SectionNotPresent")
    }
    if (r.offset + peRelocWidth(r.kind) > peSectionBytes(byKind[kidx])) {
      fail newError("RelocOutOfBounds")
    }
    if (peRelocType(r.kind, target) < 0) {
      fail newError("RelocKindUnsupportedForTarget")
    }
    // #5198: the two-result index form, not a scan of `obj.symbols`. The
    // symbol loop above enters every symbol into `symIdx` under its own index
    // and rejects a repeated name, so membership in `symIdx` is exactly
    // membership in `obj.symbols`. The scan made writing an object O(R*S) in
    // its own relocation and symbol counts; the relocation emission below
    // already reads this same map by hash.
    let (_, known) = symIdx[r.symbol]
    if (!known) {
      fail newError("UnknownSymbol")
    }
    relocCount[kidx] = relocCount[kidx] + 1
    ri = ri + 1
  }
}

