// compiler/classjsonappend.bit — `__jsonAppend(out: []byte): []byte`, `@json`'s
// direct byte-encoder (#5991, #5961 item 1).
//
// classjson.bit decides WHICH classes and fields are `@json`; classjsonbuild.bit
// builds `toJson`'s `Json` VALUE tree. This builds the SAME bytes `jsonEncode`
// renders from that tree, straight into a `[]byte` accumulator, through the
// `jsonAppend*` helpers std/json's encode.bit exports (#5978) — no `Json` node
// is ever allocated. Field order, key text, `@key` overrides and every
// conversion (`i64(...)`/`f64(...)`, an absent `Option` as an explicit
// `null`, `[]T` and `map<string, T>` walked in declaration/iteration order)
// are the same rules `synthToJson` follows, off the same `JsonClass`/
// `JsonField` classjson.bit already validated — there is no second judgment
// of what a field IS, only a second way to WRITE it. A nested `@json` field
// calls its own `__jsonAppend`, which self-delimits with its own `{`/`}`.
//
// `synthToJson` keeps shipping unconditionally; this adds a SECOND
// synthesized member beside it. A module with no `@json` class is
// byte-identical to before this file existed — no word is appended to the
// module's source, no node is spliced in, unless the module has a `@json`
// class.
//
// FIRST-ENTRY COMMAS NEED NO STATE AT THE TOP LEVEL. `jsonAppendKey`'s
// `first` argument is a compile-time constant, `f.index == 0` — the class's
// OWN fields are a fixed list in declaration order, so which one is first is
// known before any code runs. Only the two DYNAMIC-length container shapes
// (`[]T`, `map<string, T>`) need a runtime flag, because their element count
// is not known until the loop runs.

const jaOutWord = "out"
const jaBraceOpen = "'{'"
const jaBraceClose = "'}'"
const jaBracketOpen = "'['"
const jaBracketClose = "']'"
const jaComma = "','"

// std/json/encode.bit's byte-append helpers (#5978), listed once — the words
// the module source needs and the items the synthesized import binds, same
// reasoning `jsonDecHelperNames` (classjsondecode.bit) gives for its own list.
fn jsonAppendHelperNames(): []string {
  return [
    "jsonAppendKey", "jsonAppendString", "jsonAppendInt", "jsonAppendFloat",
    "jsonAppendBool", "jsonAppendNull", "jsonAppendRaw",
  ]
}

// The runtime "have I written an element yet" flag for one container field —
// distinct from `jsonLocalVal`/`jsonLocalAcc` (classjson.bit), which name a
// different local in the SAME loop; two names never collide because they are
// both numbered by the same field index.
fn jaLocalFirst(i: int): string {
  return "__json_p${i}"
}

// Every word `injectJsonAppendDecls` will need, for the module's ONE
// `appendSynthText` call to lay down beside every other feature's. The fixed
// half is appended whole whenever any `@json` class exists, not narrowed to
// which field kinds are actually present — `jsonSynthWords`' own comment
// gives the reason: two lists that could drift is a bigger risk than a
// handful of unused words.
fn jsonAppendSynthWords(classes: []JsonClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    synthJsonAppendName, synthReceiverName, jaOutWord, "byte", "i64", "f64",
    "isSome", "unwrap", "true", "false",
    jaBraceOpen, jaBraceClose, jaBracketOpen, jaBracketClose, jaComma,
  ]
  for h of synthAliasedWords(jsonAppendHelperNames()) {
    out = append(out, h)
  }
  for c of classes {
    for f of c.fields {
      if (f.keyWord != "") {
        out = append(out, f.keyWord)
      }
      if (f.kind == jkSlice || f.kind == jkMap) {
        out = append(out, jsonLocalVal(f.index))
        out = append(out, jaLocalFirst(f.index))
      }
      if (f.kind == jkMap) {
        out = append(out, jsonLocalKey(f.index))
      }
    }
  }
  return out
}

// `jsonSynthWords` plus this file's own words — ONE call so
// `planSynthMembers` (synthtext.bit) gains this feature without growing its
// own cyclomatic complexity past LINT.md's ceiling: the `for` this feature
// needs lives here instead of as a second branch in that function.
fn jsonAllSynthWords(tree: Tree, source: string, classes: []JsonClass): []string {
  let out = jsonSynthWords(tree, source, classes)
  for w of jsonAppendSynthWords(classes) {
    out = append(out, w)
  }
  return out
}

// `injectJsonDecls`'s `toJson`s plus this file's own `__jsonAppend`s — ONE
// call so `injectSynthMembersInModule` (synthtext.bit) attaches both without
// a second `for` of its own, for the same reason `jsonAllSynthWords` merges
// the word lists above.
fn jsonMemberDecls(m: SrcModule, st: SynthText, classes: []JsonClass): []int {
  let out = injectJsonDecls(m, st, classes)
  for x of injectJsonAppendMembers(m, st, classes) {
    out = append(out, x)
  }
  return out
}

// `out = <call>` — every statement this file emits ends by reassigning the
// accumulator, exactly as `jbAppendTo` (classjsonbuild.bit) does for its own
// `[]JsonEntry` accumulator.
fn jaAssignCall(jb: JsonBuild, call: int): int {
  return addNode(
    jb.tree, Tag.Assign, jb.span, int(Kind.Eq),
    [jbNode(jb, Tag.LhsList, [jbIdent(jb, jaOutWord)]), jbNode(jb, Tag.ExprList, [call])],
  )
}

// `out = append(out, '<word>')` for one of the fixed structural bytes
// (`{`/`}`/`[`/`]`/`,`) above.
fn jaAppendByte(jb: JsonBuild, word: string): int {
  let r = addLeaf(jb.tree, Tag.RuneLit, synthSpan(jb.st, word))
  return jaAssignCall(jb, jbCall(jb, jbIdent(jb, "append"), [jbIdent(jb, jaOutWord), r]))
}

// `let <word>: bool = true` / `<word> = false` — the runtime "first element"
// flag a container field's loop needs.
fn jaLetBoolTrue(jb: JsonBuild, word: string): int {
  let lit = addLeaf(jb.tree, Tag.BoolLit, synthSpan(jb.st, "true"))
  return jbNode(jb, Tag.LetDecl, [jbNode(jb, Tag.Binding, [jbIdent(jb, word), 0, lit])])
}

fn jaAssignBoolFalse(jb: JsonBuild, word: string): int {
  let lit = addLeaf(jb.tree, Tag.BoolLit, synthSpan(jb.st, "false"))
  return addNode(
    jb.tree, Tag.Assign, jb.span, int(Kind.Eq),
    [jbNode(jb, Tag.LhsList, [jbIdent(jb, word)]), jbNode(jb, Tag.ExprList, [lit])],
  )
}

// The `Json`-value-free equivalent of `jbValueOf` (classjsonbuild.bit): the
// call that appends `x`'s bytes (declared shape `kind`) onto `out`, never
// itself performing the assignment — every caller wraps this in
// `jaAssignCall`. `jkNested` calls the nested value's OWN `__jsonAppend`,
// which self-delimits, exactly as `jbValueOf`'s `jkNested` arm calls the
// nested value's own `toJson`.
fn jaAppendValueCall(jb: JsonBuild, x: int, kind: int, typeNode: int): int {
  if (kind == jkInt) {
    return jbCall(
      jb, jbIdent(jb, "__jsonAppendInt"),
      [jbIdent(jb, jaOutWord), jbCall(jb, jbIdent(jb, "i64"), [x])],
    )
  }
  if (kind == jkFloat) {
    return jbCall(
      jb, jbIdent(jb, "__jsonAppendFloat"),
      [jbIdent(jb, jaOutWord), jbCall(jb, jbIdent(jb, "f64"), [x])],
    )
  }
  if (kind == jkBool) {
    return jbCall(jb, jbIdent(jb, "__jsonAppendBool"), [jbIdent(jb, jaOutWord), x])
  }
  if (kind == jkString) {
    return jbCall(jb, jbIdent(jb, "__jsonAppendString"), [jbIdent(jb, jaOutWord), x])
  }
  if (kind == jkEnum) {
    let str = jbEnumStringExpr(jb, x, typeNode)
    return jbCall(jb, jbIdent(jb, "__jsonAppendString"), [jbIdent(jb, jaOutWord), str])
  }
  return jbCall(jb, jbMember(jb, x, synthJsonAppendName), [jbIdent(jb, jaOutWord)])
}

// `out = jsonAppendKey(out, <key>, <first>)` for one field. `first` is the
// compile-time constant this field's header comment explains: the class's
// OWN field list order is fixed, so only `f.index == 0` can ever be true.
fn jaAppendKeyStmt(jb: JsonBuild, f: JsonField): int {
  let firstWord = "false"
  if (f.index == 0) {
    firstWord = "true"
  }
  let firstLit = addLeaf(jb.tree, Tag.BoolLit, synthSpan(jb.st, firstWord))
  let call = jbCall(
    jb, jbIdent(jb, "__jsonAppendKey"), [jbIdent(jb, jaOutWord), jbKeyExpr(jb, f), firstLit],
  )
  return jaAssignCall(jb, call)
}

// `if (<flag>) { <flag> = false } else { out = append(out, ',') }` — the one
// piece of runtime state a container element needs: no comma before the
// first element, one before every element after it.
fn jaCommaIf(jb: JsonBuild, firstWord: string): int {
  let thenBlock = jbNode(jb, Tag.Block, [jaAssignBoolFalse(jb, firstWord)])
  let elseBlock = jbNode(jb, Tag.Block, [jaAppendByte(jb, jaComma)])
  return jbNode(jb, Tag.IfStmt, [jbIdent(jb, firstWord), thenBlock, elseBlock])
}

// `[]T`: `out = append(out, '[')`, then `for v of this.f { <comma?> out =
// <append v> }`, then `out = append(out, ']')` — the array shape
// `encodeArray` (stdlib/json/encode.bit) writes, built without ever holding a
// `[]Json` the way `jbSliceField` (classjsonbuild.bit) does.
fn jaSliceFieldStmts(jb: JsonBuild, f: JsonField, key: int): []int {
  let elemWord = jsonLocalVal(f.index)
  let firstWord = jaLocalFirst(f.index)
  let elemStmt = jaAssignCall(jb, jaAppendValueCall(jb, jbIdent(jb, elemWord), f.elemKind, f.elem))
  let body = jbNode(jb, Tag.Block, [jaCommaIf(jb, firstWord), elemStmt])
  let loop = jbNode(jb, Tag.ForOf, [jbIdent(jb, elemWord), jbThisField(jb, f.nameNode), body])
  return [
    key, jaLetBoolTrue(jb, firstWord), jaAppendByte(jb, jaBracketOpen), loop,
    jaAppendByte(jb, jaBracketClose),
  ]
}

// `map<string, T>`: `out = append(out, '{')`, then `for (k, v) of this.f {
// out = jsonAppendKey(out, k, <flag>); <flag> = false; out = <append v> }`,
// then `out = append(out, '}')`. Reuses `jsonAppendKey` for the entry's own
// separator/key/colon — the same helper the outer object's fields use — so a
// map's runtime keys get identical comma placement and escaping with no
// second implementation.
fn jaMapFieldStmts(jb: JsonBuild, f: JsonField, key: int): []int {
  let kWord = jsonLocalKey(f.index)
  let vWord = jsonLocalVal(f.index)
  let firstWord = jaLocalFirst(f.index)
  let entryKey = jbCall(
    jb, jbIdent(jb, "__jsonAppendKey"),
    [jbIdent(jb, jaOutWord), jbIdent(jb, kWord), jbIdent(jb, firstWord)],
  )
  let keyStmt = jaAssignCall(jb, entryKey)
  let markUsed = jaAssignBoolFalse(jb, firstWord)
  let valueStmt = jaAssignCall(jb, jaAppendValueCall(jb, jbIdent(jb, vWord), f.elemKind, f.elem))
  let binder = jbNode(jb, Tag.TuplePat, [jbIdent(jb, kWord), jbIdent(jb, vWord)])
  let body = jbNode(jb, Tag.Block, [keyStmt, markUsed, valueStmt])
  let loop = jbNode(jb, Tag.ForOf, [binder, jbThisField(jb, f.nameNode), body])
  return [
    key, jaLetBoolTrue(jb, firstWord), jaAppendByte(jb, jaBraceOpen), loop,
    jaAppendByte(jb, jaBraceClose),
  ]
}

// `Option<T>`: `if (isSome(this.f)) { out = <append unwrap(this.f)> } else {
// out = jsonAppendNull(out) }` — an absent `Option` still gets its key (just
// emitted, unconditionally, by `jaAppendKeyStmt`) and an explicit `null`
// value, never an omitted key, mirroring `jbOptionValue`'s own rule.
fn jaOptionStmt(jb: JsonBuild, f: JsonField): int {
  let thisF = jbThisField(jb, f.nameNode)
  let cond = jbCall(jb, jbIdent(jb, "isSome"), [thisF])
  let inner = jbCall(jb, jbIdent(jb, "unwrap"), [thisF])
  let someStmt = jaAssignCall(jb, jaAppendValueCall(jb, inner, f.elemKind, f.elem))
  let noneCall = jbCall(jb, jbIdent(jb, "__jsonAppendNull"), [jbIdent(jb, jaOutWord)])
  let noneStmt = jaAssignCall(jb, noneCall)
  return jbNode(
    jb, Tag.IfStmt,
    [cond, jbNode(jb, Tag.Block, [someStmt]), jbNode(jb, Tag.Block, [noneStmt])],
  )
}

// Every statement one field contributes: its key (always — an absent
// `Option` still emits one), then its value.
fn jaFieldStmts(jb: JsonBuild, f: JsonField): []int {
  jb.span = getNode(jb.tree, f.nameNode).span
  let key = jaAppendKeyStmt(jb, f)
  if (f.kind == jkSlice) {
    return jaSliceFieldStmts(jb, f, key)
  }
  if (f.kind == jkMap) {
    return jaMapFieldStmts(jb, f, key)
  }
  if (f.kind == jkOption) {
    return [key, jaOptionStmt(jb, f)]
  }
  return [
    key,
    jaAssignCall(jb, jaAppendValueCall(jb, jbThisField(jb, f.nameNode), f.kind, f.typeNode)),
  ]
}

// `[export] fn (this: C) __jsonAppend(out: []byte): []byte { ... }` for one
// `@json` class — same shape `synthToJson` produces (a top-level `FuncDecl`
// with a receiver, exported iff the class is), so every pass that discovers a
// method by walking the arena for one picks this up unchanged.
fn synthJsonAppend(tree: Tree, source: string, st: SynthText, jc: JsonClass): int {
  let classSpan = getNode(tree, jc.className).span
  let jb = JsonBuild{ tree = tree, st = st, span = classSpan, source = source }
  let stmts = [jaAppendByte(jb, jaBraceOpen)]
  for f of jc.fields {
    for s of jaFieldStmts(jb, f) {
      stmts = append(stmts, s)
    }
  }
  jb.span = classSpan
  stmts = append(stmts, jaAppendByte(jb, jaBraceClose))
  stmts = append(stmts, jbNode(jb, Tag.ReturnStmt, [jbIdent(jb, jaOutWord)]))
  let recv = addNode(
    tree, Tag.Receiver, classSpan, 0, [0, traitClassTypeRef(tree, jc.className, 0)],
  )
  let byteSlice = jbNode(jb, Tag.SliceType, [jbIdent(jb, "byte")])
  let params = addNode(
    tree, Tag.Params, classSpan, 0,
    [jbNode(jb, Tag.Param, [jbIdent(jb, jaOutWord), byteSlice])],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      recv, synthIdent(tree, st, synthJsonAppendName), 0, params, byteSlice,
      addNode(tree, Tag.Block, classSpan, 0, stmts),
    ],
  )
  if (!jc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// Every `@json` class's synthesized `__jsonAppend`, for the caller to attach
// beside `injectJsonDecls`'s `toJson`s in the same pass.
fn injectJsonAppendDecls(m: SrcModule, st: SynthText, classes: []JsonClass): []int {
  let out = []int(0)
  for jc of classes {
    out = append(out, synthJsonAppend(m.tree, m.source, st, jc))
  }
  return out
}

// The whole feature's contribution to one module: every `__jsonAppend`
// method plus the one import declaration they need, or nothing at all when
// the module carries no `@json` class — the gate
// `injectSynthMembersInModule` (synthtext.bit) calls unconditionally so that
// file stays free of this feature's own check.
fn injectJsonAppendMembers(m: SrcModule, st: SynthText, classes: []JsonClass): []int {
  if (len(classes) == 0) {
    return []int(0)
  }
  let out = injectJsonAppendDecls(m, st, classes)
  let importDecl = jsonAppendImportDecl(m, st, classes)
  if (importDecl != 0) {
    out = append(out, importDecl)
  }
  return out
}

// `import { jsonAppendKey as __jsonAppendKey, ... } from "std/json"`, minus
// the names an earlier feature already bound — same shape and same reason `jsonDecImportHelpers`
// (classjsondecodeimports.bit) synthesizes its own import rather than
// requiring the user to write one: `__jsonAppend`'s helpers are an
// implementation detail of a member the user never wrote, unlike `toJson`'s
// `Json`/`JsonEntry`, which appear in a value the user's own code can hold.
fn jsonAppendImportDecl(m: SrcModule, st: SynthText, classes: []JsonClass): int {
  if (len(classes) == 0) {
    return 0
  }
  return synthImportAliasedDecl(m, st, jsonDecodeModulePath, jsonAppendHelperNames())
}
