// compiler/classjsondecodeenum.bit — jsonDecode<T>'s read half for a
// payload-free enum field (#6177, the decode-side mirror of #6163's encode).
//
// Split from classjsondecode.bit, which was within a few lines of LINT.md's
// 800-line ceiling before this landed: this file is that one shape, its own
// sibling, exactly the way classjsonfield.bit/classjsonbuild.bit/
// classjsondecode.bit already split one feature across files.
//
// `jsonDecEnumKey`/`jsonDecEnumIndex` (stdlib/json/decode.bit) decode the
// wire value as a STRING and VALIDATE it is one of the class's own declared
// variants in the same call — an unknown name fails with the field's dotted
// path and the full list, the same `JsonDecodeError` shape every other
// mismatch takes. By the time the ternary chain below runs, the string IS
// one of them, so it ends on the LAST variant unconditionally, mirroring
// `classjsonbuild.bit`'s own `jbEnumStringExpr` (#6163) — the encode-side
// twin this file inverts.

// The class member value decoded from a payload-free enum field's variant
// name. The decode-and-validate call is built ONCE and its result node
// shared as the left operand of every comparison in the chain below — the
// same sharing `jbEnumStringExpr` already does for its own `x` — so the wire
// value is fetched once, never once per variant.
fn jdEnumValueOf(db: JsonDecBuild, el: JsonDecElem, jsonExpr: int, pr: JsonDecPathRef): int {
  let helper = "__jsonDecEnumKey"
  if (pr.byIndex) {
    helper = "__jsonDecEnumIndex"
  }
  let call = jbCall(
    db.jb, jdLocal(db, helper),
    [jsonExpr, pr.parent, pr.step, jdEnumAllowedLit(db, el.typeNode)],
  )
  return jdEnumFromStringExpr(db, jbTry(db.jb, call), el.typeNode)
}

// `["Draft", "Published"]` — every variant name of the enum at `typeNode`,
// quoted, for `jsonDecEnumKey`/`jsonDecEnumIndex`'s `allowed` parameter.
fn jdEnumAllowedLit(db: JsonDecBuild, typeNode: int): int {
  let typeName = jsonNodeText(db.jx, typeNode)
  let (names, ok) = enumVariantNames(db.jb.tree, db.jx.source, typeName)
  if (!ok || len(names) == 0) {
    panic("classjsondecodeenum: '${typeName}' is not a payload-free enum this module declares")
  }
  let items = []int(0)
  for n of names {
    items = append(items, jbSynthString(db.jb, n))
  }
  return jbNode(db.jb, Tag.SliceLit, items)
}

// `raw == "Draft" ? Status.Draft : (raw == "Published" ? Status.Published :
// Status.<last>)` — the inverse of `jbEnumStringExpr`: `raw` (already
// validated by `jdEnumValueOf`'s own call) is compared against each quoted
// variant name and the chain returns the matching class member.
fn jdEnumFromStringExpr(db: JsonDecBuild, raw: int, typeNode: int): int {
  let jb = db.jb
  let typeSpan = getNode(jb.tree, typeNode).span
  let typeName = jsonNodeText(db.jx, typeNode)
  let (variantNodes, ok) = enumVariantNameNodes(jb.tree, db.jx.source, typeName)
  if (!ok || len(variantNodes) == 0) {
    panic("classjsondecodeenum: '${typeName}' is not a payload-free enum this module declares")
  }
  let i = 0
  let result = jdEnumMemberRef(jb, typeSpan, variantNodes[len(variantNodes) - 1])
  while (i < len(variantNodes) - 1) {
    let vName = identText(jb.tree, db.jx.source, variantNodes[i])
    let cond = addNode(
      jb.tree,
      Tag.Binary,
      jb.span,
      int(Kind.EqEq),
      [raw, jbSynthString(jb, vName)],
    )
    result = jbNode(
      jb,
      Tag.CondExpr,
      [cond, jdEnumMemberRef(jb, typeSpan, variantNodes[i]), result],
    )
    i = i + 1
  }
  return result
}

// `Status.<variant>` — a fresh member-access node cloning the type's and the
// variant's own already-lexed spans, the same cloning `jbThisField` uses for
// a field's own name.
fn jdEnumMemberRef(jb: JsonBuild, typeSpan: Span, variantNode: int): int {
  return jbNode(
    jb, Tag.Member,
    [
      addLeaf(jb.tree, Tag.Ident, typeSpan),
      addLeaf(jb.tree, Tag.Ident, getNode(jb.tree, variantNode).span),
    ],
  )
}
