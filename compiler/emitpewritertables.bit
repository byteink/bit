fn peWriteSectionRelocations(
  out: ByteBuf, target: PeTarget, relocations: []PeRelocation,
  kidx: int, symIdx: map<string, int>,
): ()! {
  let ri = 0
  while (ri < len(relocations)) {
    let r = relocations[ri]
    if (peKindIndex(r.section) == kidx) {
      let (sidx, ok) = symIdx[r.symbol]
      if (!ok) {
        fail newError("UnknownSymbol")
      }
      appendU32(out, r.offset)
      appendU32(out, sidx)
      appendU16(out, peRelocType(r.kind, target))
    }
    ri = ri + 1
  }
}

fn peWriteRelocations(
  out: ByteBuf,
  target: PeTarget,
  obj: PeObject,
  buckets: ([]PeSectionKind, []int),
  symIdx: map<string, int>,
): ()! {
  let (order, relocCount) = buckets
  let ci = 0
  while (ci < len(order)) {
    let kidx = peKindIndex(order[ci])
    if (relocCount[kidx] > 0) {
      if (peRelocOverflows(relocCount[kidx])) {
        // Synthetic entry at index 0: VirtualAddress carries the true count,
        // INCLUSIVE of this entry itself (peMaxRelocsPerSection's comment).
        // The other two fields are unused -- the reader must ignore them.
        appendU32(out, pePhysicalRelocCount(relocCount[kidx])?)
        appendU32(out, 0)
        appendU16(out, 0)
      }
      peWriteSectionRelocations(out, target, obj.relocations, kidx, symIdx)?
    }
    ci = ci + 1
  }
}

fn peWriteSymbols(out: ByteBuf, symbols: []PeSymbol, order: []PeSectionKind, strOff: []int) {
  let oi = 0
  while (oi < len(symbols)) {
    let s = symbols[oi]
    let nameBytes = []byte(s.name)
    if (len(nameBytes) <= 8) {
      appendBytes(out, nameBytes)
      appendZeros(out, 8 - len(nameBytes))
    } else {
      appendU32(out, 0)
      appendU32(out, strOff[oi])
    }
    appendU32(out, s.offset) // Value
    if (s.hasSection) {
      appendU16(out, peSectionNumberOf(order, s.section))
    } else {
      appendU16(out, 0) // IMAGE_SYM_UNDEFINED
    }
    if (s.kind == PeSymKind.Func) {
      appendU16(out, 0x0020) // complex type FUNCTION, base type NULL
    } else {
      appendU16(out, 0x0000) // IMAGE_SYM_TYPE_NULL
    }
    if (s.binding == PeBinding.Global) {
      out.bytes = append(out.bytes, u8(2)) // IMAGE_SYM_CLASS_EXTERNAL
    } else {
      out.bytes = append(out.bytes, u8(3)) // IMAGE_SYM_CLASS_STATIC
    }
    out.bytes = append(out.bytes, u8(0)) // NumberOfAuxSymbols
    oi = oi + 1
  }
}

