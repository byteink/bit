// compiler/testrun.bit — `bit test`'s CLI entry point and its recursive
// directory walk (#2247). A sibling .bit file is the same module as
// build.bit (#1503's pattern), so `buildIr`/`readRtArchive`/`writeModuleExe`
// there and `injectTestMain` (testgen.bit) / `verifyModuleOk` (verify.bit)
// need no import here.
//
// THE DEFECT THIS REMOVES. `bit test <dir>` used to build and run exactly one
// module's `test_*` functions — the directory's own — and say nothing about a
// subdirectory the root imports, however many `test_*` functions it held.
// `bit test project-root` reported the root's tests as the whole suite,
// silently green, while a failing test sat one level down. SPEC §19 said "the
// root module (never in an imported one)", which stopped a DEPENDENCY's tests
// from leaking into a run, but read the same way for a project's own
// sub-packages — which is not what any of Go's `./...`, cargo, pytest or jest
// mean by running a directory's tests, and not what a CI step named
// `bit test .` has to mean to be trustworthy (#2247).
import { isSymlink } from "std/fs"

// A path that names nothing at all is `moduleRootProblem`'s first question
// (build.bit) and is checked once per module this walk visits, inside
// `runModuleTests`' own call to `buildIr`; nothing here duplicates it.

// Directories this walk never opens, regardless of what they hold: `bit-out`
// is the build driver's own output, `dist` is the release pipeline's own
// output tree (`dist/release.sh` populates the gitignored `dist/out/`,
// `.gitignore:26`, which can hold a full copy of every compiler `.bit`
// source under `dist/out/stagesrc/` during/after a release build — #4159),
// and a dotted directory (`.git` among them) is neither a module nor a place
// a project keeps one. All three are skipped unconditionally — that has been
// true of an explicit `bit test <dir>` since #2247 and #3784 must not change
// it.
//
// REJECTED: deriving this from `git check-ignore` instead of a named list.
// That form is more general — it would also cover the next gitignored
// output directory nobody has named yet — but it makes a plain filesystem
// walk depend on an external `git` process, with no defined answer for a
// project that is not a git repo at all (this workspace root among them) or
// one where `git` is not installed. `bit fmt`/`bit lint`/`bit check`/
// `bit test` must all behave the same way regardless of that, so the walk
// stays the bounded, dependency-free name check `bit-out` already uses,
// rather than gaining a second, environment-dependent execution path.
//
// `vendor` (a fetched/vendored dependency tree) is skipped ONLY when
// `skipVendor` is set — #3784's whole-project walk (`checkProjectCmd`,
// projectcli.bit; `testCmd` with no operand, below) passes true, because
// walking `vendor/bit` would run the COMPILER's own test suite from inside a
// user's project. A caller naming a directory explicitly gets the pre-#3784
// walk unchanged: `bit test some/dir` must not start skipping a `vendor/`
// subdirectory it used to walk into.
fn testWalkSkipsDir(name: string, skipVendor: bool): bool {
  if (len(name) > 0 && name[0] == '.') {
    return true
  }
  if (name == "bit-out" || name == "dist") {
    return true
  }
  return skipVendor && name == "vendor"
}

// Bounds recursion depth the same way `std/fs.walk` bounds its own (a cycle
// fails loudly rather than running forever), and the walk below also caps
// the total modules found at `maxModules` (project.bit) — the ceiling a
// project's own module count already has, reused rather than duplicated.
const maxTestWalkDepth = 64

// The raw entries of `dir`, files and subdirectories together ("." and ".."
// excluded by construction — `fsListDir` never emits them), unfiltered:
// `listBitFiles` (project.bit) already answers "which of these are `.bit`
// files"; this answers "which of these are worth opening as a directory".
fn dirEntryNames(dir: string): []string {
  let raw = fsListDir(dir)
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw) && len(out) < maxFilesPerModule) {
    if (raw[i] == 0) {
      out = append(out, raw[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// Whether any of `files` (module-relative `.bit` names from `listBitFiles`)
// is a `.test.bit` file (`isTestBitFile`, testgen.bit — same module, no
// import needed: this file is a sibling, #1503's pattern). Discovery is
// `.test.bit`-only (SPEC §19, #3786), so a directory holding nothing but
// plain `.bit` files can never produce a discoverable test. Reporting such a
// directory as a module anyway means `runModuleTests` (below) builds it
// purely to learn that — and for a module whose runtime backend is
// legitimately restricted to one target (#4253: stdlib/prof's Darwin-only
// `bit_rt_prof_*` externs), that build fails on every OTHER target even
// though nothing there was ever going to run.
fn hasTestBitFile(files: []string): bool {
  for f of files {
    if (isTestBitFile(f)) {
      return true
    }
  }
  return false
}

// Every module directory at or beneath `root` that could hold a
// discoverable test: `root` itself first if it qualifies, then depth-first
// through its subdirectories in sorted order. A "module" worth reporting is
// any directory holding at least one `.test.bit` file (`hasTestBitFile`,
// above) — an intermediate directory holding only subdirectories, or only
// plain `.bit` files with no `.test.bit` sibling, is walked through but
// never itself reported. `moduleRootProblem`'s (build.bit) "holds no .bit
// source" question is deliberately NOT asked of `root` here: that question
// is right for `build`/`run`/`check`, which read exactly one directory, but
// wrong for this recursive walk, where `root` is allowed to hold no `.bit`
// files of its own as long as a module beneath it does.
//
// NEVER LEAVES `root`'S OWN FILESYSTEM SUBTREE. This is a plain directory
// walk, not an import-graph traversal: it never opens a `./`-relative import
// target outside the tree it was given and never reaches into `~/.bit/pkg/**`
// (a fetched dependency lives outside the project directory entirely, so
// nothing here ever names its path) — which is the containment SPEC §19's
// "never in an imported one" sentence protects, kept by construction rather
// than by checking an import path against the root.
//
// SYMBOLIC LINKS ARE NEVER DESCENDED (#2489), the same contract
// `std/fs.walk` settled on for `bit lint <dir>` (#2152): a link cannot name a
// module this walk reports, whatever it points at, so a directory reachable
// only through one — inside `root` or a self-referential link back into an
// ancestor — is never visited. That is what keeps every path this walk
// returns inside `root`'s own subtree, and what makes a cycle a non-event
// rather than something `maxTestWalkDepth` merely happens to survive.
fn collectTestModules(root: string, skipVendor: bool): []string {
  let out = []string(0)
  if (hasTestBitFile(listBitFiles(root))) {
    out = append(out, root)
  }
  return testWalkInto(root, out, maxTestWalkDepth, skipVendor)
}

// Whether `p` is a directory this walk may descend into: a REAL one, not a
// link that resolves to one. `fsIsDir` alone cannot tell the difference — it
// is `opendir`/`stat`-shaped and follows a link exactly like Go's `os.Stat` —
// so both questions are asked, in this order: `isSymlink` reports false both
// for "not a link" and for "could not probe", and only the first is safe to
// descend on, but `fsIsDir` already screened `p` through the runtime's
// `max_path` and embedded-NUL rules, so by the time the second operand runs
// "could not probe" cannot be the reason. Reversing the operands would drop
// that guarantee (`std/fs.walk`'s `isRealDir`, #2152).
fn testWalkIsRealDir(p: string): bool {
  return fsIsDir(p) && !isSymlink(p)
}

fn testWalkInto(dir: string, acc: []string, depth: int, skipVendor: bool): []string {
  if (depth <= 0 || len(acc) >= maxModules) {
    return acc
  }
  let out = acc
  for name of sortStrings(dirEntryNames(dir)) {
    if (testWalkSkipsDir(name, skipVendor)) {
      continue
    }
    let p = dir + "/" + name
    if (!testWalkIsRealDir(p)) {
      continue
    }
    if (hasTestBitFile(listBitFiles(p))) {
      // bit:lint allow E0214 -- testWalkInto has 2 call sites (testrun.bit:89, tail-forwarded from collectTestModules's fresh []string(0) never read again; testrun.bit:124, its own self-recursion reassigning out in place); neither keeps a pre-call reference
      out = append(out, p)
    }
    if (len(out) >= maxModules) {
      return out
    }
    out = testWalkInto(p, out, depth - 1, skipVendor)
  }
  return out
}

// "" for one thing, "s" otherwise — every summary line below counts a test,
// a module, or both, and none of them wanted this spelled out three times.
fn pluralS(n: int): string {
  if (n == 1) {
    return ""
  }
  return "s"
}

// The result of running exactly one module's own `test_*` functions (never a
// sub-module's — SPEC §19). `ranAny` false means "no tests in this module",
// which is not a failure; `buildFailed` true means a message is already
// printed and this module counts against the combined exit code regardless
// of `passed`/`failed`, which stay 0. `discovered` is every test found before
// the `--run` substring narrowed it (equal to `passed+failed` when no
// pattern was given). `noMatch` is true only when a non-empty `--run`
// pattern matched nothing in this module — the one case where `ranAny` is
// false but it IS a failure, distinct from a module that genuinely has no
// tests.
class ModuleTestReport {
  passed: int,
  failed: int,
  discovered: int,
  ranAny: bool,
  buildFailed: bool,
  noMatch: bool,
}

// `testModule`/`testProject`'s exit code plus the one number #3784's
// project-level `bit test` summary needs and neither function's own return
// used to carry: how many tests actually RAN (passed+failed), regardless of
// how many modules or files that came from. `testCmd` reads `.ran` only when
// `opts.wholeProject` is set — every explicit-path caller is unaffected.
class TestRunTotals {
  code: int,
  ran: int,
}

// Whether `td`'s dispatch list is empty ONLY because a non-empty `runPattern`
// narrowed a real discovery down to nothing — the `--run`-given failure case
// this ticket adds, distinct from a module that simply has no tests at all
// (empty `runPattern`, handled separately below).
fn testRunNoMatch(td: TestDiscovery, runPattern: string): bool {
  return len(runPattern) > 0 && len(td.names) == 0
}

// `osRunTestBounded`'s two non-exit-code outcomes (runtime/ABI.md §19,
// `osForkExecWaitBounded` in runtime/root/{linux,darwin}/os.bit): -1 the
// child never started (spawn/wait failure), -2 the deadline elapsed and the
// child's whole process group was SIGKILLed. Named here, distinct from
// `testPanicExitCode` (testgen.bit), so the FAIL line below can say WHICH is
// which rather than leaving "the one after the last ok" as the only clue —
// the ticket this closes (#2274) names that as the whole local-debugging
// complaint.
const testSpawnFailedCode = 0 - 1
const testTimedOutCode = 0 - 2

// Default per-test bound, in the Go/Jest/pytest-timeout mould: generous
// enough that a real test clears it, short enough that a hang is caught
// within one developer's sitting rather than burning a CI runner slot for an
// hour (#2274's own complaint). Overridable per run with `--timeout
// <seconds>` (`testTimeoutMs`, main.bit); this is PER TEST, never a bound on
// the whole run — a suite of many slow-but-legitimate tests has no combined
// deadline, only each individual process does.
const defaultTestTimeoutMs = 30000

// What the FAIL line appends so the two non-exit-code outcomes are named
// rather than silent — "" for an ordinary non-zero exit, which already
// reads as a plain failure.
fn testFailNote(code: int): string {
  if (code == testTimedOutCode) {
    return " (timed out)"
  }
  if (code == testSpawnFailedCode) {
    return " (failed to start)"
  }
  return ""
}

// Whether every one of `files` is the same file — the common case (one
// `.test.bit` per module, or a single file named directly on the command
// line), where a header would be noise rather than structure.
fn allSameFile(files: []string): bool {
  let i = 1
  while (i < len(files)) {
    if (files[i] != files[0]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The ok/FAIL line itself, indented two spaces under a file header when
// `grouped`. Kept byte-for-byte identical to before #4129 when not grouped
// ("ok   "/"FAIL ", the exact spacing several fixtures pin as a substring —
// `_tests_/bit/clicmd/cases.bit`'s `wantOutSub`) — indentation only ever
// PREPENDS, so those substrings still occur unchanged inside the line.
fn printTestVerdict(name: string, ok: bool, note: string, grouped: bool) {
  let indent = ""
  if (grouped) {
    indent = "  "
  }
  if (ok) {
    print("${indent}ok   ${name}\n")
  } else {
    print("${indent}FAIL ${name}${note}\n")
  }
}

fn testFileAlreadyPrinted(printedFiles: []string, file: string): bool {
  let i = 0
  while (i < len(printedFiles)) {
    if (printedFiles[i] == file) {
      return true
    }
    i = i + 1
  }
  return false
}

// Prints `file`'s header the first time it is seen — nothing when `grouped`
// is false (the single-file run, no header at all) or `file` already has
// one — and returns `printedFiles` grown to include it when it did. Split
// out of `runModuleTests`'s own run loop (#4129) purely to keep that
// function's cyclomatic complexity under the repo's limit; no behavior
// change from the inline version it replaces.
fn maybePrintFileHeader(printedFiles: []string, file: string, grouped: bool): []string {
  if (!grouped || testFileAlreadyPrinted(printedFiles, file)) {
    return printedFiles
  }
  if (len(printedFiles) > 0) {
    print("\n")
  }
  print("${file}\n")
  // bit:lint allow E0214 -- `printedFiles` is owned by this call: `runModuleTests`'s loop starts it at `[]string(0)` (fresh, no shared backing array) and reassigns `printedFiles = maybePrintFileHeader(printedFiles, ...)` every iteration — the one caller, the one alias.
  return append(printedFiles, file)
}

// Builds `src` and runs its own `test_*` functions, printing ok/FAIL per test
// (and any build-time error) as it goes — streamed in RUN order, same as
// before #4129, so a failing test's own panic trace (written to inherited
// stderr by its own child process, in real time) still lands immediately
// before that test's FAIL line rather than being separated from it by a
// batch of verdicts printed only after every test has finished. When the
// run's tests span more than one origin file (`IrFunc.testFile`, via
// `TestDiscovery.files`) each file gets a header, printed once, the moment
// its first test's verdict is about to print (#4129: "the file is the
// group", no `describe` wrapper) — guarded by `printedFiles` rather than
// merely "did the file change since the last test", so even if declaration
// order ever stopped being file-contiguous this could misattribute a test
// to the wrong header but could never print the same header twice. Never
// prints a summary line and never decides an exit code — `testModule` and
// `testProject` need DIFFERENT summaries from the same per-test detail, so
// both call this and finish it themselves.
fn runModuleTests(src: string, runPattern: string, timeoutMs: int): ModuleTestReport {
  let noRun = ModuleTestReport{ passed: 0, failed: 0, ranAny: false, buildFailed: true }
  // Always the host target: a cross-compiled test binary could not be run here.
  let rt = readRtArchive(hostBuildTarget()) catch e {
    eprint("bit: runtime archive ${libbitrtPath(hostBuildTarget())}: ${e.message()}\n")
    return noRun
  }
  let module = buildIr(src, hostBuildTarget(), false, rt, true, true) catch e {
    eprint("bit: ${src}: ${e.message()}\n")
    return noRun
  }
  if (len(module.stubbed) > 0) {
    eprint("bit: ${src}: refusing to run tests\n")
    // Named, like the object/binary paths (compiler/build.bit's renderStubbed):
    // a bare count says a gate is red without saying what to fix, which is how
    // this one sat red and unread.
    renderStubbed(module)
    return noRun
  }
  if (!verifyModuleOk(module, src, "run tests")) {
    return noRun
  }
  let td = injectTestMain(module, runPattern)
  if (testRunNoMatch(td, runPattern)) {
    return ModuleTestReport{
      passed: 0, failed: 0, discovered: len(td.discovered),
      ranAny: false, buildFailed: false, noMatch: true,
    }
  }
  let names = td.names
  if (len(names) == 0) {
    return ModuleTestReport{ passed: 0, failed: 0, ranAny: false, buildFailed: false }
  }
  // Disambiguated for the same reason as `runCmd`'s path (#1459/#1463).
  // Scratch dir shared with `runCmd`'s `runScratchDir()` (#4173): honors
  // `$TMPDIR` on POSIX, `%TEMP%`/`%TMP%` on Windows.
  let tmp = "${runScratchDir()}/bit-test-${pathStem(src)}-${scratchNonce()}"
  if (!writeModuleExe(module, src, tmp, hostBuildTarget(), rt, false, false)) {
    return ModuleTestReport{ passed: 0, failed: 0, ranAny: true, buildFailed: true }
  }
  let grouped = !allSameFile(td.files)
  let printedFiles = []string(0)
  let passed = 0
  let i = 0
  while (i < len(names)) {
    let code = osRunTestBounded(tmp, i, timeoutMs)
    let ok = testVerdictPassed(names[i], code)
    if (ok) {
      passed = passed + 1
    }
    printedFiles = maybePrintFileHeader(printedFiles, td.files[i], grouped)
    printTestVerdict(names[i], ok, testFailNote(code), grouped)
    i = i + 1
  }
  fsRemove(tmp)
  return ModuleTestReport{
    passed: passed, failed: len(names) - passed,
    discovered: len(td.discovered), ranAny: true, buildFailed: false,
  }
}

// `bit test <one module>`: unchanged from before #2247 exit codes and per-test
// `ok`/`FAIL` lines — `testCmd` below falls through to this whenever the walk
// finds nothing to recurse into. The summary line's WORDING changed at #2080
// to print `discovered N, ran N` rather than bare `N tests`: `discovered` and
// `ran` are two independently meaningful counts (a test the checker rejects
// for a bad signature — SPEC §19 — never reaches `names` in the first place,
// so a build that gets this far already discovered exactly the tests it is
// about to run), and printing both explicitly is what makes a FUTURE silent
// drop visible on the summary's own face rather than needing a diff to
// notice — the repo's convention elsewhere (`imports: 113/113 OK`,
// `golden: PASS — 447 cases`).
fn testModule(src: string, runPattern: string, timeoutMs: int): TestRunTotals {
  let r = runModuleTests(src, runPattern, timeoutMs)
  if (r.buildFailed) {
    return TestRunTotals{ code: 1, ran: 0 }
  }
  if (r.noMatch) {
    eprint("bit test: no test matched --run ${runPattern}\n")
    return TestRunTotals{ code: 1, ran: 0 }
  }
  if (!r.ranAny) {
    print("no tests in ${src} (a test is a 'test \"name\" { }' declaration in a .test.bit file)\n")
    return TestRunTotals{ code: 0, ran: 0 }
  }
  let total = r.passed + r.failed
  print(
      "\ndiscovered ${r.discovered} test${pluralS(r.discovered)}, ran ${total}: " +
      "${r.passed} passed, ${r.failed} failed\n",
  )
  if (r.failed == 0) {
    return TestRunTotals{ code: 0, ran: total }
  }
  return TestRunTotals{ code: 1, ran: total }
}

// One module's contribution to `testProject`'s running totals — split out
// by #4212/#4216 so the new explicit-path-zero check below did not push
// `testProject` past E0204's complexity-10 limit (was 10, the added branch
// made it 11). Pure extraction: same four branches, same prints, same
// arithmetic, just returning the updated aggregate instead of mutating
// `testProject`'s own locals in place.
class ProjectAgg {
  totalPassed: int,
  totalFailed: int,
  totalDiscovered: int,
  anyBuildFailed: bool,
}

fn aggregateModuleResult(agg: ProjectAgg, m: string, r: ModuleTestReport): ProjectAgg {
  if (r.buildFailed) {
    return ProjectAgg{
      totalPassed: agg.totalPassed, totalFailed: agg.totalFailed,
      totalDiscovered: agg.totalDiscovered, anyBuildFailed: true,
    }
  }
  if (r.noMatch) {
    // Reported once for the whole run, after the loop, not per module —
    // see the aggregate check in testProject below.
    return agg
  }
  if (!r.ranAny) {
    print("no tests in ${m} (a test is a 'test \"name\" { }' declaration in a .test.bit file)\n")
    return agg
  }
  let sub = r.passed + r.failed
  print(
      "discovered ${r.discovered} test${pluralS(r.discovered)}, ran ${sub}: " +
      "${r.passed} passed, ${r.failed} failed\n",
  )
  return ProjectAgg{
    totalPassed: agg.totalPassed + r.passed, totalFailed: agg.totalFailed + r.failed,
    totalDiscovered: agg.totalDiscovered + r.discovered, anyBuildFailed: agg.anyBuildFailed,
  }
}

// `bit test <project root>`: runs every module `mods` names — independently,
// each its own `buildIr`, never sharing state — and reports each labeled by
// its own path so a failure is attributable, plus one combined summary and
// exit code. This is what makes `bit test <dir>` at a project root actually
// cover the project (#2247) instead of only its own top level.
fn testProject(
  mods: []string,
  runPattern: string,
  timeoutMs: int,
  wholeProject: bool,
): TestRunTotals {
  let agg = ProjectAgg{ totalPassed: 0, totalFailed: 0, totalDiscovered: 0, anyBuildFailed: false }
  for m of mods {
    print("== ${m} ==\n")
    let r = runModuleTests(m, runPattern, timeoutMs)
    agg = aggregateModuleResult(agg, m, r)
    print("\n")
  }
  let total = agg.totalPassed + agg.totalFailed
  if (len(runPattern) > 0 && total == 0) {
    eprint("bit test: no test matched --run ${runPattern}\n")
    return TestRunTotals{ code: 1, ran: 0 }
  }
  print(
      "discovered ${agg.totalDiscovered} test${pluralS(agg.totalDiscovered)} across ${len(mods)} module${pluralS(len(mods))}, " +
      "ran ${total}: ${agg.totalPassed} passed, ${agg.totalFailed} failed\n",
  )
  if (agg.totalFailed > 0 || agg.anyBuildFailed) {
    return TestRunTotals{ code: 1, ran: total }
  }
  // #4212/#4216: same reasoning as testModule's `!r.ranAny` branch above —
  // an explicit multi-module path that discovered literally nothing is a
  // discovery failure, not a project with no tests yet.
  if (!wholeProject && total == 0) {
    return TestRunTotals{ code: 1, ran: total }
  }
  return TestRunTotals{ code: 0, ran: total }
}

// The operand `bit test` builds, plus the `--run` substring filter (#2833,
// applied by #2834). `runPattern` is "" when `--run` was never given, in
// which case every function below behaves exactly as before: `testCmd`
// threads it into `testModule`/`testProject`, which thread it into
// `runModuleTests`, which passes it to `injectTestMain` (testgen.bit) — the
// one place the substring match itself happens.
class TestOptions {
  src: string,
  runPattern: string,
  timeoutMs: int,
  // #3784: true only for `bit test`'s no-operand ("whole project") form —
  // `src` is then `projectRootDir()` (main.bit), not something the caller
  // typed. Every explicit-path caller leaves this false, so `testCmd`'s
  // output for a GIVEN path is unchanged (the extra line below never prints).
  wholeProject: bool,
}

// `bit test <file.bit|dir>` (SPEC §19). A file is always exactly one module —
// unchanged. A directory is walked for every module beneath it; when that
// walk finds nothing but the directory itself (the common case: a single
// module, no sub-packages, or none at all) the result is identical to
// running that one module directly, so `testModule` alone still owns that
// wording. Only a directory holding more than its own top level, or holding
// modules with nothing at its own top level, reaches `testProject`.
fn testCmd(opts: TestOptions): int {
  // Refuse before any compile — `runModuleTests` (above) always calls
  // `buildIr` first regardless of file vs. directory or how many modules a
  // directory walk finds, so one check here ahead of `testRunResult` below
  // covers `testModule` AND `testProject` (#2979, `refuseTestUnderStressGc`
  // in build.bit — same module, no import needed).
  if (refuseTestUnderStressGc(opts.src)) {
    return 1
  }
  let result = testRunResult(opts)
  // #3784's whole line: the project-level summary a path-given `bit test`
  // never prints. `countConventionTestFiles` (projectcli.bit) is REPORTING
  // ONLY — it never decides which tests run, so it cannot disagree with
  // `result.ran` about what actually happened.
  if (opts.wholeProject) {
    print("${countConventionTestFiles(opts.src)} test file(s) found, ${result.ran} test(s) run\n")
  }
  return result.code
}

// The file-vs-directory, single-module-vs-project split `testCmd` used to
// inline before #3784 needed its RESULT (not just its exit code) to build
// the whole-project summary line above.
fn testRunResult(opts: TestOptions): TestRunTotals {
  let src = opts.src
  if (!fsIsDir(src)) {
    return testModule(src, opts.runPattern, opts.timeoutMs) // a file, or a path that does not exist at all
  }
  let mods = collectTestModules(src, opts.wholeProject)
  if (len(mods) == 0 || (len(mods) == 1 && mods[0] == src)) {
    return testModule(src, opts.runPattern, opts.timeoutMs)
  }
  return testProject(mods, opts.runPattern, opts.timeoutMs, opts.wholeProject)
}
