// Self-host Stage 3 (#1342): ARM64 top-level per-function driver — register
// allocation, frame layout, emission — split out of arm64.bit (#1503).
// Sibling .bit file, same module: see arm64.bit for the backend overview.
// compiler/arm64dispatch.bit (#3915, sibling split) holds compileInst's
// per-op dispatch and collectReservedArm64.

// ===========================================================================
// Top-level: register allocation, frame layout, emission
//
// Live-interval construction is backend-agnostic and lives in codegen.bit
// (`buildIntervals`), shared with x64.
// ===========================================================================

// How many of `args` overflow past the argument registers to the stack.
fn stackArgSlots(
  ctx: TypeContext,
  f: IrFunc,
  args: []int,
  baseIntOrd: int,
  baseFloatOrd: int,
): int {
  let intOrd = baseIntOrd
  let floatOrd = baseFloatOrd
  let slots = 0
  let i = 0
  while (i < len(args)) {
    let regClass = regClassOf(ctx, f.instrs[args[i]].ty)
    if (regClass == RegClass.Int) {
      if (intOrd >= maxArgRegs()) {
        slots = slots + 1
      }
      intOrd = intOrd + 1
    } else {
      if (floatOrd >= maxArgRegs()) {
        slots = slots + 1
      }
      floatOrd = floatOrd + 1
    }
    i = i + 1
  }
  return slots
}

// #3284: does `f` contain a division/remainder instruction whose runtime
// zero-check (#2016) reaches `emitCallReloc(cx, "bit_rt_panic_div_zero")`
// (arm64select.bit's emitDivInt)? That call is invisible to hasSafepoints —
// it isn't Op.Call/RtCall/CallValue/CallIface/GcAlloc/MakeClosure, so
// isSafepointOp never sees it — which is exactly the gap #2929's frameless
// optimization left open once a stack walker exists to be misled by it
// (spec/SPEC.md §18.6). bit_rt_panic_nil_call/_nil_iface do NOT need an
// equivalent check here: both are emitted only from emitCallValue/
// emitCallIface (arm64call.bit), and Op.CallValue/Op.CallIface are already
// in isSafepointOp, so any function containing either one already has
// hasSafepoints == true and is disqualified from `frameless` before this
// predicate would ever matter — hasSafepoints already covers them; it is
// deliberately not reused here because it does NOT cover div/rem.
//
// Asks `xDivisorPlan` — the same function `emitDivInt` gates the call on
// (#4361) — rather than restating its rule. This predicate used to mirror the
// emitter by hand and claim in this comment that it "can never disagree"; a
// comment asserting soundness is a claim, not a proof, and the two rules were
// two edits away from diverging. Sharing the decision makes agreement
// structural: any divisor the emitter guards is a divisor this reports.
fn hasDivZeroGuard(ctx: TypeContext, f: IrFunc): bool {
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (isDivOp(ins.op) && xDivisorPlan(f, ins.rhs, widthOf(ctx, ins.ty)).guard) {
      return true
    }
    i = i + 1
  }
  return false
}

// #3915: does `f` contain an `asm` block (§11.6) whose arm64 clobber list
// names x30 (register 30, the link register)? `blr`/`bl` inside an asm
// payload IS a call, but Op.Asm is deliberately absent from isSafepointOp
// (codegenlive.bit) — widening it would force every one- or two-instruction
// atomic/syscall asm block in the tree onto the callee-saved file for no
// reason (most clobber nothing beyond what they already declare). Declaring
// `clobber arm64 { x30 }` is the one signal the language actually gives an
// author for "this block destroys the return address": SPEC.md:1160 only
// promises the register is excluded from the allocator, which does nothing
// for x30 in a leaf, since x30 there is never allocated in the first place —
// it's the incoming return address, not a vreg location. So frame layout
// keys off the declared clobber directly rather than the (silently
// ineffective) exclusion.
// runtime/ABI.md §4, asserted rather than argued: "a stack map can only ever
// name a register the shim did save", and the safepoint shim writes the
// callee-saved file ONLY, leaving the rest of its snapshot untouched. So a
// live reference reported in a caller-saved register is read out of an
// unwritten snapshot slot — a MISSED root for any frame the walk unwinds into.
//
// Until #4343 this held for free, because a safepoint-bearing function had no
// caller-saved register in its file at all. It now rests on regalloc's
// `rootedAtPoint` restriction, which is a different predicate in a different
// file, so it is checked here at the one point where both the stack maps and
// the physical register file exist. Bounded by the total number of live
// references across all safepoints, which the map already enumerates.
fn arm64TargetRegs(intRegs: []int, floatRegs: []int): TargetRegs {
  return TargetRegs{
    intRegs: RegFile{
      count: len(intRegs),
      calleeSaved: calleeSavedIntMask(intRegs),
      pollSaved: pollSavedIntMask(intRegs),
    },
    floatRegs: RegFile{
      count: len(floatRegs),
      calleeSaved: calleeSavedFloatMask(floatRegs),
      pollSaved: pollSavedFloatMask(floatRegs),
    },
  }
}

fn posInList(ps: []int, p: int): bool {
  let i = 0
  while (i < len(ps)) {
    if (ps[i] == p) {
      return true
    }
    i = i + 1
  }
  return false
}

// #4429: the check above, now asked per SAFEPOINT KIND rather than once for the
// whole function, because the two kinds have different answers and conflating
// them is exactly the miscompile this assert exists to catch.
//
//   - an ordinary call's map is read after the collector has restored the
//     register file through the frames it unwound, and a prologue saves only
//     AAPCS64 callee-saved registers, so only those may be named;
//   - a back-edge poll's map is read out of bit_rt_safepoint's own raw
//     snapshot with no restore in front of it, so anything the shim stores may
//     be named — isPollSavedInt, which mirrors that payload.
fn assertStackMapsSnapshotSaved(
  result: RegAllocResult, intRegs: []int, polls: []int,
) {
  let si = 0
  while (si < len(result.stackMaps)) {
    let sm = result.stackMaps[si]
    let atPoll = posInList(polls, sm.pos)
    let ri = 0
    while (ri < len(sm.regs)) {
      let r = intRegs[sm.regs[ri]]
      assert(
        isCalleeSavedInt(r) || (atPoll && isPollSavedInt(r)),
        "stack map names a register the safepoint shim does not save (runtime/ABI.md §4)",
      )
      ri = ri + 1
    }
    si = si + 1
  }
}

fn asmClobbersLr(module: IrModule, ins: IrInstr): bool {
  if (ins.op != Op.Asm) {
    return false
  }
  let blk = module.asmBlocks[ins.ival]
  let j = 0
  while (j < len(blk.clobArm64)) {
    if (blk.clobArm64[j] == 30) {
      return true
    }
    j = j + 1
  }
  return false
}

// Every instruction slot holding such a block. #4343: these are REGISTER
// clobber points as well as a frame-layout signal, and that only became
// load-bearing when the int file widened past the callee-saved subset — before
// it, a function containing one always also had safepoints (or ran on the full
// file with nothing to protect), so the caller-saved registers an asm `bl`
// destroys held nothing live either way.
fn asmLrClobberPositions(module: IrModule, f: IrFunc): []int {
  let out = []int(0)
  let i = 0
  while (i < len(f.instrs)) {
    if (asmClobbersLr(module, f.instrs[i])) {
      out = append(out, i)
    }
    i = i + 1
  }
  return out
}

fn hasAsmLrClobber(module: IrModule, f: IrFunc): bool {
  return len(asmLrClobberPositions(module, f)) > 0
}

// Every position at which this function's emitted code destroys the caller-saved
// registers — compiler/regalloc.bit's `AllocPoints.clobbers`. Since #4429 the
// caller hands this only the CALL safepoints: a back-edge poll destroys a
// smaller set (RegFile.pollSaved) and is carried in `AllocPoints.polls`
// instead, so it must not appear here.
//
// The poll-cache prefetch half is taken from `xClobberPoints` rather than
// re-derived: both backends emit that prefetch under the same predicate
// (hasBackEdgeSafepoint) at the same point — after the incoming-argument bind,
// before the entry block's first body instruction — so the position is one
// expression over IrFunc alone with no register file in it. Spelling it twice
// is how a change to WHERE the prefetch is emitted updates one backend and
// silently leaves the other handing out a register that call destroys. The `x`
// prefix is historical; nothing in it is x86-specific.
//
// The panic helpers this backend emits inline (bit_rt_panic_nil_call,
// bit_rt_panic_nil_iface, bit_rt_panic_div_zero, bit_rt_panic_overflow) are
// deliberately absent, on the same grounds x64 states: none of them returns, so
// no later instruction can read a register they destroyed.
fn arm64ClobberPoints(module: IrModule, f: IrFunc, safepoints: []int): []int {
  let out = xClobberPoints(f, nonReturningFiltered(f, safepoints))
  for p of asmLrClobberPositions(module, f) {
    out = append(out, p)
  }
  return out
}

// True iff the instruction at `pos` is a call whose very next instruction is
// `Op.Unreachable` — a bounds check's `bit_rt_panic`, a `fail` that cannot be
// caught, any lowering that ends "call, then unreachable".
//
// Such a call is still a SAFEPOINT (it emits a stack map, and `recordSafepoint`
// stays in lockstep with buildIntervals' scan), but it is not a CLOBBER: the
// only instruction that can follow it is `Op.Unreachable`, which emits a `udf`
// and reads no register. That holds whether or not the callee really returns —
// a returning callee falls into the trap instead of reading anything.
//
// It matters because a bounds check's panic block sits in the middle of the
// enclosing loop's INDEX range while sitting off its control-flow path
// entirely. `crossesPoint` is a linear index test, so every address temporary
// computed before the check and used after it counted as live across a call
// that can never return, and was confined to x19..x28 for that reason alone.
fn isNonReturningCall(f: IrFunc, pos: int): bool {
  if (pos + 1 >= len(f.instrs)) {
    return false
  }
  if (!isSafepointOp(f.instrs[pos].op)) {
    return false // a back-edge poll: recorded at its Jump/Br terminator
  }
  return f.instrs[pos + 1].op == Op.Unreachable
}

fn nonReturningFiltered(f: IrFunc, safepoints: []int): []int {
  let out = []int(0)
  for p of safepoints {
    if (!isNonReturningCall(f, p)) {
      out = append(out, p)
    }
  }
  return out
}

// #4429: split `buildIntervals`' safepoint list by kind. A back-edge poll is
// recorded at its Jump/Br TERMINATOR (codegenlive.bit), and every other
// safepoint at an `isSafepointOp` instruction, so the op at the position is the
// whole discriminator — the same one isNonReturningCall already relies on. An
// Op.Br whose two edges are both back edges appears twice; both are polls and
// both belong here.
fn arm64PollSafepoints(f: IrFunc, safepoints: []int): []int {
  let out = []int(0)
  for p of safepoints {
    if (!isSafepointOp(f.instrs[p].op)) {
      out = append(out, p)
    }
  }
  return out
}

fn arm64CallSafepoints(f: IrFunc, safepoints: []int): []int {
  let out = []int(0)
  for p of safepoints {
    if (isSafepointOp(f.instrs[p].op)) {
      out = append(out, p)
    }
  }
  return out
}

// #3915 (revisits #3284): a call this backend emits or admits that
// `hasSafepoints` does not see, and that must still force a real frame
// record for x30 (or, for hasDivZeroGuard, for the stack space §18.6's
// panic walker needs) to survive. Two instances today — the div-zero panic
// guard and an asm block's declared link-register clobber. A third instance
// extends this function; `frameless` below stays a fixed-shape expression
// instead of growing another `&&` operand per instance.
fn hasHiddenCallHazard(module: IrModule, ctx: TypeContext, f: IrFunc): bool {
  return hasDivZeroGuard(ctx, f) || hasAsmLrClobber(module, f)
}

// One compiled function: its machine code plus everything an object writer needs
// to place it.
class FuncCode {
  name: string,
  code: []u8,
  relocs: []Reloc,
  safepoints: []SafepointView,
  // Callee-saved registers this function's prologue preserves, and where
  // (frame-pointer-relative) it stashed the caller's value — the runtime stack
  // walker (runtime/ABI.md §4) restores them when unwinding.
  savedRegs: []SavedReg,
  frameSize: int,
  // #3283: this function's debug-info rows, in final code-emission order.
  // See emDebugLinesOf (compiler/emit.bit) for the row-0 fixup and
  // appendDebugLineIfChanged (compiler/codegen.bit) for how they're built.
  lines: []DebugLineRow,
}

// Compiles one function to ARM64 machine code. `debug` reaches only as far as
// `A64Ctx.debug` today (#3077) — later codegen tickets read it from there.
fn compileFunction(module: IrModule, f: IrFunc, debug: bool): FuncCode {
  let ctx = module.ctx
  let built = buildIntervals(ctx, f)
  let intervals = built.intervals

  // Any emitted safepoint is a bl (a real call/rt_call/etc. OR the synthetic
  // bit_rt_safepoint a loop back-edge inserts), and every bl clobbers the
  // caller-saved GPRs. built.safepoints is the exact set of bls buildIntervals
  // recorded (calls + back-edges), so it is the single source of truth; a bare
  // has-calls op scan missed the back-edge case, leaving a loop-carried value in
  // a caller-saved register that the back-edge safepoint then destroyed (#1236).
  // Since #4343 it no longer narrows the register file — it only decides frame
  // shape (below) — because the allocator restricts per interval instead.
  let hasSafepoints = len(built.safepoints) > 0
  let intRegs = buildIntRegs()
  let floatRegs = buildFloatRegs()

  // #2925: does `f` close at least one loop back-edge with a real poll (the
  // exact predicate emitBackEdgeSafepointIfNeeded gates on)? Scanned ahead of
  // frame layout, independently of `built.safepoints` (which also counts
  // ordinary calls — fib has one of those and zero of these), so the
  // poll-address cache slots can be sized before emitPrologue runs. Implies
  // hasSafepoints: codegen.bit's own buildIntervals records the identical
  // back-edge under the identical guard, so a function with one always has
  // len(built.safepoints) > 0 already and is never frameless.
  let hasBackEdgePoll = hasBackEdgeSafepoint(f)
  let pollCacheSlots = 0
  if (hasBackEdgePoll) {
    // #4203: ONE slot — the attention word's address. It was worldAddr, gcAddr,
    // preemptAnyAddr (#3746) and a poll countdown (#4200) while the back edge
    // re-derived the poll predicate itself.
    pollCacheSlots = 1
  }
  assert(!hasBackEdgePoll || hasSafepoints)

  // Any physical register an `asm` block names (`input`/`result`/clobber) leaves
  // the allocatable file for the whole function, so no vreg can land in a
  // register the inline sequence overwrites (§11.6) — the same exclusion
  // div/shift/atomics use, generalized to an arbitrary set. Neither an `asm`
  // nor a `syscall` (§11.8) in this function leaves `intRegs` exactly as
  // `buildIntRegs` returned it.
  let reserved = collectReservedArm64(module, f)
  let allocRegs = []int(0)
  let ri = 0
  while (ri < len(intRegs)) {
    if (!reserved[intRegs[ri]]) {
      allocRegs = append(allocRegs, intRegs[ri])
    }
    ri = ri + 1
  }
  intRegs = allocRegs

  // #4343: the per-interval rule (#3171), which this backend passed up until
  // now. Both files are the full pool; `calleeSaved` says which of their
  // members survive a call, and `clobbers` says where the calls are, so an
  // interval live across one is confined to x19..x28 / d8..d15 and one that is
  // not may take anything. An over-reported mask is a miscompile, not a missed
  // optimization — calleeSavedIntMask/calleeSavedFloatMask derive it from the
  // same isCalleeSavedInt/isCalleeSavedFloat the prologue's save set uses.
  //
  // The clobber list is deliberately NOT a superset of `built.safepoints` — see
  // arm64ClobberPoints. regalloc's GC-rooting restriction (runtime/ABI.md §4: a
  // stack map may only name a register the safepoint shim saved) reads
  // `built.safepoints` directly and is gated on the mask above, not on this
  // list, so narrowing it cannot weaken that guarantee.
  //
  // #3738 passes `built.roots`: a block param every predecessor binds to one
  // value shares that value's location instead of getting its own, which
  // deletes the edge move rather than optimising it. Purely an assignment
  // question, so it is orthogonal to the clobber discussion above.
  //
  // #4429 splits `built.safepoints` by kind. Only the CALL half is a full
  // clobber and only the CALL half confines a live reference to x19..x28; a
  // back-edge poll goes through bit_rt_safepoint, which preserves and republishes
  // the whole allocatable file, so a loop-carried value no longer has to be
  // callee-saved just because the loop polls.
  let polls = arm64PollSafepoints(f, built.safepoints)
  let calls = arm64CallSafepoints(f, built.safepoints)
  let result = allocateCoalesced(
    arm64TargetRegs(intRegs, floatRegs),
    intervals,
    AllocPoints{
      safepoints: built.safepoints,
      calleeSafepoints: calls,
      polls: polls,
      clobbers: arm64ClobberPoints(module, f, calls),
    },
    built.roots,
  )
  assertStackMapsSnapshotSaved(result, intRegs, polls)

  let skipConst = computeSkipConstMaterialize(ctx, f, debug)
  // #4430: computed before fuseCmp, which reads it to exclude an eliminated
  // br's condition read from its own use count (arm64branch.bit).
  let redundantBr = computeRedundantBoundsBranch(f)
  let fuseCmp = computeFuseCmpBranchForArm64(f, redundantBr)
  let deadBlock = computeDeadBoundsBlocks(f, redundantBr)

  // Which callee-saved physical registers this allocation actually touched — only
  // those need saving. Scanned per-vreg (rather than over the locations alone)
  // since a bare register index is ambiguous between the int and float files
  // without its own class.
  //
  // #3101: an interval whose instruction WRITES no register is skipped. The
  // allocator hands out a location for every one of `buildIntervals`' dense
  // slots, including the ones its own doc comment calls "trivial, never-
  // referenced [i,i] interval; harmless filler" (terminators, field_set/
  // index_set, a void-typed call) — plus the `const_int` defs #1853/#3104/#3105
  // fold whole into an immediate and never materialize. Counting those as used
  // saved a register the body provably never writes, which made the prologue's
  // str/ldr pair a pure no-op and, when it was the only entry, kept an otherwise
  // frameless function paying a full frame record.
  let gprUsed = []bool(len(intRegs))
  let fprUsed = []bool(len(floatRegs))
  let vi = 0
  while (vi < len(intervals)) {
    let loc = result.locations[vi]
    if (!loc.isSpill && arm64DefinesRegister(ctx, f, skipConst, fuseCmp, vi)) {
      if (intervals[vi].regClass == RegClass.Int) {
        gprUsed[loc.index] = true
      } else {
        fprUsed[loc.index] = true
      }
    }
    vi = vi + 1
  }
  let savedGpr = []int(0)
  let i = 0
  while (i < len(intRegs)) {
    if (gprUsed[i] && isCalleeSavedInt(intRegs[i])) {
      savedGpr = append(savedGpr, intRegs[i])
    }
    i = i + 1
  }
  let savedFpr = []int(0)
  i = 0
  while (i < len(floatRegs)) {
    if (fprUsed[i] && isCalleeSavedFloat(floatRegs[i])) {
      savedFpr = append(savedFpr, floatRegs[i])
    }
    i = i + 1
  }

  // Size the outgoing stack-argument area to the widest call this function makes:
  // the 9th+ argument of any class spills to the stack. Only real bls carry user
  // args — the synthetic back-edge safepoint, gc_alloc, and make_closure never
  // overflow.
  let outgoingSlots = 0
  i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    let need = 0
    if (ins.op == Op.Call || ins.op == Op.RtCall) {
      need = stackArgSlots(ctx, f, ins.args, 0, 0)
    } else if (ins.op == Op.CallValue || ins.op == Op.CallIface) {
      need = stackArgSlots(ctx, f, ins.args, 1, 0) // arg0 = env / receiver
    }
    if (need > outgoingSlots) {
      outgoingSlots = need
    }
    i = i + 1
  }
  let outgoingBytes = outgoingSlots * 8

  // #2929: elide the frame entirely when this function provably needs none.
  // `!hasSafepoints` alone is NOT "x30 is live across nothing" — an `asm`
  // block's `blr`/`bl` is a real call that `isSafepointOp` deliberately does
  // not count (see hasHiddenCallHazard below and #3915) — so `hasSafepoints`
  // only covers "makes no Op.Call/RtCall/GcAlloc/MakeClosure/CallValue/
  // CallIface and closes no loop back-edge" (isSafepointOp/buildIntervals
  // above); the remaining call-shaped hazards are `hiddenCallHazard`, below.
  // The other three conditions cover the callee-saved/spill/outgoing-argument
  // space a frame record would otherwise exist to address. The standard
  // fourth condition, "takes no address of a local", is vacuous here — Bit
  // has no address-of operator (spec/SPEC.md §13) — so nothing else ever
  // needs this function's frame to be stable.
  //
  // #3284 (revisits #2929), extended by #3915: calls this backend emits or
  // admits that are NOT in `hasSafepoints` and used to be let through
  // anyway — emitDivInt's inline `bl bit_rt_panic_div_zero` guard (#2016),
  // reachable from a bare SDiv/UDiv/SRem/URem with no other call in the
  // function, and an `asm` block whose payload issues a `blr`/`bl` and
  // declares as much via `clobber arm64 { x30 }`. The div-zero case was sound
  // only as long as "this backend's panic path never walks a frame chain at
  // all" (runtime/root/darwin/io.bit's `bit_rt_panic` doc comment) stayed
  // true; spec/SPEC.md §18.6 commits to a runtime stack walker (#3285) that
  // makes it false, so a div-zero panic inside an otherwise-frameless leaf
  // must now establish a real frame record for that walker to find. The asm
  // case needs a frame for a more direct reason: without one, `blr` destroys
  // x30 and the bare `ret` returns into the middle of the function.
  // `hasHiddenCallHazard` (above) covers both. A safepoint-bearing function
  // (CallValue/CallIface's own nil-check panics, or an asm block whose
  // callee-saved-only exclusion already forced one) never needed this: those
  // are already in `hasSafepoints`, which already excludes it from
  // `frameless` — hasSafepoints is reused for that half and is NOT reused
  // here, because it does not cover div/rem or a bare asm `blr`.
  let hiddenCallHazard = hasHiddenCallHazard(module, ctx, f)
  let frameless = !f.isNaked &&
    !hasSafepoints &&
    !hiddenCallHazard &&
    result.numSpillSlots == 0 &&
    len(savedGpr) == 0 &&
    len(savedFpr) == 0 &&
    outgoingBytes == 0

  let frameSize = 0
  if (!frameless) {
    frameSize = alignFrame16(
        outgoingBytes +
        16 +
        pollCacheSlots * 8 +
        len(savedGpr) * 8 +
        len(savedFpr) * 8 +
        result.numSpillSlots * 8,
    )
    // Every access this backend emits into the frame uses the unsigned-imm12
    // form when it fits: 4095*8 bytes reaches any realistic frame. Larger
    // frames still work (via the register-offset fallback) but that path is
    // untested at this scale — assert the common case explicitly.
    assert(frameSize < 4096 * 4096)
  }

  let frame = FrameInfo{
    savedGpr: savedGpr, savedFpr: savedFpr,
    numSpillSlots: result.numSpillSlots, outgoingBytes: outgoingBytes,
    pollCacheSlots: pollCacheSlots, frameSize: frameSize, frameless: frameless,
  }

  // §10.3.1 @naked safety net: the prologue is suppressed, so a spill slot,
  // saved register, or outgoing-arg area would silently corrupt the caller.
  // (frameSize itself is never 0 — arm64 always budgets the 16-byte frame
  // record — but a naked fn allocates none of it.) Rules 1+2 make this
  // unreachable; assert rather than paper over it.
  assert(
      !f.isNaked ||
      (result.numSpillSlots == 0 && len(savedGpr) == 0 && len(savedFpr) == 0 && outgoingBytes == 0),
  )

  let instToVreg = []int(0)
  i = 0
  while (i < len(intervals)) {
    instToVreg = append(instToVreg, i)
    i = i + 1
  }

  let cx = A64Ctx{
    module: module,
    f: f,
    code: newByteBuf(),
    relocs: []Reloc(0),
    instToVreg: instToVreg,
    result: result,
    intRegs: intRegs,
    floatRegs: floatRegs,
    frame: frame,
    blockOffsets: []int(len(f.blocks)),
    jumpFixups: []JumpFixup(0),
    safepoints: []SafepointView(0),
    safepointPositions: built.safepoints,
    nextSafepointIdx: 0,
    skipConst: skipConst,
    fuseCmp: fuseCmp,
    redundantBr: redundantBr,
    deadBlock: deadBlock,
    wroteInt: []bool(32),
    wroteFloat: []bool(32),
    debug: debug,
    dbgRows: []DebugLineRow(0),
  }

  // §10.3.1 @naked: no prologue — the function runs on its caller's frame.
  // #2929 frameless: same effect, proved rather than declared.
  if (!f.isNaked && !frame.frameless) {
    emitPrologue(cx)
  }
  bindIncomingArgs(cx)
  // #2925: after incoming args are off the ABI registers and onto their real
  // (callee-saved, since hasSafepoints) homes — otherwise these two calls'
  // caller-saved clobber would destroy an argument still sitting in x0..x7.
  emitPollCachePrefetch(cx)

  // Emit every block in its original (emission) order.
  //
  // #4430: a block in `deadBlock` is the panic target of a `br` that
  // `emitBr` never tests any more (computeRedundantBoundsBranch proved it
  // unreachable) — nothing branches to it, so `effInstsLen` narrows its
  // bound to zero instructions (computeEffectiveInstsLen, arm64branch.bit)
  // rather than adding a branch to this loop: this function is already
  // complexity-debt.txt's worst-recorded E0204 entry, and only a human may
  // raise that baseline. `blockOffsets` is left at whatever `codeLen`
  // already is, matching the block that falls straight through it.
  let effInstsLen = computeEffectiveInstsLen(f, deadBlock)
  let bi = 0
  while (bi < len(f.blocks)) {
    cx.blockOffsets[bi] = codeLen(cx)
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    while (idx < b.instsStart + effInstsLen[bi]) {
      // #3283: record this instruction's source position before it emits
      // any code, so the row's pcOffset names where it actually starts.
      cx.dbgRows = appendDebugLineIfChanged(
        cx.dbgRows,
        debugPosOf(cx.module.sm, f.instrs[idx].span), codeLen(cx),
      )
      compileInst(cx, bi, idx)
      idx = idx + 1
    }
    bi = bi + 1
  }
  patchJumpFixups(cx)

  // #3101: emission is finished, so `cx.wroteInt`/`cx.wroteFloat` now hold every
  // physical register a vreg actually resolved to. Every callee-saved one must be
  // in the save set the frame was laid out from — otherwise this function
  // clobbers a register its caller expects back, which no test can see until the
  // caller's value happens to matter. A @naked function saves nothing by
  // contract (§10.3.1) and owns the whole file itself, so it is exempt.
  if (!f.isNaked) {
    assertSavedCoversWrites(cx)
  }

  // Register-recovery slots: the prologue saves savedGpr[i] at gprSaveOffset(i)
  // from sp; convert to x29-relative (fp = sp + frameSize - 16) so the runtime
  // walker reads *(x29 + fpOff).
  let fpBase = savedFpOffset(frame)
  let savedRegs = []SavedReg(0)
  i = 0
  while (i < len(frame.savedGpr)) {
    savedRegs = append(
      savedRegs,
      SavedReg{
        reg: frame.savedGpr[i],
        fpOff: gprSaveOffset(frame, i) - fpBase,
      },
    )
    i = i + 1
  }

  return FuncCode{
    name: f.name, code: cx.code.bytes, relocs: cx.relocs,
    safepoints: cx.safepoints, savedRegs: savedRegs, frameSize: frameSize,
    lines: cx.dbgRows,
  }
}

// Establishes the frame record and saves the callee-saved registers this
// function's allocation touched.
fn emitPrologue(cx: A64Ctx) {
  addSubImmWide(cx.code, true, regSp(), regSp(), cx.frame.frameSize)
  // x29 and x30 sit in consecutive slots by construction (savedLrOffset is
  // savedFpOffset + 8), so the frame record is one stp on any frame the signed
  // imm7 reaches — #3509. Nothing about WHERE either lands changes, so the
  // stack maps this function also emits are unaffected.
  frameRun(cx.code, [29, 30], false, false, regSp(), savedFpOffset(cx.frame))
  addSubImmWide(cx.code, false, 29, regSp(), savedFpOffset(cx.frame))
  frameRun(
    cx.code, cx.frame.savedGpr, false, false, regSp(),
    gprSaveOffset(cx.frame, 0),
  )
  frameRun(
    cx.code, cx.frame.savedFpr, true, false, regSp(),
    fprSaveOffset(cx.frame, 0),
  )
}

// Binds the incoming arguments into the entry block's params. The mirror of
// marshalArgs: params 1-8 of each class arrive in the ABI registers; the rest sit
// just above this frame at [sp + frameSize + 8*k] (the caller's outgoing area).
//
// ponytail: the entry block is block 0. The seed carries an explicit
// Function.entry, but every one of its five finish() call sites passes the first
// block its builder created — so entry is always 0 today. If a lowering ever
// creates a block before the entry block, IrFunc needs the field.
fn bindIncomingArgs(cx: A64Ctx) {
  let entry = cx.f.blocks[0]
  let intOrd = 0
  let floatOrd = 0
  let stackIndex = 0
  // One parallel move covering both classes (#3182).
  let moves = []PMove(0)
  let pi = 0
  while (pi < len(cx.f.paramTypes)) {
    let regClass = regClassOf(cx.module.ctx, cx.f.paramTypes[pi])
    let ord = floatOrd
    if (regClass == RegClass.Int) {
      ord = intOrd
    }
    let dst = plocOf(cx, vregOf(cx, entry.instsStart + pi), regClass)
    let reg = argReg(regClass, ord)
    let src = plocMem(incomingArgOffset(cx.frame, stackIndex), regClass)
    if (reg < 0) {
      stackIndex = stackIndex + 1
    } else {
      src = plocReg(reg, regClass)
    }
    if (regClass == RegClass.Int) {
      intOrd = intOrd + 1
    } else {
      floatOrd = floatOrd + 1
    }
    moves = append(moves, PMove{ src: src, dst: dst })
    pi = pi + 1
  }
  sequentializeAndEmit(cx, moves)
}
