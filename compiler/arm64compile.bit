// Self-host Stage 3 (#1342): ARM64 instruction dispatch and the top-level
// per-function driver (register allocation, frame layout, emission), split out
// of arm64.bit (#1503). Sibling .bit file, same module: see arm64.bit.

// ===========================================================================
// Instruction dispatch
// ===========================================================================

// Which `const_int` definitions (#1853) an ADD/SUB-immediate fold, a
// bitmask AND/ORR/EOR-immediate fold (#3495), a power-of-two Mul (#3105) or a
// power-of-two SDiv/UDiv (#3104) consumes entirely, indexed by instruction
// id. `instrOperands` (opt.bit) is the SAME
// operand map DCE uses, so a constant with any use besides the one fold that
// reads it as an immediate keeps `false` and still materializes normally —
// this only marks a def whose sole structural use is that one fold. Mirrors
// `emitBinaryInt`/`emitMulInt`/`emitDivInt`'s own operand order exactly, so it
// never marks a value skipped that the emitter actually reads as a register.
//
// SRem/URem are deliberately excluded from the divide case even though
// `xConstPow2Divisor` accepts the same divisors: `emitDivInt` (arm64select.bit)
// only takes the shift path for SDiv/UDiv (#3104's own doc comment — msub
// still needs the real divisor register to recover a remainder), so marking
// the divisor skipped for a Rem would leave `emitDivInt`'s general path
// reading an unmaterialized register — the exact silent miscompile this
// function's `useCount == 1` guard exists to prevent.
fn computeSkipConstMaterialize(ctx: TypeContext, f: IrFunc): []bool {
  let n = len(f.instrs)
  let useCount = []int(0)
  let i = 0
  while (i < n) {
    useCount = append(useCount, 0)
    i = i + 1
  }
  i = 0
  while (i < n) {
    let ops = instrOperands(f, i)
    let k = 0
    while (k < len(ops)) {
      useCount[ops[k]] = useCount[ops[k]] + 1
      k = k + 1
    }
    i = i + 1
  }
  let skip = []bool(0)
  i = 0
  while (i < n) {
    skip = append(skip, false)
    i = i + 1
  }
  i = 0
  while (i < n) {
    let ins = f.instrs[i]
    if (ins.op == Op.Add || ins.op == Op.Sub) {
      let rc = constIntOf(f, ins.rhs)
      if (rc.known && resolveAddSubImm(ins.op, rc.ival).fits && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      } else if (ins.op == Op.Add) {
        let lc = constIntOf(f, ins.lhs)
        if (lc.known && resolveAddSubImm(ins.op, lc.ival).fits && useCount[ins.lhs] == 1) {
          skip[ins.lhs] = true
        }
      }
    } else if (ins.op == Op.Mul) {
      let w = widthOf(ctx, ins.ty)
      let factor = xConstPow2Factor(f, ins.lhs, ins.rhs, w)
      if (factor.k >= 0) {
        let constOp = ins.lhs
        if (factor.value == ins.lhs) {
          constOp = ins.rhs
        }
        if (useCount[constOp] == 1) {
          skip[constOp] = true
        }
      }
    } else if (ins.op == Op.BAnd || ins.op == Op.BOr || ins.op == Op.BXor) {
      let s = logicalConstSkip(f, ins.rhs, ins.lhs)
      if (s >= 0 && useCount[s] == 1) {
        skip[s] = true
      }
    } else if (ins.op == Op.SDiv || ins.op == Op.UDiv) {
      let w = widthOf(ctx, ins.ty)
      let pk = xConstPow2Divisor(f, ins.rhs, w)
      if (pk >= 0 && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      }
    }
    i = i + 1
  }
  return skip
}

// #3101: does `compileInst` write instruction `i`'s own allocated register?
//
// Mirrors the dispatch below, and DEFAULTS TO TRUE so the mirror can only ever
// fail safe: a new op, or one this list forgets, is treated as writing its
// register and is saved as before. Only the reverse — claiming a write does not
// happen when it does — could drop a live callee-saved value, so nothing goes in
// the false list without a `compileInst` arm that provably binds no destination:
//
//   * Jump/Br/Ret/Unreachable/FieldSet/IndexSet/AtomicStore pass no `i` to their
//     emitter at all; they only read operands.
//   * Call/CallValue/CallIface/RtCall/Asm route their destination through
//     `dstOrNone`, which answers -1 for a void result, and `emitCall`/`emitAsm`
//     each guard on that (arm64call.bit's `dst < 0`, emitAsm's `dst >= 0`).
//   * a `const_int` in `skipConst` is the one arm that materializes nothing;
//     `computeSkipConstMaterialize` above already proves its sole use reads it as
//     an immediate, never as a register, so nothing loads it either.
//
// block_param is deliberately absent: `moveBlockArgs` writes a param's register
// on every incoming edge, so it is a real definition even though `compileInst`
// never sees one.
fn arm64WritesResult(ctx: TypeContext, f: IrFunc, skipConst: []bool, i: int): bool {
  let ins = f.instrs[i]
  let op = ins.op
  if (op == Op.Jump || op == Op.Br || op == Op.Ret || op == Op.Unreachable ||
    op == Op.FieldSet || op == Op.IndexSet || op == Op.AtomicStore) {
    return false
  }
  if (op == Op.ConstInt) {
    return !skipConst[i]
  }
  if (op == Op.Call || op == Op.CallValue || op == Op.CallIface ||
    op == Op.RtCall || op == Op.Asm) {
    return ins.ty != ctx.voidId
  }
  return true
}

// Emits one instruction. `curBlock` is only needed to classify an edge as a
// back-edge.
fn compileInst(cx: A64Ctx, curBlock: int, i: int) {
  let ins = cx.f.instrs[i]
  let op = ins.op
  let ty = ins.ty
  let iw = widthOf(cx.module.ctx, ty) // result width: drives narrow re-canonicalization

  if (op == Op.ConstInt) {
    if (!cx.skipConst[i]) { emitConstInt(cx, i, ins.ival) }
    return
  }
  if (op == Op.ConstBool) { emitConstBool(cx, i, ins.bval); return }
  if (op == Op.ConstNil) { emitConstNil(cx, i); return }
  if (op == Op.ConstFloat) { emitConstFloat(cx, i, ins.fval, iw.bytes); return }
  if (op == Op.ConstString) { emitConstString(cx, i, ins.ival); return }
  if (op == Op.Add || op == Op.Sub || op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    emitBinaryInt(cx, op, i, ins.lhs, ins.rhs, iw)
    return
  }
  if (op == Op.Mul) {
    emitMulInt(cx, i, ins.lhs, ins.rhs, xConstPow2Factor(cx.f, ins.lhs, ins.rhs, iw), iw)
    return
  }
  if (op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem) {
    emitDivInt(cx, op, i, ins.lhs, ins.rhs, xConstPow2Divisor(cx.f, ins.rhs, iw), iw)
    return
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    emitShiftInt(cx, op, i, ins.lhs, ins.rhs, iw)
    return
  }
  if (isIcmp(op)) { emitIcmp(cx, op, i, ins.lhs, ins.rhs); return }
  if (op == Op.FAdd) { emitBinaryFloat(cx, FArithOp.Add, i, ins.lhs, ins.rhs, iw.bytes); return }
  if (op == Op.FSub) { emitBinaryFloat(cx, FArithOp.Sub, i, ins.lhs, ins.rhs, iw.bytes); return }
  if (op == Op.FMul) { emitBinaryFloat(cx, FArithOp.Mul, i, ins.lhs, ins.rhs, iw.bytes); return }
  if (op == Op.FDiv) { emitBinaryFloat(cx, FArithOp.Div, i, ins.lhs, ins.rhs, iw.bytes); return }
  if (isFcmp(op)) {
    // A float compare's operand width comes from the OPERANDS — its own result is
    // a bool.
    emitFcmp(cx, op, i, ins.lhs, ins.rhs, widthOf(cx.module.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return
  }
  if (op == Op.Neg || op == Op.BNot) { emitUnaryInt(cx, op, i, ins.lhs, iw); return }
  if (op == Op.Convert) { emitConvert(cx, i, ins.lhs, ty); return }
  if (op == Op.FNeg) { emitFneg(cx, i, ins.lhs, iw.bytes); return }
  if (op == Op.FSqrt) { emitFsqrt(cx, i, ins.lhs, iw.bytes); return }
  // FRINTM / FRINTP / FRINTZ / FRINTA — floor, ceil, truncate,
  // round-half-away-from-zero.
  if (op == Op.FFloor) { emitFRound(cx, i, ins.lhs, iw.bytes, 10); return }
  if (op == Op.FCeil) { emitFRound(cx, i, ins.lhs, iw.bytes, 9); return }
  if (op == Op.FTrunc) { emitFRound(cx, i, ins.lhs, iw.bytes, 11); return }
  if (op == Op.FRound) { emitFRound(cx, i, ins.lhs, iw.bytes, 12); return }
  // The width always comes from the FLOAT side — the integer view of an f32 is
  // 4 bytes wide whichever direction the transfer runs, and only one of the two
  // types carries a float width to read.
  if (op == Op.Bitcast) {
    let dstIsFloat = iw.regClass == RegClass.Float
    let bw = widthOf(cx.module.ctx, cx.f.instrs[ins.lhs].ty).bytes
    if (dstIsFloat) { bw = iw.bytes }
    emitBitcast(cx, i, ins.lhs, bw, dstIsFloat)
    return
  }
  if (op == Op.Jump) {
    emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival)
    moveBlockArgs(cx, ins.ival, ins.args)
    emitJumpFixup(cx, ins.ival)
    return
  }
  if (op == Op.Br) {
    cmpZero(cx.code, getInt(cx, vregOf(cx, ins.lhs), scratch1()))
    let elseFixup = emitLocalCondBranch(cx, condEq())
    emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival)
    moveBlockArgs(cx, ins.ival, ins.thenArgs)
    emitJumpFixup(cx, ins.ival)
    patchLocalCondBranch(cx, elseFixup)
    emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival2)
    moveBlockArgs(cx, ins.ival2, ins.elseArgs)
    emitJumpFixup(cx, ins.ival2)
    return
  }
  if (op == Op.Ret) {
    // Multi-value returns are lowered to a boxed tuple before codegen, so at most
    // one value reaches here.
    assert(len(ins.args) <= 1)
    if (len(ins.args) == 1) {
      let v = ins.args[0]
      if (regClassOf(cx.module.ctx, cx.f.instrs[v].ty) == RegClass.Int) {
        movRR(cx.code, retRegNum(), getInt(cx, vregOf(cx, v), scratch1()))
      } else {
        fmovFF(cx.code, retRegNum(), getFloat(cx, vregOf(cx, v), fscratch1()), 8)
      }
    }
    emitEpilogueAndRet(cx)
    return
  }
  if (op == Op.Unreachable) { emitUdf(cx.code); return }
  if (op == Op.Call) { emitCall(cx, dstOrNone(cx, i, ty), ty, ins.name, ins.args, true); return }
  if (op == Op.CallValue) { emitCallValue(cx, dstOrNone(cx, i, ty), ty, ins.lhs, ins.args); return }
  if (op == Op.CallIface) {
    emitCallIface(cx, dstOrNone(cx, i, ty), ty, ins.lhs, ins.ival, ins.args)
    return
  }
  if (op == Op.RtCall) {
    emitCall(cx, dstOrNone(cx, i, ty), ty, rtSymbol(ins.name), ins.args, true)
    return
  }
  if (op == Op.GcAlloc) { emitGcAlloc(cx, i, ins.ival, ins.offsets); return }
  if (op == Op.TypeInfo) { emitTypeInfo(cx, i, ins.ival, ins.ival2, ins.offsets); return }
  if (op == Op.FieldGet) {
    emitFieldGet(cx, i, ins.lhs, ins.ival, ty,
      cx.module.ctx.types[cx.f.instrs[ins.lhs].ty].kind == TypeKind.Slice)
    return
  }
  if (op == Op.FieldSet) {
    emitFieldSet(cx, ins.lhs, ins.ival, ins.rhs, cx.f.instrs[ins.rhs].ty)
    return
  }
  if (op == Op.IndexGet) { emitIndexGet(cx, i, ins.lhs, ins.rhs, ty); return }
  if (op == Op.IndexSet) {
    // index_set keeps its VALUE operand in ival (rhs is the index).
    emitIndexSet(cx, ins.lhs, ins.rhs, ins.ival, cx.f.instrs[ins.ival].ty)
    return
  }
  if (op == Op.SliceLen) { emitSliceLen(cx, i, ins.lhs); return }
  if (op == Op.AtomicLoad) { emitAtomicLoad(cx, i, ins.lhs, ty); return }
  if (op == Op.AtomicStore) {
    emitAtomicStore(cx, ins.lhs, ins.rhs, cx.f.instrs[ins.rhs].ty)
    return
  }
  if (op == Op.AtomicCmpxchg) {
    emitAtomicCmpxchg(cx, i, ins.lhs, ins.rhs, ins.ival)
    return
  }
  if (opIsAtomicRmw(op)) {
    emitAtomicRmw(cx, op, i, ins.lhs, ins.rhs, ty)
    return
  }
  if (op == Op.MakeClosure) { emitMakeClosure(cx, i, ins.name, ins.lhs); return }
  if (op == Op.FuncAddr) { emitFuncAddr(cx, i, ins.name); return }
  if (op == Op.GlobalAddr) { emitGlobalAddr(cx, i, ins.name); return }
  if (op == Op.StackMapsAddr) { emitStackMapsAddr(cx, i, ins.name); return }
  if (op == Op.Syscall) {
    emitSyscall(cx, i, ins.lhs, ins.args)
    return
  }
  if (op == Op.Asm) {
    emitAsm(cx, dstOrNone(cx, i, ty), ins.ival, ins.args)
    return
  }
  // block_param is never reached: every emission loop starts past a block's
  // params.
  assert(op != Op.BlockParam)
  assert(false) // unhandled op
}

// A void-typed instruction has no result to bind; -1 says so.
// emitAsm/emitSyscall moved to arm64asm.bit (#3283, pure move — line budget).

// Every arm64 register pinned by an `asm` block (`input`/`result`/clobber) or by
// a `syscall` in `f`, indexed by register number 0..31. The `memory` sentinel
// (254) falls outside the array and is skipped; `sp`/`xzr` (31) is never
// allocatable anyway.
fn collectReservedArm64(module: IrModule, f: IrFunc): []bool {
  let reserved = []bool(32)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    // §11.8: x8 holds the syscall number, x0..x5 the arguments, x0 the kernel's
    // return value. `svc` is a trap, not a `bl` — the Linux arm64 kernel ABI
    // preserves every other register, so unlike x64 there is nothing more to
    // exclude.
    if (ins.op == Op.Syscall) {
      reserved[syscallNrReg()] = true
      let regs = syscallArgRegs()
      let k = 0
      while (k < len(regs)) {
        reserved[regs[k]] = true
        k = k + 1
      }
    }
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      if (blk.hasResult && blk.resultArm64 < 32) {
        reserved[blk.resultArm64] = true
      }
      let j = 0
      while (j < len(blk.inArm64)) {
        if (blk.inArm64[j] < 32) {
          reserved[blk.inArm64[j]] = true
        }
        j = j + 1
      }
      j = 0
      while (j < len(blk.clobArm64)) {
        if (blk.clobArm64[j] < 32) {
          reserved[blk.clobArm64[j]] = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return reserved
}

fn dstOrNone(cx: A64Ctx, i: int, ty: int): int {
  if (ty == cx.module.ctx.voidId) {
    return -1
  }
  return i
}

fn isIcmp(op: Op): bool {
  return op == Op.ICmpEq || op == Op.ICmpNe || op == Op.ICmpSlt || op == Op.ICmpSle ||
    op == Op.ICmpSgt || op == Op.ICmpSge || op == Op.ICmpUlt || op == Op.ICmpUle ||
    op == Op.ICmpUgt || op == Op.ICmpUge
}

fn isFcmp(op: Op): bool {
  return op == Op.FCmpEq || op == Op.FCmpNe || op == Op.FCmpLt || op == Op.FCmpLe ||
    op == Op.FCmpGt || op == Op.FCmpGe
}

// ===========================================================================
// Top-level: register allocation, frame layout, emission
//
// Live-interval construction is backend-agnostic and lives in codegen.bit
// (`buildIntervals`), shared with x64.
// ===========================================================================

// How many of `args` overflow past the argument registers to the stack.
fn stackArgSlots(ctx: TypeContext, f: IrFunc, args: []int, baseIntOrd: int, baseFloatOrd: int): int {
  let intOrd = baseIntOrd
  let floatOrd = baseFloatOrd
  let slots = 0
  let i = 0
  while (i < len(args)) {
    let regClass = regClassOf(ctx, f.instrs[args[i]].ty)
    if (regClass == RegClass.Int) {
      if (intOrd >= maxArgRegs()) {
        slots = slots + 1
      }
      intOrd = intOrd + 1
    } else {
      if (floatOrd >= maxArgRegs()) {
        slots = slots + 1
      }
      floatOrd = floatOrd + 1
    }
    i = i + 1
  }
  return slots
}

// #3284: does `f` contain a division/remainder instruction whose runtime
// zero-check (#2016) reaches `emitCallReloc(cx, "bit_rt_panic_div_zero")`
// (arm64select.bit's emitDivInt)? That call is invisible to hasSafepoints —
// it isn't Op.Call/RtCall/CallValue/CallIface/GcAlloc/MakeClosure, so
// isSafepointOp never sees it — which is exactly the gap #2929's frameless
// optimization left open once a stack walker exists to be misled by it
// (spec/SPEC.md §18.6). bit_rt_panic_nil_call/_nil_iface do NOT need an
// equivalent check here: both are emitted only from emitCallValue/
// emitCallIface (arm64call.bit), and Op.CallValue/Op.CallIface are already
// in isSafepointOp, so any function containing either one already has
// hasSafepoints == true and is disqualified from `frameless` before this
// predicate would ever matter — hasSafepoints already covers them; it is
// deliberately not reused here because it does NOT cover div/rem.
//
// Mirrors emitDivInt's own accept/decline exactly, so this predicate can
// never disagree with what the emitter actually does: SDiv/UDiv skip the
// check (and the call) only on a divisor xConstPow2Divisor proves a known,
// positive power of two; SRem/URem are deliberately never reduced (#3104)
// and always emit the check, regardless of the divisor.
fn hasDivZeroGuard(ctx: TypeContext, f: IrFunc): bool {
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.SDiv || ins.op == Op.UDiv) {
      if (xConstPow2Divisor(f, ins.rhs, widthOf(ctx, ins.ty)) < 0) {
        return true
      }
    } else if (ins.op == Op.SRem || ins.op == Op.URem) {
      return true
    }
    i = i + 1
  }
  return false
}

// One compiled function: its machine code plus everything an object writer needs
// to place it.
class FuncCode {
  name: string,
  code: []u8,
  relocs: []Reloc,
  safepoints: []SafepointView,
  // Callee-saved registers this function's prologue preserves, and where
  // (frame-pointer-relative) it stashed the caller's value — the runtime stack
  // walker (runtime/ABI.md §4) restores them when unwinding.
  savedRegs: []SavedReg,
  frameSize: int,
  // #3283: this function's debug-info rows, in final code-emission order.
  // See emDebugLinesOf (compiler/emit.bit) for the row-0 fixup and
  // appendDebugLineIfChanged (compiler/codegen.bit) for how they're built.
  lines: []DebugLineRow,
}

// Compiles one function to ARM64 machine code. `debug` reaches only as far as
// `A64Ctx.debug` today (#3077) — later codegen tickets read it from there.
fn compileFunction(module: IrModule, f: IrFunc, debug: bool): FuncCode {
  let ctx = module.ctx
  let built = buildIntervals(ctx, f)
  let intervals = built.intervals

  // Any emitted safepoint is a bl (a real call/rt_call/etc. OR the synthetic
  // bit_rt_safepoint a loop back-edge inserts), and every bl clobbers the
  // caller-saved GPRs — so a function with ANY safepoint must draw only from the
  // callee-saved subset. built.safepoints is the exact set of bls buildIntervals
  // recorded (calls + back-edges), so it is the single source of truth; a bare
  // has-calls op scan missed the back-edge case, leaving a loop-carried value in
  // a caller-saved register that the back-edge safepoint then destroyed (#1236).
  let hasSafepoints = len(built.safepoints) > 0
  let intRegs = buildIntRegs(hasSafepoints)
  let floatRegs = buildFloatRegs(hasSafepoints)

  // #2925: does `f` close at least one loop back-edge with a real poll (the
  // exact predicate emitBackEdgeSafepointIfNeeded gates on)? Scanned ahead of
  // frame layout, independently of `built.safepoints` (which also counts
  // ordinary calls — fib has one of those and zero of these), so the
  // poll-address cache slots can be sized before emitPrologue runs. Implies
  // hasSafepoints: codegen.bit's own buildIntervals records the identical
  // back-edge under the identical guard, so a function with one always has
  // len(built.safepoints) > 0 already and is never frameless.
  let hasBackEdgePoll = hasBackEdgeSafepoint(f)
  let pollCacheSlots = 0
  if (hasBackEdgePoll) {
    pollCacheSlots = 2
  }
  assert(!hasBackEdgePoll || hasSafepoints)

  // Any physical register an `asm` block names (`input`/`result`/clobber) leaves
  // the allocatable file for the whole function, so no vreg can land in a
  // register the inline sequence overwrites (§11.6) — the same exclusion
  // div/shift/atomics use, generalized to an arbitrary set. Neither an `asm`
  // nor a `syscall` (§11.8) in this function leaves `intRegs` exactly as
  // `buildIntRegs` returned it.
  let reserved = collectReservedArm64(module, f)
  let allocRegs = []int(0)
  let ri = 0
  while (ri < len(intRegs)) {
    if (!reserved[intRegs[ri]]) {
      allocRegs = append(allocRegs, intRegs[ri])
    }
    ri = ri + 1
  }
  intRegs = allocRegs

  // No clobber positions, and that is not an omission (#3171). This backend
  // still uses the WHOLE-FUNCTION approximation above: buildIntRegs and
  // buildFloatRegs already hand back only the callee-saved subset — x19..x28
  // and d8..d15 — whenever `hasSafepoints`, so no vreg can be in a
  // call-clobbered register in the first place and the per-interval rule has
  // nothing left to restrict. x64 needs the rule because AAPCS64's d8..d15 have
  // no SysV counterpart: its callee-saved XMM subset is EMPTY, so the same
  // approximation there means no float register at all.
  //
  // `calleeSaved` is left 0 for the same reason: it is read only when clobber
  // positions are given, and giving none keeps this allocation register-for-
  // register what it was. Whoever widens either file here must set both — an
  // over-reported mask is a miscompile, not a missed optimization.
  let result = allocate(TargetRegs{
    intRegs: RegFile{ count: len(intRegs), calleeSaved: 0 },
    floatRegs: RegFile{ count: len(floatRegs), calleeSaved: 0 },
  }, intervals, built.safepoints, []int(0))

  let skipConst = computeSkipConstMaterialize(ctx, f)

  // Which callee-saved physical registers this allocation actually touched — only
  // those need saving. Scanned per-vreg (rather than over the locations alone)
  // since a bare register index is ambiguous between the int and float files
  // without its own class.
  //
  // #3101: an interval whose instruction WRITES no register is skipped. The
  // allocator hands out a location for every one of `buildIntervals`' dense
  // slots, including the ones its own doc comment calls "trivial, never-
  // referenced [i,i] interval; harmless filler" (terminators, field_set/
  // index_set, a void-typed call) — plus the `const_int` defs #1853/#3104/#3105
  // fold whole into an immediate and never materialize. Counting those as used
  // saved a register the body provably never writes, which made the prologue's
  // str/ldr pair a pure no-op and, when it was the only entry, kept an otherwise
  // frameless function paying a full frame record.
  let gprUsed = []bool(len(intRegs))
  let fprUsed = []bool(len(floatRegs))
  let vi = 0
  while (vi < len(intervals)) {
    let loc = result.locations[vi]
    if (!loc.isSpill && arm64WritesResult(ctx, f, skipConst, vi)) {
      if (intervals[vi].regClass == RegClass.Int) {
        gprUsed[loc.index] = true
      } else {
        fprUsed[loc.index] = true
      }
    }
    vi = vi + 1
  }
  let savedGpr = []int(0)
  let i = 0
  while (i < len(intRegs)) {
    if (gprUsed[i] && isCalleeSavedInt(intRegs[i])) {
      savedGpr = append(savedGpr, intRegs[i])
    }
    i = i + 1
  }
  let savedFpr = []int(0)
  i = 0
  while (i < len(floatRegs)) {
    if (fprUsed[i] && isCalleeSavedFloat(floatRegs[i])) {
      savedFpr = append(savedFpr, floatRegs[i])
    }
    i = i + 1
  }

  // Size the outgoing stack-argument area to the widest call this function makes:
  // the 9th+ argument of any class spills to the stack. Only real bls carry user
  // args — the synthetic back-edge safepoint, gc_alloc, and make_closure never
  // overflow.
  let outgoingSlots = 0
  i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    let need = 0
    if (ins.op == Op.Call || ins.op == Op.RtCall) {
      need = stackArgSlots(ctx, f, ins.args, 0, 0)
    } else if (ins.op == Op.CallValue || ins.op == Op.CallIface) {
      need = stackArgSlots(ctx, f, ins.args, 1, 0) // arg0 = env / receiver
    }
    if (need > outgoingSlots) {
      outgoingSlots = need
    }
    i = i + 1
  }
  let outgoingBytes = outgoingSlots * 8

  // #2929: elide the frame entirely when this function provably needs none.
  // `!hasSafepoints` is exactly "makes no call and closes no loop back-edge"
  // (isSafepointOp/buildIntervals above), so x30 is live across nothing; the
  // other three conditions cover the callee-saved/spill/outgoing-argument space
  // a frame record would otherwise exist to address. The standard fourth
  // condition, "takes no address of a local", is vacuous here — Bit has no
  // address-of operator (spec/SPEC.md §13) — so nothing ever needs this
  // function's frame to be stable.
  //
  // #3284 (revisits #2929): one call this backend emits is NOT in
  // `hasSafepoints` and used to be let through anyway — emitDivInt's inline
  // `bl bit_rt_panic_div_zero` guard (#2016), reachable from a bare SDiv/UDiv/
  // SRem/URem with no other call in the function. That was sound only as long
  // as "this backend's panic path never walks a frame chain at all"
  // (runtime/root/darwin/io.bit's `bit_rt_panic` doc comment) stayed true;
  // spec/SPEC.md §18.6 commits to a runtime stack walker (#3285) that makes it
  // false, so a div-zero panic inside an otherwise-frameless leaf must now
  // establish a real frame record for that walker to find — `hasDivZeroGuard`
  // (above) covers exactly this gap. A safepoint-bearing function
  // (CallValue/CallIface's own nil-check panics) never needed this: those ops
  // are already in `hasSafepoints`, which already excludes it from `frameless`
  // — hasSafepoints is reused for that half and is NOT reused for div/rem,
  // because it does not cover div/rem.
  let panicReachable = hasDivZeroGuard(ctx, f)
  let frameless = !f.isNaked && !hasSafepoints && !panicReachable &&
    result.numSpillSlots == 0 && len(savedGpr) == 0 && len(savedFpr) == 0 && outgoingBytes == 0

  let frameSize = 0
  if (!frameless) {
    frameSize = alignFrame16(outgoingBytes + 16 + pollCacheSlots * 8 +
      len(savedGpr) * 8 + len(savedFpr) * 8 + result.numSpillSlots * 8)
    // Every access this backend emits into the frame uses the unsigned-imm12
    // form when it fits: 4095*8 bytes reaches any realistic frame. Larger
    // frames still work (via the register-offset fallback) but that path is
    // untested at this scale — assert the common case explicitly.
    assert(frameSize < 4096 * 4096)
  }

  let frame = FrameInfo{ savedGpr: savedGpr, savedFpr: savedFpr,
    numSpillSlots: result.numSpillSlots, outgoingBytes: outgoingBytes,
    pollCacheSlots: pollCacheSlots, frameSize: frameSize, frameless: frameless }

  // §10.3.1 @naked safety net: the prologue is suppressed, so a spill slot,
  // saved register, or outgoing-arg area would silently corrupt the caller.
  // (frameSize itself is never 0 — arm64 always budgets the 16-byte frame
  // record — but a naked fn allocates none of it.) Rules 1+2 make this
  // unreachable; assert rather than paper over it.
  assert(!f.isNaked || (result.numSpillSlots == 0 && len(savedGpr) == 0 &&
    len(savedFpr) == 0 && outgoingBytes == 0))

  let instToVreg = []int(0)
  i = 0
  while (i < len(intervals)) {
    instToVreg = append(instToVreg, i)
    i = i + 1
  }

  let cx = A64Ctx{
    module: module,
    f: f,
    code: newByteBuf(),
    relocs: []Reloc(0),
    instToVreg: instToVreg,
    result: result,
    intRegs: intRegs,
    floatRegs: floatRegs,
    frame: frame,
    blockOffsets: []int(len(f.blocks)),
    jumpFixups: []JumpFixup(0),
    safepoints: []SafepointView(0),
    safepointPositions: built.safepoints,
    nextSafepointIdx: 0,
    skipConst: skipConst,
    wroteInt: []bool(32),
    wroteFloat: []bool(32),
    debug: debug,
    dbgRows: []DebugLineRow(0),
  }

  // §10.3.1 @naked: no prologue — the function runs on its caller's frame.
  // #2929 frameless: same effect, proved rather than declared.
  if (!f.isNaked && !frame.frameless) {
    emitPrologue(cx)
  }
  bindIncomingArgs(cx)
  // #2925: after incoming args are off the ABI registers and onto their real
  // (callee-saved, since hasSafepoints) homes — otherwise these two calls'
  // caller-saved clobber would destroy an argument still sitting in x0..x7.
  emitPollCachePrefetch(cx)

  // Emit every block in its original (emission) order.
  let bi = 0
  while (bi < len(f.blocks)) {
    cx.blockOffsets[bi] = codeLen(cx)
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    while (idx < b.instsStart + b.instsLen) {
      // #3283: record this instruction's source position before it emits
      // any code, so the row's pcOffset names where it actually starts.
      cx.dbgRows = appendDebugLineIfChanged(cx.dbgRows,
        debugPosOf(cx.module.sm, f.instrs[idx].span), codeLen(cx))
      compileInst(cx, bi, idx)
      idx = idx + 1
    }
    bi = bi + 1
  }
  patchJumpFixups(cx)

  // #3101: emission is finished, so `cx.wroteInt`/`cx.wroteFloat` now hold every
  // physical register a vreg actually resolved to. Every callee-saved one must be
  // in the save set the frame was laid out from — otherwise this function
  // clobbers a register its caller expects back, which no test can see until the
  // caller's value happens to matter. A @naked function saves nothing by
  // contract (§10.3.1) and owns the whole file itself, so it is exempt.
  if (!f.isNaked) {
    assertSavedCoversWrites(cx)
  }

  // Register-recovery slots: the prologue saves savedGpr[i] at gprSaveOffset(i)
  // from sp; convert to x29-relative (fp = sp + frameSize - 16) so the runtime
  // walker reads *(x29 + fpOff).
  let fpBase = savedFpOffset(frame)
  let savedRegs = []SavedReg(0)
  i = 0
  while (i < len(frame.savedGpr)) {
    savedRegs = append(savedRegs, SavedReg{ reg: frame.savedGpr[i],
      fpOff: gprSaveOffset(frame, i) - fpBase })
    i = i + 1
  }

  return FuncCode{ name: f.name, code: cx.code.bytes, relocs: cx.relocs,
    safepoints: cx.safepoints, savedRegs: savedRegs, frameSize: frameSize,
    lines: cx.dbgRows }
}

// Establishes the frame record and saves the callee-saved registers this
// function's allocation touched.
fn emitPrologue(cx: A64Ctx) {
  addSubImmWide(cx.code, true, regSp(), regSp(), cx.frame.frameSize)
  // x29 and x30 sit in consecutive slots by construction (savedLrOffset is
  // savedFpOffset + 8), so the frame record is one stp on any frame the signed
  // imm7 reaches — #3509. Nothing about WHERE either lands changes, so the
  // stack maps this function also emits are unaffected.
  frameRun(cx.code, [29, 30], false, false, regSp(), savedFpOffset(cx.frame))
  addSubImmWide(cx.code, false, 29, regSp(), savedFpOffset(cx.frame))
  frameRun(cx.code, cx.frame.savedGpr, false, false, regSp(),
    gprSaveOffset(cx.frame, 0))
  frameRun(cx.code, cx.frame.savedFpr, true, false, regSp(),
    fprSaveOffset(cx.frame, 0))
}

// Binds the incoming arguments into the entry block's params. The mirror of
// marshalArgs: params 1-8 of each class arrive in the ABI registers; the rest sit
// just above this frame at [sp + frameSize + 8*k] (the caller's outgoing area).
//
// ponytail: the entry block is block 0. The seed carries an explicit
// Function.entry, but every one of its five finish() call sites passes the first
// block its builder created — so entry is always 0 today. If a lowering ever
// creates a block before the entry block, IrFunc needs the field.
fn bindIncomingArgs(cx: A64Ctx) {
  let entry = cx.f.blocks[0]
  let intOrd = 0
  let floatOrd = 0
  let stackIndex = 0
  // One parallel move covering both classes (#3182).
  let moves = []PMove(0)
  let pi = 0
  while (pi < len(cx.f.paramTypes)) {
    let regClass = regClassOf(cx.module.ctx, cx.f.paramTypes[pi])
    let ord = floatOrd
    if (regClass == RegClass.Int) {
      ord = intOrd
    }
    let dst = plocOf(cx, vregOf(cx, entry.instsStart + pi), regClass)
    let reg = argReg(regClass, ord)
    let src = plocMem(incomingArgOffset(cx.frame, stackIndex), regClass)
    if (reg < 0) {
      stackIndex = stackIndex + 1
    } else {
      src = plocReg(reg, regClass)
    }
    if (regClass == RegClass.Int) {
      intOrd = intOrd + 1
    } else {
      floatOrd = floatOrd + 1
    }
    moves = append(moves, PMove{ src: src, dst: dst })
    pi = pi + 1
  }
  sequentializeAndEmit(cx, moves)
}
