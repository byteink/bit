// In-Bit self-checks for compiler/mainpaths.bit's path-splitting helpers
// (#4186). Split into its own sibling file rather than growing
// selfcheck.bit further; same module, so `selfcheck()` still calls this
// directly with no import.
//
// COVERAGE, STATED HONESTLY: `hostBackslashSep()` answers from `hostTarget()`,
// a real runtime primitive baked into the per-target libbitrt THIS BINARY
// links against — it cannot be mocked from inside a running process, and this
// binary is built for whichever host is running this check (never Windows in
// this repo's own gates, since no gate here runs on Windows hardware). So:
//
//   - `checkMainPathsPosixHost` runs the real, unmocked `pathDir`/`pathBase`/
//     `pathStem` end-to-end on THIS (POSIX) host, and is exactly the test
//     #4186 requires: it WOULD FAIL if `isPathSepByte` ever treated '\' as a
//     separator unconditionally, because a file named "a\b.txt" would then
//     wrongly split into directory "a" / base "b.txt" instead of staying one
//     component.
//   - `checkIsPathSepByte` drives the isolated decision function directly
//     with an explicit `winSep` argument, so BOTH branches (Windows and
//     POSIX) of the separator rule are exercised deterministically here —
//     but this is unit coverage of the boundary, not proof that `pathDir` et
//     al. behave correctly when `hostTarget()` itself reports Windows.
//   - THAT end-to-end claim — a real Windows host running this same binary
//     and correctly splitting a native backslash path — is NOT covered by
//     anything in this POSIX-only gate. It was verified separately on real
//     Windows hardware (mustafa-desktop-win, a cross-linked bit.exe); see
//     #4186's ticket comments for that transcript, not this file.

fn checkMainPathsPosixHost() {
  // Ordinary '/'-separated paths: unchanged baseline behavior.
  assert(pathDir("examples/hello.bit") == "examples")
  assert(pathDir("a.bit") == ".")
  assert(pathDir("/a/b.bit") == "/a")
  assert(pathDir("/a.bit") == "/")
  assert(pathBase("examples/hello.bit") == "hello.bit")
  assert(pathBase("a.bit") == "a.bit")
  assert(pathStem("examples/hello.bit") == "hello")
  assert(pathStem("a.bit") == "a")

  // The POSIX-safety proof: '\' is a legal POSIX filename byte (a file
  // literally named "a\b.txt" is valid on macOS/Linux), so on THIS host —
  // genuinely not Windows, via the real unmocked hostTarget() — none of the
  // three helpers may treat it as a separator. A regression that made
  // isPathSepByte ignore `winSep` would flip every assert below.
  assert(pathDir("a\\b.txt") == ".")
  assert(pathBase("a\\b.txt") == "a\\b.txt")
  assert(pathStem("a\\b.txt") == "a\\b")
  assert(pathDir("dir/a\\b.txt") == "dir")
  assert(pathBase("dir/a\\b.txt") == "a\\b.txt")

  // stripTrailingSlashes (buildout.bit) and isUsableProjectName
  // (pmcliinit.bit) share the same host-conditional decision; a POSIX
  // filename ending in '\' or holding one is likewise left alone here.
  assert(stripTrailingSlashes("foo\\") == "foo\\")
  assert(stripTrailingSlashes("foo/") == "foo")
  assert(isUsableProjectName("a\\b"))
  assert(!isUsableProjectName("a/b"))
}

// The separator decision in isolation, both branches — the part of #4186's
// fix that a POSIX-only gate CAN prove deterministically, since `winSep` is
// an explicit parameter rather than read from the real host.
fn checkIsPathSepByte() {
  assert(isPathSepByte(u8(47), false)) // '/' is always a separator
  assert(isPathSepByte(u8(47), true))
  assert(!isPathSepByte(u8(92), false)) // '\' -- POSIX: never
  assert(isPathSepByte(u8(92), true))   // '\' -- Windows: yes
  assert(!isPathSepByte(u8(97), false)) // 'a' -- never, either host
  assert(!isPathSepByte(u8(97), true))
}
