// bit — bit.json's ROOT-ONLY "link" array: external `.a`/`.o` paths handed
// to the linker (#5711), resolved and read into bytes here, then threaded
// by `buildIr` (build.bit) through `IrModule.linkArchives` into both the
// §11.7 admission gate (`rejectExternForTarget`'s `extraArchives`,
// buildextern.bit/#5712) and the real link step (`emitAndLinkExe`, #5713).
// Sibling of build.bit (same module).
//
// "Root-only" is enforced STRUCTURALLY, not by a runtime check:
// `readLinkArchives` takes exactly one directory argument and has no
// recursive-descent path into a dependency tree at all. `buildIr`
// (build.bit) is its only caller, and always passes its own `rootDir` —
// never a path `loadProject` recurses into for a fetched dependency's own
// directory (that recursion goes through `readManifest` directly, in
// pmz.bit/pmztrans.bit, never through this file). A fetched package naming
// an archive to link would be arbitrary-file inclusion at build time — the
// install-time-code-execution hazard SPEC §17.7 already forbids for every
// other field a dependency's own manifest could carry.

// The external archive/object paths bit.json's root "link" array names,
// resolved to absolute paths under `rootDir` via `pathJoinResolve`
// (project.bit) — the same helper this codebase's other path resolution
// already uses, never a second one.
//
// `rootDir + "/bit.json"` missing, or present with no "link" key, is not an
// error: an empty result, same as manifestProjectName's "no name" (buildout.bit)
// degrades on a field nobody set. `"link"` present but not a JSON array of
// strings — a bare string, a number, an object, a non-string element — IS an
// error: silently returning `[]` on a malformed manifest would make a bad
// "link" field build clean and quietly link nothing, which is the worst kind
// of bug because it looks like it worked.
export fn readLinkArchives(rootDir: string): []string! {
  let doc = readManifest(rootDir)?
  let linkId = jsonGet(doc, doc.root, "link")
  if (!jsonHas(doc, linkId)) {
    return []string(0)
  }
  if (jsonKindOf(doc, linkId) != JsonKind.Arr) {
    fail newError("bit.json: \"link\" must be an array of archive/object path strings")
  }
  let out = []string(0)
  let n = jsonLen(doc, linkId)
  let i = 0
  while (i < n) {
    let itemId = jsonAt(doc, linkId, i)
    if (!jsonHas(doc, itemId) || jsonKindOf(doc, itemId) != JsonKind.Str) {
      fail newError("bit.json: \"link\"[${i}] must be a string path")
    }
    out = append(out, pathJoinResolve(rootDir, jsonStrOf(doc, itemId)))
    i = i + 1
  }
  return out
}

// Proves `readLinkArchives`'s result is reachable from `buildIr`: every
// resolved path is non-empty, since `pathJoinResolve` never returns "".
fn assertLinkArchivesResolved(archives: []string) {
  let i = 0
  while (i < len(archives)) {
    assert(len(archives[i]) > 0)
    i = i + 1
  }
}

// Reads each of `paths`' bytes, in order -- the resolved absolute paths
// `readLinkArchives` returned -- and confirms each one parses as an `ar`
// archive at all (`parseArchive`, archive.bit -- the same GNU/BSD-detecting
// reader every backend's own `*ArchiveDefines` already builds on, so this
// asks nothing a real link would not itself need to answer).
//
// A path that does not exist, cannot be read, or does not parse as `ar`
// fails the BUILD, naming the path and the bit.json it came from, rather
// than degrading to a silently shorter (or empty) archive list: a name
// missing from `extraArchives` only because its OWN read failed would look
// identical to "this symbol genuinely is not in the archive" (E0078) --
// exactly the debugging trap #3579 exists to close. A member that parses as
// `ar` but holds the wrong target's object format is left to the existing
// per-target membership check (machoArchiveDefines/peArchiveDefines/
// archiveDefines), which already treats "cannot read this member" as "does
// not define this symbol" rather than silently dropping the whole archive.
fn readLinkArchiveBytes(rootDir: string, paths: []string): [][]u8! {
  let manifestPath = pmJoin(rootDir, "bit.json")
  let out = [][]u8(0)
  let i = 0
  while (i < len(paths)) {
    let path = paths[i]
    let text = readFile(path) catch e {
      fail newError("${manifestPath}: \"link\" archive ${path}: ${e.message()}")
    }
    let bytes = []byte(text)
    parseArchive(bytes) catch e {
      fail newError("${manifestPath}: \"link\" archive ${path} is not a valid ar archive: ${e.message()}")
    }
    out = append(out, bytes)
    i = i + 1
  }
  return out
}

// `buildIr`'s one call site into this file: resolve bit.json's "link" array
// under `rootDir`, then read every entry's bytes. Bundled into one function
// (rather than three calls at the call site) so a change to this file's own
// internal plumbing never touches `buildIr`'s line count or param list.
export fn resolveLinkArchives(rootDir: string): [][]u8! {
  let paths = readLinkArchives(rootDir)?
  assertLinkArchivesResolved(paths)
  return readLinkArchiveBytes(rootDir, paths)?
}

// ---- self-checks (compiler/selfcheck.bit's selfcheckPhaseProject calls
// these directly; sibling .bit files are one module) -----------------------

// A well-formed "link" array resolves each entry to an absolute path under
// the root — the ordinary case.
fn checkReadLinkArchivesResolvesArray() {
  let root = pmCheckScratchDir()
  let dir = root + "/link-array"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/bit.json", "{\n  \"link\": [\"lib/a.a\"]\n}\n") catch e {
    panic("buildlink: cannot write bit.json: " + e.message())
  }
  let archives = readLinkArchives(dir) catch e {
    panic("buildlink: readLinkArchives(dir) unexpectedly failed: " + e.message())
  }
  assert(len(archives) == 1)
  // pathResolve (project.bit), not raw concatenation: pmCheckScratchDir
  // builds `dir` off TMPDIR, which on this machine already ends in "/", so
  // `dir + "/lib/a.a"` would carry a "//" pathJoinResolve's own lexical
  // resolution never emits.
  assert(archives[0] == pathResolve(dir + "/lib/a.a"))

  removeTree(root, pmCheckTimeoutMs)
}

// No bit.json at all is not an error: nothing to reconcile, same as
// manifestLockProblem's own no-files case.
fn checkReadLinkArchivesNoManifest() {
  let root = pmCheckScratchDir()
  let dir = root + "/no-manifest"
  pmCheckMkdirAll(dir)
  let archives = readLinkArchives(dir) catch e {
    panic("buildlink: readLinkArchives(dir) unexpectedly failed: " + e.message())
  }
  assert(len(archives) == 0)

  removeTree(root, pmCheckTimeoutMs)
}

// A bit.json with no "link" key at all is not an error either.
fn checkReadLinkArchivesNoLinkKey() {
  let root = pmCheckScratchDir()
  let dir = root + "/no-link-key"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/bit.json", "{\n  \"name\": \"demo\"\n}\n") catch e {
    panic("buildlink: cannot write bit.json: " + e.message())
  }
  let archives = readLinkArchives(dir) catch e {
    panic("buildlink: readLinkArchives(dir) unexpectedly failed: " + e.message())
  }
  assert(len(archives) == 0)

  removeTree(root, pmCheckTimeoutMs)
}

// `readLinkArchives`'s failure message, or "" on success — same shape as
// pmCliTryBuildIrMessage (pmmanifestcheck.bit).
fn pmTryReadLinkArchivesMessage(dir: string): string {
  readLinkArchives(dir) catch e {
    return e.message()
  }
  return ""
}

// `readLinkArchiveBytes`'s failure message, or "" on success — same shape as
// pmTryReadLinkArchivesMessage above.
fn pmTryReadLinkArchiveBytesMessage(dir: string, paths: []string): string {
  readLinkArchiveBytes(dir, paths) catch e {
    return e.message()
  }
  return ""
}

// "link" present but not an array must FAIL, not degrade to []: a wrong
// shape is a real parse error (this file's own header explains why).
fn checkReadLinkArchivesRejectsNonArrayShape() {
  let root = pmCheckScratchDir()
  let dir = root + "/link-not-array"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/bit.json", "{\n  \"link\": \"not-an-array\"\n}\n") catch e {
    panic("buildlink: cannot write bit.json: " + e.message())
  }
  let message = pmTryReadLinkArchivesMessage(dir)
  assert(message != "")
  assert(pkgTestContains(message, "link"))

  removeTree(root, pmCheckTimeoutMs)
}

// A fetched-dependency-shaped directory nested under the root, with its own
// "link" array, must never be read: `readLinkArchives(dir)` takes exactly
// the outer root and returns only ITS OWN "link" entries.
fn checkReadLinkArchivesIgnoresDependencyDir() {
  let root = pmCheckScratchDir()
  let dir = root + "/root-project"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/bit.json", "{\n  \"link\": [\"lib/a.a\"]\n}\n") catch e {
    panic("buildlink: cannot write root bit.json: " + e.message())
  }
  let depDir = dir + "/vendor/evil-dep"
  pmCheckMkdirAll(depDir)
  writeFile(depDir + "/bit.json", "{\n  \"link\": [\"lib/evil.a\"]\n}\n") catch e {
    panic("buildlink: cannot write dependency bit.json: " + e.message())
  }
  let archives = readLinkArchives(dir) catch e {
    panic("buildlink: readLinkArchives(dir) unexpectedly failed: " + e.message())
  }
  assert(len(archives) == 1)
  assert(archives[0] == pathResolve(dir + "/lib/a.a"))

  removeTree(root, pmCheckTimeoutMs)
}

// A resolved path that IS a well-formed (empty) `ar` archive reads back its
// exact bytes — the ordinary case `readLinkArchiveBytes` exists for.
fn checkReadLinkArchiveBytesReadsArchive() {
  let root = pmCheckScratchDir()
  let dir = root + "/bytes-ok"
  pmCheckMkdirAll(dir)
  let archiveBytes = writeArchive([]ArMember(0), arFormatGnu())
  writeFile(dir + "/a.a", string(archiveBytes)) catch e {
    panic("buildlink: cannot write a.a: " + e.message())
  }
  let bytes = readLinkArchiveBytes(dir, [dir + "/a.a"]) catch e {
    panic("buildlink: readLinkArchiveBytes unexpectedly failed: " + e.message())
  }
  assert(len(bytes) == 1)
  assert(len(bytes[0]) == len(archiveBytes))

  removeTree(root, pmCheckTimeoutMs)
}

// A resolved path readLinkArchives named but nothing wrote to disk must FAIL,
// naming the path — the "silently skip a missing archive" trap this file's
// own header warns against.
fn checkReadLinkArchiveBytesRejectsMissingPath() {
  let root = pmCheckScratchDir()
  let dir = root + "/bytes-missing"
  pmCheckMkdirAll(dir)
  let missing = dir + "/nope.a"
  let message = pmTryReadLinkArchiveBytesMessage(dir, [missing])
  assert(message != "")
  assert(pkgTestContains(message, missing))

  removeTree(root, pmCheckTimeoutMs)
}

// A path that exists but is not a valid `ar` archive must FAIL too, naming
// the path — the same trap, one step later: the file reads fine, only its
// shape is wrong.
fn checkReadLinkArchiveBytesRejectsMalformedArchive() {
  let root = pmCheckScratchDir()
  let dir = root + "/bytes-malformed"
  pmCheckMkdirAll(dir)
  let bad = dir + "/bad.a"
  writeFile(bad, "not an archive") catch e {
    panic("buildlink: cannot write bad.a: " + e.message())
  }
  let message = pmTryReadLinkArchiveBytesMessage(dir, [bad])
  assert(message != "")
  assert(pkgTestContains(message, bad))

  removeTree(root, pmCheckTimeoutMs)
}
