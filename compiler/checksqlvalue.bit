// compiler/checksqlvalue.bit — `sqlValue<V>` (std/sql, #6256): turning a
// plain Bit value into `std/sql`'s `Value` at compile time, so a package can
// write `where<V>(col: string, v: V) { ...sqlValue(v)... }` and a caller
// writes `where("email", email)` — never `Value.Text(email)`.
//
// WHY THIS IS NOT `jsonDecode<T>`'s OWN MECHANISM, despite the same "generic
// expanded per instantiation" phrasing. `jsonDecode<T>`
// (classjsondecodecall.bit) resolves `T` SYNTACTICALLY, before any Checker
// exists, by matching the type argument's literal identifier text — which
// only works because `T` is always WRITTEN at the call (`jsonDecode<User>(j)`).
// `sqlValue(v)` never writes `V`; it is inferred from `v`'s own type the same
// way any ordinary generic call infers a parameter-position type argument
// (SPEC §15.3) — a purely syntactic pass cannot know a variable's type. So
// this hooks the pipeline LATER: after ordinary checking has already computed
// and recorded each call's concrete type argument in the instantiation
// ledger (`TypeContext.instantiations`, the same bookkeeping every generic
// call gets), classifies that concrete type, and retargets the ledger
// entry's `decl` at a hand-written specialisation — the same RETARGET half
// `jsonDecode<T>`'s own generic-composability extension uses
// (classjsondecodegeneric.bit/classjsondecodegenericretarget.bit), minus
// that extension's own complexity, for two reasons:
//
//   - every target here (`Value.Text`, `Value.Int`, ...) already lives in
//     `std/sql` itself — unlike a `@json` class, which can be declared in any
//     module, there is no cross-module symbol to synthesize or retarget
//     into, so the ten specialisations below are plain, hand-written,
//     ordinary Bit functions, never AST-synthesized;
//   - because the retarget classifies each ledger entry's OWN resolved
//     `args` (concrete by construction — the ledger only ever records a
//     concrete instantiation) rather than matching written syntax, a call to
//     `sqlValue(v)` INSIDE ANOTHER GENERIC (`where<V>` calling `sqlValue(v)`
//     with `v: V`) composes for free: monomorphizing the outer generic
//     substitutes `V` throughout its body, including in the nested call,
//     before this retarget ever runs — there is no "type parameter is not a
//     name" problem to work around, because nothing here ever resolves by
//     name. This is deliberately NOT exercised by pkg/orm in this ticket
//     (out of scope, #6256's own text) but is the reason this file does not
//     need classjsondecodegenericretarget.bit's ledger-propagation closure.
//
// WHY NOT AN INTERFACE THE PRIMITIVES SATISFY. SPEC §14.3: only a class or
// enum type can satisfy an interface — an interface value IS the receiver's
// object pointer, and a scalar has no method set and no object to point at.
// `string`/`int`/`bool`/`f64`/`[]byte` can never implement one, so this
// candidate is not merely worse, it does not typecheck.
//
// WHY NOT OVERLOADING. Bit has none (SPEC §10.3: "One `init` per class; a
// second is a compile error" generalizes — there is no per-signature
// dispatch anywhere in the language), so `sqlValue(v: string)` and
// `sqlValue(v: int)` cannot coexist as two declarations of the same name.
//
// THE CLOSED SET. `V` is `string`, `int`/`i64` (an alias, SPEC §11.1 — one
// type, one kind), `bool`, `f64`, `[]byte`, or `Option<>` of one of those
// (`Option.None` maps to `Value.Null`). Anything else is a compile error
// naming the type — **E0177**. An enum stored as text is NOT part of this
// slice: it needs its own design question (which representation of a
// variant counts as "text"?) the ticket's acceptance never exercises: left
// for a follow-up.

// E0177 (#6256): `sqlValue<V>` instantiated with a `V` outside the closed
// set string/int/i64/bool/f64/[]byte/Option<> of one of those.
const ecSqlValueBadType = 177

const sqlValueModulePath = "std/sql"
const sqlValueFuncName = "sqlValue"

// The module id `std/sql` was loaded as, found off any OTHER module's own
// import map — mirrors `jsonStdModuleId` (classjsondecodegenericretarget.bit)
// exactly, for the identical reason: `std/sql` cannot import itself (E0044),
// so its own id is read off an importer instead.
fn sqlValueStdModuleId(mods: []Checker): int {
  let i = 0
  while (i < len(mods)) {
    let (id, ok) = mods[i].importPaths[sqlValueModulePath]
    if (ok && id >= 0 && id < len(mods)) {
      return id
    }
    i = i + 1
  }
  return -1
}

// The five non-Option base kinds `sqlValue` accepts, by concrete TypeId —
// `""` for anything else. Prim numbers are the seed's own order
// (`compiler/types.bit`'s `primName`): i64=3, u8=4, f64=9, bool=10,
// string=11 — the same bare integers roughly ninety other call sites already
// match against (types.bit's own comment on why they are never named consts).
// The kind of one of the four accepted PRIM numbers, `""` for any other —
// split out of `sqlValueBaseKindOfType` to keep its own complexity under
// `spec/LINT.md`'s ceiling (E0204).
fn sqlValuePrimKind(prim: int): string {
  if (prim == 3) {
    return "int"
  }
  if (prim == 9) {
    return "float"
  }
  if (prim == 10) {
    return "bool"
  }
  if (prim == 11) {
    return "text"
  }
  return ""
}

fn sqlValueBaseKindOfType(ctx: TypeContext, arg: int): string {
  if (arg <= 0 || arg >= len(ctx.types)) {
    return ""
  }
  let t = ctx.types[arg]
  if (t.kind == TypeKind.Prim) {
    return sqlValuePrimKind(t.prim)
  }
  if (t.kind == TypeKind.Slice &&
    ctx.types[t.elem].kind == TypeKind.Prim &&
    ctx.types[t.elem].prim == 4) {
    return "blob"
  }
  return ""
}

// The full closed set: a base kind, or `"opt_" + base` for `Option<>` of one
// (`Option.None` included — its own type is still `Option<base>`, resolved by
// ordinary inference same as `Some`'s payload). `""` for anything else,
// which is what makes E0177 fire.
fn sqlValueKindOfType(ctx: TypeContext, arg: int): string {
  let base = sqlValueBaseKindOfType(ctx, arg)
  if (base != "") {
    return base
  }
  if (arg <= 0 || arg >= len(ctx.types)) {
    return ""
  }
  let t = ctx.types[arg]
  if (t.kind != TypeKind.Enum || !t.hasName || t.name != "Option") {
    return ""
  }
  let (payloads, ok) = ctx.variantPayloads["${arg}.Some"]
  if (!ok || len(payloads) != 1) {
    return ""
  }
  let inner = sqlValueBaseKindOfType(ctx, payloads[0])
  if (inner == "") {
    return ""
  }
  return "opt_" + inner
}

// The hand-written specialisation's name for one kind — shared by the
// retarget (which looks it up) and `stdlib/sql/sql.bit` (which declares it),
// so the two can never spell it differently.
fn sqlValueSpecName(kind: string): string {
  return "__sql_value_${kind}"
}

// The one authoritative check that a `sqlValue<V>` instantiation can be
// resolved. Runs after every module is checked (checkproject.bit), so the
// ledger already holds every instantiation the check pass recorded — what
// makes `bit check` and `bit build` agree; the retarget below runs during
// lowering, which `bit check` never reaches.
fn validateSqlValueGenerics(mods: []Checker) {
  let sm = sqlValueStdModuleId(mods)
  if (sm < 0) {
    return
  }
  let ctx = mods[0].ctx
  let d = mods[0].diags
  let i = 0
  while (i < len(ctx.instantiations)) {
    let inst = ctx.instantiations[i]
    if (inst.module == sm && inst.name == sqlValueFuncName) {
      validateSqlValueInstance(d, ctx, inst)
    }
    i = i + 1
  }
}

fn validateSqlValueInstance(d: Diagnostics, ctx: TypeContext, inst: Instantiation) {
  let arg = 0
  if (len(inst.args) == 1) {
    arg = inst.args[0]
  }
  if (sqlValueKindOfType(ctx, arg) != "") {
    return
  }
  reportSqlValueBadType(d, ctx, inst.site, arg)
}

// The E0177 diagnostic itself, shared by an explicit `sqlValue(v)` call
// (`validateSqlValueInstance` above) and a `Value`-typed CALL ARGUMENT
// outside the closed set (`vSqlValueArgCoerced` below, #6280) — the two
// spellings a program can trigger this from must read identically, since
// `db.exec(sql, badValue)` is defined (SPEC, next to `sqlValue<V>`) as
// exactly `db.exec(sql, sqlValue(badValue))` would have been.
fn reportSqlValueBadType(d: Diagnostics, ctx: TypeContext, site: Span, arg: int) {
  report(
    d, ecSqlValueBadType, site,
    "'sqlValue' cannot turn '${typeName(ctx, arg)}' into a 'std/sql' 'Value'",
    "'sqlValue<V>' accepts 'string', 'int'/'i64', 'bool', 'f64', '[]byte', or 'Option<>' of one of those — wrap '${typeName(
      ctx,
      arg,
    )}' yourself with the matching 'Value' variant instead",
  )
}

// `std/sql`'s own `Value` enum TypeId, or 0 when `std/sql` is not imported
// anywhere in this build (`sqlValueStdModuleId`'s own guard) — the
// parameter-type identity `vSqlValueArgCoerced`/`sqlValueCoerceIfNeeded`
// below compare a declared parameter type against, exactly as
// `sqlValueSpecName`'s lookup key is shared between the checker and the
// lowerer. Read off `std/sql`'s own `userTypes`, the same table
// `userTypeLookup` reads for a name declared IN the current module — `Value`
// is declared in `std/sql` itself, so this is that same table on the
// resolved importer's checker instead of `c`'s own.
fn sqlValueTypeId(mods: []Checker): int {
  let sm = sqlValueStdModuleId(mods)
  if (sm < 0) {
    return 0
  }
  let (v, ok) = mods[sm].userTypes["Value"]
  if (!ok) {
    return 0
  }
  return v
}

// A bare, payload-less `Option.None` (or `Option<T>.None`) reference — the
// one `sqlValue` argument shape `checkExprType` cannot classify by TYPE at
// all: with no `Some(x)` payload to infer from and no explicit `<T>`, `T`
// is unresolved (SPEC §15.3 has nothing to infer it from), which is exactly
// what makes `f(1, "x", true, Option.None)` — this ticket's own acceptance
// — otherwise unreachable at a non-generic `Value` parameter (unlike
// `sqlValue<Option<string>>(Option.None)`, there is no explicit-type-argument
// spelling available at a plain call argument). None NEEDS no such
// resolution: every `Option<T>.None` is `Value.Null` regardless of `T`, so
// this is judged on the NODE's syntax (mirrors `vVariantConstructionName`'s
// own syntactic recognition of `Enum.Variant`, one step short of it: a
// payload-less variant reference is a bare `Tag.Member`, never a `Tag.Call`).
fn sqlValueIsOptionNone(c: Checker, a: int): bool {
  if (getNode(c.tree, a).tag != Tag.Member) {
    return false
  }
  let mk = kidsOf(c.tree, a)
  let recvTy = enumReceiverType(c, mk[0])
  if (recvTy == 0 || !c.ctx.types[recvTy].hasName || c.ctx.types[recvTy].name != "Option") {
    return false
  }
  let mn = getNode(c.tree, mk[1])
  return c.source[mn.span.start:mn.span.end] == "None"
}

// #6280: a parameter declared exactly `std/sql` `Value` — plain, or the
// element type of a variadic `...values: Value` (both already resolve to
// this same per-argument judgement, since `vCallArgWant`/`vFuncSigArgWant`
// read a rest parameter's declared type as its bare element type, never
// widened to `[]Value`, before this runs) — accepts any argument `sqlValue`
// accepts, AS THOUGH the caller had written `sqlValue(arg)`: string,
// int/i64, bool, f64, []byte, or `Option<>` of one of those. True when this
// judged the call (accepted the coercion, or reported E0177 for it) and the
// caller must not ALSO run the ordinary `vExpectExpr` on `a`; false leaves
// `pty`'s normal judgement as the whole answer, which covers both "not a
// `Value` parameter" and "the argument is already a `Value`" (`sqlValue`'s
// own `Value` passes through unchanged, SPEC).
fn vSqlValueArgCoerced(c: Checker, a: int, pty: int): bool {
  let vt = sqlValueTypeId(c.mods)
  if (vt == 0 || pty != vt) {
    return false
  }
  if (sqlValueIsOptionNone(c, a)) {
    return true
  }
  let argTy = checkExprType(c, a)
  if (argTy == 0 || vMentionsInvalid(c, argTy, 0) || vHasTypeParam(c, argTy, 0)) {
    return false
  }
  let dty = defaultType(c, argTy)
  if (dty == vt) {
    return false
  }
  if (sqlValueKindOfType(c.ctx, dty) != "") {
    return true
  }
  reportSqlValueBadType(c.diags, c.ctx, vSpan(c, a), dty)
  return true
}

// Points every `sqlValue<V>` ledger entry at the hand-written specialisation
// for `V`'s kind, so Pass A2 (lowerinstemit.bit's `lowerInstance`) emits it
// under the instance symbol the call already names — `retargetJsonDecodeInstances`'s
// own shape, minus the cross-module lookup: every specialisation lives in
// `std/sql` itself.
fn retargetSqlValueInstances(mods: []Checker, root: int, lo: Lowerer) {
  let sm = sqlValueStdModuleId(mods)
  if (sm < 0) {
    return
  }
  let ctx = mods[root].ctx
  let g = 0
  while (g < len(ctx.instantiations)) {
    let inst = ctx.instantiations[g]
    if (inst.module == sm && inst.name == sqlValueFuncName) {
      retargetOneSqlValueInstance(mods, sm, inst, lo)
    }
    g = g + 1
  }
}

fn retargetOneSqlValueInstance(mods: []Checker, sm: int, inst: Instantiation, lo: Lowerer) {
  let ctx = mods[0].ctx
  let arg = 0
  if (len(inst.args) == 1) {
    arg = inst.args[0]
  }
  let kind = sqlValueKindOfType(ctx, arg)
  let decl = 0
  if (kind != "") {
    let (dn, ok) = mods[sm].funcDecls[sqlValueSpecName(kind)]
    if (ok) {
      decl = dn
    }
  }
  if (decl == 0) {
    // Unreachable through `bit build`, which checks first (`validateSqlValueGenerics`
    // already refused any kind this cannot classify) — but the template's own
    // stub body computes nothing, so falling through would ship a program
    // that fails at RUN TIME. Refuse instead, the same defensive fallback
    // `retargetOneJsonDecodeInstance` takes.
    lo.stubbed = append(
      lo.stubbed,
      StubbedFn{
        name = inst.name, span = inst.site,
        reason = "a 'sqlValue<V>' call whose type argument has no matching specialisation",
        note = "", noteSite = pointSpan(0, 0),
      },
    )
    return
  }
  inst.declModule = sm
  inst.decl = decl
}

// #6280's lowering half of `vSqlValueArgCoerced` — the ONE place a call
// argument at a `Value`-hinted parameter is lowered, replacing a bare
// `lowerExprH(fc, a, hint)` at both call sites (`lowerArgsRest`'s fixed
// argument loop, `fillSliceLitElems`'s variadic-tail element loop). A no-op
// (`lowerExprH(fc, a, hint)` unchanged) the instant `hint` is not `std/sql`'s
// `Value` — recomputed here from the checked types exactly as
// `retargetSqlValueInstances` recomputes its own answer from the
// instantiation ledger independently of `validateSqlValueGenerics`'s
// check-time pass, rather than threading a mark through from the checker.
//
// `Option.None` is judged BEFORE `a` is ever lowered at all, never after:
// `sqlValueIsOptionNone` needs no resolved type (see its own header) but
// ordinary lowering does — `lowerExprH` on a bare `Option.None` resolves its
// enum type from `nodeType`/`hint` (`variantConstructionObjTy`,
// lowerlayout.bit), and `hint` here is `Value`, a different nominal base, so
// that resolution would fall through to the unsubstituted TEMPLATE `Option`
// and build garbage. `Value.Null` is built directly instead — the same
// `buildEnumObj` a source-level `Value.Null` literal lowers through
// (`lowerVariantConstruction`), never `__sql_value_opt_*`: which of those
// five to call cannot be decided without `T`, and `None` never needs one to
// answer `Value.Null`.
fn sqlValueLowerArg(fc: FnCtx, a: int, hint: int): int {
  let vt = sqlValueTypeId(fc.c.mods)
  if (vt == 0 || hint != vt) {
    return lowerExprH(fc, a, hint)
  }
  if (sqlValueIsOptionNone(fc.c, a)) {
    return buildEnumObj(fc, vt, variantOrdinal(fc.c, vt, "Null"), -1)
  }
  let v = lowerExprH(fc, a, hint)
  if (fc.failed) {
    return v
  }
  let argTy = defaultType(fc.c, nodeType(fc, a))
  if (argTy == vt) {
    return v
  }
  let kind = sqlValueKindOfType(fc.c.ctx, argTy)
  if (kind == "") {
    return v
  }
  return sqlValueWrapCall(fc, kind, v)
}

// Emits `__sql_value_<kind>(v)` — a plain, direct call to the hand-written
// specialisation `retargetOneSqlValueInstance` above already resolves for an
// explicit `sqlValue(x)` — as the ordinary resolved-callee tail
// (`emitResolvedCall`, lowerprim.bit) any other statically known callee
// takes. `v` is left unchanged if `std/sql` was somehow not importable or
// the specialisation is missing (both already impossible by the time this
// runs: `sqlValueLowerArg` only calls this once `kind` classified, and
// `vSqlValueArgCoerced` already proved the call reachable at `bit check`
// time) — the same defensive no-op every lookup in this file takes rather
// than trust an invariant it cannot re-verify here.
fn sqlValueWrapCall(fc: FnCtx, kind: string, v: int): int {
  let sm = sqlValueStdModuleId(fc.c.mods)
  if (sm < 0) {
    return v
  }
  let owner = fc.c.mods[sm]
  let name = sqlValueSpecName(kind)
  let (decl, ok) = owner.funcDecls[name]
  if (!ok) {
    return v
  }
  let fr = FuncRef{ owner = owner, decl = decl, declName = name }
  let t = CallTarget{
    ok = true,
    symbol = callQualifiedRef(fc.lowerer.root, fr),
    paramTypes = lowerParamTypes(owner, decl),
    result = funcResultLookup(owner, name),
    owner = owner, decl = decl,
  }
  return emitResolvedCall(fc, t, [v])
}
