// compiler/classjsonschemacall.bit — how `jsonSchema<T>()` becomes a call to
// the specialised function `T` demands (#6166, #6168's E0173).
//
//     jsonSchema<User>()   ->   __json_schema_User()
//
// Simpler than `jsonDecode<T>`'s own rewrite (classjsondecodecall.bit):
// `jsonSchema<T>()` takes no runtime argument and has no lenient/text
// variant, and a `jsonSchema<T>()` call SITE itself needs no transitive
// closure: every demanded class owes exactly the one function
// `__json_schema_<Name>()`, in its own declaring module, nothing more
// (#6170's import wiring handles a caller in a different module).
//
// A `$ref` INSIDE that function's own document is a different story
// (#6182): a nested `@json` class declared in ANOTHER module still needs a
// `$defs` entry, and a node built with `addNode` belongs to the `Tree` it
// was built into, so that entry cannot be the FOREIGN class's own AST
// inlined here. `jsSchemaDocumentEntries`'s own section below builds it
// instead as a CALL to a bare-fragment function
// (`__json_schema_frag_<Name>()`, `JsonSchemaFragNeed`) the class's own
// module exports — the same "cross-module reference is a call, not an
// inlined tree" shape `jsonDecode<T>` already uses, scoped to exactly the
// classes `importPathClone`'s own hard constraint can reach: a call
// synthesized into a module's tree can only use a path THAT MODULE already
// imports somewhere in its own source, so this walks one hop from a
// document root's own module (never chained through an intermediate
// module's own import, which that root's module does not have) — a class
// reached only through a SECOND cross-module hop keeps a dangling `$ref`,
// same as before this fix, and is the next ticket's scope, not a silent
// wrong answer here.

// E0173: first free code above E0172 (compiler/parserstatic.bit's
// ecStaticMethodFn, #6156). `jsonSchema<T>` where `T` is not a class carrying
// `@json`. Refused here, by name, exactly as `jsonDecode<T>`'s own E0145 is
// (classjsondecodecall.bit) and for the same reason: left unrefused, the
// template's body would compile against an unbound `T` and only fail at
// RUNTIME — a `panic`, since this template has no `!` to fail through —
// which is the one outcome this must not have.
const ecJsonSchemaType = 173

const jsonSchemaFuncNameConst = "jsonSchema"
const jsonSchemaModulePath = "std/json"

fn jsonSchemaFuncName(name: string): string {
  return "__json_schema_${name}"
}

// `__json_schema_frag_<Name>()` — the BARE fragment (#6165's own
// `synthJsonSchema`, no `$defs` wrapper) a class's own module exports so
// ANOTHER module's document can call it for a `$defs` entry (#6182),
// distinct from `jsonSchemaFuncName`'s FULL document (own `$defs` included)
// a direct `jsonSchema<T>()` call site rewrites to.
fn fragFuncName(name: string): string {
  return "__json_schema_frag_${name}"
}

// One `jsonSchema<T>()` call to rewrite, and which class's function it
// resolves to.
class JsonSchemaSite {
  callerMod: int,
  callNode: int,
  classMod: int,
  className: string,
}

// One class some module demands the schema function of.
class JsonSchemaNeed {
  needMod: int,
  classMod: int,
  className: string,
  // How `needMod` reaches `classMod`'s module — "" for a module-local need
  // (nothing to import), the import path text otherwise. #6170's own
  // `classjsonschemaimports.bit` reads this to synthesize the cross-module
  // import a caller in a DIFFERENT module needs for the rewritten call.
  path: string,
}

// One cross-module `$defs` entry a document root's own closure reaches
// (#6182): `classMod` must export `fragFuncName(className)`, and `needMod`
// (always a document ROOT's own module — see this file's header) calls it,
// importing it when the two differ, which for a `JsonSchemaFragNeed` is
// always (a same-module reference is inlined by the EXISTING
// `jsonSchemaClosureNames`/`jsonSchemaClosureMembers` path, unchanged).
// `rootName` scopes this to the ONE document it serves: two root classes in
// the same module can reach different, unrelated foreign classes, each with
// its own independently-assigned `$defs` key (`schemaDefsKeyMap`).
class JsonSchemaFragNeed {
  needMod: int,
  rootName: string,
  classMod: int,
  className: string,
  path: string,
}

// Every rewrite the project needs, and every function those rewrites reach.
//
// `instNeeds` is the generic path's half (#6201, classjsonschemageneric.bit):
// a class reached only through a generic wrapper has no site to rewrite, and
// its module owes the `__json_schema_inst_C` specialisation on top of the
// document function itself. Kept as its own list, mirroring
// `JsonDecodeDemand.instNeeds` (classjsondecodecall.bit) for the same reason.
class JsonSchemaDemand {
  sites: []JsonSchemaSite,
  needs: []JsonSchemaNeed,
  fragNeeds: []JsonSchemaFragNeed,
  instNeeds: []JsonSchemaNeed,
}

// The local names `std/json`'s `jsonSchema` may be spelled under in this
// module: the bare name a named import binds (an `as` alias renames it), and
// every alias a namespace import bound. Mirrors
// `jsonDecodeNamesOf`/`bindsJsonDecode`, narrowed to this feature's one entry
// point.
class JsonSchemaNames {
  bare: string,
  namespaces: []string,
}

fn jsonSchemaNamesOf(tree: Tree, source: string): JsonSchemaNames {
  let out = JsonSchemaNames{ bare = "", namespaces = []string(0) }
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(tree, d)
    if (stringLitText(source, getNode(tree, k[1]).span) != jsonSchemaModulePath) {
      continue
    }
    let tag = getNode(tree, k[0]).tag
    if (tag == Tag.ImportNs || tag == Tag.ImportStar) {
      out.namespaces = append(out.namespaces, identText(tree, source, kidsOf(tree, k[0])[0]))
      continue
    }
    if (tag != Tag.ImportGroup) {
      continue
    }
    for item of kidsOf(tree, k[0]) {
      if (identText(tree, source, kidsOf(tree, item)[0]) == jsonSchemaFuncNameConst) {
        out.bare = importItemLocalName(tree, source, item)
      }
    }
  }
  return out
}

fn bindsJsonSchema(names: JsonSchemaNames): bool {
  return names.bare != "" || len(names.namespaces) != 0
}

// True iff `callee` names std/json's `jsonSchema` — the bare local name, or
// `<ns>.jsonSchema` through a namespace import.
fn isJsonSchemaCallee(tree: Tree, source: string, callee: int, names: JsonSchemaNames): bool {
  if (callee == 0) {
    return false
  }
  let tag = getNode(tree, callee).tag
  if (tag == Tag.Ident) {
    return names.bare != "" && identText(tree, source, callee) == names.bare
  }
  if (tag != Tag.Member) {
    return false
  }
  let k = kidsOf(tree, callee)
  if (getNode(tree, k[0]).tag != Tag.Ident ||
    identText(tree, source, k[1]) != jsonSchemaFuncNameConst) {
    return false
  }
  let ns = identText(tree, source, k[0])
  for a of names.namespaces {
    if (a == ns) {
      return true
    }
  }
  return false
}

// Every `jsonSchema<...>(...)` call node in the module.
fn jsonSchemaCallNodes(tree: Tree, source: string, names: JsonSchemaNames): []int {
  let out = []int(0)
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.Call &&
      isJsonSchemaCallee(tree, source, kidsOf(tree, i)[0], names)) {
      out = append(out, i)
    }
    i = i + 1
  }
  return out
}

// The single type argument written at a `jsonSchema<T>` call, or 0 when the
// call does not have exactly one. Zero or two is an ordinary generic-arity
// error on the template and is left to the checker.
fn jsonSchemaTypeArg(tree: Tree, n: int): int {
  let targs = kidsOf(tree, n)[1]
  if (targs == 0) {
    return 0
  }
  let list = kidsOf(tree, targs)
  if (len(list) != 1) {
    return 0
  }
  return list[0]
}

fn reportJsonSchemaArity(jx: JsonCtx, call: int) {
  report(
    jx.diags, ecJsonSchemaType, getNode(jx.tree, call).span,
    "'jsonSchema' needs exactly one explicit type argument",
    "write 'jsonSchema<T>()' naming the '@json' class to describe — 'T' appears only in the result, so nothing infers it from the argument",
  )
}

fn reportJsonSchemaType(jx: JsonCtx, targ: int, why: string, markable: bool) {
  let tname = jsonNodeText(jx, targ)
  let help = "'jsonSchema<T>' describes only a class carrying '@json', declared here or imported from another module by name"
  if (markable) {
    help = "mark '${tname}' with '@json' — 'jsonSchema<T>' is specialised from the same field list '@json' serializes, and never describes a type that did not opt in"
  }
  report(
    jx.diags, ecJsonSchemaType, getNode(jx.tree, targ).span,
    "'jsonSchema' cannot describe '${tname}': it ${why}", help,
  )
}

// The class `jsonSchema<T>()` describes, or a site with `found: false` after
// reporting why — the same resolution `jsonDecodeTarget`
// (classjsondecodecall.bit) makes, reused here rather than forked.
fn jsonSchemaTarget(jx: JsonCtx, mid: int, targ: int): JsonClassSite {
  let miss = JsonClassSite{ mod = -1, name = "", path = "", mark = 0, found = false }
  if (getNode(jx.tree, targ).tag != Tag.Ident) {
    reportJsonSchemaType(jx, targ, "is not a named class", false)
    return miss
  }
  let name = jsonNodeText(jx, targ)
  if (scalarJsonKind(name) != jkNested) {
    reportJsonSchemaType(jx, targ, "is not a class", false)
    return miss
  }
  let site = jsonClassSiteOf(jx, mid, name)
  if (!site.found) {
    reportJsonSchemaType(
      jx, targ, "is not declared in this module and is not imported from another by name", false,
    )
    return miss
  }
  if (site.mark != jmJsonClass) {
    let why = "is not a class"
    if (site.mark == jmPlainClass) {
      why = "does not carry '@json'"
    }
    reportJsonSchemaType(jx, targ, why, site.mark == jmPlainClass)
    return miss
  }
  return site
}

fn recordJsonSchemaSite(d: JsonSchemaDemand, mid: int, call: int, site: JsonClassSite) {
  d.sites = append(
    d.sites,
    JsonSchemaSite{ callerMod = mid, callNode = call, classMod = site.mod, className = site.name },
  )
  addJsonSchemaNeed(d, mid, site)
}

fn hasJsonSchemaNeed(d: JsonSchemaDemand, needMod: int, classMod: int, name: string): bool {
  for n of d.needs {
    if (n.needMod == needMod && n.classMod == classMod && n.className == name) {
      return true
    }
  }
  return false
}

// Records that `needMod` calls `site`'s schema function, once — and, when the
// class lives elsewhere, that its OWN module owes the function too. Mirrors
// `addJsonDecodeNeed`'s split for the identical reason: `needMod == classMod`
// is what makes a module BUILD the function, any other `needMod` only makes
// it CALL one (#6170's import wiring is what makes that second case compile).
fn addJsonSchemaNeed(d: JsonSchemaDemand, needMod: int, site: JsonClassSite) {
  if (!hasJsonSchemaNeed(d, needMod, site.mod, site.name)) {
    d.needs = append(
      d.needs,
      JsonSchemaNeed{
        needMod = needMod, classMod = site.mod, className = site.name, path = site.path,
      },
    )
  }
  if (needMod == site.mod || hasJsonSchemaNeed(d, site.mod, site.mod, site.name)) {
    return
  }
  d.needs = append(
    d.needs,
    JsonSchemaNeed{ needMod = site.mod, classMod = site.mod, className = site.name, path = "" },
  )
}

fn collectModuleSchemaSites(p: Project, mid: int, d: JsonSchemaDemand) {
  let m = p.mods[mid]
  let names = jsonSchemaNamesOf(m.tree, m.source)
  if (!bindsJsonSchema(names)) {
    return
  }
  let jx = newJsonCtx(p, m)
  let tpCalls = jsonSchemaTypeParamCalls(m)
  for n of jsonSchemaCallNodes(m.tree, m.source, names) {
    // A wrong ARGUMENT count is an ordinary arity error against the
    // template's own signature (it takes none) and is left to the checker.
    if (len(kidsOf(m.tree, kidsOf(m.tree, n)[2])) != 0) {
      continue
    }
    let targ = jsonSchemaTypeArg(m.tree, n)
    if (targ == 0) {
      reportJsonSchemaArity(jx, n)
      continue
    }
    // A type argument that is a TYPE PARAMETER resolves to a different class
    // per instantiation and so has no single name to rewrite to (#6201,
    // classjsonschemageneric.bit): `jstpOwn` is left unrewritten and
    // unreported here for the generic path's own ledger retarget to resolve
    // later; `jstpRecv` (a generic RECEIVER's own parameter) stays a refusal,
    // mirroring `collectDecodeSitesFor`'s identical split.
    let (tp, isTp) = tpCalls[n]
    if (isTp) {
      if (tp == jstpRecv) {
        reportJsonSchemaRecvTypeParam(jx, targ)
      }
      continue
    }
    let site = jsonSchemaTarget(jx, mid, targ)
    if (site.found) {
      recordJsonSchemaSite(d, mid, n, site)
    }
  }
}

// Every `jsonSchema<T>` call in the project, resolved. Runs before any module
// is modified, exactly as `collectJsonDecodeDemand` does, so a project that
// never calls `jsonSchema<T>` is byte-identical to before this feature
// existed.
fn collectJsonSchemaDemand(p: Project): JsonSchemaDemand {
  let d = JsonSchemaDemand{
    sites = []JsonSchemaSite(0), needs = []JsonSchemaNeed(0), fragNeeds = []JsonSchemaFragNeed(0),
    instNeeds = []JsonSchemaNeed(0),
  }
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    collectModuleSchemaSites(p, i, d)
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
  // The generic path (#6201), before the frag closure below: a class reached
  // only through a describing wrapper still owes its own `$defs` closure.
  collectJsonSchemaGenericNeeds(p, collectJsonSchemaGenerics(p), d)
  for n of d.needs {
    if (n.needMod != n.classMod) {
      continue
    }
    for need of collectSchemaFragNeedsForRoot(p, n.classMod, n.className) {
      d.fragNeeds = append(d.fragNeeds, need)
    }
  }
  return d
}

// The classes THIS module must synthesize a schema function for: the ones
// demanded of it that it also declares.
fn moduleSchemaClasses(
  d: JsonSchemaDemand,
  mid: int,
  classes: []JsonClass,
  jx: JsonCtx,
): []JsonClass {
  let out = []JsonClass(0)
  for jc of classes {
    let name = identText(jx.tree, jx.source, jc.className)
    for n of d.needs {
      if (n.classMod == mid && n.className == name) {
        out = append(out, jc)
        break
      }
    }
  }
  return out
}

// Every word module `mid` needs for this feature ON TOP of
// `jsonSchemaSynthWords`'s own fixed list: the name of every function it
// CALLS (its own or another module's).
fn jsonSchemaCallWords(d: JsonSchemaDemand, mid: int): []string {
  let out = []string(0)
  for n of d.needs {
    if (n.needMod == mid) {
      out = append(out, jsonSchemaFuncName(n.className))
    }
  }
  return out
}

// ---- #6169/#6182: the transitive $defs/$ref closure ---------------------
//
// #6165's `synthJsonSchema` always spells a nested `@json` class field as a
// `{"$ref": "#/$defs/<Name>"}` STRING, never a call to that class's own
// function — so a SAME-MODULE closure member needs no cross-module function
// wiring at all: every class the walk below reaches gets rendered INLINE,
// by #6165's own fragment builder, into the SAME tree the root's function
// lives in.
//
// THAT INLINING IS ALSO THE LIMIT for a class this file's `jsonClassByName`
// can find: a node built with `addNode`/`addLeaf` belongs to the `Tree` it
// was built into, and a nested field's declared type node is only
// meaningful read against the module that PARSED it, so a `$ref` target
// declared in a DIFFERENT module cannot be inlined here. A cross-module
// class instead gets its `$defs` entry from classjsonschemafrag.bit's own
// one-hop closure (#6182) — `jsSchemaDocumentEntries` merges both.

// The class named `name` among `classes`, or a `classNode == 0` sentinel
// when `classes` (always `collectJsonClasses` on ONE module) does not
// declare it — the same "not found" shape `JsonClassSite.found` uses,
// specialised to a same-module lookup this closure never needs to leave.
fn jsonClassByName(jx: JsonCtx, classes: []JsonClass, name: string): JsonClass {
  for jc of classes {
    if (identText(jx.tree, jx.source, jc.className) == name) {
      return jc
    }
  }
  return JsonClass{ classNode = 0, className = 0, exported = false, fields = []JsonField(0) }
}

// Every `@json` class name reachable from `rootName` through a chain of
// SAME-MODULE nested-class fields, in discovery order, `rootName` itself
// first. A worklist, not recursion, mirroring `closeJsonDecodeNeeds`'s own
// shape and for the same reason: a self-referential class (`class Node {
// next: Option<Node> }`) must terminate, and `seen` plus the `budget` bound
// (at most one visit per class in the module) is what proves it does,
// rather than trusting the walk never to cycle.
fn jsonSchemaClosureNames(jx: JsonCtx, allClasses: []JsonClass, rootName: string): []string {
  let order = []string(0)
  let seen = map<string, bool>{}
  let queue = [rootName]
  let i = 0
  let budget = len(allClasses) + 1
  while (i < len(queue) && i < budget) {
    let name = queue[i]
    i = i + 1
    let (_, dup) = seen[name]
    if (dup) {
      continue
    }
    seen[name] = true
    let jc = jsonClassByName(jx, allClasses, name)
    if (jc.classNode == 0) {
      continue
    }
    order = append(order, name)
    for f of jc.fields {
      let nested = jsonDecNestedName(jx, f)
      if (nested != "") {
        queue = append(queue, nested)
      }
    }
  }
  return order
}

// Every class in the closure of every root in `roots`, deduped once across
// ALL of them — two roots sharing a nested class need its words (and, at
// the call site, its `$defs` entry) built only once each.
fn jsonSchemaClosureMembers(jx: JsonCtx, allClasses: []JsonClass, roots: []JsonClass): []JsonClass {
  let out = []JsonClass(0)
  let seen = map<string, bool>{}
  for root of roots {
    let rootName = identText(jx.tree, jx.source, root.className)
    for n of jsonSchemaClosureNames(jx, allClasses, rootName) {
      let (_, dup) = seen[n]
      if (dup) {
        continue
      }
      seen[n] = true
      out = append(out, jsonClassByName(jx, allClasses, n))
    }
  }
  return out
}

// `mid` (the module currently synthesizing) and `sd` (the project's whole
// demand), bundled so threading #6182's frag-need lookups through
// `jsSchemaDocumentEntries`/`synthJsonSchemaFunc`/`injectJsonSchemaDecls`
// costs each one param, not two, against LINT.md's max-params=5.
class SchemaSynthCtx {
  mid: int,
  sd: JsonSchemaDemand,
}

// `jsonSchemaSynthWords`'s fixed keyword list, every closure member's own
// name QUOTED (a `$defs` key `jbSynthString` needs a registered word for,
// same as any other), and every closure member's per-field words — appended
// only when this module actually builds at least one schema function, the
// same guard `jsonDecodeSynthWords` applies to its own fixed helper-name
// list. `allClasses` is `collectJsonClasses`'s own result for this module,
// taken as a PARAMETER rather than recomputed: that function reports E0142
// on a class missing the `Json`/`JsonEntry` import as a SIDE EFFECT, so
// calling it a second time for the same module double-reports the same
// diagnostic. `fragClasses` (#6182) gets the SAME word treatment: building
// a bare fragment function walks the SAME field list a full document does.
fn jsonSchemaAllSynthWords(
  jx: JsonCtx,
  ctx: SchemaSynthCtx,
  allClasses: []JsonClass,
  schemaClasses: []JsonClass,
  fragClasses: []JsonClass,
): []string {
  let roots = []JsonClass(0)
  for c of schemaClasses {
    roots = append(roots, c)
  }
  for c of fragClasses {
    roots = append(roots, c)
  }
  if (len(roots) == 0) {
    return []string(0)
  }
  let members = jsonSchemaClosureMembers(jx, allClasses, roots)
  let out = jsonSchemaSynthWords()
  for m of members {
    out = append(out, "\"" + identText(jx.tree, jx.source, m.className) + "\"")
  }
  for w of jsonSchemaFieldsWords(jx, members) {
    out = append(out, w)
  }
  for w of schemaFragDefsKeyWords(jx, ctx, allClasses, schemaClasses) {
    out = append(out, w)
  }
  return out
}

// The quoted `$defs` key text every cross-module frag need (#6182) resolves
// to, for every root class this module builds a document for — the one
// word `jsonSchemaClosureMembers`'s own SAME-MODULE walk cannot register,
// since the key only exists once `schemaDefsKeyMap` runs collision
// resolution for a SPECIFIC root.
fn schemaFragDefsKeyWords(
  jx: JsonCtx, ctx: SchemaSynthCtx, allClasses: []JsonClass, schemaClasses: []JsonClass,
): []string {
  let out = []string(0)
  for c of schemaClasses {
    let rootName = identText(jx.tree, jx.source, c.className)
    let fragNeeds = schemaFragNeedsForRoot(ctx.sd, ctx.mid, rootName)
    let keys = schemaDefsKeyMap(
      jx.proj,
      jsonSchemaClosureNames(jx, allClasses, rootName),
      fragNeeds,
    )
    for n of fragNeeds {
      let (key, _) = keys["${n.classMod}:${n.className}"]
      out = append(out, "\"" + key + "\"")
    }
  }
  return out
}

// The root's own document: its three entries (#6165's `jsSchemaEntries`)
// plus a fourth, `"$defs"`, holding one bare fragment per class in the
// closure, `jc` itself included — inlined (#6165's own `synthJsonSchema`)
// for a same-module member, a CALL to `fragFuncName` for a cross-module one
// (#6182), since only the class's own module can read its own fields.
fn jsSchemaDocumentEntries(
  jx: JsonCtx,
  ctx: SchemaSynthCtx,
  st: SynthText,
  jc: JsonClass,
  allClasses: []JsonClass,
): []int {
  let tree = jx.tree
  let jb = JsonBuild{
    tree = tree,
    st = st,
    span = getNode(tree, jc.className).span,
    source = jx.source,
  }
  let rootName = identText(tree, jx.source, jc.className)
  let localNames = jsonSchemaClosureNames(jx, allClasses, rootName)
  let fragNeeds = schemaFragNeedsForRoot(ctx.sd, ctx.mid, rootName)
  let keys = schemaDefsKeyMap(jx.proj, localNames, fragNeeds)
  let rc = SchemaRefCtx{ jx = jx, mod = ctx.mid, keys = keys }
  let entries = jsSchemaEntries(jb, tree, jc, rc)
  let defs = []int(0)
  for n of localNames {
    let member = jsonClassByName(jx, allClasses, n)
    defs = append(defs, jsEntry(jb, n, synthJsonSchema(tree, jx.source, st, member, rc)))
  }
  for n of fragNeeds {
    let (key, _) = keys["${n.classMod}:${n.className}"]
    let call = jbCall(jb, jbIdent(jb, fragFuncName(n.className)), []int(0))
    defs = append(defs, jsEntry(jb, key, call))
  }
  entries = append(entries, jsEntry(jb, "$defs", jsObj(jb, defs)))
  return entries
}

// `<name>(): Json { return <body> }` — the one free-function shape both
// `synthJsonSchemaFunc` (the full document) and `synthJsonSchemaFragFunc`
// (#6182's bare fragment) build, exported iff the class is: a class the
// module keeps to itself cannot be named from outside, so neither function
// can ever be called from outside either.
fn synthJsonSchemaDecl(tree: Tree, st: SynthText, jc: JsonClass, name: string, body: int): int {
  let classSpan = getNode(tree, jc.className).span
  let blk = addNode(
    tree,
    Tag.Block,
    classSpan,
    0,
    [addNode(tree, Tag.ReturnStmt, classSpan, 0, [body])],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      0, synthIdent(tree, st, name), 0,
      addNode(tree, Tag.Params, classSpan, 0, []int(0)), synthIdent(tree, st, synthJsonName), blk,
    ],
  )
  if (!jc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// `__json_schema_<Name>(): Json { return <document> }` — a FREE function,
// not a member (Bit has no static methods, and there is no instance to call
// one on).
fn synthJsonSchemaFunc(
  jx: JsonCtx, ctx: SchemaSynthCtx, st: SynthText, jc: JsonClass, allClasses: []JsonClass,
): int {
  let tree = jx.tree
  let entries = jsSchemaDocumentEntries(jx, ctx, st, jc, allClasses)
  let jb = JsonBuild{
    tree = tree,
    st = st,
    span = getNode(tree, jc.className).span,
    source = jx.source,
  }
  let document = jsObj(jb, entries)
  let name = identText(tree, jx.source, jc.className)
  return synthJsonSchemaDecl(tree, st, jc, jsonSchemaFuncName(name), document)
}

// `__json_schema_frag_<Name>(): Json { return <bare fragment> }` (#6182) —
// no `$defs`, `jc`'s own module resolving its own nested references (a
// further cross-module hop from HERE is left dangling, this file's header
// explains why); the class this belongs to owns no `$defs` key of its own,
// since it is the CALLER's document that assigns one.
fn synthJsonSchemaFragFunc(jx: JsonCtx, ctx: SchemaSynthCtx, st: SynthText, jc: JsonClass): int {
  let tree = jx.tree
  let rc = SchemaRefCtx{ jx = jx, mod = ctx.mid, keys = map<string, string>{} }
  let fragment = synthJsonSchema(tree, jx.source, st, jc, rc)
  let name = identText(tree, jx.source, jc.className)
  return synthJsonSchemaDecl(tree, st, jc, fragFuncName(name), fragment)
}

// Every demanded class's schema function (full documents and #6182's bare
// fragments), for the caller to attach in the one pass that attaches
// `@json`'s encoder and #3977's decoder. `allClasses` is taken as a
// parameter for the same reason `jsonSchemaAllSynthWords` takes it:
// `collectJsonClasses` reports E0142 as a side effect, and this runs in the
// SAME module synthesis pass `jsonSchemaAllSynthWords` already did, so
// recomputing it here would report the same diagnostic twice.
fn injectJsonSchemaDecls(
  jx: JsonCtx,
  ctx: SchemaSynthCtx,
  st: SynthText,
  classes: []JsonClass,
  allClasses: []JsonClass,
): []int {
  let out = []int(0)
  for jc of classes {
    out = append(out, synthJsonSchemaFunc(jx, ctx, st, jc, allClasses))
  }
  for jc of moduleSchemaFragClasses(ctx.sd, ctx.mid, allClasses, jx) {
    out = append(out, synthJsonSchemaFragFunc(jx, ctx, st, jc))
  }
  return out
}

// `jsonSchema<C>()` becomes `__json_schema_C()`, in place — the callee slot
// renamed and the (already empty) type-argument slot cleared, the args slot
// untouched since this entry point takes none. Mirrors
// `rewriteJsonDecodeCalls`'s own in-place rewrite for the identical reason:
// the call sits somewhere inside an expression whose parent this pass does
// not hold.
fn rewriteJsonSchemaCalls(m: SrcModule, st: SynthText, mid: int, d: JsonSchemaDemand) {
  let tree = m.tree
  for site of d.sites {
    if (site.callerMod != mid) {
      continue
    }
    setKid(tree, site.callNode, 0, synthIdent(tree, st, jsonSchemaFuncName(site.className)))
    setKid(tree, site.callNode, 1, 0)
  }
}
