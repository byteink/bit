// compiler/classjsonschemacall.bit — how `jsonSchema<T>()` becomes a call to
// the specialised function `T` demands (#6166, #6168's E0172).
//
//     jsonSchema<User>()   ->   __json_schema_User()
//
// Simpler than `jsonDecode<T>`'s own rewrite (classjsondecodecall.bit):
// `jsonSchema<T>()` takes no runtime argument and has no lenient/text
// variant, and — since #6165's fragment never CALLS another class's schema
// function, only ever spells a `$ref` STRING — needs no transitive closure
// either: every demanded class owes exactly the one function
// `__json_schema_<Name>()`, in its own declaring module, nothing more.
//
// NOT YET HANDLED, both by this ticket's own scope: the `$defs` object a
// `$ref` needs to resolve against (#6169) and the cross-module IMPORT of a
// schema function called from a module that does not own the class (#6170,
// mirroring classjsondecodeimports.bit) — this ticket's acceptance is scoped
// to a class with no nested `@json` field, so neither gap is reachable from
// what it tests.

// E0172 (SPEC "jsonSchema<T>"): `jsonSchema<T>` where `T` is not a class
// carrying `@json`. Refused here, by name, exactly as `jsonDecode<T>`'s own
// E0145 is (classjsondecodecall.bit) and for the same reason: left
// unrefused, the template's body would compile against an unbound `T` and
// only fail at RUNTIME — a `panic`, since this template has no `!` to fail
// through — which is the one outcome this must not have.
const ecJsonSchemaType = 172

const jsonSchemaFuncNameConst = "jsonSchema"
const jsonSchemaModulePath = "std/json"

fn jsonSchemaFuncName(name: string): string {
  return "__json_schema_${name}"
}

// One `jsonSchema<T>()` call to rewrite, and which class's function it
// resolves to.
class JsonSchemaSite {
  callerMod: int,
  callNode: int,
  classMod: int,
  className: string,
}

// One class some module demands the schema function of.
class JsonSchemaNeed {
  needMod: int,
  classMod: int,
  className: string,
}

// Every rewrite the project needs, and every function those rewrites reach.
class JsonSchemaDemand {
  sites: []JsonSchemaSite,
  needs: []JsonSchemaNeed,
}

// The local names `std/json`'s `jsonSchema` may be spelled under in this
// module: the bare name a named import binds (an `as` alias renames it), and
// every alias a namespace import bound. Mirrors
// `jsonDecodeNamesOf`/`bindsJsonDecode`, narrowed to this feature's one entry
// point.
class JsonSchemaNames {
  bare: string,
  namespaces: []string,
}

fn jsonSchemaNamesOf(tree: Tree, source: string): JsonSchemaNames {
  let out = JsonSchemaNames{ bare = "", namespaces = []string(0) }
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(tree, d)
    if (stringLitText(source, getNode(tree, k[1]).span) != jsonSchemaModulePath) {
      continue
    }
    let tag = getNode(tree, k[0]).tag
    if (tag == Tag.ImportNs || tag == Tag.ImportStar) {
      out.namespaces = append(out.namespaces, identText(tree, source, kidsOf(tree, k[0])[0]))
      continue
    }
    if (tag != Tag.ImportGroup) {
      continue
    }
    for item of kidsOf(tree, k[0]) {
      if (identText(tree, source, kidsOf(tree, item)[0]) == jsonSchemaFuncNameConst) {
        out.bare = importItemLocalName(tree, source, item)
      }
    }
  }
  return out
}

fn bindsJsonSchema(names: JsonSchemaNames): bool {
  return names.bare != "" || len(names.namespaces) != 0
}

// True iff `callee` names std/json's `jsonSchema` — the bare local name, or
// `<ns>.jsonSchema` through a namespace import.
fn isJsonSchemaCallee(tree: Tree, source: string, callee: int, names: JsonSchemaNames): bool {
  if (callee == 0) {
    return false
  }
  let tag = getNode(tree, callee).tag
  if (tag == Tag.Ident) {
    return names.bare != "" && identText(tree, source, callee) == names.bare
  }
  if (tag != Tag.Member) {
    return false
  }
  let k = kidsOf(tree, callee)
  if (getNode(tree, k[0]).tag != Tag.Ident ||
    identText(tree, source, k[1]) != jsonSchemaFuncNameConst) {
    return false
  }
  let ns = identText(tree, source, k[0])
  for a of names.namespaces {
    if (a == ns) {
      return true
    }
  }
  return false
}

// Every `jsonSchema<...>(...)` call node in the module.
fn jsonSchemaCallNodes(tree: Tree, source: string, names: JsonSchemaNames): []int {
  let out = []int(0)
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.Call &&
      isJsonSchemaCallee(tree, source, kidsOf(tree, i)[0], names)) {
      out = append(out, i)
    }
    i = i + 1
  }
  return out
}

// The single type argument written at a `jsonSchema<T>` call, or 0 when the
// call does not have exactly one. Zero or two is an ordinary generic-arity
// error on the template and is left to the checker.
fn jsonSchemaTypeArg(tree: Tree, n: int): int {
  let targs = kidsOf(tree, n)[1]
  if (targs == 0) {
    return 0
  }
  let list = kidsOf(tree, targs)
  if (len(list) != 1) {
    return 0
  }
  return list[0]
}

fn reportJsonSchemaArity(jx: JsonCtx, call: int) {
  report(
    jx.diags, ecJsonSchemaType, getNode(jx.tree, call).span,
    "'jsonSchema' needs exactly one explicit type argument",
    "write 'jsonSchema<T>()' naming the '@json' class to describe — 'T' appears only in the result, so nothing infers it from the argument",
  )
}

fn reportJsonSchemaType(jx: JsonCtx, targ: int, why: string, markable: bool) {
  let tname = jsonNodeText(jx, targ)
  let help = "'jsonSchema<T>' describes only a class carrying '@json', declared here or imported from another module by name"
  if (markable) {
    help = "mark '${tname}' with '@json' — 'jsonSchema<T>' is specialised from the same field list '@json' serializes, and never describes a type that did not opt in"
  }
  report(
    jx.diags, ecJsonSchemaType, getNode(jx.tree, targ).span,
    "'jsonSchema' cannot describe '${tname}': it ${why}", help,
  )
}

// The class `jsonSchema<T>()` describes, or a site with `found: false` after
// reporting why — the same resolution `jsonDecodeTarget`
// (classjsondecodecall.bit) makes, reused here rather than forked.
fn jsonSchemaTarget(jx: JsonCtx, mid: int, targ: int): JsonClassSite {
  let miss = JsonClassSite{ mod = -1, name = "", path = "", mark = 0, found = false }
  if (getNode(jx.tree, targ).tag != Tag.Ident) {
    reportJsonSchemaType(jx, targ, "is not a named class", false)
    return miss
  }
  let name = jsonNodeText(jx, targ)
  if (scalarJsonKind(name) != jkNested) {
    reportJsonSchemaType(jx, targ, "is not a class", false)
    return miss
  }
  let site = jsonClassSiteOf(jx, mid, name)
  if (!site.found) {
    reportJsonSchemaType(
      jx, targ, "is not declared in this module and is not imported from another by name", false,
    )
    return miss
  }
  if (site.mark != jmJsonClass) {
    let why = "is not a class"
    if (site.mark == jmPlainClass) {
      why = "does not carry '@json'"
    }
    reportJsonSchemaType(jx, targ, why, site.mark == jmPlainClass)
    return miss
  }
  return site
}

fn recordJsonSchemaSite(d: JsonSchemaDemand, mid: int, call: int, site: JsonClassSite) {
  d.sites = append(
    d.sites,
    JsonSchemaSite{ callerMod = mid, callNode = call, classMod = site.mod, className = site.name },
  )
  addJsonSchemaNeed(d, mid, site)
}

fn hasJsonSchemaNeed(d: JsonSchemaDemand, needMod: int, classMod: int, name: string): bool {
  for n of d.needs {
    if (n.needMod == needMod && n.classMod == classMod && n.className == name) {
      return true
    }
  }
  return false
}

// Records that `needMod` calls `site`'s schema function, once — and, when the
// class lives elsewhere, that its OWN module owes the function too. Mirrors
// `addJsonDecodeNeed`'s split for the identical reason: `needMod == classMod`
// is what makes a module BUILD the function, any other `needMod` only makes
// it CALL one (#6170's import wiring is what makes that second case compile).
fn addJsonSchemaNeed(d: JsonSchemaDemand, needMod: int, site: JsonClassSite) {
  if (!hasJsonSchemaNeed(d, needMod, site.mod, site.name)) {
    d.needs = append(
      d.needs, JsonSchemaNeed{ needMod = needMod, classMod = site.mod, className = site.name },
    )
  }
  if (needMod == site.mod || hasJsonSchemaNeed(d, site.mod, site.mod, site.name)) {
    return
  }
  d.needs = append(
    d.needs, JsonSchemaNeed{ needMod = site.mod, classMod = site.mod, className = site.name },
  )
}

fn collectModuleSchemaSites(p: Project, mid: int, d: JsonSchemaDemand) {
  let m = p.mods[mid]
  let names = jsonSchemaNamesOf(m.tree, m.source)
  if (!bindsJsonSchema(names)) {
    return
  }
  let jx = newJsonCtx(p, m)
  for n of jsonSchemaCallNodes(m.tree, m.source, names) {
    // A wrong ARGUMENT count is an ordinary arity error against the
    // template's own signature (it takes none) and is left to the checker.
    if (len(kidsOf(m.tree, kidsOf(m.tree, n)[2])) != 0) {
      continue
    }
    let targ = jsonSchemaTypeArg(m.tree, n)
    if (targ == 0) {
      reportJsonSchemaArity(jx, n)
      continue
    }
    let site = jsonSchemaTarget(jx, mid, targ)
    if (site.found) {
      recordJsonSchemaSite(d, mid, n, site)
    }
  }
}

// Every `jsonSchema<T>` call in the project, resolved. Runs before any module
// is modified, exactly as `collectJsonDecodeDemand` does, so a project that
// never calls `jsonSchema<T>` is byte-identical to before this feature
// existed.
fn collectJsonSchemaDemand(p: Project): JsonSchemaDemand {
  let d = JsonSchemaDemand{ sites = []JsonSchemaSite(0), needs = []JsonSchemaNeed(0) }
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    collectModuleSchemaSites(p, i, d)
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
  return d
}

// The classes THIS module must synthesize a schema function for: the ones
// demanded of it that it also declares.
fn moduleSchemaClasses(
  d: JsonSchemaDemand,
  mid: int,
  classes: []JsonClass,
  jx: JsonCtx,
): []JsonClass {
  let out = []JsonClass(0)
  for jc of classes {
    let name = identText(jx.tree, jx.source, jc.className)
    for n of d.needs {
      if (n.classMod == mid && n.className == name) {
        out = append(out, jc)
        break
      }
    }
  }
  return out
}

// Every word module `mid` needs for this feature ON TOP of
// `jsonSchemaSynthWords`'s own fixed list: the name of every function it
// CALLS (its own or another module's).
fn jsonSchemaCallWords(d: JsonSchemaDemand, mid: int): []string {
  let out = []string(0)
  for n of d.needs {
    if (n.needMod == mid) {
      out = append(out, jsonSchemaFuncName(n.className))
    }
  }
  return out
}

// `jsonSchemaSynthWords`'s fixed keyword list plus every field's own `$ref`
// word, appended only when this module actually builds at least one schema
// function — the same guard `jsonDecodeSynthWords` applies to its own fixed
// helper-name list.
fn jsonSchemaAllSynthWords(jx: JsonCtx, schemaClasses: []JsonClass): []string {
  if (len(schemaClasses) == 0) {
    return []string(0)
  }
  let out = jsonSchemaSynthWords()
  for w of jsonSchemaFieldsWords(jx, schemaClasses) {
    out = append(out, w)
  }
  return out
}

// `__json_schema_<Name>(): Json { return <#6165's fragment> }` — a FREE
// function, not a member (Bit has no static methods, and there is no
// instance to call one on), exported iff the class is: a class the module
// keeps to itself cannot be named from outside, so its schema function can
// never be called from outside either.
fn synthJsonSchemaFunc(tree: Tree, source: string, st: SynthText, jc: JsonClass): int {
  let classSpan = getNode(tree, jc.className).span
  let fragment = synthJsonSchema(tree, source, st, jc)
  let name = identText(tree, source, jc.className)
  let body = addNode(
    tree, Tag.Block, classSpan, 0, [addNode(tree, Tag.ReturnStmt, classSpan, 0, [fragment])],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      0, synthIdent(tree, st, jsonSchemaFuncName(name)), 0,
      addNode(tree, Tag.Params, classSpan, 0, []int(0)), synthIdent(tree, st, "Json"), body,
    ],
  )
  if (!jc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// Every demanded class's schema function, for the caller to attach in the
// one pass that attaches `@json`'s encoder and #3977's decoder.
fn injectJsonSchemaDecls(jx: JsonCtx, st: SynthText, classes: []JsonClass): []int {
  let out = []int(0)
  for jc of classes {
    out = append(out, synthJsonSchemaFunc(jx.tree, jx.source, st, jc))
  }
  return out
}

// `jsonSchema<C>()` becomes `__json_schema_C()`, in place — the callee slot
// renamed and the (already empty) type-argument slot cleared, the args slot
// untouched since this entry point takes none. Mirrors
// `rewriteJsonDecodeCalls`'s own in-place rewrite for the identical reason:
// the call sits somewhere inside an expression whose parent this pass does
// not hold.
fn rewriteJsonSchemaCalls(m: SrcModule, st: SynthText, mid: int, d: JsonSchemaDemand) {
  let tree = m.tree
  for site of d.sites {
    if (site.callerMod != mid) {
      continue
    }
    let start = getNode(tree, site.callNode).kidsStart
    tree.extra[start] = synthIdent(tree, st, jsonSchemaFuncName(site.className))
    tree.extra[start + 1] = 0
  }
}
