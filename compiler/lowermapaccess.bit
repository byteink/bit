// compiler/lowermapaccess.bit — split out of loweraccess.bit (#4437, over the
// 800-line ceiling once map key/value string coercion landed). Sibling of
// loweraccess.bit and lowerlit.bit: same module, so this needs no imports
// and no call-site changes. `m[k]` and `let (v, ok) = m[k]` read lowering:
// the miss-edge policy and both probe forms.

// Does `ty`'s zero value (SPEC §13.4) differ from the null word that `map_get`
// reports a miss with? `map_get`'s raw miss word is a null REFERENCE, not the
// object §13.4 names, so where they differ the miss edge must be routed
// through the same materialization a class-typed miss already gets.
//
// The boxed records — class, tuple, boxed enum — are `zeroIsLiveRecord`
// (lowerslicefill.bit), the one answer this compiler keeps to that question;
// the tuple arm is #4500, which is what a map miss on a `(int, int)` value
// used to segfault on. THREE KINDS BEYOND IT are true here and only here, and
// the difference is this site's, not drift: a miss returns ONE WORD with no
// allocation behind it, so `string` (`""`), a slice (empty) and `[N]T` (a
// zeroed block) each need their zero built, where in memory a zeroing
// allocator owns they would already be correct.
//
// False for map/chan/function/interface, whose zero IS `nil`, for every
// scalar, whose zero IS the word 0, and for a bare (non-boxed) enum, whose
// zero IS its first variant's tag with nothing to allocate.
fn zeroIsObject(fc: FnCtx, ty: int): bool {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    return td.prim == 11
  }
  if (zeroIsLiveRecord(fc, ty)) {
    return true
  }
  return td.kind == TypeKind.Slice || td.kind == TypeKind.Array
}

// `m[k]` (SPEC §12.6): a missing key yields the value type's zero value.
// `map_get` can only report a miss as the null word, so where V's zero is a live
// object materialize it on the miss edge — otherwise a miss hands back a null
// header and the first `len`/field read faults (#1557). The zero is built
// lazily, inside the miss block, so a hit allocates nothing.
//
// WHEN V HAS NO ZERO VALUE AT ALL (a class with a class-typed field, §13.4)
// the miss edge cannot be satisfied, and what happens then depends on which form
// the programmer wrote (#1926):
//
//   `let v = m[k]`         -> `missPanics`, and the miss edge PANICS naming the
//                             type. There is no value to hand back and no way
//                             for the caller to have known, so failing loudly at
//                             the read beats returning a null that faults later
//                             somewhere that no longer mentions the map.
//   `let (v, ok) = m[k]`   -> NOT `missPanics`. The comma-ok form exists to ask
//                             whether the key is there; making it panic would
//                             leave such a map unreadable by any means. `v` is
//                             the raw null and `ok` is false, which is the
//                             contract that form already carries.
//
// That split is the same one C++ draws between `operator[]` (requires a
// default-constructible value) and `find`, and the same one this compiler
// already applies to `[]T(n)`: reject or fail loudly on the unchecked form,
// leave the checked form usable.
//
// Every case decidable at compile time is already E0083 from the checker; this
// is only for a key whose presence is not knowable until it runs.
// How emitMapGet handles a missing key, bundled into one param (#2189, E0202):
// `panics` is false only for the comma-ok form, where absence is reported
// through `ok` instead. `span` is the source span of the index/lvalue this
// read came from, for the refusal a value type with no zero value forces.
class MapGetMiss {
  panics: bool,
  span: Span,
}

// Shared by `m[k]` (loweraccess.bit's `lowerIndex`) and the compound-assign
// MapElem read (lowerassign.bit's `readLvalue`).
//
// #4426: `key` crosses into `map_get`'s one-boxed-word ABI exactly as it
// stands. #4431 routed it through a box/unbox round trip first, which under
// the string gate unboxed an already-boxed handle and allocated a second
// identical box for every string-keyed read — `bench/cases/strmap`'s whole
// 12,450,003-object regression. lowerexplodestr.bit's banner has the
// derivation and why the container boundary needs no coercion in either
// direction.
fn emitMapGet(fc: FnCtx, valTy: int, m: int, key: int, onMiss: MapGetMiss): int {
  let gv = mkInstr(Op.RtCall, valTy)
  gv.name = "map_get"
  gv.args = [m, key]
  return emitMapMiss(fc, valTy, emitRtCall(fc, gv), onMiss)
}

// The miss edge of a map read, given the raw word `v` the read produced — null
// when the key was absent. Shared by `m[k]` above and by `emitMapCommaOk`
// below, which reaches it with `map_val_at`'s word instead of `map_get`'s: one
// miss policy, so the two forms cannot drift apart on a value type whose zero
// is a live object.
fn emitMapMiss(fc: FnCtx, valTy: int, v: int, onMiss: MapGetMiss): int {
  if (!zeroIsObject(fc, valTy)) {
    return v
  }
  // Comma-ok over a value type with no zero value: hand back the null and let
  // `ok` speak. No miss block, so a miss costs nothing.
  if (!onMiss.panics && typeHasNoZeroValue(fc, valTy)) {
    return v
  }
  let miss = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = neNil(fc, v, valTy)
  br.ival = join
  br.thenArgs = [v]
  br.ival2 = miss
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, miss)
  if (typeHasNoZeroValue(fc, valTy)) {
    // Terminates the miss block; `join` is then reached only from the hit edge,
    // which still carries the parameter below.
    emitNoZeroValuePanic(fc, valTy, "m[k]")
  } else {
    let zero = zeroValue(fc, valTy, onMiss.span)
    if (fc.failed) {
      return 0
    }
    emitJump(fc, join, [zero])
  }
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, valTy)
}

// `let (v, ok) = m[k]` (SPEC §12.6), as ONE probe rather than two.
//
// It used to emit `map_get` and then `map_has` — two exported calls that each
// hashed and walked the same table for one source expression (#4019, 20.0% of
// `bench/cases/map`). `map_slot` probes once and answers both questions: `ok`
// is `slot >= 0`, and `map_val_at` turns the slot into the value word by
// indexing, with no probe at all. A negative slot reads as the zero word
// (ABI.md §15), which is the same null `map_get` reported a miss with, so the
// shared miss edge above needs no change.
//
// `ok` is emitted BEFORE the miss edge splits the block, so it is defined in a
// block that dominates the join — the same way `m` and `key` already outlive
// that split at this call site.
fn emitMapCommaOk(fc: FnCtx, valTy: int, m: int, key: int, span: Span): []int {
  let i64ty = primType(fc.c.ctx, 3)
  let sv = mkInstr(Op.RtCall, i64ty)
  sv.name = "map_slot"
  sv.args = [m, key]
  let slot = emitRtCall(fc, sv)
  let ge = mkInstr(Op.ICmpSge, primType(fc.c.ctx, 10))
  ge.lhs = slot
  ge.rhs = builderEmit(fc.b, mkInstr(Op.ConstInt, i64ty))
  let ok = builderEmit(fc.b, ge)
  let vv = mkInstr(Op.RtCall, valTy)
  vv.name = "map_val_at"
  vv.args = [m, slot]
  let v = emitMapMiss(fc, valTy, emitRtCall(fc, vv), MapGetMiss{ panics: false, span: span })
  if (fc.failed) {
    return []int(0)
  }
  return [v, ok]
}
