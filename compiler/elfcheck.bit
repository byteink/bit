// In-Bit self-checks for the ELF64 ET_REL object writer. Split out of
// selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

// ---- elf.bit: the ELF64 ET_REL object writer (#342 ported) ----------------

// The message writeElfObject failed with, or "" if it succeeded.
fn elfErr(t: ElfTarget, obj: ElfObject): string {
  let msg = ""
  writeElfObject(t, obj) catch e {
    msg = e.message()
    []u8(0)
  }
  return msg
}

fn checkElfMinimal() {
  // push rbp; mov rbp,rsp; pop rbp; ret
  let code = [u8(0x55), u8(0x48), u8(0x89), u8(0xe5), u8(0x5d), u8(0xc3)]
  let obj = ElfObject{
    sections: [
      ElfSection{
        kind: ElfSectionKind.Text, data: code, size: 0,
        alignment: 16,
      },
    ],
    symbols: [
      ElfSymbol{
        name: "main", hasSection: true,
        section: ElfSectionKind.Text, offset: 0, size: len(code),
        binding: ElfBinding.Global, kind: ElfSymKind.Func,
      },
    ],
    relocations: []ElfRelocation(0),
  }
  assert(elfErr(ElfTarget.X86_64, obj) == "") // a valid object is not rejected
  let b = elfBytes(ElfTarget.X86_64, obj)

  // e_ident: 0x7f 'E' 'L' 'F', ELFCLASS64, ELFDATA2LSB, version 1.
  assert(b[0] == u8(127) && b[1] == u8(69) && b[2] == u8(76) && b[3] == u8(70))
  assert(b[4] == u8(2))
  assert(b[5] == u8(1))
  assert(b[6] == u8(1))
  assert(leAt(b, 16, 2) == 1)  // e_type == ET_REL
  assert(leAt(b, 18, 2) == 62) // e_machine == EM_X86_64
  assert(leAt(b, 52, 2) == sizeofElfEhdr())
  assert(leAt(b, 58, 2) == sizeofElfShdr())
  assert(leAt(b, 40, 8) > 0) // e_shoff points past the header

  // An ET_REL object has no program headers.
  assert(leAt(b, 32, 8) == 0) // e_phoff
  assert(leAt(b, 54, 2) == 0) // e_phentsize
  assert(leAt(b, 56, 2) == 0) // e_phnum

  // Section header 0 is the mandatory null entry.
  let z = elfShdrAt(b, 0)
  assert(leAt(b, z, 4) == 0 && leAt(b, z + 4, 4) == 0)

  let ti = elfFindSection(b, ".text")
  assert(ti > 0)
  let th = elfShdrAt(b, ti)
  assert(leAt(b, th + 4, 4) == 1) // SHT_PROGBITS
  assert(leAt(b, th + 8, 8) == 6) // SHF_ALLOC | SHF_EXECINSTR
  assert(leAt(b, th + 32, 8) == len(code))
  assert(leAt(b, th + 48, 8) == 16) // sh_addralign
  let off = leAt(b, th + 24, 8)
  assert(off % 16 == 0) // the writer honoured the alignment
  let i = 0
  while (i < len(code)) {
    assert(b[off + i] == code[i])
    i = i + 1
  }

  // .symtab: the null symbol, then `main` as a global STT_FUNC in .text.
  let si = elfFindSection(b, ".symtab")
  assert(si > 0)
  let sh = elfShdrAt(b, si)
  assert(leAt(b, sh + 4, 4) == 2)               // SHT_SYMTAB
  assert(leAt(b, sh + 56, 8) == sizeofElfSym()) // sh_entsize
  assert(leAt(b, sh + 32, 8) == 2 * sizeofElfSym())
  assert(leAt(b, sh + 44, 4) == 1)                            // sh_info: one past the last local
  assert(leAt(b, sh + 40, 4) == elfFindSection(b, ".strtab")) // sh_link
  let syms = leAt(b, sh + 24, 8)
  let s1 = syms + sizeofElfSym()
  // st_info: STB_GLOBAL (1) << 4 | STT_FUNC (2).
  assert(leAt(b, s1 + 4, 1) == 18)
  assert(leAt(b, s1 + 6, 2) == ti)         // st_shndx names .text
  assert(leAt(b, s1 + 8, 8) == 0)          // st_value
  assert(leAt(b, s1 + 16, 8) == len(code)) // st_size
  let strs = leAt(b, elfShdrAt(b, elfFindSection(b, ".strtab")) + 24, 8)
  assert(elfStrAt(b, strs, leAt(b, s1, 4)) == "main")
}

fn checkElfFull() {
  // bl #0 (placeholder); ret
  let code = [u8(0x00), u8(0x00), u8(0x00), u8(0x94), u8(0xc0), u8(0x03), u8(0x5f), u8(0xd6)]
  let rodata = []byte("hello")
  // 12 bytes, not 8: leaves the write cursor 4 past an 8-boundary, so the
  // .rela.* sections that follow can only be 8-aligned if the writer padded.
  let gcMeta = []u8(12)
  let obj = ElfObject{
    sections: [
      ElfSection{ kind: ElfSectionKind.Text, data: code, size: 0, alignment: 4 },
      ElfSection{ kind: ElfSectionKind.Rodata, data: rodata, size: 0, alignment: 1 },
      // Stray data on a .bss section: the contract says a NOBITS section's bytes
      // are implicitly zero and its size comes from `size`, so the writer must
      // ignore `data` outright. Passing junk here is what makes that guard
      // testable — with the data written, .bit_gc below would be shoved along by
      // 32 bytes while sh_size still claimed 64.
      ElfSection{ kind: ElfSectionKind.Bss, data: []u8(32), size: 64, alignment: 8 },
      ElfSection{ kind: ElfSectionKind.GcMeta, data: gcMeta, size: 0, alignment: 8 },
    ],
    symbols: [
      ElfSymbol{
        name: "main", hasSection: true, section: ElfSectionKind.Text,
        offset: 0, size: len(code), binding: ElfBinding.Global, kind: ElfSymKind.Func,
      },
      ElfSymbol{
        name: "bit_rt_alloc", hasSection: false, section: ElfSectionKind.Text,
        offset: 0, size: 0, binding: ElfBinding.Global, kind: ElfSymKind.Notype,
      },
      ElfSymbol{
        name: "__bitstr_0", hasSection: true, section: ElfSectionKind.Rodata,
        offset: 0, size: len(rodata), binding: ElfBinding.Local, kind: ElfSymKind.Object,
      },
    ],
    relocations: [
      ElfRelocation{
        section: ElfSectionKind.Text, offset: 0, symbol: "bit_rt_alloc",
        kind: ElfRelocKind.Call26, addend: 0,
      },
      ElfRelocation{
        section: ElfSectionKind.GcMeta, offset: 0, symbol: "__bitstr_0",
        kind: ElfRelocKind.Abs64, addend: 0,
      },
    ],
  }
  assert(elfErr(ElfTarget.Aarch64, obj) == "")
  let b = elfBytes(ElfTarget.Aarch64, obj)
  assert(leAt(b, 18, 2) == 183) // EM_AARCH64

  // Every section's sh_offset must be a multiple of its own sh_addralign. The
  // 5-byte .rodata above is what gives this teeth: it leaves the cursor at an
  // odd offset, so the 8-aligned sections after it can only satisfy this if the
  // writer actually padded.
  let sn = leAt(b, 60, 2)
  let sx = 1
  while (sx < sn) {
    let hh = elfShdrAt(b, sx)
    let al = leAt(b, hh + 48, 8)
    if (al > 1) {
      assert(leAt(b, hh + 24, 8) % al == 0)
    }
    sx = sx + 1
  }

  // .bss is SHT_NOBITS: it has a size but occupies no file bytes. Its sh_offset
  // must still be inside the file, and the section that follows must not have
  // been pushed along by its 64 bytes.
  let bi = elfFindSection(b, ".bss")
  assert(bi > 0)
  let bh = elfShdrAt(b, bi)
  assert(leAt(b, bh + 4, 4) == 8)   // SHT_NOBITS
  assert(leAt(b, bh + 32, 8) == 64) // sh_size
  assert(leAt(b, bh + 8, 8) == 3)   // SHF_ALLOC | SHF_WRITE

  let gi = elfFindSection(b, ".bit_gc")
  assert(gi > 0)
  assert(leAt(b, elfShdrAt(b, gi) + 8, 8) == 2) // SHF_ALLOC only — never writable
  // .bss contributes no file bytes, so .bit_gc starts within 8 (its alignment)
  // of where .bss's header claims to sit.
  assert(leAt(b, elfShdrAt(b, gi) + 24, 8) - leAt(b, bh + 24, 8) < 8)

  // .rela.text: one CALL26 against bit_rt_alloc; sh_info names .text, sh_link
  // the symtab (patched only after the symtab's index was known).
  let ri = elfFindSection(b, ".rela.text")
  assert(ri > 0)
  let rh = elfShdrAt(b, ri)
  assert(leAt(b, rh + 4, 4) == 4)                // SHT_RELA
  assert(leAt(b, rh + 32, 8) == sizeofElfRela()) // exactly one entry
  assert(leAt(b, rh + 44, 4) == elfFindSection(b, ".text"))
  assert(leAt(b, rh + 40, 4) == elfFindSection(b, ".symtab"))
  let r0 = leAt(b, rh + 24, 8)
  assert(leAt(b, r0, 8) == 0)       // r_offset
  assert(leAt(b, r0 + 8, 4) == 283) // R_AARCH64_CALL26
  assert(leAt(b, r0 + 16, 8) == 0)  // r_addend

  // The r_info symbol index must actually name bit_rt_alloc in the symtab.
  let symsOff = leAt(b, elfShdrAt(b, elfFindSection(b, ".symtab")) + 24, 8)
  let strs = leAt(b, elfShdrAt(b, elfFindSection(b, ".strtab")) + 24, 8)
  let rsym = leAt(b, r0 + 12, 4)
  let rs = symsOff + rsym * sizeofElfSym()
  assert(elfStrAt(b, strs, leAt(b, rs, 4)) == "bit_rt_alloc")
  assert(leAt(b, rs + 6, 2) == 0) // SHN_UNDEF — the linker must resolve it

  let gri = elfFindSection(b, ".rela.bit_gc")
  assert(gri > 0)
  let g0 = leAt(b, elfShdrAt(b, gri) + 24, 8)
  assert(leAt(b, g0 + 8, 4) == 257) // R_AARCH64_ABS64
}

// ELF's symtab contract: every STB_LOCAL precedes every STB_GLOBAL, and sh_info
// is the boundary. The writer reorders to honour it, so a caller listing a
// global first must still produce locals-first — and each relocation's r_info
// must follow its symbol to its NEW slot.
fn checkElfSymbolOrder() {
  let code = [u8(0), u8(0), u8(0), u8(0)]
  let obj = ElfObject{
    sections: [ElfSection{ kind: ElfSectionKind.Text, data: code, size: 0, alignment: 1 }],
    symbols: [
      ElfSymbol{
        name: "g1", hasSection: true, section: ElfSectionKind.Text,
        offset: 0, size: 0, binding: ElfBinding.Global, kind: ElfSymKind.Func,
      },
      ElfSymbol{
        name: "l1", hasSection: true, section: ElfSectionKind.Text,
        offset: 0, size: 0, binding: ElfBinding.Local, kind: ElfSymKind.Func,
      },
      ElfSymbol{
        name: "g2", hasSection: true, section: ElfSectionKind.Text,
        offset: 0, size: 0, binding: ElfBinding.Global, kind: ElfSymKind.Func,
      },
      ElfSymbol{
        name: "l2", hasSection: true, section: ElfSectionKind.Text,
        offset: 0, size: 0, binding: ElfBinding.Local, kind: ElfSymKind.Func,
      },
    ],
    relocations: [
      ElfRelocation{
        section: ElfSectionKind.Text, offset: 0,
        symbol: "g2", kind: ElfRelocKind.Pc32, addend: -4,
      },
    ],
  }
  let b = elfBytes(ElfTarget.X86_64, obj)
  let sh = elfShdrAt(b, elfFindSection(b, ".symtab"))
  let syms = leAt(b, sh + 24, 8)
  let strs = leAt(b, elfShdrAt(b, elfFindSection(b, ".strtab")) + 24, 8)
  let nameOf = []string(0)
  let i = 1
  while (i < 5) {
    nameOf = append(nameOf, elfStrAt(b, strs, leAt(b, syms + i * sizeofElfSym(), 4)))
    i = i + 1
  }
  // Locals first, each group keeping the caller's own relative order.
  assert(nameOf[0] == "l1")
  assert(nameOf[1] == "l2")
  assert(nameOf[2] == "g1")
  assert(nameOf[3] == "g2")
  assert(leAt(b, sh + 44, 4) == 3) // sh_info: 2 locals + the null symbol

  // g2 moved from caller-slot 3 to symtab slot 4; r_info must name 4, not 3.
  let r0 = leAt(b, elfShdrAt(b, elfFindSection(b, ".rela.text")) + 24, 8)
  assert(leAt(b, r0 + 12, 4) == 4)
  assert(elfStrAt(b, strs, leAt(b, syms + 4 * sizeofElfSym(), 4)) == "g2")
  assert(leAt(b, r0 + 8, 4) == 2) // R_X86_64_PC32
  assert(leAt(b, r0 + 16, 8) == -4)
}

fn checkElfRejects() {
  // A 4-byte section: big enough that a 4-byte relocation at offset 0 FITS, so
  // the unknown-symbol case reaches its own check instead of tripping the
  // bounds check first (validation order: bounds, then symbol).
  let code = [u8(0), u8(0), u8(0), u8(0)]
  let text = ElfSection{ kind: ElfSectionKind.Text, data: code, size: 0, alignment: 1 }
  let noRelocs = []ElfRelocation(0)

  // Nothing can ever define an undefined local, so the binding is meaningless.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: []ElfSection(0),
          symbols: [
            ElfSymbol{
              name: "hidden", hasSection: false,
              section: ElfSectionKind.Text, offset: 0, size: 0,
              binding: ElfBinding.Local, kind: ElfSymKind.Notype,
            },
          ],
          relocations: noRelocs,
        },
      ) ==
      "UndefinedLocalSymbol",
  )

  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [
            text,
            ElfSection{
              kind: ElfSectionKind.Text, data: code, size: 0,
              alignment: 1,
            },
          ],
          symbols: []ElfSymbol(0), relocations: noRelocs,
        },
      ) ==
      "DuplicateSection",
  )

  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [
            ElfSection{
              kind: ElfSectionKind.Text, data: code, size: 0,
              alignment: 3,
            },
          ],
          symbols: []ElfSymbol(0), relocations: noRelocs,
        },
      ) ==
      "InvalidSectionAlignment",
  )

  let dup = ElfSymbol{
    name: "same", hasSection: true, section: ElfSectionKind.Text,
    offset: 0, size: 4, binding: ElfBinding.Global, kind: ElfSymKind.Func,
  }
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [dup, dup], relocations: noRelocs,
        },
      ) ==
      "DuplicateSymbol",
  )

  // A symbol naming a section this object does not carry.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [
            ElfSymbol{
              name: "d", hasSection: true, section: ElfSectionKind.Data,
              offset: 0, size: 0, binding: ElfBinding.Global, kind: ElfSymKind.Object,
            },
          ],
          relocations: noRelocs,
        },
      ) ==
      "SectionNotPresent",
  )

  // offset + size must fit inside the section.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [
            ElfSymbol{
              name: "big", hasSection: true, section: ElfSectionKind.Text,
              offset: 0, size: 99, binding: ElfBinding.Global, kind: ElfSymKind.Func,
            },
          ],
          relocations: noRelocs,
        },
      ) ==
      "SymbolOutOfBounds",
  )

  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: []ElfSymbol(0),
          relocations: [
            ElfRelocation{
              section: ElfSectionKind.Text, offset: 0,
              symbol: "nope", kind: ElfRelocKind.Pc32, addend: 0,
            },
          ],
        },
      ) ==
      "UnknownSymbol",
  )

  // The relocated FIELD must fit too: a 4-byte pc32 at offset 2 needs [2..6) of
  // a 4-byte section.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [dup],
          relocations: [
            ElfRelocation{
              section: ElfSectionKind.Text, offset: 2,
              symbol: "same", kind: ElfRelocKind.Pc32, addend: 0,
            },
          ],
        },
      ) ==
      "RelocOutOfBounds",
  )

  // An 8-byte abs64 at offset 0 does not fit a 4-byte section either — the
  // width comes from the KIND, not the field's start.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [dup],
          relocations: [
            ElfRelocation{
              section: ElfSectionKind.Text, offset: 0,
              symbol: "same", kind: ElfRelocKind.Abs64, addend: 0,
            },
          ],
        },
      ) ==
      "RelocOutOfBounds",
  )

  // Each ARM64 reloc kind has no x86-64 encoding, and pc32 has no ARM64 one.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [dup],
          relocations: [
            ElfRelocation{
              section: ElfSectionKind.Text, offset: 0,
              symbol: "same", kind: ElfRelocKind.Call26, addend: 0,
            },
          ],
        },
      ) ==
      "RelocKindUnsupportedForTarget",
  )
  assert(
      elfErr(
        ElfTarget.Aarch64,
        ElfObject{
          sections: [text],
          symbols: [dup],
          relocations: [
            ElfRelocation{
              section: ElfSectionKind.Text, offset: 0,
              symbol: "same", kind: ElfRelocKind.Pc32, addend: 0,
            },
          ],
        },
      ) ==
      "RelocKindUnsupportedForTarget",
  )

  // A valid object with a resolvable relocation reports no error.
  assert(
      elfErr(
        ElfTarget.X86_64,
        ElfObject{
          sections: [text],
          symbols: [dup],
          relocations: [
            ElfRelocation{
              section: ElfSectionKind.Text, offset: 0,
              symbol: "same", kind: ElfRelocKind.Pc32, addend: -4,
            },
          ],
        },
      ) ==
      "",
  )
}
