// compiler/pmfetchresolve.bit — resolving a parsed dependency spec to bytes
// on disk (#2968, split off compiler/pmfetch.bit under the 800-line limit,
// spec/LINT.md §4). Sibling of pmfetch.bit (same module): pmfetch.bit owns
// the dependency-spec GRAMMAR (`DepSpec`, `parseSpec`, `validateSegment` and
// the other per-form parsers); this file owns everything that turns an
// already-parsed, already-validated spec into a resolved commit and a
// checked-out cache entry — ref resolution (`resolveDependencyRef`), tag
// enumeration for a range resolver (`listVersions`, #2365), the
// content-addressed git fetch/cache (`fetchSha`), vanity-name resolution
// over HTTPS (`resolveVanityUrl`, SPEC §17.7), and reading a fetched
// dependency's own `bit.json` (`readManifest`). See pmfetch.bit's own module
// header for the design notes that still apply here unchanged: the
// subprocess timeout discipline `runGit` (pmfetchtail.bit) implements, and
// the vanity-resolution deadline/body-cap rationale.
import { sortInPlace } from "std/sort"

// --- resolving a ref to a commit -----------------------------------------

// Resolves `ref` (an exact tag, a branch name, or a bare commit sha) against
// `url` to a 40-hex commit sha. A `ref` that is already a full sha is
// returned as-is with no subprocess call at all — SPEC §17.7 allows pinning a
// bare sha directly, and there is nothing to resolve. Otherwise runs
// `git ls-remote`, bounded by `timeoutMs`.
//
// Queries TWO patterns, `ref` and `${ref}^{}`: an exact (non-glob) ref-name
// query only ever gets the peeled companion line back for an ANNOTATED tag
// (`git tag -a`/`-s`, every GitHub Release) when that literal peeled ref
// name — `<ref>^{}`, the wire form git itself advertises it under — is
// asked for directly. Passing just `ref` gets ONLY the tag object, silently:
// no error, no second line, an `ls-remote` that looks identical to a
// lightweight tag's. `--exit-code` still succeeds as long as at least one
// pattern matches, so this is a no-op for a branch or a lightweight tag,
// where `${ref}^{}` never names anything.
export fn resolveDependencyRef(gitBin: string, url: string, ref: string, timeoutMs: int): string! {
  if (isFullSha(ref)) {
    return ref
  }
  let run = runGit(gitBin, ["ls-remote", "--exit-code", url, ref, "${ref}^{}"], timeoutMs)?
  if (run.timedOut) {
    fail newError("pmfetch: git ls-remote timed out after ${timeoutMs}ms: ${url}@${ref}")
  }
  if (run.exitCode != 0) {
    let detail = pmTrim(run.output)
    // `git ls-remote <url> <ref>` exits non-zero with EMPTY stdout+stderr when
    // `ref` simply does not exist (verified exit 2 on git 2.55.0) — unlike an
    // unreachable/not-found remote (exit 128), which always writes to stderr.
    // Passing that empty `detail` through verbatim left a bare trailing colon
    // and no message at all (#2268); a nonexistent ref is the single most
    // common `bit add` mistake, so this gets its own named diagnostic instead
    // of degrading further into the generic exit-code line below.
    if (len(detail) == 0) {
      fail newError("pmfetch: no ref '${ref}' in ${url}")
    }
    fail newError("pmfetch: git ls-remote failed (exit ${run.exitCode}) for ${url}@${ref}: ${detail}")
  }
  let sha = shaFromLsRemote(run.output)
  if (len(sha) == 0) {
    fail newError("pmfetch: git ls-remote returned no match for ${url}@${ref}")
  }
  return sha
}

// `git ls-remote`'s output is one `<sha>\t<ref>` line per match. A branch or
// a lightweight tag has exactly one matching line, and that sha is already a
// commit. An ANNOTATED tag (`git tag -a`/`-s`, every GitHub Release, and any
// machine with `tag.gpgsign true` set) additionally emits a second, PEELED
// line whose ref ends in `^{}` — that line's sha is the underlying commit,
// while the plain `refs/tags/<tag>` line's sha is the tag OBJECT, not a
// commit. `fetchSha`'s integrity check compares against `git rev-parse
// HEAD`, which is always a commit, so returning the tag-object sha here
// fails that check on every annotated tag. Scan every line, prefer the
// peeled one, and fall back to the first valid line's sha when there is no
// peeled line (branch, lightweight tag, or bare commit ref).
fn shaFromLsRemote(output: string): string {
  let lines = split(output, "\n")
  let fallback = ""
  let li = 0
  while (li < len(lines)) {
    let line = lines[li]
    li = li + 1
    let i = 0
    while (i < len(line) && line[i] != '\t' && line[i] != ' ') {
      i = i + 1
    }
    let sha = line[0:i]
    if (!isFullSha(sha)) {
      continue
    }
    let ref = line[i:len(line)]
    if (hasSuffix(ref, "^{}")) {
      return sha
    }
    if (len(fallback) == 0) {
      fallback = sha
    }
  }
  return fallback
}

// --- listing available versions from tags (#2365) ------------------------

// Enumerates the version tags `url` carries: runs
// `git ls-remote --tags --refs <url>`, keeps only tag names
// `canonicalVersion` (pmversion.bit) accepts — both the bare `1.2.3` and the
// `v1.2.3` spellings, since a third-party repository may use either — and
// returns their parsed `Version`s sorted DESCENDING (highest first). A tag
// that is not a valid version in either spelling (a release-notes tag,
// `latest`, a prerelease qualifier this format admits no syntax for,
// anything else) is silently skipped rather than failing the whole call.
// Resolving a selected version back to a commit sha stays
// `resolveDependencyRef`'s job; this function only enumerates.
//
// `--tags` alone matches every tag at once (unlike `resolveDependencyRef`'s
// single named `ref` query), so the ANNOTATED-tag peeling #2064 fixed shows
// up here in the opposite shape: instead of a peeled line being silently
// withheld unless asked for by its exact `<ref>^{}` name, a wildcard `--tags`
// query reports BOTH the tag-object line and a second, peeled `^{}` line for
// every annotated tag, and a `^{}`-suffixed ref does not parse as a tag name
// at all. `--refs` suppresses that second line — verified against real git
// 2.55 rather than assumed, since assuming was exactly what made #2064's
// first attempted fix a no-op (`checkPmfetchListVersionsRefsSuppressesPeel`,
// pmfetchresolvecheck.bit, asserts the peeled line is present WITHOUT the
// flag and absent WITH it, so the flag is proven to do something rather than
// the assertion merely never firing).
export fn listVersions(gitBin: string, url: string, timeoutMs: int): []Version! {
  let run = runGit(gitBin, ["ls-remote", "--tags", "--refs", url], timeoutMs)?
  if (run.timedOut) {
    fail newError("pmfetch: git ls-remote --tags timed out after ${timeoutMs}ms: ${url}")
  }
  if (run.exitCode != 0) {
    fail newError("pmfetch: git ls-remote --tags failed (exit ${run.exitCode}) for ${url}: ${pmTrim(run.output)}")
  }

  let versions = []Version(0)
  let lines = split(run.output, "\n")
  let li = 0
  while (li < len(lines)) {
    let (v, ok) = versionFromLsRemoteTagLine(lines[li])
    if (ok) {
      versions = append(versions, v)
    }
    li = li + 1
  }
  sortInPlace(versions, versionGreater)
  return versions
}

// One `git ls-remote --tags --refs` output line, `<sha>\trefs/tags/<name>`,
// to its parsed `Version` — or `(_, false)` when the line is blank, not a
// `refs/tags/` entry (a branch, or a peeled `^{}` line if one ever leaked
// through), or `name` is not a version `canonicalVersion` accepts in either
// spelling.
fn versionFromLsRemoteTagLine(line: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  let tab = indexOf(line, "\t")
  if (tab < 0) {
    return zero, false
  }
  let ref = line[tab + 1:len(line)]
  if (!hasPrefix(ref, "refs/tags/")) {
    return zero, false
  }
  let name = ref[10:len(ref)] // len("refs/tags/")
  let (canon, ok) = canonicalVersion(name)
  if (!ok) {
    return zero, false
  }
  return parseVersion(canon)
}

// `versionLess` (pmresolve.bit), flipped — passed to `sortInPlace` (std/sort)
// this sorts `listVersions`' result highest-first instead of that library's
// default ascending order. Defines no ordering of its own.
fn versionGreater(a: Version, b: Version): bool {
  return versionLess(b, a)
}

// --- fetching into the content-addressed cache ---------------------------

// Fetches `sha` from `url` into `<cacheRoot>/<host>/<owner>/<repo>/<sha>/`, or
// verifies an already-cached copy. `sha` must already be a resolved 40-hex
// commit — this is the `bit.lock`-driven entry point (a lock entry records
// exactly this), not the ref-resolving one (`resolveDependencyRef`, above).
//
// A cache hit is verified, never trusted blind: `git rev-parse HEAD` inside
// the cached checkout must equal `sha`, or this fails loudly rather than
// silently re-fetching — a mismatch means the cache directory was tampered
// with or corrupted, and re-resolving over it would paper over exactly that.
//
// A fresh fetch (`finalDir` does not exist yet) is built entirely inside a
// SCRATCH directory beside it and only moved into place once every step
// verifies (#2257): before this, `init`/`fetch`/`checkout` ran directly
// against `finalDir`, so any failure in between — a network drop, a killed
// process, a sha that turns out not to exist on the remote — left a
// half-fetched directory sitting exactly where a later run's `isDir(finalDir)`
// check treats a directory as a cache-hit CANDIDATE. That later run then hit
// the integrity check above and failed with "cache integrity error", forever
// — the identical `bit add` failed a SECOND time in a different, more
// confusing way, and nothing in the tool could clear it. Building in scratch
// means a failed fetch leaves nothing at `finalDir` at all: a corrected retry
// (the right sha, a reachable host) succeeds on its own, no manual cleanup
// needed.
//
// `pkgDir` is `bit.lock`'s `LockEntry.dir` (#3270): non-empty only for a
// vanity dependency whose `bit-import:` document named a subdirectory of a
// larger repository as the package's own root (SPEC §17.7, e.g. a
// first-party package under `pkg/<name>/`). Passed straight to
// `fetchGitInto`, which narrows the fetch/checkout to it (#3470) — empty
// keeps today's whole-repository behaviour byte-for-byte, since a
// whole-repo package has no subdirectory to narrow to.
export fn fetchSha(
  gitBin: string, cacheRoot: string, host: string, owner: string, repo: string,
  url: string, sha: string, pkgDir: string, timeoutMs: int,
): FetchResult! {
  if (!isFullSha(sha)) {
    fail newError("pmfetch: fetchSha needs an already-resolved commit sha, got: ${sha}")
  }
  validateSegment(host)?
  validateOwnerPath(owner)?
  validateSegment(repo)?

  let finalDir = cacheRoot + "/" + host + "/" + owner + "/" + repo + "/" + sha

  if (isDir(finalDir)) {
    let actual = revParseHead(gitBin, finalDir, timeoutMs)?
    if (actual != sha) {
      fail newError("pmfetch: cache integrity error at ${finalDir}: expected ${sha}, found ${actual} — remove it and retry: rm -rf ${finalDir}")
    }
    return FetchResult{ dir: finalDir, sha: sha, cacheHit: true }
  }

  mkdirAll(pathDir(finalDir))?

  let scratchDir = finalDir + ".tmp-" + uuidFormat(uuidV4())
  fetchGitInto(gitBin, scratchDir, url, sha, pkgDir, timeoutMs) catch e {
    removeTree(scratchDir, timeoutMs)
    fail e
  }

  // Another process may have won the race and already placed a verified
  // `finalDir` while this one was fetching into its own scratch copy (two
  // concurrent `bit add`s of the same not-yet-cached dependency) — never
  // overwrite a real entry; just discard the redundant scratch copy and
  // verify the winner exactly like an ordinary cache hit.
  if (isDir(finalDir)) {
    removeTree(scratchDir, timeoutMs)
    let actual = revParseHead(gitBin, finalDir, timeoutMs)?
    if (actual != sha) {
      fail newError("pmfetch: cache integrity error at ${finalDir}: expected ${sha}, found ${actual} — remove it and retry: rm -rf ${finalDir}")
    }
    return FetchResult{ dir: finalDir, sha: sha, cacheHit: true }
  }

  let mv = runGit("mv", [scratchDir, finalDir], timeoutMs) catch e {
    removeTree(scratchDir, timeoutMs)
    fail e
  }
  if (mv.timedOut) {
    removeTree(scratchDir, timeoutMs)
    fail newError("pmfetch: moving the fetched checkout into place timed out after ${timeoutMs}ms: ${finalDir}")
  }
  if (mv.exitCode != 0) {
    removeTree(scratchDir, timeoutMs)
    fail newError("pmfetch: moving the fetched checkout into place failed (exit ${mv.exitCode}) for ${finalDir}: ${pmTrim(mv.output)}")
  }

  return FetchResult{ dir: finalDir, sha: sha, cacheHit: false }
}

// The init/fetch/checkout/verify sequence that used to run directly against
// `fetchSha`'s `finalDir`, now run entirely inside a scratch directory so
// `fetchSha` can clean up with one `removeTree` call on any failure instead
// of repeating it after each of the four steps (#2257).
//
// `pkgDir` non-empty (#3470) narrows the fetch to that subdirectory via
// `narrowFetchInto` instead of the plain whole-repository `git fetch` below —
// see that function's own comment for why both steps (sparse-checkout AND
// `--filter=blob:none`) are needed. Empty keeps the original two-argument
// `git fetch --depth 1 <url> <sha>` unchanged, so a whole-repo package's
// behaviour is untouched byte-for-byte.
fn fetchGitInto(gitBin: string, dir: string, url: string, sha: string, pkgDir: string, timeoutMs: int): ()! {
  let init = runGit(gitBin, ["init", "--quiet", dir], timeoutMs)?
  if (init.timedOut) {
    fail newError("pmfetch: git init timed out after ${timeoutMs}ms: ${dir}")
  }
  if (init.exitCode != 0) {
    fail newError("pmfetch: git init failed (exit ${init.exitCode}) for ${dir}: ${pmTrim(init.output)}")
  }

  if (len(pkgDir) > 0) {
    narrowFetchInto(gitBin, dir, url, sha, pkgDir, timeoutMs)?
  } else {
    let fetch = runGit(gitBin, ["-C", dir, "fetch", "--quiet", "--depth", "1", url, sha], timeoutMs)?
    if (fetch.timedOut) {
      fail newError("pmfetch: git fetch timed out after ${timeoutMs}ms: ${url}@${sha}")
    }
    if (fetch.exitCode != 0) {
      fail newError("pmfetch: git fetch failed (exit ${fetch.exitCode}) for ${url}@${sha}: ${pmTrim(fetch.output)}")
    }
  }

  let checkout = runGit(gitBin, ["-C", dir, "checkout", "--quiet", sha], timeoutMs)?
  if (checkout.timedOut) {
    fail newError("pmfetch: git checkout timed out after ${timeoutMs}ms: ${sha} in ${dir}")
  }
  if (checkout.exitCode != 0) {
    fail newError("pmfetch: git checkout failed (exit ${checkout.exitCode}) for ${sha} in ${dir}: ${pmTrim(checkout.output)}")
  }

  let actual = revParseHead(gitBin, dir, timeoutMs)?
  if (actual != sha) {
    fail newError("pmfetch: fetched content does not match requested sha (got ${actual}, want ${sha}) in ${dir}")
  }
}

// Narrows `dir`'s fetch to `pkgDir` rather than pulling every blob in the
// repository at `sha` (#3470): a plain `git fetch <url> <sha>` has no
// narrower unit than "everything reachable from this commit", so installing
// one small first-party package under `pkg/<name>/` wrote the whole
// compiler tree — measured at 20M across 2427 files for this repo.
//
// Two client-side mechanisms, both needed, neither alone sufficient:
//   - `sparse-checkout set --no-cone <pkgDir>` restricts which paths are
//     ever WRITTEN to the working tree. This alone still fetches every
//     blob at `sha` into `.git/objects` — it only shrinks the checkout.
//   - `--filter=blob:none` (partial clone) makes blobs lazy: combined with
//     sparse-checkout, git only ever demands the blobs `pkgDir` needs, so
//     the objects fetched shrink too. This needs the SERVER to advertise
//     `uploadpack.allowFilter` — every real git host tested here (GitHub)
//     does, by default; a bare `file://` remote does not unless its own
//     `uploadpack.allowFilter` is explicitly set, in which case git prints
//     "filtering not recognized by server, ignoring" to `fetch`'s captured
//     output and silently fetches every blob anyway (still exit 0). That is
//     git's own degradation, not a fallback this function adds — see
//     `fetchGitInto`'s caller contract: any git failure here still fails the
//     whole fetch outright, never retries wide.
//
// `remote add origin` is required before `sparse-checkout set`: a bare
// `git fetch <url> <sha>` needs no configured remote, but `sparse-checkout`
// and the subsequent `fetch origin <sha>` operate against one.
fn narrowFetchInto(gitBin: string, dir: string, url: string, sha: string, pkgDir: string, timeoutMs: int): ()! {
  let remoteAdd = runGit(gitBin, ["-C", dir, "remote", "add", "origin", url], timeoutMs)?
  if (remoteAdd.timedOut) {
    fail newError("pmfetch: git remote add timed out after ${timeoutMs}ms: ${dir}")
  }
  if (remoteAdd.exitCode != 0) {
    fail newError("pmfetch: git remote add failed (exit ${remoteAdd.exitCode}) for ${dir}: ${pmTrim(remoteAdd.output)}")
  }

  let sparse = runGit(gitBin, ["-C", dir, "sparse-checkout", "set", "--no-cone", pkgDir], timeoutMs)?
  if (sparse.timedOut) {
    fail newError("pmfetch: git sparse-checkout timed out after ${timeoutMs}ms: ${dir}")
  }
  if (sparse.exitCode != 0) {
    fail newError("pmfetch: git sparse-checkout failed (exit ${sparse.exitCode}) for ${dir}: ${pmTrim(sparse.output)}")
  }

  let fetch = runGit(gitBin, ["-C", dir, "fetch", "--quiet", "--depth", "1", "--filter=blob:none", "origin", sha], timeoutMs)?
  if (fetch.timedOut) {
    fail newError("pmfetch: git fetch timed out after ${timeoutMs}ms: ${url}@${sha}")
  }
  if (fetch.exitCode != 0) {
    fail newError("pmfetch: git fetch failed (exit ${fetch.exitCode}) for ${url}@${sha}: ${pmTrim(fetch.output)}")
  }
}

// Best-effort recursive removal of a directory this file created (a scratch
// fetch that failed partway) — reuses `runGit`'s generic, timeout-bounded
// subprocess runner for `rm -rf` rather than adding a second one; `runGit`
// itself is not git-specific despite the name, it just execs `[bin,
// ...args]`. Never fails outward: a cleanup that itself errors (e.g. `dir`
// was never created because `git init` is what failed) must not mask the
// fetch failure the caller is already propagating.
fn removeTree(dir: string, timeoutMs: int) {
  runGit("rm", ["-rf", dir], timeoutMs) catch e { return }
}

// The checked-out commit at `dir`, or a loud failure naming why it could not
// be confirmed. A local (no-network) `git rev-parse`, same deadline as every
// other invocation here.
fn revParseHead(gitBin: string, dir: string, timeoutMs: int): string! {
  let run = runGit(gitBin, ["-C", dir, "rev-parse", "HEAD"], timeoutMs)?
  if (run.timedOut) {
    fail newError("pmfetch: git rev-parse timed out after ${timeoutMs}ms verifying ${dir}")
  }
  if (run.exitCode != 0) {
    fail newError("pmfetch: cannot verify cache at ${dir}: incomplete or corrupted checkout (git rev-parse HEAD failed: ${pmTrim(run.output)})")
  }
  let sha = pmTrim(run.output)
  if (!isFullSha(sha)) {
    fail newError("pmfetch: cannot verify cache at ${dir}: unexpected rev-parse output")
  }
  return sha
}

// `trimSpace` (std/strings) only strips spaces and tabs, not newlines — every
// subprocess this file captures ends its output in one, so this is the
// trimmer actually used on `runGit` output throughout this file.
fn pmTrim(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t' || s[lo] == '\n' || s[lo] == '\r')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t' || s[hi - 1] == '\n' || s[hi - 1] == '\r')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// Validates `owner` as a "/"-joined path of one or more safe segments — the
// same relaxation `splitHostOwnerRepo` applies at parse time for a
// GitLab-style nested group (#2244): `owner` becomes part of the cache
// directory (`<cacheRoot>/<host>/<owner>/<repo>`), which may now be several
// directories deep, so it can no longer be validated as a single
// `validateSegment` call — that charset has no "/" in it and would reject a
// real multi-segment owner outright.
fn validateOwnerPath(owner: string): ()! {
  let parts = split(owner, "/")
  let i = 0
  while (i < len(parts)) {
    validateSegment(parts[i])?
    i = i + 1
  }
}

// mkdir -p, iteratively (Power of 10 rule 2: bounded by the path's own
// segment count, no recursion). `std/fs.mkdir` fails if the parent is
// missing, so every prefix is created in order.
fn mkdirAll(path: string): ()! {
  if (len(path) == 0 || isDir(path)) {
    return
  }
  let parts = split(path, "/")
  let acc = ""
  let i = 0
  while (i < len(parts)) {
    if (len(parts[i]) > 0) {
      acc = acc + "/" + parts[i]
      if (!isDir(acc)) {
        mkdir(acc)?
      }
    }
    i = i + 1
  }
}

// --- the default ~/.bit/pkg cache root -----------------------------------

// `BIT_PKG_CACHE` overrides the whole root, the same override pattern
// `stdRootPath` (main.bit) already uses for `BIT_STDLIB` — it lets a sandboxed
// or CI checkout point a `bit build` at a pre-warmed cache without writing
// into the real `$HOME`, and it is what compiler/projectcheck.bit's own
// self-check uses to prove the warm-cache path never dials the network,
// without touching the developer's own `~/.bit/pkg`.
export fn defaultCacheRoot(): string! {
  let override = envOr("BIT_PKG_CACHE", "")
  if (len(override) > 0) {
    return override
  }
  let home = env("HOME")
  if (len(home) == 0) {
    fail newError("pmfetch: HOME is not set")
  }
  return home + "/.bit/pkg"
}

// The git remote a bare `host/owner/repo` resolves to per SPEC §17.7's
// git-only registry model — the one URL-derivation rule `bit add`'s CLI layer
// (pmcli.bit's `addCmd`) and `bit up`'s (`upDependencies`) both need for a
// dependency bit.lock has no recorded `url` for yet, kept in one place rather
// than each re-deriving the same string.
export fn defaultDepUrl(host: string, owner: string, repo: string): string {
  return "https://" + host + "/" + owner + "/" + repo + ".git"
}

// Parse + resolve + fetch in one call, against the default cache root and
// system git. The high-level entry a future CLI layer (`bit add`/`up`, not
// part of this file) would call for a fresh, not-yet-locked dependency. A
// vanity spec is refused here rather than silently mishandled: resolving one
// safely needs a comparison against whatever `bit.lock` already records for
// the name (`checkResolvedUrlMatches`, below), which this cache-only entry
// point has no access to — `pmcli.bit`'s `addVanityDependency`/
// `pmz.bit`'s `resolveVanityDependency` is the real vanity entry point.
export fn fetchDependency(spec: string, timeoutMs: int): FetchResult! {
  let d = parseSpec(spec)?
  if (d.vanity) {
    fail newError("pmfetch: fetchDependency does not resolve vanity names (${d.vanityName}) — use the bit add/up flow")
  }
  let url = defaultDepUrl(d.host, d.owner, d.repo)
  let sha = resolveDependencyRef(defaultGitBin, url, d.ref, timeoutMs)?
  let root = defaultCacheRoot()?
  return fetchSha(defaultGitBin, root, d.host, d.owner, d.repo, url, sha, "", timeoutMs)?
}

// --- vanity name resolution (SPEC §17.7) ---------------------------------

// The response body cap: a `bit-import:` document exceeding this before its
// single line completes is a hard failure, not a truncation.
export const vanityMaxDocBytes: int = 4096

// The wall-clock deadline for resolving one vanity name, separate from
// `defaultTimeoutMs`'s 30s git-fetch budget — a static single-line GET has no
// reason to share a git clone's budget (SPEC §17.7).
export const vanityTimeoutMs: int = 5000

// The `host`/`owner`/`repo` a resolved git URL decomposes into, mirroring
// `DepSpec`'s own fields for a direct spec — used to key the same
// `<cacheRoot>/<host>/<owner>/<repo>/<sha>` layout `fetchSha` already uses,
// regardless of whether the URL came from a direct spec or a vanity
// resolution (`parseGitRemoteUrl`, below).
class GitRemoteRepo { host: string, owner: string, repo: string }

// The inverse of `defaultDepUrl`: decomposes an `https://` git remote URL
// that is `host/owner/repo[.git]` shaped — exactly the shape every direct
// spec's own derived URL already has by construction. SPEC §17.7 says a
// vanity document's `<gitURL>` is "used exactly as a direct spec's derived
// URL would be", so requiring the same shape here is not a new limitation;
// it is the existing one (`parseSpec`/`splitHostOwnerRepo` require at least
// 3 segments for a direct spec's owner/repo, #2244 relaxed from exactly 3 to
// allow a GitLab-style nested group), just applied to a resolved URL instead
// of a written-out spec.
fn parseGitRemoteUrl(url: string): GitRemoteRepo! {
  if (!hasPrefix(url, "https://")) {
    fail newError("pmfetch: resolved git URL is not https: ${url}")
  }
  let rest = url[8:len(url)]
  if (hasSuffix(rest, ".git")) {
    rest = rest[0:len(rest) - 4]
  }
  let (host, owner, repo, ok) = splitHostOwnerRepo(rest)
  if (!ok) {
    fail newError("pmfetch: resolved git URL is not host/owner/repo shaped: ${url}")
  }
  return GitRemoteRepo{ host: host, owner: owner, repo: repo }
}

// A later resolution of dependency `name` producing a DIFFERENT git URL than
// `bit.lock` already records is a hard failure naming both — never a silent
// switch (SPEC §17.7: "moving a vanity name to a different git remote
// requires removing the dependency and re-adding it"). `existingUrl` empty
// (no prior lock entry, or a fresh `add`) always passes.
export fn checkResolvedUrlMatches(name: string, existingUrl: string, freshUrl: string): ()! {
  if (len(existingUrl) > 0 && existingUrl != freshUrl) {
    fail newError("pmfetch: ${name} resolved to a different git URL than bit.lock already records (recorded: ${existingUrl}, resolved: ${freshUrl}) — remove and re-add the dependency to switch remotes")
  }
}

// Enforces the `vanityMaxDocBytes` cap on a vanity document's body BEFORE any
// parsing — an oversized document is a hard failure, not a truncation.
// `std/http.get` buffers the whole response body before this ever runs (see
// the module header), so this bounds what pmfetch itself will PARSE, not how
// many bytes an oversized response makes the process buffer in memory first.
fn checkVanityCap(body: string): ()! {
  if (len(body) > vanityMaxDocBytes) {
    fail newError("pmfetch: vanity document exceeds the ${vanityMaxDocBytes}-byte cap (got ${len(body)} bytes)")
  }
}

// `body` up to (not including) its first newline, with one trailing `\r`
// stripped if present (a CRLF-terminated line).
fn firstLine(body: string): string {
  let i = 0
  while (i < len(body) && body[i] != '\n') {
    i = i + 1
  }
  let line = body[0:i]
  if (len(line) > 0 && line[len(line) - 1] == '\r') {
    line = line[0:len(line) - 1]
  }
  return line
}

// One resolved `bit-import:` document (SPEC §17.7): `gitUrl` is the
// required `<gitURL>` token; `dir`, from the format's extension point, is
// the subdirectory of the fetched repository that is the package's own
// root — "" when the document names no `dir` field, meaning the repository
// root, exactly as every vanity document resolved before this field
// existed.
class VanityDoc {
  gitUrl: string,
  dir: string,
}

// Validates a `bit-import:` document's `dir` field value (SPEC §17.7): a
// non-empty, `/`-separated, repository-relative path whose every segment
// passes the same charset/traversal check every other repo-derived path
// segment in this module does (`validateSegment`, pmfetch.bit). A vanity
// document is untrusted remote content, so this is the one check standing
// between a hostile `dir` value and walking outside the fetched checkout
// with a `..` segment, or escaping into an absolute path.
fn validateVanityDir(name: string, dir: string): ()! {
  if (len(dir) == 0 || dir[0] == '/') {
    fail newError("pmfetch: bit-import document for ${name} names an invalid dir field: '${dir}'")
  }
  let parts = split(dir, "/")
  let i = 0
  while (i < len(parts)) {
    validateSegment(parts[i]) catch e {
      fail newError("pmfetch: bit-import document for ${name} names an invalid dir field: '${dir}'")
    }
    i = i + 1
  }
}

// Validates and parses a `bit-import:` document body (SPEC §17.7): its first
// line must be exactly `bit-import: <name> git <gitURL>`, each token
// separated by exactly one space, `<name>` byte-for-byte equal to `name`
// (the vanity name that was requested — this is the format's whole trust
// boundary) and `<gitURL>` an `https://` URL. A pure function over an
// already-buffered body — the caller enforces the byte cap
// (`checkVanityCap`) before this ever runs.
//
// Everything after `<gitURL>` is the format's extension point (SPEC
// §17.7); today's one recognized use is `dir <path>` as the fifth and
// sixth tokens (`validateVanityDir`). Anything else there — a `dir` token
// with nothing after it, or a field this version does not recognize at
// all — is silently ignored rather than rejected, exactly as the format's
// own forward-compatibility guarantee requires; only a RECOGNIZED `dir`
// field with an invalid `<path>` is a hard failure.
fn parseVanityDoc(name: string, body: string): VanityDoc! {
  let line = firstLine(body)
  let parts = split(line, " ")
  if (len(parts) < 4) {
    fail newError("pmfetch: malformed bit-import document for ${name}: ${line}")
  }
  if (parts[0] != "bit-import:") {
    fail newError("pmfetch: bit-import document for ${name} does not start with 'bit-import:': ${line}")
  }
  if (parts[1] != name) {
    fail newError("pmfetch: bit-import document claims name '${parts[1]}', requested '${name}'")
  }
  if (parts[2] != "git") {
    fail newError("pmfetch: bit-import document for ${name} is missing the 'git' token: ${line}")
  }
  let gitUrl = parts[3]
  if (!hasPrefix(gitUrl, "https://")) {
    fail newError("pmfetch: bit-import document for ${name} names a non-https git URL: ${gitUrl}")
  }
  let dir = ""
  if (len(parts) >= 6 && parts[4] == "dir") {
    validateVanityDir(name, parts[5])?
    dir = parts[5]
  }
  return VanityDoc{ gitUrl: gitUrl, dir: dir }
}

// The cap-then-parse sequence a fetched vanity document body runs through
// (`resolveVanityUrl`, below) — factored out so it is directly testable
// against a fixture string with no network involved (pmfetchcheck.bit),
// and so the byte cap provably runs BEFORE any parsing rather than after.
fn checkAndParseVanityDoc(name: string, body: string): VanityDoc! {
  checkVanityCap(body)?
  return parseVanityDoc(name, body)?
}

// One vanity-document fetch outcome, delivered over a channel by
// `vanityFetchWorker` to the racing `select` in `resolveVanityUrl`.
class VanityFetchMsg { ok: bool, status: int, body: string, errMsg: string }

// Runs in its own green thread: GET `url` and report the outcome. Never
// fails outward — a transport/TLS error becomes a `VanityFetchMsg{ok:false}`
// so the racing `select` in `resolveVanityUrl` always has a value to read.
fn vanityFetchWorker(url: string, ch: chan<VanityFetchMsg>) {
  let res = get(url) catch e {
    ch <- VanityFetchMsg{ ok: false, status: 0, body: "", errMsg: e.message() }
    return
  }
  ch <- VanityFetchMsg{ ok: true, status: res.status, body: res.body, errMsg: "" }
}

// Runs in its own green thread: park for `timeoutMs`, then signal. Races
// `vanityFetchWorker` in `resolveVanityUrl`'s `select` — `std/http` has no
// request-level deadline of its own (module header), so this is how the
// 5000 ms wall-clock deadline is enforced. If the fetch wins the race, this
// thread's own `sleep` still runs to completion; if the TIMER wins, the fetch
// green thread keeps running until its own work finishes — the deadline
// bounds how long `resolveVanityUrl` blocks its caller, not how long the
// loser lives (see the module header).
fn vanityTimerFire(ch: chan<bool>, timeoutMs: int) {
  sleep(timeoutMs * Millisecond)
  ch <- true
}

// Builds the URL a vanity document fetch requests, given `name` and the raw
// `BIT_VANITY_ORIGIN` override value (`""` when unset). Factored out of
// `resolveVanityUrl` — its only caller, which always passes it
// `envOr("BIT_VANITY_ORIGIN", "")` — the same way `checkAndParseVanityDoc`
// was factored out: so it is directly testable against fixture strings, no
// environment mutation or network involved (pmfetchcheck.bit).
//
// Testing-only seam, the same override pattern `defaultCacheRoot` uses for
// `BIT_PKG_CACHE` and `stdRootPath` (main.bit) uses for `BIT_STDLIB`: it
// lets a test dial a local, plaintext fixture server instead of the real
// vanity host, without weakening anything for a real run — SPEC §17.7 still
// requires HTTPS, so this never touches TLS verification, only which origin
// is dialed. `origin == ""` (unset) is byte-identical to before this
// existed: `"https://" + name`. `origin` set REPLACES the `"https://" +
// <name>`'s host prefix: the part of `name` from its first `/` onward (its
// own path, e.g. `"/pkg/http"`) is appended to `origin` unchanged; a `name`
// with no `/` at all (a bare host, no path) maps to `origin` verbatim. The
// name-must-match check, the byte cap, the deadline and the non-200
// rejection all still run unchanged against whatever this returns, and the
// `<gitURL>` recorded in `bit.lock` comes from the fetched document's body
// (`parseVanityDoc`), never from this URL — this seam cannot affect it.
fn vanityRequestUrl(name: string, origin: string): string {
  if (len(origin) == 0) {
    return "https://" + name
  }
  let slash = indexOf(name, "/")
  if (slash < 0) {
    return origin
  }
  return origin + name[slash:len(name)]
}

// Resolves vanity name `name` (e.g. `"bitlang.org/pkg/http"`) to its
// `VanityDoc` — `<gitURL>` plus an optional `dir` — per SPEC §17.7: one
// HTTPS GET of `https://<name>`, its `bit-import:` document validated and
// parsed (`checkAndParseVanityDoc`), bounded by `timeoutMs` wall-clock.
// `std/http.get` never follows a redirect (module header), so any non-200
// response — including a 3xx that would otherwise have redirected — is
// treated as a resolution failure, which is exactly SPEC's "a redirect to a
// non-https scheme is a hard failure" for a client with no
// redirect-following code path to begin with.
//
// `BIT_VANITY_ORIGIN`, when set, overrides the `https://<host>` prefix this
// dials (`vanityRequestUrl`'s own doc comment) — testing-only, see there.
export fn resolveVanityUrl(name: string, timeoutMs: int): VanityDoc! {
  let url = vanityRequestUrl(name, envOr("BIT_VANITY_ORIGIN", ""))
  let fetchCh = chan<VanityFetchMsg>(1)
  let timeoutCh = chan<bool>(1)
  spawn vanityFetchWorker(url, fetchCh)
  spawn vanityTimerFire(timeoutCh, timeoutMs)

  select {
    case msg = <- fetchCh:
      if (!msg.ok) {
        fail newError("pmfetch: vanity fetch of ${url} failed: ${msg.errMsg}")
      }
      if (msg.status != 200) {
        fail newError("pmfetch: vanity fetch of ${url} returned HTTP ${msg.status}, not 200")
      }
      return checkAndParseVanityDoc(name, msg.body)?
    case <- timeoutCh:
      fail newError("pmfetch: vanity fetch of ${url} timed out after ${timeoutMs}ms")
  }
}

// --- a fetched dependency's own bit.json -----------------------------

// Reads and validates `<dir>/bit.json` — size-capped before anything is
// parsed, then parsed with the shared JSON parser's own nesting-depth guard
// (`jsonparse.bit`'s `jsonMaxDepth`), never a bespoke reader. A dependency
// with no manifest at all (nothing further to resolve) is not an error: it
// reads as an empty, well-formed document.
export fn readManifest(dir: string): JsonDoc! {
  let path = pmJoin(dir, "bit.json")
  if (!exists(path)) {
    return JsonDoc{ nodes: []JsonValue(0), root: -1, ok: true }
  }
  let f = open(path)?
  defer f.close()
  let text = f.read(maxManifestBytes + 1)
  if (len(text) > maxManifestBytes) {
    fail newError("pmfetch: ${path} exceeds the ${maxManifestBytes}-byte manifest cap")
  }
  let doc = jsonParse(text)
  if (!doc.ok) {
    fail newError("pmfetch: ${path} is not valid JSON")
  }
  return doc
}
