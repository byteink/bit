// compiler/classtabledescwords.bit — rendering a class's recorded attributes
// and fields to the quoted, escaped string literals `injectTableDescDecls`
// (classtabledesc.bit) splices into the synthesized `tableDescriptor()`/
// `tableAttrs()` bodies. Split out of classtabledesc.bit (#5064, to hold the
// 800-line ceiling); sibling file, same module. NOT a pure move, and the
// split's first draft called it one: SIX of the eight functions here moved
// byte for byte (verified by hashing each before and after), `tableAttrArgWords`
// is new for #5064's named attribute arguments, and `tableRecordedAttrWords`
// changed by exactly three lines to call it instead of `tableArgWord` directly.

// An argument's rendered spelling (SPEC §10.5): a string literal's own
// DECODED content, or any other literal's raw source text unchanged —
// `@maxLen(255)`'s `255` (not applicable here, since it CALLS) stays the
// three-character string "255" for a recorded attribute that had one.
// `pkg/orm` parses this text itself; this file never interprets it.
fn tableArgSpelling(tree: Tree, source: string, node: int): string {
  let n = getNode(tree, node)
  if (n.tag == Tag.StringLit || n.tag == Tag.RawStringLit) {
    return decodeStringContent(source, n.span.start, n.span.end)
  }
  return source[n.span.start:n.span.end]
}

fn tableFieldNameWord(name: string): string {
  return "\"" + name + "\""
}

fn tableTypeNameWord(typeText: string): string {
  return "\"" + typeText + "\""
}

fn tableAttrNameWord(name: string): string {
  return "\"" + name + "\""
}

// A rendered argument, quoted and escaped for embedding as a Bit string
// literal — the argument's own text may contain quotes or backslashes
// (`@collation("it's")`), which `jsonEscapeChars` (compiler/json.bit) escapes
// the same way Bit's own string-literal grammar requires.
fn tableArgWord(spelling: string): string {
  return "\"" + jsonEscapeChars(spelling) + "\""
}

// One argument's own rendered word(s): a plain argument renders to its one
// spelling; `onDelete = Cascade` (`Tag.NamedArg`) renders to TWO consecutive
// words, name then value, so `AttrDesc.args` for `@belongsTo("userId",
// onDelete = Cascade)` reads `["userId", "onDelete", "Cascade"]` - the
// reader (`pkg/orm`) matches its own keyword names in the flat list.
fn tableAttrArgWords(tree: Tree, source: string, argNode: int): []string {
  if (getNode(tree, argNode).tag == Tag.NamedArg) {
    let k = kidsOf(tree, argNode)
    return [
      tableArgWord(identText(tree, source, k[0])),
      tableArgWord(tableArgSpelling(tree, source, k[1])),
    ]
  }
  return [tableArgWord(tableArgSpelling(tree, source, argNode))]
}

// One recorded attribute's own words - its quoted name and every quoted,
// escaped argument - shared by a field's `attrs` and `@table`'s own
// `classAttrs` (#5189), which need the identical rendering.
fn tableRecordedAttrWords(tree: Tree, source: string, attrs: []RecordedAttr): []string {
  let out = []string(0)
  for a of attrs {
    out = append(out, tableAttrNameWord(identText(tree, source, a.nameNode)))
    for argNode of a.args {
      for w of tableAttrArgWords(tree, source, argNode) {
        out = append(out, w)
      }
    }
  }
  return out
}

// Every distinct word `injectTableDescDecls` needs in the module source.
fn tableDescSynthWords(tree: Tree, source: string, classes: []TableClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    synthTableDescriptorName, synthTableAttrsName, "FieldDesc", "AttrDesc",
    "name", "typeName", "attrs", "args",
  ]
  for c of classes {
    for w of tableRecordedAttrWords(tree, source, c.classAttrs) {
      out = append(out, w)
    }
    for f of c.fields {
      out = append(out, tableFieldNameWord(identText(tree, source, f.nameNode)))
      let tn = getNode(tree, f.typeNode).span
      out = append(out, tableTypeNameWord(source[tn.start:tn.end]))
      for w of tableRecordedAttrWords(tree, source, f.attrs) {
        out = append(out, w)
      }
    }
  }
  return out
}
