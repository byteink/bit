// Self-host lexer (#1503): numeric literal scanning — digit runs, exponents,
// and `scanNumber`. Split out of lexer.bit; a sibling file is the same module.

struct DigitRun {
  count: int,
  badSep: bool,
}

// Consumes a run of base-`class` digits with `_` separators; a `_` not flanked by
// two digits is a bad separator (§5.5). Bounded by the source length.
function digitRun(lx: Lexer, class: DigitClass): DigitRun {
  let count = 0
  let bad = false
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (classOf(c, class)) {
      count = count + 1
      lx.i = lx.i + 1
    } else if (c == '_') {
      let prevOk = count > 0 && classOf(lx.src[lx.i - 1], class)
      let nextOk = lx.i + 1 < len(lx.src) && classOf(lx.src[lx.i + 1], class)
      if (!prevOk || !nextOk) {
        bad = true
      }
      lx.i = lx.i + 1
    } else {
      break
    }
  }
  return DigitRun{ count: count, badSep: bad }
}

struct ExpResult {
  present: bool,
  bad: bool,
}

// An `e`/`E`/`p`/`P` exponent with optional sign; `bad` if the digit run is
// empty or has a bad separator.
function scanExponent(lx: Lexer): ExpResult {
  let c = peekAt(lx, 0)
  if (c != 'e' && c != 'E' && c != 'p' && c != 'P') {
    return ExpResult{ present: false, bad: false }
  }
  lx.i = lx.i + 1
  if (peekAt(lx, 0) == '+' || peekAt(lx, 0) == '-') {
    lx.i = lx.i + 1
  }
  let d = digitRun(lx, DigitClass.Dec)
  return ExpResult{ present: true, bad: d.count == 0 || d.badSep }
}

// A numeric literal (§5.4/§5.5): decimal, `0x`/`0o`/`0b` bases, and decimal or
// hex floats. Mirrors the seed's scanNumber including its badness rules
// (C-octal, empty base, `_` misuse, identifier abut). An invalid literal is a
// single `Invalid` token spanning the whole bad run.
function scanNumber(lx: Lexer): Token {
  let start = lx.i
  let c0 = lx.src[start]
  let isFloat = false
  let bad = false

  if (c0 == '0' && (peekAt(lx, 1) == 'x' || peekAt(lx, 1) == 'X')) {
    lx.i = lx.i + 2
    let r = digitRun(lx, DigitClass.Hex)
    if (r.count == 0 || r.badSep) {
      bad = true
    }
    // A hex float needs a 'p' exponent; a bare '.' without one is bad (§5.5).
    if (peekAt(lx, 0) == '.' || peekAt(lx, 0) == 'p' || peekAt(lx, 0) == 'P') {
      isFloat = true
      if (peekAt(lx, 0) == '.') {
        lx.i = lx.i + 1
        if (digitRun(lx, DigitClass.Hex).badSep) {
          bad = true
        }
      }
      if (peekAt(lx, 0) == 'p' || peekAt(lx, 0) == 'P') {
        if (scanExponent(lx).bad) {
          bad = true
        }
      } else {
        bad = true
      }
    }
  } else if (c0 == '0' && (peekAt(lx, 1) == 'o' || peekAt(lx, 1) == 'O')) {
    lx.i = lx.i + 2
    let r = digitRun(lx, DigitClass.Oct)
    if (r.count == 0 || r.badSep) {
      bad = true
    }
  } else if (c0 == '0' && (peekAt(lx, 1) == 'b' || peekAt(lx, 1) == 'B')) {
    lx.i = lx.i + 2
    let r = digitRun(lx, DigitClass.Bin)
    if (r.count == 0 || r.badSep) {
      bad = true
    }
  } else {
    if (c0 == '.') {
      isFloat = true
      lx.i = lx.i + 1
      let f = digitRun(lx, DigitClass.Dec)
      if (f.count == 0 || f.badSep) {
        bad = true
      }
    } else {
      let leadZero = c0 == '0'
      let r = digitRun(lx, DigitClass.Dec)
      if (r.badSep) {
        bad = true
      }
      // Leading 0 then more decimal digits is C-octal, forbidden (§5.4).
      if (leadZero && r.count > 1) {
        bad = true
      }
      if (peekAt(lx, 0) == '.') {
        isFloat = true
        lx.i = lx.i + 1
        if (digitRun(lx, DigitClass.Dec).badSep) {
          bad = true
        }
      }
    }
    if (peekAt(lx, 0) == 'e' || peekAt(lx, 0) == 'E') {
      isFloat = true
      if (scanExponent(lx).bad) {
        bad = true
      }
    }
  }

  // A valid numeric literal never abuts an identifier character.
  if (lx.i < len(lx.src) && isIdentCont(lx.src[lx.i])) {
    bad = true
    while (lx.i < len(lx.src) && isIdentCont(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }

  if (bad) {
    lexReport(lx, ecInvalidNumber, start, lx.i, "invalid number literal", "check digits and '_' separators")
    return Token{ kind: Kind.Invalid, start: start, end: lx.i }
  }
  if (isFloat) {
    return Token{ kind: Kind.FloatLit, start: start, end: lx.i }
  }
  return Token{ kind: Kind.IntLit, start: start, end: lx.i }
}
