// Self-host (#3326, epic #3322): the TEST-ONLY COFF byte builder pereadercheck.bit's
// self-checks drive readCoffObject with — split out of pereadercheck.bit
// (docs/development.md's 800-line rule) once #3842's `:` -> `=` separator
// sweep pushed the canonical-formatted file back over the ceiling. There is
// still no compiler/pe.bit / compiler/emitpe.bit writer to round-trip
// against (emitpe.bit is #3325, in flight in parallel), so this file is the
// from-scratch fixture builder pereadercheck.bit's module comment describes
// (prFixBuild and friends), plus the two small result-query helpers
// (prErr/prAtomNamed) every check function in that file calls. Sibling .bit
// files are the same module, so `selfcheck()` still calls the check
// functions directly; named to sort bytewise after "pereadercheck.bit".

// ---- fixture types: enough of a COFF object to drive readCoffObject, with
// no ambition beyond what THIS file's tests need -----------------------

class PrFixSection {
  name: string,
  chars: int,
  data: []u8,
  size: int,         // SizeOfRawData; lets a BSS section report a size with no bytes
  hasFileData: bool, // false => PointerToRawData is 0 (a BSS-shaped section)
}

// One raw 18-byte symbol-table slot: either a primary entry or an aux record
// that must be skipped. Callers pick which fields are meaningful via `isAux`.
class PrFixSymbolRaw {
  isAux: bool,
  name: string,
  value: int,
  section: int, // 1-based, 0 = undefined, -1 = absolute, -2 = debug
  storageClass: int,
  naux: int,
  auxScnLen: int,
  auxNReloc: int,
}

class PrFixReloc {
  sectionIdx: int, // 0-based into the `sections` list
  offset: int,
  symRawIndex: int, // RAW index into the assembled symbol table
  rtype: int,
}

class PrFixBuilt {
  bytes: []u8,
  dataOff: []int,
  relocOff: []int,
  relocCount: []int,
}

// PrFixLayout is prFixBuild's intermediate layout pass: where each section's
// raw data and each section's relocation block land in the file, computed
// before any bytes are emitted since the header needs those offsets.
class PrFixLayout {
  dataOff: []int,
  relocOff: []int,
  relocCount: []int,
  symtabOff: int,
}

fn prPutU16(b: []u8, v: int): []u8 {
  b = append(b, u8(v & 255))
  b = append(b, u8((v >> 8) & 255))
  return b
}

fn prPutU32(b: []u8, v: int): []u8 {
  b = append(b, u8(v & 255))
  b = append(b, u8((v >> 8) & 255))
  b = append(b, u8((v >> 16) & 255))
  b = append(b, u8((v >> 24) & 255))
  return b
}

fn prPutI16(b: []u8, v: int): []u8 {
  let u = v
  if (u < 0) {
    u = u + 0x10000
  }
  return prPutU16(b, u)
}

fn prPutName8(b: []u8, name: string): []u8 {
  let nb = []byte(name)
  let k = 0
  while (k < 8) {
    if (k < len(nb)) {
      b = append(b, nb[k])
    } else {
      b = append(b, u8(0))
    }
    k = k + 1
  }
  return b
}

// One 18-byte EXTERNAL symbol-table entry with no aux records: `sectionNumber`
// is 0 for undefined, or 1-based for a definition. Used by
// checkPeReaderNrelocOvfl, which needs two plain symbols and no more.
fn prPutExternSymbol(b: []u8, name: string, sectionNumber: int): []u8 {
  b = prPutName8(b, name)
  b = prPutU32(b, 0) // Value
  b = prPutI16(b, sectionNumber)
  b = prPutU16(b, 0)   // Type
  b = append(b, u8(2)) // IMAGE_SYM_CLASS_EXTERNAL
  b = append(b, u8(0)) // NumberOfAuxSymbols
  return b
}

// Assembles a well-formed COFF object from a flat description: header,
// section table, section data, per-section relocations, symbol table, string
// table, in that order. A single forward pass over precomputed offsets, so
// there is no reserve-then-patch step to get wrong.
// prFixComputeLayout walks `sections` then `relocs` once each to place every
// section's raw data and every section's relocation block after the fixed
// header + section table, so the header fields below can be filled in before
// any variable-length data is emitted.
fn prFixComputeLayout(sections: []PrFixSection, relocs: []PrFixReloc): PrFixLayout {
  let nsec = len(sections)
  let cursor = prSizeofHeader() + nsec * prSizeofSection()

  let dataOff = []int(0)
  let i = 0
  while (i < nsec) {
    if (sections[i].hasFileData) {
      dataOff = append(dataOff, cursor)
      cursor = cursor + sections[i].size
    } else {
      dataOff = append(dataOff, 0)
    }
    i = i + 1
  }

  let relocOff = []int(0)
  let relocCount = []int(0)
  i = 0
  while (i < nsec) {
    let cnt = 0
    let r = 0
    while (r < len(relocs)) {
      if (relocs[r].sectionIdx == i) {
        cnt = cnt + 1
      }
      r = r + 1
    }
    relocCount = append(relocCount, cnt)
    if (cnt > 0) {
      relocOff = append(relocOff, cursor)
      cursor = cursor + cnt * prSizeofReloc()
    } else {
      relocOff = append(relocOff, 0)
    }
    i = i + 1
  }

  return PrFixLayout{
    dataOff = dataOff,
    relocOff = relocOff,
    relocCount = relocCount,
    symtabOff = cursor,
  }
}

// prFixEmitHeaderAndSections writes the fixed-size COFF file header and the
// section table, both of which are complete once `layout` is known.
fn prFixEmitHeaderAndSections(
  nsec: int,
  symbolCount: int,
  sections: []PrFixSection,
  layout: PrFixLayout,
): []u8 {
  let out = []u8(0)
  out = prPutU16(out, 0x8664)
  out = prPutU16(out, nsec)
  out = prPutU32(out, 0) // TimeDateStamp
  out = prPutU32(out, layout.symtabOff)
  out = prPutU32(out, symbolCount)
  out = prPutU16(out, 0) // SizeOfOptionalHeader
  out = prPutU16(out, 0) // Characteristics

  let i = 0
  while (i < nsec) {
    let sec = sections[i]
    out = prPutName8(out, sec.name)
    out = prPutU32(out, 0) // VirtualSize
    out = prPutU32(out, 0) // VirtualAddress
    out = prPutU32(out, sec.size)
    out = prPutU32(out, layout.dataOff[i])
    out = prPutU32(out, layout.relocOff[i])
    out = prPutU32(out, 0) // PointerToLinenumbers
    out = prPutU16(out, layout.relocCount[i])
    out = prPutU16(out, 0) // NumberOfLinenumbers
    out = prPutU32(out, sec.chars)
    i = i + 1
  }
  return out
}

// prFixEmitSymbolsAndStrings appends the raw symbol-table slots (primary
// entries and their aux records) followed by the string table those entries'
// long names point into, since a name's offset into `strs` is only known
// once every prior symbol has been emitted.
fn prFixEmitSymbolsAndStrings(out: []u8, symbols: []PrFixSymbolRaw): []u8 {
  let strs = []u8(0)
  let i = 0
  while (i < len(symbols)) {
    let sm = symbols[i]
    if (sm.isAux) {
      out = prPutU32(out, sm.auxScnLen)
      out = prPutU16(out, sm.auxNReloc)
      out = prPutU16(out, 0)   // NumberOfLinenumbers
      out = prPutU32(out, 0)   // CheckSum
      out = prPutU16(out, 0)   // Number
      out = append(out, u8(0)) // Selection
      out = append(out, u8(0))
      out = append(out, u8(0))
      out = append(out, u8(0)) // 3 bytes unused padding
    } else {
      let nb = []byte(sm.name)
      if (len(nb) <= 8) {
        out = prPutName8(out, sm.name)
      } else {
        out = prPutU32(out, 0)
        out = prPutU32(out, 4 + len(strs))
        let k = 0
        while (k < len(nb)) {
          strs = append(strs, nb[k])
          k = k + 1
        }
        strs = append(strs, u8(0))
      }
      out = prPutU32(out, sm.value)
      out = prPutI16(out, sm.section)
      out = prPutU16(out, 0) // Type
      out = append(out, u8(sm.storageClass))
      out = append(out, u8(sm.naux))
    }
    i = i + 1
  }

  out = prPutU32(out, 4 + len(strs))
  let j = 0
  while (j < len(strs)) {
    out = append(out, strs[j])
    j = j + 1
  }
  return out
}

fn prFixBuild(
  sections: []PrFixSection,
  symbols: []PrFixSymbolRaw,
  relocs: []PrFixReloc,
): PrFixBuilt {
  let nsec = len(sections)
  let layout = prFixComputeLayout(sections, relocs)
  let dataOff = layout.dataOff
  let relocOff = layout.relocOff
  let relocCount = layout.relocCount

  let out = prFixEmitHeaderAndSections(nsec, len(symbols), sections, layout)

  let i = 0
  while (i < nsec) {
    if (sections[i].hasFileData) {
      let d = sections[i].data
      let j = 0
      while (j < len(d)) {
        out = append(out, d[j])
        j = j + 1
      }
    }
    i = i + 1
  }

  i = 0
  while (i < nsec) {
    let r = 0
    while (r < len(relocs)) {
      if (relocs[r].sectionIdx == i) {
        out = prPutU32(out, relocs[r].offset)
        out = prPutU32(out, relocs[r].symRawIndex)
        out = prPutU16(out, relocs[r].rtype)
      }
      r = r + 1
    }
    i = i + 1
  }

  out = prFixEmitSymbolsAndStrings(out, symbols)

  return PrFixBuilt{ bytes = out, dataOff = dataOff, relocOff = relocOff, relocCount = relocCount }
}

fn prErr(b: []u8): string {
  let msg = ""
  readCoffObject("t.o", b) catch e {
    msg = e.message()
    LoModule{ name = "", atoms = []LoAtom(0) }
  }
  return msg
}

fn prAtomNamed(m: LoModule, name: string): int {
  let i = 0
  while (i < len(m.atoms)) {
    if (m.atoms[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

