// Split out of emit.bit (#1503): the Mach-O object writer — emitMachoObject and
// its Mach-O-only naming and relocation helpers. The shared blob/global
// placement helpers stay in emit.bit.
//
// Layout decisions worth stating, because they are not arbitrary:
//   __text   every function's machine code, plus the _bit_main trampoline.
//   __const  string bytes, ptr_offsets arrays, type-name strings — read-only.
//   __data   everything holding an ABSOLUTE pointer: the string {ptr,len}
//            headers, the TypeInfo blobs, the method tables, the stack-map
//            table. Under macOS's PIE model dyld only rebases a pointer that
//            lives in a WRITABLE segment; in __const it would keep its unslid
//            link-time value — a wild pointer into the unmapped pre-slide image.
//
// Every symbol is `_`-prefixed: the Mach-O C ABI mangling the runtime's own
// exports use.
//

// The Mach-O C ABI's leading underscore.
fn emMac(name: string): string {
  return "_" + name
}

// The Mach-O-spelled names this module legitimately leaves undefined for dyld
// to bind — its §11.7 `extern function` declarations. Mirrors the seed's
// emit.externImportNames.
//
// The linker cannot derive this set itself: an `extern function` and a symbol
// the compiler simply misspelled are emitted identically (both are just an
// undefined external), so the declaration has to be carried across the object
// boundary out of band. Without it the Mach-O linker has no way to tell a legal
// dylib import from #1428's `_idg`.
fn machoImportNames(module: IrModule): []string {
  let out = []string(0)
  for n of module.externNames {
    out = append(out, emMac(n))
  }
  return out
}

fn emitMachoObject(module: IrModule, withEntry: bool, freestanding: bool, debug: bool): []u8! {
  let code = newByteBuf()
  let rodata = newByteBuf()
  let data = newByteBuf()
  let gc = newByteBuf()
  let dbg = newByteBuf()
  let symbols = []MachoSymbol(0)
  let relocs = []MachoRelocation(0)
  let defined = map<string, bool>{}
  let stackmaps = []FuncStackMap(0)
  let debugLines = []FuncDebugLines(0)
  let emittedNames = []string(0)
  assignIfaceCaches(module)
  if (freestanding) {
    refuseManagedMetadata(module)?
    refuseUnpinnedImports(module)?
    refuseImportedGlobalRefs(module)?
  }
  refuseThreadLocalStorage(module, "Mach-O")?

  emMachoRefuseSyscalls(module, freestanding)?
  let out = EmMachoDbgLines{
    symbols = symbols, relocs = relocs, defined = defined,
    stackmaps = stackmaps, debugLines = debugLines, emittedNames = emittedNames,
    mainVoid = false, haveMain = false,
  }
  out = emMachoFuncsToText(module, freestanding, debug, code, out)
  let acc = out
  if (withEntry) {
    acc = emMachoAddEntry(code, out, acc)?
  }
  let dbgFileSyms = internDebugFiles(module, out.debugLines)
  let dbgNameSyms = internDebugNames(module, out.debugLines, out.emittedNames)
  acc = emMachoStringPool(module, rodata, data, freestanding, acc)
  acc = emMachoTypeInfos(module, rodata, data, freestanding, acc)
  acc = emMachoStackMaps(gc, out, acc)
  acc = emitMachoDebugLines(dbg, acc, dbgFileSyms, dbgNameSyms)
  let cellBinding = MachoBinding.Global
  if (definitionIsLocal(freestanding, false)) {
    cellBinding = MachoBinding.Local
  }
  let bssSize = emMachoGlobals(module, data, freestanding, cellBinding, acc)?
  acc = emMachoReadonlyGlobals(module, rodata, freestanding, cellBinding, acc)?
  acc = emMachoUndefinedExterns(acc)
  let sections = emMachoMetaSections(code, gc, dbg)
  sections = emMachoReadonlySection(module, rodata, freestanding, sections)
  sections = emMachoWritableSections(module, data, freestanding, bssSize, sections)
  return writeMacho(
    MachoTarget.Aarch64,
    MachoObject{ sections = sections, symbols = acc.symbols, relocations = acc.relocs },
  )?
}

// Reuse the debug result across phases so the split adds no result allocations.
class EmMachoDbgLines {
  symbols: []MachoSymbol,
  relocs: []MachoRelocation,
  defined: map<string, bool>,
  stackmaps: []FuncStackMap,
  debugLines: []FuncDebugLines,
  emittedNames: []string,
  mainVoid: bool,
  haveMain: bool,
}

// Debug-info line table entries (runtime/ABI.md §4.2, #3283/#3662) ->
// __DATA,__bit_dbg. A second, independent side table, same
// per-member/per-function-local-atom shape as the GcMeta block in
// emitMachoObject (see writeDebugLines' own comment) — never merged with it.
// A function with zero rows (emDebugLinesOf, no source-mapped instruction at
// all) contributes no entry, so dbgResult.funcIndices is not 1:1 with
// emittedNames by position; look the owner up through it.
fn emitMachoDebugLines(
  dbg: ByteBuf, acc: EmMachoDbgLines,
  dbgFileSyms: map<int, int>, dbgNameSyms: map<int, int>,
): EmMachoDbgLines {
  let debugLines = acc.debugLines
  let emittedNames = acc.emittedNames
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  let dbgResult = writeDebugLines(dbg, debugLines)
  let dbi = 0
  while (dbi < len(dbgResult.relocOffsets)) {
    let dbOff = dbgResult.relocOffsets[dbi]
    let dbEnd = len(dbg.bytes)
    if (dbi + 1 < len(dbgResult.relocOffsets)) {
      dbEnd = dbgResult.relocOffsets[dbi + 1]
    }
    let dbName = emMac("__bitdbg_${dbi}")
    symbols = append(
      symbols,
      MachoSymbol{
        name = dbName, hasSection = true,
        section = MachoSectionKind.DbgMeta, offset = dbOff, size = dbEnd - dbOff,
        binding = MachoBinding.Local,
      },
    )
    defined[dbName] = true
    let owner = dbgResult.funcIndices[dbi]
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.DbgMeta,
        offset = dbOff, symbol = emMac(emittedNames[owner]),
        kind = MachoRelocKind.Unsigned64,
      },
    )
    // #3662: name_hdr_ptr sits right after the header's original 16 bytes
    // (code_addr/format_version/code_size/num_rows) — one per ENTRY, not one
    // per row — see writeDebugLines.
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.DbgMeta,
        offset = dbOff + 16, symbol = "___bitstr_${dbgNameSyms[owner]}",
        kind = MachoRelocKind.Unsigned64,
      },
    )
    // Each row's file_hdr_ptr sits at (24-byte header) + rowIndex*(16-byte
    // row) + 4 (past that row's own pcOffset field) — see writeDebugLines.
    let rows = debugLines[owner].rows
    let ri = 0
    while (ri < len(rows)) {
      relocs = append(
        relocs,
        MachoRelocation{
          section = MachoSectionKind.DbgMeta,
          offset = dbOff + 28 + ri * 16, symbol = "___bitstr_${dbgFileSyms[rows[ri].file]}",
          kind = MachoRelocKind.Unsigned64,
        },
      )
      ri = ri + 1
    }
    dbi = dbi + 1
  }
  acc.symbols = symbols
  acc.relocs = relocs
  acc.defined = defined
  return acc
}

// codegen's Reloc kinds map 1:1 onto the object writer's.
fn emRelocKind(k: RelocKind): MachoRelocKind {
  if (k == RelocKind.Branch) {
    return MachoRelocKind.Branch
  }
  if (k == RelocKind.Page21) {
    return MachoRelocKind.Page21
  }
  assert(k == RelocKind.PageOff12)
  return MachoRelocKind.Pageoff12
}

// One Unsigned64 per global fixup placed in `buf`, which is section `sec`'s
// blob. No addend field on this writer, so the addend is baked into the image.
// #5990: a `__data` cell's fixup is rebased by dyld exactly as a string
// header's `ptr` is; a `__const` one is not rebased at all under PIE.
fn machoFixups(
  buf: ByteBuf,
  fixups: []GlobalFixup,
  sec: MachoSectionKind,
  relocs: []MachoRelocation,
): []MachoRelocation {
  for f of fixups {
    patchU64Le(buf.bytes, f.offset, f.addend)
    relocs = append(
      relocs,
      MachoRelocation{
        section = sec,
        offset = f.offset, symbol = emMac(f.symbol), kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  return relocs
}
