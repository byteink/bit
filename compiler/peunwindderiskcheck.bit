// Self-host (#3345, epic #3322): the real machine de-risk payload proving
// peexception.bit's/x64unwind.bit's `.pdata`/`.xdata` pipeline against
// actual Windows (mustafa-desktop-win over SSH), plus the Win64 home-space
// assertion (#3355) it shares fixtures with. Split out of
// peexceptioncheck.bit (docs/development.md's 800-line rule) once #3842's
// `:` -> `=` separator sweep pushed the canonical-formatted file back over
// the ceiling — peexceptioncheck.bit keeps the `.pdata` sort/end-to-end
// link checks (checkPePdataSort/checkPeLinkPdataEndToEnd), this file keeps
// everything downstream of the real-hardware exercise (the `xd`-prefixed
// fixture builders, checkPeLinkUnwindDerisk itself, and the home-space
// assertion helpers it calls). Sibling .bit files are the same module, so
// `selfcheck()` still calls checkPeLinkUnwindDerisk directly. Named to sort
// bytewise after "peexceptioncheck.bit".

// ---------------------------------------------------------------------------
// #3345: the real de-risk payload — a 4-function chain (_start -> funcA ->
// funcB -> funcC), with `funcB`'s frame large enough to trigger #3327's
// stack probe, that calls RtlCaptureStackBackTrace from inside funcC and
// writes the captured return addresses to stdout. Run on mustafa-desktop-win
// over SSH (checkPeLinkDerisk's own header comment explains why: no linker
// on the test box at all). funcC's body was independently verified with
// `clang -target x86_64-apple-macos -c` + objdump (transcript in the
// task-3345 report) — the SAME discipline #3329's own de-risk payload used.
//
// Every prologue/epilogue byte below is xEmitPrologue/xEmitEpilogue's REAL
// output for the given XFrame, not a parallel description — this is the
// same claim x64unwind.bit's module comment makes about the unwind CODES,
// extended here to the harness that proves it against a real OS.
// ---------------------------------------------------------------------------

fn xdEmitRaw(buf: X64Buf, bytes: []u8) {
  let i = 0
  while (i < len(bytes)) {
    xEmitByte(buf, int(bytes[i]))
    i = i + 1
  }
}

// `call <symbol>` with the COFF REL-style addend (-4) already baked into the
// field, matching checkPeLinkPc32Addend's own convention — NOT xCallReloc's
// (codegen.bit), which bakes a zero placeholder for a later format-specific
// translation step that does not exist for PE yet (no `bit build --target
// x86_64-windows` driver wires FuncCode into a PeObject today).
fn xdCallRel32(buf: X64Buf, relocs: []PeRelocation, symbol: string): []PeRelocation {
  xEmitByte(buf, 0xE8)
  let off = len(buf.code)
  xEmitByte(buf, 0xFC)
  xEmitByte(buf, 0xFF)
  xEmitByte(buf, 0xFF)
  xEmitByte(buf, 0xFF)
  // bit:lint allow E0214 -- xdCallRel32 is unexported; every caller (xdEmitFuncCBody, xdReproBody, xdBuildRepro in this file and pecallcheck.bit) seeds relocs fresh from []PeRelocation(0) and immediately reassigns it from this call's return value, never holding a pre-call copy
  return append(
    relocs,
    PeRelocation{
      section = PeSectionKind.Text, offset = off,
      symbol = symbol, kind = PeRelocKind.Rel32,
    },
  )
}

// funcC's body, independently verified (module comment above): sets up
// RtlCaptureStackBackTrace(0, 10, buf, NULL) with `buf` at rbp-96 (inside
// funcC's own carved frame — see the XFrame passed to xEmitPrologue at the
// call site), converts the USHORT frame count to a byte length, then
// WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), buf, count*8, &written, NULL),
// then ExitProcess(0).
//
// #3355: every call FIRST reserves Win64's 32-byte home space (48 for
// WriteFile, whose 5th argument then goes at [rsp+0x20]). The callee may spill
// its four register arguments into those bytes, so without the reservation
// they land on the CALLER's own frame — measured on real hardware, not
// reasoned about: a canary at [rbp-8] under a 32-byte frame is argument 4's
// home slot, and WriteFile overwrote it with the pointer in r9 on every run.
// This body escaped only because `buf` at [rbp-0x60] began one byte past the
// clobbered range; the reservation is what makes that a guarantee rather than
// an accident.
//
// Reloc offsets are now COMPUTED from the emitted position instead of
// hand-counted — 3c24501b already fixed one silent miscompile in this same
// harness caused by a stale offset, and inserting the reservations moves every
// one of them.
fn xdEmitFuncCBody(cx: XCtx): []PeRelocation {
  let relocs = []PeRelocation(0)
  xdEmitRaw(cx.buf, [u8(0x31), u8(0xc9)])                               // xor ecx,ecx
  xdEmitRaw(cx.buf, [u8(0xba), u8(0x0a), u8(0x00), u8(0x00), u8(0x00)]) // mov edx,10
  xdEmitRaw(cx.buf, [u8(0x4c), u8(0x8d), u8(0x45), u8(0xa0)])           // lea r8,[rbp-0x60]
  xdEmitRaw(cx.buf, [u8(0x45), u8(0x31), u8(0xc9)])                     // xor r9d,r9d
  xRspAddSub(cx.buf, true, 32)
  relocs = xdCallRel32(cx.buf, relocs, "RtlCaptureStackBackTrace")
  xRspAddSub(cx.buf, false, 32)
  xdEmitRaw(cx.buf, [u8(0x0f), u8(0xb7), u8(0xc0)])                     // movzx eax,ax
  xdEmitRaw(cx.buf, [u8(0xc1), u8(0xe0), u8(0x03)])                     // shl eax,3
  xdEmitRaw(cx.buf, [u8(0x89), u8(0xc3)])                               // mov ebx,eax
  xdEmitRaw(cx.buf, [u8(0xb9), u8(0xf5), u8(0xff), u8(0xff), u8(0xff)]) // mov ecx,-11
  xRspAddSub(cx.buf, true, 32)
  relocs = xdCallRel32(cx.buf, relocs, "GetStdHandle")
  xRspAddSub(cx.buf, false, 32)
  xdEmitRaw(cx.buf, [u8(0x48), u8(0x89), u8(0xc1)])           // mov rcx,rax
  xdEmitRaw(cx.buf, [u8(0x48), u8(0x8d), u8(0x55), u8(0xa0)]) // lea rdx,[rbp-0x60]
  xdEmitRaw(cx.buf, [u8(0x41), u8(0x89), u8(0xd8)])           // mov r8d,ebx
  xdEmitRaw(cx.buf, [u8(0x4c), u8(0x8d), u8(0x4d), u8(0xf0)]) // lea r9,[rbp-0x10]
  xRspAddSub(cx.buf, true, 48)
  xdEmitRaw(cx.buf, [u8(0x48), u8(0xc7), u8(0x44), u8(0x24), u8(0x20)])
  xEmitU32(cx.buf, 0) // mov qword[rsp+0x20],0
  relocs = xdCallRel32(cx.buf, relocs, "WriteFile")
  xRspAddSub(cx.buf, false, 48)
  xdEmitRaw(cx.buf, [u8(0x31), u8(0xc9)]) // xor ecx,ecx
  xRspAddSub(cx.buf, true, 32)
  relocs = xdCallRel32(cx.buf, relocs, "ExitProcess")
  return relocs
}

// One function's `.pdata`/`.xdata` contribution: the record bytes (addend 0
// for Begin/UnwindInfoAddress, addend = the function's own size for End —
// peexception.bit's module comment), the 3 relocations (targeting the
// function's own symbol and a private `$xdata$<name>` symbol), and the raw
// UNWIND_INFO bytes xEmitPrologue itself built.
class XdUnwindPiece {
  pdataRec: []u8,
  pdataRelocs: []PeRelocation, // offsets relative to the FUNCTION's OWN pdata record; caller rebases
  xdataBytes: []u8,
}

fn xdUnwindPiece(name: string, fnSize: int, info: XUnwindInfo): XdUnwindPiece {
  let rec = []u8(12)
  rec[4] = u8(fnSize & 255)
  rec[5] = u8((fnSize >> 8) & 255)
  rec[6] = u8((fnSize >> 16) & 255)
  rec[7] = u8((fnSize >> 24) & 255)
  let relocs = [
    PeRelocation{
      section = PeSectionKind.Pdata,
      offset = 0,
      symbol = name,
      kind = PeRelocKind.AddrRva32,
    },
    PeRelocation{
      section = PeSectionKind.Pdata,
      offset = 4,
      symbol = name,
      kind = PeRelocKind.AddrRva32,
    },
    PeRelocation{
      section = PeSectionKind.Pdata,
      offset = 8,
      symbol = "\$xdata\$" + name,
      kind = PeRelocKind.AddrRva32,
    },
  ]
  return XdUnwindPiece{ pdataRec = rec, pdataRelocs = relocs, xdataBytes = info.bytes }
}

// One of the four synthetic PE functions checkPeLinkUnwindDerisk assembles to
// exercise the linker's unwind-info path. One allocation per synthetic
// function built — 4 per derisk run, whether that is the one golden case
// that calls checkPeLinkUnwindDerisk or a hand run under
// BIT_PE_UNWIND_DERISK_OUT — never per instruction emitted.
class PdFuncBuild {
  bytes: []u8,
  size: int,
  u: XUnwindInfo,
  relocs: []PeRelocation,
}

fn pdBuildStartFunc(): PdFuncBuild {
  // _start: minimal prologue, calls funcA.
  let cxStart = newXCtx(XCallConv.Win64)
  cxStart.frame = XFrame{
    savedGpr = []XReg64(0),
    savedXmm = []XmmReg(0),
    numSpillSlots = 0,
    frameSize = 32,
  }
  let uStart = xEmitPrologue(cxStart)
  let relocs = xdCallRel32(cxStart.buf, []PeRelocation(0), "funcA")
  xEmitEpilogue(cxStart)
  xRet(cxStart.buf)
  let bytes = cxStart.buf.code
  return PdFuncBuild{ bytes = bytes, size = len(bytes), u = uStart, relocs = relocs }
}

fn pdBuildFuncA(): PdFuncBuild {
  // funcA: two callee-saved GPRs, a real (small) frame, calls funcB.
  let cxA = newXCtx(XCallConv.Win64)
  cxA.frame = XFrame{
    savedGpr = [XReg64.Rbx, XReg64.Rsi],
    savedXmm = []XmmReg(0),
    numSpillSlots = 0,
    frameSize = 32,
  }
  let uA = xEmitPrologue(cxA)
  let relocs = xdCallRel32(cxA.buf, []PeRelocation(0), "funcB")
  xEmitEpilogue(cxA)
  xRet(cxA.buf)
  let bytes = cxA.buf.code
  return PdFuncBuild{ bytes = bytes, size = len(bytes), u = uA, relocs = relocs }
}

fn pdBuildFuncB(): PdFuncBuild {
  // funcB: frame over one guard page — #3327's stack probe — calls funcC.
  let cxB = newXCtx(XCallConv.Win64)
  cxB.frame = XFrame{
    savedGpr = []XReg64(0),
    savedXmm = []XmmReg(0),
    numSpillSlots = 0,
    frameSize = 8192,
  }
  let uB = xEmitPrologue(cxB)
  if (envOr("BIT_PE_UNWIND_MUTATE_FUNCB", "") != "") {
    // #3345 acceptance: perturb ONE unwind code and prove the real-hardware
    // backtrace goes wrong.
    //
    // First attempt, RECORDED because the negative result is itself the
    // finding: corrupting the ALLOC_LARGE operand (bytes[6..7], the
    // little-endian scaled-by-8 frame size) did NOT change the captured
    // backtrace on real hardware — a byte-for-byte comparison of the two
    // exes' captured addresses came back identical. RtlCaptureStackBackTrace
    // is invoked from deep inside funcB's body, past its SET_FPREG
    // instruction, so RtlVirtualUnwind uses the RBP chain directly (return
    // address at [rbp+8], caller's saved rbp at [rbp+0]) and never consults
    // the allocation size at all for a body-context capture; that operand
    // only matters mid-prologue/epilogue. So the ALLOC_LARGE operand is
    // real and load-bearing (checkX64WinUnwindInfo already covers it
    // structurally) but is not the field this particular backtrace exercises.
    //
    // The field the RBP-chain shortcut DOES consult is FrameRegister itself
    // (bytes[3]'s low nibble, x64unwind.bit's xPackUnwindInfo header) — the
    // register RtlVirtualUnwind treats as the frame base once PC is past
    // SET_FPREG. Corrupting it from RBP(5) to RCX(1) makes the unwinder walk
    // through whatever garbage RCX holds mid-body instead of the real RBP
    // chain, which is a genuine "wrong or truncated backtrace" mutation for
    // exactly the capture point this harness exercises.
    assert(len(uB.bytes) == 12 && uB.bytes[3] == u8(5))
    uB.bytes[3] = u8(1)
  }
  let relocs = xdCallRel32(cxB.buf, []PeRelocation(0), "funcC")
  xEmitEpilogue(cxB)
  xRet(cxB.buf)
  let bytes = cxB.buf.code
  return PdFuncBuild{ bytes = bytes, size = len(bytes), u = uB, relocs = relocs }
}

fn pdBuildFuncC(): PdFuncBuild {
  // funcC: one saved GPR, a frame holding the capture buffer — no epilogue,
  // it ends in ExitProcess and never returns.
  let cxC = newXCtx(XCallConv.Win64)
  cxC.frame = XFrame{
    savedGpr = [XReg64.Rbx],
    savedXmm = []XmmReg(0),
    numSpillSlots = 0,
    frameSize = 120,
  }
  let uC = xEmitPrologue(cxC)
  let relocs = xdEmitFuncCBody(cxC)
  xdAssertHomeSpace(cxC.buf.code, relocs, true)
  let bytes = cxC.buf.code
  return PdFuncBuild{ bytes = bytes, size = len(bytes), u = uC, relocs = relocs }
}

// The four synthetic functions checkPeLinkUnwindDerisk lays out and links.
// One allocation per derisk run, bundling the four PdFuncBuild results above.
class PdUnwindFuncs {
  start: PdFuncBuild,
  a: PdFuncBuild,
  b: PdFuncBuild,
  c: PdFuncBuild,
}

fn pdBuildUnwindFuncs(): PdUnwindFuncs {
  return PdUnwindFuncs{
    start = pdBuildStartFunc(), a = pdBuildFuncA(), b = pdBuildFuncB(), c = pdBuildFuncC(),
  }
}

// The combined `.text` layout for the four synthetic functions and their
// rebased relocations. One allocation per derisk run.
//
// Every function's relocations start out LOCAL (relative to that function's
// OWN bytes, from xdCallRel32/xdEmitFuncCBody) — PeRelocation offsets are
// SECTION-relative, though, so each list gets rebased by its function's
// now-known position in the combined `text` below via xdRebaseRelocs. _start
// sits at offset 0, so its own rebase is a no-op; every other function's is
// not (an earlier draft skipped this and got a real, reproduced failure —
// see the task-3345 report).
// One allocation per derisk run, like the three classes around it.
class PdTextLayout {
  text: []u8,
  aOff: int,
  bOff: int,
  cOff: int,
  relocs: []PeRelocation,
}

fn pdBuildTextLayout(funcs: PdUnwindFuncs): PdTextLayout {
  let text = xdAppendAllR([]u8(0), funcs.start.bytes)
  let aOff = len(text)
  text = xdAppendAllR(text, funcs.a.bytes)
  let bOff = len(text)
  text = xdAppendAllR(text, funcs.b.bytes)
  let cOff = len(text)
  text = xdAppendAllR(text, funcs.c.bytes)

  let relocs = xdRebaseRelocs(funcs.start.relocs, 0)
  relocs = xdMergeRebased(relocs, funcs.a.relocs, aOff)
  relocs = xdMergeRebased(relocs, funcs.b.relocs, bOff)
  relocs = xdMergeRebased(relocs, funcs.c.relocs, cOff)

  return PdTextLayout{ text = text, aOff = aOff, bOff = bOff, cOff = cOff, relocs = relocs }
}

// The combined `.xdata`/`.pdata` streams for the four synthetic functions,
// each function's per-piece symbol offset, and `relocs` extended with the
// pdata-record relocations. One allocation per derisk run.
class PdUnwindTables {
  xdata: []u8,
  pdata: []u8,
  relocs: []PeRelocation,
  xdataSymOff: map<string, int>,
  pdataSymOff: map<string, int>,
}

fn pdBuildUnwindTables(funcs: PdUnwindFuncs, layout: PdTextLayout): PdUnwindTables {
  let pieces = [
    xdUnwindPiece("_start", funcs.start.size, funcs.start.u),
    xdUnwindPiece("funcA", funcs.a.size, funcs.a.u),
    xdUnwindPiece("funcB", funcs.b.size, funcs.b.u), xdUnwindPiece(
      "funcC",
      funcs.c.size,
      funcs.c.u,
    ),
  ]
  let names = ["_start", "funcA", "funcB", "funcC"]
  let xdata = []u8(0)
  let pdata = []u8(0)
  let xdataSymOff = map<string, int>{}
  let pdataSymOff = map<string, int>{}
  let relocs = layout.relocs
  let pi = 0
  while (pi < len(pieces)) {
    let p = pieces[pi]
    xdataSymOff[names[pi]] = len(xdata)
    xdata = xdAppendAllR(xdata, p.xdataBytes)
    let precOff = len(pdata)
    pdataSymOff[names[pi]] = precOff
    pdata = xdAppendAllR(pdata, p.pdataRec)
    let pj = 0
    while (pj < len(p.pdataRelocs)) {
      let r = p.pdataRelocs[pj]
      relocs = append(
        relocs,
        PeRelocation{
          section = r.section, offset = precOff + r.offset,
          symbol = r.symbol, kind = r.kind,
        },
      )
      pj = pj + 1
    }
    pi = pi + 1
  }
  return PdUnwindTables{
    xdata = xdata, pdata = pdata, relocs = relocs, xdataSymOff = xdataSymOff,
    pdataSymOff = pdataSymOff,
  }
}

// The four function symbols (_start/funcA/funcB/funcC), each `hasSection` in
// `.text` at its layout offset.
fn pdBuildSymbolsCode(funcs: PdUnwindFuncs, layout: PdTextLayout): []PeSymbol {
  return [
    PeSymbol{
      name = "_start",
      hasSection = true,
      section = PeSectionKind.Text,
      offset = 0,
      size = funcs.start.size,
      binding = PeBinding.Global,
      kind = PeSymKind.Func,
    },
    PeSymbol{
      name = "funcA",
      hasSection = true,
      section = PeSectionKind.Text,
      offset = layout.aOff,
      size = funcs.a.size,
      binding = PeBinding.Global,
      kind = PeSymKind.Func,
    },
    PeSymbol{
      name = "funcB",
      hasSection = true,
      section = PeSectionKind.Text,
      offset = layout.bOff,
      size = funcs.b.size,
      binding = PeBinding.Global,
      kind = PeSymKind.Func,
    },
    PeSymbol{
      name = "funcC",
      hasSection = true,
      section = PeSectionKind.Text,
      offset = layout.cOff,
      size = funcs.c.size,
      binding = PeBinding.Global,
      kind = PeSymKind.Func,
    },
  ]
}

// The local `$xdata$<fn>` symbols, one per synthetic function's unwind-info
// bytes in `.xdata`.
fn pdBuildSymbolsXdata(funcs: PdUnwindFuncs, tables: PdUnwindTables): []PeSymbol {
  return [
    PeSymbol{
      name = "\$xdata\$_start",
      hasSection = true,
      section = PeSectionKind.Xdata,
      offset = tables.xdataSymOff["_start"],
      size = len(funcs.start.u.bytes),
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "\$xdata\$funcA",
      hasSection = true,
      section = PeSectionKind.Xdata,
      offset = tables.xdataSymOff["funcA"],
      size = len(funcs.a.u.bytes),
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "\$xdata\$funcB",
      hasSection = true,
      section = PeSectionKind.Xdata,
      offset = tables.xdataSymOff["funcB"],
      size = len(funcs.b.u.bytes),
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "\$xdata\$funcC",
      hasSection = true,
      section = PeSectionKind.Xdata,
      offset = tables.xdataSymOff["funcC"],
      size = len(funcs.c.u.bytes),
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
  ]
}

// The local `$pdata$<fn>` symbols, one per synthetic function's RUNTIME_FUNCTION
// record in `.pdata` (each record is `sizeofPePdataEntry()` == 12 bytes).
fn pdBuildSymbolsPdata(tables: PdUnwindTables): []PeSymbol {
  return [
    PeSymbol{
      name = "\$pdata\$_start",
      hasSection = true,
      section = PeSectionKind.Pdata,
      offset = tables.pdataSymOff["_start"],
      size = 12,
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "\$pdata\$funcA",
      hasSection = true,
      section = PeSectionKind.Pdata,
      offset = tables.pdataSymOff["funcA"],
      size = 12,
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "\$pdata\$funcB",
      hasSection = true,
      section = PeSectionKind.Pdata,
      offset = tables.pdataSymOff["funcB"],
      size = 12,
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "\$pdata\$funcC",
      hasSection = true,
      section = PeSectionKind.Pdata,
      offset = tables.pdataSymOff["funcC"],
      size = 12,
      binding = PeBinding.Local,
      kind = PeSymKind.Notype,
    },
  ]
}

// The four imports `checkPeLinkUnwindDerisk`'s allowed-import list lets the
// linker leave undefined (RtlCaptureStackBackTrace, plus the stdio/exit set
// funcC's body actually calls).
fn pdBuildSymbolsImports(): []PeSymbol {
  return [
    PeSymbol{
      name = "RtlCaptureStackBackTrace",
      hasSection = false,
      section = PeSectionKind.Text,
      offset = 0,
      size = 0,
      binding = PeBinding.Global,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "GetStdHandle",
      hasSection = false,
      section = PeSectionKind.Text,
      offset = 0,
      size = 0,
      binding = PeBinding.Global,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "WriteFile",
      hasSection = false,
      section = PeSectionKind.Text,
      offset = 0,
      size = 0,
      binding = PeBinding.Global,
      kind = PeSymKind.Notype,
    },
    PeSymbol{
      name = "ExitProcess",
      hasSection = false,
      section = PeSectionKind.Text,
      offset = 0,
      size = 0,
      binding = PeBinding.Global,
      kind = PeSymKind.Notype,
    },
  ]
}

fn pdBuildSymbols(funcs: PdUnwindFuncs, layout: PdTextLayout, tables: PdUnwindTables): []PeSymbol {
  let out = pdBuildSymbolsCode(funcs, layout)
  for x of pdBuildSymbolsXdata(funcs, tables) {
    out = append(out, x)
  }
  for x of pdBuildSymbolsPdata(tables) {
    out = append(out, x)
  }
  for x of pdBuildSymbolsImports() {
    out = append(out, x)
  }
  return out
}

fn checkPeLinkUnwindDerisk() {
  let funcs = pdBuildUnwindFuncs()
  let layout = pdBuildTextLayout(funcs)
  let tables = pdBuildUnwindTables(funcs, layout)
  let symbols = pdBuildSymbols(funcs, layout, tables)

  let bytes = plWriteProbe(
    [
      PeSection{ kind = PeSectionKind.Text, data = layout.text, size = 0, alignment = 16 },
      PeSection{ kind = PeSectionKind.Pdata, data = tables.pdata, size = 0, alignment = 4 },
      PeSection{ kind = PeSectionKind.Xdata, data = tables.xdata, size = 0, alignment = 4 },
    ],
    symbols, tables.relocs,
  )

  let allowed = ["RtlCaptureStackBackTrace", "GetStdHandle", "WriteFile", "ExitProcess"]
  let exe = linkPe([plObjectInput(bytes)], allowed) catch _ {
    []u8(0)
  }
  assert(len(exe) > 0)

  let optOff = plLfanew() + 4 + sizeofPeFileHeader()
  let dirsOff = optOff + plOptionalHeaderSize() - 16 * 8
  let exceptionSize = leAt(exe, dirsOff + 3 * 8 + 4, 4)
  assert(exceptionSize == 4 * sizeofPePdataEntry()) // all 4 functions survive

  let outPath = envOr("BIT_PE_UNWIND_DERISK_OUT", "")
  if (outPath != "") {
    writeFile(outPath, string(exe)) catch _ {}
  }
}

// Concatenates a whole `[]u8` — `append` only appends single elements
// (ppdScenario's caller does this inline; factored out here since
// checkPeLinkUnwindDerisk needs it repeatedly). MUST be used as `x =
// xdAppendAllR(x, ...)`: like every other slice-returning helper in this
// file, growing happens by return value, not by mutating `dst` in place.
fn xdAppendAllR(dst: []u8, src: []u8): []u8 {
  let i = 0
  while (i < len(src)) {
    dst = append(dst, src[i])
    i = i + 1
  }
  return dst
}

// Rebases a function's LOCAL (atom-relative) Text relocations to
// SECTION-relative ones, now that its position in the combined `text` is
// known. PeRelocation.offset (emitpe.bit) is always section-relative, same
// as a real object's — xdCallRel32/xdEmitFuncCBody deliberately return
// local offsets so each function can be built in isolation, but skipping
// this step corrupts whatever bytes happen to sit at the (wrong) unrebased
// offset in the FINAL section, silently: it is not a malformed relocation,
// just one that patches the wrong field. That is exactly what happened
// building this check the first time — see the task-3345 report.
fn xdRebaseRelocs(relocs: []PeRelocation, base: int): []PeRelocation {
  let out = []PeRelocation(0)
  let i = 0
  while (i < len(relocs)) {
    let r = relocs[i]
    out = append(
      out,
      PeRelocation{
        section = r.section, offset = r.offset + base,
        symbol = r.symbol, kind = r.kind,
      },
    )
    i = i + 1
  }
  return out
}

fn xdMergeRebased(dst: []PeRelocation, src: []PeRelocation, base: int): []PeRelocation {
  let rebased = xdRebaseRelocs(src, base)
  let i = 0
  while (i < len(rebased)) {
    dst = append(dst, rebased[i])
    i = i + 1
  }
  return dst
}

// Mutation-tested manually (#3345), two ways:
// 1. peexception.bit's ppSortEntries comparison (`>` -> `<`, descending
//    instead of ascending) — `bit selfcheck` failed (exit 2). checkPePdataSort
//    is what actually caught it (a pure unit test on a deliberately scrambled
//    input); THIS check's own `assert(beginRva > prevBegin)` never got the
//    chance to, because ppdScenario's records happen to already come out in
//    address order for THIS particular sort bug — the two checks are
//    complementary, not redundant, and this is why both exist.
// 2. peexception.bit's ppResolveEntries: changed `if (textAlive)` to
//    `if (true)`, i.e. stopped excluding a dead-stripped function's record.
//    `bit selfcheck` failed (exit 2) — deadFunc's own `assert(hasBegin)`
//    fires immediately, since a stripped function's atom is never placed and
//    so never has an RVA. Both mutations reverted; `bit selfcheck` is green
//    again (exit 0, "selfcheck OK") — verified by rebuilding each time, not
//    by reasoning about the change.

// ---------------------------------------------------------------------------
// #3355: Win64's home-space obligation, asserted on the emitted bytes.
// ---------------------------------------------------------------------------

// Whether the `call` whose opcode byte sits at `callOff` reserved home space
// first. Matches the reservation EXACTLY — `sub rsp, imm32` (48 81 EC, imm >=
// 32) immediately before the call, or immediately before the optional 9-byte
// 5th-argument store `mov qword [rsp+0x20], 0`.
//
// Deliberately not a backward SCAN over a window: the first draft was, and it
// reported home space for calls that had none, because xEmitPrologue's own
// frame-carving `sub rsp, 32` is the same seven bytes and sat within the
// window. A pattern that cannot tell the two apart makes this check pass on
// exactly the code it exists to reject.
//
// 32 is the whole invariant: with rsp lowered by at least that much, the
// [rsp, rsp+32) a callee may spill its four register arguments into lies BELOW
// every byte of the caller's carved frame, so no rbp-relative local can be in
// it whatever its offset. Without it, that window IS the frame's top 32 bytes.
fn xdIsRspSub32(code: []u8, at: int): bool {
  if (at < 0 || at + 7 > len(code)) {
    return false
  }
  if (int(code[at]) != 0x48 || int(code[at + 1]) != 0x81 || int(code[at + 2]) != 0xEC) {
    return false
  }
  let imm = int(code[at + 3]) |
    (int(code[at + 4]) << 8) |
    (int(code[at + 5]) << 16) |
    (int(code[at + 6]) << 24)
  return imm >= 32
}

fn xdIsArg5Store(code: []u8, at: int): bool {
  if (at < 0 || at + 9 > len(code)) {
    return false
  }
  return int(code[at]) == 0x48 &&
    int(code[at + 1]) == 0xC7 &&
    int(code[at + 2]) == 0x44 &&
    int(code[at + 3]) == 0x24 &&
    int(code[at + 4]) == 0x20
}

fn xdHasHomeSpace(code: []u8, callOff: int): bool {
  if (xdIsRspSub32(code, callOff - 7)) {
    return true
  }
  return xdIsArg5Store(code, callOff - 9) && xdIsRspSub32(code, callOff - 16)
}

// Asserts every Rel32 call in `relocs` does (or deliberately does not) reserve
// home space. `relocs` offsets are the rel32 FIELD, so the opcode is one byte
// earlier. The count is asserted non-zero: a scan that matched nothing would
// pass vacuously and prove nothing about the bytes.
fn xdAssertHomeSpace(code: []u8, relocs: []PeRelocation, want: bool) {
  let n = 0
  for r of relocs {
    if (r.section == PeSectionKind.Text && r.kind == PeRelocKind.Rel32) {
      assert(xdHasHomeSpace(code, r.offset - 1) == want)
      n = n + 1
    }
  }
  assert(n > 0)
}
