// Self-host Stage 3 (#1342): ARM64 per-instruction dispatch — compileInst's
// giant op switch, the register-reservation scan for asm/syscall blocks, and
// the small predicates only dispatch needs. Split out of arm64compile.bit
// (#3915, pure move — that file crossed 800 lines adding the hidden-call-
// hazard predicates for frame layout). Sibling .bit file, same module: see
// arm64.bit for the backend overview; arm64compile.bit keeps the top-level
// per-function driver (register allocation, frame layout, emission).

// ===========================================================================
// Instruction dispatch
// ===========================================================================

// Which integer-constant definitions (#1853) an immediate fold consumes
// entirely, indexed by instruction id — an ADD/SUB immediate, a `cmp`/`cmn`
// immediate (#4349), a bitmask AND/ORR/EOR immediate (#3495), a power-of-two
// Mul (#3105) or a power-of-two SDiv/UDiv (#3104). `const_bool` is one of
// them since #4522 (`opIsIntConst`, arm64select.bit), and reaches only the
// `cmp` arm: bool is prim 10, and `numericBinaryOk` (compiler/checkexpr.bit:324)
// admits an arithmetic or bitwise operand only through `vPrimIsInt`
// (compiler/validate.bit:97, `p >= 0 && p <= 7`), so no `Add`/`Sub`/`Mul`/
// `Div`/`BAnd`/`BOr`/`BXor` can ever carry one.
//
// `instrOperands` (opt.bit) is the SAME operand map DCE uses, so a constant
// with any use besides a fold that reads it as an immediate keeps `false` and
// still materializes normally. Which operand each family folds is
// `immFoldConstOperand`'s question, and each of its arms mirrors its own
// emitter, so nothing here can mark skipped a value an emitter reads as a
// register — and every arm names a CONSTANT operand, never the other one
// (`mulDivFoldOperand` returns the operand `Pow2Factor.value` is NOT, and that
// field holds the non-constant multiplicand).
//
// The test is EVERY USE IS A FOLD, not "there is exactly one use" (#4281). The
// old count-of-one rule was not the safety condition, it was a proxy for it,
// and it read false on the commonest shape there is: one literal consumed by
// two different computations. `let k = 5; (n + k) * (m + k)` — a single
// `const_int i64 5` with two `add`-immediate uses — materialized a `mov xN, #5`
// that no emitter ever read AND kept a register alive across the pair, because
// `skip` also drives `arm64DefinesRegister` (arm64branch.bit).
//
// SIX INSTRUCTIONS WHERE FIVE DO, measured by #4667 on plain `main` (4d30a255)
// with objdump, both rules built in one worktree: `add`, `add`, `mul`, `mov`,
// `ret` under this rule, plus a dead `movz xN, #5` under the old one. #4281
// then makes the shape the common one rather than an occasional one, by giving
// two spellings of the same literal one id — `(n + 5) * (m + 5)` is TWO
// `const_int`s without it, one use each, which the old rule already handled.
// `_tests_/bit/constimmfold.bit` is the gate that holds all three counts.
//
// `useCount > 0` is what keeps this a statement about constants: `foldCount` is
// only ever incremented for an operand `immFoldConstOperand` named, so a zero
// count on both sides must not read as "all of its uses fold".
fn computeSkipConstMaterialize(ctx: TypeContext, f: IrFunc, debug: bool): []bool {
  let n = len(f.instrs)
  let useCount = []int(n)
  let foldCount = []int(n)
  let i = 0
  while (i < n) {
    let ops = instrOperands(f, i)
    let k = 0
    while (k < len(ops)) {
      useCount[ops[k]] = useCount[ops[k]] + 1
      k = k + 1
    }
    let c = immFoldConstOperand(ctx, f, f.instrs[i], debug)
    if (c >= 0) {
      foldCount[c] = foldCount[c] + 1
    }
    i = i + 1
  }
  let skip = []bool(n)
  i = 0
  while (i < n) {
    skip[i] = useCount[i] > 0 && foldCount[i] == useCount[i]
    i = i + 1
  }
  return skip
}

// Which operand of `ins`, if any, an immediate fold in the emitters consumes
// ENTIRELY — the one question the whole table above asks, so the
// every-use-is-a-fold rule and the `skip` bookkeeping are written once rather
// than once per op family. Returns that operand's instruction id, or -1.
// (That rule was `useCount == 1` until #4667, which is why the paragraph below
// still names a use count: the hazard it records predates the change and is
// unaffected by it — an emitter folding an operand this function did not name
// is wrong under either rule.)
//
// Splitting the question out this way removed a real hazard, not just five
// copies of a line: the Add arm used to fall through to its LHS whenever the
// RHS test failed, and one of the ways that test failed was a second USE of an
// RHS constant the emitter folds regardless of use count. `emitBinaryInt`
// would then fold the RHS while the LHS sat marked skipped and unmaterialized.
// Each helper below mirrors its emitter's own operand precedence and nothing
// else; the use count is not that emitter's business and is applied once, here.
fn immFoldConstOperand(ctx: TypeContext, f: IrFunc, ins: IrInstr, debug: bool): int {
  let a = addSubFoldOperand(f, ins, debug)
  if (a >= 0) {
    return a
  }
  let c = icmpFoldOperand(f, ins)
  if (c >= 0) {
    return c
  }
  let m = mulDivFoldOperand(ctx, f, ins)
  if (m >= 0) {
    return m
  }
  return bitwiseShiftFoldOperand(f, ins)
}

// Whether `v` is an integer constant that `op`'s add/sub-immediate encoding
// takes whole — the test `emitBinaryInt` itself applies, in the same order.
//
// #4522 widened `constIntOf` to answer for `const_bool` as well, and this is
// the one consumer that could not have reached one anyway: see
// `computeSkipConstMaterialize`'s header for the typing argument. Were a bool
// ever to arrive here it would still be correct, not merely unreachable —
// `constIntValue` gives the same 0/1 the register path would have
// materialized, so the fold computes the same result.
fn addSubImmOperandFits(f: IrFunc, op: Op, v: int): bool {
  let c = constIntOf(f, v)
  return c.known && resolveAddSubImm(op, c.ival).fits
}

// `debug` (#3080/§13.5) is a hard refusal, not a nuance: a debug build's
// `emitBinaryInt` skips the ADD/SUB-immediate fold entirely (no flag-setting
// immediate form exists to trap on), so marking a constant skipped here would
// leave the general path reading an unmaterialized register. Verified live:
// unguarded, `x + 1` under `--debug` emitted `adds x21, x19, x20` with no
// prior write to x20.
fn addSubFoldOperand(f: IrFunc, ins: IrInstr, debug: bool): int {
  if (debug) {
    return -1
  }
  if (ins.op != Op.Add && ins.op != Op.Sub) {
    return -1
  }
  if (addSubImmOperandFits(f, ins.op, ins.rhs)) {
    return ins.rhs
  }
  // Add is commutative so a leading literal folds too; Sub is not
  // (`k - x` != `x - k`), so only its rhs is ever offered.
  if (ins.op != Op.Add) {
    return -1
  }
  if (addSubImmOperandFits(f, ins.op, ins.lhs)) {
    return ins.lhs
  }
  return -1
}

// #4349: `emitIcmp` folds a constant rhs into `cmp`/`cmn` whenever
// `icmpConstImm` says it fits, and fetches no register for it on that path.
// Unlike the ADD/SUB arm this needs no `debug` guard — a comparison traps on
// nothing, so `compileInst` reaches the same `emitIcmp` in every build mode.
fn icmpFoldOperand(f: IrFunc, ins: IrInstr): int {
  if (isIcmp(ins.op) && icmpConstImm(f, ins.rhs).fits) {
    return ins.rhs
  }
  return -1
}

// All four div ops are offered, not just SDiv/UDiv: since #4361 `emitDivInt`
// takes a register-free path for every one of them when the divisor reduces
// (`emitPow2RemInt` masks rather than recovering the remainder with `msub`,
// which is what needed the divisor register under #3104). This now matches
// `xComputeSkipConstMaterialize`, which has always offered all four — so since
// #4674 `xImmFoldConstOperand` (x64dispatch.bit) CALLS THIS ONE, the same call
// `xUsedIntRegs` already makes on `arm64WritesResult`. It is shared only while
// BOTH emitters read no register on the same plans: `factor.k >= 0` for Mul,
// and for the four div ops whatever `divPlanReadsDivisor` (divplan.bit) says,
// which since #4389 is the magic-multiply shape as well as the power of two --
// narrowed by #4722 to the two QUOTIENT ops, which this arm did not have to
// learn about either because it asks rather than restates. A
// backend that regains a register read must split this in two before changing
// its emitter, or it silently miscompiles.
//
// `plan.guard == false` alone is NOT enough to skip the materialization: that
// path still emits a real `sdiv`/`udiv` reading the divisor register. Which
// plans stop reading it is `divPlanReadsDivisor`'s question (divplan.bit) and
// is asked, not restated -- #4389 added a second such shape and this arm did
// not have to learn about it.
//
// Mul's debug overflow trap (#3084, arm64selectovf.bit) does read `cx.debug`,
// but never re-reads the skipped operand: `emitPow2MulInt`'s check only touches
// the non-constant operand's register and the compile-time-known shift amount
// `k`, so this stays safe in every build mode. Div reads `cx.debug` nowhere.
fn mulDivFoldOperand(ctx: TypeContext, f: IrFunc, ins: IrInstr): int {
  if (ins.op == Op.Mul) {
    let factor = xConstPow2Factor(f, ins.lhs, ins.rhs, widthOf(ctx, ins.ty))
    if (factor.k < 0) {
      return -1
    }
    if (factor.value == ins.lhs) {
      return ins.rhs
    }
    return ins.lhs
  }
  if (!isDivOp(ins.op)) {
    return -1
  }
  if (divPlanReadsDivisor(xDivisorPlan(f, ins.rhs, widthOf(ctx, ins.ty), ins.op))) {
    return -1
  }
  return ins.rhs
}

// `constShiftAmount` (arm64select.bit) masks any const_int to 0-63, never
// returning -1 for one — the only -1 case is "not a const_int at all" — so this
// answers with exactly the operand `emitShiftInt`'s own `amt >= 0` branch
// takes, and the masked value is always a legal shift-immediate encoding
// regardless of the IR's result width.
fn bitwiseShiftFoldOperand(f: IrFunc, ins: IrInstr): int {
  if (ins.op == Op.BAnd || ins.op == Op.BOr || ins.op == Op.BXor) {
    return logicalConstSkip(f, ins.rhs, ins.lhs)
  }
  if (ins.op != Op.Shl && ins.op != Op.AShr && ins.op != Op.LShr) {
    return -1
  }
  if (constShiftAmount(f, ins.rhs) < 0) {
    return -1
  }
  return ins.rhs
}

// #3101: does `compileInst` write instruction `i`'s own allocated register?
//
// Mirrors the dispatch below, and DEFAULTS TO TRUE so the mirror can only ever
// fail safe: a new op, or one this list forgets, is treated as writing its
// register and is saved as before. Only the reverse — claiming a write does not
// happen when it does — could drop a live callee-saved value, so nothing goes in
// the false list without a `compileInst` arm that provably binds no destination:
//
//   * Jump/Br/Ret/Unreachable/FieldSet/IndexSet/AtomicStore pass no `i` to their
//     emitter at all; they only read operands.
//   * Call/CallValue/CallIface/RtCall/Asm route their destination through
//     `dstOrNone`, which answers -1 for a void result, and `emitCall`/`emitAsm`
//     each guard on that (arm64call.bit's `dst < 0`, emitAsm's `dst >= 0`).
//   * an integer constant (`const_int`, or since #4522 `const_bool`) in
//     `skipConst` is the one arm that materializes nothing;
//     `computeSkipConstMaterialize` above already proves its sole use reads it as
//     an immediate, never as a register, so nothing loads it either. x64 calls
//     this function with its OWN `skipConst`, and `xConstIntOf`
//     (x64select.bit:195) still admits `const_int` alone — so a `const_bool`
//     there is never marked skipped and still answers true here.
//
// block_param is deliberately absent: an edge's parallel move
// (`sequentializeAndEmit` over `blockArgMoves`) writes a param's register on
// every incoming edge, so it is a real definition even though `compileInst`
// never sees one.
fn arm64WritesResult(ctx: TypeContext, f: IrFunc, skipConst: []bool, i: int): bool {
  let ins = f.instrs[i]
  let op = ins.op
  if (op == Op.Jump ||
    op == Op.Br ||
    op == Op.Ret ||
    op == Op.Unreachable ||
    op == Op.FieldSet ||
    op == Op.IndexSet ||
    op == Op.AtomicStore) {
    return false
  }
  if (opIsIntConst(op)) {
    return !skipConst[i]
  }
  if (op == Op.Call ||
    op == Op.CallValue ||
    op == Op.CallIface ||
    op == Op.RtCall ||
    op == Op.Asm) {
    return ins.ty != ctx.voidId
  }
  return true
}

// #4110: `compileInst` was a single complexity-64 dispatch (E0204 limit 10) —
// one flat if-chain covering every arm64 IR op. Split into instruction-family
// helpers below, each trying only the ops in its own family and reporting
// whether it handled `op`; `compileInst` tries each family in turn and
// returns as soon as one claims the op. Every helper reads `op`/`ty` straight
// off `ins` rather than taking them as separate parameters — they are always
// `ins.op`/`ins.ty`, so passing both again would just be restating the same
// value under a second name. Pure grouping — no arm moved to a different
// family, no dispatch order changed, no emitter call rewritten.

// True for the five integer ops `emitBinaryInt` may fold an ADD/SUB-immediate
// or a bitmask AND/ORR/EOR-immediate into (`resolveAddSubImm`/`logicalConstSkip`,
// both above).
fn isIntBinOp(op: Op): bool {
  return op == Op.Add || op == Op.Sub || op == Op.BAnd || op == Op.BOr || op == Op.BXor
}

fn isDivOp(op: Op): bool {
  return op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem
}

fn isShiftOp(op: Op): bool {
  return op == Op.Shl || op == Op.LShr || op == Op.AShr
}

fn isUnaryIntOp(op: Op): bool {
  return op == Op.Neg || op == Op.BNot
}

// FRINTM / FRINTP / FRINTZ / FRINTA — floor, ceil, truncate,
// round-half-away-from-zero.
fn isFRoundOp(op: Op): bool {
  return op == Op.FFloor || op == Op.FCeil || op == Op.FTrunc || op == Op.FRound
}

fn arm64RoundModeForOp(op: Op): int {
  if (op == Op.FFloor) {
    return 10
  }
  if (op == Op.FCeil) {
    return 9
  }
  if (op == Op.FTrunc) {
    return 11
  }
  assert(op == Op.FRound)
  return 12
}

fn compileInstConst(cx: A64Ctx, i: int, ins: IrInstr, iw: Width): bool {
  let op = ins.op
  if (opIsIntConst(op)) {
    if (!cx.skipConst[i]) {
      emitConstInt(cx, i, constIntValue(ins))
    }
    return true
  }
  if (op == Op.ConstNil) {
    emitConstNil(cx, i)
    return true
  }
  if (op == Op.ConstFloat) {
    emitConstFloat(cx, i, ins.fval, iw.bytes)
    return true
  }
  if (op == Op.ConstString) {
    emitConstString(cx, i, ins.ival)
    return true
  }
  return false
}

fn compileInstIntArith(cx: A64Ctx, i: int, ins: IrInstr, iw: Width): bool {
  let op = ins.op
  if (isIntBinOp(op)) {
    emitBinaryInt(cx, op, i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (op == Op.Mul) {
    emitMulInt(cx, i, ins.lhs, ins.rhs, xConstPow2Factor(cx.f, ins.lhs, ins.rhs, iw), iw)
    return true
  }
  // Always 64-bit: `smulh`/`umulh` have no narrower form and the magic divide
  // that mints these (optdivmagic.bit) types them i64/u64 for that reason.
  if (op == Op.SMulHi || op == Op.UMulHi) {
    emitMulHiInt(cx, op, i, ins.lhs, ins.rhs)
    return true
  }
  if (isDivOp(op)) {
    emitDivInt(cx, i, ins.lhs, ins.rhs, xDivisorPlan(cx.f, ins.rhs, iw, op))
    return true
  }
  if (isShiftOp(op)) {
    emitShiftInt(cx, op, i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (isIcmp(op)) {
    emitIcmp(cx, op, i, ins.lhs, ins.rhs)
    return true
  }
  return false
}

fn compileInstFloatArith(cx: A64Ctx, i: int, ins: IrInstr, iw: Width): bool {
  let op = ins.op
  if (op == Op.FAdd) {
    emitBinaryFloat(cx, FArithOp.Add, i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (op == Op.FSub) {
    emitBinaryFloat(cx, FArithOp.Sub, i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (op == Op.FMul) {
    emitBinaryFloat(cx, FArithOp.Mul, i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (op == Op.FDiv) {
    emitBinaryFloat(cx, FArithOp.Div, i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (isFcmp(op)) {
    // A float compare's operand width comes from the OPERANDS — its own result is
    // a bool.
    emitFcmp(cx, op, i, ins.lhs, ins.rhs, widthOf(cx.module.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  return false
}

fn compileInstUnary(cx: A64Ctx, i: int, ins: IrInstr, iw: Width): bool {
  let op = ins.op
  if (isUnaryIntOp(op)) {
    emitUnaryInt(cx, op, i, ins.lhs, iw)
    return true
  }
  if (op == Op.Convert) {
    emitConvert(cx, i, ins.lhs, ins.ty)
    return true
  }
  if (op == Op.FNeg) {
    emitFneg(cx, i, ins.lhs, iw.bytes)
    return true
  }
  if (op == Op.FSqrt) {
    emitFsqrt(cx, i, ins.lhs, iw.bytes)
    return true
  }
  if (isFRoundOp(op)) {
    emitFRound(cx, i, ins.lhs, iw.bytes, arm64RoundModeForOp(op))
    return true
  }
  // The width always comes from the FLOAT side — the integer view of an f32 is
  // 4 bytes wide whichever direction the transfer runs, and only one of the two
  // types carries a float width to read.
  if (op == Op.Bitcast) {
    let dstIsFloat = iw.regClass == RegClass.Float
    let bw = widthOf(cx.module.ctx, cx.f.instrs[ins.lhs].ty).bytes
    if (dstIsFloat) {
      bw = iw.bytes
    }
    emitBitcast(cx, i, ins.lhs, bw, dstIsFloat)
    return true
  }
  return false
}

fn compileInstControl(cx: A64Ctx, curBlock: int, i: int, ins: IrInstr): bool {
  let op = ins.op
  if (op == Op.Jump) {
    emitJumpEdge(cx, curBlock, i, ins.ival, ins.args)
    return true
  }
  if (op == Op.Br) {
    emitBr(cx, curBlock, i, ins)
    return true
  }
  if (op == Op.Ret) {
    // A `ret` of W words lands in the first W ABI return registers, counted per
    // class (retRegsFor). W is not bounded here: retRegsFor owns the budget and
    // asserts it, so the convention has one owner rather than a second copy of
    // the limit that can drift from it.
    //
    // W <= 1 for every function the front end builds today — `return a, b` is
    // boxed into one tuple handle before codegen (lowerfunc.bit's ReturnStmt
    // arm) — so the multi-word arm is capability for #4108's value-form payload
    // enums and is reached by nothing in this tree yet. The W == 1 arm below is
    // byte-for-byte what it always was, deliberately: see emitMultiWordRet.
    if (len(ins.args) == 1) {
      let v = ins.args[0]
      if (regClassOf(cx.module.ctx, cx.f.instrs[v].ty) == RegClass.Int) {
        movRR(cx.code, retRegNum(), getInt(cx, vregOf(cx, v), scratch1()))
      } else {
        fmovFF(cx.code, retRegNum(), getFloat(cx, vregOf(cx, v), fscratch1()), 8)
      }
    } else if (len(ins.args) > 1) {
      emitMultiWordRet(cx, ins.args)
    }
    emitEpilogueAndRet(cx)
    return true
  }
  if (op == Op.Unreachable) {
    emitUdf(cx.code)
    return true
  }
  return false
}

fn compileInstCall(cx: A64Ctx, i: int, ins: IrInstr): bool {
  let op = ins.op
  let ty = ins.ty
  if (op == Op.Call) {
    // #4405: a call whose result is W > 1 words is followed by its
    // `Op.CallWord` run, and every destination is bound in the one parallel
    // move at the call site (#4236 — nothing may be emitted between the `bl`
    // and the last binding).
    let w = callWordRunLen(cx.f, i)
    if (w > 1) {
      emitCallWords(cx, i, ins, w)
      return true
    }
    emitCall(cx, dstOrNone(cx, i, ty), ty, ins.name, ins.args, true)
    return true
  }
  // #4405: word k > 0 was already bound by the call that owns it.
  if (op == Op.CallWord) {
    return true
  }
  if (op == Op.CallValue) {
    emitCallValue(cx, dstOrNone(cx, i, ty), ty, ins.lhs, ins.args)
    return true
  }
  if (op == Op.CallIface) {
    emitCallIface(cx, dstOrNone(cx, i, ty), ty, ins.lhs, ins.ival, ins.args)
    return true
  }
  if (op == Op.RtCall) {
    emitCall(cx, dstOrNone(cx, i, ty), ty, rtSymbol(ins.name), ins.args, true)
    return true
  }
  return false
}

fn compileInstMem(cx: A64Ctx, i: int, ins: IrInstr): bool {
  let op = ins.op
  if (op == Op.GcAlloc) {
    emitGcAlloc(cx, i, ins.ival, ins.offsets)
    return true
  }
  if (op == Op.TypeInfo) {
    emitTypeInfo(cx, i, ins.ival, ins.ival2, ins.offsets)
    return true
  }
  if (op == Op.FieldGet) {
    emitFieldGet(
      cx, i, ins.lhs, ins.ival, ins.ty,
      isHeaderBase(cx.module.ctx, cx.f.instrs[ins.lhs].ty),
    )
    return true
  }
  if (op == Op.FieldSet) {
    // Width comes from `ival2`, the store's OWN recorded type — set once at
    // construction, never re-derived from the value operand's defining
    // instruction (#4396: that read is wrong the moment an optimization
    // aliases the value to something of a different width).
    emitFieldSet(cx, ins.lhs, ins.ival, ins.rhs, ins.ival2)
    return true
  }
  if (op == Op.IndexGet) {
    emitIndexGet(cx, i, ins.lhs, ins.rhs, ins.ty)
    return true
  }
  if (op == Op.IndexSet) {
    // index_set keeps its VALUE operand in ival (rhs is the index). Width
    // comes from `ival2`, the store's own recorded type (#4396).
    emitIndexSet(cx, ins.lhs, ins.rhs, ins.ival, ins.ival2)
    return true
  }
  if (op == Op.SliceLen) {
    emitSliceLen(cx, i, ins.lhs)
    return true
  }
  return false
}

fn compileInstAtomic(cx: A64Ctx, i: int, ins: IrInstr): bool {
  let op = ins.op
  if (op == Op.AtomicLoad) {
    emitAtomicLoad(cx, i, ins.lhs, ins.ty)
    return true
  }
  if (op == Op.AtomicStore) {
    // Pointee width from `ival2`, the store's own recorded type (#4396).
    emitAtomicStore(cx, ins.lhs, ins.rhs, ins.ival2)
    return true
  }
  if (op == Op.AtomicCmpxchg) {
    // Pointee width from `ival2`, the store's own recorded type (#4396).
    emitAtomicCmpxchg(
      cx,
      i,
      AtomicCasOperands{ ptr: ins.lhs, expected: ins.rhs, desired: ins.ival, ty: ins.ival2 },
    )
    return true
  }
  if (opIsAtomicRmw(op)) {
    emitAtomicRmw(cx, op, AtomicRmwOperands{ dst: i, ptr: ins.lhs, operand: ins.rhs, ty: ins.ty })
    return true
  }
  return false
}

fn compileInstAddr(cx: A64Ctx, i: int, ins: IrInstr): bool {
  let op = ins.op
  if (op == Op.MakeClosure) {
    emitMakeClosure(cx, i, ins.name, ins.lhs)
    return true
  }
  if (op == Op.FuncAddr) {
    emitFuncAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.GlobalAddr) {
    emitGlobalAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.StackMapsAddr) {
    emitStackMapsAddr(cx, i, ins.name)
    return true
  }
  // #4457: not an address materialization but the same shape — one value, no
  // operands, no call — so it is claimed here rather than in a family of one.
  if (op == Op.PollAttention) {
    emitPollAttention(cx, i)
    return true
  }
  if (op == Op.Syscall) {
    emitSyscall(cx, i, ins.lhs, ins.args)
    return true
  }
  if (op == Op.Asm) {
    emitAsm(cx, dstOrNone(cx, i, ins.ty), ins.ival, ins.args)
    return true
  }
  return false
}

// Emits one instruction. `curBlock` is only needed to classify an edge as a
// back-edge. Tries each instruction-family helper above in turn; the first
// one that claims `op` does the emission.
fn compileInst(cx: A64Ctx, curBlock: int, i: int) {
  let ins = cx.f.instrs[i]
  let iw = widthOf(cx.module.ctx, ins.ty) // result width: drives narrow re-canonicalization

  if (compileInstConst(cx, i, ins, iw)) {
    return
  }
  if (compileInstIntArith(cx, i, ins, iw)) {
    return
  }
  if (compileInstFloatArith(cx, i, ins, iw)) {
    return
  }
  if (compileInstUnary(cx, i, ins, iw)) {
    return
  }
  if (compileInstControl(cx, curBlock, i, ins)) {
    return
  }
  if (compileInstCall(cx, i, ins)) {
    return
  }
  if (compileInstMem(cx, i, ins)) {
    return
  }
  if (compileInstAtomic(cx, i, ins)) {
    return
  }
  if (compileInstAddr(cx, i, ins)) {
    return
  }
  // block_param is never reached: every emission loop starts past a block's
  // params.
  assert(ins.op != Op.BlockParam)
  assert(false) // unhandled op
}

// A void-typed instruction has no result to bind; -1 says so.
// emitAsm/emitSyscall moved to arm64asm.bit (#3283, pure move — line budget).

// Every arm64 register pinned by an `asm` block (`input`/`result`/clobber) or by
// a `syscall` in `f`, indexed by register number 0..31. The `memory` sentinel
// (254) falls outside the array and is skipped; `sp`/`xzr` (31) is never
// allocatable anyway.
fn collectReservedArm64(module: IrModule, f: IrFunc): []bool {
  let reserved = []bool(32)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    // §11.8: x8 holds the syscall number, x0..x5 the arguments, x0 the kernel's
    // return value. `svc` is a trap, not a `bl` — the Linux arm64 kernel ABI
    // preserves every other register, so unlike x64 there is nothing more to
    // exclude.
    if (ins.op == Op.Syscall) {
      reserved[syscallNrReg()] = true
      let regs = syscallArgRegs()
      let k = 0
      while (k < len(regs)) {
        reserved[regs[k]] = true
        k = k + 1
      }
    }
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      if (blk.hasResult && blk.resultArm64 < 32) {
        reserved[blk.resultArm64] = true
      }
      let j = 0
      while (j < len(blk.inArm64)) {
        if (blk.inArm64[j] < 32) {
          reserved[blk.inArm64[j]] = true
        }
        j = j + 1
      }
      j = 0
      while (j < len(blk.clobArm64)) {
        if (blk.clobArm64[j] < 32) {
          reserved[blk.clobArm64[j]] = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return reserved
}

fn dstOrNone(cx: A64Ctx, i: int, ty: int): int {
  if (ty == cx.module.ctx.voidId) {
    return -1
  }
  return i
}

fn isIcmp(op: Op): bool {
  return op == Op.ICmpEq ||
    op == Op.ICmpNe ||
    op == Op.ICmpSlt ||
    op == Op.ICmpSle ||
    op == Op.ICmpSgt ||
    op == Op.ICmpSge ||
    op == Op.ICmpUlt ||
    op == Op.ICmpUle ||
    op == Op.ICmpUgt ||
    op == Op.ICmpUge
}

fn isFcmp(op: Op): bool {
  return op == Op.FCmpEq ||
    op == Op.FCmpNe ||
    op == Op.FCmpLt ||
    op == Op.FCmpLe ||
    op == Op.FCmpGt ||
    op == Op.FCmpGe
}
