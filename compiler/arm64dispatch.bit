// Self-host Stage 3 (#1342): ARM64 per-instruction dispatch — compileInst's
// giant op switch, the register-reservation scan for asm/syscall blocks, and
// the small predicates only dispatch needs. Split out of arm64compile.bit
// (#3915, pure move — that file crossed 800 lines adding the hidden-call-
// hazard predicates for frame layout). Sibling .bit file, same module: see
// arm64.bit for the backend overview; arm64compile.bit keeps the top-level
// per-function driver (register allocation, frame layout, emission).

// ===========================================================================
// Instruction dispatch
// ===========================================================================

// Which `const_int` definitions (#1853) an ADD/SUB-immediate fold, a bitmask
// AND/ORR/EOR-immediate fold (#3495), a power-of-two Mul (#3105) or a
// power-of-two SDiv/UDiv (#3104) consumes entirely, indexed by instruction id.
// `instrOperands` (opt.bit) is the SAME operand map DCE uses, so a constant
// with any use besides the one fold that reads it as an immediate keeps
// `false` and still materializes normally — this only marks a def whose sole
// structural use is that one fold, mirroring the emitters' own operand order
// so nothing here marks skipped a value an emitter actually reads as a
// register.
//
// SRem/URem are deliberately excluded from the divide case: `emitDivInt`
// only takes the shift path for SDiv/UDiv (#3104 — msub still needs the real
// divisor register to recover a remainder), so skipping the divisor for a Rem
// would leave the general path reading an unmaterialized register — the
// `useCount == 1` guard below exists to prevent exactly this class of bug.
//
// `debug` (#3080/§13.5) is the same hazard: a debug build's `emitBinaryInt`
// skips the ADD/SUB-immediate fold (no flag-setting immediate form exists),
// so this arm must agree or a constant marked skipped here reads an
// unmaterialized register. Verified live: unguarded, `x + 1` under `--debug`
// emitted `adds x21, x19, x20` with no prior write to x20. Mul's debug
// overflow trap (#3084, arm64selectovf.bit) does read `cx.debug` now, but
// never re-reads the skipped operand: `emitPow2MulInt`'s check only touches
// the non-constant operand's register and the compile-time-known shift
// amount `k`, so skipping the power-of-two constant here stays safe in every
// build mode. Div is still untouched — it reads `cx.debug` nowhere.
fn computeSkipConstMaterialize(ctx: TypeContext, f: IrFunc, debug: bool): []bool {
  let n = len(f.instrs)
  let useCount = []int(0)
  let i = 0
  while (i < n) {
    useCount = append(useCount, 0)
    i = i + 1
  }
  i = 0
  while (i < n) {
    let ops = instrOperands(f, i)
    let k = 0
    while (k < len(ops)) {
      useCount[ops[k]] = useCount[ops[k]] + 1
      k = k + 1
    }
    i = i + 1
  }
  let skip = []bool(0)
  i = 0
  while (i < n) {
    skip = append(skip, false)
    i = i + 1
  }
  i = 0
  while (i < n) {
    let ins = f.instrs[i]
    if ((ins.op == Op.Add || ins.op == Op.Sub) && !debug) {
      let rc = constIntOf(f, ins.rhs)
      if (rc.known && resolveAddSubImm(ins.op, rc.ival).fits && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      } else if (ins.op == Op.Add) {
        let lc = constIntOf(f, ins.lhs)
        if (lc.known && resolveAddSubImm(ins.op, lc.ival).fits && useCount[ins.lhs] == 1) {
          skip[ins.lhs] = true
        }
      }
    } else if (ins.op == Op.Mul) {
      let w = widthOf(ctx, ins.ty)
      let factor = xConstPow2Factor(f, ins.lhs, ins.rhs, w)
      if (factor.k >= 0) {
        let constOp = ins.lhs
        if (factor.value == ins.lhs) {
          constOp = ins.rhs
        }
        if (useCount[constOp] == 1) {
          skip[constOp] = true
        }
      }
    } else if (ins.op == Op.BAnd || ins.op == Op.BOr || ins.op == Op.BXor) {
      let s = logicalConstSkip(f, ins.rhs, ins.lhs)
      if (s >= 0 && useCount[s] == 1) {
        skip[s] = true
      }
    } else if (ins.op == Op.SDiv || ins.op == Op.UDiv) {
      let w = widthOf(ctx, ins.ty)
      let pk = xConstPow2Divisor(f, ins.rhs, w)
      if (pk >= 0 && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      }
    } else if (ins.op == Op.Shl || ins.op == Op.AShr || ins.op == Op.LShr) {
      // `constShiftAmount` (arm64select.bit) masks any const_int to 0-63,
      // never returning -1 for one — the only -1 case is "not a const_int at
      // all" — so this guard fires on exactly the operand `emitShiftInt`'s
      // own `amt >= 0` branch takes, and the masked value is always a legal
      // shift-immediate encoding regardless of the IR's result width.
      if (constShiftAmount(f, ins.rhs) >= 0 && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      }
    }
    i = i + 1
  }
  return skip
}

// #3101: does `compileInst` write instruction `i`'s own allocated register?
//
// Mirrors the dispatch below, and DEFAULTS TO TRUE so the mirror can only ever
// fail safe: a new op, or one this list forgets, is treated as writing its
// register and is saved as before. Only the reverse — claiming a write does not
// happen when it does — could drop a live callee-saved value, so nothing goes in
// the false list without a `compileInst` arm that provably binds no destination:
//
//   * Jump/Br/Ret/Unreachable/FieldSet/IndexSet/AtomicStore pass no `i` to their
//     emitter at all; they only read operands.
//   * Call/CallValue/CallIface/RtCall/Asm route their destination through
//     `dstOrNone`, which answers -1 for a void result, and `emitCall`/`emitAsm`
//     each guard on that (arm64call.bit's `dst < 0`, emitAsm's `dst >= 0`).
//   * a `const_int` in `skipConst` is the one arm that materializes nothing;
//     `computeSkipConstMaterialize` above already proves its sole use reads it as
//     an immediate, never as a register, so nothing loads it either.
//
// block_param is deliberately absent: `moveBlockArgs` writes a param's register
// on every incoming edge, so it is a real definition even though `compileInst`
// never sees one.
fn arm64WritesResult(ctx: TypeContext, f: IrFunc, skipConst: []bool, i: int): bool {
  let ins = f.instrs[i]
  let op = ins.op
  if (op == Op.Jump ||
    op == Op.Br ||
    op == Op.Ret ||
    op == Op.Unreachable ||
    op == Op.FieldSet ||
    op == Op.IndexSet ||
    op == Op.AtomicStore) {
    return false
  }
  if (op == Op.ConstInt) {
    return !skipConst[i]
  }
  if (op == Op.Call ||
    op == Op.CallValue ||
    op == Op.CallIface ||
    op == Op.RtCall ||
    op == Op.Asm) {
    return ins.ty != ctx.voidId
  }
  return true
}

// Emits one instruction. `curBlock` is only needed to classify an edge as a
// back-edge.
fn compileInst(cx: A64Ctx, curBlock: int, i: int) {
  let ins = cx.f.instrs[i]
  let op = ins.op
  let ty = ins.ty
  let iw = widthOf(cx.module.ctx, ty) // result width: drives narrow re-canonicalization

  if (op == Op.ConstInt) {
    if (!cx.skipConst[i]) {
      emitConstInt(cx, i, ins.ival)
    }
    return
  }
  if (op == Op.ConstBool) {
    emitConstBool(cx, i, ins.bval)
    return
  }
  if (op == Op.ConstNil) {
    emitConstNil(cx, i)
    return
  }
  if (op == Op.ConstFloat) {
    emitConstFloat(cx, i, ins.fval, iw.bytes)
    return
  }
  if (op == Op.ConstString) {
    emitConstString(cx, i, ins.ival)
    return
  }
  if (op == Op.Add || op == Op.Sub || op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    emitBinaryInt(cx, op, i, ins.lhs, ins.rhs, iw)
    return
  }
  if (op == Op.Mul) {
    emitMulInt(cx, i, ins.lhs, ins.rhs, xConstPow2Factor(cx.f, ins.lhs, ins.rhs, iw), iw)
    return
  }
  if (op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem) {
    emitDivInt(cx, op, i, ins.lhs, ins.rhs, xConstPow2Divisor(cx.f, ins.rhs, iw), iw)
    return
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    emitShiftInt(cx, op, i, ins.lhs, ins.rhs, iw)
    return
  }
  if (isIcmp(op)) {
    emitIcmp(cx, op, i, ins.lhs, ins.rhs)
    return
  }
  if (op == Op.FAdd) {
    emitBinaryFloat(cx, FArithOp.Add, i, ins.lhs, ins.rhs, iw.bytes)
    return
  }
  if (op == Op.FSub) {
    emitBinaryFloat(cx, FArithOp.Sub, i, ins.lhs, ins.rhs, iw.bytes)
    return
  }
  if (op == Op.FMul) {
    emitBinaryFloat(cx, FArithOp.Mul, i, ins.lhs, ins.rhs, iw.bytes)
    return
  }
  if (op == Op.FDiv) {
    emitBinaryFloat(cx, FArithOp.Div, i, ins.lhs, ins.rhs, iw.bytes)
    return
  }
  if (isFcmp(op)) {
    // A float compare's operand width comes from the OPERANDS — its own result is
    // a bool.
    emitFcmp(cx, op, i, ins.lhs, ins.rhs, widthOf(cx.module.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return
  }
  if (op == Op.Neg || op == Op.BNot) {
    emitUnaryInt(cx, op, i, ins.lhs, iw)
    return
  }
  if (op == Op.Convert) {
    emitConvert(cx, i, ins.lhs, ty)
    return
  }
  if (op == Op.FNeg) {
    emitFneg(cx, i, ins.lhs, iw.bytes)
    return
  }
  if (op == Op.FSqrt) {
    emitFsqrt(cx, i, ins.lhs, iw.bytes)
    return
  }
  // FRINTM / FRINTP / FRINTZ / FRINTA — floor, ceil, truncate,
  // round-half-away-from-zero.
  if (op == Op.FFloor) {
    emitFRound(cx, i, ins.lhs, iw.bytes, 10)
    return
  }
  if (op == Op.FCeil) {
    emitFRound(cx, i, ins.lhs, iw.bytes, 9)
    return
  }
  if (op == Op.FTrunc) {
    emitFRound(cx, i, ins.lhs, iw.bytes, 11)
    return
  }
  if (op == Op.FRound) {
    emitFRound(cx, i, ins.lhs, iw.bytes, 12)
    return
  }
  // The width always comes from the FLOAT side — the integer view of an f32 is
  // 4 bytes wide whichever direction the transfer runs, and only one of the two
  // types carries a float width to read.
  if (op == Op.Bitcast) {
    let dstIsFloat = iw.regClass == RegClass.Float
    let bw = widthOf(cx.module.ctx, cx.f.instrs[ins.lhs].ty).bytes
    if (dstIsFloat) {
      bw = iw.bytes
    }
    emitBitcast(cx, i, ins.lhs, bw, dstIsFloat)
    return
  }
  if (op == Op.Jump) {
    emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival)
    moveBlockArgs(cx, ins.ival, ins.args)
    emitJumpOrFallThrough(cx, curBlock, i, ins.ival)
    return
  }
  if (op == Op.Br) {
    let elseFixup = emitCondBranchOnBool(cx, i, ins.lhs)
    emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival)
    moveBlockArgs(cx, ins.ival, ins.thenArgs)
    emitJumpFixup(cx, ins.ival)
    patchLocalCondBranch(cx, elseFixup)
    emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival2)
    moveBlockArgs(cx, ins.ival2, ins.elseArgs)
    emitJumpOrFallThrough(cx, curBlock, i, ins.ival2)
    return
  }
  if (op == Op.Ret) {
    // Multi-value returns are lowered to a boxed tuple before codegen, so at most
    // one value reaches here.
    assert(len(ins.args) <= 1)
    if (len(ins.args) == 1) {
      let v = ins.args[0]
      if (regClassOf(cx.module.ctx, cx.f.instrs[v].ty) == RegClass.Int) {
        movRR(cx.code, retRegNum(), getInt(cx, vregOf(cx, v), scratch1()))
      } else {
        fmovFF(cx.code, retRegNum(), getFloat(cx, vregOf(cx, v), fscratch1()), 8)
      }
    }
    emitEpilogueAndRet(cx)
    return
  }
  if (op == Op.Unreachable) {
    emitUdf(cx.code)
    return
  }
  if (op == Op.Call) {
    emitCall(cx, dstOrNone(cx, i, ty), ty, ins.name, ins.args, true)
    return
  }
  if (op == Op.CallValue) {
    emitCallValue(cx, dstOrNone(cx, i, ty), ty, ins.lhs, ins.args)
    return
  }
  if (op == Op.CallIface) {
    emitCallIface(cx, dstOrNone(cx, i, ty), ty, ins.lhs, ins.ival, ins.args)
    return
  }
  if (op == Op.RtCall) {
    emitCall(cx, dstOrNone(cx, i, ty), ty, rtSymbol(ins.name), ins.args, true)
    return
  }
  if (op == Op.GcAlloc) {
    emitGcAlloc(cx, i, ins.ival, ins.offsets)
    return
  }
  if (op == Op.TypeInfo) {
    emitTypeInfo(cx, i, ins.ival, ins.ival2, ins.offsets)
    return
  }
  if (op == Op.FieldGet) {
    emitFieldGet(
      cx, i, ins.lhs, ins.ival, ty,
      isHeaderBase(cx.module.ctx, cx.f.instrs[ins.lhs].ty),
    )
    return
  }
  if (op == Op.FieldSet) {
    emitFieldSet(cx, ins.lhs, ins.ival, ins.rhs, cx.f.instrs[ins.rhs].ty)
    return
  }
  if (op == Op.IndexGet) {
    emitIndexGet(cx, i, ins.lhs, ins.rhs, ty)
    return
  }
  if (op == Op.IndexSet) {
    // index_set keeps its VALUE operand in ival (rhs is the index).
    emitIndexSet(cx, ins.lhs, ins.rhs, ins.ival, cx.f.instrs[ins.ival].ty)
    return
  }
  if (op == Op.SliceLen) {
    emitSliceLen(cx, i, ins.lhs)
    return
  }
  if (op == Op.AtomicLoad) {
    emitAtomicLoad(cx, i, ins.lhs, ty)
    return
  }
  if (op == Op.AtomicStore) {
    emitAtomicStore(cx, ins.lhs, ins.rhs, cx.f.instrs[ins.rhs].ty)
    return
  }
  if (op == Op.AtomicCmpxchg) {
    emitAtomicCmpxchg(cx, i, ins.lhs, ins.rhs, ins.ival)
    return
  }
  if (opIsAtomicRmw(op)) {
    emitAtomicRmw(cx, op, i, ins.lhs, ins.rhs, ty)
    return
  }
  if (op == Op.MakeClosure) {
    emitMakeClosure(cx, i, ins.name, ins.lhs)
    return
  }
  if (op == Op.FuncAddr) {
    emitFuncAddr(cx, i, ins.name)
    return
  }
  if (op == Op.GlobalAddr) {
    emitGlobalAddr(cx, i, ins.name)
    return
  }
  if (op == Op.StackMapsAddr) {
    emitStackMapsAddr(cx, i, ins.name)
    return
  }
  if (op == Op.Syscall) {
    emitSyscall(cx, i, ins.lhs, ins.args)
    return
  }
  if (op == Op.Asm) {
    emitAsm(cx, dstOrNone(cx, i, ty), ins.ival, ins.args)
    return
  }
  // block_param is never reached: every emission loop starts past a block's
  // params.
  assert(op != Op.BlockParam)
  assert(false) // unhandled op
}

// A void-typed instruction has no result to bind; -1 says so.
// emitAsm/emitSyscall moved to arm64asm.bit (#3283, pure move — line budget).

// Every arm64 register pinned by an `asm` block (`input`/`result`/clobber) or by
// a `syscall` in `f`, indexed by register number 0..31. The `memory` sentinel
// (254) falls outside the array and is skipped; `sp`/`xzr` (31) is never
// allocatable anyway.
fn collectReservedArm64(module: IrModule, f: IrFunc): []bool {
  let reserved = []bool(32)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    // §11.8: x8 holds the syscall number, x0..x5 the arguments, x0 the kernel's
    // return value. `svc` is a trap, not a `bl` — the Linux arm64 kernel ABI
    // preserves every other register, so unlike x64 there is nothing more to
    // exclude.
    if (ins.op == Op.Syscall) {
      reserved[syscallNrReg()] = true
      let regs = syscallArgRegs()
      let k = 0
      while (k < len(regs)) {
        reserved[regs[k]] = true
        k = k + 1
      }
    }
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      if (blk.hasResult && blk.resultArm64 < 32) {
        reserved[blk.resultArm64] = true
      }
      let j = 0
      while (j < len(blk.inArm64)) {
        if (blk.inArm64[j] < 32) {
          reserved[blk.inArm64[j]] = true
        }
        j = j + 1
      }
      j = 0
      while (j < len(blk.clobArm64)) {
        if (blk.clobArm64[j] < 32) {
          reserved[blk.clobArm64[j]] = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return reserved
}

fn dstOrNone(cx: A64Ctx, i: int, ty: int): int {
  if (ty == cx.module.ctx.voidId) {
    return -1
  }
  return i
}

fn isIcmp(op: Op): bool {
  return op == Op.ICmpEq ||
    op == Op.ICmpNe ||
    op == Op.ICmpSlt ||
    op == Op.ICmpSle ||
    op == Op.ICmpSgt ||
    op == Op.ICmpSge ||
    op == Op.ICmpUlt ||
    op == Op.ICmpUle ||
    op == Op.ICmpUgt ||
    op == Op.ICmpUge
}

fn isFcmp(op: Op): bool {
  return op == Op.FCmpEq ||
    op == Op.FCmpNe ||
    op == Op.FCmpLt ||
    op == Op.FCmpLe ||
    op == Op.FCmpGt ||
    op == Op.FCmpGe
}
