fn checkPeWriterBounds() {
  checkPeWriterDataBounds()
  checkPeWriterRelocBounds()
  checkPeWriterTableBounds()
  checkPeWriterStringBounds()
  checkPeWriterBssBounds()
  checkPeWriterContainment()
}

fn checkPeWriterDataBounds() {
  let max = peWriterU32Max()
  assert(
      (peWriterField(max) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (peWriterField(max + 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteSectionOffset(max - 7, 8) catch _ {
        -1
      }) ==
      max - 7,
  )
  assert(
      (peWriteSectionOffset(max - 6, 8) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteDataEnd(max, max) catch _ {
        -1
      }) ==
      max * 2,
  )
  assert(
      (peWriteDataEnd(max, max + 1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkPeWriterRelocBounds() {
  let max = peWriterU32Max()
  assert(
      (pePhysicalRelocCount(65535) catch _ {
        -1
      }) ==
      65535,
  )
  assert(
      (pePhysicalRelocCount(65536) catch _ {
        -1
      }) ==
      65537,
  )
  assert(
      (pePhysicalRelocCount(max - 1) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (pePhysicalRelocCount(max) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteRelocEnd(max, max - 1) catch _ {
        -1
      }) ==
      max * 11,
  )
  assert(
      (peWriteRelocEnd(max + 1, 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (pePhysicalRelocCount(-1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkPeWriterTableBounds() {
  let max = peWriterU32Max()
  assert(
      (peWriteTableEnd(max, max, 4) catch _ {
        -1
      }) ==
      max * 19 + 4,
  )
  assert(
      (peWriteTableEnd(max + 1, 1, 4) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteTableEnd(20, max + 1, 4) catch _ {
        -1
      }) ==
      -1,
  )
  let limit = objectByteLimit()
  assert(
      (peWriteTableEnd(limit - 4, 0, 4) catch _ {
        -1
      }) ==
      limit,
  )
  assert(
      (peWriteTableEnd(limit - 3, 0, 4) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteTableEnd(-1, 0, 4) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkPeWriterStringBounds() {
  let max = peWriterU32Max()
  assert(
      (peWriteNameEnd(4, max - 5) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (peWriteNameEnd(4, max - 4) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteNameEnd(4, -1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (peWriteTableEnd(20, 0, max) catch _ {
        -1
      }) ==
      max + 20,
  )
  assert(
      (peWriteTableEnd(20, 0, max + 1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkPeWriterBssBounds() {
  let obj = PeObject{
    sections = [
      PeSection{
        kind = PeSectionKind.Bss, data = []u8(0), size = peWriterU32Max(), alignment = 8,
      },
    ],
    symbols = []PeSymbol(0), relocations = []PeRelocation(0),
  }
  let b = pecBytes(PeTarget.X86_64, obj)
  assert(len(b) == sizeofPeFileHeader() + sizeofPeSectionHeader() + 4)
  assert(leAt(b, sizeofPeFileHeader() + 16, 4) == peWriterU32Max())
  obj.sections[0].size = peWriterU32Max() + 1
  assert(pecErr(PeTarget.X86_64, obj) == "ObjectSizeOverflow")
  obj.sections[0].size = -1
  assert(pecErr(PeTarget.X86_64, obj) == "ObjectSizeOverflow")
}

fn checkPeWriterContainment() {
  let obj = PeObject{
    sections = [
      PeSection{
        kind = PeSectionKind.Bss, data = []u8(0), size = 8, alignment = 1,
      },
    ],
    symbols = [
      PeSymbol{
        name = "s", hasSection = true, section = PeSectionKind.Bss,
        offset = 8, size = 0, binding = PeBinding.Local, kind = PeSymKind.Object,
      },
    ],
    relocations = []PeRelocation(0),
  }
  assert(pecErr(PeTarget.X86_64, obj) == "")
  obj.symbols[0].offset = -1
  assert(pecErr(PeTarget.X86_64, obj) == "SymbolOutOfBounds")
  obj.symbols[0].offset = 1
  obj.symbols[0].size = vI64Max()
  assert(pecErr(PeTarget.X86_64, obj) == "SymbolOutOfBounds")
  obj.symbols[0].size = -1
  assert(pecErr(PeTarget.X86_64, obj) == "SymbolOutOfBounds")
  obj.symbols[0].size = 0
  obj.relocations = [
    PeRelocation{
      section = PeSectionKind.Bss, offset = 0, symbol = "s", kind = PeRelocKind.Addr64,
    },
  ]
  assert(pecErr(PeTarget.X86_64, obj) == "")
  obj.relocations[0].offset = -1
  assert(pecErr(PeTarget.X86_64, obj) == "RelocOutOfBounds")
  obj.relocations[0].offset = vI64Max()
  assert(pecErr(PeTarget.X86_64, obj) == "RelocOutOfBounds")
}
