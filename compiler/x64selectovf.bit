// Self-host Stage 3 (#1346): the x86-64 backend, signed-overflow trap.
// Split out of compiler/x64select.bit at 826 lines against the 800-line
// limit (#3082) — same module, so nothing here is imported.

// ---------------------------------------------------------------------------
// Signed add/sub overflow trap (#3082, SPEC §13.5, debug builds only)
// ---------------------------------------------------------------------------
//
// Mirrors the div-by-zero sequence in x64selectarith.bit's xEmitDivInt (#2016): a
// conditional branch over a call to a `@nosplit` root-io panic function,
// taken only on the error path. Unsigned add/sub always wraps modularly
// (§13.5: no trap possible) — gated on `w.signed`, not just `cx.debug`.
//
// ADD/SUB always set OF on x86-64, register or immediate form, so no special
// flag-setting encoding is needed the way AArch64 needs ADDS/SUBS over
// ADD/SUB. But OF from a 64-bit ADD/SUB only reflects TRUE 64-bit overflow:
// every integer SSA value lives sign-extended in a full 64-bit GPR (module
// doc comment, top of x64select.bit), so at a narrower type width OF can read
// clear while the narrow value has actually overflowed — it is simply the
// wrong flag for any width other than 8. So width 8 reads OF directly;
// narrower widths re-narrow a COPY (xScratch3, never allocated to a vreg —
// see xBuildIntRegs/xMasterGprs) and compare it against the pre-narrow
// result, exactly the range check optfold.bit's foldAddSubMul performs at
// compile time for constants.
fn xEmitOverflowCall(cx: XCtx) {
  let shadow = xShadowSpace(cx.cc)
  if (shadow > 0) {
    xRspAddSub(cx.buf, true, shadow)
  }
  xCallReloc(cx, "bit_rt_panic_overflow")
  if (shadow > 0) {
    xRspAddSub(cx.buf, false, shadow)
  }
}

// True 64-bit overflow: OF from the add/sub that just ran is authoritative.
fn xEmitOverflowTrap64(cx: XCtx) {
  let skip = xJccRel32Placeholder(cx, ccNo())
  xEmitOverflowCall(cx)
  xPatchRel32Here(cx, skip)
}

// Narrower than 64 bits: re-narrow a copy of `reg` and compare against the
// pre-narrow value in `reg` itself — a mismatch is exactly the out-of-range
// result optfold.bit's foldAddSubMul declines to fold at compile time.
fn xEmitOverflowTrapNarrow(cx: XCtx, reg: XReg64, w: Width) {
  xMovRR(cx.buf, xScratch3(), reg)
  xCanonNarrow(cx.buf, xScratch3(), w)
  xArithRR(cx.buf, XArith.Cmp, reg, xScratch3())
  let skip = xJccRel32Placeholder(cx, ccE())
  xEmitOverflowCall(cx)
  xPatchRel32Here(cx, skip)
}

// `reg` holds a just-computed signed add/sub result, still pre-narrow. Emits
// nothing outside debug builds or for an unsigned width (§13.5: unsigned
// always wraps). Must run BEFORE the caller's own `xCanonNarrow` — the narrow
// path needs the pre-narrow value to compare against.
fn xMaybeOverflowTrap(cx: XCtx, reg: XReg64, w: Width) {
  if (!cx.debug || !w.signed) {
    return
  }
  if (w.bytes == 8) {
    xEmitOverflowTrap64(cx)
    return
  }
  xEmitOverflowTrapNarrow(cx, reg, w)
}

// ---------------------------------------------------------------------------
// Signed multiply overflow trap (#3085, SPEC §13.5, debug builds only)
// ---------------------------------------------------------------------------
//
// The general (non-folded) multiply emits x86-64's two-operand IMUL
// (`0F AF /r`, xImulRR, x64arith.bit): `dst = dst * src`, computed as a
// genuine 64x64->64 product, with CF/OF set exactly when the mathematical
// result does not fit in the 64-bit destination — the same "true 64-bit
// overflow" fact ADD/SUB's OF reports above. So at width 8 `xMaybeOverflowTrap`
// (unchanged) already applies: the IMUL that just ran leaves OF authoritative,
// and its caller (xEmitMulInt) inserts the identical call ADD/SUB's own RR
// path does. At width < 8 both operands are themselves sign-extended values
// of that narrower type (bounded magnitude < 2^(bits-1)), so their exact
// product can never reach 2^63 in magnitude — true 64-bit overflow cannot
// happen, and only whether the product fits width w's own narrower range
// remains to check, exactly what `xEmitOverflowTrapNarrow` already does. So
// the general path needs no new code here at all.
//
// The `x * 2^k` strength-reduction fold (#3105, x64selectarith.bit's
// xEmitPow2MulInt) is genuinely different: it never runs IMUL, so there is no
// OF to read, and SHL's own OF flag is defined ONLY for a shift count of
// exactly 1 (Intel SDM) — `k` here is not fixed. `value` and the `2^k` factor
// are each still bounded the same way a general operand is (the factor is
// itself a valid literal of width w), so the width-8-vs-narrower split above
// still applies unchanged; only the width-8 arm needs a different mechanism
// since there is no flag to read.
//
// `xEmitPow2MulOverflowTrap64` derives the same "did the true product need
// more than 64 bits" fact without a hardware flag: shifting the already-shl'd
// result back down by the same `k` (arithmetic, to restore the sign the way a
// genuine right shift of a signed value would) and comparing against the
// pre-shift operand — unequal means bits fell off the top. This is the
// standard technique for detecting a signed left shift's overflow in the
// absence of a usable flag, and it works for any `k`, not just 1 (checked by
// hand: i64 MIN << 1 loses the sign bit entirely and the shift-back correctly
// disagrees; 2^61 << 2 == 2^63, exactly one past i64 MAX, and disagrees too).
// The caller must keep `original` in a register the shl never touches —
// `shifted` and `original` must not alias.
fn xEmitPow2MulOverflowTrap64(cx: XCtx, shifted: XReg64, original: XReg64, k: int) {
  xMovRR(cx.buf, xScratch3(), shifted)
  xShiftImm(cx.buf, XShift.Sar, xScratch3(), k)
  xArithRR(cx.buf, XArith.Cmp, xScratch3(), original)
  let skip = xJccRel32Placeholder(cx, ccE())
  xEmitOverflowCall(cx)
  xPatchRel32Here(cx, skip)
}
