// compiler/lowertypeassert.bit — every lowering of `iface.(T)` (SPEC §14.4),
// moved out of lowerexpr.bit by #4512 and joined there by the INTERFACE-target
// form that ticket added. Sibling of lowerexpr.bit: same module, so this needs
// no imports and no call-site changes.
//
// Two shapes, three kinds of target:
//
//   let x       = iface.(T)   panics on a mismatch   `lowerTypeAssert`
//   let (x, ok) = iface.(T)   yields (nil, false)    `lowerTypeAssertTwo`
//
//   T a CLASS      — one pointer compare against T's `TypeInfo` descriptor,
//                    `bit_rt_iface_as` / `bit_rt_iface_assert` (ABI.md
//                    §2.2): descriptor identity IS type identity.
//   T a BOXED ENUM — a boxed enum's object size varies PER VARIANT (§14.7),
//                    so unlike a class there is no single descriptor every
//                    allocation of T shares; `bit_rt_iface_as_enum` compares
//                    descriptors by their `type_id` word instead of address
//                    (ABI.md §2.2a, #6017). No `bit_rt_iface_assert_enum` exists — the
//                    one-result form (`lowerEnumAssertOne`) builds its own
//                    panic block here, the same way the INTERFACE case below
//                    already does. A non-boxed (bare-tag) enum is rejected at
//                    check time (`vStorableInInterface`) and never reaches here.
//   T an INTERFACE — `ok` is "the dynamic type's method set satisfies T", which
//                    is what a structural interface assertion means (§14.3), so
//                    there is no single descriptor to compare against. One
//                    `bit_rt_iface_implements` call carrying T's method ids,
//                    the verdict cached per (type, T) (`lowerIfaceNarrow`,
//                    #7406). Before #4512 this shape passed the
//                    checker and then failed to lower at all (E0092).

// The dispatch ids of `iface`'s methods — `methodId`'s ids (lower.bit), the
// same ones `Op.CallIface` emits, so a hit here is exactly a method the
// receiver can dispatch. Empty for an interface that declares no methods.
//
// #5979: each id carries `iface`'s own declared signature for that name
// (`methodSigLookup`), so a class whose method shares only the NAME with
// `iface`'s misses here instead of narrowing successfully and segfaulting
// the first call through it.
//
// The predeclared `error` (§10.6) has no declaration for `vIfaceMethodNames`
// to walk, so its one method is named here by hand — checkmodule.bit registers
// `error.message` by hand for the same reason.
fn ifaceAssertMethodIds(fc: FnCtx, iface: int): []int {
  let names = vIfaceMethodNames(fc.c, iface)
  if (len(names) == 0 && iface == fc.c.ctx.errorId) {
    names = ["message"]
  }
  let out = []int(0)
  for m of names {
    let sig = methodSigLookup(fc.c, "${iface}.${m}")
    out = append(out, methodId(fc.lowerer, fc.c.ctx, m, sig))
  }
  return out
}

// `iface.(I)` narrowed to the interface `I`: the receiver, or null when its
// dynamic type does not satisfy `I`. ONE `bit_rt_iface_implements` call (ABI.md
// §2.2b, #7406) carrying `I`'s method ids as a pooled string of decimal ids
// joined by `,`: the runtime tests the whole set and caches the verdict per
// (dynamic type, interface), where the chain this replaced walked the method
// table once per method on every assertion. The pooled string's address is the
// interface's cache key, so two interfaces with one method set share a verdict.
// Both callers below take `ok` as a null test of the result (`assertOk`).
//
// An interface with no methods emits no call at all and the receiver IS the
// answer: every value carrying a dynamic type satisfies an empty method set.
fn lowerIfaceNarrow(fc: FnCtx, recv: int, iface: int, ids: []int): int {
  if (len(ids) == 0) {
    return recv
  }
  let list = "${ids[0]}"
  let i = 1
  while (i < len(ids)) {
    list = list + ",${ids[i]}"
    i = i + 1
  }
  let k = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  k.sval = list
  k.ival = internPoolString(fc, list)
  let call = mkInstr(Op.RtCall, iface)
  call.name = "iface_implements"
  call.args = [recv, builderEmit(fc.b, k)]
  return emitRtCall(fc, call)
}

// Lowers the one-result assertion `iface.(T)` (SPEC §14.4): the receiver, then
// `T`'s TypeInfo descriptor, then `rt_call iface_assert(recv, info) T` — which
// panics on a mismatch. The two-result form `(v, ok) = iface.(T)` routes through
// the assign path instead (`lowerTypeAssertTwo`).
fn lowerTypeAssert(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let ty = nodeType(fc, node)
  let recv = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  if (fc.c.ctx.types[ty].kind == TypeKind.Interface) {
    return lowerIfaceAssertOne(fc, recv, ty)
  }
  let info = lowerTypeInfo(fc, ty, getNode(fc.c.tree, node).span)
  if (fc.failed) {
    return 0
  }
  if (fc.c.ctx.types[ty].kind == TypeKind.Enum) {
    return lowerEnumAssertOne(fc, recv, ty, info)
  }
  let ins = mkInstr(Op.RtCall, ty)
  ins.name = "iface_assert"
  ins.args = [recv, info]
  return emitRtCall(fc, ins)
}

// The one-result form with a BOXED-ENUM target (#6017): panics on a mismatch
// the same way `lowerIfaceAssertOne` does for an INTERFACE target — there is
// no `bit_rt_iface_assert_enum` (ABI.md §2.2a), since the panic needs the
// write path only `../{darwin,linux}/io.bit` reaches, exactly the reason
// `lowerIfaceAssertOne` already builds its own panic block here instead of a
// second runtime entry point.
fn lowerEnumAssertOne(fc: FnCtx, recv: int, ty: int, info: int): int {
  let av = mkInstr(Op.RtCall, ty)
  av.name = "iface_as_enum"
  av.args = [recv, info]
  let v = emitRtCall(fc, av)
  let cond = assertOk(fc, v, ty)
  let bad = builderNewBlock(fc.b)
  let ok = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = ok
  br.ival2 = bad
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, bad)
  emitIfaceAssertPanic(fc, ty)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, ok)
  return v
}

// The one-result form with an INTERFACE target: narrow, then panic where the
// narrowing missed. `bit_rt_iface_assert` cannot serve — it compares against
// ONE descriptor, and "satisfies `I`" is not one type — so the panic is emitted
// here instead, reaching the same `bit_rt_panic` (exit 2, §18.4) and opening
// with the same "type assertion failed:" the runtime's own message does
// (`ifaceAssertWrite`, runtime/root/{darwin,linux}/io.bit). It cannot name the
// dynamic type the way that message does: the check is a method-set test, so
// there is no descriptor in hand to read a name out of.
fn lowerIfaceAssertOne(fc: FnCtx, recv: int, iface: int): int {
  let v = lowerIfaceNarrow(fc, recv, iface, ifaceAssertMethodIds(fc, iface))
  let cond = assertOk(fc, v, iface)
  let bad = builderNewBlock(fc.b)
  let ok = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = ok
  br.ival2 = bad
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, bad)
  emitIfaceAssertPanic(fc, iface)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, ok)
  return v
}

// The panic block of `lowerIfaceAssertOne`, out of line so that function stays
// one straight read.
fn emitIfaceAssertPanic(fc: FnCtx, iface: int) {
  let msg = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  msg.sval = "type assertion failed: the dynamic type does not satisfy ${typeName(fc.c.ctx, iface)}"
  msg.ival = internPoolString(fc, msg.sval)
  let pn = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  pn.name = "panic"
  pn.args = [builderEmit(fc.b, msg)]
  emitRtCall(fc, pn)
  builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
}

// The `ok` of an assertion whose runtime call returned `v`: `v != nil`.
// `bit_rt_iface_as`, `bit_rt_iface_as_enum` and `bit_rt_iface_has` (ABI.md
// §2.2/§2.2a) return the receiver on a hit and null on a miss, and a nil
// receiver has no dynamic type, so it always misses: the result IS the flag.
// Reading it here instead of calling `bit_rt_iface_as_ok` saves a per-task
// scratch lookup per assertion (#7408); that entry point stays for code the
// pinned stage0 built. Any new assertion form (#7406's interface-to-interface
// one included) takes its `ok` through here, off the raw result, before a miss
// is replaced by a zero value.
fn assertOk(fc: FnCtx, v: int, ty: int): int {
  return neNil(fc, v, ty)
}

// The two-result form `(v, ok) = iface.(T)`, dispatched from `lowerTwoResult`
// (lowertuple.bit), which owns the OTHER two-result forms.
fn lowerTypeAssertTwo(fc: FnCtx, node: int, valTy: int): []int {
  let recv = lowerExpr(fc, kidsOf(fc.c.tree, node)[0])
  if (fc.failed) {
    return []int(0)
  }
  if (fc.c.ctx.types[valTy].kind == TypeKind.Interface) {
    return lowerIfaceAssertTwo(fc, recv, valTy)
  }
  let info = lowerTypeInfo(fc, valTy, getNode(fc.c.tree, node).span)
  if (fc.failed) {
    return []int(0)
  }
  let av = mkInstr(Op.RtCall, valTy)
  av.name = "iface_as"
  if (fc.c.ctx.types[valTy].kind == TypeKind.Enum) {
    // A boxed enum's object size varies per variant (§14.7), so the
    // class-path's descriptor-pointer identity does not hold — `iface_as_enum`
    // compares the descriptors' `type_id` word instead (ABI.md §2.2a).
    av.name = "iface_as_enum"
  }
  av.args = [recv, info]
  let v = emitRtCall(fc, av)
  let ok = assertOk(fc, v, valTy)
  // `ok` is taken off the raw result BEFORE a mismatch (§14.4) is replaced by
  // the live zero object of a class or boxed enum (#5910) — the only concrete
  // targets a checked assertion can name (`vStorableInInterface`) — so that
  // zero object never reads as a hit.
  if (zeroIsLiveRecord(fc, valTy)) {
    v = emitZeroOnNil(fc, valTy, v, getNode(fc.c.tree, node).span)
    if (fc.failed) {
      return []int(0)
    }
  }
  return [v, ok]
}

// The two-result form with an INTERFACE target. On `!ok` the value is already
// nil, which is exactly the `(nil, false)` §14.4 requires of a mismatch.
//
// With no method to test there is no call and `v` is the receiver: every value
// carrying a dynamic type satisfies an empty method set, and an interface value
// is either nil or a class instance (`vStorableInInterface`,
// validateassignable.bit), so the same null test is still `ok`.
fn lowerIfaceAssertTwo(fc: FnCtx, recv: int, valTy: int): []int {
  let v = lowerIfaceNarrow(fc, recv, valTy, ifaceAssertMethodIds(fc, valTy))
  return [v, assertOk(fc, v, valTy)]
}
