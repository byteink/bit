// In-Bit self-checks for the ar archive reader and writer. Split out of
// selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

// Stage 3 (#1344) the ar archive reader. Ports the seed's tests: a hand-built
// System V archive with a long-name member, and a BSD one in the exact shape
// macOS `ar` produces.

function arAppendStr(b: ByteBuf, s: string) {
  appendBytes(b, []byte(s))
}

// One 60-byte ar header: a 16-byte name field, then fixed-width fields padded
// with spaces, a decimal size at 48, and the "`\n" magic at 58.
function arAppendHeader(b: ByteBuf, name: string, size: int) {
  let start = len(b.bytes)
  let i = 0
  while (i < arHeaderLen()) {
    b.bytes = append(b.bytes, u8(32)) // space-filled
    i = i + 1
  }
  let nb = []byte(name)
  i = 0
  while (i < len(nb)) {
    b.bytes[start + i] = nb[i]
    i = i + 1
  }
  let sb = []byte("${size}")
  i = 0
  while (i < len(sb)) {
    b.bytes[start + 48 + i] = sb[i]
    i = i + 1
  }
  b.bytes[start + 58] = u8(96)  // `
  b.bytes[start + 59] = u8(10)  // \n
}

// One BSD "#1/<len>" member: the name is a null-padded prefix of the member's
// own data (padded to 4 bytes, which exercises the NUL trim), then the content.
function arAppendBsdMember(b: ByteBuf, name: string, content: string) {
  let nameField = alignForward(len([]byte(name)), 4)
  arAppendHeader(b, "#1/${nameField}", nameField + len([]byte(content)))
  arAppendStr(b, name)
  appendZeros(b, nameField - len([]byte(name)))
  arAppendStr(b, content)
  if (len(b.bytes) % 2 == 1) {
    b.bytes = append(b.bytes, u8(10))
  }
}

// The message parseArchive failed with, or "" if it succeeded.
function arErr(bytes: []u8): string {
  let msg = ""
  let m = parseArchive(bytes) catch e {
    msg = e.message()
    []ArMember(0)
  }
  return msg
}

function checkArchiveSysV() {
  // Symbol table (empty, ignored), a long-name table with one name, one member
  // using it, and one GNU short-name member.
  let b = newByteBuf()
  arAppendStr(b, arMagic())
  arAppendHeader(b, "/", 0)

  let longName = "a_very_long_member_name.o"
  // Real GNU ar terminates each long name with a slash before the newline —
  // verified against this repo's own libbitrt.a, whose table reads
  // ".zig-cache/o/<hash>/libbitrt_zcu.o/\n". Without the slash here the strip
  // is never exercised.
  let table = "${longName}/\n"
  arAppendHeader(b, "//", len([]byte(table)))
  arAppendStr(b, table)
  if (len(b.bytes) % 2 == 1) {
    b.bytes = append(b.bytes, u8(10)) // ar pads each member to an even offset
  }

  arAppendHeader(b, "/0", 5)
  arAppendStr(b, "hello")
  b.bytes = append(b.bytes, u8(10)) // odd-length padding

  arAppendHeader(b, "short.o/", 3)
  arAppendStr(b, "abc")

  assert(arErr(b.bytes) == "")
  let ms = parseArchive(b.bytes) catch e { []ArMember(0) }
  // The `/` and `//` special members are skipped, not returned.
  assert(len(ms) == 2)
  assert(ms[0].name == longName) // resolved through the long-name table
  assert(string(ms[0].data) == "hello")
  assert(ms[1].name == "short.o") // GNU trailing slash stripped
  assert(string(ms[1].data) == "abc")
}

function checkArchiveBsd() {
  // The exact shape macOS ar / Zig-for-macho produces: a BSD symbol-table member
  // named __.SYMDEF (must be skipped) then one real object whose name is a
  // null-padded prefix of its own data (must be stripped off the content).
  let b = newByteBuf()
  arAppendStr(b, arMagic())
  arAppendBsdMember(b, "__.SYMDEF", "INDEX-BYTES")
  arAppendBsdMember(b, "libbitrt_zcu.o", "MACHOCONTENT")

  let ms = parseArchive(b.bytes) catch e { []ArMember(0) }
  assert(len(ms) == 1)
  assert(ms[0].name == "libbitrt_zcu.o")
  assert(string(ms[0].data) == "MACHOCONTENT")
}

// #1398 the archive WRITER: whatever goes in comes back out through the reader,
// names and payloads byte-identical, in both name encodings. A long name, an
// odd-length payload (which forces the `\n` even-offset padding) and an empty
// member are each present because each is a distinct failure mode.
function arRoundTrip(format: int, members: []ArMember) {
  let back = parseArchive(writeArchive(members, format)) catch e { []ArMember(0) }
  assert(len(back) == len(members))
  let i = 0
  while (i < len(members)) {
    assert(back[i].name == members[i].name)
    assert(string(back[i].data) == string(members[i].data))
    i = i + 1
  }
}

function checkArchiveWriter() {
  let members = [ArMember{ name: "short.o", data: []byte("abc") },
    ArMember{ name: "a_very_long_member_name_over_15_bytes.o", data: []byte("hello") },
    ArMember{ name: "empty.o", data: []u8(0) },
    ArMember{ name: "exactly_15chars", data: []byte("wxyz") }]
  arRoundTrip(arFormatGnu(), members)
  arRoundTrip(arFormatBsd(), members)

  // The magic, and no symbol-table member: with no long names the first header
  // is the real member's, with no `/` index and no `//` table before it.
  let one = writeArchive([ArMember{ name: "a.o", data: []byte("x") }], arFormatGnu())
  assert(arBytesEq(one, 0, arMagic()))
  let hdr = len([]byte(arMagic()))
  assert(arTrimEnd(string(one[hdr:hdr + 16]), u8(32)) == "a.o/")

  // Header field layout, against what `ar` writes: a BSD name padded to 4
  // (14 -> 16), zeroed ownership fields, and the size covering name + data.
  let bsd = writeArchive([ArMember{ name: "libbitrt_zcu.o", data: []byte("MACHO") }], arFormatBsd())
  assert(arTrimEnd(string(bsd[hdr:hdr + 16]), u8(32)) == "#1/16")
  assert(arTrimEnd(string(bsd[hdr + 16:hdr + 28]), u8(32)) == "0")   // mtime
  assert(arTrimEnd(string(bsd[hdr + 28:hdr + 34]), u8(32)) == "0")   // uid
  assert(arTrimEnd(string(bsd[hdr + 34:hdr + 40]), u8(32)) == "0")   // gid
  assert(arTrimEnd(string(bsd[hdr + 40:hdr + 48]), u8(32)) == "0")   // mode
  assert(arTrimEnd(string(bsd[hdr + 48:hdr + 58]), u8(32)) == "21")  // 16 name + 5 data
  assert(string(bsd[hdr + 58:hdr + 60]) == "`\n")

  // GNU members carry mode 644, the convention `./make libbitrt` also writes.
  let gnu = writeArchive([ArMember{ name: "a.o", data: []byte("x") }], arFormatGnu())
  assert(arTrimEnd(string(gnu[hdr + 40:hdr + 48]), u8(32)) == "644")

  // Every header starts at an even offset: the second member here follows an
  // odd-length payload, so it is only reachable if the `\n` filler was written.
  let two = writeArchive([ArMember{ name: "odd.o", data: []byte("abc") },
    ArMember{ name: "next.o", data: []byte("de") }], arFormatGnu())
  let second = hdr + arHeaderLen() + 3 + 1
  assert(second % 2 == 0)
  assert(arTrimEnd(string(two[second:second + 16]), u8(32)) == "next.o/")
}

function checkArchiveRejects() {
  assert(arErr([]byte("not an archive")) == "BadMagic")
  assert(arErr([]u8(0)) == "BadMagic")

  // A header that does not end in the "`\n" magic.
  let b = newByteBuf()
  arAppendStr(b, arMagic())
  arAppendHeader(b, "x.o/", 0)
  b.bytes[len([]byte(arMagic())) + 58] = u8(88) // clobber the '`'
  assert(arErr(b.bytes) == "BadHeader")

  // A member whose declared size runs past the end of the file.
  let b2 = newByteBuf()
  arAppendStr(b2, arMagic())
  arAppendHeader(b2, "x.o/", 999)
  arAppendStr(b2, "short")
  assert(arErr(b2.bytes) == "TruncatedArchive")

  // A header cut off mid-way.
  let b3 = newByteBuf()
  arAppendStr(b3, arMagic())
  arAppendStr(b3, "junk")
  assert(arErr(b3.bytes) == "TruncatedArchive")

  // A non-decimal size field: a silent 0 would truncate the member.
  let b4 = newByteBuf()
  arAppendStr(b4, arMagic())
  arAppendHeader(b4, "x.o/", 0)
  b4.bytes[len([]byte(arMagic())) + 48] = u8(122) // 'z' in the size field
  assert(arErr(b4.bytes) == "BadHeader")

  // A long-name offset past the end of the `//` table.
  let b5 = newByteBuf()
  arAppendStr(b5, arMagic())
  arAppendHeader(b5, "//", 4)
  arAppendStr(b5, "abc\n")
  arAppendHeader(b5, "/99", 1)
  arAppendStr(b5, "x")
  assert(arErr(b5.bytes) == "BadLongName")
}

// SPEC §11.7 / E0078: `archiveDefines` decides the archive half of whether an
// `extern function` is admissible on a Linux target — `externResolvable` ORs
// this with a §11.9 pin for the other half. Mirrors the seed's
// `link.archiveDefines` tests.
//
// Built from a SYNTHETIC archive rather than the real libbitrt.a: this way the
// test depends on no filesystem path and no build ordering, and — more to the
// point — it can state the discriminating case, which a real archive cannot.
// That case is the third one below: a member that only REFERENCES a symbol must
// not count as defining it. Resolution keys on defining ATOMS, and an undefined
// reference never becomes one; a predicate that scanned the symbol table naively
// would answer "defined" for a caller and admit an extern the link then cannot
// resolve.
function checkArchiveDefines() {
  // A member that DEFINES `bit_rt_probe`.
  let definer = ElfObject{
    sections: [ElfSection{ kind: ElfSectionKind.Text, data: []u8(8), size: 0,
      alignment: 4 }],
    symbols: [
      ElfSymbol{ name: "bit_rt_probe", hasSection: true,
        section: ElfSectionKind.Text, offset: 0, size: 8,
        binding: ElfBinding.Global, kind: ElfSymKind.Func }],
    relocations: []ElfRelocation(0) }

  // A member that merely CALLS `bit_rt_absent` — an undefined external, not a
  // definition. `hasSection: false` is what makes the symbol undefined.
  let caller = ElfObject{
    sections: [ElfSection{ kind: ElfSectionKind.Text, data: []u8(8), size: 0,
      alignment: 4 }],
    symbols: [
      ElfSymbol{ name: "caller", hasSection: true, section: ElfSectionKind.Text,
        offset: 0, size: 8, binding: ElfBinding.Global, kind: ElfSymKind.Func },
      ElfSymbol{ name: "bit_rt_absent", hasSection: false,
        section: ElfSectionKind.Text, offset: 0, size: 0,
        binding: ElfBinding.Global, kind: ElfSymKind.Notype }],
    relocations: []ElfRelocation(0) }

  // A local definition, which is invisible outside its own member and so must
  // not satisfy an extern either.
  let localOnly = ElfObject{
    sections: [ElfSection{ kind: ElfSectionKind.Text, data: []u8(8), size: 0,
      alignment: 4 }],
    symbols: [
      ElfSymbol{ name: "bit_rt_local", hasSection: true,
        section: ElfSectionKind.Text, offset: 0, size: 8,
        binding: ElfBinding.Local, kind: ElfSymKind.Func }],
    relocations: []ElfRelocation(0) }

  let t = ElfTarget.X86_64
  let ar = writeArchive([
    ArMember{ name: "definer.o", data: elfBytes(t, definer) },
    ArMember{ name: "caller.o", data: elfBytes(t, caller) },
    ArMember{ name: "localonly.o", data: elfBytes(t, localOnly) }], arFormatGnu())

  let lt = ElfLinkTarget.X86_64Linux
  // Defined by a member: admissible.
  assert(archiveDefines(lt, ar, "bit_rt_probe"))
  // Only referenced: NOT admissible. The whole point of the test.
  assert(!archiveDefines(lt, ar, "bit_rt_absent"))
  // Locally defined: not visible to the link, so NOT admissible.
  assert(!archiveDefines(lt, ar, "bit_rt_local"))
  // Present nowhere at all.
  assert(!archiveDefines(lt, ar, "bit_rt_no_such_symbol_exists_anywhere"))
  // Undecidable inputs answer false, never accept: the caller's only sound
  // response to "unknown" is to reject. That answer is for a LINK whose archive
  // could not be read; `--emit-obj` performs no link and no longer asks (#1645).
  assert(!archiveDefines(lt, []u8(0), "bit_rt_probe"))
  assert(!archiveDefines(lt, []byte("not an ar archive at all"), "bit_rt_probe"))
}
