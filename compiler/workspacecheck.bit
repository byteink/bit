// #6491: in-Bit self-checks for the package workspace (workspace.bit). Sibling
// .bit files are the same module, so `selfcheck()` calls these directly.
// `std/os` has no `setEnv`, so `BIT_WORKSPACE=off|verbose` and its refusal of
// any other value are proved through the CLI instead (the ticket's mutation),
// not here; these run with it unset.

const wsCheckUrl: string = "https://example.org/m.git"
const wsCheckCommit: string = "0123456789abcdef0123456789abcdef01234567"

// Writes `<dir>/<name>`, naming the file when it fails.
fn wsCheckWrite(path: string, text: string) {
  writeFile(path, text) catch e {
    panic("workspacecheck: cannot write ${path}: ${e.message()}")
  }
}

// A project directory `<root>/<where>/proj` that imports "m", locked to a
// RELEASED-looking entry (a vanity, a url and a commit that would need the
// cache or the network) — exactly what `pkg/auth`'s `bit.lock` holds for web.
fn wsCheckProject(root: string, where: string): string {
  let proj = "${root}/${where}/proj"
  pmCheckMkdirAll(proj)
  wsCheckWrite(
    proj + "/main.bit",
    "import { greet } from \"m\"\nfn main() {\n  print(greet())\n}\n",
  )
  wsCheckWrite(proj + "/bit.json", "{\"dependencies\": {\"m\": \"example.org/pkg/m@^1.0.0\"}}\n")
  writeLock(
    proj + "/bit.lock",
    [
      LockEntry{
        name = "m", vanity = "example.org/pkg/m", url = wsCheckUrl, commit = wsCheckCommit,
        version = "1.0.0", requires = []LockRequire(0),
      },
    ],
  ) catch e {
    panic("workspacecheck: writeLock failed: ${e.message()}")
  }
  return proj
}

// Inside a `bit.work` tree the released-looking entry resolves to the member
// directory in the tree, `bit.lock` is byte-identical afterwards, the entry's
// locked `commit`/`version` are untouched, and a project outside the tree
// keeps the released entry.
fn checkWorkspaceResolvesMemberFromTree() {
  let root = pmCheckScratchDir()
  let ws = root + "/ws"
  pmCheckMkdirAll(ws + "/m")
  wsCheckWrite(ws + "/bit.work", "{\"members\": {\"example.org/pkg/m\": \"m\"}}\n")
  wsCheckWrite(ws + "/m/greet.bit", "export fn greet(): string {\n  return \"from the tree\"\n}\n")
  let proj = wsCheckProject(root, "ws")
  let lockBefore = readFile(proj + "/bit.lock") catch e {
    panic("workspacecheck: ${e.message()}")
  }

  let p = loadProjectOverlay(proj, "", "", map<string, string>{})
  resolveProject(p)
  assert(!hasErrors(p.diags))
  let (modId, has) = p.mods[p.root].imports["m"]
  assert(has && modId >= 0)
  assert(p.mods[modId].dir == pathResolve(ws + "/m"))

  let (entries, err) = loadLockEntries(proj)
  assert(err == "")
  assert(entries["m"].localPath == pathResolve(ws + "/m"))
  assert(entries["m"].commit == wsCheckCommit && entries["m"].version == "1.0.0")
  let lockAfter = readFile(proj + "/bit.lock") catch e {
    panic("workspacecheck: ${e.message()}")
  }
  assert(lockAfter == lockBefore)
  assert(manifestLockProblem(proj, entries, err) == "")

  let outside = wsCheckProject(root, "outside")
  let (outEntries, outErr) = loadLockEntries(outside)
  assert(outErr == "")
  assert(outEntries["m"].localPath == "")

  removeTree(root, pmCheckTimeoutMs)
}

// A developer mistake in `bit.work` is an error everywhere the manifest is
// checked, not a silent fall back to the released tag: a member naming a
// directory that does not exist, and a file that is not the expected shape.
fn checkWorkspaceRefusesBrokenFile() {
  let root = pmCheckScratchDir()
  let ws = root + "/ws"
  pmCheckMkdirAll(ws)
  wsCheckWrite(ws + "/bit.work", "{\"members\": {\"example.org/pkg/m\": \"gone\"}}\n")
  let proj = wsCheckProject(root, "ws")

  let (_, err) = loadLockEntries(proj)
  assert(
    pkgTestContains(
      err,
      "member \"example.org/pkg/m\" names directory \"gone\", which does not exist",
    ),
  )
  assert(manifestLockProblem(proj, map<string, LockEntry>{}, "") == err)

  wsCheckWrite(ws + "/bit.work", "{\"members\": [")
  let (_, malformed) = loadLockEntries(proj)
  assert(pkgTestContains(malformed, "malformed JSON"))

  wsCheckWrite(ws + "/bit.work", "{\"use\": {}}")
  let (_, noMembers) = loadLockEntries(proj)
  assert(pkgTestContains(noMembers, "missing \"members\" object"))

  removeTree(root, pmCheckTimeoutMs)
}
