// Self-host Stage 2 (#1339): optimizer passes.
// Runs immediately before codegen; `bit2 --dump-ir` renders the result and must
// byte-match the seed's optimized `bit --dump-ir`.
//
// ## Rebuild, don't mutate
//
// `IrFunc`'s core invariant — instruction index == value id, and each block's
// instructions are contiguous in emission order — makes deleting an instruction
// in place illegal: it would shift every later index and silently corrupt every
// operand reference that follows. Every pass instead REBUILDS the function
// through the lowering builder, walking the old function once (already
// def-before-use) and translating each surviving value through an old-index ->
// new-id `remap` table, exactly the construction lower.bit itself uses.
//
// ## Passes
//
// - `foldConstantsAndPrune`: one forward sweep records each value's
//   compile-time constant (propagating through folded arithmetic/compares);
//   `propagateBlockParams` (optparams.bit) then adds the one fact that sweep
//   cannot see, a block param whose every predecessor edge passes the same
//   constant; `forwardFieldLoads` (optstore.bit) records which `field_get`
//   reloads a slot a `field_set` just wrote in the same block; a bounded BFS
//   uses constant branch conditions to find the reachable blocks; the rebuild
//   reserves only reachable blocks and turns a resolved `br` into a plain
//   `jump`. Folding, propagation, store-to-load forwarding, and dead-branch/
//   dead-block pruning all fall out of the one rebuild.
// - `proveInductionBounds` (optbce.bit) rides the same rebuild: an
//   `icmp_ult(i, len)` whose block is dominated by a `while (i < len)` header
//   test, with `i` proven non-negative, is recorded in `known` as `true` — so
//   the bounds `br` collapses to a `jump` and its panic block is pruned.
//
// Every pass is one bounded walk over already-known-size arrays. The one
// alternation is `propagateBlockParams`' mark/re-sweep round, and its ceiling
// is static: `known` only ever gains entries and the sweep never writes a param
// slot, so a productive round always marks at least one of the fewer-than-
// len(instrs) params.
//
// The inliner's splice is the one recursive step, and it recurses only into a
// callee body, bounded by maxInlineDepth() (#3163) — a depth limit
// rather than a fixpoint precisely because a recursive call graph has neither a
// callee-first order nor a fixpoint to converge on.

// The constant map for `f`: one forward sweep, then the two facts the sweep
// structurally cannot see — a `field_get %h[16]` on a slice header whose `off`
// is provably zero (`markZeroOffLoads`, optzerooff.bit), and a block param whose
// every predecessor edge passes the same constant (`propagateBlockParams`).
//
// THE ORDER OF THE LAST TWO IS LOAD-BEARING. `markZeroOffLoads` runs FIRST so
// that a zero `off` reaching its use through a block param — which is how every
// LICM-hoisted header word arrives, and how matrix's three slices reach their
// index sites — is a constant by the time `propagateBlockParams` walks the
// edges that carry it. Reversed, the fold would land one whole
// `foldConstantsAndPrune` round late and the second round is the last one there
// is.
fn analyzeConsts(ctx: TypeContext, f: IrFunc): []ConstVal {
  let known = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    known = append(known, noConst())
    i = i + 1
  }
  sweepConsts(ctx, f, known)
  markZeroOffLoads(ctx, f, known)
  propagateBlockParams(ctx, f, known)
  return known
}

// Single forward sweep over every instruction: records each constant literal,
// then folds each binary/unary op whose operands are already known — cascading
// propagation for free, since the flat order guarantees an operand's def index
// is always less than its use's.
//
// Refines `known` in place and never clears an entry, so re-running it after
// `propagateBlockParams` has marked a param constant only ever adds facts. It
// writes only to indices whose op is a const literal, an arith/compare, or one
// of the three unary ops — never to a `block_param` slot, which is what makes
// the alternation terminate.
fn sweepConsts(ctx: TypeContext, f: IrFunc, known: []ConstVal) {
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    let op = ins.op
    if (op == Op.ConstInt) {
      known[i] = intConst(ins.ival)
    } else if (op == Op.ConstFloat) {
      known[i] = floatConst(ins.fval)
    } else if (op == Op.ConstBool) {
      known[i] = boolConst(ins.bval)
    } else if (opIsArith(op) || opIsCompare(op)) {
      let lv = known[ins.lhs]
      let rv = known[ins.rhs]
      if (lv.known && rv.known) {
        if (opIsCompare(op)) {
          known[i] = foldCompare(ctx, op, f.instrs[ins.lhs].ty, lv, rv)
        } else {
          known[i] = foldBinaryArith(ctx, op, ins.ty, lv, rv)
        }
      }
    } else if (op == Op.Neg || op == Op.FNeg || op == Op.BNot) {
      let v = known[ins.lhs]
      if (v.known) {
        known[i] = foldUnary(ctx, op, ins.ty, v)
      }
    }
    i = i + 1
  }
}

// Bounded BFS from the entry block (the worklist is sized to the block count and
// each block is enqueued at most once). A `br` whose condition folded to a known
// constant only follows the taken edge — this is what prunes an unreachable
// branch's whole block, not just its instructions.
fn computeReachable(f: IrFunc, known: []ConstVal): []bool {
  let n = len(f.blocks)
  let reachable = []bool(0)
  let i = 0
  while (i < n) {
    reachable = append(reachable, false)
    i = i + 1
  }
  if (n == 0) {
    return reachable
  }
  // The entry block is block 0 (lowering opens it first, so it starts at 0).
  let queue = [0]
  reachable[0] = true
  let head = 0
  while (head < len(queue)) {
    let b = f.blocks[queue[head]]
    head = head + 1
    // AN EMPTY BLOCK HAS NO TERMINATOR, so `instsStart + instsLen - 1` names the
    // instruction BEFORE the block — index -1 for block 0, which is how #2084
    // segfaulted. Lowering no longer produces one (see lowerfunc.bit), but DCE
    // can still empty a block it keeps, and reading out of bounds is the wrong
    // way to find out. A block with nothing in it branches nowhere.
    if (b.instsLen == 0) {
      continue
    }
    let term = f.instrs[b.instsStart + b.instsLen - 1]
    if (term.op == Op.Jump) {
      if (!reachable[term.ival]) {
        reachable[term.ival] = true
        queue = append(queue, term.ival)
      }
    } else if (term.op == Op.Br) {
      let cond = known[term.lhs]
      if (cond.known) {
        let target = term.ival2
        if (cond.bval) {
          target = term.ival
        }
        if (!reachable[target]) {
          reachable[target] = true
          queue = append(queue, target)
        }
      } else {
        if (!reachable[term.ival]) {
          reachable[term.ival] = true
          queue = append(queue, term.ival)
        }
        if (!reachable[term.ival2]) {
          reachable[term.ival2] = true
          queue = append(queue, term.ival2)
        }
      }
    }
  }
  return reachable
}

// Ops that can trap, allocate, or write observable state — never dead, and the
// roots of the liveness sweep along with terminators and block params. `index_get`
// is included: its bounds check can panic.
// The four ops that transfer control to another function. Grouped rather than
// spelled out at each site: three separate `||` chains listed them, and the
// #4405 opcode addition pushed two of those chains past the complexity ceiling
// precisely because a per-opcode table written as a chain grows with the enum.
fn opIsCall(op: Op): bool {
  return op == Op.Call || op == Op.CallValue || op == Op.CallIface || op == Op.RtCall
}

// The ops whose value operands are ALL of `args`, with nothing in `lhs`/`rhs`.
// Read by `instrOperands` here and by `extendUses` (codegenlive.bit), which had
// the identical list written out twice — the copy this repo keeps paying for.
//
// `Op.Jump` is in the set: its block arguments really are its operands. The
// liveness reader handles Jump BEFORE consulting this (#2934 extends a jump's
// arguments separately, gated on whether the receiving parameter is live), so
// including it here changes nothing there.
fn opUsesArgs(op: Op): bool {
  return op == Op.Jump ||
    op == Op.Ret ||
    op == Op.Call ||
    op == Op.RtCall ||
    op == Op.Asm ||
    op == Op.CallWord
}

fn isSideEffecting(op: Op): bool {
  return opIsCall(op) ||
    op == Op.FieldSet ||
    op == Op.IndexSet ||
    op == Op.IndexGet ||
    op == Op.GcAlloc ||
    op == Op.MakeClosure ||
    op == Op.SDiv ||
    op == Op.UDiv ||
    op == Op.SRem ||
    op == Op.URem ||
    opIsAtomic(op) ||
    op == Op.Asm ||
    // A syscall's effect is the kernel's, entirely outside this module's view —
    // never drop or deduplicate it, even with the result unused.
    op == Op.Syscall ||
    // #4457: a read of MUTABLE runtime state (the attention word). Not pure:
    // deduplicating two of them, or hoisting one out of the loop that re-reads
    // it, would freeze the answer for the whole loop -- which is exactly the
    // latency the poll exists to bound. `stripMine` is the only producer and
    // runs after every pass here, so this is a guard against a future one.
    op == Op.PollAttention ||
    // #4405: a word of a multi-register call result. Not a side effect — it is
    // one indivisible call result spread over W instruction slots, and DROPPING
    // ONE WORD IS UNRECOVERABLE: a discarded word still consumes its class's
    // return-register ordinal (bindCallResults' own rule), so deleting the
    // middle word of a run would slide every later word into the wrong
    // register. Kept for the same "must never be dropped" reason the atomics
    // and the syscall are here, rather than for a memory effect.
    op == Op.CallWord ||
    opIsTerminator(op)
}

// Whether anything emitted into `b.instrs[lo:hi)` could have reached a
// SAFEPOINT — a conservative "did the collector possibly run in this window",
// for a caller holding a raw GC-managed address in an `i64` that no stack map
// describes (`fillSliceLitElems`, lowerlit.bit).
//
// The test is `isSideEffecting` itself rather than a hand-kept list of the ops
// that call or allocate, which is optcse.bit's rule 3: an op added later that
// calls or allocates must join that set or DCE would already be deleting it,
// so it becomes a barrier here the day it lands. It over-reports on a raw
// store and on a trapping op that cannot return, and over-reporting costs one
// reload rather than correctness.
fn emittedSafepointIn(b: IrBuilder, lo: int, hi: int): bool {
  let i = lo
  while (i < hi) {
    if (isSideEffecting(b.instrs[i].op)) {
      return true
    }
    i = i + 1
  }
  return false
}

// The four ops a `--debug` build gives an overflow trap the IR does not
// otherwise carry (arm64select.bit's `cx.debug && w.signed`, and the x64
// twin). Refused WHOLE rather than only when signed — signedness is a
// property of the operand WIDTH, not the op. Also called directly from
// `optloopcand.bit`'s `licmHoistable` (#4290), same module, no import needed.
fn opTrapsOnOverflow(op: Op): bool {
  return op == Op.Add || op == Op.Sub || op == Op.Mul || op == Op.Neg
}

// `isSideEffecting` plus the four ops above when `debug`: what `computeLive`
// needs so `deadCodeElim` keeps an overflow-checked instruction alive even
// when its value is never read (#4220) — the DCE twin of `licmHoistable`'s
// `lc.debug && opTrapsOnOverflow` guard.
fn isSideEffectingDebug(op: Op, debug: bool): bool {
  return isSideEffecting(op) || (debug && opTrapsOnOverflow(op))
}

// The atomic ops (§11.5): they touch shared memory and must never be dropped,
// hoisted, or deduplicated even when their result is unused.
fn opIsAtomic(op: Op): bool {
  return op == Op.AtomicLoad || op == Op.AtomicStore || op == Op.AtomicCmpxchg || opIsAtomicRmw(op)
}

fn opIsAtomicRmw(op: Op): bool {
  return op == Op.AtomicRmwAdd ||
    op == Op.AtomicRmwSub ||
    op == Op.AtomicRmwAnd ||
    op == Op.AtomicRmwOr ||
    op == Op.AtomicRmwXchg
}

fn opIsTerminator(op: Op): bool {
  return op == Op.Jump || op == Op.Br || op == Op.Ret || op == Op.Unreachable
}

// `dst` with every element of `src` appended. `append` takes ONE element, so
// `append(dst, src)` stores the slice HEADER as an int — which reads back as a
// wild value id in the tens of billions, not as a type error. That is exactly
// what the first version of `instrOperands` did, and the verifier's own output
// is what caught it.
fn concatIds(dst: []int, src: []int): []int {
  let out = dst
  for v of src {
    // bit:lint allow E0214 -- concatIds has 2 call sites (opt.bit:311,314), each inside a return statement passing either a fresh array literal ([ins.lhs]) or the unnamed result of a nested concatIds call; neither is ever bound to a variable, so nothing can read a pre-call copy
    out = append(out, v)
  }
  return out
}

// THE OPERAND MAP: the value ids instruction `id` READS, in no particular order.
// Consts, block params, gc_alloc, type_info, func_addr and global_addr read
// nothing — their payloads are immediates, not values.
//
// One table, two consumers: dead-code elimination below, and `verifyIrFunc`
// (verify.bit, #1925). It used to be inlined into `markOperandsLive` alone, and
// the verifier would have needed a second copy of the same per-opcode table —
// which is how two tables come to disagree, and a disagreement here is either a
// DCE pass that deletes a live value or a verifier that misses a real violation.
//
// `ival` is a VALUE only for IndexSet's stored element and AtomicCmpxchg's
// desired; everywhere else it is an offset, a block id or a pool index. `lhs`
// and `rhs` are likewise left 0 on the ops not listed here, and 0 is a
// perfectly valid value id. That is why this is a per-opcode table and not a
// blanket sweep of every field: a blanket sweep would name whatever instruction
// happens to sit at index 0 as an operand of half the program.
fn instrOperands(f: IrFunc, id: int): []int {
  let ins = f.instrs[id]
  let op = ins.op
  if (opIsBinary(op)) {
    return [ins.lhs, ins.rhs]
  }
  if (op == Op.Neg ||
    op == Op.FNeg ||
    op == Op.BNot ||
    op == Op.Convert ||
    op == Op.FSqrt ||
    op == Op.Bitcast ||
    op == Op.FFloor ||
    op == Op.FCeil ||
    op == Op.FTrunc ||
    op == Op.FRound ||
    op == Op.FieldGet ||
    op == Op.SliceLen ||
    op == Op.MakeClosure ||
    op == Op.AtomicLoad) {
    return [ins.lhs]
  }
  if (opUsesArgs(op)) {
    return ins.args
  }
  // §11.8: `lhs` is the syscall number, `args` its 0..6 arguments.
  if (op == Op.Syscall || op == Op.CallValue || op == Op.CallIface) {
    return concatIds([ins.lhs], ins.args)
  }
  if (op == Op.Br) {
    return concatIds(concatIds([ins.lhs], ins.thenArgs), ins.elseArgs)
  }
  // Atomics: `lhs`=ptr always; store/rmw also read `rhs`; cmpxchg's `desired`
  // rides in `ival`.
  if (op == Op.FieldSet || op == Op.IndexGet || op == Op.AtomicStore || opIsAtomicRmw(op)) {
    return [ins.lhs, ins.rhs]
  }
  if (op == Op.IndexSet || op == Op.AtomicCmpxchg) {
    return [ins.lhs, ins.rhs, ins.ival]
  }
  return []int(0)
}

// Marks every value `id` reads as live.
fn markOperandsLive(f: IrFunc, live: []bool, id: int) {
  markListLive(live, instrOperands(f, id))
}

fn markListLive(live: []bool, ids: []int) {
  let i = 0
  while (i < len(ids)) {
    live[ids[i]] = true
    i = i + 1
  }
}

// One backward sweep marks every value transitively reachable from a root
// (side-effecting instruction, terminator, or block param) live. Correct in a
// single descending pass because every operand's def index is always less than
// its use's, so by the time the sweep reaches a definition every later
// instruction that could mark it live has already run.
//
// `dead` (optalloc.bit) is the one input that can unseat a side-effecting root:
// the instructions of an allocation proven unobservable. They are skipped
// rather than marked, so they neither survive nor keep their operands alive —
// a store into a dead object is the only reader of the value it stored, and
// that value must be free to die with it. Pass `noDeadAllocs(len(f.instrs))`
// for the plain sweep.
//
// `debug` widens the root set via `isSideEffectingDebug` (#4220): an unread
// `add`/`sub`/`mul`/`neg` still carries a backend-invented overflow trap.
// #4406: marks every value `id` must not outlive (`IrFunc.keepAlive`). Returns
// whether it marked one the descending sweep has ALREADY walked past — the only
// case that needs another round, since a lower index will be visited anyway.
//
// A base word usually sits at a HIGHER index than the interior word it roots
// (word 0 is the call or the first parameter, the traced word comes after), so
// this is the common case and not a corner.
fn markKeepAliveLive(f: IrFunc, live: []bool, id: int): bool {
  let again = false
  let i = 0
  while (i + 1 < len(f.keepAlive)) {
    if (f.keepAlive[i] == id) {
      let b = f.keepAlive[i + 1]
      if (b >= 0 && b < len(live) && !live[b]) {
        live[b] = true
        if (b > id) {
          again = true
        }
      }
    }
    i = i + 2
  }
  return again
}

// One descending sweep. Returns whether a keepalive edge marked a value this
// sweep had already passed, so `computeLive` knows to run another.
fn liveSweep(f: IrFunc, live: []bool, dead: []bool, debug: bool): bool {
  let again = false
  let i = len(f.instrs)
  while (i > 0) {
    i = i - 1
    if (dead[i]) {
      continue
    }
    let op = f.instrs[i].op
    if (op == Op.BlockParam) {
      live[i] = true
      continue
    }
    if (!live[i] && !isSideEffectingDebug(op, debug)) {
      continue
    }
    live[i] = true
    markOperandsLive(f, live, i)
    if (markKeepAliveLive(f, live, i)) {
      again = true
    }
  }
  return again
}

fn computeLive(f: IrFunc, dead: []bool, debug: bool): []bool {
  let live = []bool(0)
  let i = 0
  while (i < len(f.instrs)) {
    live = append(live, false)
    i = i + 1
  }
  // A function with no keepalive edges runs EXACTLY one sweep: `liveSweep`
  // can only report `again` from `markKeepAliveLive`, which walks an empty
  // list. So this costs the 99.9% case nothing, and each extra round resolves
  // at least one edge, which bounds the walk.
  let round = 0
  while (round <= len(f.keepAlive)) {
    if (!liveSweep(f, live, dead, debug)) {
      return live
    }
    round = round + 1
  }
  return live
}

// Pass 2: dead code elimination — drop every pure instruction no live root
// reads, plus (optalloc.bit) every allocation nothing reads at all and the
// stores that write into it. No folding and no block pruning here, so the
// rebuild is a faithful translate-and-copy of what survives.
//
// `debug`, threaded the same way `foldConstantsAndPrune` already takes it —
// see `computeLive`'s header for why DCE needs it (#4220).
fn deadCodeElim(f: IrFunc, debug: bool): IrFunc {
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    noFold = append(noFold, noConst())
    i = i + 1
  }
  let reachAll = []bool(0)
  i = 0
  while (i < len(f.blocks)) {
    reachAll = append(reachAll, true)
    i = i + 1
  }
  return rebuild(
    f,
    RebuildPlan{
      known: noFold, keep: computeLive(f, deadAllocs(f), debug),
      fwd: noForwarding(len(f.instrs)), blockReachable: reachAll,
      licm: noLicm(len(f.instrs)),
    },
  )
}

// Which ops read `lhs` / `rhs` as a value operand (rather than leaving them 0).
// `ival`-carried immediates (offsets, block ids, sizes) are copied verbatim.
fn opUsesLhs(op: Op): bool {
  if (opIsBinary(op)) {
    return true
  }
  return op == Op.Neg ||
    op == Op.FNeg ||
    op == Op.BNot ||
    op == Op.Convert ||
    op == Op.FSqrt ||
    op == Op.Bitcast ||
    op == Op.FFloor ||
    op == Op.FCeil ||
    op == Op.FTrunc ||
    op == Op.FRound ||
    op == Op.FieldGet ||
    op == Op.FieldSet ||
    op == Op.IndexGet ||
    op == Op.IndexSet ||
    op == Op.SliceLen ||
    op == Op.CallValue ||
    op == Op.CallIface ||
    op == Op.MakeClosure ||
    opIsAtomic(op) ||
    op == Op.Syscall
}

fn opUsesRhs(op: Op): bool {
  if (opIsBinary(op)) {
    return true
  }
  return op == Op.FieldSet ||
    op == Op.IndexGet ||
    op == Op.IndexSet ||
    op == Op.AtomicStore ||
    op == Op.AtomicCmpxchg ||
    opIsAtomicRmw(op)
}

// Pass 1: constant folding + propagation, block-local store-to-load forwarding,
// dead-branch/dead-block pruning. Forwarding rides here rather than in its own
// rebuild because the DCE pass that immediately follows is what actually
// deletes the reloads it made dead, and `optimizeModule` runs the pair twice —
// so a load exposed by inlining is forwarded on the second round.
// `debug` is `bit build --debug` (#3077). A pass that SPECULATES a trapping
// add/sub/mul/neg — performs it on a path the program might not have taken —
// changes what a debug build does; `licmPlanFor` is that pass, see optloop.bit's
// header. `deadCodeElim`, called right after this by every caller, guards the
// opposite failure — DROPPING a trap rather than inventing one — see
// `computeLive`'s header (#4220).
fn foldConstantsAndPrune(ctx: TypeContext, f: IrFunc, debug: bool): IrFunc {
  let known = analyzeConsts(ctx, f)
  foldIdentities(ctx, f, known)
  let keepAll = []bool(0)
  let i = 0
  while (i < len(f.instrs)) {
    keepAll = append(keepAll, true)
    i = i + 1
  }
  // One forwarding map, filled by three transforms in order of precision: a
  // store answers a load best (optstore.bit), an earlier load answers it next
  // (optcse.bit), and each later pass only writes entries the earlier ones
  // left at -1.
  let fwd = forwardFieldLoads(f)
  cseAvailableValues(f, fwd)
  // #4375: the LICM plan is built first so that pass reads exactly the constant
  // map it always read; `proveInductionBounds` then adds the bounds compares a
  // dominating `i < len(xs)` has already decided, which is what lets
  // `computeReachable` below drop the panic block.
  let licm = licmPlanFor(ctx, f, known, fwd, debug)
  proveInductionBounds(ctx, f, known)
  return rebuild(
    f,
    RebuildPlan{
      known: known, keep: keepAll,
      fwd: fwd, blockReachable: computeReachable(f, known),
      licm: licm,
    },
  )
}

// Runs the optimizer over every function in `m`, in place. Mirrors the seed's
// `-O1` pipeline — the same fixed 5 steps (fold, DCE, inline, fold, DCE),
// without ever looping to a fixpoint, so a constant-argument call still
// collapses after inlining exposes it.
//
// Run as THREE phases over the whole module rather than five steps per
// function, because inlining is the one step that reads a function other than
// the one it is rewriting (#3163). Interleaved, it read callees from the module
// this loop was halfway through mutating, so a callee at a lower index arrived
// already flattened and one at a higher index still held its own calls — and a
// function's index is its file's position in the module's bytewise-sorted file
// list. Identical source in differently named files compiled to different
// machine code, and the collector drew the losing name.
//
// Phase 1 and phase 3 are per-function and pure, so their order cannot matter.
// Phase 2 reads every callee out of `pre`, a snapshot of phase 1's output taken
// before a single function is rewritten, so its order cannot matter either.
// `pre` must be a copy of the LIST: `m.funcs[i] = ...` replaces an element, so
// the copy keeps the pre-inlining function while the module moves on.
fn optimizeModule(m: IrModule, debug: bool) {
  let i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = foldConstantsAndPrune(m.ctx, m.funcs[i], debug)
    m.funcs[i] = deadCodeElim(m.funcs[i], debug)
    i = i + 1
  }
  // #4356: devirtualise `call_value` on a closure whose code pointer is known,
  // BEFORE the snapshot below. The inliner only ever sees `Op.Call`, so a
  // comparator reached through `blr` is out of its reach no matter how small it
  // is; running this first is what puts `sortInPlace`'s `(a, b) => a < b` in
  // front of it. After the fold above for the block-id/schedule reason
  // optappend.bit's header spells out.
  specializeClosureCalls(m)
  let pre = []IrFunc(0)
  i = 0
  while (i < len(m.funcs)) {
    pre = append(pre, m.funcs[i])
    i = i + 1
  }
  i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = inlineCalls(m, pre, i)
    i = i + 1
  }
  // #4039: `slice_append`'s spare-capacity fast path, expanded AFTER inlining
  // and BEFORE the fold below. Both halves of that placement are load-bearing —
  // see optappend.bit's header. Ahead of the inliner it costs `Builder.writeByte`
  // its splice (a measured 37% regression); after the fold, nothing renumbers
  // the blocks it mints back into the linear schedule that `isBackEdge` and the
  // x64 interval numbering assume.
  i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = expandAppends(m.ctx, m.funcs[i])
    i = i + 1
  }
  i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = foldConstantsAndPrune(m.ctx, m.funcs[i], debug)
    m.funcs[i] = deadCodeElim(m.funcs[i], debug)
    i = i + 1
  }
  // #4648: a `string` header the two passes above have DECLINED to delete,
  // whose three words are one call's result run, becomes #4628's reuse diamond.
  // After the fold because "did anything delete this box" is the question it
  // asks, and before strip mining because it renumbers blocks (optstrbox.bit).
  // A no-op unless the string flip is on.
  reuseStringBoxesInModule(m, debug)
  // #4204: strip mining, LAST on purpose. It allocates its block ids in final
  // emission order itself, so nothing may renumber behind it -- see
  // optstrip.bit's header for why that placement is required rather than
  // convenient, and for the latency argument that governs its strip size.
  i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = stripMine(m.ctx, m.funcs[i])
    i = i + 1
  }
}
