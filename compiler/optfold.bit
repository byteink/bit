// Self-host Stage 2 (#1339): compile-time constant values and the arithmetic,
// compare and shift folding rules they obey. Split out of opt.bit (#1503).

// A value known at compile time. `ival` holds the raw 64-bit pattern exactly as
// `IrInstr.ival` stores it — width and signedness come from the value's own
// type, not from here (the IR's "store bits, reinterpret per type" convention).
// Bit has no tagged union, so `known`/`isFloat`/`isBool` discriminate.
struct ConstVal {
  known: bool,
  isFloat: bool,
  isBool: bool,
  ival: int,
  fval: f64,
  bval: bool,
}

fn noConst(): ConstVal {
  return ConstVal{ known: false, isFloat: false, isBool: false, ival: 0, fval: 0.0, bval: false }
}

fn intConst(v: int): ConstVal {
  return ConstVal{ known: true, isFloat: false, isBool: false, ival: v, fval: 0.0, bval: false }
}

fn floatConst(v: f64): ConstVal {
  return ConstVal{ known: true, isFloat: true, isBool: false, ival: 0, fval: v, bval: false }
}

fn boolConst(v: bool): ConstVal {
  return ConstVal{ known: true, isFloat: false, isBool: true, ival: 0, fval: 0.0, bval: v }
}

// The prim index of a type, or -1 when it is not a primitive.
fn primOfType(ctx: TypeContext, ty: int): int {
  if (ctx.types[ty].kind != TypeKind.Prim) {
    return -1
  }
  return ctx.types[ty].prim
}

// Prim indices: 0=i8 1=i16 2=i32 3=i64 4=u8 5=u16 6=u32 7=u64 8=f32 9=f64
// 10=bool 11=string.
fn primBits(p: int): int {
  if (p == 0 || p == 4) { return 8 }
  if (p == 1 || p == 5) { return 16 }
  if (p == 2 || p == 6) { return 32 }
  return 64
}

fn isSignedPrim(p: int): bool {
  return p >= 0 && p <= 3
}

fn isIntPrim(p: int): bool {
  return p >= 0 && p <= 7
}

fn isFloatPrim(p: int): bool {
  return p == 8 || p == 9
}

fn minI64(): int {
  // Written as MAX-negated-minus-one: the literal -9223372036854775808 would
  // have to parse its magnitude as a positive i64 first, which overflows.
  return -9223372036854775807 - 1
}

fn maxI64(): int {
  return 9223372036854775807
}

// Keeps only the low `bits` bits of `raw`, zeroing the rest — the IR's canonical
// unsigned storage form for a `bits`-wide value.
fn maskTo(raw: int, bits: int): int {
  if (bits >= 64) {
    return raw
  }
  return raw & ((1 << bits) - 1)
}

// Reinterprets `raw`'s low `bits` bits as a signed, sign-extended value. `>>` on
// a signed int is an arithmetic shift, which does the extension.
fn signExtend(raw: int, bits: int): int {
  if (bits >= 64) {
    return raw
  }
  let shift = 64 - bits
  return (raw << shift) >> shift
}

// Canonicalizes `raw`'s low `bits` bits per the codegen width-canonical
// invariant: the bits above the type's width must equal the type's sign —
// zero for unsigned, a copy of bit `bits-1` for signed. Every `ConstVal.ival`
// a fold function hands back must already be in this form, since codegen
// trusts a folded `const_int` at face value with no re-narrowing of its own
// (#1708: `maskTo` alone zero-extends, wrong for a negative signed result —
// `-5: i32` folded that way stored as `4294967291`, the unsigned bit
// pattern, instead of a sign-extended `-5`). Only `raw`'s low `bits` bits are
// read, so it is safe on a value whose higher bits are still garbage.
fn canon(raw: int, bits: int, signed: bool): int {
  if (signed) {
    return signExtend(raw, bits)
  }
  return maskTo(raw, bits)
}

// Whether `a + b` would overflow a signed 64-bit result. Checked BEFORE the add
// so the addition itself never overflows (§13.5 leaves signed overflow
// build-mode dependent; the optimizer must never rely on it).
fn addOverflows64(a: int, b: int): bool {
  if (b > 0 && a > maxI64() - b) {
    return true
  }
  return b < 0 && a < minI64() - b
}

fn subOverflows64(a: int, b: int): bool {
  if (b < 0 && a > maxI64() + b) {
    return true
  }
  return b > 0 && a < minI64() + b
}

fn mulOverflows64(a: int, b: int): bool {
  if (a == 0 || b == 0) {
    return false
  }
  // MIN * -1 is the one product whose magnitude escapes the range symmetrically;
  // check it before any division (MIN / -1 would itself overflow).
  if (a == -1) {
    return b == minI64()
  }
  if (b == -1) {
    return a == minI64()
  }
  if (a > 0) {
    if (b > 0) {
      return a > maxI64() / b
    }
    return b < minI64() / a
  }
  if (b > 0) {
    return a < minI64() / b
  }
  return a < maxI64() / b
}

// Folds `add`/`sub`/`mul`. Unsigned always wraps modularly (§13.5: no trap
// possible). Signed only folds when the exact result fits the type's range — an
// out-of-range result is left as a runtime op so it keeps trapping in debug /
// wrapping in release exactly as before (folding never changes behavior).
fn foldAddSubMul(op: Op, bits: int, signed: bool, aRaw: int, bRaw: int): ConstVal {
  if (!signed) {
    // Wrap in u64 (modular, never traps), then narrow to the type's width.
    let ua = u64(maskTo(aRaw, bits))
    let ub = u64(maskTo(bRaw, bits))
    let r = ua + ub
    if (op == Op.Sub) {
      r = ua - ub
    } else if (op == Op.Mul) {
      r = ua * ub
    }
    return intConst(maskTo(i64(r), bits))
  }
  let a = signExtend(aRaw, bits)
  let b = signExtend(bRaw, bits)
  // A sub-64-bit operand pair can never overflow the i64 the math runs in, so
  // only the range check below applies; at 64 bits the op itself could overflow,
  // so it is pre-checked and left unfolded.
  if (bits >= 64) {
    if (op == Op.Add && addOverflows64(a, b)) {
      return noConst()
    }
    if (op == Op.Sub && subOverflows64(a, b)) {
      return noConst()
    }
    if (op == Op.Mul && mulOverflows64(a, b)) {
      return noConst()
    }
  }
  let wide = a + b
  if (op == Op.Sub) {
    wide = a - b
  } else if (op == Op.Mul) {
    wide = a * b
  }
  if (bits < 64) {
    let lim = 1 << (bits - 1)
    if (wide < -lim || wide > lim - 1) {
      return noConst()
    }
  }
  return intConst(canon(wide, bits, true))
}

// Folds `sdiv`/`srem`. Divide-by-zero and `MIN / -1` (the one signed division
// that overflows) both always panic (§13.5) — left unfolded so the trap still
// happens at runtime.
fn foldSignedDivRem(op: Op, bits: int, aRaw: int, bRaw: int): ConstVal {
  let a = signExtend(aRaw, bits)
  let b = signExtend(bRaw, bits)
  if (b == 0) {
    return noConst()
  }
  let minVal = minI64()
  if (bits < 64) {
    minVal = -(1 << (bits - 1))
  }
  if (op == Op.SDiv && a == minVal && b == -1) {
    return noConst()
  }
  if (op == Op.SDiv) {
    return intConst(canon(a / b, bits, true))
  }
  return intConst(canon(a % b, bits, true))
}

// Folds `udiv`/`urem`. Divide-by-zero always panics (§13.5) — left unfolded;
// every other unsigned division is total, no trap possible.
fn foldUnsignedDivRem(op: Op, bits: int, aRaw: int, bRaw: int): ConstVal {
  let a = u64(maskTo(aRaw, bits))
  let b = u64(maskTo(bRaw, bits))
  if (b == u64(0)) {
    return noConst()
  }
  if (op == Op.UDiv) {
    return intConst(i64(a / b))
  }
  return intConst(i64(a % b))
}

// Folds `shl`/`lshr`/`ashr`. Always total: §13.5 defines the shift count as
// taken modulo the operand bit width, so no trap is ever possible. `lshr`/
// `ashr` are themselves already sign-correct (lowering only ever emits
// `lshr` for an unsigned `>>` and `ashr` for a signed one), but `shl` serves
// both, so the caller's `signed` decides the final canonicalization.
fn foldShift(op: Op, bits: int, signed: bool, aRaw: int, bRaw: int): ConstVal {
  // The count is the raw operand mod the width; it is a bit pattern, so read it
  // unsigned before the modulo.
  let shift = i64(u64(bRaw) % u64(bits))
  if (op == Op.Shl) {
    return intConst(canon(maskTo(aRaw, bits) << shift, bits, signed))
  }
  if (op == Op.LShr) {
    // Logical: `>>` on u64 does not sign-extend.
    return intConst(canon(i64(u64(maskTo(aRaw, bits)) >> u64(shift)), bits, signed))
  }
  return intConst(canon(signExtend(aRaw, bits) >> shift, bits, signed))
}

fn foldBinaryArith(ctx: TypeContext, op: Op, ty: int, lhs: ConstVal, rhs: ConstVal): ConstVal {
  let p = primOfType(ctx, ty)
  if (p < 0) {
    return noConst()
  }
  if (isFloatPrim(p)) {
    if (op == Op.FAdd) { return floatConst(lhs.fval + rhs.fval) }
    if (op == Op.FSub) { return floatConst(lhs.fval - rhs.fval) }
    if (op == Op.FMul) { return floatConst(lhs.fval * rhs.fval) }
    if (op == Op.FDiv) { return floatConst(lhs.fval / rhs.fval) }
    return noConst()
  }
  if (!isIntPrim(p)) {
    return noConst()
  }
  let bits = primBits(p)
  let signed = isSignedPrim(p)
  if (op == Op.Add || op == Op.Sub || op == Op.Mul) {
    return foldAddSubMul(op, bits, signed, lhs.ival, rhs.ival)
  }
  if (op == Op.SDiv || op == Op.SRem) {
    if (!signed) {
      return noConst()
    }
    return foldSignedDivRem(op, bits, lhs.ival, rhs.ival)
  }
  if (op == Op.UDiv || op == Op.URem) {
    if (signed) {
      return noConst()
    }
    return foldUnsignedDivRem(op, bits, lhs.ival, rhs.ival)
  }
  if (op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    let a = maskTo(lhs.ival, bits)
    let b = maskTo(rhs.ival, bits)
    if (op == Op.BAnd) { return intConst(canon(a & b, bits, signed)) }
    if (op == Op.BOr) { return intConst(canon(a | b, bits, signed)) }
    return intConst(canon(a ^ b, bits, signed))
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    return foldShift(op, bits, signed, lhs.ival, rhs.ival)
  }
  return noConst()
}

// Compares fold against the OPERAND's type (the result is always bool).
fn foldCompare(ctx: TypeContext, op: Op, operandTy: int, lhs: ConstVal, rhs: ConstVal): ConstVal {
  let p = primOfType(ctx, operandTy)
  if (p < 0) {
    return noConst()
  }
  if (p == 10) {
    if (op == Op.ICmpEq) { return boolConst(lhs.bval == rhs.bval) }
    if (op == Op.ICmpNe) { return boolConst(lhs.bval != rhs.bval) }
    return noConst()
  }
  if (isFloatPrim(p)) {
    if (op == Op.FCmpEq) { return boolConst(lhs.fval == rhs.fval) }
    if (op == Op.FCmpNe) { return boolConst(lhs.fval != rhs.fval) }
    if (op == Op.FCmpLt) { return boolConst(lhs.fval < rhs.fval) }
    if (op == Op.FCmpLe) { return boolConst(lhs.fval <= rhs.fval) }
    if (op == Op.FCmpGt) { return boolConst(lhs.fval > rhs.fval) }
    if (op == Op.FCmpGe) { return boolConst(lhs.fval >= rhs.fval) }
    return noConst()
  }
  if (!isIntPrim(p)) {
    return noConst()
  }
  let bits = primBits(p)
  if (isSignedPrim(p)) {
    let a = signExtend(lhs.ival, bits)
    let b = signExtend(rhs.ival, bits)
    if (op == Op.ICmpEq) { return boolConst(a == b) }
    if (op == Op.ICmpNe) { return boolConst(a != b) }
    if (op == Op.ICmpSlt) { return boolConst(a < b) }
    if (op == Op.ICmpSle) { return boolConst(a <= b) }
    if (op == Op.ICmpSgt) { return boolConst(a > b) }
    if (op == Op.ICmpSge) { return boolConst(a >= b) }
    return noConst()
  }
  let a = u64(maskTo(lhs.ival, bits))
  let b = u64(maskTo(rhs.ival, bits))
  if (op == Op.ICmpEq) { return boolConst(a == b) }
  if (op == Op.ICmpNe) { return boolConst(a != b) }
  if (op == Op.ICmpUlt) { return boolConst(a < b) }
  if (op == Op.ICmpUle) { return boolConst(a <= b) }
  if (op == Op.ICmpUgt) { return boolConst(a > b) }
  if (op == Op.ICmpUge) { return boolConst(a >= b) }
  return noConst()
}

fn foldUnary(ctx: TypeContext, op: Op, ty: int, v: ConstVal): ConstVal {
  let p = primOfType(ctx, ty)
  if (p < 0) {
    return noConst()
  }
  if (op == Op.FNeg) {
    return floatConst(-v.fval)
  }
  if (!isIntPrim(p)) {
    return noConst()
  }
  let bits = primBits(p)
  if (op == Op.BNot) {
    return intConst(canon(~maskTo(v.ival, bits), bits, isSignedPrim(p)))
  }
  if (op != Op.Neg) {
    return noConst()
  }
  if (isSignedPrim(p)) {
    let a = signExtend(v.ival, bits)
    let minVal = minI64()
    if (bits < 64) {
      minVal = -(1 << (bits - 1))
    }
    // Negating MIN overflows: preserve the trap.
    if (a == minVal) {
      return noConst()
    }
    return intConst(canon(-a, bits, true))
  }
  return intConst(canon(i64(u64(0) - u64(maskTo(v.ival, bits))), bits, false))
}

fn opIsCompare(op: Op): bool {
  return int(op) >= int(Op.ICmpEq) && int(op) <= int(Op.FCmpGe)
}

fn opIsArith(op: Op): bool {
  return int(op) >= int(Op.Add) && int(op) <= int(Op.LShr)
}

// ---------------------------------------------------------------------------
// Algebraic identities (#3164)
//
// `analyzeConsts` folds a binary op only when BOTH operands are known, so an op
// against a literal 0, 1 or -1 survives to codegen as a materialized constant
// plus a real instruction. `runtime/gc/mem.bit`'s `wordAt` is the canonical
// case: `let n: *i64 = nil` then `n + (addr / 8)` emitted `mov x1, #0x0`
// followed by `add x2, x1, x0`. The rules below cover the one-operand-known
// case, and `const_nil` reads as the constant 0 (see `constView`) so the `nil`
// half of that pair participates.
//
// Two result shapes, neither of which deletes an instruction — opt.bit's
// file-level invariant is that an instruction's index IS its value id, so
// removing one in place would silently renumber every later operand:
//
//   - the op YIELDS AN OPERAND (`add x, 0` -> `x`): every later read of the op
//     is rewritten to read that operand instead, leaving the op itself unread.
//     `deadCodeElim`, the very next step of the pipeline, drops it.
//   - the op YIELDS A CONSTANT (`mul x, 0` -> `0`): recorded in the caller's
//     `known` table, which `rebuild` already renders as a `const_int`.
//
// Dropping the USE of an operand is always legal here: the operand's defining
// instruction stays put, and only `deadCodeElim` may remove it — which it does
// solely for ops `isSideEffecting` says are pure. A call, a division or an
// `index_get` behind a folded `mul x, 0` is therefore still executed.
//
// No rule depends on signed overflow behavior. Every result is either an
// operand the unfolded code already computed or a constant inside the type's
// range, so no rule can introduce an overflow, a trap or a division the
// original did not have. §13.5 leaves a trapping debug mode open and
// `foldAddSubMul` above is written not to rely on it either.
// ---------------------------------------------------------------------------

// The outcome of one identity test. Bit has no tagged union, so the two flags
// discriminate: `isCopy` means the op yields the existing value `copyOf`,
// `cval.known` means it yields that constant, and neither set means no identity
// applies.
struct IdentFold {
  isCopy: bool,
  copyOf: int,
  cval: ConstVal,
}

fn noIdent(): IdentFold {
  return IdentFold{ isCopy: false, copyOf: 0, cval: noConst() }
}

fn copyIdent(v: int): IdentFold {
  return IdentFold{ isCopy: true, copyOf: v, cval: noConst() }
}

fn constIdent(v: ConstVal): IdentFold {
  return IdentFold{ isCopy: false, copyOf: 0, cval: v }
}

// The compile-time value of `v`, widened with the one fact `analyzeConsts` does
// not record: `const_nil` IS the integer 0. It is deliberately not added to
// `known` itself — that table drives `emitTranslated`, which would then replace
// every `const_nil` with a `const_int 0` at a pointer type, changing what
// codegen and the GC's pointer maps see for no gain. Here it only ever feeds an
// identity test, so the nil operand disappears and the surviving operand keeps
// its own type.
fn constView(known: []ConstVal, f: IrFunc, v: int): ConstVal {
  if (known[v].known) {
    return known[v]
  }
  if (f.instrs[v].op == Op.ConstNil) {
    return intConst(0)
  }
  return noConst()
}

// The width to read value `v`'s raw constant bits under: its own type's, or 64
// when it is not a primitive (a `const_nil`'s pointer type, where the value is
// exactly 0 at any width).
fn constBitsOf(ctx: TypeContext, f: IrFunc, v: int): int {
  let p = primOfType(ctx, f.instrs[v].ty)
  if (p < 0) {
    return 64
  }
  return primBits(p)
}

// Whether `cv` is an integer constant equal to `want` in `v`'s own width. Bool
// and float constants never match: `false`/`0.0` are not integer zeros, and
// `x + 0.0` is not `x` when `x` is `-0.0`.
fn constIsInt(ctx: TypeContext, known: []ConstVal, f: IrFunc, v: int, want: int): bool {
  let cv = constView(known, f, v)
  if (!cv.known || cv.isFloat || cv.isBool) {
    return false
  }
  let bits = constBitsOf(ctx, f, v)
  return maskTo(cv.ival, bits) == maskTo(want, bits)
}

// Whether the shift COUNT `v` is a constant that shifts by nothing. §13.5 takes
// the count modulo the operand width, so 64 on an i64 is as much a no-op as 0.
// Uses `foldShift`'s exact expression so the both-known and one-known paths can
// never disagree about which counts are no-ops.
fn shiftCountIsNoop(known: []ConstVal, f: IrFunc, v: int, bits: int): bool {
  let cv = constView(known, f, v)
  if (!cv.known || cv.isFloat || cv.isBool) {
    return false
  }
  return i64(u64(cv.ival) % u64(bits)) == 0
}

// The all-ones constant for a `bits`-wide value of the given signedness — `-1`
// signed, `2^bits - 1` unsigned — already canonical per `canon`.
fn allOnesConst(bits: int, signed: bool): ConstVal {
  return intConst(canon(maskTo(-1, bits), bits, signed))
}

// `add`/`sub`/`mul` identities. `sub(0, x)` is deliberately absent: it is a
// negation, which needs an instruction this pass cannot create and which traps
// on MIN under the specified debug mode.
fn identAddSubMul(ctx: TypeContext, known: []ConstVal, f: IrFunc, ins: IrInstr,
  bits: int, signed: bool): IdentFold {
  let lZero = constIsInt(ctx, known, f, ins.lhs, 0)
  let rZero = constIsInt(ctx, known, f, ins.rhs, 0)
  if (ins.op == Op.Add) {
    if (rZero) { return copyIdent(ins.lhs) }
    if (lZero) { return copyIdent(ins.rhs) }
    return noIdent()
  }
  if (ins.op == Op.Sub) {
    if (rZero) { return copyIdent(ins.lhs) }
    return noIdent()
  }
  if (lZero || rZero) {
    return constIdent(intConst(canon(0, bits, signed)))
  }
  if (constIsInt(ctx, known, f, ins.rhs, 1)) { return copyIdent(ins.lhs) }
  if (constIsInt(ctx, known, f, ins.lhs, 1)) { return copyIdent(ins.rhs) }
  return noIdent()
}

// `and`/`or`/`xor` identities. Always total — a bitwise op can neither trap nor
// overflow at any width.
fn identBitwise(ctx: TypeContext, known: []ConstVal, f: IrFunc, ins: IrInstr,
  bits: int, signed: bool): IdentFold {
  let lZero = constIsInt(ctx, known, f, ins.lhs, 0)
  let rZero = constIsInt(ctx, known, f, ins.rhs, 0)
  let lOnes = constIsInt(ctx, known, f, ins.lhs, -1)
  let rOnes = constIsInt(ctx, known, f, ins.rhs, -1)
  if (ins.op == Op.BAnd) {
    if (rOnes) { return copyIdent(ins.lhs) }
    if (lOnes) { return copyIdent(ins.rhs) }
    if (lZero || rZero) { return constIdent(intConst(canon(0, bits, signed))) }
    return noIdent()
  }
  if (ins.op == Op.BOr) {
    if (rZero) { return copyIdent(ins.lhs) }
    if (lZero) { return copyIdent(ins.rhs) }
    if (lOnes || rOnes) { return constIdent(allOnesConst(bits, signed)) }
    return noIdent()
  }
  if (rZero) { return copyIdent(ins.lhs) }
  if (lZero) { return copyIdent(ins.rhs) }
  return noIdent()
}

// `shl`/`lshr`/`ashr` identities: a no-op count yields the shifted value, and
// shifting zero yields zero under every direction and every count.
fn identShift(ctx: TypeContext, known: []ConstVal, f: IrFunc, ins: IrInstr,
  bits: int, signed: bool): IdentFold {
  if (shiftCountIsNoop(known, f, ins.rhs, bits)) {
    return copyIdent(ins.lhs)
  }
  if (constIsInt(ctx, known, f, ins.lhs, 0)) {
    return constIdent(intConst(canon(0, bits, signed)))
  }
  return noIdent()
}

// The identity `ins` obeys, if any. Float ops fall through: `x + 0.0` is not
// `x` for `-0.0`, and `x * 1.0` quiets a signaling NaN, so IEEE-754 arithmetic
// gets no rules here. A non-primitive result type (pointer arithmetic, where
// `wordAt`'s `add *i64` lives) is allowed a copy identity but never a constant
// one, since there is no width to canonicalize a constant to.
fn identityOf(ctx: TypeContext, known: []ConstVal, f: IrFunc, id: int): IdentFold {
  let ins = f.instrs[id]
  let op = ins.op
  let p = primOfType(ctx, ins.ty)
  let isInt = p >= 0 && isIntPrim(p)
  let bits = 64
  let signed = false
  if (isInt) {
    bits = primBits(p)
    signed = isSignedPrim(p)
  } else if (p >= 0) {
    // A float or bool result: nothing below applies to either.
    return noIdent()
  }
  let r = noIdent()
  if (op == Op.Add || op == Op.Sub || op == Op.Mul) {
    r = identAddSubMul(ctx, known, f, ins, bits, signed)
  } else if (op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    r = identBitwise(ctx, known, f, ins, bits, signed)
  } else if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    r = identShift(ctx, known, f, ins, bits, signed)
  }
  if (r.cval.known && !isInt) {
    return noIdent()
  }
  // THE TYPE MUST NOT CHANGE. A copy identity replaces reads of `id` with reads
  // of an operand, so anything that consumed `id` at `ins.ty` now consumes the
  // operand at ITS type — a silent retype of a live value, which codegen and
  // the GC's pointer maps both trust. Refusing the fold is always safe.
  if (r.isCopy && f.instrs[r.copyOf].ty != ins.ty) {
    return noIdent()
  }
  return r
}

// `ids` with every entry replaced by its representative. Returns the ORIGINAL
// slice when nothing changed, and otherwise a fresh one — an IR operand list
// can be shared between instructions, so mutating one in place would rewrite
// operands this pass never examined.
fn mapIds(alias: []int, ids: []int): []int {
  let i = 0
  while (i < len(ids)) {
    if (alias[ids[i]] != ids[i]) {
      let out = []int(0)
      let j = 0
      while (j < len(ids)) {
        out = append(out, alias[ids[j]])
        j = j + 1
      }
      return out
    }
    i = i + 1
  }
  return ids
}

// Points every value id instruction `id` reads at its representative. Mirrors
// `emitTranslated`'s own field discipline exactly — `lhs`/`rhs` only where
// `opUsesLhs`/`opUsesRhs` say they hold a value, `ival` only for the two ops
// whose immediate is one, and `br`'s edge argument lists separately — because a
// second, disagreeing operand table is how a pass comes to rewrite an offset as
// if it were a value id.
fn rewriteOperandIds(f: IrFunc, alias: []int, id: int) {
  let ins = f.instrs[id]
  let op = ins.op
  if (op == Op.Br) {
    ins.lhs = alias[ins.lhs]
    ins.thenArgs = mapIds(alias, ins.thenArgs)
    ins.elseArgs = mapIds(alias, ins.elseArgs)
    return
  }
  if (opUsesLhs(op)) {
    ins.lhs = alias[ins.lhs]
  }
  if (opUsesRhs(op)) {
    ins.rhs = alias[ins.rhs]
  }
  if (op == Op.IndexSet || op == Op.AtomicCmpxchg) {
    ins.ival = alias[ins.ival]
  }
  ins.args = mapIds(alias, ins.args)
}

// One forward sweep applying every identity above, in place. Runs after
// `analyzeConsts` and before the rebuild, so a constant it discovers still
// reaches `computeReachable` and `rebuild` through the same `known` table.
//
// Bounded and non-recursive: one pass over an array of known size, and each
// step reads only `alias` entries strictly below `i`. Operands are repointed
// BEFORE `i`'s own identity is tested, so an identity's surviving value is
// already a representative and `alias` never needs chasing — one lookup is
// always final. That is also what makes a cascade (`add x, (mul y, 0)`) resolve
// in this single pass.
//
// Mutating `f` in place is safe here in a way deleting an instruction would not
// be: no index moves, so every value id stays valid. `f`'s `IrInstr` records
// are its own — every producer of an `IrFunc` (`rebuild`, `inlineCalls`,
// lowering) builds fresh records through `mkInstr`, and `spliceCallee` copies
// rather than sharing — so no other function can observe these writes.
fn foldIdentities(ctx: TypeContext, f: IrFunc, known: []ConstVal) {
  let alias = []int(0)
  let i = 0
  while (i < len(f.instrs)) {
    alias = append(alias, i)
    i = i + 1
  }
  i = 0
  while (i < len(f.instrs)) {
    rewriteOperandIds(f, alias, i)
    if (!known[i].known && opIsArith(f.instrs[i].op)) {
      let r = identityOf(ctx, known, f, i)
      if (r.isCopy) {
        alias[i] = r.copyOf
      } else if (r.cval.known) {
        known[i] = r.cval
      }
    }
    i = i + 1
  }
}
