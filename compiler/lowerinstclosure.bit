// compiler/lowerinstclosure.bit — split out of compiler/lowerdriver.bit
// (#5640, which was at the 800-line E0200 ceiling with zero headroom).
// Sibling of lowerdriver.bit: same module (directory-scanned), so this
// needs no imports and no call-site changes.
//
// Pass A1 — the MONOMORPHIZATION CLOSURE: walks every generic call reachable
// from a non-generic body (and every generic-receiver method instantiation,
// #4569), recording what lowering will need to emit, transitively, before
// anything is actually lowered. See closeInstantiations below for the full
// two-step account.

// The most instantiations Pass A1 may ADD to the ledger. Polymorphic recursion
// (`f<T>` calling `f<Box<T>>`) has no finite monomorphization, so the closure
// needs a hard stop; running out of budget leaves the ledger exactly as
// incomplete as it was before the pass existed, which means the build refuses
// with "cannot lower" rather than looping forever.
const closureBudget = 4096

// Every `call` node in the subtree rooted at `node`, in source order.
//
// An explicit stack rather than recursion, and bounded by the arena's own size:
// this runs over trees the parser produced, but a walker whose only termination
// argument is "the tree is a tree" is one malformed node away from not
// terminating at all.
fn subtreeCallNodes(t: Tree, node: int): []int {
  let out = []int(0)
  if (node == 0) {
    return out
  }
  let stack = [node]
  let steps = 0
  while (len(stack) > 0 && steps < len(t.nodes)) {
    let n = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    if (getNode(t, n).tag == Tag.Call) {
      out = append(out, n)
    }
    // Pushed in reverse so the pops come out in source order, matching the
    // arena order the check pass records in.
    let kids = kidsOf(t, n)
    let i = len(kids) - 1
    while (i >= 0) {
      if (kids[i] != 0) {
        stack = append(stack, kids[i])
      }
      i = i - 1
    }
    steps = steps + 1
  }
  return out
}

// Records the instantiation every generic call in `node`'s subtree will ask for,
// resolved EXACTLY the way `resolveCallTarget` resolves it during lowering: same
// `funcRefAt` node keying, same `genericTypeArgs`. Any other rule would fill the
// ledger with instances the emitted calls do not name, which is the failure this
// pass exists to end rather than move.
//
// `bareNames` selects which callee spellings to consider. A NON-generic body
// passes false: the check pass already recorded its `f(...)` calls, and only the
// dotted `ns.f(...)` spelling — which checkmodule.bit never looks at — is
// missing. An instance body passes true, because its calls must be re-resolved
// under this instantiation's bindings.
//
// `genEnv` is that instantiation's (type param -> concrete arg) map, empty for a
// non-generic body. It is applied to the INFERRED arguments for the same reason
// `nodeType` applies it to every body node's type: the body was checked once
// against unbound parameters, so an argument still typed `T` here is `i64` in
// this instance and the call binds `i64`.
fn recordSubtreeInstantiations(c: Checker, node: int, bareNames: bool, genEnv: TypeEnv) {
  let calls = subtreeCallNodes(c.tree, node)
  let i = 0
  while (i < len(calls)) {
    recordSubtreeCall(c, calls[i], bareNames, genEnv)
    i = i + 1
  }
}

// One call of that walk. Split out so the walk itself stays a loop: this is
// where every callee spelling is classified, and there are now three.
fn recordSubtreeCall(c: Checker, callNode: int, bareNames: bool, genEnv: TypeEnv) {
  let callee = kidsOf(c.tree, callNode)[0]
  let cn = getNode(c.tree, callee)
  let name = ""
  if (cn.tag == Tag.Ident && bareNames) {
    name = c.source[cn.span.start:cn.span.end]
  }
  if (cn.tag == Tag.Member) {
    let qn = nsQualifiedName(c, callee)
    if (qn != "" && funcDeclLookup(c, qn) != 0) {
      name = qn
    }
  }
  if (name != "") {
    let fr = funcRefAt(c, callee, name)
    if (funcRefIsGeneric(fr)) {
      recordInstantiation(
        c,
        fr,
        substTypeList(c, genericTypeArgs(c, name, callNode), genEnv),
        vSpan(c, callNode),
      )
    }
    return
  }
  // A generic METHOD call inside an instance body, for the same reason the
  // bare-name arm above re-resolves a free one: the body was checked once
  // against the template's unbound parameters, so the entry the check pass
  // recorded is not the one this instance's call will name (#4495).
  if (cn.tag == Tag.Member && bareNames) {
    recordMethodInstantiation(c, callNode, callee, genEnv)
  }
}

// Binds `decl`'s type parameters to `args` in `oc`'s flat `userTypes`, returning
// what each name held before. The same rebinding `lowerInstance` performs, and
// for the same reason: every type node re-resolved while it is in force reads
// the instantiation's concrete argument instead of the bare parameter.
fn bindTypeParams(oc: Checker, decl: int, args: []int): []int {
  let saved = []int(0)
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let j = 0
  while (j < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    saved = append(saved, userTypeLookup(oc, tpname))
    if (j < len(args)) {
      oc.userTypes[tpname] = args[j]
    }
    j = j + 1
  }
  return saved
}

// Undoes `bindTypeParams`.
fn restoreTypeParams(oc: Checker, decl: int, saved: []int) {
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let j = 0
  while (j < len(tps) && j < len(saved)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
    oc.userTypes[oc.source[tpn.span.start:tpn.span.end]] = saved[j]
    j = j + 1
  }
}

// Pass A1 — the MONOMORPHIZATION CLOSURE, run before anything is lowered.
//
// The check pass records one instantiation per generic call it sees, with the
// type arguments that call binds where it stands (checkmodule.bit). Two shapes
// escape it, and both then failed at lowering with the spanless, span-less
// "cannot lower N function(s)":
//
//   - a generic call inside a GENERIC body (#2102, #2307). The body is checked
//     ONCE, against the template's own unbound parameters, so `let a = f1(x);
//     return f2(a)` records `f2<T>`. Every monomorphization of the enclosing
//     generic then asks for `f2<i64>` — an instance nothing recorded — and the
//     whole caller was stubbed. `return f2(f1(x))` escaped only because a Call
//     argument's type is RE-COMPUTED at lowering time and so came back `<T>`
//     again, while a local's is read from the checker's table and came back
//     concrete: the two spellings disagreed about the same call.
//   - a generic reached through a NAMESPACE import (#2133), `util.idOf(7)`.
//     checkmodule.bit records only an `Ident` callee, so a dotted one recorded
//     nothing at all and `std/seq` was unusable in its namespace spelling.
//
// The ledger doubles as the worklist — an instance appended here is itself
// scanned — so a chain of generics closes transitively.
fn closeInstantiations(mods: []Checker, root: int) {
  // Step 1: the dotted generic calls in every NON-generic body. A generic
  // template is deliberately skipped here: its type parameters are not in scope
  // at this point (the flat `userTypes` holds whichever generic in the module
  // declared a `T` last, #1485), so reading its body now would bind arguments
  // off another declaration's parameters. Step 2 visits it once per
  // instantiation, with the right bindings in force.
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let m = 1
    while (m < len(c.tree.nodes)) {
      if (getNode(c.tree, m).tag == Tag.FuncDecl && !isGenericFuncDecl(c, m)) {
        recordSubtreeInstantiations(c, kidsOf(c.tree, m)[5], false, emptyTypeEnv())
      }
      m = m + 1
    }
    mi = mi + 1
  }
  // Step 1b: the body of every method on a GENERIC RECEIVER, once per nominal
  // instantiation of that receiver (#4569). It runs before step 2 so that what
  // it records is itself closed transitively by the worklist below.
  closeMethodInstantiations(mods)
  // Step 2: every instantiation's own body, under that instantiation's bindings.
  let ctx = mods[root].ctx
  let budget = len(ctx.instantiations) + closureBudget
  let g = 0
  while (g < len(ctx.instantiations) && len(ctx.instantiations) < budget) {
    let inst = ctx.instantiations[g]
    if (inst.declModule >= 0 && inst.declModule < len(mods)) {
      let owner = mods[inst.declModule]
      // The ledger's own decl node, as `lowerInstance` reads it: a generic
      // METHOD is an entry here too (#4495) and `funcDeclLookup` answers for
      // free functions only, so looking it up by name skipped every method
      // instance's body and a generic call inside one resolved to nothing.
      let decl = inst.decl
      if (decl != 0) {
        let saved = bindTypeParams(owner, decl, inst.args)
        recordSubtreeInstantiations(
          owner, kidsOf(owner.tree, decl)[5], true,
          genericEnvOf(owner, decl, inst.args),
        )
        restoreTypeParams(owner, decl, saved)
      }
    }
    g = g + 1
  }
}

// Pass A1, step 1b — the body of a method on a GENERIC RECEIVER, once per
// nominal instantiation of that receiver.
//
// Neither of the other two steps can reach such a body (#4569). Step 1 skips it
// because the parser merges the receiver's `<A>` into the method's own generic
// params, so `isGenericFuncDecl` is true for `(p: Pair<A>) first()`; step 2
// iterates the FUNCTION ledger, and a method with no type params of its own is
// not an entry there — `lowerMethodInstances` emits it once per `ctx.typeInsts`
// entry instead. So a generic call in that body was only ever recorded at the
// receiver's own type parameter, which is degenerate and refused (#4499), and
// lowering the emitted body then failed with E0092 "target could not be
// resolved".
//
// This walks exactly the bodies `lowerMethodInstances` will emit (including
// which `typeInsts` entry, `typeInstArgsConcrete` in lowerprim.bit, #5320),
// under exactly the bindings it will emit them with.
fn closeMethodInstantiations(mods: []Checker) {
  let mi = 0
  while (mi < len(mods)) {
    closeModuleMethodInstantiations(mods[mi])
    mi = mi + 1
  }
}

// One module's share of that step. The arm selected here is the same one
// `lowerModuleMethods` routes to `lowerMethodInstances`: a method with a
// receiver, no type params of its own, and a generic receiver.
fn closeModuleMethodInstantiations(c: Checker) {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0 && methodOwnGenericCount(c, m) == 0) {
      let recvName = typeNodeName(c, kidsOf(c.tree, kidsOf(c.tree, m)[0])[1])
      if (len(declTypeParamIds(c, recvName)) != 0) {
        recordMethodInstanceCalls(c, m, recvName)
      }
    }
    m = m + 1
  }
}

// `recordSubtreeInstantiations` over method `decl`'s body, once per nominal
// instantiation of its generic receiver `recvName`. `bareNames` is true for the
// same reason step 2 passes it: this body was checked ONCE against the
// receiver's unbound parameters, so its `f(...)` calls must be re-resolved under
// this instantiation's bindings rather than trusted from the check pass.
fn recordMethodInstanceCalls(c: Checker, decl: int, recvName: string) {
  let params = declTypeParamIds(c, recvName)
  let argNames = receiverTypeParamNames(c, decl)
  let body = kidsOf(c.tree, decl)[5]
  let i = 0
  while (i < len(c.ctx.typeInsts)) {
    let inst = c.ctx.typeInsts[i]
    if (inst.module == c.moduleId &&
      inst.name == recvName &&
      len(inst.args) == len(params) &&
      typeInstArgsConcrete(c.ctx, inst.args)) {
      let saved = bindReceiverTypeParams(c, argNames, inst.args)
      recordSubtreeInstantiations(c, body, true, methodInstEnv(c, decl, recvName, inst.args))
      restoreReceiverTypeParams(c, argNames, saved)
    }
    i = i + 1
  }
}

// Binds a method's receiver type-argument NAMES positionally onto one nominal
// instantiation's concrete args, returning what each name held before. Every
// site that RE-RESOLVES a type node by name reads the concrete argument while
// this is in force; `methodInstEnv` covers the sites that read a type the
// checker already recorded against the template.
fn bindReceiverTypeParams(c: Checker, argNames: []string, args: []int): []int {
  let saved = []int(0)
  let j = 0
  while (j < len(argNames)) {
    saved = append(saved, userTypeLookup(c, argNames[j]))
    if (j < len(args)) {
      c.userTypes[argNames[j]] = args[j]
    }
    j = j + 1
  }
  return saved
}

// Undoes `bindReceiverTypeParams`.
fn restoreReceiverTypeParams(c: Checker, argNames: []string, saved: []int) {
  let j = 0
  while (j < len(argNames) && j < len(saved)) {
    c.userTypes[argNames[j]] = saved[j]
    j = j + 1
  }
}

// The (type param -> concrete arg) env for one nominal instantiation of method
// `decl`'s generic receiver.
//
// Built from the METHOD's own generics list, not the class's. The parser merges
// a receiver's `<T>` into the method's generic params (parserdecl: "those params
// are DECLARED here"), so the body was checked against ids the class decl never
// saw — and `genericEnvOf` additionally binds whatever the name resolves to NOW,
// which the flat env can have moved (#1485).
//
// Both the method's own type-param ids AND the class's are bound: the class's
// `items: []T` was typed against the class's `T`, the method's `v: T` against
// the method's, and a body mentions both.
fn methodInstEnv(c: Checker, decl: int, recvName: string, args: []int): TypeEnv {
  let env = genericEnvOf(c, decl, args)
  let sids = declTypeParamIds(c, recvName)
  let s = 0
  while (s < len(sids) && s < len(args)) {
    if (sids[s] != 0) {
      env.params = append(env.params, sids[s])
      env.args = append(env.args, args[s])
    }
    s = s + 1
  }
  return env
}
