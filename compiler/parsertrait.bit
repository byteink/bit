// compiler/parsertrait.bit — `trait` declaration parsing (SPEC §10.7, #3369;
// trait fields #3370), moved verbatim out of parsertype.bit. A sibling .bit
// file is the same module, so this is a pure move: no import, no call-site
// change, and every function keeps its name and body.
//
// Split for the 800-line ceiling (spec/LINT.md E0200): field attributes
// (#3879) added a `FieldModifiers` bundle and an attribute arm to
// `parseClassMember`, which took parsertype.bit to 813. The trait block is the
// seam because it is the one group in that file with a single entry point from
// outside it (`parseTraitDecl`, parserdecl.bit's decl dispatch) and no
// declarations at all — no consts, no classes — so no ordering question arises.

// `[export] IDENT ':'` — a field, whether or not it is exported. Checked by
// looking past an optional `export` rather than folding `export` into
// `parseTraitMember`'s own lookahead unconditionally: a trait METHOD may
// also carry a leading `export` (SPEC §10.7), so the token after the name —
// `:` for a field, anything else for a method — is what actually decides;
// `parseTraitMethod` below consumes its own leading `export` when this
// predicate says no.
fn atTraitField(p: Parser): bool {
  if (peekKind(p) == Kind.KwExport) {
    return peekKindAt(p, 1) == Kind.Ident && peekKindAt(p, 2) == Kind.Colon
  }
  return peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.Colon
}

// A trait member (SPEC §10.7, #3369; fields #3370): a `use` statement
// composing another trait, a field (injected into the using class's layout
// and GC pointer map, exactly like one it declared itself), or a method —
// required (no body, `hurt(n: i64)`) or provided (a body,
// `dead(): bool { ... }`).
fn parseTraitMember(p: Parser): int {
  if (atUseStmt(p)) {
    return parseUseStmt(p)
  }
  if (atTraitField(p)) {
    let exported = acceptTok(p, Kind.KwExport)
    let name = expectIdent(p)
    // No `readonly` on a trait field (#4066 scopes the modifier to classes;
    // `atTraitField` above admits no such token anyway), and no attributes
    // (#3879 scopes those to classes too — §10.7's `trait_field` production is
    // unchanged, so a `@` in a trait body stays the parse error it is today).
    let mods = FieldModifiers{ exported = exported, readonly = false, attrs = 0 }
    return parseField(p, name, mods, false)
  }
  return parseTraitMethod(p)
}

// `trait_method = [name, generics_or_none, params, result_or_none,
// body_or_none]` (SPEC §10.7). The body kid is `none` (0) for a required
// method: checktrait.bit reads that absence to decide what a using class
// must supply for itself. Unlike a class's in-body method (parsertype.bit's
// parseMethodMember), there is no receiver-derived prefix to merge in: a
// trait declares no generics of its own (parseTraitDecl above), so
// `maybeGenericParams` alone is the method's whole `<...>` list, duplicated
// fresh per injection site and merged with the USING class's own generics at
// clone time (checktraitinject.bit's cloneTraitMethod), exactly as a class method's
// own generics are merged with its receiver's there.
//
// A leading `export` (SPEC §10.7) wraps the returned node in `Tag.Export`,
// exactly as `parseField` above wraps an exported trait field and
// `parseMethodMember` (parsertype.bit) wraps an exported class method — the
// one shape every reader of a class's method already knows how to unwrap.
// `checktraitinject.bit`'s `cloneTraitMethod` reads this wrapper back off
// to carry the same export status onto the injected copy.
fn parseTraitMethod(p: Parser): int {
  let exported = acceptTok(p, Kind.KwExport)
  let name = expectIdent(p)
  let generics = maybeGenericParams(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let body = 0
  if (peekKind(p) == Kind.LBrace) {
    body = parseBlock(p)
  }
  let node = mkNode(p, Tag.TraitMethod, 0, [name, generics, params, result, body])
  if (!exported) {
    return node
  }
  return mkNode(p, Tag.Export, 0, [node])
}

// E0021 naming the actual rule ("traits cannot be generic") instead of the
// generic "expected '{', found '<'" `parseFail` would otherwise produce,
// which points at the `<` and leaves the reader to guess why it is wrong.
// Consumes the `<...>` list via `maybeGenericParams` (parsertype.bit) so
// parsing recovers at the member list instead of misreading the parameters
// as trait members and cascading further errors.
fn rejectTraitGenerics(p: Parser) {
  if (peekKind(p) != Kind.Lt) {
    return
  }
  let t = peekTok(p)
  let span = Span{ file = p.file, start = t.start, end = t.end }
  report(
    p.diags, 21, span,
    "traits cannot be generic",
    "give the type parameter to the class or interface that uses this trait instead",
  )
  maybeGenericParams(p)
}

// `trait_decl = "trait" IDENT "{" { trait_member } "}"` (SPEC §10.7). No
// generics on the trait itself — #5275 settled this deliberately rather than
// leaving it as an omission: a trait's type parameters would have to be
// either its own (matching class/interface) or inherited from the `use`-ing
// type, and the two are different languages, not two spellings of one.
// Inheriting would make a trait body's `T` resolve through the SAME
// module-wide `userTypes` name table `buildSignatures` already uses for
// every other generic (checkbindfunc.bit), which #4602 documents as corrupting
// two generics that both spell a parameter `T` — a trait adds a seventh
// reader with no owner yet. Declaring the trait's own `<T>` is consistent
// but needs type-argument substitution at each `use Existence<T>` site that
// nothing in the trait pipeline does today (`cloneTraitMethod` below only
// merges the CLASS's generics into a clone; it never threads an argument
// list back into the trait's own signatures). Fields are supported (#3370)
// and injected into the using class's own layout — see checktraitfield.bit.
// A `<` right after the name is reported as E0021, not silently swallowed:
// see `rejectTraitGenerics` below.
fn parseTraitDecl(p: Parser): int {
  advance(p) // 'trait'
  let name = expectIdent(p)
  rejectTraitGenerics(p)
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (!atListClose(p, Kind.RBrace)) {
    let before = p.pos
    items = append(items, parseTraitMember(p))
    if (!acceptTok(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
    if (p.pos == before) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let members = mkSpanNode(p, Tag.TraitMemberList, 0, items, lbStart, rbEnd)
  return mkNode(p, Tag.TraitDecl, 0, [name, members])
}
