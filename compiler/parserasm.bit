// Parser: inline assembly (§11.6). Split out of parser.bit (#1503); sibling
// .bit files are the same module, so this is a pure move.

// ---- inline assembly (§11.6) -----------------------------------------------

// The current token's source text — used only to match the contextual keywords
// inside an `asm` block (`x64`/`arm64`/`input`/`result`/`clobber`/`volatile`),
// which lex as ordinary identifiers.
fn curText(p: Parser): string {
  let t = peekTok(p)
  return p.src[t.start:t.end]
}

// Consumes an identifier that must read exactly `word`; reports otherwise.
fn expectWord(p: Parser, word: string) {
  if (peekKind(p) == Kind.Ident && curText(p) == word) {
    advance(p)
    return
  }
  parseFail(p, word)
}

// `asm [volatile] { directive... }` — an expression yielding its `result`
// operand, or `()` when it declares none. Both target sub-blocks live on the
// one node; codegen reads only its own arch's (Bit has no arch-conditional
// compilation, and the runtime sites need none).
fn parseAsm(p: Parser): int {
  let kwStart = peekTok(p).start
  advance(p) // 'asm'
  let isVolatile = 0
  if (peekKind(p) == Kind.Ident && curText(p) == "volatile") {
    isVolatile = 1
    advance(p)
  }
  expect(p, Kind.LBrace)
  let x64Code = 0
  let arm64Code = 0
  let result = 0
  let clobX64 = 0
  let clobArm64 = 0
  let inputs = []int(0)
  let guard = 0
  while (guard < 256) {
    // Statements auto-terminate at newlines, so a `;` sits between directives
    // (after each `}`); skip them.
    skipSemis(p)
    let k = peekKind(p)
    if (k == Kind.RBrace || k == Kind.Eof) {
      break
    }
    if (k != Kind.Ident) {
      parseFail(p, "an asm directive")
      break
    }
    let dir = curText(p)
    if (dir == "x64") {
      advance(p)
      x64Code = parseAsmCode(p)
    } else if (dir == "arm64") {
      advance(p)
      arm64Code = parseAsmCode(p)
    } else if (dir == "input") {
      advance(p)
      inputs = append(inputs, parseAsmOperand(p, Tag.AsmInput))
    } else if (dir == "result") {
      advance(p)
      result = parseAsmOperand(p, Tag.AsmResult)
    } else if (dir == "clobber") {
      advance(p)
      let isX64 = peekKind(p) == Kind.Ident && curText(p) == "x64"
      let arch = expectIdent(p)
      let clob = parseAsmClobber(p)
      if (isX64) {
        clobX64 = clob
      } else {
        clobArm64 = clob
      }
    } else {
      parseFail(p, "an asm directive (x64, arm64, input, result, clobber)")
      break
    }
    guard = guard + 1
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let kids = [x64Code, arm64Code, result, clobX64, clobArm64]
  for inp of inputs {
    kids = append(kids, inp)
  }
  return mkSpanNode(p, Tag.AsmStmt, isVolatile, kids, kwStart, rbEnd)
}

// `{ int_lit, ... }` — one target's pre-encoded bytes (x64) / words (arm64).
fn parseAsmCode(p: Parser): int {
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  if (peekKind(p) != Kind.RBrace) {
    items = append(items, parseAsmInt(p))
    while (peekKind(p) == Kind.Comma || peekKind(p) == Kind.Semicolon) {
      advance(p)
      if (peekKind(p) == Kind.RBrace) {
        break
      }
      items = append(items, parseAsmInt(p))
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  return mkSpanNode(p, Tag.AsmCode, 0, items, lbStart, rbEnd)
}

fn parseAsmInt(p: Parser): int {
  if (peekKind(p) != Kind.IntLit) {
    parseFail(p, "an integer")
    return 0
  }
  return leaf(p, Tag.IntLit)
}

// `arm64 <reg> x64 <reg> ( = expr | : type )`.
fn parseAsmOperand(p: Parser, tag: Tag): int {
  expectWord(p, "arm64")
  let arm64Reg = expectIdent(p)
  expectWord(p, "x64")
  let x64Reg = expectIdent(p)
  if (tag == Tag.AsmInput) {
    expect(p, Kind.Eq)
    let val = parseExpr(p)
    return mkNode(p, Tag.AsmInput, 0, [arm64Reg, x64Reg, val])
  }
  expect(p, Kind.Colon)
  let ty = parseType(p)
  return mkNode(p, Tag.AsmResult, 0, [arm64Reg, x64Reg, ty])
}

// `{ reg_ident, ... }` — clobbered registers (may include `memory`).
fn parseAsmClobber(p: Parser): int {
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  if (peekKind(p) != Kind.RBrace) {
    items = append(items, expectIdent(p))
    while (peekKind(p) == Kind.Comma || peekKind(p) == Kind.Semicolon) {
      advance(p)
      if (peekKind(p) == Kind.RBrace) {
        break
      }
      items = append(items, expectIdent(p))
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  return mkSpanNode(p, Tag.AsmClobber, 0, items, lbStart, rbEnd)
}
