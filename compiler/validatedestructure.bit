// Self-host: the `let (a, b) = e` half of §10.1's destructuring rule (#4718).
//
// `checkTupleBinders` (checkbind.bit) types a tuple pattern's binders against
// the initializer's elements, and returns SILENTLY twice: when the initializer
// is not a tuple type at all, and when its arity differs from the binder count.
// Neither return binds anything and neither reports, so the binders keep
// whatever type the name last had in scope and `bit check` exits 0 on a program
// the compiler cannot lower — `fcFail` (lower.bit) refuses both shapes as
// E0092 "cannot lower a tuple destructure whose right side is not a tuple",
// spanless and after a clean check. #4488 lost a build to exactly that: a
// return type changed from `(string, string)` to a class, nine destructuring
// call sites left behind, `bit check compiler` silent.
//
// This file asks the two questions the checker was not asking. The lowerer's
// refusals stay as the backstop: the checker catching it first is the fix, not
// a reason to remove them. The assignment form `(a, b) = rhs` is already
// covered by `vDestructure` (validateiface.bit) and is not touched here.
//
// A class is NOT made destructurable positionally — `Pair{a, b}` is a class,
// not a tuple, and the whole value of the lowerer's refusal was that it said so.

// The initializer type a `let`/`var` tuple pattern on `node` (`Tag.Binding`) is
// asking to split, or 0 when this binding is not one E0041 can judge.
//
// THE SAFETY RULE (validate.bit): an inference gap must never become a spurious
// diagnostic on code the previous release accepts. So an initializer that did
// not infer (`0`), mentions `invalid`, or still carries an open type parameter
// — a generic's body, judged per monomorphization — is left alone, exactly as
// `vForOfSplitElem` (validateloop.bit) leaves the same three.
fn vLetSplitInit(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node) // [pat, annotation, init]
  if (len(kids) < 3 || kids[2] == 0) {
    return 0
  }
  if (getNode(c.tree, kids[0]).tag != Tag.TuplePat) {
    return 0
  }
  if (len(kidsOf(c.tree, kids[0])) == 2 && vTwoResultForm(c, kids[2])) {
    return 0
  }
  let ty = checkExprType(c, kids[2])
  if (vMentionsInvalid(c, ty, 0) || vHasTypeParam(c, ty, 0)) {
    return 0
  }
  return ty
}

// True for an initializer SPELLED as one of the two-result forms `m[k]`, `<- c`
// or `x.(T)` (§12.6/§16/§14.7), whose pair is a receive/lookup/assertion result
// rather than a tuple — `checkCommaOk` (checkbind.bit) types those itself and
// never reaches `checkTupleBinders`.
//
// Conservative in the same direction `vDestructure` chose for the assignment
// form: the TAG alone is enough to skip, without asking whether the receiver is
// really a map. A slice-of-tuples index is a one-result read that this waves
// through unjudged — a missing diagnostic, never a false positive on valid code.
fn vTwoResultForm(c: Checker, init: int): bool {
  let n = getNode(c.tree, init)
  if (n.tag == Tag.Index || n.tag == Tag.TypeAssert) {
    return true
  }
  return n.tag == Tag.Unary && n.main == int(Kind.ArrowLeft)
}

// Reports E0041 when the pattern `pat` cannot split the type `ty`: it is not a
// tuple, or it is a tuple of a different arity than the pattern names. Recurses
// into a nested pattern only once the level above it matched, so one mismatch
// is reported once, at the outermost level that is wrong.
//
// E0041 rather than a code of its own, per §14.5: this is the binding's declared
// shape disagreeing with its initializer's type, which is what `ecTypeMismatch`
// already says everywhere else a binding is judged — including `vDestructure`'s
// verdict on the assignment spelling of this same rule.
fn vTupleSplit(c: Checker, pat: int, ty: int) {
  let binders = kidsOf(c.tree, pat)
  let tn = typeName(c.ctx, ty)
  if (c.ctx.types[ty].kind != TypeKind.Tuple) {
    report(
      c.diags, ecTypeMismatch, vSpan(c, pat),
      "'${tn}' has no parts to split (§10.1)",
      "a tuple pattern destructures a tuple-typed initializer; bind it to a single name instead",
    )
    return
  }
  let members = c.ctx.types[ty].members
  if (len(members) != len(binders)) {
    report(
      c.diags, ecTypeMismatch, vSpan(c, pat),
      "'${tn}' has ${len(members)} parts, but this pattern names ${len(binders)} (§10.1)",
      "name one binder per part",
    )
    return
  }
  let i = 0
  while (i < len(binders)) {
    if (getNode(c.tree, binders[i]).tag == Tag.TuplePat) {
      vTupleSplit(c, binders[i], members[i])
    }
    i = i + 1
  }
}

// Wired from `vStmt`'s `Tag.Binding` arm (validatestmt.bit), beside `vBinding`
// — which judges the ANNOTATED, non-tuple shape and explicitly hands the tuple
// pattern on.
fn vLetDestructure(c: Checker, node: int) {
  let ty = vLetSplitInit(c, node)
  if (ty == 0) {
    return
  }
  vTupleSplit(c, kidsOf(c.tree, node)[0], ty)
}
