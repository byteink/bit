// Self-host (#3329, epic #3322): in-Bit self-checks for pelink.bit's PE32+
// linker. Split out (docs/development.md's file-size rule) rather than folded
// into pelink.bit, mirroring elflinkcheck.bit's own split from elflink.bit.
//
// These are structural checks, run in-process with no Windows host — the real
// proof is execution, which needs mustafa-desktop-win (epic #3322's SSH-host
// comment). Every hand-written x86-64 byte sequence below was independently
// verified with a real disassembler before being committed (assembled as raw
// `.byte` directives via `clang -target x86_64-apple-macos -c` and read back
// with `objdump -d`), not merely hand-derived — see the ticket comment for the
// transcript. checkPeLinkDerisk's payload is exactly what was run on the box.
//
// checkPeLinkDerisk optionally writes its produced .exe to
// envOr("BIT_PE_DERISK_OUT", "") when that path is non-empty. Inert during
// `bit selfcheck`/`./make test` (the var is never set there); used only to
// hand real bytes to an external SSH run against mustafa-desktop-win.

// ---- shared probe helpers --------------------------------------------------

fn plErr(inputs: []PlLinkInput, allowedImports: []string): string {
  let msg = ""
  let e = linkPe(inputs, allowedImports) catch err {
    msg = err.message()
    []u8(0)
  }
  return msg
}

fn plWriteProbe(sections: []PeSection, symbols: []PeSymbol, relocs: []PeRelocation): []u8 {
  let obj = PeObject{ sections: sections, symbols: symbols, relocations: relocs }
  return writePeObject(PeTarget.X86_64, obj) catch e { []u8(0) }
}

fn plNumSections(b: []u8): int {
  return leAt(b, plLfanew() + 4 + 2, 2)
}

fn plSectionHeaderAt(n: int): int {
  return plLfanew() + 4 + sizeofPeFileHeader() + plOptionalHeaderSize() + n * sizeofPeSectionHeader()
}

struct PlFoundSection {
  found: bool,
  sh: int,
}

// Finds a section by its exact NUL-padded 8-byte name, scanning the section
// table the same way a real PE parser would (never assuming a fixed index).
fn plFindSection(b: []u8, name: string): PlFoundSection {
  let n = plNumSections(b)
  let nameBytes = []byte(name)
  let i = 0
  while (i < n) {
    let sh = plSectionHeaderAt(i)
    let matches = true
    let k = 0
    while (k < 8) {
      let want = u8(0)
      if (k < len(nameBytes)) {
        want = nameBytes[k]
      }
      if (b[sh + k] != want) {
        matches = false
      }
      k = k + 1
    }
    if (matches) {
      return PlFoundSection{ found: true, sh: sh }
    }
    i = i + 1
  }
  return PlFoundSection{ found: false, sh: 0 }
}

// True if `needle` occurs literally anywhere in b[start:end) — used to find a
// hint/name entry in .idata without depending on its exact computed offset.
fn plContainsAt(b: []u8, start: int, end: int, needle: []u8): bool {
  let n = len(needle)
  let p = start
  while (p + n <= end) {
    let matches = true
    let k = 0
    while (k < n) {
      if (b[p + k] != needle[k]) {
        matches = false
      }
      k = k + 1
    }
    if (matches) {
      return true
    }
    p = p + 1
  }
  return false
}

// ---- pure relocation math, no object writer involved -----------------------

// Empirically pins the addend convention pereader.bit/pelink.bit share for a
// COFF Rel32 field: the raw field bytes must already hold -4 (FC FF FF FF),
// the same "REL-style implicit addend" pereader.bit's own header comment
// describes. `_start` (call rel32) is placed immediately before `helper`
// (ret), both alignment 1, so the mathematically correct disp32 is exactly 0
// — this is a property of the call being to the very next byte, independent
// of load address, so it isolates the addend convention from everything else
// in the pipeline.
fn checkPeLinkPc32Addend() {
  let startAtom = LoAtom{ name: "_start", kind: LoSectionKind.Text, binding: LoBinding.Global,
    data: [u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF)], size: 5, alignment: 1, weak: false,
    relocs: [LoReloc{ offset: 1, kind: LoRelocKind.Pc32, target: loLocalRef(1), addend: -4 }] }
  let helperAtom = LoAtom{ name: "helper", kind: LoSectionKind.Text, binding: LoBinding.Local,
    data: [u8(0xC3)], size: 1, alignment: 1, weak: false, relocs: []LoReloc(0) }
  let mod = LoModule{ name: "m", atoms: [startAtom, helperAtom] }
  let exe = linkPeExecutable([mod], 1, []string(0)) catch e { []u8(0) }
  assert(len(exe) > 0)

  let textSec = plFindSection(exe, ".text")
  assert(textSec.found)
  let textFileOff = leAt(exe, textSec.sh + 20, 4)
  assert(leAt(exe, textFileOff + 1, 4) == 0)
}

// ---- structural checks over a real writePeObject round-trip ----------------

// A minimal single-import program: `_start` calls ExitProcess and nothing
// else. Bytes verified with objdump (module comment); reloc field offset 11
// is `call`'s opcode (index 10) + 1.
fn plMinimalCode(): []u8 {
  return [u8(0x48), u8(0x83), u8(0xE4), u8(0xF0), // and rsp,-16
    u8(0x48), u8(0x83), u8(0xEC), u8(0x20),       // sub rsp,0x20
    u8(0x31), u8(0xC9),                            // xor ecx,ecx
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF)] // call ExitProcess
}

fn checkPeLinkRaw() {
  let code = plMinimalCode()
  let bytes = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "ExitProcess", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 11, symbol: "ExitProcess", kind: PeRelocKind.Rel32 }])
  let inputs = [plObjectInput(bytes)]
  // "ExitProcess" is referenced from the PROGRAM object (not an archive
  // member), so plUndefinedIsImport requires it declared here — mirrors a
  // real compiled Bit program's §11.7 extern declarations.
  let allowed = ["ExitProcess"]
  assert(plErr(inputs, allowed) == "")
  let exe = linkPe(inputs, allowed) catch e { []u8(0) }

  assert(exe[0] == u8(77) && exe[1] == u8(90)) // "MZ"
  assert(leAt(exe, 0x3C, 4) == plLfanew())
  let sigOff = plLfanew()
  assert(exe[sigOff] == u8(80) && exe[sigOff + 1] == u8(69) &&
    exe[sigOff + 2] == u8(0) && exe[sigOff + 3] == u8(0)) // "PE\0\0"
  assert(leAt(exe, sigOff + 4, 2) == 0x8664) // IMAGE_FILE_MACHINE_AMD64

  let optOff = sigOff + 4 + sizeofPeFileHeader()
  assert(leAt(exe, optOff, 2) == 0x020B) // IMAGE_NT_OPTIONAL_HDR64_MAGIC
  assert(leAt(exe, optOff + 68, 2) == 3) // IMAGE_SUBSYSTEM_WINDOWS_CUI

  let entryRva = leAt(exe, optOff + 16, 4)
  assert(entryRva > 0)
  let sizeOfImage = leAt(exe, optOff + 56, 4)
  assert(sizeOfImage % plSectionAlign() == 0)

  let textSec = plFindSection(exe, ".text")
  assert(textSec.found)
  let textRva = leAt(exe, textSec.sh + 12, 4)
  let textVsize = leAt(exe, textSec.sh + 8, 4)
  // AddressOfEntryPoint lands inside .text's virtual range.
  assert(entryRva >= textRva && entryRva < textRva + textVsize)
  // SizeOfImage is consistent with the section table: it covers every byte
  // the sections claim.
  assert(sizeOfImage >= textRva + textVsize)
}

// THE ELF ASSUMPTION CANNOT SILENTLY CARRY OVER: assert SectionAlignment and
// FileAlignment are handled independently, by showing .text's RVA and file
// offset genuinely differ, and that the code lands correctly at the FILE
// offset (not at rva-as-if-it-were-a-file-offset).
fn checkPeLinkAlignmentDiffers() {
  let code = plMinimalCode()
  let bytes = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "ExitProcess", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 11, symbol: "ExitProcess", kind: PeRelocKind.Rel32 }])
  let exe = linkPe([plObjectInput(bytes)], ["ExitProcess"]) catch e { []u8(0) }

  let textSec = plFindSection(exe, ".text")
  assert(textSec.found)
  let rva = leAt(exe, textSec.sh + 12, 4)
  let fileOff = leAt(exe, textSec.sh + 20, 4)
  assert(rva != fileOff)
  assert(rva == plSectionAlign())  // .text is the first section: one page in.
  assert(fileOff < rva)            // headers need far less than a full page on disk.
  assert(fileOff % plFileAlign() == 0)
  assert(rva % plSectionAlign() == 0)

  // The code lands correctly at the FILE offset: every byte up to the
  // relocation field (offset 11, patched with the real rel32 displacement by
  // the linker — module comment on plMinimalCode) matches verbatim.
  let i = 0
  while (i < 11) {
    assert(exe[fileOff + i] == code[i])
    i = i + 1
  }
}

// The import directory names kernel32.dll (the only DLL these three symbols
// admit) for the symbols actually referenced, and the IAT entry count matches
// the referenced import count. Bytes verified with objdump (module comment).
fn checkPeLinkImports() {
  let code = [
    u8(0x48), u8(0x83), u8(0xE4), u8(0xF0),
    u8(0x48), u8(0x83), u8(0xEC), u8(0x30),
    u8(0xB9), u8(0xF5), u8(0xFF), u8(0xFF), u8(0xFF),
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),          // call GetStdHandle (off 14)
    u8(0x48), u8(0x89), u8(0xC1),
    u8(0x48), u8(0x8D), u8(0x15), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF), // lea rdx,[rip+msg] (off 24)
    u8(0x41), u8(0xB8), u8(0x02), u8(0x00), u8(0x00), u8(0x00),
    u8(0x4C), u8(0x8D), u8(0x4C), u8(0x24), u8(0x28),
    u8(0x48), u8(0xC7), u8(0x44), u8(0x24), u8(0x20), u8(0x00), u8(0x00), u8(0x00), u8(0x00),
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),           // call WriteFile (off 49)
    u8(0x31), u8(0xC9),
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF)]           // call ExitProcess (off 56)
  let msg = []byte("hi")
  let bytes = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 },
     PeSection{ kind: PeSectionKind.Rodata, data: msg, size: 0, alignment: 1 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "msg", hasSection: true, section: PeSectionKind.Rodata,
        offset: 0, size: len(msg), binding: PeBinding.Local, kind: PeSymKind.Object },
     PeSymbol{ name: "GetStdHandle", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype },
     PeSymbol{ name: "WriteFile", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype },
     PeSymbol{ name: "ExitProcess", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 14, symbol: "GetStdHandle", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 24, symbol: "msg", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 49, symbol: "WriteFile", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 56, symbol: "ExitProcess", kind: PeRelocKind.Rel32 }])
  let inputs = [plObjectInput(bytes)]
  let allowed = ["GetStdHandle", "WriteFile", "ExitProcess"]
  assert(plErr(inputs, allowed) == "")
  let exe = linkPe(inputs, allowed) catch e { []u8(0) }

  let idataSec = plFindSection(exe, ".idata")
  assert(idataSec.found)
  let idataRva = leAt(exe, idataSec.sh + 12, 4)
  let idataFileOff = leAt(exe, idataSec.sh + 20, 4)
  let idataFileEnd = idataFileOff + leAt(exe, idataSec.sh + 16, 4)

  // IAT data directory (index 12): 3 real imports + 1 null-terminator thunk,
  // each 8 bytes (PE32+ IMAGE_THUNK_DATA64).
  let optOff = plLfanew() + 4 + sizeofPeFileHeader()
  let iatDirOff = optOff + 112 + 12 * 8
  assert(leAt(exe, iatDirOff + 4, 4) == 4 * 8)

  // The import descriptor names kernel32.dll — the only DLL pesyms.bit admits
  // for any of these three symbols.
  let dllNameRva = leAt(exe, idataFileOff + 12, 4)
  let dllNameFileOff = idataFileOff + (dllNameRva - idataRva)
  let want = []byte("kernel32.dll")
  let k = 0
  while (k < len(want)) {
    assert(exe[dllNameFileOff + k] == want[k])
    k = k + 1
  }

  // Every referenced symbol's hint/name entry is present.
  assert(plContainsAt(exe, idataFileOff, idataFileEnd, []byte("GetStdHandle")))
  assert(plContainsAt(exe, idataFileOff, idataFileEnd, []byte("WriteFile")))
  assert(plContainsAt(exe, idataFileOff, idataFileEnd, []byte("ExitProcess")))
}

// Links a Bit "program" object plus a "libbitrt member" (an ar archive) into
// one .exe: `_start` calls `helper`, defined only in the archive member,
// which itself calls the kernel32 import ExitProcess. Exercises
// selectArchiveMembers (helper is pulled in lazily) and confirms an archive
// member's own undefined names become imports with an empty allowedImports —
// that list gates the PROGRAM object only (plUndefinedIsImport). Bytes
// verified with objdump (module comment).
fn checkPeLinkArchiveMember() {
  let startCode = [u8(0x48), u8(0x83), u8(0xE4), u8(0xF0),
    u8(0x48), u8(0x83), u8(0xEC), u8(0x20),
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF)] // call helper (off 9)
  let progBytes = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: startCode, size: 0, alignment: 16 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(startCode), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "helper", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 9, symbol: "helper", kind: PeRelocKind.Rel32 }])

  let helperCode = plMinimalCode() // "and rsp,-16;sub rsp,0x20;xor ecx,ecx;call ExitProcess", reused verbatim
  let memberBytes = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: helperCode, size: 0, alignment: 16 }],
    [PeSymbol{ name: "helper", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(helperCode), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "ExitProcess", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 11, symbol: "ExitProcess", kind: PeRelocKind.Rel32 }])

  let arBytes = writeArchive([ArMember{ name: "helper.obj", data: memberBytes }], arFormatGnu())
  let inputs = [plObjectInput(progBytes), plArchiveInput(arBytes)]
  assert(plErr(inputs, []string(0)) == "")
  let exe = linkPe(inputs, []string(0)) catch e { []u8(0) }
  assert(len(exe) > 0)
  assert(exe[0] == u8(77) && exe[1] == u8(90))

  let idataSec = plFindSection(exe, ".idata")
  assert(idataSec.found) // ExitProcess, reached only through the pulled-in member, is an import
  assert(plContainsAt(exe, leAt(exe, idataSec.sh + 20, 4),
    leAt(exe, idataSec.sh + 20, 4) + leAt(exe, idataSec.sh + 16, 4), []byte("ExitProcess")))
}

fn checkPeLinkRejects() {
  // Nothing defines _start.
  let code = [u8(0xC3)]
  let bytes = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 }],
    [PeSymbol{ name: "bit_main", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: 1, binding: PeBinding.Global, kind: PeSymKind.Func }],
    []PeRelocation(0))
  assert(plErr([plObjectInput(bytes)], []string(0)) != "")

  // An undefined symbol the program object references, that is neither
  // defined nor a declared extern, is a link error — not a silently-guessed
  // import. "nowhere" is not a real Windows API on purpose: this rejection
  // fires at the allowedImports gate, before pesyms.bit is ever consulted.
  let code2 = [u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF), u8(0xC3)]
  let bytes2 = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code2, size: 0, alignment: 16 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code2), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "nowhere", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 1, symbol: "nowhere", kind: PeRelocKind.Rel32 }])
  assert(plErr([plObjectInput(bytes2)], []string(0)) != "")

  // The same SHAPE of reference is accepted once declared as an allowed
  // extern that pesyms.bit also admits — proving the rejection above was
  // about admissibility, not shape. Reuses "ExitProcess" (a real admitted
  // import) rather than "nowhere", which pesyms.bit would still refuse.
  let bytes3 = plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code2, size: 0, alignment: 16 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code2), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "ExitProcess", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 1, symbol: "ExitProcess", kind: PeRelocKind.Rel32 }])
  assert(plErr([plObjectInput(bytes3)], ["ExitProcess"]) == "")
}

// A direct LoModule-level test of the Abs64-to-import rejection: this
// compiler never takes an extern function's address as data, only ever calls
// it (module comment on pelink.bit), so an absolute pointer to an import is
// refused rather than silently mis-linked.
fn checkPeLinkAbs64ImportRejected() {
  let data = [u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0)]
  let startAtom = LoAtom{ name: "_start", kind: LoSectionKind.Data, binding: LoBinding.Global,
    data: data, size: 8, alignment: 8, weak: false,
    relocs: [LoReloc{ offset: 0, kind: LoRelocKind.Abs64, target: loGlobalRef("SomeImport"), addend: 0 }] }
  let mod = LoModule{ name: "m", atoms: [startAtom] }
  let msg = ""
  let r = linkPeExecutable([mod], 1, ["SomeImport"]) catch e {
    msg = e.message()
    []u8(0)
  }
  assert(len(r) == 0)
  assert(msg != "")
}

// Direct unit test of plBuildIdataLayout/plBuildIdataBytes with TWO synthetic
// DLL groups, bypassing plGroupByDll/pesyms.bit entirely (pesyms.bit admits
// only kernel32.dll today — #3328's own scope note — so this is the only way
// to exercise the N-DLL machinery pelink.bit generalizes to). Confirms each
// DLL's ILT/IAT/name regions are correctly sized, non-overlapping, and that
// each descriptor points at the right DLL's own chunk.
fn checkPlBuildIdataLayoutMultiDll() {
  let g = PlDllGroups{
    dlls: ["kernel32.dll", "ntdll.dll"],
    start: [0, 2],
    count: [2, 1],
    names: ["ExitProcess", "WriteFile", "NtSomething"] }
  let layout = plBuildIdataLayout(g)
  assert(layout.descriptorTableSize == 3 * 20) // 2 real + 1 null terminator
  assert(len(layout.dllIltOff) == 2)
  assert(len(layout.dllIatOff) == 2)
  // dll0's ILT (2+1 thunks) must not overlap dll1's ILT (1+1 thunks).
  assert(layout.dllIltOff[1] == layout.dllIltOff[0] + (g.count[0] + 1) * 8)
  // All ILTs precede all IATs (module comment: the IAT data directory needs
  // one contiguous region).
  assert(layout.dllIatOff[0] >= layout.dllIltOff[1] + (g.count[1] + 1) * 8)
  assert(layout.dllIatOff[1] == layout.dllIatOff[0] + (g.count[0] + 1) * 8)

  let idataRva = 0x2000
  let bytes = plBuildIdataBytes(layout, g, idataRva)
  assert(len(bytes) == layout.totalSize)
  // Descriptor 0 (kernel32.dll) points at its own ILT/IAT/name, not dll1's.
  assert(leAt(bytes, 0, 4) == idataRva + layout.dllIltOff[0])
  assert(leAt(bytes, 12, 4) == idataRva + layout.dllNameOff[0])
  assert(leAt(bytes, 16, 4) == idataRva + layout.dllIatOff[0])
  // Descriptor 1 (ntdll.dll).
  assert(leAt(bytes, 20, 4) == idataRva + layout.dllIltOff[1])
  assert(leAt(bytes, 20 + 12, 4) == idataRva + layout.dllNameOff[1])
  assert(leAt(bytes, 20 + 16, 4) == idataRva + layout.dllIatOff[1])
  // Descriptor 2 is the all-zero null terminator.
  assert(leAt(bytes, 40, 20) == 0)
  // Both DLL name strings are present.
  assert(plContainsAt(bytes, 0, len(bytes), []byte("kernel32.dll")))
  assert(plContainsAt(bytes, 0, len(bytes), []byte("ntdll.dll")))
  assert(plContainsAt(bytes, 0, len(bytes), []byte("NtSomething")))
}

// ---- the real de-risk payload: run on mustafa-desktop-win over SSH --------

// _start: GetStdHandle(STD_OUTPUT_HANDLE); GetConsoleMode(handle, &mode);
// print "csl=0\n" or "csl=1\n" depending on whether GetConsoleMode succeeded
// (the "console handle arrangement" the epic's SSH-host comment asks a test
// program to report, chosen because it needs no branch — a
// setnz/movzx/imul/add sequence selects between the two fixed messages);
// ExitProcess(0). Every instruction and every relocation offset below was
// verified with objdump against this exact byte sequence (module comment).
fn plDeriskCode(): []u8 {
  return [
    u8(0x48), u8(0x83), u8(0xE4), u8(0xF0),                               // and rsp,-16
    u8(0x48), u8(0x83), u8(0xEC), u8(0x30),                               // sub rsp,0x30
    u8(0xB9), u8(0xF5), u8(0xFF), u8(0xFF), u8(0xFF),                     // mov ecx,STD_OUTPUT_HANDLE
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                     // call GetStdHandle (off 14)
    u8(0x49), u8(0x89), u8(0xC4),                                         // mov r12,rax
    u8(0x4C), u8(0x89), u8(0xE1),                                         // mov rcx,r12
    u8(0x48), u8(0x8D), u8(0x54), u8(0x24), u8(0x20),                     // lea rdx,[rsp+0x20]
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                     // call GetConsoleMode (off 30)
    u8(0x85), u8(0xC0),                                                   // test eax,eax
    u8(0x0F), u8(0x95), u8(0xC0),                                         // setnz al
    u8(0x0F), u8(0xB6), u8(0xC0),                                         // movzx eax,al
    u8(0x6B), u8(0xC0), u8(0x06),                                         // imul eax,eax,6
    u8(0x48), u8(0x8D), u8(0x15), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF), // lea rdx,[rip+msgs] (off 48)
    u8(0x48), u8(0x01), u8(0xC2),                                         // add rdx,rax
    u8(0x4C), u8(0x89), u8(0xE1),                                         // mov rcx,r12
    u8(0x41), u8(0xB8), u8(0x06), u8(0x00), u8(0x00), u8(0x00),           // mov r8d,6
    u8(0x4C), u8(0x8D), u8(0x4C), u8(0x24), u8(0x28),                     // lea r9,[rsp+0x28]
    u8(0x48), u8(0xC7), u8(0x44), u8(0x24), u8(0x20), u8(0x00), u8(0x00), u8(0x00), u8(0x00), // mov qword[rsp+0x20],0
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF),                     // call WriteFile (off 79)
    u8(0x31), u8(0xC9),                                                   // xor ecx,ecx
    u8(0xE8), u8(0xFC), u8(0xFF), u8(0xFF), u8(0xFF)]                     // call ExitProcess (off 86)
}

fn plDeriskBytes(): []u8 {
  let code = plDeriskCode()
  let msgs = []byte("csl=0\ncsl=1\n")
  return plWriteProbe(
    [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 },
     PeSection{ kind: PeSectionKind.Rodata, data: msgs, size: 0, alignment: 1 }],
    [PeSymbol{ name: "_start", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code), binding: PeBinding.Global, kind: PeSymKind.Func },
     PeSymbol{ name: "msgs", hasSection: true, section: PeSectionKind.Rodata,
        offset: 0, size: len(msgs), binding: PeBinding.Local, kind: PeSymKind.Object },
     PeSymbol{ name: "GetStdHandle", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype },
     PeSymbol{ name: "GetConsoleMode", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype },
     PeSymbol{ name: "WriteFile", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype },
     PeSymbol{ name: "ExitProcess", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype }],
    [PeRelocation{ section: PeSectionKind.Text, offset: 14, symbol: "GetStdHandle", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 30, symbol: "GetConsoleMode", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 48, symbol: "msgs", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 79, symbol: "WriteFile", kind: PeRelocKind.Rel32 },
     PeRelocation{ section: PeSectionKind.Text, offset: 86, symbol: "ExitProcess", kind: PeRelocKind.Rel32 }])
}

fn checkPeLinkDerisk() {
  let bytes = plDeriskBytes()
  let inputs = [plObjectInput(bytes)]
  let allowed = ["GetStdHandle", "GetConsoleMode", "WriteFile", "ExitProcess"]
  assert(plErr(inputs, allowed) == "")
  let exe = linkPe(inputs, allowed) catch e { []u8(0) }
  assert(len(exe) > 0)
  assert(exe[0] == u8(77) && exe[1] == u8(90))
  let optOff = plLfanew() + 4 + sizeofPeFileHeader()
  assert(leAt(exe, optOff, 2) == 0x020B)
  let entryRva = leAt(exe, optOff + 16, 4)
  let textSec = plFindSection(exe, ".text")
  assert(textSec.found)
  let textRva = leAt(exe, textSec.sh + 12, 4)
  let textVsize = leAt(exe, textSec.sh + 8, 4)
  assert(entryRva >= textRva && entryRva < textRva + textVsize)
  let idataSec = plFindSection(exe, ".idata")
  assert(idataSec.found) // GetStdHandle, GetConsoleMode, WriteFile, ExitProcess

  let outPath = envOr("BIT_PE_DERISK_OUT", "")
  if (outPath != "") {
    writeFile(outPath, string(exe)) catch e { }
  }
}
