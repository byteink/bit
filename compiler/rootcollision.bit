// compiler/rootcollision.bit — E0096 (#2958, SPEC §11.7): a root-module
// function's bare link name colliding with a symbol the linked runtime
// resolves externally, and #2985's `bit test` answer to the same collision.
// Split out of build.bit, which was at 821/800 lines with this block inline —
// the same over-limit shape #2740/#2747 hit elsewhere, fixed the same way (a
// sibling `.bit` file, not a raised limit). A sibling file is the same
// module, so `Checker`/`BuildTarget`/`Project`/`report`/`remapDiags`/
// `isGenericFuncDecl`/`machoArchiveExterns`/`elfArchiveExterns` need no
// import here, and `buildIr` (build.bit) calls into this file with no import
// either.

// E0096 (#2958, SPEC §11.7): a root-module function's bare link name collides
// with a symbol the linked runtime archive resolves externally. First free
// code above E0095 at the time this was assigned (checkbind.bit's
// ecMethodReceiverKind, since removed by #3811 as permanently unreachable
// after #3762 deleted the written receiver-form grammar).
const ecRootNameCollision = 96

// The runtime archive's OWN extern surface for `target` — every name some
// member of `rtArchive` references without any member defining it, derived
// straight from the archive bytes rather than a hand-picked list of libc
// names. See machoArchiveExterns/elfArchiveExterns for the per-format read;
// this only dispatches on target the same way externResolvable does.
fn linkedExternNames(target: BuildTarget, rtArchive: []u8): map<string, bool> {
  if (isMachoTarget(target)) {
    return machoArchiveExterns(rtArchive)
  }
  return elfArchiveExterns(elfLinkTargetOf(target), rtArchive)
}

// One of `root`'s own top-level function declarations whose bare LINK name
// collides with a symbol the linked runtime resolves externally (§11.7).
class RootCollision {
  name: string,
  decl: int,
}

// §11.7 (#2958): the root module keeps every top-level function's link name
// BARE — `modulePrefix`/`moduleQualified` return "" for the root so `main`
// stays `main` and a single-module build stays byte-identical — which
// `emit.bit`'s isPinnedName assumed made it disjoint from every resolvable
// extern spelling ("disjoint by construction" via '$'). That is false for the
// root: a root `fn listen` ALSO defines the bare symbol `_listen`, and on
// Darwin's flat namespace the final link then binds the runtime's own extern
// call (runtime/net/darwin/sock.bit's `extern fn listen`, ultimately
// libSystem's listen(2)) to the user's function instead of to libSystem —
// silently, and not always as a crash: a root `fn write` makes every
// `println` print nothing, at exit 0.
//
// The comparison set (`linkedExternNames`) is derived from the actual linked
// `rtArchive`, never a fixed list of libc names — a hand-picked list would
// both miss a symbol this exact runtime calls and reject a name that cannot
// collide with it, and a false rejection here is worse than the bug it
// replaces. `linking` mirrors rejectExternForTarget: `--emit-obj` performs no
// link, so nothing can collide yet.
//
// Scans ONLY, reports nothing — shared by `rejectRootNameCollision` below
// (`bit build`/`bit run`: reject) and `bit test`'s own path
// (`demangleTestRootCollisions`, testgen.bit: rename instead, #2985), so the
// two can never disagree on WHAT collides, only on what happens next.
fn collidingRootDecls(root: Checker, target: BuildTarget, rtArchive: []u8,
    linking: bool): []RootCollision {
  let out = []RootCollision(0)
  if (!linking) { return out }
  let externs = linkedExternNames(target, rtArchive)
  if (len(externs) == 0) { return out }
  for top of kidsOf(root.tree, root.tree.root) {
    if (top == 0) { continue }
    let inner = top
    if (getNode(root.tree, top).tag == Tag.Export) {
      inner = kidsOf(root.tree, top)[0]
    }
    if (getNode(root.tree, inner).tag != Tag.FuncDecl) { continue }
    let kids = kidsOf(root.tree, inner) // [recv, name, generics, params, result, body]
    if (kids[0] != 0) { continue } // a method: namespaced by its receiver type, never bare
    if (isGenericFuncDecl(root, inner)) { continue } // never emitted bare; only its instances are
    let nameNode = getNode(root.tree, kids[1])
    let name = root.source[nameNode.span.start:nameNode.span.end]
    let (_, collides) = externs[name]
    if (!collides) { continue }
    out = append(out, RootCollision{ name: name, decl: inner })
  }
  return out
}

fn rejectRootNameCollision(root: Checker, target: BuildTarget, rtArchive: []u8,
    linking: bool): bool {
  let cols = collidingRootDecls(root, target, rtArchive, linking)
  if (len(cols) == 0) { return false }
  let before = len(root.diags.list)
  for col of cols {
    report(root.diags, ecRootNameCollision, getNode(root.tree, col.decl).span,
      "function '${col.name}' has the same link name as a symbol the runtime resolves externally (SPEC §11.7)",
      "the root module keeps bare link names, so this would also bind the runtime's own extern call; rename '${col.name}' to something that does not collide")
  }
  remapDiags(root.diags, before, root.files, root.fileStarts)
  return true
}
