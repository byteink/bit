// compiler/lowerspawn.bit — `spawn` of a closure VALUE (#6717): `spawn { ... }`
// and `spawn (() => ...)(args)`. Sibling of lowerfuncval.bit, which holds the
// direct-call `spawn f(args)` (lowerSpawn) and the pieces this reuses
// (layoutFields, packSpawnThunk, emitSpawnCall, finishSpawnTrampoline).

// The trampoline `spawn$trampoline$<fid>(env)` for a closure target. The thunk
// holds the closure value in field 0 and its arguments after it; the trampoline
// reads them back and dispatches through `Op.CallValue`, the one-handle
// convention every closure call uses (an argument is never exploded into words,
// so no `explodeCallArgs` here). The result of the closure is discarded.
fn synthSpawnValueTrampoline(fc: FnCtx, cty: int, fty: int, layout: StructLayout): int {
  let ft = fc.c.ctx.types[cty]
  let b = newBuilder()
  builderBeginBlock(b, builderNewBlock(b))
  builderAddParam(b, fty)
  let fv = mkInstr(Op.FieldGet, cty)
  fv.lhs = 0
  fv.ival = layout.offsets[0]
  let callee = builderEmit(b, fv)
  let args = []int(0)
  let i = 0
  while (i < len(ft.members)) {
    let fg = mkInstr(Op.FieldGet, ft.members[i])
    fg.lhs = 0
    fg.ival = layout.offsets[i + 1]
    args = append(args, builderEmit(b, fg))
    i = i + 1
  }
  let call = mkInstr(Op.CallValue, unwrapFallible(fc.c, ft.result))
  call.lhs = callee
  call.args = args
  builderEmit(b, call)
  return finishSpawnTrampoline(fc, b, fty)
}

// `spawn <callee>(args)` where `callee` is any expression of function type: the
// callee value and the arguments are evaluated HERE, on the spawning thread
// (SPEC §16.1, §13.7), and packed into the thunk; only the call itself runs on
// the new thread. A closure captures like any other (lowerArrowFn), so what
// `spawn { ... }` mentions of the enclosing function is captured at this point.
fn lowerSpawnValue(fc: FnCtx, call: int, callee: int) {
  let cty = nodeType(fc, callee)
  if (cty == 0 || fc.c.ctx.types[cty].kind != TypeKind.Func) {
    fcFail(
      fc,
      getNode(fc.c.tree, callee).span,
      "a `spawn` target that does not resolve to a function",
    )
    return
  }
  let members = fc.c.ctx.types[cty].members
  if (fc.c.ctx.types[cty].variadic) {
    fcFail(fc, getNode(fc.c.tree, callee).span, "a `spawn` of a variadic function")
    return
  }
  let fv = lowerExpr(fc, callee)
  if (fc.failed) {
    return
  }
  let argVals = lowerArgs(fc, call, members)
  if (fc.failed) {
    return
  }
  let fieldTys = [cty]
  let vals = [fv]
  let i = 0
  while (i < len(members)) {
    fieldTys = append(fieldTys, members[i])
    vals = append(vals, argVals[i])
    i = i + 1
  }
  let envTy = mkFunc(fc.c.ctx, fieldTys, false, fc.c.ctx.voidId)
  let layout = layoutFields(fc, fieldTys)
  let thunk = packSpawnThunk(fc, envTy, layout, vals)
  let fid = synthSpawnValueTrampoline(fc, cty, envTy, layout)
  emitSpawnCall(fc, envTy, fid, thunk)
}
