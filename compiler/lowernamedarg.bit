// compiler/lowernamedarg.bit — lowers a call whose argument list contains at
// least one `Tag.NamedArg` (SPEC §12.11, #3839). Sibling of lowercall.bit/
// lower.bit: same module, so this needs no imports and no call-site changes
// beyond `lowerCall`'s own dispatch (`lowerArgsForCall` below).
//
// By the time lowering runs, `namedargs.bit`'s `vCallNamedArgs` has already
// proven the call fully valid: every FIXED parameter filled exactly once, no
// unknown name, no duplicate, nothing named twice, no positional argument
// after a named one, and never combined with a `...` spread. Nothing here
// re-validates any of that — only evaluation order is this file's job.
//
// EVALUATE IN WRITTEN ORDER, PLACE IN DECLARED ORDER. Naively walking the
// DECLARED parameter list and lowering whichever argument fills each slot, in
// that order, would evaluate `f(b = g(), a = h())`'s `h()` before `g()` —
// reversing the side-effect order the source wrote. `lowerArgsForNamed` walks
// `args` in their own AST order instead (which, given the ordering rule
// above, is exactly the WRITTEN order: the positional prefix, then the named
// suffix in whatever order the call wrote them) and only copies each
// already-evaluated value into its declared slot afterward.

// The resolved declaration a named-argument call lowers against: `owner`'s
// tree owns `params`, `want` is its length, and `paramTypes[i]` is
// `params[i]`'s already-checked type. Bundles what would otherwise be four
// separate parameters (E0202) into the one thing they all describe: WHICH
// decl this call binds against.
class NamedLowerDecl { owner: Checker, params: []int, want: int, paramTypes: []int }

// The accumulator `lowerOneNamedArg`/`lowerNamedArgVariadicTail` write into:
// `vals[i]` the already-lowered value for declared parameter `i`, `filled[i]`
// whether it has been written yet. Both are sized `want` and mutated in
// place by every entry, so bundling them keeps each helper under E0202's
// 5-parameter limit.
class NamedLowerOut { vals: []int, filled: []bool }

// One `args[i]` entry: evaluates it (materializing with its RESOLVED
// parameter's type as the hint) and writes the result into `out.vals`/
// `out.filled` at that parameter's DECLARED index — `i` itself for a plain
// `Tag.Arg` (positional prefix, always aligned with declared order up to
// `namedStart` by construction), or the name-resolved index for a
// `Tag.NamedArg`. Split out of `lowerArgsForNamed` purely to keep ITS OWN
// complexity from growing (spec/LINT.md E0204, tools/build/complexity-debt.txt).
fn lowerOneNamedArg(fc: FnCtx, a: int, i: int, decl: NamedLowerDecl, out: NamedLowerOut) {
  let n = getNode(fc.c.tree, a)
  let pidx = i
  let exprNode = a
  if (n.tag == Tag.NamedArg) {
    let nk = kidsOf(fc.c.tree, a)
    let nameNode = getNode(fc.c.tree, nk[0])
    let argName = fc.c.source[nameNode.span.start:nameNode.span.end]
    pidx = paramIndexByName(decl.owner, decl.params, argName)
    exprNode = nk[1]
  } else if (n.tag == Tag.Arg) {
    exprNode = kidsOf(fc.c.tree, a)[0]
  }
  // An unresolvable name FAILS the lowering; it must never be dropped. The
  // checker proved every name resolves, but it proved it against ITS
  // resolution of the callee — so a future divergence between the two
  // (`methodParamNodes`, namedargs.bit, is what keeps them identical today)
  // has to surface as a refused build, not as an argument silently left at
  // the slot's zero value with the call still emitted.
  if (pidx < 0 || pidx >= decl.want) {
    fcFail(
      fc, getNode(fc.c.tree, a).span,
      "a named argument whose parameter could not be resolved",
    )
    return
  }
  let hint = 0
  if (pidx < len(decl.paramTypes)) {
    hint = decl.paramTypes[pidx]
  }
  out.vals[pidx] = arrayValueForBind(
    fc, exprNode, lowerExprH(fc, exprNode, hint),
    defaultType(fc.c, nodeType(fc, exprNode)),
  )
  out.filled[pidx] = true
}

// A variadic slot is never reached by `lowerArgsForNamed`'s own loop: the
// checker's ordering rule means a named-argument call carries no positional
// argument past the fixed prefix and no `...` spread, so its variadic
// parameter (if it has one, and nothing already filled it) always binds the
// empty slice — the same value `lowerVariadicTail` builds from a zero-length
// range. Split out of `lowerArgsForNamed` for the same complexity reason.
fn lowerNamedArgVariadicTail(fc: FnCtx, decl: NamedLowerDecl, out: NamedLowerOut) {
  if (decl.want == 0) {
    return
  }
  if (getNode(decl.owner.tree, decl.params[decl.want - 1]).tag != Tag.ParamRest) {
    return
  }
  if (out.filled[decl.want - 1]) {
    return
  }
  let elemTy = 0
  if (decl.want - 1 < len(decl.paramTypes)) {
    elemTy = decl.paramTypes[decl.want - 1]
  }
  out.vals[decl.want - 1] = lowerVariadicTail(fc, elemTy, []int(0))
}

// `params` are the callee's declared parameter NODES, in `owner`'s tree —
// supplied by the caller rather than derived here because the two callers
// resolve a callee differently: a free function through `declParamListNode`
// (check.bit), a method through `methodParamNodes` (namedargs.bit). Both hand
// over the identical list shape, which is what lets one placement loop serve
// both.
fn lowerArgsForNamed(
  fc: FnCtx,
  node: int,
  owner: Checker,
  params: []int,
  paramTypes: []int,
): []int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let decl = NamedLowerDecl{
    owner: owner,
    params: params,
    want: len(params),
    paramTypes: paramTypes,
  }
  let out = NamedLowerOut{ vals: []int(decl.want), filled: []bool(decl.want) }
  let i = 0
  while (i < len(args) && !fc.failed) {
    lowerOneNamedArg(fc, args[i], i, decl, out)
    i = i + 1
  }
  lowerNamedArgVariadicTail(fc, decl, out)
  return out.vals
}

// `lowerArgsFor`, extended to detect a named-argument call and route it
// through `lowerArgsForNamed` above; identical to plain `lowerArgsFor` for
// every call `namedargs.bit`'s checker pass left untouched (the ordinary
// case, unchanged).
fn lowerArgsForCall(fc: FnCtx, node: int, owner: Checker, decl: int, paramTypes: []int): []int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  if (namedArgStart(fc.c.tree, args) < len(args)) {
    // `declParamListNode` answers -1 for a generic decl, which `vCallKnownDecl`
    // (validatecall.bit) has already rejected with E0128 — an empty list here
    // therefore reaches `lowerOneNamedArg`'s own hard failure above rather
    // than indexing a node list with -1.
    let plist = declParamListNode(owner, decl)
    let params = []int(0)
    if (plist > 0) {
      params = kidsOf(owner.tree, plist)
    }
    return lowerArgsForNamed(fc, node, owner, params, paramTypes)
  }
  return lowerArgsFor(fc, node, owner, decl, paramTypes)
}

// The method equivalent of `lowerArgsForCall` above, called by
// `lowerArgsForMethod` (lowercall.bit) — which every statically and
// dynamically dispatched method call site funnels through, so this one hook
// covers the class, interface, primitive-alias and `init` arms alike.
//
// The (owner, params) pair comes from `methodParamNodes` (namedargs.bit), the
// SAME resolution `vMemberNamedArgs` validated the call with, so a name that
// checked here binds the slot the checker type-checked it against. When it
// answers `ok: false` the checker cannot have accepted this call at all, so
// the build is refused rather than an argument being placed by guess.
fn lowerArgsForNamedMethod(fc: FnCtx, node: int, recvTy: int, mname: string): []int {
  let mp = methodParamNodes(fc.c, recvTy, mname)
  let fnTy = methodSigLookup(fc.c, "${recvTy}.${mname}")
  if (!mp.ok || fnTy == 0) {
    fcFail(
      fc, getNode(fc.c.tree, node).span,
      "a named argument on a method call whose declaration could not be resolved",
    )
    return []int(0)
  }
  return lowerArgsForNamed(fc, node, mp.owner, mp.params, fc.c.ctx.types[fnTy].members)
}
