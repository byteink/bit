// ELF section bytes and relocation tables, in canonical order.

fn ewSectionIndices(): []int {
  let shIndexOf = []int(0)
  let ki = 0
  while (ki < elfNumKinds()) {
    shIndexOf = append(shIndexOf, 0)
    ki = ki + 1
  }
  return shIndexOf
}

fn ewRealSection(
  out: ByteBuf,
  shstrtab: ByteBuf,
  shdrs: []ElfShdr,
  sec: ElfSection,
  shIndexOf: []int,
): []ElfShdr! {
  let kind = sec.kind
  let kidx = elfKindIndex(kind)
  let nameOff = ewInternString(shstrtab, elfSectionName(kind))?
  let alignment = sec.alignment
  if (alignment == 0) {
    alignment = 1
  }
  ewPad(out, alignment)?
  let fileOff = len(out.bytes)
  if (kind != ElfSectionKind.Bss) {
    ewAppend(out, sec.data)?
  }
  shIndexOf[kidx] = len(shdrs)
  shdrs = append(
    shdrs,
    ElfShdr{
      name = nameOff, shtype = elfShType(kind),
      flags = elfShFlags(kind), addr = 0, offset = fileOff, size = elfSectionBytes(sec),
      link = 0, info = 0, addralign = alignment, entsize = 0,
    },
  )
  return shdrs
}

fn ewSectionRelocations(relocations: []ElfRelocation, kidx: int): []ElfRelocation {
  let mine = []ElfRelocation(0)
  let ri = 0
  while (ri < len(relocations)) {
    if (elfKindIndex(relocations[ri].section) == kidx) {
      mine = append(mine, relocations[ri])
    }
    ri = ri + 1
  }
  return mine
}

fn ewRelocationBytes(
  target: ElfTarget,
  out: ByteBuf,
  mine: []ElfRelocation,
  symIdx: map<string, int>,
): ()! {
  let ri = 0
  while (ri < len(mine)) {
    let r = mine[ri]
    let (sidx, ok) = symIdx[r.symbol]
    if (!ok) {
      fail newError("UnknownSymbol")
    }
    appendElfRela(out, r.offset, sidx, elfRelocType(r.kind, target), r.addend)
    ri = ri + 1
  }
}

fn ewRelocationHeader(nameOff: int, fileOff: int, count: int, sectionIndex: int): ElfShdr! {
  return ElfShdr{
    name = nameOff, shtype = 4, // SHT_RELA
    flags = 64,                 // SHF_INFO_LINK
    addr = 0, offset = fileOff, size = objectMul(count, sizeofElfRela(), objectByteLimit())?,
    link = 0, // patched after the symtab exists
    info = sectionIndex, addralign = 8, entsize = sizeofElfRela(),
  }
}
