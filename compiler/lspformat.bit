// bit lsp (#3007) — textDocument/formatting. `bit lsp` and `bit fmt` are the
// same binary and share `formatSource` (compiler/fmt.bit), so this calls it
// directly rather than shelling out to a `bit fmt` subprocess.
//
// Two rules that are easy to get backwards, both silent if violated:
//
//   - On a parse error, `FmtResult.failed` is true and `.text` holds RENDERED
//     DIAGNOSTICS, not source. Returning that as an edit would replace the
//     user's file with an error message, so a failed format returns an empty
//     edit list instead — declining to format invalid syntax is correct
//     behaviour, the same choice every real formatter makes.
//   - The buffer comes from the server's in-memory overlay
//     (`server.overlays`, kept current by didOpen/didChange/didClose in
//     lspserver.bit), never from disk — the whole point is formatting
//     unsaved edits. A document that is not open has no overlay, so it is
//     declined the same way.

fn lspOnFormatting(server: LspServer, d: JsonDoc, params: int, idText: string) {
  let empty = "[]"
  let doc = jsonGet(d, params, "textDocument")
  let uri = jsonStrOf(d, jsonGet(d, doc, "uri"))
  if (uri == "") {
    lspRespond(idText, empty)
    return
  }
  let raw = lspUriToPath(uri)
  if (raw == "") {
    lspRespond(idText, empty)
    return
  }
  // #2410: canonicalize before keying `server.overlays` — see lspserver.bit's
  // document-sync handlers, which write the overlay under the same
  // `pathResolve`d form.
  let path = pathResolve(raw)
  let (text, isOpen) = server.overlays[path]
  if (!isOpen) {
    lspRespond(idText, empty)
    return
  }
  let r = formatSource(path, text)
  if (r.failed) {
    lspRespond(idText, empty)
    return
  }
  if (r.text == text) {
    lspRespond(idText, empty)
    return
  }
  let range = lspRangeJson(lspSpanToRange(text, 0, len(text)))
  lspRespond(idText, "[{\"range\":" + range + ",\"newText\":" + jsonEncodeString(r.text) + "}]")
}
