// In-Bit self-checks for SPEC §11.7's Darwin extern predicate (#1634).
// Sibling .bit files are the same module, so `selfcheck()` calls these directly.

// The cross-language tripwire: asserts the same count,
// so extending one compiler's table without the other reddens a test instead of
// silently making the two disagree about what links. (Sortedness itself is
// checked on the seed's side — asserting it here would need string ORDERING,
// which is #1664.)
//
// The pinned number itself is libsystemSymbolsCount, declared in
// compiler/machosyms.bit immediately above libsystemSymbols() — not here.
fn checkLibsystemTableCount() {
  let got = len(libsystemSymbols())
  assert(
    got == libsystemSymbolsCount,
    "libsystemSymbols() (compiler/machosyms.bit) now has ${got} admitted " +
        "symbol(s), but libsystemSymbolsCount (compiler/machosyms.bit, " +
        "declared immediately above libsystemSymbols()) still says " +
        "${libsystemSymbolsCount}. Adding or removing a symbol is expected " +
        "to move this count -- update libsystemSymbolsCount to ${got} in " +
        "compiler/machosyms.bit, in the same commit.",
  )
}

fn checkLibsystemDefines() {
  // Scored over the WHOLE table, not a sample.
  let table = libsystemSymbols()
  let i = 0
  while (i < len(table)) {
    assert(libsystemDefines(table[i]))
    i = i + 1
  }
  // The negative pole — the #1634 repro's own symbol.
  assert(!libsystemDefines("definitelyNotInTheRuntimeArchive1234"))
  assert(!libsystemDefines(""))
  // Near-misses of real entries: a prefix/suffix match must not count.
  assert(!libsystemDefines("mmap_"))
  assert(!libsystemDefines("mma"))
  assert(!libsystemDefines("_NSGetExecutablePat"))
  assert(!libsystemDefines("writevv"))
}

// One Mach-O member defining `_bit_rt_probe`, one that merely references
// `_bit_rt_absent`, and one whose definition is LOCAL — the three shapes that
// separate "defines" from "mentions".
fn checkMachoArchiveDefines() {
  let code = [u8(0xc0), u8(0x03), u8(0x5f), u8(0xd6)] // ret
  let definer = MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0,
      alignment: 4 }],
    symbols: [MachoSymbol{ name: "_bit_rt_probe", hasSection: true,
      section: MachoSectionKind.Text, offset: 0, size: len(code),
      binding: MachoBinding.Global }],
    relocations: []MachoRelocation(0) }
  // `hasSection: false` is what makes the symbol undefined — a reference, not a
  // definition.
  let caller = MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0,
      alignment: 4 }],
    symbols: [
      MachoSymbol{ name: "_caller", hasSection: true,
        section: MachoSectionKind.Text, offset: 0, size: len(code),
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_bit_rt_absent", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: []MachoRelocation(0) }
  let localOnly = MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0,
      alignment: 4 }],
    symbols: [MachoSymbol{ name: "_bit_rt_local", hasSection: true,
      section: MachoSectionKind.Text, offset: 0, size: len(code),
      binding: MachoBinding.Local }],
    relocations: []MachoRelocation(0) }

  let t = MachoTarget.Aarch64
  let ar = writeArchive([
    ArMember{ name: "definer.o", data: writeMacho(t, definer) catch _ { []u8(0) } },
    ArMember{ name: "caller.o", data: writeMacho(t, caller) catch _ { []u8(0) } },
    ArMember{ name: "localonly.o", data: writeMacho(t, localOnly) catch _ { []u8(0) } }],
    arFormatGnu())

  // The caller passes the SOURCE-LEVEL name; the underscore decoration is
  // applied inside. Passing the decorated name must therefore NOT match.
  assert(machoArchiveDefines(ar, "bit_rt_probe"))
  assert(!machoArchiveDefines(ar, "_bit_rt_probe"))
  // Only referenced: not admissible. The whole point of the test.
  assert(!machoArchiveDefines(ar, "bit_rt_absent"))
  // Locally defined: invisible to the link, so not admissible.
  assert(!machoArchiveDefines(ar, "bit_rt_local"))
  assert(!machoArchiveDefines(ar, "bit_rt_no_such_symbol_exists_anywhere"))
  // Undecidable inputs answer false, never accept.
  assert(!machoArchiveDefines([]u8(0), "bit_rt_probe"))
  assert(!machoArchiveDefines([]byte("not an ar archive at all"), "bit_rt_probe"))
}

// The predicate the E0078 gate actually calls, over all three platform
// halves. A libSystem name is admissible ONLY on Darwin: the ELF image has no
// dyld. A kernel32 name (pesyms.bit's windowsImportDefines) is admissible
// ONLY on Windows, the PE twin of the same rule (#3349).
fn checkExternResolvable() {
  let noPins = map<string, bool>{}
  assert(externResolvable(BuildTarget.Aarch64Macos, []u8(0), "mmap", noPins))
  assert(!externResolvable(BuildTarget.Aarch64Macos, []u8(0),
    "definitelyNotInTheRuntimeArchive1234", noPins))
  assert(!externResolvable(BuildTarget.X86_64Linux, []u8(0), "mmap", noPins))
  assert(!externResolvable(BuildTarget.Aarch64Linux, []u8(0), "mmap", noPins))
  // A kernel32 import (ExitProcess) is admissible on Windows and nowhere
  // else — the mirror image of the libSystem (mmap) assertions above.
  assert(externResolvable(BuildTarget.X86_64Windows, []u8(0), "ExitProcess", noPins))
  assert(!externResolvable(BuildTarget.X86_64Windows, []u8(0),
    "definitelyNotInTheRuntimeArchive1234", noPins))
  assert(!externResolvable(BuildTarget.Aarch64Macos, []u8(0), "ExitProcess", noPins))
  assert(!externResolvable(BuildTarget.X86_64Linux, []u8(0), "ExitProcess", noPins))
  assert(!externResolvable(BuildTarget.X86_64Windows, []u8(0), "mmap", noPins))

  // A §11.9 pin this build's own modules define is admissible on every target
  // even though no archive and no dylib/kernel32 defines it — the final link
  // resolves it out of the program's own object (_tests_/stress/pinsym), on
  // Linux and Windows exactly like on Darwin: a static ELF link (or a PE link
  // with no matching import) resolves it out of the program's own object too,
  // the same way it resolves `bit_main`.
  let pins = map<string, bool>{}
  pins["bit_pinned_sub"] = true
  assert(externResolvable(BuildTarget.Aarch64Macos, []u8(0), "bit_pinned_sub", pins))
  assert(!externResolvable(BuildTarget.Aarch64Macos, []u8(0), "bit_pinned_sub", noPins))
  assert(externResolvable(BuildTarget.X86_64Linux, []u8(0), "bit_pinned_sub", pins))
  assert(externResolvable(BuildTarget.Aarch64Linux, []u8(0), "bit_pinned_sub", pins))
  assert(externResolvable(BuildTarget.X86_64Windows, []u8(0), "bit_pinned_sub", pins))
  assert(!externResolvable(BuildTarget.X86_64Windows, []u8(0), "bit_pinned_sub", noPins))
  // The widened gate still rejects a name nothing pins and no archive defines —
  // both poles over one Linux triple, as the existing E0078 tests do.
  assert(!externResolvable(BuildTarget.X86_64Linux, []u8(0), "bit_pinned_sub", noPins))
  assert(!externResolvable(BuildTarget.X86_64Linux, []u8(0),
    "definitelyNotInTheRuntimeArchive1234", pins))
}
