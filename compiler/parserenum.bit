// compiler/parserenum.bit — in-body enum methods (owner ruling #5216, SPEC
// §10.6): `this` bound to the value, exactly as a class body's
// `parseMethodMember` already binds it. Split out of parsertype.bit to keep
// that file under the repo's 800-line ceiling; same module as its sibling,
// so this needs no import and no call-site change.

// E0191 (SPEC §14.7, #6403): `static` heads a static method in an enum body
// (`static name(...)`, §10.4.1), so a variant cannot be named `static`.
const ecEnumVariantStatic = 191

// True when the member at the CURRENT token (its own name; `export` and
// `static` are consumed before this is asked) is an in-body method rather
// than a variant. `<` is unambiguous (a variant has none).
// `IDENT "("` is genuinely ambiguous —
// a variant's payload is a paren'd TYPE list, a method's is a paren'd PARAM
// list, both legal empty — so this scans to the matching `)` and decides on
// what follows it: a variant ends in `,`/`;`/`}`, a method always continues
// with `: result` or a mandatory `{` body.
fn atEnumMethod(p: Parser): bool {
  if (peekKindAt(p, 1) == Kind.Lt) {
    return true
  }
  if (peekKindAt(p, 1) != Kind.LParen) {
    return false
  }
  let depth = 0
  let i = 1
  let guard = 0
  while (guard < 100000) {
    let k = peekKindAt(p, i)
    if (k == Kind.LParen) {
      depth = depth + 1
    } else if (k == Kind.RParen) {
      depth = depth - 1
      if (depth == 0) {
        let after = peekKindAt(p, i + 1)
        return after == Kind.Colon || after == Kind.LBrace
      }
    } else if (k == Kind.Eof) {
      return false
    }
    i = i + 1
    guard = guard + 1
  }
  return false
}

// A variant, an in-body method (owner ruling #5216) or an in-body static
// method (SPEC §10.4.1, #6403) — the enum body's counterpart to
// `parseClassMember`. `static name(...)` builds the same node a class's does
// (`parseStaticMethodMember`, parserstatic.bit), so the checker's and
// lowering's `Receiver.main == 1` reading needs nothing enum-specific. A bare
// `static` that heads neither a static method nor a method named `static` can
// only be a variant of that name, which E0191 refuses.
fn parseEnumMember(p: Parser, enumName: int, enumGenerics: int): int {
  let exported = acceptTok(p, Kind.KwExport)
  if (atStaticMethod(p) || atStaticMethodFnRejected(p)) {
    return parseStaticMethodMember(p, exported, enumName, enumGenerics)
  }
  if (exported || atEnumMethod(p)) {
    let name = expectIdent(p)
    return parseMethodMember(p, name, exported, enumName, enumGenerics)
  }
  if (peekKind(p) == Kind.Ident && curText(p) == "static") {
    let t = peekTok(p)
    report(
      p.diags, ecEnumVariantStatic, Span{ file = p.file, start = t.start, end = t.end },
      "an enum variant cannot be named 'static'",
      "'static' introduces a static method in an enum body (SPEC §10.4.1); pick another variant name",
    )
  }
  return parseVariant(p)
}
