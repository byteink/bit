// compiler/parserenum.bit — in-body enum methods (owner ruling #5216, SPEC
// §10.6): `this` bound to the value, exactly as a class body's
// `parseMethodMember` already binds it. Split out of parsertype.bit to keep
// that file under the repo's 800-line ceiling; same module as its sibling,
// so this needs no import and no call-site change.

// True when the member at the CURRENT token (its own name, or `export`
// ahead of it) is an in-body method rather than a variant. `export`/`<` are
// unambiguous (a variant has neither). `IDENT "("` is genuinely ambiguous —
// a variant's payload is a paren'd TYPE list, a method's is a paren'd PARAM
// list, both legal empty — so this scans to the matching `)` and decides on
// what follows it: a variant ends in `,`/`;`/`}`, a method always continues
// with `: result` or a mandatory `{` body.
fn atEnumMethod(p: Parser): bool {
  if (peekKind(p) == Kind.KwExport) {
    return true
  }
  if (peekKindAt(p, 1) == Kind.Lt) {
    return true
  }
  if (peekKindAt(p, 1) != Kind.LParen) {
    return false
  }
  let depth = 0
  let i = 1
  let guard = 0
  while (guard < 100000) {
    let k = peekKindAt(p, i)
    if (k == Kind.LParen) {
      depth = depth + 1
    } else if (k == Kind.RParen) {
      depth = depth - 1
      if (depth == 0) {
        let after = peekKindAt(p, i + 1)
        return after == Kind.Colon || after == Kind.LBrace
      }
    } else if (k == Kind.Eof) {
      return false
    }
    i = i + 1
    guard = guard + 1
  }
  return false
}

// A variant or an in-body method (owner ruling #5216) — the enum body's
// counterpart to `parseClassMember`.
fn parseEnumMember(p: Parser, enumName: int, enumGenerics: int): int {
  if (atEnumMethod(p)) {
    let exported = acceptTok(p, Kind.KwExport)
    let name = expectIdent(p)
    return parseMethodMember(p, name, exported, enumName, enumGenerics)
  }
  return parseVariant(p)
}
