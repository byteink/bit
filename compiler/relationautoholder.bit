// compiler/relationautoholder.bit — #6344 (epic #6298): where a row lives
// after it ESCAPES a query's own flow, and what proves its relation loaded
// there.
//
// THE GAP. `relationAutoResolve` (relationauto.bit) follows a row from the
// query that produced it through a `let`, a `for-of`, an index, a call. A row
// stored into a struct field, a map value, or captured by a closure leaves
// that flow, so a later read used to be E0300 with the hint "add
// '.with(\"rel\")' where the rows are queried" — advice that did not help,
// because nothing linked the read back to that query. Following the
// compiler's own advice must always make the build pass.
//
// THE MODEL. An untraceable location is a HOLDER, named by a key built from
// static facts only (never a name a caller could shadow):
//   `holder:F:<struct type id>.<field>`  every value stored in that field of
//                                        any instance of that struct;
//   `holder:M:<row class id>:<slice?>`   every value stored in any map whose
//                                        values are that row class (or slices
//                                        of it);
//   `holder:C:<module>:<symbol id>`      a local `let`/`for-of` variable, read
//                                        where the walk has no binding for it
//                                        (a closure's own fresh walk);
//   `holder:P:<module>:<name node>`      a parameter of a named function, read
//                                        where the walk has no binding for it
//                                        (a closure capturing it, #6352): its
//                                        stores are the ARGUMENTS of every call
//                                        to that function;
//   `holder:Q:<module>:<query call>`     the rows of one query, for the stores
//                                        that REPLACE them (`rows[0] = v`,
//                                        `rows = v`, #6352). Unlike the others
//                                        this is never a read's own flow: a
//                                        read whose flow reaches the query is
//                                        proven by the query's names AND by
//                                        every store recorded here.
// `relationAutoResolve` answers a holder as a `RelationAutoFlow` whose
// `paramName` is the key (`relationAutoIsHolderName`; a real parameter is an
// identifier, so the `holder:` prefix never collides) with `queryCall = 0`.
// Every consumer that already treats a parameter-origin flow as "not a query"
// therefore treats a holder the same, with no new state on the flow.
//
// WRITERS. The err pass (relationautoerr.bit) runs twice. Pass one only
// COLLECTS, into `RelationAutoHolders`, every store into a holder: a field
// assignment, an element assignment, a composite-literal field init, a map
// literal entry, a `let`, a `for-of` binder, a plain `=` to a variable, and
// each call argument bound to a named function's parameter (a `...` spread
// or an omitted argument poisons it). Each
// store is a `RelationAutoWriter`: the value's own flow reduced to either the
// relation names its query provably loads (`relationAutoQueryNames`: the
// explicit `.with(...)` chain on the query plus whatever the auto-loader
// splices) or "copied from another holder", or POISONED (`ok = false`) when
// the stored value is not traceable at all. Pass two checks reads. A read on
// a holder is proven iff the holder has at least one writer and EVERY writer
// proves the read's full dotted path: one poisoned or unloading writer
// refuses it, so a holder can never be proven by the writers that happen to
// be visible. A holder nothing was recorded for is unproven.
//
// A STORE INTO A QUERY'S OWN ROWS (#6352). `let rows = q.all()?; rows[0] =
// raw` leaves `rows` bound to `q` for the same-function walk, so a later
// `rows[0].author` is spliced onto `q` and looks loaded while the element the
// read sees is `raw`. Every store whose target resolves to a query's rows —
// an element, or the variable itself — is therefore a writer of that query's
// `holder:Q` key, at `RelationAutoWriter.at` (the path inside the row the
// store sits at), and a read that reaches the query is proven only when each
// such store proves the read too (`relationAutoQueryStoresProve`). A store of
// the query's own rows back into itself records nothing.
//
// SOUNDNESS LIMITS, all in the refusing direction except the last: an
// unresolvable store poisons; a chain of copies deeper than
// `relationAutoHolderMaxDepth` (or a cycle) is unproven; a `for-of` over a
// non-slice poisons. NOT tracked: a store into a PARAMETER's own rows
// (`p[0] = other`, `p = other`), which reads through the parameter never saw.

const relationAutoHolderPrefix = "holder:"
const relationAutoHolderMaxDepth = 8

fn relationAutoIsHolderName(name: string): bool {
  let n = len(relationAutoHolderPrefix)
  return len(name) > n && name[0:n] == relationAutoHolderPrefix
}

// One store into a holder. `ok = false`: an untraceable value. Otherwise
// either `via == ""` (a real query, `names` are the relations it loads) or
// `via` names another holder the value was copied from. `path` is the
// relation path already walked from that query's / holder's row to the
// stored value (`cache.author = post.author` stores `path = "author"`).
// `line` is the query's source line, for the hint. `at` (only meaningful under
// a `holder:Q` key): the path, inside the query's row, the store sits at.
// `qkey`: the `holder:Q` key of the query behind a `via == ""` writer, whose
// own replacing stores the writer's proof also owes.
class RelationAutoWriter {
  ok: bool,
  names: []string,
  via: string,
  path: string,
  line: int,
  at: string,
  qkey: string,
}

// Where a store lands: a holder key and, for a `holder:Q` key, the path inside
// the query's row it sits at (`RelationAutoWriter.at`). `key == ""`: nowhere.
class RelationAutoStore {
  key: string,
  at: string,
}

class RelationAutoHolders {
  writers: map<string, []RelationAutoWriter>,
}

fn relationAutoNewHolders(): RelationAutoHolders {
  return RelationAutoHolders{ writers = map<string, []RelationAutoWriter>{} }
}

fn relationAutoWriterBad(at: string): RelationAutoWriter {
  return RelationAutoWriter{
    ok = false, names = []string(0), via = "", path = "", line = 0, at = at, qkey = "",
  }
}

fn relationAutoParamHolderKey(moduleId: int, nameNode: int): string {
  return "${relationAutoHolderPrefix}P:${moduleId}:${nameNode}"
}

fn relationAutoQueryHolderKey(ownerModule: int, queryCall: int): string {
  return "${relationAutoHolderPrefix}Q:${ownerModule}:${queryCall}"
}

// The 1-based source line of byte offset `off`.
fn relationAutoLineOf(source: string, off: int): int {
  let line = 1
  let i = 0
  while (i < off && i < len(source)) {
    if (source[i] == '\n') {
      line = line + 1
    }
    i = i + 1
  }
  return line
}

// Every relation name `queryCall` is known to load: the explicit `.with(...)`
// chain on the query's own receiver (the same walk the splice trusts,
// `relationAutoExistingWithNames`) plus every name the auto-loader records
// for it (`Checker.relationAutoWith`) and will splice at build time.
fn relationAutoQueryNames(owner: Checker, queryCall: int): []string {
  let callee = kidsOf(owner.tree, queryCall)[0]
  let out = relationAutoExistingWithNames(owner.tree, owner.source, kidsOf(owner.tree, callee)[0])
  let (auto, ok) = owner.relationAutoWith[queryCall]
  if (ok) {
    for n of auto {
      out = append(out, n)
    }
  }
  return out
}

// `flow` (a stored value's own resolved flow) reduced to a writer stored at
// `at`. `fd` is the function being walked (0 for a closure or top level): a
// flow still relative to one of its parameters becomes a copy from that
// parameter's own holder, whose stores are the arguments of its callers.
fn relationAutoWriterOf(
  c: Checker,
  flow: RelationAutoFlow,
  fd: int,
  at: string,
): RelationAutoWriter {
  if (!flow.found) {
    return relationAutoWriterBad(at)
  }
  if (relationAutoIsHolderName(flow.paramName)) {
    return RelationAutoWriter{
      ok = true, names = []string(0), via = flow.paramName, path = flow.path, line = 0, at = at, qkey = "",
    }
  }
  if (flow.queryCall <= 0) {
    return relationAutoWriterOfParam(c, flow, fd, at)
  }
  let owner = c.mods[flow.ownerModule]
  return RelationAutoWriter{
    ok = true, names = relationAutoQueryNames(owner, flow.queryCall), via = "", path = flow.path,
    line = relationAutoLineOf(owner.source, getNode(owner.tree, flow.queryCall).span.start),
    at = at, qkey = relationAutoQueryHolderKey(flow.ownerModule, flow.queryCall),
  }
}

// The name node of parameter `name` of function `fd` (a `FuncDecl`), or 0.
fn relationAutoParamNameNode(c: Checker, fd: int, name: string): int {
  if (fd == 0) {
    return 0
  }
  for p of kidsOf(c.tree, kidsOf(c.tree, fd)[3]) {
    let nameNode = kidsOf(c.tree, p)[0]
    if (getNode(c.tree, p).tag == Tag.Param && identText(c.tree, c.source, nameNode) == name) {
      return nameNode
    }
  }
  return 0
}

fn relationAutoWriterOfParam(
  c: Checker,
  flow: RelationAutoFlow,
  fd: int,
  at: string,
): RelationAutoWriter {
  let nameNode = relationAutoParamNameNode(c, fd, flow.paramName)
  if (nameNode == 0) {
    return relationAutoWriterBad(at) // no function to ask about its callers
  }
  return RelationAutoWriter{
    ok = true, names = []string(0), via = relationAutoParamHolderKey(c.moduleId, nameNode),
    path = flow.path, line = 0, at = at, qkey = "",
  }
}

// Records `w` as a store into `tgt`. A query's own rows stored back into the
// place they already are (`rows = rows`, `rows[0] = rows[1]`) change nothing
// and record nothing.
fn relationAutoHolderNote(h: RelationAutoHolders, tgt: RelationAutoStore, w: RelationAutoWriter) {
  if (tgt.key == "") {
    return
  }
  if (w.ok && w.via == "" && w.qkey == tgt.key && w.path == tgt.at) {
    return
  }
  let (old, ok) = h.writers[tgt.key]
  if (!ok) {
    old = []RelationAutoWriter(0)
  }
  h.writers[tgt.key] = append(old, w)
}

// True when some name in `names` is `path` or nests under it — a query that
// loads "author.posts" has loaded "author" on the way.
fn relationAutoNamesCover(names: []string, path: string): bool {
  for n of names {
    if (relationAutoPathIsPrefixOf(path, n)) {
      return true
    }
  }
  return false
}

// (proved, line): whether `w` proves `need` (a path relative to the holder's
// rows), and the source line of a query that failed to, when there is one. A
// query's writer also owes every store that replaced that query's rows.
fn relationAutoWriterProves(
  h: RelationAutoHolders, w: RelationAutoWriter, need: string, depth: int,
): (bool, int) {
  if (!w.ok) {
    return (false, 0)
  }
  let full = relationAutoJoinPath(w.path, need)
  if (w.via != "") {
    return relationAutoHolderProves(h, w.via, full, depth + 1)
  }
  if (!relationAutoNamesCover(w.names, full)) {
    return (false, w.line)
  }
  return relationAutoQueryStoresProve(h, w.qkey, full, depth + 1)
}

// Whether a store at path `at` inside a query's row can change what a read of
// `full` (a path from that row) sees: `at` is the row itself, or a proper
// ancestor of the read's path.
fn relationAutoStoreReaches(at: string, full: string): bool {
  return at == "" || (len(full) > len(at) && relationAutoPathIsPrefixOf(at, full))
}

// (proved, line): every store recorded against query `qkey` that reaches a
// read of `full` loaded what the read needs of the stored value. No store at
// all is proved: the query's own names are the whole proof.
fn relationAutoQueryStoresProve(
  h: RelationAutoHolders, qkey: string, full: string, depth: int,
): (bool, int) {
  let (ws, ok) = h.writers[qkey]
  if (!ok) {
    return (true, 0)
  }
  if (depth > relationAutoHolderMaxDepth) {
    return (false, 0)
  }
  let all = true
  let blame = 0
  for w of ws {
    if (!relationAutoStoreReaches(w.at, full)) {
      continue
    }
    let need = full
    if (w.at != "") {
      need = full[len(w.at) + 1:]
    }
    let (proved, line) = relationAutoWriterProves(h, w, need, depth)
    if (!proved) {
      all = false
      if (blame == 0) {
        blame = line
      }
    }
  }
  return (all, blame)
}

// Whether the rows `flow` reaches loaded `need` (a path from those rows): a
// query's rows by its names and replacing stores, a holder's by its stores.
fn relationAutoFlowProves(
  h: RelationAutoHolders,
  flow: RelationAutoFlow,
  need: string,
): (bool, int) {
  if (flow.queryCall > 0) {
    return relationAutoQueryStoresProve(
      h, relationAutoQueryHolderKey(flow.ownerModule, flow.queryCall), need, 0,
    )
  }
  return relationAutoHolderProves(h, flow.paramName, need, 0)
}

fn relationAutoHolderProves(
  h: RelationAutoHolders, key: string, need: string, depth: int,
): (bool, int) {
  if (depth > relationAutoHolderMaxDepth) {
    return (false, 0)
  }
  let (ws, ok) = h.writers[key]
  if (!ok || len(ws) == 0) {
    return (false, 0)
  }
  let all = true
  let blame = 0
  for w of ws {
    let (proved, line) = relationAutoWriterProves(h, w, need, depth)
    if (!proved) {
      all = false
      if (blame == 0) {
        blame = line
      }
    }
  }
  return (all, blame)
}

// The flow of a holder whose value at `node` is a `@table` row (or a slice of
// them) and whose key is `key`; not-found for every other type — a holder only
// matters for rows.
fn relationAutoHolderFlow(c: Checker, node: int, key: string): RelationAutoFlow {
  let (cls, isSlice) = relationAutoParamTrackable(c, checkExprType(c, node))
  if (!cls.found) {
    return relationAutoNoFlow(c)
  }
  return RelationAutoFlow{
    found = true, cls = cls, queryCall = 0, paramName = key, isSlice = isSlice,
    ownerModule = c.moduleId, path = "",
  }
}

// A plain local `let` (or `for-of` binder), or a parameter of a named
// function (#6352) — read where the walk has no binding for it, i.e. inside a
// closure that captures it. A parameter's stores are its callers' arguments
// (`relationAutoHolderNoteCall`, relationautostore.bit).
fn relationAutoHolderIdent(c: Checker, n: int): RelationAutoFlow {
  if (n <= 0 || n >= len(c.nodeSymbols)) {
    return relationAutoNoFlow(c)
  }
  let sid = c.nodeSymbols[n]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return relationAutoNoFlow(c)
  }
  let sym = c.symbols[sid]
  if (sym.kind == SymbolKind.LetBinding) {
    return relationAutoHolderFlow(c, n, "${relationAutoHolderPrefix}C:${c.moduleId}:${sid}")
  }
  if (sym.kind == SymbolKind.Param) {
    return relationAutoHolderFlow(c, n, relationAutoParamHolderKey(c.moduleId, sym.decl))
  }
  return relationAutoNoFlow(c)
}

fn relationAutoHolderMember(c: Checker, n: int): RelationAutoFlow {
  let k = kidsOf(c.tree, n)
  if (len(k) < 2 || k[0] == 0 || k[1] == 0) {
    return relationAutoNoFlow(c)
  }
  let sty = checkExprType(c, k[0])
  if (sty == 0 || c.ctx.types[sty].kind != TypeKind.Struct) {
    return relationAutoNoFlow(c)
  }
  let key = "${relationAutoHolderPrefix}F:${sty}.${identText(c.tree, c.source, k[1])}"
  return relationAutoHolderFlow(c, n, key)
}

// `m[k]` on a map whose VALUE type is a row (or slice of rows).
fn relationAutoHolderIndex(c: Checker, n: int): RelationAutoFlow {
  let bt = checkExprType(c, kidsOf(c.tree, n)[0])
  if (bt == 0 || c.ctx.types[bt].kind != TypeKind.Map) {
    return relationAutoNoFlow(c)
  }
  let (cls, isSlice) = relationAutoParamTrackable(c, c.ctx.types[bt].mapVal)
  if (!cls.found) {
    return relationAutoNoFlow(c)
  }
  return RelationAutoFlow{
    found = true, cls = cls, queryCall = 0,
    paramName = "${relationAutoHolderPrefix}M:${cls.ty}:${isSlice}", isSlice = isSlice,
    ownerModule = c.moduleId, path = "",
  }
}

// The holder flow `n` is, by its own shape, or not-found.
fn relationAutoHolderOf(c: Checker, n: int): RelationAutoFlow {
  let tag = getNode(c.tree, n).tag
  if (tag == Tag.Ident) {
    return relationAutoHolderIdent(c, n)
  }
  if (tag == Tag.Member) {
    return relationAutoHolderMember(c, n)
  }
  if (tag == Tag.Index) {
    return relationAutoHolderIndex(c, n)
  }
  return relationAutoNoFlow(c)
}

// The hint for a read on a holder that failed to prove `need`.
fn relationAutoHolderHint(need: string, line: int): string {
  if (line <= 0) {
    return relationAutoUnknownOriginHint(need)
  }
  return "these rows were stored from the query on line ${line}, which does not load '${need}' " +
    "-- add '.with(\"${need}\")' to that query"
}
