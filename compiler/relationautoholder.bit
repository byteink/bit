// compiler/relationautoholder.bit — #6344 (epic #6298): where a row lives
// after it ESCAPES a query's own flow, and what proves its relation loaded
// there.
//
// THE GAP. `relationAutoResolve` (relationauto.bit) follows a row from the
// query that produced it through a `let`, a `for-of`, an index, a call. A row
// stored into a struct field, a map value, or captured by a closure leaves
// that flow, so a later read used to be E0300 with the hint "add
// '.with(\"rel\")' where the rows are queried" — advice that did not help,
// because nothing linked the read back to that query. Following the
// compiler's own advice must always make the build pass.
//
// THE MODEL. An untraceable location is a HOLDER, named by a key built from
// static facts only (never a name a caller could shadow):
//   `holder:F:<struct type id>.<field>`  every value stored in that field of
//                                        any instance of that struct;
//   `holder:M:<row class id>:<slice?>`   every value stored in any map whose
//                                        values are that row class (or slices
//                                        of it);
//   `holder:C:<module>:<symbol id>`      a local `let`/`for-of` variable, read
//                                        where the walk has no binding for it
//                                        (a closure's own fresh walk);
//   `holder:P:<module>:<name node>`      a parameter of a named function, read
//                                        where the walk has no binding for it
//                                        (a closure capturing it, #6352): its
//                                        stores are the ARGUMENTS of every call
//                                        to that function;
//   `holder:X:<module>:<decl>`           what a function returns when its
//                                        `return`s disagree (#6373);
//   `holder:Q:<module>:<query call>`     the rows of one query, for the stores
//                                        that REPLACE them (`rows[0] = v`,
//                                        `rows = v`, #6352). Unlike the others
//                                        this is never a read's own flow: a
//                                        read whose flow reaches the query is
//                                        proven by the query's names AND by
//                                        every store recorded here.
// `relationAutoResolve` answers a holder as a `RelationAutoFlow` whose
// `paramName` is the key (`relationAutoIsHolderName`; a real parameter is an
// identifier, so the `holder:` prefix never collides) with `queryCall = 0`.
// Every consumer that already treats a parameter-origin flow as "not a query"
// therefore treats a holder the same, with no new state on the flow.
//
// WRITERS. The err pass (relationautoerr.bit) runs twice. Pass one only
// COLLECTS, into `RelationAutoHolders`, every store into a holder: a field
// assignment, an element assignment, a composite-literal field init, a map
// literal entry, a `let`, a `for-of` binder, a plain `=` to a variable, and
// each call argument bound to a named function's parameter (an omitted
// argument poisons it; a variadic parameter takes each of its arguments, a
// `...` spread's slice included, #6405). Each
// store is a `RelationAutoWriter`: the value's own flow reduced to either the
// relation names its query provably loads (`relationAutoQueryNames`: the
// explicit `.with(...)` chain on the query plus whatever the auto-loader
// splices) or "copied from another holder", or POISONED (`ok = false`) when
// the stored value is not traceable at all. Pass two checks reads. A read on
// a holder is proven iff the holder has at least one writer and EVERY writer
// proves the read's full dotted path: one poisoned or unloading writer
// refuses it, so a holder can never be proven by the writers that happen to
// be visible. A holder nothing was recorded for is unproven.
//
// A STORE INTO A QUERY'S OWN ROWS (#6352). `let rows = q.all()?; rows[0] =
// raw` leaves `rows` bound to `q` for the same-function walk, so a later
// `rows[0].author` is spliced onto `q` and looks loaded while the element the
// read sees is `raw`. Every store whose target resolves to a query's rows —
// an element, or the variable itself — is therefore a writer of that query's
// `holder:Q` key, at `RelationAutoWriter.at` (the path inside the row the
// store sits at), and a read that reaches the query is proven only when each
// such store proves the read too (`relationAutoReplacingStoresProve`). A store of
// the query's own rows back into itself records nothing.
//
// A STORE INTO A PARAMETER'S OWN ROWS (#6366) is the same thing one level up:
// `fn f(p: []Post) { p = raw; p[0] = other; p[0].author }` reads through a
// parameter whose callers are proven by the call site, yet the rows it reads
// are the stored ones. Every such store is a writer of `holder:S:<module>:<name
// node>`, checked exactly like a query's replacing stores: a read through the
// parameter (or through a closure, `holder:P`) is proven only when each store
// that reaches it loaded what the read needs.
//
// A ROW FROM RAW SQL (#6366) is the holder `holder:R:<module>:<query call>`
// (relationautoraw.bit): it has no writer ever, so a read that reaches it is
// unproven by construction, and the proof's failure says so (`RelationAutoBlame`)
// so the hint can name what does work instead of a `.with` that cannot exist.
//
// A FUNCTION'S RETURN WHEN ITS `return`s DISAGREE (#6373) is the holder
// `holder:X:<module>:<decl>` (relationautoreturn.bit): one writer per `return`,
// so a read of the result is proven iff every `return` loads it, and the proof's
// failure names the `return` (or its query) that does not. A hint names a place
// in another file as `<file>:<line>` (`relationAutoSitePhrase`).
//
// SOUNDNESS LIMITS, all in the refusing direction: an unresolvable store
// poisons; a chain of copies deeper than `relationAutoHolderMaxDepth` (or a
// cycle) is unproven; a `for-of` over a non-slice poisons.

const relationAutoHolderPrefix = "holder:"
const relationAutoHolderMaxDepth = 8

fn relationAutoIsHolderName(name: string): bool {
  let n = len(relationAutoHolderPrefix)
  return len(name) > n && name[0:n] == relationAutoHolderPrefix
}

// A place in the source: the node and the module whose tree it indexes. The
// line a hint names is derived from it only when an error is reported
// (`relationAutoSitePhrase`), never per store. `node == 0`: nowhere.
class RelationAutoSite {
  mod: int,
  node: int,
}

// One store into a holder. `ok = false`: an untraceable value. Otherwise
// either `via == ""` (a real query, `names` are the relations it loads) or
// `via` names another holder the value was copied from. `path` is the
// relation path already walked from that query's / holder's row to the
// stored value (`cache.author = post.author` stores `path = "author"`).
// `site`: the query for a direct query writer, the store itself for every
// other writer. `at` (only meaningful under a `holder:Q`/`holder:S` key): the
// path, inside the query's row, the store sits at. `qkey`: the `holder:Q` key
// of the query behind a `via == ""` writer, whose own replacing stores the
// writer's proof also owes.
class RelationAutoWriter {
  ok: bool,
  names: []string,
  via: string,
  path: string,
  site: RelationAutoSite,
  at: string,
  qkey: string,
}

// Where a store lands: a holder key and, for a `holder:Q`/`holder:S` key, the
// path inside the row it sits at (`RelationAutoWriter.at`). `key == ""`:
// nowhere. `site`: the store's own place.
class RelationAutoStore {
  key: string,
  at: string,
  site: RelationAutoSite,
}

enum RelationAutoBlameKind {
  None,
  Query,
  Store,
  Raw,
}

// Why a proof failed, for the hint: `Query` (a query that does not load the
// read), `Store` (a store whose value cannot be traced at all), `Raw` (rows
// from raw SQL, which can never load a relation), or `None` (no writer at all).
// `site` is where to point the developer, `node == 0` when nowhere.
class RelationAutoBlame {
  kind: RelationAutoBlameKind,
  site: RelationAutoSite,
}

// `empty` (#6407): the holders a `let` initialised with no row at all
// (`Option.None`, `[]T(0)`). One that nothing else was ever stored into holds no
// row, so a read through it is dead code and needs no load; a holder nothing was
// recorded for and that was never so initialised stays unproven.
class RelationAutoHolders {
  writers: map<string, []RelationAutoWriter>,
  empty: map<string, bool>,
}

fn relationAutoNewHolders(): RelationAutoHolders {
  return RelationAutoHolders{
    writers = map<string, []RelationAutoWriter>{},
    empty = map<string, bool>{},
  }
}

fn relationAutoWriterBad(tgt: RelationAutoStore): RelationAutoWriter {
  return RelationAutoWriter{
    ok = false, names = []string(0), via = "", path = "", site = tgt.site, at = tgt.at, qkey = "",
  }
}

fn relationAutoNoBlame(): RelationAutoBlame {
  return RelationAutoBlame{
    kind = RelationAutoBlameKind.None, site = RelationAutoSite{ mod = 0, node = 0 },
  }
}

fn relationAutoParamHolderKey(moduleId: int, nameNode: int): string {
  return "${relationAutoHolderPrefix}P:${moduleId}:${nameNode}"
}

fn relationAutoQueryHolderKey(ownerModule: int, queryCall: int): string {
  return "${relationAutoHolderPrefix}Q:${ownerModule}:${queryCall}"
}

// The stores that replace parameter `nameNode`'s own rows (#6366), kept apart
// from `holder:P` (the arguments of its callers, each checked at its call).
fn relationAutoParamStoreKey(moduleId: int, nameNode: int): string {
  return "${relationAutoHolderPrefix}S:${moduleId}:${nameNode}"
}

// True when `key` is `prefix` followed by something.
fn relationAutoKeyIs(key: string, prefix: string): bool {
  let n = len(prefix)
  return len(key) > n && key[0:n] == prefix
}

// `holder:P:<rest>`'s replacing-store key `holder:S:<rest>`, or "" for any
// other key.
fn relationAutoStoreKeyOfHolder(key: string): string {
  let p = "${relationAutoHolderPrefix}P:"
  if (!relationAutoKeyIs(key, p)) {
    return ""
  }
  return "${relationAutoHolderPrefix}S:" + key[len(p):]
}

// Where `site` is, as a hint names it: "on line N" when it is in the file the
// error is reported in (`at`, a node of `c`), "at <file>:N" when it is in any
// other file of this module or in another module, so the developer can open it;
// "" when it names nowhere. Lines are per FILE: a module's files are one
// concatenated source (`vSpan`, validate.bit maps a node back to its own file).
fn relationAutoSitePhrase(c: Checker, at: int, site: RelationAutoSite): string {
  if (site.node == 0) {
    return ""
  }
  let there = vSpan(c.mods[site.mod], site.node)
  let line = locate(c.diags.sm, there.file, there.start).line + 1
  if (there.file == vSpan(c, at).file) {
    return "on line ${line}"
  }
  return "at ${filePath(c.diags.sm, there.file)}:${line}"
}

// What the place `site` holds: a `return` statement's rows are "returned",
// every other store's are "stored".
fn relationAutoSiteVerb(c: Checker, site: RelationAutoSite): string {
  if (site.node != 0 && getNode(c.mods[site.mod].tree, site.node).tag == Tag.ReturnStmt) {
    return "returned"
  }
  return "stored"
}

// Every relation name `queryCall` is known to load: the explicit `.with(...)`
// chain on the query's own receiver (the same walk the splice trusts,
// `relationAutoExistingWithNames`) plus every name the auto-loader records
// for it (`Checker.relationAutoWith`) and will splice at build time.
fn relationAutoQueryNames(owner: Checker, queryCall: int): []string {
  let callee = kidsOf(owner.tree, queryCall)[0]
  let out = relationAutoExistingWithNames(owner.tree, owner.source, kidsOf(owner.tree, callee)[0])
  let (auto, ok) = owner.relationAutoWith[queryCall]
  if (ok) {
    for n of auto {
      out = append(out, n)
    }
  }
  return out
}

// `flow` (a stored value's own resolved flow) reduced to a writer stored at
// `at`. `fd` is the function being walked (0 for a closure or top level): a
// flow still relative to one of its parameters becomes a copy from that
// parameter's own holder, whose stores are the arguments of its callers.
fn relationAutoWriterOf(
  c: Checker,
  flow: RelationAutoFlow,
  fd: int,
  tgt: RelationAutoStore,
): RelationAutoWriter {
  if (!flow.found) {
    return relationAutoWriterBad(tgt)
  }
  if (relationAutoIsHolderName(flow.paramName)) {
    return RelationAutoWriter{
      ok = true, names = []string(0), via = flow.paramName, path = flow.path, site = tgt.site,
      at = tgt.at, qkey = "",
    }
  }
  if (flow.queryCall <= 0) {
    return relationAutoWriterOfParam(c, flow, fd, tgt)
  }
  let owner = c.mods[flow.ownerModule]
  return RelationAutoWriter{
    ok = true, names = relationAutoQueryNames(owner, flow.queryCall), via = "", path = flow.path,
    site = RelationAutoSite{ mod = flow.ownerModule, node = flow.queryCall }, at = tgt.at,
    qkey = relationAutoQueryHolderKey(flow.ownerModule, flow.queryCall),
  }
}

// The name node of parameter `name` of function `fd` (a `FuncDecl`), or 0.
fn relationAutoParamNameNode(c: Checker, fd: int, name: string): int {
  if (fd == 0) {
    return 0
  }
  for p of kidsOf(c.tree, kidsOf(c.tree, fd)[3]) {
    let nameNode = kidsOf(c.tree, p)[0]
    let tag = getNode(c.tree, p).tag
    if ((tag == Tag.Param || tag == Tag.ParamRest) &&
      identText(c.tree, c.source, nameNode) == name) {
      return nameNode
    }
  }
  return 0
}

fn relationAutoWriterOfParam(
  c: Checker,
  flow: RelationAutoFlow,
  fd: int,
  tgt: RelationAutoStore,
): RelationAutoWriter {
  let nameNode = relationAutoParamNameNode(c, fd, flow.paramName)
  if (nameNode == 0) {
    return relationAutoWriterBad(tgt) // no function to ask about its callers
  }
  return RelationAutoWriter{
    ok = true, names = []string(0), via = relationAutoParamHolderKey(c.moduleId, nameNode),
    path = flow.path, site = tgt.site, at = tgt.at, qkey = "",
  }
}

// Whether `w` stores the rows `tgt` names back into themselves: a query's own
// rows into its `holder:Q`, a parameter's own rows (copied from its `holder:P`)
// into its `holder:S`.
fn relationAutoStoresIntoSelf(tgt: RelationAutoStore, w: RelationAutoWriter): bool {
  if (!w.ok || w.path != tgt.at) {
    return false
  }
  if (w.via == "") {
    return w.qkey == tgt.key
  }
  return relationAutoStoreKeyOfHolder(w.via) == tgt.key
}

// Records `w` as a store into `tgt`. A query's or a parameter's own rows stored
// back into the place they already are (`rows = rows`, `rows[0] = rows[1]`)
// change nothing and record nothing.
fn relationAutoHolderNote(h: RelationAutoHolders, tgt: RelationAutoStore, w: RelationAutoWriter) {
  if (tgt.key == "") {
    return
  }
  if (relationAutoStoresIntoSelf(tgt, w)) {
    return
  }
  let (old, ok) = h.writers[tgt.key]
  if (!ok) {
    old = []RelationAutoWriter(0)
  }
  h.writers[tgt.key] = append(old, w)
}

// True when some name in `names` is `path` or nests under it — a query that
// loads "author.posts" has loaded "author" on the way.
fn relationAutoNamesCover(names: []string, path: string): bool {
  for n of names {
    if (relationAutoPathIsPrefixOf(path, n)) {
      return true
    }
  }
  return false
}

// (proved, blame): whether `w` proves `need` (a path relative to the holder's
// rows), and why not when it does not. A query's writer also owes every store
// that replaced that query's rows.
fn relationAutoWriterProves(
  h: RelationAutoHolders, w: RelationAutoWriter, need: string, depth: int,
): (bool, RelationAutoBlame) {
  if (!w.ok) {
    return (false, RelationAutoBlame{ kind = RelationAutoBlameKind.Store, site = w.site })
  }
  let full = relationAutoJoinPath(w.path, need)
  if (w.via != "") {
    let (proved, blame) = relationAutoHolderProves(h, w.via, full, depth + 1)
    return (proved, relationAutoBlameStoredAt(blame, w.site))
  }
  if (!relationAutoNamesCover(w.names, full)) {
    return (false, RelationAutoBlame{ kind = RelationAutoBlameKind.Query, site = w.site })
  }
  return relationAutoReplacingStoresProve(h, w.qkey, full, depth + 1)
}

// A raw-SQL blame learns where THIS store put the rows; every other blame
// already names its own place.
fn relationAutoBlameStoredAt(blame: RelationAutoBlame, site: RelationAutoSite): RelationAutoBlame {
  if (blame.kind == RelationAutoBlameKind.Raw && blame.site.node == 0) {
    return RelationAutoBlame{ kind = RelationAutoBlameKind.Raw, site = site }
  }
  return blame
}

// Whether a store at path `at` inside a query's row can change what a read of
// `full` (a path from that row) sees: `at` is the row itself, or a proper
// ancestor of the read's path.
fn relationAutoStoreReaches(at: string, full: string): bool {
  return at == "" || (len(full) > len(at) && relationAutoPathIsPrefixOf(at, full))
}

// (proved, blame): every store recorded against `key` (a query's `holder:Q` or
// a parameter's `holder:S`) that reaches a read of `full` loaded what the read
// needs of the stored value. No store at all is proved: the query's own names,
// or the parameter's callers, are the whole proof.
fn relationAutoReplacingStoresProve(
  h: RelationAutoHolders, key: string, full: string, depth: int,
): (bool, RelationAutoBlame) {
  let (ws, ok) = h.writers[key]
  if (!ok) {
    return (true, relationAutoNoBlame())
  }
  if (depth > relationAutoHolderMaxDepth) {
    return (false, relationAutoNoBlame())
  }
  let all = true
  let blame = relationAutoNoBlame()
  for w of ws {
    if (!relationAutoStoreReaches(w.at, full)) {
      continue
    }
    let need = full
    if (w.at != "") {
      need = full[len(w.at) + 1:]
    }
    let (proved, why) = relationAutoWriterProves(h, w, need, depth)
    if (!proved) {
      all = false
      blame = relationAutoFirstBlame(blame, why)
    }
  }
  return (all, blame)
}

// The blame to report when two proofs both failed: the first one that says
// anything, else the later one.
fn relationAutoFirstBlame(have: RelationAutoBlame, next: RelationAutoBlame): RelationAutoBlame {
  if (have.kind != RelationAutoBlameKind.None) {
    return have
  }
  return next
}

// Whether the rows `flow` reaches loaded `need` (a path from those rows): a
// query's rows by its names and replacing stores, a holder's by its stores.
fn relationAutoFlowProves(
  h: RelationAutoHolders,
  flow: RelationAutoFlow,
  need: string,
): (bool, RelationAutoBlame) {
  if (flow.queryCall > 0) {
    return relationAutoReplacingStoresProve(
      h, relationAutoQueryHolderKey(flow.ownerModule, flow.queryCall), need, 0,
    )
  }
  return relationAutoHolderProves(h, flow.paramName, need, 0)
}

// What a holder nothing was ever stored into says about why it is unproven:
// rows from raw SQL never have a writer and can never be loaded; any other
// key (a parameter nothing calls) says nothing.
fn relationAutoUnwrittenBlame(key: string): RelationAutoBlame {
  if (relationAutoIsRawName(key)) {
    return RelationAutoBlame{
      kind = RelationAutoBlameKind.Raw, site = RelationAutoSite{ mod = 0, node = 0 },
    }
  }
  return relationAutoNoBlame()
}

fn relationAutoHolderProves(
  h: RelationAutoHolders, key: string, need: string, depth: int,
): (bool, RelationAutoBlame) {
  if (depth > relationAutoHolderMaxDepth) {
    return (false, relationAutoNoBlame())
  }
  let (ws, ok) = h.writers[key]
  if (!ok || len(ws) == 0) {
    let (emptied, known) = h.empty[key]
    return (known && emptied, relationAutoUnwrittenBlame(key))
  }
  let all = true
  let blame = relationAutoNoBlame()
  for w of ws {
    let (proved, why) = relationAutoWriterProves(h, w, need, depth)
    if (!proved) {
      all = false
      blame = relationAutoFirstBlame(blame, why)
    }
  }
  if (!all) {
    return (false, blame)
  }
  return relationAutoOwnStoresProve(h, key, need, depth)
}

// A parameter's holder (`holder:P`) is proven by its callers' arguments AND by
// the stores that replaced its rows inside its own function (#6366); every
// other key has no such stores.
fn relationAutoOwnStoresProve(
  h: RelationAutoHolders, key: string, need: string, depth: int,
): (bool, RelationAutoBlame) {
  let skey = relationAutoStoreKeyOfHolder(key)
  if (skey == "") {
    return (true, relationAutoNoBlame())
  }
  return relationAutoReplacingStoresProve(h, skey, need, depth + 1)
}

// The flow of a holder whose value at `node` is a `@table` row (or a slice of
// them) and whose key is `key`; not-found for every other type — a holder only
// matters for rows.
fn relationAutoHolderFlow(c: Checker, node: int, key: string): RelationAutoFlow {
  return relationAutoHolderFlowOfType(c, checkExprType(c, node), key)
}

fn relationAutoHolderFlowOfType(c: Checker, ty: int, key: string): RelationAutoFlow {
  let (cls, isSlice) = relationAutoParamTrackable(c, ty)
  if (!cls.found) {
    return relationAutoNoFlow(c)
  }
  return RelationAutoFlow{
    found = true, cls = cls, queryCall = 0, paramName = key, isSlice = isSlice,
    ownerModule = c.moduleId, path = "",
  }
}

// A plain local `let` (or `for-of` binder), or a parameter of a named
// function (#6352) — read where the walk has no binding for it, i.e. inside a
// closure that captures it. A parameter's stores are its callers' arguments
// (`relationAutoHolderNoteCall`, relationautostore.bit).
fn relationAutoHolderIdent(c: Checker, n: int): RelationAutoFlow {
  if (n <= 0 || n >= len(c.nodeSymbols)) {
    return relationAutoNoFlow(c)
  }
  let sid = c.nodeSymbols[n]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return relationAutoNoFlow(c)
  }
  let sym = c.symbols[sid]
  if (sym.kind == SymbolKind.LetBinding) {
    // A local `Option<Row>` is a holder of that row (#6407): every writer
    // (`relationAutoHolderNoteLet` and the assignments) is judged like a row's.
    let ty = relationAutoOptionPayload(c, checkExprType(c, n))
    return relationAutoHolderFlowOfType(c, ty, "${relationAutoHolderPrefix}C:${c.moduleId}:${sid}")
  }
  if (sym.kind == SymbolKind.Param) {
    return relationAutoHolderFlow(c, n, relationAutoParamHolderKey(c.moduleId, sym.decl))
  }
  return relationAutoNoFlow(c)
}

fn relationAutoHolderMember(c: Checker, n: int): RelationAutoFlow {
  let k = kidsOf(c.tree, n)
  if (len(k) < 2 || k[0] == 0 || k[1] == 0) {
    return relationAutoNoFlow(c)
  }
  let sty = checkExprType(c, k[0])
  if (sty == 0 || c.ctx.types[sty].kind != TypeKind.Struct) {
    return relationAutoNoFlow(c)
  }
  let key = "${relationAutoHolderPrefix}F:${sty}.${identText(c.tree, c.source, k[1])}"
  return relationAutoHolderFlow(c, n, key)
}

// `m[k]` on a map whose VALUE type is a row (or slice of rows).
fn relationAutoHolderIndex(c: Checker, n: int): RelationAutoFlow {
  let bt = checkExprType(c, kidsOf(c.tree, n)[0])
  if (bt == 0 || c.ctx.types[bt].kind != TypeKind.Map) {
    return relationAutoNoFlow(c)
  }
  let (cls, isSlice) = relationAutoParamTrackable(c, c.ctx.types[bt].mapVal)
  if (!cls.found) {
    return relationAutoNoFlow(c)
  }
  return RelationAutoFlow{
    found = true, cls = cls, queryCall = 0,
    paramName = "${relationAutoHolderPrefix}M:${cls.ty}:${isSlice}", isSlice = isSlice,
    ownerModule = c.moduleId, path = "",
  }
}

// The holder flow `n` is, by its own shape, or not-found.
fn relationAutoHolderOf(c: Checker, n: int): RelationAutoFlow {
  let tag = getNode(c.tree, n).tag
  if (tag == Tag.Ident) {
    return relationAutoHolderIdent(c, n)
  }
  if (tag == Tag.Member) {
    return relationAutoHolderMember(c, n)
  }
  if (tag == Tag.Index) {
    return relationAutoHolderIndex(c, n)
  }
  return relationAutoNoFlow(c)
}

// The hint for a read of `need` on `className`'s rows, reported at node `at` of
// `c`, that failed to prove it: every branch names something a developer can
// change so the build passes, and a place in another file says which file.
fn relationAutoHolderHint(
  c: Checker, at: int, need: string, className: string, blame: RelationAutoBlame,
): string {
  let place = relationAutoSitePhrase(c, at, blame.site)
  let verb = relationAutoSiteVerb(c, blame.site)
  if (blame.kind == RelationAutoBlameKind.Raw) {
    return relationAutoRawHint(need, className, verb, place)
  }
  if (place == "") {
    return relationAutoUnknownOriginHint(need)
  }
  if (blame.kind == RelationAutoBlameKind.Store) {
    let act = "store"
    if (verb == "returned") {
      act = "return"
    }
    return "the rows ${verb} ${place} cannot be traced to a query -- ${act} rows from a query " +
      "that loads '${need}' there (add '.with(\"${need}\")' to it)"
  }
  return "these rows came from the query ${place}, which does not load '${need}' " +
    "-- add '.with(\"${need}\")' to that query"
}
