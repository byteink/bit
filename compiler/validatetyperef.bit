// Self-host: E0058 generic arity at a type REFERENCE (§15.1), split out of
// validateattr.bit (#6369).

// A declaration's own type-parameter count: its `GenericParams` kid (kid 1 of
// a class, enum, interface or alias declaration), or 0 when it has none.
fn vDeclArity(oc: Checker, decl: int): int {
  let gen = kidsOf(oc.tree, decl)[1]
  if (gen == 0) {
    return 0
  }
  return len(kidsOf(oc.tree, gen))
}

// The type-parameter count of an IMPORTED named type, read from its declaring
// module, or -1 when `ut` is not one this checker can trace to a declaration.
// An alias resolves transparently to its target, so a name that lands on a
// generic instantiation is an alias of one and its own count is not recorded
// here: -1, never the target's count.
fn vImportedArity(c: Checker, ut: int): int {
  if (ut == 0 || typeInstOfResult(c.ctx, ut) >= 0) {
    return -1
  }
  let oc = typeOwner(c, ut)
  let kind = c.ctx.types[ut].kind
  let decl = 0
  if (kind == TypeKind.Struct) {
    decl = structDeclOf(c, ut)
  } else if (kind == TypeKind.Enum) {
    decl = enumDeclOf(c, ut)
  } else if (kind == TypeKind.Interface) {
    decl = declNodeIn(oc, Tag.InterfaceDecl, c.ctx.types[ut].name)
  }
  if (decl == 0) {
    return -1
  }
  return vDeclArity(oc, decl)
}

// The type-parameter count of the declaration an IMPORTED name `name` lands on,
// read where it is declared, or -1 when no declaration can be traced. Follows
// `importedFrom` through re-exports (bounded) to the module whose `typeDecls`
// holds the node. This is the only reader that sees an ALIAS imported from
// another module: `type X = Pair<i64, string>` resolves transparently to the
// instantiation, so `vImportedArity` below has no declaration to ask (#6379).
fn vOriginArity(c: Checker, name: string): int {
  let at = c
  let key = name
  let hops = 0
  while (hops < 8) {
    let (o, ok) = at.importedFrom[key]
    if (!ok || o.module < 0 || o.module >= len(c.mods)) {
      return -1
    }
    at = c.mods[o.module]
    key = o.name
    let decl = at.typeDecls[key]
    if (decl != 0) {
      return vDeclArity(at, decl)
    }
    hops = hops + 1
  }
  return -1
}

// How many type arguments the type name `name` takes, or -1 when this checker
// cannot establish one. -1 is the permissive answer and every judgement below
// acts only on a count >= 0: a name it cannot see (a function, an unresolved
// name, a generic function's own type parameter) costs MISSING, never
// FALSEPOS. A predeclared name (`i64`, `string`, `error`) and a type parameter
// take none; a type declared in this module answers from its declaration
// whatever its kind, an alias included; an imported one from its declaring
// module (`vImportedArity`).
fn vTypeArity(c: Checker, name: string): int {
  if (name == "") {
    return -1
  }
  if (primIndexByName(name) >= 0 || name == "error") {
    return 0
  }
  let ut = userTypeLookup(c, name)
  if (ut != 0 && c.ctx.types[ut].kind == TypeKind.TypeParam) {
    return 0
  }
  let local = c.typeDecls[name]
  if (local != 0) {
    return vDeclArity(c, local)
  }
  let origin = vOriginArity(c, name)
  if (origin >= 0) {
    return origin
  }
  return vImportedArity(c, ut)
}

// E0058 for a generic type named bare in a type position: `Box` where `Box<T>`
// is meant (§15.1). Called only for a kid its parent's tag makes a TYPE
// position (`vTypeRefs`); a bare `Ident` is otherwise just an identifier, and
// judging every one would fire on a variable named after a generic type.
fn vBareTypeRef(c: Checker, node: int) {
  if (node == 0 || getNode(c.tree, node).tag != Tag.Ident) {
    return
  }
  let name = vIdentText(c, node)
  let want = vTypeArity(c, name)
  if (want > 0) {
    reportNoHint(
      c.diags, ecGenericArityMismatch, vSpan(c, node),
      "'${name}' needs ${want} type argument(s); write '${name}<...>'",
    )
  }
}

// E0058 for a generic interface named BARE as a bound, `fn f<S: Store>(s: S)`
// for `interface Store<T>` (#6379). A bound is a name (`parseConstraint`,
// parsertype.bit): it cannot carry type arguments yet, so the bare form has no
// legal spelling, and accepting it left `S`'s methods typed against an open `T`.
// Judged on each bound of one `GenericParam` node `[name, constraint_or_none]`.
fn vBoundTypeRefs(c: Checker, node: int) {
  let k = kidsOf(c.tree, node)
  if (len(k) < 2 || k[1] == 0) {
    return
  }
  for b of kidsOf(c.tree, k[1]) {
    if (getNode(c.tree, b).tag != Tag.Ident) {
      continue
    }
    let name = vIdentText(c, b)
    let want = vTypeArity(c, name)
    if (want > 0) {
      reportNoHint(
        c.diags, ecGenericArityMismatch, vSpan(c, b),
        "'${name}' takes ${want} type argument(s), and a bound cannot carry type arguments yet; a generic type cannot be a bound",
      )
    }
  }
}

// E0058 for one `GenericInst` node naming a type: `Box<i64, i64>` against
// `Box<T>`, or any `<...>` on a type that takes none. Judged on the node
// itself, wherever it sits (a let annotation, a composite literal's type, a
// receiver, a signature), so no position has to be listed. A `GenericInst`
// naming a generic FUNCTION has no arity here (`vTypeArity` answers -1) and is
// left to the call check.
fn vGenericInstArity(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [name_ident, type_args]
  if (len(k) < 2) {
    return
  }
  let name = typeNodeName(c, node)
  let want = vTypeArity(c, name)
  let got = len(kidsOf(c.tree, k[1]))
  if (want < 0 || want == got) {
    return
  }
  reportNoHint(
    c.diags, ecGenericArityMismatch, vSpan(c, node),
    "'${name}' expects ${want} type argument(s), found ${got}",
  )
}

// Whether EVERY kid of a node with this tag is a type. `ArrayType` (kid 0 is
// its length expression) and `FuncType` (kid 0 is a `TypeList`, visited as a
// node of its own) are not here: `vTypeSlot` names their one type kid.
fn vKidsAreTypes(tag: Tag): bool {
  return tag == Tag.SliceType ||
    tag == Tag.PtrType ||
    tag == Tag.ChanType ||
    tag == Tag.MapType ||
    tag == Tag.TupleType ||
    tag == Tag.Fallible ||
    tag == Tag.TypeList ||
    tag == Tag.TypeArgs
}

// Whether a `tag` node with two or more kids holds its type at kid 1:
// `Param`/`ParamRest`/`Field`/`ArrowP` hold `[name, type, ...]`, `Binding`
// `[pattern, type_or_none, init]`, `TypeAssert` `[expr, type]`, `ArrayType`
// `[length, element]`, `FuncType` `[params, result]`.
fn vTypeAtOne(tag: Tag): bool {
  return tag == Tag.Param ||
    tag == Tag.ParamRest ||
    tag == Tag.Field ||
    tag == Tag.ArrowP ||
    tag == Tag.TypeAssert ||
    tag == Tag.ArrayType ||
    tag == Tag.FuncType ||
    tag == Tag.Binding
}

// The index of the ONE kid of a `tag` node with `n` kids that is a type, or -1.
// `TypeAlias` holds `[name, generics, type]`, `MethodSig` `[name, params,
// result]`; the rest are `vTypeAtOne`.
fn vTypeSlot(tag: Tag, n: int): int {
  if (n >= 2 && vTypeAtOne(tag)) {
    return 1
  }
  if (n >= 3 && (tag == Tag.TypeAlias || tag == Tag.MethodSig)) {
    return 2
  }
  return -1
}

// E0058 at ONE node of the blanket walk `vTypeNode` runs: a `GenericInst` is
// judged for its own count; every other node judges the bare generic names
// among the kids its tag makes type positions. No recursion, so a bare name is
// judged once, by its parent, and a nested `Pair<Box<i64>>` by each node in
// turn. A composite literal's own type is deliberately not a position: a bare
// generic name there infers its arguments from the field values (`Pair{ a = 1,
// b = "s" }`).
fn vTypeRefs(c: Checker, node: int) {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.GenericInst) {
    vGenericInstArity(c, node)
    return
  }
  if (tag == Tag.GenericParam) {
    vBoundTypeRefs(c, node)
    return
  }
  let k = kidsOf(c.tree, node)
  if (vKidsAreTypes(tag)) {
    for t of k {
      vBareTypeRef(c, t)
    }
    return
  }
  let at = vTypeSlot(tag, len(k))
  if (at >= 0) {
    vBareTypeRef(c, k[at])
  }
}

// `vTypeNodes` over `root`, with `gen` (a declaration's `GenericParams` node, or
// 0) as the open generic scope: a type parameter of the declaration resolves by
// name, so `T<i64>` with `T` a parameter is judged (`vTypeArity`). The previous
// scope is restored, not cleared: the sweep that reaches here leaves it at 0.
fn vTypeNodesIn(c: Checker, gen: int, root: int) {
  let saved = c.curGenericDecl
  c.curGenericDecl = gen
  vTypeNodes(c, root, 0)
  c.curGenericDecl = saved
}

// `vTypeNodes` over one child of a function declaration, plus the one position
// `vTypeNodes` cannot reach: the result type, which sits directly under the
// `FuncDecl` (kid 4) that the signature sweep (checkmodule.bit) does not visit
// as a node itself.
fn vSigTypeNodes(c: Checker, fnDecl: int, kid: int) {
  let k = kidsOf(c.tree, fnDecl)
  vTypeNodesIn(c, k[2], k[kid])
  if (kid == 4) {
    vBareTypeRef(c, k[kid])
  }
}

// Whether the declaration sweep (checkmodule.bit) runs `vDeclTypeNodes` over a
// declaration of this tag: every kind that holds type annotations of its own.
fn vDeclSweptForTypes(tag: Tag): bool {
  return tag == Tag.StructDecl ||
    tag == Tag.EnumDecl ||
    tag == Tag.TypeAlias ||
    tag == Tag.InterfaceDecl ||
    tag == Tag.TraitDecl
}

// `vTypeNodes` over a class, enum, alias or interface declaration, in the
// scope of its own type parameters (kid 1); a trait is swept member by member
// (`vTraitTypeNodes`), its kid 1 being the member list, not a generics node.
fn vDeclTypeNodes(c: Checker, decl: int) {
  if (getNode(c.tree, decl).tag == Tag.TraitDecl) {
    vTraitTypeNodes(c, decl)
    return
  }
  vTypeNodesIn(c, kidsOf(c.tree, decl)[1], decl)
}

// `vTypeNodes` over one trait member (SPEC §10.7): a field, or a method's
// `[name, generics, params, result, body]` in the scope of its OWN type
// parameters. The body (kid 4) is left out, exactly as `FuncDecl`'s is: the
// statement walk reaches it. A trait declares no generics itself, so a field
// is judged in no scope. An `export`ed member is unwrapped first.
fn vTraitMemberTypeNodes(c: Checker, member: int) {
  let m = member
  if (getNode(c.tree, m).tag == Tag.Export) {
    m = kidsOf(c.tree, m)[0]
  }
  let tag = getNode(c.tree, m).tag
  if (tag == Tag.Field) {
    vTypeNodesIn(c, 0, m)
    return
  }
  if (tag != Tag.TraitMethod) {
    return
  }
  let k = kidsOf(c.tree, m)
  let saved = c.curGenericDecl
  c.curGenericDecl = k[1]
  vTypeNodes(c, k[1], 0)
  vTypeNodes(c, k[2], 0)
  vTypeNodes(c, k[3], 0)
  vBareTypeRef(c, k[3])
  c.curGenericDecl = saved
}

// E0058 and the other type-node rules over a `trait` declaration's signatures
// and fields (#6379), which the declaration sweep (checkmodule.bit) skipped:
// `trait Tr { name(p: Box): i64 }` with `Box<T>` generic was accepted. A trait is
// swept member by member, not as a subtree, because its method bodies are not
// type positions.
fn vTraitTypeNodes(c: Checker, decl: int) {
  for m of kidsOf(c.tree, kidsOf(c.tree, decl)[1]) {
    vTraitMemberTypeNodes(c, m)
  }
}

// The type kid of a construct that declares a VALUE's type, or 0: `Binding`
// covers `let x: T`, `Param`/`ParamRest` a signature, `Field` a class member.
// `valueTypeKid` (validatestaticiface.bit) reads exactly these positions; the
// wider set E0058 judges is `vTypeSlot`.
fn vDeclaredTypeKid(c: Checker, node: int): int {
  let tag = getNode(c.tree, node).tag
  let k = kidsOf(c.tree, node)
  if (tag == Tag.Param || tag == Tag.ParamRest || tag == Tag.Field) {
    if (len(k) >= 2) {
      return k[1]
    }
    return 0
  }
  if (tag == Tag.Binding) {
    if (len(k) >= 3) {
      return k[1]
    } // [name, ty_or_none, init_or_none]
    return 0
  }
  return 0
}

// E0058 for the type arguments written on the Call `node` (`[callee, targs,
// args]`) when their count is not `want`: one place for the message every call
// shape shares (a free function, a method, a construction).
fn vTypeArgCountMismatch(c: Checker, node: int, name: string, want: int) {
  let targs = kidsOf(c.tree, node)[1]
  if (targs == 0) {
    return
  }
  let got = len(kidsOf(c.tree, targs))
  if (want == got) {
    return
  }
  reportNoHint(
    c.diags, ecGenericArityMismatch, vSpan(c, node),
    "'${name}' expects ${want} type argument(s), found ${got}",
  )
}

// The length of the `GenericParams` node `gen` of `oc`'s tree (0 when absent).
fn vGenericsLen(oc: Checker, gen: int): int {
  if (gen == 0) {
    return 0
  }
  return len(kidsOf(oc.tree, gen))
}

// A function declaration's own type-parameter count, 0 for an extern (§11.7).
fn vFuncArity(owner: Checker, decl: int): int {
  if (getNode(owner.tree, decl).tag != Tag.FuncDecl) {
    return 0
  }
  return vGenericsLen(owner, kidsOf(owner.tree, decl)[2])
}

// E0058 for explicit type arguments written on a call to a generic FUNCTION:
// `id<i64, i64>(1)` against `id<T>`, or `<...>` on a function that is not
// generic (§12.7, §15.3). Explicit arguments replace inference wholesale, so
// the list must have exactly the declaration's own length. `decl` is the callee
// in its OWNING module's tree (`owner`).
fn vCallTypeArgCount(c: Checker, node: int, owner: Checker, decl: int, name: string) {
  vTypeArgCountMismatch(c, node, name, vFuncArity(owner, decl))
}

// The same for a METHOD call `recv.m<...>(...)`. A method's generics are its
// receiver's own parameters followed by its own (`mergeGenericParams`,
// parsertype.bit), so the explicit list is judged against the remainder. No
// declaration (an interface method) is silence.
fn vMethodTypeArgCount(c: Checker, node: int, recvTy: int, fr: FuncRef, name: string) {
  if (fr.decl == 0) {
    return
  }
  let want = vFuncArity(fr.owner, fr.decl)
  let cls = 0
  if (c.ctx.types[recvTy].kind == TypeKind.Struct) {
    cls = structDeclOf(c, recvTy)
  } else if (c.ctx.types[recvTy].kind == TypeKind.Enum) {
    cls = enumDeclOf(c, recvTy)
  }
  if (cls != 0) {
    want = want - vDeclArity(typeOwner(c, recvTy), cls)
  }
  if (want < 0) {
    return
  }
  vTypeArgCountMismatch(c, node, name, want)
}
