// compiler/pmclioutdatedcheck.bit — in-Bit self-checks for
// compiler/pmclioutdated.bit's `bit outdated` (#2368). Sibling of
// pmclicheck.bit (same module), named to sort after it so `checkPmCli()`'s
// call into `checkPmCliOutdated` below is a backward reference. Reuses
// pmfetchresolvecheck.bit's `pmCheckScratchDir`/`pmBuildFixture`/
// `pmCheckTimeoutMs`/`pmGitMustSucceed`, pmcliaddedgecheck.bit's
// `pmCliCommitAndTag`, and pmzclicheck.bit's `pmCliBuildProjectDeps` — same
// module, unqualified, per this directory's own convention.

// Tags the fixture at `fx.dir` with v1.0.0 (unused below — its own
// resolution is exercised, not asserted, via `outdatedDependencies`'s
// `listVersions` call), v1.2.0, v1.2.3, v1.5.0 and v2.0.0, returning the two
// commits `checkPmCliOutdated` seeds into bit.lock. Split out so the check
// itself stays under the complexity-10 ceiling (spec/LINT.md E0204) — every
// `catch` here was a decision point in the same function.
fn pmCliOutdatedFixtureShas(fx: PmFixture): (string, string) {
  let tagV1 = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "v1.0.0", "-m", "v1.0.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git tag v1.0.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag v1.0.0", tagV1)
  let sha120 = pmCliCommitAndTag(fx.dir, "v1.2.0 commit", "v1.2.0")
  let sha123 = pmCliCommitAndTag(fx.dir, "v1.2.3 commit", "v1.2.3")
  let _ = pmCliCommitAndTag(fx.dir, "v1.5.0 commit", "v1.5.0")
  let _ = pmCliCommitAndTag(fx.dir, "v2.0.0 commit", "v2.0.0")
  return sha120, sha123
}

// `caretdep`/`exactdep`/`versioneddep`'s seeded bit.lock entries.
// `versioneddep`'s recorded `version` ("9.9.9") deliberately does NOT match
// its own `commit` (`sha120`, really v1.2.0) -- bit.lock's `version` field
// (#2856) must be trusted VERBATIM, never re-derived from the tag list, so
// this is the discriminator: if `outdatedLockedVersion` ever fell through
// to its reverse-lookup fallback instead of trusting the field, this would
// read back "1.2.0", not "9.9.9". Split out of `checkPmCliOutdated` so that
// function stays under the 80-line ceiling (spec/LINT.md E0201).
fn pmCliOutdatedSeed(url: string, sha120: string, sha123: string): []LockEntry {
  return [
    LockEntry{
      name: "caretdep",
      url: url,
      commit: sha120,
      requires: []LockRequire(0),
      vanity: "",
      localPath: "",
      dir: "",
    },
    LockEntry{
      name: "exactdep",
      url: url,
      commit: sha123,
      requires: []LockRequire(0),
      vanity: "",
      localPath: "",
      dir: "",
    },
    LockEntry{
      name: "versioneddep",
      url: url,
      commit: sha120,
      version: "9.9.9",
      requires: []LockRequire(0),
      vanity: "",
      localPath: "",
      dir: "",
    },
  ]
}

// A caret dependency locked to an OLDER commit than its constraint's ceiling
// allows, and an exact-pinned dependency locked to the newest commit its own
// (exact) constraint allows — the two cases #2368's acceptance table
// distinguishes: `wanted` moves for the caret dependency but not the exact
// one, while `latest` is the same 2.0.0 ceiling-crossing version for both
// (only `bit up --latest` may ever reach it). Confirms `bit.json`/`bit.lock`
// are byte-identical before and after — `bit outdated` is read-only.
fn checkPmCliOutdated() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let (sha120, sha123) = pmCliOutdatedFixtureShas(fx)

  let deps = "    \"caretdep\": \"github.com/pmclicheck/caretdep@^1.2.0\",\n" +
    "    \"exactdep\": \"github.com/pmclicheck/exactdep@1.2.3\",\n" +
    "    \"versioneddep\": \"github.com/pmclicheck/versioneddep@1.2.0\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read seeded bit.json: " + e.message())
  }

  let lockPath = proj.dir + "/bit.lock"
  writeLock(lockPath, pmCliOutdatedSeed(url, sha120, sha123)) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }
  let originalLock = readFile(lockPath) catch e {
    panic("pmclicheck: cannot read seeded bit.lock: " + e.message())
  }

  let rows = outdatedDependencies(proj.dir, defaultGitBin, pmCheckTimeoutMs) catch e {
    panic("pmclicheck: outdatedDependencies failed: " + e.message())
  }
  assert(len(rows) == 3)

  // caretdep: locked at v1.2.0 (stale within range), `wanted` moves to
  // v1.5.0 — the highest tag inside `^1.2.0` (< 2.0.0) — exactly what plain
  // `bit up` would move bit.lock to; `latest` is v2.0.0, outside the range,
  // reachable only via `bit up --latest`.
  assert(rows[0].name == "caretdep")
  assert(rows[0].locked == "1.2.0")
  assert(rows[0].wanted == "1.5.0")
  assert(rows[0].latest == "2.0.0")

  // exactdep: an exact pin's `wanted` never moves off the locked commit
  // (matches plain `bit up`'s own "never moves an exact pin" rule) even
  // though a newer `latest` is published.
  assert(rows[1].name == "exactdep")
  assert(rows[1].locked == "1.2.3")
  assert(rows[1].wanted == "1.2.3")
  assert(rows[1].latest == "2.0.0")

  // versioneddep: the bit.lock `version` field is trusted verbatim -- see
  // the seed comment above for why "9.9.9" (not "1.2.0") proves the fast
  // path, not the reverse-lookup fallback, produced this.
  assert(rows[2].name == "versioneddep")
  assert(rows[2].locked == "9.9.9")
  assert(rows[2].wanted == "1.2.0")
  assert(rows[2].latest == "2.0.0")

  let finalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
  }
  assert(finalBitJson == originalBitJson)
  let finalLock = readFile(lockPath) catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(finalLock == originalLock)
}
