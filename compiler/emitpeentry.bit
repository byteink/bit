fn emPeRefuseSyscalls(module: IrModule, freestanding: bool): ()! {
  // §11.8: `syscall()` is Linux-only — Windows publishes no stable syscall
  // ABI either (pesyms.bit's own module comment), so a raw `syscall`
  // instruction reaching a Windows image would trap at load with no line
  // number. Mirrors emitmacho.bit's identical guard for aarch64-macos.
  let sf = 0
  while (sf < len(module.funcs)) {
    let sfn = module.funcs[sf]
    if (!emitsFunction(sfn, freestanding)) {
      sf = sf + 1
      continue
    }
    let si0 = 0
    while (si0 < len(sfn.instrs)) {
      if (sfn.instrs[si0].op == Op.Syscall) {
        fail newError("'syscall' is not supported on x86_64-windows: Windows publishes no stable syscall ABI (SPEC §11.8)")
      }
      si0 = si0 + 1
    }
    sf = sf + 1
  }

}

fn emPeEntry(withEntry: bool, code: ByteBuf, fr: EmPeFuncsResult): ()! {
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined
  if (withEntry) {
    if (!fr.haveMain) {
      // Wording shared with emitelf.bit/emitmacho.bit, defined once in
      // build.bit (#2234).
      fail newError(noMainMessage())
    }

    // ---- bit_main entry trampoline (Win64) ---------------------------------
    // The runtime calls bit_main (boot runs it as a green thread); a void
    // `main` still owes an exit code, so the trampoline supplies 0. Shaped
    // like emitelf.bit's x64 trampoline ("sub rsp,N ; call main ; ... ; add
    // rsp,N ; ret") but N is 40 rather than 8: Win64 additionally reserves 32
    // bytes of caller "home space" below the call, on top of the 8 the SysV
    // trampoline uses purely for 16-byte alignment at the CALL instruction
    // (on entry rsp%16==8, same on both ABIs — the return address bit_main's
    // own caller pushed).
    let tramp = len(code.bytes)
    appendBytes(code, [u8(0x48), u8(0x83), u8(0xEC), u8(0x28)]) // sub rsp, 40
    code.bytes = append(code.bytes, u8(0xE8))                   // call rel32
    let callField = len(code.bytes)
    appendZeros(code, 4)
    pePatchRel32Addend(code.bytes, callField)
    relocs = append(
      relocs,
      PeRelocation{
        section = PeSectionKind.Text,
        offset = callField, symbol = "main", kind = PeRelocKind.Rel32,
      },
    )
    if (fr.mainVoid) {
      appendBytes(code, [u8(0x31), u8(0xC0)]) // xor eax, eax
    }
    appendBytes(code, [u8(0x48), u8(0x83), u8(0xC4), u8(0x28), u8(0xC3)]) // add rsp,40 ; ret
    symbols = append(
      symbols,
      PeSymbol{
        name = "bit_main", hasSection = true,
        section = PeSectionKind.Text, offset = tramp, size = len(code.bytes) - tramp,
        binding = PeBinding.Global, kind = PeSymKind.Func,
      },
    )
    defined["bit_main"] = true
  }
  // The trampoline is a function entry too, and a padded tail makes every
  // atom a whole number of 32-byte units, so the linker never fills a gap
  // between two of them with bytes of its own.
  xPadFuncAlign(code)

  fr.symbols = symbols
  fr.relocs = relocs
}
