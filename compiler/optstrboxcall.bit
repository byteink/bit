// compiler/optstrboxcall.bit — split out of optstrbox.bit (#7178) when the
// #7176/#7178/#7179 admissions took it past 800 lines: the CALL half of the
// reuse question, whether a call's three result words come back as a handle
// the caller's reuse test accepts. Same module as optstrbox.bit, so nothing
// here needs an import; the moved text is byte-identical.

// How the caller's reuse test fares on the callee `gs.f`'s `ret` `r`, reached
// through the call `c` in `fs.f` — the static half of the reuse invariant, and
// this pass's profit test. 1: the test succeeds there. 0: it fails there. -1:
// the `ret` is a shape this pass has no answer for, which refuses the site.
//
// A `ret` whose words 0 and 1 are read out of its word 2 hands back a handle
// that denotes its own bytes — a literal's static header, or a handle loaded
// from a field — so the test succeeds by construction.
//
// #5945: a `ret` passing one `string` parameter's incoming words through
// unchanged hands back exactly what the caller passed, so the caller's own
// argument words decide it, as they would for a box built straight from them:
// a handle the caller holds succeeds, and a view built at the call, whose word
// 2 is its source, fails. `canonMethod` (std/http message.bit) is the shape:
// seven literal returns and one passthrough, called on a fresh substring.
//
// #7163: a `ret` forwarding the inner call `k`'s three result words hands back
// whatever `k`'s target hands back, so it succeeds exactly where that target
// does: 1 when `callReturnsReusable` admits `k`, 0 when it refuses.
// `pick(o) { return unwrap(o) }` is the shape — a generic instance is not
// inlined, so no fold leaves its own handle's words in `pick`.
fn retReuseVerdict(x: StrBoxScan, fs: StrBoxFn, gs: StrBoxFn, c: int, r: IrInstr): int {
  if (len(r.args) != 3) {
    return -1
  }
  if (boxWordsAreOwnHandle(gs, r.args[0], r.args[1], r.args[2])) {
    return 1
  }
  let k = callOfWords(gs, r.args[0], r.args[1], r.args[2])
  if (k >= 0) {
    return callReturnsReusable(x, gs, k) ? 1 : 0
  }
  let p = paramWordsBase(x.ctx, gs, r.args[0], r.args[1], r.args[2])
  let args = fs.f.instrs[c].args
  if (p < 0 || len(args) != gs.f.blocks[0].paramCount) {
    return -1
  }
  return argWordsVerdict(x, fs, gs.depth, args, p)
}

// How the caller's reuse test fares on the argument `args[p..p+2]` a callee
// hands straight back: 1 for a handle's own words or the caller's own
// parameter's, as `argWordsAreHandle` reads them, else 0.
//
// #7165: the argument may itself be another call's three result words —
// `chain("z")` once `mid` and `idf` are spliced in is four `idf$10(%c, ..)`
// calls each passing the last one's words — and is then answered by asking that
// call, with `depth` (the calls already followed) carried over so the walk
// stays inside `strBoxForwardDepth`.
fn argWordsVerdict(x: StrBoxScan, fs: StrBoxFn, depth: int, args: []int, p: int): int {
  if (argWordsAreHandle(x.ctx, fs, args[p], args[p + 1], args[p + 2])) {
    return 1
  }
  let k = callOfWords(fs, args[p], args[p + 1], args[p + 2])
  if (k < 0) {
    return 0
  }
  let at = StrBoxFn{ f = fs.f, rep = fs.rep, depth = depth }
  return callReturnsReusable(x, at, k) ? 1 : 0
}

// Whether the caller's words `a0`, `a1`, `a2` for one argument are a handle's
// own `ptr`/`len` and that handle, or the caller's own parameter's incoming
// words — the two box shapes `reusableStringBox` admits without a call.
fn argWordsAreHandle(ctx: TypeContext, fs: StrBoxFn, a0: int, a1: int, a2: int): bool {
  return boxWordsAreOwnHandle(fs, a0, a1, a2) || paramWordsBase(ctx, fs, a0, a1, a2) >= 0
}

// Whether the call at `c` in `fs.f` resolves to `string` functions in
// `x.snap` whose every `ret` has an answer in `retReuseVerdict` and at least
// one succeeds. An unresolvable target — a `call_value`, an `rt_call`, or a
// name this module does not hold — refuses.
//
// One unanswerable `ret` refuses the whole function: `return s[lo:hi]` hands
// back a fresh view whose word 2 is its source, and #4648 measured what a
// diamond that fails costs — the allocation it already had plus three
// comparisons, bench/cases/json +2.77%. A callee whose every `ret` FAILS at
// this site refuses for the same reason. A mix is admitted: a caller cannot
// know which `ret` it will reach, and `canonMethod`'s common path is a literal.
// A function with no `ret` at all (every path panics) refuses — `pays` starts
// false — because there is nothing to have proven.
//
// `snap` is the module's function list as it stood BEFORE this pass rewrote
// anything, the same discipline #3163 gave the inliner: a pass that reads
// callees out of the list it is halfway through mutating gets an answer that
// depends on function order.
//
// #7163: `retReuseVerdict` asks this again about a call a `ret` forwards, so
// the question recurses through a chain of forwarders, a recursive one
// included. `fs.depth` counts the calls already followed and refuses at
// `strBoxForwardDepth`, which bounds the walk whatever the call graph.
//
// #7178: an interface dispatch is asked the same question of EVERY method it
// can land on, their `ret`s pooled as one function's would be: once #7146
// returned `use<T>`'s result in words and the inliner spliced it into `main`,
// the `call_iface` was the only call left to ask, and refusing it cost one
// header per call that the return-site diamond had reused before.
fn callReturnsReusable(x: StrBoxScan, fs: StrBoxFn, c: int): bool {
  if (fs.depth >= strBoxForwardDepth) {
    return false
  }
  let targets = callTargetsOf(x, fs.f.instrs[c])
  let pays = false
  for gi of targets {
    let v = targetReuseVerdict(x, fs, c, gi)
    if (v < 0) {
      return false
    }
    pays = pays || v == 1
  }
  return pays
}

// The `x.snap` index of every function the call `call` can run, or an empty
// list when one of them is unknown — which `callReturnsReusable` refuses.
//
// A `call_iface` reaches exactly the methods whose slot in `x.tables` carries
// its id, the enumeration `calmIfaceTargets` (optappendfield.bit) rests on:
// `bit_rt_iface_lookup` resolves an id only through a receiver's TypeInfo,
// every TypeInfo with methods is one of those tables, and the module is the
// whole program. #5945's passthrough answer cannot misread such a method's
// parameters: `call.args` omits the receiver its entry block counts, so
// `retReuseVerdict`'s arity test refuses the site instead.
fn callTargetsOf(x: StrBoxScan, call: IrInstr): []int {
  let out = []int(0)
  if (call.op == Op.Call) {
    let gi = funcIndexByName(x.snap, call.name)
    return gi < 0 ? out : [gi]
  }
  if (call.op != Op.CallIface) {
    return out
  }
  for t of x.tables {
    for s of t.methods {
      if (s.id != call.ival) {
        continue
      }
      let gi = funcIndexByName(x.snap, s.func)
      if (gi < 0) {
        return []int(0)
      }
      out = append(out, gi)
    }
  }
  return out
}

// How the caller's reuse test fares on the target `x.snap[gi]` of the call `c`
// in `fs.f`: -1 when it is not a `string` function with a body or one of its
// `ret`s has no answer in `retReuseVerdict`, else 1 when one `ret` succeeds
// and 0 when none does.
fn targetReuseVerdict(x: StrBoxScan, fs: StrBoxFn, c: int, gi: int): int {
  let g = x.snap[gi]
  if (g.result != primType(x.ctx, 11) || len(g.blocks) == 0) {
    return -1
  }
  let gs = StrBoxFn{ f = g, rep = []int(0), depth = fs.depth + 1 }
  let pays = 0
  for r of g.instrs {
    if (r.op != Op.Ret) {
      continue
    }
    let v = retReuseVerdict(x, fs, gs, c, r)
    if (v < 0) {
      return -1
    }
    pays = v == 1 ? 1 : pays
  }
  return pays
}
