// compiler/classtablerelation.bit — `@table`'s relation-loading generic
// static (#6277, epic #6261, `.claude/kb/data-packages-dx.md` "Approved
// 2026-09-29"): `static __loadRelation(db: Data, name: string, rows: []Self): []Self!`,
// added to `Tabled` (pkg/orm/db.bit) so `Repo<T>.with` (#6275,
// pkg/orm/repo.bit) needs no reflection on `T` — it is synthesized ON the
// concrete class, so its body reads/writes the class's OWN relation field
// directly, never through a generic type parameter (unlike
// `pkg/orm/relation.bit`'s retired per-entity wrapper, which needed a
// caller-supplied `assign` closure for the identical reason,
// `compiler/classrelationattr.bit`'s own header).
//
// SYNTHESIZED FOR EVERY `@table` CLASS, UNCONDITIONALLY (mirrors
// classtablerow.bit's own four members) — a class with no relation field
// still needs the member to satisfy `Tabled`; its body is an empty
// dispatch table, which `pkg/orm/relationload.bit`'s `dispatchLoadRelation`
// fails naming the class for.
//
// ALL THE LOOPING LIVES IN `pkg/orm/relationload.bit`, HAND-WRITTEN, NOT
// SYNTHESIZED. `belongsToRelation`/`hasOneRelation`/`hasManyRelation` (that
// file) take only tiny per-field closures (`(r) => r.authorId`,
// `(r, v) => { r.author = v }`) — the ONLY things that differ per CONCRETE
// relation field, and so the only things this file builds. Each
// `__loadRelation` body is ONE `map<string, RelationLoader<Self>>`
// composite literal, one entry per relation field, handed to
// `dispatchLoadRelation`.
//
// `__linkRelation` (`@manyToMany`'s own static, `Tabled`) IS SYNTHESIZED AS
// A STUB HERE, NOT YET FUNCTIONAL: every `@table` class gets one that
// always fails "many-to-many linking is not yet supported" — needed so
// every class keeps satisfying the widened `Tabled` bound (`pkg/orm/db.bit`)
// today, but `Repo<T>.link`/`unlink` (#6275) do not yet work end to end.
// Real `@manyToMany` linking (join table/columns from the class's own raw
// name, `pkg/orm/manytomany.bit`'s `attach`/`detach`) is follow-up work, not
// attempted in this pass — flagged, not silently assumed done.

const classAttrManyToMany = "manyToMany"

const synthLoadRelationName = "__loadRelation"
const synthLinkRelationName = "__linkRelation"

// One relation field ready for synthesis: its own name/type node, which
// compiler-known kind, and the attribute's own single string argument
// (decoded text) — the FK Bit field name for `@hasMany`/`@hasOne`, the
// child's own FK Bit field name read on the child for `@belongsTo`, "" for
// `@manyToMany` (its argument is the join table name, not read here since
// `__linkRelation` is a stub — see this file's header).
class TableRelationField {
  nameNode: int,
  typeNode: int,
  kind: string,
  argWord: string,
}

class TableRelationClass {
  tc: TableClass,
  loadFields: []TableRelationField,
  // Whether `tc` itself satisfies `Tabled` (`canFromRow`, classtablerow.bit)
  // — `synthLoadRelation` emits the trivial always-fail stub instead of a
  // real `dispatchLoadRelation<Own>(...)` call when false, since that call
  // would itself need `Own: Tabled` to type-check, independent of
  // `loadFields` being empty.
  canFromRow: bool,
}

// Every `@table` class, always — mirrors `collectTableRowClasses`
// (classtablerow.bit): no class is ever DROPPED, since `__loadRelation` is
// synthesized unconditionally (this file's header). Takes `[]TableRowClass`,
// not `[]TableClass`, because a relation field's arm is only buildable when
// BOTH sides carry `__fromRow` (`canFromRow`, classtablerow.bit) — every
// `dispatchLoadRelation<Own>`/`belongsToRelation<Own,Target>` call this file
// synthesizes needs `Tabled` on its own type arguments to type-check the
// DECLARATION itself, whether or not anything ever calls it. `relPerson`/
// `relPost` (pkg/orm/relation.test.bit) are the canonical `canFromRow=false`
// case classtablerow.bit's own header names: a bare-class `@belongsTo`/
// `@hasOne` field has no zero value, so their composite literal cannot omit
// it, so `__fromRow` is skipped for them — and so must every relation arm
// that would otherwise name them as a `Tabled` type argument.
fn collectTableRelationClasses(
  tree: Tree,
  source: string,
  tableRowClasses: []TableRowClass,
): []TableRelationClass {
  let out = []TableRelationClass(0)
  for c of tableRowClasses {
    let fields = []TableRelationField(0)
    if (c.canFromRow) {
      fields = tableRelationFieldsOf(tree, source, c.tc, tableRowClasses)
    }
    out = append(
      out,
      TableRelationClass{ tc = c.tc, loadFields = fields, canFromRow = c.canFromRow },
    )
  }
  return out
}

// Whether `word` names a `TableRowClass` in `all` with `canFromRow` true —
// the target-side half of the same guard `collectTableRelationClasses`
// applies to the owning side.
fn tableRowClassFromRowByName(
  tree: Tree,
  source: string,
  all: []TableRowClass,
  word: string,
): bool {
  for c of all {
    if (identText(tree, source, c.tc.className) == word && c.canFromRow) {
      return true
    }
  }
  return false
}

fn tableRelationFieldsOf(
  tree: Tree,
  source: string,
  tc: TableClass,
  all: []TableRowClass,
): []TableRelationField {
  let out = []TableRelationField(0)
  for f of tc.fields {
    for a of f.attrs {
      let name = identText(tree, source, a.nameNode)
      if (!attrNameIsRelation(name)) {
        continue
      }
      let targetWord = identText(
        tree,
        source,
        tableRelationTargetIdentNode(
          tree,
          TableRelationField{
            nameNode = f.nameNode,
            typeNode = f.typeNode,
            kind = name,
            argWord = "",
          },
        ),
      )
      if (!tableRowClassFromRowByName(tree, source, all, targetWord)) {
        continue
      }
      out = append(
        out,
        TableRelationField{
          nameNode = f.nameNode, typeNode = f.typeNode, kind = name,
          argWord = tableRelationArgWord(tree, source, f.attrs, name),
        },
      )
    }
  }
  return out
}

// The relation attribute's own single string argument, decoded — "" when it
// carries none (a bare `@hasMany` with no FK argument is a `pkg/orm`
// runtime concern, not this file's).
fn tableRelationArgWord(tree: Tree, source: string, attrs: []RecordedAttr, name: string): string {
  for a of attrs {
    if (identText(tree, source, a.nameNode) != name || len(a.args) == 0) {
      continue
    }
    let sp = getNode(tree, a.args[0]).span
    return decodeStringContent(source, sp.start, sp.end)
  }
  return ""
}

// The class's own `@id` field's name node, or 0 — `applyDefaultIdField`
// (classtabledefaultid.bit) already guarantees one exists on every `@table`
// class (a bare `id` field counts, even with no explicit `@id`), so 0 here
// means the class carries a composite key, which this file (like
// `pkg/orm/repo.bit`'s own single-key limitation) does not support — a
// relation field on such a class synthesizes a loader that panics through
// `relationIdField`'s own runtime error instead, never silently picking one
// of several key fields.
fn tableClassIdFieldNameNode(tree: Tree, source: string, tc: TableClass): int {
  for f of tc.fields {
    for a of f.attrs {
      if (identText(tree, source, a.nameNode) == "id") {
        return f.nameNode
      }
    }
  }
  return 0
}

// `f`'s target class NAME NODE: the slice element (`@hasMany`'s `[]Post`) or
// the bare class type itself (`@hasOne`/`@belongsTo`'s `Profile`/`Author`).
fn tableRelationTargetIdentNode(tree: Tree, f: TableRelationField): int {
  if (f.kind == classAttrHasMany) {
    return kidsOf(tree, f.typeNode)[0]
  }
  return f.typeNode
}

// ---- building ---------------------------------------------------------

// Reuses classtabledesc.bit's own `TableBuild`/`tbNode`/`tbIdent`/`tbStrLit`/
// `tbCall`/`tbFieldInit` (same module, SPEC §17.1) for everything they
// already cover; the few shapes below (generic calls, arrow functions, a
// field assignment, map types) are new to this file only because no
// existing synthesis needed them yet.

// A clone of an EXISTING node's span as a fresh `Tag.Ident` leaf — the same
// technique `classtablerow.bit`'s `tableNameLitNode`/`tbThisField` already
// use: cloning the span clones the printed text, so no new `SynthText` word
// is needed for a name that already appears in source (a class name, a
// field name).
fn rbCloneIdent(tree: Tree, node: int): int {
  return addLeaf(tree, Tag.Ident, getNode(tree, node).span)
}

// `recvWord.field` — `recvWord` a synthesized parameter name (`"r"`),
// `field` an EXISTING field name node cloned the same way `rbCloneIdent`
// clones a class name.
fn rbMember(b: TableBuild, recvWord: string, field: int): int {
  return tbNode(b, Tag.Member, [tbIdent(b, recvWord), rbCloneIdent(b.tree, field)])
}

// `recvWord.field = valWord` — the ONLY statement an assigning closure's
// body ever needs.
fn rbAssignField(b: TableBuild, recvWord: string, field: int, valWord: string): int {
  let lhsList = tbNode(b, Tag.LhsList, [rbMember(b, recvWord, field)])
  let rhsList = tbNode(b, Tag.ExprList, [tbIdent(b, valWord)])
  return addNode(b.tree, Tag.Assign, b.span, int(Kind.Eq), [lhsList, rhsList])
}

// `(paramWord) => exprBody` — a single-parameter arrow with an EXPRESSION
// body (never a block), the shape every "read a field" closure this file
// builds needs.
fn rbArrow1(b: TableBuild, paramWord: string, exprBody: int): int {
  let p = tbNode(b, Tag.ArrowP, [tbIdent(b, paramWord), 0])
  let params = tbNode(b, Tag.ArrowParams, [p])
  return tbNode(b, Tag.ArrowFn, [params, exprBody])
}

// `(p1, p2) => { stmts }` — the shape every "assign a field" closure needs;
// `stmts` is always exactly `[rbAssignField(...)]` in this file.
fn rbArrow2(b: TableBuild, p1: string, p2: string, stmts: []int): int {
  let a1 = tbNode(b, Tag.ArrowP, [tbIdent(b, p1), 0])
  let a2 = tbNode(b, Tag.ArrowP, [tbIdent(b, p2), 0])
  let params = tbNode(b, Tag.ArrowParams, [a1, a2])
  return tbNode(b, Tag.ArrowFn, [params, tbNode(b, Tag.Block, stmts)])
}

// `callee<typeArgs...>(args...)` — `tbCall`'s own shape (classtabledesc.bit)
// plus a `TypeArgs` node in the slot `tbCall` always leaves 0.
fn rbGenericCall(b: TableBuild, calleeWord: string, typeArgs: []int, args: []int): int {
  let argNodes = []int(0)
  for a of args {
    argNodes = append(argNodes, tbNode(b, Tag.Arg, [a]))
  }
  return tbNode(
    b, Tag.Call, [
      tbIdent(b, calleeWord),
      tbNode(b, Tag.TypeArgs, typeArgs),
      tbNode(b, Tag.Args, argNodes),
    ],
  )
}

// `map<string, elemType>` — a `Tag.MapType` keyed by `string`.
fn rbStringMapType(b: TableBuild, elemType: int): int {
  return tbNode(b, Tag.MapType, [tbIdent(b, "string"), elemType])
}

// `RelationLoader<own>` in TYPE position — `Tag.GenericInst`'s own shape
// (`classtablerow.bit`'s `tableRowFieldOmittable` reads the identical shape
// for `Option<>`).
fn rbGenericInstType(b: TableBuild, baseWord: string, arg: int): int {
  return tbNode(b, Tag.GenericInst, [tbIdent(b, baseWord), tbNode(b, Tag.TypeArgs, [arg])])
}

// The class's own field named `word`, or 0 — `@belongsTo`'s FK
// (`f.argWord`) names a field on the SAME class it decorates, unlike
// `@hasOne`/`@hasMany`'s, which names a field on the TARGET class instead
// (read generically at runtime, `relationIdField`/`groupRelationRows`,
// `pkg/orm/relationload.bit`, never resolved here).
fn tableFieldNamedNode(tree: Tree, source: string, fields: []TableField, word: string): int {
  for f of fields {
    if (identText(tree, source, f.nameNode) == word) {
      return f.nameNode
    }
  }
  return 0
}

// The per-class context every relation-field builder below needs, bundled
// so none of them exceeds LINT.md's max-params=5 (`tc`/`ownIdField` are
// computed ONCE per class, `synthLoadRelation`, never re-derived per
// field). The owning class's own name is `tc.className` itself — always
// CLONED by span (`rbCloneIdent`), never carried as text, since a class
// name is unbounded per-project source, not a fixed synthesis word.
class RelSynthCtx {
  tree: Tree,
  source: string,
  tc: TableClass,
  ownIdField: int,
}

// One `"name": call(...)` map entry for a single relation field.
fn rbLoadFieldEntry(b: TableBuild, ctx: RelSynthCtx, f: TableRelationField): int {
  let fieldWord = identText(ctx.tree, ctx.source, f.nameNode)
  let key = addLeaf(ctx.tree, Tag.StringLit, synthSpan(b.st, "\"" + fieldWord + "\""))
  let val = rbLoadFieldCall(b, ctx, f)
  return tbNode(b, Tag.MapEntry, [key, val])
}

// `belongsToRelation<own,target>(readFk, assignField)` /
// `hasOneRelation<own,target>(readOwnId, "fk", assignField)` /
// `hasManyRelation<own,target>(readOwnId, "fk", assignField)` — the three
// shapes `pkg/orm/relationload.bit`'s own constructors take, one call per
// relation field.
fn rbLoadFieldCall(b: TableBuild, ctx: RelSynthCtx, f: TableRelationField): int {
  // Class names are EXISTING source text, not synthesized words — cloned by
  // span (`rbCloneIdent`), never routed through `tbIdent`/`synthIdent`,
  // which requires the word pre-registered in `SynthText` (this file's own
  // header omits neither "Post" nor "Author" from any fixed word list on
  // purpose: a class name is per-project, unbounded, and cannot be).
  let typeArgs = [
    rbCloneIdent(ctx.tree, ctx.tc.className), rbCloneIdent(
      ctx.tree,
      tableRelationTargetIdentNode(ctx.tree, f),
    ),
  ]
  let assignArrow = rbArrow2(b, "r", "v", [rbAssignField(b, "r", f.nameNode, "v")])
  if (f.kind == classAttrBelongsTo) {
    let ownFkNode = tableFieldNamedNode(ctx.tree, ctx.source, ctx.tc.fields, f.argWord)
    let readFk = rbArrow1(b, "r", rbMember(b, "r", ownFkNode))
    return rbGenericCall(b, "belongsToRelation", typeArgs, [readFk, assignArrow])
  }
  let readOwnId = rbArrow1(b, "r", rbMember(b, "r", ctx.ownIdField))
  let fkWord = addLeaf(ctx.tree, Tag.StringLit, synthSpan(b.st, "\"" + f.argWord + "\""))
  if (f.kind == classAttrHasOne) {
    return rbGenericCall(b, "hasOneRelation", typeArgs, [readOwnId, fkWord, assignArrow])
  }
  return rbGenericCall(b, "hasManyRelation", typeArgs, [readOwnId, fkWord, assignArrow])
}

// `__loadRelation`'s own single body statement: the real dispatch when
// `trc.canFromRow`, else `fail newError(...)` — see `synthLoadRelation`'s
// own call site for why the fallback exists.
fn rbLoadRelationBody(
  b: TableBuild,
  tree: Tree,
  st: SynthText,
  trc: TableRelationClass,
  ctx: RelSynthCtx,
): int {
  let classSpan = getNode(tree, trc.tc.className).span
  if (!trc.canFromRow) {
    let msg = addLeaf(
      tree, Tag.StringLit, synthSpan(
        st,
        "\"orm: this class does not satisfy Tabled, so no relation can be loaded on it\"",
      ),
    )
    return addNode(tree, Tag.FailStmt, classSpan, 0, [tbCall(b, tbIdent(b, "newError"), [msg])])
  }
  let entries = []int(0)
  for f of trc.loadFields {
    entries = append(entries, rbLoadFieldEntry(b, ctx, f))
  }
  let mapType = rbStringMapType(
    b,
    rbGenericInstType(b, "RelationLoader", rbCloneIdent(tree, trc.tc.className)),
  )
  let mapLit = tbNode(b, Tag.CompositeLit, [mapType, tbNode(b, Tag.MapEntries, entries)])
  let dispatchArgs = [tbIdent(b, "db"), tbIdent(b, "name"), tbIdent(b, "rows"), mapLit]
  let call = rbGenericCall(
    b,
    "dispatchLoadRelation",
    [rbCloneIdent(tree, trc.tc.className)],
    dispatchArgs,
  )
  let tryCall = addNode(tree, Tag.TryExpr, classSpan, 0, [call])
  return addNode(tree, Tag.ReturnStmt, classSpan, 0, [tryCall])
}

// `[export] static __loadRelation(db: Data, name: string, rows: []Own): []Own! { return dispatchLoadRelation<Own>(db, name, rows, map<string, RelationLoader<Own>>{...})? }`
fn synthLoadRelation(tree: Tree, source: string, st: SynthText, trc: TableRelationClass): int {
  let classSpan = getNode(tree, trc.tc.className).span
  let b = TableBuild{ tree = tree, st = st, span = classSpan }
  let ctx = RelSynthCtx{
    tree = tree, source = source, tc = trc.tc,
    ownIdField = tableClassIdFieldNameNode(tree, source, trc.tc),
  }
  // `!trc.canFromRow` (this class itself does not satisfy `Tabled` —
  // `relPerson`/`relPost`, this file's header): a real
  // `dispatchLoadRelation<Own>(...)` call would itself need `Own: Tabled`
  // to type-check the DECLARATION, so this emits the same trivial
  // always-fail body `synthLinkRelationStub` gives every `@manyToMany` stub
  // — never attempted, not silently pretended correct.
  let stmts = [rbLoadRelationBody(b, tree, st, trc, ctx)]
  let rowsParamType = addNode(
    tree,
    Tag.SliceType,
    classSpan,
    0,
    [rbCloneIdent(tree, trc.tc.className)],
  )
  let rowsResultType = addNode(
    tree,
    Tag.SliceType,
    classSpan,
    0,
    [rbCloneIdent(tree, trc.tc.className)],
  )
  let params = tbNode(
    b, Tag.Params,
    [
      tbNode(b, Tag.Param, [tbIdent(b, "db"), tbIdent(b, "Data")]),
      tbNode(b, Tag.Param, [tbIdent(b, "name"), tbIdent(b, "string")]),
      tbNode(b, Tag.Param, [tbIdent(b, "rows"), rowsParamType]),
    ],
  )
  let resultTy = addNode(tree, Tag.Fallible, classSpan, 0, [rowsResultType, 0])
  let recv = addNode(
    tree,
    Tag.Receiver,
    classSpan,
    1,
    [0, traitClassTypeRef(tree, trc.tc.className, 0)],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      recv, synthIdent(tree, st, synthLoadRelationName), 0, params, resultTy,
      addNode(tree, Tag.Block, classSpan, 0, stmts),
    ],
  )
  if (!trc.tc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// `[export] static __linkRelation(db: Data, name: string, op: LinkOp): ()! { fail newError("...") }`
// — a STUB (this file's header): real `@manyToMany` linking is follow-up
// work, not attempted in this pass.
fn synthLinkRelationStub(tree: Tree, st: SynthText, tc: TableClass): int {
  let classSpan = getNode(tree, tc.className).span
  let b = TableBuild{ tree = tree, st = st, span = classSpan }
  let msg = addLeaf(
    tree,
    Tag.StringLit,
    synthSpan(st, "\"orm: many-to-many linking is not yet supported\""),
  )
  let failExpr = tbCall(b, tbIdent(b, "newError"), [msg])
  let stmts = [addNode(tree, Tag.FailStmt, classSpan, 0, [failExpr])]
  let params = tbNode(
    b, Tag.Params,
    [
      tbNode(b, Tag.Param, [tbIdent(b, "db"), tbIdent(b, "Data")]),
      tbNode(b, Tag.Param, [tbIdent(b, "name"), tbIdent(b, "string")]),
      tbNode(b, Tag.Param, [tbIdent(b, "op"), tbIdent(b, "LinkOp")]),
    ],
  )
  let voidTy = addNode(tree, Tag.VoidType, classSpan, 0, []int(0))
  let resultTy = addNode(tree, Tag.Fallible, classSpan, 0, [voidTy, 0])
  let recv = addNode(
    tree,
    Tag.Receiver,
    classSpan,
    1,
    [0, traitClassTypeRef(tree, tc.className, 0)],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      recv, synthIdent(tree, st, synthLinkRelationName), 0, params, resultTy,
      addNode(tree, Tag.Block, classSpan, 0, stmts),
    ],
  )
  if (!tc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// ---- words / import / injection ---------------------------------------

// The fixed vocabulary every `__loadRelation`/`__linkRelation` pair needs,
// once per module carrying at least one `@table` class, plus one quoted
// word per relation field (its own name, and — for `@hasOne`/`@hasMany` —
// its FK argument) — mirrors `tableRowSynthWords`'s own fixed-plus-per-field
// shape (classtablerow.bit).
fn tableRelationSynthWords(tree: Tree, source: string, classes: []TableRelationClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    synthLoadRelationName, synthLinkRelationName,
    "Data", "string", "db", "name", "rows", "r", "v", "op",
    "dispatchLoadRelation", "RelationLoader", "belongsToRelation", "hasOneRelation", "hasManyRelation",
    "LinkOp", "newError", "\"orm: many-to-many linking is not yet supported\"",
    "\"orm: this class does not satisfy Tabled, so no relation can be loaded on it\"",
  ]
  for c of classes {
    for f of c.loadFields {
      out = append(out, "\"" + identText(tree, source, f.nameNode) + "\"")
      if (f.kind != classAttrBelongsTo) {
        out = append(out, "\"" + f.argWord + "\"")
      }
    }
  }
  return out
}

// `import { Data, LinkOp, RelationLoader, dispatchLoadRelation,
// belongsToRelation, hasOneRelation, hasManyRelation } from "orm"` — every
// name `__loadRelation`/`__linkRelation`'s own signature or body reaches,
// skipping whichever this module's `bound` map already carries (shared
// across features in the same module, `synthtext.bit`, the same reason
// `tableRowImportDecl` takes it).
fn tableRelationImportDecl(
  m: SrcModule,
  st: SynthText,
  classes: []TableRelationClass,
  bound: map<string, bool>,
): int {
  if (len(classes) == 0) {
    return 0
  }
  let wanted = [
    "Data", "LinkOp", "RelationLoader", "dispatchLoadRelation", "belongsToRelation", "hasOneRelation",
    "hasManyRelation",
  ]
  let names = []string(0)
  for w of wanted {
    let (_, already) = bound[w]
    if (!already) {
      names = append(names, w)
      bound[w] = true
    }
  }
  if (len(names) == 0) {
    return 0
  }
  return synthImportDecl(m, st, tableRelationOrmPath(m.tree, m.source), names)
}

// The EXACT path text this module already imports pkg/orm through — bare
// `"orm"` for released code, or a relative path ending `/orm` for
// in-repo dev fixtures (`ormPathMatches`, compiler/checkormquery.bit,
// reused unchanged — the same two spellings that gate `ormModuleImportsOrm`,
// which already guarantees one exists before this is ever called). Never
// hardcoded to `"orm"`: `synthImportDecl`'s own `importPathClone` matches
// by EXACT decoded text, so injecting `"orm"` into a module whose own
// import reads `"../../../pkg/orm"` (`_tests_/bit/checkercases/
// check_orm_repo_no_single_key.bit`, the fixture that caught this) would
// clone nothing and synthesize NO import at all — every name this file's
// synthesized bodies use would read as `E0040 undefined name`.
fn tableRelationOrmPath(tree: Tree, source: string): string {
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let pathText = stringLitText(source, getNode(tree, kidsOf(tree, d)[1]).span)
    if (ormPathMatches(pathText)) {
      return pathText
    }
  }
  return "orm"
}

// Every `@table` class's `__loadRelation`/`__linkRelation` pair, in order.
fn injectTableRelationDecls(
  tree: Tree,
  source: string,
  st: SynthText,
  classes: []TableRelationClass,
): []int {
  let out = []int(0)
  for c of classes {
    out = append(out, synthLoadRelation(tree, source, st, c))
    out = append(out, synthLinkRelationStub(tree, st, c.tc))
  }
  return out
}
