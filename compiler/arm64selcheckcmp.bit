// In-Bit self-checks for #4349: the compare-immediate fold (`cmp`/`cmn` against
// a small literal instead of materializing it into a register) and the
// branch-condition test (CBZ/CBNZ on an unfused boolean instead of
// `cmp Xn, xzr` + B.cond). Split out
// of compiler/arm64selcheck.bit, which was 690 lines against the 800-line
// limit and could not hold them — the same split compiler/arm64selcheckgen.bit
// already made (#3141). Same module as selfcheck.bit (#1503), so `selfcheck()`
// reaches these through arm64selcheck.bit's own entry.
//
// Named to sort after compiler/arm64selcheck.bit — module files concatenate in
// bytewise filename order (compiler/project.bit:7).

// #4349: a constant compare operand that fits the immediate encoding folds in
// whole -- no materializing `mov`, exactly as #1853's add/sub fold. Slot 2
// carries a real const_int in each case so `constIntOf` reads genuine IR rather
// than a fixture stand-in that could never be const: with the fold reverted, a
// fixture whose slot 2 stayed a BlockParam would pass every check here without
// exercising the fold at all.
fn arm64CmpImmChecks() {
  let cx = selCtx()
  let want = newByteBuf()

  // A small positive constant: `cmp Xn, #5`.
  cx = selCtx()
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = 5
  emitIcmp(cx, Op.ICmpSlt, 0, 1, 2)
  want = newByteBuf()
  cmpImm(want, addSubImm(true, 5, false), 1)
  cset(want, 0, condLt())
  assertSameBytes(cx.code, want)

  // A NEGATIVE constant has no `cmp` immediate form at all: it becomes CMN,
  // which is ADDS and sets NZCV identically to SUBS against the materialized
  // two's complement -- for unsigned relational compares as well as signed.
  cx = selCtx()
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = -5
  emitIcmp(cx, Op.ICmpUlt, 0, 1, 2)
  want = newByteBuf()
  cmpImm(want, addSubImm(false, 5, false), 1)
  cset(want, 0, condCc())
  assertSameBytes(cx.code, want)

  // An exact multiple of 4096 takes the shifted form rather than materializing.
  cx = selCtx()
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = 4096
  emitIcmp(cx, Op.ICmpEq, 0, 1, 2)
  want = newByteBuf()
  cmpImm(want, addSubImm(true, 1, true), 1)
  cset(want, 0, condEq())
  assertSameBytes(cx.code, want)

  // Fits neither form: the operand register is fetched and compared exactly as
  // a non-constant one is.
  cx = selCtx()
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = 5000
  emitIcmp(cx, Op.ICmpEq, 0, 1, 2)
  want = newByteBuf()
  cmpRR(want, 1, 2)
  cset(want, 0, condEq())
  assertSameBytes(cx.code, want)

  // i64 MIN has no positive magnitude to negate into a CMN, so it never folds.
  cx = selCtx()
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = minI64()
  emitIcmp(cx, Op.ICmpEq, 0, 1, 2)
  want = newByteBuf()
  cmpRR(want, 1, 2)
  cset(want, 0, condEq())
  assertSameBytes(cx.code, want)

  // Fused AND folded: the immediate `cmp` is the entire lowering.
  cx = selCtx()
  cx.fuseCmp[0] = true
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = 5
  emitIcmp(cx, Op.ICmpSlt, 0, 1, 2)
  want = newByteBuf()
  cmpImm(want, addSubImm(true, 5, false), 1)
  assertSameBytes(cx.code, want)
}

// #4349: an UNFUSED `br` condition is tested by CBZ/CBNZ reading the boolean
// register, never by `cmp Xn, xzr` plus a B.cond reading it back out of NZCV.
// A fused one still branches on flags, and that path must emit nothing at all
// before its branch -- the compare it reads is already behind it.
fn arm64BrTestChecks() {
  // Unfused: vreg 0 lives in x0, and the ELSE edge is taken when the bool is 0.
  let cx = selCtx()
  let t = emitBrCondition(cx, 1, 0)
  assert(t.reg == 0, "BRTEST-1")
  assert(len(cx.code.bytes) == 0, "BRTEST-2")
  emitBrTestJump(cx, t, false, 0)
  let want = newByteBuf()
  cbz(want, 0, 0)
  assertSameBytes(cx.code, want)

  // ... and the THEN edge on the complement, which is CBNZ and not a condition
  // code at all.
  cx = selCtx()
  t = emitBrCondition(cx, 1, 0)
  emitBrTestJump(cx, t, true, 0)
  want = newByteBuf()
  cbnzX(want, 0, 0)
  assertSameBytes(cx.code, want)

  // The both-edges-inline shape's forward skip is the same CBZ, resolved by the
  // imm19 patch `patchLocalCondBranch` already applies to a B.cond.
  cx = selCtx()
  t = emitBrCondition(cx, 1, 0)
  assert(emitBrTestLocalBranch(cx, t) == 0, "BRTEST-3")
  want = newByteBuf()
  cbz(want, 0, 0)
  assertSameBytes(cx.code, want)

  // Fused: nothing emitted, and the branch is a B.cond on the else condition.
  cx = selCtx()
  cx.f.instrs[0] = mkInstr(Op.ICmpSlt, 0)
  cx.fuseCmp[0] = true
  t = emitBrCondition(cx, 1, 0)
  assert(t.reg == -1, "BRTEST-4")
  assert(t.cond == condGe(), "BRTEST-5")
  assert(len(cx.code.bytes) == 0, "BRTEST-6")
  emitBrTestJump(cx, t, false, 0)
  want = newByteBuf()
  emitWord(want, 0x54000000 | condGe())
  assertSameBytes(cx.code, want)
}

// #4384: which fused compares qualify at all. Only EQ and NE against a literal
// ZERO do — every other predicate needs the flags a subtraction sets, and a
// non-zero literal is a different question however well it fits the immediate
// encoding. Split from the emission checks below to stay under E0201.
fn arm64CbzOperandChecks() {
  let cx = selCtx()
  cx.f.instrs[3] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[3].ival = 0
  cx.f.instrs[0] = mkInstr(Op.ICmpEq, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  assert(cbzFusedOperand(cx.f, 0) == 1, "CBZ0-1")
  cx.f.instrs[0] = mkInstr(Op.ICmpNe, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  assert(cbzFusedOperand(cx.f, 0) == 1, "CBZ0-2")
  // A relational predicate needs the flags a subtraction sets; CBZ has none.
  cx.f.instrs[0] = mkInstr(Op.ICmpSlt, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  assert(cbzFusedOperand(cx.f, 0) == -1, "CBZ0-3")
  // A NON-zero literal keeps `cmp`, even though the immediate encoding takes
  // it: `icmpConstImm` fitting is not the same property as being zero.
  cx.f.instrs[3].ival = 1
  cx.f.instrs[0] = mkInstr(Op.ICmpEq, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  assert(cbzFusedOperand(cx.f, 0) == -1, "CBZ0-4")
  // A non-constant rhs keeps `cmp` too.
  cx.f.instrs[0].rhs = 2
  assert(cbzFusedOperand(cx.f, 0) == -1, "CBZ0-5")
}

// #4522: a `const_bool` IS an integer constant to the selector -- 0 or 1 --
// so both folds a `const_int` already took apply to `!x`, which lowers to
// `x == const_bool false` (compiler/lowercond.bit:71, SPEC 12.4). Pinned by
// exact encoding on BOTH sides, because the two properties come apart here
// exactly as they do for a `const_int`: `false` is zero and reaches CBZ,
// `true` fits the immediate encoding just as well and must NOT.
fn arm64BoolConstImmChecks() {
  // The value a fold reads is the value the materializer would have written.
  // These are the same call (`constIntValue`), which is the point: two copies
  // of `true == 1` that drifted apart would be a silent miscompile.
  let fb = mkInstr(Op.ConstBool, 0)
  fb.bval = false
  let tb = mkInstr(Op.ConstBool, 0)
  tb.bval = true
  assert(constIntValue(fb) == 0 && constIntValue(tb) == 1, "BOOLIMM-1")

  // `x == false` folds whole into `cmp Xn, #0` -- no `mov` for the literal.
  let cx = selCtx()
  cx.f.instrs[2] = fb
  emitIcmp(cx, Op.ICmpEq, 0, 1, 2)
  let want = newByteBuf()
  cmpImm(want, addSubImm(true, 0, false), 1)
  cset(want, 0, condEq())
  assertSameBytes(cx.code, want)

  // `x == true` folds too, into `cmp Xn, #1`.
  cx = selCtx()
  cx.f.instrs[2] = tb
  emitIcmp(cx, Op.ICmpEq, 0, 1, 2)
  want = newByteBuf()
  cmpImm(want, addSubImm(true, 1, false), 1)
  cset(want, 0, condEq())
  assertSameBytes(cx.code, want)

  // Only `false` is ZERO, so only `false` qualifies for CBZ.
  cx = selCtx()
  cx.f.instrs[3] = fb
  cx.f.instrs[0] = mkInstr(Op.ICmpEq, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  assert(cbzFusedOperand(cx.f, 0) == 1, "BOOLIMM-2")
  cx.f.instrs[3] = tb
  assert(cbzFusedOperand(cx.f, 0) == -1, "BOOLIMM-3")
}

// #4522: the `!x` shape end to end -- a FUSED `x == const_bool false` emits
// nothing at all, and its branch tests the compare's own operand with the
// same CBZ/CBNZ pair `x == const_int 0` already got. The polarity is asked in
// both edge directions for the reason arm64CbzZeroChecks gives: an inverted
// one takes the other arm of every `if (!f())` in the program and never
// crashes.
fn arm64BoolCbzChecks() {
  let cx = boolCbzCtx()
  emitIcmp(cx, Op.ICmpEq, 0, 1, 3)
  assert(len(cx.code.bytes) == 0, "BOOLCBZ-1")
  let t = emitBrCondition(cx, 1, 0)
  assert(t.reg == 1 && len(cx.code.bytes) == 0, "BOOLCBZ-2")
  emitBrTestJump(cx, t, true, 0)
  let want = newByteBuf()
  cbz(want, 1, 0)
  assertSameBytes(cx.code, want)

  cx = boolCbzCtx()
  t = emitBrCondition(cx, 1, 0)
  emitBrTestJump(cx, t, false, 0)
  want = newByteBuf()
  cbnzX(want, 1, 0)
  assertSameBytes(cx.code, want)
}

// `cbzCtx`'s shape with the literal spelled as a `const_bool false` rather
// than a `const_int 0` -- what `!x` actually lowers to.
fn boolCbzCtx(): A64Ctx {
  let cx = selCtx()
  let fb = mkInstr(Op.ConstBool, 0)
  fb.bval = false
  cx.f.instrs[3] = fb
  cx.f.instrs[0] = mkInstr(Op.ICmpEq, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  cx.fuseCmp[0] = true
  return cx
}

// #4384: the emitted shape. The compare emits nothing at all and hands its own
// operand register to the branch, which tests it with CBZ (`== 0`) or CBNZ
// (`!= 0`). The polarity is the whole risk — an inverted one is a silent
// wrong-branch miscompile, not a crash — so all four predicate/edge
// combinations are pinned here by their exact encoding.
fn arm64CbzZeroChecks() {
  // `x == 0`: the compare emits nothing at all, and the THEN edge is taken
  // when the register is ZERO.
  let cx = cbzCtx(Op.ICmpEq)
  emitIcmp(cx, Op.ICmpEq, 0, 1, 3)
  assert(len(cx.code.bytes) == 0, "CBZ0-6")
  let t = emitBrCondition(cx, 1, 0)
  assert(t.reg == 1 && len(cx.code.bytes) == 0, "CBZ0-7")
  emitBrTestJump(cx, t, true, 0)
  let want = newByteBuf()
  cbz(want, 1, 0)
  assertSameBytes(cx.code, want)

  // ... and its ELSE edge on the complement, CBNZ.
  cx = cbzCtx(Op.ICmpEq)
  t = emitBrCondition(cx, 1, 0)
  emitBrTestJump(cx, t, false, 0)
  want = newByteBuf()
  cbnzX(want, 1, 0)
  assertSameBytes(cx.code, want)

  // `x != 0` is the mirror: THEN on CBNZ, ELSE on CBZ.
  cx = cbzCtx(Op.ICmpNe)
  emitIcmp(cx, Op.ICmpNe, 0, 1, 3)
  assert(len(cx.code.bytes) == 0, "CBZ0-8")
  t = emitBrCondition(cx, 1, 0)
  emitBrTestJump(cx, t, true, 0)
  want = newByteBuf()
  cbnzX(want, 1, 0)
  assertSameBytes(cx.code, want)

  cx = cbzCtx(Op.ICmpNe)
  t = emitBrCondition(cx, 1, 0)
  emitBrTestJump(cx, t, false, 0)
  want = newByteBuf()
  cbz(want, 1, 0)
  assertSameBytes(cx.code, want)

  // The both-edges-inline shape skips the THEN code on the ELSE condition, so
  // its local branch is CBNZ for `== 0` where a plain boolean gets CBZ.
  cx = cbzCtx(Op.ICmpEq)
  t = emitBrCondition(cx, 1, 0)
  assert(emitBrTestLocalBranch(cx, t) == 0, "CBZ0-9")
  want = newByteBuf()
  cbnzX(want, 1, 0)
  assertSameBytes(cx.code, want)

  // The register tested is the COMPARE's operand, not the compare's own slot:
  // vreg 4 lives in x4, so reading the wrong value shows up as the wrong Rt.
  cx = cbzCtx(Op.ICmpEq)
  cx.f.instrs[0].lhs = 4
  t = emitBrCondition(cx, 1, 0)
  assert(t.reg == 4, "CBZ0-10")
}

// A `selCtx` whose slot 0 is a FUSED `slot1 <op> 0` compare and slot 3 the
// literal zero it tests against — the shape `computeFuseCmpBranch` marks when
// a `br` at slot 1 consumes it.
fn cbzCtx(op: Op): A64Ctx {
  let cx = selCtx()
  cx.f.instrs[3] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[3].ival = 0
  cx.f.instrs[0] = mkInstr(op, 0)
  cx.f.instrs[0].lhs = 1
  cx.f.instrs[0].rhs = 3
  cx.fuseCmp[0] = true
  return cx
}
