// compiler/validateappend.bit — `append`'s call rule, split out of
// validatecall.bit. That file was at 790 of the 800-line ceiling (E0200), and
// #4371 gives `append` a SECOND admissible operand shape, which is a rule the
// file could not absorb. Sibling of `lowerappend.bit`: the validation and the
// lowering of the same builtin now sit beside each other rather than one of
// them being buried in a file about calls in general.
//
// Same module, so this needs no imports and no call-site changes —
// `reportNoHint`, `report`, `vSpan`, `checkExprType`, `vMentionsInvalid`,
// `vHasTypeParam`, `defaultType` and `typeName` are all still defined
// elsewhere in this module and called from here exactly as they were before
// the move. `vCall` (validatecall.bit) still dispatches to `vAppendCall`.

// `append(x, ...)` (§12.6, E0054): the first argument must be a slice, exactly
// as an index receiver must be — mirrors the seed's checkBuiltinCall append
// arm, which rejects a fixed array (or anything else non-slice) via
// notIndexable. Ponytail: only the receiver-kind check is ported, not the
// element-type assignability of the remaining arguments (§12.6's other half),
// since that is not the divergence #1623 found. Permissive on an inference
// gap or unresolved type param, matching every other builtin-call rule here.
//
// ONE EXCEPTION TO THAT PONYTAIL, AND IT IS THE POINT OF #4371: a `string`
// trailing argument IS judged, because `append` now has two admissible operand
// shapes and a `string` is the only operand that can mean either of them. See
// `vAppendStrOperands` below.
fn vAppendCall(c: Checker, node: int) {
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  // A zero-arg `append()` has no slice to read, and `lowerAppend`
  // (lowerappend.bit) reads `args[0]` unconditionally — so an unreported empty
  // call reached lowering and panicked with "index out of range" and no
  // diagnostic (#3758). Reported here, the same shape `vAtomicCall`
  // (validateunmanaged.bit) uses for its own zero-arg case, rather than as a
  // silent `return`.
  if (len(args) == 0) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "'append' requires at least 1 argument, found 0")
    return
  }
  let a = args[0]
  if (getNode(c.tree, a).tag == Tag.Arg) { a = kidsOf(c.tree, a)[0] }
  let st = checkExprType(c, a)
  if (st == 0 || vMentionsInvalid(c, st, 0) || vHasTypeParam(c, st, 0)) { return }
  if (c.ctx.types[st].kind != TypeKind.Slice) {
    reportNoHint(c.diags, ecNotIndexable, vSpan(c, a), "'${typeName(c.ctx, st)}' cannot be indexed")
    return
  }
  vAppendStrOperands(c, args, st)
}

// E0130: first free code above E0129 (validateloop.bit's
// `ecForInMapPairBinder`).
const ecAppendStrDest = 130

// `append(dst, s)` where `s` is a `string` (#4371, SPEC §12.6). Two shapes are
// admissible and a `string` operand is the only one that can be read as
// either:
//
//   - `dst` is `[]u8`     -> the BYTES shape: `s`'s bytes are appended in one
//                            `rt_call slice_append_str` (lowerappend.bit).
//   - `dst` is `[]string` -> the ELEMENT shape: `s` is one element, exactly as
//                            it always was.
//   - anything else       -> reported here.
//
// WITHOUT THIS THE THIRD ROW IS A SILENT WRONG ANSWER, and it already was one
// before this ticket: on `9e642e10`, `append([]i64, "hi")` checked rc=0, built
// rc=0 and appended a single garbage word — the string's own header address
// truncated to the element. Adding the bytes shape without adding this rule
// would have left that miscompile in place while making the surface around it
// ambiguous, so the diagnostic is not an extra: it is the half of the feature
// that says which shape a call chose and why it could not have the other.
//
// The message NAMES BOTH SHAPES rather than saying "type mismatch": with two
// admissible spellings, "found `[]i64`" alone does not tell the reader which
// one they were reaching for.
//
// Deliberately narrower than full element assignability (§12.6's other half,
// still unported): every other trailing operand type is judged exactly as
// permissively as it was before, so this cannot become a false positive on any
// shape the corpus already compiles. Skips an operand that did not infer,
// mentions `invalid`, or still carries an open type param — THE SAFETY RULE
// (validate.bit), the same guard the receiver check above uses.
fn vAppendStrOperands(c: Checker, args: []int, st: int) {
  let et = c.ctx.types[st].elem
  let ed = c.ctx.types[et]
  if (ed.kind == TypeKind.Prim && (ed.prim == 4 || ed.prim == 11)) { return }
  let i = 1
  while (i < len(args)) {
    let a = args[i]
    if (getNode(c.tree, a).tag == Tag.Arg) { a = kidsOf(c.tree, a)[0] }
    vAppendStrOperand(c, a, st, et)
    i = i + 1
  }
}

// One trailing operand of an `append` whose element is neither `u8` nor
// `string`. Split out of the loop above so each stays inside E0204's
// max-complexity 10 (spec/LINT.md).
fn vAppendStrOperand(c: Checker, a: int, st: int, et: int) {
  let raw = checkExprType(c, a)
  if (raw == 0 || vMentionsInvalid(c, raw, 0) || vHasTypeParam(c, raw, 0)) { return }
  // `defaultType` first: a bare `"hi"` is an UNTYPED string (§15.4), so the
  // raw id is `untypedString`, not the `string` prim — comparing `raw`
  // directly would miss the one spelling users write most, the same defaulting
  // `vLenCapCall` (validatecall.bit) records getting wrong on `len("bit")`.
  let t = defaultType(c, raw)
  let td = c.ctx.types[t]
  if (td.kind != TypeKind.Prim || td.prim != 11) { return }
  report(
    c.diags, ecAppendStrDest, vSpan(c, a),
    "'append' takes a 'string' operand only for a '[]u8' destination (its bytes) or a '[]string' one (one element); this destination is '${typeName(c.ctx, st)}'",
    "append a '${typeName(c.ctx, et)}' element, or convert the destination to '[]u8'",
  )
}
