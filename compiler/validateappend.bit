// compiler/validateappend.bit — `append`'s call rule, split out of
// validatecall.bit. That file was at 790 of the 800-line ceiling (E0200), and
// #4371 gives `append` a SECOND admissible operand shape, which is a rule the
// file could not absorb. Sibling of `lowerappend.bit`: the validation and the
// lowering of the same builtin now sit beside each other rather than one of
// them being buried in a file about calls in general.
//
// Same module, so this needs no imports and no call-site changes —
// `reportNoHint`, `report`, `vSpan`, `checkExprType`, `vMentionsInvalid`,
// `vHasTypeParam`, `stringish`, `vAssignableNode`, `vExpect` and `typeName`
// are all defined elsewhere in this module and called from here exactly as
// any other validator in it would. `vCall` (validatecall.bit) still
// dispatches to `vAppendCall`.

// `append(x, ...)` (§12.6, E0054): the first argument must be a slice, exactly
// as an index receiver must be — mirrors the seed's checkBuiltinCall append
// arm, which rejects a fixed array (or anything else non-slice) via
// notIndexable. Permissive on an inference gap or unresolved type param,
// matching every other builtin-call rule here.
//
// The remaining arguments are checked for element-type assignability by
// `vAppendOperands` below (§12.6's other half, ported by #6229: an
// `append(dst, src)` where `src` is itself a slice of `dst`'s own element
// type — e.g. `append([]u8, []u8)` — type-checked and appended `src`'s
// header, truncated to one element, as a silent wrong answer).
fn vAppendCall(c: Checker, node: int) {
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  // A zero-arg `append()` has no slice to read, and `lowerAppend`
  // (lowerappend.bit) reads `args[0]` unconditionally — so an unreported empty
  // call reached lowering and panicked with "index out of range" and no
  // diagnostic (#3758). Reported here, the same shape `vAtomicCall`
  // (validateunmanaged.bit) uses for its own zero-arg case, rather than as a
  // silent `return`.
  if (len(args) == 0) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "'append' requires at least 1 argument, found 0",
    )
    return
  }
  let a = args[0]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  let st = checkExprType(c, a)
  if (st == 0 || vMentionsInvalid(c, st, 0) || vHasTypeParam(c, st, 0)) {
    return
  }
  if (c.ctx.types[st].kind != TypeKind.Slice) {
    reportNoHint(c.diags, ecNotIndexable, vSpan(c, a), "'${typeName(c.ctx, st)}' cannot be indexed")
    return
  }
  vAppendOperands(c, args, st)
}

// E0130: first free code above E0129 (validateloop.bit's
// `ecForInMapPairBinder`).
const ecAppendStrDest = 130

// Each trailing argument of `append(dst, x...)` (§12.6). Two operand shapes
// are admissible:
//
//   - the ELEMENT shape: `x` is assignable to `dst`'s element type, judged by
//     `vExpect` — the same E0041 ordinary assignment, a return, or any other
//     call argument uses, so `append([]u8, []u8)` reports "expected 'u8',
//     found '[]u8'" exactly as passing a `[]u8` where a `u8` is wanted
//     anywhere else would (#6229).
//   - the BYTES shape: `dst` is `[]u8` and `x` is a `string` — `x`'s bytes are
//     appended in one `rt_call slice_append_str` (lowerappend.bit), never
//     reaching `vExpect`, which would reject a `string` for a `u8` element.
//
// A `string` operand reaching neither shape (dst is not `[]u8`, and not
// `[]string` where it would fit as an element) keeps its own E0130 message
// (#4371): it is the one operand that can mean either shape, so "expected
// 'T', found 'string'" alone would not say WHICH shape the call was reaching
// for.
fn vAppendOperands(c: Checker, args: []int, st: int) {
  let et = c.ctx.types[st].elem
  let i = 1
  while (i < len(args)) {
    let a = args[i]
    if (getNode(c.tree, a).tag == Tag.Arg) {
      a = kidsOf(c.tree, a)[0]
    }
    vAppendOperand(c, a, st, et)
    i = i + 1
  }
}

// One trailing operand of an `append`. Split out of the loop above so each
// stays inside E0204's max-complexity 10 (spec/LINT.md). Skips an operand
// that did not infer, mentions `invalid`, or still carries an open type
// param — THE SAFETY RULE (validate.bit), the same guard the receiver check
// above uses.
fn vAppendOperand(c: Checker, a: int, st: int, et: int) {
  let raw = checkExprType(c, a)
  if (raw == 0 || vMentionsInvalid(c, raw, 0) || vHasTypeParam(c, raw, 0)) {
    return
  }
  let elemIsU8 = c.ctx.types[et].kind == TypeKind.Prim && c.ctx.types[et].prim == 4
  if (elemIsU8 && stringish(c, raw)) {
    return // the bytes shape
  }
  if (stringish(c, raw) && !vAssignableNode(c, a, raw, et)) {
    report(
      c.diags, ecAppendStrDest, vSpan(c, a),
      "'append' takes a 'string' operand only for a '[]u8' destination (its bytes) or a '[]string' one (one element); this destination is '${typeName(
        c.ctx,
        st,
      )}'",
      "append a '${typeName(c.ctx, et)}' element, or convert the destination to '[]u8'",
    )
    return
  }
  vExpect(c, a, raw, et)
}
