// Version constraint parsing and matching for `bit.json` dependency
// requirements (#2364, epic #2362). Semantics are spec/SPEC.md §17.7 as
// rewritten by #2363: three forms only — `^X.Y.Z`, `~X.Y.Z`, bare `X.Y.Z` —
// and npm's 0.x caret rules, because every Bit package starts at 0.x:
//
//   ^1.2.3  ->  >=1.2.3 <2.0.0
//   ^0.1.2  ->  >=0.1.2 <0.2.0
//   ^0.0.3  ->  >=0.0.3 <0.0.4
//   ~1.2.3  ->  >=1.2.3 <1.3.0
//   ~0.1.2  ->  >=0.1.2 <0.2.0
//   1.2.3   ->  ==1.2.3
//
// Scope: pure string parsing and comparison, no network/filesystem/git — the
// solver (#2366) and `bit add` (#2367) both consume this as data. Ordering
// reuses `compiler/pmresolve.bit`'s `Version`/`versionLess`/`versionEq` (same
// module, this directory); this file defines no second `Version` and no
// second ordering — two orderings that can disagree is a real defect class,
// not a style preference (see #2743's writeup of the same failure mode for
// duplicated shell scripts).
//
// Named to sort before `pmresolve.bit`/`pmcli.bit`: sibling `.bit` files in a
// directory are one module, and file order affects inlining
// (docs/development.md).

// `MAJOR.MINOR.PATCH`, never `vMAJOR.MINOR.PATCH` — `canonicalVersion`,
// below, is the only place in this module a leading `v` is recognized.
// Rejects an empty component (`"1..3"`), a non-digit component (`"1.2.a"`),
// a missing component (`"1.2"`), and a fourth component (`"1.2.3.4"`). There
// is no separate check for a leading `v`: `'v'` is not a digit, so the major
// component's scan already rejects it, same as any other non-digit start.
function parseVersion(s: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  let (major, i1, ok1) = scanUintComponent(s, 0)
  if (!ok1 || i1 >= len(s) || s[i1] != '.') {
    return zero, false
  }
  let (minor, i2, ok2) = scanUintComponent(s, i1 + 1)
  if (!ok2 || i2 >= len(s) || s[i2] != '.') {
    return zero, false
  }
  let (patch, i3, ok3) = scanUintComponent(s, i2 + 1)
  if (!ok3 || i3 != len(s)) {
    return zero, false
  }
  return Version{ major: major, minor: minor, patch: patch }, true
}

// The decimal integer starting at `s[start]`, the index just past its last
// digit, and whether at least one digit was read. Deliberately private to
// this module rather than sharing `pmcli.bit`'s identical-shaped
// `pmScanUint` (used for `parseVersionTag`'s `v`-prefixed tags): pmcli.bit is
// exactly the file #2367 is about to rewrite, and this module has no reason
// to depend on it.
function scanUintComponent(s: string, start: int): (int, int, bool) {
  let i = start
  let n = 0
  let any = false
  while (i < len(s) && s[i] >= '0' && s[i] <= '9') {
    n = n * 10 + (int(s[i]) - int('0'))
    i = i + 1
    any = true
  }
  return n, i, any
}

// Accepts `1.2.3` or `v1.2.3` and returns the bare form — for canonicalising
// CLI input and git tag names, both of which exist in the wild with and
// without the prefix. The only place in this module a `v` is stripped;
// `parseVersion` itself never accepts one. Rejects `"vv1.2.3"` (the `v` is
// stripped once, and `parseVersion("v1.2.3")` then rejects the remainder)
// and `"1.2"` (not a complete version either way).
function canonicalVersion(s: string): (string, bool) {
  if (len(s) > 0 && s[0] == 'v') {
    let bare = s[1:len(s)]
    let (_, ok) = parseVersion(bare)
    if (!ok) {
      return "", false
    }
    return bare, true
  }
  let (_, ok) = parseVersion(s)
  if (!ok) {
    return "", false
  }
  return s, true
}

// `^` (caret), `~` (tilde), or an exact pin — the only three forms spec
// §17.7 defines. No other operator exists.
enum ConstraintOp {
  Caret,
  Tilde,
  Exact,
}

struct Constraint {
  op: ConstraintOp,
  version: Version,
}

// `^X.Y.Z`, `~X.Y.Z`, or bare `X.Y.Z`. Every other spelling — `>=1.0.0`,
// `*`, `1.0.0 || 2.0.0`, `1.0 - 2.0`, `^v1.2.3` — fails `parseVersion` on
// whatever follows the recognized operator prefix (or on the whole string,
// for a bare form) and is rejected here as a named failure. There is no
// operator allowlist to fall through past: an unrecognized leading byte
// either matches `^`/`~` and then fails version parsing, or falls to the
// bare-exact path and fails there, in both cases returning `(_, false)`
// rather than silently matching exactly.
//
// Named `parseVersionConstraint`, not the ticket's literal `parseConstraint`
// — `compiler/parsertype.bit:192` already declares a top-level
// `parseConstraint(p: Parser): int` for a generic type bound (`T: Bound`),
// unrelated to semver. Sibling `.bit` files in this directory are one module
// with one flat, name-keyed top-level scope (`resolve.bit`'s
// `duplicate_declaration`/E0042 has no signature-based overload resolution —
// confirmed by reading `rDeclareBinding`'s scope-map insertion), so the two
// would collide. This is a mechanical rename to avoid a real compile error,
// not a semantic reinterpretation of the ticket.
function parseVersionConstraint(s: string): (Constraint, bool) {
  let zero = Constraint{ op: ConstraintOp.Exact, version: Version{ major: 0, minor: 0, patch: 0 } }
  if (len(s) == 0) {
    return zero, false
  }
  if (s[0] == '^') {
    let (v, ok) = parseVersion(s[1:len(s)])
    if (!ok) {
      return zero, false
    }
    return Constraint{ op: ConstraintOp.Caret, version: v }, true
  }
  if (s[0] == '~') {
    let (v, ok) = parseVersion(s[1:len(s)])
    if (!ok) {
      return zero, false
    }
    return Constraint{ op: ConstraintOp.Tilde, version: v }, true
  }
  let (v, ok) = parseVersion(s)
  if (!ok) {
    return zero, false
  }
  return Constraint{ op: ConstraintOp.Exact, version: v }, true
}

// The exclusive upper bound of a `^`/`~` constraint's half-open range.
// Never called for `Exact`, which has no upper bound — `constraintMatches`
// handles that case by equality before reaching here.
//
// Caret is major-aware: bump the major if it is nonzero, else the minor if
// that is nonzero, else the patch (`^0.0.3` -> `<0.0.4`, effectively exact).
// Tilde has no such special case — it always bumps the minor, which is why
// `~0.1.2` and `^0.1.2` land on the identical `<0.2.0` bound (both bump
// minor, since caret's major IS zero here) while `~1.2.3` bumps minor
// (`<1.3.0`) where caret at the same version would bump major (`<2.0.0`).
function constraintUpperBound(c: Constraint): Version {
  let base = c.version
  if (c.op == ConstraintOp.Caret) {
    if (base.major != 0) {
      return Version{ major: base.major + 1, minor: 0, patch: 0 }
    }
    if (base.minor != 0) {
      return Version{ major: 0, minor: base.minor + 1, patch: 0 }
    }
    return Version{ major: 0, minor: 0, patch: base.patch + 1 }
  }
  return Version{ major: base.major, minor: base.minor + 1, patch: 0 }
}

// Whether `v` satisfies `c`, per the semantics table above. Every comparison
// goes through `versionLess`/`versionEq` (pmresolve.bit) — this module
// defines no ordering of its own.
function constraintMatches(c: Constraint, v: Version): bool {
  if (c.op == ConstraintOp.Exact) {
    return versionEq(c.version, v)
  }
  if (versionLess(v, c.version)) {
    return false
  }
  return versionLess(v, constraintUpperBound(c))
}
