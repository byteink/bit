// Self-host Stage 3 (#1342): the AArch64 backend, signed-overflow trap.
// Split out of compiler/arm64select.bit at 800 lines against the 800-line
// limit (#3081) — same module, so nothing here is imported. Mirrors
// compiler/x64selectovf.bit's split of the x86-64 twin (#3082).
//
// Named to sort after compiler/arm64select.bit — module files concatenate in
// bytewise filename order (compiler/project.bit:7).

// Debug-mode-only (SPEC §13.5, #3076/#3080): `d` was just computed by a
// signed Add/Sub. Mirrors the div-by-zero shape at `emitDivInt` above: a
// B.cond skips a call to `bit_rt_panic_overflow`. At i64, `d` came from
// ADDS/SUBS so V reflects a true 64-bit overflow. Narrower widths use plain ADD/SUB
// (sign-extended to 64 bits, so V never fires narrow): re-narrow a SCRATCH COPY of `d`.
fn emitOverflowTrap(cx: A64Ctx, d: int, w: Width) {
  let ok = -1
  if (w.bytes == 8) {
    ok = emitLocalCondBranch(cx, condVc())
  } else {
    extendRegA(cx.code, scratch2(), d, w.bytes, w.signed)
    cmpRR(cx.code, scratch2(), d)
    ok = emitLocalCondBranch(cx, condEq())
  }
  emitCallReloc(cx, "bit_rt_panic_overflow")
  patchLocalCondBranch(cx, ok)
}

// The two source registers for a binary op -- grouped so the E0202 ceiling holds.
class RRPair { l: int, r: int }

// `dst = lhs + rhs`/`lhs - rhs` plus the debug overflow check (factored out
// of emitBinaryInt, already over budget pre-ticket, #2447-#2453).
fn emitAddSubRR(cx: A64Ctx, op: Op, d: int, rr: RRPair, w: Width) {
  // Unsigned wraps by spec (§13.5) and is never checked -- signed only.
  let trapOverflow = cx.debug && w.signed
  let useFlags = trapOverflow && w.bytes == 8
  if (op == Op.Add) {
    if (useFlags) {
      addsRR(cx.code, d, rr.l, rr.r)
    } else {
      addRR(cx.code, d, rr.l, rr.r)
    }
  } else {
    if (useFlags) {
      subsRR(cx.code, d, rr.l, rr.r)
    } else {
      subRR(cx.code, d, rr.l, rr.r)
    }
  }
  if (trapOverflow) {
    emitOverflowTrap(cx, d, w)
  }
}
