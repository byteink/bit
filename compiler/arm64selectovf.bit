// Self-host Stage 3 (#1342): the AArch64 backend, signed-overflow trap.
// Split out of compiler/arm64select.bit at 800 lines against the 800-line
// limit (#3081) — same module, so nothing here is imported. Mirrors
// compiler/x64selectovf.bit's split of the x86-64 twin (#3082).
//
// Named to sort after compiler/arm64select.bit — module files concatenate in
// bytewise filename order (compiler/project.bit:7).

// Debug-mode-only (SPEC §13.5, #3076/#3080): `d` was just computed by a
// signed Add/Sub. Mirrors the div-by-zero shape at `emitDivInt` above: a
// B.cond skips a call to `bit_rt_panic_overflow`. At i64, `d` came from
// ADDS/SUBS so V reflects a true 64-bit overflow. Narrower widths use plain ADD/SUB
// (sign-extended to 64 bits, so V never fires narrow): re-narrow a SCRATCH COPY of `d`.
fn emitOverflowTrap(cx: A64Ctx, d: int, w: Width) {
  let ok = -1
  if (w.bytes == 8) {
    ok = emitLocalCondBranch(cx, condVc())
  } else {
    extendRegA(cx.code, scratch2(), d, w.bytes, w.signed)
    cmpRR(cx.code, scratch2(), d)
    ok = emitLocalCondBranch(cx, condEq())
  }
  emitCallReloc(cx, "bit_rt_panic_overflow")
  patchLocalCondBranch(cx, ok)
}

// The two source registers for a binary op -- grouped so the E0202 ceiling holds.
class RRPair { l: int, r: int }

// `dst = lhs + rhs`/`lhs - rhs` plus the debug overflow check (factored out
// of emitBinaryInt, already over budget pre-ticket, #2447-#2453).
fn emitAddSubRR(cx: A64Ctx, op: Op, d: int, rr: RRPair, w: Width) {
  // Unsigned wraps by spec (§13.5) and is never checked -- signed only.
  let trapOverflow = cx.debug && w.signed
  let useFlags = trapOverflow && w.bytes == 8
  if (op == Op.Add) {
    if (useFlags) {
      addsRR(cx.code, d, rr.l, rr.r)
    } else {
      addRR(cx.code, d, rr.l, rr.r)
    }
  } else {
    if (useFlags) {
      subsRR(cx.code, d, rr.l, rr.r)
    } else {
      subRR(cx.code, d, rr.l, rr.r)
    }
  }
  if (trapOverflow) {
    emitOverflowTrap(cx, d, w)
  }
}

// ---------------------------------------------------------------------------
// Signed multiply overflow trap (#3084, SPEC §13.5, debug builds only)
// ---------------------------------------------------------------------------
//
// AArch64's MUL/MADD never sets flags (unlike ADD/SUB's ADDS/SUBS above), so
// there is no V flag a true 64-bit overflow could set. At width 8 this
// computes the full 128-bit signed product: `low` is the existing 64-bit MUL
// result and `high` is SMULH's (signed multiply high) top 64 bits. The exact
// product fits in 64 bits iff `high` is nothing but the sign-extension of
// `low`'s top bit -- all zero for a non-negative non-overflowing result, all
// one for a negative one; any other `high` means the mathematical product
// needed more than 64 bits. At width < 8 both operands are themselves
// sign-extended values of that narrower type (magnitude bound < 2^(bits-1)),
// so their exact product can never reach 2^63 -- true 64-bit overflow is
// impossible, and only whether the product fits width `w`'s own narrower
// range remains, exactly what `emitOverflowTrap`'s re-narrow-and-compare arm
// already checks, reused unchanged.
fn emitMulOverflowTrap64(cx: A64Ctx, low: int, high: int) {
  asrImm(cx.code, scratch2(), low, 63)
  cmpRR(cx.code, high, scratch2())
  let ok = emitLocalCondBranch(cx, condEq())
  emitCallReloc(cx, "bit_rt_panic_overflow")
  patchLocalCondBranch(cx, ok)
}

// `dst = lhs * rhs`, the general (non-power-of-two) path, plus the width-8
// debug overflow check. `l`/`r` must survive past the low-bits multiply so
// SMULH can still read them: a spilled `dst` makes `d` alias `scratch1()`,
// which may be `l`'s own register (the same hazard `emitDivInt`'s SRem arm
// documents for `msub`). So SMULH runs FIRST, into scratch3 (never
// allocatable, never `d`), while `l`/`r` still hold whatever `getInt`
// returned -- the low-bits MUL that follows is a single instruction and reads
// its sources before writing `d`, so it is correct even where `d` aliases
// `l` or `r`.
fn emitMulRR(cx: A64Ctx, dst: int, lhs: int, rhs: int, w: Width) {
  let l = getInt(cx, vregOf(cx, lhs), scratch1())
  let r = getInt(cx, vregOf(cx, rhs), scratch2())
  let trap64 = cx.debug && w.signed && w.bytes == 8
  if (trap64) {
    smulhRR(cx.code, scratch3(), l, r)
  }
  let d = destInt(cx, dst, scratch1())
  mulRR(cx.code, d, l, r)
  if (trap64) {
    emitMulOverflowTrap64(cx, d, scratch3())
  } else if (cx.debug && w.signed) {
    emitOverflowTrap(cx, d, w)
  }
  canonNarrow(cx.code, d, w)
  putInt(cx, dst, d)
}

// `shifted` is a just-computed `value << k` (emitPow2MulInt); `original` is a
// register holding `value` from BEFORE the shift, preserved by the caller in
// a register the shift never touches (`d` may alias `value`'s own register
// when both round-trip through scratch1/spill). Shifting `shifted` back down
// by the same `k` (arithmetic, to restore the sign the way a genuine signed
// right shift would) and comparing against `original` recovers the "did the
// true product need more than 64 bits" fact with no flag to read -- mirrors
// `compiler/x64selectovf.bit`'s `xEmitPow2MulOverflowTrap64` and works for
// any `k` (checked by hand: i64 MIN << 1 loses the sign bit and the
// shift-back correctly disagrees; 2^61 << 2 == 2^63, one past i64 MAX,
// disagrees too).
fn emitPow2MulOverflowTrap64(cx: A64Ctx, shifted: int, original: int, k: int) {
  asrImm(cx.code, scratch2(), shifted, k)
  cmpRR(cx.code, scratch2(), original)
  let ok = emitLocalCondBranch(cx, condEq())
  emitCallReloc(cx, "bit_rt_panic_overflow")
  patchLocalCondBranch(cx, ok)
}

// `dst = value * 2^k` as a single `lsl` (#3105). No bias, no correction and no
// width special-casing: `x * 2^k` and `x << k` agree on ALL 64 bits for every
// input, so they agree on the low `bits` bits at every width, signed or
// unsigned -- strictly simpler than the SDiv reduction, which needs a bias
// only because truncating division rounds toward zero. `canonNarrow` stays,
// unlike `emitPow2DivInt`'s deliberate omission: a left shift pushes bits
// past a narrow type's width exactly as the product it replaces does.
//
// Debug overflow trapping (#3084): LSL sets no flag a signed overflow check
// could read, so at width 8 `v` is copied to scratch3 BEFORE the shift (`d`
// may alias `v`'s own register) and compared back after via
// `emitPow2MulOverflowTrap64`; narrower widths can never truly overflow 64
// bits (same argument as `emitMulRR`) and reuse `emitOverflowTrap` unchanged.
fn emitPow2MulInt(cx: A64Ctx, dst: int, value: int, k: int, w: Width) {
  let v = getInt(cx, vregOf(cx, value), scratch1())
  let trap64 = cx.debug && w.signed && w.bytes == 8
  let d = destInt(cx, dst, scratch1())
  if (trap64) {
    movRR(cx.code, scratch3(), v)
  }
  lslImm(cx.code, d, v, k)
  if (trap64) {
    emitPow2MulOverflowTrap64(cx, d, scratch3(), k)
  } else if (cx.debug && w.signed) {
    emitOverflowTrap(cx, d, w)
  }
  canonNarrow(cx.code, d, w)
  putInt(cx, dst, d)
}
