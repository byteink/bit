// A class name passed to a `Class<T>` parameter (std/where, SPEC §12.3.1, epic
// #6984): `p.can(Read, Article, { authorId: 1 })`. A class name is not a value
// anywhere else, so the one position that takes one is told apart by its
// EXPECTED type alone, as a condition literal is (checkwhere.bit):
//
//   - the binder (`bindTypeParamAtCall`, checkgeneric.bit) reads the name as the
//     binding of `T` in a parameter written `Class<T>`, so every later parameter
//     (a `Where<T>`) is judged against that class, left to right;
//   - the validator (`vExpectExpr`, validate.bit) accepts the name against the
//     instantiation `Class<Article>`, and refuses it against any other type;
//   - the lowerer (`lowerClassNameArg`) builds the empty `Class<Article>` value.
//
// Same module as the rest of the checker; no imports.

const classMarkerName = "Class"

// The class the identifier at `node` names where a value is expected, or 0 when
// it is anything else: a binding, a function, an enum, a generic template.
fn classNameArg(c: Checker, node: int): int {
  if (node == 0 || getNode(c.tree, node).tag != Tag.Ident || identResolvesToBinding(c, node)) {
    return 0
  }
  let t = typeFromNode(c, node)
  if (t == 0 || c.ctx.types[t].kind != TypeKind.Struct || isGenericClassTemplate(c, t)) {
    return 0
  }
  return t
}

// `T` of a type `Class<T>` (a nominal instance named `Class` with one
// argument), or 0 for any other type.
fn classMarkerTarget(c: Checker, want: int): int {
  let idx = typeInstOfResult(c.ctx, want)
  if (idx < 0) {
    return 0
  }
  let inst = c.ctx.typeInsts[idx]
  if (inst.name != classMarkerName || len(inst.args) != 1) {
    return 0
  }
  return inst.args[0]
}

// What argument node `anode` of the call binds type parameter `tpname` to when
// the declared parameter `pnode` is written `Class<tpname>`: the class the
// argument names, else 0. `pc` owns `pnode`, `ac` owns `anode`.
fn bindClassArg(pc: Checker, pnode: int, ac: Checker, anode: int, tpname: string): int {
  if (getNode(pc.tree, pnode).tag != Tag.GenericInst ||
    typeNodeName(pc, pnode) != classMarkerName) {
    return 0
  }
  let targs = kidsOf(pc.tree, kidsOf(pc.tree, pnode)[1])
  if (len(targs) != 1 || nodeText(pc.tree, pc.source, targs[0]) != tpname) {
    return 0
  }
  return classNameArg(ac, anode)
}

// `node` against the expected type `want`: true when `node` is a class name and
// was judged here. It is accepted against `Class<itself>`; against any other
// type it is E0041, naming the one place a class name is a value. A `want` that
// is still undecided (mentions an unresolved parameter or an invalid type) is
// judged per instantiation, not here.
fn vClassNameArg(c: Checker, node: int, want: int): bool {
  let cls = classNameArg(c, node)
  if (cls == 0) {
    return false
  }
  if (classMarkerTarget(c, want) == cls ||
    vMentionsInvalid(c, want, 0) ||
    vHasTypeParam(c, want, 0)) {
    return true
  }
  report(
    c.diags, ecTypeMismatch, vSpan(c, node),
    "expected '${typeName(c.ctx, want)}', found the class name '${typeName(c.ctx, cls)}'",
    "a class name is a value only as the argument of a `Class<T>` parameter (SPEC §12.3.1)",
  )
  return true
}

// The empty `Class<T>` value a class name lowers to where `hint` is its own
// `Class<T>`, or -1 (no value id is negative) when this is not that position and
// the caller lowers the identifier as it always did. The class is asked first:
// it is the cheap test, and almost every hinted identifier is a local.
fn lowerClassNameArg(fc: FnCtx, node: int, hint: int): int {
  let cls = classNameArg(fc.c, node)
  if (cls == 0 || hint == 0 || classMarkerTarget(fc.c, hint) != cls) {
    return -1
  }
  let decl = structDeclOf(fc.c, hint)
  if (decl == 0) {
    return -1
  }
  let oc = typeOwner(fc.c, hint)
  let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, hint))
  let ga = mkInstr(Op.GcAlloc, hint)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  return builderEmit(fc.b, ga)
}

// An identifier in expression position: a class name where `hint` is its own
// `Class<T>` (`lowerClassNameArg`), else the name's value (`lowerNamedValue`).
fn lowerIdentExpr(fc: FnCtx, node: int, hint: int, n: Node): int {
  let marker = lowerClassNameArg(fc, node, hint)
  if (marker >= 0) {
    return marker
  }
  return lowerNamedValue(fc, node, fc.c.source[n.span.start:n.span.end])
}

// A call whose type arguments could not all be inferred, judged for the one
// cause this file owns: a `Class<T>` parameter whose argument is a typed value
// that is not a class name (`p.can(Read, user, {...})`), so nothing bound `T`.
// The argument is the program's mistake, E0041 here, not a gap to ask explicit
// type arguments for; an argument the checker cannot type stays silent (THE
// SAFETY RULE). True when it reported, so the caller adds no E0068 on top.
fn vClassParamArgs(c: Checker, node: int, cd: CallDecl): bool {
  let reported = false
  let i = 0
  while (i < len(cd.params) && i < len(kidsOf(c.tree, kidsOf(c.tree, node)[2]))) {
    let pnode = kidsOf(cd.owner.tree, cd.params[i])[1]
    let a = callArgNode(c, node, i)
    let isMarker = getNode(cd.owner.tree, pnode).tag == Tag.GenericInst &&
      typeNodeName(cd.owner, pnode) == classMarkerName
    if (isMarker && a != 0 && classNameArg(c, a) == 0) {
      reported = vReportNotAClass(c, a) || reported
    }
    i = i + 1
  }
  return reported
}

// E0041 for argument `a` of a `Class<T>` parameter when it has a type and is
// not a class name; false (nothing said) for one the checker cannot type.
fn vReportNotAClass(c: Checker, a: int): bool {
  let got = checkExprType(c, a)
  if (got == 0 || vMentionsInvalid(c, got, 0)) {
    return false
  }
  report(
    c.diags, ecTypeMismatch, vSpan(c, a),
    "expected a class name for a `Class<T>` parameter, found '${typeName(
      c.ctx,
      defaultType(c, got),
    )}'",
    "name the class itself, as in `can(Read, Article, { ... })` (SPEC §12.3.1)",
  )
  return true
}
