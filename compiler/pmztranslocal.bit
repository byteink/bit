// ---- local-path transitive resolution (#6266) ---------------------------
//
// Bound on a dependency chain reachable PURELY through local filesystem
// paths (Power of 10 rule 2) — the local-path counterpart to
// `_tests_/bit/pkgdocs/firstparty.bit`'s own `maxDepDepth` for the identical
// shape of walk over a different corpus. No real chain in this repo is
// remotely close to it.
const maxLocalChainEntries: int = 64

// #6266: `bit add`/`bit up` already give a TAG-pinned dependency's own
// `requires` the full transitive walk (`resolveTransitiveDeps`, pmztrans.bit) — a
// local-path dependency's own `bit.json` gets nothing today, so a project
// depending on `orm` (pkg/orm) by local path never learns about orm's own
// postgres/mysql dependencies unless it declares them itself by hand. This
// gives a LOCAL dependency's own LOCAL requirements the same transitive
// treatment `resolveTransitiveDeps` already gives tag-pinned ones, called
// BEFORE it (`addLocalDependency`/`upDependencies`) so a nested local
// dependency already has its own top-level entry by the time that walk's
// `lockHasEntry` check reaches it — its own NON-local requirements (the
// orm/postgres shape this ticket exists for) still flow into that ordinary
// walk unchanged, reused rather than duplicated.
//
// SECURITY (#2244, `resolveTransitiveSpec`'s own refusal) is unchanged by
// this: it only ever inspects entries ALREADY in `entries` with `localPath`
// set — the root's own direct local dependency, or another local dependency
// this function itself resolved. An entry reached through a git FETCH never
// has `localPath` set, so `resolveTransitiveSpec`'s refusal still fires the
// moment a FETCHED dependency's own manifest names a local path —
// `checkPmCliTransitiveLocalDependencyBanned` (pmcliaddedgecheck.bit) proves
// that boundary still holds.
export fn resolveLocalTransitiveDeps(projectDir: string, entries: []LockEntry): []LockEntry! {
  let out = entries
  let i = 0
  while (i < len(out)) {
    if (i >= maxLocalChainEntries) {
      fail newError("pmz: local dependency chain exceeds the ${maxLocalChainEntries}-entry bound")
    }
    let owner = out[i]
    i = i + 1
    if (len(owner.localPath) == 0) {
      continue
    }
    let ownerDir = pathJoinResolve(projectDir, owner.localPath)
    out = resolveLocalOwnerRequires(ownerDir, owner, out)?
  }
  return out
}

// One local owner's own `requires`, folded into `entries`: a non-local
// requirement is left untouched for `resolveTransitiveDeps` to discover; a
// local one not yet locked gets `resolveLocalDependency`'s own treatment,
// resolved against `ownerDir` (the dependency that named it), not the root
// project — exactly what a relative path inside its OWN `bit.json` means.
fn resolveLocalOwnerRequires(
  ownerDir: string,
  owner: LockEntry,
  entries: []LockEntry,
): []LockEntry! {
  let out = entries
  let j = 0
  while (j < len(owner.requires)) {
    let req = owner.requires[j]
    j = j + 1
    let d = parseAddSpec(req.ref)?
    if (d.scheme != "local") {
      continue
    }
    let absPath = pathJoinResolve(ownerDir, d.localPath)
    out = mergeLocalRequirement(ownerDir, owner.name, req.name, absPath, out)?
  }
  return out
}

// `name`'s entry, added via `resolveLocalDependency` (reused unchanged) and
// written with `localPath` as the ABSOLUTE path `absPath` names — never the
// raw, possibly-`ownerDir`-relative manifest value: `resolvePackageImportUncached`
// (projectpkg.bit) joins every top-level entry's `localPath` against the
// CONSUMING project's own root, never against the dependency that named it,
// so a path relative to ITS OWNER would resolve from the wrong base once it
// is a top-level entry (`pathJoinResolve` returns an absolute `b` as-is,
// regardless of that base, so this is safe either way `entries` reads it
// back). `name` already locked under a DIFFERENT absolute path is the
// local-path counterpart to `checkVersionConflict`'s exact-version
// arbitration: a hard failure naming both requirers and both paths, never a
// silent pick of one.
fn mergeLocalRequirement(
  ownerDir: string, ownerName: string, name: string, absPath: string, entries: []LockEntry,
): []LockEntry! {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      if (len(entries[i].localPath) > 0 && entries[i].localPath != absPath) {
        fail newError("pmz: local dependency '${name}' conflicts: ${ownerName} requires ${absPath}, already locked at ${entries[i].localPath}")
      }
      return entries
    }
    i = i + 1
  }
  let nested = resolveLocalDependency(ownerDir, name, absPath)?
  return upsertLockEntry(entries, lockEntryResolvedAs(nested, "", ""))
}
