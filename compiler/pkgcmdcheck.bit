// compiler/pkgcmdcheck.bit — #6306 (M1b): in-process unit checks for
// pkgcmd.bit's pure resolution logic (longest-match and the two-dependency
// conflict), run by `bit selfcheck` (selfcheck.bit). The end-to-end
// build-and-run path (a real `bit <words>` invocation, `gen.bit`, argv/exit
// code forwarding) is `_tests_/bit/clicmd/pkgcmd.bit` instead — that needs a
// real `bit` binary and a subprocess, which `bit selfcheck` cannot spawn.
//
// Same module as pkgcmd.bit/projectcheck.bit (sibling .bit files): reuses
// `pmCheckMkdirAll` (projectcheck.bit), `pmCheckScratchDir`/`removeTree`/
// `pmCheckTimeoutMs` (pmfetchresolvecheck.bit) and `writeLock` (pmlock.bit)
// without import.

// Writes `<depDir>/cmd/<words>/main.bit` (and its parent directories), so
// `findPkgCmd` has something to match against.
fn pkgCheckWriteCmd(depDir: string, words: []string) {
  let dir = "${depDir}/cmd/${joinSlashWords(words)}"
  pmCheckMkdirAll(dir)
  writeFile("${dir}/main.bit", "fn main() {\n  print(\"ok\\n\")\n}\n") catch e {
    panic("pkgcmdcheck: cannot write ${dir}/main.bit: " + e.message())
  }
}

// `bit make migration` (2 words) must be found before `bit make` (1 word)
// would be, when both exist — proving the longest-match rule, not just that
// SOME match is found. Also proves `words`/`cmdDir` are threaded through
// correctly: the caller gets back exactly the words matched and the
// directory that matched them.
fn checkPkgCmdLongestMatchWins() {
  let root = pmCheckScratchDir()
  let projDir = root + "/proj"
  pmCheckMkdirAll(projDir)
  writeFile(projDir + "/bit.json", "{\"dependencies\": {\"dep\": \"../dep\"}}\n") catch e {
    panic("pkgcmdcheck: cannot write bit.json: " + e.message())
  }
  let depDir = root + "/dep"
  pmCheckMkdirAll(depDir)
  writeLock(projDir + "/bit.lock", [LockEntry{ name = "dep", localPath = "../dep", requires = []LockRequire(0) }]) catch e {
    panic("pkgcmdcheck: cannot write bit.lock: " + e.message())
  }
  pkgCheckWriteCmd(depDir, ["make"])
  pkgCheckWriteCmd(depDir, ["make", "migration"])

  let found = findPkgCmd(projDir, ["make", "migration", "extra"])
  assert(found.ok, "pkgcmdcheck: longest-match: no match found")
  assert(len(found.words) == 2, "pkgcmdcheck: longest-match: want 2 words")
  assert(
    found.words[0] == "make" && found.words[1] == "migration",
    "pkgcmdcheck: longest-match: wrong words",
  )
  assert(found.depName == "dep", "pkgcmdcheck: longest-match: wrong depName")
  // `pathResolve`, not a bare string compare: `pmCheckScratchDir()` builds
  // `root` off `$TMPDIR` verbatim, which on this machine already ends in a
  // '/' — a plain "+"-concatenated expected value keeps that double slash,
  // while `found.cmdDir` went through `pathJoinResolve`'s own lexical
  // normalization (`resolvePackageImportUncached`, projectpkg.bit), which
  // collapses it. Both name the same directory; only the STRING needs
  // normalizing here to compare them.
  let wantCmdDir = pathResolve(depDir + "/cmd/make/migration")
  assert(found.cmdDir == wantCmdDir, "pkgcmdcheck: longest-match: wrong cmdDir")

  removeTree(root, pmCheckTimeoutMs)
}

// Two DIRECT dependencies shipping the identical `cmd/hello/main.bit` is a
// conflict naming both — never a silent pick of one.
fn checkPkgCmdConflictNamesBothDeps() {
  let root = pmCheckScratchDir()
  let projDir = root + "/proj"
  pmCheckMkdirAll(projDir)
  writeFile(
    projDir + "/bit.json",
    "{\"dependencies\": {\"depa\": \"../depa\", \"depb\": \"../depb\"}}\n",
  ) catch e {
    panic("pkgcmdcheck: cannot write bit.json: " + e.message())
  }
  let depaDir = root + "/depa"
  let depbDir = root + "/depb"
  pmCheckMkdirAll(depaDir)
  pmCheckMkdirAll(depbDir)
  writeLock(
    projDir + "/bit.lock",
    [
      LockEntry{ name = "depa", localPath = "../depa", requires = []LockRequire(0) },
      LockEntry{ name = "depb", localPath = "../depb", requires = []LockRequire(0) },
    ],
  ) catch e {
    panic("pkgcmdcheck: cannot write bit.lock: " + e.message())
  }
  pkgCheckWriteCmd(depaDir, ["hello"])
  pkgCheckWriteCmd(depbDir, ["hello"])

  let found = findPkgCmd(projDir, ["hello"])
  assert(!found.ok)
  assert(len(found.conflict) == 2)
  assert(
    (found.conflict[0] == "depa" && found.conflict[1] == "depb") ||
      (found.conflict[0] == "depb" && found.conflict[1] == "depa"),
  )

  removeTree(root, pmCheckTimeoutMs)
}

// A transitive dependency's `cmd/` tree must never be consulted — only the
// keys of the project's OWN `bit.json` "dependencies" map do (`directDependencyDirs`
// reads `projectDeps`, never `bit.lock`'s full — locked but not necessarily
// direct — entry set).
fn checkPkgCmdIgnoresTransitiveDep() {
  let root = pmCheckScratchDir()
  let projDir = root + "/proj"
  pmCheckMkdirAll(projDir)
  // "dep" is the only DIRECT dependency; "transitive" is locked (as a real
  // build would lock a transitive requirement) but never named in
  // bit.json's own "dependencies" map.
  writeFile(projDir + "/bit.json", "{\"dependencies\": {\"dep\": \"../dep\"}}\n") catch e {
    panic("pkgcmdcheck: cannot write bit.json: " + e.message())
  }
  let depDir = root + "/dep"
  let transDir = root + "/transitive"
  pmCheckMkdirAll(depDir)
  pmCheckMkdirAll(transDir)
  writeLock(
    projDir + "/bit.lock",
    [
      LockEntry{ name = "dep", localPath = "../dep", requires = []LockRequire(0) },
      LockEntry{ name = "transitive", localPath = "../transitive", requires = []LockRequire(0) },
    ],
  ) catch e {
    panic("pkgcmdcheck: cannot write bit.lock: " + e.message())
  }
  pkgCheckWriteCmd(transDir, ["hello"])

  let found = findPkgCmd(projDir, ["hello"])
  assert(!found.ok)
  assert(len(found.conflict) == 0)

  removeTree(root, pmCheckTimeoutMs)
}

// `.` and `/` must never reach a filesystem path built from argv words — the
// whole traversal guard is this one predicate.
fn checkPkgCmdRejectsUnsafeWords() {
  assert(isSafePkgCmdWord("migrate"))
  assert(isSafePkgCmdWord("make-migration"))
  assert(isSafePkgCmdWord("v2"))
  assert(!isSafePkgCmdWord(".."))
  assert(!isSafePkgCmdWord("a/b"))
  assert(!isSafePkgCmdWord(""))
  assert(!isSafePkgCmdWord("Hello"))
}
