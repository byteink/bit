// ARM64 block layout (#4455), split out of arm64compile.bit and arm64branch.bit
// so each has room for the reasoning that makes it safe.
// Sibling .bit file, same module: see arm64.bit for the backend overview.
//
// Nothing here is shared with the x86-64 backend on purpose. That backend
// reorders its blocks into RPO (see codegen.bit's note on debug-line rows), so
// "which block is emitted next" is already a different question there, and it
// has no `deadBlock` machinery for this to compose with.

// ===========================================================================
// #4455: a bounds check's panic block is emitted OUT OF LINE
// ===========================================================================
//
// `compileFunction` emitted blocks in `f.blocks` index order, and
// `emitBoundsCheck` (loweraccess.bit) mints its panic block BEFORE the
// in-bounds block. So the panic block was always the branching block's
// immediate successor in emission order, and `emitBr`'s first shape — "THEN
// needs no code and ELSE is the next block" — correctly picked "branch to
// THEN, fall through to ELSE":
//
//     cmp   x0, x8
//     b.lo  0x1000007ac      <- TAKEN on every in-bounds iteration
//     adrp  x24, ...         <- the panic block, 6 words, never executed
//     bl    _bit_rt_panic
//     udf   #0x0
//     0x1000007ac: ldr d0, [x12, x0, lsl #3]
//
// The polarity that costs nothing on the hot path — `b.hs <panic>` not taken,
// falling straight into the load — is unreachable from any branch peephole,
// because it is a decision about where the panic BLOCK goes, not about what
// shape the branch takes. Moving the block is the whole fix: with the panic
// block no longer the emission successor, `emitBr`'s existing second shape
// ("ELSE needs no code": branch to ELSE, fall through to THEN) already emits
// exactly that, unchanged.
//
// WHAT THIS BUYS, MEASURED, so nobody re-derives it from the ticket's original
// prediction — which was refuted. There is no taken-branch throughput ceiling
// being hit here: a dedicated kernel sustains 1.97-1.99 taken branches per
// cycle on this core and `bench/cases/matrix` runs at 52-75% of that. Hand-
// patching the real `matrix` binary into this exact shape (29 words rewritten
// in place, instructions retired per iteration unchanged at 17.196) over 41
// fresh processes per arm moved the MINIMUM by +0.12% and the median by
// -11.98%, p75 by -18.6%, with the run-to-run spread collapsing from 43.5% to
// 2.4%. A taken branch on this core is an EXPOSURE — its cost depends on where
// the code lands — not a fixed price. This deletes the exposure, not a stall.
//
// The instruction count is identical either way. That is the check that the
// two forms do the same work, and it is why this is a placement change and not
// an optimization that could lose one.

// Does `bi` end in `unreachable` — a block with no successors at all?
//
// That is the whole cold-block test, and it is a property of the CFG rather
// than a guess about frequency: `Op.Unreachable` is emitted only after a
// diverging call (a bounds check's `bit_rt_panic`, a `panic()`/`fail` in
// source, a slice's out-of-range trap) or on a join a lowering proved
// unreachable. Every one of those is either never executed or executed once,
// on the way out of the program. Nothing falls out of such a block, which is
// what makes moving it free: it cannot be anyone's fall-through source, and it
// has no edge whose elision could change.
fn blockEndsUnreachable(f: IrFunc, bi: int): bool {
  let b = f.blocks[bi]
  if (b.instsLen == 0) {
    return false
  }
  return f.instrs[b.instsStart + b.instsLen - 1].op == Op.Unreachable
}

// The order `compileFunction` emits blocks in: every non-terminal block first,
// in IR index order, then every `unreachable`-terminated one, also in IR index
// order. A permutation of `0 .. len(f.blocks)`, so `len(layout)` IS the block
// count and every block is still emitted exactly once — a shared panic block
// (two `br`s pointing at one `oob`, lowerreslice.bit) keeps its single copy and
// is simply reached by two branches instead of one branch and one fall-through.
//
// Block 0 is never moved. The prologue and `bindIncomingArgs` are emitted
// before the block loop runs, so the entry block's code must be what follows
// them; a function whose entry diverges outright stays exactly where it is.
//
// Stable within each group on purpose. `isBackEdge` (codegen.bit) reads IR
// block INDICES, not emission positions, so keeping relative order inside the
// hot group means no edge changes its back-edge classification and no
// safepoint poll appears or disappears.
fn computeBlockLayout(f: IrFunc): []int {
  let layout = []int(0)
  let bi = 0
  while (bi < len(f.blocks)) {
    if (bi == 0 || !blockEndsUnreachable(f, bi)) {
      layout = append(layout, bi)
    }
    bi = bi + 1
  }
  bi = 1
  while (bi < len(f.blocks)) {
    if (blockEndsUnreachable(f, bi)) {
      layout = append(layout, bi)
    }
    bi = bi + 1
  }
  return layout
}

// For each block, the block emitted immediately after it that actually emits
// code — or -1 when nothing does. Indexed by block id, walked backwards so
// each entry is one assignment.
//
// This SUBSUMES the `cx.deadBlock` walk `emitJumpOrFallThrough` used to run
// (#4430: a dead block emits no bytes, so it must not count as a block
// standing between `curBlock` and its fall-through candidate). One array now
// answers both questions — "what falls through to what" and "what emits
// nothing" — instead of a `curBlock + 1` guess corrected by a loop.
fn computeLayoutNext(layout: []int, deadBlock: []bool): []int {
  let next = []int(len(layout))
  let li = len(layout) - 1
  let follow = -1
  while (li >= 0) {
    let blk = layout[li]
    next[blk] = follow
    if (!deadBlock[blk]) {
      follow = blk
    }
    li = li - 1
  }
  return next
}

// Which block each instruction index belongs to. `f.blocks` partitions
// `f.instrs` by construction, so every index this is asked about is covered.
fn computeBlockOfInstr(f: IrFunc): []int {
  let out = []int(len(f.instrs))
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart
    while (idx < b.instsStart + b.instsLen) {
      out[idx] = bi
      idx = idx + 1
    }
    bi = bi + 1
  }
  return out
}

// `points` (IR-index order, as `buildIntervals` collected them) re-sorted into
// the order EMISSION reaches them under `layout`.
//
// THIS IS THE #4456 CONTRACT, AND MOVING A BLOCK IS EXACTLY WHAT BREAKS IT.
// `recordSafepoint` (arm64call.bit) picks its stack map with a running counter,
// `result.stackMaps[cx.nextSafepointIdx]`, so the maps must be in emission
// order. `allocateCoalesced` (regalloc.bit) builds `stackMaps[i]` from
// `points.safepoints[i]` one-for-one, and each entry is a pure function of its
// own `pos` — so ordering `points` here orders the maps, with no permutation
// applied afterwards and no second order to keep in step. Every other consumer
// of the list (`crossesAnyPoint`, `rootedAtAnyPoint`, the call/poll filters,
// `xClobberPoints`) asks set questions and cannot see the order at all.
//
// A stable counting sort keyed on `layout` itself, NOT on the hot/cold rule
// above: a filter that re-encoded that rule here would be a second copy of the
// layout decision, and the two diverging would hand each safepoint from the
// divergence on another point's root set — missed GC roots, silent, exit 0.
// That is #4456's failure mode, and it is the one this must not be able to
// re-create. Stability keeps IR order inside a block, which is emission order
// inside a block.
fn computeSafepointEmissionOrder(f: IrFunc, layout: []int, points: []int): []int {
  let blockOf = computeBlockOfInstr(f)
  let n = len(layout)
  let slotOf = []int(n)
  let li = 0
  while (li < n) {
    slotOf[layout[li]] = li
    li = li + 1
  }
  let start = []int(n)
  for p of points {
    start[slotOf[blockOf[p]]] = start[slotOf[blockOf[p]]] + 1
  }
  let acc = 0
  li = 0
  while (li < n) {
    let c = start[li]
    start[li] = acc
    acc = acc + c
    li = li + 1
  }
  let out = []int(len(points))
  for p of points {
    let s = slotOf[blockOf[p]]
    out[start[s]] = p
    start[s] = start[s] + 1
  }
  return out
}

// ===========================================================================
// #7830, #7843, #7867: loop headers on 32 (or 16) bytes, never behind a pad
// that runs on a hot path; function entries on 32
// ===========================================================================
//
// A loop's cycles followed the size of unrelated code before it. On an Apple
// M-series core bench/cases/strings ran 5.5% slower when 12 fewer
// instructions ahead of `_main`'s inner loop moved its header from 0x...510 to
// 0x...504, the loop's own instructions unchanged; three NOPs at entry put
// the header back at 0x...510 and gave the cycles back. x86-64 pads its
// headers already (xAlignBlockStart, x64align.bit, #6442).
//
// The boundary is the one LLVM uses on the Neoverse N1/N2/N3/V1/V2/V3
// tunings (AArch64Subtarget::initializeProperties: loops to 32 within 16
// bytes of padding) and GCC's default tuning uses (generic-armv8-a:
// `-falign-loops=32:16`), with 16 as the floor a header always reaches: a
// header moves to the next 32-byte boundary when that costs at most 16 bytes
// of NOPs, otherwise to the next 16-byte one (at most 12). LLVM sets no loop
// alignment for the Apple A7-M5 tunings.
//
// WHERE THE PAD GOES is #7867. NOPs that run cost more than their issue
// slots here: bench/cases/matrix lost 0.8% to 3 NOPs per pass of its `k`
// loop (1.57M passes), 2 before the strip-mined `j` loop's outer header and 1
// before its inner header. Patching the binary so that no NOP runs, every
// inner header where it was, measured equal to main (paired 1.0000 against a
// null of 1.0003 over 22 rounds); the same layout with 3 NOPs running per
// pass measured 1.0045. So a pad follows LLVM's rule
// (MachineBlockPlacement::alignBlocks, llvm-project 611eee02d8a7): a block
// its layout predecessor does not fall into is always aligned, and one it
// does is aligned only when that edge is cold against the block. Without a
// profile the fall-through edge is judged by shape, in this order:
//
// 1. The code before the header cannot fall into it (a64Quiet): the pad
//    there never runs.
// 2. The code since the last point nothing falls into holds no header and
//    recorded nothing but its own words (a64Hoist): the pad goes there, and
//    that code moves past it. matrix's inner header is reached so: its
//    fall-through predecessor is a strip arm entered only by a branch.
// 3. The header heads an innermost loop: the pad runs once per entry, and a
//    loop with no loop inside it is what iterates against it. strings' inner
//    header is reached so.
// 4. Otherwise no pad. An outer loop's header runs once per pass of a
//    whole inner loop, so its alignment buys little against a pad paid on
//    every entry; the strip-mined outer loop iterates twice per entry in
//    matrix.
//
// A header can only be placed relative to its function's entry, so entries
// are 32-aligned: emitmacho.bit's `__text` and emitelf.bit's emElfTextAlign
// give the section a64FuncAlign(), and the linker gives every function atom
// in it that alignment. The entry fill is linker padding, never executed.
fn a64FuncAlign(): int { return 32 }

// The preferred header boundary, the most padding it may cost, and the
// boundary a header reaches when the preferred one costs more.
fn a64LoopAlign(): int { return 32 }
fn a64LoopMaxPad(): int { return 16 }
fn a64LoopMinAlign(): int { return 16 }

// `hint #0`, the AArch64 NOP.
fn a64NopWord(): int { return 0xD503201F }

// Bytes of NOPs that move a header at function offset `at` onto its boundary.
fn a64HeaderPad(at: int): int {
  let pad = (a64LoopAlign() - at % a64LoopAlign()) % a64LoopAlign()
  if (pad <= a64LoopMaxPad()) {
    return pad
  }
  return (a64LoopMinAlign() - at % a64LoopMinAlign()) % a64LoopMinAlign()
}

fn a64EmitNops(code: ByteBuf, pad: int) {
  let k = 0
  while (k < pad) {
    emitWord(code, a64NopWord())
    k = k + 4
  }
}

// Is the word before `at` one execution never continues past: `b`, `br`,
// `ret`, `udf` or `brk`? Then nothing falls into `at`.
fn a64Quiet(code: ByteBuf, at: int): bool {
  if (at < 4) {
    return false
  }
  let w = readWordAt(code, at - 4)
  let jump = (w & 0xFC000000) == 0x14000000
  let ind = (w & 0xFFFFFC1F) == 0xD61F0000 || (w & 0xFFFFFC1F) == 0xD65F0000
  let trap = (w & 0xFFFF0000) == 0 || (w & 0xFFE0001F) == 0xD4200000
  return jump || ind || trap
}

// One function's padding state across its block loop. `inner` marks the
// headers of innermost loops. The run is the code since the last point
// nothing falls into, with no header in it: where it starts, its first
// block's layout position (-1 for none), what the context had recorded
// then (a64Marks) and how many debug rows.
class A64Pads {
  heads: []bool,
  inner: []bool,
  runAt: int,
  runLi: int,
  marks: []int,
  rows: int,
}

fn a64Pads(f: IrFunc): A64Pads {
  let heads = loopHeaders(f)
  return A64Pads{
    heads = heads, inner = a64InnermostHeads(f, heads), runAt = 0, runLi = -1,
    marks = []int(0), rows = 0,
  }
}

// Every list emission records a code offset into, and the safepoint
// counter. A run that moved any of them cannot move.
fn a64Marks(cx: A64Ctx): []int {
  return [len(cx.jumpFixups), len(cx.relocs), len(cx.clearStubs), cx.nextSafepointIdx]
}

// Which loop headers head an innermost loop: no other header lies after it
// and at or before its last back edge, in block index order, the order
// isBackEdge (codegen.bit) and loopHeaders (jumpchain.bit) read loops in.
fn a64InnermostHeads(f: IrFunc, heads: []bool): []bool {
  let n = len(f.blocks)
  let last = []int(n)
  let bi = 0
  while (bi < n) {
    a64NoteLatch(f, bi, last)
    bi = bi + 1
  }
  let inner = []bool(n)
  let next = n
  bi = n - 1
  while (bi >= 0) {
    if (heads[bi]) {
      assert(last[bi] >= bi, "#7867: a loop header has a back edge")
      inner[bi] = next > last[bi]
      next = bi
    }
    bi = bi - 1
  }
  return inner
}

// Records block `bi` as the last back edge of each header it branches back
// to, as markBackTargets (jumpchain.bit) finds them. Blocks come in index
// order, so the last write is the furthest latch.
fn a64NoteLatch(f: IrFunc, bi: int, last: []int) {
  let b = f.blocks[bi]
  if (b.instsLen <= b.paramCount) {
    return
  }
  let t = f.instrs[b.instsStart + b.instsLen - 1]
  if (t.op != Op.Jump && t.op != Op.Br) {
    return
  }
  if (isBackEdge(bi, t.ival)) {
    last[t.ival] = bi
  }
  if (t.op == Op.Br && isBackEdge(bi, t.ival2)) {
    last[t.ival2] = bi
  }
}

// Where block `layout[li]`, about to be emitted, starts. A loop header moves
// onto its boundary (a64HeaderPad) by the first of the four rules above that
// applies; any other block starts where the code ends and may start a run.
fn a64BlockStart(cx: A64Ctx, ps: A64Pads, layout: []int, li: int): int {
  let at = codeLen(cx)
  assert(at % 4 == 0, "#7867: arm64 code is whole words")
  let bi = layout[li]
  if (!ps.heads[bi]) {
    a64NoteRun(cx, ps, li, at)
    return at
  }
  let pad = a64HeaderPad(at)
  let quiet = a64Quiet(cx.code, at)
  let hoisted = pad > 0 && !quiet && a64Hoist(cx, ps, layout, li, pad)
  ps.runLi = -1
  if (pad > 0 && !hoisted && (quiet || ps.inner[bi])) {
    a64EmitNops(cx.code, pad)
  }
  return codeLen(cx)
}

// A block nothing falls into starts a new run; any other continues the run
// there is.
fn a64NoteRun(cx: A64Ctx, ps: A64Pads, li: int, at: int) {
  if (!a64Quiet(cx.code, at)) {
    return
  }
  ps.runAt = at
  ps.runLi = li
  ps.marks = a64Marks(cx)
  ps.rows = len(cx.dbgRows)
}

// Rule 2: puts `pad` NOP bytes where the run starts, moving the run's code
// past them, when the run recorded no offset but its blocks' and its debug
// rows', which move with it. False, and nothing touched, otherwise.
fn a64Hoist(cx: A64Ctx, ps: A64Pads, layout: []int, li: int, pad: int): bool {
  if (ps.runLi < 0 || !a64SameInts(a64Marks(cx), ps.marks)) {
    return false
  }
  let s = ps.runAt
  let k = codeLen(cx) - s - 4
  a64EmitNops(cx.code, pad)
  while (k >= 0) {
    writeWordAt(cx.code, s + pad + k, readWordAt(cx.code, s + k))
    k = k - 4
  }
  k = 0
  while (k < pad) {
    writeWordAt(cx.code, s + k, a64NopWord())
    k = k + 4
  }
  k = ps.runLi
  while (k < li) {
    assert(cx.blockOffsets[layout[k]] >= s, "#7867: a run's block starts in the run")
    cx.blockOffsets[layout[k]] = cx.blockOffsets[layout[k]] + pad
    k = k + 1
  }
  a64ShiftRows(cx.dbgRows, ps.rows, s, pad)
  return true
}

// The debug rows a moved run recorded, from index `from`, move with it.
fn a64ShiftRows(rows: []DebugLineRow, from: int, s: int, pad: int) {
  let r = from
  while (r < len(rows)) {
    assert(rows[r].pcOffset >= s, "#7867: a run's debug row lies in the run")
    rows[r].pcOffset = rows[r].pcOffset + pad
    r = r + 1
  }
}

fn a64SameInts(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}
