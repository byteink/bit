// compiler/lowerlit.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// The declared-order index of a field name in a struct, or -1.
function fieldIndexByName(c: Checker, fields: []int, name: string): int {
  let i = 0
  while (i < len(fields)) {
    let fn = getNode(c.tree, kidsOf(c.tree, fields[i])[0])
    if (c.source[fn.span.start:fn.span.end] == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Lowers a struct composite literal `T{f: v, ...}` to a `gc_alloc` (its GC
// descriptor is the ref-field offsets) followed by a `field_set` per field, in
// the literal's source order. ponytail: struct bodies only — []T/[N]T/map<K,V>
// composites and inline-array fields land next.
// Lowers a slice-type callee `[]E(...)`. A single `string` argument is the
// conversion `[]byte(s)` -> `bytes_from_string`. Otherwise it is a sized
// allocation `[]E(n)` / `[]E(n, m)`: `slice_new(n, cap, is_ref)`, cap defaulting
// to n, `is_ref` set when the element is pointer-sized.
function lowerSliceAlloc(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let sliceTy = typeFromNode(fc.c, kids[0])
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let args = kidsOf(fc.c.tree, kids[2])
  let arg0 = args[0]
  if (getNode(fc.c.tree, arg0).tag == Tag.Arg) {
    arg0 = kidsOf(fc.c.tree, arg0)[0]
  }
  // `[]byte(s)`: a lone string argument is the bytes-of-string conversion. A
  // string literal defaults through `untyped_string`, so default the type first.
  let a0ty = defaultType(fc.c, nodeType(fc, arg0))
  if (len(args) == 1 && fc.c.ctx.types[a0ty].kind == TypeKind.Prim && fc.c.ctx.types[a0ty].prim == 11) {
    let sv = lowerExprH(fc, arg0, primType(fc.c.ctx, 11))
    if (fc.failed) {
      return 0
    }
    let bs = mkInstr(Op.RtCall, sliceTy)
    bs.name = "bytes_from_string"
    bs.args = [sv]
    return emitRtCall(fc, bs)
  }
  let nV = lowerExprH(fc, arg0, primType(fc.c.ctx, 3))
  if (fc.failed) {
    return 0
  }
  let capV = nV
  if (len(args) >= 2) {
    let arg1 = args[1]
    if (getNode(fc.c.tree, arg1).tag == Tag.Arg) {
      arg1 = kidsOf(fc.c.tree, arg1)[0]
    }
    capV = lowerExprH(fc, arg1, primType(fc.c.ctx, 3))
    if (fc.failed) {
      return 0
    }
  }
  let refI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [nV, capV, refV]
  return emitRtCall(fc, sn)
}

// Lowers a `[]E{a, b, ...}` slice literal: allocate via `rt_call slice_new(len,
// len, is_ref)`, then `slice_set` each element in order. `items` are the element
// expression nodes (each possibly wrapped in an `arg`).
function lowerSliceElems(fc: FnCtx, sliceTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let lenI = mkInstr(Op.ConstInt, i64ty)
  lenI.ival = len(items)
  let lenV = builderEmit(fc.b, lenI)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [lenV, lenV, refV]
  let s = emitRtCall(fc, sn)
  let i = 0
  while (i < len(items)) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ss = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ss.name = "slice_set"
    ss.args = [s, idxV, v]
    emitRtCall(fc, ss)
    i = i + 1
  }
  return s
}

// Allocates an empty map: `rt_call map_new(key_is_string, val_is_ref)`. The two
// flags drive the runtime's key hashing and GC tracing (ABI.md §11). `mapTy` is
// the checker's interned map type.
function lowerMapMake(fc: FnCtx, mapTy: int): int {
  let m = fc.c.ctx.types[mapTy]
  let i64ty = primType(fc.c.ctx, 3)
  let kf = mkInstr(Op.ConstInt, i64ty)
  if (fc.c.ctx.types[m.mapKey].kind == TypeKind.Prim && fc.c.ctx.types[m.mapKey].prim == 11) {
    kf.ival = 1
  }
  let kflag = builderEmit(fc.b, kf)
  let vf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, m.mapVal).isPtr) {
    vf.ival = 1
  }
  let vflag = builderEmit(fc.b, vf)
  let ins = mkInstr(Op.RtCall, mapTy)
  ins.name = "map_new"
  ins.args = [kflag, vflag]
  return emitRtCall(fc, ins)
}

// A `map<K,V>{k: v, ...}` composite: allocate, then `map_set(m, k, v)` per entry
// in order (each key/val lowered at the map's key/val type).
function lowerMapLit(fc: FnCtx, mapTy: int, entries: []int): int {
  let m = fc.c.ctx.types[mapTy]
  let mv = lowerMapMake(fc, mapTy)
  let i = 0
  while (i < len(entries) && !fc.failed) {
    let ek = kidsOf(fc.c.tree, entries[i])
    let key = lowerExprH(fc, ek[0], m.mapKey)
    let val = lowerExprH(fc, ek[1], m.mapVal)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [mv, key, val]
    emitRtCall(fc, ins)
    i = i + 1
  }
  return mv
}

// Constructs a channel `chan<T>(n)`: `rt_call chan_make(cap, is_ref)`, cap
// defaulting to 0 (unbuffered) when omitted; is_ref marks a pointer element word
// so the runtime traces a buffered element as a GC root (ABI.md §11).
function lowerChanMake(fc: FnCtx, node: int): int {
  let chanTy = nodeType(fc, node)
  let elemTy = fc.c.ctx.types[chanTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let capV = 0
  if (len(args) >= 1) {
    let a = args[0]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    capV = lowerExpr(fc, a)
    if (fc.failed) {
      return 0
    }
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    capV = builderEmit(fc.b, z)
  }
  let rf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    rf.ival = 1
  }
  let refV = builderEmit(fc.b, rf)
  let ins = mkInstr(Op.RtCall, chanTy)
  ins.name = "chan_make"
  ins.args = [capV, refV]
  return emitRtCall(fc, ins)
}

// The byte size of a fixed-size array `[N]T`: N inline scalar elements.
function arrayBytes(fc: FnCtx, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  return a.arrayLen * fieldLayoutFor(fc, a.elem).size
}

// A fresh, zeroed inline storage block for an `[N]T` value: `gc_alloc` hands back
// zeroed memory (no reference elements to trace), so every element reads 0.
function newArray(fc: FnCtx, arrayTy: int): int {
  let ga = mkInstr(Op.GcAlloc, arrayTy)
  ga.ival = arrayBytes(fc, arrayTy)
  ga.offsets = []int(0)
  return builderEmit(fc.b, ga)
}

// An independent copy of the `[N]T` value `src`: read every (scalar) element
// BEFORE allocating the destination — `gc_alloc` is a safepoint, so holding the
// loads past it keeps them off the far side of a possible collection.
function cloneArray(fc: FnCtx, src: int, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let elems = []int(0)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = builderEmit(fc.b, ci)
    elems = append(elems, builderEmit(fc.b, ig))
    i = i + 1
  }
  let dst = newArray(fc, arrayTy)
  i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = builderEmit(fc.b, ci)
    is.ival = elems[i]
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// The value to bind when an `[N]T`-typed expression flows into a new location
// (let/assign/arg/return): a reference expression (ident/field/index) names
// existing storage, so it is copied for value semantics; a fresh literal is not.
function arrayValueForBind(fc: FnCtx, node: int, val: int, ty: int): int {
  if (ty == 0 || fc.c.ctx.types[ty].kind != TypeKind.Array) {
    return val
  }
  let t = getNode(fc.c.tree, node).tag
  if (t == Tag.Ident || t == Tag.Member || t == Tag.Index) {
    return cloneArray(fc, val, ty)
  }
  return val
}

// Lowers an `[N]T{a, b, ...}` array literal: allocate the block, then `index_set`
// each element in order (elements are scalars, checker-restricted).
function lowerArrayElems(fc: FnCtx, arrayTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[arrayTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let dst = newArray(fc, arrayTy)
  let i = 0
  while (i < len(items) && !fc.failed) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = v
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// Copies every (scalar) element of the `[N]T` at `src` into the existing storage
// at `dst` (both element-base pointers) — read then write per element, no alloc.
function copyArrayInto(fc: FnCtx, dst: int, src: int, arrayTy: int) {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = idxV
    let e = builderEmit(fc.b, ig)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = e
    builderEmit(fc.b, is)
    i = i + 1
  }
}

// The zero value of a type as an IR value (SPEC §13.4): a scalar constant, a
// fresh zeroed array/struct body (a live instance, not nil), else a nil word.
// The field substitution behind a struct TypeId: the declaration's type-param
// names bound to the instantiation's recorded arguments, so `Box<string>` lays
// out `v: T` as a string (a traced pointer) and `Box<i64>` as a scalar. Without
// it a generic field falls back to the bare param and the layout's pointer map
// is wrong for one of the two. Empty for a non-generic struct; a TEMPLATE binds
// its own rigid params, which changes nothing.
function structTySubst(fc: FnCtx, oc: Checker, decl: int, ty: int): TypeSubst {
  let sub = noSubst()
  let gen = kidsOf(oc.tree, decl)[1]
  if (gen == 0) {
    return sub
  }
  let params = kidsOf(oc.tree, gen)
  let args = nominalArgsOf(fc.c, ty)
  let i = 0
  while (i < len(params) && i < len(args)) {
    let pn = getNode(oc.tree, kidsOf(oc.tree, params[i])[0])
    sub.names = append(sub.names, oc.source[pn.span.start:pn.span.end])
    sub.types = append(sub.types, args[i])
    i = i + 1
  }
  return sub
}

function zeroValue(fc: FnCtx, ty: int): int {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 10) {
      let b = mkInstr(Op.ConstBool, ty)
      b.bval = false
      return builderEmit(fc.b, b)
    }
    if (td.prim == 8 || td.prim == 9) {
      let f = mkInstr(Op.ConstFloat, ty)
      return builderEmit(fc.b, f)
    }
    if (td.prim == 11) {
      let s = mkInstr(Op.ConstString, ty)
      s.sval = ""
      s.ival = internPoolString(fc, s.sval)
      return builderEmit(fc.b, s)
    }
    let ci = mkInstr(Op.ConstInt, ty)
    return builderEmit(fc.b, ci)
  }
  if (td.kind == TypeKind.Array) {
    return newArray(fc, ty)
  }
  if (td.kind == TypeKind.Struct) {
    let decl = structDeclOf(fc.c, ty)
    if (decl == 0) {
      fc.failed = true
      return 0
    }
    let oc = typeOwner(fc.c, ty)
    let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, ty))
    let ga = mkInstr(Op.GcAlloc, ty)
    ga.ival = layout.size
    ga.offsets = layout.ptrOffsets
    return builderEmit(fc.b, ga)
  }
  // A slice zero-value is the EMPTY slice, not a null header (SPEC §13.4). A
  // null header has no `len` word to load, so `len(xs)` on it faults; `nil` is
  // unspellable for a slice (`xs == nil` is E0053), so an empty slice is
  // indistinguishable from the `nil` the spec names — and unlike `nil` it is
  // usable. Same shape as `string`'s zero above.
  if (td.kind == TypeKind.Slice) {
    return lowerSliceElems(fc, ty, []int(0))
  }
  let nl = mkInstr(Op.ConstNil, ty)
  return builderEmit(fc.b, nl)
}

// Binds a generic struct's declared type-param names to the concrete arguments
// at a composite-literal site: `Box<i64>{...}` (a GenericInst type node) yields
// {T: i64}. Param names come from the declaration (`oc`), argument types from
// the construction site (`c`) — the two differ across a module boundary. Empty
// for a non-generic struct (the type node is a plain ident).
function structLitSubst(c: Checker, oc: Checker, decl: int, typeNode: int): TypeSubst {
  let sub = noSubst()
  if (getNode(c.tree, typeNode).tag != Tag.GenericInst) {
    return sub
  }
  let params = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  let targs = kidsOf(c.tree, kidsOf(c.tree, typeNode)[1])
  let i = 0
  while (i < len(params) && i < len(targs)) {
    let pn = getNode(oc.tree, kidsOf(oc.tree, params[i])[0])
    sub.names = append(sub.names, oc.source[pn.span.start:pn.span.end])
    sub.types = append(sub.types, typeFromNode(c, targs[i]))
    i = i + 1
  }
  return sub
}

function lowerCompositeLit(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let structTy = typeFromNode(fc.c, kids[0])
  // A `[]E{...}` slice composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Slice) {
    return lowerSliceElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // An `[N]T{...}` array composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Array) {
    return lowerArrayElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // A `map<K,V>{...}` composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Map) {
    return lowerMapLit(fc, nodeType(fc, node), kidsOf(fc.c.tree, kids[1]))
  }
  if (structTy == 0 || fc.c.ctx.types[structTy].kind != TypeKind.Struct) {
    fc.failed = true
    return 0
  }
  let decl = structDeclOf(fc.c, structTy)
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let oc = typeOwner(fc.c, structTy)
  let sub = structLitSubst(fc.c, oc, decl, kids[0])
  let layout = structLayout(fc, oc, decl, sub)
  let fields = structFieldNodes(oc, decl)
  let ga = mkInstr(Op.GcAlloc, structTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(fc.b, ga)
  let inits = kidsOf(fc.c.tree, kids[1])
  let i = 0
  while (i < len(inits)) {
    let fk = kidsOf(fc.c.tree, inits[i])
    let fn = getNode(fc.c.tree, fk[0])
    let idx = fieldIndexByName(oc, fields, fc.c.source[fn.span.start:fn.span.end])
    if (idx == -1) {
      fc.failed = true
      return 0
    }
    // Substituted, for the same reason the layout above is: `items: []T` on a
    // `Stack<i64>{...}` must lower its initializer under `[]i64`. Under the bare
    // `[]T` the slice materializes with is_ref set, and the GC then walks plain
    // integers as pointers.
    let fty = typeFromNodeIn(oc, kidsOf(oc.tree, fields[idx])[1], sub)
    // An inline array field is copied into the struct's own storage (its
    // elements live in the struct body), not stored as a shared handle.
    if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
      let src = lowerExpr(fc, fk[1])
      if (fc.failed) {
        return 0
      }
      let fg = mkInstr(Op.FieldGet, fty)
      fg.lhs = obj
      fg.ival = layout.offsets[idx]
      copyArrayInto(fc, builderEmit(fc.b, fg), src, fty)
      i = i + 1
      continue
    }
    // The field's own type is the hint the initializer lowers under. Without it
    // an untyped literal materializes at its DEFAULT type — `4.5` as an `f64` —
    // and the field_set then writes the field's width from it, storing the low
    // half of an f64 into an `f32` field: a silent zero (#1457).
    let val = lowerExprH(fc, fk[1], fty)
    if (fc.failed) {
      return 0
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[idx]
    fs.rhs = val
    builderEmit(fc.b, fs)
    i = i + 1
  }
  zeroOmittedFields(fc, oc, obj, fields, inits, layout, sub)
  return obj
}

// Give every field the literal did not name its zero value (#1914).
//
// SPEC §13.4 line 1785: a struct's zero value is "a live instance with each
// field zero-valued (structs are references, so `let p: Point` yields a usable
// zeroed `Point`, not `nil`)". `GcAlloc` above hands back zeroed memory, which
// IS the zero value for a scalar, a string and a slice — `let p: Inner` proves
// it, reading `len(p.xs)` as 0 off a zeroed header. It is NOT the zero value for
// a field that must be a live object of its own: a struct field left as zero
// bits is a null reference, and reading through it segfaults with no diagnostic.
//
//     struct Inner { xs: []u32 }
//     struct Outer { a: int, b: Inner }
//     let o = Outer{ a: 1 }
//     len(o.b.xs)                        // SIGSEGV before this
//
// Ordinary, spec-conforming code with no unsafe construct in it, and the crash
// lands arbitrarily far from the literal. Worse than the crash, an omitted field
// holding a plausible-looking address is a FALSE GC ROOT — `gcMarkConservative`
// follows it and decodes a header that is not one.
//
// Only Struct and Array fields are filled. Both are exactly the cases whose
// `zeroValue` allocates (`GcAlloc` and `newArray`); every other kind's zero
// value is the zero bits `GcAlloc` already wrote, and storing those again would
// be a pointless store per omitted field on every struct literal in the program.
//
// Found from the stdlib, not from a synthetic case: `RsaPrivateKey` grew five
// CRT fields in #1913, and the documented `RsaPrivateKey{n, e, d}` short form —
// which SPEC §15.6 explicitly permits — crashed on the first read of `priv.p`.
function zeroOmittedFields(
  fc: FnCtx,
  oc: Checker,
  obj: int,
  fields: []int,
  inits: []int,
  layout: StructLayout,
  sub: TypeSubst,
) {
  let idx = 0
  while (idx < len(fields)) {
    let fty = typeFromNodeIn(oc, kidsOf(oc.tree, fields[idx])[1], sub)
    let kind = fc.c.ctx.types[fty].kind
    if (kind != TypeKind.Struct && kind != TypeKind.Array) {
      idx = idx + 1
      continue
    }
    if (fieldNamedIn(fc, oc, fields, inits, idx)) {
      idx = idx + 1
      continue
    }
    let zv = zeroValue(fc, fty)
    if (fc.failed) {
      return
    }
    // An inline array lives in the struct's own storage, so it is COPIED in
    // rather than stored as a handle — the same split the named-field path above
    // makes, for the same reason.
    if (kind == TypeKind.Array) {
      let fg = mkInstr(Op.FieldGet, fty)
      fg.lhs = obj
      fg.ival = layout.offsets[idx]
      copyArrayInto(fc, builderEmit(fc.b, fg), zv, fty)
      idx = idx + 1
      continue
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[idx]
    fs.rhs = zv
    builderEmit(fc.b, fs)
    idx = idx + 1
  }
}

// Whether the literal's initializer list names field `idx`.
function fieldNamedIn(fc: FnCtx, oc: Checker, fields: []int, inits: []int, idx: int): bool {
  let i = 0
  while (i < len(inits)) {
    let fk = kidsOf(fc.c.tree, inits[i])
    let fn = getNode(fc.c.tree, fk[0])
    if (fieldIndexByName(oc, fields, fc.c.source[fn.span.start:fn.span.end]) == idx) {
      return true
    }
    i = i + 1
  }
  return false
}

// Lowers a struct field access `s.f` to `field_get %s[offset] fieldType`, or an
// enum variant reference `Enum.Variant` to its tag constant.
function lowerFieldAccess(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  // `ns.member` — an exported const/state/function of a namespaced module, not a
  // field of a value. Its dotted key resolves through the ordinary name path.
  let qn = nsQualifiedName(fc.c, node)
  if (qn != "") {
    return lowerNamedValue(fc, node, qn)
  }
  // `Enum.Variant` (receiver is an enum type name): a C-like enum's variant is
  // its bare tag `const_int <Enum> <ordinal>`; a boxed enum's no-payload variant
  // wraps that tag in the `{tag, nil}` object.
  let baseName = typeNodeName(fc.c, kids[0])
  if (baseName != "") {
    let ut = userTypeLookup(fc.c, baseName)
    if (ut != 0 && fc.c.ctx.types[ut].kind == TypeKind.Enum) {
      let mn0 = getNode(fc.c.tree, kids[1])
      let ord = variantOrdinal(fc.c, ut, fc.c.source[mn0.span.start:mn0.span.end])
      if (fc.c.ctx.types[ut].enumBoxed) {
        return buildEnumObj(fc, ut, ord, -1)
      }
      let ci = mkInstr(Op.ConstInt, ut)
      ci.ival = ord
      return builderEmit(fc.b, ci)
    }
  }
  let recvTy = nodeType(fc, kids[0])
  // An uncalled interface method `iface.m` is a closure over the receiver plus a
  // trampoline that dispatches dynamically (call_iface).
  if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Interface) {
    return lowerIfaceMethodValue(fc, node, recvTy)
  }
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fc.failed = true
    return 0
  }
  let decl = structDeclOf(fc.c, recvTy)
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let oc = typeOwner(fc.c, recvTy)
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(fc.c.tree, kids[1])
  let idx = fieldIndexByName(oc, fields, fc.c.source[mn.span.start:mn.span.end])
  if (idx == -1) {
    return lowerStructMethodValue(fc, node, recvTy)
  }
  // Substituted so a generic field's declared `T` is laid out at the
  // instantiation's real argument width. Must stay in step with the matching
  // `field_set` in `lowerFieldStore` — a read and a write of the same field
  // agreeing on a WRONG offset is worse than either alone (#1565).
  let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, recvTy))
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.FieldGet, fieldAccessType(fc, oc, fields[idx], node))
  ins.lhs = recvV
  ins.ival = layout.offsets[idx]
  return builderEmit(fc.b, ins)
}

// The concrete type of a struct field READ. The declared field node is the
// template's answer (`b: T` of a `Pair<T>` is the bare param), so a read off a
// `Pair<i64>` would emit `field_get ... <T>` — wrong width and, worse, wrong
// is_ref, which is a GC-tracing bug rather than a compile error.
//
// `checkMember` already substitutes the receiver's type arguments, so prefer the
// checker's answer for this node. It is only an improvement when it resolves the
// parameter away; when it cannot (an inferred receiver whose args are
// unrecoverable) it hands back a type still mentioning the parameter, and the
// declared type stands. Permissive when undecided: never trade a known type for
// an unknown one.
//
// The openness test is STRUCTURAL (#1556). Testing only whether the declared
// type is ITSELF a bare TypeParam accepted `[]T`, `chan<T>`, `map<string, T>`,
// `[2]T`, `(T) => T` and `Box<T>` verbatim, because none of those is a TypeParam
// at the top level — so a read off a `Shapes<i64>` emitted
// `field_get %0[8] []<T>` where the seed emits `[]i64`. That is the is_ref bug
// this function's comment warns about, reached one level down: a slice of a type
// param classifies as holding GC references.
function fieldAccessType(fc: FnCtx, oc: Checker, field: int, node: int): int {
  let declTy = typeFromNode(oc, kidsOf(oc.tree, field)[1])
  if (declTy != 0 && !vHasTypeParam(fc.c, declTy, 0)) {
    return declTy
  }
  let checked = nodeType(fc, node)
  if (checked != 0 && !vHasTypeParam(fc.c, checked, 0)) {
    return checked
  }
  return declTy
}

// Does `ty`'s zero value (SPEC §13.4) differ from the null word that `map_get`
// reports a miss with? True for the reference types whose zero is a live object
// — `string` (`""`), slice (empty), struct (zeroed instance), `[N]T` (zeroed
// block). False for map/chan/function/interface, whose zero IS `nil`, and for
// every scalar, whose zero IS the word 0.
function zeroIsObject(fc: FnCtx, ty: int): bool {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    return td.prim == 11
  }
  return td.kind == TypeKind.Slice || td.kind == TypeKind.Array ||
    td.kind == TypeKind.Struct
}

// `m[k]` (SPEC §12.6): a missing key yields the value type's zero value.
// `map_get` can only report a miss as the null word, so where V's zero is a live
// object materialize it on the miss edge — otherwise a miss hands back a null
// header and the first `len`/field read faults (#1557). The zero is built
// lazily, inside the miss block, so a hit allocates nothing.
function emitMapGet(fc: FnCtx, valTy: int, m: int, key: int): int {
  let gv = mkInstr(Op.RtCall, valTy)
  gv.name = "map_get"
  gv.args = [m, key]
  let v = emitRtCall(fc, gv)
  if (!zeroIsObject(fc, valTy)) {
    return v
  }
  let miss = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = neNil(fc, v, valTy)
  br.ival = join
  br.thenArgs = [v]
  br.ival2 = miss
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, miss)
  let zero = zeroValue(fc, valTy)
  if (fc.failed) {
    return 0
  }
  emitJump(fc, join, [zero])
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, valTy)
}

// Lowers an index read `a[i]`: a slice via `rt_call slice_get`, a map via
// `map_get`, a string via `string_byte`, a fixed array via the `index_get` op.
function lowerIndex(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let ty = defaultType(fc.c, nodeType(fc, node))
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  let rd = fc.c.ctx.types[recvTy]
  if (rd.kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "slice_get"
    ins.args = [recv, idx]
    return emitRtCall(fc, ins)
  }
  if (rd.kind == TypeKind.Map) {
    return emitMapGet(fc, ty, recv, idx)
  }
  if (rd.kind == TypeKind.Prim && rd.prim == 11) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "string_byte"
    ins.args = [recv, idx]
    return emitRtCall(fc, ins)
  }
  let ins = mkInstr(Op.IndexGet, ty)
  ins.lhs = recv
  ins.rhs = idx
  return builderEmit(fc.b, ins)
}

// Lowers a reslice `s[lo:hi]` (SPEC §12.7): `rt_call slice_slice(s, lo, hi)` for a
// slice, `string_slice` for a string. An omitted `lo` is 0; an omitted `hi` is
// the receiver's current length. Array reslice is not lowerable (matches seed).
function lowerSliceExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let isString = rd.kind == TypeKind.Prim && rd.prim == 11
  if (rd.kind != TypeKind.Slice && !isString) {
    fc.failed = true
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let recv = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let lo = 0
  if (k[1] != 0) {
    lo = lowerExprH(fc, k[1], i64ty)
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    lo = builderEmit(fc.b, z)
  }
  let hi = 0
  if (k[2] != 0) {
    hi = lowerExprH(fc, k[2], i64ty)
  } else {
    let sl = mkInstr(Op.SliceLen, i64ty)
    sl.lhs = recv
    hi = builderEmit(fc.b, sl)
  }
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.RtCall, nodeType(fc, node))
  ins.name = "slice_slice"
  if (isString) {
    ins.name = "string_slice"
  }
  ins.args = [recv, lo, hi]
  return emitRtCall(fc, ins)
}
