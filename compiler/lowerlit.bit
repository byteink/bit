// compiler/lowerlit.bit — split out of lower.bit (#1809); #2911, further
// split — field/index/reslice access moved to loweraccess.bit to keep both
// files under the 800-line lint limit. Sibling of lower.bit and
// loweraccess.bit: same module, so this needs no imports and no call-site
// changes. Composite literal construction (class/slice/array/map/chan) and
// zero values.

// The declared-order index of a field name in a class, or -1.
fn fieldIndexByName(c: Checker, fields: []int, name: string): int {
  let i = 0
  while (i < len(fields)) {
    let fldNode = getNode(c.tree, kidsOf(c.tree, fields[i])[0])
    if (c.source[fldNode.span.start:fldNode.span.end] == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Lowers a class composite literal `T{f: v, ...}` to a `gc_alloc` (its GC
// descriptor is the ref-field offsets) followed by a `field_set` per field, in
// the literal's source order. ponytail: class bodies only — []T/[N]T/map<K,V>
// composites and inline-array fields land next.
// Whether `[]E(...)` is the `[]byte(s)` CONVERSION rather than a sized
// allocation: exactly one argument, of type `string`. A string literal defaults
// through `untyped_string`, so the argument's type is defaulted before the test.
fn isBytesConversion(fc: FnCtx, args: []int, arg0: int): bool {
  if (len(args) != 1) {
    return false
  }
  let a0ty = defaultType(fc.c, nodeType(fc, arg0))
  return fc.c.ctx.types[a0ty].kind == TypeKind.Prim && fc.c.ctx.types[a0ty].prim == 11
}

// `[]byte(s)` -> `rt_call bytes_from_string(s)`. Split out of `lowerSliceAlloc`
// with its predicate above so that function stays inside E0204's complexity
// ceiling (spec/LINT.md §max-complexity = 10); it was already over at 12 before
// #3648 added its empty-slice arm.
fn lowerBytesFromString(fc: FnCtx, sliceTy: int, arg0: int): int {
  let sv = lowerExprH(fc, arg0, primType(fc.c.ctx, 11))
  if (fc.failed) {
    return 0
  }
  let bs = mkInstr(Op.RtCall, sliceTy)
  bs.name = "bytes_from_string"
  bs.args = [sv]
  return emitRtCall(fc, bs)
}

// Unwraps a call argument's `Arg` wrapper node to the underlying expression,
// if present. `lowerSliceAlloc`'s two argument reads share this exact shape;
// splitting it out keeps that function inside E0204's complexity ceiling
// (spec/LINT.md §max-complexity = 10) after #3756's zero-arg guard pushed it
// to 11.
fn unwrapSliceAllocArg(fc: FnCtx, node: int): int {
  if (getNode(fc.c.tree, node).tag == Tag.Arg) {
    return kidsOf(fc.c.tree, node)[0]
  }
  return node
}

// Lowers a slice-type callee `[]E(...)`. A single `string` argument is the
// conversion `[]byte(s)` -> `bytes_from_string`. Otherwise it is a sized
// allocation `[]E(n)` / `[]E(n, m)`: `slice_new(n, cap, is_ref)`, cap defaulting
// to n, `is_ref` set when the element is pointer-sized.
//
// `[]T()` with zero arguments is checker-rejected (E0050, validatezero.bit's
// vSliceAllocArity), so `bit check`/`build`/`run` never reach here with an
// empty `args` — but `--dump-ir`/`--dump-ir-pre` lower unchecked input (#3756),
// so this still has to decline rather than index `args[0]` off the end.
fn lowerSliceAlloc(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let sliceTy = typeFromNode(fc.c, kids[0])
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let args = kidsOf(fc.c.tree, kids[2])
  if (len(args) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a sized slice constructor `[]T()` with no arguments")
    return 0
  }
  let arg0 = unwrapSliceAllocArg(fc, args[0])
  if (isBytesConversion(fc, args, arg0)) {
    return lowerBytesFromString(fc, sliceTy, arg0)
  }
  let nV = lowerExprH(fc, arg0, primType(fc.c.ctx, 3))
  if (fc.failed) {
    return 0
  }
  let capV = nV
  if (len(args) >= 2) {
    let arg1 = unwrapSliceAllocArg(fc, args[1])
    capV = lowerExprH(fc, arg1, primType(fc.c.ctx, 3))
    if (fc.failed) {
      return 0
    }
  }
  // `[]E(0)` / `[]E(0, 0)`: no header and no buffer (#3648). An explicit
  // non-zero capacity (`[]E(0, 16)`) still allocates — that slice has a
  // reserved buffer to hand back.
  if (isStaticEmptyAlloc(fc.b, nV, capV)) {
    return emptySliceValue(fc, sliceTy)
  }
  let refI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  // elem_size (ABI.md §9, #3121/#3226): 1 for a packed `[]u8`, 8 for every
  // other element type. `sliceElemSizeFor` (lowercall.bit) is the single
  // source of truth for which prim gets packed.
  let esI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  esI.ival = sliceElemSizeFor(fc, elemTy)
  let esV = builderEmit(fc.b, esI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [nV, capV, refV, esV]
  let s = emitRtCall(fc, sn)
  if (fc.c.ctx.types[elemTy].kind == TypeKind.Struct) {
    return fillStructElems(fc, s, elemTy, nV, getNode(fc.c.tree, node).span)
  }
  return s
}

// A STATICALLY-EMPTY SLICE IS THE NULL HEADER, NOT AN ALLOCATION (#3648).
//
// `slice_new` costs TWO heap objects, and for a length-0 capacity-0 slice both
// are pure overhead: the header (`gcAlloc(g, base + riSlice * 8)`,
// runtime/root/slices.bit:181) and its element buffer (slices.bit:182 ->
// `allocBuf` -> `gcAllocRaw(g, words * elemSize, info)`, runtime/root/root.bit).
// Nothing can be read out of either — every bounds check rejects every index —
// so the pair exists only to be collected.
//
// THE NULL WORD IS THE LANGUAGE'S OTHER SPELLING OF THE EMPTY SLICE, not a new
// representation. A zeroed class's slice field already holds it (SPEC §13.4),
// `nil` is unspellable for a slice (`xs == nil` is E0053), and every reader
// already answers it as empty: `len` and `cap` through both backends'
// `emitHeaderWordOrZero` (#1564), `xs[i]` through the inlined bounds check
// (compiler/loweraccess.bit), `append` through `appendTarget`
// (runtime/root/slices.bit), `xs[lo:hi]` through `rtSliceSlice`'s null arm, and
// `for … of` through `slice_len`.
//
// AND IT SHARES NOTHING, which is what rules out the two candidate singletons.
// A process-wide empty HEADER cannot work at all — `append` grows the header in
// place, so the first append anywhere would corrupt it (#1557, recorded in
// slices.bit's `rtSliceAppend` header) — and a shared empty BACKING would need
// a proof that nothing ever writes through it, which `append`'s documented
// aliasing (E0214) makes a convention rather than a guarantee. Null aliases
// nothing: `append(null, x)` allocates a fresh header AND a fresh buffer, so no
// two empty slices can ever reach the same memory.
fn emptySliceValue(fc: FnCtx, sliceTy: int): int {
  return builderEmit(fc.b, mkInstr(Op.ConstNil, sliceTy))
}

// True when `[]E(n[, m])`'s already-lowered length and capacity are both
// literally `const_int 0`. A structural test on the lowered values, the same
// shape and the same one-way conservatism as lower.bit's `isConstTrue`: it can
// only under-report, and under-reporting costs the allocation this avoids
// rather than correctness. The two dead `const_int 0`s it leaves behind are
// `deadCodeElim`'s (compiler/opt.bit) and cost one `mov` each at -O0.
fn isStaticEmptyAlloc(b: IrBuilder, nV: int, capV: int): bool {
  return isConstZeroVal(b, nV) && isConstZeroVal(b, capV)
}

fn isConstZeroVal(b: IrBuilder, v: int): bool {
  if (v < 0 || v >= len(b.instrs)) {
    return false
  }
  return b.instrs[v].op == Op.ConstInt && b.instrs[v].ival == 0
}

// Lowers a `[]E{a, b, ...}` slice literal: allocate via `rt_call slice_new(len,
// len, is_ref)`, then `slice_set` each element in order. `items` are the element
// expression nodes (each possibly wrapped in an `arg`).
fn lowerSliceElems(fc: FnCtx, sliceTy: int, items: []int): int {
  // `[]E{}` — and, through `zeroValue` below, every slice zero value — is the
  // null header rather than two heap objects (#3648). See `emptySliceValue`.
  if (len(items) == 0) {
    return emptySliceValue(fc, sliceTy)
  }
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let lenI = mkInstr(Op.ConstInt, i64ty)
  lenI.ival = len(items)
  let lenV = builderEmit(fc.b, lenI)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  // elem_size (ABI.md §9, #3121/#3226): see `lowerSliceAlloc`'s identical
  // comment above.
  let esI = mkInstr(Op.ConstInt, i64ty)
  esI.ival = sliceElemSizeFor(fc, elemTy)
  let esV = builderEmit(fc.b, esI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [lenV, lenV, refV, esV]
  let s = emitRtCall(fc, sn)
  let i = 0
  while (i < len(items)) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ss = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ss.name = "slice_set"
    ss.args = [s, idxV, v, esV]
    emitRtCall(fc, ss)
    i = i + 1
  }
  return s
}

// Allocates an empty map: `rt_call map_new(key_desc, val_is_ref)`. The two
// arguments drive the runtime's key hashing, equality and GC tracing (ABI.md
// §15). `mapTy` is the checker's interned map type.
//
// `key_desc` is 0 for a scalar key and 1 for a `string` key — and for a class
// or tuple key it is the DESCRIPTOR PROGRAM for that type, so the map hashes and
// matches the key's CONTENTS. Passing 0 there is what made an equal key miss and
// a re-insert grow the map (#2111); it also left the key buffer untraced, so a
// composite key could be collected while the map still held it.
fn lowerMapMake(fc: FnCtx, mapTy: int): int {
  let m = fc.c.ctx.types[mapTy]
  let i64ty = primType(fc.c.ctx, 3)
  let prog = descForType(fc, m.mapKey)
  let kflag = 0
  if (prog != "") {
    kflag = descConst(fc, prog)
  } else {
    let kf = mkInstr(Op.ConstInt, i64ty)
    if (fc.c.ctx.types[m.mapKey].kind == TypeKind.Prim && fc.c.ctx.types[m.mapKey].prim == 11) {
      kf.ival = 1
    }
    kflag = builderEmit(fc.b, kf)
  }
  let vf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, m.mapVal).isPtr) {
    vf.ival = 1
  }
  let vflag = builderEmit(fc.b, vf)
  let ins = mkInstr(Op.RtCall, mapTy)
  ins.name = "map_new"
  ins.args = [kflag, vflag]
  return emitRtCall(fc, ins)
}

// A `map<K,V>{k: v, ...}` composite: allocate, then `map_set(m, k, v)` per entry
// in order (each key/val lowered at the map's key/val type).
fn lowerMapLit(fc: FnCtx, mapTy: int, entries: []int): int {
  let m = fc.c.ctx.types[mapTy]
  let mv = lowerMapMake(fc, mapTy)
  let i = 0
  while (i < len(entries) && !fc.failed) {
    let ek = kidsOf(fc.c.tree, entries[i])
    let key = lowerExprH(fc, ek[0], m.mapKey)
    let val = lowerExprH(fc, ek[1], m.mapVal)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [mv, key, val]
    emitRtCall(fc, ins)
    i = i + 1
  }
  return mv
}

// Constructs a channel `chan<T>(n)`: `rt_call chan_make(cap, is_ref)`, cap
// defaulting to 0 (unbuffered) when omitted; is_ref marks a pointer element word
// so the runtime traces a buffered element as a GC root (ABI.md §11).
fn lowerChanMake(fc: FnCtx, node: int): int {
  let chanTy = nodeType(fc, node)
  let elemTy = fc.c.ctx.types[chanTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let capV = 0
  if (len(args) >= 1) {
    let a = args[0]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    capV = lowerExpr(fc, a)
    if (fc.failed) {
      return 0
    }
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    capV = builderEmit(fc.b, z)
  }
  let rf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    rf.ival = 1
  }
  let refV = builderEmit(fc.b, rf)
  let ins = mkInstr(Op.RtCall, chanTy)
  ins.name = "chan_make"
  ins.args = [capV, refV]
  return emitRtCall(fc, ins)
}

// The byte size of a fixed-size array `[N]T`: N inline scalar elements.
fn arrayBytes(fc: FnCtx, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  return a.arrayLen * fieldLayoutFor(fc, a.elem).size
}

// A fresh, zeroed inline storage block for an `[N]T` value: `gc_alloc` hands back
// zeroed memory (no reference elements to trace), so every element reads 0.
fn newArray(fc: FnCtx, arrayTy: int): int {
  let ga = mkInstr(Op.GcAlloc, arrayTy)
  ga.ival = arrayBytes(fc, arrayTy)
  ga.offsets = []int(0)
  return builderEmit(fc.b, ga)
}

// An independent copy of the `[N]T` value `src`: read every (scalar) element
// BEFORE allocating the destination — `gc_alloc` is a safepoint, so holding the
// loads past it keeps them off the far side of a possible collection.
fn cloneArray(fc: FnCtx, src: int, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let elems = []int(0)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = builderEmit(fc.b, ci)
    elems = append(elems, builderEmit(fc.b, ig))
    i = i + 1
  }
  let dst = newArray(fc, arrayTy)
  i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = builderEmit(fc.b, ci)
    is.ival = elems[i]
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// The value to bind when an `[N]T`-typed expression flows into a new location
// (let/assign/arg/return): a reference expression (ident/field/index) names
// existing storage, so it is copied for value semantics; a fresh literal is not.
fn arrayValueForBind(fc: FnCtx, node: int, val: int, ty: int): int {
  if (ty == 0 || fc.c.ctx.types[ty].kind != TypeKind.Array) {
    return val
  }
  let t = getNode(fc.c.tree, node).tag
  if (t == Tag.Ident || t == Tag.Member || t == Tag.Index) {
    return cloneArray(fc, val, ty)
  }
  return val
}

// Lowers an `[N]T{a, b, ...}` array literal: allocate the block, then `index_set`
// each element in order (elements are scalars, checker-restricted).
fn lowerArrayElems(fc: FnCtx, arrayTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[arrayTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let dst = newArray(fc, arrayTy)
  let i = 0
  while (i < len(items) && !fc.failed) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = v
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// Copies every (scalar) element of the `[N]T` at `src` into the existing storage
// at `dst` (both element-base pointers) — read then write per element, no alloc.
fn copyArrayInto(fc: FnCtx, dst: int, src: int, arrayTy: int) {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = idxV
    let e = builderEmit(fc.b, ig)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = e
    builderEmit(fc.b, is)
    i = i + 1
  }
}

// The zero value of a type as an IR value (SPEC §13.4): a scalar constant, a
// fresh zeroed array/class body (a live instance, not nil), else a nil word.
// The field substitution behind a class TypeId: the declaration's type-param
// names bound to the instantiation's recorded arguments, so `Box<string>` lays
// out `v: T` as a string (a traced pointer) and `Box<i64>` as a scalar. Without
// it a generic field falls back to the bare param and the layout's pointer map
// is wrong for one of the two. Empty for a non-generic class; a TEMPLATE binds
// its own rigid params, which changes nothing.
fn structTySubst(fc: FnCtx, oc: Checker, decl: int, ty: int): TypeSubst {
  let sub = noSubst()
  let gen = kidsOf(oc.tree, decl)[1]
  if (gen == 0) {
    return sub
  }
  let params = kidsOf(oc.tree, gen)
  let args = nominalArgsOf(fc.c, ty)
  let i = 0
  while (i < len(params) && i < len(args)) {
    let pn = getNode(oc.tree, kidsOf(oc.tree, params[i])[0])
    sub.names = append(sub.names, oc.source[pn.span.start:pn.span.end])
    sub.types = append(sub.types, args[i])
    i = i + 1
  }
  return sub
}

// The zero value of `ty`, materialized.
//
// The Struct arm below emits a bare zeroed `GcAlloc` and writes no field, and
// that is CORRECT rather than a shortcut, because of an invariant the checker
// now enforces (E0083, #1914): a class type that has a class-typed field has
// no zero value at all and never reaches here — `vBindingNoZeroValue` rejects
// `let o: Outer` before lowering. So every class that does get here has only
// fields whose zero value IS zero bits (scalars, strings, slices, maps,
// interfaces, inline arrays), which is exactly what `GcAlloc` hands back.
//
// This function used to be paired with a `zeroOmittedFields` in the literal
// path that filled class-typed fields one level deep. That fill was deleted
// with the checker rule: two mechanisms answering the same question is how they
// come to disagree, and the fill's own recursion stopped at depth 1 anyway, so
// `Inner` inside `Inner` was still a null.
fn zeroValue(fc: FnCtx, ty: int, span: Span): int {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 10) {
      let b = mkInstr(Op.ConstBool, ty)
      b.bval = false
      return builderEmit(fc.b, b)
    }
    if (td.prim == 8 || td.prim == 9) {
      let f = mkInstr(Op.ConstFloat, ty)
      return builderEmit(fc.b, f)
    }
    if (td.prim == 11) {
      let s = mkInstr(Op.ConstString, ty)
      s.sval = ""
      s.ival = internPoolString(fc, s.sval)
      return builderEmit(fc.b, s)
    }
    let ci = mkInstr(Op.ConstInt, ty)
    return builderEmit(fc.b, ci)
  }
  if (td.kind == TypeKind.Array) {
    return newArray(fc, ty)
  }
  if (td.kind == TypeKind.Struct) {
    let decl = structDeclOf(fc.c, ty)
    if (decl == 0) {
      fcFail(fc, span, "a zero value for a class type with no declaration in scope")
      return 0
    }
    let oc = typeOwner(fc.c, ty)
    let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, ty))
    let ga = mkInstr(Op.GcAlloc, ty)
    ga.ival = layout.size
    ga.offsets = layout.ptrOffsets
    return builderEmit(fc.b, ga)
  }
  // A slice zero-value is the EMPTY slice (SPEC §13.4), which since #3648 is
  // spelled as the null header — `lowerSliceElems` with no items.
  //
  // THIS COMMENT USED TO SAY THE OPPOSITE and its reason was stale: "a null
  // header has no `len` word to load, so `len(xs)` on it faults". #1564 fixed
  // that fault in both backends (`emitHeaderWordOrZero`), so null and empty are
  // now indistinguishable to a program in every operation, not just in the
  // `xs == nil` that E0053 already forbids.
  if (td.kind == TypeKind.Slice) {
    return lowerSliceElems(fc, ty, []int(0))
  }
  let nl = mkInstr(Op.ConstNil, ty)
  return builderEmit(fc.b, nl)
}

// Binds a generic class's declared type-param names to the concrete arguments
// at a composite-literal site: `Box<i64>{...}` (a GenericInst type node) yields
// {T: i64}. Param names come from the declaration (`oc`), argument types from
// the construction site (`c`) — the two differ across a module boundary. Empty
// for a non-generic class (the type node is a plain ident).
fn structLitSubst(c: Checker, oc: Checker, decl: int, typeNode: int): TypeSubst {
  let sub = noSubst()
  if (getNode(c.tree, typeNode).tag != Tag.GenericInst) {
    return sub
  }
  let params = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  let targs = kidsOf(c.tree, kidsOf(c.tree, typeNode)[1])
  let i = 0
  while (i < len(params) && i < len(targs)) {
    let pn = getNode(oc.tree, kidsOf(oc.tree, params[i])[0])
    sub.names = append(sub.names, oc.source[pn.span.start:pn.span.end])
    sub.types = append(sub.types, typeFromNode(c, targs[i]))
    i = i + 1
  }
  return sub
}

fn lowerCompositeLit(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let structTy = typeFromNode(fc.c, kids[0])
  // A `[]E{...}` slice composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Slice) {
    return lowerSliceElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // An `[N]T{...}` array composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Array) {
    return lowerArrayElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // A `map<K,V>{...}` composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Map) {
    return lowerMapLit(fc, nodeType(fc, node), kidsOf(fc.c.tree, kids[1]))
  }
  if (structTy == 0 || fc.c.ctx.types[structTy].kind != TypeKind.Struct) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a composite literal whose target type is not a slice, array, map or class")
    return 0
  }
  let decl = structDeclOf(fc.c, structTy)
  if (decl == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a class composite literal with no declaration in scope")
    return 0
  }
  let oc = typeOwner(fc.c, structTy)
  let sub = structLitSubst(fc.c, oc, decl, kids[0])
  let layout = structLayout(fc, oc, decl, sub)
  let fields = structFieldNodes(oc, decl)
  let ga = mkInstr(Op.GcAlloc, structTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(fc.b, ga)
  let inits = kidsOf(fc.c.tree, kids[1])
  let i = 0
  while (i < len(inits)) {
    let fk = kidsOf(fc.c.tree, inits[i])
    let fldNode = getNode(fc.c.tree, fk[0])
    let idx = fieldIndexByName(oc, fields, fc.c.source[fldNode.span.start:fldNode.span.end])
    if (idx == -1) {
      fcFail(fc, fldNode.span, "a composite literal field that does not exist on the class")
      return 0
    }
    // Substituted, for the same reason the layout above is: `items: []T` on a
    // `Stack<i64>{...}` must lower its initializer under `[]i64`. Under the bare
    // `[]T` the slice materializes with is_ref set, and the GC then walks plain
    // integers as pointers.
    let fty = typeFromNodeIn(oc, kidsOf(oc.tree, fields[idx])[1], sub)
    // An inline array field is copied into the class's own storage (its
    // elements live in the class body), not stored as a shared handle.
    if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
      let src = lowerExpr(fc, fk[1])
      if (fc.failed) {
        return 0
      }
      let fg = mkInstr(Op.FieldGet, fty)
      fg.lhs = obj
      fg.ival = layout.offsets[idx]
      copyArrayInto(fc, builderEmit(fc.b, fg), src, fty)
      i = i + 1
      continue
    }
    // The field's own type is the hint the initializer lowers under. Without it
    // an untyped literal materializes at its DEFAULT type — `4.5` as an `f64` —
    // and the field_set then writes the field's width from it, storing the low
    // half of an f64 into an `f32` field: a silent zero (#1457).
    let val = lowerExprH(fc, fk[1], fty)
    if (fc.failed) {
      return 0
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[idx]
    fs.rhs = val
    builderEmit(fc.b, fs)
    i = i + 1
  }
  return obj
}
