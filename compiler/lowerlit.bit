// compiler/lowerlit.bit — split out of lower.bit (#1809); #2911, further
// split — field/index/reslice access moved to loweraccess.bit; #4064,
// further split — map construction moved to lowermapctor.bit; #5706, further
// split — class/struct composite literals (field lookup, the generic
// type-param substitution and the two field writers) moved to
// lowerclasslit.bit; all to keep files under the 800-line lint limit.
// Sibling of lower.bit, loweraccess.bit, lowermapctor.bit and
// lowerclasslit.bit: same module, so this needs no imports and no call-site
// changes. Slice/array/chan composite literal construction, zero values, and
// the composite-literal dispatcher that routes to the class arm.

// Lowers a class composite literal `T{f = v, ...}` to a `gc_alloc` (its GC
// descriptor is the ref-field offsets) followed by a `field_set` per field, in
// the literal's source order. ponytail: class bodies only — []T/[N]T/map<K,V>
// composites and inline-array fields land next.
// Whether `[]E(...)` is the `[]byte(s)` CONVERSION rather than a sized
// allocation: exactly one argument, of type `string`, AND the slice's element
// is byte-sized (`byte`/`u8`, prim index 4). A string literal defaults through
// `untyped_string`, so the argument's type is defaulted before the test.
//
// #4137: this used to admit any single-`string`-arg slice literal, with no
// check on `elemTy` at all — mirroring only half of the checker's own
// `vSliceAllocIsBytesForm` (validatector.bit), which requires both. `bit
// check`/`build`/`run` never reached the gap: `vSliceAllocArgType` already
// rejects `[]i64("hello")` with E0111 before lowering ever runs. But
// `--dump-ir`/`--dump-ir-pre` lower unchecked input (#3756), and without the
// elem check here `[]i64("hello")` took this early return and was lowered as
// `rt_call bytes_from_string(...) []i64` — a 5-byte buffer typed as a 5-element
// `[]i64`, reading past the allocation for any index beyond 0. With the elem
// check added, that case now falls through to `lowerSliceAllocLenArg`, which
// already `fcFail`s on a non-integer length argument.
fn isBytesConversion(fc: FnCtx, elemTy: int, args: []int, arg0: int): bool {
  if (len(args) != 1) {
    return false
  }
  if (elemTy == 0 ||
    fc.c.ctx.types[elemTy].kind != TypeKind.Prim ||
    fc.c.ctx.types[elemTy].prim != 4) {
    return false
  }
  let a0ty = defaultType(fc.c, nodeType(fc, arg0))
  return fc.c.ctx.types[a0ty].kind == TypeKind.Prim && fc.c.ctx.types[a0ty].prim == 11
}

// `[]byte(s)` -> `rt_call bytes_from_string(s)`. Split out of `lowerSliceAlloc`
// with its predicate above so that function stays inside E0204's complexity
// ceiling (spec/LINT.md §max-complexity = 10); it was already over at 12 before
// #3648 added its empty-slice arm.
fn lowerBytesFromString(fc: FnCtx, sliceTy: int, arg0: int): int {
  let sv = lowerExprH(fc, arg0, primType(fc.c.ctx, 11))
  if (fc.failed) {
    return 0
  }
  let bs = mkInstr(Op.RtCall, sliceTy)
  bs.name = "bytes_from_string"
  bs.args = [sv]
  return emitRtCall(fc, bs)
}

// Unwraps a call argument's `Arg` wrapper node to the underlying expression,
// if present. `lowerSliceAlloc`'s two argument reads share this exact shape;
// splitting it out keeps that function inside E0204's complexity ceiling
// (spec/LINT.md §max-complexity = 10) after #3756's zero-arg guard pushed it
// to 11.
fn unwrapSliceAllocArg(fc: FnCtx, node: int): int {
  if (getNode(fc.c.tree, node).tag == Tag.Arg) {
    return kidsOf(fc.c.tree, node)[0]
  }
  return node
}

// A length/cap argument for `[]T(n)` / `[]T(n, m)` must be an integer —
// `vSliceAllocArgType` (validatector.bit, #4091) already enforces this at
// check time, but `--dump-ir`/`--dump-ir-pre` lower unchecked input (#3756),
// so lowering cannot trust that check ran either: a non-integer argument
// (e.g. another slice's own SSA result) would otherwise be handed straight to
// `slice_new` as a raw i64 length, reading that value's address as a length
// (#4104). By the time this is called, `isBytesConversion` above has already
// ruled out the one legal non-integer case (a single §12.9 `[]byte(s)`
// string argument), so a plain integer check is exact here. Split out of
// `lowerSliceAlloc` to keep it under E0204's complexity ceiling (#4133).
fn lowerSliceAllocLenArg(fc: FnCtx, argNode: int, what: string): int {
  let t = defaultType(fc.c, nodeType(fc, argNode))
  if (!isIntegerOperand(fc.c, t)) {
    fcFail(fc, getNode(fc.c.tree, argNode).span, "a slice ${what} that is not an integer")
    return 0
  }
  let v = lowerExprH(fc, argNode, primType(fc.c.ctx, 3))
  if (fc.failed) {
    return 0
  }
  return v
}

// Lowers a slice-type callee `[]E(...)`. A single `string` argument is the
// conversion `[]byte(s)` -> `bytes_from_string`. Otherwise it is a sized
// allocation `[]E(n)` / `[]E(n, m)`: `slice_new(n, cap, is_ref)`, cap defaulting
// to n, `is_ref` set when the element is pointer-sized.
//
// `[]T()` with zero arguments is checker-rejected (E0050, validatezero.bit's
// vSliceAllocArity), so `bit check`/`build`/`run` never reach here with an
// empty `args` — but `--dump-ir`/`--dump-ir-pre` lower unchecked input (#3756),
// so this still has to decline rather than index `args[0]` off the end.
fn lowerSliceAlloc(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  // #5706: was a bare `typeFromNode(fc.c, kids[0])`, missing the `fc.genEnv`
  // substitution `nodeType` applies -- inside a generic body this kept the
  // template's abstract `[]T`, so `sliceElemIsRef` read the TYPE PARAM's own
  // (non-Prim) elem kind rather than the instantiation's concrete element,
  // and defaulted `is_ref` to 1 for EVERY `[]T(n)` regardless of T: a `[]int`
  // sized allocation was marked as holding traced pointers, same class of bug
  // `structLitSubst`/`lowerCompositeLit` were already fixed for (see
  // `nodeType`'s own header, lower.bit).
  let sliceTy = nodeType(fc, node)
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let args = kidsOf(fc.c.tree, kids[2])
  if (len(args) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a sized slice constructor `[]T()` with no arguments")
    return 0
  }
  let arg0 = unwrapSliceAllocArg(fc, args[0])
  if (isBytesConversion(fc, elemTy, args, arg0)) {
    return lowerBytesFromString(fc, sliceTy, arg0)
  }
  let nV = lowerSliceAllocLenArg(fc, arg0, "length")
  if (fc.failed) {
    return 0
  }
  let capV = nV
  if (len(args) >= 2) {
    let arg1 = unwrapSliceAllocArg(fc, args[1])
    capV = lowerSliceAllocLenArg(fc, arg1, "capacity")
    if (fc.failed) {
      return 0
    }
  }
  // `[]E(0)` / `[]E(0, 0)`: no header and no buffer (#3648). An explicit
  // non-zero capacity (`[]E(0, 16)`) still allocates — that slice has a
  // reserved buffer to hand back.
  if (isStaticEmptyAlloc(fc.b, nV, capV)) {
    return emptySliceValue(fc, sliceTy)
  }
  let refI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  if (sliceElemIsRef(fc, elemTy)) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  // elem_size (ABI.md §9, #3121/#3226, #3862): 1 for a packed `[]u8`, a
  // class's own size for a `[]T` using the packed inline representation, 8
  // for every other element type. `sliceElemSizeFor` (lowerlayout.bit) is the
  // single source of truth for which element type gets packed.
  let stride = sliceElemSizeFor(fc, elemTy)
  let esI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  esI.ival = stride
  let esV = builderEmit(fc.b, esI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [nV, capV, refV, esV]
  let s = emitRtCall(fc, sn)
  // `zeroIsLiveRecord` (lowerslicefill.bit) is the whole condition: an element
  // whose zero value is a built object cannot be left as `slice_new`'s zeroed
  // buffer, which is a null REFERENCE for it. This was a local
  // `sliceAllocElemNeedsFill` naming the class and the boxed enum but not the
  // tuple, so `[]( (int, int) )(n)` handed back nulls (#4500).
  if (zeroIsLiveRecord(fc, elemTy)) {
    // A PACKED class (#3862) needs no fill loop: `slice_new`'s buffer is a
    // fresh GC allocation, always zeroed, and zero bytes ARE an all-scalar
    // class's zero value — the same invariant `typeHasNoZeroValue` guarantees
    // can never fail for a class this ticket lets qualify. A boxed enum is
    // never packed (`sliceElemSizeFor` never inlines one), so this branch
    // always runs for one (#4182): the buffer's zero bytes are a null
    // REFERENCE for it, not the real `{tag:0,nil}` zero value.
    if (stride > 8) {
      return s
    }
    return fillZeroElems(fc, s, elemTy, nV, getNode(fc.c.tree, node).span)
  }
  return s
}

// A STATICALLY-EMPTY SLICE IS THE NULL HEADER, NOT AN ALLOCATION (#3648).
//
// `slice_new` costs TWO heap objects, and for a length-0 capacity-0 slice both
// are pure overhead: the header (`gcAlloc(g, base + riSlice * 8)`,
// runtime/root/slices.bit:181) and its element buffer (slices.bit:182 ->
// `allocBuf` -> `gcAllocRaw(g, words * elemSize, info)`, runtime/root/root.bit).
// Nothing can be read out of either — every bounds check rejects every index —
// so the pair exists only to be collected.
//
// THE NULL WORD IS THE LANGUAGE'S OTHER SPELLING OF THE EMPTY SLICE, not a new
// representation. A zeroed class's slice field already holds it (SPEC §13.4),
// `nil` is unspellable for a slice (`xs == nil` is E0053), and every reader
// already answers it as empty: `len` and `cap` through both backends'
// `emitHeaderWordOrZero` (#1564), `xs[i]` through the inlined bounds check
// (compiler/loweraccess.bit), `append` through `appendTarget`
// (runtime/root/slices.bit), `xs[lo:hi]` through `rtSliceSlice`'s null arm, and
// `for … of` through `slice_len`.
//
// AND IT SHARES NOTHING, which is what rules out the two candidate singletons.
// A process-wide empty HEADER cannot work at all — `append` grows the header in
// place, so the first append anywhere would corrupt it (#1557, recorded in
// slices.bit's `rtSliceAppend` header) — and a shared empty BACKING would need
// a proof that nothing ever writes through it, which `append`'s documented
// aliasing (E0214) makes a convention rather than a guarantee. Null aliases
// nothing: `append(null, x)` allocates a fresh header AND a fresh buffer, so no
// two empty slices can ever reach the same memory.
fn emptySliceValue(fc: FnCtx, sliceTy: int): int {
  return builderEmit(fc.b, mkInstr(Op.ConstNil, sliceTy))
}

// True when `[]E(n[, m])`'s already-lowered length and capacity are both
// literally `const_int 0`. A structural test on the lowered values, the same
// shape and the same one-way conservatism as lower.bit's `isConstTrue`: it can
// only under-report, and under-reporting costs the allocation this avoids
// rather than correctness. The two dead `const_int 0`s it leaves behind are
// `deadCodeElim`'s (compiler/opt.bit) and cost one `mov` each at -O0.
fn isStaticEmptyAlloc(b: IrBuilder, nV: int, capV: int): bool {
  return isConstZeroVal(b, nV) && isConstZeroVal(b, capV)
}

fn isConstZeroVal(b: IrBuilder, v: int): bool {
  if (v < 0 || v >= len(b.instrs)) {
    return false
  }
  return b.instrs[v].op == Op.ConstInt && b.instrs[v].ival == 0
}

// Lowers a `[]E{a, b, ...}` slice literal: allocate via `rt_call slice_new(len,
// len, is_ref)`, then fill each element in order — `fillSliceLitElems` below
// for a word-strided (or packed `[]u8`) element, `fillPackedSliceLitElems` for
// a `stride > 8` class element (#3862). `items` are the element expression
// nodes (each possibly wrapped in an `arg`).
fn lowerSliceElems(fc: FnCtx, sliceTy: int, items: []int): int {
  // `[]E{}` — and, through `zeroValue` below, every slice zero value — is the
  // null header rather than two heap objects (#3648). See `emptySliceValue`.
  if (len(items) == 0) {
    return emptySliceValue(fc, sliceTy)
  }
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let lenI = mkInstr(Op.ConstInt, i64ty)
  lenI.ival = len(items)
  let lenV = builderEmit(fc.b, lenI)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (sliceElemIsRef(fc, elemTy)) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  // elem_size (ABI.md §9, #3121/#3226, #3862): see `lowerSliceAlloc`'s
  // identical comment above.
  let stride = sliceElemSizeFor(fc, elemTy)
  let esI = mkInstr(Op.ConstInt, i64ty)
  esI.ival = stride
  let esV = builderEmit(fc.b, esI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [lenV, lenV, refV, esV]
  let s = emitRtCall(fc, sn)
  if (stride > 8) {
    return fillPackedSliceLitElems(fc, s, elemTy, stride, items)
  }
  return fillSliceLitElems(fc, s, elemTy, esV, items)
}

// Fills a freshly-allocated WORD-STRIDED (or packed `[]u8`) slice literal's
// elements (#4385). An element `canInlineSliceStore` (loweraccess.bit) admits
// becomes one `index_set` against the buffer pointer instead of `rt_call
// slice_set` — that call was 5425 of `bit-out/bin/bit`'s 71128 `bl`s, mostly
// constant tables written as literals (`hpackHuffLen` alone is 257 of them).
// An element the predicate refuses (a word-strided narrow prim — i8/i16/i32/
// u16/u32/bool/f32, for the reason its header states) still goes through the
// call, so the two representations never diverge.
//
// NO BOUNDS CHECK, and the argument does not widen to any other call site.
// `emitInlineSliceSet` pays `emitBoundsCheck` against a runtime `slice_len`
// because its index is arbitrary; here every input is known at emission.
// `s` is the value of the `rt_call slice_new(len, len, ...)` emitted a few
// instructions above in THIS function, with `len` a `const_int` equal to
// `len(items)` — `rtSliceNew` (runtime/root/slices.bit) stores that as
// `slcLen` and allocates `c >= want` slots. Every index is a `const_int i`
// minted below with `0 <= i < len(items)`, so the test would compare two
// constants and could never fail. And nothing can change the header in
// between: `s` is a fresh SSA value, not bound to a local, not stored into any
// object and not passed anywhere, so the only reads of it are the ones this
// function emits and no element expression can even name it. That third step
// is a property of a literal's own private header, not of index arithmetic,
// which is exactly why the elision is authorized here and nowhere else.
//
// `slcOff` is 0 on a fresh header (`rtSliceNew` stores it) and nothing here
// reslices, so `emitSliceElemAddr`'s `buf + (off + i)` is `buf + i` with `off`
// PROVEN zero rather than a second, drifting copy of that arithmetic.
//
// THE BUFFER POINTER IS REUSED ACROSS ELEMENTS ONLY WHILE THAT IS CHECKED.
// `buf` is a GC-managed pointer held as an `i64`, so no stack map describes it
// (ABI.md §4). `emitInlineSliceElem`'s GC paragraph keeps such a copy valid
// across a safepoint because the collector is non-moving AND the owning header
// is live in the stack map at that poll. THE SECOND HALF DOES NOT HOLD HERE:
// nothing uses `s` after the buffer word is read, and the literal's value can
// be discarded by its consumer, so the header may be unreachable at an
// allocation inside a later element expression — freeing the buffer this is
// about to write into. So it is not assumed: the cached `buf` is dropped
// whenever `emittedSafepointIn` (opt.bit) saw anything side-effecting emitted
// while lowering an element, and is read from `s` again, which also
// re-establishes the header's liveness there. What survives is a run of
// elements whose lowering emitted no call, no allocation and no terminator,
// and across such a run `buf`'s live range holds no safepoint at all — the
// original, strongest form of the argument. A constant table is that shape.
fn fillSliceLitElems(fc: FnCtx, s: int, elemTy: int, esV: int, items: []int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let bufV = -1
  let scanned = len(fc.b.instrs)
  let i = 0
  while (i < len(items)) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    if (emittedSafepointIn(fc.b, scanned, len(fc.b.instrs))) {
      bufV = -1
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    if (canInlineSliceStore(fc, elemTy, idxV, v)) {
      if (bufV < 0) {
        bufV = emitSliceLitBuf(fc, s)
      }
      let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
      is.lhs = bufV
      is.rhs = idxV
      is.ival = v
      is.ival2 = elemTy
      builderEmit(fc.b, is)
    } else {
      let ss = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ss.name = "slice_set"
      ss.args = [s, idxV, v, esV]
      emitRtCall(fc, ss)
      bufV = -1
    }
    // Everything emitted since `scanned` that is this function's own — a
    // `const_int`, the buffer read, one raw store — cannot reach a safepoint,
    // and the fallback arm's `rt_call` drops `bufV` on the line above rather
    // than through the scan. So the next window is exactly the next element
    // expression's instructions and nothing else.
    scanned = len(fc.b.instrs)
    i = i + 1
  }
  return s
}

// The slice header's `buf` word (runtime/ABI.md §2, offset 0), read through the
// null-safe header path both backends give `field_get` on a slice base
// (`emitHeaderWordOrZero`, #1564) — the same first half `emitSliceElemAddr`
// (loweraccess.bit) and `emitAppendFastStore` (optappend.bit) read.
fn emitSliceLitBuf(fc: FnCtx, recv: int): int {
  let bufIns = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  bufIns.lhs = recv
  bufIns.ival = 0
  return builderEmit(fc.b, bufIns)
}

// Constructs a channel `chan<T>(n)`: `rt_call chan_make(cap, is_ref)`, cap
// defaulting to 0 (unbuffered) when omitted; is_ref marks a pointer element word
// so the runtime traces a buffered element as a GC root (ABI.md §11).
fn lowerChanMake(fc: FnCtx, node: int): int {
  let chanTy = nodeType(fc, node)
  let elemTy = fc.c.ctx.types[chanTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let capV = 0
  if (len(args) >= 1) {
    let a = args[0]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    capV = lowerExpr(fc, a)
    if (fc.failed) {
      return 0
    }
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    capV = builderEmit(fc.b, z)
  }
  let rf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc.c.ctx, elemTy).isPtr) {
    rf.ival = 1
  }
  let refV = builderEmit(fc.b, rf)
  let ins = mkInstr(Op.RtCall, chanTy)
  ins.name = "chan_make"
  ins.args = [capV, refV]
  return emitRtCall(fc, ins)
}

// The byte size of a fixed-size array `[N]T`: N inline scalar elements.
fn arrayBytes(fc: FnCtx, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  return a.arrayLen * fieldLayoutFor(fc.c.ctx, a.elem).size
}

// A fresh, zeroed inline storage block for an `[N]T` value: `gc_alloc` hands back
// zeroed memory (no reference elements to trace), so every element reads 0.
fn newArray(fc: FnCtx, arrayTy: int): int {
  let ga = mkInstr(Op.GcAlloc, arrayTy)
  ga.ival = arrayBytes(fc, arrayTy)
  ga.offsets = []int(0)
  return builderEmit(fc.b, ga)
}

// An independent copy of the `[N]T` value `src`: read every (scalar) element
// BEFORE allocating the destination — `gc_alloc` is a safepoint, so holding the
// loads past it keeps them off the far side of a possible collection.
fn cloneArray(fc: FnCtx, src: int, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let elems = []int(0)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = builderEmit(fc.b, ci)
    elems = append(elems, builderEmit(fc.b, ig))
    i = i + 1
  }
  let dst = newArray(fc, arrayTy)
  i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = builderEmit(fc.b, ci)
    is.ival = elems[i]
    is.ival2 = a.elem
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// The value to bind when an `[N]T`-typed expression flows into a new location
// (let/assign/arg/return): a reference expression (ident/field/index) names
// existing storage, so it is copied for value semantics; a fresh literal is not.
fn arrayValueForBind(fc: FnCtx, node: int, val: int, ty: int): int {
  if (ty == 0 || fc.c.ctx.types[ty].kind != TypeKind.Array) {
    return val
  }
  let t = getNode(fc.c.tree, node).tag
  if (t == Tag.Ident || t == Tag.Member || t == Tag.Index) {
    return cloneArray(fc, val, ty)
  }
  return val
}

// Lowers an `[N]T{a, b, ...}` array literal: allocate the block, then `index_set`
// each element in order (elements are scalars, checker-restricted).
fn lowerArrayElems(fc: FnCtx, arrayTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[arrayTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let dst = newArray(fc, arrayTy)
  let i = 0
  while (i < len(items) && !fc.failed) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = v
    is.ival2 = elemTy
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// Copies every (scalar) element of the `[N]T` at `src` into the existing storage
// at `dst` (both element-base pointers) — read then write per element, no alloc.
fn copyArrayInto(fc: FnCtx, dst: int, src: int, arrayTy: int) {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = idxV
    let e = builderEmit(fc.b, ig)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = e
    is.ival2 = a.elem
    builderEmit(fc.b, is)
    i = i + 1
  }
}

// The zero value of a type as an IR value (SPEC §13.4): a scalar constant, a
// fresh zeroed array/class body (a live instance, not nil), else a nil word.
// Dispatches to the class arm's own type-param substitution
// (`structTySubst`/`structLitSubst`, lowerclasslit.bit) for the struct case.
fn lowerCompositeLit(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  // #5706: was a bare `typeFromNode`, missing the `fc.genEnv` substitution
  // `nodeType` adds — `h`'s stored type stayed the template's `Holder<T>`.
  let structTy = nodeType(fc, node)
  // A `[]E{...}` slice composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Slice) {
    return lowerSliceElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // An `[N]T{...}` array composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Array) {
    return lowerArrayElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // A `map<K,V>{...}` composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Map) {
    return lowerMapLit(fc, nodeType(fc, node), kidsOf(fc.c.tree, kids[1]))
  }
  if (structTy == 0 || fc.c.ctx.types[structTy].kind != TypeKind.Struct) {
    fcFail(
      fc,
      getNode(fc.c.tree, node).span,
      "a composite literal whose target type is not a slice, array, map or class",
    )
    return 0
  }
  return lowerClassLit(fc, node, structTy)
}
