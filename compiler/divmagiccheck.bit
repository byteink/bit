// In-Bit self-checks for `divisorMagic` (divmagic.bit) — the Granlund-Montgomery
// constant-divide sequences (#4389).
//
// A wrong magic here is a SILENT WRONG ANSWER: the program computes a
// plausible quotient nobody flags, so every arm is pinned individually
// against a reference rather than sampled.
//
// The reference is the C transcription of Hacker's Delight Figures 10-1 and
// 10-3, checked by running the EMITTED SEQUENCE against `/` and `%` over
// 24,893,188 signed and 12,451,136 unsigned (dividend, divisor) pairs — every
// |d| in 2..4096 and 15 larger ones, both signs plus i64 MIN, against
// dividends including i64 MIN, i64 MIN+1, ±(2^32±1), -1, 0, 1, i64 MAX and
// 3000 xorshift values. Zero mismatches, and six targeted mutations of that
// sequence (drop the round-toward-zero fixup, drop either signed correction,
// ignore the unsigned add-indicator, shift by `s` instead of `s-1`, take
// `q2` instead of `q2+1`) each reddened it, in the signed or unsigned arm
// they belong to and not the other. The tuples below are printed BY that
// program, not transcribed by hand.
//
// `shift` is the emitter's shift, so the unsigned fixup rows already carry
// HD's `s - 1`.

fn dmSigned(d: int, m: int, shift: int, addend: int) {
  let g = divisorMagic(d, true)
  assert(g.ok)
  assert(g.signed)
  assert(g.m == m)
  assert(g.shift == shift)
  assert(g.addend == addend)
  assert(!g.fixup)
}

fn dmUnsigned(d: int, m: int, shift: int, fixup: bool) {
  let g = divisorMagic(d, false)
  assert(g.ok)
  assert(!g.signed)
  assert(g.m == m)
  assert(g.shift == shift)
  assert(g.fixup == fixup)
  assert(g.addend == 0)
}

// The divisors that must NOT get a magic sequence, and why each one:
//   0  keeps its zero-divisor panic (SPEC §13.5) -- folding it would return a
//      silent 0 for `/` and the dividend for `%`;
//   1  and -1 need no multiply at all, and -1 is the one that MATTERS:
//      `i64 MIN / -1` overflows, SPEC §13.5 wraps it two's-complement, the
//      hardware divide already does exactly that and a magic sequence would
//      not. As an UNSIGNED divisor the same bit pattern is 2^64-1, a perfectly
//      ordinary divisor, so -1 is declined on the signed side only -- the row
//      below pins that asymmetry rather than leaving it to be inferred.
fn checkDivMagicDeclines() {
  assert(!divisorMagic(0, true).ok)
  assert(!divisorMagic(0, false).ok)
  assert(!divisorMagic(1, true).ok)
  assert(!divisorMagic(1, false).ok)
  assert(!divisorMagic(0 - 1, true).ok)
  assert(divisorMagic(0 - 1, false).ok)
}

fn checkDivMagicSigned() {
  dmSigned(2, -9223372036854775807, 0, 1)
  dmSigned(3, 6148914691236517206, 0, 0)
  dmSigned(5, 7378697629483820647, 1, 0)
  dmSigned(6, 3074457345618258603, 0, 0)
  dmSigned(7, 5270498306774157605, 1, 0)
  dmSigned(10, 7378697629483820647, 2, 0)
  dmSigned(11, 3353953467947191203, 1, 0)
  dmSigned(12, 3074457345618258603, 1, 0)
  dmSigned(13, 5675921253449092805, 2, 0)
  dmSigned(17, 8680820740569200761, 3, 0)
  dmSigned(26, 5675921253449092805, 3, 0)
  dmSigned(100, -6640827866535438581, 6, 1)
  dmSigned(1000, 2361183241434822607, 7, 0)
  dmSigned(1024, -9223372036854775807, 9, 1)
  dmSigned(1000000007, -8543223828751151131, 29, 1)
  dmSigned(2147483647, -9223372032559808509, 30, 1)
  dmSigned(3037000499, -5402926244184667893, 31, 1)
  dmSigned(-3, 6148914691236517205, 1, -1)
  dmSigned(-7, -5270498306774157605, 1, 0)
  dmSigned(-8, 9223372036854775807, 2, -1)
  dmSigned(-100, 6640827866535438581, 6, -1)
  dmSigned(-1024, 9223372036854775807, 9, -1)
  dmSigned(-1000000007, 8543223828751151131, 29, -1)
  dmSigned(-9223372036854775808, 9223372036854775807, 62, -1)
  dmSigned(-9223372036854775807, -4611686018427387905, 61, 0)
  dmSigned(9223372036854775807, 4611686018427387905, 61, 0)
  dmSigned(4294967297, 9223372034707292161, 31, 0)
  dmSigned(6148914691236517205, 6917529027641081857, 61, 0)
}

fn checkDivMagicUnsigned() {
  dmUnsigned(2, -9223372036854775808, 0, false)
  dmUnsigned(3, -6148914691236517205, 1, false)
  dmUnsigned(5, -3689348814741910323, 2, false)
  dmUnsigned(6, -6148914691236517205, 2, false)
  dmUnsigned(7, 2635249153387078803, 2, true)
  dmUnsigned(10, -3689348814741910323, 3, false)
  dmUnsigned(11, 3353953467947191203, 1, false)
  dmUnsigned(12, -6148914691236517205, 3, false)
  dmUnsigned(13, 5675921253449092805, 2, false)
  dmUnsigned(17, -1085102592571150095, 4, false)
  dmUnsigned(26, 5675921253449092805, 3, false)
  dmUnsigned(100, 5165088340638674453, 6, true)
  dmUnsigned(641, -3712371272244199935, 9, false)
  dmUnsigned(1000, 442721857769029239, 9, true)
  dmUnsigned(1001, 423851262432886801, 9, true)
  dmUnsigned(1024, 18014398509481984, 0, false)
  dmUnsigned(1000000007, -8543223828751151131, 29, false)
  dmUnsigned(2147483647, 8589934597, 30, true)
  dmUnsigned(3037000499, 7640891585340215829, 31, true)
  dmUnsigned(4294967297, -4294967295, 32, false)
  dmUnsigned(-1, -9223372036854775807, 63, false)
  dmUnsigned(-2, 3, 63, true)
  dmUnsigned(-9223372036854775807, -3, 63, true)
  dmUnsigned(9223372036854775807, 3, 62, true)
  dmUnsigned(-6148914691236517206, -4611686018427387903, 63, false)
}

fn checkDivMagic() {
  checkDivMagicDeclines()
  checkDivMagicSigned()
  checkDivMagicUnsigned()
  checkDivMagicEmission()
}

// The emitted-byte half, and it exists because the tuple table above did NOT
// catch four of the six mutations run against this work: dropping the signed
// round-toward-zero tail, dropping the signed addend correction, dropping the
// unsigned add-indicator fixup, and applying the signed sequence to an
// unsigned divide all left `divisorMagic` correct and the BYTES wrong, so
// `selfcheck` passed while 36,573 differential lines went red. A tuple that is
// right and an emitter that ignores it are indistinguishable here without this.
//
// `want` is built from the SAME `divisorMagic` result the emitter reads, on
// purpose: this pins the emitter against the plan, and the table above pins
// the plan against Hacker's Delight. Folding the two would let a wrong
// multiplier agree with itself.
fn dmWantSigned(want: ByteBuf, mg: DivMagic, q: int, l: int) {
  let t = scratch2()
  movImm64(want, t, mg.m)
  smulhRR(want, q, l, t)
  if (mg.addend > 0) {
    addRR(want, q, q, l)
  }
  if (mg.addend < 0) {
    subRR(want, q, q, l)
  }
  if (mg.shift > 0) {
    asrImm(want, q, q, mg.shift)
  }
  lsrImm(want, t, q, 63)
  addRR(want, q, q, t)
}

fn dmWantUnsigned(want: ByteBuf, mg: DivMagic, q: int, l: int) {
  let t = scratch2()
  movImm64(want, t, mg.m)
  umulhRR(want, q, l, t)
  if (mg.fixup) {
    subRR(want, t, l, q)
    lsrImm(want, t, t, 1)
    addRR(want, q, t, q)
  }
  if (mg.shift > 0) {
    lsrImm(want, q, q, mg.shift)
  }
}

// `emitDivInt` with a magic plan must emit exactly the quotient sequence, then
// `mov` it to the destination -- and NO divide. Divisors are chosen one per
// shape: 3 has neither correction nor shift, 100 takes the +1 addend and a
// shift, -3 takes the -1 addend, 7 unsigned takes the add-indicator fixup and
// 13 unsigned takes neither.
fn dmAssertDiv(op: Op, d: int, signed: bool) {
  let mg = divisorMagic(d, signed)
  assert(mg.ok)
  let cx = selCtx()
  emitDivInt(cx, op, 0, 1, 2, magicDivPlan(mg), w64())
  let want = newByteBuf()
  if (signed) {
    dmWantSigned(want, mg, scratch3(), 1)
  } else {
    dmWantUnsigned(want, mg, scratch3(), 1)
  }
  movRR(want, 0, scratch3())
  assertSameBytes(cx.code, want)
}

// `%` is the quotient plus `msub d = l - q*divisor`, which is the one place the
// divisor itself is materialized -- from the plan, never from the IR, which is
// why `divPlanReadsDivisor` may tell the skip scans to drop it.
//
// Since #4722 the PLANNER never picks this shape (`%` measured +4.77% and
// keeps its `sdiv`; divplancheck.bit pins that), so this direct call is the
// only thing holding the arm proven for the day it is reopened.
fn dmAssertRem(op: Op, d: int, signed: bool) {
  let mg = divisorMagic(d, signed)
  assert(mg.ok)
  let cx = selCtx()
  emitDivInt(cx, op, 0, 1, 2, magicDivPlan(mg), w64())
  let want = newByteBuf()
  if (signed) {
    dmWantSigned(want, mg, scratch3(), 1)
  } else {
    dmWantUnsigned(want, mg, scratch3(), 1)
  }
  movImm64(want, scratch2(), mg.divisor)
  msubRR(want, 0, scratch3(), scratch2(), 1)
  assertSameBytes(cx.code, want)
}

fn checkDivMagicEmission() {
  dmAssertDiv(Op.SDiv, 3, true)
  dmAssertDiv(Op.SDiv, 100, true)
  dmAssertDiv(Op.SDiv, 0 - 3, true)
  dmAssertDiv(Op.UDiv, 7, false)
  dmAssertDiv(Op.UDiv, 13, false)
  dmAssertRem(Op.SRem, 7, true)
  dmAssertRem(Op.URem, 100, false)

  // No divide is emitted at all -- the point of the whole path. The test is on
  // the OPCODE FIELD, not on a whole word: an exact-word probe carries a
  // destination register, so it answers "no sdiv into x11" and reads exactly
  // like "no sdiv". The first draft of this check did precisely that and its
  // own control caught it -- the general path emits `sdiv x0`, which the
  // x11-shaped probe could never find.
  let cx = selCtx()
  emitDivInt(cx, Op.SDiv, 0, 1, 2, magicDivPlan(divisorMagic(7, true)), w64())
  assert(!bufHasDivide(cx.code))
  let ucx = selCtx()
  emitDivInt(ucx, Op.UDiv, 0, 1, 2, magicDivPlan(divisorMagic(7, false)), w64())
  assert(!bufHasDivide(ucx.code))
  // The controls: the general path DOES carry the opcode, in both signednesses,
  // so `bufHasDivide` is proven able to find one rather than merely never
  // matching. Without these two lines a broken predicate reads as a clean pass.
  let gs = selCtx()
  emitDivInt(gs, Op.SDiv, 0, 1, 2, litDivPlan(), w64())
  assert(bufHasDivide(gs.code))
  let gu = selCtx()
  emitDivInt(gu, Op.UDiv, 0, 1, 2, litDivPlan(), w64())
  assert(bufHasDivide(gu.code))

  // The x86-64 twin emits no `idiv` (F7 /7 -> modrm f8 for rax) either, and
  // does emit the one-operand `imul` (F7 /5 -> modrm e8..ef) that reads rdx.
  let xcx = xTestCtx()
  xEmitDivInt(xcx, XDivOp.SDiv, 0, 0, 0, magicDivPlan(divisorMagic(7, true)), w64())
  assert(!xHexHas(xcx.buf, "48f7f8")) // idiv %rax
  assert(!xHexHas(xcx.buf, "48f7f0")) // div %rax
  let xgeneral = xTestCtx()
  xEmitDivInt(xgeneral, XDivOp.SDiv, 0, 0, 0, litDivPlan(), w64())
  assert(xHexHas(xgeneral.buf, "48f7f8")) // the control: the probe can match
}

// Whether any instruction in `hay` is an SDIV or a UDIV, whatever its
// registers. Both are the data-processing-2-source family
// (`sf 0011010110 Rm opcode Rn Rd`) with opcode 3 and 2; masking off Rm/Rn/Rd
// leaves 0x9ac00c00 and 0x9ac00800, which is what `dataProc2Source` in
// arm64.bit builds. AArch64 instructions are fixed 4-byte little-endian, so
// stepping by 4 from 0 lands on every instruction and on nothing else.
fn bufHasDivide(hay: ByteBuf): bool {
  let i = 0
  while (i + 4 <= len(hay.bytes)) {
    // `int(...)` on every byte, not just the shifted ones: `bytes` is `[]u8`,
    // and `u8 << 24` truncates to zero rather than widening.
    let w = int(hay.bytes[i]) |
      (int(hay.bytes[i + 1]) << 8) |
      (int(hay.bytes[i + 2]) << 16) |
      (int(hay.bytes[i + 3]) << 24)
    let masked = w & 4292934656 // 0xffe0fc00: keep sf, the family and opcode
    if (masked == 2596277248 || masked == 2596276224) {
      return true // 0x9ac00c00 sdiv, 0x9ac00800 udiv
    }
    i = i + 4
  }
  return false
}
