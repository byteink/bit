// In-Bit self-checks for the x86-64 frame words zeroed for class 8's
// conservative scan (#6420): the Win64 home area each call reserves, and the
// prologue's paired 16-byte stores. Sibling .bit file, same module:
// `selfcheck()` calls `checkX64Zeroes` directly and nothing here is imported.

fn checkX64Zeroes() {
  checkX64ReserveShadow()
  checkX64FrameZeroPairs()
  checkZeroRunPositions()
}

// #7565: slots 1, 3 and 4 are zeroed, 0 and 2 written first. x86-64 places
// the written ones from the top, the poll cache next, and the zeroed run last,
// so its three words are adjacent; arm64 places the zeroed run first.
fn checkZeroRunPositions() {
  let wrote = [true, false, true, false, false]
  let fr = XFrame{
    savedGpr = []XReg64(0), savedXmm = []XmmReg(0), numSpillSlots = 6,
    pollCacheSlots = 1, frameSize = 48,
  }
  xPlaceSlots(fr, wrote)
  assert(fr.pollPos == 2 && xPollCacheOffset(fr, 0) == -24, "#7565: the poll cache")
  assert(xSpillOffset(fr, 2) == -16, "#7565: a written slot")
  let offs = xFrameZeroOffs(fr, wrote, 0)
  assert(len(offs) == 3 && offs[0] == -32 && offs[1] == -40 && offs[2] == -48)
  let a = zeroRunPositions(wrote, true, 0)
  assert(a[0] == 3 && a[1] == 0 && a[2] == 4 && a[3] == 1 && a[4] == 2)
}

// Win64: sub $32, %rsp, then movq $0 to 0/8/16/24(%rsp); rsp forces a SIB.
// SysV reserves nothing and emits nothing.
fn checkX64ReserveShadow() {
  let cw = newXCtx(XCallConv.Win64)
  assert(xReserveShadow(cw) == 32)
  let want = "4883ec20" + "48c7042400000000" + "48c744240800000000"
  want = want + "48c744241000000000" + "48c744241800000000"
  assert(xHex(cw.buf) == want, "the Win64 home area is reserved and zeroed")
  let cs = newXCtx(XCallConv.SysV)
  assert(xReserveShadow(cs) == 0 && len(cs.buf.code) == 0)
}

// Offsets in xFrameZeroOffs order (slots downward). SysV: -40 alone keeps
// movq $0; xorps %xmm15,%xmm15 once; -24/-16 is one movups %xmm15, -24(%rbp);
// -8 alone keeps movq $0. Win64: four movq $0, no xmm.
fn checkX64FrameZeroPairs() {
  let cs = newXCtx(XCallConv.SysV)
  cs.frame.zeroOffs = [-8, -16, -24, -40]
  xEmitFrameZeroes(cs)
  let want = "48c745d800000000" + "450f57ff" + "440f117de8"
  want = want + "48c745f800000000"
  assert(xHex(cs.buf) == want, "adjacent zero words are one 16-byte store")
  let cw = newXCtx(XCallConv.Win64)
  cw.frame.zeroOffs = [-8, -16, -24, -40]
  xEmitFrameZeroes(cw)
  assert(len(cw.buf.code) == 32 && !xHexHas(cw.buf, "0f11"), "Win64 keeps movq per word")
}
