// Self-host: static linker driver + ELF executable writer (#345). Turns the
// compiled Bit program's object plus
// libbitrt.a into one standalone, zero-dynamic-linker, zero-libc ELF executable
// — the "ship one binary like Go" promise, on Linux.
//
// Pipeline: read every input into linkobj.bit's generic object model (via
// elfreader.bit / archive.bit), resolve the whole-link global symbol table and
// dead-strip from the entry root `_start` (strip.bit), lay the surviving atoms
// into two page-aligned PT_LOAD segments (R-X: headers/text/rodata; R-W:
// data/GOT/TLS-init/bss) plus a PT_TLS describing the thread-local image, apply
// every relocation against the assigned addresses, then emit Ehdr + Phdrs +
// segment bytes.
//
// Non-PIE ET_EXEC at a fixed base: the kernel maps each PT_LOAD at its p_vaddr
// and jumps to e_entry (= _start), which the runtime provides. FILE LAYOUT
// MIRRORS MEMORY LAYOUT — a segment's file offset is its vaddr minus the load
// base — so .bss/.tbss are the only file-vs-mem size gap, and one piece of
// address arithmetic serves both the segment table and the byte copies.

// Fixed non-PIE load base. The traditional x86-64 ET_EXEC value; well clear of
// the kernel's mmap_min_addr and the zero page.
fn elLoadBase(): int { return 0x400000 }
fn elPage(): int { return 0x1000 }
fn elEntrySymbol(): string { return "_start" }
fn elGotEntrySize(): int { return 8 }
fn sizeofElfPhdr(): int { return 56 }

// p_type
fn ptLoad(): int { return 1 }
fn ptTls(): int { return 7 }
fn ptGnuStack(): int { return 0x6474e551 }
// p_flags
fn pfX(): int { return 1 }
fn pfW(): int { return 2 }
fn pfR(): int { return 4 }

enum ElfLinkTarget {
  X86_64Linux,
  Aarch64Linux,
}

fn elReaderTarget(t: ElfLinkTarget): ElfTarget {
  if (t == ElfLinkTarget.X86_64Linux) {
    return ElfTarget.X86_64
  }
  return ElfTarget.Aarch64
}

// One input to the link. Bit has no tagged union: `isArchive` selects whether
// `bytes` is a single relocatable object (the compiled Bit program) or an ar
// archive (libbitrt.a) whose every member is read as its own module.
class ElfLinkInput {
  isArchive: bool,
  bytes: []u8,
}

// An atom assigned an address. `tlsOffset` is meaningful only for tls_data /
// tls_bss atoms, whose references resolve to thread-pointer offsets rather than
// to vaddrs.
class ElPlaced {
  id: int,
  vaddr: int,
  tlsOffset: int,
}

// Assigns each atom in `items` an address, honouring its own alignment, and
// returns the cursor past the last one. Structs are reference types, so the
// ElPlaced records are updated in place.
fn elPlaceAtoms(modules: []LoModule, items: []ElPlaced, cursor: int): int {
  let c = cursor
  let i = 0
  while (i < len(items)) {
    let a = modules[atomKeyModule(items[i].id)].atoms[atomKeyAtom(items[i].id)]
    c = alignForward(c, a.alignment)
    items[i].vaddr = c
    c = c + a.size
    i = i + 1
  }
  return c
}

// Appends a merged group's atom keys (mergedStackMapAtoms/
// mergedDebugLineAtoms's own return shape) onto an already-collected
// placed-atom list, unplaced (vaddr filled in later by elPlaceAtoms). Shared
// by both merged tables' callers in linkElfExecutable, so that driver gains
// one call per table rather than one loop per table.
fn elAppendGroup(placed: []ElPlaced, group: []int): []ElPlaced {
  let i = 0
  while (i < len(group)) {
    placed = append(placed, ElPlaced{ id: group[i], vaddr: 0, tlsOffset: 0 })
    i = i + 1
  }
  return placed
}

// The atoms of one output class, in module then declaration order.
fn elCollect(modules: []LoModule, kept: map<int, bool>, kind: LoSectionKind): []ElPlaced {
  let out = []ElPlaced(0)
  let mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let id = atomKey(mi, ai)
      let (_, keep) = kept[id]
      if (keep && atoms[ai].kind == kind) {
        out = append(out, ElPlaced{ id: id, vaddr: 0, tlsOffset: 0 })
      }
      ai = ai + 1
    }
    mi = mi + 1
  }
  return out
}

fn elMaxAlign(modules: []LoModule, items: []ElPlaced, start: int): int {
  let m = start
  let i = 0
  while (i < len(items)) {
    let a = modules[atomKeyModule(items[i].id)].atoms[atomKeyAtom(items[i].id)]
    if (a.alignment > m) {
      m = a.alignment
    }
    i = i + 1
  }
  return m
}

// Lays out the TLS init image: tdata gets file bytes, tbss extends memsz only.
// Returns the cursor past the block's FILE-backed part. Both lists are assigned
// their block offsets and vaddrs in place.
class ElTlsLayout {
  vaddr: int,
  filesz: int,
  memsz: int,
  alignment: int,
}

fn elLayoutTls(modules: []LoModule, tdata: []ElPlaced, tbss: []ElPlaced, cursor: int): ElTlsLayout {
  let tlsAlign = elMaxAlign(modules, tdata, 1)
  tlsAlign = elMaxAlign(modules, tbss, tlsAlign)
  let vaddr = alignForward(cursor, tlsAlign)
  let off = 0
  let i = 0
  while (i < len(tdata)) {
    let a = modules[atomKeyModule(tdata[i].id)].atoms[atomKeyAtom(tdata[i].id)]
    off = alignForward(off, a.alignment)
    tdata[i].tlsOffset = off
    tdata[i].vaddr = vaddr + off
    off = off + a.size
    i = i + 1
  }
  let filesz = off // only tdata has a file image
  i = 0
  while (i < len(tbss)) {
    let a = modules[atomKeyModule(tbss[i].id)].atoms[atomKeyAtom(tbss[i].id)]
    off = alignForward(off, a.alignment)
    tbss[i].tlsOffset = off
    tbss[i].vaddr = vaddr + off
    off = off + a.size
    i = i + 1
  }
  return ElTlsLayout{ vaddr: vaddr, filesz: filesz, memsz: off, alignment: tlsAlign }
}

// A symbol's offset from the thread pointer, which differs by ABI variant.
//
// Variant II (x86-64): the static TLS block sits BELOW the thread pointer, so a
// symbol at block offset `o` is at TP - (aligned block size) + o.
//
// Variant I (AArch64): the block sits ABOVE the thread pointer, after a 16-byte
// ABI TCB aligned to the block's own alignment (the AArch64 ELF TLS ABI,
// IHI 0056 §3.5.5: sizeof(TCB) == 16), so a symbol at block offset `o` is at
// TP + alignUp(16, align) + o.
fn elTpOffset(t: ElfLinkTarget, blockOffset: int, tls: ElTlsLayout): int {
  if (t == ElfLinkTarget.X86_64Linux) {
    return blockOffset - alignForward(tls.memsz, tls.alignment)
  }
  return alignForward(16, tls.alignment) + blockOffset
}

// Appends one Elf64_Phdr. Layout: type u32, flags u32, offset u64, vaddr u64,
// paddr u64, filesz u64, memsz u64, align u64. Note flags sits at offset 4 in
// the 64-bit form (Elf32 puts it last) — getting that wrong makes the kernel
// read the whole table as garbage.
fn appendElfPhdr(out: ByteBuf, ptype: int, flags: int, offset: int, vaddr: int,
  filesz: int, memsz: int, palign: int) {
  appendU32(out, ptype)
  appendU32(out, flags)
  appendU64(out, offset)
  appendU64(out, vaddr)
  appendU64(out, vaddr) // p_paddr: irrelevant for a hosted ET_EXEC, mirrors vaddr
  appendU64(out, filesz)
  appendU64(out, memsz)
  appendU64(out, palign)
}

// Reads every input into the generic module model. Objects and archive members
// are kept apart: an object is always a link input, a member only if it
// satisfies a still-undefined symbol (selectArchiveMembers, #1647). Reading a
// member is not loading it.
fn elIngest(target: ElfLinkTarget, inputs: []ElfLinkInput): []LoModule! {
  let modules = []LoModule(0)
  let members = []LoModule(0)
  let rt = elReaderTarget(target)
  let i = 0
  while (i < len(inputs)) {
    if (inputs[i].isArchive) {
      let entries = parseArchive(inputs[i].bytes)?
      let m = 0
      while (m < len(entries)) {
        members = append(members, readElf(rt, entries[m].name, entries[m].data)?)
        m = m + 1
      }
    } else {
      modules = append(modules, readElf(rt, "bit.o", inputs[i].bytes)?)
    }
    i = i + 1
  }
  let picked = selectArchiveMembers(modules, members, [elEntrySymbol()])
  let p = 0
  while (p < len(picked)) {
    modules = append(modules, picked[p])
    p = p + 1
  }
  return modules
}

// True if `symbol` is DEFINED by some member of the `ar` archive `bytes` when
// read for `target` — i.e. whether a static link against this archive would
// resolve a reference to it. Backs SPEC §11.7's E0078 predicate: on Linux an
// `extern function` is admissible when the symbol is inside the archive being
// linked, OR pinned by this build's own modules (`externResolvable` also
// consults `pins`) — this function answers only the archive half. Mirrors the
// seed's link.archiveDefines.
//
// "Defined" means a global-binding ATOM, which is what resolveGlobals keys the
// whole-link symbol table on — the same notion the real link uses, not a
// parallel one. An undefined reference never becomes an atom, so a member that
// merely CALLS `symbol` does not count as defining it. Reading the members
// through readElf rather than through the archive's own `/` symbol index is
// deliberate: the index is a hint an archive is not obliged to carry
// (parseArchive skips it for both formats), whereas the atoms are the ground
// truth the linker itself acts on.
//
// An empty or malformed archive answers FALSE, never an error: the caller's only
// sound response to "undecidable" is to reject, so collapsing that into the
// negative keeps the decision in one place. That answer is for a LINK whose
// archive could not be read — `bit build --emit-obj` performs no link and no
// longer asks this question at all (#1645), rather than asking it with an empty
// slice and being told everything is absent.
fn archiveDefines(target: ElfLinkTarget, bytes: []u8, symbol: string): bool {
  if (len(bytes) == 0) { return false }
  let members = parseArchive(bytes) catch e { return false }
  let rt = elReaderTarget(target)
  let m = 0
  while (m < len(members)) {
    let mod = readElf(rt, members[m].name, members[m].data) catch e {
      m = m + 1
      continue
    }
    for atom of mod.atoms {
      if (atom.binding != LoBinding.Global) { continue }
      if (atom.name == symbol) { return true }
    }
    m = m + 1
  }
  return false
}

// The ELF archive `bytes`' own extern surface for `target` (#2958) — the
// Linux twin of machoArchiveExterns. ELF carries no leading-underscore
// decoration (`archiveDefines` above compares `atom.name` to `symbol`
// unchanged), so the names come back exactly as the object holds them, with
// no undecorating step.
fn elfArchiveExterns(target: ElfLinkTarget, bytes: []u8): map<string, bool> {
  if (len(bytes) == 0) { return map<string, bool>{} }
  let members = parseArchive(bytes) catch e { return map<string, bool>{} }
  let rt = elReaderTarget(target)
  let modules = []LoModule(0)
  let m = 0
  while (m < len(members)) {
    let mod = readElf(rt, members[m].name, members[m].data) catch e {
      m = m + 1
      continue
    }
    modules = append(modules, mod)
    m = m + 1
  }
  return loArchiveExterns(modules)
}

// ---- .symtab / .strtab / .shstrtab (#3395) --------------------------------
//
// A COMPLETE section-header table: every PT_LOAD-covered byte is claimed by
// exactly one section, not only .text. That completeness is load-bearing, not
// cosmetic — GNU strip/objcopy REBUILD the program headers from the section
// table when they rewrite a file, and a byte range no section claims, they
// treat as free to drop. A .text-only table proved this the hard way: on real
// x86_64 Linux, `strip` silently deleted the ENTIRE R-W PT_LOAD segment
// (.data/.got/.bss/TLS) and truncated .rodata out of the R-X one, producing a
// binary that segfaults on its first touch of any global — worse than shipping
// no section table at all, which `strip` correctly refuses ("has no
// sections") rather than corrupting.
//
// Nothing at runtime looks any of this up: the compiler's own panic
// self-symbolization (epic #1905) never consults a section header, and stays
// fully independent of this table. These bytes are appended AFTER every
// PT_LOAD segment, exactly where a stripped binary's tables would also sit —
// the kernel loader reads only Ehdr+Phdrs+segment bytes and never consults
// e_shoff, so a tool that drops this table WITHOUT rebuilding segments (e.g.
// `objcopy --remove-section=.symtab` alone) still produces a valid, loadable
// ELF file.
class ElSymtab {
  strtab: ByteBuf,
  symtab: ByteBuf,
  nLocal: int,
}

// One STB_LOCAL/STT_FUNC Elf64_Sym per surviving kept .text atom that carries a
// name, address = its assigned vaddr. Mirrors machoreloc.bit's meBuildSymtab —
// same shape, same "skip an empty name" guard, ELF's own on-disk format.
fn elBuildSymtab(modules: []LoModule, text: []ElPlaced): ElSymtab {
  let strtab = newByteBuf()
  strtab.bytes = append(strtab.bytes, u8(0)) // offset 0 == ""
  let symtab = newByteBuf()
  appendElfSym(symtab, 0, 0, 0, 0, 0) // index 0: mandatory null symbol
  let nLocal = 0
  let i = 0
  while (i < len(text)) {
    let atom = modules[atomKeyModule(text[i].id)].atoms[atomKeyAtom(text[i].id)]
    if (len(atom.name) > 0) {
      let nameOff = elfInternString(strtab, atom.name)
      appendElfSym(symtab, nameOff, elfSymInfo(ElfBinding.Local, ElfSymKind.Func),
        1, text[i].vaddr, atom.size) // shndx 1: the lone .text section header
      nLocal = nLocal + 1
    }
    i = i + 1
  }
  return ElSymtab{ strtab: strtab, symtab: symtab, nLocal: nLocal }
}

// The four PT_LOAD-covered byte ranges a section must claim. Every *Start/
// *End is a vaddr; the matching file offset is always vaddr - elLoadBase()
// (elflink.bit:15-18, "file layout mirrors memory layout"). `data` covers the
// GOT and the TLS init image too — they are physically contiguous with it and
// carry no symbols of their own, so folding them into one PROGBITS section
// claims their bytes without inventing three more sections for it.
class ElShLayout {
  textStart: int, textEnd: int, textAlign: int,
  rodataStart: int, rodataEnd: int, rodataAlign: int,
  dataStart: int, dataEnd: int, dataAlign: int,
  bssStart: int, bssEnd: int, bssAlign: int,
}

// The bytes to append after `fileSize` (the resulting e_shoff) plus those
// bytes themselves: .strtab, .symtab, .shstrtab, then an 8-entry section-header
// table (SHT_NULL, .text, .rodata, .data, .bss, .strtab, .symtab, .shstrtab).
class ElShTable {
  bytes: []u8,
  shoff: int,
}

// One PROGBITS/NOBITS ElfShdr spanning [start, end) at `align`, of ELF's own
// `kind` (reusing elf.bit's elfSectionName/elfShType/elfShFlags rather than
// re-deriving them).
fn elShdrFor(shstrtab: ByteBuf, kind: ElfSectionKind, start: int, end: int, align: int): ElfShdr {
  let nameOff = elfInternString(shstrtab, elfSectionName(kind))
  return ElfShdr{ name: nameOff, shtype: elfShType(kind), flags: elfShFlags(kind),
    addr: start, offset: start - elLoadBase(), size: end - start,
    link: 0, info: 0, addralign: align, entsize: 0 }
}

fn elBuildSectionTable(fileSize: int, ly: ElShLayout, st: ElSymtab): ElShTable {
  let shstrtab = newByteBuf()
  shstrtab.bytes = append(shstrtab.bytes, u8(0))
  let textSh = elShdrFor(shstrtab, ElfSectionKind.Text, ly.textStart, ly.textEnd, ly.textAlign)
  let rodataSh = elShdrFor(shstrtab, ElfSectionKind.Rodata, ly.rodataStart, ly.rodataEnd, ly.rodataAlign)
  let dataSh = elShdrFor(shstrtab, ElfSectionKind.Data, ly.dataStart, ly.dataEnd, ly.dataAlign)
  let bssSh = elShdrFor(shstrtab, ElfSectionKind.Bss, ly.bssStart, ly.bssEnd, ly.bssAlign)
  let strtabNameOff = elfInternString(shstrtab, ".strtab")
  let symtabNameOff = elfInternString(shstrtab, ".symtab")
  let shstrtabNameOff = elfInternString(shstrtab, ".shstrtab")

  let tail = newByteBuf()
  let strtabFileOff = fileSize + len(tail.bytes)
  appendBytes(tail, st.strtab.bytes)
  padTo(tail, 8)
  let symtabFileOff = fileSize + len(tail.bytes)
  appendBytes(tail, st.symtab.bytes)
  let shstrtabFileOff = fileSize + len(tail.bytes)
  appendBytes(tail, shstrtab.bytes)
  padTo(tail, 8)
  let shoff = fileSize + len(tail.bytes)

  let shdrs = []ElfShdr(0)
  shdrs = append(shdrs, ElfShdr{ name: 0, shtype: 0, flags: 0, addr: 0, offset: 0,
    size: 0, link: 0, info: 0, addralign: 0, entsize: 0 }) // 0: SHT_NULL
  shdrs = append(shdrs, textSh)   // 1: .text
  shdrs = append(shdrs, rodataSh) // 2: .rodata
  shdrs = append(shdrs, dataSh)   // 3: .data
  shdrs = append(shdrs, bssSh)    // 4: .bss
  shdrs = append(shdrs, ElfShdr{ name: strtabNameOff, shtype: 3, // 5: SHT_STRTAB
    flags: 0, addr: 0, offset: strtabFileOff, size: len(st.strtab.bytes),
    link: 0, info: 0, addralign: 1, entsize: 0 })
  shdrs = append(shdrs, ElfShdr{ name: symtabNameOff, shtype: 2, // 6: SHT_SYMTAB
    flags: 0, addr: 0, offset: symtabFileOff, size: len(st.symtab.bytes),
    link: 5, // .strtab's section index
    info: st.nLocal + 1, // one past the last (and only) local symbol's index
    addralign: 8, entsize: sizeofElfSym() })
  shdrs = append(shdrs, ElfShdr{ name: shstrtabNameOff, shtype: 3, // 7: SHT_STRTAB
    flags: 0, addr: 0, offset: shstrtabFileOff, size: len(shstrtab.bytes),
    link: 0, info: 0, addralign: 1, entsize: 0 })
  assert(len(shdrs) == 8)
  let sh = 0
  while (sh < len(shdrs)) {
    appendElfShdr(tail, shdrs[sh])
    sh = sh + 1
  }
  return ElShTable{ bytes: tail.bytes, shoff: shoff }
}

// Links `inputs` into a standalone ELF executable.
fn linkElfExecutable(target: ElfLinkTarget, inputs: []ElfLinkInput): []u8! {
  let modules = elIngest(target, inputs)?

  // ABI.md §4: the merged GC stack-map table's bounds are linker-defined, so
  // the boundary symbols enter the link as a synthetic module. It goes in
  // BEFORE resolution so the runtime's extern references resolve like any other
  // global, and last so its index is stable.
  let markerModuleIdx = len(modules)
  modules = append(modules, markerModule(""))

  // ---- resolve + dead-strip ---------------------------------------------
  let globals = resolveGlobals(modules)?
  let kept = deadStrip(modules, globals,
    [elEntrySymbol(), stackmapsStartSymbol(), stackmapsEndSymbol(),
      debugLinesStartSymbol(), debugLinesEndSymbol()])?
  // ABI.md §4.2: unlike a GcMeta entry, a retained DbgMeta entry's own targets
  // (interned debug-only source-file strings) are not otherwise reachable —
  // pull them into `kept` before the elCollect calls below run their one pass
  // each, or they are silently never placed. See keepDebugLineTargets' own
  // comment.
  keepDebugLineTargets(modules, globals, kept, markerModuleIdx)?

  // `-fdata-sections` can emit ONE variable as several adjacent symbols in a
  // single section (std's TLS `area_desc` splits into area_desc.0/.1/...).
  // Dead-stripping the unreferenced pieces would repack the survivors and shift
  // the variable's fields, corrupting it. Keep every mutable-data atom (.data,
  // .bss, and the TLS init/bss) so their in-section layout is preserved; code
  // (.text) and read-only constants (.rodata) are still granularly stripped.
  let mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let k = atoms[ai].kind
      if (k == LoSectionKind.Data || k == LoSectionKind.Bss ||
          k == LoSectionKind.TlsData || k == LoSectionKind.TlsBss) {
        kept[atomKey(mi, ai)] = true
      }
      ai = ai + 1
    }
    mi = mi + 1
  }

  // ---- collect kept atoms, partitioned by output class -------------------
  let text = elCollect(modules, kept, LoSectionKind.Text)
  let rodata = elCollect(modules, kept, LoSectionKind.Rodata)
  let data = elCollect(modules, kept, LoSectionKind.Data)
  let bss = elCollect(modules, kept, LoSectionKind.Bss)
  let tdata = elCollect(modules, kept, LoSectionKind.TlsData)
  let tbss = elCollect(modules, kept, LoSectionKind.TlsBss)

  // ---- merged GC stack-map group (ABI.md §4) ----------------------------
  // Appended to `rodata` as one contiguous run: the entries are read-only, hold
  // absolute code pointers this non-PIE image never rebases, and must sit
  // between the two boundary markers with nothing interleaved. Appending last
  // means no later atom can land inside the extent.
  let gcGroup = mergedStackMapAtoms(modules, globals, kept, markerModuleIdx)?
  rodata = elAppendGroup(rodata, gcGroup)

  // ---- merged debug-info line table group (ABI.md §4.2) ------------------
  // Same shape as the GC stack-map group above, appended right after it as
  // its own contiguous run bounded by its OWN two markers — still .rodata:
  // this non-PIE image never rebases either table.
  let dbgGroup = mergedDebugLineAtoms(modules, globals, kept, markerModuleIdx)?
  rodata = elAppendGroup(rodata, dbgGroup)
  // TlsVars is a macOS tlv_descriptor section; ELF has no equivalent and
  // elfreader.bit never produces it.
  if (len(elCollect(modules, kept, LoSectionKind.TlsVars)) > 0) {
    fail newError("elf: tls_vars section in an ELF link")
  }

  // ---- lay out the two PT_LOAD segments ---------------------------------
  // The headers occupy the very start of the R-X segment and are loaded too, so
  // reserve their size before the first text atom. The phdr count is known up
  // front: 2 PT_LOAD + PT_GNU_STACK, plus PT_TLS iff there is any TLS.
  let hasTls = len(tdata) + len(tbss) > 0
  let phnum = 3
  if (hasTls) {
    phnum = 4
  }
  let headersSize = sizeofElfEhdr() + phnum * sizeofElfPhdr()

  let cursor = elLoadBase() + headersSize
  cursor = elPlaceAtoms(modules, text, cursor)
  let textEnd = cursor
  // The first kept .text atom's OWN vaddr, not the pre-alignment cursor above:
  // elPlaceAtoms aligns the first atom forward from that cursor (elLoadBase() +
  // headersSize is not generally 16-aligned), so the raw cursor undercounts
  // whenever that alignment padding is nonzero — the .text section header must
  // describe where the bytes actually landed.
  let textStart = textEnd
  if (len(text) > 0) {
    textStart = text[0].vaddr
  }
  cursor = elPlaceAtoms(modules, rodata, cursor)
  let rxEnd = cursor
  // Same reasoning as textStart: the first rodata/gc-stack-map atom's own vaddr,
  // not the pre-alignment cursor.
  let rodataStart = rxEnd
  if (len(rodata) > 0) {
    rodataStart = rodata[0].vaddr
  }

  // The R-W segment starts on a fresh page: GOT, data, TLS init image, bss.
  cursor = alignForward(cursor, elPage())
  let rwStart = cursor

  // GOT: one slot per distinct target of a GOT-relative relocation.
  let gotIndex = map<int, int>{}
  let gotTargets = []int(0)
  mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let (_, keep) = kept[atomKey(mi, ai)]
      if (keep) {
        let relocs = atoms[ai].relocs
        let r = 0
        while (r < len(relocs)) {
          if (needsGot(relocs[r].kind)) {
            let tgt = resolveRef(globals, mi, relocs[r].target)?
            let (_, seen) = gotIndex[tgt]
            if (!seen) {
              gotIndex[tgt] = len(gotTargets)
              gotTargets = append(gotTargets, tgt)
            }
          }
          r = r + 1
        }
      }
      ai = ai + 1
    }
    mi = mi + 1
  }
  let gotVaddr = cursor
  cursor = cursor + len(gotTargets) * elGotEntrySize()

  cursor = elPlaceAtoms(modules, data, cursor)

  let tls = elLayoutTls(modules, tdata, tbss, cursor)
  cursor = tls.vaddr + tls.filesz // only tdata occupies file bytes here

  // .bss and .tbss carry no file bytes. .tbss's memory is already accounted for
  // in tls.memsz; ordinary .bss is placed after the TLS init image.
  let rwFileEnd = cursor // the last vaddr backed by file bytes in R-W
  cursor = elPlaceAtoms(modules, bss, cursor) // extends memsz only
  let rwMemEnd = cursor

  // ---- address lookup for every placed atom ------------------------------
  let addrOf = map<int, int>{}
  let groups = [text, rodata, data, bss]
  let gi = 0
  while (gi < len(groups)) {
    let g = groups[gi]
    let i = 0
    while (i < len(g)) {
      addrOf[g[i].id] = g[i].vaddr
      i = i + 1
    }
    gi = gi + 1
  }
  // TLS atoms resolve to thread-pointer offsets, not vaddrs; keyed separately.
  let tpoffOf = map<int, int>{}
  let tgroups = [tdata, tbss]
  gi = 0
  while (gi < len(tgroups)) {
    let g = tgroups[gi]
    let i = 0
    while (i < len(g)) {
      tpoffOf[g[i].id] = elTpOffset(target, g[i].tlsOffset, tls)
      i = i + 1
    }
    gi = gi + 1
  }

  let (entryId, haveEntry) = globals[elEntrySymbol()]
  if (!haveEntry) {
    fail newError("elf: missing entry symbol ${elEntrySymbol()}")
  }
  let (entryVaddr, haveEntryAddr) = addrOf[entryId]
  if (!haveEntryAddr) {
    fail newError("elf: entry symbol ${elEntrySymbol()} was stripped")
  }

  // ---- apply relocations into per-atom mutable copies --------------------
  // An atom's own bytes are never mutated: two atoms can share a backing slice,
  // and only the patched copy reaches the file.
  let patched = map<int, []u8>{}
  mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let id = atomKey(mi, ai)
      let (_, keep) = kept[id]
      if (keep && len(atoms[ai].data) > 0) {
        let buf = []u8(0)
        let b = 0
        while (b < len(atoms[ai].data)) {
          buf = append(buf, atoms[ai].data[b])
          b = b + 1
        }
        // A TLS atom's own data is patched, but it is addressed by others via
        // tpoff, so it has no vaddr of its own here.
        let atomVaddr = 0
        let (av, hasAv) = addrOf[id]
        if (hasAv) {
          atomVaddr = av
        }
        let relocs = atoms[ai].relocs
        let r = 0
        while (r < len(relocs)) {
          let reloc = relocs[r]
          let tgt = resolveRef(globals, mi, reloc.target)?
          let v = noValues()
          v.p = atomVaddr + reloc.offset
          if (isTlsKind(reloc.kind)) {
            let (tp, hasTp) = tpoffOf[tgt]
            if (!hasTp) {
              fail newError("elf: undefined TLS symbol")
            }
            v.tpOffset = tp + reloc.addend
          } else if (needsGot(reloc.kind)) {
            let (slot, hasSlot) = gotIndex[tgt]
            if (!hasSlot) {
              fail newError("elf: GOT slot missing")
            }
            // The addend (-4 for REX_GOTPCRELX) is part of the PC-relative
            // arithmetic, exactly as for pc32; fold it into the GOT-slot address
            // the field resolves against.
            v.gotSlot = gotVaddr + slot * elGotEntrySize() + reloc.addend
          } else {
            let (ta, hasTa) = addrOf[tgt]
            if (!hasTa) {
              fail newError("elf: undefined symbol")
            }
            v.s = ta + reloc.addend
          }
          applyReloc(reloc.kind, buf, reloc.offset, v)?
          r = r + 1
        }
        patched[id] = buf
      }
      ai = ai + 1
    }
    mi = mi + 1
  }

  // ---- emit the image ----------------------------------------------------
  // File offset == vaddr - load_base for every byte-backed region.
  let fileSize = rwFileEnd - elLoadBase()
  let buf = []u8(fileSize)

  // Copy every byte-backed atom to (vaddr - load_base). BSS/TBSS have no bytes;
  // the TLS init bytes (tdata) do get written.
  let wgroups = [text, rodata, data, tdata]
  gi = 0
  while (gi < len(wgroups)) {
    let g = wgroups[gi]
    let i = 0
    while (i < len(g)) {
      let atom = modules[atomKeyModule(g[i].id)].atoms[atomKeyAtom(g[i].id)]
      let bytes = atom.data
      let (pb, hasPb) = patched[g[i].id]
      if (hasPb) {
        bytes = pb
      }
      let off = g[i].vaddr - elLoadBase()
      let b = 0
      while (b < len(bytes)) {
        buf[off + b] = bytes[b]
        b = b + 1
      }
      i = i + 1
    }
    gi = gi + 1
  }

  // GOT slots: each holds its target's absolute address.
  let gt = 0
  while (gt < len(gotTargets)) {
    let off = gotVaddr + gt * elGotEntrySize() - elLoadBase()
    let (addr, hasAddr) = addrOf[gotTargets[gt]]
    if (!hasAddr) {
      fail newError("elf: undefined GOT target")
    }
    loWrU64(buf, off, addr)
    gt = gt + 1
  }

  // .symtab/.strtab/.shstrtab (#3395): computed here, before Ehdr, since
  // e_shoff/e_shnum/e_shstrndx below depend on it. Every *Start/*End below is
  // already an exact boundary already used for the Phdrs themselves (rwStart,
  // rwFileEnd, rwMemEnd) or derived the same way textStart is (the first
  // placed atom's own vaddr) — see ElShLayout's own comment for why every
  // PT_LOAD-covered byte must be claimed.
  let symtabData = elBuildSymtab(modules, text)
  let shLayout = ElShLayout{
    textStart: textStart, textEnd: textEnd, textAlign: elMaxAlign(modules, text, 1),
    rodataStart: rodataStart, rodataEnd: rxEnd, rodataAlign: elMaxAlign(modules, rodata, 1),
    dataStart: rwStart, dataEnd: rwFileEnd, dataAlign: elMaxAlign(modules, data, 8),
    bssStart: rwFileEnd, bssEnd: rwMemEnd, bssAlign: elMaxAlign(modules, bss, 8),
  }
  let shTable = elBuildSectionTable(fileSize, shLayout, symtabData)

  // Ehdr.
  let hdr = newByteBuf()
  hdr.bytes = append(hdr.bytes, u8(127))
  appendBytes(hdr, []byte("ELF"))
  hdr.bytes = append(hdr.bytes, u8(2)) // EI_CLASS: ELFCLASS64
  hdr.bytes = append(hdr.bytes, u8(1)) // EI_DATA: ELFDATA2LSB
  hdr.bytes = append(hdr.bytes, u8(1)) // EI_VERSION
  hdr.bytes = append(hdr.bytes, u8(0)) // EI_OSABI: ELFOSABI_NONE
  appendZeros(hdr, 8)
  appendU16(hdr, 2) // e_type: ET_EXEC
  appendU16(hdr, elfMachine(elReaderTarget(target)))
  appendU32(hdr, 1)
  appendU64(hdr, entryVaddr)
  appendU64(hdr, sizeofElfEhdr()) // e_phoff: the phdrs follow the header
  appendU64(hdr, shTable.shoff)   // e_shoff
  appendU32(hdr, 0)
  appendU16(hdr, sizeofElfEhdr())
  appendU16(hdr, sizeofElfPhdr())
  appendU16(hdr, phnum)
  appendU16(hdr, sizeofElfShdr()) // e_shentsize
  appendU16(hdr, 8) // e_shnum: NULL, .text, .rodata, .data, .bss, .strtab, .symtab, .shstrtab
  appendU16(hdr, 7) // e_shstrndx: .shstrtab is shdrs[7]
  let h = 0
  while (h < len(hdr.bytes)) {
    buf[h] = hdr.bytes[h]
    h = h + 1
  }

  // Phdrs.
  let ph = newByteBuf()
  // R-X: headers + text + rodata, from load_base to rxEnd.
  appendElfPhdr(ph, ptLoad(), pfR() | pfX(), 0, elLoadBase(),
    rxEnd - elLoadBase(), rxEnd - elLoadBase(), elPage())
  // R-W: rwStart .. rwMemEnd (filesz stops at rwFileEnd; the rest is bss).
  appendElfPhdr(ph, ptLoad(), pfR() | pfW(), rwStart - elLoadBase(), rwStart,
    rwFileEnd - rwStart, rwMemEnd - rwStart, elPage())
  if (hasTls) {
    appendElfPhdr(ph, ptTls(), pfR(), tls.vaddr - elLoadBase(), tls.vaddr,
      tls.filesz, tls.memsz, tls.alignment)
  }
  // PT_GNU_STACK: a non-executable stack, no mapped bytes.
  appendElfPhdr(ph, ptGnuStack(), pfR() | pfW(), 0, 0, 0, 0, elPage())
  assert(len(ph.bytes) == phnum * sizeofElfPhdr())
  let p = 0
  while (p < len(ph.bytes)) {
    buf[sizeofElfEhdr() + p] = ph.bytes[p]
    p = p + 1
  }

  // shTable.bytes sits past fileSize, outside every PT_LOAD — never loaded,
  // never touched by the runtime.
  let img = ByteBuf{ bytes: buf }
  appendBytes(img, shTable.bytes)
  return img.bytes
}
