fn peWriterU32Max(): int { return 0xFFFFFFFF }

fn peWriterField(value: int): int! {
  return objectAdd(value, 0, peWriterU32Max())?
}

fn peWriteSectionOffset(cursor: int, alignment: int): int! {
  return peWriterField(objectAlign(cursor, alignment, objectByteLimit())?)?
}

fn peWriteDataEnd(offset: int, size: int): int! {
  peWriterField(offset)?
  peWriterField(size)?
  return objectAdd(offset, size, objectByteLimit())?
}

fn peWriteRelocEnd(cursor: int, count: int): int! {
  peWriterField(cursor)?
  let bytes = objectMul(pePhysicalRelocCount(count)?, sizeofPeReloc(), objectByteLimit())?
  return objectAdd(cursor, bytes, objectByteLimit())?
}

fn peWriteNameEnd(cursor: int, size: int): int! {
  return objectAdd(cursor, objectAdd(size, 1, peWriterU32Max())?, peWriterU32Max())?
}

fn peWriteStringLength(symbols: []PeSymbol): int! {
  let cursor = 4
  let i = 0
  while (i < len(symbols)) {
    let size = len(symbols[i].name)
    if (size > 8) {
      cursor = peWriteNameEnd(cursor, size)?
    }
    i = i + 1
  }
  return cursor
}

fn peWriteTableEnd(start: int, count: int, stringSize: int): int! {
  peWriterField(count)?
  peWriterField(stringSize)?
  if (count > 0) {
    peWriterField(start)?
  }
  let bytes = objectMul(count, sizeofPeSymbol(), objectByteLimit())?
  let end = objectAdd(start, bytes, objectByteLimit())?
  return objectAdd(end, stringSize, objectByteLimit())?
}
