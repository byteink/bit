// In-Bit self-checks for #4457's `Op.PollAttention`: the IR-level read of the
// safepoint attention word, through the frame slot emitPollCachePrefetch
// already filled. Split out of compiler/arm64selcheck.bit, which is 784 lines
// against the 800-line limit and cannot hold them — the same split
// compiler/arm64selcheckgen.bit (#3141) and compiler/arm64selcheckcmp.bit
// (#4349) already made. Same module as selfcheck.bit (#1503).
//
// Named to sort after compiler/arm64selcheckovf.bit — module files concatenate
// in bytewise filename order (compiler/project.bit:7).
//
// WHAT THESE PIN, AND WHY IT IS THE WHOLE POINT OF THE TICKET: that this op
// emits NO CALL. #4204's strip miner asked the same question with an
// `Op.Call` to bit_rt_port_sched_poll_attention_addr, and `bl` destroys every
// caller-saved register — which, with one location per interval, put a spill
// reload inside bench/cases/matrix's innermost loop. A relocation count of
// zero is the check that cannot be satisfied by a call, so it is asserted
// directly rather than inferred from the byte length.

// A frame carrying the one poll-address cache slot, which is this op's
// precondition. `numSpillSlots: 1` is deliberate and is the mutation this
// fixture exists to survive on the x64 side too: the offset must be derived
// from `pollCacheSlots`, not from "the allocator asked for a slot".
fn pollFrameArm64(): FrameInfo {
  return FrameInfo{
    savedGpr: []int(0), savedFpr: []int(0), numSpillSlots: 1,
    outgoingBytes: 16, pollCacheSlots: 1, frameSize: 64,
  }
}

fn checkArm64PollAttention() {
  // Two loads and nothing else. The destination is vreg 3, which selCtx gives
  // a register, so `putInt`'s closing move is a self-move and encodes nothing.
  let cx = selCtx()
  cx.frame = pollFrameArm64()
  emitPollAttention(cx, 3)
  let want = newByteBuf()
  let d = cx.intRegs[3]
  loadImm(want, d, regSp(), pollCacheOffset(cx.frame, 0), 8, false)
  // A PLAIN `ldr`, not the `ldar` emitPollGuard uses. This read only chooses a
  // strip size; the guard on the outer back edge re-reads the word with the
  // acquire that decides whether to ACT on it (codegen.bit's header there).
  loadImm(want, d, d, 0, 8, false)
  assertSameBytes(cx.code, want)
  assert(len(cx.code.bytes) == 8) // two instructions, both AArch64 fixed-width
  assert(len(cx.relocs) == 0)     // a `bl` cannot exist without one
  assert(len(cx.safepoints) == 0) // it neither allocates nor parks

  // A SPILLED destination computes in scratch1 and stores, and still calls
  // nothing. Pinned because the spilled arm is the one a strip-mined function
  // under register pressure actually takes.
  let cs = selCtx()
  cs.frame = pollFrameArm64()
  cs.result.locations[4] = RegLoc{ isSpill: true, index: 0 }
  emitPollAttention(cs, 4)
  let ws = newByteBuf()
  let sd = scratch1()
  loadImm(ws, sd, regSp(), pollCacheOffset(cs.frame, 0), 8, false)
  loadImm(ws, sd, sd, 0, 8, false)
  storeImm(ws, sd, regSp(), spillOffset(cs.frame, 0), 8)
  assertSameBytes(cs.code, ws)
  assert(len(cs.relocs) == 0)

  // The DISPATCH arm, driven through compileInstAddr rather than by calling
  // the emitter again: an op wired into no dispatch emits nothing at all, and
  // a fixture that only ever calls the emitter directly cannot tell that from
  // a correct one.
  let cd = selCtx()
  cd.frame = pollFrameArm64()
  cd.f.instrs[3] = mkInstr(Op.PollAttention, 0)
  assert(compileInstAddr(cd, 3, cd.f.instrs[3]))
  assertSameBytes(cd.code, want)
  assert(len(cd.relocs) == 0)
}
