// In-Bit self-checks for the ARM64 parallel-move sequentializer
// (sequentializeAndEmit, compiler/arm64ctx.bit): independent moves, a
// dependent chain, a mem<->mem 2-cycle (#1235), the float scratch pair, and
// a mixed-class call (#3182). Split out of compiler/arm64check.bit (#5643),
// which was at exactly 800 lines against E0200 with zero headroom; sibling
// .bit file, same module, so `selfcheck()` (compiler/selfcheck.bit) still
// calls `checkArm64Moves` directly, no import needed.

fn checkArm64Moves() {
  checkArm64MovesIndependent()
  checkArm64MovesDependentChain()
  checkArm64MovesMemCycle()
  checkArm64MovesFloatCycle()
  checkArm64MovesMixedClass()
}

fn checkArm64MovesIndependent() {
  // Independent moves emit as-is; a self-move is dropped entirely.
  let cx = testA64Ctx()
  sequentializeAndEmit(
    cx,
    [
      PMove{ src = plocReg(1, RegClass.Int), dst = plocReg(2, RegClass.Int) },
      PMove{ src = plocReg(3, RegClass.Int), dst = plocReg(3, RegClass.Int) },
    ],
  )
  assert(len(cx.code.bytes) == 4 && wordAt(cx.code, 0) == 0xaa0103e2) // mov x2, x1
}

fn checkArm64MovesDependentChain() {
  // A dependent chain must drain in reverse: x1->x2 has to happen BEFORE x0->x1
  // overwrites x1, no matter what order the moves arrive in.
  let cx = testA64Ctx()
  sequentializeAndEmit(
    cx,
    [
      PMove{ src = plocReg(0, RegClass.Int), dst = plocReg(1, RegClass.Int) },
      PMove{ src = plocReg(1, RegClass.Int), dst = plocReg(2, RegClass.Int) },
    ],
  )
  let want = newByteBuf()
  movRR(want, 2, 1)
  movRR(want, 1, 0)
  assertSameBytes(cx.code, want)
}

fn checkArm64MovesMemCycle() {
  // Regression (#1235): two spilled values swapping stack slots form a mem<->mem
  // 2-cycle. The cycle-break saves one slot's value in a scratch register held
  // across the whole rotation, so that register must differ from the one emitMove
  // uses as its own mem->mem copy temp (scratch1). Using scratch1 for both means
  // the first rotation step overwrites the saved value and the swap silently
  // corrupts — one loop-carried value takes another's. Byte-exact, so a revert to
  // scratch1 fails here and not only in an allocation-sensitive golden.
  let cx = testA64Ctx()
  sequentializeAndEmit(
    cx,
    [
      PMove{ src = plocMem(0, RegClass.Int), dst = plocMem(8, RegClass.Int) },
      PMove{ src = plocMem(8, RegClass.Int), dst = plocMem(0, RegClass.Int) },
    ],
  )
  let want = newByteBuf()
  loadImm(want, scratch2(), regSp(), 8, 8, false) // save start slot into x10 (NOT x9)
  loadImm(want, scratch1(), regSp(), 0, 8, false) // rotate the mem->mem move via x9
  storeImm(want, scratch1(), regSp(), 8, 8)
  storeImm(want, scratch2(), regSp(), 0, 8) // restore saved value from x10
  assertSameBytes(cx.code, want)
}

fn checkArm64MovesFloatCycle() {
  // The float cycle uses the float scratch pair, not the int one.
  let cx = testA64Ctx()
  sequentializeAndEmit(
    cx,
    [
      PMove{ src = plocReg(0, RegClass.Float), dst = plocReg(1, RegClass.Float) },
      PMove{ src = plocReg(1, RegClass.Float), dst = plocReg(0, RegClass.Float) },
    ],
  )
  let want = newByteBuf()
  fmovFF(want, fscratch2(), 1, 8)
  fmovFF(want, 1, 0, 8)
  fmovFF(want, 0, fscratch2(), 8)
  assertSameBytes(cx.code, want)
}

fn checkArm64MovesMixedClass() {
  // #3182: a single call carrying BOTH classes at once must produce the exact
  // same bytes as the two independent one-class calls above interleaved in
  // call order — merging must not perturb same-class ordering or scratch
  // choice. Concatenates the dependent-int-chain case with the float-cycle
  // case into one movesIn list.
  let cx = testA64Ctx()
  sequentializeAndEmit(
    cx,
    [
      PMove{ src = plocReg(0, RegClass.Int), dst = plocReg(1, RegClass.Int) },
      PMove{ src = plocReg(1, RegClass.Int), dst = plocReg(2, RegClass.Int) },
      PMove{ src = plocReg(0, RegClass.Float), dst = plocReg(1, RegClass.Float) },
      PMove{ src = plocReg(1, RegClass.Float), dst = plocReg(0, RegClass.Float) },
    ],
  )
  let want = newByteBuf()
  movRR(want, 2, 1)
  movRR(want, 1, 0)
  fmovFF(want, fscratch2(), 1, 8)
  fmovFF(want, 1, 0, 8)
  fmovFF(want, 0, fscratch2(), 8)
  assertSameBytes(cx.code, want)
}
