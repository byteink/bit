// Self-host Stage 3 (#1343): Mach-O64 relocatable object writer. Consumed by
// the static linker (#1344), which turns
// .o files plus libbitrt.a into a standalone executable.
//
// Deliberately decoupled from the backends: this file knows nothing of the IR,
// physical registers, or instruction encoding. Its types carry a `Macho` prefix
// because selfhost is one flat namespace and names like Section/Symbol/Object
// are far too generic to claim (the seed gets one module per object format).
//
// Emits the smallest layout `ld` accepts, not the layout `as` happens to
// produce: one LC_SEGMENT_64 (Mach-O's MH_OBJECT convention — every section
// lives in one nameless segment) plus one LC_SYMTAB. No LC_DYSYMTAB, no
// LC_BUILD_VERSION, no chained fixups (LC_DYLD_CHAINED_FIXUPS is an
// MH_EXECUTE/MH_DYLIB concept — never valid on a relocatable object). The seed
// verified empirically that an object carrying only those two load commands
// relinks clean via `ld -r` and links+runs via clang.
//
// Structure layouts and constants come from the Xcode SDK's <mach-o/loader.h>,
// <mach-o/nlist.h>, <mach-o/reloc.h>, <mach-o/x86_64/reloc.h>,
// <mach-o/arm64/reloc.h>, cross-checked byte-for-byte against as/otool output.
//

enum MachoTarget {
  X86_64,
  Aarch64,
}

fn machoCpuType(t: MachoTarget): int {
  if (t == MachoTarget.X86_64) {
    return 0x01000007 // CPU_TYPE_X86_64 (CPU_TYPE_X86 | CPU_ARCH_ABI64)
  }
  return 0x0100000C // CPU_TYPE_ARM64 (CPU_TYPE_ARM | CPU_ARCH_ABI64)
}

fn machoCpuSubtype(t: MachoTarget): int {
  if (t == MachoTarget.X86_64) {
    return 3 // CPU_SUBTYPE_X86_64_ALL
  }
  return 0 // CPU_SUBTYPE_ARM64_ALL
}

enum MachoSectionKind {
  Text,
  Data,
  Rodata,
  Bss,
  GcMeta,
  // Debug-info line table (runtime/ABI.md §4.2, #3281/#3283) — a second,
  // independent side table shaped exactly like GcMeta above (own extent
  // symbols, own per-function local atoms), never merged with it.
  DbgMeta,
}

fn machoNumKinds(): int {
  return 6
}

// Bit has no enum-to-ordinal cast, and every by-kind lookup below is an array
// index — so the mapping is spelled out both ways.
fn machoKindIndex(k: MachoSectionKind): int {
  if (k == MachoSectionKind.Text) {
    return 0
  }
  if (k == MachoSectionKind.Data) {
    return 1
  }
  if (k == MachoSectionKind.Rodata) {
    return 2
  }
  if (k == MachoSectionKind.Bss) {
    return 3
  }
  if (k == MachoSectionKind.GcMeta) {
    return 4
  }
  return 5 // DbgMeta
}

// Fixed emission order, spelled out explicitly so reordering MachoSectionKind's
// declaration can never silently reorder the file layout.
fn machoCanonicalOrder(): []MachoSectionKind {
  return [
    MachoSectionKind.Text, MachoSectionKind.Data, MachoSectionKind.Rodata,
    MachoSectionKind.Bss, MachoSectionKind.GcMeta, MachoSectionKind.DbgMeta,
  ]
}

fn machoSegmentName(k: MachoSectionKind): string {
  if (k == MachoSectionKind.Text || k == MachoSectionKind.Rodata) {
    return "__TEXT"
  }
  return "__DATA" // data, bss, gc_meta, dbg_meta
}

fn machoSectionName(k: MachoSectionKind): string {
  if (k == MachoSectionKind.Text) {
    return "__text"
  }
  if (k == MachoSectionKind.Data) {
    return "__data"
  }
  if (k == MachoSectionKind.Rodata) {
    return "__const"
  }
  if (k == MachoSectionKind.Bss) {
    return "__bss"
  }
  if (k == MachoSectionKind.GcMeta) {
    return "__bit_gc"
  }
  return "__bit_dbg" // DbgMeta
}

// Bss is the only kind with no file bytes (a Mach-O S_ZEROFILL section).
fn machoIsZerofill(k: MachoSectionKind): bool {
  return k == MachoSectionKind.Bss
}

fn machoSectionFlags(k: MachoSectionKind): int {
  if (k == MachoSectionKind.Text) {
    // S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    return 0x80000400
  }
  if (k == MachoSectionKind.Bss) {
    return 0x1 // S_ZEROFILL
  }
  return 0x0 // S_REGULAR: data, rodata, gc_meta, dbg_meta
}

// One section's content. Bss carries `size` and no data.
class MachoSection {
  kind: MachoSectionKind,
  data: []u8,
  size: int,
  // 0 or a power of two; 0 means "no constraint" and is normalized to 1.
  alignment: int,
}

fn machoSectionBytes(s: MachoSection): int {
  if (s.kind == MachoSectionKind.Bss) {
    return s.size
  }
  return len(s.data)
}

enum MachoBinding {
  Local,
  Global,
}

// `hasSection == false` names an external symbol (a runtime bit_rt_* export, or
// another Bit module's function) that the linker must resolve — it carries no
// offset and must be Global: nothing else can ever define an undefined local.
class MachoSymbol {
  name: string,
  hasSection: bool,
  section: MachoSectionKind,
  offset: int,
  size: int,
  binding: MachoBinding,
}

// Mirrors codegen.bit's Reloc (offset + symbol) plus the architecture-specific
// "how the field's bytes are interpreted" the object writer needs. Mach-O gives
// every target an equivalent encoding for all four kinds, so one enum covers
// both architectures.
enum MachoRelocKind {
  // PC-relative call/branch operand: x86-64 CALL rel32's 4-byte immediate, or
  // ARM64 BL's 26-bit immediate packed into its 4-byte instruction word.
  Branch,
  // Absolute pointer-sized reference, e.g. a __bit_gc TypeInfo pointer into
  // __const.
  Unsigned64,
  // ARM64 ADRP page-of-symbol immediate (ARM64_RELOC_PAGE21) — the high half of
  // an address-of sequence (a const_string's __bitstr_N).
  Page21,
  // ARM64 ADD/LDR low-12-bits immediate (ARM64_RELOC_PAGEOFF12) — the low half.
  Pageoff12,
}

fn machoRelocWidth(k: MachoRelocKind): int {
  if (k == MachoRelocKind.Unsigned64) {
    return 8
  }
  return 4
}

fn machoRelocPcrel(k: MachoRelocKind): bool {
  return k == MachoRelocKind.Branch || k == MachoRelocKind.Page21
}

fn machoRelocLength(k: MachoRelocKind): int {
  if (k == MachoRelocKind.Unsigned64) {
    return 3 // 8 bytes
  }
  return 2 // 4 bytes
}

// Mach-O relocation type ordinal. X86_64_RELOC_BRANCH and ARM64_RELOC_BRANCH26
// are both 2; X86_64_RELOC_UNSIGNED and ARM64_RELOC_UNSIGNED are both 0 —
// spelled out per-target anyway (not collapsed to one constant) so a future
// third target with a different ordinal is a one-line change, not a hidden
// assumption. Page21/Pageoff12 are AArch64-only (x86-64 materializes a symbol
// address as an absolute Unsigned64, never a PC-relative pair).
fn machoRelocType(k: MachoRelocKind, t: MachoTarget): int {
  if (t == MachoTarget.X86_64) {
    if (k == MachoRelocKind.Branch) {
      return 2
    }                                      // X86_64_RELOC_BRANCH
    assert(k == MachoRelocKind.Unsigned64) // page21/pageoff12 are AArch64-only
    return 0                               // X86_64_RELOC_UNSIGNED
  }
  if (k == MachoRelocKind.Branch) {
    return 2
  } // ARM64_RELOC_BRANCH26
  if (k == MachoRelocKind.Unsigned64) {
    return 0
  } // ARM64_RELOC_UNSIGNED
  if (k == MachoRelocKind.Page21) {
    return 3
  }        // ARM64_RELOC_PAGE21
  return 4 // ARM64_RELOC_PAGEOFF12
}

class MachoRelocation {
  section: MachoSectionKind,
  offset: int,
  symbol: string,
  kind: MachoRelocKind,
}

class MachoObject {
  sections: []MachoSection,
  symbols: []MachoSymbol,
  relocations: []MachoRelocation,
}

// ---- on-disk constants (<mach-o/loader.h>, <mach-o/nlist.h>) --------------

fn mhMagic64(): int { return 0xfeedfacf }
fn mhObject(): int { return 0x1 }
fn lcSegment64(): int { return 0x19 }
fn lcSymtab(): int { return 0x2 }
fn vmProtAll(): int { return 0x7 } // READ | WRITE | EXECUTE
fn nUndf(): int { return 0x0 }
fn nSect(): int { return 0xe }
fn nExt(): int { return 0x01 }

// Structure sizes, from the SDK's field layouts.
fn sizeofMachHeader64(): int { return 32 }
fn sizeofSegmentCommand64(): int { return 72 }
fn sizeofSection64(): int { return 80 }
fn sizeofSymtabCommand(): int { return 24 }
fn sizeofNlist64(): int { return 16 }

// ---- byte emission --------------------------------------------------------

fn appendBytes(out: ByteBuf, data: []u8) {
  let i = 0
  while (i < len(data)) {
    out.bytes = append(out.bytes, data[i])
    i = i + 1
  }
}

fn appendZeros(out: ByteBuf, n: int) {
  let i = 0
  while (i < n) {
    out.bytes = append(out.bytes, u8(0))
    i = i + 1
  }
}

// A 16-byte NUL-padded section/segment name.
fn appendName16(out: ByteBuf, s: string) {
  assert(len(s) <= 16)
  let b = []byte(s)
  appendBytes(out, b)
  appendZeros(out, 16 - len(b))
}

fn padTo(out: ByteBuf, alignment: int) {
  let rem = len(out.bytes) % alignment
  if (rem != 0) {
    appendZeros(out, alignment - rem)
  }
}

fn alignForward(v: int, alignment: int): int {
  let rem = v % alignment
  if (rem == 0) {
    return v
  }
  return v + alignment - rem
}

fn isPowerOfTwo(v: int): bool {
  return v > 0 && (v & (v - 1)) == 0
}

fn log2Int(v: int): int {
  let n = 0
  let x = v
  while (x > 1) {
    x = x >> 1
    n = n + 1
  }
  return n
}

// r_symbolnum:24, r_pcrel:1, r_length:2, r_extern:1, r_type:4 packed LSB-first —
// the bit order the SDK headers document for the C bitfield.
fn machoRelocInfo(symbolnum: int, pcrel: bool, length: int, isExtern: bool, rtype: int): int {
  let info = symbolnum
  if (pcrel) {
    info = info | (1 << 24)
  }
  info = info | (length << 25)
  if (isExtern) {
    info = info | (1 << 27)
  }
  return info | (rtype << 28)
}

// Appends a NUL-terminated string to a string table, returning its byte offset.
// `buf` must already carry the leading NUL (offset 0 is the empty string,
// matching every Mach-O string table as/ld produce).
fn machoInternString(buf: ByteBuf, s: string): int {
  let off = len(buf.bytes)
  appendBytes(buf, []byte(s))
  buf.bytes = append(buf.bytes, u8(0))
  return off
}

// ---- the writer -----------------------------------------------------------

// Emits a complete Mach-O64 MH_OBJECT for `obj`, targeting the given
// architecture.
fn writeMacho(target: MachoTarget, obj: MachoObject): []u8! {
  machoWriteCounts(obj)?
  let n = machoNumKinds()
  let hasKind = []bool(n)
  let sectionOf = []MachoSection(n)
  machoWriteSectionsValid(obj, hasKind, sectionOf)?
  machoWriteSymbolsValid(obj, hasKind, sectionOf)?
  let symIdxOf = map<string, int>{}
  machoWriteSymbolIndex(obj, symIdxOf)?
  let relocBuckets = []MachoRelocList(0)
  let i = 0
  while (i < n) {
    relocBuckets = append(relocBuckets, MachoRelocList{ list = []MachoRelocation(0) })
    i = i + 1
  }
  machoWriteRelocsValid(obj, hasKind, sectionOf, symIdxOf, relocBuckets)?
  let present = []MachoSectionKind(0)
  let order = machoCanonicalOrder()
  i = 0
  while (i < len(order)) {
    if (hasKind[machoKindIndex(order[i])]) {
      present = append(present, order[i])
    }
    i = i + 1
  }
  let segCmdSize = sizeofSegmentCommand64() + len(present) * sizeofSection64()
  let sizeofcmds = segCmdSize + sizeofSymtabCommand()
  let cmdsEnd = sizeofMachHeader64() + sizeofcmds
  let out = newByteBuf()
  appendZeros(out, cmdsEnd)
  let hdrs = []MachoSecHdr(0)
  let addrOf = []int(n)
  let ordinalOf = []int(n)
  let addrCursor = 0
  let segFileoff = 0
  let segFileoffSet = false
  let filesize = 0
  i = 0
  while (i < len(present)) {
    let kind = present[i]
    let idx = machoKindIndex(kind)
    let sec = sectionOf[idx]
    let alignment = sec.alignment
    if (alignment == 0) {
      alignment = 1
    }
    addrCursor = alignForward(addrCursor, alignment)
    addrOf[idx] = addrCursor
    ordinalOf[idx] = i + 1 // section ordinals are 1-based
    addrCursor = addrCursor + machoSectionBytes(sec)
    let h = machoWriteSection(out, sec, alignment, addrOf[idx], len(relocBuckets[idx].list))
    if (!machoIsZerofill(kind)) {
      if (!segFileoffSet) {
        segFileoff = h.offset
        segFileoffSet = true
      }
      filesize = len(out.bytes) - segFileoff
    }
    hdrs = append(hdrs, h)
    i = i + 1
  }
  machoWriteRelocs(target, out, present, relocBuckets, (hdrs, symIdxOf))
  let strtab = newByteBuf()
  strtab.bytes = append(strtab.bytes, u8(0)) // offset 0 == empty string
  let nameOffs = []int(0)
  i = 0
  while (i < len(obj.symbols)) {
    nameOffs = append(nameOffs, machoInternString(strtab, obj.symbols[i].name))
    i = i + 1
  }
  padTo(out, 8)
  let symoff = len(out.bytes)
  machoWriteSymbols(out, obj, nameOffs, ordinalOf, addrOf)
  let stroff = len(out.bytes)
  appendBytes(out, strtab.bytes)
  let vm = (addrCursor, segFileoff, filesize, sizeofcmds, segCmdSize, cmdsEnd)
  let sy = (symoff, stroff, len(strtab.bytes), len(obj.symbols))
  machoWriteHeader(target, out, hdrs, vm, sy)
  return out.bytes
}

// A zerofill section contributes no file bytes, so its header's `offset` stays 0.
class MachoSecHdr {
  kind: MachoSectionKind,
  addr: int,
  size: int,
  offset: int,
  align: int,
  reloff: int,
  nreloc: int,
}

// Bit has no slice-of-slice literal, so the per-section relocation buckets need
// a named wrapper.
class MachoRelocList {
  list: []MachoRelocation,
}
