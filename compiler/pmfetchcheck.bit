// In-Bit self-checks for compiler/pmfetch.bit's dependency-spec GRAMMAR
// (#1733; narrowed to this by #2968's split, spec/LINT.md §4). Sibling of
// pmfetch.bit (same module). Run by `selfcheck()` under `./make test` via
// `checkPmfetch()` below, which also drives the fetch/cache/vanity checks
// that now live in the sibling `pmfetchresolvecheck.bit` — a failed `assert`
// anywhere in that call chain panics with exit 2, so a regression in either
// file fails the build the same way. Every check here is a pure function
// over a literal dependency-spec string: no network, no subprocess, no
// scratch directory — those live in `pmfetchresolvecheck.bit`.

// `parseSpec` accepts a well-formed spec and rejects every malformed shape
// SPEC §17.7 names: no `@ref`, wrong segment count, a `..` segment.
fn checkPmfetchParseSpec() {
  let good = parseSpec("github.com/byteink/quicwire@v1.4.2") catch e {
    panic("pmfetchcheck: parseSpec rejected a valid spec: " + e.message())
    DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" }
  }
  assert(good.host == "github.com")
  assert(good.owner == "byteink")
  assert(good.repo == "quicwire")
  assert(good.ref == "v1.4.2")

  let noRef = parseSpec("github.com/byteink/quicwire") catch e { DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" } }
  assert(len(noRef.host) == 0)

  let tooFewParts = parseSpec("github.com/byteink@main") catch e { DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" } }
  assert(len(tooFewParts.host) == 0)

  let traversal = parseSpec("github.com/../etc@main") catch e { DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" } }
  assert(len(traversal.host) == 0)
}

// #2068 acceptance: `github.com/owner/repo@v1.2.3` must still derive
// `https://github.com/owner/repo.git`, proving the known-host path is
// untouched by vanity resolution — `parseSpec` classifies it `vanity: false`
// and `defaultDepUrl` is pure string concatenation over the parsed segments,
// so there is no code path here through which an HTTP fetch could even be
// reached (`resolveVanityUrl`/`get` are simply never called for a known
// host).
fn checkPmfetchKnownHostDirect() {
  let d = parseSpec("github.com/owner/repo@v1.2.3") catch e {
    panic("pmfetchcheck: parseSpec rejected a known-host spec: " + e.message())
    DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" }
  }
  assert(!d.vanity)
  assert(d.host == "github.com")
  assert(d.owner == "owner")
  assert(d.repo == "repo")
  assert(len(d.vanityName) == 0)
  assert(defaultDepUrl(d.host, d.owner, d.repo) == "https://github.com/owner/repo.git")
}

// #2068: SPEC §17.7's host-based rule is decided on the FIRST path segment
// only, never on segment count — `bitlang.org/pkg/http` is exactly 3
// segments (the same shape as `gitHost/owner/repo`) and must still parse as
// vanity, and a name with MORE than 3 segments must parse just as well (no
// subpaths rule notwithstanding — that is about resolution, not parsing).
fn checkPmfetchParseSpecVanity() {
  let d = parseSpec("bitlang.org/pkg/http@v2.0.1") catch e {
    panic("pmfetchcheck: parseSpec rejected a vanity spec: " + e.message())
    DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" }
  }
  assert(d.vanity)
  assert(len(d.host) == 0)
  assert(len(d.owner) == 0)
  assert(len(d.repo) == 0)
  assert(d.vanityName == "bitlang.org/pkg/http")
  assert(d.ref == "v2.0.1")

  let deeper = parseSpec("bitlang.org/pkg/http/client@main") catch e {
    panic("pmfetchcheck: parseSpec rejected a >3-segment vanity spec: " + e.message())
    DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" }
  }
  assert(deeper.vanity)
  assert(deeper.vanityName == "bitlang.org/pkg/http/client")

  // A traversal segment inside a vanity path is still rejected the same way
  // it is for a direct spec's owner/repo.
  let traversal = parseSpec("bitlang.org/pkg/../etc@main") catch e { DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "" } }
  assert(!traversal.vanity)
  assert(len(traversal.vanityName) == 0)
}

fn pmDeadSpec(): DepSpec {
  return DepSpec{ vanity: false, host: "", owner: "", repo: "", vanityName: "", ref: "", scheme: "", localPath: "", sshUser: "" }
}

// #2244: a GitLab-style nested-group spec (more than one segment between a
// KNOWN git host and the repo) parses as a direct (non-vanity) spec, with
// `owner` holding every middle segment rejoined by "/" — and the URL it
// derives is exactly the nested-group clone URL GitLab itself expects.
fn checkPmfetchParseSpecNestedGroup() {
  let d = parseSpec("gitlab.com/group/subgroup/repo@v1.0.0") catch e {
    panic("pmfetchcheck: parseSpec rejected a nested-group spec: " + e.message())
    pmDeadSpec()
  }
  assert(!d.vanity)
  assert(d.host == "gitlab.com")
  assert(d.owner == "group/subgroup")
  assert(d.repo == "repo")
  assert(d.ref == "v1.0.0")
  assert(defaultDepUrl(d.host, d.owner, d.repo) == "https://gitlab.com/group/subgroup/repo.git")

  // Three levels of subgroup nests just as well — no fixed depth limit.
  let deeper = parseSpec("gitlab.com/g1/g2/g3/repo@main") catch e {
    panic("pmfetchcheck: parseSpec rejected a 3-deep nested-group spec: " + e.message())
    pmDeadSpec()
  }
  assert(deeper.owner == "g1/g2/g3")
  assert(deeper.repo == "repo")

  // A traversal segment smuggled into a nested owner path is still rejected
  // per-segment, exactly like the flat 3-segment case.
  let traversal = parseSpec("gitlab.com/group/../repo@main") catch e { pmDeadSpec() }
  assert(len(traversal.host) == 0)
}

// #2244: an explicit `ssh://[user@]host/owner/repo@ref` spec parses to the
// same host/owner/repo shape a direct https spec has, `sshUser` capturing
// the `user@` portion, and `sshDepUrl` reconstructs the exact URL `git`
// fetches from and `bit.lock` records.
fn checkPmfetchParseSpecSsh() {
  let d = parseSpec("ssh://git@example.internal/owner/repo@v1") catch e {
    panic("pmfetchcheck: parseSpec rejected an ssh spec: " + e.message())
    pmDeadSpec()
  }
  assert(!d.vanity)
  assert(d.scheme == "ssh")
  assert(d.sshUser == "git")
  assert(d.host == "example.internal")
  assert(d.owner == "owner")
  assert(d.repo == "repo")
  assert(d.ref == "v1")
  assert(sshDepUrl(d.sshUser, d.host, d.owner, d.repo) == "ssh://git@example.internal/owner/repo")

  // No user@ portion at all — anonymous, ssh config decides the user.
  let noUser = parseSpec("ssh://example.internal/owner/repo@v1") catch e {
    panic("pmfetchcheck: parseSpec rejected a user-less ssh spec: " + e.message())
    pmDeadSpec()
  }
  assert(len(noUser.sshUser) == 0)
  assert(noUser.host == "example.internal")
  assert(sshDepUrl(noUser.sshUser, noUser.host, noUser.owner, noUser.repo) == "ssh://example.internal/owner/repo")

  // A nested-group owner works over ssh exactly as it does over https.
  let nested = parseSpec("ssh://git@example.internal/group/subgroup/repo@v1") catch e {
    panic("pmfetchcheck: parseSpec rejected a nested-group ssh spec: " + e.message())
    pmDeadSpec()
  }
  assert(nested.owner == "group/subgroup")

  // No @ref at all: `parseSpec` (unlike `parseAddSpec`, pmcli.bit) never
  // defaults to HEAD — this is a hard parse failure, consistent with the
  // non-ssh form.
  let noRef = parseSpec("ssh://git@example.internal/owner/repo") catch e { pmDeadSpec() }
  assert(len(noRef.host) == 0)
}

// #2244 SECURITY: an ssh dependency spec must not be able to inject an
// argument into the `git`/`ssh` invocation it drives — the class of bug
// CVE-2017-1000117 patched in `git` itself (a hostname/path segment
// beginning with `-`, read by `ssh` as an option rather than a hostname,
// e.g. `-oProxyCommand=...`). `validateSegment` (pmfetch.bit) rejects a
// leading `-` on every segment (host, user, owner, repo) regardless of the
// installed `git`/`ssh` version's own patch level.
fn checkPmfetchSshInjectionRejected() {
  // A malicious "user" segment: charset-legal (letters only) but for the
  // leading '-', isolating `validateSegment`'s dash check from the ALSO
  // rejected '='/'/' characters a real `-oProxyCommand=...;payload` string
  // would additionally carry.
  let userInjection = parseSpec("ssh://-oProxyCommand@evil.example/owner/repo@main") catch e { pmDeadSpec() }
  assert(len(userInjection.host) == 0)

  // A malicious "host" segment (no user given).
  let hostInjection = parseSpec("ssh://-oProxyCommand/owner/repo@main") catch e { pmDeadSpec() }
  assert(len(hostInjection.host) == 0)

  // A malicious "owner" segment, deeper in a nested-group path.
  let ownerInjection = parseSpec("ssh://git@example.internal/-oProxyCommand/repo@main") catch e { pmDeadSpec() }
  assert(len(ownerInjection.host) == 0)

  // The scp-like "user@host:owner/repo" shorthand is refused OUTRIGHT, at
  // parse time, never silently reinterpreted as anything else: neither
  // `isLocalSpecPrefix` nor `hasPrefix(spec, "ssh://")` recognizes it, so it
  // falls to the generic direct/vanity parser, whose very first step
  // (`validateSegment` on the leading path segment) rejects the embedded "@"
  // and ":" characters outright — there is no path through which this
  // shorthand is quietly treated as a vanity name or any other form.
  // Documented in `parseSshSpec`'s own comment: the unambiguous "ssh://"
  // scheme is required, deny by default.
  let scpLike = parseSpec("git@github.com:byteink/quicwire@v1") catch e { pmDeadSpec() }
  assert(!scpLike.vanity)
  assert(len(scpLike.host) == 0)
  assert(len(scpLike.vanityName) == 0)
}

// #2244 SECURITY: a plain leading `-` (the injection shape above) is
// rejected on the DIRECT https form too, not just ssh — `validateSegment`'s
// fix is unconditional, so this is the same guard exercised from the other
// caller.
fn checkPmfetchLeadingDashRejected() {
  let d = parseSpec("github.com/-oProxyCommand/repo@main") catch e { pmDeadSpec() }
  assert(len(d.host) == 0)
}

// #2244: a bare filesystem path ("/abs", "./rel", "../rel") and a
// "file://" URL both parse to `scheme == "local"`, carry no ref at all
// (an "@" inside the path is part of the path, never a ref separator), and
// an "@" inside a bare-path spec never gets misread as a ref boundary.
fn checkPmfetchParseSpecLocal() {
  let rel = parseSpec("../textutil") catch e {
    panic("pmfetchcheck: parseSpec rejected a relative local path: " + e.message())
    pmDeadSpec()
  }
  assert(rel.scheme == "local")
  assert(rel.localPath == "../textutil")
  assert(len(rel.ref) == 0)
  assert(!rel.vanity)

  let dotRel = parseSpec("./sibling/textutil") catch e {
    panic("pmfetchcheck: parseSpec rejected a './' local path: " + e.message())
    pmDeadSpec()
  }
  assert(dotRel.scheme == "local")
  assert(dotRel.localPath == "./sibling/textutil")

  let abs = parseSpec("/var/tmp/textutil") catch e {
    panic("pmfetchcheck: parseSpec rejected an absolute local path: " + e.message())
    pmDeadSpec()
  }
  assert(abs.scheme == "local")
  assert(abs.localPath == "/var/tmp/textutil")

  let fileUrl = parseSpec("file:///var/tmp/textutil") catch e {
    panic("pmfetchcheck: parseSpec rejected a file:// URL: " + e.message())
    pmDeadSpec()
  }
  assert(fileUrl.scheme == "local")
  assert(fileUrl.localPath == "/var/tmp/textutil")

  // An "@" inside the path is part of the path, not a ref separator — a
  // directory literally named "textutil@v2" is a legal (if unusual) POSIX
  // name and must not be split.
  let atInName = parseSpec("../textutil@v2") catch e {
    panic("pmfetchcheck: parseSpec rejected a local path containing '@': " + e.message())
    pmDeadSpec()
  }
  assert(atInName.localPath == "../textutil@v2")
}

// #2244 SECURITY: "file://" is only well-defined for an ABSOLUTE path — a
// relative remainder is refused outright rather than silently anchored to
// the process's cwd, and a ".." segment inside a path that claims to be
// absolute is refused too (an absolute target never legitimately needs
// one — see `checkNoDotDotSegment`'s own comment for why this is the
// "must not point outside the intended tree" check named on #2244).
fn checkPmfetchFileUrlTraversalRejected() {
  // No leading "/" after "file://" at all — an ambiguous relative path.
  let relative = parseSpec("file://../../../etc/passwd") catch e { pmDeadSpec() }
  assert(len(relative.localPath) == 0)
  assert(relative.scheme != "local")

  let relative2 = parseSpec("file://etc/passwd") catch e { pmDeadSpec() }
  assert(relative2.scheme != "local")

  // Absolute, but with a ".." segment inside it.
  let dotdot = parseSpec("file:///var/tmp/proj/../../../etc/passwd") catch e { pmDeadSpec() }
  assert(dotdot.scheme != "local")

  // A genuinely clean absolute path is unaffected.
  let clean = parseSpec("file:///var/tmp/proj/textutil") catch e {
    panic("pmfetchcheck: parseSpec rejected a clean absolute file:// URL: " + e.message())
    pmDeadSpec()
  }
  assert(clean.scheme == "local")
  assert(clean.localPath == "/var/tmp/proj/textutil")

  // The explicitly-relative bare forms are UNAFFECTED by this check — ".."
  // is their entire legitimate point (the sibling-directory case, #2244's
  // own motivating scenario) and must keep working.
  let sibling = parseSpec("../../siblings/textutil") catch e {
    panic("pmfetchcheck: parseSpec rejected a legitimate '../' local path: " + e.message())
    pmDeadSpec()
  }
  assert(sibling.scheme == "local")
  assert(sibling.localPath == "../../siblings/textutil")
}

fn checkPmfetch() {
  checkPmfetchParseSpec()
  checkPmfetchKnownHostDirect()
  checkPmfetchParseSpecVanity()
  checkPmfetchParseSpecNestedGroup()
  checkPmfetchParseSpecSsh()
  checkPmfetchSshInjectionRejected()
  checkPmfetchLeadingDashRejected()
  checkPmfetchParseSpecLocal()
  checkPmfetchFileUrlTraversalRejected()
  checkPmfetchVanityDocResolves()
  checkPmfetchVanityRequestUrlOverride()
  checkPmfetchVanityTransportRules()
  checkPmfetchResolvedUrlConflict()
  checkPmfetchFetchAndCacheHit()
  checkPmfetchNoSuchRefMessage()
  checkPmfetchIntegrityMismatch()
  checkPmfetchAnnotatedTag()
  checkPmfetchTimeout()
  checkPmfetchFailedFetchLeavesNoDirectory()
  checkPmfetchIntegrityErrorNamesCleanup()
}
