// compiler/x64mulpull.bit — #7183: brings a `umulhi` and the `mul` of the
// same product together before register allocation, so #7181's pairing
// (`xComputeMulPairs`, x64selectarith.bit) selects them as ONE `mul`. Sibling
// .bit file, same module: nothing here is imported.
//
// field25519's `(umulHi(a, b) << 13) | ((a * b) >> 51)` lowers to umulhi,
// const, shl, mul: the shift sits between the halves, and the pairing's
// liveness argument holds only for adjacent ones. Both halves are pure and
// read only `a` and `b`, which are defined before the first, so the second
// can be computed right after the first instead: `rebuild`'s `pull`
// (optrebuild.bit) emits it there. The pairing itself is untouched and
// re-decides on the moved IR.
//
// The move stretches the second result's live range back over the gap. A gap
// holding a call, safepoint or `asm`/`syscall` clobber is never crossed: the
// result would need a callee-saved register or a slot to survive it. Neither
// is a block boundary: the partner is looked for in the first's block only.
// Nor is a gap holding another product: a column of products summed before
// their high words is where pulled results stack up live at once. Unrestricted,
// fe25519MulCore (stdlib/crypto/field25519.bit) went from 29 `imul` to 4 but
// its frame from 0x90 to 0x150 bytes and its frame stores from 25 to 61.

// One function's walk: what `xMulPairable` reads, and the claims so far in
// `rebuild`'s `pull` form.
class XPullWalk {
  ctx: TypeContext,
  f: IrFunc,
  debug: bool,
  pull: []int,
}

// `f`, its non-adjacent pairs moved together; `f` itself when there is none.
fn xPullMulPartners(ctx: TypeContext, f: IrFunc, debug: bool): IrFunc {
  let w = XPullWalk{ ctx = ctx, f = f, debug = debug, pull = noForwarding(len(f.instrs)) }
  let moved = false
  for b of f.blocks {
    if (xPullBlock(w, b)) {
      moved = true
    }
  }
  if (!moved) {
    return f
  }
  let plan = neutralPlan(f)
  plan.pull = w.pull
  return rebuild(f, plan)
}

// Claims block `b`'s pairs, left to right and each with its nearest partner,
// the order `xComputeMulPairs` pairs them in. True iff one is not adjacent.
fn xPullBlock(w: XPullWalk, b: IrBlock): bool {
  let moved = false
  let i = b.instsStart + b.paramCount
  let end = b.instsStart + b.instsLen
  while (i < end) {
    let j = xMulPartner(w, i, end)
    if (j > i) {
      w.pull[i] = j
      w.pull[j] = i
      if (j > i + 1) {
        moved = true
      }
    }
    i = i + 1
  }
  return moved
}

// The unclaimed instruction before `end` that `i` pairs with, or -1: none, `i`
// is claimed or not a multiply, or a clobber or another product sits between.
fn xMulPartner(w: XPullWalk, i: int, end: int): int {
  let op = w.f.instrs[i].op
  if (w.pull[i] >= 0 || (op != Op.Mul && op != Op.UMulHi)) {
    return -1
  }
  let j = i + 1
  while (j < end) {
    let ins = w.f.instrs[j]
    if (xPullBarrier(ins.op)) {
      return -1
    }
    if (w.pull[j] < 0 && xMulPairable(w.ctx, w.f.instrs[i], ins, w.debug)) {
      return j
    }
    if (xIsProduct(ins.op)) {
      return -1
    }
    j = j + 1
  }
  return -1
}

// An instruction no pulled result may live across in a register it owns.
fn xPullBarrier(op: Op): bool {
  return isSafepointOp(op) || opIsCall(op) || op == Op.Asm || op == Op.Syscall || op == Op.CallWord
}

fn xIsProduct(op: Op): bool {
  return op == Op.Mul || op == Op.UMulHi || op == Op.SMulHi
}
