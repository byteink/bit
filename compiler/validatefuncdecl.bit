// Top-level function/test DECLARATION validation, split out of
// compiler/validateattr.bit by #4148 (that file was 829 lines against the
// 800-line ceiling once #4148's E0117 check landed there). Sorts right
// after validateattr.bit (compiler/project.bit:7's bytewise module
// concatenation), the same position this content already occupied at the
// end of that file, so the split does not move it earlier relative to any
// sibling — see that file's own header for why file order can matter for
// emitted diagnostic order, not for name resolution.
//
// Four things live here, in source order: E0117 (a bare 'fn' shaped like
// the removed legacy test form, inside a '.test.bit' file), `vFuncDecl`
// (the main per-declaration body/attribute walk every free function and
// in-body method goes through), E0115 (a `test "..." { }` declaration
// outside a '.test.bit' file) and `vFuncOrTestDecl`, the one dispatcher
// `checkModule`'s main sweep calls for both node tags.

// E0117 (SPEC §19, epic #4126, #4148): a bare top-level 'fn' shaped exactly
// like the REMOVED legacy test form -- no receiver, no generics, no
// parameters, no declared result -- inside a '.test.bit' file. Before #4148
// this shape was silently discovered and run as a test (testgen.bit's
// former `isTestFunc`); after removal it would otherwise just be an
// ordinary function that never runs, which is the SILENT failure mode this
// repo treats as worse than a compile error -- a test that quietly stops
// being discovered still exits 0 and reports nothing missing. So this shape
// is a hard error instead, pointing the author at the one remaining
// discovery form. Measured across every tracked '.test.bit' file when
// #4148 landed: zero legitimate helpers of this exact shape existed outside
// the one fixture that same commit rewrote, so this cannot fire on real
// code as it stood then.
const ecBareFnLooksLikeTest = 117

// Reports E0117 when `node` (a FuncDecl already known to have a body,
// `kids` its own already-fetched children) matches the removed legacy test
// shape inside a '.test.bit' file. Split out of `vFuncDecl` so that
// function's own branch count is unchanged by this addition -- one new
// call there, not one new branch. `raw` must be the node's own
// (module-global) span, never `vSpan`'s remapped one -- see `vTestDecl`'s
// identical #4151 caution below, which this reuses `declInTestFile` from.
fn vBareTestShapeInTestFile(c: Checker, node: int, kids: []int) {
  if (kids[0] != 0 || kids[2] != 0 || kids[4] != 0) {
    return // method, generic, or has a declared result: never test-shaped
  }
  if (kids[3] != 0 && len(kidsOf(c.tree, kids[3])) > 0) {
    return // takes a parameter
  }
  if (vIdentText(c, kids[1]) == "main") {
    return // SPEC §19: never test-shaped regardless of shape (see isTestFunc)
  }
  let raw = getNode(c.tree, node).span
  if (!declInTestFile(c, raw)) {
    return
  }
  let full = vSpan(c, node)
  report(
    c.diags, ecBareFnLooksLikeTest,
    Span{ file: full.file, start: full.start, end: vSpan(c, kids[1]).end },
    "a bare 'fn' with no parameters and no return type is not allowed in a '.test.bit' file",
    "write 'test \"<name>\" { }' instead (SPEC §19), or give this function a parameter or a return type if it is a helper, not a test",
  )
}

// Validates one function's body. Called src `checkModule`'s sweep as it reaches
// the FuncDecl node — see this file's header for why that is the only point
// where `env` holds this function's bindings and no other's.
fn vFuncDecl(c: Checker, node: int) {
  // [recv, name, generics, params, result, body(, attrs)] — the 7th child is
  // elided when the decl carries no `@attr` (parser.bit), so both widths are
  // well-formed and every kid this function reads sits at a fixed index below 6.
  let kids = kidsOf(c.tree, node)
  assert(len(kids) == 6 || len(kids) == 7)
  if (kids[5] == 0) {
    return
  }
  vBareTestShapeInTestFile(c, node, kids)
  // The declared result, unwrapped for a fallible function: `return x` in a
  // `(): T!` produces the OK type, never the boxed `!` wrapper (§18.2).
  let result = c.ctx.voidId
  let fallible = false
  if (kids[4] != 0) {
    let declared = typeFromNode(c, kids[4])
    fallible = c.ctx.types[declared].kind == TypeKind.Fallible
    result = unwrapFallible(c, declared)
  }
  // The signature's type-annotation rules (E0052/E0072) are NOT swept here. They
  // moved to check.bit's declaration pre-pass (#1550), which is where the seed
  // judges them: one phase over every declaration's type nodes, ahead of the
  // module bindings. Run from here they landed in the main arena pass instead,
  // after those bindings, so the two compilers agreed on the diagnostic set and
  // disagreed on its order.
  //
  // §10.3.1/§11.9 attributes. E0076/E0079-argument first (an unknown name
  // resolves to no flag, and a malformed pin yields no name), then the pin
  // rule below. v1 attaches attributes to free functions only — an in-body
  // method's func_decl (parsertype.bit's parseMethodMember/parseInitMember,
  // checktrait.bit's cloneTraitMethod) never carries an attrs kid at all, so
  // `pin`/`naked`/`nosplit` are structurally always ""/false/false for a
  // method and there is nothing left to reject on a receiver here (#3811
  // removed the three "cannot be a method" checks that used to fire, since
  // no attribute syntax exists for the in-body method form to trigger them).
  let pin = vAttrNames(c, node)
  let naked = funcHasAttr(c, node, "naked")
  let nosplit = funcHasAttr(c, node, "nosplit")
  if (kids[0] == 0) {
    // The pin is validated before the body rules, mirroring the seed, where it
    // is collect-phase work and @naked/@nosplit body walks are not.
    if (pin != "") {
      vPinnedSymbol(c, node, pin)
    }
  }
  vStmt(c, result, kids[5], 0, 0, fallible)
  // v1 attaches attributes to free functions only: the seed's body-rule pass
  // reads its attribute set from the free-function table, so a method's @naked
  // is inert there — and unreachable in the first place, since a method's
  // func_decl never carries an attrs kid (see the comment above `pin`).
  let nakedFree = naked && kids[0] == 0
  // E0055 (§10.3): a non-void function must return on every path. `result` is
  // already the unwrapped ok type; an unresolved result (0) is skipped so an
  // inference gap never becomes a spurious diagnostic. A @naked function is held
  // to the rule even when void (§10.3.1): lowering emits no implicit `ret` for
  // one, so falling off the end silently builds an object with no `ret` at all.
  if ((result != c.ctx.voidId || nakedFree) && result != 0 && !vDiverges(c, kids[5], false)) {
    reportNoHint(
      c.diags, ecMissingReturn, vSpan(c, kids[1]),
      "missing return: not every path returns a value",
    )
  }
  // The seed runs the @naked/@nosplit body rules after the body walk and E0055;
  // diagnostics render in emission order, so a function tripping several of them
  // must emit them in the seed's sequence.
  if (kids[0] == 0) {
    if (naked) {
      vNakedFn(c, node, result)
    }
    if (nosplit) {
      vNosplitWalk(c, kids[5], vIdentText(c, kids[1]), 0)
    }
  }
}

// E0115 (SPEC §19, epic #4126): a `test "name" { ... }` declaration outside a
// `.test.bit` file. First free code above E0114 (validateassign.bit's
// ecReadonlyFieldAssign) — the LINT range starts at E0200, so this is a
// checker code, not a lint one.
const ecTestDeclOutsideTestFile = 115

// Validates one test declaration (parserdecl.bit's parseTestDecl always
// produces this shape, so `kids` needs no length assertion the way
// vFuncDecl's does). The grammar admits `test "..." { }` anywhere
// `parseTopDecl` is reached — the parser has no Checker and so cannot know
// its own real source file — so the FILE requirement is enforced here, the
// one place that can: `declInTestFile` (testgen.bit) resolves a span back to
// its real file the same way lowering's `inTestFile` does. Reported on the
// declaration's HEAD, `test "name"`, not the whole body, so a multi-line
// test never produces a multi-line caret. A `.test.bit` declaration is
// validated exactly like a void, non-fallible function's body
// (vFuncDecl above): no params, no receiver, no generics, no declared
// result, so `vStmt` with a void result and a fresh break/loop context is
// everything the body needs.
//
// #4151: `declInTestFile` takes a MODULE-GLOBAL offset (it runs `fileOf`
// itself, same as `vSpan` does) — so it needs the node's RAW span, not
// `vSpan`'s output. `vSpan` already remapped that to a file-local offset,
// and re-running `fileOf` over an already-file-local number silently
// resolves to file index 0 whenever the true file sorts after another file
// in the module (fileStarts[0] is always 0, so any small offset satisfies
// it). `raw` is only for that check; `full` (the remapped span) still
// carries the correct file id for the diagnostic below.
fn vTestDecl(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [name, body]
  let full = vSpan(c, node)
  let raw = getNode(c.tree, node).span
  if (!declInTestFile(c, raw)) {
    report(
      c.diags, ecTestDeclOutsideTestFile,
      Span{ file: full.file, start: full.start, end: vSpan(c, kids[0]).end },
      "'test' declarations are only allowed in a '.test.bit' file",
      "rename this file to '<name>.test.bit', or declare an ordinary 'fn' here (SPEC §19)",
    )
    return
  }
  vStmt(c, c.ctx.voidId, kids[1], 0, 0, false)
}

// checkModule's main pass (checkmodule.bit) dispatches one call per top-level
// node tag via an if-elseif chain, and that chain's own McCabe complexity is
// what tools/build/complexity-debt.txt pins for `checkModule` -- every ARM
// added there costs `checkModule` +1, permanently, even though the arm's own
// body is a single call. FuncDecl and TestDecl share the identical ordering
// requirement (see vFuncDecl's and vTestDecl's own headers: children precede
// parents in arena order, so the body is fully swept and `env` holds exactly
// this declaration's locals by the time the sweep reaches it) and nothing
// else about them, so this folds both into ONE branch in checkModule --
// `else if (vFuncOrTestDecl(c, i, tag))` -- replacing what was already a
// single `tag == Tag.FuncDecl` branch there, at no net cost to checkModule's
// own complexity. Called at the exact same arena position either way, so the
// ordering guarantee is unchanged; only WHICH function contains the decision
// point moves.
fn vFuncOrTestDecl(c: Checker, node: int, tag: Tag): bool {
  if (tag == Tag.FuncDecl) {
    vFuncDecl(c, node)
    return true
  }
  if (tag == Tag.TestDecl) {
    vTestDecl(c, node)
    return true
  }
  return false
}
