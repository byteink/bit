// bit doc — a module's public surface, straight from the checker (#1590).
//
// Documentation drifts: a hand-maintained list of what
// `std/strings` exports is wrong the moment somebody adds an export and forgets
// the page. So the list is not maintained, it is DERIVED — from the same
// `exports` set the resolver builds and the same signatures the checker infers.
//
// Two output forms, close to the seed's `runDoc` but now diverging on purpose
// (#2724): a named type's line no longer repeats its own name (the seed's
// fixed `<kind> <name> <type>` printed "enum Option Option", since a named
// type's rendered type IS its name), and both forms carry the symbol's own
// generic parameter list, read from its declaration node rather than
// reconstructed from source text.
//   plain:   named type ("struct"/"enum"/"interface"/"type"):
//              "<kind> <name><params>\n"
//            everything else:
//              "<kind> <name><params> <type>\n"
//   --json:  a `[ {...} ]` array, one object per line, with a "params" key
//            between "kind" and "type", for tooling and humans.
//
// A method is reported against its receiver (`File.readAll`), because that is how
// it is called and how a reader looks it up. A method set also holds a type's
// PRIVATE methods (interface satisfaction needs them); those are no public
// surface, so only `export`ed methods appear — the `ctx.methodExported` filter.
//
// `--fields` (#3039) additionally reports each struct's OWN fields, the same
// way as a method (`Exchange.conn`, kind "field"), in declaration order. It
// defaults OFF: the plain/`--json` shapes are otherwise unchanged, because
// two existing consumers depend on that exact shape — see `collectDoc`'s own
// comment for why turning it on unconditionally would break both. Field
// reporting is also NOT filtered by the field's own `export` keyword (SPEC
// §17.3), unlike a method: the checker does not actually enforce that keyword
// for a cross-module read (`resolveStructFields` interns every field into
// `ctx.structFields` with no visibility check at the call site), so a field
// with no `export` is, in practice, exactly as reachable from outside the
// module as one with it. Filtering by the keyword would have hidden the
// removal that motivated this: `Exchange { conn, request }` ->
// `Exchange { conn }` (#2346) broke a real consumer of the unmarked `request`
// field.

// One exported symbol. `kind` is the seed's Kind.text(): "function", "method",
// "const", "struct", "enum", "interface" or "type".
struct DocSymbol {
  kind: string,
  name: string,
  // The written generic parameter list, angle-bracketed and ", "-separated
  // ("<T>", "<T, E>"), or "" when the symbol declares none. A method reports
  // "" here unconditionally — its receiver's own doc line already carries
  // the receiver's parameters.
  params: string,
  typeText: string,
}

// Upper bound on symbols reported for one module, so the walk is provably bounded
// (Power of 10). A stdlib module is nowhere near it. Matches the seed's max_symbols.
fn docMaxSymbols(): int {
  return 1024
}

// The kind text for a named type, from its DECL node's tag — NOT from the type it
// resolves to. A `type X = Box<i64>` resolves to a struct, but its kind is "type";
// reading the resolved type's kind would misreport it as "struct" (the seed keys
// off the decl symbol's kind for exactly this reason).
fn docTypeKind(c: Checker, declNode: int): string {
  let tag = getNode(c.tree, declNode).tag
  if (tag == Tag.StructDecl) {
    return "struct"
  }
  if (tag == Tag.EnumDecl) {
    return "enum"
  }
  if (tag == Tag.InterfaceDecl) {
    return "interface"
  }
  return "type"
}

// The decl node recorded for a named type, or 0 when `name` names no type.
fn docTypeDecl(c: Checker, name: string): int {
  let (node, ok) = c.typeDecls[name]
  if (!ok) {
    return 0
  }
  return node
}

// Renders a `Tag.GenericParams` node's own parameter names, angle-bracketed
// and comma-separated ("<T>", "<T, E>"). `node` is 0 for a non-generic
// declaration, which renders as "". Reads only the parameter NAME (kid 0 of
// each `Tag.GenericParam`, parsertype.bit's `parseGenericParam`), never the
// `: Bound` constraint — the params list is the declaration's arity and
// spelling, not its bounds.
fn docGenericParamsText(tree: Tree, source: string, node: int): string {
  if (node == 0) {
    return ""
  }
  let items = kidsOf(tree, node)
  let out = "<"
  let i = 0
  while (i < len(items)) {
    if (i != 0) {
      out = out + ", "
    }
    let nm = getNode(tree, kidsOf(tree, items[i])[0])
    out = out + source[nm.span.start:nm.span.end]
    i = i + 1
  }
  return out + ">"
}

// A named type's own generic parameter list, from its decl node's generics
// slot: kid 1 of StructDecl/EnumDecl/InterfaceDecl/TypeAlias (parsertype.bit's
// `mkNode` calls). `declNode` is whatever `docTypeDecl` returned, which only
// ever answers from `c.typeDecls` — filled by `checkModule`'s pre-scan over
// `c.tree` alone, never an import (checkmodule.bit) — so this reads
// `c.tree`/`c.source` directly; there is no cross-module hop for a named type
// the way there is for a function below.
fn docTypeParamsText(c: Checker, declNode: int): string {
  return docGenericParamsText(c.tree, c.source, kidsOf(c.tree, declNode)[1])
}

// A free function's own generic parameter list, from its FuncDecl node's
// generics slot: kid 2 (parserdecl.bit). `owner` MUST be `declOwner(c, name)`
// — an imported function's decl node lives in the EXPORTING module's tree
// (checklookup.bit's `funcDeclLookup`), and indexing it against the
// importer's tree would land on an unrelated node. An extern function is
// never generic and keeps a 3-kid shape with no generics slot at all (SPEC
// 11.7), and a name `funcDeclLookup` could not resolve reads as `declNode ==
// 0` — both guarded rather than indexed.
fn docFuncParamsText(owner: Checker, declNode: int): string {
  if (declNode == 0 || isExternDecl(owner.tree, declNode)) {
    return ""
  }
  return docGenericParamsText(owner.tree, owner.source, kidsOf(owner.tree, declNode)[2])
}

// Whether a concrete method carries `export`. A missing key is private.
fn docMethodExported(c: Checker, key: string): bool {
  let (ex, ok) = c.ctx.methodExported[key]
  return ok && ex
}

// Appends a receiver's EXPORTED methods, reported as `Recv.name`. An interface's
// methods are no part of this: the seed stores them on the type itself, not in
// the method sets `methodsOf` walks, so `bit doc` reports none for an interface
// (the self-host DOES register them in `typeMethodNames`, so they are skipped
// here explicitly). Bounded by `docMaxSymbols`.
fn docAppendMethods(c: Checker, out: []DocSymbol, recvName: string, recvId: int): []DocSymbol {
  if (c.ctx.types[recvId].kind == TypeKind.Interface) {
    return out
  }
  let names = typeMethodNamesOf(c.ctx, recvId)
  let i = 0
  while (i < len(names)) {
    if (len(out) >= docMaxSymbols()) {
      return out
    }
    let m = names[i]
    let key = "${recvId}." + m
    if (docMethodExported(c, key)) {
      let sig = methodSigLookup(c, key)
      out = append(out, DocSymbol{ kind: "method", name: recvName + "." + m,
        typeText: typeName(c.ctx, sig) })
    }
    i = i + 1
  }
  return out
}

// Appends a struct's OWN fields, reported as `Recv.name`, in declaration
// order (`structFieldNodes` already strips each field's `Export` wrapper, so
// this reads every field regardless of that keyword — see the header
// comment above `docAppendMethods` for why that is deliberate). `declNode`
// is the struct's own `StructDecl`, and `recvId` is `userTypeLookup(c,
// recvName)` — the same id `resolveStructFields` (checkbind.bit) keyed
// `ctx.structFields` under, so `structFieldLookup` always finds a field this
// walk names. Bounded by `docMaxSymbols`, matching `docAppendMethods`.
fn docAppendFields(c: Checker, out: []DocSymbol, recvName: string, recvId: int, declNode: int): []DocSymbol {
  let fields = structFieldNodes(c, declNode)
  let i = 0
  while (i < len(fields)) {
    if (len(out) >= docMaxSymbols()) {
      return out
    }
    let nm = getNode(c.tree, kidsOf(c.tree, fields[i])[0])
    let fname = c.source[nm.span.start:nm.span.end]
    let fty = structFieldLookup(c, "${recvId}." + fname)
    out = append(out, DocSymbol{ kind: "field", name: recvName + "." + fname,
      typeText: typeName(c.ctx, fty) })
    i = i + 1
  }
  return out
}

// The exported symbols of the root module `c`, in the seed's classification: a
// name is a named type, a free function, or a module constant — anything else
// (a bare exported method name, which the self-host's `collectExports` also
// records) matches no category and is skipped, exactly as the seed's `else => {}`.
//
// `withFields` is OFF by default (`--fields`, #3039) and additive-only: the
// plain/`--json` shapes stage0 already emits are unchanged with it off, which
// is load-bearing for two things past this file — `selfhost-diffdoc.sh` diffs
// this output byte-for-byte against the PINNED PREVIOUS release, which never
// emitted field lines and cannot be made to; and `tests/bit/stdlibdocs.bit`
// fails the build on any exported symbol with no `docs/stdlib/*.md` section,
// and no stdlib page documents its structs' individual fields today. Turning
// this on unconditionally would redden both for reasons unrelated to this
// change. `--fields` exists so a caller that wants the fuller surface (the
// release-surface gate this was added for) can ask for it without disturbing
// either.
fn collectDoc(c: Checker, withFields: bool): []DocSymbol {
  let out = []DocSymbol(0)
  for (n, _) of c.exports {
    if (len(out) >= docMaxSymbols()) {
      return out
    }
    let td = docTypeDecl(c, n)
    if (td != 0) {
      let id = userTypeLookup(c, n)
      let params = docTypeParamsText(c, td)
      // typeText is deliberately `n + params`, not `typeName(c.ctx, id)`: the
      // latter renders the same "n" back (a named type's own id is never an
      // instantiation of itself), so the two were always identical — the
      // "enum Option Option" doubling this replaces (#2724).
      out = append(out, DocSymbol{ kind: docTypeKind(c, td), name: n,
        params: params, typeText: n + params })
      out = docAppendMethods(c, out, n, id)
      // Enum/interface/type-alias decl nodes do not share StructDecl's
      // shape (kid 2 is not a FieldList), so this is struct-only.
      if (withFields && docTypeKind(c, td) == "struct") {
        out = docAppendFields(c, out, n, id, td)
      }
      continue
    }
    let sig = funcSigLookup(c, n)
    if (sig != 0) {
      let params = docFuncParamsText(declOwner(c, n), funcDeclLookup(c, n))
      out = append(out, DocSymbol{ kind: "function", name: n, params: params,
        typeText: typeName(c.ctx, sig) })
      continue
    }
    let (ct, isConst) = c.moduleEnv[n]
    if (isConst) {
      out = append(out, DocSymbol{ kind: "const", name: n,
        typeText: typeName(c.ctx, ct) })
      continue
    }
  }
  return sortDoc(out)
}

// Insertion sort by name, bytewise (`strCompare`) — matching the seed's
// `std.mem.lessThan(u8, a.name, b.name)`. Module symbol counts are small; O(n²)
// is negligible and keeps the order provably total.
fn sortDoc(syms: []DocSymbol): []DocSymbol {
  let i = 1
  while (i < len(syms)) {
    let cur = syms[i]
    let j = i - 1
    while (j >= 0 && strCompare(syms[j].name, cur.name) > 0) {
      syms[j + 1] = syms[j]
      j = j - 1
    }
    syms[j + 1] = cur
    i = i + 1
  }
  return syms
}

// Escapes a rendered type for a JSON string. A type name never holds a control
// character, but it can hold `\` (and `"` in principle) — escape both, matching
// the seed's `writeJsonString`.
fn docJsonString(s: string): string {
  let out = "\""
  let b = []byte(s)
  let i = 0
  while (i < len(b)) {
    let c = b[i]
    if (c == u8(34) || c == u8(92)) { // '"' or '\'
      out = out + "\\"
    }
    out = out + string(b[i:i + 1])
    i = i + 1
  }
  return out + "\""
}

// The `--json` form: a `[ {...} ]` array, one object per line, byte-identical to
// the seed's `writeJson`.
fn docJson(syms: []DocSymbol): string {
  let out = "[\n"
  let i = 0
  while (i < len(syms)) {
    let s = syms[i]
    out = out + "  {\"name\": " + docJsonString(s.name) +
      ", \"kind\": " + docJsonString(s.kind) +
      ", \"params\": " + docJsonString(s.params) +
      ", \"type\": " + docJsonString(s.typeText) + "}"
    if (i + 1 < len(syms)) {
      out = out + ","
    }
    out = out + "\n"
    i = i + 1
  }
  return out + "]\n"
}

// Whether `kind` is a named type's — the four the checker keys off the decl
// symbol's own tag for (`docTypeKind`), never a method/function/const.
fn docKindIsNamedType(kind: string): bool {
  return kind == "struct" || kind == "enum" || kind == "interface" || kind == "type"
}

// The plain form, per symbol (#2724): a named type prints "<kind> <type>\n" —
// `typeText` already holds `name + params`, so printing `name` too would
// repeat it verbatim. Every other kind prints "<kind> <name><params>
// <type>\n".
fn docPlain(syms: []DocSymbol): string {
  let out = ""
  let i = 0
  while (i < len(syms)) {
    let s = syms[i]
    if (docKindIsNamedType(s.kind)) {
      out = out + s.kind + " " + s.typeText + "\n"
    } else {
      out = out + s.kind + " " + s.name + s.params + " " + s.typeText + "\n"
    }
    i = i + 1
  }
  return out
}

// `bit doc [--json] [--fields] <module-dir>`: load, resolve and check the
// module rooted at `path` (always a DIRECTORY — a lone-file root has no doc
// form yet, SPEC §17.1), then print its exported surface. Returns false (and
// leaves diagnostics on stderr) when the module does not compile, matching
// the seed's `null` return.
//
// The front-end order mirrors `checkCmd`: resolve first (so module-graph errors
// surface even beside a parse error, as the seed's loader reports them), then the
// parse+resolve gate, then the type checker.
fn docCmd(path: string, asJson: bool, withFields: bool): bool {
  // The operand must exist and hold Bit source, checked ahead of the loader
  // (#2411): a directory with no `.bit` files registered as a zero-file
  // module and printed nothing, indistinguishable from a real module whose
  // exports are all private. `moduleRootProblem` (compiler/build.bit) is the
  // same guard `checkCmd`/`buildIr` use, so this and the other commands agree
  // about the same path instead of drifting the way #2394's four call sites did.
  let problem = moduleRootProblem(path)
  if (problem != "") {
    eprint("bit doc: ${path}: ${problem}\n")
    return false
  }
  let rootDir = path
  if (!fsIsDir(path)) {
    rootDir = pathDir(path)
  }
  // #2254: same manifest-vs-lock guard checkCmd (main.bit) and buildIr
  // (build.bit) run, so `doc` cannot start disagreeing about the same
  // bit.json — see `manifestLockProblem` (projectpkg.bit) for exactly what
  // it checks.
  let (lockEntries, lockErr) = loadLockEntries(rootDir)
  let manifestProblem = manifestLockProblem(rootDir, lockEntries, lockErr)
  if (manifestProblem != "") {
    eprint("bit doc: ${manifestProblem}\n")
    return false
  }
  let p = loadProject(path, "", stdRootPath())
  if (p.root < 0 || len(p.mods) == 0) {
    eprint("bit doc: not a module: ${path}\n")
    return false
  }
  let mods = resolveProject(p)
  if (reportCheckErrors(p.diags)) {
    return false
  }
  checkResolved(p, mods)
  // Final gate: renders a warnings-only sink too (#2491), unlike the
  // parse+resolve gate above.
  if (reportCheckDiagnostics(p.diags)) {
    return false
  }
  let syms = collectDoc(mods[p.root], withFields)
  if (asJson) {
    print(docJson(syms))
  } else {
    print(docPlain(syms))
  }
  return true
}
