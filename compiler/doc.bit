// bit doc — a module's public surface, straight from the checker (#1590).
//
// Documentation drifts: a hand-maintained list of what
// `std/strings` exports is wrong the moment somebody adds an export and forgets
// the page. So the list is not maintained, it is DERIVED — from the same
// `exports` set the resolver builds and the same signatures the checker infers.
//
// Two output forms, close to the seed's `runDoc` but now diverging on purpose
// (#2724): a named type's line no longer repeats its own name (the seed's
// fixed `<kind> <name> <type>` printed "enum Option Option", since a named
// type's rendered type IS its name), and both forms carry the symbol's own
// generic parameter list, read from its declaration node rather than
// reconstructed from source text.
//   plain:   named type ("class"/"interface"/"type"):
//              "<kind> <name><params>\n"
//            enum:
//              "enum <name><params> { <variant>, <variant>(<payload, ...>), ... }\n"
//            everything else:
//              "<kind> <name><params> <type>\n"
//   --json:  a `[ {...} ]` array, one object per line, with a "params" key
//            between "kind" and "type", for tooling and humans, and a
//            "variants" key on every entry (empty for anything but an enum).
//
// An enum's variant list is its entire meaning (#2279): unlike a class, whose
// shape a reader can at least infer from its methods, a bare `enum Json` name
// gives no way to learn that a value is built `Json.JsonObject([]JsonEntry{...})`
// rather than some other plausible spelling. So both forms report each
// variant's name and its payload types (empty payload for a bare variant like
// `JsonNull`), read the same way `resolveEnumPayloads` (checkbind.bit) built
// them: from the EnumDecl's own `VariantList` for the ordered NAMES (every
// variant, including payload-less ones, which never reach
// `ctx.variantPayloads`), and from `ctx.variantPayloads` for the resolved
// PAYLOAD TYPES, keyed under the same template TypeId `collectDoc` already
// looks up for the enum's own entry.
//
// A method is reported against its receiver (`File.readAll`), because that is how
// it is called and how a reader looks it up. A method set also holds a type's
// PRIVATE methods (interface satisfaction needs them); those are no public
// surface, so only `export`ed methods appear — the `ctx.methodExported` filter.
//
// `--fields` (#3039) additionally reports each class's OWN fields, the same
// way as a method (`Exchange.conn`, kind "field"), in declaration order. It
// defaults OFF: the plain/`--json` shapes are otherwise unchanged, because
// two existing consumers depend on that exact shape — see `collectDoc`'s own
// comment for why turning it on unconditionally would break both. Field
// reporting is also NOT filtered by the field's own `export` keyword (SPEC
// §17.3), unlike a method: the checker does not actually enforce that keyword
// for a cross-module read (`resolveStructFields` interns every field into
// `ctx.structFields` with no visibility check at the call site), so a field
// with no `export` is, in practice, exactly as reachable from outside the
// module as one with it. Filtering by the keyword would have hidden the
// removal that motivated this: `Exchange { conn, request }` ->
// `Exchange { conn }` (#2346) broke a real consumer of the unmarked `request`
// field.

// One exported symbol. `kind` is the seed's Kind.text(): "function", "method",
// "const", "class", "enum", "interface" or "type".
class DocSymbol {
  kind: string,
  name: string,
  // The written generic parameter list, angle-bracketed and ", "-separated
  // ("<T>", "<T, E>"), or "" when the symbol declares none. A method reports
  // "" here unconditionally — its receiver's own doc line already carries
  // the receiver's parameters.
  params: string,
  typeText: string,
  // Enum-only (#2279): every variant, in declaration order, with its
  // resolved payload type names. Empty for every other kind.
  variants: []DocVariant,
  // The `//` comment block written directly above the declaration (#2725),
  // lines joined by "\n" in source order with each line's own leading "//"
  // kept verbatim. "" when no such run immediately precedes the declaration
  // (nothing there, a blank line, or a `/* */` block comment in the way).
  // Filled for a named type, function or const; a method or field (#3039)
  // has no declaration-node lookup by name today, so it stays "".
  doc: string,
}

// One enum variant: its bare name, and its payload TYPE NAMES already
// rendered by `typeName` (empty for a payload-less variant like `JsonNull`).
class DocVariant {
  name: string,
  payload: []string,
}

// Upper bound on symbols reported for one module, so the walk is provably bounded
// (Power of 10). A stdlib module is nowhere near it. Matches the seed's max_symbols.
fn docMaxSymbols(): int {
  return 1024
}

// The kind text for a named type, from its DECL node's tag — NOT from the type it
// resolves to. A `type X = Box<i64>` resolves to a class, but its kind is "type";
// reading the resolved type's kind would misreport it as "class" (the seed keys
// off the decl symbol's kind for exactly this reason).
fn docTypeKind(c: Checker, declNode: int): string {
  let tag = getNode(c.tree, declNode).tag
  if (tag == Tag.StructDecl) {
    return "class"
  }
  if (tag == Tag.EnumDecl) {
    return "enum"
  }
  if (tag == Tag.InterfaceDecl) {
    return "interface"
  }
  return "type"
}

// The decl node recorded for a named type, or 0 when `name` names no type.
fn docTypeDecl(c: Checker, name: string): int {
  let (node, ok) = c.typeDecls[name]
  if (!ok) {
    return 0
  }
  return node
}

// Renders a `Tag.GenericParams` node's own parameter names, angle-bracketed
// and comma-separated ("<T>", "<T, E>"). `node` is 0 for a non-generic
// declaration, which renders as "". Reads only the parameter NAME (kid 0 of
// each `Tag.GenericParam`, parsertype.bit's `parseGenericParam`), never the
// `: Bound` constraint — the params list is the declaration's arity and
// spelling, not its bounds.
fn docGenericParamsText(tree: Tree, source: string, node: int): string {
  if (node == 0) {
    return ""
  }
  let items = kidsOf(tree, node)
  let out = "<"
  let i = 0
  while (i < len(items)) {
    if (i != 0) {
      out = out + ", "
    }
    let nm = getNode(tree, kidsOf(tree, items[i])[0])
    out = out + source[nm.span.start:nm.span.end]
    i = i + 1
  }
  return out + ">"
}

// A named type's own generic parameter list, from its decl node's generics
// slot: kid 1 of StructDecl/EnumDecl/InterfaceDecl/TypeAlias (parsertype.bit's
// `mkNode` calls). `declNode` is whatever `docTypeDecl` returned, which only
// ever answers from `c.typeDecls` — filled by `checkModule`'s pre-scan over
// `c.tree` alone, never an import (checkmodule.bit) — so this reads
// `c.tree`/`c.source` directly; there is no cross-module hop for a named type
// the way there is for a function below.
fn docTypeParamsText(c: Checker, declNode: int): string {
  return docGenericParamsText(c.tree, c.source, kidsOf(c.tree, declNode)[1])
}

// A variant's payload type names, resolved — `[]` for a payload-less variant.
// `resolveEnumPayloads` (checkbind.bit) only interns `ctx.variantPayloads`
// for a variant that HAS a payload, so a missing key means "no payload",
// never "not yet resolved" (`declTypeOf` already ran `resolveEnumPayloads`
// for every named type before `collectDoc`'s exports walk starts).
fn docVariantPayload(c: Checker, enumTy: int, vname: string): []string {
  let (ptypes, ok) = c.ctx.variantPayloads["${enumTy}." + vname]
  let out = []string(0)
  if (!ok) {
    return out
  }
  let i = 0
  while (i < len(ptypes)) {
    out = append(out, typeName(c.ctx, ptypes[i]))
    i = i + 1
  }
  return out
}

// An enum's own variant list, in declaration order, from its `EnumDecl`
// node's `VariantList` slot (kid 2, `parseEnumDecl`/`parseVariant` in
// parsertype.bit): every variant appears here, including payload-less ones
// that `ctx.variantPayloads` never records. `enumTy` is the same template
// TypeId `collectDoc` already looked up for the enum's own entry — the id
// `resolveEnumPayloads` interned payloads under.
fn docEnumVariants(c: Checker, declNode: int, enumTy: int): []DocVariant {
  let vs = kidsOf(c.tree, kidsOf(c.tree, declNode)[2])
  let out = []DocVariant(0)
  let i = 0
  while (i < len(vs)) {
    let vk = kidsOf(c.tree, vs[i])
    let vn = getNode(c.tree, vk[0])
    let vname = c.source[vn.span.start:vn.span.end]
    out = append(out, DocVariant{ name: vname, payload: docVariantPayload(c, enumTy, vname) })
    i = i + 1
  }
  return out
}

// A free function's own generic parameter list, from its FuncDecl node's
// generics slot: kid 2 (parserdecl.bit). `owner` MUST be `declOwner(c, name)`
// — an imported function's decl node lives in the EXPORTING module's tree
// (checklookup.bit's `funcDeclLookup`), and indexing it against the
// importer's tree would land on an unrelated node. An extern function is
// never generic and keeps a 3-kid shape with no generics slot at all (SPEC
// 11.7), and a name `funcDeclLookup` could not resolve reads as `declNode ==
// 0` — both guarded rather than indexed.
fn docFuncParamsText(owner: Checker, declNode: int): string {
  if (declNode == 0 || isExternDecl(owner.tree, declNode)) {
    return ""
  }
  return docGenericParamsText(owner.tree, owner.source, kidsOf(owner.tree, declNode)[2])
}

// Whether a concrete method carries `export`. A missing key is private.
fn docMethodExported(c: Checker, key: string): bool {
  let (ex, ok) = c.ctx.methodExported[key]
  return ok && ex
}

// Appends a receiver's EXPORTED methods, reported as `Recv.name`. An interface's
// methods are no part of this: the seed stores them on the type itself, not in
// the method sets `methodsOf` walks, so `bit doc` reports none for an interface
// (the self-host DOES register them in `typeMethodNames`, so they are skipped
// here explicitly). Bounded by `docMaxSymbols`.
fn docAppendMethods(c: Checker, out: []DocSymbol, recvName: string, recvId: int): []DocSymbol {
  if (c.ctx.types[recvId].kind == TypeKind.Interface) {
    return out
  }
  let names = typeMethodNamesOf(c.ctx, recvId)
  let i = 0
  while (i < len(names)) {
    if (len(out) >= docMaxSymbols()) {
      return out
    }
    let m = names[i]
    let key = "${recvId}." + m
    if (docMethodExported(c, key)) {
      let sig = methodSigLookup(c, key)
      out = append(out, DocSymbol{ kind: "method", name: recvName + "." + m,
        typeText: typeName(c.ctx, sig) })
    }
    i = i + 1
  }
  return out
}

// Appends a class's OWN fields, reported as `Recv.name`, in declaration
// order (`structFieldNodes` already strips each field's `Export` wrapper, so
// this reads every field regardless of that keyword — see the header
// comment above `docAppendMethods` for why that is deliberate). `declNode`
// is the class's own `StructDecl`, and `recvId` is `userTypeLookup(c,
// recvName)` — the same id `resolveStructFields` (checkbind.bit) keyed
// `ctx.structFields` under, so `structFieldLookup` always finds a field this
// walk names. Bounded by `docMaxSymbols`, matching `docAppendMethods`.
fn docAppendFields(c: Checker, out: []DocSymbol, recvName: string, recvId: int, declNode: int): []DocSymbol {
  let fields = structFieldNodes(c, declNode)
  let i = 0
  while (i < len(fields)) {
    if (len(out) >= docMaxSymbols()) {
      return out
    }
    let nm = getNode(c.tree, kidsOf(c.tree, fields[i])[0])
    let fname = c.source[nm.span.start:nm.span.end]
    let fty = structFieldLookup(c, "${recvId}." + fname)
    out = append(out, DocSymbol{ kind: "field", name: recvName + "." + fname,
      typeText: typeName(c.ctx, fty) })
    i = i + 1
  }
  return out
}

// ---- doc comments (#2725) ---------------------------------------------------

// Whether `source[start:]` starts its own source line — only whitespace (or
// nothing) separates it from the preceding '\n' (or byte 0). False for a
// TRAILING comment on a previous statement's line (`const x = 1 // note`):
// without this check, that trailing comment reads as "one newline above" the
// NEXT declaration exactly the way a real standalone doc comment does, and
// gets misattributed to it.
fn docCommentOwnLine(source: string, start: int): bool {
  let i = start - 1
  while (i >= 0 && source[i] != '\n') {
    if (source[i] != ' ' && source[i] != '\t') {
      return false
    }
    i = i - 1
  }
  return true
}

// The run of `//` line comments that ends immediately above `declStart`, in
// SOURCE order: walking backward from the closest comment before `declStart`,
// a comment joins the run only while it is itself a line comment standing
// alone on its own source line (`docCommentOwnLine` — a `/* */` block comment
// or a trailing comment on the PREVIOUS statement's line stops the walk cold)
// and at most one newline separates it from the item below — the declaration
// itself, for the first one considered, else the comment already accepted
// below it. Two or more newlines is a blank line, which ends the run so the
// comment belongs to nothing (a doc comment must be adjacent, not merely
// "somewhere above"). Capped at 64 lines, matching `docMaxSymbols`'s role of
// bounding the walk (Power of 10).
fn docLeadingCommentLines(comments: []Comment, source: string, declStart: int): []string {
  let idx = len(comments) - 1
  while (idx >= 0 && comments[idx].start >= declStart) {
    idx = idx - 1
  }
  let rev = []string(0)
  let boundary = declStart
  while (idx >= 0 && comments[idx].isLine && docCommentOwnLine(source, comments[idx].start) &&
    newlinesBetween(source, comments[idx].end, boundary) <= 1 && len(rev) < 64) {
    rev = append(rev, source[comments[idx].start:comments[idx].end])
    boundary = comments[idx].start
    idx = idx - 1
  }
  let out = []string(len(rev))
  let j = 0
  while (j < len(rev)) {
    out[len(rev) - 1 - j] = rev[j]
    j = j + 1
  }
  return out
}

// `declNode`'s doc comment, "\n"-joined with each line's own leading "//"
// kept, or "" for `declNode == 0` (a lookup that found nothing) or no
// adjacent comment run. `cache` (module id -> that module's whole comment
// set) is filled at most once per module regardless of how many of its
// exported symbols ask for one — re-lexing `owner.source` per symbol would be
// wasted work for a module with many exports (Power of 10: bounded re-work).
fn docCommentsOf(cache: map<int, []Comment>, owner: Checker, declNode: int): string {
  if (declNode == 0) {
    return ""
  }
  let (comments, ok) = cache[owner.moduleId]
  if (!ok) {
    comments = collectComments(owner.source)
    cache[owner.moduleId] = comments
  }
  let lines = docLeadingCommentLines(comments, owner.source, getNode(owner.tree, declNode).span.start)
  let out = ""
  let i = 0
  while (i < len(lines)) {
    if (i != 0) {
      out = out + "\n"
    }
    out = out + lines[i]
    i = i + 1
  }
  return out
}

// The `ConstDecl` node binding `name` at module scope, or 0 when none does —
// needed only for doc-comment attachment (#2725): unlike `funcDeclLookup` and
// `docTypeDecl`, nothing indexes a const's declaration node by name, so this
// scans the top-level declaration list the same way `isTopLevelConstBinding`
// (checkbind.bit) already does, over the same short list.
fn docConstDeclNode(owner: Checker, name: string): int {
  for d of kidsOf(owner.tree, owner.tree.root) {
    if (d == 0) {
      continue
    }
    let inner = d
    if (getNode(owner.tree, inner).tag == Tag.Export) {
      inner = kidsOf(owner.tree, inner)[0]
    }
    if (getNode(owner.tree, inner).tag != Tag.ConstDecl) {
      continue
    }
    for b of kidsOf(owner.tree, inner) {
      let pat = kidsOf(owner.tree, b)[0]
      let pn = getNode(owner.tree, pat)
      if (pn.tag == Tag.Ident && owner.source[pn.span.start:pn.span.end] == name) {
        return inner
      }
    }
  }
  return 0
}

// The exported symbols of the root module `c`, in the seed's classification: a
// name is a named type, a free function, or a module constant — anything else
// (a bare exported method name, which the self-host's `collectExports` also
// records) matches no category and is skipped, exactly as the seed's `else => {}`.
//
// `withFields` is OFF by default (`--fields`, #3039) and additive-only: the
// plain/`--json` shapes stage0 already emits are unchanged with it off, which
// is load-bearing for two things past this file — `selfhost-diffdoc.sh` diffs
// this output byte-for-byte against the PINNED PREVIOUS release, which never
// emitted field lines and cannot be made to; and `_tests_/bit/stdlibdocs.bit`
// fails the build on any exported symbol with no `docs/stdlib/*.md` section,
// and no stdlib page documents its structs' individual fields today. Turning
// this on unconditionally would redden both for reasons unrelated to this
// change. `--fields` exists so a caller that wants the fuller surface (the
// release-surface gate this was added for) can ask for it without disturbing
// either.
fn collectDoc(c: Checker, withFields: bool): []DocSymbol {
  let out = []DocSymbol(0)
  // Module id -> its comment set, filled lazily by docCommentsOf so a
  // module's source is re-lexed for comments at most once for this whole
  // walk, however many of its names this module exports (#2725).
  let docCache = map<int, []Comment>{}
  for (n, _) of c.exports {
    if (len(out) >= docMaxSymbols()) {
      return out
    }
    let td = docTypeDecl(c, n)
    if (td != 0) {
      let id = userTypeLookup(c, n)
      let params = docTypeParamsText(c, td)
      let kind = docTypeKind(c, td)
      // An enum's variants ARE its meaning (#2279), so every enum entry
      // carries them; every other kind gets the zero-value empty slice.
      let variants = []DocVariant(0)
      if (kind == "enum") {
        variants = docEnumVariants(c, td, id)
      }
      // typeText is deliberately `n + params`, not `typeName(c.ctx, id)`: the
      // latter renders the same "n" back (a named type's own id is never an
      // instantiation of itself), so the two were always identical — the
      // "enum Option Option" doubling this replaces (#2724). `td` is always
      // in `c`'s own tree (docTypeDecl's own doc comment), so the doc lookup
      // never needs an owner hop.
      out = append(out, DocSymbol{ kind: kind, name: n,
        params: params, typeText: n + params, variants: variants,
        doc: docCommentsOf(docCache, c, td) })
      out = docAppendMethods(c, out, n, id)
      // Enum/interface/type-alias decl nodes do not share StructDecl's
      // shape (kid 2 is not a FieldList), so this is class-only.
      if (withFields && kind == "class") {
        out = docAppendFields(c, out, n, id, td)
      }
      continue
    }
    let sig = funcSigLookup(c, n)
    if (sig != 0) {
      // Unlike a const's ConstDecl, `n` landing in `funcSigs` does not by
      // itself mean `c` exports a free function called `n`: `importName`
      // copies an imported function's signature into the IMPORTER's `funcSigs`
      // too (for the importer's own call sites to type against), so a module
      // that imports a name for internal use and separately exports something
      // else under the identical bare name — e.g. a method, which
      // `collectExports` also records into `c.exports` by its bare name, per
      // the comment above — sees `sig != 0` here for a name it never declares
      // itself. Bit has no re-export syntax, so a genuine free-function export
      // always has `declOwner(c, n) == c` (`docFuncParamsText`'s comment draws
      // the same owner-vs-importer distinction for generics text); anything
      // else is a same-name import that merely happens to also be a key of
      // `c.exports`, and is correctly skipped (#3734).
      let owner = declOwner(c, n)
      if (owner.moduleId == c.moduleId) {
        let fdecl = funcDeclLookup(c, n)
        let params = docFuncParamsText(owner, fdecl)
        out = append(out, DocSymbol{ kind: "function", name: n, params: params,
          doc: docCommentsOf(docCache, owner, fdecl),
          typeText: typeName(c.ctx, sig) })
      }
      continue
    }
    let (ct, isConst) = c.moduleEnv[n]
    if (isConst) {
      // No re-export syntax (SPEC has none), so `n`'s ConstDecl is always in
      // `c`'s own tree — `declOwner` is still the uniform way to say so.
      let owner = declOwner(c, n)
      let cdecl = docConstDeclNode(owner, n)
      out = append(out, DocSymbol{ kind: "const", name: n,
        typeText: typeName(c.ctx, ct), doc: docCommentsOf(docCache, owner, cdecl) })
      continue
    }
  }
  return sortDoc(out)
}

// Insertion sort by name, bytewise (`strCompare`) — matching the seed's
// `std.mem.lessThan(u8, a.name, b.name)`. Module symbol counts are small; O(n²)
// is negligible and keeps the order provably total.
fn sortDoc(syms: []DocSymbol): []DocSymbol {
  let i = 1
  while (i < len(syms)) {
    let cur = syms[i]
    let j = i - 1
    while (j >= 0 && strCompare(syms[j].name, cur.name) > 0) {
      syms[j + 1] = syms[j]
      j = j - 1
    }
    syms[j + 1] = cur
    i = i + 1
  }
  return syms
}

