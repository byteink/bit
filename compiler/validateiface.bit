// Self-host: validation of type assertions, destructuring, interface boxing and
// conversions (#1503, split out of validate.bit).

// ---- E0041 impossible type assertion (§14.4) -------------------------------

// Does candidate type `cand` satisfy interface `iface` — i.e. carry every one of
// its methods with a matching signature (§14.3)? Both a class method and an
// interface method intern their `(params) => result` shape into methodSigs, and
// interning dedups, so equal ids mean equal shapes. Non-generic interfaces only
// (a Self-parameterised one is skipped by the type-param guard at the call site).
//
// TWO TABLES, because an interface's method set is not recorded in one place
// (#2237). `methodSigs` holds the full `(params) => result` shape for every
// DECLARED interface — user-written ones, and their generic instantiations. The
// PREDECLARED `error` (§10.6) has no declaration to walk, so `checkModule`
// registers its single method as a bare RESULT in `methodResults` and nothing at
// all in `methodSigs`. Reading only `methodSigs` therefore gave `error` an empty
// method set, the loop below ran zero times, and every class in the language
// "satisfied" it: `let e: error = NotAnError{ code: 7 }` passed `bit check`,
// linked, and SIGSEGV'd on the first `message()` — through a dispatch slot that
// no method table had ever filled. That is the one interface SPEC §18.3 tells
// users to satisfy structurally, and it was the one that was not checked.
//
// The result loop deliberately SKIPS any name the signature loop already judged,
// so a declared interface's verdict is unchanged to the bit: only a method
// recorded in `methodResults` alone adds a requirement, and today that is
// exactly `error.message`.
//
// It also judges PRESENCE separately from TYPE, the distinction `vHasMember`
// exists for. A method whose own result type failed to resolve is recorded with
// type 0, which a `!= 0` lookup cannot tell apart from "no such method" — the
// read that once invented 13 E0057s across stdlib/crypto. Absent means absent;
// present with an unresolved result stays permissive, per the safety rule.
fn vSatisfies(c: Checker, cand: int, iface: int): bool {
  if (cand == 0 || iface == 0) {
    return true // cascade suppression
  }
  if (c.ctx.types[iface].kind != TypeKind.Interface) {
    return cand == iface
  }
  let prefix = "${iface}."
  for (k, sig) of c.ctx.methodSigs {
    if (len(k) > len(prefix) && k[0:len(prefix)] == prefix) {
      let name = k[len(prefix):len(k)]
      let have = methodSigLookup(c, "${cand}." + name)
      if (have == 0 || have != vBindSelf(c, sig, cand)) {
        return false
      }
    }
  }
  for (k, res) of c.ctx.methodResults {
    if (len(k) <= len(prefix) || k[0:len(prefix)] != prefix) {
      continue
    }
    if (methodSigLookup(c, k) != 0) {
      continue // already judged, more strictly, by the signature loop above
    }
    let key = "${cand}." + k[len(prefix):len(k)]
    if (!vHasMember(c.ctx.methodResults, key) && !vHasMember(c.ctx.methodSigs, key)) {
      return false // the method is absent outright
    }
    let have = methodResultLookup(c, key)
    if (have != 0 && res != 0 && have != res) {
      return false // present, but returning something else
    }
  }
  return true
}

// `iface`'s method names, in DECLARATION source order — never map iteration
// order, which is arbitrary relative to the source (`c.ctx.methodSigs` is a
// hash map) and would make `vSatisfyReason`'s choice of which failing method
// to name look randomly chosen. Mirrors `vMissingStructFields`
// (validatezero.bit), the same decl-node walk for a class's fields.
//
// Empty for the predeclared `error` (§10.6), which has no declaration to
// walk — #2237 gave it a satisfaction check, so this path is now reachable
// and must answer "" (no reason), not crash or invent one.
fn vIfaceMethodNames(c: Checker, iface: int): []string {
  let oc = typeOwner(c, iface)
  let decl = declNodeIn(oc, Tag.InterfaceDecl, c.ctx.types[iface].name)
  if (decl == 0) {
    return []string(0)
  }
  let out = []string(0)
  for s of kidsOf(oc.tree, kidsOf(oc.tree, decl)[2]) {
    let n = getNode(oc.tree, kidsOf(oc.tree, s)[0])
    out = append(out, oc.source[n.span.start:n.span.end])
  }
  return out
}

// Why `cand` fails to satisfy `iface`, as a hint string for E0041, or "" when
// there is nothing to say (satisfies after all, or `iface` has no declaration
// to walk — the predeclared `error`). Same walk and same verdict as
// `vSatisfies` — deliberately a SEPARATE function so the hot accept path
// stays a bare bool and can never drift from the message: this is only ever
// called by `vMismatch`, on a path that has already failed `vSatisfies`, to
// explain why.
fn vSatisfyReason(c: Checker, cand: int, iface: int): string {
  let cn = typeName(c.ctx, cand)
  let inm = typeName(c.ctx, iface)
  for m of vIfaceMethodNames(c, iface) {
    let want = methodSigLookup(c, "${iface}." + m)
    let key = "${cand}." + m
    if (!vHasMember(c.ctx.methodSigs, key) && !vHasMember(c.ctx.methodResults, key)) {
      return "'${cn}' has no method '${m}'; '${inm}' needs ${typeName(c.ctx, want)}"
    }
    let have = methodSigLookup(c, key)
    if (have != 0 && want != 0 && have != want) {
      return "'${cn}.${m}' is ${typeName(c.ctx, have)}, but '${inm}' needs ${typeName(c.ctx, want)}"
    }
  }
  return ""
}

// Binds every `Self` occurrence inside a declared method signature `sig` to
// the candidate type `cand` under test, so `less(other: Self): bool` is
// compared against `P.less`'s `(P) => bool` as `(P) => bool`, not as
// `(Self) => bool` (§14.3's "with Self bound to S"). A no-op (returns `sig`
// unchanged) for the overwhelming majority of signatures, which mention no
// `Self` at all.
//
// The ids to bind are collected from the SIGNATURE itself, not from `c`'s own
// `selfTypeId` — `Self` is minted lazily per module (checktype.bit), so the
// interface's declaring module may have interned a different TypeId for the
// name than this checker's own module would. Reading it off the sig is what
// makes this correct when `cand`'s checker and `iface`'s declaring checker
// differ.
fn vBindSelf(c: Checker, sig: int, cand: int): int {
  let ids = vCollectSelf(c, sig, 0, []int(0))
  if (len(ids) == 0) {
    return sig
  }
  let args = []int(0)
  let i = 0
  while (i < len(ids)) {
    args = append(args, cand)
    i = i + 1
  }
  return substType(c, sig, TypeEnv{ params: ids, args: args }, 0)
}

// Every distinct `Self`-named TypeParam id reachable inside `ty`, deduped.
// Bounded exactly like `vMentionsInvalid`/`vComparable` (Power of 10): a
// (self-referential) generic signature must not recurse forever. A method
// signature is always a `Func` (`mkFunc(params, variadic, result)`, built by
// `funcTypeFromParams`/`buildSignatures`), so both positions SPEC §11.3
// permits `Self` in — parameter and result — are reached by the Func arm.
fn vCollectSelf(c: Checker, ty: int, depth: int, acc: []int): []int {
  if (ty == 0 || depth >= 32) {
    return acc
  }
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.TypeParam) {
    if (t.name != "Self") {
      return acc
    }
    for id of acc {
      if (id == ty) {
        return acc
      }
    }
    // bit:lint allow E0214 -- no call site reads the pre-call acc/ids after the call: :169/:172/:175 tail-forward it, :178 copies it to out and never reads acc again, :180/:183 reassign out; vBindSelf:141 hands ids to substType via TypeEnv.params, but substType/typeEnvLookup/substTypeList only read env.params, and every env.params append (checkinst.bit, lowerdriver.bit, lowerglobal.bit) targets a different TypeEnv
    return append(acc, ty)
  }
  if (k == TypeKind.Slice || k == TypeKind.Chan || k == TypeKind.Array || k == TypeKind.Ptr) {
    return vCollectSelf(c, t.elem, depth + 1, acc)
  }
  if (k == TypeKind.Map) {
    return vCollectSelf(c, t.mapVal, depth + 1, vCollectSelf(c, t.mapKey, depth + 1, acc))
  }
  if (k == TypeKind.Fallible) {
    return vCollectSelf(c, t.errTy, depth + 1, vCollectSelf(c, t.result, depth + 1, acc))
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    let out = acc
    for m of t.members {
      out = vCollectSelf(c, m, depth + 1, out)
    }
    if (k == TypeKind.Func) {
      out = vCollectSelf(c, t.result, depth + 1, out)
    }
    return out
  }
  return acc
}

// Emits E0041 when `iface.(T)` asserts a target that can never be the dynamic
// type held in the interface — T does not satisfy the interface, so the assertion
// is false forever (§14.4). Only fires for a confidently-known interface receiver
// and concrete target; the span covers the whole `recv.(T)`.
fn vTypeAssert(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, typeNode]
  let recvTy = checkExprType(c, kids[0])
  let target = typeFromNode(c, kids[1])
  if (recvTy == 0 || target == 0) {
    return
  }
  if (vMentionsInvalid(c, recvTy, 0) || vMentionsInvalid(c, target, 0)) {
    return
  }
  if (vHasTypeParam(c, recvTy, 0) || vHasTypeParam(c, target, 0)) {
    return
  }
  if (c.ctx.types[recvTy].kind != TypeKind.Interface) {
    return
  }
  if (!vStorableInInterface(c, target)) {
    report(
      c.diags, ecTypeMismatch, vSpan(c, node),
      "cannot store '${typeName(c.ctx, target)}' in interface '${typeName(c.ctx, recvTy)}': only a class can be the concrete type behind an interface value",
      "an interface value is the receiver's object pointer, so a non-class has nothing to point to (§14.3)",
    )
    return
  }
  if (!vSatisfies(c, target, recvTy)) {
    reportNoHint(
      c.diags, ecTypeMismatch, vSpan(c, node),
      "impossible type assertion: '${typeName(c.ctx, target)}' does not satisfy '${typeName(
        c.ctx,
        recvTy,
      )}'",
    )
  }
}

// ---- E0041 destructuring assignment needs a two-result form (§12.6) --------

// A parenthesized two-target assignment `(a, b) = rhs` only type-checks when the
// right side is a two-result form — `m[k]`, `<- c`, or `iface.(T)` (§12.6/§14.4/
// §16.2). The parser folds `(a, b)` into a single `tuple_pat` lhs item, so the
// plain arity check waves it through; this catches an rhs that is none of those.
// Conservative: any of the three two-result tags is skipped (a slice `m[k]` that
// the seed would still reject stays MISSING, never a false positive).
fn vDestructure(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [lhs_list, rhs_list]
  let lhsItems = kidsOf(c.tree, k[0])
  let rhsItems = kidsOf(c.tree, k[1])
  if (len(lhsItems) != 1 || len(rhsItems) != 1) {
    return
  }
  let lhs0 = lhsItems[0]
  if (getNode(c.tree, lhs0).tag != Tag.TuplePat) {
    return
  }
  let targets = kidsOf(c.tree, lhs0)
  let rhs = rhsItems[0]
  let rn = getNode(c.tree, rhs)
  // A tuple right-hand side spreads positionally over the targets (SPEC §13.1),
  // so it is a valid destructure at any matching arity — not just the arity-2
  // two-result forms.
  let rt = checkExprType(c, rhs)
  if (rt != 0 &&
    c.ctx.types[rt].kind == TypeKind.Tuple &&
    len(c.ctx.types[rt].members) == len(targets)) {
    return
  }
  if (len(targets) != 2) {
    return
  }
  if (rn.tag == Tag.Index || rn.tag == Tag.TypeAssert) {
    return
  }
  if (rn.tag == Tag.Unary && rn.main == int(Kind.ArrowLeft)) {
    return // `<- c` receive
  }
  reportNoHint(
    c.diags, ecTypeMismatch, vSpan(c, node),
    "destructuring assignment needs a tuple or a two-result form on the right: a tuple-returning call, 'm[k]', '<- c', or 'iface.(T)'",
  )
}

// ---- E0041 interface-scalar store: every path a value reaches an interface ---
// slot (§14.3). The `return` site is already caught by vExpect (vAssignable now
// gates an interface target on storable+satisfies); these walkers cover the
// other slots the seed checks with the same `expect` — an annotated binding, a
// plain assignment, a call argument, a class/map/slice literal element, and a
// channel send. Each stays NARROW: it fires only for a confidently-concrete,
// non-storable (scalar) value against a confirmed interface target, emitting the
// one special "cannot store" message. A storable-but-non-satisfying value is
// left to vExpect's path, never re-judged here — porting general satisfaction
// into every slot would risk the false positives vSatisfies edge cases invite.

fn vIfaceStore(c: Checker, valueNode: int, target: int) {
  if (target == 0 || c.ctx.types[target].kind != TypeKind.Interface) {
    return
  }
  let v = valueNode
  if (getNode(c.tree, v).tag == Tag.Arg) {
    v = kidsOf(c.tree, v)[0]
  }
  let ty = checkExprType(c, v)
  if (ty == 0 || vMentionsInvalid(c, ty, 0) || vHasTypeParam(c, ty, 0)) {
    return
  }
  if (!vStorableInInterface(c, ty)) {
    report(
      c.diags, ecTypeMismatch, vSpan(c, v),
      "cannot store '${typeName(c.ctx, ty)}' in interface '${typeName(c.ctx, target)}': only a class can be the concrete type behind an interface value",
      "an interface value is the receiver's object pointer, so a non-class has nothing to point to (§14.3)",
    )
  }
}

// An annotated binding `let x: T = e` / `var x: T = e`, against its annotation.
//
// This is the #1470 hole, and it was not float-specific or array-specific: NO
// annotated binding was assignability-checked at all. `vAssignable`/`vExpect`
// were ported faithfully but had no Binding call site, so the self-hosted
// compiler accepted `let x: string = 5` and `let x: i32 = "hello"` — every one
// of which the seed rejects with E0041. A generated verdict sweep
// (scripts/selfhost-diffverdict.sh) put the count at 132 constructs the seed
// refuses and bit admitted.
//
// The assignment form `x = e` was already covered, which is why this stayed
// hidden: the shape people grep for looked checked.
fn vBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pat, annotation, init]
  // Arity guard: this runs at MODULE level too (check.bit's top-level walk), and
  // not every binding shape there carries all three kids. Indexing blind panicked
  // the compiler on stdlib/http.
  if (len(kids) < 3) {
    return
  }
  let ann = kids[1]
  let init = kids[2]
  // No annotation means no expectation (the type IS the initializer's), and a
  // tuple pattern is destructuring — arity and element types are vDestructure's.
  if (ann == 0 || init == 0 || getNode(c.tree, kids[0]).tag == Tag.TuplePat) {
    return
  }
  vExpectExpr(c, init, typeFromNode(c, ann))
}

// A plain `=` assignment: each rhs against its lhs slot's type. Compound
// assignments (`+=`, ...) are numeric and never store into an interface; the
// two-result `(a, b) = ...` form is vDestructure's.
//
// #3061 FIX: was `vIfaceStore` only, with no `vExpect*` fallback at all — so a
// storable class that did not satisfy the lhs interface's method set was
// never checked (`p = Cash{...}` for `p: Payer` built rc=0). `vExpectExpr`
// answers both vIfaceStore's narrow "cannot store" scalar case (identical
// wording, via vMismatch) and the general satisfies case, so vIfaceStore is no
// longer called here. No double-report risk: this was the ONLY check any
// plain-assignment rhs against an interface-typed lhs ever reached.
fn vAssignIface(c: Checker, node: int) {
  if (getNode(c.tree, node).main != int(Kind.Eq)) {
    return
  }
  let k = kidsOf(c.tree, node) // [lhs_list, rhs_list]
  let lhs = kidsOf(c.tree, k[0])
  let rhs = kidsOf(c.tree, k[1])
  if (len(lhs) != len(rhs)) {
    return
  }
  let i = 0
  while (i < len(lhs)) {
    if (getNode(c.tree, lhs[i]).tag != Tag.TuplePat) {
      let lty = checkExprType(c, lhs[i])
      if (lty != 0 && c.ctx.types[lty].kind == TypeKind.Interface) {
        vExpectExpr(c, rhs[i], lty)
      }
    }
    i = i + 1
  }
}

// A free-function call's arguments against interface-typed parameters. Mirrors
// vCall's resolution: a bare-ident, non-shadowed, non-generic user function
// only — a generic's params carry bare `T` (skipped), and member/builtin callees
// are the checker's own paths.
//
// #3050: this used to be the ONLY interface check any free-call argument ever
// reached, and it is narrow — vIfaceStore rejects a non-storable scalar
// (E0041, "cannot store") but never judges a storable class against the
// parameter's method set. vCall's own argument loop (validatecall.bit) now
// routes every fixed-arity, non-variadic call through vExpectExpr, which
// answers both cases correctly — so this function SKIPS exactly that shape
// (`!variadic && want == got`, mirroring vCall's own decidability guard) to
// avoid double-reporting `take(7)` for `take(p: Any)` once as "cannot store"
// from here and again from there. It stays live for a variadic callee, whose
// arguments vCall's loop never type-checks at all (it returns before the
// loop for any variadic call — see the arity block there), and for an
// arity-mismatched call, where vCall's loop is likewise never reached.
fn vCallArgIface(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]
  if (shadowedByValue(c, callee, name)) {
    return
  }
  let fr = funcRefAt(c, callee, name)
  let decl = fr.decl
  if (decl == 0) {
    return
  }
  let owner = fr.owner
  let plist = declParamListNode(owner, decl)
  if (plist < 0) {
    return // generic: param types carry bare `T`
  }
  let params = kidsOf(owner.tree, plist)
  let args = kidsOf(c.tree, kids[2])
  let want = len(params)
  let variadic = want > 0 && getNode(owner.tree, params[want - 1]).tag == Tag.ParamRest
  if (!variadic && want == len(args)) {
    return // vCall's own loop reaches this exact shape and fully covers it
  }
  let i = 0
  while (i < len(params) && i < len(args)) {
    vIfaceStore(c, args[i], typeFromNode(owner, kidsOf(owner.tree, params[i])[1]))
    i = i + 1
  }
}

// Arity (E0050) and, for a fixed non-generic signature, each argument's type
// (E0041) against an already-resolved func TYPE `sig` — shared by vMethodCall
// (a concrete method's signature) and vCallValue's tail (validatestmt.bit, a
// func-typed value/slice/map-element/class-field callee, #2786). One
// implementation for both: the rule is identical once the callee's signature
// is in hand, so the two call sites used to carry it twice. Permissive on
// every shape whose rule is not ported, exactly as vCall is for a free
// function: variadic, generic, spread, or any type carrying an inference gap.
fn vCallAgainstFuncSig(c: Checker, node: int, sig: int) {
  let ftt = c.ctx.types[sig]
  if (ftt.variadic) {
    return
  }
  if (vMentionsInvalid(c, sig, 0) || vHasTypeParam(c, sig, 0)) {
    return
  }
  let params = ftt.members
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let got = len(args)
  // A spread has no variadic slot to land in on a fixed signature; E0063
  // (elsewhere) already rejects it, so judging arity here too would restate
  // that rule with the wrong number.
  for a of args {
    if (getNode(c.tree, a).tag == Tag.ArgSpread) {
      return
    }
  }
  let want = len(params)
  if (want != got) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "expected ${want} argument(s), found ${got}",
    )
    return
  }
  let i = 0
  while (i < got) {
    let a = args[i]
    if (getNode(c.tree, a).tag == Tag.Arg) {
      a = kidsOf(c.tree, a)[0]
    }
    // #3050 FIX: was vExpectExprNonIface, skipping an interface parameter on
    // the claim that "vIfaceStore's rule" covered it "elsewhere" — but
    // vIfaceStore is never called on a method or func-value call's arguments
    // at all (confirmed by grep: its only call sites are vAssignIface,
    // vCallArgIface — free calls only — an interface-typed channel send, and
    // validatezero.bit's zero-value paths). So a class argument that did not
    // satisfy an interface-typed method or func-value parameter was never
    // checked: `h.take(cash)` built rc=0 and segfaulted exactly like the
    // free-call shape vCall now fixes. No double-report risk here: nothing
    // else answers an interface-typed argument for this call shape.
    vExpectExpr(c, a, params[i])
    i = i + 1
  }
}

// A method call `recv.method(args)` (#2755), OR a call through a func-typed
// STRUCT FIELD (#2786, SPEC §9.4) — `mk[0]` is the receiver expression,
// `mk[1]` the member-name leaf. Called from vCallValue (validatestmt.bit) for
// every Member callee.
//
// The method path works identically for a concrete class receiver and an
// interface-typed one: `buildSignatures` (checkbind.bit) records BOTH a
// class method's and an interface method's signature in the SAME
// `methodSigs` table, keyed "<recvTypeId>.<name>" — one lookup separates a
// real method from a func-typed field of the same name (a field has no such
// entry), so the two ARE separable, contrary to a comment this once carried.
//
// When that lookup misses, the member is a func-typed field IF the receiver
// is a class and `structFieldLookup` — the same table `checkMember`'s own
// class-field branch (checkbind.bit) reads — resolves the field to a Func
// type; anything else (a plain non-func field, or a receiver that is not a
// class at all) is left unvalidated, same as before #2786.
//
// A NAMESPACED call (`ns.fn(...)`, also a Member) never reaches either
// lookup: a namespace alias is bound only under "ns.name" keys
// (bindNamespaceImport, checkproject.bit), never as a value in its own right,
// so `checkExprType(c, mk[0])` on the bare alias already returns 0 above and
// this function returns before either lookup runs. That is the existing
// guard the method path already relied on, not a new one.
fn vMethodCall(c: Checker, node: int, mk: []int) {
  let recvType = checkExprType(c, mk[0])
  if (recvType == 0) {
    return
  } // bit2 could not type the receiver
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  let recvKey = "${methodRecvType(c, recvType)}.${mname}"
  let sig = methodSigLookup(c, recvKey)
  if (sig == 0) {
    if (c.ctx.types[recvType].kind != TypeKind.Struct) {
      return
    } // not a class: no field to fall back to
    sig = structFieldLookup(c, recvKey)
    if (sig == 0 || c.ctx.types[sig].kind != TypeKind.Func) {
      return
    } // absent or non-callable field
  }
  vCallAgainstFuncSig(c, node, sig)
}

// ---- E0053 conversions (§12.9) ---------------------------------------------

// A numeric prim index (§11.1): the signed and unsigned integers plus the two
// floats occupy 0..9 in `primIndexByName` order, `bool` and `string` follow.
fn vPrimIsNumeric(p: int): bool { return p >= 0 && p <= 9 }

// An integer prim index — numeric minus the two floats.
fn vPrimIsInteger(p: int): bool { return p >= 0 && p <= 7 }

// Emits E0053 for a conversion whose source type cannot reach its target
// (§12.9). Mirrors the seed's `checkConstruction` prim branch in
//
//
// This call site did not exist at all — the same shape as #1470, where
// `vAssignable`/`vExpect` were faithfully ported but nothing invoked them for a
// `Tag.Binding`. `vNotCallable` deliberately RETURNS on a primitive callee
// ("a conversion `i64(x)`, a type constructor, or a builtin") because it is
// judging callability, and no other pass looked at the argument. So
// `string(someI64)` type-checked to `string`, lowered to a `string_from_*`
// that never existed for that source, and SIGSEGV'd at runtime — the compiler
// users get accepting a program the oracle rejects, with a crash rather than a
// diagnostic as the consequence (#1490).
//
// The target name printed is the CANONICAL prim (`primName`), not the alias the
// user wrote, so `int(x)` reports 'i64' exactly as the seed does.
fn vConversion(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]

  // Every callable spelling that could SHADOW a prim name is cleared first, for
  // the same reason `vNotCallable` does it: bit2's env is flat, so a local or a
  // user decl called `string` would otherwise be judged as the conversion.
  if (funcRefAt(c, callee, name).decl != 0 || funcSigLookup(c, name) != 0) {
    return
  }
  if (userTypeLookup(c, name) != 0 || shadowedByValue(c, callee, name)) {
    return
  }
  let p = primIndexByName(name)
  if (p < 0) {
    return
  }

  // Arity is a separate diagnostic; judge only the well-formed one-argument
  // shape so a malformed call reports once.
  let args = kidsOf(c.tree, kids[2])
  if (len(args) != 1) {
    return
  }
  // Arguments arrive wrapped in an `Arg` node, which `checkExprType` has no case
  // for and would silently type as 0 — reading as "did not infer" and taking
  // the permissive path, which is how this check would appear to pass while
  // never firing.
  let arg = args[0]
  if (getNode(c.tree, arg).tag == Tag.Arg) {
    arg = kidsOf(c.tree, arg)[0]
  }

  let at = checkExprType(c, arg)
  // THE SAFETY RULE: a type bit2 did not infer, or one still carrying a type
  // param, is this compiler's gap and not the program's. Stay permissive.
  if (at == 0 || vMentionsInvalid(c, at, 0) || vHasTypeParam(c, at, 0)) {
    return
  }

  let k = c.ctx.types[at].kind
  let ok = false
  if (k == TypeKind.Prim) {
    ok = vPrimIsNumeric(p) && vPrimIsNumeric(c.ctx.types[at].prim)
  } else if (k == TypeKind.UntypedInt || k == TypeKind.UntypedFloat || k == TypeKind.UntypedRune) {
    ok = vPrimIsNumeric(p)
  } else if (k == TypeKind.UntypedString) {
    ok = p == 11
  } else if (k == TypeKind.Ptr) {
    // `int(p)` (§11.4): a raw pointer's address as an integer. Both are one
    // word and codegen's `convert` is the identity.
    ok = vPrimIsInteger(p)
  } else if (k == TypeKind.Enum) {
    // A C-like enum is an integer tag, so `int(tag)` yields it. A payload enum
    // is a boxed object with no integer value — use `match`.
    ok = vPrimIsInteger(p) && !c.ctx.types[at].enumBoxed
  } else if (k == TypeKind.Slice) {
    // `string([]u8)` copies bytes verbatim. A `[]rune`/`[]i32` source would
    // need UTF-8 encoding (deferred with rune iteration, #348 unit D), so it is
    // rejected rather than silently narrowing each code point to a byte.
    ok = p == 11 && c.ctx.types[at].elem == primType(c.ctx, 4)
  }
  if (ok) {
    return
  }

  let an = typeName(c.ctx, at)
  let tn = primName(p)
  reportNoHint(
    c.diags, ecInvalidOperand, vSpan(c, node),
    "cannot convert '${an}' to '${tn}'",
  )
}

// The USER-TYPE half of the same §12.9 conversion rule (#1898).
//
// `vConversion` above returns on `userTypeLookup(c, name) != 0`, so a conversion
// to a user-declared type was judged by NOTHING: `E(5)` (an int to an interface
// it does not implement) and `B(a)` (one class to an unrelated class) both
// type-checked, and the lowerer then refused the whole enclosing function with
// no span and no named expression. That is the #1490 shape this file's header
// already describes — a check that returns early because "some other pass will
// look at it", when no other pass does.
//
// The two legal targets are judged by the rules that already exist rather than
// by new ones, which is what keeps this consistent with the implicit spelling:
// an interface target is a STORE INTO AN INTERFACE SLOT (`vIfaceStore`, the same
// rule `let e: E = car` and a channel send go through), and every other target
// is ordinary assignability (`vAssignable`), which covers a type alias reaching
// its underlying type and a class converted to itself.
fn vUserConversion(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]

  // A callable spelling of the same name wins over the type, exactly as in
  // `vConversion` and for the same flat-env reason.
  if (funcRefAt(c, callee, name).decl != 0 || funcSigLookup(c, name) != 0) {
    return
  }
  if (shadowedByValue(c, callee, name)) {
    return
  }
  let dst = userTypeLookup(c, name)
  if (dst == 0) {
    return
  }
  // A class declaring 'init' (classinit.bit, #3371): `Account(500)` calls the
  // constructor, not this §12.9 conversion — vCall (validatestmt.bit) already
  // routed it through vClassConstructCall, judged against 'init's own params.
  if (classInitNode(c, dst) != 0) {
    return
  }

  // Arity is a separate diagnostic; judge only the well-formed one-argument
  // shape so a malformed call reports once.
  let args = kidsOf(c.tree, kids[2])
  if (len(args) != 1) {
    return
  }
  let arg = args[0]
  if (getNode(c.tree, arg).tag == Tag.Arg) {
    arg = kidsOf(c.tree, arg)[0]
  }

  let at = checkExprType(c, arg)
  // THE SAFETY RULE, as in `vConversion`: a type this compiler did not infer, or
  // one still carrying a type param, is its own gap and not the program's.
  if (at == 0 || vMentionsInvalid(c, at, 0) || vHasTypeParam(c, at, 0)) {
    return
  }
  if (vMentionsInvalid(c, dst, 0) || vHasTypeParam(c, dst, 0)) {
    return
  }

  // #3064 FIX: was `vIfaceStore` only, with no `vExpect*` fallback — same hole
  // as #3050/#3061's five sites. `vIfaceStore` catches only a non-storable
  // scalar (E0041 "cannot store"); a storable class that does not satisfy
  // `dst`'s method set went unchecked, so `Payer(cash)` for a `Cash` missing
  // `pay()` built rc=0 and segfaulted on the first dispatch through the empty
  // method table. `vExpectExpr` answers both: the identical narrow case (via
  // `vMismatch`) and the general satisfies case, so `vIfaceStore` is no longer
  // called here. No double-report risk: `vCall` (validatecall.bit) never
  // reaches this argument — `vUserConversion` only fires when the callee name
  // resolves to a TYPE, not a function, so `vRuntimeBuiltinArity` (the only
  // check `vCall` runs for a non-function callee) is a no-op for it
  // (`runtimeBuiltinArity` returns -1 for a type name); this was the only
  // check this argument ever reached.
  if (c.ctx.types[dst].kind == TypeKind.Interface) {
    vExpectExpr(c, arg, dst)
    return
  }
  if (vAssignable(c, at, dst)) {
    return
  }

  let an = typeName(c.ctx, at)
  let tn = typeName(c.ctx, dst)
  reportNoHint(
    c.diags, ecInvalidOperand, vSpan(c, node),
    "cannot convert '${an}' to '${tn}'",
  )
}

// A channel send `ch <- v`: the sent value against the channel's element type.
//
// #3061 FIX: was `vIfaceStore` + `vExpectExprNonIface`, where
// `vExpectExprNonIface` explicitly returns on an Interface-kind target — so an
// interface-typed channel element reached only vIfaceStore's narrow "cannot
// store" scalar check, never the general satisfies check (`ch <- Cash{...}`
// for `chan<Payer>` built rc=0). `vExpectExpr` answers both, so vIfaceStore is
// no longer called here. No double-report risk: these were the only two
// checks reaching this exact node/target pair.
fn vSendIface(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [chan_expr, value_expr]
  let chanTy = checkExprType(c, k[0])
  if (chanTy == 0 || c.ctx.types[chanTy].kind != TypeKind.Chan) {
    return
  }
  // The sent value against the channel's element type — same #1470 hole,
  // reached through `c <- v` (§16).
  vExpectExpr(c, k[1], c.ctx.types[chanTy].elem)
}

// A `select` comm clause (§16.3, mirrors the seed's checkComm): each `case` must
// be a `send_stmt` with a channel-typed lhs or a `recv_bind` with a
// channel-typed operand. The selfhost parser, unlike the seed's, does not
// normalize a bare expression with no `<-` into a `recv_bind` (#1693's
// parseComm comment) — so a shape that is neither tag reaches here directly,
// and is judged as an attempted receive against itself, matching the seed's
// "receive requires a channel operand" wording for the same source (its parser
// gets there via the opposite route: wrapping the bare expr as `recv_bind`
// before `checkComm` ever sees it).
fn vComm(c: Checker, node: int) {
  let t = getNode(c.tree, node).tag
  if (t == Tag.SendStmt) {
    let k = kidsOf(c.tree, node) // [chan_expr, value_expr]
    let chanTy = checkExprType(c, k[0])
    if (chanTy == 0 || vMentionsInvalid(c, chanTy, 0)) {
      return
    }
    if (c.ctx.types[chanTy].kind != TypeKind.Chan) {
      reportNoHint(
        c.diags, ecInvalidOperand, vSpan(c, k[0]),
        "send requires a channel operand, found '${typeName(c.ctx, chanTy)}'",
      )
    }
    return
  }
  let operand = node
  if (t == Tag.RecvBind) {
    operand = kidsOf(c.tree, node)[1]
  }
  let ty = checkExprType(c, operand)
  if (ty == 0 || vMentionsInvalid(c, ty, 0)) {
    return
  }
  if (c.ctx.types[ty].kind != TypeKind.Chan) {
    reportNoHint(
      c.diags, ecInvalidOperand, vSpan(c, operand),
      "receive requires a channel operand, found '${typeName(c.ctx, ty)}'",
    )
  }
}

