// compiler/lowerexplode.bit — #4404: a parameter passed as more than one word.
//
// THE DESIGN, and why it costs nothing to build. `runtime/ABI.md` §1.1 costed a
// register-PAIR calling convention and rejected it: one SSA value occupying two
// physical locations needs a new `PLoc` kind, a multi-location `LiveInterval`, a
// per-word `isRef` and a changed stack-map shape. That ruling stands for the
// design it costed.
//
// This is a different design and §1.1 never named it. The aggregate is taken
// apart in the LOWERER, above the backend, into N independent single-word SSA
// values — so there is never a multi-location value, and `marshalArgs`,
// `PLoc`, `LiveInterval`, `StackMapEntry`, the `.bit_gc` wire format and
// `runtime/gc/stackmap.bit` are all untouched. `marshalArgs` walks an argument
// LIST and `bindIncomingArgs` walks a parameter LIST; explosion makes both
// lists longer and neither function changes.
//
// SCOPE, as it stands. #4404 opened with exactly two words, ARGUMENTS ONLY,
// for a free non-generic non-extern non-`@symbol` function; #4405 widened the
// width to two-or-more and added the RETURN side; #4423 admits `string` as
// three words on the argument side (`explodedWordTypes`'s `explodeStr`), behind
// `Lowerer.explodeStrings`, and excludes VARIADIC declarations whose parameter
// list does not describe what arrives. The return side keeps the one-handle
// convention for a `string` until #4424 — `explodedRetWords` is the one call
// that pins it.
//
// WHY THE CALLEE HOLDS THE WORDS RATHER THAN RE-BOXING THEM. Rebuilding the
// aggregate at function entry is correct and was measured to be a
// pessimization: the box survives every optimization, because a local is
// threaded through each control-flow join as a block parameter and dead block
// parameters are not stripped. So an exploded parameter IS its words
// (`declareExplodedParam`), and `localRead` materializes a box only where
// something genuinely needs the whole aggregate — adjacent to its use, in the
// same block, where store-to-load forwarding and dead-allocation elimination
// remove it.

// The per-word types of a parameter type this compiler passes as more than one
// word, or an EMPTY list for the one-word convention every other type uses.
//
// The shape: a tuple of at least two members, each exactly one 8-byte field.
// A member must be a full word because a word IS the unit both `marshalArgs`
// and the stack map deal in — a narrower member would need a packing rule that
// does not exist. A member may be a GC reference; each word carries its own
// type, so the traced one gets its own `isRef` interval exactly as a boxed
// handle does.
//
// #4405 widened the width from exactly two to two-or-more. The ARGUMENT side
// needs no budget: a word past the eighth marshals through the existing
// outgoing-stack-argument path. The RETURN side has no such path (#4238), so
// its own budget lives in `retWordsFitRegisters` rather than here — one shape
// rule, and the one place the two directions genuinely differ is named.
//
// `explodeStr` is #4423: a `string` is three words (`{ptr, len, base}`, fixed
// at 0/8/16 by `runtime/ABI.md` §2.3) rather than one handle. It is a
// PARAMETER of this function rather than a second predicate beside it, and
// that is the whole point — #4412 shipped a truncating miscompile because one
// consumer of the width rule was widened and another was not, so the width
// rule stays SINGLE and each caller states which ABI direction it is asking
// about. Today the argument side passes `explodeStrings` and the return side
// passes `false` (`explodedRetWords`); #4424 flips that one call.
//
// A `string` is admitted by NAME, not by the tuple shape above, because it is
// a prim: `ctx.types[string].kind` is not `Tuple` and it has no members. The
// two constructors that build and read its box (`boxStringWords`,
// `stringWordTypes`, lowerexplodestr.bit) are named there for the same reason.
fn explodedWordTypes(ctx: TypeContext, ty: int, explodeStr: bool): []int {
  if (explodeStr && ty == primType(ctx, 11)) {
    return stringWordTypes(ctx)
  }
  if (ty == 0 || ctx.types[ty].kind != TypeKind.Tuple) {
    return []int(0)
  }
  let members = ctx.types[ty].members
  if (len(members) < 2) {
    return []int(0)
  }
  let i = 0
  while (i < len(members)) {
    if (fieldLayoutFor(ctx, members[i]).size != 8) {
      return []int(0)
    }
    i = i + 1
  }
  return members
}

// Whether any of `paramTypes` is passed as words. The cheap gate every caller
// runs first, so a signature with no tuple and no `string` in it costs one kind
// test per parameter and allocates nothing.
fn anyExplodedParam(ctx: TypeContext, paramTypes: []int, explodeStr: bool): bool {
  let i = 0
  while (i < len(paramTypes)) {
    if (len(explodedWordTypes(ctx, paramTypes[i], explodeStr)) != 0) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether `decl`'s parameters are marshalled as words. The answer has to be the
// SAME at the declaration and at every direct call site, so it is derived from
// the declaration alone and never from the call.
//
// Five exclusions, each because the declaration is not the only contract:
//
//   - an `extern fn` binds a foreign symbol whose ABI this compiler does not own;
//   - a METHOD reaches its callers through vtable dispatch (`Op.CallIface`) as
//     well as by name, and there the interface's method signature is the
//     contract — outside the direct-call producers this change can see;
//   - a GENERIC's call site holds template types where the instance's body
//     holds substituted ones, so the two sides could classify differently;
//   - a `@symbol`-pinned name exists precisely so something outside this
//     compiler can call it;
//   - a VARIADIC signature's parameter list does not describe the values that
//     arrive. `paramsAreVariadic` (checklookup.bit) keeps the tail interned as
//     its ELEMENT type `T` while the value the callee is handed is the
//     collected `[]T` — one word. `explodeCallArgs` already tells those apart
//     at the call site with its shape test, but `explodeParamTypes` on the
//     CALLEE side has only the declared type to read, so `...parts: string`
//     would give the callee three block parameters for a one-word slice.
//
// That last one is #4423's, and it is a real hole rather than a precaution:
// `...xs: (i64, i64)` has the same shape and would have mis-lowered since
// #4404 — there is no such declaration in the tree, which is why nothing
// caught it. `...parts: string` is `_tests_/cases/run_variadic.bit`, which the
// golden suite compiles, so the string flip reaches it.
//
// Getting this wrong is loud rather than silent: `callArityEscapesInFunc`
// (verify.bit) refuses any module whose call arity disagrees with its callee.
fn explodesParams(c: Checker, decl: int): bool {
  if (decl == 0 || isExternDecl(c.tree, decl)) {
    return false
  }
  let kids = kidsOf(c.tree, decl)
  if (kids[0] != 0 || kids[2] != 0 || paramsAreVariadic(c, kids[3])) {
    return false
  }
  return funcAttrArg(c, decl, "symbol") == ""
}

// The two independent gates a parameter list can need: #4404's explosion
// eligibility (`tuples`, decided per DECLARATION by `explodesParams`) and the
// string gate (`strings`, a per-LOWERER constant — `Lowerer.explodeStrings`).
// Grouped into one struct so the functions that need both stay under the
// 5-parameter lint limit rather than growing a bare bool for every future
// coercion this file adds; a third would need the same treatment, not a
// seventh parameter.
//
// `tuples` names #4404's mechanism and `strings` #4423's, but the pair travels
// together through `explodeParamTypes`, `recordParamKeepAlive`,
// `bindParamLocals` and `explodeCallArgs` — the four places that must give the
// same answer for one signature, on both sides of the call.
class ArgExplodeGates {
  tuples: bool,
  strings: bool,
}

// The IR parameter list for `paramTypes`: an exploded parameter contributes its
// words in order, every other parameter contributes itself. `gates.tuples` is
// `explodesParams`, so an ineligible declaration keeps today's list exactly.
fn explodeParamTypes(ctx: TypeContext, paramTypes: []int, gates: ArgExplodeGates): []int {
  if (!gates.tuples || !anyExplodedParam(ctx, paramTypes, gates.strings)) {
    return paramTypes
  }
  let out = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    let words = explodedWordTypes(ctx, paramTypes[i], gates.strings)
    if (len(words) == 0) {
      out = append(out, paramTypes[i])
    } else {
      let k = 0
      while (k < len(words)) {
        out = append(out, words[k])
        k = k + 1
      }
    }
    i = i + 1
  }
  return out
}

// The argument list for a direct call to a function whose declared parameter
// types are `paramTypes`: an exploded parameter's single aggregate argument
// becomes its words, read out at the call site. When the argument was built
// here from its parts, those reads and the build cancel — same block, so
// store-to-load forwarding and dead-allocation elimination take both.
//
// An argument is expanded only when ITS OWN IR type has the same exploded shape
// as the parameter's. That is not belt-and-braces: a variadic callee's
// `paramTypes` carries the tail's ELEMENT type while the argument that arrives
// is the collected `[]T`, and the shape test is what tells those apart without
// a variadic special case here.
//
// `gates.strings` is checked even when this function's early return fires —
// independent of `gates.tuples`/`anyExplodedParam` below — because a call to an
// INELIGIBLE callee (an extern, a method, a generic instance, a `@symbol` or a
// variadic) still passes its `string` arguments as one boxed handle, and that
// is exactly the position #4431's coercion covers. When the callee IS eligible
// the argument explodes instead, so the two are alternatives rather than a
// pair: `coerceStringArgList` is reached only on the path that did not.
fn explodeCallArgs(
  ctx: TypeContext,
  b: IrBuilder,
  paramTypes: []int,
  args: []int,
  gates: ArgExplodeGates,
): []int {
  if (!gates.tuples || !anyExplodedParam(ctx, paramTypes, gates.strings)) {
    return coerceStringArgList(ctx, b, paramTypes, args, gates.strings)
  }
  let out = []int(0)
  let i = 0
  while (i < len(args)) {
    let words = explodedArgWords(ctx, paramTypes, i, b.instrs[args[i]].ty, gates.strings)
    if (len(words) == 0) {
      let ty = paramTypeAt(paramTypes, i, ctx.voidId)
      out = append(out, coerceStringToBoxedRaw(ctx, b, gates.strings, args[i], ty))
    } else {
      let ids = explodeValueWords(ctx, b, args[i], words)
      let j = 0
      while (j < len(ids)) {
        out = append(out, ids[j])
        j = j + 1
      }
    }
    i = i + 1
  }
  return out
}

// The word types argument `i` is expanded into, or an empty list to pass it
// through unchanged. `argTy` is the argument's own IR type — passed in rather
// than read from the builder here, which is what keeps this at five parameters
// with the string gate added (#4423).
//
// The shape test is not belt-and-braces. A variadic callee is excluded whole by
// `explodesParams`, but a NAMED-argument call and a spread both reorder what
// arrives, and an argument whose IR type does not have the parameter's word
// shape must be passed as one value or the call and the callee disagree on
// arity — which `callArityEscapesInFunc` (verify.bit) then refuses.
fn explodedArgWords(
  ctx: TypeContext, paramTypes: []int, i: int, argTy: int, explodeStr: bool,
): []int {
  if (i >= len(paramTypes)) {
    return []int(0)
  }
  let words = explodedWordTypes(ctx, paramTypes[i], explodeStr)
  if (len(words) == 0) {
    return []int(0)
  }
  if (len(explodedWordTypes(ctx, argTy, explodeStr)) != len(words)) {
    return []int(0)
  }
  return words
}

// Binds `name` to a parameter that arrived as words. At exactly two words the
// local IS those words: nothing is allocated, and the aggregate is materialized
// on demand by `localRead`. Otherwise the callee rebuilds the aggregate from
// the words it received, which is what the one-handle convention did.
//
// TWO REASONS TO REBUILD, and they are different in kind:
//
// ONE exclusion now, where there were two. A name the escape rule marked
// captured-and-assigned (§12.8) has to live in a heap CELL, and a cell holds
// one word, so it keeps the handle.
//
// THE SECOND EXCLUSION IS GONE BECAUSE ITS CAUSE IS GONE. `LocalBind` used to
// hold exactly two words, so this function bound `ids[0]`/`ids[1]` and DROPPED
// the rest once #4405 widened `explodedWordTypes` from `!= 2` to `< 2`:
// `localRead` rebuilt an N-member tuple out of two values and
// `take4((1,2,3,4))` returned 1200 for 1234 at exit 0 (#4412). Nothing caught
// it — `callArityEscapesInFunc` compares the call's arity against the callee's
// and both said four. #4422 widened the binding to a word LIST, which is the
// data-structure fix for that whole class rather than a guard against one
// instance of it: there is no longer a width this function can be handed and
// silently mis-bind.
//
// The exclusion does not touch the ABI, which stays derived from the
// declaration — the words still arrive in registers either way.
// #4423 adds the third reason the rebuild path can be taken, and it is why the
// constructor here is `materializeExplodedLocal` rather than `buildTuple`: a
// `string` parameter that the escape rule marked captured-and-assigned needs
// its BOX rebuilt from the three words, and `buildTuple` cannot produce that
// shape (ABI.md §2.3 fixes it at 24 bytes with `ptr_offsets = [16]`, while a
// `string` is a prim whose generic layout is one pointer).
fn declareExplodedParam(fc: FnCtx, name: string, ty: int, words: []int, ids: []int) {
  if (len(words) < 2 || stringInList(fc.boxedNames, name)) {
    declareLocal(fc, name, materializeExplodedLocal(fc, ty, ids), ty)
    return
  }
  bindExplodedWords(fc, name, ty, words, ids)
}

// Whether env slot `bd` holds words rather than one handle. The ONE predicate
// every consumer asks, so a future widening cannot reach some of them and miss
// others — which is exactly how #4412 shipped.
fn bindIsExploded(bd: LocalBind): bool {
  return len(bd.wordTys) != 0
}

// The word values of an exploded binding, word 0 first. `value` carries word 0
// so every non-exploded path (`boxTy`, the plain SSA local) keeps reading the
// field it always read.
fn bindWordValues(bd: LocalBind): []int {
  let out = [bd.value]
  let k = 0
  while (k < len(bd.hiValues)) {
    out = append(out, bd.hiValues[k])
    k = k + 1
  }
  return out
}

// Rebinds an exploded slot to a new full word list. The one writer, so the
// `len(hiValues) + 1 == len(wordTys)` invariant has a single owner.
fn setBindWordValues(bd: LocalBind, vals: []int) {
  bd.value = vals[0]
  let hi = []int(0)
  let k = 1
  while (k < len(vals)) {
    hi = append(hi, vals[k])
    k = k + 1
  }
  bd.hiValues = hi
}

// Appends an exploded binding for `name`: word 0 in `value`, the rest in
// `hiValues`, the per-word types in `wordTys`.
fn bindExplodedWords(fc: FnCtx, name: string, ty: int, words: []int, ids: []int) {
  let bd = LocalBind{
    name: name, value: 0, ty: ty, boxTy: 0,
    hiValues: []int(0), wordTys: words,
  }
  setBindWordValues(bd, ids)
  fc.env = append(fc.env, bd)
}

// Binds a `let`/`const` name to its initializer's two WORDS rather than to the
// handle, when the declared type has the exploded shape (#4410).
//
// WHY A LOCAL AND NOT ONLY A PARAMETER. #4404 explodes what ARRIVES in words,
// and a call site reads the words back out of whatever the argument is. When
// the aggregate is built in the same block as the call, the build and the reads
// cancel and the allocation dies. When it is a LOCAL declared outside the loop
// the call sits in, they cannot: the local is threaded through the loop header
// as a block parameter that the back edge redefines, so the `field_set`s stay
// outside the loop, the `field_get`s land inside it, and store-to-load
// forwarding has no path between them. Measured on `let w = (a, b)` used in a
// loop: the caller paid one live `gc_alloc` plus a `ldr` per call site, against
// none for the same call with `(a, b)` written at the site.
//
// Binding the words here removes the box from the loop-carried state entirely,
// so the two shapes lower to the same thing. `localRead` still materializes an
// aggregate for a use that genuinely wants one, adjacent to that use.
//
// The initializer is lowered EXACTLY as before and the words are read back out
// of its result — the same shape `explodedRetValues` uses for a `return`, and
// for the same reason. It is one path for `let w = (a, b)`, `let w = f()` and
// `let w = other`, rather than a words-producing variant of every expression
// form that can yield an aggregate, and correctness never rests on the
// optimizer: under `--no-optimize` the box is real and these are genuine loads.
//
// TWO EXCLUSIONS, both the same ones `declareExplodedParam` carries. A
// captured-and-assigned name (§12.8) must live in a one-word heap cell, and
// `LocalBind` holds exactly two words, so any other width keeps the handle.
fn declareLetLocal(fc: FnCtx, name: string, value: int, ty: int) {
  let words = localWordTypes(fc, ty)
  if (len(words) < 2 || stringInList(fc.boxedNames, name)) {
    declareLocal(fc, name, value, ty)
    return
  }
  bindExplodedWords(fc, name, ty, words, explodeValueWords(fc.c.ctx, fc.b, value, words))
}

// ===========================================================================
// Env-to-block-parameter threading
//
// Moved here from lower.bit under #4404, unchanged in behaviour except that
// "one value per env slot" is no longer a law: an exploded local occupies TWO
// slots' worth of words. All three walk the env in the same order, so the flat
// word list `snapshotValues` produces lines up position-for-position with the
// parameters `addJoinParams` declares and with what `restoreValues` consumes.
// ===========================================================================

// The current value ids of the first `n` env locals (a control-flow snapshot),
// flattened by word.
fn snapshotValues(fc: FnCtx, n: int): []int {
  let vals = []int(0)
  let i = 0
  while (i < n) {
    vals = append(vals, fc.env[i].value)
    let k = 0
    while (k < len(fc.env[i].hiValues)) {
      vals = append(vals, fc.env[i].hiValues[k])
      k = k + 1
    }
    i = i + 1
  }
  return vals
}

// Restores the locals a snapshot covers from their word list (after a branch
// that reassigned some of them). Walks env slots consuming words, so a snapshot
// taken over the first `n` slots restores exactly those `n`.
fn restoreValues(fc: FnCtx, vals: []int) {
  let i = 0
  let k = 0
  while (k < len(vals)) {
    let run = [vals[k]]
    k = k + 1
    let j = 0
    while (j < len(fc.env[i].hiValues)) {
      run = append(run, vals[k])
      k = k + 1
      j = j + 1
    }
    setBindWordValues(fc.env[i], run)
    i = i + 1
  }
}

// At a reachable join, gives the current block one parameter per in-scope
// local's WORD (the first `n` locals) and rebinds each local to its new
// block-param values — the seed's addLoopParams. Params are added in env order,
// each exploded local's low word before its high one.
fn addJoinParams(fc: FnCtx, n: int) {
  let i = 0
  while (i < n) {
    if (bindIsExploded(fc.env[i])) {
      let ids = []int(0)
      let k = 0
      while (k < len(fc.env[i].wordTys)) {
        ids = append(ids, builderAddParam(fc.b, fc.env[i].wordTys[k]))
        k = k + 1
      }
      // #4406, and this site was missing it. A join MINTS new value ids for
      // every word, so the keepalive edges recorded where the local was bound
      // name values that no longer exist on this side of the join. An
      // exploded local whose untraced word is an INTERIOR pointer — which is
      // exactly what #4422 makes a string's `ptr` — then has nothing holding
      // its base's live interval open past the join, and the collector is
      // free to sweep the bytes it points into. The symptom is a wrong answer
      // rather than a crash (the bytes are swept, not necessarily reused), so
      // no gate in the suite would report it; #4425 owns proving it with a
      // mutant. Costs nothing for a tuple, whose words are all base pointers.
      recordWordKeepAlive(fc.c.ctx, fc.b, fc.env[i].wordTys, ids)
      setBindWordValues(fc.env[i], ids)
    } else {
      fc.env[i].value = builderAddParam(fc.b, bindSlotTy(fc.env[i]))
    }
    i = i + 1
  }
}

// ===========================================================================
// #4405: the RETURN side — a result handed back in more than one ABI return
// register instead of as one handle to a heap box.
//
// The backend half already existed and was reached by nothing: `retRegsFor`
// (arm64.bit), `bindCallResults` and `emitMultiWordRet` (arm64call.bit) are
// generalized by W. What was missing is a front end that produces W > 1.
//
// The decision is derived from the callee's DECLARATION and from nowhere else,
// exactly as `explodesParams` is, because the callee's `ret` and every one of
// its call sites are lowered in different functions and must agree.
// ===========================================================================

// Whether every word of a W-word return has an ABI return register.
//
// #4238 decided there is NO spill path for a return word above the budget and
// that none is to be built: `emitOutgoingStackArg` stores into the CALLER's
// frame before the `bl`, which is the wrong owner and the wrong direction for
// a value the CALLEE produces, and the frame layout has no caller-owned return
// area at all. `retRegsFor` asserts that budget.
//
// So the boundary is handled HERE, by refusing the shape: a result too wide to
// lower keeps today's one-handle convention, which is why no source program
// can reach that assert. The budget is `maxArgRegs()`, read from the same
// place `argReg` reads it, so the limit has one owner rather than a copy that
// can drift from it.
fn retWordsFitRegisters(ctx: TypeContext, words: []int): bool {
  let ints = 0
  let floats = 0
  let i = 0
  while (i < len(words)) {
    if (regClassOf(ctx, words[i]) == RegClass.Int) {
      ints = ints + 1
    } else {
      floats = floats + 1
    }
    i = i + 1
  }
  return ints <= maxArgRegs() && floats <= maxArgRegs()
}

// `decl`'s declared result type, or 0 for a void result or a FALLIBLE one.
//
// Fallible is excluded whole. A `T!E` body returns through four separate
// producers — the `return` statement, `fail`'s zero-ok return, the fall-off
// epilogue and the wrapper `emitFallibleMainWrapper` synthesizes — and each
// also owes the error slot (§11.6). The ABI needs every one of them to agree
// on the width; buying that agreement is its own ticket, not a side effect of
// this one.
fn declPlainResultType(c: Checker, decl: int): int {
  let kids = kidsOf(c.tree, decl)
  if (kids[4] == 0) {
    return 0
  }
  let raw = typeFromNode(c, kids[4])
  if (raw == 0 || c.ctx.types[raw].kind == TypeKind.Fallible) {
    return 0
  }
  return raw
}

// The per-word types `decl`'s result is returned in, or an EMPTY list for the
// one-word convention every other function uses.
//
// `on` is the TARGET gate, and it is the reason this decision cannot live in a
// backend: the return ABI is a property of the target (AAPCS64 pairs x0/x1,
// SysV pairs rax/rdx, Win64 returns a 16-byte aggregate through memory), while
// the boxing it replaces is an ALLOCATION in the IR that no backend can
// remove. This is the first lowering decision in this compiler that depends on
// the target; see `Lowerer.multiWordRet`.
// The `false` is the RETURN half of the string flip, and it is #4424's to
// change — not an oversight and not a default. The argument side needs no
// budget (a word past the eighth marshals through `emitOutgoingStackArg`),
// while the return side has no such path at all (#4238), so flipping this one
// argument is a separate decision with its own budget check below.
fn explodedRetWords(c: Checker, decl: int, on: bool): []int {
  if (!on || decl == 0 || !explodesParams(c, decl)) {
    return []int(0)
  }
  let words = explodedWordTypes(c.ctx, declPlainResultType(c, decl), false)
  if (!retWordsFitRegisters(c.ctx, words)) {
    return []int(0)
  }
  return words
}

// The W words of `v`, a value of the exploded result type `ty`: one
// `field_get` per word, emitted adjacent to the `ret` that consumes them.
//
// A `return` lowers its expression EXACTLY as it did before and this reads the
// words back out of the result, rather than each return form growing its own
// exploded path. `return a, b`, `return t` and `return f()` therefore all go
// through one place, and the box the first of them builds is removed by
// store-to-load forwarding plus dead-allocation elimination — the same pair
// #4404 relies on at an exploded call site. Correctness never rests on that:
// under `--no-optimize` the box is real and these are genuine loads out of it.
fn explodedRetValues(fc: FnCtx, v: int, words: []int): []int {
  return emitWordReads(fc.c.ctx, fc.b, v, words)
}

// Emits the `Op.CallWord` run carrying words 1..W-1 of `call`'s result, and
// returns every word's value id with word 0 (the call itself) first.
//
// One instruction per word because the IR is single-assignment and
// single-result: a call that produces W values needs W slots. The run stays
// immediately after its call and in ascending word order — nothing may be
// emitted between the `bl` and the last binding (#4236) — which
// `callWordEscapesInFunc` (verify.bit) refuses to let drift.
fn emitCallResultWords(ctx: TypeContext, b: IrBuilder, call: int, words: []int): []int {
  let out = [call]
  let k = 1
  while (k < len(words)) {
    let w = mkInstr(Op.CallWord, words[k])
    w.args = [call]
    w.ival = k
    out = append(out, builderEmit(b, w))
    k = k + 1
  }
  // #4406: word 0 IS the call, so the run is where a multi-word result stops
  // being one value. The box `buildTuple` wraps these in dies to store-to-load
  // forwarding, and after that nothing but these edges couples the words.
  recordWordKeepAlive(ctx, b, words, out)
  return out
}

// ===========================================================================
// Keepalive edges (#4406)
//
// THE HAZARD THIS CLOSES, reproduced on `df423d13` before any of it was
// written. `explodedWordTypes` admits a tuple whose members are each one word,
// and `*T` (SPEC §11.4) is one word the GC must never follow (`isRefType`,
// codegen.bit). So `(ptrOf(s) + 1, s)` is an exploded aggregate whose word 0 is
// an INTERIOR address into `s`'s buffer and whose word 1 is the only thing that
// roots it. Explosion makes the two independent SSA values with nothing between
// them, so word 1's live interval ends at its last use — which is nowhere, when
// the consumer reads only word 0:
//
//   %1 = call @mkPair(%0) *i64        word 0, the interior pointer
//   %2 = call_word %1[1] []i64        word 1, the base, never read again
//   %3 = call @churn() i64            SAFEPOINT, stack map regs=[]
//   %4 = field_get %1[0] i64          dereferences the interior pointer
//
// Conservative scanning does not save it: `gcOwns` (runtime/gc/gcalloc.bit) is
// exact base equality, so the interior word roots nothing. Measured: 1234 under
// the default collector, `0` under `BIT_GC=stress`, exit 0 both times. With the
// same program built from `ptrOf(s) + 0` — a BASE pointer, everything else
// identical — stress prints 1234, which is what isolates interior-ness rather
// than the missing root as the cause.
//
// WHERE THE EDGES ARE RECORDED: exactly where the aggregate is taken apart into
// words, so there is one rule rather than a list of shapes. Every non-traced
// word is paired with every traced word of the same aggregate. Pairing `len`
// with `base` as well as `ptr` is deliberate and is the reason there is no
// "which word is the pointer" test here: the lowerer does not know, and a word
// that is merely an integer costs the base a slightly longer interval rather
// than a wrong answer.
//
// A `return`'s words are NOT recorded. `explodedRetValues` emits them adjacent
// to the `ret` that consumes them, so there is no safepoint left in this
// function for the base to be dead across; the caller's own edges (recorded by
// `recordCallResultKeepAlive` on the receiving side) carry it from there.
// ===========================================================================

// Records "value `derived` must not outlive value `base`".
fn builderKeepAlive(b: IrBuilder, derived: int, base: int) {
  if (derived == base) {
    return
  }
  b.keepAlive = append(b.keepAlive, derived)
  b.keepAlive = append(b.keepAlive, base)
}

// Pairs every non-traced word of one aggregate with every traced word of it.
// `words` are the per-word TYPES and `ids` the value ids, positionally.
fn recordWordKeepAlive(ctx: TypeContext, b: IrBuilder, words: []int, ids: []int) {
  let k = 0
  while (k < len(words) && k < len(ids)) {
    if (!isRefType(ctx, words[k])) {
      let t = 0
      while (t < len(words) && t < len(ids)) {
        if (isRefType(ctx, words[t])) {
          builderKeepAlive(b, ids[k], ids[t])
        }
        t = t + 1
      }
    }
    k = k + 1
  }
}

// The parameter side: `paramIds` is the FLAT block-0 parameter list
// `explodeParamTypes` produced, so this walks `paramTypes` with the same cursor
// that built it and hands each exploded parameter's own run to
// `recordWordKeepAlive`. `gates.tuples` is `explodesParams`, so an ineligible
// declaration records nothing — its single handle is its own root.
//
// #4423 makes this load-bearing where it was free. A tuple's words are all base
// pointers, so the edges cost nothing; an exploded `string` PARAMETER arrives
// as `{ptr, len, base}` where `ptr` is an INTERIOR address into the bytes
// `base` roots, and `gcOwns` (runtime/gc/gcalloc.bit) is exact base equality.
// Without an edge from `ptr` to `base`, a callee that reads only `ptr` lets
// `base`'s interval end at block 0 and the next collection sweeps the bytes
// under it — a wrong answer at exit 0, which is the shape #4406 measured.
fn recordParamKeepAlive(
  ctx: TypeContext, b: IrBuilder, paramTypes: []int, paramIds: []int, gates: ArgExplodeGates,
) {
  if (!gates.tuples || !anyExplodedParam(ctx, paramTypes, gates.strings)) {
    return
  }
  let at = 0
  let i = 0
  while (i < len(paramTypes)) {
    let words = explodedWordTypes(ctx, paramTypes[i], gates.strings)
    if (len(words) == 0) {
      at = at + 1
    } else {
      let ids = []int(0)
      let k = 0
      while (k < len(words)) {
        if (at + k < len(paramIds)) {
          ids = append(ids, paramIds[at + k])
        }
        k = k + 1
      }
      recordWordKeepAlive(ctx, b, words, ids)
      at = at + len(words)
    }
    i = i + 1
  }
}

// The words of `val`, an aggregate whose per-word types are `words`: one
// `field_get` at `k * 8` typed as that word. No keepalive edges — see
// `explodeValueWords` for the form that records them, which is what every
// caller but the `return` path wants.
//
// The offset is `k * 8` rather than a `layoutFields` lookup, and that is exact
// rather than an assumption for both shapes that reach here: a type
// `explodedWordTypes` admits has every member an 8-byte field, and a boxed
// `string` has its `{ptr, len, base}` fixed at 0/8/16 by `runtime/ABI.md` §2.3.
//
// ONE decomposer for the tuple and the string sides, for the argument, return
// and local positions alike. There used to be two identical loops —
// `explodedWordGet` called in a loop, and `unboxStringWords` — differing only
// in where the word type came from, and this file carries the receipt for what
// a second copy costs: #4412 widened one consumer of a shared predicate and not
// the other, and `take4((1,2,3,4))` printed 1200 at exit 0. The word TYPE now
// has exactly one source, the `words` list the caller was given.
fn emitWordReads(ctx: TypeContext, b: IrBuilder, val: int, words: []int): []int {
  let ids = []int(0)
  let k = 0
  while (k < len(words)) {
    let fg = mkInstr(Op.FieldGet, words[k])
    fg.lhs = val
    fg.ival = k * 8
    ids = append(ids, builderEmit(b, fg))
    k = k + 1
  }
  return ids
}

// `emitWordReads` plus the keepalive edges pairing every untraced word with
// every traced one (#4406) — the form every position takes except a `return`,
// whose words are consumed by the `ret` in the same block (see the banner
// above).
fn explodeValueWords(ctx: TypeContext, b: IrBuilder, val: int, words: []int): []int {
  let ids = emitWordReads(ctx, b, val, words)
  recordWordKeepAlive(ctx, b, words, ids)
  return ids
}
