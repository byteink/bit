// compiler/classrelationattr.bit — relation attribute recognition (SPEC
// §10.5, #5053 step 1 of 3, epic #5050 decision 5/6).
//
//     @table
//     class User {
//       @id id: i64
//       @hasMany("userId") orders: []Order
//     }
//
// `@hasMany`, `@hasOne` and `@belongsTo` are COMPILER-KNOWN marks, the way
// `@key`/`@column` are (classjson.bit) — matched by NAME, unconditionally,
// rather than resolved through #3879's ordinary name lookup. A relation
// attribute that reached that path would desugar to a call to a function
// called `hasMany` that nobody declared, the exact failure mode `@key` was
// carved out of.
//
// WHY THIS IS NOT #5051's compiler-known-list. #5051 refuses a hardcoded
// list of metadata attribute names on purpose: `pkg/orm` alone decides what
// `@unique`/`@check`/`@collation` mean, and the compiler only records the
// name. A relation is different — epic #5050's decision 6 has the COMPILER
// itself check a relation read at the point it is used, which needs the
// compiler to know which fields are relations before any zero-value
// encoding or panic can be built on that knowledge (#5053's remaining
// steps). #5247's lint rule answers the same "is this field a relation?"
// question at compile time, off the same predicate.
//
// WHAT THIS FILE DOES NOT DO YET. A relation field on a `@table` class is
// already RECORDED into `tableDescriptor()` by classtabledesc.bit's
// existing CALL/RECORD split, unchanged here — `hasMany` never resolves to
// a declared function, so it was always going to be recorded. This file
// adds two things on top: the names are excluded from #3879's call path
// EVERYWHERE (never silently routed to a coincidentally-named free
// function), and a relation attribute on a class that carries no `@table`
// is refused with its own diagnostic instead of silently doing nothing once
// excluded from that call path. The reserved "unloaded" encoding and the
// read-side panic are later steps of #5053, not this file.

// E0160 (§10.5): a relation attribute on a field of a class carrying no
// `@table` — a relation is meaningless outside an entity, and once excluded
// from #3879's call path (`attrNameIsRelation`, wired into classjson.bit's
// `fieldAttrIsCompilerKnown`) it would otherwise vanish with no diagnostic
// at all, the same reasoning `@key` outside `@json` (E0139) already gives.
const ecRelationOutsideTable = 160

// The three relation marks. Target/foreign-key handling (the attribute's
// own argument) is #5061's (pkg/orm) to read off `tableDescriptor()`'s
// recorded `AttrDesc`, not this file's to interpret — recognition only
// decides WHICH fields are relations, never what a relation means.
const classAttrHasMany = "hasMany"
const classAttrHasOne = "hasOne"
const classAttrBelongsTo = "belongsTo"

// True iff `name` is one of the three compiler-known relation marks.
fn attrNameIsRelation(name: string): bool {
  return name == classAttrHasMany || name == classAttrHasOne || name == classAttrBelongsTo
}

// The first relation attribute on `field`, or 0. Mirrors classjson.bit's
// `fieldKeyAttr`. A field carrying more than one relation mark is not this
// function's question to answer — it returns whichever is declared first,
// leaving a "more than one relation mark" ruling to whichever later step
// needs one.
fn fieldRelationAttr(t: Tree, source: string, field: int): int {
  for a of fieldAttrs(t, field) {
    if (attrNameIsRelation(identText(t, source, kidsOf(t, a)[0]))) {
      return a
    }
  }
  return 0
}

// A relation attribute on a field of a class carrying no `@table`, reported
// for its own sake: nothing else in the pipeline ever looks at it once it is
// excluded from #3879's call path. Runs over every module, unconditionally,
// mirroring classjson.bit's `vStrayKeyAttrs` exactly — same walk, same
// reason a `@table`-less class synthesizes nothing that could notice it.
fn vStrayRelationAttrs(tree: Tree, source: string, diags: Diagnostics) {
  for tc of topClassDecls(tree) {
    let d = tc.decl
    if (classHasTable(tree, source, d)) {
      continue
    }
    let cname = identText(tree, source, kidsOf(tree, d)[0])
    for m of kidsOf(tree, kidsOf(tree, d)[2]) {
      let f = memberField(tree, m)
      if (f == 0) {
        continue
      }
      let attr = fieldRelationAttr(tree, source, f)
      if (attr == 0) {
        continue
      }
      let aname = identText(tree, source, kidsOf(tree, attr)[0])
      let fname = identText(tree, source, kidsOf(tree, f)[0])
      reportRelationOutsideTable(diags, getNode(tree, attr).span, aname, fname, cname)
    }
  }
}

fn reportRelationOutsideTable(
  diags: Diagnostics, span: Span, aname: string, fname: string, cname: string,
) {
  report(
    diags, ecRelationOutsideTable, span,
    "'@${aname}' on field '${fname}' has no effect: class '${cname}' does not carry '@table'",
    "mark '${cname}' with '@table', or drop '@${aname}' — a relation attribute only has meaning on an entity",
  )
}
