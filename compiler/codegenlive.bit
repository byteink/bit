// ===========================================================================
// Live-interval construction (feeds regalloc.bit's `allocate`)
//
// Backend-agnostic by nature: liveness is a property of the IR's CFG and the
// TypeContext, never of a physical register file or an encoding. The seed keeps
// a private copy per backend (own comment blames a ticket boundary,
// not a technical one) and the two drifted apart — never grew the
// `extendParamsToPreds` guard needed. That divergence is exactly the
// design smell codegen.bit's header warns about, so with x64 as the second
// concrete user the logic lives here once, guard included.
//
// Split out of codegen.bit (#3434), which had reached 791 of the 800-line limit
// (spec/LINT.md E0200) and is the largest file in compiler/. A pure move: this
// section already carried its own banner and depends on nothing in codegen.bit
// but the IR and the TypeContext. Sibling .bit files are one module, so every
// caller and every name resolves exactly as before.
// ===========================================================================

fn extendOne(intervals: []LiveInterval, usePos: int, operand: int) {
  if (intervals[operand].end < usePos) {
    intervals[operand].end = usePos
  }
}

fn extendList(intervals: []LiveInterval, usePos: int, operands: []int) {
  let i = 0
  while (i < len(operands)) {
    extendOne(intervals, usePos, operands[i])
    i = i + 1
  }
}

// Extends each operand's live interval to reach this instruction. Every op that
// READS a value must be listed — an omission ends a value's interval early and
// the allocator hands its register to someone else while it is still live.
fn extendUses(intervals: []LiveInterval, usePos: int, ins: IrInstr) {
  let op = ins.op
  if (op == Op.BlockParam ||
    op == Op.ConstInt ||
    op == Op.ConstFloat ||
    op == Op.ConstBool ||
    op == Op.ConstString ||
    op == Op.ConstNil ||
    op == Op.Unreachable ||
    op == Op.GcAlloc ||
    op == Op.TypeInfo ||
    op == Op.FuncAddr ||
    op == Op.GlobalAddr ||
    op == Op.StackMapsAddr) {
    return // no value operands
  }
  // #2934: Jump/Br's block-param ARGUMENTS are extended separately, by
  // extendForwardArgs, gated on whether the receiving param is genuinely live
  // rather than unconditionally — see computeParamTrueLive's header. Br's own
  // CONDITION is still an unconditional real read.
  if (op == Op.Jump) {
    return
  }
  if (op == Op.Ret || op == Op.Call || op == Op.RtCall || op == Op.Asm) {
    extendList(intervals, usePos, ins.args)
    return
  }
  if (op == Op.Br) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.CallValue || op == Op.CallIface) {
    extendOne(intervals, usePos, ins.lhs) // callee / receiver
    extendList(intervals, usePos, ins.args)
    return
  }
  // §11.8: `lhs` is the syscall number, `args` its 0..6 arguments. Must be
  // listed explicitly — the fall-through at the bottom would read a `rhs` this
  // op does not have (extending vreg 0) and miss every argument.
  if (op == Op.Syscall) {
    extendOne(intervals, usePos, ins.lhs)
    extendList(intervals, usePos, ins.args)
    return
  }
  if (op == Op.FieldGet ||
    op == Op.SliceLen ||
    op == Op.MakeClosure ||
    op == Op.Neg ||
    op == Op.BNot ||
    op == Op.Convert ||
    op == Op.FNeg ||
    op == Op.FSqrt ||
    op == Op.Bitcast ||
    op == Op.FFloor ||
    op == Op.FCeil ||
    op == Op.FTrunc ||
    op == Op.FRound) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.FieldSet) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    return
  }
  if (op == Op.IndexSet) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    extendOne(intervals, usePos, ins.ival) // the value operand
    return
  }
  // Atomics (§11.5): `lhs`=ptr always; store/rmw also read `rhs`; cmpxchg also
  // reads `rhs` (expected) and `ival` (desired). `atomic_load` has no `rhs`, so
  // it must not fall through to the two-operand default (that would extend
  // vreg 0).
  if (op == Op.AtomicLoad) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.AtomicCmpxchg) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    extendOne(intervals, usePos, ins.ival)
    return
  }
  if (op == Op.AtomicStore || opIsAtomicRmw(op)) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    return
  }
  // Everything else is a two-operand value op (bin/index_get).
  extendOne(intervals, usePos, ins.lhs)
  extendOne(intervals, usePos, ins.rhs)
}

// All of a block's params are live simultaneously at block entry — the
// predecessor edge's parallel move writes every one before the jump. A param that
// is never read afterward would otherwise keep its initial empty [i, i] interval
// and could be coalesced onto a live sibling param's register, so the edge move
// clobbers one param with another (a returned value coming back as some other
// incoming argument). Extend every param's interval to its block's last param
// position so all params of a block mutually interfere and land in distinct
// registers.
fn forceParamInterference(intervals: []LiveInterval, f: IrFunc) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let blk = f.blocks[bi]
    if (blk.paramCount > 0) {
      let lastParam = blk.instsStart + blk.paramCount - 1
      let p = blk.instsStart
      while (p < blk.instsStart + blk.paramCount) {
        if (intervals[p].end < lastParam) {
          intervals[p].end = lastParam
        }
        p = p + 1
      }
    }
    bi = bi + 1
  }
}

fn extendBlockParams(intervals: []LiveInterval, f: IrFunc, target: int, edgePos: int) {
  let blk = f.blocks[target]
  let p = blk.instsStart
  let end = blk.instsStart + blk.paramCount
  while (p < end) {
    if (intervals[p].start > edgePos) {
      intervals[p].start = edgePos
    }
    p = p + 1
  }
}

// A block param's storage is written by each predecessor's edge move, which runs
// at the predecessor's TERMINATOR. Under RPO a forward branch targets a block
// emitted later, so that write happens well before the param's own instruction
// index. Extend every param's start back to its earliest predecessor terminator
// so the param is live across the gap and interferes with anything live there;
// otherwise a value that dies in the gap is handed the param's register or spill
// slot and the edge move clobbers it — the caller silently reads the wrong value
// (an early `return` out of a loop reading a spilled loop-carried local). A
// back-edge predecessor sits at a HIGHER position than the param, so it never
// lowers the start.
//
// Only x64 has ever been observed to need this: a safepoint-bearing function is
// restricted to 4 allocatable callee-saved GPRs and spills, while arm64's ~10
// never forced the collision. arm64 dodged the bug by register count, not by
// correctness — so the guard runs for both rather than waiting for arm64 to grow
// a spill and fail silently.
fn extendParamsToPreds(intervals: []LiveInterval, f: IrFunc) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let pblk = f.blocks[bi]
    // A well-formed block always ends in a terminator; guard anyway so malformed
    // IR cannot index out of bounds behind our backs.
    if (pblk.instsLen > 0) {
      let termPos = pblk.instsStart + pblk.instsLen - 1
      let ins = f.instrs[termPos]
      if (ins.op == Op.Jump) {
        extendBlockParams(intervals, f, ins.ival, termPos)
      }
      if (ins.op == Op.Br) {
        extendBlockParams(intervals, f, ins.ival, termPos)
        extendBlockParams(intervals, f, ins.ival2, termPos)
      }
    }
    bi = bi + 1
  }
}

// #2934: the CFG-obliviousness fix. A chain of "if (cond) { return X }" checks
// threads every local through EVERY subsequent block's params via the Jump/Br
// argument list, regardless of whether anything downstream ever reads it
// again — opt.bit's DCE keeps every block param structurally live because
// trimming one means rewriting every predecessor's arg list too (its own
// `computeLive` unconditionally marks Op.BlockParam live for exactly that
// reason). Left alone, a value already dead after its first branch keeps a
// register reserved — and gets re-copied at every later block's edge move —
// all the way to the function's last block, which is what inflated
// bit_rt_safepoint_needed to 14 distinct GPRs for a true 2-value peak.
//
// This computes, for every instruction slot, whether it is "genuinely" live:
// read directly by something other than a block-forwarding argument, or
// forwarded to a param that is (recursively) genuinely live. Two stages:
//
// Stage 1 finds every direct (non-forwarding) use exactly the way extendUses
// already does — reusing it unmodified on a throwaway interval array, since
// extendUses' own Op.Jump/Op.Br handling no longer touches forwarded args.
//
// Stage 2 walks blocks in DESCENDING order propagating liveness backward
// across FORWARD edges only: a forward branch always targets a LATER block
// (isBackEdge), so by the time this walk reaches a block's own terminator,
// every block it can jump forward to has already been fully processed —
// including THAT block's own Stage 2 contribution — so its params' liveness
// is completely final. A BACK edge's target has not been visited yet in a
// single descending pass, so those arguments stay conservatively live,
// unchanged from today: under-approximating deadness there would shrink a
// genuinely live loop-carried value's interval and hand its register away
// early, which is a miscompile, not a missed optimization.
fn computeParamTrueLive(f: IrFunc): []bool {
  let n = len(f.instrs)
  let temp = []LiveInterval(0)
  let i = 0
  while (i < n) {
    temp = append(
      temp,
      LiveInterval{ vreg: i, regClass: RegClass.Int, start: i, end: i, isRef: false },
    )
    i = i + 1
  }
  i = 0
  while (i < n) {
    extendUses(temp, i, f.instrs[i])
    i = i + 1
  }
  let live = []bool(0)
  i = 0
  while (i < n) {
    live = append(live, temp[i].end > temp[i].start)
    i = i + 1
  }

  let bi = len(f.blocks)
  while (bi > 0) {
    bi = bi - 1
    let b = f.blocks[bi]
    if (b.instsLen > 0) {
      let termPos = b.instsStart + b.instsLen - 1
      let ins = f.instrs[termPos]
      if (ins.op == Op.Jump) {
        markForwardLiveArgs(f, live, bi, ins.ival, ins.args)
      }
      if (ins.op == Op.Br) {
        markForwardLiveArgs(f, live, bi, ins.ival, ins.thenArgs)
        markForwardLiveArgs(f, live, bi, ins.ival2, ins.elseArgs)
      }
    }
  }
  return live
}

// Shared by computeParamTrueLive's own backward propagation and
// extendForwardArgs' interval extension: argument `k` of a jump from
// `curBlock` to `target` is worth treating as a genuine use iff the edge is a
// back edge (always conservative, same as extendUses used to be
// unconditionally) or the receiving param (`target`'s k-th) is itself live.
fn argFeedsLiveTarget(f: IrFunc, live: []bool, curBlock: int, target: int, k: int): bool {
  return isBackEdge(curBlock, target) || live[f.blocks[target].instsStart + k]
}

fn markForwardLiveArgs(f: IrFunc, live: []bool, curBlock: int, target: int, args: []int) {
  let k = 0
  while (k < len(args)) {
    if (argFeedsLiveTarget(f, live, curBlock, target, k)) {
      live[args[k]] = true
    }
    k = k + 1
  }
}

// buildIntervals' replacement for extendUses' old unconditional Jump/Br
// argument handling: only extends a forwarded value's interval when
// argFeedsLiveTarget says the edge is worth it (#2934).
fn extendForwardArgs(
  intervals: []LiveInterval,
  f: IrFunc,
  live: []bool,
  usePos: int,
  curBlock: int,
  target: int,
  args: []int,
) {
  let k = 0
  while (k < len(args)) {
    if (argFeedsLiveTarget(f, live, curBlock, target, k)) {
      extendOne(intervals, usePos, args[k])
    }
    k = k + 1
  }
}

fn isSafepointOp(op: Op): bool {
  return op == Op.Call ||
    op == Op.RtCall ||
    op == Op.GcAlloc ||
    op == Op.MakeClosure ||
    op == Op.CallValue ||
    op == Op.CallIface
}

// buildIntervals produces two things at once; a slice appended to inside a callee
// does not grow the caller's, so both come back in one class.
class IntervalBuild {
  intervals: []LiveInterval,
  safepoints: []int,
  // #3738: per instruction slot, the vreg whose location it must share. See
  // computeCopyRoots at the bottom of this file.
  roots: []int,
}

// One LiveInterval per instruction slot (dense 0..len(instrs), matching
// regalloc.bit's dense-vreg contract). Non-value instructions (terminators,
// field_set/index_set) get a trivial, never-referenced [i,i] interval; harmless
// filler, never looked up. Also collects safepoint positions in the exact order
// they will be re-encountered during emission (calls first-seen, then back-edge
// terminators) so a backend can match each stack map back to its call by cursor
// position — arm64 consumes this; x64 records its safepoints during emission and
// reads only `intervals`.
fn buildIntervals(ctx: TypeContext, f: IrFunc): IntervalBuild {
  let safepoints = []int(0)
  let intervals = []LiveInterval(0)
  let i = 0
  while (i < len(f.instrs)) {
    let w = widthOf(ctx, f.instrs[i].ty)
    intervals = append(
      intervals,
      LiveInterval{
        vreg: i, regClass: w.regClass, start: i, end: i,
        isRef: w.regClass == RegClass.Int && isRefType(ctx, f.instrs[i].ty),
      },
    )
    i = i + 1
  }

  let paramLive = computeParamTrueLive(f)

  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      if (isSafepointOp(ins.op)) {
        safepoints = append(safepoints, idx)
      }
      extendUses(intervals, idx, ins)
      if (ins.op == Op.Jump) {
        extendForwardArgs(intervals, f, paramLive, idx, bi, ins.ival, ins.args)
      }
      if (ins.op == Op.Br) {
        extendForwardArgs(intervals, f, paramLive, idx, bi, ins.ival, ins.thenArgs)
        extendForwardArgs(intervals, f, paramLive, idx, bi, ins.ival2, ins.elseArgs)
      }
      // Back-edge safepoints are suppressed for @naked/@nosplit — gate recording
      // on the same predicate as emission so positions stay in lockstep (§10.3.1).
      if (ins.op == Op.Jump && isBackEdge(bi, ins.ival) && !needsNoSafepoints(f)) {
        safepoints = append(safepoints, idx)
      }
      if (ins.op == Op.Br && !needsNoSafepoints(f)) {
        if (isBackEdge(bi, ins.ival)) {
          safepoints = append(safepoints, idx)
        }
        if (isBackEdge(bi, ins.ival2)) {
          safepoints = append(safepoints, idx)
        }
      }
      idx = idx + 1
    }
    bi = bi + 1
  }
  extendParamsToPreds(intervals, f)
  forceParamInterference(intervals, f)
  return IntervalBuild{
    intervals: intervals, safepoints: safepoints,
    roots: computeCopyRoots(f),
  }
}

// ===========================================================================
// SSA copy roots (#3738)
//
// A block param whose predecessors all pass the same value IS that value: the
// edge's parallel move writes `P := A` on every path into the block, so P and A
// can share one location and every one of those moves becomes a self-move the
// sequencer drops. `allocateCoalesced` (regalloc.bit) consumes what this
// computes.
//
// This is what the emitted code costs without it. `schedWorkPending`
// (runtime/sched/worker.bit) threads six loop-invariant values — the worker, the
// scheduler, the worker count, this worker's id — through the params of every
// block in its steal loop. Each block gave each of them a fresh vreg and the
// allocator gave each fresh vreg a fresh register, so one iteration paid a
// six-register round trip (x25->x20, x27->x23, x26->x22 on the way in and back
// again on the way out) for values nothing ever writes. Measured on 189ef1e6:
// 34 of the function's 156 instructions were `mov`, and the pressure that
// shuffle created spilled the loop counter to the frame as well.
//
// A CHAIN AND A LOOP BOTH NEED A FIXPOINT, which is why this is not a single
// pass over the edges. bb12's param is fed by bb8's copy of bb7's param and by
// bb11's copy of the same value; neither is literally bb7's vreg, so they agree
// only once both have been resolved to it. And bb7's own param is fed by the
// entry value and, around the back edge, by a copy of itself.
//
// THE SELF-REFERENCE RULE IS RESTRICTED TO BACK EDGES ON PURPOSE. Ignoring an
// argument that resolves to the param itself is what collapses the loop-carried
// pass-through, and it is sound because the first entry to the block cannot come
// from an edge carrying the param's own value — that edge is only reachable once
// the block has already run. Bit lowers only structured `while`/`for`, so every
// loop is reducible and "the edge that closes the loop" is exactly
// `isBackEdge`; requiring it rather than trusting the value test keeps the
// argument true without depending on reducibility holding forever.
// ===========================================================================

// One CFG edge, with the arguments its terminator binds to the target's params.
// `src` is the predecessor block index (`from` is a reserved word, SPEC §5.2).
class IrEdge {
  src: int,
  target: int,
  args: []int,
}

fn collectEdges(f: IrFunc): []IrEdge {
  let out = []IrEdge(0)
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    // A well-formed block always ends in a terminator; guard anyway so
    // malformed IR cannot index out of bounds behind our backs.
    if (b.instsLen > 0) {
      let t = f.instrs[b.instsStart + b.instsLen - 1]
      if (t.op == Op.Jump) {
        out = append(out, IrEdge{ src: bi, target: t.ival, args: t.args })
      }
      if (t.op == Op.Br) {
        out = append(out, IrEdge{ src: bi, target: t.ival, args: t.thenArgs })
        out = append(out, IrEdge{ src: bi, target: t.ival2, args: t.elseArgs })
      }
    }
    bi = bi + 1
  }
  return out
}

// Follows `v`'s chain to the vreg that owns the location. Bounded by the array
// length — entries are written already-resolved, so this is one hop in practice
// and the guard only exists so a malformed table cannot spin.
fn copyRootOf(roots: []int, v: int): int {
  let r = v
  let guard = 0
  while (roots[r] != r && guard < len(roots)) {
    r = roots[r]
    guard = guard + 1
  }
  return r
}

// Edge indices grouped by target block, so a refinement round costs one pass
// over each block's OWN predecessors rather than over every edge in the
// function. Without it the walk is quadratic in the block count on every round
// and shows up as compiler wall clock, not as generated code.
// IrEdge is a class (reference type, SPEC §13.3), so grouping the edges
// themselves by target costs no more than grouping their indices did -- each
// slot is a pointer to the same edge object, not a copy of it -- and it is
// what lets paramRootCandidate drop both `edges` and `inEdges` for a single
// already-scoped `[]IrEdge` (see #3764).
fn indexEdges(f: IrFunc, edges: []IrEdge): [][]IrEdge {
  let byTarget = [][]IrEdge(0)
  let i = 0
  while (i < len(f.blocks)) {
    byTarget = append(byTarget, []IrEdge(0))
    i = i + 1
  }
  i = 0
  while (i < len(edges)) {
    let t = edges[i].target
    if (t >= 0 && t < len(byTarget)) {
      byTarget[t] = append(byTarget[t], edges[i])
    }
    i = i + 1
  }
  return byTarget
}

// The single root every predecessor passes into param `p` (slot `k` of block
// `bi`), or -1 when the block has no predecessor, when two predecessors
// disagree, or when a terminator's argument list is too short for the slot.
// `inEdges` is already scoped to `bi`'s predecessors (indexEdges groups by
// target), so it carries the edges themselves rather than indices plus a
// separate `edges` array to dereference them through.
fn paramRootCandidate(f: IrFunc, inEdges: []IrEdge, roots: []int, bi: int, k: int): int {
  let p = f.blocks[bi].instsStart + k
  let cand = -1
  let e = 0
  while (e < len(inEdges)) {
    let ed = inEdges[e]
    if (k >= len(ed.args)) {
      return -1
    }
    let r = copyRootOf(roots, ed.args[k])
    if (r != p || !isBackEdge(ed.src, bi)) {
      if (cand < 0) {
        cand = r
      }
      if (cand != r) {
        return -1
      }
    }
    e = e + 1
  }
  return cand
}

// One refinement round over every still-unresolved param. Returns whether
// anything moved, so the caller can stop at the fixpoint.
fn refineCopyRoots(f: IrFunc, byTarget: [][]IrEdge, roots: []int): bool {
  let changed = false
  // Block 0's params are the function's incoming ARGUMENTS: the prologue binds
  // them from the ABI's argument registers, not from any edge move, so nothing
  // a predecessor passes describes them. A back edge that targeted block 0
  // would otherwise offer a candidate and the prologue would then write over
  // the value it was aliased to.
  let bi = 1
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let k = 0
    while (k < b.paramCount) {
      let p = b.instsStart + k
      if (roots[p] == p) {
        let cand = paramRootCandidate(f, byTarget[bi], roots, bi, k)
        if (cand >= 0 && cand != p) {
          roots[p] = cand
          changed = true
        }
      }
      k = k + 1
    }
    bi = bi + 1
  }
  return changed
}

// Per instruction slot, the vreg whose location it must share — itself when it
// has none. Bounded: a round that changes nothing stops the walk, and no walk
// runs more rounds than there are blocks (each round resolves at least one
// param or is the last).
fn computeCopyRoots(f: IrFunc): []int {
  let roots = []int(0)
  let i = 0
  while (i < len(f.instrs)) {
    roots = append(roots, i)
    i = i + 1
  }
  let edges = collectEdges(f)
  let byTarget = indexEdges(f, edges)
  let round = 0
  while (round <= len(f.blocks)) {
    if (!refineCopyRoots(f, byTarget, roots)) {
      return normalizeCopyRoots(roots)
    }
    round = round + 1
  }
  return normalizeCopyRoots(roots)
}

// Collapses every chain to its endpoint, so a consumer needs no walk of its
// own: a param resolved to a root that a later round resolved further leaves a
// two-hop entry behind. A cycle cannot form (a round only writes an entry that
// still points at itself, and never to a vreg that resolves back to it), and
// `copyRootOf`'s guard bounds the walk regardless.
fn normalizeCopyRoots(roots: []int): []int {
  let i = 0
  while (i < len(roots)) {
    roots[i] = copyRootOf(roots, i)
    i = i + 1
  }
  return roots
}
