// Self-host Stage 3 (#1346): the x86-64 backend, instruction dispatch and driver.
// Split out of compiler/x64.bit; same module, so nothing here is imported.

// ---------------------------------------------------------------------------
// Instruction dispatch
// ---------------------------------------------------------------------------

// The x86 condition code an integer compare sets its result from. Signed and
// unsigned are DIFFERENT codes for the same relation (l/ge vs b/ae): reading a
// signed compare with an unsigned code silently reorders negative values.
fn xCcForIcmp(op: Op): int {
  if (op == Op.ICmpEq) {
    return ccE()
  }
  if (op == Op.ICmpNe) {
    return ccNe()
  }
  if (op == Op.ICmpSlt) {
    return ccL()
  }
  if (op == Op.ICmpSle) {
    return ccLe()
  }
  if (op == Op.ICmpSgt) {
    return ccG()
  }
  if (op == Op.ICmpSge) {
    return ccGe()
  }
  if (op == Op.ICmpUlt) {
    return ccB()
  }
  if (op == Op.ICmpUle) {
    return ccBe()
  }
  if (op == Op.ICmpUgt) {
    return ccA()
  }
  assert(op == Op.ICmpUge)
  return ccAe()
}

fn xArithForOp(op: Op): XArith {
  if (op == Op.Sub) {
    return XArith.Sub
  }
  if (op == Op.BAnd) {
    return XArith.And
  }
  if (op == Op.BOr) {
    return XArith.Or
  }
  if (op == Op.BXor) {
    return XArith.Xor
  }
  assert(op == Op.Add)
  return XArith.Add
}

fn xDivOpForOp(op: Op): XDivOp {
  if (op == Op.UDiv) {
    return XDivOp.UDiv
  }
  if (op == Op.SRem) {
    return XDivOp.SRem
  }
  if (op == Op.URem) {
    return XDivOp.URem
  }
  assert(op == Op.SDiv)
  return XDivOp.SDiv
}

fn xShiftForOp(op: Op): XShift {
  if (op == Op.LShr) {
    return XShift.Shr
  }
  if (op == Op.AShr) {
    return XShift.Sar
  }
  assert(op == Op.Shl)
  return XShift.Shl
}

fn xFArithForOp(op: Op): XFArith {
  if (op == Op.FSub) {
    return XFArith.FSub
  }
  if (op == Op.FMul) {
    return XFArith.FMul
  }
  if (op == Op.FDiv) {
    return XFArith.FDiv
  }
  assert(op == Op.FAdd)
  return XFArith.FAdd
}

fn xFCmpForOp(op: Op): XFCmp {
  if (op == Op.FCmpNe) {
    return XFCmp.FNe
  }
  if (op == Op.FCmpLt) {
    return XFCmp.FLt
  }
  if (op == Op.FCmpLe) {
    return XFCmp.FLe
  }
  if (op == Op.FCmpGt) {
    return XFCmp.FGt
  }
  if (op == Op.FCmpGe) {
    return XFCmp.FGe
  }
  assert(op == Op.FCmpEq)
  return XFCmp.FEq
}

// The bit pattern a float constant is materialized from. An f32 constant must be
// NARROWED first and its 32-bit pattern used — feeding the f64 bits to a 4-byte
// movd loads the wrong half of the value.
fn xFloatConstBits(val: f64, width: int): int {
  if (width == 4) {
    return i64(u64(float32Bits(f32(val))))
  }
  return i64(floatBits(val))
}

// A void-typed instruction has no result to bind; -1 says so.
// Inline assembly (§11.6): move each `input` value into its fixed register
// (excluded from the allocatable file for the whole function), emit the x64
// sub-block's pre-encoded bytes verbatim, then read the `result` register (if
// any) into the instruction's result vreg. `dst` is -1 for a result-less block.
fn xEmitAsm(cx: XCtx, dst: int, block: int, inVals: []int) {
  let blk = cx.module.asmBlocks[block]
  let i = 0
  while (i < len(inVals)) {
    let src = xGetInt(cx, inVals[i], xScratch1())
    xMovRR(cx.buf, xRegOf(blk.inX64[i]), src)
    i = i + 1
  }
  i = 0
  while (i < len(blk.x64Bytes)) {
    xEmitByte(cx.buf, blk.x64Bytes[i])
    i = i + 1
  }
  if (dst >= 0) {
    xPutInt(cx, dst, xRegOf(blk.resultX64))
  }
}

// Raw Linux syscall (§11.8): move each argument into its kernel-ABI register,
// the number into rax, emit the two-byte `syscall` opcode, then read the
// kernel's return value out of rax. Every register involved is excluded from
// the allocatable file for the whole function (xCollectReserved), so the moves
// cannot clobber a live value and can run in plain sequence.
fn xEmitSyscall(cx: XCtx, dst: int, nr: int, args: []int) {
  let regs = xSyscallArgRegs()
  let i = 0
  while (i < len(args)) {
    let src = xGetInt(cx, args[i], xScratch1())
    xMovRR(cx.buf, regs[i], src)
    i = i + 1
  }
  let nrSrc = xGetInt(cx, nr, xScratch1())
  xMovRR(cx.buf, XReg64.Rax, nrSrc)
  xEmitByte(cx.buf, 0x0F) // syscall
  xEmitByte(cx.buf, 0x05)
  xPutInt(cx, dst, XReg64.Rax)
}

// Every x64 register pinned by an `asm` block (`input`/`result`/clobber) or by
// a `syscall` in `f`, indexed by ModRM register number 0..15. The `memory`
// sentinel (254) falls outside the array and is skipped.
fn xCollectReserved(module: IrModule, f: IrFunc): []bool {
  let reserved = []bool(16)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    // §11.8: the number/return register, the six kernel argument registers, and
    // rcx/r11 — which the `syscall` instruction itself overwrites with the
    // return address and saved rflags. r10/r11 are codegen scratch and never
    // allocatable anyway; marking them keeps the set self-documenting.
    if (ins.op == Op.Syscall) {
      reserved[xRegNum(XReg64.Rax)] = true
      reserved[xRegNum(XReg64.Rcx)] = true
      reserved[xRegNum(XReg64.R11)] = true
      let regs = xSyscallArgRegs()
      let k = 0
      while (k < len(regs)) {
        reserved[xRegNum(regs[k])] = true
        k = k + 1
      }
    }
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      if (blk.hasResult && blk.resultX64 < 16) {
        reserved[blk.resultX64] = true
      }
      let j = 0
      while (j < len(blk.inX64)) {
        if (blk.inX64[j] < 16) {
          reserved[blk.inX64[j]] = true
        }
        j = j + 1
      }
      j = 0
      while (j < len(blk.clobX64)) {
        if (blk.clobX64[j] < 16) {
          reserved[blk.clobX64[j]] = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return reserved
}

fn xDstOrNone(cx: XCtx, i: int, ty: int): int {
  if (ty == cx.ctx.voidId) {
    return -1
  }
  return i
}

// Which `const_int` definitions (#1853) an ADD/SUB-immediate fold, an
// AND/OR/XOR-immediate fold (#3495), a power-of-two Mul (#3105) or a
// power-of-two SDiv/UDiv/SRem/URem (#3104, #1704) consumes entirely, indexed
// by instruction id. `instrOperands` (opt.bit) is the SAME operand map DCE
// uses, so a constant with any use besides a fold that reads it as an
// immediate keeps `false` and still materializes normally. Which operand each
// family folds is `xImmFoldConstOperand`'s question, and each of its arms
// mirrors its own emitter's operand precedence, so nothing here can mark
// skipped a value an emitter reads as a register — and every arm names a
// CONSTANT operand, never the other one.
//
// The test is EVERY USE IS A FOLD, not "there is exactly one use" (#4674, the
// x86-64 half of #4667's arm64 fix). The old count-of-one rule was not the
// safety condition, it was a proxy for it, and it read false on the commonest
// shape there is: one literal consumed by two different computations.
// `let k = 5; (n + k) * (m + k)` — a single `const_int i64 5` with two
// `addq $5` uses — materialized a `movq $0x5, %rdx` that no emitter ever read
// AND kept a register alive across the pair, because `skip` also drives
// `arm64WritesResult` (arm64dispatch.bit), which `xUsedIntRegs` (x64call.bit)
// calls with THIS array.
//
// The proxy also had a live fall-through hazard the per-arm rewrite removes:
// the Add arm dropped to its LHS whenever the RHS test failed, and one of the
// ways that test failed was a second USE of an RHS constant `xEmitBinaryInt`
// folds regardless of use count. The emitter would then fold the RHS while the
// LHS sat marked skipped and unmaterialized. The use count is not an emitter's
// business and is applied once, below.
//
// ALL FOUR divide ops qualify: `xEmitDivInt` (x64selectarith.bit) takes a
// register-free path for SDiv/UDiv AND for SRem/URem (`xEmitPow2RemInt`
// masks; since #4389 the magic-multiply sequence materializes its own
// constant, and since #4722 for `/` only) on exactly the plans
// `divPlanReadsDivisor` (divplan.bit) answers
// false for, so the divisor register is never read on x86-64 for any of the
// four. Since #4361 arm64's `emitDivInt` reduces on the same plans, which is
// why `mulDivFoldOperand` is shared rather than twinned — and why the shape
// #4389 added reached both backends without either arm learning about it.
//
// `useCount > 0` is what keeps this a statement about constants: `foldCount`
// is only ever incremented for an operand `xImmFoldConstOperand` named, so a
// zero count on both sides must not read as "all of its uses fold".
fn xComputeSkipConstMaterialize(ctx: TypeContext, f: IrFunc): []bool {
  let n = len(f.instrs)
  let useCount = []int(n)
  let foldCount = []int(n)
  let i = 0
  while (i < n) {
    let ops = instrOperands(f, i)
    let k = 0
    while (k < len(ops)) {
      useCount[ops[k]] = useCount[ops[k]] + 1
      k = k + 1
    }
    let c = xImmFoldConstOperand(ctx, f, f.instrs[i])
    if (c >= 0) {
      foldCount[c] = foldCount[c] + 1
    }
    i = i + 1
  }
  let skip = []bool(n)
  i = 0
  while (i < n) {
    skip[i] = useCount[i] > 0 && foldCount[i] == useCount[i]
    i = i + 1
  }
  return skip
}

// Which operand of `ins`, if any, an immediate fold in the x86-64 emitters
// consumes ENTIRELY — the one question the table above asks, so the
// every-use-is-a-fold rule and the `skip` bookkeeping are written once rather
// than once per op family. Returns that operand's instruction id, or -1.
// The arms are mutually exclusive by `ins.op`, so the order is presentation
// only.
//
// The arm64 twin `immFoldConstOperand` (arm64dispatch.bit) additionally offers
// an icmp operand: `emitIcmp` there folds a constant rhs into `cmp`/`cmn`
// (#4349). `xEmitIcmp` (x64selectarith.bit:282) has no such path — it fetches
// BOTH operands with `xGetInt` before the `cmp` — so naming one here would
// mark skipped a constant the emitter reads as a register. Under-naming only
// costs a materialization; over-naming is a silent miscompile.
//
// No `debug` parameter, and that asymmetry is real rather than an oversight:
// arm64's `addSubFoldOperand` must refuse in debug builds because its
// `emitBinaryInt` skips the ADD/SUB-immediate fold there (no flag-setting
// shifted-imm12 form to trap on). x86-64's group-1 `81 /digit id` form sets OF
// exactly like the register form, so `xTryAddSubImmFold` (x64select.bit:248)
// takes the same path in every build mode.
fn xImmFoldConstOperand(ctx: TypeContext, f: IrFunc, ins: IrInstr): int {
  let a = xAddSubFoldOperand(f, ins)
  if (a >= 0) {
    return a
  }
  let m = mulDivFoldOperand(ctx, f, ins)
  if (m >= 0) {
    return m
  }
  return xBitwiseShiftFoldOperand(f, ins)
}

// Whether `v` is an integer constant x86-64's group-1 immediate encoding takes
// whole — the test `xTryAddSubImmFold` and `xTryLogicalImmFold` both apply.
fn xArithImmOperandFits(f: IrFunc, v: int): bool {
  let c = xConstIntOf(f, v)
  return c.known && fitsXArithImm32(c.ival)
}

// Mirrors `xTryAddSubImmFold` (x64select.bit) in its own order: rhs first,
// then — for Add alone, since `k - x` != `x - k` — lhs.
fn xAddSubFoldOperand(f: IrFunc, ins: IrInstr): int {
  if (ins.op != Op.Add && ins.op != Op.Sub) {
    return -1
  }
  if (xArithImmOperandFits(f, ins.rhs)) {
    return ins.rhs
  }
  if (ins.op != Op.Add) {
    return -1
  }
  if (xArithImmOperandFits(f, ins.lhs)) {
    return ins.lhs
  }
  return -1
}

// `xLogicalConstSkip` (x64select.bit) already mirrors `xTryLogicalImmFold`'s
// rhs-then-lhs precedence for the three commutative bitwise ops.
//
// `xConstShiftAmount` (x64call.bit) masks any const_int to 0-63, never
// returning -1 for one — the only -1 case is "not a const_int at all" — so
// this answers with exactly the operand `xEmitShiftInt`'s own `constAmt >= 0`
// branch takes, and `xShiftImm` encodes any 0-63 value in one byte regardless
// of the IR's result width.
fn xBitwiseShiftFoldOperand(f: IrFunc, ins: IrInstr): int {
  if (ins.op == Op.BAnd || ins.op == Op.BOr || ins.op == Op.BXor) {
    return xLogicalConstSkip(f, ins.rhs, ins.lhs)
  }
  if (ins.op != Op.Shl && ins.op != Op.AShr && ins.op != Op.LShr) {
    return -1
  }
  if (xConstShiftAmount(f, ins.rhs) < 0) {
    return -1
  }
  return ins.rhs
}

// Emits one instruction. Returns false when the construct is unsupported (a
// multi-value ret), which fails the whole compile rather than emitting something
// that computes the wrong thing.
// The address-materialization family, plus the two inline-payload ops that
// share its shape: one value, operands that are not SSA reads of a base, and
// no dispatch on width. THE SAME SEVEN ARMS arm64's `compileInstAddr`
// (arm64dispatch.bit) already groups — x64 had them inline in `xEmitInst`,
// which is why the two dispatchers did not read alike.
//
// Extracted by #4457 rather than grown: adding `Op.PollAttention` inline took
// `xEmitInst` from complexity 62 to 63, past its recorded baseline in
// tools/build/complexity-debt.txt, and that file only ever shrinks. Moving six
// arms out and calling one takes it to 57 and leaves this at 8.
fn xEmitInstAddr(cx: XCtx, i: int, ins: IrInstr, ty: int): bool {
  let op = ins.op
  if (op == Op.MakeClosure) {
    xEmitMakeClosure(cx, i, ins.name, ins.lhs, ty)
    return true
  }
  if (op == Op.FuncAddr) {
    xEmitFuncAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.GlobalAddr) {
    xEmitGlobalAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.StackMapsAddr) {
    xEmitStackMapsAddr(cx, i, ins.name)
    return true
  }
  // #4457: not an address materialization but the same shape — one value, no
  // operands, no call — so it is claimed here rather than in a family of one.
  if (op == Op.PollAttention) {
    xEmitPollAttention(cx, i)
    return true
  }
  if (op == Op.Asm) {
    xEmitAsm(cx, xDstOrNone(cx, i, ty), ins.ival, ins.args)
    return true
  }
  if (op == Op.Syscall) {
    xEmitSyscall(cx, i, ins.lhs, ins.args)
    return true
  }
  return false
}

fn xEmitInst(cx: XCtx, i: int): bool {
  let ins = cx.f.instrs[i]
  let op = ins.op
  let ty = ins.ty
  // The RESULT width — it drives narrow re-canonicalization. A compare's own
  // result is a bool, so the float path re-reads its OPERAND width below.
  let iw = widthOf(cx.ctx, ty)

  if (op == Op.ConstInt) {
    if (!cx.skipConst[i]) {
      xEmitConstInt(cx, i, ins.ival)
    }
    return true
  }
  if (op == Op.ConstBool) {
    xEmitConstBool(cx, i, ins.bval)
    return true
  }
  if (op == Op.ConstNil) {
    xEmitConstNil(cx, i)
    return true
  }
  if (op == Op.ConstFloat) {
    xEmitConstFloat(cx, i, xFloatConstBits(ins.fval, iw.bytes), iw.bytes)
    return true
  }
  if (op == Op.ConstString) {
    xEmitConstString(cx, i, ins.ival)
    return true
  }
  if (op == Op.Add || op == Op.Sub || op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    xEmitBinaryInt(cx, xArithForOp(op), i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (op == Op.Mul) {
    xEmitMulInt(cx, i, ins.lhs, ins.rhs, xConstPow2Factor(cx.f, ins.lhs, ins.rhs, iw), iw)
    return true
  }
  if (op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem) {
    xEmitDivInt(cx, xDivOpForOp(op), i, ins.lhs, ins.rhs, xDivisorPlan(cx.f, ins.rhs, iw, op), iw)
    return true
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    xEmitShiftInt(cx, xShiftForOp(op), i, ins.lhs, ins.rhs, xConstShiftAmount(cx.f, ins.rhs), iw)
    return true
  }
  if (isIcmp(op)) {
    xEmitIcmp(cx, xCcForIcmp(op), i, ins.lhs, ins.rhs)
    return true
  }
  if (op == Op.FAdd || op == Op.FSub || op == Op.FMul || op == Op.FDiv) {
    xEmitBinaryFloat(cx, xFArithForOp(op), i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (isFcmp(op)) {
    // A float compare's operand width comes from the OPERANDS — its own result is
    // a bool, so `iw` would say 1 and compare the wrong half of the register.
    xEmitFcmp(
      cx,
      xFCmpForOp(op),
      i,
      ins.lhs,
      ins.rhs,
      widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes,
    )
    return true
  }
  if (op == Op.Neg || op == Op.BNot) {
    xEmitUnaryInt(cx, op == Op.Neg, i, ins.lhs, iw)
    return true
  }
  if (op == Op.Convert) {
    xEmitConvert(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty), iw)
    return true
  }
  if (op == Op.FNeg) {
    xEmitFneg(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.FSqrt) {
    xEmitFsqrt(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.Bitcast) {
    // The width always comes from the FLOAT side — the integer view of an f32
    // is 4 bytes wide whichever direction the transfer runs, and only one of
    // the two types carries a float width to read.
    let dstIsFloat = iw.regClass == RegClass.Float
    let bw = widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes
    if (dstIsFloat) {
      bw = iw.bytes
    }
    xEmitBitcast(cx, i, ins.lhs, bw, dstIsFloat)
    return true
  }
  if (op == Op.FFloor) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Floor)
    return true
  }
  if (op == Op.FCeil) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Ceil)
    return true
  }
  if (op == Op.FTrunc) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Trunc)
    return true
  }
  if (op == Op.FRound) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Round)
    return true
  }
  if (op == Op.Jump) {
    xEmitJump(cx, i, ins.ival, ins.args)
    return true
  }
  if (op == Op.Br) {
    xEmitBr(cx, i, ins)
    return true
  }
  if (op == Op.Ret) {
    return xEmitRet(cx, ins.args)
  }
  if (op == Op.Unreachable) {
    xUd2(cx.buf)
    return true
  }
  if (op == Op.Call) {
    xEmitCallLike(cx, ins.name, ins.args, ty != cx.ctx.voidId, i, ty, true)
    return true
  }
  if (op == Op.RtCall) {
    xEmitCallLike(cx, rtSymbol(ins.name), ins.args, ty != cx.ctx.voidId, i, ty, true)
    return true
  }
  if (op == Op.CallValue) {
    xEmitCallValue(cx, xDstOrNone(cx, i, ty), ty, ins.lhs, ins.args)
    return true
  }
  if (op == Op.CallIface) {
    xEmitCallIface(cx, xDstOrNone(cx, i, ty), ty, ins.lhs, ins.ival, ins.args)
    return true
  }
  if (op == Op.GcAlloc) {
    xEmitGcAlloc(cx, i, ty, ins.ival, ins.offsets)
    return true
  }
  if (op == Op.TypeInfo) {
    xEmitTypeInfo(cx, i, ins.ival, ins.ival2, ins.offsets)
    return true
  }
  if (xEmitInstAddr(cx, i, ins, ty)) {
    return true
  }
  if (op == Op.FieldGet) {
    xEmitFieldGet(
      cx, i, ins.lhs, ins.ival, iw, cx.ctx.types[ty].kind == TypeKind.Array,
      isHeaderBase(cx.ctx, cx.f.instrs[ins.lhs].ty),
    )
    return true
  }
  if (op == Op.FieldSet) {
    // Width comes from `ival2`, the store's OWN recorded type — set once at
    // construction, never re-derived from the value operand's defining
    // instruction (#4396: that read is wrong the moment an optimization
    // aliases the value to something of a different width).
    xEmitFieldSet(cx, ins.lhs, ins.ival, ins.rhs, widthOf(cx.ctx, ins.ival2))
    return true
  }
  if (op == Op.IndexGet) {
    xEmitIndexGet(cx, i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (op == Op.IndexSet) {
    // index_set keeps its VALUE operand in ival — rhs is the INDEX. Width
    // comes from `ival2`, the store's own recorded type (#4396).
    xEmitIndexSet(cx, ins.lhs, ins.rhs, ins.ival, widthOf(cx.ctx, ins.ival2))
    return true
  }
  if (op == Op.SliceLen) {
    xEmitSliceLen(cx, i, ins.lhs)
    return true
  }
  if (op == Op.AtomicLoad) {
    xEmitAtomicLoad(cx, i, ins.lhs, iw)
    return true
  }
  if (op == Op.AtomicStore) {
    // Pointee width from `ival2`, the store's own recorded type (#4396).
    xEmitAtomicStore(cx, ins.lhs, ins.rhs, widthOf(cx.ctx, ins.ival2))
    return true
  }
  if (op == Op.AtomicCmpxchg) {
    // Pointee width from `ival2`, the store's own recorded type (#4396).
    xEmitAtomicCmpxchg(
      cx, i,
      XAtomicCasOperands{
        ptr: ins.lhs,
        expected: ins.rhs,
        desired: ins.ival,
        w: widthOf(cx.ctx, ins.ival2),
      },
    )
    return true
  }
  if (opIsAtomicRmw(op)) {
    xEmitAtomicRmw(cx, op, i, ins.lhs, ins.rhs, iw)
    return true
  }
  // block_param is never reached: every emission loop starts past a block's
  // params.
  assert(op != Op.BlockParam)
  return false
}
