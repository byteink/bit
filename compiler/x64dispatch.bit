// Self-host Stage 3 (#1346): the x86-64 backend, instruction dispatch and driver.
// Split out of compiler/x64.bit; same module, so nothing here is imported.

// ---------------------------------------------------------------------------
// Instruction dispatch
// ---------------------------------------------------------------------------

// The x86 condition code an integer compare sets its result from. Signed and
// unsigned are DIFFERENT codes for the same relation (l/ge vs b/ae): reading a
// signed compare with an unsigned code silently reorders negative values.
fn xCcForIcmp(op: Op): int {
  if (op == Op.ICmpEq) {
    return ccE()
  }
  if (op == Op.ICmpNe) {
    return ccNe()
  }
  if (op == Op.ICmpSlt) {
    return ccL()
  }
  if (op == Op.ICmpSle) {
    return ccLe()
  }
  if (op == Op.ICmpSgt) {
    return ccG()
  }
  if (op == Op.ICmpSge) {
    return ccGe()
  }
  if (op == Op.ICmpUlt) {
    return ccB()
  }
  if (op == Op.ICmpUle) {
    return ccBe()
  }
  if (op == Op.ICmpUgt) {
    return ccA()
  }
  assert(op == Op.ICmpUge)
  return ccAe()
}

fn xArithForOp(op: Op): XArith {
  if (op == Op.Sub) {
    return XArith.Sub
  }
  if (op == Op.BAnd) {
    return XArith.And
  }
  if (op == Op.BOr) {
    return XArith.Or
  }
  if (op == Op.BXor) {
    return XArith.Xor
  }
  assert(op == Op.Add)
  return XArith.Add
}

fn xDivOpForOp(op: Op): XDivOp {
  if (op == Op.UDiv) {
    return XDivOp.UDiv
  }
  if (op == Op.SRem) {
    return XDivOp.SRem
  }
  if (op == Op.URem) {
    return XDivOp.URem
  }
  assert(op == Op.SDiv)
  return XDivOp.SDiv
}

fn xShiftForOp(op: Op): XShift {
  if (op == Op.LShr) {
    return XShift.Shr
  }
  if (op == Op.AShr) {
    return XShift.Sar
  }
  assert(op == Op.Shl)
  return XShift.Shl
}

fn xFArithForOp(op: Op): XFArith {
  if (op == Op.FSub) {
    return XFArith.FSub
  }
  if (op == Op.FMul) {
    return XFArith.FMul
  }
  if (op == Op.FDiv) {
    return XFArith.FDiv
  }
  assert(op == Op.FAdd)
  return XFArith.FAdd
}

fn xFCmpForOp(op: Op): XFCmp {
  if (op == Op.FCmpNe) {
    return XFCmp.FNe
  }
  if (op == Op.FCmpLt) {
    return XFCmp.FLt
  }
  if (op == Op.FCmpLe) {
    return XFCmp.FLe
  }
  if (op == Op.FCmpGt) {
    return XFCmp.FGt
  }
  if (op == Op.FCmpGe) {
    return XFCmp.FGe
  }
  assert(op == Op.FCmpEq)
  return XFCmp.FEq
}

// The bit pattern a float constant is materialized from. An f32 constant must be
// NARROWED first and its 32-bit pattern used — feeding the f64 bits to a 4-byte
// movd loads the wrong half of the value.
fn xFloatConstBits(val: f64, width: int): int {
  if (width == 4) {
    return i64(u64(float32Bits(f32(val))))
  }
  return i64(floatBits(val))
}

// A void-typed instruction has no result to bind; -1 says so.
// Inline assembly (§11.6): move each `input` value into its fixed register
// (excluded from the allocatable file for the whole function), emit the x64
// sub-block's pre-encoded bytes verbatim, then read the `result` register (if
// any) into the instruction's result vreg. `dst` is -1 for a result-less block.
fn xEmitAsm(cx: XCtx, dst: int, block: int, inVals: []int) {
  let blk = cx.module.asmBlocks[block]
  let i = 0
  while (i < len(inVals)) {
    let src = xGetInt(cx, inVals[i], xScratch1())
    xMovRR(cx.buf, xRegOf(blk.inX64[i]), src)
    i = i + 1
  }
  i = 0
  while (i < len(blk.x64Bytes)) {
    xEmitByte(cx.buf, blk.x64Bytes[i])
    i = i + 1
  }
  if (dst >= 0) {
    xPutInt(cx, dst, xRegOf(blk.resultX64))
  }
}

// Raw Linux syscall (§11.8): move each argument into its kernel-ABI register,
// the number into rax, emit the two-byte `syscall` opcode, then read the
// kernel's return value out of rax. Every register involved is excluded from
// the allocatable file for the whole function (xCollectReserved), so the moves
// cannot clobber a live value and can run in plain sequence.
fn xEmitSyscall(cx: XCtx, dst: int, nr: int, args: []int) {
  let regs = xSyscallArgRegs()
  let i = 0
  while (i < len(args)) {
    let src = xGetInt(cx, args[i], xScratch1())
    xMovRR(cx.buf, regs[i], src)
    i = i + 1
  }
  let nrSrc = xGetInt(cx, nr, xScratch1())
  xMovRR(cx.buf, XReg64.Rax, nrSrc)
  xEmitByte(cx.buf, 0x0F) // syscall
  xEmitByte(cx.buf, 0x05)
  xPutInt(cx, dst, XReg64.Rax)
}

// Every x64 register pinned by an `asm` block (`input`/`result`/clobber) or by
// a `syscall` in `f`, indexed by ModRM register number 0..15. The `memory`
// sentinel (254) falls outside the array and is skipped.
fn xCollectReserved(module: IrModule, f: IrFunc): []bool {
  let reserved = []bool(16)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    // §11.8: the number/return register, the six kernel argument registers, and
    // rcx/r11 — which the `syscall` instruction itself overwrites with the
    // return address and saved rflags. r10/r11 are codegen scratch and never
    // allocatable anyway; marking them keeps the set self-documenting.
    if (ins.op == Op.Syscall) {
      reserved[xRegNum(XReg64.Rax)] = true
      reserved[xRegNum(XReg64.Rcx)] = true
      reserved[xRegNum(XReg64.R11)] = true
      let regs = xSyscallArgRegs()
      let k = 0
      while (k < len(regs)) {
        reserved[xRegNum(regs[k])] = true
        k = k + 1
      }
    }
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      if (blk.hasResult && blk.resultX64 < 16) {
        reserved[blk.resultX64] = true
      }
      let j = 0
      while (j < len(blk.inX64)) {
        if (blk.inX64[j] < 16) {
          reserved[blk.inX64[j]] = true
        }
        j = j + 1
      }
      j = 0
      while (j < len(blk.clobX64)) {
        if (blk.clobX64[j] < 16) {
          reserved[blk.clobX64[j]] = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return reserved
}

fn xDstOrNone(cx: XCtx, i: int, ty: int): int {
  if (ty == cx.ctx.voidId) {
    return -1
  }
  return i
}

// Which `const_int` definitions (#1853) an ADD/SUB-immediate fold, an
// AND/OR/XOR-immediate fold (#3495), a power-of-two Mul (#3105) or a
// power-of-two SDiv/UDiv/SRem/URem (#3104, #1704) consumes entirely, indexed
// by instruction id. `instrOperands`
// (opt.bit) is the SAME operand map DCE uses, so a constant with any use
// besides the one fold that reads it as an immediate keeps `false` and still
// materializes normally — this only marks a def whose sole structural use is
// that one fold. Mirrors `xEmitBinaryInt`/`xEmitMulInt`/`xEmitDivInt`'s own
// operand order exactly, so it never marks a value skipped that the emitter
// actually reads as a register.
//
// Unlike the arm64 twin, ALL FOUR divide ops qualify here: `xEmitDivInt`
// (x64selectarith.bit) takes a shift/mask path for SDiv/UDiv AND a mask path for
// SRem/URem (`xEmitPow2RemInt`) whenever `pow2K >= 0`, so the divisor
// register is never read on x86-64 for any of the four — arm64's `emitDivInt`
// only reduces SDiv/UDiv (msub still needs the real divisor to recover a
// Rem), which is why its own twin excludes Rem. Marking a divisor skipped
// that the emitter still reads would be a silent miscompile, which is exactly
// what the `useCount == 1` guard below exists to prevent.
fn xComputeSkipConstMaterialize(ctx: TypeContext, f: IrFunc): []bool {
  let n = len(f.instrs)
  let useCount = []int(0)
  let i = 0
  while (i < n) {
    useCount = append(useCount, 0)
    i = i + 1
  }
  i = 0
  while (i < n) {
    let ops = instrOperands(f, i)
    let k = 0
    while (k < len(ops)) {
      useCount[ops[k]] = useCount[ops[k]] + 1
      k = k + 1
    }
    i = i + 1
  }
  let skip = []bool(0)
  i = 0
  while (i < n) {
    skip = append(skip, false)
    i = i + 1
  }
  i = 0
  while (i < n) {
    let ins = f.instrs[i]
    if (ins.op == Op.Add || ins.op == Op.Sub) {
      let rc = xConstIntOf(f, ins.rhs)
      if (rc.known && fitsXArithImm32(rc.ival) && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      } else if (ins.op == Op.Add) {
        let lc = xConstIntOf(f, ins.lhs)
        if (lc.known && fitsXArithImm32(lc.ival) && useCount[ins.lhs] == 1) {
          skip[ins.lhs] = true
        }
      }
    } else if (ins.op == Op.Mul) {
      let w = widthOf(ctx, ins.ty)
      let factor = xConstPow2Factor(f, ins.lhs, ins.rhs, w)
      if (factor.k >= 0) {
        let constOp = ins.lhs
        if (factor.value == ins.lhs) {
          constOp = ins.rhs
        }
        if (useCount[constOp] == 1) {
          skip[constOp] = true
        }
      }
    } else if (ins.op == Op.BAnd || ins.op == Op.BOr || ins.op == Op.BXor) {
      let s = xLogicalConstSkip(f, ins.rhs, ins.lhs)
      if (s >= 0 && useCount[s] == 1) {
        skip[s] = true
      }
    } else if (ins.op == Op.SDiv || ins.op == Op.UDiv || ins.op == Op.SRem || ins.op == Op.URem) {
      let w = widthOf(ctx, ins.ty)
      let pk = xConstPow2Divisor(f, ins.rhs, w)
      if (pk >= 0 && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      }
    } else if (ins.op == Op.Shl || ins.op == Op.AShr || ins.op == Op.LShr) {
      // `xConstShiftAmount` (x64call.bit) masks any const_int to 0-63, never
      // returning -1 for one — the only -1 case is "not a const_int at all"
      // — so this guard fires on exactly the operand `xEmitShiftInt`'s own
      // `constAmt >= 0` branch takes, and `xShiftImm` encodes any 0-63 value
      // in one byte regardless of the IR's result width.
      if (xConstShiftAmount(f, ins.rhs) >= 0 && useCount[ins.rhs] == 1) {
        skip[ins.rhs] = true
      }
    }
    i = i + 1
  }
  return skip
}

// Emits one instruction. Returns false when the construct is unsupported (a
// multi-value ret), which fails the whole compile rather than emitting something
// that computes the wrong thing.
fn xEmitInst(cx: XCtx, i: int): bool {
  let ins = cx.f.instrs[i]
  let op = ins.op
  let ty = ins.ty
  // The RESULT width — it drives narrow re-canonicalization. A compare's own
  // result is a bool, so the float path re-reads its OPERAND width below.
  let iw = widthOf(cx.ctx, ty)

  if (op == Op.ConstInt) {
    if (!cx.skipConst[i]) {
      xEmitConstInt(cx, i, ins.ival)
    }
    return true
  }
  if (op == Op.ConstBool) {
    xEmitConstBool(cx, i, ins.bval)
    return true
  }
  if (op == Op.ConstNil) {
    xEmitConstNil(cx, i)
    return true
  }
  if (op == Op.ConstFloat) {
    xEmitConstFloat(cx, i, xFloatConstBits(ins.fval, iw.bytes), iw.bytes)
    return true
  }
  if (op == Op.ConstString) {
    xEmitConstString(cx, i, ins.ival)
    return true
  }
  if (op == Op.Add || op == Op.Sub || op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    xEmitBinaryInt(cx, xArithForOp(op), i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (op == Op.Mul) {
    xEmitMulInt(cx, i, ins.lhs, ins.rhs, xConstPow2Factor(cx.f, ins.lhs, ins.rhs, iw), iw)
    return true
  }
  if (op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem) {
    xEmitDivInt(cx, xDivOpForOp(op), i, ins.lhs, ins.rhs, xConstPow2Divisor(cx.f, ins.rhs, iw), iw)
    return true
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    xEmitShiftInt(cx, xShiftForOp(op), i, ins.lhs, ins.rhs, xConstShiftAmount(cx.f, ins.rhs), iw)
    return true
  }
  if (isIcmp(op)) {
    xEmitIcmp(cx, xCcForIcmp(op), i, ins.lhs, ins.rhs)
    return true
  }
  if (op == Op.FAdd || op == Op.FSub || op == Op.FMul || op == Op.FDiv) {
    xEmitBinaryFloat(cx, xFArithForOp(op), i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (isFcmp(op)) {
    // A float compare's operand width comes from the OPERANDS — its own result is
    // a bool, so `iw` would say 1 and compare the wrong half of the register.
    xEmitFcmp(
      cx,
      xFCmpForOp(op),
      i,
      ins.lhs,
      ins.rhs,
      widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes,
    )
    return true
  }
  if (op == Op.Neg || op == Op.BNot) {
    xEmitUnaryInt(cx, op == Op.Neg, i, ins.lhs, iw)
    return true
  }
  if (op == Op.Convert) {
    xEmitConvert(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty), iw)
    return true
  }
  if (op == Op.FNeg) {
    xEmitFneg(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.FSqrt) {
    xEmitFsqrt(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.Bitcast) {
    // The width always comes from the FLOAT side — the integer view of an f32
    // is 4 bytes wide whichever direction the transfer runs, and only one of
    // the two types carries a float width to read.
    let dstIsFloat = iw.regClass == RegClass.Float
    let bw = widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes
    if (dstIsFloat) {
      bw = iw.bytes
    }
    xEmitBitcast(cx, i, ins.lhs, bw, dstIsFloat)
    return true
  }
  if (op == Op.FFloor) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Floor)
    return true
  }
  if (op == Op.FCeil) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Ceil)
    return true
  }
  if (op == Op.FTrunc) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Trunc)
    return true
  }
  if (op == Op.FRound) {
    xEmitFRound(cx, i, ins.lhs, XRoundMode.Round)
    return true
  }
  if (op == Op.Jump) {
    xEmitJump(cx, ins.ival, ins.args)
    return true
  }
  if (op == Op.Br) {
    xEmitBr(cx, ins.lhs, ins.ival, ins.thenArgs, ins.ival2, ins.elseArgs)
    return true
  }
  if (op == Op.Ret) {
    return xEmitRet(cx, ins.args)
  }
  if (op == Op.Unreachable) {
    xUd2(cx.buf)
    return true
  }
  if (op == Op.Call) {
    xEmitCallLike(cx, ins.name, ins.args, ty != cx.ctx.voidId, i, ty, true)
    return true
  }
  if (op == Op.RtCall) {
    xEmitCallLike(cx, rtSymbol(ins.name), ins.args, ty != cx.ctx.voidId, i, ty, true)
    return true
  }
  if (op == Op.CallValue) {
    xEmitCallValue(cx, xDstOrNone(cx, i, ty), ty, ins.lhs, ins.args)
    return true
  }
  if (op == Op.CallIface) {
    xEmitCallIface(cx, xDstOrNone(cx, i, ty), ty, ins.lhs, ins.ival, ins.args)
    return true
  }
  if (op == Op.GcAlloc) {
    xEmitGcAlloc(cx, i, ty, ins.ival, ins.offsets)
    return true
  }
  if (op == Op.TypeInfo) {
    xEmitTypeInfo(cx, i, ins.ival, ins.ival2, ins.offsets)
    return true
  }
  if (op == Op.MakeClosure) {
    xEmitMakeClosure(cx, i, ins.name, ins.lhs, ty)
    return true
  }
  if (op == Op.FuncAddr) {
    xEmitFuncAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.GlobalAddr) {
    xEmitGlobalAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.StackMapsAddr) {
    xEmitStackMapsAddr(cx, i, ins.name)
    return true
  }
  if (op == Op.Asm) {
    xEmitAsm(cx, xDstOrNone(cx, i, ty), ins.ival, ins.args)
    return true
  }
  if (op == Op.Syscall) {
    xEmitSyscall(cx, i, ins.lhs, ins.args)
    return true
  }
  if (op == Op.FieldGet) {
    xEmitFieldGet(
      cx, i, ins.lhs, ins.ival, iw, cx.ctx.types[ty].kind == TypeKind.Array,
      isHeaderBase(cx.ctx, cx.f.instrs[ins.lhs].ty),
    )
    return true
  }
  if (op == Op.FieldSet) {
    xEmitFieldSet(cx, ins.lhs, ins.ival, ins.rhs, widthOf(cx.ctx, cx.f.instrs[ins.rhs].ty))
    return true
  }
  if (op == Op.IndexGet) {
    xEmitIndexGet(cx, i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (op == Op.IndexSet) {
    // index_set keeps its VALUE operand in ival — rhs is the INDEX.
    xEmitIndexSet(cx, ins.lhs, ins.rhs, ins.ival, widthOf(cx.ctx, cx.f.instrs[ins.ival].ty))
    return true
  }
  if (op == Op.SliceLen) {
    xEmitSliceLen(cx, i, ins.lhs)
    return true
  }
  if (op == Op.AtomicLoad) {
    xEmitAtomicLoad(cx, i, ins.lhs, iw)
    return true
  }
  if (op == Op.AtomicStore) {
    xEmitAtomicStore(cx, ins.lhs, ins.rhs, widthOf(cx.ctx, cx.f.instrs[ins.rhs].ty))
    return true
  }
  if (op == Op.AtomicCmpxchg) {
    xEmitAtomicCmpxchg(cx, i, ins.lhs, ins.rhs, ins.ival)
    return true
  }
  if (opIsAtomicRmw(op)) {
    xEmitAtomicRmw(cx, op, i, ins.lhs, ins.rhs, iw)
    return true
  }
  // block_param is never reached: every emission loop starts past a block's
  // params.
  assert(op != Op.BlockParam)
  return false
}

// ---------------------------------------------------------------------------
// Top-level driver
// ---------------------------------------------------------------------------

// Compiles one function to x86-64 machine code for `cc`. Runs register
// allocation itself (intervals and safepoints come from the shared
// buildIntervals), lays out the frame, then emits the prologue, every block in
// f.blocks order — which back-edge detection assumes is the original builder/RPO
// order (see isBackEdge) — and finally patches the jump targets.
//
// Returns a FuncCode with an empty name when the function contains a construct
// this backend refuses (a multi-value ret): the caller must not emit a binary.
fn xCompileFunction(module: IrModule, f: IrFunc, cc: XCallConv, debug: bool): FuncCode {
  let ctx = module.ctx
  let flags = xScanFuncFlags(f)
  let intRegs = xBuildIntRegs(cc, flags)
  let floatRegs = xBuildFloatRegs()

  // Registers an `asm` block pins (`input`/`result`/clobber, §11.6) or a
  // `syscall` pins (number/argument/clobber, §11.8) leave the allocatable file
  // for the whole function — the same exclusion the needsRaxRdx/needsRcx flags
  // apply for div/shift, generalized to an arbitrary set. Neither construct
  // leaves `intRegs` exactly as `xBuildIntRegs` returned.
  let reserved = xCollectReserved(module, f)
  let allocRegs = []XReg64(0)
  let ri = 0
  while (ri < len(intRegs)) {
    if (!reserved[xRegNum(intRegs[ri])]) {
      allocRegs = append(allocRegs, intRegs[ri])
    }
    ri = ri + 1
  }
  intRegs = allocRegs

  // §10.3.1 @naked: the prologue never runs, so a callee-saved register would be
  // clobbered without ever being saved. Restrict a naked function to the volatile
  // file. If that is not enough registers, regalloc spills instead — and the frame
  // check below refuses the function loudly rather than letting it silently
  // corrupt its caller.
  if (f.isNaked) {
    let nakedInt = []XReg64(0)
    let ni = 0
    while (ni < len(intRegs)) {
      if (!xIsCalleeSavedInt(cc, intRegs[ni])) {
        nakedInt = append(nakedInt, intRegs[ni])
      }
      ni = ni + 1
    }
    intRegs = nakedInt
    let nakedFloat = []XmmReg(0)
    let nf = 0
    while (nf < len(floatRegs)) {
      if (!xIsCalleeSavedFloat(cc, floatRegs[nf])) {
        nakedFloat = append(nakedFloat, floatRegs[nf])
      }
      nf = nf + 1
    }
    floatRegs = nakedFloat
  }

  let built = buildIntervals(ctx, f)
  // #3738's `built.roots` on the same terms as arm64: the two backends share
  // buildIntervals and regalloc, so a coalescing rule that only one of them
  // consumed would be exactly the per-backend liveness drift codegenlive.bit's
  // header exists to prevent.
  let result = allocateCoalesced(
    TargetRegs{
      intRegs: RegFile{ count: len(intRegs), calleeSaved: xCalleeSavedIntMask(cc, intRegs) },
      floatRegs: RegFile{
        count: len(floatRegs),
        calleeSaved: xCalleeSavedFloatMask(cc, floatRegs),
      },
    },
    built.intervals,
    built.safepoints,
    xClobberPoints(f, built.safepoints),
    built.roots,
  )

  // Hoisted above the frame layout because `xUsedIntRegs` needs it: a
  // `const_int` a fold consumes whole is never materialized, so it never writes
  // the register it was allocated, and counting it saved a register the body
  // provably never touches. `cx.skipConst` below is this same array.
  let skipConst = xComputeSkipConstMaterialize(ctx, f)
  let savedGpr = xBuildSavedGpr(
    cc, intRegs,
    xUsedIntRegs(ctx, f, skipConst, built.intervals, result.locations, len(intRegs)),
  )
  // Deliberately NOT narrowed the same way: under SysV `xIsCalleeSavedFloat` is
  // false for every XMM, so this is already empty on the one convention #3860
  // measured, and Win64 — where xmm6..xmm13 are both callee-saved and
  // allocatable — has no hardware here to prove it on.
  let savedXmm = xBuildSavedXmm(cc, floatRegs)

  // #3169/#4203: a function that polls a loop back edge gets ONE EXTRA spill
  // slot on top of the ones the allocator asked for, caching the address of the
  // runtime's attention word for the back-edge poll guard (xPollCacheOffset /
  // xEmitPollGuard). It was two, then three (#3746's preempt summary), then
  // four (#4200's countdown) while the guard re-derived the whole poll
  // predicate inline; #4203 replaced that with one word the runtime publishes.
  // Sized here because the frame is laid out before emission, and off the same
  // predicate xScanFuncFlags uses for hasSafepoints — so a polling function is
  // always allocated out of the callee-saved-only file and always has a
  // prologue to address rbp from. The allocator never names an index this high,
  // so it stays out of every stack map (see the slots loop below).
  let pollCacheSlots = 0
  if (hasBackEdgeSafepoint(f)) {
    pollCacheSlots = 1
  }
  assert(pollCacheSlots == 0 || flags.hasSafepoints)

  // The XMMs live inside the carved frame alongside the spill slots; the GPRs are
  // pushed, so they are NOT part of frameSize — only its alignment (an odd number
  // of pushes leaves rsp 8 off).
  let numSlots = result.numSpillSlots + pollCacheSlots
  let rawFrame = 8 * (numSlots + len(savedXmm))
  // #3906: the rounding exists so rsp is 16-aligned AT A CALL, so a function
  // that emits none pays nothing for it. `flags` alone is NOT that predicate —
  // see xNeedsCallAlign (x64frame.bit), which takes it and finishes the job.
  let needsCallAlign = xNeedsCallAlign(f, flags, debug)
  let frame = XFrame{
    savedGpr: savedGpr, savedXmm: savedXmm, numSpillSlots: numSlots,
    frameSize: xAlignFrame(rawFrame, len(savedGpr), needsCallAlign),
  }

  // §10.3.1 @naked safety net: a spill slot is the only *per-function* frame need
  // a naked function can develop. savedGpr is now what this function's allocation
  // actually assigned (#3860 — it used to be a constant of the target, all four
  // SysV callee-saved GPRs), but for a NAKED function the two agree at empty:
  // the volatile-only file above contains no callee-saved register for the
  // allocator to hand out, so nothing can reach either list. Naked functions
  // allocate out of that file, so a spill here means the body outgrew what a
  // prologue-less function can hold.
  if (f.isNaked && result.numSpillSlots != 0) {
    return FuncCode{
      name: "", code: []u8(0), relocs: []Reloc(0),
      safepoints: []SafepointView(0), savedRegs: []SavedReg(0), frameSize: 0,
      lines: []DebugLineRow(0),
    }
  }

  let cx = newXCtx(cc)
  cx.module = module
  cx.ctx = ctx
  cx.f = f
  cx.debug = debug
  cx.skipConst = skipConst
  cx.alloc = result
  cx.intRegs = intRegs
  cx.floatRegs = floatRegs
  cx.frame = frame
  cx.noCallAlign = !needsCallAlign // arms xCallReloc/xCallReg's backstop assert
  cx.blockOffsets = []int(len(f.blocks))
  cx.safepointCodeOffsets = []int(len(built.safepoints))

  // §10.3.1 @naked: no prologue — the function runs on its caller's frame.
  if (!f.isNaked) {
    xEmitPrologue(cx)
  }
  xBindIncomingArgs(cx)
  // #3169: after the incoming args are off the ABI registers and onto their real
  // (callee-saved, since hasSafepoints) homes — otherwise these two calls'
  // caller-saved clobber would destroy an argument still sitting in rdi..r9.
  xEmitPollCachePrefetch(cx)

  let ok = true
  let bi = 0
  while (bi < len(f.blocks)) {
    cx.curBlock = bi
    cx.blockOffsets[bi] = len(cx.buf.code)
    let b = f.blocks[bi]
    let i = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (i < end) {
      // #3283: record this instruction's source position before it emits
      // any code, so the row's pcOffset names where it actually starts.
      cx.dbgRows = appendDebugLineIfChanged(
        cx.dbgRows,
        debugPosOf(cx.module.sm, f.instrs[i].span), len(cx.buf.code),
      )
      if (!xEmitInst(cx, i)) {
        ok = false
      }
      i = i + 1
    }
    bi = bi + 1
  }
  xPatchJumpFixups(cx)

  if (!ok) {
    return FuncCode{
      name: "", code: []u8(0), relocs: []Reloc(0),
      safepoints: []SafepointView(0), savedRegs: []SavedReg(0), frameSize: 0,
      lines: []DebugLineRow(0),
    }
  }

  // Every safepoint the interval builder predicted must have been reached during
  // emission, or the stack maps below pair with the wrong return addresses.
  assert(cx.nextSafepointIdx == len(built.safepoints))

  // Pair each allocator stack map with the code offset emission recorded for it —
  // the two lists are in the same order by construction.
  let safepoints = []SafepointView(0)
  let si = 0
  while (si < len(result.stackMaps)) {
    let sm = result.stackMaps[si]
    let regs = []int(0)
    for r of sm.regs {
      regs = append(regs, xRegNum(intRegs[r]))
    }
    // Only the ALLOCATOR's own slot indices, which is what keeps #3169's
    // poll-cache slots out of the table: they sit above every index that can
    // appear here, so the collector never tries to trace the World or GC
    // module-state address as a managed object.
    let slots = []int(0)
    for s of sm.slots {
      assert(s < frame.numSpillSlots - pollCacheSlots)
      slots = append(slots, xSpillOffset(frame, s))
    }
    safepoints = append(
      safepoints,
      SafepointView{
        retOffset: cx.safepointCodeOffsets[si],
        slots: slots, regs: regs,
      },
    )
    si = si + 1
  }

  // Register-recovery slots: the prologue does `push rbp; mov rbp,rsp; push
  // savedGpr[i]...`, so the caller's savedGpr[i] lands at rbp - 8*(i+1) —
  // frame-pointer-relative, matching SafepointView's own offsets.
  let savedRegs = []SavedReg(0)
  let gi = 0
  while (gi < len(savedGpr)) {
    savedRegs = append(savedRegs, SavedReg{ reg: xRegNum(savedGpr[gi]), fpOff: -8 * (gi + 1) })
    gi = gi + 1
  }

  return FuncCode{
    name: f.name, code: cx.buf.code, relocs: cx.relocs,
    safepoints: safepoints, savedRegs: savedRegs, frameSize: frame.frameSize,
    lines: cx.dbgRows,
  }
}
