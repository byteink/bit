// compiler/pmversionset.bit — version-set arithmetic for the PubGrub resolver
// (#2366). PubGrub's "terms" reason about arbitrary unions of version ranges,
// not just the single contiguous range a `^`/`~`/exact constraint (#2364)
// describes on its own: deriving the negation of a constraint, or resolving
// two conflicting incompatibilities, both need real set complement and union,
// which a lone `Constraint` cannot represent (its complement is generally TWO
// disjoint ranges — everything below it and everything above).
//
// A `VersionSet` is `[]Range`, always kept canonical: sorted ascending by
// `min`, pairwise disjoint, and non-adjacent ranges never merged into one
// (adjacent half-open ranges DO get coalesced — see `mergeSortedRanges` — so
// canonical form is unique for a given set of versions). An empty slice is
// the empty set (no version satisfies); the one-element universe set (`[0.0.0,
// +inf)`) is every version. Every function below both takes and returns
// canonical sets, so canonicality never needs re-establishing by a caller.
//
// Versions have no fractional component (`major.minor.patch` are all `int`),
// so "the version immediately after `v`" is well-defined (`versionNext`) and
// an exact-pin constraint is exactly the range `[v, versionNext(v))` — no
// separate "point" representation is needed anywhere in this file.

// One half-open interval `[min, max)`, or `[min, +inf)` when `!hasMax`. `max`
// is meaningless (never read) when `hasMax` is false; every function here
// checks `hasMax` before touching it.
class Range {
  min: Version,
  max: Version,
  hasMax: bool,
}

fn versionZero(): Version {
  return Version{ major: 0, minor: 0, patch: 0 }
}

// The version immediately after `v` in `MAJOR.MINOR.PATCH` order — there is
// no version strictly between `v` and this, so `[v, versionNext(v))` is
// exactly `{v}`.
fn versionNext(v: Version): Version {
  return Version{ major: v.major, minor: v.minor, patch: v.patch + 1 }
}

fn versionMin(a: Version, b: Version): Version {
  if (versionLess(a, b)) {
    return a
  }
  return b
}

fn versionMax(a: Version, b: Version): Version {
  if (versionLess(a, b)) {
    return b
  }
  return a
}

// The universe set: every version from 0.0.0 up.
fn versionSetUniverse(): []Range {
  return [Range{ min: versionZero(), max: versionZero(), hasMax: false }]
}

fn versionSetEmpty(): []Range {
  return []Range(0)
}

// The set a `^`/`~`/exact constraint (#2364) describes, as a single range.
// Reuses `constraintUpperBound` (pmversion.bit) for `^`/`~` rather than
// re-deriving the caret/tilde bump rules a second time; an exact pin's
// range is `[v, versionNext(v))`, matching no other version by construction.
fn versionSetFromConstraint(c: Constraint): []Range {
  if (c.op == ConstraintOp.Exact) {
    return [Range{ min: c.version, max: versionNext(c.version), hasMax: true }]
  }
  return [Range{ min: c.version, max: constraintUpperBound(c), hasMax: true }]
}

fn versionSetIsEmpty(vs: []Range): bool {
  return len(vs) == 0
}

fn versionSetIsUniverse(vs: []Range): bool {
  return len(vs) == 1 && versionEq(vs[0].min, versionZero()) && !vs[0].hasMax
}

// Whether `r`'s exclusive upper bound is at or below `v` — always false for
// an unbounded range.
fn rangeAtOrAboveMax(r: Range, v: Version): bool {
  if (!r.hasMax) {
    return false
  }
  return !versionLess(v, r.max)
}

fn rangeContainsVersion(r: Range, v: Version): bool {
  return !versionLess(v, r.min) && !rangeAtOrAboveMax(r, v)
}

fn versionSetContainsVersion(vs: []Range, v: Version): bool {
  let i = 0
  while (i < len(vs)) {
    if (rangeContainsVersion(vs[i], v)) {
      return true
    }
    i = i + 1
  }
  return false
}

// `a ∩ b`, or `(_, false)` when they do not overlap at all.
fn rangeIntersect(a: Range, b: Range): (Range, bool) {
  let lo = versionMax(a.min, b.min)
  let hasMax = a.hasMax || b.hasMax
  let hi = a.max
  if (a.hasMax && b.hasMax) {
    hi = versionMin(a.max, b.max)
  } else if (b.hasMax) {
    hi = b.max
  }
  if (hasMax && !versionLess(lo, hi)) {
    return Range{ min: lo, max: hi, hasMax: true }, false
  }
  return Range{ min: lo, max: hi, hasMax: hasMax }, true
}

// `a ∩ b` over full sets. Every pairwise range intersection is mutually
// disjoint by construction (two results can only share a version if it lies
// in two DIFFERENT ranges of `a` — impossible, `a` is itself disjoint — or
// symmetrically for `b`), and iterating `a` and `b` both ascending yields
// them already in ascending order, so no separate sort/merge pass is needed
// here the way `versionSetUnion` (below) requires.
fn versionSetIntersect(a: []Range, b: []Range): []Range {
  let out = []Range(0)
  let i = 0
  while (i < len(a)) {
    let j = 0
    while (j < len(b)) {
      let (r, ok) = rangeIntersect(a[i], b[j])
      if (ok) {
        out = append(out, r)
      }
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// Insertion sort by ascending `min` — `rs` is a freshly built slice (never an
// alias of caller data), small (a handful of ranges), and insertion sort is
// simplest correct choice at that size. Bounded by `len(rs)^2`.
fn sortRangesByMin(rs: []Range): []Range {
  let out = rs
  let n = len(out)
  let i = 1
  while (i < n) {
    let cur = out[i]
    let j = i
    while (j > 0 && versionLess(cur.min, out[j - 1].min)) {
      out[j] = out[j - 1]
      j = j - 1
    }
    out[j] = cur
    i = i + 1
  }
  return out
}

// Whether `b` starts at or before `a`'s own exclusive end, so the two
// half-open ranges merge into one contiguous range (`[x,y)` and `[y,z)` ->
// `[x,z)`). Only called on ranges already sorted ascending by `min`, so this
// is the only overlap direction that can occur.
fn rangesTouchOrOverlap(a: Range, b: Range): bool {
  if (!a.hasMax) {
    return true
  }
  return !versionLess(a.max, b.min)
}

fn rangeUnion(a: Range, b: Range): Range {
  let hasMax = a.hasMax && b.hasMax
  let hi = a.max
  if (hasMax) {
    hi = versionMax(a.max, b.max)
  }
  return Range{ min: a.min, max: hi, hasMax: hasMax }
}

// Coalesces a `min`-sorted (not necessarily disjoint) list into canonical
// form: a single left-to-right sweep merging every touching/overlapping run.
fn mergeSortedRanges(sorted: []Range): []Range {
  let out = []Range(0)
  let i = 0
  while (i < len(sorted)) {
    let cur = sorted[i]
    i = i + 1
    while (i < len(sorted) && rangesTouchOrOverlap(cur, sorted[i])) {
      cur = rangeUnion(cur, sorted[i])
      i = i + 1
    }
    out = append(out, cur)
  }
  return out
}

// `a ∪ b`. Unlike intersection, a straight concatenation of two individually
// sorted lists is not itself sorted (their ranges can interleave), so this
// sorts the combined list before the merge sweep.
fn versionSetUnion(a: []Range, b: []Range): []Range {
  let combined = []Range(0)
  let i = 0
  while (i < len(a)) {
    combined = append(combined, a[i])
    i = i + 1
  }
  let j = 0
  while (j < len(b)) {
    combined = append(combined, b[j])
    j = j + 1
  }
  return mergeSortedRanges(sortRangesByMin(combined))
}

// The complement of a canonical set: the gaps between its ranges, plus the
// tail below the first range (when it does not already start at 0.0.0) and
// the tail above the last range (when the last range is bounded).
fn versionSetComplement(a: []Range): []Range {
  let out = []Range(0)
  let cursor = versionZero()
  let i = 0
  while (i < len(a)) {
    if (versionLess(cursor, a[i].min)) {
      out = append(out, Range{ min: cursor, max: a[i].min, hasMax: true })
    }
    if (!a[i].hasMax) {
      return out
    }
    cursor = a[i].max
    i = i + 1
  }
  out = append(out, Range{ min: cursor, max: versionZero(), hasMax: false })
  return out
}

// `a ⊆ b`, via `a \ b == ∅` — reuses intersect+complement rather than a
// third range-containment routine.
fn versionSetSubsetOf(a: []Range, b: []Range): bool {
  return versionSetIsEmpty(versionSetIntersect(a, versionSetComplement(b)))
}
