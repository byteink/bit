// Trailing-comment column alignment (#3673): a run of consecutive output
// lines that each end in a same-line `//` comment is aligned to one shared
// column, gofmt-style, instead of every line getting the bare single space
// `fmtGap` (fmt.bit) writes by default. Split into its own file rather than
// folded into fmt.bit or fmtwrap.bit: this is a self-contained post-pass
// over the finished byte buffer, not a change to either file's streaming
// control flow — see fmt.bit's `fmtGap` for where the raw single space is
// still written and where each candidate is recorded, and `formatSource`
// for the one call site that applies this pass. spec/FMT.md documents the
// run-breaking rule this file implements.

// One trailing same-line `//` comment recorded during the main print pass
// (`fmt.bit`'s `fmtGap`): `pos` is the byte offset in the (still unaligned)
// output buffer of the single space `fmtGap` already wrote just before the
// comment text; `width` is the output column the code ended at, just
// before that space (`p.col` at the time — the printer's own canonical
// rendering, never anything read back out of source text); `line` is the
// 0-based output line the comment sits on (`p.outLine` at the time). All
// three come straight off the Printer's running state as it writes, so
// re-formatting an already-aligned file reproduces the identical values —
// the alignment padding this file adds is whitespace between two tokens,
// never a token itself, so it cannot change any `width` a second pass
// would measure.
class TrailAlign {
  pos: int,
  width: int,
  line: int,
}

// Splits `entries` (already in ascending pos/line order — `fmtGap` records
// them in emission order) into alignment groups and returns, for each
// entry, the column its comment should start at: one space past the
// widest `width` among that entry's group.
//
// A group is a maximal run of entries whose output lines are consecutive —
// `entries[k].line == entries[k-1].line + 1` — so a blank line, a code line
// with no trailing comment, or an own-line comment between two candidates
// all break the run the same way: each leaves a gap bigger than 1 between
// consecutive recorded `line` values, since none of them appends a
// TrailAlign entry of its own.
//
// A group ALSO breaks before any entry that would push the shared column
// past `fmtMaxWidth` (fmt.bit): the alignment budget is the same one every
// other wrap decision in this formatter already respects, so one
// genuinely wide outlier starts a fresh group of its own — at its own
// natural one-space column — instead of dragging every neighboring
// comment out past the line-width limit just to keep one shared column.
// A singleton group (including an isolated outlier) is left at exactly
// one space: there is nothing to align it WITH.
fn fmtComputeAlignCols(entries: []TrailAlign): []int {
  let cols = []int(0)
  let n = len(entries)
  let i = 0
  while (i < n) {
    let groupEnd = i + 1
    let groupMax = entries[i].width
    while (groupEnd < n && entries[groupEnd].line == entries[groupEnd - 1].line + 1) {
      let candidateMax = groupMax
      if (entries[groupEnd].width > candidateMax) {
        candidateMax = entries[groupEnd].width
      }
      if (candidateMax + 1 > fmtMaxWidth) {
        break
      }
      groupMax = candidateMax
      groupEnd = groupEnd + 1
    }
    let size = groupEnd - i
    let k = i
    while (k < groupEnd) {
      if (size == 1) {
        cols = append(cols, entries[k].width + 1)
      } else {
        cols = append(cols, groupMax + 1)
      }
      k = k + 1
    }
    i = groupEnd
  }
  return cols
}

// Rewrites `out`, replacing each recorded entry's single space byte (at
// `entries[i].pos`) with enough spaces to land its comment at
// `fmtComputeAlignCols(entries)[i]` — always at least one, since that
// column is never less than `entries[i].width + 1` by construction. Every
// other byte is copied unchanged: nothing before the first entry's `pos`
// moves, and no entry's own code text is touched, only the one space
// between it and its comment.
fn fmtApplyAlignment(out: []byte, entries: []TrailAlign): []byte {
  if (len(entries) == 0) {
    return out
  }
  let cols = fmtComputeAlignCols(entries)
  let result = []byte(0)
  let srcPos = 0
  let i = 0
  while (i < len(entries)) {
    let e = entries[i]
    let k = srcPos
    while (k < e.pos) {
      result = append(result, out[k])
      k = k + 1
    }
    let pad = cols[i] - e.width
    if (pad < 1) {
      pad = 1
    }
    let s = 0
    while (s < pad) {
      result = append(result, ' ')
      s = s + 1
    }
    srcPos = e.pos + 1
    i = i + 1
  }
  let k = srcPos
  while (k < len(out)) {
    result = append(result, out[k])
    k = k + 1
  }
  return result
}
