// Self-host: type ASSIGNABILITY (§14.2) and its structural helpers, split out
// of validate.bit (#5639) to keep it under the 800-line E0200 ceiling with
// zero headroom — see validate.bit's own header for the layer this belongs
// to and THE SAFETY RULE every predicate here follows: undecided answers
// yes, never invents an error. Sibling .bit file, same module: nothing here
// needs an import.
//
// vMentionsInvalid and vSameModuloTypeParams are vAssignable's own escapes
// (an inference gap, and a type differing only where a type parameter sits,
// #2041) and travel with it rather than into the numeric-predicate sibling.
// vAssignableNode is the node-aware entry point that adds range-checking a
// literal against a sized target (vUntypedIntFits, validatenumeric.bit) and
// falls back to a variant construction's own instantiation rule
// (vVariantConstructionName/vVariantPayloadsFit/vVariantFitsInstantiation),
// which is why those three land here too rather than as their own file:
// vAssignableNode is their only caller. vStorableInInterface is §14.3's
// interface-storage half vAssignable and vMismatch both call.

// Does `ty` mention `invalid` anywhere inside it?
//
// A composite whose COMPONENT failed to infer is just as undecidable as a bare
// `invalid`, and the top-level id alone does not show it: an arrow function
// whose parameter type did not resolve interns as a perfectly real func type
// `(<error>) => <error>`, whose id is non-zero and compares unequal to every
// concrete `(i64) => []u8`. Reporting that is a false positive on code the seed
// accepts — the gap is bit2's inference, not the program. Same contract as a
// bare invalid, one level down.
//
// Named types (class/enum/interface) are NOT descended into: they are nominal,
// so a class with an un-inferred field is still exactly that class, and two
// mentions of it are still the same type. Descending would make every named type
// containing one bad field permanently unverifiable.
fn vMentionsInvalid(c: Checker, ty: int, depth: int): bool {
  if (ty == 0) {
    return true
  }
  // Bounded like typeNameDepth: a recursive generic can cycle through its own
  // instantiation, and this must terminate (Power of 10). Undecided at the
  // bottom means "no" — the outer levels already answered for anything real.
  if (depth >= 32) {
    return false
  }
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.Invalid) {
    return true
  }
  if (k == TypeKind.Slice || k == TypeKind.Array || k == TypeKind.Chan) {
    return vMentionsInvalid(c, t.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vMentionsInvalid(c, t.mapKey, depth + 1) || vMentionsInvalid(c, t.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return vMentionsInvalid(c, t.result, depth + 1) || vMentionsInvalid(c, t.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    for m of t.members {
      if (vMentionsInvalid(c, m, depth + 1)) {
        return true
      }
    }
    if (k == TypeKind.Func) {
      return vMentionsInvalid(c, t.result, depth + 1)
    }
    return false
  }
  return false
}

// Whether two types differ ONLY where a type parameter sits (#2041) — the
// structural form of `vAssignable`'s bare-TypeParam escape, and a strict
// superset of it: a bare parameter on either side still short-circuits at the
// top, so nothing the old test accepted is refused here.
//
// This can only ever turn a rejection into an acceptance, which is what makes it
// safe: the ids of two same-spelled type params cannot be compared at all (see
// vAssignable), so a composite over one carries exactly as little information as
// the parameter itself. Kind and arity must still agree, so `[]T` against
// `map<T,int>`, or `[]T` against `i64`, remains a real mismatch — this is not a
// blanket "anything mentioning a T".
//
// Bounded like vMentionsInvalid: a recursive generic can cycle through its own
// instantiation and this must terminate (Power of 10). Undecided at the bottom
// answers YES, matching the permissive direction of every rule it serves.
fn vSameModuloTypeParams(c: Checker, a: int, b: int, depth: int): bool {
  if (depth >= 32) {
    return true
  }
  if (a == 0 || b == 0 || a == b) {
    return true
  }
  let ta = c.ctx.types[a]
  let tb = c.ctx.types[b]
  if (ta.kind == TypeKind.TypeParam || tb.kind == TypeKind.TypeParam) {
    return true
  }
  if (ta.kind != tb.kind) {
    return false
  }
  let k = ta.kind
  if (k == TypeKind.Slice || k == TypeKind.Chan) {
    return vSameModuloTypeParams(c, ta.elem, tb.elem, depth + 1)
  }
  if (k == TypeKind.Array) {
    return ta.arrayLen == tb.arrayLen && vSameModuloTypeParams(c, ta.elem, tb.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vSameModuloTypeParams(c, ta.mapKey, tb.mapKey, depth + 1) &&
      vSameModuloTypeParams(c, ta.mapVal, tb.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) { // ok widens via vFuncResultCompatible (#5264); errTy stays exact
    return vFuncResultCompatible(c, ta.result, tb.result, depth + 1) &&
      vSameModuloTypeParams(c, ta.errTy, tb.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    if (len(ta.members) != len(tb.members)) {
      return false
    }
    let i = 0
    while (i < len(ta.members)) {
      if (!vSameModuloTypeParams(c, ta.members[i], tb.members[i], depth + 1)) {
        return false
      }
      i = i + 1
    }
    if (k == TypeKind.Func) {
      return vFuncResultCompatible(c, ta.result, tb.result, depth + 1)
    }
    return true
  }
  // Named types (class/enum/interface) are NOT descended into: they are
  // nominal, and `sameNominalDecl` above already answers for them.
  return false
}

// Structural assignability with no source-literal awareness: identity, `nil`
// into a nilable type, or an untyped constant whose DEFAULT type matches `dst`
// exactly.
fn vAssignable(c: Checker, src: int, dst: int): bool {
  // `invalid` suppresses cascades — and is the id an un-inferred node still
  // holds, so this is also what keeps an inference gap from becoming a false
  // error.
  if (src == 0 || dst == 0) {
    return true
  }
  if (src == dst) {
    return true
  }
  // #1540: two instantiations of one generic declaration — and a template
  // against its own instantiations — were literally the same TypeId before
  // per-instantiation nominal identity. Accepting them preserves exactly the
  // programs this validator accepted; narrowing it to compare type ARGUMENTS is
  // a new diagnostic, and belongs with the generic-inference tail rather than
  // inside a renumbering, where it would be indistinguishable from a regression.
  if (sameNominalDecl(c.ctx, src, dst)) {
    return true
  }
  // An `invalid` buried inside a composite is the same undecidable as a bare
  // one — see vMentionsInvalid. Checked after the identity test so two mentions
  // of the same broken type still compare equal rather than recursing.
  if (vMentionsInvalid(c, src, 0) || vMentionsInvalid(c, dst, 0)) {
    return true
  }
  // `nil` is answered before the interface branch: an interface is a reference
  // type, so `nil` is its zero value, but `nil` has no method set and would fail
  // a satisfaction test against any non-empty interface.
  if (src == c.ctx.untypedNilId) {
    return vIsNilable(c, dst)
  }
  // An interface target: the value must be storable behind an interface (a
  // class, another interface, or nil — §14.3) AND satisfy its method set.
  // `nil` and `invalid` were
  // already answered above, so this only decides real value types.
  if (c.ctx.types[dst].kind == TypeKind.Interface) {
    return vStorableInInterface(c, src) && vSatisfies(c, src, dst)
  }
  // A type parameter on either side is accepted unchecked, and the same answer
  // must hold wherever one is REACHED, not only where one is the whole type
  // (#2041). Two decls that each declare `<T>` get two distinct TypeParam ids,
  // and `userTypes` keys them by BARE NAME, so the last `<T>` in the module wins
  // and an earlier decl's `T` resolves to the wrong id — `expected 'T', found
  // 'T'` on _tests_/cases/run_generic_nested.bit, where `Opt<T>` and `Box<T>`
  // coexist. Real fix is per-decl type-param scoping; until then the ids cannot
  // be compared and the only sound answer is yes.
  //
  // Written as a bare-kind test, this rule fired for `v: T` and not for
  // `items: []T`, which is why `class Stack<T> { items: []T }` had no writable
  // constructor: the class's field is `[]T_struct` and the constructor's
  // literal is `[]T_func`, two Slice ids, neither of them a TypeParam, so
  // identity failed and E0041 printed the SAME SPELLING on both sides.
  if (vSameModuloTypeParams(c, src, dst, 0)) {
    return true
  }
  if (isUntyped(c, src)) {
    if (defaultType(c, src) == dst) {
      return true
    }
    // A float constant is representable in either float width. An int/rune
    // constant is range-checked by `vAssignableNode` when the source literal is
    // in hand; here, with no node, only exact-width float widening is safe.
    if (src == c.ctx.untypedFloatId && c.ctx.types[dst].kind == TypeKind.Prim) {
      return vPrimIsFloat(c.ctx.types[dst].prim)
    }
    return false
  }
  return false
}

// The variant name of a construction `Enum.Variant(...)` / `Enum<T>.Variant(...)`,
// or "" for any other expression. The receiver has to resolve to an ENUM
// (`enumReceiverType`), which is what separates this from a method call on a
// class value written with the identical syntax.
fn vVariantConstructionName(c: Checker, node: int): string {
  if (getNode(c.tree, node).tag != Tag.Call) {
    return ""
  }
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return ""
  }
  let mk = kidsOf(c.tree, callee)
  if (enumReceiverType(c, mk[0]) == 0) {
    return ""
  }
  let vn = getNode(c.tree, mk[1])
  return c.source[vn.span.start:vn.span.end]
}

// Each construction argument against the payload type the EXPECTED instantiation
// declares for that slot. `vAssignableNode` and not `vAssignable`: the argument
// node is what makes an untyped constant range-checkable (§15.4), and it is the
// whole reason this walks the arguments instead of comparing minted type
// arguments.
fn vVariantPayloadsFit(c: Checker, args: []int, want: []int): bool {
  let i = 0
  while (i < len(want)) {
    let a = args[i]
    if (getNode(c.tree, a).tag == Tag.Arg) {
      a = kidsOf(c.tree, a)[0]
    }
    if (!vAssignableNode(c, a, checkExprType(c, a), want[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// `Hold.Only(7)` against a declared `Hold<f64>`: legal (§15.4 — an untyped
// constant takes its type from the context), and NOT answered by `vAssignable`.
//
// The checker mints the enum's own type arguments from the CALL's arguments
// (`variantConstructionTypeArgs`, checkaccess.bit), defaulting an untyped 7 to
// i64, so the source type reaching assignability is `Hold<i64>` whatever the
// context says. Since #4562 `sameNominalDecl` compares type arguments, so that
// is a mismatch — correctly for `Hold.Only(n)` with `n: i64`, wrongly for the
// constant, and the two are indistinguishable by the time only the two TypeIds
// are in hand.
//
// So the construction is re-checked against the expectation where the argument
// EXPRESSIONS are still reachable: the same push-down `vExpectExpr` already
// performs for a slice literal's elements and a tuple literal's members, at the
// one other construct whose type is minted from its own operands. `Hold.Only(7)`
// fits `Hold<f64>` because untyped 7 fits f64; `Hold.Only(n)` does not, because
// i64 does not.
fn vVariantFitsInstantiation(c: Checker, node: int, src: int, dst: int): bool {
  if (c.ctx.types[dst].kind != TypeKind.Enum || !sameNominalBase(c.ctx, src, dst)) {
    return false
  }
  let vname = vVariantConstructionName(c, node)
  if (vname == "") {
    return false
  }
  let want = variantPayloadTypes(c, dst, vname)
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  if (len(want) == 0 || len(want) != len(args)) {
    return false
  }
  return vVariantPayloadsFit(c, args, want)
}

fn vAssignableNode(c: Checker, node: int, src: int, dst: int): bool {
  if (src == 0 || dst == 0) {
    return true
  }
  if (src == c.ctx.untypedFloatId && vIsDecimalType(c, dst)) {
    return vDecimalLiteralFits(c, node)
  }
  let constant = vUntypedIntFits(c, node, src, dst)
  if (constant >= 0) {
    return constant == 1
  }
  if (vAssignable(c, src, dst)) {
    return true
  }
  return vVariantFitsInstantiation(c, node, src, dst)
}

// Only a class, a BOXED enum (or an interface value, or nil) can be the
// concrete type behind an interface — an interface value IS the receiver's
// object pointer (§14.3, buildEnumObj); a bare-tag enum is a raw i64. Owner
// ruling #5216 widens this no further than the representation allows.
// storableInInterface.
fn vStorableInInterface(c: Checker, src: int): bool {
  if (src == 0 || src == c.ctx.untypedNilId) {
    return true
  }
  let k = c.ctx.types[src].kind
  if (k == TypeKind.Enum) {
    return c.ctx.types[src].enumBoxed
  }
  return k == TypeKind.Struct || k == TypeKind.Interface || k == TypeKind.Invalid
}
