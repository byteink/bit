// Pins LinkArchive's read-once contract (#7256): a format already read is
// answered from the kept members, never from `bytes` again, while each
// consumer keeps its own answer for a damaged member (#7250).
fn checkLinkArchiveReadOnce() {
  let junk = writeArchive(
    [ArMember{ name = "bad.o", data = []byte("not an object") }],
    arFormatGnu(),
  )
  let a = newLinkArchive(junk)
  // The E0096 surface skips the member it cannot read.
  assert(len(lkReadable(a, LkFormat.Macho)) == 0)
  assert(len(a.members) == 1 && arHasPrefix(a.members[0].err, "object bad.o: "))
  // A re-read would now fail `archive: BadMagic`; the kept read names the member.
  a.bytes = []byte("not an archive")
  let defErr = ""
  lkDefines(a, LkFormat.Macho, "_x") catch e {
    defErr = e.message()
    false
  }
  assert(arHasPrefix(defErr, "object bad.o: "))
  let linkErr = ""
  lkAppendMembers([]LoModule(0), a, LkFormat.Macho) catch e {
    linkErr = e.message()
    []LoModule(0)
  }
  assert(arHasPrefix(linkErr, "object bad.o: "))
  // Another format reads the bytes afresh.
  assert(len(lkReadable(a, LkFormat.Coff)) == 0)
  assert(a.format == LkFormat.Coff && a.err != "")
}
