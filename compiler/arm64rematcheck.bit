// In-Bit self-checks for #4666: a rematerializable constant is the allocator's
// cheapest spill victim and owns no stack slot. Sibling of arm64remat.bit,
// same module, reached from `checkArm64RematSpilledConst` (arm64selcheck.bit)
// so no new entry joins `selfcheck()`'s registry.
//
// The allocator half is pinned in compiler/ircheckregalloc.bit
// (`checkRegallocRemat`); this file pins what the BACKEND does with the answer,
// which is where a disagreement between the two becomes emitted bytes.

// vreg 2 rematerialized — spilled with NO slot (index -1), everything else in
// its own register. `rematCtx` (arm64selcheck.bit) is the same shape with a
// real slot 0, and the two together are the whole difference #4666 makes.
fn rematNoSlotCtx(val: int): A64Ctx {
  let cx = selCtx()
  cx.frame = FrameInfo{
    savedGpr = []int(0), savedFpr = []int(0), numSpillSlots = 0,
    outgoingBytes = 16, frameSize = 64,
  }
  setLoc(cx.result, 2, RegLoc{ isSpill = true, index = -1 })
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = val
  return cx
}

// A read of a slotless constant recomputes it, and `plocOf` hands the same
// constant to a parallel move as a VALUE rather than a frame address. Both
// would otherwise call `spillOffset(frame, -1)`, which asserts.
fn checkArm64RematNoSlotRead() {
  let cx = rematNoSlotCtx(5)
  assert(getInt(cx, 2, scratch1()) == scratch1())
  let want = newByteBuf()
  movImm64(want, scratch1(), 5)
  assertSameBytes(cx.code, want)

  let p = plocOf(cx, 2, RegClass.Int)
  assert(p.isImm && p.v == 5 && !p.isReg)
  // An immediate is a value, not a place: equal to nothing, itself included.
  assert(!plocEq(p, p))
  assert(!plocEq(p, plocMem(5, RegClass.Int)) && !plocEq(p, plocReg(5, RegClass.Int)))
  // ...so a batch holding one is never already in place.
  assert(!pmovesAllIdentity([PMove{ src = p, dst = plocReg(3, RegClass.Int) }]))
}

// The scheduling rule, and it is the reason `selectMoves` exists: an
// immediate-sourced move WRITES its destination, so every move that reads that
// destination must run first. Emitted last is what makes that true.
fn checkArm64RematMoveOrder() {
  let imm = plocImm(5, RegClass.Int)
  let ms = [
    PMove{ src = imm, dst = plocReg(1, RegClass.Int) },
    PMove{ src = plocReg(1, RegClass.Int), dst = plocReg(2, RegClass.Int) },
    PMove{ src = plocReg(3, RegClass.Int), dst = plocReg(3, RegClass.Int) },
  ]
  assert(len(selectMoves(ms, true)) == 1, "one immediate-sourced move")
  assert(len(selectMoves(ms, false)) == 1, "the identity move is dropped, the transfer is not")

  // `mov x2, x1` reads x1 and must precede the write of x1. Emitting the
  // immediate first would hand x2 the constant instead of x1's incoming value.
  let cx = selCtx()
  sequentializeAndEmit(cx, ms)
  let want = newByteBuf()
  movRR(want, 2, 1)
  movImm64(want, 1, 5)
  assertSameBytes(cx.code, want)
}

// An overflow argument sourced from a slotless constant stages through the
// same scratch a spilled one would, with no load in front of it.
fn checkArm64RematOutgoingArg() {
  let cx = selCtx()
  emitOutgoingStackArg(cx, plocImm(7, RegClass.Int), RegClass.Int, 24)
  let want = newByteBuf()
  movImm64(want, scratch1(), 7)
  storeImm(want, scratch1(), regSp(), 24, 8)
  assertSameBytes(cx.code, want)
}

// The two producers of the mark, against the one predicate they must share.
fn checkArm64RematMarking() {
  let f = irFuncOf(
    "t",
    []int(0),
    0,
    []IrBlock(0),
    [mkInstr(Op.BlockParam, 0), mkInstr(Op.ConstInt, 0), mkInstr(Op.ConstInt, 0)],
  )
  f.instrs[1].ival = 5
  f.instrs[2].ival = 0x1234567890abcdef
  assert(!isRematConst(f, 0, RematIsa.Arm64), "a block param defines no constant")
  assert(isRematConst(f, 1, RematIsa.Arm64), "one MOVZ word qualifies")
  assert(!isRematConst(f, 2, RematIsa.Arm64), "four words is over the bar")

  let ivs = [
    mkIv(0, RegClass.Int, 0, 2, false),
    mkIv(1, RegClass.Int, 1, 2, false),
    mkIv(2, RegClass.Int, 2, 2, false),
  ]
  markRematIntervals(f, ivs, RematIsa.Arm64)
  assert(!ivs[0].remat && ivs[1].remat && !ivs[2].remat)

  // A reference is refused even if its definition looked constant, because a
  // stack map cannot name a slot that was never written.
  let refIvs = [mkIv(0, RegClass.Int, 0, 1, false), mkIv(1, RegClass.Int, 1, 2, true)]
  markRematIntervals(f, refIvs, RematIsa.Arm64)
  assert(refIvs[1].remat == false, "a live reference never rematerializes")

  // And the emission side reads the allocator's answer, not the predicate:
  // only a location the allocator refused a slot is skipped.
  let skip = [false, false, false]
  addRematSkips(
    skip,
    RegAllocResult{
      locations = [
        RegLoc{ isSpill = false, index = 0 },
        RegLoc{ isSpill = true, index = -1 },
        RegLoc{ isSpill = true, index = 0 },
      ],
      numSpillSlots = 0, stackMaps = []StackMapEntry(0),
    },
  )
  assert(!skip[0] && skip[1] && !skip[2])
}

// #7565: the [p,p] filler of an instruction that writes no register is marked
// folded, so it takes no register; a value-writing instruction is not, and
// neither is a float or reference filler, which the no-slot location cannot hold.
fn checkFillerMarking() {
  let ctx = newTypeContext()
  let w = ctx.primIds[3]
  let v = ctx.voidId
  let ops = [
    Op.BlockParam,
    Op.Add,
    Op.FieldSet,
    Op.Jump,
    Op.Ret,
    Op.Call,
    Op.Call,
    Op.ConstInt,
    Op.Jump,
    Op.Br,
  ]
  let tys = [w, w, v, v, v, v, w, w, v, v]
  let instrs = []IrInstr(0)
  let ivs = []LiveInterval(0)
  let i = 0
  while (i < len(ops)) {
    instrs = append(instrs, mkInstr(ops[i], tys[i]))
    ivs = append(ivs, mkIv(i, RegClass.Int, i, i, false))
    i = i + 1
  }
  ivs[8].regClass = RegClass.Float
  ivs[9].isRef = true
  let f = irFuncOf("t", []int(0), v, []IrBlock(0), instrs)
  let skip = []bool(len(ops))
  skip[7] = true
  markFoldedIntervals(ctx, f, ivs, skip)
  let want = [false, false, true, true, true, true, false, true, false, false]
  i = 0
  while (i < len(ops)) {
    assert(ivs[i].folded == want[i], "#7565: filler marking")
    i = i + 1
  }
}

fn checkArm64Remat() {
  checkArm64RematNoSlotRead()
  checkArm64RematMoveOrder()
  checkArm64RematOutgoingArg()
  checkArm64RematMarking()
  checkArm64ArgFwd()
  checkArm64SpillFwd()
  checkArm64SpillFwdMove()
  checkArm64SpillFwdArg()
  checkFillerMarking()
}

// #7190: `rematCtx`'s spilled vreg 2 (slot 0) as a param the entry binding
// stored from x4. Read before anything is emitted past the binding it is x4 —
// not when the binding also writes x4, a branch reaches block 0, a later block
// has started, the instruction is a call or the read's own home is x4; the
// call's argument marshalling still takes x4. The refusals emit nothing, so
// the last read is the one reload.
fn checkArm64ArgFwd() {
  let cx = rematCtx()
  let slot = plocMem(spillOffset(cx.frame, 0), RegClass.Int)
  let store = PMove{ src = plocReg(4, RegClass.Int), dst = slot }
  bindArgFwd(cx, [store, PMove{ src = plocReg(5, RegClass.Int), dst = plocReg(4, RegClass.Int) }])
  assert(argFwd(cx, 0, RegClass.Int) < 0)
  cx.f.instrs[1] = mkInstr(Op.Jump, 0) // block 1 jumps to block 0
  bindArgFwd(cx, [store])
  assert(argFwd(cx, 0, RegClass.Int) < 0)
  cx.f.instrs[1] = mkInstr(Op.BlockParam, 0)
  bindArgFwd(cx, [store])
  noteCurInst(cx, 0, 0) // home x0
  assert(getInt(cx, 2, scratch1()) == 4 && codeLen(cx) == cx.argFwdAt)
  cx.f.instrs[0] = mkInstr(Op.Call, 0)
  assert(argFwd(cx, 0, RegClass.Int) < 0, "a call's operand selector may write x0..x7 first")
  assert(argFwdSrc(cx, slot).isReg && argFwdSrc(cx, slot).v == 4)
  cx.f.instrs[0] = mkInstr(Op.BlockParam, 0)
  noteCurInst(cx, 0, 4) // home x4
  assert(argFwd(cx, 0, RegClass.Int) < 0)
  noteCurInst(cx, 1, 0)
  assert(argFwd(cx, 0, RegClass.Int) < 0 && !argFwdSrc(cx, slot).isReg)
  cx.argFwdAt = codeLen(cx)
  assert(getInt(cx, 2, scratch1()) == 4)
  noteCurInst(cx, 0, 0)
  loadImm(cx.code, scratch2(), regSp(), 0, 8, false)
  assert(getInt(cx, 2, scratch1()) == scratch1(), "a byte past the binding ends the window")
}

// #7705: `rematCtx`'s vreg 2 (slot 0) read straight after putInt/putFloat
// stored it is a move from the stored register, and nothing at all when the
// read's scratch is that register. A byte, a local label or a block label past
// the store, or a read of the other class, keeps the `ldr`.
fn checkArm64SpillFwd() {
  let cx = rematCtx()
  let off = spillOffset(cx.frame, 0)
  putInt(cx, 2, 4)
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(0, 4, false), "a reload after its store is a mov")
  putInt(cx, 2, scratch1())
  let at = codeLen(cx)
  assert(getInt(cx, 2, scratch1()) == scratch1() && codeLen(cx) == at)
  putInt(cx, 2, 4)
  movRR(cx.code, 5, 6)
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(off, -1, false), "a byte between keeps the ldr")
  let fx = emitLocalCbz(cx, false, 5)
  putInt(cx, 2, 4)
  patchLocalCondBranch(cx, fx)
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(off, -1, false), "a local label keeps the ldr")
  cx.blockOffsets = [0, 0]
  putInt(cx, 2, 4)
  cx.blockOffsets[1] = codeLen(cx)
  noteCurInst(cx, 1, 0)
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(off, -1, false), "a block label keeps the ldr")
  putInt(cx, 2, 4)
  noteCurInst(cx, 1, 1)
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(0, 4, false), "mid-block, no label")
  putFloat(cx, 2, 3)
  assert(getFloat(cx, 2, fscratch1()) == fscratch1())
  assert(lastWord(cx) == oneWord(0, 3, true), "a float reload after its store is an fmov")
  putInt(cx, 2, 4)
  assert(getFloat(cx, 2, fscratch1()) == fscratch1())
  assert(lastWord(cx) == oneWord(off, -1, true), "the other class keeps the ldr")
}

// #7739: `rematCtx`'s vreg 2 (slot 0) read straight after a parallel move
// stored it is a move from the stored register: x4, scratch2 when the store
// closes a cycle, d3 for a float. A move emitted after the store keeps the `ldr`.
fn checkArm64SpillFwdMove() {
  let cx = rematCtx()
  let off = spillOffset(cx.frame, 0)
  let slot = plocMem(off, RegClass.Int)
  let x4 = plocReg(4, RegClass.Int)
  sequentializeAndEmit(cx, [PMove{ src = x4, dst = slot }])
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(0, 4, false), "a reload after emitMove's store is a mov")
  sequentializeAndEmit(
    cx,
    [
      PMove{ src = x4, dst = slot },
      PMove{ src = plocReg(5, RegClass.Int), dst = plocReg(6, RegClass.Int) },
    ],
  )
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(off, -1, false), "a move after the store keeps the ldr")
  sequentializeAndEmit(cx, [PMove{ src = slot, dst = x4 }, PMove{ src = x4, dst = slot }])
  assert(getInt(cx, 2, scratch1()) == scratch1())
  assert(lastWord(cx) == oneWord(0, scratch2(), false), "a cycle's closing store")
  let d3 = plocReg(3, RegClass.Float)
  sequentializeAndEmit(cx, [PMove{ src = d3, dst = plocMem(off, RegClass.Float) }])
  assert(getFloat(cx, 2, fscratch1()) == fscratch1())
  assert(lastWord(cx) == oneWord(0, 3, true), "a float reload after emitMove's store is an fmov")
}

// #7731: a call argument marshalled straight after putInt/putFloat stored it
// is the stored register as a parallel-move source, ordered before the move
// that overwrites it, scratch1 included, and nothing at all when it is the
// argument register. Stored from scratch1 with a ninth argument staged
// through scratch1 (vreg 11, a slotless constant), the `ldr` stays.
fn checkArm64SpillFwdArg() {
  let cx = spillArgCtx()
  let off = spillOffset(cx.frame, 0)
  putInt(cx, 2, 0)
  marshalArgs(cx, [3, 2], 0, 0)
  let want = newByteBuf()
  storeImm(want, 0, regSp(), off, 8)
  movRR(want, 1, 0)
  movRR(want, 0, 3)
  putInt(cx, 2, scratch1())
  marshalArgs(cx, [2], 0, 0)
  storeImm(want, scratch1(), regSp(), off, 8)
  movRR(want, 0, scratch1())
  putInt(cx, 2, 0)
  marshalArgs(cx, [2], 0, 0)
  storeImm(want, 0, regSp(), off, 8)
  assertSameBytes(cx.code, want)
  cx = spillArgCtx()
  setLoc(cx.result, 11, RegLoc{ isSpill = true, index = -1 })
  cx.f.instrs[11] = mkInstr(Op.ConstInt, primType(cx.module.ctx, 3))
  cx.f.instrs[11].ival = 7
  putInt(cx, 2, scratch1())
  marshalArgs(cx, [0, 1, 2, 3, 4, 5, 6, 7, 11], 0, 0)
  want = newByteBuf()
  storeImm(want, scratch1(), regSp(), off, 8)
  movImm64(want, scratch1(), 7)
  storeImm(want, scratch1(), regSp(), outgoingArgOffset(0), 8)
  loadImm(want, 2, regSp(), off, 8, false)
  assertSameBytes(cx.code, want)
  cx = spillArgCtx()
  cx.f.instrs[2] = mkInstr(Op.BlockParam, primType(cx.module.ctx, 9))
  putFloat(cx, 2, 3)
  marshalArgs(cx, [2], 0, 0)
  want = newByteBuf()
  storeImmF(want, 3, regSp(), off, 8)
  fmovFF(want, 0, 3, 8)
  assertSameBytes(cx.code, want)
}

// `rematCtx` with every value an i64, as marshalArgs reads each one's class.
fn spillArgCtx(): A64Ctx {
  let cx = rematCtx()
  let i = 0
  while (i < len(cx.f.instrs)) {
    cx.f.instrs[i] = mkInstr(Op.BlockParam, primType(cx.module.ctx, 3))
    i = i + 1
  }
  return cx
}

fn lastWord(cx: A64Ctx): int {
  return readWordAt(cx.code, codeLen(cx) - 4)
}

// The reload into scratch1 (fscratch1 when `isFloat`): a move from register
// `src`, or the `ldr` of frame offset `off` when `src` is -1.
fn oneWord(off: int, src: int, isFloat: bool): int {
  let b = newByteBuf()
  if (isFloat && src >= 0) {
    fmovFF(b, fscratch1(), src, 8)
  } else if (isFloat) {
    loadImmF(b, fscratch1(), regSp(), off, 8)
  } else if (src >= 0) {
    movRR(b, scratch1(), src)
  } else {
    loadImm(b, scratch1(), regSp(), off, 8, false)
  }
  assert(len(b.bytes) == 4)
  return readWordAt(b, 0)
}
