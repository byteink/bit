// Self-host Stage 3 (#1344): real Mach-O64 arm64 relocatable object reader,
// a direct port. Parses the MH_OBJECT that
// `./make libbitrt` emits for aarch64-macos (plus this compiler's own object
// for the Bit program) and normalizes it into linkobj.bit's generic Module/Atom
// IR via atomizeModule.
//
// Scope is empirical: every section type and relocation type this file switches
// on was confirmed present in a real aarch64-macos libbitrt_zcu.o (via
// otool -l / otool -r) before being handled; anything else fails loudly rather
// than mis-linking.
//
// Mach-O differs from ELF in three ways this reader must bridge:
//  - No per-symbol size (nlist_64 carries none) — atomizeModule infers an atom's
//    extent from the next symbol's offset, which is why RawSymbol.size stays 0.
//  - Relocations are REL-style: UNSIGNED carries its addend in the field bytes,
//    and the AArch64 page/branch kinds carry it in a PRECEDING
//    ARM64_RELOC_ADDEND prefix relocation (folded here into the next reloc's
//    addend, so the generic model sees one explicit addend per reloc).
//  - PAGEOFF12 is one Mach-O type for both ADD and every LDR/STR width; ELF
//    splits them. This reader decodes the instruction word to pick the right
//    generic kind (the scale matters).

// ---- little-endian primitive reads ---------------------------------------
//
// Every read is unaligned-safe by construction: ar members are only 2-byte
// aligned, so nothing may assume a wider alignment.

fn loRdU16(b: []u8, off: int): int {
  return int(b[off]) | (int(b[off + 1]) << 8)
}

fn loRdU32(b: []u8, off: int): int {
  return int(b[off]) | (int(b[off + 1]) << 8) | (int(b[off + 2]) << 16) | (int(b[off + 3]) << 24)
}

// Sign-extended 32-bit read: r_address and a length-2 implicit addend are both
// signed.
fn loRdI32(b: []u8, off: int): int {
  let v = loRdU32(b, off)
  if (v >= 0x80000000) {
    return v - 0x100000000
  }
  return v
}

fn loRdU64(b: []u8, off: int): int {
  return loRdU32(b, off) | (loRdU32(b, off + 4) << 32)
}

// Structure sizes, from the SDK's field layouts.
fn mrSizeofHeader(): int { return 32 }
fn mrSizeofSegment(): int { return 72 }
fn mrSizeofSection(): int { return 80 }
fn mrSizeofSymtab(): int { return 24 }
fn mrSizeofNlist(): int { return 16 }
fn mrSizeofRelocInfo(): int { return 8 }

// A parsed section header plus the bookkeeping needed to map file section
// ordinals back to RawSection indices. `rawIndex` is -1 for a dropped section.
class MrSectionMeta {
  addr: int,
  size: int,
  offset: int,
  alignLog2: int,
  reloff: int,
  nreloc: int,
  rawIndex: int,
  kind: LoSectionKind,
}

// What a relocation's symbol resolves to. Bit has no tagged union.
enum MrSymKind {
  // An import / cross-module global.
  Undef,
  // A defined symbol: an index into the raw symbols.
  Raw,
  // A stab/absolute symbol, or one defined in a dropped section.
  Ignored,
}

class MrSymTarget {
  kind: MrSymKind,
  name: string,
  raw: int,
}

// The NUL-terminated name in a 16-byte fixed field.
fn mrName16(b: []u8, off: int): string {
  let out = []u8(0)
  let i = 0
  while (i < 16 && b[off + i] != u8(0)) {
    out = append(out, b[off + i])
    i = i + 1
  }
  return string(out)
}

fn mrCstr(strtab: []u8, offset: int): string! {
  if (offset >= len(strtab)) {
    fail newError("Malformed")
  }
  let end = offset
  while (end < len(strtab) && strtab[end] != u8(0)) {
    end = end + 1
  }
  if (end >= len(strtab)) {
    fail newError("Malformed")
  }
  return string(strtab[offset:end])
}

// Classifies a section by segment + SECTION_TYPE. Drops unwind/debug/LD helper
// sections — nothing running needs them in v1 (no exceptions). `has` is false
// for a dropped section.
class MrClass {
  has: bool,
  kind: LoSectionKind,
}

// __TEXT-segment section classification, extracted out of mrClassify to keep
// its own branch count under the complexity ceiling.
fn mrClassifyText(sect: string): MrClass {
  if (sect == "__unwind_info" ||
    sect == "__eh_frame" ||
    sect == "__gcc_except_tab" ||
    sect == "__compact_unwind") {
    return MrClass{ has: false, kind: LoSectionKind.Text }
  }
  if (sect == "__text") {
    return MrClass{ has: true, kind: LoSectionKind.Text }
  }
  // __const, __cstring, __literal4/8/16
  return MrClass{ has: true, kind: LoSectionKind.Rodata }
}

// __DATA/__DATA_CONST-segment section classification, extracted out of
// mrClassify for the same reason as mrClassifyText above — a second
// name-discriminated kind (DbgMeta) joining GcMeta is what pushed this past
// the ceiling.
fn mrClassifyData(sect: string): MrClass {
  if (sect == "__compact_unwind") {
    return MrClass{ has: false, kind: LoSectionKind.Data }
  }
  // ABI.md §4: must be tested BEFORE the blanket Data below, which would
  // otherwise scatter the GC stack-map entries among unrelated __DATA atoms
  // and break the merged table's contiguity silently.
  if (sect == "__bit_gc") {
    return MrClass{ has: true, kind: LoSectionKind.GcMeta }
  }
  // ABI.md §4.2: same reasoning as __bit_gc above, for the debug-info line
  // table's own atoms.
  if (sect == "__bit_dbg") {
    return MrClass{ has: true, kind: LoSectionKind.DbgMeta }
  }
  return MrClass{ has: true, kind: LoSectionKind.Data }
}

fn mrClassify(seg: string, sect: string, flags: int): MrClass {
  let sectionType = flags & 0xff
  if (sectionType == 0x12) { // S_THREAD_LOCAL_ZEROFILL
    return MrClass{ has: true, kind: LoSectionKind.TlsBss }
  }
  if (sectionType == 0x13) { // S_THREAD_LOCAL_VARIABLES (tlv_descriptors)
    return MrClass{ has: true, kind: LoSectionKind.TlsVars }
  }
  if (sectionType == 0x11) { // S_THREAD_LOCAL_REGULAR (thread-local init image)
    return MrClass{ has: true, kind: LoSectionKind.TlsData }
  }
  if (sectionType == 0x1) { // S_ZEROFILL
    return MrClass{ has: true, kind: LoSectionKind.Bss }
  }
  if (seg == "__TEXT") {
    return mrClassifyText(sect)
  }
  if (seg == "__DATA" || seg == "__DATA_CONST") {
    return mrClassifyData(sect)
  }
  return MrClass{ has: false, kind: LoSectionKind.Data } // __LD and anything else
}

// Maps a Mach-O arm64 relocation type to the generic kind, decoding the
// instruction word for PAGEOFF12 — one Mach-O type spanning ADD and every
// LDR/STR width, where the scale lives in the instruction, not the relocation.
fn mrRelocKind(rtype: int, length: int, sectionData: []u8, rAddress: int): LoRelocKind! {
  if (rtype == 0) { // ARM64_RELOC_UNSIGNED
    if (length == 3) {
      return LoRelocKind.Abs64
    }
    if (length == 2) {
      return LoRelocKind.Abs32
    }
    fail newError("UnsupportedRelocation")
  }
  if (rtype == 2) {
    return LoRelocKind.Aarch64Call26
  } // BRANCH26
  if (rtype == 3) {
    return LoRelocKind.Aarch64AdrPrelPgHi21
  } // PAGE21
  if (rtype == 5) {
    return LoRelocKind.Aarch64AdrGotPage
  } // GOT_LOAD_PAGE21
  if (rtype == 6) {
    return LoRelocKind.Aarch64Ld64GotLo12Nc
  } // GOT_LOAD_PAGEOFF12
  if (rtype == 8) {
    return LoRelocKind.Aarch64TlvpAdrPage21
  } // TLVP_LOAD_PAGE21
  if (rtype == 9) {
    return LoRelocKind.Aarch64TlvpLd64Lo12
  }                 // TLVP_LOAD_PAGEOFF12
  if (rtype == 4) { // ARM64_RELOC_PAGEOFF12
    if (rAddress + 4 > len(sectionData)) {
      fail newError("Malformed")
    }
    let insn = loRdU32(sectionData, rAddress)
    // LDR/STR unsigned-immediate form: bits[29:27]=111, bits[25:24]=01.
    if ((insn & 0x3b000000) == 0x39000000) {
      // 128-bit SIMD LDR/STR has size=00 but bit[23] set (opc high).
      if ((insn & 0x04800000) == 0x04800000) {
        return LoRelocKind.Aarch64Ldst128AbsLo12Nc
      }
      let scale = (insn >> 30) & 3
      if (scale == 0) {
        return LoRelocKind.Aarch64Ldst8AbsLo12Nc
      }
      if (scale == 1) {
        return LoRelocKind.Aarch64Ldst16AbsLo12Nc
      }
      if (scale == 2) {
        return LoRelocKind.Aarch64Ldst32AbsLo12Nc
      }
      return LoRelocKind.Aarch64Ldst64AbsLo12Nc
    }
    return LoRelocKind.Aarch64AddAbsLo12Nc // ADD immediate (address materialization)
  }
  fail newError("UnsupportedRelocation")
}

fn mrReadImplicitAddend(sectionData: []u8, rAddress: int, length: int): int {
  if (length == 3) {
    let lo = loRdU32(sectionData, rAddress)
    let hi = loRdI32(sectionData, rAddress + 4)
    return lo | (hi << 32)
  }
  if (length == 2) {
    return loRdI32(sectionData, rAddress)
  }
  return 0
}

// Parses a whole Mach-O64 arm64 MH_OBJECT into the generic object model.
fn readMachoObject(name: string, bytes: []u8): LoModule! {
  if (len(bytes) < mrSizeofHeader()) {
    fail newError("Truncated")
  }
  if (loRdU32(bytes, 0) != 0xfeedfacf) {
    fail newError("NotMachO")
  }
  if (loRdU32(bytes, 4) != 0x0100000C) { // CPU_TYPE_ARM64
    fail newError("UnsupportedMachO")
  }
  if (loRdU32(bytes, 12) != 0x1) { // MH_OBJECT
    fail newError("UnsupportedMachO")
  }
  let ncmds = loRdU32(bytes, 16)

  // ---- pass 1: sections (one 1-based ordinal each) + LC_SYMTAB ------------
  let rawSections = []LoRawSection(0)
  // Indexed by 1-based file section ordinal; entry 0 is unused (NO_SECT).
  let meta = [
    MrSectionMeta{
      addr: 0, size: 0, offset: 0, alignLog2: 0, reloff: 0,
      nreloc: 0, rawIndex: -1, kind: LoSectionKind.Text,
    },
  ]
  let haveSymtab = false
  let symoff = 0
  let nsyms = 0
  let stroff = 0
  let strsize = 0

  let lcOff = mrSizeofHeader()
  let lci = 0
  while (lci < ncmds) {
    if (lcOff + 8 > len(bytes)) {
      fail newError("Truncated")
    }
    let cmd = loRdU32(bytes, lcOff)
    let cmdsize = loRdU32(bytes, lcOff + 4)
    if (cmdsize < 8 || lcOff + cmdsize > len(bytes)) {
      fail newError("Malformed")
    }
    if (cmd == 0x19) { // LC_SEGMENT_64
      let nsects = loRdU32(bytes, lcOff + 64)
      let so = lcOff + mrSizeofSegment()
      let si = 0
      while (si < nsects) {
        if (so + mrSizeofSection() > len(bytes)) {
          fail newError("Truncated")
        }
        let sect = mrName16(bytes, so)
        let seg = mrName16(bytes, so + 16)
        let addr = loRdU64(bytes, so + 32)
        let size = loRdU64(bytes, so + 40)
        let offset = loRdU32(bytes, so + 48)
        let alignLog2 = loRdU32(bytes, so + 52)
        let reloff = loRdU32(bytes, so + 56)
        let nreloc = loRdU32(bytes, so + 60)
        let flags = loRdU32(bytes, so + 64)
        so = so + mrSizeofSection()

        let c = mrClassify(seg, sect, flags)
        if (!c.has) {
          meta = append(
            meta,
            MrSectionMeta{
              addr: addr, size: size, offset: offset,
              alignLog2: alignLog2, reloff: reloff, nreloc: nreloc, rawIndex: -1,
              kind: LoSectionKind.Text,
            },
          )
        } else {
          let data = []u8(0)
          if (!loIsBss(c.kind)) {
            if (offset + size > len(bytes)) {
              fail newError("Truncated")
            }
            data = bytes[offset:offset + size]
          }
          meta = append(
            meta,
            MrSectionMeta{
              addr: addr, size: size, offset: offset,
              alignLog2: alignLog2, reloff: reloff, nreloc: nreloc,
              rawIndex: len(rawSections), kind: c.kind,
            },
          )
          rawSections = append(
            rawSections,
            LoRawSection{
              name: sect, kind: c.kind,
              data: data, size: size,
              // Mach-O stores log2 of the required alignment.
              alignment: 1 << alignLog2,
            },
          )
        }
        si = si + 1
      }
    } else if (cmd == 0x2) { // LC_SYMTAB
      haveSymtab = true
      symoff = loRdU32(bytes, lcOff + 8)
      nsyms = loRdU32(bytes, lcOff + 12)
      stroff = loRdU32(bytes, lcOff + 16)
      strsize = loRdU32(bytes, lcOff + 20)
    }
    lcOff = lcOff + cmdsize
    lci = lci + 1
  }

  if (!haveSymtab) {
    fail newError("Malformed")
  }
  if (stroff + strsize > len(bytes)) {
    fail newError("Truncated")
  }
  let strtab = bytes[stroff:stroff + strsize]

  // ---- pass 2: symbols ---------------------------------------------------
  let symTargets = []MrSymTarget(0)
  let rawSymbols = []LoRawSymbol(0)
  let s = 0
  while (s < nsyms) {
    let n = symoff + s * mrSizeofNlist()
    if (n + mrSizeofNlist() > len(bytes)) {
      fail newError("Truncated")
    }
    let nStrx = loRdU32(bytes, n)
    let nType = int(bytes[n + 4])
    let nSect = int(bytes[n + 5])
    let nValue = loRdU64(bytes, n + 8)

    if ((nType & 0xe0) != 0) { // N_STAB: a debug symbol
      symTargets = append(
        symTargets,
        MrSymTarget{
          kind: MrSymKind.Ignored,
          name: "", raw: 0,
        },
      )
      s = s + 1
      continue
    }
    let symName = mrCstr(strtab, nStrx)?
    let ntype = nType & 0x0e
    if (ntype == 0x0 || nSect == 0) { // N_UNDF
      symTargets = append(
        symTargets,
        MrSymTarget{
          kind: MrSymKind.Undef,
          name: symName, raw: 0,
        },
      )
      s = s + 1
      continue
    }
    if (ntype != 0xe) { // not N_SECT: N_ABS/N_PBUD unsupported
      fail newError("UnsupportedSymbol")
    }
    if (nSect >= len(meta)) {
      fail newError("Malformed")
    }
    let m = meta[nSect]
    if (m.rawIndex < 0) {
      // Defined in a dropped section (e.g. unwind).
      symTargets = append(
        symTargets,
        MrSymTarget{
          kind: MrSymKind.Ignored,
          name: "", raw: 0,
        },
      )
      s = s + 1
      continue
    }
    let alignLog2 = m.alignLog2
    if (alignLog2 > 31) {
      alignLog2 = 31
    }
    let binding = LoBinding.Local
    if ((nType & 0x01) != 0) { // N_EXT
      binding = LoBinding.Global
    }
    symTargets = append(
      symTargets,
      MrSymTarget{
        kind: MrSymKind.Raw, name: symName,
        raw: len(rawSymbols),
      },
    )
    rawSymbols = append(
      rawSymbols,
      LoRawSymbol{
        name: symName, section: m.rawIndex,
        // n_value is the absolute address; the section's addr is its base.
        offset: nValue - m.addr,
        size: 0, // Mach-O carries none; atomize infers from the next symbol
        binding: binding, weak: false, alignment: 1 << alignLog2,
      },
    )
    s = s + 1
  }

  // ---- pass 3: relocations (per owning section) --------------------------
  let rawRelocs = []LoRawReloc(0)
  let mi = 0
  while (mi < len(meta)) {
    let m = meta[mi]
    if (m.rawIndex < 0 || m.nreloc == 0) {
      mi = mi + 1
      continue
    }
    if (m.reloff + m.nreloc * mrSizeofRelocInfo() > len(bytes)) {
      fail newError("Truncated")
    }
    // A pending ARM64_RELOC_ADDEND prefix applies to the NEXT relocation only;
    // -1 sentinel rather than an optional, since a real addend can be negative
    // — hence the separate flag.
    let havePending = false
    let pendingAddend = 0
    let ri = 0
    while (ri < m.nreloc) {
      let r = m.reloff + ri * mrSizeofRelocInfo()
      let rAddress = loRdI32(bytes, r)
      let rInfo = loRdU32(bytes, r + 4)
      let symbolnum = rInfo & 0x00FFFFFF
      let length = (rInfo >> 25) & 0x3
      let isExtern = ((rInfo >> 27) & 1) != 0
      let rtype = (rInfo >> 28) & 0xF

      if (rtype == 10) { // ARM64_RELOC_ADDEND
        // Prefix reloc: r_symbolnum is a signed 24-bit addend for the
        // immediately following page/branch relocation.
        let a = symbolnum
        if (a >= 0x800000) {
          a = a - 0x1000000
        }
        pendingAddend = a
        havePending = true
        ri = ri + 1
        continue
      }
      if (!isExtern) { // only ADDEND is section-based here
        fail newError("UnsupportedRelocation")
      }

      let sectionData = rawSections[m.rawIndex].data
      let kind = mrRelocKind(rtype, length, sectionData, rAddress)?

      // Addend: UNSIGNED reads it from the field; the page/branch kinds take it
      // from a preceding ARM64_RELOC_ADDEND (else 0).
      let addend = 0
      if (havePending) {
        addend = pendingAddend
      }
      havePending = false
      if (rtype == 0) { // ARM64_RELOC_UNSIGNED
        addend = mrReadImplicitAddend(sectionData, rAddress, length)
      }

      if (symbolnum >= len(symTargets)) {
        fail newError("Malformed")
      }
      let st = symTargets[symbolnum]
      if (st.kind == MrSymKind.Ignored) {
        fail newError("Malformed")
      }
      let target = loTargetGlobal(st.name)
      if (st.kind == MrSymKind.Raw) {
        // A defined global still resolves through the whole-link table: another
        // module may override it.
        if (rawSymbols[st.raw].binding != LoBinding.Global) {
          target = loTargetSymbol(st.raw)
        }
      }
      rawRelocs = append(
        rawRelocs,
        LoRawReloc{
          section: m.rawIndex,
          offset: rAddress, kind: kind, target: target, addend: addend,
        },
      )
      ri = ri + 1
    }
    mi = mi + 1
  }

  return atomizeModule(name, rawSections, rawSymbols, rawRelocs)?
}
