// ARM64 branch emission peepholes (#3843), split out of arm64compile.bit and
// arm64select.bit so each has room for the reasoning that makes it safe.
// Sibling .bit file, same module: see arm64.bit for the backend overview.
//
// Nothing here is shared with the x86-64 backend on purpose. That backend
// reorders its blocks into RPO (see codegen.bit's note on debug-line rows),
// so "the next block in emission order" is a different question there and the
// answer this file relies on does not carry over.

// ===========================================================================
// #3843: a compare that feeds a `br` branches on its own flags
// ===========================================================================
//
// Lowering emits every comparison as a value, so `if (a != b)` costs four
// instructions where two do:
//
//     cmp   x0, x1        <- sets NZCV
//     cset  x2, ne        <- materializes the boolean
//     cmp   x2, xzr       <- tests the boolean, discarding the first result
//     b.eq  <else>
//
// The `cset`/`cmp` pair is pure round-tripping: `b.ne`'s own condition is
// already decided by the first `cmp`. Fusing them leaves `cmp x0, x1` +
// `b.eq <else>`, which is what `clang -O2` emits.
//
// Two conditions make the fusion exact, and BOTH are required:
//
//   1. The boolean has exactly one use and that use is the branch's
//      condition. A boolean that is also stored, returned, passed as a call
//      or block argument, or read by a second branch is a real value and
//      still needs its `cset`. Use counts come from `instrOperands`
//      (opt.bit) — the SAME operand map DCE uses, and the one
//      `computeSkipConstMaterialize` already relies on for #1853 — so a use
//      this file forgot to think about is still counted. Note `Op.Br`'s own
//      entry there is `[lhs] ++ thenArgs ++ elseArgs`: a condition that is
//      ALSO passed along one of its own edges counts twice and is refused.
//
//   2. NZCV is still live at the branch. The compare must be the instruction
//      immediately before the `br` IN THE SAME BLOCK, so nothing can be
//      emitted between the two. Adjacency in the instruction array is not
//      enough by itself: a `br` that is the only instruction of its own block
//      is adjacent to the last instruction of the PREVIOUS block, and that
//      block is not the only way in — a different predecessor would reach the
//      branch with arbitrary flags. `computeFuseCmpBranch` walks per block so
//      a cross-block pair can never be formed.
//
// Emission-order adjacency then follows from IR adjacency: the fused
// `emitIcmp`/`emitFcmp` path (arm64select.bit) ends with the flag-setting
// `cmp`/`fcmp` itself, `emitBrCondition` below emits nothing at all on that
// path, and `emitBr` puts the conditional branch first in every one of its
// three shapes. Both operand fetches happen before the compare, and neither
// the destination binding nor the spill store the unfused path ends with is
// emitted at all.

// Marks each icmp/fcmp whose only consumer is the `br` immediately after it
// in the same block. Indexed by instruction id, like `skipConst`.
fn computeFuseCmpBranch(f: IrFunc): []bool {
  let n = len(f.instrs)
  let useCount = []int(n)
  let i = 0
  while (i < n) {
    for u of instrOperands(f, i) {
      useCount[u] = useCount[u] + 1
    }
    i = i + 1
  }
  let fuse = []bool(n)
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount + 1
    while (idx < b.instsStart + b.instsLen) {
      let ins = f.instrs[idx]
      if (ins.op == Op.Br &&
        ins.lhs == idx - 1 &&
        useCount[idx - 1] == 1 &&
        (isIcmp(f.instrs[idx - 1].op) || isFcmp(f.instrs[idx - 1].op))) {
        fuse[idx - 1] = true
      }
      idx = idx + 1
    }
    bi = bi + 1
  }
  return fuse
}

// The condition `br` must branch on to take its ELSE edge, given the compare
// `cmpIdx` that set the flags. The unfused sequence tests the materialized
// boolean against zero and takes the else edge when it is 0, so the fused
// form takes it on the complement of the compare's own condition.
//
// `condInvert` is the flag-level complement (it flips the low bit of the
// condition field, which is how AArch64 pairs EQ/NE, MI/PL, HI/LS, ...), not
// a negation of the source-level predicate. That distinction is what makes
// this correct for floats: `fcmp` sets NZCV so that an unordered (NaN)
// compare answers false for LT via MI, and PL is true on exactly the NZCV
// states MI is false on — NaN included. Negating the PREDICATE instead
// (LT -> GE) would be wrong there, and is not what happens here.
fn fusedElseCond(f: IrFunc, cmpIdx: int): int {
  let op = f.instrs[cmpIdx].op
  if (isIcmp(op)) {
    return condInvert(icmpCond(op))
  }
  assert(isFcmp(op))
  return condInvert(fcmpCond(op))
}

// Emits whatever sets NZCV for `br`, and returns the condition the branch must
// test to take its ELSE edge. `cond` is the boolean operand and `i` the `br`'s
// own instruction id. Emits NOTHING on the fused path — the compare is the
// instruction already emitted immediately before, which is the whole point —
// so the caller's conditional branch is still the next word in the stream
// either way, and no flag-clobbering instruction can slip between them.
//
// The THEN condition is `condInvert` of what this returns, on both paths:
// EQ/NE are a condInvert pair, and `fusedElseCond` is itself a `condInvert`,
// which is an involution. See the NaN reasoning on `fusedElseCond` — it
// applies unchanged in the other direction.
fn emitBrCondition(cx: A64Ctx, i: int, cond: int): int {
  if (cond == i - 1 && cx.fuseCmp[cond]) {
    return fusedElseCond(cx.f, cond)
  }
  cmpZero(cx.code, getInt(cx, vregOf(cx, cond), scratch1()))
  return condEq()
}

// Does instruction `i` bind a physical register of its own?
//
// A fused compare's whole result is NZCV, so it defines no register and must
// not keep one alive — the same reasoning `arm64WritesResult` already applies
// to a `const_int` folded into an immediate. Kept as a wrapper rather than
// one more clause inside `arm64WritesResult`, which is already at this repo's
// E0204 complexity ceiling (spec/LINT.md).
fn arm64DefinesRegister(
  ctx: TypeContext, f: IrFunc, skipConst: []bool,
  fuseCmp: []bool, i: int,
): bool {
  if (fuseCmp[i]) {
    return false
  }
  return arm64WritesResult(ctx, f, skipConst, i)
}

// ===========================================================================
// #3844: a jump to the next block is a fall-through
// ===========================================================================
//
// `jump` and the else edge of `br` both ended in an unconditional `b` even
// when the block they named was the very next one emitted, which the hardware
// reaches by doing nothing:
//
//     228:  b     0x22c
//     22c:  add   x25, x19, #0x10     <- the target IS the next address
//
// This is decided at EMISSION time — the word is never written — rather than
// by deleting it afterwards, and that is what makes it safe for every table
// this backend builds. Relocations, safepoint return addresses, block
// offsets, jump fixups, local conditional-branch patches and #3283's
// debug-line rows all take their offset from `codeLen(cx)` as emission
// proceeds, so each one is a statement about the stream that was actually
// produced. Nothing is computed against a pre-elision layout and then
// shifted, so there is no offset to update. (Stack-map positions are IR
// instruction indices, not code offsets — see `recordSafepoint` — and this
// language emits no jump tables.)
//
// Two facts make "the target is the next address" exact rather than a guess:
//
//   1. `compileFunction` emits blocks in `f.blocks` index order and emits
//      nothing between two blocks, so block `curBlock + 1` begins at whatever
//      offset this block ends at.
//   2. The `b` would be this block's LAST word. `i` is checked against the
//      block's own last instruction index for the terminator half, and both
//      call sites place this call last in their arm.
//
// The restriction this can never lift: an edge whose `b` is elided must be the
// one the block FALLS INTO, and in `emitBr`'s two-shape below that is decided
// per shape, not per edge. Under the both-edges-inline shape the THEN edge
// still keeps its `b` unconditionally — `patchLocalCondBranch` resolves the
// else fixup to whatever follows it, so dropping the then jump there would
// patch that conditional branch to its own address, an infinite loop rather
// than a slower loop. `emitBr` calls this for THEN only in the shape that
// emits no local fixup at all.
fn emitJumpOrFallThrough(cx: A64Ctx, curBlock: int, i: int, target: int) {
  let b = cx.f.blocks[curBlock]
  if (target == curBlock + 1 && i == b.instsStart + b.instsLen - 1) {
    return
  }
  emitJumpFixup(cx, target)
}

// ===========================================================================
// #4348: one conditional branch, not a b.cond to a trampoline that jumps again
// ===========================================================================
//
// The both-edges-inline shape below is what `br` always emitted. It skips the
// THEN edge's inline code with a local conditional branch, so when NEITHER
// edge has any inline code it degenerates to three branches doing one branch's
// work — 728 of the 851 conditional branches in the `matrix` bench binary:
//
//     cmp   x23, x19
//     b.ge  L        <- 8 bytes down
//     b     THEN     <- and THEN is the very next block
//   L: b     ELSE
//
// An edge only needs code of its own for two reasons — a back-edge safepoint
// poll, and the target block's parameter moves — so when one edge needs
// neither, the conditional branch can name that edge's BLOCK directly and the
// other edge takes the fall-through. `emitCondJumpFixup` resolves against
// `blockOffsets` at the end of the function exactly as the unconditional
// `emitJumpFixup` does.
//
// Nothing here moves a safepoint. Both shapes emit the poll for an edge on
// that edge's own path and nowhere else, and the ORDER in which the two edges'
// polls are emitted is unchanged — which is what `recordSafepoint`'s
// `sm.pos == cx.safepointPositions[...]` assert is checking, since the stack
// maps are consumed in the order `buildIntervals` collected them.
//
// Block order is untouched: this decides how to reach a block, never where a
// block goes.

// Does `br`'s edge to `target` need any code emitted ON the edge? Only two
// things can live there: a back-edge safepoint poll, and the target block's
// parameter moves. `moves` is that edge's already-built parallel move, so this
// is exact rather than a guess from the argument count — an edge whose every
// argument is already in its parameter's location emits nothing, and 9 of the
// 20 trampolines left in `matrix`'s `_main` were exactly that case.
fn brEdgeNeedsInlineCode(
  cx: A64Ctx, curBlock: int, target: int, moves: []PMove,
): bool {
  if (isBackEdge(curBlock, target) && !needsNoSafepoints(cx.f)) {
    return true
  }
  return !pmovesAllIdentity(moves)
}

// Emits the whole of `br`. `i` is its instruction id, which is its block's
// last, so either edge is a legal fall-through candidate.
fn emitBr(cx: A64Ctx, curBlock: int, i: int, ins: IrInstr) {
  let elseCond = emitBrCondition(cx, i, ins.lhs)
  let thenMoves = blockArgMoves(cx, ins.ival, ins.thenArgs)
  let elseMoves = blockArgMoves(cx, ins.ival2, ins.elseArgs)
  let thenInline = brEdgeNeedsInlineCode(cx, curBlock, ins.ival, thenMoves)
  let elseInline = brEdgeNeedsInlineCode(cx, curBlock, ins.ival2, elseMoves)
  // THEN needs nothing: branch straight to it and let ELSE have the tail.
  // Preferred over the mirror when ELSE is the next block, because then the
  // tail costs nothing either and the whole `br` is one instruction.
  if (!thenInline && (elseInline || ins.ival2 == curBlock + 1)) {
    emitCondJumpFixup(cx, condInvert(elseCond), ins.ival)
    emitBrEdgeTail(cx, curBlock, i, ins.ival2, elseMoves)
    return
  }
  // ELSE needs nothing: branch straight to it and let THEN have the tail.
  if (!elseInline) {
    emitCondJumpFixup(cx, elseCond, ins.ival2)
    emitBrEdgeTail(cx, curBlock, i, ins.ival, thenMoves)
    return
  }
  // Both edges carry code, so one of them has to be jumped over.
  let elseFixup = emitLocalCondBranch(cx, elseCond)
  emitBackEdgeSafepointIfNeeded(cx, curBlock, ins.ival)
  sequentializeAndEmit(cx, thenMoves)
  emitJumpFixup(cx, ins.ival)
  patchLocalCondBranch(cx, elseFixup)
  emitBrEdgeTail(cx, curBlock, i, ins.ival2, elseMoves)
}

// The fall-through edge's own code, then its jump — elided when `target` is
// the next block, which is `emitJumpOrFallThrough`'s whole job.
fn emitBrEdgeTail(
  cx: A64Ctx, curBlock: int, i: int, target: int, moves: []PMove,
) {
  emitBackEdgeSafepointIfNeeded(cx, curBlock, target)
  sequentializeAndEmit(cx, moves)
  emitJumpOrFallThrough(cx, curBlock, i, target)
}
