// Self-host (#3355, epic #3322): the Win64 home-space reproduction matrix for
// the PE backend. Split out of peexceptioncheck.bit, which was at the 800-line
// limit (docs/development.md); sibling .bit files are the same module, so
// `selfcheck()` still calls checkPeCallRepro directly and the shared helpers
// (xdEmitRaw, xdCallRel32, xdUnwindPiece, xdAssertHomeSpace, xdAppendAllR,
// xdRebaseRelocs, xdMergeRebased) need no import.
//
// #3345 reported that a function reached from `_start` via an intra-object
// `call` printed non-deterministic garbage instead of its canary, and blamed
// the PE linker. This holds "reached via an intra-object call" CONSTANT and
// varies the two Win64 caller obligations that harness omitted, so the real
// discriminator is measured on hardware rather than reasoned about.

// ---------------------------------------------------------------------------
// #3355: the intra-object-call repro matrix.
//
// #3345 reported that a function reached from `_start` via an intra-object
// `call` printed non-deterministic garbage instead of its canary, and blamed
// the PE linker. This builds a MATRIX of variants that hold "reached via an
// intra-object call" constant while varying the two Win64 caller obligations
// the throwaway harness omitted, so the real discriminator is measured rather
// than reasoned about. See xdCallVariants for what each one isolates.
// ---------------------------------------------------------------------------

// `homeSpace`: reserve Win64's 32-byte home space around each API call, the
// obligation xEmitCallLike (compiler/x64call.bit:422) discharges for real
// codegen. `arg5`: store WriteFile's 5th argument (lpOverlapped = NULL) at
// [rsp+0x20], where the callee reads it. `canaryOff`/`writtenOff` are
// rbp-relative, so a canary inside [rbp-frameSize, rbp) sits in the very
// bytes a callee may spill its register arguments into when homeSpace is off.
class XdCallVariant {
  name: string,
  intraCall: bool,
  frameSize: int,
  canaryOff: int,
  writtenOff: int,
  homeSpace: bool,
  arg5: bool,
  count: int,
}

// A signed rbp displacement as the disp8 byte of a ModRM /r+disp8 form.
fn xdDisp8(off: int): int {
  assert(off >= -128 && off <= 127)
  return (off + 256) & 255
}

// The canary-write + GetStdHandle + WriteFile + ExitProcess body, emitted
// into `cx` with the variant's obligations honoured or omitted. Returns the
// call relocations at offsets LOCAL to cx.buf (xdRebaseRelocs rebases them).
fn xdReproBody(cx: XCtx, v: XdCallVariant): []PeRelocation {
  let relocs = []PeRelocation(0)
  xdEmitRaw(
    cx.buf,
    [
      u8(0xC7), u8(0x45), u8(xdDisp8(v.canaryOff)),
      u8(0x43), u8(0x43), u8(0x43), u8(0x43),
    ],
  )                                                                     // mov dword[rbp+co],0x43434343
  xdEmitRaw(cx.buf, [u8(0xB9), u8(0xF5), u8(0xFF), u8(0xFF), u8(0xFF)]) // mov ecx,-11
  if (v.homeSpace) {
    xRspAddSub(cx.buf, true, 32)
  }
  relocs = xdCallRel32(cx.buf, relocs, "GetStdHandle")
  if (v.homeSpace) {
    xRspAddSub(cx.buf, false, 32)
  }
  xdEmitRaw(cx.buf, [u8(0x48), u8(0x89), u8(0xC1)])                           // mov rcx,rax
  xdEmitRaw(cx.buf, [u8(0x48), u8(0x8D), u8(0x55), u8(xdDisp8(v.canaryOff))]) // lea rdx,[rbp+co]
  xdEmitRaw(cx.buf, [u8(0x41), u8(0xB8)])
  xEmitU32(cx.buf, v.count)                                                    // mov r8d,count
  xdEmitRaw(cx.buf, [u8(0x4C), u8(0x8D), u8(0x4D), u8(xdDisp8(v.writtenOff))]) // lea r9,[rbp+wo]
  // 48 bytes, not 32: home space (0x20) plus the 5th stack argument at
  // [rsp+0x20], rounded up to keep rsp 16-aligned at the call.
  if (v.homeSpace) {
    xRspAddSub(cx.buf, true, 48)
  }
  if (v.arg5) {
    xdEmitRaw(cx.buf, [u8(0x48), u8(0xC7), u8(0x44), u8(0x24), u8(0x20)])
    xEmitU32(cx.buf, 0) // mov qword[rsp+0x20],0
  }
  relocs = xdCallRel32(cx.buf, relocs, "WriteFile")
  if (v.homeSpace) {
    xRspAddSub(cx.buf, false, 48)
  }
  xdEmitRaw(cx.buf, [u8(0x31), u8(0xC9)]) // xor ecx,ecx
  if (v.homeSpace) {
    xRspAddSub(cx.buf, true, 32)
  }
  relocs = xdCallRel32(cx.buf, relocs, "ExitProcess")
  return relocs
}

// Links one variant into a complete .exe. `_start` either calls `funcSmall`
// (the reported-broken shape) or runs the body itself (the reported-working
// shape); both carry real `.pdata`/`.xdata` from xEmitPrologue, so unwind
// info is held constant across the whole matrix.
fn xdBuildRepro(v: XdCallVariant): []u8 {
  let startFrame = 32
  if (!v.intraCall) {
    startFrame = v.frameSize
  }
  let cxS = newXCtx(XCallConv.Win64)
  cxS.frame = XFrame{
    savedGpr: []XReg64(0), savedXmm: []XmmReg(0),
    numSpillSlots: 0, frameSize: startFrame,
  }
  let uS = xEmitPrologue(cxS)
  let sRelocs = []PeRelocation(0)
  if (v.intraCall) {
    if (v.homeSpace) {
      xRspAddSub(cxS.buf, true, 32)
    }
    sRelocs = xdCallRel32(cxS.buf, sRelocs, "funcSmall")
  } else {
    sRelocs = xdReproBody(cxS, v)
    xdAssertHomeSpace(cxS.buf.code, sRelocs, v.homeSpace)
  }
  let sBytes = cxS.buf.code
  let sSize = len(sBytes)

  let text = xdAppendAllR([]u8(0), sBytes)
  let relocs = xdRebaseRelocs(sRelocs, 0)
  let names = ["_start"]
  let sizes = [sSize]
  let infos = [uS]

  if (v.intraCall) {
    let cxF = newXCtx(XCallConv.Win64)
    cxF.frame = XFrame{
      savedGpr: []XReg64(0), savedXmm: []XmmReg(0),
      numSpillSlots: 0, frameSize: v.frameSize,
    }
    let uF = xEmitPrologue(cxF)
    let fRelocs = xdReproBody(cxF, v)
    xdAssertHomeSpace(cxF.buf.code, fRelocs, v.homeSpace)
    let fBytes = cxF.buf.code
    let fOff = len(text)
    text = xdAppendAllR(text, fBytes)
    relocs = xdMergeRebased(relocs, fRelocs, fOff)
    names = append(names, "funcSmall")
    sizes = append(sizes, len(fBytes))
    infos = append(infos, uF)
  }

  let symbols = []PeSymbol(0)
  let xdata = []u8(0)
  let pdata = []u8(0)
  let off = 0
  let i = 0
  while (i < len(names)) {
    let xOff = len(xdata)
    let pOff = len(pdata)
    let piece = xdUnwindPiece(names[i], sizes[i], infos[i])
    xdata = xdAppendAllR(xdata, piece.xdataBytes)
    pdata = xdAppendAllR(pdata, piece.pdataRec)
    let pj = 0
    while (pj < len(piece.pdataRelocs)) {
      let r = piece.pdataRelocs[pj]
      relocs = append(
        relocs,
        PeRelocation{
          section: r.section, offset: pOff + r.offset,
          symbol: r.symbol, kind: r.kind,
        },
      )
      pj = pj + 1
    }
    symbols = append(
      symbols,
      PeSymbol{
        name: names[i], hasSection: true,
        section: PeSectionKind.Text, offset: off, size: sizes[i],
        binding: PeBinding.Global, kind: PeSymKind.Func,
      },
    )
    symbols = append(
      symbols,
      PeSymbol{
        name: "\$xdata\$" + names[i], hasSection: true,
        section: PeSectionKind.Xdata, offset: xOff, size: len(piece.xdataBytes),
        binding: PeBinding.Local, kind: PeSymKind.Notype,
      },
    )
    symbols = append(
      symbols,
      PeSymbol{
        name: "\$pdata\$" + names[i], hasSection: true,
        section: PeSectionKind.Pdata, offset: pOff, size: 12,
        binding: PeBinding.Local, kind: PeSymKind.Notype,
      },
    )
    off = off + sizes[i]
    i = i + 1
  }
  for n of ["GetStdHandle", "WriteFile", "ExitProcess"] {
    symbols = append(
      symbols,
      PeSymbol{
        name: n, hasSection: false,
        section: PeSectionKind.Text, offset: 0, size: 0,
        binding: PeBinding.Global, kind: PeSymKind.Notype,
      },
    )
  }

  let bytes = plWriteProbe(
    [
      PeSection{ kind: PeSectionKind.Text, data: text, size: 0, alignment: 16 },
      PeSection{ kind: PeSectionKind.Pdata, data: pdata, size: 0, alignment: 4 },
      PeSection{ kind: PeSectionKind.Xdata, data: xdata, size: 0, alignment: 4 },
    ],
    symbols, relocs,
  )
  return linkPe(
    [plObjectInput(bytes)],
    ["GetStdHandle", "WriteFile", "ExitProcess"],
  ) catch _ {
    []u8(0)
  }
}

// v1  the ticket's shape verbatim: canary at [rbp-8] with a 32-byte frame, so
//     it lands exactly on argument 4's home slot; no home space, no 5th arg.
// v2  the same, both obligations honoured — the predicted fix.
// v3  home space only: isolates whether the missing 5th argument alone breaks it.
// v5  the ticket's "working" shape (no intra-object call), otherwise identical
//     to v1 — this is the ticket's claimed structural difference.
// v6  v1 with a 64-byte frame: the canary moves OUT of the home space while the
//     intra-object call, the missing home space and the missing 5th argument all
//     stay exactly as in v1. The discriminator.
// v8  v1 writing 8 bytes instead of 4: reveals the whole clobbering value, so it
//     can be identified rather than guessed at.
fn xdCallVariants(): []XdCallVariant {
  return [
    XdCallVariant{
      name: "v1-ticket", intraCall: true, frameSize: 32,
      canaryOff: -8, writtenOff: -16, homeSpace: false, arg5: false, count: 4,
    },
    XdCallVariant{
      name: "v2-fixed", intraCall: true, frameSize: 32,
      canaryOff: -8, writtenOff: -16, homeSpace: true, arg5: true, count: 4,
    },
    XdCallVariant{
      name: "v3-home-only", intraCall: true, frameSize: 32,
      canaryOff: -8, writtenOff: -16, homeSpace: true, arg5: false, count: 4,
    },
    XdCallVariant{
      name: "v5-nocall", intraCall: false, frameSize: 32,
      canaryOff: -8, writtenOff: -16, homeSpace: false, arg5: false, count: 4,
    },
    XdCallVariant{
      name: "v6-bigframe", intraCall: true, frameSize: 64,
      canaryOff: -8, writtenOff: -16, homeSpace: false, arg5: false, count: 4,
    },
    XdCallVariant{
      name: "v8-ticket8", intraCall: true, frameSize: 32,
      canaryOff: -8, writtenOff: -16, homeSpace: false, arg5: false, count: 8,
    },
  ]
}

// Mutation-tested (#3355): removing the `xRspAddSub(cx.buf, true, 32)` before
// GetStdHandle in xdEmitFuncCBody made `bit selfcheck` fail (exit 2, "panic:
// assertion failed") on xdAssertHomeSpace's `want: true` arm; reverted, and
// green again (exit 0) — verified by rebuilding each time.
//
// Measured on mustafa-desktop-win (Windows 11 Pro 10.0.26200), 3 runs each:
// v2-fixed/v3-home-only/v6-bigframe printed `43 43 43 43` every time;
// v1-ticket and v5-nocall printed 4 DIFFERENT bytes every time. v6 is one byte
// from v1 (sub rsp,0x40 vs 0x20) with the same call and the same missing home
// space, so the intra-object call is not the cause; v5 has no such call and
// fails anyway. v8-ticket8 prints 8 bytes: always a canonical stack address
// whose implied rbp is 16-aligned, identifying the clobbering value as r9
// (&written), spilled by WriteFile into argument 4's home slot at [rbp-8].
fn checkPeCallRepro() {
  let dir = envOr("BIT_PE_CALL_REPRO_DIR", "")
  for v of xdCallVariants() {
    let exe = xdBuildRepro(v)
    assert(len(exe) > 0)
    if (dir != "") {
      writeFile(dir + "/" + v.name + ".exe", string(exe)) catch _ {}
    }
  }
}
