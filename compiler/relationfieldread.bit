// compiler/relationfieldread.bit — three small helpers for asking "is this
// field a relation, and where is a nested-scope boundary" that outlived the
// file they were written for. compiler/lintrelation.bit (E0218
// `relation-unloaded-read`) was retired (#6303, ticket epic #6298): #6296
// removed the `find<T>` chain shape the lint rule anchored on, and the
// compile-time build error E0300 (compiler/relationautoerr.bit) now covers
// the same misuse. But `compiler/relationauto.bit`'s flow walk (R1/R2/R2b),
// `compiler/relationautoerr.bit`'s build-error walk (R3) and
// `compiler/checkormquery.bit`'s literal-column check all came to depend on
// these three functions directly, so deleting them with the rest of
// lintrelation.bit would have broken three passes with nothing to do with
// the retired lint rule. Moved here instead, unchanged.

// The field named `fieldName` on `classDecl`, or 0. Mirrors
// `classrelationattr.bit`'s `vStrayRelationAttrs` member walk exactly.
fn lintFieldByName(tree: Tree, src: string, classDecl: int, fieldName: string): int {
  for m of kidsOf(tree, kidsOf(tree, classDecl)[2]) {
    let f = memberField(tree, m)
    if (f == 0) {
      continue
    }
    if (identText(tree, src, kidsOf(tree, f)[0]) == fieldName) {
      return f
    }
  }
  return 0
}

// The real compiler-known predicate (#5053 step 1), never a string match on
// the field's own type or name.
fn lintFieldIsRelation(tree: Tree, src: string, classDecl: int, fieldName: string): bool {
  let field = lintFieldByName(tree, src, classDecl, fieldName)
  if (field == 0) {
    return false
  }
  return fieldRelationAttr(tree, src, field) != 0
}

// True for a node a relation-tracking walk must not descend INTO — a nested
// closure/function is its own scope, visited separately as its own
// top-level entry by the caller's own loop (relationauto.bit's
// `relationAutoAnalyzeWholeProject`, relationautoerr.bit's whole-project
// pass).
fn lintIsNestedFuncBoundary(tag: Tag): bool {
  return tag == Tag.FuncDecl || tag == Tag.ArrowFn
}
