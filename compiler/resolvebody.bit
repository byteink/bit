// Self-host Stage 2 (#1503): resolver pass 2 — split out of resolve.bit.
// Bodies, type expressions, and initializers, plus the `resolveModule` entry
// point. Passes 1 and the resolver substrate live in resolve.bit / symbols.bit.

// ---- pass 2: resolve bodies, type expressions, and initializers ------------

fn rResolveBodies(r: Resolver) {
  let decls = kidsOf(r.tree, r.tree.root)
  let i = 0
  while (i < len(decls)) {
    if (decls[i] != 0) {
      rResolveTopDeclBody(r, rUnwrapExport(r, decls[i]))
    }
    i = i + 1
  }
}

fn rResolveTopDeclBody(r: Resolver, idx: int) {
  let tag = getNode(r.tree, idx).tag
  if (tag == Tag.LetDecl || tag == Tag.ConstDecl) {
    let bindings = kidsOf(r.tree, idx)
    let i = 0
    while (i < len(bindings)) {
      let bk = kidsOf(r.tree, bindings[i]) // [pattern, type_or_none, init_or_none]
      rResolveNode(r, bk[1], r.moduleScope)
      rResolveNode(r, bk[2], r.moduleScope)
      i = i + 1
    }
  } else if (tag == Tag.TypeAlias) {
    let k = kidsOf(r.tree, idx) // [name, generics, ty]
    rResolveNode(r, k[2], rPushGenericsScope(r, k[1], r.moduleScope))
  } else if (tag == Tag.FuncDecl) {
    rResolveFuncDecl(r, idx)
  } else if (tag == Tag.ExternFnDecl) {
    rResolveExternFnDecl(r, idx)
  } else if (tag == Tag.StructDecl) {
    rResolveStructDecl(r, idx)
  } else if (tag == Tag.InterfaceDecl) {
    rResolveInterfaceDecl(r, idx)
  } else if (tag == Tag.EnumDecl) {
    rResolveEnumDecl(r, idx)
  } else {
    // Every tag with no case above is either not a top-level declaration at
    // all (a poisoned node from parser error recovery) or is handled by a
    // tail delegate here -- kept OUT of this if-elseif chain so a new tag
    // costs the delegate's own complexity, never rResolveTopDeclBody's
    // (spec/LINT.md E0204, tools/build/complexity-debt.txt).
    rResolveTopDeclBodyTail(r, idx, tag)
  }
}

// `rResolveTopDeclBody`'s tail delegate (see its own trailing `else` above).
fn rResolveTopDeclBodyTail(r: Resolver, idx: int, tag: Tag) {
  if (tag == Tag.TestDecl) {
    rResolveTestDecl(r, idx)
  }
}

// THE FIX FOR THE `<T>` COLLISION: each decl's type params get their OWN scope,
// so two decls each declaring `<T>` bind two distinct symbols instead of
// fighting over one bare name. This is what a scope tree buys.
fn rPushGenericsScope(r: Resolver, genericsIdx: int, parent: int): int {
  if (genericsIdx == 0) {
    return parent
  }
  let scopeId = rPushScope(r, parent)
  let gps = kidsOf(r.tree, genericsIdx)
  let i = 0
  while (i < len(gps)) {
    let gk = kidsOf(r.tree, gps[i]) // [name, constraint_or_none]
    rActivateLocal(r, gk[0], SymbolKind.GenericParam, scopeId)
    rResolveNode(r, gk[1], scopeId)
    i = i + 1
  }
  return scopeId
}

fn rResolveFuncDecl(r: Resolver, idx: int) {
  let k = kidsOf(r.tree, idx) // [recv, name, generics, params, result, body]
  let fnScope = rPushScope(r, rPushGenericsScope(r, k[2], r.moduleScope))

  if (k[0] != 0) {
    let rk = kidsOf(r.tree, k[0]) // receiver: [name_or_none, type_name]
    rResolveNode(r, rk[1], fnScope)
    if (rk[0] != 0) {
      rActivateLocal(r, rk[0], SymbolKind.Receiver, fnScope)
    } else {
      // An in-body method's implicit `this` (SPEC §10.4, #3367): no name
      // token exists to activate from.
      rActivateReceiver(r, k[0], fnScope)
    }
  }
  let params = kidsOf(r.tree, k[3])
  let i = 0
  while (i < len(params)) {
    let pk = kidsOf(r.tree, params[i]) // param | param_rest: [name, type]
    rResolveNode(r, pk[1], fnScope)
    rActivateLocal(r, pk[0], SymbolKind.Param, fnScope)
    i = i + 1
  }
  rResolveNode(r, k[4], fnScope)
  rResolveNode(r, k[5], fnScope)
}

// `test "name" { ... }` (SPEC §19, epic #4126, #4127): a fresh scope for the
// body, same shape as `rResolveFuncDecl` above minus the receiver, generics
// and params it has none of. Not collected into the flat namespace at all
// (resolvecollect.bit's `rCollectTopDecl` has no TestDecl arm) — a test is
// never referenced by name, so it needs no symbol.
fn rResolveTestDecl(r: Resolver, idx: int) {
  let k = kidsOf(r.tree, idx) // [name, body]
  rResolveNode(r, k[1], rPushScope(r, r.moduleScope))
}

// SPEC 11.7: only the signature's type nodes need resolving — there is no body,
// and the parameter names are documentation, never referenced.
fn rResolveExternFnDecl(r: Resolver, idx: int) {
  let k = kidsOf(r.tree, idx) // [name, params, result_or_none]
  let params = kidsOf(r.tree, k[1])
  let i = 0
  while (i < len(params)) {
    rResolveNode(r, kidsOf(r.tree, params[i])[1], r.moduleScope)
    i = i + 1
  }
  rResolveNode(r, k[2], r.moduleScope)
}

// Reports a duplicate for any name already in `seen`, else records it. Shared by
// the class-field / enum-variant / interface-method sibling checks. No caller
// anywhere wants to know which happened (#4150) — the diagnostic is the only
// observable effect — so this is void rather than a bool nobody reads.
fn rSeenDuplicate(r: Resolver, seen: map<string, bool>, nameNode: int) {
  let name = rIdentText(r, nameNode)
  let (_, dup) = seen[name]
  if (dup) {
    rReportDuplicate(r, nameNode, name)
    return
  }
  seen[name] = true
}

fn rResolveStructDecl(r: Resolver, idx: int) {
  let k = kidsOf(r.tree, idx) // [name, generics, field_list]
  let scopeId = rPushGenericsScope(r, k[1], r.moduleScope)
  let seen = map<string, bool>{}
  let fields = kidsOf(r.tree, k[2])
  let i = 0
  while (i < len(fields)) {
    let item = rUnwrapExport(r, fields[i])
    if (getNode(r.tree, item).tag == Tag.FuncDecl) {
      // An in-body method (SPEC §10.4, #3367): this list holds both fields
      // and methods, but `rResolveBodies`'s decls-list walk only ever
      // reaches a TOP-LEVEL func_decl, so a nested one is resolved here
      // instead, exactly like a top-level one — its merged generics already
      // carry the class's own (parsertype.bit's mergeGenericParams call), so
      // it needs no scope from this class's own `scopeId`.
      rResolveFuncDecl(r, item)
      i = i + 1
      continue
    }
    if (getNode(r.tree, item).tag == Tag.UseStmt) {
      // A trait-injection statement (SPEC §10.7, #3369): not a field, and
      // its kids are trait-name references consumed by checktrait.bit's own
      // pre-resolve pass, not by ordinary identifier lookup here.
      i = i + 1
      continue
    }
    let fk = kidsOf(r.tree, item) // [name, type]
    rResolveNode(r, fk[1], scopeId)
    rSeenDuplicate(r, seen, fk[0])
    i = i + 1
  }
}

fn rResolveEnumDecl(r: Resolver, idx: int) {
  let k = kidsOf(r.tree, idx) // [name, generics, variant_list]
  let scopeId = rPushGenericsScope(r, k[1], r.moduleScope)
  let seen = map<string, bool>{}
  let variants = kidsOf(r.tree, k[2])
  let i = 0
  while (i < len(variants)) {
    let vk = kidsOf(r.tree, variants[i]) // [name, payload_or_none]
    if (vk[1] != 0) {
      let tys = kidsOf(r.tree, vk[1])
      let j = 0
      while (j < len(tys)) {
        rResolveNode(r, tys[j], scopeId)
        j = j + 1
      }
    }
    rSeenDuplicate(r, seen, vk[0])
    i = i + 1
  }
}

fn rResolveInterfaceDecl(r: Resolver, idx: int) {
  let k = kidsOf(r.tree, idx) // [name, generics, method_sig_list]
  let scopeId = rPushScope(r, rPushGenericsScope(r, k[1], r.moduleScope))
  // `Self` (§14.3) stands for whatever type ends up satisfying the interface;
  // it is only meaningful inside method signatures.
  rInjectImplicitSymbol(r, scopeId, "Self", SymbolKind.GenericParam)

  let seen = map<string, bool>{}
  let sigs = kidsOf(r.tree, k[2])
  let i = 0
  while (i < len(sigs)) {
    let sk = kidsOf(r.tree, sigs[i]) // [name, params, result_or_none]
    rSeenDuplicate(r, seen, sk[0])
    let params = kidsOf(r.tree, sk[1])
    let j = 0
    while (j < len(params)) {
      // [name, type] — no body, so the params themselves never need binding
      rResolveNode(r, kidsOf(r.tree, params[j])[1], scopeId)
      j = j + 1
    }
    rResolveNode(r, sk[2], scopeId)
    i = i + 1
  }
}

// ---- blocks: prescan for use-before-init, then resolve sequentially --------

fn rResolveBlockScope(r: Resolver, blockIdx: int, parent: int) {
  let scopeId = rPushScope(r, parent)
  let stmts = kidsOf(r.tree, blockIdx)
  rPrescanBlockNames(r, stmts, scopeId)
  let i = 0
  while (i < len(stmts)) {
    rResolveNode(r, stmts[i], scopeId)
    i = i + 1
  }
}

fn rPrescanBlockNames(r: Resolver, stmts: []int, scopeId: int) {
  let i = 0
  while (i < len(stmts)) {
    let tag = getNode(r.tree, stmts[i]).tag
    if (tag == Tag.LetDecl || tag == Tag.ConstDecl) {
      let bindings = kidsOf(r.tree, stmts[i])
      let j = 0
      while (j < len(bindings)) {
        rPrescanPattern(r, kidsOf(r.tree, bindings[j])[0], scopeId)
        j = j + 1
      }
    }
    i = i + 1
  }
}

fn rPrescanPattern(r: Resolver, patIdx: int, scopeId: int) {
  let tag = getNode(r.tree, patIdx).tag
  // A `FieldPat` (`for { a, b } of xs`, #4106) has the same flat-list-of-
  // binders shape `TuplePat` does — the field name doubling as the bound
  // local's name is a lowering/checker concern, not a resolver one.
  if (tag == Tag.TuplePat || tag == Tag.FieldPat) {
    let subs = kidsOf(r.tree, patIdx)
    let i = 0
    while (i < len(subs)) {
      rPrescanPattern(r, subs[i], scopeId)
      i = i + 1
    }
    return
  }
  let name = rIdentText(r, patIdx)
  if (name == "_") {
    return
  }
  r.scopes[scopeId].pending[name] = true
}

fn rActivatePattern(r: Resolver, patIdx: int, kind: SymbolKind, scopeId: int) {
  let tag = getNode(r.tree, patIdx).tag
  if (tag == Tag.TuplePat || tag == Tag.FieldPat) {
    let subs = kidsOf(r.tree, patIdx)
    let i = 0
    while (i < len(subs)) {
      rActivatePattern(r, subs[i], kind, scopeId)
      i = i + 1
    }
    return
  }
  rActivateLocal(r, patIdx, kind, scopeId)
}

// Case/clause bodies share the enclosing scope rather than opening their own: a
// case's own prescan still runs, so declarations inside one case are visible to
// a later reference in the SAME case, and colliding with a sibling case's
// declaration is a duplicate in the shared scope.
fn rResolveCaseBody(r: Resolver, stmtListIdx: int, scopeId: int) {
  let stmts = kidsOf(r.tree, stmtListIdx)
  rPrescanBlockNames(r, stmts, scopeId)
  let i = 0
  while (i < len(stmts)) {
    rResolveNode(r, stmts[i], scopeId)
    i = i + 1
  }
}

fn rResolveForC(r: Resolver, idx: int, scopeId: int) {
  let k = kidsOf(r.tree, idx) // [init_or_none, cond_or_none, post_or_none, body]
  let loopScope = rPushScope(r, scopeId)
  rResolveNode(r, k[0], loopScope)
  rResolveNode(r, k[1], loopScope)
  rResolveNode(r, k[2], loopScope)
  rResolveNode(r, k[3], loopScope)
}

fn rResolveForOf(r: Resolver, idx: int, scopeId: int) {
  let k = kidsOf(r.tree, idx)    // [binder, iter_expr, body]
  rResolveNode(r, k[1], scopeId) // the iterable cannot see the loop variable
  let loopScope = rPushScope(r, scopeId)
  rActivatePattern(r, k[0], SymbolKind.LetBinding, loopScope)
  rResolveNode(r, k[2], loopScope)
}

fn rResolveForIn(r: Resolver, idx: int, scopeId: int) {
  let k = kidsOf(r.tree, idx) // [name_ident, iter_expr, body]
  rResolveNode(r, k[1], scopeId)
  let loopScope = rPushScope(r, scopeId)
  rActivateLocal(r, k[0], SymbolKind.LetBinding, loopScope)
  rResolveNode(r, k[2], loopScope)
}

fn rResolveSwitch(r: Resolver, idx: int, scopeId: int) {
  let k = kidsOf(r.tree, idx) // [subject_or_none, case_list]
  rResolveNode(r, k[0], scopeId)
  let cases = kidsOf(r.tree, k[1])
  let i = 0
  while (i < len(cases)) {
    let tag = getNode(r.tree, cases[i]).tag
    if (tag == Tag.SwitchCase) {
      let ck = kidsOf(r.tree, cases[i]) // [expr_list, stmt_list]
      let exprs = kidsOf(r.tree, ck[0])
      let j = 0
      while (j < len(exprs)) {
        rResolveNode(r, exprs[j], scopeId)
        j = j + 1
      }
      rResolveCaseBody(r, ck[1], scopeId)
    } else if (tag == Tag.SwitchDefault) {
      rResolveCaseBody(r, kidsOf(r.tree, cases[i])[0], scopeId)
    }
    i = i + 1
  }
}

// A `match`: the subject, then each arm's body in its own scope. A variant
// pattern's NAME is not a scope lookup — the checker resolves it against the
// subject's enum type — so only its payload binders activate here.
fn rResolveMatch(r: Resolver, idx: int, scopeId: int) {
  let k = kidsOf(r.tree, idx) // [subject, arm_list]
  rResolveNode(r, k[0], scopeId)
  let arms = kidsOf(r.tree, k[1])
  let i = 0
  while (i < len(arms)) {
    let ak = kidsOf(r.tree, arms[i]) // [variant_pat, body]
    let armScope = rPushScope(r, scopeId)
    let vk = kidsOf(r.tree, ak[0]) // variant_pat: [name, binders_or_none]
    if (vk[1] != 0) {
      let binders = kidsOf(r.tree, vk[1])
      let j = 0
      while (j < len(binders)) {
        rActivateLocal(r, binders[j], SymbolKind.LetBinding, armScope)
        j = j + 1
      }
    }
    rResolveNode(r, ak[1], armScope)
    i = i + 1
  }
}

fn rResolveSelect(r: Resolver, idx: int, scopeId: int) {
  let clauses = kidsOf(r.tree, idx)
  let i = 0
  while (i < len(clauses)) {
    let tag = getNode(r.tree, clauses[i]).tag
    if (tag == Tag.CommCase) {
      let ck = kidsOf(r.tree, clauses[i]) // [comm, stmt_list]
      let commScope = rPushScope(r, scopeId)
      rResolveComm(r, ck[0], commScope)
      rResolveCaseBody(r, ck[1], commScope)
    } else if (tag == Tag.CommDefault) {
      rResolveCaseBody(r, kidsOf(r.tree, clauses[i])[0], scopeId)
    }
    i = i + 1
  }
}

fn rResolveComm(r: Resolver, idx: int, scopeId: int) {
  let tag = getNode(r.tree, idx).tag
  if (tag == Tag.SendStmt) {
    let k = kidsOf(r.tree, idx)
    rResolveNode(r, k[0], scopeId)
    rResolveNode(r, k[1], scopeId)
  } else if (tag == Tag.RecvBind) {
    let k = kidsOf(r.tree, idx) // [binder_or_none, chan_expr]
    rResolveNode(r, k[1], scopeId)
    if (k[0] != 0) {
      rActivatePattern(r, k[0], SymbolKind.LetBinding, scopeId)
    }
  }
}

// The unified expression/statement/type walker. Because value and type names
// share one flat namespace, a type-shaped node (GenericInst, ArrayType, ...)
// The name of the `const` binding at the root of an index/member/slice lvalue
// chain (`K[i]`, `K[i].x`, `K[a:b][i]`), or "" when the chain does not root in a
// `const`. Mirrors the seed's `rootBindingIsConst`; bounded by the arena depth.
fn rRootConstName(r: Resolver, node: int): string {
  let cur = node
  let guard = 0
  while (guard < 64) {
    let tag = getNode(r.tree, cur).tag
    if (tag == Tag.Index || tag == Tag.Member || tag == Tag.SliceExpr || tag == Tag.TupleIndex) {
      cur = kidsOf(r.tree, cur)[0]
    } else if (tag == Tag.Ident) {
      let sid = r.nodeSymbols[cur]
      if (sid > 0 && r.symbols[sid].kind == SymbolKind.ConstBinding) {
        return rIdentText(r, cur)
      }
      return ""
    } else {
      return ""
    }
    guard = guard + 1
  }
  return ""
}

// resolves through the exact same recursion as an expression: leaves have no
// kids (a no-op), and the only positions that must NOT recurse as plain
// references are member/field names, handled below. Scope-opening and
// name-declaring constructs get their own case; everything else falls through
// to the default "resolve every child".
fn rResolveNode(r: Resolver, idx: int, scopeId: int) {
  if (idx == 0) {
    return
  }
  let tag = getNode(r.tree, idx).tag
  if (tag == Tag.Ident) {
    rResolveIdentRef(r, idx, scopeId)
    return
  }
  // `.name` is a member/field name, resolved later against a type, not a scope
  // lookup — only the receiver/base is a reference.
  if (tag == Tag.Member) {
    rResolveNode(r, kidsOf(r.tree, idx)[0], scopeId)
    return
  }
  // `ns.Type` in TYPE position (#2118) — identical shape to `Member`: only the
  // namespace is a scope reference, the type name resolves later against that
  // namespace's exports (checktype.bit's typeFromNodeIn, validated for
  // presence by vQualType).
  if (tag == Tag.QualType) {
    rResolveNode(r, kidsOf(r.tree, idx)[0], scopeId)
    return
  }
  if (tag == Tag.FieldInit) {
    rResolveNode(r, kidsOf(r.tree, idx)[1], scopeId)
    return
  }
  // `name = expr` at a call site (SPEC §12.11, #3839): `name` is the callee's
  // PARAMETER name, resolved later against its declaration (validatecall.bit),
  // never a scope lookup — only the value expression is a reference. Mirrors
  // `Tag.FieldInit` immediately above. Without this case the generic recursion
  // below would look `name` up as a local/global and either report a spurious
  // "undefined" or silently bind it to an unrelated same-named variable.
  if (tag == Tag.NamedArg) {
    rResolveNode(r, kidsOf(r.tree, idx)[1], scopeId)
    return
  }
  if (tag == Tag.Block) {
    rResolveBlockScope(r, idx, scopeId)
    return
  }
  if (tag == Tag.LetDecl || tag == Tag.ConstDecl) {
    let kind = SymbolKind.ConstBinding
    if (tag == Tag.LetDecl) {
      kind = SymbolKind.LetBinding
    }
    let bindings = kidsOf(r.tree, idx)
    let i = 0
    while (i < len(bindings)) {
      let bk = kidsOf(r.tree, bindings[i]) // [pattern, type_or_none, init_or_none]
      rResolveNode(r, bk[1], scopeId)
      rResolveNode(r, bk[2], scopeId)
      rActivatePattern(r, bk[0], kind, scopeId)
      i = i + 1
    }
    return
  }
  if (tag == Tag.ForC) {
    rResolveForC(r, idx, scopeId)
    return
  }
  if (tag == Tag.ForOf) {
    rResolveForOf(r, idx, scopeId)
    return
  }
  if (tag == Tag.ForIn) {
    rResolveForIn(r, idx, scopeId)
    return
  }
  if (tag == Tag.SwitchStmt) {
    rResolveSwitch(r, idx, scopeId)
    return
  }
  if (tag == Tag.MatchStmt) {
    rResolveMatch(r, idx, scopeId)
    return
  }
  if (tag == Tag.SelectStmt) {
    rResolveSelect(r, idx, scopeId)
    return
  }
  if (tag == Tag.CatchBind) {
    let k = kidsOf(r.tree, idx) // [expr, err_ident, block]
    rResolveNode(r, k[0], scopeId)
    let catchScope = rPushScope(r, scopeId)
    rActivateLocal(r, k[1], SymbolKind.LetBinding, catchScope)
    rResolveNode(r, k[2], catchScope)
    return
  }
  if (tag == Tag.ArrowFn) {
    let k = kidsOf(r.tree, idx) // [arrow_params, body]
    let arrowScope = rPushScope(r, scopeId)
    let params = kidsOf(r.tree, k[0])
    let i = 0
    while (i < len(params)) {
      let pk = kidsOf(r.tree, params[i]) // [name, type_or_none]
      rResolveNode(r, pk[1], arrowScope)
      rActivateLocal(r, pk[0], SymbolKind.Param, arrowScope)
      i = i + 1
    }
    rResolveNode(r, k[1], arrowScope)
    return
  }
  // `t.0++` / `t.0--` mutate their target just as `=` does, so the read-only
  // tuple-element rule (§12.5) applies to them too.
  if (tag == Tag.IncStmt || tag == Tag.DecStmt) {
    let ik = kidsOf(r.tree, idx)
    rResolveNode(r, ik[0], scopeId)
    if (ik[0] != 0 && getNode(r.tree, ik[0]).tag == Tag.TupleIndex) {
      rErrorNoHint(
        r, ik[0], ecImmutableAssign,
        "cannot assign to a tuple element: tuple elements are read-only; use a class for a mutable field",
      )
    }
    return
  }
  if (tag == Tag.Assign) {
    let k = kidsOf(r.tree, idx) // [lhsList, rhsList]
    rResolveNode(r, k[0], scopeId)
    rResolveNode(r, k[1], scopeId)
    // E0062 (§13.1): a `const`-declared name is immutable. Only bare-ident
    // targets bind mutability; an index/member target's mutability is the
    // receiver's, so it is left to the checker's assignability rule.
    let targets = kidsOf(r.tree, k[0])
    let ti = 0
    while (ti < len(targets)) {
      let t = targets[ti]
      if (t != 0 && getNode(r.tree, t).tag == Tag.Ident) {
        let sid = r.nodeSymbols[t]
        if (sid > 0 && r.symbols[sid].kind == SymbolKind.ConstBinding) {
          rErrorNoHint(
            r,
            t,
            ecImmutableAssign,
            "cannot assign to '${rIdentText(r, t)}': declared 'const'",
          )
        }
      }
      // A tuple element is read-only (§12.5) — the restriction that lets a tuple
      // stay a value type while being one shared box (ABI.md §1.1). Purely
      // syntactic, so it belongs here beside the `const` rule rather than in a
      // type-directed pass.
      if (t != 0 && getNode(r.tree, t).tag == Tag.TupleIndex) {
        rErrorNoHint(
          r, t, ecImmutableAssign,
          "cannot assign to a tuple element: tuple elements are read-only; use a class for a mutable field",
        )
      }
      // A write THROUGH a `const` — `K[i] = v` — would fault the read-only
      // `.rodata` image a `const` table lives in (§11.11). Reject by walking the
      // index/member chain to its root name, mirroring the seed's
      // `checkAssignableLhs`. Bare idents and tuple elements are handled above.
      let tt = getNode(r.tree, t).tag
      if (t != 0 && tt != Tag.Ident && tt != Tag.TupleIndex) {
        let cn = rRootConstName(r, t)
        if (cn != "") {
          rErrorNoHint(
            r, t, ecImmutableAssign,
            "cannot assign through '${cn}': declared 'const' (a 'const' table is read-only)",
          )
        }
      }
      ti = ti + 1
    }
    return
  }
  if (tag == Tag.AsmStmt) {
    // §11.6: register-name and byte/word leaves are literal payload, never
    // scope references — only the `result` type and each `input`'s value
    // expression resolve. The generic recursion would wrongly look up
    // `x0`/`rax` as variables.
    let ak = kidsOf(r.tree, idx) // [x64_code, arm64_code, result?, clob_x64, clob_arm64, input...]
    if (ak[2] != 0) {
      let rk = kidsOf(r.tree, ak[2]) // [arm64_reg, x64_reg, type]
      rResolveNode(r, rk[2], scopeId)
    }
    let ai = 5
    while (ai < len(ak)) {
      let ik = kidsOf(r.tree, ak[ai]) // [arm64_reg, x64_reg, value]
      rResolveNode(r, ik[2], scopeId)
      ai = ai + 1
    }
    return
  }
  let kids = kidsOf(r.tree, idx)
  let i = 0
  while (i < len(kids)) {
    rResolveNode(r, kids[i], scopeId)
    i = i + 1
  }
}

// Resolves one module. `allModules` is every module resolved so far (indexed by
// module id) so imports can be checked against their target's exports; the
// loader loads dependencies first, so they are always present by the time a
// dependent resolves.
//
// `siblingScanEnabled` (#2919) and `isRootModule` (#3244) are forwarded to
// `newResolver` — see each field's own comment on `Resolver` (resolve.bit) for
// who passes `false` and why.
fn resolveModule(
  diags: Diagnostics, m: SrcModule, allModules: []Module, prelude: int, siblingScanEnabled: bool,
  isRootModule: bool,
): Module {
  let r = newResolver(diags, m, allModules, prelude, siblingScanEnabled, isRootModule)
  rCollectTopLevel(r)
  rInjectPrelude(r) // after the module's own decls, so user names shadow it
  rCheckTypeCycles(r)
  rResolveBodies(r)
  return Module{
    symbols: r.symbols, allNames: r.scopes[r.moduleScope].names, exports: r.exports,
    nodeSymbols: r.nodeSymbols,
  }
}
