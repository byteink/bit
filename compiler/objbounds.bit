// Checked reads for the object readers (#6345). An archive on disk is untrusted
// input: a half-written libbitrt.a or a bad download must fail the build with a
// diagnostic naming the member and the range, never panic the compiler on a slice
// bound. Every offset or size a reader takes from the file goes through
// loCheckRange / loSlice below before it indexes or slices the buffer.

// Whether [off, off+n) lies inside a buffer of `total` bytes. Written so no sum
// can overflow: a u64 field read as an int can be negative or near 2^63, and
// `off + n > total` would then wrap to a passing value.
fn loRangeOk(total: int, off: int, n: int): bool {
  return off >= 0 && n >= 0 && off <= total && n <= total - off
}

// `what` names the field being read ("section header table", "string table").
fn loCheckRange(total: int, off: int, n: int, what: string): ()! {
  if (!loRangeOk(total, off, n)) {
    fail newError("${what}: bytes [${off}, ${off}+${n}) lie outside the ${total}-byte buffer")
  }
}

fn loSlice(b: []u8, off: int, n: int, what: string): []u8! {
  loCheckRange(len(b), off, n, what)?
  return b[off:off + n]
}

// Prefixes a reader's failure with the archive member it came from, so one
// diagnostic names both the member and what was out of range.
fn loMemberError(name: string, msg: string): string {
  return "object ${name}: ${msg}"
}

// The shape every reader hands atomizeModule: validated here, once, so a corrupt
// symbol offset or relocation index becomes an error instead of a slice panic
// deep in atomization. A symbol may sit AT the section end (a zero-size
// trailing symbol) but not past it; a relocation's whole field must lie inside its section.
fn loValidateRaw(
  sections: []LoRawSection, symbols: []LoRawSymbol, relocs: []LoRawReloc,
): ()! {
  let i = 0
  while (i < len(symbols)) {
    let s = symbols[i]
    if (s.section < 0 || s.section >= len(sections)) {
      fail newError("symbol ${s.name}: section index ${s.section} out of range (${len(sections)} sections)")
    }
    if (s.offset < 0 || s.offset > sections[s.section].size) {
      fail newError("symbol ${s.name}: offset ${s.offset} lies outside its ${sections[s.section].size}-byte section ${sections[s.section].name}")
    }
    i = i + 1
  }
  i = 0
  while (i < len(relocs)) {
    loValidateReloc(sections, len(symbols), relocs[i])?
    i = i + 1
  }
}

// The field a relocation patches: 8 bytes for a 64-bit pointer, else one 4-byte
// instruction word or 32-bit field.
fn loRelocWidth(kind: LoRelocKind): int {
  if (kind == LoRelocKind.Abs64) {
    return 8
  }
  return 4
}

fn loValidateReloc(sections: []LoRawSection, nsyms: int, r: LoRawReloc): ()! {
  if (r.section < 0 || r.section >= len(sections)) {
    fail newError("relocation: section index ${r.section} out of range (${len(sections)} sections)")
  }
  let width = loRelocWidth(r.kind)
  if (!loRangeOk(sections[r.section].size, r.offset, width)) {
    fail newError("relocation: ${width} bytes at offset ${r.offset} lie outside its ${sections[r.section].size}-byte section ${sections[r.section].name}")
  }
  if (r.target.kind == LoRawTargetKind.Symbol &&
    (r.target.symbol < 0 || r.target.symbol >= nsyms)) {
    fail newError("relocation: target symbol ${r.target.symbol} out of range (${nsyms} symbols)")
  }
  if (r.target.kind == LoRawTargetKind.SectionOffset &&
    (r.target.section < 0 || r.target.section >= len(sections))) {
    fail newError("relocation: target section ${r.target.section} out of range (${len(sections)} sections)")
  }
}

// A relocation's field must lie inside the ONE atom that owns it: a symbol
// placed mid-field splits an instruction between two atoms, and the linker's
// patch would then write past the owner's bytes.
fn loCheckRelocInAtom(a: LoAtom, intra: int, kind: LoRelocKind): ()! {
  if (!loRangeOk(len(a.data), intra, loRelocWidth(kind))) {
    fail newError("relocation: ${loRelocWidth(kind)} bytes at offset ${intra} straddle the end of atom ${a.name} (${len(a.data)} bytes)")
  }
}
