// Split out of emit.bit (#1503): the ELF object writer — emitElfBlobs,
// emitElfObject and their per-arch relocation mappers. The shared blob/global
// placement helpers stay in emit.bit.

// ---- ELF object emission (#345: the Linux path) ---------------------------

// Emits the arch-independent ELF data — string-pool headers, gc_alloc TypeInfo
// blobs (ABI.md §2.1), and the GC stack-map table — all into `.rodata` with
// abs64 pointer relocations, then declares an undefined extern for every
// referenced-but-undefined symbol (the runtime's bit_rt_* calls). Shared by both
// ELF targets; their only differences (codegen, the entry trampoline, the code
// relocation kinds) are handled by the caller before this runs.
//
// Note the contrast with emitMachoObject above, which puts these blobs in
// WRITABLE __data: Mach-O output is PIE and dyld rebases each pointer at load.
// An ELF link here is non-PIE and static, so the addresses are known at link
// time and the blobs are read-only.
class EmElfBlobs {
  symbols: []ElfSymbol,
  relocs: []ElfRelocation,
}

fn emElfSym(
  name: string, kind: ElfSectionKind, off: int, size: int,
  binding: ElfBinding, sk: ElfSymKind,
): ElfSymbol {
  return ElfSymbol{
    name = name, hasSection = true, section = kind, offset = off,
    size = size, binding = binding, kind = sk,
  }
}

fn emElfAbs64(off: int, sym: string): ElfRelocation {
  return ElfRelocation{
    section = ElfSectionKind.Rodata, offset = off, symbol = sym,
    kind = ElfRelocKind.Abs64, addend = 0,
  }
}

// `gc` is the .bit_gc GC stack-map section (ABI.md §4) — kept separate from
// .rodata because the linker must lay its atoms out contiguously. `dbg` is
// the analogous .bit_dbg debug-info line table (ABI.md §4.2, #3283) — a
// second, independent side table, never merged with `gc`. Each blob kind is
// its own phase (emitelfblobs.bit), threading its symbol/reloc/defined state
// through via that file's EmElfSymAccum — see its own comment.
fn emitElfBlobs(
  module: IrModule, rodata: ByteBuf, gc: ByteBuf, dbg: ByteBuf,
  symbols: []ElfSymbol, relocs: []ElfRelocation, defined: map<string, bool>,
  stackmaps: []FuncStackMap, debugLines: []FuncDebugLines, emittedNames: []string,
  freestanding: bool,
): EmElfBlobs {
  assert(len(emittedNames) == len(stackmaps))
  assert(len(emittedNames) == len(debugLines))
  // #3283: intern every distinct source file the debug-info rows reference
  // BEFORE the string-pool phase runs, so its headers cover them too — see
  // internDebugFiles (compiler/emit.bit).
  let dbgFileSyms = internDebugFiles(module, debugLines)
  // #3662: intern every debug-info entry's own function name the same way —
  // see internDebugNames (compiler/emit.bit).
  let dbgNameSyms = internDebugNames(module, debugLines, emittedNames)
  let blobBinding = ElfBinding.Global
  if (freestanding) {
    blobBinding = ElfBinding.Local
  }

  let acc = EmElfSymAccum{ symbols = symbols, relocs = relocs, defined = defined }
  acc = emitElfStringPool(module, rodata, blobBinding, acc)
  acc = emitElfTypeInfoBlobs(module, rodata, freestanding, acc)
  acc = emitElfGcStackMaps(gc, stackmaps, emittedNames, acc)

  // Extracted to its own function (rather than inlined like the phases
  // above) so this already-oversized function's own complexity doesn't grow
  // further — see emitElfDebugLines' own comment for the section itself.
  let dbgOut = emitElfDebugLines(
    dbg, debugLines, emittedNames, dbgFileSyms,
    dbgNameSyms, acc.symbols, acc.relocs, acc.defined,
  )
  acc = EmElfSymAccum{ symbols = dbgOut.symbols, relocs = dbgOut.relocs, defined = dbgOut.defined }

  acc = emitElfUndefinedExterns(acc)
  return EmElfBlobs{ symbols = acc.symbols, relocs = acc.relocs }
}

// The mutated symbol/reloc/defined-set triple emitElfDebugLines hands back to
// emitElfBlobs, since Bit gives a helper no way to mutate three of its
// caller's locals in place across a call boundary — mirrors EmElfBlobs above.
class EmElfDbgLines {
  symbols: []ElfSymbol,
  relocs: []ElfRelocation,
  defined: map<string, bool>,
}

// Debug-info line table entries (runtime/ABI.md §4.2, #3283/#3662) -> .bit_dbg.
// Same per-member/per-function-local-atom shape as the .bit_gc block in
// emitElfBlobs (see writeDebugLines' own comment), never merged with it. A
// function with zero rows (no source-mapped instruction at all) contributes
// no entry, so dbgResult.funcIndices is not 1:1 with emittedNames by
// position; look the owner up through it.
fn emitElfDebugLines(
  dbg: ByteBuf, debugLines: []FuncDebugLines,
  emittedNames: []string, dbgFileSyms: map<int, int>, dbgNameSyms: map<int, int>,
  symbols: []ElfSymbol, relocs: []ElfRelocation, defined: map<string, bool>,
): EmElfDbgLines {
  let dbgResult = writeDebugLines(dbg, debugLines)
  let dbi = 0
  while (dbi < len(dbgResult.relocOffsets)) {
    let dbOff = dbgResult.relocOffsets[dbi]
    let dbEnd = len(dbg.bytes)
    if (dbi + 1 < len(dbgResult.relocOffsets)) {
      dbEnd = dbgResult.relocOffsets[dbi + 1]
    }
    symbols = append(
      symbols,
      emElfSym(
        "__bitdbg_${dbi}", ElfSectionKind.DbgMeta,
        dbOff, dbEnd - dbOff, ElfBinding.Local, ElfSymKind.Object,
      ),
    )
    defined["__bitdbg_${dbi}"] = true
    let owner = dbgResult.funcIndices[dbi]
    relocs = append(
      relocs,
      ElfRelocation{
        section = ElfSectionKind.DbgMeta,
        offset = dbOff, symbol = emittedNames[owner], kind = ElfRelocKind.Abs64,
        addend = 0,
      },
    )
    // #3662: name_hdr_ptr sits right after the header's original 16 bytes
    // (code_addr/format_version/code_size/num_rows) — one per ENTRY, not one
    // per row — see writeDebugLines.
    relocs = append(
      relocs,
      ElfRelocation{
        section = ElfSectionKind.DbgMeta,
        offset = dbOff + 16, symbol = "__bitstr_${dbgNameSyms[owner]}",
        kind = ElfRelocKind.Abs64, addend = 0,
      },
    )
    // Each row's file_hdr_ptr sits at (24-byte header) + rowIndex*(16-byte
    // row) + 4 (past that row's own pcOffset field) — see writeDebugLines.
    let rows = debugLines[owner].rows
    let ri = 0
    while (ri < len(rows)) {
      relocs = append(
        relocs,
        ElfRelocation{
          section = ElfSectionKind.DbgMeta,
          offset = dbOff + 28 + ri * 16, symbol = "__bitstr_${dbgFileSyms[rows[ri].file]}",
          kind = ElfRelocKind.Abs64, addend = 0,
        },
      )
      ri = ri + 1
    }
    dbi = dbi + 1
  }
  return EmElfDbgLines{ symbols = symbols, relocs = relocs, defined = defined }
}

// x86-64 codegen's Reloc kinds mapped onto the ELF writer's. A `call rel32`'s
// field is measured from its own start, so the -4 bias the encoder assumes is
// carried as the relocation's addend (the seed does exactly this).
fn emElfRelocX64(k: RelocKind): ElfRelocKind {
  if (k == RelocKind.Abs64) {
    return ElfRelocKind.Abs64
  }
  if (k == RelocKind.Tpoff32) {
    return ElfRelocKind.Tpoff32
  }
  assert(k == RelocKind.Branch)
  return ElfRelocKind.Pc32
}

fn emElfAddendX64(k: RelocKind): int {
  if (k == RelocKind.Branch) {
    return -4
  }
  return 0
}

// Each per-arch mapper below asserts its OWN arch's kind set, so the dispatch
// has to happen before the call — evaluating both sides would trip the other
// arch's assert on a kind it never emits.
fn emCompileFor(module: IrModule, f: IrFunc, isX64: bool, debug: bool): FuncCode {
  if (isX64) {
    return xCompileFunction(module, f, XCallConv.SysV, debug)
  }
  // #4316: the non-x64 ELF target is aarch64-linux, whose ARMv8.0-A baseline
  // does not guarantee FEAT_LSE — `arm64HasLse` answers false and the atomics
  // stay on the `ldaxr`/`stlxr` retry loop.
  return compileFunction(module, f, debug, BuildTarget.Aarch64Linux)
}

fn emElfRelocFor(k: RelocKind, isX64: bool): ElfRelocKind {
  if (isX64) {
    return emElfRelocX64(k)
  }
  return emElfRelocArm64(k)
}

fn emElfAddendFor(k: RelocKind, isX64: bool): int {
  if (isX64) {
    return emElfAddendX64(k)
  }
  return 0
}

fn emElfRelocArm64(k: RelocKind): ElfRelocKind {
  if (k == RelocKind.Branch) {
    return ElfRelocKind.Call26
  }
  if (k == RelocKind.Page21) {
    return ElfRelocKind.AdrPrelPgHi21
  }
  if (k == RelocKind.TprelHi12) {
    return ElfRelocKind.TlsleAddTprelHi12
  }
  if (k == RelocKind.TprelLo12) {
    return ElfRelocKind.TlsleAddTprelLo12Nc
  }
  assert(k == RelocKind.PageOff12)
  return ElfRelocKind.AddAbsLo12Nc
}

// Emits `module` as a relocatable ELF object for `target`. One entry point for
// both architectures: the arch-specific parts are the backend, the code
// relocation kinds, and the bit_main trampoline's encoding.
// Driver only (#2450): each phase below (functions, entry trampoline, the
// three globals kinds, blob assembly, section construction) is its own
// function so this one stays under E0201's line limit; the ORDER these calls
// run in is still this driver's own concern — see the comment ahead of the
// data/bss call for why globals must be placed before `emitElfBlobs`.
// `EmElfSymAccum` (compiler/emitelfblobs.bit) already bundles the one state
// every phase but the last two shares (`symbols`/`relocs`/`defined`), so it is
// reused rather than re-invented; `EmElfFuncsResult` and `EmElfSectionInputs`
// below are the two genuinely new bundles this split needs, for the values
// only the function-emission phase or only section construction touch.
fn emitElfObject(
  module: IrModule,
  target: ElfTarget,
  withEntry: bool,
  freestanding: bool,
  debug: bool,
): []u8! {
  let code = newByteBuf()
  let rodata = newByteBuf()
  let gc = newByteBuf()
  let dbg = newByteBuf()
  let isX64 = target == ElfTarget.X86_64
  if (freestanding) {
    refuseManagedMetadata(module)?
    refuseUnpinnedImports(module)?
    refuseImportedGlobalRefs(module)?
  }

  let fr = emElfFuncsToText(module, freestanding, isX64, debug, code)
  let acc = fr.acc
  if (withEntry) {
    acc = emElfAddEntry(code, isX64, fr.mainVoid, fr.haveMain, acc)?
  }

  // ---- module-level state (§11.11) -> writable .data ---------------------
  // Placed BEFORE emitElfBlobs: that call ends with the undefined-extern
  // sweep, which declares an extern for every relocation naming a symbol not
  // yet in `defined`. A global's own load/store relocations name it, so
  // registering these after the sweep emits each cell twice — once undefined,
  // once defined — and the ELF writer rejects that as DuplicateSymbol. The
  // seed's two ELF emitters place globals before the sweep for this reason.
  // §11.11/§17.6 (#1630): a cell is never a pin, so a freestanding object keeps
  // its own module state LOCAL — no sibling may name it, and the mangled name
  // carries a project-local ordinal two builds need not agree on.
  let cellBinding = ElfBinding.Global
  if (definitionIsLocal(freestanding, false)) {
    cellBinding = ElfBinding.Local
  }
  let gdata = newByteBuf()
  let (dbAcc, egs) = emElfGlobalsToDataBss(module, freestanding, cellBinding, gdata, acc)
  acc = dbAcc

  // ---- per-thread state (§11.11) -> the `.tdata` template ----------------
  let tdata = newByteBuf()
  acc = emElfGlobalsToTdata(module, freestanding, cellBinding, tdata, acc)

  // ---- read-only module state (§11.11) -> .rodata ------------------------
  acc = emElfGlobalsToRodata(module, freestanding, cellBinding, rodata, acc)

  let blobs = emitElfBlobs(
    module, rodata, gc, dbg, acc.symbols, acc.relocs, acc.defined,
    fr.stackmaps, fr.debugLines, fr.emittedNames, freestanding,
  )
  acc.symbols = blobs.symbols
  acc.relocs = blobs.relocs

  let si = EmElfSectionInputs{
    code = code, gc = gc, dbg = dbg, rodata = rodata,
    gdata = gdata, egs = egs, tdata = tdata,
  }
  let sections = emElfBuildSections(module, freestanding, si)

  return writeElfObject(
    target,
    ElfObject{
      sections = sections, symbols = acc.symbols,
      relocations = acc.relocs,
    },
  )?
}

// The four values `emElfFuncsToText` produces beyond `code` (which it mutates
// in place, a `ByteBuf` being a reference type): the accumulated symbol
// table/relocations/defined-set, the per-function stack-map and debug-line
// rows `emitElfBlobs` needs later, the emitted function names in the same
// order (also for `emitElfBlobs`), and whether a `main` was seen/is void
// (for the entry trampoline). Cost: one allocation per `emitElfObject` call
// (once per object emitted), same category as `EmElfSymAccum` itself.
class EmElfFuncsResult {
  acc: EmElfSymAccum,
  stackmaps: []FuncStackMap,
  debugLines: []FuncDebugLines,
  emittedNames: []string,
  mainVoid: bool,
  haveMain: bool,
}

// ---- every function -> one .text symbol + its relocations -----------------
fn emElfFuncsToText(
  module: IrModule, freestanding: bool, isX64: bool, debug: bool, code: ByteBuf,
): EmElfFuncsResult {
  let acc = EmElfSymAccum{
    symbols = []ElfSymbol(0),
    relocs = []ElfRelocation(0),
    defined = map<string, bool>{},
  }
  let stackmaps = []FuncStackMap(0)
  let debugLines = []FuncDebugLines(0)
  let emittedNames = []string(0)
  let mainVoid = false
  let haveMain = false
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: an imported module's function belongs to its own object.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    let fc = emCompileFor(module, f, isX64, debug)
    let off = len(code.bytes)
    appendBytes(code, fc.code)
    // §11.9/§17.6 (#1631): a freestanding object exports only its @symbol pins;
    // every other definition is module-private and would otherwise collide with
    // a sibling module's same-named private helper in the archive.
    let fnBinding = ElfBinding.Global
    if (definitionIsLocal(freestanding, f.isPinned)) {
      fnBinding = ElfBinding.Local
    }
    acc.symbols = append(
      acc.symbols,
      emElfSym(
        f.name, ElfSectionKind.Text, off,
        len(fc.code), fnBinding, ElfSymKind.Func,
      ),
    )
    acc.defined[f.name] = true
    let r = 0
    while (r < len(fc.relocs)) {
      acc.relocs = append(
        acc.relocs,
        ElfRelocation{
          section = ElfSectionKind.Text,
          offset = off + fc.relocs[r].offset, symbol = fc.relocs[r].symbol,
          kind = emElfRelocFor(fc.relocs[r].kind, isX64),
          addend = emElfAddendFor(fc.relocs[r].kind, isX64),
        },
      )
      r = r + 1
    }
    stackmaps = append(stackmaps, emStackMapOf(fc))
    debugLines = append(debugLines, emDebugLinesOf(fc))
    emittedNames = append(emittedNames, f.name)
    if (f.name == "main") {
      haveMain = true
      mainVoid = module.ctx.types[f.result].kind == TypeKind.Void
    }
    fi = fi + 1
  }
  return EmElfFuncsResult{
    acc = acc, stackmaps = stackmaps, debugLines = debugLines,
    emittedNames = emittedNames, mainVoid = mainVoid, haveMain = haveMain,
  }
}

// ---- bit_main entry trampoline ---------------------------------------
// The runtime calls bit_main (boot runs it as a green
// thread); a void `main` still owes an exit code, so the trampoline
// supplies 0.
fn emElfAddEntry(
  code: ByteBuf, isX64: bool, mainVoid: bool, haveMain: bool, acc: EmElfSymAccum,
): EmElfSymAccum! {
  if (!haveMain) {
    // Wording shared with emitmacho.bit, defined once in build.bit (#2234).
    fail newError(noMainMessage())
  }
  let tramp = len(code.bytes)
  let callField = 0
  if (isX64) {
    // On entry rsp%16==8 (the call into bit_main pushed a return address); a
    // single `sub rsp,8` re-aligns it so the SysV call below is 16-aligned.
    //   sub rsp,8 ; call main ; [xor eax,eax if void] ; add rsp,8 ; ret
    appendBytes(code, [u8(0x48), u8(0x83), u8(0xEC), u8(0x08)])
    code.bytes = append(code.bytes, u8(0xE8))
    callField = len(code.bytes)
    appendZeros(code, 4)
    acc.relocs = append(
      acc.relocs,
      ElfRelocation{
        section = ElfSectionKind.Text,
        offset = callField, symbol = "main", kind = ElfRelocKind.Pc32, addend = -4,
      },
    )
    if (mainVoid) {
      appendBytes(code, [u8(0x31), u8(0xC0)]) // xor eax, eax
    }
    appendBytes(code, [u8(0x48), u8(0x83), u8(0xC4), u8(0x08), u8(0xC3)])
  } else {
    //   stp x29,x30,[sp,#-16]! ; bl main ; [movz w0,#0 if void] ; ldp ; ret
    emitWord(code, 0xA9BF7BFD)
    callField = len(code.bytes)
    emitWord(code, 0x94000000) // bl main (placeholder)
    acc.relocs = append(
      acc.relocs,
      ElfRelocation{
        section = ElfSectionKind.Text,
        offset = callField, symbol = "main", kind = ElfRelocKind.Call26, addend = 0,
      },
    )
    if (mainVoid) {
      emitWord(code, 0x52800000) // movz w0, #0
    }
    emitWord(code, 0xA8C17BFD) // ldp x29, x30, [sp], #16
    emitWord(code, 0xD65F03C0) // ret
  }
  acc.symbols = append(
    acc.symbols,
    emElfSym(
      "bit_main", ElfSectionKind.Text, tramp,
      len(code.bytes) - tramp, ElfBinding.Global, ElfSymKind.Func,
    ),
  )
  acc.defined["bit_main"] = true
  return acc
}

// #2949: an all-zero cell (the common case for a large scratch buffer, e.g.
// stdlib/http/trustcache.bit's trust-cache buffer) goes to `.bss`
// (SHT_NOBITS), which carries a size in the section header and no file bytes
// at all, instead of writing its full size into `.data`. Returns the updated
// accumulator and `placeGlobals`' own split, which `emElfBuildSections` still
// needs (`egs.bssSize`) once this function's own locals are gone.
fn emElfGlobalsToDataBss(
  module: IrModule, freestanding: bool, cellBinding: ElfBinding, gdata: ByteBuf,
  acc: EmElfSymAccum,
): (EmElfSymAccum, GlobalsSplit) {
  let egs = placeGlobals(module, 0, gdata, freestanding, true)
  let egi = 0
  while (egi < len(egs.data)) {
    acc.symbols = append(
      acc.symbols,
      emElfSym(
        egs.data[egi].name, ElfSectionKind.Data,
        egs.data[egi].offset, egs.data[egi].size, cellBinding, ElfSymKind.Object,
      ),
    )
    acc.defined[egs.data[egi].name] = true
    egi = egi + 1
  }
  let ebi = 0
  while (ebi < len(egs.bss)) {
    acc.symbols = append(
      acc.symbols,
      emElfSym(
        egs.bss[ebi].name, ElfSectionKind.Bss,
        egs.bss[ebi].offset, egs.bss[ebi].size, cellBinding, ElfSymKind.Object,
      ),
    )
    acc.defined[egs.bss[ebi].name] = true
    ebi = ebi + 1
  }
  return (acc, egs)
}

// Every cell goes to `.tdata` even when its image is all zeros, rather than
// splitting zero-valued ones into `.tbss`: the linker merges both into one
// contiguous template anyway, and one section keeps the offsets trivially
// ordered. The symbol is STT_TLS, so its value reads as an offset within
// that template — relative to the thread pointer — not a link-time address.
// `splitZero: false` keeps that guarantee: #2949's bss split is process-wide
// (storage 0) only. Unlike `emElfGlobalsToDataBss`, `placeGlobals`' own split
// result is not needed again after this function returns, so only `acc`
// threads back out.
fn emElfGlobalsToTdata(
  module: IrModule, freestanding: bool, cellBinding: ElfBinding, tdata: ByteBuf,
  acc: EmElfSymAccum,
): EmElfSymAccum {
  let tgs = placeGlobals(module, 1, tdata, freestanding, false)
  let tgi = 0
  while (tgi < len(tgs.data)) {
    acc.symbols = append(
      acc.symbols,
      emElfSym(
        tgs.data[tgi].name, ElfSectionKind.Tdata,
        tgs.data[tgi].offset, tgs.data[tgi].size, cellBinding, ElfSymKind.Tls,
      ),
    )
    acc.defined[tgs.data[tgi].name] = true
    tgi = tgi + 1
  }
  return acc
}

// Placed BEFORE the blobs so a table's own alignment padding is measured from
// the start of the section, not from wherever the string pool happened to end.
// Each name enters `defined` so the undefined-externals sweep does not then
// declare the table an unresolved import.
fn emElfGlobalsToRodata(
  module: IrModule, freestanding: bool, cellBinding: ElfBinding, rodata: ByteBuf,
  acc: EmElfSymAccum,
): EmElfSymAccum {
  let ro = placeReadonlyGlobals(module, rodata, freestanding)
  for rp of ro.placements {
    acc.symbols = append(
      acc.symbols,
      emElfSym(
        rp.name, ElfSectionKind.Rodata,
        rp.offset, rp.size, cellBinding, ElfSymKind.Object,
      ),
    )
    acc.defined[rp.name] = true
  }
  // ELF is RELA: the addend rides in the relocation and the field bytes are
  // ignored, so the authored image is left exactly as written.
  for f of ro.fixups {
    acc.relocs = append(
      acc.relocs,
      ElfRelocation{
        section = ElfSectionKind.Rodata,
        offset = f.offset, symbol = f.symbol, kind = ElfRelocKind.Abs64,
        addend = f.addend,
      },
    )
  }
  return acc
}

// The byte buffers and placement results `emElfBuildSections` reads —
// bundled because that function alone would otherwise need 7 parameters
// (module and freestanding make 9) against the 5-param ceiling. Every field
// is read-only there; none is grown or mutated. Cost: one allocation per
// `emitElfObject` call, same category as the two classes above.
class EmElfSectionInputs {
  code: ByteBuf,
  gc: ByteBuf,
  dbg: ByteBuf,
  rodata: ByteBuf,
  gdata: ByteBuf,
  egs: GlobalsSplit,
  tdata: ByteBuf,
}

fn emElfBuildSections(module: IrModule, freestanding: bool, si: EmElfSectionInputs): []ElfSection {
  let sections = [
    ElfSection{
      kind = ElfSectionKind.Text, data = si.code.bytes,
      size = 0, alignment = 16,
    },
  ]
  if (len(si.gc.bytes) > 0) {
    // 8-aligned (#1927): `writeStackMaps` pads every entry to a multiple of 8,
    // so every atom's length is already a multiple of 8 and the linker never
    // needs to insert padding of its own to honor this; there is no gap for
    // the walk to misread as an entry.
    sections = append(
      sections,
      ElfSection{
        kind = ElfSectionKind.GcMeta,
        data = si.gc.bytes, size = 0, alignment = 8,
      },
    )
  }
  if (len(si.dbg.bytes) > 0) {
    // 8-aligned: writeDebugLines' 24-byte header and 16-byte rows are
    // already multiples of 8, so this needs no padding step either.
    sections = append(
      sections,
      ElfSection{
        kind = ElfSectionKind.DbgMeta,
        data = si.dbg.bytes, size = 0, alignment = 8,
      },
    )
  }
  if (len(si.rodata.bytes) > 0) {
    sections = append(
      sections,
      ElfSection{
        kind = ElfSectionKind.Rodata,
        data = si.rodata.bytes, size = 0,
        alignment = globalsAlign(module, storageReadonly(), freestanding),
      },
    )
  }
  if (len(si.gdata.bytes) > 0) {
    sections = append(
      sections,
      ElfSection{
        kind = ElfSectionKind.Data,
        data = si.gdata.bytes, size = 0, alignment = globalsAlign(module, 0, freestanding),
      },
    )
  }
  if (si.egs.bssSize > 0) {
    // No `data` bytes at all — elfSectionBytes reads `size` for Bss.
    sections = append(
      sections,
      ElfSection{
        kind = ElfSectionKind.Bss,
        data = []u8(0), size = si.egs.bssSize, alignment = globalsAlignBss(module, 0, freestanding),
      },
    )
  }
  if (len(si.tdata.bytes) > 0) {
    sections = append(
      sections,
      ElfSection{
        kind = ElfSectionKind.Tdata,
        data = si.tdata.bytes, size = 0, alignment = globalsAlign(module, 1, freestanding),
      },
    )
  }
  return sections
}
