// compiler/checkormquery.bit — pkg/orm's `Repo<T>`/`TxRepo<T>` chain
// (#5057, #6271; #6296 retired the old `find<T>`/`update<T>`/`deleteMany<T>`
// root walk this file used to also check): the compile-time literal-column
// check.
//
// SECURITY IS THE POINT (#5057's own label). `Repo<T>.where("emial",
// x)`-style calls take a Bit FIELD NAME; `pkg/orm/repo.bit`'s runtime
// `columnFor` defers the identical check onto the chain's own error when it
// is wrong, but a mistyped STRING LITERAL is the mistake people actually
// make, and it costs nothing to catch here instead — the owner's reasoning
// for this ticket.
//
// A READ-ONLY PASS, UNLIKE #5054's OWN `checksqlrow.bit`/
// `checksqlrowbuild.bit`. Those rewrite a call site into a different one
// (`find<T>` into `sqlFindMany`, with a synthesized mapper); THIS file only
// walks already-parsed syntax and reports a diagnostic; it never mutates a
// tree, which is what keeps it safe to run from `resolveProject` without
// the "before any Checker exists" ordering #5054's own passes depend on.
//
// THE SHAPE IT CHECKS. `pkg/orm/db.bit`'s `db.table<T>()`/`tx.table<T>()`
// is the one root a chain may bottom out at (`ormChainRoot`'s `table` arm),
// gated on the whole module importing "orm" at all (`ormModuleImportsOrm`)
// rather than a bound import name, since `table` is a METHOD, not a name an
// `import` statement binds. For every `.where`/`.orderBy`/`.set`/`.with`
// call anywhere in such a module, `ormChainRoot` walks its RECEIVER back
// through zero or more OTHER `Repo<T>`-returning method calls
// (`ormChainMethodNames`) to see whether it bottoms out, syntactically, at
// a `db.table<T>()`/`tx.table<T>()` call. When it does, and the call's own
// first argument is a STRING LITERAL, that text is checked against `T`'s
// declared field names — `.with("orders")`'s argument by the same rule,
// since a relation is a declared field of `T` like any other (#5061).
//
// THIS IS DELIBERATELY SYNTACTIC, NOT TYPE-BASED, AND DELIBERATELY NARROWER
// THAN THE RUNTIME CHECK. A column reached any other way — held in a
// variable, passed through a function, or chained off a `Repo<T>` value
// that this walk cannot trace back to its own `db.table<T>()` root — is
// simply not flagged here. It is never silently accepted either:
// `Repo<T>.columnFor` (pkg/orm/reposql.bit) performs the identical
// existence check at RUNTIME on every call, literal-chained or not,
// deferring onto the chain's own error. A dynamic column can never reach
// SQL text unchecked either way — see that file's header for the
// placeholder-only guarantee this check is layered on top of.

// E0163 (#5057): a string-literal column argument to
// `where`/`whereIn`/`whereNull`/`whereLike`/`orderBy`, chained directly off
// a `find<T>(...)` call, names no field `T` declares.
const ecOrmBadColumn = 163

// E0181 (#6293): a `.after(...)` call chained off a `db.table<T>()`/
// `find<T>(...)` root with no `.orderBy(...)` call anywhere earlier in the
// same syntactic chain — the compile-time half of `keysetPredicateForRepo`'s
// (pkg/orm/keyset.bit) `KeysetCause.NoOrderBy` refusal, deferred onto
// `Repo<T>.errText` at runtime (`pkg/orm/repo.bit`'s own `after()`) for a
// chain this syntactic walk cannot see through.
const ecOrmAfterNoOrderBy = 181

// E0182 (#6293): the FIRST `.orderBy(...)` call in an `.after(...)`
// chain names its column as a string literal, and that column carries
// neither `@id` nor `@unique` (nor is it the bare `id` default,
// `classtabledefaultid.bit`) — the compile-time half of
// `keysetPredicateForRepo`'s `KeysetCause.NotUnique` refusal.
const ecOrmAfterNotUnique = 182

const ormModulePath = "orm"

// `db.table<T>()`/`tx.table<T>()` (#6271, `pkg/orm/db.bit`): the one root a
// chain can bottom out at (#6296 retired the other roots, `find<T>`/
// `update<T>`/`deleteMany<T>`, along with `pkg/orm`'s own `Query<T>`/
// `Patch<T>`/`DeletePatch<T>`). It is a METHOD, not a name one `import`
// statement binds, so `ormModuleImportsOrm` (module imports "orm" at all)
// is the gate this file's own header already accepts the false-positive
// cost of for `ormPathMatches`.
const ormTableMethodName = "table"

// Whether an import's own path text names `pkg/orm`: either the bare
// registry name ("orm", the only spelling any RELEASED code can use — a
// package is always imported by name, never a filesystem path, once it has
// a `bit.lock` entry) or a path ending "/orm" (a same-repo relative import,
// the only spelling that resolves TODAY: pkg/orm carries no manifest yet,
// so `bit add` — and therefore a bare `"orm"` import from outside this repo
// — has nothing to resolve against; `_tests_/bit/checkercases/
// check_orm_bad_column.bit`, this feature's own proof, uses the relative
// form for exactly that reason). Checked by SUFFIX rather than walking the
// filesystem to resolve it: this pass runs before any Checker exists, the
// same reason `sqlRowCallEntry` (checksqlrow.bit) matches by import rather
// than bare spelling — a user's own unrelated "orm"-suffixed path is not
// realistically also exporting a generic `find<T>` some other class's
// literal columns get checked against, and the cost of that false positive
// is a diagnostic, never a miscompile (this pass never rewrites a tree).
fn ormPathMatches(path: string): bool {
  if (path == ormModulePath) {
    return true
  }
  let suffix = "/" + ormModulePath
  let n = len(path)
  let sn = len(suffix)
  return n >= sn && path[n - sn:n] == suffix
}

// Whether the module imports "orm" at all — the
// gate for the whole per-module sweep now that a `Repo<T>` chain can root at
// `db.table<T>()` (a method, never itself an import binding). Strictly more
// general than "any of find/update/deleteMany bound" (every binding in `b`
// comes from an import this same function would also match), so it replaces
// that check rather than adding to it.
fn ormModuleImportsOrm(tree: Tree, source: string): bool {
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(tree, d)
    if (ormPathMatches(stringLitText(source, getNode(tree, k[1]).span))) {
      return true
    }
  }
  return false
}

// The `Repo<T>`/`TxRepo<T>`-returning method names a chain may pass through
// on its way back to its root call — every `pkg/orm/repo.bit` chain method
// that returns `this`, including the two that take no column
// (`limit`/`offset`).
fn ormChainMethodNames(): []string {
  return ["where", "orderBy", "limit", "offset", "set", "with"]
}

// The four methods THIS file validates a literal first argument of — every
// `pkg/orm/repo.bit` chain method whose first parameter names a field of
// `T`. `with`'s argument is a relation name rather than a column, but a
// relation name is still one of `T`'s declared field names (#5061's owner
// decision — the attribute lives on the relation field itself), so it is
// checked against the identical `ormClassFieldNames` list.
fn ormColumnMethodNames(): []string {
  return ["where", "orderBy", "set", "with"]
}

// `Repo<T>.link`/`unlink` (#6275/#6277, pkg/orm/repo.bit's own "// relations"
// block): TERMINAL calls, never chain-returning (so never in
// `ormChainMethodNames`), and their relation-name argument is the SECOND
// positional one — `v: T` is the first (`ormSecondArgExpr`, below) — so
// they need their own check rather than reusing `checkOrmColumnCall`'s
// first-argument one. A `link`/`unlink` target must be a many-to-many
// relation specifically, never any relation field `with` accepts, so it is
// checked against `ormManyToManyFieldNames`, not `ormClassFieldNames`.
fn ormLinkMethodNames(): []string {
  return ["link", "unlink"]
}

fn ormNameIn(name: string, names: []string): bool {
  for n of names {
    if (n == name) {
      return true
    }
  }
  return false
}

// Walks `expr` back through a chain of `Repo<T>`-returning method calls to
// the `db.table<T>()`/`tx.table<T>()` call node it is syntactically rooted
// at, or 0 when `expr` is not (directly) such a chain — see this file's
// header for what falls back to the runtime check instead. Bounded at 64
// links: a fluent chain that long is not something a person writes by hand.
fn ormChainRoot(tree: Tree, source: string, expr: int): int {
  let cur = expr
  let guard = 0
  while (guard < 64) {
    guard = guard + 1
    if (getNode(tree, cur).tag != Tag.Call) {
      return 0
    }
    let callee = kidsOf(tree, cur)[0]
    if (getNode(tree, callee).tag != Tag.Member) {
      return 0
    }
    let mk = kidsOf(tree, callee)
    let mname = identText(tree, source, mk[1])
    // `db.table<T>()`/`tx.table<T>()`: the root (#6271) — reachable at all
    // only because `checkOrmFindColumnsInModule`'s own gate already proved
    // this module imports "orm".
    if (mname == ormTableMethodName) {
      return cur
    }
    if (!ormNameIn(mname, ormChainMethodNames())) {
      return 0
    }
    cur = mk[0]
  }
  return 0
}

// `callNode`'s type argument, resolved to the class `T` names — `sqlClassSiteOf`
// (checksqlrow.bit) is general-purpose (any class name reachable from `mid`,
// local or imported by name), not std/sql-specific despite the file it lives
// in.
fn ormFindCallClassSite(p: Project, mid: int, m: SrcModule, callNode: int): SqlClassSite {
  let targ = sqlRowTypeArg(m.tree, callNode)
  if (targ == 0 || getNode(m.tree, targ).tag != Tag.Ident) {
    return sqlClassSiteMiss()
  }
  return sqlClassSiteOf(p, mid, identText(m.tree, m.source, targ))
}

// `decl`'s own field names, in declaration order — existence only, no type
// classification: this check does not care what a field's type is, only
// whether a literal string names one.
fn ormClassFieldNames(target: SrcModule, decl: int): []string {
  let out = []string(0)
  for m0 of kidsOf(target.tree, kidsOf(target.tree, decl)[2]) {
    let f = memberField(target.tree, m0)
    if (f == 0) {
      continue
    }
    out = append(out, identText(target.tree, target.source, kidsOf(target.tree, f)[0]))
  }
  return out
}

// `decl`'s own `@manyToMany` field names — `link`/`unlink`'s own narrower
// version of `ormClassFieldNames`: matched by attribute NAME off the raw
// AST the same way `compiler/classtablerelation.bit`'s
// `tableManyToManyFieldsOf` reads it (`@manyToMany` is not in
// `classrelationattr.bit`'s `attrNameIsRelation`, manytomany.bit's own
// header).
fn ormManyToManyFieldNames(target: SrcModule, decl: int): []string {
  let out = []string(0)
  for m0 of kidsOf(target.tree, kidsOf(target.tree, decl)[2]) {
    let f = memberField(target.tree, m0)
    if (f == 0) {
      continue
    }
    for a of fieldAttrs(target.tree, f) {
      if (identText(target.tree, target.source, kidsOf(target.tree, a)[0]) == classAttrManyToMany) {
        out = append(out, identText(target.tree, target.source, kidsOf(target.tree, f)[0]))
      }
    }
  }
  return out
}

// `callNode`'s own first argument expression, or 0 when it has none — the
// argument arity mismatch case is left to the checker's own diagnostic
// against `Query<T>`'s method signatures, same as `resolveSqlRowCall`'s own
// precedent.
fn ormFirstArgExpr(tree: Tree, callNode: int): int {
  let args = kidsOf(tree, kidsOf(tree, callNode)[2])
  if (len(args) == 0) {
    return 0
  }
  return kidsOf(tree, args[0])[0]
}

// `callNode`'s own SECOND argument expression, or 0 when it has fewer than
// two — `link`/`unlink`'s own counterpart of `ormFirstArgExpr`: `v: T` is
// their first argument, the relation name their second.
fn ormSecondArgExpr(tree: Tree, callNode: int): int {
  let args = kidsOf(tree, kidsOf(tree, callNode)[2])
  if (len(args) < 2) {
    return 0
  }
  return kidsOf(tree, args[1])[0]
}

// The FIRST `.orderBy(...)` call's own column, walking from `expr` (an
// `.after(...)` call's own receiver) back to `root` (its chain's own
// `find<T>(...)`/`db.table<T>()` call, already proven reachable by
// `ormChainRoot`) — `present` is false when no `.orderBy` appears in the
// chain at all; `literal` is false when the nearest-root `.orderBy`'s own
// first argument is not a string literal (a dynamic column, deferred to
// the runtime check the same way `checkOrmColumnCall` already defers one).
// Walks the identical path `ormChainRoot` already validated, so every
// step's callee is `Tag.Member` until `cur` reaches `root`.
class OrmOrderByInfo { present: bool, literal: bool, col: string }

fn ormFirstOrderByBeforeCall(tree: Tree, source: string, expr: int, root: int): OrmOrderByInfo {
  let cur = expr
  let present = false
  let literal = false
  let col = ""
  let guard = 0
  while (cur != root && guard < 64) {
    guard = guard + 1
    let mk = kidsOf(tree, kidsOf(tree, cur)[0])
    if (identText(tree, source, mk[1]) == "orderBy") {
      present = true
      let argNode = ormFirstArgExpr(tree, cur)
      literal = argNode != 0 && getNode(tree, argNode).tag == Tag.StringLit
      col = ""
      if (literal) {
        col = stringLitText(source, getNode(tree, argNode).span)
      }
    }
    cur = mk[0]
  }
  return OrmOrderByInfo{ present = present, literal = literal, col = col }
}

// Whether field `f` carries `@id` or `@unique` explicitly — split out of
// `ormUniqueFieldNames` to keep its loop body a single call (LINT.md
// max-complexity), the same shape `ormManyToManyFieldNames`'s own inner
// loop already is.
fn ormFieldIsMarkedUnique(tree: Tree, source: string, f: int): bool {
  for a of fieldAttrs(tree, f) {
    let an = identText(tree, source, kidsOf(tree, a)[0])
    if (an == "id" || an == "unique") {
      return true
    }
  }
  return false
}

// `decl`'s own field names that make an `after()` sort column unambiguous
// — every field carrying `@id`/`@unique` explicitly, plus (only when NO
// field carries `@id` explicitly) the bare field literally named `id`,
// mirroring `classtabledefaultid.bit`'s own default exactly — the
// identical answer `keysetIsUnique` (pkg/orm/keyset.bit) gives at runtime.
// `ormRepoExplicitIdCount` (checkormrepokey.bit, this module's own
// sibling, SPEC §17.1) is reused rather than re-derived.
fn ormUniqueFieldNames(target: SrcModule, decl: int): []string {
  let members = kidsOf(target.tree, kidsOf(target.tree, decl)[2])
  let hasExplicitId = ormRepoExplicitIdCount(target.tree, target.source, decl) > 0
  let out = []string(0)
  for m0 of members {
    let f = memberField(target.tree, m0)
    if (f == 0) {
      continue
    }
    let name = identText(target.tree, target.source, kidsOf(target.tree, f)[0])
    let isDefaultId = !hasExplicitId && name == "id"
    if (ormFieldIsMarkedUnique(target.tree, target.source, f) || isDefaultId) {
      out = append(out, name)
    }
  }
  return out
}

fn reportOrmAfterNoOrderBy(p: Project, m: SrcModule, nameNode: int, className: string) {
  report(
    p.diags, ecOrmAfterNoOrderBy, getNode(m.tree, nameNode).span,
    "after() on '${className}' has no orderBy() earlier in the chain",
    "keyset pagination needs a deterministic order to compare the cursor against — call orderBy(...) before after(...) in this chain, or build the column from a non-literal expression to fall back to the runtime check",
  )
}

fn reportOrmAfterNotUnique(
  p: Project,
  m: SrcModule,
  nameNode: int,
  column: string,
  className: string,
) {
  report(
    p.diags, ecOrmAfterNotUnique, getNode(m.tree, nameNode).span,
    "after() on '${className}' orders by '${column}', which is neither @id nor @unique",
    "the page boundary would be ambiguous, silently skipping or repeating rows — order by a unique column instead",
  )
}

// One candidate call: `.after(key)`, chained off a `db.table<T>()`/
// `find<T>(...)` this module binds (#6293) — the compile-time backstop for
// `keysetPredicateForRepo`'s (pkg/orm/keyset.bit) two runtime refusals: no
// `.orderBy(...)` anywhere earlier in the chain, or the FIRST one's own
// literal column carrying neither `@id` nor `@unique`. Mirrors
// `checkOrmColumnCall`'s own receiver walk; only flags what the walk can
// see — a dynamic `.orderBy(colVar)`, or a chain this syntactic walk
// cannot trace back to its own root, defers to the runtime check.
fn checkOrmAfterCall(p: Project, mid: int, callNode: int) {
  let m = p.mods[mid]
  let callee = kidsOf(m.tree, callNode)[0]
  if (getNode(m.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(m.tree, callee)
  if (identText(m.tree, m.source, mk[1]) != "after") {
    return
  }
  let root = ormChainRoot(m.tree, m.source, mk[0])
  if (root == 0) {
    return
  }
  let site = ormFindCallClassSite(p, mid, m, root)
  if (!site.found) {
    return
  }
  let ob = ormFirstOrderByBeforeCall(m.tree, m.source, mk[0], root)
  if (!ob.present) {
    reportOrmAfterNoOrderBy(p, m, mk[1], site.name)
    return
  }
  if (!ob.literal) {
    return
  }
  if (!ormNameIn(ob.col, ormUniqueFieldNames(p.mods[site.mod], site.decl))) {
    reportOrmAfterNotUnique(p, m, mk[1], ob.col, site.name)
  }
}

fn reportOrmBadColumn(p: Project, m: SrcModule, argNode: int, field: string, className: string) {
  report(
    p.diags, ecOrmBadColumn, getNode(m.tree, argNode).span,
    "'${field}' is not a field of '${className}'",
    "this chain checks a string-literal column against the class its root call named — use one of '${className}'s declared field names, or build the column from a non-literal expression to fall back to the runtime check",
  )
}

// One candidate call: `.where`/`.whereIn`/`.whereNull`/`.whereLike`/
// `.orderBy`, chained off a `find<T>(...)` this module binds, with a
// string-literal first argument that names no field of `T`.
fn checkOrmColumnCall(p: Project, mid: int, callNode: int) {
  let m = p.mods[mid]
  let callee = kidsOf(m.tree, callNode)[0]
  if (getNode(m.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(m.tree, callee)
  if (!ormNameIn(identText(m.tree, m.source, mk[1]), ormColumnMethodNames())) {
    return
  }
  let root = ormChainRoot(m.tree, m.source, mk[0])
  if (root == 0) {
    return
  }
  let site = ormFindCallClassSite(p, mid, m, root)
  if (!site.found) {
    return
  }
  let argNode = ormFirstArgExpr(m.tree, callNode)
  if (argNode == 0 || getNode(m.tree, argNode).tag != Tag.StringLit) {
    return
  }
  let field = stringLitText(m.source, getNode(m.tree, argNode).span)
  if (!ormNameIn(field, ormClassFieldNames(p.mods[site.mod], site.decl))) {
    reportOrmBadColumn(p, m, argNode, field, site.name)
  }
}

// One candidate call: `.link`/`.unlink`, chained off a `db.table<T>()`
// (or `find<T>(...)`) root, with a string-literal SECOND argument that
// names no `@manyToMany` field of `T` — `checkOrmColumnCall`'s own shape,
// with the receiver walk reused unchanged and only the argument index and
// the field list this file's header explains swapped.
fn checkOrmLinkCall(p: Project, mid: int, callNode: int) {
  let m = p.mods[mid]
  let callee = kidsOf(m.tree, callNode)[0]
  if (getNode(m.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(m.tree, callee)
  if (!ormNameIn(identText(m.tree, m.source, mk[1]), ormLinkMethodNames())) {
    return
  }
  let root = ormChainRoot(m.tree, m.source, mk[0])
  if (root == 0) {
    return
  }
  let site = ormFindCallClassSite(p, mid, m, root)
  if (!site.found) {
    return
  }
  let argNode = ormSecondArgExpr(m.tree, callNode)
  if (argNode == 0 || getNode(m.tree, argNode).tag != Tag.StringLit) {
    return
  }
  let field = stringLitText(m.source, getNode(m.tree, argNode).span)
  if (!ormNameIn(field, ormManyToManyFieldNames(p.mods[site.mod], site.decl))) {
    reportOrmBadColumn(p, m, argNode, field, site.name)
  }
}

fn checkOrmFindColumnsInModule(p: Project, mid: int) {
  let m = p.mods[mid]
  if (!ormModuleImportsOrm(m.tree, m.source)) {
    return
  }
  let i = 1
  while (i < len(m.tree.nodes)) {
    if (getNode(m.tree, i).tag == Tag.Call) {
      checkOrmColumnCall(p, mid, i)
      checkOrmLinkCall(p, mid, i)
      checkOrmAfterCall(p, mid, i)
    }
    i = i + 1
  }
}

// Every `pkg/orm` `Repo<T>` chain call in the project, checked. Called from
// `resolveProject` (checkproject.bit) right after `injectSynthMembers` —
// after synthesis, so a synthesized import cannot hide a module's own "orm"
// import from `ormModuleImportsOrm`, and this reports nothing that mutates
// a tree, so ordering relative to resolve/check does not otherwise matter.
// Spans are
// MODULE-GLOBAL at this point exactly as `injectSynthMembers`'s own are
// (synthtext.bit), so the identical `remapDiags` call has to follow each
// module's pass — without it a diagnostic renders against file 0 (a real
// symptom hit and fixed while proving this file: an E0163 rendered at
// `stdlib/core/core.bit:7`, the checked module's file 0, instead of the
// checkercase fixture that actually named the bad column).
fn checkOrmFindColumns(p: Project) {
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    checkOrmFindColumnsInModule(p, i)
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
}
