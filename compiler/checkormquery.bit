// compiler/checkormquery.bit — pkg/orm's find chain (#5057): the
// compile-time literal-column check.
//
// SECURITY IS THE POINT (#5057's own label). `Query<T>.where("emial",
// x)`-style calls take a Bit FIELD NAME; `pkg/orm/query.bit`'s runtime
// `columnFor` panics naming the field and class when it is wrong, but a
// mistyped STRING LITERAL is the mistake people actually make, and it costs
// nothing to catch here instead — the owner's reasoning for this ticket.
//
// A READ-ONLY PASS, UNLIKE #5054's OWN `checksqlrow.bit`/
// `checksqlrowbuild.bit`. Those rewrite a call site into a different one
// (`find<T>` into `sqlFindMany`, with a synthesized mapper); reusing that
// machinery for `pkg/orm`'s own `find<T>` (`pkg/orm/query.bit`) would need
// the same rewrite depth — see that file's header for the reuse surface and
// why it is not attempted this wave. THIS file only walks already-parsed
// syntax and reports a diagnostic; it never mutates a tree, which is what
// keeps it safe to run from `resolveProject` without the "before any
// Checker exists" ordering #5054's own passes depend on.
//
// THE SHAPE IT CHECKS. `pkg/orm/query.bit`'s `find<T>(db, table, fields,
// mapper)` is `checksqlrow.bit`'s own free-function-with-an-explicit-type-
// argument shape, imported from module "orm" (checked by NAME, never bare
// spelling — a user's own `find` is a different function, same rule
// `sqlRowCallEntry` takes). For every `.where`/`.whereIn`/`.whereNull`/
// `.whereLike`/`.orderBy` call anywhere in the module, `ormChainRoot` walks
// its RECEIVER back through zero or more OTHER `Query<T>`-returning method
// calls (`ormChainMethodNames`) to see whether it bottoms out, syntactically,
// at a `find<T>(...)` call bound to that import. When it does, and the
// call's own first argument is a STRING LITERAL, that text is checked
// against `T`'s declared field names.
//
// THIS IS DELIBERATELY SYNTACTIC, NOT TYPE-BASED, AND DELIBERATELY NARROWER
// THAN THE RUNTIME CHECK. A column reached any other way — held in a
// variable, passed through a function, or chained off a `Query<T>` value
// that this walk cannot trace back to its own `find<T>(...)` root (the
// ticket's own composition example, `let q = find<T>(...).where(...); ...;
// q = q.whereLike(...)`, is exactly this: `q`'s SECOND use is not part of
// the syntactic chain this file walks) — is simply not flagged here. It is
// never silently accepted either: `Query.columnFor` (pkg/orm/query.bit)
// performs the identical existence check at RUNTIME on every call,
// literal-chained or not, and panics naming the field and class. A dynamic
// column can never reach SQL text unchecked either way — see that file's
// header for the placeholder-only guarantee this check is layered on top of.

// E0163 (#5057): a string-literal column argument to
// `where`/`whereIn`/`whereNull`/`whereLike`/`orderBy`, chained directly off
// a `find<T>(...)` call, names no field `T` declares.
const ecOrmBadColumn = 163

const ormModulePath = "orm"
const ormFindFuncName = "find"

// Whether an import's own path text names `pkg/orm`: either the bare
// registry name ("orm", the only spelling any RELEASED code can use — a
// package is always imported by name, never a filesystem path, once it has
// a `bit.lock` entry) or a path ending "/orm" (a same-repo relative import,
// the only spelling that resolves TODAY: pkg/orm carries no manifest yet,
// so `bit add` — and therefore a bare `"orm"` import from outside this repo
// — has nothing to resolve against; `_tests_/bit/checkercases/
// check_orm_bad_column.bit`, this feature's own proof, uses the relative
// form for exactly that reason). Checked by SUFFIX rather than walking the
// filesystem to resolve it: this pass runs before any Checker exists, the
// same reason `sqlRowCallEntry` (checksqlrow.bit) matches by import rather
// than bare spelling — a user's own unrelated "orm"-suffixed path is not
// realistically also exporting a generic `find<T>` some other class's
// literal columns get checked against, and the cost of that false positive
// is a diagnostic, never a miscompile (this pass never rewrites a tree).
fn ormPathMatches(path: string): bool {
  if (path == ormModulePath) {
    return true
  }
  let suffix = "/" + ormModulePath
  let n = len(path)
  let sn = len(suffix)
  return n >= sn && path[n - sn:n] == suffix
}

// The local name `T`'s find chain (module "orm") binds `find` to in one
// module, or "" when this module never imports it — mirrors
// `sqlRowBindingsOf` (checksqlrow.bit), one name instead of three.
class OrmFindBinding { find: string }

fn ormFindBindingOf(tree: Tree, source: string): OrmFindBinding {
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(tree, d)
    if (!ormPathMatches(stringLitText(source, getNode(tree, k[1]).span))) {
      continue
    }
    if (getNode(tree, k[0]).tag != Tag.ImportGroup) {
      continue
    }
    let bound = ormFindBindingInGroup(tree, source, k[0])
    if (bound != "") {
      return OrmFindBinding{ find: bound }
    }
  }
  return OrmFindBinding{ find: "" }
}

// The local name `find` is bound to inside one `{ a, b as c }` import group,
// or "" when that group does not import it — split out of
// `ormFindBindingOf` to keep its loop body a single call (LINT.md
// max-complexity).
fn ormFindBindingInGroup(tree: Tree, source: string, group: int): string {
  for item of kidsOf(tree, group) {
    if (identText(tree, source, kidsOf(tree, item)[0]) == ormFindFuncName) {
      return importItemLocalName(tree, source, item)
    }
  }
  return ""
}

// The `Query<T>`-returning method names a chain may pass through on its way
// back to `find<T>(...)` — every method `pkg/orm/query.bit` declares that
// returns `this`, including the two that take no column (`limit`/`offset`).
fn ormChainMethodNames(): []string {
  return ["where", "whereIn", "whereNull", "whereLike", "orderBy", "limit", "offset"]
}

// The five methods THIS file validates a literal first argument of — every
// `pkg/orm/query.bit` method whose first parameter is a column name.
fn ormColumnMethodNames(): []string {
  return ["where", "whereIn", "whereNull", "whereLike", "orderBy"]
}

fn ormNameIn(name: string, names: []string): bool {
  for n of names {
    if (n == name) {
      return true
    }
  }
  return false
}

// Walks `expr` back through a chain of `Query<T>`-returning method calls to
// the `find<T>(...)` call node it is syntactically rooted at, or 0 when
// `expr` is not (directly) such a chain — see this file's header for what
// falls back to the runtime check instead. Bounded at 64 links: a fluent
// chain that long is not something a person writes by hand.
fn ormChainRoot(tree: Tree, source: string, b: OrmFindBinding, expr: int): int {
  let cur = expr
  let guard = 0
  while (guard < 64) {
    guard = guard + 1
    if (getNode(tree, cur).tag != Tag.Call) {
      return 0
    }
    let callee = kidsOf(tree, cur)[0]
    if (getNode(tree, callee).tag == Tag.Ident) {
      if (b.find != "" && identText(tree, source, callee) == b.find) {
        return cur
      }
      return 0
    }
    if (getNode(tree, callee).tag != Tag.Member) {
      return 0
    }
    let mk = kidsOf(tree, callee)
    if (!ormNameIn(identText(tree, source, mk[1]), ormChainMethodNames())) {
      return 0
    }
    cur = mk[0]
  }
  return 0
}

// `callNode`'s type argument, resolved to the class `T` names — `sqlClassSiteOf`
// (checksqlrow.bit) is general-purpose (any class name reachable from `mid`,
// local or imported by name), not std/sql-specific despite the file it lives
// in.
fn ormFindCallClassSite(p: Project, mid: int, m: SrcModule, callNode: int): SqlClassSite {
  let targ = sqlRowTypeArg(m.tree, callNode)
  if (targ == 0 || getNode(m.tree, targ).tag != Tag.Ident) {
    return sqlClassSiteMiss()
  }
  return sqlClassSiteOf(p, mid, identText(m.tree, m.source, targ))
}

// `decl`'s own field names, in declaration order — existence only, no type
// classification: this check does not care what a field's type is, only
// whether a literal string names one.
fn ormClassFieldNames(target: SrcModule, decl: int): []string {
  let out = []string(0)
  for m0 of kidsOf(target.tree, kidsOf(target.tree, decl)[2]) {
    let f = memberField(target.tree, m0)
    if (f == 0) {
      continue
    }
    out = append(out, identText(target.tree, target.source, kidsOf(target.tree, f)[0]))
  }
  return out
}

// `callNode`'s own first argument expression, or 0 when it has none — the
// argument arity mismatch case is left to the checker's own diagnostic
// against `Query<T>`'s method signatures, same as `resolveSqlRowCall`'s own
// precedent.
fn ormFirstArgExpr(tree: Tree, callNode: int): int {
  let args = kidsOf(tree, kidsOf(tree, callNode)[2])
  if (len(args) == 0) {
    return 0
  }
  return kidsOf(tree, args[0])[0]
}

fn reportOrmBadColumn(p: Project, m: SrcModule, argNode: int, field: string, className: string) {
  report(
    p.diags, ecOrmBadColumn, getNode(m.tree, argNode).span,
    "'${field}' is not a field of '${className}'",
    "the find chain checks a string-literal column against the class 'find<T>' named — use one of '${className}'s declared field names, or build the column from a non-literal expression to fall back to the runtime check",
  )
}

// One candidate call: `.where`/`.whereIn`/`.whereNull`/`.whereLike`/
// `.orderBy`, chained off a `find<T>(...)` this module binds, with a
// string-literal first argument that names no field of `T`.
fn checkOrmColumnCall(p: Project, mid: int, b: OrmFindBinding, callNode: int) {
  let m = p.mods[mid]
  let callee = kidsOf(m.tree, callNode)[0]
  if (getNode(m.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(m.tree, callee)
  if (!ormNameIn(identText(m.tree, m.source, mk[1]), ormColumnMethodNames())) {
    return
  }
  let root = ormChainRoot(m.tree, m.source, b, mk[0])
  if (root == 0) {
    return
  }
  let site = ormFindCallClassSite(p, mid, m, root)
  if (!site.found) {
    return
  }
  let argNode = ormFirstArgExpr(m.tree, callNode)
  if (argNode == 0 || getNode(m.tree, argNode).tag != Tag.StringLit) {
    return
  }
  let field = stringLitText(m.source, getNode(m.tree, argNode).span)
  if (!ormNameIn(field, ormClassFieldNames(p.mods[site.mod], site.decl))) {
    reportOrmBadColumn(p, m, argNode, field, site.name)
  }
}

fn checkOrmFindColumnsInModule(p: Project, mid: int) {
  let m = p.mods[mid]
  let b = ormFindBindingOf(m.tree, m.source)
  if (b.find == "") {
    return
  }
  let i = 1
  while (i < len(m.tree.nodes)) {
    if (getNode(m.tree, i).tag == Tag.Call) {
      checkOrmColumnCall(p, mid, b, i)
    }
    i = i + 1
  }
}

// Every `pkg/orm` find-chain call in the project, checked. Called from
// `resolveProject` (checkproject.bit) right after `injectSynthMembers` —
// after synthesis, so a synthesized import cannot hide a binding from
// `ormFindBindingOf`, and this reports nothing that mutates a tree, so
// ordering relative to resolve/check does not otherwise matter. Spans are
// MODULE-GLOBAL at this point exactly as `injectSynthMembers`'s own are
// (synthtext.bit), so the identical `remapDiags` call has to follow each
// module's pass — without it a diagnostic renders against file 0 (a real
// symptom hit and fixed while proving this file: an E0163 rendered at
// `stdlib/core/core.bit:7`, the checked module's file 0, instead of the
// checkercase fixture that actually named the bad column).
fn checkOrmFindColumns(p: Project) {
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    checkOrmFindColumnsInModule(p, i)
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
}
