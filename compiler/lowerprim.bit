// compiler/lowerprim.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// Materializes a variadic call's trailing arguments as the single `[]T` value
// the callee binds (§10.3). A lone `...s` spread (§12.4) forwards `s` itself
// rather than rebuilding it, which is what makes the pass-through form
// aliasing-free. The checker restricts `...` to the final argument (E0063), so
// a spread anywhere else in the tail means the tree disagrees with what was
// checked — refuse rather than emit something plausible.
fn lowerVariadicTail(fc: FnCtx, elemTy: int, items: []int): int {
  let sliceTy = mkSlice(fc.c.ctx, elemTy)
  if (len(items) == 1 && getNode(fc.c.tree, items[0]).tag == Tag.ArgSpread) {
    return lowerExprH(fc, kidsOf(fc.c.tree, items[0])[0], sliceTy)
  }
  let i = 0
  while (i < len(items)) {
    if (getNode(fc.c.tree, items[i]).tag == Tag.ArgSpread) {
      fcFail(fc, getNode(fc.c.tree, items[i]).span, "a `...` spread anywhere but the final call argument")
      return 0
    }
    i = i + 1
  }
  return lowerSliceElems(fc, sliceTy, items)
}

// The integer word type a float of type `ty` crosses the container word ABI as,
// or -1 when `ty` is not a float. `f32` uses `u32` so the bitcast on each side
// is a 32-bit transfer — the stored word is zero-extended, so the round trip is
// exact.
fn wordIntTy(fc: FnCtx, ty: int): int {
  let d = fc.c.ctx.types[ty]
  if (d.kind != TypeKind.Prim) {
    return -1
  }
  if (d.prim == 9) {
    return primType(fc.c.ctx, 7)
  }
  if (d.prim == 8) {
    return primType(fc.c.ctx, 6)
  }
  return -1
}

// The single lowering entry point for every `rt_call`. The container primitives
// declare their element operands and results as an untyped `u64` word
// (ir.bit's `rtWordArgs`/`rtReturnsWord`), so a float element must cross that
// boundary as its bit pattern, in an integer register. Emitting the bitcasts
// here — rather than letting codegen classify the operand by its Bit type —
// keeps the IR honest about the callee's actual C signature and fixes every
// backend at once. A non-word position, and any non-float type, passes through.
fn emitRtCall(fc: FnCtx, ins: IrInstr): int {
  let mask = rtWordArgs(ins.name)
  if (mask != 0) {
    let cast = []int(0)
    let i = 0
    for a of ins.args {
      let bit = mask / pow2(i) % 2
      let wt = -1
      if (bit == 1) {
        wt = wordIntTy(fc, fc.b.instrs[a].ty)
      }
      if (wt < 0) {
        cast = append(cast, a)
      } else {
        let bc = mkInstr(Op.Bitcast, wt)
        bc.lhs = a
        cast = append(cast, builderEmit(fc.b, bc))
      }
      i = i + 1
    }
    ins.args = cast
  }
  if (rtReturnsWord(ins.name)) {
    let rt = wordIntTy(fc, ins.ty)
    if (rt >= 0) {
      let resTy = ins.ty
      ins.ty = rt
      let word = builderEmit(fc.b, ins)
      let bc = mkInstr(Op.Bitcast, resTy)
      bc.lhs = word
      return builderEmit(fc.b, bc)
    }
  }
  return builderEmit(fc.b, ins)
}

// ===========================================================================
// Structural comparison descriptors (SPEC §14.6)
//
// §14.6 makes a struct comparable FIELD-WISE and a tuple ELEMENT-WISE, but both
// are one traced handle to a heap box, so the plain word compare `lowerComparison`
// emits answered "same allocation?" instead (#2105, #2113) — and the runtime map
// hashed the same handle, so an equal key missed and re-inserting it GREW the map
// (#2111).
//
// All three are fixed by one runtime walk (`descEqAgg` / `descHashAgg` in
// runtime/root/maps.bit), and that walk needs the type's shape. It cannot recover
// it at run time: the GC's `TypeInfo` distinguishes reference words from scalar
// words but not a `string` from a nested struct, and a string LITERAL is a static
// `{ptr,len}` pair with no GC header to read at all. So the shape is compiled
// here into a DESCRIPTOR PROGRAM — a string constant, one byte per body word —
// and handed to the runtime at the comparison site and at `map_new`.
//
// runtime/root/maps.bit owns the grammar; this is its only producer. ONE producer
// and ONE consumer is what makes the map's hash and its equality agree by
// construction rather than by review.
// ===========================================================================

// How deep the generator will follow nested aggregates. Below the runtime's own
// `descMaxDepth` (8) on purpose, so a program can never out-nest its interpreter.
// A self-referential type (`struct N { next: N }`) is what this bounds: it stops
// at 'r' — identity — which is also what Go gives such a field, since a
// recursive Go struct must reach itself through a pointer.
const descMaxDepth: int = 6

// The token budget for one whole program, counted in body words. Each nested
// aggregate is handed an equal share of what is left, so the total output is
// bounded by this number however wide or deep the type is (Power of 10 rule 3).
const descMaxWords: int = 96

// The descriptor token for a value of type `ty` occupying ONE body word.
// `budget` is the number of further words this token's own subtree may describe.
fn descToken(fc: FnCtx, ty: int, depth: int, budget: int): string {
  let t = fc.c.ctx.types[ty]
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return "s"
  }
  if (depth < descMaxDepth && (t.kind == TypeKind.Struct || t.kind == TypeKind.Tuple)) {
    let inner = descProgram(fc, ty, depth + 1, budget)
    if (inner != "") {
      return inner
    }
  }
  // Everything else reachable through a traced word — a slice, map, chan,
  // function, interface, payload enum or bare type parameter — has no value
  // equality of its own (§14.6), so it keeps the identity comparison it has
  // today. Blowing the depth or the budget lands here too, which degrades to the
  // pre-fix answer rather than to a wrong one.
  return "r"
}

// The body word slots of aggregate `ty`: `out[i]` is the type of the traced
// value occupying body word `i`, or 0 when that word holds raw bytes (scalars,
// packed sub-word fields, padding). Returns an empty slice when the layout
// cannot be read, which the caller treats as "not describable".
fn descSlots(fc: FnCtx, ty: int): []int {
  let t = fc.c.ctx.types[ty]
  if (t.kind == TypeKind.Tuple) {
    return descSlotsFrom(fc, layoutFields(fc, t.members), t.members)
  }
  let decl = structDeclOf(fc.c, ty)
  if (decl == 0) {
    return []int(0)
  }
  let oc = typeOwner(fc.c, ty)
  // `ty` is the INSTANTIATION (`Box<i64>`), whose declaration still spells the
  // field `v: T`; laying it out unsubstituted would call that integer a traced
  // reference, the same trap `lowerTypeInfo` records for the GC descriptor.
  let sub = structTySubst(fc, oc, decl, ty)
  let fields = structFieldNodes(oc, decl)
  let ftypes = []int(0)
  let i = 0
  while (i < len(fields)) {
    ftypes = append(ftypes, typeFromNodeIn(oc, kidsOf(oc.tree, fields[i])[1], sub))
    i = i + 1
  }
  return descSlotsFrom(fc, structLayout(fc, oc, decl, sub), ftypes)
}

// Records the word slots an inlined `[N]T` field at body offset `at` occupies.
// `structLayout` INLINES an array field into the struct's own body rather than
// storing a handle, and does not add its elements to the GC pointer map — so this
// walk is the only thing that describes them. A scalar element leaves its word
// raw; only a reference element needs a slot. `out` is a slice, so the write is
// the caller's (SPEC §13.3).
fn descSlotsArrayInto(fc: FnCtx, out: []int, at: int, arrTy: int) {
  let ft = fc.c.ctx.types[arrTy]
  if (!fieldLayoutFor(fc, ft.elem).isPtr) {
    return
  }
  let k = 0
  while (k < ft.arrayLen) {
    let w = (at + k * 8) / 8
    if (w < len(out)) {
      out[w] = ft.elem
    }
    k = k + 1
  }
}

// The shared half of `descSlots`, over a computed layout and its field types.
fn descSlotsFrom(fc: FnCtx, layout: StructLayout, ftypes: []int): []int {
  let out = []int(layout.size / 8)
  let i = 0
  while (i < len(ftypes) && i < len(layout.offsets)) {
    if (fc.c.ctx.types[ftypes[i]].kind == TypeKind.Array) {
      descSlotsArrayInto(fc, out, layout.offsets[i], ftypes[i])
    } else if (fieldLayoutFor(fc, ftypes[i]).isPtr) {
      let w = layout.offsets[i] / 8
      if (w < len(out)) {
        out[w] = ftypes[i]
      }
    }
    i = i + 1
  }
  return out
}

// The descriptor program for the aggregate type `ty`, e.g. `"{ws}"` for
// `struct P { x: int, name: string }`. Empty when `ty` has no describable
// layout or when `budget` will not cover it.
fn descProgram(fc: FnCtx, ty: int, depth: int, budget: int): string {
  let slots = descSlots(fc, ty)
  let n = len(slots)
  if (n > budget) {
    return ""
  }
  // Each word's own subtree gets an equal share of what this level leaves over,
  // so the whole program is bounded by the budget it started with.
  let share = 0
  if (n > 0) {
    share = (budget - n) / n
  }
  let out = "{"
  let i = 0
  while (i < n) {
    if (slots[i] == 0) {
      out = out + "w"
    } else {
      out = out + descToken(fc, slots[i], depth, share)
    }
    i = i + 1
  }
  return out + "}"
}

// The descriptor program for a type compared BY VALUE, or "" for a type that
// keeps its word comparison. Structs and tuples are the two §14.6 admits with a
// field/element-wise rule and a boxed representation; everything else — scalars,
// `string`, C-like enums, interfaces (identity today, see #2105's note) — is
// already handled by `lowerComparison` or has no value equality.
fn descForType(fc: FnCtx, ty: int): string {
  let k = fc.c.ctx.types[ty].kind
  if (k != TypeKind.Struct && k != TypeKind.Tuple) {
    return ""
  }
  return descProgram(fc, ty, 0, descMaxWords)
}

// Materializes a descriptor program as a pooled string constant.
fn descConst(fc: FnCtx, prog: string): int {
  let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  ins.sval = prog
  ins.ival = internPoolString(fc, prog)
  return builderEmit(fc.b, ins)
}

// `a == b` / `a != b` over a struct or tuple: `rt_call value_eq(a, b, desc)`,
// with `!=` negated the way the `string_eq` path next door negates its own.
// Returns -1 when `operandTy` is not compared by value, leaving the caller's
// word comparison in place.
fn lowerValueEq(fc: FnCtx, opKind: int, operandTy: int, lhs: int, rhs: int): int {
  if (opKind != int(Kind.EqEq) && opKind != int(Kind.BangEq)) {
    return -1
  }
  let prog = descForType(fc, operandTy)
  if (prog == "") {
    return -1
  }
  let boolTy = primType(fc.c.ctx, 10)
  let ve = mkInstr(Op.RtCall, boolTy)
  ve.name = "value_eq"
  ve.args = [lhs, rhs, descConst(fc, prog)]
  let eq = emitRtCall(fc, ve)
  if (opKind == int(Kind.EqEq)) {
    return eq
  }
  let f = mkInstr(Op.ConstBool, boolTy)
  f.bval = false
  let fV = builderEmit(fc.b, f)
  let ne = mkInstr(Op.ICmpEq, boolTy)
  ne.lhs = eq
  ne.rhs = fV
  return builderEmit(fc.b, ne)
}

// 2^n for the small, statically bounded `n` the word-argument mask needs.
fn pow2(n: int): int {
  let v = 1
  let i = 0
  for (; i < n; i = i + 1) {
    v = v * 2
  }
  return v
}

// Lowers `len(x)` / `cap(x)`: an array is its static length (const_int, len==cap),
// a slice's `len` is `slice_len` and its `cap` is `field_get [24]` (the header's
// cap word), a string/map `len` is `slice_len`/`rt_call map_len`. `cap` is
// slice/array-only — the checker rejects it elsewhere.
fn lowerLen(fc: FnCtx, node: int, isCap: bool): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a = args[0]
  if (getNode(fc.c.tree, a).tag == Tag.Arg) {
    a = kidsOf(fc.c.tree, a)[0]
  }
  let argTy = defaultType(fc.c, nodeType(fc, a))
  let td = fc.c.ctx.types[argTy]
  let i64ty = primType(fc.c.ctx, 3)
  // A fixed-size array's length is static; the argument is not evaluated.
  if (td.kind == TypeKind.Array) {
    let ins = mkInstr(Op.ConstInt, i64ty)
    ins.ival = td.arrayLen
    return builderEmit(fc.b, ins)
  }
  let v = lowerExpr(fc, a)
  if (fc.failed) {
    return 0
  }
  if (td.kind == TypeKind.Slice) {
    if (isCap) {
      let ci = mkInstr(Op.FieldGet, i64ty)
      ci.lhs = v
      ci.ival = 24
      return builderEmit(fc.b, ci)
    }
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Prim && td.prim == 11) {
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, i64ty)
    ins.name = "map_len"
    ins.args = [v]
    return emitRtCall(fc, ins)
  }
  fcFail(fc, getNode(fc.c.tree, node).span, "`len()`/`cap()` on a value that is not a slice, array, string or map")
  return 0
}

// Lowers `append(s, e1, e2, ...)`: folds each element through `slice_append`,
// threading the returned (possibly regrown) header so a `s = append(s, ...)`
// observes the new length. Each element lowers with the slice's element hint.
// `is_ref` travels on every call (ABI.md §2, #1569): a null header (a zeroed
// struct's slice field, #1564) has no element type to read, so the call site
// — the only place that still knows the static element type — supplies it.
fn lowerAppend(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a0 = args[0]
  if (getNode(fc.c.tree, a0).tag == Tag.Arg) {
    a0 = kidsOf(fc.c.tree, a0)[0]
  }
  let sliceTy = defaultType(fc.c, nodeType(fc, a0))
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  // elem_size (ABI.md §9, #3119/#3120): always 8 in this ticket, see
  // `lowerlit.bit`'s `lowerSliceAlloc` for the full rationale.
  let esI = mkInstr(Op.ConstInt, i64ty)
  esI.ival = 8
  let esV = builderEmit(fc.b, esI)
  let acc = lowerExpr(fc, a0)
  if (fc.failed) {
    return 0
  }
  let i = 1
  while (i < len(args) && !fc.failed) {
    let a = args[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, sliceTy)
    ins.name = "slice_append"
    ins.args = [acc, v, refV, esV]
    acc = emitRtCall(fc, ins)
    i = i + 1
  }
  return acc
}

// `atomicAdd`/`atomicSub`/`atomicAnd`/`atomicOr`/`atomicXchg` -> its IR op.
fn atomicRmwOpFor(name: string): Op {
  if (name == "atomicAdd") { return Op.AtomicRmwAdd }
  if (name == "atomicSub") { return Op.AtomicRmwSub }
  if (name == "atomicAnd") { return Op.AtomicRmwAnd }
  if (name == "atomicOr") { return Op.AtomicRmwOr }
  return Op.AtomicRmwXchg
}

// Lowers an atomic builtin (§11.5) to its dedicated inline IR op. The element
// type `T` is read off the `*T` argument; every value argument is lowered with
// `T` as its hint.
//
// That hint is advisory, not enforced, for anything but an untyped literal —
// so `assertAtomicOperandWidth` below re-checks it against what actually came
// out. This is the exact invariant that broke in shipped 0.1.10 (#2742): the
// backend (`emitAtomicStore` in arm64compile.bit, arm64select.bit's CAS
// lowering, x64dispatch.bit) reads the emitted access WIDTH off the *value*
// operand's IR type, never off the pointee, so a value that silently lowers
// to a different width than `T` makes the backend emit a 64-bit `stlr x`/
// `ldaxr x`/`cmpxchgq` through a 32-bit pointer — corrupting the 4 adjacent
// bytes. That happened when a module-const's inline path dropped its declared
// type and the literal defaulted to i64. The checker cannot catch this: it
// never sees IR types. Asserting here is the only place that can.
fn lowerAtomic(fc: FnCtx, node: int, name: string): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let pn = args[0]
  if (getNode(fc.c.tree, pn).tag == Tag.Arg) {
    pn = kidsOf(fc.c.tree, pn)[0]
  }
  let elem = fc.c.ctx.types[defaultType(fc.c, nodeType(fc, pn))].elem
  let ptr = lowerExpr(fc, pn)
  if (fc.failed) {
    return 0
  }
  if (name == "atomicLoad") {
    let ins = mkInstr(Op.AtomicLoad, elem)
    ins.lhs = ptr
    return builderEmit(fc.b, ins)
  }
  let a1 = args[1]
  if (getNode(fc.c.tree, a1).tag == Tag.Arg) {
    a1 = kidsOf(fc.c.tree, a1)[0]
  }
  let v1 = lowerExprH(fc, a1, elem)
  if (fc.failed) {
    return 0
  }
  assertAtomicOperandWidth(fc, v1, elem, name)
  if (name == "atomicStore") {
    let ins = mkInstr(Op.AtomicStore, fc.c.ctx.voidId)
    ins.lhs = ptr
    ins.rhs = v1
    return builderEmit(fc.b, ins)
  }
  if (name == "atomicCmpxchg") {
    let a2 = args[2]
    if (getNode(fc.c.tree, a2).tag == Tag.Arg) {
      a2 = kidsOf(fc.c.tree, a2)[0]
    }
    let v2 = lowerExprH(fc, a2, elem)
    if (fc.failed) {
      return 0
    }
    assertAtomicOperandWidth(fc, v2, elem, name)
    let ins = mkInstr(Op.AtomicCmpxchg, primType(fc.c.ctx, 10))
    ins.lhs = ptr
    ins.rhs = v1
    ins.ival = v2
    return builderEmit(fc.b, ins)
  }
  let ins = mkInstr(atomicRmwOpFor(name), elem)
  ins.lhs = ptr
  ins.rhs = v1
  return builderEmit(fc.b, ins)
}

// The width of an atomic store/RMW/CAS operand comes from the pointee (§11.5),
// never the value's own lowered type — see `lowerAtomic`'s comment. `valId`
// is the just-lowered value's SSA id; a mismatch means the hint above was
// dropped somewhere upstream and the backend is about to emit the wrong
// instruction width. Fail the compile rather than ship it (#2742).
fn assertAtomicOperandWidth(fc: FnCtx, valId: int, elem: int, name: string) {
  let got = fc.b.instrs[valId].ty
  if (got != elem) {
    panic("lowerAtomic: ${name}'s value operand lowered to '${typeName(fc.c.ctx, got)}' but its pointee is '${typeName(fc.c.ctx, elem)}' — atomic access width must come from the pointee (#2742)")
  }
}

// `ptrOf(s)` (§11.5): the byte address of `s`'s element 0, as a `*T`. The slice
// header is `{buf@0, len@8, off@16, cap@24, is_ref@32}` and each element is one
// 8-byte word, so element 0 sits at `buf + off*8`. The trailing `convert`
// retypes the address word from `i64` to `*T` (both are one int word).
// `entryOf(f)` (§11.10): `f`'s code address as a `*byte`, via the FuncAddr op —
// the same one `spawn` uses for its trampoline, so the relocation and every
// backend's emission of it are untouched and were already exercised on all three
// targets. `callQualified` supplies the emitted symbol name, exactly as a direct
// call does, so a pinned (§11.9) or imported callee is spelled the one way.
//
// validate.bit has already proved the operand is a direct reference to a
// non-generic, non-extern function declaration; `fc.failed` mirrors the seed's
// `UnsupportedConstruct` for the case that cannot legitimately arise, rather than
// emitting a relocation against a name nothing defines.
fn lowerEntryOf(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let callee = args[0]
  if (getNode(fc.c.tree, callee).tag == Tag.Arg) {
    callee = kidsOf(fc.c.tree, callee)[0]
  }
  if (getNode(fc.c.tree, callee).tag != Tag.Ident) {
    fcFail(fc, getNode(fc.c.tree, callee).span, "`entryOf()` on an argument that is not a direct function name")
    return 0
  }
  let fnNode = getNode(fc.c.tree, callee)
  let name = fc.c.source[fnNode.span.start:fnNode.span.end]
  let fr = funcRefAt(fc.c, callee, name)
  if (fr.decl == 0) {
    fcFail(fc, fnNode.span, "`entryOf()` on a name that does not resolve to a function declaration")
    return 0
  }
  let fa = mkInstr(Op.FuncAddr, nodeType(fc, node))
  fa.name = callQualifiedRef(fc.lowerer.root, fr)
  return builderEmit(fc.b, fa)
}

// `stackMapsBegin()`/`stackMapsEnd()` (§11.12): one bound of the compiler-emitted
// stack-map table (ABI.md §4), as a `*byte`. The symbol is UNDEFINED in this
// object by design — no member may claim a name the linker owns — so the whole
// instruction is one relocation and nothing else.
fn lowerStackMapsAddr(fc: FnCtx, node: int, name: string): int {
  let sm = mkInstr(Op.StackMapsAddr, nodeType(fc, node))
  sm.name = "bit_stack_maps"
  if (name == "stackMapsEnd") {
    sm.name = "bit_stack_maps_end"
  }
  return builderEmit(fc.b, sm)
}

fn lowerPtrOf(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let sn = args[0]
  if (getNode(fc.c.tree, sn).tag == Tag.Arg) {
    sn = kidsOf(fc.c.tree, sn)[0]
  }
  // Module-level state (§11.11) has a static address: GlobalAddr IS the answer,
  // with no slice header to walk.
  let pn = getNode(fc.c.tree, sn)
  if (pn.tag == Tag.Ident) {
    let psym = moduleGlobalSym(fc, fc.c.source[pn.span.start:pn.span.end])
    if (psym != "") {
      let cv = mkInstr(Op.Convert, nodeType(fc, node))
      cv.lhs = emitGlobalAddrVal(fc, psym)
      return builderEmit(fc.b, cv)
    }
  }
  let s = lowerExpr(fc, sn)
  if (fc.failed) {
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let bufIns = mkInstr(Op.FieldGet, i64ty)
  bufIns.lhs = s
  bufIns.ival = 0
  let buf = builderEmit(fc.b, bufIns)
  let offIns = mkInstr(Op.FieldGet, i64ty)
  offIns.lhs = s
  offIns.ival = 16
  let off = builderEmit(fc.b, offIns)
  let eightIns = mkInstr(Op.ConstInt, i64ty)
  eightIns.ival = 8
  let eight = builderEmit(fc.b, eightIns)
  let mulIns = mkInstr(Op.Mul, i64ty)
  mulIns.lhs = off
  mulIns.rhs = eight
  let byteoff = builderEmit(fc.b, mulIns)
  let addIns = mkInstr(Op.Add, i64ty)
  addIns.lhs = buf
  addIns.rhs = byteoff
  let addr = builderEmit(fc.b, addIns)
  let cvt = mkInstr(Op.Convert, nodeType(fc, node))
  cvt.lhs = addr
  return builderEmit(fc.b, cvt)
}

// Lowers a call: `print(x)` -> `rt_call print`, a direct call to a top-level
// function -> `call @name(args) result`. Other callees trip `failed`.
// Lowers a type conversion `T(x)`: a no-op if the source already has the target
// type; `string([]byte)` via `rt_call string_from_bytes`; otherwise the numeric
// `convert` op.
fn lowerConvert(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let arg = args[0]
  if (getNode(fc.c.tree, arg).tag == Tag.Arg) {
    arg = kidsOf(fc.c.tree, arg)[0]
  }
  let dstTy = defaultType(fc.c, nodeType(fc, node))
  let srcTy = defaultType(fc.c, nodeType(fc, arg))
  let src = lowerExprH(fc, arg, srcTy)
  if (fc.failed) {
    return 0
  }
  if (srcTy == dstTy) {
    return src
  }
  let dd = fc.c.ctx.types[dstTy]
  // A CONVERSION TO AN INTERFACE CARRIES NO VALUE CHANGE (#1898). An interface
  // value is the receiver pointer itself: `call_iface` finds the method table
  // through `bit_rt_iface_lookup` on the object's own header, so there is no fat
  // pointer to build and nothing to box. Only the static type differs, and the
  // instruction already carries that. Reached by `E(car)` and, since the
  // implicit `let e: E = car` spelling emits nothing at all, this is the only
  // path that has to say so.
  //
  // MUST PRECEDE the numeric arm below: without it an interface target falls
  // through to `Op.Convert`, which is a numeric widen/narrow and would emit a
  // register conversion over a pointer.
  if (dd.kind == TypeKind.Interface) {
    return src
  }
  if (dd.kind == TypeKind.Prim && dd.prim == 11 && fc.c.ctx.types[srcTy].kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, dstTy)
    ins.name = "string_from_bytes"
    ins.args = [src]
    return emitRtCall(fc, ins)
  }
  let ins = mkInstr(Op.Convert, dstTy)
  ins.lhs = src
  return builderEmit(fc.b, ins)
}

// Maps a runtime-primitive builtin name to its `rt_call` name, or "" for a
// non-primitive. Mirrors `prim_rt_fns` (the fs §14 / net §20
// / math §17 / time §18 / os §19 / crypto §21 surface); each lowers 1:1 to a
// runtime call whose result the checker already typed in `builtinResultType`.
// Maps a builtin name to the inline unary IR op that implements it, or
// `Op.BlockParam` (never a unary op, so it reads as "none") when the name is
// not one of these. These deliberately do NOT appear in `primRtName`: they are
// one hardware instruction on every backend, so they lower to an op — which is
// also what makes them pure and safepoint-free, and therefore usable inside
// `@nosplit`.
//
// `ffloor`/`fceil`/`ftrunc`/`fround` are here too, though they are one
// instruction only on AArch64 (`frintm`/`frintp`/`frintz`/`frinta`): the
// x86-64 form is `roundsd`, which is SSE4.1, and this backend emits nothing
// above SSE2. `x64.bit` expands them into a short SSE2 sequence rather than
// raising the baseline of every binary the compiler produces. An expansion is
// still not a call — no allocation, no safepoint — so the property that admits
// these inside `@nosplit` is unaffected.
fn primUnaryOp(name: string): Op {
  if (name == "fsqrt") { return Op.FSqrt }
  if (name == "floatBits") { return Op.Bitcast }
  if (name == "float32Bits") { return Op.Bitcast }
  if (name == "bitsToFloat") { return Op.Bitcast }
  if (name == "ffloor") { return Op.FFloor }
  if (name == "fceil") { return Op.FCeil }
  if (name == "ftrunc") { return Op.FTrunc }
  if (name == "fround") { return Op.FRound }
  return Op.BlockParam
}

fn primRtName(name: string): string {
  if (name == "fsOpen") { return "fs_open" }
  if (name == "fsReadAll") { return "fs_read_all" }
  if (name == "fsWrite") { return "fs_write" }
  if (name == "fsClose") { return "fs_close" }
  if (name == "fsAppend") { return "fs_append" }
  if (name == "fsRead") { return "fs_read" }
  if (name == "fsExists") { return "fs_exists" }
  if (name == "fsIsDir") { return "fs_is_dir" }
  if (name == "fsMkdir") { return "fs_mkdir" }
  if (name == "fsRemove") { return "fs_remove" }
  if (name == "fsListDir") { return "fs_list_dir" }
  if (name == "netListen") { return "net_listen" }
  if (name == "netLocalPort") { return "net_local_port" }
  if (name == "netAccept") { return "net_accept" }
  if (name == "netDial") { return "net_dial" }
  if (name == "netRead") { return "net_read" }
  if (name == "netWrite") { return "net_write" }
  if (name == "netUdpBind") { return "net_udp_bind" }
  if (name == "netUdpSend") { return "net_udp_send" }
  if (name == "netUdpRecv") { return "net_udp_recv" }
  if (name == "netUdpSenderHost") { return "net_udp_sender_host" }
  if (name == "netUdpSenderPort") { return "net_udp_sender_port" }
  if (name == "netResolve") { return "net_resolve" }
  if (name == "fpow") { return "pow" }
  if (name == "fatan2") { return "atan2" }
  if (name == "flog") { return "log" }
  if (name == "flog2") { return "log2" }
  if (name == "flog10") { return "log10" }
  if (name == "timeMonoNs") { return "time_mono_ns" }
  if (name == "timeUnixNs") { return "time_unix_ns" }
  if (name == "timeSleepNs") { return "time_sleep_ns" }
  if (name == "osArgc") { return "os_argc" }
  if (name == "osArgAt") { return "os_arg_at" }
  if (name == "osEnv") { return "os_env" }
  if (name == "osSelfExe") { return "os_self_exe" }
  if (name == "osExit") { return "os_exit" }
  if (name == "cryptoRandomBytes") { return "random_bytes" }
  if (name == "cryptoSecureZero") { return "secure_zero" }
  if (name == "fsChmod") { return "fs_chmod" }
  if (name == "osRun") { return "os_run" }
  if (name == "osRunTest") { return "os_run_test" }
  if (name == "osRunBounded") { return "os_run_bounded" }
  if (name == "osRunTestBounded") { return "os_run_test_bounded" }
  if (name == "hostTarget") { return "host_target" }
  if (name == "auxv") { return "auxv" }
  if (name == "parseFloat") { return "parse_float" }
  return ""
}

// A directly-named callee, fully resolved: the symbol the linker will see, the
// parameter types an argument list must be built against, and the IR result type.
struct CallTarget {
  ok: bool,
  symbol: string,
  paramTypes: []int,
  result: int,
  owner: Checker,
  decl: int,
}

// Resolves the callee of `callNode` (a Tag.Call whose callee is a Tag.Ident) to
// the symbol and signature to emit. `call`, `spawn` and `defer` ALL go through
// here — that is the shape, and the reason
// they cannot drift apart again. Deriving a name from the callee's source span
// instead skips BOTH generic instantiation (`g` where `g$0` was emitted) and
// module qualification (`work` where the definition is `m1$work`), producing an
// object with a dangling reference that only fails at dyld load.
fn resolveCallTarget(fc: FnCtx, name: string, callNode: int): CallTarget {
  let none = CallTarget{ ok: false, symbol: "", paramTypes: []int(0), result: 0, owner: fc.c, decl: 0 }
  // Keyed on the callee NODE where there is one (#1502): a bare `f(...)` asks
  // the resolver which `f`, and only a dotted `ns.f(...)` — whose name the
  // resolver never binds as one symbol — still falls back to the name path.
  let cnode = calleeNodeOf(fc.c, callNode)
  let fr = funcRefAt(fc.c, cnode, name)
  let decl = fr.decl
  if (decl == 0) {
    return none
  }
  // An imported callee's decl lives in ITS module's tree — `decl` indexes that
  // arena, so every read of it must go through the owning checker.
  let oc = fr.owner
  if (funcRefIsGeneric(fr)) {
    // The instance is numbered in the project-wide ledger and emitted by the
    // module that DECLARES the generic, so its symbol carries that module's
    // prefix and its original name — identical from every caller.
    // `genericTypeArgs` binds each type parameter from the checker's
    // once-checked-against-unbound-parameters record (`declRefType`); inside a
    // generic body a call argument that traces back to the enclosing
    // function's own PARAMETER (never rebound by `rebindCheckerName`, which
    // only fires for let/for/match/catch binders) still reads as the bare
    // TypeParam here. Substituting through `fc.genEnv` — mirroring
    // `recordSubtreeInstantiations` (lowerdriver.bit:83) and `nodeType`
    // (lower.bit:273) — turns it into this instantiation's concrete argument,
    // so the ledger lookup below finds the CONCRETE entry instead of the
    // degenerate one recorded from the unbound template.
    let targs = substTypeList(fc.c, genericTypeArgs(fc.c, name, callNode), fc.genEnv)
    let idx = instantiationIndex(fc.c, fr, targs)
    if (idx == -1) {
      return none
    }
    // SUBSTITUTED parameter types, never the template's. The template's `T` is a
    // non-primitive and so classifies as a GC reference: an argument list built
    // from it packs an `i64` into a slot the collector then walks as a pointer.
    return CallTarget{ ok: true,
      symbol: "${modulePrefix(oc.moduleId, fc.lowerer.root)}${fr.declName}\$${idx}",
      paramTypes: genericParamTypes(oc, decl, targs),
      result: unwrapFallible(fc.c, defaultType(fc.c, nodeType(fc, callNode))),
      owner: oc, decl: decl }
  }
  // A fallible callee's IR result is its ok type (the error rides the slot).
  return CallTarget{ ok: true,
    symbol: callQualifiedRef(fc.lowerer.root, fr),
    paramTypes: lowerParamTypes(oc, decl),
    result: unwrapFallible(fc.c, funcResultLookup(fc.c, name)),
    owner: oc, decl: decl }
}
