// compiler/lowerprim.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// Materializes a variadic call's trailing arguments as the single `[]T` value
// the callee binds (§10.3). A lone `...s` spread (§12.4) forwards `s` itself
// rather than rebuilding it, which is what makes the pass-through form
// aliasing-free. The checker restricts `...` to the final argument (E0063), so
// a spread anywhere else in the tail means the tree disagrees with what was
// checked — refuse rather than emit something plausible.
fn lowerVariadicTail(fc: FnCtx, elemTy: int, items: []int): int {
  let sliceTy = mkSlice(fc.c.ctx, elemTy)
  if (len(items) == 1 && getNode(fc.c.tree, items[0]).tag == Tag.ArgSpread) {
    return lowerExprH(fc, kidsOf(fc.c.tree, items[0])[0], sliceTy)
  }
  let i = 0
  while (i < len(items)) {
    if (getNode(fc.c.tree, items[i]).tag == Tag.ArgSpread) {
      fcFail(
        fc,
        getNode(fc.c.tree, items[i]).span,
        "a `...` spread anywhere but the final call argument",
      )
      return 0
    }
    i = i + 1
  }
  return lowerSliceElems(fc, sliceTy, items)
}

// `a == b` / `a != b` over a class or tuple: `rt_call value_eq(a, b, desc)`,
// with `!=` negated the way the `string_eq` path next door negates its own.
// Returns -1 when `operandTy` is not compared by value, leaving the caller's
// word comparison in place.
fn lowerValueEq(fc: FnCtx, opKind: int, operandTy: int, lhs: int, rhs: int): int {
  if (opKind != int(Kind.EqEq) && opKind != int(Kind.BangEq)) {
    return -1
  }
  let prog = descForType(fc, operandTy)
  if (prog == "") {
    return -1
  }
  let boolTy = primType(fc.c.ctx, 10)
  let ve = mkInstr(Op.RtCall, boolTy)
  ve.name = "value_eq"
  ve.args = [lhs, rhs, descConst(fc, prog)]
  let eq = emitRtCall(fc, ve)
  if (opKind == int(Kind.EqEq)) {
    return eq
  }
  let f = mkInstr(Op.ConstBool, boolTy)
  f.bval = false
  let fV = builderEmit(fc.b, f)
  let ne = mkInstr(Op.ICmpEq, boolTy)
  ne.lhs = eq
  ne.rhs = fV
  return builderEmit(fc.b, ne)
}

// Lowers `len(x)` / `cap(x)`: an array is its static length (const_int, len==cap),
// a slice's `len` is `slice_len` and its `cap` is `field_get [24]` (the header's
// cap word), a string/map `len` is `slice_len`/`rt_call map_len`. `cap` is
// slice/array-only — the checker rejects it elsewhere.
fn lowerLen(fc: FnCtx, node: int, isCap: bool): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a = args[0]
  if (getNode(fc.c.tree, a).tag == Tag.Arg) {
    a = kidsOf(fc.c.tree, a)[0]
  }
  let argTy = defaultType(fc.c, nodeType(fc, a))
  let td = fc.c.ctx.types[argTy]
  let i64ty = primType(fc.c.ctx, 3)
  // A fixed-size array's length is static; the argument is not evaluated.
  if (td.kind == TypeKind.Array) {
    let ins = mkInstr(Op.ConstInt, i64ty)
    ins.ival = td.arrayLen
    return builderEmit(fc.b, ins)
  }
  let v = lowerExpr(fc, a)
  if (fc.failed) {
    return 0
  }
  if (td.kind == TypeKind.Slice) {
    if (isCap) {
      let ci = mkInstr(Op.FieldGet, i64ty)
      ci.lhs = v
      ci.ival = 24
      return builderEmit(fc.b, ci)
    }
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Prim && td.prim == 11) {
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, i64ty)
    ins.name = "map_len"
    ins.args = [v]
    return emitRtCall(fc, ins)
  }
  fcFail(
    fc,
    getNode(fc.c.tree, node).span,
    "`len()`/`cap()` on a value that is not a slice, array, string or map",
  )
  return 0
}

// `atomicAdd`/`atomicSub`/`atomicAnd`/`atomicOr`/`atomicXchg` -> its IR op.
fn atomicRmwOpFor(name: string): Op {
  if (name == "atomicAdd") {
    return Op.AtomicRmwAdd
  }
  if (name == "atomicSub") {
    return Op.AtomicRmwSub
  }
  if (name == "atomicAnd") {
    return Op.AtomicRmwAnd
  }
  if (name == "atomicOr") {
    return Op.AtomicRmwOr
  }
  return Op.AtomicRmwXchg
}

// Lowers an atomic builtin (§11.5) to its dedicated inline IR op. The element
// type `T` is read off the `*T` argument; every value argument is lowered with
// `T` as its hint.
//
// That hint is advisory, not enforced, for anything but an untyped literal —
// so `assertAtomicOperandWidth` below re-checks it against what actually came
// out. This is the exact invariant that broke in shipped 0.1.10 (#2742): the
// backend (`emitAtomicStore` in arm64compile.bit, arm64select.bit's CAS
// lowering, x64dispatch.bit) reads the emitted access WIDTH off the *value*
// operand's IR type, never off the pointee, so a value that silently lowers
// to a different width than `T` makes the backend emit a 64-bit `stlr x`/
// `ldaxr x`/`cmpxchgq` through a 32-bit pointer — corrupting the 4 adjacent
// bytes. That happened when a module-const's inline path dropped its declared
// type and the literal defaulted to i64. The checker cannot catch this: it
// never sees IR types. Asserting here is the only place that can.
//
// A zero-arg atomic call (`atomicLoad()`) is checker-rejected (E0050,
// `vAtomicCall`, validateunmanaged.bit) — `bit check`/`build`/`run` never
// reach here with an empty `args` — but `--dump-ir`/`--dump-ir-pre` lower
// checker-rejected input (#3756/#3755's family), so this still has to decline
// rather than index `args[0]` off the end (#3759).
// Unwraps a call argument's `Arg` wrapper node to the underlying expression,
// if present. `lowerAtomic`'s three argument reads share this exact shape;
// splitting it out keeps that function inside E0204's complexity ceiling
// (spec/LINT.md's max-complexity = 10) after #3759's zero-arg guard pushed it
// to 11. Scoped to this function, not a file-wide dedup: the same idiom
// recurs ~20x across compiler/lower*.bit (lowerlit.bit's own
// `unwrapSliceAllocArg`, #3756, made the identical call).
fn unwrapAtomicArg(fc: FnCtx, node: int): int {
  if (getNode(fc.c.tree, node).tag == Tag.Arg) {
    return kidsOf(fc.c.tree, node)[0]
  }
  return node
}

fn lowerAtomic(fc: FnCtx, node: int, name: string): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  if (len(args) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "'${name}' with no arguments")
    return 0
  }
  let pn = unwrapAtomicArg(fc, args[0])
  let elem = fc.c.ctx.types[defaultType(fc.c, nodeType(fc, pn))].elem
  let ptr = lowerExpr(fc, pn)
  if (fc.failed) {
    return 0
  }
  if (name == "atomicLoad") {
    let ins = mkInstr(Op.AtomicLoad, elem)
    ins.lhs = ptr
    return builderEmit(fc.b, ins)
  }
  let a1 = unwrapAtomicArg(fc, args[1])
  let v1 = lowerExprH(fc, a1, elem)
  if (fc.failed) {
    return 0
  }
  assertAtomicOperandWidth(fc, v1, elem, name)
  if (name == "atomicStore") {
    let ins = mkInstr(Op.AtomicStore, fc.c.ctx.voidId)
    ins.lhs = ptr
    ins.rhs = v1
    // The pointee type, pinned here rather than re-derived from `v1`'s
    // defining instruction at codegen time (#4396 — the exact hazard
    // `assertAtomicOperandWidth` above only catches immediately after
    // lowering, before any later fold can retype what `rhs` resolves to).
    ins.ival2 = elem
    return builderEmit(fc.b, ins)
  }
  if (name == "atomicCmpxchg") {
    let a2 = unwrapAtomicArg(fc, args[2])
    let v2 = lowerExprH(fc, a2, elem)
    if (fc.failed) {
      return 0
    }
    assertAtomicOperandWidth(fc, v2, elem, name)
    let ins = mkInstr(Op.AtomicCmpxchg, primType(fc.c.ctx, 10))
    ins.lhs = ptr
    ins.rhs = v1
    ins.ival = v2
    // The pointee type, pinned here rather than re-derived from `v1`/`v2`'s
    // defining instructions at codegen time (#4396 — the same hazard
    // `assertAtomicOperandWidth` above only catches immediately after
    // lowering).
    ins.ival2 = elem
    return builderEmit(fc.b, ins)
  }
  let ins = mkInstr(atomicRmwOpFor(name), elem)
  ins.lhs = ptr
  ins.rhs = v1
  return builderEmit(fc.b, ins)
}

// The width of an atomic store/RMW/CAS operand comes from the pointee (§11.5),
// never the value's own lowered type — see `lowerAtomic`'s comment. `valId`
// is the just-lowered value's SSA id; a mismatch means the hint above was
// dropped somewhere upstream and the backend is about to emit the wrong
// instruction width. Fail the compile rather than ship it (#2742).
fn assertAtomicOperandWidth(fc: FnCtx, valId: int, elem: int, name: string) {
  let got = fc.b.instrs[valId].ty
  if (got != elem) {
    panic(
      "lowerAtomic: ${name}'s value operand lowered to '${typeName(fc.c.ctx, got)}' but its pointee is '${typeName(
        fc.c.ctx,
        elem,
      )}' — atomic access width must come from the pointee (#2742)",
    )
  }
}

// `ptrOf(s)` (§11.5): the byte address of `s`'s element 0, as a `*T`. The slice
// header is `{buf@0, len@8, off@16, cap@24, is_ref@32}` and `off` is counted in
// ELEMENTS, so element 0 sits at `buf + off*stride`, `stride` being the
// buffer's real per-element byte width: 1 for a packed `[]u8`, 8 for every
// other element (ABI.md §2, #3121/#3226 — same `sliceElemSizeFor` every other
// slice call site uses). The trailing `convert` retypes the address word from
// `i64` to `*T` (both are one int word).
// `entryOf(f)` (§11.10): `f`'s code address as a `*byte`, via the FuncAddr op —
// the same one `spawn` uses for its trampoline, so the relocation and every
// backend's emission of it are untouched and were already exercised on all three
// targets. `callQualified` supplies the emitted symbol name, exactly as a direct
// call does, so a pinned (§11.9) or imported callee is spelled the one way.
//
// validate.bit has already proved the operand is a direct reference to a
// non-generic, non-extern function declaration; `fc.failed` mirrors the seed's
// `UnsupportedConstruct` for the case that cannot legitimately arise, rather than
// emitting a relocation against a name nothing defines.
//
// A zero-arg `entryOf()` is checker-rejected (E0050, `vEntryOfCall`,
// validateunmanaged.bit) — `bit check`/`build`/`run` never reach here with an
// empty `args` — but `--dump-ir`/`--dump-ir-pre` lower checker-rejected input
// (#3756/#3755's family), so this still has to decline rather than index
// `args[0]` off the end (#3759).
fn lowerEntryOf(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  if (len(args) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "'entryOf' with no arguments")
    return 0
  }
  let callee = args[0]
  if (getNode(fc.c.tree, callee).tag == Tag.Arg) {
    callee = kidsOf(fc.c.tree, callee)[0]
  }
  if (getNode(fc.c.tree, callee).tag != Tag.Ident) {
    fcFail(
      fc,
      getNode(fc.c.tree, callee).span,
      "`entryOf()` on an argument that is not a direct function name",
    )
    return 0
  }
  let fnNode = getNode(fc.c.tree, callee)
  let name = fc.c.source[fnNode.span.start:fnNode.span.end]
  let fr = funcRefAt(fc.c, callee, name)
  if (fr.decl == 0) {
    fcFail(fc, fnNode.span, "`entryOf()` on a name that does not resolve to a function declaration")
    return 0
  }
  let fa = mkInstr(Op.FuncAddr, nodeType(fc, node))
  fa.name = callQualifiedRef(fc.lowerer.root, fr)
  return builderEmit(fc.b, fa)
}

// A zero-arg `ptrOf()` is checker-rejected (E0050, `vPtrOfCall`,
// validateunmanaged.bit) — `bit check`/`build`/`run` never reach here with an
// empty `args` — but `--dump-ir`/`--dump-ir-pre` lower checker-rejected input
// (#3756/#3755's family), so this still has to decline rather than index
// `args[0]` off the end (#3759).
fn lowerPtrOf(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  if (len(args) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "'ptrOf' with no arguments")
    return 0
  }
  let sn = args[0]
  if (getNode(fc.c.tree, sn).tag == Tag.Arg) {
    sn = kidsOf(fc.c.tree, sn)[0]
  }
  // Module-level state (§11.11) has a static address: GlobalAddr IS the answer,
  // with no slice header to walk.
  let pn = getNode(fc.c.tree, sn)
  if (pn.tag == Tag.Ident) {
    let psym = moduleGlobalSym(fc, fc.c.source[pn.span.start:pn.span.end])
    if (psym != "") {
      let cv = mkInstr(Op.Convert, nodeType(fc, node))
      cv.lhs = emitGlobalAddrVal(fc, psym)
      return builderEmit(fc.b, cv)
    }
  }
  let sliceTy = defaultType(fc.c, nodeType(fc, sn))
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let s = lowerExpr(fc, sn)
  if (fc.failed) {
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let bufIns = mkInstr(Op.FieldGet, i64ty)
  bufIns.lhs = s
  bufIns.ival = 0
  let buf = builderEmit(fc.b, bufIns)
  let offIns = mkInstr(Op.FieldGet, i64ty)
  offIns.lhs = s
  offIns.ival = 16
  let off = builderEmit(fc.b, offIns)
  let strideIns = mkInstr(Op.ConstInt, i64ty)
  strideIns.ival = sliceElemSizeFor(fc, elemTy)
  let stride = builderEmit(fc.b, strideIns)
  let mulIns = mkInstr(Op.Mul, i64ty)
  mulIns.lhs = off
  mulIns.rhs = stride
  let byteoff = builderEmit(fc.b, mulIns)
  let addIns = mkInstr(Op.Add, i64ty)
  addIns.lhs = buf
  addIns.rhs = byteoff
  let addr = builderEmit(fc.b, addIns)
  let cvt = mkInstr(Op.Convert, nodeType(fc, node))
  cvt.lhs = addr
  let ptr = builderEmit(fc.b, cvt)
  // #4467: `ptr` is a RAW address into `s`'s buffer, and `isRefType`
  // (codegen.bit) reports `*T` as a word the GC must never follow — so `s` is
  // the only thing that roots the bytes `ptr` names. Every other producer of an
  // untraced word from a traced base records this edge already
  // (`recordWordKeepAlive`, lowerkeepalive.bit, at the five explosion sites);
  // `ptrOf` is the SOURCE-LEVEL spelling of exactly that derivation and was the
  // one producer without it. Without the edge `s`'s live interval ends at the
  // `field_get` above, no stack map can name it at a later safepoint, and
  // `*(ptrOf(s) + 1)` read after a collection returns 0 at exit 0 wherever the
  // base did not happen to land somewhere the conservative stack scan could
  // see. The module-global path returns above and needs none: a `GlobalAddr`
  // has a static address and no GC base.
  if (isRefType(fc.c.ctx, sliceTy)) {
    builderKeepAlive(fc.b, ptr, s)
  }
  return ptr
}

// Lowers a call: `print(x)` -> `rt_call print`, a direct call to a top-level
// function -> `call @name(args) result`. Other callees trip `failed`.
// Lowers a type conversion `T(x)`: a no-op if the source already has the target
// type; `string([]byte)` via `rt_call string_from_bytes`; otherwise the numeric
// `convert` op.
fn lowerConvert(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let arg = args[0]
  if (getNode(fc.c.tree, arg).tag == Tag.Arg) {
    arg = kidsOf(fc.c.tree, arg)[0]
  }
  let dstTy = defaultType(fc.c, nodeType(fc, node))
  let srcTy = defaultType(fc.c, nodeType(fc, arg))
  let src = lowerExprH(fc, arg, srcTy)
  if (fc.failed) {
    return 0
  }
  if (srcTy == dstTy) {
    return src
  }
  let dd = fc.c.ctx.types[dstTy]
  // A CONVERSION TO AN INTERFACE CARRIES NO VALUE CHANGE (#1898). An interface
  // value is the receiver pointer itself: `call_iface` finds the method table
  // through `bit_rt_iface_lookup` on the object's own header, so there is no fat
  // pointer to build and nothing to box. Only the static type differs, and the
  // instruction already carries that. Reached by `E(car)` and, since the
  // implicit `let e: E = car` spelling emits nothing at all, this is the only
  // path that has to say so.
  //
  // MUST PRECEDE the numeric arm below: without it an interface target falls
  // through to `Op.Convert`, which is a numeric widen/narrow and would emit a
  // register conversion over a pointer.
  if (dd.kind == TypeKind.Interface) {
    return src
  }
  if (dd.kind == TypeKind.Prim && dd.prim == 11 && fc.c.ctx.types[srcTy].kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, dstTy)
    ins.name = "string_from_bytes"
    ins.args = [src]
    return emitRtCall(fc, ins)
  }
  // `decimal` (§12.9, §5.3) is two i64 words, never one register — the
  // generic `Op.Convert` below is single-register-in, single-register-out
  // and silently mis-handles either direction (#5409). `isDecimalPrim`
  // (lowerdecimal.bit) on exactly one side is a numeric-conversion `T(x)`
  // reaching here (`srcTy == dstTy` above already returned for the
  // `decimal(d)` identity, and every other pairing is E0053-rejected before
  // lowering, per `vPrimConvertOk`, validateiface.bit).
  if (isDecimalPrim(fc.c.ctx, dstTy)) {
    return lowerIntToDecimalConvert(fc, src, srcTy)
  }
  if (isDecimalPrim(fc.c.ctx, srcTy)) {
    return lowerDecimalToIntConvert(fc, src, dstTy)
  }
  let ins = mkInstr(Op.Convert, dstTy)
  ins.lhs = src
  return builderEmit(fc.b, ins)
}

// Maps a runtime-primitive builtin name to its `rt_call` name, or "" for a
// non-primitive. Mirrors `prim_rt_fns` (the fs §14 / net §20
// / math §17 / time §18 / os §19 / crypto §21 surface); each lowers 1:1 to a
// runtime call whose result the checker already typed in `builtinResultType`.
// Maps a builtin name to the inline unary IR op that implements it, or
// `Op.BlockParam` (never a unary op, so it reads as "none") when the name is
// not one of these. These deliberately do NOT appear in `primRtName`: they are
// one hardware instruction on every backend, so they lower to an op — which is
// also what makes them pure and safepoint-free, and therefore usable inside
// `@nosplit`.
//
// `ffloor`/`fceil`/`ftrunc`/`fround` are here too, though they are one
// instruction only on AArch64 (`frintm`/`frintp`/`frintz`/`frinta`): the
// x86-64 form is `roundsd`, which is SSE4.1, and this backend emits nothing
// above SSE2. `x64.bit` expands them into a short SSE2 sequence rather than
// raising the baseline of every binary the compiler produces. An expansion is
// still not a call — no allocation, no safepoint — so the property that admits
// these inside `@nosplit` is unaffected.
fn primUnaryOp(name: string): Op {
  if (name == "fsqrt") {
    return Op.FSqrt
  }
  if (name == "floatBits") {
    return Op.Bitcast
  }
  if (name == "float32Bits") {
    return Op.Bitcast
  }
  if (name == "bitsToFloat") {
    return Op.Bitcast
  }
  if (name == "ffloor") {
    return Op.FFloor
  }
  if (name == "fceil") {
    return Op.FCeil
  }
  if (name == "ftrunc") {
    return Op.FTrunc
  }
  if (name == "fround") {
    return Op.FRound
  }
  return Op.BlockParam
}

// #5613: table-driven -- a flat if/return chain formats to 3 lines per case
// under canonical `bit fmt` (153 lines, complexity 50) the moment this file
// came off BIT_FMTZERO_DEBT (#4099). A PrimRtEntry row stays on one physical
// line no matter how the file is reflowed, same shape as #5603's
// gateDepStep and irrtfns.bit's rtFnTags() table.
class PrimRtEntry {
  prim: string,
  rt: string,
}

fn primRtNameTable(): []PrimRtEntry {
  return [
    PrimRtEntry{ prim = "fsOpen", rt = "fs_open" },
    PrimRtEntry{ prim = "fsReadAll", rt = "fs_read_all" },
    PrimRtEntry{ prim = "fsWrite", rt = "fs_write" },
    PrimRtEntry{ prim = "fsClose", rt = "fs_close" },
    PrimRtEntry{ prim = "fsAppend", rt = "fs_append" },
    PrimRtEntry{ prim = "fsRead", rt = "fs_read" },
    PrimRtEntry{ prim = "fsExists", rt = "fs_exists" },
    PrimRtEntry{ prim = "fsIsDir", rt = "fs_is_dir" },
    PrimRtEntry{ prim = "fsMkdir", rt = "fs_mkdir" },
    PrimRtEntry{ prim = "fsRemove", rt = "fs_remove" },
    PrimRtEntry{ prim = "fsRename", rt = "fs_rename" },
    PrimRtEntry{ prim = "fsListDir", rt = "fs_list_dir" },
    PrimRtEntry{ prim = "fsCwd", rt = "fs_cwd" },
    PrimRtEntry{ prim = "netListen", rt = "net_listen" },
    PrimRtEntry{ prim = "netLocalPort", rt = "net_local_port" },
    PrimRtEntry{ prim = "netAccept", rt = "net_accept" },
    PrimRtEntry{ prim = "netDial", rt = "net_dial" },
    PrimRtEntry{ prim = "netRead", rt = "net_read" },
    PrimRtEntry{ prim = "netWrite", rt = "net_write" },
    PrimRtEntry{ prim = "netUdpBind", rt = "net_udp_bind" },
    PrimRtEntry{ prim = "netUdpSend", rt = "net_udp_send" },
    PrimRtEntry{ prim = "netUdpRecv", rt = "net_udp_recv" },
    PrimRtEntry{ prim = "netUdpSenderHost", rt = "net_udp_sender_host" },
    PrimRtEntry{ prim = "netUdpSenderPort", rt = "net_udp_sender_port" },
    PrimRtEntry{ prim = "netResolve", rt = "net_resolve" },
    PrimRtEntry{ prim = "fpow", rt = "pow" },
    PrimRtEntry{ prim = "fatan2", rt = "atan2" },
    PrimRtEntry{ prim = "flog", rt = "log" },
    PrimRtEntry{ prim = "flog2", rt = "log2" },
    PrimRtEntry{ prim = "flog10", rt = "log10" },
    PrimRtEntry{ prim = "timeMonoNs", rt = "time_mono_ns" },
    PrimRtEntry{ prim = "timeUnixNs", rt = "time_unix_ns" },
    PrimRtEntry{ prim = "timeSleepNs", rt = "time_sleep_ns" },
    PrimRtEntry{ prim = "osArgc", rt = "os_argc" },
    PrimRtEntry{ prim = "osArgAt", rt = "os_arg_at" },
    PrimRtEntry{ prim = "osEnv", rt = "os_env" },
    PrimRtEntry{ prim = "osSelfExe", rt = "os_self_exe" },
    PrimRtEntry{ prim = "osExit", rt = "os_exit" },
    PrimRtEntry{ prim = "cryptoRandomBytes", rt = "random_bytes" },
    PrimRtEntry{ prim = "cryptoSecureZero", rt = "secure_zero" },
    PrimRtEntry{ prim = "fsChmod", rt = "fs_chmod" },
    PrimRtEntry{ prim = "osRun", rt = "os_run" },
    PrimRtEntry{ prim = "osRunTest", rt = "os_run_test" },
    PrimRtEntry{ prim = "osRunBounded", rt = "os_run_bounded" },
    PrimRtEntry{ prim = "osRunTestBounded", rt = "os_run_test_bounded" },
    PrimRtEntry{ prim = "hostTarget", rt = "host_target" },
    PrimRtEntry{ prim = "auxv", rt = "auxv" },
    PrimRtEntry{ prim = "parseFloat", rt = "parse_float" },
    // #2665: the `chan<bool>` argument lowers exactly as `close(c)`'s does --
    // `lowerArgs` calls `lowerExpr` on it like any other argument, with no
    // special case needed here at all.
    PrimRtEntry{ prim = "schedTimerChanArm", rt = "sched_timer_chan_arm" },
  ]
}

fn primRtName(name: string): string {
  let table = primRtNameTable()
  let i = 0
  while (i < len(table)) {
    if (table[i].prim == name) {
      return table[i].rt
    }
    i = i + 1
  }
  return ""
}

// True when every one of `args` is a CONCRETE type — no TypeParam leaf.
// `typeInsts` also holds `Wrap<T>{...}`'s OWN template entry (`T` still
// `wrap<T>`'s unbound param, `checkinst.bit`'s `foreignFuncTypeParam`);
// nothing ever calls that receiver, so lowering its method body asked for
// an instantiation keyed on a TypeParam (#5320: `E0092` on a program `bit
// check` accepted). `lowerinstemit.bit`'s `lowerMethodInstances` and
// `lowerinstclosure.bit`'s `recordMethodInstanceCalls` skip such an entry
// with this.
fn typeInstArgsConcrete(ctx: TypeContext, args: []int): bool {
  let i = 0
  while (i < len(args)) {
    if (ctx.types[args[i]].kind == TypeKind.TypeParam) {
      return false
    }
    i = i + 1
  }
  return true
}

// A directly-named callee, fully resolved: the symbol the linker will see, the
// parameter types an argument list must be built against, and the IR result type.
class CallTarget {
  ok: bool,
  symbol: string,
  paramTypes: []int,
  result: int,
  owner: Checker,
  decl: int,
}

// Resolves the callee of `callNode` (a Tag.Call whose callee is a Tag.Ident) to
// the symbol and signature to emit. `call`, `spawn` and `defer` ALL go through
// here — that is the shape, and the reason
// they cannot drift apart again. Deriving a name from the callee's source span
// instead skips BOTH generic instantiation (`g` where `g$0` was emitted) and
// module qualification (`work` where the definition is `m1$work`), producing an
// object with a dangling reference that only fails at dyld load.
fn resolveCallTarget(fc: FnCtx, name: string, callNode: int): CallTarget {
  let none = CallTarget{
    ok = false,
    symbol = "",
    paramTypes = []int(0),
    result = 0,
    owner = fc.c,
    decl = 0,
  }
  // Keyed on the callee NODE where there is one (#1502): a bare `f(...)` asks
  // the resolver which `f`, and only a dotted `ns.f(...)` — whose name the
  // resolver never binds as one symbol — still falls back to the name path.
  let cnode = calleeNodeOf(fc.c, callNode)
  let fr = funcRefAt(fc.c, cnode, name)
  let decl = fr.decl
  if (decl == 0) {
    return none
  }
  // An imported callee's decl lives in ITS module's tree — `decl` indexes that
  // arena, so every read of it must go through the owning checker.
  let oc = fr.owner
  if (funcRefIsGeneric(fr)) {
    // The instance is numbered in the project-wide ledger and emitted by the
    // module that DECLARES the generic, so its symbol carries that module's
    // prefix and its original name — identical from every caller.
    // `genericTypeArgs` binds each type parameter from the checker's
    // once-checked-against-unbound-parameters record (`declRefType`); inside a
    // generic body a call argument that traces back to the enclosing
    // function's own PARAMETER (never rebound by `rebindCheckerName`, which
    // only fires for let/for/match/catch binders) still reads as the bare
    // TypeParam here. Substituting through `fc.genEnv` — mirroring
    // `recordSubtreeInstantiations` (lowerinstclosure.bit:70) and `nodeType`
    // (lower.bit:273) — turns it into this instantiation's concrete argument,
    // so the ledger lookup below finds the CONCRETE entry instead of the
    // degenerate one recorded from the unbound template.
    let targs = substTypeList(fc.c, genericTypeArgs(fc.c, name, callNode), fc.genEnv)
    let idx = instantiationIndex(fc.c, fr, targs)
    if (idx == -1) {
      return none
    }
    // SUBSTITUTED parameter types, never the template's. The template's `T` is a
    // non-primitive and so classifies as a GC reference: an argument list built
    // from it packs an `i64` into a slot the collector then walks as a pointer.
    return CallTarget{
      ok = true,
      symbol = instanceSymbol(fc.c.ctx, fc.lowerer.root, idx),
      paramTypes = genericParamTypes(oc, decl, targs),
      result = unwrapFallible(fc.c, defaultType(fc.c, nodeType(fc, callNode))),
      owner = oc, decl = decl,
    }
  }
  // A fallible callee's IR result is its ok type (the error rides the slot).
  return CallTarget{
    ok = true,
    symbol = callQualifiedRef(fc.lowerer.root, fr),
    paramTypes = lowerParamTypes(oc, decl),
    result = unwrapFallible(fc.c, funcResultLookup(fc.c, name)),
    owner = oc, decl = decl,
  }
}

// The `Op.Call` for a resolved direct callee — the tail both of `lowerCall`'s
// resolved-target paths share (the plain `f(...)` and the namespaced
// `ns.f(...)`), and the single place a call-site interception can be added
// without either path drifting from the other.
//
// Extracted rather than branched inline: `lowerCall` is already 418 lines and
// complexity 86, and adding the #4345 test at both sites would have taken it to
// 88 while duplicating the emit. This leaves it SHORTER than before.
fn emitResolvedCall(fc: FnCtx, t: CallTarget, a: []int): int {
  let mp = emitMemPrim(fc, t, a)
  if (mp.hit) {
    return mp.slot
  }
  let retWords = explodedRetWords(t.owner, t.decl, fc.lowerer)
  let ins = mkInstr(Op.Call, t.result)
  if (len(retWords) != 0) {
    ins = mkInstr(Op.Call, retWords[0])
  }
  ins.name = t.symbol
  // #4404: an exploded parameter takes its words, not the aggregate. Decided
  // from the callee's DECLARATION, which is the same thing `lowerFunc` decided
  // when it built that callee's parameter list.
  ins.args = explodeCallArgs(
    fc.c.ctx, fc.b, t.paramTypes, a,
    ArgExplodeGates{
      tuples = explodesParams(t.owner, t.decl),
      strings = fc.lowerer.explodeStrings,
    },
  )
  let call = builderEmit(fc.b, ins)
  if (len(retWords) == 0) {
    return call
  }
  // #4405: the callee handed its result back in W registers, so the call
  // carries word 0 and its `Op.CallWord` run the rest. The aggregate is
  // rebuilt HERE, which is what keeps every consumer of a call result — a
  // destructure, a field access, a pass-through `return f()` — exactly as it
  // was: this function is the only place that has to know.
  //
  // The box is what the optimizer then removes. A destructure's `field_get`s
  // forward from these `field_set`s in the same block and the allocation
  // nothing reads is deleted. Where the aggregate genuinely escapes, the box
  // stays — which is precisely today's behaviour, so this is never worse than
  // what it replaces, and correctness never depends on the optimizer running.
  return materializeExplodedIn(
    fc, fc.b, t.result, emitCallResultWords(fc.c.ctx, fc.b, call, retWords),
  )
}
