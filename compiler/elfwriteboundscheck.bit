fn checkElfWriteBounds() {
  checkElfBackedBounds()
  checkElfRecordBounds()
  checkElfNameBounds()
  checkElfWideBss()
  checkElfContainmentBounds()
}

fn checkElfBackedBounds() {
  let max = objectByteLimit()
  assert(
      (ewDataEnd(max - 8, 8, 8) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (ewDataEnd(max - 7, 8, 8) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (ewDataEnd(max, 1, 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (ewRecordEnd(max - 64, 1, sizeofElfShdr()) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (ewRecordEnd(max - 63, 1, sizeofElfShdr()) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkElfRecordBounds() {
  let max = objectByteLimit()
  let n = max / sizeofElfRela()
  assert(
      (ewRecordEnd(0, n, sizeofElfRela()) catch _ {
        -1
      }) ==
      n * sizeofElfRela(),
  )
  assert(
      (ewRecordEnd(0, n + 1, sizeofElfRela()) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (ewSymbolSize(0xffffffff, 0) catch _ {
        -1
      }) ==
      0x100000000 * sizeofElfSym(),
  )
  assert(
      (ewSymbolSize(0x100000000, 0) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (ewSymbolSize(0xffffffff, 0xfffffffe) catch _ {
        -1
      }) > 0,
  )
  assert(
      (ewSymbolSize(0xffffffff, 0xffffffff) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkElfNameBounds() {
  assert(
      (ewU32(0xffffffff) catch _ {
        -1
      }) ==
      0xffffffff,
  )
  assert(
      (ewU32(0x100000000) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (ewStringEnd(0xffffffff, 1) catch _ {
        -1
      }) ==
      0x100000001,
  )
  assert(
      (ewStringEnd(0x100000000, 0) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (ewStringEnd(1, objectByteLimit() - 2) catch _ {
        -1
      }) ==
      objectByteLimit(),
  )
  assert(
      (ewStringEnd(1, objectByteLimit() - 1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkElfWideBss() {
  let sec = ElfSection{ kind = ElfSectionKind.Bss, data = []u8(0), size = vI64Max(), alignment = 8 }
  assert(
      (ewRealBounds(sec, 64) catch _ {
        -1
      }) ==
      64,
  )
  let obj = ElfObject{
    sections = [sec],
    symbols = []ElfSymbol(0),
    relocations = []ElfRelocation(0),
  }
  for target of [ElfTarget.X86_64, ElfTarget.Aarch64] {
    let bytes = elfBytes(target, obj)
    assert(len(bytes) < 1024)
    let sh = elfShdrAt(bytes, elfFindSection(bytes, ".bss"))
    assert(leAt(bytes, sh + 32, 8) == vI64Max())
  }
  sec.size = -1
  assert(
      (ewRealBounds(sec, 64) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkElfContainmentBounds() {
  let sec = ElfSection{ kind = ElfSectionKind.Bss, data = []u8(0), size = vI64Max(), alignment = 1 }
  let sym = ElfSymbol{
    name = "end", hasSection = true, section = ElfSectionKind.Bss,
    offset = vI64Max(), size = 0, binding = ElfBinding.Global, kind = ElfSymKind.Object,
  }
  let obj = ElfObject{ sections = [sec], symbols = [sym], relocations = []ElfRelocation(0) }
  assert(elfErr(ElfTarget.X86_64, obj) == "")
  sym.size = 1
  assert(elfErr(ElfTarget.X86_64, obj) == "SymbolOutOfBounds")
  sym.size = 0
  sym.offset = -1
  assert(elfErr(ElfTarget.X86_64, obj) == "SymbolOutOfBounds")
  obj.symbols = []ElfSymbol(0)
  obj.relocations = [
    ElfRelocation{
      section = ElfSectionKind.Bss, offset = vI64Max(), symbol = "missing",
      kind = ElfRelocKind.Abs64, addend = 0,
    },
  ]
  assert(elfErr(ElfTarget.X86_64, obj) == "RelocOutOfBounds")
  obj.relocations[0].offset = -1
  assert(elfErr(ElfTarget.X86_64, obj) == "RelocOutOfBounds")
}
