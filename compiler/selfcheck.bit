// Phase 8: regalloc/codegen-core word layout, IR, and the frontend (checker,
// lexer, parser, diagnostics, package manager CLI).
fn selfcheckPhaseFrontend() {
  checkRegalloc()
  checkCodegenCore()
  checkDecimalWordLayout()
  // #5426: the enum-PAYLOAD-SLOT pointer-map question, distinct from the
  // class-field one checkDecimalWordLayout proves above.
  checkEnumPayloadSlotIsPtr()
  // #5312 (compiler/lowerlayout.bit): the enum branch of explodedWordTypes.
  checkExplodedEnumWordTypes()
  // #5447: the ref-if-ANY direction of that branch's payload-word union, which
  // no eligible declaration can distinguish from ref-if-EVERY.
  checkEnumPayloadWordIsRefUnion()
  checkInferTypes()
  checkMethodTables()
  checkMemWordAtPrim()
  checkMemPrimRefusesForgedRootName()
  checkFoldTargetTests()
  checkTargetIsX64Policy()
  checkInstrSpans()
  checkIrDump()
  checkArityValidatorFiresOnMalformedJoin()
  checkInlineJoinArity()
  checkCallArityValidator()
  checkExplodedPairArgs()
  // #4410 (compiler/lowerexplode.bit).
  checkExplodedPairLocal()
  // #4405 (compiler/ircheckret.bit, compiler/arm64selcheckgen.bit).
  checkMultiWordRet()
  checkCallWordValidator()
  // #5444 (compiler/verify.bit, compiler/ircheckret.bit).
  checkCallResultValidator()
  checkArm64CallWordDispatch()
  // #4407 (compiler/verify.bit, compiler/ircheckret.bit).
  checkStringViewBaseValidator()
  checkConvertFold()
  checkTypeNames()
  checkResolveSubstrate()
  checkDiagnostics()
  checkDiagRender()
  checkLint()
  checkAst()
  checkLexer()
  checkNumbers()
  checkStrings()
  checkInterp()
  checkParser()
  checkPmVersion()
  checkPmResolve()
  checkPmCli()
  checkTestgen()
  checkBuildTargetRoundTrip()
  checkMainPathsPosixHost()
  checkIsPathSepByte()
  checkEcCodesUnique()
}

fn selfcheck() {
  let only = osEnv("BIT_SELFCHECK_ONLY")
  if (len(only) > 0) {
    selfcheckOnly(only)
    return
  }
  selfcheckPhaseMisc()
  selfcheckPhaseX64Encode()
  selfcheckPhaseX64Codegen()
  selfcheckPhaseProject()
  selfcheckPhaseArm64()
  selfcheckPhaseObjWriters()
  selfcheckPhaseLink()
  selfcheckPhaseFrontend()
}

// Round-trips all 4 BuildTarget triples (build.bit) through parse ->
// buildTargetOf -> name/index (#3324) — guards buildTargetName's bare tail
// against silently absorbing a future 5th member the way it did
// X86_64Windows until this ticket.
fn checkBuildTargetRoundTrip() {
  let triples = ["x86_64-linux", "aarch64-linux", "aarch64-macos", "x86_64-windows"]
  let i = 0
  while (i < len(triples)) {
    let idx = parseBuildTarget(triples[i])
    assert(idx == i)
    let t = buildTargetOf(idx)
    assert(buildTargetName(t) == triples[i])
    assert(buildTargetIndex(t) == idx)
    i = i + 1
  }
  assert(parseBuildTarget("x86_64-bogus") == -1)
}
