// Split out of arm64call.bit (#5965): `Op.CallIface` dispatch through the
// site's inline cache (runtime/ABI.md §2.1, compiler/ifacecache.bit). Same
// module, sibling file.

// call_iface: structural interface dispatch (ABI.md §2.1). Load the receiver
// object's TypeInfo (*(recv - 16), the header's `info` field) and compare it
// with the site's inline cache cell `{info, fn}` (#5965, compiler/ifacecache.bit):
// a hit takes the cached code address, a miss resolves the method id
// (emitIfaceCacheMiss). Then blr it with the receiver
// in x0. The lookup never collects, so only the final method call records a
// safepoint (like `emitCallValue`, arm64callvalue.bit); the receiver is
// reloaded from its vreg afterward (its home survives the lookup call).
fn emitCallIfaceSeq(cx: A64Ctx, ins: IrInstr) {
  assert(ins.name != "") // assignIfaceCaches names every site's cell before codegen
  let recv = getInt(cx, vregOf(cx, ins.lhs), scratch1())
  // #2240: a nil interface value's receiver is the null word (ABI.md §2: an
  // interface value IS its receiver pointer); dispatching through it must
  // panic, not read `*(recv - 16)` as a TypeInfo pointer at address -16.
  // `Op.CallIface` is already a full safepoint/clobber point for regalloc
  // (isSafepointOp), so this extra call on the cold path needs no register
  // preservation of its own.
  //
  // #4379: CBNZ, not `cmp recv, xzr` + `b.ne` — the same one-for-two trade
  // #4355 made in `emitCallValue` (arm64callvalue.bit), on the same helper,
  // testing the full 64-bit register directly and writing no flags (the `sub recv, #16` that
  // follows passes setFlags=false and nothing here reads NZCV). Interface
  // dispatch carries this shape at ~10x the closure-call site count — 492
  // against 50 in the compiler's own binary. Like the closure check it cannot
  // be hoisted out of a loop: LICM (optloopcand.bit) moves instructions, not
  // branches, and the panic must fire at the first dispatch rather than at
  // loop entry, so a loop that runs zero times must not perform it at all
  // (`_tests_/cases/run_nil_iface_zero_trip.bit`).
  let niFixup = emitLocalCbz(cx, true, recv) // non-nil -> skip the panic call
  emitCallReloc(cx, "bit_rt_panic_nil_iface")
  patchLocalCondBranch(cx, niFixup)
  addSubImmediate(cx.code, addSubImm(true, 16, false), false, scratch2(), recv) // x10 = recv - 16
  loadImm(cx.code, scratch2(), scratch2(), 0, 8, false)                         // x10 = info
  emitIfaceCacheProbe(cx, ins.name)                                             // x11 = cached fn, Z = hit
  let hit = emitLocalCondBranch(cx, condEq())
  emitIfaceCacheMiss(cx, ins.ival)
  patchLocalCondBranch(cx, hit)
  marshalArgs(cx, ins.args, 1, 0)
  movRR(cx.code, argReg(RegClass.Int, 0), getInt(cx, vregOf(cx, ins.lhs), scratch1())) // x0 = recv
  blr(cx.code, scratch3())
  recordSafepoint(cx, codeLen(cx))
}

// The inline cache's hit test (#5965, ABI.md §2.1). x9 = &cell, x11 = the
// cached code address, flags EQ iff the cached info is the receiver's (x10).
// The cell's `info` is read with LDAR before its `fn`: the miss path stores
// `fn` first and `info` with release, so an acquired `info` that matches
// carries its own `fn`. The receiver in x9 is dead here; it is reloaded from
// its home after marshaling. x16 is free: no call sits between its write and
// its read.
fn emitIfaceCacheProbe(cx: A64Ctx, cell: string) {
  emitAddrOf(cx, scratch1(), cell)                      // x9 = &cell
  ldar(cx.code, 3, scratch1(), ascratch1())             // x16 = cell.info
  loadImm(cx.code, scratch3(), scratch1(), 8, 8, false) // x11 = cell.fn
  cmpRR(cx.code, ascratch1(), scratch2())
}

// The miss path (ABI.md §2.1): x11 = the method's code address for the info
// in x10. A cell already bound to another type (x11, its `fn`, non-zero) can
// never bind again, so that site calls bit_rt_iface_lookup directly: a site
// that keeps missing pays the probe and one CBNZ over what it paid before the
// cache, and no extra call level. Only an unbound cell goes through
// bit_rt_iface_lookup_ic, which may bind it.
fn emitIfaceCacheMiss(cx: A64Ctx, methodId: int) {
  movRR(cx.code, argReg(RegClass.Int, 0), scratch2())  // x0 = info
  movImm64(cx.code, argReg(RegClass.Int, 1), methodId) // x1 = id
  let bound = emitLocalCbz(cx, true, scratch3())
  movRR(cx.code, argReg(RegClass.Int, 2), scratch1()) // x2 = &cell
  emitCallReloc(cx, "bit_rt_iface_lookup_ic")
  let done = codeLen(cx)
  emitWord(cx.code, 0x14000000) // B over the plain lookup
  patchLocalCondBranch(cx, bound)
  emitCallReloc(cx, "bit_rt_iface_lookup")
  patchBranchTo(cx.code, done, codeLen(cx), true)
  movRR(cx.code, scratch3(), retRegNum()) // x11 = fn, survives marshaling
}

// #5446: the one-word form. The dispatch sequence above and the BINDING are
// split for the same reason `emitCall`/`emitCallSeq` are — only the binding
// differs between a one-handle result and a word run, and one sequence means
// the nil check, the lookup and the safepoint cannot drift between them.
fn emitCallIface(cx: A64Ctx, dst: int, dstTy: int, ins: IrInstr) {
  emitCallIfaceSeq(cx, ins)
  bindCallResult(cx, dst, dstTy, false)
}

// #5446: the multi-word form. Instruction `i` is the `Op.CallIface` (word 0)
// and the `w - 1` `Op.CallWord`s immediately after it carry the rest, so ONE
// `bindCallResults` binds every word — nothing may be emitted between the
// `blr` and the last binding (#4236), which is why the whole run is compiled
// here rather than one word at a time. Identical to `emitCallWords` (arm64call.bit) but
// for the sequence it wraps; a vtable callee returns its words in the same ABI
// registers a direct one does, so the binding is the same call.
fn emitCallIfaceWords(cx: A64Ctx, i: int, ins: IrInstr, w: int) {
  let dsts = callWordDsts(cx, i, w)
  let tys = callWordTys(cx, i, w)
  emitCallIfaceSeq(cx, ins)
  bindCallResults(cx, dsts, tys, false)
}
