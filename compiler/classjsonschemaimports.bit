// compiler/classjsonschemaimports.bit — the import declaration a
// cross-module `jsonSchema<T>()` call needs (#6170), mirroring
// classjsondecodeimports.bit.
//
// UNLIKE DECODE, THIS IS THE ONLY IMPORT THE FEATURE EVER SYNTHESIZES. A
// module that gains a `__json_schema_<Name>()` function needs no stdlib
// runtime helper import the way a decoder needs `jsonDecObject`/
// `jsonDecStringKey`/etc: #6165's fragment builder calls nothing from
// stdlib/json at all, only `Json`/`JsonEntry` constructors, which the
// class's own `@json` mark ALREADY forces its declaring module to import
// (E0142, classjson.bit) — unconditionally, whether or not `jsonSchema<T>`
// is ever called on it. So the one real gap is narrower than decode's own:
// a module that only CALLS another module's `__json_schema_<Name>()`
// (`needMod != classMod`) needs that one name imported, and nothing else.

// One name a module must import, and the path it reaches it by.
class JsonSchemaImport {
  path: string,
  word: string,
}

// The schema functions module `mid` calls that another module declares —
// `path != ""` is exactly `needMod != classMod` (`addJsonSchemaNeed`'s own
// module-local need always carries `path == ""`).
fn jsonSchemaImportItems(d: JsonSchemaDemand, mid: int): []JsonSchemaImport {
  let out = []JsonSchemaImport(0)
  for n of d.needs {
    if (n.needMod == mid && n.path != "") {
      out = append(out, JsonSchemaImport{ path = n.path, word = jsonSchemaFuncName(n.className) })
    }
  }
  return out
}

// One import declaration per name above that the module does not already
// bind — a synthesized import of a name the user imported too would be
// `E0042 already declared in this scope`. `synthImportDecl`/`bound`'s
// map are `classjsondecodeimports.bit`'s own, reused rather than forked.
fn jsonSchemaNeedImports(
  m: SrcModule, st: SynthText, d: JsonSchemaDemand, mid: int, bound: map<string, bool>,
): []int {
  let out = []int(0)
  for it of jsonSchemaImportItems(d, mid) {
    let (_, already) = bound[it.word]
    if (already) {
      continue
    }
    bound[it.word] = true
    let decl = synthImportDecl(m, st, it.path, [it.word])
    if (decl != 0) {
      out = append(out, decl)
    }
  }
  return out
}

// The imports module `mid` needs for this feature: one schema function name
// per class it demands that another module declares. `bound` is fresh per
// call (mirroring `jsonDecodeImportDecls`'s own): the two features' words
// share no prefix (`__json_dec_`/`__json_schema_`), so nothing collides
// across them within one synthesis pass.
fn jsonSchemaImportDecls(m: SrcModule, st: SynthText, mid: int, d: JsonSchemaDemand): []int {
  let bound = importedLocalNames(m.tree, m.source)
  return jsonSchemaNeedImports(m, st, d, mid, bound)
}
