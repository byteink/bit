// #7920: definite facts follow reaching branches; lexical blocks only pop
// bindings. The shared transfers live in compiler/relationautoassign.bit.

fn relationAutoErrWalkLet(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  for b of kidsOf(c.tree, node) {
    let bk = kidsOf(c.tree, b)
    if (bk[2] != 0) {
      relationAutoErrWalk(c, bk[2], ctx)
    }
    for pair of relationAutoLetPairs(c, bk[0], bk[2]) {
      relationAutoErrBindLet(c, pair, ctx)
    }
  }
}

fn relationAutoErrBindLet(
  c: Checker, pair: RelationAutoLetPair, ctx: RelationAutoErrCtx,
) {
  ctx.errSt.loaded = relationAutoLiteralFacts(c, pair.pat, pair.init, ctx.errSt.loaded)
  if (ctx.pass.collect) {
    relationAutoHolderNoteLet(c, pair.pat, pair.init, ctx)
  }
  let flow = relationAutoResolve(c, pair.init, ctx.st)
  if (!flow.found) {
    return
  }
  ctx.st.bindings = append(
    ctx.st.bindings,
    RelationAutoBinding{
      symbol = relationAutoSymbol(c, pair.pat), cls = flow.cls, queryCall = flow.queryCall,
      paramName = flow.paramName, isSlice = flow.isSlice,
      ownerModule = flow.ownerModule, path = flow.path,
    },
  )
}

fn relationAutoErrWalkForOf(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  relationAutoErrWalk(c, k[1], ctx)
  let flow = relationAutoResolve(c, k[1], ctx.st)
  if (ctx.pass.collect) {
    relationAutoHolderNoteForOf(c, k[0], flow, ctx)
  }
  let pushed = k[0] != 0 && getNode(c.tree, k[0]).tag == Tag.Ident && flow.found && flow.isSlice
  if (pushed) {
    ctx.st.bindings = append(
      ctx.st.bindings,
      RelationAutoBinding{
        symbol = relationAutoSymbol(c, k[0]), cls = flow.cls, queryCall = flow.queryCall,
        paramName = flow.paramName, isSlice = false, ownerModule = flow.ownerModule, path = flow.path,
      },
    )
  }
  relationAutoErrWalk(c, k[2], ctx)
  if (pushed) {
    ctx.st.bindings = ctx.st.bindings[0:len(ctx.st.bindings) - 1]
  }
}

fn relationAutoErrWalkAssign(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  let targets = kidsOf(c.tree, k[0])
  for t of targets {
    relationAutoErrWalk(c, relationAutoAssignWalkee(c, t), ctx)
  }
  for v of kidsOf(c.tree, k[1]) {
    relationAutoErrWalk(c, v, ctx)
  }
  if (ctx.pass.collect) {
    relationAutoHolderNoteAssign(c, node, ctx)
  }
  if (getNode(c.tree, node).main != int(Kind.Eq)) {
    return
  }
  ctx.errSt.loaded = relationAutoMarkAssigned(c, node, ctx.errSt.loaded)
}

fn relationAutoErrWalkScoped(c: Checker, node: int, tag: Tag, ctx: RelationAutoErrCtx): bool {
  if (relationAutoErrWalkConditional(c, node, tag, ctx)) {
    return true
  }
  if (tag == Tag.Block) {
    let save = len(ctx.st.bindings)
    for k of kidsOf(c.tree, node) {
      relationAutoErrWalk(c, k, ctx)
    }
    ctx.st.bindings = ctx.st.bindings[0:save]
    return true
  }
  if (tag == Tag.LetDecl) {
    relationAutoErrWalkLet(c, node, ctx)
    return true
  }
  if (tag == Tag.MatchStmt) {
    relationAutoErrWalkMatch(c, node, ctx)
    return true
  }
  if (tag == Tag.Assign) {
    relationAutoErrWalkAssign(c, node, ctx)
    return true
  }
  return false
}

fn relationAutoErrWalkIf(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  relationAutoErrWalk(c, k[0], ctx)
  let entry = ctx.errSt.loaded
  relationAutoErrWalk(c, k[1], ctx)
  let left = ctx.errSt.loaded
  ctx.errSt.loaded = entry
  relationAutoErrWalk(c, k[2], ctx)
  if (vDiverges(c, k[1], false)) {
    return
  }
  if (vDiverges(c, k[2], false)) {
    ctx.errSt.loaded = left
    return
  }
  ctx.errSt.loaded = relationAutoFactsMeet(left, ctx.errSt.loaded)
}

fn relationAutoErrWalkLoop(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let tag = getNode(c.tree, node).tag
  let k = kidsOf(c.tree, node)
  if (tag == Tag.ForC) {
    relationAutoErrWalk(c, k[0], ctx)
  }
  let entry = relationAutoLoopFacts(c, node, ctx.errSt.loaded)
  ctx.errSt.loaded = entry
  if (tag == Tag.ForOf) {
    relationAutoErrWalkForOf(c, node, ctx)
  } else if (tag == Tag.ForC) {
    relationAutoErrWalk(c, k[1], ctx)
    relationAutoErrWalk(c, k[3], ctx)
    relationAutoErrWalk(c, k[2], ctx)
  } else {
    for child of k {
      relationAutoErrWalk(c, child, ctx)
    }
  }
  ctx.errSt.loaded = entry
}

fn relationAutoErrWalkCases(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let tag = getNode(c.tree, node).tag
  let clauses = kidsOf(c.tree, node)
  let hasDefault = tag == Tag.SelectStmt
  if (tag == Tag.SwitchStmt) {
    relationAutoErrWalk(c, clauses[0], ctx)
    clauses = kidsOf(c.tree, clauses[1])
  }
  let entry = ctx.errSt.loaded
  let joined = []RelationAutoErrLoaded(0)
  let seen = false
  for clause of clauses {
    ctx.errSt.loaded = entry
    relationAutoErrWalk(c, clause, ctx)
    let ck = kidsOf(c.tree, clause)
    let ct = getNode(c.tree, clause).tag
    if (ct == Tag.SwitchDefault || ct == Tag.CommDefault) {
      hasDefault = true
    }
    let body = ck[len(ck) - 1]
    if (!vBlockDiverges(c, body, false)) {
      joined = relationAutoJoinCaseFacts(joined, ctx.errSt.loaded, seen)
      seen = true
    }
  }
  if (!hasDefault) {
    joined = relationAutoJoinCaseFacts(joined, entry, seen)
  }
  ctx.errSt.loaded = joined
}

fn relationAutoErrWalkConditional(c: Checker, node: int, tag: Tag, ctx: RelationAutoErrCtx): bool {
  if (tag == Tag.IfStmt) {
    relationAutoErrWalkIf(c, node, ctx)
    return true
  }
  if (relationAutoIsLoop(tag)) {
    relationAutoErrWalkLoop(c, node, ctx)
    return true
  }
  if (tag == Tag.SwitchStmt || tag == Tag.SelectStmt) {
    relationAutoErrWalkCases(c, node, ctx)
    return true
  }
  if (tag == Tag.DeferStmt || tag == Tag.CatchBind) {
    let entry = ctx.errSt.loaded
    for child of kidsOf(c.tree, node) {
      relationAutoErrWalk(c, child, ctx)
    }
    ctx.errSt.loaded = relationAutoFactsMeet(entry, ctx.errSt.loaded)
    return true
  }
  return false
}
