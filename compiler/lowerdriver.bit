// compiler/lowerdriver.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// The most instantiations Pass A1 may ADD to the ledger. Polymorphic recursion
// (`f<T>` calling `f<Box<T>>`) has no finite monomorphization, so the closure
// needs a hard stop; running out of budget leaves the ledger exactly as
// incomplete as it was before the pass existed, which means the build refuses
// with "cannot lower" rather than looping forever.
const closureBudget = 4096

// Every `call` node in the subtree rooted at `node`, in source order.
//
// An explicit stack rather than recursion, and bounded by the arena's own size:
// this runs over trees the parser produced, but a walker whose only termination
// argument is "the tree is a tree" is one malformed node away from not
// terminating at all.
fn subtreeCallNodes(t: Tree, node: int): []int {
  let out = []int(0)
  if (node == 0) {
    return out
  }
  let stack = [node]
  let steps = 0
  while (len(stack) > 0 && steps < len(t.nodes)) {
    let n = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    if (getNode(t, n).tag == Tag.Call) {
      out = append(out, n)
    }
    // Pushed in reverse so the pops come out in source order, matching the
    // arena order the check pass records in.
    let kids = kidsOf(t, n)
    let i = len(kids) - 1
    while (i >= 0) {
      if (kids[i] != 0) {
        stack = append(stack, kids[i])
      }
      i = i - 1
    }
    steps = steps + 1
  }
  return out
}

// Records the instantiation every generic call in `node`'s subtree will ask for,
// resolved EXACTLY the way `resolveCallTarget` resolves it during lowering: same
// `funcRefAt` node keying, same `genericTypeArgs`. Any other rule would fill the
// ledger with instances the emitted calls do not name, which is the failure this
// pass exists to end rather than move.
//
// `bareNames` selects which callee spellings to consider. A NON-generic body
// passes false: the check pass already recorded its `f(...)` calls, and only the
// dotted `ns.f(...)` spelling — which checkmodule.bit never looks at — is
// missing. An instance body passes true, because its calls must be re-resolved
// under this instantiation's bindings.
//
// `genEnv` is that instantiation's (type param -> concrete arg) map, empty for a
// non-generic body. It is applied to the INFERRED arguments for the same reason
// `nodeType` applies it to every body node's type: the body was checked once
// against unbound parameters, so an argument still typed `T` here is `i64` in
// this instance and the call binds `i64`.
fn recordSubtreeInstantiations(c: Checker, node: int, bareNames: bool, genEnv: TypeEnv) {
  let calls = subtreeCallNodes(c.tree, node)
  let i = 0
  while (i < len(calls)) {
    let callee = kidsOf(c.tree, calls[i])[0]
    let cn = getNode(c.tree, callee)
    let name = ""
    if (cn.tag == Tag.Ident && bareNames) {
      name = c.source[cn.span.start:cn.span.end]
    }
    if (cn.tag == Tag.Member) {
      let qn = nsQualifiedName(c, callee)
      if (qn != "" && funcDeclLookup(c, qn) != 0) {
        name = qn
      }
    }
    if (name != "") {
      let fr = funcRefAt(c, callee, name)
      if (funcRefIsGeneric(fr)) {
        recordInstantiation(
          c,
          fr,
          substTypeList(c, genericTypeArgs(c, name, calls[i]), genEnv),
          vSpan(c, calls[i]),
        )
      }
    }
    i = i + 1
  }
}

// Binds `decl`'s type parameters to `args` in `oc`'s flat `userTypes`, returning
// what each name held before. The same rebinding `lowerInstance` performs, and
// for the same reason: every type node re-resolved while it is in force reads
// the instantiation's concrete argument instead of the bare parameter.
fn bindTypeParams(oc: Checker, decl: int, args: []int): []int {
  let saved = []int(0)
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let j = 0
  while (j < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    saved = append(saved, userTypeLookup(oc, tpname))
    if (j < len(args)) {
      oc.userTypes[tpname] = args[j]
    }
    j = j + 1
  }
  return saved
}

// Undoes `bindTypeParams`.
fn restoreTypeParams(oc: Checker, decl: int, saved: []int) {
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let j = 0
  while (j < len(tps) && j < len(saved)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
    oc.userTypes[oc.source[tpn.span.start:tpn.span.end]] = saved[j]
    j = j + 1
  }
}

// Pass A1 — the MONOMORPHIZATION CLOSURE, run before anything is lowered.
//
// The check pass records one instantiation per generic call it sees, with the
// type arguments that call binds where it stands (checkmodule.bit). Two shapes
// escape it, and both then failed at lowering with the spanless, span-less
// "cannot lower N function(s)":
//
//   - a generic call inside a GENERIC body (#2102, #2307). The body is checked
//     ONCE, against the template's own unbound parameters, so `let a = f1(x);
//     return f2(a)` records `f2<T>`. Every monomorphization of the enclosing
//     generic then asks for `f2<i64>` — an instance nothing recorded — and the
//     whole caller was stubbed. `return f2(f1(x))` escaped only because a Call
//     argument's type is RE-COMPUTED at lowering time and so came back `<T>`
//     again, while a local's is read from the checker's table and came back
//     concrete: the two spellings disagreed about the same call.
//   - a generic reached through a NAMESPACE import (#2133), `util.idOf(7)`.
//     checkmodule.bit records only an `Ident` callee, so a dotted one recorded
//     nothing at all and `std/seq` was unusable in its namespace spelling.
//
// The ledger doubles as the worklist — an instance appended here is itself
// scanned — so a chain of generics closes transitively.
fn closeInstantiations(mods: []Checker, root: int) {
  // Step 1: the dotted generic calls in every NON-generic body. A generic
  // template is deliberately skipped here: its type parameters are not in scope
  // at this point (the flat `userTypes` holds whichever generic in the module
  // declared a `T` last, #1485), so reading its body now would bind arguments
  // off another declaration's parameters. Step 2 visits it once per
  // instantiation, with the right bindings in force.
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let m = 1
    while (m < len(c.tree.nodes)) {
      if (getNode(c.tree, m).tag == Tag.FuncDecl && !isGenericFuncDecl(c, m)) {
        recordSubtreeInstantiations(c, kidsOf(c.tree, m)[5], false, emptyTypeEnv())
      }
      m = m + 1
    }
    mi = mi + 1
  }
  // Step 2: every instantiation's own body, under that instantiation's bindings.
  let ctx = mods[root].ctx
  let budget = len(ctx.instantiations) + closureBudget
  let g = 0
  while (g < len(ctx.instantiations) && len(ctx.instantiations) < budget) {
    let inst = ctx.instantiations[g]
    if (inst.module >= 0 && inst.module < len(mods)) {
      let owner = mods[inst.module]
      let decl = funcDeclLookup(owner, inst.name)
      if (decl != 0) {
        let saved = bindTypeParams(owner, decl, inst.args)
        recordSubtreeInstantiations(
          owner, kidsOf(owner.tree, decl)[5], true,
          genericEnvOf(owner, decl, inst.args),
        )
        restoreTypeParams(owner, decl, saved)
      }
    }
    g = g + 1
  }
}

// Lowers method `decl` once per nominal instantiation of its generic receiver
// `recvName`, appending each to `out` in the checker's instantiation order (the
// seed's emission order). Returns `out` unchanged when the generic was never
// instantiated — a template has no concrete slot types, so there is nothing to
// emit and nothing that could call it.
//
// The receiver's type-argument NAMES are rebound positionally onto the concrete
// args, exactly as `lowerInstance` does for a generic function: that fixes every
// site which RE-RESOLVES a type node (the result annotation, the parameter slot
// types), while `genEnv` fixes every site that reads a type the checker already
// recorded against the template. Both are needed — see nodeType.
fn lowerMethodInstances(
  c: Checker, decl: int, consts: map<string, int>,
  lowerer: Lowerer, recvName: string, out: []IrFunc,
): []IrFunc {
  let params = declTypeParamIds(c, recvName)
  let argNames = receiverTypeParamNames(c, decl)
  let nm = getNode(c.tree, kidsOf(c.tree, decl)[1])
  let fname = c.source[nm.span.start:nm.span.end]
  let i = 0
  while (i < len(c.ctx.typeInsts)) {
    let inst = c.ctx.typeInsts[i]
    if (inst.module != c.moduleId || inst.name != recvName || len(inst.args) != len(params)) {
      i = i + 1
      continue
    }
    let saved = []int(0)
    let j = 0
    while (j < len(argNames)) {
      saved = append(saved, userTypeLookup(c, argNames[j]))
      if (j < len(inst.args)) {
        c.userTypes[argNames[j]] = inst.args[j]
      }
      j = j + 1
    }
    // Built from the METHOD's own generics list, not the class's. The parser
    // merges a receiver's `<T>` into the method's generic params (parserdecl:
    // "those params are DECLARED here"), so the body was checked against ids the
    // class decl never saw — and `genericEnvOf` additionally binds whatever the
    // name resolves to NOW, which the flat env can have moved (#1485).
    // Both the method's own type-param ids AND the class's are bound: the
    // class's `items: []T` was typed against the class's `T`, the method's
    // `v: T` against the method's, and a body mentions both. `genericEnvOf`
    // supplies the method half (plus whatever the name resolves to now, #1485).
    let genEnv = genericEnvOf(c, decl, inst.args)
    let sids = declTypeParamIds(c, recvName)
    let s = 0
    while (s < len(sids) && s < len(inst.args)) {
      if (sids[s] != 0) {
        genEnv.params = append(genEnv.params, sids[s])
        genEnv.args = append(genEnv.args, inst.args[s])
      }
      s = s + 1
    }
    out = append(
      out,
      lowerFuncNamed(
        c, decl, consts, lowerer,
        lowerer.modPrefix + fname + "\$t${inst.result}", genEnv,
      ),
    )
    j = 0
    while (j < len(argNames)) {
      c.userTypes[argNames[j]] = saved[j]
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// The type-parameter names a method declares, in order — the `A, B` of
// `(p: Pair<A, B>) first()`. The parser merges a receiver's `<...>` in FRONT of
// the method's own `<...>`, so this one list covers both, and position is what
// lines it up with an instantiation's arguments (a method may name the
// receiver's parameters differently from the class declaration, #1325).
fn receiverTypeParamNames(c: Checker, decl: int): []string {
  let out = []string(0)
  let genNode = kidsOf(c.tree, decl)[2]
  if (genNode == 0) {
    return out
  }
  let tps = kidsOf(c.tree, genNode)
  let i = 0
  while (i < len(tps)) {
    let n = getNode(c.tree, kidsOf(c.tree, tps[i])[0])
    out = append(out, c.source[n.span.start:n.span.end])
    i = i + 1
  }
  return out
}

// Lowers generic instantiation `g` of module `c` — the type params bound to the
// instantiation's concrete args for the duration, then restored.
fn lowerInstance(
  c: Checker, consts: map<string, int>, lowerer: Lowerer, g: int,
  prefix: string,
): IrFunc {
  let inst = c.ctx.instantiations[g]
  // `c` IS the declaring module (lowerProject picks it), so the template's decl
  // and every type name it mentions resolve in this checker's own tree.
  let decl = funcDeclLookup(c, inst.name)
  let tps = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  // Built BEFORE the rebinding below, so it captures the template's own TypeParam
  // ids — what the body's checked types actually mention. Rebinding `userTypes`
  // only fixes sites that RE-RESOLVE a type node during lowering; every site that
  // reads a checked node type needs this env instead (see nodeType).
  let genEnv = genericEnvOf(c, decl, inst.args)
  let saved = []int(0)
  let j = 0
  while (j < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[j])[0])
    let tpname = c.source[tpn.span.start:tpn.span.end]
    saved = append(saved, userTypeLookup(c, tpname))
    if (j < len(inst.args)) {
      c.userTypes[tpname] = inst.args[j]
    }
    j = j + 1
  }
  let f = lowerFuncNamed(c, decl, consts, lowerer, "${prefix}${inst.name}\$${g}", genEnv)
  j = 0
  while (j < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[j])[0])
    c.userTypes[c.source[tpn.span.start:tpn.span.end]] = saved[j]
    j = j + 1
  }
  return f
}

// One module on its own — the single-file path (`--dump-ir`, `bit2 build
// <file.bit>`). Delegates to lowerProject so there is exactly ONE lowering
// order: with a single module that IS the root, every prefix is empty and the
// output is what it was before modules existed. This is also why the existing
// single-file IR differential covers lowerProject.
fn lowerModuleIr(c: Checker): IrModule {
  return lowerProject([c], 0)
}

// Parse -> check -> lower -> render IR text, the `bit2 --dump-ir` pipeline.
// Builds `src`'s IR module: parse -> check -> lower.
fn lowerSourceModule(src: string): IrModule {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return lowerModuleIr(c)
}

// The raw lowering dump (`--dump-ir-pre`).
fn lowerSourceDump(src: string): string {
  return dumpIr(lowerSourceModule(src))
}

// The optimized dump (`--dump-ir`): the seed runs its -O1 pipeline before
// rendering, so bit2 must too for the post-opt differential.
fn lowerSourceDumpOpt(src: string): string {
  let m = lowerSourceModule(src)
  optimizeModule(m)
  return dumpIr(m)
}

// Pass A3' — every method decl in the project, in exactly the order Pass A3
// lowers them (module order, then node order, `FuncDecl` with a receiver).
// Split out of `lowerFuncNamed` so the entries, and therefore the dispatch ids,
// exist before the first body is lowered (#1471). Everything an entry holds is
// derivable from the decl alone, so this needs no lowering state beyond the
// module prefix.
fn collectMethodEntries(mods: []Checker, root: int, lw: Lowerer) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lw.modPrefix = modulePrefix(mi, root)
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0) {
        let kids = kidsOf(c.tree, m)
        let nm = getNode(c.tree, kids[1])
        lw.methodEntries = append(
          lw.methodEntries,
          MethodEntry{
            recvTy: userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1])),
            name: c.source[nm.span.start:nm.span.end], prefix: lw.modPrefix,
          },
        )
      }
      m = m + 1
    }
    mi = mi + 1
  }
}

// Per-type method tables (runtime/ABI.md §2.1) from Pass A3's entries: one table
// per distinct receiver type in first-seen order, each holding that type's
// methods in declaration order with their global dispatch ids. call_iface
// resolves through these at runtime.
fn buildMethodTables(lw: Lowerer): []MethodTable {
  let tables = []MethodTable(0)
  let seen = map<int, bool>{}
  let i = 0
  while (i < len(lw.methodEntries)) {
    let disc = lw.methodEntries[i].recvTy
    let (_, already) = seen[disc]
    if (already) {
      i = i + 1
      continue
    }
    seen[disc] = true
    let methods = []MethodSlot(0)
    let j = 0
    while (j < len(lw.methodEntries)) {
      if (lw.methodEntries[j].recvTy == disc) {
        // The id is assigned from the raw name (global across modules); the
        // symbol carries the declaring module's prefix.
        methods = append(
          methods,
          MethodSlot{
            id: methodId(lw, lw.methodEntries[j].name),
            func: lw.methodEntries[j].prefix + lw.methodEntries[j].name + "\$t${disc}",
          },
        )
      }
      j = j + 1
    }
    tables = append(tables, MethodTable{ typeDisc: disc, methods: methods })
    i = i + 1
  }
  return tables
}

// The value of a NAME that is not a local: a module-level `let` cell, a
// module-level const (inlined at the use site), or a top-level function taken
// as a first-class value. Every lookup here is name-keyed, so a namespace
// member `ns.c` passes its DOTTED key and resolves exactly as a plain import
// of the same symbol would (see check.bit `bindNamespaceImport`).
fn lowerNamedValue(fc: FnCtx, node: int, name: string): int {
  let slot = envIndex(fc, name)
  if (slot != -1) {
    return localRead(fc, slot)
  }
  // Not a local: a module-level `let` (§11.11) is a static cell. An `[N]T`
  // array IS its base address in this IR (IndexGet/IndexSet take an
  // element-base pointer), so the address is the value; every other
  // admissible type is one word in the cell, so it takes one load — FieldGet
  // at offset 0, the same op `*p` lowers to.
  let gsym = moduleGlobalSym(fc, name)
  if (gsym != "") {
    let addr = emitGlobalAddrVal(fc, gsym)
    let gty = nodeType(fc, node)
    if (fc.c.ctx.types[gty].kind == TypeKind.Array) {
      return addr
    }
    let ld = mkInstr(Op.FieldGet, gty)
    ld.lhs = addr
    ld.ival = 0
    return builderEmit(fc.b, ld)
  }
  // Not a local: a module-level const inlines its initializer at the use site.
  // An IMPORTED const's initializer node indexes its OWN module's arena, so it
  // must be lowered against that module's checker — reading the node against
  // this tree lands on an unrelated node (the declOwner rule). Both the tree
  // and the const table are swapped for the duration, so an initializer that
  // references another const of its own module resolves there too.
  // ponytail: the owner's const table is rescanned per imported reference —
  // consts are rare; cache it on the Lowerer if a project ever makes it hot.
  let oc = declOwner(fc.c, name)
  let ocName = declName2(fc.c, name)
  let ocConsts = fc.moduleConsts
  if (oc.moduleId != fc.c.moduleId) {
    ocConsts = collectModuleConsts(oc)
  }
  for (k, initNode) of ocConsts {
    if (k == ocName) {
      let savedC = fc.c
      let savedConsts = fc.moduleConsts
      fc.c = oc
      fc.moduleConsts = ocConsts
      // The const's own DECLARED type, not the reference site's context: the
      // reference `x` already types as f64 via `moduleEnv`, but an untyped
      // literal INSIDE the initializer only adopts that type if it is passed
      // down as `lowerExprH`'s hint. Unhinted (plain `lowerExpr`), `const K:
      // f64 = 1` inlined `const_int i64 1` at every use site — the same
      // integer-bit-pattern bug as #2429's `let`, one level removed (the
      // literal never sees the declared type, only the untyped default).
      let (hintTy, hasHint) = oc.moduleEnv[ocName]
      if (!hasHint) {
        hintTy = 0
      }
      let cv = lowerExprH(fc, initNode, hintTy)
      fc.c = savedC
      fc.moduleConsts = savedConsts
      return cv
    }
  }
  // A bare top-level function used as a first-class value: wrap it in a closure
  // over a nil env and its trampoline.
  if (funcRefAt(fc.c, node, name).decl != 0) {
    let fnTy = funcSigLookup(fc.c, name)
    let fid = fnValueTrampoline(fc, name)
    let nl = mkInstr(Op.ConstNil, fnTy)
    let mc = mkInstr(Op.MakeClosure, fnTy)
    mc.name = "fnvalue\$trampoline\$${fid}"
    mc.lhs = builderEmit(fc.b, nl)
    return builderEmit(fc.b, mc)
  }
  fcFail(
    fc,
    getNode(fc.c.tree, node).span,
    "a name that does not resolve to a local, a module constant, a global or a function",
  )
  return 0
}
