// compiler/lowerdriver.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// Lowers method `decl` once per nominal instantiation of its generic receiver
// `recvName`, appending each to `out` in the checker's instantiation order (the
// seed's emission order). Returns `out` unchanged when the generic was never
// instantiated — a template has no concrete slot types, so there is nothing to
// emit and nothing that could call it.
//
// The receiver's type-argument NAMES are rebound positionally onto the concrete
// args, exactly as `lowerInstance` does for a generic function: that fixes every
// site which RE-RESOLVES a type node (the result annotation, the parameter slot
// types), while `genEnv` fixes every site that reads a type the checker already
// recorded against the template. Both are needed — see nodeType.
function lowerMethodInstances(c: Checker, decl: int, consts: map<string, int>,
    lowerer: Lowerer, recvName: string, out: []IrFunc): []IrFunc {
  let params = declTypeParamIds(c, recvName)
  let argNames = receiverTypeParamNames(c, decl)
  let nm = getNode(c.tree, kidsOf(c.tree, decl)[1])
  let fname = c.source[nm.span.start:nm.span.end]
  let i = 0
  while (i < len(c.ctx.typeInsts)) {
    let inst = c.ctx.typeInsts[i]
    if (inst.module != c.moduleId || inst.name != recvName || len(inst.args) != len(params)) {
      i = i + 1
      continue
    }
    let saved = []int(0)
    let j = 0
    while (j < len(argNames)) {
      saved = append(saved, userTypeLookup(c, argNames[j]))
      if (j < len(inst.args)) {
        c.userTypes[argNames[j]] = inst.args[j]
      }
      j = j + 1
    }
    // Built from the METHOD's own generics list, not the struct's. The parser
    // merges a receiver's `<T>` into the method's generic params (parserdecl:
    // "those params are DECLARED here"), so the body was checked against ids the
    // struct decl never saw — and `genericEnvOf` additionally binds whatever the
    // name resolves to NOW, which the flat env can have moved (#1485).
    // Both the method's own type-param ids AND the struct's are bound: the
    // struct's `items: []T` was typed against the struct's `T`, the method's
    // `v: T` against the method's, and a body mentions both. `genericEnvOf`
    // supplies the method half (plus whatever the name resolves to now, #1485).
    let genEnv = genericEnvOf(c, decl, inst.args)
    let sids = declTypeParamIds(c, recvName)
    let s = 0
    while (s < len(sids) && s < len(inst.args)) {
      if (sids[s] != 0) {
        genEnv.params = append(genEnv.params, sids[s])
        genEnv.args = append(genEnv.args, inst.args[s])
      }
      s = s + 1
    }
    out = append(out, lowerFuncNamed(c, decl, consts, lowerer,
      lowerer.modPrefix + fname + "\$t${inst.result}", genEnv))
    j = 0
    while (j < len(argNames)) {
      c.userTypes[argNames[j]] = saved[j]
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// The type-parameter names a method declares, in order — the `A, B` of
// `(p: Pair<A, B>) first()`. The parser merges a receiver's `<...>` in FRONT of
// the method's own `<...>`, so this one list covers both, and position is what
// lines it up with an instantiation's arguments (a method may name the
// receiver's parameters differently from the struct declaration, #1325).
function receiverTypeParamNames(c: Checker, decl: int): []string {
  let out = []string(0)
  let genNode = kidsOf(c.tree, decl)[2]
  if (genNode == 0) {
    return out
  }
  let tps = kidsOf(c.tree, genNode)
  let i = 0
  while (i < len(tps)) {
    let n = getNode(c.tree, kidsOf(c.tree, tps[i])[0])
    out = append(out, c.source[n.span.start:n.span.end])
    i = i + 1
  }
  return out
}

// Lowers generic instantiation `g` of module `c` — the type params bound to the
// instantiation's concrete args for the duration, then restored.
function lowerInstance(c: Checker, consts: map<string, int>, lowerer: Lowerer, g: int,
    prefix: string): IrFunc {
  let inst = c.ctx.instantiations[g]
  // `c` IS the declaring module (lowerProject picks it), so the template's decl
  // and every type name it mentions resolve in this checker's own tree.
  let decl = funcDeclLookup(c, inst.name)
  let tps = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  // Built BEFORE the rebinding below, so it captures the template's own TypeParam
  // ids — what the body's checked types actually mention. Rebinding `userTypes`
  // only fixes sites that RE-RESOLVE a type node during lowering; every site that
  // reads a checked node type needs this env instead (see nodeType).
  let genEnv = genericEnvOf(c, decl, inst.args)
  let saved = []int(0)
  let j = 0
  while (j < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[j])[0])
    let tpname = c.source[tpn.span.start:tpn.span.end]
    saved = append(saved, userTypeLookup(c, tpname))
    if (j < len(inst.args)) {
      c.userTypes[tpname] = inst.args[j]
    }
    j = j + 1
  }
  let f = lowerFuncNamed(c, decl, consts, lowerer, "${prefix}${inst.name}\$${g}", genEnv)
  j = 0
  while (j < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[j])[0])
    c.userTypes[c.source[tpn.span.start:tpn.span.end]] = saved[j]
    j = j + 1
  }
  return f
}

// One module on its own — the single-file path (`--dump-ir`, `bit2 build
// <file.bit>`). Delegates to lowerProject so there is exactly ONE lowering
// order: with a single module that IS the root, every prefix is empty and the
// output is what it was before modules existed. This is also why the existing
// single-file IR differential covers lowerProject.
function lowerModuleIr(c: Checker): IrModule {
  return lowerProject([c], 0)
}

// Parse -> check -> lower -> render IR text, the `bit2 --dump-ir` pipeline.
// Builds `src`'s IR module: parse -> check -> lower.
function lowerSourceModule(src: string): IrModule {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return lowerModuleIr(c)
}

// The raw lowering dump (`--dump-ir-pre`).
function lowerSourceDump(src: string): string {
  return dumpIr(lowerSourceModule(src))
}

// The optimized dump (`--dump-ir`): the seed runs its -O1 pipeline before
// rendering, so bit2 must too for the post-opt differential.
function lowerSourceDumpOpt(src: string): string {
  let m = lowerSourceModule(src)
  optimizeModule(m)
  return dumpIr(m)
}

// Pass A3' — every method decl in the project, in exactly the order Pass A3
// lowers them (module order, then node order, `FuncDecl` with a receiver).
// Split out of `lowerFuncNamed` so the entries, and therefore the dispatch ids,
// exist before the first body is lowered (#1471). Everything an entry holds is
// derivable from the decl alone, so this needs no lowering state beyond the
// module prefix.
function collectMethodEntries(mods: []Checker, root: int, lw: Lowerer) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lw.modPrefix = modulePrefix(mi, root)
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0) {
        let kids = kidsOf(c.tree, m)
        let nm = getNode(c.tree, kids[1])
        lw.methodEntries = append(lw.methodEntries,
          MethodEntry{ recvTy: userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1])),
            name: c.source[nm.span.start:nm.span.end], prefix: lw.modPrefix })
      }
      m = m + 1
    }
    mi = mi + 1
  }
}

// Per-type method tables (runtime/ABI.md §2.1) from Pass A3's entries: one table
// per distinct receiver type in first-seen order, each holding that type's
// methods in declaration order with their global dispatch ids. call_iface
// resolves through these at runtime.
function buildMethodTables(lw: Lowerer): []MethodTable {
  let tables = []MethodTable(0)
  let seen = map<int, bool>{}
  let i = 0
  while (i < len(lw.methodEntries)) {
    let disc = lw.methodEntries[i].recvTy
    let (_, already) = seen[disc]
    if (already) {
      i = i + 1
      continue
    }
    seen[disc] = true
    let methods = []MethodSlot(0)
    let j = 0
    while (j < len(lw.methodEntries)) {
      if (lw.methodEntries[j].recvTy == disc) {
        // The id is assigned from the raw name (global across modules); the
        // symbol carries the declaring module's prefix.
        methods = append(methods, MethodSlot{ id: methodId(lw, lw.methodEntries[j].name),
          func: lw.methodEntries[j].prefix + lw.methodEntries[j].name + "\$t${disc}" })
      }
      j = j + 1
    }
    tables = append(tables, MethodTable{ typeDisc: disc, methods: methods })
    i = i + 1
  }
  return tables
}

// The value of a NAME that is not a local: a module-level `let` cell, a
// module-level const (inlined at the use site), or a top-level function taken
// as a first-class value. Every lookup here is name-keyed, so a namespace
// member `ns.c` passes its DOTTED key and resolves exactly as a plain import
// of the same symbol would (see check.bit `bindNamespaceImport`).
function lowerNamedValue(fc: FnCtx, node: int, name: string): int {
  let v = envValue(fc, name)
  if (v != -1) {
    return v
  }
  // Not a local: a module-level `let` (§11.11) is a static cell. An `[N]T`
  // array IS its base address in this IR (IndexGet/IndexSet take an
  // element-base pointer), so the address is the value; every other
  // admissible type is one word in the cell, so it takes one load — FieldGet
  // at offset 0, the same op `*p` lowers to.
  let gsym = moduleGlobalSym(fc, name)
  if (gsym != "") {
    let addr = emitGlobalAddrVal(fc, gsym)
    let gty = nodeType(fc, node)
    if (fc.c.ctx.types[gty].kind == TypeKind.Array) {
      return addr
    }
    let ld = mkInstr(Op.FieldGet, gty)
    ld.lhs = addr
    ld.ival = 0
    return builderEmit(fc.b, ld)
  }
  // Not a local: a module-level const inlines its initializer at the use site.
  // An IMPORTED const's initializer node indexes its OWN module's arena, so it
  // must be lowered against that module's checker — reading the node against
  // this tree lands on an unrelated node (the declOwner rule). Both the tree
  // and the const table are swapped for the duration, so an initializer that
  // references another const of its own module resolves there too.
  // ponytail: the owner's const table is rescanned per imported reference —
  // consts are rare; cache it on the Lowerer if a project ever makes it hot.
  let oc = declOwner(fc.c, name)
  let ocName = declName2(fc.c, name)
  let ocConsts = fc.moduleConsts
  if (oc.moduleId != fc.c.moduleId) {
    ocConsts = collectModuleConsts(oc)
  }
  for (k, initNode) of ocConsts {
    if (k == ocName) {
      let savedC = fc.c
      let savedConsts = fc.moduleConsts
      fc.c = oc
      fc.moduleConsts = ocConsts
      let cv = lowerExpr(fc, initNode)
      fc.c = savedC
      fc.moduleConsts = savedConsts
      return cv
    }
  }
  // A bare top-level function used as a first-class value: wrap it in a closure
  // over a nil env and its trampoline.
  if (funcRefAt(fc.c, node, name).decl != 0) {
    let fnTy = funcSigLookup(fc.c, name)
    let fid = fnValueTrampoline(fc, name)
    let nl = mkInstr(Op.ConstNil, fnTy)
    let mc = mkInstr(Op.MakeClosure, fnTy)
    mc.name = "fnvalue\$trampoline\$${fid}"
    mc.lhs = builderEmit(fc.b, nl)
    return builderEmit(fc.b, mc)
  }
  fc.failed = true
  return 0
}
