// #5990: link-time-constant heap objects, lowered to one static cell each
// instead of a `gc_alloc` per evaluation.
//
// A bare top-level function used as a value is a closure over a nil env: both
// of its words are known at link time, so every evaluation used to allocate an
// identical `{code, env}` cell. One cell per trampoline is the same value.
// That is sound because nothing writes a closure cell after `emitMakeClosure`
// fills it, the collector ignores an address it does not own (`gcMarkRoot`,
// runtime/gc/gcmark.bit), and a function value can never sit behind an
// interface (E0041), so no path reads the GC header it lacks.
//
// The cell is a process-storage global (`placeGlobals`, emit.bit), in the
// writable data section where Mach-O keeps the string-literal headers: dyld
// rebases a pointer there under PIE, and never one in `__TEXT,__const`.

// Whether this build lowers link-time constants to static cells. Default OFF:
// it changes post-opt IR and emitted code against the pinned stage0, so it
// lands dark until the next repin flips the default (`BIT_BCE_JOIN` pattern,
// `compiler/optbce.bit`). Never on for `--freestanding`, whose objects are
// archived one module each and must keep refusing a managed closure
// (`refuseManagedMetadata`, emit.bit). TEMPORARY, like `bceJoinEnabled`.
fn staticConstEnabled(freestanding: bool): bool {
  return envOr("BIT_STATIC_CONST", "") == "1" && !freestanding
}

// The static closure cell for trampoline `fid`, laid out as `emitMakeClosure`
// lays out a heap one: the code address at +0 (an abs64 fixup to the
// trampoline), the env at +8 (0). Registered on the first reference, which is
// the reference that created the trampoline, so the cell's owner module is the
// trampoline's.
fn staticClosureAddr(fc: FnCtx, fid: int, fnTy: int): int {
  let sym = "__bitfnv_${fid}"
  if (!staticCellKnown(fc.lowerer, sym)) {
    fc.lowerer.globals = append(
      fc.lowerer.globals,
      IrGlobal{
        name = sym, bytes = []int(16), align = 8, storage = 0,
        relocs = [IrGlobalReloc{ offset = 0, symbol = "fnvalue\$trampoline\$${fid}", addend = 0 }],
        inRootModule = fc.lowerer.curModule == fc.lowerer.root,
      },
    )
  }
  let ga = mkInstr(Op.GlobalAddr, fnTy)
  ga.name = sym
  return builderEmit(fc.b, ga)
}

// Whether a global named `sym` is already registered. Bounded by the module's
// global count.
fn staticCellKnown(lo: Lowerer, sym: string): bool {
  for g of lo.globals {
    if (g.name == sym) {
      return true
    }
  }
  return false
}
