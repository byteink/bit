// Self-host: E0068 for a generic CALL whose type arguments cannot be inferred
// (SPEC §15.3). Its own sibling file because validatecall.bit is 799 lines and
// validateexpr.bit — which owns the other half of this same rule, `vInferEnum`
// — is 767, so neither fits the 800-line limit (spec/LINT.md E0200); the split
// follows validatevariant.bit's, made for the same reason.
//
// `vInferEnum` reports the un-annotated BINDING context, `let x = Enum.Variant`,
// and its header says it is restricted there because "an annotation, a return
// target, or a call-argument slot all supply" the expectation. That last clause
// is only true of a NON-GENERIC callee, and #4560 is what falsifies it: in
//
//     fn viaFree<T: Named>(q: Option<T>): string { ... }
//     viaFree(Option.None)
//
// the slot's declared type is `Option<T>` and nothing in the call names `T`, so
// the slot supplies nothing. SPEC §15.3 is explicit — "if any type parameter
// cannot be inferred, the call is an error and explicit type arguments are
// required" — and this is the second, and last, context where the expectation
// is provably absent. It is not an Option rule: any generic enum's payload-less
// variant reaches it, and so does any other argument that names no type
// parameter.
//
// What happened instead, before this: `genericTypeArgs` fabricated `void` for
// the gap, `recordInstantiation` accepted the entry (#4499's `instArgsAreConcrete`
// refuses a `TypeKind.TypeParam` arg, and `void` is not one), Pass A2 emitted the
// body, and `t.label()` in the template's `Some` arm has a receiver that is
// neither class nor interface. So `bit check` exited 0 and lowering refused the
// whole program with E0092 pointed INSIDE a correct generic body — killing the
// `viaFree(Option.Some(Tag{}))` call in the same `main` that inferred fine.

// Whether inference left a gap in `targs`, reporting E0068 at the call site when
// the gap is the PROGRAM's and not the checker's.
//
// THE SAFETY RULE (validate.bit) decides the difference, and it is decided by the
// argument TYPES rather than by the shape of any one argument: an argument the
// checker could not type at all is `TypeKind.Invalid`, and a gap under one of
// those says the binder failed, not the program. Measured on `main` at 6f5eb7f5
// over this whole repo — compiler, stdlib, runtime, tools, pkg, examples,
// _tests_/imports and all 719 `_tests_/cases` — exactly ONE call reaches here,
// `unwrap(v)` at pkg/redis/client.test.bit:89, and its argument types are
// `<error>`: that program builds and runs today, and judging it would reject
// it. Inverting this one condition rejects it, which is how that was measured.
//
// The caller bails on `true` exactly as it always did, so an undecidable gap is
// still silence and not a diagnostic.
fn vGenericGap(c: Checker, node: int, owner: Checker, decl: int, targs: []int): bool {
  let i = 0
  while (i < len(targs)) {
    if (targs[i] == 0 || targs[i] == c.ctx.voidId) {
      if (vCallArgTypesKnown(c, node)) {
        reportNoHint(
          c.diags, ecCannotInfer, vSpan(c, node),
          "cannot infer type parameter '${vGenericParamName(owner, decl, i)}'; give explicit type arguments",
        )
      }
      return true
    }
    i = i + 1
  }
  return false
}

// A type parameter's own spelling, read from the DECLARING module's tree: the
// decl may be imported, and its node indices mean nothing in this module's.
fn vGenericParamName(owner: Checker, decl: int, idx: int): string {
  let tps = kidsOf(owner.tree, kidsOf(owner.tree, decl)[2])
  if (idx >= len(tps)) {
    return "?"
  }
  let n = getNode(owner.tree, kidsOf(owner.tree, tps[idx])[0])
  return owner.source[n.span.start:n.span.end]
}

// Whether every argument of this call has a type at all. Reached only from
// `vCallGenericEnv`, which runs after `vCallArity` has proven the call decidable
// — a known, non-spread free function whose arity matches — and which since
// #4548 bails ahead of here for a VARIADIC callee, so the argument list this
// walks is still the fixed-arity one the parameter list was bound against.
fn vCallArgTypesKnown(c: Checker, node: int): bool {
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let i = 0
  while (i < len(args)) {
    let t = checkArgType(c, node, i)
    if (t == 0 || c.ctx.types[t].kind == TypeKind.Invalid) {
      return false
    }
    i = i + 1
  }
  return true
}
