// Self-host: validation of a generic CALL's type arguments (SPEC §15.3) — both
// E0068, when inference cannot produce them, and E0051, when it produces one
// that breaks its type parameter's declared bound. Its own sibling file because
// validatecall.bit is 799 lines and validateexpr.bit — which owns the other half
// of the E0068 rule, `vInferEnum` — was 771, so neither fits the 800-line limit
// (spec/LINT.md E0200); the split follows validatevariant.bit's, made for the
// same reason. E0051 moved in from validateexpr.bit with #4634.
//
// `vInferEnum` reports the un-annotated BINDING context, `let x = Enum.Variant`,
// and its header says it is restricted there because "an annotation, a return
// target, or a call-argument slot all supply" the expectation. That last clause
// is only true of a NON-GENERIC callee, and #4560 is what falsifies it: in
//
//     fn viaFree<T: Named>(q: Option<T>): string { ... }
//     viaFree(Option.None)
//
// the slot's declared type is `Option<T>` and nothing in the call names `T`, so
// the slot supplies nothing. SPEC §15.3 is explicit — "if any type parameter
// cannot be inferred, the call is an error and explicit type arguments are
// required" — and this is the second, and last, context where the expectation
// is provably absent. It is not an Option rule: any generic enum's payload-less
// variant reaches it, and so does any other argument that names no type
// parameter.
//
// What happened instead, before this: `genericTypeArgs` fabricated `void` for
// the gap, `recordInstantiation` accepted the entry (#4499's `instArgsAreConcrete`
// refuses a `TypeKind.TypeParam` arg, and `void` is not one), Pass A2 emitted the
// body, and `t.label()` in the template's `Some` arm has a receiver that is
// neither class nor interface. So `bit check` exited 0 and lowering refused the
// whole program with E0092 pointed INSIDE a correct generic body — killing the
// `viaFree(Option.Some(Tag{}))` call in the same `main` that inferred fine.

// Whether inference left a gap in `targs`, reporting E0068 at the call site when
// the gap is the PROGRAM's and not the checker's.
//
// THE SAFETY RULE (validate.bit) decides the difference, and it is decided by the
// argument TYPES rather than by the shape of any one argument: an argument the
// checker could not type at all is `TypeKind.Invalid`, and a gap under one of
// those says the binder failed, not the program. Measured on `main` at 6f5eb7f5
// over this whole repo — compiler, stdlib, runtime, tools, pkg, examples,
// _tests_/imports and all 719 `_tests_/cases` — exactly ONE call reaches here,
// `unwrap(v)` at pkg/redis/client.test.bit:89, and its argument types are
// `<error>`: that program builds and runs today, and judging it would reject
// it. Inverting this one condition rejects it, which is how that was measured.
//
// The caller bails on `true` exactly as it always did, so an undecidable gap is
// still silence and not a diagnostic. A gap an EMPTY variadic slot could have
// filled, at a type parameter `()` is a legal argument for, is not a gap at all
// (#4597/#4633, `vEmptyRestGapIsSilent` below): it is skipped rather than
// returned, so the rest of the call is still judged.
fn vGenericGap(c: Checker, node: int, cd: CallDecl, targs: []int): bool {
  let got = len(kidsOf(c.tree, kidsOf(c.tree, node)[2]))
  let i = 0
  while (i < len(targs)) {
    let missing = targs[i] == 0 || targs[i] == c.ctx.voidId
    if (missing && !vEmptyRestGapIsSilent(c, cd, got, i)) {
      if (vCallArgTypesKnown(c, node)) {
        reportNoHint(
          c.diags, ecCannotInfer, vSpan(c, node),
          "cannot infer type parameter '${vGenericParamName(cd.owner, cd.decl, i)}'; give explicit type arguments",
        )
      }
      return true
    }
    i = i + 1
  }
  return false
}

// Whether type parameter `idx` is unbound only because NO ARGUMENT REACHED THE
// SLOT THAT BINDS IT — the empty variadic slot of `fn each<T>(...xs: T)` called
// as `each()`. `each()` and `tally("b")` check and run on `main`, printing `0`
// and `1`, and SPEC §15.3's "cannot be inferred" is not about them: there is no
// argument to unify against, and requiring `each<i64>()` for a call that binds
// nothing at runtime either would reject working code (#4548 measured both as
// E0068 the moment a variadic call reached here).
//
// The empty rest slot is the ONLY parameter that can go unfilled once
// `vCallArity` has admitted the call — a fixed-arity call has an exact count and
// a variadic one has at least `fixed` arguments — so this is the whole of the
// distinction, not a first case. A type parameter a FIXED parameter also
// mentions is still reported: `f<T>(q: Option<T>, ...xs: T)` called `f(Option.None)`
// had an argument at a slot that binds `T` and failed to bind it anyway, which is
// #4560's error. A type parameter NO parameter mentions is reported as before.
//
// The `!cd.variadic` half also keeps `cd.params[cd.fixed]` IN RANGE: a
// non-variadic signature has no parameter at index `fixed`, which equals its
// `want`. Dropping that token panics `bit check` with `index out of range` on
// every fixed-arity generic call that reaches a gap — measured, as #4597's
// mutation.
//
// The SHAPE is not the whole answer, which is #4633: `genericTypeArgs` does not
// leave such a parameter unbound, it binds it to `()`, and that is the type the
// template is then emitted against. Silence is therefore owed a second
// question — is `()` a legal argument here — and `vEmptySlotBoundOk` answers it.
// (Named `vGapOnlyEmptyRest` when #4597 added it, when the shape was the whole
// test.)
fn vEmptyRestGapIsSilent(c: Checker, cd: CallDecl, got: int, idx: int): bool {
  if (!cd.variadic || got > cd.fixed) {
    return false
  }
  let names = [vGenericParamName(cd.owner, cd.decl, idx)]
  let rest = kidsOf(cd.owner.tree, cd.params[cd.fixed])[1]
  if (!typeNodeMentionsAny(cd.owner, rest, names)) {
    return false
  }
  let pi = 0
  while (pi < cd.fixed) {
    if (typeNodeMentionsAny(cd.owner, kidsOf(cd.owner.tree, cd.params[pi])[1], names)) {
      return false
    }
    pi = pi + 1
  }
  return vEmptySlotBoundOk(c, cd, idx)
}

// Whether `()` — the type `genericTypeArgs` binds a type parameter to when the
// empty variadic slot binds it nothing — is a LEGAL argument for it.
//
// A type parameter with no bound promises the template nothing, so nothing is
// broken by the fabricated `()`: `each()`, `tally("b")` and `nested()` keep
// running, which is #4597's constraint. A BOUND is a promise the template is
// entitled to rely on — inside `fn joinAll<T: Named>(sep: string, ...xs: T)`,
// `x.label()` is correct code — and `()` has no methods, so it satisfies no
// bound that names one. Emitting the template against it is exactly what put
//
//     error[E0092]: cannot lower a call whose callee does not resolve to a
//     function ... note: while emitting 'joinAll<()>', instantiated here
//
// inside a correct generic body, with `bit check` exiting 0 first (#4633). The
// caller reports E0068 at the CALL instead, and `joinAll<Tag>("-")` is the
// answer it asks for.
//
// Judged by the same pair E0051 uses — the bound read off the DECLARING
// module's type-param node (not the flat `typeParamConstraints`, which the last
// `<T: I>` in the module clobbers) and `vSatisfies` — minus `vBoundJudgeable`'s
// `arg != voidId` clause, which is why that predicate cannot be reused whole
// here: it exists to stop an inference GAP becoming a false E0051, and this
// void is not standing in for a gap, it IS the argument the call would
// instantiate at.
//
// THE SAFETY RULE (validate.bit) still binds on the bound's own side: anything
// but a resolved, concrete, non-generic interface is undecidable, and
// undecidable is silence.
fn vEmptySlotBoundOk(c: Checker, cd: CallDecl, idx: int): bool {
  let tps = kidsOf(cd.owner.tree, kidsOf(cd.owner.tree, cd.decl)[2])
  if (idx >= len(tps)) {
    return true
  }
  let gk = kidsOf(cd.owner.tree, tps[idx]) // [name, constraint_group?]
  if (gk[1] == 0 || len(kidsOf(cd.owner.tree, gk[1])) == 0) {
    return true // no bound: promises nothing, so violates nothing
  }
  let boundIface = typeFromNode(cd.owner, kidsOf(cd.owner.tree, gk[1])[0])
  if (!vBoundIsJudgeable(c, boundIface)) {
    return true
  }
  return vSatisfies(c, c.ctx.voidId, boundIface)
}

// The bound-side half of `vBoundJudgeable` (validateexpr.bit), which owns E0051
// and cannot be called from here because its argument-side half rejects the
// very `void` this file has to judge. Same three clauses, same order.
fn vBoundIsJudgeable(c: Checker, boundIface: int): bool {
  return boundIface != 0 &&
    !vMentionsInvalid(c, boundIface, 0) &&
    !vHasTypeParam(c, boundIface, 0) &&
    c.ctx.types[boundIface].kind == TypeKind.Interface
}

// A type parameter's own spelling, read from the DECLARING module's tree: the
// decl may be imported, and its node indices mean nothing in this module's.
fn vGenericParamName(owner: Checker, decl: int, idx: int): string {
  let tps = kidsOf(owner.tree, kidsOf(owner.tree, decl)[2])
  if (idx >= len(tps)) {
    return "?"
  }
  let n = getNode(owner.tree, kidsOf(owner.tree, tps[idx])[0])
  return owner.source[n.span.start:n.span.end]
}

// Whether every argument of this call has a type at all. Reached only from
// `vCallGenericEnv`, which runs after `vCallArity` has proven the call decidable
// — a known, non-spread free function whose argument count its signature admits.
// Since #4597 that includes a VARIADIC callee, whose argument list can be longer
// than its parameter list; this walks the ARGUMENTS, so the extra ones in the
// variadic slot are asked the same question as the fixed prefix.
fn vCallArgTypesKnown(c: Checker, node: int): bool {
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let i = 0
  while (i < len(args)) {
    let t = checkArgType(c, node, i)
    if (t == 0 || c.ctx.types[t].kind == TypeKind.Invalid) {
      return false
    }
    i = i + 1
  }
  return true
}

// ---- E0051 generic bound violation (§15.3) ---------------------------------
//
// Moved here from validateexpr.bit (#4634), which sat at 771 lines against the
// 800-line limit (spec/LINT.md E0200) and had no room for the METHOD entry
// point below. It belongs beside E0068 in any case: both rules judge a generic
// CALL's type arguments, and both must read the type-param and constraint nodes
// out of the DECLARING module's tree rather than the caller's.

// The safety rule for judging one type argument against one bound: only a
// confidently-concrete arg against a concrete, non-generic interface bound is
// testable. An unbound (void) or un-inferred arg is skipped so an inference gap
// never becomes a false positive (the seed emits E0068 for those, elsewhere).
fn vBoundJudgeable(c: Checker, arg: int, boundIface: int): bool {
  return arg != 0 &&
    arg != c.ctx.voidId &&
    !vMentionsInvalid(c, arg, 0) &&
    !vHasTypeParam(c, arg, 0) &&
    boundIface != 0 &&
    !vMentionsInvalid(c, boundIface, 0) &&
    !vHasTypeParam(c, boundIface, 0) &&
    c.ctx.types[boundIface].kind == TypeKind.Interface
}

// The interface a type-parameter node declares as its bound, or 0 when it
// declares none (no constraint group, or an empty one — either way the
// parameter promises nothing and so can violate nothing).
//
// `oc` is the module that DECLARES the generic, which is not the caller's when
// it was imported: `tp` and its constraint nodes are indices into `oc.tree` and
// mean nothing in any other.
fn vBoundIfaceOf(oc: Checker, tp: int): int {
  let gk = kidsOf(oc.tree, tp) // [name, constraint_group?]
  if (gk[1] == 0) {
    return 0
  }
  let cons = kidsOf(oc.tree, gk[1])
  if (len(cons) == 0) {
    return 0
  }
  return typeFromNode(oc, cons[0])
}

// One type-param node against one type argument: THE judgement behind E0051,
// and the single one every caller shares. `vBoundJudgeable` carries the safety
// rule and `vSatisfies` decides the fit.
//
// `vInstBoundsViolated` (validateinst.bit) asks this same question to suppress
// the per-instantiation rules for an instantiation whose bounds were already
// broken, and it must agree with what E0051 reports by CONSTRUCTION rather than
// by resemblance — a second predicate that merely looked the same would drift.
fn vArgViolatesBound(c: Checker, oc: Checker, tp: int, arg: int): bool {
  let boundIface = vBoundIfaceOf(oc, tp)
  return vBoundJudgeable(c, arg, boundIface) && !vSatisfies(c, arg, boundIface)
}

// Emits E0051 naming the argument type, the bound, and WHY the two do not fit
// (#4521) — two different bound failures at the same call shape used to render
// byte-identical text naming neither type. `vSatisfyReason` is E0041's own
// renderer, reused here rather than duplicated, so the two codes can never
// drift; it returns "" only for the predeclared `error`, which has no
// declaration to walk, and that case keeps the original generic hint.
fn vReportBound(c: Checker, node: int, i: int, arg: int, boundIface: int) {
  let an = typeName(c.ctx, arg)
  let bn = typeName(c.ctx, boundIface)
  let why = vSatisfyReason(c, arg, boundIface)
  let hint = "check the interface's method set against this type"
  if (why != "") {
    hint = why
  }
  report(
    c.diags, ecMissingMethod, vSpan(c, node),
    "type argument ${i} is '${an}', which does not satisfy the bound '${bn}'",
    hint,
  )
}

// A resolved decl's type-parameter nodes, read out of the module that DECLARES
// it: the decl may be imported, and its node indices mean nothing in the
// caller's tree. Read straight off the decl rather than from the flat
// `typeParamConstraints`, which the last `<T: I>` in the module clobbers.
fn vDeclTypeParams(fr: FuncRef): []int {
  return kidsOf(fr.owner.tree, kidsOf(fr.owner.tree, fr.decl)[2])
}

// Judges `args[start:]` against `tps[start:]` and reports each violation at the
// CALL. The two lists are positionally paired by construction — `genericTypeArgs`
// and `methodTypeArgsRaw` both build exactly one entry per declared type
// parameter, in declaration order — so a length mismatch means the pairing is
// not trustworthy and nothing is judged rather than something guessed.
//
// `start` exists for the method entry point: a method's type-param list is
// MERGED, its receiver class's parameters in front of its own (parserdecl), and
// only the tail is this call's business. Reported indices are relative to
// `start`, so `mx<T: Ord>` declared on a generic class still names argument 0 —
// the number the programmer wrote.
fn vBoundLoop(c: Checker, fr: FuncRef, args: []int, node: int, start: int) {
  let tps = vDeclTypeParams(fr)
  if (len(args) != len(tps)) {
    return
  }
  let i = start
  while (i < len(tps)) {
    if (vArgViolatesBound(c, fr.owner, tps[i], args[i])) {
      vReportBound(c, node, i - start, args[i], vBoundIfaceOf(fr.owner, tps[i]))
    }
    i = i + 1
  }
}

// Checks a generic call's inferred type arguments against each type parameter's
// declared interface bound (E0051) — a direct port's `instantiateFunc`.
//
// Both callee shapes are judged. Before #4634 only a bare-ident FREE generic
// reached the rule and a generic METHOD's bounds were never checked at all, so
// the identical program with the generic moved into a class body exited
// `bit check` 0 and died at lowering with E0092 — the #1430 check/build
// divergence class, reported at the wrong layer and at a span inside the class
// body rather than at the call that chose the argument.
fn vGenericBound(c: Checker, node: int) {
  let callee = kidsOf(c.tree, node)[0] // [callee, generic_args, arg_list]
  let tag = getNode(c.tree, callee).tag
  if (tag == Tag.Ident) {
    vGenericBoundFree(c, node, callee)
    return
  }
  if (tag == Tag.Member) {
    vGenericBoundMethod(c, node, callee)
  }
}

// The free-function arm. The arg comes from the same `genericTypeArgs` the
// sweep records instantiations with, so the pairing matches the seed's env
// exactly.
fn vGenericBoundFree(c: Checker, node: int, callee: int) {
  let name = nodeText(c.tree, c.source, callee)
  if (shadowedByValue(c, callee, name)) {
    return // a local value shadows the free function
  }
  if (!isGenericFuncAt(c, callee, name)) {
    return
  }
  let fr = funcRefAt(c, callee, name)
  if (fr.decl == 0) {
    return
  }
  vBoundLoop(c, fr, genericTypeArgs(c, name, node), node, 0)
}

// The method arm (#4634). `methodRefAt` + `methodTypeArgsRaw` are the same pair
// `recordMethodInstantiation` (checkproject.bit) resolves a method call with, so
// what is judged here is precisely what the ledger will monomorphize — not a
// second, parallel resolution that could disagree with it.
//
// A `Tag.Member` callee is not necessarily a method call: `ns.f(...)` names an
// imported free function, `Enum.Variant(...)` constructs, and an interface
// method has no FuncDecl. `vInstMemberSkip` (validateinst.bit) rejects the first
// two by receiver shape and `fr.decl == 0` covers the rest.
//
// Only the method's OWN type parameters are judged. The receiver class's half of
// the merged list is bound from the RECEIVER TYPE, not from anything this call
// wrote, so a violation there belongs to whatever built the receiver and would
// otherwise be reported once per method call on it.
fn vGenericBoundMethod(c: Checker, node: int, callee: int) {
  let mk = kidsOf(c.tree, callee) // [recv, name]
  if (vInstMemberSkip(c, mk[0])) {
    return
  }
  let rt = checkExprType(c, mk[0])
  if (rt == 0) {
    return
  }
  let recvTy = methodRecvType(c, rt)
  let fr = methodRefAt(c, recvTy, nodeText(c.tree, c.source, mk[1]))
  if (fr.decl == 0) {
    return
  }
  let own = methodOwnGenericCount(fr.owner, fr.decl)
  if (own == 0) {
    return // no type params of its own: nothing this call chose to judge
  }
  let start = len(vDeclTypeParams(fr)) - own
  vBoundLoop(c, fr, methodTypeArgsRaw(c, fr, recvTy, node), node, start)
}
