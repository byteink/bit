// Self-host Stage 3 (#1344, split out of machoexec.bit by #1503): the Mach-O
// load-command emitters, the header, and the stub writer.

// ===========================================================================
// Load-command emitters
//
// Each appends one command's exact on-disk bytes. Sizes are fixed and asserted
// against sizeofcmds at the end of linkExecutable: every file offset recorded in
// a command is computed from that total, so a wrong size makes every one a lie.
// ===========================================================================

fn meAppendName16(lc: ByteBuf, s: string) {
  let b = []byte(s)
  assert(len(b) <= 16)
  appendBytes(lc, b)
  appendZeros(lc, 16 - len(b))
}

// A NUL-terminated path padded out to the command's declared size.
fn meAppendPaddedStr(lc: ByteBuf, s: string, cmdsize: int, offset: int) {
  let b = []byte(s)
  appendBytes(lc, b)
  appendZeros(lc, cmdsize - offset - len(b))
}

fn meAppendSeg(
  lc: ByteBuf, seg: string, vmaddr: int, vmsize: int,
  fileoff: int, filesize: int, initprot: int, maxprot: int, nsects: int,
) {
  appendU32(lc, lcSegment64())
  appendU32(lc, mrSizeofSegment() + nsects * mrSizeofSection())
  meAppendName16(lc, seg)
  appendU64(lc, vmaddr)
  appendU64(lc, vmsize)
  appendU64(lc, fileoff)
  appendU64(lc, filesize)
  appendU32(lc, maxprot)
  appendU32(lc, initprot)
  appendU32(lc, nsects)
  appendU32(lc, 0) // flags
}

fn meAppendSect(
  lc: ByteBuf, sect: string, seg: string, addr: int, size: int,
  offset: int, alignLog2: int, flags: int, reserved1: int, reserved2: int,
) {
  meAppendName16(lc, sect)
  meAppendName16(lc, seg)
  appendU64(lc, addr)
  appendU64(lc, size)
  appendU32(lc, offset)
  appendU32(lc, alignLog2)
  appendU32(lc, 0) // reloff: an executable's sections carry no relocations
  appendU32(lc, 0) // nreloc
  appendU32(lc, flags)
  appendU32(lc, reserved1)
  appendU32(lc, reserved2)
  appendU32(lc, 0) // reserved3
}

// The nlist array is [local __text symbols][(none) defined-external][undefined
// imports] — LC_DYSYMTAB's three groups must be exactly that order, contiguous.
// The indirect table drives stubs/got and is unrelated to this grouping.
fn meAppendDysymtab(lc: ByteBuf, nlocal: int, nundef: int, indirectOff: int, nindirect: int) {
  appendU32(lc, lcDysymtab())
  appendU32(lc, 80)
  appendU32(lc, 0)      // ilocalsym
  appendU32(lc, nlocal) // nlocalsym
  appendU32(lc, nlocal) // iextdefsym
  appendU32(lc, 0)      // nextdefsym
  appendU32(lc, nlocal) // iundefsym
  appendU32(lc, nundef)
  appendU32(lc, 0) // tocoff
  appendU32(lc, 0) // ntoc
  appendU32(lc, 0) // modtaboff
  appendU32(lc, 0) // nmodtab
  appendU32(lc, 0) // extrefsymoff
  appendU32(lc, 0) // nextrefsyms
  appendU32(lc, indirectOff)
  appendU32(lc, nindirect)
  appendU32(lc, 0) // extreloff
  appendU32(lc, 0) // nextrel
  appendU32(lc, 0) // locreloff
  appendU32(lc, 0) // nlocrel
}

fn meDylinkerCmdsize(): int {
  return meAlignUp(12 + len([]byte(meDylinkerPath())) + 1, 8)
}

fn meDylibCmdsize(): int {
  return meAlignUp(24 + len([]byte(meLibsystemPath())) + 1, 8)
}

fn meAppendDylinker(lc: ByteBuf) {
  let cmdsize = meDylinkerCmdsize()
  appendU32(lc, lcLoadDylinker())
  appendU32(lc, cmdsize)
  appendU32(lc, 12) // name.offset
  meAppendPaddedStr(lc, meDylinkerPath(), cmdsize, 12)
}

fn meAppendDylib(lc: ByteBuf) {
  let cmdsize = meDylibCmdsize()
  appendU32(lc, lcLoadDylib())
  appendU32(lc, cmdsize)
  appendU32(lc, 24) // name.offset
  appendU32(lc, 2)  // timestamp
  appendU32(lc, 0)  // current_version (any)
  appendU32(lc, 0)  // compatibility_version (any)
  meAppendPaddedStr(lc, meLibsystemPath(), cmdsize, 24)
}

// entryoff is the entry's FILE offset (__TEXT starts at file offset 0); dyld
// calls it with the C main(argc,argv,envp,apple) ABI.
fn meAppendMain(lc: ByteBuf, entryoff: int) {
  appendU32(lc, lcMain())
  appendU32(lc, 24)
  appendU64(lc, entryoff)
  appendU64(lc, 0) // stacksize: 0 == default
}

fn meAppendBuildVersion(lc: ByteBuf) {
  appendU32(lc, lcBuildVersion())
  appendU32(lc, 24)
  appendU32(lc, platformMacos())
  appendU32(lc, 0x000B0000) // minos: macOS 11.0
  appendU32(lc, 0x000B0000) // sdk:   macOS 11.0
  appendU32(lc, 0)          // ntools
}

fn meAppendDyldInfo(
  lc: ByteBuf, rebaseOff: int, rebaseSize: int,
  bindOff: int, bindSize: int,
) {
  appendU32(lc, lcDyldInfoOnly())
  appendU32(lc, 48)
  appendU32(lc, rebaseOff)
  appendU32(lc, rebaseSize)
  appendU32(lc, bindOff)
  appendU32(lc, bindSize)
  appendU32(lc, 0) // weak_bind_off
  appendU32(lc, 0) // weak_bind_size
  appendU32(lc, 0) // lazy_bind_off
  appendU32(lc, 0) // lazy_bind_size
  appendU32(lc, 0) // export_off
  appendU32(lc, 0) // export_size
}

fn meAppendSymtab(lc: ByteBuf, symoff: int, nsyms: int, stroff: int, strsize: int) {
  appendU32(lc, lcSymtabCmd())
  appendU32(lc, 24)
  appendU32(lc, symoff)
  appendU32(lc, nsyms)
  appendU32(lc, stroff)
  appendU32(lc, strsize)
}

fn meAppendCodeSignature(lc: ByteBuf, sigOff: int, sigSize: int) {
  appendU32(lc, lcCodeSignature())
  appendU32(lc, 16)
  appendU32(lc, sigOff)
  appendU32(lc, sigSize)
}

// The Mach-O header. PIE: dyld picks a random slide, and every relocation this
// backend applies is PC-relative and so slide-invariant.
fn meAppendHeader(out: ByteBuf, sizeofcmds: int, hasDataSeg: bool, hasTlvVars: bool) {
  appendU32(out, 0xfeedfacf) // MH_MAGIC_64
  appendU32(out, 0x0100000C) // CPU_TYPE_ARM64
  appendU32(out, 0)          // CPU_SUBTYPE_ARM64_ALL
  appendU32(out, mhExecute())
  appendU32(out, meNcmds(hasDataSeg))
  appendU32(out, sizeofcmds)
  let flags = mhDyldlink() | mhTwolevel() | mhPie()
  if (hasTlvVars) {
    // Without this dyld skips TLV setup and the first thread-local access calls
    // the placeholder thunk -> _tlv_bootstrap_error.
    flags = flags | mhHasTlvDescriptors()
  }
  appendU32(out, flags)
  appendU32(out, 0) // reserved
}

// The total load-command byte count. Computed before layout, because every file
// offset a command records is measured from the end of the commands.
fn meSizeofcmds(textNsects: int, dataNsects: int, hasDataSeg: bool): int {
  let n = mrSizeofSegment()                                  // __PAGEZERO
  n = n + mrSizeofSegment() + textNsects * mrSizeofSection() // __TEXT
  if (hasDataSeg) {
    n = n + mrSizeofSegment() + dataNsects * mrSizeofSection() // __DATA
  }
  n = n + mrSizeofSegment() // __LINKEDIT
  n = n + 48                // LC_DYLD_INFO_ONLY
  n = n + 24                // LC_SYMTAB
  n = n + 80                // LC_DYSYMTAB
  n = n + meDylinkerCmdsize()
  n = n + meDylibCmdsize()
  n = n + 24 // LC_BUILD_VERSION
  n = n + 24 // LC_MAIN
  n = n + 16 // LC_CODE_SIGNATURE
  return n
}

fn meTextNsects(st: MeLinkState): int {
  let n = 1 // __text always exists
  if (len(st.stubList) > 0) {
    n = n + 1
  }
  if (len(st.rodata) > 0) {
    n = n + 1
  }
  return n
}

fn meDataNsects(st: MeLinkState): int {
  let n = 0
  if (len(st.gotList) > 0) {
    n = n + 1
  }
  if (len(st.data) > 0) {
    n = n + 1
  }
  if (len(st.tlsVars) > 0) {
    n = n + 1
  }
  if (len(st.tlsData) > 0) {
    n = n + 1
  }
  if (len(st.tlsBss) > 0) {
    n = n + 1
  }
  if (len(st.bss) > 0) {
    n = n + 1
  }
  return n
}

// The three-instruction stub dyld never touches: load the import's GOT slot and
// jump through it. adrp x16, got ; ldr x16, [x16, off] ; br x16.
fn meWriteStub(file: []u8, off: int, stubVaddr: int, gotSlot: int): ()! {
  loWrU32(file, off, 0x90000010)     // adrp x16, 0
  loWrU32(file, off + 4, 0xF9400210) // ldr x16, [x16]
  loWrU32(file, off + 8, 0xD61F0200) // br x16
  applyReloc(
    LoRelocKind.Aarch64AdrGotPage, file, off,
    RelocValues{ s: 0, p: stubVaddr, gotSlot: gotSlot, tpOffset: 0 },
  )?
  applyReloc(
    LoRelocKind.Aarch64Ld64GotLo12Nc, file, off + 4,
    RelocValues{ s: 0, p: 0, gotSlot: gotSlot, tpOffset: 0 },
  )?
}
