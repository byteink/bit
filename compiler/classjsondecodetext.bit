// compiler/classjsondecodetext.bit — the decoder `jsonDecodeText<T>`
// specialises to (#4501). The streaming twin of classjsondecode.bit: where that
// file pulls a class's fields out of a `Json`, this one pulls them out of the
// TOKEN STREAM, so no `Json` is ever built.
//
// What one class turns into, written out, is what a reader would have
// hand-written against stdlib/json/dectext.bit's named helpers:
//
//     fn __json_dectextroot_User(__json_src: string): User! {
//       let __json_r = jsonTextReader(__json_src)
//       let __json_v = __json_dectext_User(__json_r, "", 0)?
//       jsonTextFinish(__json_r)?
//       return __json_v
//     }
//
//     fn __json_dectext_User(__json_r: JsonReader, __json_p: string, __json_d: i64): User! {
//       jsonTextObject(__json_r, __json_p, __json_d)?
//       let __json_x0 = i64(0)
//       let __json_ds0 = false
//       let __json_x1: []string
//       let __json_ds1 = false
//       let __json_dn = 0
//       while (jsonTextKey(__json_r, __json_dn)?) {
//         __json_dn = __json_dn + 1
//         if (jsonTextKeyIs(__json_r, "id")) {
//           if (!jsonTextNull(__json_r)) {
//             __json_x0 = i64(jsonTextIntKey(__json_r, __json_p, "id")?)
//             __json_ds0 = true
//           }
//         } else if (jsonTextKeyIs(__json_r, "tags")) {
//           if (!jsonTextNull(__json_r)) {
//             let __json_dp1 = jsonDecPath(__json_p, "tags")
//             __json_x1 = []string(0, 4)
//             jsonTextArray(__json_r, __json_dp1, __json_d)?
//             let __json_di1 = 0
//             while (jsonTextItem(__json_r, __json_di1)?) {
//               __json_x1 = append(__json_x1, jsonTextStringIndex(__json_r, __json_dp1, __json_di1)?)
//               __json_di1 = __json_di1 + 1
//             }
//             __json_ds1 = true
//           }
//         } else {
//           jsonTextUnknown(__json_r, __json_p)?
//         }
//       }
//       jsonTextNeed(__json_ds0, __json_p, "id")?
//       jsonTextNeed(__json_ds1, __json_p, "tags")?
//       return User{ id: __json_x0, tags: __json_x1 }
//     }
//
// WHY THE SHAPE IS DECLARE-THEN-WALK-THEN-CHECK, and not a field-by-field
// extraction like the DOM decoder's. A JSON object's keys arrive in whatever
// order the producer wrote them, and a forward cursor gets ONE pass over them.
// So every field's value lands in a local as it goes by, and the missing-key
// check that the DOM path makes per field before reading it happens here after
// the object has closed. `__json_ds<i>` is that check's evidence: false when
// the key never appeared, and false when it appeared as `null`, which is
// exactly the pair `jsonDecMember` folds together on the DOM side.
//
// WHY A NESTED CLASS FIELD IS HELD AS AN `Option`. A local needs a value before
// the walk starts and a class-typed field has no zero value (SPEC §13.4) — a
// class with a class-typed field cannot be default-constructed at all. Every
// other shape has a real zero (`i64(0)`, `""`, `false`, the empty slice, the
// empty map, `None`), so only this one pays a box, and it pays it once per
// nested object rather than once per scalar.
//
// LAST WINS ON A DUPLICATE KEY, matching `jsonGet` (stdlib/json/value.bit) and
// therefore the DOM path. A scalar overwrites its local; a `[]T` and a
// `map<string, T>` reset theirs before the inner walk, which is what the
// `__json_x1 = []string(0, 4)` above is for — without it a repeated key would
// CONCATENATE,
// and would do it silently.
//
// THE PATH AND THE DEPTH ARE THREADED exactly as classjsondecode.bit threads
// them, through the same `JsonDecPathRef`: a scalar is handed the containing
// path and its own key or index as two arguments and the dotted string is built
// inside stdlib's `fail` (#4502); a nested class is handed a real string
// because it threads it down to its own fields.

// The synthesized decoder's parameters and the two locals its root wrapper
// needs. The `__json_` prefix is not a reservation and does not need to be:
// these live in the function's own scope, which contains nothing the user
// wrote.
const jsonDecTextParamR = "__json_r"
const jsonDecTextParamSrc = "__json_src"
const jsonDecTextLocalV = "__json_v"
const jsonDecTextLocalN = "__json_dn"

// The capacity a `[]T` accumulator starts at, and the same number and the same
// reason as `jsonSmallCap` (stdlib/json/parse.bit): `append` doubles FROM 1, so
// an accumulator built from an empty slice reallocates its backing at 1, 2 and
// 4 — three `gc_alloc`s and three copies to hold four elements, and real
// documents are overwhelmingly made of short arrays. Measured here on
// `"tags":[1,2,3]`: 3 objects per record from an empty start, 1 from this one.
const jsonDecTextSliceCapWord = "4"

// The per-field locals this builder adds to classjsondecode.bit's: `ds` is
// whether the key was seen with a value, `dk` a map entry's key, `dn` a map's
// member cursor. `x`, `dp` and `di` are shared with the DOM builder — different
// functions, so nothing collides, and one spelling for one meaning.
fn jsonDecTextLocalS(i: int): string {
  return "__json_ds${i}"
}

fn jsonDecTextLocalK(i: int): string {
  return "__json_dk${i}"
}

fn jsonDecTextLocalN2(i: int): string {
  return "__json_dn${i}"
}

// Every word a text decoder for `classes` needs in the module source. The FIXED
// half is appended whole for the reason `jsonDecodeSynthWords` appends its own:
// a list that tracked which helpers are reachable would be a second copy of the
// builder's dispatch, and the two going out of step is exactly what
// `synthSpan`'s panic exists to catch.
fn jsonDecodeTextSynthWords(jx: JsonCtx, classes: []JsonClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    jsonDecTextParamR, jsonDecParamP, jsonDecParamD, jsonDecTextParamSrc,
    jsonDecTextLocalV, jsonDecTextLocalN, "JsonReader", "string", "i64",
    "Option", "Some", "None", "append", "unwrap", "true", "false",
    jsonDecodeRootPathWord, jsonDecodeZeroWord, "1", jsonDecTextSliceCapWord,
  ]
  for h of jsonDecTextHelperNames() {
    out = append(out, h)
  }
  for c of classes {
    let name = identText(jx.tree, jx.source, c.className)
    out = append(out, jsonDecTextName(name))
    out = append(out, jsonDecTextRootName(name))
    for f of c.fields {
      for w of jsonDecTextFieldWords(jx, f) {
        out = append(out, w)
      }
    }
  }
  return out
}

// One field's words: its key (when it is not a `@key` literal already in the
// source), its locals, and the text decoder name of any nested `@json` class it
// reaches.
fn jsonDecTextFieldWords(jx: JsonCtx, f: JsonField): []string {
  let out = [
    jsonDecLocalX(f.index), jsonDecLocalP(f.index), jsonDecLocalI(f.index),
    jsonDecTextLocalS(f.index), jsonDecTextLocalK(f.index),
    jsonDecTextLocalN2(f.index),
  ]
  if (f.keyWord != "") {
    out = append(out, f.keyWord)
  }
  let nested = jsonDecNestedName(jx, f)
  if (nested != "") {
    out = append(out, jsonDecTextName(nested))
  }
  return out
}

// ---- node helpers ----------------------------------------------------------

// `!<expr>`.
fn jdtNot(db: JsonDecBuild, expr: int): int {
  return addNode(db.jb.tree, Tag.Unary, db.jb.span, int(Kind.Bang), [expr])
}

// `true` / `false`, as the literal leaves the lowerer reads their text off.
fn jdtBool(db: JsonDecBuild, word: string): int {
  return addLeaf(db.jb.tree, Tag.BoolLit, synthSpan(db.jb.st, word))
}

// `""` — the root path a wrapper passes, and a `string` field's zero.
fn jdtEmptyString(db: JsonDecBuild): int {
  return addLeaf(db.jb.tree, Tag.StringLit, synthSpan(db.jb.st, jsonDecodeRootPathWord))
}

// `Option<T>`, built around a cloned copy of `T`. A nested class field is
// declared as the class itself, so the option type it is HELD in has to be
// constructed rather than cloned.
fn jdtOptionType(db: JsonDecBuild, inner: int): int {
  let targs = jbNode(db.jb, Tag.TypeArgs, [jbCloneType(db.jb.tree, inner, 0)])
  return jbNode(db.jb, Tag.GenericInst, [jbIdent(db.jb, "Option"), targs])
}

// `<optType>.Some(<v>)`.
fn jdtSome(db: JsonDecBuild, optType: int, v: int): int {
  let ctor = jbNode(db.jb, Tag.Member, [optType, jbIdent(db.jb, "Some")])
  return jbCall(db.jb, ctor, [v])
}

// `<optType>.None`.
fn jdtNone(db: JsonDecBuild, optType: int): int {
  return jbNode(db.jb, Tag.Member, [optType, jbIdent(db.jb, "None")])
}

// `<helper>(__json_r, <args...>)?` — every runtime helper takes the reader
// first, so the call shape is uniform.
fn jdtHelperCall(db: JsonDecBuild, helper: string, args: []int): int {
  let all = [jdLocal(db, jsonDecTextParamR)]
  for a of args {
    all = append(all, a)
  }
  return jbTry(db.jb, jbCall(db.jb, jdLocal(db, helper), all))
}

// The same call as a statement.
fn jdtHelperStmt(db: JsonDecBuild, helper: string, args: []int): int {
  return jbNode(db.jb, Tag.ExprStmt, [jdtHelperCall(db, helper, args)])
}

// ---- one value -------------------------------------------------------------

// The by-key and by-index extractors for a scalar shape, spelled out rather
// than assembled from a base name and a suffix: these words have to be in
// `jsonDecTextHelperNames`, and a name built by interpolation would go missing
// there silently for whichever shape no test decodes.
fn jdtScalarKeyHelper(kind: int): string {
  if (kind == jkBool) {
    return "jsonTextBoolKey"
  }
  if (kind == jkString) {
    return "jsonTextStringKey"
  }
  if (kind == jkFloat) {
    return "jsonTextFloatKey"
  }
  return "jsonTextIntKey"
}

fn jdtScalarIndexHelper(kind: int): string {
  if (kind == jkBool) {
    return "jsonTextBoolIndex"
  }
  if (kind == jkString) {
    return "jsonTextStringIndex"
  }
  if (kind == jkFloat) {
    return "jsonTextFloatIndex"
  }
  return "jsonTextIntIndex"
}

// The value under the cursor, reached by `pr`, decoded to `el`'s declared type.
// An integer or float goes through an explicit conversion to the field's OWN
// width — the helper answers `i64`/`f64` and a `u8` field needs `u8(...)` —
// which is the rule `jdValueOf` applies on the DOM side and `jbValueOf` applies
// in reverse.
fn jdtValueOf(db: JsonDecBuild, el: JsonDecElem, pr: JsonDecPathRef): int {
  if (el.kind == jkNested) {
    return jdtHelperCall(
      db, jsonDecTextName(el.nested), [jdJoinPath(db, pr), jdDeeper(db)],
    )
  }
  let helper = jdtScalarKeyHelper(el.kind)
  if (pr.byIndex) {
    helper = jdtScalarIndexHelper(el.kind)
  }
  let raw = jdtHelperCall(db, helper, [pr.parent, pr.step])
  if (el.kind == jkBool || el.kind == jkString) {
    return raw
  }
  return jbCall(db.jb, jbCloneType(db.jb.tree, el.typeNode, 0), [raw])
}

// ---- one field: its local, its arm, and its check --------------------------

// `map<string, T>{}` — the empty map a map field's local starts at and is reset
// to.
fn jdtEmptyMap(db: JsonDecBuild, f: JsonField): int {
  return jbNode(
    db.jb, Tag.CompositeLit,
    [jbCloneType(db.jb.tree, f.typeNode, 0), jbNode(db.jb, Tag.MapEntries, []int(0))],
  )
}

// The value a field's local holds before the object has been walked. Every
// shape has a real zero except a nested class, which is held as an `Option` for
// the reason this file's header gives.
fn jdtZero(db: JsonDecBuild, f: JsonField): int {
  if (f.kind == jkOption) {
    return jdtNone(db, jbCloneType(db.jb.tree, f.typeNode, 0))
  }
  if (f.kind == jkNested) {
    return jdtNone(db, jdtOptionType(db, f.typeNode))
  }
  if (f.kind == jkBool) {
    return jdtBool(db, "false")
  }
  if (f.kind == jkString) {
    return jdtEmptyString(db)
  }
  return jbCall(db.jb, jbCloneType(db.jb.tree, f.typeNode, 0), [jbInt(db.jb, "0")])
}

// `[]T(0, 4)` — an empty accumulator with room for a short array, and the
// expression a `[]T` field's local is both declared with and reset to.
fn jdtEmptySlice(db: JsonDecBuild, f: JsonField): int {
  let sliceTy = jbNode(db.jb, Tag.SliceType, [jbCloneType(db.jb.tree, f.elem, 0)])
  return jbCall(
    db.jb, sliceTy,
    [jbInt(db.jb, jsonDecodeZeroWord), jbInt(db.jb, jsonDecTextSliceCapWord)],
  )
}

// `let __json_x<i> = <zero>`, or — for the two container shapes — a DECLARATION
// WITH NO INITIALIZER, which is the empty slice and the nil map (SPEC §13.4)
// and allocates nothing at all. The container is materialised in the arm that
// matched its key, so a field the document omits costs no allocation, and a nil
// map can never escape: a container field is never an `Option`, so
// `jdtNeedChecks` refuses an absent one before the result is built.
fn jdtDeclare(db: JsonDecBuild, f: JsonField): int {
  let x = jsonDecLocalX(f.index)
  if (isJsonContainer(f.kind)) {
    return jbLet(db.jb, x, jbCloneType(db.jb.tree, f.typeNode, 0), 0)
  }
  return jbLet(db.jb, x, 0, jdtZero(db, f))
}

// `[]T`: the field's path bound once, the accumulator reset, the array entered,
// and a cursor for the `tags[3]` path an element failure reports.
fn jdtSliceStmts(db: JsonDecBuild, f: JsonField): []int {
  let p = jsonDecLocalP(f.index)
  let x = jsonDecLocalX(f.index)
  let ix = jsonDecLocalI(f.index)
  let elemRef = JsonDecPathRef{
    parent: jdLocal(db, p), step: jdLocal(db, ix), byIndex: true,
  }
  let add = jbCall(
    db.jb, jdLocal(db, "append"),
    [jdLocal(db, x), jdtValueOf(db, jdElemOf(db, f), elemRef)],
  )
  let body = jbNode(
    db.jb, Tag.Block,
    [
      jbAssignTo(db.jb, jdLocal(db, x), add),
      jbAssignTo(db.jb, jdLocal(db, ix), jbAdd(db.jb, jdLocal(db, ix), jbInt(db.jb, "1"))),
    ],
  )
  return [
    jbLet(db.jb, p, 0, jdFieldPath(db, f)),
    jbAssignTo(db.jb, jdLocal(db, x), jdtEmptySlice(db, f)),
    jdtHelperStmt(db, "jsonTextArray", [jdLocal(db, p), jdLocal(db, jsonDecParamD)]),
    jbLet(db.jb, ix, 0, jbInt(db.jb, "0")),
    jbNode(
      db.jb, Tag.WhileStmt,
      [jdtHelperCall(db, "jsonTextItem", [jdLocal(db, ix)]), body],
    ),
  ]
}

// `map<string, T>`: the same shape over the object's own members, keyed by each
// member's key. The keys are already strings, so nothing converts them; a value
// failure reports `<field>.<key>`.
fn jdtMapStmts(db: JsonDecBuild, f: JsonField): []int {
  let p = jsonDecLocalP(f.index)
  let x = jsonDecLocalX(f.index)
  let n = jsonDecTextLocalN2(f.index)
  let k = jsonDecTextLocalK(f.index)
  let valRef = JsonDecPathRef{
    parent: jdLocal(db, p), step: jdLocal(db, k), byIndex: false,
  }
  let slot = jbNode(db.jb, Tag.Index, [jdLocal(db, x), jdLocal(db, k)])
  let body = jbNode(
    db.jb, Tag.Block,
    [
      jbAssignTo(db.jb, jdLocal(db, n), jbAdd(db.jb, jdLocal(db, n), jbInt(db.jb, "1"))),
      jbLet(
        db.jb, k, 0,
        jbCall(db.jb, jdLocal(db, "jsonTextKeyText"), [jdLocal(db, jsonDecTextParamR)]),
      ),
      jbAssignTo(db.jb, slot, jdtValueOf(db, jdElemOf(db, f), valRef)),
    ],
  )
  return [
    jbLet(db.jb, p, 0, jdFieldPath(db, f)),
    jbAssignTo(db.jb, jdLocal(db, x), jdtEmptyMap(db, f)),
    jdtHelperStmt(db, "jsonTextObject", [jdLocal(db, p), jdLocal(db, jsonDecParamD)]),
    jbLet(db.jb, n, 0, jbInt(db.jb, "0")),
    jbNode(
      db.jb, Tag.WhileStmt,
      [jdtHelperCall(db, "jsonTextKey", [jdLocal(db, n)]), body],
    ),
  ]
}

// The value a simple field's local is assigned. A nested class and an `Option`
// are wrapped, everything else lands as it is read.
fn jdtSimpleValue(db: JsonDecBuild, f: JsonField): int {
  let raw = jdtValueOf(db, jdElemOf(db, f), jdFieldRef(db, f))
  if (f.kind == jkOption) {
    return jdtSome(db, jbCloneType(db.jb.tree, f.typeNode, 0), raw)
  }
  if (f.kind == jkNested) {
    return jdtSome(db, jdtOptionType(db, f.typeNode), raw)
  }
  return raw
}

// Every statement one field contributes once its key has been matched.
fn jdtFieldStmts(db: JsonDecBuild, f: JsonField): []int {
  if (f.kind == jkSlice) {
    return jdtSliceStmts(db, f)
  }
  if (f.kind == jkMap) {
    return jdtMapStmts(db, f)
  }
  return [jbAssignTo(db.jb, jdLocal(db, jsonDecLocalX(f.index)), jdtSimpleValue(db, f))]
}

// `if (!jsonTextNull(__json_r)) { <field>; __json_ds<i> = true }` — the arm one
// matched key runs.
//
// A key present with an explicit `null` leaves the local at its zero and the
// flag at false, so a non-`Option` field reports `missing key` and an `Option`
// stays `None`. That is `jsonDecMember`/`jsonDecOptMember`'s rule, reached
// through the token stream instead of through the tree.
fn jdtFieldArm(db: JsonDecBuild, f: JsonField): int {
  db.jb.span = getNode(db.jb.tree, f.nameNode).span
  let stmts = jdtFieldStmts(db, f)
  if (f.kind != jkOption) {
    stmts = append(
      stmts,
      jbAssignTo(db.jb, jdLocal(db, jsonDecTextLocalS(f.index)), jdtBool(db, "true")),
    )
  }
  let live = jdtNot(
    db,
    jbCall(
      db.jb, jdLocal(db, "jsonTextNull"), [jdLocal(db, jsonDecTextParamR)],
    ),
  )
  return jbNode(db.jb, Tag.IfStmt, [live, jbNode(db.jb, Tag.Block, stmts), 0])
}

// ---- the member walk -------------------------------------------------------

// The `if (jsonTextKeyIs(...)) ... else ...` chain over the class's fields,
// from field `i` on, ending in the unknown-key refusal.
//
// Recursive because the chain IS right-nested — an `else if` is an `IfStmt` in
// the else slot (parserstmt.bit) — and bounded by the class's field count.
//
// UNKNOWN KEYS ARE REPORTED, NOT IGNORED, for the reason `jsonDecUnknown`
// states: a dropped field and an accepted field are indistinguishable to
// whoever sent the document. Here it costs nothing extra — the else arm of a
// chain that has to exist anyway.
fn jdtDispatch(db: JsonDecBuild, jc: JsonClass, i: int): int {
  if (i >= len(jc.fields)) {
    db.jb.span = getNode(db.jb.tree, jc.className).span
    return jbNode(
      db.jb, Tag.Block,
      [jdtHelperStmt(db, "jsonTextUnknown", [jdLocal(db, jsonDecParamP)])],
    )
  }
  let f = jc.fields[i]
  let arm = jdtFieldArm(db, f)
  db.jb.span = getNode(db.jb.tree, f.nameNode).span
  let cond = jbCall(
    db.jb, jdLocal(db, "jsonTextKeyIs"),
    [jdLocal(db, jsonDecTextParamR), jbKeyExpr(db.jb, f)],
  )
  return jbNode(
    db.jb, Tag.IfStmt,
    [cond, jbNode(db.jb, Tag.Block, [arm]), jdtDispatch(db, jc, i + 1)],
  )
}

// `while (jsonTextKey(__json_r, __json_dn)?) { __json_dn = __json_dn + 1; ... }`
//
// The loop needs no guard of its own, and that is a property of the reader
// rather than an omission: `jsonTextKey` charges every call against a budget of
// `len(src) + 1` (stdlib/json/dectext.bit) and fails past it, so the number of
// iterations every loop in the whole decode can take together is bounded by the
// document's own length.
fn jdtMemberLoop(db: JsonDecBuild, jc: JsonClass): int {
  db.jb.span = getNode(db.jb.tree, jc.className).span
  let bump = jbAssignTo(
    db.jb, jdLocal(db, jsonDecTextLocalN),
    jbAdd(db.jb, jdLocal(db, jsonDecTextLocalN), jbInt(db.jb, "1")),
  )
  let body = jbNode(db.jb, Tag.Block, [bump, jdtDispatch(db, jc, 0)])
  db.jb.span = getNode(db.jb.tree, jc.className).span
  return jbNode(
    db.jb, Tag.WhileStmt,
    [jdtHelperCall(db, "jsonTextKey", [jdLocal(db, jsonDecTextLocalN)]), body],
  )
}

// ---- the whole decoder -----------------------------------------------------

// Every field's local, and the flag a non-`Option` field's missing-key check
// reads.
fn jdtFieldDecls(db: JsonDecBuild, jc: JsonClass): []int {
  let out = []int(0)
  for f of jc.fields {
    db.jb.span = getNode(db.jb.tree, f.nameNode).span
    out = append(out, jdtDeclare(db, f))
    if (f.kind != jkOption) {
      out = append(
        out, jbLet(db.jb, jsonDecTextLocalS(f.index), 0, jdtBool(db, "false")),
      )
    }
  }
  return out
}

// `jsonTextNeed(__json_ds<i>, __json_p, "<key>")?` per non-`Option` field, in
// declaration order — so a document missing two keys names the first one the
// class declares, exactly as the DOM decoder does.
fn jdtNeedChecks(db: JsonDecBuild, jc: JsonClass): []int {
  let out = []int(0)
  for f of jc.fields {
    if (f.kind == jkOption) {
      continue
    }
    db.jb.span = getNode(db.jb.tree, f.nameNode).span
    let call = jbCall(
      db.jb, jdLocal(db, "jsonTextNeed"),
      [
        jdLocal(db, jsonDecTextLocalS(f.index)), jdLocal(db, jsonDecParamP),
        jbKeyExpr(db.jb, f),
      ],
    )
    out = append(out, jbNode(db.jb, Tag.ExprStmt, [jbTry(db.jb, call)]))
  }
  return out
}

// `C{ id: __json_x0, ... }` — every accepted field, in declaration order. A
// nested class is unwrapped out of the `Option` it was held in, which is safe
// because `jdtNeedChecks` has already refused an absent one.
fn jdtResultLit(db: JsonDecBuild, jc: JsonClass): int {
  let inits = []int(0)
  for f of jc.fields {
    db.jb.span = getNode(db.jb.tree, f.nameNode).span
    let name = addLeaf(db.jb.tree, Tag.Ident, getNode(db.jb.tree, f.nameNode).span)
    inits = append(
      inits, jbNode(db.jb, Tag.FieldInit, [name, jdtResultValue(db, f)]),
    )
  }
  db.jb.span = getNode(db.jb.tree, jc.className).span
  return jbNode(
    db.jb, Tag.CompositeLit,
    [jdClassRef(db, jc), jbNode(db.jb, Tag.FieldInits, inits)],
  )
}

fn jdtResultValue(db: JsonDecBuild, f: JsonField): int {
  if (f.kind == jkNested) {
    return jbCall(
      db.jb, jdLocal(db, "unwrap"), [jdLocal(db, jsonDecLocalX(f.index))],
    )
  }
  return jdLocal(db, jsonDecLocalX(f.index))
}

// `(__json_r: JsonReader, __json_p: string, __json_d: i64)`.
fn jdtParams(db: JsonDecBuild): int {
  return jbNode(
    db.jb, Tag.Params,
    [
      jbNode(db.jb, Tag.Param, [jbIdent(db.jb, jsonDecTextParamR), jbIdent(db.jb, "JsonReader")]),
      jbNode(db.jb, Tag.Param, [jbIdent(db.jb, jsonDecParamP), jbIdent(db.jb, "string")]),
      jbNode(db.jb, Tag.Param, [jbIdent(db.jb, jsonDecParamD), jbIdent(db.jb, "i64")]),
    ],
  )
}

// The three nodes a synthesized declaration differs by. Bundled so
// `jdtFuncDecl` stays inside LINT.md's max-params=5 without positional
// indexing.
class JsonDecTextFn {
  params: int,
  result: int,
  body: int,
}

// A top-level free declaration named `name`, exported iff the CLASS is: a class
// the module keeps to itself cannot be named from outside, so neither of its
// decoders can be called from outside either.
fn jdtFuncDecl(db: JsonDecBuild, jc: JsonClass, name: string, fnp: JsonDecTextFn): int {
  let tree = db.jb.tree
  let classSpan = getNode(tree, jc.className).span
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [0, synthIdent(tree, db.jb.st, name), 0, fnp.params, fnp.result, fnp.body],
  )
  if (!jc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// The reader-driven decoder for one class.
fn synthJsonTextDecoder(db: JsonDecBuild, jc: JsonClass): int {
  let tree = db.jb.tree
  let classSpan = getNode(tree, jc.className).span
  db.jb.span = classSpan
  let stmts = [
    jdtHelperStmt(
      db, "jsonTextObject",
      [jdLocal(db, jsonDecParamP), jdLocal(db, jsonDecParamD)],
    ),
  ]
  for s of jdtFieldDecls(db, jc) {
    stmts = append(stmts, s)
  }
  db.jb.span = classSpan
  stmts = append(stmts, jbLet(db.jb, jsonDecTextLocalN, 0, jbInt(db.jb, "0")))
  stmts = append(stmts, jdtMemberLoop(db, jc))
  for s of jdtNeedChecks(db, jc) {
    stmts = append(stmts, s)
  }
  let body = jdtResultLit(db, jc)
  db.jb.span = classSpan
  stmts = append(stmts, jbNode(db.jb, Tag.ReturnStmt, [body]))
  let name = identText(tree, db.jx.source, jc.className)
  return jdtFuncDecl(
    db, jc, jsonDecTextName(name),
    JsonDecTextFn{
      params: jdtParams(db),
      result: jbNode(db.jb, Tag.Fallible, [jdClassRef(db, jc), 0]),
      body: jbNode(db.jb, Tag.Block, stmts),
    },
  )
}

// The entry point a rewritten `jsonDecodeText<C>(src)` names: build the reader,
// decode one value at the root, and refuse anything after it.
//
// `jsonTextFinish` is why this wrapper exists at all rather than the call site
// being rewritten to the decoder directly: a trailing second document is a
// malformed request, `jsonParse` refuses it through `parseTopLevel`, and three
// statements cannot be spelled as one expression at a call site.
fn synthJsonTextRoot(db: JsonDecBuild, jc: JsonClass): int {
  let tree = db.jb.tree
  let name = identText(tree, db.jx.source, jc.className)
  db.jb.span = getNode(tree, jc.className).span
  let decode = jbTry(
    db.jb,
    jbCall(
      db.jb, jdLocal(db, jsonDecTextName(name)),
      [
        jdLocal(db, jsonDecTextParamR), jdtEmptyString(db),
        jbInt(db.jb, jsonDecodeZeroWord),
      ],
    ),
  )
  let stmts = [
    jbLet(
      db.jb, jsonDecTextParamR, 0,
      jbCall(
        db.jb, jdLocal(db, "jsonTextReader"), [jdLocal(db, jsonDecTextParamSrc)],
      ),
    ),
    jbLet(db.jb, jsonDecTextLocalV, 0, decode),
    jdtHelperStmt(db, "jsonTextFinish", []int(0)),
    jbNode(db.jb, Tag.ReturnStmt, [jdLocal(db, jsonDecTextLocalV)]),
  ]
  let params = jbNode(
    db.jb, Tag.Params,
    [
      jbNode(
        db.jb, Tag.Param,
        [jbIdent(db.jb, jsonDecTextParamSrc), jbIdent(db.jb, "string")],
      ),
    ],
  )
  return jdtFuncDecl(
    db, jc, jsonDecTextRootName(name),
    JsonDecTextFn{
      params: params,
      result: jbNode(db.jb, Tag.Fallible, [jdClassRef(db, jc), 0]),
      body: jbNode(db.jb, Tag.Block, stmts),
    },
  )
}

// Every demanded class's text decoder, plus a root wrapper for the ones a call
// actually names, for the caller to attach in the one pass that attaches
// `@json`'s encoders, the DOM decoders and #3879's validators.
fn injectJsonDecodeTextDecls(jx: JsonCtx, st: SynthText, plan: SynthPlan): []int {
  let out = []int(0)
  if (len(plan.textClasses) == 0) {
    return out
  }
  let db = JsonDecBuild{
    jb: JsonBuild{ tree: jx.tree, st: st, span: pointSpan(0, 0) }, jx: jx,
  }
  for jc of plan.textClasses {
    out = append(out, synthJsonTextDecoder(db, jc))
  }
  for jc of plan.textRootClasses {
    out = append(out, synthJsonTextRoot(db, jc))
  }
  return out
}
