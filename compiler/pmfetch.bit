// compiler/pmfetch.bit — git-URL dependency fetch into a content-addressed
// cache (#1733, epic #1480). Registry model per spec §17.7: no hosted
// service in v1, a dependency spec resolves straight to a git remote. This
// file shells out to the system `git` binary — never a hand-rolled git
// wire-protocol client — and never executes anything found inside a fetched
// package (no build/postinstall scripts, no exceptions).
//
// Layout on disk: a resolved dependency lands at
// `<cacheRoot>/<host>/<owner>/<repo>/<sha>/`, a real `git` checkout (the
// `.git` directory is kept, not stripped) so a cache hit can be verified with
// `git rev-parse HEAD` — the resolved commit's own identity is the integrity
// check, not a hash Bit invents. `fetchSha` is the entry point that already
// knows the target sha (the `bit.lock`-driven path); `resolveDependencyRef`
// is the separate, read-only step that turns a mutable ref (branch/tag) into
// one.
//
// Every subprocess this file spawns carries a wall-clock deadline and is
// killed by its own PID on timeout, never a name pattern — the same
// discipline `tests/proc.zig` documents for this repo's own test harnesses
// (one absolute deadline; timeout is a distinct outcome from a crash). Bit
// has no subprocess-timeout primitive of its own yet (`osRun` blocks until
// its child exits), so `runGit` reimplements the same discipline as a small
// generated POSIX `/bin/sh` wrapper: it backgrounds the real command, races
// it against a watcher subshell that SIGKILLs that exact child pid if the
// deadline passes first, and reports which one happened. See `runGit`'s own
// comment for the two races that shape its exact form.
import { open, exists, isDir, mkdir, remove } from "std/fs"
import { split } from "std/strings"
import { join as pmJoin } from "std/path"
import { env } from "std/os"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Wall-clock ceiling a caller may pass to any function below. 30s: resolving
// a ref or shallow-fetching one small module over a healthy connection is a
// small fraction of this; a caller wiring up interactive `bit add`/`bit up`
// (not part of this file — see the module header on #1733's own ticket) is
// expected to pass its own, shorter budget when it wants faster user
// feedback on a bad host.
export const defaultTimeoutMs: int = 30000

// Ceiling on a fetched module's `bit.json` before it is parsed at all: reject
// and error, never allocate/parse past this. A dependency's manifest is
// untrusted content (fetched from a third-party git remote), and SPEC §17.7's
// whole dependency map is a handful of short strings, so 1 MiB is far beyond
// any legitimate file — Power of 10 rule 3 (no unbounded allocation).
export const maxManifestBytes: int = 1048576

export const defaultGitBin: string = "git"

// One resolved dependency spec, SPEC §17.7: `gitHost/owner/repo@ref`.
export struct DepSpec { host: string, owner: string, repo: string, ref: string }

export struct FetchResult { dir: string, sha: string, cacheHit: bool }

// One `runGit` invocation's outcome. `exitCode` is meaningless when
// `timedOut` — the child was killed, not let finish.
struct GitRun { exitCode: int, timedOut: bool, output: string }

// --- dependency spec parsing ------------------------------------------

// Splits `gitHost/owner/repo@ref` into its parts. Rejects a malformed spec
// (missing `@`, wrong segment count, an empty ref) or a host/owner/repo that
// is not a safe filesystem path component — both are validated here because
// every valid parse becomes a cache directory name later.
export function parseSpec(spec: string): DepSpec! {
  let at = lastIndexByte(spec, '@')
  if (at < 0) {
    fail newError("pmfetch: dependency spec has no @ref: ${spec}")
  }
  let ref = spec[at + 1:len(spec)]
  if (len(ref) == 0) {
    fail newError("pmfetch: dependency spec has an empty ref: ${spec}")
  }
  let parts = split(spec[0:at], "/")
  if (len(parts) != 3) {
    fail newError("pmfetch: dependency spec must be gitHost/owner/repo@ref: ${spec}")
  }
  validateSegment(parts[0])?
  validateSegment(parts[1])?
  validateSegment(parts[2])?
  return DepSpec{ host: parts[0], owner: parts[1], repo: parts[2], ref: ref }
}

function lastIndexByte(s: string, c: u8): int {
  let i = len(s)
  while (i > 0) {
    if (s[i - 1] == c) {
      return i - 1
    }
    i = i - 1
  }
  return -1
}

// A safe single path component: non-empty, not `.`/`..`, and drawn from a
// charset that can never introduce a `/` or a traversal segment — `host`,
// `owner`, and `repo` all become cache directory names, so this is the one
// gate keeping a hostile dependency spec from writing outside `cacheRoot`.
function validateSegment(s: string): ()! {
  if (len(s) == 0 || s == "." || s == "..") {
    fail newError("pmfetch: invalid path segment in dependency spec: '${s}'")
  }
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    let ok = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
      c == '-' || c == '_' || c == '.'
    if (!ok) {
      fail newError("pmfetch: invalid character in dependency spec segment: '${s}'")
    }
    i = i + 1
  }
}

function isFullSha(s: string): bool {
  if (len(s) != 40) {
    return false
  }
  let i = 0
  while (i < 40) {
    let c = s[i]
    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
      return false
    }
    i = i + 1
  }
  return true
}

// --- resolving a ref to a commit -----------------------------------------

// Resolves `ref` (an exact tag, a branch name, or a bare commit sha) against
// `url` to a 40-hex commit sha. A `ref` that is already a full sha is
// returned as-is with no subprocess call at all — SPEC §17.7 allows pinning a
// bare sha directly, and there is nothing to resolve. Otherwise runs
// `git ls-remote`, bounded by `timeoutMs`.
export function resolveDependencyRef(gitBin: string, url: string, ref: string, timeoutMs: int): string! {
  if (isFullSha(ref)) {
    return ref
  }
  let run = runGit(gitBin, ["ls-remote", "--exit-code", url, ref], timeoutMs)?
  if (run.timedOut) {
    fail newError("pmfetch: git ls-remote timed out after ${timeoutMs}ms: ${url}@${ref}")
  }
  if (run.exitCode != 0) {
    fail newError("pmfetch: git ls-remote failed (exit ${run.exitCode}) for ${url}@${ref}: ${pmTrim(run.output)}")
  }
  let sha = firstShaFromLsRemote(run.output)
  if (len(sha) == 0) {
    fail newError("pmfetch: git ls-remote returned no match for ${url}@${ref}")
  }
  return sha
}

// `git ls-remote`'s output is one `<sha>\t<ref>` line per match; the first
// line's sha is what a bare ref name or tag resolves to.
function firstShaFromLsRemote(output: string): string {
  let i = 0
  while (i < len(output) && output[i] != '\n' && output[i] != '\t' && output[i] != ' ') {
    i = i + 1
  }
  let candidate = output[0:i]
  if (isFullSha(candidate)) {
    return candidate
  }
  return ""
}

// --- fetching into the content-addressed cache ---------------------------

// Fetches `sha` from `url` into `<cacheRoot>/<host>/<owner>/<repo>/<sha>/`, or
// verifies an already-cached copy. `sha` must already be a resolved 40-hex
// commit — this is the `bit.lock`-driven entry point (a lock entry records
// exactly this), not the ref-resolving one (`resolveDependencyRef`, above).
//
// A cache hit is verified, never trusted blind: `git rev-parse HEAD` inside
// the cached checkout must equal `sha`, or this fails loudly rather than
// silently re-fetching — a mismatch means the cache directory was tampered
// with or corrupted, and re-resolving over it would paper over exactly that.
// The same applies to a *partial* prior fetch (interrupted before it ever
// reached a valid HEAD): the directory already exists, so it is a cache-hit
// candidate, and verification reports it as broken rather than silently
// redoing the work — clearing a broken cache entry is a human's call.
export function fetchSha(
  gitBin: string, cacheRoot: string, host: string, owner: string, repo: string,
  url: string, sha: string, timeoutMs: int,
): FetchResult! {
  if (!isFullSha(sha)) {
    fail newError("pmfetch: fetchSha needs an already-resolved commit sha, got: ${sha}")
  }
  validateSegment(host)?
  validateSegment(owner)?
  validateSegment(repo)?

  let finalDir = cacheRoot + "/" + host + "/" + owner + "/" + repo + "/" + sha

  if (isDir(finalDir)) {
    let actual = revParseHead(gitBin, finalDir, timeoutMs)?
    if (actual != sha) {
      fail newError("pmfetch: cache integrity error at ${finalDir}: expected ${sha}, found ${actual}")
    }
    return FetchResult{ dir: finalDir, sha: sha, cacheHit: true }
  }

  mkdirAll(pathDir(finalDir))?

  let init = runGit(gitBin, ["init", "--quiet", finalDir], timeoutMs)?
  if (init.timedOut) {
    fail newError("pmfetch: git init timed out after ${timeoutMs}ms: ${finalDir}")
  }
  if (init.exitCode != 0) {
    fail newError("pmfetch: git init failed (exit ${init.exitCode}) for ${finalDir}: ${pmTrim(init.output)}")
  }

  let fetch = runGit(gitBin, ["-C", finalDir, "fetch", "--quiet", "--depth", "1", url, sha], timeoutMs)?
  if (fetch.timedOut) {
    fail newError("pmfetch: git fetch timed out after ${timeoutMs}ms: ${url}@${sha}")
  }
  if (fetch.exitCode != 0) {
    fail newError("pmfetch: git fetch failed (exit ${fetch.exitCode}) for ${url}@${sha}: ${pmTrim(fetch.output)}")
  }

  let checkout = runGit(gitBin, ["-C", finalDir, "checkout", "--quiet", sha], timeoutMs)?
  if (checkout.timedOut) {
    fail newError("pmfetch: git checkout timed out after ${timeoutMs}ms: ${sha} in ${finalDir}")
  }
  if (checkout.exitCode != 0) {
    fail newError("pmfetch: git checkout failed (exit ${checkout.exitCode}) for ${sha} in ${finalDir}: ${pmTrim(checkout.output)}")
  }

  let actual = revParseHead(gitBin, finalDir, timeoutMs)?
  if (actual != sha) {
    fail newError("pmfetch: fetched content does not match requested sha (got ${actual}, want ${sha}) in ${finalDir}")
  }
  return FetchResult{ dir: finalDir, sha: sha, cacheHit: false }
}

// The checked-out commit at `dir`, or a loud failure naming why it could not
// be confirmed. A local (no-network) `git rev-parse`, same deadline as every
// other invocation here.
function revParseHead(gitBin: string, dir: string, timeoutMs: int): string! {
  let run = runGit(gitBin, ["-C", dir, "rev-parse", "HEAD"], timeoutMs)?
  if (run.timedOut) {
    fail newError("pmfetch: git rev-parse timed out after ${timeoutMs}ms verifying ${dir}")
  }
  if (run.exitCode != 0) {
    fail newError("pmfetch: cannot verify cache at ${dir}: incomplete or corrupted checkout (git rev-parse HEAD failed: ${pmTrim(run.output)})")
  }
  let sha = pmTrim(run.output)
  if (!isFullSha(sha)) {
    fail newError("pmfetch: cannot verify cache at ${dir}: unexpected rev-parse output")
  }
  return sha
}

// `trimSpace` (std/strings) only strips spaces and tabs, not newlines — every
// subprocess this file captures ends its output in one, so this is the
// trimmer actually used on `runGit` output throughout this file.
function pmTrim(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t' || s[lo] == '\n' || s[lo] == '\r')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t' || s[hi - 1] == '\n' || s[hi - 1] == '\r')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// mkdir -p, iteratively (Power of 10 rule 2: bounded by the path's own
// segment count, no recursion). `std/fs.mkdir` fails if the parent is
// missing, so every prefix is created in order.
function mkdirAll(path: string): ()! {
  if (len(path) == 0 || isDir(path)) {
    return
  }
  let parts = split(path, "/")
  let acc = ""
  let i = 0
  while (i < len(parts)) {
    if (len(parts[i]) > 0) {
      acc = acc + "/" + parts[i]
      if (!isDir(acc)) {
        mkdir(acc)?
      }
    }
    i = i + 1
  }
}

// --- the default ~/.bit/pkg cache root -----------------------------------

// `BIT_PKG_CACHE` overrides the whole root, the same override pattern
// `stdRootPath` (main.bit) already uses for `BIT_STDLIB` — it lets a sandboxed
// or CI checkout point a `bit build` at a pre-warmed cache without writing
// into the real `$HOME`, and it is what compiler/projectcheck.bit's own
// self-check uses to prove the warm-cache path never dials the network,
// without touching the developer's own `~/.bit/pkg`.
export function defaultCacheRoot(): string! {
  let override = envOr("BIT_PKG_CACHE", "")
  if (len(override) > 0) {
    return override
  }
  let home = env("HOME")
  if (len(home) == 0) {
    fail newError("pmfetch: HOME is not set")
  }
  return home + "/.bit/pkg"
}

// The git remote a bare `host/owner/repo` resolves to per SPEC §17.7's
// git-only registry model — the one URL-derivation rule `bit add`'s CLI layer
// (pmcli.bit's `addCmd`) and `bit up`'s (`upDependencies`) both need for a
// dependency bit.lock has no recorded `url` for yet, kept in one place rather
// than each re-deriving the same string.
export function defaultDepUrl(host: string, owner: string, repo: string): string {
  return "https://" + host + "/" + owner + "/" + repo + ".git"
}

// Parse + resolve + fetch in one call, against the default cache root and
// system git. The high-level entry a future CLI layer (`bit add`/`up`, not
// part of this file) would call for a fresh, not-yet-locked dependency.
export function fetchDependency(spec: string, timeoutMs: int): FetchResult! {
  let d = parseSpec(spec)?
  let url = defaultDepUrl(d.host, d.owner, d.repo)
  let sha = resolveDependencyRef(defaultGitBin, url, d.ref, timeoutMs)?
  let root = defaultCacheRoot()?
  return fetchSha(defaultGitBin, root, d.host, d.owner, d.repo, url, sha, timeoutMs)?
}

// --- a fetched dependency's own bit.json -----------------------------

// Reads and validates `<dir>/bit.json` — size-capped before anything is
// parsed, then parsed with the shared JSON parser's own nesting-depth guard
// (`jsonparse.bit`'s `jsonMaxDepth`), never a bespoke reader. A dependency
// with no manifest at all (nothing further to resolve) is not an error: it
// reads as an empty, well-formed document.
export function readManifest(dir: string): JsonDoc! {
  let path = pmJoin(dir, "bit.json")
  if (!exists(path)) {
    return JsonDoc{ nodes: []JsonValue(0), root: -1, ok: true }
  }
  let f = open(path)?
  defer f.close()
  let text = f.read(maxManifestBytes + 1)
  if (len(text) > maxManifestBytes) {
    fail newError("pmfetch: ${path} exceeds the ${maxManifestBytes}-byte manifest cap")
  }
  let doc = jsonParse(text)
  if (!doc.ok) {
    fail newError("pmfetch: ${path} is not valid JSON")
  }
  return doc
}

// --- subprocess plumbing --------------------------------------------------

// Runs `[gitBin, ...args]` with a hard wall-clock deadline, capturing
// combined stdout+stderr. Builds and execs a throwaway `/bin/sh` script
// rather than calling `osRun` on `gitBin` directly, for two independent
// reasons: `osRun` takes no argv (only a bare path) and has no timeout, and a
// shell is the only way this language can express "kill this child if it
// outruns a deadline" today (see the module header).
//
// Every dynamic value (`gitBin`, each of `args`, the output path) is
// single-quoted with `shQuote` before it reaches the script text, so a
// hostile URL or ref — this all ultimately traces back to a fetched
// `bit.json` — can shell-quote-break out of its own argument but never out of
// the script into a second command.
//
// The watcher race: a naive "watcher kills child, then touches a flag file"
// design has a real bug — `kill -9` on an already-exited-but-not-yet-reaped
// zombie still reports success, so a child that finishes microseconds before
// the deadline can still look "killed by the deadline" to a racing watcher.
// This avoids that by ordering on the WATCHER's own liveness instead: after
// the main `wait` on the child returns, `kill -0 "$watcher"` distinguishes
// "the watcher is still sleeping" (the child finished on its own; take its
// real status) from "the watcher already ran" (it must have fired the kill;
// report timeout) — no zombie-pid ambiguity, because the watcher itself is
// never waited on until this check has already resolved which happened.
function runGit(gitBin: string, args: []string, timeoutMs: int): GitRun! {
  let base = scratchBase()
  let scriptPath = base + ".sh"
  let outPath = base + ".out"
  defer removeQuiet(scriptPath)
  defer removeQuiet(outPath)

  let timeoutSecs = timeoutMs / 1000
  if (timeoutSecs < 1) {
    timeoutSecs = 1
  }

  let cmd = shQuote(gitBin)
  let i = 0
  while (i < len(args)) {
    cmd = cmd + " " + shQuote(args[i])
    i = i + 1
  }

  let script = "#!/bin/sh\n" +
    cmd + " > " + shQuote(outPath) + " 2>&1 &\n" +
    "child=$!\n" +
    "( sleep ${timeoutSecs}; kill -9 \"$child\" 2>/dev/null ) &\n" +
    "watcher=$!\n" +
    "wait \"$child\" 2>/dev/null\n" +
    "status=$?\n" +
    "if kill -0 \"$watcher\" 2>/dev/null; then\n" +
    "  kill \"$watcher\" 2>/dev/null\n" +
    "  wait \"$watcher\" 2>/dev/null\n" +
    "  exit \"$status\"\n" +
    "fi\n" +
    "wait \"$watcher\" 2>/dev/null\n" +
    "exit 124\n"

  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700: owner rwx only
    fail newError("pmfetch: cannot make wrapper script executable: ${scriptPath}")
  }

  let code = osRun(scriptPath)
  let output = readFile(outPath) catch e { "" }
  if (code == 124) {
    return GitRun{ exitCode: -1, timedOut: true, output: output }
  }
  if (code < 0) {
    fail newError("pmfetch: cannot launch git wrapper script: ${scriptPath}")
  }
  return GitRun{ exitCode: code, timedOut: false, output: output }
}

function scratchBase(): string {
  return envOr("TMPDIR", "/tmp") + "/bitpm-" + uuidFormat(uuidV4())
}

function removeQuiet(path: string) {
  remove(path) catch e { return }
}

// Wraps `s` in single quotes for safe use as one POSIX `/bin/sh` argument
// word: every embedded `'` becomes `'\''` (close the quote, an escaped literal
// quote, reopen the quote), the standard POSIX-shell escaping technique.
function shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\'') {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}
