// compiler/parserstatic.bit — split out of parsertype.bit (#6091, to keep
// that file under the repo's 800-line ceiling). Sibling of parsertype.bit:
// same module, so this needs no imports and no call-site changes.
//
// `static fn name(...)` class methods (SPEC §10.4.1): a method on the TYPE,
// not the instance, called `ClassName.name(...)` and callable through a
// bound generic type parameter (`T.name()` where `T`'s bound declares the
// requirement) — see #6091's tracking ticket for the checker/lowering half,
// which is not yet wired: parsing lands ahead of it so the grammar and the
// `Receiver.main == 1` representation are fixed before the rest is built on
// top of them.

// `static` is a CONTEXTUAL keyword, the same shape as `use` (parsertype.bit)
// and `extern`/`test` (parserdecl.bit): it lexes as an ordinary identifier
// and stays usable as one everywhere else — `static: int` (a field) and a
// plain in-body method named `static` both still parse. Unlike `use`, whose
// second token is always an identifier, a static method's next token is the
// REAL keyword `fn` (`Kind.KwFunction`), which a field or an ordinary method
// name can never be immediately followed by (`:` starts a field, `(`/`<`
// starts a method) — so this commits with no lookahead risk.
fn atStaticMethod(p: Parser): bool {
  return p.staticMethodsEnabled &&
    peekKind(p) == Kind.Ident &&
    curText(p) == "static" &&
    peekKindAt(p, 1) == Kind.KwFunction
}

// `static fn name [generic_params] (params) [: result] { body }` (SPEC
// §10.4.1, #6091): a method on the TYPE, not the instance. Builds the exact
// `func_decl` shape `parseMethodMember` (parsertype.bit) does — same merged
// generics, same `classTypeRef` receiver naming the owning class — so every
// existing reader keyed off `kids[0] != 0` (checkbindfunc.bit's
// `collectFuncDecl`/`buildSignatures`, which key `methodResults`/
// `methodSigs` under the receiver's type) keeps working unchanged and
// registers this method under the SAME "<typeId>.<name>" namespace an
// instance method uses. The one difference is the Receiver node's `main`
// field: 1 here, 0 for an instance method — the single bit
// `resolvebody.bit`'s `rResolveFuncDecl` and `checkmodule.bit`'s
// `bindParamOrReceiver` read to skip binding `this`, since a static method
// has none.
fn parseStaticMethodMember(p: Parser, exported: bool, className: int, classGenerics: int): int {
  let kwStart = peekTok(p).start
  advance(p) // 'static'
  advance(p) // 'fn'
  let name = expectIdent(p)
  let generics = mergeGenericParams(p, dupGenericParams(p, classGenerics), maybeGenericParams(p))
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let body = parseBlock(p)
  let recv = mkSpanNode(
    p, Tag.Receiver, 1, [0, classTypeRef(p, className, classGenerics)],
    kwStart, getNode(p.tree, name).span.end,
  )
  let node = mkNode(p, Tag.FuncDecl, 0, [recv, name, generics, params, result, body])
  if (!exported) {
    return node
  }
  return mkNode(p, Tag.Export, 0, [node])
}

// An interface's static requirement (SPEC §10.4.1, #6091/#6099): `static
// name(params) [: result]`, callable only through the declaring TYPE
// (`Iface.name()`) or a generic bound (`T.name()`, `T: Iface`), never
// through an interface VALUE — an interface value carries no type to call a
// static on (checked separately, at the type-annotation sites that would
// make one). `static`'s next token here is always a bare IDENT (an ordinary
// `method_sig` starts `name(...)` or `name<...>`, never `name othername`),
// unlike the class-body form's `static fn`, so the lookahead differs from
// `atStaticMethod` above.
fn atStaticInterfaceMember(p: Parser): bool {
  return p.staticMethodsEnabled &&
    peekKind(p) == Kind.Ident &&
    curText(p) == "static" &&
    peekKindAt(p, 1) == Kind.Ident
}

// `static name(params) [: result]`. Same `[name, params, result]` shape
// `parseMethodSig` (parsertype.bit) builds; `main = 1` is the only
// difference — read by `checkbindfunc.bit`'s `buildSignatures` to record the
// requirement into `TypeContext.staticMethods` under the SAME
// "<ifaceId>.<name>" key `parseMethodSig`'s ordinary form uses, so
// `validateiface.bit`'s `vSatisfies` needs only a staticness-match guard,
// not a second satisfaction walk.
fn parseStaticMethodSig(p: Parser): int {
  advance(p) // 'static'
  let name = expectIdent(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  return mkNode(p, Tag.MethodSig, 1, [name, params, result])
}
