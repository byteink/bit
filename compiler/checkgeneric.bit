// compiler/checkgeneric.bit — split out of check.bit (#1809). Sibling of
// check.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// Whether `name` is a generic free function. Prefer `isGenericFuncAt` wherever
// the referring node is in hand — see `funcRefAt`.
fn isGenericFunc(c: Checker, name: string): bool {
  return funcRefIsGeneric(
    FuncRef{
      owner: declOwner(c, name), decl: funcDeclLookup(c, name),
      declName: declName2(c, name),
    },
  )
}

// Whether the identifier at `node` names a generic free function.
fn isGenericFuncAt(c: Checker, node: int, name: string): bool {
  return funcRefIsGeneric(funcRefAt(c, node, name))
}

// Structurally binds type-param `tpname` from a parameter's type node against a
// concrete argument type: a bare `T` binds directly; `[]T`/`[N]T`/`chan<T>`
// recurse into the element, `map<K,V>` into key then value, `T!E` into the ok
// type. Returns 0 when this parameter does not mention `tpname`.
// `pc` owns `paramNode`'s tree — the module DECLARING the generic, which is not
// the caller's when the generic was imported. `argType` is a TypeId, global to
// the shared context, so it needs no module of its own.
fn bindTypeParamFromNode(pc: Checker, paramNode: int, argType: int, tpname: string): int {
  let pn = getNode(pc.tree, paramNode)
  if (pn.tag == Tag.Ident) {
    if (pc.source[pn.span.start:pn.span.end] == tpname) {
      return argType
    }
    return 0
  }
  if (argType == 0) {
    return 0
  }
  let at = pc.ctx.types[argType]
  let pk = kidsOf(pc.tree, paramNode)
  if (pn.tag == Tag.SliceType && at.kind == TypeKind.Slice) {
    return bindTypeParamFromNode(pc, pk[0], at.elem, tpname)
  }
  if (pn.tag == Tag.ArrayType && at.kind == TypeKind.Array) {
    return bindTypeParamFromNode(pc, pk[1], at.elem, tpname)
  }
  if (pn.tag == Tag.ChanType && at.kind == TypeKind.Chan) {
    return bindTypeParamFromNode(pc, pk[0], at.elem, tpname)
  }
  if (pn.tag == Tag.MapType && at.kind == TypeKind.Map) {
    let k = bindTypeParamFromNode(pc, pk[0], at.mapKey, tpname)
    if (k != 0) {
      return k
    }
    return bindTypeParamFromNode(pc, pk[1], at.mapVal, tpname)
  }
  if (pn.tag == Tag.Fallible && at.kind == TypeKind.Fallible) {
    return bindTypeParamFromNode(pc, pk[0], at.result, tpname)
  }
  // `o: Opt<T>` against a concrete `Opt<string>` (#1560). Every other type
  // constructor above descends into the argument's TYPE; a nominal generic
  // could not, because before per-instantiation identity the argument type
  // carried no arguments to descend into. `nominalArgsOf` now recovers them
  // from the instantiation ledger, so this is the same structural recursion,
  // not another syntactic recovery arm — which is why the shapes #1566 lists
  // (a variant construction, a field read) all bind through one change rather
  // than one arm each.
  //
  // Two guards, both THE SAFETY RULE. The argument must be a real
  // INSTANTIATION — `typeInstOfResult` finding a ledger entry — not a template:
  // a template's `nominalArgsOf` answers its own bare parameters, so descending
  // into one binds `T := T` and returns a useless non-zero that short-circuits
  // the syntactic fallbacks in `bindTypeParamAtCall` which used to answer here
  // (that regressed `okOr(e, 0)` in _tests_/imports/coreopt to E0053). And the
  // base NAME must match, since binding `Opt<T>` against a `Box<string>` would
  // be a guess. Anything else returns 0 and leaves the old path in charge.
  if (pn.tag == Tag.GenericInst &&
    at.hasName &&
    typeNodeName(pc, pk[0]) == at.name &&
    typeInstOfResult(pc.ctx, argType) >= 0) {
    let targs = kidsOf(pc.tree, pk[1])
    let aargs = nominalArgsOf(pc, argType)
    let i = 0
    while (i < len(targs) && i < len(aargs)) {
      let b = bindTypeParamFromNode(pc, targs[i], aargs[i], tpname)
      if (b != 0) {
        return b
      }
      i = i + 1
    }
    return 0
  }
  // `f: (T) => U` against a concrete `(i64) => i64`. Without this a type param
  // reachable ONLY through a function-typed parameter — `U` in
  // `mapped<T, U>(xs: []T, f: (T) => U): []U` — can never bind. Func params live
  // in `members`; try each position, then the result.
  if (pn.tag == Tag.FuncType && at.kind == TypeKind.Func) {
    let plist = kidsOf(pc.tree, pk[0])
    let i = 0
    while (i < len(plist) && i < len(at.members)) {
      let b = bindTypeParamFromNode(pc, plist[i], at.members[i], tpname)
      if (b != 0) {
        return b
      }
      i = i + 1
    }
    return bindTypeParamFromNode(pc, pk[1], at.result, tpname)
  }
  return 0
}

// A call argument expression's node (unwrapping a named `Arg`), or 0.
fn callArgNode(c: Checker, callNode: int, i: int): int {
  let args = kidsOf(c.tree, kidsOf(c.tree, callNode)[2])
  if (i >= len(args)) {
    return 0
  }
  let a = args[i]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  return a
}

// The declared type NODE of a call argument: an ident binding's recorded type
// node, or a composite literal's own `Pair<i64>` type. 0 if unknown.
fn argTypeNode(c: Checker, argNode: int): int {
  if (argNode == 0) {
    return 0
  }
  let n = getNode(c.tree, argNode)
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        return v
      }
    }
    return 0
  }
  if (n.tag == Tag.CompositeLit) {
    return kidsOf(c.tree, argNode)[0]
  }
  return 0
}

// Binds `tpname` by structurally matching a parameter type NODE against an
// argument type NODE (both AST): a bare `T` binds to the arg node's type; a
// generic instance `Pair<T>` recurses into matching type-arg positions. Node-based
// because a generic-class instance TYPE does not carry its type-args (carrying
// them would perturb the type-id parity). Returns 0 if unbound.
// `pnode` (the declared parameter) and `anode` (the call's argument) come from
// DIFFERENT trees whenever the generic was imported, so each side carries its
// own checker. Reading one against the other's tree is the whole bug class this
// exists to avoid.
fn bindTypeParamNodeVsNode(pc: Checker, pnode: int, ac: Checker, anode: int, tpname: string): int {
  if (pnode == 0 || anode == 0) {
    return 0
  }
  let pt = getNode(pc.tree, pnode)
  if (pt.tag == Tag.Ident) {
    if (pc.source[pt.span.start:pt.span.end] == tpname) {
      return typeFromNode(ac, anode)
    }
    return 0
  }
  if (pt.tag == Tag.GenericInst && getNode(ac.tree, anode).tag == Tag.GenericInst) {
    let pta = kidsOf(pc.tree, kidsOf(pc.tree, pnode)[1])
    let ata = kidsOf(ac.tree, kidsOf(ac.tree, anode)[1])
    let i = 0
    while (i < len(pta) && i < len(ata)) {
      let b = bindTypeParamNodeVsNode(pc, pta[i], ac, ata[i], tpname)
      if (b != 0) {
        return b
      }
      i = i + 1
    }
  }
  return 0
}

// The concrete type arguments of a generic call's RESULT, when that result is
// written as the generic instance `wantName<...>`: `find<T>(xs: []T, …): Option<T>`
// applied to a `[]i64` yields [i64] for wantName "Option". Empty for anything
// else — a non-generic callee, a result that is not an instance of `wantName`,
// or any argument that does not resolve to a concrete type.
//
// Only the TYPE-based binder runs here, never `bindTypeParamAtCall`: that one
// can reach back into this function through a binding's initializer, and two
// functions with same-named locals (`let v = f(w)` / `let w = g(v)`) would make
// the flat name map a cycle. Type-based binding terminates on the AST alone.
fn callResultTypeArgs(c: Checker, callNode: int, wantName: string): []int {
  let out = []int(0)
  let name = typeNodeName(c, kidsOf(c.tree, callNode)[0])
  if (name == "") {
    return out
  }
  let fr = funcRefAt(c, calleeNodeOf(c, callNode), name)
  let decl = fr.decl
  if (decl == 0) {
    return out
  }
  // The decl's nodes index its OWN module's tree (see FuncRef); an extern is
  // never generic (SPEC 11.7).
  let oc = fr.owner
  if (isExternDecl(oc.tree, decl)) {
    return out
  }
  let dk = kidsOf(oc.tree, decl)
  if (dk[2] == 0 || dk[4] == 0) {
    return out
  }
  if (getNode(oc.tree, dk[4]).tag != Tag.GenericInst || typeNodeName(oc, dk[4]) != wantName) {
    return out
  }
  let params = kidsOf(oc.tree, dk[3])
  let tps = kidsOf(oc.tree, dk[2])
  let sub = noSubst()
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let pi = 0
    while (pi < len(params)) {
      let b = bindTypeParamFromNode(
        oc, kidsOf(oc.tree, params[pi])[1],
        defaultType(c, checkArgType(c, callNode, pi)), tpname,
      )
      if (b != 0) {
        sub.names = append(sub.names, tpname)
        sub.types = append(sub.types, b)
        pi = len(params)
      }
      pi = pi + 1
    }
    ti = ti + 1
  }
  let targs = kidsOf(oc.tree, kidsOf(oc.tree, dk[4])[1])
  let i = 0
  while (i < len(targs)) {
    let a = typeFromNodeIn(oc, targs[i], sub)
    // An unresolved or still-type-param argument is no better than binding
    // nothing; report NOTHING rather than a wrong answer.
    if (a == 0 || c.ctx.types[a].kind == TypeKind.TypeParam) {
      return []int(0)
    }
    out = append(out, a)
    i = i + 1
  }
  return out
}

// The CALL that initialized the binding the identifier at `node` resolves to, or
// 0. Keyed by the decl NODE and read through the resolver (nodeSymbols ->
// Symbol.decl), so a same-named binding in another function can never answer for
// this one (#1536).
//
// There is deliberately NO name-keyed fallback for an unresolved node (the dump
// entry points never run the resolver). Binding nothing leaves #1498's loud
// refusal, which is recoverable; binding from a same-named local in another
// function is a silent miscompile, which is not.
fn declInitOf(c: Checker, node: int): int {
  if (node > 0 && node < len(c.nodeSymbols)) {
    let sid = c.nodeSymbols[node]
    if (sid > 0 && sid < len(c.symbols)) {
      let (init, ok) = c.declInitNodes[c.symbols[sid].decl]
      if (ok) {
        return init
      }
    }
  }
  return 0
}

// Binds `tpname` from a `Name<T>` parameter against an argument that is a local
// with no written type, by re-deriving the type args of the call that
// initialized it (#1498). This is the case `bindTypeParamNodeVsNode` cannot
// reach: it needs the argument's written type node, and `let found = find<i64>(…)`
// has none. Returns 0 unless the initializer's result is an instance of the same
// generic the parameter names.
fn bindTypeParamFromInit(pc: Checker, pnode: int, ac: Checker, anode: int, tpname: string): int {
  if (anode == 0) {
    return 0
  }
  let an = getNode(ac.tree, anode)
  if (an.tag != Tag.Ident) {
    return 0
  }
  let init = declInitOf(ac, anode)
  if (init == 0) {
    return 0
  }
  let args = callResultTypeArgs(ac, init, typeNodeName(pc, pnode))
  let pta = kidsOf(pc.tree, kidsOf(pc.tree, pnode)[1])
  if (len(pta) != len(args)) {
    return 0 // arity disagreement: bind nothing rather than bind by luck
  }
  let i = 0
  while (i < len(pta)) {
    let b = bindTypeParamFromNode(pc, pta[i], args[i], tpname)
    if (b != 0) {
      return b
    }
    i = i + 1
  }
  return 0
}

// Binds `tpname` from the first call parameter whose type mentions it: a
// type-based structural match (`[]T`, `map<K,V>`, `T!`) or, for a generic-instance
// param (`Pair<T>`) whose arg type carries no type-args, a node-vs-node match.
// Returns 0 if no parameter binds it.
// `pc` declares the generic (its tree holds `params`); `ac` is the caller (its
// tree holds `callNode`). They are the same checker for a local generic.
fn bindTypeParamAtCall(
  pc: Checker,
  ac: Checker,
  callNode: int,
  params: []int,
  tpname: string,
): int {
  let pi = 0
  while (pi < len(params)) {
    let pnode = kidsOf(pc.tree, params[pi])[1]
    let b = bindTypeParamFromNode(
      pc,
      pnode,
      defaultType(ac, checkArgType(ac, callNode, pi)),
      tpname,
    )
    if (b == 0 && getNode(pc.tree, pnode).tag == Tag.GenericInst) {
      b = bindTypeParamNodeVsNode(
        pc,
        pnode,
        ac,
        argTypeNode(ac, callArgNode(ac, callNode, pi)),
        tpname,
      )
      if (b == 0) {
        b = bindTypeParamFromInit(pc, pnode, ac, callArgNode(ac, callNode, pi), tpname)
      }
    }
    if (b != 0) {
      return b
    }
    pi = pi + 1
  }
  return 0
}

// The concrete type arguments a generic call binds, one per type-parameter, in
// declaration order: each type-param is bound structurally from the first
// parameter whose type mentions it. A type-param bound by no parameter (rare)
// resolves to void.
fn genericTypeArgs(c: Checker, name: string, callNode: int): []int {
  let out = []int(0)
  let fr = funcRefAt(c, calleeNodeOf(c, callNode), name)
  let decl = fr.decl
  if (decl == 0) {
    return out
  }
  // The decl's nodes belong to its own module's tree (see FuncRef).
  let oc = fr.owner
  if (isExternDecl(oc.tree, decl)) {
    return out // SPEC 11.7: never generic
  }
  let dk = kidsOf(oc.tree, decl)
  let tps = kidsOf(oc.tree, dk[2])
  let params = kidsOf(oc.tree, dk[3])
  let explicit = explicitCallTypeArgs(c, callNode)
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let bound = 0
    if (ti < len(explicit)) {
      bound = explicit[ti]
    }
    if (bound == 0) {
      bound = bindTypeParamAtCall(oc, c, callNode, params, tpname)
    }
    if (bound == 0) {
      bound = c.ctx.voidId
    }
    out = append(out, bound)
    ti = ti + 1
  }
  return out
}

// Whether two type-arg lists are equal.
fn typeArgsEqual(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The project-wide index of the (defining module, name, args) instantiation, or
// -1 if not recorded. The index IS the monomorphized suffix, so it must be the
// same number for every module that calls this generic with these arguments.
fn instantiationIndexIn(ctx: TypeContext, mod: int, name: string, args: []int): int {
  let i = 0
  while (i < len(ctx.instantiations)) {
    let inst = ctx.instantiations[i]
    if (inst.module == mod && inst.name == name && typeArgsEqual(inst.args, args)) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The index of a resolved generic's (args) instantiation — its identity is
// (declaring module, declared name, args), all three taken from the `FuncRef`
// so a caller and the definer cannot disagree about which generic this is. The
// index IS the monomorphized suffix, so one number must serve every module that
// calls this generic with these arguments.
fn instantiationIndex(c: Checker, fr: FuncRef, args: []int): int {
  return instantiationIndexIn(c.ctx, fr.owner.moduleId, fr.declName, args)
}

// Records a generic-function instantiation the first time its (module, name,
// args) combo is seen, preserving discovery order (the monomorphized index).
// `site` is the calling code's span for THIS call node; only the first call's
// site is kept (#3827), matching the "first time seen" contract above — a
// later call with the same args is a duplicate and does not overwrite it.
fn recordInstantiation(c: Checker, fr: FuncRef, args: []int, site: Span) {
  if (instantiationIndex(c, fr, args) == -1) {
    c.ctx.instantiations = append(
      c.ctx.instantiations,
      Instantiation{ module: fr.owner.moduleId, name: fr.declName, args: args, site: site },
    )
  }
}

fn isUntyped(c: Checker, t: int): bool {
  return t == c.ctx.untypedIntId ||
    t == c.ctx.untypedFloatId ||
    t == c.ctx.untypedRuneId ||
    t == c.ctx.untypedBoolId ||
    t == c.ctx.untypedStringId ||
    t == c.ctx.untypedNilId
}

// The result type of a binary arithmetic/bitwise operator: an untyped operand
// takes the other's concrete type; matching types stay; otherwise the left one.
fn mergeTypes(c: Checker, a: int, b: int): int {
  if (a == b) {
    return a
  }
  if (isUntyped(c, a) && !isUntyped(c, b)) {
    return b
  }
  if (isUntyped(c, b) && !isUntyped(c, a)) {
    return a
  }
  return a
}

fn isComparisonOp(op: int): bool {
  return op == int(Kind.EqEq) ||
    op == int(Kind.BangEq) ||
    op == int(Kind.Lt) ||
    op == int(Kind.Gt) ||
    op == int(Kind.LtEq) ||
    op == int(Kind.GtEq) ||
    op == int(Kind.AmpAmp) ||
    op == int(Kind.PipePipe)
}

// Whether the type node `tnode` names any of `names`. The seeding pass below
// uses it to keep a parameter position whose type still mentions an UNBOUND type
// param out of an arrow's expectation: resolving one anyway hands the arrow a
// bare `T`, and `x * 2` against it is E0053 "operator not defined for 'T' and
// 'untyped int'" — a diagnostic manufactured out of a program that checks today.
fn typeNodeMentionsAny(owner: Checker, tnode: int, names: []string): bool {
  if (tnode == 0 || len(names) == 0) {
    return false
  }
  let n = getNode(owner.tree, tnode)
  if (n.tag == Tag.Ident) {
    let nm = owner.source[n.span.start:n.span.end]
    let i = 0
    while (i < len(names)) {
      if (names[i] == nm) {
        return true
      }
      i = i + 1
    }
    return false
  }
  let kids = kidsOf(owner.tree, tnode)
  let k = 0
  while (k < len(kids)) {
    if (typeNodeMentionsAny(owner, kids[k], names)) {
      return true
    }
    k = k + 1
  }
  return false
}

// Binds `tpname` from the first NON-arrow argument whose parameter type mentions
// it. Deliberately not `bindTypeParamAtCall`: this runs in the seeding pre-pass,
// before an arrow's own parameters have been typed, so reading an arrow argument
// here would type that arrow with the invalid parameter the seeding exists to
// prevent — and SPEC 15.3 makes the arrow the RECEIVER of the inward flow, never
// its source. `bindTypeParamFromInit` is left out for the same reason: it walks
// back through a binding's initializer, which is a call, which types its own
// arguments.
// `pc` declares the generic (its tree holds `params`); `ac` is the caller.
fn bindTypeParamFromValueArgs(
  pc: Checker, ac: Checker, callNode: int,
  params: []int, args: []int, tpname: string,
): int {
  let pi = 0
  while (pi < len(params)) {
    if (getNode(ac.tree, argInner(ac, args[pi])).tag != Tag.ArrowFn) {
      let pnode = kidsOf(pc.tree, params[pi])[1]
      let b = bindTypeParamFromNode(
        pc, pnode,
        defaultType(ac, checkArgType(ac, callNode, pi)), tpname,
      )
      if (b == 0 && getNode(pc.tree, pnode).tag == Tag.GenericInst) {
        b = bindTypeParamNodeVsNode(
          pc, pnode, ac,
          argTypeNode(ac, callArgNode(ac, callNode, pi)), tpname,
        )
      }
      if (b != 0) {
        return b
      }
    }
    pi = pi + 1
  }
  return 0
}

// The type `tnode` denotes under `sub`, or 0 when it still mentions a type param
// nothing bound — recording nothing rather than a guess.
fn substTypeGuarded(owner: Checker, tnode: int, sub: TypeSubst, unbound: []string): int {
  if (tnode == 0 || typeNodeMentionsAny(owner, tnode, unbound)) {
    return 0
  }
  return typeFromNodeIn(owner, tnode, sub)
}

// `mapped([1, 2, 3], x => x * 2)` — a GENERIC callee's parameter type is written
// against its type params, so the arrow's expectation only exists once the other
// arguments have bound them. SPEC 15.3 fixes the order: type params are inferred
// by unifying parameter types with argument types, and an expected type then
// flows inward. `T` binds to i64 from the first argument, the arrow is checked
// against `(i64) => U`, its body types to i64, and `bindTypeParamAtCall` then
// binds `U` structurally from the arrow's OWN function type.
//
// Skipping generics outright is what made `seq.mapped` and `seq.forEach`
// unusable with the bare-parameter arrow their signatures invite (#2040): the
// arrow's parameter stayed at 0, its body typed to nothing, nothing bound `U`,
// `genericTypeArgs` fell through to `()`, and the instantiation `mapped<i64, ()>`
// refused to lower. `(T) => bool` escaped only because a concrete result needs no
// binding at all, and `reduce` because `A` is fixed by `init` before the arrow.
//
// The non-generic path's rule survives one level down: a position still
// mentioning an unbound type param resolves to 0, so the arrow is left inferred
// exactly as before rather than handed a wrong expectation.
fn seedArrowExpectedGeneric(
  c: Checker, callNode: int, owner: Checker,
  decl: int, args: []int,
) {
  let dk = kidsOf(owner.tree, decl)
  let params = kidsOf(owner.tree, dk[3])
  if (len(params) != len(args)) {
    return // variadic, spread, or an arity error: which parameter is undecided
  }
  let tps = kidsOf(owner.tree, dk[2])
  let explicit = explicitCallTypeArgs(c, callNode)
  let names = []string(0)
  let types = []int(0)
  let unbound = []string(0)
  let ti = 0
  while (ti < len(tps)) {
    let tn = getNode(owner.tree, kidsOf(owner.tree, tps[ti])[0])
    let tpname = owner.source[tn.span.start:tn.span.end]
    let bound = 0
    if (ti < len(explicit)) {
      bound = explicit[ti]
    }
    if (bound == 0) {
      bound = bindTypeParamFromValueArgs(owner, c, callNode, params, args, tpname)
    }
    if (bound == 0) {
      unbound = append(unbound, tpname)
    } else {
      names = append(names, tpname)
      types = append(types, bound)
    }
    ti = ti + 1
  }
  let sub = TypeSubst{ names: names, types: types }
  let i = 0
  while (i < len(args)) {
    let a = argInner(c, args[i])
    let ptn = kidsOf(owner.tree, params[i])[1]
    // Same two guards as the non-generic path: the argument must be an arrow and
    // the parameter must be function-typed.
    if (getNode(c.tree, a).tag == Tag.ArrowFn && getNode(owner.tree, ptn).tag == Tag.FuncType) {
      let ptk = kidsOf(owner.tree, ptn) // func_type [type_list, result]
      let plist = kidsOf(owner.tree, ptk[0])
      let members = []int(0)
      let mi = 0
      while (mi < len(plist)) {
        members = append(members, substTypeGuarded(owner, plist[mi], sub, unbound))
        mi = mi + 1
      }
      c.arrowExpected[a] = mkFunc(
        owner.ctx, members, false,
        substTypeGuarded(owner, ptk[1], sub, unbound),
      )
    }
    i = i + 1
  }
}

// The prim-enum index for a predeclared type name, or -1 if not a primitive.
// Includes the size aliases (`int`/`uint`/`byte`/`rune`) that map onto a prim.
fn primIndexByName(name: string): int {
  if (name == "i8") {
    return 0
  }
  if (name == "i16") {
    return 1
  }
  if (name == "i32") {
    return 2
  }
  if (name == "i64") {
    return 3
  }
  if (name == "u8") {
    return 4
  }
  if (name == "u16") {
    return 5
  }
  if (name == "u32") {
    return 6
  }
  if (name == "u64") {
    return 7
  }
  if (name == "f32") {
    return 8
  }
  if (name == "f64") {
    return 9
  }
  if (name == "bool") {
    return 10
  }
  if (name == "string") {
    return 11
  }
  if (name == "int") {
    return 3
  }
  if (name == "uint") {
    return 7
  }
  if (name == "byte") {
    return 4
  }
  if (name == "rune") {
    return 2
  }
  return -1
}

// The default concrete type of an untyped value (spec §15.4): int→i64, float→f64,
// rune→i32, bool→bool, string→string; anything else is unchanged.
fn defaultType(c: Checker, ty: int): int {
  if (ty == c.ctx.untypedIntId) {
    return primType(c.ctx, 3)
  }
  if (ty == c.ctx.untypedFloatId) {
    return primType(c.ctx, 9)
  }
  if (ty == c.ctx.untypedRuneId) {
    return primType(c.ctx, 2)
  }
  if (ty == c.ctx.untypedBoolId) {
    return primType(c.ctx, 10)
  }
  if (ty == c.ctx.untypedStringId) {
    return primType(c.ctx, 11)
  }
  return ty
}

// `defaultType`'s override for a BARE integer literal with no declared type
// (#2487): a value whose magnitude needs the 64th bit — `0xFFFFFFFFFFFFFFFF`,
// `18446744073709551615` — has no representation in ANY signed type, so
// `defaultType`'s blanket "untyped int -> i64" silently handed it a formatter
// that reads bit 63 as the sign (`lowerToString`, #2011) and printed -1.
//
// Checked on `parseIntText`'s OWN result, never re-parsed: a value that needs
// bit 63 wraps to a negative i64 by construction (two's complement), so
// `parseIntText(text) < 0` on a literal that is not itself negated is exactly
// "the 64th bit is set" — the same fact `intTextOverflows` tests for the
// wider-than-64-bits case, one layer down. A literal wider than 64 bits is
// #2488's job (E0084 stops it before this ever runs); this only widens the
// DEFAULT for one that is exactly 64 bits wide.
//
// Deliberately narrower than `defaultType`: only a direct `Tag.IntLit` node
// gets the override, so `let z = -1` (a `Tag.Unary` over a small literal) and
// every compound expression keep i64 as before — a signed literal must never
// become unsigned, and this must not reopen #2358's rule about what merely
// COMPILES. Callers that already have a declared target type (`let x: u64 =
// ...`) never reach `defaultType` for the literal at all (`typeFromNode` on
// the annotation wins), so those are unaffected either way.
fn defaultLitType(c: Checker, node: int, ty: int): int {
  if (ty == c.ctx.untypedIntId && getNode(c.tree, node).tag == Tag.IntLit) {
    let n = getNode(c.tree, node)
    let text = c.source[n.span.start:n.span.end]
    if (parseIntText(text) < 0) {
      return primType(c.ctx, 7) // u64
    }
  }
  return defaultType(c, ty)
}
