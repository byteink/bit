// Self-host Stage 1 (#1335): the parser — a
// recursive-descent parser building the same node tags and child order as the
// seed, so `--dump-ast` is byte-identical over the corpus.
//
// Since #1503 the grammar is spread over siblings, all one module: this file
// holds the `Parser` record, the token cursor (peek/advance/accept/expect), the
// diagnostic and ASI-hint helpers, and the node/span constructors every
// production calls. `parserdecl.bit` holds the top-level declarations,
// `parserstmt.bit` statements and control flow, `parserexpr.bit` the
// precedence-climbing expression grammar, `parsertype.bit` type expressions,
// and `parserasm.bit` the §11.6 `asm` block.
//
// The parser runs over a pre-lexed token array (lexAll), including the lexer's
// ASI semicolons. Only leaf nodes need exact spans (the dump renders their
// source text); interior-node spans are irrelevant to the dump, so they use a
// dummy point span.

class Parser {
  toks: []Token,
  src: string,
  pos: int,
  tree: Tree,
  // Suppresses a `T{...}` composite literal at the top of a `for..of`/`for..in`
  // iterable, where the `{` opens the loop body (§13.1).
  noComposite: bool,
  // Suppresses treating `,` as a statement-level continuation (multi-target
  // assign, multi-value return) while parsing a match arm's direct statement
  // body, so the arm-separating `,` of SPEC §13.8 stops the statement instead
  // of being swallowed into it (#2100). `parseBlock` resets this for a braced
  // arm body, whose own top-level statements are not the arm's direct body.
  noStmtComma: bool,
  // Diagnostic sink + the FileId spans are stamped with (shared with the lexer,
  // so `--dump-diags` renders lex and parse errors together).
  diags: Diagnostics,
  file: int,
  // Journal of the in-place token splits `expectGenericClose` performs, so a
  // speculative attempt can un-split on rollback. The seed checkpoints its
  // LEXER and `reset` restores it wholesale, which undoes a split for free;
  // this port lexes eagerly into `toks` and rewrites the token in place, so
  // every split it made inside a failed attempt must be replayed backwards.
  // Restoring only the outermost `>` (which is all this used to do) leaves a
  // nested `Box<Box<i64>>{` half-split behind after a rewind.
  splits: []Split,
  // Current expression-recursion depth, and whether `maxParseDepth` has been
  // exceeded. See `enterExpr` (#2022).
  depth: int,
  aborted: bool,
}

// The parse error a file nested past `maxParseDepth` gets. In the parser's own
// band (E0021 is the generic "expected X, found Y"); 22 was unused.
const ecNestingTooDeep = 22

// The hard ceiling on expression recursion (#2022, and the Power of 10 rule that
// every loop and recursion carries a statically provable bound).
//
// MEASURED, not guessed, from both directions:
//
//   Legal source. The deepest `--dump-ast` s-expression nesting over all 834
//   `.bit` files in stdlib/, examples/, compiler/, tools/, bench/, _tests_/cases/
//   and _tests_/imports/ is 28 — and that counts declarations, blocks and
//   statements as well as expressions, so it is an over-estimate of what this
//   counter sees. 400 is >14x the deepest thing anyone has actually written.
//
//   The crash. Without a limit, `bit check` on `((((1))))` nested 6000 deep dies
//   of SIGSEGV with no diagnostic (ok at 4000, 139 at 6000, measured on
//   aarch64-macos). 400 is ~15x under that on this host, which is the margin
//   that has to cover the smallest supported stack — the seed release crashed at
//   a different depth again (SIGBUS at 16000), so the exact number is not a
//   property anything should be tuned close to.
const maxParseDepth: int = 400

// Enters one level of expression recursion; the caller MUST return a poison node
// immediately when this returns false, and MUST call `leaveExpr` otherwise.
//
// Exceeding the limit reports ONCE and then jumps the cursor to EOF. Jumping is
// what makes the unwind terminate: every enclosing production's loop already
// stops at EOF (`parseBlock`, `parseFile`, the switch/select arm loops) or at a
// failed separator, so the whole stack pops without any of them re-entering.
// `aborted` then silences `parseFail`, because otherwise each of the ~400
// enclosing `expect(RParen)` calls would report "expected ')', found end of
// file" on the way out and bury the one diagnostic that explains the file.
fn enterExpr(p: Parser): bool {
  p.depth = p.depth + 1
  if (p.depth <= maxParseDepth) {
    return true
  }
  if (!p.aborted) {
    p.aborted = true
    let t = peekTok(p)
    report(p.diags, ecNestingTooDeep, Span{ file: p.file, start: t.start, end: t.end },
      "expression nested more than ${maxParseDepth} levels deep",
      "split the expression with intermediate 'let' bindings")
  }
  p.pos = len(p.toks) - 1
  return false
}

fn leaveExpr(p: Parser) {
  p.depth = p.depth - 1
}

// One `>>`/`>>=`/`>=` token that `expectGenericClose` rewrote in place, with the
// token as it stood before the rewrite.
class Split {
  pos: int,
  tok: Token,
}

// Checkpoint for `undoSplits`. Bounded: one entry per `>` consumed as a generic
// close, so at most one per token in the file.
fn splitMark(p: Parser): int {
  return len(p.splits)
}

// Rolls the token stream's splits back to a `splitMark` checkpoint, newest
// first. Terminating: `i` strictly decreases toward `n`.
fn undoSplits(p: Parser, n: int) {
  let i = len(p.splits) - 1
  while (i >= n) {
    p.toks[p.splits[i].pos] = p.splits[i].tok
    i = i - 1
  }
  p.splits = p.splits[0:n]
}

fn newParser(src: string): Parser {
  let sm = newSourceManager()
  let f = addFile(sm, "", src)
  return newParserD(src, f, newDiagnostics(sm))
}

fn newParserD(src: string, file: int, diags: Diagnostics): Parser {
  return Parser{
    toks: lexAllD(src, file, diags),
    src: src,
    pos: 0,
    tree: newTree(),
    noComposite: false,
    noStmtComma: false,
    diags: diags,
    file: file,
    splits: []Split(0),
    depth: 0,
    aborted: false,
  }
}

// Reports a parse error (E0021) at the current token: "expected <what>, found
// <token>". An `.invalid` current token already carries its lexer diagnostic at
// this span, so no second report is added (matching the seed's `fail`).
fn parseFail(p: Parser, what: string) {
  // Past `maxParseDepth` the cursor sits on EOF and the stack is unwinding, so
  // every enclosing production is about to report what it was left holding. The
  // depth diagnostic is the only one that explains the file (#2022).
  if (p.aborted) {
    return
  }
  let t = peekTok(p)
  if (t.kind == Kind.Invalid) {
    return
  }
  let msg = "expected " + what + ", found " + describeFound(p, t)
  let span = Span{ file: p.file, start: t.start, end: t.end }
  let hint = asiHint(t)
  if (hint == "") {
    reportNoHint(p.diags, 21, span, msg)
    return
  }
  report(p.diags, 21, span, msg, hint)
}

// The "found" half of an E0021 message. `Kind.KwStruct` prints its own source
// spelling (`curText`) rather than `describe`'s `kindName` fallback: #3425
// aliased `class` onto this one Kind, so `kindName` — one fixed string per
// Kind — can no longer say which spelling the user wrote (and #3427 later
// retired `struct` as ITS spelling, so "kw_struct" now names neither
// keyword's current source text). Scoped to this one Kind rather than every
// reserved word: every other keyword still has exactly one spelling, so
// `describe`'s `kindName` fallback for them already matches curText's answer
// and stays untouched — widening this would rename their rendering too and
// redden scripts/selfhost-diffdiags.sh against the pinned stage0 oracle,
// which still renders every keyword by kindName (#3446's own constraint).
fn describeFound(p: Parser, t: Token): string {
  if (t.kind == Kind.KwStruct) {
    return "'" + curText(p) + "'"
  }
  return describe(t.kind)
}

// The hint for a parse error whose unexpected token is a semicolon §7
// SYNTHESIZED rather than one the author wrote.
// `asiHint`. Worth calling out because the source shows no `;` at all, so
// "found ';'" names a token the reader cannot see — the reported symptom behind
// both wrapped `import` (#1412) and a condition broken before its operator
// (#1430). A synthesized semicolon is the one token the lexer emits with a
// zero-width span; a written `;` covers its byte. No grammar changes.
fn asiHint(t: Token): string {
  if (t.kind != Kind.Semicolon || t.start != t.end) {
    return ""
  }
  return "a line break after a value ends the statement (§7); to continue an expression, end the line with the operator instead of starting the next line with it"
}

// A token kind as it reads in a diagnostic ("'{'", "a number", …); falls back
// to the canonical kind name (`kindName`) for keywords and operators.
fn describe(k: Kind): string {
  if (k == Kind.Eof) { return "end of file" }
  if (k == Kind.Invalid) { return "an invalid token" }
  if (k == Kind.Ident) { return "an identifier" }
  if (k == Kind.IntLit || k == Kind.FloatLit) { return "a number" }
  if (k == Kind.StringLit || k == Kind.RawStringLit) { return "a string" }
  if (k == Kind.RuneLit) { return "a rune" }
  if (k == Kind.BoolLit) { return "a boolean literal" }
  if (k == Kind.NilLit) { return "'nil'" }
  if (k == Kind.StrPart || k == Kind.InterpStart || k == Kind.InterpEnd) { return "a string" }
  if (k == Kind.Semicolon) { return "';'" }
  if (k == Kind.LParen) { return "'('" }
  if (k == Kind.RParen) { return "')'" }
  if (k == Kind.LBracket) { return "'['" }
  if (k == Kind.RBracket) { return "']'" }
  if (k == Kind.LBrace) { return "'{'" }
  if (k == Kind.RBrace) { return "'}'" }
  if (k == Kind.Comma) { return "','" }
  if (k == Kind.Colon) { return "':'" }
  if (k == Kind.Dot) { return "'.'" }
  if (k == Kind.Ellipsis) { return "'...'" }
  if (k == Kind.FatArrow) { return "'=>'" }
  if (k == Kind.Question) { return "'?'" }
  if (k == Kind.ArrowLeft) { return "'<-'" }
  if (k == Kind.Eq) { return "'='" }
  if (k == Kind.Lt) { return "'<'" }
  if (k == Kind.Gt) { return "'>'" }
  if (k == Kind.Bang) { return "'!'" }
  if (k == Kind.Amp) { return "'&'" }
  if (k == Kind.Star) { return "'*'" }
  return kindName(k)
}

fn peekTok(p: Parser): Token {
  return p.toks[p.pos]
}

fn peekKind(p: Parser): Kind {
  return p.toks[p.pos].kind
}

// The kind `n` tokens ahead (Eof past the end).
fn peekKindAt(p: Parser, n: int): Kind {
  let j = p.pos + n
  if (j < len(p.toks)) {
    return p.toks[j].kind
  }
  return Kind.Eof
}

// A call/slice-literal item: `...expr` spread or a plain `expr` argument.
fn parseArgItem(p: Parser): int {
  if (acceptTok(p, Kind.Ellipsis)) {
    return mkNode(p, Tag.ArgSpread, 0, [parseExpr(p)])
  }
  return mkNode(p, Tag.Arg, 0, [parseExpr(p)])
}

// A genuine CALL's argument item (SPEC §12.11, #3839): `name = expr` named,
// else whatever `parseArgItem` already accepts. Used ONLY at the two real
// call postfixes (parserexpr.bit's `parsePostfix` and its turbofish
// `f<T>(...)` sibling) — never at the `arguments` list a bare slice literal
// or an array/slice-TYPE conversion call (`[]byte(...)`) shares with a call's
// syntax, since neither has a callee to name a parameter against.
//
// `IDENT "="` is the unambiguous lookahead: assignment is a STATEMENT (SPEC
// §13.2), never an expression, so `=` cannot otherwise follow a bare
// identifier inside an argument list. `==` is a distinct token (Kind.EqEq,
// lexer.bit), so a boolean argument `x == y` is untouched.
fn parseCallArgItem(p: Parser): int {
  if (peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.Eq) {
    let name = leaf(p, Tag.Ident)
    advance(p) // '='
    return mkNode(p, Tag.NamedArg, 0, [name, parseExpr(p)])
  }
  return parseArgItem(p)
}

fn advance(p: Parser) {
  if (p.pos + 1 < len(p.toks)) {
    p.pos = p.pos + 1
  }
}

fn acceptTok(p: Parser, k: Kind): bool {
  if (peekKind(p) == k) {
    advance(p)
    return true
  }
  return false
}

// Consume `k` if present; otherwise report E0021 naming `k` by its glyph
// (`describe`). Recovery is lenient — the token is not consumed on mismatch, so
// the caller continues (matching the seed's non-fatal `expect`).
fn expect(p: Parser, k: Kind) {
  expectMsg(p, k, describe(k))
}

// `expect` with an explicit expected-token phrase, for the sites where the seed
// names a keyword (`'as'`, `'from'`) or a role (`'(' (channel constructor)`)
// rather than the token glyph.
fn expectMsg(p: Parser, k: Kind, what: string) {
  if (peekKind(p) == k) {
    advance(p)
    return
  }
  parseFail(p, what)
}

fn skipSemis(p: Parser) {
  while (peekKind(p) == Kind.Semicolon) {
    advance(p)
  }
}

// The loop condition for every comma-separated list, mirroring the seed's
// `commaList`, which stops at the CLOSE delimiter ONLY — never at EOF. After the
// open delimiter, and again after every separator, it parses one item
// unconditionally. On truncated input that lets the ITEM parser report what it
// was left holding ("expected an identifier", "':'", "a type") instead of the
// caller reporting only the unclosed delimiter. That recovery depth is what the
// fuzz differential gates (#1515); an EOF test here would also swallow the item
// after a trailing separator.
//
// Terminating: every caller breaks out when it fails to consume a separator, so
// each iteration past the first consumes a token — bounded by the token count.
//
// Like the seed's `atClose`, the `>` closing a generic argument list may still be
// glued to what follows as `>>`/`>>=`/`>=`, which `expectGenericClose` splits in
// place, so those count as the close too.
fn atListClose(p: Parser, closeKind: Kind): bool {
  let k = peekKind(p)
  if (k == closeKind) { return true }
  if (closeKind != Kind.Gt) { return false }
  return k == Kind.Shr || k == Kind.ShrEq || k == Kind.GtEq
}

// A leaf node from the current token (with its exact span), then advance.
fn leaf(p: Parser, tag: Tag): int {
  let t = peekTok(p)
  let node = addLeaf(p.tree, tag, Span{ file: p.file, start: t.start, end: t.end })
  advance(p)
  return node
}

// An interior node with a dummy span (the dump ignores interior spans).
// The smallest span covering every kid — what a caret under this construct must
// underline. An interior node has no token of its own (only `leaf` reads one), so
// its extent is exactly its children's, which is the seed's rule too:
// `join(self.span(lhs), self.span(rhs))` for a binary, and the same shape
// elsewhere.
//
// Every interior node used to get `pointSpan(0, 0)`, so a diagnostic on one
// rendered at line 1, column 1 with a caret under the file's first byte —
// `E0053` on `1 + "a"` pointed at `// error`. Nothing caught it: `--dump-ast`
// compares STRUCTURE, not spans, and every consumer until now (dump-types, the
// E0041 sites) happened to read a LEAF's span.
fn spanOfKids(p: Parser, kids: []int): Span {
  let start = -1
  let end = -1
  for k of kids {
    if (k == 0) {
      continue // the `none` poison contributes no text
    }
    let s = getNode(p.tree, k).span
    if (s.start == 0 && s.end == 0) {
      continue // an unspanned kid (empty construct) cannot widen the range
    }
    if (start < 0 || s.start < start) {
      start = s.start
    }
    if (end < 0 || s.end > end) {
      end = s.end
    }
  }
  if (start < 0) {
    return pointSpan(p.file, 0)
  }
  return Span{ file: p.file, start: start, end: end }
}

fn mkNode(p: Parser, tag: Tag, main: int, kids: []int): int {
  return addNode(p.tree, tag, spanOfKids(p, kids), main, kids)
}

// Like mkNode, but with an explicit `[start, end)` span — the seed's
// `join(startTok, endTok)` for nodes bounded by a leading keyword or opening
// delimiter and a trailing `}` that are not children (match/switch/select and
// the braced list bodies). mkNode's kids-only span stops at the last child, so
// it dropped those delimiters; the AST dump never reads interior spans, but
// `bit fmt` does, so the divergence surfaced only there (#1599). parseBlock,
// fail/break/continue and spawn/defer already capture their spans this way.
fn mkSpanNode(p: Parser, tag: Tag, main: int, kids: []int, start: int, end: int): int {
  return addNode(p.tree, tag, Span{ file: p.file, start: start, end: end }, main, kids)
}

// Consumes an identifier or reports "an identifier" and returns the `none`
// poison (index 0) without advancing — the seed's expectIdent. EXCEPT for a
// `Kw*` token (#2248): unlike every other mismatch here, a reserved word can
// never be a valid identifier ANYWHERE, unconditionally, so there is nothing
// ambiguous left for an enclosing production to usefully re-diagnose by
// looking at the same token again. expectIdent names it — source spelling,
// not the generic "found kw_type" a reader cannot map back to source without
// already knowing the answer — and consumes it, the same way `leaf` consumes
// a token it accepts. Every identifier-required site (a class field, a
// parameter, a binding) routes through this one function, so a class field
// named `type` now reports once instead of cascading through every sibling
// production that also wanted the same unconsumed token.
fn expectIdent(p: Parser): int {
  if (peekKind(p) == Kind.Ident) {
    return leaf(p, Tag.Ident)
  }
  if (isReservedKeyword(peekKind(p))) {
    parseFailReservedIdent(p)
    advance(p)
    return 0
  }
  parseFail(p, "an identifier")
  return 0
}

// E0021, naming the reserved word by its source spelling rather than
// `describe`'s `kw_*` fallback, in the same shape as `checkOldFunctionKeyword`'s
// "'function' is not a keyword" report below. Same guards as `parseFail`
// (silenced past `maxParseDepth`; an `.invalid` current token cannot reach here
// since a keyword token is never `Kind.Invalid`). Reports only — `expectIdent`
// does the advancing, since that half is specific to this one call site.
fn parseFailReservedIdent(p: Parser) {
  if (p.aborted) {
    return
  }
  let t = peekTok(p)
  let word = curText(p)
  let span = Span{ file: p.file, start: t.start, end: t.end }
  report(p.diags, 21, span, "'${word}' is a reserved keyword",
    "reserved words cannot be used as identifiers (SPEC §5.2)")
}
