// compiler/lowerflow.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

fn lowerMatchArm(fc: FnCtx, arm: int, preLen: int, join: int, boxed: bool, enumTy: int, subject: int): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumTy, subject)
  // An arm runs only when its variant matched, so a `defer` in it is scheduled
  // only then (#2280).
  let deferBase = deferMark(fc)
  lowerArmBody(fc, ak[1])
  deferScopeEnd(fc, deferBase, ak[1])
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, snapshotValues(fc, preLen))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => body, ... }` statement over an enum to a
// decision tree: each arm but the last tests `tag == <ordinal>` and branches to
// its body or the next test; the last arm is the exhaustive fallthrough. A `join`
// block merges the non-diverging arms (unreachable if every arm diverges). A
// boxed enum's tag is object word 0 and its arms bind the payload.
fn lowerMatch(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fcFail(fc, getNode(fc.c.tree, k[0]).span, "a `match` over a value that is not an enum")
    return
  }
  let boxed = fc.c.ctx.types[subjectTy].enumBoxed
  let subject = lowerExprH(fc, k[0], subjectTy)
  if (fc.failed) {
    return
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return
  }
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = matchTag(fc, subject, subjectTy, boxed)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, subjectTy, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchArm(fc, arm, preLen, join, boxed, subjectTy, subject)) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  // Last arm: the exhaustive fallthrough, lowered in the current block with no
  // test.
  fc.terminated = false
  if (lowerMatchArm(fc, arms[len(arms) - 1], preLen, join, boxed, subjectTy, subject)) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Lowers one match-expression arm: its body is an *expression* whose value is
// carried to the join as the trailing block param. Returns whether the join is
// reached.
fn lowerMatchExprArm(fc: FnCtx, arm: int, preLen: int, join: int, resultTy: int, isVoid: bool, boxed: bool, enumTy: int, subject: int): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumTy, subject)
  let val = 0
  if (isVoid) {
    lowerExpr(fc, ak[1])
  } else {
    val = lowerExprH(fc, ak[1], resultTy)
  }
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, catchEdgeArgs(fc, snapshotValues(fc, preLen), val, isVoid))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => expr, ... }` in expression position over a
// C-like enum: like the statement form, but each arm yields a value merged at the
// The result type of a generic-enum match expression: the first arm's body type
// with its payload binders substituted to the scrutinee's concrete type-args, so
// `match(o: Opt<i64>){ Some(v)=>v ... }` yields i64, not the bare type-param.
fn matchExprResultTy(fc: FnCtx, node: int, enumTy: int): int {
  let k = kidsOf(fc.c.tree, node)
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return fc.c.ctx.voidId
  }
  let ak = kidsOf(fc.c.tree, arms[0])
  let vp = kidsOf(fc.c.tree, ak[0])
  if (vp[1] != 0) {
    let vn = getNode(fc.c.tree, vp[0])
    let ptypes = variantPayloadTypes(fc.c, enumTy, fc.c.source[vn.span.start:vn.span.end])
    let binders = kidsOf(fc.c.tree, vp[1])
    let i = 0
    while (i < len(binders)) {
      let bt = primType(fc.c.ctx, 3)
      if (i < len(ptypes)) {
        bt = ptypes[i]
      }
      rebindCheckerName(fc, binders[i], bt)
      i = i + 1
    }
  }
  return defaultType(fc.c, nodeType(fc, ak[1]))
}

// join's trailing param — the whole match's value. ponytail: boxed enums deferred.
fn lowerMatchExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let resultTy = defaultType(fc.c, nodeType(fc, node))
  let subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fcFail(fc, getNode(fc.c.tree, k[0]).span, "a `match` over a value that is not an enum")
    return 0
  }
  let boxed = fc.c.ctx.types[subjectTy].enumBoxed
  let subject = lowerExprH(fc, k[0], subjectTy)
  if (fc.failed) {
    return 0
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a `match` expression with no arms")
    return 0
  }
  // A generic-enum match's arms yield the substituted payload type, which the
  // whole-match type inference (over the bare type-param) misses — derive the
  // result from the first arm's body with its payload binders substituted.
  if (boxed && (resultTy == 0 || fc.c.ctx.types[resultTy].kind == TypeKind.TypeParam)) {
    resultTy = matchExprResultTy(fc, node, subjectTy)
  }
  let isVoid = resultTy == fc.c.ctx.voidId
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = matchTag(fc, subject, subjectTy, boxed)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, subjectTy, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchExprArm(fc, arm, preLen, join, resultTy, isVoid, boxed, subjectTy, subject)) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  fc.terminated = false
  if (lowerMatchExprArm(fc, arms[len(arms) - 1], preLen, join, resultTy, isVoid, boxed, subjectTy, subject)) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (!joinReachable) {
    let phTy = resultTy
    if (isVoid) {
      phTy = primType(fc.c.ctx, 3)
    }
    let ph = zeroValue(fc, phTy, getNode(fc.c.tree, node).span)
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
    return ph
  }
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    let z = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
    return builderEmit(fc.b, z)
  }
  return builderAddParam(fc.b, resultTy)
}

// Drops env locals beyond `n` (a scope exit), keeping the first `n`.
fn truncateEnv(fc: FnCtx, n: int) {
  fc.env = fc.env[0:n]
}

// The `fc.defers` length to hand `deferScopeEnd` after lowering a conditional
// region's body.
fn deferMark(fc: FnCtx): int {
  return len(fc.defers)
}

// Closes a conditional region (an if/else branch, a loop body, a switch/select
// clause, a match arm, a bind-catch block) that may have registered defers.
//
// `fc.defers` is a LOWERING-time list: `lowerDefer` appends in TEXTUAL order and
// `runDefers` replays the whole list at every exit. That models §18.5 only while
// every statement between a `defer` and the exit is unconditional. A `defer`
// inside a branch the run did not take is still in the list at a later exit, so
// it ran anyway — taking the second of two guarded branches ran TWO deferred
// calls, and one `lock()` with two replayed `unlock()`s hangs. Worse, where the
// skipped branch never evaluated the call's arguments, the replayed call reads
// SSA values defined in a block that does not dominate that exit: a garbage
// receiver, i.e. a SIGSEGV leaving a function that scheduled nothing (#2280).
//
// So the region owns what it registered. Two ways out:
//
//   - the region cannot be left except by `return`/`fail`, which already
//     replayed them (`terminated`, and no `break`/`continue` escaping it): drop
//     them, since no later exit is reachable from here. This is the shape the
//     bug is really about — a guarded `lock(); defer unlock(); return`.
//   - otherwise control leaves the region and reaches a later exit, which must
//     replay them only IF the region ran. That needs a per-defer runtime flag
//     in a slot live from function entry, which nothing in the lowerer allocates
//     yet: refuse to lower rather than emit a call the program never scheduled.
fn deferScopeEnd(fc: FnCtx, mark: int, region: int) {
  if (len(fc.defers) <= mark) {
    return
  }
  if (fc.terminated && !deferJumpEscapes(fc, region, 0, false, false)) {
    fc.defers = fc.defers[0:mark]
    return
  }
  fcFail(fc, getNode(fc.c.tree, region).span, "a `defer` inside a block only some paths through it would run")
}

// Does a `break`/`continue` inside `node` leave the region rooted at `node`?
// A nested loop absorbs both; a `switch`/`select` is a break target but not a
// continue target (`lowerStmt` skips `isSwitch` frames for `continue`), so it
// absorbs only `break`; a `match` absorbs neither (#1531). A nested function
// body carries its own control flow and its own defer list.
//
// Depth-capped like `vContainsOwnBreak`, and the cap answers "it escapes":
// over-reporting costs a refused lowering, under-reporting silently drops a
// deferred call.
fn deferJumpEscapes(fc: FnCtx, node: int, depth: int, inLoop: bool, inSwitch: bool): bool {
  if (node == 0) {
    return false
  }
  if (depth >= 256) {
    return true
  }
  let t = getNode(fc.c.tree, node).tag
  if (t == Tag.BreakStmt) {
    return !inSwitch
  }
  if (t == Tag.ContinueStmt) {
    return !inLoop
  }
  if (t == Tag.FuncDecl || t == Tag.ArrowFn) {
    return false
  }
  let nowLoop = inLoop
  let nowSwitch = inSwitch
  if (vIsLoop(t)) {
    nowLoop = true
    nowSwitch = true
  } else if (t == Tag.SwitchStmt || t == Tag.SelectStmt) {
    nowSwitch = true
  }
  for k of kidsOf(fc.c.tree, node) {
    if (deferJumpEscapes(fc, k, depth + 1, nowLoop, nowSwitch)) {
      return true
    }
  }
  return false
}

// The env index of a local (most recent binding), or -1 if unbound.
fn envIndex(fc: FnCtx, name: string): int {
  let i = len(fc.env) - 1
  while (i >= 0) {
    if (fc.env[i].name == name) {
      return i
    }
    i = i - 1
  }
  return -1
}

// The base binary operator of a compound-assignment kind (`+=` -> `+`), or -1.
fn compoundBase(op: int): int {
  if (op == int(Kind.PlusEq)) { return int(Kind.Plus) }
  if (op == int(Kind.MinusEq)) { return int(Kind.Minus) }
  if (op == int(Kind.StarEq)) { return int(Kind.Star) }
  if (op == int(Kind.SlashEq)) { return int(Kind.Slash) }
  if (op == int(Kind.PercentEq)) { return int(Kind.Percent) }
  if (op == int(Kind.AmpEq)) { return int(Kind.Amp) }
  if (op == int(Kind.PipeEq)) { return int(Kind.Pipe) }
  if (op == int(Kind.CaretEq)) { return int(Kind.Caret) }
  if (op == int(Kind.ShlEq)) { return int(Kind.Shl) }
  if (op == int(Kind.ShrEq)) { return int(Kind.Shr) }
  return -1
}

// The IR op for a base arithmetic operator over a value of type `ty`.
fn arithOpFor(fc: FnCtx, base: int, ty: int): Op {
  let td = fc.c.ctx.types[ty]
  let isFloat = td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)
  let signed = !(td.kind == TypeKind.Prim && td.prim >= 4 && td.prim <= 7)
  return binOpFor(base, isFloat, signed)
}

// Lowers `s.f = v` to `field_set %s[offset] = %v` at the field's byte offset.
// ponytail: inline-array fields (copy semantics) deferred.
fn lowerFieldStore(fc: FnCtx, lhs: int, rhs: int) {
  let lhsSpan = getNode(fc.c.tree, lhs).span
  let mk = kidsOf(fc.c.tree, lhs)
  let recvTy = nodeType(fc, mk[0])
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fcFail(fc, lhsSpan, "a field assignment whose receiver is not a struct")
    return
  }
  let decl = structDeclOf(fc.c, recvTy)
  if (decl == 0) {
    fcFail(fc, lhsSpan, "a field assignment on a struct with no declaration in scope")
    return
  }
  let oc = typeOwner(fc.c, recvTy)
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(fc.c.tree, mk[1])
  let fidx = fieldIndexByName(oc, fields, fc.c.source[mn.span.start:mn.span.end])
  if (fidx == -1) {
    fcFail(fc, lhsSpan, "assignment to an unknown struct field")
    return
  }
  let fty = typeFromNode(oc, kidsOf(oc.tree, fields[fidx])[1])
  if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
    fcFail(fc, lhsSpan, "assignment to an inline-array struct field")
    return
  }
  let recv = lowerExpr(fc, mk[0])
  let v = lowerExprH(fc, rhs, fty)
  if (fc.failed) {
    return
  }
  let ins = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  ins.lhs = recv
  // Substituted for the same reason as the matching `field_get` in
  // `lowerFieldAccess`, and it must stay in step with it: a store to a wrong
  // offset corrupts the adjacent field rather than merely reading it (#1565).
  ins.ival = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, recvTy)).offsets[fidx]
  ins.rhs = v
  builderEmit(fc.b, ins)
}

// `*p = x` (§11.4): store one word at the pointed-at address. Reuses FieldSet at
// offset 0 — the pointer is the base, the rhs is stored at the pointee type.
fn lowerPtrStore(fc: FnCtx, lhs: int, rhs: int) {
  let opNode = kidsOf(fc.c.tree, lhs)[0]
  let elemTy = defaultType(fc.c, nodeType(fc, lhs))
  let p = lowerExpr(fc, opNode)
  let v = lowerExprH(fc, rhs, elemTy)
  if (fc.failed) {
    return
  }
  let ins = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  ins.lhs = p
  ins.ival = 0
  ins.rhs = v
  builderEmit(fc.b, ins)
}

// Lowers `a[i] = v`: a slice via `rt_call slice_set`, a map via `map_set`, a
// fixed array via the `index_set` op.
//
// The fixed-array arm is a TESTED arm, not a fallthrough (#2403) — the third and
// last copy of the shape #2385 removed from `lowerIndex` and #2390 from
// `resolveLvalue`. `index_set` is raw word addressing, `base + i*width`, over an
// inline block, so emitting it against a receiver that is not an inline block
// STORES THROUGH whatever the receiver actually holds. Measured under the released
// 0.1.8 and on this tree before the guard: `xs[0] = 9` on a bare `T` bound to an
// int or a bool built clean and died on SIGSEGV, on a struct it silently
// overwrote field `a` with 42 and exited 0, and `s[0] = 'z'` wrote over an
// immutable string's object. A string has no arm here on purpose — it is
// immutable, so the store must be refused rather than lowered. The checker is the
// layer that owes a diagnostic (#2391); while it has a gap the lowerer must not
// paper over it with a wrong answer.
fn lowerIndexStore(fc: FnCtx, lhs: int, rhs: int) {
  let k = kidsOf(fc.c.tree, lhs)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  let elemTy = defaultType(fc.c, nodeType(fc, lhs))
  let v = lowerExprH(fc, rhs, elemTy)
  if (fc.failed) {
    return
  }
  if (rd.kind == TypeKind.Slice) {
    // `recv`, `idx` and `v` are all lowered above, so the inline sequence's
    // safepoint-free window (see `emitInlineSliceElem`) opens after the last
    // thing that could allocate.
    if (canInlineSliceStore(fc, elemTy, idx, v)) {
      emitInlineSliceSet(fc, recv, idx, v, elemTy)
      return
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "slice_set"
    ins.args = [recv, idx, v]
    emitRtCall(fc, ins)
    return
  }
  if (rd.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [recv, idx, v]
    emitRtCall(fc, ins)
    return
  }
  if (rd.kind != TypeKind.Array) {
    fcFail(fc, getNode(fc.c.tree, lhs).span, "an indexed assignment to a value that is not a slice, array or map (e.g. a string, which is immutable)")
    return
  }
  let ins = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
  ins.lhs = recv
  ins.rhs = idx
  ins.ival = v
  builderEmit(fc.b, ins)
}

fn lowerAssign(fc: FnCtx, node: int) {
  let opKind = getNode(fc.c.tree, node).main
  let k = kidsOf(fc.c.tree, node)
  let lhsItems = kidsOf(fc.c.tree, k[0])
  let rhsItems = kidsOf(fc.c.tree, k[1])
  // A two-result comma-ok assign to existing locals, either bare `v, ok = m[k]`
  // (two lhs items) or parenthesized `(v, ok) = m[k]` (one tuple_pat item).
  if (opKind == int(Kind.Eq) && len(rhsItems) == 1) {
    let targets = []int(0)
    if (len(lhsItems) == 2) {
      targets = lhsItems
    } else if (len(lhsItems) == 1 && getNode(fc.c.tree, lhsItems[0]).tag == Tag.TuplePat) {
      targets = kidsOf(fc.c.tree, lhsItems[0])
    }
    if (len(targets) == 2) {
      let two = lowerTwoResult(fc, rhsItems[0])
      if (fc.failed) {
        return
      }
      if (len(two) == 2) {
        let t = 0
        while (t < 2) {
          assignEnvSlot(fc, targets[t], two[t])
          if (fc.failed) {
            return
          }
          t = t + 1
        }
        return
      }
    }
    // `a, b = f()` / `(a, b) = f()` where `f` returns a tuple (SPEC §13.1): one
    // value spread positionally over the targets.
    if (len(targets) > 1) {
      let tupTy = nodeType(fc, rhsItems[0])
      if (tupTy != 0 && fc.c.ctx.types[tupTy].kind == TypeKind.Tuple &&
          len(fc.c.ctx.types[tupTy].members) == len(targets)) {
        let val = lowerExpr(fc, rhsItems[0])
        if (fc.failed) {
          return
        }
        let ti = 0
        while (ti < len(targets)) {
          assignEnvSlot(fc, targets[ti], tupleElem(fc, tupTy, val, ti))
          if (fc.failed) {
            return
          }
          ti = ti + 1
        }
        return
      }
      fcFail(fc, getNode(fc.c.tree, rhsItems[0]).span, "a multi-target assignment whose right side is not a matching tuple")
      return
    }
  }
  if (len(lhsItems) != 1 || len(rhsItems) != 1) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a multi-target assignment this lowerer does not yet handle")
    return
  }
  let ln = getNode(fc.c.tree, lhsItems[0])
  // A plain assignment to a struct field or a collection element.
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Member) {
    lowerFieldStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Index) {
    lowerIndexStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  // `*p = x` (§11.4): store one word at the pointed-at address.
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Unary && ln.main == int(Kind.Star)) {
    lowerPtrStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  // Compound-assign (`+= -= *= /= %= &= |= ^= <<= >>=`, SPEC §13.1): resolve
  // the target once, read-modify-write it. Covers every lvalue shape — local,
  // module global, struct field, slice/array index, map entry.
  if (opKind != int(Kind.Eq)) {
    let base = compoundBase(opKind)
    if (base == -1) {
      fcFail(fc, getNode(fc.c.tree, node).span, "an unrecognized compound-assignment operator")
      return
    }
    let lv = resolveLvalue(fc, lhsItems[0])
    if (fc.failed) {
      return
    }
    let cur = readLvalue(fc, lv, getNode(fc.c.tree, lhsItems[0]).span)
    let ty = nodeType(fc, lhsItems[0])
    let rhs = lowerExprH(fc, rhsItems[0], ty)
    if (fc.failed) {
      return
    }
    let op = arithOpFor(fc, base, ty)
    if (op == Op.BlockParam) {
      fcFail(fc, getNode(fc.c.tree, lhsItems[0]).span, "an unsupported compound-assignment operator for this operand type")
      return
    }
    let ins = mkInstr(op, ty)
    ins.lhs = cur
    ins.rhs = rhs
    writeLvalue(fc, lv, builderEmit(fc.b, ins))
    return
  }
  if (ln.tag != Tag.Ident) {
    fcFail(fc, ln.span, "an assignment target that is not a name, field, index or pointer dereference")
    return
  }
  let lname = fc.c.source[ln.span.start:ln.span.end]
  let idx = envIndex(fc, lname)
  if (idx == -1) {
    // Not a local: a module-level `let` (§11.11). Its cell is written through
    // the ordinary FieldSet at offset 0, the same lvalue shape `*p = x` uses.
    let wsym = moduleGlobalSym(fc, lname)
    if (wsym == "") {
      fcFail(fc, ln.span, "an assignment target that is neither a local nor a module-level variable")
      return
    }
    // The lvalue's address is materialized BEFORE the right-hand side, which
    // is the seed's resolveLvalue-then-lowerExpr order; matching it keeps the
    // two compilers' IR byte-identical.
    let waddr = emitGlobalAddrVal(fc, wsym)
    let wty = nodeType(fc, lhsItems[0])
    let wv = lowerExprH(fc, rhsItems[0], wty)
    if (fc.failed) {
      return
    }
    let st = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    st.lhs = waddr
    st.ival = 0
    st.rhs = wv
    builderEmit(fc.b, st)
    return
  }
  let ty = fc.env[idx].ty
  let rhsTy = defaultType(fc.c, nodeType(fc, rhsItems[0]))
  let v = lowerExprH(fc, rhsItems[0], ty)
  if (fc.failed) {
    return
  }
  // A concrete value assigned into an interface-typed local is relabelled.
  localWrite(fc, idx, coerceToIface(fc, v, rhsTy, ty))
}

fn lowerIncDec(fc: FnCtx, node: int, base: int) {
  let lhs = kidsOf(fc.c.tree, node)[0]
  let lv = resolveLvalue(fc, lhs)
  if (fc.failed) {
    return
  }
  let ty = nodeType(fc, lhs)
  // The checker rejects a non-numeric operand before this ever runs
  // (validatestmt.bit's vIncDec, #2556) — but `arithOpFor` below assumes a
  // numeric type and otherwise builds a nonsensical instruction rather than
  // refusing, so a checker gap it has not yet closed must still not reach
  // codegen: refuse here too instead of silently discarding the statement.
  if (!isNumericPrim(fc, ty)) {
    fcFail(fc, getNode(fc.c.tree, node).span, "`++`/`--` on a non-numeric operand")
    return
  }
  let cur = readLvalue(fc, lv, getNode(fc.c.tree, lhs).span)
  let op = arithOpFor(fc, base, ty)
  if (op == Op.BlockParam) {
    fcFail(fc, getNode(fc.c.tree, node).span, "`++`/`--` with an unsupported operand type")
    return
  }
  let oneV = oneConst(fc, ty)
  let ins = mkInstr(op, ty)
  ins.lhs = cur
  ins.rhs = oneV
  writeLvalue(fc, lv, builderEmit(fc.b, ins))
}

// Lowers a `while (cond) body`: jump to a header block (loop-carried live locals
// as block params), test the condition, branch into the body or out to the
// exit; the body back-jumps to the header. break/continue target exit/header via
// the loop stack. Mirrors the seed's lowerWhile. Exit block left open.
fn lowerWhile(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let preLen = len(fc.env)
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  // Entry edge into the header.
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: loop-carried params, then the condition + branch.
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  let cond = lowerExpr(fc, k[0])
  if (fc.failed) {
    return
  }
  let condAlways = isConstTrue(fc.b, cond)
  // The body is dominated by the header (single predecessor), so it takes no
  // params; only the exit is a real merge (this edge + every break).
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = exitBlk
  br.elseArgs = snapshotValues(fc, preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  // Body.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: header, preLen: preLen, isSwitch: false, exitUsed: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  let deferBase = deferMark(fc)
  lowerStmtList(fc, k[1])
  deferScopeEnd(fc, deferBase, k[1])
  if (!fc.terminated) {
    emitJump(fc, header, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  let exitUsed = fc.loops[len(fc.loops) - 1].exitUsed
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  truncateEnv(fc, preLen)
  // Exit: merges the false-branch and every break. The false edge carries args
  // whether or not it can be taken, so the exit always takes its params.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  // A statically-true condition never takes that false edge, so with no `break`
  // reaching the exit nothing does, and the loop diverges — the same conclusion
  // the validator's `diverges` reaches for `while (true)` with no own break.
  // Recording it keeps `terminated` in step with that analysis; where the two
  // disagreed, `lowerCatch` had to refuse the whole function (#1519, #1548).
  if (condAlways && !exitUsed) {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  } else {
    fc.terminated = false
  }
}

// Lowers a bare `for { }`, the unconditional loop: the same shape as lowerWhile
// minus the condition and its branch — a header carrying the live locals as
// block params, the body back-jumping to it, and an exit only `break` reaches.
// Mirrors the seed's lowerForInf. Exit block left open.
fn lowerForInf(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let preLen = len(fc.env)
  let header = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  // Entry edge into the header.
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: loop-carried params, then the body itself — with no condition to
  // test there is nothing to branch on, so the body needs no block of its own.
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: header, preLen: preLen, isSwitch: false, exitUsed: false })
  fc.terminated = false
  let deferBase = deferMark(fc)
  lowerStmtList(fc, k[0])
  deferScopeEnd(fc, deferBase, k[0])
  if (!fc.terminated) {
    emitJump(fc, header, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  let exitUsed = fc.loops[len(fc.loops) - 1].exitUsed
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  truncateEnv(fc, preLen)
  // `for { }` has no exit edge of its own, so `break` is the only way out. With
  // none the loop diverges — the same conclusion the validator's `for_inf` rule
  // reaches — and the exit has no predecessor at all, so unlike lowerWhile's it
  // takes no params (the lowerSwitch/lowerMatch idiom). Keeping `terminated` in
  // step with the validator is what stops lowerCatch refusing the whole
  // function where the two disagree (#1519, #1548).
  builderBeginBlock(fc.b, exitBlk)
  if (exitUsed) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}
