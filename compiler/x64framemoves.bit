// Parallel moves and argument passing for the x86-64 backend — moved verbatim
// out of `x64frame.bit` (#4322), which was 795 lines against the hard
// 800-line E0200 ceiling.
//
// Two sections: the cycle-breaking parallel-move sequencer that feeds every
// call and block-param edge, and the SysV/Win64 argument-position rules with
// the stack-argument store that follows them. The emitter context, the frame
// layout and the per-function register file stay in `x64frame.bit`; read its
// header first.
//
// Split out of compiler/x64.bit originally, so this is the same module and
// nothing here is imported — a duplicate import is E0042.
// ---------------------------------------------------------------------------
// Parallel moves
// ---------------------------------------------------------------------------
//
// PLoc/PMove/plocEq/swapRemoveMove are architecture-neutral and already defined
// by the arm64 backend; only the emitters below differ. A spill location is an
// rbp-relative offset here, exactly as it is x29-relative there.

// Emits one move. A mem->mem move has no single-instruction form, so it routes
// through the PRIMARY scratch — which is why a move CYCLE must rotate through
// the SECONDARY scratch instead (see xSequentializeAndEmit).
fn xEmitMove(cx: XCtx, src: PLoc, dst: PLoc) {
  // A value never changes class in transit; the two ends of one move always
  // agree, so either one names which emitter runs.
  assert(src.regClass == dst.regClass)
  if (src.regClass == RegClass.Int) {
    if (src.isReg && dst.isReg) {
      xMovRR(cx.buf, xRegOf(dst.v), xRegOf(src.v))
      return
    }
    if (src.isReg) {
      xMovStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xRegOf(src.v), 8)
      return
    }
    if (dst.isReg) {
      xMovLoad(cx.buf, xRegOf(dst.v), xMemB(XReg64.Rbp, src.v), 8, false)
      return
    }
    xMovLoad(cx.buf, xScratch1(), xMemB(XReg64.Rbp, src.v), 8, false)
    xMovStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xScratch1(), 8)
    return
  }
  if (src.isReg && dst.isReg) {
    xMovFRR(cx.buf, xXmmOf(dst.v), xXmmOf(src.v), 8)
    return
  }
  if (src.isReg) {
    xMovFStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xXmmOf(src.v), 8)
    return
  }
  if (dst.isReg) {
    xMovFLoad(cx.buf, xXmmOf(dst.v), xMemB(XReg64.Rbp, src.v), 8)
    return
  }
  xMovFLoad(cx.buf, xFScratch1(), xMemB(XReg64.Rbp, src.v), 8)
  xMovFStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xFScratch1(), 8)
}

// Emits `movesIn` so every destination receives the value it would under
// true-parallel semantics, even when sources and destinations alias (register
// swaps and rotations). Two phases: drain everything nothing else reads, then
// break the remaining closed cycles through a scratch.
//
// One parallel move covering every class at once (#3182): `movesIn` may freely
// mix Int and Float PMoves — splitting a block edge's move by class into two
// independent calls is what let an int destination and a float source alias
// through a shared spill-slot number in the first place (#3168). `class` lives
// on each PLoc now, and a same-address spill collision between the two classes
// (should #3168's partitioning ever be lost) is now visible to `anyReads` too —
// plocEq (#3191) compares register PLocs by (v, class) but spill PLocs by
// address (v) alone, since a spill's `v` is already the byte offset and two
// classes at the same offset really are the same location. xEmitMove/the
// scratch below still read the class off the moves themselves rather than a
// single caller-supplied class for the batch.
fn xSequentializeAndEmit(cx: XCtx, movesIn: []PMove) {
  let moves = []PMove(0)
  let k = 0
  while (k < len(movesIn)) {
    if (!plocEq(movesIn[k].src, movesIn[k].dst)) {
      moves = append(moves, movesIn[k])
    }
    k = k + 1
  }

  // Phase 1: emit every move whose destination no other pending move still
  // reads. Each pass either emits one or stops, so this is bounded.
  let changed = true
  while (changed) {
    changed = false
    let i = 0
    while (i < len(moves)) {
      if (anyReads(moves, i, moves[i].dst)) {
        i = i + 1
      } else {
        xEmitMove(cx, moves[i].src, moves[i].dst)
        moves = swapRemoveMove(moves, i)
        changed = true
      }
    }
  }

  // Phase 2: whatever remains forms closed cycles. Walk one backwards from an
  // arbitrary destination (each location is written exactly once, so the
  // predecessor is unique) and rotate it through a scratch register.
  while (len(moves) > 0) {
    let cycle = []PMove(0)
    let start = moves[0].dst
    let cur = start
    let guard = 0
    while (guard <= len(movesIn)) {
      let found = -1
      let j = 0
      while (j < len(moves)) {
        if (plocEq(moves[j].dst, cur)) {
          found = j
          j = len(moves)
        } else {
          j = j + 1
        }
      }
      assert(found >= 0) // invariant: what is left forms closed cycles
      let mv = moves[found]
      cycle = append(cycle, mv)
      moves = swapRemoveMove(moves, found)
      cur = mv.src
      if (plocEq(cur, start)) {
        guard = len(movesIn) + 1
      } else {
        guard = guard + 1
      }
    }

    // The cycle scratch holds one location's value across the WHOLE rotation,
    // so it must be a register xEmitMove never uses as its own temporary. A
    // mem->mem step inside the cycle routes through the PRIMARY scratch, so the
    // cycle must use the SECONDARY one — otherwise the first mem->mem step
    // overwrites the saved value and the cycle resolves to garbage. That is
    // #1235: a spilled loop-carried value swapped on a back-edge, silently
    // corrupted.
    // Every link in a cycle shares one class in practice: `plocEq` (#3191)
    // only requires it for registers, but #3168's partitioning means no two
    // different classes' spills ever share an address either, so a spill
    // chase can never actually cross classes. `start`'s class names the
    // whole cycle; a same-address collision that DID cross classes here
    // would trip xEmitMove's own src.class==dst.class assert on the closing
    // scratch move rather than silently mis-restoring, since scratch is
    // fixed to `start`'s class for the whole rotation.
    let scratch = plocReg(xRegNum(xScratch2()), RegClass.Int)
    if (start.regClass == RegClass.Float) {
      scratch = plocReg(xmmNum(xFScratch2()), RegClass.Float)
    }
    xEmitMove(cx, cycle[0].dst, scratch) // save what is about to be overwritten
    let i = 0
    while (i + 1 < len(cycle)) {
      xEmitMove(cx, cycle[i].src, cycle[i].dst)
      i = i + 1
    }
    xEmitMove(cx, scratch, cycle[len(cycle) - 1].dst)
  }
}

// ---------------------------------------------------------------------------
// Argument marshalling
// ---------------------------------------------------------------------------

// The register argument `position` lands in, or -1 when it goes on the stack.
// `classOrdinal` counts only arguments of the same class seen so far.
//
// This is where the two ABIs genuinely diverge, and the difference is silent:
//   - SysV counts the integer and float banks INDEPENDENTLY, so f(int, float,
//     int) passes rdi, xmm0, rsi.
//   - Win64 indexes by POSITION, the banks SHARING slots, so the same call
//     passes rcx, xmm1, r8 — a float at position 1 consumes the slot rcx would
//     otherwise take.
// Using one rule under the other convention reads every argument after the
// first float from the wrong register.
fn xArgReg(cc: XCallConv, regClass: RegClass, position: int, classOrdinal: int): int {
  let ord = classOrdinal
  if (cc == XCallConv.Win64) {
    ord = position
  }
  if (regClass == RegClass.Int) {
    let regs = xIntArgRegs(cc)
    if (ord < len(regs)) {
      return xRegNum(regs[ord])
    }
    return -1
  }
  // Floats go in xmm0.. in both conventions; only the count differs (SysV
  // takes eight, Win64 four).
  let maxF = 8
  if (cc == XCallConv.Win64) {
    maxF = 4
  }
  if (ord < maxF) {
    return ord
  }
  return -1
}

// One argument that did not fit in a register and must be stored to the
// outgoing stack area.
class XStackArg {
  src: PLoc,
  regClass: RegClass,
  offset: int,
}

// Stores one overflow argument into the outgoing area at rsp+offset.
fn xEmitStackArgStore(cx: XCtx, sa: XStackArg) {
  if (sa.regClass == RegClass.Int) {
    let r = xScratch1()
    if (sa.src.isReg) {
      r = xRegOf(sa.src.v)
    } else {
      xMovLoad(cx.buf, r, xMemB(XReg64.Rbp, sa.src.v), 8, false)
    }
    xMovStore(cx.buf, xMemB(XReg64.Rsp, sa.offset), r, 8)
    return
  }
  let f = xFScratch1()
  if (sa.src.isReg) {
    f = xXmmOf(sa.src.v)
  } else {
    xMovFLoad(cx.buf, f, xMemB(XReg64.Rbp, sa.src.v), 8)
  }
  xMovFStore(cx.buf, xMemB(XReg64.Rsp, sa.offset), f, 8)
}

// The outgoing stack area a call needs for `stackCount` overflow arguments,
// rounded up to keep rsp 16-aligned at the call.
fn xStackReserve(stackCount: int): int {
  let raw = 8 * stackCount
  if (raw % 16 == 0) {
    return raw
  }
  return raw + (16 - raw % 16)
}

// Win64 requires 32 bytes of "shadow space" below the return address that the
// CALLER reserves and the callee may freely use to spill its four register
// arguments. Omitting it lets the callee scribble over the caller's own frame.
fn xShadowSpace(cc: XCallConv): int {
  if (cc == XCallConv.Win64) {
    return 32
  }
  return 0
}
