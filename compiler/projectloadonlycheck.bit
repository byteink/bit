// #5358: `loadModuleAt`'s `only != ""` memo bypass, split out of
// projectcheck.bit (same module, sibling `.bit` file) to keep it under
// spec/LINT.md's 800-line ceiling rather than growing that file further.
//
// `loadProjectCached` loads the prelude (the whole `std/core` directory,
// `only == ""`) before the root. `pathResolve` is lexical — it never
// absolutises — so when `stdRoot` is spelled such that
// `pathJoinResolve(stdRoot, "core")` is the SAME STRING as the root
// directory, the root's `only != ""` load must not be satisfied by (nor
// overwrite) the prelude's whole-directory memo entry keyed on that same
// canonical string: it must still return a module built from exactly the
// one named file, not the prelude's two.

fn checkProjectLoadModuleOnlySkipsMemo() {
  let root = pmCheckScratchDir()
  let stdRoot = root + "/std"
  let coreDir = stdRoot + "/core"
  pmCheckMkdirAll(coreDir)
  // Two files, so a wrongly-shared memo entry would hand the root load a
  // two-file module instead of the one it asked for.
  writeFile(coreDir + "/a.bit", "fn a() {}\n") catch e {
    panic("projectloadonlycheck: cannot write a.bit: " + e.message())
  }
  writeFile(coreDir + "/b.bit", "fn b() {}\n") catch e {
    panic("projectloadonlycheck: cannot write b.bit: " + e.message())
  }

  let p = loadProject(coreDir, "a.bit", stdRoot)
  assert(p.root >= 0 && p.prelude >= 0)
  assert(p.root != p.prelude)
  let rootMod = p.mods[p.root]
  assert(len(rootMod.fileNames) == 1)
  assert(rootMod.fileNames[0] == "a.bit")
  let preludeMod = p.mods[p.prelude]
  assert(len(preludeMod.fileNames) == 2)

  removeTree(root, pmCheckTimeoutMs)
}
