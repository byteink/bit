// Self-host Stage 3 (#1342): ARM64 call sequences, block edges and the
// epilogue, split out of arm64.bit (#1503). Sibling .bit file, same module:
// see arm64.bit for the backend overview.

// ===========================================================================
// Calls
// ===========================================================================

// Stores one overflow argument to its outgoing stack slot [sp + off] in the
// reserved area at the bottom of this frame. `src` is sp-relative (a spill) or a
// physical register; the frame never moves, so both the slot and every spill
// source stay put — the mem staging temp (scratch1/fscratch1) is free here
// because these run before the register parallel moves.
fn emitOutgoingStackArg(cx: A64Ctx, src: PLoc, regClass: RegClass, off: int) {
  if (regClass == RegClass.Int) {
    if (src.isReg) {
      storeImm(cx.code, src.v, regSp(), off, 8)
      return
    }
    loadImm(cx.code, scratch1(), regSp(), src.v, 8, false)
    storeImm(cx.code, scratch1(), regSp(), off, 8)
    return
  }
  if (src.isReg) {
    storeImmF(cx.code, src.v, regSp(), off, 8)
    return
  }
  loadImmF(cx.code, fscratch1(), regSp(), src.v, 8)
  storeImmF(cx.code, fscratch1(), regSp(), off, 8)
}

// Marshals `args` into their ABI argument registers via the parallel-move
// sequencer, with the integer/float register banks already baseIntOrd/
// baseFloatOrd deep (emitCall passes 0,0 for a plain call; the closure and
// interface paths pass 1,0 to reserve x0 for the environment/receiver).
// Arguments past x0-x7 / v0-v7 overflow to the outgoing stack-argument area at
// the bottom of the frame: each is stored at [sp + 8*k] in argument order,
// before the register parallel moves run.
fn marshalArgs(cx: A64Ctx, args: []int, baseIntOrd: int, baseFloatOrd: int) {
  let intOrd = baseIntOrd
  let floatOrd = baseFloatOrd
  // One parallel move covering both classes (#3182): the register-bound moves
  // below run through a single sequentializeAndEmit call.
  let moves = []PMove(0)
  let stackIndex = 0
  let i = 0
  while (i < len(args)) {
    let v = args[i]
    let regClass = regClassOf(cx.module.ctx, cx.f.instrs[v].ty)
    let ord = floatOrd
    if (regClass == RegClass.Int) {
      ord = intOrd
    }
    let src = plocOf(cx, vregOf(cx, v), regClass)
    let reg = argReg(regClass, ord)
    if (reg < 0) {
      emitOutgoingStackArg(cx, src, regClass, outgoingArgOffset(stackIndex))
      stackIndex = stackIndex + 1
    } else {
      moves = append(moves, PMove{ src: src, dst: plocReg(reg, regClass) })
    }
    if (regClass == RegClass.Int) {
      intOrd = intOrd + 1
    } else {
      floatOrd = floatOrd + 1
    }
    i = i + 1
  }
  sequentializeAndEmit(cx, moves)
}

// Whether `ty` is the bool primitive — the one integer-class type whose return
// register a C callee may leave partially undefined.
fn isBoolTy(ctx: TypeContext, ty: int): bool {
  return ctx.types[ty].kind == TypeKind.Prim && ctx.types[ty].prim == 10
}

// Binds one call's single result (if any) into `dst`.
fn bindCallResult(cx: A64Ctx, dst: int, dstTy: int, normalizeBool: bool) {
  if (dst < 0) {
    return
  }
  if (regClassOf(cx.module.ctx, dstTy) == RegClass.Float) {
    putFloat(cx, dst, retRegNum())
    return
  }
  // A C callee returns `bool` in w0, leaving x0's upper bits unspecified. A Bit
  // bool is a full-width 0/1 — `!b` and the branch tests read the whole register
  // — so normalize at this boundary, where a foreign convention meets ours (see
  // ABI.md §2 on a narrow return leaving the register partly undefined).
  if (normalizeBool && isBoolTy(cx.module.ctx, dstTy)) {
    uxtb(cx.code, retRegNum())
  }
  putInt(cx, dst, retRegNum())
}

// `dst` is a vreg, or -1 when the call's result is discarded (no vreg is
// negative, so the sentinel is unambiguous).
fn emitCall(cx: A64Ctx, dst: int, dstTy: int, symbol: string, args: []int, isSafepoint: bool) {
  if (symbol == gcThreadTokenSymbol() && len(args) == 0) {
    emitInlinedThreadToken(cx)
    if (isSafepoint) {
      recordSafepoint(cx, codeLen(cx))
    }
    bindCallResult(cx, dst, dstTy, true)
    return
  }
  marshalArgs(cx, args, 0, 0)
  emitCallReloc(cx, symbol)
  if (isSafepoint) {
    recordSafepoint(cx, codeLen(cx))
  }
  bindCallResult(cx, dst, dstTy, true)
}

// ---------------------------------------------------------------------------
// #3434: the thread-token read, emitted here instead of called
// ---------------------------------------------------------------------------
//
// MUST MIRROR runtime/gc/linux/gcthread.bit and runtime/gc/darwin/gcthread.bit,
// which carry these four words verbatim. tests/bit/threadtokenbytes.bit reads
// both files and fails on any drift — see gcThreadTokenSymbol (codegen.bit) for
// why the body is unreachable to the inliner and what that cost.
//
// ONE payload for every AArch64 target, and that is a property of the probe,
// not an omission: aarch64-linux and aarch64-macos read the SAME two system
// registers in the SAME order, and aarch64-windows is out of scope for the
// Windows port (epic #3322 targets x86_64-windows only). So this backend needs
// no OS discriminator at all — only the x64 one does, and it already has
// XCallConv. See runtime/gc/gcthread.bit's header for why the order is
// TPIDRRO_EL0 first (measured on hardware: Darwin puts a CPU id, not a thread
// pointer, in TPIDR_EL0, so the natural-reading order silently hands every
// thread on a 2-core Mac one of two tokens).
//
// x0 is the AArch64 return register (retRegNum), so the sequence lands its
// result exactly where a real `bl` to this symbol would have, and
// bindCallResult moves it on unchanged. The `cbnz` is PC-relative over two
// words INSIDE this sequence, so it needs no fixup and no reloc and is valid at
// any offset.
//
// The safepoint entry is still recorded, deliberately. cx.nextSafepointIdx
// indexes regalloc's stackMaps in lockstep with buildIntervals' own Op.Call
// scan (recordSafepoint asserts `sm.pos == safepointPositions[idx]`), so
// skipping it here would desynchronise every later safepoint in the function.
// The entry it writes is inert: runtime/gc/stackmap.bit's scanFrame matches
// `codeAddr + retOff == pc` EXACTLY, and no return address can ever equal an
// offset with no call in front of it.
// A LIST, not four emitWord calls, so tests/bit/threadtokenbytes.bit can read
// this literal out of the checked-in source and compare it against the runtime
// files it mirrors as one payload — the same shape the runtime writes it in.
//
//   d53bd060  mrs  x0, tpidrro_el0   Darwin: the thread pointer. Linux: 0.
//   b5000040  cbnz x0, +8            non-zero -> that IS the answer
//   d53bd040  mrs  x0, tpidr_el0     Linux: the thread pointer.
//   927df000  and  x0, x0, #~7       Darwin packs a cpu id in the low bits
fn a64ThreadTokenWords(): []int {
  return [0xD53BD060, 0xB5000040, 0xD53BD040, 0x927DF000]
}

fn emitInlinedThreadToken(cx: A64Ctx) {
  for w of a64ThreadTokenWords() {
    emitWord(cx.code, w)
  }
}

// Records the stack map for the safepoint at `retOff` (a call return address)
// from the register allocator's precomputed stackMaps, in the same first-seen
// order buildIntervals collected them. Shared by every safepoint-bearing call
// site (emitCall, emitGcAlloc, emitMakeClosure, the two indirect calls).
fn recordSafepoint(cx: A64Ctx, retOff: int) {
  let sm = cx.result.stackMaps[cx.nextSafepointIdx]
  assert(sm.pos == cx.safepointPositions[cx.nextSafepointIdx])
  let regs = []int(0)
  let i = 0
  while (i < len(sm.regs)) {
    regs = append(regs, cx.intRegs[sm.regs[i]])
    i = i + 1
  }
  // Normalize to frame-pointer-relative (x29 = sp + frameSize - 16), so the
  // runtime walker (runtime/ABI.md §4) is arch-neutral: *(x29 + off).
  let fpBase = savedFpOffset(cx.frame)
  let offs = []int(0)
  i = 0
  while (i < len(sm.slots)) {
    offs = append(offs, spillOffset(cx.frame, sm.slots[i]) - fpBase)
    i = i + 1
  }
  cx.safepoints = append(cx.safepoints, SafepointView{ retOffset: retOff, slots: offs, regs: regs })
  cx.nextSafepointIdx = cx.nextSafepointIdx + 1
}

// gc_alloc: load the static TypeInfo blob's address into x0 and `bl
// bit_rt_gc_alloc`, which returns the zeroed body pointer in x0. A GC point, so
// it records a safepoint (buildIntervals counts gc_alloc too).
fn emitGcAlloc(cx: A64Ctx, dst: int, size: int, ptrOffsets: []int) {
  let name = typeInfoSymbol(cx.f.instrs[dst].ty, size, ptrOffsets)
  emitAddrOf(cx, argReg(RegClass.Int, 0), name) // arg0 = x0
  emitCallReloc(cx, "bit_rt_gc_alloc")
  recordSafepoint(cx, codeLen(cx))
  putInt(cx, dst, retRegNum())
}

// type_info: materialize the address of a named type's static TypeInfo blob. Not
// a call and not a GC point — the descriptor is a .rodata constant (its
// non-reference result type keeps it out of the stack map).
fn emitTypeInfo(cx: A64Ctx, dst: int, disc: int, size: int, ptrOffsets: []int) {
  let d = destInt(cx, dst, scratch1())
  emitAddrOf(cx, d, typeInfoSymbol(disc, size, ptrOffsets))
  putInt(cx, dst, d)
}

// A closure value is a pointer to a 16-byte GC cell {code_ptr, env_ptr}: the code
// pointer at +0 (into .text, never a GC ref) and the captured environment at +8
// (the cell's one GC field). Single-word, so it flows through the register
// allocator like any other reference.
fn closureCellSize(): int {
  return 16
}

fn closureCellPtrOffsets(): []int {
  return [8]
}

// make_closure: allocate the {code, env} cell (a GC point, like emitGcAlloc),
// then store the target function's address at +0 and the already-materialized
// environment pointer at +8.
fn emitMakeClosure(cx: A64Ctx, dst: int, funcName: string, env: int) {
  let ti = typeInfoSymbol(cx.f.instrs[dst].ty, closureCellSize(), closureCellPtrOffsets())
  emitAddrOf(cx, argReg(RegClass.Int, 0), ti) // x0 = &TypeInfo
  emitCallReloc(cx, "bit_rt_gc_alloc")
  recordSafepoint(cx, codeLen(cx))
  // x0 = cell. Store code address at +0 and the env pointer at +8.
  let cell = retRegNum()
  emitAddrOf(cx, scratch1(), funcName) // x9 = &code
  storeImm(cx.code, scratch1(), cell, 0, 8)
  storeImm(cx.code, getInt(cx, vregOf(cx, env), scratch1()), cell, 8, 8)
  putInt(cx, dst, cell)
}

// func_addr: materialize a function's code address into `dst` via a
// page21/pageoff12 relocation pair to its own symbol (the same primitive
// make_closure uses to fill a cell's code slot, minus the cell). No call.
fn emitFuncAddr(cx: A64Ctx, dst: int, funcName: string) {
  let d = destInt(cx, dst, scratch1())
  emitAddrOf(cx, d, funcName)
  putInt(cx, dst, d)
}

// stackmaps_addr (§11.12): one bound of the linker-built stack-map table, via the
// same page21/pageoff12 relocation pair func_addr uses. The name is undefined in
// this object by design — no member may claim it (ABI.md §4) — so the emitter
// carries it out as an undefined external and strip.bit resolves it at link.
// Pure address materialization: no load, no call, no safepoint.
fn emitStackMapsAddr(cx: A64Ctx, dst: int, sym: string) {
  let d = destInt(cx, dst, scratch1())
  emitAddrOf(cx, d, sym)
  putInt(cx, dst, d)
}

// global_addr (§11.11): the static address of a module-level variable, via the
// same page21/pageoff12 relocation pair func_addr uses. Pure address
// arithmetic — no load, no call, no safepoint — so it is legal inside a
// `@nosplit` body (§10.3.1).
//
// A per-thread cell instead resolves against the thread pointer, so its address
// differs per OS thread; that path is equally call-free, which is what lets
// §11.11 promise `@nosplit` compatibility for both storage classes.
fn emitGlobalAddr(cx: A64Ctx, dst: int, sym: string) {
  let d = destInt(cx, dst, scratch1())
  if (globalStorageOf(cx.module, sym) == 1) {
    emitTlsAddrOf(cx, d, sym)
  } else {
    emitAddrOf(cx, d, sym)
  }
  putInt(cx, dst, d)
}

// AArch64 ELF local-exec TLS (§11.11): the address of thread-local `symbol` in
// the CALLING thread, as
//
//     mrs dst, TPIDR_EL0
//     add dst, dst, #:tprel_hi12:symbol, lsl #12
//     add dst, dst, #:tprel_lo12_nc:symbol
//
// Three instructions, no memory reference and no call, so the sequence is legal
// in a `@nosplit` body and clobbers nothing but `dst`. The linker folds the
// variant-I `AbiTcb` header into the relocation's value, so the two ADDs
// together carry a 24-bit thread-pointer offset.
fn emitTlsAddrOf(cx: A64Ctx, dst: int, symbol: string) {
  emitWord(cx.code, 0xD53BD040 | dst) // MRS dst, TPIDR_EL0
  let hiOff = codeLen(cx)
  emitWord(cx.code, 0x91400000 | (dst << 5) | dst) // ADD dst, dst, #0, LSL #12
  cx.relocs = append(cx.relocs, Reloc{ offset: hiOff, symbol: symbol, kind: RelocKind.TprelHi12 })
  let loOff = codeLen(cx)
  emitWord(cx.code, 0x91000000 | (dst << 5) | dst) // ADD dst, dst, #0
  cx.relocs = append(cx.relocs, Reloc{ offset: loOff, symbol: symbol, kind: RelocKind.TprelLo12 })
}

// call_value: dispatch through a closure. Load the environment (+8) and code
// pointer (+0) into reserved scratch regs argument marshaling never touches
// (x10/x11 are not argument registers; x9 is the parallel-move cycle temp),
// marshal the real arguments into x1.., place the environment in x0, then blr. A
// call is a GC point, so it records a safepoint.
fn emitCallValue(cx: A64Ctx, dst: int, dstTy: int, callee: int, args: []int) {
  let cell = getInt(cx, vregOf(cx, callee), scratch1())
  // #2018: a nil function value's cell is the null word (SPEC §13.4); calling
  // through it must panic (§18.4: "call of a nil function"), not dereference
  // address 0 for its {code, env} fields. `Op.CallValue` is already a full
  // safepoint/clobber point for regalloc (isSafepointOp), so this extra call
  // on the cold path needs no register preservation of its own.
  cmpZero(cx.code, cell)
  let ncFixup = emitLocalCondBranch(cx, condNe()) // non-nil -> skip the panic call
  emitCallReloc(cx, "bit_rt_panic_nil_call")
  patchLocalCondBranch(cx, ncFixup)
  loadImm(cx.code, scratch2(), cell, 8, 8, false) // x10 = env
  loadImm(cx.code, scratch3(), cell, 0, 8, false) // x11 = code
  marshalArgs(cx, args, 1, 0)
  movRR(cx.code, argReg(RegClass.Int, 0), scratch2()) // x0 = env
  blr(cx.code, scratch3())
  recordSafepoint(cx, codeLen(cx))
  bindCallResult(cx, dst, dstTy, false)
}

// call_iface: structural interface dispatch (ABI.md §2.1). Load the receiver
// object's TypeInfo (*(recv - 32), the header's `info` field), resolve the method
// id to a code address via bit_rt_iface_lookup, then blr it with the receiver in
// x0. The lookup never collects, so only the final method call records a
// safepoint (like emitCallValue); the receiver is reloaded from its vreg
// afterward (its home survives the lookup call).
fn emitCallIface(cx: A64Ctx, dst: int, dstTy: int, ifaceVal: int, methodId: int, args: []int) {
  let recv = getInt(cx, vregOf(cx, ifaceVal), scratch1())
  // #2240: a nil interface value's receiver is the null word (ABI.md §2: an
  // interface value IS its receiver pointer); dispatching through it must
  // panic, not read `*(recv - 32)` as a TypeInfo pointer at address -32.
  // `Op.CallIface` is already a full safepoint/clobber point for regalloc
  // (isSafepointOp), so this extra call on the cold path needs no register
  // preservation of its own.
  cmpZero(cx.code, recv)
  let niFixup = emitLocalCondBranch(cx, condNe()) // non-nil -> skip the panic call
  emitCallReloc(cx, "bit_rt_panic_nil_iface")
  patchLocalCondBranch(cx, niFixup)
  addSubImmediate(cx.code, true, scratch2(), recv, 32, false) // x10 = recv - 32
  loadImm(cx.code, scratch2(), scratch2(), 0, 8, false)       // x10 = info
  movRR(cx.code, argReg(RegClass.Int, 0), scratch2())         // x0 = info
  movImm64(cx.code, argReg(RegClass.Int, 1), methodId)        // x1 = id
  emitCallReloc(cx, "bit_rt_iface_lookup")                    // x0 = method code address
  movRR(cx.code, scratch3(), retRegNum())                     // x11 = fn, survives marshaling
  marshalArgs(cx, args, 1, 0)
  movRR(cx.code, argReg(RegClass.Int, 0), getInt(cx, vregOf(cx, ifaceVal), scratch1())) // x0 = recv
  blr(cx.code, scratch3())
  recordSafepoint(cx, codeLen(cx))
  bindCallResult(cx, dst, dstTy, false)
}

// ===========================================================================
// Block edges and the epilogue
// ===========================================================================

// True iff a jump/br targeting `target` is a loop back-edge. Block ids are
// emitted in ascending order, so any edge that does not advance closes a loop —
// the conservative test the safepoint contract (runtime/ABI.md §5) needs: a loop
// with no call in it must still reach a safepoint, or a spinning thread would
// never yield to the collector.
// #2921: the naked shim's full chain (five stack frames, see
// runtime/stw/stwpoll.bit) is only needed when a stop is pending or a
// collection is due — both rare. #2921 guarded it behind a call to
// `bit_rt_safepoint_needed`; #2925 inlines that call's own condition instead
// (emitInlinedPollGuard) — see the header there for why a call, even to a
// true leaf, remained ~0.50s of collatz's 0.86s and could not be fixed by
// #2929 (that leaf's own prologue/epilogue is baked into the pinned-stage0
// libbitrt.a, out of this tree's reach).
fn emitBackEdgeSafepointIfNeeded(cx: A64Ctx, curBlock: int, target: int) {
  // §10.3.1: a @naked/@nosplit function polls no safepoint on its back-edges.
  if (isBackEdge(curBlock, target) && !needsNoSafepoints(cx.f)) {
    emitInlinedPollGuard(cx)
  }
}

// ---------------------------------------------------------------------------
// #2925: the poll guard's condition, inlined at the call site
// ---------------------------------------------------------------------------
//
// The six word offsets this ladder reads (pgWorldStopWordWord/pgGcCfgStressWord/
// pgGcCfgEnabledWord/pgGcHeapAddrWord/pgHeapLiveWordWord/pgGcNextBytesWord)
// live in compiler/codegen.bit — #3169 gave the x64 backend the same inlined
// ladder, and a number two backends mirror from one runtime must have exactly
// one copy. See that block's header for the mirroring contract, and
// tests/bit/pollguardoffsets.bit for the gate that pins it.

// Fetches (worldAddr, gcAddr) ONCE per function invocation and caches them in
// this function's own frame (FrameInfo.pollCacheSlots), rather than once per
// loop iteration. Safe because runtime/stw/stw.bit's stwBind runs exactly once
// at boot — before any compiled Bit function's entry can execute — and never
// unbinds (#2184): the two addresses are a per-process constant for the
// entire lifetime of every function this backend compiles, so re-fetching
// them on every iteration (what a per-iteration call would do) buys nothing.
// Emitted right after bindIncomingArgs: the incoming args are already off
// x0..x7 by then, so these calls' ordinary caller-saved clobber is harmless,
// and every vreg in a hasSafepoints function is callee-saved-only already
// (buildIntRegs), so neither call can clobber a live loop-carried value.
// bit_rt_world_addr/bit_rt_gc_addr are themselves true leaves that never
// allocate or park, so — like the #2921 guard call they replace at the call
// site — neither is recorded as a safepoint.
fn emitPollCachePrefetch(cx: A64Ctx) {
  if (cx.frame.pollCacheSlots == 0) {
    return
  }
  emitCallReloc(cx, worldAddrSymbol())
  storeImm(cx.code, retRegNum(), regSp(), pollCacheOffset(cx.frame, 0), 8)
  emitCallReloc(cx, gcAddrSymbol())
  storeImm(cx.code, retRegNum(), regSp(), pollCacheOffset(cx.frame, 1), 8)
}

// Loads the plain (non-atomic) i64 at word offset `wordOff` from the pointer
// value in `baseReg`, into `dst`. Mirrors a bare `*(g + off)` deref.
fn emitPollField(cx: A64Ctx, dst: int, baseReg: int, wordOff: int) {
  loadImm(cx.code, dst, baseReg, wordOff * 8, 8, false)
}

// Atomically loads the i64 at word offset `wordOff` from the pointer value in
// `baseReg`, overwriting `baseReg` with the loaded value. Mirrors a bare
// `atomicLoad(p + off)`. LDAR has no immediate-offset form (arm64ctx.bit's
// emitAddrOf note: no movabs/addressing-mode equivalent exists here either),
// so a nonzero offset is materialized into the same register first.
fn emitAtomicPollFieldInPlace(cx: A64Ctx, baseReg: int, wordOff: int) {
  if (wordOff != 0) {
    addSubImmWide(cx.code, false, baseReg, baseReg, wordOff * 8)
  }
  ldar(cx.code, 3, baseReg, baseReg)
}

// The inlined equivalent of:
//
//   fn stwPollNeeded(): bool {
//     let waddr = worldAddr
//     if (waddr == 0) { return true }
//     if (atomicLoad(world + worldStopWord) != 0) { return true }
//     let gA = gcAddr
//     if (gA == 0) { return true }
//     if (*(g + gcCfgStress) != 0) { return true }
//     if (*(g + gcCfgEnabled) == 0) { return false }
//     let hb = *(g + gcHeapAddr)
//     let liveBytes = atomicLoad(hb + heapLiveWord)
//     let nextBytes = *(g + gcNextBytes)
//     return liveBytes >= nextBytes
//       && (liveBytes - nextBytes >= nextBytes
//           || *(g + gcNumObjectsIdx) >= *(g + gcNextObjects))
//   }
//
// `true` (poll needed) falls into the real `bl bit_rt_safepoint`; `false`
// (skip) branches past it. Three scratch registers cover the whole ladder —
// scratch1/scratch2 hold the cached worldAddr/gcAddr only until each is used
// for the last time, then get reused as plain temporaries, exactly as the
// rest of this backend already treats them (never live across an instruction
// boundary by convention).
fn emitInlinedPollGuard(cx: A64Ctx) {
  let rWorld = scratch1()
  let rGc = scratch2()
  let rTmp = scratch3()
  let pollFixups = []int(0)
  let skipFixups = []int(0)

  loadImm(cx.code, rWorld, regSp(), pollCacheOffset(cx.frame, 0), 8, false)
  cmpZero(cx.code, rWorld)
  pollFixups = append(pollFixups, emitLocalCondBranch(cx, condEq())) // waddr==0

  emitAtomicPollFieldInPlace(cx, rWorld, pgWorldStopWordWord())
  cmpZero(cx.code, rWorld)
  pollFixups = append(pollFixups, emitLocalCondBranch(cx, condNe())) // stop pending

  loadImm(cx.code, rGc, regSp(), pollCacheOffset(cx.frame, 1), 8, false)
  cmpZero(cx.code, rGc)
  pollFixups = append(pollFixups, emitLocalCondBranch(cx, condEq())) // gcAddr==0

  emitPollField(cx, rTmp, rGc, pgGcCfgStressWord())
  cmpZero(cx.code, rTmp)
  pollFixups = append(pollFixups, emitLocalCondBranch(cx, condNe())) // stress mode

  emitPollField(cx, rTmp, rGc, pgGcCfgEnabledWord())
  cmpZero(cx.code, rTmp)
  skipFixups = append(skipFixups, emitLocalCondBranch(cx, condEq())) // disabled -> skip

  emitPollField(cx, rTmp, rGc, pgGcHeapAddrWord())          // rTmp = heap base addr
  emitAtomicPollFieldInPlace(cx, rTmp, pgHeapLiveWordWord()) // rTmp = heap live bytes
  emitPollField(cx, rGc, rGc, pgGcNextBytesWord())          // rGc = next trigger
  cmpRR(cx.code, rTmp, rGc)
  skipFixups = append(skipFixups, emitLocalCondBranch(cx, condLt())) // under trigger -> skip

  // The object half of the trigger (#3292), inlined here by #3359 — without
  // it this ladder polls on the byte trigger alone and the runtime then
  // declines to collect, once per back edge, for as long as the two disagree.
  //
  //   liveBytes - nextBytes >= nextBytes            -> poll (second cycle)
  //   *(g+gcNumObjectsIdx) <  *(g+gcNextObjects)    -> skip
  //   otherwise                                     -> poll (objects caught up)
  //
  // The subtraction IS `liveBytes >= nextBytes * 2`, exactly and without
  // overflow, which is why no saturation guard appears here; the runtime
  // predicate is written the same way for the same reason. The final compare
  // falls THROUGH to the poll, so the object arm needs no extra branch.
  //
  // `rGc` held gcAddr until the `gcNextBytes` load above overwrote it, so the
  // object arm reloads it from the poll cache — one frame load, against the
  // ~190 instructions a wasted poll costs.
  subRR(cx.code, rTmp, rTmp, rGc)                           // rTmp = live - next
  cmpRR(cx.code, rTmp, rGc)
  pollFixups = append(pollFixups, emitLocalCondBranch(cx, condGe())) // 2x -> poll

  loadImm(cx.code, rGc, regSp(), pollCacheOffset(cx.frame, 1), 8, false)
  emitPollField(cx, rTmp, rGc, pgGcNumObjectsIdxWord())     // rTmp = live objects
  emitPollField(cx, rGc, rGc, pgGcNextObjectsWord())        // rGc = object trigger
  cmpRR(cx.code, rTmp, rGc)
  skipFixups = append(skipFixups, emitLocalCondBranch(cx, condLt())) // not caught up -> skip

  let i = 0
  while (i < len(pollFixups)) {
    patchLocalCondBranch(cx, pollFixups[i])
    i = i + 1
  }
  emitCall(cx, -1, 0, safepointSymbol(), []int(0), true)
  i = 0
  while (i < len(skipFixups)) {
    patchLocalCondBranch(cx, skipFixups[i])
    i = i + 1
  }
}

// Binds a jump's arguments to the target block's parameters. All of them at once
// — a naive sequential emission would clobber a source another move still needs.
fn moveBlockArgs(cx: A64Ctx, target: int, args: []int) {
  let tb = cx.f.blocks[target]
  // One parallel move covering both classes (#3182): a block edge is a single
  // simultaneous move, so both classes' PMoves go through one
  // sequentializeAndEmit call rather than two independently-ordered ones.
  let moves = []PMove(0)
  let i = 0
  while (i < len(args)) {
    let paramV = tb.instsStart + i
    let regClass = regClassOf(cx.module.ctx, cx.f.instrs[paramV].ty)
    moves = append(moves, PMove{ src: plocOf(cx, vregOf(cx, args[i]), regClass),
      dst: plocOf(cx, vregOf(cx, paramV), regClass) })
    i = i + 1
  }
  sequentializeAndEmit(cx, moves)
}

fn emitEpilogueAndRet(cx: A64Ctx) {
  // §10.3.1 @naked, and #2929 frameless: no frame was set up, so restore
  // nothing — emit only the raw `ret` (the return value is already in x0/v0).
  if (!cx.f.isNaked && !cx.frame.frameless) {
    // Mirrors emitPrologue exactly, slot for slot and in the same runs, so the
    // ldp/ldr split is decided identically (#3509) — every register comes back
    // from the offset the prologue wrote it to whether or not pairing applied.
    frameRun(cx.code, cx.frame.savedFpr, true, true, regSp(),
      fprSaveOffset(cx.frame, 0))
    frameRun(cx.code, cx.frame.savedGpr, false, true, regSp(),
      gprSaveOffset(cx.frame, 0))
    frameRun(cx.code, [29, 30], false, true, regSp(), savedFpOffset(cx.frame))
    addSubImmWide(cx.code, false, regSp(), regSp(), cx.frame.frameSize)
  }
  emitRet(cx.code)
}
