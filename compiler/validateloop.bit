// compiler/validateloop.bit — checker rejections for a `for ... of` / `for
// ... in` iterable (#2013, #2162, #4106). Sibling of validatestmt.bit,
// extracted because that file is
// at the 800-line hard limit (799 as of #2428) with no room for either rule —
// same squeeze validateassign.bit's #2740 header and validatezero.bit's #2147
// header record for their own extractions.
//
// Both rules below are wired from checkmodule.bit's pre-pass 3 for-of sweep —
// the loop that already visits every `Tag.ForOf` node once, in source order,
// to call `typeForOfBinder` — rather than `vStmt`. `vStmt` has no entry for
// `Tag.ForOf`/`Tag.ForIn` at all (validatestmt.bit:543-661 only classifies
// them for E0055 divergence and break/continue counting), so there was no
// existing hook to extend; adding one there would cost the one line
// validatestmt.bit no longer has. Reusing pre-pass 3's sweep instead needs no
// new hook anywhere and no growth of validatestmt.bit for either rule.
//
// ---- #4334: what `for x of m` yields --------------------------------------
//
// There is no rule here for a single binder over a MAP any more. E0088
// (#2108) used to reject it: SPEC.md §12.6 showed only `for (k, v) of m`, and
// one binder could not say whether it meant the key or the value, so
// rejecting was the reversible choice while the semantics were undecided.
//
// Epic #4332's owner ruling decided them: `of` yields THE VALUE and `in`
// yields THE POSITION, so a map's `of`-value is the `(k, v)` pair and its
// `in`-position is the key. `for x of m` therefore binds the pair, typed by
// `elementType`'s Map branch (checkmatch.bit), and `for (k, v) of m` is that
// same value destructured positionally. E0088 is retired, not reused —
// #4333's `vForInPairOverMap` (E0129, below) is what now guards the map's
// other half, `for (k, v) in m`.

// ---- #2013: for-of over a STRING ------------------------------------------
//
// `for c of "abc"` and `for (i, c) of s` (`s: string`) both pass `bit check`
// silently and die at lowering with the same spanless "cannot lower" refusal
// (`lowerForOf`'s `id.kind` guard in compiler/lowerctrl.bit: a string is
// `TypeKind.Prim`, not Slice/Array/Map/Chan, so it falls straight through).
//
// This is a TYPED gap, not an unmodeled one. For the single-binder spelling,
// `elementType` (checkmatch.bit) deliberately types the binder as a guessed
// rune (`i32`) — its own comment there calls the guess safe only because
// "for-of binders are typed for env resolution only, never dumped", which is
// true but beside THIS point, since nothing downstream ever asks whether that
// typing should have happened at all. For the two-binder spelling
// `for (i, c) of s`, `typeForOfBinder`'s tuple arm (checkmatch.bit) has no
// `string` case, so both binders stay untyped (0) — the same missing rule
// either way. So the defect is a CHECKING gap (no rule asks
// "does this iterable's kind admit for-of at all"), not a typing gap: the
// iterable's own type resolves fine in every spelling; what is missing is a
// validator that reads that type and objects to it before lowering does.
//
// Rejecting is not a design choice here — SPEC.md §21
// (:3132-3134) reserves "rune iteration (`for r of s`)" by name for a future
// version, alongside the UTF-8 rune conversions. There is nothing to decide;
// the only question was where the rule could live.
//
// `defaultType` runs on the iterable's type before the kind check, matching
// lowering's own `defaultType(fc.c, nodeType(fc, k[1]))` (lowerctrl.bit):
// a bare string literal iterable types as `untypedStringId`
// (`checkExprType`, checkexpr.bit:361), not `Prim`/11, until defaulted — the
// direct-literal repro (`for c of "abc"`) would otherwise slip past the kind
// test below exactly as it slips past `elementType`'s own undefaulted check.

// E0090: first free code above E0089 (parserdecl.bit's ecFunctionKeywordRemoved).
const ecForOfString = 90

// Reports E0090 when `node` (`Tag.ForOf`) iterates a `string`, in either
// binder form — the span sits on the iterable expression itself (`kids[1]`),
// not the binder, since the iterable's TYPE is what makes the loop illegal
// and the binder may not even exist as a single name (`for (i, c) of s`).
//
// Skips an iterable that did not infer, mentions `invalid`, or still carries
// an open type param — THE SAFETY RULE (validate.bit): an inference gap must
// never become a spurious diagnostic on code the previous release accepts.
fn vForOfString(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let iterT = checkExprType(c, kids[1])
  if (iterT == 0 || vMentionsInvalid(c, iterT, 0) || vHasTypeParam(c, iterT, 0)) {
    return
  }
  let dt = defaultType(c, iterT)
  if (c.ctx.types[dt].kind != TypeKind.Prim || c.ctx.types[dt].prim != 11) {
    return
  }
  report(
    c.diags, ecForOfString, vSpan(c, kids[1]),
    "'${typeName(c.ctx, dt)}' iteration ('for c of s') is not available in v0.1; rune iteration is reserved (§21)",
    "index bytes with 's[i]' (§12.6), or convert with '[]byte(s)' (§12.9)",
  )
}

// ---- #2162: for ... in ... over anything but a slice/array/map -----------
//
// Owner decision (2026-08-10): `for x in it` gets TypeScript semantics — `in`
// yields the slice/array's INDEX or the map's KEY, `of` keeps yielding
// values. That is only defined for a slice, array or map; everything else has
// no index or key to give the binder:
//
//   - `string` is excluded deliberately, not by oversight — what `for c of s`
//     itself yields is still unsettled (§21, #2013), so an `in` form over
//     strings before that lands would be building on sand.
//   - `chan<T>` is a stream, not a container: it has no keys.
//   - a pair binder IS grammatical here (#4333): Appendix A's `for_in =
//     ( IDENT | "(" pat "," pat ")" ) "in" expression .` admits one, so
//     `for (i, x) in xs` parses and reaches this rule, where a slice/array
//     iterable takes the (index, element) path and a map one is reported by
//     `vForInPairOverMap` below as E0129 rather than failing to parse.
//
// `typeForInBinder` (checkmatch.bit) already leaves the binder untyped (0) on
// every operand below rather than guess, so this rule is what turns that
// silence into a diagnostic instead of letting the program reach lowering's
// spanless "cannot lower" refusal — the same division of labour #2013's
// `vForOfString` uses for a for-of over a string.
//
// Skips an iterable that did not infer, mentions `invalid`, or still carries
// an open type param — THE SAFETY RULE (validate.bit): an inference gap must
// never become a spurious diagnostic on code the previous release accepts.

// E0091: first free code above E0090 (this file's ecForOfString).
const ecForIn = 91

// Reports E0091 when `node` (`Tag.ForIn`) iterates anything but a slice,
// array or map. The span sits on the iterable expression (`kids[1]`), same as
// `vForOfString` — the iterable's TYPE is what makes the loop illegal, not
// the binder.
fn vForIn(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let iterT = checkExprType(c, kids[1])
  if (iterT == 0 || vMentionsInvalid(c, iterT, 0) || vHasTypeParam(c, iterT, 0)) {
    return
  }
  let dt = defaultType(c, iterT)
  let t = c.ctx.types[dt]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array || t.kind == TypeKind.Map) {
    vForInPairOverMap(c, kids[0], t)
    return
  }
  report(
    c.diags, ecForIn, vSpan(c, kids[1]),
    "'for ... in ...' yields an index (slice/array) or a key (map); '${typeName(c.ctx, dt)}' has neither (§13.1)",
    "iterate values with 'for x of ...' instead, or index/key it explicitly",
  )
}

// E0129: first free code above E0128 (namedargs.bit's ecNamedArgVariadic).
const ecForInMapPairBinder = 129

// Reports E0129 for a `for (k, v) in m` pair binder (#4333): `in` already
// yields the map's key alone (`for k in m`), so a pair binder would put the
// key that `in` already gives you back inside a second, redundant pairing
// with the value — `typeForInPairBinder` (checkmatch.bit) only ever binds a
// slice/array's (index, element), so this diagnostic is what stops a map's
// pair binder reaching lowering silently untyped instead.
fn vForInPairOverMap(c: Checker, binder: int, t: Type) {
  if (t.kind != TypeKind.Map || getNode(c.tree, binder).tag != Tag.TuplePat) {
    return
  }
  report(
    c.diags, ecForInMapPairBinder, vSpan(c, binder),
    "the key is already inside the value; a pair binder over 'in' is redundant for a map",
    "use 'for (k, v) of m' to destructure the pair, or 'for k in m' for the key alone",
  )
}

// ---- #4106: field pattern for-of naming a field the class does not have --

// E0123: first free code above E0122 (checkbind.bit's ecArrayIndexOutOfRange).
const ecForOfUnknownField = 123

// Reports E0123 for each name in a `for { a, b, ... } of it` binder
// (`Tag.FieldPat`) that `it`'s element class does not declare as a field.
// `typeForOfFieldPat` (checkmatch.bit) leaves such a name untyped rather than
// invent one; this is what turns that silence into a diagnostic instead of an
// invalid-cascade or an E0040 "undefined name" once the loop body reads it —
// the same division of labour #2013's `vForOfString` uses for a for-of over a
// string.
//
// Skips an iterable whose element did not infer, mentions `invalid`, or still
// carries an open type param — THE SAFETY RULE (validate.bit): an inference
// gap must never become a spurious diagnostic on code the previous release
// accepts.
fn vForOfFieldPat(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let binder = kids[0]
  if (getNode(c.tree, binder).tag != Tag.FieldPat) {
    return
  }
  let iterT = checkExprType(c, kids[1])
  let elemT = elementType(c, iterT)
  if (elemT == 0 || vMentionsInvalid(c, elemT, 0) || vHasTypeParam(c, elemT, 0)) {
    return
  }
  if (c.ctx.types[elemT].kind != TypeKind.Struct) {
    return
  }
  for f of kidsOf(c.tree, binder) {
    let fname = c.source[getNode(c.tree, f).span.start:getNode(c.tree, f).span.end]
    if (structFieldLookup(c, "${elemT}." + fname) != 0) {
      continue
    }
    report(
      c.diags, ecForOfUnknownField, vSpan(c, f),
      "'${typeName(c.ctx, elemT)}' has no field '${fname}'",
      "check the field name, or the class declaration",
    )
  }
}

// ---- #4336: for-of pair binder over an element with no matching parts ------
//
// Epic #4332's owner ruling makes `of` yield THE VALUE and a binder pattern
// split whatever it was handed, so `for (a, b) of xs` asks the ELEMENT for two
// parts. `for (i, x) of xs` used to mean (index, element) instead; that meaning
// moved to `for (i, x) in xs` (#4333) and nothing under `of` replaced it.
//
// So a pair binder over `[]int` — the shape that used to bind an index — now
// asks an `int` to split in two, and `typeForOfBinder`'s `checkTupleBinders`
// call (checkmatch.bit) leaves both binders untyped rather than guess. This
// rule is what turns that silence into a diagnostic, instead of letting the
// program reach lowering's `destructureTuple` refusal — the same division of
// labour #2013's `vForOfString` uses for a for-of over a string.
//
// Deliberately not reported for a string or a `chan<T>` iterable: E0090 above
// already owns the string row, and a channel's binder shape is
// `lowerForOfChan`'s. `vForOfSplitElem` is the eligibility half, split out so
// this file's guards stay under spec/LINT.md's max-complexity (10).

// E0146: first free code above E0145 (classjsondecodecall.bit's ecJsonDecodeType).
const ecForOfPairBinder = 146

// The element type a `for … of` tuple binder on `node` (`Tag.ForOf`) is asking
// to split, or 0 when this loop is not one E0146 can judge — a non-tuple
// binder, an iterable that is not a slice/array/map, or an iterable that did
// not infer, mentions `invalid` or still carries an open type param (THE
// SAFETY RULE, validate.bit: an inference gap must never become a spurious
// diagnostic on code the previous release accepts). The element is derived
// from that same iterable, so it needs no second invalid/type-param screen.
fn vForOfSplitElem(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (getNode(c.tree, kids[0]).tag != Tag.TuplePat) {
    return 0
  }
  let iterT = checkExprType(c, kids[1])
  if (iterT == 0 || vMentionsInvalid(c, iterT, 0) || vHasTypeParam(c, iterT, 0)) {
    return 0
  }
  let k = c.ctx.types[defaultType(c, iterT)].kind
  if (k != TypeKind.Slice && k != TypeKind.Array && k != TypeKind.Map) {
    return 0
  }
  return elementType(c, iterT)
}

// Reports E0146 when a `for (a, b, …) of it` binder cannot split what `of`
// handed it: the value is not a tuple at all, or it is a tuple of a different
// arity than the binder names. The span sits on the BINDER, not the iterable —
// the iterable is legal for-of material either way, the pattern is what does
// not fit it.
fn vForOfPairBinder(c: Checker, node: int) {
  let elemT = vForOfSplitElem(c, node)
  if (elemT == 0) {
    return
  }
  let binder = kidsOf(c.tree, node)[0]
  let names = len(kidsOf(c.tree, binder))
  if (c.ctx.types[elemT].kind != TypeKind.Tuple) {
    report(
      c.diags, ecForOfPairBinder, vSpan(c, binder),
      "'${typeName(c.ctx, elemT)}' has no parts to split (§13.1)",
      "use 'for (i, x) in ...' for the index and the element, or 'for x of ...' for the element alone",
    )
    return
  }
  let parts = len(c.ctx.types[elemT].members)
  if (parts != names) {
    report(
      c.diags, ecForOfPairBinder, vSpan(c, binder),
      "'${typeName(c.ctx, elemT)}' has ${parts} parts, but this binder names ${names} (§13.1)",
      "name one binder per part",
    )
  }
}
