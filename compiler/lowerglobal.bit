// compiler/lowerglobal.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

fn lowerIfaceMethodValue(fc: FnCtx, node: int, recvTy: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let mn = getNode(fc.c.tree, kids[1])
  let mname = fc.c.source[mn.span.start:mn.span.end]
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let sigKey = "${recvTy}.${mname}"
  let fnTy = methodSigLookup(fc.c, sigKey)
  let result = methodResultLookup(fc.c, sigKey)
  let mid = methodId(fc.lowerer, mname)
  let paramTypes = fc.c.ctx.types[fnTy].members
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let recvParam = builderAddParam(b, recvTy)
  let allParams = [recvTy]
  let callArgs = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    callArgs = append(callArgs, builderAddParam(b, paramTypes[i]))
    allParams = append(allParams, paramTypes[i])
    i = i + 1
  }
  let ci = mkInstr(Op.CallIface, result)
  ci.lhs = recvParam
  ci.ival = mid
  ci.args = callArgs
  let r = builderEmit(b, ci)
  if (result == fc.c.ctx.voidId) {
    builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
  } else {
    let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
    rt.args = [r]
    builderEmit(b, rt)
  }
  builderEndBlock(b)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "ifacemethod\$trampoline\$${fid}", paramTypes: allParams, result: result, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  let mc = mkInstr(Op.MakeClosure, fnTy)
  mc.name = "ifacemethod\$trampoline\$${fid}"
  mc.lhs = recvV
  return builderEmit(fc.b, mc)
}

// Whether `name` is in a string list.
fn stringInList(xs: []string, name: string): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// The FuncId of the trampoline that wraps top-level function `funcName` as a
// first-class value, synthesizing it on first use. The trampoline takes the
// closure env (ignored) plus the target's parameters and tail-calls the target,
// so a bare function value is call-compatible with arrow closures.
fn fnValueTrampoline(fc: FnCtx, funcName: string): int {
  for (nm, existing) of fc.lowerer.fnValueTramps {
    if (nm == funcName) {
      return existing
    }
  }
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  let decl = funcDeclLookup(fc.c, funcName)
  // An imported target's params are declared in ITS tree (see declOwner).
  //
  // The SIGNATURE types, not the callee's body slot types: a variadic tail is
  // `...xs: i32`, which the callee's own frame binds as `[]i32` but which the
  // function TYPE carries as the element type with variadic-ness held as a
  // separate flag. The trampoline is declared against the type, so it takes the
  // element type here — matching the seed. The value that actually arrives is
  // the caller's slice either way (one word, identical call sites), so this is
  // the declared type only; no call site or lowering changes with it.
  let paramTypes = lowerParamTypes(declOwner(fc.c, funcName), decl)
  let result = unwrapFallible(fc.c, funcResultLookup(fc.c, funcName))
  let fnTy = funcSigLookup(fc.c, funcName)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  // Leading env param (ignored), then one block param per target parameter.
  builderAddParam(b, fnTy)
  let callArgs = []int(0)
  let allParams = [fnTy]
  let i = 0
  while (i < len(paramTypes)) {
    callArgs = append(callArgs, builderAddParam(b, paramTypes[i]))
    allParams = append(allParams, paramTypes[i])
    i = i + 1
  }
  let call = mkInstr(Op.Call, result)
  // The trampoline body calls the real function, so it needs the same qualified
  // symbol a direct call would use — an imported target lives under its own
  // module's name.
  call.name = callQualified(fc.c, fc.lowerer.root, funcName)
  call.args = callArgs
  let r = builderEmit(b, call)
  if (result == fc.c.ctx.voidId) {
    builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
  } else {
    let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
    rt.args = [r]
    builderEmit(b, rt)
  }
  builderEndBlock(b)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "fnvalue\$trampoline\$${fid}", paramTypes: allParams, result: result, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  fc.lowerer.fnValueTramps[funcName] = fid
  return fid
}

// Whether a func decl is a generic template (has a non-empty `<...>` list). Such
// a template is not lowered directly — one instance per call-site type-arg combo
// is emitted instead (monomorphization).
fn isGenericFuncDecl(c: Checker, decl: int): bool {
  if (isExternDecl(c.tree, decl)) {
    return false // SPEC 11.7: never generic
  }
  let gp = kidsOf(c.tree, decl)[2]
  return gp != 0 && len(kidsOf(c.tree, gp)) > 0
}

// Every regular func a module contributes (free + methods) — part of the FuncId
// budget that must be reserved before any closure trampoline takes an id.
// Generic INSTANCES are not counted here: the ledger is project-wide now, so
// lowerProject adds them once rather than once per module.
fn moduleReservedCount(c: Checker): int {
  let reserved = 0
  let ri = 1
  while (ri < len(c.tree.nodes)) {
    let rn = getNode(c.tree, ri)
    if (rn.tag == Tag.FuncDecl) {
      if (kidsOf(c.tree, ri)[0] != 0 || !isGenericFuncDecl(c, ri)) {
        reserved = reserved + 1
      }
    }
    // SPEC 11.7: an extern decl emits NO function here (calls resolve by name),
    // but the seed still reserves it a FuncId in its Pass A. Closure ids count
    // up from this total and their SYMBOL NAME embeds the id, so failing to
    // count externs would rename every closure in a program that uses one.
    if (rn.tag == Tag.ExternFnDecl) {
      reserved = reserved + 1
    }
    ri = ri + 1
  }
  return reserved
}

// Lowers a whole checked project into ONE IrModule. Modules are walked in id
// (dependency) order within each pass, matching the seed's module-major
// Pass A/A2/A3 order, so the emitted function order is the seed's.
//
// The root module keeps bare names; every other module's functions are prefixed
// `m<id>$`, so two modules that both declare `join` cannot collide in the
// object's flat symbol namespace.
// The in-memory size of a module-level `let`'s type (§11.11). Only the untraced
// shapes the checker admits reach here: a scalar or raw `*T` is one field slot,
// and `[N]U` is N elements at their natural width — the same stride
// IndexGet/IndexSet use, which is what lets a static cell stand in for a heap
// array without touching either op.
fn moduleGlobalSize(ctx: TypeContext, ty: int): int {
  let t = ctx.types[ty]
  if (t.kind == TypeKind.Array) {
    return t.arrayLen * moduleGlobalScalarSize(ctx, t.elem)
  }
  return moduleGlobalScalarSize(ctx, ty)
}

fn moduleGlobalScalarSize(ctx: TypeContext, ty: int): int {
  let t = ctx.types[ty]
  if (t.kind == TypeKind.Prim) {
    let p = t.prim
    if (p == 0 || p == 4 || p == 10) { return 1 }
    if (p == 1 || p == 5) { return 2 }
    if (p == 2 || p == 6 || p == 8) { return 4 }
  }
  return 8
}

// A module global's rendered static image. `ok: false` means the initializer is
// a shape this cannot evaluate EXACTLY — the caller must then refuse (stub)
// rather than emit a cell holding the wrong value. Silent wrongness is the one
// outcome worth failing the build over.
struct GlobalImage {
  ok: bool,
  bytes: []int,
}

// Renders a module-level `let`'s initial value into its static byte image
// (§11.11). Little-endian: every target Bit emits for.
fn moduleGlobalImage(c: Checker, ty: int, initNode: int): GlobalImage {
  let size = moduleGlobalSize(c.ctx, ty)
  let bytes = []int(size)
  if (initNode == 0) {
    return GlobalImage{ ok: true, bytes: bytes }   // zero-valued
  }
  // The SAME folder the checker admitted this initializer with (§15.4), so
  // "check accepted it" and "lowering can render it" cannot drift apart — that
  // drift was #1430: `vLiteralValue` folded only a signed literal, so
  // `let x: i64 = 0 - 1` passed check and then failed to lower.
  let cv = vConstEval(c, initNode, 0)
  if (!cv.ok) {
    return GlobalImage{ ok: false, bytes: bytes }
  }
  // A constant STRING folds (#1534) but has no scalar value to render: vcString
  // carries no payload, so falling through would write `ival`'s 0 into the cell
  // and ship a silently wrong image — the one outcome this function exists to
  // prevent. Unreachable today, because a string is traced and §11.11 keeps it
  // out of module state, so this is the guard for the day that changes.
  if (cv.kind == vcString) {
    return GlobalImage{ ok: false, bytes: bytes }
  }
  let v = cv.ival
  if (cv.kind == vcFloat) {
    // The cell holds the IEEE-754 bit pattern, at the cell's own width: an f32
    // global stores the f32 encoding, not a truncated f64 one.
    if (size == 4) {
      v = int(float32Bits(f32(cv.fval)))
    } else {
      v = int(floatBits(cv.fval))
    }
  }
  let i = 0
  while (i < size) {
    bytes[i] = (v >> (i * 8)) & 255
    i = i + 1
  }
  return GlobalImage{ ok: true, bytes: bytes }
}

// Pass A0: walk every module's top-level `let` declarations (§11.11) and give
// each one an `IrGlobal` — a symbol name and the complete static image of its
// initial value.
//
// The checker has already proved each is a single-name binding of an untraced
// type, so this never diagnoses. A global whose initializer cannot be rendered
// exactly is simply not registered; every reference to it then fails its
// function, which `bit build` refuses — never a cell holding a wrong value.
fn registerGlobals(mods: []Checker, lowerer: Lowerer) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let i = 1
    while (i < len(c.tree.nodes)) {
      if (getNode(c.tree, i).tag == Tag.LetDecl) {
        // §11.11 storage class, recorded by the parser in the decl's `main`:
        // 0 = process-wide, 1 = per-thread (`@threadlocal let`). Both classes
        // obey identical untraced-type/constant-initializer rules, so only the
        // cell's placement differs and that is decided right here.
        let storage = getNode(c.tree, i).main
        let binds = kidsOf(c.tree, i)
        let j = 0
        while (j < len(binds)) {
          let bk = kidsOf(c.tree, binds[j])
          let pat = getNode(c.tree, bk[0])
          if (pat.tag == Tag.Ident && isModuleStateBinding(c, binds[j])) {
            let nm = c.source[pat.span.start:pat.span.end]
            let ty = c.nodeTypes[bk[0]]
            if (ty != 0) {
              let img = moduleGlobalImage(c, ty, bk[2])
              if (img.ok) {
                let sym = "__bitg_${c.moduleId}_${nm}"
                lowerer.globals = append(lowerer.globals, IrGlobal{ name: sym,
                  bytes: img.bytes, align: moduleStateAlign, storage: storage,
                  relocs: []IrGlobalReloc(0),
                  inRootModule: c.moduleId == lowerer.root })
                lowerer.globalSyms["${c.moduleId}\$${nm}"] = sym
              }
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    mi = mi + 1
  }
}

// Renders an `[N]T` const composite literal into its read-only static image
// (§11.11): each element folded with `vConstEval` — the SAME folder the checker
// admitted it with, so "check accepted" and "lowering can render" cannot drift
// — and written little-endian at the element's natural stride. `ok: false` if
// any element is not a constant scalar, so the caller refuses rather than
// shipping a silently wrong image.
fn constArrayImage(c: Checker, ty: int, initNode: int): GlobalImage {
  let elem = c.ctx.types[ty].elem
  let esize = moduleGlobalScalarSize(c.ctx, elem)
  let n = c.ctx.types[ty].arrayLen
  let bytes = []int(n * esize)
  if (initNode == 0 || getNode(c.tree, initNode).tag != Tag.CompositeLit) {
    return GlobalImage{ ok: false, bytes: bytes }
  }
  let items = kidsOf(c.tree, kidsOf(c.tree, initNode)[1])
  if (len(items) != n) {
    return GlobalImage{ ok: false, bytes: bytes }
  }
  let ep = c.ctx.types[elem].prim
  let isFloat = ep == 8 || ep == 9   // f32 / f64
  let i = 0
  while (i < n) {
    let a = items[i]
    if (getNode(c.tree, a).tag == Tag.Arg) { a = kidsOf(c.tree, a)[0] }
    let cv = vConstEval(c, a, 0)
    if (!cv.ok || cv.kind == vcString) {
      return GlobalImage{ ok: false, bytes: bytes }
    }
    let v = cv.ival
    if (isFloat) {
      // An untyped int literal in a float array folds to vcInt; convert so the
      // cell holds the IEEE-754 bit pattern the seed's `constWordFor` writes.
      let f = cv.fval
      if (cv.kind == vcInt) { f = f64(cv.ival) }
      if (esize == 4) { v = int(float32Bits(f32(f))) } else { v = int(floatBits(f)) }
    }
    let j = 0
    while (j < esize) {
      bytes[i * esize + j] = (v >> (j * 8)) & 255
      j = j + 1
    }
    i = i + 1
  }
  return GlobalImage{ ok: true, bytes: bytes }
}

// Pass A0': every top-level `const` whose initializer the checker admitted as a
// constant `[N]T` composite literal (§11.11) becomes one read-only `.rodata`
// image, registered in `globalSyms` exactly as a module-`let` cell is — so a
// reference resolves through the same `moduleGlobalSym` path and, being an
// `[N]T` (whose value IS its base address), lowers to a bare `GlobalAddr` with
// no per-use allocation. The naming (`__bitc_`) matches the seed so the two
// compilers emit byte-identical `global_addr` symbols in every dump.
fn registerConstArrays(mods: []Checker, lowerer: Lowerer) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let i = 1
    while (i < len(c.tree.nodes)) {
      if (getNode(c.tree, i).tag == Tag.ConstDecl) {
        let binds = kidsOf(c.tree, i)
        let j = 0
        while (j < len(binds)) {
          let bk = kidsOf(c.tree, binds[j])
          let pat = getNode(c.tree, bk[0])
          if (pat.tag == Tag.Ident && len(bk) >= 3 && bk[2] != 0) {
            let ty = c.nodeTypes[bk[0]]
            if (ty != 0 && c.ctx.types[ty].kind == TypeKind.Array &&
                c.ctx.types[c.ctx.types[ty].elem].kind == TypeKind.Prim) {
              let img = constArrayImage(c, ty, bk[2])
              if (img.ok) {
                let nm = c.source[pat.span.start:pat.span.end]
                let sym = "__bitc_${c.moduleId}_${nm}"
                lowerer.globals = append(lowerer.globals, IrGlobal{ name: sym,
                  bytes: img.bytes, align: moduleStateAlign, storage: storageReadonly(),
                  relocs: []IrGlobalReloc(0),
                  inRootModule: c.moduleId == lowerer.root })
                lowerer.globalSyms["${c.moduleId}\$${nm}"] = sym
              }
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    mi = mi + 1
  }
}

// The symbol of the module global `name` refers to at this use site, or "" when
// `name` is not module state. The owner lookup is the declOwner rule: a name
// imported from another module resolves against THAT module's id.
fn moduleGlobalSym(fc: FnCtx, name: string): string {
  let owner = declOwner(fc.c, name)
  let (sym, ok) = fc.lowerer.globalSyms["${owner.moduleId}\$${name}"]
  if (!ok) {
    return ""
  }
  return sym
}

// The address of a module-level `let`'s static cell (§11.11), as a raw pointer
// value. GlobalAddr is pure address arithmetic — no load, no call, no safepoint
// — which is what makes module state reachable from a `@nosplit` body.
fn emitGlobalAddrVal(fc: FnCtx, sym: string): int {
  let ga = mkInstr(Op.GlobalAddr, primType(fc.c.ctx, 3))
  ga.name = sym
  return builderEmit(fc.b, ga)
}

fn lowerProject(mods: []Checker, root: int): IrModule {
  assert(len(mods) >= 1)
  assert(root >= 0 && root < len(mods))
  // Pass A1: close the instantiation ledger over the calls the check pass could
  // not see (see closeInstantiations). BEFORE the FuncId budget below, which
  // counts the ledger, and before Pass A2 snapshots it.
  closeInstantiations(mods, root)
  // The FuncId budget spans every module: closure trampolines are numbered after
  // all of them, so a per-module count would hand two modules the same ids.
  let reserved = len(mods[root].ctx.instantiations)
  let ri = 0
  while (ri < len(mods)) {
    reserved = reserved + moduleReservedCount(mods[ri])
    ri = ri + 1
  }
  // One Lowerer for the whole project: interface dispatch ids, the string pool
  // and func-value trampolines are all program-wide, not per-module.
  let lowerer = Lowerer{ methodIds: map<string, int>{}, methodEntries: []MethodEntry(0),
    stringPool: []string(0), asmBlocks: []AsmBlock(0), reservedCount: reserved, closureFuncs: []IrFunc(0),
    fnValueTramps: map<string, int>{}, modPrefix: "", root: root, curModule: root,
    typeModule: map<int, int>{}, stubbed: []string(0),
    globals: []IrGlobal(0), globalSyms: map<string, string>{} }
  // Pass A0: every module-level `let` (§11.11) gets a static cell before any
  // function body is lowered, so a reference from a function declared above the
  // `let` resolves just as well as one below it.
  registerGlobals(mods, lowerer)
  // Pass A0': every `[N]T` const the checker admitted as a constant composite
  // literal (§11.11) gets a read-only `.rodata` cell, so a reference lowers to
  // its static address rather than re-allocating the literal per use.
  registerConstArrays(mods, lowerer)
  // Every named type -> its declaring module, before any body is lowered: a
  // method's symbol takes its receiver TYPE's prefix, and a Pass A body can call
  // a method whose decl Pass A3 has not reached yet. `typeDecls` holds only the
  // names a module declares itself, so an imported type is not claimed here.
  let ti = 0
  while (ti < len(mods)) {
    for (nm, _) of mods[ti].typeDecls {
      let id = userTypeLookup(mods[ti], nm)
      if (id != 0) {
        lowerer.typeModule[id] = ti
      }
    }
    ti = ti + 1
  }
  // An INSTANTIATION's own type id too, keyed on the module that DECLARED the
  // generic (#2306). `typeDecls` holds TEMPLATE names, and a method's receiver
  // type at a call site is the instance `GBox<int>`, never the template — so
  // `methodSymbol` found nothing and fell through to its unprefixed
  // `get2$t<id>`, while Pass A3 emitted the body under the declaring module's
  // prefix as `m1$get2$t<id>`. The two never met: `undefined symbol
  // '_get2$t54', referenced from bit.o`.
  //
  // This never surfaced because the CHECKER refused the call with E0057 first —
  // the same #2306 pass-order defect, one stage earlier. Fixing only the checker
  // turns that diagnostic into a link error, so both halves are one change.
  //
  // An instance declared by the ROOT module is unaffected: `modulePrefix(root,
  // root)` is "", which is exactly what the fallback already produced.
  let gi = 0
  while (gi < len(mods[root].ctx.typeInsts)) {
    let inst = mods[root].ctx.typeInsts[gi]
    if (inst.result != 0 && inst.module >= 0 && inst.module < len(mods)) {
      lowerer.typeModule[inst.result] = inst.module
    }
    gi = gi + 1
  }
  // Pass A3' (#1471): record every method decl, and assign the global dispatch
  // ids from them, BEFORE any body is lowered. The seed does the same — it fills
  // `l.method_table` while reserving method FuncIds and builds the per-type
 // tables at :998, both ahead of "Pass B: lower bodies". Doing it
  // after instead lets the first `call_iface` in a body claim id 0, so a program
  // mixing a concrete method with an interface method numbered them differently
  // in the two compilers. Neither numbering is wrong per runtime/ABI.md §2.1
  // (dense, one id per name, consistent program-wide), but the IR differential
  // is only useful if it is quiet.
  //
  // The walk must match Pass A3 node-for-node, and the ids come out of
  // buildMethodTables' GROUPED-BY-RECEIVER loop, not this flat order: for
  // `A.m1; B.m2; A.m3` the seed's ids are m1, m3, m2.
  collectMethodEntries(mods, root, lowerer)
  let methodTables = buildMethodTables(lowerer)
  let funcs = []IrFunc(0)

  // Pass A: every module's non-generic free functions, in declaration order.
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lowerer.modPrefix = modulePrefix(mi, root)
    lowerer.curModule = mi
    let consts = collectModuleConsts(c)
    let i = 1
    while (i < len(c.tree.nodes)) {
      let n = getNode(c.tree, i)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, i)[0] == 0 && !isGenericFuncDecl(c, i)) {
        funcs = append(funcs, lowerFunc(c, i, consts, lowerer))
      }
      i = i + 1
    }
    mi = mi + 1
  }

  // Pass A2: the project's monomorphized generic instances, in the checker's
  // discovery order (the index IS the `$n` suffix). Each is lowered against the
  // module that DECLARES the generic — its tree holds the template — and named
  // with that module's prefix, so every caller resolves to the one symbol.
  let insts = mods[root].ctx.instantiations
  let g = 0
  while (g < len(insts)) {
    let owner = mods[insts[g].module]
    lowerer.modPrefix = modulePrefix(insts[g].module, root)
    lowerer.curModule = insts[g].module
    funcs = append(funcs, lowerInstance(owner, collectModuleConsts(owner), lowerer, g,
      modulePrefix(insts[g].module, root)))
    g = g + 1
  }

  // Pass A3: each module's methods, in declaration order.
  mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lowerer.modPrefix = modulePrefix(mi, root)
    lowerer.curModule = mi
    let consts = collectModuleConsts(c)
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0) {
        let recvName = typeNodeName(c, kidsOf(c.tree, kidsOf(c.tree, m)[0])[1])
        if (len(declTypeParamIds(c, recvName)) == 0) {
          funcs = append(funcs, lowerFunc(c, m, consts, lowerer))
        } else {
          // A generic receiver has no single body: the seed emits one fully
          // substituted method per nominal instantiation, and an UNinstantiated
          // template emits nothing at all (there is no concrete type to lower
          // its `T` slots against). #1540.
          funcs = lowerMethodInstances(c, m, consts, lowerer, recvName, funcs)
        }
      }
      m = m + 1
    }
    mi = mi + 1
  }

  // Pass A4: synthesized closure trampolines, at the FuncIds reserved for them.
  let ci = 0
  while (ci < len(lowerer.closureFuncs)) {
    funcs = append(funcs, lowerer.closureFuncs[ci])
    ci = ci + 1
  }
  return IrModule{ funcs: funcs, ctx: mods[root].ctx, stringPool: lowerer.stringPool,
    asmBlocks: lowerer.asmBlocks, methodTables: methodTables, stubbed: lowerer.stubbed,
    globals: lowerer.globals, externNames: collectExternNames(mods) }
}

// Every §11.7 `extern function` name declared anywhere in the project, raw and
// unmangled. These are the only symbols the compiled program may legitimately
// leave undefined for dyld to bind; the Mach-O linker refuses any other (#1445).
//
// Scans EVERY module, not just the root: an extern declared in an imported
// module is still linked into this image, and missing one would turn a valid
// program into a link error. `kidsOf(...)[0]` is the name node (§ lowerFunc).
fn collectExternNames(mods: []Checker): []string {
  let out = []string(0)
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.ExternFnDecl) {
        let nameNode = getNode(c.tree, kidsOf(c.tree, m)[0])
        out = append(out, c.source[nameNode.span.start:nameNode.span.end])
      }
      m = m + 1
    }
    mi = mi + 1
  }
  return out
}

// A method's link symbol: prefixed by the module that DECLARES the receiver
// type, not by the caller's — `s.area()` on an imported Shape must reach the
// same symbol from every module — then mangled by the receiver's type id so two
// types can share a method name.
fn methodSymbol(lw: Lowerer, name: string, recvTy: int): string {
  let (mod, known) = lw.typeModule[recvTy]
  if (!known) {
    return name + "\$t${recvTy}" // an unnamed receiver: not an importable decl
  }
  return modulePrefix(mod, lw.root) + name + "\$t${recvTy}"
}

// A module's link prefix: bare for the root, `m<id>$` otherwise.
fn modulePrefix(mod: int, root: int): string {
  if (mod == root) {
    return ""
  }
  return "m${mod}\$"
}

// The (type param -> concrete arg) bindings a call's type arguments make. `oc`
// must OWN `decl` (its tree and its type tables).
//
// The ids come from the ledger registerGenerics filled, NOT from looking the
// param names up in `userTypes`: every generic registers its params under their
// bare names, so in a module declaring both `mapped<T, U>` and `fold<T, A>` the
// name `T` resolves only to whichever was declared last. Binding by name there
// silently produces an env keyed on ANOTHER decl's `T`, which matches nothing in
// this body and leaves every local a slice-of-type-param.
fn genericEnvOf(oc: Checker, decl: int, targs: []int): TypeEnv {
  let env = emptyTypeEnv()
  let genNode = kidsOf(oc.tree, decl)[2]
  if (genNode == 0) {
    return env
  }
  let ids = oc.genericParamIds[genNode]
  let tps = kidsOf(oc.tree, genNode)
  let j = 0
  while (j < len(ids) && j < len(targs)) {
    if (ids[j] != 0) {
      env.params = append(env.params, ids[j])
      env.args = append(env.args, targs[j])
    }
    // ...and ALSO the id the name resolves to right now, which is not always the
    // same id. registerGenerics records this decl's ids during the COLLECT pass,
    // but `userTypes` is flat and keyed by bare name, so the next generic in the
    // module to declare a `T` overwrites it. Bodies are checked in a later pass
    // (#1238's two-phase bind-then-body), by which point every body in the module
    // that mentions `T` was typed against the LAST-registered `T`, not its own.
    // Binding only the registered id therefore left `${got}` in `eq<T>`'s body
    // still typed as a bare type param after substitution, and lowerToString
    // refused it — four stubbed instances and a permanently red difftests gate
    // (#1485). A type param name inside a body can only mean that body's own
    // param, so binding both ids is sound; the duplicate is a no-op when they
    // agree (the last-declared generic).
    if (j < len(tps)) {
      let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
      let byName = userTypeLookup(oc, oc.source[tpn.span.start:tpn.span.end])
      if (byName != 0 && byName != ids[j]) {
        env.params = append(env.params, byName)
        env.args = append(env.args, targs[j])
      }
    }
    j = j + 1
  }
  return env
}

// A generic callee's declared parameter types with THIS call's type arguments
// substituted in. The template's params still name its own type params, so an
// argument hinted with the raw `[]T` is built as a slice of a type param — which
// classifies as holding GC references, handing slice_new is_ref=1 so the
// collector walks raw integers as pointers.
//
// Bound by NAME while resolving the decl's own type nodes, not by substituting
// the ids `lowerParamTypes` returns: that re-resolves `T` through `userTypes`,
// which by lowering time names whichever generic in the module declared a `T`
// last — a different id than this decl's, matching nothing.
fn genericParamTypes(oc: Checker, decl: int, targs: []int): []int {
  let sub = noSubst()
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let j = 0
  while (j < len(tps) && j < len(targs)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
    sub.names = append(sub.names, oc.source[tpn.span.start:tpn.span.end])
    sub.types = append(sub.types, targs[j])
    j = j + 1
  }
  return lowerParamTypesIn(oc, decl, sub)
}
