// compiler/relationautodefault.bit — #6366 (epic #6298): a parameter the call
// omits is still an argument. `fn show(p: Post = fallback())` called as
// `show()` hands `p` the value of `fallback()` (SPEC §10.3: a default is a full
// expression evaluated at the call site), so every consumer of a call's
// arguments — the auto-loader's summary walk (relationautocalls.bit), the
// return-forwarding of `relationAutoResolveNamedCall`, the holder stores of
// `relationAutoHolderNoteCall` (relationautostore.bit) and the proof at the
// call (relationautoerrcall.bit) — must see that expression, not a hole.
//
// A default is written in the CALLEE's module, so its node indexes that
// module's tree, never the caller's: a `RelationAutoSlot` carries the Checker
// that owns the expression beside the node. A default cannot name another
// parameter or `this` (E0183), so it is resolved against a fresh, empty state
// (`relationAutoSlotState`) and never sees a binding of the calling function.

// One argument position of a call, resolved to the expression that fills it:
// `c` owns `node`, `dflt` is true when it is the callee's default expression,
// `node == 0` when nothing fills the position.
class RelationAutoSlot {
  c: Checker,
  node: int,
  dflt: bool,
}

// `summary.params[i]`'s default expression and the module that owns it, or
// (`c`, 0) when it has none. `name` is the callee's name as written at the call
// `c` is checking (`declOwner` resolves it to the declaring module).
fn relationAutoParamDefault(
  c: Checker, name: string, summary: RelationAutoFuncSummary, i: int,
): RelationAutoSlot {
  let owner = declOwner(c, name)
  let params = kidsOf(owner.tree, kidsOf(owner.tree, summary.decl)[3])
  if (i >= len(params)) {
    return RelationAutoSlot{ c = c, node = 0, dflt = false }
  }
  let pk = kidsOf(owner.tree, params[i])
  if (len(pk) < 3 || pk[2] == 0) {
    return RelationAutoSlot{ c = c, node = 0, dflt = false }
  }
  return RelationAutoSlot{ c = owner, node = pk[2], dflt = true }
}

// What fills argument position `i` of a call from `c` to `name`: the
// call's own argument (`args[i]`, from `relationAutoArgExprs`) when it passes
// one, else the parameter's default.
fn relationAutoSlotOf(
  c: Checker, name: string, summary: RelationAutoFuncSummary, args: []int, i: int,
): RelationAutoSlot {
  if (i < len(args) && args[i] != 0) {
    return RelationAutoSlot{ c = c, node = args[i], dflt = false }
  }
  return relationAutoParamDefault(c, name, summary, i)
}

// The state `slot`'s expression resolves against: the caller's own `st` for an
// explicit argument, an empty one over the same summaries for a default.
fn relationAutoSlotState(slot: RelationAutoSlot, st: RelationAutoState): RelationAutoState {
  if (!slot.dflt) {
    return st
  }
  return RelationAutoState{
    bindings = []RelationAutoBinding(0), assigned = []RelationAutoErrLoaded(0),
    summaries = st.summaries, paramReads = map<string, []string>{}, returnSeen = false,
    returnCandidate = relationAutoNoFlow(slot.c), returnMixed = false,
  }
}

fn relationAutoSlotFlow(slot: RelationAutoSlot, st: RelationAutoState): RelationAutoFlow {
  return relationAutoResolve(slot.c, slot.node, relationAutoSlotState(slot, st))
}

// The pass context `slot`'s expression is judged in: the caller's own for an
// explicit argument, a fresh one for a default.
fn relationAutoSlotCtx(slot: RelationAutoSlot, ctx: RelationAutoErrCtx): RelationAutoErrCtx {
  if (!slot.dflt) {
    return ctx
  }
  return RelationAutoErrCtx{
    st = relationAutoSlotState(slot, ctx.st), errSt = RelationAutoErrState{ loaded = []RelationAutoErrLoaded(0) },
    fd = 0, pass = ctx.pass,
  }
}
