// compiler/pmfetchretrycheck.bit — in-Bit self-checks for the retry policy in
// pmfetchretry.bit (#7608): which git failures are transient, how long the
// backoff waits, and the shape of the one-line retry notice. Pure functions
// over literal `GitRun` values, no subprocess and no network; the end-to-end
// behaviour (a remote that fails twice then answers) is
// _tests_/bit/pmrangegate/retrytransient.bit (git) and _tests_/bit/pmvanity.bit
// (the vanity document GET). Called from `checkPmfetch()`
// (pmfetchcheck.bit).

fn pmRetryRun(code: int, output: string): GitRun {
  return GitRun{ exitCode = code, timedOut = false, output = output }
}

fn checkPmfetchRetryTransient() {
  // The incident that filed #7608, verbatim.
  assert(
    isTransientGitFailure(
      pmRetryRun(
        128,
        "fatal: unable to access 'https://github.com/o/r.git/': Failed to connect to github.com port 443 after 1047 ms: Couldn't connect to server\n",
      ),
    ),
  )
  assert(
    isTransientGitFailure(
      pmRetryRun(128, "fatal: unable to access 'https://h/r.git/': Could not resolve host: h\n"),
    ),
  )
  assert(
    isTransientGitFailure(
      pmRetryRun(
        128,
        "ssh: connect to host h port 22: Connection timed out\nfatal: Could not read from remote repository.\n",
      ),
    ),
  )
  assert(
    isTransientGitFailure(
      pmRetryRun(
        128,
        "fatal: unable to access 'https://h/r.git/': The requested URL returned error: 503\n",
      ),
    ),
  )
  assert(
    isTransientGitFailure(
      pmRetryRun(
        128,
        "error: RPC failed; curl 56 OpenSSL SSL_read: Connection reset by peer\nfatal: early EOF\n",
      ),
    ),
  )
  assert(isTransientGitFailure(GitRun{ exitCode = -1, timedOut = true, output = "" }))

}

fn checkPmfetchRetryPermanent() {
  // Never retried: auth, not found, a missing ref (exit 2, no output), success.
  assert(
    !isTransientGitFailure(pmRetryRun(128, "fatal: Authentication failed for 'https://h/r.git/'\n")),
  )
  assert(
    !isTransientGitFailure(
      pmRetryRun(
        128,
        "fatal: could not read Username for 'https://h': terminal prompts disabled\n",
      ),
    ),
  )
  assert(
    !isTransientGitFailure(
      pmRetryRun(
        128,
        "remote: Repository not found.\nfatal: repository 'https://h/r.git/' not found\n",
      ),
    ),
  )
  assert(
    !isTransientGitFailure(
      pmRetryRun(
        128,
        "fatal: unable to access 'https://h/r.git/': The requested URL returned error: 403\n",
      ),
    ),
  )
  assert(
    !isTransientGitFailure(
      pmRetryRun(
        255,
        "git@h: Permission denied (publickey).\nfatal: Could not read from remote repository.\n",
      ),
    ),
  )
  assert(
    !isTransientGitFailure(
      pmRetryRun(128, "fatal: '/no/such' does not appear to be a git repository\n"),
    ),
  )
  assert(!isTransientGitFailure(pmRetryRun(2, "")))
  assert(!isTransientGitFailure(pmRetryRun(0, "")))
}

// 500 ms doubling per attempt, jitter adding [0, 50%) on top.
fn checkPmfetchRetryBackoff() {
  assert(gitBackoffMs(1, 0) == 500)
  assert(gitBackoffMs(2, 0) == 1000)
  assert(gitBackoffMs(1, 255) == 500 + 500 * 255 / 512)
  assert(gitBackoffMs(2, 255) < 1500)
  let jitter = 0
  while (jitter < 256) {
    let first = gitBackoffMs(1, jitter)
    assert(first >= 500 && first < 750)
    let second = gitBackoffMs(2, jitter)
    assert(second >= 1000 && second < 1500)
    jitter = jitter + 1
  }
}

fn checkPmfetchRetryLine() {
  let multi = pmRetryRun(128, "fatal: unable to access 'u': Failed to connect\nsecond line\n")
  let line = gitRetryLine("git ls-remote u@v1", 1, gitFailureDetail(multi, 1000), 640)
  assert(
      line ==
      "pmfetch: git ls-remote u@v1 failed (attempt 1/3): fatal: unable to access 'u': Failed to connect second line; retrying in 640ms\n",
  )
  let timed = GitRun{ exitCode = -1, timedOut = true, output = "" }
  assert(gitFailureDetail(timed, 30000) == "timed out after 30000ms")
}

// The vanity document GET reports through the same classifier
// (`vanityAttempt`, pmfetchresolvevanity.bit): an HTTP status as the phrase
// git/curl use, a transport failure as the std/net and std/http error text.
fn checkPmfetchRetryVanity() {
  let status = "The requested URL returned error: "
  assert(isTransientGitFailure(pmRetryRun(500, status + "500")))
  assert(isTransientGitFailure(pmRetryRun(503, status + "503")))
  assert(isTransientGitFailure(pmRetryRun(429, status + "429")))
  assert(!isTransientGitFailure(pmRetryRun(404, status + "404")))
  assert(!isTransientGitFailure(pmRetryRun(400, status + "400")))
  assert(!isTransientGitFailure(pmRetryRun(401, status + "401")))
  assert(!isTransientGitFailure(pmRetryRun(403, status + "403")))
  assert(!isTransientGitFailure(pmRetryRun(410, status + "410")))
  assert(!isTransientGitFailure(pmRetryRun(301, status + "301")))
  assert(isTransientGitFailure(pmRetryRun(vanityTransportExit, "could not resolve bitlang.org")))
  assert(isTransientGitFailure(pmRetryRun(vanityTransportExit, "dial 1.2.3.4:443 failed")))
  assert(isTransientGitFailure(pmRetryRun(vanityTransportExit, "dial 1.2.3.4:443 timed out")))
  assert(isTransientGitFailure(pmRetryRun(vanityTransportExit, "read timed out")))
  assert(
    isTransientGitFailure(
      pmRetryRun(vanityTransportExit, "response: connection closed inside the head"),
    ),
  )
  assert(
    isTransientGitFailure(
      pmRetryRun(vanityTransportExit, "tls client: server flight has no ServerHello"),
    ),
  )
  assert(isTransientGitFailure(GitRun{ exitCode = -1, timedOut = true, output = "" }))
  assert(!isTransientGitFailure(pmRetryRun(0, "bit-import: x git https://h/r.git\n")))
}

fn checkPmfetchRetry() {
  checkPmfetchRetryTransient()
  checkPmfetchRetryPermanent()
  checkPmfetchRetryVanity()
  checkPmfetchRetryBackoff()
  checkPmfetchRetryLine()
}
