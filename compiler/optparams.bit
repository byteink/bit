// Self-host Stage 2: constant propagation across BLOCK PARAMS. Split out of
// opt.bit the way optfold.bit was (#1503) — same module, so nothing here needs
// an import.
//
// `sweepConsts` (opt.bit) is a single forward walk and is correct in one pass
// only because an operand's def index is always below its use's. A block param
// breaks that guarantee: its incoming arguments come from predecessor
// TERMINATORS, which a loop back edge places arbitrarily far later in the flat
// order. So a param that provably holds one constant on every incoming edge is
// invisible to the sweep, and #2378's flag-guarded defer lowering made the cost
// visible — the "defer already ran" flag is `const_bool true` in the entry
// block, arrives at the guard through a block param, and a statically-true
// `br` reached the backend (#3517).
//
// This pass adds no CFG surgery of its own. It only writes more entries into
// the SAME `known` map that `computeReachable` and `emitTranslated` already
// consult for a `br` condition, so a param proven constant collapses that `br`
// to a `jump` and the existing dead-block pruning removes the untaken side.

// The per-block-param agreement state over the predecessor edges seen so far.
// One record rather than two loose slices so the edge walk stays inside the
// parameter limit and the two arrays cannot be passed out of step.
class ParamAgree {
  // Per instruction index: 0 = no predecessor edge yet, 1 = every edge so far
  // agreed on `cand[i]`, 2 = poisoned (an edge passed a non-constant, an edge
  // disagreed, or the arity was wrong).
  state: []int,
  cand: []ConstVal,
}

// Whether any block other than the entry has parameters. A function with none
// has nothing for `propagateBlockParams` to do, so it skips the two
// per-instruction arrays that pass would otherwise allocate for every function
// in the module.
fn hasNonEntryParams(f: IrFunc): bool {
  let b = 1
  while (b < len(f.blocks)) {
    if (f.blocks[b].paramCount > 0) {
      return true
    }
    b = b + 1
  }
  return false
}

// Two constants are interchangeable only when the discriminators AND the
// payload match.
//
// A FLOAT IS NEVER interchangeable here, deliberately: IEEE-754 says
// `-0.0 == 0.0`, so an `==` on `fval` would call two values equal that
// `1.0 / x` tells apart (+inf against -inf), and NaN compares unequal to itself
// so a genuinely identical NaN would be rejected anyway. Callers treat a float
// argument as unknown instead; the integer and bool cases are what the
// flag-guarded defer lowering and every branch condition actually need.
fn sameConst(a: ConstVal, b: ConstVal): bool {
  return a.known &&
    b.known &&
    !a.isFloat &&
    !b.isFloat &&
    a.isBool == b.isBool &&
    a.ival == b.ival &&
    a.bval == b.bval
}

// EVERYTHING STARTS POISONED and only a real block param is opened up to 0.
// State 0 must never be promoted: it means the block has NO predecessor, and
// "every predecessor agrees" over an empty set is vacuously true — which would
// declare an unreachable block's params constant on nothing at all.
fn newParamAgree(f: IrFunc): ParamAgree {
  let state = []int(0)
  let cand = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    state = append(state, 2)
    cand = append(cand, noConst())
    i = i + 1
  }
  // Block 0 is the entry (lowering opens it first). Its params are the
  // FUNCTION's parameters and carry no predecessor edge, so they stay poisoned:
  // treating them as constant would fold every caller's argument away.
  let b = 1
  while (b < len(f.blocks)) {
    let blk = f.blocks[b]
    let j = 0
    while (j < blk.paramCount) {
      state[blk.instsStart + j] = 0
      j = j + 1
    }
    b = b + 1
  }
  return ParamAgree{ state = state, cand = cand }
}

// Folds one incoming argument into param slot `p`'s agreement state.
fn updateParamState(v: ConstVal, ag: ParamAgree, p: int) {
  if (ag.state[p] == 2) {
    return
  }
  if (!v.known || v.isFloat) {
    ag.state[p] = 2
    return
  }
  if (ag.state[p] == 0) {
    ag.state[p] = 1
    ag.cand[p] = v
    return
  }
  if (!sameConst(ag.cand[p], v)) {
    ag.state[p] = 2
  }
}

// Folds one CFG edge — `target` and the argument list that edge passes — into
// the target block's param states.
fn applyEdge(f: IrFunc, known: []ConstVal, ag: ParamAgree, target: int, args: []int) {
  let blk = f.blocks[target]
  let j = 0
  while (j < blk.paramCount) {
    let p = blk.instsStart + j
    if (j < len(args)) {
      updateParamState(known[args[j]], ag, p)
    } else {
      // An edge passing fewer arguments than the block declares is malformed IR
      // (verify.bit rejects it). Poison rather than read past the end.
      ag.state[p] = 2
    }
    j = j + 1
  }
}

// Feeds block `b`'s outgoing edges into the param states. Reads the terminator
// exactly the way `computeReachable` does, including the empty-block guard:
// `instsStart + instsLen - 1` names the instruction BEFORE an empty block,
// which is index -1 for block 0 (#2084).
//
// BOTH arms of a `br` are fed, even when the condition is already a known
// constant and one of them is about to be pruned. That is conservative in the
// safe direction — an extra edge can only make a param disagree and stay
// unfolded, never make it agree wrongly — and `optimizeModule` runs this pass
// twice, so the pruned edge is gone by the second run and the fold lands then.
fn applyBlockEdges(f: IrFunc, known: []ConstVal, ag: ParamAgree, b: int) {
  let blk = f.blocks[b]
  if (blk.instsLen == 0) {
    return
  }
  let term = f.instrs[blk.instsStart + blk.instsLen - 1]
  if (term.op == Op.Jump) {
    applyEdge(f, known, ag, term.ival, term.args)
    return
  }
  if (term.op == Op.Br) {
    applyEdge(f, known, ag, term.ival, term.thenArgs)
    applyEdge(f, known, ag, term.ival2, term.elseArgs)
  }
}

// One round: records a constant into every block param whose predecessor edges
// all pass the same one. Returns whether anything new was marked.
fn markConstParams(f: IrFunc, known: []ConstVal): bool {
  let ag = newParamAgree(f)
  let b = 0
  while (b < len(f.blocks)) {
    applyBlockEdges(f, known, ag, b)
    b = b + 1
  }
  let changed = false
  let i = 0
  while (i < len(f.instrs)) {
    if (ag.state[i] == 1 && !known[i].known) {
      known[i] = ag.cand[i]
      changed = true
    }
    i = i + 1
  }
  return changed
}

// Propagates a constant into a block param when EVERY predecessor edge passes
// the same one, then re-sweeps so the new fact cascades into the arithmetic and
// the compares that read it. `computeReachable` and `emitTranslated` both read
// `known[term.lhs]` for a `br`, so a param proven constant collapses that `br`
// to a `jump` and prunes the untaken side — no CFG surgery here, just one more
// source of constants for machinery that already existed.
//
// The rebuild never consults `known` for a param slot — `rebuild` emits params
// through `builderAddParam` before the instruction loop — so marking one here
// cannot change a block's arity or drop an edge's argument. It only unlocks
// folding at the USES, which is what keeps this a pure refinement of the
// existing pass rather than a new transform on the CFG.
//
// Bounded, not an open-ended fixpoint: `known` only ever gains entries,
// `sweepConsts` never writes a param slot, so each productive round marks at
// least one new param and there are strictly fewer params than instructions.
// `len(f.instrs)` is therefore a statically provable ceiling; in practice the
// `changed` early exit ends it after one or two rounds.
fn propagateBlockParams(ctx: TypeContext, f: IrFunc, known: []ConstVal) {
  if (!hasNonEntryParams(f)) {
    return
  }
  let rounds = 0
  while (rounds < len(f.instrs)) {
    if (!markConstParams(f, known)) {
      return
    }
    sweepConsts(ctx, f, known)
    rounds = rounds + 1
  }
}

// #6435 / BIT_CONST_STRING_FOLD: on by default, unlike the BIT_APPEND_FRESH
// two-step (lowerappend.bit), so programs get the fold now. The pinned 0.34.0
// oracle lacks it and its post-opt IR differs on 67 corpus files, so the
// diffiropt row sets it to "0" for the tree until the repin that carries #6435
// (scripts/selfhost-diffdump-setup.sh); golden still runs every case with it on.
// "0" makes every source -1, the neutral value, which turns off all three uses,
// stops `bceLimitCovers` (optbce.bit) comparing two constant limits, and stops
// #6454's `licmReadsLiteralPtr` (optloopcand.bit) hoisting a literal's pointer.
fn constStringFoldEnabled(): bool {
  return envOr("BIT_CONST_STRING_FOLD", "1") != "0"
}

// #6435: the `const_string` each value provably holds, or -1. A literal holds
// itself; a block param holds `c` when every edge into it passes `c` or a
// param that itself holds `c`. `markConstStringLens` below and the rebuild's
// `emitStaticHeaderRead` (optrebuild.bit) read it.
//
// OPTIMISTIC, unlike `markConstParams`, because the shape it exists for is a
// loop: `lowerWhile` threads a literal local through the header and back round
// the join and increment blocks, so the back edge passes a param this walk has
// not decided yet. Such an edge is skipped (`strUndecided`) rather than
// poisoning the param. Sound by the trivial-phi argument `bceParamSource`
// (optbce.bit) spells out: a value is passed only from a block its definition
// dominates, so the first run-time entry to any param arrives from an edge
// whose argument is already assigned, and by induction a param still
// undecided at the fixpoint is never assigned at all. Literals are matched by
// value id, never by text.
//
// Bounded: a param only moves down `strUndecided -> c -> -1`, each productive
// round moves at least one, so there are at most `2 * len(f.instrs)` of them.
fn constStringSources(f: IrFunc): []int {
  let src = []int(0)
  let on = constStringFoldEnabled()
  let i = 0
  while (i < len(f.instrs)) {
    src = append(src, -1)
    if (on && f.instrs[i].op == Op.ConstString) {
      src[i] = i
    }
    i = i + 1
  }
  if (!on || !hasNonEntryParams(f)) {
    return src
  }
  return strSourceSolve(f, src)
}

// Resolves every non-entry block param in `src` to the one ConstString all
// its incoming edges carry, or -1.
fn strSourceSolve(f: IrFunc, src: []int): []int {
  let b = 1
  while (b < len(f.blocks)) {
    let j = 0
    while (j < f.blocks[b].paramCount) {
      src[f.blocks[b].instsStart + j] = strUndecided
      j = j + 1
    }
    b = b + 1
  }
  let rounds = 0
  while (rounds <= 2 * len(f.instrs) && strSourceRound(f, src)) {
    rounds = rounds + 1
  }
  let i = 0
  while (i < len(src)) {
    if (src[i] == strUndecided) {
      src[i] = -1
    }
    i = i + 1
  }
  return src
}

// A param no edge has given a value yet: the optimistic top of the lattice.
const strUndecided: int = -2

// One pass over every edge in `f`. Returns whether any param moved.
fn strSourceRound(f: IrFunc, src: []int): bool {
  let changed = false
  let b = 0
  while (b < len(f.blocks)) {
    let blk = f.blocks[b]
    if (blk.instsLen > 0) {
      let t = f.instrs[blk.instsStart + blk.instsLen - 1]
      if (t.op == Op.Jump) {
        changed = strSourceEdge(f, src, t.ival, t.args) || changed
      } else if (t.op == Op.Br) {
        changed = strSourceEdge(f, src, t.ival, t.thenArgs) || changed
        changed = strSourceEdge(f, src, t.ival2, t.elseArgs) || changed
      }
    }
    b = b + 1
  }
  return changed
}

// Meets one edge's arguments into `target`'s params. An argument list shorter
// than the block's params is malformed IR (verify.bit); the missing ones read
// as -1 rather than past the end.
fn strSourceEdge(f: IrFunc, src: []int, target: int, args: []int): bool {
  let blk = f.blocks[target]
  let changed = false
  let k = 0
  while (k < blk.paramCount) {
    let p = blk.instsStart + k
    let v = -1
    if (k < len(args)) {
      v = src[args[k]]
    }
    if (v != strUndecided && src[p] != -1 && src[p] != v) {
      src[p] = strMeet(src[p], v)
      changed = true
    }
    k = k + 1
  }
  return changed
}

fn strMeet(cur: int, v: int): int {
  if (cur == strUndecided) {
    return v
  }
  return -1
}

// The `len` word of a string header (runtime/ABI.md §2.3).
const strLenWord: int = 8

// #6435: `len` of a value that only ever holds one string literal is that
// literal's byte count. A literal's header is static (`__bitstr_N`) and a
// string is immutable (SPEC §5.3), so nothing can move it at run time. Runs
// ahead of `sweepConsts` (opt.bit), so the compares reading it fold in the
// same sweep. #6459: the same word read as `field_get [8]`, which is how a
// literal passed as an exploded string argument reads it; `src` resolves only
// string values, so offset 8 is always that word.
fn markConstStringLens(f: IrFunc, src: []int, known: []ConstVal) {
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (readsStrLen(ins) && src[ins.lhs] >= 0) {
      known[i] = intConst(len(f.instrs[src[ins.lhs]].sval))
    }
    i = i + 1
  }
}

fn readsStrLen(ins: IrInstr): bool {
  return ins.op == Op.SliceLen || (ins.op == Op.FieldGet && ins.ival == strLenWord)
}
