// Self-host: arity/type validation for the four VOID-typed predeclared
// builtins (#6084, split out of validatecall.bit to keep both files under
// the 800-line lint limit). Same module as validatecall.bit, so this needs
// no imports and no call-site changes.

// #6084: `delete`/`close`/`panic`/`assert` are `builtinReturnsVoid`
// (checktype.bit) — their call expressions type as `()` REGARDLESS OF
// ARGUMENTS — and `runtimeBuiltinArity` (validatecall.bit) answers -1 for
// all four (they are not `bit_rt_*` runtime primitives; `map_delete`/
// `chan_close`/`panic`/`assert` are dedicated `Op.RtCall`s
// `lowerCallIdentOps3`/`Ops4` (lowercallident.bit) build by hand), so before
// this a call to any of the four with any arity and any argument types
// typechecked clean with zero diagnostics whenever the call site had not
// imported a same-named symbol — `vCall`'s own PRECEDENCE comment
// (validatecall.bit) already routes an explicit import to the declaration
// path above `vCallResolveBuiltin`, so these four run only for the
// genuinely bare, unimported name. Permissive on an inference gap or
// `vMentionsInvalid`, matching every other rule in validatecall.bit, so a
// program bit2 cannot yet type never gets a false positive here.
fn vDeleteCall(c: Checker, node: int, argList: int) {
  let args = kidsOf(c.tree, argList)
  if (len(args) != 2) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "'delete' takes exactly 2 arguments, found ${len(args)}",
    )
    return
  }
  let m = args[0]
  if (getNode(c.tree, m).tag == Tag.Arg) {
    m = kidsOf(c.tree, m)[0]
  }
  let mt = checkExprType(c, m)
  if (mt == 0 || vMentionsInvalid(c, mt, 0)) {
    return
  }
  let dt = defaultType(c, mt)
  if (c.ctx.types[dt].kind != TypeKind.Map) {
    reportNoHint(
      c.diags, ecInvalidOperand, vSpan(c, m),
      "'delete' requires a map as its first argument, found '${typeName(c.ctx, dt)}'",
    )
    return
  }
  let k = args[1]
  if (getNode(c.tree, k).tag == Tag.Arg) {
    k = kidsOf(c.tree, k)[0]
  }
  let kt = checkExprType(c, k)
  if (kt == 0 || vMentionsInvalid(c, kt, 0)) {
    return
  }
  vExpect(c, k, kt, c.ctx.types[dt].mapKey)
}

// `close(c)` (§16.2) — see `vDeleteCall`'s header comment for why this rule
// exists at all.
fn vCloseCall(c: Checker, node: int, argList: int) {
  let args = kidsOf(c.tree, argList)
  if (len(args) != 1) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "'close' takes exactly 1 argument, found ${len(args)}",
    )
    return
  }
  let a = args[0]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  let t = checkExprType(c, a)
  if (t == 0 || vMentionsInvalid(c, t, 0)) {
    return
  }
  let dt = defaultType(c, t)
  if (c.ctx.types[dt].kind != TypeKind.Chan) {
    reportNoHint(
      c.diags, ecInvalidOperand, vSpan(c, a),
      "'close' requires a channel, found '${typeName(c.ctx, dt)}'",
    )
  }
}

// `panic(msg)` (§18.4): the runtime signature is frozen at `(msg: string)`
// (ABI.md §12, `bit_rt_panic`) — see `vDeleteCall`'s header comment for why
// this rule exists at all.
fn vPanicCall(c: Checker, node: int, argList: int) {
  let args = kidsOf(c.tree, argList)
  if (len(args) != 1) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "'panic' takes exactly 1 argument, found ${len(args)}",
    )
    return
  }
  let a = args[0]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  let t = checkExprType(c, a)
  if (t == 0 || vMentionsInvalid(c, t, 0)) {
    return
  }
  vExpect(c, a, t, primType(c.ctx, 11))
}

// `assert(cond)` / `assert(cond, msg)` (§18.4): the runtime signature is
// frozen at `(cond: bool, msg: string)` (ABI.md §12, `bit_rt_assert`) —
// `lowerCallIdentOps3` (lowercallident.bit) supplies the default message
// when the source form omits it. See `vDeleteCall`'s header comment for why
// this rule exists at all.
fn vAssertCall(c: Checker, node: int, argList: int) {
  let args = kidsOf(c.tree, argList)
  let got = len(args)
  if (got != 1 && got != 2) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "'assert' takes 1 or 2 arguments, found ${got}",
    )
    return
  }
  let cond = args[0]
  if (getNode(c.tree, cond).tag == Tag.Arg) {
    cond = kidsOf(c.tree, cond)[0]
  }
  let ct = checkExprType(c, cond)
  if (ct != 0 && !vMentionsInvalid(c, ct, 0)) {
    vExpect(c, cond, ct, primType(c.ctx, 10))
  }
  if (got != 2) {
    return
  }
  let msg = args[1]
  if (getNode(c.tree, msg).tag == Tag.Arg) {
    msg = kidsOf(c.tree, msg)[0]
  }
  let mt = checkExprType(c, msg)
  if (mt != 0 && !vMentionsInvalid(c, mt, 0)) {
    vExpect(c, msg, mt, primType(c.ctx, 11))
  }
}

// Dispatches the four fixed-arity builtins whose arity/type rule lives above
// (`vDeleteCall`/`vCloseCall`/`vPanicCall`/`vAssertCall`) — called from
// `vCallResolveBuiltin` (validatecall.bit) rather than inlined there, so
// adding the four did not push that function's own McCabe complexity past
// spec/LINT.md's E0204 ceiling. True when `name` matched and the call was
// handled (`vCallResolveBuiltin` returns immediately either way); false for
// every other builtin name.
fn vCallBuiltinFixedArg(c: Checker, node: int, name: string, argList: int): bool {
  if (name == "delete") {
    vDeleteCall(c, node, argList)
    return true
  }
  if (name == "close") {
    vCloseCall(c, node, argList)
    return true
  }
  if (name == "panic") {
    vPanicCall(c, node, argList)
    return true
  }
  if (name == "assert") {
    vAssertCall(c, node, argList)
    return true
  }
  return false
}
