// #5965: every `call_iface` site's inline cache cell (runtime/ABI.md §2.1).
//
// A site's hit path compares the receiver's `info` with the cell's and calls
// the cell's code address; only a miss reaches `bit_rt_iface_lookup_ic`. The
// cell is a writable, zero-initialised 16-byte global `{info, fn}`, one per
// site, named after its function so the name is unique program-wide and
// travels with the instruction in `ins.name` (unused by `Op.CallIface`
// otherwise). Assigned at emission, after every IR pass, so no later
// rewrite can duplicate or drop a site, and idempotently, because an emitter
// may be handed the same module twice.

const icCellBytes = 16

// Names and registers the cell of every `Op.CallIface` in `module` that has
// none yet. A cell belongs to its function's object (`inRootModule`), so a
// freestanding build defines exactly the cells its own code references.
fn assignIfaceCaches(module: IrModule) {
  let fi = 0
  while (fi < len(module.funcs)) {
    assignFuncIfaceCaches(module, module.funcs[fi])
    fi = fi + 1
  }
}

fn assignFuncIfaceCaches(module: IrModule, f: IrFunc) {
  let k = 0
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.CallIface) {
      if (ins.name == "") {
        ins.name = "${f.name}$ic${k}"
        module.globals = append(
          module.globals,
          IrGlobal{
            name = ins.name, bytes = []int(icCellBytes), align = 8, storage = 0,
            relocs = []IrGlobalReloc(0), inRootModule = f.inRootModule,
          },
        )
      }
      k = k + 1
    }
    i = i + 1
  }
}
