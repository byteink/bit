// compiler/classtabledefaultid.bit — #6269 (`data-packages-dx.md`,
// epic #6253): a field named `id` is a `@table` class's primary key when no
// field carries `@id` explicitly. Sibling of classtabledesc.bit, same
// module (split out to stay under the 800-line ceiling, not a pure move —
// this function is new).
//
// When no field of the class already carries an explicit `@id` (checked
// against `TableField.attrs`'s own RESOLVED list, the same one
// `hasIdAttr` (pkg/orm/write.bit) reads at runtime — never a second,
// syntactic re-derivation of `collectRecordedAttrs`'s call/record
// resolution, `classtabledesc.bit`'s own header explains why `@id` is
// always recorded rather than called), a field literally named `id`
// becomes the primary key: `applyDefaultIdField` synthesizes the identical
// `RecordedAttr{name="id"}` a hand-written `@id` on that field would have
// produced, reusing the field's OWN name node as the synthesized
// attribute's name node — its source text already reads "id", exactly
// what a real `@id` mark's own name node would read, so no fresh
// `SynthText`-backed node is needed (`buildTableClass`, classtabledesc.bit,
// runs before `st` exists, `classtablerow.bit`'s own header). A composite
// key (more than one explicit `@id` field, #5084) is unaffected: the check
// below is PRESENCE, not count, so it never runs once any field carries
// one — `@id` still overrides, on one field or several.

fn applyDefaultIdField(tree: Tree, source: string, fields: []TableField): []TableField {
  for f of fields {
    for a of f.attrs {
      if (identText(tree, source, a.nameNode) == "id") {
        return fields
      }
    }
  }
  let out = []TableField(0)
  for f of fields {
    if (identText(tree, source, f.nameNode) != "id") {
      out = append(out, f)
      continue
    }
    out = append(
      out,
      TableField{
        nameNode = f.nameNode,
        typeNode = f.typeNode,
        attrs = append(f.attrs, RecordedAttr{ nameNode = f.nameNode, args = []int(0) }),
      },
    )
  }
  return out
}
