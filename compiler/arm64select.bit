// Self-host Stage 3 (#1342): ARM64 operand fetch/store helpers and instruction
// selection, split out of arm64.bit (#1503). Sibling .bit file, same module:
// see arm64.bit for the backend overview.

// ===========================================================================
// Operand fetch/store helpers
//
// Every selector reads its operands into registers, computes there, then writes
// the result out — getInt/putInt (and the float pair) hide whether a vreg landed
// in a register or a spill slot.
// ===========================================================================

fn regLocOf(cx: A64Ctx, vreg: int): RegLoc {
  return cx.result.locations[vreg]
}

fn getInt(cx: A64Ctx, vreg: int, scratch: int): int {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    loadImm(cx.code, scratch, regSp(), spillOffset(cx.frame, loc.index), 8, false)
    return scratch
  }
  return cx.intRegs[loc.index]
}

fn putInt(cx: A64Ctx, vreg: int, src: int) {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    storeImm(cx.code, src, regSp(), spillOffset(cx.frame, loc.index), 8)
    return
  }
  movRR(cx.code, cx.intRegs[loc.index], src)
}

fn getFloat(cx: A64Ctx, vreg: int, scratch: int): int {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    loadImmF(cx.code, scratch, regSp(), spillOffset(cx.frame, loc.index), 8)
    return scratch
  }
  return cx.floatRegs[loc.index]
}

fn putFloat(cx: A64Ctx, vreg: int, src: int) {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    storeImmF(cx.code, src, regSp(), spillOffset(cx.frame, loc.index), 8)
    return
  }
  fmovFF(cx.code, cx.floatRegs[loc.index], src, 8)
}

// The register a selector may compute its result directly into: the
// destination's own allocated register when it has one, else `fallback` (a
// scratch), since a spilled destination has to be stored out of some register
// anyway. Computing there makes the trailing `putInt`/`putFloat` a self-move,
// which `movRR`/`fmovFF` already drop — so the rename disappears with no
// peephole over emitted bytes and no change to the IR (#1852).
//
// LEGAL ONLY when the sequence's FIRST write of the destination happens no
// earlier than its LAST read of an operand. The allocator frees a destination's
// register at its def point, so the only value that register can still hold is
// an operand dying at this very instruction — which a read-then-write
// instruction consumes before clobbering it. Two shapes violate that and keep
// computing in scratch on purpose:
//   * `emitHeaderWordOrZero` zeroes its target BEFORE the `cbz`/`ldr` pair reads
//     `baseReg` (its own comment turns on scratch1 never aliasing baseReg), so
//     slice_len and the cap(s) field_get stay as they were;
//   * the atomic LL/SC loops re-read `base`/`oper` on every retry, after the
//     loop body has written its result register.
fn destInt(cx: A64Ctx, vreg: int, fallback: int): int {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    return fallback
  }
  return cx.intRegs[loc.index]
}

fn destFloat(cx: A64Ctx, vreg: int, fallback: int): int {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    return fallback
  }
  return cx.floatRegs[loc.index]
}

fn plocOf(cx: A64Ctx, vreg: int, class: RegClass): PLoc {
  let loc = regLocOf(cx, vreg)
  if (loc.isSpill) {
    return plocMem(spillOffset(cx.frame, loc.index))
  }
  if (class == RegClass.Int) {
    return plocReg(cx.intRegs[loc.index])
  }
  return plocReg(cx.floatRegs[loc.index])
}

fn vregOf(cx: A64Ctx, v: int): int {
  return cx.instToVreg[v]
}

// ===========================================================================
// Instruction selection
//
// Every selector reads its operands into registers, computes there, then writes
// the result out. The scratch registers are never allocatable, so a selector may
// clobber them freely between a get and its put.
// ===========================================================================

enum LogicOp {
  And,
  Orr,
  Eor,
}

fn logicalOpc(op: LogicOp): int {
  if (op == LogicOp.And) {
    return 0
  }
  if (op == LogicOp.Orr) {
    return 1
  }
  return 2 // Eor
}

enum FArithOp {
  Add,
  Sub,
  Mul,
  Div,
}

fn fArithOpcode(op: FArithOp): int {
  if (op == FArithOp.Mul) {
    return 0
  }
  if (op == FArithOp.Div) {
    return 1
  }
  if (op == FArithOp.Add) {
    return 2
  }
  return 3 // Sub
}

// Re-represent `src`'s low `width` bytes as a full 64-bit value in `dst`: SBFM
// (signed) or UBFM (unsigned), the SXTB/UXTB/... family. Width 8 is a plain move.
fn extendRegA(code: ByteBuf, dst: int, src: int, width: int, signed: bool) {
  let opc = 2 // UBFM
  if (signed) {
    opc = 0 // SBFM
  }
  if (width == 1) {
    bitfieldImm(code, opc, dst, src, 0, 7)
    return
  }
  if (width == 2) {
    bitfieldImm(code, opc, dst, src, 0, 15)
    return
  }
  if (width == 4) {
    bitfieldImm(code, opc, dst, src, 0, 31)
    return
  }
  if (dst != src) {
    movRR(code, dst, src)
  }
}

// Re-narrow a freshly-computed result in `reg` to its type width, restoring the
// width-canonical invariant: every value in a register is its true value
// sign/zero-extended to 64 bits, so a narrow compare or store needs no fixup. A
// no-op for the 64-bit and non-int classes.
fn canonNarrow(code: ByteBuf, reg: int, w: Width) {
  if (w.class == RegClass.Int && w.bytes < 8) {
    extendRegA(code, reg, reg, w.bytes, w.signed)
  }
}

fn emitBinaryInt(cx: A64Ctx, op: Op, dst: int, lhs: int, rhs: int, w: Width) {
  let l = getInt(cx, vregOf(cx, lhs), scratch1())
  let r = getInt(cx, vregOf(cx, rhs), scratch2())
  let d = destInt(cx, dst, scratch1())
  if (op == Op.Add) {
    addRR(cx.code, d, l, r)
  } else if (op == Op.Sub) {
    subRR(cx.code, d, l, r)
  } else if (op == Op.BAnd) {
    logicalRR(cx.code, logicalOpc(LogicOp.And), d, l, r)
  } else if (op == Op.BOr) {
    logicalRR(cx.code, logicalOpc(LogicOp.Orr), d, l, r)
  } else {
    assert(op == Op.BXor)
    logicalRR(cx.code, logicalOpc(LogicOp.Eor), d, l, r)
  }
  // add/sub can overflow past the type width; the bitwise ops preserve canonical
  // operands, so they need no re-narrowing.
  if (op == Op.Add || op == Op.Sub) {
    canonNarrow(cx.code, d, w)
  }
  putInt(cx, dst, d)
}

fn emitMulInt(cx: A64Ctx, dst: int, lhs: int, rhs: int, w: Width) {
  let l = getInt(cx, vregOf(cx, lhs), scratch1())
  let r = getInt(cx, vregOf(cx, rhs), scratch2())
  let d = destInt(cx, dst, scratch1())
  mulRR(cx.code, d, l, r)
  canonNarrow(cx.code, d, w)
  putInt(cx, dst, d)
}

// `w` is the RESULT width: signed division is the one narrow op division can
// push past its type width (INT_MIN / -1 — e.g. i32(-2147483648) / i32(-1)
// mathematically yields 2147483648, unrepresentable in i32), because operands
// live sign-extended in full 64-bit registers (module doc comment above) so
// the 64-bit `sdiv` never itself overflows or traps; it just leaves a result
// outside the declared width that must be re-narrowed like every other
// width-breaking op (#2263).
fn emitDivInt(cx: A64Ctx, op: Op, dst: int, lhs: int, rhs: int, w: Width) {
  let l = getInt(cx, vregOf(cx, lhs), scratch1())
  let r = getInt(cx, vregOf(cx, rhs), scratch2())
  // #2016: a zero divisor to `/` or `%` panics (SPEC §13.5, §18.4) rather than
  // silently returning 0/lhs. The compile-time power-of-two fast path needs no
  // check — its divisor is proven non-zero at compile time by construction
  // (ABI.md §12.1). `cmpZero`/`emitLocalCondBranch` (not `emitCbnz`, which
  // tests only the low 32 bits — fine for the STXR status word it exists for,
  // wrong for a 64-bit divisor) so a divisor like 0x100000000 is never
  // misread as zero.
  cmpZero(cx.code, r)
  let dzFixup = emitLocalCondBranch(cx, condNe()) // divisor != 0 -> skip the panic call
  emitCallReloc(cx, "bit_rt_panic_div_zero")
  patchLocalCondBranch(cx, dzFixup)
  let signed = op == Op.SDiv || op == Op.SRem
  let isRem = op == Op.SRem || op == Op.URem
  // `rem` recovers its result with `msub dst = l - q*r`, so it still needs `l`
  // (and `r`) after the divide. `l` aliases scratch1 whenever it was spilled and
  // reloaded there, so writing the quotient to the result register would clobber
  // `l` before msub reads it (yielding q*(1-r)) — a spilled destination makes
  // `d` scratch1 too, so the hazard survives destination-driven selection.
  // Divide into scratch3 — never allocatable, never `d`, and unused on this
  // path — so `l` survives. A plain divide has no later use of `l`, so it
  // divides straight into `d`.
  let d = destInt(cx, dst, scratch1())
  let q = d
  if (isRem) {
    q = scratch3()
  }
  if (signed) {
    sdivRR(cx.code, q, l, r)
  } else {
    udivRR(cx.code, q, l, r)
  }
  if (isRem) {
    msubRR(cx.code, d, q, r, l)
  }
  canonNarrow(cx.code, d, w)
  putInt(cx, dst, d)
}

fn emitUnaryInt(cx: A64Ctx, op: Op, dst: int, operand: int, w: Width) {
  let v = getInt(cx, vregOf(cx, operand), scratch1())
  let d = destInt(cx, dst, scratch1())
  if (op == Op.Neg) {
    negR(cx.code, d, v) // two's-complement negate sets high bits
  } else {
    assert(op == Op.BNot)
    mvnR(cx.code, d, v) // bitwise-not sets every bit above width
  }
  canonNarrow(cx.code, d, w)
  putInt(cx, dst, d)
}

// `T(x)` numeric conversion (SPEC §12.9). Int operands are canonicalized to their
// true 64-bit value from the source width, then to the destination width
// (SBFM/UBFM); int<->float uses SCVTF / FCVTZS (truncating), float<->float uses
// FCVT. (Unsigned 64-bit <-> float takes the signed path — a value with bit 63
// set is out of range, a v1 limit.)
fn emitConvert(cx: A64Ctx, dst: int, src: int, dstTy: int) {
  let sw = widthOf(cx.module.ctx, cx.f.instrs[src].ty)
  let dw = widthOf(cx.module.ctx, dstTy)
  if (sw.class == RegClass.Int && dw.class == RegClass.Int) {
    let r = getInt(cx, vregOf(cx, src), scratch1())
    let d = destInt(cx, dst, scratch1())
    extendRegA(cx.code, d, r, sw.bytes, sw.signed)
    extendRegA(cx.code, d, d, dw.bytes, dw.signed)
    putInt(cx, dst, d)
    return
  }
  if (sw.class == RegClass.Int && dw.class == RegClass.Float) {
    // The widening stays in the INT scratch: `d` is a float register here, so it
    // cannot hold the intermediate.
    let r = getInt(cx, vregOf(cx, src), scratch1())
    let d = destFloat(cx, dst, fscratch1())
    extendRegA(cx.code, scratch1(), r, sw.bytes, sw.signed)
    fpIntConv(cx.code, true, dw.bytes, 0, 2, scratch1(), d) // SCVTF
    putFloat(cx, dst, d)
    return
  }
  if (sw.class == RegClass.Float && dw.class == RegClass.Int) {
    let x = getFloat(cx, vregOf(cx, src), fscratch1())
    let d = destInt(cx, dst, scratch1())
    fpIntConv(cx.code, true, sw.bytes, 3, 0, x, d) // FCVTZS
    extendRegA(cx.code, d, d, dw.bytes, dw.signed)
    putInt(cx, dst, d)
    return
  }
  // float -> float, always differing widths (same-type is filtered in lowering).
  let x = getFloat(cx, vregOf(cx, src), fscratch1())
  let d = destFloat(cx, dst, fscratch1())
  let opcode = 4 // FCVT to single
  if (dw.bytes == 8) {
    opcode = 5 // FCVT to double
  }
  fp1Source(cx.code, opcode, sw.bytes, d, x)
  putFloat(cx, dst, d)
}

// Peeks whether `v` is a const_int instruction, returning its value masked to a
// valid 0-63 shift count when so, or -1 when it is not (no negative shift count
// exists, so the sentinel is unambiguous).
fn constShiftAmount(f: IrFunc, v: int): int {
  if (f.instrs[v].op != Op.ConstInt) {
    return -1
  }
  return f.instrs[v].ival & 63
}

fn emitShiftInt(cx: A64Ctx, op: Op, dst: int, lhs: int, rhs: int, w: Width) {
  let l = getInt(cx, vregOf(cx, lhs), scratch1())
  let amt = constShiftAmount(cx.f, rhs)
  let d = destInt(cx, dst, scratch1())
  if (amt >= 0) {
    if (op == Op.Shl) {
      lslImm(cx.code, d, l, amt)
    } else if (op == Op.LShr) {
      lsrImm(cx.code, d, l, amt)
    } else {
      assert(op == Op.AShr)
      asrImm(cx.code, d, l, amt)
    }
  } else {
    let r = getInt(cx, vregOf(cx, rhs), scratch2())
    if (op == Op.Shl) {
      lslvRR(cx.code, d, l, r)
    } else if (op == Op.LShr) {
      lsrvRR(cx.code, d, l, r)
    } else {
      assert(op == Op.AShr)
      asrvRR(cx.code, d, l, r)
    }
  }
  // Only shl pushes bits past the type width; lshr/ashr keep a canonical operand
  // canonical, so a full-width right shift needs no re-narrowing.
  if (op == Op.Shl) {
    canonNarrow(cx.code, d, w)
  }
  putInt(cx, dst, d)
}

fn icmpCond(op: Op): int {
  if (op == Op.ICmpEq) { return condEq() }
  if (op == Op.ICmpNe) { return condNe() }
  if (op == Op.ICmpSlt) { return condLt() }
  if (op == Op.ICmpSle) { return condLe() }
  if (op == Op.ICmpSgt) { return condGt() }
  if (op == Op.ICmpSge) { return condGe() }
  if (op == Op.ICmpUlt) { return condCc() }
  if (op == Op.ICmpUle) { return condLs() }
  if (op == Op.ICmpUgt) { return condHi() }
  assert(op == Op.ICmpUge)
  return condCs()
}

fn emitIcmp(cx: A64Ctx, op: Op, dst: int, lhs: int, rhs: int) {
  let l = getInt(cx, vregOf(cx, lhs), scratch1())
  let r = getInt(cx, vregOf(cx, rhs), scratch2())
  // `cset` reads only NZCV, and the `cmp` that sets them has already consumed
  // both operands, so writing the destination here cannot clobber a live read.
  let d = destInt(cx, dst, scratch1())
  cmpRR(cx.code, l, r)
  cset(cx.code, d, icmpCond(op))
  putInt(cx, dst, d)
}

// AArch64's FCMP sets NZCV such that the *plain* EQ/NE/GT/GE condition codes are
// already correct for IEEE-754 ordered comparisons (false on any NaN, except NE
// which is true) — but "less than" and "less than or equal" are NOT LT/LE (those
// would be true on an unordered NaN compare, an ARM-specific gotcha every AArch64
// backend must special-case): use MI and LS instead. Same mapping LLVM's AArch64
// backend uses.
fn fcmpCond(op: Op): int {
  if (op == Op.FCmpEq) { return condEq() }
  if (op == Op.FCmpNe) { return condNe() }
  if (op == Op.FCmpGt) { return condGt() }
  if (op == Op.FCmpGe) { return condGe() }
  if (op == Op.FCmpLt) { return condMi() }
  assert(op == Op.FCmpLe)
  return condLs()
}

fn emitFcmp(cx: A64Ctx, op: Op, dst: int, lhs: int, rhs: int, width: int) {
  let l = getFloat(cx, vregOf(cx, lhs), fscratch1())
  let r = getFloat(cx, vregOf(cx, rhs), fscratch2())
  // Int destination, float operands: no aliasing is even possible across the
  // two register files, and `fcmp` has consumed both before `cset` writes.
  let d = destInt(cx, dst, scratch1())
  fcmp(cx.code, l, r, width)
  cset(cx.code, d, fcmpCond(op))
  putInt(cx, dst, d)
}

fn emitBinaryFloat(cx: A64Ctx, op: FArithOp, dst: int, lhs: int, rhs: int, width: int) {
  let l = getFloat(cx, vregOf(cx, lhs), fscratch1())
  let r = getFloat(cx, vregOf(cx, rhs), fscratch2())
  let d = destFloat(cx, dst, fscratch1())
  fArithRR(cx.code, fArithOpcode(op), d, l, r, width)
  putFloat(cx, dst, d)
}

fn emitFneg(cx: A64Ctx, dst: int, operand: int, width: int) {
  let v = getFloat(cx, vregOf(cx, operand), fscratch1())
  let d = destFloat(cx, dst, fscratch1())
  fnegF(cx.code, d, v, width)
  putFloat(cx, dst, d)
}

// `fsqrt(x)` — one instruction, no call.
fn emitFsqrt(cx: A64Ctx, dst: int, operand: int, width: int) {
  let v = getFloat(cx, vregOf(cx, operand), fscratch1())
  let d = destFloat(cx, dst, fscratch1())
  fsqrtF(cx.code, d, v, width)
  putFloat(cx, dst, d)
}

// `ffloor`/`fceil`/`ftrunc`/`fround` — one FRINT each. See `frintF` for why
// `fround` is FRINTA and not FRINTN.
fn emitFRound(cx: A64Ctx, dst: int, operand: int, width: int, opcode: int) {
  let v = getFloat(cx, vregOf(cx, operand), fscratch1())
  let d = destFloat(cx, dst, fscratch1())
  frintF(cx.code, opcode, d, v, width)
  putFloat(cx, dst, d)
}

// A register-class transfer, not a conversion: FMOV moves the bits verbatim in
// whichever direction the result type asks for. Float -> int is `floatBits`/
// `float32Bits`; int -> float is the read half of the container word ABI, which
// turns the `u64` a runtime primitive hands back in x0 into the `f64`/`f32` the
// element is. `width` is the FLOAT side's width in both directions. FMOV Wd, Sn
// writes the 32-bit W view, which zero-extends into X.
fn emitBitcast(cx: A64Ctx, dst: int, operand: int, width: int, dstIsFloat: bool) {
  if (dstIsFloat) {
    let iv = getInt(cx, vregOf(cx, operand), scratch1())
    let d = destFloat(cx, dst, fscratch1())
    fmovToFp(cx.code, d, iv, width)
    putFloat(cx, dst, d)
    return
  }
  let v = getFloat(cx, vregOf(cx, operand), fscratch1())
  let d = destInt(cx, dst, scratch1())
  fmovFromFp(cx.code, d, v, width)
  putInt(cx, dst, d)
}

// The constant materializers have no operands at all, so the destination is
// unconditionally safe to write into: `movImm64`'s MOVZ/MOVK chain only ever
// writes its target.
fn emitConstInt(cx: A64Ctx, dst: int, val: int) {
  let d = destInt(cx, dst, scratch1())
  movImm64(cx.code, d, val)
  putInt(cx, dst, d)
}

fn emitConstBool(cx: A64Ctx, dst: int, val: bool) {
  let v = 0
  if (val) {
    v = 1
  }
  let d = destInt(cx, dst, scratch1())
  movImm64(cx.code, d, v)
  putInt(cx, dst, d)
}

fn emitConstNil(cx: A64Ctx, dst: int) {
  let d = destInt(cx, dst, scratch1())
  movImm64(cx.code, d, 0)
  putInt(cx, dst, d)
}

// A float constant has no wide-immediate form: materialize its bit pattern in a
// GPR and move that across to the FP register file. floatBits/float32Bits are
// runtime primitives because Bit has no bitcast and its numeric conversions
// truncate; float32Bits also does the f64 -> f32 rounding, which cannot be
// derived from the f64 bits by arithmetic.
fn emitConstFloat(cx: A64Ctx, dst: int, val: f64, width: int) {
  // The bit pattern stays in the int scratch — `d` is a float register.
  let d = destFloat(cx, dst, fscratch1())
  if (width == 8) {
    movImm64(cx.code, scratch1(), i64(floatBits(val)))
    fmovToFp(cx.code, d, scratch1(), 8)
  } else {
    movImm64(cx.code, scratch1(), i64(u64(float32Bits(f32(val)))))
    fmovToFp(cx.code, d, scratch1(), 4)
  }
  putFloat(cx, dst, d)
}

// A const_string value is the address of its static {ptr,len} header
// (__bitstr_N, materialized by the object writer + linker into .rodata); loads
// that address into the destination via the ADRP/ADD pair.
fn emitConstString(cx: A64Ctx, dst: int, poolIdx: int) {
  let d = destInt(cx, dst, scratch1())
  emitAddrOf(cx, d, "__bitstr_${poolIdx}")
  putInt(cx, dst, d)
}

// slice_len reads the `len` word from a slice or string header. A []T header is
// {ptr, len, cap, is_ref} and a string header is {ptr, len} (ABI.md §2) — both
// keep `len` at offset 8, so one load serves both. `len` on a static [N]T array
// folds to a const_int in lowering, and dynamic slice indexing goes through the
// slice_get/_set runtime calls, so this op only ever loads a header length.
// Loads a slice/string header word at `disp`, reading a NULL header as 0 (#1564).
//
// A struct zero-value is one gc_alloc of zeroed memory (SPEC §13.4), so a slice
// or string FIELD of a zeroed struct holds the null word rather than an empty
// header. `xs == nil` is not spellable for either type (E0053), so null and
// empty are indistinguishable to a program — only the fault was observable.
// Both header readers that are inline rather than runtime calls (`len` at +8,
// `cap` at +24) come through here, so the guard leaves every IR dump untouched.
// scratch1 is never allocatable, so it cannot alias baseReg — zeroing it before
// the null test reads baseReg is safe.
fn emitHeaderWordOrZero(cx: A64Ctx, baseReg: int, disp: int) {
  movImm64(cx.code, scratch1(), 0)
  cbz(cx.code, baseReg, 2) // null header -> skip the single-word load
  loadImm(cx.code, scratch1(), baseReg, disp, 8, false)
}

fn emitSliceLen(cx: A64Ctx, dst: int, base: int) {
  let baseReg = getInt(cx, vregOf(cx, base), scratch2())
  emitHeaderWordOrZero(cx, baseReg, 8)
  putInt(cx, dst, scratch1())
}

// `isSliceBase` comes from the dispatcher for the same reason as the x86-64
// selector's: the selector must not reach back into `cx.f.instrs`, which a stub
// self-check context leaves empty.
fn emitFieldGet(cx: A64Ctx, dst: int, base: int, offset: int, ty: int, isSliceBase: bool) {
  let baseReg = getInt(cx, vregOf(cx, base), scratch2())
  // A fixed-size array field is inline storage: its value is the interior address
  // base + offset (an ADD-immediate), not a loaded word.
  if (cx.module.ctx.types[ty].kind == TypeKind.Array) {
    // `addSubImmWide` reads `rn` only in its first ADD, then chains off its own
    // destination, so `d` aliasing `baseReg` is safe.
    let d = destInt(cx, dst, scratch1())
    addSubImmWide(cx.code, false, d, baseReg, offset)
    putInt(cx, dst, d)
    return
  }
  // cap(s) lowers to a field_get [24] on the slice HEADER itself, so a null
  // header must read as 0 here exactly as it does for len (#1564). Keyed on the
  // base's own type, so a struct field read is untouched and pays nothing.
  if (isSliceBase) {
    emitHeaderWordOrZero(cx, baseReg, offset)
    putInt(cx, dst, scratch1())
    return
  }
  // A far offset materializes into scratch3 first, so both load forms still read
  // `baseReg` before they write `d`.
  let w = widthOf(cx.module.ctx, ty)
  if (w.class == RegClass.Int) {
    let d = destInt(cx, dst, scratch1())
    loadImm(cx.code, d, baseReg, offset, w.bytes, w.signed)
    putInt(cx, dst, d)
    return
  }
  let d = destFloat(cx, dst, fscratch1())
  loadImmF(cx.code, d, baseReg, offset, w.bytes)
  putFloat(cx, dst, d)
}

// ponytail: no write barrier — the runtime's write-barrier contract is not
// settled yet (the collector is stop-the-world, so nothing needs one today). Add
// when the GC goes incremental; same deferral as the x86-64 backend's field_set.
fn emitFieldSet(cx: A64Ctx, base: int, offset: int, value: int, ty: int) {
  let w = widthOf(cx.module.ctx, ty)
  let baseReg = getInt(cx, vregOf(cx, base), scratch2())
  if (w.class == RegClass.Int) {
    storeImm(cx.code, getInt(cx, vregOf(cx, value), scratch1()), baseReg, offset, w.bytes)
    return
  }
  storeImmF(cx.code, getFloat(cx, vregOf(cx, value), fscratch1()), baseReg, offset, w.bytes)
}

// ---- atomics (§11.5) -------------------------------------------------------
// `*T` is an int-classed word; every sequence is call-free (never a safepoint)
// and uses only the codegen scratch GPRs plus ascratch1/ascratch2.

fn emitAtomicLoad(cx: A64Ctx, dst: int, ptr: int, ty: int) {
  let w = widthOf(cx.module.ctx, ty)
  let base = getInt(cx, vregOf(cx, ptr), ascratch1())
  // One LDAR, no retry loop: it consumes `base` as it writes, so unlike the
  // LL/SC sequences below this one can land straight in the destination.
  let d = destInt(cx, dst, scratch1())
  ldar(cx.code, atomicSize(w.bytes), base, d)
  canonNarrow(cx.code, d, w)
  putInt(cx, dst, d)
}

fn emitAtomicStore(cx: A64Ctx, ptr: int, value: int, ty: int) {
  let w = widthOf(cx.module.ctx, ty)
  let base = getInt(cx, vregOf(cx, ptr), ascratch1())
  let val = getInt(cx, vregOf(cx, value), scratch1())
  stlr(cx.code, atomicSize(w.bytes), base, val)
}

// LL/SC retry loop; returns the pre-op (old) value. scratch1=old,
// scratch2=computed, scratch3=STLXR status, ascratch1=base, ascratch2=operand.
fn emitAtomicRmw(cx: A64Ctx, op: Op, dst: int, ptr: int, operand: int, ty: int) {
  let w = widthOf(cx.module.ctx, ty)
  let size = atomicSize(w.bytes)
  let base = getInt(cx, vregOf(cx, ptr), ascratch1())
  let oper = getInt(cx, vregOf(cx, operand), ascratch2())
  let retryOff = codeLen(cx)
  ldaxr(cx.code, size, base, scratch1())
  if (op == Op.AtomicRmwAdd) {
    addRR(cx.code, scratch2(), scratch1(), oper)
  } else if (op == Op.AtomicRmwSub) {
    subRR(cx.code, scratch2(), scratch1(), oper)
  } else if (op == Op.AtomicRmwAnd) {
    logicalRR(cx.code, 0, scratch2(), scratch1(), oper)
  } else if (op == Op.AtomicRmwOr) {
    logicalRR(cx.code, 1, scratch2(), scratch1(), oper)
  } else {
    movRR(cx.code, scratch2(), oper)
  }
  stlxr(cx.code, size, scratch3(), base, scratch2())
  let cbnzOff = codeLen(cx)
  emitCbnz(cx.code, scratch3(), (retryOff - cbnzOff) / 4)
  canonNarrow(cx.code, scratch1(), w)
  putInt(cx, dst, scratch1())
}

// Go-style CAS: swaps `desired` in iff [ptr]==expected; result is the bool "did
// it swap". scratch1=old, scratch2=desired, scratch3=status, ascratch1=base,
// ascratch2=expected.
fn emitAtomicCmpxchg(cx: A64Ctx, dst: int, ptr: int, expected: int, desired: int) {
  let w = widthOf(cx.module.ctx, cx.f.instrs[expected].ty)
  let size = atomicSize(w.bytes)
  let base = getInt(cx, vregOf(cx, ptr), ascratch1())
  let exp = getInt(cx, vregOf(cx, expected), ascratch2())
  let des = getInt(cx, vregOf(cx, desired), scratch2())
  let retryOff = codeLen(cx)
  ldaxr(cx.code, size, base, scratch1())
  canonNarrow(cx.code, scratch1(), w) // match `expected`'s canonical form before the compare
  cmpRR(cx.code, scratch1(), exp)
  let bneFixup = emitLocalCondBranch(cx, condNe())
  stlxr(cx.code, size, scratch3(), base, des)
  let cbnzOff = codeLen(cx)
  emitCbnz(cx.code, scratch3(), (retryOff - cbnzOff) / 4)
  patchLocalCondBranch(cx, bneFixup) // success fall-through and mismatch converge here
  cset(cx.code, scratch1(), condEq()) // Z from the last CMP: set iff old == expected
  putInt(cx, dst, scratch1())
}

// Array element access — lower.bit only ever emits index_get/index_set against a
// static array base, so `base` is always a direct data pointer with no header to
// skip.
fn emitIndexGet(cx: A64Ctx, dst: int, base: int, index: int, ty: int) {
  let w = widthOf(cx.module.ctx, ty)
  let baseReg = getInt(cx, vregOf(cx, base), scratch2())
  let idxReg = getInt(cx, vregOf(cx, index), scratch3())
  if (w.class == RegClass.Int) {
    let d = destInt(cx, dst, scratch1())
    loadIndexed(cx.code, d, baseReg, idxReg, w.bytes, w.signed)
    putInt(cx, dst, d)
    return
  }
  // Float arrays index the same way ints do (register-offset, scaled); no
  // distinct float indexed-load opcode is needed since the addressing mode is
  // class-independent.
  let d = destFloat(cx, dst, fscratch1())
  loadStoreRegOffset(cx.code, fpRegOffSize(w.bytes), true, 1, idxReg, w.bytes != 1,
    baseReg, d)
  putFloat(cx, dst, d)
}

fn emitIndexSet(cx: A64Ctx, base: int, index: int, value: int, ty: int) {
  let w = widthOf(cx.module.ctx, ty)
  let baseReg = getInt(cx, vregOf(cx, base), scratch2())
  let idxReg = getInt(cx, vregOf(cx, index), scratch3())
  if (w.class == RegClass.Int) {
    storeIndexed(cx.code, getInt(cx, vregOf(cx, value), scratch1()), baseReg, idxReg, w.bytes)
    return
  }
  let v = getFloat(cx, vregOf(cx, value), fscratch1())
  loadStoreRegOffset(cx.code, fpRegOffSize(w.bytes), true, 0, idxReg, w.bytes != 1, baseReg, v)
}

// The size field for a float register-offset access: 0b11 for a double, 0b10 for
// a single. (A float is never 1 or 2 bytes wide, so the GP size table's narrow
// rows have no float counterpart.)
fn fpRegOffSize(width: int): int {
  if (width == 8) {
    return 3
  }
  return 2
}
