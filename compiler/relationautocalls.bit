// compiler/relationautocalls.bit — R2 (#6305, epic #6298): extends
// `compiler/relationauto.bit`'s SAME-FUNCTION walk across a function's own
// parameters and return value, solved to a fixed point over the call graph.
// R2b (#6322) widens the fixed point from one module to the WHOLE PROJECT
// and resolves `Tag.NamedArg` calls by matching the argument's own name
// against the callee's declared parameter name (`relationAutoArgExprs`)
// instead of bailing out — the two gaps this file's own R2 header used to
// list as permanently unprovable.
//
// SCOPE, still restricted deliberately (exactly as R1 restricted itself to
// one function): only calls to a NAMED, non-generic free function are ever
// resolved, found via `funcDeclLookup`/`declOwner` (compiler/checklookup.bit,
// check.bit) — the SAME pair `callQualified` (checkaccess.bit) uses to
// qualify a call's own link name, so a call this pass resolves is always one
// lowering will actually emit as a direct call. A call through a METHOD, a
// closure value, or a generic function's own type parameter stays exactly
// as unprovable as it was before this file existed, same as every other gap
// `relationauto.bit`'s own header lists; a variadic parameter (`...xs: T`,
// #6405) is a slice parameter filled by every positional argument past the
// fixed ones and a `...` spread (`relationAutoVariadicArgs`). Nested reads
// (`post.author.posts`, #6318) are left for a later ticket;
// `RelationAutoBinding`'s `paramName` tag and this file's own per-parameter
// summary shape are already dotted-path-ready — a further ticket only needs
// to widen "one relation name" to "one dotted path".
//
// THE FIXED POINT. Per non-generic function IN THE WHOLE PROJECT, a
// summary: for each parameter, the relation names read on it (directly, or
// transitively through a further call this function makes, passing that
// parameter along); and for the return value, either a fixed real query
// call inside this function's own body, or "forwards parameter i"
// untouched. A function's own summary only ever GROWS (a read-name set
// gaining a name, a return going from unresolved to resolved) as OTHER
// functions' summaries improve, never shrinks — so recomputing every
// function's summary from scratch each round, against the current
// (possibly still-incomplete) snapshot of every other function's summary in
// EVERY module, is safe: anything true in an earlier round stays true.
// Bounded (Power of 10) at `#non-generic-functions-in-the-project + 1`
// rounds — a call graph with N nodes cannot need more hops than that for
// information to reach every node — with an explicit assert on top of the
// loop condition. `RelationAutoFuncSummaries.declToIndex` is keyed
// `"${moduleId}:${decl}"` (a decl NODE index only means something inside
// its own tree — the same reason `validateinstchain.bit`'s own instantiation
// ledger key carries a module id), never a bare decl, since two different
// modules' trees can and do reuse the same small node indices.
//
// NESTED READS (#6318) needed NOTHING new in this file: a parameter's own
// `reads: []string` and a return's own `RelationAutoFlow` (now carrying
// `.path`, compiler/relationauto.bit) already treat a recorded name as an
// opaque string — `relationAutoCheckCallArgs` propagates whatever names a
// callee's summary lists, dotted or not, and `relationAutoResolveNamedCall`
// forwards `ret.path` (below) unchanged. Only `RelationAutoReturnSummary`
// itself gained a field, since a function CAN return a nested read directly
// (`fn getAuthor(p: Post): Author { return p.author }`).

// One parameter's own summary: its declared shape (`cls`/`isSlice`,
// `trackable` when the declared type isn't a `@table` class or a slice of
// one) and the relation names this function's own body — or a further call
// it makes, passing this same parameter along — reads on it.
class RelationAutoParamSummary {
  name: string,
  cls: RelationAutoClass,
  isSlice: bool,
  trackable: bool,
  // `...name: T` (#6405): the body binds a `[]T`, and the call's arguments
  // that fill it are not one slot but every positional argument past the fixed
  // parameters plus a final `...spread` (`relationAutoVariadicArgs`).
  variadic: bool,
  reads: []string,
}

// This function's own return value, in terms of what PRODUCED it: a fixed
// query call node inside this function's own body (`queryCall > 0`), or
// this function's own parameter of that name, forwarded untouched
// (`viaParamName != ""`) — never both. `found = false` for every other
// shape (no return, a return this walk cannot resolve at all). Returns that
// DISAGREE (#6373) are `viaParamName = "holder:X:..."`: the function's return
// holder, one writer per `return` (`relationAutoMixedReturn`,
// relationautoreturn.bit). `ownerModule` (R2b, #6322) is the module `queryCall`'s own node
// index belongs to — this function's OWN module, always, since a return
// summary is built by walking this function's own body — carried onward so
// a CALLER in a different module can record a read against the right tree
// (`relationauto.bit`'s `RelationAutoFlow.ownerModule`, same reasoning).
class RelationAutoReturnSummary {
  found: bool,
  queryCall: int,
  viaParamName: string,
  cls: RelationAutoClass,
  isSlice: bool,
  ownerModule: int,
  // Mirrors `RelationAutoFlow.path` (#6318): "" when the return is the
  // query row/parameter itself, or the dotted relation path already walked
  // to reach it (`return p.author` carries `path = "author"`).
  path: string,
}

class RelationAutoFuncSummary {
  decl: int,
  params: []RelationAutoParamSummary,
  ret: RelationAutoReturnSummary,
}

// The WHOLE PROJECT's call-graph table (R2b, #6322 — one module's, before):
// `declToIndex` lets a call site (`funcDeclLookup`/`declOwner`, resolved
// through any module's imports) find its callee's summary in `list` —
// shared, mutable state one `RelationAutoState` (relationauto.bit) points at
// for the whole of one project-wide round. Keyed `"${moduleId}:${decl}"`,
// never a bare decl node — see this file's own header.
class RelationAutoFuncSummaries {
  declToIndex: map<string, int>,
  list: []RelationAutoFuncSummary,
}

fn relationAutoNoReturnSummary(c: Checker): RelationAutoReturnSummary {
  return RelationAutoReturnSummary{
    found = false, queryCall = 0, viaParamName = "",
    cls = RelationAutoClass{ found = false, oc = c, decl = 0, ty = 0 }, isSlice = false,
    ownerModule = c.moduleId, path = "",
  }
}

// `FuncDecl` is `[recv, name, generics, params, result, body, attrs?]`
// (`lintFuncInfo`'s own header, compiler/lintapply.bit) — a generic
// declaration's own parameter CLASS varies per instantiation, which this
// pass's one per-declaration summary cannot represent, so it is walked
// (same-function analysis still applies to it) but never entered into the
// call graph.
fn relationAutoIsNonGeneric(tree: Tree, decl: int): bool {
  return len(kidsOf(tree, kidsOf(tree, decl)[2])) == 0
}

// `c.funcDecls` is NOT exclusively `Tag.FuncDecl` nodes: `collectExternFnDecl`
// (compiler/checkbindfunc.bit) writes an `extern function`'s own
// `Tag.ExternFnDecl` node into the SAME table, under the SAME flat name key,
// with a completely different kid shape (`[name, params, result_or_none]` —
// no generics kid at index 2, no body). Reading it as a `FuncDecl` panicked
// index-out-of-range on `kidsOf(tree, decl)[3]` the first time this pass ran
// over a module declaring one; an extern function has no body for
// `relationAutoWalk` to look inside anyway, so it is simply excluded from
// the call graph, same as any other shape this pass cannot reason about.
fn relationAutoCollectFuncDecls(c: Checker): []int {
  let out = []int(0)
  for (_, decl) of c.funcDecls {
    if (getNode(c.tree, decl).tag == Tag.FuncDecl && relationAutoIsNonGeneric(c.tree, decl)) {
      out = append(out, decl)
    }
  }
  // Ascending node id, never map order (#7379): the summary list this seeds is
  // folded in order, and the order the read names merge in decides the order
  // the spliced `.with(...)` links come out (#7396).
  sortInPlace(out, (a: int, b: int) => a < b)
  return out
}

// The body block of one proof entry: a `FuncDecl`/`ArrowFn`'s own body, or a
// `test "..." { }` declaration's (`[name, body]`, `parseTestDecl`,
// compiler/parserdecl.bit). A test block is not a caller, but it IS a reader
// (#6406): a relation read written in one is judged exactly like one in a
// function body.
fn relationAutoBodyOf(tree: Tree, entry: int): int {
  if (getNode(tree, entry).tag == Tag.TestDecl) {
    return kidsOf(tree, entry)[1]
  }
  return lintFuncInfo(tree, entry).body
}

// The default-value expressions of a `FuncDecl`'s own parameters (`[name,
// type, default]`, `parseParam`, compiler/parserparam.bit): code that runs at
// the CALL when an argument is omitted, and a body like any other, so a
// relation read written in one is judged here too (#6406). Empty for a
// `test` block, an `ArrowFn` (`ArrowP` carries no default) and every function
// without one.
fn relationAutoParamDefaults(tree: Tree, entry: int): []int {
  let out = []int(0)
  if (getNode(tree, entry).tag != Tag.FuncDecl) {
    return out
  }
  for p of kidsOf(tree, kidsOf(tree, entry)[3]) {
    let pk = kidsOf(tree, p)
    if (len(pk) >= 3 && pk[2] != 0) {
      out = append(out, pk[2])
    }
  }
  return out
}

// Every entry the proof walks, one fresh walk each: every `FuncDecl` and
// `ArrowFn` (`lintCollectFuncs`, closures inside a test block included) plus
// every top-level `TestDecl`, which has no parameters, no return and no
// summary of its own (`hasIdx` is false for it, like a generic function).
fn relationAutoCollectBodies(tree: Tree): []int {
  let out = lintCollectFuncs(tree, tree.root, []int(0))
  for decl of kidsOf(tree, tree.root) {
    if (getNode(tree, decl).tag == Tag.TestDecl) {
      out = append(out, decl)
    }
  }
  return out
}

// The entries that can CALL a function: `relationAutoCollectBodies` minus
// every `test` block and the closures inside one (SPEC §10.5: a test block is
// not a caller, so it never makes a function "called").
fn relationAutoCallerFuncs(tree: Tree): []int {
  let out = []int(0)
  for decl of kidsOf(tree, tree.root) {
    if (getNode(tree, decl).tag != Tag.TestDecl) {
      out = lintCollectFuncs(tree, decl, out)
    }
  }
  return out
}

// Whether `ptype` is trackable as a query row: a `@table` class directly
// (a scalar parameter) or `[]T` for one (a slice parameter) — `elementType`
// unwraps the slice via the SAME `TypeKind.Slice`/`.elem` shape
// `compiler/checkmatch.bit`'s own `elementType` reads, reused here directly
// since a parameter's declared type never needs its map/iterator cases.
fn relationAutoParamTrackable(c: Checker, ptype: int): (RelationAutoClass, bool) {
  if (ptype != 0 && c.ctx.types[ptype].kind == TypeKind.Slice) {
    return (relationAutoClassFromStructType(c, c.ctx.types[ptype].elem), true)
  }
  return (relationAutoClassFromStructType(c, ptype), false)
}

// One `Param` node's own declared type is `c.declTypes[nameNode]`
// (compiler/checkmodule.bit's `bindParamOrReceiver`, which keys it on the
// SAME name node this reads) — populated for every parameter by the
// ordinary check pre-pass, well before this whole-program pass ever runs.
fn relationAutoBuildParamSummaries(c: Checker, decl: int): []RelationAutoParamSummary {
  let paramsNode = kidsOf(c.tree, decl)[3]
  let out = []RelationAutoParamSummary(0)
  for p of kidsOf(c.tree, paramsNode) {
    let tag = getNode(c.tree, p).tag
    let nameNode = kidsOf(c.tree, p)[0]
    let ptype = 0
    if (nameNode >= 0 && nameNode < len(c.declTypes)) {
      ptype = c.declTypes[nameNode]
    }
    let (cls, isSlice) = relationAutoParamTrackable(c, ptype)
    out = append(
      out,
      RelationAutoParamSummary{
        name = identText(c.tree, c.source, nameNode), cls = cls, isSlice = isSlice,
        trackable = cls.found, variadic = tag == Tag.ParamRest, reads = []string(0),
      },
    )
  }
  return out
}

// One trackable parameter becomes a synthetic `RelationAutoBinding` — see
// that class's own header (relationauto.bit) for why `queryCall = 0` /
// `paramName = p.name` and `afterOffset = -1` (in scope for the whole body).
// `ownerModule = c.moduleId` is never actually read while `queryCall == 0`
// (`relationAutoRecordRead`'s own guard, relationauto.bit) — `c` is this
// function's OWN Checker, the only value on hand here, kept only because
// every `RelationAutoBinding` literal must fill the field.
fn relationAutoSeedParamBindings(
  c: Checker,
  params: []RelationAutoParamSummary,
): []RelationAutoBinding {
  let out = []RelationAutoBinding(0)
  for p of params {
    if (!p.trackable) {
      continue
    }
    out = append(
      out,
      RelationAutoBinding{
        varName = p.name, cls = p.cls, queryCall = 0, paramName = p.name, isSlice = p.isSlice,
        afterOffset = -1, ownerModule = c.moduleId, path = "",
      },
    )
  }
  return out
}

// The WHOLE PROJECT's initial call-graph table (R2b, #6322): every
// non-generic named free function of EVERY module, keyed `"${moduleId}:
// ${decl}"` (this file's own header) so a decl node from one module's tree
// can never collide with a same-numbered node from another's.
fn relationAutoInitProjectSummaries(mods: []Checker): RelationAutoFuncSummaries {
  let sums = RelationAutoFuncSummaries{
    declToIndex = map<string, int>{},
    list = []RelationAutoFuncSummary(0),
  }
  for c of mods {
    for decl of relationAutoCollectFuncDecls(c) {
      sums.declToIndex["${c.moduleId}:${decl}"] = len(sums.list)
      sums.list = append(
        sums.list,
        RelationAutoFuncSummary{
          decl = decl, params = relationAutoBuildParamSummaries(c, decl), ret = relationAutoNoReturnSummary(c),
        },
      )
    }
  }
  return sums
}

// `params` with `fresh` (one round's own `st.paramReads`, keyed by
// parameter name) unioned into each parameter's own `reads` —
// `relationAutoMergeName` (compiler/relationautopath.bit, #6318) collapses a
// flat name against a dotted one nesting under it, the same subsumption
// `relationAutoRecordRead` applies on the same-function side, so a name
// appended by TWO different call sites in the same round — or a shorter
// name that a LATER round's own more specific one subsumes — is still
// recorded once, at its most specific.
fn relationAutoMergedParams(
  params: []RelationAutoParamSummary,
  fresh: map<string, []string>,
): []RelationAutoParamSummary {
  let out = []RelationAutoParamSummary(0)
  for p of params {
    let merged = p.reads
    let (newNames, ok) = fresh[p.name]
    if (ok) {
      for n of newNames {
        merged = relationAutoMergeName(merged, n)
      }
    }
    out = append(
      out,
      RelationAutoParamSummary{
        name = p.name,
        cls = p.cls,
        isSlice = p.isSlice,
        trackable = p.trackable,
        variadic = p.variadic,
        reads = merged,
      },
    )
  }
  return out
}

fn relationAutoFinalizeReturn(
  c: Checker,
  st: RelationAutoState,
  fd: int,
): RelationAutoReturnSummary {
  if (st.returnMixed) {
    return relationAutoMixedReturn(c, st.returnCandidate, fd)
  }
  if (!st.returnSeen || !st.returnCandidate.found) {
    return relationAutoNoReturnSummary(c)
  }
  let flow = st.returnCandidate
  return RelationAutoReturnSummary{
    found = true, queryCall = flow.queryCall, viaParamName = flow.paramName, cls = flow.cls, isSlice = flow.isSlice,
    ownerModule = flow.ownerModule, path = flow.path,
  }
}

// One round's own progress measure: the total CHARACTER length of every
// recorded relation-name path across every parameter, plus how many
// functions have a resolved return — both monotonically non-decreasing
// round over round (this file's own header), so equality before/after a
// round IS the fixed point. CHARACTER length, not entry count (#6318):
// `relationAutoMergeName` can replace a flat name with a longer, more
// specific dotted one that SUBSUMES it (`"author"` -> `"author.posts"`)
// without changing the entry COUNT — a count-only measure could read that
// round as "unchanged" and stop the fixed point one round before a
// cross-function/cross-module caller ever sees the more specific path.
// Length strictly grows whenever a subsumption like that happens, so it
// cannot go stale that way.
fn relationAutoSummariesMeasure(sums: RelationAutoFuncSummaries): int {
  let total = 0
  for f of sums.list {
    for p of f.params {
      for r of p.reads {
        total = total + len(r) + 1
      }
    }
    if (f.ret.found) {
      total = total + 1
    }
  }
  return total
}

// Walks one function's body once, seeded with its own parameter bindings
// (if it has a call-graph summary at all — `hasIdx` is false for a
// generic function or an `ArrowFn`, which still get the plain same-function
// walk via `relationAutoWalk`'s own recording into `c.relationAutoWith`,
// just no parameter/return summary of their own), then folds what this one
// walk found back into `sums`. Keyed `"${c.moduleId}:${fd}"` (this file's
// own header): `fd` is a node in `c`'s OWN tree, since every call site below
// passes each module's own decls against that same module's own Checker.
fn relationAutoWalkOneFunc(c: Checker, fd: int, sums: RelationAutoFuncSummaries) {
  let (idx, hasIdx) = sums.declToIndex["${c.moduleId}:${fd}"]
  let bindings = []RelationAutoBinding(0)
  if (hasIdx) {
    bindings = relationAutoSeedParamBindings(c, sums.list[idx].params)
  }
  let st = RelationAutoState{
    bindings = bindings, assigned = []RelationAutoErrLoaded(0), summaries = sums,
    paramReads = map<string, []string>{}, returnSeen = false, returnCandidate = relationAutoNoFlow(c),
    returnMixed = false,
  }
  for dflt of relationAutoParamDefaults(c.tree, fd) {
    relationAutoWalk(c, dflt, st)
  }
  relationAutoWalk(c, relationAutoBodyOf(c.tree, fd), st)
  if (!hasIdx) {
    return
  }
  sums.list[idx] = RelationAutoFuncSummary{
    decl = fd, params = relationAutoMergedParams(sums.list[idx].params, st.paramReads),
    ret = relationAutoFinalizeReturn(c, st, fd),
  }
}

// Entry point for the WHOLE PROJECT (R2b, #6322 — one module's, before;
// `relationAutoAnalyzeProject`, relationauto.bit): re-walks every function
// in EVERY module once per round — `lintCollectFuncs` gives ALL of a
// module's own (generic functions and `ArrowFn`s included, so their own
// same-function recording still runs), while only the non-generic named
// ones in `sums` grow a parameter/return summary other functions, in any
// module, can consult. Returns the converged `sums` (R3, #6308): the
// caller passes it on to `relationAutoCheckErrors`
// (compiler/relationautoerr.bit), which needs the SAME resolved
// parameter/return summaries this fixed point already built to tell a
// provable cross-function read from an unprovable one — recomputing them a
// second time would either double this pass's own cost or risk drifting
// from the exact set `relationautosplice.bit` actually splices.
fn relationAutoAnalyzeWholeProject(mods: []Checker): RelationAutoFuncSummaries {
  let sums = relationAutoInitProjectSummaries(mods)
  let bound = len(sums.list) + 1
  let round = 0
  let changed = true
  while (changed && round < bound) {
    let before = relationAutoSummariesMeasure(sums)
    for c of mods {
      for fd of relationAutoCollectBodies(c.tree) {
        relationAutoWalkOneFunc(c, fd, sums)
      }
    }
    changed = relationAutoSummariesMeasure(sums) != before
    round = round + 1
  }
  assert(round <= bound, "relationautocalls: fixed point exceeded its own bound of ${bound} rounds")
  return sums
}

// `callNode`'s own argument EXPRESSIONS, one slot per entry of `params` (a
// callee's own resolved parameter summaries — `RelationAutoParamSummary`,
// in DECLARATION order), never per call-site ARGUMENT (R2b, #6322: was
// per-argument, positional-only, before). Slot `i` is 0 when parameter `i`
// got no value at this call site — a trailing default-filled parameter, the
// same "cannot resolve" this file already gives an unprovable shape,
// `relationAutoResolve`'s own `node == 0` guard reads as not-found — never a
// wrong position: `Args`'s kids are `Arg` nodes (each wrapping one
// expression at kid 0, `ormFirstArgExpr`'s identical shape,
// compiler/checkormquery.bit) for a positional argument, or `Tag.NamedArg`
// (`[name, expr]`, SPEC §12.11) for a named one, resolved against `params`
// by NAME (`relationAutoParamIndex`) rather than position — named arguments
// only ever follow every positional one (SPEC §12.11's own ordering rule,
// enforced by `namedargs.bit`'s `vNamedArgOrder` before this pass ever
// runs), so a plain running position counter for the un-named prefix is
// exact. A variadic parameter (`...xs: T`, #6405) is never named (E-code
// `ecNamedArgVariadic`) and is filled by MANY arguments, so its slot stays 0
// here and `relationAutoVariadicArgs` lists what fills it: the positional
// arguments past the fixed parameters and a `Tag.ArgSpread` (`...xs`, #6352),
// which is only ever the final argument.
fn relationAutoArgExprs(c: Checker, callNode: int, params: []RelationAutoParamSummary): []int {
  let out = []int(len(params))
  let posIdx = 0
  let fixed = relationAutoFixedCount(params)
  for a of kidsOf(c.tree, kidsOf(c.tree, callNode)[2]) {
    let tag = getNode(c.tree, a).tag
    if (tag == Tag.NamedArg) {
      let nk = kidsOf(c.tree, a)
      let pidx = relationAutoParamIndex(params, identText(c.tree, c.source, nk[0]))
      if (pidx >= 0 && pidx < fixed) {
        out[pidx] = nk[1]
      }
    } else if (tag == Tag.Arg && posIdx < fixed) {
      out[posIdx] = kidsOf(c.tree, a)[0]
      posIdx = posIdx + 1
    }
  }
  return out
}

// How many of `params` are fixed: all of them, or all but a trailing variadic.
fn relationAutoFixedCount(params: []RelationAutoParamSummary): int {
  if (len(params) > 0 && params[len(params) - 1].variadic) {
    return len(params) - 1
  }
  return len(params)
}

// The expressions that fill `params`' variadic parameter at `callNode` (#6405):
// every positional argument past the fixed parameters (each one row of the
// variadic's rows) and a final `...spread`'s operand (a slice of them). Empty
// when the callee has no variadic parameter or the call passes none.
fn relationAutoVariadicArgs(c: Checker, callNode: int, params: []RelationAutoParamSummary): []int {
  let out = []int(0)
  let fixed = relationAutoFixedCount(params)
  if (fixed == len(params)) {
    return out
  }
  let posIdx = 0
  for a of kidsOf(c.tree, kidsOf(c.tree, callNode)[2]) {
    let tag = getNode(c.tree, a).tag
    if (tag == Tag.ArgSpread || (tag == Tag.Arg && posIdx >= fixed)) {
      out = append(out, kidsOf(c.tree, a)[0])
    }
    if (tag == Tag.Arg) {
      posIdx = posIdx + 1
    }
  }
  return out
}

fn relationAutoParamIndex(params: []RelationAutoParamSummary, name: string): int {
  let i = 0
  while (i < len(params)) {
    if (params[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// A `RelationAutoFuncSummary` carrying no relation information — the "not
// resolved" answer `relationAutoLookupSummary` returns alongside `false`,
// so its caller never has to construct one inline.
fn relationAutoNoFuncSummary(c: Checker): RelationAutoFuncSummary {
  return RelationAutoFuncSummary{
    decl = 0, params = []RelationAutoParamSummary(0), ret = relationAutoNoReturnSummary(c),
  }
}

// Resolves `name`, called from `c` at `callee`, to its call-graph summary —
// possibly in ANOTHER module of the project (R2b, #6322: was `c.funcDecls`,
// same-module only, before). `funcDeclLookup`/`declOwner`
// (compiler/checklookup.bit, check.bit) are the same pair `callQualified`
// (checkaccess.bit) uses to qualify a call's own LINK name: a local
// declaration shadows a same-named import, and an imported name resolves to
// its DEFINING module — so a call this function resolves to a summary is
// always one lowering will actually emit as a direct call to that same
// declaration. Guarded by `shadowedByValue` (compiler/checkexpr.bit) — its
// own header names this exact "does a local shadow this callee?" use, since
// a flat name table is unsafe to trust without it
// (`relationauto.bit`'s own #2947 comment).
fn relationAutoLookupSummary(
  c: Checker,
  name: string,
  callee: int,
  st: RelationAutoState,
): (RelationAutoFuncSummary, bool) {
  if (shadowedByValue(c, callee, name)) {
    return (relationAutoNoFuncSummary(c), false)
  }
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return (relationAutoNoFuncSummary(c), false)
  }
  let owner = declOwner(c, name)
  let (idx, hasIdx) = st.summaries.declToIndex["${owner.moduleId}:${decl}"]
  if (!hasIdx) {
    return (relationAutoNoFuncSummary(c), false)
  }
  return (st.summaries.list[idx], true)
}

// A call `f(a0, a1, ...)` to a named, resolved free function, anywhere in
// the project: for every parameter position `f`'s own summary has recorded
// relation reads against, resolve the matching ARGUMENT expression in the
// CALLER's own state (a parameter the call omits: its default expression,
// relationautodefault.bit) and record those same names against whatever it flows
// from — a real query call, or (when this walk is itself building an
// ENCLOSING function's own parameter summary) that enclosing function's own
// parameter, letting a chain of wrapper calls propagate for free.
fn relationAutoCheckCallArgs(c: Checker, node: int, st: RelationAutoState) {
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let name = identText(c.tree, c.source, callee)
  let (summary, ok) = relationAutoLookupSummary(c, name, callee, st)
  if (!ok) {
    return
  }
  let args = relationAutoArgExprs(c, node, summary.params)
  let fixed = relationAutoFixedCount(summary.params)
  let i = 0
  while (i < fixed) {
    if (len(summary.params[i].reads) != 0) {
      let slot = relationAutoSlotOf(c, name, summary, args, i)
      relationAutoRecordParamReads(c, summary.params[i].reads, relationAutoSlotFlow(slot, st), st)
    }
    i = i + 1
  }
  if (fixed == len(summary.params) || len(summary.params[fixed].reads) == 0) {
    return
  }
  for a of relationAutoVariadicArgs(c, node, summary.params) {
    relationAutoRecordParamReads(c, summary.params[fixed].reads, relationAutoResolve(c, a, st), st)
  }
}

// `reads` (a callee parameter's recorded relation names) recorded against
// `argFlow`, the flow of the argument filling that parameter, when it traces
// to a query or a parameter of the enclosing function.
fn relationAutoRecordParamReads(
  c: Checker, reads: []string, argFlow: RelationAutoFlow, st: RelationAutoState,
) {
  if (!argFlow.found) {
    return
  }
  for r of reads {
    relationAutoRecordRead(c, st, argFlow, r)
  }
}

// What to walk of an assignment TARGET: a `Member` target is being WRITTEN,
// never read (`x.f = v` does not load `f`), so only its receiver is walked
// (`arr[i].f = v` still reads `arr[i]`; `x.a.b = v` still reads `x.a`);
// any other target is walked whole.
fn relationAutoAssignWalkee(c: Checker, t: int): int {
  if (t != 0 && getNode(c.tree, t).tag == Tag.Member) {
    return kidsOf(c.tree, t)[0]
  }
  return t
}

// An assignment (#6352): a plain `=` only WRITES its targets, and once its
// values are walked, records each `x.f` target as assigned on `x` until the
// enclosing block ends — a read of it after that is the assigned value, never
// a load the query or a caller owes. A compound `+=` reads its target first,
// so it is walked whole and records nothing.
fn relationAutoWalkAssign(c: Checker, node: int, st: RelationAutoState) {
  let k = kidsOf(c.tree, node)
  let plain = getNode(c.tree, node).main == int(Kind.Eq)
  let targets = kidsOf(c.tree, k[0])
  for t of targets {
    if (plain) {
      relationAutoWalk(c, relationAutoAssignWalkee(c, t), st)
    } else {
      relationAutoWalk(c, t, st)
    }
  }
  for v of kidsOf(c.tree, k[1]) {
    relationAutoWalk(c, v, st)
  }
  if (plain) {
    st.assigned = relationAutoMarkAssigned(c, targets, getNode(c.tree, node).span.end, st.assigned)
  }
}

// A function returning its own variadic parameter (#6405) hands back whatever
// its callers passed to it, many arguments across many calls: the parameter's
// holder (`holder:P`, relationautoholder.bit), whose writers are exactly those
// arguments (`relationAutoHolderNoteCall`).
fn relationAutoVariadicReturn(
  c: Checker,
  name: string,
  summary: RelationAutoFuncSummary,
  ret: RelationAutoReturnSummary,
  idx: int,
): RelationAutoFlow {
  let owner = declOwner(c, name)
  let params = kidsOf(owner.tree, kidsOf(owner.tree, summary.decl)[3])
  return RelationAutoFlow{
    found = true, cls = ret.cls, queryCall = 0,
    paramName = relationAutoParamHolderKey(owner.moduleId, kidsOf(owner.tree, params[idx])[0]),
    isSlice = ret.isSlice, ownerModule = ret.ownerModule, path = ret.path,
  }
}

// The VALUE a call to a named, resolved free function produces, from its
// own return summary: a fixed query call directly (`ret.queryCall > 0`,
// `ret.ownerModule` naming which module's tree it indexes into), or —
// `ret.viaParamName != ""` — whatever the matching ARGUMENT expression at
// THIS call site resolves to in the caller's own state, recursed through
// `relationAutoResolve` exactly once per call site (the recursion is on the
// ARGUMENT node, syntactically smaller than `callNode`, so a call cycle in
// the source cannot loop this call). `relationauto.bit`'s
// `relationAutoResolveCall` is this function's only caller, already past
// the `shadowedByValue` guard `relationAutoLookupSummary` applies here too —
// the same check would just repeat it.
fn relationAutoResolveNamedCall(
  c: Checker,
  callNode: int,
  callee: int,
  st: RelationAutoState,
): RelationAutoFlow {
  let name = identText(c.tree, c.source, callee)
  let (summary, ok) = relationAutoLookupSummary(c, name, callee, st)
  if (!ok) {
    return relationAutoNoFlow(c)
  }
  let ret = summary.ret
  if (!ret.found) {
    return relationAutoNoFlow(c)
  }
  if (ret.queryCall > 0) {
    return RelationAutoFlow{
      found = true, cls = ret.cls, queryCall = ret.queryCall, paramName = "", isSlice = ret.isSlice,
      ownerModule = ret.ownerModule, path = ret.path,
    }
  }
  if (relationAutoIsHolderName(ret.viaParamName)) {
    return RelationAutoFlow{
      found = true, cls = ret.cls, queryCall = 0, paramName = ret.viaParamName, isSlice = ret.isSlice,
      ownerModule = ret.ownerModule, path = ret.path,
    }
  }
  let paramIdx = relationAutoParamIndex(summary.params, ret.viaParamName)
  if (paramIdx >= 0 && summary.params[paramIdx].variadic) {
    return relationAutoVariadicReturn(c, name, summary, ret, paramIdx)
  }
  let args = relationAutoArgExprs(c, callNode, summary.params)
  if (paramIdx < 0 || paramIdx >= len(args)) {
    return relationAutoNoFlow(c)
  }
  return relationAutoSlotFlow(relationAutoSlotOf(c, name, summary, args, paramIdx), st)
}
