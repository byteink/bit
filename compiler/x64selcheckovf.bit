// In-Bit self-checks for x86-64 overflow traps and comparison selection —
// moved verbatim out of compiler/x64selcheck.bit (#4322), which was 792 lines
// against the hard 800-line E0200 ceiling, the same split
// compiler/x64selcheckmem.bit already made at 797 (#3141).
//
// The multiply overflow traps (general and power-of-two, both widths), unary
// selection and its overflow traps, and the integer/float comparison
// selectors. Canonicalization, operand classification, binary/divide/pow2-mul
// selection and the add/sub overflow trap stay in x64selcheck.bit; read its
// header first.
//
// Split out of selfcheck.bit (#1503) originally, so this is the same module:
// nothing is imported here (a duplicate import is E0042).
// #3085: overflow-checked signed multiply in debug builds, general
// (non-folded) path. IMUL (0F AF /r, xImulRR) sets OF/CF exactly when the
// 64x64->64 product does not fit the destination -- the same fact ADD/SUB's
// OF reports (#3082), so `xMaybeOverflowTrap` applies unchanged.
fn checkX64MulOverflowTrap() {
  let w64 = mkWidth(8, RegClass.Int, true)

  // Release: byte-identical to pre-#3085 (mov, imul, mov).
  let cxRel = xTestCtx()
  xEmitMulInt(cxRel, 0, 0, 0, noPow2Factor(w64))
  assert(xHex(cxRel.buf) == "480fafc0")

  // Debug, i64: OF from the imul that just ran is authoritative.
  let cxDbg = xTestCtx()
  cxDbg.debug = true
  xEmitMulInt(cxDbg, 0, 0, 0, noPow2Factor(w64))
  assert(xHex(cxDbg.buf) == "480fafc0" + "0f8105000000e800000000")
  assert(len(cxDbg.relocs) == 1 && cxDbg.relocs[0].symbol == "bit_rt_panic_overflow")

  // Debug, unsigned (SPEC 13.5): byte-identical to release.
  let cxDbgU = xTestCtx()
  cxDbgU.debug = true
  xEmitMulInt(cxDbgU, 0, 0, 0, noPow2Factor(mkWidth(8, RegClass.Int, false)))
  assert(xHex(cxDbgU.buf) == xHex(cxRel.buf))

  checkX64MulOverflowTrapWide(1,
    "480fafc0480fbec0",
    "480fafc0" + "4989c44d0fbee44c39e00f8405000000e800000000" + "480fbec0")
  checkX64MulOverflowTrapWide(2,
    "480fafc0480fbfc0",
    "480fafc0" + "4989c44d0fbfe44c39e00f8405000000e800000000" + "480fbfc0")
  checkX64MulOverflowTrapWide(4,
    "480fafc04863c0",
    "480fafc0" + "4989c44d63e44c39e00f8405000000e800000000" + "4863c0")
}

// Widths < 8: operand magnitude is bounded under 2^(bits-1), so the exact
// product can never reach 2^63 -- only whether it fits width `bytes`'s own
// range remains, the same re-narrow-and-compare ADD/SUB already uses.
fn checkX64MulOverflowTrapWide(bytes: int, relHex: string, dbgHex: string) {
  let ws = mkWidth(bytes, RegClass.Int, true)
  let wu = mkWidth(bytes, RegClass.Int, false)

  let cxRel = xTestCtx()
  xEmitMulInt(cxRel, 0, 0, 0, noPow2Factor(ws))
  assert(xHex(cxRel.buf) == relHex)

  let cxDbg = xTestCtx()
  cxDbg.debug = true
  xEmitMulInt(cxDbg, 0, 0, 0, noPow2Factor(ws))
  assert(xHex(cxDbg.buf) == dbgHex)
  assert(len(cxDbg.relocs) == 1 && cxDbg.relocs[0].symbol == "bit_rt_panic_overflow")

  // Unsigned at this width: still no trap -- gated on w.signed too.
  let cxDbgU = xTestCtx()
  cxDbgU.debug = true
  xEmitMulInt(cxDbgU, 0, 0, 0, noPow2Factor(wu))
  let cxRelU = xTestCtx()
  xEmitMulInt(cxRelU, 0, 0, 0, noPow2Factor(wu))
  assert(xHex(cxDbgU.buf) == xHex(cxRelU.buf))
}

// #3085's pow2-fold counterpart: xEmitPow2MulInt (#3105) never runs imul, so
// at width 8 there is no OF to read -- x64selectovf.bit's
// xEmitPow2MulOverflowTrap64 shifts the shl result back down by `k` and
// compares against the pre-shift operand, preserved in %r10 before the shl
// clobbers %r11. Narrower than 8, the shl result is bit-identical to what a
// real imul would produce, so the narrow check matches the general path's.
fn checkX64Pow2MulOverflowTrap() {
  let w64 = mkWidth(8, RegClass.Int, true)

  // Release, k=3 (x*8): unchanged from checkX64Pow2MulSel's own golden above.
  let cxRel = xTestCtx()
  xEmitPow2MulInt(cxRel, 0, 0, 3, w64)
  assert(xHex(cxRel.buf) == "48c1e003")

  // Debug, i64: value and the 2^k factor are each bounded only by width 8's
  // own range, so their product genuinely can overflow (unlike narrower
  // widths). mov %rax,%r10 preserves the pre-shift value; the rest is the
  // shift-back-and-compare xEmitPow2MulOverflowTrap64 performs.
  let cxDbg = xTestCtx()
  cxDbg.debug = true
  xEmitPow2MulInt(cxDbg, 0, 0, 3, w64)
  assert(xHex(cxDbg.buf) ==
    "4989c2" + "48c1e003" +
    "4989c449c1fc034d39d40f8405000000e800000000")
  assert(len(cxDbg.relocs) == 1 && cxDbg.relocs[0].symbol == "bit_rt_panic_overflow")

  // Debug, unsigned: byte-identical to release, even through the fold.
  let cxDbgU = xTestCtx()
  cxDbgU.debug = true
  xEmitPow2MulInt(cxDbgU, 0, 0, 3, mkWidth(8, RegClass.Int, false))
  assert(xHex(cxDbgU.buf) == xHex(cxRel.buf))

  checkX64Pow2MulOverflowTrapWide(1,
    "48c1e001480fbec0",
    "48c1e001" + "4989c44d0fbee44c39e00f8405000000e800000000" + "480fbec0")
  checkX64Pow2MulOverflowTrapWide(2,
    "48c1e001480fbfc0",
    "48c1e001" + "4989c44d0fbfe44c39e00f8405000000e800000000" + "480fbfc0")
  checkX64Pow2MulOverflowTrapWide(4,
    "48c1e0014863c0",
    "48c1e001" + "4989c44d63e44c39e00f8405000000e800000000" + "4863c0")
}

// Same shape, k=1 (x*2, the acceptance test's own shape): shl bytes
// ("49c1e301") are identical at every width -- SHL acts on the physical
// register, not the logical one.
fn checkX64Pow2MulOverflowTrapWide(bytes: int, relHex: string, dbgHex: string) {
  let ws = mkWidth(bytes, RegClass.Int, true)
  let wu = mkWidth(bytes, RegClass.Int, false)

  let cxRel = xTestCtx()
  xEmitPow2MulInt(cxRel, 0, 0, 1, ws)
  assert(xHex(cxRel.buf) == relHex)

  let cxDbg = xTestCtx()
  cxDbg.debug = true
  xEmitPow2MulInt(cxDbg, 0, 0, 1, ws)
  assert(xHex(cxDbg.buf) == dbgHex)
  assert(len(cxDbg.relocs) == 1 && cxDbg.relocs[0].symbol == "bit_rt_panic_overflow")

  let cxDbgU = xTestCtx()
  cxDbgU.debug = true
  xEmitPow2MulInt(cxDbgU, 0, 0, 1, wu)
  let cxRelU = xTestCtx()
  xEmitPow2MulInt(cxRelU, 0, 0, 1, wu)
  assert(xHex(cxDbgU.buf) == xHex(cxRelU.buf))
}

fn checkX64UnarySel() {
  // neg and not both set bits above the type width, so both re-narrow.
  let narrow = mkWidth(1, RegClass.Int, true)
  let cxN = xTestCtx()
  xEmitUnaryInt(cxN, true, 0, 0, narrow)
  let cxW = xTestCtx()
  xEmitUnaryInt(cxW, true, 0, 0, mkWidth(8, RegClass.Int, true))
  assert(len(cxN.buf.code) > len(cxW.buf.code))

  // neg (F7 /3) and not (F7 /2) share a group and differ only by the digit.
  let cx1 = xTestCtx()
  xEmitUnaryInt(cx1, true, 0, 0, mkWidth(8, RegClass.Int, true))
  let cx2 = xTestCtx()
  xEmitUnaryInt(cx2, false, 0, 0, mkWidth(8, RegClass.Int, true))
  assert(xHex(cx1.buf) != xHex(cx2.buf))
}

// #3083: overflow-checked signed negation in debug builds. NEG sets OF exactly
// like ADD/SUB (#3082), at the same full-64-bit register width `xNegR` always
// encodes, so `xMaybeOverflowTrap` applies unchanged: OF alone at width 8,
// re-narrow-and-compare below it. BNOT never overflows and must stay
// byte-identical whether or not cx.debug is set, at every width.
fn checkX64UnaryOverflowTrapWide(
  bytes: int, relHex: string, dbgHex: string, dbgUHex: string, notHex: string,
) {
  let ws = mkWidth(bytes, RegClass.Int, true)
  let wu = mkWidth(bytes, RegClass.Int, false)

  // Release (cx.debug == false): unchanged from before this ticket -- the
  // regression guard for the release path.
  let cxRel = xTestCtx()
  xEmitUnaryInt(cxRel, true, 0, 0, ws)
  assert(xHex(cxRel.buf) == relHex)

  // Debug, signed: traps.
  let cxDbg = xTestCtx()
  cxDbg.debug = true
  xEmitUnaryInt(cxDbg, true, 0, 0, ws)
  assert(xHex(cxDbg.buf) == dbgHex)
  assert(len(cxDbg.relocs) == 1 && cxDbg.relocs[0].symbol == "bit_rt_panic_overflow")

  // Debug, unsigned: SPEC 13.5 -- unsigned negate always wraps, even in a
  // debug build. Byte-identical to the release sequence at this width.
  let cxDbgU = xTestCtx()
  cxDbgU.debug = true
  xEmitUnaryInt(cxDbgU, true, 0, 0, wu)
  assert(xHex(cxDbgU.buf) == dbgUHex)
  let cxRelU = xTestCtx()
  xEmitUnaryInt(cxRelU, true, 0, 0, wu)
  assert(xHex(cxRelU.buf) == xHex(cxDbgU.buf))

  // BNOT: cx.debug must never change a single byte, at this width or any
  // other -- xMaybeOverflowTrap is only ever reached from the isNeg branch.
  let cxNotRel = xTestCtx()
  xEmitUnaryInt(cxNotRel, false, 0, 0, ws)
  assert(xHex(cxNotRel.buf) == notHex)
  let cxNotDbg = xTestCtx()
  cxNotDbg.debug = true
  xEmitUnaryInt(cxNotDbg, false, 0, 0, ws)
  assert(xHex(cxNotDbg.buf) == xHex(cxNotRel.buf))
}

fn checkX64UnaryOverflowTrap() {
  // i8: re-narrow trap via movsbq (0F BE) on the copy (r12) and on the final
  // result (r11) -- narrower than i64, so OF from the 64-bit NEG is NOT
  // authoritative (-128 negates to +128, which fits 64 bits fine and never
  // sets OF; only the re-narrow-and-compare catches it).
  checkX64UnaryOverflowTrapWide(
    1,
    "48f7d8480fbec0",
    "48f7d84989c44d0fbee44c39e00f8405000000e800000000480fbec0",
    "48f7d8480fb6c0",
    "48f7d0480fbec0",
  )

  // i16: same shape, movswq (0F BF).
  checkX64UnaryOverflowTrapWide(
    2,
    "48f7d8480fbfc0",
    "48f7d84989c44d0fbfe44c39e00f8405000000e800000000480fbfc0",
    "48f7d8480fb7c0",
    "48f7d0480fbfc0",
  )

  // i32: same shape, movslq (63) -- identical trap bytes to #3082's checkX64OverflowTrap
  // narrow case, since xEmitOverflowTrapNarrow is parameterized only by (cx, reg, w).
  checkX64UnaryOverflowTrapWide(
    4,
    "48f7d84863c0",
    "48f7d84989c44d63e44c39e00f8405000000e8000000004863c0",
    "48f7d88bc0",
    "48f7d04863c0",
  )

  // i64: OF from the 64-bit NEG is authoritative -- the ONLY signed i64 value
  // that overflows negation is i64 MIN, and that is exactly when NEG sets OF.
  // No re-narrowing: the register width already IS the type width.
  checkX64UnaryOverflowTrapWide(
    8,
    "48f7d8",
    "48f7d80f8105000000e800000000",
    "48f7d8",
    "48f7d0",
  )
}

fn checkX64Icmp() {
  // cmp, setcc, movzx — in that order. The movzx comes AFTER because setcc must
  // read the flags cmp set; zeroing the destination first would clobber them.
  let cx = xTestCtx()
  xEmitIcmp(cx, ccE(), 0, 0, 0)
  //   48 39 c0        cmp %rax, %rax
  //   41 0f 94 c3     sete %r11b (REX.B — r11 is an extended register)
  //   4d 0f b6 db     movzbq %r11b, %r11
  //   4c 89 d8        mov %r11, %rax
  assert(xHex(cx.buf) == "4839c0400f94c0480fb6c0")

  // Signed and unsigned compares must differ — that is -1 vs a huge positive.
  let cxS = xTestCtx()
  xEmitIcmp(cxS, ccL(), 0, 0, 0)
  let cxU = xTestCtx()
  xEmitIcmp(cxU, ccB(), 0, 0, 0)
  assert(xHex(cxS.buf) != xHex(cxU.buf))
}

fn checkX64Fcmp() {
  // IEEE, not just "icmp with float codes". ucomis sets PF when either operand
  // is NaN (unordered), and each case handles it.

  // GT/GE use the unsigned above codes directly, operands in order.
  let cxGt = xTestCtx()
  xEmitFcmp(cxGt, 0, 0, 0, XFCmpOp{ cc: XFCmp.FGt, width: 8 })
  let cxGe = xTestCtx()
  xEmitFcmp(cxGe, 0, 0, 0, XFCmpOp{ cc: XFCmp.FGe, width: 8 })
  assert(xHex(cxGt.buf) != xHex(cxGe.buf))

  // LT/LE SWAP the operands rather than use the signed codes — the signed codes
  // read TRUE on an unordered result, so `NaN < x` would come out true.
  // With both operands the same vreg the swap is invisible, so use distinct
  // ones: vreg 0 is in a register, vreg 1 is spilled.
  let cxLt = xTestCtx()
  xEmitFcmp(cxLt, 0, 0, 1, XFCmpOp{ cc: XFCmp.FLt, width: 8 })
  let cxGt2 = xTestCtx()
  xEmitFcmp(cxGt2, 0, 0, 1, XFCmpOp{ cc: XFCmp.FGt, width: 8 })
  // Both use `seta`, so they differ ONLY in the ucomis operand order — which is
  // exactly the swap.
  assert(xHex(cxLt.buf) != xHex(cxGt2.buf))

  // EQ is "equal AND ordered": ucomis sets ZF for equal AND for unordered, so
  // `sete` alone would make NaN == NaN true. Two setccs combined with and8.
  let cxEq = xTestCtx()
  xEmitFcmp(cxEq, 0, 0, 0, XFCmpOp{ cc: XFCmp.FEq, width: 8 })
  // NE is "not-equal OR unordered", so NaN != NaN stays true.
  let cxNe = xTestCtx()
  xEmitFcmp(cxNe, 0, 0, 0, XFCmpOp{ cc: XFCmp.FNe, width: 8 })
  assert(xHex(cxEq.buf) != xHex(cxNe.buf))
  // Both emit TWO setccs plus a combine — strictly more than an ordered
  // compare, which is the cost of getting NaN right.
  assert(len(cxEq.buf.code) > len(cxGt.buf.code))
  assert(len(cxNe.buf.code) > len(cxGt.buf.code))

  // The COMBINE op is where eq and ne actually diverge, and it must be checked
  // directly: eq is (equal AND ordered) via and8 (0x20), ne is (not-equal OR
  // unordered) via or8 (0x08). Comparing the two sequences wholesale is not
  // enough — they already differ in their setcc codes, so a swapped combine
  // slips through. Using and8 for ne makes NaN != NaN false, which is wrong.
  assert(xEmitContains(cxEq.buf, 0x20)) // and8
  assert(!xEmitContains(cxEq.buf, 0x08))
  assert(xEmitContains(cxNe.buf, 0x08)) // or8
  assert(!xEmitContains(cxNe.buf, 0x20))
}
