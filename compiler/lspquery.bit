// bit lsp (#1547) — the read-only queries: hover, goto-definition, document
// symbols, and completion. Sorts before lspserver.bit
// so the dispatch there is lowered after these. Every query builds the edited
// directory's project through the shared `lspBuildProject` (compiler/
// lspbuild.bit, which serves it from the last build when the bytes on disk and
// in the open buffers are unchanged) and reads the checker's own tables:
// `nodeSymbols`/`symbols` (resolver handoff), `nodeTypes`, and `ctx`.
//
// The re-model versus the seed: the seed keeps one AST tree per file and indexes
// `node_symbols[file_idx][node]`; the selfhost concatenates a directory's files
// into ONE tree, so a cursor's per-file (line,character) becomes a byte offset
// within the file, then a module-global offset by adding `fileStarts[fileIdx]`.
// `fileOf` maps a node span back to its file for the response URI/range.

// A located file within a built project's ROOT module: its index in the module's
// file list, its own source text, and the module-global offset it begins at.
struct LspFileLoc {
  found: bool,
  fileIdx: int,
  fileSrc: string,
  fileStart: int,
}

// Finds `path` among the root module's files. Matches on the full canonical path
// first, then the basename (unique within a module directory).
function lspLocateFile(lp: LspProject, path: string): LspFileLoc {
  let m = lp.p.mods[lp.p.root]
  let base = pathBase(path)
  let fi = 0
  while (fi < len(m.fileNames)) {
    if (m.dir + "/" + m.fileNames[fi] == path || m.fileNames[fi] == base) {
      return LspFileLoc{ found: true, fileIdx: fi,
        fileSrc: fileSource(lp.p.sm, m.files[fi]), fileStart: m.fileStarts[fi] }
    }
    fi = fi + 1
  }
  return LspFileLoc{ found: false, fileIdx: 0, fileSrc: "", fileStart: 0 }
}

// The smallest tree node whose span contains `offset` ("touching" semantics: a
// cursor at a token's end still matches it). Bounded walk (Power of 10).
function lspNodeAt(tree: Tree, offset: int): int {
  let current = tree.root
  let depth = 0
  while (depth < 256) {
    let kids = kidsOf(tree, current)
    let next = -1
    let i = 0
    while (i < len(kids)) {
      let child = kids[i]
      if (child != 0) {
        let sp = getNode(tree, child).span
        if (offset >= sp.start && offset <= sp.end) {
          next = child
          i = len(kids)
        }
      }
      i = i + 1
    }
    if (next < 0) {
      depth = 256
    } else {
      current = next
      depth = depth + 1
    }
  }
  return current
}

// The ancestor chain from the root down to the smallest node containing `offset`.
// Dot-completion needs the spliced marker's immediate parent (the `member` node).
function lspNodePath(tree: Tree, offset: int): []int {
  let out = [tree.root]
  let current = tree.root
  let depth = 0
  while (depth < 256) {
    let kids = kidsOf(tree, current)
    let next = -1
    let i = 0
    while (i < len(kids)) {
      let child = kids[i]
      if (child != 0) {
        let sp = getNode(tree, child).span
        if (offset >= sp.start && offset <= sp.end) {
          next = child
          i = len(kids)
        }
      }
      i = i + 1
    }
    if (next < 0) {
      depth = 256
    } else {
      out = append(out, next)
      current = next
      depth = depth + 1
    }
  }
  return out
}

// ---- hover -----------------------------------------------------------------

// The hover label for a symbol kind.
function lspSymbolKindLabel(k: SymbolKind): string {
  if (k == SymbolKind.LetBinding) { return "let" }
  if (k == SymbolKind.ConstBinding) { return "const" }
  if (k == SymbolKind.Param) { return "param" }
  if (k == SymbolKind.Receiver) { return "receiver" }
  if (k == SymbolKind.GenericParam) { return "type param" }
  if (k == SymbolKind.Func) { return "func" }
  if (k == SymbolKind.TypeAlias) { return "type" }
  if (k == SymbolKind.StructType) { return "struct" }
  if (k == SymbolKind.InterfaceType) { return "interface" }
  if (k == SymbolKind.EnumType) { return "enum" }
  if (k == SymbolKind.ImportNamespace || k == SymbolKind.ImportItem) { return "import" }
  if (k == SymbolKind.BuiltinType) { return "type" }
  if (k == SymbolKind.BuiltinFunc) { return "func" }
  return "?"
}

// Hover markdown for `node`: `kind name` from its resolved symbol, `: type` from
// the checker's per-node type. "" when neither is available. Doc-comment hover is
// deferred until fmt's comment collector ports (#1345).
function lspHoverText(c: Checker, node: int): string {
  let inner = ""
  let sid = 0
  if (node > 0 && node < len(c.nodeSymbols)) {
    sid = c.nodeSymbols[node]
  }
  if (sid > 0 && sid < len(c.symbols)) {
    let sym = c.symbols[sid]
    inner = lspSymbolKindLabel(sym.kind) + " " + sym.name
  }
  let ty = 0
  if (node > 0 && node < len(c.nodeTypes)) {
    ty = c.nodeTypes[node]
  }
  // `nodeTypes` is only fully populated by the `--dump-types` walk (binders get
  // an entry during the normal check, expression usages do not), so an
  // identifier/member/call the user hovers on falls back to re-deriving its type
  // the same way the checker does. The instantiations this produces are deduped
  // by `recordInstantiation`, and no checker path reports a diagnostic — which
  // is what makes it safe against a project that outlives the request
  // (lspbuild.bit), where the cheap `memo`-shaped side effects on `nodeTypes`
  // are the same answer a fresh build would re-derive. `lspFindSnapshot` rolls
  // the diagnostics sink back on every reuse so that safety is structural
  // rather than a standing invitation to break it.
  if (ty <= 0 && node > 0) {
    let tag = getNode(c.tree, node).tag
    if (isLeafTag(tag) || tag == Tag.Member || tag == Tag.Call) {
      ty = checkExprType(c, node)
    }
  }
  if (ty > 0) { // 0 == the Invalid type
    if (inner == "") {
      let sp = getNode(c.tree, node).span
      inner = c.source[sp.start:sp.end]
    }
    inner = inner + ": " + typeName(c.ctx, ty)
  }
  if (inner == "") {
    return ""
  }
  return "```bit\n" + inner + "\n```"
}

function lspOnHover(server: LspServer, d: JsonDoc, params: int, idText: string) {
  let tdp = lspTextDocPosition(d, params)
  if (!tdp.ok) {
    lspRespond(idText, "null")
    return
  }
  let path = lspUriToPath(tdp.uri)
  if (path == "") {
    lspRespond(idText, "null")
    return
  }
  let lp = lspBuildProject(server, pathDir(path))
  if (len(lp.mods) == 0 || !lp.checkedOk) {
    lspRespond(idText, "null")
    return
  }
  let loc = lspLocateFile(lp, path)
  if (!loc.found) {
    lspRespond(idText, "null")
    return
  }
  let c = lp.mods[lp.p.root]
  let offset = loc.fileStart + lspPosToByte(loc.fileSrc, tdp.pos)
  let nodePath = lspNodePath(c.tree, offset)
  let node = nodePath[len(nodePath) - 1]
  if (node == 0) {
    lspRespond(idText, "null")
    return
  }
  // A member's name (`recv.NAME`) resolves against the receiver's TYPE
  // (#2327), never as a bare name — that is what found an unrelated
  // same-named local/param elsewhere in the project. No fallback to
  // `lspHoverText` on a miss: showing nothing beats showing the wrong symbol.
  let mref = lspPathMemberName(c.tree, nodePath)
  let text = ""
  if (mref.isMemberName) {
    text = lspMemberHoverText(c, mref.memberNode, mref.nameNode)
  } else {
    text = lspHoverText(c, node)
  }
  if (text == "") {
    lspRespond(idText, "null")
    return
  }
  lspRespond(idText, "{\"contents\":{\"kind\":\"markdown\",\"value\":" +
    jsonEncodeString(text) + "}}")
}

// ---- definition ------------------------------------------------------------

// The identifier span to highlight for a declaring node: a func's name is kid 1
// (kid 0 is the optional receiver); struct/interface/enum/alias names are kid 0;
// everything else already points at its own name.
// defNameSpan.
function lspDefNameSpan(tree: Tree, decl: int): Span {
  let n = getNode(tree, decl)
  if (n.tag == Tag.FuncDecl) {
    return getNode(tree, kidsOf(tree, decl)[1]).span
  }
  if (n.tag == Tag.StructDecl || n.tag == Tag.InterfaceDecl ||
      n.tag == Tag.EnumDecl || n.tag == Tag.TypeAlias) {
    return getNode(tree, kidsOf(tree, decl)[0]).span
  }
  return n.span
}

// A span that is module-global WITHIN `modIdx`'s own tree (every module has
// its own concatenated tree+source, per lspBuildProject's header comment)
// rendered as an LSP Location `{"uri":...,"range":...}` against the file it
// falls in there. `fileOf` maps the offset to a file; the range is computed
// against that file's own text with a per-file offset.
function lspModSpanLocationJson(p: Project, modIdx: int, span: Span): string {
  let m = p.mods[modIdx]
  let fl = fileOf(m.fileStarts, span.start)
  let src = fileSource(p.sm, m.files[fl.fileIdx])
  let start = fl.offset
  let end = fl.offset + (span.end - span.start)
  let uri = lspPathToUri(m.dir + "/" + m.fileNames[fl.fileIdx])
  return "{\"uri\":" + jsonEncodeString(uri) + ",\"range\":" +
    lspRangeJson(lspSpanToRange(src, start, end)) + "}"
}

// As `lspModSpanLocationJson`, against the ROOT module — the common case.
function lspSpanLocationJson(p: Project, span: Span): string {
  return lspModSpanLocationJson(p, p.root, span)
}

// The result of following a symbol's `importedFromModule`/`importedFromSymbol`
// chain (#2330) to the module and symbol that actually DECLARES it: `modIdx`
// is a module id into `lp.mods`/`lp.p.mods`, valid only when `found`.
struct LspResolvedSymbol {
  found: bool,
  modIdx: int,
  sym: Symbol,
}

// Follows an import chain — an `import { x } from "std/y"` binding, or the
// auto-imported prelude, both of which record `importedFromModule` the same
// way (resolve.bit's `rDeclareImportItem` / the prelude re-export) — to the
// symbol that actually owns a declaration node, rather than the import
// statement's own binding name. Bounded (Power of 10): a well-formed program
// cannot have an import chain longer than its own module count, so 8 hops is
// generous headroom without trusting the data to be acyclic.
function lspResolveImportChain(lp: LspProject, modIdx: int, sym: Symbol): LspResolvedSymbol {
  let curMod = modIdx
  let cur = sym
  let hops = 0
  while (cur.importedFromModule >= 0 && hops < 8) {
    hops = hops + 1
    if (cur.importedFromModule >= len(lp.mods)) {
      return LspResolvedSymbol{ found: false, modIdx: 0, sym: cur }
    }
    let targetC = lp.mods[cur.importedFromModule]
    if (cur.importedFromSymbol <= 0 || cur.importedFromSymbol >= len(targetC.symbols)) {
      return LspResolvedSymbol{ found: false, modIdx: 0, sym: cur }
    }
    curMod = cur.importedFromModule
    cur = targetC.symbols[cur.importedFromSymbol]
  }
  if (cur.importedFromModule >= 0) {
    return LspResolvedSymbol{ found: false, modIdx: 0, sym: cur } // hop limit
  }
  return LspResolvedSymbol{ found: true, modIdx: curMod, sym: cur }
}

function lspOnDefinition(server: LspServer, d: JsonDoc, params: int, idText: string) {
  let tdp = lspTextDocPosition(d, params)
  if (!tdp.ok) {
    lspRespond(idText, "null")
    return
  }
  let path = lspUriToPath(tdp.uri)
  if (path == "") {
    lspRespond(idText, "null")
    return
  }
  let lp = lspBuildProject(server, pathDir(path))
  if (len(lp.mods) == 0) {
    lspRespond(idText, "null")
    return
  }
  let loc = lspLocateFile(lp, path)
  if (!loc.found) {
    lspRespond(idText, "null")
    return
  }
  let c = lp.mods[lp.p.root]
  let offset = loc.fileStart + lspPosToByte(loc.fileSrc, tdp.pos)
  let nodePath = lspNodePath(c.tree, offset)
  let node = nodePath[len(nodePath) - 1]
  // A member's name (`recv.NAME`) has no entry in `nodeSymbols` — it is not a
  // standalone reference — so it resolves against the receiver's TYPE instead
  // (#2329), the same technique hover (#2327) and completion already use.
  let mref = lspPathMemberName(c.tree, nodePath)
  if (mref.isMemberName) {
    let recvType = checkExprType(c, kidsOf(c.tree, mref.memberNode)[0])
    if (recvType > 0) {
      let declNode = lspFindMemberDecl(c, recvType, lspMemberNodeText(c, mref.nameNode))
      if (declNode > 0) {
        lspRespond(idText, lspSpanLocationJson(lp.p, getNode(c.tree, declNode).span))
        return
      }
    }
    lspRespond(idText, "null")
    return
  }
  let sid = 0
  if (node > 0 && node < len(c.nodeSymbols)) {
    sid = c.nodeSymbols[node]
  }
  if (sid <= 0 || sid >= len(c.symbols)) {
    lspRespond(idText, "null")
    return
  }
  let sym = c.symbols[sid]
  if (sym.importedFromModule >= 0) {
    // #2330: an imported/stdlib/prelude name — jump to its REAL declaration
    // in the source module, not the import statement's own binding name.
    // Checked BEFORE `sym.decl == 0` on purpose: the auto-imported prelude
    // (rInjectPrelude, resolve.bit) sets `decl: 0` on its synthetic binding —
    // there is no explicit `import` statement in the user's file for it — but
    // `importedFromModule`/`importedFromSymbol` still name the real symbol.
    let resolved = lspResolveImportChain(lp, lp.p.root, sym)
    if (!resolved.found || resolved.sym.decl == 0) {
      lspRespond(idText, "null")
      return
    }
    lspRespond(idText, lspModSpanLocationJson(lp.p, resolved.modIdx,
      lspDefNameSpan(lp.mods[resolved.modIdx].tree, resolved.sym.decl)))
    return
  }
  if (sym.decl == 0) {
    lspRespond(idText, "null") // a builtin: no declaration anywhere to jump to
    return
  }
  lspRespond(idText, lspSpanLocationJson(lp.p, lspDefNameSpan(c.tree, sym.decl)))
}

// ---- document symbols ------------------------------------------------------
//
// The nested `DocumentSymbol` tree itself (#2333) is compiler/lspsymbols.bit:
// a struct's fields and its methods as `children`, rather than one flat
// entry per top-level decl.

function lspOnDocumentSymbol(server: LspServer, d: JsonDoc, params: int, idText: string) {
  let doc = jsonGet(d, params, "textDocument")
  let uri = jsonStrOf(d, jsonGet(d, doc, "uri"))
  if (uri == "") {
    lspRespond(idText, "[]")
    return
  }
  let path = lspUriToPath(uri)
  if (path == "") {
    lspRespond(idText, "[]")
    return
  }
  let lp = lspBuildProject(server, pathDir(path))
  if (len(lp.mods) == 0) {
    lspRespond(idText, "[]")
    return
  }
  let loc = lspLocateFile(lp, path)
  if (!loc.found) {
    lspRespond(idText, "[]")
    return
  }
  let items = lspDocumentSymbolTree(lp, loc.fileIdx)
  lspRespond(idText, "[" + lspJoinComma(items) + "]")
}

// ---- completion ------------------------------------------------------------

// The LSP CompletionItemKind for a symbol kind.
// completionKind.
function lspCompletionKind(k: SymbolKind): int {
  if (k == SymbolKind.Func || k == SymbolKind.BuiltinFunc) { return 3 } // Function
  if (k == SymbolKind.StructType) { return 22 } // Struct
  if (k == SymbolKind.InterfaceType) { return 8 } // Interface
  if (k == SymbolKind.TypeAlias || k == SymbolKind.BuiltinType) { return 7 } // Class
  if (k == SymbolKind.ConstBinding) { return 21 } // Constant
  if (k == SymbolKind.ImportNamespace || k == SymbolKind.ImportItem) { return 9 } // Module
  return 6 // Variable
}

function lspCompletionItemJson(label: string, kind: int, detail: string, hasDetail: bool): string {
  let s = "{\"label\":" + jsonEncodeString(label) + ",\"kind\":${kind}"
  if (hasDetail) {
    s = s + ",\"detail\":" + jsonEncodeString(detail)
  }
  return s + "}"
}

function lspCompletionList(items: []string): string {
  return "{\"isIncomplete\":false,\"items\":[" + lspJoinComma(items) + "]}"
}

// Module-scope completion: every top-level and imported name visible in the root
// module. Reads the resolver's symbol table, keeping module-scoped decls,
// namespace aliases, and imported names (including the auto-imported prelude);
// locals and params are excluded, matching the seed's `all_names`.
function lspScopeCompletion(c: Checker): string {
  let items = []string(0)
  let seen = map<string, bool>{}
  let i = 1 // symbol 0 is the reserved none/poison sentinel
  while (i < len(c.symbols)) {
    let sym = c.symbols[i]
    i = i + 1
    let visible = sym.moduleScoped || sym.kind == SymbolKind.ImportItem ||
      sym.kind == SymbolKind.ImportNamespace
    if (!visible || sym.name == "" || sym.name == "_") {
      continue
    }
    let (_, dup) = seen[sym.name]
    if (dup) {
      continue
    }
    seen[sym.name] = true
    items = append(items, lspCompletionItemJson(sym.name, lspCompletionKind(sym.kind), "", false))
  }
  return lspCompletionList(items)
}

// The completion-item detail for a struct field / method: its type name.
function lspTypeDetail(ctx: TypeContext, id: int): string {
  return typeName(ctx, id)
}

// `.`-completion for a receiver of type `recvType`: its struct fields and its
// methods (which, for an interface receiver, are the interface's methods). Reads
// `ctx.structFields` (keyed "typeId.field") and `ctx.typeMethodNames` /
// `ctx.methodSigs` (keyed "typeId" / "typeId.member").
function lspMemberCompletion(ctx: TypeContext, recvType: int): string {
  let items = []string(0)
  let prefix = "${recvType}."
  for (k, v) of ctx.structFields {
    if (len(k) > len(prefix) && k[0:len(prefix)] == prefix) {
      let field = k[len(prefix):len(k)]
      items = append(items, lspCompletionItemJson(field, 5, lspTypeDetail(ctx, v), true))
    }
  }
  let (names, ok) = ctx.typeMethodNames["${recvType}"]
  if (ok) {
    let mi = 0
    while (mi < len(names)) {
      let name = names[mi]
      mi = mi + 1
      let (sig, hasSig) = ctx.methodSigs["${recvType}.${name}"]
      if (hasSig) {
        items = append(items, lspCompletionItemJson(name, 2, lspTypeDetail(ctx, sig), true))
      } else {
        items = append(items, lspCompletionItemJson(name, 2, "", false))
      }
    }
  }
  return lspCompletionList(items)
}

function lspOnCompletion(server: LspServer, d: JsonDoc, params: int, idText: string) {
  let empty = lspCompletionList([]string(0))
  let tdp = lspTextDocPosition(d, params)
  if (!tdp.ok) {
    lspRespond(idText, empty)
    return
  }
  let path = lspUriToPath(tdp.uri)
  if (path == "") {
    lspRespond(idText, empty)
    return
  }
  let dir = pathDir(path)
  let (text, isOpen) = server.overlays[path]
  if (!isOpen) {
    lspRespond(idText, empty)
    return
  }
  let fileOffset = lspPosToByte(text, tdp.pos)
  let dotBefore = fileOffset > 0 && text[fileOffset - 1] == u8('.')
  if (!dotBefore) {
    let lp = lspBuildProject(server, dir)
    if (len(lp.mods) == 0 || !lp.checkedOk) {
      lspRespond(idText, empty)
      return
    }
    lspRespond(idText, lspScopeCompletion(lp.mods[lp.p.root]))
    return
  }
  lspDotCompletion(server, dir, path, text, fileOffset, idText)
}

// Splices a throwaway identifier at the cursor so the receiver before the bare
// `.` still parses, rebuilds against that overlay, and lists the receiver type's
// members. The seed's "dummy identifier" technique — cheaper than teaching the
// parser to accept an incomplete member expression.
function lspDotCompletion(server: LspServer, dir: string, path: string,
    text: string, fileOffset: int, idText: string) {
  let empty = lspCompletionList([]string(0))
  let marker = "zqx"
  let spliced = text[0:fileOffset] + marker + text[fileOffset:len(text)]
  // A fresh overlay map with the splice, so the server's real overlays are
  // untouched (a struct/map is a reference in Bit).
  let ov = map<string, string>{}
  for (k, v) of server.overlays {
    ov[k] = v
  }
  ov[path] = spliced
  let lp = lspBuildProjectOverlay(server, ov, dir, false)
  if (len(lp.mods) == 0 || !lp.checkedOk) {
    lspRespond(idText, empty)
    return
  }
  let loc = lspLocateFile(lp, path)
  if (!loc.found) {
    lspRespond(idText, empty)
    return
  }
  let c = lp.mods[lp.p.root]
  let offset = loc.fileStart + fileOffset
  let path2 = lspNodePath(c.tree, offset)
  if (len(path2) < 2) {
    lspRespond(idText, empty)
    return
  }
  let markerNode = path2[len(path2) - 1]
  let parent = path2[len(path2) - 2]
  if (getNode(c.tree, parent).tag != Tag.Member) {
    lspRespond(idText, empty)
    return
  }
  let mk = kidsOf(c.tree, parent)
  if (mk[1] != markerNode) {
    lspRespond(idText, empty)
    return
  }
  // The receiver's type is re-derived here rather than read from `nodeTypes`:
  // that map is only fully populated by the `--dump-types` walk, not the normal
  // check, so an expression receiver has no entry. `checkExprType` is what
  // `checkMember` itself uses to type a receiver.
  let recvType = checkExprType(c, mk[0])
  if (recvType <= 0) {
    lspRespond(idText, empty)
    return
  }
  lspRespond(idText, lspMemberCompletion(c.ctx, recvType))
}
