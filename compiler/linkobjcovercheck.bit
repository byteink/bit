// Pins loFindSymbolCovering's binary search (linkobj.bit, #7256) to the
// linear scan it replaced, kept below as the reference. The fixture holds
// alias groups (several symbols at one offset, including the first offset)
// and declares symbols out of offset order, so `order` is a real
// permutation: the search must return the FIRST entry of a group in
// `order`, not merely an entry at the right offset.

// The pre-#7256 linear scan, verbatim: the oracle for the tie-break.
fn loCoveringLinear(symbols: []LoRawSymbol, order: []int, offset: int): int {
  let best = order[0]
  let i = 0
  while (i < len(order)) {
    let symOff = symbols[order[i]].offset
    if (symOff <= offset && symOff > symbols[best].offset) {
      best = order[i]
    }
    i = i + 1
  }
  return best
}

fn checkFindSymbolCovering() {
  let offs = [40, 8, 8, 0, 24, 40, 0, 8, 63, 24, 40]
  let syms = []LoRawSymbol(0)
  let i = 0
  while (i < len(offs)) {
    syms = append(syms, loSym("s${i}", 0, offs[i], 0, LoBinding.Global, 1))
    i = i + 1
  }
  let items = []int(0)
  i = 0
  while (i < len(offs)) {
    items = append(items, i)
    i = i + 1
  }
  let order = loSortByOffset(syms, items)
  // Every offset from below the first symbol to past the last one.
  let off = -2
  while (off <= 66) {
    assert(loFindSymbolCovering(syms, order, off) == loCoveringLinear(syms, order, off))
    off = off + 1
  }
  // The group at 8 is symbols 1, 2, 7: the first in `order` wins.
  assert(loFindSymbolCovering(syms, order, 9) == 1)
  // A one-entry order answers its only entry on either side of it.
  assert(loFindSymbolCovering(syms, [8], 70) == 8)
  assert(loFindSymbolCovering(syms, [8], 5) == 8)
}
