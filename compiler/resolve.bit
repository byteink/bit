// Self-host Stage 2 (#1503): the resolver proper — split out of resolve.bit.
// Pass 2 (bodies, type expressions, initializers) lives in resolvebody.bit;
// the symbol/Module substrate and the predeclared universe live in symbols.bit.

// ============================================================================
// The resolver proper — `Resolver`, passes 1 and 2
// ============================================================================
//
// ONE STRUCTURAL DIFFERENCE FROM THE SEED, and it simplifies everything: the
// seed carries `files: []ModuleFile` and threads a `file_idx` through every
// function, because it keeps one tree per file. bit2 CONCATENATES a module's
// files into a single `source` + `tree` (see project.bit), so there is exactly
// one tree here and no `file_idx` dimension at all. Spans are module-global;
// `rSpan` remaps them back to the owning file the same way validate.bit's
// `vSpan` does.
//
// Diagnostic codes: 40 undefined_name,
// 42 duplicate_declaration, 43 use_before_init, 44 import_cycle,
// 45 import_not_found, 46 unexported_name, 47 type_cycle,
// 48 shadows_predeclared.

const ecUndefinedName = 40
const ecDuplicateDeclaration = 42
const ecUseBeforeInit = 43
const ecImportCycle = 44
const ecImportNotFound = 45
const ecUnexportedName = 46
const ecTypeCycle = 47
const ecShadowsPredeclared = 48
const ecImmutableAssign = 62

// A lexical scope. `parent` is -1 for the universe (the chain's root).
// `pending` holds names this scope declares LATER in program order — a
// reference that finds a name here rather than in `names` is a use-before-init,
// not an undefined name. That distinction is the only reason `pending` exists.
struct Scope {
  parent: int,
  names: map<string, int>,
  pending: map<string, bool>,
}

// One inner-`let`-hides-outer-local hit (spec/LINT.md E0213 `shadowed-local`).
// Recorded here instead of reported directly: this is resolver bookkeeping for
// a LINT finding, not a `bit check` diagnostic, so it never touches `r.diags` —
// `bit lint` reads `Resolver.shadows` after a resolve pass and decides
// severity/message itself.
struct ShadowHit {
  inner: int,
  outer: int,
  name: string,
}

// Resolver state for ONE module. Structs are references in Bit, so every helper
// mutates in place and nothing is threaded back by return value.
struct Resolver {
  diags: Diagnostics,
  // The module being resolved: its concatenated tree/source, and the file table
  // spans remap against.
  tree: Tree,
  source: string,
  fileStarts: []int,
  files: []int,
  // Import path text -> module id, and every module resolved so far (indexed by
  // module id) so an import can be checked against its target's exports.
  importPaths: map<string, int>,
  // Import path text -> a bit.lock/cache failure detail (#1737), for exactly
  // the paths `importPaths` maps to `modPkgFail`. See `SrcModule.pkgFail`.
  importFailDetail: map<string, string>,
  allModules: []Module,
  // The prelude module's id whose exports auto-import here, or -1 (this IS the
  // prelude, or the build ships no stdlib).
  prelude: int,
  symbols: []Symbol,
  scopes: []Scope,
  exports: map<string, int>,
  // node index -> symbol id (0 = none). Parallel to the tree's nodes.
  nodeSymbols: []int,
  universe: int,
  moduleScope: int,
  // E0213 `shadowed-local` hits, in declaration order. See `ShadowHit`.
  shadows: []ShadowHit,
  // #2917: `rFindSiblingDeclaring`'s directory scan, memoized per directory.
  // The scan depends only on the directory's file set and this module's own
  // declared names, both fixed for the Resolver's lifetime, so a directory is
  // scanned at most once no matter how many undefined names it explains. See
  // `SiblingScan` in resolvesibling.bit.
  siblingScans: map<string, SiblingScan>,
  // #2919: gates the call to `rFindSiblingDeclaring` below. `false` for
  // `bit lint`'s per-file resolves, whose diagnostics sink is never read —
  // see the call site.
  siblingScanEnabled: bool,
}

// ---- small helpers ---------------------------------------------------------

fn rIdentText(r: Resolver, node: int): string {
  let sp = getNode(r.tree, node).span
  return r.source[sp.start:sp.end]
}

// Strips the surrounding quotes from a string_lit leaf's raw source text.
// Import paths are plain strings (the grammar requires `.string_lit`), so no
// escape decoding is needed — same reasoning as the seed's `stringLitText`.
fn rStringLitText(r: Resolver, node: int): string {
  return stringLitText(r.source, getNode(r.tree, node).span)
}

// Module-global span -> the owning file's span. Same remap as validate.bit's
// `vSpan`: bit2 concatenates a module's files, the renderer needs per-file
// offsets.
fn rSpan(r: Resolver, node: int): Span {
  let sp = getNode(r.tree, node).span
  let loc = fileOf(r.fileStarts, sp.start)
  return Span{ file: r.files[loc.fileIdx], start: loc.offset, end: loc.offset + (sp.end - sp.start) }
}

fn rError(r: Resolver, node: int, code: int, message: string, hint: string) {
  report(r.diags, code, rSpan(r, node), message, hint)
}

fn rErrorNoHint(r: Resolver, node: int, code: int, message: string) {
  reportNoHint(r.diags, code, rSpan(r, node), message)
}

fn rWarn(r: Resolver, node: int, code: int, message: string, hint: string) {
  warn(r.diags, code, rSpan(r, node), message, hint)
}

fn rPushScope(r: Resolver, parent: int): int {
  let id = len(r.scopes)
  r.scopes = append(r.scopes, Scope{ parent: parent, names: map<string, int>{}, pending: map<string, bool>{} })
  return id
}

fn rNewSymbol(r: Resolver, s: Symbol): int {
  let id = len(r.symbols)
  r.symbols = append(r.symbols, s)
  return id
}

fn rSetNodeSymbol(r: Resolver, node: int, id: int) {
  r.nodeSymbols[node] = id
}

// Looks a name up in one scope's active bindings; -1 when absent.
fn rScopeGet(r: Resolver, scopeId: int, name: string): int {
  let (id, ok) = r.scopes[scopeId].names[name]
  if (ok) {
    return id
  }
  return -1
}

// A symbol with no declaration site: the predeclared identifiers, and the
// implicit `Self` bound inside an interface body (§14.3).
fn rInjectImplicitSymbol(r: Resolver, scopeId: int, name: string, kind: SymbolKind) {
  let id = rNewSymbol(r, builtinSymbol(name, kind))
  r.scopes[scopeId].names[name] = id
}

fn rUnwrapExport(r: Resolver, idx: int): int {
  if (getNode(r.tree, idx).tag == Tag.Export) {
    return kidsOf(r.tree, idx)[0]
  }
  return idx
}

fn newResolver(diags: Diagnostics, m: SrcModule, allModules: []Module, prelude: int, siblingScanEnabled: bool): Resolver {
  let r = Resolver{
    diags: diags, tree: m.tree, source: m.source, fileStarts: m.fileStarts, files: m.files,
    importPaths: m.imports, importFailDetail: m.pkgFail, allModules: allModules, prelude: prelude,
    symbols: []Symbol(0), scopes: []Scope(0), exports: map<string, int>{},
    nodeSymbols: []int(len(m.tree.nodes)), universe: 0, moduleScope: 0,
    shadows: []ShadowHit(0), siblingScans: map<string, SiblingScan>{},
    siblingScanEnabled: siblingScanEnabled,
  }
  // Index 0 is the reserved `none` sentinel, matching the tree's node 0.
  let sink = rNewSymbol(r, builtinSymbol("", SymbolKind.Poison))
  r.universe = rPushScope(r, -1)
  let types = predeclaredTypes()
  let i = 0
  while (i < len(types)) {
    rInjectImplicitSymbol(r, r.universe, types[i], SymbolKind.BuiltinType)
    i = i + 1
  }
  let funcs = predeclaredFuncs()
  let j = 0
  while (j < len(funcs)) {
    rInjectImplicitSymbol(r, r.universe, funcs[j], SymbolKind.BuiltinFunc)
    j = j + 1
  }
  r.moduleScope = rPushScope(r, r.universe)
  return r
}

// ---- declaring names -------------------------------------------------------

fn rReportDuplicate(r: Resolver, node: int, name: string) {
  rError(r, node, ecDuplicateDeclaration, "'${name}' is already declared in this scope",
    "rename or remove one of the declarations")
}

// The second span for the E0042 above (#2129). `prior` is the symbol id the
// scope lookup already returned — the collision is how it was detected, so the
// first declaration's node was in hand all along and simply thrown away.
// Reporting one span while advising "rename or remove one of the DECLARATIONS"
// left the other to be found by grep, and §17.1 makes a module a DIRECTORY of
// `.bit` files sharing one namespace, so it is routinely in a different file
// from the one just edited.
//
// SEPARATE from `rReportDuplicate` rather than a parameter on it because the
// third caller cannot supply one: `rSeenDuplicate` (resolvebody.bit) checks
// struct fields, enum variants and interface methods against a
// `map<string, bool>`, which records that a name was seen and not where. Those
// collisions are also siblings inside one declaration, where both spans are
// already on screen. Emit this only from the scope-table paths, which have a
// real Symbol.
//
// Nothing is emitted when the prior symbol has no declaration node:
// `builtinSymbol` (universe predeclared names, the implicit `Self`) carries
// `decl: 0`, and node 0 would render at the top of the file. Those collisions
// are `rCheckShadowsPredeclared`'s job.
fn rNotePriorDecl(r: Resolver, prior: int) {
  if (prior < 0 || prior >= len(r.symbols)) {
    return
  }
  let first = r.symbols[prior].decl
  if (first == 0) {
    return
  }
  note(r.diags, rSpan(r, rDeclNameNode(r, first)), "previously declared here")
}

// The NAME node inside a declaration. `Symbol.decl` is not uniform: a binding
// and an import binder store the name node itself, but a function, extern or
// type stores the whole declaration (`decl: idx` in `rNamedTopDecl` and its
// siblings), and underlining `function shared(): int { return 1 }` entire buries
// the one identifier the message is about.
//
// Finds it by TAG rather than by a per-form kid index, so no declaration shape
// has to be enumerated here and a future one cannot silently pick the wrong kid:
// the name is the first Ident among the leading kids. Two is enough for every
// form — `[name, ...]` for struct/enum/alias/interface/extern, `[recv, name,
// ...]` for a FuncDecl, whose receiver is 0 for exactly the free functions that
// reach the module scope. Anything unrecognised falls back to the decl node,
// which is what was rendered before this narrowing and is never wrong, only wide.
fn rDeclNameNode(r: Resolver, decl: int): int {
  let d = rUnwrapExport(r, decl)
  if (getNode(r.tree, d).tag == Tag.Ident) {
    return d
  }
  let k = kidsOf(r.tree, d)
  let i = 0
  while (i < len(k) && i < 2) {
    if (k[i] != 0 && getNode(r.tree, k[i]).tag == Tag.Ident) {
      return k[i]
    }
    i = i + 1
  }
  return d
}

fn rCheckShadowsPredeclared(r: Resolver, node: int, name: string) {
  if (rScopeGet(r, r.universe, name) >= 0) {
    rWarn(r, node, ecShadowsPredeclared, "'${name}' shadows a predeclared identifier",
      "shadowing predeclared names is discouraged")
  }
}

// Declares `nameNode` in the module's flat top scope (top-level declarations and
// import bindings). The blank identifier never binds.
fn rInsertModuleSymbol(r: Resolver, nameNode: int, s: Symbol): int {
  if (s.name == "_") {
    rSetNodeSymbol(r, nameNode, 0)
    return 0
  }
  let priorTop = rScopeGet(r, r.moduleScope, s.name)
  if (priorTop >= 0) {
    rReportDuplicate(r, nameNode, s.name)
    rNotePriorDecl(r, priorTop)
    rSetNodeSymbol(r, nameNode, 0)
    return 0
  }
  let id = rNewSymbol(r, s)
  r.symbols[id].moduleScoped = true
  r.scopes[r.moduleScope].names[s.name] = id
  if (s.exported) {
    r.exports[s.name] = id
  }
  rCheckShadowsPredeclared(r, nameNode, s.name)
  rSetNodeSymbol(r, nameNode, id)
  return id
}

// Declares a local (param, receiver, generic param, loop/catch binder, or a
// block-local let/const being activated). Clears any pending (TDZ) entry so
// later same-scope references resolve normally.
fn rActivateLocal(r: Resolver, nameNode: int, kind: SymbolKind, scopeId: int): int {
  let name = rIdentText(r, nameNode)
  if (name == "_") {
    rSetNodeSymbol(r, nameNode, 0)
    return 0
  }
  let priorLocal = rScopeGet(r, scopeId, name)
  if (priorLocal >= 0) {
    rReportDuplicate(r, nameNode, name)
    rNotePriorDecl(r, priorLocal)
    rSetNodeSymbol(r, nameNode, 0)
    return 0
  }
  let id = rNewSymbol(r, Symbol{ name: name, kind: kind, decl: nameNode, fileIdx: 0, exported: false,
    importedFromModule: -1, importedFromSymbol: -1, namespaceModule: -1 })
  delete(r.scopes[scopeId].pending, name)
  r.scopes[scopeId].names[name] = id
  rCheckShadowsPredeclared(r, nameNode, name)
  // E0213 `shadowed-local` (spec/LINT.md §4): only a `let`/`const`-shaped local
  // — this also covers for/catch/match binders, which activate with these same
  // two kinds. A PARAMETER or receiver shadowing an outer name is deliberately
  // not recorded: `function f(count: int)` beside a module-level `count` is the
  // single highest-volume shape of "shadowing" in real code, and a parameter's
  // whole lexical extent IS the function body, so there is no earlier read in
  // the same scope that silently changes meaning the way a mid-block `let`
  // does. Recording it would make the rule too noisy to leave enabled.
  if (kind == SymbolKind.LetBinding || kind == SymbolKind.ConstBinding) {
    let outer = rFindShadowedLocal(r, scopeId, name)
    if (outer >= 0) {
      r.shadows = append(r.shadows, ShadowHit{ inner: nameNode, outer: outer, name: name })
    }
  }
  rSetNodeSymbol(r, nameNode, id)
  return id
}

// The nearest ANCESTOR scope binding `name` to a user declaration, or -1.
// `decl != 0` is what makes this rule not double-report: universe predeclared
// symbols and prelude auto-imports both carry no decl node (`builtinSymbol`,
// `rInjectPrelude`), so a `let` hiding either is invisible here — E0048
// `shadows_predeclared` already covers the predeclared case, and the prelude
// case is deliberately unreported by anything (spec/LINT.md §8). Starts at
// `scopeId`'s PARENT, not `scopeId` itself: a same-scope collision was already
// turned away above as `duplicate_declaration`, and same-scope is not
// shadowing.
fn rFindShadowedLocal(r: Resolver, scopeId: int, name: string): int {
  let cur = r.scopes[scopeId].parent
  while (cur >= 0) {
    let found = rScopeGet(r, cur, name)
    if (found >= 0 && r.symbols[found].decl != 0) {
      return r.symbols[found].decl
    }
    cur = r.scopes[cur].parent
  }
  return -1
}

// Resolves an identifier reference: walks the parent chain, preferring an
// already-active binding, falling back to a pending one to report
// use_before_init instead of a misleading undefined_name. The blank identifier
// never resolves and never errors (write-only, §5.1).
fn rResolveIdentRef(r: Resolver, node: int, scopeId: int) {
  let name = rIdentText(r, node)
  if (name == "_") {
    rSetNodeSymbol(r, node, 0)
    return
  }
  let cur = scopeId
  while (cur >= 0) {
    let found = rScopeGet(r, cur, name)
    if (found >= 0) {
      rSetNodeSymbol(r, node, found)
      return
    }
    let (isPending, pendingOk) = r.scopes[cur].pending[name]
    if (pendingOk && isPending) {
      rError(r, node, ecUseBeforeInit, "'${name}' is used before it is declared",
        "move this reference after the declaration")
      rSetNodeSymbol(r, node, 0)
      return
    }
    cur = r.scopes[cur].parent
  }
  // #2869: an unresolvable name may live in a sibling `.bit` file this build
  // never loaded — the build target named a FILE rather than the directory
  // (§17.1: naming a file selects only that file, naming the directory
  // selects all of it). If it were a directory build, every sibling's
  // declarations would already be in `r.scopes` and this scan would find
  // nothing new; it only ever fires on the failure path this function is
  // already on, so it costs nothing in the common case.
  //
  // #2919: skipped when `siblingScanEnabled` is `false` — see that field.
  let sib = ""
  if (r.siblingScanEnabled) {
    sib = rFindSiblingDeclaring(r, node, name)
  }
  if (sib != "") {
    rError(r, node, ecUndefinedName, "undefined name '${name}'",
      "'${name}' is declared in ${sib}, which is part of this directory's module — build the directory rather than the file: `bit build .` or `bit run .`")
    rSetNodeSymbol(r, node, 0)
    return
  }
  rErrorNoHint(r, node, ecUndefinedName, "undefined name '${name}'")
  rSetNodeSymbol(r, node, 0)
}

// `rFindSiblingDeclaring` and its helpers live in resolvesibling.bit (#2869):
// split out to stay under the repo's 800-line E0200 limit.

// Auto-imports the prelude's exports into this module's flat scope (SPEC §17),
// as if each were an explicit `import { name } from "std/core"`. Runs AFTER the
// module's own top-level declarations, so a user name shadows the prelude rather
// than colliding with it — the injected binding is simply skipped.
fn rInjectPrelude(r: Resolver) {
  if (r.prelude < 0 || r.prelude >= len(r.allModules)) {
    return
  }
  for (name, sid) of r.allModules[r.prelude].exports {
    if (rScopeGet(r, r.moduleScope, name) >= 0) {
      continue // the user's own name wins
    }
    let id = rNewSymbol(r, Symbol{ name: name, kind: SymbolKind.ImportItem, decl: 0, fileIdx: 0,
      exported: false, importedFromModule: r.prelude, importedFromSymbol: sid, namespaceModule: -1 })
    r.scopes[r.moduleScope].names[name] = id
  }
}
