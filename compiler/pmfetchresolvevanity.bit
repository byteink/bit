// compiler/pmfetchresolvevanity.bit — vanity-name resolution over HTTPS
// (#5600, split off compiler/pmfetchresolve.bit under the 800-line E0200
// limit, spec/LINT.md §4). Sibling of pmfetchresolve.bit (same module),
// which still owns ref resolution, the content-addressed git fetch/cache,
// git-remote identity (`GitRemoteRepo`) and a fetched dependency's own
// `bit.json` (`readManifest`). This file owns SPEC §17.7's whole vanity
// path: fetching and validating a `bit-import:` document
// (`resolveVanityUrl`, `checkAndParseVanityDoc`, `parseVanityDoc`) and the
// `BIT_VANITY_ORIGIN` test-only request-URL override (`vanityRequestUrl`).
// The check-side mirror of this exact boundary already exists:
// pmfetchresolvevanitycheck.bit was split off pmfetchresolvecheck.bit under
// #4322 for the same reason, before the production code followed it here.
// See pmfetch.bit's own module header for the design notes that still
// apply here unchanged: the subprocess timeout discipline `runGit`
// (pmfetchtail.bit) implements, and the vanity-resolution deadline/body-cap
// rationale.

// --- vanity name resolution (SPEC §17.7) ---------------------------------

// The response body cap: a `bit-import:` document exceeding this before its
// single line completes is a hard failure, not a truncation.
export const vanityMaxDocBytes: int = 4096

// The wall-clock deadline for resolving one vanity name, separate from
// `defaultTimeoutMs`'s 30s git-fetch budget — a static single-line GET has no
// reason to share a git clone's budget (SPEC §17.7).
export const vanityTimeoutMs: int = 5000

// Enforces the `vanityMaxDocBytes` cap on a vanity document's body BEFORE any
// parsing — an oversized document is a hard failure, not a truncation.
// `std/http.get` buffers the whole response body before this ever runs (see
// the module header), so this bounds what pmfetch itself will PARSE, not how
// many bytes an oversized response makes the process buffer in memory first.
fn checkVanityCap(body: string): ()! {
  if (len(body) > vanityMaxDocBytes) {
    fail newError("pmfetch: vanity document exceeds the ${vanityMaxDocBytes}-byte cap (got ${len(body)} bytes)")
  }
}

// `body` up to (not including) its first newline, with one trailing `\r`
// stripped if present (a CRLF-terminated line).
fn firstLine(body: string): string {
  let i = 0
  while (i < len(body) && body[i] != '\n') {
    i = i + 1
  }
  let line = body[0:i]
  if (len(line) > 0 && line[len(line) - 1] == '\r') {
    line = line[0:len(line) - 1]
  }
  return line
}

// One resolved `bit-import:` document (SPEC §17.7): `gitUrl` is the
// required `<gitURL>` token; `dir`, from the format's extension point, is
// the subdirectory of the fetched repository that is the package's own
// root — "" when the document names no `dir` field, meaning the repository
// root, exactly as every vanity document resolved before this field
// existed.
class VanityDoc {
  gitUrl: string,
  dir: string,
}

// Validates a `bit-import:` document's `dir` field value (SPEC §17.7): a
// non-empty, `/`-separated, repository-relative path whose every segment
// passes the same charset/traversal check every other repo-derived path
// segment in this module does (`validateSegment`, pmfetch.bit). A vanity
// document is untrusted remote content, so this is the one check standing
// between a hostile `dir` value and walking outside the fetched checkout
// with a `..` segment, or escaping into an absolute path.
fn validateVanityDir(name: string, dir: string): ()! {
  if (len(dir) == 0 || dir[0] == '/') {
    fail newError("pmfetch: bit-import document for ${name} names an invalid dir field: '${dir}'")
  }
  let parts = split(dir, "/")
  let i = 0
  while (i < len(parts)) {
    validateSegment(parts[i]) catch _ {
      fail newError("pmfetch: bit-import document for ${name} names an invalid dir field: '${dir}'")
    }
    i = i + 1
  }
}

// Validates and parses a `bit-import:` document body (SPEC §17.7): its first
// line must be exactly `bit-import: <name> git <gitURL>`, each token
// separated by exactly one space, `<name>` byte-for-byte equal to `name`
// (the vanity name that was requested — this is the format's whole trust
// boundary) and `<gitURL>` an `https://` URL. A pure function over an
// already-buffered body — the caller enforces the byte cap
// (`checkVanityCap`) before this ever runs.
//
// Everything after `<gitURL>` is the format's extension point (SPEC
// §17.7); today's one recognized use is `dir <path>` as the fifth and
// sixth tokens (`validateVanityDir`). Anything else there — a `dir` token
// with nothing after it, or a field this version does not recognize at
// all — is silently ignored rather than rejected, exactly as the format's
// own forward-compatibility guarantee requires; only a RECOGNIZED `dir`
// field with an invalid `<path>` is a hard failure.
fn parseVanityDoc(name: string, body: string): VanityDoc! {
  let line = firstLine(body)
  let parts = split(line, " ")
  if (len(parts) < 4) {
    fail newError("pmfetch: malformed bit-import document for ${name}: ${line}")
  }
  if (parts[0] != "bit-import:") {
    fail newError("pmfetch: bit-import document for ${name} does not start with 'bit-import:': ${line}")
  }
  if (parts[1] != name) {
    fail newError("pmfetch: bit-import document claims name '${parts[1]}', requested '${name}'")
  }
  if (parts[2] != "git") {
    fail newError("pmfetch: bit-import document for ${name} is missing the 'git' token: ${line}")
  }
  let gitUrl = parts[3]
  if (!hasPrefix(gitUrl, "https://")) {
    fail newError("pmfetch: bit-import document for ${name} names a non-https git URL: ${gitUrl}")
  }
  let dir = ""
  if (len(parts) >= 6 && parts[4] == "dir") {
    validateVanityDir(name, parts[5])?
    dir = parts[5]
  }
  return VanityDoc{ gitUrl = gitUrl, dir = dir }
}

// The cap-then-parse sequence a fetched vanity document body runs through
// (`resolveVanityUrl`, below) — factored out so it is directly testable
// against a fixture string with no network involved (pmfetchcheck.bit),
// and so the byte cap provably runs BEFORE any parsing rather than after.
fn checkAndParseVanityDoc(name: string, body: string): VanityDoc! {
  checkVanityCap(body)?
  return parseVanityDoc(name, body)?
}

// One vanity-document fetch outcome, delivered over a channel by
// `vanityFetchWorker` to the racing `select` in `resolveVanityUrl`.
class VanityFetchMsg { ok: bool, status: int, body: string, errMsg: string }

// Runs in its own green thread: GET `url` and report the outcome. Never
// fails outward — a transport/TLS error becomes a `VanityFetchMsg{ok:false}`
// so the racing `select` in `resolveVanityUrl` always has a value to read.
fn vanityFetchWorker(url: string, ch: chan<VanityFetchMsg>) {
  let res = get(url) catch e {
    ch <- VanityFetchMsg{ ok = false, status = 0, body = "", errMsg = e.message() }
    return
  }
  ch <- VanityFetchMsg{ ok = true, status = res.status, body = res.body, errMsg = "" }
}

// Runs in its own green thread: park for `timeoutMs`, then signal. Races
// `vanityFetchWorker` in `resolveVanityUrl`'s `select` — `std/http` has no
// request-level deadline of its own (module header), so this is how the
// 5000 ms wall-clock deadline is enforced. If the fetch wins the race, this
// thread's own `sleep` still runs to completion; if the TIMER wins, the fetch
// green thread keeps running until its own work finishes — the deadline
// bounds how long `resolveVanityUrl` blocks its caller, not how long the
// loser lives (see the module header).
fn vanityTimerFire(ch: chan<bool>, timeoutMs: int) {
  sleep(timeoutMs * Millisecond)
  ch <- true
}

// Builds the URL a vanity document fetch requests, given `name` and the raw
// `BIT_VANITY_ORIGIN` override value (`""` when unset). Factored out of
// `resolveVanityUrl` — its only caller, which always passes it
// `envOr("BIT_VANITY_ORIGIN", "")` — the same way `checkAndParseVanityDoc`
// was factored out: so it is directly testable against fixture strings, no
// environment mutation or network involved (pmfetchcheck.bit).
//
// Testing-only seam, the same override pattern `defaultCacheRoot` uses for
// `BIT_PKG_CACHE` and `stdRootPath` (mainpaths.bit) uses for `BIT_STDLIB`: it
// lets a test dial a local, plaintext fixture server instead of the real
// vanity host, without weakening anything for a real run — SPEC §17.7 still
// requires HTTPS, so this never touches TLS verification, only which origin
// is dialed. `origin == ""` (unset) is byte-identical to before this
// existed: `"https://" + name`. `origin` set REPLACES the `"https://" +
// <name>`'s host prefix: the part of `name` from its first `/` onward (its
// own path, e.g. `"/pkg/http"`) is appended to `origin` unchanged; a `name`
// with no `/` at all (a bare host, no path) maps to `origin` verbatim. The
// name-must-match check, the byte cap, the deadline and the non-200
// rejection all still run unchanged against whatever this returns, and the
// `<gitURL>` recorded in `bit.lock` comes from the fetched document's body
// (`parseVanityDoc`), never from this URL — this seam cannot affect it.
fn vanityRequestUrl(name: string, origin: string): string {
  if (len(origin) == 0) {
    return "https://" + name
  }
  let slash = indexOf(name, "/")
  if (slash < 0) {
    return origin
  }
  return origin + name[slash:len(name)]
}

// Resolves vanity name `name` (e.g. `"bitlang.org/pkg/http"`) to its
// `VanityDoc` — `<gitURL>` plus an optional `dir` — per SPEC §17.7: one
// HTTPS GET of `https://<name>`, its `bit-import:` document validated and
// parsed (`checkAndParseVanityDoc`), bounded by `timeoutMs` wall-clock.
// `std/http.get` never follows a redirect (module header), so any non-200
// response — including a 3xx that would otherwise have redirected — is
// treated as a resolution failure, which is exactly SPEC's "a redirect to a
// non-https scheme is a hard failure" for a client with no
// redirect-following code path to begin with.
//
// `BIT_VANITY_ORIGIN`, when set, overrides the `https://<host>` prefix this
// dials (`vanityRequestUrl`'s own doc comment) — testing-only, see there.
export fn resolveVanityUrl(name: string, timeoutMs: int): VanityDoc! {
  let url = vanityRequestUrl(name, envOr("BIT_VANITY_ORIGIN", ""))
  let fetchCh = chan<VanityFetchMsg>(1)
  let timeoutCh = chan<bool>(1)
  spawn vanityFetchWorker(url, fetchCh)
  spawn vanityTimerFire(timeoutCh, timeoutMs)

  select {
    case msg = <- fetchCh:
      if (!msg.ok) {
        fail newError("pmfetch: vanity fetch of ${url} failed: ${msg.errMsg}")
      }
      if (msg.status != 200) {
        fail newError("pmfetch: vanity fetch of ${url} returned HTTP ${msg.status}, not 200")
      }
      return checkAndParseVanityDoc(name, msg.body)?
    case <- timeoutCh:
      fail newError("pmfetch: vanity fetch of ${url} timed out after ${timeoutMs}ms")
  }
}
