// compiler/relationautoerrcall.bit — gap 3 of relationautoerr.bit (#6344): the
// proof a row passed to a function that reads its relation owes AT THE CALL.
// Split out of relationautoerr.bit (729 lines against the 800-line ceiling once
// #6366 needed room). #6366 adds the parameters a call omits (their defaults,
// relationautodefault.bit) and the stores that replaced a parameter's rows.

// ---- gap 3 (#6344): a row passed to a function that reads its relation ----
//
// `view(a)` reads `a.author` off its PARAMETER. Every read there resolves
// (relationautocalls.bit seeds the parameter), and the function has a known
// caller, so the read itself always passed — even when the caller's argument
// came from raw SQL. The proof therefore belongs at the CALL: for each
// parameter the callee's converged summary says is read, the argument must
// reach a real query, or a holder whose every store loaded the read, or be
// (by an earlier assignment / literal in this function) already loaded, or
// itself be a parameter of the enclosing function (whose own callers are
// checked the same way). Anything else is E0300 at the argument.

// True when `lit` is a composite literal that sets field `name` itself.
fn relationAutoErrLiteralSets(c: Checker, lit: int, name: string): bool {
  if (getNode(c.tree, lit).tag != Tag.CompositeLit) {
    return false
  }
  let body = kidsOf(c.tree, lit)[1]
  if (body == 0 || getNode(c.tree, body).tag != Tag.FieldInits) {
    return false
  }
  for f of kidsOf(c.tree, body) {
    if (identText(c.tree, c.source, kidsOf(c.tree, f)[0]) == name) {
      return true
    }
  }
  return false
}

// Whether argument `arg`, resolving to `flow`, provably has relation `r`
// (a path relative to the parameter's row) loaded, and why not when it does not.
// A literal or a plain name can be proven loaded by assignment (flat `r` only);
// a real query or a holder by its writers; the enclosing function's own
// parameter by its callers (checked at each call) and by the stores that
// replaced its rows here (#6366).
fn relationAutoErrArgProvesRead(
  c: Checker, arg: int, flow: RelationAutoFlow, r: string, ctx: RelationAutoErrCtx,
): (bool, RelationAutoBlame) {
  if (relationAutoErrLiteralSets(c, arg, r) ||
    relationAutoErrLoadedByAssignment(c, arg, r, arg, ctx.errSt.loaded)) {
    return (true, relationAutoNoBlame())
  }
  if (!flow.found) {
    return (false, relationAutoNoBlame())
  }
  let need = relationAutoJoinPath(flow.path, r)
  if (flow.queryCall > 0 || relationAutoIsHolderName(flow.paramName)) {
    return relationAutoFlowProves(ctx.pass.holders, flow, need)
  }
  return relationAutoParamStoresProve(c, ctx, flow, need)
}

// The first relation `p` reads that argument `arg` (resolving to `flow`) cannot
// prove loaded, and the hint that says what to change; `""` when every read is
// proven. A default expression (`relationautodefault.bit`) that is an argument
// like any other is judged by the same function, in its own module `c`.
fn relationAutoErrUnprovenRead(
  c: Checker, arg: int, p: RelationAutoParamSummary, ctx: RelationAutoErrCtx, dflt: bool,
): (string, string) {
  let flow = relationAutoResolve(c, arg, ctx.st)
  for r of p.reads {
    let (proved, blame) = relationAutoErrArgProvesRead(c, arg, flow, r, ctx)
    if (proved) {
      continue
    }
    let need = relationAutoJoinPath(flow.path, r)
    if (!flow.found && relationAutoErrIsLiteral(c, arg) && relationAutoPathDepth(r) == 1) {
      return (r, relationAutoLiteralHint(r))
    }
    if (dflt && blame.kind == RelationAutoBlameKind.None) {
      return (r, relationAutoDefaultHint(r))
    }
    return (r, relationAutoHolderHint(c, arg, need, relationAutoClassName(p.cls), blame))
  }
  return ("", "")
}

// `arg` is a composite literal (past a trailing `?`).
fn relationAutoErrIsLiteral(c: Checker, arg: int): bool {
  return getNode(c.tree, relationAutoStripTry(c, arg)).tag == Tag.CompositeLit
}

fn relationAutoLiteralHint(r: string): string {
  return "this literal never sets '${r}' -- set it in the literal ('${r} = ...'), " +
    "or use a row from a query that loads it (add '.with(\"${r}\")' there)"
}

// One argument against one parameter's recorded reads: reports the first
// read it cannot prove, once.
fn relationAutoErrCheckArg(
  c: Checker, fname: string, p: RelationAutoParamSummary, arg: int, ctx: RelationAutoErrCtx,
) {
  if (arg == 0 || !p.trackable) {
    return
  }
  let (r, hint) = relationAutoErrUnprovenRead(c, arg, p, ctx, false)
  if (r == "") {
    return
  }
  report(
    c.diags, ecRelationAutoUnprovableRead, vSpan(c, arg),
      "relation field '${r}' on '${relationAutoClassName(p.cls)}' is read through parameter " +
      "'${p.name}' of '${fname}', but the row passed here was not proven loaded",
    hint,
  )
}

// A parameter the call omits takes its default expression (#6366): judged once
// per default however many calls omit it, reported at the default's own line in
// the module that declares it. Nothing to say when the default is itself proven.
fn relationAutoErrCheckDefault(
  fname: string, p: RelationAutoParamSummary, slot: RelationAutoSlot, ctx: RelationAutoErrCtx,
) {
  let key = "${slot.c.moduleId}:${slot.node}"
  let (seen, _) = ctx.pass.defaults[key]
  if (seen || !p.trackable) {
    return
  }
  ctx.pass.defaults[key] = true
  let (r, hint) = relationAutoErrUnprovenRead(
    slot.c,
    slot.node,
    p,
    relationAutoSlotCtx(slot, ctx),
    true,
  )
  if (r == "") {
    return
  }
  report(
    slot.c.diags, ecRelationAutoUnprovableRead, vSpan(slot.c, slot.node),
      "relation field '${r}' on '${relationAutoClassName(p.cls)}' is read through parameter " +
      "'${p.name}' of '${fname}', but this default value was not proven loaded",
    hint,
  )
}

// A default whose origin could not be traced at all gets its own advice (the
// generic "add '.with' where the rows are queried" has no query to point at).
fn relationAutoDefaultHint(r: string): string {
  return "this default is used when a call omits the argument -- make it a row from a query that " +
    "loads '${r}' (add '.with(\"${r}\")' there), or pass the argument at every call"
}

// `node` is a `Tag.Call`. A call to a named, non-generic free function whose
// summary records reads on a parameter is checked argument by argument
// (`relationAutoArgExprs`, the same argument-to-parameter matching R2/R2b use);
// a position the call leaves empty is its parameter's default, and a variadic
// parameter's arguments are each judged the same (#6405).
fn relationAutoErrCheckCall(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  if (ctx.pass.collect) {
    relationAutoHolderNoteCall(c, node, ctx)
    return
  }
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let name = identText(c.tree, c.source, callee)
  let (summary, ok) = relationAutoLookupSummary(c, name, callee, ctx.st)
  if (!ok) {
    return
  }
  let args = relationAutoArgExprs(c, node, summary.params)
  let fixed = relationAutoFixedCount(summary.params)
  let i = 0
  while (i < fixed) {
    let slot = relationAutoSlotOf(c, name, summary, args, i)
    if (slot.dflt) {
      relationAutoErrCheckDefault(name, summary.params[i], slot, ctx)
    } else {
      relationAutoErrCheckArg(c, name, summary.params[i], slot.node, ctx)
    }
    i = i + 1
  }
  if (fixed == len(summary.params)) {
    return
  }
  // Every argument filling the variadic parameter (#6405) is a row, or a `...`
  // slice of them, judged exactly like a fixed parameter's.
  for a of relationAutoVariadicArgs(c, node, summary.params) {
    relationAutoErrCheckArg(c, name, summary.params[fixed], a, ctx)
  }
}
