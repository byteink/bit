// The operator, combinator and `related(...)` halves of a condition literal
// (SPEC §12.3.1, epic #6984), judged against the class `T` of a `Where<T>`.
// checkwhere.bit reads the entries and hands the three shapes here.
//
//   { age: { gte: 18, lt: 65 } }     operator object, its entries ANDed
//   { or: [ {...}, {...} ], not: {...} }   combinators, each operand a `Where<T>`
//   { folder: related("editor") }    a relationship test on a relation field
//
// Operators carry no `$`: a key is a field or an operator by position (a field's
// value object holds operators, a literal's own keys hold fields), and the
// operator set is closed. Lowering is #7002's; this file only judges.

const whereOpIn = "in"

const whereOpList = "eq, ne, in, lt, lte, gt, gte"

// The seven operators, in the order a diagnostic lists them.
fn whereOpNames(): []string {
  return ["eq", "ne", "in", "lt", "lte", "gt", "gte"]
}

fn whereOpIsOrdering(op: string): bool {
  return op == "lt" || op == "lte" || op == "gt" || op == "gte"
}

// The std/time types whose values are ordered instants or calendar points.
fn whereTimeTypeNames(): []string {
  return ["Timestamp", "Date", "Time", "DateTime", "NaiveDateTime"]
}

// Can an ordering operator compare a field of type `ft`? Numbers, decimals,
// strings and the std/time types can; bool, enums, byte slices and classes
// have no order. An `Option` field is judged by its payload.
fn whereIsOrdered(c: Checker, ft: int): bool {
  let inner = vOptionPayload(c, ft)
  if (inner != 0) {
    return whereIsOrdered(c, inner)
  }
  let t = c.ctx.types[ft]
  if (t.kind == TypeKind.Prim) {
    return t.prim != 10
  }
  return t.kind == TypeKind.Struct && t.hasName && whereNameIn(whereTimeTypeNames(), t.name)
}

fn whereOpSlot(slot: WhereSlot, op: string): WhereSlot {
  return WhereSlot{
    owner = "${slot.owner} under operator '${op}'", ft = slot.ft,
    hint = "the operand of '${op}' has the field's own type",
  }
}

fn reportWhereUnknownOp(c: Checker, node: int, slot: WhereSlot, op: string) {
  report(
    c.diags, ecWhereUnknownField, vSpan(c, node),
    "unknown operator \"${op}\" on ${slot.owner}",
    "the operators are ${whereOpList}",
  )
}

fn reportWhereNotOrdered(c: Checker, node: int, slot: WhereSlot, op: string) {
  report(
    c.diags, ecWhereValueType, vSpan(c, node),
    "operator '${op}' needs an ordered field, but ${slot.owner} is '${typeName(c.ctx, slot.ft)}'",
    "'${op}' works on numbers, decimals, strings and std/time types; bool, enum and []byte fields take eq, ne and in",
  )
}

// `in`'s operand: a list of the field's type. A list literal is judged
// element by element, any other list expression by its element type. An empty
// list is allowed and matches nothing.
fn checkWhereIn(c: Checker, val: int, slot: WhereSlot) {
  if (getNode(c.tree, val).tag == Tag.SliceLit) {
    c.containerLitTargeted[val] = true
    for a of kidsOf(c.tree, val) {
      let e = a
      if (getNode(c.tree, e).tag == Tag.Arg) {
        e = kidsOf(c.tree, e)[0]
      }
      whereCheckAgainst(c, e, slot)
    }
    return
  }
  let got = checkExprType(c, val)
  if (got == 0 || vMentionsInvalid(c, got, 0) || vMentionsInvalid(c, slot.ft, 0)) {
    return
  }
  if (c.ctx.types[got].kind != TypeKind.Slice) {
    report(
      c.diags, ecWhereValueType, vSpan(c, val),
      "${slot.owner} takes a list of '${typeName(c.ctx, slot.ft)}', found '${typeName(c.ctx, got)}'",
      "write `in: [a, b]`, or pass a list of the field's own type",
    )
    return
  }
  let elem = c.ctx.types[got].elem
  if (!whereValueFits(c, val, elem, slot.ft)) {
    reportWhereValueType(c, val, slot, elem)
  }
}

// One `op: value` entry of an operator object on a field of type `slot.ft`.
fn checkWhereOp(c: Checker, op: string, key: int, val: int, slot: WhereSlot) {
  if (!whereNameIn(whereOpNames(), op)) {
    reportWhereUnknownOp(c, key, slot, op)
    return
  }
  let opSlot = whereOpSlot(slot, op)
  if (op == whereOpIn) {
    checkWhereIn(c, val, opSlot)
    return
  }
  if (!whereOpIsOrdering(op)) {
    whereCheckAgainst(c, val, opSlot)
    return
  }
  if (!whereIsOrdered(c, slot.ft)) {
    reportWhereNotOrdered(c, key, slot, op)
    return
  }
  if (getNode(c.tree, val).tag == Tag.NilLit) {
    reportWhereValueType(c, val, opSlot, c.ctx.untypedNilId)
    return
  }
  whereCheckAgainst(c, val, opSlot)
}

// A field's operator object `{ gte: 18, lt: 65 }`. The object is not a map, so
// the end-of-module sweeps are told to leave it alone.
fn checkWhereOps(c: Checker, obj: int, slot: WhereSlot) {
  c.whereLits[obj] = true
  c.containerLitTargeted[obj] = true
  if (len(kidsOf(c.tree, obj)) == 0) {
    reportWhereUnsupported(c, obj, "an operator object with no operator")
    return
  }
  for e of kidsOf(c.tree, obj) {
    let ek = kidsOf(c.tree, e)
    if (getNode(c.tree, ek[0]).tag != Tag.Ident) {
      reportWhereUnsupported(c, ek[0], "an operator that is not a plain name")
      continue
    }
    checkWhereOp(c, nodeText(c.tree, c.source, ek[0]), ek[0], ek[1], slot)
  }
}

// `and` and `or` take a list of conditions, `not` one condition; each operand
// is a `Where<T>` of the same `T`, so a nested literal is judged by the same
// rules and an already built `Where<T>` value is accepted as it stands.
fn checkWhereCombinator(c: Checker, key: string, val: int, want: int) {
  if (key == "not" && getNode(c.tree, val).tag == Tag.SliceLit) {
    whereQuietLits(c, val)
    report(
      c.diags, ecWhereValueType, vSpan(c, val), "the 'not' key takes one condition, found a list",
      "write `not: { ... }`; to negate several, `not: { or: [...] }`",
    )
    return
  }
  if (key == "not") {
    vExpectExpr(c, val, want)
    return
  }
  vExpectExpr(c, val, mkSlice(c.ctx, want))
}

// `related(...)`: a call to a function named `related`, with callee and
// argument as written. Only the call's form is read here; what `related`
// returns is the declaring package's business.
fn whereIsRelatedCall(c: Checker, val: int): bool {
  if (getNode(c.tree, val).tag != Tag.Call) {
    return false
  }
  let callee = kidsOf(c.tree, val)[0]
  return getNode(c.tree, callee).tag == Tag.Ident && nodeText(c.tree, c.source, callee) == "related"
}

// True when the call is `related("name")`: one argument, a string literal.
fn whereRelatedHasLiteralArg(c: Checker, call: int): bool {
  let args = kidsOf(c.tree, kidsOf(c.tree, call)[2])
  if (len(args) != 1 || getNode(c.tree, args[0]).tag != Tag.Arg) {
    return false
  }
  let tag = getNode(c.tree, kidsOf(c.tree, args[0])[0]).tag
  return tag == Tag.StringLit || tag == Tag.RawStringLit
}

// The text of a `@belongsTo("userId")` style attribute's first argument, "" when
// it has none.
fn whereAttrFirstArg(oc: Checker, attr: int): string {
  let kids = kidsOf(oc.tree, attr)
  if (len(kids) < 2 || getNode(oc.tree, kids[1]).tag != Tag.StringLit) {
    return ""
  }
  let sp = getNode(oc.tree, kids[1]).span
  return decodeStringContent(oc.source, sp.start, sp.end)
}

// Is `name` the foreign key some `@belongsTo("name")` of the class `decl`
// names?
fn whereIsForeignKey(oc: Checker, decl: int, name: string): bool {
  for m of kidsOf(oc.tree, kidsOf(oc.tree, decl)[2]) {
    let f = memberField(oc.tree, m)
    if (f == 0) {
      continue
    }
    for a of fieldAttrs(oc.tree, f) {
      if (identText(oc.tree, oc.source, kidsOf(oc.tree, a)[0]) == classAttrBelongsTo &&
        whereAttrFirstArg(oc, a) == name) {
        return true
      }
    }
  }
  return false
}

// A relation or foreign-key field: one carrying a relation mark, a class-typed
// field (or an `Option` of one), the foreign key a `@belongsTo` names, or the
// class's own `id` (the object itself related to the subject).
fn whereIsRelationField(c: Checker, target: int, field: string, ft: int): bool {
  let oc = typeOwner(c, target)
  let decl = structDeclOf(c, target)
  if (decl == 0) {
    return false
  }
  if (field == "id" || lintFieldIsRelation(oc.tree, oc.source, decl, field)) {
    return true
  }
  let inner = vOptionPayload(c, ft)
  if (inner == 0) {
    inner = ft
  }
  return c.ctx.types[inner].kind == TypeKind.Struct || whereIsForeignKey(oc, decl, field)
}

fn checkWhereRelated(c: Checker, call: int, target: int, field: string, slot: WhereSlot) {
  if (!whereRelatedHasLiteralArg(c, call)) {
    reportWhereUnsupported(c, call, "a related(...) call whose argument is not one string literal")
    return
  }
  let got = checkExprType(c, call)
  if (got == 0 || vMentionsInvalid(c, got, 0) || vMentionsInvalid(c, slot.ft, 0)) {
    return
  }
  if (!whereIsRelationField(c, target, field, slot.ft)) {
    report(
      c.diags, ecWhereValueType, vSpan(c, call),
      "related(...) tests a relation, but ${slot.owner} is '${typeName(c.ctx, slot.ft)}', not a relation or foreign-key field",
      "use it on a class-typed field, a field marked @belongsTo/@hasOne/@hasMany/@manyToMany, a foreign key a @belongsTo names, or `id`",
    )
  }
}
