// compiler/checkbindexpr.bit — split out of checkbind.bit (#5642). Sibling
// of checkbind.bit and check.bit: same module, so this needs no imports and
// no call-site changes. Member-access and untyped-literal type checking:
// `checkMember` (dotted-access resolution) and the slice/tuple literal
// element-type inference `checkExprType` (checkexpr.bit) dispatches to.

fn checkMember(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let recv = kids[0]
  // Enum-variant access `Enum.Variant` / `Enum<T>.Variant` -> the enum type.
  let et = enumReceiverType(c, recv)
  if (et != 0) {
    return et
  }
  // `ns.member` — an exported const, module state or function of the namespaced
  // module, bound under the dotted key. Consulted before the receiver is typed:
  // a namespace alias is not a value and has no type of its own.
  let qn = nsQualifiedName(c, node)
  if (qn != "") {
    let qe = envLookup(c, qn)
    if (qe != 0) {
      return qe
    }
    return funcSigLookup(c, qn)
  }
  let rt = checkExprType(c, recv)
  if (rt != 0) {
    let mn = getNode(c.tree, kids[1])
    let mname = c.source[mn.span.start:mn.span.end]
    let recvKey = "${methodRecvType(c, rt)}"
    // Class field access `value.field`. `structFieldLookup` is keyed by the
    // receiver's own TypeId, and a generic INSTANTIATION's fields are recorded
    // already substituted (`fillInstMembers`, #1540/#1573) — `Box<i64>.val`
    // reads back i64 directly, with no scrutinee-syntax recovery needed. Only
    // inside the generic's OWN body, where the receiver is still the bare
    // template, can this answer stay a type param, and there is no better
    // answer to recover there either.
    if (c.ctx.types[rt].kind == TypeKind.Struct) {
      let ft = structFieldLookup(c, recvKey + "." + mname)
      if (ft != 0) {
        return ft
      }
    }
    // An uncalled method value `value.method` -> the method's func type.
    return methodSigLookup(c, recvKey + "." + mname)
  }
  return 0
}

// An untyped slice literal `[a, b, ...]` is `[]E`, E the (defaulted) type of its
// first element. ponytail: first element only — a heterogeneous literal would
// need element unification, which the checker rejects anyway.
fn checkSliceLit(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0) {
    return 0
  }
  let first = kids[0]
  if (getNode(c.tree, first).tag == Tag.Arg) {
    first = kidsOf(c.tree, first)[0]
  }
  return mkSlice(c.ctx, defaultType(c, checkExprType(c, first)))
}

// A tuple literal `(a, b, ...)` (SPEC §12.10, #4105) is `(T1, T2, ...)`, each
// Ti its own element's (defaulted) type — positional, unlike `checkSliceLit`'s
// single shared element type, because a tuple's elements need not agree.
// `mkTuple` is the same interning `checktype.bit`'s `typeFromNodeIn` performs
// for a `tuple_type` annotation, so a literal and an annotation naming the
// same element types produce the identical TypeId.
fn checkTupleLit(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let members = []int(0)
  let i = 0
  while (i < len(kids)) {
    members = append(members, defaultType(c, checkExprType(c, kids[i])))
    i = i + 1
  }
  return mkTuple(c.ctx, members)
}
