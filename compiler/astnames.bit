// The statement/control-flow half of `tagName`'s if-chain, split out for the
// same reason `tagNameExtra`/`tagNameJsx` were (E0201's 80-line limit; see
// their comments below) -- this half never touched declaration/expression
// tags, so it carries its own arms rather than growing `tagName` itself.
// Chained into 7-arm groups (`tagNameStmts2`..`tagNameStmts7`) rather than one
// flat function so no single link in the chain crosses E0204's complexity
// limit either -- each new Tag still costs exactly one link its +1, never
// `tagName` itself.
fn tagNameStmts(tag: Tag): string {
  if (tag == Tag.IfStmt) {
    return "if_stmt"
  }
  if (tag == Tag.WhileStmt) {
    return "while_stmt"
  }
  if (tag == Tag.ForOf) {
    return "for_of"
  }
  if (tag == Tag.ForIn) {
    return "for_in"
  }
  if (tag == Tag.ForC) {
    return "for_c"
  }
  if (tag == Tag.ForInf) {
    return "for_inf"
  }
  if (tag == Tag.BreakStmt) {
    return "break_stmt"
  }
  return tagNameStmts2(tag)
}

fn tagNameStmts2(tag: Tag): string {
  if (tag == Tag.ContinueStmt) {
    return "continue_stmt"
  }
  if (tag == Tag.FailStmt) {
