// compiler/astnames.bit -- split out of ast.bit (#5675, ast.bit was 923
// lines formatted against the 800-line limit, #4099/#4103's canonical-
// format debt on BIT_FMTZERO_DEBT). Same module as ast.bit, so this needs
// no imports and no call-site changes.
//
// The string-table dispatch family: tagName and its tagNameStmts2..7/
// tagNameExtra/tagNameJsx per-Tag-range helpers (the `@tagName` used by
// dumpAst/dumpNode's `(tag ...)` rendering), dumpQuoted/isLeafTag (which
// Tags dumpNode treats as leaves or quotes), and opSymbol (the operator
// glyph for a binary/unary Node.main, §12.9). Moved as one group: every
// function here is a flat if-chain string table over Tag or Kind, called
// only from ast.bit's dumpNode/dumpAst.

// ---- s-expression dump (matches ast.dump) ---------------

// The seed's @tagName for a non-leaf node. Chained into 7-arm groups
// (`tagName2`..`tagName9`) for the same reason `tagNameStmts`'s own chain
// below is: E0201's 80-line limit and E0204's complexity limit, each new Tag
// costing exactly one link its +1.
fn tagName(tag: Tag): string {
  if (tag == Tag.Program) {
    return "program"
  }
  if (tag == Tag.ConstDecl) {
    return "const_decl"
  }
  if (tag == Tag.LetDecl) {
    return "let_decl"
  }
  if (tag == Tag.Binding) {
    return "binding"
  }
  if (tag == Tag.FuncDecl) {
    return "func_decl"
  }
  if (tag == Tag.AttrList) {
    return "attr_list"
  }
  if (tag == Tag.Attr) {
    return "attr"
  }
  return tagName2(tag)
}

fn tagName2(tag: Tag): string {
  if (tag == Tag.ExternFnDecl) {
    return "extern_fn_decl"
  }
  if (tag == Tag.Params) {
    return "params"
  }
  if (tag == Tag.Param) {
    return "param"
  }
  if (tag == Tag.ParamRest) {
    return "param_rest"
  }
  if (tag == Tag.Block) {
    return "block"
  }
  if (tag == Tag.ReturnStmt) {
    return "return_stmt"
  }
  if (tag == Tag.ExprStmt) {
    return "expr_stmt"
  }
  return tagName3(tag)
}

