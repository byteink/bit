  }
  if (tag == Tag.SpawnStmt) {
    return "spawn_stmt"
  }
  if (tag == Tag.DeferStmt) {
    return "defer_stmt"
  }
  if (tag == Tag.AsmStmt) {
    return "asm_stmt"
  }
  if (tag == Tag.AsmCode) {
    return "asm_code"
  }
  if (tag == Tag.AsmResult) {
    return "asm_result"
  }
  return tagNameStmts3(tag)
}

