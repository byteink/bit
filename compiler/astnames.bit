// The tail of `tagName`'s if-chain, split out purely to keep that function's
// own McCabe complexity from growing every time a new Tag joins the enum
// (spec/LINT.md E0204, tools/build/complexity-debt.txt's baseline for
// `tagName`) -- each new arm here costs this function +1, never `tagName`'s.
fn tagNameExtra(tag: Tag): string {
  if (tag == Tag.TestDecl) {
    return "test_decl"
  }
  if (tag == Tag.CondExpr) {
    return "cond_expr"
  }
  if (tag == Tag.TupleLit) {
    return "tuple_lit"
  }
  if (tag == Tag.FieldPat) {
    return "field_pat"
  }
  if (tag == Tag.NamedArg) {
    return "named_arg"
  }
  return tagNameJsx(tag)
}

// The JSX arms of `tagName`'s if-chain, split off for the same reason
// `tagNameExtra` was: each new Tag costs THIS function +1 and neither of its
// callers, so no debt-listed complexity baseline moves (#3943).
fn tagNameJsx(tag: Tag): string {
  if (tag == Tag.JsxElem) {
    return "jsx_elem"
  }
  if (tag == Tag.JsxFrag) {
    return "jsx_frag"
  }
  if (tag == Tag.JsxAttrs) {
    return "jsx_attrs"
  }
  if (tag == Tag.JsxAttr) {
    return "jsx_attr"
  }
  if (tag == Tag.JsxSpreadAttr) {
    return "jsx_spread_attr"
  }
  if (tag == Tag.JsxChildren) {
    return "jsx_children"
  }
  if (tag == Tag.JsxExpr) {
    return "jsx_expr"
  }
  if (tag == Tag.JsxText) {
    return "jsx_text"
  }
  return "?"
}

// True for a node `dumpNode` renders as its QUOTED source text. A str_part is
// quoted so empty chunks (`""`) stay visible; a jsx_text is quoted for the same
// reason — its content is arbitrary prose, and unquoted it would run into the
// surrounding s-expression. A predicate rather than a second `||` inside
// `dumpNode`, which sits at its complexity-debt baseline (#3943).
fn dumpQuoted(tag: Tag): bool {
  return tag == Tag.StrPart || tag == Tag.JsxText
}

// True for a leaf that renders as its source text (not `(tag ...)`).
fn isLeafTag(tag: Tag): bool {
  return tag == Tag.Ident ||
    tag == Tag.IntLit ||
    tag == Tag.FloatLit ||
    tag == Tag.StringLit ||
    tag == Tag.RawStringLit ||
    tag == Tag.RuneLit ||
    tag == Tag.BoolLit ||
    tag == Tag.NilLit
}

// The glyph for a binary/unary operator, whose Kind (§lexer) is stored as an int
// in `Node.main`. Compared against `int(Kind.X)` (C-like enum -> int, §12.9).
// Chained into 7-arm groups (`opSymbol2`..`opSymbol5`) for the same reason
// `tagName`'s chain above is: E0201's 80-line limit and E0204's complexity
// limit, each new Kind costing exactly one link its +1.
fn opSymbol(m: int): string {
  if (m == int(Kind.Plus)) {
    return "+"
  }
  if (m == int(Kind.Minus)) {
    return "-"
  }
  if (m == int(Kind.Star)) {
    return "*"
  }
  if (m == int(Kind.Slash)) {
    return "/"
  }
  if (m == int(Kind.Percent)) {
    return "%"
  }
  if (m == int(Kind.Amp)) {
    return "&"
  }
  if (m == int(Kind.Pipe)) {
    return "|"
  }
  return opSymbol2(m)
}

fn opSymbol2(m: int): string {
  if (m == int(Kind.Caret)) {
    return "^"
  }
  if (m == int(Kind.Shl)) {
    return "<<"
  }
  if (m == int(Kind.Shr)) {
    return ">>"
  }
  if (m == int(Kind.Tilde)) {
    return "~"
  }
  if (m == int(Kind.AmpAmp)) {
    return "&&"
  }
  if (m == int(Kind.PipePipe)) {
    return "||"
  }
  if (m == int(Kind.Bang)) {
    return "!"
  }
  return opSymbol3(m)
}

fn opSymbol3(m: int): string {
  if (m == int(Kind.EqEq)) {
    return "=="
  }
  if (m == int(Kind.BangEq)) {
    return "!="
  }
  if (m == int(Kind.Lt)) {
    return "<"
  }
  if (m == int(Kind.LtEq)) {
    return "<="
  }
  if (m == int(Kind.Gt)) {
    return ">"
  }
  if (m == int(Kind.GtEq)) {
    return ">="
  }
  if (m == int(Kind.ArrowLeft)) {
    return "<-"
  }
  return opSymbol4(m)
}

fn opSymbol4(m: int): string {
  if (m == int(Kind.Eq)) {
    return "="
  }
  if (m == int(Kind.PlusEq)) {
    return "+="
  }
  if (m == int(Kind.MinusEq)) {
    return "-="
  }
  if (m == int(Kind.StarEq)) {
    return "*="
  }
  if (m == int(Kind.SlashEq)) {
    return "/="
  }
  if (m == int(Kind.PercentEq)) {
    return "%="
  }
  if (m == int(Kind.AmpEq)) {
    return "&="
  }
  return opSymbol5(m)
}

fn opSymbol5(m: int): string {
  if (m == int(Kind.PipeEq)) {
    return "|="
  }
  if (m == int(Kind.CaretEq)) {
    return "^="
  }
  if (m == int(Kind.ShlEq)) {
    return "<<="
  }
  if (m == int(Kind.ShrEq)) {
    return ">>="
  }
  return "?"
}
