fn machoWriteCounts(obj: MachoObject): ()! {
  // Section ordinals are a u8 with 0 reserved (nlist.h's MAX_SECT), and a
  // relocation's symbol index is 24 bits — neither can be allowed to truncate
  // silently, however unreachable a real compilation unit makes them.
  if (len(obj.sections) > 255) {
    fail newError("TooManySections")
  }
  if (len(obj.symbols) > (1 << 24) - 1) {
    fail newError("TooManySymbols")
  }

}

fn machoWriteSectionsValid(obj: MachoObject, hasKind: []bool, sectionOf: []MachoSection): ()! {
  let i = 0
  while (i < len(obj.sections)) {
    let s = obj.sections[i]
    let idx = machoKindIndex(s.kind)
    if (hasKind[idx]) {
      fail newError("DuplicateSection")
    }
    if (s.alignment != 0 && !isPowerOfTwo(s.alignment)) {
      fail newError("InvalidSectionAlignment")
    }
    hasKind[idx] = true
    sectionOf[idx] = s
    i = i + 1
  }

}

fn machoWriteSymbolsValid(obj: MachoObject, hasKind: []bool, sectionOf: []MachoSection): ()! {
  let i = 0
  while (i < len(obj.symbols)) {
    let sym = obj.symbols[i]
    if (!sym.hasSection && sym.binding == MachoBinding.Local) {
      fail newError("UndefinedLocalSymbol")
    }
    if (sym.hasSection) {
      let idx = machoKindIndex(sym.section)
      if (!hasKind[idx]) {
        fail newError("SectionNotPresent")
      }
      if (!loRangeOk(machoSectionBytes(sectionOf[idx]), sym.offset, sym.size)) {
        fail newError("SymbolOutOfBounds")
      }
    }
    i = i + 1
  }

}

fn machoWriteSymbolIndex(obj: MachoObject, symIdxOf: map<string, int>): ()! {
  let i = 0
  while (i < len(obj.symbols)) {
    let (_, dup) = symIdxOf[obj.symbols[i].name]
    if (dup) {
      fail newError("DuplicateSymbol")
    }
    symIdxOf[obj.symbols[i].name] = i
    i = i + 1
  }

}

fn machoWriteRelocsValid(
  obj: MachoObject,
  hasKind: []bool,
  sectionOf: []MachoSection,
  symIdxOf: map<string, int>,
  relocBuckets: []MachoRelocList,
): ()! {
  let i = 0
  while (i < len(obj.relocations)) {
    let r = obj.relocations[i]
    let idx = machoKindIndex(r.section)
    if (!hasKind[idx]) {
      fail newError("SectionNotPresent")
    }
    if (!loRangeOk(machoSectionBytes(sectionOf[idx]), r.offset, machoRelocWidth(r.kind))) {
      fail newError("RelocOutOfBounds")
    }
    machoWriteRelocAddress(r.offset)?
    let (symbolIndex, known) = symIdxOf[r.symbol]
    if (!known) {
      fail newError("UnknownSymbol")
    }
    machoWriteSymbolNumber(symbolIndex)?
    relocBuckets[idx].list = append(relocBuckets[idx].list, r)
    i = i + 1
  }

}
