// Self-host Stage 2: bounds-check elimination for the induction shape
//
//     while (i < len(xs)) { ... xs[i] ... }
//
// #4354 removed the duplicate test from `for x of xs`; this is the explicit-
// index half. The lowering emits the header's SIGNED test and then, inside the
// element load, the UNSIGNED test `emitBoundsCheck` needs — on arm64 they come
// out as literally the same two registers compared twice, `cmp x28, x22` then
// `b.ge`, `cmp x28, x22` then `b.lo`.
//
// ## The whole missing step
//
// `icmp_slt(i, L)` true does NOT imply `icmp_ult(i, L)` true — `i = -1, L = 1`
// is a counterexample. It does the moment `i >= 0`, because then `0 <= i < L`
// and both compares read the same bits. So the pass proves exactly one thing:
// the header param is never negative.
//
// ## Why this is an IR pass and not a selector peephole
//
// `emitBoundsCheck` SPLITS the block, so for a checked access `len` and
// `buf`/`off` are never in one block — a peephole at the selector cannot see
// the dominating test at all. #4354 specified that route and it was found
// unsound at the very site it cited.
//
// ## The proof, and every place it can go wrong
//
// Candidate header `h` (never block 0 — its params come from the caller):
// terminator `br %c, T, F` with `%c = icmp_slt(%i, %L)`, `%i` a param of `h`
// at index `k`, `T != F`, neither equal to `h`.
//
// NON-NEGATIVITY, by induction over the dynamic sequence of entries to `h`.
// Every predecessor edge must pass, at position `k`, one of:
//
//   - a non-negative integer constant  — the base case;
//   - `%i` itself                      — unchanged, so still non-negative;
//   - `add(%i, 1)` from a block `p` with `!viaF[p]`  — the step.
//
// At least one edge must be the constant form, or there is no base case. The
// first entry to `h` cannot come through a block `h` dominates, and both other
// forms read `%i`, so the first entry always takes a constant edge.
//
// THE STEP'S OVERFLOW HOLE IS CLOSED BY `!viaF[p]`, and that is the only reason
// the dominance walk exists. `!viaF[p]` means every path from `h` to `p` runs
// through `T`, so reaching `p` establishes `%i < %L` for the CURRENT iteration;
// `%L <= maxInt`, so `%i + 1 <= %L` cannot overflow, and `%i + 1 >= 1 > 0`.
// Without it, an increment on the `F` side could step `%i` at `maxInt` and wrap
// it negative, which is precisely the value that makes the unsigned test lie.
//
// The add's own block never needs checking. SSA already guarantees it
// dominates `p`, and a value that dominates `p` is recomputed on every path
// from `h` to `p`: were there a path from `h` to `p` avoiding the def, the
// prefix reaching `h` for the FIRST time contains no `h`, hence no def (the def
// reads `%i`, so `h` dominates it), and prepending it would give a def-free
// path from entry to `p` — contradicting SSA dominance. So the value on the
// edge is always the current iteration's `%i + 1`, never a stale one.
//
// MARKING. In any block `b != h` with `!viaF[b]`, an `icmp_ult(%i, %L)` whose
// two operands resolve to the SAME two value ids is true whenever it executes:
// it reads `%i`, so `h` dominates `b`, and `!viaF[b]` puts `T` on every path
// in. `known[b] = true`
// then makes `emitTranslated` turn the guarding `br` into a `jump` and
// `computeReachable` drop the panic block — no lowering change at all.
//
// `b == h` is excluded and the exclusion is load-bearing: an `icmp_ult` sitting
// in the header runs BEFORE its own `br` tests anything.
//
// `T` ITSELF MUST HAVE ONE PREDECESSOR. "`!viaF[b]` puts `T` on every path in"
// only holds if the ONLY way to reach `T` is `h`'s true edge: `bceReachAvoiding`
// stops the walk AT `T` (it is `stopB`), so a second predecessor of `T` reached
// from the false side is never explored past `T` and everything behind `T`
// reads as `!viaF`, safe, even on the path that entered through that second
// edge without the test ever holding. `lowerWhile` always gives `T` one
// predecessor today; `bceProveHeader` checks it and refuses the header rather
// than trusting the lowering to keep it that way (#5896).
//
// EXACT VALUE IDS, not equal expressions. Two `slice_len` reads of the same
// base are the same value only if nothing between them can move `len`, and
// `bit_rt_slice_append` mutates a header in place. The first fold round leaves
// the header's `slice_len` and the load's as distinct ids and this pass simply
// does not fire; `cseAvailableValues` and optloop.bit's hoist unify them, so it
// fires on the second round, which is the one before codegen. `bceResolve`
// only ever replaces a block PARAM by the one value it can hold; it never
// equates two instructions, so a memory read is still matched by id alone.
//
// THE SELF EDGE. `lowerWhile` passes every live local as a header param and the
// back edge passes an unchanged one back to itself, so `let n = len(w)` reaches
// the test and the check as two params, each fed `%X` on entry and itself on
// every back edge. `bceParamSource` skips such an edge: a param whose edges
// pass only `%X` or itself holds `%X`. `%X` dominates the param's block, since
// the first entry cannot take a self edge (the param is not yet defined), so it
// takes an `%X` edge, and that needs `%X` to dominate its source. Nor can `%X`
// be re-executed between an entry and a later use of the param: `%X`'s block
// strictly dominates the param's, so a path from it to the use that avoided
// the param's block would give a path from the entry avoiding it too, and the
// next entry after a re-execution arrives on an `%X` edge, which reloads the
// param. The same argument with `h` for the param's block shows the resolved
// root of `%L` is not re-executed between `h`'s test and the check, so both
// compares read the same two values. Block 0 is refused: its params arrive
// from the caller along no edge, so its edges do not hold every source. The
// self test itself uses the strict all-edges-agree rule and never recurses
// into `bceParamSource`.
//
// WHICH REFUSALS ARE ACTUALLY EXERCISED, counted with a temporary probe over
// `compiler` (243 files), `stdlib/regex`, the 13 bench cases and the fixture,
// against 882 marks made:
//
//   `!viaF[p]` on the step        194 refusals   — load-bearing
//   `b != h` in `bceMarkProven`     0            — defensive
//   the constant base case          0            — defensive
//
// The two zeros are kept anyway, and the reason is that neither is a
// performance trade: each guards a case the induction argument above does not
// cover at all, and a lowering change is all it would take to produce one. But
// they are stated as unexercised rather than sold as proven, because no
// fixture in this tree kills a mutant that drops either.
//
// 64-BIT SIGNED ONLY. The argument is width-generic, but the base case reads a
// raw `ival` whose narrow-width interpretation is the IR's "store bits,
// reinterpret per type" convention rather than a number, and every index
// variable in this tree is `int`. Widening it is a measurement, not a guess.

// The blocks reachable from `from` without passing through `stopA` or `stopB`.
// Bounded: each block is enqueued at most once.
fn bceReachAvoiding(f: IrFunc, src: int, stopA: int, stopB: int): []bool {
  let seen = licmFalses(len(f.blocks))
  if (src == stopA || src == stopB) {
    return seen
  }
  seen[src] = true
  let work = [src]
  let s = 0
  while (s < len(work)) {
    let ts = licmTargets(f, work[s])
    s = s + 1
    let i = 0
    while (i < len(ts)) {
      let t = ts[i]
      if (!seen[t] && t != stopA && t != stopB) {
        seen[t] = true
        work = append(work, t)
      }
      i = i + 1
    }
  }
  return seen
}

// `b`'s terminator, or -1 when the block is empty. DCE can empty a block it
// keeps, and `instsStart + instsLen - 1` then names the instruction BEFORE the
// block — index -1 for block 0, which is how #2084 segfaulted.
fn bceTerminator(f: IrFunc, b: int): int {
  let blk = f.blocks[b]
  if (blk.instsLen == 0) {
    return -1
  }
  return blk.instsStart + blk.instsLen - 1
}

// The index of `v` among `b`'s block params, or -1 when it is not one of them.
fn bceParamIndex(f: IrFunc, b: int, v: int): int {
  let blk = f.blocks[b]
  if (v < blk.instsStart || v >= blk.instsStart + blk.paramCount) {
    return -1
  }
  return v - blk.instsStart
}

fn bceIsNonNegConst(known: []ConstVal, v: int): bool {
  let kv = known[v]
  return kv.known && !kv.isFloat && !kv.isBool && kv.ival >= 0
}

// `v`'s index among its block's params, or -1 when it is not a param or its
// block is block 0, whose params arrive from the caller along no edge at all.
fn bceParamSlot(lp: BceLoop, v: int): int {
  let b = lp.owner[v]
  if (b == 0) {
    return -1
  }
  return bceParamIndex(lp.f, b, v)
}

// The value edge `e` of block `b` passes to param slot `k`, or -1 when the
// edge's argument list does not match the block's params.
fn bceEdgeArg(lp: BceLoop, b: int, e: int, k: int): int {
  let args = licmEdgeArgs(lp.f, lp.pm.list[e], b)
  if (len(args) != lp.f.blocks[b].paramCount) {
    return -1
  }
  return args[k]
}

// The single value EVERY predecessor edge passes to block param `v`, or -1
// when `v` is not a param, has no predecessors, or its sources disagree. It is
// an EQUALITY, so stopping early is a true answer rather than a wrong one.
//
// A nested `if` whose then-arm falls through feeds the loop's outer join the
// same value under two ids: the continuation's own param and the enclosing
// block's param (#5971). So each edge argument is compared after resolving it
// through single-source params, by this same strict rule and never
// `bceParamSource`'s self-skipping one, `bceSameDepth` levels deep. Every
// level is itself an equality, so a resolved argument holds exactly what the
// raw one does, and the depth bound is what ends a walk around a loop.
fn bceSameSource(lp: BceLoop, v: int): int {
  lp.visits[0] = bceSameBudget
  return bceSameSourceAt(lp, v, bceSameDepth)
}

// The params one lookup may visit. Two agreeing edges each recurse, so a chain
// of joins fans out up to 2^8 visits at depth 8; running out answers -1, "no
// single source", which is always true.
const bceSameBudget: int = 64

// How many levels `bceSameRoot` resolves: the steps `bceIsSelf` walks.
const bceSameDepth: int = 8

// `bceSameSource` with `depth` levels of argument resolution left; depth 0
// compares raw ids.
fn bceSameSourceAt(lp: BceLoop, v: int, depth: int): int {
  let k = bceParamSlot(lp, v)
  if (k < 0 || lp.visits[0] <= 0) {
    return -1
  }
  lp.visits[0] = lp.visits[0] - 1
  let b = lp.owner[v]
  let found = -1
  let e = lp.pm.start[b]
  while (e < lp.pm.start[b + 1]) {
    let a = bceSameRoot(lp, bceEdgeArg(lp, b, e, k), depth)
    if (a < 0 || (found >= 0 && a != found)) {
      return -1
    }
    found = a
    e = e + 1
  }
  return found
}

// The value `a` holds once single-source params are resolved `depth` levels
// deep: `a` itself at depth 0 or when it has no single source, -1 for -1.
fn bceSameRoot(lp: BceLoop, a: int, depth: int): int {
  if (a < 0 || depth == 0) {
    return a
  }
  let r = bceSameSourceAt(lp, a, depth - 1)
  if (r < 0) {
    return a
  }
  return r
}

// True iff `a` is param `v` itself, or reaches it through params whose every
// edge agrees: the join and increment blocks `lowerWhile` threads each local
// through on the way back to the header. Uses the strict rule, never the
// self-skipping one, so it cannot recurse into `bceParamSource`.
fn bceIsSelf(lp: BceLoop, a: int, v: int): bool {
  let x = a
  let steps = 0
  while (steps < 8 && x >= 0) {
    if (x == v) {
      return true
    }
    x = bceSameSource(lp, x)
    steps = steps + 1
  }
  return false
}

// The single value block param `v` can hold, or -1. The trivial-phi rule: an
// edge that passes `v` back to itself is skipped, and the param equals the one
// value every OTHER edge passes. -1 when no edge passes anything but `v`.
// The other edges are compared by `bceSameRoot`, like `bceSameSource`'s: the
// loop's outer join also carries the index, and a nested `if` feeds it
// through two ids (#5971).
fn bceParamSource(lp: BceLoop, v: int): int {
  let k = bceParamSlot(lp, v)
  if (k < 0) {
    return -1
  }
  let b = lp.owner[v]
  let found = -1
  let e = lp.pm.start[b]
  while (e < lp.pm.start[b + 1]) {
    let a = bceEdgeArg(lp, b, e, k)
    if (a < 0) {
      return -1
    }
    if (!bceIsSelf(lp, a, v)) {
      lp.visits[0] = bceSameBudget
      let r = bceSameRoot(lp, a, bceSameDepth)
      if (found >= 0 && r != found) {
        return -1
      }
      found = r
    }
    e = e + 1
  }
  return found
}

// `v0` with every block param that can only ever hold one value folded away.
// The step bound is what makes a mutually referring pair of params terminate.
fn bceResolve(lp: BceLoop, v0: int): int {
  let v = v0
  let steps = 0
  while (steps < 8) {
    let w = bceParamSource(lp, v)
    if (w < 0) {
      return v
    }
    v = w
    steps = steps + 1
  }
  return v
}

// The constant `a` adds to `%iv`, or -1: `a` is `%iv + c` or `c + %iv` for a
// non-negative integer constant `c`.
//
// BOTH SIDES ARE RESOLVED, and without that this pass fires on almost nothing.
// `lowerWhile` closes a loop through a separate increment block carrying its
// OWN full parameter list, and a `continue` or a nested `if` adds a join block
// on top — so the back edge passes `add(%joinParam, 1)`, where `%joinParam` is
// a param every edge feeds with the header's own `%iv`. Measured before the
// resolve was added: `appendDuring` in run_while_index_bce.bit kept its bounds
// test for exactly this reason, with the header, the limit and the index all
// otherwise matching.
fn bceAddend(lp: BceLoop, a: int): int {
  let ins = lp.f.instrs[bceResolve(lp, a)]
  if (ins.op != Op.Add) {
    return -1
  }
  if (bceResolve(lp, ins.lhs) == lp.iv) {
    return bceNonNegInt(lp.known, ins.rhs)
  }
  if (bceResolve(lp, ins.rhs) == lp.iv) {
    return bceNonNegInt(lp.known, ins.lhs)
  }
  return -1
}

fn bceNonNegInt(known: []ConstVal, v: int): int {
  if (!bceIsNonNegConst(known, v)) {
    return -1
  }
  return known[v].ival
}

// True iff `a` is `%iv + d` with `1 <= d <= off + 1`: the step. With `off = 0`
// that is `d = 1`, the original rule. `a` may also be a join param every edge
// of which passes a step, `bceStepDepth` joins deep: an `if`/`else` choosing
// between two strides meets in one (#6840, headerEndIn's `+2`/`+1`/`+4`). A
// join off the `F` side is refused; any other `!viaF` join has only `!viaF`
// predecessors, so each edge's add is this iteration's, as for a direct edge.
fn bceIsStep(lp: BceLoop, a: int, depth: int): bool {
  let d = bceAddend(lp, a)
  if (d >= 1) {
    return d <= lp.off + 1
  }
  let r = bceResolve(lp, a)
  let k = bceParamSlot(lp, r)
  if (depth == 0 || k < 0) {
    return false
  }
  let q = lp.owner[r]
  if (q == lp.h || lp.viaF[q] || bcePredCount(lp.pm, q) == 0) {
    return false
  }
  return bceJoinSteps(lp, q, k, depth - 1)
}

// True iff every edge into join `q` passes a step to its param slot `k`.
fn bceJoinSteps(lp: BceLoop, q: int, k: int, depth: int): bool {
  let e = lp.pm.start[q]
  while (e < lp.pm.start[q + 1]) {
    let x = bceEdgeArg(lp, q, e, k)
    if (x < 0 || !bceIsStep(lp, x, depth)) {
      return false
    }
    e = e + 1
  }
  return true
}

const bceStepDepth: int = 4

// One candidate loop, bundled so the walks below stay inside the parameter
// limit — the same reason `LicmCtx` exists. `viaF` is per-header, so this is
// built fresh for each one rather than shared.
class BceLoop {
  f: IrFunc,
  known: []ConstVal,
  pm: PredMap,
  owner: []int,
  viaF: []bool,
  h: int,
  k: int,
  iv: int,
  off: int,
  visits: []int,
}

// One predecessor edge into `h`: 0 refuses the header, 1 accepts the edge as a
// base case, 2 as an unchanged pass-through, 3 as a step.
fn bceClassifyEdge(lp: BceLoop, p: int): int {
  let args = licmEdgeArgs(lp.f, p, lp.h)
  if (len(args) != lp.f.blocks[lp.h].paramCount) {
    return 0
  }
  let a = args[lp.k]
  if (bceIsNonNegConst(lp.known, a) && lp.known[a].ival <= bceMaxInt - lp.off) {
    return 1
  }
  if (bceResolve(lp, a) == lp.iv) {
    return 2
  }
  if (!lp.viaF[p] && bceIsStep(lp, a, bceStepDepth)) {
    return 3
  }
  return 0
}

const bceMaxInt: int = 9223372036854775807

// True iff `h`'s param `k` is provably non-negative on every entry. Refuses a
// header with no predecessors at all, and one with no constant base case.
fn bceIndexNonNegative(lp: BceLoop): bool {
  let sawBase = false
  let e = lp.pm.start[lp.h]
  if (e == lp.pm.start[lp.h + 1]) {
    return false
  }
  while (e < lp.pm.start[lp.h + 1]) {
    let c = bceClassifyEdge(lp, lp.pm.list[e])
    if (c == 0) {
      return false
    }
    if (c == 1) {
      sawBase = true
    }
    e = e + 1
  }
  return sawBase
}

// Records every `icmp_ult(%iv, %lim)` the header's own signed test has already
// decided. `viaF` is the refusal: a block the FALSE arm can reach was not
// tested by that branch at all.
fn bceMarkProven(lp: BceLoop, lim: int) {
  let iv = bceResolve(lp, lp.iv)
  let rl = bceResolve(lp, lim)
  let b = 0
  while (b < len(lp.f.blocks)) {
    if (b != lp.h && !lp.viaF[b]) {
      bceMarkBlock(lp, b, iv, rl)
    }
    b = b + 1
  }
}

// `iv` and `lim` arrive resolved; each compare's operands are resolved here.
fn bceMarkBlock(lp: BceLoop, b: int, iv: int, lim: int) {
  let blk = lp.f.blocks[b]
  let idx = blk.instsStart + blk.paramCount
  let end = blk.instsStart + blk.instsLen
  while (idx < end) {
    let ins = lp.f.instrs[idx]
    if (ins.op == Op.ICmpUlt && !lp.known[idx].known && bceIsWindowIndex(lp, ins.lhs, iv)) {
      if (bceLimitCovers(lp.known, lim, bceResolve(lp, ins.rhs))) {
        lp.known[idx] = boolConst(true)
      }
    }
    idx = idx + 1
  }
}

// True iff `x` is `%iv` itself or, under a header testing `%iv + off`, `%iv + j`
// with `1 <= j <= off`. `0 <= %iv` and `%iv + off < lim` without a wrap give
// `0 <= %iv + j < lim`; the add cannot wrap either, since `%iv + off` did not.
fn bceIsWindowIndex(lp: BceLoop, x: int, iv: int): bool {
  if (bceResolve(lp, x) == iv) {
    return true
  }
  if (lp.off == 0) {
    return false
  }
  let j = bceAddend(lp, x)
  return j >= 1 && j <= lp.off
}

// Whether the header's `iv < lim` already decides `iv <u rhs`: the same value,
// or two integer constants with `lim <= rhs` (#6435: `len` of a string literal
// folds to one, so a loop bounded by one literal indexes a second literal of
// the same or greater length). `0 <= iv < lim <= rhs` gives `iv < rhs` with
// `iv >= 0`, which is `iv <u rhs`; all three are 64-bit, `bceHeaderTest`'s
// refusal.
fn bceLimitCovers(known: []ConstVal, lim: int, rhs: int): bool {
  if (rhs == lim) {
    return true
  }
  let a = known[lim]
  let b = known[rhs]
  return bceIsIntConst(a) && bceIsIntConst(b) && a.ival <= b.ival
}

fn bceIsIntConst(kv: ConstVal): bool {
  return kv.known && !kv.isFloat && !kv.isBool
}

// The `icmp_slt` a candidate header branches on, or -1. Rejects block 0 (its
// params are the caller's), an empty or non-`br` terminator, a `br` whose two
// arms coincide or name the header, and any operand type that is not 64-bit
// signed.
fn bceHeaderTest(ctx: TypeContext, f: IrFunc, h: int): int {
  if (h == 0) {
    return -1
  }
  let ti = bceTerminator(f, h)
  if (ti < 0) {
    return -1
  }
  let term = f.instrs[ti]
  if (term.op != Op.Br || term.ival == term.ival2) {
    return -1
  }
  if (term.ival == h || term.ival2 == h) {
    return -1
  }
  let cmp = f.instrs[term.lhs]
  if (cmp.op != Op.ICmpSlt) {
    return -1
  }
  let p = primOfType(ctx, f.instrs[cmp.lhs].ty)
  if (!isSignedPrim(p) || primBits(p) != 64) {
    return -1
  }
  return term.lhs
}

// The number of predecessor edges into block `b`.
fn bcePredCount(pm: PredMap, b: int): int {
  return pm.start[b + 1] - pm.start[b]
}

// One candidate header. Marks nothing unless every refusal above passes.
fn bceProveHeader(fc: BceFn, h: int) {
  let ci = bceHeaderTest(fc.ctx, fc.f, h)
  if (ci < 0) {
    return
  }
  let cmp = fc.f.instrs[ci]
  let iv = bceHeaderIv(fc.f, h, cmp.lhs)
  if (iv < 0) {
    return
  }
  let term = fc.f.instrs[bceTerminator(fc.f, h)]
  // #5896: MARKING's soundness needs `T` reachable only through `h`'s true
  // edge. `lowerWhile` always gives it one predecessor; refuse the header
  // outright rather than trust that, so a future lowering change that ever
  // gives `T` a second one loses precision here instead of a bounds check.
  if (bcePredCount(fc.pm, term.ival) != 1) {
    return
  }
  let lp = BceLoop{
    f = fc.f, known = fc.known, pm = fc.pm, owner = fc.owner, h = h,
    k = bceParamIndex(fc.f, h, iv), iv = iv, off = 0,
    viaF = bceReachAvoiding(fc.f, term.ival2, h, term.ival),
    visits = [0],
  }
  if (bceWindowSound(lp, cmp, term.ival)) {
    bceMarkProven(lp, cmp.rhs)
  }
}

// The header param the test reads: `v` itself, or the param under `v = %p + c`
// or `c + %p`; -1 otherwise. `bceWindowSound` checks the constant.
fn bceHeaderIv(f: IrFunc, h: int, v: int): int {
  if (bceParamIndex(f, h, v) >= 0) {
    return v
  }
  let ins = f.instrs[v]
  if (ins.op != Op.Add) {
    return -1
  }
  if (bceParamIndex(f, h, ins.lhs) >= 0) {
    return ins.lhs
  }
  if (bceParamIndex(f, h, ins.rhs) >= 0) {
    return ins.rhs
  }
  return -1
}

// THE WINDOW (#6840): a header testing `%iv + off < %L` proves `%iv + j <u %L`
// for `0 <= j <= off`. Sets `lp.off` and answers whether the induction holds.
//
// `0 <= %iv` alone is not enough once `off > 0`: `%iv + off` can WRAP and
// still pass the signed test (`%L = maxInt`, `%iv = maxInt - 2`, `+ 3` reads
// minInt). So the invariant is `0 <= %iv <= B` with `B + off <= maxInt`:
//
//   - a base constant `c` needs `c <= maxInt - off`;
//   - a step `+ d` from a `!viaF` block needs `1 <= d <= off + 1`, so
//     `%iv + d <= %iv + off + 1 <= %L`;
//   - and `%L` itself needs `%L <= maxInt - off` (`bceLimitBounded`).
//
// `off = 0` keeps the original rule exactly: only `+ 1` steps, any base.
fn bceWindowSound(lp: BceLoop, cmp: IrInstr, t: int): bool {
  if (cmp.lhs != lp.iv) {
    lp.off = bceAddend(lp, cmp.lhs)
  }
  if (lp.off < 0 || lp.off > bceMaxOffset) {
    return false
  }
  if (!bceIndexNonNegative(lp)) {
    return false
  }
  return lp.off == 0 || bceLimitBounded(lp, cmp.rhs, t)
}

// The widest window accepted. A length counts the elements of an object in the
// address space, so it is below 2^57 on every target; `2^57 + 4096` is far from
// maxInt, and the cap keeps that margin obvious.
const bceMaxOffset: int = 4096

// Whether the header's `%L` is at most `maxInt - off` on every iteration that
// steps: an integer constant that is, or a LENGTH. `emitBoundsCheck`
// (loweraccess.bit) sets `bval` on its compare because its `rhs` is the length
// of the object being indexed; a marked compare reading `%L` in a block `x` that every
// step passes through puts a real length in `%L` on each iteration that steps.
// The same instance as the header's test: the root is not re-executed between
// the test and `x` (THE SELF EDGE above). Unmarked `icmp_ult`s also come from
// unsigned compares and decimal lowering, which bound nothing.
fn bceLimitBounded(lp: BceLoop, lim: int, t: int): bool {
  let rl = bceResolve(lp, lim)
  if (bceIsIntConst(lp.known[rl])) {
    return lp.known[rl].ival <= bceMaxInt - lp.off
  }
  let b = 0
  while (b < len(lp.f.blocks)) {
    if (b != lp.h && !lp.viaF[b] && bceHasLengthCheck(lp, b, rl) && bceStepsBehind(lp, t, b)) {
      return true
    }
    b = b + 1
  }
  return false
}

// True iff block `b` holds a bounds compare marked by `emitBoundsCheck` whose
// limit resolves to `rl`.
fn bceHasLengthCheck(lp: BceLoop, b: int, rl: int): bool {
  let blk = lp.f.blocks[b]
  let idx = blk.instsStart + blk.paramCount
  while (idx < blk.instsStart + blk.instsLen) {
    let ins = lp.f.instrs[idx]
    if (ins.op == Op.ICmpUlt && ins.bval && bceResolve(lp, ins.rhs) == rl) {
      return true
    }
    idx = idx + 1
  }
  return false
}

// True iff no step edge into `h` leaves a block reachable from `T` without
// passing through `x`: every iteration that steps runs `x`. `T` has one
// predecessor (`bceProveHeader`), so the walk from `T` sees every such path.
fn bceStepsBehind(lp: BceLoop, t: int, x: int): bool {
  let open = bceReachAvoiding(lp.f, t, x, lp.h)
  let e = lp.pm.start[lp.h]
  while (e < lp.pm.start[lp.h + 1]) {
    let p = lp.pm.list[e]
    if (open[p] && bceClassifyEdge(lp, p) == 3) {
      return false
    }
    e = e + 1
  }
  return true
}

// Seeds `known` with every bounds compare a dominating signed loop test has
// already decided. Runs inside `foldConstantsAndPrune`, AFTER `licmPlanFor` so
// that pass sees the constant map it always saw, and BEFORE `computeReachable`,
// which is what drops the panic block.
fn proveInductionBounds(ctx: TypeContext, f: IrFunc, known: []ConstVal) {
  if (!bceHasCandidate(ctx, f)) {
    return
  }
  let fc = BceFn{
    ctx = ctx, f = f, known = known,
    pm = licmPredMap(f), owner = licmOwners(f),
  }
  let h = 0
  while (h < len(f.blocks)) {
    bceProveHeader(fc, h)
    h = h + 1
  }
}

// The per-function analysis state, bundled for the same reason `BceLoop` is.
class BceFn {
  ctx: TypeContext,
  f: IrFunc,
  known: []ConstVal,
  pm: PredMap,
  owner: []int,
}

// One O(blocks) scan so a function with no loop of this shape pays no
// predecessor map and no owner array. Most functions in this tree are that.
fn bceHasCandidate(ctx: TypeContext, f: IrFunc): bool {
  let h = 0
  while (h < len(f.blocks)) {
    if (bceHeaderTest(ctx, f, h) >= 0) {
      return true
    }
    h = h + 1
  }
  return false
}
