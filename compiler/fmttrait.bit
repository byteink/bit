// compiler/fmttrait.bit — formatter support for trait declarations and the
// `use` statement (SPEC §10.7, #3369). Split out as its own sibling rather
// than added to fmt.bit or fmtdispatch.bit, both already close to the
// repo's 800-line ceiling.

// A trait method: `name(params)[: result]`, then a body for a PROVIDED
// method or nothing for a REQUIRED one (k[3] == 0) — no generics and no
// receiver, unlike a class method, so this needs none of
// fmtPrintClassMethod's (fmt.bit) generic-splitting machinery.
fn fmtPrintTraitMethod(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [name, params, result, body_or_none]
  fmtPrintNode(p, k[0])
  fmtPrintNode(p, k[1])
  if (k[2] != 0) {
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[2])
  }
  if (k[3] != 0) {
    fmtRaw(p, " ")
    fmtPrintBodyBlock(p, k[3], true)
  }
}

// `use A, B`: the trait names, comma-separated, in the order written.
fn fmtPrintUseStmt(p: Printer, idx: int) {
  let names = kidsOf(p.tree, idx)
  fmtRaw(p, "use ")
  let i = 0
  while (i < len(names)) {
    if (i > 0) {
      fmtRaw(p, ", ")
    }
    fmtPrintNode(p, names[i])
    i = i + 1
  }
}

// `trait Name { ... }` — always the one-member-per-line block rendering
// (fmt.bit's fmtPrintMemberBlock), never the comma-list a field-only class
// falls back to: a trait mixes `use` statements, methods and fields (#3370)
// freely, so there is no shape where every member is a bare field the way a
// field-only class can be. A trait field itself needs no dedicated printer
// here — `fmtPrintMember`/`fmtPrintNode` already dispatch a `Tag.Field` to
// the same renderer a class field uses.
fn fmtPrintTraitDecl(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [name, member_list]
  fmtRaw(p, "trait ")
  fmtPrintNode(p, k[0])
  fmtRaw(p, " ")
  fmtPrintMemberBlock(p, kidsOf(p.tree, k[1]), getNode(p.tree, k[1]).span)
}
