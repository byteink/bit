// compiler/lowermethodtable.bit — split out of compiler/lowerdriver.bit
// (#5640, which was at the 800-line E0200 ceiling with zero headroom).
// Sibling of lowerdriver.bit: same module (directory-scanned), so this
// needs no imports and no call-site changes.
//
// Pass A3' — per-type method dispatch tables (runtime/ABI.md §2.1), built
// from every method decl in the project, in exactly the order Pass A3
// (lowerinstemit.bit's lowerModuleMethods) lowers them.

// One method decl's share of Pass A3'. A NON-generic receiver contributes one
// entry, keyed on its own type id. A GENERIC receiver contributes one PER
// NOMINAL INSTANTIATION, keyed on that INSTANCE's id — the same filter
// `lowerMethodInstances` (Pass A3) selects emissions with, because a slot's
// symbol is `<prefix><name>$t<key>` and `$t<inst.result>` is the name Pass A3
// emits that instance's body under.
//
// #4675: keying a generic receiver on `userTypeLookup`'s answer — the TEMPLATE's
// id, which `lowerFuncNamed` already documents as the wrong one for a symbol —
// built a table under a key no descriptor ever asks for. `gc_alloc` carries the
// INSTANCE's id, so `methodTableOf` (compiler/ir.bit) answered "no methods", the
// emitted TypeInfo came out with `methods_len == 0`, and `bit_rt_iface_lookup`
// returned 0 (runtime/root/iface.bit): `let d = Holder<i64>{...}` dispatched
// through an interface branched to address 0. `bit check` was clean and the
// compiler exited 0, so the miscompile only showed as the PROGRAM segfaulting.
//
// A3' runs after Pass A1's monomorphization closure and before any body is
// lowered, so `typeInsts` here is a prefix of what Pass A3 later walks: every
// entry named below has a body emitted for it, which is the dangling-reference
// rule the caller states.
// `sinceTypeInst` is 0 for the first, project-wide pass and `lowerProject`'s
// baseline `typeInsts` length for the #6248 delta pass that closes over
// instances minted while a generic FUNCTION body was lowered (see
// `lowerProject`, lowerglobal.bit) — the non-generic branch does not depend
// on `typeInsts` at all, so it runs once, on the first pass only, and the
// generic branch resumes scanning where the previous pass left off instead
// of re-adding entries for instances it already collected.
fn collectMethodEntry(
  c: Checker,
  lw: Lowerer,
  recvName: string,
  mname: string,
  sinceTypeInst: int,
) {
  let params = declTypeParamIds(c, recvName)
  if (len(params) == 0) {
    if (sinceTypeInst > 0) {
      return
    }
    let recvTy = userTypeLookup(c, recvName)
    lw.methodEntries = append(
      lw.methodEntries,
      MethodEntry{
        recvTy = recvTy, name = mname, prefix = lw.modPrefix,
        sig = methodSigLookup(c, "${recvTy}.${mname}"),
      },
    )
    return
  }
  let i = sinceTypeInst
  while (i < len(c.ctx.typeInsts)) {
    let inst = c.ctx.typeInsts[i]
    if (inst.module == c.moduleId && inst.name == recvName && len(inst.args) == len(params)) {
      lw.methodEntries = append(
        lw.methodEntries,
        MethodEntry{
          recvTy = inst.result, name = mname, prefix = lw.modPrefix,
          sig = methodSigLookup(c, "${inst.result}.${mname}"),
        },
      )
    }
    i = i + 1
  }
}

// Pass A3' — every method decl in the project, in exactly the order Pass A3
// lowers them (module order, then node order, `FuncDecl` with a receiver).
// Split out of `lowerFuncNamed` so the entries, and therefore the dispatch ids,
// exist before the first body is lowered (#1471). Everything an entry holds is
// derivable from the decl alone, so this needs no lowering state beyond the
// module prefix.
fn collectMethodEntries(mods: []Checker, root: int, lw: Lowerer, sinceTypeInst: int) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lw.modPrefix = modulePrefix(mi, root)
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      // Node-for-node with Pass A3 (`lowerModuleMethods`), which is the whole
      // contract of this walk — a table slot names a symbol, and a slot naming
      // one nothing emits is a dangling data reference the linker only reports
      // if dead-code stripping does not happen to remove it first. A method
      // that declares its own type params has no single body (it is
      // monomorphized, #4495) and cannot be reached dynamically anyway: SPEC's
      // `method_sig` takes no `generic_params` (parsertype.bit's
      // `parseMethodSig`), so no interface can declare one to dispatch to.
      // An enum's synthesized `__variantName`/`__variants`/`__variantAt` (enumvariants.bit)
      // get no entry either: a bare-tag enum is never an interface value
      // (SPEC §14.7), so nothing dispatches to them, and an entry would mint
      // two dispatch ids and a table in every program that declares an enum.
      if (n.tag == Tag.FuncDecl &&
        kidsOf(c.tree, m)[0] != 0 &&
        methodOwnGenericCount(c, m) == 0 &&
        !isEnumVariantsDecl(c, m)) {
        let kids = kidsOf(c.tree, m)
        let nm = getNode(c.tree, kids[1])
        collectMethodEntry(
          c, lw, typeNodeName(c, kidsOf(c.tree, kids[0])[1]),
          c.source[nm.span.start:nm.span.end], sinceTypeInst,
        )
      }
      m = m + 1
    }
    mi = mi + 1
  }
}

// Per-type method tables (runtime/ABI.md §2.1) from Pass A3's entries: one table
// per distinct receiver type in first-seen order, each holding that type's
// methods in declaration order with their global dispatch ids. call_iface
// resolves through these at runtime.
fn buildMethodTables(lw: Lowerer, c: Checker): []MethodTable {
  let ctx = c.ctx
  let selfMethods = selfIfaceMethods(c)
  let tables = []MethodTable(0)
  let seen = map<int, bool>{}
  let i = 0
  while (i < len(lw.methodEntries)) {
    let disc = lw.methodEntries[i].recvTy
    let (_, already) = seen[disc]
    if (already) {
      i = i + 1
      continue
    }
    seen[disc] = true
    let methods = []MethodSlot(0)
    let j = 0
    while (j < len(lw.methodEntries)) {
      let e = lw.methodEntries[j]
      if (e.recvTy == disc) {
        // The id is assigned from the raw name (global across modules); the
        // symbol carries the declaring module's prefix.
        let sym = e.prefix + e.name + "\$t${disc}"
        methods = append(
          methods,
          MethodSlot{ id = mintMethodId(lw, ctx, e.name, e.sig), func = sym },
        )
        for extra of selfSlots(lw, c, selfMethods, e, methods) {
          methods = append(methods, extra)
        }
      }
      j = j + 1
    }
    tables = append(tables, MethodTable{ typeDisc = disc, methods = methods })
    i = i + 1
  }
  return tables
}

// An interface method whose signature mentions `Self` (SPEC §11.3), as the
// interface declares it.
class SelfMethod {
  name: string,
  sig: int,
}

// Every `Self`-bearing method of every interface, in type-id then declaration
// order so the ids minted from them are deterministic. Empty for a program
// with no such interface, which then mints nothing extra (#7387).
fn selfIfaceMethods(c: Checker): []SelfMethod {
  let out = []SelfMethod(0)
  let i = 0
  while (i < len(c.ctx.types)) {
    if (c.ctx.types[i].kind == TypeKind.Interface) {
      for m of vIfaceMethodNames(c, i) {
        let sig = methodSigLookup(c, "${i}.${m}")
        if (sig != 0 && len(vCollectSelf(c, sig, 0, []int(0))) != 0) {
          out = append(out, SelfMethod{ name = m, sig = sig })
        }
      }
    }
    i = i + 1
  }
  return out
}

// A dispatch id keys on the method's NAME AND SIGNATURE (`methodId`), and an
// interface's `dup(): Self` renders `Self` where the class's own `dup(): A`
// renders `A`, so the two never meet. The class's method is therefore ALSO
// filed under each `Self`-bearing interface signature it satisfies, i.e. the
// one whose `Self` bound to this receiver gives the class's own signature
// (`vBindSelf`, the same test `vSatisfies` makes). `methods` already holds the
// method under its own key; the slots returned are only those new to it.
fn selfSlots(
  lw: Lowerer, c: Checker, selfMethods: []SelfMethod, e: MethodEntry, methods: []MethodSlot,
): []MethodSlot {
  let out = []MethodSlot(0)
  for sm of selfMethods {
    if (sm.name != e.name || vBindSelf(c, sm.sig, e.recvTy) != e.sig) {
      continue
    }
    let id = mintMethodId(lw, c.ctx, sm.name, sm.sig)
    if (!slotsHaveId(methods, id) && !slotsHaveId(out, id)) {
      out = append(out, MethodSlot{ id = id, func = e.prefix + e.name + "\$t${e.recvTy}" })
    }
  }
  return out
}

fn slotsHaveId(slots: []MethodSlot, id: int): bool {
  for s of slots {
    if (s.id == id) {
      return true
    }
  }
  return false
}

// #6114: `buildMethodTables` with every slot no lowered site dispatches to
// dropped, called once every body is lowered. A slot is a relocation to its
// method, so the linker's dead strip (strip.bit) keeps whatever the slot names
// and everything that reaches: one `App.listenTls()` in pkg/web put TLS, QUIC,
// HTTP/2, HTTP/3 and X.509 into a server that only ever calls `listen()`. A
// table is only ever read by `bit_rt_iface_lookup`/`bit_rt_iface_has` with an
// id `methodId` handed to a lowered site, so a slot whose id no site holds is
// never read. The table itself stays, possibly empty: the emitter keys a
// TypeInfo on it, and `methods_len == 0` is legal (runtime/ABI.md §2.1).
fn dispatchedTables(tables: []MethodTable, dispatched: map<int, bool>): []MethodTable {
  let out = []MethodTable(0)
  for t of tables {
    let methods = []MethodSlot(0)
    for slot of t.methods {
      let (_, hit) = dispatched[slot.id]
      if (hit) {
        methods = append(methods, slot)
      }
    }
    out = append(out, MethodTable{ typeDisc = t.typeDisc, methods = methods })
  }
  return out
}

// #6248: whether `c`'s own tree declares at least one method (a `FuncDecl`
// with a receiver, own type params excluded — same filter as
// `collectMethodEntries`) on `recvName`. Independent of `collectMethodEntry`'s
// bookkeeping so it can serve as this ticket's ircheck's oracle rather than
// restating the same state it is meant to catch a regression in.
fn declaresAnyMethod(c: Checker, recvName: string): bool {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0 && methodOwnGenericCount(c, m) == 0) {
      let rn = typeNodeName(c, kidsOf(c.tree, kidsOf(c.tree, m)[0])[1])
      if (rn == recvName) {
        return true
      }
    }
    m = m + 1
  }
  return false
}

// Memoizes `declaresAnyMethod` across `typeInsts` entries that share a
// receiver — `Sq<bool>`, `Sq<i64>`, ... all ask the identical AST question,
// and re-walking the tree once per instance would turn a linear ircheck into
// a quadratic one on a program with many instantiations of a few generics.
fn declaresAnyMethodMemo(c: Checker, recvName: string, memo: map<string, bool>): bool {
  let key = "${c.moduleId}:${recvName}"
  let (has, present) = memo[key]
  if (present) {
    return has
  }
  let answer = declaresAnyMethod(c, recvName)
  memo[key] = answer
  return answer
}

fn hasMethodTableFor(tables: []MethodTable, disc: int): bool {
  let i = 0
  while (i < len(tables)) {
    if (tables[i].typeDisc == disc) {
      return true
    }
    i = i + 1
  }
  return false
}

// #6248 ircheck: every nominal instantiation of a generic receiver that
// declares at least one method has a MethodTable entry — existence, not
// non-emptiness (#6114 may still drop every slot if nothing dispatches to
// it; that is legal, see `dispatchedTables` above). Independent of
// `collectMethodEntries`'s own bookkeeping: this walks the CLOSED
// `ctx.typeInsts` and the declaring module's tree fresh, so a regression
// that lets an instantiation escape the fixpoint in `lowerProject`
// (lowerglobal.bit) — the exact shape of #6248, a `Sq<bool>` minted while
// lowering a generic FUNCTION's body and never folded into `methodTables` —
// fails HERE, at compile time, instead of shipping a TypeInfo whose method
// table `bit_rt_iface_lookup` (runtime/root/iface.bit) answers with a null
// slot and a call site jumps to address 0.
fn assertMethodTablesCoverInstantiations(mods: []Checker, ctx: TypeContext, tables: []MethodTable) {
  let memo = map<string, bool>{}
  let i = 0
  while (i < len(ctx.typeInsts)) {
    let inst = ctx.typeInsts[i]
    if (inst.module >= 0 &&
      inst.module < len(mods) &&
      declaresAnyMethodMemo(mods[inst.module], inst.name, memo) &&
      !hasMethodTableFor(tables, inst.result)) {
      panic(
          "#6248: ${inst.name} (type ${inst.result}) declares a method but " +
          "lowering built no MethodTable for it -- a receiver a table slot " +
          "would name is missing, which is exactly the runtime jump-to-0 " +
          "this assertion exists to refuse at compile time",
      )
    }
    i = i + 1
  }
}

// `lowerProject`'s (lowerglobal.bit) #6248 fixpoint. `baseline` is the
// `typeInsts` length Pass A3' closed over before any body lowered. If
// lowering the project's bodies minted more instances since — a nominal
// instantiation of a generic receiver reached only from inside a generic
// FUNCTION's own body, like `Sq<bool>` in `fn make<U>(x: U): Shape { return
// Sq<U>{...} }` — this re-collects just the delta (`mintMethodId` dedups by
// (name, sig), so an id an earlier instance already claimed never changes)
// and rebuilds `tables` from the closed set. Either way, the ircheck above
// has the final say: it fails loudly if the closure still missed something,
// rather than shipping a table `bit_rt_iface_lookup` answers with a null slot.
fn closeLateMethodTables(
  mods: []Checker, root: int, lowerer: Lowerer, baseline: int, tables: []MethodTable,
): []MethodTable {
  let out = tables
  if (len(mods[root].ctx.typeInsts) > baseline) {
    collectMethodEntries(mods, root, lowerer, baseline)
    out = buildMethodTables(lowerer, mods[root])
  }
  assertMethodTablesCoverInstantiations(mods, mods[root].ctx, out)
  return out
}

// `lowerProject`'s Pass A3' entry point: collects every method decl into
// `lowerer.methodEntries` and builds the per-type tables from them, before
// any body is lowered. Returns the `typeInsts` length observed at that
// moment too — `closeMethodTablesOverLateInstantiations` above needs it as
// the baseline for what counts as "minted while a body lowered" (#6248).
fn collectAndBuildMethodTables(mods: []Checker, root: int, lowerer: Lowerer): (int, []MethodTable) {
  collectMethodEntries(mods, root, lowerer, 0)
  let baseline = len(mods[root].ctx.typeInsts)
  return (baseline, buildMethodTables(lowerer, mods[root]))
}

// #6260: a synthesized static (`lowerinstemit.bit`'s `lowerModuleMethods`
// deferred lowering it) — @json's `injectCollectionNameDecls`
// (classcollectiondesc.bit) and @table's four (`injectTableRowSynth`,
// classtablerow.bit) inject one of these on EVERY carrying class regardless
// of use, so `c`/`decl` are what `lowerFunc` needs to lower it LATE, once
// reachability is known, rather than what it needed to decide reachability.
class SynthStaticCandidate {
  c: Checker,
  decl: int,
  recvTy: int,
  mname: string,
}

// True iff `name` is one of the seven reserved synthesized statics #6260
// makes conditional on reachability. Matched by name alone — the same way
// `vReservedCollectionName`/E0178 (classcollectiondesc.bit, classtablerow.bit)
// already refuse a user declaring one — so this is ONE general rule over the
// whole set, never a branch per member. `synthManyToManyJoinsName` (#6323)
// joins the set for the identical reason `synthColumnsName`/
// `synthTableAttrsRowName` are here: a program that never calls `__tables()`
// must get no new IR for a `@manyToMany` join it never asked about.
fn isPrunableSynthStaticName(name: string): bool {
  return name == synthCollectionNameName ||
    name == synthTableNameName ||
    name == synthClassNameName ||
    name == synthFromRowName ||
    name == synthColumnsName ||
    name == synthValuesName ||
    name == synthTableAttrsRowName ||
    name == synthLoadRelationName ||
    name == synthLinkRelationName ||
    name == synthManyToManyJoinsName
}

// #6267: true iff FuncDecl `m` is exactly the shape `lowerModuleMethods`
// (lowerinstemit.bit) defers into a `SynthStaticCandidate` rather than lowers
// inline — a plain (non-generic, non-generic-receiver) method whose name is
// one of the reserved synthesized statics. `moduleReservedCount`
// (lowerinstemit.bit) reads this SAME predicate to exclude a deferred decl from
// the closure FuncId budget: that budget is fixed before any body lowers, long
// before `lowerReachableSynthStatics` knows whether a candidate has a caller,
// so a decl only `lowerModuleMethods` recognizes as deferred would otherwise
// reserve an id no oracle build (which never declared it) counts, shifting
// every `spawn$trampoline$N` after it. One predicate read by both sites is
// what keeps "deferred" and "reserves nothing" from drifting apart.
fn isDeferredSynthStaticDecl(c: Checker, m: int): bool {
  if (kidsOf(c.tree, m)[0] == 0 || methodOwnGenericCount(c, m) != 0) {
    return false
  }
  let recvName = typeNodeName(c, kidsOf(c.tree, kidsOf(c.tree, m)[0])[1])
  if (len(declTypeParamIds(c, recvName)) != 0) {
    return false
  }
  let nm = getNode(c.tree, kidsOf(c.tree, m)[1])
  return isPrunableSynthStaticName(c.source[nm.span.start:nm.span.end]) || isEnumVariantsDecl(c, m)
}

// Every symbol `funcs` already calls, takes the address of, or closes over.
// `Op.Call`/`Op.FuncAddr`/`Op.MakeClosure` are the three ops whose `name`
// names another function by symbol (ir.bit's `IrInstr.name` field doc);
// `Op.CallIface`/`Op.CallValue` resolve through a table or a runtime value
// instead and carry no callee name to read.
fn referencedCalleeNames(funcs: []IrFunc): map<string, bool> {
  let out = map<string, bool>{}
  for f of funcs {
    for ins of f.instrs {
      if (ins.op == Op.Call || ins.op == Op.FuncAddr || ins.op == Op.MakeClosure) {
        out[ins.name] = true
      }
    }
  }
  return out
}

// #6260: lowers exactly the deferred synthesized statics a call site
// reaches. A direct `T.__collectionName()` after a bound generic's
// instantiation substitutes a concrete `T` lowers through
// `methodSymbol` (lowerglobal.bit)/`emitStaticMethodCall` (lowerexplodemethod.bit) under the SAME
// symbol `methodSymbol` recomputes here, so membership in
// `referencedCalleeNames` is exact, never a heuristic — a candidate this
// drops has no relocation anywhere in `funcs` to be a dangling reference to.
// Runs after every OTHER Pass A (top-level functions), Pass A2 (generic
// instantiations) and Pass A3 body is already in `funcs`: `lowerModuleMethods`
// defers a synthesized static rather than lowering it inline, so a direct
// call from one class's ordinary method to another class's synthesized
// static is captured before this runs too.
fn lowerReachableSynthStatics(
  lowerer: Lowerer, funcs: []IrFunc, candidates: []SynthStaticCandidate,
): []IrFunc {
  // #6265: a closure literal lowered inside a Pass A3 method body (`build$t<N>`
  // capturing `(n) => T.__fromRow(n)`) is NOT yet in `funcs` here — it only
  // joins `funcs` in `lowerProjectFuncs`'s Pass A4, AFTER this sweep runs.
  // `lowerer.closureFuncs` already holds it (appended the moment the closure
  // itself lowered, earlier in this same Pass A3), so the reachability scan
  // must read both lists or a synthesized static reached ONLY through a
  // closure's own body stays pruned and its call site links to nothing.
  //
  // #6275/#6277: a CANDIDATE'S OWN body, once lowered BY THIS LOOP, can
  // itself make ANOTHER candidate reachable — `__loadRelation`'s `with()`
  // arm for a `@manyToMany` field (compiler/classtablerelationlink.bit's
  // `rbFromRowArrow`) synthesizes a closure `(rows) => Target.__fromRow(rows)`
  // INSIDE `__loadRelation`'s own deferred body, so `Target.__fromRow`
  // (also a candidate) is discovered only once `__loadRelation` itself is
  // lowered — after the single `referenced` snapshot the old single-pass
  // version took before this loop ever started, which linked
  // `undefined symbol '___fromRow$t...'` the moment two prunable candidates
  // chained through a synthesized closure this way. Fixed-point instead:
  // keep sweeping every NOT-YET-lowered candidate against a freshly
  // rebuilt `referenced` (which now also sees every candidate's own
  // lowered body and any closure IT created) until one full pass lowers
  // nothing new. Bounded at `len(candidates) + 1` passes — each pass that
  // makes progress lowers at least one candidate, so no more passes than
  // candidates can ever be needed.
  let lowered = map<int, bool>{}
  let changed = true
  let pass = 0
  while (changed && pass <= len(candidates)) {
    pass = pass + 1
    let referenced = referencedCalleeNames(funcs)
    for (name, _) of referencedCalleeNames(lowerer.closureFuncs) {
      referenced[name] = true
    }
    let (out, madeProgress) = sweepReachableSynthStatics(
      lowerer,
      funcs,
      candidates,
      referenced,
      lowered,
    )
    funcs = out
    changed = madeProgress
  }
  return funcs
}

// One pass over every `candidates` entry not yet in `lowered`: lowers each
// whose symbol `referenced` (this pass's own snapshot, `lowerReachableSynthStatics`)
// already names, marking it lowered so a later pass never repeats it. Split
// out of `lowerReachableSynthStatics` to stay inside LINT.md's max-nesting=4
// — that function's own fixed-point `while` already costs it one level.
fn sweepReachableSynthStatics(
  lowerer: Lowerer, funcs: []IrFunc, candidates: []SynthStaticCandidate,
  referenced: map<string, bool>, lowered: map<int, bool>,
): ([]IrFunc, bool) {
  let changed = false
  let ci = 0
  while (ci < len(candidates)) {
    let (already, _) = lowered[ci]
    if (!already) {
      let (out, hit) = lowerOneReachableCandidate(lowerer, funcs, candidates[ci], referenced)
      funcs = out
      if (hit) {
        lowered[ci] = true
        changed = true
      }
    }
    ci = ci + 1
  }
  return (funcs, changed)
}

// `cand`, lowered and appended to `funcs` iff `referenced` already names its
// own symbol — split out of `sweepReachableSynthStatics` for the identical
// max-nesting reason.
fn lowerOneReachableCandidate(
  lowerer: Lowerer, funcs: []IrFunc, cand: SynthStaticCandidate, referenced: map<string, bool>,
): ([]IrFunc, bool) {
  let sym = methodSymbol(lowerer, cand.mname, cand.recvTy)
  let (_, hit) = referenced[sym]
  if (!hit) {
    return (funcs, false)
  }
  let (mod, known) = lowerer.typeModule[cand.recvTy]
  lowerer.modPrefix = ""
  if (known) {
    lowerer.modPrefix = modulePrefix(mod, lowerer.root)
    lowerer.curModule = mod
  }
  // bit:lint allow E0214 -- growth returned via the tuple below; both callers reassign funcs from it
  funcs = append(funcs, lowerFunc(cand.c, cand.decl, collectModuleConsts(cand.c), lowerer))
  return (funcs, true)
}
