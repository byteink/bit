// compiler/relationautopath.bit — the dotted relation-path algebra R1's walk
// (relationauto.bit, #6318 nested reads) records names with: building a path,
// testing ancestry, merging a name into a set, and the depth bound. Moved
// verbatim out of relationauto.bit (792 lines against the 800-line ceiling
// once #6366 needed room); a sibling .bit file is the same module, so this is
// a pure move with no import or call-site change.

// `prefix` with `name` appended as one more dotted segment — "" + "author"
// is "author", "author" + "posts" is "author.posts" (#6318). The one place
// a recorded relation name is actually BUILT; every reader downstream
// treats the result as an opaque string (relationauto.bit's own header).
fn relationAutoJoinPath(prefix: string, name: string): string {
  if (prefix == "") {
    return name
  }
  return prefix + "." + name
}

// Whether `path` IS `prefix`, or nests directly under it — `"author"` is a
// prefix of `"author.posts"` and of itself, never of `"authors"` (the `.`
// boundary check is exact, not a bare substring match).
fn relationAutoPathIsPrefixOf(prefix: string, path: string): bool {
  if (path == prefix) {
    return true
  }
  return len(path) > len(prefix) && path[0:len(prefix)] == prefix && path[len(prefix)] == '.'
}

// Adds `name` to `names`, collapsing it against any existing entry that is
// a dotted-path ANCESTOR or DESCENDANT of it (#6318). `.with("author.posts")`
// already loads "author" on its way to "posts" (`pkg/orm/relationload.bit`'s
// own recursive dispatch) — keeping a bare "author" alongside it as a
// SEPARATE `.with()` name is not just wasted work, `repoLoadWith`
// (pkg/orm/reporelations.bit) runs every queued name in order, and a
// shorter name loaded AFTER a longer one overwrites the longer one's own
// nested load with a fresh, unloaded target. So: a new name that is a
// PREFIX of an entry already present is dropped (already implied by the
// more specific one); a new name that SUBSUMES an existing shorter entry
// replaces it; two unrelated paths (`"author.posts"`/`"author.company"`)
// keep both. The one merge funnel `relationAutoRecordRead` (below) and
// `compiler/relationautocalls.bit`'s own `relationAutoMergedParams` both
// use, so a name is never recorded twice under two different specificities
// either way.
fn relationAutoMergeName(names: []string, name: string): []string {
  let out = []string(0)
  let subsumed = false
  for existing of names {
    if (relationAutoPathIsPrefixOf(name, existing)) {
      // `name` is `existing` itself, or a shorter ancestor of it — already
      // implied by the more specific entry already present.
      subsumed = true
      out = append(out, existing)
      continue
    }
    if (relationAutoPathIsPrefixOf(existing, name)) {
      // `existing` is a shorter ancestor of `name` — dropped, `name`
      // subsumes it.
      continue
    }
    out = append(out, existing)
  }
  if (subsumed) {
    return out
  }
  return append(out, name)
}

// A dotted `.with(...)` path, or a nested source read chain, cannot
// meaningfully nest past this many relation hops — #6318's own bound,
// mirrored on the runtime side by `pkg/orm/relationload.bit`'s
// `relationMaxPathDepth`. Real schemas bottom out in 2-3 hops; this exists
// only so a pathological or cyclic one (`post.author.posts.author...`)
// cannot grow this pass's own state without limit.
const relationAutoMaxPathDepth = 8

fn relationAutoPathDepth(path: string): int {
  let n = 1
  let i = 0
  while (i < len(path)) {
    if (path[i] == '.') {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// `path` split at its first dot: "author.posts" is ("author", "posts"), "author"
// is ("author", "") (#6408). The inverse of `relationAutoJoinPath`.
fn relationAutoSplitHop(path: string): (string, string) {
  let i = 0
  while (i < len(path)) {
    if (path[i] == '.') {
      return (path[0:i], path[i + 1:])
    }
    i = i + 1
  }
  return (path, "")
}

// `path` split at its last dot: "author.posts" is ("author", "posts"), "author"
// is ("", "author") (#6408).
fn relationAutoSplitLastHop(path: string): (string, string) {
  let i = len(path) - 1
  while (i >= 0) {
    if (path[i] == '.') {
      return (path[0:i], path[i + 1:])
    }
    i = i - 1
  }
  return ("", path)
}
