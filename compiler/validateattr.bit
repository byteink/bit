// Self-host: validation of function attributes (#1503, split out of
// validate.bit). Symbol pinning, @naked, and the @nosplit call-graph walk.

// ---- §10.3.1 function attributes -------------------------------------------

// The source text of an identifier node, read from THIS module's source.
fn vIdentText(c: Checker, node: int): string {
  let n = getNode(c.tree, node)
  return c.source[n.span.start:n.span.end]
}

// A scalar value type (§10.3.1): any prim but `string` (prim 11), or a bare type
// parameter. Exactly the results a naked function can hand back in a register.
fn vIsScalarValue(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  if (k == TypeKind.Prim) { return c.ctx.types[ty].prim != 11 }
  return k == TypeKind.TypeParam
}

// §14.6 comparability, mirroring `comparable`. Only the kinds
// the seed calls out as NON-comparable answer false; everything else — prims,
// untyped literals, interfaces, type params, raw pointers (compared by address,
// §11.4) and `invalid` — is comparable, which is also THE SAFETY RULE: an
// unresolved type must never manufacture a diagnostic.
//
// Class is deliberately PERMISSIVE where the seed recurses its fields. A
// class's field types live in `ctx.structFields` keyed by name, and a
// single-file check of a multi-file module resolves only part of that table, so
// a field-walk here would judge on an incomplete set. Under-reporting E0052 on
// class keys costs MISSING; judging on a partial table would risk FALSEPOS.
fn vComparable(c: Checker, ty: int, depth: int): bool {
  if (depth > 32) { return true }
  let k = c.ctx.types[ty].kind
  if (k == TypeKind.Slice || k == TypeKind.Map || k == TypeKind.Func ||
      k == TypeKind.Chan || k == TypeKind.Void || k == TypeKind.Fallible) {
    return false
  }
  if (k == TypeKind.Array) { return vComparable(c, c.ctx.types[ty].elem, depth + 1) }
  if (k == TypeKind.Tuple) {
    let ms = c.ctx.types[ty].members
    let i = 0
    while (i < len(ms)) {
      if (!vComparable(c, ms[i], depth + 1)) { return false }
      i = i + 1
    }
    return true
  }
  // A C-like enum is an integer tag, so it compares by tag; a payload enum
  // carries data and has no structural equality yet (§14.6).
  if (k == TypeKind.Enum) { return !c.ctx.types[ty].enumBoxed }
  return true
}

// Whether a resolved TypeId may be judged at all: id 0 and `Invalid` are what an
// unresolved annotation holds, and the seed guards both emit sites with
// `!= .invalid` for exactly that reason.
fn vTypeResolved(c: Checker, ty: int): bool {
  if (ty == 0) { return false }
  return c.ctx.types[ty].kind != TypeKind.Invalid
}

// E0052 / E0072 for ONE type node, judged after its components — the seed emits
// these inside `checkType`, which evaluates a composite type's parts before
// emitting on the composite itself, so `map<[]int, map<[]int, int>>` reports
// inner-first (#1521).
//
// This is the node's own judgement only; the caller owns the recursion, so the
// same rule composes whether it is reached from the statement walk (a body
// annotation, interleaved with that statement's other diagnostics) or from
// `vTypeNodes` (a signature, walked as a unit).
//
// Both predicates read only the annotation's own resolved type — never the flat
// env, never a receiver — so this carries none of E0057's false-positive risk.
fn vTypeNode(c: Checker, node: int) {
  if (node == 0) { return }
  let kids = kidsOf(c.tree, node)
  // A parse error can leave a type node short of its kids; judging nothing is
  // the permissive answer.
  let tag = getNode(c.tree, node).tag
  // E0058 enters from the declaring construct, not from the type node itself:
  // this walk visits EVERY node, and a type reference is only recognisable from
  // the position it sits in (see vTypeRef).
  vTypeRef(c, vDeclaredTypeKid(c, node), 0)
  if (len(kids) < 2) { return }
  if (tag == Tag.MapType) {
    let key = typeFromNode(c, kids[0])
    if (vTypeResolved(c, key) && !vComparable(c, key, 0)) {
      reportNoHint(c.diags, ecNotComparable, vSpan(c, kids[0]),
        "map key type must be comparable")
    }
  } else if (tag == Tag.ArrayType) {
    // §12: the length is a compile-time constant. The parser accepts a whole
    // expression there since #1903, so THIS is what keeps the promise — without
    // it a non-constant size folds to -1 and `mkArray` builds an array of
    // length -1, which compiles clean and prints `len(a) == -1` at runtime. A
    // silent wrong answer is strictly worse than the parse error this replaced.
    if (checkArraySize(c, kids[0]) < 0) {
      reportNoHint(c.diags, ecNonConstantExpr, vSpan(c, kids[0]),
        "array length must be a compile-time constant integer")
    }
    // §11.2: a `[N]T` box holds no GC references, so a reference-typed element
    // would need per-element tracing that does not exist yet.
    let elem = typeFromNode(c, kids[1])
    if (vTypeResolved(c, elem) && !vIsScalarValue(c, elem)) {
      reportNoHint(c.diags, ecInvalidArrayElement, vSpan(c, kids[1]),
        "fixed-size arrays of reference-typed elements are not yet supported; the element type must be a scalar value type (integer, bool, or float)")
    }
  } else if (tag == Tag.QualType) {
    vQualType(c, node)
  }
}

// E0046 for a namespace-qualified TYPE name (`io.Bogus`, #2118): the same
// export-table presence test `vMember` runs for a namespaced VALUE reference
// (`io.bogus()`), reused here because `checktype.bit`'s `typeFromNodeIn`
// resolves a `QualType` through the identical `importedFrom` table
// `bindNamespaceImport` populates for every export — a name that is either
// unexported (module-private) or does not exist at all is absent from it
// either way, so both negative cases share this one check.
fn vQualType(c: Checker, node: int) {
  let qn = nsQualifiedName(c, node)
  if (qn == "") {
    return
  }
  let (_, ok) = c.importedFrom[qn]
  if (ok) {
    return
  }
  let kids = kidsOf(c.tree, node)
  let mn = getNode(c.tree, kids[1])
  let mname = c.source[mn.span.start:mn.span.end]
  report(c.diags, ecUnexportedName, vSpan(c, kids[1]),
    "'${mname}' is not exported by this module",
    "add 'export' to its declaration in the source module, or check the spelling")
}

// ---- E0058 generic arity at a type REFERENCE (§15.1) -----------------------

// The declared type-parameter count of the generic user type `name`, or 0 when
// this checker cannot positively establish one. Zero is the permissive answer
// and both judgements below require > 0 before reporting: `structTypeParamCount`
// reaches only STRUCT declarations, so a generic enum or type alias also lands
// on 0, and judging `Result<T, E>` against a count we never derived would refuse
// valid code. Requiring > 0 means we judge only names we positively know to be
// generic structs; every other shape under-reports, costing MISSING, never
// FALSEPOS.
fn vGenericArity(c: Checker, name: string): int {
  if (name == "") { return 0 }
  let ut = userTypeLookup(c, name)
  if (ut == 0) { return 0 }
  return structTypeParamCount(c, ut)
}

// E0058 for one node in TYPE position: a generic type named with the wrong
// number of type arguments (§15.1) — bare (`Box`) or mis-arity (`Box<i64, i64>`),
// the seed's two `checkTypeIdent`/`checkTypeGenericInst` emit sites.
//
// MUST be driven only from a known type POSITION, never from the blanket node
// walk that reaches `vTypeNode`. A bare `Ident` is just an identifier: judging
// every one of them would fire on a variable named after a generic type and on
// every mention of the name in expression position. `vTypeNode` below picks the
// type kid out of the constructs that have one at a fixed index.
//
// Composite recursion is an explicit whitelist rather than "all kids" because
// not every kid of a type-ish node is a type — `ArrayType` holds its length
// EXPRESSION at kid 0, and a `FuncType`'s parameter nodes carry a name ident.
// Descending into either would reintroduce exactly the bare-ident hazard above,
// so both are handled narrowly (ArrayType: element only) or left alone.
fn vTypeRef(c: Checker, node: int, depth: int) {
  if (node == 0 || depth > 64) { return }
  let n = getNode(c.tree, node)
  let tag = n.tag
  if (tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    let want = vGenericArity(c, name)
    if (want > 0) {
      reportNoHint(c.diags, ecGenericArityMismatch, vSpan(c, node),
        "'${name}' needs ${want} type argument(s); write '${name}<...>'")
    }
    return
  }
  if (tag == Tag.GenericInst) {
    let k = kidsOf(c.tree, node) // [name_ident, type_args]
    if (len(k) < 2) { return }
    let name = typeNodeName(c, node)
    let want = vGenericArity(c, name)
    let args = kidsOf(c.tree, k[1])
    if (want > 0 && want != len(args)) {
      reportNoHint(c.diags, ecGenericArityMismatch, vSpan(c, node),
        "'${name}' expects ${want} type argument(s), found ${len(args)}")
    }
    for a of args {
      vTypeRef(c, a, depth + 1)
    }
    return
  }
  if (tag == Tag.ArrayType) {
    let k = kidsOf(c.tree, node) // [length_expr, elem]
    if (len(k) >= 2) { vTypeRef(c, k[1], depth + 1) }
    return
  }
  if (tag == Tag.SliceType || tag == Tag.PtrType || tag == Tag.ChanType ||
      tag == Tag.MapType || tag == Tag.TupleType || tag == Tag.Fallible) {
    for k of kidsOf(c.tree, node) {
      vTypeRef(c, k, depth + 1)
    }
  }
}

// The type kid of a construct that declares one, or 0. These are the only
// positions `vTypeRef` may be entered from — see its comment. `Binding` covers
// `let x: T`, `Param`/`ParamRest` a signature, `Field` a class member.
fn vDeclaredTypeKid(c: Checker, node: int): int {
  let tag = getNode(c.tree, node).tag
  let k = kidsOf(c.tree, node)
  if (tag == Tag.Param || tag == Tag.ParamRest || tag == Tag.Field) {
    if (len(k) >= 2) { return k[1] }
    return 0
  }
  if (tag == Tag.Binding) {
    if (len(k) >= 3) { return k[1] } // [name, ty_or_none, init_or_none]
    return 0
  }
  return 0
}

// `vTypeNode` over a whole subtree, post-order. Used for the two regions the
// statement walk does not reach: a function SIGNATURE (params/result, which the
// seed checks before the body) and an arrow-fn subtree (vStmt refuses to descend
// one, §validatestmt). Everywhere else the statement walk visits the type node
// itself, so driving it from here would hoist these ahead of the statement
// diagnostics they interleave with (#1521).
fn vTypeNodes(c: Checker, node: int, depth: int) {
  if (node == 0 || depth > 128) { return }
  for k of kidsOf(c.tree, node) {
    vTypeNodes(c, k, depth + 1)
  }
  vTypeNode(c, node)
}

// The attr list of a FuncDecl, or 0 when the decl carries none. The 7th child is
// elided when absent, so both kid widths are well-formed (parser.bit).
fn vAttrList(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (len(kids) <= 6) { return 0 }
  return kids[6]
}

// §11.9: a name C can actually refer to — a letter or '_', then letters, digits
// or '_'. Deliberately narrower than what ELF/Mach-O permit: a name outside this
// set assembles fine but cannot be spelled from C, which defeats the point of a
// pin, and '$' in particular is how this compiler's own mangling is written.
// Strict ASCII, so this cannot reuse the lexer's `isIdentStart` (which admits
// every byte >= 0x80 to keep non-ASCII identifiers lexing).
fn vIsValidSymbolName(s: string): bool {
  if (len(s) == 0) { return false }
  let f = s[0]
  if (!((f >= 'a' && f <= 'z') || (f >= 'A' && f <= 'Z') || f == '_')) { return false }
  let i = 1
  while (i < len(s)) {
    let ch = s[i]
    if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
          (ch >= '0' && ch <= '9') || ch == '_')) {
      return false
    }
    i = i + 1
  }
  return true
}

// Resolves the attr list, reporting E0076 (§10.3.1) for any name other than
// @naked/@nosplit/@symbol and E0079 (§11.9) for a malformed argument, and
// returns the pinned symbol name ("" when the decl pins none). Mirrors the
// seed's collectAttrs, which likewise reports as it resolves and yields the pin
// only once the argument has passed both rules — so a malformed pin never also
// draws the signature diagnostics below.
fn vAttrNames(c: Checker, node: int): string {
  let list = vAttrList(c, node)
  if (list == 0) { return "" }
  let pin = ""
  let attrs = kidsOf(c.tree, list)
  let i = 0
  while (i < len(attrs)) {
    let ak = kidsOf(c.tree, attrs[i]) // [name_ident, arg_string_lit?]
    let nameNode = ak[0]
    let name = vIdentText(c, nameNode)
    // The argument child is ELIDED when absent, so an attr-with-no-argument
    // keeps the exact 1-kid shape it had before arguments existed (parser.bit).
    let arg = 0
    if (len(ak) > 1) { arg = ak[1] }
    if (name == "symbol") {
      if (arg == 0) {
        report(c.diags, ecSymbolAttrInvalid, vSpan(c, nameNode),
          "attribute '@symbol' requires a string argument",
          "write @symbol(\"the_exported_name\")")
      } else {
        // The raw literal minus its quotes. A symbol name has no use for
        // escapes, and every escape introduces a '\', which vIsValidSymbolName
        // rejects — so no unescaping is needed.
        let raw = vIdentText(c, arg)
        let text = raw[1:len(raw) - 1]
        if (!vIsValidSymbolName(text)) {
          report(c.diags, ecSymbolAttrInvalid, vSpan(c, arg),
            "'${text}' is not a valid symbol name",
            "a symbol name must be a C identifier: a letter or '_' followed by letters, digits or '_'")
        } else {
          pin = text
        }
      }
    } else {
      if (arg != 0) {
        reportNoHint(c.diags, ecSymbolAttrInvalid, vSpan(c, arg),
          "attribute '@${name}' does not take an argument")
      }
      if (name != "naked" && name != "nosplit") {
        report(c.diags, ecUnknownAttribute, vSpan(c, nameNode),
          "unknown attribute '@${name}'",
          "the recognized attributes are @naked, @nosplit and @symbol")
      }
    }
    i = i + 1
  }
  return pin
}

// E0079/E0080 (§11.9): validates a `@symbol("name")` pin and claims the name
// project-wide. A pinned function DEFINES the C symbol `name`, so its signature
// has to be one the C ABI can actually carry — the same `vIsCAbiType` §11.7
// applies in the consuming direction, since both use the one shared C-ABI
// marshaller and neither marshals anything else.
//
// The `cannot be variadic` rule became reachable when parseParam learned
// `...name: T` (#1418), for the same reason it did in vExternFnDecl.
fn vPinnedSymbol(c: Checker, node: int, sym: string) {
  let k = kidsOf(c.tree, node) // [recv, name, generics, params, result, body, attrs]
  let name = vIdentText(c, k[1])
  // A generic function has no single body to give a single symbol: it is emitted
  // once per instantiation, each needing a distinct name.
  if (k[2] != 0) {
    report(c.diags, ecSymbolAttrInvalid, vSpan(c, k[1]),
      "generic function '${name}' cannot pin a symbol name",
      "each instantiation would need its own symbol")
    return
  }
  let params = kidsOf(c.tree, k[3])
  let i = 0
  while (i < len(params)) {
    let pk = kidsOf(c.tree, params[i]) // [name, type]
    let pt = typeFromNode(c, pk[1])
    // A pinned symbol is called across the C ABI, which cannot carry a Bit
    // variadic. Reported at the whole param node, and it replaces the C-ABI
    // check for that parameter — the seed's else-if.
    if (getNode(c.tree, params[i]).tag == Tag.ParamRest) {
      reportNoHint(c.diags, ecSymbolAttrInvalid, vSpan(c, params[i]),
        "function '${name}' pinning a symbol cannot be variadic")
    } else if (pt != 0 && !vIsCAbiType(c, pt)) {
      // An unresolved type (0) is bit2's inference gap, not the program's —
      // reporting it would be a false positive on code the seed accepts.
      report(c.diags, ecSymbolAttrInvalid, vSpan(c, pk[1]),
        "parameter of '${name}' must be a scalar or a raw pointer to pin a symbol",
        "the C ABI has no representation for a GC-managed Bit value")
    }
    i = i + 1
  }
  // The RAW result node is what is checked, so a fallible `T!E` fails this too —
  // it returns through the thread-local error slot, not the C return register,
  // and is neither a prim nor a ptr.
  if (k[4] != 0) {
    let rt = typeFromNode(c, k[4])
    if (rt != 0 && !vIsCAbiType(c, rt)) {
      reportNoHint(c.diags, ecSymbolAttrInvalid, vSpan(c, k[4]),
        "'${name}' must return void, a scalar, or a raw pointer to pin a symbol")
    }
  }
  // Claim the name. The identity packs the declaring module with the decl node:
  // node indices only mean something inside their own tree, so the module id is
  // what keeps two modules' node 7 apart. Re-registering the same decl is a
  // no-op, which is what makes a repeated `checkModule` over one tree safe.
  let owner = c.moduleId * 4294967296 + node
  let (prev, seen) = c.ctx.pinnedSymbols[sym]
  if (seen && prev != owner) {
    report(c.diags, ecDuplicateSymbol, vSpan(c, k[6]),
      "symbol '${sym}' is already pinned by another declaration",
      "each pinned symbol name must be defined exactly once")
    return
  }
  c.ctx.pinnedSymbols[sym] = owner
}

// E0074 (§10.3.1) @naked: a restricted signature (no generics or parameters,
// void or scalar result) and a return-only body — there is no prologue, so a
// local, a spill, or control flow has nowhere to live.
fn vNakedFn(c: Checker, node: int, result: int) {
  let k = kidsOf(c.tree, node)
  let name = vIdentText(c, k[1])
  if (k[2] != 0) {
    reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, k[1]),
      "naked function '${name}' cannot be generic")
  }
  if (len(kidsOf(c.tree, k[3])) != 0) {
    reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, k[1]),
      "naked function '${name}' cannot take parameters")
  }
  // An unresolved result (0) is skipped: an inference gap is bit2's, not the
  // program's, and reporting it would be a false positive on code the seed takes.
  if (result != c.ctx.voidId && result != 0 && !vIsScalarValue(c, result)) {
    reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, k[1]),
      "naked function '${name}' must return void or a scalar value")
  }
  let body = kidsOf(c.tree, k[5])
  let i = 0
  while (i < len(body)) {
    if (getNode(c.tree, body[i]).tag != Tag.ReturnStmt) {
      reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, body[i]),
        "a naked function body may contain only 'return' statements")
    }
    i = i + 1
  }
}

// Matches the seed's nosplit_max_depth: a malformed or over-deep tree stops here
// rather than recursing without bound (Power of 10).
const vNosplitMaxDepth = 256

// Whether `callee` is `len`/`cap` AND `node`'s first argument's type is a
// fixed-size array (`TypeKind.Array`) — the one operand shape `lowerLen`
// (lowerprim.bit) folds to a compile-time `Op.ConstInt` with no argument
// evaluation at all. Re-derives the argument's type with `checkArgType`, the
// same helper the checker itself uses to type a `len`/`cap` call, so this
// tracks the checker's own notion of the argument's type rather than a second
// one. A slice, string or map argument returns `TypeKind.Slice`/`Map` here and
// stays refused by the caller's allowlist.
fn vNosplitLenCapOk(c: Checker, callee: string, node: int): bool {
  if (callee != "len" && callee != "cap") { return false }
  let at = checkArgType(c, node, 0)
  return at != 0 && c.ctx.types[at].kind == TypeKind.Array
}

// The one-hop callee rule. A nosplit body may call only a named function that is
// itself @nosplit — Power of 10: indirection limited to what is statically known.
// A non-ident callee is a slice/map/type constructor (which allocates) or a
// value/interface/method call (unknowable statically).
fn vNosplitCall(c: Checker, node: int, caller: string, depth: int) {
  let ck = kidsOf(c.tree, node) // [callee, type_args, args]
  if (getNode(c.tree, ck[0]).tag != Tag.Ident) {
    report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
      "nosplit function '${caller}' may not allocate or call indirectly here",
      "nosplit bodies allow only calls to other nosplit functions")
    return
  }
  let callee = vIdentText(c, ck[0])
  let fr = funcRefAt(c, ck[0], callee)
  let decl = fr.decl
  let ok = false
  if (decl != 0 && isExternDecl(fr.owner.tree, decl)) {
    // SPEC 11.7: a call to an `extern function` is admitted on the author's
    // ASSERTION, on exactly the footing `asm` is — and for the same reason. The
    // callee's body lives in another image, so it is opaque to every compiler
    // pass and no proof about it is possible; `extern function` is itself an
    // unmanaged-subset marker (§11.7 exists solely for the runtime's libSystem
    // path), so a second marker would gate nothing. What the compiler emits IS
    // proved: a plain C-ABI call, no GcAlloc, and no safepoint poll. The
    // boundary is narrow by construction — E0077 admits only scalars and raw
    // pointers across it, so no GC-managed value, closure or interface can
    // reach the callee. And unlike `asm`, this site is strictly safer than the
    // assertion it rests on: a Call is a safepoint SITE on both backends
    // whether or not the function is `@nosplit` (only the back-edge poll is
    // suppressed), so the frame keeps a stack map at the return address even if
    // the callee were to re-enter Bit through an address the author handed it.
    ok = true
  } else if (decl != 0) {
    // A decl node index only means something inside its own tree, so the attr
    // scan must read the OWNER's source — `FuncRef` carries the two together so
    // they cannot disagree. Reading `c` for an imported callee would slice the
    // wrong file. A user function shadowing a builtin lands here and is judged
    // on its own attribute, exactly as it is everywhere else.
    ok = funcHasAttr(fr.owner, decl, "nosplit")
  } else {
    // No declaration resolves, so this is a predeclared builtin. Of that set
    // only the atomics (§11.5) are safe here: they lower to inline machine
    // instructions rather than a call, so they can neither allocate nor reach a
    // safepoint. Every other builtin may do both and stays rejected. Without
    // this carve-out the unmanaged subset contradicts itself — a lock is
    // precisely the machinery `@nosplit` exists to protect, yet could not be
    // written with `@nosplit`.
    //
    // `entryOf` (§11.10) joins them on the same footing and on the same PROOF:
    // it lowers to one inline address materialization (FuncAddr) against a
    // link-time constant, so it can neither allocate nor reach a safepoint. The
    // scheduler's `initialContext` is nosplit-by-nature and needs exactly this
    // address to build a task's saved register state.
    //
    // `ptrOf` (§11.5) qualifies on the same proof, and the proof covers BOTH of
    // its forms — neither emits a call: on module state (§11.11) it is
    // `global_addr` plus a retype, a link-time constant address of exactly the
    // shape `entryOf` is admitted for; on a slice it is two field reads and an
    // add, both already on this allowlist in their own right. The atomics are
    // unusable inside `@nosplit` without it — they take a `*T` and `ptrOf` is
    // the only bridge to one. Widening stops at the address: the ARGUMENT is
    // still walked below, so `ptrOf` over an allocating expression stays E0075.
    //
    // `fsqrt`/`floatBits`/`float32Bits` join on the same proof, and the proof
    // is the reason rather than the convenience: each lowers to a single inline
    // machine instruction (Op.FSqrt / Op.Bitcast, never an RtCall), so like the
    // atomics it can neither allocate nor reach a safepoint. Refusing them
    // would repeat the contradiction this carve-out exists to avoid — the
    // runtime's own float helpers are nosplit-by-nature, and these primitives
    // are exactly what implements them. `ffloor`/`fceil`/`ftrunc`/`fround`
    // join on the same proof: on x86-64 they expand to a short SSE2 sequence
    // rather than one `roundsd` (SSE4.1), but an expansion still neither
    // allocates nor reaches a safepoint, which is the only property this
    // carve-out rests on.
    //
    // `stackMapsBegin`/`stackMapsEnd` (§11.12) join on the IDENTICAL proof to
    // `entryOf`: one inline address materialization (Op.StackMapsAddr) against a
    // link-time constant, no load and no call. Same contradiction to avoid, too
    // — the only caller that can exist is the collector's root walk, and a
    // safepoint poll is nosplit by construction, so refusing them here would
    // carve out an operation reachable from nowhere.
    //
    // `debugLinesBegin`/`debugLinesEnd` (#3285) join on the SAME proof as
    // `stackMapsBegin`/`stackMapsEnd` immediately above — same op, same
    // "one relocation, no load, no call" shape, just against the debug-info
    // table's extent symbols instead. The only caller that can exist is
    // `bit_rt_panic`'s own symbolizer, itself `@nosplit` by construction.
    //
    // `syscall` (§11.8) joins on PROOF, and on the strongest one on this list:
    // it is not a call at all. Both backends emit the kernel trap INLINE
    // (`syscall` / `svc #0`) — the Syscall IR op reaches neither the call
    // emitter nor the safepoint recorders, so no `bit_rt_*` symbol is
    // referenced, no stack map entry is taken, and nothing can allocate. The
    // kernel has no way back into Bit code: a syscall returns to the
    // instruction after the trap, and Bit expresses no signal handler. Refusing
    // it would repeat the contradiction this carve-out exists to avoid — on
    // Linux a raw syscall is the ONLY way to reach the kernel (the output is
    // static, with no libc), so the allocator and the collector, `@nosplit` in
    // their entirety, could never obtain a page.
    //
    // A builtin TYPE name in callee position is a conversion (§12.9), not a
    // call, and a NUMERIC prim conversion — including `int(p)`, a raw pointer's
    // address (§11.4) — is pure register work that allocates nothing and
    // reaches no safepoint. `string(x)` allocates and stays rejected.
    //
    // `len`/`cap` join on the STRONGEST proof on this list, one step past the
    // fixed-array `Tag.Index` carve-out just above: `lowerLen` (lowerprim.bit)
    // folds either builtin over a FIXED ARRAY to one Op.ConstInt holding the
    // array's declared length, and the argument expression is never even
    // evaluated on that path — no field read, no call, no allocation, no
    // safepoint. This is a type-conditional relaxation of the OPERAND, not a
    // blanket admission of the name: `vNosplitLenCapOk` re-derives the argument's
    // type with the same `checkArgType` the checker itself uses for `len`/`cap`,
    // so a slice (`SliceLen`/`field_get`), a string (`SliceLen`) or a map
    // (`rt_call map_len`) all still fall through to the catch-all below.
    ok = vAtomicArity(callee) >= 0 || callee == "entryOf" || callee == "ptrOf" ||
      callee == "stackMapsBegin" || callee == "stackMapsEnd" ||
      callee == "debugLinesBegin" || callee == "debugLinesEnd" ||
      callee == "fsqrt" || callee == "floatBits" || callee == "float32Bits" ||
      callee == "bitsToFloat" ||
      callee == "ffloor" || callee == "fceil" || callee == "ftrunc" ||
      callee == "fround" ||
      callee == "syscall" ||
      vNosplitLenCapOk(c, callee, node) ||
      vIsNumericPrimName(callee)
  }
  if (!ok) {
    report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
      "nosplit function '${caller}' calls '${callee}', which is not marked nosplit",
      "mark the callee @nosplit or inline it")
    return
  }
  vNosplitWalk(c, ck[2], caller, depth + 1) // args
}

// E0075 (§10.3.1) @nosplit: a default-deny allowlist over the body. Every
// construct that could allocate or reach a safepoint (composite/slice/map
// literals, slice/map indexing, `append`, `spawn`, closures, string
// interpolation, and channel ops) falls through to the catch-all and is
// rejected; a FIXED-ARRAY index is the one read admitted (a static `index_get`,
// #1231). An `asm` block is
// admitted on the author's assertion (§10.3.1), as is a call to an `extern
// function` (§11.7); the operands/arguments of both are still walked. A raw
// `syscall` (§11.8) is admitted on proof — an inline kernel trap, not a call.
fn vNosplitWalk(c: Checker, node: int, caller: string, depth: int) {
  if (node == 0) { return }
  if (depth >= vNosplitMaxDepth) { return }
  let t = getNode(c.tree, node).tag
  // Safe leaves: a name or a literal reads a register or a static const.
  if (t == Tag.Ident || t == Tag.IntLit || t == Tag.FloatLit || t == Tag.StringLit ||
      t == Tag.RawStringLit || t == Tag.RuneLit || t == Tag.BoolLit ||
      t == Tag.NilLit || t == Tag.BreakStmt || t == Tag.ContinueStmt) {
    return
  }
  // Pure operators, control flow, and statement wrappers: recurse into their
  // value children (the guarded set only).
  if (t == Tag.Binary || t == Tag.Unary || t == Tag.ExprStmt || t == Tag.ReturnStmt ||
      t == Tag.Assign || t == Tag.LhsList || t == Tag.ExprList || t == Tag.Args ||
      t == Tag.Arg || t == Tag.Block || t == Tag.IfStmt || t == Tag.WhileStmt ||
      t == Tag.ForC || t == Tag.LetDecl || t == Tag.ConstDecl) {
    let kids = kidsOf(c.tree, node)
    let i = 0
    while (i < len(kids)) {
      vNosplitWalk(c, kids[i], caller, depth + 1)
      i = i + 1
    }
    return
  }
  if (t == Tag.Binding) {
    // [pattern, type_or_none, init_or_none]: only the initializer is an
    // evaluated expression; the type annotation is not code.
    let bk = kidsOf(c.tree, node)
    if (len(bk) >= 3) { vNosplitWalk(c, bk[2], caller, depth + 1) }
    return
  }
  if (t == Tag.Member) {
    // Field access on a value already in hand is safe; recurse only the base.
    vNosplitWalk(c, kidsOf(c.tree, node)[0], caller, depth + 1)
    return
  }
  if (t == Tag.Call) {
    vNosplitCall(c, node, caller, depth)
    return
  }
  if (t == Tag.Index) {
    // §11.11: indexing a FIXED ARRAY lowers to `index_get` — a scaled
    // register-offset load against a static base (a `.rodata` const table,
    // #1231), with no bounds-check branch, no call, no allocation and no
    // safepoint. Admitted on that proof, like `ptrOf` on module state. A MAP
    // base is an `rt_call` outright and falls through to the catch-all.
    // This is the read side of the const rodata table #1231 made addressable —
    // what lets a `@nosplit` transcendental hold its constant table.
    //
    // A SLICE base ALSO falls through, and since #3107 the reason is narrower
    // than "it is a call". `xs[i]` no longer lowers to `rt_call slice_get`; it
    // lowers inline (compiler/loweraccess.bit's `emitInlineSliceGet`) and the
    // whole in-bounds path is loads and arithmetic. What still disqualifies it
    // is the COLD edge: the out-of-range branch calls `bit_rt_panic` with a
    // materialized message, and `vNosplitWalk` judges a construct by every edge
    // it can take, not by its likely one. Admitting a slice index here would
    // need that panic reached without a call — a §12.1-style argument-free
    // runtime entry point — so this stays a refusal until one exists.
    let ik = kidsOf(c.tree, node) // [recv, index_expr]
    let recvTy = declRefType(c, ik[0])
    if (recvTy == 0 || c.ctx.types[recvTy].kind != TypeKind.Array) {
      report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
        "nosplit function '${caller}' may not allocate or reach a safepoint here",
        "nosplit bodies allow only non-allocating arithmetic, control flow, and calls to other nosplit functions")
      return
    }
    // Base and index stay ordinary expressions: an allocating index stays E0075.
    vNosplitWalk(c, ik[0], caller, depth + 1)
    vNosplitWalk(c, ik[1], caller, depth + 1)
    return
  }
  if (t == Tag.AsmStmt) {
    // §10.3.1: an `asm` payload is pre-encoded machine code, opaque to every
    // compiler pass. It is admitted on the author's assertion, not on proof —
    // `asm` is already the unmanaged-subset marker (§11.6), so no second marker
    // is required. The operand expressions are ordinary Bit code the compiler
    // *can* inspect, so they stay subject to the allowlist: only the opaque
    // part is taken on trust.
    let ak = kidsOf(c.tree, node) // [x64, arm64, result?, clob_x64, clob_arm64, input...]
    let i = 5
    while (i < len(ak)) {
      vNosplitWalk(c, kidsOf(c.tree, ak[i])[2], caller, depth + 1)
      i = i + 1
    }
    return
  }
  report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
    "nosplit function '${caller}' may not allocate or reach a safepoint here",
    "nosplit bodies allow only non-allocating arithmetic, control flow, and calls to other nosplit functions")
}
