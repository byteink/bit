// compiler/optcse.bit — REDUNDANT-LOAD ELIMINATION (#4035) and COMMON-
// SUBEXPRESSION ELIMINATION (#4036). Sibling of optstore.bit in the same
// module, split out for the same reason: opt.bit is at its size limit.
//
// optstore.bit forwards a STORE to a later load of the same slot. This file is
// the other two halves of the same idea — forwarding a LOAD to a later
// identical load, and a pure computation to a later identical computation —
// and it shares that file's discipline: every rule refuses rather than reasons
// when it cannot prove the answer.
//
// ## Why this is not strictly block-local, and why block-local would be worth
// ## nothing here
//
// #4035 described the transform as block-local. Read against the IR, that is
// wrong, and it is worth stating because "block-local" is the safe-sounding
// answer. Every inline slice access (loweraccess.bit's `emitInlineSliceElem`)
// ENDS ITS BLOCK: the bounds test emits `br` to an out-of-line panic block and
// a fresh `ok` block, and the header words are read in that `ok` block. So the
// three accesses of matrix's `c[i*n+j] = c[i*n+j] + aik*b[k*n+j]` sit in four
// different blocks (bb20/bb22/bb24/bb26 on 6f6a730e), and a pass that cannot
// see past one block removes none of the 42 instructions the ticket measured.
//
// What those blocks are is a CHAIN: each has exactly one predecessor. A block
// with exactly one predecessor is dominated by it, so every value live at that
// predecessor's exit is available at its entry — no dataflow, no meet, no
// dominator tree. That single rule is the whole extension, and it is applied
// only forwards (`p < bi` and earlier in emission order), so the table never
// crosses a back edge and therefore never crosses the safepoint a back edge
// carries.
//
// ## What invalidates an entry
//
// LOADS: any instruction that can write memory, call, allocate or trap-and-
// return clears the whole table. That list is `isSideEffecting` (opt.bit)
// minus `index_get`, which is a pure load whose only effect is a panic, and a
// panic does not return. Deriving the barrier set from `isSideEffecting`
// rather than listing it is deliberate and is optstore.bit's rule 3: an op
// added later that writes memory must join `isSideEffecting` or DCE would
// already be deleting it, so it becomes a barrier here the day it lands.
//
// The table holds MANY bases at once (matrix caches `b` and `c` together), so
// unlike optstore.bit's store table it cannot answer "do these two SSA values
// alias" — and it never has to, because it never keeps an entry across
// anything that could store. That is why a store clears everything rather than
// clearing one offset.
//
// PURE OPS (#4036): nothing invalidates them, and they get their own chain for
// exactly that reason. A pure op over the same SSA operand ids is the same
// value by definition; SSA values are immutable, so a call between the two
// computations cannot change either operand, and a barrier that must drop
// every cached load must NOT drop these. Only the availability chain breaking
// (a block with two predecessors) ends their reach.
//
// `opIsBinary && !isSideEffecting` is the whole membership test — arithmetic,
// bitwise, shifts, float arithmetic and every compare, with `sdiv`/`udiv`/
// `srem`/`urem` excluded because they trap and `isSideEffecting` already says
// so. Under `--debug` an `add`/`sub`/`mul` traps on signed overflow; that is
// still sound here, because the FIRST of two identical computations traps and
// a trap does not return.
//
// Operands are resolved through `fwd` before they are keyed, so the two halves
// compose: matrix's store index `add %off, %idx` matches the load's only after
// `%off` has been forwarded to the earlier `field_get` and `%idx` to the
// earlier `add`. Neither half finds it alone.
//
// ## What this does NOT do
//
// No code motion of any kind — no LICM, no hoisting, no sinking. Every value
// this pass reuses was already computed at that point on every path.
// loweraccess.bit:316 stakes the GC's correctness on `buf`'s live range
// containing no safepoint; a reuse extends that range forwards, and the
// barrier rule above is what keeps a call or an allocation out of it.

// Available expressions as a PERSISTENT LIST in one arena: `next[e]` is the
// entry visible before `e`, so a block inherits its predecessor's set by
// copying ONE integer (the head) and adding to it without disturbing a sibling
// block that inherited the same head. Clearing is `head = -1`. Nothing is ever
// copied and nothing is ever removed, which is what makes the chain shared.
//
// `a` is the first operand (a resolved value id), `b` the second operand for a
// binary op or the byte offset for a `field_get`, `ty` the result type — width
// is taken from the result type at codegen, so two loads of one slot at
// different widths must not answer each other.
class AvailArena {
  op: []int,
  a: []int,
  b: []int,
  ty: []int,
  val: []int,
  next: []int,
}

fn newAvailArena(): AvailArena {
  return AvailArena{
    op: []int(0), a: []int(0), b: []int(0), ty: []int(0),
    val: []int(0), next: []int(0),
  }
}

// What makes two instructions the same computation. A class rather than four
// arguments because `max-params` is 5 (spec/LINT.md:184) and its stated reason
// is exactly this one: past five, the arguments want to be a class.
class AvailKey {
  op: int,
  a: int,
  b: int,
  ty: int,
}

// Records `val` under `k` and returns the new head. Bounded: at most one entry
// per instruction examined.
fn availPush(ar: AvailArena, head: int, k: AvailKey, val: int): int {
  ar.op = append(ar.op, k.op)
  ar.a = append(ar.a, k.a)
  ar.b = append(ar.b, k.b)
  ar.ty = append(ar.ty, k.ty)
  ar.val = append(ar.val, val)
  ar.next = append(ar.next, head)
  return len(ar.op) - 1
}

// The value id already holding `k` at `head`, or -1. Walks the chain, which is
// bounded by the number of entries pushed so far and strictly descending, so it
// terminates.
fn availFind(ar: AvailArena, head: int, k: AvailKey): int {
  let e = head
  while (e >= 0) {
    if (ar.op[e] == k.op && ar.a[e] == k.a && ar.b[e] == k.b && ar.ty[e] == k.ty) {
      return ar.val[e]
    }
    e = ar.next[e]
  }
  return -1
}

// The value `id` has already been forwarded to, following the chain to its
// representative so two uses that differ only by an eliminated intermediate
// key the same. Bounded by the instruction count: `fwd` only ever points at a
// strictly lower index.
fn cseResolve(fwd: []int, id: int): int {
  let cur = id
  let steps = 0
  while (steps < len(fwd) && fwd[cur] >= 0) {
    cur = fwd[cur]
    steps = steps + 1
  }
  return cur
}

// The ops that clear the load table: `isSideEffecting` minus the two members
// this pass accounts for exactly.
//
// `index_get` is a pure load whose only effect is a bounds panic, and a panic
// does not return.
//
// A TERMINATOR writes no memory — it transfers control. It is in
// `isSideEffecting` so DCE cannot delete it, which is a different question.
// The one memory-relevant thing any terminator does is the BACK-EDGE SAFEPOINT
// POLL (arm64call.bit's `emitBackEdgeSafepointIfNeeded`, `target <= curBlock`),
// and `cseInheritHead` refuses every edge that could be one, so no entry ever
// survives a poll. Leaving terminators in the set is not conservative, it is
// vacuous: a block's own `br` would clear the set at the block's exit, which is
// the only moment a successor reads it, so the pass would fire block-locally
// and never once across the chain it exists for.
fn opClobbersLoads(op: Op): bool {
  return isSideEffecting(op) && op != Op.IndexGet && !opIsTerminator(op)
}

// The loads this pass forwards. Both read one word of a slice/class header
// through the null-safe path; neither can trap and neither writes anything.
fn opIsCseLoad(op: Op): bool {
  return op == Op.SliceLen || op == Op.FieldGet
}

// The computations this pass reuses without any barrier at all: every binary
// op `isSideEffecting` does not name. See the header for why a call between
// two of them changes nothing.
fn opIsCsePure(op: Op): bool {
  return opIsBinary(op) && !isSideEffecting(op)
}

// The two chains a block carries. One object per function, rewritten at each
// block boundary, so the walk allocates nothing per instruction.
class CseHeads {
  load: int,
  pure: int,
}

// What identifies instruction `idx` as a computation. `b` is the byte offset
// for a load and the second operand for a binary op; both operands are
// resolved through `fwd` so an eliminated intermediate does not hide a match.
// `ty` is in the key because codegen takes a load's width from its result type
// (arm64compile.bit:232), so two reads of one slot at different widths must
// not answer each other.
fn cseKeyOf(f: IrFunc, fwd: []int, idx: int): AvailKey {
  let ins = f.instrs[idx]
  let b = ins.ival
  if (!opIsCseLoad(ins.op)) {
    b = cseResolve(fwd, ins.rhs)
  }
  return AvailKey{ op: int(ins.op), a: cseResolve(fwd, ins.lhs), b: b, ty: ins.ty }
}

// `idx` against one chain: forward it to an earlier equal computation, or
// record it as the one that answers the next. Returns that chain's new head.
fn cseTry(f: IrFunc, ar: AvailArena, fwd: []int, head: int, idx: int): int {
  let k = cseKeyOf(f, fwd, idx)
  let hit = availFind(ar, head, k)
  if (hit >= 0) {
    fwd[idx] = hit
    return head
  }
  return availPush(ar, head, k, idx)
}

// One instruction against both chains. A `field_get` optstore.bit already
// answered from a store is left alone: its value is the stored one, which is a
// strictly better answer than any load.
fn cseStep(f: IrFunc, ar: AvailArena, fwd: []int, h: CseHeads, idx: int) {
  let ins = f.instrs[idx]
  if (opClobbersLoads(ins.op)) {
    h.load = -1
  }
  if (fwd[idx] >= 0) {
    return
  }
  if (opIsCseLoad(ins.op)) {
    h.load = cseTry(f, ar, fwd, h.load, idx)
  } else if (opIsCsePure(ins.op)) {
    h.pure = cseTry(f, ar, fwd, h.pure, idx)
  }
}

// One block front to back. Block params are skipped: they define values but
// compute nothing, and `rebuild` emits them ahead of this range.
fn cseBlock(f: IrFunc, ar: AvailArena, fwd: []int, h: CseHeads, bi: int) {
  let blk = f.blocks[bi]
  let idx = blk.instsStart + blk.paramCount
  let end = blk.instsStart + blk.instsLen
  while (idx < end) {
    cseStep(f, ar, fwd, h, idx)
    idx = idx + 1
  }
}

// `pred[b]` is b's only predecessor, or -1 when it has none or more than one.
// An unreachable predecessor still counts, which only ever refuses an
// opportunity. A block with no terminator (DCE can empty a block it keeps)
// branches nowhere — reading `instsStart + instsLen - 1` there names the
// instruction BEFORE the block, which is how #2084 segfaulted.
fn singlePredecessors(f: IrFunc): []int {
  let pred = []int(0)
  let i = 0
  while (i < len(f.blocks)) {
    pred = append(pred, -1)
    i = i + 1
  }
  i = 0
  while (i < len(f.blocks)) {
    let blk = f.blocks[i]
    if (blk.instsLen != 0) {
      let term = f.instrs[blk.instsStart + blk.instsLen - 1]
      if (term.op == Op.Jump) {
        pred[term.ival] = notePred(pred[term.ival], i)
      } else if (term.op == Op.Br) {
        pred[term.ival] = notePred(pred[term.ival], i)
        pred[term.ival2] = notePred(pred[term.ival2], i)
      }
    }
    i = i + 1
  }
  return pred
}

// -2 is "more than one predecessor"; -1 "none seen yet". Both read as "do not
// inherit" at the one place that consults the array.
fn notePred(cur: int, src: int): int {
  if (cur == -1) {
    return src
  }
  return -2
}

// The head to start block `bi` from: its predecessor's exit set when that
// predecessor is its only one AND the edge runs forwards. Forwards means both
// a lower block id — `isBackEdge` is `target <= curBlock` by id, so this is
// exactly "the edge carries no safepoint poll" — and an earlier position in
// emission order, so the predecessor's exit head is already computed.
fn cseInheritHead(pred: []int, pos: []int, exitHead: []int, bi: int, at: int): int {
  let p = pred[bi]
  if (p < 0 || p >= bi || pos[p] >= at) {
    return -1
  }
  return exitHead[p]
}

// The emission-order position of each block, so `cseInheritHead` can tell
// whether a predecessor's exit set has been computed yet.
fn blockOrderPositions(f: IrFunc, order: []int): []int {
  let pos = []int(0)
  let i = 0
  while (i < len(f.blocks)) {
    pos = append(pos, 0)
    i = i + 1
  }
  i = 0
  while (i < len(order)) {
    pos[order[i]] = i
    i = i + 1
  }
  return pos
}

// `n` entries of -1: an empty chain for every block, before the walk fills in
// the real exit heads.
fn emptyHeads(n: int): []int {
  let h = []int(0)
  let i = 0
  while (i < n) {
    h = append(h, -1)
    i = i + 1
  }
  return h
}

// #4035 + #4036: fills `fwd` with every load another load already answered and
// every pure computation another pure computation already answered. Walks
// blocks in emission order so a predecessor's exit sets are always ready.
fn cseAvailableValues(f: IrFunc, fwd: []int) {
  let ar = newAvailArena()
  let pred = singlePredecessors(f)
  let order = blockEmissionOrder(f)
  let pos = blockOrderPositions(f, order)
  let exitLoad = emptyHeads(len(f.blocks))
  let exitPure = emptyHeads(len(f.blocks))
  let h = CseHeads{ load: -1, pure: -1 }
  let i = 0
  while (i < len(order)) {
    let bi = order[i]
    h.load = cseInheritHead(pred, pos, exitLoad, bi, i)
    h.pure = cseInheritHead(pred, pos, exitPure, bi, i)
    cseBlock(f, ar, fwd, h, bi)
    exitLoad[bi] = h.load
    exitPure[bi] = h.pure
    i = i + 1
  }
}
