// compiler/lowerreslice.bit — split out of loweraccess.bit (#4048) to keep both
// files under the 800-line lint limit. Two things now: reslice — `a[lo:hi]` on
// a slice (still `rt_call slice_slice`) and on a string (inline since #4048) —
// and the inline string INDEX read `s[i]` (#4346), which lives beside it
// because both read the same `{ptr, len, base}` header words through the same
// null-safe path, and a change to that layout must land in one file rather than
// two. Sibling of loweraccess.bit: same module, so this needs no imports and no
// call-site changes.

// The out-of-line bounds panic both reslice paths would share if the slice side
// were ever inlined too. Today only the string side calls it.
//
// The message text is the runtime's own, byte for byte:
// `runtime/root/slices.bit`'s `strOobWord0..3`/`strOobLen` decode to exactly
// "string bounds out of range" (26 bytes), which `panicBounds(oobStringRange)`
// hands to `bit_rt_panic`. Reaching the same `bit_rt_panic` with the same text
// gives the same stderr line and the same exit 2.
fn emitStringSliceOob(fc: FnCtx) {
  let msg = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  msg.sval = "string bounds out of range"
  msg.ival = internPoolString(fc, msg.sval)
  let pn = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  pn.name = "panic"
  pn.args = [builderEmit(fc.b, msg)]
  emitRtCall(fc, pn)
  builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
}

// `s[lo:hi]` on a string, built INLINE instead of through
// `rt_call string_slice` (#4048). Reproduces `rtStringSlice`
// (runtime/root/strings.bit:166) and the `allocStringView`/`strInitView` pair it
// calls (runtime/root/root.bit:636, :589), verbatim:
//
//   n = len(s)                         // strSize: a NULL header reads as 0
//   lo < 0 || lo > hi || hi > n  -> panic "string bounds out of range"
//   out = gc_alloc(24, ptr_offsets=[16])
//   out.ptr  = ptr(s) + lo             // strBytes: a NULL header reads as 0
//   out.len  = hi - lo
//   out.base = s                       // the IMMEDIATE source, never base(s)
//
// WHY INLINE AT ALL, and what this does NOT buy. It removes one `bl
// _bit_rt_string_slice` and one safepoint per slice, which is real but small.
// The reason it comes first in #3901's plan is different: the allocation this
// expression performs is invisible to every compiler pass while it happens
// inside a runtime call. #4007 measured `bench/cases/strings` at 1 non-escaping
// allocation out of 7,125,044 — an artefact, because 41.1% of that program's
// allocations have no `Op.GcAlloc` in anyone's IR. 7,125,001 of them are this
// expression. `s[lo:hi]` STILL ALLOCATES after this change; it allocates
// somewhere the optimizer, and any future escape analysis, can see.
//
// TWO UNSIGNED COMPARES COVER ALL THREE RUNTIME CONDITIONS, and the reduction is
// exact rather than approximate. `0 <= lo <= hi <= n` holds iff `lo <=u hi` and
// `hi <=u n`: `hi <=u n` forces `hi` into `[0, n]` (a length is non-negative and
// far below 2^63, so a negative `hi` reads as an unsigned value larger than any
// `n`), and given that, `lo <=u hi` forces `lo` into `[0, hi]`. Both directions
// hold, so nothing legal is rejected and nothing illegal accepted. It is exact
// at every integer width because this compiler keeps every value in a register
// sign/zero-extended to its true 64-bit value (arm64select.bit's `canonNarrow`)
// and both backends' `icmp` is a full 64-bit compare.
//
// A SIGN-BIT TRICK WAS TRIED AND IS UNSOUND, recorded so it is not re-proposed:
// `(lo | (hi - lo) | (n - hi)) >= 0` accepts `n = 0, hi = -(2^63-1), lo = 2`,
// where `hi - lo` wraps positive and `n - hi` does too. It would take a 2^63-byte
// length from a 5-byte string. Two compares are what this needs.
//
// BLOCK IDS ASCEND WITH EMISSION ORDER, and here that is load-bearing rather
// than tidy. `isBackEdge` (codegen.bit:588) is `target <= curBlock`, so a branch
// to an ALREADY-EMITTED block is read as a loop back edge and both backends emit
// a safepoint poll ladder there. The second bounds test branches to the same
// panic block the first one does, so the panic block must be minted AFTER it:
// `chk2`, then `oob`, then `ok`, emitted in that order. Minting `oob` first — the
// order `emitInlineSliceElem` uses, where there is only one test — would put an
// unnecessary poll on the second test's path.
//
// THE INTERIOR POINTER IS FORMED AFTER THE ALLOCATION, not before, and that is
// the GC argument. `ptr` is an address INTO the backing object and must never be
// traced (ABI.md §2.3), so nothing keeps it valid across a collection except the
// backing staying alive. Computing it after `gc_alloc` — the only safepoint in
// this sequence — means it never crosses one. `s` itself does cross it, and is
// safely rooted: its IR type is `string`, which `isRefType` (codegen.bit:79)
// reports as a GC reference, so the register allocator marks its live interval
// `isRef` and the stack map at the `gc_alloc` return address names it. Its range
// covers the call because the `field_set` of `base` reads it afterwards. That is
// the same requirement `allocStringView`'s own header states ("`src` must
// survive `gcAllocRaw`, which can collect") and the same one the copying
// implementation before #3897 already had.
//
// THAT ARGUMENT IS TRUE ONLY BECAUSE `s` IS TODAY ONE REF-TYPED SSA VALUE, and
// #4407 made it a CHECKED invariant rather than only an argued one:
// `stringViewBaseEscapesInFunc` (verify.bit) runs on the emit path for every
// function and refuses to emit if the value stored into a string view's `base`
// is not `isRefType`. It exists because #3901 explodes `string` into
// independent `ptr`/`len`/`base` words, at which point `s` here may stop being
// one ref-typed value — the exact failure this function's whole design is
// built to rule out — and nothing else in the suite would notice (#4406's own
// reasoning: the freed bytes are swept, not necessarily reused, so the symptom
// is a wrong answer, not a crash).
//
// #4422 IS THAT MOMENT, and the instruction the paragraph above left is what
// this function now follows: when the receiver arrives as words, `setBase`
// below is fed `words[2]`, the `base` word, which is the ONE ref-typed word of
// the three (`stringWordTypes`, lowerexplodestr.bit) and the traced root the
// interior `ptr` was derived from. `stringViewBaseEscapesInFunc` refuses
// anything else, so this is a checked claim rather than an argued one.
//
// THE INTERIOR POINTER THEN PREDATES THE ALLOCATION, which is the one thing
// the paragraph above says must not happen — and it is safe for a different
// reason, not by the same one. `words[0]` was formed where the receiver was
// bound and is untraced, so nothing but its backing staying alive keeps it
// valid. `words[2]` is what keeps it alive, and the edge that forces that is
// recorded rather than argued: `recordWordKeepAlive` (#4406) pairs every
// untraced word with every traced one of the same aggregate, and
// `extendKeepAlive` (codegenlive.bit) then holds the base's live interval open
// to the end of the derived word's. That is exactly the case #4406 was built
// for and #4425 owns proving with a mutant.
//
// NO WRITE BARRIER, for the reason #3108 established for the inline slice store:
// `runtime/gc/gccollect.bit` is a full stop-the-world mark-sweep, there is no
// barrier anywhere in the tree, and `strInitView`'s own `storeWord` performs
// none either. When the GC goes incremental the barrier is owed here, at both
// backends' `field_set`, and at `strInitView` together.
//
// THE DESCRIPTOR MATCHES THE RUNTIME'S. `typeInfoSymbol` emits
// `__bittype_<string>_24_16` — size 24, `ptr_offsets = [16]` — which is exactly
// what `rootInit` writes for `riString` (`writeInfo(base, riString,
// strAllocHeader, ..., 1, ...)` with `riStringOffs` holding `strBase`). Two
// descriptors with identical contents, and nothing in the collector matches
// `riString` by ADDRESS: only `riRefArray` is a by-address sentinel
// (runtime/root/root.bit's `ref_array_info` note), and a string view is never
// allocated with it.
fn emitInlineStringSlice(fc: FnCtx, sr: StringRecv, lo: int, hi: int, ty: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let boolty = primType(fc.c.ctx, 10)
  let n = strRecvLen(fc, sr)
  // Minted before either is emitted, in the order they are emitted, so every
  // branch below targets a HIGHER id than the block it leaves.
  let chk2 = builderNewBlock(fc.b)
  let oob = builderNewBlock(fc.b)
  let ok = builderNewBlock(fc.b)

  let c1 = mkInstr(Op.ICmpUle, boolty)
  c1.lhs = lo
  c1.rhs = hi
  let br1 = mkInstr(Op.Br, fc.c.ctx.voidId)
  br1.lhs = builderEmit(fc.b, c1)
  br1.ival = chk2
  br1.ival2 = oob
  builderEmit(fc.b, br1)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, chk2)
  let c2 = mkInstr(Op.ICmpUle, boolty)
  c2.lhs = hi
  c2.rhs = n
  let br2 = mkInstr(Op.Br, fc.c.ctx.voidId)
  br2.lhs = builderEmit(fc.b, c2)
  br2.ival = ok
  br2.ival2 = oob
  builderEmit(fc.b, br2)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, oob)
  emitStringSliceOob(fc)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, ok)
  let ga = mkInstr(Op.GcAlloc, ty)
  ga.ival = strViewHeaderSize()
  ga.offsets = [strViewBaseOffset()]
  let obj = builderEmit(fc.b, ga)
  let addIns = mkInstr(Op.Add, i64ty)
  addIns.lhs = strRecvPtr(fc, sr)
  addIns.rhs = lo
  let setPtr = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  setPtr.lhs = obj
  setPtr.ival = 0
  setPtr.rhs = builderEmit(fc.b, addIns)
  setPtr.ival2 = i64ty
  builderEmit(fc.b, setPtr)
  let subIns = mkInstr(Op.Sub, i64ty)
  subIns.lhs = hi
  subIns.rhs = lo
  let setLen = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  setLen.lhs = obj
  setLen.ival = 8
  setLen.rhs = builderEmit(fc.b, subIns)
  setLen.ival2 = i64ty
  builderEmit(fc.b, setLen)
  let setBase = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  setBase.lhs = obj
  setBase.ival = strViewBaseOffset()
  setBase.rhs = strRecvBase(sr)
  setBase.ival2 = primType(fc.c.ctx, 11)
  builderEmit(fc.b, setBase)
  return obj
}

// Whether `s[i]` may be read INLINE (#4346). Two conditions, both fail-closed,
// asked at the call site rather than inside the emitter for the reason
// `canInlineSliceStore` (loweraccess.bit) is a predicate: a receiver that fails
// either one keeps the runtime call, which is today's behaviour byte for byte.
//
// THE RESULT must be exactly one byte wide and int-classed. `index_get` scales
// by the RESULT type's own width, and only a 1-byte result makes that scale the
// byte stride a string's bytes actually have; SPEC §12.2 types `s[i]` `u8`, so
// this holds for every program that reaches here today, and a wider result
// would otherwise address `i * 8` bytes into the backing.
//
// THE INDEX must be int-classed, for the reason `lowerIndex`'s slice arm gives:
// the compare and the address arithmetic read an INTEGER register, and nothing
// rejects `s[1.5]` today.
fn canInlineStringByte(fc: FnCtx, ty: int, idx: int): bool {
  let w = widthOf(fc.c.ctx, ty)
  return w.bytes == 1 &&
    w.regClass == RegClass.Int &&
    regClassOf(fc.c.ctx, fc.b.instrs[idx].ty) == RegClass.Int
}

// `s[i]` on a string, read INLINE instead of through `rt_call string_byte`
// (#4346) — the index twin of `emitInlineStringSlice` above, and the same shape
// `emitInlineSliceGet` (loweraccess.bit) already has for `xs[i]`, minus the view
// offset a string header does not carry:
//
//   n = len(s)                    // slice_len at +8: a NULL header reads as 0
//   (u64)i >= (u64)n  -> panic "index out of range"
//   p = ptr(s)                    // field_get at +0: a NULL header reads as 0
//   b = loadByte(p + i)
//
// That is `rtStringByte` (runtime/root/strings.bit) verbatim. Its `strSize` and
// `strBytes` are the null-safe funnels reproduced here by `emitHeaderWordOrZero`
// on both backends (`isHeaderBase` already answers true for a string), and its
// explicit `index < 0 || index >= n` pair is the ONE unsigned compare
// `emitBoundsCheck` emits: a negative index reads as a huge unsigned and fails
// it, exactly as it does for a slice. `bit_rt_string_byte` stays exported
// (ABI.md §2), as #3107 kept `bit_rt_slice_get`.
//
// WHY INLINE AT ALL. `rtStringByte` is 50 instructions behind a `bl`, and calls
// `_strSize`, `_strBytes` and `_bit_rt_port_mem_load_byte` in turn. Every
// `src[i]` in a lexer is that call once per input byte.
//
// THE PANIC IS BYTE-IDENTICAL. `panicBounds(oobIndex)`'s words decode to "index
// out of range" (runtime/root/slices.bit), which is the text `emitBoundsCheck`
// hands to `bit_rt_panic` — the same stderr line and the same exit 2. It is the
// same equality #3107 spent when it replaced `rtSliceGet`'s panic.
//
// #4422 GIVES THIS THE SAME `StringRecv` THE RESLICE TAKES, and it is not
// symmetry for its own sake. `emitBoundsCheck` SPLITS THE BLOCK, so a box
// materialized for the receiver is written in one block and read (`field_get
// %b[0]`) in the next — and optstore.bit's store-to-load forwarding is
// deliberately block-local. Measured on `a[0]` where `a` is an exploded
// local: the box survived every pass, one allocation per read, which would
// have made `s[i]` on a sliced local a REGRESSION against the boxed form.
//
// THE ADDRESS NEVER CROSSES A SAFEPOINT, and for a string that is still the
// argument rather than a historical one. `ptr` is an INTERIOR pointer (ABI.md
// §2.3) held in an untraced `i64`, so nothing keeps it valid across a collection
// but the header — and `licmReadsHeaderWord` (optloopcand.bit) deliberately
// refuses to hoist a `field_get` at offset 0 on a STRING base, so this read
// stays inside its loop. From it to the `index_get` is one straight-line block:
// no call, no allocation, and no back edge (`isBackEdge` is `target <=
// curBlock`, and both blocks `emitBoundsCheck` mints have ids above the current
// one). Lifting that refusal would need #4053's four-part argument re-derived
// for a string, whose traced word is `base` at +16 and not `ptr`; it is not
// done here, and the cost of leaving it is one never-taken `cbz` and one `ldr`
// per iteration instead of nothing.
fn emitInlineStringByte(fc: FnCtx, sr: StringRecv, idx: int, ty: int): int {
  emitBoundsCheck(fc, idx, strRecvLen(fc, sr))
  let ig = mkInstr(Op.IndexGet, ty)
  ig.lhs = strRecvPtr(fc, sr)
  ig.rhs = idx
  return builderEmit(fc.b, ig)
}

// `strAllocHeader` (runtime/root/root.bit:218) — the byte size of a `{ptr, len,
// base}` string header, and the whole size of a view, which owns no inline
// bytes. Named rather than written as a literal at the two sites above because
// it is a runtime layout constant this file is MIRRORING, not choosing.
fn strViewHeaderSize(): int {
  return 24
}

// `strBase` (runtime/root/root.bit:217) — the offset of the one traced field of
// a string header, and so the whole of its `ptr_offsets` (ABI.md §2.3). `ptr`
// at +0 is an interior pointer and must never appear there.
fn strViewBaseOffset(): int {
  return 16
}

// A string reslice's RECEIVER, in whichever form this body already holds it.
//
// `handle` is the one boxed word every receiver has had until now. `words` is
// non-empty only when the receiver is a plain name bound to an EXPLODED string
// local (#4422) — `{ptr, len, base}`, in `stringWordTypes` order — and then
// `handle` is 0 and no box is materialized at all.
//
// This is the whole of the producer flip. Without it, `localRead` rebuilds a
// box for the receiver, `setBase` stores that box into the result's `base`
// slot, and a stored value is an escape optalloc.bit refuses — so every
// `s[lo:hi]` on an exploded local would pay an allocation the boxed form did
// not, turning the flip into a regression rather than a win.
class StringRecv {
  handle: int,
  words: []int,
}

// The receiver of `k[0]`, taking an exploded string local's words when it has
// them. Only a plain `Tag.Ident` qualifies: every other expression form has to
// be lowered to be evaluated at all, and an identifier is the one shape whose
// evaluation emits nothing, so skipping `lowerExpr` for it cannot skip a side
// effect. A captured-and-assigned name (§12.8) never reaches here as exploded
// — `declareLetLocal` excludes it — so the cell's contents cannot be stale.
fn lowerStringRecv(fc: FnCtx, node: int, isString: bool): StringRecv {
  if (isString) {
    let n = getNode(fc.c.tree, node)
    if (n.tag == Tag.Ident) {
      let slot = envIndex(fc, fc.c.source[n.span.start:n.span.end])
      if (slot != -1 && bindIsExploded(fc.env[slot]) && fc.env[slot].ty == primType(fc.c.ctx, 11)) {
        return StringRecv{ handle: 0, words: bindWordValues(fc.env[slot]) }
      }
    }
  }
  return StringRecv{ handle: lowerExpr(fc, node), words: []int(0) }
}

// `len(s)` for a receiver: the `len` word when there is one, else the same
// null-safe `slice_len` on the handle that has always been emitted here.
fn strRecvLen(fc: FnCtx, sr: StringRecv): int {
  if (len(sr.words) != 0) {
    return sr.words[1]
  }
  let ins = mkInstr(Op.SliceLen, primType(fc.c.ctx, 3))
  ins.lhs = sr.handle
  return builderEmit(fc.b, ins)
}

// `ptr(s)` for a receiver: the `ptr` word when there is one, else `field_get
// %s[0]` read null-safely (`isHeaderBase`, codegen.bit) — a zeroed class's
// string field is the null word, and `strBytes` answers 0 for it.
fn strRecvPtr(fc: FnCtx, sr: StringRecv): int {
  if (len(sr.words) != 0) {
    return sr.words[0]
  }
  let ins = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  ins.lhs = sr.handle
  ins.ival = 0
  return builderEmit(fc.b, ins)
}

// The value stored into the result's `base` slot: the receiver's own `base`
// word when exploded, else the receiver handle itself.
//
// THOSE TWO ARE NOT THE SAME OBJECT and the difference is deliberate. The
// boxed form stores the IMMEDIATE source, so a chain of views holds a chain of
// headers alive. The exploded form stores what the source itself points at,
// which roots the same bytes — `strInitOwned` sets an owning string's `base`
// to ITSELF (runtime/root/root.bit:578) and `strInitView` sets a view's to its
// source (:600), so following the word one link never leaves the chain — and
// retains one fewer header per link. A null receiver reads its `base` word as
// 0 through the same `isHeaderBase` guard the other two words use, which is
// the state `strBytes`/`strSize` already answer 0 for.
// The receiver as ONE boxed word, for a consumer that has not flipped — the
// runtime calls `string_byte`/`slice_get`/`map_get` take a handle and their
// ABI is the runtime's, not this compiler's. Materialized here rather than by
// the caller so a call site that never reaches such a consumer never builds
// one.
fn strRecvHandle(fc: FnCtx, sr: StringRecv): int {
  if (len(sr.words) == 0) {
    return sr.handle
  }
  return boxStringWords(fc.c.ctx, fc.b, sr.words[0], sr.words[1], sr.words[2])
}

fn strRecvBase(sr: StringRecv): int {
  if (len(sr.words) != 0) {
    return sr.words[2]
  }
  return sr.handle
}

// Lowers a reslice `s[lo:hi]` (SPEC §12.7): `rt_call slice_slice(s, lo, hi)` for a
// slice, inline for a string (#4048). An omitted `lo` is 0; an omitted `hi` is
// the receiver's current length. Array reslice is not lowerable (matches seed).
fn lowerSliceExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let isString = rd.kind == TypeKind.Prim && rd.prim == 11
  if (rd.kind != TypeKind.Slice && !isString) {
    fcFail(
      fc,
      getNode(fc.c.tree, node).span,
      "a reslice of a value that is not a slice or a string",
    )
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let sr = lowerStringRecv(fc, k[0], isString)
  let recv = sr.handle
  if (fc.failed) {
    return 0
  }
  let lo = 0
  if (k[1] != 0) {
    lo = lowerExprH(fc, k[1], i64ty)
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    lo = builderEmit(fc.b, z)
  }
  let hi = 0
  if (k[2] != 0) {
    hi = lowerExprH(fc, k[2], i64ty)
  } else {
    hi = strRecvLen(fc, sr)
  }
  if (fc.failed) {
    return 0
  }
  // `recv`, `lo` and `hi` are ALL lowered before the sequence below starts.
  // Evaluating either bound can allocate or call, and that is a safepoint;
  // keeping them ahead of the allocation is what leaves the derived interior
  // pointer's live range safepoint-free.
  if (isString) {
    return emitInlineStringSlice(fc, sr, lo, hi, nodeType(fc, node))
  }
  let ins = mkInstr(Op.RtCall, nodeType(fc, node))
  ins.name = "slice_slice"
  ins.args = [recv, lo, hi]
  return emitRtCall(fc, ins)
}
