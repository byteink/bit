// Class-body declarations use the same complexity boundary as free functions.
fn lintMethodFixture(header: string, member: string, branches: int): string {
  let source = header + " {\n  " + member + "() {\n"
  for (let i = 0; i < branches; i = i + 1) {
    source = source + "    if (a) {}\n"
  }
  return source + "  }\n}\n"
}

fn checkLintMethodBoundary(header: string, member: string, name: string) {
  for branches of [9, 10] {
    let source = lintMethodFixture(header, member, branches)
    let diagnostics = lintTestSink()
    let file = addFile(diagnostics.sm, "method.bit", source)
    let tree = parseSourceD(source, file, diagnostics)
    assert(!hasErrors(diagnostics))
    lintMaxComplexity(tree, file, 10, diagnostics)
    assert(len(diagnostics.list) == branches - 9)
    if (branches == 10) {
      assert(diagnostics.list[0].code == ecLintMaxComplexity)
      assert(diagnostics.list[0].message == "function complexity is 11, limit is 10 (Sample.${name})")
    }
  }
}

fn checkLintComplexityMethods() {
  checkLintMethodBoundary("class Sample", "run", "run")
  checkLintMethodBoundary("export class Sample", "export run", "run")
  checkLintMethodBoundary("class Sample", "static run", "run")
  checkLintMethodBoundary("export class Sample", "export static run", "run")
  checkLintMethodBoundary("class Sample", "init", "init")
  checkLintMethodBoundary("export class Sample", "init", "init")
  checkLintComplexityMethodArrows()
  checkLintComplexityMethodRecovery()
}

fn checkLintComplexityMethodArrows() {
  let body = ""
  for (let i = 0; i < 10; i = i + 1) {
    body = body + "if (a) {}\n"
  }
  let sources = [
    "class Sample { run() { let f = () => {\n" + body + "} } }",
    "let f = () => {\n" + body + "}",
  ]
  for (let i = 0; i < len(sources); i = i + 1) {
    let diagnostics = lintTestSink()
    let file = addFile(diagnostics.sm, "arrow.bit", sources[i])
    let tree = parseSourceD(sources[i], file, diagnostics)
    assert(!hasErrors(diagnostics))
    lintMaxComplexity(tree, file, 10, diagnostics)
    assert(len(diagnostics.list) == 1 - i)
  }
}

fn checkLintComplexityMethodRecovery() {
  for source of [
    "class Broken {",
    "class Broken { run(",
    "class { run() {} }",
    "class Broken { export }",
  ] {
    let diagnostics = lintTestSink()
    let file = addFile(diagnostics.sm, "broken.bit", source)
    let tree = parseSourceD(source, file, diagnostics)
    assert(hasErrors(diagnostics))
    lintMaxComplexity(tree, file, 10, diagnostics)
  }
}
