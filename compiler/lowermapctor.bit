// compiler/lowermapctor.bit — split out of lowerlit.bit (#4064) to keep both
// files under the 800-line lint limit; see lowerlit.bit for the rest of
// literal construction (class/slice/array/chan composites and zero values).
// Sibling of lowerlit.bit: same module, so this needs no imports and no
// call-site changes. Map construction only: the empty/hinted constructor
// `map<K,V>()` / `map<K,V>(n)` and the `map<K,V>{...}` literal.

// Allocates an empty map: `rt_call map_new(key_desc, val_is_ref, cap_hint)`.
// `mapTy` is the checker's interned map type; `capV` is an already-lowered i64
// SSA value — the caller's capacity hint (`lowerMapCtor` below) or a zero
// constant for the no-hint paths (a map literal, or `map<K,V>()`).
//
// `key_desc` is 0 for a scalar key and 1 for a `string` key — and for a class
// or tuple key it is the DESCRIPTOR PROGRAM for that type, so the map hashes and
// matches the key's CONTENTS. Passing 0 there is what made an equal key miss and
// a re-insert grow the map (#2111); it also left the key buffer untraced, so a
// composite key could be collected while the map still held it.
fn lowerMapMake(fc: FnCtx, mapTy: int, capV: int): int {
  let m = fc.c.ctx.types[mapTy]
  let i64ty = primType(fc.c.ctx, 3)
  let prog = descForType(fc, m.mapKey)
  let kflag = 0
  if (prog != "") {
    kflag = descConst(fc, prog)
  } else {
    let kf = mkInstr(Op.ConstInt, i64ty)
    if (fc.c.ctx.types[m.mapKey].kind == TypeKind.Prim && fc.c.ctx.types[m.mapKey].prim == 11) {
      kf.ival = 1
    }
    kflag = builderEmit(fc.b, kf)
  }
  let vf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, m.mapVal).isPtr) {
    vf.ival = 1
  }
  let vflag = builderEmit(fc.b, vf)
  let ins = mkInstr(Op.RtCall, mapTy)
  ins.name = "map_new"
  ins.args = [kflag, vflag, capV]
  return emitRtCall(fc, ins)
}

// A map-type callee `map<K,V>(...)`: zero arguments is `map<K,V>()`, one is a
// capacity HINT `map<K,V>(n)` (§11.2, §12.9, #4064) — advisory, forwarded to
// `lowerMapMake` and from there to the runtime, which pre-sizes from it and
// otherwise ignores it (`mapCapForHint`, runtime/root/mapcaps.bit).
// `vMapCtorArity` (validatezero.bit) has already bounded the argument count
// at one; `--dump-ir`/`--dump-ir-pre` lower unchecked input, so a missing
// argument still defaults to zero here, mirroring `lowerChanMake`'s identical
// unbuffered/buffered shape (lowerlit.bit).
fn lowerMapCtor(fc: FnCtx, node: int): int {
  let mapTy = nodeType(fc, node)
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let i64ty = primType(fc.c.ctx, 3)
  let capV = builderEmit(fc.b, mkInstr(Op.ConstInt, i64ty))
  if (len(args) >= 1) {
    let a = args[0]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    capV = lowerExprH(fc, a, i64ty)
    if (fc.failed) {
      return 0
    }
  }
  return lowerMapMake(fc, mapTy, capV)
}

// A `map<K,V>{k: v, ...}` composite: allocate, then `map_set(m, k, v)` per entry
// in order (each key/val lowered at the map's key/val type). No capacity hint —
// a literal's entry count could seed one, but that is a separate decision from
// #4064's constructor form and out of scope here.
fn lowerMapLit(fc: FnCtx, mapTy: int, entries: []int): int {
  let m = fc.c.ctx.types[mapTy]
  let zeroV = builderEmit(fc.b, mkInstr(Op.ConstInt, primType(fc.c.ctx, 3)))
  let mv = lowerMapMake(fc, mapTy, zeroV)
  let i = 0
  while (i < len(entries) && !fc.failed) {
    let ek = kidsOf(fc.c.tree, entries[i])
    let key = lowerExprH(fc, ek[0], m.mapKey)
    let val = lowerExprH(fc, ek[1], m.mapVal)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [mv, key, val]
    emitRtCall(fc, ins)
    i = i + 1
  }
  return mv
}
