// #7920: the two relation walks share lexical assignment facts. Every list
// is persistent: branches can retain their input without aliasing later writes.
fn relationAutoSymbol(c: Checker, node: int): int {
  if (node <= 0 || node >= len(c.nodeSymbols)) {
    return 0
  }
  return c.nodeSymbols[node]
}

fn relationAutoFactsKill(
  c: Checker, target: int, loaded: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  let symbol = relationAutoSymbol(c, target)
  let field = ""
  if (getNode(c.tree, target).tag == Tag.Member) {
    let k = kidsOf(c.tree, target)
    symbol = relationAutoSymbol(c, k[0])
    field = identText(c.tree, c.source, k[1])
  }
  let out = []RelationAutoErrLoaded(0)
  for l of loaded {
    if (l.symbol != symbol || (field != "" && l.fieldName != field)) {
      out = append(out, l)
    }
  }
  return out
}

fn relationAutoFactAdd(
  c: Checker, recv: int, field: string, loaded: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  let symbol = relationAutoSymbol(c, recv)
  if (symbol == 0) {
    return loaded
  }
  let out = []RelationAutoErrLoaded(0)
  for l of loaded {
    if (l.symbol == symbol && l.fieldName == field) {
      return loaded
    }
    out = append(out, l)
  }
  return append(
    out,
    RelationAutoErrLoaded{
      symbol = symbol, fieldName = field,
    },
  )
}

fn relationAutoLiteralFacts(
  c: Checker, target: int, value: int, loaded: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  let s = relationAutoStripTry(c, value)
  if (s == 0 || getNode(c.tree, s).tag != Tag.CompositeLit) {
    return loaded
  }
  let k = kidsOf(c.tree, s)
  if (len(k) < 2 || k[1] == 0 || getNode(c.tree, k[1]).tag != Tag.FieldInits) {
    return loaded
  }
  let cls = relationAutoClassFromStructType(c, checkExprType(c, s))
  if (!cls.found) {
    return loaded
  }
  let out = loaded
  for f of kidsOf(c.tree, k[1]) {
    let field = identText(c.tree, c.source, kidsOf(c.tree, f)[0])
    if (lintFieldIsRelation(cls.oc.tree, cls.oc.source, cls.decl, field) &&
      relationAutoErrLiteralSets(c, s, field)) {
      out = relationAutoFactAdd(c, target, field, out)
    }
  }
  return out
}

fn relationAutoAssignedValue(
  c: Checker, target: int, value: int, loaded: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  let tag = getNode(c.tree, target).tag
  let out = relationAutoFactsKill(c, target, loaded)
  if (tag == Tag.Ident) {
    return relationAutoLiteralFacts(c, target, value, out)
  }
  if (tag == Tag.Member) {
    let k = kidsOf(c.tree, target)
    if (getNode(c.tree, k[0]).tag == Tag.Ident) {
      return relationAutoFactAdd(c, k[0], identText(c.tree, c.source, k[1]), out)
    }
  }
  return out
}

fn relationAutoMarkAssigned(
  c: Checker, node: int, loaded: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  let k = kidsOf(c.tree, node)
  let targets = kidsOf(c.tree, k[0])
  let values = kidsOf(c.tree, k[1])
  let out = loaded
  let i = 0
  while (i < len(targets)) {
    if (len(targets) == len(values)) {
      out = relationAutoAssignedValue(c, targets[i], values[i], out)
    } else {
      out = relationAutoFactsKill(c, targets[i], out)
    }
    i = i + 1
  }
  return out
}

fn relationAutoFactsMeet(
  a: []RelationAutoErrLoaded, b: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  let out = []RelationAutoErrLoaded(0)
  for x of a {
    for y of b {
      if (x.symbol == y.symbol && x.fieldName == y.fieldName) {
        out = append(out, x)
        break
      }
    }
  }
  return out
}

// A later iteration may reach the body after any of its writes. Retain only
// entry facts every write preserves; zero iterations establish nothing.
fn relationAutoLoopFacts(
  c: Checker, node: int, loaded: []RelationAutoErrLoaded,
): []RelationAutoErrLoaded {
  if (node == 0 || lintIsNestedFuncBoundary(getNode(c.tree, node).tag)) {
    return loaded
  }
  let out = loaded
  if (getNode(c.tree, node).tag == Tag.Assign) {
    out = relationAutoFactsMeet(out, relationAutoMarkAssigned(c, node, out))
  }
  for k of kidsOf(c.tree, node) {
    out = relationAutoLoopFacts(c, k, out)
  }
  return out
}

fn relationAutoIsLoop(tag: Tag): bool {
  return tag == Tag.WhileStmt ||
    tag == Tag.ForC ||
    tag == Tag.ForOf ||
    tag == Tag.ForIn ||
    tag == Tag.ForInf
}

fn relationAutoJoinCaseFacts(
  joined: []RelationAutoErrLoaded, branch: []RelationAutoErrLoaded, seen: bool,
): []RelationAutoErrLoaded {
  if (!seen) {
    return branch
  }
  return relationAutoFactsMeet(joined, branch)
}
