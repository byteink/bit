// bit lsp (#1547) — in-Bit self-checks for the ported language server, run from
// `selfcheck()` under `./make test`. A failed `assert` panics (exit 2), so a
// regression in the LSP substrate fails the build. These cover the pure layer
// (position math, URI mapping, JSON-RPC framing) — the parts testable without a
// project on disk; the end-to-end behaviour (9 methods over stdio) is gated by
// the scripted transcript in scripts/lsp-transcript.sh, which drives the real
// `bit lsp` binary.

// Position <-> byte-offset round-trips, ASCII and a codepoint above U+FFFF (2
// UTF-16 units).
function checkLspPositions() {
  let src = "let x = 1\nlet yy = 2\n"
  let pos = byteToLspPos(src, 14) // the 'y' of "yy"
  assert(pos.line == 1)
  assert(pos.character == 4)
  assert(lspPosToByte(src, pos) == 14)

  // A 4-byte UTF-8 codepoint (U+1F600) costs 2 UTF-16 units: the byte after it
  // is at character 3 (1 for 'a' + 2 for the emoji), not 2.
  let wide = "a" + utf8Append("", 0x1F600) + "b"
  let bpos = byteToLspPos(wide, 5) // start of "b"; emoji occupies bytes 1..4
  assert(bpos.line == 0)
  assert(bpos.character == 3)
  assert(lspPosToByte(wide, bpos) == 5)

  // Line/char (0,0) is byte 0; a position past the line's end clamps at the
  // newline rather than crossing into the next line.
  assert(lspPosToByte(src, LspPos{ line: 0, character: 0 }) == 0)
  assert(lspPosToByte(src, LspPos{ line: 0, character: 99 }) == 9) // clamps at '\n'
}

// URI <-> path round-trip, matching "uriToPath / pathToUri" test:
// a space encodes as %20, and the round-trip is the identity.
function checkLspUri() {
  let path = lspUriToPath("file:///tmp/a%20b/x.bit")
  assert(path == "/tmp/a b/x.bit")
  let uri = lspPathToUri(path)
  assert(uri == "file:///tmp/a%20b/x.bit")

  // A non-file scheme is rejected (empty sentinel).
  assert(lspUriToPath("http://x/y") == "")
  // A stray '%' with no valid hex pair passes through literally.
  assert(lspPercentDecode("a%zz") == "a%zz")
  assert(lspPercentDecode("a%2") == "a%2")
}

// `Content-Length` framing: readMessage extracts exactly the declared body, and
// writeFramed prepends the correct header. Mirrors "readMessage
// parses Content-Length framing" test, driven over an in-memory Reader.
function checkLspFraming() {
  let body = "{\"a\":\"body!\"}"
  let framed = "Content-Length: 13\r\n\r\n" + body
  let r = lspReaderOverString(framed)
  let msg = lspReadMessage(r)
  assert(msg.ok)
  assert(msg.body == body)

  // A second read past the single message reports end-of-stream, not a phantom.
  let msg2 = lspReadMessage(r)
  assert(!msg2.ok)

  // Extra ignored headers before the blank line are tolerated.
  let framed2 = "Content-Type: x\r\nContent-Length: 2\r\n\r\n{}"
  let m3 = lspReadMessage(lspReaderOverString(framed2))
  assert(m3.ok)
  assert(m3.body == "{}")

  // The framed output carries the byte count of the body, then the body.
  assert(lspFrame("{}") == "Content-Length: 2\r\n\r\n{}")
}

// `n` blank-ish lines — enough to trip `max-file-lines` without needing to be
// valid Bit source, matching lintcheck.bit's own fixtures: the rule counts
// lines textually and never parses.
function lspLintFixtureLines(n: int): string {
  let out = ""
  let i = 0
  while (i < n) {
    out = out + "let x = 1\n"
    i = i + 1
  }
  return out
}

// Lint findings ride along with check diagnostics over the LSP (#1391).
// `lspLintDiagnostics` runs against its own throwaway sink, never `p.diags` —
// that sink is what `lspBuildProject` gates the type checker on, so a lint
// result (a warning finding, or a malformed directive's error) must never
// land there or it would silently block hover/definition/completion the way
// a real check error does.
function checkLspLint() {
  // A clean small file: no findings.
  let clean = lspLintDiagnostics("let x = 1\n")
  assert(len(clean.list) == 0)

  // Past the 800-line default: exactly one E0200 warning, distinct severity
  // from an error (severity 1, not 0 — `lspSeverity` maps it to LSP
  // Warning=2, never Error=1).
  let over = lspLintDiagnostics(lspLintFixtureLines(801))
  assert(len(over.list) == 1)
  assert(over.list[0].code == ecLintMaxFileLines)
  assert(over.list[0].severity == 1)

  // A malformed directive reports itself and stops reading further
  // directives, but the rules still run on the config parsed so far —
  // "report it in place and keep going", not the CLI's exit 2.
  let bad = lspLintDiagnostics("// bit:lint max-file-lines 900 -- nope\nlet x = 1\n")
  assert(len(bad.list) == 1)
  assert(bad.list[0].code == ecLintBadDirective)
  assert(bad.list[0].severity == 0)

  // A genuine lex/parse error yields NO lint findings (#2331): the checker's
  // own `p.diags` already carries this exact diagnostic (it parses the same
  // overlay text via `loadProjectOverlay`), so `lspPublishDiagnostics`
  // appending this sink's list too would publish it a second time, byte-
  // identical range and message.
  let broken = lspLintDiagnostics("let x = \"unterminated\n")
  assert(len(broken.list) == 0)

  // A directive error ahead of a later parse error keeps the directive
  // finding (lint-only, never in the checker) and still drops the parse
  // diagnostic (checker-owned).
  let badAndBroken = lspLintDiagnostics(
    "// bit:lint max-file-lines 900 -- nope\nlet x = \"unterminated\n")
  assert(len(badAndBroken.list) == 1)
  assert(badAndBroken.list[0].code == ecLintBadDirective)
}

function checkLsp() {
  checkLspPositions()
  checkLspUri()
  checkLspFraming()
  checkLspLint()
}
