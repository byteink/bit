// The canonical list of runtime primitives the compiler can emit a call to —
// this module's half of the ABI contract `runtime/ABI.md` describes, and the
// DEMAND oracle `_tests_/bit/abimembers/` checks the runtime's `@symbol` pins
// against.
//
// WHY A TABLE AND NOT A SCAN
//
// Until #1858 the oracle was the deleted seed compiler's `ir` module's
// `RtFn` enum (removed along with the rest of the seed by #1593); nothing in
// `compiler/` replaced it: demand is spread across the
// `Op.RtCall` sites, the names `lowerprim.bit`'s `primRtName` returns, and the
// backends emit directly. A text scan over those is INCOMPLETE BY CONSTRUCTION —
// `print` and `eprint` reach `.name` through a variable, so no scanner can see
// them — and a demand set that silently shrinks is a gate that silently passes.
//
// So the list is written down. It is reviewable in a diff, which the scan never
// was, and `abimembers.bit` holds it to both sides: a floor keeps it from being
// emptied, and every `rt_call` name the compiler is actually seen to build must
// appear here, so the table cannot drift below what the compiler emits.
//
// PROVENANCE: copied from the deleted seed compiler's `ir` module's `RtFn`
// enum as it stood on main at the time (#1858); that module no longer
// exists — the seed was deleted by #1593. Taking the known-good set whole
// preserves the demand the seed asserted; re-deriving it from `compiler/`
// alone would have produced a SMALLER set, which is the failure this guards
// against.
//
// #1858 suggested seeding this from commit `8e8cd5e`. Do not — that
// commit predates #1591 and its roster held 93 tags, not 96. `os_run_bounded`,
// `os_run_test_bounded` and `string_cmp` are missing from it, and a roster three
// primitives short still clears `minRtFnTags`, so the gate would have gone on
// passing while quietly checking nothing for those three.
//
// Tags map to symbols through `codegen.bit`'s `rtSymbol`, which is why two
// entries here (`err_get`, `err_set`) do not read as their own symbol names:
// those are `bit_rt_get_err` / `bit_rt_set_err`, verb first. Every other tag `t`
// is `bit_rt_${t}`. What each primitive does is documented in `runtime/ABI.md`,
// not here — this file is the roster, not the contract.
//
// ADDING A PRIMITIVE: add the tag here, pin `@symbol("bit_rt_<name>")` on a
// provider under `runtime/`, and document it in `runtime/ABI.md`. Leaving this
// file out makes `abimembers` fail naming the tag, which is the point.
//
// NOTHING IN `compiler/` CALLS THIS, and that is deliberate. The obvious use —
// having `rtSymbol` check its argument against the roster — would run a scan of
// this list on every `rt_call` the backend lowers, to re-derive at compile time
// what the gate already proves once. `abimembers` is what keeps the table and
// the compiler in step, in both directions: a floor if the roster shrinks, and
// `checkTableCovers` if the compiler grows past it.
fn rtFnTags(): []string {
  return [
    "assert",
    "atan2",
    "auxv",
    "bytes_from_string",
    "ceil",
    "chan_close",
    "chan_make",
    "chan_recv",
    "chan_recv_ok",
    "chan_send",
    "eprint",
    "err_get",
    "err_set",
    "float32_bits",
    "float_bits",
    "floor",
    "fs_append",
    "fs_chmod",
    "fs_close",
    "fs_cwd",
    "fs_exists",
    "fs_is_dir",
    "fs_list_dir",
    "fs_mkdir",
    "fs_open",
    "fs_read",
    "fs_read_all",
    "fs_remove",
    "fs_rename",
    "fs_write",
    "host_target",
    "iface_as",
    "iface_as_ok",
    "iface_assert",
    "log",
    "log10",
    "log2",
    "map_delete",
    "map_get",
    "map_has",
    "map_iter_init",
    "map_iter_next",
    "map_key_at",
    "map_len",
    "map_new",
    "map_set",
    "map_slot",
    "map_val_at",
    "net_accept",
    "net_dial",
    "net_listen",
    "net_local_port",
    "net_read",
    "net_resolve",
    "net_udp_bind",
    "net_udp_recv",
    "net_udp_send",
    "net_udp_sender_host",
    "net_udp_sender_port",
    "net_write",
    "os_arg_at",
    "os_argc",
    "os_env",
    "os_exit",
    "os_run",
    "os_run_bounded",
    "os_run_test",
    "os_run_test_bounded",
    "os_self_exe",
    "panic",
    "parse_float",
    "pow",
    "print",
    "random_bytes",
    "round",
    "sched_timer_chan_arm",
    "secure_zero",
    "select",
    "select_alloc",
    "slice_append",
    "slice_get",
    "slice_new",
    "slice_set",
    "slice_slice",
    "spawn",
    "sqrt",
    "string_byte",
