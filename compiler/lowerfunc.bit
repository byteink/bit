// compiler/lowerfunc.bit — split out of lower.bit (#1809). Sibling of
// lower.bit and lowerfuncval.bit (#3790): same module, so this needs no
// imports and no call-site changes. Holds statement lowering (lowerStmt,
// lowerStmtList) and function-declaration lowering (lowerFunc,
// lowerFuncNamed, paramNames). Closure/arrow-fn synthesis, spawn
// trampolines and method-value lowering moved to lowerfuncval.bit (#3790)
// to keep both files well under the 800-line ceiling.

// Whether a single-value `return` inside a fallible function owes the ok
// path's `clearErr` (§11.6). Yes for a value that IS the ok result — the slot
// must be null when the caller checks it. No for a value that is ITSELF
// fallible, because then the `return` is FORWARDING a failure and clearing
// deletes it (#4504).
//
// The second case is unreachable from a named function: `fn f(): i64! {
// return boom(n) }` is E0041 there, it must be written `boom(n)?`. It exists
// only in an arrow, whose return position `vArrow` leaves undecided for a
// fallible expectation (#1488, validatecall.bit) — so `(n) => { return
// boom(n) }` is accepted and forwards, which is what it did before closures
// carried a fallible context at all.
fn retClearsErr(fc: FnCtx, vty: int): bool {
  if (fc.fallibleErr == 0) {
    return false
  }
  return vty == 0 || fc.c.ctx.types[vty].kind != TypeKind.Fallible
}

// #3282: every instruction this statement lowers defaults to ITS span,
// restored on exit (defer) so a nested construct's own, more specific span
// (a nested lowerStmt, or lowerCall's cn.span override) never leaks past the
// statement that contains it. A statement with no real source (none exist
// today) would carry n.span from the synthesized node anyway -- there is no
// synthesized STATEMENT in this lowerer, only synthesized instructions
// within a real one, which is why this granularity needs no "unknown" case.
fn lowerStmt(fc: FnCtx, node: int) {
  let n = getNode(fc.c.tree, node)
  let prevSpan = fc.b.curSpan
  defer restoreSpan(fc, prevSpan)
  builderSetSpan(fc.b, remapModuleSpan(fc.c, n.span))
  if (n.tag == Tag.ExprStmt) {
    // A bare expression statement (e.g. `print(x)`); its value is discarded.
    lowerExpr(fc, kidsOf(fc.c.tree, node)[0])
    return
  }
  if (n.tag == Tag.DeferStmt) {
    lowerDefer(fc, node)
    return
  }
  // A nested block `{ … }` as a statement: its own local scope. Unconditional
  // (unlike if/while/for), so a `defer` inside it needs no E0092 refusal — see
  // lowerBareBlock (compiler/lowerctrl.bit, #3443).
  if (n.tag == Tag.Block) {
    lowerBareBlock(fc, node)
    return
  }
  if (n.tag == Tag.SpawnStmt) {
    lowerSpawn(fc, node)
    return
  }
  if (n.tag == Tag.SendStmt) {
    // `ch <- v`: send one word; the value lowers at the channel's element type.
    let sk = kidsOf(fc.c.tree, node)
    let chanTy = defaultType(fc.c, nodeType(fc, sk[0]))
    let elemTy = fc.c.ctx.types[chanTy].elem
    let ch = lowerExpr(fc, sk[0])
    let v = lowerExprH(fc, sk[1], elemTy)
    if (fc.failed) {
      return
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "chan_send"
    ins.args = [ch, v]
    emitRtCall(fc, ins)
    return
  }
  if (n.tag == Tag.LetDecl || n.tag == Tag.ConstDecl) {
    let binds = kidsOf(fc.c.tree, node)
    let i = 0
    while (i < len(binds) && !fc.failed) {
      lowerBinding(fc, binds[i])
      i = i + 1
    }
    return
  }
  if (n.tag == Tag.ReturnStmt) {
    let vals = kidsOf(fc.c.tree, node)
    if (len(vals) == 0) {
      runDefers(fc)
      // A fallible function's ok return must leave the error slot null (§11.6).
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      builderEmit(fc.b, mkInstr(Op.Ret, fc.c.ctx.voidId))
      fc.terminated = true
      return
    }
    // `return a, b` builds one boxed tuple and returns a single handle (ABI.md
    // §1.1) — a `ret` carries at most one value. Elements are lowered against the
    // DECLARED element types: an untyped literal must widen to the element's
    // width before it is stored into the box, unlike a single-value return where
    // the ret register absorbs the difference.
    if (len(vals) > 1) {
      let tupTy = fc.resultTy
      if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
        fcFail(fc, n.span, "a multi-value `return` whose function result is not a matching tuple")
        return
      }
      let members = fc.c.ctx.types[tupTy].members
      if (len(members) != len(vals)) {
        fcFail(
          fc,
          n.span,
          "a multi-value `return` with the wrong number of values for the result tuple",
        )
        return
      }
      let elems = []int(0)
      let ei = 0
      while (ei < len(vals)) {
        elems = append(
          elems,
          arrayValueForBind(fc, vals[ei], lowerExprH(fc, vals[ei], members[ei]), members[ei]),
        )
        if (fc.failed) {
          return
        }
        ei = ei + 1
      }
      let boxed = buildTuple(fc, tupTy, elems)
      runDefers(fc)
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      emitReturnValue(fc, boxed)
      return
    }
    // The declared result type is the hint, matching the seed: without it an
    // untyped literal lands at its default type and a narrower result reads the
    // wrong half of it — `return 4.5` from an `f32!` (#1467). Defers run after
    // the return value is evaluated, before the ret. Returning an array from a
    // location copies it.
    let vty = nodeType(fc, vals[0])
    let v = arrayValueForBind(fc, vals[0], lowerExprH(fc, vals[0], fc.resultTy), vty)
    if (fc.failed) {
      return
    }
    runDefers(fc)
    if (retClearsErr(fc, vty)) {
      clearErr(fc)
    }
    emitReturnValue(fc, v)
    return
  }
  if (n.tag == Tag.FailStmt) {
    lowerFail(fc, node)
    return
  }
  if (n.tag == Tag.IfStmt) {
    lowerIf(fc, node)
    return
  }
  if (n.tag == Tag.WhileStmt) {
    lowerWhile(fc, node)
    return
  }
  if (n.tag == Tag.ForInf) {
    lowerForInf(fc, node)
    return
  }
  if (n.tag == Tag.ForOf) {
    lowerForOf(fc, node)
    return
  }
  if (n.tag == Tag.ForIn) {
    lowerForIn(fc, node)
    return
  }
  if (n.tag == Tag.ForC) {
    lowerForC(fc, node)
    return
  }
  if (n.tag == Tag.MatchStmt) {
    lowerMatch(fc, node)
    return
  }
  if (n.tag == Tag.SwitchStmt) {
    lowerSwitch(fc, node)
    return
  }
  if (n.tag == Tag.SelectStmt) {
    lowerSelect(fc, node)
    return
  }
  if (n.tag == Tag.Assign) {
    lowerAssign(fc, node)
    return
  }
  if (n.tag == Tag.IncStmt) {
    lowerIncDec(fc, node, int(Kind.Plus))
    return
  }
  if (n.tag == Tag.DecStmt) {
    lowerIncDec(fc, node, int(Kind.Minus))
    return
  }
  if (n.tag == Tag.BreakStmt || n.tag == Tag.ContinueStmt) {
    if (len(fc.loops) == 0) {
      fcFail(fc, n.span, "`break`/`continue` outside any loop or switch")
      return
    }
    // `break` targets the innermost frame (loop or switch); `continue` targets
    // the innermost real loop, skipping switch frames.
    let fi = len(fc.loops) - 1
    if (n.tag == Tag.ContinueStmt) {
      while (fi >= 0 && fc.loops[fi].isSwitch) {
        fi = fi - 1
      }
      if (fi < 0) {
        fcFail(fc, n.span, "`continue` outside any loop")
        return
      }
    }
    let frame = fc.loops[fi]
    let target = frame.exit
    if (n.tag == Tag.ContinueStmt) {
      target = frame.cont
    } else {
      // Records that this frame's exit really is reachable, so `lowerWhile` can
      // tell a `while (true)` that breaks from one that diverges (#1548).
      fc.loops[fi].exitUsed = true
    }
    emitJump(fc, target, snapshotValues(fc, frame.preLen))
    fc.terminated = true
    return
  }
  fcFail(fc, n.span, "a statement form the lowerer does not yet handle")
}

// Emits this body's `ret` carrying `v`, a value of the declared result type.
//
// ONE place for every return form. When the result is exploded (#4405,
// `fc.retWords`) the words are read out of `v` here rather than each form
// growing its own exploded path, so `return a, b`, `return t` and
// `return f()` cannot disagree about the width the ABI promises — a
// disagreement no gate could see, since each `ret` is individually valid.
//
// Emitted after `runDefers`, so the words sit adjacent to the `ret` that
// consumes them and the box they are read from is removed by store-to-load
// forwarding plus dead-allocation elimination.
fn emitReturnValue(fc: FnCtx, v: int) {
  let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
  // The two arms are ALTERNATIVES, not a coercion the explosion then discards.
  // They used to be written the other way round — coerce, then overwrite —
  // which was correct while a plain `string` result could never have
  // `retWords`. #4424 made it exactly the common case, and an overwrite there
  // leaves a whole unbox/rebox round trip (three `field_get`s, a `gc_alloc`
  // and three `field_set`s) in the IR with nothing reading its result, on
  // every one of the 507 string-returning declarations in the tree.
  if (len(fc.retWords) != 0) {
    r.args = explodedRetValues(fc, v, fc.retWords)
  } else {
    // The "return" position for a result the ABI still hands back as one
    // boxed handle — a method, a generic instance, an `extern`, a `@symbol`
    // or a variadic declaration, plus every closure body. `v` already IS
    // that handle (#4426, lowerexplodestr.bit) — except for a `return f()`
    // pass-through, where it is a box `emitResolvedCall` rebuilt from three
    // registers and `retHandleFor` (#4628) recovers the callee's own handle.
    r.args = [retHandleFor(fc, v)]
  }
  builderEmit(fc.b, r)
  fc.terminated = true
}

// Lowers a body block's statements in order, stopping at the first unlowerable
// one (`failed`) or once the block has terminated (dead code after it).
fn lowerStmtList(fc: FnCtx, block: int) {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
}

// A signature-only stub: params + the fall-off `ret`, for functions whose body
// is not yet fully lowerable.
fn signatureOnlyFunc(c: Checker, name: string, paramTypes: []int, result: int): IrFunc {
  let b = newBuilder()
  builderBeginBlock(b, builderNewBlock(b))
  let i = 0
  while (i < len(paramTypes)) {
    builderAddParam(b, paramTypes[i])
    i = i + 1
  }
  builderEmit(b, mkInstr(Op.Ret, c.ctx.voidId))
  builderEndBlock(b)
  return IrFunc{
    name: name, paramTypes: paramTypes, result: result,
    blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false,
  }
}

// Lowers one function declaration to an `IrFunc`: the full signature plus the
// body if every statement lowers, else a signature-only stub.
// Maps every top-level (and, harmlessly, nested — locals shadow via env) const
// binding name to its initializer node, so a reference inlines the value.
fn collectModuleConsts(c: Checker): map<string, int> {
  let m = map<string, int>{}
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.ConstDecl) {
      let binds = kidsOf(c.tree, i)
      let j = 0
      while (j < len(binds)) {
        let bk = kidsOf(c.tree, binds[j])
        let pat = getNode(c.tree, bk[0])
        if (pat.tag == Tag.Ident && bk[2] != 0) {
          m[c.source[pat.span.start:pat.span.end]] = bk[2]
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return m
}

fn lowerFunc(c: Checker, decl: int, moduleConsts: map<string, int>, lowerer: Lowerer): IrFunc {
  return lowerFuncNamed(c, decl, moduleConsts, lowerer, "", emptyTypeEnv())
}

// §10.3.1: true if the func_decl carries `@want` in its trailing attr_list
// (the 7th child, elided for attr-less functions).
fn funcHasAttr(c: Checker, decl: int, want: string): bool {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 6 || kids[6] == 0) {
    return false
  }
  let attrs = kidsOf(c.tree, kids[6])
  let i = 0
  while (i < len(attrs)) {
    let an = getNode(c.tree, kidsOf(c.tree, attrs[i])[0])
    if (c.source[an.span.start:an.span.end] == want) {
      return true
    }
    i = i + 1
  }
  return false
}

// §11.9: the string argument of `@want("...")` on this func_decl, or "" if the
// attribute is absent or carries no argument. The literal's quotes are stripped;
// a symbol name has no use for escapes, and the checker has already rejected
// anything outside the C identifier charset.
fn funcAttrArg(c: Checker, decl: int, want: string): string {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 6 || kids[6] == 0) {
    return ""
  }
  let attrs = kidsOf(c.tree, kids[6])
  let i = 0
  while (i < len(attrs)) {
    let ak = kidsOf(c.tree, attrs[i])
    let an = getNode(c.tree, ak[0])
    if (c.source[an.span.start:an.span.end] == want && len(ak) > 1 && ak[1] != 0) {
      let sn = getNode(c.tree, ak[1])
      return c.source[sn.span.start + 1:sn.span.end - 1]
    }
    i = i + 1
  }
  return ""
}

// Lowers a function; `nameOverride` (non-empty) forces the IR name — used for a
// monomorphized instance `name$index`, which bypasses method mangling. `genEnv`
// carries that instance's type-param bindings (empty for an ordinary function),
// which every body node's type is resolved through — see nodeType.
fn lowerFuncNamed(
  c: Checker,
  decl: int,
  moduleConsts: map<string, int>,
  lowerer: Lowerer,
  nameOverride: string,
  genEnv: TypeEnv,
): IrFunc {
  let kids = kidsOf(c.tree, decl)
  let nm = getNode(c.tree, kids[1])
  let name = c.source[nm.span.start:nm.span.end]
  // Kept before every mangling below, so the entry-point test at the bottom asks
  // about the DECLARED name and not about a method/instance/@symbol spelling that
  // happens to read `main`.
  let declName = name
  // A method's IR name is mangled by its receiver type's id (`get$t21`), so two
  // types can share a method name (the seed's method FuncId scheme).
  if (kids[0] != 0) {
    let recvId = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))
    // The entry itself is recorded by Pass A3' (collectMethodEntries), which runs
    // BEFORE any body is lowered — see the ordering note there. Only the name
    // mangling happens here.
    //
    // A generic receiver's method is emitted once per nominal instantiation
    // (#1540), each with `nameOverride` already mangled by that INSTANCE's type
    // id — `userTypeLookup` here would return the template's id and collapse
    // every instantiation back onto one symbol. A free monomorphized instance
    // also arrives with an override, and never has a receiver at all.
    name = lowerer.modPrefix + name + "\$t${recvId}"
  } else {
    name = lowerer.modPrefix + name
  }
  // An override (a monomorphized instance) is already module-qualified by the
  // caller, so it is used verbatim — prefixing again would produce `m2$m2$f$0`.
  if (nameOverride != "") {
    name = nameOverride
  }
  // §11.9: `@symbol("name")` pins the link-level name, bypassing module
  // qualification entirely — the `m<id>$` ordinal is assigned by whichever build
  // imports the module, so a qualified name is not stable enough to be the
  // symbol codegen calls a runtime primitive by. Applied after nameOverride
  // because a pinned function is never generic (the checker rejects that), so
  // the two can never both be set.
  let pinned = funcAttrArg(c, decl, "symbol")
  if (pinned != "") {
    name = pinned
  }
  let paramTypes = substTypeList(c, lowerParamSlotTypes(c, decl), genEnv)
  // An omitted result is void; a fallible result `T!E` shows its ok type in the
  // header, and its ok/err feed the error channel (`fail`/`?`/ok-return).
  let result = c.ctx.voidId
  let fallibleOk = 0
  let fallibleErr = 0
  if (kids[4] != 0) {
    let rawResult = typeFromNode(c, kids[4])
    if (rawResult != 0 && c.ctx.types[rawResult].kind == TypeKind.Fallible) {
      fallibleOk = c.ctx.types[rawResult].result
      fallibleErr = c.ctx.types[rawResult].errTy
    }
    result = unwrapFallible(c, rawResult)
  }
  // A generic instance's SIGNATURE is re-derived like every other type in its
  // body (#1540): the annotations above resolve against the template, so `T`
  // stays `T` here even though the body lowers concretely. Empty for an ordinary
  // function, where `substType` returns its argument untouched.
  result = substType(c, result, genEnv, 0)
  fallibleOk = substType(c, fallibleOk, genEnv, 0)
  fallibleErr = substType(c, fallibleErr, genEnv, 0)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let fc = FnCtx{
    c: c, b: b, env: []LocalBind(0), failed: false,
    failSpan: pointSpan(0, 0), failReason: "", terminated: false,
    loops: []LoopFrame(0), moduleConsts: moduleConsts, lowerer: lowerer, defers: []DeferCall(0),
    fallibleOk: fallibleOk, fallibleErr: fallibleErr, genEnv: genEnv, resultTy: result,
    boxedNames: []string(0),
  }
  // Which of this body's locals a closure both captures and writes (§12.8). Decided
  // once for the whole body, parameters included, because a capture's cell has to
  // exist from the declaration that introduces it — see `boxedLocalNames`. An
  // `overflow` answer may name only SOME of what escapes, and an unboxed capture is
  // a silent wrong answer, so the function is refused instead (a stub, which `bit
  // build` will not write a binary for).
  let names = paramNames(c, decl)
  let scan = boxedLocalNames(c, kids[5], names)
  fc.boxedNames = scan.names
  if (scan.overflow) {
    fcFail(fc, nm.span, "a function whose closures capture more locals than the lowerer can box")
  }
  // Bind params (receiver first, if any) to their block-param value ids. The
  // checker's env is flat across the whole module, so a later function's
  // same-named param can have overwritten this one's type; rebind ours here so
  // `checkExprType` resolves this body's identifiers to the correct types during
  // lowering (`x: f64` here vs `x: int` in a sibling).
  //
  // Every block param is added BEFORE the first of them is bound: a boxed
  // parameter's `declareLocal` emits its cell's `gc_alloc`, and a block's params
  // must all precede its body instructions.
  //
  // #4404: an exploded parameter adds one block param PER WORD, so the ids are
  // walked with their own cursor rather than by parameter index; #4423 adds
  // `string`. Both gates travel together so the four users below cannot disagree.
  let gates = ArgExplodeGates{ tuples: explodesParams(c, decl), strings: lowerer.explodeStrings }
  // #4405: the return width, decided once from the declaration so that every
  // `ret` this body emits and every call site that reads it agree. Empty for a
  // fallible or otherwise ineligible function, which is the one-handle
  // convention every other body keeps.
  fc.retWords = explodedRetWords(c, decl, lowerer)
  let irParamTypes = explodeParamTypes(c.ctx, paramTypes, gates)
  let paramIds = []int(0)
  let i = 0
  while (i < len(irParamTypes)) {
    paramIds = append(paramIds, builderAddParam(b, irParamTypes[i]))
    i = i + 1
  }
  // #4406: recorded from the SIGNATURE, beside the list that flattened it.
  recordParamKeepAlive(c.ctx, b, paramTypes, paramIds, gates)
  bindParamLocals(fc, names, paramTypes, paramIds, gates)
  rebindParamDeclTypes(c, decl, paramTypes)
  // #4531: each parameter's declared type NODE used to be re-recorded into
  // `declTypeNodes` here, per body, because that map was keyed by NAME and flat
  // across the module — so lowering had to undo whatever a later same-named
  // parameter had written over it. `argTypeNode`, lowering's only reader of it,
  // now reads the decl-NODE key instead (checkgeneric.bit's `declTypeNodeOf`),
  // which is unique, so checkModule's one pass over the arena is already correct
  // for every body. Deleting this is what makes the two passes agree: while it
  // existed, Pass A1's ledger (`closeInstantiations`, which runs before ANY body
  // is lowered and so saw the last writer's answer) and Pass A2/A3's call
  // resolution (which saw this rewrite) resolved the same call at DIFFERENT type
  // arguments — E0092, "target could not be resolved", inside a correct function.
  // The name-keyed twin that survives is read only by the checker's own pre-pass
  // 3b, never during lowering, so nothing needs rebinding here at all.
  let isNaked = funcHasAttr(c, decl, "naked")
  let isNosplit = funcHasAttr(c, decl, "nosplit")
  // Reserve every defer's flag+operand slots at function entry, before the
  // body lowers at all (#2378) — see deferPreScan (compiler/lowerdefer.bit).
  deferPreScan(fc, kids[5])
  lowerStmtList(fc, kids[5])
  if (fc.failed) {
    lowerer.stubbed = append(
      lowerer.stubbed,
      StubbedFn{
        name: name, span: remapModuleSpan(c, fc.failSpan), reason: fc.failReason,
        note: "", noteSite: pointSpan(0, 0),
      },
    )
    return signatureOnlyFunc(c, name, irParamTypes, result)
  }
  if (!fc.terminated) {
    // §10.3.1 @naked: no frame to tear down, so no defers and no error-slot
    // clear. It USED TO SKIP THE TERMINATOR TOO, and that was #2084: a `@naked`
    // body falling off the end left a block with no terminator at all, DCE then
    // emptied it, and `computeReachable` indexed `instrs[instsStart - 1]` and
    // segfaulted. `bit build` never saw it — E0055 rejects the shape long before
    // lowering — but the `--dump-ir` entries bypass checking by design, so they
    // walked malformed IR.
    //
    // Every block owes a terminator regardless of what suppresses the epilogue,
    // and emitting one costs a valid program nothing: `fc.terminated` is already
    // true for every `@naked` function that checks, so this branch is reachable
    // only on input E0055 rejects. Codegen's naked path lowers a `Ret` to the
    // raw `ret` with no teardown (arm64call.bit, x64call.bit), which is exactly
    // what a naked function wants anyway.
    if (!isNaked) {
      runDefers(fc)
      // A void fallible function `()!` that falls off the end still clears the
      // error slot on its ok path (§11.6).
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
    }
    builderEmit(fc.b, mkInstr(Op.Ret, c.ctx.voidId))
  }
  builderEndBlock(fc.b)
  // A fallible entry point keeps its body under a private name and gets the
  // `main` symbol from the normalizing wrapper below (SPEC §17.4, ABI.md §10).
  if (isFallibleEntry(lowerer, declName, kids, nameOverride, pinned, fallibleErr)) {
    name = fallibleMainBody
    emitFallibleMainWrapper(c, lowerer, moduleConsts, genEnv, result, fallibleErr)
  }
  // #3786: `inTestFile` is read back by testgen.bit's `isTestFunc`; #4129:
  // `testFile` by its `bit test` printer (testrun.bit), to group ok/FAIL
  // lines by origin file.
  return IrFunc{
    name: name, paramTypes: irParamTypes, result: result,
    blocks: fc.b.blocks, instrs: fc.b.instrs, isFallible: fc.fallibleErr != 0,
    isNaked: isNaked, isNosplit: isNosplit,
    inRootModule: lowerer.curModule == lowerer.root, isPinned: pinned != "",
    inTestFile: declInTestFile(c, nm.span), testFile: declFilePath(c, nm.span),
    keepAlive: fc.b.keepAlive,
  }
}

// Binds each source parameter (receiver first, if any) to the block-param value
// ids it was given. An exploded parameter consumed TWO ids and is bound to both
// (#4404); every other parameter consumed one and is bound exactly as before.
//
// The checker's env is flat across the whole module, so a later function's
// same-named param can have overwritten this one's type; rebinding here is what
// makes `checkExprType` resolve this body's identifiers to the correct types
// during lowering (`x: f64` here vs `x: int` in a sibling). The DECLARED type is
// what goes back into that env, never the word types — nothing above the
// lowerer knows this parameter arrived in pieces.
fn bindParamLocals(
  fc: FnCtx, names: []string, paramTypes: []int, ids: []int, gates: ArgExplodeGates,
) {
  let cursor = 0
  let i = 0
  while (i < len(paramTypes)) {
    let words = []int(0)
    if (gates.tuples) {
      words = explodedWordTypes(fc.c.ctx, paramTypes[i], gates.strings)
    }
    if (len(words) == 0) {
      declareLocal(fc, names[i], ids[cursor], paramTypes[i])
      cursor = cursor + 1
    } else {
      declareExplodedParam(fc, names[i], paramTypes[i], words, ids[cursor:cursor + len(words)])
      cursor = cursor + len(words)
    }
    fc.c.env[names[i]] = paramTypes[i]
    i = i + 1
  }
}

// Rebinds this body's parameters in the CHECKER to the types this instance
// actually gives them — `rebindCheckerName`'s other half, for the one class of
// binder that never had it (#4697).
//
// `bindParamLocals` above already writes the flat `env`. The DECL path
// (`nodeSymbols` -> `Symbol.decl` -> `declTypes`) is the one an identifier
// resolves through, and it still held the check pass's answer, which for a
// monomorphized instance is the bare template: inside `fn one<T>(v: T)`,
// `checkExprType(v)` answered the rigid `T` while lowering `one<[]i64>`.
//
// `declRefType` (checkexpr.bit) reasoned that this was harmless because
// lowering substitutes what it reads. That holds for a type that MENTIONS `T`
// and not for a judgement that FAILED because of it: `checkIndex` answers 0 for
// a `T` receiver, `substType(0)` is 0, and `v[0]` reached codegen with no type
// at all — `lowerIndex` then scaled by the wrong element size (a `[]u8` read
// returned a word), `lowerToString` refused the program as E0092, and a `let`
// bound from it typed its local 0, which classifies as a GC reference.
//
// Writing the substituted type once, here, is what makes every consumer read
// the same answer the receiver has: `paramTypes` is already `substTypeList`'d,
// so for an ordinary function this writes back exactly what the checker's own
// `bindParamOrReceiver` wrote (`paramBindType` gives a variadic `...xs: T` the
// same `[]T` `lowerParamSlotTypes` does) and only an instance's types change.
// Each instance rebinds on entry to its own lowering, so two instances of one
// template cannot see each other's.
fn rebindParamDeclTypes(c: Checker, decl: int, paramTypes: []int) {
  let nodes = paramDeclNodes(c, decl)
  if (len(nodes) != len(paramTypes)) {
    return
  }
  let i = 0
  while (i < len(nodes)) {
    if (nodes[i] > 0 && nodes[i] < len(c.declTypes)) {
      c.declTypes[nodes[i]] = paramTypes[i]
    }
    i = i + 1
  }
}

// The node each parameter's type is keyed on in `declTypes`, in `paramNames`
// order — `bindParamOrReceiver`'s own keying (checkmodule.bit): the name ident,
// except for an in-body method's implicit `this`, which has no name token and is
// keyed on the receiver node itself (SPEC §10.4, #3367).
fn paramDeclNodes(c: Checker, decl: int): []int {
  let kids = kidsOf(c.tree, decl)
  let nodes = []int(0)
  if (kids[0] != 0) {
    let rnKid = kidsOf(c.tree, kids[0])[0]
    if (rnKid == 0) {
      nodes = append(nodes, kids[0])
    } else {
      nodes = append(nodes, rnKid)
    }
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    nodes = append(nodes, kidsOf(c.tree, params[i])[0])
    i = i + 1
  }
  return nodes
}

// The parameter names of a function declaration, in the same order as
// lowerParamTypes (method receiver first).
fn paramNames(c: Checker, decl: int): []string {
  let kids = kidsOf(c.tree, decl)
  let names = []string(0)
  if (kids[0] != 0) {
    let rnKid = kidsOf(c.tree, kids[0])[0]
    if (rnKid == 0) {
      // An in-body method's implicit `this` (SPEC §10.4, #3367): no name
      // token exists to read a span from.
      names = append(names, "this")
    } else {
      let rn = getNode(c.tree, rnKid)
      names = append(names, c.source[rn.span.start:rn.span.end])
    }
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    let pn = getNode(c.tree, kidsOf(c.tree, params[i])[0])
    names = append(names, c.source[pn.span.start:pn.span.end])
    i = i + 1
  }
  return names
}
