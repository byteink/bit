// compiler/lowerfunc.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

fn lowerStmt(fc: FnCtx, node: int) {
  let n = getNode(fc.c.tree, node)
  if (n.tag == Tag.ExprStmt) {
    // A bare expression statement (e.g. `print(x)`); its value is discarded.
    lowerExpr(fc, kidsOf(fc.c.tree, node)[0])
    return
  }
  if (n.tag == Tag.DeferStmt) {
    lowerDefer(fc, node)
    return
  }
  // A nested block `{ … }` as a statement: its own local scope. Unconditional
  // (unlike if/while/for), so a `defer` inside it needs no E0092 refusal — see
  // lowerBareBlock (compiler/lowerctrl.bit, #3443).
  if (n.tag == Tag.Block) {
    lowerBareBlock(fc, node)
    return
  }
  if (n.tag == Tag.SpawnStmt) {
    lowerSpawn(fc, node)
    return
  }
  if (n.tag == Tag.SendStmt) {
    // `ch <- v`: send one word; the value lowers at the channel's element type.
    let sk = kidsOf(fc.c.tree, node)
    let chanTy = defaultType(fc.c, nodeType(fc, sk[0]))
    let ch = lowerExpr(fc, sk[0])
    let v = lowerExprH(fc, sk[1], fc.c.ctx.types[chanTy].elem)
    if (fc.failed) {
      return
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "chan_send"
    ins.args = [ch, v]
    emitRtCall(fc, ins)
    return
  }
  if (n.tag == Tag.LetDecl || n.tag == Tag.ConstDecl) {
    let binds = kidsOf(fc.c.tree, node)
    let i = 0
    while (i < len(binds) && !fc.failed) {
      lowerBinding(fc, binds[i])
      i = i + 1
    }
    return
  }
  if (n.tag == Tag.ReturnStmt) {
    let vals = kidsOf(fc.c.tree, node)
    if (len(vals) == 0) {
      runDefers(fc)
      // A fallible function's ok return must leave the error slot null (§11.6).
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      builderEmit(fc.b, mkInstr(Op.Ret, fc.c.ctx.voidId))
      fc.terminated = true
      return
    }
    // `return a, b` builds one boxed tuple and returns a single handle (ABI.md
    // §1.1) — a `ret` carries at most one value. Elements are lowered against the
    // DECLARED element types: an untyped literal must widen to the element's
    // width before it is stored into the box, unlike a single-value return where
    // the ret register absorbs the difference.
    if (len(vals) > 1) {
      let tupTy = fc.resultTy
      if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
        fcFail(fc, n.span, "a multi-value `return` whose function result is not a matching tuple")
        return
      }
      let members = fc.c.ctx.types[tupTy].members
      if (len(members) != len(vals)) {
        fcFail(fc, n.span, "a multi-value `return` with the wrong number of values for the result tuple")
        return
      }
      let elems = []int(0)
      let ei = 0
      while (ei < len(vals)) {
        elems = append(elems, arrayValueForBind(fc, vals[ei], lowerExprH(fc, vals[ei], members[ei]), members[ei]))
        if (fc.failed) {
          return
        }
        ei = ei + 1
      }
      let boxed = buildTuple(fc, tupTy, elems)
      runDefers(fc)
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
      rt.args = [boxed]
      builderEmit(fc.b, rt)
      fc.terminated = true
      return
    }
    // The declared result type is the hint, matching the seed: without it an
    // untyped literal lands at its default type and a narrower result reads the
    // wrong half of it — `return 4.5` from an `f32!` (#1467). Defers run after
    // the return value is evaluated, before the ret. Returning an array from a
    // location copies it.
    let v = arrayValueForBind(fc, vals[0], lowerExprH(fc, vals[0], fc.resultTy), nodeType(fc, vals[0]))
    if (fc.failed) {
      return
    }
    runDefers(fc)
    if (fc.fallibleErr != 0) {
      clearErr(fc)
    }
    let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
    r.args = [v]
    builderEmit(fc.b, r)
    fc.terminated = true
    return
  }
  if (n.tag == Tag.FailStmt) {
    lowerFail(fc, node)
    return
  }
  if (n.tag == Tag.IfStmt) {
    lowerIf(fc, node)
    return
  }
  if (n.tag == Tag.WhileStmt) {
    lowerWhile(fc, node)
    return
  }
  if (n.tag == Tag.ForInf) {
    lowerForInf(fc, node)
    return
  }
  if (n.tag == Tag.ForOf) {
    lowerForOf(fc, node)
    return
  }
  if (n.tag == Tag.ForIn) {
    lowerForIn(fc, node)
    return
  }
  if (n.tag == Tag.ForC) {
    lowerForC(fc, node)
    return
  }
  if (n.tag == Tag.MatchStmt) {
    lowerMatch(fc, node)
    return
  }
  if (n.tag == Tag.SwitchStmt) {
    lowerSwitch(fc, node)
    return
  }
  if (n.tag == Tag.SelectStmt) {
    lowerSelect(fc, node)
    return
  }
  if (n.tag == Tag.Assign) {
    lowerAssign(fc, node)
    return
  }
  if (n.tag == Tag.IncStmt) {
    lowerIncDec(fc, node, int(Kind.Plus))
    return
  }
  if (n.tag == Tag.DecStmt) {
    lowerIncDec(fc, node, int(Kind.Minus))
    return
  }
  if (n.tag == Tag.BreakStmt || n.tag == Tag.ContinueStmt) {
    if (len(fc.loops) == 0) {
      fcFail(fc, n.span, "`break`/`continue` outside any loop or switch")
      return
    }
    // `break` targets the innermost frame (loop or switch); `continue` targets
    // the innermost real loop, skipping switch frames.
    let fi = len(fc.loops) - 1
    if (n.tag == Tag.ContinueStmt) {
      while (fi >= 0 && fc.loops[fi].isSwitch) {
        fi = fi - 1
      }
      if (fi < 0) {
        fcFail(fc, n.span, "`continue` outside any loop")
        return
      }
    }
    let frame = fc.loops[fi]
    let target = frame.exit
    if (n.tag == Tag.ContinueStmt) {
      target = frame.cont
    } else {
      // Records that this frame's exit really is reachable, so `lowerWhile` can
      // tell a `while (true)` that breaks from one that diverges (#1548).
      fc.loops[fi].exitUsed = true
    }
    emitJump(fc, target, snapshotValues(fc, frame.preLen))
    fc.terminated = true
    return
  }
  fcFail(fc, n.span, "a statement form the lowerer does not yet handle")
}

// Lowers a body block's statements in order, stopping at the first unlowerable
// one (`failed`) or once the block has terminated (dead code after it).
fn lowerStmtList(fc: FnCtx, block: int) {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
}

// A signature-only stub: params + the fall-off `ret`, for functions whose body
// is not yet fully lowerable.
fn signatureOnlyFunc(c: Checker, name: string, paramTypes: []int, result: int): IrFunc {
  let b = newBuilder()
  builderBeginBlock(b, builderNewBlock(b))
  let i = 0
  while (i < len(paramTypes)) {
    builderAddParam(b, paramTypes[i])
    i = i + 1
  }
  builderEmit(b, mkInstr(Op.Ret, c.ctx.voidId))
  builderEndBlock(b)
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false }
}

// Lowers one function declaration to an `IrFunc`: the full signature plus the
// body if every statement lowers, else a signature-only stub.
// Maps every top-level (and, harmlessly, nested — locals shadow via env) const
// binding name to its initializer node, so a reference inlines the value.
fn collectModuleConsts(c: Checker): map<string, int> {
  let m = map<string, int>{}
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.ConstDecl) {
      let binds = kidsOf(c.tree, i)
      let j = 0
      while (j < len(binds)) {
        let bk = kidsOf(c.tree, binds[j])
        let pat = getNode(c.tree, bk[0])
        if (pat.tag == Tag.Ident && bk[2] != 0) {
          m[c.source[pat.span.start:pat.span.end]] = bk[2]
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return m
}

fn lowerFunc(c: Checker, decl: int, moduleConsts: map<string, int>, lowerer: Lowerer): IrFunc {
  return lowerFuncNamed(c, decl, moduleConsts, lowerer, "", emptyTypeEnv())
}

// §10.3.1: true if the func_decl carries `@want` in its trailing attr_list
// (the 7th child, elided for attr-less functions).
fn funcHasAttr(c: Checker, decl: int, want: string): bool {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 6 || kids[6] == 0) {
    return false
  }
  let attrs = kidsOf(c.tree, kids[6])
  let i = 0
  while (i < len(attrs)) {
    let an = getNode(c.tree, kidsOf(c.tree, attrs[i])[0])
    if (c.source[an.span.start:an.span.end] == want) {
      return true
    }
    i = i + 1
  }
  return false
}

// §11.9: the string argument of `@want("...")` on this func_decl, or "" if the
// attribute is absent or carries no argument. The literal's quotes are stripped;
// a symbol name has no use for escapes, and the checker has already rejected
// anything outside the C identifier charset.
fn funcAttrArg(c: Checker, decl: int, want: string): string {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 6 || kids[6] == 0) {
    return ""
  }
  let attrs = kidsOf(c.tree, kids[6])
  let i = 0
  while (i < len(attrs)) {
    let ak = kidsOf(c.tree, attrs[i])
    let an = getNode(c.tree, ak[0])
    if (c.source[an.span.start:an.span.end] == want && len(ak) > 1 && ak[1] != 0) {
      let sn = getNode(c.tree, ak[1])
      return c.source[sn.span.start + 1:sn.span.end - 1]
    }
    i = i + 1
  }
  return ""
}

// Lowers a function; `nameOverride` (non-empty) forces the IR name — used for a
// monomorphized instance `name$index`, which bypasses method mangling. `genEnv`
// carries that instance's type-param bindings (empty for an ordinary function),
// which every body node's type is resolved through — see nodeType.
fn lowerFuncNamed(c: Checker, decl: int, moduleConsts: map<string, int>, lowerer: Lowerer, nameOverride: string, genEnv: TypeEnv): IrFunc {
  let kids = kidsOf(c.tree, decl)
  let nm = getNode(c.tree, kids[1])
  let name = c.source[nm.span.start:nm.span.end]
  // Kept before every mangling below, so the entry-point test at the bottom asks
  // about the DECLARED name and not about a method/instance/@symbol spelling that
  // happens to read `main`.
  let declName = name
  // A method's IR name is mangled by its receiver type's id (`get$t21`), so two
  // types can share a method name (the seed's method FuncId scheme).
  if (kids[0] != 0) {
    let recvId = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))
    // The entry itself is recorded by Pass A3' (collectMethodEntries), which runs
    // BEFORE any body is lowered — see the ordering note there. Only the name
    // mangling happens here.
    //
    // A generic receiver's method is emitted once per nominal instantiation
    // (#1540), each with `nameOverride` already mangled by that INSTANCE's type
    // id — `userTypeLookup` here would return the template's id and collapse
    // every instantiation back onto one symbol. A free monomorphized instance
    // also arrives with an override, and never has a receiver at all.
    name = lowerer.modPrefix + name + "\$t${recvId}"
  } else {
    name = lowerer.modPrefix + name
  }
  // An override (a monomorphized instance) is already module-qualified by the
  // caller, so it is used verbatim — prefixing again would produce `m2$m2$f$0`.
  if (nameOverride != "") {
    name = nameOverride
  }
  // §11.9: `@symbol("name")` pins the link-level name, bypassing module
  // qualification entirely — the `m<id>$` ordinal is assigned by whichever build
  // imports the module, so a qualified name is not stable enough to be the
  // symbol codegen calls a runtime primitive by. Applied after nameOverride
  // because a pinned function is never generic (the checker rejects that), so
  // the two can never both be set.
  let pinned = funcAttrArg(c, decl, "symbol")
  if (pinned != "") {
    name = pinned
  }
  let paramTypes = substTypeList(c, lowerParamSlotTypes(c, decl), genEnv)
  // An omitted result is void; a fallible result `T!E` shows its ok type in the
  // header, and its ok/err feed the error channel (`fail`/`?`/ok-return).
  let result = c.ctx.voidId
  let fallibleOk = 0
  let fallibleErr = 0
  if (kids[4] != 0) {
    let rawResult = typeFromNode(c, kids[4])
    if (rawResult != 0 && c.ctx.types[rawResult].kind == TypeKind.Fallible) {
      fallibleOk = c.ctx.types[rawResult].result
      fallibleErr = c.ctx.types[rawResult].errTy
    }
    result = unwrapFallible(c, rawResult)
  }
  // A generic instance's SIGNATURE is re-derived like every other type in its
  // body (#1540): the annotations above resolve against the template, so `T`
  // stays `T` here even though the body lowers concretely. Empty for an ordinary
  // function, where `substType` returns its argument untouched.
  result = substType(c, result, genEnv, 0)
  fallibleOk = substType(c, fallibleOk, genEnv, 0)
  fallibleErr = substType(c, fallibleErr, genEnv, 0)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let fc = FnCtx{ c: c, b: b, env: []LocalBind(0), failed: false,
    failSpan: pointSpan(0, 0), failReason: "", terminated: false,
    loops: []LoopFrame(0), moduleConsts: moduleConsts, lowerer: lowerer, defers: []DeferCall(0),
    fallibleOk: fallibleOk, fallibleErr: fallibleErr, genEnv: genEnv, resultTy: result,
    boxedNames: []string(0) }
  // Which of this body's locals a closure both captures and writes (§12.8). Decided
  // once for the whole body, parameters included, because a capture's cell has to
  // exist from the declaration that introduces it — see `boxedLocalNames`. An
  // `overflow` answer may name only SOME of what escapes, and an unboxed capture is
  // a silent wrong answer, so the function is refused instead (a stub, which `bit
  // build` will not write a binary for).
  let names = paramNames(c, decl)
  let scan = boxedLocalNames(c, kids[5], names)
  fc.boxedNames = scan.names
  if (scan.overflow) {
    fcFail(fc, nm.span, "a function whose closures capture more locals than the lowerer can box")
  }
  // Bind params (receiver first, if any) to their block-param value ids. The
  // checker's env is flat across the whole module, so a later function's
  // same-named param can have overwritten this one's type; rebind ours here so
  // `checkExprType` resolves this body's identifiers to the correct types during
  // lowering (`x: f64` here vs `x: int` in a sibling).
  //
  // Every block param is added BEFORE the first of them is bound: a boxed
  // parameter's `declareLocal` emits its cell's `gc_alloc`, and a block's params
  // must all precede its body instructions.
  let paramIds = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    paramIds = append(paramIds, builderAddParam(b, paramTypes[i]))
    i = i + 1
  }
  i = 0
  while (i < len(paramTypes)) {
    declareLocal(fc, names[i], paramIds[i], paramTypes[i])
    c.env[names[i]] = paramTypes[i]
    i = i + 1
  }
  // Record each parameter's declared type NODE for this body (a generic-enum
  // scrutinee `o: Opt<i64>` recovers its type-args from it during a match).
  let pnodes = kidsOf(c.tree, kids[3])
  let pi = 0
  while (pi < len(pnodes)) {
    let pnn = getNode(c.tree, kidsOf(c.tree, pnodes[pi])[0])
    c.declTypeNodes[c.source[pnn.span.start:pnn.span.end]] = kidsOf(c.tree, pnodes[pi])[1]
    pi = pi + 1
  }
  let isNaked = funcHasAttr(c, decl, "naked")
  let isNosplit = funcHasAttr(c, decl, "nosplit")
  // Reserve every defer's flag+operand slots at function entry, before the
  // body lowers at all (#2378) — see deferPreScan (compiler/lowerdefer.bit).
  deferPreScan(fc, kids[5])
  lowerStmtList(fc, kids[5])
  if (fc.failed) {
    lowerer.stubbed = append(lowerer.stubbed, StubbedFn{ name: name, span: remapModuleSpan(c, fc.failSpan), reason: fc.failReason })
    return signatureOnlyFunc(c, name, paramTypes, result)
  }
  if (!fc.terminated) {
    // §10.3.1 @naked: no frame to tear down, so no defers and no error-slot
    // clear. It USED TO SKIP THE TERMINATOR TOO, and that was #2084: a `@naked`
    // body falling off the end left a block with no terminator at all, DCE then
    // emptied it, and `computeReachable` indexed `instrs[instsStart - 1]` and
    // segfaulted. `bit build` never saw it — E0055 rejects the shape long before
    // lowering — but the `--dump-ir` entries bypass checking by design, so they
    // walked malformed IR.
    //
    // Every block owes a terminator regardless of what suppresses the epilogue,
    // and emitting one costs a valid program nothing: `fc.terminated` is already
    // true for every `@naked` function that checks, so this branch is reachable
    // only on input E0055 rejects. Codegen's naked path lowers a `Ret` to the
    // raw `ret` with no teardown (arm64call.bit, x64call.bit), which is exactly
    // what a naked function wants anyway.
    if (!isNaked) {
      runDefers(fc)
      // A void fallible function `()!` that falls off the end still clears the
      // error slot on its ok path (§11.6).
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
    }
    builderEmit(fc.b, mkInstr(Op.Ret, c.ctx.voidId))
  }
  builderEndBlock(fc.b)
  // A fallible entry point keeps its body under a private name and gets the
  // `main` symbol from the normalizing wrapper below (SPEC §17.4, ABI.md §10).
  if (isFallibleEntry(lowerer, declName, kids, nameOverride, pinned, fallibleErr)) {
    name = fallibleMainBody
    emitFallibleMainWrapper(c, lowerer, moduleConsts, genEnv, result, fallibleErr)
  }
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: fc.b.blocks, instrs: fc.b.instrs, isFallible: fc.fallibleErr != 0,
    isNaked: isNaked, isNosplit: isNosplit,
    inRootModule: lowerer.curModule == lowerer.root, isPinned: pinned != "" }
}

// The parameter names of a function declaration, in the same order as
// lowerParamTypes (method receiver first).
fn paramNames(c: Checker, decl: int): []string {
  let kids = kidsOf(c.tree, decl)
  let names = []string(0)
  if (kids[0] != 0) {
    let rn = getNode(c.tree, kidsOf(c.tree, kids[0])[0])
    names = append(names, c.source[rn.span.start:rn.span.end])
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    let pn = getNode(c.tree, kidsOf(c.tree, params[i])[0])
    names = append(names, c.source[pn.span.start:pn.span.end])
    i = i + 1
  }
  return names
}

// Lowers every top-level function into an `IrModule`. FuncId order matches the
// seed's passes: free functions first (Pass A), then class methods (Pass A3),
// each in declaration order — so the dump's `func` blocks line up.
// Lays out a closure's captured fields (like structLayout, over arbitrary field
// types) into offsets + GC pointer offsets + total size.
fn layoutFields(fc: FnCtx, fieldTypes: []int): StructLayout {
  let offsets = []int(0)
  let ptrOffsets = []int(0)
  let cur = 0
  let i = 0
  while (i < len(fieldTypes)) {
    let fl = fieldLayoutFor(fc, fieldTypes[i])
    cur = alignUp(cur, fl.size)
    offsets = append(offsets, cur)
    if (fl.isPtr) {
      ptrOffsets = append(ptrOffsets, cur)
    }
    cur = cur + fl.size
    i = i + 1
  }
  return StructLayout{ size: alignUp(cur, 8), offsets: offsets, ptrOffsets: ptrOffsets }
}

// Synthesizes a closure function `closure$<fid>(env, params) { body }`: the body
// reads its captures from the env object (word i) and its params from block
// params. Returns the FuncId (post-order: nested closures get lower ids). Appends
// the function to the shared closure list.
fn lowerClosureBody(fc: FnCtx, node: int, closureTy: int, caps: CaptureSet, layout: StructLayout): int {
  let k = kidsOf(fc.c.tree, node)
  let ft = fc.c.ctx.types[closureTy]
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  // The boxed-name set is the ENCLOSING body's: a closure is lowered as part of
  // the function that contains it, so a name a nested arrow captures and writes
  // has to be boxed at the same scopes on both sides of the boundary.
  let cfc = FnCtx{ c: fc.c, b: b, env: []LocalBind(0), failed: false,
    failSpan: pointSpan(0, 0), failReason: "", terminated: false,
    loops: []LoopFrame(0), moduleConsts: fc.moduleConsts, lowerer: fc.lowerer, defers: []DeferCall(0),
    fallibleOk: 0, fallibleErr: 0, genEnv: fc.genEnv, resultTy: ft.result,
    boxedNames: fc.boxedNames }
  let envParam = builderAddParam(b, closureTy)
  let allParams = [closureTy]
  let pnodes = kidsOf(fc.c.tree, k[0])
  // Params first, then their bindings: a boxed param's `declareLocal` emits its
  // cell's `gc_alloc`, and a block's params must all precede its instructions.
  let paramIds = []int(0)
  let i = 0
  while (i < len(pnodes)) {
    paramIds = append(paramIds, builderAddParam(b, ft.members[i]))
    allParams = append(allParams, ft.members[i])
    i = i + 1
  }
  i = 0
  while (i < len(pnodes)) {
    let pn = getNode(fc.c.tree, kidsOf(fc.c.tree, pnodes[i])[0])
    let pname = fc.c.source[pn.span.start:pn.span.end]
    declareLocal(cfc, pname, paramIds[i], ft.members[i])
    fc.c.env[pname] = ft.members[i]
    i = i + 1
  }
  // Unpack captures from the env object (field_get word i). A boxed capture's slot
  // holds the CELL POINTER, and the body keeps it boxed: that is what makes a write
  // in here land in the cell the enclosing frame and every sibling closure read.
  let slotTypes = captureSlotTypes(caps)
  i = 0
  while (i < len(caps.names)) {
    let fg = mkInstr(Op.FieldGet, slotTypes[i])
    fg.lhs = envParam
    fg.ival = layout.offsets[i]
    declareLocalRaw(cfc, caps.names[i], builderEmit(b, fg), caps.types[i], caps.boxTys[i])
    fc.c.env[caps.names[i]] = caps.types[i]
    i = i + 1
  }
  let body = k[1]
  if (getNode(fc.c.tree, body).tag == Tag.Block) {
    // Reserve every defer's flag+operand slots at function entry, same as an
    // ordinary function body (#2378) — a closure lowers under its own FnCtx
    // and owns its own defers, replayed at ITS OWN return below.
    deferPreScan(cfc, body)
    lowerStmtList(cfc, body)
    if (!cfc.terminated) {
      // Mirror lowerFuncNamed's fall-through epilogue: a closure body that
      // falls off the end owes its own defers the same as an explicit
      // `return` does (lowerStmt's ReturnStmt path already calls this). A
      // closure has no @naked attribute and cfc.fallibleErr is always 0
      // (see FnCtx construction above), so neither the isNaked guard nor
      // the clearErr call applies here.
      runDefers(cfc)
      builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
    }
  } else {
    let v = lowerExprH(cfc, body, ft.result)
    let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
    rt.args = [v]
    builderEmit(b, rt)
  }
  builderEndBlock(b)
  if (cfc.failed) {
    // The closure body's own failure names the actual construct; propagate it
    // rather than losing the span behind a generic "closure failed" note.
    fcFail(fc, cfc.failSpan, cfc.failReason)
  }
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "closure\$${fid}", paramTypes: allParams, result: ft.result, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  return fid
}

// Lowers an arrow function `(params) => body` to a closure: captures every
// in-scope local not shadowed by its own params (innermost first, the seed's
// order), packs them into a gc_alloc'd env (nil when none), synthesizes the
// closure body, and wraps them with `make_closure`.
fn lowerArrowFn(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let closureTy = nodeType(fc, node)
  let ownNames = []string(0)
  let pnodes = kidsOf(fc.c.tree, k[0])
  let pi = 0
  while (pi < len(pnodes)) {
    let pn = getNode(fc.c.tree, kidsOf(fc.c.tree, pnodes[pi])[0])
    ownNames = append(ownNames, fc.c.source[pn.span.start:pn.span.end])
    pi = pi + 1
  }
  // A boxed local contributes its CELL POINTER, not its value (§12.8): that is the
  // one word both sides share, and packing the value instead is what made the
  // capture a snapshot.
  let caps = newCaptureSet()
  let i = len(fc.env) - 1
  while (i >= 0) {
    let bd = fc.env[i]
    if (!stringInList(ownNames, bd.name) && !stringInList(caps.names, bd.name)) {
      caps.names = append(caps.names, bd.name)
      caps.types = append(caps.types, bd.ty)
      caps.boxTys = append(caps.boxTys, bd.boxTy)
      caps.values = append(caps.values, bd.value)
    }
    i = i - 1
  }
  let layout = layoutFields(fc, captureSlotTypes(caps))
  let envObj = 0
  if (len(caps.names) == 0) {
    envObj = builderEmit(fc.b, mkInstr(Op.ConstNil, closureTy))
  } else {
    let ga = mkInstr(Op.GcAlloc, closureTy)
    ga.ival = layout.size
    ga.offsets = layout.ptrOffsets
    envObj = builderEmit(fc.b, ga)
    let ci = 0
    while (ci < len(caps.names)) {
      let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
      fs.lhs = envObj
      fs.ival = layout.offsets[ci]
      fs.rhs = caps.values[ci]
      builderEmit(fc.b, fs)
      ci = ci + 1
    }
  }
  let fid = lowerClosureBody(fc, node, closureTy, caps, layout)
  if (fc.failed) {
    return 0
  }
  let mc = mkInstr(Op.MakeClosure, closureTy)
  mc.name = "closure\$${fid}"
  mc.lhs = envObj
  return builderEmit(fc.b, mc)
}

// Synthesizes a spawn thunk trampoline `spawn$trampoline$<fid>(env)`: it reads
// each packed argument from the env object and calls the target function, then
// returns (a task yields nothing). Returns the FuncId.
fn synthSpawnTrampoline(fc: FnCtx, targetName: string, paramTypes: []int, result: int, fty: int, layout: StructLayout): int {
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  builderAddParam(b, fty)
  let envParam = 0
  let callArgs = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    let fg = mkInstr(Op.FieldGet, paramTypes[i])
    fg.lhs = envParam
    fg.ival = layout.offsets[i]
    callArgs = append(callArgs, builderEmit(b, fg))
    i = i + 1
  }
  let call = mkInstr(Op.Call, result)
  call.name = targetName
  call.args = callArgs
  builderEmit(b, call)
  builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
  builderEndBlock(b)
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "spawn\$trampoline\$${fid}", paramTypes: [fty], result: fc.c.ctx.voidId, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  return fid
}

// Lowers `spawn f(args)` for a direct named function: pack the args (typed by the
// callee's parameters) into a gc_alloc'd thunk, then `spawn(func_addr trampoline,
// thunk)`. Closure/method spawn targets are out of scope.
fn lowerSpawn(fc: FnCtx, node: int) {
  let call = kidsOf(fc.c.tree, node)[0]
  let ck = kidsOf(fc.c.tree, call)
  let callee = getNode(fc.c.tree, ck[0])
  if (callee.tag != Tag.Ident) {
    fcFail(fc, callee.span, "a `spawn` whose target is not a plain function name")
    return
  }
  let targetName = fc.c.source[callee.span.start:callee.span.end]
  let fty = nodeType(fc, ck[0])
  if (fty == 0 || fc.c.ctx.types[fty].kind != TypeKind.Func) {
    fcFail(fc, callee.span, "a `spawn` target that does not resolve to a function")
    return
  }
  // `spawn` packs one thunk slot per declared parameter, so a variadic callee
  // would need its tail collected into a `[]T` first. Refuse explicitly: an
  // arity-only guard would let `spawn f(x)` against `...xs: T` through, and the
  // thunk would then hand the callee a scalar where it binds a slice.
  if (fc.c.ctx.types[fty].variadic) {
    fcFail(fc, callee.span, "a `spawn` of a variadic function")
    return
  }
  // Resolve the callee the way a direct call does. Reading the signature off
  // `fty` instead yields the TEMPLATE members for a generic callee, and the
  // thunk layout below derives `ptr_offsets` from these types — an unsubstituted
  // `T` is a GC reference, so the collector would walk a packed int as a pointer.
  let t = resolveCallTarget(fc, targetName, call)
  if (!t.ok) {
    fcFail(fc, callee.span, "a `spawn` whose target could not be resolved")
    return
  }
  let paramTypes = t.paramTypes
  let result = t.result
  // The thunk object's type, and the trampoline's env parameter. Interned from
  // the RESOLVED signature, not taken from `fty`: for a generic callee `fty` is
  // the unbound template, so the emitted IR carried `fn(<T>, chan<<T>>)`. For
  // every non-generic spawn this interns to precisely `fty` again.
  let envTy = mkFunc(fc.c.ctx, paramTypes, false, result)
  let argVals = lowerArgs(fc, call, paramTypes)
  if (fc.failed) {
    return
  }
  let layout = layoutFields(fc, paramTypes)
  let ga = mkInstr(Op.GcAlloc, envTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let thunk = builderEmit(fc.b, ga)
  let i = 0
  while (i < len(argVals)) {
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = thunk
    fs.ival = layout.offsets[i]
    fs.rhs = argVals[i]
    builderEmit(fc.b, fs)
    i = i + 1
  }
  let fid = synthSpawnTrampoline(fc, t.symbol, paramTypes, result, envTy, layout)
  let fa = mkInstr(Op.FuncAddr, envTy)
  fa.name = "spawn\$trampoline\$${fid}"
  let faV = builderEmit(fc.b, fa)
  let sp = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  sp.name = "spawn"
  sp.args = [faV, thunk]
  emitRtCall(fc, sp)
}

// Lowers an uncalled interface method value `iface.m`: a closure over the
// interface receiver plus a synthesized `ifacemethod$trampoline$<fid>(recv, args)`
// that dispatches dynamically via call_iface.
// A concrete class method taken as a value, `v.m` (§11.10): a closure whose
// environment IS the receiver and whose code IS the method itself.
//
// No trampoline is synthesized, unlike the interface (`lowerIfaceMethodValue`)
// and bare-function (`fnValueTrampoline`) cases. A method's ABI already takes
// its receiver as the leading parameter, which is exactly the closure calling
// convention `(env, args...)` — so the method's own symbol is directly
// call-compatible with `call_value`. Mirrors seed `lowerMember`.
//
// Reached only when the member named no field, so a miss here (`m` is neither
// field nor method) is the genuine failure the caller used to report directly.
fn lowerStructMethodValue(fc: FnCtx, node: int, recvTy: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let mn = getNode(fc.c.tree, kids[1])
  let mname = fc.c.source[mn.span.start:mn.span.end]
  let fnTy = methodSigLookup(fc.c, "${recvTy}.${mname}")
  if (fnTy == 0) {
    fcFail(fc, mn.span, "a member access that is neither a field nor a method")
    return 0
  }
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let mc = mkInstr(Op.MakeClosure, fnTy)
  mc.name = methodSymbol(fc.lowerer, mname, recvTy)
  mc.lhs = recvV
  return builderEmit(fc.b, mc)
}
