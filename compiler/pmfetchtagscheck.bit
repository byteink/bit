// compiler/pmfetchtagscheck.bit — in-Bit self-checks for #4472: a package
// resolved through a vanity document that names a `dir` field (SPEC §17.7)
// reads its versions out of its OWN `<key>/` git-tag namespace, and never
// out of the bare one that belongs to the host repository's own releases.
//
// Sibling of pmfetchtags.bit / pmfetchresolve.bit / pmfetchresolvecheck.bit
// in the same module, so `TagRemote`, `listVersions`, `resolveAddRef`,
// `resolveDependencyRef`, `pmGitMustSucceed`, `pmCheckScratchDir`,
// `pmCheckTimeoutMs`, `pmTagRemote` and `pmBuildFixture` are all visible
// unqualified and are NOT re-imported (a module's imports are shared across
// its files; a second import of a name the module already has is E0042).
// `checkPmfetchTags()` is called from `checkPmfetch()` (pmfetchcheck.bit).
//
// The fixture is a real `git init`'d repository under a scratch temp
// directory, reached over `file://` — no network, exactly like every other
// git-backed check in this module.
//
// WHY THE DECOY IS THE POINT. The fixture carries a bare `v9.9.9` tag on a
// commit of its own. That is not filler: it is the exact shape of the
// compiler's own release tag sitting on the very repository a first-party
// package lives in (`git tag -l 'v0.1.0'` on this repo already matches), and
// it is the highest version in the repository by a wide margin. Every
// assertion below that names a `web/` version would pass just as happily
// against a resolver that had no namespace at all — EXCEPT when 9.9.9 is
// reachable, which is why the bare-`bit add` case (highest available version,
// no constraint at all) is here: without the prefix it selects 9.9.9, and
// `bit add bitlang.org/pkg/web` would pin the consumer to the compiler's
// release.
//
// ANTI-VACUITY: the three commits are asserted PAIRWISE DISTINCT before any
// sha comparison is trusted. A one-commit fixture makes "resolved to
// web/v0.1.0's sha" true no matter which tag the resolver picked.

// The fixture's three tagged commits, and the url they are reached at.
class PmTagFixture {
  url: string,
  shaDecoy: string,
  sha010: string,
  sha015: string,
  sha020: string,
}

// One more commit on top of `dir`'s HEAD, returning its sha. Each call
// writes a distinct file so the tree really changes and git cannot dedupe
// the commit.
fn pmTagCommit(dir: string, n: int): string {
  writeFile(dir + "/step${n}.txt", "step ${n}\n") catch e {
    panic("pmfetchtagscheck: cannot write fixture file: " + e.message())
  }
  let add = runGit(defaultGitBin, ["-C", dir, "add", "step${n}.txt"], pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: git add failed: " + e.message())
  }
  pmGitMustSucceed("add step${n}", add)
  let commit = runGit(
    defaultGitBin,
    ["-C", dir, "commit", "--quiet", "-m", "pmfetchtagscheck step ${n}"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git commit failed: " + e.message())
  }
  pmGitMustSucceed("commit step${n}", commit)
  return revParseHead(defaultGitBin, dir, pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: cannot read fixture HEAD: " + e.message())
  }
}

// A LIGHTWEIGHT tag at `sha`, written through `update-ref` rather than
// `git tag`: this fleet sets `tag.gpgsign true`, which makes a bare
// `git tag` fail with "no tag message?" (the same technique, and the same
// reason, as `checkPmfetchListVersionsMixedTagsAndSpellings`).
fn pmTagRef(dir: string, name: string, sha: string) {
  let r = runGit(
    defaultGitBin,
    ["-C", dir, "update-ref", "refs/tags/" + name, sha],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git update-ref ${name} failed: " + e.message())
  }
  pmGitMustSucceed("update-ref ${name}", r)
}

// Four tags over four distinct commits:
//
//   v9.9.9       the DECOY — the host repository's own release, bare
//                namespace, and the highest version present
//   web/v0.1.0   ANNOTATED, so the peeling path (#2064) is exercised on a
//                namespaced tag too, not only on a bare one
//   web/v0.1.5   lightweight; the highest inside `^0.1.0`/`~0.1.0`
//   web/v0.2.0   lightweight; outside `^0.1.0` (SPEC §17.7: below 1.0.0 the
//                caret's breaking boundary is MINOR), the highest overall in
//                the package's own namespace
fn pmBuildTagFixture(root: string): PmTagFixture {
  let fx = pmBuildFixture(root)
  let shaDecoy = fx.sha
  pmTagRef(fx.dir, "v9.9.9", shaDecoy)

  let sha010 = pmTagCommit(fx.dir, 1)
  let ann = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "web/v0.1.0", sha010, "-m", "web v0.1.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git tag -a web/v0.1.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag -a web/v0.1.0", ann)

  let sha015 = pmTagCommit(fx.dir, 2)
  pmTagRef(fx.dir, "web/v0.1.5", sha015)

  let sha020 = pmTagCommit(fx.dir, 3)
  pmTagRef(fx.dir, "web/v0.2.0", sha020)

  // Anti-vacuity: every sha assertion below is only meaningful because the
  // four tags name four DIFFERENT commits.
  assert(shaDecoy != sha010)
  assert(shaDecoy != sha015)
  assert(shaDecoy != sha020)
  assert(sha010 != sha015)
  assert(sha010 != sha020)
  assert(sha015 != sha020)

  return PmTagFixture{
    url: "file://" + fx.dir,
    shaDecoy: shaDecoy,
    sha010: sha010,
    sha015: sha015,
    sha020: sha020,
  }
}

fn pmDeadAddRef(): AddRefResolution {
  return AddRefResolution{ fetchRef: "", writtenRef: "", resolvedVersion: "" }
}

// `resolveAddRef` on a fixture, panicking with the resolver's own message
// rather than a bare assert (`pmGitMustSucceed`'s rule: name what failed).
fn pmAddRefOk(r: TagRemote, rawRef: string, what: string): AddRefResolution {
  return resolveAddRef(r, true, rawRef) catch e {
    panic("pmfetchtagscheck: resolveAddRef(${what}) failed: " + e.message())
  }
}

// The commit a resolved `fetchRef` actually names, through the same
// `resolveDependencyRef` the fetch itself uses — so a wrong tag cannot pass
// by naming a version that happens to exist.
fn pmShaOfRef(url: string, ref: string): string {
  return resolveDependencyRef(defaultGitBin, url, ref, pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: resolveDependencyRef(${ref}) failed: " + e.message())
  }
}

// #4472: `listVersions` under `web/` sees the package's three versions and
// not the decoy; under "" it sees the decoy and not the package's — the two
// directions that make each other non-vacuous.
fn checkPmTagsListVersionsNamespaced() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)

  let pkg = listVersions(pmTagRemote(fx.url, "web/")) catch e {
    panic("pmfetchtagscheck: listVersions(web/) failed: " + e.message())
  }
  assert(len(pkg) == 3)
  assert(versionEq(pkg[0], Version{ major: 0, minor: 2, patch: 0 }))
  assert(versionEq(pkg[1], Version{ major: 0, minor: 1, patch: 5 }))
  assert(versionEq(pkg[2], Version{ major: 0, minor: 1, patch: 0 }))

  let bare = listVersions(pmTagRemote(fx.url, "")) catch e {
    panic("pmfetchtagscheck: listVersions() failed: " + e.message())
  }
  assert(len(bare) == 1)
  assert(versionEq(bare[0], Version{ major: 9, minor: 9, patch: 9 }))

  removeTree(root, pmCheckTimeoutMs)
}

// #4472: the consumer spelling. `@v0.1.0` written in bit.json resolves the
// repository tag `web/v0.1.0` and that tag's own commit — and `bit.json`
// still keeps the plain `0.1.0` it was written with (`writtenRef`).
fn checkPmTagsExactRefResolvesNamespacedTag() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let picked = pmAddRefOk(r, "v0.1.0", "v0.1.0")
  assert(picked.fetchRef == "web/v0.1.0")
  assert(picked.writtenRef == "0.1.0")
  assert(picked.resolvedVersion == "0.1.0")
  assert(pmShaOfRef(fx.url, picked.fetchRef) == fx.sha010)

  // The `v`-less consumer spelling SPEC §17.7 writes into bit.json resolves
  // identically — the prefix is applied to the version, not to the spelling.
  let bareSpelling = pmAddRefOk(r, "0.1.0", "0.1.0")
  assert(bareSpelling.fetchRef == "web/v0.1.0")
  assert(pmShaOfRef(fx.url, bareSpelling.fetchRef) == fx.sha010)

  removeTree(root, pmCheckTimeoutMs)
}

// #4472: `^`/`~` search the package's namespace only, and respect SPEC
// §17.7's 0.x caret boundary — `^0.1.0` is `>=0.1.0 <0.2.0`, so it selects
// `web/v0.1.5` and NOT `web/v0.2.0`. `~0.1.0` is the same range below 1.0.0.
fn checkPmTagsRangeRefsStayInNamespace() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let caret = pmAddRefOk(r, "^0.1.0", "^0.1.0")
  assert(caret.fetchRef == "web/v0.1.5")
  assert(caret.writtenRef == "^0.1.0")
  assert(caret.resolvedVersion == "0.1.5")
  assert(pmShaOfRef(fx.url, caret.fetchRef) == fx.sha015)

  let tilde = pmAddRefOk(r, "~0.1.0", "~0.1.0")
  assert(tilde.fetchRef == "web/v0.1.5")
  assert(tilde.resolvedVersion == "0.1.5")
  assert(pmShaOfRef(fx.url, tilde.fetchRef) == fx.sha015)

  removeTree(root, pmCheckTimeoutMs)
}

// #4472, THE DECOY CASE: a bare `bit add bitlang.org/pkg/web` — no ref at
// all, "resolve the highest available version" — must select `web/v0.2.0`.
// The repository's highest version is 9.9.9; a resolver without the
// namespace pins the consumer to the compiler's own release, which is the
// failure this whole ticket exists to prevent.
fn checkPmTagsBareAddNeverPicksTheDecoy() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)

  let picked = resolveAddRef(pmTagRemote(fx.url, "web/"), false, "") catch e {
    panic("pmfetchtagscheck: bare resolveAddRef failed: " + e.message())
  }
  assert(picked.fetchRef == "web/v0.2.0")
  assert(picked.resolvedVersion == "0.2.0")
  assert(picked.writtenRef == "^0.2.0")
  assert(pmShaOfRef(fx.url, picked.fetchRef) == fx.sha020)
  assert(pmShaOfRef(fx.url, picked.fetchRef) != fx.shaDecoy)

  // The control, on the SAME repository: with no prefix the same bare add
  // does select 9.9.9. That is what makes the assertion above a statement
  // about the namespace rather than about this fixture's tag list.
  let noPrefix = resolveAddRef(pmTagRemote(fx.url, ""), false, "") catch e {
    panic("pmfetchtagscheck: bare resolveAddRef (no prefix) failed: " + e.message())
  }
  assert(noPrefix.fetchRef == "v9.9.9")
  assert(noPrefix.resolvedVersion == "9.9.9")
  assert(pmShaOfRef(fx.url, noPrefix.fetchRef) == fx.shaDecoy)

  removeTree(root, pmCheckTimeoutMs)
}

// #4472 control: a dependency whose document names NO `dir` is unchanged.
// The bare tag resolves, and the package's namespaced tags are invisible to
// it — `@v0.1.0` fails even though `web/v0.1.0` exists on this repository.
fn checkPmTagsNoDirDependencyUnchanged() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "")

  let decoy = pmAddRefOk(r, "v9.9.9", "v9.9.9")
  assert(decoy.fetchRef == "v9.9.9")
  assert(decoy.resolvedVersion == "9.9.9")
  assert(pmShaOfRef(fx.url, decoy.fetchRef) == fx.shaDecoy)

  let failed = false
  let msg = ""
  let hidden = resolveAddRef(r, true, "v0.1.0") catch e {
    failed = true
    msg = e.message()
    pmDeadAddRef()
  }
  assert(failed)
  assert(len(hidden.fetchRef) == 0)
  assert(contains(msg, "no tag v0.1.0 in "))
  // ... and it must NOT have reached into the package's namespace to find it.
  assert(!contains(msg, "web/"))

  removeTree(root, pmCheckTimeoutMs)
}

// #4472: a version the package does not publish fails naming the tag it
// looked for, PREFIX INCLUDED — the one part of the mapping a consumer who
// wrote `@v0.3.0` cannot see from their own bit.json. The bare spelling must
// not appear, or the message sends them looking for a tag that would be the
// host repository's release if it existed.
fn checkPmTagsMissingVersionNamesPrefixedTag() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let failedExact = false
  let exactMsg = ""
  let e1 = resolveAddRef(r, true, "v0.3.0") catch e {
    failedExact = true
    exactMsg = e.message()
    pmDeadAddRef()
  }
  assert(failedExact)
  assert(len(e1.fetchRef) == 0)
  assert(contains(exactMsg, "no tag web/v0.3.0 in "))
  assert(contains(exactMsg, fx.url))
  assert(!contains(exactMsg, "no tag v0.3.0"))

  // A range names no single tag, so it names the namespace it searched and
  // the range it searched for — still prefixed.
  let failedRange = false
  let rangeMsg = ""
  let e2 = resolveAddRef(r, true, "^0.5.0") catch e {
    failedRange = true
    rangeMsg = e.message()
    pmDeadAddRef()
  }
  assert(failedRange)
  assert(len(e2.fetchRef) == 0)
  assert(contains(rangeMsg, "no web/v* tag matching ^0.5.0 in "))

  removeTree(root, pmCheckTimeoutMs)
}

// #4472: the prefix derivation itself (`vanityTagPrefix`, pmcli.bit) — a
// document with no `dir` yields no namespace, one with a `dir` yields the
// vanity name's trailing segment. Derived from the NAME, never from the
// bit.json key, so a locally renamed dependency still reads the package's
// own tags.
fn checkPmTagsVanityPrefixDerivation() {
  assert(vanityTagPrefix("bitlang.org/pkg/web", "") == "")
  assert(vanityTagPrefix("bitlang.org/pkg/web", "pkg/web") == "web/")
  assert(vanityTagPrefix("bitlang.org/pkg/redis", "pkg/redis") == "redis/")
  assert(vanityTagPrefix("example.com/thing", "sub/dir") == "thing/")
}

// --- #4481: the TRANSITIVE walk's own ref resolution ---------------------

// Filler for a `(string, string)`-typed `catch` block whose error path a
// check treats as the expected outcome — the tuple counterpart of
// `pmDeadAddRef` above.
fn pmDeadTransRef(): (string, string) {
  return "", ""
}

// `resolveTransitiveRefSha` (pmztrans.bit) on a fixture, panicking with the
// resolver's own message rather than a bare assert (`pmGitMustSucceed`'s
// rule: name what failed).
fn pmTransRefOk(r: TagRemote, ref: string, what: string): (string, string) {
  return resolveTransitiveRefSha(r, ref) catch e {
    panic("pmfetchtagscheck: resolveTransitiveRefSha(${what}) failed: " + e.message())
  }
}

// The message `resolveTransitiveRefSha` FAILS with. A success here is a
// silent pass otherwise — the caller only looks at the message — so it is a
// loud panic naming the resolution that should not have happened.
fn pmTransRefErr(r: TagRemote, ref: string): string {
  let msg = ""
  let (tag, sha) = resolveTransitiveRefSha(r, ref) catch e {
    msg = e.message()
    pmDeadTransRef()
  }
  if (len(msg) == 0) {
    panic("pmfetchtagscheck: resolveTransitiveRefSha(${ref}) unexpectedly resolved '${tag}' -> ${sha}")
  }
  return msg
}

// The message a RAW `resolveDependencyRef` fails with — the call
// `resolveTransitiveSpec` made for every ref before #4481. Same
// anti-vacuity panic as `pmTransRefErr`.
fn pmRawRefErr(url: string, ref: string): string {
  let msg = ""
  let sha = resolveDependencyRef(defaultGitBin, url, ref, pmCheckTimeoutMs) catch e {
    msg = e.message()
    ""
  }
  if (len(msg) == 0) {
    panic("pmfetchtagscheck: resolveDependencyRef(${ref}) unexpectedly resolved to ${sha}")
  }
  return msg
}

// #4481: a version requirement spelled the way SPEC §17.7 and `bit add`
// itself write one into a manifest — BARE `0.1.0`, no `v` — resolves the
// repository's `web/v0.1.0` tag, and reports that tag so `bit.lock`'s `tag`
// field (#4472) can record it instead of "".
//
// The two controls are what make this a statement about the fix rather than
// about the fixture. `resolveDependencyRef` on the same repository and the
// same ref — the call the transitive walk made before #4481 — FAILS on both
// spellings, so the pre-fix path provably could not resolve this
// requirement at all; and the same ref against an EMPTY namespace fails
// too, so it is the prefix that finds the tag.
fn checkPmTagsTransitiveVersionRefResolvesNamespacedTag() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let (bareTag, bareSha) = pmTransRefOk(r, "0.1.0", "0.1.0")
  assert(bareTag == "web/v0.1.0")
  assert(bareSha == fx.sha010)
  assert(bareSha != fx.shaDecoy)

  let (vTag, vSha) = pmTransRefOk(r, "v0.1.0", "v0.1.0")
  assert(vTag == "web/v0.1.0")
  assert(vSha == fx.sha010)

  // Control 1: the pre-#4481 call, on the same repository and the same ref
  // the manifest wrote. It cannot resolve this requirement at all.
  assert(contains(pmRawRefErr(fx.url, "0.1.0"), "no ref '0.1.0'"))
  // Control 2: the namespace is what finds the tag. An empty prefix looks
  // for `v0.1.0` then `0.1.0`, neither of which this repository has, and
  // says so naming BOTH spellings it looked for (#4490).
  assert(contains(pmTransRefErr(pmTagRemote(fx.url, ""), "0.1.0"), "no tag v0.1.0 or 0.1.0 in "))

  removeTree(root, pmCheckTimeoutMs)
}

// #4481 part (1), with no namespace in play at all: the host repository
// tags `v9.9.9`, and a requirement written `@9.9.9` — SPEC's own spelling —
// must match it. This is the half of the ticket that has nothing to do with
// `dir` packages: before the fix a bare-spelled version was queried as a
// literal git ref, so only a repository that tagged bare could ever satisfy
// a transitive version requirement.
//
// And the namespace is a fence in BOTH directions, which is what stops
// either assertion being true by accident: the package's own namespace
// cannot see the host repository's release, and the bare namespace cannot
// see the package's versions.
fn checkPmTagsTransitiveRefRespectsTheNamespace() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)

  let (decoyTag, decoySha) = pmTransRefOk(pmTagRemote(fx.url, ""), "9.9.9", "9.9.9")
  assert(decoyTag == "v9.9.9")
  assert(decoySha == fx.shaDecoy)
  assert(contains(pmRawRefErr(fx.url, "9.9.9"), "no ref '9.9.9'"))

  // The host repository's own release is not a version of the package.
  assert(
    contains(
      pmTransRefErr(pmTagRemote(fx.url, "web/"), "9.9.9"),
      "no tag web/v9.9.9 or web/9.9.9 in ",
    ),
  )
  // ...and the package's versions are not releases of the host repository.
  // This one is load-bearing for `tagRefPath` (pmcliaddref.bit): without the
  // fully-qualified query, `git ls-remote <url> v0.2.0` matches
  // `refs/tags/web/v0.2.0` by tail, so this resolves instead of failing and
  // `pmTransRefErr`'s own anti-vacuity panic fires.
  assert(!contains(pmTransRefErr(pmTagRemote(fx.url, ""), "0.2.0"), "web/"))

  removeTree(root, pmCheckTimeoutMs)
}

// #4481 control: SPEC §17.7's other two ref forms are NOT versions and keep
// the verbatim passthrough, reporting no tag — the behaviour the fix must
// not have changed. Run against the NAMESPACED remote deliberately: a
// passthrough that had started applying the prefix would ask git for
// `web/main`, and a branch is not in any package's tag namespace.
fn checkPmTagsTransitiveNonVersionRefsPassThrough() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  // `main` is the fixture's branch, and `pmBuildTagFixture`'s last commit
  // (`web/v0.2.0`'s) is its tip.
  let (branchTag, branchSha) = pmTransRefOk(r, "main", "main")
  assert(len(branchTag) == 0)
  assert(branchSha == fx.sha020)

  let (shaTag, shaSha) = pmTransRefOk(r, fx.sha010, "bare sha")
  assert(len(shaTag) == 0)
  assert(shaSha == fx.sha010)
  assert(shaSha != fx.sha020)

  removeTree(root, pmCheckTimeoutMs)
}

// A repository carrying BOTH a first-party package's `web/v0.1.0` and its
// own release `v0.1.0` — the same version number in two namespaces, on two
// different commits. `web/v0.1.0` is ANNOTATED and `v0.1.0` LIGHTWEIGHT on
// purpose: `shaFromLsRemote` (pmfetchresolve.bit) prefers a PEELED line, so
// an ambiguous match resolves to the ANNOTATED one, which makes "the wrong
// side won" observable rather than a coin flip.
class PmCollidingTagFixture { url: string, shaPkg: string, shaHost: string }

fn pmBuildCollidingTagFixture(root: string): PmCollidingTagFixture {
  let fx = pmBuildFixture(root)
  let shaPkg = fx.sha
  let ann = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "web/v0.1.0", shaPkg, "-m", "web v0.1.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git tag -a web/v0.1.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag -a web/v0.1.0", ann)

  let shaHost = pmTagCommit(fx.dir, 1)
  pmTagRef(fx.dir, "v0.1.0", shaHost)
  assert(shaPkg != shaHost)

  return PmCollidingTagFixture{
    url: "file://" + fx.dir,
    shaPkg: shaPkg,
    shaHost: shaHost,
  }
}

// #4481 + `tagRefPath` (pmcliaddref.bit): when a repository carries the same
// version in two namespaces, each side resolves its OWN commit — and the
// unqualified query this replaced resolves the wrong one.
//
// `git ls-remote <url> <pattern>` matches the TAIL of a ref at a `/`
// boundary, so `v0.1.0` matches `refs/tags/web/v0.1.0` as well as
// `refs/tags/v0.1.0`. The third assertion below pins that git behaviour
// directly: asking for the host repository's own release by name comes back
// with the PACKAGE's commit. That is a silent wrong answer, not an error,
// and it is the reason the version resolver asks for `refs/tags/<tag>`.
fn checkPmTagsCollidingNamespacesResolveSeparately() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildCollidingTagFixture(root)

  let (pkgTag, pkgSha) = pmTransRefOk(pmTagRemote(fx.url, "web/"), "0.1.0", "web/ 0.1.0")
  assert(pkgTag == "web/v0.1.0")
  assert(pkgSha == fx.shaPkg)
  assert(pkgSha != fx.shaHost)

  let (hostTag, hostSha) = pmTransRefOk(pmTagRemote(fx.url, ""), "0.1.0", "bare 0.1.0")
  assert(hostTag == "v0.1.0")
  assert(hostSha == fx.shaHost)
  assert(hostSha != fx.shaPkg)

  // The git behaviour both of the above depend on being defended against.
  let loose = resolveDependencyRef(defaultGitBin, fx.url, "v0.1.0", pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: resolveDependencyRef(v0.1.0) failed: " + e.message())
  }
  assert(loose == fx.shaPkg)
  assert(loose != fx.shaHost)

  removeTree(root, pmCheckTimeoutMs)
}

// #4481: the VANITY branch's own wiring — `transitiveVanityRemote`
// (pmztrans.bit) is what `resolveTransitiveSpec` builds for a transitive
// requirement on a vanity name, out of the spec it parsed and the
// `bit-import:` document it resolved. Driven with a real `parseAddSpec`
// result and a hand-built `VanityDoc` rather than a hand-built `DepSpec`,
// so the `vanityName` the prefix is derived from is the one the parser
// actually produces.
//
// The assertion that matters is the RESOLUTION, not the prefix string: the
// prefix is fed straight into `resolveTransitiveRefSha` against the real
// fixture, so dropping it here selects nothing at all rather than quietly
// selecting the host repository's release. The no-`dir` row is the control
// that makes it a statement about `dir`.
fn checkPmTagsTransitiveVanityRemoteAppliesTheNamespace() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)

  let d = parseAddSpec("bitlang.org/pkg/web@0.1.0") catch e {
    panic("pmfetchtagscheck: parseAddSpec failed: " + e.message())
  }
  assert(d.vanity)
  assert(d.vanityName == "bitlang.org/pkg/web")
  assert(d.ref == "0.1.0")

  let withDir = transitiveVanityRemote(
    defaultGitBin,
    d,
    VanityDoc{ gitUrl: fx.url, dir: "pkg/web" },
    pmCheckTimeoutMs,
  )
  assert(withDir.prefix == "web/")
  assert(withDir.url == fx.url)
  let (tag, sha) = pmTransRefOk(withDir, d.ref, "vanity dir 0.1.0")
  assert(tag == "web/v0.1.0")
  assert(sha == fx.sha010)
  assert(sha != fx.shaDecoy)

  // Control: the same document with NO `dir` names the repository root as
  // the package, so there is no namespace and `0.1.0` is not a version this
  // repository publishes at all.
  let noDir = transitiveVanityRemote(
    defaultGitBin,
    d,
    VanityDoc{ gitUrl: fx.url, dir: "" },
    pmCheckTimeoutMs,
  )
  assert(len(noDir.prefix) == 0)
  assert(contains(pmTransRefErr(noDir, d.ref), "no tag v0.1.0 or 0.1.0 in "))

  removeTree(root, pmCheckTimeoutMs)
}

// The message `resolveVersionRefSha` (pmcliaddref.bit) FAILS with. A success
// here is a silent pass otherwise — the caller only looks at the message —
// so it is a loud panic naming the resolution that should not have happened,
// the same anti-vacuity shape as `pmTransRefErr` above.
fn pmVersionRefErr(r: TagRemote, v: Version): string {
  let msg = ""
  let (tag, sha) = resolveVersionRefSha(r, v) catch e {
    msg = e.message()
    pmDeadTransRef()
  }
  if (len(msg) == 0) {
    panic("pmfetchtagscheck: resolveVersionRefSha(${versionText(v)}) unexpectedly resolved '${tag}' -> ${sha}")
  }
  return msg
}

// #4490: when NEITHER spelling is on the remote, the failure names BOTH — the
// `v`-prefixed tag tried first and the bare fallback — each inside the
// package's own namespace. Before this, the first attempt was swallowed by a
// `catch _ { "" }` and only the FALLBACK's message propagated, so a consumer
// who wrote `@0.3.0` against a `dir` package was sent looking for a tag named
// `web/0.3.0` while the tag this resolver prefers, `web/v0.3.0`, was never
// mentioned.
//
// The un-prefixed control is what makes it a statement about the namespace
// and not about the fixture: neither name may appear without `web/`.
fn checkPmTagsMissingTagNamesBothSpellings() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildTagFixture(root)

  let msg = pmVersionRefErr(pmTagRemote(fx.url, "web/"), Version{ major: 0, minor: 3, patch: 0 })
  assert(contains(msg, "web/v0.3.0"))
  assert(contains(msg, "web/0.3.0"))
  assert(contains(msg, fx.url))
  assert(!contains(msg, "no tag v0.3.0"))
  assert(!contains(msg, "or 0.3.0"))

  removeTree(root, pmCheckTimeoutMs)
}

// #4490: a query that FAILED is not a tag that is ABSENT. There is no
// repository at this path at all, so `git ls-remote` exits 128 having written
// to stderr — the shape `lookupDependencyRef` (pmfetchresolve.bit)
// distinguishes from the empty-output absence signal git gives for a ref that
// merely does not exist.
//
// Both halves are load-bearing. The message must say the QUERY failed rather
// than that a tag is missing, and it must name the query that actually
// failed: the `v`-prefixed one, tried FIRST. The swallowing `catch` reported
// the bare fallback's failure on the same broken remote instead, so the ref
// named in the message was never the one that first went wrong.
fn checkPmTagsQueryFailureIsNotAMissingTag() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchtagscheck: cannot create scratch dir: " + e.message())
  }
  let missing = "file://" + root + "/no-such-repository.git"

  let msg = pmVersionRefErr(pmTagRemote(missing, "web/"), Version{ major: 0, minor: 1, patch: 0 })
  assert(contains(msg, "git ls-remote failed"))
  assert(!contains(msg, "no tag"))
  assert(contains(msg, "refs/tags/web/v0.1.0"))
  assert(!contains(msg, "refs/tags/web/0.1.0"))

  removeTree(root, pmCheckTimeoutMs)
}

fn checkPmfetchTags() {
  checkPmTagsVanityPrefixDerivation()
  checkPmTagsListVersionsNamespaced()
  checkPmTagsExactRefResolvesNamespacedTag()
  checkPmTagsRangeRefsStayInNamespace()
  checkPmTagsBareAddNeverPicksTheDecoy()
  checkPmTagsNoDirDependencyUnchanged()
  checkPmTagsMissingVersionNamesPrefixedTag()
  checkPmTagsMissingTagNamesBothSpellings()
  checkPmTagsQueryFailureIsNotAMissingTag()
  checkPmTagsTransitiveVersionRefResolvesNamespacedTag()
  checkPmTagsTransitiveRefRespectsTheNamespace()
  checkPmTagsTransitiveNonVersionRefsPassThrough()
  checkPmTagsCollidingNamespacesResolveSeparately()
  checkPmTagsTransitiveVanityRemoteAppliesTheNamespace()
}
