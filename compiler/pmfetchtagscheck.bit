// compiler/pmfetchtagscheck.bit — in-Bit self-checks for #4472: a package
// resolved through a vanity document that names a `dir` field (SPEC §17.7)
// reads its versions out of its OWN `<key>/` git-tag namespace, and never
// out of the bare one that belongs to the host repository's own releases.
//
// Sibling of pmfetchtags.bit / pmfetchresolve.bit / pmfetchresolvecheck.bit
// in the same module, so `TagRemote`, `listVersions`, `resolveAddRef`,
// `resolveDependencyRef`, `pmGitMustSucceed`, `pmCheckScratchDir`,
// `pmCheckTimeoutMs`, `pmTagRemote` and `pmBuildFixture` are all visible
// unqualified and are NOT re-imported (a module's imports are shared across
// its files; a second import of a name the module already has is E0042).
// `checkPmfetchTags()` is called from `checkPmfetch()` (pmfetchcheck.bit).
//
// The fixture is a real `git init`'d repository under a scratch temp
// directory, reached over `file://` — no network, exactly like every other
// git-backed check in this module.
//
// WHY THE DECOY IS THE POINT. The fixture carries a bare `v9.9.9` tag on a
// commit of its own. That is not filler: it is the exact shape of the
// compiler's own release tag sitting on the very repository a first-party
// package lives in (`git tag -l 'v0.1.0'` on this repo already matches), and
// it is the highest version in the repository by a wide margin. Every
// assertion below that names a `web/` version would pass just as happily
// against a resolver that had no namespace at all — EXCEPT when 9.9.9 is
// reachable, which is why the bare-`bit add` case (highest available version,
// no constraint at all) is here: without the prefix it selects 9.9.9, and
// `bit add bitlang.org/pkg/web` would pin the consumer to the compiler's
// release.
//
// ANTI-VACUITY: the three commits are asserted PAIRWISE DISTINCT before any
// sha comparison is trusted. A one-commit fixture makes "resolved to
// web/v0.1.0's sha" true no matter which tag the resolver picked.

// The fixture's three tagged commits, and the url they are reached at.
class PmTagFixture {
  url: string,
  shaDecoy: string,
  sha010: string,
  sha015: string,
  sha020: string,
}

// One more commit on top of `dir`'s HEAD, returning its sha. Each call
// writes a distinct file so the tree really changes and git cannot dedupe
// the commit.
fn pmTagCommit(dir: string, n: int): string {
  writeFile(dir + "/step${n}.txt", "step ${n}\n") catch e {
    panic("pmfetchtagscheck: cannot write fixture file: " + e.message())
  }
  let add = runGit(defaultGitBin, ["-C", dir, "add", "step${n}.txt"], pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: git add failed: " + e.message())
  }
  pmGitMustSucceed("add step${n}", add)
  let commit = runGit(
    defaultGitBin,
    ["-C", dir, "commit", "--quiet", "-m", "pmfetchtagscheck step ${n}"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git commit failed: " + e.message())
  }
  pmGitMustSucceed("commit step${n}", commit)
  return revParseHead(defaultGitBin, dir, pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: cannot read fixture HEAD: " + e.message())
  }
}

// A LIGHTWEIGHT tag at `sha`, written through `update-ref` rather than
// `git tag`: this fleet sets `tag.gpgsign true`, which makes a bare
// `git tag` fail with "no tag message?" (the same technique, and the same
// reason, as `checkPmfetchListVersionsMixedTagsAndSpellings`).
fn pmTagRef(dir: string, name: string, sha: string) {
  let r = runGit(
    defaultGitBin,
    ["-C", dir, "update-ref", "refs/tags/" + name, sha],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git update-ref ${name} failed: " + e.message())
  }
  pmGitMustSucceed("update-ref ${name}", r)
}

// Four tags over four distinct commits:
//
//   v9.9.9       the DECOY — the host repository's own release, bare
//                namespace, and the highest version present
//   web/v0.1.0   ANNOTATED, so the peeling path (#2064) is exercised on a
//                namespaced tag too, not only on a bare one
//   web/v0.1.5   lightweight; the highest inside `^0.1.0`/`~0.1.0`
//   web/v0.2.0   lightweight; outside `^0.1.0` (SPEC §17.7: below 1.0.0 the
//                caret's breaking boundary is MINOR), the highest overall in
//                the package's own namespace
fn pmBuildTagFixture(root: string): PmTagFixture {
  let fx = pmBuildFixture(root)
  let shaDecoy = fx.sha
  pmTagRef(fx.dir, "v9.9.9", shaDecoy)

  let sha010 = pmTagCommit(fx.dir, 1)
  let ann = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "web/v0.1.0", sha010, "-m", "web v0.1.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchtagscheck: git tag -a web/v0.1.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag -a web/v0.1.0", ann)

  let sha015 = pmTagCommit(fx.dir, 2)
  pmTagRef(fx.dir, "web/v0.1.5", sha015)

  let sha020 = pmTagCommit(fx.dir, 3)
  pmTagRef(fx.dir, "web/v0.2.0", sha020)

  // Anti-vacuity: every sha assertion below is only meaningful because the
  // four tags name four DIFFERENT commits.
  assert(shaDecoy != sha010)
  assert(shaDecoy != sha015)
  assert(shaDecoy != sha020)
  assert(sha010 != sha015)
  assert(sha010 != sha020)
  assert(sha015 != sha020)

  return PmTagFixture{
    url: "file://" + fx.dir,
    shaDecoy: shaDecoy,
    sha010: sha010,
    sha015: sha015,
    sha020: sha020,
  }
}

fn pmDeadAddRef(): AddRefResolution {
  return AddRefResolution{ fetchRef: "", writtenRef: "", resolvedVersion: "" }
}

// `resolveAddRef` on a fixture, panicking with the resolver's own message
// rather than a bare assert (`pmGitMustSucceed`'s rule: name what failed).
fn pmAddRefOk(r: TagRemote, rawRef: string, what: string): AddRefResolution {
  return resolveAddRef(r, true, rawRef) catch e {
    panic("pmfetchtagscheck: resolveAddRef(${what}) failed: " + e.message())
  }
}

// The commit a resolved `fetchRef` actually names, through the same
// `resolveDependencyRef` the fetch itself uses — so a wrong tag cannot pass
// by naming a version that happens to exist.
fn pmShaOfRef(url: string, ref: string): string {
  return resolveDependencyRef(defaultGitBin, url, ref, pmCheckTimeoutMs) catch e {
    panic("pmfetchtagscheck: resolveDependencyRef(${ref}) failed: " + e.message())
  }
}

// #4472: `listVersions` under `web/` sees the package's three versions and
// not the decoy; under "" it sees the decoy and not the package's — the two
// directions that make each other non-vacuous.
fn checkPmTagsListVersionsNamespaced() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("pmfetchtagscheck: cannot create scratch dir: " + e.message()) }
  let fx = pmBuildTagFixture(root)

  let pkg = listVersions(pmTagRemote(fx.url, "web/")) catch e {
    panic("pmfetchtagscheck: listVersions(web/) failed: " + e.message())
  }
  assert(len(pkg) == 3)
  assert(versionEq(pkg[0], Version{ major: 0, minor: 2, patch: 0 }))
  assert(versionEq(pkg[1], Version{ major: 0, minor: 1, patch: 5 }))
  assert(versionEq(pkg[2], Version{ major: 0, minor: 1, patch: 0 }))

  let bare = listVersions(pmTagRemote(fx.url, "")) catch e {
    panic("pmfetchtagscheck: listVersions() failed: " + e.message())
  }
  assert(len(bare) == 1)
  assert(versionEq(bare[0], Version{ major: 9, minor: 9, patch: 9 }))
}

// #4472: the consumer spelling. `@v0.1.0` written in bit.json resolves the
// repository tag `web/v0.1.0` and that tag's own commit — and `bit.json`
// still keeps the plain `0.1.0` it was written with (`writtenRef`).
fn checkPmTagsExactRefResolvesNamespacedTag() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("pmfetchtagscheck: cannot create scratch dir: " + e.message()) }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let picked = pmAddRefOk(r, "v0.1.0", "v0.1.0")
  assert(picked.fetchRef == "web/v0.1.0")
  assert(picked.writtenRef == "0.1.0")
  assert(picked.resolvedVersion == "0.1.0")
  assert(pmShaOfRef(fx.url, picked.fetchRef) == fx.sha010)

  // The `v`-less consumer spelling SPEC §17.7 writes into bit.json resolves
  // identically — the prefix is applied to the version, not to the spelling.
  let bareSpelling = pmAddRefOk(r, "0.1.0", "0.1.0")
  assert(bareSpelling.fetchRef == "web/v0.1.0")
  assert(pmShaOfRef(fx.url, bareSpelling.fetchRef) == fx.sha010)
}

// #4472: `^`/`~` search the package's namespace only, and respect SPEC
// §17.7's 0.x caret boundary — `^0.1.0` is `>=0.1.0 <0.2.0`, so it selects
// `web/v0.1.5` and NOT `web/v0.2.0`. `~0.1.0` is the same range below 1.0.0.
fn checkPmTagsRangeRefsStayInNamespace() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("pmfetchtagscheck: cannot create scratch dir: " + e.message()) }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let caret = pmAddRefOk(r, "^0.1.0", "^0.1.0")
  assert(caret.fetchRef == "web/v0.1.5")
  assert(caret.writtenRef == "^0.1.0")
  assert(caret.resolvedVersion == "0.1.5")
  assert(pmShaOfRef(fx.url, caret.fetchRef) == fx.sha015)

  let tilde = pmAddRefOk(r, "~0.1.0", "~0.1.0")
  assert(tilde.fetchRef == "web/v0.1.5")
  assert(tilde.resolvedVersion == "0.1.5")
  assert(pmShaOfRef(fx.url, tilde.fetchRef) == fx.sha015)
}

// #4472, THE DECOY CASE: a bare `bit add bitlang.org/pkg/web` — no ref at
// all, "resolve the highest available version" — must select `web/v0.2.0`.
// The repository's highest version is 9.9.9; a resolver without the
// namespace pins the consumer to the compiler's own release, which is the
// failure this whole ticket exists to prevent.
fn checkPmTagsBareAddNeverPicksTheDecoy() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("pmfetchtagscheck: cannot create scratch dir: " + e.message()) }
  let fx = pmBuildTagFixture(root)

  let picked = resolveAddRef(pmTagRemote(fx.url, "web/"), false, "") catch e {
    panic("pmfetchtagscheck: bare resolveAddRef failed: " + e.message())
  }
  assert(picked.fetchRef == "web/v0.2.0")
  assert(picked.resolvedVersion == "0.2.0")
  assert(picked.writtenRef == "^0.2.0")
  assert(pmShaOfRef(fx.url, picked.fetchRef) == fx.sha020)
  assert(pmShaOfRef(fx.url, picked.fetchRef) != fx.shaDecoy)

  // The control, on the SAME repository: with no prefix the same bare add
  // does select 9.9.9. That is what makes the assertion above a statement
  // about the namespace rather than about this fixture's tag list.
  let noPrefix = resolveAddRef(pmTagRemote(fx.url, ""), false, "") catch e {
    panic("pmfetchtagscheck: bare resolveAddRef (no prefix) failed: " + e.message())
  }
  assert(noPrefix.fetchRef == "v9.9.9")
  assert(noPrefix.resolvedVersion == "9.9.9")
  assert(pmShaOfRef(fx.url, noPrefix.fetchRef) == fx.shaDecoy)
}

// #4472 control: a dependency whose document names NO `dir` is unchanged.
// The bare tag resolves, and the package's namespaced tags are invisible to
// it — `@v0.1.0` fails even though `web/v0.1.0` exists on this repository.
fn checkPmTagsNoDirDependencyUnchanged() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("pmfetchtagscheck: cannot create scratch dir: " + e.message()) }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "")

  let decoy = pmAddRefOk(r, "v9.9.9", "v9.9.9")
  assert(decoy.fetchRef == "v9.9.9")
  assert(decoy.resolvedVersion == "9.9.9")
  assert(pmShaOfRef(fx.url, decoy.fetchRef) == fx.shaDecoy)

  let failed = false
  let msg = ""
  let hidden = resolveAddRef(r, true, "v0.1.0") catch e {
    failed = true
    msg = e.message()
    pmDeadAddRef()
  }
  assert(failed)
  assert(len(hidden.fetchRef) == 0)
  assert(contains(msg, "no tag v0.1.0 in "))
  // ... and it must NOT have reached into the package's namespace to find it.
  assert(!contains(msg, "web/"))
}

// #4472: a version the package does not publish fails naming the tag it
// looked for, PREFIX INCLUDED — the one part of the mapping a consumer who
// wrote `@v0.3.0` cannot see from their own bit.json. The bare spelling must
// not appear, or the message sends them looking for a tag that would be the
// host repository's release if it existed.
fn checkPmTagsMissingVersionNamesPrefixedTag() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("pmfetchtagscheck: cannot create scratch dir: " + e.message()) }
  let fx = pmBuildTagFixture(root)
  let r = pmTagRemote(fx.url, "web/")

  let failedExact = false
  let exactMsg = ""
  let e1 = resolveAddRef(r, true, "v0.3.0") catch e {
    failedExact = true
    exactMsg = e.message()
    pmDeadAddRef()
  }
  assert(failedExact)
  assert(len(e1.fetchRef) == 0)
  assert(contains(exactMsg, "no tag web/v0.3.0 in "))
  assert(contains(exactMsg, fx.url))
  assert(!contains(exactMsg, "no tag v0.3.0"))

  // A range names no single tag, so it names the namespace it searched and
  // the range it searched for — still prefixed.
  let failedRange = false
  let rangeMsg = ""
  let e2 = resolveAddRef(r, true, "^0.5.0") catch e {
    failedRange = true
    rangeMsg = e.message()
    pmDeadAddRef()
  }
  assert(failedRange)
  assert(len(e2.fetchRef) == 0)
  assert(contains(rangeMsg, "no web/v* tag matching ^0.5.0 in "))
}

// #4472: the prefix derivation itself (`vanityTagPrefix`, pmcli.bit) — a
// document with no `dir` yields no namespace, one with a `dir` yields the
// vanity name's trailing segment. Derived from the NAME, never from the
// bit.json key, so a locally renamed dependency still reads the package's
// own tags.
fn checkPmTagsVanityPrefixDerivation() {
  assert(vanityTagPrefix("bitlang.org/pkg/web", "") == "")
  assert(vanityTagPrefix("bitlang.org/pkg/web", "pkg/web") == "web/")
  assert(vanityTagPrefix("bitlang.org/pkg/redis", "pkg/redis") == "redis/")
  assert(vanityTagPrefix("example.com/thing", "sub/dir") == "thing/")
}

fn checkPmfetchTags() {
  checkPmTagsVanityPrefixDerivation()
  checkPmTagsListVersionsNamespaced()
  checkPmTagsExactRefResolvesNamespacedTag()
  checkPmTagsRangeRefsStayInNamespace()
  checkPmTagsBareAddNeverPicksTheDecoy()
  checkPmTagsNoDirDependencyUnchanged()
  checkPmTagsMissingVersionNamesPrefixedTag()
}
