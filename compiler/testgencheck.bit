// Self-check for `bit test`'s discovery + dispatch contract (#1105, #3786).
//
// THE PROPERTY (#3786, SPEC §19): a test is a top-level, zero-parameter,
// no-return function declared in a `.test.bit` file — file plus shape, no
// name convention at all. The name list `injectTestMain` returns and the
// synthetic `main` it appends agree POSITIONALLY. BIT_TEST_INDEX `i` runs
// exactly the i-th such function of the ROOT module in source order, and the
// child's exit code is that test's verdict — 0 passed, 2 a panicking `assert`.
// Nothing else runs: not a parameterised or value-returning helper, not an
// identically-shaped function in a PLAIN `.bit` file, not an imported
// module's own test, and not the module's own `main`.
//
// Every assertion below is load-bearing against a specific way this check could
// pass while checking nothing:
//
//   - The runtime archive is ASSERTED, never `catch { return }`. The earlier
//     harness opened by returning early when the archive path was empty — a
//     silent green no-op, with no build-time signal that it fired.
//   - The FAILING test is checked for exactly 2, not `!= 0`. `osRunTestBounded`
//     returns -1 on spawn failure and -2 on timeout (ABI §19), both non-zero, so
//     `!= 0` also passes when the binary was never executed at all.
//   - Counts are asserted BEFORE the element-wise names. A name loop bounded by
//     `len(names)` is green on an empty list.
//   - The single-file fixture's own `main` is `assert(false)`. It must be
//     renamed, not run, so every index that exits 0 also proves the rename. The
//     earlier fixture had no `main` and never covered that path.
//   - Index 99 dispatches to nothing and must still exit 0 (§19), so an
//     out-of-range index is asserted as the ABI's harmless no-op rather than
//     left to mean "everything passes".
//   - One discovered name (`additionWorks`) deliberately does NOT start with
//     "test_" — proof that discovery reads the FILE, not a name prefix, since
//     the old rule would have silently dropped it.
//   - A PLAIN `.bit` file sitting beside the `.test.bit` fixture declares a
//     function of the identical test shape. Its presence in the lowered
//     module is asserted before its absence from the discovered names —
//     without that, "absent from names" would be satisfied just as well by a
//     fixture whose sibling file never loaded.
//   - The FIRST discovered test (index 0) is the one that panics, so a run
//     that reports the other two proves one-process-per-test rather than
//     merely proving indices 1 and 2 individually work.
//   - The project fixture's non-root module really does define a
//     same-shaped candidate, and its presence in the lowered module is
//     asserted before its absence from the discovered names — "root module
//     only" is otherwise quantified over an empty candidate set.
//
// Bounded spawns, never `osRunTest`: this is the first subprocess `bit
// selfcheck` runs and there is no per-check timeout around it, so a hung child
// would hang the whole gate rather than fail one case.
//
// EXPECTED NOISE. The children inherit this process's stderr and there is no
// output-capture primitive, so a passing run prints exactly four panic lines —
// `assertion failed`, `sum: got 6, want 7`, `nope`, `deliberate` — one per
// deliberately failing (or deliberately panicking) fixture test. They are the
// proof the children really ran; the verdict
// is the exit code and `selfcheck OK`, not the absence of stderr.

// The `.test.bit` fixture: three tests in source order (the FIRST one panics,
// deliberately — see checkTestgenFile), a parameterised helper, a
// value-returning helper, and a `main` that panics if it is ever the entry
// point. One test is named without a "test_" prefix at all, to prove
// discovery no longer reads the name.
fn testgenFixtureFile(): string {
  return "fn test_fails() {\n" +
    "  assert(1 == 2)\n" +
    "}\n\n" +
    "fn additionWorks() {\n" +
    "  assert(1 + 1 == 2)\n" +
    "}\n\n" +
    "fn test_also_passes() {\n" +
    "  assert(2 * 3 == 6)\n" +
    "}\n\n" +
    "fn helperWithParam(n: i64) {\n" +
    "  assert(n == n)\n" +
    "}\n\n" +
    "fn helperReturnsValue(): i64 {\n" +
    "  return 1\n" +
    "}\n\n" +
    "fn main() {\n" +
    "  assert(false)\n" +
    "}\n"
}

// The PLAIN `.bit` sibling: a function of the IDENTICAL test shape (zero
// parameters, no return) that must never be discovered, however perfectly it
// matches, because its own file does not end ".test.bit" (#3786).
fn testgenFixturePlainSibling(): string {
  return "fn wouldBeATestButPlainFile() {\n" + "  assert(false)\n" + "}\n"
}

// The project fixture's ROOT module: four tests over std/testing, plus a call
// into the sibling module so that module is really loaded and lowered.
fn testgenFixtureProjRoot(): string {
  return "import { eq, neq, ok, failNow } from \"std/testing\"\n" +
    "import { subHelper } from \"./sub\"\n\n" +
    "fn test_scalars() {\n" +
    "  eq<i64>(1 + 1, 2, \"sum\")\n" +
    "  neq<i64>(subHelper(), 5, \"sub\")\n" +
    "}\n\n" +
    "fn test_strings() {\n" +
    "  ok(len(\"abc\") == 3, \"len\")\n" +
    "}\n\n" +
    "fn test_fails_with_a_diff() {\n" +
    "  eq<i64>(6, 7, \"sum\")\n" +
    "}\n\n" +
    "fn test_fails_explicitly() {\n" +
    "  failNow(\"nope\")\n" +
    "}\n"
}

// The project fixture's NON-ROOT module. `test_notmine` is a genuine discovery
// candidate — same shape as a real test, exported, and present in the lowered
// module — that the root-module rule must reject.
fn testgenFixtureProjSub(): string {
  return "export fn subHelper(): i64 {\n" +
    "  return 7\n" +
    "}\n\n" +
    "export fn test_notmine() {\n" +
    "  assert(false)\n" +
    "}\n"
}

// A single-file fixture exercising `testpanic_` discovery and verdict
// inversion (#2839, SPEC §18.4): an ordinary `test_` pass sits beside a
// `testpanic_` that dies by panic (must PASS) and a `testpanic_` that
// returns normally (must FAIL) — the load-bearing middle case, since a
// silent discovery miss would make it simply never run rather than fail.
fn testgenFixturePanicFile(): string {
  return "fn test_ok() {\n" +
    "  assert(1 == 1)\n" +
    "}\n\n" +
    "fn testpanic_dies() {\n" +
    "  panic(\"deliberate\")\n" +
    "}\n\n" +
    "fn testpanic_survives() {\n" +
    "  assert(1 == 1)\n" +
    "}\n"
}

// Writes `content` to `path`, failing the check rather than the fixture.
fn testgenWrite(path: string, content: string) {
  writeFile(path, content) catch e {
    assert(false, "testgen check: cannot write ${path}: ${e.message()}")
  }
}

// Creates `path`, failing the check if it cannot be created.
fn testgenMkdir(path: string) {
  assert(fsMkdir(path) >= 0, "testgen check: cannot create ${path}")
}

// Whether the lowered module defines a function named exactly `name`.
fn testgenHasFunc(m: IrModule, name: string): bool {
  let i = 0
  while (i < len(m.funcs)) {
    if (m.funcs[i].name == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether any lowered function's name ends with `suffix`. Used to find a
// non-root module's function, which lowering renames to `m<id>$<name>`.
fn testgenHasFuncSuffix(m: IrModule, suffix: string): bool {
  let i = 0
  while (i < len(m.funcs)) {
    let n = m.funcs[i].name
    if (len(n) >= len(suffix) && n[len(n) - len(suffix):len(n)] == suffix) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether `names` contains `name`.
fn testgenNamesHave(names: []string, name: string): bool {
  let i = 0
  while (i < len(names)) {
    if (names[i] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// What `testgenBuild` produced: the discovered names in dispatch order and the
// lowered module they were discovered from. The module is kept so the rejection
// cases can assert what WAS a candidate, not just what came out.
class TestgenBuilt {
  names: []string,
  module: IrModule,
}

// Builds `src` for the host with the test `main` injected, asserting every step
// the way `testCmd` reports it, and leaves the executable at `bin`.
fn testgenBuild(src: string, bin: string, rt: []u8): TestgenBuilt {
  let m = buildIr(src, hostBuildTarget(), false, rt, true, true) catch e {
    assert(false, "testgen check: ${src}: ${e.message()}")
    return TestgenBuilt{
      names: []string(0),
      module: IrModule{ ctx: newTypeContext(), sm: newSourceManager() },
    }
  }
  // A stub lowers to a signature with no body, so a binary containing one runs
  // the wrong program; `testCmd` refuses to run tests in that case and so does
  // this check, rather than measure exit codes of something unlowered.
  assert(len(m.stubbed) == 0, "testgen check: ${src}: unlowered functions")
  // "" — this check never exercises `--run`, only the discovery+dispatch
  // contract, so `names` here is always the full discovered list.
  let names = injectTestMain(m, "").names
  assert(
    writeModuleExe(m, src, bin, hostBuildTarget(), rt, false, false),
    "testgen check: cannot build ${bin}",
  )
  return TestgenBuilt{ names: names, module: m }
}

// Per-test wall clock. Generous — the fixtures do arithmetic — because the
// bound exists to turn a hang into a failure, not to measure anything.
const testgenRunMs: int = 60000

// A single-file module: discovery order, per-index verdicts, and the rename.
fn checkTestgenFile(dir: string, rt: []u8) {
  // A directory (one module, #3786's white-box layout): the `.test.bit`
  // fixture plus a plain `.bit` sibling of the identical test shape.
  let root = "${dir}/case"
  let src = "${root}/case.test.bit"
  let sibling = "${root}/plain.bit"
  let bin = "${dir}/case.bin"
  testgenMkdir(root)
  testgenWrite(src, testgenFixtureFile())
  testgenWrite(sibling, testgenFixturePlainSibling())

  let built = testgenBuild(root, bin, rt)
  let names = built.names
  // The module's own `main` is RENAMED, not dropped and not left as the entry.
  assert(
    testgenHasFunc(built.module, "__bit_module_main"),
    "testgen check: module main was not renamed",
  )
  assert(!testgenNamesHave(names, "main"), "testgen check: main is not a test")
  // Count first: an element-wise loop over an empty list asserts nothing.
  assert(len(names) == 3, "testgen check: expected 3 tests")
  assert(
    names[0] == "test_fails",
    "testgen check: names[0] (the panicking one, deliberately first)",
  )
  assert(
    names[1] == "additionWorks",
    "testgen check: names[1] (no test_ prefix — file+shape is the rule)",
  )
  assert(names[2] == "test_also_passes", "testgen check: names[2]")
  // A parameterised helper and a value-returning helper are never tests
  // (#3786): the shape rule, not their name, excludes them.
  assert(
    !testgenNamesHave(names, "helperWithParam"),
    "testgen check: a parameter excludes a helper",
  )
  assert(
    !testgenNamesHave(names, "helperReturnsValue"),
    "testgen check: a return value excludes a helper",
  )
  // THE LOAD-BEARING CASE FOR #3786: an IDENTICAL zero-arg, no-return function,
  // same module (a directory is one module), but declared in a PLAIN `.bit`
  // file — never discovered, however perfectly it matches the test shape.
  // Presence asserted first: without it, "absent from names" would be
  // satisfied just as well by a fixture whose sibling file never loaded.
  assert(
    testgenHasFunc(built.module, "wouldBeATestButPlainFile"),
    "testgen check: fixture broken, the plain-file sibling was never lowered",
  )
  assert(
    !testgenNamesHave(names, "wouldBeATestButPlainFile"),
    "testgen check: a plain .bit file's zero-arg fn must never be discovered",
  )

  // Index 0 is the FIRST declared test and it panics — proving one process
  // per test: its failure must neither hide nor abort the other two.
  assert(osRunTestBounded(bin, 0, testgenRunMs) == 2, "testgen check: index 0 (first test) panics")
  assert(
    osRunTestBounded(bin, 1, testgenRunMs) == 0,
    "testgen check: index 1 still runs and passes",
  )
  assert(
    osRunTestBounded(bin, 2, testgenRunMs) == 0,
    "testgen check: index 2 still runs and passes",
  )
  // Out of range dispatches to nothing and exits cleanly (§19) — and, since the
  // fixture's own `main` panics, this also proves the rename took effect.
  assert(osRunTestBounded(bin, 99, testgenRunMs) == 0, "testgen check: index 99")

  remove(bin) catch println("testgen check: cleanup failed for ${bin}")
  remove(src) catch println("testgen check: cleanup failed for ${src}")
  remove(sibling) catch println("testgen check: cleanup failed for ${sibling}")
  remove(root) catch println("testgen check: cleanup failed for ${root}")
}

// A directory module: tests may import std/testing, and discovery covers the
// ROOT module only even when another module defines a real `test_*`.
fn checkTestgenProject(dir: string, rt: []u8) {
  let root = "${dir}/proj"
  let sub = "${root}/sub"
  testgenMkdir(root)
  testgenMkdir(sub)
  let rootSrc = "${root}/main.test.bit"
  let subSrc = "${sub}/sub.bit"
  let bin = "${dir}/proj.bin"
  testgenWrite(rootSrc, testgenFixtureProjRoot())
  testgenWrite(subSrc, testgenFixtureProjSub())

  let built = testgenBuild(root, bin, rt)
  let names = built.names
  assert(len(names) == 4, "testgen check: expected 4 project tests")
  assert(names[0] == "test_scalars", "testgen check: project names[0]")
  assert(names[1] == "test_strings", "testgen check: project names[1]")
  assert(names[2] == "test_fails_with_a_diff", "testgen check: project names[2]")
  assert(names[3] == "test_fails_explicitly", "testgen check: project names[3]")

  // The rejection is asserted over a candidate that is REALLY THERE: the sub
  // module lowers into this same module, `test_notmine` included, and discovery
  // still does not pick it up. Assert the presence FIRST — without it, "absent
  // from names" is satisfied by a fixture whose second module never loaded.
  assert(
    testgenHasFuncSuffix(built.module, "$test_notmine"),
    "testgen check: fixture broken, the non-root test was never lowered",
  )
  assert(
    !testgenNamesHave(names, "test_notmine"),
    "testgen check: a non-root module's test was discovered",
  )

  assert(osRunTestBounded(bin, 0, testgenRunMs) == 0, "testgen check: project index 0")
  assert(osRunTestBounded(bin, 1, testgenRunMs) == 0, "testgen check: project index 1")
  assert(osRunTestBounded(bin, 2, testgenRunMs) == 2, "testgen check: project index 2")
  assert(osRunTestBounded(bin, 3, testgenRunMs) == 2, "testgen check: project index 3")

  remove(bin) catch println("testgen check: cleanup failed for ${bin}")
  remove(subSrc) catch println("testgen check: cleanup failed for ${subSrc}")
  remove(rootSrc) catch println("testgen check: cleanup failed for ${rootSrc}")
  remove(sub) catch println("testgen check: cleanup failed for ${sub}")
  remove(root) catch println("testgen check: cleanup failed for ${root}")
}

// `testpanic_` discovery and verdict inversion (#2839). Discovery is proven
// by running the fixture's own child processes and reading their raw exit
// codes; the verdict RULE (`testVerdictPassed`, testgen.bit) is then checked
// directly against those codes, plus codes no real run should ever produce
// for a `testpanic_` name (an unrelated non-zero exit, a spawn failure, a
// timeout) so a `testpanic_` cannot "pass" for any reason but the runtime's
// own panic exit status.
fn checkTestgenPanic(dir: string, rt: []u8) {
  let src = "${dir}/panic.test.bit"
  let bin = "${dir}/panic.bin"
  testgenWrite(src, testgenFixturePanicFile())

  let built = testgenBuild(src, bin, rt)
  let names = built.names
  assert(len(names) == 3, "testgen check: expected 3 panic-fixture tests")
  assert(names[0] == "test_ok", "testgen check: panic fixture names[0]")
  assert(names[1] == "testpanic_dies", "testgen check: panic fixture names[1]")
  assert(names[2] == "testpanic_survives", "testgen check: panic fixture names[2]")

  let code0 = osRunTestBounded(bin, 0, testgenRunMs)
  let code1 = osRunTestBounded(bin, 1, testgenRunMs)
  let code2 = osRunTestBounded(bin, 2, testgenRunMs)
  assert(code0 == 0, "testgen check: panic fixture index 0 (ordinary pass)")
  assert(code1 == 2, "testgen check: panic fixture index 1 died by panic")
  assert(code2 == 0, "testgen check: panic fixture index 2 returned normally")

  assert(
    testVerdictPassed(names[0], code0),
    "testgen check: test_ok should pass",
  )
  assert(
    testVerdictPassed(names[1], code1),
    "testgen check: testpanic_dies should pass (died by panic)",
  )
  // THE LOAD-BEARING CASE: a testpanic_ that returns normally must FAIL, not
  // be silently skipped or counted as a pass.
  assert(
    !testVerdictPassed(names[2], code2),
    "testgen check: testpanic_survives should FAIL (returned normally)",
  )
  // A testpanic_ must not pass on any non-zero code other than the runtime's
  // own panic exit status — a crash, an explicit exit(1), a spawn failure
  // (-1) or a timeout (-2, ABI.md §19) are none of them a panic.
  assert(
    !testVerdictPassed(names[2], 1),
    "testgen check: testpanic_ must not pass on exit 1",
  )
  assert(
    !testVerdictPassed(names[2], -1),
    "testgen check: testpanic_ must not pass on spawn failure (-1)",
  )
  assert(
    !testVerdictPassed(names[2], -2),
    "testgen check: testpanic_ must not pass on timeout (-2)",
  )
  // An ordinary test_ function's rule is unchanged: only exit 0 passes.
  assert(
    !testVerdictPassed(names[0], 2),
    "testgen check: test_ must not pass merely by exiting 2",
  )

  remove(bin) catch println("testgen check: cleanup failed for ${bin}")
  remove(src) catch println("testgen check: cleanup failed for ${src}")
}

// Everything lives under a nonce-named /tmp directory: the check writes,
// builds and EXECS these paths, and two `bit selfcheck` runs sharing one name
// is the ETXTBSY/half-a-build shape #1459 records. It also makes the check
// cwd-independent — `stdRootPath()`/`libbitrtPath()` resolve from this binary's
// own location, never the working directory.
fn checkTestgen() {
  let dir = "/tmp/bit-testgen-check-${scratchNonce()}"
  testgenMkdir(dir)
  // ASSERTED, not skipped: a missing archive is a broken build tree, and the
  // earlier harness's silent `return` here is what made it a no-op nobody noticed.
  let rt = readRtArchive(hostBuildTarget()) catch e {
    assert(
      false,
      "testgen check: runtime archive ${libbitrtPath(hostBuildTarget())}: ${e.message()}",
    )
    return
  }
  checkTestgenFile(dir, rt)
  checkTestgenProject(dir, rt)
  checkTestgenPanic(dir, rt)
  remove(dir) catch println("testgen check: cleanup failed for ${dir}")
}
