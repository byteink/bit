fn selectedGlobal(g: IrGlobal, storage: int, freestanding: bool): bool {
  return g.storage == storage && emitsGlobal(g, freestanding)
}

fn checkGlobalFixups(g: IrGlobal, off: int): ()! {
  for r of g.relocs {
    objectFixupOffset(len(g.bytes), r.offset, off)?
  }
}

// Validate the complete selected span before the first image or padding append.
fn checkGlobalPlacement(
  module: IrModule, storage: int, initial: int, freestanding: bool, splitZero: bool,
): ()! {
  let cursor = objectAdd(initial, 0, objectByteLimit())?
  let bss = 0
  for g of module.globals {
    if (!selectedGlobal(g, storage, freestanding)) {
      continue
    }
    if (splitZero && zeroFillable(g)) {
      bss = objectGlobalEnd(bss, len(g.bytes), g.align, vI64Max())?
      continue
    }
    let off = objectAlign(cursor, g.align, objectByteLimit())?
    cursor = objectGlobalEnd(cursor, len(g.bytes), g.align, objectByteLimit())?
    checkGlobalFixups(g, off)?
  }
}

fn appendGlobalImage(buf: ByteBuf, g: IrGlobal): int! {
  let off = objectAlign(len(buf.bytes), g.align, objectByteLimit())?
  objectGlobalEnd(len(buf.bytes), len(g.bytes), g.align, objectByteLimit())?
  while (len(buf.bytes) < off) {
    buf.bytes = append(buf.bytes, u8(0))
  }
  for b of g.bytes {
    buf.bytes = append(buf.bytes, u8(b))
  }
  return off
}
