// compiler/classtablerow.bit — `@table`'s four generic-bound members (#6255,
// epic #6253, `.claude/kb/data-packages-dx.md` rules 3-4): `static
// __tableName(): string`, `static __fromRow(rows: Rows): T!`, `static
// __columns(): []FieldDesc` and an instance `__values(): []Value`.
//
// A `db.table<T>()` repository (pkg/orm, a later ticket) needs no
// hand-written mapper and no dummy-instance `tableDescriptor()` call: every
// `@table` class satisfies `interface Tabled { static __tableName(): string,
// static __columns(): []FieldDesc }` structurally, the same
// static-through-a-type-parameter shape `@job`'s `__jobName`
// (compiler/classjobdesc.bit) already established for `interface Job`.
//
// THE SAME FIELDS #5054's `find<T>` MAPS A ROW INTO (checksqlrow.bit,
// checksqlrowbuild.bit) - `__fromRow` and `__values` are built from the
// identical column classification (`classifySqlFieldType`, `sqlColumnOf`)
// and the identical field/accessor helpers (`SqlRowField`,
// `buildSqlRowClass`, `srbFieldInit`, `srbMapperTail`) that file already
// synthesizes a mapper with — reused here unconditionally, for every `@table`
// class, rather than demanded by a `find<T>` call site. `__tableName` and
// `__columns` reuse `classtabledesc.bit`'s own `TableClass`/`TableBuild`/
// `tbFieldDescLit`: `__columns()` renders the identical `[]FieldDesc` list
// `tableDescriptor()` does, as a STATIC method (`synthTableMethod`'s new
// `isStatic` parameter is the only difference in shape).
//
// `__tableName`/`__columns`/`__values` ARE SYNTHESIZED FOR EVERY `@table`
// CLASS (subject only to E0178/E0179 below). `__values()` never has to
// REPRESENT a field it excludes — it only ever lists the ones it includes,
// so excluding one is always safe. `__fromRow` is different: it constructs
// the class through a `CompositeLit`, and Bit (E0083) only lets a composite
// literal OMIT a field whose type has a zero value on its own — a slice, a
// map, a channel or `Option<>` (SPEC §10.5's relation-field section: "a
// composite literal... that omits the field writes this reserved value
// instead of the ordinary null/empty slice", true only because a relation
// field's declared type is `[]T`). A `@hasOne`/`@belongsTo` SINGULAR
// relation field (a bare class type, no `[]`) has no such zero value —
// proven by `pkg/orm/relation.test.bit`'s `relPerson.profile`/
// `relPost.author`, both bare-class relation fields whose OWN class
// literals omit them elsewhere in that very file and go E0083 for it. So
// `canFromRow` (`tableRowCanFromRow` below) is false, and `__fromRow` is
// skipped for that ONE class, whenever any field is neither row-mappable
// nor safely omittable (`tableRowFieldOmittable`) — the other three members
// are unaffected.
//
// `__fromRow`/`__values` COVER ONLY A CLASS'S ROW-MAPPABLE, NON-RELATION
// FIELDS, UNLIKE `find<T>`'s OWN E0154. A relation field (`@hasMany`/
// `@hasOne`/`@belongsTo`) is loaded separately, never through a column
// (SPEC §10.5's "starts unloaded" section) — silently excluded, never an
// error. A field that is neither a relation mark nor one of the five
// scalar kinds `find<T>` maps a column with is ALSO silently excluded,
// rather than E0154: unlike `find<T>`'s demand-driven mapper (opted into
// per call site), this fires on EVERY `@table` class, and the existing
// corpus routinely declares one with non-scalar, non-relation fields
// (`tableDescriptor()` itself has never restricted field types).
//
// ALL FOUR ARE STILL SKIPPED TOGETHER when the class declares `init`
// (E0179 below) — `find<T>`'s own E0152 restriction, since a mapper
// assigns fields directly.

// E0178 (§10.5): a `@table` class already declares one of `__tableName`,
// `__fromRow`, `__columns` or `__values` — the same rule, for the same
// reason, E0148/E0157/E0168 are for their own synthesized members.
const ecTableRowMemberDeclared = 178

// E0179 (§10.5): a `@table` class declares `init`, so `__fromRow`/`__values`
// cannot be synthesized — the row mapper assigns fields directly through a
// composite literal, the same restriction `find<T>`'s own E0152
// (checksqlrow.bit) places on a hand-mapped class.
const ecTableRowInitDeclared = 179

const synthTableNameName = "__tableName"
const synthFromRowName = "__fromRow"
const synthColumnsName = "__columns"
const synthValuesName = "__values"

// One `@table` class, ready for all four members: the `TableClass` #5052's
// own synthesis already built (for `__tableName`'s override and
// `__columns`'s field list), the resolved table-name text, and the
// row-mapped field list (kind, optionality, column) `__fromRow`/`__values`
// share.
class TableRowClass {
  tc: TableClass,
  exported: bool,
  tableNameLit: int,
  tableNameWord: string,
  fields: []SqlRowField,
  canFromRow: bool,
}

fn tableRowReservedNames(): []string {
  return [synthTableNameName, synthFromRowName, synthColumnsName, synthValuesName]
}

// The class's own member (field or method) named one of the four reserved
// words, or `(0, "")` — mirrors `declaredPersistedField`/
// `declaredPersistedMethod` (classtabledesc.bit), merged into one search
// since all four share a single diagnostic (E0178).
fn declaredTableRowMember(tree: Tree, source: string, fieldList: int): (int, string) {
  for name of tableRowReservedNames() {
    let m = declaredMember(tree, source, fieldList, name)
    if (m != 0) {
      return (m, name)
    }
  }
  for m0 of kidsOf(tree, fieldList) {
    let f = memberField(tree, m0)
    if (f == 0) {
      continue
    }
    let nameNode = kidsOf(tree, f)[0]
    let fname = identText(tree, source, nameNode)
    for name of tableRowReservedNames() {
      if (fname == name) {
        return (nameNode, name)
      }
    }
  }
  return (0, "")
}

fn reportTableRowMemberDeclared(p: Project, tree: Tree, cname: string, node: int, name: string) {
  report(
    p.diags, ecTableRowMemberDeclared, getNode(tree, node).span,
    "class '${cname}' carries '@table' and also declares '${name}', which '@table' synthesizes",
    "drop '@table', or rename this member — a hand-written '${name}' that silently won would make the synthesized one invisible to a generic 'T: Tabled' bound",
  )
}

fn reportTableRowInitDeclared(
  p: Project,
  tree: Tree,
  source: string,
  cname: string,
  initNode: int,
) {
  report(
    p.diags, ecTableRowInitDeclared, getNode(tree, initNode).span,
    "class '${cname}' carries '@table' and also declares 'init', so '__fromRow'/'__values' cannot be synthesized",
    "'__fromRow' assigns fields directly through a composite literal, the same restriction 'find<T>' places on a class declaring 'init' (E0152) — construct through 'init' yourself and skip the generic row mapper",
  )
}

// `@table`'s own name override — the string literal node of `@table("...")`,
// cloned by `synthTableName` below, or 0 when `@table` carries no argument.
fn tableNameOverrideOf(tree: Tree, source: string, tc: TableClass): int {
  for a of tc.classAttrs {
    if (identText(tree, source, a.nameNode) == classAttrTable && len(a.args) == 1) {
      return a.args[0]
    }
  }
  return 0
}

// Every `@table` class ready for all four members, or dropped (with a
// diagnostic already reported) when it declares `init` or one of the four
// reserved names itself.
fn collectTableRowClasses(p: Project, m: SrcModule, tableClasses: []TableClass): []TableRowClass {
  let out = []TableRowClass(0)
  for tc of tableClasses {
    let built = buildTableRowClass(p, m, tc)
    if (built.tc.classNode != 0) {
      out = append(out, built)
    }
  }
  return out
}

fn tableRowBad(): TableRowClass {
  return TableRowClass{
    tc = TableClass{
      classNode = 0,
      className = 0,
      exported = false,
      classAttrs = []RecordedAttr(0),
      fields = []TableField(0),
    },
    exported = false, tableNameLit = 0, tableNameWord = "", fields = []SqlRowField(0), canFromRow = false,
  }
}

// True iff a field NOT included in the row-mapped field list may still be
// safely left out of `__fromRow`'s `CompositeLit` — its declared type has
// its own zero value (this file's header explains why `Option<>` counts:
// `Option.None` is that zero value, same as a nil slice/map/channel).
fn tableRowFieldOmittable(tree: Tree, source: string, typeNode: int): bool {
  let tag = getNode(tree, typeNode).tag
  if (tag == Tag.SliceType || tag == Tag.MapType || tag == Tag.ChanType) {
    return true
  }
  if (tag != Tag.GenericInst) {
    return false
  }
  let base = kidsOf(tree, typeNode)[0]
  if (getNode(tree, base).tag != Tag.Ident) {
    return false
  }
  return identText(tree, source, base) == "Option"
}

// True iff every field of the class is either in `fields` (row-mapped) or
// safely omittable — the condition `__fromRow`'s composite literal needs to
// compile at all.
fn tableRowCanFromRow(tree: Tree, source: string, classDecl: int, fields: []SqlRowField): bool {
  for m0 of kidsOf(tree, kidsOf(tree, classDecl)[2]) {
    let f = memberField(tree, m0)
    if (f == 0) {
      continue
    }
    let nameNode = kidsOf(tree, f)[0]
    if (sqlRowFieldsHasName(tree, source, fields, nameNode)) {
      continue
    }
    if (!tableRowFieldOmittable(tree, source, kidsOf(tree, f)[1])) {
      return false
    }
  }
  return true
}

fn sqlRowFieldsHasName(tree: Tree, source: string, fields: []SqlRowField, nameNode: int): bool {
  let name = identText(tree, source, nameNode)
  for f of fields {
    if (identText(tree, source, f.nameNode) == name) {
      return true
    }
  }
  return false
}

// A field's row-mapped shape, or `ok = false` when it is a relation mark or
// not one of the five scalar kinds — both silently excluded (this file's
// header explains why neither is an error here).
fn tableRowFieldOf(p: Project, tree: Tree, source: string, field: int): (SqlRowField, bool) {
  let bad = SqlRowField{
    nameNode = 0,
    kind = sqlKindBad,
    optional = false,
    columnLit = 0,
    columnWord = "",
  }
  if (fieldRelationAttr(tree, source, field) != 0) {
    return (bad, false)
  }
  let fk = kidsOf(tree, field)
  let (kind, optional) = classifySqlFieldType(tree, source, fk[1])
  if (kind == sqlKindBad) {
    return (bad, false)
  }
  let (lit, word, ok) = sqlColumnOf(p, tree, source, field)
  if (!ok) {
    return (bad, false)
  }
  return (
    SqlRowField{
      nameNode = fk[0],
      kind = kind,
      optional = optional,
      columnLit = lit,
      columnWord = word,
    },
    true,
  )
}

// Every field of the class this file's header says `__fromRow`/`__values`
// cover, in declaration order.
fn buildTableRowFields(p: Project, tree: Tree, source: string, classDecl: int): []SqlRowField {
  let out = []SqlRowField(0)
  for m0 of kidsOf(tree, kidsOf(tree, classDecl)[2]) {
    let f = memberField(tree, m0)
    if (f == 0) {
      continue
    }
    let (rf, ok) = tableRowFieldOf(p, tree, source, f)
    if (ok) {
      out = append(out, rf)
    }
  }
  return out
}

fn buildTableRowClass(p: Project, m: SrcModule, tc: TableClass): TableRowClass {
  let tree = m.tree
  let source = m.source
  let cname = identText(tree, source, tc.className)
  let fieldList = kidsOf(tree, tc.classNode)[2]
  let (reserved, reservedName) = declaredTableRowMember(tree, source, fieldList)
  if (reserved != 0) {
    reportTableRowMemberDeclared(p, tree, cname, reserved, reservedName)
    return tableRowBad()
  }
  let initNode = declaredMember(tree, source, fieldList, "init")
  if (initNode != 0) {
    reportTableRowInitDeclared(p, tree, source, cname, initNode)
    return tableRowBad()
  }
  let nameLit = tableNameOverrideOf(tree, source, tc)
  let nameWord = ""
  if (nameLit == 0) {
    nameWord = toSnakeCase(cname)
  }
  let fields = buildTableRowFields(p, tree, source, tc.classNode)
  return TableRowClass{
    tc = tc, exported = tc.exported, tableNameLit = nameLit, tableNameWord = nameWord,
    fields = fields, canFromRow = tableRowCanFromRow(tree, source, tc.classNode, fields),
  }
}

// ---- words -----------------------------------------------------------------

fn tableRowAnyFromRow(classes: []TableRowClass): bool {
  for c of classes {
    if (c.canFromRow) {
      return true
    }
  }
  return false
}

fn tableRowSynthWords(classes: []TableRowClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    "this", "isSome", "unwrap", "Value", "string",
    "Int", "Float", "Bool", "Text", "Blob", "Null",
    synthTableNameName, synthColumnsName, synthValuesName,
  ]
  if (tableRowAnyFromRow(classes)) {
    out = append(out, "Rows")
    out = append(out, "rows")
    out = append(out, "cols")
    out = append(out, "columns")
    out = append(out, synthFromRowName)
    out = append(out, sqlRowResultLocal)
    out = append(out, synthMarkPersistedName)
    out = append(out, sqlRowTrueWord)
    for a of sqlFieldAccessorNames() {
      out = append(out, a)
    }
  }
  for c of classes {
    if (c.tableNameLit == 0) {
      out = append(out, "\"" + c.tableNameWord + "\"")
    }
    if (!c.canFromRow) {
      continue // the column word is only spelled by __fromRow's accessor calls
    }
    for f of c.fields {
      if (f.columnLit == 0) {
        out = append(out, f.columnWord)
      }
    }
  }
  return out
}

// `Value`, and — when at least one class in the module gets `__fromRow`
// (`tableRowAnyFromRow`) — `Rows` and the row-accessor helpers too. Shares
// `bound` with `sqlRowImportDecls` (checksqlrowbuild.bit) so a module using
// both `@table` and `find<T>` never double-imports the same name (#6255).
fn tableRowImportDecl(
  m: SrcModule,
  st: SynthText,
  classes: []TableRowClass,
  bound: map<string, bool>,
): int {
  let names = []string(0)
  if (tableRowAnyFromRow(classes)) {
    for h of sqlRowHelperNames() {
      let (_, already) = bound[h]
      if (!already) {
        names = append(names, h)
        bound[h] = true
      }
    }
  }
  let (_, hasValue) = bound["Value"]
  if (!hasValue) {
    names = append(names, "Value")
    bound["Value"] = true
  }
  return synthImportDecl(m, st, sqlRowModulePath, names)
}

// ---- __tableName -------------------------------------------------------------

fn tableNameLitNode(tree: Tree, st: SynthText, c: TableRowClass): int {
  if (c.tableNameLit != 0) {
    let n = getNode(tree, c.tableNameLit)
    return addLeaf(tree, n.tag, n.span)
  }
  return addLeaf(tree, Tag.StringLit, synthSpan(st, "\"" + c.tableNameWord + "\""))
}

// `[export] static __tableName(): string { return "<name>" }` — mirrors
// `synthJobNameMethod` (classjobdesc.bit) exactly: a static method reached
// through the CLASS, `T.__tableName()` for `T: Tabled`, never through an
// instance.
fn synthTableName(tree: Tree, st: SynthText, c: TableRowClass): int {
  let classSpan = getNode(tree, c.tc.className).span
  let lit = tableNameLitNode(tree, st, c)
  let stmts = [addNode(tree, Tag.ReturnStmt, classSpan, 0, [lit])]
  let recv = addNode(
    tree,
    Tag.Receiver,
    classSpan,
    1,
    [0, traitClassTypeRef(tree, c.tc.className, 0)],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      recv, synthIdent(tree, st, synthTableNameName), 0,
      addNode(tree, Tag.Params, classSpan, 0, []int(0)), synthIdent(tree, st, "string"),
      addNode(tree, Tag.Block, classSpan, 0, stmts),
    ],
  )
  if (!c.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// ---- __columns ---------------------------------------------------------------

// `[export] static __columns(): []FieldDesc { return [...] }` — the STATIC
// twin of `tableDescriptor()`: identical `tbFieldDescLit` rendering of
// `c.tc.fields`, through `synthTableMethod`'s `isStatic = true`.
fn synthTableColumns(tree: Tree, source: string, st: SynthText, c: TableRowClass): int {
  let classSpan = getNode(tree, c.tc.className).span
  let b = TableBuild{ tree = tree, st = st, span = classSpan }
  let items = []int(0)
  for f of c.tc.fields {
    items = append(items, tbFieldDescLit(b, tree, source, f))
  }
  return synthTableMethod(
    b, c.tc, TableMethodSpec{ name = synthColumnsName, elemType = "FieldDesc", isStatic = true }, items,
  )
}

// ---- __fromRow -----------------------------------------------------------

// `[export] static __fromRow(rows: Rows): T! { let cols = rows.columns();
// return T{ ... } }` (marking the hydrated row persisted, #5052, since every
// `@table` class carries the hidden flag) — the STATIC twin of #5054's own
// `__sql_row_C` mapper (`synthSqlRowMapper`, checksqlrowbuild.bit), reusing
// its field-value/tail builders (`srbFieldInit`, `srbMapperTail`) unchanged.
fn synthTableFromRow(tree: Tree, st: SynthText, c: TableRowClass): int {
  let classSpan = getNode(tree, c.tc.className).span
  let b = SqlRowBuild{ tree = tree, st = st, span = classSpan }
  let colsCall = srbCall(
    b, srbNode(b, Tag.Member, [srbIdent(b, "rows"), srbIdent(b, "columns")]), []int(0),
  )
  let colsLet = srbNode(
    b,
    Tag.LetDecl,
    [srbNode(b, Tag.Binding, [srbIdent(b, "cols"), 0, colsCall])],
  )
  let inits = []int(0)
  for f of c.fields {
    inits = append(inits, srbFieldInit(b, f))
  }
  b.span = classSpan
  let ctor = srbNode(
    b, Tag.CompositeLit,
    [addLeaf(tree, Tag.Ident, classSpan), srbNode(b, Tag.FieldInits, inits)],
  )
  let stmts = [colsLet]
  for s of srbMapperTail(b, ctor, true) {
    stmts = append(stmts, s)
  }
  let body = srbNode(b, Tag.Block, stmts)
  let params = srbNode(
    b, Tag.Params, [srbNode(b, Tag.Param, [srbIdent(b, "rows"), srbIdent(b, "Rows")])],
  )
  let result = srbNode(b, Tag.Fallible, [addLeaf(tree, Tag.Ident, classSpan), 0])
  let recv = addNode(
    tree,
    Tag.Receiver,
    classSpan,
    1,
    [0, traitClassTypeRef(tree, c.tc.className, 0)],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [recv, synthIdent(tree, st, synthFromRowName), 0, params, result, body],
  )
  if (!c.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// ---- __values ------------------------------------------------------------

// `Value.<variant>` — the enum constructor name (`stdlib/sql/sql.bit`'s
// `enum Value { Null, Int(int), Float(f64), Bool(bool), Text(string),
// Blob([]byte) }`) matching a field's scalar kind, same mapping
// `sqlFieldAccessorName`'s kind switch already keys on the decode side.
fn sqlValueVariant(kind: int): string {
  if (kind == sqlKindInt) {
    return "Int"
  }
  if (kind == sqlKindFloat) {
    return "Float"
  }
  if (kind == sqlKindBool) {
    return "Bool"
  }
  if (kind == sqlKindString) {
    return "Text"
  }
  return "Blob"
}

fn tbCall(b: TableBuild, callee: int, args: []int): int {
  let argNodes = []int(0)
  for a of args {
    argNodes = append(argNodes, tbNode(b, Tag.Arg, [a]))
  }
  return tbNode(b, Tag.Call, [callee, 0, tbNode(b, Tag.Args, argNodes)])
}

// `this.<field>`, a FRESH leaf on the field's own name span — mirrors
// `jbThisField` (classjsonbuild.bit); called separately at every use site
// rather than shared, the same reason `jbOptionValue` clones its own operand
// twice: a node reachable by two paths is a shape no other pass here builds.
fn tbThisField(b: TableBuild, nameNode: int): int {
  let recv = tbIdent(b, synthReceiverName)
  let name = addLeaf(b.tree, Tag.Ident, getNode(b.tree, nameNode).span)
  return tbNode(b, Tag.Member, [recv, name])
}

fn tbValueCtor(b: TableBuild, variant: string, arg: int): int {
  let callee = tbNode(b, Tag.Member, [tbIdent(b, "Value"), tbIdent(b, variant)])
  return tbCall(b, callee, [arg])
}

// `Value.<Kind>(this.f)`, or for `Option<>`: `isSome(this.f) ? Value.<Kind>(unwrap(this.f)) : Value.Null`.
fn tbFieldValueExpr(b: TableBuild, f: SqlRowField): int {
  b.span = getNode(b.tree, f.nameNode).span
  if (!f.optional) {
    return tbValueCtor(b, sqlValueVariant(f.kind), tbThisField(b, f.nameNode))
  }
  let cond = tbCall(b, tbIdent(b, "isSome"), [tbThisField(b, f.nameNode)])
  let some = tbValueCtor(
    b,
    sqlValueVariant(f.kind),
    tbCall(b, tbIdent(b, "unwrap"), [tbThisField(b, f.nameNode)]),
  )
  let none = tbNode(b, Tag.Member, [tbIdent(b, "Value"), tbIdent(b, "Null")])
  return tbNode(b, Tag.CondExpr, [cond, some, none])
}

// `[export] (this: C) __values(): []Value { return [...] }`, in column order
// — through `synthTableMethod`'s ordinary instance shape (`isStatic = false`).
fn synthTableValues(tree: Tree, st: SynthText, c: TableRowClass): int {
  let classSpan = getNode(tree, c.tc.className).span
  let b = TableBuild{ tree = tree, st = st, span = classSpan }
  let items = []int(0)
  for f of c.fields {
    items = append(items, tbFieldValueExpr(b, f))
  }
  return synthTableMethod(
    b, c.tc, TableMethodSpec{ name = synthValuesName, elemType = "Value", isStatic = false }, items,
  )
}

// ---- injection -------------------------------------------------------------

fn injectTableRowDecls(tree: Tree, source: string, st: SynthText, classes: []TableRowClass): []int {
  let out = []int(0)
  for c of classes {
    out = append(out, synthTableName(tree, st, c))
    out = append(out, synthTableColumns(tree, source, st, c))
    if (c.canFromRow) {
      out = append(out, synthTableFromRow(tree, st, c))
    }
    out = append(out, synthTableValues(tree, st, c))
  }
  return out
}
