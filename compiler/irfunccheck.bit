// In-Bit self-check for #7066: every `IrFunc` a lowering or optimizer pass
// builds goes through `irFuncFromBuilder`, `irFuncRebuilt` or `irFuncRenamed`
// (ir.bit), and each of them carries the interior-pointer keepalive edges
// (#4406) itself. #7039 was memory corruption in every `test` body because one
// producer built its own `IrFunc{...}` literal and left `keepAlive` off. This
// pins that the constructors copy the edges, so one that stops fails here at
// selfcheck time instead of as a freed string at run time.

fn keepAliveEdgesMatch(f: IrFunc, want: []int): bool {
  if (len(f.keepAlive) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(want)) {
    if (f.keepAlive[i] != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn checkIrFuncKeepAlive() {
  let b = newBuilder()
  b.keepAlive = [3, 1, 4, 2]
  let built = irFuncFromBuilder(b, "built", []int(0), 0)
  assert(
    keepAliveEdgesMatch(built, [3, 1, 4, 2]),
    "irFuncFromBuilder must carry the builder's keepAlive edges",
  )

  let rb = newBuilder()
  let rebuilt = irFuncRebuilt(built, rb, [7, 5])
  assert(
    keepAliveEdgesMatch(rebuilt, [7, 5]),
    "irFuncRebuilt must carry the keepAlive edges it is handed",
  )

  let renamed = irFuncRenamed(built, "renamed")
  assert(renamed.name == "renamed", "irFuncRenamed changes the name")
  assert(
    keepAliveEdgesMatch(renamed, [3, 1, 4, 2]),
    "irFuncRenamed must carry the source's keepAlive edges",
  )

  built.isPinned = true
  built.inRootModule = true
  let flags = irFuncRebuilt(built, rb, []int(0))
  assert(
    flags.isPinned && flags.inRootModule,
    "irFuncRebuilt must carry the pin and module-tag flags",
  )
}
