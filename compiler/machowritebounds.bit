fn machoWriteU32(value: int): int! {
  return objectAdd(value, 0, 0xFFFFFFFF)?
}

fn machoWriteRelocAddress(value: int): int! {
  return objectAdd(value, 0, 0x7FFFFFFF)?
}

fn machoWriteSymbolValue(addr: int, offset: int): int! {
  return objectAdd(addr, offset, 0x7FFFFFFFFFFFFFFF)?
}

fn machoWriteSymbolNumber(value: int): int! {
  return objectAdd(value, 0, 0xFFFFFF)?
}

fn machoWriteVmEnd(cursor: int, size: int, alignment: int): int! {
  let addr = objectAlign(cursor, alignment, 0x7FFFFFFFFFFFFFFF)?
  return objectAdd(addr, size, 0x7FFFFFFFFFFFFFFF)?
}

fn machoWriteFileEnd(cursor: int, size: int, alignment: int): int! {
  let offset = objectAlign(cursor, alignment, objectByteLimit())?
  machoWriteU32(offset)?
  return objectAdd(offset, size, objectByteLimit())?
}

fn machoWriteRelocEnd(cursor: int, count: int): int! {
  if (count > 0) {
    machoWriteU32(cursor)?
  }
  machoWriteU32(count)?
  let size = objectMul(count, 8, objectByteLimit())?
  return objectAdd(cursor, size, objectByteLimit())?
}

fn machoWriteSymtabEnd(cursor: int, count: int, strsize: int): int! {
  let symoff = objectAlign(cursor, 8, objectByteLimit())?
  machoWriteU32(symoff)?
  machoWriteU32(count)?
  let bytes = objectMul(count, sizeofNlist64(), objectByteLimit())?
  let stroff = objectAdd(symoff, bytes, objectByteLimit())?
  machoWriteU32(stroff)?
  machoWriteU32(strsize)?
  return objectAdd(stroff, strsize, objectByteLimit())?
}

fn machoWriteNameSize(size: int, nameSize: int): int! {
  let end = objectAdd(size, nameSize, 0xFFFFFFFF)?
  return objectAdd(end, 1, 0xFFFFFFFF)?
}

fn machoWriteNamesAndValues(obj: MachoObject, addrOf: []int): int! {
  let strsize = 1
  let i = 0
  while (i < len(obj.symbols)) {
    let sym = obj.symbols[i]
    strsize = machoWriteNameSize(strsize, len(sym.name))?
    if (sym.hasSection) {
      machoWriteSymbolValue(addrOf[machoKindIndex(sym.section)], sym.offset)?
    }
    i = i + 1
  }
  return strsize
}

fn machoWriteBounds(
  obj: MachoObject,
  present: []MachoSectionKind,
  parts: ([]MachoSection, []MachoRelocList, []int),
  cmdsEnd: int,
): ()! {
  let (sections, relocs, addrOf) = parts
  let cursor = cmdsEnd
  let vm = 0
  let i = 0
  while (i < len(present)) {
    let idx = machoKindIndex(present[i])
    let sec = sections[idx]
    let alignment = sec.alignment
    if (alignment == 0) {
      alignment = 1
    }
    addrOf[idx] = objectAlign(vm, alignment, 0x7FFFFFFFFFFFFFFF)?
    vm = machoWriteVmEnd(vm, machoSectionBytes(sec), alignment)?
    if (!machoIsZerofill(sec.kind)) {
      cursor = machoWriteFileEnd(cursor, len(sec.data), alignment)?
    }
    i = i + 1
  }
  cursor = objectAlign(cursor, 4, objectByteLimit())?
  i = 0
  while (i < len(present)) {
    cursor = machoWriteRelocEnd(cursor, len(relocs[machoKindIndex(present[i])].list))?
    i = i + 1
  }
  let strsize = machoWriteNamesAndValues(obj, addrOf)?
  machoWriteSymtabEnd(cursor, len(obj.symbols), strsize)?
}
