// #6684: the closure-call emitters, split out of x64call.bit, which was 26
// lines under the 800-line ceiling, so the one-word and the word-run forms can
// sit together. Sibling .bit file, same module: see x64call.bit for the direct
// and interface forms this mirrors, and arm64callvalue.bit for the twin.

// `call_value`: dispatch through a closure cell {code, env}. The env and code are
// loaded into r10/rax — neither is an argument register, so marshalling cannot
// disturb them, and r11 stays free as the move-cycle temp. rax is free (#6198):
// a call_value is a strict clobber point, so nothing live sits in it.
//
// #6684: the closure-call counterpart of #5869's xEmitCallIfaceSeq split. Only
// the binding differs between a one-word result and a word run, so the nil
// check, the cell loads, the marshaling and the safepoint live in ONE sequence
// and cannot drift between the two forms.
fn xEmitCallValueSeq(cx: XCtx, callee: int, args: []int) {
  let cell = xGetInt(cx, callee, xScratch1())
  // #2018: a nil function value's cell is the null word (SPEC §13.4); calling
  // through it must panic (§18.4: "call of a nil function"), not dereference
  // address 0 for its {code, env} fields. `Op.CallValue` is already a full
  // safepoint/clobber point for regalloc, so this extra call on the cold path
  // needs no register preservation of its own.
  xTestRR(cx.buf, cell, cell)
  let ncSkip = xJccRel32Placeholder(cx, ccNe()) // non-nil -> skip the panic call
  let shadow = xReserveShadow(cx)
  xCallReloc(cx, "bit_rt_panic_nil_call")
  if (shadow > 0) {
    xRspAddSub(cx.buf, false, shadow)
  }
  xPatchRel32Here(cx, ncSkip)
  xMovLoad(cx.buf, xScratch2(), xMemB(cell, 8), 8, false) // r10 = env
  xMovLoad(cx.buf, XReg64.Rax, xMemB(cell, 0), 8, false)  // rax = code
  let argReserve = xMarshalArgs(cx, args, 1, 1, 0)        // arg0 reserved for env
  xMovRR(cx.buf, xArg0(cx.cc), xScratch2())
  shadow = xReserveShadow(cx)
  xCallReg(cx, XReg64.Rax)
  xRecordSafepoint(cx)
  if (shadow > 0) {
    xRspAddSub(cx.buf, false, shadow)
  }
  if (argReserve > 0) {
    xRspAddSub(cx.buf, false, argReserve)
  }
}

// #6684: the one-word form. Byte-identical to the sequence before the split.
fn xEmitCallValue(cx: XCtx, dst: int, ty: int, callee: int, args: []int) {
  xEmitCallValueSeq(cx, callee, args)
  if (cx.ctx.types[ty].kind != TypeKind.Void) {
    xTakeCallResult(cx, dst, ty)
  }
}

// #6684: the multi-word form. Instruction `i` is the `Op.CallValue` (word 0)
// and the `w - 1` `Op.CallWord`s immediately after it carry the rest, so ONE
// `xTakeCallResults` binds every word — nothing may be emitted between the
// call and the last binding (#4236). A closure returns its words in the same ABI
// registers a direct call does, so the binding is the same call as
// `xEmitCallWords` and `xEmitCallIfaceWords` (x64call.bit) make.
fn xEmitCallValueWords(cx: XCtx, i: int, ins: IrInstr, w: int) {
  let dsts = xCallWordDsts(cx, i, w)
  let tys = xCallWordTys(cx, i, w)
  xEmitCallValueSeq(cx, ins.lhs, ins.args)
  xTakeCallResults(cx, dsts, tys)
}

// #6684: the `Op.CallValue` dispatch arm (x64dispatch.bit). A closure call whose
// result is W > 1 words is followed by its own `Op.CallWord` run, bound in the
// one parallel move at the call site exactly as a direct or a vtable call's is;
// kept here so the arm in xEmitInstOps6 stays one call.
fn xEmitCallValueInst(cx: XCtx, i: int, ins: IrInstr) {
  let w = callWordRunLen(cx.f, i)
  if (w > 1) {
    xEmitCallValueWords(cx, i, ins, w)
    return
  }
  xEmitCallValue(cx, xDstOrNone(cx, i, ins.ty), ins.ty, ins.lhs, ins.args)
}
