// compiler/checklookup.bit — split out of check.bit (#1809). Sibling of
// check.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

fn structFieldLookup(c: Checker, key: string): int {
  let (v, ok) = c.ctx.structFields[key]
  if (ok) {
    return v
  }
  return 0
}

// The base name of a type node: a plain ident's text, or a generic instance's
// base (`Box<i64>` -> "Box"). Empty for anything else.
fn typeNodeName(c: Checker, node: int): string {
  if (node == 0) {
    return ""
  }
  let n = getNode(c.tree, node)
  if (n.tag == Tag.Ident) {
    return c.source[n.span.start:n.span.end]
  }
  if (n.tag == Tag.GenericInst) {
    return typeNodeName(c, kidsOf(c.tree, node)[0])
  }
  return ""
}

fn methodResultLookup(c: Checker, key: string): int {
  let (v, ok) = c.ctx.methodResults[key]
  if (ok) {
    return v
  }
  return 0
}

// "TypeName.method" -> the method's `(params) => result` func type, or 0.
fn methodSigLookup(c: Checker, key: string): int {
  let (v, ok) = c.ctx.methodSigs[key]
  if (ok) {
    return v
  }
  return 0
}

// Builds a `(params) => result` func type from a params-list node (each kid a
// `param[name, type]`), for a method value or a signature.
// Interns a parameter list's types in source order, returning the id list.
fn paramTypeIds(c: Checker, paramsNode: int): []int {
  let ptypes = []int(0)
  let params = kidsOf(c.tree, paramsNode)
  let i = 0
  while (i < len(params)) {
    ptypes = append(ptypes, typeFromNode(c, kidsOf(c.tree, params[i])[1]))
    i = i + 1
  }
  return ptypes
}

// The type a parameter's NAME binds to in the body. For `...name: T` the
// declared type node is the element type T but the body sees `[]T` (§10.3);
// every other parameter binds its declared type unchanged.
fn paramBindType(c: Checker, tag: Tag, typeNode: int): int {
  let ty = typeFromNode(c, typeNode)
  if (tag == Tag.ParamRest) {
    return mkSlice(c.ctx, ty)
  }
  return ty
}

// A signature is variadic when its LAST parameter is `...name: T` (the grammar
// permits it only there). The interned param type stays the element type T —
// the seed does the same, and call-site arity checking reads the flag.
fn paramsAreVariadic(c: Checker, paramsNode: int): bool {
  let params = kidsOf(c.tree, paramsNode)
  if (len(params) == 0) {
    return false
  }
  return getNode(c.tree, params[len(params) - 1]).tag == Tag.ParamRest
}

fn funcTypeFromParams(c: Checker, paramsNode: int, resultTy: int): int {
  return mkFunc(c.ctx, paramTypeIds(c, paramsNode),
    paramsAreVariadic(c, paramsNode), resultTy)
}

// The type to resolve a method call against: a constrained type parameter `T`
// dispatches through its constraint interface, so `s.area()` (s: T, `T: Shape`)
// resolves on Shape. Any other type is its own receiver.
fn methodRecvType(c: Checker, recvType: int): int {
  if (c.ctx.types[recvType].kind != TypeKind.TypeParam) {
    return recvType
  }
  let cons = c.typeParamConstraints[recvType]
  if (cons != 0) {
    return cons
  }
  return recvType
}

fn userTypeLookup(c: Checker, name: string): int {
  let (v, ok) = c.userTypes[name]
  if (ok) {
    return v
  }
  return 0
}

// name -> TypeId from the scope env, or 0 (invalid) if unbound. ponytail: linear
// scan pending map comma-ok lowering. [[bit-maps]]
fn envLookup(c: Checker, name: string): int {
  for (k, v) of c.env {
    if (k == name) {
      return v
    }
  }
  return 0
}

fn funcResultLookup(c: Checker, name: string): int {
  let (v, ok) = c.funcResults[name]
  if (ok) {
    return v
  }
  return 0
}

// The full `(params) => result` type of a free function used as a value, or 0.
fn funcSigLookup(c: Checker, name: string): int {
  let (v, ok) = c.funcSigs[name]
  if (ok) {
    return v
  }
  return 0
}

// The FuncDecl node for a free function, or 0. An imported name's decl lives in
// the exporting module's tree, so the lookup follows the import — callers that
// then read the node MUST read it against `declOwner(c, name).tree`.
fn funcDeclLookup(c: Checker, name: string): int {
  // A locally-declared function shadows a same-named prelude/import (§17.5): the
  // user's own name wins, matching the resolver's rInjectPrelude and the seed.
  // Consulting the import first mis-resolved a local `unwrap` to the prelude's
  // generic `unwrap<T>`, so `genericResultAt` bound a phantom type param and the
  // call's type came out as the argument's rather than the declared result.
  let (v, ok0) = c.funcDecls[name]
  if (ok0) {
    return v
  }
  let (o, ok) = c.importedFrom[name]
  if (ok && o.module >= 0 && o.module < len(c.mods)) {
    let e = c.mods[o.module]
    let (ev, ok1) = e.funcDecls[o.name]
    if (ok1) {
      return ev
    }
  }
  return 0
}

// A free function's declaration, paired with the module that owns the tree the
// decl node indexes. The two are inseparable — a node index only means anything
// inside its own tree — so every site that needs one needs the other, and
// resolving them together makes it impossible to pair a decl with the wrong
// tree. `decl == 0` means "no free function", and `owner` is then `c`.
//
// `declName` is the name the OWNER declares it under, which differs from the
// spelling at the use site whenever an import renames it
// (`import { readFile as slurp }`). Both the instantiation ledger and the link
// symbol are built from it, so an alias never reaches either.
class FuncRef {
  owner: Checker,
  decl: int,
  declName: string,
}

// The free function the identifier at `node` names, resolved through the
// RESOLVER's per-node symbol table rather than by name (#1502).
//
// `funcDeclLookup`/`declOwner` answer from `name` alone, against a module-wide
// map, with a hand-rolled "a local declaration beats an import" loop standing in
// for scope. That is the flat-namespace hazard this codebase keeps paying for: a
// name is not a binding, and only the node knows which binding it is. The
// resolver already computed that — a `Func` symbol carries its own decl node,
// and an `ImportItem` carries the module and symbol it aliases, which is exactly
// the owner hop `declOwner` reconstructs by guessing.
//
// A node the resolver bound to a VALUE — a local, const, param or receiver of
// the same name — answers "there is NO free function here" (#1552). Per SPEC
// §17.5 the nearer binding wins outright, so the declaration is not a candidate
// and must not be reached by name. This is the same question `shadowedByValue`
// answers for the validators; keeping the two in step is what stops the checker
// and the lowerer disagreeing about which callee a shadowed name denotes.
//
// Falls back to the name path only when the node resolves to no symbol at all:
// the resolver-less dump entry points (`nodeSymbols` empty) and a qualified
// `ns.member` callee, whose dotted key has no single ident node to bind.
fn funcRefAt(c: Checker, node: int, name: string): FuncRef {
  // A BARE name only. `nodeSymbols` binds identifiers; a dotted `ns.fn` callee
  // is a Member node the resolver never bound to one symbol, and `name` there is
  // the dotted key the name-keyed tables use. Trusting the node for it would
  // silently answer "unresolved" for every namespaced call.
  if (node > 0 && node < len(c.nodeSymbols) && getNode(c.tree, node).tag == Tag.Ident) {
    let sid = c.nodeSymbols[node]
    if (sid > 0 && sid < len(c.symbols)) {
      let sym = c.symbols[sid]
      if (sym.kind == SymbolKind.Func && sym.decl != 0) {
        return FuncRef{ owner: c, decl: sym.decl, declName: sym.name }
      }
      // Bound to a VALUE: the shadow is decisive, so stop here rather than
      // falling through to the name path, which would find the very declaration
      // §17.5 says this name no longer denotes.
      if (sym.kind == SymbolKind.LetBinding || sym.kind == SymbolKind.ConstBinding ||
          sym.kind == SymbolKind.Param || sym.kind == SymbolKind.Receiver) {
        return FuncRef{ owner: c, decl: 0, declName: "" }
      }
      if (sym.kind == SymbolKind.ImportItem) {
        let m = sym.importedFromModule
        if (m >= 0 && m < len(c.mods)) {
          let e = c.mods[m]
          let tid = sym.importedFromSymbol
          if (tid > 0 && tid < len(e.symbols)) {
            let tgt = e.symbols[tid]
            if (tgt.kind == SymbolKind.Func && tgt.decl != 0) {
              return FuncRef{ owner: e, decl: tgt.decl, declName: tgt.name }
            }
          }
        }
      }
    }
  }
  return FuncRef{ owner: declOwner(c, name), decl: funcDeclLookup(c, name),
    declName: declName2(c, name) }
}

// The link name for a call to the RESOLVED function `fr`, from a build rooted at
// module `root`. The same three rules as `callQualified` — §11.7 extern, §11.9
// pin, then module qualification — with nothing left to guess: owner, declared
// name and decl node all come from the callee's resolved symbol, so neither an
// import alias nor a local shadowing a same-named import can reach the object
// file. Requires `fr.decl != 0`.
fn callQualifiedRef(root: int, fr: FuncRef): string {
  // SPEC 11.7: an extern symbol is NEVER module-qualified — the raw name is
  // precisely the symbol the linker must import from the dylib.
  let (_, isExtern) = fr.owner.externFns[fr.declName]
  if (isExtern) {
    return fr.declName
  }
  // SPEC 11.9: a pinned function's DEFINITION is emitted under the pinned name
  // (lowerFuncNamed), bypassing module qualification, so a call to it must be
  // spelled the same way. Without this the definition lands as `bit_rt_f` while
  // the call emits `m<id>$f` — an unresolvable reference that fails far from its
  // cause. Checked AFTER extern so an `extern function` (which has no attribute
  // list at kid 6) never reaches funcAttrArg; §11.7 consumes a symbol, §11.9
  // produces one, and the two are disjoint by construction.
  let pin = funcAttrArg(fr.owner, fr.decl, "symbol")
  if (pin != "") {
    return pin
  }
  return moduleQualified(fr.owner.moduleId, root, fr.declName)
}

// The callee node of a Call, or 0 for anything else — the node `funcRefAt` keys
// on. Guarded rather than assumed: several callers pass a `callNode` that is
// only SOMETIMES a Call (see `explicitCallTypeArgs`), and reading kid 0 of a
// non-Call would key the lookup on an unrelated node. A non-Ident callee needs
// no guard here; `funcRefAt` is the one place that decides what it can trust.
fn calleeNodeOf(c: Checker, callNode: int): int {
  if (callNode <= 0 || callNode >= len(c.tree.nodes)) {
    return 0
  }
  if (getNode(c.tree, callNode).tag != Tag.Call) {
    return 0
  }
  return kidsOf(c.tree, callNode)[0]
}

// Copies every entry whose key is exactly `orig`, or is prefixed `orig.` (a
// type's fields and methods are keyed "Type.member"), rebinding the key's
// leading name to `alias`. Named `orig`/`alias` because `from` is a keyword.
fn copyQualified(dst: map<string, int>, src: map<string, int>, orig: string, alias: string) {
  for (k, v) of src {
    if (k == orig) {
      dst[alias] = v
      continue
    }
    if (len(k) > len(orig) && k[0:len(orig)] == orig && k[len(orig)] == '.') {
      dst[alias + k[len(orig):len(k)]] = v
    }
  }
}

// Binds `name` (as declared in module `mid`'s checker `e`) into `c` under
// `alias`. TypeIds are global to the shared TypeContext, so the type side of an
// import is a plain copy — which is what lets the rest of the checker stay
// name-keyed and completely unaware that modules exist. Only the declaration
// NODE cannot be copied; it stays in the exporter's tree, reached via declOwner.
fn importName(c: Checker, e: Checker, mid: int, name: string, alias: string) {
  c.importedFrom[alias] = ImportOrigin{ module: mid, name: name }
  copyQualified(c.funcResults, e.funcResults, name, alias)
  copyQualified(c.funcSigs, e.funcSigs, name, alias)
  copyQualified(c.userTypes, e.userTypes, name, alias)
  // A module-level `export const` records its type in `env` (checkBinding), and
  // an importer that cannot type the name cannot use it at all: `${pi}` has no
  // idea what to interpolate. The exporting module is fully checked before this
  // runs (module ids are dependency order), so its env holds the const already.
  // From `moduleEnv`, never `env`: see the field comment. A local shadowing an
  // exported name is legal Bit (E0048 is only a warning), so reading the flat
  // env here handed the importer the shadowing local's type.
  copyQualified(c.env, e.moduleEnv, name, alias)
  // Fields and methods are NOT copied: they live on the type in the shared
  // TypeContext, so they resolve from any module that can name the type at all.
}
