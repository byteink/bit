// compiler/checklookup.bit — split out of check.bit (#1809). Sibling of
// check.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

fn structFieldLookup(c: Checker, key: string): int {
  let (v, ok) = c.ctx.structFields[key]
  if (ok) {
    return v
  }
  return 0
}

// "<typeId>.<field>" -> whether that field is `readonly` (#4066). A missing
// key means false, matching `methodExported`'s sparse-map convention.
fn readonlyFieldLookup(c: Checker, key: string): bool {
  let (v, ok) = c.ctx.readonlyFields[key]
  return ok && v
}

// "<typeId>.<field>" -> whether that field carries `export` (SPEC 10.5,
// #4631). A missing key means false — module-private — matching
// `readonlyFields`/`methodExported`'s sparse-map convention.
fn exportedFieldLookup(c: Checker, key: string): bool {
  let (v, ok) = c.ctx.exportedFields[key]
  return ok && v
}

// The base name of a type node: a plain ident's text, or a generic instance's
// base (`Box<i64>` -> "Box"). Empty for anything else.
fn typeNodeName(c: Checker, node: int): string {
  if (node == 0) {
    return ""
  }
  let n = getNode(c.tree, node)
  if (n.tag == Tag.Ident) {
    return c.source[n.span.start:n.span.end]
  }
  if (n.tag == Tag.GenericInst) {
    return typeNodeName(c, kidsOf(c.tree, node)[0])
  }
  return ""
}

fn methodResultLookup(c: Checker, key: string): int {
  let (v, ok) = c.ctx.methodResults[key]
  if (ok) {
    return v
  }
  return 0
}

// "TypeName.method" -> the method's `(params) => result` func type, or 0.
fn methodSigLookup(c: Checker, key: string): int {
  let (v, ok) = c.ctx.methodSigs[key]
  if (ok) {
    return v
  }
  return 0
}

// Builds a `(params) => result` func type from a params-list node (each kid a
// `param[name, type]`), for a method value or a signature.
// Interns a parameter list's types in source order, returning the id list.
fn paramTypeIds(c: Checker, paramsNode: int): []int {
  let ptypes = []int(0)
  let params = kidsOf(c.tree, paramsNode)
  let i = 0
  while (i < len(params)) {
    ptypes = append(ptypes, paramDeclaredType(c, kidsOf(c.tree, params[i])))
    i = i + 1
  }
  return ptypes
}

// A Param/ParamRest's declared type, or — when the type is absent (§10.3,
// #5258's inferred spelling `x = 1`) — the default concrete type its literal
// default infers to (`defaultLitType`, checkgeneric.bit): the same
// untyped-constant defaulting `let x = 5` and `Option.Some(5)` already use.
// E0159 (validatefuncdecl.bit) restricts a default to a bare literal, so this
// is the only case a VALID absent type can mean. `pk` is the param's own kid
// list `[name, type_or_0, default_or_absent]` — the third kid is present only
// when `parseParam` (parserparam.bit) actually built one, and #5415 is the
// case that comment used to miss: `pk[1] == 0` is not only the inferred
// spelling. `parseType` also returns 0, with NO default following, when the
// type itself failed to parse (error recovery mid a malformed member list,
// e.g. `_tests_/cases/error_trait_field_default.bit`'s retried param) — a
// 2-kid node that already carries its own parse diagnostic. `len(pk) < 3`
// tells the two apart the same way `vParamDefaults` (validatefuncdecl.bit)
// already does before its own `pk[2]` read. `nil` is accepted as a literal by
// E0159 (an ANNOTATED default may assign it to any nil-accepting type) but
// has no default concrete type of its own — `defaultLitType` leaves it
// untyped, and `vParamDefaults` (validatefuncdecl.bit) is what turns that
// into a diagnostic for this form.
fn paramDeclaredType(c: Checker, pk: []int): int {
  return paramDeclaredTypeIn(c, pk, noSubst())
}

// `paramDeclaredType` with a generic instantiation's substitution applied
// (`lowerParamTypesIn`, lower.bit, the one other reader of a param's type
// node): irrelevant to the inferred arm, since a literal default is always a
// concrete primitive — never a type parameter — so `sub` only ever reaches
// `typeFromNodeIn` on the WRITTEN-type arm.
fn paramDeclaredTypeIn(c: Checker, pk: []int, sub: TypeSubst): int {
  if (pk[1] != 0) {
    return typeFromNodeIn(c, pk[1], sub)
  }
  if (len(pk) < 3) {
    // A type that failed to parse, not the inferred spelling (#5415): there
    // is no default kid to type, and the parser already reported this node.
    // 0 is the same "already reported, do not cascade" sentinel the untyped
    // branch below returns.
    return 0
  }
  let dty = defaultLitType(c, pk[2], checkExprType(c, pk[2]))
  // Still untyped (`nil`, defaultLitType's one no-op case): invalid (0)
  // rather than the untyped-nil placeholder, matching every other genuinely
  // unresolved type node in this checker — 0 is what every downstream reader
  // already treats as "already reported, do not cascade" (see
  // vExternFnDecl's/vSymbolAttr's own `pt != 0` guards, checklookup.bit
  // sibling functions). `vParamDefaults` (validatefuncdecl.bit) is what
  // reports it, once.
  if (isUntyped(c, dty)) {
    return 0
  }
  return dty
}

// The type a parameter's NAME binds to in the body. For `...name: T` the
// declared type node is the element type T but the body sees `[]T` (§10.3);
// every other parameter binds its declared type unchanged.
fn paramBindType(c: Checker, tag: Tag, pk: []int): int {
  let ty = paramDeclaredType(c, pk)
  if (tag == Tag.ParamRest) {
    return mkSlice(c.ctx, ty)
  }
  return ty
}

// A signature is variadic when its LAST parameter is `...name: T` (the grammar
// permits it only there). The interned param type stays the element type T —
// the seed does the same, and call-site arity checking reads the flag.
fn paramsAreVariadic(c: Checker, paramsNode: int): bool {
  let params = kidsOf(c.tree, paramsNode)
  if (len(params) == 0) {
    return false
  }
  return getNode(c.tree, params[len(params) - 1]).tag == Tag.ParamRest
}

fn funcTypeFromParams(c: Checker, paramsNode: int, resultTy: int): int {
  return mkFunc(
    c.ctx, paramTypeIds(c, paramsNode),
    paramsAreVariadic(c, paramsNode), resultTy,
  )
}

// The type to resolve a method call against: a constrained type parameter `T`
// dispatches through its constraint interface, so `s.area()` (s: T, `T: Shape`)
// resolves on Shape. Any other type is its own receiver.
fn methodRecvType(c: Checker, recvType: int): int {
  if (c.ctx.types[recvType].kind != TypeKind.TypeParam) {
    return recvType
  }
  let cons = c.typeParamConstraints[recvType]
  if (cons != 0) {
    return cons
  }
  return recvType
}

fn userTypeLookup(c: Checker, name: string): int {
  let (v, ok) = c.userTypes[name]
  if (ok) {
    return v
  }
  return 0
}

// `genNode`'s OWN type parameter named `name` -> its TypeId, or 0. The
// answer #4602's six save/rebind/restore sites exist to fake by rebinding
// `userTypes` around one declaration at a time: `genericParamIds` is already
// keyed by decl NODE (registerGenerics, `checkbinddecl.bit`), not by name, so
// two decls each declaring an `A` live under two different `genNode` keys —
// never one flat slot the second overwrites. `genNode` is the generics-list
// node itself (`<T, U>`), exactly what `bindGenericScope` and
// `registerGenerics` above already take, so a caller that already has it (all
// of #5701/#5702's six do) needs no resolver hop to use this.
fn typeParamIdOf(c: Checker, genNode: int, name: string): int {
  let (ids, ok) = c.genericParamIds[genNode]
  if (!ok) {
    return 0
  }
  let ps = kidsOf(c.tree, genNode)
  // SAME GUARD AS `bindGenericScope`, and for the same reason it gives: a
  // length mismatch means `ids` is not THIS decl's own list, so pairing
  // `ps[i]` with `ids[i]` would answer from someone else's parameters. A
  // `min(len)` loop answers anyway, from a truncated pairing, which is the
  // silent wrong answer #4602 exists to remove. Refuse instead.
  if (len(ids) != len(ps)) {
    return 0
  }
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    if (c.source[nm.span.start:nm.span.end] == name) {
      return ids[i]
    }
    i = i + 1
  }
  return 0
}

// name -> TypeId from the scope env, or 0 (invalid) if unbound. ponytail: linear
// scan pending map comma-ok lowering. [[bit-maps]]
fn envLookup(c: Checker, name: string): int {
  for (k, v) of c.env {
    if (k == name) {
      return v
    }
  }
  return 0
}

// The type of an IMPORTED name, read from the EXPORTING module's `moduleEnv` —
// module state and consts, which is the only thing `importName` copies into
// `env` — or 0 for an imported function or type, whose type comes from
// `funcSigs`/`funcResults`/`userTypes` instead.
//
// Read at the source, not through this module's `env`, because the copy lands
// under a bare alias that any same-named local parameter overwrites. That is the
// ORIGINAL #4570 report: `static.test.bit` imported `run` from `std/os` and a
// test helper two files away declared `ruleFailure(run: () => ()!)`, so every
// `run(...)` in the module typed at the parameter's signature and the diagnostic
// landed on the importing file, which names neither declaration.
fn importedEnvType(c: Checker, sym: Symbol): int {
  let m = sym.importedFromModule
  if (m < 0 || m >= len(c.mods)) {
    return 0
  }
  let e = c.mods[m]
  let tid = sym.importedFromSymbol
  if (tid <= 0 || tid >= len(e.symbols)) {
    return 0
  }
  let (v, ok) = e.moduleEnv[e.symbols[tid].name]
  if (ok) {
    return v
  }
  return 0
}

// What `envLookup` should have been: the type of the identifier at `node`, taken
// from the declaration the RESOLVER bound it to instead of from a name.
//
// `Checker.env` is keyed by NAME ONLY and flat across the whole module, and
// `bindParamOrReceiver`/`checkBinding`/`importName` all write it, so `envLookup`
// answers for a name as soon as ANY function anywhere in the module binds it.
// That is the #4570 leak: a parameter `helper: () => string` made every
// `helper(...)` in the module — including calls to the top-level
// `fn helper(n: int): int` in another FILE, since a module's files share one
// arena — type at the parameter's function type. In one file that SEGFAULTED
// (an i64 result typed `string`, then interpolated) with `bit check` exiting 0;
// across two it reported E0041 at the innocent file, naming neither declaration
// that collided. It was never only about functions either: `MyInt(5)`,
// `len("abcd")` and an imported `run(...)` were all retyped the same way.
//
// Three answers, and no name-keyed guess left in any of them:
//   - an IMPORTED name -> the exporting module's own table (`importedEnvType`);
//   - a NAMESPACE alias -> NO value type at all (0). An alias is bound only
//     under dotted "ns.member" keys (`bindNamespaceImport`), never as a value
//     in its own right, so the bare name it is spelled with has no entry of
//     its own and `envLookup` on it can only answer with some OTHER binding.
//     It did: `env` is flat and module-wide, so a `let strings = Wrap{}` in
//     ANY function typed the receiver of a genuine `strings.trim(s, cut)` in
//     every other function as `Wrap`, and `vMethodCall` (validatemethodcall.bit)
//     then judged the call against `Wrap.trim` — `error[E0050]: expected 1
//     argument(s), found 2` on correct code (#4665). Answering 0 hands the
//     caller back to the namespace path (`nsQualifiedName`), which is
//     node-keyed since #4660 and is the only thing that may resolve an alias;
//   - everything else -> `declTypes` at the decl node (`declRefType`), which is
//     0 for a free function, class, alias or builtin, so the caller falls
//     through to `funcSigs`/`funcResults`/`userTypes`/`primIndexByName` — the
//     declaration tables no parameter ever writes.
//
// `declRefType` rather than `envLookup` even for a plain local or parameter,
// which the main sweep does rebind correctly: pre-pass 3 writes EVERY parameter
// in the module before pre-pass 3a types a `for v of cb()` header, so `envLookup`
// there answered with the last same-named parameter in the arena rather than
// this function's own.
//
// Falls back to the name path only when the node resolves to no symbol at all —
// the resolver-less dump entry points (`nodeSymbols` empty), see `declRefType`.
fn identEnvType(c: Checker, node: int, name: string): int {
  if (node <= 0 || node >= len(c.nodeSymbols)) {
    return envLookup(c, name)
  }
  let sid = c.nodeSymbols[node]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return envLookup(c, name)
  }
  if (c.symbols[sid].kind == SymbolKind.ImportItem) {
    return importedEnvType(c, c.symbols[sid])
  }
  if (c.symbols[sid].kind == SymbolKind.ImportNamespace) {
    return 0
  }
  return declRefType(c, node)
}

fn funcResultLookup(c: Checker, name: string): int {
  let (v, ok) = c.funcResults[name]
  if (ok) {
    return v
  }
  return 0
}

// The full `(params) => result` type of a free function used as a value, or 0.
fn funcSigLookup(c: Checker, name: string): int {
  let (v, ok) = c.funcSigs[name]
  if (ok) {
    return v
  }
  return 0
}

// The FuncDecl node for a free function, or 0. An imported name's decl lives in
// the exporting module's tree, so the lookup follows the import — callers that
// then read the node MUST read it against `declOwner(c, name).tree`.
fn funcDeclLookup(c: Checker, name: string): int {
  // A locally-declared function shadows a same-named prelude/import (§17.5): the
  // user's own name wins, matching the resolver's rInjectPrelude and the seed.
  // Consulting the import first mis-resolved a local `unwrap` to the prelude's
  // generic `unwrap<T>`, so `genericResultAt` bound a phantom type param and the
  // call's type came out as the argument's rather than the declared result.
  let (v, ok0) = c.funcDecls[name]
  if (ok0) {
    return v
  }
  let (o, ok) = c.importedFrom[name]
  if (ok && o.module >= 0 && o.module < len(c.mods)) {
    let e = c.mods[o.module]
    let (ev, ok1) = e.funcDecls[o.name]
    if (ok1) {
      return ev
    }
  }
  return 0
}

// A free function's declaration, paired with the module that owns the tree the
// decl node indexes. The two are inseparable — a node index only means anything
// inside its own tree — so every site that needs one needs the other, and
// resolving them together makes it impossible to pair a decl with the wrong
// tree. `decl == 0` means "no free function", and `owner` is then `c`.
//
// `declName` is the name the OWNER declares it under, which differs from the
// spelling at the use site whenever an import renames it
// (`import { readFile as slurp }`). Both the instantiation ledger and the link
// symbol are built from it, so an alias never reaches either.
class FuncRef {
  owner: Checker,
  decl: int,
  declName: string,
}

// The free function the identifier at `node` names, resolved through the
// RESOLVER's per-node symbol table rather than by name (#1502).
//
// `funcDeclLookup`/`declOwner` answer from `name` alone, against a module-wide
// map, with a hand-rolled "a local declaration beats an import" loop standing in
// for scope. That is the flat-namespace hazard this codebase keeps paying for: a
// name is not a binding, and only the node knows which binding it is. The
// resolver already computed that — a `Func` symbol carries its own decl node,
// and an `ImportItem` carries the module and symbol it aliases, which is exactly
// the owner hop `declOwner` reconstructs by guessing.
//
// A node the resolver bound to a VALUE — a local, const, param or receiver of
// the same name — answers "there is NO free function here" (#1552). Per SPEC
// §17.5 the nearer binding wins outright, so the declaration is not a candidate
// and must not be reached by name. This is the same question `shadowedByValue`
// answers for the validators; keeping the two in step is what stops the checker
// and the lowerer disagreeing about which callee a shadowed name denotes.
//
// Falls back to the name path only when the node resolves to no symbol at all:
// the resolver-less dump entry points (`nodeSymbols` empty) and a qualified
// `ns.member` callee, whose dotted key has no single ident node to bind.
fn funcRefAt(c: Checker, node: int, name: string): FuncRef {
  // A BARE name only. `nodeSymbols` binds identifiers; a dotted `ns.fn` callee
  // is a Member node the resolver never bound to one symbol, and `name` there is
  // the dotted key the name-keyed tables use. Trusting the node for it would
  // silently answer "unresolved" for every namespaced call.
  if (node > 0 && node < len(c.nodeSymbols) && getNode(c.tree, node).tag == Tag.Ident) {
    let sid = c.nodeSymbols[node]
    if (sid > 0 && sid < len(c.symbols)) {
      let sym = c.symbols[sid]
      if (sym.kind == SymbolKind.Func && sym.decl != 0) {
        return FuncRef{ owner = c, decl = sym.decl, declName = sym.name }
      }
      // Bound to a VALUE: the shadow is decisive, so stop here rather than
      // falling through to the name path, which would find the very declaration
      // §17.5 says this name no longer denotes.
      if (sym.kind == SymbolKind.LetBinding ||
        sym.kind == SymbolKind.ConstBinding ||
        sym.kind == SymbolKind.Param ||
        sym.kind == SymbolKind.Receiver) {
        return FuncRef{ owner = c, decl = 0, declName = "" }
      }
      if (sym.kind == SymbolKind.ImportItem) {
        let m = sym.importedFromModule
        if (m >= 0 && m < len(c.mods)) {
          let e = c.mods[m]
          let tid = sym.importedFromSymbol
          if (tid > 0 && tid < len(e.symbols)) {
            let tgt = e.symbols[tid]
            if (tgt.kind == SymbolKind.Func && tgt.decl != 0) {
              return FuncRef{ owner = e, decl = tgt.decl, declName = tgt.name }
            }
          }
        }
      }
    }
  }
  return FuncRef{
    owner = declOwner(c, name), decl = funcDeclLookup(c, name),
    declName = declName2(c, name),
  }
}

// The link name for a call to the RESOLVED function `fr`, from a build rooted at
// module `root`. The same three rules as `callQualified` — §11.7 extern, §11.9
// pin, then module qualification — with nothing left to guess: owner, declared
// name and decl node all come from the callee's resolved symbol, so neither an
// import alias nor a local shadowing a same-named import can reach the object
// file. Requires `fr.decl != 0`.
fn callQualifiedRef(root: int, fr: FuncRef): string {
  // SPEC 11.7: an extern symbol is NEVER module-qualified — the raw name is
  // precisely the symbol the linker must import from the dylib.
  let (_, isExtern) = fr.owner.externFns[fr.declName]
  if (isExtern) {
    return fr.declName
  }
  // SPEC 11.9: a pinned function's DEFINITION is emitted under the pinned name
  // (lowerFuncNamed), bypassing module qualification, so a call to it must be
  // spelled the same way. Without this the definition lands as `bit_rt_f` while
  // the call emits `m<id>$f` — an unresolvable reference that fails far from its
  // cause. Checked AFTER extern so an `extern function` (which has no attribute
  // list at kid 6) never reaches funcAttrArg; §11.7 consumes a symbol, §11.9
  // produces one, and the two are disjoint by construction.
  let pin = funcAttrArg(fr.owner, fr.decl, "symbol")
  if (pin != "") {
    return pin
  }
  return moduleQualified(fr.owner.moduleId, root, fr.declName)
}

// The callee node of a Call, or 0 for anything else — the node `funcRefAt` keys
// on. Guarded rather than assumed: several callers pass a `callNode` that is
// only SOMETIMES a Call (see `explicitCallTypeArgs`), and reading kid 0 of a
// non-Call would key the lookup on an unrelated node. A non-Ident callee needs
// no guard here; `funcRefAt` is the one place that decides what it can trust.
fn calleeNodeOf(c: Checker, callNode: int): int {
  if (callNode <= 0 || callNode >= len(c.tree.nodes)) {
    return 0
  }
  if (getNode(c.tree, callNode).tag != Tag.Call) {
    return 0
  }
  return kidsOf(c.tree, callNode)[0]
}

// Copies every entry whose key is exactly `orig`, or is prefixed `orig.` (a
// type's fields and methods are keyed "Type.member"), rebinding the key's
// leading name to `alias`. Named `orig`/`alias` because `from` is a keyword.
fn copyQualified(dst: map<string, int>, src: map<string, int>, orig: string, alias: string) {
  for (k, v) of src {
    if (k == orig) {
      dst[alias] = v
      continue
    }
    if (len(k) > len(orig) && k[0:len(orig)] == orig && k[len(orig)] == '.') {
      dst[alias + k[len(orig):len(k)]] = v
    }
  }
}

// Binds `name` (as declared in module `mid`'s checker `e`) into `c` under
// `alias`. TypeIds are global to the shared TypeContext, so the type side of an
// import is a plain copy — which is what lets the rest of the checker stay
// name-keyed and completely unaware that modules exist. Only the declaration
// NODE cannot be copied; it stays in the exporter's tree, reached via declOwner.
fn importName(c: Checker, e: Checker, mid: int, name: string, alias: string) {
  c.importedFrom[alias] = ImportOrigin{ module = mid, name = name }
  copyQualified(c.funcResults, e.funcResults, name, alias)
  copyQualified(c.funcSigs, e.funcSigs, name, alias)
  copyQualified(c.userTypes, e.userTypes, name, alias)
  // A module-level `export const` records its type in `env` (checkBinding), and
  // an importer that cannot type the name cannot use it at all: `${pi}` has no
  // idea what to interpolate. The exporting module is fully checked before this
  // runs (module ids are dependency order), so its env holds the const already.
  // From `moduleEnv`, never `env`: see the field comment. A local shadowing an
  // exported name is legal Bit (E0048 is only a warning), so reading the flat
  // env here handed the importer the shadowing local's type.
  copyQualified(c.env, e.moduleEnv, name, alias)
  // Fields and methods are NOT copied: they live on the type in the shared
  // TypeContext, so they resolve from any module that can name the type at all.
}

// The declaration of method `mname` on receiver type `recvTy`, paired with the
// module whose tree the node indexes — a `FuncRef`, exactly as a free
// function's declaration is resolved, so the two share every downstream
// mechanism (`funcRefIsGeneric`, `recordInstantiation`, `instantiationIndex`,
// `lowerInstance`). `decl == 0` means "not a declared method here": an
// interface's own signature, which has no FuncDecl at all, and a namespaced
// `ns.f(...)` callee, whose base is not a value, both answer that way.
//
// `declName` is the ledger and link spelling `<name>$t<recvTy>` rather than the
// bare method name. It has to be UNIQUE project-wide because the instantiation
// ledger is keyed on it: two classes may declare a `get`, and `$` cannot occur
// in a Bit identifier, so this can never collide with a free function's name
// either.
//
// The owner falls back to `c` when `mods` is empty — the single-source dump
// entry points (`--dump-ir`) never populate it, and there is then no other
// module the decl could belong to.
fn methodRefAt(c: Checker, recvTy: int, mname: string): FuncRef {
  let none = FuncRef{ owner = c, decl = 0, declName = "" }
  if (recvTy <= 0) {
    return none
  }
  let (decl, ok) = c.ctx.methodDecls["${recvTy}.${mname}"]
  if (!ok || decl == 0) {
    return none
  }
  let owner = c
  let (mod, okm) = c.ctx.methodDeclMods["${recvTy}.${mname}"]
  if (okm && mod >= 0 && mod < len(c.mods)) {
    owner = c.mods[mod]
  }
  return FuncRef{ owner = owner, decl = decl, declName = "${mname}\$t${recvTy}" }
}

// How many type params the METHOD `decl` declares for ITSELF. The parser merges
// a generic receiver's `<...>` in FRONT of the method's own (parserdecl), so the
// declaration's one list covers both and only the tail belongs to the method:
// `(p: Pair<A, B>) first()` answers 0, `nameOf<T: Named>(v: T)` answers 1.
//
// This is the whole difference between the two lowering paths. A method with
// none of its own is emitted once per receiver (or once per nominal
// instantiation of a generic receiver); a method with its own is monomorphized
// through the instantiation ledger like any generic function (#4495).
fn methodOwnGenericCount(oc: Checker, decl: int): int {
  let k = kidsOf(oc.tree, decl)
  if (k[0] == 0 || k[2] == 0) {
    return 0
  }
  return len(kidsOf(oc.tree, k[2])) -
    len(declTypeParamIds(oc, typeNodeName(oc, kidsOf(oc.tree, k[0])[1])))
}
