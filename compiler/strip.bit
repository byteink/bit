// Self-host Stage 3 (#1344): symbol resolution, dead-strip, and relocation
// arithmetic over the generic object model.
// Shared by every executable writer — none of this depends on the output
// container. Given a set of modules it builds the whole-link global symbol
// table, walks the relocation graph from the entry roots to decide which atoms
// survive (so libbitrt.a + compiler-rt do not drag their whole std-lib closure
// into every image), and applies one relocation to its field bytes given the
// resolved addresses.

// ---- little-endian writes -------------------------------------------------

fn loWrU32(b: []u8, off: int, v: int) {
  b[off] = u8(v & 255)
  b[off + 1] = u8((v >> 8) & 255)
  b[off + 2] = u8((v >> 16) & 255)
  b[off + 3] = u8((v >> 24) & 255)
}

fn loWrU64(b: []u8, off: int, v: int) {
  loWrU32(b, off, v & 0xFFFFFFFF)
  loWrU32(b, off + 4, (v >> 32) & 0xFFFFFFFF)
}

// ---- whole-link symbol table ----------------------------------------------

// Identifies one atom across the whole link: which module, and its index in that
// module's atoms. Packed into one int for map keys, exactly as the seed packs it
// into a u64.
fn atomKey(module: int, atom: int): int {
  return (module << 32) | atom
}

fn atomKeyModule(k: int): int {
  return k >> 32
}

fn atomKeyAtom(k: int): int {
  return k & 0xFFFFFFFF
}

// name -> packed AtomId, over every global-binding atom in every module.
//
// Strong overrides weak; two weak definitions keep the first; two strong
// definitions are a real conflict (e.g. a runtime symbol a Bit program also
// defined). compiler-rt supplies many weak defaults (memcpy, strlen, ...) that
// the runtime may strong-override.
fn resolveGlobals(modules: []LoModule): map<string, int>! {
  let table = map<string, int>{}
  let mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let atom = atoms[ai]
      if (atom.binding != LoBinding.Global) {
        ai = ai + 1
        continue
      }
      let (existingKey, found) = table[atom.name]
      if (found) {
        let ex = modules[atomKeyModule(existingKey)].atoms[atomKeyAtom(existingKey)]
        if (ex.weak && !atom.weak) {
          table[atom.name] = atomKey(mi, ai)
        } else if (!ex.weak && !atom.weak) {
          fail newError("DuplicateSymbol")
        }
        ai = ai + 1
        continue
      }
      table[atom.name] = atomKey(mi, ai)
      ai = ai + 1
    }
    mi = mi + 1
  }
  return table
}

// A name that something references (or the container demands) and nothing has
// defined yet — exactly the condition that pulls an archive member in. Mirrors
// the seed's strip.isOutstanding.
fn saIsOutstanding(name: string, defined: map<string, bool>, wanted: map<string, bool>): bool {
  let (_, isWanted) = wanted[name]
  let (_, isDefined) = defined[name]
  return isWanted && !isDefined
}

// Adds `mod`'s global definitions to `defined`. Mirrors strip.noteDefinitions.
fn saNoteDefinitions(mod: LoModule, defined: map<string, bool>) {
  for atom of mod.atoms {
    if (atom.binding != LoBinding.Global) { continue }
    defined[atom.name] = true
  }
}

// Records every global `mod` references. A name nothing ever defines simply
// stays outstanding forever (the libSystem imports on Mach-O are exactly that)
// and pulls nothing. Mirrors strip.noteReferences.
fn saNoteReferences(mod: LoModule, wanted: map<string, bool>) {
  for atom of mod.atoms {
    for r of atom.relocs {
      if (!r.target.isGlobal) { continue }
      wanted[r.target.name] = true
    }
  }
}

fn saDefinesAnyOutstanding(mod: LoModule, defined: map<string, bool>, wanted: map<string, bool>): bool {
  for atom of mod.atoms {
    if (atom.binding != LoBinding.Global) { continue }
    if (saIsOutstanding(atom.name, defined, wanted)) { return true }
  }
  return false
}

// Selects which archive members take part in the link, per the standard
// static-archive rule: a member is pulled in ONLY to satisfy a symbol that is
// undefined at the moment it is considered. `eager` is every explicit object
// input (always loaded, always winning), `candidates` is every member of every
// archive in archive order, and `roots` names the symbols the container itself
// demands (the entry point), which no object references.
//
// Why this is a correctness requirement and not an output-size optimization
// (#1647): a program that compiles a runtime module FROM SOURCE defines the same
// ABI names the archive's copy of that module defines. Loading every member
// unconditionally makes that a DuplicateSymbol — 38 of the 55 host-runnable
// tests/stress programs, none of which any renaming can avoid, because the
// collision is between a program's own definition and the archive's. Under this
// rule the program's own definition satisfies the reference, the archive's
// member is never read, and there is nothing to collide with.
//
// Pulling a member can leave NEW symbols undefined, which may pull further
// members, so this iterates to a fixed point. The bound is real, not hopeful:
// every round either takes at least one member or stops, and there are finitely
// many members, so len(candidates) + 1 rounds is an upper limit.
//
// What this deliberately does NOT do is weaken the duplicate diagnostic. Two
// explicit objects defining one strong symbol are both `eager` and still collide
// in resolveGlobals; so do two archive members that both get pulled. Laziness
// changes WHICH members enter the link, never what happens to the ones that do.
// Mirrors the seed's strip.selectArchiveMembers.
fn selectArchiveMembers(eager: []LoModule, candidates: []LoModule, roots: []string): []LoModule {
  // Two monotone sets, never erased from. "Still undefined" is the DERIVED
  // predicate wanted && !defined (saIsOutstanding), not a third set kept in step
  // by hand: a reference is satisfied the instant something defines the name,
  // and there is no order of updates that can get that wrong.
  let defined = map<string, bool>{}
  let wanted = map<string, bool>{}

  for name of roots {
    wanted[name] = true
  }
  for mod of eager {
    saNoteDefinitions(mod, defined)
    saNoteReferences(mod, wanted)
  }

  let taken = []bool(len(candidates))
  let rounds = 0
  while (rounds <= len(candidates)) {
    let progress = false
    let i = 0
    while (i < len(candidates)) {
      if (taken[i] || !saDefinesAnyOutstanding(candidates[i], defined, wanted)) {
        i = i + 1
        continue
      }
      taken[i] = true
      progress = true
      saNoteDefinitions(candidates[i], defined)
      saNoteReferences(candidates[i], wanted)
      i = i + 1
    }
    if (!progress) {
      break
    }
    rounds = rounds + 1
  }

  // Emitted in archive order rather than pull order, so a member's position in
  // the link depends only on the archive, not on the order references happened
  // to be discovered in.
  let out = []LoModule(0)
  let j = 0
  while (j < len(candidates)) {
    if (taken[j]) {
      out = append(out, candidates[j])
    }
    j = j + 1
  }
  return out
}

// Resolves one relocation target to the atom it names: a local target is an
// index into moduleIdx's own atoms; a global target goes through the whole-link
// table.
//
// `fromName` is the referencing module's own name, and it exists so the failure
// can SAY what it could not resolve (#1646): a bare "UndefinedSymbol" told the
// user only that something was missing, which is the one thing they already
// knew. Bit errors carry a message, so the failure names the unresolved symbol
// and the module that wanted it.
fn resolveRefFrom(globals: map<string, int>, moduleIdx: int, ref: LoSymbolRef,
    fromName: string): int! {
  if (!ref.isGlobal) {
    return atomKey(moduleIdx, ref.local)
  }
  let (k, found) = globals[ref.name]
  if (!found) {
    fail newError("undefined symbol '${ref.name}', referenced from ${fromName}")
  }
  return k
}

// resolveRefFrom for the callers that have no module name in hand. The name is
// what a diagnostic gains, never what resolution depends on.
fn resolveRef(globals: map<string, int>, moduleIdx: int, ref: LoSymbolRef): int! {
  return resolveRefFrom(globals, moduleIdx, ref, "?")?
}

// Marks every atom reachable from `roots` (global symbol names — the entry
// _start, plus anything the container must keep regardless) by walking each kept
// atom's relocations transitively. Everything unmarked is dead and the driver
// drops it. An explicit work stack (not recursion) keeps the traversal bounded
// and stack-safe over libbitrt's large call graph.
//
// This walk is where a static link discovers that nothing defines a name, so it
// is where the failure is NAMED (#1646). It runs after selectArchiveMembers has
// reached its fixed point, which is what makes the answer trustworthy under
// #1647's lazy member loading: a symbol is undefined only once no further member
// can be pulled to satisfy it, never on a first pass.
fn deadStrip(modules: []LoModule, globals: map<string, int>, roots: []string): map<int, bool>! {
  let kept = map<int, bool>{}
  let stack = []int(0)
  let i = 0
  while (i < len(roots)) {
    let (id, found) = globals[roots[i]]
    if (!found) {
      fail newError("undefined symbol '${roots[i]}', referenced from link roots")
    }
    let (_, already) = kept[id]
    if (!already) {
      kept[id] = true
      stack = append(stack, id)
    }
    i = i + 1
  }

  while (len(stack) > 0) {
    let id = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    let cur = modules[atomKeyModule(id)].atoms[atomKeyAtom(id)]
    let r = 0
    while (r < len(cur.relocs)) {
      let target = resolveRefFrom(globals, atomKeyModule(id), cur.relocs[r].target,
        modules[atomKeyModule(id)].name)?
      let (_, already) = kept[target]
      if (!already) {
        kept[target] = true
        stack = append(stack, target)
      }
      r = r + 1
    }
  }
  return kept
}

// ---- GC stack-map merge (ABI.md §4) ---------------------------------------

// The linker-defined bounds of the merged GC stack-map table. No object defines
// either: the table spans every archive member that carries entries, so a
// per-object definition would be a duplicate symbol, and a per-object
// terminator would stop the runtime's walk at the first member's last entry.
// The runtime externs both and walks the half-open extent between them.
fn stackmapsStartSymbol(): string {
  return "bit_stack_maps"
}

fn stackmapsEndSymbol(): string {
  return "bit_stack_maps_end"
}

// Index of the boundary atoms within the marker module's atom slice.
fn markerStartAtom(): int {
  return 0
}

fn markerEndAtom(): int {
  return 1
}

// Builds the synthetic module holding the two boundary atoms. Both are
// zero-size and 1-aligned so they contribute no bytes and force no padding —
// they exist only to be given addresses at the ends of the merged group.
//
// `symPrefix` is the container's C symbol mangling ("" on ELF, "_" on Mach-O).
// It is a parameter rather than a constant because these names must match the
// runtime's extern spelling exactly, and an unprefixed name on Mach-O does not
// fail at link — it falls through to a libSystem import and aborts at dyld
// load, far from its cause.
//
// Always present, even when nothing carries stack maps: the runtime's extern
// references must resolve, and an empty extent (start == end) is the right
// answer for a program with no Bit frames to walk.
fn markerModule(symPrefix: string): LoModule {
  let atoms = []LoAtom(0)
  atoms = append(atoms, LoAtom{ name: "${symPrefix}${stackmapsStartSymbol()}",
    kind: LoSectionKind.GcMeta, binding: LoBinding.Global, data: []u8(0),
    size: 0, alignment: 1, weak: false, relocs: []LoReloc(0) })
  atoms = append(atoms, LoAtom{ name: "${symPrefix}${stackmapsEndSymbol()}",
    kind: LoSectionKind.GcMeta, binding: LoBinding.Global, data: []u8(0),
    size: 0, alignment: 1, weak: false, relocs: []LoReloc(0) })
  return LoModule{ name: "<gc stack maps>", atoms: atoms }
}

// Orders the merged group: the start marker, then every retained entry, then
// the end marker. The driver appends this run to one output group WITHOUT
// interruption, which is what makes the runtime's linear walk valid — the
// entries carry no count and no terminator, only these two bounds.
//
// `kept` is updated in place with every entry selected. Retention is decided
// HERE, and both effects belong to this one call, for two reasons that were
// each paid for during this change:
//   - a driver that skipped a separate retention pass would emit an EMPTY
//     extent, and the program would link, run, and silently collect live
//     objects. That happened on the Mach-O driver, and a mutation test showed
//     the host-native suite cannot see the same omission on the ELF driver.
//   - an entry that is placed but not in `kept` never has its relocations
//     applied, so its codeAddr stays zero and the collector reads a code range
//     at address 0 — a live-looking table with dead contents.
// One call that cannot be half-applied removes both instead of guarding them.
//
// The rule itself: an entry is retained exactly when the function it describes
// is retained. It cannot be a dead-strip ROOT — an entry relocates to its
// function, so rooting the entries would retain every function of every runtime
// module in every image, defeating dead-strip entirely. Nor can it be left to
// ordinary reachability, per above. Deciding it after deadStrip also needs no
// fixpoint: an entry's only relocation targets its own function, which is by
// then already kept, so keeping an entry can never make a further atom
// reachable.
fn mergedStackMapAtoms(modules: []LoModule, globals: map<string, int>,
    kept: map<int, bool>, markerModuleIdx: int): []int! {
  let out = []int(0)
  out = append(out, atomKey(markerModuleIdx, markerStartAtom()))
  let mi = 0
  while (mi < len(modules)) {
    if (mi != markerModuleIdx) {
      let atoms = modules[mi].atoms
      let ai = 0
      while (ai < len(atoms)) {
        let atom = atoms[ai]
        if (atom.kind == LoSectionKind.GcMeta && atom.binding != LoBinding.Global) {
          let r = 0
          while (r < len(atom.relocs)) {
            let target = resolveRef(globals, mi, atom.relocs[r].target)?
            let (_, live) = kept[target]
            if (live) {
              kept[atomKey(mi, ai)] = true
              out = append(out, atomKey(mi, ai))
              r = len(atom.relocs)
            } else {
              r = r + 1
            }
          }
        }
        ai = ai + 1
      }
    }
    mi = mi + 1
  }
  out = append(out, atomKey(markerModuleIdx, markerEndAtom()))
  return out
}

// ---- relocation arithmetic ------------------------------------------------

// The values a single relocation's arithmetic can need — the driver fills in
// whichever apply to the kind. `s` is the target atom's final address plus the
// reloc addend already (S + A); `p` is the field's own final address; `gotSlot`
// is the address of the target's GOT entry (GOT kinds only); `tpOffset` is the
// target's offset from the thread pointer (TLS kinds only, negative under the
// x86-64 variant-II local-exec model).
class RelocValues {
  s: int,
  p: int,
  gotSlot: int,
  tpOffset: int,
}

fn noValues(): RelocValues {
  return RelocValues{ s: 0, p: 0, gotSlot: 0, tpOffset: 0 }
}

// Applies one relocation into `data` at `off` (the reloc's bytes within its
// atom's data). The seed passes an already-sliced field; passing base+offset
// avoids depending on slice aliasing to write through.
fn applyReloc(kind: LoRelocKind, data: []u8, off: int, v: RelocValues): ()! {
  if (kind == LoRelocKind.Abs64) {
    loWrU64(data, off, v.s)
    return
  }
  if (kind == LoRelocKind.Abs32) {
    loWrU32(data, off, v.s & 0xFFFFFFFF)
    return
  }
  if (kind == LoRelocKind.Abs32Signed) {
    if (v.s < 0 - 2147483648 || v.s > 2147483647) {
      fail newError("RelocationOutOfRange")
    }
    loWrU32(data, off, v.s & 0xFFFFFFFF)
    return
  }
  if (kind == LoRelocKind.Pc32) {
    writePcRel32(data, off, v.s, v.p)?
    return
  }
  if (kind == LoRelocKind.Got32) {
    writePcRel32(data, off, v.gotSlot, v.p)?
    return
  }
  if (kind == LoRelocKind.Tpoff32) {
    // Variant II local-exec: value = S's thread-pointer offset + A. `tpOffset`
    // already folds the addend, so this writes it straight as a signed 32-bit
    // displacement.
    if (v.tpOffset < 0 - 2147483648 || v.tpOffset > 2147483647) {
      fail newError("RelocationOutOfRange")
    }
    loWrU32(data, off, v.tpOffset & 0xFFFFFFFF)
    return
  }

  // ---- AArch64 instruction-field kinds (Mach-O arm64 executable) ----------
  // Each patches a 4-byte little-endian instruction word in place. `s` already
  // folds the addend; GOT/TLVP kinds address their indirection slot via gotSlot.
  if (kind == LoRelocKind.Aarch64Call26 || kind == LoRelocKind.Aarch64Jump26) {
    writeBranch26(data, off, v.s, v.p)?
    return
  }
  if (kind == LoRelocKind.Aarch64AdrPrelPgHi21) {
    writeAdrp(data, off, v.s, v.p)?
    return
  }
  if (kind == LoRelocKind.Aarch64AdrGotPage || kind == LoRelocKind.Aarch64TlvpAdrPage21) {
    writeAdrp(data, off, v.gotSlot, v.p)?
    return
  }
  if (kind == LoRelocKind.Aarch64AddAbsLo12Nc || kind == LoRelocKind.Aarch64Ldst8AbsLo12Nc) {
    writeLo12(data, off, v.s, 0)
    return
  }
  if (kind == LoRelocKind.Aarch64Ldst16AbsLo12Nc) {
    writeLo12(data, off, v.s, 1)
    return
  }
  if (kind == LoRelocKind.Aarch64Ldst32AbsLo12Nc) {
    writeLo12(data, off, v.s, 2)
    return
  }
  if (kind == LoRelocKind.Aarch64Ldst64AbsLo12Nc) {
    writeLo12(data, off, v.s, 3)
    return
  }
  if (kind == LoRelocKind.Aarch64Ldst128AbsLo12Nc) {
    writeLo12(data, off, v.s, 4)
    return
  }
  if (kind == LoRelocKind.Aarch64Ld64GotLo12Nc || kind == LoRelocKind.Aarch64TlvpLd64Lo12) {
    writeLo12(data, off, v.gotSlot, 3)
    return
  }
  // AArch64 local-exec TLS (Variant I): X = TPREL(S) + A, already folded into
  // tpOffset by the driver. The pair sets an ADD immediate to bits [23:12]
  // (HI12) and [11:0] (LO12) of X, together covering a 24-bit thread-pointer
  // offset.
  assert(kind == LoRelocKind.TlsleAddTprelHi12 || kind == LoRelocKind.TlsleAddTprelLo12Nc)
  let x = v.tpOffset
  if (x < 0 || x >= (1 << 24)) {
    fail newError("RelocationOutOfRange")
  }
  let bits12 = x
  if (kind == LoRelocKind.TlsleAddTprelHi12) {
    bits12 = x >> 12
  }
  writeLo12(data, off, bits12, 0)
}

// BL/B imm26 = (target - P) >> 2, signed 26-bit, at instruction bits [25:0].
fn writeBranch26(data: []u8, off: int, target: int, p: int): ()! {
  let disp = target - p
  if (disp & 3 != 0) { // branch targets are 4-aligned
    fail newError("UnsupportedRelocation")
  }
  let imm = disp >> 2
  if (imm < 0 - (1 << 25) || imm >= (1 << 25)) {
    fail newError("RelocationOutOfRange")
  }
  loWrU32(data, off, (loRdU32(data, off) & 0xFC000000) | (imm & 0x03FFFFFF))
}

// ADRP imm21 = (page(target) - page(P)) >> 12, split into immlo (bits [30:29])
// and immhi (bits [23:5]). page(x) = x & ~0xfff.
fn writeAdrp(data: []u8, off: int, target: int, p: int): ()! {
  let pageMask = ~0xFFF
  let delta = (target & pageMask) - (p & pageMask)
  let imm = delta >> 12
  if (imm < 0 - (1 << 20) || imm >= (1 << 20)) {
    fail newError("RelocationOutOfRange")
  }
  let uimm = imm & 0x1FFFFF
  let immlo = uimm & 0x3
  let immhi = (uimm >> 2) & 0x7FFFF
  let insn = loRdU32(data, off)
  insn = insn & ~((0x3 << 29) | (0x7FFFF << 5))
  loWrU32(data, off, insn | (immlo << 29) | (immhi << 5))
}

// ADD/LDR/STR imm12 = (value & 0xfff) >> scale, at bits [21:10]. `scale` is the
// access-size log2 (0 for ADD and byte access, 3 for a 64-bit load).
fn writeLo12(data: []u8, off: int, value: int, scale: int) {
  let imm12 = (value & 0xFFF) >> scale
  let insn = loRdU32(data, off)
  insn = insn & ~(0xFFF << 10)
  loWrU32(data, off, insn | (imm12 << 10))
}

fn writePcRel32(data: []u8, off: int, target: int, p: int): ()! {
  let disp = target - p
  if (disp < 0 - 2147483648 || disp > 2147483647) {
    fail newError("RelocationOutOfRange")
  }
  loWrU32(data, off, disp & 0xFFFFFFFF)
}

// True for a relocation kind that must materialize a GOT slot for its target
// (the driver pre-scans kept atoms for these to size the GOT).
fn needsGot(kind: LoRelocKind): bool {
  return kind == LoRelocKind.Got32 || kind == LoRelocKind.Aarch64AdrGotPage ||
    kind == LoRelocKind.Aarch64Ld64GotLo12Nc
}

// True for a macOS thread-local kind that must materialize a __thread_ptr slot
// for its target tlv_descriptor (the driver sizes that table like the GOT).
fn needsTlvp(kind: LoRelocKind): bool {
  return kind == LoRelocKind.Aarch64TlvpAdrPage21 ||
    kind == LoRelocKind.Aarch64TlvpLd64Lo12
}

// True for a TLS-relative kind (its target lives in the TLS segment and resolves
// to a thread-pointer offset, not a virtual address).
fn isTlsKind(kind: LoRelocKind): bool {
  return kind == LoRelocKind.Tpoff32 || kind == LoRelocKind.TlsleAddTprelHi12 ||
    kind == LoRelocKind.TlsleAddTprelLo12Nc
}
