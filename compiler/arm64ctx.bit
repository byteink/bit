// Self-host Stage 3 (#1342): ARM64 per-function context, frame layout and
// parallel-move sequencing, split out of arm64.bit (#1503). Sibling .bit file,
// same module: see arm64.bit for the backend overview.

// ===========================================================================
// Per-function context
//
// Everything the instruction selectors read or append to while compiling one
// IrFunc. A backend context would also naturally carry an
// allocator and an `owned_syms` list to free the `__bitstr_N` symbol names it
// mints; both are manual memory bookkeeping with no counterpart here.
// ===========================================================================

class JumpFixup {
  patchOffset: int,
  // Condition code, or -1 for an unconditional B — Bit has no optional int and
  // no condition is negative.
  cond: int,
  target: int, // BlockId
}

class A64Ctx {
  module: IrModule,
  f: IrFunc,
  code: ByteBuf,
  relocs: []Reloc,
  // IR instruction index -> vreg (the allocator's dense numbering).
  instToVreg: []int,
  result: RegAllocResult,
  // Allocatable register index -> physical register number, per class.
  intRegs: []int,
  floatRegs: []int,
  frame: FrameInfo,
  blockOffsets: []int,
  jumpFixups: []JumpFixup,
  safepoints: []SafepointView,
  safepointPositions: []int,
  nextSafepointIdx: int,
  // #1853: `const_int` definitions consumed entirely by an ADD/SUB-immediate
  // fold, indexed by instruction id — `compileInst` skips materializing one
  // rather than writing a value nothing ever reads. See
  // `computeSkipConstMaterialize` (arm64dispatch.bit).
  skipConst: []bool,
  // #3843: icmp/fcmp definitions whose only use is the `br` immediately after
  // them, indexed by instruction id — the compare sets NZCV and the branch
  // reads it directly, so no boolean is ever materialized. See
  // `computeFuseCmpBranch` (arm64branch.bit).
  fuseCmp: []bool,
  // #3101 safety net: every physical register emission actually resolved a vreg
  // to, by register number. `compileFunction` asserts the callee-saved ones are
  // a subset of what the prologue saved, so `arm64WritesResult` drifting from
  // `compileInst` fails the build instead of silently dropping the caller's
  // value. Written on READS too (`getInt`/`getFloat`): reading a callee-saved
  // register this function never wrote would be a live-range bug in its own
  // right, so the wider set is the stronger invariant, not a looser one.
  wroteInt: []bool,
  wroteFloat: []bool,
  // Threaded from `bit build --debug` (#3077). Reaches every instruction
  // selector; nothing reads it yet — that is later codegen tickets'.
  debug: bool,
  // #3283: this function's debug-info rows so far, appended in final
  // code-emission order by appendDebugLineIfChanged (compiler/codegen.bit) as
  // compileFunction's block loop reaches each instruction.
  dbgRows: []DebugLineRow,
}

// #3101: notes that emission resolved a vreg to physical int register `r`.
fn noteIntReg(cx: A64Ctx, r: int): int {
  cx.wroteInt[r] = true
  return r
}

fn noteFloatReg(cx: A64Ctx, r: int): int {
  cx.wroteFloat[r] = true
  return r
}

// #3101: asserts the prologue saved every callee-saved register the two above
// recorded. Lives beside them rather than in `compileFunction` so the recorder
// and its check cannot be edited apart.
fn assertSavedCoversWrites(cx: A64Ctx) {
  let r = 0
  while (r < 32) {
    if (cx.wroteInt[r] && isCalleeSavedInt(r)) {
      assert(regInList(cx.frame.savedGpr, r))
    }
    if (cx.wroteFloat[r] && isCalleeSavedFloat(r)) {
      assert(regInList(cx.frame.savedFpr, r))
    }
    r = r + 1
  }
}

fn regInList(regs: []int, r: int): bool {
  let i = 0
  while (i < len(regs)) {
    if (regs[i] == r) {
      return true
    }
    i = i + 1
  }
  return false
}

fn codeLen(cx: A64Ctx): int {
  return len(cx.code.bytes)
}

// ---- relocations -----------------------------------------------------------

// BL with a placeholder imm26 the linker patches from the branch relocation.
fn emitCallReloc(cx: A64Ctx, symbol: string) {
  let off = codeLen(cx)
  emitWord(cx.code, 0x94000000)
  cx.relocs = append(cx.relocs, Reloc{ offset: off, symbol: symbol, kind: RelocKind.Branch })
}

// Materializes the address of a static symbol into `dst` via the AArch64
// ADRP/ADD pair (imm fields are 0 placeholders the linker patches from the
// page21/pageoff12 relocations). No movabs equivalent exists on AArch64; this is
// the standard PC-relative address-of sequence.
fn emitAddrOf(cx: A64Ctx, dst: int, symbol: string) {
  let adrpOff = codeLen(cx)
  emitWord(cx.code, 0x90000000 | dst) // ADRP dst, 0
  cx.relocs = append(cx.relocs, Reloc{ offset: adrpOff, symbol: symbol, kind: RelocKind.Page21 })
  let addOff = codeLen(cx)
  emitWord(cx.code, 0x91000000 | (dst << 5) | dst) // ADD dst, dst, #0
  cx.relocs = append(cx.relocs, Reloc{ offset: addOff, symbol: symbol, kind: RelocKind.PageOff12 })
}

// ---- branch fixups ---------------------------------------------------------

fn emitJumpFixup(cx: A64Ctx, target: int) {
  let off = codeLen(cx)
  emitWord(cx.code, 0x14000000) // B, imm26=0 placeholder
  cx.jumpFixups = append(cx.jumpFixups, JumpFixup{ patchOffset: off, cond: -1, target: target })
}

fn emitCondJumpFixup(cx: A64Ctx, cond: int, target: int) {
  let off = codeLen(cx)
  emitWord(cx.code, 0x54000000 | cond) // B.cond, imm19=0 placeholder
  cx.jumpFixups = append(cx.jumpFixups, JumpFixup{ patchOffset: off, cond: cond, target: target })
}

// Emits a B.cond to a not-yet-known LOCAL code offset (never a real IR block —
// used only to skip over one side of a `br`'s inline then/else code, resolved by
// patchLocalCondBranch as soon as that offset is known, unlike jumpFixups which
// resolve at the very end against blockOffsets).
fn emitLocalCondBranch(cx: A64Ctx, cond: int): int {
  let off = codeLen(cx)
  emitWord(cx.code, 0x54000000 | cond)
  return off
}

// The compare-and-branch counterpart of emitLocalCondBranch: one instruction
// where `cmpZero` + `emitLocalCondBranch(condEq/condNe)` is two, testing the
// full 64-bit register against zero exactly as `cmp Xn, xzr` does, and writing
// no flags at all. `nonzero` picks CBNZ over CBZ. Resolved by the same
// patchLocalCondBranch below, which rewrites imm19 and nothing else.
fn emitLocalCbz(cx: A64Ctx, nonzero: bool, reg: int): int {
  let off = codeLen(cx)
  if (nonzero) {
    cbnzX(cx.code, reg, 0)
  } else {
    cbz(cx.code, reg, 0)
  }
  return off
}

fn patchLocalCondBranch(cx: A64Ctx, patchOffset: int) {
  patchImm19At(cx.code, patchOffset, codeLen(cx))
}

fn patchJumpFixups(cx: A64Ctx) {
  let i = 0
  while (i < len(cx.jumpFixups)) {
    let fx = cx.jumpFixups[i]
    patchBranchTo(cx.code, fx.patchOffset, cx.blockOffsets[fx.target], fx.cond)
    i = i + 1
  }
}

// ===========================================================================
// Frame layout
//
// SP-relative throughout (no dynamic alloca in this language, so SP never moves
// except once at entry and once before `ret` — no per-spill x29 indirection
// needed the way the x86-64 backend uses rbp, though the encoder would happily
// take any base register). Layout, low to high address:
//   [0, outgoingBytes)                    outgoing stack-argument area
//   [outgoingBytes, +spillBytes)          spill slots, 8 bytes each
//   [+spillBytes, +gprBytes)              saved callee-saved GPRs
//   [+gprBytes, +fprBytes)                saved callee-saved FP regs
//   [frameSize-16, frameSize-8)           saved x29 (frame record)
//   [frameSize-8, frameSize)              saved x30 (frame record)
// frameSize is always a multiple of 16 (AAPCS64 requires SP 16-aligned at all
// times, not just at call boundaries).
//
// The outgoing-argument area holds the 9th+ integer/reference or float argument
// of any call this function makes (AAPCS64 passes the first eight of each class
// in x0–x7 / v0–v7; the rest spill to the caller's stack). Sized to the widest
// call (outgoingBytes) and reserved at the bottom of the frame — rather than a
// transient `sub sp` per call — precisely because everything here is
// SP-relative: a mid-body SP shift would move every spill/save offset. The
// callee finds these same words just above its own frame at
// [sp + frameSize + 8*k] (its caller stored them at its own [sp + 8*k], and the
// prologue lowered SP by frameSize).
// ===========================================================================

class FrameInfo {
  savedGpr: []int,
  savedFpr: []int,
  numSpillSlots: int,
  // Bytes reserved at the bottom of the frame for outgoing stack arguments (0 if
  // every call this function makes fits in registers). A multiple of 8.
  outgoingBytes: int,
  // #2925: 0 or 1 — the slot holding the address of the attention word the
  // back-edge poll guard (emitPollGuard) reads every iteration, fetched once at
  // function entry by emitPollCachePrefetch rather than via a per-iteration
  // call. It was 2, then 3 (#3746's preempt summary), then 4 (#4200's
  // countdown) while the guard re-derived the whole poll predicate inline;
  // #4203 replaced that with one word the runtime publishes, so one address is
  // all a back edge can reach for. Zero for any function with no back-edge safepoint
  // (hasBackEdgeSafepoint), so a pure-recursion function like fib (calls but
  // no loop) or a frameless leaf pays nothing for this. Every class literal
  // that omits this field gets 0 (§12.2), which is the right default for
  // every hand-built test frame in arm64check.bit/arm64selcheck.bit/
  // selfcheck.bit that predates #2925.
  pollCacheSlots: int,
  frameSize: int,
  // #2929: true when compileFunction proved this function needs no frame at all
  // (no calls, no callee-saved register, no spill slot, no outgoing-argument
  // area) — `frameSize` is 0 and emitPrologue/emitEpilogueAndRet are skipped
  // entirely, the same as `@naked` but derived rather than declared. Every
  // class literal that omits this field gets `false` (§12.2), which is the
  // right default for every hand-built test frame in arm64check.bit/
  // arm64selcheck.bit/selfcheck.bit.
  frameless: bool,
}

fn spillOffset(fr: FrameInfo, slot: int): int {
  return fr.outgoingBytes + slot * 8
}

// #2925/#4203: the cached poll-address slot — index 0 is the address of
// runtime/sched/pollreq.bit's attention word, and since #4203 it is the only
// one. Sits just above the spill area, below the callee-saved-register save
// area.
fn pollCacheOffset(fr: FrameInfo, i: int): int {
  return fr.outgoingBytes + fr.numSpillSlots * 8 + i * 8
}

fn gprSaveOffset(fr: FrameInfo, i: int): int {
  return fr.outgoingBytes + fr.numSpillSlots * 8 + fr.pollCacheSlots * 8 + i * 8
}

fn fprSaveOffset(fr: FrameInfo, i: int): int {
  return fr.outgoingBytes +
    fr.numSpillSlots * 8 +
    fr.pollCacheSlots * 8 +
    len(fr.savedGpr) * 8 +
    i * 8
}

fn savedFpOffset(fr: FrameInfo): int {
  return fr.frameSize - 16
}

fn savedLrOffset(fr: FrameInfo): int {
  return fr.frameSize - 8
}

// SP-relative byte offset of the k-th outgoing stack argument (the caller side
// stores here just before a `bl`).
fn outgoingArgOffset(k: int): int {
  return k * 8
}

// SP-relative byte offset of the k-th incoming stack argument — the words the
// caller placed just above this frame (see the layout note above).
fn incomingArgOffset(fr: FrameInfo, k: int): int {
  return fr.frameSize + k * 8
}

fn alignFrame16(raw: int): int {
  return (raw + 15) & ~15
}

// ===========================================================================
// Parallel move sequencing
//
// A block's arguments (and a call's) must all be read before any is written:
// emitting the moves in their natural order clobbers a source that a later move
// still needs. Two phases: repeatedly drain any move whose destination nothing
// else reads (a topological order), then break whatever closed cycles remain
// with a scratch register.
// ===========================================================================

// One end of a move: a physical register number, or an SP-relative frame offset.
// Bit has no tagged union; `isReg` selects how `v` reads. `class` is
// load-bearing for `plocEq` (#3182) ONLY on the register side: x5 and v5/d5
// are different physical registers sharing one raw number, so a register
// PLoc needs `class` to tell them apart. A spill PLoc's `v` is already the
// resolved SP-relative BYTE OFFSET (arm64select.bit/x64select.bit build it
// via spillOffset/xSpillOffset before ever constructing the PLoc), so two
// spill PLocs at the same offset name the same byte of stack regardless of
// what class either was tagged with — comparing `class` there would make a
// same-address collision compare unequal (#3191). `plocEq` reflects this:
// register identity is (v, class); spill identity is v alone. Nothing
// currently allocates two live values to the same spill address at once
// (#3168 partitions the int/float slot-number spaces so their byte offsets
// can never collide) — that partition is the actual defense; this is what
// keeps the representation from silently misrepresenting it if it ever did.
class PLoc {
  isReg: bool,
  v: int,
  regClass: RegClass,
}

fn plocReg(r: int, regClass: RegClass): PLoc {
  return PLoc{ isReg: true, v: r, regClass: regClass }
}

fn plocMem(off: int, regClass: RegClass): PLoc {
  return PLoc{ isReg: false, v: off, regClass: regClass }
}

// Register identity needs `class` (x5 and d5 share raw number 5 but are
// different registers); spill identity does not (`v` is already the
// resolved byte offset, and two spills at the same offset ARE the same
// location no matter what class either end was tagged with — #3191).
fn plocEq(a: PLoc, b: PLoc): bool {
  if (a.isReg != b.isReg) {
    return false
  }
  if (a.isReg) {
    return a.v == b.v && a.regClass == b.regClass
  }
  return a.v == b.v
}

class PMove {
  // `from`/`to` would read better; both are Bit keywords (import syntax).
  src: PLoc,
  dst: PLoc,
}

// Removes element `i` by overwriting it with the last (order is irrelevant to
// both phases) — the seed's `swapRemove`.
fn swapRemoveMove(ms: []PMove, i: int): []PMove {
  ms[i] = ms[len(ms) - 1]
  return ms[0:len(ms) - 1]
}

fn emitMove(cx: A64Ctx, src: PLoc, dst: PLoc) {
  // A value never changes class in transit; the two ends of one move always
  // agree, so either one names which emitter runs.
  assert(src.regClass == dst.regClass)
  if (src.regClass == RegClass.Int) {
    if (src.isReg && dst.isReg) {
      movRR(cx.code, dst.v, src.v)
      return
    }
    if (src.isReg) {
      storeImm(cx.code, src.v, regSp(), dst.v, 8)
      return
    }
    if (dst.isReg) {
      loadImm(cx.code, dst.v, regSp(), src.v, 8, false)
      return
    }
    loadImm(cx.code, scratch1(), regSp(), src.v, 8, false)
    storeImm(cx.code, scratch1(), regSp(), dst.v, 8)
    return
  }
  if (src.isReg && dst.isReg) {
    fmovFF(cx.code, dst.v, src.v, 8)
    return
  }
  if (src.isReg) {
    storeImmF(cx.code, src.v, regSp(), dst.v, 8)
    return
  }
  if (dst.isReg) {
    loadImmF(cx.code, dst.v, regSp(), src.v, 8)
    return
  }
  loadImmF(cx.code, fscratch1(), regSp(), src.v, 8)
  storeImmF(cx.code, fscratch1(), regSp(), dst.v, 8)
}

// True if any move other than `self` reads `loc`.
fn anyReads(ms: []PMove, self: int, loc: PLoc): bool {
  let j = 0
  while (j < len(ms)) {
    if (j != self && plocEq(ms[j].src, loc)) {
      return true
    }
    j = j + 1
  }
  return false
}

// One parallel move covering every class at once (#3182): a block edge or a
// call site's argument marshalling is a single simultaneous move, and splitting
// it by class into two independent calls is what let an int destination and a
// float source alias through a shared spill-slot number in the first place
// (#3168). `movesIn` may freely mix Int and Float PMoves; `class` lives on each
// PLoc now, and a same-address spill collision between the two classes (should
// #3168's partitioning ever be lost) is now visible to `anyReads` too — plocEq
// (#3191) compares register PLocs by (v, class) but spill PLocs by address (v)
// alone, since a spill's `v` is already the byte offset and two classes at the
// same offset really are the same location. emitMove/the scratch below still
// read the class off the moves themselves rather than a single caller-supplied
// class for the whole batch.
fn sequentializeAndEmit(cx: A64Ctx, movesIn: []PMove) {
  let moves = []PMove(0)
  let k = 0
  while (k < len(movesIn)) {
    if (!plocEq(movesIn[k].src, movesIn[k].dst)) {
      moves = append(moves, movesIn[k])
    }
    k = k + 1
  }

  // Phase 1: drain every move nothing else depends on, until only cycles are
  // left. Each pass emits at least one move or stops, so the outer loop runs at
  // most len(moves) times.
  let changed = true
  while (changed) {
    changed = false
    let i = 0
    while (i < len(moves)) {
      if (anyReads(moves, i, moves[i].dst)) {
        i = i + 1
      } else {
        emitMove(cx, moves[i].src, moves[i].dst)
        moves = swapRemoveMove(moves, i)
        changed = true
      }
    }
  }

  // Phase 2: what remains forms closed cycles. Walk one backwards from an
  // arbitrary move's destination (each location is written exactly once, so the
  // predecessor is unique) and rotate it through a scratch register.
  while (len(moves) > 0) {
    let cycle = []PMove(0)
    let start = moves[0].dst
    let cur = start
    let guard = 0
    while (guard <= len(movesIn)) {
      let found = -1
      let j = 0
      while (j < len(moves)) {
        if (plocEq(moves[j].dst, cur)) {
          found = j
          break
        }
        j = j + 1
      }
      assert(found >= 0) // invariant: what's left forms closed cycles
      let mv = moves[found]
      cycle = append(cycle, mv)
      moves = swapRemoveMove(moves, found)
      cur = mv.src
      if (plocEq(cur, start)) {
        break
      }
      guard = guard + 1
    }
    assert(plocEq(cur, start)) // the guard bound never trips before the cycle closes
    // The cycle scratch holds one location's value across the whole rotation, so
    // it must be a register emitMove never clobbers as its own temporary. A
    // mem->mem move inside the cycle routes through scratch1/fscratch1 (see
    // emitMove), so the cycle must use the *secondary* scratch — otherwise the
    // first mem->mem rotation step overwrites the saved value and the cycle
    // resolves to garbage (a spilled loop-carried value swap on a back-edge
    // silently corrupts, task #1235). scratch2/fscratch2 are reserved and never a
    // move source/destination, so they are safe to hold across the rotation.
    // Every link in a cycle shares one class in practice: `plocEq` (#3191)
    // only requires it for registers, but #3168's partitioning means no two
    // different classes' spills ever share an address either, so a spill
    // chase can never actually cross classes. `start`'s class names the
    // whole cycle; a same-address collision that DID cross classes here
    // would trip emitMove's own src.class==dst.class assert on the closing
    // scratch move rather than silently mis-restoring, since scratch is
    // fixed to `start`'s class for the whole rotation.
    let scratch = plocReg(fscratch2(), RegClass.Float)
    if (start.regClass == RegClass.Int) {
      scratch = plocReg(scratch2(), RegClass.Int)
    }
    emitMove(cx, cycle[0].dst, scratch)
    let i = 0
    while (i + 1 < len(cycle)) {
      emitMove(cx, cycle[i].src, cycle[i].dst)
      i = i + 1
    }
    emitMove(cx, scratch, cycle[len(cycle) - 1].dst)
  }
}
