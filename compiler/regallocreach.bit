// compiler/regallocreach.bit — #7778: the two facts `crossesAnyCall`
// (regallocpoints.bit) needs to tell a successor a value is live on entry to
// from one it merely spans in linear order. A cold `fail newError(...)` region
// of several blocks sits inside the interval of every value its hot
// neighbours keep, so its inner successors start inside that interval although
// nothing they lead to reads the value.

// Per block b, at 2b and 2b + 1, the lowest and highest position of the blocks
// reachable from b, b included. Raised to a fixpoint from the last block back,
// so a forward edge settles within one pass and each further pass carries a
// hull across one more back edge; a path has fewer back edges than there are
// blocks, which bounds the passes.
fn reachHulls(f: IrFunc): []int {
  let nb = len(f.blocks)
  let h = []int(2 * nb)
  let b = 0
  while (b < nb) {
    h[2 * b] = f.blocks[b].instsStart
    h[2 * b + 1] = f.blocks[b].instsStart + f.blocks[b].instsLen - 1
    b = b + 1
  }
  let passes = 0
  while (widenHulls(f, h)) {
    passes = passes + 1
    assert(passes <= nb, "#7778: reach hulls did not settle")
  }
  return h
}

fn widenHulls(f: IrFunc, h: []int): bool {
  let changed = false
  let b = len(f.blocks) - 1
  while (b >= 0) {
    let blk = f.blocks[b]
    let t = f.instrs[blk.instsStart + blk.instsLen - 1]
    if ((t.op == Op.Jump || t.op == Op.Br) && widenFrom(h, b, t.ival)) {
      changed = true
    }
    if (t.op == Op.Br && widenFrom(h, b, t.ival2)) {
      changed = true
    }
    b = b - 1
  }
  return changed
}

fn widenFrom(h: []int, b: int, s: int): bool {
  let changed = false
  if (h[2 * s] < h[2 * b]) {
    h[2 * b] = h[2 * s]
    changed = true
  }
  if (h[2 * s + 1] > h[2 * b + 1]) {
    h[2 * b + 1] = h[2 * s + 1]
    changed = true
  }
  return changed
}

// `p.readFrom`/`p.readAt`: every read `buildIntervals` charged, counted per
// copy root, then placed in position order. A read past its value's end (an
// edge argument whose param is dead, #2934) is skipped, as `noteCallReads`
// skips it. Bounded by the operand count.
fn fillReadLists(p: AllocPoints, f: IrFunc, built: IntervalBuild) {
  let n = len(f.instrs)
  let from = []int(n + 1)
  walkReads(f, built, from, []int(0))
  let r = 0
  while (r < n) {
    from[r + 1] = from[r + 1] + from[r]
    r = r + 1
  }
  let next = []int(n + 1)
  r = 0
  while (r <= n) {
    next[r] = from[r]
    r = r + 1
  }
  let at = []int(from[n])
  walkReads(f, built, next, at)
  p.readFrom = from
  p.readAt = at
  p.readRoots = built.roots
}

// Each charged read (root r, position q): counted into slot[r + 1] while `at`
// is empty, else stored at at[slot[r]].
fn walkReads(f: IrFunc, built: IntervalBuild, slot: []int, at: []int) {
  let q = 0
  while (q < len(f.instrs)) {
    for v of instrOperands(f, q) {
      if (built.intervals[v].end >= q) {
        placeRead(slot, at, readRoot(built.roots, v), q)
      }
    }
    q = q + 1
  }
}

fn placeRead(slot: []int, at: []int, r: int, q: int) {
  if (len(at) == 0) {
    slot[r + 1] = slot[r + 1] + 1
    return
  }
  at[slot[r]] = q
  slot[r] = slot[r] + 1
}

fn readRoot(roots: []int, v: int): int {
  if (len(roots) == 0) {
    return v
  }
  return roots[v]
}

// Whether a read of `v`'s copy root lies in [lo, hi]; false for lo == -1.
fn readWithin(p: AllocPoints, v: int, lo: int, hi: int): bool {
  let r = readRoot(p.readRoots, v)
  let a = p.readFrom[r]
  let b = p.readFrom[r + 1]
  while (a < b) {
    let m = (a + b) / 2
    if (p.readAt[m] < lo) {
      a = m + 1
      continue
    }
    b = m
  }
  return lo >= 0 && a < p.readFrom[r + 1] && p.readAt[a] <= hi
}
