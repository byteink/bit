// compiler/lowerdecimalarith.bit — #3982's second and third slices: scale
// alignment, binary `+`/`-`, the six comparisons, and binary `*` on
// `decimal`. Sibling of lowerdecimal.bit: same module, so this needs no
// imports and no call-site changes. Divide and half-even rounding live in
// `lowerdecimaldiv.bit` (also this module) — a 96-bit long division with
// correct rounding needs its own design pass, and multiply is already a
// full slice alongside alignment/add/sub.
//
// WHY THIS IS ITS OWN FILE rather than more of lowerdecimal.bit. That file is
// the REPRESENTATION (literal, unary, field access, to-string) and was
// already 367 lines; this slice alone is a comparable amount of new lowering,
// and the 800-line ceiling means the two would have to split eventually
// regardless — doing it at the seam between "what a decimal IS" and "what you
// can DO with two of them" keeps each file's job nameable in one sentence.
//
// THE CORE TRICK, so the functions below read as one idea rather than a pile
// of bit-twiddling: `decimal`'s 96-bit magnitude, once both operands are
// scaled to agree, is added SIGN-MAGNITUDE — same-sign operands add their
// (unsigned) magnitudes, opposite-sign operands subtract the smaller
// magnitude from the larger, mirroring the unsigned compare/subtract
// `emitPairCmpGe`/`emitPairSub` (lowerdecimaldiv.bit) already use for
// division. A two's-complement reading of the raw magnitude (negate the
// negative operand, add, read the sign back off bit 95 of the sum) looks
// simpler but is only valid for magnitudes below 2^95 — half the type's
// documented 96-bit range has bit 95 set on its own unsigned bit pattern, so
// that trick reads a perfectly positive magnitude as already negative
// (#5288). Same-sign addition is the only arm that can overflow the type's
// 96-bit ceiling (checked with a real carry-out of bit 95, not a sign
// flip); opposite-sign subtraction is always exact. Comparison reuses the
// identical core: `a - b`'s sign (via `a + (-b)`) decides the ordering,
// with the special case that comparison must never PANIC on a same-sign
// magnitude sum this core can hit even for two in-range operands, since
// their exact difference can need up to 97 bits — the sum's sign is still
// well-defined in that case (it is simply the operands' shared sign), so
// only `lowerDecimalAdd`'s own overflow panic needs the carry-out check.

// ---- small emission helpers, shared by everything below -------------------

// One `i64` constant, emitted into the current block.
fn emitI64Const(fc: FnCtx, val: int): int {
  let ins = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  ins.ival = val
  return builderEmit(fc.b, ins)
}

// One `bool` constant, emitted into the current block.
fn emitBoolConst(fc: FnCtx, val: bool): int {
  let ins = mkInstr(Op.ConstBool, primType(fc.c.ctx, 10))
  ins.bval = val
  return builderEmit(fc.b, ins)
}

// A binary IR op over two already-lowered operands — the boilerplate every
// `mkInstr`/`builderEmit` pair below shares.
fn emitBin(fc: FnCtx, op: Op, ty: int, lhs: int, rhs: int): int {
  let ins = mkInstr(op, ty)
  ins.lhs = lhs
  ins.rhs = rhs
  return builderEmit(fc.b, ins)
}

// `cond ? tVal : fVal` as a real branch and join, for a RUNTIME `cond` over
// two already-computed values (so both must be side-effect-free to compute
// eagerly — never a value from a path that can panic or loop, which is why
// the alignment loop and the add/sub cores below build their own explicit
// blocks instead of calling this). The smallest instance of the `cond ? a : b`
// join `lowerDecimalNegate` (lowerdecimal.bit) already builds by hand; every
// three-way merge in this file is this, called once or nested.
fn emitCondVal(fc: FnCtx, cond: int, ty: int, tVal: int, fVal: int): int {
  let tBlk = builderNewBlock(fc.b)
  let fBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = tBlk
  br.thenArgs = []int(0)
  br.ival2 = fBlk
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, tBlk)
  emitJump(fc, join, [tVal])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, fBlk)
  emitJump(fc, join, [fVal])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, ty)
}

// Bit 63 of an `i64`, computed rather than written as a literal — the same
// representability trap `lowerDecimalNegate` already documents (the positive
// magnitude before negation is one past i64's positive range).
fn emitSignBitConst(fc: FnCtx): int {
  let i64ty = primType(fc.c.ctx, 3)
  return emitBin(fc, Op.Shl, i64ty, emitI64Const(fc, 1), emitI64Const(fc, 63))
}

// ---- the hi-word layout, read and written at runtime -----------------------
//
// A decimal's hi word (this file's banner, and lowerdecimal.bit's) packs the
// mantissa's top 32 bits (bits 0..31), the scale (bits 32..39) and the sign
// (bit 63). These three are the only accessors every function below needs;
// nothing here reaches into the low word, which is the mantissa's bottom 64
// bits verbatim.

fn decSignMasked(fc: FnCtx, hi: int): int {
  return emitBin(fc, Op.BAnd, primType(fc.c.ctx, 3), hi, emitSignBitConst(fc))
}

fn decIsNeg(fc: FnCtx, hi: int): int {
  return emitBin(fc, Op.ICmpNe, primType(fc.c.ctx, 10), decSignMasked(fc, hi), emitI64Const(fc, 0))
}

fn decMantHi32(fc: FnCtx, hi: int): int {
  return emitBin(fc, Op.BAnd, primType(fc.c.ctx, 3), hi, emitI64Const(fc, 4294967295))
}

fn decScale(fc: FnCtx, hi: int): int {
  let shifted = emitBin(fc, Op.LShr, primType(fc.c.ctx, 3), hi, emitI64Const(fc, 32))
  return emitBin(fc, Op.BAnd, primType(fc.c.ctx, 3), shifted, emitI64Const(fc, 255))
}

// The inverse of the three reads above: one hi word from a mantissa-high
// word, a scale and an already-masked sign (0 or `emitSignBitConst`'s value).
fn decComposeHi(fc: FnCtx, mantHi32: int, scale: int, signMasked: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let scaleShifted = emitBin(fc, Op.Shl, i64ty, scale, emitI64Const(fc, 32))
  let withScale = emitBin(fc, Op.BOr, i64ty, mantHi32, scaleShifted)
  return emitBin(fc, Op.BOr, i64ty, withScale, signMasked)
}

// Panics "decimal arithmetic overflowed" unless `ok`. Same shape as
// `emitBoundsCheck` (loweraccess.bit): mint both successor blocks up front,
// the panic side never returns, and the caller's next instructions land in
// the block this leaves current — which is what lets every call site below
// just keep emitting as if the check were a no-op guard.
fn emitDecimalOverflowPanic(fc: FnCtx, ok: int) {
  let good = builderNewBlock(fc.b)
  let bad = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = ok
  br.ival = good
  br.ival2 = bad
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, bad)
  let msg = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  msg.sval = "decimal arithmetic overflowed"
  msg.ival = internPoolString(fc, msg.sval)
  let pn = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  pn.name = "panic"
  pn.args = [builderEmit(fc.b, msg)]
  emitRtCall(fc, pn)
  builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, good)
}

// ---- scale alignment --------------------------------------------------------

// Scales a 96-bit magnitude (`lo0`/`mant0`) up by `diff` decimal places —
// multiply by 10, `diff` times, panicking the instant the mantissa would not
// fit 96 bits. `diff` is a RUNTIME value (0-28, or up to 255 given the field
// is 8 bits — bounded either way), so this is a real loop, not unrolled; 0
// iterations is a no-op, which is what makes an equal-scale operand pair (and
// so `0.1 + 0.2`) need no special case at all.
//
// PER-ITERATION, not just at the end: `hi32*10` alone can exceed 2^32 well
// before 28 iterations, so checking only the final value would read a value
// that already wrapped past i64 within the loop.
//
// `carry` (the high 64 bits of `lo*10`) is always 0-9: `lo < 2^64`, so
// `lo*10 < 10 * 2^64`, so `floor(lo*10 / 2^64) < 10`.
fn emitDecimalScaleUp(fc: FnCtx, lo0: int, mant0: int, diff: int): (int, int) {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let header = builderNewBlock(fc.b)
  let body = builderNewBlock(fc.b)
  let exit = builderNewBlock(fc.b)

  emitJump(fc, header, [lo0, mant0, diff])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, header)
  let loP = builderAddParam(fc.b, i64ty)
  let mantP = builderAddParam(fc.b, i64ty)
  let cntP = builderAddParam(fc.b, i64ty)
  let cont = emitBin(fc, Op.ICmpSgt, boolTy, cntP, emitI64Const(fc, 0))
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cont
  br.ival = body
  br.thenArgs = []int(0)
  br.ival2 = exit
  br.elseArgs = [loP, mantP]
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, body)
  let ten = emitI64Const(fc, 10)
  let loProd = emitBin(fc, Op.Mul, i64ty, loP, ten)
  let carry = emitBin(fc, Op.UMulHi, i64ty, loP, ten)
  let mantTimes10 = emitBin(fc, Op.Mul, i64ty, mantP, ten)
  let newMant = emitBin(fc, Op.Add, i64ty, mantTimes10, carry)
  let inRange = emitBin(fc, Op.ICmpSlt, boolTy, newMant, emitI64Const(fc, 4294967296))
  emitDecimalOverflowPanic(fc, inRange)
  let newCnt = emitBin(fc, Op.Sub, i64ty, cntP, emitI64Const(fc, 1))
  emitJump(fc, header, [loProd, newMant, newCnt])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, exit)
  let finalLo = builderAddParam(fc.b, i64ty)
  let finalMant = builderAddParam(fc.b, i64ty)
  return (finalLo, finalMant)
}

// Both operands' magnitudes, aligned to a shared scale (the larger of the
// two), and that shared scale — needed by add/sub AND all six comparisons
// (`1.0 == 1.00` must be `true`, which only holds once both sides read the
// same 96-bit magnitude). Exactly one of the two `emitDecimalScaleUp` calls
// below ever does real work; the other runs its loop zero times.
class DecimalAligned {
  loA: int,
  mantA: int,
  loB: int,
  mantB: int,
  scale: int,
}

fn emitDecimalAlign(fc: FnCtx, loA: int, hiA: int, loB: int, hiB: int): DecimalAligned {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let scaleA = decScale(fc, hiA)
  let scaleB = decScale(fc, hiB)
  let mantA0 = decMantHi32(fc, hiA)
  let mantB0 = decMantHi32(fc, hiB)
  let aBigger = emitBin(fc, Op.ICmpSge, boolTy, scaleA, scaleB)

  let aBiggerBlk = builderNewBlock(fc.b)
  let bBiggerBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = aBigger
  br.ival = aBiggerBlk
  br.thenArgs = []int(0)
  br.ival2 = bBiggerBlk
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  // A's scale is the larger (or they're equal, either arm is correct): scale
  // B up by the difference, leave A alone.
  builderBeginBlock(fc.b, aBiggerBlk)
  let diffToB = emitBin(fc, Op.Sub, i64ty, scaleA, scaleB)
  emitJump(fc, join, [emitI64Const(fc, 0), diffToB, scaleA])
  builderEndBlock(fc.b)

  // B's scale is strictly larger: scale A up instead.
  builderBeginBlock(fc.b, bBiggerBlk)
  let diffToA = emitBin(fc, Op.Sub, i64ty, scaleB, scaleA)
  emitJump(fc, join, [diffToA, emitI64Const(fc, 0), scaleB])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, join)
  let diffA = builderAddParam(fc.b, i64ty)
  let diffB = builderAddParam(fc.b, i64ty)
  let resultScale = builderAddParam(fc.b, i64ty)
  let (loAa, mantAa) = emitDecimalScaleUp(fc, loA, mantA0, diffA)
  let (loBa, mantBa) = emitDecimalScaleUp(fc, loB, mantB0, diffB)
  return DecimalAligned{
    loA = loAa,
    mantA = mantAa,
    loB = loBa,
    mantB = mantBa,
    scale = resultScale,
  }
}

// ---- sign-magnitude core, shared by add/sub and comparison ----------------

// Unsigned 96-bit add, mod 2^96 — a carry out of bit 95 is simply dropped.
// The only caller that can legally hit that dropped carry is
// `emitDecimalDivRound`'s (lowerdecimaldiv.bit) `quotient + 1`, which panics
// first whenever the quotient is already the maximum representable
// magnitude, so the drop is unreachable there; `emitDecimalAddCore` below
// does its own carry-out check rather than calling this, since dropping the
// carry is exactly what it must not do.
fn emitDecAddPair(fc: FnCtx, loA: int, mA: int, loB: int, mB: int): (int, int) {
  let i64ty = primType(fc.c.ctx, 3)
  let sumLo = emitBin(fc, Op.Add, i64ty, loA, loB)
  let wrapped = emitBin(fc, Op.ICmpUlt, primType(fc.c.ctx, 10), sumLo, loA)
  let carry = emitCondVal(fc, wrapped, i64ty, emitI64Const(fc, 1), emitI64Const(fc, 0))
  let mSum = emitBin(fc, Op.Add, i64ty, emitBin(fc, Op.Add, i64ty, mA, mB), carry)
  let sumM = emitBin(fc, Op.BAnd, i64ty, mSum, emitI64Const(fc, 4294967295))
  return (sumLo, sumM)
}

// The result of adding two decimals' ALIGNED magnitudes sign-magnitude: the
// raw result magnitude (`lo`/`m`), its scale, its true sign (`neg` — correct
// even when `agrees` is false, since the sign of a same-sign sum is the
// operands' shared sign regardless of whether the magnitude overflowed), and
// whether the magnitude add genuinely overflowed the type's 96-bit ceiling
// (`agrees` — false only for a same-sign magnitude sum that carries out of
// bit 95; opposite-sign subtraction is always exact), and whether the raw
// result is exactly zero.
class DecimalSum {
  lo: int,
  m: int,
  scale: int,
  neg: int,
  agrees: int,
  isZero: int,
}

fn emitDecimalAddCore(fc: FnCtx, loA: int, hiA: int, loB: int, hiB: int): DecimalSum {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let signA = decIsNeg(fc, hiA)
  let signB = decIsNeg(fc, hiB)
  let sameSign = emitBin(fc, Op.ICmpEq, boolTy, signA, signB)
  let aligned = emitDecimalAlign(fc, loA, hiA, loB, hiB)

  // Same sign: magnitudes ADD. The true sum can need a 97th bit — checked
  // with a real carry-out of the unsigned add, since bit 95 of the low-32
  // masked result is not a sign bit (#5288).
  let (addLo, addCarry) = emitAddWithCarry(fc, aligned.loA, aligned.loB)
  let addMRaw = emitBin(
    fc, Op.Add, i64ty, emitBin(fc, Op.Add, i64ty, aligned.mantA, aligned.mantB), addCarry,
  )
  let addOk = emitBin(
    fc, Op.ICmpEq, boolTy, emitBin(fc, Op.LShr, i64ty, addMRaw, emitI64Const(fc, 32)),
    emitI64Const(fc, 0),
  )
  let addM = emitBin(fc, Op.BAnd, i64ty, addMRaw, emitI64Const(fc, 4294967295))

  // Opposite sign: magnitudes SUBTRACT, larger minus smaller — always exact,
  // mirroring `emitPairCmpGe`/`emitPairSub` (lowerdecimaldiv.bit).
  let ge = emitPairCmpGe(fc, aligned.loA, aligned.mantA, aligned.loB, aligned.mantB)
  let (subLoGe, subMGe) = emitPairSub(fc, aligned.loA, aligned.mantA, aligned.loB, aligned.mantB)
  let (subLoLt, subMLt) = emitPairSub(fc, aligned.loB, aligned.mantB, aligned.loA, aligned.mantA)
  let subLo = emitCondVal(fc, ge, i64ty, subLoGe, subLoLt)
  let subM = emitCondVal(fc, ge, i64ty, subMGe, subMLt)
  let subSign = emitCondVal(fc, ge, boolTy, signA, signB)

  let resultLo = emitCondVal(fc, sameSign, i64ty, addLo, subLo)
  let resultM = emitCondVal(fc, sameSign, i64ty, addM, subM)
  let resultNeg = emitCondVal(fc, sameSign, boolTy, signA, subSign)
  let agrees = emitCondVal(fc, sameSign, boolTy, addOk, emitBoolConst(fc, true))
  let isZero = emitBin(
    fc, Op.ICmpEq, boolTy, emitBin(fc, Op.BOr, i64ty, resultLo, resultM), emitI64Const(fc, 0),
  )
  return DecimalSum{
    lo = resultLo, m = resultM, scale = aligned.scale, neg = resultNeg, agrees = agrees, isZero = isZero,
  }
}

// ---- binary `+` / `-` --------------------------------------------------------

// The words-level core of `a + b`: adds sign-magnitude, panics if that
// overflowed, then composes the result's hi word — marking it negative only
// when the sum's own true sign says so, and forcing a `0` result to the
// canonical positive-zero bit pattern (mirroring `lowerDecimalMultiply`'s
// identical `isZero` override below), since a same-magnitude opposite-sign
// subtraction can otherwise land on the larger operand's sign at an
// exact-zero result. Composes ALREADY-EXPLODED operand words, doing no
// `explodeValueWords` of its own — the caller decides WHEN each operand's
// words are read, which is the fix for
// #5402's allocation: `lowerDecimalBinary`'s `-` arm used to box `a` (this
// file's own boxing convention, via the caller's `lowerExprH`) and then run
// `lowerDecimalNegate`'s branch-and-join on `b` BEFORE reading `a` back, so
// `a`'s `field_get`s landed in the join block while its `field_set`s were in
// the block before the branch. `compiler/optstore.bit`'s store-to-load
// forwarding is block-local only (its header: "nothing across blocks"), so
// it could not answer that `field_get` from the store, `a`'s box kept an
// escaping use, and `compiler/optalloc.bit`'s dead-allocation pass — which
// needs zero escaping uses — could never remove it: one real heap object per
// call, where every other decimal operator explodes both operands straight
// through with no branch in between and pays nothing. `lowerDecimalBinary`
// now explodes `a` BEFORE calling `lowerDecimalNegate`, so both operands'
// `field_get`s sit in the same block as their `field_set`s, same as every
// zero-alloc operator.
fn lowerDecimalAddWords(fc: FnCtx, loA: int, hiA: int, loB: int, hiB: int): int {
  let ctx = fc.c.ctx
  let i64ty = primType(ctx, 3)
  let sum = emitDecimalAddCore(fc, loA, hiA, loB, hiB)
  emitDecimalOverflowPanic(fc, sum.agrees)
  let signMasked = emitCondVal(fc, sum.neg, i64ty, emitSignBitConst(fc), emitI64Const(fc, 0))
  let finalSignMasked = emitCondVal(fc, sum.isZero, i64ty, emitI64Const(fc, 0), signMasked)
  let resultHi = decComposeHi(fc, sum.m, sum.scale, finalSignMasked)
  return buildTuple(fc, decimalTupleType(ctx), [sum.lo, resultHi])
}

// `a + b` from two already-boxed operands: explodes both straight through
// (no branch between the two `explodeValueWords` calls, so both stay
// zero-alloc) and hands the words to `lowerDecimalAddWords`.
fn lowerDecimalAdd(fc: FnCtx, a: int, b: int): int {
  let words = decimalWordTypes(fc.c.ctx)
  let aw = explodeValueWords(fc.c.ctx, fc.b, a, words)
  let bw = explodeValueWords(fc.c.ctx, fc.b, b, words)
  return lowerDecimalAddWords(fc, aw[0], aw[1], bw[0], bw[1])
}

// `a + b` / `a - b` (§12, precedence row 5). `-` is `a + (-b)`, reusing
// #3982's already-shipped, already-gated unary negate (`lowerDecimalNegate`,
// lowerdecimal.bit) rather than a second sign-flip. `*` is
// `lowerDecimalMultiply` below; `/` is `lowerDecimalDivide`
// (lowerdecimaldiv.bit).
//
// `ty` prefers the caller's `hint` over the node's own checked type when that
// type is untyped — exactly `lowerExprByTag`'s float-widening rule
// (lowerexpr.bit), for the identical reason: `0.1 + 0.2` with NEITHER operand
// already decimal (both untyped-float literals) checks as `untyped float`
// (`checkBinary` only special-cases decimal when the operands already joined
// at decimal), so `let total: decimal = 0.1 + 0.2` reaches here with the
// node's own type still untyped and the decimal-ness carried ONLY by `hint`
// — the exact shape SPEC §11.1's money example is written in. Without this,
// `defaultType(untyped float)` is `f64` and the whole expression would
// silently compute in floating point.
fn lowerDecimalBinary(fc: FnCtx, node: int, hint: int, n: Node): int {
  let raw = nodeType(fc, node)
  let ty = defaultType(fc.c, raw)
  if (isUntyped(fc.c, raw) && lowerIsDecimal(fc, hint)) {
    ty = hint
  }
  let kids = kidsOf(fc.c.tree, node)
  let a = lowerExprH(fc, kids[0], ty)
  let b = lowerExprH(fc, kids[1], ty)
  if (fc.failed) {
    return 0
  }
  if (n.main == int(Kind.Minus)) {
    // Explode `a` HERE, before `lowerDecimalNegate`'s branch-and-join runs
    // on `b` — not after, the way a plain `lowerDecimalAdd(fc, a, b)` call
    // would. See `lowerDecimalAddWords`'s banner: exploding `a` on the far
    // side of that branch is #5402's one-object-per-call leak.
    let words = decimalWordTypes(fc.c.ctx)
    let aw = explodeValueWords(fc.c.ctx, fc.b, a, words)
    let negB = lowerDecimalNegate(fc, b)
    let bw = explodeValueWords(fc.c.ctx, fc.b, negB, words)
    return lowerDecimalAddWords(fc, aw[0], aw[1], bw[0], bw[1])
  } else if (n.main == int(Kind.Star)) {
    return lowerDecimalMultiply(fc, a, b)
  } else if (n.main == int(Kind.Slash)) {
    return lowerDecimalDivide(fc, a, b)
  } else if (n.main != int(Kind.Plus)) {
    fcFail(fc, n.span, "an unsupported binary operator on 'decimal'")
    return 0
  }
  return lowerDecimalAdd(fc, a, b)
}

// ---- the six comparisons ----------------------------------------------------

// `hi` with its sign bit flipped, leaving scale and mantissa untouched — the
// comparison path's stand-in for negating a whole decimal VALUE without the
// canonical-zero guard `lowerDecimalNegate` pays for: flipping a zero
// magnitude's sign bit here is harmless, because `emitDecimalAddCore` only
// ever reads that flipped bit to classify same-sign vs. opposite-sign, and
// either classification of a zero magnitude still nets the correct magnitude
// and sign out of that core — the bogus "negative zero" this could
// momentarily represent never escapes this function.
fn emitFlippedSignHi(fc: FnCtx, hi: int): int {
  return emitBin(fc, Op.BXor, primType(fc.c.ctx, 3), hi, emitSignBitConst(fc))
}

// The sign of `a - b`, as a plain `-1`/`0`/`1`, for all six relational
// operators to share (mirroring `lowerCompare`'s string arm, which gets the
// same three-way shape from `string_cmp`). Reuses `emitDecimalAddCore`
// rather than a second, magnitude-comparing mechanism — with one correction
// it does not need: `a`'s and `-b`'s exact difference can need up to 97 bits
// (each operand's magnitude alone fits 96), so the core's `agrees` (false
// only for a same-sign magnitude sum overflowing 96 bits) is not a real
// arithmetic fault to panic on here, only a signal that the true difference
// is certainly nonzero — `diff.neg` itself is already correct in that case
// too, since a same-sign sum's sign is the operands' shared sign regardless
// of whether the magnitude overflowed, so this needs no separate fallback.
fn emitDecimalCompareSign(fc: FnCtx, loA: int, hiA: int, loB: int, hiB: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let diff = emitDecimalAddCore(fc, loA, hiA, loB, emitFlippedSignHi(fc, hiB))
  let trueZero = emitCondVal(fc, diff.agrees, boolTy, diff.isZero, emitBoolConst(fc, false))
  let nonZeroOrd = emitCondVal(fc, diff.neg, i64ty, emitI64Const(fc, 0 - 1), emitI64Const(fc, 1))
  return emitCondVal(fc, trueZero, i64ty, emitI64Const(fc, 0), nonZeroOrd)
}

// `lowerCompare`'s (lowercond.bit) decimal arm: explode both operands, get
// their sign, and dispatch through `cmpOpFor` exactly as the generic numeric
// path does — `cmpOpFor(op, false, true)` covers all six relational kinds
// (unlike `strCmpOpFor`, which only covers the four ordering ones), so there
// is no separate equality case to special-case here the way strings need one.
fn lowerDecimalCompare(fc: FnCtx, opKind: int, lhs: int, rhs: int): int {
  let ctx = fc.c.ctx
  let words = decimalWordTypes(ctx)
  let lw = explodeValueWords(ctx, fc.b, lhs, words)
  let rw = explodeValueWords(ctx, fc.b, rhs, words)
  let sign = emitDecimalCompareSign(fc, lw[0], lw[1], rw[0], rw[1])
  let cop = cmpOpFor(opKind, false, true)
  let ins = mkInstr(cop, primType(ctx, 10))
  ins.lhs = sign
  ins.rhs = emitI64Const(fc, 0)
  return builderEmit(fc.b, ins)
}

// ---- binary `*` --------------------------------------------------------------

// `a + b` and its carry-out (1 if the unsigned sum wrapped past `2^64`, else
// 0) — the same unsigned-wraparound idiom `emitDecAddPair` already uses
// inline (`sum < a`), pulled out here because the multiply below chains it
// four times and inlining each would bury the schoolbook shape it is meant
// to read as.
fn emitAddWithCarry(fc: FnCtx, a: int, b: int): (int, int) {
  let i64ty = primType(fc.c.ctx, 3)
  let sum = emitBin(fc, Op.Add, i64ty, a, b)
  let wrapped = emitBin(fc, Op.ICmpUlt, primType(fc.c.ctx, 10), sum, a)
  let carry = emitCondVal(fc, wrapped, i64ty, emitI64Const(fc, 1), emitI64Const(fc, 0))
  return (sum, carry)
}

// The unsigned magnitude product of two 96-bit mantissas, each held the same
// way `emitDecimalAlign`'s output is: `lo` (bits 0-63, the full register) and
// `m` (bits 64-95, held in a 64-bit register whose own top 32 bits are always
// zero — `decMantHi32`'s postcondition). Panics unless the true, unbounded
// product fits 96 bits; returns the low 96 bits (`lo`, `m`) otherwise.
//
// SCHOOLBOOK, base 2^64, two limbs a side — `a = aLo + aM*2^64`,
// `b = bLo + bM*2^64` — rather than three limbs of 32 bits, because `Mul`/
// `UMulHi` already give a full 64x64->128 product natively (this file's
// scale-alignment loop uses the identical pair for `lo*10`), so two limbs
// need only 4 partial products instead of 3 limbs' 9. Every partial product
// is a full 64x64->128 result (`pXXlo`/`pXXhi`) EXCEPT `p11` (`aM*bM`): both
// factors are already `< 2^96`'s own high limb (`< 2^32`), so that one
// product is `< 2^64` and needs no `UMulHi` at all — its `hi` half is always
// 0, which is exactly why it never appears in the column-3 sum below (a
// zero term contributes nothing to add).
//
// COLUMN ACCUMULATION (base `2^64`, so a "column" is one output limb, and
// each column's overflow past `2^64` is that column's carry into the next):
//   column 0 (bits   0- 63): p00lo                              = r0
//   column 1 (bits  64-127): p00hi + p01lo + p10lo   + carry-in = r1, c1
//   column 2 (bits 128-191): p01hi + p10hi + p11 + c1            = r2, c2
//   column 3 (bits 192-255): c2 (p11's hi half is always 0)      = r3
// The true 96-bit result is `r0` and `r1`'s low 32 bits; overflow is exactly
// `r1`'s high 32 bits, or `r2`, or `r3`, being nonzero — anything landing at
// bit 96 or above.
fn emitDecMulPair(fc: FnCtx, aLo: int, aM: int, bLo: int, bM: int): (int, int) {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let p00lo = emitBin(fc, Op.Mul, i64ty, aLo, bLo)
  let p00hi = emitBin(fc, Op.UMulHi, i64ty, aLo, bLo)
  let p01lo = emitBin(fc, Op.Mul, i64ty, aLo, bM)
  let p01hi = emitBin(fc, Op.UMulHi, i64ty, aLo, bM)
  let p10lo = emitBin(fc, Op.Mul, i64ty, aM, bLo)
  let p10hi = emitBin(fc, Op.UMulHi, i64ty, aM, bLo)
  let p11 = emitBin(fc, Op.Mul, i64ty, aM, bM)

  let (sum1, c1a) = emitAddWithCarry(fc, p00hi, p01lo)
  let (r1, c1b) = emitAddWithCarry(fc, sum1, p10lo)
  let c1 = emitBin(fc, Op.Add, i64ty, c1a, c1b)

  let (sum2, c2a) = emitAddWithCarry(fc, p01hi, p10hi)
  let (sum2b, c2b) = emitAddWithCarry(fc, sum2, p11)
  let (r2, c2c) = emitAddWithCarry(fc, sum2b, c1)
  let c2 = emitBin(fc, Op.Add, i64ty, emitBin(fc, Op.Add, i64ty, c2a, c2b), c2c)

  let r3 = c2
  let mask32 = emitI64Const(fc, 4294967295)
  let r1Hi = emitBin(fc, Op.LShr, i64ty, r1, emitI64Const(fc, 32))
  let noOverflow1 = emitBin(fc, Op.ICmpEq, boolTy, r1Hi, emitI64Const(fc, 0))
  let noOverflow2 = emitBin(fc, Op.ICmpEq, boolTy, r2, emitI64Const(fc, 0))
  let noOverflow3 = emitBin(fc, Op.ICmpEq, boolTy, r3, emitI64Const(fc, 0))
  let ok12 = emitCondVal(fc, noOverflow1, boolTy, noOverflow2, emitBoolConst(fc, false))
  let ok = emitCondVal(fc, ok12, boolTy, noOverflow3, emitBoolConst(fc, false))
  emitDecimalOverflowPanic(fc, ok)

  return (p00lo, emitBin(fc, Op.BAnd, i64ty, r1, mask32))
}

// `a * b` (§12, precedence row 6): the result scale is the SUM of the
// operand scales (SPEC §11.1) — panicking past 28 rather than reducing
// precision the way `System.Decimal` does, the same "overflow panics, it
// does not silently narrow" posture §13.5 already commits to for the
// mantissa. The sign is the operands' XOR, EXCEPT a zero magnitude always
// canonicalizes positive (`lowerDecimalNegate`'s invariant, preserved here
// exactly as `lowerDecimalAdd` preserves it across addition) — `-5 * 0` must
// print `0`, not a `-0` the language could not otherwise produce.
fn lowerDecimalMultiply(fc: FnCtx, a: int, b: int): int {
  let ctx = fc.c.ctx
  let i64ty = primType(ctx, 3)
  let boolTy = primType(ctx, 10)
  let words = decimalWordTypes(ctx)
  let aw = explodeValueWords(ctx, fc.b, a, words)
  let bw = explodeValueWords(ctx, fc.b, b, words)
  let loA = aw[0]
  let hiA = aw[1]
  let loB = bw[0]
  let hiB = bw[1]

  let scaleSum = emitBin(fc, Op.Add, i64ty, decScale(fc, hiA), decScale(fc, hiB))
  let scaleOk = emitBin(fc, Op.ICmpSle, boolTy, scaleSum, emitI64Const(fc, 28))
  emitDecimalOverflowPanic(fc, scaleOk)

  let (magLo, magM) = emitDecMulPair(fc, loA, decMantHi32(fc, hiA), loB, decMantHi32(fc, hiB))

  let resultNeg = emitBin(fc, Op.ICmpNe, boolTy, decIsNeg(fc, hiA), decIsNeg(fc, hiB))
  let isZero = emitBin(
    fc, Op.ICmpEq, boolTy, emitBin(fc, Op.BOr, i64ty, magLo, magM), emitI64Const(fc, 0),
  )
  let signMasked = emitCondVal(fc, resultNeg, i64ty, emitSignBitConst(fc), emitI64Const(fc, 0))
  let finalSignMasked = emitCondVal(fc, isZero, i64ty, emitI64Const(fc, 0), signMasked)
  let resultHi = decComposeHi(fc, magM, scaleSum, finalSignMasked)
  return buildTuple(fc, decimalTupleType(ctx), [magLo, resultHi])
}

// ---- §12.9 conversions to/from a plain integer -----------------------------

// Panics "decimal to integer conversion overflowed" unless `ok` — the
// conversion-specific sibling of `emitDecimalOverflowPanic` above and
// `emitDecimalDivZeroPanic` (lowerdecimaldiv.bit): SPEC §13.5 gives each
// distinct decimal fault its own message, and this one is neither an
// arithmetic overflow nor a divide-by-zero, it is `i64(d)`'s truncated
// integer part not fitting the destination's 64-bit range.
fn emitDecimalToIntOverflowPanic(fc: FnCtx, ok: int) {
  let good = builderNewBlock(fc.b)
  let bad = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = ok
  br.ival = good
  br.ival2 = bad
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, bad)
  let msg = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  msg.sval = "decimal to integer conversion overflowed"
  msg.ival = internPoolString(fc, msg.sval)
  let pn = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  pn.name = "panic"
  pn.args = [builderEmit(fc.b, msg)]
  emitRtCall(fc, pn)
  builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, good)
}

// An ordinary (non-decimal) numeric `Convert`, exactly `lowerConvert`'s own
// generic fallback (lowerprim.bit) — both operands are one register here, so
// this is the well-tested plain sign-/zero-extend-or-truncate path, never the
// 16-byte decimal case that path cannot handle.
fn emitScalarConvert(fc: FnCtx, v: int, dstTy: int): int {
  let ins = mkInstr(Op.Convert, dstTy)
  ins.lhs = v
  return builderEmit(fc.b, ins)
}

// `decimal(n)` (§12.9) for any integer `n`: exact, scale 0. An unsigned
// source is already its own magnitude — sign is always positive. A signed
// source's magnitude is computed sign-agnostically (`0 - n`, wrapping i64
// arithmetic, this file's own idiom throughout — see `emitDecAddPair`'s
// banner) rather than `Op.Neg`, which is exactly the `-i64::MIN`
// representability trap `lowerDecimalNegate` (lowerdecimal.bit) already
// avoids for the sign-bit constant; here the trap is on the VALUE itself, one
// magnitude (`i64::MIN`'s, `2^63`) past what a signed i64 can hold, and `0 -
// n` computed at 64 bits wraps to exactly that magnitude's correct bit
// pattern instead of overflowing a signed representation of it.
fn lowerIntToDecimalConvert(fc: FnCtx, srcVal: int, srcTy: int): int {
  let ctx = fc.c.ctx
  let i64ty = primType(ctx, 3)
  let boolTy = primType(ctx, 10)
  let srcI64 = srcVal
  if (srcTy != i64ty) {
    srcI64 = emitScalarConvert(fc, srcVal, i64ty)
  }
  if (!widthOf(ctx, srcTy).signed) {
    return buildTuple(fc, decimalTupleType(ctx), [srcI64, emitI64Const(fc, 0)])
  }
  let isNeg = emitBin(fc, Op.ICmpSlt, boolTy, srcI64, emitI64Const(fc, 0))
  let magNeg = emitBin(fc, Op.Sub, i64ty, emitI64Const(fc, 0), srcI64)
  let mag = emitCondVal(fc, isNeg, i64ty, magNeg, srcI64)
  let signMasked = emitCondVal(fc, isNeg, i64ty, emitSignBitConst(fc), emitI64Const(fc, 0))
  let hi = decComposeHi(fc, emitI64Const(fc, 0), emitI64Const(fc, 0), signMasked)
  return buildTuple(fc, decimalTupleType(ctx), [mag, hi])
}

// `i64(d)` (§12.9): truncates the fractional part toward zero, matching the
// `float -> int truncates toward zero` rule the same section already states
// for every other numeric conversion. Divides the mantissa down by its own
// scale (`emitDecimalDivPow10`, lowerdecimaldiv.bit — dropping the remainder
// each round IS the truncation), panics if the truncated magnitude does not
// fit a 64-bit integer, reapplies the sign the same wrapping way
// `lowerIntToDecimalConvert` builds it, then hands off to the ordinary
// int-to-int path for any destination narrower or wider than `i64` — exactly
// the truncate/extend §12.9 already defines for two plain integer types.
fn lowerDecimalToIntConvert(fc: FnCtx, srcVal: int, dstTy: int): int {
  let ctx = fc.c.ctx
  let i64ty = primType(ctx, 3)
  let boolTy = primType(ctx, 10)
  let words = explodeValueWords(ctx, fc.b, srcVal, decimalWordTypes(ctx))
  let lo = words[0]
  let hi = words[1]
  let neg = decIsNeg(fc, hi)
  let (tlo, tm) = emitDecimalDivPow10(fc, lo, decMantHi32(fc, hi), decScale(fc, hi))

  let bound = emitCondVal(
    fc,
    neg,
    i64ty,
    emitSignBitConst(fc),
    emitI64Const(fc, 9223372036854775807),
  )
  let noHiBits = emitBin(fc, Op.ICmpEq, boolTy, tm, emitI64Const(fc, 0))
  let inRange = emitBin(fc, Op.ICmpUle, boolTy, tlo, bound)
  // `emitDecMulPair`'s own `ok12`/`ok` shape above: this file's idiom for
  // ANDing two runtime bools is a nested `emitCondVal`, not a bitwise op.
  let fits = emitCondVal(fc, noHiBits, boolTy, inRange, emitBoolConst(fc, false))
  emitDecimalToIntOverflowPanic(fc, fits)

  let magNeg = emitBin(fc, Op.Sub, i64ty, emitI64Const(fc, 0), tlo)
  let result64 = emitCondVal(fc, neg, i64ty, magNeg, tlo)
  if (dstTy == i64ty) {
    return result64
  }
  return emitScalarConvert(fc, result64, dstTy)
}
