// Parser: attributes, function and extern declarations, top-level decl
// dispatch, and the program/source entry points. Split out of parser.bit
// (#1503); sibling .bit files are the same module, so this is a pure move.

// `attr_list = attr { attr }`, `attr = "@" IDENT [ "(" string_lit ")" ]`. One or
// more `@name`, each optionally carrying a single string argument (§11.9
// `@symbol("...")`); each consumes the `@`, so the loop is bounded by the token
// count. The argument child is ELIDED when absent, so a bare `@naked`/`@nosplit`
// keeps the exact 1-child shape it had before arguments existed.
fn parseAttrList(p: Parser): int {
  // mkNode spans only its KIDS, and neither the `@` nor the closing `)` is one —
  // capture both tokens explicitly so an `attr` covers `@name("arg")` whole, like
  // the seed's. Without this a diagnostic carried on one of these nodes (E0080,
  // which reports on the list) underlines one column short of the seed.
  let listStart = peekTok(p).start
  let items = []int(0)
  let guard = 0
  while (peekKind(p) == Kind.At && guard < 100000) {
    let atStart = peekTok(p).start
    advance(p) // '@'
    let name = expectIdent(p)
    if (peekKind(p) == Kind.LParen) {
      advance(p) // '('
      let arg = 0
      if (peekKind(p) == Kind.StringLit) {
        arg = leaf(p, Tag.StringLit)
      } else {
        parseFail(p, "a string literal argument")
      }
      let closeEnd = peekTok(p).end
      expect(p, Kind.RParen)
      items = append(items, addNode(p.tree, Tag.Attr,
        Span{ file: p.file, start: atStart, end: closeEnd }, 0, [name, arg]))
    } else {
      let nameEnd = spanOfKids(p, [name]).end
      items = append(items, addNode(p.tree, Tag.Attr,
        Span{ file: p.file, start: atStart, end: nameEnd }, 0, [name]))
    }
    // Both IDENT and `)` are ASI terminators (§7), so a newline after an
    // attribute synthesizes a semicolon. An attribute list is only ever followed
    // by another attribute or `function`, so a separator here can never be
    // meaningful — drop it, which lets an attribute sit on its own line above
    // the declaration it modifies.
    let sguard = 0
    while (peekKind(p) == Kind.Semicolon && sguard < 100000) {
      advance(p)
      sguard = sguard + 1
    }
    guard = guard + 1
  }
  // An empty list keeps the entry position for both ends, as the seed's does.
  let end = listStart
  if (len(items) != 0) {
    end = spanOfKids(p, [items[len(items) - 1]]).end
  }
  return addNode(p.tree, Tag.AttrList, Span{ file: p.file, start: listStart, end: end }, 0, items)
}

// `function` was the bootstrap-bridge spelling of `fn` (SPEC §10.3) until
// #2773 removed it from the lexer; it now lexes as an ordinary identifier.
const ecFunctionKeywordRemoved = 89

// Every site below that dispatches on `Kind.KwFunction` would otherwise fall
// through to a generic "expected ..." diagnostic that never names the
// replacement, and the word is common enough in pre-#2773 source that a bare
// parse error is a poor trade for the one line this costs. True iff the
// current token is exactly that identifier, in which case the diagnostic is
// already reported and the caller only needs to recover.
fn checkOldFunctionKeyword(p: Parser): bool {
  if (peekKind(p) != Kind.Ident || curText(p) != "function") {
    return false
  }
  let t = peekTok(p)
  report(p.diags, ecFunctionKeywordRemoved,
    Span{ file: p.file, start: t.start, end: t.end },
    "'function' is not a keyword", "declare functions with 'fn' (SPEC §10.3)")
  return true
}

// The retired keyword was the bootstrap-bridge spelling of `class` for
// exactly one release (#3425) until #3427 removed it from the lexer; it now
// lexes as an ordinary identifier. First free code above E0101
// (validateexpr.bit's ecWildcardUnreachable).
const ecStructKeywordRemoved = 102

// Same shape as `checkOldFunctionKeyword`: every site below that dispatches
// on `Kind.KwStruct` would otherwise fall through to a generic "expected ..."
// diagnostic that never names the replacement, and the retired word is common
// enough in pre-#3427 source that a bare parse error is a poor trade for the
// one line this costs.
fn checkOldStructKeyword(p: Parser): bool {
  if (peekKind(p) != Kind.Ident || curText(p) != "struct") {
    return false
  }
  let t = peekTok(p)
  report(p.diags, ecStructKeywordRemoved,
    Span{ file: p.file, start: t.start, end: t.end },
    "'struct' is not a keyword", "declare classes with 'class' (SPEC §10.5)")
  return true
}

// The written `fn (recv: Type) name()` method form was removed by #3762 in
// favor of declaring the method inside the class body (SPEC §10.4). Every
// top-level `fn` immediately followed by `(` used to be this form's receiver
// clause; left unchecked it falls through to parseParams reading `(recv:
// Type)` as an (invalid, parenthesized) parameter list, producing a
// cascading "expected an identifier"/"expected '{'" that never names the
// replacement. First free code above E0102 (checkOldStructKeyword above).
const ecReceiverFormRemoved = 103

fn checkOldReceiverForm(p: Parser): bool {
  if (peekKind(p) != Kind.LParen) {
    return false
  }
  let t = peekTok(p)
  report(p.diags, ecReceiverFormRemoved,
    Span{ file: p.file, start: t.start, end: t.end },
    "the 'fn (recv: Type) name()' method form was removed in 0.2.0",
    "declare the method inside 'class Type { ... }' using the implicit 'this' receiver (SPEC §10.4)")
  return true
}

// Attributes attach to function declarations (§10.3.1) and to module-level
// state (§11.11 `@threadlocal let`). Any other target is a parse error.
fn parseAttrDecl(p: Parser): int {
  let attrs = parseAttrList(p)
  if (peekKind(p) == Kind.KwFunction) {
    return parseFuncDecl(p, attrs)
  }
  if (peekKind(p) == Kind.KwLet) {
    // §11.11 defines exactly one attribute at this position, so the legal set
    // here is a syntactic property of the position and is checked here.
    if (!attrsAreThreadLocal(p, attrs)) {
      parseFail(p, "'@threadlocal', the only attribute a 'let' accepts")
      synchronizeTopLevel(p)
      return 0
    }
    return parseValueDecl(p, Tag.LetDecl, 1)
  }
  if (checkOldFunctionKeyword(p)) {
    synchronizeTopLevel(p)
    return 0
  }
  parseFail(p, "'fn' or 'let' after an attribute")
  synchronizeTopLevel(p)
  return 0
}

// True iff `attrs` is exactly the single attribute `@threadlocal`, with no
// argument. Anything else is rejected by the caller.
fn attrsAreThreadLocal(p: Parser, attrs: int): bool {
  let list = kidsOf(p.tree, attrs)
  if (len(list) != 1) {
    return false
  }
  let attrKids = kidsOf(p.tree, list[0])
  if (len(attrKids) != 1) {
    return false
  }
  let sp = getNode(p.tree, attrKids[0]).span
  return p.src[sp.start:sp.end] == "threadlocal"
}

// `func_decl = [recv_or_none, name, generics_or_none, params, result_or_none,
// body, attrs_or_none]`. `attrs` (the 7th child) is elided when absent so the
// attr-less corpus' AST dumps stay byte-identical. `recv` is always `none`
// (0) here: a top-level `fn` never has a receiver of its own — #3762 removed
// the written `fn (recv: T) name()` form (SPEC 10.4 pre-0.2.0). The kid slot
// itself stays, unrenumbered, because `parsertype.bit`'s `parseMethodMember`
// (the in-body method form, #3367) still produces a real, non-zero `Receiver`
// kid here for a method parsed inside a class body — every reader of
// `FuncDecl`'s shape (the checker's collect/main sweeps, method-table
// building, lowering's Pass A3) keeps working against that kid unchanged.
fn parseFuncDecl(p: Parser, attrs: int): int {
  advance(p)
  if (checkOldReceiverForm(p)) {
    synchronizeTopLevel(p)
    return 0
  }
  let name = expectIdent(p)
  let generics = maybeGenericParams(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let body = parseBlock(p)
  if (attrs == 0) {
    return mkNode(p, Tag.FuncDecl, 0, [0, name, generics, params, result, body])
  }
  return mkNode(p, Tag.FuncDecl, 0, [0, name, generics, params, result, body, attrs])
}

// `extern_fn_decl = "extern" "fn" IDENT signature` (SPEC 11.7). No body,
// no receiver, no generics — a bare binding from a Bit name to an external
// symbol the linker resolves from a dylib.
fn parseExternFnDecl(p: Parser): int {
  // mkNode spans only its KIDS, and `extern` is not one — capture the keyword
  // token explicitly so the node covers the whole declaration like the seed's.
  let start = peekTok(p).start
  advance(p) // 'extern'
  if (peekKind(p) != Kind.KwFunction) {
    if (checkOldFunctionKeyword(p)) {
      // Unlike the generic fallback just below, this recovers to the next
      // top-level declaration rather than one token past `function` — the
      // cascading "expected a top-level declaration" that a bare `advance`
      // leaves on the declaration's name would bury the one diagnostic that
      // names the fix.
      synchronizeTopLevel(p)
      return 0
    }
    parseFail(p, "'fn' after 'extern'")
    advance(p)
    return 0
  }
  advance(p) // 'fn'
  let name = expectIdent(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let kids = [name, params, result]
  let sp = spanOfKids(p, kids)
  return addNode(p.tree, Tag.ExternFnDecl, Span{ file: p.file, start: start, end: sp.end }, 0, kids)
}

// Skips to the next token that can start a top-level declaration, or `;`
// (consumed), or eof — the seed's `synchronizeTopLevel`. Bounded by the
// remaining tokens.
//
// The stop set deliberately mirrors the seed's EXACTLY, including its omission
// of `enum` and `@`: the two compilers must agree on where recovery resumes or
// every cascading diagnostic after a bad top-level token diverges. Widening it
// here would be a unilateral change to the oracle.
fn synchronizeTopLevel(p: Parser) {
  let guard = 0
  while (peekKind(p) != Kind.Eof && guard < 1000000) {
    let k = peekKind(p)
    if (k == Kind.Semicolon) {
      advance(p)
      return
    }
    if (k == Kind.KwImport || k == Kind.KwExport || k == Kind.KwLet || k == Kind.KwConst ||
      k == Kind.KwFunction || k == Kind.KwStruct || k == Kind.KwInterface || k == Kind.KwType) {
      return
    }
    advance(p)
    guard = guard + 1
  }
}

// Every non-import declaration that may follow `export`. `what` names what was
// expected, because the seed words the failure differently by context — "a
// top-level declaration" at file scope, "a declaration after 'export'" after
// the keyword.
fn parseExportableDecl(p: Parser, what: string): int {
  let k = peekKind(p)
  // `extern` is a CONTEXTUAL keyword: it lexes as an ordinary identifier and
  // stays usable as one everywhere else. Unambiguous here because an identifier
  // can never begin a declaration, so this commits with no lookahead.
  if (k == Kind.Ident && curText(p) == "extern") { return parseExternFnDecl(p) }
  if (checkOldFunctionKeyword(p)) {
    synchronizeTopLevel(p)
    return 0
  }
  if (checkOldStructKeyword(p)) {
    synchronizeTopLevel(p)
    return 0
  }
  if (k == Kind.KwConst) { return parseValueDecl(p, Tag.ConstDecl, 0) }
  if (k == Kind.KwLet) { return parseValueDecl(p, Tag.LetDecl, 0) }
  if (k == Kind.At) { return parseAttrDecl(p) }
  if (k == Kind.KwFunction) { return parseFuncDecl(p, 0) }
  if (k == Kind.KwStruct) { return parseStructDecl(p) }
  if (k == Kind.KwInterface) { return parseInterfaceDecl(p) }
  if (k == Kind.KwEnum) { return parseEnumDecl(p) }
  if (k == Kind.KwType) { return parseTypeAlias(p) }
  // Unrecognized: report and synchronize. Silently swallowing the token instead
  // let ANY garbage at file scope through with no diagnostic at all.
  parseFail(p, what)
  synchronizeTopLevel(p)
  return 0
}

fn parseTopDecl(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.KwImport) { return parseImportDecl(p) }
  if (k == Kind.KwExport) {
    advance(p)
    let inner = parseExportableDecl(p, "a declaration after 'export'")
    if (inner == 0) {
      return 0
    }
    return mkNode(p, Tag.Export, 0, [inner])
  }
  return parseExportableDecl(p, "a top-level declaration")
}

fn parseProgram(p: Parser): int {
  let decls = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.Eof && guard < 100000) {
    guard = guard + 1
    if (acceptTok(p, Kind.Semicolon)) {
      continue
    }
    let d = parseTopDecl(p)
    if (d == 0) {
      continue // already reported and synchronized; re-checking would double-report
    }
    decls = append(decls, d)
    // A declaration not closed by `;`/eof is malformed: report the missing
    // separator once and synchronize, mirroring `parseBlock`'s statement
    // recovery. Blanket-skipping semicolons instead let a run of garbage after a
    // good declaration through unreported.
    if (!acceptTok(p, Kind.Semicolon) && peekKind(p) != Kind.Eof) {
      parseFail(p, "';'")
      synchronizeTopLevel(p)
    }
  }
  return mkNode(p, Tag.Program, 0, decls)
}

// Parses `src` into a Tree whose root is the `program` node.
fn parseSource(src: string): Tree {
  let p = newParser(src)
  p.tree.root = parseProgram(p)
  return p.tree
}

// Lexes + parses `src`, reporting lex and parse diagnostics into `diags` (spans
// stamped `file`). Backs `--dump-diags`.
fn parseSourceD(src: string, file: int, diags: Diagnostics): Tree {
  let p = newParserD(src, file, diags)
  p.tree.root = parseProgram(p)
  return p.tree
}
