// Self-host Stage 3 (#1346): the x86-64 backend, Win64 stack probing.
// Split out of compiler/x64call.bit (#3327, to keep it under the 800-line
// limit); same module, so nothing here is imported.

// ---------------------------------------------------------------------------
// #3327: Win64 stack probing
// ---------------------------------------------------------------------------
//
// Linux and macOS grow a thread's stack on demand: any fault inside the
// mapped-but-unbacked region just commits a page and resumes. Windows does
// not — a thread's stack sits behind a single guard page, and touching more
// than one page below the last-committed page skips the guard entirely,
// turning what should be stack growth into an access violation. A bare
// `sub rsp, N` for N over a page, followed by any write near the new rsp, is
// exactly that skip.
//
// Windows' page size is architecturally fixed at 4 KiB. This constant is
// BOTH the size past which xEmitPrologue must probe (a frame this size or
// smaller can only ever touch the one page the OS already guards, so the
// fault-driven growth above still works with no help) and the stride between
// each probe touch (touching more than a page apart would itself skip the
// very guard page the probe exists to hit).
fn xWinStackGuardPageBytes(): int {
  return 4096
}

// Touches every full page of `frameSize` in DESCENDING order, at most
// xWinStackGuardPageBytes() apart, ending with rsp at exactly the same place
// `xRspAddSub(cx.buf, true, frameSize)` would have left it. The final partial
// page (< one page, by construction) is left untouched on purpose: it is
// within one page of the last real touch, so the first genuine write into it
// hits the guard page exactly the way an untouched at-or-below-one-page frame
// already relies on — that is the invariant the threshold check in
// xEmitPrologue (compiler/x64call.bit) depends on, not a shortcut taken here.
//
// r11 (xScratch1) and r10 (xScratch2) are the only registers this clobbers
// besides rsp, and neither holds a live value at this point in the prologue
// under either convention: Win64's four integer arguments arrive in
// rcx/rdx/r8/r9 (SysV's six in rdi/rsi/rdx/rcx/r8/r9, moot here since this
// only ever runs for Win64), and xBindIncomingArgs — which moves them into
// their vreg homes — has not run yet. Both are the reserved codegen scratch
// pair (compiler/x64.bit), never allocatable and never an argument register
// in either convention.
fn xEmitWinStackProbe(cx: XCtx, frameSize: int) {
  let page = xWinStackGuardPageBytes()
  let remaining = xScratch1() // r11: bytes still to allocate
  let pageReg = xScratch2()   // r10: the page size, for the one comparison an
                               // immediate form can't express (xArithImmDigit
                               // covers only Add/Sub)
  xMovRI(cx.buf, remaining, frameSize)
  xMovRI(cx.buf, pageReg, page)
  let loopStart = len(cx.buf.code)
  xArithRR(cx.buf, XArith.Cmp, remaining, pageReg)
  let doneFixup = xJccRel32Placeholder(cx, ccBe()) // remaining <= page -> tail
  xArithImm32(cx.buf, XArith.Sub, XReg64.Rsp, page)
  // The touch: any write commits the whole page. The value stored is
  // meaningless — nothing has been spilled or saved into the frame yet, so
  // this word carries no live data for anything to read.
  xMovStore(cx.buf, xMemB(XReg64.Rsp, 0), remaining, 8)
  xArithImm32(cx.buf, XArith.Sub, remaining, page)
  xJmpRel32To(cx, loopStart)
  xPatchRel32Here(cx, doneFixup)
  xArithRR(cx.buf, XArith.Sub, XReg64.Rsp, remaining) // the untouched tail
}
