// Self-host: validation of the statement walk and control flow (#1503, split
// out of validate.bit; #2906, further split — operator/return/call/arrow
// validation moved to validatecall.bit to keep both files under the 800-line
// lint limit). `catch`/`spawn`/`defer`, composite literals, the statement
// dispatcher itself, and E0055 missing-return divergence.

// ---- the statement walk ----------------------------------------------------

// `spawn`/`defer` take a call and nothing else.
// A `catch e { … }` block's LAST statement, when it is a bare expression, is
// the block's VALUE — not a discarded result — so E0065 must not fire on it
// (`checkCatchBlock` type-checks it against the ok type instead of
// routing it through `checkExprStmt`). vStmt is a generic tag-dispatch walk, so
// without this it visited that tail like any other statement: 80 FALSEPOS, all
// of them working `catch` blocks.
//
// Handling the block here rather than through a shared exempt-set keeps the
// exemption local to the one construct that has it. `catch <expr>` (CatchDefault)
// has no block and needs nothing.
//
// E0067 rides along because the seed derives it from the same walk: a block that
// neither ends in a value expression nor diverts control is incomplete —
// UNLESS the operand's ok type is `()`. SPEC §11 (line 750) makes a bare `()`
// a valid type only in RESULT position, so no expression can ever "produce"
// it; requiring one would make a `()!` catch block unsatisfiable by
// construction (#2103). A block that falls off the end already yields `()`
// with no expression needed, exactly as an arrow-fn block body with no
// value-returning `return` already does (§12.8, line 1684) — so for this one
// ok type, falling through (empty block or not) is well-formed. `lowerCatch`
// (lowerfail.bit) already treats a void ok type this way; only the validator
// was refusing it. A non-void `T!E` still requires a value or divergence.
fn vCatchBind(c: Checker, result: int, node: int, brk: int, loop: int, fallible: bool) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) < 3) {
    return
  }
  let block = kids[2]
  vStmt(c, result, kids[0], brk, loop, fallible)
  if (block == 0) {
    return
  }
  let okTy = unwrapFallible(c, checkExprType(c, kids[0]))
  let unitOk = okTy == c.ctx.voidId
  let stmts = kidsOf(c.tree, block)
  if (len(stmts) == 0) {
    if (unitOk) {
      return
    }
    reportNoHint(
      c.diags, ecCatchBlockIncomplete, vSpan(c, block),
      "'catch' block must produce a value or divert control (return/fail/panic/break/continue)",
    )
    return
  }
  let last = stmts[len(stmts) - 1]
  let i = 0
  while (i < len(stmts) - 1) {
    vStmt(c, result, stmts[i], brk, loop, fallible)
    i = i + 1
  }
  if (getNode(c.tree, last).tag == Tag.ExprStmt) {
    // The value expression: validate what is INSIDE it, never the statement
    // wrapper (that wrapper is what E0065 judges).
    let inner = kidsOf(c.tree, last)
    if (len(inner) > 0) {
      vStmt(c, result, inner[0], brk, loop, fallible)
      vCatchTailExpect(c, last, inner[0], okTy, unitOk)
    }
    return
  }
  vStmt(c, result, last, brk, loop, fallible)
  if (!vDiverges(c, last, true) && !unitOk) {
    reportNoHint(
      c.diags, ecCatchBlockIncomplete, vSpan(c, block),
      "'catch' block must produce a value or divert control (return/fail/panic/break/continue)",
    )
  }
}

// #2981: vCatchBind's ExprStmt tail IS the block's value (checkExprType's
// CatchBind case types the whole `catch` expression from the OPERAND alone,
// independent of what the block actually yields — checkexpr.bit:441-442 —
// so nothing else ever compares them), so `exprNode` must type-check against
// `okTy` UNLESS one of two exemptions applies, both matching vCatchBind's
// general (non-ExprStmt) branch: a void ok type (SPEC §18.3: no expression
// can produce `()`, and `lowerCatchBlock` (lowerfail.bit:281) already runs a
// void-ok tail as an ordinary discarded statement rather than as a value),
// or a diverging tail (`panic(...)`/`exit(...)` never return, so it has no
// value to compare — `vDiverges`'s own `Tag.ExprStmt` case is exactly this
// predicate; run_parseint_intmin.bit's `catch e { panic(...) }` on an
// `i64!` operand caught the omission). `last` is the ExprStmt wrapper
// (`vDiverges` needs the statement, not the inner expression); `exprNode`
// is what actually gets checked. Split out of vCatchBind to keep it under
// spec/LINT.md's max-complexity (E0204, #3488).
fn vCatchTailExpect(c: Checker, last: int, exprNode: int, okTy: int, unitOk: bool) {
  if (!unitOk && !vDiverges(c, last, true)) {
    vExpectExpr(c, exprNode, okTy)
  }
}

fn vSpawnDefer(c: Checker, node: int, word: string) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0 || kids[0] == 0) {
    return
  }
  if (getNode(c.tree, kids[0]).tag == Tag.Call) {
    return
  }
  reportNoHint(
    c.diags, ecExpectedCallExpr, vSpan(c, node),
    "'${word}' requires a call expression",
  )
}

// Whether a node opens a `break`-able construct (for/while/switch/select) and,
// separately, a `continue`-able one (for/while only) — the seed's two counters.
fn vIsLoop(t: Tag): bool {
  return t == Tag.ForC || t == Tag.ForOf || t == Tag.ForIn || t == Tag.ForInf || t == Tag.WhileStmt
}
fn vIsBreakable(t: Tag): bool {
  return vIsLoop(t) || t == Tag.SwitchStmt || t == Tag.SelectStmt
}

// Walks a composite literal in the seed's order (#1489): the whole-literal
// array-length rule first, then each slot's own subtree BEFORE that slot's
// assignability — `checkStructInit` / `checkSeqInit` / `checkMapInit` each call
// checkExpr and only then `expect`. A map entry interleaves at slot
// granularity, not entry granularity, because the seed judges the key before it
// descends into the value.
//
// Visits exactly the nodes the generic kid loop did (the type node, then every
// item's subtree), so this changes sequence only, never coverage.
fn vComposite(c: Checker, result: int, node: int, brk: int, loop: int, fallible: bool) {
  let kids = kidsOf(c.tree, node) // [type, init]
  vStmt(c, result, kids[0], brk, loop, fallible)
  vCompositeArrayLen(c, node)
  // Whole-literal, so pre-order alongside the length rule — which field is
  // absent does not depend on what any present slot's expression turns out to
  // be (#1914).
  vCompositeNoOmitted(c, node)
  // E0110 (classinit.bit, #3371): a composite literal for an
  // 'init'-declaring class, outside its defining module. Whole-literal too —
  // the seal does not depend on any slot's own expression.
  vCompositeInitSeal(c, node)
  for it of kidsOf(c.tree, kids[1]) {
    if (getNode(c.tree, it).tag == Tag.MapEntry) {
      let mk = kidsOf(c.tree, it) // [key, val]
      vStmt(c, result, mk[0], brk, loop, fallible)
      vCompositeSlot(c, node, it, 0)
      vStmt(c, result, mk[1], brk, loop, fallible)
      vCompositeSlot(c, node, it, 1)
    } else {
      vStmt(c, result, it, brk, loop, fallible)
      vCompositeSlot(c, node, it, 0)
    }
  }
}

// E0116 (§18.3, #4013): a `?` whose OPERAND is not fallible. First free code
// above E0115 (validateattr.bit's ecTestDeclOutsideTestFile) — the LINT range
// starts at E0200, so this is a checker code, not a lint one. Distinct from
// E0061 (ecTryOutsideFallible, validate.bit): that code is about the
// ENCLOSING function; this one is about the operand, and the two never fire
// on the same node (see vTryExpr's if/else).
const ecTryOperandNotFallible = 116

// The whole of `expr?`'s validation, both halves of SPEC §18.3's sentence:
// the ENCLOSING function must be fallible (E0061), and separately the
// OPERAND itself must be (E0116, #4013). Extracted out of `vStmt` rather than
// left as two conditions inline there (compiler/validatestmt.bit vStmt's
// complexity is a pinned ratchet, tools/build/complexity-debt.txt, at its
// recorded baseline of 53) — folding a second `&&` condition in directly
// would have crossed it, and this gate never tolerates a raised baseline.
// the if/else keeps the two diagnostics mutually exclusive: a `?` wrong on
// both counts (non-fallible function AND non-fallible operand) reports only
// E0061, matching the enclosing-function check's own pre-existing behaviour.
// `opTy == 0` (uninferred/invalid) is silently skipped per this file's
// header: a validator that invents an error on an undecided type breaks a
// working build.
fn vTryExpr(c: Checker, node: int, fallible: bool) {
  if (!fallible) {
    reportNoHint(
      c.diags, ecTryOutsideFallible, vSpan(c, node),
      "'?' is only valid inside a fallible function",
    )
  } else {
    let opTy = checkExprType(c, kidsOf(c.tree, node)[0])
    if (opTy != 0 && c.ctx.types[opTy].kind != TypeKind.Fallible) {
      let tn = typeName(c.ctx, opTy)
      reportNoHint(
        c.diags, ecTryOperandNotFallible, vSpan(c, node),
        "'?' operand has type '${tn}', which is not fallible",
      )
    }
  }
}

// Walks `node` validating statements, carrying the enclosing function's declared
// result type plus the loop/fallible context the seed tracks: `brk` counts
// break-able constructs, `loop` counts for/while (continue targets those only),
// and `fallible` is set inside a `T!` function. Descends every child; a node
// with nothing to check falls through.
fn vStmt(c: Checker, result: int, node: int, brk: int, loop: int, fallible: bool) {
  if (node == 0) {
    return
  }
  let t = getNode(c.tree, node).tag
  // An arrow function has its own result AND its own loop/fallible context, so
  // its body is walked under THAT context, never this one (#1522).
  //
  // #1521 landed a `vTypeNodes` sweep here, on the premise that this walk did not
  // descend an arrow at all, so the arrow's type nodes would otherwise go
  // unreported. #1522 removed that premise: `vArrow` walks every kid through
  // `vStmt`, which now emits `vTypeNode` per node on the way out. Sweeping as
  // well would report each of them twice.
  if (t == Tag.ArrowFn) {
    vArrow(c, node)
    return
  }
  if (t == Tag.Binary) {
    vBinary(c, node)
  }
  if (t == Tag.CondExpr) {
    vConditional(c, node)
  }
  if (t == Tag.Unary) {
    vUnary(c, node)
  }
  if (t == Tag.SwitchStmt) {
    vSwitch(c, node)
  } // implicit `subject == label`, #2428
  // #2488: the function-body half of §15.4's overflow check — `vModuleState`/
  // `vTopLevelConst` (validateunmanaged.bit) only fold a const initializer, so
  // this is the only place a `let` inside a function, a call argument, or a
  // `return` operand ever gets checked.
  if (t == Tag.IntLit) {
    vIntLitRange(c, node)
  }
  if (t == Tag.ReturnStmt) {
    vReturn(c, result, node)
  }
  if (t == Tag.Call) {
    vCall(c, node)
  }
  if (t == Tag.Call) {
    vNotCallable(c, node)
  }
  if (t == Tag.Call) {
    vVariantArity(c, node)
  }
  if (t == Tag.Call) {
    vGenericBound(c, node)
  }
  if (t == Tag.Call) {
    vUnmanagedBuiltin(c, node)
  }
  if (t == Tag.Call) {
    vConversion(c, node)
  }
  if (t == Tag.Call) {
    vSliceAllocArity(c, node)
  }
  if (t == Tag.Call) {
    vSliceAllocNoZeroValue(c, node)
  }
  if (t == Tag.Call) {
    vMapCtorArity(c, node)
  }
  if (t == Tag.Call) {
    vChanCtorArgs(c, node)
  }
  if (t == Tag.Call) {
    vArrayCtorRejected(c, node)
  }
  if (t == Tag.Call) {
    vUserConversion(c, node)
  }
  if (t == Tag.StrInterp) {
    vInterp(c, node)
  }
  if (t == Tag.Index) {
    vIndex(c, node)
  }
  if (t == Tag.TupleIndex) {
    vTupleIndex(c, node)
  }
  if (t == Tag.Member) {
    vMember(c, node)
  }
  if (t == Tag.TypeAssert) {
    vTypeAssert(c, node)
  }
  if (t == Tag.Assign) {
    vDestructure(c, node)
  }
  if (t == Tag.Assign) {
    vAssignIface(c, node)
  }
  if (t == Tag.IncStmt) {
    vIncDec(c, node)
  }
  if (t == Tag.DecStmt) {
    vIncDec(c, node)
  }
  // Owns its own kid recursion, POST-order (#1521). seed `checkBinding` is
  // `checkType(annotation)` -> `checkExpr(init)` -> `expect(init)`: the
  // annotation's own E0052/E0072 and everything nested in the initializer are
  // reported BEFORE the binding's assignability verdict, because you cannot
  // judge assignability before you know the initializer's type. Judging at
  // pre-order emitted the same diagnostics in a different sequence, and became
  // visible the moment body type nodes stopped being hoisted by vTypeNodes.
  //
  // vBinding SUPERSEDES the former vBindingIface: it carries the identical
  // guards (annotation present, non-tuple pattern) and routes through vExpect,
  // which reports the §14.3 not-storable case vIfaceStore covered AND the
  // unsatisfied-method-set case it did not. Running both double-reported.
  // vInferEnum is mutually exclusive with it (it returns on an annotation,
  // vBinding returns without one), so their relative order is unobservable.
  if (t == Tag.Binding) {
    // A binding is neither a loop nor breakable, so the kid context is unchanged.
    for k of kidsOf(c.tree, node) {
      vStmt(c, result, k, brk, loop, fallible)
    }
    vInferEnum(c, node)
    vBinding(c, node)
    vBindingNoZeroValue(c, node)
    return
  }
  // Owns its own kid recursion (#1489). The seed's checkCompositeLit checks a
  // slot's expression — reporting everything nested inside it — and only THEN
  // that slot's assignability, so judging the whole literal at pre-order and
  // descending afterwards emits the same diagnostics in a different sequence.
  if (t == Tag.CompositeLit) {
    vComposite(c, result, node, brk, loop, fallible)
    return
  }
  if (t == Tag.Call) {
    vCallArgIface(c, node)
  }
  if (t == Tag.SendStmt) {
    vSendIface(c, node)
  }
  if (t == Tag.CommCase) {
    vComm(c, kidsOf(c.tree, node)[0])
  }
  if (t == Tag.AsmStmt) {
    vAsm(c, node)
  }
  if (t == Tag.MatchStmt) {
    vMatch(c, node)
  }
  if (t == Tag.MatchStmt) {
    vMatchExpr(c, node)
  }
  if (t == Tag.ExprStmt) {
    vExprStmt(c, node)
  }
  if (t == Tag.SpawnStmt) {
    vSpawnDefer(c, node, "spawn")
  }
  if (t == Tag.DeferStmt) {
    vSpawnDefer(c, node, "defer")
  }
  // Owns its own kid recursion (its block's tail is a value, not a statement).
  if (t == Tag.CatchBind) {
    vCatchBind(c, result, node, brk, loop, fallible)
    return
  }
  if (t == Tag.BreakStmt && brk == 0) {
    reportNoHint(
      c.diags, ecInvalidBreakContinue, vSpan(c, node),
      "'break' outside a for/while/switch/select",
    )
  }
  if (t == Tag.ContinueStmt && loop == 0) {
    reportNoHint(
      c.diags, ecInvalidBreakContinue, vSpan(c, node),
      "'continue' outside a for/while loop",
    )
  }
  if (t == Tag.FailStmt && !fallible) {
    reportNoHint(
      c.diags, ecFailOutsideFallible, vSpan(c, node),
      "'fail' is only valid inside a fallible function",
    )
  }
  if (t == Tag.TryExpr) {
    vTryExpr(c, node, fallible)
  }
  let cbrk = brk
  let cloop = loop
  if (vIsLoop(t)) {
    cbrk = brk + 1
    cloop = loop + 1
  } else if (vIsBreakable(t)) {
    cbrk = brk + 1
  }
  for k of kidsOf(c.tree, node) {
    vStmt(c, result, k, cbrk, cloop, fallible)
  }
  // POST-order, after the kids, so a nested type reports inner-first and a type
  // node embedded in an expression reports in its source position among that
  // expression's other diagnostics — the seed emits these from `checkType`,
  // reached at exactly this point in its own walk (#1521).
  vTypeNode(c, node)
}

// ---- E0055 missing-return: control-flow divergence (§10.3) -----------------
// Ported from `diverges`. The rule: a non-void function whose body is
// not proven to always divert control (return / fail / panic / infinite loop /
// exhaustive all-arms-diverge) is missing a return. Conservative TOWARD NOT
// EMITTING — any construct that cannot be proven to fall through is treated as
// diverging — because a missed missing_return is a harmless gap (the seed still
// gates) but a spurious one rejects a valid build. The corpus is code the seed
// accepts, so every non-void body must read as diverging here or the diffcheck
// FALSEPOS gate fires; that gate is what proves this port faithful.

// The while-condition is the literal `true`. bit2 has no const-evaluator, so a
// const that folds to true is not recognised (under-detects vs the seed's
// constEval — but that only under-reports, never false-positives; `for {}` is
// the idiomatic infinite loop and is handled exactly via ForInf).
fn vIsTrueLit(c: Checker, node: int): bool {
  if (node == 0 || getNode(c.tree, node).tag != Tag.BoolLit) {
    return false
  }
  let sp = getNode(c.tree, node).span
  return c.source[sp.start:sp.end] == "true"
}

// A call that diverges by terminating the process: the builtin `panic`, or
// `std/os`'s `exit` (#3471 — `exit` calls `osExit`, which never returns, so a
// `catch` tail of `eprint(...); exit(2)` was rejected with E0041 for falling
// off the end, even though it never falls anywhere).
//
// `panic`'s case mirrors the seed's isPanicCall: the bare name `panic`,
// shadowed by neither a local value nor a user function (the same
// permissiveness vCall uses to identify a builtin) — panic has NO
// declaration anywhere, so `funcRefAt(...).decl == 0` alone tells "the real
// builtin" apart from "a user redefinition".
//
// `exit` cannot use that same test: unlike `panic` it is an ordinary EXPORTED
// function, so once imported it always resolves to a real decl and
// `decl == 0` would never fire — a fix that reused panic's exact condition
// would be as vacuous as checking a `noreturn` type that this language does
// not have (grep confirms zero occurrences of "noreturn" in spec/ or
// compiler/). What distinguishes the real `std/os.exit` from a local
// redefinition of the same name is which module owns the resolved decl: an
// import resolves to a decl owned by the EXPORTING module (a different
// `moduleId` from this call site's own), while a local `fn exit(...)` in
// THIS module resolves to a decl `funcRefAt` reports as owned by `c` itself.
// Only the former is trusted to diverge.
fn vIsDivergingCall(c: Checker, node: int): bool {
  if (getNode(c.tree, node).tag != Tag.Call) {
    return false
  }
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return false
  }
  let cn = getNode(c.tree, callee)
  let name = c.source[cn.span.start:cn.span.end]
  if (name != "panic" && name != "exit") {
    return false
  }
  if (shadowedByValue(c, callee, name)) {
    return false
  }
  let fr = funcRefAt(c, callee, name)
  if (name == "panic") {
    return fr.decl == 0
  }
  return fr.decl != 0 && fr.owner.moduleId != c.moduleId
}

// Does `node` (a loop body) contain a `break` targeting THIS loop — i.e. one not
// shadowed by a nested loop/switch/select? Bounded depth, mirrors the seed.
fn vContainsOwnBreak(c: Checker, node: int, depth: int): bool {
  if (node == 0 || depth >= 64) {
    return false
  }
  let t = getNode(c.tree, node).tag
  if (t == Tag.BreakStmt) {
    return true
  }
  if (t == Tag.ForC ||
    t == Tag.ForOf ||
    t == Tag.ForIn ||
    t == Tag.ForInf ||
    t == Tag.WhileStmt ||
    t == Tag.SwitchStmt ||
    t == Tag.SelectStmt) {
    return false
  }
  if (t == Tag.Block || t == Tag.StmtList) {
    for s of kidsOf(c.tree, node) {
      if (vContainsOwnBreak(c, s, depth + 1)) {
        return true
      }
    }
    return false
  }
  if (t == Tag.IfStmt) {
    let k = kidsOf(c.tree, node) // [cond, then, else]
    if (vContainsOwnBreak(c, k[1], depth + 1)) {
      return true
    }
    if (k[2] != 0) {
      return vContainsOwnBreak(c, k[2], depth + 1)
    }
    return false
  }
  // A match is not a break target (`vIsBreakable` excludes it, and `lowerMatch`
  // pushes no loop frame), so a `break` in an arm body targets THIS loop (#1531).
  if (t == Tag.MatchStmt) {
    let k = kidsOf(c.tree, node) // [subject, arm_list]
    for arm of kidsOf(c.tree, k[1]) {
      if (vContainsOwnBreak(c, kidsOf(c.tree, arm)[1], depth + 1)) {
        return true
      }
    }
    return false
  }
  return false
}

// Any statement in a block/stmt-list diverges.
fn vBlockDiverges(c: Checker, node: int, countBrk: bool): bool {
  for s of kidsOf(c.tree, node) {
    if (vDiverges(c, s, countBrk)) {
      return true
    }
  }
  return false
}

// Does executing `node` guarantee control never falls through past it? (§10.3)
fn vDiverges(c: Checker, node: int, countBrk: bool): bool {
  if (node == 0) {
    return false
  }
  let t = getNode(c.tree, node).tag
  if (t == Tag.ReturnStmt || t == Tag.FailStmt) {
    return true
  }
  if (t == Tag.BreakStmt || t == Tag.ContinueStmt) {
    return countBrk
  }
  if (t == Tag.Block) {
    return vBlockDiverges(c, node, countBrk)
  }
  if (t == Tag.ExprStmt) {
    return vIsDivergingCall(c, kidsOf(c.tree, node)[0])
  }
  if (t == Tag.IfStmt) {
    let k = kidsOf(c.tree, node) // [cond, then, else]
    if (k[2] == 0) {
      return false
    }
    return vDiverges(c, k[1], countBrk) && vDiverges(c, k[2], countBrk)
  }
  if (t == Tag.WhileStmt) {
    let k = kidsOf(c.tree, node) // [cond, body]
    if (vIsTrueLit(c, k[0])) {
      return !vContainsOwnBreak(c, k[1], 0)
    }
    return false
  }
  if (t == Tag.ForInf) {
    return !vContainsOwnBreak(c, kidsOf(c.tree, node)[0], 0)
  }
  if (t == Tag.ForC || t == Tag.ForOf || t == Tag.ForIn) {
    return false
  }
  if (t == Tag.SwitchStmt) {
    let k = kidsOf(c.tree, node) // [subject, case_list]
    let hasDefault = false
    let all = true
    for cse of kidsOf(c.tree, k[1]) {
      let ct = getNode(c.tree, cse).tag
      if (ct == Tag.SwitchCase) {
        if (!vBlockDiverges(c, kidsOf(c.tree, cse)[1], countBrk)) {
          all = false
        }
      } else if (ct == Tag.SwitchDefault) {
        hasDefault = true
        if (!vBlockDiverges(c, kidsOf(c.tree, cse)[0], countBrk)) {
          all = false
        }
      }
    }
    return hasDefault && all
  }
  if (t == Tag.MatchStmt) {
    let k = kidsOf(c.tree, node) // [subject, arm_list]
    let arms = kidsOf(c.tree, k[1])
    if (len(arms) == 0) {
      return false
    }
    for arm of arms {
      if (!vDiverges(c, kidsOf(c.tree, arm)[1], countBrk)) {
        return false
      }
    }
    return true
  }
  if (t == Tag.SelectStmt) {
    let clauses = kidsOf(c.tree, node)
    if (len(clauses) == 0) {
      return true
    } // `select {}` blocks forever
    for cl of clauses {
      let clt = getNode(c.tree, cl).tag
      let body = 0
      if (clt == Tag.CommCase) {
        body = kidsOf(c.tree, cl)[1]
      } else if (clt == Tag.CommDefault) {
        body = kidsOf(c.tree, cl)[0]
      } else {
        continue
      }
      if (!vBlockDiverges(c, body, countBrk)) {
        return false
      }
    }
    return true
  }
  return false
}

