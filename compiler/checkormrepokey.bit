// compiler/checkormrepokey.bit — `Repo<T>.find/update/delete` with a `T`
// that carries no single primary key (#6269, epic #6253,
// mission-critical reliability first): a COMPILE error naming the class,
// never a runtime panic. Retires two of `pkg/orm/repo.bit`'s own panics for
// every case THIS check can see at compile time — `singleKeyColumn`'s
// (`find`/`delete`) and `update`'s own "no single '@id' field" — both still
// exist as `fail`-returning errors now (#6269's own third part), kept as
// the runtime backstop for a `T` this check cannot see through (a type
// parameter still generic at the call site, or reached through an
// interface), never as the primary signal.
//
// WHY A CHECKER PASS, NOT A NARROWER `Tabled` BOUND. `find`/`update`/
// `delete` are declared on `Repo<T: Tabled>` itself (`pkg/orm/repo.bit`) —
// `Tabled` is what every `@table` class satisfies "for free"
// (`pkg/orm/db.bit`'s own header), and Bit has no per-method bound
// narrower than the class's own type parameter (SPEC §10.4 declares no
// such syntax). The only way to fail this at compile time is a checker
// pass over concrete call sites — the same category `checkormquery.bit`'s
// own literal-column check already is for the (now-retired) free-function
// `find<T>`, but this targets `Repo<T>`'s three METHODS by their RESOLVED
// receiver type (`vMethodCall`'s own `checkExprType`, and `ctx.typeInsts`
// for the generic instantiation) rather than a syntactic type argument at
// the call site — `people.find(id)`'s own receiver is a LOCAL VARIABLE
// (`let people = db.table<Person>()`), and `checkormquery.bit`'s syntactic
// chain-walk cannot trace back through one (that file's own header names
// exactly this limitation as what falls back to the runtime check); by the
// time `vMethodCall` runs, ordinary type inference already has.
//
// SCOPE: NAMES `Repo` AND THE METHOD, NEVER THE DECLARING MODULE. Matching
// by class name only — never confirming the generic's own module is
// `pkg/orm` — mirrors `ormPathMatches`'s (checkormquery.bit) accepted
// narrow risk: a user's own unrelated `Repo<T>` class, also generic, also
// naming a `find`/`update`/`delete` method, instantiated with a `@table`
// class that happens to carry no single key, would false-positive here.
// Resolving the generic's declaring module by import path would need
// `Checker` to carry the OWNING module's path where it only carries a
// module ID (`typeOwner`, lowerlayout.bit) — out of this ticket's scope.
//
// A COMPOSITE KEY (`@id` on more than one field, #5084) IS FLAGGED FOR
// `find`/`delete` ONLY (`find<V>(id: V)`, a single argument, cannot
// represent one). `update` (#7129) writes its `WHERE` from EVERY `@id`
// column (#6991), so it accepts a composite key and is refused only when
// the class carries no key at all. `pkg/orm/repo.bit`'s own
// `singleKeyColumn` error stays the runtime backstop only for a `T` this
// pass cannot resolve to a concrete `@table` class.

// E0180 (SPEC §10.5): `Repo<T>.find/delete` where `T` carries no single
// primary key (zero `@id`/`id` fields, or a composite key), or
// `Repo<T>.update` where `T` carries no primary key at all.
const ecOrmRepoNoSingleKey = 180

const ormRepoClassName = "Repo"

fn ormRepoMethodNames(): []string {
  return ["find", "update", "delete"]
}

// Whether `mname` (one of `ormRepoMethodNames`) refuses a key-field count
// of `count`: `update` needs at least one (it matches every `@id`),
// `find`/`delete` exactly one.
fn ormRepoRefusesKeyCount(mname: string, count: int): bool {
  if (mname == "update") {
    return count == 0
  }
  return count != 1
}

// Every field of `classDecl` carrying an `@id` field attribute, counted by
// SOURCE-TEXT name only — deliberately syntactic, the same shortcut
// `checkormquery.bit`'s own `ormClassFieldNames` already takes for field
// names rather than re-deriving `collectRecordedAttrs`'s call/record
// resolution (`classtabledesc.bit`'s own header: `@id` never resolves to a
// callable in practice).
fn ormRepoExplicitIdCount(tree: Tree, source: string, classDecl: int): int {
  let n = 0
  for m0 of kidsOf(tree, kidsOf(tree, classDecl)[2]) {
    let f = memberField(tree, m0)
    if (f == 0) {
      continue
    }
    for a of fieldAttrs(tree, f) {
      if (identText(tree, source, kidsOf(tree, a)[0]) == "id") {
        n = n + 1
      }
    }
  }
  return n
}

fn ormRepoHasFieldNamedId(tree: Tree, source: string, classDecl: int): bool {
  for m0 of kidsOf(tree, kidsOf(tree, classDecl)[2]) {
    let f = memberField(tree, m0)
    if (f == 0) {
      continue
    }
    if (identText(tree, source, kidsOf(tree, f)[0]) == "id") {
      return true
    }
  }
  return false
}

// `classDecl`'s primary-key field count, #6269's own rule: every explicit
// `@id` field when there is at least one (a composite key stays exactly
// what it was), else 1 when the class carries a field literally named
// `id` (the new default, `classtabledefaultid.bit`), else 0.
fn ormRepoKeyFieldCount(tree: Tree, source: string, classDecl: int): int {
  let explicit = ormRepoExplicitIdCount(tree, source, classDecl)
  if (explicit > 0) {
    return explicit
  }
  if (ormRepoHasFieldNamedId(tree, source, classDecl)) {
    return 1
  }
  return 0
}

fn ormRepoNoSingleKeyWhy(count: int): string {
  if (count > 1) {
    return "it carries a composite key (more than one '@id' field)"
  }
  return "no field carries '@id' and none is named 'id'"
}

fn ormRepoNoSingleKeyHelp(mname: string, count: int): string {
  if (count > 1) {
    return "Repo<T>.${mname} takes one id and cannot match a composite key; only 'update' and 'save' match every '@id' field"
  }
  return "Repo<T>.${mname} needs a primary key; add '@id' to a field, or name one 'id'"
}

fn reportOrmRepoNoSingleKey(
  c: Checker,
  nameNode: int,
  className: string,
  mname: string,
  count: int,
) {
  let what = "has no single primary key"
  if (mname == "update") {
    what = "has no primary key"
  }
  report(
    c.diags, ecOrmRepoNoSingleKey, vSpan(c, nameNode),
    "'${className}' ${what} for 'Repo<${className}>.${mname}'",
    "${ormRepoNoSingleKeyWhy(count)} — ${ormRepoNoSingleKeyHelp(mname, count)}",
  )
}

// Whether `recvType` (an already-resolved receiver type) is `Repo<T>` for
// some concrete `T`, and if so, `T`'s own TypeId — `(0, false)` for
// anything else, including `Repo` still generic over its own type
// parameter (inside `Repo`'s own body, where `typeInstOfResult` answers
// -1, the same convention every `ctx.typeInsts` reader shares).
fn ormRepoTypeArg(c: Checker, recvType: int): (int, bool) {
  let idx = typeInstOfResult(c.ctx, recvType)
  if (idx < 0) {
    return (0, false)
  }
  let inst = c.ctx.typeInsts[idx]
  if (inst.name != ormRepoClassName || len(inst.args) != 1) {
    return (0, false)
  }
  return (inst.args[0], true)
}

// `recvType.mname(...)` is one of `Repo<T>.find/update/delete`, `T`
// resolves to a `@table` class (`classHasTable`, classtabledesc.bit), and
// that class's own key-field count is one the method refuses
// (`ormRepoRefusesKeyCount`) — reports
// `ecOrmRepoNoSingleKey` at `nameNode` (the call's own method name),
// naming the class. Called from `vMethodCall` (validatemethodcall.bit) the
// same way `vForeignMethodCall` is: a read-only diagnostic alongside the
// ordinary method-call validation, never altering it.
fn checkOrmRepoSingleKey(c: Checker, nameNode: int, recvType: int, mname: string) {
  if (!ormNameIn(mname, ormRepoMethodNames())) {
    return
  }
  let (argTy, ok) = ormRepoTypeArg(c, recvType)
  if (!ok || c.ctx.types[argTy].kind != TypeKind.Struct) {
    return
  }
  let oc = typeOwner(c, argTy)
  let decl = structDeclOf(c, argTy)
  if (decl == 0 || !classHasTable(oc.tree, oc.source, decl)) {
    return
  }
  let count = ormRepoKeyFieldCount(oc.tree, oc.source, decl)
  if (ormRepoRefusesKeyCount(mname, count)) {
    reportOrmRepoNoSingleKey(c, nameNode, c.ctx.types[argTy].name, mname, count)
  }
}
