// In-Bit self-checks for `gpSizeOpc` (compiler/arm64encode.bit), split into
// its own sibling file rather than added to compiler/arm64check.bit, which
// is at exactly 800 lines with zero headroom (#5420). Module files
// concatenate in bytewise filename order (compiler/project.bit:7); this
// file's name sorts after arm64encode.bit and arm64check.bit and before
// arm64layout.bit, so it needs no special placement.

// #5420: every width `gpSizeOpc` is meant to encode must still produce the
// exact size/opc pair it produced before the width-16 guard was added — a
// table over all sixteen {1,2,4,8} x {signed,unsigned} x {load,store}
// combinations, not spot checks, since this function is the encoder's whole
// size/opc authority and a regression here is silent by nature (that is
// exactly the shape #5420 itself was: a wrong opc that assembles, runs, and
// changes nothing observable).
// `size` per width, independent of signed/isLoad (AArch64's load/store size
// field): 1=0, 2=1, 4=2, 8=3.
fn wantGpSize(width: int): int {
  if (width == 1) {
    return 0
  }
  if (width == 2) {
    return 1
  }
  if (width == 4) {
    return 2
  }
  return 3
}

fn wantGpOpc(width: int, signed: bool, isLoad: bool): int {
  if (!isLoad) {
    return 0
  }
  if (width != 8 && signed) {
    return 2
  }
  return 1
}

fn checkGpSizeOpcTable() {
  let widths = [1, 2, 4, 8]
  let bools = [false, true]
  let wi = 0
  while (wi < len(widths)) {
    let width = widths[wi]
    let si = 0
    while (si < len(bools)) {
      let signed = bools[si]
      let li = 0
      while (li < len(bools)) {
        let isLoad = bools[li]
        let so = gpSizeOpc(width, signed, isLoad)
        let label = "width ${width} signed ${signed} isLoad ${isLoad}"
        assert(so.size == wantGpSize(width), "${label}: wrong size")
        assert(so.opc == wantGpOpc(width, signed, isLoad), "${label}: wrong opc")
        li = li + 1
      }
      si = si + 1
    }
    wi = wi + 1
  }
}

// #5420: proves the width the *real* codegen dispatch seam (`compileInstMem`,
// arm64dispatch.bit — the same entry `compileInstMem` routes every
// `field_get`/`field_set` through, never gpSizeOpc called by hand) hands to
// `gpSizeOpc` is the width `emitFieldGet` actually computed from the IR
// type, not merely that gpSizeOpc itself is correct in isolation. A `decimal`
// field (16 bytes) cannot be driven THROUGH this seam without gpSizeOpc's own
// guard firing — panic() is unconditionally fatal, has no `recover`
// (SPEC.md S18.4), and would crash the process running this check — so this
// exercises the seam at width 8 (an ordinary i64 field) and cross-checks the
// emitted size/opc bits against `gpSizeOpc` called directly. That the two
// agree on a width the dispatcher itself supplies is what makes "no live
// caller reaches gpSizeOpc with an unencodable width, and if one ever does,
// the same seam carries it straight into the new guard" a claim about this
// wiring rather than an assumption.
fn checkGpSizeOpcReachedThroughDispatch() {
  let cx = selCtx()
  let ctx = cx.module.ctx
  let i64ty = primType(ctx, 3)
  let fg = mkInstr(Op.FieldGet, i64ty)
  fg.lhs = 0
  fg.ival = 16
  assert(compileInstMem(cx, 5, fg))
  let want = gpSizeOpc(8, true, true)
  // `loadStoreUnsignedImm`/`loadStoreRegOffset` both pack size at bits 30:31
  // and opc at bits 22:23 of the first emitted word (arm64encode.bit).
  let got = wordAt(cx.code, 0)
  assert(((got >> 30) & 3) == want.size, "dispatch seam disagreed with gpSizeOpc on size")
  assert(((got >> 22) & 3) == want.opc, "dispatch seam disagreed with gpSizeOpc on opc")
}

// #5425: `checkGpSizeOpcTable` above proves gpSizeOpc's answer for every
// ENCODABLE width; this proves `checkGpEncodableWidth`'s panic (#5420,
// arm64encode.bit) actually FIRES for one that is not — in a CHILD process,
// since `panic()` is unconditionally fatal and calling this in-process here
// would crash the whole `bit selfcheck` run instead of failing one check
// (compiler/selfcheck.bit's `runSelfcheckOnlyPanics` header has the why).
//
// Mutation witness: delete the panic (or its guarding `if`) from
// `checkGpEncodableWidth` and THIS is the only check in the whole battery
// that goes red — `checkGpSizeOpcTable` only ever iterates {1, 2, 4, 8} and
// stays silent on width 16 by construction.
fn checkGpEncodableWidthPanicsOnWidth16() {
  gpSizeOpc(16, true, true)
}

fn checkGpEncodableWidthPanics() {
  let (code, out) = runSelfcheckOnlyPanics("checkGpEncodableWidthPanicsOnWidth16")
  assert(code == 2, "gpSizeOpc(16, ...) must panic (exit 2); isolated child exited ${code}: ${out}")
  assert(
    indexOf(out, "panic: gpSizeOpc: width 16 has no ARM64 GP load/store encoding") >= 0,
    "expected checkGpEncodableWidth's own panic text in the captured child output, got: ${out}",
  )
}
