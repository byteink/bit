// Self-host Stage 2 (#1336): symbol resolution.
// This file is the substrate — symbol kinds, the Symbol record, the per-module
// symbol table, and the predeclared universe (spec §5.3). The resolver proper
// (scopes, name binding, imports, method sets) builds on this from the sibling
// files `resolve.bit` and `resolvebody.bit` (#1503), which are the same module.
// It is verified indirectly: the ported checker's `--dump-types` and the
// name/import `// error` diagnostics must match the seed. Structs are reference
// types in Bit, so the module table mutates in place.

// The nature of a bound name. C-like enum: the order matches the seed so the
// integer values agree if ever dumped.
enum SymbolKind {
  LetBinding,
  ConstBinding,
  Param,
  Receiver,
  GenericParam,
  Func,
  TypeAlias,
  StructType,
  InterfaceType,
  EnumType,
  ImportNamespace,
  ImportItem,
  BuiltinType,
  BuiltinFunc,
  // Bound in place of a failed import so downstream references don't cascade
  // into a second, misleading `undefined_name`.
  Poison,
}

// A resolved name. `decl` is the declaring AST node (0 = none, for universe /
// poison symbols); `fileIdx` selects which file's tree `decl` lives in. The
// import fields use -1 as "none" (Bit structs have no optionals): `imported*`
// is set for ImportItem (the concrete symbol it aliases), `namespaceModule`
// for ImportNamespace (the module it namespaces).
struct Symbol {
  name: string,
  kind: SymbolKind,
  decl: int,
  fileIdx: int,
  exported: bool,
  // True for symbols declared in the module scope itself, as opposed to any
  // nested block/function scope. Only `rInsertModuleSymbol` sets it. The
  // distinction matters for LetBinding, which is the kind of BOTH a
  // module-level `let` (§11.11, a static cell) and every local `let` (an SSA
  // value) — nothing else in the symbol table separates the two.
  moduleScoped: bool,
  importedFromModule: int,
  importedFromSymbol: int,
  namespaceModule: int,
}

// Result of resolving one module: every symbol it declares or imports, the
// name -> symbol-id table (id indexes `symbols`), the exported subset, and the
// per-node symbol table (`nodeSymbols[node]` = symbol id, 0 = none) parallel to
// the module tree's nodes — the checker consumes it to type an identifier
// reference from the symbol it actually resolves to, not a flat module-wide env.
struct Module {
  symbols: []Symbol,
  allNames: map<string, int>,
  exports: map<string, int>,
  nodeSymbols: []int,
}

fn newModule(): Module {
  return Module{ symbols: []Symbol(0), allNames: map<string, int>{}, exports: map<string, int>{},
    nodeSymbols: []int(0) }
}

// Appends a symbol and returns its id (index into `symbols`). Persists to the
// caller because a struct is a reference.
fn addSymbol(m: Module, s: Symbol): int {
  let id = len(m.symbols)
  m.symbols = append(m.symbols, s)
  return id
}

// Binds `name -> id` in the module's name table (last write wins, as the
// resolver's duplicate check runs separately).
fn bindName(m: Module, name: string, id: int) {
  m.allNames[name] = id
}

// Looks up a top-level name; returns the symbol id or -1 if absent.
fn lookupName(m: Module, name: string): int {
  let (id, ok) = m.allNames[name]
  if (ok) {
    return id
  }
  return -1
}

// The predeclared type names (spec §5.3) — the universe's builtin types.
fn predeclaredTypes(): []string {
  return ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64",
    "int", "uint", "byte", "rune", "bool", "string", "error"]
}

// The predeclared builtin function names (spec §5.3 + the ABI boundary
// primitives). Order is irrelevant here — resolution is by name.
fn predeclaredFuncs(): []string {
  return ["len", "cap", "append", "delete", "close", "panic", "assert", "print", "eprint",
    "fsOpen", "fsReadAll", "fsWrite", "fsClose", "fsAppend", "fsRead", "fsExists", "fsIsDir",
    "fsMkdir", "fsRemove", "fsRename", "fsListDir",
    "netListen", "netLocalPort", "netAccept", "netDial", "netRead",
    "netWrite", "netUdpBind", "netUdpSend", "netUdpRecv", "netUdpSenderHost", "netUdpSenderPort", "netResolve",
    "fsqrt", "ffloor", "fceil", "fround", "ftrunc", "fpow", "fatan2", "flog", "flog2", "flog10",
    "timeMonoNs", "timeUnixNs", "timeSleepNs",
    "osArgc", "osArgAt", "osEnv", "osSelfExe", "osExit", "osRun", "osRunTest", "hostTarget",
    "auxv", "osRunBounded", "osRunTestBounded",
    "cryptoRandomBytes", "cryptoSecureZero",
    "fsChmod",
    "parseFloat",
    // Float bit patterns, for this compiler's own const_float codegen.
    "floatBits", "float32Bits",
    // The inverse, `bitsToFloat(v: u64) -> f64`, for the transcendental ports.
    "bitsToFloat",
    // Atomics (§11.5) + the `ptrOf` bridge from a slice to a raw `*T`.
    "atomicLoad", "atomicStore", "atomicCmpxchg", "atomicAdd", "atomicSub",
    "atomicAnd", "atomicOr", "atomicXchg", "ptrOf",
    // `entryOf(f): *byte` (§11.10) — the code entry address of a named function,
    // `ptrOf`'s sibling: that one bridges traced memory to a raw pointer, this
    // one bridges a function declaration to one.
    "entryOf",
    // `stackMapsBegin()`/`stackMapsEnd(): *byte` (§11.12) — the half-open extent
    // of the compiler-emitted stack-map table (ABI.md §4). The only spelling for
    // a data symbol the LINKER defines and no object may claim.
    "stackMapsBegin", "stackMapsEnd",
    // Raw OS syscall (§11.8) — Linux only, variable arity (nr + up to 6 args).
    "syscall"]
}

// SPEC §5.3's own "Builtin functions" line, verbatim: `len cap append delete
// close panic assert` (§16), plus `parseFloat` (documented separately, just
// below that line). A strict subset of `predeclaredFuncs()` above, which also
// reserves the wider ABI-boundary primitives (`netLocalPort`, `fsOpen`, ...)
// that spec/SPEC.md never names. `rModuleShadowExempt` (resolve.bit) reads
// THIS list, not `predeclaredFuncs()`, when deciding whether an exported
// module-scope declaration reusing a predeclared name is a deliberate public
// API choice (spec/LINT.md's E0048 entry) — the wider ABI-boundary set stays
// an ordinary finding, since #3353 renamed two real accidental collisions
// with it (`netResolve`, `netLocalPort` in `runtime/net/**`) rather than
// accepting them.
fn specDocumentedFuncs(): []string {
  return ["len", "cap", "append", "delete", "close", "panic", "assert", "parseFloat"]
}

// A universe symbol with no declaration site.
fn builtinSymbol(name: string, kind: SymbolKind): Symbol {
  return Symbol{ name: name, kind: kind, decl: 0, fileIdx: 0, exported: false,
    importedFromModule: -1, importedFromSymbol: -1, namespaceModule: -1 }
}

// Builds the universe scope: every predeclared type and function as a builtin
// symbol, bound by name. This is the root every module's top scope chains to.
fn universeModule(): Module {
  let m = newModule()
  let types = predeclaredTypes()
  let i = 0
  while (i < len(types)) {
    bindName(m, types[i], addSymbol(m, builtinSymbol(types[i], SymbolKind.BuiltinType)))
    i = i + 1
  }
  let funcs = predeclaredFuncs()
  let j = 0
  while (j < len(funcs)) {
    bindName(m, funcs[j], addSymbol(m, builtinSymbol(funcs[j], SymbolKind.BuiltinFunc)))
    j = j + 1
  }
  return m
}

