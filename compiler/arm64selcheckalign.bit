// #7830's selfcheck arm: an arm64 loop header starts on a 16-byte boundary
// (a64BlockStart, arm64layout.bit). Same module as selfcheck.bit (#1503).

// `mov xzr, xzr`: filler that is not the NOP a pad is made of.
fn a64FillerWord(): int { return 0xAA1F03FF }

// A header moves to the next boundary by NOPs, whatever the residue; one
// already on it, and any other block, stays where the code ends.
fn checkArm64LoopHeaderAlign() {
  for n of [0, 1, 2, 3, 4, 5] {
    for head of [true, false] {
      let b = newByteBuf()
      let k = 0
      while (k < n) {
        emitWord(b, a64FillerWord())
        k = k + 1
      }
      let want = n * 4
      if (head && want % 16 != 0) {
        want = want + 16 - want % 16
      }
      let at = a64BlockStart(b, head)
      assert(at == want && len(b.bytes) == want, "#7830: a loop header must start 16-aligned")
      while (k * 4 < want) {
        assert(wordAt(b, k * 4) == a64NopWord(), "#7830: a header pad is NOPs")
        k = k + 1
      }
    }
  }
  checkArm64CompiledLoopAligned()
}

// bb0(%0): asm <`fill` filler words>; jump bb1
// bb1:     br %0, bb1, bb2      <- the back edge
// bb2:     ret
//
// Compiled whole for fill = 1..4, so the header's unpadded offset takes all
// four residues mod 16 and three of them need a pad: what is checked is the
// emitted branch words, not the emitter's own record of where the header is.
fn checkArm64CompiledLoopAligned() {
  let fill = 1
  while (fill <= 4) {
    let ctx = newTypeContext()
    let i64t = primType(ctx, 3)
    let words = []int(0)
    while (len(words) < fill) {
      words = append(words, a64FillerWord())
    }
    let jmp = mkInstr(Op.Jump, ctx.voidId)
    jmp.ival = 1
    let br = mkInstr(Op.Br, ctx.voidId)
    br.lhs = 0
    br.ival = 1
    br.ival2 = 2
    let f = irFuncOf(
      "loop", [i64t], ctx.voidId,
      [
        IrBlock{ instsStart = 0, paramCount = 1, instsLen = 3 },
        IrBlock{ instsStart = 3, paramCount = 0, instsLen = 1 },
        IrBlock{ instsStart = 4, paramCount = 0, instsLen = 1 },
      ],
      [
        mkInstr(Op.BlockParam, i64t), mkInstr(Op.Asm, ctx.voidId), jmp, br,
        mkInstr(Op.Ret, ctx.voidId),
      ],
    )
    let blk = AsmBlock{
      x64Bytes = [0x90], arm64Words = words, hasResult = false,
      resultX64 = 0, resultArm64 = 0, inX64 = []int(0), inArm64 = []int(0),
      clobX64 = []int(0), clobArm64 = []int(0),
    }
    let m = IrModule{
      funcs = [f], ctx = ctx, asmBlocks = [blk], stringPool = []string(0),
      sm = newSourceManager(),
    }
    let fc = a64FixtureCompile(m, f)
    let targets = a64BackBranchTargets(fc.code)
    assert(len(targets) > 0, "#7830: the fixture has a back edge")
    for t of targets {
      assert(t % a64CodeAlign() == 0, "#7830: a back edge must land on a 16-aligned header")
    }
    fill = fill + 1
  }
}

// The code offsets the backward branches in `code` name: `b`, `b.cond`,
// `cbz`/`cbnz` and `tbz`/`tbnz`, the forms the backend writes.
fn a64BackBranchTargets(code: []u8): []int {
  let buf = ByteBuf{ bytes = code }
  let out = []int(0)
  let at = 0
  while (at < len(code)) {
    let d = a64BranchDisp(wordAt(buf, at))
    if (d < 0) {
      out = append(out, at + d)
    }
    at = at + 4
  }
  return out
}

// A branch word's signed byte displacement; 0 for any other word, and for a
// `bl` the linker has yet to patch.
fn a64BranchDisp(w: int): int {
  if ((w & 0x7C000000) == 0x14000000) {
    return signExtend(w & 0x03FFFFFF, 26) * 4
  }
  if ((w & 0xFF000010) == 0x54000000 || (w & 0x7E000000) == 0x34000000) {
    return signExtend((w >> 5) & 0x7FFFF, 19) * 4
  }
  if ((w & 0x7E000000) == 0x36000000) {
    return signExtend((w >> 5) & 0x3FFF, 14) * 4
  }
  return 0
}
