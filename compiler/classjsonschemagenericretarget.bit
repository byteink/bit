// compiler/classjsonschemagenericretarget.bit — the second half of #6201's
// generic path for `jsonSchema<T>()`: the one refusal that keeps `bit check`
// and `bit build` agreeing, and the ledger retarget itself. Mirrors
// `classjsondecodegenericretarget.bit`, simplified for `jsonSchema`'s single
// entry point — no strict/lenient split, since #6202's own
// `classjsonschemageneric.bit` synthesizes exactly one wrapper per class.
//
// A PURE MOVE, following the same reasoning `classjsondecodegenericretarget.bit`
// states for its own split: `classjsonschemagenericretarget.bit` sorts
// immediately after `classjsonschemageneric.bit` and before
// `classjsonschemaimports.bit` (compiler/project.bit concatenates a module's
// files in bytewise filename order), so no declaration in the module moves and
// no import changes.
// ---- the refusal, and the retarget -----------------------------------------

// The one authoritative check that a describing generic's instantiation can
// be resolved. Runs after every module is checked, so the ledger already
// holds every instantiation the CHECK pass recorded. Mirrors
// `validateJsonDecodeGenerics`.
//
// This is what makes `bit check` and `bit build` agree. The retarget below
// runs during lowering, which `bit check` never reaches.
fn validateJsonSchemaGenerics(p: Project, mods: []Checker) {
  if (len(mods) == 0) {
    return
  }
  let gens = collectJsonSchemaGenerics(p)
  if (len(gens) == 0) {
    return
  }
  let ctx = mods[0].ctx
  let i = 0
  while (i < len(ctx.instantiations)) {
    let inst = ctx.instantiations[i]
    for g of gens {
      if (g.mod == inst.module && g.decl == inst.decl && g.tpIndex < len(inst.args)) {
        validateJsonSchemaArg(p, mods, inst, inst.args[g.tpIndex])
      }
    }
    i = i + 1
  }
}

fn validateJsonSchemaArg(p: Project, mods: []Checker, inst: Instantiation, arg: int) {
  // Every Checker shares one `ctx` and one `diags` after `resolveProject`
  // handed them out, so mods[0]'s are the project's. Mirrors
  // `validateJsonDecodeArg`.
  let d = mods[0].diags
  let ctx = mods[0].ctx
  if (arg == ctx.voidId) {
    // `T` here is in the RESULT alone, so nothing ever infers it from the
    // arguments. The general E0068 rule owns every call it can see (SPEC
    // §15.3); this pass hands it the JSON reason and says nothing more where
    // it already fired, same as the decode path's own `jdgUnbound` cause.
    if (adoptCannotInferHint(d, inst.site, jsgUnboundHint)) {
      return
    }
    reportJsonSchemaGenericArg(d, inst.site, "", jsgUnbound)
    return
  }
  let t = ctx.types[arg]
  if (t.kind != TypeKind.Struct || !t.hasName || t.declModule < 0 || t.declModule >= len(mods)) {
    reportJsonSchemaGenericArg(d, inst.site, typeName(ctx, arg), jsgNotJson)
    return
  }
  let (_, ok) = mods[t.declModule].funcDecls[jsonSchemaInstName(t.name)]
  if (ok) {
    return
  }
  let cause = jsgNotJson
  if (jsonClassMarkOf(p, t.declModule, t.name) == jmJsonClass) {
    cause = jsgUnseen
  }
  reportJsonSchemaGenericArg(d, inst.site, t.name, cause)
}

// Why one instantiation of a describing generic cannot be specialised. Three
// distinct causes, kept distinct — mirrors `jdgNotJson`/`jdgUnbound`/`jdgUnseen`.
const jsgNotJson = 0
const jsgUnbound = 1
const jsgUnseen = 2

// The unbound-`T` reason, worded once: E0173 renders it below, and E0068
// borrows it when the general rule got to the call first. Mirrors
// `jdgUnboundHint`.
const jsgUnboundHint = "write the type argument out — 'jsonSchema<T>' puts 'T' in the RESULT alone, so nothing infers it from the arguments and neither can a generic wrapping it"

// E0173 for the generic path, at the CALL that instantiated the generic — the
// line the reader can act on, since the `jsonSchema<T>` inside the wrapper
// may sit in a module they do not own. Mirrors `reportJsonDecodeGenericArg`.
fn reportJsonSchemaGenericArg(d: Diagnostics, site: Span, tname: string, cause: int) {
  let msg = "'jsonSchema' cannot describe '${tname}': it does not carry '@json'"
  let help = "mark '${tname}' with '@json' — a generic that calls 'jsonSchema<T>()' describes only a class that opted in, exactly as a direct call does"
  if (cause == jsgUnbound) {
    msg = "'jsonSchema' cannot describe an unbound type parameter: this call binds it to nothing"
    help = jsgUnboundHint
  }
  if (cause == jsgUnseen) {
    msg = "'jsonSchema' cannot describe '${tname}': no schema specialisation was synthesized for it"
    help = "write the type argument out at the call site — a describing generic is specialised from the type argument AS SPELLED, before any type is inferred (#6201)"
  }
  report(d, ecJsonSchemaType, site, msg, help)
}

// Points every `jsonSchema<C>` ledger entry at the specialisation synthesized
// in `C`'s own module, so Pass A2 emits the document under the instance
// symbol the wrapper's call already names. Mirrors `retargetJsonDecodeInstances`,
// reusing `jsonStdModuleId` (classjsondecodegenericretarget.bit) directly —
// it resolves `std/json` by an importer's own path map and is not
// jsonDecode-specific.
//
// Runs after Pass A1's closure, which is what CREATES these entries: the
// check pass only ever sees `jsonSchema<T>()` inside the wrapper's template
// body, which `recordInstantiation` refuses as degenerate (#4499). It is
// `recordSubtreeInstantiations`, re-walking each instance body under that
// instance's bindings, that records the concrete one.
fn retargetJsonSchemaInstances(mods: []Checker, root: int, lo: Lowerer) {
  let jm = jsonStdModuleId(mods)
  if (jm < 0) {
    return
  }
  let ctx = mods[root].ctx
  let g = 0
  while (g < len(ctx.instantiations)) {
    let inst = ctx.instantiations[g]
    if (inst.module == jm && inst.name == jsonSchemaFuncNameConst) {
      retargetOneJsonSchemaInstance(mods, inst, lo)
    }
    g = g + 1
  }
}

fn retargetOneJsonSchemaInstance(mods: []Checker, inst: Instantiation, lo: Lowerer) {
  let ctx = mods[0].ctx
  let arg = 0
  if (len(inst.args) == 1) {
    arg = inst.args[0]
  }
  let t = ctx.types[arg]
  let cmod = -1
  if (arg != 0 && t.kind == TypeKind.Struct && t.hasName) {
    cmod = t.declModule
  }
  let decl = 0
  if (cmod >= 0 && cmod < len(mods)) {
    let (dn, ok) = mods[cmod].funcDecls[jsonSchemaInstName(t.name)]
    if (ok) {
      decl = dn
    }
  }
  if (decl == 0) {
    // Unreachable through `bit build`, which checks first — but a stub that
    // computes nothing is exactly what `jsonSchema`'s own template body is,
    // so falling through would ship a program that FAILS AT RUN TIME.
    // Refuse. Mirrors `retargetOneJsonDecodeInstance`'s own refusal.
    lo.stubbed = append(
      lo.stubbed,
      StubbedFn{
        name = inst.name, span = inst.site,
        reason = "a 'jsonSchema<T>()' inside a generic body whose type argument has no synthesized description",
        note = "", noteSite = pointSpan(0, 0),
      },
    )
    return
  }
  // `module` is NOT touched: it is half of the (module, name, args) key every
  // call site looks this entry up by, and half of the symbol `instanceSymbol`
  // builds. Only where the BODY comes from moves.
  inst.declModule = cmod
  inst.decl = decl
}
