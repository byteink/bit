// In-Bit self-checks for the x86-64 encoder: registers, moves, memory, ALU,
// setcc. Split out of selfcheck.bit (#1503); sibling .bit files are the same
// module, so `selfcheck()` still calls these directly.

fn checkX64Regs() {
  // The enum ordinal IS the encoding's register number. If this drifts, every
  // ModRM byte below addresses a different register — silently.
  assert(xRegNum(XReg64.Rax) == 0 && xRegNum(XReg64.Rcx) == 1)
  assert(xRegNum(XReg64.Rsp) == 4 && xRegNum(XReg64.Rbp) == 5)
  assert(xRegNum(XReg64.R8) == 8 && xRegNum(XReg64.R15) == 15)
  assert(xmmNum(XmmReg.Xmm0) == 0 && xmmNum(XmmReg.Xmm15) == 15)

  // Scratch must never be allocatable, or a selector's temp would clobber a
  // live value the allocator handed out.
  for r of xMasterGprs() {
    assert(r != xScratch1() && r != xScratch2() && r != xScratch3())
    // rsp/rbp are the frame, never allocatable either.
    assert(r != XReg64.Rsp && r != XReg64.Rbp)
  }
  assert(xMaxIntRegs() == 11)
  assert(xMaxFloatRegs() == 14) // xmm14/xmm15 reserved as float scratch
  assert(xmmNum(xFScratch1()) >= xMaxFloatRegs() && xmmNum(xFScratch2()) >= xMaxFloatRegs())

  // Scratch must also not be an argument register in EITHER convention, or
  // marshalling would overwrite an argument already placed.
  for cc of [XCallConv.SysV, XCallConv.Win64] {
    for a of xIntArgRegs(cc) {
      assert(a != xScratch1() && a != xScratch2() && a != xScratch3())
    }
  }

  // The two conventions differ in COUNT and in REGISTERS — Win64's list is not
  // a prefix of SysV's, so a port that passes one through the other silently
  // reads arguments from the wrong places.
  assert(len(xIntArgRegs(XCallConv.SysV)) == 6)
  assert(len(xIntArgRegs(XCallConv.Win64)) == 4)
  assert(xIntArgRegs(XCallConv.SysV)[0] == XReg64.Rdi)
  assert(xIntArgRegs(XCallConv.Win64)[0] == XReg64.Rcx)

  // Callee-saved sets differ: rsi/rdi are SysV argument registers (caller-saved)
  // but Win64 preserves them.
  assert(xIsCalleeSavedInt(XCallConv.SysV, XReg64.Rbx))
  assert(!xIsCalleeSavedInt(XCallConv.SysV, XReg64.Rsi))
  assert(xIsCalleeSavedInt(XCallConv.Win64, XReg64.Rsi))
  assert(xIsCalleeSavedInt(XCallConv.Win64, XReg64.Rdi))
  assert(!xIsCalleeSavedInt(XCallConv.SysV, XReg64.Rax))
  // SysV preserves no XMM at all; Win64 preserves xmm6..xmm15.
  assert(!xIsCalleeSavedFloat(XCallConv.SysV, XmmReg.Xmm15))
  assert(xIsCalleeSavedFloat(XCallConv.Win64, XmmReg.Xmm6))
  assert(!xIsCalleeSavedFloat(XCallConv.Win64, XmmReg.Xmm5))
}

fn checkX64Encoder() {
  // REX: 0x40 base, W=8 R=4 X=2 B=1.
  assert(xRex(false, false, false, false) == 0x40)
  assert(xRex(true, false, false, false) == 0x48)
  assert(xRex(true, true, true, true) == 0x4F)
  assert(xRex(false, false, false, true) == 0x41)

  // ModRM: mod=11 for register-direct; only the low 3 bits of each register
  // land in the byte (bit 3 rides in REX).
  assert(xModrmReg(0, 0) == 0xC0)
  assert(xModrmReg(0, 1) == 0xC1)
  // r11 (11) and rbx (3) share the low 3 bits — they differ ONLY by REX.B.
  assert(xModrmReg(0, 11) == xModrmReg(0, 3))
  assert(xModrmMem(0, 0, 0) == 0x00 && xModrmMem(1, 0, 0) == 0x40)
  assert(xModrmMem(2, 7, 6) == 0xBE)

  // SIB scale is encoded log2, so an unencodable width must not silently pass.
  assert(xScaleBits(1) == 0 && xScaleBits(2) == 1 && xScaleBits(4) == 2 && xScaleBits(8) == 3)
  assert(xSib(8, 1, 2) == 0xCA) // scale=3<<6 | index=1<<3 | base=2

  // Byte order: little-endian, low byte first.
  let b = newX64Buf()
  xEmitU32(b, 0x12345678)
  assert(xHex(b) == "78563412")
  let b2 = newX64Buf()
  xEmitU64(b2, 0x123456789ABCDEF0)
  assert(xHex(b2) == "f0debc9a78563412")

  // A REX prefix is emitted only when some bit is set...
  let b3 = newX64Buf()
  xMaybeRex(b3, false, false, false, false)
  assert(len(b3.code) == 0)
  // ...but xRexForce always emits, which is what makes spl/bpl/sil/dil
  // reachable at all (without any REX those encodings mean ah/ch/dh/bh).
  let b4 = newX64Buf()
  xRexForce(b4, false, false, false, false)
  assert(len(b4.code) == 1 && b4.code[0] == u8(0x40))
}

fn checkX64Movs() {
  // Every golden below is the system assembler's own output.

  // mov %rax, %rcx -> 48 89 c1
  let b = newX64Buf()
  xMovRR(b, XReg64.Rcx, XReg64.Rax)
  assert(xHex(b) == "4889c1")

  // mov %r11, %rax -> 4c 89 d8  (REX.R for the source in the reg field)
  let b2 = newX64Buf()
  xMovRR(b2, XReg64.Rax, XReg64.R11)
  assert(xHex(b2) == "4c89d8")

  // mov %rax, %r11 -> 49 89 c3  (REX.B for the destination in the rm field)
  let b3 = newX64Buf()
  xMovRR(b3, XReg64.R11, XReg64.Rax)
  assert(xHex(b3) == "4989c3")

  // mov %r15, %r14 -> 4d 89 fe  (both extended: REX.R and REX.B)
  let b4 = newX64Buf()
  xMovRR(b4, XReg64.R14, XReg64.R15)
  assert(xHex(b4) == "4d89fe")

  // A self-move encodes nothing at all.
  let b5 = newX64Buf()
  xMovRR(b5, XReg64.Rax, XReg64.Rax)
  assert(len(b5.code) == 0)

  // movq $5, %rax -> 48 c7 c0 05 00 00 00 (the short imm32 form)
  let b6 = newX64Buf()
  xMovRI(b6, XReg64.Rax, 5)
  assert(xHex(b6) == "48c7c005000000")

  // movq $5, %r15 -> 49 c7 c7 05 00 00 00
  let b7 = newX64Buf()
  xMovRI(b7, XReg64.R15, 5)
  assert(xHex(b7) == "49c7c705000000")

  // movabs $0x123456789, %rax -> 48 b8 + 8 bytes. The value does NOT fit in a
  // sign-extended imm32, so the short form would load a different number.
  let b8 = newX64Buf()
  xMovRI(b8, XReg64.Rax, 0x123456789)
  assert(xHex(b8) == "48b88967452301000000")

  // movabs $0x123456789, %r13 -> 49 bd + 8 bytes
  let b9 = newX64Buf()
  xMovRI(b9, XReg64.R13, 0x123456789)
  assert(xHex(b9) == "49bd8967452301000000")

  // The imm32/movabs boundary, both sides. -2^31 and 2^31-1 still fit; one past
  // either end must switch to the 10-byte form.
  let bA = newX64Buf()
  xMovRI(bA, XReg64.Rax, 2147483647)
  assert(len(bA.code) == 7)
  let bB = newX64Buf()
  xMovRI(bB, XReg64.Rax, -2147483648)
  assert(len(bB.code) == 7)
  let bC = newX64Buf()
  xMovRI(bC, XReg64.Rax, 2147483648)
  assert(len(bC.code) == 10)
  let bD = newX64Buf()
  xMovRI(bD, XReg64.Rax, -2147483649)
  assert(len(bD.code) == 10)

  // A negative imm32 sign-extends: movq $-1, %rax is 48 c7 c0 ff ff ff ff.
  let bE = newX64Buf()
  xMovRI(bE, XReg64.Rax, -1)
  assert(xHex(bE) == "48c7c0ffffffff")
}

fn checkX64Mem() {
  // Goldens from `clang --target=x86_64` with the `{disp32}` prefix, which
  // forces the always-disp32 form this encoder emits (the assembler would
  // otherwise pick disp8 and the bytes would not line up).

  // {disp32} mov 16(%rax), %rcx -> 48 8b 88 10 00 00 00
  let b = newX64Buf()
  xMovLoad(b, XReg64.Rcx, xMemB(XReg64.Rax, 16), 8, false)
  assert(xHex(b) == "488b8810000000")

  // rsp as a base FORCES a SIB byte: rm=100 is the SIB escape, not a register.
  // {disp32} mov 16(%rsp), %rcx -> 48 8b 8c 24 10 00 00 00
  let b2 = newX64Buf()
  xMovLoad(b2, XReg64.Rcx, xMemB(XReg64.Rsp, 16), 8, false)
  assert(xHex(b2) == "488b8c2410000000")

  // r12 needs the SIB byte just as much — its low 3 bits are also 100. Missing
  // this is the classic form of the bug, and it addresses through rsp instead.
  // {disp32} mov 16(%r12), %rcx -> 49 8b 8c 24 10 00 00 00
  let b3 = newX64Buf()
  xMovLoad(b3, XReg64.Rcx, xMemB(XReg64.R12, 16), 8, false)
  assert(xHex(b3) == "498b8c2410000000")
  assert(xNeedsSib(xMemB(XReg64.R12, 0)) && xNeedsSib(xMemB(XReg64.Rsp, 0)))
  assert(!xNeedsSib(xMemB(XReg64.Rbp, 0)) && !xNeedsSib(xMemB(XReg64.R13, 0)))

  // rbp/r13 need NO SIB in the disp32 form (their special case is mod=00 only).
  // {disp32} mov 16(%rbp), %rcx -> 48 8b 8d 10 00 00 00
  let b4 = newX64Buf()
  xMovLoad(b4, XReg64.Rcx, xMemB(XReg64.Rbp, 16), 8, false)
  assert(xHex(b4) == "488b8d10000000")
  // {disp32} mov 16(%r13), %rcx -> 49 8b 8d 10 00 00 00 (REX.B for r13)
  let b5 = newX64Buf()
  xMovLoad(b5, XReg64.Rcx, xMemB(XReg64.R13, 16), 8, false)
  assert(xHex(b5) == "498b8d10000000")

  // Indexed: {disp32} mov 16(%rax,%rbx,8), %rcx -> 48 8b 8c d8 10 00 00 00
  let b6 = newX64Buf()
  xMovLoad(b6, XReg64.Rcx, xMemBI(XReg64.Rax, XReg64.Rbx, 8, 16), 8, false)
  assert(xHex(b6) == "488b8cd810000000")

  // All three REX bits at once — reg, index and base each extended:
  // {disp32} mov 16(%r15,%r14,4), %r13 -> 4f 8b ac b7 10 00 00 00
  let b7 = newX64Buf()
  xMovLoad(b7, XReg64.R13, xMemBI(XReg64.R15, XReg64.R14, 4, 16), 8, false)
  assert(xHex(b7) == "4f8bacb710000000")

  // disp=0 still emits a full disp32 — that is the whole point of the scheme.
  // {disp32} mov 0(%rax), %rcx -> 48 8b 88 00 00 00 00
  let b8 = newX64Buf()
  xMovLoad(b8, XReg64.Rcx, xMemB(XReg64.Rax, 0), 8, false)
  assert(xHex(b8) == "488b8800000000")

  // A negative displacement is a two's-complement disp32.
  let b9 = newX64Buf()
  xMovLoad(b9, XReg64.Rcx, xMemB(XReg64.Rax, -8), 8, false)
  assert(xHex(b9) == "488b88f8ffffff")

  // {disp32} lea 16(%rax), %rcx -> 48 8d 88 10 00 00 00
  let bA = newX64Buf()
  xLea(bA, XReg64.Rcx, XReg64.Rax, 16)
  assert(xHex(bA) == "488d8810000000")
}

fn checkX64LoadWidths() {
  // Each narrow load must leave the register WIDTH-CANONICAL, so the opcode and
  // the REX.W bit both matter. Goldens are the assembler's, disp32-forced.

  // 32-bit unsigned: a plain 32-bit mov zero-extends to 64 for free — NO REX.W.
  // Emitting REX.W here would load 64 bits and read 4 bytes of the neighbour.
  // {disp32} movl 16(%rax), %ecx -> 8b 88 10 00 00 00
  let b = newX64Buf()
  xMovLoad(b, XReg64.Rcx, xMemB(XReg64.Rax, 16), 4, false)
  assert(xHex(b) == "8b8810000000")

  // 32-bit signed: movsxd, and REX.W is what makes it 32->64.
  // {disp32} movslq 16(%rax), %rcx -> 48 63 88 10 00 00 00
  let b2 = newX64Buf()
  xMovLoad(b2, XReg64.Rcx, xMemB(XReg64.Rax, 16), 4, true)
  assert(xHex(b2) == "48638810000000")

  // 16-bit: movzx/movsx via the 0F escape, with REX.W for a 64-bit destination.
  // {disp32} movzwq 16(%rax), %rcx -> 48 0f b7 88 10 00 00 00
  let b3 = newX64Buf()
  xMovLoad(b3, XReg64.Rcx, xMemB(XReg64.Rax, 16), 2, false)
  assert(xHex(b3) == "480fb78810000000")
  // {disp32} movswq 16(%rax), %rcx -> 48 0f bf 88 10 00 00 00
  let b4 = newX64Buf()
  xMovLoad(b4, XReg64.Rcx, xMemB(XReg64.Rax, 16), 2, true)
  assert(xHex(b4) == "480fbf8810000000")

  // 8-bit. {disp32} movzbq 16(%rax), %rcx -> 48 0f b6 88 10 00 00 00
  let b5 = newX64Buf()
  xMovLoad(b5, XReg64.Rcx, xMemB(XReg64.Rax, 16), 1, false)
  assert(xHex(b5) == "480fb68810000000")
  // {disp32} movsbq 16(%rax), %rcx -> 48 0f be 88 10 00 00 00
  let b6 = newX64Buf()
  xMovLoad(b6, XReg64.Rcx, xMemB(XReg64.Rax, 16), 1, true)
  assert(xHex(b6) == "480fbe8810000000")

  // Signed and unsigned must NEVER encode the same: that is the difference
  // between -1 and 255, and it is silent.
  let s = newX64Buf()
  let u = newX64Buf()
  xMovLoad(s, XReg64.Rcx, xMemB(XReg64.Rax, 0), 1, true)
  xMovLoad(u, XReg64.Rcx, xMemB(XReg64.Rax, 0), 1, false)
  assert(xHex(s) != xHex(u))
}

fn checkX64Stores() {
  // {disp32} mov %rcx, 16(%rax) -> 48 89 88 10 00 00 00
  let b = newX64Buf()
  xMovStore(b, xMemB(XReg64.Rax, 16), XReg64.Rcx, 8)
  assert(xHex(b) == "48898810000000")

  // 32-bit store: no REX.W. {disp32} mov %ecx, 16(%rax) -> 89 88 10 00 00 00
  let b2 = newX64Buf()
  xMovStore(b2, xMemB(XReg64.Rax, 16), XReg64.Rcx, 4)
  assert(xHex(b2) == "898810000000")

  // 16-bit: the 0x66 operand-size prefix comes BEFORE any REX byte.
  // {disp32} mov %cx, 16(%rax) -> 66 89 88 10 00 00 00
  let b3 = newX64Buf()
  xMovStore(b3, xMemB(XReg64.Rax, 16), XReg64.Rcx, 2)
  assert(xHex(b3) == "66898810000000")

  // ...and these are the cases that PROVE the order, because the one above
  // needs no REX at all and so passes either way.
  // {disp32} mov %r13w, 16(%rax) -> 66 44 89 a8 10 00 00 00 (REX.R after 0x66)
  let b3r = newX64Buf()
  xMovStore(b3r, xMemB(XReg64.Rax, 16), XReg64.R13, 2)
  assert(xHex(b3r) == "664489a810000000")
  // {disp32} mov %cx, 16(%r12) -> 66 41 89 8c 24 10 00 00 00 (REX.B + r12 SIB)
  let b3b = newX64Buf()
  xMovStore(b3b, xMemB(XReg64.R12, 16), XReg64.Rcx, 2)
  assert(xHex(b3b) == "6641898c2410000000")

  // 8-bit ALWAYS carries a REX byte, even when every extension bit is clear.
  // The assembler emits plain `88 88 ...` for %cl; this emits `40 88 88 ...`.
  // Both encode the same store — the uniform prefix is what makes the sil case
  // below safe, and a bare 0x40 is a legal no-op prefix.
  let b4 = newX64Buf()
  xMovStore(b4, xMemB(XReg64.Rax, 16), XReg64.Rcx, 1)
  assert(xHex(b4) == "40888810000000")

  // ...and here is why. {disp32} mov %sil, 16(%rax) -> 40 88 b0 10 00 00 00 —
  // the assembler emits that same bare REX. WITHOUT it, this encoding names
  // %dh, a completely different register, and nothing complains.
  let b5 = newX64Buf()
  xMovStore(b5, xMemB(XReg64.Rax, 16), XReg64.Rsi, 1)
  assert(xHex(b5) == "4088b010000000")
  // {disp32} mov %dil, 16(%rax) -> 40 88 b8 10 00 00 00
  let b6 = newX64Buf()
  xMovStore(b6, xMemB(XReg64.Rax, 16), XReg64.Rdi, 1)
  assert(xHex(b6) == "4088b810000000")

  // r13 -> r12: REX.R for the source, REX.B for the base, and r12's mandatory
  // SIB. {disp32} mov %r13, 16(%r12) -> 4d 89 ac 24 10 00 00 00
  let b7 = newX64Buf()
  xMovStore(b7, xMemB(XReg64.R12, 16), XReg64.R13, 8)
  assert(xHex(b7) == "4d89ac2410000000")

  // Indexed. {disp32} mov %rcx, 16(%rax,%rbx,8) -> 48 89 8c d8 10 00 00 00
  let b8 = newX64Buf()
  xMovStore(b8, xMemBI(XReg64.Rax, XReg64.Rbx, 8, 16), XReg64.Rcx, 8)
  assert(xHex(b8) == "48898cd810000000")
}

fn checkX64Alu() {
  // Every golden is the assembler's. The group-1 ops share one encoding shape
  // and differ only by opcode, so the whole table is checked — a transposed
  // pair (say and/sub) computes the wrong answer silently.
  let ops = [XArith.Add, XArith.Or, XArith.And, XArith.Sub, XArith.Xor, XArith.Cmp]
  let want = ["4801c8", "4809c8", "4821c8", "4829c8", "4831c8", "4839c8"]
  let i = 0
  while (i < len(ops)) {
    let b = newX64Buf()
    xArithRR(b, ops[i], XReg64.Rax, XReg64.Rcx)
    assert(xHex(b) == want[i])
    i = i + 1
  }

  // The REX bits: for group-1, dst is the RM field (REX.B) and src the REG
  // field (REX.R).
  // add %r15, %rax -> 4c 01 f8  (REX.R: the source is extended)
  let b2 = newX64Buf()
  xArithRR(b2, XArith.Add, XReg64.Rax, XReg64.R15)
  assert(xHex(b2) == "4c01f8")
  // add %rcx, %r15 -> 49 01 cf  (REX.B: the destination is extended)
  let b3 = newX64Buf()
  xArithRR(b3, XArith.Add, XReg64.R15, XReg64.Rcx)
  assert(xHex(b3) == "4901cf")

  // IMUL REVERSES that: its destination is the REG field. Encoding it like
  // group-1 would multiply into the wrong register.
  // imul %rcx, %rax -> 48 0f af c1
  let b4 = newX64Buf()
  xImulRR(b4, XReg64.Rax, XReg64.Rcx)
  assert(xHex(b4) == "480fafc1")
  // imul %r15, %rax -> 49 0f af c7  (REX.B: the SOURCE is extended here)
  let b5 = newX64Buf()
  xImulRR(b5, XReg64.Rax, XReg64.R15)
  assert(xHex(b5) == "490fafc7")
  // imul %rcx, %r15 -> 4c 0f af f9  (REX.R: the DESTINATION is extended here)
  let b6 = newX64Buf()
  xImulRR(b6, XReg64.R15, XReg64.Rcx)
  assert(xHex(b6) == "4c0faff9")

  // test %rcx, %rax -> 48 85 c8
  let b7 = newX64Buf()
  xTestRR(b7, XReg64.Rax, XReg64.Rcx)
  assert(xHex(b7) == "4885c8")
}

// Group-1 immediate form (`81 /digit id`, #3495) for AND/OR/XOR — the same
// shape ADD/SUB already used (#1853), just three more digits. Split out of
// checkX64Alu to keep that function under the line ceiling. Every golden is
// `clang -arch x86_64 -c` + `otool -t` on %rcx/%r15 (never %rax: the
// assembler special-cases %rax with a shorter accumulator-only opcode this
// encoder does not implement, so an %rax golden would not match).
fn checkX64AluImm() {
  let immOps = [XArith.And, XArith.Or, XArith.Xor]
  let immWant = ["4881e134120000", "4881c934120000", "4881f134120000"]
  let i = 0
  while (i < len(immOps)) {
    let b = newX64Buf()
    xArithImm32(b, immOps[i], XReg64.Rcx, 0x1234)
    assert(xHex(b) == immWant[i])
    i = i + 1
  }
  // REX.B: %r15 as the sole (rm-field) operand.
  let r15Want = ["4981e734120000", "4981cf34120000", "4981f734120000"]
  i = 0
  while (i < len(immOps)) {
    let b = newX64Buf()
    xArithImm32(b, immOps[i], XReg64.R15, 0x1234)
    assert(xHex(b) == r15Want[i])
    i = i + 1
  }
  // A negative and an at-the-boundary imm32, forcing the long (non-imm8,
  // non-accumulator) form clang would otherwise shorten.
  let b8 = newX64Buf()
  xArithImm32(b8, XArith.And, XReg64.Rcx, 0 - 1000)
  assert(xHex(b8) == "4881e118fcffff")
  let b9 = newX64Buf()
  xArithImm32(b9, XArith.Or, XReg64.Rcx, 0 - 2147483648)
  assert(xHex(b9) == "4881c900000080")
  let b10 = newX64Buf()
  xArithImm32(b10, XArith.Xor, XReg64.R15, 2147483647)
  assert(xHex(b10) == "4981f7ffffff7f")

  // Outside imm32 range: not representable at all, must fall back.
  assert(!fitsXArithImm32(2147483648))
  assert(!fitsXArithImm32(0 - 2147483649))
  assert(fitsXArithImm32(2147483647) && fitsXArithImm32(0 - 2147483648))
}

fn checkX64DivShift() {
  // neg %rax -> 48 f7 d8 ; not %r15 -> 49 f7 d7
  let b = newX64Buf()
  xNegR(b, XReg64.Rax)
  assert(xHex(b) == "48f7d8")
  let b2 = newX64Buf()
  xNotR(b2, XReg64.R15)
  assert(xHex(b2) == "49f7d7")

  // idiv %rcx -> 48 f7 f9 ; div %r15 -> 49 f7 f7. Signed and unsigned division
  // are different opcodes on the same F7 group — swapping them gives a wrong
  // quotient, never a fault.
  let b3 = newX64Buf()
  xIdivR(b3, XReg64.Rcx)
  assert(xHex(b3) == "48f7f9")
  let b4 = newX64Buf()
  xDivR(b4, XReg64.R15)
  assert(xHex(b4) == "49f7f7")

  // cqto -> 48 99 (sign-extend rax into rdx:rax, priming SIGNED division)
  let b5 = newX64Buf()
  xCqo(b5)
  assert(xHex(b5) == "4899")
  // xor %edx, %edx -> 31 d2 (zero rdx, priming UNSIGNED division). No REX.W:
  // the 32-bit write clears the upper half for free.
  let b6 = newX64Buf()
  xZero32(b6, XReg64.Rdx)
  assert(xHex(b6) == "31d2")
  // xor %r13d, %r13d -> 45 31 ed — the register is in BOTH fields, so REX.R
  // and REX.B must both be set.
  let b7 = newX64Buf()
  xZero32(b7, XReg64.R13)
  assert(xHex(b7) == "4531ed")

  // Shifts. shr and sar differ ONLY by the ModRM digit (5 vs 7): getting it
  // wrong silently sign-extends, or fails to, on every right shift.
  assert(xShiftDigit(XShift.Shl) == 4)
  assert(xShiftDigit(XShift.Shr) == 5)
  assert(xShiftDigit(XShift.Sar) == 7)
  // shl $5, %rax -> 48 c1 e0 05
  let b8 = newX64Buf()
  xShiftImm(b8, XShift.Shl, XReg64.Rax, 5)
  assert(xHex(b8) == "48c1e005")
  // shr $5, %r15 -> 49 c1 ef 05
  let b9 = newX64Buf()
  xShiftImm(b9, XShift.Shr, XReg64.R15, 5)
  assert(xHex(b9) == "49c1ef05")
  // sar $5, %rax -> 48 c1 f8 05
  let bA = newX64Buf()
  xShiftImm(bA, XShift.Sar, XReg64.Rax, 5)
  assert(xHex(bA) == "48c1f805")
  // shl %cl, %rax -> 48 d3 e0 ; sar %cl, %r15 -> 49 d3 ff
  let bB = newX64Buf()
  xShiftCl(bB, XShift.Shl, XReg64.Rax)
  assert(xHex(bB) == "48d3e0")
  let bC = newX64Buf()
  xShiftCl(bC, XShift.Sar, XReg64.R15)
  assert(xHex(bC) == "49d3ff")
}

fn checkX64Setcc() {
  // The whole setcc table against the assembler. The SIGNED and UNSIGNED codes
  // are the pair most worth pinning: `setl` vs `setb` differ by one nibble and
  // decide whether 0xFFFF...F reads as -1 or as a huge positive.
  let ccs = [ccE(), ccNe(), ccB(), ccAe(), ccBe(), ccA(), ccL(), ccGe(), ccLe(), ccG(), ccP(), ccNp()]
  let want = ["400f94c0", "400f95c0", "400f92c0", "400f93c0", "400f96c0", "400f97c0",
    "400f9cc0", "400f9dc0", "400f9ec0", "400f9fc0", "400f9ac0", "400f9bc0"]
  let i = 0
  while (i < len(ccs)) {
    let b = newX64Buf()
    xSetcc(b, ccs[i], XReg64.Rax)
    // The assembler emits `0f 94 c0` for %al; this always prefixes REX, which
    // is what makes the %sil case below correct. Same instruction either way.
    assert(xHex(b) == want[i])
    i = i + 1
  }
  // Signed and unsigned must never collide.
  assert(ccL() != ccB() && ccG() != ccA() && ccLe() != ccBe() && ccGe() != ccAe())

  // sete %sil -> 40 0f 94 c6. The assembler emits that bare REX too: without
  // it, this encoding is `sete %dh`.
  let b2 = newX64Buf()
  xSetcc(b2, ccE(), XReg64.Rsi)
  assert(xHex(b2) == "400f94c6")
  // sete %r13b -> 41 0f 94 c5
  let b3 = newX64Buf()
  xSetcc(b3, ccE(), XReg64.R13)
  assert(xHex(b3) == "410f94c5")

  // movzbq %al, %rax -> 48 0f b6 c0
  let b4 = newX64Buf()
  xMovzxb(b4, XReg64.Rax, XReg64.Rax)
  assert(xHex(b4) == "480fb6c0")
  // movzbq %r13b, %r15 -> 4d 0f b6 fd (both extended)
  let b5 = newX64Buf()
  xMovzxb(b5, XReg64.R15, XReg64.R13)
  assert(xHex(b5) == "4d0fb6fd")

  // andb %cl, %al -> 20 c8 ; orb %cl, %al -> 08 c8 (plus the forced REX).
  let b6 = newX64Buf()
  xAnd8(b6, XReg64.Rax, XReg64.Rcx)
  assert(xHex(b6) == "4020c8")
  let b7 = newX64Buf()
  xOr8(b7, XReg64.Rax, XReg64.Rcx)
  assert(xHex(b7) == "4008c8")
}
