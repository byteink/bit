// Self-host (#3349, epic #3322): the driver that turns a real IrModule into a
// PE/COFF object for x86_64-windows — `emitPeObject`, modelled on
// emitmacho.bit's `emitMachoObject` and the x64 half of emitelf.bit's
// `emitElfObject`. A NEW file rather than a branch inside emitelf.bit's
// `emCompileFor`: that function is shared with aarch64-linux codegen and its
// SysV call convention must stay untouched (#3349's own constraint) — Win64
// is a different ABI (four integer args starting at RCX rather than six from
// RDI, RSI/RDI/XMM6-15 callee-saved, 32 bytes of caller-reserved "home space",
// position-based argument slots where the integer and float banks share
// numbering), so it needs its own driver, not a conditional bolted onto the
// shared one.
//
// Blob placement follows emitelf.bit's model, not emitmacho.bit's: like
// static ELF, a PE image's absolute pointers are fixed up by the LOADER via
// the `.reloc` table (pelink.bit's base-relocation pass) before the image
// ever runs, not by a dyld-style runtime rebind that needs a writable
// segment. So string headers, TypeInfo blobs and method tables all live in
// `.rdata` (read-only), never `.data` — matching emitElfObject's read-only
// blob placement even though a PE image IS ASLR-relocatable (pelink.bit's own
// "DYNAMIC BASE + .reloc" header note).
//
// COFF relocations carry NO addend field (emitpe.bit's own header comment) —
// REL-style, like Mach-O, not RELA like ELF — so a fixed constant a real
// toolchain bakes into the field bytes has to be written directly into the
// code/data here, not threaded through as a separate relocation field.
// `pelinkcheck.bit:100`'s own fixture pins the value this file must produce:
// a COFF Rel32 (`call rel32`) field's raw bytes must already hold -4
// (FC FF FF FF). Codegen's `xCallReloc` (x64frame.bit) leaves a ZERO
// placeholder there — correct for ELF's separately-stored RELA addend, wrong
// here — so `pePatchRel32Addend` overwrites it after every function's code is
// appended. An Abs64/Addr64 field's correct placeholder IS zero (the linker
// writes the absolute address in whole), so that path needs no patch.
//
// x86_64 only (XCallConv.Win64): aarch64-windows is out of scope for the
// whole epic (pelink.bit's own module comment), so unlike
// emitElfObject/emitMachoObject there is no second architecture to dispatch
// on here.
//

// codegen's Reloc kinds mapped onto emitpe.bit's writer. x86-64 only ever
// emits Branch and Abs64 once refuseThreadLocalStorage below has run (Tpoff32
// is reachable only from a per-thread `global_addr`, which that refusal keeps
// out of every function this file compiles) — mirrors emitelf.bit's
// emElfRelocX64 in shape, Mach-O's "no addend field" in convention.
fn emPeRelocX64(k: RelocKind): PeRelocKind {
  if (k == RelocKind.Abs64) {
    return PeRelocKind.Addr64
  }
  assert(k == RelocKind.Branch)
  return PeRelocKind.Rel32
}

// Overwrites a 4-byte COFF Rel32 field with the REL-style implicit addend a
// real toolchain bakes there (-4, i.e. FC FF FF FF little-endian) — see the
// module comment and pelinkcheck.bit:100's checkPeLinkPc32Addend, which pins
// this exact byte pattern against a real linkPeExecutable round trip.
fn pePatchRel32Addend(code: []u8, off: int) {
  code[off] = u8(0xFC)
  code[off + 1] = u8(0xFF)
  code[off + 2] = u8(0xFF)
  code[off + 3] = u8(0xFF)
}

fn emitPeObject(module: IrModule, withEntry: bool, freestanding: bool, debug: bool): []u8! {
  let code = newByteBuf()
  let rodata = newByteBuf()
  let gc = newByteBuf()
  let gdata = newByteBuf()
  assignIfaceCaches(module)
  if (freestanding) {
    refuseManagedMetadata(module)?
    refuseUnpinnedImports(module)?
    refuseImportedGlobalRefs(module)?
  }
  refuseThreadLocalStorage(module, "PE")?

  emPeRefuseSyscalls(module, freestanding)?
  let fr = emPeFuncsToText(module, freestanding, debug, code)
  emPeEntry(withEntry, code, fr)?
  let cellBinding = PeBinding.Global
  if (definitionIsLocal(freestanding, false)) {
    cellBinding = PeBinding.Local
  }
  let bssSize = emPeGlobals(module, freestanding, cellBinding, gdata, fr)?
  emPeReadonlyGlobals(module, freestanding, cellBinding, rodata, fr)?
  emPeStrings(module, freestanding, rodata, fr)
  emPeTypeInfos(module, freestanding, rodata, fr)
  emPeStackMaps(gc, fr)
  emPeUndefined(fr)
  let sections = [
    PeSection{
      kind = PeSectionKind.Text, data = code.bytes,
      size = 0, alignment = xFuncAlign(),
    },
  ]
  sections = emPeReadonlySection(module, freestanding, rodata, sections)
  sections = emPeDataSections(module, freestanding, gdata, bssSize, sections)
  sections = emPeGcSection(gc, sections)
  return writePeObject(
    PeTarget.X86_64,
    PeObject{ sections = sections, symbols = fr.symbols, relocations = fr.relocs },
  )?
}

// What `emPeFuncsToText` produces beyond `code`, which it fills in place: the
// symbol table, relocations and defined-set every later phase extends, the
// per-function stack maps and names the .bit_gc pass needs, and whether a
// `main` was seen and is void (for the entry trampoline). One allocation per
// `emitPeObject` call, as `EmElfFuncsResult` is for ELF.
class EmPeFuncsResult {
  symbols: []PeSymbol,
  relocs: []PeRelocation,
  defined: map<string, bool>,
  stackmaps: []FuncStackMap,
  emittedNames: []string,
  mainVoid: bool,
  haveMain: bool,
}

// ---- every function -> one .text symbol + its relocations -----------------
// #5830: each function is followed by xPadFuncAlign's NOPs, so every entry
// sits on an xFuncAlign() boundary, as emElfFuncsToText does for ELF (#5829).
// The symbol's size stays the code's own length: padding is outside it.
fn emPeFuncsToText(
  module: IrModule, freestanding: bool, debug: bool, code: ByteBuf,
): EmPeFuncsResult {
  let symbols = []PeSymbol(0)
  let relocs = []PeRelocation(0)
  let defined = map<string, bool>{}
  let stackmaps = []FuncStackMap(0)
  let emittedNames = []string(0)
  let mainVoid = false
  let haveMain = false
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: an imported module's function belongs to its own object.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    let fc = xCompileFunction(module, f, XCallConv.Win64, debug)
    let off = len(code.bytes)
    appendBytes(code, fc.code)
    // §11.9/§17.6 (#1631): a freestanding object exports only its @symbol
    // pins; every other definition is module-private.
    let fnBinding = PeBinding.Global
    if (definitionIsLocal(freestanding, f.isPinned)) {
      fnBinding = PeBinding.Local
    }
    symbols = append(
      symbols,
      PeSymbol{
        name = f.name, hasSection = true,
        section = PeSectionKind.Text, offset = off, size = len(fc.code),
        binding = fnBinding, kind = PeSymKind.Func,
      },
    )
    defined[f.name] = true
    let r = 0
    while (r < len(fc.relocs)) {
      let relOff = off + fc.relocs[r].offset
      let k = emPeRelocX64(fc.relocs[r].kind)
      if (k == PeRelocKind.Rel32) {
        pePatchRel32Addend(code.bytes, relOff)
      }
      relocs = append(
        relocs,
        PeRelocation{
          section = PeSectionKind.Text,
          offset = relOff, symbol = fc.relocs[r].symbol, kind = k,
        },
      )
      r = r + 1
    }
    xPadFuncAlign(code)
    stackmaps = append(stackmaps, emStackMapOf(fc))
    emittedNames = append(emittedNames, f.name)
    if (f.name == "main") {
      haveMain = true
      mainVoid = module.ctx.types[f.result].kind == TypeKind.Void
    }
    fi = fi + 1
  }
  return EmPeFuncsResult{
    symbols = symbols, relocs = relocs, defined = defined, stackmaps = stackmaps,
    emittedNames = emittedNames, mainVoid = mainVoid, haveMain = haveMain,
  }
}

// One Addr64 per global fixup placed in `buf`, which is section `sec`'s blob;
// `pelink` turns each into a DIR64 base relocation. No addend field on this
// writer (module comment), so the addend is baked into the image, as
// `machoFixups` (emitmacho.bit) does rather than ELF's RELA form.
fn peFixups(
  buf: ByteBuf,
  fixups: []GlobalFixup,
  sec: PeSectionKind,
  relocs: []PeRelocation,
): []PeRelocation {
  for f of fixups {
    patchU64Le(buf.bytes, f.offset, f.addend)
    relocs = append(
      relocs,
      PeRelocation{
        section = sec, offset = f.offset, symbol = f.symbol, kind = PeRelocKind.Addr64,
      },
    )
  }
  return relocs
}
