// Self-host (#3349, epic #3322): the driver that turns a real IrModule into a
// PE/COFF object for x86_64-windows — `emitPeObject`, modelled on
// emitmacho.bit's `emitMachoObject` and the x64 half of emitelf.bit's
// `emitElfObject`. A NEW file rather than a branch inside emitelf.bit's
// `emCompileFor`: that function is shared with aarch64-linux codegen and its
// SysV call convention must stay untouched (#3349's own constraint) — Win64
// is a different ABI (four integer args starting at RCX rather than six from
// RDI, RSI/RDI/XMM6-15 callee-saved, 32 bytes of caller-reserved "home space",
// position-based argument slots where the integer and float banks share
// numbering), so it needs its own driver, not a conditional bolted onto the
// shared one.
//
// Blob placement follows emitelf.bit's model, not emitmacho.bit's: like
// static ELF, a PE image's absolute pointers are fixed up by the LOADER via
// the `.reloc` table (pelink.bit's base-relocation pass) before the image
// ever runs, not by a dyld-style runtime rebind that needs a writable
// segment. So string headers, TypeInfo blobs and method tables all live in
// `.rdata` (read-only), never `.data` — matching emitElfObject's read-only
// blob placement even though a PE image IS ASLR-relocatable (pelink.bit's own
// "DYNAMIC BASE + .reloc" header note).
//
// COFF relocations carry NO addend field (emitpe.bit's own header comment) —
// REL-style, like Mach-O, not RELA like ELF — so a fixed constant a real
// toolchain bakes into the field bytes has to be written directly into the
// code/data here, not threaded through as a separate relocation field.
// `pelinkcheck.bit:100`'s own fixture pins the value this file must produce:
// a COFF Rel32 (`call rel32`) field's raw bytes must already hold -4
// (FC FF FF FF). Codegen's `xCallReloc` (x64frame.bit) leaves a ZERO
// placeholder there — correct for ELF's separately-stored RELA addend, wrong
// here — so `pePatchRel32Addend` overwrites it after every function's code is
// appended. An Abs64/Addr64 field's correct placeholder IS zero (the linker
// writes the absolute address in whole), so that path needs no patch.
//
// x86_64 only (XCallConv.Win64): aarch64-windows is out of scope for the
// whole epic (pelink.bit's own module comment), so unlike
// emitElfObject/emitMachoObject there is no second architecture to dispatch
// on here.

// codegen's Reloc kinds mapped onto emitpe.bit's writer. x86-64 only ever
// emits Branch and Abs64 once refuseThreadLocalStorage below has run (Tpoff32
// is reachable only from a per-thread `global_addr`, which that refusal keeps
// out of every function this file compiles) — mirrors emitelf.bit's
// emElfRelocX64 in shape, Mach-O's "no addend field" in convention.
fn emPeRelocX64(k: RelocKind): PeRelocKind {
  if (k == RelocKind.Abs64) {
    return PeRelocKind.Addr64
  }
  assert(k == RelocKind.Branch)
  return PeRelocKind.Rel32
}

// Overwrites a 4-byte COFF Rel32 field with the REL-style implicit addend a
// real toolchain bakes there (-4, i.e. FC FF FF FF little-endian) — see the
// module comment and pelinkcheck.bit:100's checkPeLinkPc32Addend, which pins
// this exact byte pattern against a real linkPeExecutable round trip.
fn pePatchRel32Addend(code: []u8, off: int) {
  code[off] = u8(0xFC)
  code[off + 1] = u8(0xFF)
  code[off + 2] = u8(0xFF)
  code[off + 3] = u8(0xFF)
}

fn emitPeObject(module: IrModule, withEntry: bool, freestanding: bool, debug: bool): []u8! {
  let code = newByteBuf()
  let rodata = newByteBuf()
  let gc = newByteBuf()
  let gdata = newByteBuf()
  let symbols = []PeSymbol(0)
  let relocs = []PeRelocation(0)
  let defined = map<string, bool>{}
  let stackmaps = []FuncStackMap(0)
  let emittedNames = []string(0)
  if (freestanding) {
    refuseManagedMetadata(module)?
    refuseUnpinnedImports(module)?
    refuseImportedGlobalRefs(module)?
  }
  refuseThreadLocalStorage(module, "PE")?

  // §11.8: `syscall()` is Linux-only — Windows publishes no stable syscall
  // ABI either (pesyms.bit's own module comment), so a raw `syscall`
  // instruction reaching a Windows image would trap at load with no line
  // number. Mirrors emitmacho.bit's identical guard for aarch64-macos.
  let sf = 0
  while (sf < len(module.funcs)) {
    let sfn = module.funcs[sf]
    if (!emitsFunction(sfn, freestanding)) {
      sf = sf + 1
      continue
    }
    let si0 = 0
    while (si0 < len(sfn.instrs)) {
      if (sfn.instrs[si0].op == Op.Syscall) {
        fail newError("'syscall' is not supported on x86_64-windows: Windows publishes no stable syscall ABI (SPEC §11.8)")
      }
      si0 = si0 + 1
    }
    sf = sf + 1
  }

  // ---- every function -> one .text symbol + its relocations ---------------
  let mainVoid = false
  let haveMain = false
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: an imported module's function belongs to its own object.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    let fc = xCompileFunction(module, f, XCallConv.Win64, debug)
    let off = len(code.bytes)
    appendBytes(code, fc.code)
    // §11.9/§17.6 (#1631): a freestanding object exports only its @symbol
    // pins; every other definition is module-private.
    let fnBinding = PeBinding.Global
    if (definitionIsLocal(freestanding, f.isPinned)) {
      fnBinding = PeBinding.Local
    }
    symbols = append(symbols, PeSymbol{ name: f.name, hasSection: true,
      section: PeSectionKind.Text, offset: off, size: len(fc.code),
      binding: fnBinding, kind: PeSymKind.Func })
    defined[f.name] = true
    let r = 0
    while (r < len(fc.relocs)) {
      let relOff = off + fc.relocs[r].offset
      let k = emPeRelocX64(fc.relocs[r].kind)
      if (k == PeRelocKind.Rel32) {
        pePatchRel32Addend(code.bytes, relOff)
      }
      relocs = append(relocs, PeRelocation{ section: PeSectionKind.Text,
        offset: relOff, symbol: fc.relocs[r].symbol, kind: k })
      r = r + 1
    }
    stackmaps = append(stackmaps, emStackMapOf(fc))
    emittedNames = append(emittedNames, f.name)
    if (f.name == "main") {
      haveMain = true
      mainVoid = module.ctx.types[f.result].kind == TypeKind.Void
    }
    fi = fi + 1
  }
  if (withEntry) {
    if (!haveMain) {
      // Wording shared with emitelf.bit/emitmacho.bit, defined once in
      // build.bit (#2234).
      fail newError(noMainMessage())
    }

    // ---- bit_main entry trampoline (Win64) ---------------------------------
    // The runtime calls bit_main (boot runs it as a green thread); a void
    // `main` still owes an exit code, so the trampoline supplies 0. Shaped
    // like emitelf.bit's x64 trampoline ("sub rsp,N ; call main ; ... ; add
    // rsp,N ; ret") but N is 40 rather than 8: Win64 additionally reserves 32
    // bytes of caller "home space" below the call, on top of the 8 the SysV
    // trampoline uses purely for 16-byte alignment at the CALL instruction
    // (on entry rsp%16==8, same on both ABIs — the return address bit_main's
    // own caller pushed).
    let tramp = len(code.bytes)
    appendBytes(code, [u8(0x48), u8(0x83), u8(0xEC), u8(0x28)]) // sub rsp, 40
    code.bytes = append(code.bytes, u8(0xE8))                    // call rel32
    let callField = len(code.bytes)
    appendZeros(code, 4)
    pePatchRel32Addend(code.bytes, callField)
    relocs = append(relocs, PeRelocation{ section: PeSectionKind.Text,
      offset: callField, symbol: "main", kind: PeRelocKind.Rel32 })
    if (mainVoid) {
      appendBytes(code, [u8(0x31), u8(0xC0)]) // xor eax, eax
    }
    appendBytes(code, [u8(0x48), u8(0x83), u8(0xC4), u8(0x28), u8(0xC3)]) // add rsp,40 ; ret
    symbols = append(symbols, PeSymbol{ name: "bit_main", hasSection: true,
      section: PeSectionKind.Text, offset: tramp, size: len(code.bytes) - tramp,
      binding: PeBinding.Global, kind: PeSymKind.Func })
    defined["bit_main"] = true
  }

  // ---- module-level state (§11.11) -> writable .data / zero-fill .bss -----
  // §11.11/§17.6 (#1630): a cell is never a pin, so a freestanding object
  // keeps its own module state LOCAL.
  let cellBinding = PeBinding.Global
  if (definitionIsLocal(freestanding, false)) {
    cellBinding = PeBinding.Local
  }
  // #2949: an all-zero cell goes to `.bss` (no file bytes), matching the ELF
  // and Mach-O paths.
  let egs = placeGlobals(module, 0, gdata, freestanding, true)
  let egi = 0
  while (egi < len(egs.data)) {
    symbols = append(symbols, PeSymbol{ name: egs.data[egi].name, hasSection: true,
      section: PeSectionKind.Data, offset: egs.data[egi].offset,
      size: egs.data[egi].size, binding: cellBinding, kind: PeSymKind.Object })
    defined[egs.data[egi].name] = true
    egi = egi + 1
  }
  let ebi = 0
  while (ebi < len(egs.bss)) {
    symbols = append(symbols, PeSymbol{ name: egs.bss[ebi].name, hasSection: true,
      section: PeSectionKind.Bss, offset: egs.bss[ebi].offset,
      size: egs.bss[ebi].size, binding: cellBinding, kind: PeSymKind.Object })
    defined[egs.bss[ebi].name] = true
    ebi = ebi + 1
  }

  // ---- read-only module state (§11.11) -> .rdata ---------------------------
  // Placed before the string pool/TypeInfo/GC blobs so a table's own
  // alignment padding is measured from the start of the section (mirrors
  // emitElfObject's ordering).
  let ro = placeReadonlyGlobals(module, rodata, freestanding)
  for rp of ro.placements {
    symbols = append(symbols, PeSymbol{ name: rp.name, hasSection: true,
      section: PeSectionKind.Rodata, offset: rp.offset, size: rp.size,
      binding: cellBinding, kind: PeSymKind.Object })
    defined[rp.name] = true
  }
  // No addend field on this writer (module comment): bake it into the image,
  // mirroring emitmacho.bit's identical fixups loop rather than ELF's RELA one.
  for f of ro.fixups {
    patchU64Le(rodata.bytes, f.offset, f.addend)
    relocs = append(relocs, PeRelocation{ section: PeSectionKind.Rodata,
      offset: f.offset, symbol: f.symbol, kind: PeRelocKind.Addr64 })
  }

  // ---- string pool -> .rdata bytes + a {ptr,len} header --------------------
  let ssi = 0
  while (ssi < len(module.stringPool)) {
    let s = module.stringPool[ssi]
    let dataOff = len(rodata.bytes)
    appendBytes(rodata, []byte(s))
    let dataName = "__bitstr_${ssi}_data"
    symbols = append(symbols, PeSymbol{ name: dataName, hasSection: true,
      section: PeSectionKind.Rodata, offset: dataOff, size: len([]byte(s)),
      binding: PeBinding.Local, kind: PeSymKind.Object })
    defined[dataName] = true

    emPadTo8(rodata)
    let hdrOff = len(rodata.bytes)
    appendU64(rodata, 0)              // ptr — filled by the reloc below
    appendU64(rodata, len([]byte(s))) // len
    let hdrName = "__bitstr_${ssi}"
    let hdrBinding = PeBinding.Global
    if (freestanding) {
      hdrBinding = PeBinding.Local
    }
    symbols = append(symbols, PeSymbol{ name: hdrName, hasSection: true,
      section: PeSectionKind.Rodata, offset: hdrOff, size: 16,
      binding: hdrBinding, kind: PeSymKind.Object })
    defined[hdrName] = true
    relocs = append(relocs, PeRelocation{ section: PeSectionKind.Rodata,
      offset: hdrOff, symbol: dataName, kind: PeRelocKind.Addr64 })
    ssi = ssi + 1
  }

  // ---- gc_alloc TypeInfo blobs -> .rdata -----------------------------------
  let tis = collectTypeInfos(module, freestanding)
  let ti = 0
  while (ti < len(tis)) {
    let t = tis[ti]
    let name = typeInfoSymbol(t.disc, t.size, t.ptrOffsets)
    let offsName = ""
    if (len(t.ptrOffsets) > 0) {
      emPadTo8(rodata)
      let offsOff = len(rodata.bytes)
      let k = 0
      while (k < len(t.ptrOffsets)) {
        appendU64(rodata, t.ptrOffsets[k])
        k = k + 1
      }
      offsName = name + "_offs"
      symbols = append(symbols, PeSymbol{ name: offsName, hasSection: true,
        section: PeSectionKind.Rodata, offset: offsOff,
        size: len(t.ptrOffsets) * 8, binding: PeBinding.Local, kind: PeSymKind.Object })
      defined[offsName] = true
    }
    let tname = ""
    if (module.ctx.types[t.disc].hasName) {
      tname = module.ctx.types[t.disc].name
    }
    let nameSym = ""
    if (len([]byte(tname)) > 0) {
      let nmOff = len(rodata.bytes)
      appendBytes(rodata, []byte(tname))
      nameSym = name + "_name"
      symbols = append(symbols, PeSymbol{ name: nameSym, hasSection: true,
        section: PeSectionKind.Rodata, offset: nmOff, size: len([]byte(tname)),
        binding: PeBinding.Local, kind: PeSymKind.Object })
      defined[nameSym] = true
    }
    let methods = emitMethodTable(module, rodata, t.disc, name)
    if (methods.sym != "") {
      symbols = append(symbols, PeSymbol{ name: methods.sym, hasSection: true,
        section: PeSectionKind.Rodata, offset: methods.off, size: methods.size,
        binding: PeBinding.Local, kind: PeSymKind.Object })
      defined[methods.sym] = true
      let mr = 0
      while (mr < len(methods.relocs)) {
        relocs = append(relocs, PeRelocation{ section: PeSectionKind.Rodata,
          offset: methods.relocs[mr].off, symbol: methods.relocs[mr].sym,
          kind: PeRelocKind.Addr64 })
        mr = mr + 1
      }
    }

    emPadTo8(rodata)
    let tiOff = len(rodata.bytes)
    appendU64(rodata, t.size)             // size
    appendU64(rodata, 0)                  // ptr_offsets_ptr (reloc below if any)
    appendU64(rodata, len(t.ptrOffsets))  // ptr_offsets_len
    appendU64(rodata, 0)                  // name_ptr (reloc below if any)
    appendU64(rodata, len([]byte(tname))) // name_len
    appendU64(rodata, 0)                  // methods_ptr (reloc below if any)
    appendU64(rodata, methods.size / 16)  // methods_len
    symbols = append(symbols, PeSymbol{ name: name, hasSection: true,
      section: PeSectionKind.Rodata, offset: tiOff, size: 56,
      binding: PeBinding.Global, kind: PeSymKind.Object })
    defined[name] = true
    if (len(t.ptrOffsets) > 0) {
      relocs = append(relocs, PeRelocation{ section: PeSectionKind.Rodata,
        offset: tiOff + 8, symbol: offsName, kind: PeRelocKind.Addr64 })
    }
    if (nameSym != "") {
      relocs = append(relocs, PeRelocation{ section: PeSectionKind.Rodata,
        offset: tiOff + 24, symbol: nameSym, kind: PeRelocKind.Addr64 })
    }
    if (methods.sym != "") {
      relocs = append(relocs, PeRelocation{ section: PeSectionKind.Rodata,
        offset: tiOff + 40, symbol: methods.sym, kind: PeRelocKind.Addr64 })
    }
    ti = ti + 1
  }

  // ---- GC stack-map entries (runtime/ABI.md §4) -> .bit_gc -----------------
  // Per-MEMBER, not per-program: matches emitElfObject/emitMachoObject exactly
  // — one section, one LOCAL symbol per function, so the linker can drop an
  // entry whose function it dropped.
  assert(len(emittedNames) == len(stackmaps))
  let smCodeRelocs = writeStackMaps(gc, stackmaps)
  let smi = 0
  while (smi < len(smCodeRelocs)) {
    let smOff = smCodeRelocs[smi]
    let smEnd = len(gc.bytes)
    if (smi + 1 < len(smCodeRelocs)) {
      smEnd = smCodeRelocs[smi + 1]
    }
    let smName = "__bitsm_${smi}"
    symbols = append(symbols, PeSymbol{ name: smName, hasSection: true,
      section: PeSectionKind.GcMeta, offset: smOff, size: smEnd - smOff,
      binding: PeBinding.Local, kind: PeSymKind.Object })
    defined[smName] = true
    // Offsets are already section-relative, and an entry starts with its
    // codeAddr field — so the entry offset IS the reloc offset.
    relocs = append(relocs, PeRelocation{ section: PeSectionKind.GcMeta,
      offset: smOff, symbol: emittedNames[smi], kind: PeRelocKind.Addr64 })
    smi = smi + 1
  }

  // ---- undefined externals (the runtime's bit_rt_* symbols, and §11.7
  // `extern function` declarations that will resolve to a kernel32 import at
  // link time) --------------------------------------------------------------
  let externs = map<string, bool>{}
  let ri = 0
  while (ri < len(relocs)) {
    let sym = relocs[ri].symbol
    let (_, isDef) = defined[sym]
    let (_, isExt) = externs[sym]
    if (!isDef && !isExt) {
      externs[sym] = true
      symbols = append(symbols, PeSymbol{ name: sym, hasSection: false,
        section: PeSectionKind.Text, offset: 0, size: 0,
        binding: PeBinding.Global, kind: PeSymKind.Notype })
    }
    ri = ri + 1
  }

  let sections = [PeSection{ kind: PeSectionKind.Text, data: code.bytes,
    size: 0, alignment: 16 }]
  if (len(rodata.bytes) > 0) {
    sections = append(sections, PeSection{ kind: PeSectionKind.Rodata,
      data: rodata.bytes, size: 0,
      alignment: globalsAlign(module, storageReadonly(), freestanding) })
  }
  if (len(gdata.bytes) > 0) {
    sections = append(sections, PeSection{ kind: PeSectionKind.Data,
      data: gdata.bytes, size: 0, alignment: globalsAlign(module, 0, freestanding) })
  }
  if (egs.bssSize > 0) {
    sections = append(sections, PeSection{ kind: PeSectionKind.Bss,
      data: []u8(0), size: egs.bssSize,
      alignment: globalsAlignBss(module, 0, freestanding) })
  }
  if (len(gc.bytes) > 0) {
    // 8-aligned (#1927): writeStackMaps pads every entry to a multiple of 8.
    sections = append(sections, PeSection{ kind: PeSectionKind.GcMeta,
      data: gc.bytes, size: 0, alignment: 8 })
  }
  return writePeObject(PeTarget.X86_64,
    PeObject{ sections: sections, symbols: symbols, relocations: relocs })?
}
