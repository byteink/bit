// compiler/lowermatch.bit -- split out of lowerflow.bit (#5673, no room in
// that file for the lowerAssign function split #2450 needs) to keep both
// files under the 800-line lint limit. Same module as lowerflow.bit, so
// this needs no imports and no call-site changes.
//
// The `match (subject) { ... }` STATEMENT lowering family: lowerMatchArm
// (one arm), lowerMatch (the statement itself, a decision tree over the
// enum tag), and the parallel `match` EXPRESSION path lowerMatchExprArm/
// matchExprResultTy/lowerMatchExpr (the same decision tree, but each arm
// feeds a join-block phi instead of falling out the bottom). Moved as one
// group: nothing in lowerflow.bit's remaining assign/store/loop lowering
// calls any of them.

// `matchSubjectWords`/`MatchSubject`/`lowerMatchSubject` — resolving the
// match subject, including #5313's exploded-enum word path — live in
// lowerbranch.bit next to `matchTag`/`bindArmPayload`, the two functions they
// exist to feed; same module, no import needed.

fn lowerMatchArm(
  fc: FnCtx,
  arm: int,
  preLen: int,
  join: int,
  boxed: bool,
  enumTy: int,
  ms: MatchSubject,
): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumTy, ms)
  lowerArmBody(fc, ak[1])
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, snapshotValues(fc, preLen))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => body, ... }` statement over an enum to a
// decision tree: each arm but the last tests `tag == <ordinal>` and branches to
// its body or the next test; the last arm is the exhaustive fallthrough. A `join`
// block merges the non-diverging arms (unreachable if every arm diverges). A
// boxed enum's tag is object word 0 and its arms bind the payload.
fn lowerMatch(fc: FnCtx, node: int) {
  // #5670: only one arm runs (lowerkeepalive.bit's banner).
  clearPtrOfBindings(fc)
  let k = kidsOf(fc.c.tree, node)
  let subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fcFail(fc, getNode(fc.c.tree, k[0]).span, "a `match` over a value that is not an enum")
    return
  }
  let boxed = fc.c.ctx.types[subjectTy].enumBoxed
  let ms = lowerMatchSubject(fc, k[0], subjectTy, boxed)
  if (fc.failed) {
    return
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return
  }
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = ms.tag
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, subjectTy, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchArm(fc, arm, preLen, join, boxed, subjectTy, ms)) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  // Last arm: the exhaustive fallthrough, lowered in the current block with no
  // test.
  fc.terminated = false
  if (lowerMatchArm(fc, arms[len(arms) - 1], preLen, join, boxed, subjectTy, ms)) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Lowers one match-expression arm: its body is an *expression* whose value is
// carried to the join as the trailing block param. Returns whether the join is
// reached.
fn lowerMatchExprArm(
  fc: FnCtx,
  arm: int,
  preLen: int,
  join: int,
  resultTy: int,
  isVoid: bool,
  boxed: bool,
  enumTy: int,
  ms: MatchSubject,
): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumTy, ms)
  let val = 0
  if (isVoid) {
    lowerExpr(fc, ak[1])
  } else {
    val = lowerExprH(fc, ak[1], resultTy)
  }
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, catchEdgeArgs(fc, snapshotValues(fc, preLen), val, isVoid))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => expr, ... }` in expression position over a
// C-like enum: like the statement form, but each arm yields a value merged at the
// The result type of a generic-enum match expression: the first arm's body type
// with its payload binders substituted to the scrutinee's concrete type-args, so
// `match(o: Opt<i64>){ Some(v)=>v ... }` yields i64, not the bare type-param.
fn matchExprResultTy(fc: FnCtx, node: int, enumTy: int): int {
  let k = kidsOf(fc.c.tree, node)
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return fc.c.ctx.voidId
  }
  let ak = kidsOf(fc.c.tree, arms[0])
  let vp = kidsOf(fc.c.tree, ak[0])
  if (vp[1] != 0) {
    let vn = getNode(fc.c.tree, vp[0])
    let ptypes = variantPayloadTypes(fc.c, enumTy, fc.c.source[vn.span.start:vn.span.end])
    let binders = kidsOf(fc.c.tree, vp[1])
    let i = 0
    while (i < len(binders)) {
      let bt = primType(fc.c.ctx, 3)
      if (i < len(ptypes)) {
        bt = ptypes[i]
      }
      rebindCheckerName(fc, binders[i], bt)
      i = i + 1
    }
  }
  return defaultType(fc.c, nodeType(fc, ak[1]))
}

// Bundles the fields `lowerMatchExprCases`/`lowerMatchExprDefault` share with
// their driver `lowerMatchExpr` — one heap allocation per `match` EXPRESSION
// lowered (never per arm), negligible next to the `LoopFrame` append and
// per-arm blocks `lowerMatchExpr` already allocates for the same match; same
// shape and same cost class as `lowerbranch.bit`'s `SwitchLowerState`.
class MatchExprLowerState {
  node: int,
  arms: []int,
  ms: MatchSubject,
  subjectTy: int,
  boxed: bool,
  resultTy: int,
  isVoid: bool,
  preLen: int,
  orig: []int,
  join: int,
  tag: int,
  boolTy: int,
  tagTy: int,
}

// Runs the per-arm dispatch loop of a `match` expression, arms[0..len-1)
// (the exhaustive last arm is `lowerMatchExprDefault`'s job): each arm's
// `tag == <ordinal>` test branches to its body or the next test. Returns
// whether any arm's body fell through to the join, same accumulation as the
// original inline loop.
fn lowerMatchExprCases(fc: FnCtx, state: MatchExprLowerState): bool {
  let joinReachable = false
  let i = 0
  while (i < len(state.arms) - 1 && !fc.failed) {
    let arm = state.arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, state.subjectTy, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, state.tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, state.boolTy)
    eq.lhs = state.tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchExprArm(
      fc,
      arm,
      state.preLen,
      state.join,
      state.resultTy,
      state.isVoid,
      state.boxed,
      state.subjectTy,
      state.ms,
    )) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, state.preLen)
    restoreValues(fc, state.orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  return joinReachable
}

// Lowers the last arm: the exhaustive fallthrough, tested by nothing (same
// role as `lowerSwitchDefault`). Returns whether it fell through to the join.
fn lowerMatchExprDefault(fc: FnCtx, state: MatchExprLowerState): bool {
  fc.terminated = false
  let reached = false
  if (lowerMatchExprArm(
    fc,
    state.arms[len(state.arms) - 1],
    state.preLen,
    state.join,
    state.resultTy,
    state.isVoid,
    state.boxed,
    state.subjectTy,
    state.ms,
  )) {
    reached = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, state.preLen)
  restoreValues(fc, state.orig)
  return reached
}

// join's trailing param — the whole match's value. ponytail: boxed enums deferred.
fn lowerMatchExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let resultTy = defaultType(fc.c, nodeType(fc, node))
  let subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fcFail(fc, getNode(fc.c.tree, k[0]).span, "a `match` over a value that is not an enum")
    return 0
  }
  let boxed = fc.c.ctx.types[subjectTy].enumBoxed
  let ms = lowerMatchSubject(fc, k[0], subjectTy, boxed)
  if (fc.failed) {
    return 0
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    fcFail(fc, getNode(fc.c.tree, node).span, "a `match` expression with no arms")
    return 0
  }
  // A generic-enum match's arms yield the substituted payload type, which the
  // whole-match type inference (over the bare type-param) misses — derive the
  // result from the first arm's body with its payload binders substituted.
  if (boxed && (resultTy == 0 || fc.c.ctx.types[resultTy].kind == TypeKind.TypeParam)) {
    resultTy = matchExprResultTy(fc, node, subjectTy)
  }
  let isVoid = resultTy == fc.c.ctx.voidId
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = ms.tag
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let state = MatchExprLowerState{
    node = node,
    arms = arms,
    ms = ms,
    subjectTy = subjectTy,
    boxed = boxed,
    resultTy = resultTy,
    isVoid = isVoid,
    preLen = preLen,
    orig = orig,
    join = join,
    tag = tag,
    boolTy = boolTy,
    tagTy = tagTy,
  }
  let caseReach = lowerMatchExprCases(fc, state)
  let defaultReach = lowerMatchExprDefault(fc, state)
  let joinReachable = caseReach || defaultReach
  builderBeginBlock(fc.b, join)
  if (!joinReachable) {
    let phTy = resultTy
    if (isVoid) {
      phTy = primType(fc.c.ctx, 3)
    }
    let ph = zeroValue(fc, phTy, getNode(fc.c.tree, node).span)
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
    return ph
  }
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    let z = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
    return builderEmit(fc.b, z)
  }
  return builderAddParam(fc.b, resultTy)
}

