// compiler/parsercond.bit — `cond ? a : b` (SPEC §12, #3941). Sibling of
// parserexpr.bit: same module, so this needs no imports and no call-site
// changes. Split out on its own because parserexpr.bit was already near the
// 800-line lint limit (spec/LINT.md E0200) before this landed.

// Whether a `?` just encountered by `parsePostfix` (parserexpr.bit) is
// actually the conditional's own opener rather than error-propagation — the
// one real parsing hazard: `?` is a postfix operator (`expr?`, tightest
// binding) with no operand-type requirement at parse time, so a plain
// `cond ? a : b` would otherwise have its `?` swallowed as propagation on
// `cond` itself before `parseConditional` ever ran, and the SAME thing
// happens at whichever token `cond` actually ENDS on — `a > 0 ? c : d` loses
// its `?` to `0`, `a + b ? c : d` loses it to `b`, deep inside `parseBinary`'s
// own precedence climb, not just at the top.
//
// Resolved with a real, throwaway speculative parse — the same mark/reset/
// diag-truncate idiom `parsePostfix`'s generic-turbofish attempt above already
// uses, and for the same reason: only actually trying to parse `<then> :`
// answers "does this parse" correctly, at whatever nesting depth the `?`
// sits, without hand-rolling a bracket-depth token scanner. `splitMark`/
// `undoSplits` matters here too — the speculative `then` may itself contain a
// generic close that rewrites a `>>`/`>>=`/`>=` token in place, and a rollback
// that forgot to undo it would leave the token STREAM mutated even though the
// parser's position was rewound.
//
// A clean parse of `then` followed by `:` means `?` was never propagation at
// all: `parsePostfix` must leave it unconsumed (see its call site) so the
// (possibly much shallower) `cond` bubbles up untouched and `parseConditional`
// opens the ternary normally, however deep this `?` actually was.
fn looksLikeTernaryQuestion(p: Parser): bool {
  let mark = p.pos
  let dmark = len(p.diags.list)
  let smark = splitMark(p)
  let nodeMark = len(p.tree.nodes)
  let extraMark = len(p.tree.extra)
  advance(p)   // past '?'
  parseExpr(p) // the candidate `then` — its value is not needed, only whether it parsed clean
  let ok = len(p.diags.list) == dmark && peekKind(p) == Kind.Colon
  p.pos = mark
  truncateDiags(p.diags, dmark)
  undoSplits(p, smark)
  truncateNodes(p.tree, nodeMark, extraMark)
  return ok
}

// `cond ? a : b` (§12, #3941): right-associative, between `=>` (loosest) and
// `||` (tightest of the binops) — `binary` already threads `catch` into the
// SAME precedence climb (parseBinary), so `cond`/`b` may themselves be
// `x catch y` with no extra parens (`a catch b ? c : d` is `(a catch b) ? c :
// d`). The `then` branch is a full `expression` (so it may itself be an arrow
// or a nested conditional); `else` recurses through `conditional` rather than
// `expression`, which is what makes `a ? b : c ? d : e` read right-
// associatively as `a ? b : (c ? d : e)`.
//
// By the time control reaches here, `parsePostfix` has already resolved every
// `?` that belongs to `cond` — including a genuine trailing propagation, which
// stays consumed as `TryExpr` (`f()? ? a : b` reads `f()?` as the condition,
// its own `?` never reaching this function at all) — so a bare `acceptTok`
// here is correct with no further disambiguation.
fn parseConditional(p: Parser): int {
  let cond = parseBinary(p, 1)
  if (!acceptTok(p, Kind.Question)) {
    return cond
  }
  let thenExpr = parseExpr(p)
  expect(p, Kind.Colon)
  let elseExpr = parseConditional(p)
  return mkNode(p, Tag.CondExpr, 0, [cond, thenExpr, elseExpr])
}
