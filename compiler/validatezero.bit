// Self-host: §13.4 zero-value validation (#2573, split out as its own sibling
// file — validateiface.bit was 879 lines against the 800-line limit). This is
// the E0083/#1914 class-typed-field-has-no-zero-value family plus the
// composite-literal slot checks it shares a boundary with; validateiface.bit
// keeps interface satisfaction/assignment and the §12.9 conversions.

// ---- §13.4: a class-typed field has no zero value (E0083, #1914) ----------
//
// SPEC §13.4 used to promise that every omitted field "takes its zero value",
// and for a scalar, a string, a slice or a map that is exactly what the zeroed
// `gc_alloc` hands back. It is NOT true of a field whose own type is a class:
// structs are references, so zero bits there is a NULL, and reading through it
// segfaults with no diagnostic, arbitrarily far from the literal that made it.
// Worse than the crash, an omitted field left holding a plausible address is a
// false GC root — `gcMarkConservative` follows it and decodes a header that is
// not one.
//
// Three fixes were possible and the operator chose the third:
//
//   1. fill one level (what shipped first) — still leaves a reachable SIGSEGV
//      two structs deep, because the fill's own `zeroValue` does not recurse;
//   2. fill every level, truncated at a type-graph cycle — the cycle still
//      hands back a null, so the guarantee keeps a hole, and every such literal
//      allocates a whole subtree it did not ask for;
//   3. refuse. A class type with a class-typed field HAS NO ZERO VALUE and
//      cannot be default-constructed. Rust takes the same position.
//
// So there is one rule and no fallback. The cost is bounded and was measured
// before the change: 7 sites in the whole tree, all in `compiler/`, none in the
// 46 examples and none of the initializer-less form.
//
// Arrays and slices are deliberately unaffected — an array is inline storage
// and a slice's zero value is a real empty slice, so their zero bits are valid.
// `[N]Struct` cannot arise at all (E0072 rejects a reference-typed array
// element), and `[]Struct(n)`'s null elements are a different defect with a
// different fix (#1924), not this rule.
//
// Both surfaces below are permissive on anything they cannot resolve — an
// unresolved type or a missing declaration reports nothing, per the validator's
// standing rule that inventing an error breaks a working build.

// The name of enum `enumTy`'s declaration-order FIRST (tag-0) variant, but
// ONLY when it carries a payload — the case with no zero value (#4182). §13.4
// materializes an omitted binding as the all-zero representation, which for a
// boxed enum (§14.7: any variant with a payload is `{tag, payloadPtr}`) is
// discriminant 0 with a null payload; reading that payload is the same null
// dereference a class-typed field already gives E0083 for, just reached
// through variant order instead of field order. Returns "" — meaning "has a
// zero value" — for a C-like enum (no variant anywhere carries a payload, so
// tag 0 is a real value), for a variant-0-without-payload boxed enum (`enum
// Shape { Unit, Circle(f64) }`, whose zero value is a real `{tag:0,nil}`
// object once `zeroValue` builds it — see lowerlit.bit), and permissively for
// an unresolved declaration, matching every other surface in this file.
fn enumZeroVariantName(c: Checker, enumTy: int): string {
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return ""
  }
  let vs = enumVariantNodes(oc, decl)
  if (len(vs) == 0) {
    return ""
  }
  let vk = kidsOf(oc.tree, vs[0]) // [name, payload_or_none]
  if (vk[1] == 0) {
    return ""
  }
  let vn = getNode(oc.tree, vk[0])
  return oc.source[vn.span.start:vn.span.end]
}

// Whether a value of type `fty` has no zero value at all: a class type (any
// class-typed field disqualifies its OWN container, so the field itself needs
// no recursive check — being class-kind is sufficient), or a boxed enum whose
// tag-0 variant carries a payload (`enumZeroVariantName` above). Shared by the
// checker (this file) and by lowering's own runtime-panic guard
// (`lowerslicefill.bit`'s `typeHasNoZeroValue`), which cannot reuse
// `vMissingStructFields` because it runs off an `FnCtx`, before this file's
// `Checker` is in scope.
fn vFieldHasNoZeroValue(c: Checker, fty: int): bool {
  let fk = c.ctx.types[fty].kind
  if (fk == TypeKind.Struct) {
    return true
  }
  if (fk == TypeKind.Enum) {
    return enumZeroVariantName(c, fty) != ""
  }
  return false
}

// The names of `structTy`'s fields with no zero value (a class-typed field, or
// an enum-typed field whose own tag-0 variant carries a payload, #4182), in
// declaration order, joined as `'a', 'b'` for a message. `named` is the
// literal's initializer list; a field it names is not missing. Pass an empty
// list to get every such field, which is what the initializer-less form needs.
fn vMissingStructFields(c: Checker, structTy: int, named: []int): string {
  let decl = structDeclOf(c, structTy)
  if (decl == 0) {
    return ""
  }
  let oc = typeOwner(c, structTy)
  let missing = ""
  for f of structFieldNodes(oc, decl) {
    let fldNode = getNode(oc.tree, kidsOf(oc.tree, f)[0])
    let name = oc.source[fldNode.span.start:fldNode.span.end]
    // BY NAME against the instantiation, not the declaration node: a generic
    // `Box<Inner>` must see `Inner` where the decl says `T`. `structFieldLookup`
    // is keyed on the instantiated type id, so it already carries the
    // substitution `typeFromNodeIn` would have to redo.
    let fty = structFieldLookup(c, "${structTy}." + name)
    if (fty == 0 || !vFieldHasNoZeroValue(c, fty)) {
      continue
    }
    if (vLitNamesField(c, named, name)) {
      continue
    }
    if (missing != "") {
      missing = missing + ", "
    }
    missing = missing + "'" + name + "'"
  }
  return missing
}

// ---- E0057 a class literal naming a field the class does not have --------
//
// #2230. `User{ nmae: "ana" }` exited `bit check` 0, passed `bit lint`, and then
// failed at LOWERING with "cannot lower 1 function(s)" — no file, no line, no
// caret, no mention of the key. Reading the same misspelling (`u.emial`) has
// always been a properly spanned E0057, so the diagnostic and the field lookup
// both existed; only the literal path consulted neither.
//
// Judged against the DECLARATION's field nodes, not `structFields`. The member
// tables record a field whose own type did not resolve with type 0, which a
// lookup cannot tell apart from "no such field" — the read that invented 13
// E0057s across stdlib/crypto (see vMember). Field NAMES come off the decl and
// need no type to resolve, so this judges the one thing that is always known.
//
// Permissive when there is no reachable declaration (`structDeclOf == 0`): a
// single-file check of a multi-file module cannot see the decl, and inventing an
// error there breaks a working build. A declaration WITH no fields still judges
// — `Empty{ x: 1 }` names a field `Empty` does not have.
//
// A generic instantiation resolves to its base template's decl (`typeName`
// renders `Box<i64>` as `Box`), and substitution never renames a field, so the
// name set is the right one for every instance.
fn vLitUnknownField(c: Checker, target: int, nameNode: int, fname: string) {
  let decl = structDeclOf(c, target)
  if (decl == 0) {
    return
  }
  let oc = typeOwner(c, target)
  let names = []string(0)
  for f of structFieldNodes(oc, decl) {
    let fldNode = getNode(oc.tree, kidsOf(oc.tree, f)[0])
    let n = oc.source[fldNode.span.start:fldNode.span.end]
    if (n == fname) {
      return
    }
    names = append(names, n)
  }
  let tn = typeName(c.ctx, target)
  let hint = vClosestFieldName(names, fname)
  if (hint == "") {
    reportNoHint(
      c.diags, ecUnknownMember, vSpan(c, nameNode),
      "no field '${fname}' on '${tn}'",
    )
    return
  }
  report(
    c.diags, ecUnknownMember, vSpan(c, nameNode),
    "no field '${fname}' on '${tn}'", "did you mean '${hint}'?",
  )
}

// The name in `names` closest to `wanted`, or "" when none is within edit
// distance 3 — the field-side twin of `vClosestMethodName`, sharing its
// threshold and its first-visited tie-break so a typo in a literal and a typo in
// a read suggest by the same rule.
fn vClosestFieldName(names: []string, wanted: string): string {
  let best = ""
  let bestDist = 64 + 1
  for n of names {
    let d = vEditDistance(n, wanted)
    if (d < bestDist) {
      bestDist = d
      best = n
    }
  }
  if (bestDist > 3) {
    return ""
  }
  return best
}

// Whether a composite literal's initializer list names field `name`.
fn vLitNamesField(c: Checker, inits: []int, name: string): bool {
  for it of inits {
    if (getNode(c.tree, it).tag != Tag.FieldInit) {
      continue
    }
    let fldNode = getNode(c.tree, kidsOf(c.tree, it)[0])
    if (c.source[fldNode.span.start:fldNode.span.end] == name) {
      return true
    }
  }
  return false
}

// Surface (1): `Outer{ a: 1 }` leaving out a class-typed `b`.
fn vCompositeNoOmitted(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, init]
  let target = typeFromNode(c, kids[0])
  if (target == 0 || c.ctx.types[target].kind != TypeKind.Struct) {
    return
  }
  let missing = vMissingStructFields(c, target, kidsOf(c.tree, kids[1]))
  if (missing == "") {
    return
  }
  // Every missing field in ONE diagnostic, not one each: they share a span and
  // a cause, and reporting them separately means fixing the literal N times.
  report(
    c.diags, ecNoZeroValue, vSpan(c, node),
    "'${typeName(c.ctx, target)}' literal omits field(s) with no zero value: ${missing}",
    "a class-typed field is a reference and would be null; a payload-carrying enum's zero tag names a variant that has no payload to give it — give each one a value (§13.4)",
  )
}

// E0086 (§10.1): a `let`/`const` binding with NEITHER an initializer NOR a type
// annotation has no zero value to fall back on at all — §10.1 states the rule
// this should already have failed on: "A `let` without an initializer is set
// to the zero value of its declared type; the type annotation is then
// required." First free code above E0085; E0200+ is the lint registry
// (spec/LINT.md). Declared here, beside the rule that uses it, rather than in
// validate.bit's registry, following validateentry.bit's E0085 (#2236).
const ecBindingNeedsType = 86

// Surface (2): `let o: Outer` with no initializer at all. Not reachable from
// vCompositeNoOmitted — there is no literal to inspect — so it hangs off the
// binding instead, and it is the case `lowerctrl.bit`'s zero-value path used to
// answer with a null.
//
// Surface (2b), #2147: a binding with no initializer AND no annotation is
// checked first and returns, because it also carries no type for surface (2)'s
// class-only check below to run against. `let v, ok = m["a"]` is why this
// earns its own diagnostic instead of falling through as an unresolved type:
// §10.1's grammar makes it TWO independent bindings — `v` (no type, no
// initializer) and `ok = m["a"]` (a plain, well-typed one) — not the
// two-result map read it looks like. This used to type-check clean and hand
// lowering a function it could not emit: "cannot lower 1 function(s)", naming
// neither the file nor the line. The hint names the form §12.6 actually
// specifies, since this is the Go spelling and will be typed constantly by
// anyone arriving from that language.
fn vBindingNoZeroValue(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pat, annotation, init]
  if (len(kids) < 3) {
    return
  }
  if (kids[1] == 0 && kids[2] == 0 && getNode(c.tree, kids[0]).tag == Tag.Ident) {
    let pn = getNode(c.tree, kids[0])
    let name = c.source[pn.span.start:pn.span.end]
    report(
      c.diags, ecBindingNeedsType, vSpan(c, kids[0]),
      "'${name}' has no initializer, so its type cannot be inferred; a `let` binding without an initializer requires a type annotation (§10.1)",
      "give it a type, e.g. `let ${name}: <type>`; a two-result map read is `let (v, ok) = m[k]` (§12.6), not `let v, ok = m[k]`",
    )
    return
  }
  if (kids[1] == 0 || kids[2] != 0) {
    return
  }
  let ty = typeFromNode(c, kids[1])
  if (ty == 0) {
    return
  }
  if (c.ctx.types[ty].kind == TypeKind.Enum) {
    vBindingEnumNoZeroValue(c, node, ty)
    return
  }
  vBindingStructNoZeroValue(c, node, ty)
}

// The Struct half of surface (2), split from `vBindingNoZeroValue` above to
// keep it under E0204's complexity ceiling.
fn vBindingStructNoZeroValue(c: Checker, node: int, ty: int) {
  if (c.ctx.types[ty].kind != TypeKind.Struct) {
    return
  }
  let missing = vMissingStructFields(c, ty, []int(0))
  if (missing == "") {
    return
  }
  report(
    c.diags, ecNoZeroValue, vSpan(c, node),
    "'${typeName(c.ctx, ty)}' cannot be default-constructed: field(s) with no zero value: ${missing}",
    "give the binding an initializer naming them, e.g. `= ${typeName(c.ctx, ty)}{ ... }` (§13.4)",
  )
}

// Surface (2) for an ENUM binding — `let o: Option<T>` with no initializer
// (#4182): the type itself has no zero value, rather than a field of it, so
// the diagnostic names the offending VARIANT instead of a field list. Split
// from `vBindingNoZeroValue` to keep that function under E0204's complexity
// ceiling.
fn vBindingEnumNoZeroValue(c: Checker, node: int, ty: int) {
  let variant = enumZeroVariantName(c, ty)
  if (variant == "") {
    return
  }
  report(
    c.diags, ecNoZeroValue, vSpan(c, node),
    "'${typeName(c.ctx, ty)}' cannot be default-constructed: its zero tag names '${variant}', which carries a payload and has no zero value",
    "give the binding an initializer, e.g. `= ${typeName(c.ctx, ty)}.<variant>(...)` (§13.4)",
  )
}

// ---- constructor-call arguments moved to validatector.bit (#4322) ---------
//
// The `[]T(...)`, `map<K,V>(...)`, `chan<T>(...)` and `[N]T(...)` arity and
// argument-type validators moved verbatim into compiler/validatector.bit.
// This file was 790 lines against the hard 800-line E0200 ceiling. Same
// module, same imports, no resolution change.
// Surface (3): `[]S(n)`, whose whole meaning is "n zero values of S" (§12.9), so
// an element type with no zero value cannot be filled — and unlike the literal
// forms there is no longer spelling to fall back to. `S` is a class with a
// class-typed field, or (#4182) a boxed enum whose tag-0 variant carries a
// payload.
//
// REPORTED ONLY WHEN `n` IS A CONSTANT GREATER THAN ZERO, which is the whole
// subtlety here. `[]T(0)` asks for NO zero values, so it asks for nothing that
// cannot be given, and it is the idiomatic empty slice — `[]CstEntry(0)` in the
// JSON corpus is exactly that shape. A blanket rejection failed five golden
// cases on code that was never unsafe.
//
// A non-constant `n` cannot be decided here, so it is not decided here: the
// lowering emits a panic in the fill loop's body, which is unreachable when `n`
// is zero and deterministic when it is not (`fillZeroElems`,
// `typeHasNoZeroValue`, lowerslicefill.bit). Static where the answer is
// static, dynamic only where it has to be — the array-bounds split, not a
// second opinion about the same question.
//
// The callee-tag test mirrors `lowerCall`'s dispatch: a `Tag.SliceType` in call
// position is the length-sized allocation. `[]byte(s)` reaches here too and is
// filtered out by the element kind, being a prim.
fn vSliceAllocNoZeroValue(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) < 3 || getNode(c.tree, kids[0]).tag != Tag.SliceType) {
    return
  }
  let ty = typeFromNode(c, kids[0])
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.Slice) {
    return
  }
  let elem = c.ctx.types[ty].elem
  if (elem == 0) {
    return
  }
  let ek = c.ctx.types[elem].kind
  if (ek != TypeKind.Struct && ek != TypeKind.Enum) {
    return
  }
  vSliceAllocConstLen(c, node, kids, ty, elem)
}

// The constant-length half of `vSliceAllocNoZeroValue` above, split out to
// keep it under E0204's complexity ceiling: extracts `n` from the call's
// argument list and, only when it folds to a constant above zero, hands off
// to the diagnostic body.
fn vSliceAllocConstLen(c: Checker, node: int, kids: []int, ty: int, elem: int) {
  let args = kidsOf(c.tree, kids[2])
  if (len(args) == 0) {
    return
  }
  let n = args[0]
  if (getNode(c.tree, n).tag == Tag.Arg) {
    n = kidsOf(c.tree, n)[0]
  }
  let cv = vConstEval(c, n, 0)
  if (!cv.ok || cv.kind != vcInt || cv.ival <= 0) {
    return
  }
  vSliceAllocReportNoZero(c, node, ty, elem, cv.ival)
}

// The diagnostic body for `vSliceAllocNoZeroValue` above, split out to keep
// that function under E0204's complexity ceiling: an enum element names the
// offending variant, a struct element names the offending field(s) — the same
// split `vBindingNoZeroValue`/`vBindingEnumNoZeroValue` makes for a binding.
fn vSliceAllocReportNoZero(c: Checker, node: int, ty: int, elem: int, n: int) {
  if (c.ctx.types[elem].kind == TypeKind.Enum) {
    let variant = enumZeroVariantName(c, elem)
    if (variant == "") {
      return
    }
    report(
      c.diags, ecNoZeroValue, vSpan(c, node),
      "'${typeName(c.ctx, elem)}' has no zero value, so '${typeName(c.ctx, ty)}(${n})' cannot fill its elements: its zero tag names '${variant}', which carries a payload",
      "build the slice from values instead, e.g. `${typeName(c.ctx, ty)}{ ... }`, or start from `${typeName(
        c.ctx,
        ty,
      )}(0)` and append (§13.4)",
    )
    return
  }
  let missing = vMissingStructFields(c, elem, []int(0))
  if (missing == "") {
    return
  }
  report(
    c.diags, ecNoZeroValue, vSpan(c, node),
    "'${typeName(c.ctx, elem)}' has no zero value, so '${typeName(c.ctx, ty)}(${n})' cannot fill its elements: field(s) with no zero value: ${missing}",
    "build the slice from values instead, e.g. `${typeName(c.ctx, ty)}{ ... }`, or start from `${typeName(
      c.ctx,
      ty,
    )}(0)` and append (§13.4)",
  )
}

// ---- composite literals `S{...}` / `map<K,V>{...}` / `[]T{...}` / `[N]T{...}`
// Each field, entry and element against its declared slot type, plus the array
// length rule. The typed `[N]T{...}` is the ONLY form SPEC.md admits for
// constructing an array value (§11.2, §12.3), and its element count must equal
// N (§12.3: "length must match").
//
// Last cell of the #1470 class. Unchecked, `let a: [2]f32 = [2]f32{4.5}` built
// a 2-element array from one initializer and the second slot read uninitialized
// heap — the same memory-safety shape as the bare-list length mismatch, just
// reached through the form that IS legal.
//
// The slot types are the same #1470 hole as the annotated binding, reached
// through a different syntax: before this, `S{ v: "s" }` for an `f32` field and
// `map<i32,i32>{4.5: 1}` were both accepted by the self-hosted compiler and
// rejected by the seed. Everything routes through vExpectExpr so the element of
// a composite gets the identical treatment a binding's initializer gets.
//
// #3061 FIX: an interface-typed slot used to route to `vIfaceStore` alone
// (`vExpectExprNonIface` skips an Interface-kind target, so the pair asked
// only vIfaceStore's narrow "cannot store" scalar question, never the general
// satisfies one — `Wallet{ holder: Cash{...} }` for `holder: Payer` built
// rc=0). Every slot now goes through `vExpectExpr`, which answers both
// (identical wording for the narrow case, via vMismatch), so vIfaceStore is no
// longer called from here.
//
// The E0050 length rule is whole-literal and lands BEFORE any element, matching
// checkCompositeLit: it reports the count, then calls checkSeqInit.
fn vCompositeArrayLen(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, init]
  let target = typeFromNode(c, kids[0])
  if (target == 0) {
    return
  }
  if (c.ctx.types[target].kind != TypeKind.Array) {
    return
  }
  // Only the ARRAY form has a length rule; a `[]T{...}` slice literal has no
  // fixed len. Seed's exact text and span.
  let want = c.ctx.types[target].arrayLen
  let got = len(kidsOf(c.tree, kids[1]))
  if (got != want) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "array literal has ${got} element(s), expected ${want}",
    )
  }
}

// One SLOT of the composite literal `lit`: `item` is a FieldInit / MapEntry /
// Arg, and `slot` picks a map entry's value (1) from its key (0) — every other
// form has only slot 0.
//
// Per-slot, not per-literal, so the caller can interleave each judgement with
// the descent into that slot's own expression. The seed checks a slot's
// expression (reporting everything nested) and only THEN its assignability, so
// a whole-literal pre-order pass emits the identical diagnostics in the wrong
// sequence (#1489).
//
// Class-literal FIELD types were the last declared-type slot in the language to
// get assignability checking (#1476, closing the #1470 class). It was held out
// because the recompute it needs panicked "index out of range" on all 10 corpus
// files reaching stdlib/http; that was a genuine cross-module bug in the
// match-scrutinee type-argument recovery this checker used to lean on, not a
// reason to skip the check, and it was fixed at the source rather than avoided
// here.
fn vCompositeSlot(c: Checker, lit: int, item: int, slot: int) {
  let kids = kidsOf(c.tree, lit) // [type, init]
  let target = typeFromNode(c, kids[0])
  if (target == 0) {
    return
  }
  let tk = c.ctx.types[target].kind
  if (tk == TypeKind.Struct) {
    if (slot != 0 || getNode(c.tree, item).tag != Tag.FieldInit) {
      return
    }
    let fk = kidsOf(c.tree, item) // [name, expr]
    let fnn = getNode(c.tree, fk[0])
    let fname = c.source[fnn.span.start:fnn.span.end]
    vLitUnknownField(c, target, fk[0], fname)
    // SPEC 10.5 forbids naming a foreign class's unexported field in a
    // literal exactly as it forbids reading one (#4631). Same judgement and
    // same wording as the read path — `vForeignFieldAccess`,
    // validatemember.bit.
    vForeignFieldAccess(c, target, fname, fk[0])
    let want = structFieldLookup(c, "${target}." + fname)
    vExpectExpr(c, fk[1], want)
    return
  }
  if (tk == TypeKind.Map) {
    if (getNode(c.tree, item).tag != Tag.MapEntry) {
      return
    }
    let mk = kidsOf(c.tree, item) // [key, val]
    let want = c.ctx.types[target].mapKey
    let e = mk[0]
    if (slot == 1) {
      want = c.ctx.types[target].mapVal
      e = mk[1]
    }
    vExpectExpr(c, e, want)
    return
  }
  if (slot != 0 || (tk != TypeKind.Slice && tk != TypeKind.Array)) {
    return
  }
  let elem = c.ctx.types[target].elem
  let e = item
  if (getNode(c.tree, e).tag == Tag.Arg) {
    e = kidsOf(c.tree, e)[0]
  }
  vExpectExpr(c, e, elem)
}
