// compiler/pmcliremove.bit — `bit remove` (#1736), split off
// compiler/pmcli.bit under the 800-line limit (#2967 — pmcli.bit crossed it
// again after #2244 landed dependency-spec forms). Same module, sibling
// file: this reuses pmcli.bit's `std/json` import (`cstDeleteKey`, `cstGet`,
// `cstParse`, `cstPrint`) and its shared helpers (`pmIsHelpFlag`,
// `parseDirFlag`) unqualified — an import is per-MODULE, not per-file, so
// re-importing any of those names here would be `E0042 already declared in
// this scope`.

// ---- `bit remove` (#1736) ----------------------------------------------

// `bit remove <gitHost/owner/repo | name> [--dir <path>]`. Returns the
// process exit code: 2 on a usage error, 1 if the named dependency doesn't
// exist (or the write fails), 0 on success. Accepts either the bare
// dependency name (the key under `bit.json`'s `dependencies`) or a full
// `gitHost/owner/repo[@ref]` spec — only the trailing path segment (the repo
// name, which is also the key `bit add` stores it under) is ever used, so
// both spellings resolve to the same lookup.
fn removeCmd(a: []string): int {
  if (len(a) < 3) {
    eprint("usage: bit remove <name> [--dir <path>]\n")
    return 2
  }
  // #2267: `--help`/`-h` in the name position must print usage, not be
  // looked up as a dependency name.
  if (pmIsHelpFlag(a[2])) {
    print("usage: bit remove <name> [--dir <path>]\n")
    return 0
  }
  // #2107: as in `addCmd` — a flag here would be looked up as a dependency.
  if (cliRejectFlagOperand("remove", a[2], "usage: bit remove <name> [--dir <path>]\n")) {
    return 2
  }
  let name = removeNameOf(a[2])
  let (projectDir, badArg, hasBadArg) = parseDirFlag(a, 3)
  if (hasBadArg) {
    eprint("bit remove: unexpected argument '${badArg}'\n")
    return 2
  }

  removeDependency(projectDir, name) catch e {
    eprint("bit remove: ${e.message()}\n")
    return 1
  }

  print("bit remove: ${name}\n")
  return 0
}

// The `bit.json` dependency key for a `bit remove` operand: the trailing
// `/`-separated segment with any `@ref` suffix stripped, so `bit remove
// github.com/byteink/quicwire@v1.4.2` and `bit remove quicwire` name the
// same entry `bit add` stored the dependency under (`addDependency` above
// always keys `bit.json`/`bit.lock` by `repo`, never the full spec).
fn removeNameOf(operand: string): string {
  let s = operand
  let at = lastIndexByte(s, '@')
  if (at >= 0) {
    s = s[0:at]
  }
  let slash = lastIndexByte(s, '/')
  if (slash >= 0) {
    s = s[slash + 1:len(s)]
  }
  return s
}

// Deletes `name`'s entry from `<projectDir>/bit.json`'s `dependencies` object
// through the CST edit layer (every other byte of the file survives
// untouched) and drops its entry from `bit.lock`. Fails, rather than a silent
// no-op, when `name` is not present in `bit.json` — the same "bit.json is the
// source of truth" contract `rewriteManifest` follows for `bit add`. Does
// NOT touch the on-disk `~/.bit/pkg` cache; cache pruning is a separate
// concern (#1736's own scope note).
export fn removeDependency(projectDir: string, name: string): ()! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit remove: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let root = cstParse(src)?
  match (cstGet(root, ["dependencies", name])) {
    Some(_) => {}
    None => fail newError("no dependency named '${name}' in bit.json")
  }
  let updated = cstDeleteKey(root, ["dependencies", name])?
  writeFile(path, cstPrint(updated))?

  // bit.json first here, the reverse of addDependency's bit.lock-first order
  // — deliberately, not an oversight. addDependency writes bit.lock first
  // because the risk it guards against is bit.json claiming a dependency
  // bit.lock never recorded. That risk doesn't exist in this direction: if
  // this writeLock call fails after the bit.json delete above already
  // succeeded, bit.lock is left with one HARMLESS extra entry for a
  // dependency bit.json no longer declares — never a dependency bit.json
  // claims but bit.lock lacks. The invariant addDependency's ordering
  // protects is preserved either way; only the failure mode's shape differs.
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  writeLock(lockPath, removeLockEntry(entries, name))?
}

// `entries` without the one named `name`, if present — a name absent from
// `bit.lock` (e.g. a dependency declared in `bit.json` but never locked) is
// not an error here: `bit.json` is already confirmed to have had the entry by
// `removeDependency`'s caller, and `bit.lock` is fully machine-owned, so
// there is nothing to remove is a legitimate, silent outcome for THIS file.
fn removeLockEntry(entries: []LockEntry, name: string): []LockEntry {
  let out = []LockEntry(0)
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name != name) {
      out = append(out, entries[i])
    }
    i = i + 1
  }
  return out
}
