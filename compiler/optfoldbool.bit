// `band`/`bor` on `bool` for optfold.bit's sweep and identity pass
// (#7243). Same module. `selectShortCircuits` (optselect.bit) turns a
// value-context `||`/`&&` into one of these after the fold that used to
// resolve a constant operand's `br`, so `x > 0 && false` reached codegen as
// `band %c, false` until these rules existed.

fn isBoolPrim(p: int): bool {
  return p == 10
}

// Both operands known; `p` is the result's prim.
fn foldBoolBitwise(p: int, op: Op, lhs: ConstVal, rhs: ConstVal): ConstVal {
  if (!isBoolPrim(p) || !lhs.isBool || !rhs.isBool) {
    return noConst()
  }
  if (op == Op.BAnd) {
    return boolConst(lhs.bval && rhs.bval)
  }
  if (op == Op.BOr) {
    return boolConst(lhs.bval || rhs.bval)
  }
  return noConst()
}

// One operand known: `false` absorbs a `band` and `true` a `bor`; the other
// value of each leaves the unknown operand. `p` is the result's prim.
fn identBool(p: int, known: []ConstVal, f: IrFunc, ins: IrInstr): IdentFold {
  let op = ins.op
  if (!isBoolPrim(p) || (op != Op.BAnd && op != Op.BOr)) {
    return noIdent()
  }
  let x = ins.lhs
  let c = known[ins.rhs]
  if (!c.known) {
    x = ins.rhs
    c = known[ins.lhs]
  }
  if (!c.known || !c.isBool || f.instrs[x].ty != ins.ty) {
    return noIdent()
  }
  if (c.bval == (op == Op.BOr)) {
    return constIdent(c)
  }
  return copyIdent(x)
}
