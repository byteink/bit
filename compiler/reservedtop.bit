// compiler/reservedtop.bit — E0314: a top-level name that starts with `__` is
// the compiler's, never the user's (SPEC §14.3, #7564).
//
// Synthesized code is written in terms of names it binds itself: `__Json`
// (std/json's `Json`, `synthJsonName`), `__jsonDecode_C`, `__sql_row_C` and so
// on. A user declaration of the same name would collide with them (E0042, the
// failure #7558 removed for `Json`), so the whole `__` prefix is reserved at the
// top level, the way `isSynthMemberName` (synthtext.bit) reserves it for a
// member. A member is a different question: the documented `__field`,
// `__sameValue`, `__valueHash` and `__snapshot` are members of a class and stay
// legal, as does anything inside a function body.
//
// WHAT IS REFUSED: a top-level `fn`, `class`, `interface`, `enum`, `type`,
// `let` and `const` whose name starts with `__`, and an import alias that does
// (`import { a as __a }`). WHAT IS NOT: an `extern fn` (it names a symbol of the
// C library or the OS, `__error`, `__ulock_wait`) and a module under the
// standard library root, judged by its directory and not by how it was loaded,
// which declares the helpers synthesized code calls (std/sql's `__tables`,
// `__sql_value_text`).

// E0314 (SPEC §14.3): a top-level declaration or an import alias named `__...`.
const ecReservedTopName = 314

// True iff `tag` is a declaration whose first child is its name.
fn isNamedTypeDeclTag(tag: Tag): bool {
  return tag == Tag.TypeAlias ||
    tag == Tag.StructDecl ||
    tag == Tag.InterfaceDecl ||
    tag == Tag.EnumDecl
}

// The name nodes of pattern `pat`: itself, or the names inside a tuple pattern.
fn patternNameNodes(tree: Tree, pat: int): []int {
  if (getNode(tree, pat).tag != Tag.TuplePat) {
    return [pat]
  }
  let out = []int(0)
  for s of kidsOf(tree, pat) {
    for n of patternNameNodes(tree, s) {
      out = append(out, n)
    }
  }
  return out
}

// The names `let`/`const` declaration `d` binds.
fn bindingNameNodes(tree: Tree, d: int): []int {
  let out = []int(0)
  for b of kidsOf(tree, d) {
    for n of patternNameNodes(tree, kidsOf(tree, b)[0]) {
      out = append(out, n)
    }
  }
  return out
}

// The name nodes top-level node `d0` declares, seeing through `export`: none
// for a method, an `extern fn` or anything that is not a declaration.
fn topDeclNameNodes(tree: Tree, d0: int): []int {
  let d = d0
  if (d != 0 && getNode(tree, d).tag == Tag.Export) {
    d = kidsOf(tree, d)[0]
  }
  if (d == 0) {
    return []int(0)
  }
  let tag = getNode(tree, d).tag
  if (isNamedTypeDeclTag(tag)) {
    return [kidsOf(tree, d)[0]]
  }
  if (tag == Tag.FuncDecl && kidsOf(tree, d)[0] == 0) {
    return [kidsOf(tree, d)[1]]
  }
  if (tag == Tag.LetDecl || tag == Tag.ConstDecl) {
    return bindingNameNodes(tree, d)
  }
  return []int(0)
}

// The alias nodes of `import { a as b }` declaration `d`: the `b`s.
fn importAliasNodes(tree: Tree, d: int): []int {
  let out = []int(0)
  if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
    return out
  }
  let group = kidsOf(tree, d)[0]
  if (getNode(tree, group).tag != Tag.ImportGroup) {
    return out
  }
  for item of kidsOf(tree, group) {
    let alias = kidsOf(tree, item)[1]
    if (alias != 0) {
      out = append(out, alias)
    }
  }
  return out
}

fn reportReservedTopName(tree: Tree, source: string, diags: Diagnostics, node: int) {
  let name = identText(tree, source, node)
  if (!isSynthMemberName(name)) {
    return
  }
  report(
    diags, ecReservedTopName, getNode(tree, node).span,
    "'${name}' is reserved: a top-level name that starts with '__' belongs to the compiler's synthesized code",
    "rename it without the '__' prefix (SPEC §14.3); only the members '__field', '__sameValue', '__valueHash' and '__snapshot' of a class are written with one",
  )
}

// `p` as an absolute, lexically resolved path: a relative one is anchored at
// the working directory (`getcwd` yields the physical path), so
// `bit check stdlib/sql` and a `BIT_STDLIB` or install-prefix root agree on one
// spelling whichever of them was written relative. When the working directory
// cannot be read `p` stays as `pathResolve` leaves it; "" stays "".
fn absResolved(p: string): string {
  if (p == "") {
    return ""
  }
  if (p[0] == '/') {
    return pathResolve(p)
  }
  let here = cwd() catch _ {
    return pathResolve(p)
  }
  return pathJoinResolve(here, p)
}

// True iff module `m` lives under the standard library root `stdRoot` (already
// `absResolved`). Judged on what the module IS (its directory), never on the
// import that reached it: a std module is exempt when it is the root of
// `bit check stdlib/sql` as much as when `std/sql` imports it.
fn moduleUnderRoot(m: SrcModule, stdRoot: string): bool {
  if (stdRoot == "") {
    return false
  }
  let dir = absResolved(m.dir)
  return dir == stdRoot || (len(dir) > len(stdRoot) && dir[0:len(stdRoot) + 1] == stdRoot + "/")
}

// Reports every top-level declaration and import alias of module `m` that
// starts with `__`, unless `m` is part of the standard library.
fn vReservedTopName(m: SrcModule, stdRoot: string, diags: Diagnostics) {
  if (moduleUnderRoot(m, stdRoot)) {
    return
  }
  for d of kidsOf(m.tree, m.tree.root) {
    for n of topDeclNameNodes(m.tree, d) {
      reportReservedTopName(m.tree, m.source, diags, n)
    }
    for n of importAliasNodes(m.tree, d) {
      reportReservedTopName(m.tree, m.source, diags, n)
    }
  }
}
