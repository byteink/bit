// compiler/pmzclicheck.bit — the `bit up`/`bit update` half of
// compiler/pmclicheck.bit's checks (#2474, split off compiler/pmclicheck.bit
// under the 800-line limit): pmCliBuildProjectDeps, pmAdvanceFixture,
// checkPmCliUpStaleLock, checkPmCliUpSingleName and
// checkPmCliUpdateAliasMatchesUp — self-contained (grepped: none of these
// five is called from anywhere else in pmclicheck.bit except checkPmCli()'s
// own driver, a forward function call into this file; #3211 removed the
// sixth, pmCliDeadUpResults, once its only call sites — all trailing fillers
// after an unconditional panic — became dead by E0212). Named `pmzclicheck`
// rather than `pmclichecktail` because the moved code calls `runGit`
// (compiler/pmfetchtail.bit) and `revParseHead`/`defaultGitBin`
// (compiler/pmfetch.bit) directly — `pmclichecktail.bit` would sort before
// both, same as `pmclicheck.bit` already does today, but `defaultGitBin` is
// a CONST, and a forward reference to a module const types `.invalid` and
// silently miscompiles. Sorting after every other `pm*` file (as `pmz.bit`
// already does, for the identical reason against its own `vanityTimeoutMs`
// read) makes every one of those reads a backward reference instead.
// ---- `bit up`/`bit update` checks (#1735) ------------------------------

// A project directory whose `bit.json` `dependencies` object is exactly
// `depsBody` (already indented, trailing newline included) — the custom-deps
// counterpart to `pmCliBuildProject` above, needed here so a test can name
// more than one dependency (or none) rather than always the fixed
// `existing`+`fixture` shape `bit add`'s own checks use.
fn pmCliBuildProjectDeps(root: string, depsBody: string): PmCliProject {
  let dir = root + "/project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + depsBody
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write project bit.json: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

// `UpCtx{..., latest: false}` for `projectDir`/`cacheRoot` — every
// `upDependencies` call in this file except `checkPmCliUpLatest`'s own
// `--latest` case wants exactly this, so this is the one place that shape
// is spelled out.
fn upCtxFor(projectDir: string, cacheRoot: string): UpCtx {
  return UpCtx{
    projectDir: projectDir, cacheRoot: cacheRoot, gitBin: defaultGitBin,
    latest: false, timeoutMs: pmCheckTimeoutMs,
  }
}

// Commits `content` to the fixture at `dir` (already `pmBuildFixture`-built),
// moving its HEAD forward — simulates an upstream branch moving between when
// a dependency was first locked and when `bit up` re-resolves it.
fn pmAdvanceFixture(dir: string, content: string, timeoutMs: int): string! {
  writeFile(dir + "/hello.txt", content)?
  let add = runGit(defaultGitBin, ["-C", dir, "add", "hello.txt"], timeoutMs)?
  if (add.timedOut || add.exitCode != 0) {
    fail newError("pmclicheck: git add (advance fixture) failed")
  }
  let commit = runGit(defaultGitBin, ["-C", dir, "commit", "--quiet", "-m", "advance"], timeoutMs)?
  if (commit.timedOut || commit.exitCode != 0) {
    fail newError("pmclicheck: git commit (advance fixture) failed")
  }
  return revParseHead(defaultGitBin, dir, timeoutMs)?
}

// `bit up` on a project whose bit.lock is stale (its recorded SHA predates
// the fixture's current HEAD) rewrites bit.lock with the fresh SHA, leaving
// bit.json byte-for-byte untouched (comments included) — the acceptance bar
// ticket #1735 names first.
fn checkPmCliUpStaleLock() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  // A known git host (SPEC §17.7, #2068), not the "local" label the direct
  // function-call fixtures elsewhere in this file use — this string is fed
  // through the real `parseSpec` (`upDependencies` -> `projectDeps`), which
  // now classifies an unrecognized first segment as a vanity name rather
  // than a direct git-host spec. The actual fetch still reaches the local
  // `file://` fixture via the pre-seeded bit.lock `url`, exactly as before;
  // only the label written into bit.json changed.
  let deps = "    // fixture dependency comment -- must survive untouched\n" +
    "    \"fixture\": \"github.com/pmclicheck/fixture@main\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read seeded bit.json: " + e.message())
  }

  let seed = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let newSha = pmAdvanceFixture(fx.dir, "advanced for up\n", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot advance fixture: " + e.message())
  }
  assert(newSha != fx.sha)

  let ctx = upCtxFor(proj.dir, cacheRoot)
  let results = upDependencies(ctx, "") catch e {
    panic("pmclicheck: upDependencies failed: " + e.message())
  }
  assert(len(results) == 1)
  assert(results[0].name == "fixture")
  assert(results[0].commit == newSha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].commit == newSha)
  assert(entries[0].url == url)

  let finalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
  }
  assert(finalBitJson == originalBitJson)
}

// `bit up <name>` restricted to one dependency touches only that dependency's
// bit.lock entry — a sibling entry (never fetched, an unrelated commit that
// would fail if `upDependency` were ever called for it) survives byte-for-
// byte.
fn checkPmCliUpSingleName() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  // A known git host, not "local" — see `checkPmCliUpStaleLock`'s comment.
  let deps = "    \"fixture\": \"github.com/pmclicheck/fixture@main\",\n" +
    "    \"other\": \"github.com/byteink/other@v1.0.0\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)

  let otherCommit = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
  let seed = [
    LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) },
    LockEntry{
      name: "other", url: "https://github.com/byteink/other.git", commit: otherCommit,
      requires: []LockRequire(0),
    },
  ]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let newSha = pmAdvanceFixture(fx.dir, "advanced for up single\n", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot advance fixture: " + e.message())
  }

  let ctx = upCtxFor(proj.dir, cacheRoot)
  let results = upDependencies(ctx, "fixture") catch e {
    panic("pmclicheck: upDependencies (single) failed: " + e.message())
  }
  assert(len(results) == 1)
  assert(results[0].name == "fixture")
  assert(results[0].commit == newSha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entries) == 2)
  let i = 0
  let sawOther = false
  let sawFixture = false
  while (i < len(entries)) {
    if (entries[i].name == "other") {
      assert(entries[i].commit == otherCommit)
      assert(entries[i].url == "https://github.com/byteink/other.git")
      sawOther = true
    }
    if (entries[i].name == "fixture") {
      assert(entries[i].commit == newSha)
      sawFixture = true
    }
    i = i + 1
  }
  assert(sawOther && sawFixture)
}

// #3584: `bit up` on a caret/tilde-constrained dependency must resolve the
// constraint against the remote's tags (`resolveAddRef`/`resolveHighestSatisfying`,
// pmcliaddref.bit -- the identical resolver `bit add` already uses, reused here
// rather than a second constraint parser) instead of handing the raw
// "^1.2.0"/"~1.2.0" string to `git ls-remote` as a literal ref name — before
// this fix, `upDependencies` failed every such dependency with
// `pmfetch: no ref '^1.2.0' in <url>`. One fixture, four tags across four
// commits (mirroring `checkPmCliAddVersionForms`'s own caret/tilde rows),
// reused under two dependency names so the two `upDependencies` calls never
// collide on the same bit.json/bit.lock key.
fn checkPmCliUpVersionConstraint() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  let tagV1 = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "v1.0.0", "-m", "v1.0.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git tag v1.0.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag v1.0.0", tagV1)
  let sha120 = pmCliCommitAndTag(fx.dir, "v1.2.0 commit", "v1.2.0")
  let sha150 = pmCliCommitAndTag(fx.dir, "v1.5.0 commit", "v1.5.0")
  let sha200 = pmCliCommitAndTag(fx.dir, "v2.0.0 commit", "v2.0.0")
  assert(isFullSha(sha120) && isFullSha(sha150) && isFullSha(sha200))

  // Caret: highest tag inside [1.2.0, 2.0.0) is v1.5.0 — v2.0.0 sits outside
  // caret's upper bound.
  let depsCaret = "    \"caretdep\": \"github.com/pmzclicheck/caretdep@^1.2.0\"\n"
  let projCaret = pmCliBuildProjectDeps(root + "/caret", depsCaret)
  let originalCaretBitJson = readFile(projCaret.bitJsonPath) catch e {
    panic("pmclicheck: cannot read seeded caret bit.json: " + e.message())
  }
  // Seeded with a non-empty `version` — exactly what `bit add` would already
  // have written (#2856) — so this exercises #3631's actual regression: a
  // plain `bit up` on a caret dependency must not wipe an already-recorded
  // `version` back to "".
  let seedCaret = [
    LockEntry{
      name: "caretdep",
      url: url,
      commit: fx.sha,
      version: "1.5.0",
      requires: []LockRequire(0),
    },
  ]
  writeLock(projCaret.dir + "/bit.lock", seedCaret) catch e {
    panic("pmclicheck: cannot seed caret bit.lock: " + e.message())
  }
  let ctxCaret = upCtxFor(projCaret.dir, cacheRoot + "/caret")
  let resultsCaret = upDependencies(ctxCaret, "") catch e {
    panic("pmclicheck: upDependencies (caret) failed: " + e.message())
  }
  assert(len(resultsCaret) == 1)
  assert(resultsCaret[0].name == "caretdep")
  assert(resultsCaret[0].ref == "^1.2.0")
  assert(resultsCaret[0].commit == sha150)
  let entriesCaret = readLock(projCaret.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read caret bit.lock: " + e.message())
  }
  assert(len(entriesCaret) == 1)
  assert(entriesCaret[0].commit == sha150)
  // #3631: the resolved version must still be recorded, never wiped to "".
  assert(entriesCaret[0].version == "1.5.0")
  // bit.json is never touched by `bit up` — the constraint stays exactly as
  // typed, never rewritten to the resolved version.
  let finalCaretBitJson = readFile(projCaret.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read caret bit.json: " + e.message())
  }
  assert(finalCaretBitJson == originalCaretBitJson)

  // Tilde: highest tag inside [1.2.0, 1.3.0) is v1.2.0 itself — v1.5.0 and
  // v2.0.0 both sit outside tilde's upper bound.
  let depsTilde = "    \"tildedep\": \"github.com/pmzclicheck/tildedep@~1.2.0\"\n"
  let projTilde = pmCliBuildProjectDeps(root + "/tilde", depsTilde)
  // Same #3631 seeding as the caret case above: a non-empty `version` already
  // recorded, which a plain `bit up` must preserve (here re-confirming the
  // same resolved tag, since tilde's highest satisfying tag is unchanged).
  let seedTilde = [
    LockEntry{
      name: "tildedep",
      url: url,
      commit: fx.sha,
      version: "1.2.0",
      requires: []LockRequire(0),
    },
  ]
  writeLock(projTilde.dir + "/bit.lock", seedTilde) catch e {
    panic("pmclicheck: cannot seed tilde bit.lock: " + e.message())
  }
  let ctxTilde = upCtxFor(projTilde.dir, cacheRoot + "/tilde")
  let resultsTilde = upDependencies(ctxTilde, "") catch e {
    panic("pmclicheck: upDependencies (tilde) failed: " + e.message())
  }
  assert(len(resultsTilde) == 1)
  assert(resultsTilde[0].name == "tildedep")
  assert(resultsTilde[0].ref == "~1.2.0")
  assert(resultsTilde[0].commit == sha120)
  let entriesTilde = readLock(projTilde.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read tilde bit.lock: " + e.message())
  }
  assert(len(entriesTilde) == 1)
  assert(entriesTilde[0].commit == sha120)
  // #3631: the resolved version must still be recorded, never wiped to "".
  assert(entriesTilde[0].version == "1.2.0")
}

// #2368: an EXACT pin never moves under plain `bit up` (its own bit.json
// constraint is single-point, so "highest satisfying" is trivially itself) —
// `--latest` is the only way to leave it, rewriting bit.json's constraint to
// `^<newest published>` and moving bit.lock past whatever ceiling the old
// constraint had. Also confirms bit.lock's `version` field (#2856) is
// populated by both paths, not left "" the way plain `bit up` alone left it
// for a caret/tilde ref before this ticket (#3631).
// Tags the fixture at `fx.dir` with v1.0.0 (unused below — its own
// resolution is exercised, not asserted, via `checkPmCliUpLatest`'s
// `upDependencies` calls), v1.2.3 and v2.0.0, returning the two commits it
// seeds into bit.lock and asserts against. Split out so the check itself
// stays under the complexity-10 ceiling (spec/LINT.md E0204) — every
// `catch` here was a decision point in the same function.
fn pmCliUpLatestFixtureShas(fx: PmFixture): (string, string) {
  let tagV1 = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "v1.0.0", "-m", "v1.0.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git tag v1.0.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag v1.0.0", tagV1)
  let sha123 = pmCliCommitAndTag(fx.dir, "v1.2.3 commit", "v1.2.3")
  let sha200 = pmCliCommitAndTag(fx.dir, "v2.0.0 commit", "v2.0.0")
  assert(isFullSha(sha123) && isFullSha(sha200))
  return sha123, sha200
}

fn checkPmCliUpLatest() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let (sha123, sha200) = pmCliUpLatestFixtureShas(fx)

  let deps = "    \"exactdep\": \"github.com/pmzclicheck/exactdep@1.2.3\"\n"
  let proj = pmCliBuildProjectDeps(root + "/exact", deps)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read seeded bit.json: " + e.message())
  }
  let seed = [LockEntry{ name: "exactdep", url: url, commit: sha123, requires: []LockRequire(0) }]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  // Plain `bit up`: the exact pin never moves, bit.json is never touched,
  // and bit.lock's `version` field lands "1.2.3" (not "" — #3631).
  let ctx = upCtxFor(proj.dir, cacheRoot)
  let plain = upDependencies(ctx, "") catch e {
    panic("pmclicheck: upDependencies (plain) failed: " + e.message())
  }
  assert(len(plain) == 1)
  assert(plain[0].commit == sha123)
  assert(plain[0].ref == "1.2.3")
  let entriesPlain = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock (plain): " + e.message())
  }
  assert(entriesPlain[0].commit == sha123)
  assert(entriesPlain[0].version == "1.2.3")
  let bitJsonAfterPlain = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json (plain): " + e.message())
  }
  assert(bitJsonAfterPlain == originalBitJson)

  // `bit up --latest`: moves PAST the exact pin's own ceiling to v2.0.0, and
  // rewrites bit.json's constraint to "^2.0.0".
  let ctxLatest = UpCtx{
    projectDir: proj.dir, cacheRoot: cacheRoot, gitBin: defaultGitBin,
    latest: true, timeoutMs: pmCheckTimeoutMs,
  }
  let latest = upDependencies(ctxLatest, "") catch e {
    panic("pmclicheck: upDependencies (latest) failed: " + e.message())
  }
  assert(len(latest) == 1)
  assert(latest[0].commit == sha200)
  assert(latest[0].ref == "^2.0.0")
  let entriesLatest = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock (latest): " + e.message())
  }
  assert(entriesLatest[0].commit == sha200)
  assert(entriesLatest[0].version == "2.0.0")
  let bitJsonAfterLatest = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json (latest): " + e.message())
  }
  assert(contains(bitJsonAfterLatest, "\"exactdep\": \"github.com/pmzclicheck/exactdep@^2.0.0\""))
}

// `bit update` is dispatched by main.bit to the exact same handler as
// `bit up` (`a[1] == "up" || a[1] == "update"` both call `upCmd(a)`, and
// `upCmd` never re-inspects `a[1]`), so the two commands are the same code
// path by construction. What remains to prove is that the shared entry point
// itself is deterministic: run it twice from byte-identical starting states
// (two independent project/cache/lock trees seeded the same way) and confirm
// both land the same resolved commit and the same bit.lock content — that is
// what "`bit update` produces identical output to `bit up`" cashes out to
// once the dispatch itself is a straight pass-through with no branch on the
// alias name.
fn checkPmCliUpdateAliasMatchesUp() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  // A known git host, not "local" — see `checkPmCliUpStaleLock`'s comment.
  let deps = "    \"fixture\": \"github.com/pmclicheck/fixture@main\"\n"

  let projA = pmCliBuildProjectDeps(root + "/a", deps)
  let seedA = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(projA.dir + "/bit.lock", seedA) catch e {
    panic("pmclicheck: cannot seed bit.lock A: " + e.message())
  }

  let projB = pmCliBuildProjectDeps(root + "/b", deps)
  let seedB = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(projB.dir + "/bit.lock", seedB) catch e {
    panic("pmclicheck: cannot seed bit.lock B: " + e.message())
  }

  // Stands in for `bit up`.
  let ctxA = upCtxFor(projA.dir, root + "/cacheA")
  let resultsUp = upDependencies(ctxA, "") catch e {
    panic("pmclicheck: upDependencies (up) failed: " + e.message())
  }
  // Stands in for `bit update` -- the identical call `upCmd` makes for the
  // alias, exercised a second time against an identical starting state.
  let ctxB = upCtxFor(projB.dir, root + "/cacheB")
  let resultsUpdate = upDependencies(ctxB, "") catch e {
    panic("pmclicheck: upDependencies (update) failed: " + e.message())
  }

  assert(len(resultsUp) == len(resultsUpdate))
  assert(resultsUp[0].name == resultsUpdate[0].name)
  assert(resultsUp[0].ref == resultsUpdate[0].ref)
  assert(resultsUp[0].url == resultsUpdate[0].url)
  assert(resultsUp[0].commit == resultsUpdate[0].commit)

  let entriesA = readLock(projA.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock A: " + e.message())
  }
  let entriesB = readLock(projB.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock B: " + e.message())
  }
  assert(len(entriesA) == len(entriesB))
  assert(entriesA[0].commit == entriesB[0].commit)
  assert(entriesA[0].url == entriesB[0].url)
}
