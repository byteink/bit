// compiler/pmzclicheck.bit — the `bit up`/`bit update` half of
// compiler/pmclicheck.bit's checks (#2474, split off compiler/pmclicheck.bit
// under the 800-line limit): pmCliBuildProjectDeps, pmAdvanceFixture,
// checkPmCliUpStaleLock, checkPmCliUpSingleName and
// checkPmCliUpdateAliasMatchesUp — self-contained (grepped: none of these
// five is called from anywhere else in pmclicheck.bit except checkPmCli()'s
// own driver, a forward function call into this file; #3211 removed the
// sixth, pmCliDeadUpResults, once its only call sites — all trailing fillers
// after an unconditional panic — became dead by E0212). Named `pmzclicheck`
// rather than `pmclichecktail` because the moved code calls `runGit`
// (compiler/pmfetchtail.bit) and `revParseHead`/`defaultGitBin`
// (compiler/pmfetch.bit) directly — `pmclichecktail.bit` would sort before
// both, same as `pmclicheck.bit` already does today, but `defaultGitBin` is
// a CONST, and a forward reference to a module const types `.invalid` and
// silently miscompiles. Sorting after every other `pm*` file (as `pmz.bit`
// already does, for the identical reason against its own `vanityTimeoutMs`
// read) makes every one of those reads a backward reference instead.
// ---- `bit up`/`bit update` checks (#1735) ------------------------------

// A project directory whose `bit.json` `dependencies` object is exactly
// `depsBody` (already indented, trailing newline included) — the custom-deps
// counterpart to `pmCliBuildProject` above, needed here so a test can name
// more than one dependency (or none) rather than always the fixed
// `existing`+`fixture` shape `bit add`'s own checks use.
fn pmCliBuildProjectDeps(root: string, depsBody: string): PmCliProject {
  let dir = root + "/project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + depsBody
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write project bit.json: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

// Commits `content` to the fixture at `dir` (already `pmBuildFixture`-built),
// moving its HEAD forward — simulates an upstream branch moving between when
// a dependency was first locked and when `bit up` re-resolves it.
fn pmAdvanceFixture(dir: string, content: string, timeoutMs: int): string! {
  writeFile(dir + "/hello.txt", content)?
  let add = runGit(defaultGitBin, ["-C", dir, "add", "hello.txt"], timeoutMs)?
  if (add.timedOut || add.exitCode != 0) {
    fail newError("pmclicheck: git add (advance fixture) failed")
  }
  let commit = runGit(defaultGitBin, ["-C", dir, "commit", "--quiet", "-m", "advance"], timeoutMs)?
  if (commit.timedOut || commit.exitCode != 0) {
    fail newError("pmclicheck: git commit (advance fixture) failed")
  }
  return revParseHead(defaultGitBin, dir, timeoutMs)?
}

// `bit up` on a project whose bit.lock is stale (its recorded SHA predates
// the fixture's current HEAD) rewrites bit.lock with the fresh SHA, leaving
// bit.json byte-for-byte untouched (comments included) — the acceptance bar
// ticket #1735 names first.
fn checkPmCliUpStaleLock() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  // A known git host (SPEC §17.7, #2068), not the "local" label the direct
  // function-call fixtures elsewhere in this file use — this string is fed
  // through the real `parseSpec` (`upDependencies` -> `projectDeps`), which
  // now classifies an unrecognized first segment as a vanity name rather
  // than a direct git-host spec. The actual fetch still reaches the local
  // `file://` fixture via the pre-seeded bit.lock `url`, exactly as before;
  // only the label written into bit.json changed.
  let deps = "    // fixture dependency comment -- must survive untouched\n" +
    "    \"fixture\": \"github.com/pmclicheck/fixture@main\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read seeded bit.json: " + e.message())
  }

  let seed = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let newSha = pmAdvanceFixture(fx.dir, "advanced for up\n", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot advance fixture: " + e.message())
  }
  assert(newSha != fx.sha)

  let results = upDependencies(proj.dir, cacheRoot, defaultGitBin, "", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies failed: " + e.message())
  }
  assert(len(results) == 1)
  assert(results[0].name == "fixture")
  assert(results[0].commit == newSha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].commit == newSha)
  assert(entries[0].url == url)

  let finalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
  }
  assert(finalBitJson == originalBitJson)
}

// `bit up <name>` restricted to one dependency touches only that dependency's
// bit.lock entry — a sibling entry (never fetched, an unrelated commit that
// would fail if `upDependency` were ever called for it) survives byte-for-
// byte.
fn checkPmCliUpSingleName() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  // A known git host, not "local" — see `checkPmCliUpStaleLock`'s comment.
  let deps = "    \"fixture\": \"github.com/pmclicheck/fixture@main\",\n" +
    "    \"other\": \"github.com/byteink/other@v1.0.0\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)

  let otherCommit = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
  let seed = [
    LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) },
    LockEntry{
      name: "other", url: "https://github.com/byteink/other.git", commit: otherCommit,
      requires: []LockRequire(0),
    },
  ]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let newSha = pmAdvanceFixture(fx.dir, "advanced for up single\n", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot advance fixture: " + e.message())
  }

  let results = upDependencies(proj.dir, cacheRoot, defaultGitBin, "fixture", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies (single) failed: " + e.message())
  }
  assert(len(results) == 1)
  assert(results[0].name == "fixture")
  assert(results[0].commit == newSha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entries) == 2)
  let i = 0
  let sawOther = false
  let sawFixture = false
  while (i < len(entries)) {
    if (entries[i].name == "other") {
      assert(entries[i].commit == otherCommit)
      assert(entries[i].url == "https://github.com/byteink/other.git")
      sawOther = true
    }
    if (entries[i].name == "fixture") {
      assert(entries[i].commit == newSha)
      sawFixture = true
    }
    i = i + 1
  }
  assert(sawOther && sawFixture)
}

// `bit update` is dispatched by main.bit to the exact same handler as
// `bit up` (`a[1] == "up" || a[1] == "update"` both call `upCmd(a)`, and
// `upCmd` never re-inspects `a[1]`), so the two commands are the same code
// path by construction. What remains to prove is that the shared entry point
// itself is deterministic: run it twice from byte-identical starting states
// (two independent project/cache/lock trees seeded the same way) and confirm
// both land the same resolved commit and the same bit.lock content — that is
// what "`bit update` produces identical output to `bit up`" cashes out to
// once the dispatch itself is a straight pass-through with no branch on the
// alias name.
fn checkPmCliUpdateAliasMatchesUp() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  // A known git host, not "local" — see `checkPmCliUpStaleLock`'s comment.
  let deps = "    \"fixture\": \"github.com/pmclicheck/fixture@main\"\n"

  let projA = pmCliBuildProjectDeps(root + "/a", deps)
  let seedA = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(projA.dir + "/bit.lock", seedA) catch e {
    panic("pmclicheck: cannot seed bit.lock A: " + e.message())
  }

  let projB = pmCliBuildProjectDeps(root + "/b", deps)
  let seedB = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(projB.dir + "/bit.lock", seedB) catch e {
    panic("pmclicheck: cannot seed bit.lock B: " + e.message())
  }

  // Stands in for `bit up`.
  let resultsUp = upDependencies(projA.dir, root + "/cacheA", defaultGitBin, "", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies (up) failed: " + e.message())
  }
  // Stands in for `bit update` -- the identical call `upCmd` makes for the
  // alias, exercised a second time against an identical starting state.
  let resultsUpdate = upDependencies(projB.dir, root + "/cacheB", defaultGitBin, "", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies (update) failed: " + e.message())
  }

  assert(len(resultsUp) == len(resultsUpdate))
  assert(resultsUp[0].name == resultsUpdate[0].name)
  assert(resultsUp[0].ref == resultsUpdate[0].ref)
  assert(resultsUp[0].url == resultsUpdate[0].url)
  assert(resultsUp[0].commit == resultsUpdate[0].commit)

  let entriesA = readLock(projA.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock A: " + e.message())
  }
  let entriesB = readLock(projB.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock B: " + e.message())
  }
  assert(len(entriesA) == len(entriesB))
  assert(entriesA[0].commit == entriesB[0].commit)
  assert(entriesA[0].url == entriesB[0].url)
}
