// The admitted Windows import surface for x86_64-windows (#3328, epic #3322),
// mirroring machosyms.bit's role for Darwin's libSystem.
//
// Windows publishes no stable syscall ABI, so a Bit-produced .exe cannot be
// fully static the way the Linux ELF output is: every OS-facing call must be a
// dynamic import resolved by the loader from kernel32.dll (or, for a future
// entry that genuinely needs one, ntdll.dll) at process start, recorded in the
// PE's import directory (IDT/IAT) — the loader-time counterpart of Mach-O's
// LC_LOAD_DYLIB. A name in NEITHER admitted source builds clean and dies at
// load with no line number, exactly the machosyms.bit:12 failure mode.
//
// WHY A TABLE AND NOT THE HOST'S LOADER: this Mac has no kernel32.dll to
// inspect at all, so "read the DLL and see what it exports" is not merely
// unwanted (as it is on Darwin, per machosyms.bit:17-23) but IMPOSSIBLE when
// cross-compiling `--target x86_64-windows` from here. The predicate must be a
// pure function of data the compiler carries, giving the same verdict from
// this Mac as it would from the Windows box `mustafa-desktop-win` (epic #3322
// comment) or a Linux CI runner — never discovered from any host.
//
// SCOPE: admits only what the Stage B runtime tickets (#3330-#3338, epic
// #3322) actually call: process and exit, virtual memory, file and console
// handles, thread creation and TLS, wait/synchronisation, timing, and error
// and fault reporting (including #3337's vectored exception handler — the
// ticket's own "roughly" category list omits fault handling by name, but
// #3337 is a real Stage B child and reporting a fault IS reporting an error).
// Windows entropy (#3338) is deliberately NOT admitted here: every source
// Bit could plausibly use (BCryptGenRandom, the legacy RtlGenRandom/
// SystemFunction036) lives in bcrypt.dll or advapi32.dll, neither of which
// any other Stage B ticket needs, so a #3338 ticket that actually implements
// it is the place to admit whichever DLL it settles on. An entry nobody calls
// cannot be verified, so nothing is admitted on speculation. The exact list,
// and the reasoning behind each group, is repeated in #3328's ticket comment
// so a later extension is deliberate, not accidental.
//
// Every name below resolves to Kernel32.dll per Microsoft's own API reference
// (learn.microsoft.com, `APILocation` metadata), checked individually rather
// than recalled — including the four (WaitOnAddress, WakeByAddressSingle,
// WakeByAddressAll, SetThreadStackGuarantee) whose primary "Library" line names
// a newer api-ms-win-core-*.dll apiset forwarder: each of those pages also
// lists Kernel32.dll itself as a DllExport location, so importing them from
// "kernel32.dll" directly (the same choice Go's and Zig's runtimes make) is
// correct on every supported Windows version. No entry here is Aarch64- or
// ARM64-specific; the target is x86_64-windows only (epic #3322).
//
// Emitting the PE import directory from this table is out of scope for this
// file — that is the linker's job (#3329 and successors). This file produces
// the data and the predicate only.

// One admitted Windows import: `symbol` is the exact name the PE import
// directory records, `dll` is the DLL the loader binds it from.
struct PeImport {
  symbol: string,
  dll: string,
}

// True if `symbol` (the undecorated Bit name) is DEFINED by some member of the
// COFF `ar` archive `bytes` — the Windows twin of elflink.bit's archiveDefines
// and machosyms.bit's machoArchiveDefines, and deliberately the same notion of
// "defined": a global-binding ATOM, which is what resolveGlobals keys the
// whole-link table on. A member that merely CALLS the symbol does not define
// it.
//
// Unlike machoArchiveDefines, no decoration step: x64 COFF decorates no C
// symbol names (emitpe.bit's own module comment, pelink.bit's header), so the
// archive holds `bit_rt_map_pages` verbatim for the Bit-visible name of the
// same spelling.
//
// `bytes` is `libbitrt-x86_64-windows.a`, which does not exist on disk yet
// (#3341) — until it does, `readRtArchive` fails before this is ever called
// for a LINKING build (build.bit's own ordering), so the empty-archive branch
// below is exercised only by `bit build -c --emit-obj` builds, which never
// call it at all (§11.7's gate is linking-only). Kept total anyway: an empty
// or malformed archive answers FALSE, never an error, the same collapse
// archiveDefines/machoArchiveDefines make, so "undecidable" stays one caller's
// decision.
fn peArchiveDefines(bytes: []u8, symbol: string): bool {
  if (len(bytes) == 0) { return false }
  let members = parseArchive(bytes) catch e { return false }
  let m = 0
  while (m < len(members)) {
    let mod = readCoffObject(members[m].name, members[m].data) catch e {
      m = m + 1
      continue
    }
    for atom of mod.atoms {
      if (atom.binding != LoBinding.Global) { continue }
      if (atom.name == symbol) { return true }
    }
    m = m + 1
  }
  return false
}

// True if `symbol` is one of the Windows imports Bit admits for
// x86_64-windows. The analogue of machosyms.bit:105's libsystemDefines.
//
// A LINEAR scan, matching machosyms.bit's own choice, for the same reason: the
// table is sorted for readability and for the self-check's count tripwire, not
// so a binary search can rely on it. Unlike machosyms.bit's comment (written
// while #1664 was still open), string ordering itself is not the concern here
// — #1664 fixed `<`/`>`/`<=`/`>=` on `string` to compare content in both
// compilers (95966d1a) — a linear scan is simply the simpler, sufficiently fast
// choice for a table this size. Equality is exact.
fn windowsImportDefines(symbol: string): bool {
  let table = windowsImports()
  let i = 0
  while (i < len(table)) {
    if (table[i].symbol == symbol) { return true }
    i = i + 1
  }
  return false
}

// The DLL that owns `symbol`, and whether `symbol` is admitted at all — the
// (value, ok) shape Bit map lookups use. Callers that only need the boolean
// verdict should call windowsImportDefines instead of discarding the DLL here.
fn windowsImportDll(symbol: string): (string, bool) {
  let table = windowsImports()
  let i = 0
  while (i < len(table)) {
    if (table[i].symbol == symbol) { return table[i].dll, true }
    i = i + 1
  }
  return "", false
}

// The admitted Windows import surface, sorted by `symbol` (byte-wise) and
// duplicate-free — checked programmatically in pesymscheck.bit, not by
// inspection. Every entry's `dll` is "kernel32.dll" for this round; see the
// header comment above and #3328's ticket comment for why no entry here needs
// ntdll.dll yet.
fn windowsImports(): []PeImport {
  return [
    PeImport{ symbol: "AddVectoredExceptionHandler", dll: "kernel32.dll" },
    PeImport{ symbol: "CloseHandle", dll: "kernel32.dll" },
    PeImport{ symbol: "CreateDirectoryW", dll: "kernel32.dll" },
    PeImport{ symbol: "CreateFileW", dll: "kernel32.dll" },
    PeImport{ symbol: "CreateThread", dll: "kernel32.dll" },
    PeImport{ symbol: "DeleteFileW", dll: "kernel32.dll" },
    PeImport{ symbol: "ExitProcess", dll: "kernel32.dll" },
    PeImport{ symbol: "ExitThread", dll: "kernel32.dll" },
    PeImport{ symbol: "FindClose", dll: "kernel32.dll" },
    PeImport{ symbol: "FindFirstFileW", dll: "kernel32.dll" },
    PeImport{ symbol: "FindNextFileW", dll: "kernel32.dll" },
    PeImport{ symbol: "FlushFileBuffers", dll: "kernel32.dll" },
    PeImport{ symbol: "FormatMessageW", dll: "kernel32.dll" },
    PeImport{ symbol: "FreeEnvironmentStringsW", dll: "kernel32.dll" },
    PeImport{ symbol: "GetCommandLineW", dll: "kernel32.dll" },
    PeImport{ symbol: "GetConsoleMode", dll: "kernel32.dll" },
    PeImport{ symbol: "GetCurrentProcess", dll: "kernel32.dll" },
    PeImport{ symbol: "GetCurrentProcessId", dll: "kernel32.dll" },
    PeImport{ symbol: "GetCurrentThread", dll: "kernel32.dll" },
    PeImport{ symbol: "GetCurrentThreadId", dll: "kernel32.dll" },
    PeImport{ symbol: "GetEnvironmentStringsW", dll: "kernel32.dll" },
    PeImport{ symbol: "GetEnvironmentVariableW", dll: "kernel32.dll" },
    PeImport{ symbol: "GetFileAttributesW", dll: "kernel32.dll" },
    PeImport{ symbol: "GetFileSizeEx", dll: "kernel32.dll" },
    PeImport{ symbol: "GetFileType", dll: "kernel32.dll" },
    PeImport{ symbol: "GetLastError", dll: "kernel32.dll" },
    PeImport{ symbol: "GetStdHandle", dll: "kernel32.dll" },
    PeImport{ symbol: "GetSystemTimeAsFileTime", dll: "kernel32.dll" },
    PeImport{ symbol: "GetSystemTimePreciseAsFileTime", dll: "kernel32.dll" },
    PeImport{ symbol: "MoveFileW", dll: "kernel32.dll" },
    PeImport{ symbol: "QueryPerformanceCounter", dll: "kernel32.dll" },
    PeImport{ symbol: "QueryPerformanceFrequency", dll: "kernel32.dll" },
    PeImport{ symbol: "ReadConsoleW", dll: "kernel32.dll" },
    PeImport{ symbol: "ReadFile", dll: "kernel32.dll" },
    PeImport{ symbol: "RemoveDirectoryW", dll: "kernel32.dll" },
    PeImport{ symbol: "RemoveVectoredExceptionHandler", dll: "kernel32.dll" },
    // #3345: walks a call stack via `.pdata`/`.xdata` (RtlVirtualUnwind
    // internally) exactly the way a debugger or crash reporter does — the
    // de-risk proof this ticket's evidence bar requires calls it directly
    // rather than needing an attached debugger. Exported by kernel32.dll
    // since Windows XP (Microsoft's own API reference).
    PeImport{ symbol: "RtlCaptureStackBackTrace", dll: "kernel32.dll" },
    PeImport{ symbol: "SetConsoleMode", dll: "kernel32.dll" },
    PeImport{ symbol: "SetEnvironmentVariableW", dll: "kernel32.dll" },
    PeImport{ symbol: "SetFileAttributesW", dll: "kernel32.dll" },
    PeImport{ symbol: "SetFilePointerEx", dll: "kernel32.dll" },
    PeImport{ symbol: "SetLastError", dll: "kernel32.dll" },
    PeImport{ symbol: "SetStdHandle", dll: "kernel32.dll" },
    PeImport{ symbol: "SetThreadStackGuarantee", dll: "kernel32.dll" },
    PeImport{ symbol: "TerminateProcess", dll: "kernel32.dll" },
    PeImport{ symbol: "TlsAlloc", dll: "kernel32.dll" },
    PeImport{ symbol: "TlsFree", dll: "kernel32.dll" },
    PeImport{ symbol: "TlsGetValue", dll: "kernel32.dll" },
    PeImport{ symbol: "TlsSetValue", dll: "kernel32.dll" },
    PeImport{ symbol: "VirtualAlloc", dll: "kernel32.dll" },
    PeImport{ symbol: "VirtualFree", dll: "kernel32.dll" },
    PeImport{ symbol: "VirtualProtect", dll: "kernel32.dll" },
    PeImport{ symbol: "VirtualQuery", dll: "kernel32.dll" },
    PeImport{ symbol: "WaitForSingleObject", dll: "kernel32.dll" },
    PeImport{ symbol: "WaitOnAddress", dll: "kernel32.dll" },
    PeImport{ symbol: "WakeByAddressAll", dll: "kernel32.dll" },
    PeImport{ symbol: "WakeByAddressSingle", dll: "kernel32.dll" },
    PeImport{ symbol: "WriteConsoleW", dll: "kernel32.dll" },
    PeImport{ symbol: "WriteFile", dll: "kernel32.dll" }]
}
