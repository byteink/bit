// compiler/checkifacefield.bit — an interface's FIELD REQUIREMENT
// (`interface Subject { id: string }`, SPEC §10.6/§14.3, #6990).
//
// A requirement is recorded as the getter method it is implemented with:
// `id: string` becomes the interface signature `__get_id(): string` in
// `methodSigs`, the table `vSatisfies` (validateiface.bit) already compares, so
// satisfaction, generic instantiation and dispatch need no second path. The
// class side of the pair is `__get_id`, synthesized by classifacegetter.bit
// for a class that has a field `id`; the `__` prefix keeps it out of `bit doc`,
// completion and the release surface (`isSynthMemberName`, synthtext.bit).
// A read `v.id` through an interface value is a dispatch on that getter
// (`lowerFieldAccess`, loweraccess.bit); a write is E0114 (`vMemberReadonlyAssign`).

// E0310 (§14.3): a class declares a method whose name starts with the
// reserved getter prefix.
const ecIfaceGetterDeclared = 310

const ifaceGetterPrefix = "__get_"

// True for the hidden getter's name, `__get_<field>`.
fn isIfaceGetterName(name: string): bool {
  return len(name) > len(ifaceGetterPrefix) && name[0:len(ifaceGetterPrefix)] == ifaceGetterPrefix
}

// The name interface signature `sig` is recorded under: its own spelling for a
// method, `__get_<name>` for a field requirement (`main == 2`,
// parserstatic.bit's `parseInterfaceFieldSig`).
fn ifaceSigName(tree: Tree, source: string, sig: int): string {
  let nm = getNode(tree, kidsOf(tree, sig)[0])
  let text = source[nm.span.start:nm.span.end]
  if (getNode(tree, sig).main == 2) {
    return ifaceGetterPrefix + text
  }
  return text
}

// The type of field `name` an interface `recv` requires, or 0 when `recv` is not
// an interface or requires no such field.
fn ifaceFieldType(c: Checker, recv: int, name: string): int {
  if (recv == 0 || c.ctx.types[recv].kind != TypeKind.Interface) {
    return 0
  }
  let sig = methodSigLookup(c, "${recv}.${ifaceGetterPrefix}${name}")
  if (sig == 0) {
    return 0
  }
  return c.ctx.types[sig].result
}

// One interface requirement being explained to the reader of an E0041: the
// candidate's and the interface's display names, the requirement's member name
// (a field's is its getter's `__get_<field>`), the signature it needs and the
// candidate's method-table key for it.
class MemberReq {
  cand: string,
  iface: string,
  member: string,
  want: int,
  key: string,
}

// Why the candidate fails field requirement `r`, in the field's own terms
// (never the hidden getter's), or "" when it meets it.
fn vFieldReason(c: Checker, r: MemberReq): string {
  let fname = r.member[len(ifaceGetterPrefix):len(r.member)]
  let need = typeName(c.ctx, c.ctx.types[r.want].result)
  let have = methodSigLookup(c, r.key)
  if (have == 0) {
    return "'${r.cand}' has no readable field '${fname}' (an unexported field counts only inside its own module); '${r.iface}' needs ${fname}: ${need}"
  }
  if (have != r.want) {
    return "'${r.cand}.${fname}' is ${typeName(c.ctx, c.ctx.types[have].result)}, but '${r.iface}' needs ${fname}: ${need}"
  }
  return ""
}
