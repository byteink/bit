// Self-host lexer (#1503): string, interpolation, raw-string and rune scanning.
// Split out of lexer.bit; a sibling file is the same module.

// Validates and consumes one escape sequence starting at `\` (§5.6). Bad escapes
// report E0005 and recovery continues past them.
fn scanEscape(lx: Lexer) {
  let start = lx.i
  lx.i = lx.i + 1
  if (lx.i >= len(lx.src)) {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "incomplete escape sequence")
    return
  }
  let c = lx.src[lx.i]
  if (c == 'n' || c == 'r' || c == 't' || c == '\\' || c == '\'' || c == '"' || c == '0' || c == '$') {
    lx.i = lx.i + 1
    return
  }
  if (c == 'x') {
    lx.i = lx.i + 1
    let k = 0
    while (k < 2 && lx.i < len(lx.src) && classOf(lx.src[lx.i], DigitClass.Hex)) {
      lx.i = lx.i + 1
      k = k + 1
    }
    if (k < 2) {
      lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "\\x needs two hex digits")
    }
    return
  }
  if (c == 'u') {
    scanUnicodeEscape(lx, start)
    return
  }
  lx.i = lx.i + 1
  lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "unknown escape sequence")
}

// The largest Unicode scalar value, and the UTF-16 surrogate block that is
// carved out of the range (§5.6: the escape "denotes a Unicode scalar value",
// and a surrogate is by definition not one).
const maxScalar: int = 1114111 // 0x10FFFF
const surrogateLo: int = 55296 // 0xD800
const surrogateHi: int = 57343 // 0xDFFF

// `\u{...}` (§5.6), with `lx.i` on the `u` and `start` on the backslash.
//
// The digit COUNT was the only thing validated here, never the value. An escape
// outside the scalar range was accepted with no diagnostic and then encoded to
// ZERO bytes downstream, which the encoder's caller read as "stop": the literal
// `"[\u{D800}]tail"` — nine visible characters — became the one-byte string
// `"["`, with the `]` and the `tail` silently gone, on every compiler shipped so
// far. Generated source is the realistic way to hit it: JSON, UTF-16 and Windows
// filenames all carry unpaired surrogates routinely (#2273).
fn scanUnicodeEscape(lx: Lexer, start: int) {
  lx.i = lx.i + 1
  if (peekAt(lx, 0) != '{') {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "\\u needs a '{'")
    return
  }
  lx.i = lx.i + 1
  let digits = lx.i
  let n = 0
  let v = 0
  while (lx.i < len(lx.src) && classOf(lx.src[lx.i], DigitClass.Hex)) {
    // Only the first 6 accumulate; past that the digit-count error below fires
    // and `v` is never read, and this keeps the accumulator bounded regardless
    // of how many digits the source supplies.
    if (n < 6) {
      v = v * 16 + hexDigitVal(lx.src[lx.i])
    }
    lx.i = lx.i + 1
    n = n + 1
  }
  let text = lx.src[digits:lx.i]
  if (peekAt(lx, 0) != '}') {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "unterminated \\u{...} escape")
    return
  }
  lx.i = lx.i + 1
  if (n == 0 || n > 6) {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "\\u{...} needs 1–6 hex digits")
    return
  }
  if (v > maxScalar) {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i,
      "\\u{" + text + "} is above the maximum Unicode scalar value U+10FFFF")
    return
  }
  if (v >= surrogateLo && v <= surrogateHi) {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i,
      "\\u{" + text + "} is a UTF-16 surrogate, not a Unicode scalar value")
  }
}

// Interpolation nesting cap (Power of 10): deeper nesting degrades to a literal
// `$`, matching the seed's max_interp.
const maxInterp: int = 32

// One literal segment of an interpreted string (§5.7). `isHead` marks the
// opening `"`. A string with no `${` yields a single StringLit; otherwise a
// StrPart is emitted and an InterpStart is stashed as `pending`, and after the
// interpolation's `}` (see scanRBrace) the next segment resumes here with
// `isHead = false`. Escapes are consumed so `\"` doesn't close; a newline ends
// an unterminated string with the seed's recovery span.
fn scanStringSegment(lx: Lexer, isHead: bool): Token {
  let open = lx.i
  if (isHead) {
    lx.i = lx.i + 1
  }
  let content = lx.i
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      let end = lx.i
      lx.i = lx.i + 1
      scanInvisibleRun(lx, content, end, "string literal")
      if (isHead) {
        return Token{ kind: Kind.StringLit, start: open, end: lx.i }
      }
      return Token{ kind: Kind.StrPart, start: content, end: end }
    }
    if (c == '\n') {
      return unterminatedString(lx, isHead, open, content)
    }
    if (c == '\\') {
      scanEscape(lx)
    } else if (c == '$' && peekAt(lx, 1) == '{') {
      if (len(lx.interp) >= maxInterp) {
        lexReportNoHint(lx, ecUnterminatedString, lx.i, lx.i + 2, "interpolation nested too deeply")
        lx.i = lx.i + 1 // treat '$' as literal and keep going
        continue
      }
      let dollar = lx.i
      let end = lx.i
      lx.i = lx.i + 2
      lx.interp = append(lx.interp, 0)
      lx.pending = Token{ kind: Kind.InterpStart, start: dollar, end: lx.i }
      lx.hasPending = true
      scanInvisibleRun(lx, content, end, "string literal")
      return Token{ kind: Kind.StrPart, start: content, end: end }
    } else {
      lx.i = lx.i + 1
    }
  }
  return unterminatedString(lx, isHead, open, content)
}

// A string closed by a newline or by EOF rather than by `"`.
fn unterminatedString(lx: Lexer, isHead: bool, open: int, content: int): Token {
  lexReport(lx, ecUnterminatedString, open, lx.i, "unterminated string", "add a closing '\"'")
  if (isHead) {
    return Token{ kind: Kind.StringLit, start: open, end: lx.i }
  }
  return Token{ kind: Kind.StrPart, start: content, end: lx.i }
}

// A `}`: closes the innermost interpolation (→ InterpEnd, and the next token
// resumes the string body) when that interpolation is at brace depth 0;
// otherwise it is a plain RBrace that pops one nesting level.
fn scanRBrace(lx: Lexer): Token {
  let start = lx.i
  let n = len(lx.interp)
  if (n > 0) {
    if (lx.interp[n - 1] == 0) {
      lx.i = lx.i + 1
      lx.interp = lx.interp[0:n - 1]
      lx.resumeString = true
      return Token{ kind: Kind.InterpEnd, start: start, end: lx.i }
    }
    lx.interp[n - 1] = lx.interp[n - 1] - 1
  }
  lx.i = lx.i + 1
  return Token{ kind: Kind.RBrace, start: start, end: lx.i }
}

// #3009: a raw string commonly holds the exact double-quoted interpolation
// syntax by mistake — JavaScript inverts Bit's convention (its backtick
// interpolates; Bit's is raw), so `` `The sum is ${1 + 2}` `` compiles clean
// and prints the literal text. spec/SPEC.md:245 is correct and unchanged: a
// raw string has no interpolation. This warns once, over the whole literal,
// only when the content holds a WELL-FORMED `${` ... `}` pair (nested braces
// balance). A bare `$`, a `$foo` shell variable, and an unmatched `${` all
// stay silent — that is exactly the content a raw string exists to hold (a
// shell snippet, a Makefile fragment, another language's template, or Bit
// source in a fixture), and warning on them would make this noise people
// disable.
const ecRawStringInterpLooking = 98

// True iff `src[start:end]` contains a `$` immediately followed by `{` whose
// nesting later balances to a matching `}` before `end`. Bounded by
// `end - start`: the outer loop advances by at least one byte per iteration,
// and the inner balance scan is a single forward pass over the same range.
fn hasBalancedInterpLooking(src: string, start: int, end: int): bool {
  let i = start
  while (i < end) {
    if (src[i] == '$' && i + 1 < end && src[i + 1] == '{') {
      let depth = 1
      let j = i + 2
      while (j < end && depth > 0) {
        if (src[j] == '{') {
          depth = depth + 1
        } else if (src[j] == '}') {
          depth = depth - 1
        }
        j = j + 1
      }
      if (depth == 0) {
        return true
      }
      // Unmatched at this position — keep scanning past the '${' rather than
      // stopping, in case a later, well-formed pair follows it.
      i = i + 2
      continue
    }
    i = i + 1
  }
  return false
}

// A raw string `` `...` `` → RawStringLit; no escapes, closes at the next
// backtick (or EOF, unterminated — same recovery span as the seed).
fn scanRawString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  let content = lx.i
  while (lx.i < len(lx.src) && lx.src[lx.i] != '`') {
    lx.i = lx.i + 1
  }
  if (lx.i >= len(lx.src)) {
    lexReport(lx, ecUnterminatedString, start, lx.i, "unterminated raw string", "add a closing '`'")
    return Token{ kind: Kind.RawStringLit, start: start, end: lx.i }
  }
  let contentEnd = lx.i
  lx.i = lx.i + 1
  if (hasBalancedInterpLooking(lx.src, content, contentEnd)) {
    lexWarn(lx, ecRawStringInterpLooking, start, lx.i,
      "'\${' in a raw string is literal text, not interpolation",
      "backtick strings have no escapes or interpolation — use a double-quoted string to interpolate")
  }
  return Token{ kind: Kind.RawStringLit, start: start, end: lx.i }
}

// A malformed rune: consume to the closing quote / line end, yield Invalid.
fn badRune(lx: Lexer, start: int): Token {
  while (lx.i < len(lx.src) && lx.src[lx.i] != '\'' && lx.src[lx.i] != '\n') {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '\'') {
    lx.i = lx.i + 1
  }
  lexReport(lx, ecInvalidRune, start, lx.i, "invalid character literal",
    "a rune is a single character in single quotes")
  return Token{ kind: Kind.Invalid, start: start, end: lx.i }
}

// A rune `'c'` → RuneLit: one escape or one UTF-8 code point, then a closing
// quote. Anything else recovers via badRune.
fn scanRune(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  if (lx.i >= len(lx.src) || lx.src[lx.i] == '\n' || lx.src[lx.i] == '\'') {
    return badRune(lx, start)
  }
  if (lx.src[lx.i] == '\\') {
    scanEscape(lx)
  } else {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isUtf8Cont(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '\'') {
    lx.i = lx.i + 1
    return Token{ kind: Kind.RuneLit, start: start, end: lx.i }
  }
  return badRune(lx, start)
}
