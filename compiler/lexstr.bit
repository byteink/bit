// Self-host lexer (#1503): string, interpolation, raw-string and rune scanning.
// Split out of lexer.bit; a sibling file is the same module.

// Validates and consumes one escape sequence starting at `\` (§5.6). Bad escapes
// report E0005 and recovery continues past them.
function scanEscape(lx: Lexer) {
  let start = lx.i
  lx.i = lx.i + 1
  if (lx.i >= len(lx.src)) {
    lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "incomplete escape sequence")
    return
  }
  let c = lx.src[lx.i]
  if (c == 'n' || c == 'r' || c == 't' || c == '\\' || c == '\'' || c == '"' || c == '0' || c == '$') {
    lx.i = lx.i + 1
    return
  }
  if (c == 'x') {
    lx.i = lx.i + 1
    let k = 0
    while (k < 2 && lx.i < len(lx.src) && classOf(lx.src[lx.i], DigitClass.Hex)) {
      lx.i = lx.i + 1
      k = k + 1
    }
    if (k < 2) {
      lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "\\x needs two hex digits")
    }
    return
  }
  if (c == 'u') {
    lx.i = lx.i + 1
    if (peekAt(lx, 0) != '{') {
      lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "\\u needs a '{'")
      return
    }
    lx.i = lx.i + 1
    let n = 0
    while (lx.i < len(lx.src) && classOf(lx.src[lx.i], DigitClass.Hex)) {
      lx.i = lx.i + 1
      n = n + 1
    }
    if (peekAt(lx, 0) != '}') {
      lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "unterminated \\u{...} escape")
      return
    }
    lx.i = lx.i + 1
    if (n == 0 || n > 6) {
      lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "\\u{...} needs 1–6 hex digits")
    }
    return
  }
  lx.i = lx.i + 1
  lexReportNoHint(lx, ecInvalidEscape, start, lx.i, "unknown escape sequence")
}

// Interpolation nesting cap (Power of 10): deeper nesting degrades to a literal
// `$`, matching the seed's max_interp.
const maxInterp: int = 32

// One literal segment of an interpreted string (§5.7). `isHead` marks the
// opening `"`. A string with no `${` yields a single StringLit; otherwise a
// StrPart is emitted and an InterpStart is stashed as `pending`, and after the
// interpolation's `}` (see scanRBrace) the next segment resumes here with
// `isHead = false`. Escapes are consumed so `\"` doesn't close; a newline ends
// an unterminated string with the seed's recovery span.
function scanStringSegment(lx: Lexer, isHead: bool): Token {
  let open = lx.i
  if (isHead) {
    lx.i = lx.i + 1
  }
  let content = lx.i
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      let end = lx.i
      lx.i = lx.i + 1
      if (isHead) {
        return Token{ kind: Kind.StringLit, start: open, end: lx.i }
      }
      return Token{ kind: Kind.StrPart, start: content, end: end }
    }
    if (c == '\n') {
      return unterminatedString(lx, isHead, open, content)
    }
    if (c == '\\') {
      scanEscape(lx)
    } else if (c == '$' && peekAt(lx, 1) == '{') {
      if (len(lx.interp) >= maxInterp) {
        lexReportNoHint(lx, ecUnterminatedString, lx.i, lx.i + 2, "interpolation nested too deeply")
        lx.i = lx.i + 1 // treat '$' as literal and keep going
        continue
      }
      let dollar = lx.i
      let end = lx.i
      lx.i = lx.i + 2
      lx.interp = append(lx.interp, 0)
      lx.pending = Token{ kind: Kind.InterpStart, start: dollar, end: lx.i }
      lx.hasPending = true
      return Token{ kind: Kind.StrPart, start: content, end: end }
    } else {
      lx.i = lx.i + 1
    }
  }
  return unterminatedString(lx, isHead, open, content)
}

// A string closed by a newline or by EOF rather than by `"`.
function unterminatedString(lx: Lexer, isHead: bool, open: int, content: int): Token {
  lexReport(lx, ecUnterminatedString, open, lx.i, "unterminated string", "add a closing '\"'")
  if (isHead) {
    return Token{ kind: Kind.StringLit, start: open, end: lx.i }
  }
  return Token{ kind: Kind.StrPart, start: content, end: lx.i }
}

// A `}`: closes the innermost interpolation (→ InterpEnd, and the next token
// resumes the string body) when that interpolation is at brace depth 0;
// otherwise it is a plain RBrace that pops one nesting level.
function scanRBrace(lx: Lexer): Token {
  let start = lx.i
  let n = len(lx.interp)
  if (n > 0) {
    if (lx.interp[n - 1] == 0) {
      lx.i = lx.i + 1
      lx.interp = lx.interp[0:n - 1]
      lx.resumeString = true
      return Token{ kind: Kind.InterpEnd, start: start, end: lx.i }
    }
    lx.interp[n - 1] = lx.interp[n - 1] - 1
  }
  lx.i = lx.i + 1
  return Token{ kind: Kind.RBrace, start: start, end: lx.i }
}

// A raw string `` `...` `` → RawStringLit; no escapes, closes at the next
// backtick (or EOF, unterminated — same recovery span as the seed).
function scanRawString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src) && lx.src[lx.i] != '`') {
    lx.i = lx.i + 1
  }
  if (lx.i >= len(lx.src)) {
    lexReport(lx, ecUnterminatedString, start, lx.i, "unterminated raw string", "add a closing '`'")
    return Token{ kind: Kind.RawStringLit, start: start, end: lx.i }
  }
  lx.i = lx.i + 1
  return Token{ kind: Kind.RawStringLit, start: start, end: lx.i }
}

// A malformed rune: consume to the closing quote / line end, yield Invalid.
function badRune(lx: Lexer, start: int): Token {
  while (lx.i < len(lx.src) && lx.src[lx.i] != '\'' && lx.src[lx.i] != '\n') {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '\'') {
    lx.i = lx.i + 1
  }
  lexReport(lx, ecInvalidRune, start, lx.i, "invalid character literal",
    "a rune is a single character in single quotes")
  return Token{ kind: Kind.Invalid, start: start, end: lx.i }
}

// A rune `'c'` → RuneLit: one escape or one UTF-8 code point, then a closing
// quote. Anything else recovers via badRune.
function scanRune(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  if (lx.i >= len(lx.src) || lx.src[lx.i] == '\n' || lx.src[lx.i] == '\'') {
    return badRune(lx, start)
  }
  if (lx.src[lx.i] == '\\') {
    scanEscape(lx)
  } else {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isUtf8Cont(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '\'') {
    lx.i = lx.i + 1
    return Token{ kind: Kind.RuneLit, start: start, end: lx.i }
  }
  return badRune(lx, start)
}
