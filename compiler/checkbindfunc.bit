// compiler/checkbindfunc.bit — split out of checkbind.bit (#5642). Sibling
// of checkbind.bit and check.bit: same module, so this needs no imports and
// no call-site changes. Function/method declaration collection: interning a
// signature (collectFuncDecl, collectExternFnDecl), building the
// `(params)=>result` func-type ids (buildSignatures) afterward, and
// recording which concrete methods carry `export` (collectMethodExports).

// The seed's collectFuncDecl: interns a function's signature composites in touch
// order — generics, then params (source order), then result, then (for a method)
// the receiver — and records its result + decl. The `(params)=>result` func-type
// id itself is NOT minted here (the seed stores a FuncShape, not a TypeId, so a
// sig wrapper would wrongly consume an id before later named types); it is built
// afterward by buildSignatures.
fn collectFuncDecl(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, name, generics, params, result, body]
  let recvType = ""
  let reuse = []int(0)
  if (kids[0] != 0) {
    // resolveNamed forces the receiver's own ids to exist before reuse below.
    recvType = typeNodeName(c, kidsOf(c.tree, kids[0])[1])
    let _ = resolveNamed(c, recvType)
    reuse = declTypeParamIds(c, recvType)
  }
  registerGenerics(c, kids[2], reuse)
  paramTypeIds(c, kids[3])
  let rty = c.ctx.voidId
  if (kids[4] != 0) {
    rty = typeFromNode(c, kids[4])
  }
  let nm = getNode(c.tree, kids[1])
  let fname = c.source[nm.span.start:nm.span.end]
  if (kids[0] != 0) {
    let key = "${userTypeLookup(c, recvType)}.${fname}"
    c.ctx.methodResults[key] = rty
    // #4495: which declaration that result came from, and the tree it indexes.
    // Recorded here rather than derived later: a method's own type params are
    // monomorphized from this node, and the receiver type id is the only key
    // both the call site and the emitter can agree on.
    c.ctx.methodDecls[key] = node
    c.ctx.methodDeclMods[key] = c.moduleId
    noteTypeMethod(c.ctx, userTypeLookup(c, recvType), fname)
  } else {
    c.funcResults[fname] = rty
    c.funcDecls[fname] = node
  }
  noteOwnTypeParams(c, node)
}

// Records the type-param ids `decl` declares for ITSELF: a free function's
// whole `<...>` list, or a METHOD's tail past the receiver-merged prefix the
// parser puts in front of it (`mergeGenericParams`, parsertype.bit —
// `methodOwnGenericCount` is the same split lowering uses to pick a method's
// emission path). `isOwnTypeParams` reads it to tell `Option<T>` written inside
// a generic FUNCTION from `Option`'s own rigid `T`; both are spelled `T`, and
// before this a method's own `T` was indistinguishable from the enum's, so the
// mention collapsed to the bare template and `T` was never substituted (#4538).
//
// Written HERE, at the end of the collect pass for this declaration, for the
// same reason `funcDecls` is: recording it before the `paramTypeIds` call above
// would instantiate this declaration's own `Option<T>` a pass earlier than
// today and renumber every type id minted after it.
fn noteOwnTypeParams(c: Checker, decl: int) {
  let kids = kidsOf(c.tree, decl)
  let ids = declGenericIds(c, kids[2])
  let skip = 0
  if (kids[0] != 0) {
    skip = len(ids) - methodOwnGenericCount(c, decl)
  }
  let i = 0
  while (i < len(ids)) {
    if (i >= skip) {
      c.ctx.funcOwnTypeParams[ids[i]] = true
    }
    i = i + 1
  }
}

// SPEC 11.7: records an `extern function`'s signature exactly like a free
// function's, so call sites type-check through the ordinary path, plus the
// extern marker lowering reads. There is no body and no receiver.
fn collectExternFnDecl(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [name, params, result_or_none]
  paramTypeIds(c, kids[1])
  let rty = c.ctx.voidId
  if (kids[2] != 0) {
    rty = typeFromNode(c, kids[2])
  }
  let nm = getNode(c.tree, kids[0])
  let fname = c.source[nm.span.start:nm.span.end]
  c.funcResults[fname] = rty
  c.funcDecls[fname] = node
  c.externFns[fname] = true
}

// Builds the `(params)=>result` func-type id for every free function, method, and
// interface method, filling funcSigs/methodSigs. Runs AFTER the collect pass so a
// sig wrapper's id lands past every named type (the seed mints these lazily, at
// the same relative position) — keeping named-type ids in touch order.
fn buildSignatures(c: Checker) {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl) {
      let kids = kidsOf(c.tree, m)
      let rty = c.ctx.voidId
      if (kids[4] != 0) {
        rty = typeFromNode(c, kids[4])
      }
      let sig = funcTypeFromParams(c, kids[3], rty)
      let nm = getNode(c.tree, kids[1])
      let fname = c.source[nm.span.start:nm.span.end]
      if (kids[0] != 0) {
        let rid = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))
        c.ctx.methodSigs["${rid}.${fname}"] = sig
        noteTypeMethod(c.ctx, rid, fname)
      } else {
        c.funcSigs[fname] = sig
      }
    } else if (n.tag == Tag.ExternFnDecl) {
      let ek = kidsOf(c.tree, m) // [name, params, result_or_none]
      let erty = c.ctx.voidId
      if (ek[2] != 0) {
        erty = typeFromNode(c, ek[2])
      }
      let enn = getNode(c.tree, ek[0])
      c.funcSigs[c.source[enn.span.start:enn.span.end]] = funcTypeFromParams(c, ek[1], erty)
    } else if (n.tag == Tag.InterfaceDecl) {
      let iname = declName(c, m)
      let sigs = kidsOf(c.tree, kidsOf(c.tree, m)[2])
      let mi = 0
      while (mi < len(sigs)) {
        let mk = kidsOf(c.tree, sigs[mi])
        let mnn = getNode(c.tree, mk[0])
        let mres = c.ctx.voidId
        if (mk[2] != 0) {
          mres = typeFromNode(c, mk[2])
        }
        let signame = c.source[mnn.span.start:mnn.span.end]
        c.ctx.methodSigs["${userTypeLookup(c, iname)}.${signame}"] = funcTypeFromParams(
          c,
          mk[1],
          mres,
        )
        noteTypeMethod(c.ctx, userTypeLookup(c, iname), signame)
        mi = mi + 1
      }
    }
    m = m + 1
  }
}

// Records which concrete methods carry `export`, keyed "<recvTypeId>.<name>" in
// the shared TypeContext, so `bit doc` can drop a type's PRIVATE methods from its
// public surface. Mirrors the seed's `Method.exported`. An `export`ed method is an
// `Export` node wrapping a `FuncDecl` that has a receiver (kid 0); the receiver
// type name resolves to the same TypeId `buildSignatures` keyed the method under.
// Runs after `buildSignatures` and before `copyMethodsToInsts`, so the flag is in
// place for `copyInstMethod` to carry onto each instantiation (#1528).
fn collectMethodExports(c: Checker) {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.Export) {
      let inner = kidsOf(c.tree, i)[0]
      if (inner != 0 && getNode(c.tree, inner).tag == Tag.FuncDecl) {
        let k = kidsOf(c.tree, inner)
        if (k[0] != 0 && k[1] != 0) {
          let rid = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, k[0])[1]))
          if (rid != 0) {
            let nm = getNode(c.tree, k[1])
            c.ctx.methodExported["${rid}." + c.source[nm.span.start:nm.span.end]] = true
          }
        }
      }
    }
    i = i + 1
  }
}
