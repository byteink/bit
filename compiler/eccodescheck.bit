// `hasPrefix`/`indexOf`/`split` are NOT imported here: sibling files already
// bind them module-wide (main.bit's `hasSuffix` import pulls in the same
// "std/strings" symbol set boundary as pmfetch.bit's `split, hasPrefix,
// indexOf`) and a second import of an already-bound name is a redeclaration
// (E0042). `trimSpace`/`parseInt` are genuinely new to this module.
import { trimSpace, parseInt } from "std/strings"

// In-Bit self-check (#4188) that the diagnostic code registry (compiler/
// diagnostics.bit's `E%04d` numbering, spec/LINT.md §3's "one registry, one
// collision authority") has no two `const ec*` declarations sharing a
// value. Split into its own sibling file rather than growing selfcheck.bit
// further, same shape as #4186's mainpathscheck.bit; same module, so
// `selfcheck()` calls this directly with no import.
//
// WHY A SOURCE SCAN, NOT A HARDCODED (name, value) TABLE. Four `const ec*`
// declarations already shipped colliding — E0103 (ecReceiverFormRemoved vs
// ecTraitMethodConflict), E0109 (ecTraitFieldConflict vs ecDuplicateInit),
// and #4064's E0118 (ecCondArmMismatch) — every one of them from parallel
// branches that each took "the next free code" measured on its own base.
// None could see what the others chose, git found no textual conflict
// (different files), and every branch's own gate was green. A hardcoded
// table here would need a human to remember to extend it on every new code,
// which is the exact diligence this bug has already failed three times.
// Reading the real declarations off disk means a fourth collision is caught
// with no one having to remember anything, and it can never itself drift
// out of sync with the registry it is checking.
//
// SCOPE: every `.bit` file under `compiler/` (collectProjectBitFiles,
// projectcli.bit — the same walk `bit fmt`/`bit lint` use, #4154), read
// relative to the process's cwd. That is always the repo root for every
// real invocation: `bit selfcheck` is the gate's own entry point, not
// something a user runs (main.bit's isKnownSubcommand comment), invoked by
// `./make test-selfcheck` and both hardware gates from the repo root.

// One `const ec<Name> = <value>` declaration line (an `export const ec...`
// form is handled too, though nothing uses it today), parsed with no regex
// engine: a Bit identifier never contains '=', so splitting on the first
// one cleanly separates the name from the value. `ok` is false for any line
// that is not this exact shape — including a commented-out declaration,
// since a comment line never prefix-matches "const ec" once its leading
// `//` is part of the trimmed text.
fn parseEcConstLine(line: string): (string, int, bool) {
  let body = trimSpace(line)
  if (hasPrefix(body, "export const ec")) {
    body = body[7:] // drop "export ", leaving "const ec..."
  }
  if (!hasPrefix(body, "const ec")) {
    return "", 0, false
  }
  let eq = indexOf(body, "=")
  if (eq < 0) {
    return "", 0, false
  }
  let name = trimSpace(body[6:eq]) // 6 == len("const ")
  let value = parseInt(trimSpace(body[eq + 1:])) catch _ {
    return "", 0, false
  }
  return name, value, true
}

// Scans every `.bit` file under `compiler/` for `const ec*` declarations and
// panics the first time two names claim the same numeric value, naming both
// claimants and the file the second one was found in. Returns the count of
// declarations examined so the caller can assert the scan actually ran.
fn checkEcCodesUniqueScan(): int {
  let seen = map<int, string>{}
  let count = 0
  for f of collectProjectBitFiles("compiler", false) {
    let src = readFile(f) catch e {
      panic("selfcheck: eccodescheck: cannot read ${f}: ${e.message()}")
    }
    for line of split(src, "\n") {
      let (name, value, ok) = parseEcConstLine(line)
      if (!ok) {
        continue
      }
      count = count + 1
      let (prevName, dup) = seen[value]
      if (dup) {
        panic("selfcheck: eccodescheck: E${value} is claimed by both '${prevName}' and '${name}' (found in ${f}) -- diagnostic codes must be unique")
      }
      seen[value] = name
    }
  }
  return count
}

fn checkEcCodesUnique() {
  let count = checkEcCodesUniqueScan()
  // A scan that silently examined zero declarations (a wrong directory, a
  // filter regression) would report the same clean result as a healthy
  // registry — assert the scan actually ran rather than trusting a vacuous
  // pass. 102 `const ec*` declarations existed in compiler/*.bit when this
  // check was added (#4188); the floor is deliberately well below that so a
  // modest future retirement cannot trip it for the wrong reason.
  assert(count >= 90)
}
