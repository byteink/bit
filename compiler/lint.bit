// `bit lint` — the code-health tool (epic #1377). spec/LINT.md is the authority
// for everything in this file; a divergence found here is fixed in the spec, not
// worked around.
//
// Two pieces: the rule registry — the table of every rule, its default limit
// and its diagnostic code (§3) — and the `// bit:lint` override directive
// reader, the small parser for the `<rule>=<n>` / `disable <rule>` language a
// file uses to raise or silence a rule for itself (§5).
//
// Split three ways (#2470): this file was 1362 lines against its own §4
// `max-file-lines` default of 800 — the file that implements that very rule,
// over its own declared 1300-line override. compiler/lintapply.bit keeps the
// dispatcher and every rule's own check function (§4); compiler/lintbatch.bit
// keeps diagnostic rendering and the `bit lint` command itself (§2, §6).

// Lint's slice of the central registry (spec/LINT.md §3): rules from E0200 up,
// directive machinery from E0299 down.
const ecLintMaxFileLines = 200
const ecLintMaxFnLines = 201
const ecLintMaxParams = 202
const ecLintMaxNesting = 203
const ecLintMaxComplexity = 204
const ecLintDeferInLoop = 205
const ecLintUnreachableCode = 212
const ecLintShadowedLocal = 213
const ecLintAppendAliasing = 214
const ecLintUnknownRule = 298
const ecLintBadDirective = 299

// The largest limit a directive may name. Not a policy limit — it is the guard
// that keeps `max-file-lines=99999999999999999999` from silently wrapping into
// a small number and quietly disabling the rule.
const lintMaxLimit = 1000000000

// ---------------------------------------------------------------------------
// 1. Rule registry
// ---------------------------------------------------------------------------

// One registered rule. A THRESHOLD rule carries an integer limit and may be
// assigned or disabled; a BOOLEAN rule (`hasLimit: false`) may only be disabled.
struct LintRule {
  name: string,
  code: int,
  hasLimit: bool,
  limit: int,
}

// The registered rules, in report order.
//
// Membership is deliberately narrow: a rule appears here only once its check
// function exists. An override naming a rule that has not landed is an
// E0298 unknown-rule error, which is the honest answer — accepting it would be
// exactly the silent no-op §5.2 forbids, just displaced from a typo to a
// not-yet-written rule. Each rule task (#1382-#1389) adds its own entry.
fn lintRules(): []LintRule {
  return [
    LintRule{ name: "max-file-lines", code: ecLintMaxFileLines, hasLimit: true, limit: 800 },
    LintRule{ name: "max-fn-lines", code: ecLintMaxFnLines, hasLimit: true, limit: 80 },
    LintRule{ name: "max-params", code: ecLintMaxParams, hasLimit: true, limit: 5 },
    LintRule{ name: "max-nesting", code: ecLintMaxNesting, hasLimit: true, limit: 4 },
    LintRule{ name: "max-complexity", code: ecLintMaxComplexity, hasLimit: true, limit: 10 },
    LintRule{ name: "defer-in-loop", code: ecLintDeferInLoop, hasLimit: false, limit: 0 },
    LintRule{ name: "unused-import", code: ecLintUnusedImport, hasLimit: false, limit: 0 },
    LintRule{ name: "unused-local", code: ecLintUnusedLocal, hasLimit: false, limit: 0 },
    LintRule{ name: "unreachable-code", code: ecLintUnreachableCode, hasLimit: false, limit: 0 },
    LintRule{ name: "shadowed-local", code: ecLintShadowedLocal, hasLimit: false, limit: 0 },
    LintRule{ name: "append-aliasing", code: ecLintAppendAliasing, hasLimit: false, limit: 0 },
    LintRule{ name: "unused-result", code: ecLintUnusedResult, hasLimit: false, limit: 0 },
  ]
}

// The index of `name` in `lintRules()`, or -1.
fn lintRuleIndex(rules: []LintRule, name: string): int {
  let i = 0
  while (i < len(rules)) {
    if (rules[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The effective configuration for one file: a limit and a disabled flag per
// registered rule, plus how many rules a directive changed. `overrides` counts
// DISTINCT rules whose setting came from a directive, not directive lines — two
// assignments to the same rule are one override in effect, and the summary line
// reports what is in effect (§2.2).
struct LintConfig {
  limits: []int,
  disabled: []bool,
  // Per rule: did a directive set this? The count and the `--stats` listing are
  // both derived from this one array, so they can never disagree — including in
  // the edge case of a directive that restates the default (`max-file-lines=800`),
  // which is an override in force even though it changes no behaviour.
  overridden: []bool,
}

fn newLintConfig(): LintConfig {
  let rules = lintRules()
  let limits = []int(len(rules))
  let disabled = []bool(len(rules))
  let overridden = []bool(len(rules))
  let i = 0
  while (i < len(rules)) {
    limits[i] = rules[i].limit
    disabled[i] = false
    overridden[i] = false
    i = i + 1
  }
  return LintConfig{ limits: limits, disabled: disabled, overridden: overridden }
}

// How many rules a directive set in this file. Counts DISTINCT rules, not
// directive lines: two assignments to the same rule are one override in effect,
// and the summary line reports what is in effect (§2.2).
fn lintOverrideCount(cfg: LintConfig): int {
  let n = 0
  let i = 0
  while (i < len(cfg.overridden)) {
    if (cfg.overridden[i]) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// The overrides in force, one `<rule>=<n>` or `disable <rule>` each, in registry
// order. This is what `--stats` lists: the count alone says overrides exist,
// this says which.
fn lintOverrideNotes(cfg: LintConfig): []string {
  let rules = lintRules()
  let out = []string(0)
  let i = 0
  while (i < len(rules)) {
    if (cfg.overridden[i]) {
      if (cfg.disabled[i]) {
        out = append(out, "disable ${rules[i].name}")
      } else {
        out = append(out, "${rules[i].name}=${cfg.limits[i]}")
      }
    }
    i = i + 1
  }
  return out
}

// ---------------------------------------------------------------------------
// 2. The `// bit:lint` directive reader
// ---------------------------------------------------------------------------

// ponytail: directives are COMMENTS, so they are invisible to the type system
// and hand-scanned here. A real language attribute (Rust's `#![allow(...)]`)
// would be checked by the parser and could not be misplaced, but it costs a
// grammar change to a settled spec mid-bootstrap. Revisit after the seed
// retires, when SPEC.md can move without a differential to keep in step.

fn lintIsSpace(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\r'
}

// A rule-name byte: `RuleName = lower { lower | "-" }` (§5.1).
fn lintIsNameByte(c: u8): bool {
  return (c >= 'a' && c <= 'z') || c == '-'
}

// End of the rule name starting at `i`, or `i` itself when there is none.
//
// The first byte must be a LOWERCASE LETTER, not merely a name byte. Without
// that, `// bit:lint disable -- reason` scans `--` as the rule name and reports
// "unknown lint rule '--'" for what is plainly a missing rule name — a wrong
// diagnosis of a right rejection, and the kind that sends the reader looking
// for a rule they never wrote.
fn lintScanName(src: string, i: int, stop: int): int {
  if (i >= stop || !(src[i] >= 'a' && src[i] <= 'z')) {
    return i
  }
  let j = i
  while (j < stop && lintIsNameByte(src[j])) {
    j = j + 1
  }
  return j
}

// First index in `[i, stop)` that is not a space. Bounded by `stop`.
fn lintSkipWs(src: string, i: int, stop: int): int {
  let j = i
  while (j < stop && lintIsSpace(src[j])) {
    j = j + 1
  }
  return j
}

// Whether `src[i..]` begins with `lit`, without running past `stop`.
fn lintAt(src: string, i: int, stop: int, lit: string): bool {
  if (i + len(lit) > stop) {
    return false
  }
  return src[i:i + len(lit)] == lit
}

// `src[i:stop]` with leading and trailing spaces removed.
fn lintTrim(src: string, i: int, stop: int): string {
  let a = lintSkipWs(src, i, stop)
  let b = stop
  while (b > a && lintIsSpace(src[b - 1])) {
    b = b - 1
  }
  return src[a:b]
}

// A directive error: reported at error severity so `errorCount` marks the file,
// and rendered with the same caret machinery as every other diagnostic. Always
// exit 2 — a malformed override is never a silent no-op (§5.2).
fn lintDirectiveError(d: Diagnostics, code: int, file: int, start: int, end: int,
  message: string, hint: string) {
  report(d, code, Span{ file: file, start: start, end: end }, message, hint)
}

// Parses one `bit:lint` directive body, `i0` positioned just past the tool name
// and `eol` at the end of the line. `dirStart` is the offset of `bit:` (the span
// a diagnostic points at). Returns false iff it reported an error.
//
// Bounded by the line length at every step.
fn lintParseDirective(src: string, i0: int, eol: int, dirStart: int, file: int,
  d: Diagnostics, rules: []LintRule, cfg: LintConfig): bool {
  let hint = "form: `// bit:lint <rule>=<n> -- <reason>` or `// bit:lint disable <rule> -- <reason>`"
  let i = lintSkipWs(src, i0, eol)
  if (i == i0) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "malformed lint directive: expected a rule name after 'bit:lint'", hint)
    return false
  }
  let nameStart = i
  i = lintScanName(src, i, eol)
  let first = src[nameStart:i]
  if (len(first) == 0) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "malformed lint directive: expected a rule name after 'bit:lint'", hint)
    return false
  }

  // `disable` is a keyword, not a rule name — no rule is called `disable`, so
  // the two forms are told apart by this one token.
  let ruleName = first
  let isDisable = false
  let limit = 0
  if (first == "disable") {
    isDisable = true
    let j = lintSkipWs(src, i, eol)
    if (j == i) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected a rule name after 'disable'", hint)
      return false
    }
    let ns = j
    j = lintScanName(src, j, eol)
    ruleName = src[ns:j]
    if (len(ruleName) == 0) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected a rule name after 'disable'", hint)
      return false
    }
    i = j
  } else {
    if (i >= eol || src[i] != '=') {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected '=<integer>' or the 'disable' form", hint)
      return false
    }
    i = i + 1
    let digitStart = i
    while (i < eol && src[i] >= '0' && src[i] <= '9') {
      // Clamped, not wrapped: a limit past `lintMaxLimit` is rejected below
      // rather than folding into a small number that silently tightens the rule.
      if (limit <= lintMaxLimit) {
        limit = limit * 10 + i64(src[i] - '0')
      }
      i = i + 1
    }
    if (i == digitStart) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected an integer after '='", hint)
      return false
    }
    if (limit > lintMaxLimit) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "lint limit out of range: the maximum is ${lintMaxLimit}", hint)
      return false
    }
  }

  // Unknown rule BEFORE the reason: naming a rule that does not exist is the
  // error that matters most (§5.2). If it were ignored, renaming a rule would
  // turn every existing override into a no-op and files that were green because
  // of one would start failing for reasons invisible in the diff.
  let idx = lintRuleIndex(rules, ruleName)
  if (idx < 0) {
    lintDirectiveError(d, ecLintUnknownRule, file, dirStart, eol,
      "unknown lint rule '${ruleName}'", "known rules: ${lintRuleNames(rules)}")
    return false
  }
  if (!isDisable && !rules[idx].hasLimit) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "lint rule '${ruleName}' takes no value", "it can only be turned off: `disable ${ruleName}`")
    return false
  }

  let j = lintSkipWs(src, i, eol)
  if (!lintAt(src, j, eol, "--")) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "lint directive has no reason: expected '-- <reason>'",
      "a raised limit claims this file is the exception; state why in one sentence")
    return false
  }
  let reason = lintTrim(src, j + 2, eol)
  if (len(reason) == 0) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "lint directive reason is empty",
      "a raised limit claims this file is the exception; state why in one sentence")
    return false
  }

  // Last assignment for a rule wins (§5.2).
  if (isDisable) {
    cfg.disabled[idx] = true
  } else {
    cfg.limits[idx] = limit
  }
  cfg.overridden[idx] = true
  return true
}

// The registered rule names, comma-separated — the hint on an unknown rule.
fn lintRuleNames(rules: []LintRule): string {
  let out = ""
  let i = 0
  while (i < len(rules)) {
    if (i > 0) {
      out = out + ", "
    }
    out = out + rules[i].name
    i = i + 1
  }
  return out
}

// Reads the overrides in effect for `src`, reporting any directive error into
// `d` (which the caller turns into exit 2).
//
// A directive is recognised ONLY in the file's leading comment block — the run
// of `//` lines from the start of the file up to the first blank line,
// declaration, or non-comment token (§5.2). Not pinned to line 1: a golden case
// spends line 1 on the harness mode directive.
//
// A well-formed `// bit:lint` line found AFTER the leading block ends is not
// silently skipped (#2158): every rule's own fix hint is rendered at the
// OFFENDING CONSTRUCT's span (#2137/#2145), the strongest possible signal that
// the directive belongs there, which is the one placement that never applies
// it. Reported through the SAME hard-error path as a malformed directive
// (`ecLintBadDirective`) — spec/LINT.md §5.2's own principle ("a malformed
// directive is a hard error, never a silent no-op") applies just as much to a
// well-formed directive in the wrong place. `bit:` namespace lines for another
// tool (`// bit:fmt ...`) are still skipped wherever they sit — this is
// `bit:lint` specifically, never a general "unrecognised trailing comment"
// check.
//
// Bounded by the source length.
fn readLintDirectives(src: string, file: int, d: Diagnostics): LintConfig {
  let rules = lintRules()
  let cfg = newLintConfig()
  let pos = 0
  let inLeading = true
  while (pos < len(src)) {
    let eol = pos
    while (eol < len(src) && src[eol] != '\n') {
      eol = eol + 1
    }
    let i = lintSkipWs(src, pos, eol)
    let isComment = i < eol && lintAt(src, i, eol, "//")
    if (inLeading && (i >= eol || !isComment)) {
      inLeading = false // a blank line or non-comment token ends the block
    }
    if (isComment) {
      let j = lintSkipWs(src, i + 2, eol)
      if (lintAt(src, j, eol, "bit:")) {
        let dirStart = j
        let ns = j + 4
        let k = lintScanName(src, ns, eol)
        // `bit:` is a namespace claim for the whole toolchain, not a lint
        // token. A future `// bit:fmt ...` is another tool's business and is
        // skipped here rather than rejected, in or out of the leading block.
        if (src[ns:k] == "lint") {
          if (!inLeading) {
            lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
              "bit:lint directive found outside the file's leading comment block",
              "a directive is only honoured in the file's leading comment block " +
                "(the run of `//` lines from the top of the file); move it there")
            return cfg
          }
          if (!lintParseDirective(src, k, eol, dirStart, file, d, rules, cfg)) {
            return cfg
          }
        }
      }
    }
    pos = eol + 1
  }
  return cfg
}

