// `bit lint` — the code-health tool (epic #1377). spec/LINT.md is the authority
// for everything in this file; a divergence found here is fixed in the spec, not
// worked around.
// bit:lint max-file-lines=1300 -- 11 rules landed in one file per spec/LINT.md's
// registry design (#1380); split when a 12th rule pushes it further (#1390).
//
// Three pieces, in dependency order:
//   1. the rule registry — one entry per rule, so landing a rule is an entry
//      plus a check function and nothing else (#1380);
//   2. the `// bit:lint` override reader — leading comment block, mandatory
//      reason, hard errors, never a silent no-op (#1379);
//   3. the runner — path walk, rule dispatch, deterministic ordering, exit
//      codes, `--json`, `--stats` (#1380).
//
// Lint findings are severity=1 (warning) and go through `warn`, which
// deliberately does not bump `errorCount` (diagnostics.bit:93). A lint hit must
// never fail an unrelated `bit build`; failure is expressed by this command's
// exit code alone.
import { walk } from "std/fs"
import { compare } from "std/strings"

// Lint's slice of the central registry (spec/LINT.md §3): rules from E0200 up,
// directive machinery from E0299 down.
const ecLintMaxFileLines = 200
const ecLintMaxFnLines = 201
const ecLintMaxParams = 202
const ecLintMaxNesting = 203
const ecLintMaxComplexity = 204
const ecLintDeferInLoop = 205
const ecLintUnreachableCode = 212
const ecLintShadowedLocal = 213
const ecLintAppendAliasing = 214
const ecLintUnknownRule = 298
const ecLintBadDirective = 299

// The largest limit a directive may name. Not a policy limit — it is the guard
// that keeps `max-file-lines=99999999999999999999` from silently wrapping into
// a small number and quietly disabling the rule.
const lintMaxLimit = 1000000000

// ---------------------------------------------------------------------------
// 1. Rule registry
// ---------------------------------------------------------------------------

// One registered rule. A THRESHOLD rule carries an integer limit and may be
// assigned or disabled; a BOOLEAN rule (`hasLimit: false`) may only be disabled.
struct LintRule {
  name: string,
  code: int,
  hasLimit: bool,
  limit: int,
}

// The registered rules, in report order.
//
// Membership is deliberately narrow: a rule appears here only once its check
// function exists. An override naming a rule that has not landed is an
// E0298 unknown-rule error, which is the honest answer — accepting it would be
// exactly the silent no-op §5.2 forbids, just displaced from a typo to a
// not-yet-written rule. Each rule task (#1382-#1389) adds its own entry.
fn lintRules(): []LintRule {
  return [
    LintRule{ name: "max-file-lines", code: ecLintMaxFileLines, hasLimit: true, limit: 800 },
    LintRule{ name: "max-fn-lines", code: ecLintMaxFnLines, hasLimit: true, limit: 80 },
    LintRule{ name: "max-params", code: ecLintMaxParams, hasLimit: true, limit: 5 },
    LintRule{ name: "max-nesting", code: ecLintMaxNesting, hasLimit: true, limit: 4 },
    LintRule{ name: "max-complexity", code: ecLintMaxComplexity, hasLimit: true, limit: 10 },
    LintRule{ name: "defer-in-loop", code: ecLintDeferInLoop, hasLimit: false, limit: 0 },
    LintRule{ name: "unused-import", code: ecLintUnusedImport, hasLimit: false, limit: 0 },
    LintRule{ name: "unused-local", code: ecLintUnusedLocal, hasLimit: false, limit: 0 },
    LintRule{ name: "unreachable-code", code: ecLintUnreachableCode, hasLimit: false, limit: 0 },
    LintRule{ name: "shadowed-local", code: ecLintShadowedLocal, hasLimit: false, limit: 0 },
    LintRule{ name: "append-aliasing", code: ecLintAppendAliasing, hasLimit: false, limit: 0 },
  ]
}

// The index of `name` in `lintRules()`, or -1.
fn lintRuleIndex(rules: []LintRule, name: string): int {
  let i = 0
  while (i < len(rules)) {
    if (rules[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The effective configuration for one file: a limit and a disabled flag per
// registered rule, plus how many rules a directive changed. `overrides` counts
// DISTINCT rules whose setting came from a directive, not directive lines — two
// assignments to the same rule are one override in effect, and the summary line
// reports what is in effect (§2.2).
struct LintConfig {
  limits: []int,
  disabled: []bool,
  // Per rule: did a directive set this? The count and the `--stats` listing are
  // both derived from this one array, so they can never disagree — including in
  // the edge case of a directive that restates the default (`max-file-lines=800`),
  // which is an override in force even though it changes no behaviour.
  overridden: []bool,
}

fn newLintConfig(): LintConfig {
  let rules = lintRules()
  let limits = []int(len(rules))
  let disabled = []bool(len(rules))
  let overridden = []bool(len(rules))
  let i = 0
  while (i < len(rules)) {
    limits[i] = rules[i].limit
    disabled[i] = false
    overridden[i] = false
    i = i + 1
  }
  return LintConfig{ limits: limits, disabled: disabled, overridden: overridden }
}

// How many rules a directive set in this file. Counts DISTINCT rules, not
// directive lines: two assignments to the same rule are one override in effect,
// and the summary line reports what is in effect (§2.2).
fn lintOverrideCount(cfg: LintConfig): int {
  let n = 0
  let i = 0
  while (i < len(cfg.overridden)) {
    if (cfg.overridden[i]) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// The overrides in force, one `<rule>=<n>` or `disable <rule>` each, in registry
// order. This is what `--stats` lists: the count alone says overrides exist,
// this says which.
fn lintOverrideNotes(cfg: LintConfig): []string {
  let rules = lintRules()
  let out = []string(0)
  let i = 0
  while (i < len(rules)) {
    if (cfg.overridden[i]) {
      if (cfg.disabled[i]) {
        out = append(out, "disable ${rules[i].name}")
      } else {
        out = append(out, "${rules[i].name}=${cfg.limits[i]}")
      }
    }
    i = i + 1
  }
  return out
}

// ---------------------------------------------------------------------------
// 2. The `// bit:lint` directive reader
// ---------------------------------------------------------------------------

// ponytail: directives are COMMENTS, so they are invisible to the type system
// and hand-scanned here. A real language attribute (Rust's `#![allow(...)]`)
// would be checked by the parser and could not be misplaced, but it costs a
// grammar change to a settled spec mid-bootstrap. Revisit after the seed
// retires, when SPEC.md can move without a differential to keep in step.

fn lintIsSpace(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\r'
}

// A rule-name byte: `RuleName = lower { lower | "-" }` (§5.1).
fn lintIsNameByte(c: u8): bool {
  return (c >= 'a' && c <= 'z') || c == '-'
}

// End of the rule name starting at `i`, or `i` itself when there is none.
//
// The first byte must be a LOWERCASE LETTER, not merely a name byte. Without
// that, `// bit:lint disable -- reason` scans `--` as the rule name and reports
// "unknown lint rule '--'" for what is plainly a missing rule name — a wrong
// diagnosis of a right rejection, and the kind that sends the reader looking
// for a rule they never wrote.
fn lintScanName(src: string, i: int, stop: int): int {
  if (i >= stop || !(src[i] >= 'a' && src[i] <= 'z')) {
    return i
  }
  let j = i
  while (j < stop && lintIsNameByte(src[j])) {
    j = j + 1
  }
  return j
}

// First index in `[i, stop)` that is not a space. Bounded by `stop`.
fn lintSkipWs(src: string, i: int, stop: int): int {
  let j = i
  while (j < stop && lintIsSpace(src[j])) {
    j = j + 1
  }
  return j
}

// Whether `src[i..]` begins with `lit`, without running past `stop`.
fn lintAt(src: string, i: int, stop: int, lit: string): bool {
  if (i + len(lit) > stop) {
    return false
  }
  return src[i:i + len(lit)] == lit
}

// `src[i:stop]` with leading and trailing spaces removed.
fn lintTrim(src: string, i: int, stop: int): string {
  let a = lintSkipWs(src, i, stop)
  let b = stop
  while (b > a && lintIsSpace(src[b - 1])) {
    b = b - 1
  }
  return src[a:b]
}

// A directive error: reported at error severity so `errorCount` marks the file,
// and rendered with the same caret machinery as every other diagnostic. Always
// exit 2 — a malformed override is never a silent no-op (§5.2).
fn lintDirectiveError(d: Diagnostics, code: int, file: int, start: int, end: int,
  message: string, hint: string) {
  report(d, code, Span{ file: file, start: start, end: end }, message, hint)
}

// Parses one `bit:lint` directive body, `i0` positioned just past the tool name
// and `eol` at the end of the line. `dirStart` is the offset of `bit:` (the span
// a diagnostic points at). Returns false iff it reported an error.
//
// Bounded by the line length at every step.
fn lintParseDirective(src: string, i0: int, eol: int, dirStart: int, file: int,
  d: Diagnostics, rules: []LintRule, cfg: LintConfig): bool {
  let hint = "form: `// bit:lint <rule>=<n> -- <reason>` or `// bit:lint disable <rule> -- <reason>`"
  let i = lintSkipWs(src, i0, eol)
  if (i == i0) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "malformed lint directive: expected a rule name after 'bit:lint'", hint)
    return false
  }
  let nameStart = i
  i = lintScanName(src, i, eol)
  let first = src[nameStart:i]
  if (len(first) == 0) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "malformed lint directive: expected a rule name after 'bit:lint'", hint)
    return false
  }

  // `disable` is a keyword, not a rule name — no rule is called `disable`, so
  // the two forms are told apart by this one token.
  let ruleName = first
  let isDisable = false
  let limit = 0
  if (first == "disable") {
    isDisable = true
    let j = lintSkipWs(src, i, eol)
    if (j == i) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected a rule name after 'disable'", hint)
      return false
    }
    let ns = j
    j = lintScanName(src, j, eol)
    ruleName = src[ns:j]
    if (len(ruleName) == 0) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected a rule name after 'disable'", hint)
      return false
    }
    i = j
  } else {
    if (i >= eol || src[i] != '=') {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected '=<integer>' or the 'disable' form", hint)
      return false
    }
    i = i + 1
    let digitStart = i
    while (i < eol && src[i] >= '0' && src[i] <= '9') {
      // Clamped, not wrapped: a limit past `lintMaxLimit` is rejected below
      // rather than folding into a small number that silently tightens the rule.
      if (limit <= lintMaxLimit) {
        limit = limit * 10 + i64(src[i] - '0')
      }
      i = i + 1
    }
    if (i == digitStart) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "malformed lint directive: expected an integer after '='", hint)
      return false
    }
    if (limit > lintMaxLimit) {
      lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
        "lint limit out of range: the maximum is ${lintMaxLimit}", hint)
      return false
    }
  }

  // Unknown rule BEFORE the reason: naming a rule that does not exist is the
  // error that matters most (§5.2). If it were ignored, renaming a rule would
  // turn every existing override into a no-op and files that were green because
  // of one would start failing for reasons invisible in the diff.
  let idx = lintRuleIndex(rules, ruleName)
  if (idx < 0) {
    lintDirectiveError(d, ecLintUnknownRule, file, dirStart, eol,
      "unknown lint rule '${ruleName}'", "known rules: ${lintRuleNames(rules)}")
    return false
  }
  if (!isDisable && !rules[idx].hasLimit) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "lint rule '${ruleName}' takes no value", "it can only be turned off: `disable ${ruleName}`")
    return false
  }

  let j = lintSkipWs(src, i, eol)
  if (!lintAt(src, j, eol, "--")) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "lint directive has no reason: expected '-- <reason>'",
      "a raised limit claims this file is the exception; state why in one sentence")
    return false
  }
  let reason = lintTrim(src, j + 2, eol)
  if (len(reason) == 0) {
    lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
      "lint directive reason is empty",
      "a raised limit claims this file is the exception; state why in one sentence")
    return false
  }

  // Last assignment for a rule wins (§5.2).
  if (isDisable) {
    cfg.disabled[idx] = true
  } else {
    cfg.limits[idx] = limit
  }
  cfg.overridden[idx] = true
  return true
}

// The registered rule names, comma-separated — the hint on an unknown rule.
fn lintRuleNames(rules: []LintRule): string {
  let out = ""
  let i = 0
  while (i < len(rules)) {
    if (i > 0) {
      out = out + ", "
    }
    out = out + rules[i].name
    i = i + 1
  }
  return out
}

// Reads the overrides in effect for `src`, reporting any directive error into
// `d` (which the caller turns into exit 2).
//
// A directive is recognised ONLY in the file's leading comment block — the run
// of `//` lines from the start of the file up to the first blank line,
// declaration, or non-comment token (§5.2). Not pinned to line 1: a golden case
// spends line 1 on the harness mode directive.
//
// A well-formed `// bit:lint` line found AFTER the leading block ends is not
// silently skipped (#2158): every rule's own fix hint is rendered at the
// OFFENDING CONSTRUCT's span (#2137/#2145), the strongest possible signal that
// the directive belongs there, which is the one placement that never applies
// it. Reported through the SAME hard-error path as a malformed directive
// (`ecLintBadDirective`) — spec/LINT.md §5.2's own principle ("a malformed
// directive is a hard error, never a silent no-op") applies just as much to a
// well-formed directive in the wrong place. `bit:` namespace lines for another
// tool (`// bit:fmt ...`) are still skipped wherever they sit — this is
// `bit:lint` specifically, never a general "unrecognised trailing comment"
// check.
//
// Bounded by the source length.
fn readLintDirectives(src: string, file: int, d: Diagnostics): LintConfig {
  let rules = lintRules()
  let cfg = newLintConfig()
  let pos = 0
  let inLeading = true
  while (pos < len(src)) {
    let eol = pos
    while (eol < len(src) && src[eol] != '\n') {
      eol = eol + 1
    }
    let i = lintSkipWs(src, pos, eol)
    let isComment = i < eol && lintAt(src, i, eol, "//")
    if (inLeading && (i >= eol || !isComment)) {
      inLeading = false // a blank line or non-comment token ends the block
    }
    if (isComment) {
      let j = lintSkipWs(src, i + 2, eol)
      if (lintAt(src, j, eol, "bit:")) {
        let dirStart = j
        let ns = j + 4
        let k = lintScanName(src, ns, eol)
        // `bit:` is a namespace claim for the whole toolchain, not a lint
        // token. A future `// bit:fmt ...` is another tool's business and is
        // skipped here rather than rejected, in or out of the leading block.
        if (src[ns:k] == "lint") {
          if (!inLeading) {
            lintDirectiveError(d, ecLintBadDirective, file, dirStart, eol,
              "bit:lint directive found outside the file's leading comment block",
              "a directive is only honoured in the file's leading comment block " +
                "(the run of `//` lines from the top of the file); move it there")
            return cfg
          }
          if (!lintParseDirective(src, k, eol, dirStart, file, d, rules, cfg)) {
            return cfg
          }
        }
      }
    }
    pos = eol + 1
  }
  return cfg
}

// ---------------------------------------------------------------------------
// 3. Rules
// ---------------------------------------------------------------------------

// Physical lines in `src`, counting blanks and comments (§4). A file whose last
// line has no terminating newline still counts that line.
fn lintCountLines(src: string): int {
  if (len(src) == 0) {
    return 0
  }
  let n = 0
  let i = 0
  while (i < len(src)) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  if (src[len(src) - 1] != '\n') {
    n = n + 1
  }
  return n
}

// Runs every registered rule over one file, appending findings to `d`. `tree`
// is the file's parsed AST — unused by `max-file-lines`, which reads only
// `src`, and required by every rule that needs syntax (phase 1, plus
// `append-aliasing`).
//
// This is the ONE place a rule is dispatched. A new rule adds its entry to
// `lintRules()` and its arm here; nothing else in the runner changes.
fn runLintRules(src: string, file: int, tree: Tree, cfg: LintConfig, d: Diagnostics) {
  let rules = lintRules()
  let funcs = lintCollectFuncs(tree, tree.root, []int(0))
  // `unused-import`/`unused-local` are the first rules that need the
  // resolver, computed once per file (not once per rule) and only when at
  // least one of the two is enabled, since every other rule here is
  // AST-or-text only.
  let unusedImportIdx = lintRuleIndex(rules, "unused-import")
  let unusedLocalIdx = lintRuleIndex(rules, "unused-local")
  let needUnused = (unusedImportIdx >= 0 && !cfg.disabled[unusedImportIdx]) ||
    (unusedLocalIdx >= 0 && !cfg.disabled[unusedLocalIdx])
  let analysis = LintUnusedAnalysis{ mod: newModule(), used: []bool(0) }
  if (needUnused) {
    analysis = lintAnalyzeUnused(tree, src, file, d.sm)
  }
  let i = 0
  while (i < len(rules)) {
    if (cfg.disabled[i]) {
      i = i + 1
      continue
    }
    if (rules[i].code == ecLintMaxFileLines) {
      lintMaxFileLines(src, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxFnLines) {
      lintMaxFnLines(tree, funcs, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxParams) {
      lintMaxParams(tree, funcs, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxNesting) {
      lintMaxNesting(tree, funcs, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxComplexity) {
      lintMaxComplexity(tree, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintDeferInLoop) {
      lintDeferInLoop(tree, file, d)
    } else if (rules[i].code == ecLintUnusedImport) {
      lintUnusedImport(tree, analysis.mod, analysis.used, file, d)
    } else if (rules[i].code == ecLintUnusedLocal) {
      lintUnusedLocal(tree, analysis.mod, analysis.used, file, d)
    } else if (rules[i].code == ecLintUnreachableCode) {
      lintUnreachableCode(tree, src, file, d)
    } else if (rules[i].code == ecLintShadowedLocal) {
      lintShadowedLocal(src, file, d)
    } else if (rules[i].code == ecLintAppendAliasing) {
      lintAppendAliasing(tree, src, file, d)
    }
    i = i + 1
  }
}

// E0200 `max-file-lines`. The finding points at the file's first byte: the
// problem is the whole file, and there is no more specific span to blame.
fn lintMaxFileLines(src: string, file: int, limit: int, d: Diagnostics) {
  let n = lintCountLines(src)
  if (n <= limit) {
    return
  }
  // The hint carries the `-- <reason>` placeholder deliberately: an override
  // form without it would teach the wrong shape and fail with exit 2 on first
  // use (§6).
  warn(d, ecLintMaxFileLines, Span{ file: file, start: 0, end: 0 },
    "file is ${n} lines, limit is ${limit}",
    "split it, or raise the limit with `// bit:lint max-file-lines=${n} -- <reason>` " +
      "in the file's leading comment block")
}

// E0201/E0202/E0203 share one AST walk over every function-shaped node — a
// `FuncDecl` (plain function or method) or an `ArrowFn` — because all three
// rules measure the same thing found the same way (spec/LINT.md §4).

// One function-shaped node's measurements: the byte offset to report at (its
// own declaration, never an inner node, so a finding points at what the author
// has to change), the `[startOff, endOff)` span `max-fn-lines` counts lines
// over, its declared parameter count, and its body node for `max-nesting`.
struct LintFuncInfo {
  reportAt: int,
  startOff: int,
  endOff: int,
  params: int,
  body: int,
}

// Every `FuncDecl`/`ArrowFn` anywhere in `node`'s subtree, nested included: a
// closure defined inside a function is its own function and is measured on
// its own, not folded into the enclosing one's counts.
fn lintCollectFuncs(tree: Tree, node: int, out: []int): []int {
  if (node == 0) {
    return out
  }
  let tag = getNode(tree, node).tag
  if (tag == Tag.FuncDecl || tag == Tag.ArrowFn) {
    out = append(out, node)
  }
  for k of kidsOf(tree, node) {
    out = lintCollectFuncs(tree, k, out)
  }
  return out
}

// `node`'s measurements. `FuncDecl` is `[recv, name, generics, params, result,
// body(, attrs)]` (compiler/parserdecl.bit): the node's own span cannot be used
// for `startOff` because an attribute (the 7th kid) sits BEFORE `function` in
// the source and would widen it past the declaration itself, so `startOff` is
// read explicitly from the receiver (if any) or the name, whichever is
// earliest — both fall on the `function` keyword's line in practice, since
// nothing else can precede them on it. `ArrowFn` has no attrs, so its own
// aggregate span (`ArrowParams` through body) is exactly right, including the
// zero-param case where `ArrowParams` contributes no span at all.
fn lintFuncInfo(tree: Tree, node: int): LintFuncInfo {
  if (getNode(tree, node).tag == Tag.ArrowFn) {
    let k = kidsOf(tree, node)
    let sp = getNode(tree, node).span
    return LintFuncInfo{ reportAt: sp.start, startOff: sp.start, endOff: sp.end,
      params: len(kidsOf(tree, k[0])), body: k[1] }
  }
  let k = kidsOf(tree, node)
  let recv = k[0]
  let start = getNode(tree, k[1]).span.start // name
  if (recv != 0) {
    start = getNode(tree, recv).span.start
  }
  let body = k[5]
  return LintFuncInfo{ reportAt: start, startOff: start, endOff: getNode(tree, body).span.end,
    params: len(kidsOf(tree, k[3])), body: body }
}

// Whether `tag` is a construct spec/LINT.md §4 counts as one nesting level:
// `if`, `while`, `for` (all four loop shapes), a `match` ARM (not the `match`
// itself — a flat 60-arm match stays at depth 1), and a `catch` that binds and
// runs a BLOCK. `catch <expr>` (`CatchDefault`) supplies a plain default value,
// introduces no block, and does not count.
fn lintOpensNesting(tag: Tag): bool {
  return tag == Tag.IfStmt || tag == Tag.WhileStmt || tag == Tag.ForC ||
    tag == Tag.ForOf || tag == Tag.ForIn || tag == Tag.ForInf ||
    tag == Tag.MatchArm || tag == Tag.CatchBind
}

// The deepest nesting reached in `node`'s subtree, starting from `depth`. Stops
// at a nested `FuncDecl`/`ArrowFn` without descending into it — that function's
// own nesting is measured separately, starting back at 0, the same boundary
// `validatestmt.bit`'s `vArrow` draws for its break/loop counters.
fn lintMaxNestingIn(tree: Tree, node: int, depth: int): int {
  if (node == 0) {
    return depth
  }
  let tag = getNode(tree, node).tag
  if (tag == Tag.FuncDecl || tag == Tag.ArrowFn) {
    return depth
  }
  if (tag == Tag.IfStmt) {
    return lintMaxNestingIf(tree, node, depth)
  }
  let childDepth = depth
  if (lintOpensNesting(tag)) {
    childDepth = depth + 1
  }
  let best = depth
  for k of kidsOf(tree, node) {
    let d = lintMaxNestingIn(tree, k, childDepth)
    if (d > best) {
      best = d
    }
  }
  return best
}

// An `if_stmt`'s own contribution to nesting depth (#2127). `if_stmt =
// [cond, thenBlk, elseBlk]` (parserstmt.bit's `parseIfStmt`): `cond` and
// `thenBlk` open a level like any other construct, but `elseBlk` is only a
// GENUINE nested block when it is one — `else { ... }` — a plain `Block`
// node. An `else if` never parses to a block at all: `parseIfStmt` stores the
// chained `if_stmt` directly as `elseBlk`, so it is walked at THIS if's own
// `depth`, continuing the chain rather than descending. Every mainstream
// linter draws the same line (clippy's `excessive_nesting`, eslint's
// `no-lonely-if`): a flat `if / else if / else if / ...` dispatch is one
// decision, not N nested ones, however many arms it has.
fn lintMaxNestingIf(tree: Tree, node: int, depth: int): int {
  let k = kidsOf(tree, node)
  let childDepth = depth + 1
  let best = lintMaxNestingIn(tree, k[0], childDepth) // cond
  let thenDepth = lintMaxNestingIn(tree, k[1], childDepth) // then block
  if (thenDepth > best) {
    best = thenDepth
  }
  let elseNode = k[2]
  if (elseNode != 0) {
    let elseDepth = 0
    if (getNode(tree, elseNode).tag == Tag.IfStmt) {
      elseDepth = lintMaxNestingIn(tree, elseNode, depth) // else-if: same depth
    } else {
      elseDepth = lintMaxNestingIn(tree, elseNode, childDepth) // plain else block
    }
    if (elseDepth > best) {
      best = elseDepth
    }
  }
  return best
}

// E0201 `max-fn-lines`: from the line of the `function` keyword (or an arrow's
// own start) through the line of its closing brace, inclusive (§4).
fn lintMaxFnLines(tree: Tree, funcs: []int, file: int, limit: int, d: Diagnostics) {
  for n of funcs {
    let info = lintFuncInfo(tree, n)
    let startLine = locate(d.sm, file, info.startOff).line
    let endLine = locate(d.sm, file, info.endOff - 1).line
    let lines = endLine - startLine + 1
    if (lines <= limit) {
      continue
    }
    warn(d, ecLintMaxFnLines, Span{ file: file, start: info.reportAt, end: info.reportAt },
      "function is ${lines} lines, limit is ${limit}",
      "split it, or raise the limit with `// bit:lint max-fn-lines=${lines} -- <reason>` " +
        "in the file's leading comment block")
  }
}

// E0202 `max-params`: declared parameters, receiver excluded — a `FuncDecl`'s
// receiver lives in its own `Receiver` kid, never in `Params`, so no
// special-casing is needed here to honour that (§4).
fn lintMaxParams(tree: Tree, funcs: []int, file: int, limit: int, d: Diagnostics) {
  for n of funcs {
    let info = lintFuncInfo(tree, n)
    if (info.params <= limit) {
      continue
    }
    warn(d, ecLintMaxParams, Span{ file: file, start: info.reportAt, end: info.reportAt },
      "function has ${info.params} params, limit is ${limit}",
      "group them into a struct, or raise the limit with `// bit:lint max-params=${info.params} -- <reason>` " +
        "in the file's leading comment block")
  }
}

// E0203 `max-nesting`: nested blocks inside a function body, the body itself
// depth 0 (§4).
fn lintMaxNesting(tree: Tree, funcs: []int, file: int, limit: int, d: Diagnostics) {
  for n of funcs {
    let info = lintFuncInfo(tree, n)
    let depth = lintMaxNestingIn(tree, info.body, 0)
    if (depth <= limit) {
      continue
    }
    warn(d, ecLintMaxNesting, Span{ file: file, start: info.reportAt, end: info.reportAt },
      "function nests ${depth} deep, limit is ${limit}",
      "add an early return, or raise the limit with `// bit:lint max-nesting=${depth} -- <reason>` " +
        "in the file's leading comment block")
  }
}

// E0204 `max-complexity`. McCabe cyclomatic complexity, measured per function
// from the AST: start at 1, add one for each `if`, `while`, `for` (any of its
// four forms), a `match` arm, a `catch` (either the bind or default form), and
// `&&`/`||`. Flat-sensitive, unlike `max-nesting`: a long `match` with many
// one-line arms scores high here while its nesting stays at 1, and a short
// function with a few nested branches can fail this while passing the line
// count — the two rules catch different failures (spec/LINT.md §4).
//
// Takes the same `Tree` `runLintRules` already parsed for the E0201/202/203
// walk — no need for its own parse. The parser recovers from malformed input
// rather than failing outright, so a file `bit check` would reject still
// yields a best-effort tree instead of this rule crashing or silently
// skipping the file — spec/LINT.md §10 open question 2 is still open on what
// `bit lint` should do with such a file, and this rule does not decide it.
fn lintMaxComplexity(t: Tree, file: int, limit: int, d: Diagnostics) {
  let decls = kidsOf(t, t.root)
  let i = 0
  while (i < len(decls)) {
    lintComplexityVisitDecl(t, decls[i], file, limit, d)
    i = i + 1
  }
}

// E0205 `defer-in-loop`. Boolean (no threshold, spec/LINT.md §4): an override
// can only `disable` it, never assign it a value — `lintRules()`'s
// `hasLimit: false` already routes that through the generic "takes no value"
// directive error.
//
// Takes the same `Tree` `runLintRules` already parsed — no need for its own
// parse.
fn lintDeferInLoop(tree: Tree, file: int, d: Diagnostics) {
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.FuncDecl) {
      let kids = kidsOf(tree, i)
      if (kids[5] != 0) {
        lintDeferWalk(tree, file, kids[5], 0, d)
      }
    }
    i = i + 1
  }
}

// Walks one function body for a `defer` lexically inside a `while`/`for`.
// `loopNode` is the nearest enclosing loop (0 outside one), carried down for
// the hint — not just a depth counter, because the message points at that
// specific loop.
//
// An `ArrowFn` resets `loopNode` to 0: a `defer` inside a closure binds to the
// CLOSURE's frame and runs when the arrow returns, not when the enclosing
// function does (spec/LINT.md §4) — so a defer directly in the arrow body must
// not fire even when the arrow itself sits inside a loop, while a defer inside
// a loop that is itself inside the arrow body still must (against that inner
// loop, never the outer one the arrow reset past). This mirrors validatestmt.bit's
// `vArrow`, which restarts `brk`/`loop` at 0 for the identical reason.
//
// Lexical scope only (spec constraint): a defer inside a function merely
// CALLED from a loop is never visited from here — this walk never follows a
// call, only the AST it was handed.
fn lintDeferWalk(t: Tree, file: int, node: int, loopNode: int, d: Diagnostics) {
  if (node == 0) {
    return
  }
  let tag = getNode(t, node).tag
  if (tag == Tag.ArrowFn) {
    for k of kidsOf(t, node) {
      lintDeferWalk(t, file, k, 0, d)
    }
    return
  }
  if (tag == Tag.DeferStmt && loopNode != 0) {
    lintReportDeferInLoop(t, file, node, loopNode, d)
  }
  let next = loopNode
  if (vIsLoop(tag)) {
    next = node
  }
  for k of kidsOf(t, node) {
    lintDeferWalk(t, file, k, next, d)
  }
}

// Reported at the `defer` keyword's span — `DeferStmt`'s span already starts
// there (parserstmt.bit), spanning the keyword plus the deferred call, so the
// keyword alone is the first 5 bytes.
fn lintReportDeferInLoop(t: Tree, file: int, deferNode: int, loopNode: int, d: Diagnostics) {
  let kwStart = getNode(t, deferNode).span.start
  let loopLine = locate(d.sm, file, getNode(t, loopNode).span.start).line + 1
  warn(d, ecLintDeferInLoop, Span{ file: file, start: kwStart, end: kwStart + 5 },
    "defer inside a loop runs at function exit, not loop exit",
    "the enclosing loop starts at line ${loopLine}")
}

// E0212 `unreachable-code`. Grouped in the E021x block for family coherence
// with its dead-weight neighbours (spec/LINT.md §4.2), but unlike them it is
// AST-only: whether a statement follows a diverging one in the same block is
// visible in the tree alone, no resolver needed.
//
// Reuses `vDiverges`/`vBlockDiverges` (validatestmt.bit) — the SAME divergence
// analysis `bit check` uses for E0055 missing-return and catch-block
// completeness — over a bare, resolver-less `Checker` (empty `symbols`/`env`,
// exactly what the dump entry points already use; see `shadowedByValue` and
// `funcRefAt`'s documented fallback). A second, hand-rolled divergence check
// would disagree with the checker's on some construct and report a finding on
// code the checker itself considers fine.
//
// `countBrk: true`, unlike missing-return's own caller: a `break`/`continue`
// always ends the rest of ITS OWN block, whether or not the enclosing
// construct is a loop — the question here is fallthrough within one block,
// not whether a function returns.
fn lintUnreachableCode(tree: Tree, src: string, file: int, d: Diagnostics) {
  let c = newChecker(tree, src, newTypeContext())
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.Block) {
      lintCheckBlockReachability(c, tree, i, file, d)
    }
    i = i + 1
  }
}

// A top-level declaration, possibly wrapped in `export`. Only `func_decl` is
// scored; everything else (types, consts, imports) has no complexity to speak
// of.
fn lintComplexityVisitDecl(t: Tree, idx: int, file: int, limit: int, d: Diagnostics) {
  if (idx == 0) {
    return
  }
  let n = getNode(t, idx)
  if (n.tag == Tag.Export) {
    let kids = kidsOf(t, idx)
    if (len(kids) > 0) {
      lintComplexityVisitDecl(t, kids[0], file, limit, d)
    }
    return
  }
  if (n.tag != Tag.FuncDecl) {
    return
  }
  // `func_decl = [recv, name, generics, params, result, body, attrs?]` (§ast.bit
  // parseFuncDecl): the body is always the 6th child.
  let body = kidsOf(t, idx)[5]
  let score = 1 + lintComplexityWalk(t, body)
  if (score <= limit) {
    return
  }
  warn(d, ecLintMaxComplexity, Span{ file: file, start: n.span.start, end: n.span.end },
    "function complexity is ${score}, limit is ${limit}",
    "split it, or raise the limit with `// bit:lint max-complexity=${score} -- <reason>` " +
      "in the file's leading comment block")
}

// The branch points inside the subtree rooted at `idx` — everything the caller
// adds to the base of 1. A `match_stmt` node itself is not a branch point, only
// its `match_arm` children are; an `if`'s `else` is not a branch point either,
// since it is not one of the counted tags (a plain `else` block just recurses
// through like any other block, and an `else if` is counted because it is its
// own `if_stmt`).
fn lintComplexityWalk(t: Tree, idx: int): int {
  if (idx == 0) {
    return 0
  }
  let n = getNode(t, idx)
  let c = 0
  if (n.tag == Tag.IfStmt || n.tag == Tag.WhileStmt || n.tag == Tag.MatchArm ||
    n.tag == Tag.ForOf || n.tag == Tag.ForIn || n.tag == Tag.ForC || n.tag == Tag.ForInf ||
    n.tag == Tag.CatchBind || n.tag == Tag.CatchDefault) {
    c = 1
  } else if (n.tag == Tag.Binary && (n.main == int(Kind.AmpAmp) || n.main == int(Kind.PipePipe))) {
    c = 1
  }
  let kids = kidsOf(t, idx)
  let i = 0
  while (i < len(kids)) {
    c = c + lintComplexityWalk(t, kids[i])
    i = i + 1
  }
  return c
}

// One finding per dead run, at the FIRST unreachable statement — not one per
// statement, and not the rest of the block, which is all equally unreachable
// once the first one is.
fn lintCheckBlockReachability(c: Checker, tree: Tree, block: int, file: int, d: Diagnostics) {
  let stmts = kidsOf(tree, block)
  let i = 0
  while (i < len(stmts)) {
    if (i + 1 < len(stmts) && vDiverges(c, stmts[i], true)) {
      let divLine = locateOffset(c.source, getNode(tree, stmts[i]).span.start).line + 1
      let sp = getNode(tree, stmts[i + 1]).span
      warn(d, ecLintUnreachableCode, Span{ file: file, start: sp.start, end: sp.end },
        "unreachable code",
        "line ${divLine} always diverts control; nothing after it in this block runs")
      return
    }
    i = i + 1
  }
}

// E0213 `shadowed-local` (spec/LINT.md §4): an inner `let`/`const` (including a
// for/catch/match binder) that hides a name already bound by an enclosing user
// scope. Runs its own private resolve pass over the bare source — the same
// no-project, no-prelude idiom `newChecker`'s dump entry points use (check.bit)
// — so this sees exactly one file's own scope tree. That pass's OWN
// diagnostics (duplicate_declaration, shadows_predeclared) are discarded here;
// only `Resolver.shadows`, `rActivateLocal`'s E0213 bookkeeping (resolve.bit),
// feeds this finding. A parameter/receiver shadowing an outer name is not in
// `r.shadows` at all — see the reasoning at its append site — and neither is a
// `let` shadowing a predeclared or prelude name, since `shadows_predeclared`
// (E0048) already reports that and this rule must not double it (§8).
fn lintShadowedLocal(src: string, file: int, d: Diagnostics) {
  let tree = parseSource(src)
  let scratchSm = newSourceManager()
  let scratchFile = addFile(scratchSm, "", src)
  let mod = SrcModule{ dir: "", fileNames: []string(0), fileStarts: [0], source: src, tree: tree,
    imports: map<string, int>{}, files: [scratchFile] }
  let r = newResolver(newDiagnostics(scratchSm), mod, []Module(0), -1)
  rCollectTopLevel(r)
  rInjectPrelude(r)
  rCheckTypeCycles(r)
  rResolveBodies(r)
  let i = 0
  while (i < len(r.shadows)) {
    let h = r.shadows[i]
    let innerSpan = getNode(tree, h.inner).span
    let outerLoc = locate(d.sm, file, getNode(tree, h.outer).span.start)
    warn(d, ecLintShadowedLocal, Span{ file: file, start: innerSpan.start, end: innerSpan.end },
      "'${h.name}' shadows an outer binding of the same name",
      "outer '${h.name}' declared at ${filePath(d.sm, file)}:${outerLoc.line + 1}:${outerLoc.column + 1}")
    i = i + 1
  }
}

// E0214 `append-aliasing`. `append(s, x)` grows `s` in place and aliases its
// backing array (spec/LINT.md §4): if `s` is a slice-typed PARAMETER and the
// call's result is not assigned straight back to that same parameter, the
// caller's array may be mutated out from under it. This is the rule most
// likely to need overriding — a parameter a function genuinely owns looks
// identical, from the AST, to one the caller still holds — so it fires on the
// shape alone and leaves the judgement call to `// bit:lint disable
// append-aliasing`.
//
// Deliberately narrow (spec/LINT.md constraints): PARAMETERS only, never a
// struct field or a call result, and never an attempt to prove the caller
// actually reuses the slice afterward — that is the whole-program view this
// rule avoids. A same-named local `let` shadowing the parameter is a false
// positive this rule accepts rather than resolves (spec/LINT.md §4).
fn lintAppendAliasing(tree: Tree, src: string, file: int, d: Diagnostics) {
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.FuncDecl) {
      lintAppendAliasingFunc(tree, src, file, i, d)
    }
    i = i + 1
  }
}

// `func_decl = [recv, name, generics, params, result, body(, attrs)]`
// (compiler/parserdecl.bit): params is kid 3, the body block is kid 5.
fn lintAppendAliasingFunc(tree: Tree, src: string, file: int, funcNode: int, d: Diagnostics) {
  let k = kidsOf(tree, funcNode)
  let names = lintSliceParamNames(tree, src, k[3])
  if (len(names) == 0) {
    return
  }
  let protected = lintProtectedAppends(tree, src, k[5], []int(0))
  lintFindAppendAliasing(tree, src, file, k[5], names, protected, d)
}

// The names of `params`' slice-typed parameters (`param = [name, type]`,
// compiler/parserdecl.bit). A method receiver is never in this list — it is
// not a kid of `params` at all — so it can never be flagged.
fn lintSliceParamNames(tree: Tree, src: string, params: int): []string {
  let out = []string(0)
  for pn of kidsOf(tree, params) {
    if (getNode(tree, pn).tag != Tag.Param) {
      continue // a `...rest` param is excluded; its ownership rules differ
    }
    let pk = kidsOf(tree, pn)
    if (getNode(tree, pk[1]).tag == Tag.SliceType) {
      let nm = getNode(tree, pk[0]).span
      out = append(out, src[nm.start:nm.end])
    }
  }
  return out
}

// True iff `node` is a `call` whose callee is the bare identifier `append`.
fn lintIsAppendCall(tree: Tree, src: string, node: int): bool {
  if (getNode(tree, node).tag != Tag.Call) {
    return false
  }
  let callee = getNode(tree, kidsOf(tree, node)[0])
  if (callee.tag != Tag.Ident) {
    return false
  }
  return src[callee.span.start:callee.span.end] == "append"
}

// The name `append`'s first argument resolves to, or "" if it is not a bare
// identifier (`append(f(), x)` can never alias a parameter this rule can
// name). `args` holds `arg`/`arg_spread` nodes each wrapping one expression
// (compiler/parser.bit's `parseArgItem`).
fn lintAppendFirstArgName(tree: Tree, src: string, node: int): string {
  let argKids = kidsOf(tree, kidsOf(tree, node)[2])
  if (len(argKids) == 0) {
    return ""
  }
  let expr = getNode(tree, kidsOf(tree, argKids[0])[0])
  if (expr.tag != Tag.Ident) {
    return ""
  }
  return src[expr.span.start:expr.span.end]
}

// Every `append` call node, anywhere under `node`, whose result is assigned
// straight back to the same name it was called on — `p = append(p, x)` — and
// so must not be flagged. Only this exact shape counts: routing the result
// through a temporary before reassigning is indistinguishable, from the AST,
// from never reassigning it at all, so it is not specially recognised either
// (accepted per spec/LINT.md — override, don't chase the flow).
fn lintProtectedAppends(tree: Tree, src: string, node: int, out: []int): []int {
  if (node == 0) {
    return out
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.Assign) {
    let k = kidsOf(tree, node)
    let lhs = kidsOf(tree, k[0])
    let rhs = kidsOf(tree, k[1])
    let i = 0
    while (i < len(lhs) && i < len(rhs)) {
      let lhsNode = getNode(tree, lhs[i])
      if (lhsNode.tag == Tag.Ident && lintIsAppendCall(tree, src, rhs[i])) {
        let lhsName = src[lhsNode.span.start:lhsNode.span.end]
        if (lintAppendFirstArgName(tree, src, rhs[i]) == lhsName) {
          out = append(out, rhs[i])
        }
      }
      i = i + 1
    }
  }
  for kid of kidsOf(tree, node) {
    out = lintProtectedAppends(tree, src, kid, out)
  }
  return out
}

// Reports every unprotected `append` call in `node`'s subtree whose first
// argument is one of `names` (this function's slice-typed parameters).
fn lintFindAppendAliasing(tree: Tree, src: string, file: int, node: int,
  names: []string, protected: []int, d: Diagnostics) {
  if (node == 0) {
    return
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.Call && lintIsAppendCall(tree, src, node) && !lintContainsInt(protected, node)) {
    let argName = lintAppendFirstArgName(tree, src, node)
    if (argName != "" && lintContainsString(names, argName)) {
      warn(d, ecLintAppendAliasing, n.span,
        "append on parameter '${argName}' may alias the caller's backing array",
        "if '${argName}' is owned by this function, silence with `// bit:lint disable append-aliasing -- <reason>` " +
          "in the file's leading comment block; otherwise assign the result back: ${argName} = append(${argName}, ...)")
    }
  }
  for kid of kidsOf(tree, node) {
    lintFindAppendAliasing(tree, src, file, kid, names, protected, d)
  }
}

fn lintContainsInt(xs: []int, v: int): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == v) {
      return true
    }
    i = i + 1
  }
  return false
}

fn lintContainsString(xs: []string, v: string): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == v) {
      return true
    }
    i = i + 1
  }
  return false
}

// ---------------------------------------------------------------------------
// 4. Output
// ---------------------------------------------------------------------------

// One JSON string literal, escaping what RFC 8259 requires. Control bytes take
// the `\u00XX` long form rather than the `\n`/`\t` shorthands — both are valid
// and parse identically, and lint messages are generated ASCII, so the shorter
// form would only buy bytes.
fn lintJsonString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      out = out + "\\\""
    } else if (c == '\\') {
      out = out + "\\\\"
    } else if (c < 32) {
      out = out + "\\u00" + lintHexByte(c)
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "\""
}

fn lintHexByte(c: u8): string {
  let digits = "0123456789abcdef"
  let hi = int(c) / 16
  let lo = int(c) - hi * 16
  return digits[hi:hi + 1] + digits[lo:lo + 1]
}

// The diagnostics as the LSP-shaped array `bit check --json` already emits
//: same keys, same 0-based line/character
// range, so editors and CI parse one format for both tools.
fn lintRenderJson(d: Diagnostics): string {
  let out = "["
  let i = 0
  while (i < len(d.list)) {
    if (i > 0) {
      out = out + ","
    }
    let g = d.list[i]
    let s = locate(d.sm, g.span.file, g.span.start)
    let e = locate(d.sm, g.span.file, g.span.end)
    out = out + "{\"code\":" + lintJsonString(codeString(g.code))
    out = out + ",\"severity\":" + lintJsonString(severityLabel(g.severity))
    out = out + ",\"file\":" + lintJsonString(filePath(d.sm, g.span.file))
    out = out + ",\"range\":{\"start\":{\"line\":${s.line},\"character\":${s.column}}"
    out = out + ",\"end\":{\"line\":${e.line},\"character\":${e.column}}}"
    out = out + ",\"message\":" + lintJsonString(g.message)
    if (g.hasHint) {
      out = out + ",\"hint\":" + lintJsonString(g.hint)
    }
    out = out + "}"
    i = i + 1
  }
  return out + "]"
}

// Orders findings by file path, then line, then code — the order golden tests
// pin. Insertion sort: the list is one finding per rule per file, so it stays
// small, and the sort is stable so equal keys keep discovery order.
fn lintSortDiags(d: Diagnostics) {
  let i = 1
  while (i < len(d.list)) {
    let j = i
    while (j > 0 && lintDiagLess(d, d.list[j], d.list[j - 1])) {
      let tmp = d.list[j - 1]
      d.list[j - 1] = d.list[j]
      d.list[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
}

fn lintDiagLess(d: Diagnostics, a: Diagnostic, b: Diagnostic): bool {
  let pa = filePath(d.sm, a.span.file)
  let pb = filePath(d.sm, b.span.file)
  if (pa != pb) {
    return compare(pa, pb) < 0
  }
  let la = locate(d.sm, a.span.file, a.span.start).line
  let lb = locate(d.sm, b.span.file, b.span.start).line
  if (la != lb) {
    return la < lb
  }
  return a.code < b.code
}

// ---------------------------------------------------------------------------
// 5. The command
// ---------------------------------------------------------------------------

// Parsed `bit lint` argv.
struct LintArgs {
  json: bool,
  stats: bool,
  paths: []string,
  ok: bool,
  badFlag: string,
}

// `a` is the whole argv; `a[1]` is `lint`. An unknown flag is a usage error.
// Reports nothing itself — the caller owns stderr, so this stays a pure
// function a self-check can call without polluting a green test run.
fn parseLintArgs(a: []string): LintArgs {
  let out = LintArgs{ json: false, stats: false, paths: []string(0), ok: true, badFlag: "" }
  let i = 2
  while (i < len(a)) {
    if (a[i] == "--json") {
      out.json = true
    } else if (a[i] == "--stats") {
      out.stats = true
    } else if (len(a[i]) > 1 && a[i][0] == '-') {
      out.ok = false
      out.badFlag = a[i]
      return out
    } else {
      out.paths = append(out.paths, a[i])
    }
    i = i + 1
  }
  if (len(out.paths) == 0) {
    out.paths = append(out.paths, ".")
  }
  return out
}

// Every `.bit` file named by `paths`: a directory is walked recursively, a file
// is taken as given (lint honours an explicit path even if it is not `.bit`).
// Returns an empty slice and reports on an unreadable path — exit 2, because a
// path the user named and lint could not read is a silent hole in the run.
//
// Each result records whether it came from a DIRECTORY walk or was named
// explicitly (`LintFile.swept`, compiler/lintmodule.bit) — E0210's
// module-scoping (#2284) needs that distinction: naming a directory sweeps in
// every sibling `.bit` file's usage, naming a file does not, mirroring
// `loadModuleAt`'s `only` parameter (compiler/project.bit).
fn collectLintFiles(paths: []string): []LintFile! {
  let out = []LintFile(0)
  for p of paths {
    if (fsIsDir(p)) {
      let found = walk(p) catch e {
        eprint("bit lint: ${p}: ${e.message()}\n")
        fail newError("unreadable path")
      }
      for f of found {
        if (lintHasSuffix(f, ".bit")) {
          out = append(out, LintFile{ path: f, swept: true })
        }
      }
      continue
    }
    if (!fsExists(p)) {
      eprint("bit lint: ${p}: no such file or directory\n")
      fail newError("unreadable path")
    }
    out = append(out, LintFile{ path: p, swept: false })
  }
  return lintSortFiles(out)
}

fn lintHasSuffix(s: string, suffix: string): bool {
  if (len(suffix) > len(s)) {
    return false
  }
  return s[len(s) - len(suffix):len(s)] == suffix
}

// `bit lint [--json] [--stats] [paths...]`. Returns the process exit code:
// 0 no findings, 1 at least one finding, 2 usage error / unreadable path /
// malformed directive (§2.1).
fn lintCmd(a: []string): int {
  let opts = parseLintArgs(a)
  if (!opts.ok) {
    eprint("bit lint: unknown flag '${opts.badFlag}'\n")
    eprint("usage: bit lint [--json] [--stats] [paths...]\n")
    return 2
  }
  let files = collectLintFiles(opts.paths) catch e {
    return 2
  }

  let sm = newSourceManager()
  // Two sinks, because they have different fates: a directive error is an
  // error-severity diagnostic that aborts the run with exit 2, while a finding
  // is a warning that must never bump `errorCount` (diagnostics.bit:93).
  let errs = newDiagnostics(sm)
  let findings = newDiagnostics(sm)
  let overrides = 0
  // Which files (by SourceManager id) came from a directory walk — #2284's
  // module-scoping for E0210 only applies to those; a file named explicitly
  // on argv is its own singleton module, exactly like `loadModuleAt`'s `only`.
  let sweptFiles = map<int, bool>{}
  let moduleCache = newLintModuleCache()

  for lf of files {
    let path = lf.path
    let src = readFile(path) catch e {
      eprint("bit lint: ${path}: ${e.message()}\n")
      return 2
    }
    let file = addFile(sm, path, src)
    if (lf.swept) {
      sweptFiles[file] = true
    }
    let cfg = readLintDirectives(src, file, errs)
    // Counted over EVERY file walked, not only files with findings (§2.2): the
    // number exists to make a raised limit visible, and a raised limit is
    // precisely a file that no longer has a finding.
    overrides = overrides + lintOverrideCount(cfg)
    if (hasErrors(errs)) {
      continue // keep reading the rest, then report every bad directive at once
    }
    if (opts.stats) {
      for note of lintOverrideNotes(cfg) {
        print("${path}: ${note}\n")
      }
      continue
    }
    // The phase-1 rules need an AST (§4). A file `bit check` would reject
    // parses into a recovered tree with holes a rule would read as real nodes
    // — noise on top of the syntax errors that caused them, the same reason
    // `checkFile` stops there (compiler/check.bit:1072). So a parse error is
    // reported through the SAME sink and exit path as a directive error
    // (§10 open question 2): it already carries an exact span and message,
    // and a run with one is not asked to compute findings under it either.
    let tree = parseSourceD(src, file, errs)
    if (hasErrors(errs)) {
      continue
    }
    runLintRules(src, file, tree, cfg, findings)
  }
  // #2284: an import a swept file's sibling uses is genuinely used — drop the
  // E0210 findings runLintRules computed per-file-in-isolation for those.
  lintDropModuleUsedImports(findings, moduleCache, sweptFiles)

  // A malformed override or a file that does not parse is reported instead of
  // findings, not alongside them: either one means the findings for that file
  // were never computed, so reporting a finding set nobody asked for would be
  // wrong.
  if (hasErrors(errs)) {
    lintSortDiags(errs)
    if (opts.json) {
      print(lintRenderJson(errs) + "\n")
    } else {
      eprint(renderDiags(errs))
    }
    eprint("lint: ${len(errs.list)} errors, ${overrides} overrides active\n")
    return 2
  }

  lintSortDiags(findings)
  let n = len(findings.list)
  if (opts.json) {
    print(lintRenderJson(findings) + "\n")
  } else {
    eprint(renderDiags(findings))
  }
  // Printed on EVERY run, clean ones included, and never suppressible: any
  // limit can be raised by editing the source, so this count is what keeps that
  // from happening quietly (§2.2).
  eprint("lint: ${n} findings, ${overrides} overrides active\n")
  if (opts.stats) {
    return 0
  }
  if (n > 0) {
    return 1
  }
  return 0
}
