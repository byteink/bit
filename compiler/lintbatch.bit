// `bit lint` diagnostic rendering and the `bit lint` command itself (#2470,
// split out of compiler/lint.bit — 1362 lines against the 800-line limit).
// compiler/lint.bit keeps the rule registry and the `// bit:lint` override
// directive reader; compiler/lintapply.bit keeps the dispatcher and most
// rules' own check functions (`append-aliasing`/E0214's moved to
// compiler/lintappend.bit under #3688), which `lintCmd` here calls via
// `runLintRules`; compiler/lintallow.bit keeps the per-finding `allow`
// override (#2438), which `lintCmd` applies via `lintApplyAllows` right after
// `runLintRules`.
//
// Named to sort after compiler/lint.bit, compiler/lintallow.bit,
// compiler/lintappend.bit and compiler/lintapply.bit, whose types and
// functions it calls, and before compiler/lintcheck.bit, whose self-checks
// call `parseLintArgs`, `lintRenderJson` and `lintSortDiags` directly —
// module files concatenate in bytewise filename order
// (compiler/project.bit:7).
import { compare } from "std/strings"

// One JSON string literal, escaping what RFC 8259 requires. Control bytes take
// the `\u00XX` long form rather than the `\n`/`\t` shorthands — both are valid
// and parse identically, and lint messages are generated ASCII, so the shorter
// form would only buy bytes.
fn lintJsonString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      out = out + "\\\""
    } else if (c == '\\') {
      out = out + "\\\\"
    } else if (c < 32) {
      out = out + "\\u00" + lintHexByte(c)
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "\""
}

fn lintHexByte(c: u8): string {
  let digits = "0123456789abcdef"
  let hi = int(c) / 16
  let lo = int(c) - hi * 16
  return digits[hi:hi + 1] + digits[lo:lo + 1]
}

// The diagnostics as the LSP-shaped array `bit check --json` already emits
//: same keys, same 0-based line/character
// range, so editors and CI parse one format for both tools.
fn lintRenderJson(d: Diagnostics): string {
  let out = "["
  let i = 0
  while (i < len(d.list)) {
    if (i > 0) {
      out = out + ","
    }
    let g = d.list[i]
    let s = locate(d.sm, g.span.file, g.span.start)
    let e = locate(d.sm, g.span.file, g.span.end)
    out = out + "{\"code\":" + lintJsonString(codeString(g.code))
    out = out + ",\"severity\":" + lintJsonString(severityLabel(g.severity))
    out = out + ",\"file\":" + lintJsonString(filePath(d.sm, g.span.file))
    out = out + ",\"range\":{\"start\":{\"line\":${s.line},\"character\":${s.column}}"
    out = out + ",\"end\":{\"line\":${e.line},\"character\":${e.column}}}"
    out = out + ",\"message\":" + lintJsonString(g.message)
    if (g.hasHint) {
      out = out + ",\"hint\":" + lintJsonString(g.hint)
    }
    out = out + "}"
    i = i + 1
  }
  return out + "]"
}

// Orders findings by file path, then line, then code — the order golden tests
// pin. Insertion sort: the list is one finding per rule per file, so it stays
// small, and the sort is stable so equal keys keep discovery order.
fn lintSortDiags(d: Diagnostics) {
  let i = 1
  while (i < len(d.list)) {
    let j = i
    while (j > 0 && lintDiagLess(d, d.list[j], d.list[j - 1])) {
      let tmp = d.list[j - 1]
      d.list[j - 1] = d.list[j]
      d.list[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
}

fn lintDiagLess(d: Diagnostics, a: Diagnostic, b: Diagnostic): bool {
  let pa = filePath(d.sm, a.span.file)
  let pb = filePath(d.sm, b.span.file)
  if (pa != pb) {
    return compare(pa, pb) < 0
  }
  let la = locate(d.sm, a.span.file, a.span.start).line
  let lb = locate(d.sm, b.span.file, b.span.start).line
  if (la != lb) {
    return la < lb
  }
  return a.code < b.code
}

// ---- The `bit lint` command -------------------------------------------------

// Parsed `bit lint` argv.
class LintArgs {
  json: bool,
  stats: bool,
  paths: []string,
  ok: bool,
  badFlag: string,
}

// `a` is the whole argv; `a[1]` is `lint`. An unknown flag is a usage error.
// Reports nothing itself — the caller owns stderr, so this stays a pure
// function a self-check can call without polluting a green test run.
fn parseLintArgs(a: []string): LintArgs {
  let out = LintArgs{ json: false, stats: false, paths: []string(0), ok: true, badFlag: "" }
  let i = 2
  while (i < len(a)) {
    if (a[i] == "--json") {
      out.json = true
    } else if (a[i] == "--stats") {
      out.stats = true
    } else if (len(a[i]) > 1 && a[i][0] == '-') {
      out.ok = false
      out.badFlag = a[i]
      return out
    } else {
      out.paths = append(out.paths, a[i])
    }
    i = i + 1
  }
  if (len(out.paths) == 0) {
    out.paths = append(out.paths, ".")
  }
  return out
}

// Every `.bit` file named by `paths`: a directory is walked recursively, a file
// is taken as given (lint honours an explicit path even if it is not `.bit`).
// Returns an empty slice and reports on an unreadable path — exit 2, because a
// path the user named and lint could not read is a silent hole in the run.
//
// The directory walk shares `collectProjectBitFiles` (projectcli.bit) with
// `bit fmt`/`bit check`/`bit test` rather than running its own `std/fs.walk`
// (#4154): before this, `bit lint <dir>` descended into `.claude/worktrees/`
// and `bit-out/` with no filtering at all. `skipVendor: false` — an explicit
// directory operand keeps walking a literal `vendor/` subdirectory exactly as
// `bit test <dir>` always has.
//
// Each result records whether it came from a DIRECTORY walk or was named
// explicitly (`LintFile.swept`, compiler/lintmodule.bit) — E0210's
// module-scoping (#2284) needs that distinction: naming a directory sweeps in
// every sibling `.bit` file's usage, naming a file does not, mirroring
// `loadModuleAt`'s `only` parameter (compiler/project.bit).
fn collectLintFiles(paths: []string): []LintFile! {
  let out = []LintFile(0)
  for p of paths {
    if (fsIsDir(p)) {
      for f of collectProjectBitFiles(p, false) {
        out = append(out, LintFile{ path: f, swept: true })
      }
      continue
    }
    if (!fsExists(p)) {
      eprint("bit lint: ${p}: no such file or directory\n")
      fail newError("unreadable path")
    }
    out = append(out, LintFile{ path: p, swept: false })
  }
  return lintSortFiles(out)
}


// `bit lint [--json] [--stats] [paths...]`. Returns the process exit code:
// 0 no findings, 1 at least one finding, 2 usage error / unreadable path /
// malformed directive (§2.1).
fn lintCmd(a: []string): int {
  let opts = parseLintArgs(a)
  if (!opts.ok) {
    eprint("bit lint: unknown flag '${opts.badFlag}'\n")
    eprint("usage: bit lint [--json] [--stats] [paths...]\n")
    return 2
  }
  let files = collectLintFiles(opts.paths) catch _ {
    return 2
  }

  let sm = newSourceManager()
  // Two sinks, because they have different fates: a directive error is an
  // error-severity diagnostic that aborts the run with exit 2, while a finding
  // is a warning that must never bump `errorCount` (diagnostics.bit:93).
  let ctx = LintBatchCtx{
    sm: sm,
    opts: opts,
    errs: newDiagnostics(sm),
    findings: newDiagnostics(sm),
    // Which files (by SourceManager id) came from a directory walk —
    // #2284's module-scoping for E0210 only applies to those; a file named
    // explicitly on argv is its own singleton module, exactly like
    // `loadModuleAt`'s `only`.
    sweptFiles: map<int, bool>{},
  }
  let overrides = 0
  let moduleCache = newLintModuleCache()
  // Files lint could not even open. Isolated the same way as a bad directive
  // or a parse error (#3543): there is no span to attach the failure to, so it
  // never reaches `ctx.errs`, but it still forces exit 2 and is still reported.
  let fileErrors = 0

  for lf of files {
    let src = readFile(lf.path) catch e {
      eprint("bit lint: ${lf.path}: ${e.message()}\n")
      fileErrors = fileErrors + 1
      continue // per-file isolation (#3543): keep reading the rest
    }
    overrides = overrides + lintOneFile(lf, src, ctx)
  }
  // #2284: an import a swept file's sibling uses is genuinely used — drop the
  // E0210 findings runLintRules computed per-file-in-isolation for those.
  lintDropModuleUsedImports(ctx.findings, moduleCache, ctx.sweptFiles)

  return lintReport(opts, ctx.errs, ctx.findings, overrides, fileErrors)
}

// The state one `bit lint` invocation threads through every file: the shared
// source manager and options, the two sinks `lintOneFile` reports into, and
// which files came from a directory walk. Grouped into one struct so
// `lintOneFile` takes 3 params instead of 7 (E0202).
class LintBatchCtx {
  sm: SourceManager,
  opts: LintArgs,
  errs: Diagnostics,
  findings: Diagnostics,
  sweptFiles: map<int, bool>,
}

// One file's worth of `lintCmd`'s loop body: directives, then (unless a
// directive was bad) either the `--stats` notes or the parse-and-lint pass.
// Isolated to THIS file (#3543): a bad directive or a parse error here stops
// only this file's own findings from being computed and returns early — it
// never touches `findings` for any file already processed, and the caller
// keeps walking the rest of `files` regardless. Returns the override count
// this file contributed (§2.2), 0 once it hits an error since no further
// directive or `allow` line of this file is read past that point.
fn lintOneFile(lf: LintFile, src0: string, ctx: LintBatchCtx): int {
  let src = stripBom(src0)
  let file = addFile(ctx.sm, lf.path, src)
  if (lf.swept) {
    ctx.sweptFiles[file] = true
  }
  let errs = ctx.errs
  let findings = ctx.findings
  let opts = ctx.opts
  let errsBefore = errs.errorCount
  let cfg = readLintDirectives(src, file, errs)
  // Counted over EVERY file walked, not only files with findings (§2.2): the
  // number exists to make a raised limit visible, and a raised limit is
  // precisely a file that no longer has a finding.
  let overrides = lintOverrideCount(cfg)
  if (errs.errorCount > errsBefore) {
    return overrides // this file's directive is bad; its findings are never computed
  }
  if (opts.stats) {
    for note of lintOverrideNotes(cfg) {
      print("${lf.path}: ${note}\n")
    }
    return overrides
  }
  // The phase-1 rules need an AST (§4). A file `bit check` would reject
  // parses into a recovered tree with holes a rule would read as real nodes
  // — noise on top of the syntax errors that caused them, the same reason
  // `checkFile` stops there (compiler/check.bit:1072). So a parse error is
  // reported through the SAME sink and exit path as a directive error
  // (§10 open question 2): it already carries an exact span and message,
  // and this file is not asked to compute findings under it either.
  let tree = parseSourceD(src, file, errs)
  if (errs.errorCount > errsBefore) {
    return overrides
  }
  runLintRules(src, file, tree, cfg, findings)
  // Per-finding `allow` overrides (spec/LINT.md §5.5, compiler/lintallow.bit)
  // apply against exactly this file's just-computed findings, independent of
  // `cfg`'s file-scoped disables above. Counted into the same `overrides`
  // total for the same reason (§2.2): a silenced finding must show up in
  // the summary even when the `allow` line itself is skimmed past.
  return overrides + lintApplyAllows(src, file, findings)
}

// Renders the run and picks the exit code. Errors (a malformed directive, an
// unparseable file, a file lint could not read) are reported ALONGSIDE any
// findings already computed for the OTHER files in this run (#3543), not
// instead of them: only the broken files' own findings were never computed,
// and every other file's findings still stand. The exit code stays 2
// whenever any error occurred, so a caller checking only "did findings
// appear" cannot mistake this for a clean run.
fn lintReport(
  opts: LintArgs,
  errs: Diagnostics,
  findings: Diagnostics,
  overrides: int,
  fileErrors: int,
): int {
  let n = len(findings.list)
  let errCount = errs.errorCount + fileErrors
  let combined = lintMergeDiags(errs, findings)
  lintSortDiags(combined)
  if (opts.json) {
    print(lintRenderJson(combined) + "\n")
  } else {
    eprint(renderDiags(combined))
  }
  // Printed on EVERY run, clean ones included, and never suppressible: any
  // limit can be raised by editing the source, so this count is what keeps that
  // from happening quietly (§2.2).
  eprint(lintSummaryLine(n, errCount, overrides))
  if (errCount > 0) {
    return 2
  }
  if (opts.stats) {
    return 0
  }
  if (n > 0) {
    return 1
  }
  return 0
}

// The one stderr line every run prints, including clean ones (§2.2). Kept
// byte-identical to the pre-#3543 text in the two cases that already had
// goldens pinned to it (errors-only, findings-only); the third case --
// errors alongside findings, only reachable now that files are isolated --
// gets a new format that names both.
fn lintSummaryLine(n: int, errCount: int, overrides: int): string {
  if (errCount > 0 && n > 0) {
    return "lint: ${n} findings, ${errCount} errors, ${overrides} overrides active\n"
  }
  if (errCount > 0) {
    return "lint: ${errCount} errors, ${overrides} overrides active\n"
  }
  return "lint: ${n} findings, ${overrides} overrides active\n"
}

// Concatenates two Diagnostics' lists for a single sorted render/JSON pass
// over both a run's errors and its findings (#3543). Bounded by the two
// lists' combined length, which is one finding or error per rule per file.
fn lintMergeDiags(a: Diagnostics, b: Diagnostics): Diagnostics {
  let out = newDiagnostics(a.sm)
  for d of a.list {
    out.list = append(out.list, d)
  }
  for d of b.list {
    out.list = append(out.list, d)
  }
  return out
}
