// compiler/lowerrtcallabi.bit — split out of lowerprim.bit (#5598) to bring
// lowerprim.bit under the repo's 800-line limit (E0200). Sibling of
// lowerprim.bit: same module, so this needs no imports and no call-site
// changes.
//
// The `rt_call` word/float ABI-crossing helpers: `emitRtCall` is the single
// lowering entry point every `rt_call` goes through, and `wordIntTy`/`pow2`
// are its own two direct helpers (the float-to-word type it bitcasts through,
// and the bit index into the arg word-mask) — grouped together because they
// have no reader outside this trio and no doc comment anywhere else names
// them, unlike `lowerAtomic`/`assertAtomicOperandWidth`/`lowerLen`/
// `lowerConvert`/`primRtName` and the rest of lowerprim.bit's primitive
// dispatch, which stay behind because external comments (test fixtures,
// runtime/ABI.md, sibling lower*.bit files) cite them by name at
// "lowerprim.bit" and moving them would break those citations
// (test-fmt-citations) in files this split does not otherwise touch.

// The integer word type a float of type `ty` crosses the container word ABI as,
// or -1 when `ty` is not a float. `f32` uses `u32` so the bitcast on each side
// is a 32-bit transfer — the stored word is zero-extended, so the round trip is
// exact.
fn wordIntTy(fc: FnCtx, ty: int): int {
  let d = fc.c.ctx.types[ty]
  if (d.kind != TypeKind.Prim) {
    return -1
  }
  if (d.prim == 9) {
    return primType(fc.c.ctx, 7)
  }
  if (d.prim == 8) {
    return primType(fc.c.ctx, 6)
  }
  return -1
}

// The single lowering entry point for every `rt_call`. The container primitives
// declare their element operands and results as an untyped `u64` word
// (ir.bit's `rtWordArgs`/`rtReturnsWord`), so a float element must cross that
// boundary as its bit pattern, in an integer register. Emitting the bitcasts
// here — rather than letting codegen classify the operand by its Bit type —
// keeps the IR honest about the callee's actual C signature and fixes every
// backend at once. A non-word position, and any non-float type, passes through.
fn emitRtCall(fc: FnCtx, ins: IrInstr): int {
  let mask = rtWordArgs(ins.name)
  if (mask != 0) {
    let cast = []int(0)
    let i = 0
    for a of ins.args {
      let bit = mask / pow2(i) % 2
      let wt = -1
      if (bit == 1) {
        wt = wordIntTy(fc, fc.b.instrs[a].ty)
      }
      if (wt < 0) {
        cast = append(cast, a)
      } else {
        let bc = mkInstr(Op.Bitcast, wt)
        bc.lhs = a
        cast = append(cast, builderEmit(fc.b, bc))
      }
      i = i + 1
    }
    ins.args = cast
  }
  if (rtReturnsWord(ins.name)) {
    let rt = wordIntTy(fc, ins.ty)
    if (rt >= 0) {
      let resTy = ins.ty
      ins.ty = rt
      let word = builderEmit(fc.b, ins)
      let bc = mkInstr(Op.Bitcast, resTy)
      bc.lhs = word
      return builderEmit(fc.b, bc)
    }
  }
  return builderEmit(fc.b, ins)
}

// 2^n for the small, statically bounded `n` the word-argument mask needs.
fn pow2(n: int): int {
  let v = 1
  let i = 0
  for (; i < n; i = i + 1) {
    v = v * 2
  }
  return v
}

// SPEC §11.7 / runtime/ABI.md §8.5 (#7842): does a call to `t` enter the
// syscall bracket? A user `extern fn` binds a symbol the runtime cannot see
// into, so the call may block its worker's OS thread for as long as the foreign
// code likes; unbracketed, the monitor cannot hand the worker's queue to a peer
// (`rootRetakeScan`) and a collection waits for the thread. Go brackets every
// cgo call the same way (`cgocall` -> `entersyscall`/`exitsyscall`).
//
// Two kinds of extern are the runtime's own and are never bracketed, because
// the runtime runs them inside the scheduler and the collector, where a nested
// bracket would publish a second `syscall` state over the first: one declared
// in a module under `runtime/` (`Checker.runtimeModule`), and a `bit_rt_*`
// symbol wherever it is declared (the stdlib reaches the runtime ABI that way;
// each such primitive brackets itself where it blocks). The rule is on the
// DECLARATION, so every call to the same extern agrees. `@nonblocking` on the
// declaration is the author's opt-out for a call that cannot block (a pure
// libm or memcpy-like function), which saves the bracket's cost per call.
fn externCallBracketed(t: CallTarget): bool {
  if (t.decl == 0 || !isExternDecl(t.owner.tree, t.decl)) {
    return false
  }
  if (t.owner.runtimeModule || startsWith(t.symbol, "bit_rt_")) {
    return false
  }
  return !externHasAttr(t.owner, t.decl, "nonblocking")
}

// True if the `extern fn` declaration carries `@want` (§11.7): its attr_list is
// the 4th kid, elided for an attr-less extern (`parseExternFnDecl`).
fn externHasAttr(c: Checker, decl: int, want: string): bool {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 3 || kids[3] == 0) {
    return false
  }
  for a of kidsOf(c.tree, kids[3]) {
    let an = getNode(c.tree, kidsOf(c.tree, a)[0])
    if (c.source[an.span.start:an.span.end] == want) {
      return true
    }
  }
  return false
}

// One zero-argument `rt_call` to a `bit_rt_*` bracket primitive.
fn emitBracketCall(fc: FnCtx, name: string) {
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  ins.name = name
  builderEmit(fc.b, ins)
}

// The `Op.Call` for a resolved callee, between `gc_syscall_begin` and
// `gc_syscall_end` when `externCallBracketed`. An extern's result is a scalar or
// a raw pointer and it has no error word (E0077), so nothing needs to sit
// between the call and the closing bracket (§5.1's adjacency contract covers
// only multi-word results and error words, which an extern cannot return).
fn emitTargetCall(fc: FnCtx, t: CallTarget, ins: IrInstr): int {
  if (!externCallBracketed(t)) {
    return builderEmit(fc.b, ins)
  }
  emitBracketCall(fc, "gc_syscall_begin")
  let call = builderEmit(fc.b, ins)
  emitBracketCall(fc, "gc_syscall_end")
  return call
}
