// #6299 (M1a): `loadProjectCached`'s `lockRoot` support, split out of
// project.bit (already at spec/LINT.md's 800-line ceiling, per the ticket)
// rather than growing it further. Sibling .bit files are the same module,
// so `loadProjectCached` and `loadProjectOverlay` (project.bit) call these
// directly.

// Bundles `loadProjectCached`'s two LSP-only inputs into one parameter,
// keeping its declared parameter count at spec/LINT.md's E0202 ceiling (5)
// after adding `lockRoot`: `overlays` and `parseCache` are always passed
// together, and both are non-empty for exactly one caller, `bit lsp`
// (lspbuild.bit) — every other caller passes both empty via
// `emptyLoaderIncremental`, below, unchanged from before this existed.
class LoaderIncremental {
  overlays: map<string, string>,
  parseCache: map<string, SrcModule>,
  // Load std/json right after the prelude (projectpreload.bit).
  preloadJson: bool,
  // Fork every module's tree and keep the parsed one for the next build (`bit lsp`, #7161).
  keepRaw: bool,
}

// What every caller other than `bit lsp` passes: no unsaved-buffer overlay,
// no cross-build parse reuse.
fn emptyLoaderIncremental(): LoaderIncremental {
  return overlayLoaderIncremental(map<string, string>{})
}

// `loadProjectOverlay`'s own shape: an unsaved-buffer overlay, but never
// cross-build parse reuse (only `bit lsp`, through `LspServer`, has a
// process to reuse a previous build's trees from).
fn overlayLoaderIncremental(overlays: map<string, string>): LoaderIncremental {
  return LoaderIncremental{
    overlays = overlays,
    parseCache = map<string, SrcModule>{},
    preloadJson = false,
    keepRaw = false,
  }
}

// Resolves `loadProjectCached`/`buildIr`'s `lockRoot` parameter: where
// `bit.lock`/`bit.json` are read from, and where a local-path dependency's
// relative `localPath` resolves against (`resolvePackageImportUncached`,
// projectpkg.bit). `""` (every caller before #6299) means `rootDir` itself,
// unchanged from before this parameter existed — a non-"" caller (M1b, a
// generated `.bit/cmd/...` entry) builds a module against an ancestor
// directory's lock file instead. A default value cannot read `rootDir`
// directly (spec §10.3, E0183: a default may not reference another
// parameter of the same declaration), so the empty string is the sentinel,
// resolved here, the one place both are in scope.
fn resolveLockRoot(rootDir: string, lockRoot: string): string {
  if (lockRoot == "") {
    return rootDir
  }
  return lockRoot
}

// `buildIr`'s own `lockRoot` resolution plus its bit.json/bit.lock
// consistency check, in one step — the two were already sequential there,
// and combining them keeps that function at spec/LINT.md's max-fn-lines
// ceiling after adding the parameter. `problem` is `manifestLockProblem`'s
// (projectpkg.bit) own refusal message, or "" when clean.
fn buildManifestLockCheck(rootDir: string, lockRoot: string): (string, string) {
  let effectiveLockRoot = resolveLockRoot(rootDir, lockRoot)
  let (lockEntries, lockErr) = loadLockEntries(effectiveLockRoot)
  return effectiveLockRoot, manifestLockProblem(effectiveLockRoot, lockEntries, lockErr)
}
