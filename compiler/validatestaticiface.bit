// compiler/validatestaticiface.bit — SPEC §10.4.1/§10.6 (#6091/#6099): an
// interface declaring a static requirement is usable only as a generic
// bound (`T: Named`), never as a value type — there is no instance to call
// a static method on, only a type. Split into its own file rather than
// folded into validateiface.bit, which is already near spec/LINT.md's
// 800-line ceiling.

// E0170: the checker's own diagnostic band tops out at E0169
// (classjobdesc.bit's ecJobDuplicateName, #6081) before E0200 is reserved
// for lint (spec/LINT.md) — first free code above it.
const ecStaticIfaceValueType = 170

// True iff `iface` declares at least one static requirement — a prefix
// scan over the sparse `staticMethods` set, the same shape `vSatisfies`
// (validateiface.bit) already scans for structural satisfaction.
fn ifaceHasStaticRequirement(c: Checker, iface: int): bool {
  let prefix = "${iface}."
  for (k, isStatic) of c.ctx.staticMethods {
    if (isStatic && len(k) > len(prefix) && k[0:len(prefix)] == prefix) {
      return true
    }
  }
  return false
}

// The VALUE-TYPE-position type kid of `node`, or 0: `vDeclaredTypeKid`
// (validatetyperef.bit) — `Param`/`ParamRest`/`Field`/`Binding` — plus the one
// position it does not cover, a `FuncDecl`'s own RESULT kid (its declaring
// node is the whole signature, not a param-shaped wrapper). Deliberately
// never matches `GenericParam`'s `Constraint` kid, which is what makes a
// bound (`T: Named`) exempt with no special-casing: neither this nor
// `vDeclaredTypeKid` recognizes that tag at all.
fn valueTypeKid(c: Checker, node: int): int {
  let d = vDeclaredTypeKid(c, node)
  if (d != 0) {
    return d
  }
  if (getNode(c.tree, node).tag != Tag.FuncDecl) {
    return 0
  }
  let k = kidsOf(c.tree, node)
  if (len(k) < 5) {
    return 0
  }
  return k[4]
}

// One type-annotation node, split out of `validateStaticIfaceValueTypes`'s
// sweep purely to keep the loop's own complexity under E0204's ceiling.
fn checkStaticIfaceValueType(c: Checker, tk: int) {
  let ty = typeFromNode(c, tk)
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.Interface) {
    return
  }
  if (!ifaceHasStaticRequirement(c, ty)) {
    return
  }
  let name = typeName(c.ctx, ty)
  reportNoHint(
    c.diags, ecStaticIfaceValueType, vSpan(c, tk),
    "'${name}' declares a static requirement and cannot be used as a value type; use it only as a generic bound ('T: ${name}', SPEC §10.4.1)",
  )
}

// SPEC §10.6: rejects a `let`/`const`/parameter/field/function-result type
// annotation that resolves to an interface declaring a static requirement
// (#6091/#6099). Run once, PROJECT-WIDE, after every module's own
// `checkModule` (`checkResolved`, checkproject.bit) — `TypeContext.
// staticMethods` is populated per-module as each is checked in dependency
// order, so a module using an interface a LATER module declares would see
// an incomplete answer (a false negative) if this ran any earlier, the
// same reasoning `validateInstantiations`'s own header gives for running
// after the per-module loop.
fn validateStaticIfaceValueTypes(mods: []Checker) {
  for c of mods {
    let i = 1
    while (i < len(c.tree.nodes)) {
      let tk = valueTypeKid(c, i)
      if (tk != 0) {
        checkStaticIfaceValueType(c, tk)
      }
      i = i + 1
    }
  }
}
