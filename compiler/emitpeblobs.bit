fn emPeStrings(module: IrModule, freestanding: bool, rodata: ByteBuf, fr: EmPeFuncsResult) {
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined
  // ---- string pool -> .rdata bytes + a {ptr,len} header --------------------
  let ssi = 0
  while (ssi < len(module.stringPool)) {
    let s = module.stringPool[ssi]
    let dataOff = len(rodata.bytes)
    appendBytes(rodata, []byte(s))
    let dataName = "__bitstr_${ssi}_data"
    symbols = append(
      symbols,
      PeSymbol{
        name = dataName, hasSection = true,
        section = PeSectionKind.Rodata, offset = dataOff, size = len([]byte(s)),
        binding = PeBinding.Local, kind = PeSymKind.Object,
      },
    )
    defined[dataName] = true

    emPadTo8(rodata)
    let hdrOff = len(rodata.bytes)
    appendU64(rodata, 0)              // ptr — filled by the reloc below
    appendU64(rodata, len([]byte(s))) // len
    appendU64(rodata, 0)              // base — 0: a literal is not GC-owned
    let hdrName = "__bitstr_${ssi}"
    let hdrBinding = PeBinding.Global
    if (freestanding) {
      hdrBinding = PeBinding.Local
    }
    symbols = append(
      symbols,
      PeSymbol{
        name = hdrName, hasSection = true,
        section = PeSectionKind.Rodata, offset = hdrOff, size = 24,
        binding = hdrBinding, kind = PeSymKind.Object,
      },
    )
    defined[hdrName] = true
    relocs = append(
      relocs,
      PeRelocation{
        section = PeSectionKind.Rodata,
        offset = hdrOff, symbol = dataName, kind = PeRelocKind.Addr64,
      },
    )
    ssi = ssi + 1
  }

  fr.symbols = symbols
  fr.relocs = relocs
}

fn emPeTypeInfos(module: IrModule, freestanding: bool, rodata: ByteBuf, fr: EmPeFuncsResult) {
  // ---- gc_alloc TypeInfo blobs -> .rdata -----------------------------------
  let tis = collectTypeInfos(module, freestanding)
  let ti = 0
  while (ti < len(tis)) {
    emPeTypeInfo(module, rodata, fr, tis[ti])
    ti = ti + 1
  }
}

fn emPeTypeInfo(module: IrModule, rodata: ByteBuf, fr: EmPeFuncsResult, t: TypeInfoLayout) {
  let name = typeInfoSymbol(t.disc, t.size, t.ptrOffsets)
  let offsName = emPeTypeOffsets(rodata, fr, t, name)
  let tname = ""
  if (module.ctx.types[t.disc].hasName) {
    tname = module.ctx.types[t.disc].name
  }
  let nameSym = emPeTypeName(rodata, fr, tname, name)
  let methods = emitMethodTable(module, rodata, t.disc, name)
  emPeMethods(fr, methods)
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined

  let tiOff = emTypeInfoWords(rodata, t, len([]byte(tname)), methods.size / 16)
  symbols = append(
    symbols,
    PeSymbol{
      name = name, hasSection = true,
      section = PeSectionKind.Rodata, offset = tiOff, size = emTypeInfoBytes,
      binding = PeBinding.Global, kind = PeSymKind.Object,
    },
  )
  defined[name] = true
  if (len(t.ptrOffsets) > 0) {
    relocs = append(
      relocs,
      PeRelocation{
        section = PeSectionKind.Rodata,
        offset = tiOff + 8, symbol = offsName, kind = PeRelocKind.Addr64,
      },
    )
  }
  if (nameSym != "") {
    relocs = append(
      relocs,
      PeRelocation{
        section = PeSectionKind.Rodata,
        offset = tiOff + 24, symbol = nameSym, kind = PeRelocKind.Addr64,
      },
    )
  }
  if (methods.sym != "") {
    relocs = append(
      relocs,
      PeRelocation{
        section = PeSectionKind.Rodata,
        offset = tiOff + 40, symbol = methods.sym, kind = PeRelocKind.Addr64,
      },
    )
  }
  fr.symbols = symbols
  fr.relocs = relocs
}

fn emPeTypeOffsets(rodata: ByteBuf, fr: EmPeFuncsResult, t: TypeInfoLayout, name: string): string {
  let symbols = fr.symbols
  let defined = fr.defined
  let offsName = ""
  if (len(t.ptrOffsets) > 0) {
    emPadTo8(rodata)
    let offsOff = len(rodata.bytes)
    let k = 0
    while (k < len(t.ptrOffsets)) {
      appendU64(rodata, t.ptrOffsets[k])
      k = k + 1
    }
    offsName = name + "_offs"
    symbols = append(
      symbols,
      PeSymbol{
        name = offsName, hasSection = true,
        section = PeSectionKind.Rodata, offset = offsOff,
        size = len(t.ptrOffsets) * 8, binding = PeBinding.Local, kind = PeSymKind.Object,
      },
    )
    defined[offsName] = true
  }
  fr.symbols = symbols
  return offsName
}

fn emPeTypeName(rodata: ByteBuf, fr: EmPeFuncsResult, tname: string, name: string): string {
  let symbols = fr.symbols
  let defined = fr.defined
  let nameSym = ""
  if (len([]byte(tname)) > 0) {
    let nmOff = len(rodata.bytes)
    appendBytes(rodata, []byte(tname))
    nameSym = name + "_name"
    symbols = append(
      symbols,
      PeSymbol{
        name = nameSym, hasSection = true,
        section = PeSectionKind.Rodata, offset = nmOff, size = len([]byte(tname)),
        binding = PeBinding.Local, kind = PeSymKind.Object,
      },
    )
    defined[nameSym] = true
  }
  fr.symbols = symbols
  return nameSym
}

fn emPeMethods(fr: EmPeFuncsResult, methods: EmittedMethods) {
  let symbols = fr.symbols
  let defined = fr.defined
  let relocs = fr.relocs
  if (methods.sym != "") {
    symbols = append(
      symbols,
      PeSymbol{
        name = methods.sym, hasSection = true,
        section = PeSectionKind.Rodata, offset = methods.off, size = methods.size,
        binding = PeBinding.Local, kind = PeSymKind.Object,
      },
    )
    defined[methods.sym] = true
    let mr = 0
    while (mr < len(methods.relocs)) {
      relocs = append(
        relocs,
        PeRelocation{
          section = PeSectionKind.Rodata,
          offset = methods.relocs[mr].off, symbol = methods.relocs[mr].sym,
          kind = PeRelocKind.Addr64,
        },
      )
      mr = mr + 1
    }
  }

  fr.symbols = symbols
  fr.relocs = relocs
}
