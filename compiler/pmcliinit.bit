// compiler/pmcliinit.bit — `bit init` (#2262): scaffolds a minimal bit.json in
// the current directory, so a new project has something for `bit add`/`bit
// up` to extend instead of requiring a user to hand-write the manifest from
// nothing (pmcliaddref.bit's own `checkManifestExists` refuses exactly that with no
// hint at the shape it wants). Same module as pmcli.bit: `exists`/`writeFile`
// (std/fs, already imported by pmfetch.bit/main.bit) and `jsonEncodeString`
// (compiler/json.bit) are visible here unqualified — importing either again
// would be `E0042 already declared in this scope`. `cwd` is imported below,
// since nothing else in this module has needed it before now.
//
// (#3502) Bit's fs ABI had no getcwd/realpath when this file was written
// (#2260 — see buildout.bit's own comment on `manifestProjectName`), so `bit
// init` could not derive a "name" field from the directory it runs in the
// way `npm init -y` derives one from `path.basename(process.cwd())`. Both
// gaps are closed now: `std/fs`'s `cwd()` exists, and `bit init` with no
// `[name]` argument defaults to the current directory's own basename
// (`defaultInitName` below). The `[name]` argument, when given, still wins
// outright — this only supplies what used to be omitted.
import { cwd } from "std/fs"

// `bit init [name] [--help]`. Writes `bit.json` in the CURRENT directory only
// — no `--dir`, unlike `add`/`up`/`remove`: there is nothing yet to point
// `--dir` at until this runs. Returns the process exit code: 2 on a usage
// error, 1 when bit.json already exists, the write fails, or (#3502) no
// `[name]` was given and the directory's basename is not a usable one; 0 on
// success.
fn initCmd(a: []string): int {
  if (len(a) > 2 && pmIsHelpFlag(a[2])) {
    print(pmInitUsage)
    return 0
  }
  let name = ""
  if (len(a) > 2) {
    // #2107's lesson applies here too: an unrecognised flag standing where
    // the optional name goes must be reported, not silently written into
    // bit.json as the project's "name".
    if (cliRejectFlagOperand("init", a[2], pmInitUsage)) {
      return 2
    }
    name = a[2]
  } else {
    name = defaultInitName() catch e {
      eprint("bit init: ${e.message()}\n")
      return 1
    }
  }
  if (len(a) > 3) {
    eprint("bit init: unexpected argument '${a[3]}'\n")
    eprint(pmInitUsage)
    return 2
  }

  let path = "bit.json"
  // #2751 taught this repo what writing before checking preconditions costs:
  // `checkManifestExists` (pmcliaddref.bit) now refuses to fetch or write bit.lock
  // until bit.json's existence is confirmed FIRST. This is the same rule
  // pointed the other way — refuse before writing a byte, so a second
  // `bit init` in an already-scaffolded directory can never clobber a
  // manifest `bit add`/`bit up` has since extended.
  if (exists(path)) {
    eprint("bit init: ${path} already exists — refusing to overwrite\n")
    return 1
  }

  writeFile(path, pmInitManifestText(name)) catch e {
    eprint("bit init: ${e.message()}\n")
    return 1
  }
  print("bit init: wrote ${path}\n")
  return 0
}

const pmInitUsage = "usage: bit init [name]\n" +
  "  Writes a minimal bit.json in the current directory. Fails if one\n" +
  "  already exists.\n" +
  "  [name]     recorded as bit.json's \"name\" field, which 'bit build\n" +
  "             <dir>' uses to name its default output; omitted, the\n" +
  "             current directory's own basename is used instead.\n"

// (#3502) The current directory's own basename, used as bit.json's "name"
// when `bit init` is given none — the default `npm init -y` derives from
// `path.basename(process.cwd())`. Fails, rather than deriving "", when the
// basename is not usable: see `isUsableProjectName` for exactly what that
// means and why.
fn defaultInitName(): string! {
  let dir = cwd()?
  let base = pathBase(dir)
  if (!isUsableProjectName(base)) {
    fail newError("cannot derive a project name from the current directory ('${dir}'); pass one explicitly, e.g. 'bit init myproject'")
  }
  return base
}

// Whether `name` is usable as bit.json's "name" field: non-empty, and
// holding no path-separator byte for this host ('/', plus '\' on a native
// Windows host — #4186, isPathSepByte/hostBackslashSep, mainpaths.bit, same
// module). bit.json's manifest schema places no OTHER character restriction
// on "name" — verified against compiler/buildout.bit and
// compiler/project*.bit, the field's only consumer, which reads it as an
// opaque JSON string and never as an identifier. The two restrictions kept
// here are exactly the ones `buildDirDefaultOut` (buildout.bit) actually
// depends on: it splices "name" into a build output path as a single
// component, `stripped + "/" + name`, so an empty or separator-holding value
// would silently corrupt that path rather than fail loudly. `pathBase`'s own
// return can never itself hold a separator for this host (it cuts at the
// LAST one), so this second check only ever fires for a name reaching here
// some other way; kept because the function's contract should not depend on
// its one caller's implementation detail.
fn isUsableProjectName(name: string): bool {
  if (len(name) == 0) {
    return false
  }
  let b = []byte(name)
  let winSep = hostBackslashSep()
  let i = 0
  while (i < len(b)) {
    if (isPathSepByte(b[i], winSep)) {
      return false
    }
    i = i + 1
  }
  return true
}

// The manifest text `bit init` writes: strict JSON (no comments, no trailing
// commas), so it parses identically whether read by the JSONC-tolerant
// `jsoncParse` (`bit up`'s `projectDeps`, pmcliup.bit) or by the strict
// `jsonParse` `readManifest` (pmfetchresolve.bit) uses for a directory
// build's default output name (buildout.bit's `manifestProjectName`) — a
// hand-added comment here would silently degrade only the second of those,
// not fail loudly, the same trap a later hand edit could fall into.
// `"dependencies": {}` is spelled out rather than left absent so the one
// field spec §17.7 actually defines is visible in a fresh file; a bare `{}`
// already works too (`ensureDependenciesObject`, pmcliaddref.bit), so nothing
// downstream depends on the key being present verbatim. `name` is run
// through `jsonEncodeString` (compiler/json.bit) rather than interpolated
// raw, so a name containing `"` or `\` cannot corrupt the JSON it is written
// into.
fn pmInitManifestText(name: string): string {
  if (len(name) == 0) {
    return "{\n  \"dependencies\": {}\n}\n"
  }
  return "{\n  \"name\": ${jsonEncodeString(name)},\n  \"dependencies\": {}\n}\n"
}
