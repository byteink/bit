// Self-host Stage 1 (#1333): the diagnostics + source-manager substrate, ported
// This is what the lexer and parser build on —
// spans into source, and offset→line/column mapping for diagnostics. Structs are
// reference types in Bit, so the source manager mutates in place (no explicit
// `*SourceManager` pointer needed).

// A byte range `[start, end)` in the file identified by `file` (a FileId index).
class Span {
  file: int,
  start: int,
  end: int,
}

// A zero-width span at `at` — for point diagnostics (EOF, an inserted token).
fn pointSpan(file: int, at: int): Span {
  return Span{ file: file, start: at, end: at }
}

// A byte offset resolved to a human position: 0-based line and column, plus the
// full text of the containing line (for the `N | ...` diagnostic gutter).
class Location {
  line: int,
  column: int,
  lineText: string,
}

// `lineStarts` is the byte offset of every line's first byte, ascending, always
// beginning with 0 (#5185). It exists so `locate` can binary-search instead of
// counting newlines from byte 0 on every call: `debugPosOf` (codegen.bit) asks
// for a line per EMITTED INSTRUCTION, which made debug-row assignment O(I * L)
// in instructions times source length. On the object a one-line
// `import ... from "pkg/web"` produces that was 21.5% of the whole `bit build`.
// Built once in `addFile`, never mutated afterwards, so there is no cache to
// invalidate and no lazy-fill race.
class SrcFile {
  path: string,
  source: string,
  lineStarts: []int,
}

// The offsets `SrcFile.lineStarts` records for `source`. Bounded by len(source).
fn sourceLineStarts(source: string): []int {
  let starts = [0]
  let i = 0
  while (i < len(source)) {
    if (source[i] == '\n') {
      starts = append(starts, i + 1)
    }
    i = i + 1
  }
  return starts
}

// The index of the line containing `offset`: the largest `k` with
// `starts[k] <= offset`. `starts[0]` is 0 and `offset` is never negative, so a
// `k` always exists. Bounded by log2(len(starts)) iterations.
fn lineIndexAt(starts: []int, offset: int): int {
  let lo = 0
  let hi = len(starts) - 1
  while (lo < hi) {
    let mid = lo + (hi - lo + 1) / 2
    if (starts[mid] <= offset) {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  return lo
}

// Registry of source files. `addFile` returns a FileId (the file's index).
class SourceManager {
  files: []SrcFile,
}

fn newSourceManager(): SourceManager {
  return SourceManager{ files: []SrcFile(0) }
}

// Registers a file and returns its handle. Path and source are borrowed. The
// append persists to the caller because a class is a reference.
fn addFile(sm: SourceManager, path: string, source: string): int {
  let id = len(sm.files)
  sm.files = append(
    sm.files,
    SrcFile{ path: path, source: source, lineStarts: sourceLineStarts(source) },
  )
  return id
}

fn filePath(sm: SourceManager, file: int): string {
  return sm.files[file].path
}

fn fileSource(sm: SourceManager, file: int): string {
  return sm.files[file].source
}

// A single diagnostic. `severity` is 0=error, 1=warning, 2=note (matching the
// seed's Severity order). `code` is the numeric registry value (rendered
// `E%04d`). `hint` is only rendered when `hasHint` (the seed's `?[]const u8`).
//
// `hasCode` is false only for a NOTE, which is a second span attached to the
// error above it rather than a diagnostic in its own right — it has no entry in
// the registry to name, and `note[E0042]:` would imply it did. Go, Rust and
// TypeScript all render this line bare for the same reason. Errors and warnings
// always carry a code, so nothing else sets it false.
class Diagnostic {
  severity: int,
  code: int,
  span: Span,
  message: string,
  hint: string,
  hasHint: bool,
  hasCode: bool,
}

// The diagnostic sink threaded through the front-end. Structs are references, so
// `report` persists appends to the caller. `errorCount` mirrors `hasErrors`.
class Diagnostics {
  sm: SourceManager,
  list: []Diagnostic,
  errorCount: int,
}

fn newDiagnostics(sm: SourceManager): Diagnostics {
  return Diagnostics{ sm: sm, list: []Diagnostic(0), errorCount: 0 }
}

// Records a diagnostic with a hint. Error-severity bumps `errorCount`.
fn report(d: Diagnostics, code: int, span: Span, message: string, hint: string) {
  d.list = append(
    d.list,
    Diagnostic{
      severity: 0,
      code: code,
      span: span,
      message: message,
      hint: hint,
      hasHint: true,
      hasCode: true,
    },
  )
  d.errorCount = d.errorCount + 1
}

// Records an error-severity diagnostic with no hint (the seed's `null` hint).
fn reportNoHint(d: Diagnostics, code: int, span: Span, message: string) {
  d.list = append(
    d.list,
    Diagnostic{
      severity: 0,
      code: code,
      span: span,
      message: message,
      hint: "",
      hasHint: false,
      hasCode: true,
    },
  )
  d.errorCount = d.errorCount + 1
}

// Records a warning-severity diagnostic. Deliberately does NOT bump
// `errorCount`: a warning must not fail the build (the resolver's
// `shadows_predeclared` is the only one today, and shadowing is legal).
fn warn(d: Diagnostics, code: int, span: Span, message: string, hint: string) {
  d.list = append(
    d.list,
    Diagnostic{
      severity: 1,
      code: code,
      span: span,
      message: message,
      hint: hint,
      hasHint: true,
      hasCode: true,
    },
  )
}

// Records a NOTE: a secondary span belonging to the diagnostic immediately
// before it, which is what makes "rename or remove one of the declarations"
// actionable when the other declaration is in a different file (#2129). §17.1
// makes a module a DIRECTORY of `.bit` files sharing one namespace, so a
// cross-file collision is structural here, not a corner case.
//
// It must be emitted straight after its parent: `renderDiags` walks the list in
// order and nothing links the two, exactly as the hint line is positional today.
//
// Does NOT bump `errorCount` — a note is not itself a failure, and counting it
// would make one error read as two. Callers must have already reported the error
// it annotates.
fn note(d: Diagnostics, span: Span, message: string) {
  d.list = append(
    d.list,
    Diagnostic{
      severity: 2,
      code: 0,
      span: span,
      message: message,
      hint: "",
      hasHint: false,
      hasCode: false,
    },
  )
}

// Inserts a NOTE right after the diagnostic at `afterIdx`, rather than at the
// list's end like `note` above. #5503: catch's glued-ident spacing ambiguity
// (`e{...}` read as a composite default) fails to parse via a CASCADE — the
// root diagnostic that actually explains the misparse lands mid-list, with
// more diagnostics appended after it by the time the caller can react, so the
// note must be spliced in beside its real parent rather than trailing the
// whole cascade.
fn noteAfter(d: Diagnostics, afterIdx: int, span: Span, message: string) {
  let n = Diagnostic{
    severity: 2, code: 0, span: span, message: message,
    hint: "", hasHint: false, hasCode: false,
  }
  // Built into a FRESH array rather than `append`ing onto a prefix slice of
  // `d.list`: a prefix slice can share `d.list`'s own backing storage, so
  // appending to it would write `n` straight into `d.list[afterIdx + 1]`
  // before the tail loop below has read that element — corrupting the very
  // list this function is copying from.
  let out = []Diagnostic(0)
  let i = 0
  while (i <= afterIdx) {
    out = append(out, d.list[i])
    i = i + 1
  }
  out = append(out, n)
  while (i < len(d.list)) {
    out = append(out, d.list[i])
    i = i + 1
  }
  d.list = out
}

fn hasErrors(d: Diagnostics): bool {
  return d.errorCount > 0
}

// Drops diagnostics past index `n`, restoring `errorCount`. The parser calls
// this when a speculative parse fails, so diagnostics emitted during the
// aborted attempt don't leak (the seed short-circuits via error.Speculative
// instead; truncating the sink to the pre-attempt length is the array-parser
// equivalent). Bounded by the retained count.
fn truncateDiags(d: Diagnostics, n: int) {
  d.list = d.list[0:n]
  let ec = 0
  let i = 0
  while (i < n) {
    if (d.list[i].severity == 0) {
      ec = ec + 1
    }
    i = i + 1
  }
  d.errorCount = ec
}

// Number of decimal digits in `n` (n >= 0) — the diagnostic gutter width.
fn digits(n: int): int {
  let v = n
  let out = 1
  while (v >= 10) {
    v = v / 10
    out = out + 1
  }
  return out
}

// `code` as the registry string `E%04d` (zero-padded to 4 digits, `E` prefix).
fn codeString(code: int): string {
  let s = "${code}"
  while (len(s) < 4) {
    s = "0" + s
  }
  return "E" + s
}

fn severityLabel(severity: int): string {
  if (severity == 1) {
    return "warning"
  }
  if (severity == 2) {
    return "note"
  }
  return "error"
}

// `n` copies of `ch` — bounded by the caller (gutter width, caret span, both
// small). Power-of-10: the loop is bounded by `n`.
fn repeatStr(ch: string, n: int): string {
  let s = ""
  let i = 0
  while (i < n) {
    s = s + ch
    i = i + 1
  }
  return s
}

// Caret indentation that mirrors tabs: one space per column, but a tab stays a
// tab so the caret lands under the offending byte in a tab-indented line.
// Bounded by the column, itself <= line length.
fn caretPad(lineText: string, column: int): string {
  let stop = column
  if (stop > len(lineText)) {
    stop = len(lineText)
  }
  let s = ""
  let i = 0
  while (i < stop) {
    if (lineText[i] == '\t') {
      s = s + "\t"
    } else {
      s = s + " "
    }
    i = i + 1
  }
  return s
}

// Caret run width: the span length, clamped to >=1 and to what remains on the
// line after `column` (matching the seed's caretWidth).
fn caretWidth(span: Span, loc: Location): int {
  let ll = len(loc.lineText)
  let colClamp = loc.column
  if (colClamp > ll) {
    colClamp = ll
  }
  let lineTail = ll - colClamp
  let width = 1
  if (span.end > span.start) {
    width = span.end - span.start
  }
  if (width > lineTail) {
    width = lineTail
  }
  if (width < 1) {
    width = 1
  }
  return width
}

// Renders one diagnostic in the seed's human format (ANSI disabled — the dump
// path is always color-off for a deterministic differential):
//   error[E0001]: <message>
//    --> <path>:<line>:<col>
//     |
//   N | <source line>
//     | <pad>^^^ <hint?>
fn renderOne(sm: SourceManager, d: Diagnostic): string {
  let loc = locate(sm, d.span.file, d.span.start)
  let gutter = digits(loc.line + 1)
  let pad = repeatStr(" ", gutter)
  let head = severityLabel(d.severity) + "[" + codeString(d.code) + "]"
  if (!d.hasCode) {
    head = severityLabel(d.severity)
  }
  let out = head + ": " + d.message + "\n"
  out = out + pad + "--> " + filePath(sm, d.span.file) + ":${loc.line + 1}:${loc.column + 1}\n"
  out = out + pad + " |\n"
  out = out + "${loc.line + 1} | " + loc.lineText + "\n"
  out = out + pad + " | " + caretPad(loc.lineText, loc.column) + repeatStr(
    "^",
    caretWidth(d.span, loc),
  )
  if (d.hasHint) {
    out = out + " " + d.hint
  }
  return out + "\n"
}

// Renders every diagnostic in order, concatenated (the seed's renderAll).
fn renderDiags(d: Diagnostics): string {
  let out = ""
  let i = 0
  while (i < len(d.list)) {
    out = out + renderOne(d.sm, d.list[i])
    i = i + 1
  }
  return out
}

// Maps a byte offset to 0-based line/column and the containing line's text.
// `offset` may equal len(source) (points just past the end, e.g. EOF). Both
// loops are bounded by the source length.
//
// It may also EXCEED it by one: the loader joins a module's files with a
// separator newline that belongs to no file, so an EOF diagnostic in the last
// file lands one past that file's real text. Clamping here — rather than at the
// remap — keeps the single offset->position conversion total for any input, and
// renders exactly what the seed does (the position just past the last byte).
fn locate(sm: SourceManager, file: int, offset: int): Location {
  let f = sm.files[file]
  let source = f.source
  let stop = offset
  if (stop > len(source)) {
    stop = len(source)
  }
  // Identical answer to counting newlines over source[0:stop], by construction:
  // that loop's `line` is the number of newlines before `stop` and its
  // `lineStart` is the offset just past the last of them, which is exactly the
  // largest `lineStarts` entry not above `stop` and its index.
  let line = lineIndexAt(f.lineStarts, stop)
  let lineStart = f.lineStarts[line]
  let lineEnd = lineStart
  while (lineEnd < len(source) && source[lineEnd] != '\n') {
    lineEnd = lineEnd + 1
  }
  return Location{ line: line, column: stop - lineStart, lineText: source[lineStart:lineEnd] }
}
