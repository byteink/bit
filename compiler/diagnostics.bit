// Self-host Stage 1 (#1333): the diagnostics + source-manager substrate, ported
// from compiler/diagnostics.zig. This is what the ported lexer/parser build on —
// spans into source, and offset→line/column mapping for diagnostics. Structs are
// reference types in Bit, so the source manager mutates in place (no Zig-style
// `*SourceManager` needed).

// A byte range `[start, end)` in the file identified by `file` (a FileId index).
struct Span {
  file: int,
  start: int,
  end: int,
}

// A zero-width span at `at` — for point diagnostics (EOF, an inserted token).
function pointSpan(file: int, at: int): Span {
  return Span{ file: file, start: at, end: at }
}

// A byte offset resolved to a human position: 0-based line and column, plus the
// full text of the containing line (for the `N | ...` diagnostic gutter).
struct Location {
  line: int,
  column: int,
  lineText: string,
}

struct SrcFile {
  path: string,
  source: string,
}

// Registry of source files. `addFile` returns a FileId (the file's index).
struct SourceManager {
  files: []SrcFile,
}

function newSourceManager(): SourceManager {
  return SourceManager{ files: []SrcFile(0) }
}

// Registers a file and returns its handle. Path and source are borrowed. The
// append persists to the caller because a struct is a reference.
function addFile(sm: SourceManager, path: string, source: string): int {
  let id = len(sm.files)
  sm.files = append(sm.files, SrcFile{ path: path, source: source })
  return id
}

function filePath(sm: SourceManager, file: int): string {
  return sm.files[file].path
}

function fileSource(sm: SourceManager, file: int): string {
  return sm.files[file].source
}

// A single diagnostic. `severity` is 0=error, 1=warning, 2=note (matching the
// seed's Severity order). `code` is the numeric registry value (rendered
// `E%04d`). `hint` is only rendered when `hasHint` (the seed's `?[]const u8`).
struct Diagnostic {
  severity: int,
  code: int,
  span: Span,
  message: string,
  hint: string,
  hasHint: bool,
}

// The diagnostic sink threaded through the front-end. Structs are references, so
// `report` persists appends to the caller. `errorCount` mirrors `hasErrors`.
struct Diagnostics {
  sm: SourceManager,
  list: []Diagnostic,
  errorCount: int,
}

function newDiagnostics(sm: SourceManager): Diagnostics {
  return Diagnostics{ sm: sm, list: []Diagnostic(0), errorCount: 0 }
}

// Records a diagnostic with a hint. Error-severity bumps `errorCount`.
function report(d: Diagnostics, code: int, span: Span, message: string, hint: string) {
  d.list = append(d.list, Diagnostic{ severity: 0, code: code, span: span, message: message, hint: hint, hasHint: true })
  d.errorCount = d.errorCount + 1
}

// Records an error-severity diagnostic with no hint (the seed's `null` hint).
function reportNoHint(d: Diagnostics, code: int, span: Span, message: string) {
  d.list = append(d.list, Diagnostic{ severity: 0, code: code, span: span, message: message, hint: "", hasHint: false })
  d.errorCount = d.errorCount + 1
}

// Records a warning-severity diagnostic. Deliberately does NOT bump
// `errorCount`: a warning must not fail the build (the resolver's
// `shadows_predeclared` is the only one today, and shadowing is legal).
function warn(d: Diagnostics, code: int, span: Span, message: string, hint: string) {
  d.list = append(d.list, Diagnostic{ severity: 1, code: code, span: span, message: message, hint: hint, hasHint: true })
}

function hasErrors(d: Diagnostics): bool {
  return d.errorCount > 0
}

// Drops diagnostics past index `n`, restoring `errorCount`. The parser calls
// this when a speculative parse fails, so diagnostics emitted during the
// aborted attempt don't leak (the seed short-circuits via error.Speculative
// instead; truncating the sink to the pre-attempt length is the array-parser
// equivalent). Bounded by the retained count.
function truncateDiags(d: Diagnostics, n: int) {
  d.list = d.list[0:n]
  let ec = 0
  let i = 0
  while (i < n) {
    if (d.list[i].severity == 0) {
      ec = ec + 1
    }
    i = i + 1
  }
  d.errorCount = ec
}

// Number of decimal digits in `n` (n >= 0) — the diagnostic gutter width.
function digits(n: int): int {
  let v = n
  let out = 1
  while (v >= 10) {
    v = v / 10
    out = out + 1
  }
  return out
}

// `code` as the registry string `E%04d` (zero-padded to 4 digits, `E` prefix).
function codeString(code: int): string {
  let s = "${code}"
  while (len(s) < 4) {
    s = "0" + s
  }
  return "E" + s
}

function severityLabel(severity: int): string {
  if (severity == 1) {
    return "warning"
  }
  if (severity == 2) {
    return "note"
  }
  return "error"
}

// `n` copies of `ch` — bounded by the caller (gutter width, caret span, both
// small). Power-of-10: the loop is bounded by `n`.
function repeatStr(ch: string, n: int): string {
  let s = ""
  let i = 0
  while (i < n) {
    s = s + ch
    i = i + 1
  }
  return s
}

// Caret indentation that mirrors tabs: one space per column, but a tab stays a
// tab so the caret lands under the offending byte in a tab-indented line.
// Bounded by the column, itself <= line length.
function caretPad(lineText: string, column: int): string {
  let stop = column
  if (stop > len(lineText)) {
    stop = len(lineText)
  }
  let s = ""
  let i = 0
  while (i < stop) {
    if (lineText[i] == '\t') {
      s = s + "\t"
    } else {
      s = s + " "
    }
    i = i + 1
  }
  return s
}

// Caret run width: the span length, clamped to >=1 and to what remains on the
// line after `column` (matching the seed's caretWidth).
function caretWidth(span: Span, loc: Location): int {
  let ll = len(loc.lineText)
  let colClamp = loc.column
  if (colClamp > ll) {
    colClamp = ll
  }
  let lineTail = ll - colClamp
  let width = 1
  if (span.end > span.start) {
    width = span.end - span.start
  }
  if (width > lineTail) {
    width = lineTail
  }
  if (width < 1) {
    width = 1
  }
  return width
}

// Renders one diagnostic in the seed's human format (ANSI disabled — the dump
// path is always color-off for a deterministic differential):
//   error[E0001]: <message>
//    --> <path>:<line>:<col>
//     |
//   N | <source line>
//     | <pad>^^^ <hint?>
function renderOne(sm: SourceManager, d: Diagnostic): string {
  let loc = locate(sm, d.span.file, d.span.start)
  let gutter = digits(loc.line + 1)
  let pad = repeatStr(" ", gutter)
  let out = severityLabel(d.severity) + "[" + codeString(d.code) + "]: " + d.message + "\n"
  out = out + pad + "--> " + filePath(sm, d.span.file) + ":${loc.line + 1}:${loc.column + 1}\n"
  out = out + pad + " |\n"
  out = out + "${loc.line + 1} | " + loc.lineText + "\n"
  out = out + pad + " | " + caretPad(loc.lineText, loc.column) + repeatStr("^", caretWidth(d.span, loc))
  if (d.hasHint) {
    out = out + " " + d.hint
  }
  return out + "\n"
}

// Renders every diagnostic in order, concatenated (the seed's renderAll).
function renderDiags(d: Diagnostics): string {
  let out = ""
  let i = 0
  while (i < len(d.list)) {
    out = out + renderOne(d.sm, d.list[i])
    i = i + 1
  }
  return out
}

// Maps a byte offset to 0-based line/column and the containing line's text.
// `offset` may equal len(source) (points just past the end, e.g. EOF). Both
// loops are bounded by the source length.
//
// It may also EXCEED it by one: the loader joins a module's files with a
// separator newline that belongs to no file, so an EOF diagnostic in the last
// file lands one past that file's real text. Clamping here — rather than at the
// remap — keeps the single offset->position conversion total for any input, and
// renders exactly what the seed does (the position just past the last byte).
function locate(sm: SourceManager, file: int, offset: int): Location {
  let source = sm.files[file].source
  let stop = offset
  if (stop > len(source)) {
    stop = len(source)
  }
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < stop) {
    if (source[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  let lineEnd = lineStart
  while (lineEnd < len(source) && source[lineEnd] != '\n') {
    lineEnd = lineEnd + 1
  }
  return Location{ line: line, column: stop - lineStart, lineText: source[lineStart:lineEnd] }
}
