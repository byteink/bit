// compiler/lowercond.bit — split out of lower.bit (#1809); further split by
// #2910 — switch/select/match-arm dispatch moved to lowerbranch.bit to keep
// both files under the 800-line lint limit. Sibling of lower.bit: same
// module, so this needs no imports and no call-site changes. Unary and
// relational operators, interface coercion, `&&`/`||` short-circuiting,
// and `if` with its branch-chain condition (#5926).

// A concrete value flowing into an interface-typed slot is relabelled to the
// interface via `convert` (the pointer is unchanged; SPEC §14.3). `valTy` is the
// value's source type; a value already of the interface type passes through.
fn coerceToIface(fc: FnCtx, val: int, valTy: int, targetTy: int): int {
  if (fc.c.ctx.types[targetTy].kind != TypeKind.Interface || valTy == targetTy) {
    return val
  }
  // A concrete class (or a different interface) needs the relabel. An untyped
  // `nil` was lowered with the interface hint, so it is already that type — no
  // convert (matches the seed, which checks the value's actual IR type).
  let k = fc.c.ctx.types[valTy].kind
  if (k != TypeKind.Struct && k != TypeKind.Interface) {
    return val
  }
  let cv = mkInstr(Op.Convert, targetTy)
  cv.lhs = val
  return builderEmit(fc.b, cv)
}

// Lowers a unary `-x` (neg/fneg), `~x` (bnot), `!x`, or `<- ch`. The operand
// adopts the unary's materialized type so an untyped literal takes the context
// width (`let n: i8 = -5` -> `const_int i8 5; neg i8`).
fn lowerUnary(fc: FnCtx, node: int, hint: int): int {
  let n = getNode(fc.c.tree, node)
  let opNode = kidsOf(fc.c.tree, node)[0]
  // The result type, adopting a concrete numeric hint when the node is untyped
  // (the seed's materializeType).
  let raw = nodeType(fc, node)
  let ty = defaultType(fc.c, raw)
  if (isNumericPrim(fc, hint) && isUntyped(fc.c, raw)) {
    ty = hint
  }
  // `<- ch`: receive one word from a channel; the operand is the channel (lowered
  // plainly), the value is the result. The two-result `(v, ok) = <- ch` form
  // routes through the assign path.
  if (n.main == int(Kind.ArrowLeft)) {
    return lowerChanRecvUnary(fc, ty, opNode, n.span)
  }
  // `*p` (§11.4): load one word from the pointed-at address. Reuses FieldGet at
  // offset 0 — a plain `base + 0` load, no GC barrier. `ty` is the pointee.
  if (n.main == int(Kind.Star)) {
    let p = lowerExpr(fc, opNode)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.FieldGet, ty)
    ins.lhs = p
    ins.ival = 0
    return builderEmit(fc.b, ins)
  }
  let operand = lowerExprH(fc, opNode, ty)
  if (fc.failed) {
    return 0
  }
  // Logical not `!x` is `x == false` (§12.4).
  if (n.main == int(Kind.Bang)) {
    let f = mkInstr(Op.ConstBool, ty)
    f.bval = false
    let fV = builderEmit(fc.b, f)
    let eq = mkInstr(Op.ICmpEq, ty)
    eq.lhs = operand
    eq.rhs = fV
    return builderEmit(fc.b, eq)
  }
  // Unary plus is the IDENTITY (§12, precedence row 7). It had no case here at
  // all, so `+5` marked its whole function unlowerable and `bit build` refused a
  // program the grammar admits — while `bit check` said nothing, because the
  // operand rule was missing too (#1850). `vUnary` owns the other half; a
  // non-numeric operand never reaches this point.
  if (n.main == int(Kind.Plus)) {
    return operand
  }
  let isFloat = fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
  let uop = Op.BlockParam
  if (n.main == int(Kind.Minus)) {
    if (isFloat) {
      uop = Op.FNeg
    } else {
      uop = Op.Neg
    }
  } else if (n.main == int(Kind.Tilde)) {
    uop = Op.BNot
  }
  if (uop == Op.BlockParam) {
    fcFail(fc, n.span, "an unsupported unary operator")
    return 0
  }
  let ins = mkInstr(uop, ty)
  ins.lhs = operand
  return builderEmit(fc.b, ins)
}

// `<- ch` (§16.2), split out of `lowerUnary` above to keep it under
// E0201/E0204's limits once the closed-receive zero materialization (#5910)
// landed. Single-result form has no `ok` to consult, so a closed-and-drained
// receive must itself give back the live zero object for a class, tuple or
// boxed enum, rather than the null word `chan_recv` reports close with.
fn lowerChanRecvUnary(fc: FnCtx, ty: int, opNode: int, span: Span): int {
  let operand = lowerExpr(fc, opNode)
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.RtCall, ty)
  ins.name = "chan_recv"
  ins.args = [operand]
  let v = emitRtCall(fc, ins)
  if (!zeroIsLiveRecord(fc, ty)) {
    return v
  }
  return emitZeroOnNil(fc, ty, v, span)
}

// Lowers a relational comparison to a bool. Operand evaluation only: the choice
// of comparison lives in `lowerCompare`, which every other `==` in the language
// (a switch-case label) goes through too.
fn lowerComparison(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let opKind = getNode(fc.c.tree, node).main
  // The comparison type is the operands merged, so a literal operand takes the
  // other's concrete width (`x == 0` over u8 -> both u8).
  let operandTy = defaultType(
    fc.c,
    mergeTypes(
      fc.c, nodeType(fc, kids[0]),
      nodeType(fc, kids[1]),
    ),
  )
  let lhs = lowerExprH(fc, kids[0], operandTy)
  let rhs = lowerExprH(fc, kids[1], operandTy)
  if (fc.failed) {
    return 0
  }
  // `decimal` (§11.1, #3982): `lhs`/`rhs` are the two-word tuples
  // `lowerDecimalExpr` builds, never one register, so this has to branch
  // before `lowerCompare` — that generic path would `icmp` two POINTERS.
  // Kept HERE rather than inside `lowerCompare` itself (already at its
  // complexity debt baseline, `tools/build/complexity-debt.txt`) so this
  // slice does not raise it.
  if (isDecimalPrim(fc.c.ctx, operandTy)) {
    return lowerDecimalCompare(fc, opKind, lhs, rhs)
  }
  return lowerCompare(
    fc,
    opKind,
    CompareOperand{ ty = operandTy, span = getNode(fc.c.tree, node).span },
    lhs,
    rhs,
  )
}

// A comparison's operand type and the span to blame if no comparison op
// covers it (#2189, bundled to keep lowerCompare within the 5-param limit,
// E0202).
class CompareOperand {
  ty: int,
  span: Span,
}

// THE comparison selection, for two already-lowered operands of `operand.ty`:
// strings via `string_cmp`/`string_eq`, structs and tuples field-wise via
// `value_eq`, floats via `fcmp_*`, everything else by word with signed/unsigned
// `icmp_*` from the operand type. Split out of `lowerComparison` so a
// switch-case label test shares it (#2407): `caseTest` had its own bare
// `icmp_eq` that ignored the subject type, so `switch (s) { case "one": }` was an
// ADDRESS comparison and took `default` while `s == "one"` here said true. One
// selection, one answer, whichever spelling of `==` reaches it.
// `a == b` on strings, as a call over the two views' `ptr`/`len` WORDS rather
// than over two boxed headers (#4443).
//
// WHY THE WORD FORM IS THE ONE EMITTED. `bit_rt_string_eq`'s one-handle ABI is
// the reason a `string` temporary has to exist at all: a `s[lo:hi]` view is
// built by `emitInlineStringSlice` out of three `field_set`s into a fresh
// 24-byte box, and every consumer that reads the words back out lets
// store-to-load forwarding (optstore.bit) answer the reads and dead-allocation
// elimination (optalloc.bit) drop the box. A one-handle CALL is not such a
// consumer — it names the box itself, which optalloc treats as an escape and
// refuses. `bench/cases/strings` paid 7,124,998 of its 7,125,035 allocations
// for exactly that, two per window comparison.
//
// `unboxStringWords` (lowerexplodestr.bit) is reused rather than open-coding
// two `field_get`s, because it also records the #4406 keepalive edges pairing
// the untraced `ptr`/`len` with the traced `base`. Without those, `base`'s
// live interval could end at the last `field_get` while the interior `ptr`
// stays live across the call, and a collection there frees the backing the
// pointer still points into. The runtime half is `@nosplit`, so the hazard is
// the CALLER's alone, which is where the edges are.
//
// Unconditional, not gated on `Lowerer.explodeStrings`: the words are read out
// of whatever the operand already is, so a boxed operand simply loads the two
// words the callee used to load itself — four loads move from callee to
// caller and none is added. The gate decides whether the box was ever built,
// not whether this form is correct.
fn emitStringEq(fc: FnCtx, lhs: int, rhs: int): int {
  let boolTy = primType(fc.c.ctx, 10)
  let aw = unboxStringWords(fc.c.ctx, fc.b, lhs)
  let bw = unboxStringWords(fc.c.ctx, fc.b, rhs)
  let se = mkInstr(Op.RtCall, boolTy)
  se.name = "string_eq_words"
  se.args = [aw[0], aw[1], bw[0], bw[1]]
  return emitRtCall(fc, se)
}

fn lowerCompare(fc: FnCtx, opKind: int, operand: CompareOperand, lhs: int, rhs: int): int {
  let td = fc.c.ctx.types[operand.ty]
  let boolTy = primType(fc.c.ctx, 10)
  // String (in)equality dispatches to `string_eq`; `!=` negates it via `== false`
  // (the seed's form). Ordering is content-based (SPEC §14.6), never a compare
  // of the two backing addresses: `string_cmp` yields the three-way sign and the
  // relational op is that sign against 0.
  if (td.kind == TypeKind.Prim && td.prim == 11) {
    let ord = strCmpOpFor(opKind)
    if (ord != Op.BlockParam) {
      let i64ty = primType(fc.c.ctx, 3)
      let sc = mkInstr(Op.RtCall, i64ty)
      sc.name = "string_cmp"
      sc.args = [lhs, rhs]
      let c = emitRtCall(fc, sc)
      let z = mkInstr(Op.ConstInt, i64ty)
      z.ival = 0
      let zV = builderEmit(fc.b, z)
      let rel = mkInstr(ord, boolTy)
      rel.lhs = c
      rel.rhs = zV
      return builderEmit(fc.b, rel)
    }
    if (opKind != int(Kind.EqEq) && opKind != int(Kind.BangEq)) {
      fcFail(fc, operand.span, "a relational comparison operator on strings other than == or !=")
      return 0
    }
    let eq = emitStringEq(fc, lhs, rhs)
    if (opKind == int(Kind.EqEq)) {
      return eq
    }
    let f = mkInstr(Op.ConstBool, boolTy)
    f.bval = false
    let fV = builderEmit(fc.b, f)
    let ne = mkInstr(Op.ICmpEq, boolTy)
    ne.lhs = eq
    ne.rhs = fV
    return builderEmit(fc.b, ne)
  }
  // A class compares FIELD-WISE and a tuple ELEMENT-WISE (§14.6), and both are
  // one handle to a heap box — so the word compare below answered "same
  // allocation?" and every separately built value was unequal (#2105, #2113).
  // `value_eq` walks the box against a descriptor compiled from the type; it is
  // the same walk the runtime map hashes and matches keys with, which is what
  // keeps `a == b` and `m[a]` finding `b` from disagreeing (#2111).
  let ve = lowerValueEq(fc, opKind, operand.ty, lhs, rhs)
  if (ve >= 0) {
    return ve
  }
  let isFloat = td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)
  let signed = !(td.kind == TypeKind.Prim && td.prim >= 4 && td.prim <= 7)
  let cop = cmpOpFor(opKind, isFloat, signed)
  if (cop == Op.BlockParam) {
    fcFail(fc, operand.span, "an unsupported comparison operator")
    return 0
  }
  let ins = mkInstr(cop, boolTy)
  ins.lhs = lhs
  ins.rhs = rhs
  return builderEmit(fc.b, ins)
}

// Emits a `jump target(args)` terminator.
fn emitJump(fc: FnCtx, target: int, args: []int) {
  let ins = mkInstr(Op.Jump, fc.c.ctx.voidId)
  ins.ival = target
  ins.args = args
  builderEmit(fc.b, ins)
}

// Lowers a short-circuit `a && b` / `a || b` to a bool value: branch on `a`;
// only when it doesn't decide the result is `b` evaluated in its own block; the
// join block's single bool parameter is the result. The condition sub-blocks
// carry just the bool value (no live locals — the operands are side-effect-free
// for env purposes). Mirrors the seed's lowerShortCircuit; join left open.
fn lowerShortCircuit(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let opKind = getNode(fc.c.tree, node).main
  let boolTy = primType(fc.c.ctx, 10)
  let lval = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let rhsBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = lval
  if (opKind == int(Kind.AmpAmp)) {
    // `a && b`: a true -> evaluate b; a false -> result is a.
    br.ival = rhsBlk
    br.thenArgs = []int(0)
    br.ival2 = join
    br.elseArgs = [lval]
  } else {
    // `a || b`: a true -> result is a; a false -> evaluate b.
    br.ival = join
    br.thenArgs = [lval]
    br.ival2 = rhsBlk
    br.elseArgs = []int(0)
  }
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, rhsBlk)
  let rval = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  emitJump(fc, join, [rval])
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, boolTy)
}

// Lowers `cond ? a : b` (§12, #3941) to br + then/else/join blocks, the value-
// producing sibling of `lowerShortCircuit` just above: branch on `cond`, each
// side evaluates its own arm in its own block and jumps to `join` with the
// value, and the join block's single parameter — typed at the two arms' joined
// type — is the result. No live locals to snapshot (an arm is an expression,
// never a block, so it cannot declare one).
//
// `ty` mirrors the IntLit/FloatLit literal arms of `lowerExprH`, not the
// Binary arm: unlike an arithmetic operator, a conditional performs no
// folding, so there is no precision reason to hold an untyped arm at i64 — an
// int/float HINT is honoured whenever the checker's own type is still
// untyped, exactly as a bare literal in that same context already would be.
fn lowerConditional(fc: FnCtx, node: int, hint: int): int {
  let k = kidsOf(fc.c.tree, node) // [cond, then, else]
  let cond = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let raw = nodeType(fc, node)
  let ty = defaultType(fc.c, raw)
  if (isUntyped(fc.c, raw) && isNumericPrim(fc, hint)) {
    ty = hint
  }
  let thenBlk = builderNewBlock(fc.b)
  let elseBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = thenBlk
  br.thenArgs = []int(0)
  br.ival2 = elseBlk
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, thenBlk)
  let tval = lowerExprH(fc, k[1], ty)
  if (fc.failed) {
    return 0
  }
  emitJump(fc, join, [tval])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, elseBlk)
  let eval = lowerExprH(fc, k[2], ty)
  if (fc.failed) {
    return 0
  }
  emitJump(fc, join, [eval])
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, ty)
}

// The open exits of a condition lowered by `lowerCondBr` (#5926): indices into
// `fc.b.instrs` of the `br`s whose THEN edge still has to reach the condition's
// true target (`trues`) and whose ELSE edge its false target (`falses`).
class CondExits {
  trues: []int,
  falses: []int,
}

// Lowers an `if` condition as a branch chain: `a && b` / `a || b` become one
// `br` per operand, so each compare feeds its own branch and #4393 fuses it
// into the jump. `lowerShortCircuit` (the value form, kept for every other
// position) instead joins a bool block param that the if then tests with a
// second `br`, which leaves a compare whose only use is a block argument.
// Evaluation order is unchanged and the rhs is lowered in its own block,
// reached only on the edge where the lhs does not decide the result.
//
// The exits are returned open and patched by `patchCondExits` once the if has
// created its then/join/else blocks, AFTER the condition is lowered. That keeps
// the block numbering `lowerShortCircuit` gave: every block the condition
// mints (the rhs block, a bounds check's panic and continuation) is numbered
// below the arms, so no edge out of the condition points at a lower index.
// `isBackEdge` reads indices, and such an edge would gain a safepoint poll.
//
// With `BIT_IF_BRANCHCHAIN` off every condition takes the leaf path below,
// one `lowerExpr` and one `br`, which is the IR `lowerIf` emitted before.
fn lowerCondBr(fc: FnCtx, node: int): CondExits {
  let n = getNode(fc.c.tree, node)
  let chain = n.tag == Tag.Binary && (n.main == int(Kind.AmpAmp) || n.main == int(Kind.PipePipe))
  if (chain && ifBranchChainEnabled()) {
    return lowerCondChain(fc, node, n.main == int(Kind.AmpAmp))
  }
  let exits = CondExits{ trues = []int(0), falses = []int(0) }
  let cond = lowerExpr(fc, node)
  if (fc.failed) {
    return exits
  }
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = -1
  br.ival2 = -1
  let at = builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  exits.trues = [at]
  exits.falses = [at]
  return exits
}

// Whether `lowerCondBr` lowers `&&` / `||` as a branch chain (#5926). Default
// OFF: it changes the IR of every `if` whose condition has `&&` or `||`
// against the pinned stage0 0.34.0, so it lands dark until the next repin
// flips the default; this predicate and the leaf-only arm it selects are
// deleted one release after that. TEMPORARY.
fn ifBranchChainEnabled(): bool {
  return envOr("BIT_IF_BRANCHCHAIN", "") == "1"
}

// The `&&` / `||` arm of `lowerCondBr`. For `a && b` the lhs's true exits open
// the rhs block and its false exits are the whole condition's; `a || b` is the
// mirror image.
fn lowerCondChain(fc: FnCtx, node: int, isAnd: bool): CondExits {
  let k = kidsOf(fc.c.tree, node)
  let lhs = lowerCondBr(fc, k[0])
  if (fc.failed) {
    return lhs
  }
  let rhsBlk = builderNewBlock(fc.b)
  if (isAnd) {
    patchCondExits(fc, lhs.trues, true, rhsBlk, []int(0))
  } else {
    patchCondExits(fc, lhs.falses, false, rhsBlk, []int(0))
  }
  builderBeginBlock(fc.b, rhsBlk)
  let rhs = lowerCondBr(fc, k[1])
  if (isAnd) {
    rhs.falses = concatInts(lhs.falses, rhs.falses)
  } else {
    rhs.trues = concatInts(lhs.trues, rhs.trues)
  }
  return rhs
}

// Points one side of each `br` in `brs` at `target` with `args`. Every `br`
// gets its own copy of `args`, so no two instructions share an argument array.
fn patchCondExits(fc: FnCtx, brs: []int, thenSide: bool, target: int, args: []int) {
  let i = 0
  while (i < len(brs)) {
    let br = fc.b.instrs[brs[i]]
    if (thenSide) {
      br.ival = target
      br.thenArgs = concatInts(args, []int(0))
    } else {
      br.ival2 = target
      br.elseArgs = concatInts(args, []int(0))
    }
    i = i + 1
  }
}

// A fresh array holding `a` followed by `b`; neither input is aliased.
fn concatInts(a: []int, b: []int): []int {
  let out = []int(0)
  let i = 0
  while (i < len(a) + len(b)) {
    if (i < len(a)) {
      out = append(out, a[i])
    } else {
      out = append(out, b[i - len(a)])
    }
    i = i + 1
  }
  return out
}

// Lowers an `if (cond) then [else]` to br + then/else/join blocks, threading the
// live locals (env[0..preLen]) as join-block parameters — the seed's lowerIf.
// The join block is left open for the following statements.
fn lowerIf(fc: FnCtx, node: int) {
  // #5670: only one arm runs (lowerkeepalive.bit's banner).
  clearPtrOfBindings(fc)
  let k = kidsOf(fc.c.tree, node)
  let exits = lowerCondBr(fc, k[0])
  if (fc.failed) {
    return
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let thenBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let hasElse = k[2] != 0
  let elseBlk = join
  if (hasElse) {
    elseBlk = builderNewBlock(fc.b)
  }
  // Then edges carry no args; a missing else sends every false edge to the join
  // with the live locals. A condition assigns no local, so the one snapshot is
  // the right value on each of those edges.
  let elseArgs = []int(0)
  if (!hasElse) {
    elseArgs = orig
  }
  patchCondExits(fc, exits.trues, true, thenBlk, []int(0))
  patchCondExits(fc, exits.falses, false, elseBlk, elseArgs)

  builderBeginBlock(fc.b, thenBlk)
  fc.terminated = false
  lowerStmtList(fc, k[1])
  let joinReachable = !hasElse
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)

  if (hasElse) {
    builderBeginBlock(fc.b, elseBlk)
    fc.terminated = false
    if (getNode(fc.c.tree, k[2]).tag == Tag.IfStmt) {
      lowerIf(fc, k[2])
    } else {
      lowerStmtList(fc, k[2])
    }
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
  }

  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}
