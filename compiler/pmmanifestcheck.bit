// In-Bit self-checks for bit.json/bit.lock reconciliation
// (manifestLockProblem, #2254) and the checkCmd/buildIr paths that surface
// it end to end. Split out of projectcheck.bit (#5475): #3842's `:` -> `=`
// keyed-literal sweep pushed that file from 800 raw to 806 formatted, over
// the E0200 ceiling. Same module as projectcheck.bit (sibling .bit files
// are one module), so `selfcheck()` still calls these directly; named
// `pm*check*.bit` so _tests_/bit/pmrangegate/scratchpairing.bit's
// `isPmCheckFile` scan keeps pairing these scratch-dir checks with their
// `removeTree(...)`.

// A directory with neither `bit.json` nor `bit.lock` — every golden and
// example fixture in this repo, and the vast majority of real programs — has
// nothing to reconcile and must never be flagged.
fn checkManifestLockProblemNoFiles() {
  let root = pmCheckScratchDir()
  let dir = root + "/no-manifest-no-lock"
  pmCheckMkdirAll(dir)
  assert(manifestLockProblem(dir, map<string, LockEntry>{}, "") == "")

  removeTree(root, pmCheckTimeoutMs)
}

// A `bit.json` that is not even JSON must be refused, naming the file — bug 2
// of #2254: before this, `bit build`/`run`/`check` never opened bit.json at
// all, so a manifest this broken built silently.
fn checkManifestLockProblemMalformedJson() {
  let root = pmCheckScratchDir()
  let dir = root + "/malformed-manifest"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/bit.json", "not json at all\n") catch e {
    panic("projectcheck: cannot write malformed bit.json: " + e.message())
  }
  let problem = manifestLockProblem(dir, map<string, LockEntry>{}, "")
  assert(problem != "")
  assert(pkgTestContains(problem, "bit.json"))

  removeTree(root, pmCheckTimeoutMs)
}

// A `bit.lock` that already names a dependency with no `bit.json` beside it —
// the #2751 orphan-lock shape, seen from the build side of that same bug —
// must be refused, naming both files.
fn checkManifestLockProblemOrphanLock() {
  let entries = map<string, LockEntry>{}
  entries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = "1111111111111111111111111111111111111111", requires = []LockRequire(0),
  }
  let root = pmCheckScratchDir()
  let dir = root + "/orphan-lock"
  pmCheckMkdirAll(dir)
  let problem = manifestLockProblem(dir, entries, "")
  assert(problem != "")
  assert(pkgTestContains(problem, "bit.json"))
  assert(pkgTestContains(problem, "bit.lock"))

  removeTree(root, pmCheckTimeoutMs)
}

// A dependency `bit.json` declares that `bit.lock` has never locked must be
// refused, naming the dependency.
fn checkManifestLockProblemUnlockedDependency() {
  let root = pmCheckScratchDir()
  let dir = root + "/unlocked-dependency"
  pmCheckMkdirAll(dir)
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@main\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let problem = manifestLockProblem(dir, map<string, LockEntry>{}, "")
  assert(problem != "")
  assert(pkgTestContains(problem, "dep"))
  assert(pkgTestContains(problem, "bit add") || pkgTestContains(problem, "bit up"))

  removeTree(root, pmCheckTimeoutMs)
}

// A dependency pinned in `bit.json` to a bare, resolved commit SHA that
// disagrees with what `bit.lock` actually locked for it — the one `ref` form
// #2254 can verify with no network at all (spec §17.7: the other two forms
// are mutable tag/branch names `bit.lock` never records) — must be refused,
// naming both SHAs and the fix.
fn checkManifestLockProblemShaMismatch() {
  let pinned = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let locked = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  let root = pmCheckScratchDir()
  let dir = root + "/sha-mismatch"
  pmCheckMkdirAll(dir)
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@${pinned}\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let entries = map<string, LockEntry>{}
  entries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = locked, requires = []LockRequire(0),
  }
  let problem = manifestLockProblem(dir, entries, "")
  assert(problem != "")
  assert(pkgTestContains(problem, pinned))
  assert(pkgTestContains(problem, locked))
  assert(pkgTestContains(problem, "bit up"))

  removeTree(root, pmCheckTimeoutMs)
}

// The same bare-SHA pin, matching `bit.lock` exactly, must never be flagged —
// the half that proves this fix does not become "reject more things". A
// `v`-prefixed tag ref is not a `parseVersionConstraint` form at all (spec
// §17.7's constraint grammar has no `v` prefix — only `^`/`~`/bare) and a
// branch ref is not one either, so both still pass through unflagged
// regardless of any `bit.lock`-recorded version (see `manifestLockProblem`,
// projectpkg.bit). A REAL `^`/`~`/bare constraint against a locked `version`
// is checked below in `checkManifestLockProblemConstraint*`.
fn checkManifestLockProblemNoFalsePositive() {
  let sha = "cccccccccccccccccccccccccccccccccccccccc"
  let root = pmCheckScratchDir()
  let matching = root + "/sha-match"
  pmCheckMkdirAll(matching)
  writeFile(
    matching + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@${sha}\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let matchedEntries = map<string, LockEntry>{}
  matchedEntries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = sha, requires = []LockRequire(0),
  }
  assert(manifestLockProblem(matching, matchedEntries, "") == "")

  let tagged = root + "/tag-ref"
  pmCheckMkdirAll(tagged)
  writeFile(
    tagged + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@v0.1.0\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let taggedEntries = map<string, LockEntry>{}
  taggedEntries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = "dddddddddddddddddddddddddddddddddddddddd", requires = []LockRequire(0),
  }
  assert(manifestLockProblem(tagged, taggedEntries, "") == "")

  removeTree(root, pmCheckTimeoutMs)
}

// #2857: a caret constraint (`^2.0.0`) that bit.lock's recorded `version`
// (#2856) no longer satisfies — the drift shape #2254 could not see because
// it predates the `version` field entirely. Must refuse, naming both the
// constraint and the locked version, with the same "run `bit up <name>`"
// remedy the bare-SHA arm already uses.
fn checkManifestLockProblemConstraintViolation() {
  let root = pmCheckScratchDir()
  let dir = root + "/constraint-violation"
  pmCheckMkdirAll(dir)
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@^2.0.0\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let entries = map<string, LockEntry>{}
  entries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = "1111111111111111111111111111111111111111", version = "1.2.0", requires = []LockRequire(0),
  }
  let problem = manifestLockProblem(dir, entries, "")
  assert(problem != "")
  assert(pkgTestContains(problem, "^2.0.0"))
  assert(pkgTestContains(problem, "1.2.0"))
  assert(pkgTestContains(problem, "bit up"))

  removeTree(root, pmCheckTimeoutMs)
}

// The same constraint shape, satisfied — `^1.2.0` allows anything `<2.0.0`,
// and `1.7.0` is inside that range — must never be flagged.
fn checkManifestLockProblemConstraintSatisfied() {
  let root = pmCheckScratchDir()
  let dir = root + "/constraint-satisfied"
  pmCheckMkdirAll(dir)
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@^1.2.0\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let entries = map<string, LockEntry>{}
  entries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = "2222222222222222222222222222222222222222", version = "1.7.0", requires = []LockRequire(0),
  }
  assert(manifestLockProblem(dir, entries, "") == "")

  removeTree(root, pmCheckTimeoutMs)
}

// A `bit.lock` entry with no recorded `version` at all — written before
// #2856, or a branch/bare-SHA pin that never had one to record — is unknown,
// not a violation (#2827's migration rule): must never be flagged even
// though the constraint itself (`^2.0.0`) would reject the wrong version if
// one were known.
fn checkManifestLockProblemConstraintNoRecordedVersion() {
  let root = pmCheckScratchDir()
  let dir = root + "/constraint-no-version"
  pmCheckMkdirAll(dir)
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@^2.0.0\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let entries = map<string, LockEntry>{}
  entries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = "3333333333333333333333333333333333333333", version = "", requires = []LockRequire(0),
  }
  assert(manifestLockProblem(dir, entries, "") == "")

  removeTree(root, pmCheckTimeoutMs)
}

// A branch ref (`main`) is not a `parseVersionConstraint` form at all, so it
// is never revalidated against a locked `version` — deliberately (#2827
// option 3, #2855): a branch pin's whole point is to float, and bit.lock's
// `version` field is only ever populated from a `^`/`~`/bare constraint
// resolution in the first place, never from a branch fetch. Must never be
// flagged even with a `version` present.
fn checkManifestLockProblemBranchRefIgnoresVersion() {
  let root = pmCheckScratchDir()
  let dir = root + "/branch-ref-with-version"
  pmCheckMkdirAll(dir)
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@main\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  let entries = map<string, LockEntry>{}
  entries["dep"] = LockEntry{
    name = "dep", url = "https://github.com/byteink/dep.git",
    commit = "4444444444444444444444444444444444444444", version = "1.0.0", requires = []LockRequire(0),
  }
  assert(manifestLockProblem(dir, entries, "") == "")

  removeTree(root, pmCheckTimeoutMs)
}

// End to end through the real CLI entry point (#2254's own acceptance): `bit
// check` on a directory whose `bit.json` is not JSON must exit non-zero, and
// once the manifest is removed (a program with no dependencies needs none),
// the identical directory builds clean — proving the guard rejects the
// malformed manifest and nothing else.
fn checkCheckCmdRejectsMalformedManifest() {
  let root = pmCheckScratchDir()
  let dir = root + "/check-cmd-malformed"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/main.bit", "fn main() {}\n") catch e {
    panic("projectcheck: cannot write main.bit: " + e.message())
  }
  writeFile(dir + "/bit.json", "not json at all\n") catch e {
    panic("projectcheck: cannot write malformed bit.json: " + e.message())
  }
  assert(!checkCmd(dir), "checkCmd(dir) must return false while bit.json is malformed")

  remove(dir + "/bit.json") catch e {
    panic("projectcheck: cannot remove bit.json: " + e.message())
  }
  assert(checkCmd(dir), "checkCmd(dir) must return true once the malformed bit.json is removed")

  removeTree(root, pmCheckTimeoutMs)
}

// `buildIr`'s failure message, or "" on success.
fn pmCliTryBuildIrMessage(dir: string): string {
  buildIr(dir, hostBuildTarget(), false, []u8(0), false, false) catch e {
    return e.message()
  }
  return ""
}

// End to end through `buildIr` (feeding `bit build`/`run`/`test`): a
// dependency pinned in `bit.json` to a bare SHA that disagrees with
// `bit.lock`'s recorded commit must fail the build before it ever reaches the
// loader, and correcting the pin to match builds clean — the same project,
// the same module, only the manifest's own bytes differ (#2254's other
// acceptance clause).
fn checkBuildIrRejectsShaMismatch() {
  let pinned = "1234567890123456789012345678901234567890"
  let locked = "0987654321098765432109876543210987654321"
  let root = pmCheckScratchDir()
  let dir = root + "/buildir-sha-mismatch"
  pmCheckMkdirAll(dir)
  writeFile(dir + "/main.bit", "fn main() {}\n") catch e {
    panic("projectcheck: cannot write main.bit: " + e.message())
  }
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@${pinned}\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot write bit.json: " + e.message())
  }
  writeLock(
    dir + "/bit.lock",
    [
      LockEntry{
        name = "dep", url = "https://github.com/byteink/dep.git",
        commit = locked, requires = []LockRequire(0),
      },
    ],
  ) catch e {
    panic("projectcheck: cannot write bit.lock: " + e.message())
  }

  let mismatchMsg = pmCliTryBuildIrMessage(dir)
  assert(len(mismatchMsg) > 0, "buildIr must fail when bit.json's pin disagrees with bit.lock")
  assert(pkgTestContains(mismatchMsg, pinned), "mismatch message must name bit.json's pinned sha")
  assert(pkgTestContains(mismatchMsg, locked), "mismatch message must name bit.lock's resolved sha")

  // Correct the manifest to match the lock: same project, same module, only
  // bit.json's pin changes — must now build clean.
  writeFile(
    dir + "/bit.json",
    "{\n  \"name\": \"demo\",\n  \"dependencies\": {\n    \"dep\": \"github.com/byteink/dep@${locked}\"\n  }\n}\n",
  ) catch e {
    panic("projectcheck: cannot rewrite bit.json: " + e.message())
  }
  let cleanMsg = pmCliTryBuildIrMessage(dir)
  assert(cleanMsg == "", "buildIr must succeed once bit.json's pin matches bit.lock")

  removeTree(root, pmCheckTimeoutMs)
}

fn checkProjectFileOf() {
  // Concatenation makes spans module-global; fileOf maps one back. Boundaries
  // are what break here: an offset AT a file's start belongs to that file.
  let starts = [0, 10, 25]
  let l0 = fileOf(starts, 0)
  assert(l0.fileIdx == 0 && l0.offset == 0)
  let l1 = fileOf(starts, 9)
  assert(l1.fileIdx == 0 && l1.offset == 9)
  let l2 = fileOf(starts, 10) // exactly at b.bit's first byte
  assert(l2.fileIdx == 1 && l2.offset == 0)
  let l3 = fileOf(starts, 24)
  assert(l3.fileIdx == 1 && l3.offset == 14)
  let l4 = fileOf(starts, 25)
  assert(l4.fileIdx == 2 && l4.offset == 0)
  let l5 = fileOf(starts, 100)
  assert(l5.fileIdx == 2 && l5.offset == 75)
}
