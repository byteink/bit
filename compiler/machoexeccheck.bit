// In-Bit self-checks for the Mach-O executable writer and linker. Split out of
// selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

// Stage 3 (#1344 part 5a) the Mach-O executable writer's constants, dyld opcode
// encoders, and layout helpers. Expected bytes were computed independently in
// Python; uleb(624485) == e5 8e 26 is the canonical LEB128 example from the
// DWARF spec, so the encoder is anchored to a published vector, not just to
// itself.

fn meBytesAre(b: ByteBuf, want: []u8): bool {
  if (len(b.bytes) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(want)) {
    if (b.bytes[i] != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn meUlebOf(v: int): ByteBuf {
  let b = newByteBuf()
  meUleb(b, v)
  return b
}

fn checkMachoExecUleb() {
  assert(meBytesAre(meUlebOf(0), [u8(0x00)]))
  assert(meBytesAre(meUlebOf(1), [u8(0x01)]))
  // 127 is the largest single-byte value; 128 is the first that continues.
  assert(meBytesAre(meUlebOf(127), [u8(0x7f)]))
  assert(meBytesAre(meUlebOf(128), [u8(0x80), u8(0x01)]))
  assert(meBytesAre(meUlebOf(255), [u8(0xff), u8(0x01)]))
  assert(meBytesAre(meUlebOf(300), [u8(0xac), u8(0x02)]))
  // The DWARF spec's worked example.
  assert(meBytesAre(meUlebOf(624485), [u8(0xe5), u8(0x8e), u8(0x26)]))
  // A value whose low 7 bits are zero must still emit a continued byte, not
  // stop early.
  assert(meBytesAre(meUlebOf(0x4000), [u8(0x80), u8(0x80), u8(0x01)]))
  assert(meBytesAre(meUlebOf(0x2000), [u8(0x80), u8(0x40)]))
}

fn checkMachoExecOpcodes() {
  // dyld replays this stream at load to fill an imported GOT slot: name the
  // symbol, declare it a pointer, point at segment+offset, bind.
  let b = newByteBuf()
  meEmitBind(b, "_malloc", 2, 0x10)
  assert(meBytesAre(b, [u8(0x40),
    u8(0x5f), u8(0x6d), u8(0x61), u8(0x6c), u8(0x6c), u8(0x6f), u8(0x63), u8(0x00),
    u8(0x51), u8(0x72), u8(0x10), u8(0x90)]))

  // One rebase: dyld adds the image slide to the word at segment+offset.
  let r = newByteBuf()
  meEmitRebase(r, 2, 0x2000)
  assert(meBytesAre(r, [u8(0x11), u8(0x22), u8(0x80), u8(0x40), u8(0x51)]))

  // The opcode nibbles must not collide: each is an opcode ORed with an
  // immediate, so a wrong constant silently changes the instruction.
  assert(bindOpcodeSetTypeImm() | bindTypePointer() == 0x51)
  assert(bindOpcodeSetSegmentAndOffsetUleb() | 2 == 0x72)
  assert(rebaseOpcodeSetTypeImm() | rebaseTypePointer() == 0x11)
  assert(rebaseOpcodeDoRebaseImmTimes() | 1 == 0x51)
}

fn checkMachoExecLayout() {
  assert(meAlignUp(0, 0x4000) == 0)
  assert(meAlignUp(1, 0x4000) == 0x4000)
  assert(meAlignUp(0x4000, 0x4000) == 0x4000)
  assert(meAlignUp(0x4001, 0x4000) == 0x8000)

  // A branch to an import needs a stub; a page/GOT reference does not.
  assert(meIsBranch(LoRelocKind.Aarch64Call26))
  assert(meIsBranch(LoRelocKind.Aarch64Jump26))
  assert(!meIsBranch(LoRelocKind.Aarch64AdrPrelPgHi21))
  assert(!meIsBranch(LoRelocKind.Abs64))

  // Only writable, file-backed __DATA kinds can hold a rebasable pointer. bss
  // has no file bytes to rebase; rodata is not writable.
  assert(meIsDataSeg(LoSectionKind.Data))
  assert(meIsDataSeg(LoSectionKind.TlsVars))
  assert(meIsDataSeg(LoSectionKind.TlsData))
  assert(meIsDataSeg(LoSectionKind.GcMeta))
  assert(meIsDataSeg(LoSectionKind.DbgMeta))
  assert(!meIsDataSeg(LoSectionKind.Bss))
  assert(!meIsDataSeg(LoSectionKind.TlsBss))
  assert(!meIsDataSeg(LoSectionKind.Rodata))
  assert(!meIsDataSeg(LoSectionKind.Text))

  // The __DATA segment's load command only exists if something lives in it.
  assert(meNcmds(true) == 12 && meNcmds(false) == 11)

  // Atom placement honours each atom's alignment, and a placed group's size
  // spans the padding between atoms — not the sum of their sizes.
  let mod = LoModule{ name: "m", atoms: [
    LoAtom{ name: "a", kind: LoSectionKind.Text, binding: LoBinding.Global,
      data: []u8(0), size: 5, alignment: 4, weak: false, relocs: []LoReloc(0) },
    LoAtom{ name: "b", kind: LoSectionKind.Text, binding: LoBinding.Global,
      data: []u8(0), size: 8, alignment: 16, weak: false, relocs: []LoReloc(0) }]}
  let items = [MePlaced{ module: 0, atom: 0, vaddr: 0, fileOff: 0 },
    MePlaced{ module: 0, atom: 1, vaddr: 0, fileOff: 0 }]
  let res = mePlaceAtoms([mod], items, meBaseVaddr())
  assert(res.items[0].vaddr == meBaseVaddr())      // already 4-aligned
  assert(res.items[0].fileOff == 0)                // __TEXT starts at file offset 0
  assert(res.items[1].vaddr == meBaseVaddr() + 16) // 5 bytes in, rounded up to 16
  assert(res.items[1].fileOff == 16)
  assert(res.cursor == meBaseVaddr() + 24)
  // 16 (padding included) + 8, not 5 + 8.
  assert(mePlacedSize([mod], res.items) == 24)
  assert(mePlacedSize([mod], []MePlaced(0)) == 0)
}

// Stage 3 (#1344 part 5b) the executable writer's analysis pass: dead-strip with
// libSystem imports as leaves, output partitioning, and GOT/stub synthesis.

fn meAtom(name: string, kind: LoSectionKind, b: LoBinding, size: int, relocs: []LoReloc): LoAtom {
  return LoAtom{ name: name, kind: kind, binding: b, data: []u8(size), size: size,
    alignment: 1, weak: false, relocs: relocs }
}

// A text atom whose first word is a real instruction. Relocation only patches an
// instruction's immediate field and preserves its opcode bits, so an all-zero
// fixture would assert against a relocated NOP rather than a relocated branch.
fn meCodeAtom(name: string, b: LoBinding, insn: int, relocs: []LoReloc): LoAtom {
  let a = meAtom(name, LoSectionKind.Text, b, 8, relocs)
  loWrU32(a.data, 0, insn)
  return a
}

fn meRel(off: int, kind: LoRelocKind, target: LoSymbolRef): LoReloc {
  return LoReloc{ offset: off, kind: kind, target: target, addend: 0 }
}

// An empty state — the value a failing catch must produce, since `panic` is
// typed void rather than bottom and so cannot BE the value of a catch block that
// must yield a MeLinkState. The assert(false) beside it is what actually fails.
fn meEmptyState(): MeLinkState {
  return MeLinkState{ kept: map<int, bool>{}, importOrder: []string(0),
    branchImports: map<string, bool>{}, text: []MePlaced(0), rodata: []MePlaced(0),
    data: []MePlaced(0), bss: []MePlaced(0), tlsVars: []MePlaced(0),
    tlsData: []MePlaced(0), tlsBss: []MePlaced(0), gotList: []MeGotSlot(0),
    gotOfInternal: map<int, int>{}, gotOfImport: map<string, int>{},
    stubList: []string(0), stubOfImport: map<string, int>{} }
}

// The analysis pass, run end to end the way linkExecutable will.
fn meAnalyze(modules: []LoModule): MeLinkState {
  let g = resolveGlobals(modules) catch _ {
    assert(false)
    map<string, int>{}
  }
  let st = meDeadStripWithImports(modules, g, 0, []string(0)) catch _ {
    assert(false)
    meEmptyState()
  }
  let st2 = mePartition(modules, st)
  return meBuildGotAndStubs(modules, g, st2) catch _ {
    assert(false)
    meEmptyState()
  }
}

fn checkMachoExecDeadStrip() {
  // __start branches to an undefined _malloc (a libSystem import), calls an
  // internal helper, and references a rodata string. `dead` is unreachable.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 16, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_malloc")),
      meRel(4, LoRelocKind.Aarch64Call26, loGlobalRef("helper")),
      meRel(8, LoRelocKind.Aarch64AdrPrelPgHi21, loLocalRef(3))]),  // atom 0
    meAtom("helper", LoSectionKind.Text, LoBinding.Global, 8, []LoReloc(0)), // 1
    meAtom("dead", LoSectionKind.Text, LoBinding.Global, 8, []LoReloc(0)),   // 2
    meAtom("msg", LoSectionKind.Rodata, LoBinding.Local, 4, []LoReloc(0))]}  // 3
  let st = meAnalyze([m])

  // An undefined global is an IMPORT, not an error — that is the whole
  // difference from the ELF path, where it would fail the link.
  assert(len(st.importOrder) == 1 && st.importOrder[0] == "_malloc")
  let (_, isBranchImport) = st.branchImports["_malloc"]
  assert(isBranchImport)

  // Reachable: __start, helper, msg. Not `dead`.
  assert(len(st.kept) == 3)
  let (_, k2) = st.kept[atomKey(0, 2)]
  assert(!k2)

  // Partitioned by class, in module/atom order.
  assert(len(st.text) == 2)
  assert(st.text[0].atom == 0 && st.text[1].atom == 1)
  assert(len(st.rodata) == 1 && st.rodata[0].atom == 3)
  assert(len(st.data) == 0 && len(st.bss) == 0)

  // A branch to an import needs both a stub and the GOT slot the stub loads.
  assert(len(st.stubList) == 1 && st.stubList[0] == "_malloc")
  assert(len(st.gotList) == 1 && st.gotList[0].isImport)
  assert(st.gotList[0].name == "_malloc")
  let (gi, _) = st.gotOfImport["_malloc"]
  assert(gi == 0)
  // A plain internal branch does NOT get a stub — it resolves direct.
  let (_, helperStub) = st.stubOfImport["helper"]
  assert(!helperStub)
  // Nothing here needs a __DATA segment: no got-internal, data, or bss... but the
  // import GOT slot does live in __DATA.
  assert(meHasDataSeg(st))
}

fn checkMachoExecGot() {
  // A GOT-page reference to an internal symbol takes an internal slot (rebased);
  // one to an undefined symbol takes an import slot (bound). A TLVP reference
  // reuses the same internal-GOT machinery.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 32, [
      meRel(0, LoRelocKind.Aarch64AdrGotPage, loGlobalRef("gvar")),
      meRel(4, LoRelocKind.Aarch64Ld64GotLo12Nc, loGlobalRef("gvar")),
      meRel(8, LoRelocKind.Aarch64AdrGotPage, loGlobalRef("_environ")),
      meRel(12, LoRelocKind.Aarch64TlvpAdrPage21, loLocalRef(2)),
      meRel(16, LoRelocKind.Aarch64Call26, loGlobalRef("_exit"))]),
    meAtom("gvar", LoSectionKind.Data, LoBinding.Global, 8, []LoReloc(0)),
    meAtom("tlvdesc", LoSectionKind.TlsVars, LoBinding.Local, 24, []LoReloc(0))]}
  let st = meAnalyze([m])

  // Two references to one internal symbol share ONE slot.
  assert(len(st.gotList) == 4)
  assert(!st.gotList[0].isImport && st.gotList[0].atom == 1) // gvar, once
  assert(st.gotList[1].isImport && st.gotList[1].name == "_environ")
  assert(!st.gotList[2].isImport && st.gotList[2].atom == 2) // the tlv_descriptor
  assert(st.gotList[3].isImport && st.gotList[3].name == "_exit")

  // _environ is imported but never branched to, so it needs no stub; _exit is.
  assert(len(st.stubList) == 1 && st.stubList[0] == "_exit")
  let (_, envIsBranch) = st.branchImports["_environ"]
  assert(!envIsBranch)
  // Import order is first-seen: the indirect symbol table indexes into it.
  assert(len(st.importOrder) == 2)
  assert(st.importOrder[0] == "_environ" && st.importOrder[1] == "_exit")

  assert(len(st.data) == 1 && len(st.tlsVars) == 1)
  assert(meHasDataSeg(st))
}

fn checkMachoExecNoDataSeg() {
  // A pure-text image with no GOT, data, bss or TLS needs no __DATA segment at
  // all — and one fewer load command.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Aarch64Call26, loLocalRef(1))]),
    meAtom("f", LoSectionKind.Text, LoBinding.Local, 4, []LoReloc(0))]}
  let st = meAnalyze([m])
  assert(!meHasDataSeg(st))
  assert(len(st.gotList) == 0 && len(st.stubList) == 0)
  assert(len(st.importOrder) == 0)
  assert(meNcmds(meHasDataSeg(st)) == 11)

  // A missing entry point is a hard error, not an import: nothing can define
  // __start but the runtime.
  let bad = LoModule{ name: "x", atoms: [
    meAtom("notstart", LoSectionKind.Text, LoBinding.Global, 4, []LoReloc(0))]}
  let g = resolveGlobals([bad]) catch _ { map<string, int>{} }
  let msg = ""
  meDeadStripWithImports([bad], g, 0, []string(0)) catch e {
    msg = e.message()
    meEmptyState()
  }
  assert(msg == "MissingEntry")
}

// #1445: an undefined symbol the PROGRAM object references is a link error, not
// a dyld import. Matched by the linker's own tests so both writers accept
// and reject the same programs — the seed is the differential oracle, so a gate
// only one of them enforces is worse than none.
fn checkMachoExecUndefinedSymbol() {
  // __start (program module 0) calls _helper, which archive module 1 defines;
  // _helper calls _libsystem_fn, which nothing defines. That is the legitimate
  // arrangement — an archive member reaching libSystem — and must keep linking.
  // __start additionally calls _maybe_bogus, the name under test.
  let prog = LoModule{ name: "bit.o", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_helper")),
      meRel(4, LoRelocKind.Aarch64Call26, loGlobalRef("_maybe_bogus"))])]}
  let arch = LoModule{ name: "libbitrt.a(rt.o)", atoms: [
    meAtom("_helper", LoSectionKind.Text, LoBinding.Global, 4, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_libsystem_fn"))])]}
  let mods = [prog, arch]
  let g = resolveGlobals(mods) catch _ { map<string, int>{} }

  // (1) Undeclared: refused, naming the symbol AND the referencing module.
  let msg = ""
  meDeadStripWithImports(mods, g, 1, []string(0)) catch e {
    msg = e.message()
    meEmptyState()
  }
  assert(msg == "undefined symbol '_maybe_bogus', referenced from bit.o")

  // (2) The same name declared `extern function`: a legal dylib import. This
  // also proves _libsystem_fn — undefined, but referenced from the ARCHIVE
  // module — stayed a leaf, since otherwise this would fail too.
  let ok = ""
  let st2 = meDeadStripWithImports(mods, g, 1, ["_maybe_bogus"]) catch e {
    ok = e.message()
    meEmptyState()
  }
  assert(ok == "")
  assert(len(st2.importOrder) == 2)

  // (3) An allowlist naming something else must not rescue it: the check has to
  // compare the symbol's CONTENT, not merely count entries or measure it. The
  // decoy is deliberately the SAME LENGTH as _maybe_bogus and differs by one
  // character — with a shorter decoy a length-only comparison reproduces correct
  // behaviour on both arms and the mutant survives.
  assert(len("_maybe_bogos") == len("_maybe_bogus"))
  let msg3 = ""
  meDeadStripWithImports(mods, g, 1, ["_maybe_bogos"]) catch e {
    msg3 = e.message()
    meEmptyState()
  }
  assert(msg3 == "undefined symbol '_maybe_bogus', referenced from bit.o")

  // (4) Provenance is what distinguishes an import: counting BOTH modules as
  // program objects removes the archive's exemption. This is the direction that
  // proves the exemption in (2) does real work rather than the walk simply
  // never reaching module 1.
  let msg4 = ""
  meDeadStripWithImports(mods, g, 2, ["_maybe_bogus"]) catch e {
    msg4 = e.message()
    meEmptyState()
  }
  assert(msg4 == "undefined symbol '_libsystem_fn', referenced from libbitrt.a(rt.o)")
}

// The rule above is only live in production if linkMacho actually counts the
// program's modules — and it is linkMacho, not linkExecutable, that the driver
// calls. Testing only the inner walk left programModules free to be wrong (a
// mutation that never incremented it SURVIVED), so this drives a real object,
// written by our own writer and read back by our own reader, through the real
// entry point. Mirrors the seed's "link() counts the program's own modules".
fn checkMachoExecLinkCountsProgramModules() {
  // The ARCHIVE is not decoration. programModules counts a PREFIX, so a
  // linkMacho that appended archive members before object modules would still
  // count 1 and still blame module 0 — with an object-only input the reordering
  // is unobservable. With an archive present it flips which symbol is named,
  // which is what makes the order a tested property rather than an assumed one.
  let progCode = [u8(0x00), u8(0x00), u8(0x00), u8(0x94),
                  u8(0x00), u8(0x00), u8(0x00), u8(0x94)] // bl _helper ; bl _bogus
  let obj = writeMacho(MachoTarget.Aarch64, MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: progCode,
      size: len(progCode), alignment: 4 }],
    symbols: [
      MachoSymbol{ name: "__start", hasSection: true,
        section: MachoSectionKind.Text, offset: 0, size: len(progCode),
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_helper", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_bogus", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: [
      MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
        symbol: "_helper", kind: MachoRelocKind.Branch },
      MachoRelocation{ section: MachoSectionKind.Text, offset: 4,
        symbol: "_bogus", kind: MachoRelocKind.Branch }]}) catch e {
    panic("writeMacho prog: ${e.message()}")
  }

  // The archive member: defines _helper, and reaches libSystem itself.
  let rtCode = [u8(0x00), u8(0x00), u8(0x00), u8(0x94)] // bl _libsystem_fn
  let rtObj = writeMacho(MachoTarget.Aarch64, MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: rtCode,
      size: len(rtCode), alignment: 4 }],
    symbols: [
      MachoSymbol{ name: "_helper", hasSection: true,
        section: MachoSectionKind.Text, offset: 0, size: len(rtCode),
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_libsystem_fn", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: [MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
      symbol: "_libsystem_fn", kind: MachoRelocKind.Branch }]}) catch e {
    panic("writeMacho rt: ${e.message()}")
  }
  let lib = writeArchive([ArMember{ name: "rt.o", data: rtObj }], arFormatBsd())

  let inputs = [meObjectInput(obj), meArchiveInput(lib)]

  let msg = ""
  linkMacho(inputs, "t", []string(0)) catch e {
    msg = e.message()
    []u8(0)
  }
  // Naming _bogus (not _libsystem_fn) is what proves the object module landed
  // in the counted prefix and the archive member did not.
  assert(msg == "undefined symbol '_bogus', referenced from bit.o")

  // The same inputs link once _bogus is a declared `extern function`, so the
  // gate discriminates rather than rejecting the program outright. This also
  // proves _libsystem_fn stayed a leaf.
  let ok = ""
  let exe2 = linkMacho(inputs, "t", ["_bogus"]) catch e {
    ok = e.message()
    []u8(0)
  }
  assert(ok == "")
  assert(len(exe2) > 0)
}

// The part-5c checks (address assignment, relocation application and the dyld
// info streams) moved verbatim into compiler/machoexecpatchcheck.bit (#4322):
// this file was 790 lines against the hard 800-line E0200 ceiling. Same
// module, so `selfcheck()` still calls them directly.
