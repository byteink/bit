// compiler/classvaluemore.bit — the field shapes of `__sameValue`, `__valueHash`
// and `__snapshot` (classvalue.bit, SPEC §14.3, #7327) that are more than a
// scalar, a slice or a nested class: `Option<T>`, a payload enum, a map and a
// `decimal`.
//
//   Option<T>     None equals None; Some compares the payload. The hash folds a
//                 tag, then the payload.
//   payload enum  the variant first, then each payload in order. Declared in the
//                 SAME module as the class (the payload types are spelled there,
//                 and a copy must build the variant by the name that module
//                 knows), not generic, and not recursive (the expansion is
//                 bounded by `valueDepthMax`, so a recursive one has no member).
//   map<K, V>     the same length, and every key of one is in the other with an
//                 equal value (K is a string, integer, bool or payload-free
//                 enum). The hash sums the per-entry hashes, so it does not
//                 depend on the order the map iterates in.
//   decimal       `==` compares by value, so 1.0 equals 1.00 and the hash must
//                 too. Only value operations see through the scale: the hash
//                 folds the high part (`d / 1e18`), the integer part below it
//                 and the first nine fraction digits. It is a hash, not an
//                 identity: two decimals that differ only past the ninth
//                 fraction digit collide, and equality still tells them apart.
//
// A GENERIC class and a TUPLE field have no member: the members are written as
// text before the checker runs, so a type parameter has no instantiation to
// spell, and a tuple has no accessor spelling the parser would give back
// unchanged. E0313 names the field, as for any other field without value
// semantics.
//
// Everything here is Bit text in `g.buf`; equality and hash allocate nothing
// (a `match` binds by reading, a map is walked by its iterator).

// The type node `t` as a container shape: `(vkNA, 0)` when it is neither a map
// nor `Option<T>`.
fn vkContainerOf(vd: ValueDemand, mid: int, t: int, depth: int): (int, int) {
  let jx = valueCtxOf(vd, mid)
  let tag = getNode(jx.tree, t).tag
  if (tag == Tag.MapType) {
    return vkMapOf(vd, mid, t, depth)
  }
  if (tag != Tag.GenericInst) {
    return (vkNA, 0)
  }
  let gk = kidsOf(jx.tree, t)
  let targs = kidsOf(jx.tree, gk[1])
  if (jsonNodeText(jx, gk[0]) != "Option" || len(targs) != 1) {
    return (vkNA, 0)
  }
  let (ek, _) = vkOf(vd, mid, targs[0], depth + 1)
  if (ek == vkBad) {
    return (vkBad, 0)
  }
  return (vkOption, targs[0])
}

fn valueKeyKind(k: int): bool {
  return k == vkWord || k == vkString || k == vkBool || k == vkEnum
}

fn vkMapOf(vd: ValueDemand, mid: int, t: int, depth: int): (int, int) {
  let mk = kidsOf(valueCtxOf(vd, mid).tree, t)
  let (kk, _) = vkOf(vd, mid, mk[0], depth + 1)
  let (vk, _) = vkOf(vd, mid, mk[1], depth + 1)
  if (!valueKeyKind(kk) || vk == vkBad) {
    return (vkBad, 0)
  }
  return (vkMap, mk[1])
}

// The decl node of the payload enum `name` declared in module `mid` itself, or
// 0: non-generic, at least one payload, every payload with value semantics.
fn valuePayloadEnumDecl(vd: ValueDemand, mid: int, name: string, depth: int): int {
  let tm = vd.proj.mods[mid]
  for d0 of kidsOf(tm.tree, tm.tree.root) {
    let d = d0
    if (d != 0 && getNode(tm.tree, d).tag == Tag.Export) {
      d = kidsOf(tm.tree, d)[0]
    }
    if (d == 0 || getNode(tm.tree, d).tag != Tag.EnumDecl) {
      continue
    }
    if (identText(tm.tree, tm.source, kidsOf(tm.tree, d)[0]) != name) {
      continue
    }
    if (kidsOf(tm.tree, d)[1] != 0 || enumIsPayloadFree(tm.tree, d)) {
      return 0
    }
    if (valuePayloadsOk(vd, mid, d, depth)) {
      return d
    }
    return 0
  }
  return 0
}

// The EnumVariant nodes of enum decl `d` (its in-body methods are not variants).
fn valueVariants(tree: Tree, d: int): []int {
  let out = []int(0)
  for item of kidsOf(tree, kidsOf(tree, d)[2]) {
    if (getNode(tree, item).tag == Tag.EnumVariant) {
      out = append(out, item)
    }
  }
  return out
}

// The payload type nodes of variant `v`, in order.
fn valuePayloadTypes(tree: Tree, v: int): []int {
  let tl = kidsOf(tree, v)[1]
  if (tl == 0) {
    return []int(0)
  }
  return kidsOf(tree, tl)
}

fn valuePayloadsOk(vd: ValueDemand, mid: int, d: int, depth: int): bool {
  let tree = vd.proj.mods[mid].tree
  for v of valueVariants(tree, d) {
    for pt of valuePayloadTypes(tree, v) {
      let (k, _) = vkOf(vd, mid, pt, depth + 1)
      if (k == vkBad) {
        return false
      }
    }
  }
  return true
}

// ---- text -------------------------------------------------------------------

fn vgTypeTextMore(g: ValueGen, t: int): string {
  let jx = valueCtxOf(g.vd, g.mid)
  let tag = getNode(jx.tree, t).tag
  if (tag == Tag.MapType) {
    let mk = kidsOf(jx.tree, t)
    return "map<${vgTypeText(g, mk[0])}, ${vgTypeText(g, mk[1])}>"
  }
  if (tag == Tag.GenericInst) {
    let targs = kidsOf(jx.tree, kidsOf(jx.tree, t)[1])
    return "Option<${vgTypeText(g, targs[0])}>"
  }
  return jsonNodeText(jx, t)
}

fn vgDeclTree(g: ValueGen): Tree {
  return g.vd.proj.mods[g.mid].tree
}

fn vgVariantName(g: ValueGen, v: int): string {
  let m = g.vd.proj.mods[g.mid]
  return identText(m.tree, m.source, kidsOf(m.tree, v)[0])
}

// `Name` or `Name(b1, b2)`: a match pattern for variant `v`, with fresh binders
// `prefix<n>` (returned too).
fn vgPattern(g: ValueGen, v: int, prefix: string): (string, []string) {
  let binders = []string(0)
  let n = len(valuePayloadTypes(vgDeclTree(g), v))
  while (len(binders) < n) {
    binders = append(binders, vgFresh(g, prefix))
  }
  if (len(binders) == 0) {
    return (vgVariantName(g, v), binders)
  }
  return ("${vgVariantName(g, v)}(${valueJoin(binders, ", ")})", binders)
}

fn vgEnumName(g: ValueGen, d: int): string {
  let m = g.vd.proj.mods[g.mid]
  return identText(m.tree, m.source, kidsOf(m.tree, d)[0])
}

// Equality for the shapes in this file; false when `kind` is not one of them.
fn vgEqMore(g: ValueGen, kind: int, elem: int, a: string, b: string): bool {
  if (kind == vkOption) {
    vgEqOption(g, elem, a, b)
    return true
  }
  if (kind == vkPEnum) {
    vgEqEnum(g, elem, a, b)
    return true
  }
  if (kind == vkMap) {
    vgEqMap(g, elem, a, b)
    return true
  }
  return false
}

fn vgEqOption(g: ValueGen, elem: int, a: string, b: string) {
  let p = vgFresh(g, "__vp")
  let q = vgFresh(g, "__vq")
  vgLine(g, "match (${a}) {")
  vgLine(g, "Some(${p}) => {")
  vgLine(g, "match (${b}) {")
  vgLine(g, "Some(${q}) => {")
  vgEq(g, p, q, elem)
  vgLine(g, "}")
  vgLine(g, "None => { return false }")
  vgLine(g, "}")
  vgLine(g, "}")
  vgLine(g, "None => {")
  vgLine(g, "match (${b}) {")
  vgLine(g, "Some(${vgFresh(g, "__vq")}) => { return false }")
  vgLine(g, "None => { }")
  vgLine(g, "}")
  vgLine(g, "}")
  vgLine(g, "}")
}

fn vgEqEnum(g: ValueGen, d: int, a: string, b: string) {
  let variants = valueVariants(vgDeclTree(g), d)
  vgLine(g, "match (${a}) {")
  for v of variants {
    let (pa, xs) = vgPattern(g, v, "__vx")
    let (pb, ys) = vgPattern(g, v, "__vy")
    vgLine(g, "${pa} => {")
    vgLine(g, "match (${b}) {")
    vgLine(g, "${pb} => {")
    let types = valuePayloadTypes(vgDeclTree(g), v)
    let i = 0
    while (i < len(types)) {
      vgEq(g, xs[i], ys[i], types[i])
      i = i + 1
    }
    vgLine(g, "}")
    if (len(variants) > 1) {
      vgLine(g, "_ => { return false }")
    }
    vgLine(g, "}")
    vgLine(g, "}")
  }
  vgLine(g, "}")
}

fn vgEqMap(g: ValueGen, valueType: int, a: string, b: string) {
  let k = vgFresh(g, "__vk")
  let v = vgFresh(g, "__vv")
  let w = vgFresh(g, "__vw")
  let ok = vgFresh(g, "__vo")
  vgLine(g, "if (len(${a}) != len(${b})) { return false }")
  vgLine(g, "for (${k}, ${v}) of ${a} {")
  vgLine(g, "let (${w}, ${ok}) = ${b}[${k}]")
  vgLine(g, "if (!${ok}) { return false }")
  vgEq(g, v, w, valueType)
  vgLine(g, "}")
}

// Hash for the shapes in this file; false when `kind` is not one of them.
fn vgHashMore(g: ValueGen, kind: int, elem: int, a: string, t: int): bool {
  if (kind == vkDecimal) {
    vgHashDecimal(g, a)
    return true
  }
  if (kind == vkOption) {
    vgHashOption(g, elem, a)
    return true
  }
  if (kind == vkPEnum) {
    vgHashEnum(g, elem, a)
    return true
  }
  if (kind == vkMap) {
    vgHashMap(g, a, t, elem)
    return true
  }
  return false
}

// Every intermediate is bound to a `let`: a decimal operand that is itself an
// operation result is boxed for the call (one allocation per operation), a named
// one is passed as two words.
fn vgHashDecimal(g: ValueGen, a: string) {
  let n = vgFresh(g, "__vd")
  vgLine(g, "let ${n}c: decimal = decimal(1000000000000000000)")
  vgLine(g, "let ${n}q: decimal = 0.000000001")
  vgLine(g, "let ${n}a: decimal = ${a}")
  vgLine(g, "let ${n}t: decimal = ${n}a / ${n}c")
  vgLine(g, "let ${n}h = i64(${n}t)")
  vgLine(g, "let ${n}hd: decimal = decimal(${n}h)")
  vgLine(g, "let ${n}hm: decimal = ${n}hd * ${n}c")
  vgLine(g, "let ${n}l: decimal = ${n}a - ${n}hm")
  vgLine(g, "let ${n}i = i64(${n}l)")
  vgLine(g, "let ${n}id: decimal = decimal(${n}i)")
  vgLine(g, "let ${n}f: decimal = ${n}l - ${n}id")
  vgLine(g, "let ${n}fs: decimal = ${n}f / ${n}q")
  vgStep(g, "u64(${n}h)")
  vgStep(g, "u64(${n}i)")
  vgStep(g, "u64(i64(${n}fs))")
}

fn vgHashOption(g: ValueGen, elem: int, a: string) {
  let p = vgFresh(g, "__vp")
  vgLine(g, "match (${a}) {")
  vgLine(g, "Some(${p}) => {")
  vgStep(g, "u64(1)")
  vgHash(g, p, elem)
  vgLine(g, "}")
  vgLine(g, "None => {")
  vgStep(g, "u64(0)")
  vgLine(g, "}")
  vgLine(g, "}")
}

fn vgHashEnum(g: ValueGen, d: int, a: string) {
  vgLine(g, "match (${a}) {")
  let ord = 1
  for v of valueVariants(vgDeclTree(g), d) {
    let (pat, xs) = vgPattern(g, v, "__vx")
    vgLine(g, "${pat} => {")
    vgStep(g, "u64(${ord})")
    let types = valuePayloadTypes(vgDeclTree(g), v)
    let i = 0
    while (i < len(types)) {
      vgHash(g, xs[i], types[i])
      i = i + 1
    }
    vgLine(g, "}")
    ord = ord + 1
  }
  vgLine(g, "}")
}

// Sum of per-entry hashes, each folded from a fresh accumulator, then that sum
// folded into the outer one: addition does not care what order the map yields.
fn vgHashMap(g: ValueGen, a: string, t: int, valueType: int) {
  let k = vgFresh(g, "__vk")
  let v = vgFresh(g, "__vv")
  let sum = vgFresh(g, "__vms")
  let ent = vgFresh(g, "__vme")
  let outer = g.acc
  vgStep(g, "u64(len(${a}))")
  vgLine(g, "let ${sum}: u64 = 0")
  vgLine(g, "for (${k}, ${v}) of ${a} {")
  vgLine(g, "let ${ent}: u64 = 0")
  g.acc = ent
  vgHash(g, k, kidsOf(vgDeclTree(g), t)[0])
  vgHash(g, v, valueType)
  g.acc = outer
  vgLine(g, "${sum} = ${sum} + ${ent}")
  vgLine(g, "}")
  vgStep(g, sum)
}

// ---- snapshot ---------------------------------------------------------------

// Whether a value of type node `t` holds nothing a later mutation could reach,
// so a snapshot may share it.
fn vgPlain(g: ValueGen, t: int, depth: int): bool {
  let (kind, elem) = vkOf(g.vd, g.mid, t, depth)
  if (kind == vkOption) {
    return vgPlain(g, elem, depth + 1)
  }
  if (kind == vkPEnum) {
    for v of valueVariants(vgDeclTree(g), elem) {
      for pt of valuePayloadTypes(vgDeclTree(g), v) {
        if (!vgPlain(g, pt, depth + 1)) {
          return false
        }
      }
    }
    return true
  }
  return kind != vkSlice && kind != vkMap && kind != vkClass
}

// `(true, expression)` for a copy of `a` (type node `t`) of a shape in this file,
// after the statements that build it; `(false, "")` for any other.
fn vgSnapMore(g: ValueGen, kind: int, elem: int, a: string, t: int): (bool, string) {
  if (kind == vkMap) {
    return (true, vgSnapMap(g, a, t, elem))
  }
  if ((kind != vkOption && kind != vkPEnum) || vgPlain(g, t, 0)) {
    return (false, "")
  }
  let r = vgFresh(g, "__vr")
  vgLine(g, "let ${r} = ${a}")
  if (kind == vkOption) {
    vgSnapOption(g, elem, a, r)
  } else {
    vgSnapEnum(g, elem, a, r)
  }
  return (true, r)
}

fn vgSnapMap(g: ValueGen, a: string, t: int, valueType: int): string {
  let acc = vgFresh(g, "__vs")
  let k = vgFresh(g, "__vk")
  let v = vgFresh(g, "__vv")
  vgLine(g, "let ${acc} = ${vgTypeText(g, t)}{}")
  vgLine(g, "for (${k}, ${v}) of ${a} {")
  let inner = vgSnap(g, v, valueType)
  vgLine(g, "${acc}[${k}] = ${inner}")
  vgLine(g, "}")
  return acc
}

fn vgSnapOption(g: ValueGen, elem: int, a: string, r: string) {
  let p = vgFresh(g, "__vp")
  vgLine(g, "match (${a}) {")
  vgLine(g, "Some(${p}) => {")
  let inner = vgSnap(g, p, elem)
  vgLine(g, "${r} = Option.Some(${inner})")
  vgLine(g, "}")
  vgLine(g, "None => { }")
  vgLine(g, "}")
}

fn vgSnapEnum(g: ValueGen, d: int, a: string, r: string) {
  vgLine(g, "match (${a}) {")
  for v of valueVariants(vgDeclTree(g), d) {
    let (pat, xs) = vgPattern(g, v, "__vx")
    vgLine(g, "${pat} => {")
    let types = valuePayloadTypes(vgDeclTree(g), v)
    let copies = []string(0)
    let i = 0
    while (i < len(types)) {
      copies = append(copies, vgSnap(g, xs[i], types[i]))
      i = i + 1
    }
    if (len(copies) != 0) {
      vgLine(g, "${r} = ${vgEnumName(g, d)}.${vgVariantName(g, v)}(${valueJoin(copies, ", ")})")
    }
    vgLine(g, "}")
  }
  vgLine(g, "}")
}
