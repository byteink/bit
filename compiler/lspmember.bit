// bit lsp — member resolution shared by hover (#2327) and definition (#2329)
// on a member-access expression (`recv.field`, `recv.method(...)`). Split out
// of lspquery.bit (#1547) to keep that file under its target size; sibling
// `.bit` files in `compiler/` are the same module, so nothing here needs an
// import and lspquery.bit needs none to call it.
//
// THE BUG THIS EXISTS TO FIX: hover and definition both resolved the
// identifier AFTER a `.` as a bare NAME through `nodeSymbols`/`symbols` — the
// table that answers "what does this identifier, read as a standalone
// reference, bind to" — which finds whichever unrelated `let`/param/function
// happens to share the spelling, or nothing at all. A member name is never in
// that table on purpose: it is not a standalone reference, it is a field or
// method of the RECEIVER'S TYPE, and nothing about its own spelling resolves
// it. `textDocument/completion` already gets this right after a `.`
// (`lspDotCompletion`/`lspMemberCompletion` in lspquery.bit): it re-derives
// the receiver's type with `checkExprType` and reads `ctx.structFields` /
// `ctx.typeMethodNames` / `ctx.methodSigs`, keyed by that type id. This file
// is the same technique, reused for hover's TYPE and definition's
// DECLARATION SITE instead of completion's ITEM LIST.

// Whether the smallest node containing a cursor offset is the NAME half of a
// `Tag.Member` node (`recv.NAME`, kid 1) rather than its receiver (kid 0) or
// something unrelated. `memberNode`/`nameNode` are 0 when `isMemberName` is
// false.
class LspMemberRef {
  isMemberName: bool,
  memberNode: int,
  nameNode: int,
}

// `path` is an ancestor chain root-to-leaf, e.g. from `lspNodePath` — the
// last two entries are the candidate name node and its parent.
fn lspPathMemberName(tree: Tree, path: []int): LspMemberRef {
  let none = LspMemberRef{ isMemberName: false, memberNode: 0, nameNode: 0 }
  if (len(path) < 2) {
    return none
  }
  let nameNode = path[len(path) - 1]
  let parent = path[len(path) - 2]
  if (nameNode == 0 || getNode(tree, parent).tag != Tag.Member) {
    return none
  }
  let mk = kidsOf(tree, parent)
  if (mk[1] != nameNode) {
    return none
  }
  return LspMemberRef{ isMemberName: true, memberNode: parent, nameNode: nameNode }
}

// The source text of a member's name node.
fn lspMemberNodeText(c: Checker, nameNode: int): string {
  let sp = getNode(c.tree, nameNode).span
  return c.source[sp.start:sp.end]
}

// Cursor on a method's OWN in-body declaration name (`label() { ... }`) — the
// same detection #3821 added to lsprename.bit's `lspRenameFromMethodDecl`,
// needed here too because hover/definition (#3824) never call that file. An
// in-body method's Receiver kid (kid 0) has its span PINNED to the method's
// own name span (parsertype.bit's `parseMethodMember` — there is no written
// receiver token to give it a span of its own post-#3762), so kid 0 and kid 1
// of the FuncDecl are span-identical and `lspNodePath`'s walk (lspquery.bit)
// always lands on kid 0 first. Accept landing on EITHER kid; the name is
// always kid 1.
class LspMethodDeclRef {
  found: bool,
  recvType: int,
  name: string,
  nameNode: int,
}

fn lspNoMethodDeclRef(): LspMethodDeclRef {
  return LspMethodDeclRef{ found: false, recvType: 0, name: "", nameNode: 0 }
}

// `path` is an ancestor chain root-to-leaf, e.g. from `lspNodePath`.
fn lspPathMethodDeclName(c: Checker, path: []int): LspMethodDeclRef {
  if (len(path) < 2) {
    return lspNoMethodDeclRef()
  }
  let leaf = path[len(path) - 1]
  let parent = path[len(path) - 2]
  if (getNode(c.tree, parent).tag != Tag.FuncDecl) {
    return lspNoMethodDeclRef()
  }
  let k = kidsOf(c.tree, parent)
  if (k[0] == 0 || (leaf != k[0] && leaf != k[1])) {
    return lspNoMethodDeclRef()
  }
  let recvType = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, k[0])[1]))
  if (recvType <= 0) {
    return lspNoMethodDeclRef()
  }
  return LspMethodDeclRef{
    found: true, recvType: recvType,
    name: lspMemberNodeText(c, k[1]), nameNode: k[1],
  }
}

// Hover markdown for a member keyed directly by `recvType`/`name` — shared by
// a member-USE site (`lspMemberHoverText`, which derives them from the
// receiver expression) and a method's own DECLARATION name (`lspOnHover` in
// lspquery.bit, which already has them from `lspPathMethodDeclName`).
fn lspMemberHoverTextFor(c: Checker, recvType: int, name: string): string {
  let (fty, isField) = c.ctx.structFields["${recvType}.${name}"]
  if (isField) {
    return "```bit\n" + name + ": " + typeName(c.ctx, fty) + "\n```"
  }
  let (sig, isMethodSig) = c.ctx.methodSigs["${recvType}.${name}"]
  if (isMethodSig) {
    return "```bit\n" + name + ": " + typeName(c.ctx, sig) + "\n```"
  }
  return ""
}

// Hover markdown for a resolved member (`name: type`), or "" when the
// receiver's type could not be derived or it has no such field/method — never
// a fallback to the flat by-name lookup `lspHoverText` does: showing nothing
// is correct here, showing an unrelated symbol (the original bug) is not.
fn lspMemberHoverText(c: Checker, memberNode: int, nameNode: int): string {
  let recvType = checkExprType(c, kidsOf(c.tree, memberNode)[0])
  if (recvType <= 0) {
    return ""
  }
  return lspMemberHoverTextFor(c, recvType, lspMemberNodeText(c, nameNode))
}

// The field-name node of class type `recvType`'s field `name` (the same
// span `resolveStructFields`/`compiler/checkbind.bit` walks to intern
// `ctx.structFields`), or 0. Scans every node rather than only top-level
// decls, matching `buildSignatures`' own traversal in checkbind.bit — class
// and function decls are top-level by grammar, but the scan is what the
// checker itself already does to find them, so it is kept identical rather
// than re-deriving "top-level" a second way.
fn lspFindFieldDecl(c: Checker, recvType: int, name: string): int {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.StructDecl) {
      let nameNode = kidsOf(c.tree, m)[0]
      if (userTypeLookup(c, lspMemberNodeText(c, nameNode)) == recvType) {
        let fields = kidsOf(c.tree, kidsOf(c.tree, m)[2])
        let fi = 0
        while (fi < len(fields)) {
          let fld = fields[fi]
          fi = fi + 1
          if (getNode(c.tree, fld).tag == Tag.Export) {
            fld = kidsOf(c.tree, fld)[0]
          }
          let fk = kidsOf(c.tree, fld)
          if (lspMemberNodeText(c, fk[0]) == name) {
            return fk[0]
          }
        }
      }
    }
    m = m + 1
  }
  return 0
}

// The `function (recv: T) name(...)` FuncDecl node itself whose receiver type
// resolves to `recvType` and whose own name is `name` — the same
// receiver-type resolution `buildSignatures` uses to fill `ctx.methodSigs`
// (compiler/checkbind.bit), so it agrees with what completion already lists.
// Returns 0 when no such method exists in this project (a method inherited
// only through an interface's own declaration, e.g. a bare `interface` method
// signature, is not a FuncDecl and is not reachable this way; the
// field/method lookup in `lspMemberHoverText` upstream still types it
// correctly via `ctx.methodSigs`, only its jump target is unavailable).
// Shared core for `lspFindMethodDecl` (definition's own target, the method's
// NAME node) and signature help's param extraction (#2337, which needs the
// whole decl to read its `Params` kid).
fn lspFindMethodFuncDecl(c: Checker, recvType: int, name: string): int {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl) {
      let kids = kidsOf(c.tree, m)
      if (kids[0] != 0 && lspMemberNodeText(c, kids[1]) == name) {
        let rid = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))
        if (rid == recvType) {
          return m
        }
      }
    }
    m = m + 1
  }
  return 0
}

// The method-name node half of `lspFindMethodFuncDecl`'s result — what
// definition jumps to and hover/rename compare against.
fn lspFindMethodDecl(c: Checker, recvType: int, name: string): int {
  let m = lspFindMethodFuncDecl(c, recvType, name)
  if (m == 0) {
    return 0
  }
  return kidsOf(c.tree, m)[1]
}

// The declaration node of receiver type `recvType`'s member `name` — a
// class field first, then a method — or 0 if neither exists in this
// project's own tree (an interface-only method, or a name that plain does
// not exist).
fn lspFindMemberDecl(c: Checker, recvType: int, name: string): int {
  let field = lspFindFieldDecl(c, recvType, name)
  if (field > 0) {
    return field
  }
  return lspFindMethodDecl(c, recvType, name)
}
