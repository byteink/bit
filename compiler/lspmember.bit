// bit lsp — member resolution for hover on a member-access expression
// (`recv.field`, `recv.method(...)`), #2327. Split out of lspquery.bit
// (#1547) to keep that file under its target size; sibling `.bit` files in
// `compiler/` are the same module, so nothing here needs an import and
// lspquery.bit needs none to call it.
//
// THE BUG THIS EXISTS TO FIX: hover resolved the identifier AFTER a `.` as a
// bare NAME through `nodeSymbols`/`symbols` — the table that answers "what
// does this identifier, read as a standalone reference, bind to" — which
// finds whichever unrelated `let`/param/function happens to share the
// spelling, or nothing at all. A member name is never in that table on
// purpose: it is not a standalone reference, it is a field or method of the
// RECEIVER'S TYPE, and nothing about its own spelling resolves it.
// `textDocument/completion` already gets this right after a `.`
// (`lspDotCompletion`/`lspMemberCompletion` in lspquery.bit): it re-derives
// the receiver's type with `checkExprType` and reads `ctx.structFields` /
// `ctx.typeMethodNames` / `ctx.methodSigs`, keyed by that type id. This file
// is the same technique, reused for hover's TYPE instead of completion's ITEM
// LIST.

// Whether the smallest node containing a cursor offset is the NAME half of a
// `Tag.Member` node (`recv.NAME`, kid 1) rather than its receiver (kid 0) or
// something unrelated. `memberNode`/`nameNode` are 0 when `isMemberName` is
// false.
struct LspMemberRef {
  isMemberName: bool,
  memberNode: int,
  nameNode: int,
}

// `path` is an ancestor chain root-to-leaf, e.g. from `lspNodePath` — the
// last two entries are the candidate name node and its parent.
function lspPathMemberName(tree: Tree, path: []int): LspMemberRef {
  let none = LspMemberRef{ isMemberName: false, memberNode: 0, nameNode: 0 }
  if (len(path) < 2) {
    return none
  }
  let nameNode = path[len(path) - 1]
  let parent = path[len(path) - 2]
  if (nameNode == 0 || getNode(tree, parent).tag != Tag.Member) {
    return none
  }
  let mk = kidsOf(tree, parent)
  if (mk[1] != nameNode) {
    return none
  }
  return LspMemberRef{ isMemberName: true, memberNode: parent, nameNode: nameNode }
}

// The source text of a member's name node.
function lspMemberNodeText(c: Checker, nameNode: int): string {
  let sp = getNode(c.tree, nameNode).span
  return c.source[sp.start:sp.end]
}

// Hover markdown for a resolved member (`name: type`), or "" when the
// receiver's type could not be derived or it has no such field/method — never
// a fallback to the flat by-name lookup `lspHoverText` does: showing nothing
// is correct here, showing an unrelated symbol (the original bug) is not.
function lspMemberHoverText(c: Checker, memberNode: int, nameNode: int): string {
  let recvType = checkExprType(c, kidsOf(c.tree, memberNode)[0])
  if (recvType <= 0) {
    return ""
  }
  let name = lspMemberNodeText(c, nameNode)
  let (fty, isField) = c.ctx.structFields["${recvType}.${name}"]
  if (isField) {
    return "```bit\n" + name + ": " + typeName(c.ctx, fty) + "\n```"
  }
  let (sig, isMethodSig) = c.ctx.methodSigs["${recvType}.${name}"]
  if (isMethodSig) {
    return "```bit\n" + name + ": " + typeName(c.ctx, sig) + "\n```"
  }
  return ""
}
