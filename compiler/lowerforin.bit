// compiler/lowerforin.bit — lowers `for x in it` (#2162, owner decision
// 2026-08-10: TypeScript semantics — `in` yields keys, `of` keeps yielding
// values). Sibling of lowerctrl.bit: same module, so this needs no imports and
// no call-site changes.
//
// New file rather than added to lowerctrl.bit (734 lines) or lowerfunc.bit
// (758 lines): either would clear the 800-line ceiling compiler/lint.bit's
// `max-file-lines` rule enforces by default, the same squeeze
// validateloop.bit's own header records for its own extraction out of
// validatestmt.bit.
//
// `for x in it` reuses lowerForOf's counted-loop SSA shape (header/body/step/
// exit over a hidden $iter/$idx pair, compiler/lowerctrl.bit:16-195) but binds
// ONE name to the CURSOR itself — the index for a slice/array, the key for a
// map — never the element or value. That is strictly less work than
// lowerForOf's body: no element fetch (`slice_get`/`IndexGet`) and no
// `map_val_at` call, because the value the header already computed to test the
// loop condition IS the value the body binds.
//
// string, chan<T>, and any other operand type are all rejected before this
// ever runs: compiler/validateloop.bit's `vForIn` (E0091) blocks `bit build`
// from reaching lowering on any of them, the same way
// `vForOfString`/`vForOfFieldPat` already gate `for ... of ...`. A pair
// binder (`(i, x)`) is also legal now (#4333) for a slice/array only — a pair
// binder over a map is refused by `vForInPairOverMap` (E0129) at check time.
// So the guards below are the invalid-cascade contract's defensive floor —
// never expected to fire on a program `bit check` accepted — not the
// enforcement itself.

// Refuses a `for ... in ...` binder shape lowering must never reach if
// `bit check` passed — split out of `lowerForIn` (#4333) purely to keep that
// function's own complexity from growing further with each new guard, the
// same reasoning `lowerForOfBindElem`'s own header records for its
// extraction out of `lowerForOf`. Real enforcement is
// `validateloop.bit`'s `vForIn`/`vForInPairOverMap`; this is the defensive
// floor, not the enforcement. Returns true when `binderNode` is refused and
// a diagnostic has already been reported via `fcFail`.
fn rejectForInBinderShape(fc: FnCtx, binderNode: Node, k: []int, isMap: bool): bool {
  if (binderNode.tag != Tag.Ident && binderNode.tag != Tag.TuplePat) {
    fcFail(
      fc,
      binderNode.span,
      "a `for … in` binder that is not a single name or a `(name, name)` pair",
    )
    return true
  }
  if (binderNode.tag == Tag.TuplePat && isMap) {
    fcFail(fc, binderNode.span, "a `for (k, v) in` pair binder over a map")
    return true
  }
  if (binderNode.tag == Tag.TuplePat && len(kidsOf(fc.c.tree, k[0])) != 2) {
    fcFail(fc, binderNode.span, "a `for … in` pair binder with other than two names")
    return true
  }
  return false
}

// The block ids and loop-invariant state `lowerForInHeader`/
// `lowerForInStepExit` need — bundled purely to keep those two functions
// under spec/LINT.md's E0202 param limit (5) after being split out of
// `lowerForIn` (#2450) to fit E0201's 80-line limit. One allocation per
// `for … in` loop LOWERED at compile time, never per runtime iteration.
class ForInLoopCtx {
  id: Type,
  isMap: bool,
  i64ty: int,
  preLen: int,
  idxSlot: int,
  iterSlot: int,
  header: int,
  bodyBlk: int,
  stepBlk: int,
  exitBlk: int,
}

fn lowerForIn(fc: FnCtx, node: int) {
  // #5670: the body may run zero, one or many times (lowerkeepalive.bit's
  // banner).
  clearPtrOfBindings(fc)
  let k = kidsOf(fc.c.tree, node)
  let iterTy = defaultType(fc.c, nodeType(fc, k[1]))
  let id = fc.c.ctx.types[iterTy]
  let isMap = id.kind == TypeKind.Map
  if (id.kind != TypeKind.Slice && id.kind != TypeKind.Array && !isMap) {
    fcFail(
      fc,
      getNode(fc.c.tree, k[1]).span,
      "a `for … in` whose iterable is not a slice, array or map",
    )
    return
  }
  let binderNode = getNode(fc.c.tree, k[0])
  if (rejectForInBinderShape(fc, binderNode, k, isMap)) {
    return
  }
  let i64ty = primType(fc.c.ctx, 3)
  let iterVal = lowerExpr(fc, k[1])
  if (fc.failed) {
    return
  }
  // Carry the iterable + cursor as hidden locals so they thread through the
  // loop's block params — identical setup to lowerForOf's.
  let ctx = lowerForInSetupLoop(fc, iterVal, iterTy, i64ty, id)
  lowerForInHeader(fc, ctx)
  // Body: bind the cursor itself — the index for a slice/array, the key for a
  // map — then run the body and fall to the step.
  let idxVal = fc.env[ctx.idxSlot].value
  let iterCur = fc.env[ctx.iterSlot].value
  fc.loops = append(
    fc.loops,
    LoopFrame{
      exit = ctx.exitBlk,
      cont = ctx.stepBlk,
      preLen = ctx.preLen,
      isSwitch = false,
      exitUsed = false,
    },
  )
  builderBeginBlock(fc.b, ctx.bodyBlk)
  fc.terminated = false
  let bodyMark = len(fc.env)
  lowerForInBindCursor(
    fc, binderNode, k,
    ForInBindCtx{ id = id, isMap = ctx.isMap, iterCur = iterCur, idxVal = idxVal, i64ty = i64ty },
  )
  lowerStmtList(fc, k[2])
  truncateEnv(fc, bodyMark)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  if (!fc.terminated) {
    emitJump(fc, ctx.stepBlk, snapshotValues(fc, ctx.preLen))
  }
  builderEndBlock(fc.b)
  lowerForInStepExit(fc, ctx)
}

// Declares the loop's hidden `$iter`/`$idx` locals, allocates its four block
// ids, and threads the result into a `ForInLoopCtx` — split out of
// `lowerForIn` purely to fit E0201's 80-line limit.
fn lowerForInSetupLoop(fc: FnCtx, iterVal: int, iterTy: int, i64ty: int, id: Type): ForInLoopCtx {
  let isMap = id.kind == TypeKind.Map
  declareLocal(fc, "$iter", iterVal, iterTy)
  let startV = 0
  if (isMap) {
    let mi = mkInstr(Op.RtCall, i64ty)
    mi.name = "map_iter_init"
    mi.args = [iterVal]
    startV = emitRtCall(fc, mi)
  } else {
    let zero = mkInstr(Op.ConstInt, i64ty)
    startV = builderEmit(fc.b, zero)
  }
  declareLocal(fc, "$idx", startV, i64ty)
  let preLen = len(fc.env)
  let idxSlot = preLen - 1
  let iterSlot = preLen - 2
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let stepBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  return ForInLoopCtx{
    id = id, isMap = isMap, i64ty = i64ty, preLen = preLen,
    idxSlot = idxSlot, iterSlot = iterSlot,
    header = header, bodyBlk = bodyBlk, stepBlk = stepBlk, exitBlk = exitBlk,
  }
}

// The loop-condition test block for `lowerForIn` — the same shape
// `lowerForOf` uses (map: cursor >= 0; slice/array: index < length) — split
// out purely to fit E0201's 80-line limit.
fn lowerForInHeader(fc: FnCtx, ctx: ForInLoopCtx) {
  builderBeginBlock(fc.b, ctx.header)
  addJoinParams(fc, ctx.preLen)
  let idxVal = fc.env[ctx.idxSlot].value
  let iterCur = fc.env[ctx.iterSlot].value
  let cmp = mkInstr(Op.ICmpSge, primType(fc.c.ctx, 10))
  if (ctx.isMap) {
    let z = mkInstr(Op.ConstInt, ctx.i64ty)
    cmp.lhs = idxVal
    cmp.rhs = builderEmit(fc.b, z)
  } else {
    let lenVal = 0
    if (ctx.id.kind == TypeKind.Array) {
      let ci = mkInstr(Op.ConstInt, ctx.i64ty)
      ci.ival = ctx.id.arrayLen
      lenVal = builderEmit(fc.b, ci)
    } else {
      let sl = mkInstr(Op.SliceLen, ctx.i64ty)
      sl.lhs = iterCur
      lenVal = builderEmit(fc.b, sl)
    }
    cmp = mkInstr(Op.ICmpSlt, primType(fc.c.ctx, 10))
    cmp.lhs = idxVal
    cmp.rhs = lenVal
  }
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = builderEmit(fc.b, cmp)
  br.ival = ctx.bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = ctx.exitBlk
  br.elseArgs = snapshotValues(fc, ctx.preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
}

// Advances the cursor (map: next live slot; slice/array: +1) and re-enters
// the header — identical to `lowerForOf`'s step — then closes the loop's
// env slots at exit. Split out of `lowerForIn` alongside `lowerForInHeader`
// for the same E0201-fit reason.
fn lowerForInStepExit(fc: FnCtx, ctx: ForInLoopCtx) {
  builderBeginBlock(fc.b, ctx.stepBlk)
  addJoinParams(fc, ctx.preLen)
  if (ctx.isMap) {
    let nx = mkInstr(Op.RtCall, ctx.i64ty)
    nx.name = "map_iter_next"
    nx.args = [fc.env[ctx.iterSlot].value, fc.env[ctx.idxSlot].value]
    fc.env[ctx.idxSlot].value = emitRtCall(fc, nx)
  } else {
    let one = mkInstr(Op.ConstInt, ctx.i64ty)
    one.ival = 1
    let add = mkInstr(Op.Add, ctx.i64ty)
    add.lhs = fc.env[ctx.idxSlot].value
    add.rhs = builderEmit(fc.b, one)
    fc.env[ctx.idxSlot].value = builderEmit(fc.b, add)
  }
  emitJump(fc, ctx.header, snapshotValues(fc, ctx.preLen))
  builderEndBlock(fc.b)
  // Exit.
  builderBeginBlock(fc.b, ctx.exitBlk)
  addJoinParams(fc, ctx.preLen)
  fc.terminated = false
  // Drop the hidden $iter/$idx locals.
  truncateEnv(fc, ctx.preLen - 2)
}

// The loop-invariant values `lowerForInBindCursor`/`lowerForInPairBinder`
// need to bind the body's cursor — bundled purely to keep those functions'
// own parameter count under spec/LINT.md's E0202 limit (5), the same reason
// `lowerctrl.bit`'s `ForOfBindVals` exists.
class ForInBindCtx {
  id: Type,
  isMap: bool,
  iterCur: int,
  idxVal: int,
  i64ty: int,
}

// Binds `for ... in ...`'s per-iteration cursor into `binderNode`: a plain
// name gets the index (slice/array) or key (map); a `(i, x)` pair (#4333)
// gets (index, element) — legal for a slice/array only, `lowerForIn`'s own
// guard having already refused a pair binder over a map. Split out of
// `lowerForIn` — following `lowerctrl.bit`'s `lowerForOfBindElem` precedent
// — so the new pair-binder arm does not grow that already-oversized
// function's complexity further.
fn lowerForInBindCursor(fc: FnCtx, binderNode: Node, k: []int, v: ForInBindCtx) {
  if (binderNode.tag == Tag.TuplePat) {
    lowerForInPairBinder(fc, k, v.id, v.iterCur, v.idxVal)
    return
  }
  let bindTy = v.i64ty
  let bindVal = v.idxVal
  if (v.isMap) {
    let kv = mkInstr(Op.RtCall, v.id.mapKey)
    kv.name = "map_key_at"
    kv.args = [v.iterCur, v.idxVal]
    bindVal = emitRtCall(fc, kv)
    bindTy = v.id.mapKey
  }
  declareLocal(fc, fc.c.source[binderNode.span.start:binderNode.span.end], bindVal, bindTy)
  rebindCheckerName(fc, k[0], bindTy)
}

// Binds `for (i, x) in xs`'s pair binder (#4333) inside the loop body: `i`
// gets the index; `x` gets the element, fetched the same way `lowerForOf`
// does (slice: `lowerForOfSliceElem`; array: `Op.IndexGet`) so both loops
// read the same element the same way. Recurses through `destructureTuple`
// (the function `let (a, b) = f()` uses) when `x` is itself a nested tuple
// pattern (`for (i, (name, n)) in xs`), so nesting shares one mechanism with
// `let` rather than a second copy. Never called for a map iterable —
// `lowerForIn`'s own guard refuses that combination before this runs.
fn lowerForInPairBinder(fc: FnCtx, k: []int, id: Type, iterCur: int, idxVal: int) {
  let subs = kidsOf(fc.c.tree, k[0])
  let i64ty = primType(fc.c.ctx, 3)
  let inode = getNode(fc.c.tree, subs[0])
  declareLocal(fc, fc.c.source[inode.span.start:inode.span.end], idxVal, i64ty)
  rebindCheckerName(fc, subs[0], i64ty)
  let elemTy = id.elem
  let elemV = 0
  let bindTy = elemTy
  if (id.kind == TypeKind.Slice) {
    let r = lowerForOfSliceElem(fc, iterCur, idxVal, elemTy)
    elemV = r.value
    bindTy = r.bindTy
  } else {
    let ig = mkInstr(Op.IndexGet, elemTy)
    ig.lhs = iterCur
    ig.rhs = idxVal
    elemV = builderEmit(fc.b, ig)
  }
  let vnode = getNode(fc.c.tree, subs[1])
  if (vnode.tag == Tag.TuplePat) {
    destructureTuple(fc, kidsOf(fc.c.tree, subs[1]), elemTy, elemV)
    return
  }
  declareLocal(fc, fc.c.source[vnode.span.start:vnode.span.end], elemV, bindTy)
  rebindCheckerName(fc, subs[1], elemTy)
}
