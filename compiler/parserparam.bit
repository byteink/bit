// compiler/parserparam.bit — `parseParam`/`parseParams` (SPEC §10.3), moved
// verbatim out of parsertype.bit (818 lines against the 800-line ceiling
// once #5258's inferred-default arm landed there). A sibling .bit file is
// the same module, so this is a pure move: no import, no call-site change,
// and every function keeps its name and body. No consts or structs cross
// this seam, so there is no declaration-order question to answer.

fn parseParam(p: Parser): int {
  // `...name: T` is a variadic parameter (§10.3). The `...` is a token, not a
  // kid, so mkNode's kid-derived span would start at the name and drop it —
  // capture the start here, as the seed's `join(start, span(ty))` does.
  let start = peekTok(p).start
  let isRest = acceptTok(p, Kind.Ellipsis)
  let beforeName = p.pos
  let name = expectIdent(p)
  // The inferred spelling `name = const_expr` (§10.3, #5258): no written
  // type, the checker reads one off the default (`paramDeclaredType`,
  // checklookup.bit). Guarded on NAME PROGRESS, mirroring `beforeType` below
  // for the identical reason — `expectIdent` is non-consuming on mismatch, so
  // a recovery position already sitting AT an unrelated `=` (this function
  // re-entered with nothing consumed, e.g.
  // `error_trait_field_default.bit`'s retried param) must not be read as
  // this form: without the guard, `x: int = 5`'s trailing `=` would parse as
  // a bare inferred param `= 5` on the SECOND, error-recovery call into this
  // function, one `expectIdent` failure short of consuming it for real.
  if (p.pos != beforeName && peekKind(p) == Kind.Eq) {
    advance(p) // '='
    let deflt = parseExpr(p)
    let end = getNode(p.tree, deflt).span.end
    let tag = Tag.Param
    if (isRest) {
      tag = Tag.ParamRest
    }
    return addNode(
      p.tree,
      tag,
      Span{ file = p.file, start = start, end = end },
      0,
      [name, 0, deflt],
    )
  }
  expect(p, Kind.Colon)
  // `expect` is non-consuming on mismatch (parser.bit): a malformed param
  // (no `:`) leaves the parser AT the bad token, so `parseType` also fails
  // without advancing. `beforeType` catches that: a `=` counts as a default
  // marker only when `parseType` actually consumed something — the `=` that
  // just defeated an empty `:`/type is not one (`error_trait_field_default.bit`).
  let beforeType = p.pos
  let ty = parseType(p)
  // `= const_expr` (§10.3, #5244): a default value, a THIRD optional kid so
  // every existing 2-kid `Tag.Param`/`Tag.ParamRest` builder elsewhere in
  // this module keeps working unchanged. Consumers check `len(kidsOf(...))`.
  let end = getNode(p.tree, ty).span.end
  let kids = [name, ty]
  if (p.pos != beforeType && acceptTok(p, Kind.Eq)) {
    let deflt = parseExpr(p)
    end = getNode(p.tree, deflt).span.end
    kids = [name, ty, deflt]
  }
  let tag = Tag.Param
  if (isRest) {
    tag = Tag.ParamRest
  }
  return addNode(p.tree, tag, Span{ file = p.file, start = start, end = end }, 0, kids)
}

fn parseParams(p: Parser): int {
  expect(p, Kind.LParen)
  let items = []int(0)
  while (!atListClose(p, Kind.RParen)) {
    items = append(items, parseParam(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RParen)
  return mkNode(p, Tag.Params, 0, items)
}
