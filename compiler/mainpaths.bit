// #3166: split out of main.bit to stay under the repo's 800-line E0200
// limit (spec/LINT.md's max-file-lines). Plain path-string helpers
// (pathDir/pathBase/pathStem) plus resolving `std/*` and the install
// prefix relative to this binary's own location. `main`'s dispatch lives
// in main.bit.

// Whether '\' counts as a path separator on the host this binary is
// actually RUNNING on — never the `--target` being compiled to (that is
// `build.bit`'s separate `isWindowsTarget(BuildTarget)`, over the artifact
// being produced, not the one executing right now).
//
// '\' is a legal POSIX filename byte — a file literally named "a\b.txt" is
// valid on macOS/Linux — so this must be false on every non-Windows host or
// pathDir/pathBase/pathStem below would mis-split a real filename there.
// Bit has no compile-time target-conditional compilation (spec/SPEC.md), so
// this cannot be a build-time branch; `hostTarget()` is the existing
// primitive for "which host am I actually on", already relied on by
// `build.bit`'s `hostBuildTarget()` (a runtime primitive baked into the
// per-target libbitrt this binary itself links against) — reused here
// rather than inventing a second convention, per this ticket's own
// instruction.
fn hostBackslashSep(): bool {
  return isWindowsTarget(hostBuildTarget())
}

// Whether `b` is a path-separator byte on this host: always '/', plus '\'
// when `winSep` (hostBackslashSep(), computed once per call by the three
// functions below) is true. One place to hold the byte-92 decision so
// pathDir/pathBase/pathStem — and mainpaths.bit's siblings that split an OS
// path by hand (buildout.bit's stripTrailingSlashes, pmcliinit.bit's
// isUsableProjectName) — all agree with each other rather than each
// re-deriving it.
fn isPathSepByte(b: u8, winSep: bool): bool {
  if (b == u8(47)) { // '/'
    return true
  }
  return winSep && b == u8(92) // '\' -- only when winSep, i.e. only on Windows
}

// A path's directory, or "." when it names a bare file in the cwd.
// "examples/hello.bit" -> "examples", "a.bit" -> ".". Mirrors the seed's
// `std.fs.path.dirname(src) orelse "."`.
fn pathDir(path: string): string {
  let b = []byte(path)
  let winSep = hostBackslashSep()
  let cut = -1
  let i = 0
  while (i < len(b)) {
    if (isPathSepByte(b[i], winSep)) {
      cut = i
    }
    i = i + 1
  }
  if (cut < 0) {
    return "."
  }
  if (cut == 0) {
    return "/" // a path rooted at "/" has "/" as its directory
  }
  return path[0:cut]
}

// A path's final component. "examples/hello.bit" -> "hello.bit".
fn pathBase(path: string): string {
  let b = []byte(path)
  let winSep = hostBackslashSep()
  let start = 0
  let i = 0
  while (i < len(b)) {
    if (isPathSepByte(b[i], winSep)) {
      start = i + 1
    }
    i = i + 1
  }
  return path[start:len(path)]
}

// The module name / default output: a path's basename without its extension.
// "examples/hello.bit" -> "hello", "a.bit" -> "a".
fn pathStem(path: string): string {
  let b = []byte(path)
  let winSep = hostBackslashSep()
  let start = 0
  let i = 0
  while (i < len(b)) {
    if (isPathSepByte(b[i], winSep)) {
      start = i + 1
    }
    i = i + 1
  }
  let end = len(b)
  i = start
  while (i < len(b)) {
    if (b[i] == u8(46)) { // '.'
      end = i
    }
    i = i + 1
  }
  return string(b[start:end])
}

// The directory-target default output (`stripTrailingSlashes`,
// `manifestProjectName`, `buildDirDefaultOut`) lives in buildout.bit — a
// sibling file, same module, #2260.

// Where `std/*` imports resolve (#1452), by the same three-step rule as
// libbitrtPath: an explicit override, then this binary's own install prefix,
// then the dev-tree cwd-relative default.
fn stdRootPath(): string {
  let override = envOr("BIT_STDLIB", "")
  if (len(override) > 0) {
    return override
  }
  let near = resolveNearExe("stdlib")
  if (len(near) > 0) {
    return near
  }
  return "stdlib"
}

// `rel` resolved against the install prefix inferred from this binary's OWN
// location, or "" when it is not there (#1452).
//
// This is what lets an unpacked release artifact work from any directory
// through a bare symlink into PATH, with no wrapper script and no environment
// variables — the shipped layout is `<prefix>/bin/bit` beside `<prefix>/stdlib`
// and `<prefix>/lib/<triple>/libbitrt.a`, so the prefix is the parent of the
// binary's directory. A flat unpack (everything beside the binary) is tried
// second.
//
// `selfExe()` resolving symlinks is the load-bearing part: an installer puts a
// symlink in PATH, and the SYMLINK's directory is not the install root. It also
// returns "" rather than guessing when the platform cannot say — `arg(0)` is
// not a fallback, being only whatever the caller passed.
//
// Probing rather than assuming is deliberate too: a build-tree `bit` sits at
// `bit-out/bin/bit`, where `../lib/<triple>/libbitrt.a` really does exist but
// `../stdlib` does not. Each path is answered on its own evidence, so the dev
// tree keeps working without a special case.
fn resolveNearExe(rel: string): string {
  let exe = selfExe()
  if (len(exe) == 0) {
    return ""
  }
  let binDir = pathDir(exe)
  let atPrefix = "${pathDir(binDir)}/${rel}"
  if (fsExists(atPrefix)) {
    return atPrefix
  }
  let beside = "${binDir}/${rel}"
  if (fsExists(beside)) {
    return beside
  }
  return ""
}
