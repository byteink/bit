// compiler/lowerslicefill.bit — split out of lowerlit.bit (#1924), which the
// fill loop below pushed past the 800-line limit; `zeroValue` and
// the omitted-field fill moved here from lowerlit.bit for the same reason
// (#4182, then merged with the §10.5 default fill by #4469). This is now the module's "§13.4 zero-value machinery" file: what a
// type's zero value IS (`zeroValue`), whether it HAS one at all
// (`typeHasNoZeroValue`), and the two lowering sites that must materialize one
// where a zeroed allocation is not enough (`fillZeroElems` for `[]T(n)`'s
// elements, `fillOmittedFields` for a class's own omitted fields).
// Sibling of lowerlit.bit: same module, so this needs no imports and no
// call-site changes.
//
// FILENAME ORDER NO LONGER AFFECTS CODEGEN QUALITY (#3163, 2026-08-16):
// inlining is whole-module and order-independent, so which file a callee's
// definition lives in cannot change what gets inlined. It still affects
// nothing about correctness here regardless, since every function in this
// module resolves by name — `structTySubst`/`emitRtCall`/`emitJump`/
// `buildEnumObj`/`lowerSliceElems` are all still defined elsewhere in this
// module and called from here exactly as they were before the move.

// Whether `ty` has no zero value at all (§13.4, E0083, #1914, #4182): a class
// with a class-typed (or no-zero-value-enum-typed) field, or itself a boxed
// enum whose declaration-order first variant carries a payload. The checker's
// `vMissingStructFields`/`vFieldHasNoZeroValue`/`enumZeroVariantName`
// (validatezero.bit) answer the same question and build the message; this
// side only needs the yes/no, and cannot reuse those directly because they run
// off a `Checker` before lowering has an `FnCtx` — `vFieldHasNoZeroValue` IS
// reused here per field, since it already takes a bare `Checker` and `fc.c` is
// one.
//
// Substituted through `structTySubst`, for the same reason the layouts are: a
// generic `Box<Inner>` must see `Inner` where the declaration says `T`, or a
// monomorphization with a class or enum argument slips past.
fn typeHasNoZeroValue(fc: FnCtx, ty: int): bool {
  let tk = fc.c.ctx.types[ty].kind
  if (tk == TypeKind.Enum) {
    return enumZeroVariantName(fc.c, ty) != ""
  }
  if (tk != TypeKind.Struct) {
    return false
  }
  let decl = structDeclOf(fc.c, ty)
  if (decl == 0) {
    return false
  }
  let oc = typeOwner(fc.c, ty)
  let sub = structTySubst(fc, oc, decl, ty)
  for f of structFieldNodes(oc, decl) {
    let fty = typeFromNodeIn(oc, kidsOf(oc.tree, f)[1], sub)
    if (vFieldHasNoZeroValue(fc.c, fty)) {
      return true
    }
  }
  return false
}

// `[]T(n)` where T is a STRUCT, or (#4182) a BOXED ENUM whose first variant
// has no payload: give the fresh backing `n` live zero instances (#1924).
//
// `slice_new` zeroes the buffer, which IS the zero value of a scalar, a string
// or a nested slice — and is a NULL REFERENCE for a class or a boxed enum,
// since both are reference types. So `[]Inner(2)` handed back two wild
// pointers and `s[0].xs` segfaulted with no diagnostic, on a construct whose
// whole documented purpose is "n zero values" (SPEC §12.9); `[]Shape(2)` for
// `enum Shape { Unit, Circle(f64) }` did the same the instant anything read
// its tag. Nothing else in the language produces a null class or a null enum,
// so nothing downstream is prepared to meet one.
//
// A REAL IR LOOP, not a runtime primitive, and the reason is the collector
// rather than convenience. The slice stays live across every element's
// `gc_alloc` safepoint. Here it is a reference-typed SSA value, so the stack map
// describes it by construction. Inside a `@nosplit` runtime helper it would be a
// raw `int` in a frame that only the conservative scan can see, which is the
// weaker guarantee and an open defect in its own right (#1834).
//
// Only `Struct` and boxed `Enum` need filling. Every other element kind's zero
// value is zero bits, and `[N]T` cannot be a slice element at all (E0072
// rejects a reference-typed array element).
//
// Returns the slice again, as the exit block's parameter — NOT the value passed
// in, and `hSlice`/`hN` are read rather than `sliceV`/`nV`. That is a hard
// requirement, not a style choice: a value defined OUTSIDE a loop may not be
// read INSIDE it, because its live interval is not extended to cover the loop
// and the register is reused by the body. The first version of this function
// read `sliceV` and `nV` straight out of the entry block and ran exactly ONE
// iteration — element 0 live, elements 1..n-1 still null — with no diagnostic
// anywhere. `verify.bit` now refuses that IR (#1925); `lowerWhile` threads every
// live local through its header for the same reason.
//
//     jump header(%s, %n, 0)
//   header(%s', %n', %i):  br %i < %n' -> body, exit(%s')
//   body:                  %o = gc_alloc T; slice_set %s'[%i] = %o
//                          jump header(%s', %n', %i + 1)
//   exit(%s''):            <- the enclosing expression carries on here
//
// #4566: when the element type's zero record is SHAREABLE (`zeroIsShareable`
// below — a tuple of scalars, whose members SPEC §12.5:2187 makes read-only)
// the `gc_alloc` moves ABOVE the header and its result is threaded through as
// a fourth loop parameter, so `[]T(n)` allocates once rather than `n` times:
//
//     %z = gc_alloc T                     <- once, whatever `n` is
//     jump header(%s, %n, 0, %z)
//   header(%s', %n', %i, %z'):  br %i < %n' -> body, exit(%s')
//   body:                       slice_set %s'[%i] = %z'
//                               jump header(%s', %n', %i + 1, %z')
//
// The loop and its back-edge poll are unchanged, so the safepoint count is the
// same either way (#4552).
//
// The body takes no parameters: it has the header as its single predecessor, so
// there is nothing to merge (again as `lowerWhile` does).
fn fillZeroElems(fc: FnCtx, sliceV: int, elemTy: int, nV: int, span: Span): int {
  let i64ty = primType(fc.c.ctx, 3)
  let sliceTy = fc.b.instrs[sliceV].ty
  let header = builderNewBlock(fc.b)
  let body = builderNewBlock(fc.b)
  let exit = builderNewBlock(fc.b)

  let zero = mkInstr(Op.ConstInt, i64ty)
  zero.ival = 0
  // #4566: for a shareable element type ONE record is built HERE, above the
  // loop, and threaded through the header — threaded rather than read directly
  // inside the body, for the same reason `hSlice`/`hN` are (see above).
  let shared = sharedZeroRecord(fc, elemTy, span)
  if (fc.failed) {
    return 0
  }
  emitJump(fc, header, fillLoopArgs(sliceV, nV, builderEmit(fc.b, zero), shared))
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, header)
  let hSlice = builderAddParam(fc.b, sliceTy)
  let hN = builderAddParam(fc.b, i64ty)
  let hI = builderAddParam(fc.b, i64ty)
  let hZ = 0
  if (shared != 0) {
    hZ = builderAddParam(fc.b, fc.b.instrs[shared].ty)
  }
  let lt = mkInstr(Op.ICmpSlt, primType(fc.c.ctx, 10))
  lt.lhs = hI
  lt.rhs = hN
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = builderEmit(fc.b, lt)
  br.ival = body
  br.thenArgs = []int(0)
  br.ival2 = exit
  br.elseArgs = [hSlice]
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, body)
  if (!emitFillBody(fc, fillLoopArgs(hSlice, hN, hI, hZ), elemTy, header, span)) {
    return 0
  }
  builderBeginBlock(fc.b, exit)
  return builderAddParam(fc.b, sliceTy)
}

// The header's parameter list, and the argument list of both jumps that reach
// it — ONE spelling for all three (#4566), so a shared record threaded into
// the header cannot fall out of step with what the edges pass. `shared` is 0
// when the element type has no shareable zero record, and the fourth slot then
// does not exist at all rather than carrying a placeholder.
fn fillLoopArgs(sliceV: int, nV: int, iV: int, shared: int): []int {
  if (shared == 0) {
    return [sliceV, nV, iV]
  }
  return [sliceV, nV, iV, shared]
}

// The fill loop's body block, which the caller has already opened: store one
// zero record into `hp[0][hp[2]]` and jump back to `header`. Ends the block on
// every path it takes; returns false only when lowering has failed, where the
// caller abandons the whole fill.
//
// `hp` is the header's parameters as `fillLoopArgs` laid them out —
// slice, n, i, and the shared zero record when there is one.
//
// An element type with NO zero value (a class with a class-typed field, or a
// boxed enum whose first variant carries a payload, §13.4) cannot be filled.
// The checker rejects that outright when `n` folds to a constant above zero,
// which is the diagnosable case; a runtime `n` it cannot decide, and `[]S(0)`
// is both legal and the idiomatic empty slice. So the body — entered only
// when `n > 0` — panics rather than storing a null and handing the caller a
// segfault later, at a place that no longer names the slice.
fn emitFillBody(fc: FnCtx, hp: []int, elemTy: int, header: int, span: Span): bool {
  if (typeHasNoZeroValue(fc, elemTy)) {
    emitNoZeroValuePanic(fc, elemTy, "[]" + typeName(fc.c.ctx, elemTy) + "(n)")
    builderEndBlock(fc.b)
    return true
  }
  // The hoisted record when the header carries one, else a fresh one per
  // element — which is what `[]T(n)` for a class or a boxed enum still does.
  // `hZ` and `zv` stay separate: the back edge below must pass the header's
  // OWN parameter back (or nothing at all), never the per-element record.
  let hZ = 0
  if (len(hp) > 3) {
    hZ = hp[3]
  }
  let zv = hZ
  if (hZ == 0) {
    zv = zeroValue(fc, elemTy, span)
    if (fc.failed) {
      return false
    }
  }
  // elem_size (ABI.md §9, #3121/#3226): see `lowerlit.bit`'s
  // `lowerSliceAlloc` for the full rationale; `sliceElemSizeFor` lives in
  // `lowerlayout.bit`. Every element kind that reaches here is a reference —
  // a class, a boxed enum or (#4500) a tuple — so this is always 8 in
  // practice, never a packed `[]u8`, but computed rather than hard-coded to
  // match every other call site and not depend on that invariant holding.
  let i64ty = primType(fc.c.ctx, 3)
  let esI = mkInstr(Op.ConstInt, i64ty)
  esI.ival = sliceElemSizeFor(fc, elemTy)
  let esV = builderEmit(fc.b, esI)
  let ss = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  ss.name = "slice_set"
  ss.args = [hp[0], hp[2], zv, esV]
  emitRtCall(fc, ss)
  let one = mkInstr(Op.ConstInt, i64ty)
  one.ival = 1
  let next = mkInstr(Op.Add, i64ty)
  next.lhs = hp[2]
  next.rhs = builderEmit(fc.b, one)
  emitJump(fc, header, fillLoopArgs(hp[0], hp[1], builderEmit(fc.b, next), hZ))
  builderEndBlock(fc.b)
  return true
}
// `panic(...)` naming a type §13.4 gives no zero value, followed by
// `unreachable`. The caller opens whatever block follows; this only terminates
// the current one.
//
// Shared by the two places that must materialize a zero value and cannot: the
// `[]T(n)` fill above, and `m[k]`'s miss edge (`emitMapMiss`, lowermapaccess.bit).
// Both are reached only at run time — the checker rejects every case it can
// decide statically (E0083) — and both would otherwise store or return a null
// class or a null enum, which segfaults later at a place that no longer names
// the map or the slice.
//
// `what` names the construct, not the type, so the message reads as the thing
// the programmer wrote rather than as a compiler-internal fact. The message
// itself does not say WHY `ty` has no zero value (#4182: it is either a
// class-typed field or a payload-carrying zero-tag enum variant) — `bit check`
// already reported that with a field or variant name; this is the runtime
// fallback for the case it could not decide statically.
fn emitNoZeroValuePanic(fc: FnCtx, ty: int, what: string) {
  let name = typeName(fc.c.ctx, ty)
  let msg = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  msg.sval = what + ": '" + name + "' has no zero value (SPEC 13.4)"
  msg.ival = internPoolString(fc, msg.sval)
  let pn = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  pn.name = "panic"
  pn.args = [builderEmit(fc.b, msg)]
  emitRtCall(fc, pn)
  builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
}

// The zero value of `ty`, materialized.
//
// The Struct arm emits a zeroed `GcAlloc` and then fills, via
// `fillOmittedFields`. It used to write no field at all, on the strength of a
// comment asserting that was CORRECT rather than a shortcut: the checker's
// E0083 (#1914) rejects a class with a class-typed field, so "every class that
// does get here has only fields whose zero value IS zero bits". That claim was
// false from the day #4182 landed and it cost an s1 miscompile (#4469): a
// boxed-enum field passes E0083 — `E { A, B(int) }` has a payload-free tag-0
// variant, so it HAS a zero value — but that zero value is a live `{tag:0}`
// object, not zero bits. `GcAlloc` left it NULL and the first `match` on it
// segfaulted with no diagnostic, from `[]T(n)`, from `let p: T`, from a map
// miss and from the object an `init` starts with, while the literal `T{}`
// printed the right answer because #4182 wired its fill into that one site.
// Defaults (§10.5, #3838) reach this arm the same way and for the same reason.
//
// The Enum arm is the same invariant reached through variant order instead of
// field order (#4182): a boxed enum reaches it only when its tag-0 variant
// carries no payload (validatezero.bit rejects every other one as E0083
// first). The old fallthrough built a bare `ConstNil` for EVERY enum — a null
// REFERENCE, not a tag-0 object, so the first tag read (`match`, `isNone`, ...)
// dereferenced it. A bare (non-boxed) enum's zero bits are already its first
// variant's tag, so that case still falls through unchanged.
//
// This function used to be paired with a `zeroOmittedFields` in the literal
// path that filled class-typed fields one level deep. That fill was deleted
// with the checker rule: two mechanisms answering the same question is how they
// come to disagree, and the fill's own recursion stopped at depth 1 anyway, so
// `Inner` inside `Inner` was still a null.
fn zeroValue(fc: FnCtx, ty: int, span: Span): int {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 10) {
      let b = mkInstr(Op.ConstBool, ty)
      b.bval = false
      return builderEmit(fc.b, b)
    }
    if (td.prim == 8 || td.prim == 9) {
      let f = mkInstr(Op.ConstFloat, ty)
      return builderEmit(fc.b, f)
    }
    if (td.prim == 11) {
      let s = mkInstr(Op.ConstString, ty)
      s.sval = ""
      s.ival = internPoolString(fc, s.sval)
      return builderEmit(fc.b, s)
    }
    let ci = mkInstr(Op.ConstInt, ty)
    return builderEmit(fc.b, ci)
  }
  if (td.kind == TypeKind.Array) {
    return newArray(fc, ty)
  }
  if (td.kind == TypeKind.Struct) {
    return zeroValueStruct(fc, ty, span)
  }
  if (td.kind == TypeKind.Tuple) {
    return zeroValueTuple(fc, ty, span)
  }
  // A slice zero-value is the EMPTY slice (SPEC §13.4), which since #3648 is
  // spelled as the null header — `lowerSliceElems` with no items.
  //
  // THIS COMMENT USED TO SAY THE OPPOSITE and its reason was stale: "a null
  // header has no `len` word to load, so `len(xs)` on it faults". #1564 fixed
  // that fault in both backends (`emitHeaderWordOrZero`), so null and empty are
  // now indistinguishable to a program in every operation, not just in the
  // `xs == nil` that E0053 already forbids.
  if (td.kind == TypeKind.Slice) {
    return lowerSliceElems(fc, ty, []int(0))
  }
  return zeroValueEnumOrNil(fc, ty, td)
}

// The Tuple arm of `zeroValue` above (#4414). A tuple is a boxed record
// (ABI.md §1.1), so its zero BITS are a null reference exactly as a class's
// are: `let w: (int, int)` used to lower to `const_nil` and the first `w.0`
// segfaulted, while the class and array forms beside it both zeroed correctly.
//
// Built through `buildTuple` — the one constructor every tuple goes through,
// literal or return — rather than a `GcAlloc` this function fills itself, so
// a change to the tuple representation cannot reach the literal and miss the
// zero value.
//
// Every member is stored, including the ones whose zero value IS zero bits and
// whose store `GcAlloc` has already made redundant. The Struct arm does the
// opposite (`omittedFieldValue` returns 0 and emits nothing for those), and it
// can: a class field's type is constrained by E0083, which is why that arm only
// has to materialize a boxed enum. A tuple member is not, so the set of member
// kinds whose zero bits are wrong is wider — a nested tuple, an inline array
// (`layoutFields` gives a tuple's array member a POINTER slot, where
// `structLayout` gives a class's the array's bytes inline), a class, a boxed
// enum. A predicate naming that set would be a second answer to a question
// `zeroValue` already answers, and #4469 is what that costs: two mechanisms
// disagreed and the disagreeing half left a null.
fn zeroValueTuple(fc: FnCtx, ty: int, span: Span): int {
  let members = fc.c.ctx.types[ty].members
  let vals = []int(0)
  let i = 0
  while (i < len(members)) {
    vals = append(vals, zeroValue(fc, members[i], span))
    if (fc.failed) {
      return 0
    }
    i = i + 1
  }
  return buildTuple(fc, ty, vals)
}

// The Struct arm of `zeroValue` above, split out for the same reason
// `zeroValueEnumOrNil` below it was: adding #4469's failure check took the
// parent to complexity 11 against E0204's ceiling of 10.
//
// The `GcAlloc` is only the start of a class's zero value. `fillOmittedFields`
// then writes every field whose real zero value is not the zero bytes
// `GcAlloc` just handed back — a declared default (§10.5) or a boxed enum's
// live `{tag:0}` object (§13.4) — and emits nothing at all for a class with
// neither, which is most of them.
fn zeroValueStruct(fc: FnCtx, ty: int, span: Span): int {
  let decl = structDeclOf(fc.c, ty)
  if (decl == 0) {
    fcFail(fc, span, "a zero value for a class type with no declaration in scope")
    return 0
  }
  let oc = typeOwner(fc.c, ty)
  let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, ty))
  let ga = mkInstr(Op.GcAlloc, ty)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(fc.b, ga)
  fillOmittedFields(fc, obj, ty, []int(0), span)
  if (fc.failed) {
    return 0
  }
  return obj
}

// The last two arms of `zeroValue` above, split out to keep it under E0204's
// complexity ceiling: a boxed enum's real zero value (#4182), or `ConstNil`
// for everything else that reaches here (map/chan/function/interface, whose
// zero IS `nil`, per §13.4).
fn zeroValueEnumOrNil(fc: FnCtx, ty: int, td: Type): int {
  if (td.kind == TypeKind.Enum && td.enumBoxed) {
    return buildEnumObj(fc, ty, 0, -1)
  }
  let nl = mkInstr(Op.ConstNil, ty)
  return builderEmit(fc.b, nl)
}

// Lowers one field DEFAULT (SPEC §10.5, #3838) against the module that DECLARED
// it. The initializer node indexes the declaring module's arena, so reading it
// against this module's tree lands on an unrelated node — the whole reason a
// check-time AST splice was rejected for this feature. Both the checker and the
// const table are swapped for the duration, so a default spelled `1024 * KB`
// resolves `KB` in its own module; identical to the technique lowerdriver.bit's
// `lowerNamedValue` already uses to inline an IMPORTED const at a use site.
//
// `fty` is passed as the hint for the same reason the const path passes the
// const's declared type: unhinted, `port: f64 = 1` would materialize
// `const_int 1` and store an integer bit pattern into an f64 field (#2429).
fn lowerFieldDefault(fc: FnCtx, oc: Checker, deflt: int, fty: int): int {
  let savedC = fc.c
  let savedConsts = fc.moduleConsts
  fc.c = oc
  if (oc.moduleId != savedC.moduleId) {
    fc.moduleConsts = collectModuleConsts(oc)
  }
  let v = lowerExprH(fc, deflt, fty)
  fc.c = savedC
  fc.moduleConsts = savedConsts
  return v
}

// Whether `ty`'s §13.4 zero value is a LIVE BOXED RECORD — an object that has
// to be built — rather than the zero word every zeroing allocator already
// hands back. True for a class, a tuple and a boxed enum, all three of which
// are boxed records (ABI.md §1.1) whose zero BITS are a null REFERENCE, not
// the zeroed instance / zeroed tuple body / `{tag:0,nil}` object §13.4
// specifies.
//
// ONE ANSWER FOR THE THREE SITES THAT ASK IT (#4500). This was three parallel
// lists — `omittedFieldValue` here, `zeroIsObject` in lowermapaccess.bit and
// `sliceAllocElemNeedsFill` in lowerlit.bit — and all three named the class
// and the boxed enum while none named the tuple, so `let c: C`, `C{}`, a map
// miss and `[]T(n)` each handed back a null tuple and segfaulted on the first
// member read. That is #4469's shape a second time: several mechanisms
// answering one question, and the ones that disagree leave a null. A fourth
// site asking it can now only get the same answer.
//
// The map site adds `string`, slice and inline array to this set, and that
// difference is real rather than drift: it returns ONE WORD for a miss, where
// a class field and a `[]T(n)` element sit in memory a zeroing allocator owns
// — an inline array's bytes are already its zero value there, and a null
// string/slice header already reads as the empty one (#1564, #3648).
//
// No cycle to guard against: the recursion this drives (`zeroValue` -> a
// member/field that is itself a record) only descends through classes and
// tuples, and E0047 rejects every such cycle at check time ("cannot contain
// itself: A -> B -> A"). A boxed enum's tag-0 variant carries no payload
// (E0083), so its arm never descends at all.
fn zeroIsLiveRecord(fc: FnCtx, ty: int): bool {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Struct || td.kind == TypeKind.Tuple) {
    return true
  }
  return td.kind == TypeKind.Enum && td.enumBoxed
}

// #4566: is `ty`'s zero record SHAREABLE — may ONE instance stand in for every
// element of `[]ty(n)`, instead of `n` separately allocated ones?
//
// Yes exactly when `ty` is a tuple whose members are, transitively, scalar
// primitives and other such tuples. Two facts make the substitution
// unobservable for that set and only that set:
//
//   - SPEC 12.5:2187 makes tuple elements READ-ONLY: `t.0` may be read but
//     never assigned. So no member of a shared record can be written through,
//     and `n` zero tuples of scalars are indistinguishable from one.
//   - `==` on a tuple is element-wise (SPEC 14.6, `vTupleComparable`), so
//     sharing cannot be observed as identity either.
//
// A MUTABLE member breaks it outright and is the reason this is a new
// predicate rather than a widening of `zeroIsLiveRecord`: for
// `[]((i64,i64), P, E)(2)` with `P` a class, `ds[0].1.a = 5` is legal — the
// tuple member is read-only, the CLASS it names is not — and a shared record
// would make that write visible through `ds[1].1.a` too. A slice or map member
// is the same hazard through `append`/`m[k] =`. So every kind that is not a
// scalar primitive answers false, and the walk stops there rather than
// enumerating the mutable kinds: a kind added to the language later is then
// excluded by default, which is the safe direction.
//
// STRING is excluded although a Bit string is immutable, because its zero
// value is not a record member this pass builds — the win is the `gc_alloc`,
// and a tuple of strings still allocates one per element for the ConstString
// members. Including it would widen the predicate for no measured gain.
//
// The recursion is bounded rather than argued: a tuple type's members are
// interned before the tuple itself, so pure tuple nesting is finite and
// acyclic, but `depth > 32` answers false (do NOT share) so that a type the
// walk cannot finish declines the optimization instead of deciding it. Every
// bail-out here is the conservative one.
fn zeroIsShareable(fc: FnCtx, ty: int, depth: int): bool {
  if (depth > 32) {
    return false
  }
  let td = fc.c.ctx.types[ty]
  if (td.kind != TypeKind.Tuple) {
    return false
  }
  for m of td.members {
    if (!zeroMemberIsScalar(fc, m, depth + 1)) {
      return false
    }
  }
  return true
}

// One member of the walk above: a non-string scalar primitive, or a tuple that
// is itself shareable. `td.prim == 11` is `string` (see `primName`).
fn zeroMemberIsScalar(fc: FnCtx, ty: int, depth: int): bool {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    return td.prim != 11
  }
  return zeroIsShareable(fc, ty, depth)
}

// The ONE zero record `fillZeroElems` stores into every slot of `[]elemTy(n)`,
// or 0 for "there is no shareable one — build a fresh record per element".
// Emitted into whatever block is open, which at its only call site is the
// block ABOVE the fill loop; 0 is never a real value there because the slice
// this fills is already an earlier instruction.
fn sharedZeroRecord(fc: FnCtx, elemTy: int, span: Span): int {
  if (!zeroIsShareable(fc, elemTy, 0)) {
    return 0
  }
  return zeroValue(fc, elemTy, span)
}

// The value an OMITTED field of type `fty` must be given, or 0 for "write
// nothing — `GcAlloc`'s zero bytes are already correct". `deflt` is the field's
// default initializer node, 0 when it declares none.
//
// Two cases, in this order, and the order is not arbitrary: a declared default
// (§10.5, #3838) always wins, and only a field with NO default can need the
// §13.4 zero-value materialization below it.
//
// A field whose zero value is a live record — a boxed enum (#4182), a tuple
// (#4500) — is the case that needs materializing: its zero BITS are a null
// REFERENCE, where §13.4 specifies a built object. `zeroIsLiveRecord` is the
// one place that set is named. Every other omittable field — scalar, string,
// slice, map, chan, interface, inline array — has zero bits as its real zero
// value, which is exactly what `GcAlloc` hands back, so this returns 0 and no
// store is emitted.
//
// The checker (`vMissingStructFields`/`vFieldHasNoZeroValue`, validatezero.bit)
// has already rejected any field whose type has NO zero value — a class-typed
// field outright, per §13.4's cycle-recursion rationale, and an enum whose
// tag-0 variant carries a payload. So every field reaching here is safe to
// materialize, and a boxed enum's tag-0 zero value never itself carries a
// payload, so there is no recursion and no cycle to guard against.
fn omittedFieldValue(fc: FnCtx, oc: Checker, deflt: int, fty: int, span: Span): int {
  if (deflt != 0) {
    return lowerFieldDefault(fc, oc, deflt, fty)
  }
  if (zeroIsLiveRecord(fc, fty)) {
    return zeroValue(fc, fty, span)
  }
  return 0
}

// Gives every field of `structTy` that `named` does not mention the value the
// language says it carries: its declared default (§10.5), or its §13.4 zero
// value where `GcAlloc`'s raw zero bytes are not already that value.
// `named` is a composite literal's initializer list; every ZERO-VALUE
// construction passes an empty one.
//
// ONE loop for both, and that is the fix for #4469 rather than a tidy-up. These
// were two functions, `fillDefaultFields` and `fillOmittedEnumFields`, and the
// second took the literal's AST NODE — so it could be called only from
// `lowerClassLit` and not from `zeroValue`, which has no node. The result was
// that `Holder{}` filled a boxed-enum field and `[]Holder(1)`, `let p: Holder`
// and `H(...)`'s `init` object all left it NULL and segfaulted on the first tag
// read. A comment asserted the omission was safe; it was a claim, not a check.
//
// The two loops were also documented as provably disjoint — "a default must
// fold to a compile-time constant (§15.4), and no enum value folds, so they can
// never write the same offset". That was true, and it was another comment
// asserting soundness. Here it is structural: one pass over the fields, one
// value per field, so writing an offset twice is not expressible.
//
// Called from BOTH construction sites on purpose. A field honored only by a
// literal would make `Opts{}` and `[]Opts(1)[0]` disagree about something the
// author declared exactly once, and the disagreeing half is always the raw zero
// — which for a defaulted field (a TLS mode, a body-size cap) is the unsafe
// answer, and for a boxed enum is a null pointer. `zeroValue`'s Struct arm
// covers `[]T(n)`, a bare `let p: T`, a map miss and the object an `init`
// starts from; §10.4 already allows an `init` to leave a field alone, and that
// only holds if the object it is handed carries the field's value.
//
// Recomputes the declaration/layout `lowerClassLit` already has, trading a
// little duplicate compile-time work for staying at E0202's 5-param ceiling — a
// class bundling `oc`/`fields`/`sub`/`layout` for two callers would be more
// machinery than the question it answers.
fn fillOmittedFields(fc: FnCtx, obj: int, structTy: int, named: []int, span: Span) {
  let decl = structDeclOf(fc.c, structTy)
  if (decl == 0) {
    return
  }
  let oc = typeOwner(fc.c, structTy)
  let sub = structTySubst(fc, oc, decl, structTy)
  let layout = structLayout(fc, oc, decl, sub)
  let fields = structFieldNodes(oc, decl)
  let i = 0
  while (i < len(fields)) {
    let fk = kidsOf(oc.tree, fields[i])
    let fldNode = getNode(oc.tree, fk[0])
    if (vLitNamesField(fc.c, named, oc.source[fldNode.span.start:fldNode.span.end])) {
      i = i + 1
      continue
    }
    let fty = typeFromNodeIn(oc, fk[1], sub)
    let val = omittedFieldValue(fc, oc, fk[2], fty, span)
    if (fc.failed) {
      return
    }
    if (val != 0) {
      let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
      fs.lhs = obj
      fs.ival = layout.offsets[i]
      fs.rhs = val
      fs.ival2 = fty
      builderEmit(fc.b, fs)
    }
    i = i + 1
  }
}
