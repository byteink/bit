// compiler/relationautomatch.bit — #6336, epic #6298: a `match` arm's own
// single payload binder (`Some(x)`, `Ok(x)`, or any other single-payload
// variant the grammar has — `variant_pat = IDENT [ "(" IDENT { "," IDENT }
// ")" ]`, SPEC §13.8) traces back to the arm's own SCRUTINEE, which then
// resolves exactly as any other expression `relationAutoResolve`
// (compiler/relationauto.bit) already handles — a direct query, a
// `.unwrap()`, or a named function whose return summary reaches one
// (compiler/relationautocalls.bit). Split out of relationauto.bit/
// relationautoerr.bit once adding this pushed the former past its own
// 800-line ceiling (spec/LINT.md) — a pure move, not a rewrite: every
// function here is unchanged from the file it came from.
//
// `relationAutoWalkMatch` (the R1/R2/R2b splice side, relationauto.bit's own
// `relationAutoWalk` dispatch) and `relationAutoErrWalkMatch` (the R3
// error-reporting side, relationautoerr.bit's own `relationAutoErrWalk`
// dispatch) share ONE binder-construction helper,
// `relationAutoMatchArmBinding`, so a match arm binds identically for both —
// never two independently-maintained answers to "does this arm's payload
// alias the scrutinee".

// Whether `armPat` (a `Tag.VariantPat`, `[nameIdent, binders_or_none]`) binds
// exactly one payload name that should trace back to `flow` — `Some(x)`,
// `Ok(x)`, or any other single-payload variant a `match` arm unwraps: the
// grammar never special-cases a variant by name, so the same rule R1 already
// uses for `.unwrap()` (`relationAutoResolveCall`, relationauto.bit) applies
// here — a payload bound off an already-resolved, non-slice row IS that row.
// A bare variant (`None`, `_`, no parens) or a multi-binder variant carries
// no single value to alias, so it is left untracked, same as any other
// unhandled shape.
fn relationAutoMatchArmBinding(
  c: Checker,
  armPat: int,
  flow: RelationAutoFlow,
): (RelationAutoBinding, bool) {
  let none = RelationAutoBinding{
    varName = "", cls = RelationAutoClass{ found = false, oc = c, decl = 0, ty = 0 }, queryCall = 0,
    paramName = "", isSlice = false, afterOffset = 0, ownerModule = c.moduleId, path = "",
  }
  if (!flow.found || flow.isSlice) {
    return (none, false)
  }
  let binders = kidsOf(c.tree, armPat)[1]
  if (binders == 0) {
    return (none, false)
  }
  let ids = kidsOf(c.tree, binders)
  if (len(ids) != 1) {
    return (none, false)
  }
  return (
    RelationAutoBinding{
      varName = identText(c.tree, c.source, ids[0]), cls = flow.cls, queryCall = flow.queryCall,
      paramName = flow.paramName, isSlice = false, afterOffset = getNode(c.tree, ids[0]).span.start,
      ownerModule = flow.ownerModule, path = flow.path,
    },
    true,
  )
}

// `kids = [subject, arm_list]` (parserstmt.bit's `parseMatch`). The subject
// is resolved once and shared by every arm — each arm's own payload binder
// (`relationAutoMatchArmBinding`) is pushed only for that ONE arm's body and
// popped again, mirroring `relationAutoWalkForOf`'s own scope-per-body rule
// (relationauto.bit).
fn relationAutoWalkMatch(c: Checker, node: int, st: RelationAutoState) {
  let k = kidsOf(c.tree, node)
  relationAutoWalk(c, k[0], st)
  let flow = relationAutoResolve(c, k[0], st)
  for arm of kidsOf(c.tree, k[1]) {
    let ak = kidsOf(c.tree, arm)
    let (binding, pushed) = relationAutoMatchArmBinding(c, ak[0], flow)
    if (pushed) {
      st.bindings = append(st.bindings, binding)
    }
    relationAutoWalk(c, ak[1], st)
    if (pushed) {
      st.bindings = st.bindings[0:len(st.bindings) - 1]
    }
  }
}

// Mirrors `relationAutoWalkMatch` (above) exactly, so a match arm's single
// payload binder traces to the same scrutinee for error reporting as it does
// for splicing.
fn relationAutoErrWalkMatch(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  relationAutoErrWalk(c, k[0], ctx)
  let flow = relationAutoResolve(c, k[0], ctx.st)
  for arm of kidsOf(c.tree, k[1]) {
    let ak = kidsOf(c.tree, arm)
    let (binding, pushed) = relationAutoMatchArmBinding(c, ak[0], flow)
    if (pushed) {
      ctx.st.bindings = append(ctx.st.bindings, binding)
    }
    relationAutoErrWalk(c, ak[1], ctx)
    if (pushed) {
      ctx.st.bindings = ctx.st.bindings[0:len(ctx.st.bindings) - 1]
    }
  }
}

// ---- an Option of a row is the row (#6407) ---------------------------------
//
// `first()`'s `Option<T>` is already modelled as the row `T` (relationauto.bit's
// `relationAutoSourceMethodNames`); the other ways to build or hold an Option of
// a row follow the same rule, so a `match` over one reaches the query behind it:
// `Option.Some(row)` is `row`, and a local of type `Option<Row>` is a holder of
// that row class (`relationAutoOptionPayload`, used by relationautoholder.bit).

// The one argument of `Option.Some(arg)` -- node `n` is a `Call` -- or 0 when
// `n` is anything else.
fn relationAutoOptionSomeArg(c: Checker, n: int): int {
  let k = kidsOf(c.tree, n)
  let mk = kidsOf(c.tree, k[0])
  let recvTy = enumReceiverType(c, mk[0])
  if (recvTy == 0 || !c.ctx.types[recvTy].hasName || c.ctx.types[recvTy].name != "Option") {
    return 0
  }
  let args = kidsOf(c.tree, k[2])
  if (len(args) != 1 || getNode(c.tree, args[0]).tag != Tag.Arg) {
    return 0
  }
  return kidsOf(c.tree, args[0])[0]
}

// What a call `n` that wraps or unwraps one value resolves to: `x.unwrap()` and
// `Option.Some(x)` carry exactly the rows `x` does. Never a slice: neither
// shape hands back several rows. Not found for every other call.
fn relationAutoResolveWrapped(c: Checker, n: int, st: RelationAutoState): RelationAutoFlow {
  let callee = kidsOf(c.tree, n)[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return relationAutoNoFlow(c)
  }
  let mk = kidsOf(c.tree, callee)
  let name = identText(c.tree, c.source, mk[1])
  let inner = relationAutoNoFlow(c)
  if (name == "unwrap") {
    inner = relationAutoResolve(c, mk[0], st)
  }
  let some = 0
  if (name == "Some") {
    some = relationAutoOptionSomeArg(c, n)
  }
  if (some != 0) {
    inner = relationAutoResolve(c, some, st)
  }
  if (inner.found && !inner.isSlice) {
    return inner
  }
  return relationAutoNoFlow(c)
}

// `ty`'s `Option<T>` payload `T`; `ty` itself for any other type.
fn relationAutoOptionPayload(c: Checker, ty: int): int {
  if (ty == 0) {
    return ty
  }
  let idx = typeInstOfResult(c.ctx, ty)
  if (idx < 0) {
    return ty
  }
  let inst = c.ctx.typeInsts[idx]
  if (inst.name != "Option" || len(inst.args) != 1) {
    return ty
  }
  return inst.args[0]
}

// ---- a tuple pattern over a tuple literal binds element by element ----------
//
// `let (o, n) = (Option.Some(row), 1)` binds `o` to the same rows `let o =
// Option.Some(row)` does: the literal's element at each position IS the value
// the pattern's element receives. Both `let` walkers (`relationAutoWalkLet`,
// relationauto.bit; `relationAutoErrWalkLet`, relationautoerr.bit) take their
// bindings from this one pairing, so a plain `let x = init` is just the
// one-pair case and a destructure cannot bind differently for splicing than for
// error reporting.

// One name bound to the expression that gives it its value.
class RelationAutoLetPair {
  pat: int,
  init: int,
}

// The (Ident pattern, initializer) pairs a `let` binds: `[(pattern, init)]` for
// an Ident pattern; for a `TuplePat` over a `TupleLit` of the same arity, the
// pairs of each element (nested patterns recurse); none for every other shape,
// which the walk leaves untracked. Bounded by the size of the pattern.
fn relationAutoLetPairs(c: Checker, pattern: int, init: int): []RelationAutoLetPair {
  let out = []RelationAutoLetPair(0)
  if (pattern == 0 || init == 0) {
    return out
  }
  let ptag = getNode(c.tree, pattern).tag
  if (ptag == Tag.Ident) {
    return append(out, RelationAutoLetPair{ pat = pattern, init = init })
  }
  if (ptag != Tag.TuplePat || getNode(c.tree, init).tag != Tag.TupleLit) {
    return out
  }
  let pats = kidsOf(c.tree, pattern)
  let items = kidsOf(c.tree, init)
  if (len(pats) != len(items)) {
    return out
  }
  let i = 0
  while (i < len(pats)) {
    for pair of relationAutoLetPairs(c, pats[i], items[i]) {
      out = append(out, pair)
    }
    i = i + 1
  }
  return out
}
