// compiler/namedargs.bit — named arguments at call sites (SPEC §12.11,
// #3839): `f(port = 3000)`, after any positional arguments. Sibling of
// validatecall.bit/validateiface.bit/lowercall.bit: same module, so this
// needs no imports and no call-site changes.
//
// SCOPE (#6343 widened #4686/#4688, which widened #4323's, which widened
// #3839's): named arguments are validated and lowered here for a direct call
// to a callee — generic or not — whose own parameter LIST is in scope: a
// top-level free function or `extern fn` (`vCall`, validatecall.bit, resolving through
// `funcRefAt`, checklookup.bit), the same free function spelled through a
// namespace alias, `ns.f(...)` (`vNsNamedArgs` below, #4686), a METHOD
// reached through `vCallValue`'s Member callee (validatecall.bit) on a
// class, primitive-alias, interface or type-parameter receiver, and a class
// CONSTRUCTOR against its `init` declaration (`vCallResolveBuiltin`, validatecall.bit,
// #4688). Every other call shape a `Tag.Call` node can have — a call through
// a function VALUE, a func-typed class FIELD, a builtin (`print`, `append`,
// `len`, ...), a primitive conversion, a class with no `init`,
// or a type-node "call" (`chan<T>(...)`, `[]T(...)`) —
// rejects any `Tag.NamedArg` outright (E0128) rather than attempting to
// resolve it.
//
// #3839 could not reach methods because it looked for the names in the wrong
// place: a method's checked signature (`methodSigLookup`, checklookup.bit)
// carries parameter TYPES only. The names are in the DECLARATION, which is
// exactly where the free path reads them from too — `methodRefAt`
// (checklookup.bit) hands back the same `FuncRef` shape `funcRefAt` does, and
// `declParamListNode` (check.bit) reads the same kid off it, so no second
// table holds method parameter names and the two paths cannot drift apart.
// `methodParamNodes` below is the whole of that resolution, and BOTH the
// checker and the lowerer (`lowerArgsForMethod`, lowercall.bit) call it — a
// name a call site writes therefore resolves against one declaration or
// against none, never against two different ones.

const ecNamedArgUnknown = 124
const ecNamedArgDuplicate = 125
const ecPositionalAfterNamed = 126
const ecNamedArgVariadic = 127
const ecNamedArgNotDirect = 128
// E0171 (#6121): a fixed parameter with NO default (SPEC §10.3) still
// unfilled once positional and named arguments are resolved. Distinct from
// `ecArgCount`'s bare-count message so the diagnostic names the actual
// parameter, matching every other named-argument rejection's shape.
const ecNamedArgMissing = 171

// The resolved callee `vCall` (validatecall.bit) dispatches to: a free
// function or `extern fn` declaration, fully known before any of its
// split-out helpers run. `owner`'s tree owns `decl`/`params`;
// `want`/`fixed`/`variadic` describe the parameter list's shape. Bundles
// what would otherwise be eight-plus separate parameters (E0202) into the
// one thing they all describe: WHICH decl this call targets, shared by
// `vCallKnownDecl` and every helper it calls (validatecall.bit), including
// this file's own named-argument path (same module, no import needed).
//
// `recv` is the receiver TYPE id of a method call (the constraint interface
// for a type-parameter receiver) and 0 for a free function: a generic
// method's type arguments come from the receiver's instantiation, not from
// `name` alone (`mkMethodCallDecl` below).
class CallDecl {
  owner: Checker, decl: int, name: string, generic: bool,
  params: []int, want: int, fixed: int, variadic: bool, minWant: int, recv: int,
}

// A `CallDecl` for `params` (nodes in `owner`'s tree). The variadic/fixed
// split is read off the parameter LIST's own shape: a trailing `...xs: T`
// absorbs every argument past the fixed ones, so only the prefix has an exact
// arity (§12.4). One derivation, called by `vCall` (validatecall.bit) for a
// free function and by `vMemberNamedArgs` below for a method, so the two
// cannot disagree about where a call's fixed prefix ends.
//
// `minWant` (SPEC §10.3, #5244) is the smallest positional count a call may
// supply: the index of the first FIXED parameter that carries a
// `= const_expr` default, or `fixed` when none do. `vCallKnownDecl`'s
// free-call path (`validatecall.bit`) and `vClassConstructCall`'s
// constructor path (classinit.bit) relax arity against it directly here;
// `vMethodCall` (validatemethodcall.bit, #5315) relaxes it too, but reads a
// method's own declaration through `methodMinWant` below rather than through
// a `CallDecl` (a method call has no `CallDecl` — `vCallAgainstFuncSig` reads
// an interned signature, not a declaration's parameter nodes). `lowerArgsFor`
// (lower.bit) and `lowerArgsForMethod` (lowercall.bit, #5315) are the two
// lowering paths that fill an omitted default, so this field — and
// `methodMinWant`'s answer — must not be read anywhere neither one covers.
fn minWantOf(owner: Checker, params: []int, fixed: int): int {
  let minWant = fixed
  let i = 0
  while (i < fixed) {
    if (len(kidsOf(owner.tree, params[i])) == 3) {
      minWant = i
      break
    }
    i = i + 1
  }
  return minWant
}

fn mkCallDecl(owner: Checker, decl: int, name: string, generic: bool, params: []int): CallDecl {
  let want = len(params)
  let variadic = want > 0 && getNode(owner.tree, params[want - 1]).tag == Tag.ParamRest
  let fixed = want
  if (variadic) {
    fixed = want - 1
  }
  let minWant = minWantOf(owner, params, fixed)
  return CallDecl{
    owner = owner, decl = decl, name = name, generic = generic,
    params = params, want = want, fixed = fixed, variadic = variadic, minWant = minWant,
    recv = 0,
  }
}

// The smallest positional count a call through method/constructor
// declaration `decl` (in `owner`'s tree) may supply, given the call's
// already-resolved `variadic`/`want` (SPEC §10.3, #5244) — `want` (no
// relaxation) when `decl == 0` (an interface method, which has no
// `FuncDecl` to read a default off — SPEC does not require an implementer
// to repeat an interface's default, so this never reads one) or when the
// resolved shape's param count does not match `want` (a shape this call
// site's own resolution already disagrees with; refuse rather than index
// past either list). Reads through `declParamShapeNode` (check.bit, #6263),
// not `declParamListNode` directly: a plain method's own arity/defaults
// never depend on instantiation, so a method of a GENERIC class must relax
// exactly as one of a concrete class does — `declParamListNode`'s -1 used to
// make this return `want` outright for every method of a generic class,
// defaulted parameter or not (E0050 on a call a concrete-class sibling
// method accepts). Shared by `vCallAgainstFuncSig` (validatemethodcall.bit)
// and `lowerArgsForMethod` (lowercall.bit) so the checker's relaxation and
// the lowerer's default-fill can never drift onto different methods (#5315,
// mirroring the guarantee `mkCallDecl`'s own comment above states for the
// free-call path).
fn methodMinWant(owner: Checker, decl: int, variadic: bool, want: int): int {
  if (decl == 0) {
    return want
  }
  let plist = declParamShapeNode(owner, decl)
  if (plist <= 0) {
    return want
  }
  let params = kidsOf(owner.tree, plist)
  if (len(params) != want) {
    return want
  }
  let fixed = want
  if (variadic) {
    fixed = want - 1
  }
  return minWantOf(owner, params, fixed)
}

// `vCallArity`'s (validatecall.bit) own shape parameters, bundled to keep
// that function at 5 or fewer (E0202) once `minWant` (SPEC §10.3, #5244)
// joined `variadic`/`want`.
class CallArity {
  variadic: bool, want: int, minWant: int,
}

// `CallDecl.want`/`.minWant`/`.variadic` as a `CallArity`, for the one caller
// (`vCallKnownDecl`, validatecall.bit) that may relax arity for a defaulted
// call.
fn callArityOf(cd: CallDecl): CallArity {
  return CallArity{ variadic = cd.variadic, want = cd.want, minWant = cd.minWant }
}

// Reports E0050 for a non-variadic call's argument count against `want` and
// `minWant` (SPEC §10.3, #5244) — split out of `vCallArity` purely to keep
// that function's own branch count from growing with the defaulted-argument
// range check.
fn vNonVariadicArityMismatch(c: Checker, node: int, want: int, minWant: int, got: int) {
  if (minWant == want) {
    if (want != got) {
      reportNoHint(
        c.diags, ecArgCount, vSpan(c, node),
        "expected ${want} argument(s), found ${got}",
      )
    }
    return
  }
  if (got < minWant) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "expected at least ${minWant} argument(s), found ${got}",
    )
    return
  }
  if (got > want) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "expected ${want} argument(s), found ${got}",
    )
  }
}

// The declaring module and the parameter NODE list of the method a member
// call binds to — the same (owner, params) pair the free path gets from
// `funcRefAt` + `declParamListNode`, so `paramNameOf` below reads a method's
// parameter names out of the identical shape. `ok` is false for every member
// callee SPEC §12.11 leaves positional-only, and the caller then reports
// E0128; `owner`/`params` are then meaningless and must not be read.
class MethodParams { owner: Checker, params: []int, ok: bool, decl: int }

// Resolves `recvType.mname` to its declaration's parameter list — the
// signature the call site STATICALLY sees (SPEC §12.11). A TypeParam receiver
// resolves against its CONSTRAINT interface (`methodRecvType`,
// checklookup.bit), exactly as a call through an interface value does: the
// call dispatches positionally after monomorphization, so an implementation
// whose parameter names differ still receives each value in the slot the
// interface's names bound it to. A generic class's method reads its own
// parameter list through `declParamShapeNode` (check.bit) — names never
// depend on the type arguments; only the parameter TYPES do, and those are
// substituted by `namedCallEnv` below before any argument is judged.
// `decl` is the method's declaration, 0 for an interface method.
fn methodParamNodes(c: Checker, recvType: int, mname: string): MethodParams {
  let none = MethodParams{ owner = c, params = []int(0), ok = false, decl = 0 }
  if (recvType <= 0) {
    return none
  }
  let rt = methodRecvType(c, recvType)
  let fr = methodRefAt(c, rt, mname)
  if (fr.decl == 0) {
    return ifaceMethodParamNodes(c, rt, mname)
  }
  let plist = declParamShapeNode(fr.owner, fr.decl)
  if (plist <= 0) {
    return none
  }
  return MethodParams{
    owner = fr.owner, params = kidsOf(fr.owner.tree, plist), ok = true, decl = fr.decl,
  }
}

// The `fr.decl == 0` half of `methodParamNodes`: an INTERFACE method has no
// `FuncDecl` at all (`methodDecls`, types.bit, records concrete methods only),
// so its names live on the `MethodSig` node inside the `InterfaceDecl` — kid
// 1, the same `parseParams` list a `FuncDecl` carries, which is why
// `paramNameOf` and `Tag.ParamRest` read it unchanged. Reached through
// `typeOwner`/`declNodeIn` (lowerlayout.bit) because a node index means
// nothing outside its own tree.
//
// The interface's declaration is the RIGHT list for a call through an
// interface-typed receiver: dispatch is dynamic, the call site knows only the
// interface, and `lowerArgsForMethod` (lowercall.bit) lowers such a call with
// the interface type as its receiver type, so it resolves the same names.
fn ifaceMethodParamNodes(c: Checker, recvType: int, mname: string): MethodParams {
  let none = MethodParams{ owner = c, params = []int(0), ok = false, decl = 0 }
  if (c.ctx.types[recvType].kind != TypeKind.Interface) {
    return none
  }
  let oc = typeOwner(c, recvType)
  let decl = declNodeIn(oc, Tag.InterfaceDecl, c.ctx.types[recvType].name)
  if (decl == 0) {
    return none
  }
  let sigs = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let i = 0
  while (i < len(sigs)) {
    let sk = kidsOf(oc.tree, sigs[i])
    let nm = getNode(oc.tree, sk[0])
    if (oc.source[nm.span.start:nm.span.end] == mname) {
      return MethodParams{ owner = oc, params = kidsOf(oc.tree, sk[1]), ok = true, decl = 0 }
    }
    i = i + 1
  }
  return none
}

// The `CallDecl` of a method call resolved to `mp` (`methodParamNodes` above)
// on receiver type `recv` (the constraint interface for a type parameter).
// A method of a generic class carries the class's type parameters on its own
// generics list (`parseMethodMember`, parsertype.bit), so `generic` is set by
// the same `declParamListNode` test a generic free function is: it makes
// `vCallArgWant` (validatecallargs.bit) substitute the receiver's type
// arguments into each parameter type instead of judging against the open `T`.
fn mkMethodCallDecl(mp: MethodParams, recv: int, mname: string): CallDecl {
  let generic = mp.decl != 0 && declParamListNode(mp.owner, mp.decl) < 0
  let cd = mkCallDecl(mp.owner, mp.decl, mname, generic, mp.params)
  cd.recv = recv
  return cd
}

// The substitution env a GENERIC named-argument call judges its arguments
// under, and whether inference settled it (SPEC §12.11: after names are bound,
// the call is checked exactly as the positional one). A free function's is
// `vCallGenericEnv`'s (validatecallargs.bit) — which also reports the E0068
// gap; a method's is the one `recordMethodInstantiation` (checkproject.bit)
// records: the receiver's type arguments plus the method's own.
fn namedCallEnv(c: Checker, node: int, cd: CallDecl): (TypeEnv, bool) {
  if (cd.recv == 0) {
    return vCallGenericEnv(c, node, cd)
  }
  let fr = methodRefAt(c, cd.recv, cd.name)
  let env = genericEnvOf(fr.owner, fr.decl, methodTypeArgs(c, fr, cd.recv, node))
  return env, len(env.params) > 0
}

// A NAMESPACED free call's named arguments, `ns.f(b = 2, a = 1)` (#4686).
// Answers false when `callee` is not one, leaving `vMemberNamedArgs` below
// to try the method path on the same node.
//
// SPEC §12.11 admits this call: `f` is a named function whose declaration is
// in scope, spelled through the alias. It resolves exactly as the bare
// spelling does — `vNsCalleeIsFuncDecl` (validatemember.bit, #4647) decides
// the SHAPE node-keyed through the resolver, so a local binding shadowing
// the alias stays a method call, and `funcRefAt` on the dotted key then
// hands back the same `FuncRef` `vCall` (validatecall.bit) gets for
// `f(...)`, because `bindNamespaceImport` (checkproject.bit) enters every
// export of the aliased module under `alias + "." + name`.
//
// The lowering side reads the SAME declaration: `lowerCall`'s namespaced arm
// (lowercall.bit) resolves `qn` through `resolveCallTarget` and lowers
// through `lowerArgsForCall` (lowernamedarg.bit), whose `declParamShapeNode`
// call is the one above.
fn vNsNamedArgs(c: Checker, node: int, callee: int, args: []int, namedStart: int): bool {
  if (!vNsCalleeIsFuncDecl(c, callee)) {
    return false
  }
  let qn = nsQualifiedName(c, callee)
  let fr = funcRefAt(c, callee, qn)
  let generic = declParamListNode(fr.owner, fr.decl) < 0
  let params = kidsOf(fr.owner.tree, declParamShapeNode(fr.owner, fr.decl))
  vCallNamedArgs(c, node, mkCallDecl(fr.owner, fr.decl, qn, generic, params), args, namedStart)
  return true
}

// A STATIC method call's named arguments, `Box.zero(a = 2)` (SPEC §10.4.1,
// #6091/#6099, #6121) — through the class's own name only. `mk[0]` names a
// TYPE, not a value, so plain `methodParamNodes` below — which types the
// receiver through `checkExprType` — never resolves it and every static
// named-argument call fell to `vRejectNamedArgs` (E0128) before this.
// Answers false when `callee`'s base does not name a static receiver at all
// (`staticReceiverType`, checkexprcall.bit) or names one with no static
// method by this name, leaving the instance-method path below to try the
// same node — mirrors `vNsNamedArgs`'s identical early-return shape.
//
// A BOUND GENERIC's `T.label(x = 1)` resolves against its CONSTRAINT
// interface's declared signature: `staticReceiverType` answers the interface
// (`sst`'s kind is `TypeKind.Interface`, never reachable for a direct class
// name) and `methodParamNodes` reads the names off its `MethodSig`, the same
// rule an interface VALUE receiver gets. `lowerArgsForNamedMethod`
// (lowernamedarg.bit) resolves the identical interface for the lowering, so a
// name binds the slot it was checked against even though the call dispatches
// positionally to the concrete implementation after monomorphization.
//
// For a direct class receiver, `methodParamNodes` is reused unchanged:
// `collectFuncDecl` (checkbindfunc.bit) records a static method into the SAME
// `methodDecls` table under the SAME "<typeId>.<name>" key an instance
// method uses (only `staticMethods` distinguishes the two), so its ordinary
// `fr.decl != 0` arm already reads the right declaration. The lowering side
// reads the identical one: `lowerStaticMethodCall` (lowercall.bit) resolves
// `mname` through `methodRefAt(fc.c, recvTy, mname)` on the SAME class id,
// the same lookup this validates against.
fn vStaticNamedArgs(c: Checker, node: int, callee: int, args: []int, namedStart: int): bool {
  let mk = kidsOf(c.tree, callee)
  let sst = staticReceiverType(c, mk[0])
  if (sst == 0) {
    return false
  }
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  if (!staticMethodLookup(c, "${sst}.${mname}")) {
    return false
  }
  let mp = methodParamNodes(c, sst, mname)
  if (!mp.ok) {
    vRejectNamedArgs(c, args)
    return true
  }
  noteNamedRecv(c, node, sst)
  vCallNamedArgs(c, node, mkMethodCallDecl(mp, sst, mname), args, namedStart)
  return true
}

// The named-argument branch of `vCallValue` (validatecall.bit) — the whole
// of it, for every callee shape that function handles. A Member callee that
// resolves to a declaration is validated exactly as a free call is, through
// `vCallNamedArgs` below: a namespaced free function via `vNsNamedArgs`
// above (#4686), a static method via `vStaticNamedArgs` above (#6121),
// otherwise an instance method via `methodParamNodes`. Everything else (a
// function VALUE, a func-typed class field, an unresolved or generic method)
// is E0128.
fn vMemberNamedArgs(c: Checker, node: int, callee: int, args: []int, namedStart: int) {
  if (getNode(c.tree, callee).tag != Tag.Member) {
    vRejectNamedArgs(c, args)
    return
  }
  if (vNsNamedArgs(c, node, callee, args, namedStart)) {
    return
  }
  if (vStaticNamedArgs(c, node, callee, args, namedStart)) {
    return
  }
  let mk = kidsOf(c.tree, callee)
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  let recv = checkExprType(c, mk[0])
  let mp = methodParamNodes(c, recv, mname)
  if (!mp.ok) {
    vRejectNamedArgs(c, args)
    return
  }
  let bindTy = methodRecvType(c, recv)
  noteNamedRecv(c, node, bindTy)
  vCallNamedArgs(c, node, mkMethodCallDecl(mp, bindTy, mname), args, namedStart)
}

// The index of the first `Tag.NamedArg` in `args`, or `len(args)` if none —
// the single query every hook point below uses to decide whether a call's
// argument list needs any of this module's attention at all.
fn namedArgStart(tree: Tree, args: []int): int {
  let i = 0
  while (i < len(args)) {
    if (getNode(tree, args[i]).tag == Tag.NamedArg) {
      return i
    }
    i = i + 1
  }
  return len(args)
}

// Reports E0128 at every `Tag.NamedArg` in `args` — the call this list
// belongs to is not a direct call to a concrete named function or method
// whose declaration is in scope (SPEC §12.11's DIRECT CALLS ONLY
// restriction).
fn vRejectNamedArgs(c: Checker, args: []int) {
  let i = 0
  while (i < len(args)) {
    if (getNode(c.tree, args[i]).tag == Tag.NamedArg) {
      reportNoHint(
        c.diags, ecNamedArgNotDirect, vSpan(c, args[i]),
        "named arguments require a direct call to a named function",
      )
    }
    i = i + 1
  }
}

// A `Param`/`ParamRest` node's declared name (kid 0 is the name leaf).
fn paramNameOf(tree: Tree, source: string, paramNode: int): string {
  let nm = getNode(tree, kidsOf(tree, paramNode)[0])
  return source[nm.span.start:nm.span.end]
}

// `params`'s index whose name is `name`, or -1. `params` is read from
// `owner`'s tree — a cross-module call reads the exporter's own declaration,
// exactly as every other per-parameter lookup in this checker does.
fn paramIndexByName(owner: Checker, params: []int, name: string): int {
  let i = 0
  while (i < len(params)) {
    if (paramNameOf(owner.tree, owner.source, params[i]) == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Ordering (SPEC §12.11): every entry from `namedStart` on must be a
// `Tag.NamedArg` — a positional argument written after a named one is
// rejected — and a `...` spread may never appear alongside a named argument
// at all: a spread already claims every remaining position for the variadic
// slot, leaving no argument-list position a named argument could still fill,
// so the two forms have nothing to agree on. Checked over the WHOLE list,
// not just the entries at or after `namedStart`, because a spread BEFORE
// `namedStart` still makes the call ill-formed here — `vCall`'s own ordinary
// spread rule never runs for a call that reaches this branch at all. Split
// out of `vCallNamedArgs` purely to keep ITS OWN complexity from growing
// (spec/LINT.md E0204, tools/build/complexity-debt.txt); returns true when
// nothing here was wrong.
fn vNamedArgOrder(c: Checker, args: []int, namedStart: int): bool {
  let ok = true
  let j = 0
  while (j < len(args)) {
    let t = getNode(c.tree, args[j]).tag
    if (t == Tag.ArgSpread) {
      reportNoHint(
        c.diags, ecInvalidSpread, vSpan(c, args[j]),
        "'...' spread cannot be combined with named arguments",
      )
      ok = false
    } else if (j >= namedStart && t != Tag.NamedArg) {
      reportNoHint(
        c.diags, ecPositionalAfterNamed, vSpan(c, args[j]),
        "positional argument after a named argument",
      )
      ok = false
    }
    j = j + 1
  }
  return ok
}

// The mutable output of resolving a named-argument call's names to
// parameter indices: `filled[i]` once parameter `i` is bound (by position OR
// by name — SPEC §12.11 forbids both the same way, so nothing distinguishes
// them), `slot[j]` the declared index each `args[j]` fills. Both are sized
// `want`/`len(args)` by the caller and mutated together across
// `vNamedArgResolveNames`, then read together by `vNamedArgTypeCheck` —
// bundling them keeps every helper here under E0202's 5-parameter limit.
// `env` is the substitution a generic callee's parameter types are judged
// under (`namedCallEnv` above); empty for a concrete one.
class NamedResolution { filled: []bool, slot: []int, env: TypeEnv }

// Resolves each named entry `args[namedStart:]` to a parameter index,
// marking `res.filled`/`res.slot` as it goes. E0124 unknown name, E0127 the
// variadic parameter itself, E0125 a parameter already filled. Split out of
// `vCallNamedArgs` for the same complexity reason as `vNamedArgOrder`;
// returns true when every name resolved cleanly.
fn vNamedArgResolveNames(
  c: Checker,
  cd: CallDecl,
  args: []int,
  namedStart: int,
  res: NamedResolution,
): bool {
  let ok = true
  let m = namedStart
  while (m < len(args)) {
    let nk = kidsOf(c.tree, args[m])
    let nameNode = getNode(c.tree, nk[0])
    let argName = c.source[nameNode.span.start:nameNode.span.end]
    let pidx = paramIndexByName(cd.owner, cd.params, argName)
    if (pidx < 0) {
      reportNoHint(
        c.diags, ecNamedArgUnknown, vSpan(c, args[m]),
        "no parameter named '${argName}'",
      )
      ok = false
    } else if (cd.variadic && pidx == cd.want - 1) {
      reportNoHint(
        c.diags, ecNamedArgVariadic, vSpan(c, args[m]),
        "variadic parameter '${argName}' cannot be named",
      )
      ok = false
    } else if (res.filled[pidx]) {
      reportNoHint(
        c.diags, ecNamedArgDuplicate, vSpan(c, args[m]),
        "parameter '${argName}' supplied more than once",
      )
      ok = false
    } else {
      res.filled[pidx] = true
      res.slot[m] = pidx
    }
    m = m + 1
  }
  return ok
}

// Every FIXED parameter below `cd.minWant` (SPEC §10.3, #5244) — the ones
// with NO default — must be filled exactly once; a fixed parameter AT or
// past `cd.minWant` may stay unfilled, since it carries a `= const_expr`
// default that `lowerArgsForNamed` (lowernamedarg.bit) then fills, exactly as
// a plain positional call's own trailing omission already does (#6121: a
// named or skipped-default call must lower to the same IR as the fully
// spelled-out positional one, so the checker's arity rule and the lowerer's
// fill rule read the identical `minWant` boundary). Checked in two parts:
// `namedStart` positional arguments can never exceed `cd.fixed` many on
// their own (or a fixed parameter would need both a position and, per the
// same rule, a name), and once names are resolved every UN-defaulted index
// must be marked in `filled`, named in the diagnostic (E0171) rather than
// folded into a bare count. Split out of `vCallNamedArgs` for the same
// complexity reason as `vNamedArgOrder`.
fn vNamedArgArity(c: Checker, node: int, cd: CallDecl, namedStart: int, filled: []bool): bool {
  if (namedStart > cd.fixed) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "expected ${cd.fixed} argument(s) before named arguments, found ${namedStart}",
    )
    return false
  }
  let ok = true
  let f = 0
  while (f < cd.minWant) {
    if (!filled[f]) {
      reportNoHint(
        c.diags, ecNamedArgMissing, vSpan(c, node),
        "missing argument '${paramNameOf(cd.owner.tree, cd.owner.source, cd.params[f])}'",
      )
      ok = false
    }
    f = f + 1
  }
  return ok
}

// Argument TYPES (E0041) — the same rule `vCall`'s own positional loop
// applies to a plain call, ported unchanged: `vExpectExpr` alone answers
// both the scalar and the interface-target case (#3050), so no separate
// `vIfaceStore` pass is needed here either. Split out of `vCallNamedArgs` for
// the same complexity reason as `vNamedArgOrder`.
fn vNamedArgTypeCheck(
  c: Checker,
  cd: CallDecl,
  args: []int,
  namedStart: int,
  res: NamedResolution,
) {
  let p = 0
  while (p < namedStart) {
    let a = kidsOf(c.tree, args[p])[0] // Tag.Arg
    let pty = vCallArgWant(c, cd, p, false, res.env)
    if (pty != 0) {
      vExpectExpr(c, a, pty)
    }
    p = p + 1
  }
  let q = namedStart
  while (q < len(args)) {
    let expr = kidsOf(c.tree, args[q])[1] // Tag.NamedArg [name, expr]
    let pty = vCallArgWant(c, cd, res.slot[q], false, res.env)
    if (pty != 0) {
      vExpectExpr(c, expr, pty)
    }
    q = q + 1
  }
}

// Validates AND type-checks a call whose callee has the concrete parameter
// list `cd.params` (in `cd.owner`'s tree) — a free function via `vCall`
// (validatecall.bit), a method via `vMemberNamedArgs` above — and whose
// argument list `args` contains at least one `Tag.NamedArg`, starting at
// `namedStart`. Called in place of the caller's ordinary
// spread/variadic/arity/type loop — this function is the WHOLE
// of that branch and reports every diagnostic itself, via the four phases
// above: ordering, name resolution, arity, then argument types — each phase
// bails the whole call the moment it finds a problem, so `filled`/`slot`
// (shared, mutated in place) are always read only after they are proven
// complete for what remains.
fn vCallNamedArgs(c: Checker, node: int, cd: CallDecl, args: []int, namedStart: int) {
  if (!vNamedArgOrder(c, args, namedStart)) {
    return
  }
  let filled = []bool(cd.want)
  let k = 0
  while (k < namedStart) {
    filled[k] = true
    k = k + 1
  }
  let res = NamedResolution{ filled = filled, slot = []int(len(args)), env = emptyTypeEnv() }
  if (!vNamedArgResolveNames(c, cd, args, namedStart, res)) {
    return
  }
  if (!vNamedArgArity(c, node, cd, namedStart, res.filled)) {
    return
  }
  if (cd.generic) {
    let (env, ok) = namedCallEnv(c, node, cd)
    if (!ok) {
      return
    }
    res.env = env
  }
  vNamedArgTypeCheck(c, cd, args, namedStart, res)
}

// THE one definition of "`vCallArgTypes` judges every argument of this call"
// (validatecall.bit): every spread in the shape `vSpreadsAreTyped` admits,
// and an argument count the signature admits — every argument then has a
// parameter to be judged against. `vCallArity` below returns it as its
// verdict and `vCallArgIface` (validateiface.bit) reads it to stay OFF
// exactly that shape, so the two cannot drift apart and double-report an
// interface argument once as "cannot store" and again as E0041. `want` is
// the declared parameter count; a variadic signature's fixed prefix is one
// shorter, and everything past it lands in the rest parameter.
//
// `minWant` (SPEC §10.3, #5244): the smallest positional count a
// non-variadic call may supply when a trailing prefix of `want`'s
// parameters carry a `= const_expr` default — equal to `want` for any
// signature with none, which collapses the range check below back to the
// old `== want` exactly. Moved here from validatecall.bit (SPEC §10.3,
// #5244) alongside `CallArity`/`CallDecl`, the shapes both this and
// `vCallArity` read.
fn vCallArgsAreTyped(c: Checker, args: []int, variadic: bool, want: int, minWant: int): bool {
  if (!vSpreadsAreTyped(c, args, variadic, want)) {
    return false
  }
  if (variadic) {
    return len(args) >= want - 1
  }
  return len(args) >= minWant && len(args) <= want
}

// Spread POSITIONS (E0063) and arity (E0050) for one call's argument list,
// judged against nothing but the callee's shape: `want` declared parameters,
// `variadic` or not. REPORTS only — the verdict is `vCallArgsAreTyped`'s,
// above, so the rule deciding whether the type loop runs is written once.
//
// Takes that shape as `CallArity` rather than a `CallDecl` so the METHOD and
// func-value path can share it: `vCallAgainstFuncSig` (validatemethodcall.bit)
// has an interned signature, not a declaration, and no `CallDecl` it could
// honestly build — its `params` are type ids, not the parameter NODES that
// class documents. #4671 is what the split cost: that path reported E0050 on
// its non-variadic arm only and judged no spread's position at all, so
// `f.tag()` for `tag(label: string, ...xs: i64)` reached IR verification
// with no diagnostic and `f.tag(...ys, 3)` reached the lowerer's E0092
// catch-all.
//
// `vCallSpreadAt` (validatecallargs.bit) is called HERE, not by the callers: it
// REPORTS as it scans, so it must run exactly once per call site, and this
// is the one place both paths pass through.
//
// `arity.minWant` (SPEC §10.3, #5244): the smallest positional argument
// count this call may supply without tripping E0050 — below `arity.want`
// only when a trailing prefix of the callee's parameters carry a
// `= const_expr` default. `vCallKnownDecl`'s free-call path
// (validatecall.bit), `vClassConstructCall`'s constructor path
// (classinit.bit) and `vCallAgainstFuncSig`'s method path
// (validatemethodcall.bit, #5315, via `methodMinWant`) each relax this only
// when the matching lowering path — `lowerArgsFor` (lower.bit) or
// `lowerArgsForMethod` (lowercall.bit) — fills the omitted default; no other
// caller may relax this and leave the gap unfilled at codegen.
fn vCallArity(c: Checker, node: int, args: []int, arity: CallArity): bool {
  let got = len(args)
  // The fixed prefix the rest parameter absorbs everything past. Both callers
  // derive `variadic` from a parameter list whose LAST entry is that rest
  // parameter, so `want > 0` holds whenever it is set; guarded here anyway so
  // the index cannot go negative on a caller that forgets.
  let fixed = arity.want
  if (arity.variadic && arity.want > 0) {
    fixed = arity.want - 1
  }
  let spreadAt = vCallSpreadAt(c, args, arity.variadic, got)
  if (spreadAt >= 0) {
    if (spreadAt != fixed) {
      reportNoHint(
        c.diags, ecArgCount, vSpan(c, node),
        "expected ${fixed} argument(s) before '...', found ${spreadAt}",
      )
    }
  } else if (arity.variadic) {
    if (got < fixed) {
      reportNoHint(
        c.diags, ecArgCount, vSpan(c, node),
        "expected at least ${fixed} argument(s), found ${got}",
      )
    }
  } else {
    vNonVariadicArityMismatch(c, node, arity.want, arity.minWant, got)
  }
  return vCallArgsAreTyped(c, args, arity.variadic, arity.want, arity.minWant)
}
