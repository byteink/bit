// compiler/namedargs.bit — named arguments at call sites (SPEC §12.11,
// #3839): `f(port = 3000)`, after any positional arguments. Sibling of
// validatecall.bit/validateiface.bit/lowercall.bit: same module, so this
// needs no imports and no call-site changes.
//
// SCOPE: named arguments are validated and lowered here ONLY for a direct
// call to a CONCRETE (non-generic) top-level free function or `extern fn` —
// the shape `vCall` (validatecall.bit) already resolves through `funcRefAt`.
// Every other call shape a `Tag.Call` node can have — a method, a call
// through a function VALUE, a builtin (`print`, `append`, `len`, ...), a
// primitive conversion, a class constructor, a generic function, or a
// type-node "call" (`chan<T>(...)`, `[]T(...)`) — rejects any `Tag.NamedArg`
// outright (E0128) rather than attempting to resolve it. The ticket's own
// restriction text names methods as legal too; that is NOT implemented here
// (a method's checked signature carries parameter TYPES only, never names —
// `methodSigLookup`'s `TypeKind.Func`, unlike a free function's `Param` node
// list — so resolving a name against it needs a second, parallel lookup this
// pass does not have time to build) and is filed as a follow-up rather than
// silently claimed.

const ecNamedArgUnknown = 124
const ecNamedArgDuplicate = 125
const ecPositionalAfterNamed = 126
const ecNamedArgVariadic = 127
const ecNamedArgNotDirect = 128

// The index of the first `Tag.NamedArg` in `args`, or `len(args)` if none —
// the single query every hook point below uses to decide whether a call's
// argument list needs any of this module's attention at all.
fn namedArgStart(tree: Tree, args: []int): int {
  let i = 0
  while (i < len(args)) {
    if (getNode(tree, args[i]).tag == Tag.NamedArg) {
      return i
    }
    i = i + 1
  }
  return len(args)
}

// Reports E0128 at every `Tag.NamedArg` in `args` — the call this list
// belongs to is not a direct call to a named, concrete, free function (SPEC
// §12.11's DIRECT CALLS ONLY restriction).
fn vRejectNamedArgs(c: Checker, args: []int) {
  let i = 0
  while (i < len(args)) {
    if (getNode(c.tree, args[i]).tag == Tag.NamedArg) {
      reportNoHint(
        c.diags, ecNamedArgNotDirect, vSpan(c, args[i]),
        "named arguments require a direct call to a named function",
      )
    }
    i = i + 1
  }
}

// A `Param`/`ParamRest` node's declared name (kid 0 is the name leaf).
fn paramNameOf(tree: Tree, source: string, paramNode: int): string {
  let nm = getNode(tree, kidsOf(tree, paramNode)[0])
  return source[nm.span.start:nm.span.end]
}

// `params`'s index whose name is `name`, or -1. `params` is read from
// `owner`'s tree — a cross-module call reads the exporter's own declaration,
// exactly as every other per-parameter lookup in this checker does.
fn paramIndexByName(owner: Checker, params: []int, name: string): int {
  let i = 0
  while (i < len(params)) {
    if (paramNameOf(owner.tree, owner.source, params[i]) == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Validates AND type-checks a call to a concrete free function `params`
// (`owner`'s tree) whose argument list `args` contains at least one
// `Tag.NamedArg`, starting at `namedStart`. Called from `vCall` in place of
// its ordinary spread/variadic/arity/type loop — this function is the WHOLE
// of that branch and reports every diagnostic itself.
//
// Ordering (SPEC §12.11): every entry from `namedStart` on must be a
// `Tag.NamedArg` — a positional argument written after a named one is
// rejected — and a `...` spread may never appear alongside a named argument
// at all: a spread already claims every remaining position for the variadic
// slot, leaving no argument-list position a named argument could still fill,
// so the two forms have nothing to agree on. `spreadAt` is checked over the
// WHOLE list, not just the entries this function's own caller (`vCall`) has
// not yet dispatched, because a spread positioned before `namedStart` still
// makes the call ill-formed here — the ordinary spread rules in `vCall`'s own
// loop never run for a call that reaches this function at all.
fn vCallNamedArgs(
  c: Checker, node: int, owner: Checker, params: []int, want: int,
  fixed: int, variadic: bool, args: []int, namedStart: int,
) {
  let got = len(args)
  let bad = false
  let j = 0
  while (j < got) {
    let t = getNode(c.tree, args[j]).tag
    if (t == Tag.ArgSpread) {
      reportNoHint(
        c.diags, ecInvalidSpread, vSpan(c, args[j]),
        "'...' spread cannot be combined with named arguments",
      )
      bad = true
    } else if (j >= namedStart && t != Tag.NamedArg) {
      reportNoHint(
        c.diags, ecPositionalAfterNamed, vSpan(c, args[j]),
        "positional argument after a named argument",
      )
      bad = true
    }
    j = j + 1
  }
  if (bad) { return }
  // No default arguments exist (SPEC §12 note), so every FIXED parameter not
  // reached by the positional prefix must be named — `namedStart` positional
  // arguments can never exceed `fixed` many, or a fixed parameter would need
  // BOTH a position and (per this same rule) a name.
  if (namedStart > fixed) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "expected ${fixed} argument(s) before named arguments, found ${namedStart}",
    )
    return
  }
  let filled = []bool(want)
  let k = 0
  while (k < namedStart) {
    filled[k] = true
    k = k + 1
  }
  // slot[m] is the resolved parameter index for args[m], m >= namedStart.
  let slot = []int(got)
  let m = namedStart
  while (m < got) {
    let nk = kidsOf(c.tree, args[m])
    let nameNode = getNode(c.tree, nk[0])
    let argName = c.source[nameNode.span.start:nameNode.span.end]
    let pidx = paramIndexByName(owner, params, argName)
    if (pidx < 0) {
      reportNoHint(
        c.diags, ecNamedArgUnknown, vSpan(c, args[m]),
        "no parameter named '${argName}'",
      )
      bad = true
    } else if (variadic && pidx == want - 1) {
      reportNoHint(
        c.diags, ecNamedArgVariadic, vSpan(c, args[m]),
        "variadic parameter '${argName}' cannot be named",
      )
      bad = true
    } else if (filled[pidx]) {
      reportNoHint(
        c.diags, ecNamedArgDuplicate, vSpan(c, args[m]),
        "parameter '${argName}' supplied more than once",
      )
      bad = true
    } else {
      filled[pidx] = true
      slot[m] = pidx
    }
    m = m + 1
  }
  if (bad) { return }
  let f = 0
  let missing = 0
  while (f < fixed) {
    if (!filled[f]) { missing = missing + 1 }
    f = f + 1
  }
  if (missing > 0) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "expected ${fixed} argument(s), found ${fixed - missing}",
    )
    return
  }
  // Argument TYPES (E0041) — the same rule `vCall`'s own positional loop
  // applies to a plain call, ported unchanged: `vExpectExpr` alone answers
  // both the scalar and the interface-target case (#3050), so no separate
  // `vIfaceStore` pass is needed here either.
  let p = 0
  while (p < namedStart) {
    let a = kidsOf(c.tree, args[p])[0] // Tag.Arg
    let pty = typeFromNode(owner, kidsOf(owner.tree, params[p])[1])
    if (pty != 0) { vExpectExpr(c, a, pty) }
    p = p + 1
  }
  let q = namedStart
  while (q < got) {
    let expr = kidsOf(c.tree, args[q])[1] // Tag.NamedArg [name, expr]
    let pty = typeFromNode(owner, kidsOf(owner.tree, params[slot[q]])[1])
    if (pty != 0) { vExpectExpr(c, expr, pty) }
    q = q + 1
  }
}
