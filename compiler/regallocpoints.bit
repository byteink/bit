// Register-allocation POINTS and the per-interval register mask they produce —
// split out of `regalloc.bit` (#4429) when that file crossed the 800-line
// ceiling. Same module, so nothing here is exported or imported differently;
// this is a seam, not an interface.
//
// The seam is a real one rather than a byte count: everything here answers one
// question — given where this function's calls, polls and safepoints are, which
// physical registers may this interval occupy? `regalloc.bit` keeps the scan
// itself, the interval order, the active list and the spill pools, and consumes
// `computeRegMasks`'s answer as a single `&`.

// The positions one allocation must reason about. A class rather than four
// parallel parameters because they are one description of the function's call
// structure and are always derived together (LINT.md E0202's own rationale).
class AllocPoints {
  // Every safepoint, in emission order. One StackMapEntry is produced per
  // element, in this order. `calleeSafepoints` and `polls` partition it.
  safepoints: []int,
  // The subset of `safepoints` whose stack map is consulted with the register
  // file RESTORED THROUGH THE FRAME CHAIN — i.e. every ordinary call. The
  // collector recovers those registers from the prologue save slots of the
  // frames it unwinds through, and a prologue saves only what the target's
  // convention makes callee-saved, so a GC reference live at one of these may
  // occupy only a `calleeSaved` register.
  calleeSafepoints: []int,
  // The subset of `safepoints` that is a BACK-EDGE POLL. Its stack map is only
  // ever consulted as frame 0 of the poll shim's own raw register snapshot
  // (runtime/gc/stackmap.bit's `gcScanSnapshot`), never after a restore, so a
  // reference here may occupy anything in `RegFile.pollSaved`. A poll is also a
  // weak clobber point: it destroys whatever `pollSaved` omits.
  polls: []int,
  // Positions at which the target's caller-saved registers are destroyed AND a
  // later instruction can still read one. `polls` is deliberately NOT included:
  // a poll clobbers a different, smaller set and is handled separately. An `asm`
  // block naming a caller-saved register is one too (#6382, asmPointPositions).
  clobbers: []int,
  // #6561: the plain calls (codegenlive.bit's `isPlainCallOp`: Op.Call, and
  // Op.RtCall since #7708), carried apart from `clobbers` because every
  // backend reads such a call's operands BEFORE its `bl`/`call`
  // (arm64call.bit's emitCallSeq, x64call.bit's xEmitCallSeq: marshal, then
  // branch). An interval whose last read IS the call is therefore dead when
  // the registers die, and only one still read after it crosses — see
  // `crossesCall`. Disjoint from `clobbers` by position kind, not by value: a
  // position in both (the poll-cache prefetch emitted ahead of an entry-block
  // call) is restricted by the stricter `clobbers` test.
  calls: []int,
  // #7251: the caller-saved registers each `asm` block pins as `input` or
  // `result` (AsmPin). Empty on a backend that still excludes every pin from
  // the whole function.
  pins: []AsmPin,
}

// #7251: one `asm` block's caller-saved `input`/`result` registers, as a
// FILE-POSITION mask over the int file, at the block's position. Narrower than
// a clobber point on both axes: it confines only an interval live across the
// block (`crossesPoint`, so an `input` read AT the block counts, because the
// emitter's moves into the pins run in plain sequence), and only out of the
// registers the block names. An interval that does not span the block may hold
// them, which is what a function-wide exclusion took away.
class AsmPin {
  pos: int,
  intMask: int,
}

// The int-file positions `iv` may not occupy because it spans a block pinning
// them. Zero for a float interval: an x64 pin names a GPR only.
fn pinnedAcross(iv: LiveInterval, pins: []AsmPin): int {
  let out = 0
  if (iv.regClass != RegClass.Int) {
    return out
  }
  for pin of pins {
    if (crossesPoint(iv, pin.pos)) {
      out = out | pin.intMask
    }
  }
  return out
}

// Every safepoint restricted to callee-saved rooting, nothing treated as a poll
// — what every caller that has not opted into #4429's split gets.
fn allocPoints(safepoints: []int, clobbers: []int): AllocPoints {
  return AllocPoints{
    safepoints = safepoints, calleeSafepoints = safepoints,
    polls = []int(0), clobbers = clobbers, calls = []int(0), pins = []AsmPin(0),
  }
}

// True iff `iv` is live across `p` in the sense that matters to a caller-saved
// register: it was defined strictly before `p` and is still read at or after
// it.
//
// The `end >= p` half rather than `end > p` is deliberate and is what makes
// this correct for a BACK-EDGE safepoint, where the clobbering call is emitted
// BEFORE the edge's parallel move (compiler/x64controlflow.bit's xEmitJump) —
// so a value whose last read IS that edge is read after the clobber, not
// before. A plain call is the one position where that is merely conservative,
// so it is tested by `crossesCall` instead (#6561).
fn crossesPoint(iv: LiveInterval, p: int): bool {
  return iv.start < p && iv.end >= p
}

// #6561: live across the plain call at `p` — defined before it and still read
// strictly AFTER it. An argument (end == p) is marshalled before the branch,
// so it may sit in a register the call destroys; under `crossesPoint` it was
// confined to a callee-saved one, which cost a save/restore pair and, in a
// function whose only call is a cold tail, put that pair on every hot path.
fn crossesCall(iv: LiveInterval, p: int): bool {
  return iv.start < p && iv.end > p
}

// True iff `iv` is one of the live references the stack map for a safepoint at
// `p` will name — the SAME predicate the stack-map loop at the bottom of
// `allocateCoalesced` applies, spelled once here so the two can never disagree.
//
// It is deliberately WIDER than `crossesPoint` by exactly one case, `start == p`
// (a reference DEFINED by the call at `p`, e.g. a gc_alloc result): the stack
// map names it, `crossesPoint` does not. That one case is why the two questions
// cannot share a predicate, and why a register file that answers only the
// clobber question is not safe for references — see `computeRestricted`.
fn rootedAtPoint(iv: LiveInterval, p: int): bool {
  return iv.isRef && iv.start <= p && iv.end >= p
}

// #7303: true iff `iv`'s register holds something the code after `p` still
// needs: a reference the map roots, or a value of any type live ACROSS `p`.
// `crossesPoint` rather than `rootedAtPoint`'s inclusive start keeps out the
// [p,p] filler interval of the safepoint's own instruction, which writes no
// register (#3101), and a non-reference a call at `p` has not produced yet.
// The poll shim reloads every saved register from its snapshot, so this is
// the set runtime/gc/stackmap.bit's `smLiveRegsAt` lets a collector rely on.
fn liveAtPoint(iv: LiveInterval, p: int): bool {
  return rootedAtPoint(iv, p) || (iv.regClass == RegClass.Int && crossesPoint(iv, p))
}

// One StackMapEntry per safepoint, in order: the registers and spill slots
// holding a live reference, and at a poll the live-register mask (#7303).
// Bounded by len(safepoints) * len(scan), both function-local and finite.
fn buildStackMaps(scan: []LiveInterval, locations: []RegLoc, points: AllocPoints): []StackMapEntry {
  let stackMaps = []StackMapEntry(0)
  for pos of points.safepoints {
    let sm = StackMapEntry{
      pos = pos, regs = []int(0), slots = []int(0),
      isPoll = posInList(points.polls, pos), live = 0,
    }
    for iv of scan {
      notePointLocation(sm, iv, locations[iv.vreg])
    }
    stackMaps = append(stackMaps, sm)
  }
  return stackMaps
}

// #7303: a StackMapEntry's FILE-POSITION `live` mask as a mask over physical
// register numbers, `phys[i]` naming file position i's register. The stack
// map and the poll shim's `regs[32]` snapshot are both indexed physically.
fn physRegMask(fileMask: int, phys: []int): int {
  let out = 0
  let i = 0
  while (i < len(phys)) {
    if (((fileMask >> i) & 1) != 0) {
      assert(phys[i] >= 0 && phys[i] < 32, "#7303: a physical register past the u32 mask")
      out = out | (1 << phys[i])
    }
    i = i + 1
  }
  return out
}

fn notePointLocation(sm: StackMapEntry, iv: LiveInterval, loc: RegLoc) {
  if (loc.isSpill) {
    if (rootedAtPoint(iv, sm.pos)) {
      sm.slots = append(sm.slots, loc.index)
    }
    return
  }
  if (rootedAtPoint(iv, sm.pos)) {
    sm.regs = append(sm.regs, loc.index)
  }
  if (sm.isPoll && liveAtPoint(iv, sm.pos)) {
    assert(loc.index >= 0 && loc.index < 32, "#7303: an int file position past the live mask")
    sm.live = sm.live | (1 << loc.index)
  }
}

// Per interval position, may it NOT hold a caller-saved register?
//
// Two independent reasons, and conflating them is a miscompile:
//
//  1. CLOBBER (#3171). The interval is live ACROSS a position where the
//     target's caller-saved registers are destroyed — `crossesPoint` over
//     `clobbers`. An empty `clobbers` restores the plain Poletto & Sarkar scan
//     exactly, register for register.
//
//  2. ROOTING (#4343). The interval holds a live GC REFERENCE that some
//     safepoint's stack map will name — `rootedAtPoint` over `safepoints`.
//     runtime/ABI.md §4 is explicit: the safepoint shim writes the callee-saved
//     file ONLY and leaves the rest of its snapshot untouched, so "a stack map
//     can only ever name a register the shim did save". A reference reported in
//     a caller-saved register is read out of an unwritten slot — a MISSED root
//     for any frame the walk unwinds into, i.e. a use-after-free, not a slow
//     program. Until #4343 this held for free: a safepoint-bearing function had
//     no caller-saved register in its int file at all.
//
// Reason 2 is gated on the caller having REPORTED a callee-saved mask, which is
// the meaning `RegFile.calleeSaved`'s zero default already carries. It is not
// gated on `clobbers`, deliberately: a backend may legitimately leave a
// non-returning call out of `clobbers` (nothing can read a register it
// destroyed) while that same call is still a safepoint that emits a stack map.
//
// #4429 SPLIT EACH REASON IN TWO, by the SURVIVING SET rather than by the
// reason. A back-edge poll is both a clobber and a safepoint, but the set that
// survives it is `RegFile.pollSaved`, not `calleeSaved` — so this returns a
// MASK to intersect with the file rather than a "restricted" flag. With no
// polls and no clobbers the mask is all-ones and every branch below reduces to
// the plain Poletto & Sarkar scan, register for register.
fn computeRegMasks(
  scan: []LiveInterval, points: AllocPoints, target: TargetRegs,
): []int {
  let out = []int(0)
  let i = 0
  while (i < len(scan)) {
    out = append(out, intervalRegMask(scan[i], points, target))
    i = i + 1
  }
  return out
}

fn crossesAnyPoint(iv: LiveInterval, ps: []int): bool {
  let i = 0
  while (i < len(ps)) {
    if (crossesPoint(iv, ps[i])) {
      return true
    }
    i = i + 1
  }
  return false
}

fn crossesAnyCall(iv: LiveInterval, ps: []int): bool {
  for p of ps {
    if (crossesCall(iv, p)) {
      return true
    }
  }
  return false
}

fn rootedAtAnyPoint(iv: LiveInterval, ps: []int): bool {
  let i = 0
  while (i < len(ps)) {
    if (rootedAtPoint(iv, ps[i])) {
      return true
    }
    i = i + 1
  }
  return false
}

// Bounded by len(clobbers) + len(polls) + len(safepoints), all function-local
// and finite — the same bound the stack-map loop already carries.
//
// The two ANDs compose: a value live across BOTH a real call and a poll gets
// `calleeSaved & pollSaved`, which is `calleeSaved` since one contains the
// other. Nothing here needs to know that, and it stays correct if a target ever
// makes them overlap only partially.
fn intervalRegMask(
  iv: LiveInterval, points: AllocPoints, target: TargetRegs,
): int {
  let file = regFileFor(target, iv.regClass)
  let mask = ~pinnedAcross(iv, points.pins)
  if (crossesAnyPoint(iv, points.clobbers) || crossesAnyCall(iv, points.calls)) {
    mask = mask & file.calleeSaved
  }
  if (crossesAnyPoint(iv, points.polls)) {
    mask = mask & file.pollSaved
  }
  if (!iv.isRef || file.calleeSaved == 0) {
    return mask
  }
  if (rootedAtAnyPoint(iv, points.calleeSafepoints)) {
    mask = mask & file.calleeSaved
  }
  if (rootedAtAnyPoint(iv, points.polls)) {
    mask = mask & file.pollSaved
  }
  return mask
}

// #6382: true iff the register list of an `asm` block (`AsmBlock.clobX64` /
// `clobArm64`) names a register whose bit is set in `mask`. The list also
// carries 254, the `memory` sentinel, which no mask reaches: a shift by 254
// would be undefined, so anything past bit 62 is skipped.
fn clobberListHits(clob: []int, mask: int): bool {
  for r of clob {
    if (r >= 0 && r < 63 && ((mask >> r) & 1) == 1) {
      return true
    }
  }
  return false
}

// #6457: does this `asm` block's payload call out? A callee destroys every
// caller-saved register of BOTH classes, and a `clobber` list has no spelling
// for the vector file, so the list cannot be what makes a calling block a clobber
// point. One whose caller-saved GPRs were all pinned as `input`/`result`
// (excluded from the whole function, so they never reach the list) named none in
// the point mask, was no point, and a float live across it sat in an xmm register
// the callee overwrote (x86_64-linux printed 3550.5 for 10.0, exit 0). The
// payload decoders are the ones the checker's E0053 rule (validateasmcall.bit)
// uses, so the two agree on what a call is.
fn asmPayloadCalls(blk: AsmBlock, isArm64: bool): bool {
  if (isArm64) {
    return asmArm64MayCall(blk.arm64Words)
  }
  return asmX64MayCall(blk.x64Bytes)
}

// #6382: every instruction slot holding an `asm` block that destroys, AT THAT
// POINT, a register in `mask` — `AllocPoints.clobbers` material, exactly like
// a call.
//
// A caller-saved register named in a `clobber` list used to leave the
// allocatable file for the WHOLE function (SPEC §11.6). That kept a value out of
// the register but took the register from every other use in the function too,
// and for a block that destroys the entire caller-saved file — a context switch
// resumes into another task's values — it left the allocator nothing. The
// question the block actually asks is the one a call asks: may a value live
// ACROSS this point in a caller-saved register? It is answered with the same
// machinery, `crossesPoint` over `clobbers`, so a value live across the block is
// confined to the callee-saved file and the register stays allocatable
// elsewhere. The point is a full clobber for BOTH files, as a call is: `clobber`
// has no spelling for an FP register, yet a switch leaves d0..d7 / xmm0..xmm5
// holding the resumer's values just as it does x4..x15.
//
// `mask` is the backend's set of registers that matter: each one's caller-saved
// ALLOCATABLE registers (a scratch register is never allocated, so naming it
// must not turn a one-instruction block into a call-like point) plus, on arm64,
// x30 (#3915).
fn asmPointPositions(module: IrModule, f: IrFunc, isArm64: bool, mask: int): []int {
  let out = []int(0)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      let clob = blk.clobX64
      if (isArm64) {
        clob = blk.clobArm64
      }
      // A @naked function holds no compiler-managed value (§10.3.1; E0053 exempts
      // it likewise), and a point there would only push the block's own `input`
      // into a callee-saved register the prologue-less function cannot save.
      if (clobberListHits(clob, mask) || (!f.isNaked && asmPayloadCalls(blk, isArm64))) {
        out = append(out, i)
      }
    }
    i = i + 1
  }
  return out
}
