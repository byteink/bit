// Self-host: a switch case label's implicit `subject == label` (#2428, split
// out as its own sibling file — validatestmt.bit and validateexpr.bit are both
// already near the 800-line limit). The checker never typed a case label
// against its subject at all: `switch (s) { case 1: }` on a `string` passed
// `bit check` clean, and #2407 routes the label test through `lowerCompare`, so
// the mismatch now reaches `rt_call string_eq(subject, label)` and SIGSEGVs on
// the untyped `1` instead of silently taking `default`.

// The type-agreement + comparability half of §14.6 — operand agreement, then
// comparability of the type they agree at — shared between `vCompare`
// (validateexpr.bit, for `==`/`!=`/`<`/`<=`/`>`/`>=`) and `vSwitch` below (a
// case label is always an implicit `==`, never an ordering operator). THE
// SAFETY RULE, exactly as `vCompare` already applied it: an operand mentioning
// a rigid type parameter is skipped (a generic body is checked once against
// its own `T`), and `nil` routes to `vCompareNil`, which already knows both
// the equality and ordering wording.
//
// `spanNode` carries the diagnostic's span — the binary node for `vCompare`,
// the label expression for `vSwitch`, never the whole switch statement.
// `aNode`/`bNode` are the two operand expressions, which `joinOperandTypes`
// needs to range-check an untyped literal operand against the other's
// concrete type (`vAssignableNode`).
//
// Returns the joined type once agreement and comparability both hold, or 0
// otherwise — after already reporting, or after a legitimate skip — so a
// caller must never diagnose a second time on a 0 return.
fn vCompareOperands(
  c: Checker,
  spanNode: int,
  op: int,
  aNode: int,
  bNode: int,
  a: int,
  b: int,
): int {
  if (vHasTypeParam(c, a, 0) || vHasTypeParam(c, b, 0)) {
    return 0
  }
  if (c.ctx.types[a].kind == TypeKind.UntypedNil || c.ctx.types[b].kind == TypeKind.UntypedNil) {
    vCompareNil(c, spanNode, op, a, b)
    return 0
  }
  // Defaulted, so the verdict and the message both read the concrete type the
  // comparison actually runs at: two untyped bool literals meet at `untyped
  // bool`, and "'untyped bool' has no ordering" names a type no one wrote.
  let joined = defaultType(c, joinOperandTypes(c, aNode, bNode, a, b))
  if (joined == 0) {
    reportNoHint(
      c.diags, ecInvalidOperand, vSpan(c, spanNode),
      "operator not defined for '${typeName(c.ctx, a)}' and '${typeName(c.ctx, b)}'",
    )
    return 0
  }
  let tn = typeName(c.ctx, joined)
  if (!vComparable(c, joined, 0)) {
    // A payload-carrying enum is the one non-comparable type with an obvious
    // migration, and §14.6 names it: the transition tables people write with
    // `==` over a state enum all become `match` arms.
    if (c.ctx.types[joined].kind == TypeKind.Enum) {
      report(
        c.diags, ecNotComparable, vSpan(c, spanNode),
        "'${tn}' carries a payload, so it is not comparable",
        "use 'match' to test which variant a payload-carrying enum holds",
      )
      return 0
    }
    reportNoHint(
      c.diags, ecNotComparable, vSpan(c, spanNode),
      "'${tn}' is not comparable",
    )
    return 0
  }
  return joined
}

// A `switch (subject) { case label: }` clause types its label as an implicit
// `subject == label` (SPEC.md's statement grammar note: "the subject type
// must be comparable, and every label must be assignable to it" — the
// untyped-literal half of "assignable" is `joinOperandTypes`'s own
// `vAssignableNode` call, so `let u: u8 = 200; switch (u) { case 200: }` and
// an `int` subject with `case 'a':` both keep adapting exactly as `u == 200`
// and `n == 'a'` already do).
//
// A subject-less switch (`switch { case cond: }`, `subject == 0`) tests each
// label as a `bool` condition instead (same spec line) and is not this rule's
// business.
//
// THE SAFETY RULE once more: a subject or label that did not infer, or that
// still mentions `invalid`, is skipped rather than diagnosed — bit2's gap, not
// the program's.
fn vSwitch(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [subject, case_list]
  let subject = kids[0]
  if (subject == 0) {
    return
  }
  let subjTy = checkExprType(c, subject)
  if (subjTy == 0 || vMentionsInvalid(c, subjTy, 0)) {
    return
  }
  for cs of kidsOf(c.tree, kids[1]) {
    if (getNode(c.tree, cs).tag != Tag.SwitchCase) {
      continue
    }
    for label of kidsOf(c.tree, kidsOf(c.tree, cs)[0]) {
      let labelTy = checkExprType(c, label)
      if (labelTy == 0 || vMentionsInvalid(c, labelTy, 0)) {
        continue
      }
      vCompareOperands(c, label, int(Kind.EqEq), subject, label, subjTy, labelTy)
    }
  }
}
