// Constant REMATERIALIZATION, the half both backends share: which spilled
// values the allocator may evict for free and give no stack slot, and which
// definitions then materialize nothing. Moved out of arm64remat.bit by #5867,
// when x86-64 started asking the same question; the emission side (recompute
// the value at each use) stays in each backend, `rematSpilledConst`
// (arm64remat.bit) and `xGetInt`/`xPlocOf` (x64select.bit).
//
// The three functions here must agree with each backend's emission side. A
// disagreement is not a slow program: the allocator would withhold a slot the
// emitter then addresses, and the `slot >= 0` asserts in `spillOffset`
// (arm64ctx.bit) and `xSpillOffset` (x64frame.bit) turn that into a build
// failure rather than a read of a frame word nothing ever wrote.

// Which backend's encoding sets the bar in `isRematConst`.
enum RematIsa {
  Arm64,
  X64,
}

// #4636/#5867. Whether `vreg`'s whole definition is an integer constant the
// target materializes in ONE instruction.
//
// THE BAR IS ONE INSTRUCTION, and it is not a tuning knob. A reload is one
// load, so a one-instruction materialization is never worse on instruction
// count and strictly better on memory traffic; two would ADD an instruction per
// use to remove a load, a loss in the issue-width-bound loops these backends
// are measured on and a win only in the memory-stall-bound ones.
//
// - arm64: one `movImm64` word. It is wider than it looks: MOVN covers a 51-bit
//   mask (0x7ffffffffffff is `movn xN, #0xfff8, lsl #48`), the exact shape
//   #4281 gives `_m8$fe25519MulCore` a function-long live range.
// - x86-64: every value. `xMovRI` (x64.bit) emits `mov r64, imm32` or
//   `movabs r64, imm64`, one instruction either way, against a reload that is
//   one `mov r64, [rbp + disp8]` (disp32 past 127 bytes, #7201). Neither form
//   touches the flags.
//
// `Op.ConstFloat` is deliberately out: neither backend has an FP immediate
// form, so a float remat is two instructions against a one-instruction load.
// `Op.ConstNil` is out for a different reason: its emitters materialize a
// hardcoded 0 and never read `ins.ival`, so `constIntValue` is not its value.
//
// Reading `f.instrs[vreg]` is the SAME identity the backends' location lookups
// rest on: `buildIntervals` (codegenlive.bit) gives instruction i the interval
// whose vreg is i, so the allocator's `locations` and `f.instrs` index one
// space.
fn isRematConst(f: IrFunc, vreg: int, isa: RematIsa): bool {
  let ins = f.instrs[vreg]
  if (!opIsIntConst(ins.op)) {
    return false
  }
  if (isa == RematIsa.X64) {
    return true
  }
  return movImm64Words(constIntValue(ins)) <= 1
}

// #4666/#5867. Marks every interval the allocator may evict for free, BEFORE it
// runs.
//
// `isRef` and the register class are re-checked rather than assumed: a
// remat interval owns no stack slot, so `allocateCoalesced` refuses one that
// could reach the GC stack maps or the float slot-number shift, and refusing
// here keeps that assert a statement about the allocator's contract instead of
// a way to discover this function was wrong. Neither can fire today —
// `opIsIntConst` types are integers and integers are Int-class non-references —
// so this costs two comparisons on the constants of a function and buys the
// property that a future `opIsIntConst` widening cannot silently publish a
// slot that was never written.
fn markRematIntervals(f: IrFunc, intervals: []LiveInterval, isa: RematIsa) {
  let i = 0
  while (i < len(intervals)) {
    let iv = intervals[i]
    if (iv.regClass == RegClass.Int && !iv.isRef && isRematConst(f, iv.vreg, isa)) {
      intervals[i].remat = true
    }
    i = i + 1
  }
}

// #4666. Widens the backend's skip-const answer (`computeSkipConstMaterialize`,
// `xComputeSkipConstMaterialize`) with the constants the allocator has just
// refused a slot: their definitions materialize nothing either.
//
// The two reasons a constant's definition emits no instruction are different
// and both end here. `skip` means "every use folds this into an immediate, so
// no register is needed"; this adds "no register was available and no slot was
// taken, so every use recomputes it". `arm64WritesResult` reads the union and
// is right for both (x86-64's `xUsedIntRegs` reads it through the same
// function) — neither binds a register.
//
// Indexed by instruction id, the same space `locations` is indexed by (see
// `isRematConst` for that identity), so the two arrays line up element for
// element.
fn addRematSkips(skip: []bool, locations: []RegLoc) {
  assert(len(skip) == len(locations))
  let i = 0
  while (i < len(skip)) {
    if (locations[i].isSpill && locations[i].index < 0) {
      skip[i] = true
    }
    i = i + 1
  }
}

// #6839. Marks every interval whose definition the backend's skip map says is
// folded into each of its uses, BEFORE the allocator runs, so it holds no
// register (`LiveInterval.folded`). `skip` must already have had
// `unskipRootedConsts` applied: a reference a stack map names needs a real
// location. Indexed by instruction id, the space `intervals` shares.
fn markFoldedIntervals(intervals: []LiveInterval, skip: []bool) {
  assert(len(skip) == len(intervals))
  let i = 0
  while (i < len(intervals)) {
    if (skip[i]) {
      intervals[i].folded = true
    }
    i = i + 1
  }
}

// #6839. A folded value gets the remat no-slot location, which every reader
// already handles: nothing materializes it, and a read the skip map missed
// recomputes the constant or fails `spillOffset`'s slot assert, where a
// register would have read whatever last sat there. Int-only because the float
// slot shift would turn -1 into a real slot, and never a root, because a stack
// map cannot name a location that does not exist.
fn placeFolded(locations: []RegLoc, scan: []LiveInterval, safepoints: []int) {
  for iv of scan {
    if (!iv.folded) {
      continue
    }
    assert(iv.regClass == RegClass.Int)
    assert(!iv.isRef || !rootedAtAnyPoint(iv, safepoints))
    locations[iv.vreg] = RegLoc{ isSpill = true, index = -1 }
  }
}
