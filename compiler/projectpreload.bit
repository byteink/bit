// compiler/projectpreload.bit — std/json loaded before every module that needs
// `Json` bound by `__field` (classfieldread.bit, #7110).
//
// A class module's synthesized `__field` names `Json` through the module id of
// std/json (the one the interface requiring `__field` imported), and a module's
// id is greater than every id it depends on: a class module loaded BEFORE
// std/json (`import "./models"` ahead of `import "authz"`) could not bind it.
// So after a load, if the project declares such an interface and any module
// outside the prelude and std/json's own dependencies has a smaller id, the
// project is loaded once more with std/json right after the prelude, which
// makes every other module's id greater. A project with no such interface is
// loaded once, exactly as before.

// The ids std/json depends on, transitively, and std/json's own.
fn jsonClosure(p: Project, jsonMod: int): map<int, bool> {
  let seen = map<int, bool>{}
  let stack = [jsonMod]
  while (len(stack) != 0) {
    let id = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    let (_, done) = seen[id]
    if (done) {
      continue
    }
    seen[id] = true
    for (_, dep) of p.mods[id].imports {
      if (dep >= 0) {
        stack = append(stack, dep)
      }
    }
  }
  return seen
}

// True iff a module below std/json's id is neither the prelude nor one of
// std/json's dependencies.
fn needsJsonPreload(p: Project): bool {
  let demand = collectFieldReadDemand(p)
  if (demand.jsonMod < 0) {
    return false
  }
  let closure = jsonClosure(p, demand.jsonMod)
  let id = 0
  while (id < demand.jsonMod) {
    let (_, inClosure) = closure[id]
    if (!inClosure && id != p.prelude) {
      return true
    }
    id = id + 1
  }
  return false
}

// One load, and a second with std/json first when `needsJsonPreload`. The second
// pass takes a fresh parse cache: the first one's modules carry the old ids.
fn loadProjectCached(
  rootDir: string, rootOnly: string, stdRoot: string,
  cache: LoaderIncremental, lockRoot: string = "",
): Project {
  let p = loadProjectPass(rootDir, rootOnly, stdRoot, cache, lockRoot)
  if (stdRoot == "" || cache.preloadJson || !needsJsonPreload(p)) {
    return p
  }
  let again = LoaderIncremental{
    overlays = cache.overlays, parseCache = map<string, SrcModule>{}, preloadJson = true,
    keepRaw = cache.keepRaw,
  }
  return loadProjectPass(rootDir, rootOnly, stdRoot, again, lockRoot)
}
