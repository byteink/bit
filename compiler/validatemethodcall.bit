// compiler/validatemethodcall.bit — split out of validateiface.bit (#5315,
// pure move, to keep that file at LINT.md's 800-line ceiling). Sibling of
// validateiface.bit/validatecall.bit/namedargs.bit: same module, so this
// needs no imports and no call-site changes.

// Arity (E0050) and each argument's type (E0041) against an already-resolved
// func TYPE `sig` — shared by vMethodCall (a concrete method's signature) and
// vCallValue's tail (validatestmt.bit, a func-typed value/slice/map-element/
// class-field callee, #2786). One implementation for both: the rule is
// identical once the callee's signature is in hand, so the two call sites used
// to carry it twice. Permissive on every shape whose rule is not ported: any
// type carrying an inference gap. A signature still naming a type parameter
// (a method declaring its OWN, `own<U>(u: U, n: i64)`) is judged against this
// call's inferred type arguments substituted in (`vSigParamsAt` below, #6387);
// its arity is judged regardless: a count does not depend on what a type
// parameter binds (#6381).
//
// #4661: this opened `if (ftt.variadic) { return }`, so NO argument of ANY
// variadic method or func-value call was judged — `f.bar("a")` and
// `f.bar(...s)` for `bar(...xs: i64)` both checked and ran rc=0, reading a
// string where an i64 was declared. A variadic signature is now judged exactly
// as `vCallArgTypes` (validatecallargs.bit, #4548/#4655) judges a free call's: the
// parameter index clamps at the rest parameter's own and a spread is judged
// against `[]P`. `ftt.members` carries the rest parameter's element type P
// itself, not `[]P` (`paramTypeIds`, checklookup.bit) — the same convention
// `CallDecl.params` holds for the free path.
//
// #4671: arity and spread POSITION are reported here too, by calling
// `vCallArity` (namedargs.bit) — the free path's own rule, keyed on the
// signature's shape rather than on a `CallDecl`. Before that, a variadic call
// short of its fixed prefix reached IR verification with no diagnostic
// (`f.tag()` for `tag(label: string, ...xs: i64)`) and a misplaced spread
// reached the lowerer's spanless E0092 catch-all instead of E0063 at the
// spread argument.
//
// `fr` (#5315): the method declaration `sig` was interned from, or
// `fr.decl == 0` (no relaxation, `methodMinWant` below) for a caller with
// none — an interface method or `vCallValue`'s func-typed-value tail
// (validatecall.bit). `recvTy` is the receiver type `fr`'s method is reached
// through (`methodRecvType`'s answer), 0 with `fr.decl == 0`; it binds the
// declaration's type parameters to this call's arguments (#6387).
fn vCallAgainstFuncSig(c: Checker, node: int, sig: int, fr: FuncRef, recvTy: int) {
  let ftt = c.ctx.types[sig]
  if (vMentionsInvalid(c, sig, 0)) {
    return
  }
  let params = ftt.members
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let want = len(params)
  // `want > 0` is what makes the rest parameter's index below a real one.
  // `paramsAreVariadic` (checklookup.bit) reads `params[len - 1]`, so an empty
  // list never interns variadic; this keeps that invariant local.
  let variadic = ftt.variadic && want > 0
  let minWant = methodMinWant(fr.owner, fr.decl, variadic, want)
  // E0063 at a spread this signature cannot place, then E0050 for a count it
  // cannot admit, then the verdict deciding whether the type loop below runs —
  // all three are `vCallArity`'s (validatecall.bit), CALLED rather than
  // restated, so a method call cannot drift from a free call on the wording,
  // the span, or on what "placeable" means. It reports at most once per call:
  // an unplaceable spread is E0063 at the argument plus, when the count is
  // wrong too, E0050 at the call, exactly as the free path emits both.
  if (!vCallArity(c, node, args, CallArity{ variadic = variadic, want = want, minWant = minWant })) {
    return
  }
  // E0068 for an own type parameter this call binds nothing to (#6393). The
  // gap is reported once and judging goes on: the unbound parameter is left out
  // of the env (`methodCallEnv`), so no argument is judged against it.
  vMethodOwnGap(c, node, fr, recvTy)
  if (vHasTypeParam(c, sig, 0)) {
    params = vSigParamsAt(c, node, fr, recvTy, params)
  }
  vFuncSigArgTypes(c, params, args, variadic)
}

// The parameter types of a generic method's signature with THIS call's type
// arguments substituted in (#6387) — `own<U>(u: U, n: i64)` called `V.own(1, "x")`
// judges `n` against `i64` and `u` against `U = i64`, where the whole call was
// skipped before and `"x"` was read as the i64 at rc 0. The env is
// `methodCallEnv`'s (below), the one `namedCallEnv` (namedargs.bit) judges a
// named call under, so a positional and a named call cannot disagree.
//
// A parameter this call's arguments leave unsettled — still naming a type
// parameter, or an inference gap — comes back 0, "no expectation" (`vExpectExpr`),
// exactly `vCallArgWant`'s rule for a free generic call: a gap is never judged
// (`vGenericGap`'s safety rule, validategeneric.bit). A signature with no
// declaration behind it (`decl == 0`: an interface method or a func-typed value)
// cannot be bound, so every parameter is 0 there, as it was before.
fn vSigParamsAt(c: Checker, node: int, fr: FuncRef, recvTy: int, params: []int): []int {
  let out = []int(len(params))
  if (fr.decl == 0 || recvTy == 0) {
    return out
  }
  let env = methodCallEnv(c, node, fr, recvTy)
  let i = 0
  while (i < len(params)) {
    let pty = substType(c, params[i], env, 0)
    if (pty != 0 && !vMentionsInvalid(c, pty, 0) && !vHasTypeParam(c, pty, 0)) {
      out[i] = pty
    }
    i = i + 1
  }
  return out
}

// The (type parameter -> concrete argument) env a generic METHOD call is judged
// under: the receiver's type arguments plus the method's own, as
// `recordMethodInstantiation` (checkproject.bit) records them. A parameter
// nothing bound is LEFT OUT rather than mapped to void — `methodTypeSubst`'s
// rule — so a parameter naming it stays an open type parameter and is skipped,
// instead of being judged against `()`, a type nobody wrote.
fn methodCallEnv(c: Checker, node: int, fr: FuncRef, recvTy: int): TypeEnv {
  let all = genericEnvOf(fr.owner, fr.decl, methodTypeArgsRaw(c, fr, recvTy, node))
  let env = emptyTypeEnv()
  let i = 0
  while (i < len(all.params)) {
    if (all.args[i] != 0) {
      env.params = append(env.params, all.params[i])
      env.args = append(env.args, all.args[i])
    }
    i = i + 1
  }
  return env
}

// ---- E0046 a foreign class's unexported method (17.3) ----------------------
//
// SPEC 17.3: "A method is exported by placing `export` before its `fn`
// keyword... an exported type may still have unexported methods." `vMember`'s
// `vForeignFieldAccess` (validatemember.bit, #4631) already asks this
// question for a FIELD; `vMethodCall` below resolved a call by signature
// alone and never asked it for a METHOD, so `t.bump()` on an unexported
// `bump` compiled, linked and ran across a module boundary (#5738).
//
// Judged by PRESENCE, mirroring `vForeignUnexportedField`: this runs only
// once `vMethodCall` has already resolved `mname` to a real entry in
// `methodSigs`, so an unknown name is never judged here — that stays E0057.
fn vForeignUnexportedMethod(c: Checker, rt: int, mname: string): bool {
  let rid = methodRecvType(c, rt)
  if (c.ctx.types[rid].kind != TypeKind.Struct) {
    return false
  }
  let dm = c.ctx.types[rid].declModule
  if (dm < 0 || dm == c.moduleId) {
    return false
  }
  return !methodExportedLookup(c, "${rid}.${mname}")
}

// Reports the rule above at `nameNode`, byte for byte the code, message and
// hint `vForeignFieldAccess` uses: an unexported method and an unexported
// field are the same fault, a name the source module did not publish.
fn vForeignMethodCall(c: Checker, rt: int, mname: string, nameNode: int) {
  if (!vForeignUnexportedMethod(c, rt, mname)) {
    return
  }
  report(
    c.diags, ecUnexportedName, vSpan(c, nameNode),
    "'${mname}' is not exported by this module",
    "add 'export' to its declaration in the source module, or check the spelling",
  )
}

// A static method called through its TYPE (`K.f(1, "x")`, `Pair<i64, string>.make(1, "x")`,
// `Pair.make(1, "x")`, or `T.label()` through a bound's constraint interface,
// SPEC §10.4.1). A type name has no value type, so `vMethodCall` used to return
// before any signature was judged: `K.f("x", 1)` and `K.f(1)` checked clean and
// the program crashed at run time (#6381). The receiver is `staticCallReceiver`'s
// (staticcall.bit), the one the checker and the lowerer ask too, so the signature
// judged is the one the call lowers against; `vCallAgainstFuncSig` then judges
// arity (E0050), spread placement (E0063) and each argument (E0041) as it does
// for an instance method. A bare generic name whose arguments bind no class
// parameter stays the template, whose signature carries type parameters and is
// skipped there; `vStaticCallGap` answers E0068 for it instead. Named arguments
// never reach here (`vStaticNamedArgs`, namedargs.bit).
fn vStaticCall(c: Checker, node: int, mk: []int) {
  vStaticCallGap(c, node, mk[0])
  let sst = staticCallReceiver(c, node, mk[0])
  if (sst == 0) {
    return
  }
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  let key = "${sst}.${mname}"
  let sig = methodSigLookup(c, key)
  if (!staticMethodLookup(c, key) || sig == 0) {
    return
  }
  vForeignMethodCall(c, sst, mname, mk[1])
  let fr = methodRefAt(c, sst, mname)
  vCallAgainstFuncSig(c, node, sig, fr, sst)
}

// A method call `recv.method(args)` (#2755), OR a call through a func-typed
// STRUCT FIELD (#2786, SPEC §9.4) — `mk[0]` is the receiver expression,
// `mk[1]` the member-name leaf. Called from vCallValue (validatestmt.bit) for
// every Member callee.
//
// The method path works identically for a concrete class receiver and an
// interface-typed one: `buildSignatures` (checkbindfunc.bit) records BOTH a
// class method's and an interface method's signature in the SAME
// `methodSigs` table, keyed "<recvTypeId>.<name>" — one lookup separates a
// real method from a func-typed field of the same name (a field has no such
// entry), so the two ARE separable, contrary to a comment this once carried.
//
// When that lookup misses, the member is a func-typed field IF the receiver
// is a class and `structFieldLookup` — the same table `checkMember`'s own
// class-field branch (checkbindexpr.bit) reads — resolves the field to a Func
// type; anything else (a plain non-func field, or a receiver that is not a
// class at all) is left unvalidated, same as before #2786.
//
// A NAMESPACED call (`ns.fn(...)`, also a Member) never reaches either
// lookup: a namespace alias is bound only under "ns.name" keys
// (bindNamespaceImport, checkproject.bit), never as a value in its own right,
// so `checkExprType(c, mk[0])` on the bare alias already returns 0 above and
// this function returns before either lookup runs. That is the existing
// guard the method path already relied on, not a new one.
//
// `methodRefAt` (checklookup.bit, #5315) resolves the same declaration
// `lowerArgsForMethod` (lowercall.bit) reads to fill an omitted trailing
// default, so the two can never disagree on which method relaxes arity.
fn vMethodCall(c: Checker, node: int, mk: []int) {
  let recvType = checkExprType(c, mk[0])
  if (recvType == 0) {
    vStaticCall(c, node, mk) // a type name: `Pair.blank(1)`, `K.f("x", 1)`
    return
  } // bit2 could not type the receiver
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  // #6269: `Repo<T>.find/update/delete` on a `T` with no single primary
  // key is a compile error naming `T`, never `pkg/orm/repo.bit`'s own
  // runtime panic — `checkOrmRepoSingleKey` (checkormrepokey.bit).
  checkOrmRepoSingleKey(c, mk[1], recvType, mname)
  let mrType = methodRecvType(c, recvType)
  let recvKey = "${mrType}.${mname}"
  let sig = methodSigLookup(c, recvKey)
  if (sig == 0) {
    if (c.ctx.types[recvType].kind != TypeKind.Struct) {
      return
    } // not a class: no field to fall back to
    sig = structFieldLookup(c, recvKey)
    if (sig == 0 || c.ctx.types[sig].kind != TypeKind.Func) {
      return
    } // absent or non-callable field
    vCallAgainstFuncSig(c, node, sig, FuncRef{ owner = c, decl = 0, declName = "" }, 0)
    return
  }
  vForeignMethodCall(c, mrType, mname, mk[1])
  let fr = methodRefAt(c, mrType, mname)
  vMethodTypeArgCount(c, node, mrType, fr, mname)
  vCallAgainstFuncSig(c, node, sig, fr, mrType)
}
