// #5820: self-checks for `foldTargetTests` (opttarget.bit) and the
// `targetIsX64` predicate it folds from (build.bit).
//
// An arm here rather than a fixture for the reason `checkMemWordAtPrim`
// (lowercheck.bit) states for its own pin: a program declaring
// `bit_rt_port_syscalls_on_x64` collides with the runtime's definition at
// link, and `runtime/**` is compiled by the pinned stage0, so no golden case
// reaches this fold.

// A pinned `onX64` with the runtime's own body, and `pick`, whose two arms
// are told apart by their opcode: `mul` on x86-64, `add` on aarch64. With
// `pinned` false the same name is an ordinary ROOT function answering
// `true`, the forgery `onX64CallIsPinned` refuses to fold.
fn targetTestSource(pinned: bool): string {
  let head = "export @nosplit @symbol(\"bit_rt_port_syscalls_on_x64\") fn onX64(): bool {\n" +
    "  let t = asm {\n" +
    "    arm64 { 0xD2800020 }\n" +
    "    x64 { 0xB8, 0x00, 0x00, 0x00, 0x00 }\n" +
    "    result arm64 x0 x64 rax : int\n" +
    "  }\n" +
    "  return t == 0\n" +
    "}\n"
  if (!pinned) {
    head = "fn bit_rt_port_syscalls_on_x64(): bool {\n  return true\n}\n" +
      "fn onX64(): bool {\n  return bit_rt_port_syscalls_on_x64()\n}\n"
  }
  return head +
    "fn pick(n: int): int {\n" +
    "  if (onX64()) {\n" +
    "    return n * 3\n" +
    "  }\n" +
    "  return n + 7\n" +
    "}\n" +
    "fn main() {\n" +
    "  println(string(pick(5)))\n" +
    "}\n"
}

// Bit set per opcode family in `f`: 1 call, 2 asm, 4 mul, 8 add.
fn pickShape(f: IrFunc): int {
  let s = 0
  for ins of f.instrs {
    if (ins.op == Op.Call) {
      s = s | 1
    } else if (ins.op == Op.Asm) {
      s = s | 2
    } else if (ins.op == Op.Mul) {
      s = s | 4
    } else if (ins.op == Op.Add) {
      s = s | 8
    }
  }
  return s
}

// `pick`'s shape after the full pipeline, for `target` (-1: no target set).
fn pickShapeFor(pinned: bool, target: int): int {
  let m = lowerSourceModule(targetTestSource(pinned))
  if (target >= 0) {
    setTargetArch(m, buildTargetOf(target))
  }
  optimizeModule(m, false)
  let i = irFuncNamed(m, "pick")
  assert(i >= 0)
  return pickShape(m.funcs[i])
}

fn checkFoldTargetTests() {
  // x86_64-linux and x86_64-windows keep `mul` alone; both aarch64 targets
  // keep `add` alone. No call, no `asm`, no untaken arm.
  assert(pickShapeFor(true, 0) == 4)
  assert(pickShapeFor(true, 3) == 4)
  assert(pickShapeFor(true, 1) == 8)
  assert(pickShapeFor(true, 2) == 8)
  // No target recorded: nothing folds, the inlined `asm` and both arms stay.
  assert(pickShapeFor(true, -1) == (2 | 4 | 8))
  // The forgery answers `true` whatever the target; folding it for aarch64
  // would have kept `add`.
  assert(pickShapeFor(false, 2) == 4)
}

// `targetIsX64` agrees with the object writer each target reaches, which is
// what picks the `asm` arm the fold stands in for (build.bit's
// `buildObjCmd`: Mach-O is arm64, PE is x86-64, ELF by `elfTargetOf`).
fn checkTargetIsX64Policy() {
  let i = 0
  while (i < 4) {
    let t = buildTargetOf(i)
    let writerX64 = isWindowsTarget(t) || (!isMachoTarget(t) && elfTargetOf(t) == ElfTarget.X86_64)
    assert(targetIsX64(t) == writerX64)
    i = i + 1
  }
  assert(targetIsX64(buildTargetOf(parseBuildTarget("x86_64-linux"))))
  assert(!targetIsX64(buildTargetOf(parseBuildTarget("aarch64-macos"))))
}
