// compiler/namedcallargs.bit — the call-site side of named arguments on a
// generic callee (SPEC §12.11, #6343): which declared parameter each written
// argument fills, for the readers that infer a call's type arguments from its
// arguments BY PARAMETER INDEX (`checkArgType`, `callArgNode`, `vArgKnownType`)
// and for the arrow-seeding pre-pass (`seedArrowArgs`, checkarrow.bit).
// Sibling of namedargs.bit: same module, no imports. A name binds to the
// signature the call site statically sees, so inference reads a named call
// exactly as it reads the positional call it reorders into.

// The (owner, params) a call's named arguments bind against, resolved from the
// call node alone — for the inference readers (`callArgAt`, checkgeneric.bit),
// which run before, and independently of, the validator's own dispatch in
// `vMemberNamedArgs`. Same primitives, same answer: a free function through
// `funcRefAt`, a namespaced one through its qualified name, a static method
// through `staticReceiverType`, otherwise an instance method through the
// receiver's static type. `ok` is false for every callee with no declared
// parameter list.
fn callParamNodes(c: Checker, callNode: int): MethodParams {
  let none = MethodParams{ owner = c, params = []int(0), ok = false, decl = 0 }
  let callee = kidsOf(c.tree, callNode)[0]
  let cn = getNode(c.tree, callee)
  if (cn.tag == Tag.Ident) {
    return funcParamNodes(c, callee, c.source[cn.span.start:cn.span.end])
  }
  if (cn.tag != Tag.Member) {
    return none
  }
  if (vNsCalleeIsFuncDecl(c, callee)) {
    return funcParamNodes(c, callee, nsQualifiedName(c, callee))
  }
  let mk = kidsOf(c.tree, callee)
  let mn = getNode(c.tree, mk[1])
  let mname = c.source[mn.span.start:mn.span.end]
  let sst = staticReceiverType(c, mk[0])
  if (sst != 0 && staticMethodLookup(c, "${sst}.${mname}")) {
    return methodParamNodes(c, sst, mname)
  }
  return methodParamNodes(c, checkExprType(c, mk[0]), mname)
}

// A free function's parameter list, resolved node-keyed through `funcRefAt`.
fn funcParamNodes(c: Checker, callee: int, name: string): MethodParams {
  let fr = funcRefAt(c, callee, name)
  if (fr.decl == 0) {
    return MethodParams{ owner = c, params = []int(0), ok = false, decl = 0 }
  }
  let params = kidsOf(fr.owner.tree, declParamShapeNode(fr.owner, fr.decl))
  return MethodParams{ owner = fr.owner, params = params, ok = true, decl = fr.decl }
}

// The argument-list entry (`Tag.Arg`, `Tag.ArgSpread` or `Tag.NamedArg`) that
// fills declared parameter `i` of call `callNode`, or 0 when the call supplies
// none for it (an omitted default, or a name that binds nothing). A positional
// prefix fills by position; a named suffix fills by the parameter's declared
// name (`callParamNodes` above). The whole of "reorder into positional form"
// for every reader that walks a callee's parameters by index.
fn callArgAt(c: Checker, callNode: int, i: int): int {
  let args = kidsOf(c.tree, kidsOf(c.tree, callNode)[2])
  let ns = namedArgStart(c.tree, args)
  if (i < ns) {
    return args[i]
  }
  if (ns == len(args)) {
    return 0
  }
  let mp = callParamNodes(c, callNode)
  if (!mp.ok || i >= len(mp.params)) {
    return 0
  }
  let want = paramNameOf(mp.owner.tree, mp.owner.source, mp.params[i])
  let j = ns
  while (j < len(args)) {
    let nm = getNode(c.tree, kidsOf(c.tree, args[j])[0])
    if (c.source[nm.span.start:nm.span.end] == want) {
      return args[j]
    }
    j = j + 1
  }
  return 0
}

// Records, once, the interface `ty` a named call's names bound against (see
// `Checker.namedRecv`). Only an interface is worth recording: a concrete
// receiver is the lowerer's own receiver type already. Write-once, so a later
// re-validation of the same node under a substituted body cannot replace the
// binding the generic template was checked with.
fn noteNamedRecv(c: Checker, node: int, ty: int) {
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.Interface) {
    return
  }
  let (_, seen) = c.namedRecv[node]
  if (!seen) {
    c.namedRecv[node] = ty
  }
}

// The receiver type a named method call's names resolve against at lowering:
// the recorded constraint interface when the checker bound them against one,
// else `recvTy` (the concrete receiver).
fn namedRecvTy(fc: FnCtx, node: int, recvTy: int): int {
  let (ty, ok) = fc.c.namedRecv[node]
  if (ok) {
    return ty
  }
  return recvTy
}

// Whether the argument list cannot be paired with `params` for the
// arrow-seeding pre-pass (`seedArrowExpectedGeneric`, checkgeneric.bit), which
// reads the argument filling each declared parameter through `callArgAt`. A
// positional list pairs by index and so needs exactly one argument per
// parameter (a length mismatch is a variadic, a spread or an arity error:
// which parameter is undecided). A list with a named suffix pairs by NAME, so
// an omitted defaulted parameter is simply an empty slot; only more arguments
// than parameters (an arity error, which the validator reports) is undecided.
fn arrowSeedUndecided(c: Checker, params: []int, args: []int): bool {
  if (namedArgStart(c.tree, args) < len(args)) {
    return len(args) > len(params)
  }
  return len(params) != len(args)
}
