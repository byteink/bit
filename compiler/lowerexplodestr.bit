// compiler/lowerexplodestr.bit — the box/unbox coercion boundary for `string`
// (#4431, wired into every container position by #4437, turned on for real by
// #4422). Split out of lowerexplode.bit under #4422's widening, which took that
// file past the 800-line E0200 limit; a sibling in the same module, so nothing
// here needs an import and no call site changes.
//
// The seam is the one lowerexplode.bit's own banner already drew: everything
// left behind there answers "how many words does the ABI pass this type in",
// everything here answers "how do I turn a `string` handle into its three
// words and back". Two mechanisms sharing a file was the only thing joining
// them.

// ===========================================================================
// #4431: the box/unbox coercion boundary — a SEPARATE mechanism from the
// tuple explosion in lowerexplode.bit, deliberately not folded into
// `explodedWordTypes`.
//
// THE COERCION is separate from the WIDTH RULE, and #4423 moved the line
// between them. This banner used to say `explodedWordTypes` must never
// recognize `string` at all; that was right while the ABI still passed one
// handle, and it is no longer what the code does, so here is the actual
// reasoning rather than the superseded version of it.
//
// The hazard the old text named is real: `explodedWordTypes` admits a type by
// its SHAPE (>= 2 members, each one word), and a consumer that materializes a
// box for an ineligible use falls back to `buildTuple` — a GENERIC tuple
// layout. A boxed `string` is not a generic tuple: `runtime/ABI.md` §2.3 fixes
// its allocation at exactly `strViewHeaderSize()` (24) bytes with
// `ptr_offsets = [strViewBaseOffset()]` (16), which is what
// `emitInlineStringSlice` (lowerreslice.bit) builds and what
// `stringViewBaseEscapesInFunc` (verify.bit, #4407) polices.
//
// So the width rule was widened only after every `buildTuple` fallback that a
// `string` can now reach was routed through `materializeExplodedLocal`, which
// picks the constructor by type. Enumerated on `64b8a7c7` rather than assumed —
// `git grep -n 'buildTuple\|buildTupleIn' -- compiler` is 8 call sites:
// `declareExplodedParam` (fixed by #4423, was the only one), `localRead`
// (already routed by #4422), `lowerclosure.bit:37` and `lowerfail.bit:83`
// (one-word cells via `boxTypeFor`, not this mechanism), `lowerexpr.bit:653`
// and `lowerfunc.bit:113` (tuple literals and `return a, b`, whose type is a
// tuple by construction), and the RETURN side in `lowerglobal.bit`/
// `lowerprim.bit` — the last pair being what #4424 routed through
// `materializeExplodedIn`, since a call to a `string`-returning function now
// hands back three words the caller may have to put back in a box.
//
// What stays here is what a shape rule cannot express: HOW a `string` box is
// taken apart and put back together. The width rule answers "how many words";
// this file answers "which bytes".
//
// GATED BY `Lowerer.explodeStrings`, which every real build leaves `false`
// (see `lower.bit`). Nothing below can execute outside
// `BIT_STRING_EXPLODE_TEST=1`, and every insertion point (`explodeCallArgs`,
// `emitReturnValue`, `boxErrForSlot`/`unboxErrFromSlot`, and #4422's
// `localWordTypes`) checks the gate before calling any of it — so an unset
// variable leaves every one of those functions emitting the exact IR they
// emit today, instruction for instruction.
// ===========================================================================

// The three word types a boxed `string` explodes into: `ptr`/`len` at +0/+8
// (untraced `i64`, ABI.md §2.3), `base` at +16 typed `string` itself — the
// same IR type `emitInlineStringSlice`'s own `field_set` gives that offset,
// so `isRefType` classifies a word read out of `base` exactly as it
// classifies the boxed string it came from.
fn stringWordTypes(ctx: TypeContext): []int {
  let i64ty = primType(ctx, 3)
  return [i64ty, i64ty, primType(ctx, 11)]
}

// unbox-on-use: reads a boxed `string` value's three words back out, offsets
// 0/8/16 exactly as `emitInlineStringSlice` reads its own receiver, and
// records the keepalive edges pairing `ptr`/`len` (untraced) with `base`
// (traced) — #4406's mechanism, and this is one more site that owes the call
// per its own closing note ("the mechanism is in place; it is not
// automatic"). Without it, a caller that reads only `ptr`/`len` back out and
// never touches `base` again leaves `base`'s live interval ending here, and a
// collection between this point and that later read frees the backing the
// interior `ptr` still points into — #4406's hazard, reproduced for this
// exact word shape rather than a synthetic tuple.
fn unboxStringWords(ctx: TypeContext, b: IrBuilder, val: int): []int {
  return explodeValueWords(ctx, b, val, stringWordTypes(ctx))
}

// box-on-escape: materializes a boxed `string` from three independent words —
// the identical allocation shape `emitInlineStringSlice` builds (`gc_alloc`
// `strViewHeaderSize()` bytes, `ptr_offsets = [strViewBaseOffset()]`, result
// typed `string`), so `stringViewBaseEscapesInFunc` (verify.bit, #4407)
// already refuses to emit this if `base` is ever fed a non-ref-typed value —
// the checker built for `emitInlineStringSlice`'s fingerprint covers this
// site for free because the fingerprint is identical, not because anything
// here re-derives the invariant.
//
// `base`'s own live interval needs no keepalive registration here: it is
// consumed by the `field_set` immediately below the `gc_alloc`, so ordinary
// liveness already covers it across that one safepoint. The hazard this
// function could introduce is a STALE `ptr`/`len` pair copied from an object
// that dies before `base` reaches its `field_set` — which cannot happen
// precisely because `base` (this function's own `base` argument) has a
// live use right here and needs nothing extra to stay rooted across the
// allocation that precedes it.
fn boxStringWords(ctx: TypeContext, b: IrBuilder, ptrv: int, lenv: int, basev: int): int {
  let strTy = primType(ctx, 11)
  let i64ty = primType(ctx, 3)
  let ga = mkInstr(Op.GcAlloc, strTy)
  ga.ival = strViewHeaderSize()
  ga.offsets = [strViewBaseOffset()]
  let obj = builderEmit(b, ga)
  let setPtr = mkInstr(Op.FieldSet, ctx.voidId)
  setPtr.lhs = obj
  setPtr.ival = 0
  setPtr.rhs = ptrv
  setPtr.ival2 = i64ty
  builderEmit(b, setPtr)
  let setLen = mkInstr(Op.FieldSet, ctx.voidId)
  setLen.lhs = obj
  setLen.ival = 8
  setLen.rhs = lenv
  setLen.ival2 = i64ty
  builderEmit(b, setLen)
  let setBase = mkInstr(Op.FieldSet, ctx.voidId)
  setBase.lhs = obj
  setBase.ival = strViewBaseOffset()
  setBase.rhs = basev
  setBase.ival2 = strTy
  builderEmit(b, setBase)
  return obj
}

// ===========================================================================
// #4426: THE CONTAINER BOUNDARY NEEDS NO COERCION IN EITHER DIRECTION, and
// this is where the box/unbox pair that used to sit at 28 call sites was.
//
// #4005 ruled that a `string` inside a container element or a composite field
// stays BOXED forever, because ABI.md:283-290 requires a buffer whose element
// type has any reference field to stay word-per-element and an unboxed string
// is one ref field mixed with two scalars. That ruling stands. What does not
// stand is the mechanism #4431 built to implement it: a compiler-inserted
// `unbox(val)` immediately followed by `box(words)` at every store into and
// load out of a container, a class field, a channel, the `err` slot and every
// unflipped ABI position.
//
// THE VALUE AT EVERY ONE OF THOSE POSITIONS IS ALREADY THE BOX. `lowerExpr`
// returns ONE SSA value id, so a `string` expression can only ever BE a
// handle: the exploded words live in exactly three list-shaped places —
// `LocalBind.hiValues`, a call's argument list and a `ret`'s value list — and
// each of those rebuilds the box before it can yield a single value
// (`localRead` -> `materializeExplodedLocal` in lowerclosure.bit,
// `emitResolvedCall` in lowerprim.bit, `declareExplodedParam` in
// lowerexplode.bit). So the round trip reconstructed, bit for bit, the object
// it had just taken apart.
//
// IT WAS NOT FREE. The three `field_get`s read a heap object nothing in the
// block stored, which store-to-load forwarding cannot answer, so
// dead-allocation elimination could not cancel the `gc_alloc` — one surviving
// object per gated crossing, measured by #4446 and pinned by #4508's flip
// table. `bench/cases/strmap` performs 12,450,000 string-keyed map operations
// and paid 12,450,003 objects on top of its 400,041; `bench/cases/json`'s
// lexer reads `p.source` out of a class field once per source byte.
//
// AND IT WAS WRONG WHERE IT ACTUALLY FIRED. Instrumented over 716
// `_tests_/cases/*.bit` builds with the gate on, the rebuild arm ran ONCE, on
// `run_variadic.bit`: `explodeCallArgs` asked `paramTypes[i]` for a variadic
// tail, got the tail's ELEMENT type `string` while the argument was the
// collected `[]string`, and rebuilt the slice header's first three words as a
// 24-byte string box. `cap` and `is_ref` were dropped and the scalar `off`
// landed in the slot `ptr_offsets = [16]` declares traced. It printed the
// right answer at exit 0 only because that `off` is 0 and `for p of parts`
// reads only `buf` and `len` — the #4412 shape exactly.
//
// So there is no coercion left to place, and the two directions collapse into
// one statement: a container slot and a `string` SSA value hold the same
// thing, one handle to ABI.md §2.3's 24-byte header. The eleven runtime entry
// points #4005 enumerated (`bit_rt_slice_append`/`_get`/`_set`,
// `bit_rt_map_set`/`_get`/`_has`/`_slot`/`_delete`/`_key_at`/`_val_at`, and
// `bit_rt_slice_slice`, which touches no element word at all) take that
// handle exactly as the lowerer already has it, and so do `chan_send`/
// `chan_recv` and a `field_set`/`field_get` at a string-typed field.
//
// WHAT STILL LIVES IN THIS FILE. `boxStringWords`/`unboxStringWords` are the
// two halves of the box's LAYOUT and both have real consumers:
// `materializeExplodedIn` below and `emitInlineStringSlice`
// (lowerreslice.bit) build boxes; `string_eq`'s word lowering (lowercond.bit,
// #4443) and `checkStringUnboxKeepAlive` (arm64selcheckgen.bit) take them
// apart. What is gone is the pair COMPOSED back to back at a position that
// never had words to begin with.
// ===========================================================================

// ===========================================================================
// #4422: the PRODUCER side — a `string` LOCAL is its three words rather than a
// handle to a box, which is what makes `s[lo:hi]`'s allocation removable.
// ===========================================================================

// The words a LOCAL of type `ty` is bound to, or fewer than two for the
// one-handle form every other local keeps.
//
// This USED TO BE a second, wider predicate sitting beside `explodedWordTypes`,
// because #4422 landed the local half while the ABI still passed a `string` as
// one handle. #4423 flipped the ARGUMENT half, so the two answers coincide for
// every position this compiler currently explodes and the second predicate is
// gone: there is one width rule, `explodedWordTypes`, and each caller states
// which direction it is asking about by what it passes for `explodeStr`.
// #4424 closed the last asymmetry: `explodedRetWords` reads the same
// `Lowerer.explodeStrings` this does, so a LOCAL, an ARGUMENT and a RETURN of
// type `string` are all three words under the gate and all one handle without
// it — one rule with one owner, rather than three that can drift the way
// #4412's two did.
//
// WHY A LOCAL IS WHERE THE ALLOCATION DIES. `emitInlineStringSlice` builds its
// box and the binding reads the three words straight back out, in the same
// block, where store-to-load forwarding (optstore.bit) answers each read from
// the stored value and dead-allocation elimination (optalloc.bit) then finds
// the `gc_alloc` named by nothing but its own `field_set`s. That pair cannot
// run while the handle is LOOP-CARRIED: a local in scope at a join is threaded
// through it as a block parameter, and a block argument is an escape optalloc
// refuses outright. Measured on `let a = s[w:w+8]` inside an `if`: the box
// survived as `bb7(..., %21)` with the parameter never read.
//
// Correctness never rests on that pair. Under `--no-optimize` the box is real
// and the three reads are genuine loads out of it.
fn localWordTypes(fc: FnCtx, ty: int): []int {
  return explodedWordTypes(fc.c.ctx, ty, fc.lowerer.explodeStrings)
}

// Rebuilds the aggregate an exploded local stands for, at a use that genuinely
// wants the whole thing. A `string`'s box is NOT a generic tuple — ABI.md §2.3
// fixes it at 24 bytes with `ptr_offsets = [16]`, which `buildTuple` cannot
// produce for a `string`-typed value because `string` is a prim whose layout is
// one pointer — so the two constructors are named here, once, rather than each
// caller asking which shape it holds.
fn materializeExplodedLocal(fc: FnCtx, ty: int, vals: []int): int {
  return materializeExplodedIn(fc, fc.b, ty, vals)
}

// The same choice against an explicit builder, for the two RETURN-side rebuilds
// that do not write into `fc.b`: `emitTrampolineRet` (lowerglobal.bit) builds
// the fn-value trampoline's body in a fresh builder, and `emitResolvedCall`
// (lowerprim.bit) rebuilds a call result. `buildTuple`/`buildTupleIn` are
// already split for exactly this reason and this mirrors them, so "which
// constructor does this type need" keeps ONE answer — a second copy of that
// test at the trampoline is how the two would drift.
fn materializeExplodedIn(fc: FnCtx, b: IrBuilder, ty: int, vals: []int): int {
  if (ty == primType(fc.c.ctx, 11)) {
    return boxStringWords(fc.c.ctx, b, vals[0], vals[1], vals[2])
  }
  return buildTupleIn(fc, b, ty, vals)
}

// #4586: a `string` LET-binding explodes only when its initializer just
// ALLOCATED the box, because killing that box is the only thing the explosion
// can buy.
//
// #4422's own rationale, quoted from `localWordTypes` above, is
// `emitInlineStringSlice` "builds its box and the binding reads the three
// words straight back out, in the same block, where store-to-load forwarding
// answers each read and dead-allocation elimination then finds the `gc_alloc`
// named by nothing". That argument is about ONE shape — a box the lowerer has
// just emitted — and it was applied to EVERY `string` local. For a binding
// whose initializer is a handle that already exists (a `const_string`, a class
// field, a slice or map element, a one-handle call result, a runtime call's
// result), there is no allocation to cancel: the explosion reads three words
// out of a live object and every later use at a one-word position has to
// build a SECOND object with identical contents.
//
// Measured on `bench/cases/json` at `48dd5501`, flip on, `BIT_GC_STATS=1`
// swept+live: 150,000 of those second objects in the record builder (an
// interpolation operand reaching `rt_call string_concat5`) and 600,000 in
// `parseObject` (`JsonEntry{ key: key }`, a class-field store). The second
// 600,000 are RETAINED — one header per object key where the boxed form shares
// the four `internKey` interned it (`stdlib/json/parse.bit`, #4358) — so the
// flip was turning a shared string into a per-use copy.
//
// A STRUCTURAL TEST ON THE ALREADY-LOWERED VALUE, exactly as `isConstTrue`
// (lower.bit) is, and for the same reason: it can only under-report. An
// under-report keeps today's behaviour (the local explodes, `localRead`
// rebuilds); it can never claim a box exists that does not.
//
// The two producers this admits are the two that allocate: `emitInlineStringSlice`
// (lowerreslice.bit) for `s[lo:hi]`, and `materializeExplodedIn` above for a
// call whose result arrived in three registers (#4424) — which is why
// `_tests_/bit/stringexplode`'s `retscan` probe still measures the return flip
// removing an allocation rather than adding one.
//
// SCOPED TO `string` BY CONSTRUCTION. A tuple binding (#4404/#4410) is live
// with the gate OFF, so widening this to every aggregate would change every
// real build; `ty != string` returns `true` and leaves that rule exactly as it
// is. With the gate off `localWordTypes` never gives a `string` two words, so
// this predicate is unreachable there.
fn stringLetExplodes(fc: FnCtx, ty: int, value: int): bool {
  if (ty != primType(fc.c.ctx, 11)) {
    return true
  }
  return isFreshBox(fc.b, value)
}

// Whether `v` is the result of a `gc_alloc` this function emitted — i.e. an
// object no other value denotes yet. The same fact `optstore.bit`'s
// `storeBaseIsFresh` uses, asked of the builder instead of a finished
// `IrFunc`, and bounds-guarded the way `isConstTrue` is because a value id is
// an index into `b.instrs`.
fn isFreshBox(b: IrBuilder, v: int): bool {
  if (v < 0 || v >= len(b.instrs)) {
    return false
  }
  return b.instrs[v].op == Op.GcAlloc
}

// ===========================================================================
// #4628: A CALL RESULT'S WORD 2 IS THE ORIGINATING HANDLE, AND THE REBUILD
// REUSES IT WHEN ITS OWN `ptr`/`len` MATCH.
//
// THE SOUNDNESS ARGUMENT, and it rests on one language property. A `string` is
// IMMUTABLE (SPEC §5.3): no operation writes through a handle, so the bytes a
// handle denotes are fixed for its lifetime. A handle `h` whose OWN `ptr` and
// `len` equal the words `{w0, w1}` therefore denotes exactly the bytes
// `{w0, w1}` denote — the same address, the same length, and no writer that
// could make the two disagree later. The aggregate the caller was about to
// build would have held `{w0, w1, w2}`; `h` IS `{w0, w1, h.base}`. Only `base`
// can differ, and `base` is not part of the value: it exists solely to keep
// the backing allocation alive (`strInitView`, runtime/root/root.bit), and
// `h`'s own `base` roots `h.ptr` by construction because `h` is a live view of
// it. So the reuse is correct WHATEVER word 2's provenance was, which is why
// the test is dynamic rather than a claim about where word 2 came from.
//
// This is why the test cannot be dropped, measured rather than argued: #4619
// built the guardless form and it MISCOMPILED. `let a = src[2:6]; b.f = a` has
// word 2 the OWNER BASE, not a handle denoting those four bytes, and reusing
// it printed `abcdefghij 30` where the answer is `cdef 12`; `bench/cases/json`
// produced md5 `cc08f932` against the correct `58d3db22`, and
// `bench/cases/strings` did not terminate. The `ptr`/`len` test is what
// separates the two cases, and it separates them by VALUE rather than by
// provenance.
//
// THE NULL ARM IS SEPARATE AND DELIBERATE. `field_get` on a header base reads
// a null base as 0 (`emitHeaderWordOrZero`, arm64selectmem.bit), so without
// the `!= nil` test a null word 2 would compare equal to a `{0, 0}` pair and
// the reuse would hand back a null handle where a real header is expected.
// Guarding it costs one `cbz` and makes the emitted IR independent of whether
// a backend null-guards that load at all.
// ===========================================================================

// The values a `return` hands back for a result of type `ty` occupying
// `words`, given the whole aggregate `v`.
//
// For a `string` this is `{v.ptr, v.len, v}` — word 2 is the RETURNED HANDLE
// itself rather than `field_get v[16]`. `v` is a legal `base`: `strInitView`
// (runtime/root/root.bit) stores the IMMEDIATE SOURCE and never `base(src)`,
// and `emitInlineStringSlice` (lowerreslice.bit) already stores the receiver
// HANDLE when the receiver is one (`strRecvBase`). So this makes the exploded
// path's word 2 agree with what the handle path already stores rather than
// introducing a second convention — and rooting is unchanged in kind and in
// count, still exactly one traced word: `v` roots itself and `v.base` roots
// the bytes the interior `ptr` points into, one hop further out.
//
// THE FRESH-BOX GUARD IS LOAD BEARING. A box this lowerer has just emitted —
// `emitInlineStringSlice`'s, for `return s[lo:hi]` — is removable precisely
// because nothing but its own `field_set`s names it. Putting it in word 2
// makes it ESCAPE into a return register, so dead-allocation elimination can
// no longer take it and #4422's win is undone on every function returning a
// reslice. `isFreshBox` keeps that box dead; the caller's test then fails and
// the caller allocates exactly as it does today.
//
// The type is the authority, not the word list. `explodedWordTypes` gives a
// tuple `(i64, i64, string)` the SAME three word types a `string` gets, so a
// rule keyed on `words[2] == string` would put the tuple's own handle in its
// third word and hand callers a `string` that is really the tuple — #4412's
// shape. `ty` is what `explodedRetWords` derived the words from.
fn explodedRetWordValues(fc: FnCtx, ty: int, v: int, words: []int): []int {
  if (ty != primType(fc.c.ctx, 11) || len(words) != 3 || isFreshBox(fc.b, v)) {
    return emitWordReads(fc.c.ctx, fc.b, v, words)
  }
  let ids = emitWordReads(fc.c.ctx, fc.b, v, [words[0], words[1]])
  return [ids[0], ids[1], v]
}

// `field_get handle[off] == word`, as a bool.
fn emitWordMatches(fc: FnCtx, b: IrBuilder, handle: int, off: int, word: int): int {
  let fg = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  fg.lhs = handle
  fg.ival = off
  let eq = mkInstr(Op.ICmpEq, primType(fc.c.ctx, 10))
  eq.lhs = builderEmit(b, fg)
  eq.rhs = word
  return builderEmit(b, eq)
}

// Ends the current block with `br cond -> yes() : no()`; neither edge carries a
// block argument.
fn emitWordTestBr(fc: FnCtx, b: IrBuilder, cond: int, yes: int, no: int) {
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = yes
  br.thenArgs = []int(0)
  br.ival2 = no
  br.elseArgs = []int(0)
  builderEmit(b, br)
  builderEndBlock(b)
}

// Emits the three-test chain and leaves every failing edge at `box`. The last
// test's success edge is the only one carrying a block argument — the handle
// itself, which is the whole point — so it is written here rather than through
// `emitWordTestBr`.
fn emitHandleReuseChain(fc: FnCtx, b: IrBuilder, vals: []int, box: int, join: int) {
  let ptrBlk = builderNewBlock(b)
  let lenBlk = builderNewBlock(b)
  let nl = mkInstr(Op.ConstNil, primType(fc.c.ctx, 11))
  let ne = mkInstr(Op.ICmpNe, primType(fc.c.ctx, 10))
  ne.lhs = vals[2]
  ne.rhs = builderEmit(b, nl)
  emitWordTestBr(fc, b, builderEmit(b, ne), ptrBlk, box)
  builderBeginBlock(b, ptrBlk)
  emitWordTestBr(fc, b, emitWordMatches(fc, b, vals[2], 0, vals[0]), lenBlk, box)
  builderBeginBlock(b, lenBlk)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = emitWordMatches(fc, b, vals[2], 8, vals[1])
  br.ival = join
  br.thenArgs = [vals[2]]
  br.ival2 = box
  br.elseArgs = []int(0)
  builderEmit(b, br)
  builderEndBlock(b)
}

// Rebuilds the aggregate a CALL handed back in words, reusing word 2 when it
// already denotes the same bytes.
//
// Separate from `materializeExplodedLocal`, which stays exactly as it is: a
// LOCAL's or a PARAMETER's words come from a box the lowerer itself built,
// where word 2 is the owner base and the test can never match, so there it
// would be pure cost.
fn materializeCallResult(fc: FnCtx, b: IrBuilder, ty: int, vals: []int): int {
  if (ty != primType(fc.c.ctx, 11) || len(vals) != 3) {
    return materializeExplodedIn(fc, b, ty, vals)
  }
  let box = builderNewBlock(b)
  let join = builderNewBlock(b)
  emitHandleReuseChain(fc, b, vals, box, join)
  builderBeginBlock(b, box)
  let jmp = mkInstr(Op.Jump, fc.c.ctx.voidId)
  jmp.ival = join
  jmp.args = [boxStringWords(fc.c.ctx, b, vals[0], vals[1], vals[2])]
  builderEmit(b, jmp)
  builderEndBlock(b)
  builderBeginBlock(b, join)
  return builderAddParam(b, ty)
}
