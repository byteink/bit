// compiler/fmtasm.bit — `asm { ... }` statement rendering and the
// block-ending tag list, split out of fmtdispatch.bit (#4308): that file sat
// at 799 lines with zero headroom on the repo's 800-line ceiling. fmtAsmStmt
// and its three slot helpers are called once, from fmtDispatch's
// Tag.AsmStmt case; fmtEndsInBlockTag is fmt.bit's own list of tags whose
// printed form already ends in `}` (used by fmtEndsInBlock there).
// `asm { x64 { ... } arm64 { ... } ... }` — split out to keep fmtDispatch
// readable. Kid layout mirrors the seed: k[0] x64 code, k[1] arm64 code,
// k[2] result, k[3] clobber x64, k[4] clobber arm64, k[5..] inputs. `main
// == 1` marks a volatile block.
//
// The parser (parserasm.bit) files each directive into a FIXED semantic slot,
// so k's own index is not the order the programmer wrote them in — only each
// populated kid's real span.start is (mkSpanNode/mkNode both carry genuine
// source positions). Two bugs followed from printing straight through k[0..]
// in slot order (#2879): it reordered whichever sub-blocks the programmer had
// written in a different sequence, and — because fmtGap's comment cursor only
// ever advances forward through SOURCE order — a clause printed ahead of its
// true position swept up an earlier clause's still-unconsumed trailing
// comment (or a later clause's, before that clause had even printed).
//
// The fix is two parts. First, sort the populated kids by span.start so
// print order matches source order. Second — needed even with order fixed,
// because a comment trailing one clause (after its own `}`, before the next
// clause's keyword) sits in the GAP between two siblings, which no per-item
// list printer owns — explicitly flush that gap with fmtGap before each
// clause, exactly like fmtPrintSeq does for an ordinary statement list. Only
// pay for the multi-line form when a comment actually forces it, or the
// flat rendering doesn't fit (#3679 — see fmtAsmStmt's own trial), so a
// block that fits on one line stays there as before.
fn fmtAsmSlotPrefix(p: Printer, slot: int) {
  if (slot == 0) {
    fmtRaw(p, "x64 ")
  } else if (slot == 1) {
    fmtRaw(p, "arm64 ")
  } else if (slot == 3) {
    fmtRaw(p, "clobber x64 ")
  } else if (slot == 4) {
    fmtRaw(p, "clobber arm64 ")
  }
}

// Populated kid indices, sorted by source span.start so print order matches
// what the programmer wrote (see fmtAsmSlotPrefix's doc comment above).
fn fmtAsmSlotOrder(p: Printer, k: []int): []int {
  let order = []int(0)
  let i = 0
  while (i < len(k)) {
    if (k[i] != 0) {
      order = append(order, i)
    }
    i = i + 1
  }
  // Insertion sort, bounded by len(k) (itself bounded by parseAsm's 256-
  // directive guard): stable and small-n, no library sort needed.
  let a = 1
  while (a < len(order)) {
    let b = a
    while (b > 0 &&
      getNode(p.tree, k[order[b - 1]]).span.start > getNode(p.tree, k[order[b]]).span.start) {
      let tmp = order[b - 1]
      order[b - 1] = order[b]
      order[b] = tmp
      b = b - 1
    }
    a = a + 1
  }
  return order
}

// Prints every populated slot flat, `prefix content ` each — the single-
// line form, and the text fmtAsmStmt's own width/newline trial measures
// before committing to it (#3679). One writer for both so they can never
// drift out of sync with each other.
fn fmtAsmFlatSlots(p: Printer, k: []int, order: []int) {
  let j = 0
  while (j < len(order)) {
    let slot = order[j]
    fmtAsmSlotPrefix(p, slot)
    fmtPrintNode(p, k[slot])
    fmtRaw(p, " ")
    j = j + 1
  }
}

fn fmtAsmStmt(p: Printer, idx: int, n: Node) {
  fmtRaw(p, "asm ")
  if (n.main == 1) {
    fmtRaw(p, "volatile ")
  }
  let k = kidsOf(p.tree, idx)
  let order = fmtAsmSlotOrder(p, k)
  let hasComment = fmtHasCommentBefore(p, n.span.end)
  // A block with no comment is still only a FLAT-LAYOUT CANDIDATE, not
  // guaranteed flat (#3679): render `{ slot slot ... }` into a scratch
  // buffer first and keep it only if that text holds no newline (no slot's
  // own content — e.g. a byte-array code list — decided independently to
  // wrap) and fits the width budget. Safe to discard and re-render for
  // real on the fallthrough path: `hasComment` being false already proves
  // this whole span holds no comment, so the trial cannot have consumed
  // one, and restoring p.srcPos re-plays the identical, deterministic node
  // text (mirrors fmtPrintCommaList's trial in fmtwrap.bit).
  if (!hasComment) {
    let colBefore = p.col
    let bolBefore = p.bol
    let srcPosBefore = p.srcPos
    let savedOut = p.out
    p.out = []byte(0)
    p.bol = false
    fmtRaw(p, "{ ")
    fmtAsmFlatSlots(p, k, order)
    fmtRaw(p, "}")
    let text = string(p.out)
    p.out = savedOut
    p.col = colBefore
    p.bol = bolBefore
    if (!fmtHasNl(text) && colBefore + len(text) <= fmtMaxWidth) {
      fmtRaw(p, text)
      return
    }
    p.srcPos = srcPosBefore
  }
  fmtRaw(p, "{")
  p.indent = p.indent + 1
  let j = 0
  while (j < len(order)) {
    let slot = order[j]
    fmtGap(p, getNode(p.tree, k[slot]).span.start, false)
    fmtAsmSlotPrefix(p, slot)
    fmtPrintNode(p, k[slot])
    j = j + 1
  }
  fmtGap(p, n.span.end, false)
  p.indent = p.indent - 1
  fmtRaw(p, "}")
}

// The tag list `fmt.bit`'s `fmtEndsInBlock` tests. Split out here (a sibling
// with headroom) rather than left inline there, purely so a new
// block-ending tag costs THIS function's own complexity, never
// `fmtEndsInBlock`'s recorded baseline (tools/build/complexity-debt.txt).
fn fmtEndsInBlockTag(t: Tag): bool {
  return t == Tag.Block ||
    t == Tag.FuncDecl ||
    t == Tag.StructDecl ||
    t == Tag.InterfaceDecl ||
    t == Tag.EnumDecl ||
    t == Tag.TraitDecl ||
    t == Tag.IfStmt ||
    t == Tag.WhileStmt ||
    t == Tag.ForC ||
    t == Tag.ForOf ||
    t == Tag.ForIn ||
    t == Tag.ForInf ||
    t == Tag.SwitchStmt ||
    t == Tag.SelectStmt ||
    t == Tag.MatchStmt ||
    t == Tag.TestDecl
}
