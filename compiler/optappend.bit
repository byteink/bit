// compiler/optappend.bit — #4039: expands a spare-capacity `append`'s runtime
// call inline, after the inliner ran, into a fast store that mutates the
// header IN PLACE. #6092 found that in-place mutation unsound in general —
// `x := append(base, 1); y := append(base, 1)` made `x` and `y` alias the
// identical header object, so `y`'s growth silently changed `len(x)`.
//
// BEHIND `BIT_APPEND_FRESH` (compiler/lowerappend.bit's `appendFreshEnabled`,
// epic #6160), because the fix changes the emitted IR shape and the pinned
// 0.31.0 stage0 oracle does not have it: `lowerAppend` emits a call named
// `slice_append`/`slice_append_str` when the flag is off, and
// `slice_append_fresh`/`slice_append_str_fresh` when it is on
// (runtime/root/slices.bit has both pairs of entry points; the unchanged
// pair is untouched by #6092, the `_fresh` pair clones). `appendExpandable`
// below applies a DIFFERENT eligibility rule per name:
//
//   "slice_append"       — UNCHANGED from before #6092: expand whenever the
//                           element width matches the stride, unconditionally.
//                           This is what keeps `BIT_APPEND_FRESH` unset
//                           byte-identical to main (task-6092's report).
//   "slice_append_fresh" — expand ONLY when `appendOwnedCalls`
//                           (compiler/optappendown.bit, #6164) proved that
//                           nothing but the call's input can reach the input
//                           header once the call returns: mutating it and
//                           handing the same one back is then unobservable.
//                           A proven call the fast path cannot take (a
//                           narrow stride, or `slice_append_str_fresh`) is
//                           renamed to its in-place twin instead, and so is
//                           the grow arm of a proven expansion. When the
//                           proof fails the call keeps the general (cloning)
//                           `_fresh` runtime entry point.
//
// THE GROW ARM IS UNCHANGED EITHER WAY (`emitExpandedAppend`'s `grow` block
// calls the runtime unconditionally, under whichever name the call already
// carries): a grow already pays a buffer copy, so one more small header
// allocation is proportionally cheap there, and the single-use proof buys
// nothing extra on that arm.
//
// Sibling of opt.bit: same module, so this needs no imports and no call-site
// changes — `blockEmissionOrder`, `emitTranslated`, `noConst`, `useCounts`
// and the builder API are all defined elsewhere in this module.
//
// WHY A PASS AND NOT A LOWERING. `bit_rt_slice_append` (runtime/root/slices.bit)
// is ~200 instructions and makes two further calls of its own — `appendTarget`,
// and `bit_rt_port_mem_store_byte` for a `[]u8` — so a `Builder.writeByte` loop
// paid a `bl`, a prologue and an epilogue per BYTE: 37.0 cycles per byte
// appended on `bench/cases/strings`' build phase against Go's ~12.5. The
// obvious fix is to emit the fast path in `lowerAppend`, and it BACKFIRES: the
// fast path needs three blocks, and when this was measured `optinlinecost.bit`'s
// `calleeShapeOk` refused any callee with more than one, so `Builder.writeByte`
// — whose whole body is a single `append` — stopped being spliced. Measured
// both ways on the same probe, same box, same session:
//
//   lowered inline    1.057e9 -> 1.452e9 cycles   +37%  (writeByte stops inlining)
//   expanded here     1.057e9 -> see the ticket   -43%  (writeByte still inlines)
//
// with instructions retired FALLING 33% in the regressing case — the call's
// prologue/epilogue and register pressure cost more than the instructions it
// saved. Running after `inlineCalls` gets both: the callee is still the small
// body the inliner will take when the inliner looks at it, and every surviving
// call site — the inlined copy included — is expanded here. #4344 taught the
// inliner to splice a multi-block callee, so the block count is no longer what
// would refuse a fast path lowered in `lowerAppend`; the SIZE budget and this
// measurement are unchanged, and this placement is not up for revisiting on
// that basis without re-running the probe above.
//
// Block ids minted here do NOT ascend with the linear schedule, and that is
// safe only because `optimizeModule` runs `foldConstantsAndPrune` after this
// pass: its `rebuild` renumbers blocks into emission order (ascending
// `instsStart`), which is the invariant `isBackEdge` and the x64 linear-scan
// allocator's interval numbering both assume (build.bit's `writeModuleExe`).
// Do not reorder this pass to after that fold.

// Whether instruction `idx` is a `slice_append` whose element write is the same
// single store `rtSliceAppend` performs, so the fast path can reproduce it.
//
// The two expandable strides are the two the runtime writes with one
// instruction:
//
//   stride 8 -> `storeWord(buf + (off + vlen) * 8, word)` — every reference
//               type plus i64/u64/int, and f64/f32 which `emitRtCall` has
//               already bitcast into an integer word (ir.bit's `rtWordArgs`);
//   stride 1 -> `storeByte(buf + off + vlen, word)`       — a packed `[]u8`.
//
// `index_set` scales its index by the VALUE operand's own width
// (arm64dispatch.bit, x64dispatch.bit both read `f.instrs[ins.ival].ty`), so
// the argument's IR type is what is checked here.
//
// EVERY OTHER NARROW PRIM KEEPS THE CALL, the same asymmetry
// `canInlineSliceStore` (loweraccess.bit) documents rather than a missed case.
// i8/i16/i32/u16/u32/bool are stored WORD-PER-ELEMENT (stride 8) while their
// own width is 1/2/4, so a narrow store would write the low bytes and leave the
// rest of that word holding whatever a previous view of the same buffer left
// there — and `rtSliceGet` reads the word whole. A reslice shares its backing
// (`rtSliceSlice`), so the slot at `off + len` genuinely can hold an older
// element's bytes; this is not a fresh-memory argument that happens to hold.
//
// A non-constant `elem_size` operand is refused rather than guessed. Lowering
// always emits it as a `const_int` and the inliner copies it as one, so this
// fails closed on a shape that does not occur, never silently on one that does.
//
// `owned` is `appendOwnedCalls(f)` (compiler/optappendown.bit), computed ONCE
// per function by this pass's caller and read only on the
// `slice_append_fresh` path; the unchanged `slice_append` path ignores it,
// matching main. `owned[idx]` is #6164's proof that no reference to the
// call's input header other than the input itself can exist once the call
// returns: no other SSA value in its alias class is live after it, the class
// starts from a header no one else was given, and no escape of it can reach
// the call. #6092's `useCounts(f)[h] == 1` rule it replaces was a use count
// of the input only: it missed the loop-carried `snap = acc` that a stronger
// `== 2` draft miscompiled, and it accepted a parameter or a field load with
// one use, whose header the caller or the heap still holds.
// The width/shape half of `appendExpandable`'s eligibility test, split out
// to keep `appendExpandable` itself under E0204's complexity ceiling once
// `BIT_APPEND_FRESH`'s two-name dispatch landed beside it. `(false, _)`
// when `idx` is not an eligible `slice_append`/`slice_append_fresh` call;
// otherwise `(true, fresh)`, `fresh` telling the caller which of the two
// names matched.
fn appendShapeEligible(ctx: TypeContext, f: IrFunc, idx: int): (bool, bool) {
  let ins = f.instrs[idx]
  if (ins.op != Op.RtCall || len(ins.args) != 4) {
    return false, false
  }
  let fresh = ins.name == "slice_append_fresh"
  if (!fresh && ins.name != "slice_append") {
    return false, false
  }
  let es = f.instrs[ins.args[3]]
  if (es.op != Op.ConstInt) {
    return false, false
  }
  let w = widthOf(ctx, f.instrs[ins.args[1]].ty).bytes
  if (es.ival != w || w > 8) {
    return false, false
  }
  return true, fresh
}

fn appendExpandable(ctx: TypeContext, f: IrFunc, owned: []bool, idx: int): bool {
  let (eligible, fresh) = appendShapeEligible(ctx, f, idx)
  if (!eligible) {
    return false
  }
  return !fresh || owned[idx]
}

// Whether `f` contains any append this pass rewrites at all: an expandable
// one, or a proven `_fresh` call renamed in place. The pass rebuilds nothing
// when this is false, so every function without one comes out of
// `optimizeModule` byte-identical to before — which is what keeps this change's
// blast radius the append sites and nothing else.
fn hasAppendRewrite(ctx: TypeContext, f: IrFunc, owned: []bool, copies: []int): bool {
  let i = 0
  while (i < len(f.instrs)) {
    if (owned[i] || copies[i] > 0 || appendExpandable(ctx, f, owned, i)) {
      return true
    }
    i = i + 1
  }
  return false
}

// The in-place twin of a `_fresh` append name: what a call `appendOwnedCalls`
// proved may mutate its input is renamed to. Any other name is returned as is.
fn appendInPlaceName(name: string): string {
  if (name == "slice_append_fresh") {
    return "slice_append"
  }
  if (name == "slice_append_str_fresh") {
    return "slice_append_str"
  }
  return name
}

// `call` re-emitted under `name` with its operands translated: a proven
// `_fresh` call the fast path does not expand keeps its call, in place.
fn emitRenamedAppend(b: IrBuilder, call: IrInstr, args: []int, name: string): int {
  let ins = mkInstr(Op.RtCall, call.ty)
  ins.name = name
  ins.args = args
  ins.span = call.span
  return builderEmit(b, ins)
}

// The spare-capacity arm's body: store `v` at element `off + len` of `h`'s
// buffer and bump the header's length word. Emitted into the block its caller
// opened, and it must stay call-free — see `emitExpandedAppend`'s GC argument.
fn emitAppendFastStore(b: IrBuilder, ctx: TypeContext, h: int, v: int, lenV: int) {
  let i64ty = primType(ctx, 3)
  // Header words at runtime/ABI.md §2 offsets: `buf` 0, `len` 8, `off` 16.
  // `off` is not always zero — a reslice carries a view offset — so it is
  // loaded and added rather than assumed away.
  let bufIns = mkInstr(Op.FieldGet, i64ty)
  bufIns.lhs = h
  bufIns.ival = 0
  let buf = builderEmit(b, bufIns)
  let offIns = mkInstr(Op.FieldGet, i64ty)
  offIns.lhs = h
  offIns.ival = 16
  let slot = mkInstr(Op.Add, i64ty)
  slot.lhs = builderEmit(b, offIns)
  slot.rhs = lenV
  let is = mkInstr(Op.IndexSet, ctx.voidId)
  is.lhs = buf
  is.rhs = builderEmit(b, slot)
  is.ival = v
  // `v`'s own type, read once here: `appendExpandable` already proved its
  // width is exactly the stride (8, or a packed scalar's) this fast path
  // requires, and `v` is a post-remap id into `b`, not `f` (#4396 — pinned
  // rather than re-derived by the selector at codegen time).
  is.ival2 = b.instrs[v].ty
  builderEmit(b, is)
  let one = mkInstr(Op.ConstInt, i64ty)
  one.ival = 1
  let bump = mkInstr(Op.Add, i64ty)
  bump.lhs = lenV
  bump.rhs = builderEmit(b, one)
  let set = mkInstr(Op.FieldSet, ctx.voidId)
  set.lhs = h
  set.ival = 8
  set.rhs = builderEmit(b, bump)
  set.ival2 = i64ty
  builderEmit(b, set)
}

// Replaces one `rt_call slice_append(h, word, is_ref, elem_size)` with
//
//     len = slice_len h ; cap = field_get h[24] ; br (len < cap) -> fast, grow
//   fast: store the element at h.buf[h.off + len] ; h.len = len + 1 ; jump join(h)
//   grow: jump join(rt_call slice_append h, word, is_ref, elem_size)
//   join: (result)
//
// and returns the join block's parameter — the value the call's own id must
// remap to. LEAVES `join` OPEN: the rest of the block being rewritten continues
// into it.
//
// THE SEMANTICS, on the FAST arm only:
//
//   store the element at buf + (off + vlen) * stride
//   h.len = vlen + 1 ; RETURN h — the same header, mutated in place
//
// `slice_append` (`BIT_APPEND_FRESH` off, matching main): always sound to
// emit here, unconditionally, exactly as before #6092 — the runtime's own
// `rtSliceAppend` does the identical in-place mutation on this arm, so the
// fast path only moves WHERE it happens, not WHAT happens.
// `slice_append_fresh` (`BIT_APPEND_FRESH` on): sound here specifically
// because `appendOwnedCalls` (optappendown.bit) proved nothing but `h` can
// reach `h`'s header once the call returns (#6092, #6164).
//
// The GROW arm below calls the general runtime entry point, under
// `growName`: the call's own name when it is `slice_append`, and the
// in-place `slice_append` for a proven `slice_append_fresh` (the cloning
// `rtSliceAppendFresh` would buy an independent header nobody can observe).
// It fires on `len < cap` — the
// complement of the runtime's own `vlen == vcap` grow test, so a
// reallocation happens on exactly the same appends as before. `len <= cap`
// is an invariant of every header this compiler can produce (`rtSliceNew`
// clamps `cap` up to `len`, `rtSliceSlice` gives `len = hi-lo` and
// `cap = vcap-lo`, and the fast path adds one to each side of `len < cap`),
// so `<` and `!=` select the same appends; `<` is used because it FAILS
// CLOSED into the runtime if that invariant is ever broken, where `!=` would
// write past the buffer.
//
// THE NULL HEADER NEEDS NO SEPARATE TEST, exactly as it needs none in
// `emitInlineSliceElem` (loweraccess.bit). A zeroed class's slice field is the
// null word (#1564), and both `slice_len` and a `field_get` on a slice-typed
// base read a null header as 0 (`emitHeaderWordOrZero`). So a null receiver has
// `len == cap == 0`, fails `0 < 0`, and reaches the runtime — which is where
// `appendTarget`'s fresh-header arm lives and where the compiler-supplied
// `is_ref` is honoured (#3648: a fabricated header with the wrong `is_ref` was
// a real GC bug, not merely a wasted allocation).
//
// THE ELEMENT LANDS IN BOUNDS BY THE RUNTIME'S OWN ARGUMENT. `off + cap` is the
// buffer's element count and is invariant under reslicing (`rtSliceSlice` moves
// `lo` from `cap` to `off`), so `len < cap` gives `off + len < off + cap`. No
// bounds test is emitted, for the same reason `rtSliceAppend` emits none.
//
// THE GC HAZARD IS `emitInlineSliceElem`'s, unchanged and for the same reason.
// `buf` is a GC-managed pointer living in an `i64` vreg that no stack map
// describes (runtime/ABI.md §4); what makes that sound is that its live range
// contains no safepoint. Everything between the `field_get [0]` and the
// `index_set` is arithmetic in ONE straight-line block — no call, no
// allocation, and no back edge, since `join` is minted after `fast` and
// `isBackEdge` is `target <= curBlock` once `rebuild` has renumbered both into
// emission order. `opt.bit` has no code motion that could open that window, and
// `optloop.bit` already refuses to hoist a `field_get` at offset 0 for exactly
// this reason (#4053). The `rt_call` on the grow arm IS a safepoint, and `buf`
// is not live there: it is never computed on that side.
//
// NO WRITE BARRIER, for the reason #3108 records: the collector is
// stop-the-world mark-sweep, non-moving, and `rtSliceAppend` itself stores with
// a bare `storeWord`. When it goes incremental the barrier is owed here, at
// `emitInlineSliceSet`, and at both backends' `field_set` together.
//
// `growName` is the grow arm's runtime entry: the call's own name, or its
// in-place twin when `appendOwnedCalls` proved the input unshared (#6164) —
// the same proof that licenses the fast arm licenses a mutating grow.
fn emitExpandedAppend(
  b: IrBuilder, ctx: TypeContext, call: IrInstr, args: []int, growName: string,
): int {
  let i64ty = primType(ctx, 3)
  let h = args[0]
  let lenIns = mkInstr(Op.SliceLen, i64ty)
  lenIns.lhs = h
  lenIns.span = call.span
  let lenV = builderEmit(b, lenIns)
  // `cap(s)` is `field_get [24]` on the header itself (lowerprim.bit's
  // `lowerLen`), null-safe on both backends.
  let capIns = mkInstr(Op.FieldGet, i64ty)
  capIns.lhs = h
  capIns.ival = 24
  capIns.span = call.span
  let cmp = mkInstr(Op.ICmpSlt, primType(ctx, 10))
  cmp.lhs = lenV
  cmp.rhs = builderEmit(b, capIns)
  cmp.span = call.span
  let room = builderEmit(b, cmp)
  let fast = builderNewBlock(b)
  let grow = builderNewBlock(b)
  let join = builderNewBlock(b)
  let br = mkInstr(Op.Br, ctx.voidId)
  br.lhs = room
  br.ival = fast
  br.thenArgs = []int(0)
  br.ival2 = grow
  br.elseArgs = []int(0)
  br.span = call.span
  builderEmit(b, br)
  builderEndBlock(b)

  builderBeginBlock(b, fast)
  emitAppendFastStore(b, ctx, h, args[1], lenV)
  emitAppendJump(b, join, h, call.span)
  builderEndBlock(b)

  builderBeginBlock(b, grow)
  emitAppendJump(b, join, emitRenamedAppend(b, call, args, growName), call.span)
  builderEndBlock(b)

  builderBeginBlock(b, join)
  return builderAddParam(b, call.ty)
}

// `jump target(v)`, carrying `span` so the rewritten sequence keeps the
// original call's source position (#3282's span-on-rewrite policy).
fn emitAppendJump(b: IrBuilder, target: int, v: int, span: Span) {
  let j = mkInstr(Op.Jump, 0)
  j.ival = target
  j.args = [v]
  j.span = span
  builderEmit(b, j)
}

// One block of `f`, rewritten into `b`. Every append in it splits the block:
// `emitExpandedAppend` closes the block being written and opens the join, and
// the remaining instructions — including the terminator — land there.
fn expandAppendBlock(x: AppendCtx, bi: int) {
  let blk = x.f.blocks[bi]
  builderBeginBlock(x.b, x.blockMap[bi])
  let idx = blk.instsStart
  let paramsEnd = blk.instsStart + blk.paramCount
  while (idx < paramsEnd) {
    x.remap[idx] = builderAddParam(x.b, x.f.instrs[idx].ty)
    idx = idx + 1
  }
  let end = blk.instsStart + blk.instsLen
  while (idx < end) {
    let ins = x.f.instrs[idx]
    let name = x.owned[idx] ? appendInPlaceName(ins.name) : ins.name
    if (x.copies[idx] > 0) {
      emitEscapeCopy(x, idx, x.copies[idx] - 1)
    } else if (appendExpandable(x.ctx, x.f, x.owned, idx)) {
      x.remap[idx] = emitExpandedAppend(x.b, x.ctx, ins, trList(x.remap, ins.args), name)
    } else if (x.owned[idx]) {
      x.remap[idx] = emitRenamedAppend(x.b, ins, trList(x.remap, ins.args), name)
    } else {
      emitTranslated(x.b, x.f, x.known, x.remap, x.blockMap, idx)
    }
    idx = idx + 1
  }
  builderEndBlock(x.b)
}

// Emits escape `idx` handed a new header in place of field read `g`
// (optappendfield.bit's rule 4, #6210): `rt_call slice_slice(g, 0,
// slice_len g)`, which `rtSliceSlice` allocates over the same buffer, so
// the field stays the only holder of the header its appends mutate.
fn emitEscapeCopy(x: AppendCtx, idx: int, g: int) {
  let i64ty = primType(x.ctx, 3)
  let span = x.f.instrs[idx].span
  let h = x.remap[g]
  let zero = mkInstr(Op.ConstInt, i64ty)
  zero.ival = 0
  zero.span = span
  let n = mkInstr(Op.SliceLen, i64ty)
  n.lhs = h
  n.span = span
  let cp = mkInstr(Op.RtCall, x.f.instrs[g].ty)
  cp.name = "slice_slice"
  cp.args = [h, builderEmit(x.b, zero), builderEmit(x.b, n)]
  cp.span = span
  x.remap[g] = builderEmit(x.b, cp)
  emitTranslated(x.b, x.f, x.known, x.remap, x.blockMap, idx)
  x.remap[g] = h
}

// The rewrite state shared across one function's blocks — bundled so
// `expandAppendBlock` stays under E0202's max-params (spec/LINT.md), the same
// shape `RebuildCtx` uses in opt.bit. `owned` is `appendOwnedCalls(f)` over
// the ORIGINAL (pre-rewrite) `f` — computed once in `expandAppends` and read by
// every `appendExpandable` call this pass makes, never recomputed against the
// builder `b` being written. `copies` is `fieldEscapeCopies` for `f`.
class AppendCtx {
  b: IrBuilder,
  f: IrFunc,
  ctx: TypeContext,
  remap: []int,
  blockMap: []int,
  known: []ConstVal,
  owned: []bool,
  copies: []int,
}

// Pass 4 of `optimizeModule` over every function. The field-ownership fact
// (optappendfield.bit, #6179) is proved over the whole module first, before
// any function is rewritten, so every function is judged against the same
// post-inlining program.
fn expandAppendsInModule(m: IrModule) {
  let fields = ownedFieldsOf(m)
  let i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = expandAppends(m.ctx, m.funcs[i], fields, i)
    i = i + 1
  }
}

// One function, `m.funcs[fi]`: expand every expandable `slice_append` in
// `f`, rename every proven `_fresh` call it cannot expand to its in-place
// twin, and copy the header each owned field's escape takes. Returns `f`
// untouched when there is none, so the pass cannot perturb a function it
// has no work in.
fn expandAppends(ctx: TypeContext, f: IrFunc, fo: FieldOwn, fi: int): IrFunc {
  let owned = appendOwnedCalls(f, fo)
  let copies = fieldEscapeCopies(fo, fi, len(f.instrs))
  if (!hasAppendRewrite(ctx, f, owned, copies)) {
    return f
  }
  let n = len(f.blocks)
  let blockMap = []int(0)
  let remap = []int(0)
  let known = []ConstVal(0)
  let i = 0
  while (i < n) {
    blockMap = append(blockMap, 0)
    i = i + 1
  }
  i = 0
  while (i < len(f.instrs)) {
    remap = append(remap, 0)
    // Nothing is folded here; `emitTranslated` needs the array regardless.
    known = append(known, noConst())
    i = i + 1
  }
  // Emission order, not id order: the blocks must be rewritten in the order
  // their instructions appear, so `rebuild`'s ascending-`instsStart` renumber
  // in the next pass reproduces a valid linear schedule (optrebuild.bit's
  // `blockEmissionOrder`).
  let order = blockEmissionOrder(f)
  let b = newBuilder()
  i = 0
  while (i < n) {
    blockMap[order[i]] = builderNewBlock(b)
    i = i + 1
  }
  let x = AppendCtx{
    b = b, f = f, ctx = ctx, remap = remap, blockMap = blockMap, known = known,
    owned = owned, copies = copies,
  }
  i = 0
  while (i < n) {
    expandAppendBlock(x, order[i])
    i = i + 1
  }
  // Module tag, pin flag and attrs ride across in irFuncRebuilt (ir.bit); the
  // keepalive edges (#4406) are translated through this pass's remap.
  return irFuncRebuilt(f, b, trKeepAlive(f.keepAlive, remap))
}
