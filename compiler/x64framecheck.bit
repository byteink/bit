// In-Bit self-checks for x86-64 stack, floats, calls, jumps, frames and
// register files. Split out of selfcheck.bit (#1503); sibling .bit files are
// the same module, so `selfcheck()` still calls these directly.

fn checkX64Stack() {
  // push/pop are 64-bit by default in long mode: no REX.W, only the extension
  // bit. Emitting REX.W here would not widen anything — it would be a wasted
  // (and for pop, wrong) prefix.
  let b = newX64Buf()
  xPush(b, XReg64.Rax)
  assert(xHex(b) == "50")
  let b2 = newX64Buf()
  xPush(b2, XReg64.R15)
  assert(xHex(b2) == "4157")
  let b3 = newX64Buf()
  xPop(b3, XReg64.Rbx)
  assert(xHex(b3) == "5b")
  let b4 = newX64Buf()
  xPop(b4, XReg64.R13)
  assert(xHex(b4) == "415d")

  let b5 = newX64Buf()
  xRet(b5)
  assert(xHex(b5) == "c3")
  // ud2 must be exactly this: it is the trap emitted where control must never
  // arrive, so it has to fault rather than decode as something executable.
  let b6 = newX64Buf()
  xUd2(b6)
  assert(xHex(b6) == "0f0b")
}

fn checkX64Float() {
  // The scalar arithmetic table, double: F2 prefix.
  let ops = [XFArith.FAdd, XFArith.FSub, XFArith.FMul, XFArith.FDiv]
  let want = ["f20f58c1", "f20f5cc1", "f20f59c1", "f20f5ec1"]
  let i = 0
  while (i < len(ops)) {
    let b = newX64Buf()
    xFArithRR(b, ops[i], XmmReg.Xmm0, XmmReg.Xmm1, 8)
    assert(xHex(b) == want[i])
    i = i + 1
  }
  // addss %xmm1, %xmm0 -> f3 0f 58 c1 — single takes F3.
  let b2 = newX64Buf()
  xFArithRR(b2, XFArith.FAdd, XmmReg.Xmm0, XmmReg.Xmm1, 4)
  assert(xHex(b2) == "f30f58c1")

  // REX placement: the prefix comes FIRST, then REX.
  // addsd %xmm13, %xmm0 -> f2 41 0f 58 c5 (REX.B: the source is extended)
  let b3 = newX64Buf()
  xFArithRR(b3, XFArith.FAdd, XmmReg.Xmm0, XmmReg.Xmm13, 8)
  assert(xHex(b3) == "f2410f58c5")
  // addsd %xmm1, %xmm13 -> f2 44 0f 58 e9 (REX.R: the destination is extended)
  let b4 = newX64Buf()
  xFArithRR(b4, XFArith.FAdd, XmmReg.Xmm13, XmmReg.Xmm1, 8)
  assert(xHex(b4) == "f2440f58e9")

  // ucomis uses a DIFFERENT prefix scheme: 66 for double, NONE for single —
  // the opposite shape from the arithmetic ops, where double takes F2. Using
  // the arithmetic prefix here encodes another instruction entirely.
  // ucomisd %xmm1, %xmm0 -> 66 0f 2e c1
  let b5 = newX64Buf()
  xUcomis(b5, XmmReg.Xmm0, XmmReg.Xmm1, 8)
  assert(xHex(b5) == "660f2ec1")
  // ucomiss %xmm1, %xmm0 -> 0f 2e c1 — no prefix at all.
  let b6 = newX64Buf()
  xUcomis(b6, XmmReg.Xmm0, XmmReg.Xmm1, 4)
  assert(xHex(b6) == "0f2ec1")
  // ucomisd %xmm13, %xmm0 -> 66 41 0f 2e c5
  let b7 = newX64Buf()
  xUcomis(b7, XmmReg.Xmm0, XmmReg.Xmm13, 8)
  assert(xHex(b7) == "66410f2ec5")

  // xorpd %xmm1, %xmm0 -> 66 0f 57 c1 ; xorps -> 0f 57 c1
  let b8 = newX64Buf()
  xXorp(b8, XmmReg.Xmm0, XmmReg.Xmm1, 8)
  assert(xHex(b8) == "660f57c1")
  let b9 = newX64Buf()
  xXorp(b9, XmmReg.Xmm0, XmmReg.Xmm1, 4)
  assert(xHex(b9) == "0f57c1")
}

fn checkX64Convert() {
  // cvtsi2sd %rax, %xmm0 -> f2 48 0f 2a c0. REX.W is what makes the SOURCE
  // 64-bit; without it the conversion reads only the low 32 bits.
  let b = newX64Buf()
  xCvtI2F(b, XmmReg.Xmm0, XReg64.Rax, 8)
  assert(xHex(b) == "f2480f2ac0")
  // cvtsi2ss %rax, %xmm0 -> f3 48 0f 2a c0
  let b2 = newX64Buf()
  xCvtI2F(b2, XmmReg.Xmm0, XReg64.Rax, 4)
  assert(xHex(b2) == "f3480f2ac0")

  // cvttsd2si %xmm0, %rax -> f2 48 0f 2c c0. Opcode 2C is the TRUNCATING form;
  // 2D rounds per MXCSR, a different answer for every non-integral value.
  let b3 = newX64Buf()
  xCvtF2I(b3, XReg64.Rax, XmmReg.Xmm0, 8)
  assert(xHex(b3) == "f2480f2cc0")
  // cvttss2si %xmm0, %rax -> f3 48 0f 2c c0
  let b4 = newX64Buf()
  xCvtF2I(b4, XReg64.Rax, XmmReg.Xmm0, 4)
  assert(xHex(b4) == "f3480f2cc0")

  // Float<->float: the prefix names the SOURCE width, not the destination's.
  // cvtsd2ss %xmm1, %xmm0 (8 -> 4) -> f2 0f 5a c1
  let b5 = newX64Buf()
  xCvtF2F(b5, XmmReg.Xmm0, XmmReg.Xmm1, 8)
  assert(xHex(b5) == "f20f5ac1")
  // cvtss2sd %xmm1, %xmm0 (4 -> 8) -> f3 0f 5a c1
  let b6 = newX64Buf()
  xCvtF2F(b6, XmmReg.Xmm0, XmmReg.Xmm1, 4)
  assert(xHex(b6) == "f30f5ac1")
  // The two directions must never encode the same.
  assert(xHex(b5) != xHex(b6))
}

fn checkX64Calls() {
  // call <sym> -> e8 + a zero rel32 placeholder, plus a reloc naming the field.
  // The reloc's offset must point at the IMMEDIATE (byte 1), not at the opcode:
  // pointing at the opcode makes the linker overwrite the e8 itself.
  let cx = newXCtx(XCallConv.SysV)
  xCallReloc(cx, "bar")
  assert(xHex(cx.buf) == "e800000000")
  assert(len(cx.relocs) == 1)
  assert(cx.relocs[0].offset == 1)
  assert(cx.relocs[0].symbol == "bar")
  assert(cx.relocs[0].kind == RelocKind.Branch)

  // movabs dst, <sym> -> 48 b8 + 8 zero bytes; the reloc covers the immediate.
  let cx2 = newXCtx(XCallConv.SysV)
  xMovAbsSymbol(cx2, XReg64.Rax, "g")
  assert(xHex(cx2.buf) == "48b80000000000000000")
  assert(cx2.relocs[0].offset == 2 && cx2.relocs[0].kind == RelocKind.Abs64)
  // r15 needs REX.B, which shifts the immediate one byte later — the reloc
  // offset must follow it.
  let cx3 = newXCtx(XCallConv.SysV)
  xMovAbsSymbol(cx3, XReg64.R15, "g")
  assert(cx3.relocs[0].offset == 2)
  assert(len(cx3.buf.code) == 10)

  // call *%rax -> ff d0 ; call *%r15 -> 41 ff d7 (assembler goldens)
  let cx4 = newXCtx(XCallConv.SysV)
  xCallReg(cx4, XReg64.Rax)
  assert(xHex(cx4.buf) == "ffd0")
  let cx5 = newXCtx(XCallConv.SysV)
  xCallReg(cx5, XReg64.R15)
  assert(xHex(cx5.buf) == "41ffd7")
}

fn checkX64Jumps() {
  // jmp -> e9 + rel32 placeholder; jcc -> 0f 8x + rel32. Always the rel32 form:
  // a rel8 cannot reach every block, and the distance is not known yet.
  let cx = newXCtx(XCallConv.SysV)
  xJmpRel32(cx, 0)
  assert(xHex(cx.buf) == "e900000000")
  assert(len(cx.fixups) == 1 && cx.fixups[0].patchOffset == 1 && cx.fixups[0].target == 0)

  let cx2 = newXCtx(XCallConv.SysV)
  xJccRel32(cx2, ccE(), 3)
  assert(xHex(cx2.buf) == "0f8400000000")
  assert(cx2.fixups[0].patchOffset == 2 && cx2.fixups[0].target == 3)
  // The cc rides in the opcode's low nibble: je=84, jne=85, jl=8c.
  let cx3 = newXCtx(XCallConv.SysV)
  xJccRel32(cx3, ccNe(), 0)
  assert(cx3.buf.code[1] == u8(0x85))
  let cx4 = newXCtx(XCallConv.SysV)
  xJccRel32(cx4, ccL(), 0)
  assert(cx4.buf.code[1] == u8(0x8C))

  // The rel32 is measured from the END of the field. A jmp at offset 0 has its
  // field at 1..5, so targeting 5 (the next byte) is a displacement of ZERO —
  // not 5, and not 1.
  let cx5 = newXCtx(XCallConv.SysV)
  xJmpRel32(cx5, 0)
  xPatchRel32(cx5, 1, 5)
  assert(xHex(cx5.buf) == "e900000000")
  // Targeting byte 0 (backwards, to the jump's own start) is -5.
  let cx6 = newXCtx(XCallConv.SysV)
  xJmpRel32(cx6, 0)
  xPatchRel32(cx6, 1, 0)
  assert(xHex(cx6.buf) == "e9fbffffff") // -5
  // Forwards by 16 from the end of the instruction.
  let cx7 = newXCtx(XCallConv.SysV)
  xJmpRel32(cx7, 0)
  xPatchRel32(cx7, 1, 21)
  assert(xHex(cx7.buf) == "e910000000") // 21 - 5 == 16

  // "Jump to here" resolves against the current end of the code.
  let cx8 = newXCtx(XCallConv.SysV)
  xJmpRel32(cx8, 0)
  xEmitByte(cx8.buf, 0x90) // one nop of not-taken path
  xPatchRel32Here(cx8, 1)
  assert(xHex(cx8.buf) == "e90100000090") // lands just past the nop

  // patchJumpFixups resolves every pending jump against the block table.
  let cx9 = newXCtx(XCallConv.SysV)
  xJmpRel32(cx9, 1)       // -> block 1
  xJccRel32(cx9, ccE(), 0) // -> block 0
  cx9.blockOffsets = [0, 32]
  xPatchJumpFixups(cx9)
  // jmp's field at 1: 32 - 5 == 27 (0x1b)
  assert(cx9.buf.code[1] == u8(0x1B) && cx9.buf.code[2] == u8(0))
  // jcc's field at 7: 0 - 11 == -11 (0xf5)
  assert(cx9.buf.code[7] == u8(0xF5) && cx9.buf.code[8] == u8(0xFF))
}

fn checkX64Frame() {
  // sub $0x1234, %rsp -> 48 81 ec 34 12 00 00 ; add -> 48 81 c4 ...
  // (the assembler shortens to the imm8 form for small values; this always
  // emits imm32, so the golden uses a value that forces imm32 either way).
  let b = newX64Buf()
  xRspAddSub(b, true, 0x1234)
  assert(xHex(b) == "4881ec34120000")
  let b2 = newX64Buf()
  xRspAddSub(b2, false, 0x1234)
  assert(xHex(b2) == "4881c434120000")
  // sub and add differ only by the ModRM digit (/5 vs /0) — swapping them grows
  // the stack where it should shrink.
  assert(xHex(b) != xHex(b2))

  // The 16-byte alignment rule. `push rbp` leaves rsp 16-aligned; each further
  // saved push shifts it by 8. So with an EVEN number of saved pushes the frame
  // must be 0 mod 16, and with an ODD number it must be 8 mod 16 to bring rsp
  // back to 16-aligned for any call in the body.
  //
  // This is not cosmetic: SysV requires 16-alignment at a call, and libc's SSE
  // instructions fault on a misaligned stack — so an off-by-8 frame crashes
  // inside someone else's code, far from the cause.
  assert(xAlignFrame(0, 0) == 0)
  assert(xAlignFrame(16, 0) == 16)
  assert(xAlignFrame(8, 0) == 16)   // even saves: round 8 up to 16
  assert(xAlignFrame(1, 0) == 16)
  assert(xAlignFrame(17, 0) == 32)
  assert(xAlignFrame(0, 1) == 8)    // odd saves: 0 must become 8
  assert(xAlignFrame(8, 1) == 8)
  assert(xAlignFrame(16, 1) == 24)
  assert(xAlignFrame(9, 1) == 24)
  assert(xAlignFrame(24, 2) == 32)  // even again
  assert(xAlignFrame(24, 3) == 24)  // odd: already 8 mod 16

  // Every result must actually land rsp 16-aligned. push rbp + savedCount
  // pushes + frameSize, measured from a 16-aligned rsp at entry minus the
  // 8-byte return address the call pushed.
  let saved = 0
  while (saved < 6) {
    let raw = 0
    while (raw < 40) {
      let f = xAlignFrame(raw, saved)
      assert(f >= raw)
      // 8 (retaddr) + 8 (push rbp) + 8*saved + f must be 0 mod 16.
      assert((8 + 8 + 8 * saved + f) % 16 == 0)
      raw = raw + 1
    }
    saved = saved + 1
  }
}

fn checkX64FrameOffsets() {
  // Slots are laid out downward from rbp: saved GPRs, then spills, then XMMs.
  // All rbp-relative, which is what keeps the GC's stack walker arch-neutral.
  let f = XFrame{ savedGpr: [XReg64.Rbx, XReg64.R13], savedXmm: [XmmReg.Xmm6],
    numSpillSlots: 3, frameSize: 64 }
  // Two saved GPRs occupy rbp-8 and rbp-16, so spill 0 starts at rbp-24.
  assert(xSpillOffset(f, 0) == -24)
  assert(xSpillOffset(f, 1) == -32)
  assert(xSpillOffset(f, 2) == -40)
  // The XMMs sit below the GPRs AND the spills: 16 + 24 = 40, so xmm 0 is -48.
  assert(xXmmSaveOffset(f, 0) == -48)

  // No saved registers: spill 0 sits directly below rbp.
  let f2 = XFrame{ savedGpr: []XReg64(0), savedXmm: []XmmReg(0), numSpillSlots: 2,
    frameSize: 16 }
  assert(xSpillOffset(f2, 0) == -8)
  assert(xXmmSaveOffset(f2, 0) == -24) // below the two spill slots

  // Regions must never overlap — an overlap silently corrupts a spilled value
  // when a callee-saved register is stashed on top of it.
  let f3 = XFrame{ savedGpr: [XReg64.Rbx], savedXmm: [XmmReg.Xmm6, XmmReg.Xmm7],
    numSpillSlots: 2, frameSize: 64 }
  assert(xSpillOffset(f3, 0) == -16 && xSpillOffset(f3, 1) == -24)
  assert(xXmmSaveOffset(f3, 0) == -32 && xXmmSaveOffset(f3, 1) == -40)
  assert(xXmmSaveOffset(f3, 0) < xSpillOffset(f3, f3.numSpillSlots - 1))
}

fn checkX64RegOf() {
  // xRegOf/xXmmOf are the inverse of xRegNum/xmmNum. If they ever disagree,
  // every register arriving as a raw number (regalloc's results, PLoc) lands on
  // the wrong physical register — silently.
  let i = 0
  while (i < 16) {
    assert(xRegNum(xRegOf(i)) == i)
    assert(xmmNum(xXmmOf(i)) == i)
    i = i + 1
  }
  assert(xRegOf(0) == XReg64.Rax && xRegOf(15) == XReg64.R15)
  assert(xXmmOf(0) == XmmReg.Xmm0 && xXmmOf(15) == XmmReg.Xmm15)
}

fn checkX64FloatMoves() {
  // movsd %xmm1, %xmm0 -> f2 0f 10 c1 ; a self-move encodes nothing.
  let b = newX64Buf()
  xMovFRR(b, XmmReg.Xmm0, XmmReg.Xmm1, 8)
  assert(xHex(b) == "f20f10c1")
  let b2 = newX64Buf()
  xMovFRR(b2, XmmReg.Xmm0, XmmReg.Xmm0, 8)
  assert(len(b2.code) == 0)

  // Load is 0F 10, store is 0F 11 — the same instruction with the direction bit
  // flipped. Using 0x10 for a store READS the destination instead of writing
  // it, which loses the value and leaves the slot untouched.
  let b3 = newX64Buf()
  xMovFLoad(b3, XmmReg.Xmm0, xMemB(XReg64.Rbp, -8), 8)
  let b4 = newX64Buf()
  xMovFStore(b4, xMemB(XReg64.Rbp, -8), XmmReg.Xmm0, 8)
  assert(b3.code[2] == u8(0x10) && b4.code[2] == u8(0x11))
  assert(xHex(b3) != xHex(b4))
}

fn checkX64ParallelMoves() {
  // A plain move nothing else reads: emitted directly, no scratch.
  let cx = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx, [PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(1, RegClass.Int) }])
  assert(xHex(cx.buf) == "4889c1") // mov %rax, %rcx

  // A self-move is dropped entirely.
  let cx2 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx2, [PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(0, RegClass.Int) }])
  assert(len(cx2.buf.code) == 0)

  // A chain must be ordered so the value is read before it is overwritten:
  // rax->rcx must be emitted BEFORE rdx->rax, or rax is clobbered first.
  let cx3 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx3, [PMove{ src: plocReg(2, RegClass.Int), dst: plocReg(0, RegClass.Int) },
    PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(1, RegClass.Int) }])
  // mov %rax, %rcx (48 89 c1) then mov %rdx, %rax (48 89 d0)
  assert(xHex(cx3.buf) == "4889c14889d0")

  // A two-cycle (a swap) cannot be ordered at all and must rotate through the
  // scratch. The exact sequence, pinned: save rcx into the SECONDARY scratch
  // (r10), move rax->rcx, then restore r10 into rax.
  //   mov %rcx, %r10  -> 49 89 ca
  //   mov %rax, %rcx  -> 48 89 c1
  //   mov %r10, %rax  -> 4c 89 d0
  // Rotating through the PRIMARY scratch (r11) would encode 49 89 cb / 4c 89 d8
  // instead — which is the #1235 bug, and this is what catches it.
  let cx4 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx4, [PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(1, RegClass.Int) },
    PMove{ src: plocReg(1, RegClass.Int), dst: plocReg(0, RegClass.Int) }])
  assert(xHex(cx4.buf) == "4989ca4889c14c89d0")

  // THE #1235 TRAP: a cycle whose members are SPILLED. A mem->mem move routes
  // through the PRIMARY scratch, so a cycle rotating through the primary would
  // have its saved value overwritten by the first mem->mem step and resolve to
  // garbage — a spilled loop-carried value swapped on a back-edge, silently
  // corrupted. The cycle must use the SECONDARY scratch.
  let cx5 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx5, [PMove{ src: plocMem(-8, RegClass.Int), dst: plocMem(-16, RegClass.Int) },
    PMove{ src: plocMem(-16, RegClass.Int), dst: plocMem(-8, RegClass.Int) }])
  // The saved value must still be live when it is written back. Assert the
  // scratch that holds it across the rotation is never the mem->mem temp:
  assert(xScratch1() != xScratch2())
  assert(xFScratch1() != xFScratch2())
  // ...and that something was actually emitted (a dropped cycle is silent).
  assert(len(cx5.buf.code) > 0)

  // A float cycle rotates through the float scratch, not the int one.
  let cx6 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx6, [PMove{ src: plocReg(0, RegClass.Float), dst: plocReg(1, RegClass.Float) },
    PMove{ src: plocReg(1, RegClass.Float), dst: plocReg(0, RegClass.Float) }])
  assert(len(cx6.buf.code) > 0)
  assert(cx6.buf.code[0] == u8(0xF2)) // movsd, not a GPR mov

  // #3182: a single call carrying BOTH classes at once must produce the exact
  // same bytes as the two independent one-class calls above interleaved in
  // call order — merging must not perturb same-class ordering or scratch
  // choice. Concatenates the rax/rcx/rdx chain case with the float-cycle case
  // into one movesIn list.
  let cx7 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(cx7, [PMove{ src: plocReg(2, RegClass.Int), dst: plocReg(0, RegClass.Int) },
    PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(1, RegClass.Int) },
    PMove{ src: plocReg(0, RegClass.Float), dst: plocReg(1, RegClass.Float) },
    PMove{ src: plocReg(1, RegClass.Float), dst: plocReg(0, RegClass.Float) }])
  assert(len(cx7.buf.code) > 0)
  assert(cx7.buf.code[0] == u8(0x48)) // the int move drains first here
}

fn checkX64ArgRegs() {
  // SysV: six integer args in rdi, rsi, rdx, rcx, r8, r9; the seventh spills.
  let sv = XCallConv.SysV
  assert(xArgReg(sv, RegClass.Int, 0, 0) == xRegNum(XReg64.Rdi))
  assert(xArgReg(sv, RegClass.Int, 1, 1) == xRegNum(XReg64.Rsi))
  assert(xArgReg(sv, RegClass.Int, 2, 2) == xRegNum(XReg64.Rdx))
  assert(xArgReg(sv, RegClass.Int, 3, 3) == xRegNum(XReg64.Rcx))
  assert(xArgReg(sv, RegClass.Int, 4, 4) == xRegNum(XReg64.R8))
  assert(xArgReg(sv, RegClass.Int, 5, 5) == xRegNum(XReg64.R9))
  assert(xArgReg(sv, RegClass.Int, 6, 6) == -1) // spills to the stack
  // SysV takes eight float args.
  assert(xArgReg(sv, RegClass.Float, 0, 0) == 0)
  assert(xArgReg(sv, RegClass.Float, 7, 7) == 7)
  assert(xArgReg(sv, RegClass.Float, 8, 8) == -1)

  // Win64: four integer args in rcx, rdx, r8, r9; the fifth spills.
  let w = XCallConv.Win64
  assert(xArgReg(w, RegClass.Int, 0, 0) == xRegNum(XReg64.Rcx))
  assert(xArgReg(w, RegClass.Int, 1, 1) == xRegNum(XReg64.Rdx))
  assert(xArgReg(w, RegClass.Int, 2, 2) == xRegNum(XReg64.R8))
  assert(xArgReg(w, RegClass.Int, 3, 3) == xRegNum(XReg64.R9))
  assert(xArgReg(w, RegClass.Int, 4, 4) == -1)
  assert(xArgReg(w, RegClass.Float, 3, 3) == 3)
  assert(xArgReg(w, RegClass.Float, 4, 4) == -1)

  // THE divergence. Consider f(int, float, int) — positions 0,1,2 with
  // per-class ordinals 0,0,1.
  //
  // SysV counts the banks INDEPENDENTLY: rdi, xmm0, rsi.
  assert(xArgReg(sv, RegClass.Int, 0, 0) == xRegNum(XReg64.Rdi))
  assert(xArgReg(sv, RegClass.Float, 1, 0) == 0)      // xmm0 — float ordinal 0
  assert(xArgReg(sv, RegClass.Int, 2, 1) == xRegNum(XReg64.Rsi)) // int ordinal 1
  //
  // Win64 indexes by POSITION, the banks SHARING slots: rcx, xmm1, r8. The
  // float at position 1 consumes the slot rdx would have taken, and the third
  // argument therefore lands in r8, NOT rdx.
  assert(xArgReg(w, RegClass.Int, 0, 0) == xRegNum(XReg64.Rcx))
  assert(xArgReg(w, RegClass.Float, 1, 0) == 1)       // xmm1 — by POSITION
  assert(xArgReg(w, RegClass.Int, 2, 1) == xRegNum(XReg64.R8))
  // The two rules must disagree here — that is the whole point.
  assert(xArgReg(sv, RegClass.Float, 1, 0) != xArgReg(w, RegClass.Float, 1, 0))
}

fn checkX64StackArgs() {
  // The outgoing area keeps rsp 16-aligned at the call: SysV needs it, and
  // libc's SSE faults otherwise.
  assert(xStackReserve(0) == 0)
  assert(xStackReserve(1) == 16) // 8 rounded up
  assert(xStackReserve(2) == 16)
  assert(xStackReserve(3) == 32)
  assert(xStackReserve(4) == 32)
  let n = 0
  while (n < 12) {
    assert(xStackReserve(n) % 16 == 0)
    assert(xStackReserve(n) >= 8 * n)
    n = n + 1
  }

  // Win64 makes the CALLER reserve 32 bytes of shadow space the callee may
  // freely use to spill its four register arguments; omitting it lets the
  // callee scribble over the caller's frame. SysV has no such area.
  assert(xShadowSpace(XCallConv.Win64) == 32)
  assert(xShadowSpace(XCallConv.SysV) == 0)

  // A register source stores straight to the outgoing area; a spilled source
  // must be loaded through scratch first (there is no mem->mem store).
  let cx = newXCtx(XCallConv.SysV)
  xEmitStackArgStore(cx, XStackArg{ src: plocReg(0, RegClass.Int), class: RegClass.Int, offset: 0 })
  // mov %rax, 0(%rsp) — rsp forces a SIB byte: 48 89 84 24 00000000
  assert(xHex(cx.buf) == "4889842400000000")

  let cx2 = newXCtx(XCallConv.SysV)
  xEmitStackArgStore(cx2, XStackArg{ src: plocMem(-8, RegClass.Int), class: RegClass.Int, offset: 8 })
  // Two instructions: a load from rbp-8 into the scratch, then a store to
  // rsp+8. The load's prefix is 4c, not 48 — scratch1 is r11, so REX.R is set.
  // {disp32} mov -8(%rbp), %r11 -> 4c 8b 9d f8 ff ff ff
  assert(len(cx2.buf.code) > 8)
  assert(cx2.buf.code[0] == u8(0x4C) && cx2.buf.code[1] == u8(0x8B)) // load first
  assert(xHex(cx2.buf)[0:14] == "4c8b9df8ffffff")
}

fn checkX64RegFile() {
  let none = XFuncFlags{ hasSafepoints: false, needsRaxRdx: false, needsRcx: false }
  // No constraints: the whole master file is allocatable.
  let all = xBuildIntRegs(XCallConv.SysV, none)
  assert(len(all) == xMaxIntRegs())

  // A division fixes rax and rdx as idiv/div operands, so neither may hold a
  // vreg — the allocator would otherwise hand one out and the division would
  // silently destroy it.
  let dv = XFuncFlags{ hasSafepoints: false, needsRaxRdx: true, needsRcx: false }
  let dregs = xBuildIntRegs(XCallConv.SysV, dv)
  for r of dregs {
    assert(r != XReg64.Rax && r != XReg64.Rdx)
  }
  assert(len(dregs) == xMaxIntRegs() - 2)

  // A variable shift needs cl — the ONLY variable shift count on x86-64.
  let sh = XFuncFlags{ hasSafepoints: false, needsRaxRdx: false, needsRcx: true }
  let sregs = xBuildIntRegs(XCallConv.SysV, sh)
  for r of sregs {
    assert(r != XReg64.Rcx)
  }
  assert(len(sregs) == xMaxIntRegs() - 1)

  // A function with ANY safepoint is restricted to callee-saved registers, so
  // no vreg can live in a call-clobbered one and a call needs no save sequence.
  let sp = XFuncFlags{ hasSafepoints: true, needsRaxRdx: false, needsRcx: false }
  let spregs = xBuildIntRegs(XCallConv.SysV, sp)
  assert(len(spregs) > 0)
  for r of spregs {
    assert(xIsCalleeSavedInt(XCallConv.SysV, r))
  }
  // SysV callee-saved among the master list: rbx, r13, r14, r15.
  assert(len(spregs) == 4)
  // Win64 preserves rsi/rdi too, so its restricted file is larger.
  let wregs = xBuildIntRegs(XCallConv.Win64, sp)
  assert(len(wregs) == 6)

  // The restricted file already excludes rax/rdx/rcx, which is why the
  // division/shift exclusions are only applied on the other branch. Assert that
  // rather than trust it.
  let both = XFuncFlags{ hasSafepoints: true, needsRaxRdx: true, needsRcx: true }
  for cc of [XCallConv.SysV, XCallConv.Win64] {
    for r of xBuildIntRegs(cc, both) {
      assert(r != XReg64.Rax && r != XReg64.Rdx && r != XReg64.Rcx)
    }
  }
}

fn checkX64FloatRegFile() {
  // No safepoints: xmm0..xmm13 are allocatable (xmm14/15 are scratch).
  let all = xBuildFloatRegs(XCallConv.SysV, false)
  assert(len(all) == xMaxFloatRegs())
  for x of all {
    assert(x != xFScratch1() && x != xFScratch2())
  }

  // SysV preserves NO xmm, so a function with any safepoint has no allocatable
  // float register at all — every float vreg in such a function spills.
  let sv = xBuildFloatRegs(XCallConv.SysV, true)
  assert(len(sv) == 0)

  // Win64 preserves xmm6..xmm15, so xmm6..xmm13 remain (14/15 stay scratch).
  let w = xBuildFloatRegs(XCallConv.Win64, true)
  assert(len(w) == 8)
  for x of w {
    assert(xIsCalleeSavedFloat(XCallConv.Win64, x))
    assert(x != xFScratch1() && x != xFScratch2())
  }
  assert(w[0] == XmmReg.Xmm6 && w[7] == XmmReg.Xmm13)
}
