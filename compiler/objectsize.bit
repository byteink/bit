// Object byte buffers and virtual zero-fill spans have different ceilings.
fn objectByteLimit(): int { return 0x4000000000000000 }

fn objectAdd(x: int, y: int, maximum: int): int! {
  if (x < 0 || y < 0 || x > maximum || y > maximum - x) {
    fail newError("ObjectSizeOverflow")
  }
  return x + y
}

fn objectMul(x: int, y: int, maximum: int): int! {
  if (x < 0 || y < 0 || maximum < 0) {
    fail newError("ObjectSizeOverflow")
  }
  if (y != 0 && x > maximum / y) {
    fail newError("ObjectSizeOverflow")
  }
  return x * y
}

fn objectAlign(cursor: int, alignment: int, maximum: int): int! {
  if (cursor < 0 || cursor > maximum || alignment <= 0) {
    fail newError("ObjectSizeOverflow")
  }
  if ((alignment & (alignment - 1)) != 0) {
    fail newError("ObjectSizeOverflow")
  }
  let rem = cursor % alignment
  if (rem == 0) {
    return cursor
  }
  return objectAdd(cursor, alignment - rem, maximum)?
}

fn objectGlobalEnd(cursor: int, size: int, alignment: int, maximum: int): int! {
  // Each authored image is an []int allocation, independently of its output section.
  objectMul(size, 8, storageBodyLimit())?
  let off = objectAlign(cursor, alignment, maximum)?
  return objectAdd(off, size, maximum)?
}

fn objectFixupOffset(size: int, offset: int, base: int): int! {
  if (!loRangeOk(size, offset, 8)) {
    fail newError("ObjectSizeOverflow")
  }
  return objectAdd(base, offset, objectByteLimit())?
}
