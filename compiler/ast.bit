// Self-host Stage 1 (#1333): the AST node arena.
// Same index-based design — nodes live in one growable array, their children in
// a shared `extra` pool referenced by (kidsStart, kidsLen); index 0 is the
// reserved `none` sentinel (an absent optional child). Node.main is a tag-
// specific scalar (the operator's Kind for binary/unary, else 0).
//
// Tag is a representative subset for now; it grows as the parser ports (#1335).
// Span comes from compiler/diagnostics.bit (same module).

enum Tag {
  None,
  // leaves
  Ident,
  IntLit,
  FloatLit,
  StringLit,
  RawStringLit,
  RuneLit,
  BoolLit,
  NilLit,
  // declarations
  Program,
  ConstDecl,
  LetDecl,
  Binding,
  FuncDecl,
  AttrList,
  Attr,
  ExternFnDecl,
  Params,
  Param,
  // A variadic parameter `...name: T`. Its type kid is the ELEMENT type T; the
  // body binds the name as `[]T` (§10.3), which is where the two differ.
  ParamRest,
  // statements
  Block,
  ReturnStmt,
  ExprStmt,
  // expressions
  Binary,
  Unary,
  Call,
  Args,
  Arg,
  Member,
  // more declarations
  Export,
  ImportDecl,
  ImportNs,
  ImportStar,
  ImportGroup,
  ImportItem,
  TypeAlias,
  StructDecl,
  FieldList,
  Field,
  EnumDecl,
  VariantList,
  EnumVariant,
  TypeList,
  InterfaceDecl,
  MethodSigList,
  MethodSig,
  // generics + types
  GenericParams,
  GenericParam,
  Constraint,
  GenericInst,
  TypeArgs,
  PtrType,
  SliceType,
  ArrayType,
  MapType,
  ChanType,
  // A namespace-qualified type name in TYPE position (`io.Writer`, #2118):
  // `[ns_ident, name_ident]`, mirroring `Member`'s shape for the expression-
  // position spelling of the same dotted reference.
  QualType,
  Fallible,
  // more expressions
  StrPart,
  StrInterp,
  TryExpr,
  Index,
  SliceExpr,
  TypeAssert,
  TupleIndex,
  ArgSpread,
  // `name = expression` at a CALL site (SPEC §12.11, #3839): `[nameIdent,
  // valueExpr]`. Legal only in `call_args` (parserexpr.bit's
  // `parseCallArgItem`), never in the `arguments` list a bare slice literal or
  // an array/slice-type conversion call shares with it — neither has a callee
  // to name a parameter against.
  NamedArg,
  SliceLit,
  // A tuple literal `(a, b, ...)` (SPEC §12.10, #4105): two or more elements,
  // sibling of `TupleType`/`TuplePat` — same arity rule, the missing third
  // spelling (type / pattern / literal) of one tuple representation.
  TupleLit,
  CompositeLit,
  FieldInits,
  FieldInit,
  CatchBind,
  CatchDefault,
  // statements / control flow
  IfStmt,
  WhileStmt,
  ForOf,
  ForIn,
  ForC,
  ForInf,
  BreakStmt,
  ContinueStmt,
  FailStmt,
  SpawnStmt,
  DeferStmt,
  AsmStmt,
  AsmCode,
  AsmResult,
  AsmInput,
  AsmClobber,
  IncStmt,
  DecStmt,
  SendStmt,
  Assign,
  LhsList,
  ExprList,
  // match + patterns
  MatchStmt,
  ArmList,
  MatchArm,
  VariantPat,
  TuplePat,
  // A for-of field pattern `{ a, b, ... }` (SPEC §12.6, #4106): destructures
  // a slice/array element by field NAME rather than position. Kids are plain
  // Ident leaves, one per named field — never nested, unlike `TuplePat`'s
  // `pat = IDENT | "_" | tuple_pat`.
  FieldPat,
  // methods + arrows
  Receiver,
  ArrowFn,
  ArrowParams,
  ArrowP,
  FuncType,
  TupleType,
  VoidType,
  MapEntries,
  MapEntry,
  // select / switch
  SelectStmt,
  CommCase,
  CommDefault,
  SwitchStmt,
  CaseList,
  SwitchCase,
  SwitchDefault,
  StmtList,
  RecvBind,
  // Traits (SPEC §10.7, #3369): a `trait` declaration, its member list, one
  // member (a required signature with no body, or a provided one with a
  // body), and the `use` statement that injects a trait's methods into a
  // class body.
  TraitDecl,
  TraitMemberList,
  TraitMethod,
  UseStmt,
  // `test "name" { ... }` (SPEC §19, epic #4126, #4127): `[name, body]`, a
  // string-literal name and an ordinary block, valid only at top level of a
  // `.test.bit` file (parserdecl.bit's atTestDecl/parseTestDecl enforce the
  // position, validateattr.bit's vTestDecl the file).
  TestDecl,
  // `cond ? a : b` (SPEC §12, #3941): `[cond, then, else]`, right-associative,
  // between `=>` and `||` — see parserexpr.bit's parseConditional.
  CondExpr,
}

class Node {
  tag: Tag,
  span: Span,
  main: int,
  kidsStart: int,
  kidsLen: int,
}

class Tree {
  nodes: []Node,
  extra: []int,
  root: int,
}

// A fresh tree with the reserved `none` node installed at index 0, so every real
// node has a nonzero index and 0 reads as "absent".
fn newTree(): Tree {
  let none = Node{ tag: Tag.None, span: pointSpan(0, 0), main: 0, kidsStart: 0, kidsLen: 0 }
  return Tree{ nodes: append([]Node(0), none), extra: []int(0), root: 0 }
}

// Appends a node whose children are `kids`, returning its index. The children
// are copied into the shared `extra` pool. Tree is a reference, so both slices
// grow in place.
fn addNode(t: Tree, tag: Tag, span: Span, main: int, kids: []int): int {
  let start = len(t.extra)
  let i = 0
  while (i < len(kids)) {
    t.extra = append(t.extra, kids[i])
    i = i + 1
  }
  let id = len(t.nodes)
  t.nodes = append(t.nodes, Node{ tag: tag, span: span, main: main, kidsStart: start, kidsLen: len(kids) })
  return id
}

// A leaf node (no children); the text is the source slice under `span`.
fn addLeaf(t: Tree, tag: Tag, span: Span): int {
  return addNode(t, tag, span, 0, []int(0))
}

// Rolls the arena back to a mark taken before a speculative parse (#4193),
// mirroring `truncateDiags` (compiler/diagnostics.bit) and `undoSplits`
// (compiler/parser.bit): the caller reads `len(t.nodes)`/`len(t.extra)`
// before the speculative attempt and passes them back here on rollback.
// Safe because `addNode` only ever appends and a node's kids are always
// built (and thus indexed) before the node itself, so nothing at or after
// `nodeMark`/`extraMark` can be referenced by anything before it.
fn truncateNodes(t: Tree, nodeMark: int, extraMark: int) {
  t.nodes = t.nodes[0:nodeMark]
  t.extra = t.extra[0:extraMark]
}

fn getNode(t: Tree, idx: int): Node {
  return t.nodes[idx]
}

// The child indices of node `idx`, a view into the `extra` pool.
fn kidsOf(t: Tree, idx: int): []int {
  let n = t.nodes[idx]
  return t.extra[n.kidsStart:n.kidsStart + n.kidsLen]
}

// Strips the surrounding quotes from a string_lit leaf's raw source text.
// String-literal text, including its guard:
// a node the parser could not fill in is the `none` poison (index 0), whose
// span is empty, so the quotes it appears to have must not be assumed. Slicing
// one off unconditionally underflows to `source[1:-1]` and kills the process.
fn stringLitText(source: string, sp: Span): string {
  let raw = source[sp.start:sp.end]
  if (len(raw) >= 2 && raw[0:1] == "\"" && raw[len(raw) - 1:len(raw)] == "\"") {
    return raw[1:len(raw) - 1]
  }
  return raw
}

// ---- s-expression dump (matches ast.dump) ---------------

// The seed's @tagName for a non-leaf node.
fn tagName(tag: Tag): string {
  if (tag == Tag.Program) { return "program" }
  if (tag == Tag.ConstDecl) { return "const_decl" }
  if (tag == Tag.LetDecl) { return "let_decl" }
  if (tag == Tag.Binding) { return "binding" }
  if (tag == Tag.FuncDecl) { return "func_decl" }
  if (tag == Tag.AttrList) { return "attr_list" }
  if (tag == Tag.Attr) { return "attr" }
  if (tag == Tag.ExternFnDecl) { return "extern_fn_decl" }
  if (tag == Tag.Params) { return "params" }
  if (tag == Tag.Param) { return "param" }
  if (tag == Tag.ParamRest) { return "param_rest" }
  if (tag == Tag.Block) { return "block" }
  if (tag == Tag.ReturnStmt) { return "return_stmt" }
  if (tag == Tag.ExprStmt) { return "expr_stmt" }
  if (tag == Tag.Binary) { return "binary" }
  if (tag == Tag.Unary) { return "unary" }
  if (tag == Tag.Call) { return "call" }
  if (tag == Tag.Args) { return "args" }
  if (tag == Tag.Arg) { return "arg" }
  if (tag == Tag.Member) { return "member" }
  if (tag == Tag.Export) { return "export" }
  if (tag == Tag.ImportDecl) { return "import_decl" }
  if (tag == Tag.ImportNs) { return "import_ns" }
  if (tag == Tag.ImportStar) { return "import_star" }
  if (tag == Tag.ImportGroup) { return "import_group" }
  if (tag == Tag.ImportItem) { return "import_item" }
  if (tag == Tag.TypeAlias) { return "type_alias" }
  if (tag == Tag.StructDecl) { return "struct_decl" }
  if (tag == Tag.FieldList) { return "field_list" }
  if (tag == Tag.Field) { return "field" }
  if (tag == Tag.EnumDecl) { return "enum_decl" }
  if (tag == Tag.VariantList) { return "variant_list" }
  if (tag == Tag.EnumVariant) { return "enum_variant" }
  if (tag == Tag.TypeList) { return "type_list" }
  if (tag == Tag.InterfaceDecl) { return "interface_decl" }
  if (tag == Tag.MethodSigList) { return "method_sig_list" }
  if (tag == Tag.MethodSig) { return "method_sig" }
  if (tag == Tag.GenericParams) { return "generic_params" }
  if (tag == Tag.GenericParam) { return "generic_param" }
  if (tag == Tag.Constraint) { return "constraint" }
  if (tag == Tag.GenericInst) { return "generic_inst" }
  if (tag == Tag.TypeArgs) { return "type_args" }
  if (tag == Tag.PtrType) { return "ptr_type" }
  if (tag == Tag.SliceType) { return "slice_type" }
  if (tag == Tag.ArrayType) { return "array_type" }
  if (tag == Tag.MapType) { return "map_type" }
  if (tag == Tag.ChanType) { return "chan_type" }
  if (tag == Tag.QualType) { return "qual_type" }
  if (tag == Tag.Fallible) { return "fallible" }
  if (tag == Tag.StrInterp) { return "str_interp" }
  if (tag == Tag.TryExpr) { return "try_expr" }
  if (tag == Tag.Index) { return "index" }
  if (tag == Tag.SliceExpr) { return "slice_expr" }
  if (tag == Tag.TypeAssert) { return "type_assert" }
  if (tag == Tag.TupleIndex) { return "tuple_index" }
  if (tag == Tag.ArgSpread) { return "arg_spread" }
  if (tag == Tag.NamedArg) { return "named_arg" }
  if (tag == Tag.SliceLit) { return "slice_lit" }
  if (tag == Tag.CompositeLit) { return "composite_lit" }
  if (tag == Tag.FieldInits) { return "field_inits" }
  if (tag == Tag.FieldInit) { return "field_init" }
  if (tag == Tag.CatchBind) { return "catch_bind" }
  if (tag == Tag.CatchDefault) { return "catch_default" }
  if (tag == Tag.IfStmt) { return "if_stmt" }
  if (tag == Tag.WhileStmt) { return "while_stmt" }
  if (tag == Tag.ForOf) { return "for_of" }
  if (tag == Tag.ForIn) { return "for_in" }
  if (tag == Tag.ForC) { return "for_c" }
  if (tag == Tag.ForInf) { return "for_inf" }
  if (tag == Tag.BreakStmt) { return "break_stmt" }
  if (tag == Tag.ContinueStmt) { return "continue_stmt" }
  if (tag == Tag.FailStmt) { return "fail_stmt" }
  if (tag == Tag.SpawnStmt) { return "spawn_stmt" }
  if (tag == Tag.DeferStmt) { return "defer_stmt" }
  if (tag == Tag.AsmStmt) { return "asm_stmt" }
  if (tag == Tag.AsmCode) { return "asm_code" }
  if (tag == Tag.AsmResult) { return "asm_result" }
  if (tag == Tag.AsmInput) { return "asm_input" }
  if (tag == Tag.AsmClobber) { return "asm_clobber" }
  if (tag == Tag.IncStmt) { return "inc_stmt" }
  if (tag == Tag.DecStmt) { return "dec_stmt" }
  if (tag == Tag.SendStmt) { return "send_stmt" }
  if (tag == Tag.Assign) { return "assign" }
  if (tag == Tag.LhsList) { return "lhs_list" }
  if (tag == Tag.ExprList) { return "expr_list" }
  if (tag == Tag.MatchStmt) { return "match_stmt" }
  if (tag == Tag.ArmList) { return "arm_list" }
  if (tag == Tag.MatchArm) { return "match_arm" }
  if (tag == Tag.VariantPat) { return "variant_pat" }
  if (tag == Tag.TuplePat) { return "tuple_pat" }
  if (tag == Tag.Receiver) { return "receiver" }
  if (tag == Tag.ArrowFn) { return "arrow_fn" }
  if (tag == Tag.ArrowParams) { return "arrow_params" }
  if (tag == Tag.ArrowP) { return "arrow_p" }
  if (tag == Tag.FuncType) { return "func_type" }
  if (tag == Tag.TupleType) { return "tuple_type" }
  if (tag == Tag.VoidType) { return "void_type" }
  if (tag == Tag.MapEntries) { return "map_entries" }
  if (tag == Tag.MapEntry) { return "map_entry" }
  if (tag == Tag.SelectStmt) { return "select_stmt" }
  if (tag == Tag.CommCase) { return "comm_case" }
  if (tag == Tag.CommDefault) { return "comm_default" }
  if (tag == Tag.SwitchStmt) { return "switch_stmt" }
  if (tag == Tag.CaseList) { return "case_list" }
  if (tag == Tag.SwitchCase) { return "switch_case" }
  if (tag == Tag.SwitchDefault) { return "switch_default" }
  if (tag == Tag.StmtList) { return "stmt_list" }
  if (tag == Tag.RecvBind) { return "recv_bind" }
  if (tag == Tag.TraitDecl) { return "trait_decl" }
  if (tag == Tag.TraitMemberList) { return "trait_member_list" }
  if (tag == Tag.TraitMethod) { return "trait_method" }
  if (tag == Tag.UseStmt) { return "use_stmt" }
  return tagNameExtra(tag)
}

// The tail of `tagName`'s if-chain, split out purely to keep that function's
// own McCabe complexity from growing every time a new Tag joins the enum
// (spec/LINT.md E0204, tools/build/complexity-debt.txt's baseline for
// `tagName`) -- each new arm here costs this function +1, never `tagName`'s.
fn tagNameExtra(tag: Tag): string {
  if (tag == Tag.TestDecl) { return "test_decl" }
  if (tag == Tag.CondExpr) { return "cond_expr" }
  if (tag == Tag.TupleLit) { return "tuple_lit" }
  if (tag == Tag.FieldPat) { return "field_pat" }
  return "?"
}

// True for a leaf that renders as its source text (not `(tag ...)`).
fn isLeafTag(tag: Tag): bool {
  return tag == Tag.Ident || tag == Tag.IntLit || tag == Tag.FloatLit ||
    tag == Tag.StringLit || tag == Tag.RawStringLit || tag == Tag.RuneLit ||
    tag == Tag.BoolLit || tag == Tag.NilLit
}

// The glyph for a binary/unary operator, whose Kind (§lexer) is stored as an int
// in `Node.main`. Compared against `int(Kind.X)` (C-like enum -> int, §12.9).
fn opSymbol(m: int): string {
  if (m == int(Kind.Plus)) { return "+" }
  if (m == int(Kind.Minus)) { return "-" }
  if (m == int(Kind.Star)) { return "*" }
  if (m == int(Kind.Slash)) { return "/" }
  if (m == int(Kind.Percent)) { return "%" }
  if (m == int(Kind.Amp)) { return "&" }
  if (m == int(Kind.Pipe)) { return "|" }
  if (m == int(Kind.Caret)) { return "^" }
  if (m == int(Kind.Shl)) { return "<<" }
  if (m == int(Kind.Shr)) { return ">>" }
  if (m == int(Kind.Tilde)) { return "~" }
  if (m == int(Kind.AmpAmp)) { return "&&" }
  if (m == int(Kind.PipePipe)) { return "||" }
  if (m == int(Kind.Bang)) { return "!" }
  if (m == int(Kind.EqEq)) { return "==" }
  if (m == int(Kind.BangEq)) { return "!=" }
  if (m == int(Kind.Lt)) { return "<" }
  if (m == int(Kind.LtEq)) { return "<=" }
  if (m == int(Kind.Gt)) { return ">" }
  if (m == int(Kind.GtEq)) { return ">=" }
  if (m == int(Kind.ArrowLeft)) { return "<-" }
  if (m == int(Kind.Eq)) { return "=" }
  if (m == int(Kind.PlusEq)) { return "+=" }
  if (m == int(Kind.MinusEq)) { return "-=" }
  if (m == int(Kind.StarEq)) { return "*=" }
  if (m == int(Kind.SlashEq)) { return "/=" }
  if (m == int(Kind.PercentEq)) { return "%=" }
  if (m == int(Kind.AmpEq)) { return "&=" }
  if (m == int(Kind.PipeEq)) { return "|=" }
  if (m == int(Kind.CaretEq)) { return "^=" }
  if (m == int(Kind.ShlEq)) { return "<<=" }
  if (m == int(Kind.ShrEq)) { return ">>=" }
  return "?"
}

// Recursively renders node `idx`: `_` for none, source text for a leaf, else
// `(tag kids...)` with the operator glyph after `binary`/`unary`.
fn dumpNode(t: Tree, src: string, idx: int): string {
  if (idx == 0) {
    return "_"
  }
  let n = getNode(t, idx)
  if (isLeafTag(n.tag)) {
    return src[n.span.start:n.span.end]
  }
  // A str_part renders quoted so empty chunks (`""`) are visible.
  if (n.tag == Tag.StrPart) {
    return "\"" + src[n.span.start:n.span.end] + "\""
  }
  let out = "(" + tagName(n.tag)
  if (n.tag == Tag.Binary || n.tag == Tag.Unary || n.tag == Tag.Assign) {
    out = out + " " + opSymbol(n.main)
  }
  // Only a `@threadlocal` declaration prints anything, so every existing dump
  // stays byte-identical while the §11.11 storage class stays visible to the
  // seed-vs-selfhost differential.
  if (n.tag == Tag.LetDecl || n.tag == Tag.ConstDecl) {
    if (n.main == 1) {
      out = out + " @threadlocal"
    }
  }
  let kids = kidsOf(t, idx)
  let i = 0
  while (i < len(kids)) {
    out = out + " " + dumpNode(t, src, kids[i])
    i = i + 1
  }
  return out + ")"
}

// The whole tree as one s-expression (no trailing newline), matching the seed's
// `ast.dump` byte-for-byte.
fn dumpAst(t: Tree, src: string): string {
  return dumpNode(t, src, t.root)
}
