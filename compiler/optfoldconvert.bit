// compiler/optfoldconvert.bit — everything the optimizer knows about `convert`.
// Split out of optfold.bit (#4397), which was at 768 of its 800-line ceiling;
// the identities and their sweep stay there, the width rules come here.

// ---------------------------------------------------------------------------
// Constant propagation through `convert` (#3112)
//
// `analyzeConsts` folds arithmetic, compares and the three unary ops, but never
// a `convert` — so a known constant that passes through one stops being known,
// and every consumer that recognizes only a bare `const_int` declines. #1853's
// ADD/SUB-immediate fold (`constIntOf`/`xConstIntOf`) is the one that costs
// real code: `*T ± n` scales `n` and retypes the scaled offset with a no-op
// `convert` to the pointer type (lowerexpr.bit, §11.4), so
// `*(g + gcRefArrayInfo)` and its neighbours across `runtime/gc/**` reach
// codegen as `const_int` + `convert` + register-register `add` where a single
// `add xN, xM, #imm` encodes the whole thing.
//
// THE FOLD ONLY FIRES WHEN IT CANNOT CHANGE A SINGLE BIT, which is what keeps
// it out of `Convert`'s real semantics. `emitConvert`/`xEmitConvert` are two
// `extendRegA`s — canonicalize to the SOURCE type's width and signedness, then
// to the DESTINATION's — and `canon` reproduces both exactly (`extendRegA` at
// 8 bytes is a `mov`, at 1/2/4 an SBFM/UBFM, which is `signExtend`/`maskTo`).
// The result is compared against the original pattern and the fold declines
// unless they are equal, so a narrowing conversion that would genuinely drop
// bits still evaluates through the real instruction. Int<->float and
// float->float never reach here at all: `convWidthOf` accepts only an integer
// primitive or a raw pointer.
// ---------------------------------------------------------------------------

// The width and signedness `emitConvert`'s `extendRegA` applies to a value of
// type `ty`. `ok` is false for every type this fold refuses — a float, a bool,
// a string, a GC reference, an enum — leaving those conversions alone.
class ConvWidth {
  ok: bool,
  bits: int,
  signed: bool,
}

fn noConvWidth(): ConvWidth {
  return ConvWidth{ ok: false, bits: 0, signed: false }
}

fn convWidthOf(ctx: TypeContext, ty: int): ConvWidth {
  // A raw pointer `*T` (§11.4) is codegen's uniform 8-byte int-classed word and
  // is never a GC reference (codegen.bit's `isRefType`), so folding one to a
  // `const_int` AT THAT SAME POINTER TYPE moves nothing the collector reads —
  // only the op changes, never the type. That is why `const_nil` is
  // deliberately left alone by `constView` above and this is not: this rewrite
  // keeps the value's own type, that one would have changed it.
  if (ctx.types[ty].kind == TypeKind.Ptr) {
    return ConvWidth{ ok: true, bits: 64, signed: false }
  }
  let p = primOfType(ctx, ty)
  if (p < 0 || !isIntPrim(p)) {
    return noConvWidth()
  }
  return ConvWidth{ ok: true, bits: primBits(p), signed: isSignedPrim(p) }
}

// The constant value of `convert`ing an already-known integer constant, or
// unknown when the conversion is not a pure retype of these exact bits. Reads
// `known` rather than `constView`: a `convert` of `const_nil` must keep its
// pointer-typed nil, not become a `const_int 0`.
fn foldConvert(ctx: TypeContext, known: []ConstVal, f: IrFunc, id: int): ConstVal {
  let ins = f.instrs[id]
  let src = known[ins.lhs]
  if (!src.known || src.isFloat || src.isBool) {
    return noConst()
  }
  let sw = convWidthOf(ctx, f.instrs[ins.lhs].ty)
  let dw = convWidthOf(ctx, ins.ty)
  if (!sw.ok || !dw.ok) {
    return noConst()
  }
  let out = canon(canon(src.ival, sw.bits, sw.signed), dw.bits, dw.signed)
  if (out != src.ival) {
    return noConst()
  }
  return intConst(out)
}

// ---------------------------------------------------------------------------
// Widening-convert alias (#4397, from #4363's finding)
//
// A `convert` whose source register ALREADY holds the destination's exact 64
// bits emits NO instruction: `emitConvert`/`xEmitConvert` drop the source-width
// extend when `srcIsWidthCanonical` holds, and the destination extend is then a
// no-op too. It still costs one IR instruction, and `optinline.bit` spends its
// budget on IR instructions -- which is why #4363's register-level fix could not
// move `_blobU16`'s call count: `blobU16`'s two `int(u8)` converts are counted
// long before the backend decides they emit nothing.
//
// THIS IS THE ONE PLACE IN THIS PASS WHERE A VALUE IS RETYPED. `identityOf`
// refuses a copy identity whose source type disagrees with the instruction's
// own; here the disagreement IS the transform, so it is licensed narrowly:
// integer primitives on BOTH sides (a raw pointer would retype a value
// `codegenlive.bit`'s `derivedReach` tracks and a reference one the collector
// scans), and only when the conversion cannot move a single bit for ANY source
// value. #4396 is the prerequisite -- the eight store/atomic selectors take
// their width from the instruction's own recorded `ival2` rather than from this
// value's defining instruction, so a narrower producer no longer narrows a
// store.
// ---------------------------------------------------------------------------

// Whether `extendRegA(dBits, dSigned)` is the IDENTITY on a register already
// canonical for `sBits`/`sSigned` -- true for every source value, not for some.
// Such a register holds the extension bit `e` (0 when unsigned, the sign bit
// when signed) in every position at and above `sBits`.
//
//   dBits 64      : `extendRegA` at 8 bytes is a `mov`. Identity, always.
//   dBits <= sBits: refused. Narrowing drops bits the value may be using, and
//                   equal widths can differ only in signedness, which lowering
//                   does not emit (a same-type conversion is filtered there) --
//                   so that case gets no arm rather than an unexercised one.
//   dBits > sBits : bit `dBits-1` is `e`, so a SIGNED extend copies `e` upward
//                   and reproduces the register exactly; an UNSIGNED one writes
//                   zeros above `dBits` and agrees only when `e` is already 0.
fn convertIsPureRetype(sBits: int, sSigned: bool, dBits: int, dSigned: bool): bool {
  if (dBits >= 64) {
    return true
  }
  if (dBits <= sBits) {
    return false
  }
  return dSigned || !sSigned
}

// Whether `convert` instruction `id` may be replaced by a read of its source.
//
// The producer whitelist is `srcIsWidthCanonical`'s (codegen.bit), called
// rather than copied: `Op.Asm`, an `extern` `Op.Call` and an entry
// `Op.BlockParam` are excluded there because neither backend re-canonicalizes
// at the ABI boundary, and a second list here would be the copy that stops
// tracking the first. Its width comparison is trivially satisfied -- `sw` IS
// the source's own width -- so what this call buys is the op whitelist, once.
fn convertAliasesSource(ctx: TypeContext, f: IrFunc, id: int): bool {
  let ins = f.instrs[id]
  let sp = primOfType(ctx, f.instrs[ins.lhs].ty)
  let dp = primOfType(ctx, ins.ty)
  if (!isIntPrim(sp) || !isIntPrim(dp)) {
    return false
  }
  if (!srcIsWidthCanonical(ctx, f, ins.lhs, widthOf(ctx, f.instrs[ins.lhs].ty))) {
    return false
  }
  return convertIsPureRetype(primBits(sp), isSignedPrim(sp), primBits(dp), isSignedPrim(dp))
}
