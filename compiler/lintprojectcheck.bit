// In-Bit self-checks for `bit.json`'s "lint" key (#4156, compiler/lintproject.bit).
// Run by `selfcheck()` under `./make test-selfcheck` and `./make test`, same
// as compiler/lintcheck.bit's own directive-reader checks.
//
// These cover the pure decode/merge logic — JSONC shape validation, path
// matching, and precedence — which needs no process and no real `bit.json`
// on disk. The disk-reading half of `loadLintProjectConfig` (exists/readFile,
// and the file being named in the error) plus the CLI-visible behaviour
// (exit codes, the exclude/allow summary lines, both precedence directions
// against a real file) are covered by `_tests_/bit/lintprojectconfig.bit`,
// exactly the same split `_tests_/bit/lintcmd/lintcmd.bit`'s own header describes
// for `bit lint`'s directive reader vs. its process contract.
//
// Named to sort after compiler/lintproject.bit, whose types and functions
// every check here calls, and its own `checkLintProjectConfig()` is called
// from compiler/lintcheckrules.bit's `checkLint()` — module files concatenate
// in bytewise filename order (compiler/project.bit:7), but resolution is
// order-independent regardless (bitlang-ws/CLAUDE.md's "splitting a file"
// section).

// A `Json` value from a plain JSONC string, for tests that don't need a real
// file on disk. Panics on a malformed FIXTURE (a bug in the test itself,
// never the thing under test) rather than returning `!` — every self-check
// in this file is `()`, not `()!`.
fn lintProjectTestJson(src: string): Json {
  let v = jsoncParse(src) catch _ {
    panic("lintprojectcheck: fixture is not valid JSONC: ${src}")
  }
  return v
}

fn checkLintProjectAbsent() {
  let pc = emptyLintProjectConfig()
  assert(!pc.active)
  let cfg = seedLintConfig(pc, ".", "./anything.bit")
  assert(cfg.limits[lintRuleIndex(lintRules(), "max-file-lines")] == 800)
  assert(lintOverrideCount(cfg) == 0)
  assert(len(allowCodesFor(pc, ".", "./anything.bit")) == 0)
  assert(!isProjectDisabled(pc, ".", "./anything.bit"))
}

fn checkLintProjectRulesSeed() {
  let v = lintProjectTestJson("{ \"max-file-lines\": 123, \"max-params\": 2 }")
  let assigns = decodeRulesObject("t/bit.json", "lint.rules", v) catch _ {
    panic("lintprojectcheck: decodeRulesObject unexpectedly failed")
  }
  assert(len(assigns) == 2)
  let cfg = newLintConfig()
  applyRuleAssigns(cfg, lintRules(), assigns)
  assert(cfg.limits[lintRuleIndex(lintRules(), "max-file-lines")] == 123)
  assert(cfg.overridden[lintRuleIndex(lintRules(), "max-file-lines")])
  assert(cfg.limits[lintRuleIndex(lintRules(), "max-params")] == 2)
  // A rule the object never named is untouched.
  assert(cfg.limits[lintRuleIndex(lintRules(), "max-nesting")] == 4)
  assert(!cfg.overridden[lintRuleIndex(lintRules(), "max-nesting")])
}

// Every malformed shape decodeRulesObject/decodeOverride/decodeLintValue can
// hit, each asserted by its OWN distinguishing substring — a clean
// diagnostic naming the problem, never a crash, never a silent no-op.
fn checkLintProjectDecodeErrors() {
  assertDecodeRulesFails("{ \"typo-name\": 1 }", "unknown lint rule")
  assertDecodeRulesFails("{ \"unused-import\": 1 }", "takes no value")
  assertDecodeRulesFails("{ \"max-file-lines\": \"nope\" }", "must be an integer")
  assertDecodeRulesFails("{ \"max-file-lines\": -1 }", "out of range")
  assertDecodeLintValueFails("5", "must be an object")
  assertDecodeLintValueFails("{ \"rulez\": {} }", "unrecognized key")
  assertDecodeLintValueFails("{ \"overrides\": {} }", "must be an array")
  assertDecodeLintValueFails("{ \"overrides\": [ {} ] }", "missing")
  assertDecodeLintValueFails(
    "{ \"overrides\": [ { \"paths\": [\"a\"], \"disable\": 1 } ] }",
    "must be a boolean",
  )
  assertDecodeLintValueFails(
    "{ \"overrides\": [ { \"paths\": [\"a/*\"] } ] }", "glob pattern",
  )
  assertDecodeLintValueFails(
    "{ \"overrides\": [ { \"paths\": [\"a\"], \"foo\": 1 } ] }", "unrecognized key",
  )
  assertDecodeLintValueFails(
    "{ \"overrides\": [ { \"paths\": [\"a\"], \"allow\": [\"nope\"] } ] }", "not a diagnostic code",
  )
}

fn assertDecodeRulesFails(src: string, needle: string) {
  let v = lintProjectTestJson(src)
  let _ = decodeRulesObject("t/bit.json", "lint.rules", v) catch e {
    assert(contains(e.message(), needle))
    return
  }
  panic("lintprojectcheck: expected decodeRulesObject to fail on ${src}")
}

fn assertDecodeLintValueFails(src: string, needle: string) {
  let v = lintProjectTestJson(src)
  let _ = decodeLintValue("t/bit.json", v) catch e {
    assert(contains(e.message(), needle))
    return
  }
  panic("lintprojectcheck: expected decodeLintValue to fail on ${src}")
}

fn checkLintProjectParseCodeString() {
  let (n1, ok1) = parseCodeString("E0021")
  assert(ok1 && n1 == 21)
  let (n2, ok2) = parseCodeString("E0200")
  assert(ok2 && n2 == 200)
  let (_, ok3) = parseCodeString("0021")
  assert(!ok3)
  let (_, ok4) = parseCodeString("E021")
  assert(!ok4)
  let (_, ok5) = parseCodeString("E00021")
  assert(!ok5)
  let (_, ok6) = parseCodeString("E00XY")
  assert(!ok6)
}

fn checkLintProjectPathMatching() {
  assert(pathUnderPrefix("_tests_/cases/x.bit", "_tests_/cases"))
  assert(pathUnderPrefix("_tests_/cases", "_tests_/cases"))
  assert(!pathUnderPrefix("_tests_/cases_extra/x.bit", "_tests_/cases"))
  assert(!pathUnderPrefix("other/x.bit", "_tests_/cases"))

  let (r1, ok1) = relToRoot(".", "./sub/x.bit")
  assert(ok1 && r1 == "sub/x.bit")
  let (r2, ok2) = relToRoot(".", "sub/x.bit")
  assert(ok2 && r2 == "sub/x.bit")
  let (r3, ok3) = relToRoot("..", "../sub/x.bit")
  assert(ok3 && r3 == "sub/x.bit")
  let (_, ok4) = relToRoot("..", "sub/x.bit")
  assert(!ok4) // not textually under root -- no override can match, never a crash
}

// Builds a small, hand-constructed project config: a top-level rule plus one
// override that narrows it for "sub" and one that fully disables "fixtures".
fn lintProjectTestConfig(): LintProjectConfig {
  let topRules = [LintRuleAssign{ name: "max-file-lines", limit: 100 }]
  let subOverride = LintOverride{
    paths: ["sub"],
    rules: [LintRuleAssign{ name: "max-file-lines", limit: 5 }],
    disableAll: false,
    allowCodes: [21],
  }
  let fixturesOverride = LintOverride{
    paths: ["fixtures"], rules: []LintRuleAssign(0), disableAll: true, allowCodes: []int(0),
  }
  return LintProjectConfig{
    active: true,
    rules: topRules,
    overrides: [subOverride, fixturesOverride],
  }
}

// Both precedence directions the ticket requires proof of, at the merge
// layer: a project rule applies where nothing more specific does, and a
// matching override narrows it further. (The OTHER direction — an in-file
// directive beating this whole layer — is `readLintDirectivesFrom`'s
// contract, lint.bit, proven by `_tests_/bit/lintprojectconfig.bit` against a
// real file since it needs a directive's own leading-comment-block rule.)
fn checkLintProjectSeedPrecedence() {
  let pc = lintProjectTestConfig()
  let idx = lintRuleIndex(lintRules(), "max-file-lines")

  let top = seedLintConfig(pc, ".", "./top.bit")
  assert(top.limits[idx] == 100) // project-wide rule, no override matches

  let sub = seedLintConfig(pc, ".", "sub/small.bit")
  assert(sub.limits[idx] == 5) // the override narrows it further

  let outside = seedLintConfig(pc, ".", "elsewhere/x.bit")
  assert(outside.limits[idx] == 100) // no override matches; the project rule stands
}

fn checkLintProjectAllowAndDisable() {
  let pc = lintProjectTestConfig()

  let codes = allowCodesFor(pc, ".", "sub/x.bit")
  assert(len(codes) == 1 && codes[0] == 21)
  assert(len(allowCodesFor(pc, ".", "top.bit")) == 0)

  assert(isProjectDisabled(pc, ".", "fixtures/broken.bit"))
  assert(isProjectDisabled(pc, ".", "fixtures"))
  assert(!isProjectDisabled(pc, ".", "sub/small.bit"))
  assert(!isProjectDisabled(pc, ".", "top.bit"))
}

fn checkLintProjectConfig() {
  checkLintProjectAbsent()
  checkLintProjectRulesSeed()
  checkLintProjectDecodeErrors()
  checkLintProjectParseCodeString()
  checkLintProjectPathMatching()
  checkLintProjectSeedPrecedence()
  checkLintProjectAllowAndDisable()
}
