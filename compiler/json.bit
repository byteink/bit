// Self-host JSON value model + encoder (#1595). Provides the pieces the ported
// `bit lsp` (#1547) needs to talk JSON-RPC: a tagged value tree, a string
// escaper that is byte-exact with the JSON spec, and a canonical stringifier.
// Kept LOCAL to compiler/ rather than as a stdlib/json module: the LSP is the
// only consumer, and anything under stdlib/ re-gates the full selfhost-diffall
// family on every edit — this library has no reason to do that.
//
// The value tree is arena-shaped like the rest of the self-host (ast.bit): every
// node lives in one growable `JsonDoc.nodes` array and children are referenced
// by integer id, so a recursive document needs no recursive struct. The parser
// lives in the sibling jsonparse.bit (same module); it sorts AFTER this file so
// the escaper/accessor helpers it and stringify share are lowered first.

// The six JSON value shapes (RFC 8259 §3). `Num` keeps the raw token text so
// round-tripping a number re-emits it verbatim — no float parse, no drift.
enum JsonKind {
  Null,
  Bool,
  Num,
  Str,
  Arr,
  Obj,
}

// One node. Only the fields relevant to `kind` are meaningful:
//   Bool -> boolVal; Num -> numRaw; Str -> strVal (DECODED, escapes resolved);
//   Arr  -> items (child node ids); Obj -> keys with parallel items.
struct JsonValue {
  kind: JsonKind,
  boolVal: bool,
  numRaw: string,
  strVal: string,
  keys: []string,
  items: []int,
}

// A parsed document: the node arena plus the id of the top-level value. `ok` is
// false when the source was malformed anywhere during the parse.
struct JsonDoc {
  nodes: []JsonValue,
  root: int,
  ok: bool,
}

// ---- string escaping (the outgoing-JSON correctness boundary) --------------

const jsonHexDigits: string = "0123456789abcdef"

// Appends the two-byte escape `\<b>` to `out`.
fn jsonEsc2(out: []u8, b: u8): []u8 {
  out = append(out, u8(0x5C))
  // bit:lint allow E0214 -- out is jsonEscapeInto's byte accumulator, seeded fresh from []u8(0); every caller reassigns it from the return value
  return append(out, b)
}

// Appends the JSON-escaped bytes of `s` (WITHOUT surrounding quotes) to `out`.
// Byte-exact with RFC 8259 §7 (escape_unicode=off equivalent),
// which is what the seed LSP emits: escapes `"`, `\`, the named controls
// (\b \f \n \r \t), and every other C0 control (U+0000..U+001F) as \u00XX
// (lowercase hex). `/` (0x2F) and all bytes >= 0x20 — including raw UTF-8 —
// pass through unchanged. This is a security boundary: a missed control byte or
// quote yields malformed or injectable output, so the full C0 range is covered
// explicitly rather than collapsed.
fn jsonEscapeInto(out: []u8, s: string): []u8 {
  let i = 0
  while (i < len(s)) {
    let b = s[i]
    let c = int(b)
    if (c == 0x22) {
      out = jsonEsc2(out, u8('"'))
    } else if (c == 0x5C) {
      out = jsonEsc2(out, u8(0x5C))
    } else if (c == 0x08) {
      out = jsonEsc2(out, u8('b'))
    } else if (c == 0x0C) {
      out = jsonEsc2(out, u8('f'))
    } else if (c == 0x0A) {
      out = jsonEsc2(out, u8('n'))
    } else if (c == 0x0D) {
      out = jsonEsc2(out, u8('r'))
    } else if (c == 0x09) {
      out = jsonEsc2(out, u8('t'))
    } else if (c < 0x20) {
      out = jsonEsc2(out, u8('u'))
      out = append(out, u8('0'))
      out = append(out, u8('0'))
      out = append(out, jsonHexDigits[(c >> 4) & 15])
      out = append(out, jsonHexDigits[c & 15])
    } else {
      out = append(out, b)
    }
    i = i + 1
  }
  return out
}

// The JSON string literal for `s`: a quoted, escaped run. Matches the seed's
// `json.Stringify.encodeJsonString(s, .{}, w)` byte for byte.
fn jsonEncodeString(s: string): string {
  let out = []u8(0)
  out = append(out, u8('"'))
  out = jsonEscapeInto(out, s)
  out = append(out, u8('"'))
  return string(out)
}

// The escaped run for `s` WITHOUT the surrounding quotes — for hand-built JSON
// (the seed's `encodeJsonStringChars`).
fn jsonEscapeChars(s: string): string {
  return string(jsonEscapeInto([]u8(0), s))
}

// ---- accessors (loose reads over a parsed value, like the seed's *Field) ---

// True when `id` names a real node in `d`.
fn jsonHas(d: JsonDoc, id: int): bool {
  return id >= 0 && id < len(d.nodes)
}

fn jsonKindOf(d: JsonDoc, id: int): JsonKind {
  return d.nodes[id].kind
}

// The value bound to `key` in object `id`, or -1 (also -1 if `id` is not an
// object). Linear scan — LSP objects are small and key order must be preserved.
fn jsonGet(d: JsonDoc, id: int, key: string): int {
  if (!jsonHas(d, id)) {
    return -1
  }
  let v = d.nodes[id]
  if (v.kind != JsonKind.Obj) {
    return -1
  }
  let i = 0
  while (i < len(v.keys)) {
    if (v.keys[i] == key) {
      return v.items[i]
    }
    i = i + 1
  }
  return -1
}

// Element `idx` of array `id`, or -1 (also -1 if `id` is not an array).
fn jsonAt(d: JsonDoc, id: int, idx: int): int {
  if (!jsonHas(d, id)) {
    return -1
  }
  let v = d.nodes[id]
  if (v.kind != JsonKind.Arr) {
    return -1
  }
  if (idx < 0 || idx >= len(v.items)) {
    return -1
  }
  return v.items[idx]
}

// The element / member count of an array or object.
fn jsonLen(d: JsonDoc, id: int): int {
  if (!jsonHas(d, id)) {
    return 0
  }
  return len(d.nodes[id].items)
}

// Key `idx` of object `id`, or "".
fn jsonKeyAt(d: JsonDoc, id: int, idx: int): string {
  if (!jsonHas(d, id)) {
    return ""
  }
  let v = d.nodes[id]
  if (idx < 0 || idx >= len(v.keys)) {
    return ""
  }
  return v.keys[idx]
}

// The decoded string of a Str node, or "".
fn jsonStrOf(d: JsonDoc, id: int): string {
  if (!jsonHas(d, id)) {
    return ""
  }
  return d.nodes[id].strVal
}

// The boolean of a Bool node, or false.
fn jsonBoolOf(d: JsonDoc, id: int): bool {
  if (!jsonHas(d, id)) {
    return false
  }
  return d.nodes[id].boolVal
}

fn jsonIsNull(d: JsonDoc, id: int): bool {
  return jsonHas(d, id) && d.nodes[id].kind == JsonKind.Null
}

// The integer value of a Num node, truncating any fraction/exponent — enough for
// LSP `line`/`character`/`id`, matching the seed's `@intFromFloat` narrowing.
fn jsonIntOf(d: JsonDoc, id: int): int {
  if (!jsonHas(d, id)) {
    return 0
  }
  return jsonParseIntStr(d.nodes[id].numRaw)
}

// The leading signed integer of `s` (stops at `.`/`e`); 0 if none.
fn jsonParseIntStr(s: string): int {
  let i = 0
  let neg = false
  if (len(s) > 0 && s[0] == u8('-')) {
    neg = true
    i = 1
  }
  let n = 0
  while (i < len(s) && s[i] >= u8('0') && s[i] <= u8('9')) {
    n = n * 10 + (int(s[i]) - int(u8('0')))
    i = i + 1
  }
  if (neg) {
    return -n
  }
  return n
}

// ---- canonical stringify (round-trips a parsed document) -------------------

// Appends the raw bytes of `s` to `out`.
fn jsonAppendRaw(out: []u8, s: string): []u8 {
  let i = 0
  while (i < len(s)) {
    out = append(out, s[i])
    i = i + 1
  }
  return out
}

// The canonical serialization of `d`: no insignificant whitespace, object keys
// in parse order, strings escaped via jsonEscapeInto, numbers re-emitted from
// their raw token. Parsing then stringifying canonical JSON is the identity.
fn jsonStringify(d: JsonDoc): string {
  return string(jsonWriteNode([]u8(0), d, d.root))
}

fn jsonWriteNode(out: []u8, d: JsonDoc, id: int): []u8 {
  if (!jsonHas(d, id)) {
    return jsonAppendRaw(out, "null")
  }
  let v = d.nodes[id]
  if (v.kind == JsonKind.Null) {
    return jsonAppendRaw(out, "null")
  }
  if (v.kind == JsonKind.Bool) {
    if (v.boolVal) {
      return jsonAppendRaw(out, "true")
    }
    return jsonAppendRaw(out, "false")
  }
  if (v.kind == JsonKind.Num) {
    return jsonAppendRaw(out, v.numRaw)
  }
  if (v.kind == JsonKind.Str) {
    out = append(out, u8('"'))
    out = jsonEscapeInto(out, v.strVal)
    // bit:lint allow E0214 -- out is jsonStringify's byte accumulator, seeded fresh from []u8(0); every caller (including this function's own recursion) reassigns it from the return value
    return append(out, u8('"'))
  }
  if (v.kind == JsonKind.Arr) {
    out = append(out, u8('['))
    let i = 0
    while (i < len(v.items)) {
      if (i > 0) {
        out = append(out, u8(','))
      }
      out = jsonWriteNode(out, d, v.items[i])
      i = i + 1
    }
    // bit:lint allow E0214 -- same out, same single-owner accumulator seeded fresh from []u8(0); no caller keeps a pre-call copy
    return append(out, u8(']'))
  }
  out = append(out, u8('{'))
  let j = 0
  while (j < len(v.keys)) {
    if (j > 0) {
      out = append(out, u8(','))
    }
    out = append(out, u8('"'))
    out = jsonEscapeInto(out, v.keys[j])
    out = append(out, u8('"'))
    out = append(out, u8(':'))
    out = jsonWriteNode(out, d, v.items[j])
    j = j + 1
  }
  // bit:lint allow E0214 -- same out, same single-owner accumulator seeded fresh from []u8(0); no caller keeps a pre-call copy
  return append(out, u8('}'))
}
