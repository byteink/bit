// compiler/lowerappend.bit — split out of lowerprim.bit, which `append`'s
// lowering pushed past the 800-line lint limit; same reason lowerreslice.bit
// was split out of loweraccess.bit (#4048). `append(s, ...)` lowering only, in
// all three of its forms: the ordinary word/byte element, the packed `[]T`
// element (#3862), and the inline fast path (#4039). Sibling of lowerprim.bit:
// same module, so this needs no imports and no call-site changes —
// `emitRtCall`, `emitJump`, `sliceElemSizeFor`, `sliceElemIsRef` and
// `storePackedCompositeLit` are all still defined elsewhere in this module and
// called from here exactly as they were before the move.

// Lowers `append(s, e1, e2, ...)`: folds each element through `slice_append`,
// threading the returned (possibly regrown) header so a `s = append(s, ...)`
// observes the new length. Each element lowers with the slice's element hint.
// `is_ref` travels on every call (ABI.md §2, #1569): a null header (a zeroed
// class's slice field, #1564) has no element type to read, so the call site
// — the only place that still knows the static element type — supplies it.
fn lowerAppend(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a0 = args[0]
  if (getNode(fc.c.tree, a0).tag == Tag.Arg) {
    a0 = kidsOf(fc.c.tree, a0)[0]
  }
  let sliceTy = defaultType(fc.c, nodeType(fc, a0))
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (sliceElemIsRef(fc, elemTy)) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  // elem_size (ABI.md §9, #3121/#3226, #3862): see `lowerlit.bit`'s
  // `lowerSliceAlloc` for the full rationale; `sliceElemSizeFor` lives in
  // `lowerlayout.bit`.
  let stride = sliceElemSizeFor(fc, elemTy)
  let esI = mkInstr(Op.ConstInt, i64ty)
  esI.ival = stride
  let esV = builderEmit(fc.b, esI)
  let acc = lowerExpr(fc, a0)
  if (fc.failed) {
    return 0
  }
  let ctx = AppendPackedCtx{
    sliceTy = sliceTy,
    elemTy = elemTy,
    stride = stride,
    refV = refV,
    esV = esV,
  }
  if (stride > 8) {
    return lowerAppendPacked(fc, acc, ctx, args)
  }
  return lowerAppendElems(fc, acc, ctx, args)
}

// Whether `a` — an already-unwrapped trailing `append` argument — is a
// `string`. `defaultType` first, because a bare literal is UNTYPED (§15.4):
// `append(b, "hi")`'s argument types as `untypedString`, not the `string`
// prim, and comparing the raw id would send the one spelling users write
// most down the per-byte path (the same defaulting `vLenCapCall`
// (validatecall.bit) records getting wrong on `len("bit")`).
fn appendArgIsString(fc: FnCtx, a: int): bool {
  let t = defaultType(fc.c, nodeType(fc, a))
  let td = fc.c.ctx.types[t]
  return td.kind == TypeKind.Prim && td.prim == 11
}

// The trailing values of an ordinary (stride <= 8) `append`, folded one at a
// time through the accumulator so `s = append(s, a, b)` observes both.
//
// TWO ADMISSIBLE OPERAND SHAPES (#4371, SPEC §12.6): an ELEMENT, and — when
// the destination's element is `u8` — a whole `string`, whose bytes are
// appended in one `rt_call slice_append_str` instead of one call per byte.
// The choice is per ARGUMENT, not per call, so `append(b, 65, s, 66)` mixes
// them with no special case. `vAppendCall` (validateappend.bit) is what
// proves a `string` argument here really does have a `[]u8` destination;
// anything else it rejects with E0130 before lowering ever runs, so the
// `stride == 1` test below is the destination half of a rule already checked
// rather than a silent fallback.
//
// A `[]string` destination keeps the ELEMENT shape: its element type IS
// `string`, so `stride == 8` and a string argument is the ordinary one-word
// append it has always been.
fn lowerAppendElems(fc: FnCtx, accIn: int, ctx: AppendPackedCtx, args: []int): int {
  let acc = accIn
  let i = 1
  while (i < len(args) && !fc.failed) {
    let a = args[i]
    // #5328: `append(dst, ...src)`. SPEC §12.4: "Exactly one `...spread`
    // argument is permitted... Mixing individual args and a spread in the
    // same call is a compile error" — `lowerVariadicTail` (lowerprim.bit)
    // enforces exactly this for a real variadic function's tail (a lone
    // spread only, `len(items) == 1`), but `vAppendCall`
    // (validateappend.bit) dispatches past the general check that raises
    // E0063 for everyone else, so append never got the rule at all. Mirrored
    // here: a spread is legal only as append's SOLE trailing argument
    // (`len(args) == 2` — `dst` plus the one spread).
    if (getNode(fc.c.tree, a).tag == Tag.ArgSpread) {
      if (len(args) != 2) {
        fcFail(
          fc,
          getNode(fc.c.tree, a).span,
          "a `...` spread mixed with another append argument",
        )
        return 0
      }
      acc = lowerAppendSpreadInto(fc, acc, ctx, kidsOf(fc.c.tree, a)[0])
      i = i + 1
      continue
    }
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    if (ctx.stride == 1 && appendArgIsString(fc, a)) {
      let sv = lowerExprH(fc, a, primType(fc.c.ctx, 11))
      if (fc.failed) {
        return 0
      }
      acc = emitAppendStrCall(fc, acc, sv, ctx)
    } else {
      let v = lowerExprH(fc, a, ctx.elemTy)
      if (fc.failed) {
        return 0
      }
      acc = emitAppendCall(fc, acc, v, ctx)
    }
    i = i + 1
  }
  return acc
}

// `append(dst, ...src)` (#5328): folds every element of `src` into `acc` with
// a genuine runtime loop — the same shape `for x of src { acc = append(acc,
// x) }` lowers to, and the same shape #5072's hand-written workaround used
// at every call site before this existed. `lowerAppend` never had this case
// at all: every trailing argument was lowered as one AST-level expression
// per source token, so a single spread token — one node standing for a
// runtime-many-element value — reached `lowerExprH` and hit E0092 ("cannot
// lower an expression form the lowerer does not yet handle"), for every
// element type alike; there was no element-type boundary to find.
//
// Reuses `for … of`'s own element-read shape (`lowerForOfSliceElem`,
// lowerctrl.bit): the header computes `icmp_slt(idx, slice_len(src))` and
// branches to a ZERO-PARAM body whose first instruction is the element load
// — the exact invariant that function's bounds-check elision depends on
// (see its own comment: no call, no allocation, no safepoint between the
// header's compare and the load).
//
// EVERY value the loop reads — `src`, `ctx.refV`, `ctx.esV`, besides `acc`
// and `idx` which genuinely change — is threaded through the env exactly
// like `for … of`'s own `$iter`. The IR verifier requires this even for a
// value nothing inside the loop reassigns: `ircheck.bit` refuses any read,
// anywhere in a loop closed by a back edge, of a value defined outside
// it — the first version of this function skipped that for the three
// invariants and every fixture failed verification (#5328) rather than
// producing a wrong answer.
//
// A packed (`stride > 8`) `elemTy` never reaches here: `scanAppendArgs`
// (lowersliceinline.bit) already disqualifies packing, module-wide, for any
// elemTy a spread ever appends into — a spread argument is never a fresh
// `CompositeLit` — so `ctx.stride` is always <= 8 by the time
// `lowerAppendElems` calls this, and `lowerForOfSliceElem` takes its
// ordinary (non-packed) arm.
fn lowerAppendSpreadInto(fc: FnCtx, accIn: int, ctx: AppendPackedCtx, spreadOperand: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let srcTy = mkSlice(fc.c.ctx, ctx.elemTy)
  let srcV = lowerExprH(fc, spreadOperand, srcTy)
  if (fc.failed) {
    return 0
  }
  declareLocal(fc, "$appendAcc", accIn, ctx.sliceTy)
  declareLocal(fc, "$appendSrc", srcV, srcTy)
  declareLocal(fc, "$appendRef", ctx.refV, i64ty)
  declareLocal(fc, "$appendEs", ctx.esV, i64ty)
  let zeroI = mkInstr(Op.ConstInt, i64ty)
  zeroI.ival = 0
  declareLocal(fc, "$appendIdx", builderEmit(fc.b, zeroI), i64ty)
  let preLen = len(fc.env)
  let idxSlot = preLen - 1
  let esSlot = preLen - 2
  let refSlot = preLen - 3
  let srcSlot = preLen - 4
  let accSlot = preLen - 5

  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  let idxVal = fc.env[idxSlot].value
  let srcCur = fc.env[srcSlot].value
  let lenIns = mkInstr(Op.SliceLen, i64ty)
  lenIns.lhs = srcCur
  let cmp = mkInstr(Op.ICmpSlt, primType(fc.c.ctx, 10))
  cmp.lhs = idxVal
  cmp.rhs = builderEmit(fc.b, lenIns)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = builderEmit(fc.b, cmp)
  br.ival = bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = exitBlk
  br.elseArgs = snapshotValues(fc, preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, bodyBlk)
  let elem = lowerForOfSliceElem(fc, srcCur, idxVal, ctx.elemTy)
  let loopCtx = AppendPackedCtx{
    sliceTy = ctx.sliceTy, elemTy = ctx.elemTy, stride = ctx.stride,
    refV = fc.env[refSlot].value, esV = fc.env[esSlot].value,
  }
  fc.env[accSlot].value = emitAppendCall(fc, fc.env[accSlot].value, elem.value, loopCtx)
  let oneI = mkInstr(Op.ConstInt, i64ty)
  oneI.ival = 1
  let addI = mkInstr(Op.Add, i64ty)
  addI.lhs = idxVal
  addI.rhs = builderEmit(fc.b, oneI)
  fc.env[idxSlot].value = builderEmit(fc.b, addI)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  let result = fc.env[accSlot].value
  truncateEnv(fc, preLen - 5)
  return result
}

// The inputs a packed `append` shares across every trailing value it writes
// (#3862) — bundled so `lowerAppendPacked` stays under E0202's
// max-params=5 (spec/LINT.md).
class AppendPackedCtx {
  sliceTy: int,
  elemTy: int,
  stride: int,
  refV: int,
  esV: int,
}

// Appends a PACKED element (#3862) without a throwaway boxed intermediate.
// `sliceElemInlineSafe` (lowersliceinline.bit) already proved every trailing
// arg here is a `Tag.CompositeLit` of elemTy — this lowerer never boxes a
// value read from elsewhere and copies it in, which would pay exactly the
// per-element allocation packing exists to remove.
//
// Grows via the ordinary `slice_append`, passing a placeholder 0 for the
// word #3861's runtime writes to the new slot's low 8 bytes — immediately
// overwritten below along with every other field, so the placeholder's value
// is never observed. `storePackedCompositeLit` is the same helper
// `fillPackedSliceLitElems` (lowerclasslit.bit) uses for a packed slice literal's
// elements.
fn lowerAppendPacked(fc: FnCtx, accIn: int, ctx: AppendPackedCtx, args: []int): int {
  let acc = accIn
  let i64ty = primType(fc.c.ctx, 3)
  let i = 1
  while (i < len(args) && !fc.failed) {
    let a = args[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    if (getNode(fc.c.tree, a).tag != Tag.CompositeLit) {
      panic("lowerAppendPacked: a packed []T append's argument was not a composite literal — sliceElemInlineSafe should have refused this program")
    }
    let z = mkInstr(Op.ConstInt, i64ty)
    z.ival = 0
    acc = emitAppendCall(fc, acc, builderEmit(fc.b, z), ctx)
    if (fc.failed) {
      return 0
    }
    let lenIns = mkInstr(Op.SliceLen, i64ty)
    lenIns.lhs = acc
    let lenV = builderEmit(fc.b, lenIns)
    let one = mkInstr(Op.ConstInt, i64ty)
    one.ival = 1
    let subIns = mkInstr(Op.Sub, i64ty)
    subIns.lhs = lenV
    subIns.rhs = builderEmit(fc.b, one)
    let newIdx = builderEmit(fc.b, subIns)
    let slot = PackedSlot{ recv = acc, idxV = newIdx, stride = ctx.stride, elemTy = ctx.elemTy }
    storePackedCompositeLit(fc, slot, a)
    if (fc.failed) {
      return 0
    }
    i = i + 1
  }
  return acc
}

// The out-of-line `rt_call slice_append(h, word, is_ref, elem_size)` — one
// element, the runtime's own entry point (runtime/root/slices.bit's
// `rtSliceAppend`). Both append lowerings reach it through here: the ordinary
// one above and the packed one's reserve-then-fill step. One copy, so a change
// to the call's shape cannot reach one and miss the other.
//
// THIS STAYS OUT OF LINE AT LOWERING TIME ON PURPOSE (#4039). The spare-capacity
// fast path is emitted by `expandAppends` (optappend.bit) AFTER inlining, not
// here, because it needs three blocks and the inliner only splices a callee
// with exactly ONE (optinlinecost.bit's `calleeShapeOk`). Emitting it here made
// `std/strings`' `Builder.writeByte` — whose whole body is one `append` —
// un-inlinable, and the caller then paid a real `bl` plus a nine-register
// prologue per byte: measured 1.057e9 -> 1.452e9 cycles on
// `bench/cases/strings`' build phase, a 37% REGRESSION, while retiring 33%
// fewer instructions. Expanding after the inliner has run gets both.
fn emitAppendCall(fc: FnCtx, acc: int, v: int, ctx: AppendPackedCtx): int {
  let ins = mkInstr(Op.RtCall, ctx.sliceTy)
  ins.name = "slice_append"
  ins.args = [acc, v, ctx.refV, ctx.esV]
  return emitRtCall(fc, ins)
}

// The out-of-line `rt_call slice_append_str(h, s)` — a whole string's bytes
// into a `[]u8` (runtime/root/slices.bit's `rtSliceAppendStr`, ABI.md §2).
//
// TWO ARGUMENTS, NOT FOUR. `slice_append` carries `is_ref` and `elem_size`
// because a NULL header has no header to read them from (#1569) and its
// element type could be anything; this primitive's operand rule fixes them at
// `0` and `1` for every call it will ever have, so passing them would be two
// materialized constants per call site stating what the callee already knows.
//
// NO `expandAppends` FAST PATH (optappend.bit, #4039), deliberately: that pass
// rewrites a one-WORD store into three blocks, and there is no inline shape
// for a variable-length byte copy — the copy itself is the work, and
// `copyBytes` (root.bit, #4350) is already the fast version of it. What this
// call removes is the per-byte `bit_rt_string_byte` + `bit_rt_slice_append`
// pair, which is the cost that dominated (#4371).
fn emitAppendStrCall(fc: FnCtx, acc: int, sv: int, ctx: AppendPackedCtx): int {
  let ins = mkInstr(Op.RtCall, ctx.sliceTy)
  ins.name = "slice_append_str"
  ins.args = [acc, sv]
  return emitRtCall(fc, ins)
}
