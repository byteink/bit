// bit lsp (#1547) — the server: JSON-RPC framing over stdio, message dispatch,
// the document-sync lifecycle, and diagnostics publishing. Ported from
// . Sorts last among the `lsp*.bit` siblings so the query methods it
// dispatches to (lspquery.bit) and the pure helpers (lspbase.bit) are lowered
// first.
//
// Output goes through the `print` builtin, which writes straight to fd 1 with no
// buffering, so every framed message is flushed
// the moment it is written — what a long-running language server needs. Input is
// read through a small buffered reader over the `fsRead` primitive rather than
// std/io's Reader: the rest of selfhost is deliberately Option-free and imports
// no stdlib, and rolling the reader here (returning plain strings, "" for EOF)
// keeps the compiler self-contained. It implements the same read-a-line /
// read-N-bytes contract std/io's readLine+readBytes (#1596) offer.

// ---- input: a buffered reader over fsRead ---------------------------------

// A reader over file descriptor `fd`, with `buf` holding bytes pulled but not yet
// consumed. A negative `fd` is a SEALED reader whose `buf` is all the input there
// will ever be — the in-memory form the framing self-check drives.
struct LspReader {
  fd: int,
  buf: string,
}

fn lspStdinReader(): LspReader {
  return LspReader{ fd: 0, buf: "" }
}

// A reader whose entire input is `s`; it never touches a descriptor.
fn lspReaderOverString(s: string): LspReader {
  return LspReader{ fd: -1, buf: s }
}

// Pulls the next chunk from the descriptor, or "" for a sealed reader / EOF.
fn lspReaderRefill(r: LspReader): string {
  if (r.fd < 0) {
    return ""
  }
  return fsRead(r.fd, 4096)
}

// The index of the first '\n' in `s`, or -1.
fn lspIndexNewline(s: string): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == u8('\n')) {
      return i
    }
    i = i + 1
  }
  return -1
}

// One line without its trailing '\n', mirroring std/io's readLine: a final
// newline-less line is still returned. `ok` is false only at true end of input.
struct LspLine {
  ok: bool,
  text: string,
}

fn lspReadLine(r: LspReader): LspLine {
  let line = ""
  while (true) {
    let nl = lspIndexNewline(r.buf)
    if (nl >= 0) {
      line = line + r.buf[0:nl]
      r.buf = r.buf[nl + 1:len(r.buf)]
      return LspLine{ ok: true, text: line }
    }
    line = line + r.buf
    r.buf = ""
    let chunk = lspReaderRefill(r)
    if (len(chunk) == 0) {
      if (len(line) == 0) {
        return LspLine{ ok: false, text: "" }
      }
      return LspLine{ ok: true, text: line }
    }
    r.buf = chunk
  }
  return LspLine{ ok: false, text: "" }
}

// Exactly `n` bytes, or fewer only when input truly ends first — std/io's
// readBytes contract. Consumes any bytes a prior readLine left buffered before
// refilling, so header lines and the counted body come off one stream.
fn lspReadN(r: LspReader, n: int): string {
  let out = ""
  while (len(out) < n) {
    if (len(r.buf) == 0) {
      let chunk = lspReaderRefill(r)
      if (len(chunk) == 0) {
        return out
      }
      r.buf = chunk
    }
    let take = n - len(out)
    if (take > len(r.buf)) {
      take = len(r.buf)
    }
    out = out + r.buf[0:take]
    r.buf = r.buf[take:len(r.buf)]
  }
  return out
}

// ---- JSON-RPC framing ------------------------------------------------------

// `ok` is false at end of stream or on a header block missing Content-Length.
struct LspMessage {
  ok: bool,
  body: string,
}

// Lowercases an ASCII byte, for the case-insensitive header-name compare.
fn lspLowerByte(b: u8): u8 {
  if (b >= u8('A') && b <= u8('Z')) {
    return u8(int(b) + 32)
  }
  return b
}

// True when `line` is a `Content-Length:` header (name compared case-insensitively).
fn lspIsContentLength(line: string): bool {
  let key = "content-length:"
  if (len(line) < len(key)) {
    return false
  }
  let i = 0
  while (i < len(key)) {
    if (lspLowerByte(line[i]) != key[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The integer after the colon of a header line (leading spaces/tabs skipped).
fn lspHeaderIntValue(line: string): int {
  let i = 0
  while (i < len(line) && line[i] != u8(':')) {
    i = i + 1
  }
  i = i + 1
  while (i < len(line) && (line[i] == u8(' ') || line[i] == u8('\t'))) {
    i = i + 1
  }
  let n = 0
  while (i < len(line) && line[i] >= u8('0') && line[i] <= u8('9')) {
    n = n * 10 + (int(line[i]) - int(u8('0')))
    i = i + 1
  }
  return n
}

// Reads one framed message: the header block (bounded at 32 lines), then exactly
// Content-Length body bytes. `ok` false at EOF or on a malformed/absent length.
fn lspReadMessage(r: LspReader): LspMessage {
  let contentLength = -1
  let lines = 0
  while (lines < 32) {
    lines = lines + 1
    let ln = lspReadLine(r)
    if (!ln.ok) {
      return LspMessage{ ok: false, body: "" }
    }
    let line = ln.text
    if (len(line) > 0 && line[len(line) - 1] == u8('\r')) {
      line = line[0:len(line) - 1]
    }
    if (len(line) == 0) {
      lines = 32 // blank line ends the header block
    } else if (lspIsContentLength(line)) {
      contentLength = lspHeaderIntValue(line)
    }
  }
  if (contentLength < 0) {
    return LspMessage{ ok: false, body: "" }
  }
  let body = lspReadN(r, contentLength)
  if (len(body) < contentLength) {
    return LspMessage{ ok: false, body: "" }
  }
  return LspMessage{ ok: true, body: body }
}

// The `Content-Length: N\r\n\r\n<body>` wire form of `body`.
fn lspFrame(body: string): string {
  return "Content-Length: ${len(body)}\r\n\r\n" + body
}

// Writes a framed message to stdout, flushed immediately (print is unbuffered).
fn lspWrite(body: string) {
  print(lspFrame(body))
}

// ---- output helpers --------------------------------------------------------

// The JSON text of a single parsed node (an echoed request id).
fn lspNodeText(d: JsonDoc, id: int): string {
  return string(jsonWriteNode([]u8(0), d, id))
}

// A JSON-RPC success response echoing `idText` with `resultJson` verbatim.
fn lspRespondRaw(idText: string, resultJson: string) {
  lspWrite("{\"jsonrpc\":\"2.0\",\"id\":" + idText + ",\"result\":" + resultJson + "}")
}

// The name query methods call; the id text is threaded to them already rendered.
fn lspRespond(idText: string, resultJson: string) {
  lspRespondRaw(idText, resultJson)
}

fn lspRespondError(idText: string, code: int, message: string) {
  lspWrite("{\"jsonrpc\":\"2.0\",\"id\":" + idText + ",\"error\":{\"code\":${code}," +
    "\"message\":" + jsonEncodeString(message) + "}}")
}

fn lspNotify(method: string, paramsJson: string) {
  lspWrite("{\"jsonrpc\":\"2.0\",\"method\":" + jsonEncodeString(method) +
    ",\"params\":" + paramsJson + "}")
}

// Joins `items` with commas — the array body for a document-symbol or completion
// list already rendered element-by-element.
fn lspJoinComma(items: []string): string {
  let out = ""
  let i = 0
  while (i < len(items)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + items[i]
    i = i + 1
  }
  return out
}

// ---- request-param decoding ------------------------------------------------

// A `textDocument/position` request's URI and 0-based position.
struct LspTdp {
  ok: bool,
  uri: string,
  pos: LspPos,
}

fn lspTextDocPosition(d: JsonDoc, params: int): LspTdp {
  let doc = jsonGet(d, params, "textDocument")
  let uri = jsonStrOf(d, jsonGet(d, doc, "uri"))
  if (uri == "") {
    return LspTdp{ ok: false, uri: "", pos: LspPos{ line: 0, character: 0 } }
  }
  let posNode = jsonGet(d, params, "position")
  let line = jsonIntOf(d, jsonGet(d, posNode, "line"))
  let character = jsonIntOf(d, jsonGet(d, posNode, "character"))
  if (line < 0 || character < 0) {
    return LspTdp{ ok: false, uri: "", pos: LspPos{ line: 0, character: 0 } }
  }
  return LspTdp{ ok: true, uri: uri, pos: LspPos{ line: line, character: character } }
}

// ---- server state ----------------------------------------------------------

// The server's mutable state across messages: the open documents' unsaved buffers
// (absolute path -> text), substituted for disk contents on every recheck.
struct LspServer {
  overlays: map<string, string>,
  shuttingDown: bool,
  // The most recent built projects, newest first (#2326/#2348). A query or a
  // republish is served from one of these whenever every byte the build read is
  // still what it would read now; see compiler/lspbuild.bit for the freshness
  // rule and why the list is bounded at `lspMaxSnapshots`.
  snaps: []LspSnapshot,
  // Directories whose diagnostics are STALE and owed a republish (#2201). A set,
  // not a single directory, because one burst can touch files in more than one
  // project and keeping only the last would leave the others displaying
  // diagnostics for text the user has already replaced.
  pendingDirs: map<string, bool>,
}

fn newLspServer(): LspServer {
  return LspServer{ overlays: map<string, string>{}, shuttingDown: false,
    pendingDirs: map<string, bool>{}, snaps: []LspSnapshot(0) }
}

// ---- dispatch --------------------------------------------------------------

// Parses one message body and routes it: a message with an `id` is a request
// (gets a reply), one without is a notification (never replied to). A malformed
// body is dropped, matching the seed.
fn lspHandleMessage(server: LspServer, body: string) {
  let d = jsonParse(body)
  if (!d.ok) {
    return
  }
  if (jsonKindOf(d, d.root) != JsonKind.Obj) {
    return
  }
  let method = jsonStrOf(d, jsonGet(d, d.root, "method"))
  if (method == "") {
    return
  }
  let params = jsonGet(d, d.root, "params")
  let idNode = jsonGet(d, d.root, "id")
  if (idNode >= 0) {
    lspHandleRequest(server, method, d, params, lspNodeText(d, idNode))
  } else {
    lspHandleNotification(server, method, d, params)
  }
}

fn lspInitializeResult(): string {
  return "{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true," +
    "\"definitionProvider\":true,\"documentSymbolProvider\":true," +
    "\"completionProvider\":{\"triggerCharacters\":[\".\"]}}," +
    "\"serverInfo\":{\"name\":\"bitls\",\"version\":\"0.0.0\"}}"
}

fn lspHandleRequest(server: LspServer, method: string, d: JsonDoc, params: int, idText: string) {
  // #2332: once `shutdown` has been received, every further request errors
  // InvalidRequest rather than being served — checked before dispatch so no
  // handler below ever runs against overlays the client is done editing.
  // `shutdown` itself is handled below and is what FLIPS `shuttingDown`, so it
  // is never caught by this guard on its own (first) call.
  if (server.shuttingDown) {
    lspRespondError(idText, -32600, "invalid request: server is shutting down")
    return
  }
  if (method == "initialize") {
    lspRespond(idText, lspInitializeResult())
    return
  }
  if (method == "shutdown") {
    server.shuttingDown = true
    lspRespond(idText, "null")
    return
  }
  if (method == "textDocument/hover") {
    lspOnHover(server, d, params, idText)
    return
  }
  if (method == "textDocument/definition") {
    lspOnDefinition(server, d, params, idText)
    return
  }
  if (method == "textDocument/completion") {
    lspOnCompletion(server, d, params, idText)
    return
  }
  if (method == "textDocument/documentSymbol") {
    lspOnDocumentSymbol(server, d, params, idText)
    return
  }
  lspRespondError(idText, -32601, "method not found")
}

fn lspHandleNotification(server: LspServer, method: string, d: JsonDoc, params: int) {
  if (method == "textDocument/didOpen") {
    lspOnDidOpen(server, d, params)
    return
  }
  if (method == "textDocument/didChange") {
    lspOnDidChange(server, d, params)
    return
  }
  if (method == "textDocument/didClose") {
    lspOnDidClose(server, d, params)
    return
  }
  // #2332: terminate on `exit`, per spec — code 0 iff `shutdown` was received
  // first, 1 otherwise (an unclean exit). `lspRun`'s stdin-EOF path stays as
  // the safety net for a client that closes the pipe without ever sending
  // `exit`.
  if (method == "exit") {
    if (server.shuttingDown) {
      exit(0)
    }
    exit(1)
    return
  }
  // initialized, didSave, $/cancelRequest, ...: no state to update.
}

// ---- document sync ---------------------------------------------------------

fn lspOnDidOpen(server: LspServer, d: JsonDoc, params: int) {
  let doc = jsonGet(d, params, "textDocument")
  let uri = jsonStrOf(d, jsonGet(d, doc, "uri"))
  let text = jsonStrOf(d, jsonGet(d, doc, "text"))
  if (uri == "") {
    return
  }
  let path = lspUriToPath(uri)
  if (path == "") {
    return
  }
  server.overlays[path] = text
  server.pendingDirs[pathDir(path)] = true
}

fn lspOnDidChange(server: LspServer, d: JsonDoc, params: int) {
  let doc = jsonGet(d, params, "textDocument")
  let uri = jsonStrOf(d, jsonGet(d, doc, "uri"))
  if (uri == "") {
    return
  }
  let changes = jsonGet(d, params, "contentChanges")
  let n = jsonLen(d, changes)
  if (n == 0) {
    return
  }
  // Full sync (textDocumentSync = 1): the last change's `text` is the whole doc.
  let text = jsonStrOf(d, jsonGet(d, jsonAt(d, changes, n - 1), "text"))
  let path = lspUriToPath(uri)
  if (path == "") {
    return
  }
  server.overlays[path] = text
  server.pendingDirs[pathDir(path)] = true
}

fn lspOnDidClose(server: LspServer, d: JsonDoc, params: int) {
  let doc = jsonGet(d, params, "textDocument")
  let uri = jsonStrOf(d, jsonGet(d, doc, "uri"))
  if (uri == "") {
    return
  }
  let path = lspUriToPath(uri)
  if (path == "") {
    return
  }
  delete(server.overlays, path)
  server.pendingDirs[pathDir(path)] = true
}

// ---- diagnostics -----------------------------------------------------------

// The LSP DiagnosticSeverity for a Bit severity (0 error / 1 warning / 2 note).
fn lspSeverity(s: int): int {
  if (s == 1) {
    return 2 // Warning
  }
  if (s == 2) {
    return 4 // Hint
  }
  return 1 // Error
}

// One diagnostic as LSP JSON. `src` is the file's own text and the span is
// already per-file (remapDiags rewrote it), so the range needs no fileStart.
fn lspDiagnosticJson(src: string, dg: Diagnostic): string {
  return "{\"range\":" + lspRangeJson(lspSpanToRange(src, dg.span.start, dg.span.end)) +
    ",\"severity\":${lspSeverity(dg.severity)},\"code\":" +
    jsonEncodeString(codeString(dg.code)) + ",\"source\":\"bitls\",\"message\":" +
    jsonEncodeString(dg.message) + "}"
}

// Rebuilds `dir`'s project against the overlays and publishes one
// `publishDiagnostics` per root-module file. Errors from the rebuild would only
// mean a vanished directory; there is nothing to publish then, so it is skipped.
fn lspRecheckAndPublish(server: LspServer, dir: string) {
  let lp = lspBuildProject(server, dir)
  if (len(lp.mods) == 0) {
    return
  }
  lspPublishDiagnostics(lp.p)
}

// Lint findings for one file's text (#1391), run against a throwaway
// SourceManager/Diagnostics of its own — deliberately NOT `p.diags`. That
// separation is the point: `lspBuildProject` gates the type checker on
// `hasErrors(p.diags)` (lspquery.bit), so if a malformed `// bit:lint`
// directive landed there it would silently kill hover/definition/completion
// the way a real check error does, which is exactly what the CLI's exit 2
// does on purpose and an editor must not. `readLintDirectives` already
// degrades gracefully on its own: a malformed directive reports itself and
// stops reading further directives, but returns whatever config was parsed
// before the error rather than aborting the file, so the rules below still
// run. Cost is one lex pass over `src` per publish, on top of the full
// parse+resolve+(check) `lspBuildProject` already redoes on every keystroke.
// Measured, not assumed: scripts/lsp-lint-perf.sh times the same 40
// didChange->publishDiagnostics round trips against this call site present
// vs. skipped (best-of-3 min, to cancel out this box's build-contention
// noise) — the two came out within ~3% of each other, i.e. no measurable
// keystroke-path regression (#1391).
fn lspLintDiagnostics(src: string): Diagnostics {
  let sm = newSourceManager()
  let d = newDiagnostics(sm)
  let file = addFile(sm, "lint", src)
  let cfg = readLintDirectives(src, file, d)
  // Unlike the CLI, a directive error does not stop the rules below from
  // running: killing hover/completion over a typo'd override would be exactly
  // the silent-collateral-damage the CLI's own exit-2 gate is spared from
  // causing here. Only a file that fails to parse skips them — there is no
  // tree to run a rule against, and the parser's own diagnostic already tells
  // the editor what is wrong. `beforeParse` distinguishes the two: any
  // directive error is already in `d` by this point, so a new entry past it
  // can only be the parser's.
  let beforeParse = len(d.list)
  let tree = parseSourceD(src, file, d)
  if (len(d.list) > beforeParse) {
    // This parse ran only to feed the lint rules a tree, over a throwaway
    // SourceManager of its own (never `p.sm`/`p.diags`). `lspPublishDiagnostics`
    // ALSO publishes the checker's own `p.diags`, which already carries this
    // exact lex/parse diagnostic for this file — `lspBuildProject` parsed the
    // same overlay text via `loadProjectOverlay`. Returning it again here (#2331)
    // published every syntax error twice, byte-identical range and message.
    // Directive errors recorded before `beforeParse` are kept: they exist only
    // here, never in the checker.
    d.list = d.list[0:beforeParse]
    return d
  }
  runLintRules(src, file, tree, cfg, d)
  return d
}

// Publishes diagnostics for the ROOT module's files only — the prelude and
// imported stdlib modules were loaded for name resolution but the user never
// opened them. Diagnostics are keyed by SourceManager FileId, so each file gets
// exactly the diagnostics whose span names it. Lint findings are appended
// alongside the checker's own diagnostics so both render in one editor pass.
fn lspPublishDiagnostics(p: Project) {
  let m = p.mods[p.root]
  let fi = 0
  while (fi < len(m.fileNames)) {
    let fileId = m.files[fi]
    let uri = lspPathToUri(m.dir + "/" + m.fileNames[fi])
    let src = fileSource(p.sm, fileId)
    let items = []string(0)
    let i = 0
    while (i < len(p.diags.list)) {
      let dg = p.diags.list[i]
      i = i + 1
      if (dg.span.file == fileId) {
        items = append(items, lspDiagnosticJson(src, dg))
      }
    }
    let lint = lspLintDiagnostics(src)
    for dg of lint.list {
      items = append(items, lspDiagnosticJson(src, dg))
    }
    lspNotify("textDocument/publishDiagnostics",
      "{\"uri\":" + jsonEncodeString(uri) + ",\"diagnostics\":[" + lspJoinComma(items) + "]}")
    fi = fi + 1
  }
}

// ---- run loop --------------------------------------------------------------

// The `bit lsp` entry: read framed messages from stdin and handle each until the
// stream ends. Called from main's `lsp` arm.
// Republishes every directory an edit left stale, then clears the set.
//
// COALESCED, NOT DEBOUNCED, and the distinction is the design: there is no timer
// here. `lspRun` calls this only once the reader has drained, so a burst collapses
// to ONE check however fast it arrived, while a single lone edit still publishes
// immediately. A time-based debounce would need a clock the server does not have
// and would add latency to the common case of one keystroke.
fn lspFlushPending(server: LspServer) {
  for (dir, _) of server.pendingDirs {
    lspRecheckAndPublish(server, dir)
  }
  server.pendingDirs = map<string, bool>{}
}

// The `bit lsp` entry: read framed messages from stdin and handle each until the
// stream ends. Called from main's `lsp` arm.
//
// DIAGNOSTICS PUBLISH WHEN THE INPUT DRAINS, NOT PER MESSAGE (#2201).
// `lspRecheckAndPublish` rebuilds the whole project — parse, resolve, check — and
// that is tens of seconds on `compiler/`. Doing it inside each `didChange`
// handler meant one full rebuild PER KEYSTROKE, so sustained typing queued work
// faster than it could ever be retired: the released 0.1.5 server was found
// holding a core at 78% with 88 minutes of CPU behind it, still grinding through
// edits made two hours earlier.
//
// `len(r.buf) > 0` is the "more already waiting" test. `lspReadN` consumes only
// its own message and leaves the rest of the chunk buffered, so a backlog — which
// is exactly when many notifications sit in the socket together — leaves bytes
// behind. Measured on this tree: 20 edits to a file in the 136-file `compiler/`
// project produce 136 publishes, i.e. ONE check, against 20 checks before.
//
// A message ending flush with a chunk boundary can leave the buffer empty while
// more bytes are still in the socket, costing one extra check. Bounded, never a
// wrong answer, and closing it needs a readiness probe the compiler has no
// primitive for. Raising the 4096-byte chunk was tried and changed nothing.
fn lspRun() {
  let server = newLspServer()
  let r = lspStdinReader()
  let guard = 0
  while (guard < 1000000) {
    let msg = lspReadMessage(r)
    if (!msg.ok) {
      // NO final flush. End of stream means the client is gone, so rebuilding
      // here would spend tens of seconds producing diagnostics nobody is left to
      // read — the "still grinding after the editor closed" behaviour this
      // change exists to remove.
      return
    }
    lspHandleMessage(server, msg.body)
    if (len(r.buf) == 0) {
      lspFlushPending(server)
    }
    guard = guard + 1
  }
}
