// #2165: a raw NUL/control byte and an unpaired bidirectional formatting
// character are invisible in every editor, diff and code-review surface —
// the Trojan Source primitive (CVE-2021-42574) for the bidi case, and plain
// source corruption for the control-byte case. The lexer already rejects a
// raw NUL outside any literal (E0001, lexer.bit); this extends the same
// idea into the places a human reads source verbatim but the lexer
// previously took bytes unchecked: string literals, comments (#2165), and
// identifiers (#3465).
//
// #3465 widened the SCOPE to identifiers; the code point SET is unchanged —
// see `classifyInvisible` below, still exactly the entries #2165/#2989 chose.
// An invisible code point in a string is data; in an identifier it is a
// second *identity*: `isAdmin` and `isAdmin<ZWSP>` render identically to a
// reviewer and to `git diff` while binding two different symbols. That is
// strictly worse than the string/comment case this rule already covers, not
// a new category, so no new code point was added for it.
//
// Scope, decided against spec/SPEC.md and spec/LINT.md (both silent on
// invisible characters — this is a hardening rule, not a spec violation
// fix, per SPEC §5.7's STR_ELEM which admits any byte except '"', '\' and
// newline, and per SPEC §1's "Identifiers ... may contain any Unicode scalar
// value"):
//   - Interpreted string literals, comments, and identifiers. NOT raw
//     strings (§5.7 defines their bytes as taken "verbatim" — banning bytes
//     there would contradict that guarantee) and NOT rune literals (a
//     single code point is a much smaller attack surface, and out of the
//     ticket's observed cases).
//   - A raw C0 control byte, an UNPAIRED bidi control, and a zero-width
//     formatting character (ZWSP/ZWNJ/ZWJ/WORD JOINER/U+FEFF ZERO WIDTH
//     NO-BREAK SPACE) are all hard errors, one code (E0097): none has a
//     legitimate reason to appear THIS way. A raw control byte and a
//     zero-width character both have a visible escape in a string
//     (`\x..`/`\u{..}` at minimum) — the same "costs authors nothing"
//     argument the ticket makes for `\0` applies unchanged there. An
//     identifier has no escape syntax at all (there is no `\u{..}` inside a
//     name), so for an identifier the rule is simply "remove it" — see
//     `scanInvisibleRun`'s `allowsEscape` parameter, false for identifiers.
//     A *balanced* bidi pair is real, legitimate RTL text and is the one
//     case left completely alone: only an unpaired control, which has no
//     legitimate reading at all, is rejected — this holds for identifiers
//     too, since `scanInvisibleRun` is the same balance-tracking scan over
//     the identifier's own byte range. #2989 added U+FEFF ZERO WIDTH
//     NO-BREAK SPACE to this set: this rule only ever sees it past offset 0,
//     since every production entry point strips a leading BOM before the
//     lexer runs (spec/SPEC.md:68, lexer.bit's `stripBom`), so a mid-file
//     U+FEFF found here is never a BOM — it is the same invisible-character
//     case as the other zero-width entries.
//   - This repo's `bit lint` is override-able per-file (spec/LINT.md §5)
//     and does not fail `bit build` (§2.1) — neither fits "a build cannot
//     ignore" for a construct with zero legitimate raw use, which is why
//     every case here is a `bit check`/`bit build` error, not a lint
//     finding.
//   - Out of scope, unchanged by #3465: U+00AD SOFT HYPHEN, U+180E MONGOLIAN
//     VOWEL SEPARATOR, U+2028 LINE SEPARATOR, U+3164 HANGUL FILLER and
//     U+00A0 NO-BREAK SPACE are accepted in a string today and stay accepted
//     in an identifier too — that is a pre-existing classifier coverage gap
//     (#3465's ticket says so explicitly), not a decision this change makes.
//     An ordinary non-ASCII identifier (Greek, CJK, ...) is untouched: none
//     of its code points fall in `classifyInvisible`'s matched set.

// E0097: raw control byte, unpaired bidi embedding/override/isolate
// control, or zero-width formatting character, in a string literal,
// comment, or identifier.
const ecInvisibleControl = 97

// One matched invisible/formatting character at a source position. `isBidi`
// false means a zero-width character; true means a bidi
// embedding/override/isolate control, further split by `isOpen` (push vs
// pop) and `isolate` (which of the two independent bidi stacks it belongs
// to — UAX #9 keeps isolates and embeddings/overrides on separate stacks,
// so a PDI never closes an LRE and a PDF never closes an LRI).
class InvisibleChar {
  found: bool,
  name: string,
  hex: string,
  isBidi: bool,
  isOpen: bool,
  isolate: bool,
}

fn noInvisibleChar(): InvisibleChar {
  return InvisibleChar{
    found: false,
    name: "",
    hex: "",
    isBidi: false,
    isOpen: false,
    isolate: false,
  }
}

// Every target character is a 3-byte UTF-8 sequence under lead byte 0xE2
// (U+2000 block) or 0xEF (U+FEFF only) — classifies `src[i:i+3]`, or reports
// not-found for anything else (including a truncated tail).
//
// U+FEFF ZERO WIDTH NO-BREAK SPACE (EF BB BF) is the same class of character
// as U+2060 WORD JOINER: invisible, with a visible escape (`\u{FEFF}`), and
// no legitimate raw use at this position. This function only ever sees bytes
// the lexer already treats as ordinary source content — every production
// entry point calls `stripBom` first (lexer.bit:40), which removes EF BB BF
// only when it is the file's first three bytes. So a BOM found here is never
// offset 0: it is always a mid-file occurrence, which is not a BOM at all
// per spec/SPEC.md:68 ("if present as the first character") and is exactly
// the invisible-character case E0097 exists to reject.
fn classifyInvisible(src: string, i: int): InvisibleChar {
  if (i + 3 > len(src)) {
    return noInvisibleChar()
  }
  let b0 = src[i]
  if (b0 == u8(0xEF)) {
    if (src[i + 1] == u8(0xBB) && src[i + 2] == u8(0xBF)) {
      return InvisibleChar{
        found: true,
        name: "U+FEFF ZERO WIDTH NO-BREAK SPACE",
        hex: "FEFF",
        isBidi: false,
        isOpen: false,
        isolate: false,
      }
    }
    return noInvisibleChar()
  }
  if (b0 != u8(0xE2)) {
    return noInvisibleChar()
  }
  let b1 = src[i + 1]
  let b2 = src[i + 2]
  if (b1 == u8(0x80)) {
    if (b2 == u8(0x8B)) {
      return InvisibleChar{
        found: true,
        name: "U+200B ZERO WIDTH SPACE",
        hex: "200B",
        isBidi: false,
        isOpen: false,
        isolate: false,
      }
    }
    if (b2 == u8(0x8C)) {
      return InvisibleChar{
        found: true,
        name: "U+200C ZERO WIDTH NON-JOINER",
        hex: "200C",
        isBidi: false,
        isOpen: false,
        isolate: false,
      }
    }
    if (b2 == u8(0x8D)) {
      return InvisibleChar{
        found: true,
        name: "U+200D ZERO WIDTH JOINER",
        hex: "200D",
        isBidi: false,
        isOpen: false,
        isolate: false,
      }
    }
    if (b2 == u8(0xAA)) {
      return InvisibleChar{
        found: true,
        name: "U+202A LEFT-TO-RIGHT EMBEDDING",
        hex: "202A",
        isBidi: true,
        isOpen: true,
        isolate: false,
      }
    }
    if (b2 == u8(0xAB)) {
      return InvisibleChar{
        found: true,
        name: "U+202B RIGHT-TO-LEFT EMBEDDING",
        hex: "202B",
        isBidi: true,
        isOpen: true,
        isolate: false,
      }
    }
    if (b2 == u8(0xAC)) {
      return InvisibleChar{
        found: true,
        name: "U+202C POP DIRECTIONAL FORMATTING",
        hex: "202C",
        isBidi: true,
        isOpen: false,
        isolate: false,
      }
    }
    if (b2 == u8(0xAD)) {
      return InvisibleChar{
        found: true,
        name: "U+202D LEFT-TO-RIGHT OVERRIDE",
        hex: "202D",
        isBidi: true,
        isOpen: true,
        isolate: false,
      }
    }
    if (b2 == u8(0xAE)) {
      return InvisibleChar{
        found: true,
        name: "U+202E RIGHT-TO-LEFT OVERRIDE",
        hex: "202E",
        isBidi: true,
        isOpen: true,
        isolate: false,
      }
    }
    return noInvisibleChar()
  }
  if (b1 == u8(0x81)) {
    if (b2 == u8(0xA0)) {
      return InvisibleChar{
        found: true,
        name: "U+2060 WORD JOINER",
        hex: "2060",
        isBidi: false,
        isOpen: false,
        isolate: false,
      }
    }
    if (b2 == u8(0xA6)) {
      return InvisibleChar{
        found: true,
        name: "U+2066 LEFT-TO-RIGHT ISOLATE",
        hex: "2066",
        isBidi: true,
        isOpen: true,
        isolate: true,
      }
    }
    if (b2 == u8(0xA7)) {
      return InvisibleChar{
        found: true,
        name: "U+2067 RIGHT-TO-LEFT ISOLATE",
        hex: "2067",
        isBidi: true,
        isOpen: true,
        isolate: true,
      }
    }
    if (b2 == u8(0xA8)) {
      return InvisibleChar{
        found: true,
        name: "U+2068 FIRST STRONG ISOLATE",
        hex: "2068",
        isBidi: true,
        isOpen: true,
        isolate: true,
      }
    }
    if (b2 == u8(0xA9)) {
      return InvisibleChar{
        found: true,
        name: "U+2069 POP DIRECTIONAL ISOLATE",
        hex: "2069",
        isBidi: true,
        isOpen: false,
        isolate: true,
      }
    }
    return noInvisibleChar()
  }
  return noInvisibleChar()
}

// A raw C0 control byte with no place inside a literal or comment: every one
// has a visible escape spelling (`\xNN` at minimum), so a raw occurrence is
// never an author's intent. Excludes '\t' (0x09, renders visibly) and '\n'
// (0x0A, ordinary line structure — and a string literal never reaches this
// check carrying one, since a raw newline already ends it unterminated).
fn isBannedControlByte(c: u8): bool {
  return c < u8(0x20) && c != u8(0x09) && c != u8(0x0A)
}

// The hint for a zero-width formatting character (ZWSP/ZWNJ/ZWJ/WORD
// JOINER/U+FEFF), extracted out of `scanInvisibleRun` rather than branched
// inline so that adding identifier support did not add another decision
// point to a function whose complexity was already over this repo's E0204
// limit before this change. A string or a comment can point at the escaped
// spelling; an identifier has no escape syntax at all, so "remove it" is
// the only correct advice there.
fn zeroWidthHint(hex: string, allowsEscape: bool): string {
  if (allowsEscape) {
    return "use an escape such as \\u{" + hex + "} instead"
  }
  return "remove this character"
}

// Scans `lx.src[start:end]` — already-consumed literal, comment, or
// identifier text — for raw control bytes and invisible/bidi formatting
// characters, reporting through `lx.diags`. `what` is the full noun phrase
// naming the context in the diagnostic message, article included ("a string
// literal", "a comment", "an identifier"). `allowsEscape` says whether the
// zero-width-character hint should point at an escape spelling (`\u{..}`):
// true for a string and a comment (unchanged from #2165/#2989 — both accept
// the escaped form in review text even though a comment does not itself
// interpret it), false for an identifier, which has no escape syntax of any
// kind — "remove it" is the only correct hint there. Bounded by `end -
// start`, the span the caller already scanned.
//
// Bidi balance is tracked with one depth counter per stack (embeddings and
// overrides share a stack in UAX #9's model; isolates are the other) and is
// scoped to this single call — one string segment, one comment, or one
// identifier. A control opened in one interpolation segment and closed in
// the next is therefore always unpaired here, which is the conservative,
// safe direction: it is also exactly the kind of split a reviewer is least
// likely to notice.
fn scanInvisibleRun(lx: Lexer, start: int, end: int, what: string, allowsEscape: bool) {
  let i = start
  let embedDepth = 0
  let embedOpenAt = start
  let isolateDepth = 0
  let isolateOpenAt = start
  while (i < end) {
    let c = lx.src[i]
    if (isBannedControlByte(c)) {
      lexReport(
        lx, ecInvisibleControl, i, i + 1,
        "raw control byte 0x" + hex2(c) + " in " + what,
        "use an escape such as \\x" + hex2(c) + " instead",
      )
      i = i + 1
      continue
    }
    if (c < u8(0x80)) {
      i = i + 1
      continue
    }
    let m = classifyInvisible(lx.src, i)
    if (!m.found) {
      i = i + 1
      continue
    }
    if (m.isBidi) {
      if (m.isolate) {
        if (m.isOpen) {
          if (isolateDepth == 0) {
            isolateOpenAt = i
          }
          isolateDepth = isolateDepth + 1
        } else if (isolateDepth == 0) {
          lexReport(
            lx, ecInvisibleControl, i, i + 3,
            m.name + " in " + what + " closes no matching isolate",
            "remove this character, or open an isolate before it",
          )
        } else {
          isolateDepth = isolateDepth - 1
        }
      } else {
        if (m.isOpen) {
          if (embedDepth == 0) {
            embedOpenAt = i
          }
          embedDepth = embedDepth + 1
        } else if (embedDepth == 0) {
          lexReport(
            lx, ecInvisibleControl, i, i + 3,
            m.name + " in " + what + " closes no matching embedding or override",
            "remove this character, or open an embedding/override before it",
          )
        } else {
          embedDepth = embedDepth - 1
        }
      }
    } else {
      lexReport(
        lx, ecInvisibleControl, i, i + 3,
        m.name + " in " + what + " is invisible in review",
        zeroWidthHint(m.hex, allowsEscape),
      )
    }
    i = i + 3
  }
  if (embedDepth > 0) {
    lexReport(
      lx, ecInvisibleControl, embedOpenAt, embedOpenAt + 3,
      "unpaired bidi embedding or override control in " + what,
      "every LRE/RLE/LRO/RLO needs a matching POP DIRECTIONAL FORMATTING (U+202C)",
    )
  }
  if (isolateDepth > 0) {
    lexReport(
      lx, ecInvisibleControl, isolateOpenAt, isolateOpenAt + 3,
      "unpaired bidi isolate control in " + what,
      "every LRI/RLI/FSI needs a matching POP DIRECTIONAL ISOLATE (U+2069)",
    )
  }
}
