// Self-host Stage 2 (#1337): the type checker.
// This first chunk is the inference skeleton + the `--dump-types` surface: it
// assigns a TypeId to every node (`nodeTypes`), infers literal expressions and
// their default types, resolves simple type annotations, and renders the
// binding/arrow-param/call type dump the seed's `bit --dump-types` emits. The
// full inference (idents, calls, operators, generics — needs resolve + method
// sets) grows on top, verified by the corpus `--dump-types` differential.
// No max-file-lines suppression: the 4246-line debt this file carried is gone
// (#1809 split it into the check*.bit siblings). If a future change pushes this
// back over 800, split again — do not restore the directive.

// A 0-based source position (line, column) for the dump gutter.
class LineCol {
  line: int,
  col: int,
}

// Maps a byte offset to 0-based line/column. Bounded by the offset.
fn locateOffset(source: string, offset: int): LineCol {
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < offset) {
    if (source[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  return LineCol{ line: line, col: offset - lineStart }
}

class Checker {
  ctx: TypeContext,
  tree: Tree,
  source: string,
  // True when RESOLUTION already failed before this module was checked. The
  // seed's CLI short-circuits the checker entirely on a resolver error (an
  // undefined name makes every downstream type a guess), so any check-stage
  // diagnostic it would have produced never appears. Module-state validation
  // (§11.11) honours the same rule rather than reporting into a broken tree —
  // otherwise bit2 reports where the seed is silent, which is the one
  // divergence direction that breaks builds.
  resolveFailed: bool,
  nodeTypes: []int,
  // name -> TypeId for the bindings/params in scope, and name -> result type for
  // top-level functions (a pre-pass fills the latter so forward calls resolve).
  // ponytail: one flat env, no per-function scoping yet — fine until two
  // functions bind the same name to different types.
  env: map<string, int>,
  funcResults: map<string, int>,
  // Declared class/enum/alias name -> its named TypeId.
  userTypes: map<string, int>,
  // Free-function name -> its full `(params) => result` func TypeId, so a bare
  // function reference (`let g = inc`) types as a first-class value.
  funcSigs: map<string, int>,
  // Free-function name -> its FuncDecl node, so a generic call can substitute
  // its type parameters from the argument types at the call site.
  funcDecls: map<string, int>,
  // SPEC 11.7: free-function name -> true when it is an `extern function`. This
  // is what tells lowering to emit a declaration carrying the RAW symbol name
  // instead of a module-qualified definition.
  externFns: map<string, bool>,
  // Type-parameter TYPE ID -> its constraint interface type, so a method call on
  // a constrained generic value `s.area()` (s: T, `T: Shape`) resolves via
  // Shape. Keyed by id, not by name: every decl's `T` is a distinct TypeParam
  // id, so a name key let the module's LAST `<T: I>` decide every other decl's
  // `T` (#1551 — `first<T: Boxy>` was checked against `Wordy`).
  typeParamConstraints: map<int, int>,
  // Local/param name -> its declared type NODE (rebound per function in
  // lowering), so a generic-enum scrutinee `o: Opt<i64>` can recover its type
  // arguments for match-binder substitution.
  declTypeNodes: map<string, int>,
  // Binding DECL NODE -> the CALL node that initialized it, for an un-annotated
  // `let found = find<i64>(xs, …)`. A generic INSTANCE type carries no type
  // arguments (`Option<i64>` and `Option<string>` are one TypeId, deliberately —
  // carrying them would move --dump-types off seed parity), and `declTypeNodes`
  // only has an entry when the type was WRITTEN. So a type param reachable only
  // through `Option<T>` had nothing to bind from and `unwrap(found)` stayed a
  // bare type param (#1498). Recording the initializer lets the binder re-derive
  // the instance's type arguments on demand instead.
  //
  // Keyed by NODE, read through the resolver (nodeSymbols -> Symbol.decl), so two
  // functions that each write `let found = …` do not share one slot (#1536). The
  // name-keyed shape this replaced was not merely a missed bind: two functions
  // that each bound `found` from a `find<T>` of a DIFFERENT T miscompiled to a
  // segfault, because the loser re-derived its type args from the winner's
  // initializer and the guards cannot see that both are well-formed.
  declInitNodes: map<int, int>,
  // Named type -> its decl node, so a forward reference during declTypeOf can
  // reserve+resolve it on first touch (the seed's declTypeOf recursion), giving
  // type ids in source-order touch order (needed for method-name mangling).
  typeDecls: map<string, int>,
  // A generic list node (`<T, U>`) -> that decl's OWN TypeParam ids, in
  // declaration order. `userTypes[name]` cannot answer this: every generic
  // registers its params under their bare names, so the last `<T>` declared in
  // the module wins and an earlier decl's `T` becomes unreachable by name. The
  // ids are what a template body's checked types actually mention, so
  // monomorphization needs them exactly (see genericEnvOf).
  genericParamIds: map<int, []int>,
  // --- module identity (#1345) --------------------------------------------
  // This module's id. The root is the module being built; lowering leaves the
  // root's names bare (so `main` stays `main`) and prefixes every other
  // module's with `m<id>$`.
  moduleId: int,
  // True for the ROOT module of a build — `Project.root`, the module whose
  // `main` the entry trampoline branches to (SPEC §17.4). `moduleId` cannot
  // answer this: the root is not module 0 (the loader loads a module's imports
  // before the module itself), so the id carries no such meaning. Only the
  // §17.4 entry-point rule reads it (validateentry.bit), and it must: a
  // library module's `main` is prefixed `m<id>$` and is an ordinary function.
  entryModule: bool,
  // Every module's checker, indexed by module id. A name imported from another
  // module has its DECLARATION in that module's tree, so reading the decl needs
  // that module's `tree`/`source` — see `declOwner`. Type information does not:
  // TypeIds are global to the shared TypeContext, so an import copies the
  // exporting module's type entries straight into the maps above and the whole
  // checker keeps working name-keyed and unchanged.
  mods: []Checker,
  // Local name -> where it was imported from. A name absent here is declared in
  // this module.
  importedFrom: map<string, ImportOrigin>,
  // The names this module declares under `export` — the only ones another
  // module may import, and the set the prelude auto-imports everywhere.
  exports: map<string, bool>,
  // Import path text ("std/fs") -> module id, filled by the loader before
  // checking. -1 marks a path that resolved to no module.
  importPaths: map<string, int>,
  // Module-scope binding name -> type, for `const`/`let` declared at the top
  // level. `env` cannot answer this: it is FLAT, so a function-local `let e`
  // anywhere in the module overwrites the module-level `e`'s entry and never
  // restores it. An importer that read `env` therefore inherited the LOCAL's
  // type for an exported constant — a silent miscompile (#1499). Written only
  // by top-level bindings, so it is the one honest source for `importName`.
  moduleEnv: map<string, int>,
  // Namespace alias -> module id, from `import ns from "..."` / `import * as ns`.
  // Every export of that module is ALSO bound in the maps above under the dotted
  // key "ns.name", so `ns.member` resolves through the same name-keyed lookups a
  // plain `import { member }` uses — see `bindNamespaceImports`.
  namespaces: map<string, int>,
  // An ArrowFn NODE -> the function type the arrow is written against, where
  // the source supplies one (#1487). The seed threads an `expected` type down
  // every checkExpr; this checker infers bottom-up and has no such parameter,
  // so the two positions that can supply one — an annotated binding's
  // initializer and a resolved free call's argument — record it here, keyed by
  // node, before anything types an arrow. Sparse: arrows are rare, and only
  // `checkArrowFn` ever reads it.
  arrowExpected: map<int, int>,
  // An arrow's own function type, keyed by node, as computed while its params
  // were still in scope. The flat env holds ONE binding per name, so
  // re-deriving an arrow's type after its scope closed — which lowering does
  // through `nodeType` — resolves the arrow's own params against whatever else
  // now owns those names. See `checkArrowFn` for why the memo only ever
  // rescues an invalid re-derivation, never overrides a good one.
  arrowTypes: map<int, int>,
  // An unannotated ArrowP NODE -> the parameter type taken from the function
  // type the enclosing arrow is written against (#2275/#2277). `arrowExpected`
  // above supplies the whole signature; this is its per-parameter projection,
  // keyed by node so both the main pass's ArrowP handler and `checkArrowFnAt`
  // read the same answer without either having to find the other's parent.
  arrowParamTypes: map<int, int>,
  // --- resolver handoff (#1370) -------------------------------------------
  // The resolver's per-node symbol table for THIS module: `nodeSymbols[node]`
  // is the symbol id an identifier reference resolves to (0 = none), and
  // `symbols[id]` is that Symbol. Empty on the bare dump entry points (which
  // never run the resolver); checkExprType falls back to the flat env there and
  // whenever a reference has no resolved decl (imports, builtins).
  symbols: []Symbol,
  nodeSymbols: []int,
  // A local decl's name-ident NODE -> its type, recorded where the flat env is
  // written. Keyed by node, it is immune to the same-name-across-functions
  // clobbering the flat env suffers, so an identifier typed via its resolved
  // decl (nodeSymbols) is always this decl's type — inside a generic body it
  // holds the template type, which lowering's `nodeType` substitutes exactly as
  // it does the env's, so the two paths agree byte-for-byte.
  declTypes: []int,
  // --- diagnostics --------------------------------------------------------
  // Where validation (validate.bit) reports to. Every module in a project
  // shares one sink, so `renderDiags` prints the whole build's errors in one
  // pass and `hasErrors` is a single question.
  diags: Diagnostics,
  // This module's files, as SourceManager ids and as the module-global offset
  // each one's text begins at — parallel arrays mirroring the SrcModule's
  // fileNames/fileStarts. A module is its files concatenated, so a span is
  // module-global and needs both to name a file and a line (see `vSpan`).
  files: []int,
  fileStarts: []int,
}

// Where an imported name comes from: the module that declares it, and the name
// it is declared under THERE — which differs from the local name whenever the
// import renames it (`import { readFile as slurp }`). Both are needed: the
// declaration is looked up in the exporter under `name`, and the link symbol is
// built from `name` too, so an alias never reaches the object file.
class ImportOrigin {
  module: int,
  name: string,
}

// One generic-function instantiation: the module that DECLARES the generic, the
// generic's name there, and the concrete argument types it was called with (one
// per parameter, in order). `module` is what makes an instantiation of an
// imported generic resolve to one symbol from every caller.
//
// `site` is the FIRST call site this (module, name, args) combo was recorded
// from (#3827) — one instantiation is shared by every call that supplies these
// arguments, so this is a representative site, not an exhaustive one. It exists
// so a diagnostic raised while validating the instantiated body (E0073's
// `vInstInterp`) can point back at the user's own call instead of only at the
// generic's declaration, which the user may not own or be able to edit.
class Instantiation {
  module: int,
  name: string,
  args: []int,
  site: Span,
}

// A checker over one module's concatenated source. The diagnostics sink it comes
// with is a private one over a single unnamed file — enough for the dump entry
// points, which parse a bare source string. `checkProject` replaces it (and the
// file map) with the project's shared sink, so real builds render real paths.
fn newChecker(tree: Tree, source: string, ctx: TypeContext): Checker {
  let nt = []int(0)
  let i = 0
  while (i < len(tree.nodes)) {
    nt = append(nt, 0)
    i = i + 1
  }
  let dt = []int(0)
  let d = 0
  while (d < len(tree.nodes)) {
    dt = append(dt, 0)
    d = d + 1
  }
  let sm = newSourceManager()
  let f = addFile(sm, "", source)
  return Checker{ ctx: ctx, tree: tree, source: source, nodeTypes: nt,
    arrowExpected: map<int, int>{}, arrowTypes: map<int, int>{},
    arrowParamTypes: map<int, int>{},
    symbols: []Symbol(0), nodeSymbols: []int(0), declTypes: dt,
    diags: newDiagnostics(sm), files: [f], fileStarts: [0],
    env: map<string, int>{}, funcResults: map<string, int>{}, userTypes: map<string, int>{},
    funcSigs: map<string, int>{}, funcDecls: map<string, int>{},
    externFns: map<string, bool>{},
    typeParamConstraints: map<int, int>{},
    declTypeNodes: map<string, int>{}, declInitNodes: map<int, int>{},
    typeDecls: map<string, int>{}, genericParamIds: map<int, []int>{},
    moduleId: 0, mods: []Checker(0),
    importedFrom: map<string, ImportOrigin>{}, exports: map<string, bool>{},
    importPaths: map<string, int>{}, namespaces: map<string, int>{},
    moduleEnv: map<string, int>{} }
}

// The declared name of a top-level decl node. A FuncDecl carries its name at
// kid 1 (kid 0 is the optional receiver); every other decl has it at kid 0.
// Getting this wrong reads a receiver as a name and exports nothing.
fn topDeclName(c: Checker, node: int): string {
  let n = getNode(c.tree, node)
  if (n.tag == Tag.FuncDecl) {
    let k = kidsOf(c.tree, node)
    if (k[1] == 0) {
      return ""
    }
    let nm = getNode(c.tree, k[1])
    return c.source[nm.span.start:nm.span.end]
  }
  // SPEC 11.7: an extern decl carries its name at kid 0 (there is no receiver).
  if (n.tag == Tag.ExternFnDecl) {
    let k = kidsOf(c.tree, node)
    if (k[0] == 0) {
      return ""
    }
    let en = getNode(c.tree, k[0])
    return c.source[en.span.start:en.span.end]
  }
  if (n.tag == Tag.StructDecl || n.tag == Tag.EnumDecl || n.tag == Tag.InterfaceDecl ||
      n.tag == Tag.TypeAlias) {
    return declName(c, node)
  }
  return ""
}

// Records every name declared under `export` — the decls this module makes
// importable. `export` wraps its decl rather than replacing it, so the collect
// pass already sees the inner node; this only records visibility.
fn collectExports(c: Checker) {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.Export) {
      let inner = kidsOf(c.tree, i)[0]
      if (inner != 0) {
        // `export const A = 1, B = 2` / `export let s: int` declares one name per
        // BINDING, so it has no single decl name. Omitting them left every
        // exported constant and every piece of module state out of `exports` —
        // invisible to a namespace import and to the prelude's auto-import,
        // though a named `import { A }` still found it (that path never consults
        // this table).
        let it = getNode(c.tree, inner).tag
        if (it == Tag.ConstDecl || it == Tag.LetDecl) {
          for b of kidsOf(c.tree, inner) {
            if (b != 0) {
              c.exports[declName(c, b)] = true
            }
          }
        }
        let nm = topDeclName(c, inner)
        if (nm != "") {
          c.exports[nm] = true
        }
      }
    }
    i = i + 1
  }
}

// SPEC 11.7: an `extern function` node is [name, params, result_or_none] — three
// kids — where a FuncDecl is [recv, name, generics, params, result, body(, attrs)].
// Every reader that indexes a FuncDecl's kid 2/3/4 must branch on the tag first
// or it runs off the end of the kid list. An extern is never generic and never
// has a receiver, so the generic paths simply bail on one.
fn isExternDecl(t: Tree, decl: int): bool {
  return getNode(t, decl).tag == Tag.ExternFnDecl
}

// The parameter-list node of either decl shape, or -1 when the callee is
// generic (its arity and param types are resolved by instantiation, so callers
// skip it). This is the safe reader the comment above demands: a FuncDecl keeps
// its params at kid 3 behind a generics list at kid 2, while an ExternFnDecl —
// three kids, never generic — keeps them at kid 1. Reading an extern with
// FuncDecl indices runs off the end when it declares no result, and silently
// mistakes its RESULT node for a generics list when it declares one.
fn declParamListNode(owner: Checker, decl: int): int {
  let dk = kidsOf(owner.tree, decl)
  if (isExternDecl(owner.tree, decl)) {
    return dk[1] // SPEC 11.7: [name, params, result_or_none]
  }
  if (dk[2] != 0) {
    return -1 // generic
  }
  return dk[3]
}

// The checker whose tree holds `name`'s declaration: this one, unless `name` was
// imported. Every site that reads a declaration NODE for a name must go through
// this, because a node index only means anything inside its own tree — reading
// an imported function's decl against the importing module's tree would land on
// an unrelated node and silently miscompile.
fn declOwner(c: Checker, name: string): Checker {
  // Local shadows import (see funcDeclLookup): a function this module declares
  // itself owns its node in THIS tree, never the exporter's — so the two agree
  // on which tree `funcDeclLookup`'s node belongs to.
  let (_, ok0) = c.funcDecls[name]
  if (ok0) {
    return c
  }
  let (o, ok) = c.importedFrom[name]
  if (!ok || o.module < 0 || o.module >= len(c.mods)) {
    return c
  }
  return c.mods[o.module]
}

// `name` as the module that declares it spells it — the same name, unless this
// module imported it under an alias.
fn declName2(c: Checker, name: string): string {
  let (o, ok) = c.importedFrom[name]
  if (!ok) {
    return name
  }
  return o.name
}
