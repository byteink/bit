// compiler/classjsondecode.bit — the decoder `jsonDecode<T>` specialises to
// (#3977). The mirror of classjsonbuild.bit: where that file builds a `Json`
// from a class's fields, this one extracts a class's fields out of a `Json`.
//
// What one class turns into, written out, is exactly what a reader would have
// hand-written against stdlib/json/decode.bit's named helpers:
//
//     fn __json_dec_User(__json_j: Json, __json_p: string, __json_d: i64): User! {
//       let __json_o = jsonDecObject(__json_j, __json_p, __json_d)?
//       jsonDecUnknown(__json_o, __json_p, ["id", "tags", "addr"])?
//       let __json_x0 = i64(jsonDecIntKey(
//         jsonDecMember(__json_o, __json_p, "id")?, __json_p, "id")?)
//       let __json_dp1 = jsonDecPath(__json_p, "tags")
//       let __json_x1: []string = []
//       let __json_di1 = 0
//       for __json_dv1 of jsonDecArray(
//         jsonDecMember(__json_o, __json_p, "tags")?, __json_dp1, __json_d)? {
//         __json_x1 = append(__json_x1, jsonDecStringIndex(__json_dv1, __json_dp1, __json_di1)?)
//         __json_di1 = __json_di1 + 1
//       }
//       let __json_x2 = __json_dec_Addr(
//         jsonDecMember(__json_o, __json_p, "addr")?, jsonDecPath(__json_p, "addr"), __json_d + 1)?
//       return User{ id: __json_x0, tags: __json_x1, addr: __json_x2 }
//     }
//
// THE PATH IS THREADED, NOT RECONSTRUCTED. Every helper takes the path of the
// value it is looking at, so a failure two levels down already knows it is
// `address.postcode` — nothing catches and re-prefixes on the way out, which
// would need a `catch` per call and would lose the path the moment one was
// forgotten.
//
// THREADED, BUT NOT JOINED UNTIL SOMETHING FAILS (#4502). A scalar gets the
// containing path and its own key or index as two arguments — `jsonDecIntKey`,
// `jsonDecStringIndex` — and stdlib/json/decode.bit builds the dotted string
// inside its `fail`. The `jsonDecPath`/`jsonDecIndex` calls that remain above
// are the ones whose RESULT is read on the success path: a slice or map field
// binds its own path once for `jsonDecArray`/`jsonDecEntries` to report against,
// and a nested class's decoder is handed a real string because it threads it
// down to its own fields. Both are once per container, not once per scalar.
//
// THE DEPTH IS THREADED TOO, and it is not decoration: a `@json` class may be
// self-referential (`class Node { next: Option<Node> }`), so the recursion this
// generates is bounded by the INPUT, not by the class. `__json_d` counts levels
// entered; every descent passes `__json_d + 1` and every container level is
// checked, so `jsonDecObject`/`jsonDecArray` refuse past
// `jsonMaxDecodeDepth` rather than exhausting the stack.
//
// SPANS follow classjsonbuild.bit exactly: every node a diagnostic could land
// on carries the span of the FIELD it came from.

// The synthesized decoder's parameters and its one shared local. The `__json_`
// prefix is not a reservation and does not need to be: these live in the
// function's own scope, which contains nothing the user wrote.
const jsonDecParamJ = "__json_j"
const jsonDecParamP = "__json_p"
const jsonDecParamD = "__json_d"
const jsonDecEntriesLocal = "__json_o"

// The names of stdlib/json/decode.bit's runtime half. Listed once, here,
// because they are simultaneously the words the module source needs and the
// items the synthesized import has to bind — two lists that must not drift.
fn jsonDecHelperNames(): []string {
  return [
    "jsonDecObject", "jsonDecUnknown", "jsonDecMember", "jsonDecOptMember",
    "jsonDecArray", "jsonDecEntries", "jsonDecPath", "jsonDecIndex",
    "jsonDecIntKey", "jsonDecFloatKey", "jsonDecBoolKey", "jsonDecStringKey",
    "jsonDecIntIndex", "jsonDecFloatIndex", "jsonDecBoolIndex",
    "jsonDecStringIndex",
  ]
}

// The synthesized decoder for class `name`. One per `@json` class that is
// actually decoded somewhere in the project — never for every marked class,
// which would put a dead function in every binary that only ever encodes.
fn jsonDecName(name: string): string {
  return "__json_dec_${name}"
}

// The per-field locals, numbered by the field's index among the class's
// accepted fields so two fields never collide. `x` holds the decoded value and
// is the only one every field has; `p` the field's path, `i` an array cursor,
// `v`/`e` a loop binder, `m` an `Option`'s raw member, `a` a container
// field's decoded contents — an array field's elements, a map field's
// entries.
fn jsonDecLocalX(i: int): string {
  return "__json_x${i}"
}

fn jsonDecLocalP(i: int): string {
  return "__json_dp${i}"
}

fn jsonDecLocalI(i: int): string {
  return "__json_di${i}"
}

fn jsonDecLocalV(i: int): string {
  return "__json_dv${i}"
}

fn jsonDecLocalE(i: int): string {
  return "__json_de${i}"
}

fn jsonDecLocalA(i: int): string {
  return "__json_da${i}"
}

fn jsonDecLocalM(i: int): string {
  return "__json_dm${i}"
}

// Every word a decoder for `classes` needs in the module source. The FIXED half
// is appended whole for the same reason `jsonSynthWords` appends its own: a list
// that tracked which helpers are reachable would be a second copy of the
// builder's dispatch, and the two going out of step is exactly what
// `synthSpan`'s panic exists to catch.
fn jsonDecodeSynthWords(jx: JsonCtx, classes: []JsonClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    jsonDecParamJ, jsonDecParamP, jsonDecParamD, jsonDecEntriesLocal,
    "Json", "JsonEntry", "string", "i64", "append", "isSome", "unwrap", "len",
    "key", "value", "Some", "None", "0", "1",
  ]
  for h of jsonDecHelperNames() {
    out = append(out, h)
  }
  for c of classes {
    out = append(out, jsonDecName(identText(jx.tree, jx.source, c.className)))
    for f of c.fields {
      for w of jsonDecFieldWords(jx, f) {
        out = append(out, w)
      }
    }
  }
  return out
}

// One field's words: its key (when it is not a `@key` literal already in the
// source), its locals, and the decoder name of any nested `@json` class it
// reaches.
fn jsonDecFieldWords(jx: JsonCtx, f: JsonField): []string {
  let out = [
    jsonDecLocalX(f.index), jsonDecLocalP(f.index), jsonDecLocalI(f.index),
    jsonDecLocalV(f.index), jsonDecLocalE(f.index), jsonDecLocalM(f.index),
    jsonDecLocalA(f.index),
  ]
  if (f.keyWord != "") {
    out = append(out, f.keyWord)
  }
  let nested = jsonDecNestedName(jx, f)
  if (nested != "") {
    out = append(out, jsonDecName(nested))
  }
  return out
}

// The nested `@json` class a field reaches, or "" — the field's own type for a
// bare nested field, its element/value/payload type inside a container. Read
// off the type node's source text, which is the same spelling the decoder has
// to call, so a `ns.Addr` (a `QualType`, never `jkNested` by name) answers ""
// and is rejected before it reaches here.
fn jsonDecNestedName(jx: JsonCtx, f: JsonField): string {
  if (f.kind == jkNested) {
    return jsonDecTypeName(jx, f.typeNode)
  }
  if (isJsonContainer(f.kind) && f.elemKind == jkNested) {
    return jsonDecTypeName(jx, f.elem)
  }
  return ""
}

fn jsonDecTypeName(jx: JsonCtx, typeNode: int): string {
  if (typeNode == 0 || getNode(jx.tree, typeNode).tag != Tag.Ident) {
    return ""
  }
  return jsonNodeText(jx, typeNode)
}

// ---- node helpers this builder adds to classjsonbuild.bit's -----------------

// `let <name>[: <type>] = <value>`.
fn jbLet(jb: JsonBuild, nameWord: string, typeNode: int, value: int): int {
  return jbNode(
    jb, Tag.LetDecl,
    [jbNode(jb, Tag.Binding, [jbIdent(jb, nameWord), typeNode, value])],
  )
}

// `<lhs> = <value>`, where `lhs` is any assignable expression node.
fn jbAssignTo(jb: JsonBuild, lhs: int, value: int): int {
  return addNode(
    jb.tree, Tag.Assign, jb.span, int(Kind.Eq),
    [jbNode(jb, Tag.LhsList, [lhs]), jbNode(jb, Tag.ExprList, [value])],
  )
}

// `<expr>?` — propagate the err result to the caller (SPEC §18.3).
fn jbTry(jb: JsonBuild, expr: int): int {
  return jbNode(jb, Tag.TryExpr, [expr])
}

// An integer literal spelling `word`, which must be one the collector appended.
fn jbInt(jb: JsonBuild, word: string): int {
  return addLeaf(jb.tree, Tag.IntLit, synthSpan(jb.st, word))
}

// `<a> + <b>`.
fn jbAdd(jb: JsonBuild, a: int, b: int): int {
  return addNode(jb.tree, Tag.Binary, jb.span, int(Kind.Plus), [a, b])
}

// A structural copy of a TYPE node, so the same node is never reachable by two
// paths — a shape no other pass here builds, and one `jbKeyExpr` already avoids
// for the same reason. Bounded rather than trusting the tree to be a tree: a
// `@json` field type is validated to at most a container of a simple type
// (classjsonfield.bit), so 8 is far past anything reachable, and exceeding it
// is a compiler bug rather than a user error.
fn jbCloneType(t: Tree, node: int, depth: int): int {
  if (node == 0) {
    return 0
  }
  if (depth > 8) {
    panic("classjsondecode: type node nests deeper than '@json' accepts")
  }
  let n = getNode(t, node)
  let kids = []int(0)
  for k of kidsOf(t, node) {
    kids = append(kids, jbCloneType(t, k, depth + 1))
  }
  return addNode(t, n.tag, n.span, n.main, kids)
}

// ---- one field -------------------------------------------------------------

// The builder's whole state: classjsonbuild.bit's node helpers plus the module
// context, which is what a nested field's decoder NAME has to be read out of
// (the type node's source text).
class JsonDecBuild {
  jb: JsonBuild,
  jx: JsonCtx,
}

// One position a value is decoded at: the shape it must have, the declared type
// node to convert through, and the nested class to call when the shape is a
// class. Bundled so every builder below stays inside LINT.md's max-params=5.
class JsonDecElem {
  kind: int,
  typeNode: int,
  nested: string,
}

// The element position of a field: the field itself for a bare one, its
// element/value/payload type inside a container.
fn jdElemOf(db: JsonDecBuild, f: JsonField): JsonDecElem {
  let nested = jsonDecNestedName(db.jx, f)
  if (isJsonContainer(f.kind)) {
    return JsonDecElem{ kind: f.elemKind, typeNode: f.elem, nested: nested }
  }
  return JsonDecElem{ kind: f.kind, typeNode: f.typeNode, nested: nested }
}

// `<local>` as an expression.
fn jdLocal(db: JsonDecBuild, word: string): int {
  return jbIdent(db.jb, word)
}

// `jsonDecMember(__json_o, __json_p, <key>)?` — the value a non-`Option`
// field's key must carry.
fn jdMember(db: JsonDecBuild, f: JsonField): int {
  let call = jbCall(
    db.jb, jdLocal(db, "jsonDecMember"),
    [jdLocal(db, jsonDecEntriesLocal), jdLocal(db, jsonDecParamP), jbKeyExpr(db.jb, f)],
  )
  return jbTry(db.jb, call)
}

// `jsonDecPath(__json_p, <key>)` — this field's own path.
fn jdFieldPath(db: JsonDecBuild, f: JsonField): int {
  return jbCall(
    db.jb, jdLocal(db, "jsonDecPath"),
    [jdLocal(db, jsonDecParamP), jbKeyExpr(db.jb, f)],
  )
}

// How a value's path is reached: the path of the value that CONTAINS it, plus
// the ONE step from there — an object key, or an array index when `byIndex`.
//
// Held apart rather than joined because the join allocates and only a failure
// ever reads it (#4502): the scalar extractors take both halves and build the
// dotted path inside their own `fail`. `jdJoinPath` is for the one consumer
// that needs the string on the success path — a nested class's decoder, which
// threads it down — and costs once per nested object, not once per scalar.
class JsonDecPathRef {
  parent: int,
  step: int,
  byIndex: bool,
}

// `jsonDecPath(<parent>, <key>)` or `jsonDecIndex(<parent>, <index>)` — the
// path as a string, materialised.
fn jdJoinPath(db: JsonDecBuild, pr: JsonDecPathRef): int {
  let helper = "jsonDecPath"
  if (pr.byIndex) {
    helper = "jsonDecIndex"
  }
  return jbCall(db.jb, jdLocal(db, helper), [pr.parent, pr.step])
}

// Field `f` of the object being decoded, reached from the decoder's own path.
fn jdFieldRef(db: JsonDecBuild, f: JsonField): JsonDecPathRef {
  return JsonDecPathRef{
    parent: jdLocal(db, jsonDecParamP), step: jbKeyExpr(db.jb, f), byIndex: false,
  }
}

// The by-key and by-index extractors for a scalar shape. Spelled out rather
// than assembled from a base name and a suffix: these words have to be in
// `jsonDecHelperNames`, and a name built by interpolation would go missing
// there silently for whichever shape no test happens to decode.
fn jdScalarKeyHelper(kind: int): string {
  if (kind == jkBool) {
    return "jsonDecBoolKey"
  }
  if (kind == jkString) {
    return "jsonDecStringKey"
  }
  if (kind == jkFloat) {
    return "jsonDecFloatKey"
  }
  return "jsonDecIntKey"
}

fn jdScalarIndexHelper(kind: int): string {
  if (kind == jkBool) {
    return "jsonDecBoolIndex"
  }
  if (kind == jkString) {
    return "jsonDecStringIndex"
  }
  if (kind == jkFloat) {
    return "jsonDecFloatIndex"
  }
  return "jsonDecIntIndex"
}

// `__json_d + 1` — one level deeper than the decoder being generated.
fn jdDeeper(db: JsonDecBuild): int {
  return jbAdd(db.jb, jdLocal(db, jsonDecParamD), jbInt(db.jb, "1"))
}

// The value at `jsonExpr`, reached by `pr`, decoded to `el`'s declared type. An
// integer or float goes through an explicit conversion to the field's OWN width
// — `jsonDecIntKey` answers `i64` and a `u8` field needs `u8(...)` — which is
// the same rule classjsonbuild.bit's `jbValueOf` applies in reverse.
//
// A nested class is the only shape whose path is joined here; every scalar is
// handed the two halves and joins nothing unless it fails.
fn jdValueOf(db: JsonDecBuild, el: JsonDecElem, jsonExpr: int, pr: JsonDecPathRef): int {
  if (el.kind == jkNested) {
    return jbTry(
      db.jb,
      jbCall(
        db.jb, jdLocal(db, jsonDecName(el.nested)),
        [jsonExpr, jdJoinPath(db, pr), jdDeeper(db)],
      ),
    )
  }
  let helper = jdScalarKeyHelper(el.kind)
  if (pr.byIndex) {
    helper = jdScalarIndexHelper(el.kind)
  }
  let raw = jbTry(
    db.jb, jbCall(db.jb, jdLocal(db, helper), [jsonExpr, pr.parent, pr.step]),
  )
  if (el.kind == jkBool || el.kind == jkString) {
    return raw
  }
  return jbCall(db.jb, jbCloneType(db.jb.tree, el.typeNode, 0), [raw])
}

// A scalar, string, bool or nested-class field: one binding, and the value is
// the whole of it.
fn jdSimpleField(db: JsonDecBuild, f: JsonField): []int {
  let v = jdValueOf(db, jdElemOf(db, f), jdMember(db, f), jdFieldRef(db, f))
  return [jbLet(db.jb, jsonDecLocalX(f.index), 0, v)]
}

// `[]T(0, len(__json_da<i>))` — the accumulator sized from the array it is
// about to hold, so its cost stops depending on the array's length.
//
// `[]` was the declaration until #4672, and `append` grows by doubling, so the
// cost rose with the array. Measured directly, 100,000 iterations of each
// shape under BIT_GC_STATS=1, objects = swept + live per iteration:
//
//   elements   `[]` + append   `[]T(0, n)`   saved
//          3            5.00          2.00    3.00
//         10            7.00          2.00    5.00
//
// A fixed `[]T(0, 4)` would save the first row and almost none of the second.
// The text path (classjsondecodetext.bit) takes that guess because a forward
// cursor cannot know the count before it has read the array; the DOM path
// holds the array already, so it takes the exact size.
fn jdSliceCap(db: JsonDecBuild, f: JsonField, a: string): int {
  let sliceTy = jbNode(db.jb, Tag.SliceType, [jbCloneType(db.jb.tree, f.elem, 0)])
  return jbCall(
    db.jb, sliceTy,
    [
      jbInt(db.jb, "0"),
      jbCall(db.jb, jdLocal(db, "len"), [jdLocal(db, a)]),
    ],
  )
}

// `[]T`: the field's path bound once, the array bound once, an accumulator
// sized from it, a cursor for the `tags[3]` path an element failure reports,
// and a loop.
//
// Binding the array to `__json_da<i>` rather than iterating the call directly
// is what makes the length available; the call is evaluated exactly once
// either way, and its failure still propagates before the accumulator exists.
fn jdSliceField(db: JsonDecBuild, f: JsonField): []int {
  let p = jsonDecLocalP(f.index)
  let x = jsonDecLocalX(f.index)
  let ix = jsonDecLocalI(f.index)
  let v = jsonDecLocalV(f.index)
  let a = jsonDecLocalA(f.index)
  let elemRef = JsonDecPathRef{
    parent: jdLocal(db, p), step: jdLocal(db, ix), byIndex: true,
  }
  let add = jbCall(
    db.jb, jdLocal(db, "append"),
    [jdLocal(db, x), jdValueOf(db, jdElemOf(db, f), jdLocal(db, v), elemRef)],
  )
  let body = jbNode(
    db.jb, Tag.Block,
    [
      jbAssignTo(db.jb, jdLocal(db, x), add),
      jbAssignTo(db.jb, jdLocal(db, ix), jbAdd(db.jb, jdLocal(db, ix), jbInt(db.jb, "1"))),
    ],
  )
  let items = jbTry(
    db.jb,
    jbCall(
      db.jb, jdLocal(db, "jsonDecArray"),
      [jdMember(db, f), jdLocal(db, p), jdLocal(db, jsonDecParamD)],
    ),
  )
  let sliceTy = jbNode(db.jb, Tag.SliceType, [jbCloneType(db.jb.tree, f.elem, 0)])
  return [
    jbLet(db.jb, p, 0, jdFieldPath(db, f)),
    jbLet(db.jb, a, 0, items),
    jbLet(db.jb, x, sliceTy, jdSliceCap(db, f, a)),
    jbLet(db.jb, ix, 0, jbInt(db.jb, "0")),
    jbNode(db.jb, Tag.ForOf, [jdLocal(db, v), jdLocal(db, a), body]),
  ]
}

// `map<string, T>(len(__json_da<i>))` — the map pre-sized from the entries it
// is about to hold, the map half of `jdSliceCap` above.
//
// `map<string, T>{}` was the declaration until #4680. The table starts at
// `mapInitCap` = 8 slots and doubles once `(used+1)*8 >= cap*7`
// (runtime/root/mapcaps.bit), and each doubling allocates three buffers — keys,
// values and ctrl — so a map field paid a grow per doubling of its entry count.
// The hint picks the initial `cap` directly instead (`mapCapForHint`), so those
// grows do not happen.
//
// The hint is ADVISORY by specification (SPEC §11.2, §12.9): it changes only
// how the map is pre-sized, never its contents or behaviour, and an `n` that
// under- or over-promises is still correct. Duplicate keys in the document
// make `len(entries)` an over-estimate; that is a slightly larger table, not a
// wrong one.
fn jdMapCap(db: JsonDecBuild, f: JsonField, a: string): int {
  return jbCall(
    db.jb, jbCloneType(db.jb.tree, f.typeNode, 0),
    [jbCall(db.jb, jdLocal(db, "len"), [jdLocal(db, a)])],
  )
}

// `map<string, T>`: the same shape over the object's entries, keyed by the
// entry's own key. The map's keys are already strings, so nothing converts
// them; a value failure reports `<field>.<key>`.
//
// The entries are bound to `__json_da<i>` before the map is declared, exactly
// as `jdSliceField` binds its array and for the same reason: it is what makes
// the count available to size the accumulator. The call is evaluated once
// either way, and its failure still propagates before the map exists.
fn jdMapField(db: JsonDecBuild, f: JsonField): []int {
  let p = jsonDecLocalP(f.index)
  let x = jsonDecLocalX(f.index)
  let e = jsonDecLocalE(f.index)
  let a = jsonDecLocalA(f.index)
  let valRef = JsonDecPathRef{
    parent: jdLocal(db, p), step: jbMember(db.jb, jdLocal(db, e), "key"),
    byIndex: false,
  }
  let slot = jbNode(
    db.jb, Tag.Index, [jdLocal(db, x), jbMember(db.jb, jdLocal(db, e), "key")],
  )
  let val = jdValueOf(
    db, jdElemOf(db, f), jbMember(db.jb, jdLocal(db, e), "value"), valRef,
  )
  let body = jbNode(db.jb, Tag.Block, [jbAssignTo(db.jb, slot, val)])
  let entries = jbTry(
    db.jb,
    jbCall(
      db.jb, jdLocal(db, "jsonDecEntries"),
      [jdMember(db, f), jdLocal(db, p), jdLocal(db, jsonDecParamD)],
    ),
  )
  return [
    jbLet(db.jb, p, 0, jdFieldPath(db, f)),
    jbLet(db.jb, a, 0, entries),
    jbLet(db.jb, x, 0, jdMapCap(db, f, a)),
    jbNode(db.jb, Tag.ForOf, [jdLocal(db, e), jdLocal(db, a), body]),
  ]
}

// `Option<T>`: an ABSENT key and an explicit `null` both decode to `None`. No
// path local — the value's path is reached from the decoder's own, so an absent
// key builds nothing at all (#4502).
// Those two are deliberately the same answer here and deliberately different in
// the encoder, which always writes an absent `Option` as `null` (SPEC §10.5) —
// what `@json` emits has to decode back, and a producer that omits the key
// instead is just as well-formed.
fn jdOptionField(db: JsonDecBuild, f: JsonField): []int {
  let x = jsonDecLocalX(f.index)
  let m = jsonDecLocalM(f.index)
  let raw = jbCall(
    db.jb, jdLocal(db, "jsonDecOptMember"),
    [jdLocal(db, jsonDecEntriesLocal), jbKeyExpr(db.jb, f)],
  )
  let inner = jdValueOf(
    db, jdElemOf(db, f),
    jbCall(db.jb, jdLocal(db, "unwrap"), [jdLocal(db, m)]), jdFieldRef(db, f),
  )
  let some = jbCall(
    db.jb,
    jbNode(db.jb, Tag.Member, [jbCloneType(db.jb.tree, f.typeNode, 0), jbIdent(db.jb, "Some")]),
    [inner],
  )
  let none = jbNode(
    db.jb, Tag.Member, [jbCloneType(db.jb.tree, f.typeNode, 0), jbIdent(db.jb, "None")],
  )
  let then = jbNode(db.jb, Tag.Block, [jbAssignTo(db.jb, jdLocal(db, x), some)])
  let cond = jbCall(db.jb, jdLocal(db, "isSome"), [jdLocal(db, m)])
  return [
    jbLet(db.jb, m, 0, raw),
    jbLet(db.jb, x, 0, none),
    jbNode(db.jb, Tag.IfStmt, [cond, then, 0]),
  ]
}

// Every statement one field contributes. The value always lands in
// `__json_x<i>`, whatever shape produced it, so the composite literal at the
// end is uniform.
fn jdFieldStmts(db: JsonDecBuild, f: JsonField): []int {
  db.jb.span = getNode(db.jb.tree, f.nameNode).span
  if (f.kind == jkSlice) {
    return jdSliceField(db, f)
  }
  if (f.kind == jkMap) {
    return jdMapField(db, f)
  }
  if (f.kind == jkOption) {
    return jdOptionField(db, f)
  }
  return jdSimpleField(db, f)
}

// ---- the whole decoder -----------------------------------------------------

// `["id", "name", ...]` — the key set on the wire, with `@key` renames already
// applied, which is what `jsonDecUnknown` measures the document against.
fn jdKnownKeys(db: JsonDecBuild, jc: JsonClass): int {
  let items = []int(0)
  for f of jc.fields {
    db.jb.span = getNode(db.jb.tree, f.nameNode).span
    items = append(items, jbNode(db.jb, Tag.Arg, [jbKeyExpr(db.jb, f)]))
  }
  db.jb.span = getNode(db.jb.tree, jc.className).span
  return jbNode(db.jb, Tag.SliceLit, items)
}

// `C{ id: __json_x0, ... }` — every accepted field, in declaration order.
fn jdResultLit(db: JsonDecBuild, jc: JsonClass): int {
  let inits = []int(0)
  for f of jc.fields {
    let name = addLeaf(db.jb.tree, Tag.Ident, getNode(db.jb.tree, f.nameNode).span)
    inits = append(
      inits,
      jbNode(db.jb, Tag.FieldInit, [name, jdLocal(db, jsonDecLocalX(f.index))]),
    )
  }
  return jbNode(
    db.jb, Tag.CompositeLit,
    [jdClassRef(db, jc), jbNode(db.jb, Tag.FieldInits, inits)],
  )
}

// A fresh `Ident` leaf spelling the class's own name, at the class's own span.
fn jdClassRef(db: JsonDecBuild, jc: JsonClass): int {
  return addLeaf(db.jb.tree, Tag.Ident, getNode(db.jb.tree, jc.className).span)
}

// `(__json_j: Json, __json_p: string, __json_d: i64)`.
fn jdParams(db: JsonDecBuild): int {
  return jbNode(
    db.jb, Tag.Params,
    [
      jbNode(db.jb, Tag.Param, [jbIdent(db.jb, jsonDecParamJ), jbIdent(db.jb, "Json")]),
      jbNode(db.jb, Tag.Param, [jbIdent(db.jb, jsonDecParamP), jbIdent(db.jb, "string")]),
      jbNode(db.jb, Tag.Param, [jbIdent(db.jb, jsonDecParamD), jbIdent(db.jb, "i64")]),
    ],
  )
}

// The decoder for one class, as a top-level free declaration — a FREE function
// and not a member because Bit has no static methods (SPEC §10.4: `method_decl`
// requires the `this` receiver), and decoding has no object to call a method
// on. Exported iff the CLASS is: a class the module keeps to itself cannot be
// named from outside, so its decoder can never be called from outside either.
fn synthJsonDecoder(db: JsonDecBuild, jc: JsonClass): int {
  let tree = db.jb.tree
  let classSpan = getNode(tree, jc.className).span
  db.jb.span = classSpan
  let entries = jbTry(
    db.jb,
    jbCall(
      db.jb, jdLocal(db, "jsonDecObject"),
      [
        jdLocal(db, jsonDecParamJ), jdLocal(db, jsonDecParamP),
        jdLocal(db, jsonDecParamD),
      ],
    ),
  )
  let unknown = jbTry(
    db.jb,
    jbCall(
      db.jb, jdLocal(db, "jsonDecUnknown"),
      [jdLocal(db, jsonDecEntriesLocal), jdLocal(db, jsonDecParamP), jdKnownKeys(db, jc)],
    ),
  )
  let stmts = [
    jbLet(db.jb, jsonDecEntriesLocal, 0, entries),
    jbNode(db.jb, Tag.ExprStmt, [unknown]),
  ]
  for f of jc.fields {
    for s of jdFieldStmts(db, f) {
      stmts = append(stmts, s)
    }
  }
  db.jb.span = classSpan
  stmts = append(stmts, jbNode(db.jb, Tag.ReturnStmt, [jdResultLit(db, jc)]))
  let name = identText(tree, db.jx.source, jc.className)
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      0, synthIdent(tree, db.jb.st, jsonDecName(name)), 0, jdParams(db),
      jbNode(db.jb, Tag.Fallible, [jdClassRef(db, jc), 0]),
      jbNode(db.jb, Tag.Block, stmts),
    ],
  )
  if (!jc.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// Every demanded class's decoder, for the caller to attach in the one pass that
// attaches `@json`'s encoders and #3879's validators.
fn injectJsonDecodeDecls(jx: JsonCtx, st: SynthText, classes: []JsonClass): []int {
  let out = []int(0)
  let db = JsonDecBuild{
    jb: JsonBuild{ tree: jx.tree, st: st, span: pointSpan(0, 0) }, jx: jx,
  }
  for jc of classes {
    out = append(out, synthJsonDecoder(db, jc))
  }
  return out
}
