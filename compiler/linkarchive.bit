// An `ar` archive a build reads once (#7256). libbitrt.a used to be parsed
// and atomized two or more times per build: by the E0096 extern surface
// (machoArchiveExterns/elfArchiveExterns), by each `extern fn`'s membership
// check (machoArchiveDefines/peArchiveDefines/archiveDefines) and by the
// link (linkMacho/elIngest/plIngest). All of them now ask one LinkArchive,
// which reads every member on the first ask and keeps each reader verdict,
// a module or the reader's error message, so every consumer still sees
// exactly what its own read used to give it. In memory only.

// The object reader the members were read with. A Windows build asks for
// the ELF surface (linkedExternNames) before the COFF one, so a second
// format re-reads rather than asserting.
enum LkFormat {
  Unread,
  Macho,
  Coff,
  ElfX86_64,
  ElfAarch64,
}

class LkMember {
  module: LoModule,
  // The reader's failure (`object <member>: <reason>`), "" when `module` is real.
  err: string,
}

class LinkArchive {
  bytes: []u8,
  format: LkFormat,
  // parseArchive's failure, "" when the archive itself parsed.
  err: string,
  members: []LkMember,
}

fn newLinkArchive(bytes: []u8): LinkArchive {
  return LinkArchive{
    bytes = bytes, format = LkFormat.Unread, err = "", members = []LkMember(0),
  }
}

// One unread LinkArchive per entry of `archives`, in order.
fn newLinkArchives(archives: [][]u8): []LinkArchive {
  let out = []LinkArchive(0)
  for bytes of archives {
    out = append(out, newLinkArchive(bytes))
  }
  return out
}

fn lkElfFormat(t: ElfTarget): LkFormat {
  if (t == ElfTarget.X86_64) {
    return LkFormat.ElfX86_64
  }
  return LkFormat.ElfAarch64
}

fn lkReadMember(format: LkFormat, m: ArMember): LoModule! {
  if (format == LkFormat.Macho) {
    return readMachoObject(m.name, m.data)?
  }
  if (format == LkFormat.Coff) {
    return readCoffObject(m.name, m.data)?
  }
  if (format == LkFormat.ElfX86_64) {
    return readElf(ElfTarget.X86_64, m.name, m.data)?
  }
  return readElf(ElfTarget.Aarch64, m.name, m.data)?
}

// Reads every member of `a` as `format`, unless that is already done.
fn lkRead(a: LinkArchive, format: LkFormat) {
  assert(format != LkFormat.Unread)
  if (a.format == format) {
    return
  }
  a.format = format
  a.err = ""
  a.members = []LkMember(0)
  let entries = parseArchive(a.bytes) catch e {
    a.err = e.message()
    return
  }
  for entry of entries {
    let mod = lkReadMember(format, entry) catch e {
      let none = LoModule{ name = entry.name, atoms = []LoAtom(0) }
      a.members = append(a.members, LkMember{ module = none, err = e.message() })
      continue
    }
    a.members = append(a.members, LkMember{ module = mod, err = "" })
  }
}

// True if a member of `a` (read as `format`) defines `symbol` as a global
// atom, which is what resolveGlobals keys the link on. Fails like the
// member-by-member read it replaces: `archive: <reason>` for a bad archive,
// else the first unreadable member reached before a definition.
fn lkDefines(a: LinkArchive, format: LkFormat, symbol: string): bool! {
  if (len(a.bytes) == 0) {
    return false
  }
  lkRead(a, format)
  if (a.err != "") {
    fail newError("archive: ${a.err}")
  }
  for m of a.members {
    if (m.err != "") {
      fail newError(m.err)
    }
    for atom of m.module.atoms {
      if (atom.binding == LoBinding.Global && atom.name == symbol) {
        return true
      }
    }
  }
  return false
}

// The members of `a` (read as `format`) that read cleanly; none for a bad
// archive. The E0096 surface skips what it cannot read and finds nothing in
// what is not there (machoArchiveExterns).
fn lkReadable(a: LinkArchive, format: LkFormat): []LoModule {
  let out = []LoModule(0)
  if (len(a.bytes) == 0) {
    return out
  }
  lkRead(a, format)
  for m of a.members {
    if (m.err == "") {
      out = append(out, m.module)
    }
  }
  return out
}

// `members` plus every member of `a` (read as `format`), failing as the
// link's own read did: the archive's error unprefixed, else the first
// unreadable member's.
fn lkAppendMembers(members: []LoModule, a: LinkArchive, format: LkFormat): []LoModule! {
  lkRead(a, format)
  if (a.err != "") {
    fail newError(a.err)
  }
  let out = []LoModule(0)
  for m of members {
    out = append(out, m)
  }
  for m of a.members {
    if (m.err != "") {
      fail newError(m.err)
    }
    out = append(out, m.module)
  }
  return out
}
