// x86-64 instruction selectors for memory access: class/slice field reads
// and writes, the atomics (§11.5), and array element indexing — split out of
// compiler/x64select.bit (#3141), which was 796 lines against the 800-line
// limit. compiler/x64select.bit keeps the width-canonicalization and operand
// fetch/store helpers (xGetInt/xPutInt/... used here too, same module) and
// the immediate-form arithmetic/logical selectors; the multiply/divide/
// compare/convert/shift selectors later moved out to x64selectarith.bit
// (#4183, same module) when x64select.bit hit the ceiling again.
//
// Named to sort after compiler/x64select.bit — module files concatenate in
// bytewise filename order (compiler/project.bit:7).

// ---- #5655: the constant-offset displacement fold ---------------------------
// Which address-forming `add`s emit nothing because the memory access that
// consumes them carries the constant in its ModRM disp32 instead. Kept next to
// the emitters that read the answer rather than beside the other skip map in
// compiler/x64dispatch.bit, which was at 806 lines against the 800-line E0200
// ceiling; `xUseCounts` and `xSkipWhenEveryUseFolds` stay there, shared.

// #5655: address-forming `add`s that emit NOTHING because every use of them is
// a memory access that carries the constant in its ModRM disp32 instead.
// Indexed by instruction id, read by `xEmitInst` (x64dispatch.bit, which skips
// the add) and by `xMemAddrOf` below, which rebuilds the operand from the add's
// own base. Same bookkeeping as `xComputeSkipConstMaterialize`
// (x64dispatch.bit) and the same hazard: under-naming costs an `addq`,
// over-naming leaves a memory access reading a register nothing ever wrote.
fn xComputeSkipAddrFold(ctx: TypeContext, f: IrFunc, debug: bool): []bool {
  let n = len(f.instrs)
  let foldCount = []int(n)
  let i = 0
  while (i < n) {
    let p = xAddrFoldPtrOperand(ctx, f, i, debug)
    if (p >= 0) {
      foldCount[p] = foldCount[p] + 1
    }
    i = i + 1
  }
  return xSkipWhenEveryUseFolds(xUseCounts(f), foldCount)
}

// `cx.skipAddr` for `v`. The selector self-checks build an XCtx by hand and
// leave the map empty, which reads as "nothing folds" — the conservative answer
// and the one a fixture pinning an unfolded encoding wants. The assert is what
// keeps that from covering for a production mis-sizing: any map that is neither
// empty nor exactly one entry per instruction is a bug, not a fixture.
fn xSkipsAddr(cx: XCtx, v: int): bool {
  if (len(cx.skipAddr) != len(cx.f.instrs)) {
    assert(len(cx.skipAddr) == 0, "skipAddr must be empty or one entry per instruction")
    return false
  }
  return cx.skipAddr[v]
}

// The pointer operand of the memory access at `i` that folds into its disp32,
// or -1. The one predicate both readers of `skipAddr` consult, for the reason
// `xImmFoldConstOperand` is one predicate: an emitter folding an operand this
// function did not name — or declining one it did — is a miscompile that no
// register is left holding evidence of.
//
// Five conditions, each of them load-bearing:
//
//  1. `xMemOpFoldsPtr` restricts this to the four emitters that actually call
//     `xMemAddrOf` below. Adding an op here without changing its emitter is the
//     over-naming failure above.
//  2. `ins.lhs == i - 1` — ADJACENCY, and it is the liveness argument, not a
//     tidiness one. The allocator sees the `add`'s base die at the `add` when
//     that is its last use, so with any instruction in between the base's
//     register may already have been handed to something else by the time the
//     load runs. Adjacent, the only thing emitted between the two is the `add`
//     itself, which this fold deletes. Same-block comes free: a block's last
//     instruction is always a terminator, never an `add`.
//  3. 64-bit int width. The displacement is added by the ADDRESSING unit at
//     full width with no wrap, so folding a narrower `add` — whose result
//     `xCanonNarrow` would have truncated — would address somewhere else.
//  4. A `const_int` rhs inside the signed imm32 window, checked BEFORE the
//     offset is added to it so the sum itself cannot overflow. Only the rhs:
//     `xConstIntOf` on the lhs would need the base on the right, and lower.bit
//     puts the pointer there already.
//  5. `debug` refuses outright. A debug build's `add` carries an overflow trap
//     (`xMaybeOverflowTrap`, x64selectovf.bit); deleting the `add` would delete
//     the check with it, and a fold is never worth a lost trap.
//
// Not a condition, but the reason one is not needed: the `add` this deletes can
// never be a GC root. `isRefType` (codegen.bit) is false for every type an
// `Op.Add` can produce, and in any case condition 2 leaves its live range one
// instruction long with no safepoint inside it, so no stack map can name it.
fn xAddrFoldPtrOperand(ctx: TypeContext, f: IrFunc, i: int, debug: bool): int {
  if (debug || !xMemOpFoldsPtr(f.instrs[i].op)) {
    return -1
  }
  let p = f.instrs[i].lhs
  if (p != i - 1 || f.instrs[p].op != Op.Add) {
    return -1
  }
  let w = widthOf(ctx, f.instrs[p].ty)
  if (w.regClass != RegClass.Int || w.bytes != 8) {
    return -1
  }
  let c = xConstIntOf(f, f.instrs[p].rhs)
  if (!c.known || !fitsXArithImm32(c.ival)) {
    return -1
  }
  if (!fitsXArithImm32(xMemOpConstOffset(f.instrs[i]) + c.ival)) {
    return -1
  }
  return p
}

// The ops whose emitters address through `xMemAddrOf` and so can carry a folded
// displacement: the plain field load/store and the two atomic forms that take
// the same base (SPEC §11.5). This list and those four emitters are one fact
// written twice; nothing else may join it without joining them.
//
// `Op.SliceLen` and the header/array arms of `Op.FieldGet` are absent on
// purpose rather than by oversight — see `xMemAddrOf`'s header for why they
// could not fold even if they were listed.
fn xMemOpFoldsPtr(op: Op): bool {
  return op == Op.FieldGet || op == Op.FieldSet || op == Op.AtomicLoad || op == Op.AtomicStore
}

// The constant byte offset `ins` already carries in its memory operand, which
// the folded `add`'s constant is added to. `ival` is the field offset for both
// field ops; an atomic dereferences its pointer at zero.
fn xMemOpConstOffset(ins: IrInstr): int {
  if (ins.op == Op.FieldGet || ins.op == Op.FieldSet) {
    return ins.ival
  }
  return 0
}

// The memory operand a field or atomic access addresses through: `ptr`'s own
// register plus `offset`, or — when `cx.skipAddr` says the `add` that defines
// `ptr` is never materialized (#5655) — that add's BASE register plus
// `offset + k`. One `movq base,tmp` and one `addq $k,tmp` become nothing, and
// the disp32 the load already spent four zero bytes on carries the constant.
//
// The base always comes back through `xGetInt`, so it is the base VREG's own
// home register (or a reload of its spill slot). It is never `ptr`'s allocated
// register: that register is exactly what the skipped `add` would have written
// and now holds whatever was there before.
//
// `xAddrFoldPtrOperand` above is what decides; this function only reads its
// answer, and the two must name the same four ops. Two arms of
// `xEmitFieldGet` below call this and could not fold even so, which is why they
// need no guard of their own: the array arm needs the result type to be
// `TypeKind.Array` and the header arm needs the BASE's type to be a slice or a
// string, and an `Op.Add` produces neither — so `f.instrs[ptr].op != Op.Add`
// has already refused both before `skipAddr` is consulted.
fn xMemAddrOf(cx: XCtx, ptr: int, offset: int, scratch: XReg64): XMem {
  if (!xSkipsAddr(cx, ptr)) {
    return xMemB(xGetInt(cx, ptr, scratch), offset)
  }
  let add = cx.f.instrs[ptr]
  let k = constIntValue(cx.f.instrs[add.rhs])
  return xMemB(xGetInt(cx, add.lhs, scratch), offset + k)
}

// `dst = base.field`. `base` is already the GC body pointer (runtime/ABI.md §1:
// codegen never sees the header), so `offset` is a plain byte offset with no
// header adjustment.
//
// `isArray` marks a fixed-size array field, which is INLINE storage: its value
// is the interior address `base + offset`, formed with lea — loading a word
// there would read the array's first element as if it were the array itself.
// `isSliceBase` is supplied by the dispatcher rather than read from the
// instruction table here: the selector self-checks drive this with a stub
// context whose instruction list is empty, so reaching back into `cx.f.instrs`
// would fault in the very harness that is meant to pin the encoding.
fn xEmitFieldGet(
  cx: XCtx,
  dst: int,
  base: int,
  offset: int,
  w: Width,
  isArray: bool,
  isSliceBase: bool,
) {
  let m = xMemAddrOf(cx, base, offset, xScratch2())
  let baseReg = m.base
  if (isArray) {
    let lacc = xIntAcc(cx, dst)
    xLea(cx.buf, lacc, baseReg, m.disp)
    xPutInt(cx, dst, lacc)
    return
  }
  // cap(s) lowers to a field_get [24] on the slice HEADER itself, so a null
  // header must read as 0 here exactly as it does for len (#1564). Keyed on the
  // base's own type, so a class field read is untouched and pays nothing.
  if (isSliceBase) {
    xEmitHeaderWordOrZero(cx, baseReg, m.disp)
    xPutInt(cx, dst, xScratch1())
    return
  }
  if (w.regClass == RegClass.Int) {
    let acc = xIntAcc(cx, dst)
    xMovLoad(cx.buf, acc, m, w.bytes, w.signed)
    xPutInt(cx, dst, acc)
    return
  }
  // #3171: load straight into dst's own register when it has one. The address
  // is already in an INT register, so no float operand is pending.
  let facc = xFloatAcc(cx, dst, xFScratch1())
  xMovFLoad(cx.buf, facc, m, w.bytes)
  xPutFloat(cx, dst, facc)
}

// `base.field = value`. The base is fetched into the SECONDARY scratch so the
// primary stays free for the value — fetching both into the same scratch would
// have the second overwrite the first.
fn xEmitFieldSet(cx: XCtx, base: int, offset: int, value: int, w: Width) {
  let m = xMemAddrOf(cx, base, offset, xScratch2())
  if (w.regClass == RegClass.Int) {
    let v = xGetInt(cx, value, xScratch1())
    xMovStore(cx.buf, m, v, w.bytes)
    return
  }
  let v = xGetFloat(cx, value, xFScratch1())
  xMovFStore(cx.buf, m, v, w.bytes)
}

// ---- atomics (§11.5) -------------------------------------------------------
// `*T` is an int-classed word; every sequence is call-free (never a safepoint).
// `lock`-prefixed forms are seq-cst regardless of the requested ordering.

fn xEmitAtomicLoad(cx: XCtx, dst: int, ptr: int, w: Width) {
  // #5655's displacement fold is pure ADDRESSING: which bytes this reads is
  // unchanged, and the instruction is the same plain `mov`, so the ordering
  // argument above is untouched.
  let m = xMemAddrOf(cx, ptr, 0, xScratch2())
  let acc = xIntAcc(cx, dst)
  xMovLoad(cx.buf, acc, m, w.bytes, w.signed) // plain load is acquire on x86-TSO
  xPutInt(cx, dst, acc)
}

// `XCHG` with a memory operand, NOT `mov` + `MFENCE` (#5317). Both are correct
// seq-cst stores against this backend's plain-`mov` atomic load: x86-TSO already
// orders store-store and load-load, so the only reordering a seq-cst store has
// to forbid is its own store sinking past a later load, and an implicitly
// `lock`ed access is a full barrier exactly as `MFENCE` is. Read the store's
// pair above: `xEmitAtomicLoad` is a bare `mov`, so the barrier obligation sits
// entirely on this side and is discharged either way.
//
// The choice is cost, measured on the x86_64-linux gate host (i7-14700KF,
// #5317): ten of each instruction in an `asm` block against a ten-`NOP`
// baseline, min of 5 trials of 3M iterations —
//
//     MFENCE                 6826 ps/op    (~32 cycles)
//     XCHG r64, [mem]        2930 ps/op    (~14 cycles)
//     LOCK OR $0, [mem]      3106 ps/op    (~15 cycles)
//
// so `MFENCE` costs 2.3x what the locked forms do, and `XCHG` also folds the
// store itself into that one instruction instead of paying for a separate
// `mov`. The equivalent arm64 lowering is a single `STLR` (arm64selectmem.bit's
// `emitAtomicStore`) with no barrier at all, which is why this cost was visible
// on x86_64-linux alone: the same runtime source paid ~4 ns per atomic store
// here and ~0 there.
//
// `XCHG` overwrites its register operand with the memory's old value, so the
// value is copied into the scratch first — `val` may be a live allocatable
// register (`xGetInt` returns the vreg's own home when it is not spilled) and
// clobbering it would corrupt whatever reads it next. The scratch is never
// allocatable (`xMasterGprs` omits r10/r11/r12), so this can collide with
// nothing.
fn xEmitAtomicStore(cx: XCtx, ptr: int, value: int, w: Width) {
  // #5655's displacement fold reaches here too. It is an ADDRESSING change and
  // only that: the instruction stays the same implicitly-locked `XCHG`, so
  // every word above about what this orders still holds verbatim.
  let m = xMemAddrOf(cx, ptr, 0, xScratch2())
  let val = xGetInt(cx, value, xScratch1())
  xMovRR(cx.buf, xScratch1(), val) // encodes nothing when `val` already IS the scratch
  xXchgMem(cx.buf, xScratch1(), m, w.bytes)
}

// `ptr`/`expected`/`desired`/`w` bundled so `xEmitAtomicCmpxchg` stays under
// E0202's max-params (spec/LINT.md) after #4396 added `w` — the store's own
// recorded width, no longer re-derived from `expected`'s defining instruction.
class XAtomicCasOperands {
  ptr: int,
  expected: int,
  desired: int,
  w: Width,
}

// `rax` is pinned in this function (xScanFuncFlags sets needsRaxRdx), so
// CMPXCHG's implicit accumulator is free to clobber. Result: the Go-style bool.
fn xEmitAtomicCmpxchg(cx: XCtx, dst: int, args: XAtomicCasOperands) {
  let base = xGetInt(cx, args.ptr, xScratch2())
  let des = xGetInt(cx, args.desired, xScratch3())
  let exp = xGetInt(cx, args.expected, xScratch1())
  let w = args.w
  xMovRR(cx.buf, XReg64.Rax, exp)
  xLockCmpxchgMem(cx.buf, des, base, w.bytes)
  let acc = xIntAcc(cx, dst)
  xSetcc(cx.buf, ccE(), acc) // ZF=1 => swapped
  xMovzxb(cx.buf, acc, acc)
  xPutInt(cx, dst, acc)
}

// Fetch-and-op; returns the pre-op value. add/sub/xchg are single implicit-lock
// instructions; and/or have no native fetch form on x86 and use the CMPXCHG
// retry loop (rax pinned).
fn xEmitAtomicRmw(cx: XCtx, op: Op, dst: int, ptr: int, operand: int, w: Width) {
  let base = xGetInt(cx, ptr, xScratch2())
  if (op == Op.AtomicRmwAdd || op == Op.AtomicRmwSub || op == Op.AtomicRmwXchg) {
    let oper = xGetInt(cx, operand, xScratch1())
    xMovRR(cx.buf, xScratch1(), oper) // reg holds the source and receives the old value
    if (op == Op.AtomicRmwAdd) {
      xLockXaddMem(cx.buf, xScratch1(), base, w.bytes)
    } else if (op == Op.AtomicRmwSub) {
      xNegR(cx.buf, xScratch1()) // fetch-and-sub == fetch-and-add(-v)
      xLockXaddMem(cx.buf, xScratch1(), base, w.bytes)
    } else {
      xXchgMem(cx.buf, xScratch1(), xMemB(base, 0), w.bytes)
    }
  } else {
    let oper = xGetInt(cx, operand, xScratch3())
    xMovLoad(cx.buf, XReg64.Rax, xMemB(base, 0), w.bytes, w.signed)
    let retryOff = len(cx.buf.code)
    xCanonNarrow(cx.buf, XReg64.Rax, w) // keep the comparand canonical each iteration
    xMovRR(cx.buf, xScratch1(), XReg64.Rax)
    if (op == Op.AtomicRmwAnd) {
      xArithRR(cx.buf, XArith.And, xScratch1(), oper)
    } else {
      xArithRR(cx.buf, XArith.Or, xScratch1(), oper)
    }
    xLockCmpxchgMem(cx.buf, xScratch1(), base, w.bytes)
    xJccToOffset(cx.buf, ccNe(), retryOff)  // JNZ retry: reservation lost, rax reloaded
    xMovRR(cx.buf, xScratch1(), XReg64.Rax) // rax holds the old (pre-op) value
  }
  xCanonNarrow(cx.buf, xScratch1(), w)
  xPutInt(cx, dst, xScratch1())
}

// `dst = len(slice)` — the `len` word at offset 8 of a slice or string header
// (runtime/ABI.md §2). Shared by both, which is why one selector covers them.
// Loads a slice/string header word at `disp`, reading a NULL header as 0 (#1564).
//
// A class zero-value is one gc_alloc of zeroed memory (SPEC §13.4), so a slice
// or string FIELD of a zeroed class holds the null word rather than an empty
// header. `xs == nil` is not spellable for either type (E0053), so null and
// empty are indistinguishable to a program — only the fault was observable.
// Both header readers that are inline rather than runtime calls (`len` at +8,
// `cap` at +24) come through here, so the guard leaves every IR dump untouched.
// xScratch1 is never allocatable, so it cannot alias baseReg. #3845 left this
// one on the scratch deliberately: `mov out, 0` runs BEFORE the test and the
// load that both read baseReg, so an accumulator equal to baseReg would
// destroy the address — the one shape in this file where writing the
// destination early is genuinely unsafe. The cost is one `mov` on a header
// read.
fn xEmitHeaderWordOrZero(cx: XCtx, baseReg: XReg64, disp: int) {
  xMovRI(cx.buf, xScratch1(), 0)
  xTestRR(cx.buf, baseReg, baseReg)
  xEmitByte(cx.buf, 116) // JZ rel8 -> past the load, leaving the 0
  xEmitByte(cx.buf, 0)   // displacement backpatched once the load is sized
  let afterJcc = len(cx.buf.code)
  xMovLoad(cx.buf, xScratch1(), xMemB(baseReg, disp), 8, false)
  cx.buf.code[afterJcc - 1] = u8(len(cx.buf.code) - afterJcc)
}

fn xEmitSliceLen(cx: XCtx, dst: int, base: int) {
  let baseReg = xGetInt(cx, base, xScratch2())
  xEmitHeaderWordOrZero(cx, baseReg, 8)
  xPutInt(cx, dst, xScratch1())
}

// `dst = base[index]` for a STATIC array only. A dynamic slice carries a
// header and goes through the bounds-checked slice_get runtime call instead, so
// lower.bit never emits index_get against one. The address is
// `base + index*width` — no header, a static length (lower.bit's array scheme).
fn xEmitIndexGet(cx: XCtx, dst: int, base: int, index: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  let idxReg = xGetInt(cx, index, xScratch3())
  let m = xMemBI(baseReg, idxReg, w.bytes, 0)
  if (w.regClass == RegClass.Int) {
    let acc = xIntAcc(cx, dst)
    xMovLoad(cx.buf, acc, m, w.bytes, w.signed)
    xPutInt(cx, dst, acc)
    return
  }
  // #3171: as in xEmitFieldGet — base and index are int registers, so dst's own
  // float register is free to be the load target.
  let facc = xFloatAcc(cx, dst, xFScratch1())
  xMovFLoad(cx.buf, facc, m, w.bytes)
  xPutFloat(cx, dst, facc)
}

fn xEmitIndexSet(cx: XCtx, base: int, index: int, value: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  let idxReg = xGetInt(cx, index, xScratch3())
  let m = xMemBI(baseReg, idxReg, w.bytes, 0)
  if (w.regClass == RegClass.Int) {
    let v = xGetInt(cx, value, xScratch1())
    xMovStore(cx.buf, m, v, w.bytes)
    return
  }
  let v = xGetFloat(cx, value, xFScratch1())
  xMovFStore(cx.buf, m, v, w.bytes)
}

