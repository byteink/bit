// x86-64 instruction selectors for memory access: class/slice field reads
// and writes, the atomics (§11.5), and array element indexing — split out of
// compiler/x64select.bit (#3141), which was 796 lines against the 800-line
// limit. compiler/x64select.bit keeps the width-canonicalization and operand
// fetch/store helpers (xGetInt/xPutInt/... used here too, same module) and
// the arithmetic/compare/convert/constant/shift selectors.
//
// Named to sort after compiler/x64select.bit — module files concatenate in
// bytewise filename order (compiler/project.bit:7).

// `dst = base.field`. `base` is already the GC body pointer (runtime/ABI.md §1:
// codegen never sees the header), so `offset` is a plain byte offset with no
// header adjustment.
//
// `isArray` marks a fixed-size array field, which is INLINE storage: its value
// is the interior address `base + offset`, formed with lea — loading a word
// there would read the array's first element as if it were the array itself.
// `isSliceBase` is supplied by the dispatcher rather than read from the
// instruction table here: the selector self-checks drive this with a stub
// context whose instruction list is empty, so reaching back into `cx.f.instrs`
// would fault in the very harness that is meant to pin the encoding.
fn xEmitFieldGet(cx: XCtx, dst: int, base: int, offset: int, w: Width, isArray: bool, isSliceBase: bool) {
  let baseReg = xGetInt(cx, base, xScratch2())
  if (isArray) {
    let lacc = xIntAcc(cx, dst)
    xLea(cx.buf, lacc, baseReg, offset)
    xPutInt(cx, dst, lacc)
    return
  }
  // cap(s) lowers to a field_get [24] on the slice HEADER itself, so a null
  // header must read as 0 here exactly as it does for len (#1564). Keyed on the
  // base's own type, so a class field read is untouched and pays nothing.
  if (isSliceBase) {
    xEmitHeaderWordOrZero(cx, baseReg, offset)
    xPutInt(cx, dst, xScratch1())
    return
  }
  if (w.regClass == RegClass.Int) {
    let acc = xIntAcc(cx, dst)
    xMovLoad(cx.buf, acc, xMemB(baseReg, offset), w.bytes, w.signed)
    xPutInt(cx, dst, acc)
    return
  }
  // #3171: load straight into dst's own register when it has one. The address
  // is already in an INT register, so no float operand is pending.
  let facc = xFloatAcc(cx, dst, xFScratch1())
  xMovFLoad(cx.buf, facc, xMemB(baseReg, offset), w.bytes)
  xPutFloat(cx, dst, facc)
}

// `base.field = value`. The base is fetched into the SECONDARY scratch so the
// primary stays free for the value — fetching both into the same scratch would
// have the second overwrite the first.
fn xEmitFieldSet(cx: XCtx, base: int, offset: int, value: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  if (w.regClass == RegClass.Int) {
    let v = xGetInt(cx, value, xScratch1())
    xMovStore(cx.buf, xMemB(baseReg, offset), v, w.bytes)
    return
  }
  let v = xGetFloat(cx, value, xFScratch1())
  xMovFStore(cx.buf, xMemB(baseReg, offset), v, w.bytes)
}

// ---- atomics (§11.5) -------------------------------------------------------
// `*T` is an int-classed word; every sequence is call-free (never a safepoint).
// `lock`-prefixed forms are seq-cst regardless of the requested ordering.

fn xEmitAtomicLoad(cx: XCtx, dst: int, ptr: int, w: Width) {
  let base = xGetInt(cx, ptr, xScratch2())
  let acc = xIntAcc(cx, dst)
  xMovLoad(cx.buf, acc, xMemB(base, 0), w.bytes, w.signed) // plain load is acquire on x86-TSO
  xPutInt(cx, dst, acc)
}

fn xEmitAtomicStore(cx: XCtx, ptr: int, value: int, w: Width) {
  let base = xGetInt(cx, ptr, xScratch2())
  let val = xGetInt(cx, value, xScratch1())
  xMovStore(cx.buf, xMemB(base, 0), val, w.bytes)
  xMfence(cx.buf) // a seq-cst store needs a trailing full barrier on x86
}

// `rax` is pinned in this function (xScanFuncFlags sets needsRaxRdx), so
// CMPXCHG's implicit accumulator is free to clobber. Result: the Go-style bool.
fn xEmitAtomicCmpxchg(cx: XCtx, dst: int, ptr: int, expected: int, desired: int) {
  let w = widthOf(cx.ctx, cx.f.instrs[expected].ty)
  let base = xGetInt(cx, ptr, xScratch2())
  let des = xGetInt(cx, desired, xScratch3())
  let exp = xGetInt(cx, expected, xScratch1())
  xMovRR(cx.buf, XReg64.Rax, exp)
  xLockCmpxchgMem(cx.buf, des, base, w.bytes)
  let acc = xIntAcc(cx, dst)
  xSetcc(cx.buf, ccE(), acc) // ZF=1 => swapped
  xMovzxb(cx.buf, acc, acc)
  xPutInt(cx, dst, acc)
}

// Fetch-and-op; returns the pre-op value. add/sub/xchg are single implicit-lock
// instructions; and/or have no native fetch form on x86 and use the CMPXCHG
// retry loop (rax pinned).
fn xEmitAtomicRmw(cx: XCtx, op: Op, dst: int, ptr: int, operand: int, w: Width) {
  let base = xGetInt(cx, ptr, xScratch2())
  if (op == Op.AtomicRmwAdd || op == Op.AtomicRmwSub || op == Op.AtomicRmwXchg) {
    let oper = xGetInt(cx, operand, xScratch1())
    xMovRR(cx.buf, xScratch1(), oper) // reg holds the source and receives the old value
    if (op == Op.AtomicRmwAdd) {
      xLockXaddMem(cx.buf, xScratch1(), base, w.bytes)
    } else if (op == Op.AtomicRmwSub) {
      xNegR(cx.buf, xScratch1()) // fetch-and-sub == fetch-and-add(-v)
      xLockXaddMem(cx.buf, xScratch1(), base, w.bytes)
    } else {
      xXchgMem(cx.buf, xScratch1(), base, w.bytes)
    }
  } else {
    let oper = xGetInt(cx, operand, xScratch3())
    xMovLoad(cx.buf, XReg64.Rax, xMemB(base, 0), w.bytes, w.signed)
    let retryOff = len(cx.buf.code)
    xCanonNarrow(cx.buf, XReg64.Rax, w) // keep the comparand canonical each iteration
    xMovRR(cx.buf, xScratch1(), XReg64.Rax)
    if (op == Op.AtomicRmwAnd) {
      xArithRR(cx.buf, XArith.And, xScratch1(), oper)
    } else {
      xArithRR(cx.buf, XArith.Or, xScratch1(), oper)
    }
    xLockCmpxchgMem(cx.buf, xScratch1(), base, w.bytes)
    xJccToOffset(cx.buf, ccNe(), retryOff) // JNZ retry: reservation lost, rax reloaded
    xMovRR(cx.buf, xScratch1(), XReg64.Rax) // rax holds the old (pre-op) value
  }
  xCanonNarrow(cx.buf, xScratch1(), w)
  xPutInt(cx, dst, xScratch1())
}

// `dst = len(slice)` — the `len` word at offset 8 of a slice or string header
// (runtime/ABI.md §2). Shared by both, which is why one selector covers them.
// Loads a slice/string header word at `disp`, reading a NULL header as 0 (#1564).
//
// A class zero-value is one gc_alloc of zeroed memory (SPEC §13.4), so a slice
// or string FIELD of a zeroed class holds the null word rather than an empty
// header. `xs == nil` is not spellable for either type (E0053), so null and
// empty are indistinguishable to a program — only the fault was observable.
// Both header readers that are inline rather than runtime calls (`len` at +8,
// `cap` at +24) come through here, so the guard leaves every IR dump untouched.
// xScratch1 is never allocatable, so it cannot alias baseReg. #3845 left this
// one on the scratch deliberately: `mov out, 0` runs BEFORE the test and the
// load that both read baseReg, so an accumulator equal to baseReg would
// destroy the address — the one shape in this file where writing the
// destination early is genuinely unsafe. The cost is one `mov` on a header
// read.
fn xEmitHeaderWordOrZero(cx: XCtx, baseReg: XReg64, disp: int) {
  xMovRI(cx.buf, xScratch1(), 0)
  xTestRR(cx.buf, baseReg, baseReg)
  xEmitByte(cx.buf, 116) // JZ rel8 -> past the load, leaving the 0
  xEmitByte(cx.buf, 0)   // displacement backpatched once the load is sized
  let afterJcc = len(cx.buf.code)
  xMovLoad(cx.buf, xScratch1(), xMemB(baseReg, disp), 8, false)
  cx.buf.code[afterJcc - 1] = u8(len(cx.buf.code) - afterJcc)
}

fn xEmitSliceLen(cx: XCtx, dst: int, base: int) {
  let baseReg = xGetInt(cx, base, xScratch2())
  xEmitHeaderWordOrZero(cx, baseReg, 8)
  xPutInt(cx, dst, xScratch1())
}

// `dst = base[index]` for a STATIC array only. A dynamic slice carries a
// header and goes through the bounds-checked slice_get runtime call instead, so
// lower.bit never emits index_get against one. The address is
// `base + index*width` — no header, a static length (lower.bit's array scheme).
fn xEmitIndexGet(cx: XCtx, dst: int, base: int, index: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  let idxReg = xGetInt(cx, index, xScratch3())
  let m = xMemBI(baseReg, idxReg, w.bytes, 0)
  if (w.regClass == RegClass.Int) {
    let acc = xIntAcc(cx, dst)
    xMovLoad(cx.buf, acc, m, w.bytes, w.signed)
    xPutInt(cx, dst, acc)
    return
  }
  // #3171: as in xEmitFieldGet — base and index are int registers, so dst's own
  // float register is free to be the load target.
  let facc = xFloatAcc(cx, dst, xFScratch1())
  xMovFLoad(cx.buf, facc, m, w.bytes)
  xPutFloat(cx, dst, facc)
}

fn xEmitIndexSet(cx: XCtx, base: int, index: int, value: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  let idxReg = xGetInt(cx, index, xScratch3())
  let m = xMemBI(baseReg, idxReg, w.bytes, 0)
  if (w.regClass == RegClass.Int) {
    let v = xGetInt(cx, value, xScratch1())
    xMovStore(cx.buf, m, v, w.bytes)
    return
  }
  let v = xGetFloat(cx, value, xFScratch1())
  xMovFStore(cx.buf, m, v, w.bytes)
}

