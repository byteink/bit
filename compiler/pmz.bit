// compiler/pmz.bit — the dependency-resolution engine `bit add` and `bit up`
// (compiler/pmcli.bit) both call into: resolving one dependency spec (direct
// or vanity) to a fetched LockEntry, walking the transitive `requires` graph
// of everything already locked or newly discovered (#2251), reading a
// fetched dependency's own `bit.json` requirements, and Minimal Version
// Selection conflict-checking against what a project already has locked.
// None of it touches argv, exit codes, or bit.json/bit.lock writes —
// compiler/pmcli.bit is the only file with a command's exit code, and the
// only writer of either file; this file only ever returns a `LockEntry`,
// `[]LockEntry` or a `Requirement`/`bool`, or fails.
//
// Reads from its siblings in this module (no import needed — same module):
//   - compiler/pmcli.bit: `parseAddSpec`, `DepSpec`, `upsertLockEntry`.
//   - compiler/pmfetch.bit: `resolveDependencyRef`, `fetchSha`,
//     `readManifest`, `resolveVanityUrl`, `parseGitRemoteUrl`,
//     `checkResolvedUrlMatches`, `defaultDepUrl`, `vanityTimeoutMs`.
//   - compiler/pmlock.bit: `LockEntry`, `LockRequire`.
//   - compiler/pmresolve.bit: `Requirement`, `RootRequirement`, `ModuleReqs`,
//     `ReqGraph`, `packageVersionsFromModules`, `Version`, `versionLess`.
//   - compiler/pmresolvesolve.bit: `resolvePubGrub` (#2366, replacing MVS).
//   - compiler/pmversion.bit: `Constraint`, `ConstraintOp`.
// Named `pmz` rather than `pmclitail` so it sorts after every other `pm*`
// file: module files concatenate in bytewise sorted filename order, and the
// inliner only inlines a callee it has already lowered — this file calls
// functions defined in compiler/pmfetch.bit (and pmlock.bit/pmresolve.bit),
// so it must sort after all of them, not just after compiler/pmcli.bit.

// The fetch/resolve/MVS-check sequence `bit add` and `bit up` both need,
// kept in exactly one place (ticket #1735's hard constraint: never fork
// #1734's plumbing): re-resolve `ref` against `fetchUrl` to a commit, fetch it
// into the cache, read its own transitive requirements, and re-run MVS
// (`checkVersionConflict`) against `existing`'s already-locked transitive
// requirements. Returns the fresh `LockEntry` without writing bit.lock —
// the caller (an add of one new dependency, or an up refreshing one already
// in bit.lock) decides how and when that gets written.
//
// `url` and `fetchUrl` differ only when `bit add --url` overrode where this
// one run looks (#1767): the fetch reaches `fetchUrl`, while the returned
// `LockEntry` records `url`, so an override never leaks into bit.lock.
//
// Guards `name` against a DIFFERENT repo silently taking over its bit.lock
// entry (#2253): `name` is the bare last path segment of a direct spec
// (`addDependency`'s `let name = repo`), so two unrelated repos that happen to
// share a repo name — `local.invalid/dev/strings` and
// `local.invalid/other/strings` — collide on the identical key. Before this
// guard, the second `bit add` silently overwrote the first entry (and every
// `import … from "strings"` in the project silently started compiling against
// different code); `checkResolvedUrlMatches` (pmfetch.bit) already exists for
// exactly this shape of check on the vanity path
// (`resolveVanityDependency`, below) and is reused here unchanged, checked
// BEFORE any fetch so a colliding `bit add` never touches the network. A
// dependency refreshed at a new ref (same host/owner/repo, so the same
// derived `url`) is unaffected: `existingUrlFor` returns that identical `url`,
// so the check passes trivially.
fn resolveDependency(
  cacheRoot: string, gitBin: string,
  name: string, host: string, owner: string, repo: string, ref: string, url: string,
  fetchUrl: string, existing: []LockEntry, timeoutMs: int,
): LockEntry! {
  checkResolvedUrlMatches(name, existingUrlFor(existing, name, ""), url)?
  let sha = resolveDependencyRef(gitBin, fetchUrl, ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, GitRemoteRepo{ host: host, owner: owner, repo: repo },
    GitFetchTarget{ url: fetchUrl, sha: sha, pkgDir: "" }, timeoutMs)?
  let depManifest = readManifest(fetched.dir)?
  let depRequires = manifestRequires(depManifest)
  checkVersionConflict(existing, name, ref, depRequires)?
  return LockEntry{ name: name, url: url, commit: sha, requires: depRequires, vanity: "" }
}

// The package directory a fetched vanity dependency actually lives in:
// `repoDir` (the fetch cache's checkout root) when the resolved
// `bit-import:` document named no `dir` field, or that subdirectory when it
// did (SPEC §17.7). Checked to actually exist so a `dir` value naming
// nothing readable fails loudly at `bit add`/`bit up` time — without this,
// `readManifest`'s own "a missing bit.json is not an error" contract would
// silently treat a bad `dir` as an empty manifest, and the mistake would
// only surface later, when the package is actually imported.
fn vanityPackageDir(repoDir: string, dir: string): string! {
  if (len(dir) == 0) {
    return repoDir
  }
  let joined = pathJoinResolve(repoDir, dir)
  if (!isDir(joined)) {
    fail newError("pmz: bit-import document's dir field '${dir}' does not exist or is not a directory in the fetched repository: ${joined}")
  }
  return joined
}

// The vanity counterpart to `resolveDependency`: resolve `vanityName` to a
// git URL (and an optional `dir`, SPEC §17.7's extension-point field),
// refuse a fresh resolution that disagrees with whatever URL `bit.lock`
// already records for `name` (pmfetch.bit's `checkResolvedUrlMatches` —
// SPEC §17.7's "never a silent switch" rule), then decompose the resolved
// URL into a `host`/`owner`/`repo` triple (pmfetch.bit's
// `parseGitRemoteUrl`) and run the identical fetch/MVS sequence
// `resolveDependency` runs for a direct spec — the resolved URL is used
// exactly as a direct spec's derived URL would be, never special-cased. The
// dependency's own `bit.json` is read from `doc.dir` within the fetched
// checkout when the document named one (`vanityPackageDir`), the repo root
// otherwise, exactly as before this field existed.
fn resolveVanityDependency(
  cacheRoot: string, gitBin: string,
  name: string, vanityName: string, ref: string,
  existing: []LockEntry, timeoutMs: int,
): LockEntry! {
  let doc = resolveVanityUrl(vanityName, vanityTimeoutMs)?
  checkResolvedUrlMatches(name, existingUrlFor(existing, name, ""), doc.gitUrl)?
  let remote = parseGitRemoteUrl(doc.gitUrl)?
  let sha = resolveDependencyRef(gitBin, doc.gitUrl, ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, remote, GitFetchTarget{ url: doc.gitUrl, sha: sha, pkgDir: doc.dir }, timeoutMs)?
  let pkgDir = vanityPackageDir(fetched.dir, doc.dir)?
  let depManifest = readManifest(pkgDir)?
  let depRequires = manifestRequires(depManifest)
  checkVersionConflict(existing, name, ref, depRequires)?
  return LockEntry{ name: name, url: doc.gitUrl, commit: sha, requires: depRequires, vanity: vanityName, dir: doc.dir }
}

// The local-filesystem counterpart to `resolveDependency`/
// `resolveVanityDependency` (#2244): no fetch, no URL, no commit — just
// confirm `localPath` (resolved against `projectDir`, exactly as the user
// typed it — relative or absolute) is actually a directory, and read its own
// `bit.json` requirements the same way a fetched dependency's are read.
// Called ONLY for a dependency directly named in the ROOT project's own
// `bit.json` (`pmcli.bit`'s `addLocalDependency`/`upDependencies`) — never
// from `resolveTransitiveSpec` below, which refuses a local/file spec
// discovered while walking anything else's manifest.
fn resolveLocalDependency(projectDir: string, name: string, localPath: string): LockEntry! {
  let checkPath = pmJoin(projectDir, localPath)
  if (!isDir(checkPath)) {
    fail newError("pmz: local path dependency '${name}' does not exist or is not a directory: ${checkPath}")
  }
  let depManifest = readManifest(checkPath)?
  let depRequires = manifestRequires(depManifest)
  return LockEntry{ name: name, url: "", commit: "", requires: depRequires, vanity: "", localPath: localPath }
}

// ---- transitive dependency resolution (#2251) --------------------------
//
// SPEC §17.7 step 1: "the resolver walks the transitive requirement graph —
// every dependency's own bit.json dependencies, recursively." Step 2: "for
// each distinct module named anywhere in that graph, the resolver ...
// selects" the one version satisfying every stated constraint, highest
// first when several do (owner decision, #2366, 2026-08-09), and fails
// naming the conflict when none do. `pmresolve.bit`'s `resolvePubGrub`
// (#2366, replacing #1731's MVS) already implements that step over a
// `ReqGraph` handed to it as data — its own header says assembling that
// data from `bit.lock`/git is a separate job. This is that job: walk every
// `requires` edge a locked dependency's own `bit.json` names, fetching each
// newly discovered name (through the identical direct-vs-vanity
// classification and fetch machinery a root `bit add` uses — a transitive
// dependency's own dependency can itself be a vanity name, #2068) and
// giving each surviving module its own top-level `bit.lock` entry.
//
// Two disjoint kinds of requirement, per SPEC §17.7 point 2:
//   - version-tagged (an exact `vMAJOR.MINOR.PATCH` ref): every DISTINCT
//     (name, version) pair reachable is fetched once to learn ITS OWN
//     requirements, feeding `resolvePubGrub`'s `ReqGraph` as an Exact
//     constraint (#2366's pmz.bit adaptation — every constraint this walk
//     ever builds is Exact, since a version-tagged ref is already a single
//     pinned commit, never a range); the resolved version per name is then
//     the one actually locked, reusing the fetch already done during
//     discovery rather than fetching a second time.
//   - non-version (a branch or bare commit SHA): SPEC's own carve-out — "a
//     module reachable only through such a ref resolves to exactly that
//     ref" — there is no ordering to arbitrate, so the first (and, since a
//     name is fetched at most once here, only) ref discovered for a name is
//     locked as-is.
// A version-tagged resolution wins over a non-version one for the same name
// if a walk somehow discovers both (an exact pinned version is a strictly
// stronger constraint than an unordered branch/sha) — this resolver's one
// tie-break rule, applied only at the very end so discovery never depends on
// which requirement happens to be walked first.
//
// Known limitation, deliberately out of scope here: a name that ALREADY has
// a top-level `bit.lock` entry (a direct dependency, or one this resolver
// already locked on a prior run) is never reconsidered even if a freshly
// discovered requirement would want a higher version — this walk only fills
// in names bit.lock does not yet have an entry for. Re-arbitrating an
// already-locked name against a newly discovered transitive requirement (the
// same way `checkVersionConflict` guards a root `bit add`) is #2250's own
// scope, which also covers `checkVersionConflict` itself never firing today.

// One requirement discovered while walking a dependency's own `requires` —
// `spec` is that dependency's stated value verbatim (`LockRequire.ref`,
// pmlock.bit: a full `gitHost/owner/repo@ref` or vanity `path@ref` string,
// not a bare ref). `fromRoot` marks a requirement that came directly from
// `resolveTransitiveDeps`'s own `seed` (a "true" root of this resolver's own
// graph) rather than from a deeper module's own requirements — only a root
// requirement is fed to `resolvePubGrub` directly; every deeper edge is
// re-derived by `resolvePubGrub`'s own internal walk over the `modules` this
// file assembles, the same layering `checkVersionConflict` already uses.
class PendingReq { name: string, spec: string, fromRoot: bool }

// The `Version` a FULL dependency spec string's trailing `@ref` names, or
// `(_, false)` if that ref is not an exact `vMAJOR.MINOR.PATCH` tag. Unlike
// `parseVersionTag` (above), which expects an already-bare ref, this takes
// the full spec a `bit.json` `dependencies` value or a `bit.lock` `requires`
// entry actually stores (`host/owner/repo@ref` or `vanityPath@ref`) and
// extracts the ref itself first.
fn pendingVersionTag(spec: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  let at = lastIndexByte(spec, '@')
  if (at < 0) {
    return zero, false
  }
  return parseVersionTag(spec[at + 1:len(spec)])
}

// Whether `entries` already carries a top-level entry named `name` — the
// gate that stops this resolver from re-fetching (or re-considering) a
// dependency some earlier `bit add`/`bit up` already locked.
fn lockHasEntry(entries: []LockEntry, name: string): bool {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// `queue` with one `PendingReq{fromRoot: false}` appended per entry of `rs`
// (a freshly-fetched dependency's own `requires`) — every edge discovered
// below the top level of this resolver's own walk.
fn enqueueRequires(queue: []PendingReq, rs: []LockRequire): []PendingReq {
  let out = queue
  let i = 0
  while (i < len(rs)) {
    // bit:lint allow E0214 -- enqueueRequires has 3 call sites (pmclichecktail.bit:203, a test-local literal never read after the call; pmz.bit:335,352, resolveTransitiveDeps's own local queue reassigned in place each time); queue never escapes its owning function, so no caller reads the pre-call slice after the call
    out = append(out, PendingReq{ name: rs[i].name, spec: rs[i].ref, fromRoot: false })
    i = i + 1
  }
  return out
}

// `rs` (raw `[]LockRequire`, full-spec-string refs) narrowed to its
// version-shaped subset, as pmresolve.bit's `[]Requirement` — the data a
// freshly-fetched module's own requirements become for `ReqGraph.modules`.
// Also reused by `checkVersionConflict` (below) for the dependency being
// added/refreshed's own requirements: before #2250, `checkVersionConflict`
// called `parseVersionTag` directly on a full spec string instead of
// extracting its `@ref` tail first (the now-removed `pmToRequirements`), so it
// never matched anything and MVS never had an already-locked transitive
// requirement to arbitrate against — this is the corrected extraction, and
// the reason `checkVersionConflict` never fired for a real diamond conflict
// before #2250. This resolver's own "already-locked names are never
// reconsidered" limitation (above) is the one piece #2250 does NOT cover:
// re-arbitrating an already-locked name against a newly discovered
// TRANSITIVE requirement (as opposed to a root `bit add`/`bit up`, which
// #2250 does fix) is still out of scope here.
fn versionRequirementsOf(rs: []LockRequire): []Requirement {
  let out = []Requirement(0)
  let i = 0
  while (i < len(rs)) {
    let (v, ok) = pendingVersionTag(rs[i].ref)
    if (ok) {
      out = append(out, Requirement{ name: rs[i].name, constraint: Constraint{ op: ConstraintOp.Exact, version: v } })
    }
    i = i + 1
  }
  return out
}

// Resolves one transitive requirement's full spec (a dependency's own
// `bit.json` value, e.g. `"local.invalid/dev/textutil@v0.1.0"`) to a fetched
// `LockEntry`, routing it through the identical direct-vs-vanity
// classification (`parseSpec`/`parseAddSpec`) and fetch machinery
// (`fetchSha`/`resolveVanityUrl`) a root `bit add` uses — a transitive
// dependency's own dependency can itself be a vanity name (#2068), so this
// must never assume the direct shape. `parseAddSpec` (not the stricter
// `parseSpec`) is used so a hand-authored manifest that omits `@ref` on one
// of ITS OWN dependencies resolves the same way an omitted `@ref` does for a
// root `bit add`, rather than failing the whole resolution.
fn resolveTransitiveSpec(cacheRoot: string, gitBin: string, name: string, spec: string, timeoutMs: int): LockEntry! {
  let d = parseAddSpec(spec)?
  // SECURITY (#2244): a local filesystem / "file://" dependency is only ever
  // trusted directly from the ROOT project's own bit.json
  // (`pmcli.bit`'s `addLocalDependency`/`upDependencies`, which never call
  // this function for the dependency they add themselves). This function
  // processes ONLY entries discovered by walking SOME already-resolved
  // dependency's own `requires` — content that came from a git fetch (or, at
  // best, another local dependency's manifest), never something the
  // developer running `bit add`/`bit up` typed. Without this check, a
  // dependency fetched from an untrusted remote could name an arbitrary
  // local path in its OWN `bit.json` `dependencies` and have this resolver
  // read it as though the developer had asked for it directly — turning a
  // `bit add`/`bit up` of one innocuous-looking package into an
  // attacker-chosen local file read. Denied unconditionally, regardless of
  // the path's shape (no traversal-pattern check could substitute for this:
  // the untrusted party gets to choose ANY path, absolute or relative).
  if (d.scheme == "local") {
    fail newError("pmz: transitive dependency '${name}' requests a local filesystem path (${d.localPath}) — local/file:// dependencies are only allowed directly in a project's own bit.json, never as a requirement of another dependency")
  }
  if (d.vanity) {
    let doc = resolveVanityUrl(d.vanityName, vanityTimeoutMs)?
    let remote = parseGitRemoteUrl(doc.gitUrl)?
    let sha = resolveDependencyRef(gitBin, doc.gitUrl, d.ref, timeoutMs)?
    let fetched = fetchSha(gitBin, cacheRoot, remote, GitFetchTarget{ url: doc.gitUrl, sha: sha, pkgDir: doc.dir }, timeoutMs)?
    let pkgDir = vanityPackageDir(fetched.dir, doc.dir)?
    let depManifest = readManifest(pkgDir)?
    return LockEntry{ name: name, url: doc.gitUrl, commit: sha, requires: manifestRequires(depManifest), vanity: d.vanityName, dir: doc.dir }
  }
  let url = defaultDepUrl(d.host, d.owner, d.repo)
  if (d.scheme == "ssh") {
    url = sshDepUrl(d.sshUser, d.host, d.owner, d.repo)
  }
  let sha = resolveDependencyRef(gitBin, url, d.ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, GitRemoteRepo{ host: d.host, owner: d.owner, repo: d.repo },
    GitFetchTarget{ url: url, sha: sha, pkgDir: "" }, timeoutMs)?
  let depManifest = readManifest(fetched.dir)?
  return LockEntry{ name: name, url: url, commit: sha, requires: manifestRequires(depManifest), vanity: "" }
}

// Runs `resolvePubGrub` (#2366) over `rootRequires`/`modules`, converting a
// structured `ResolveFailure` into this file's own `fail`/`?` convention —
// every OTHER function here already fails through that channel, and
// `resolvePubGrub` deliberately does not (pmresolve.bit's own header: a
// caller decides how to surface a conflict, this file surfaces it as a
// normal `bit add`/`bit up` error). `available` is derived straight from
// `modules`: every candidate this walk's callers ever try to decide is one
// this file has ALREADY fetched (a version-tagged ref always resolves to
// one concrete commit before it ever reaches the resolver), so there is no
// separate range search here yet — that is #2367/#2368's job.
fn pmResolveOrFail(rootRequires: []RootRequirement, modules: []ModuleReqs): map<string, Version>! {
  let graph = ReqGraph{ rootRequires: rootRequires, modules: modules, available: packageVersionsFromModules(modules) }
  match (resolvePubGrub(graph)) {
    Ok(resolved) => { return resolved }
    Err(f) => { fail newError(f.message) }
  }
}

// Fetches every dependency reachable from `seed` (typically every
// already-locked entry's own `requires`, flattened — `flattenRequires`,
// below) that does not already have a top-level `bit.lock` entry, giving
// each its own entry — the loop this file's own module comment above says
// `pmresolve.bit` is missing. Discovery never mutates `entries` — it only
// fetches and records candidates — so `entries` is exactly as it started
// throughout the walk regardless of queue order; both classes of winner
// (version-tagged and non-version) are written into `entries` only in the
// two materialization passes at the end.
//
// Bounded worklist: `queue` only ever grows from a freshly-fetched
// dependency's own `requires` list (`enqueueRequires`), and a `(name,
// version)` or bare `name` pair already visited is never re-enqueued for a
// fetch (`visitedVersions`/`visitedNonVersion`) — so the total number of
// fetches this performs is bounded by the number of distinct requirement
// edges reachable across every `bit.json` this walk actually reads, the same
// bound `resolvePubGrub`'s own worklist comment gives for its walk, and a
// cycle or self-dependency cannot loop it forever for the identical reason.
export fn resolveTransitiveDeps(
  cacheRoot: string, gitBin: string, entries: []LockEntry, seed: []LockRequire, timeoutMs: int,
): []LockEntry! {
  let queue = []PendingReq(0)
  let i = 0
  while (i < len(seed)) {
    queue = append(queue, PendingReq{ name: seed[i].name, spec: seed[i].ref, fromRoot: true })
    i = i + 1
  }

  let rootRequires = []RootRequirement(0)
  let modules = []ModuleReqs(0)
  let fetchedByVersion = map<string, LockEntry>{}
  let visitedVersions = map<string, bool>{}
  let nonVersionFetched = map<string, LockEntry>{}
  let visitedNonVersion = map<string, bool>{}
  let nonVersionNames = []string(0)

  let qi = 0
  while (qi < len(queue)) {
    let req = queue[qi]
    qi = qi + 1
    if (lockHasEntry(entries, req.name)) {
      continue
    }

    let (ver, isVersion) = pendingVersionTag(req.spec)
    if (!isVersion) {
      let (_, seenNV) = visitedNonVersion[req.name]
      if (seenNV) {
        continue
      }
      visitedNonVersion[req.name] = true
      let entry = resolveTransitiveSpec(cacheRoot, gitBin, req.name, req.spec, timeoutMs)?
      nonVersionFetched[req.name] = entry
      nonVersionNames = append(nonVersionNames, req.name)
      queue = enqueueRequires(queue, entry.requires)
      continue
    }

    if (req.fromRoot) {
      rootRequires = append(rootRequires, RootRequirement{ requirer: "root", name: req.name, constraint: Constraint{ op: ConstraintOp.Exact, version: ver } })
    }

    let key = "${req.name}@${ver.major}.${ver.minor}.${ver.patch}"
    let (_, seenV) = visitedVersions[key]
    if (seenV) {
      continue
    }
    visitedVersions[key] = true
    let entry = resolveTransitiveSpec(cacheRoot, gitBin, req.name, req.spec, timeoutMs)?
    fetchedByVersion[key] = entry
    modules = append(modules, ModuleReqs{ name: req.name, version: ver, requires: versionRequirementsOf(entry.requires) })
    queue = enqueueRequires(queue, entry.requires)
  }

  let resolved = pmResolveOrFail(rootRequires, modules)?

  // Version-tagged winners first — the tie-break rule this resolver's own
  // module comment names.
  let vi = 0
  while (vi < len(modules)) {
    let name = modules[vi].name
    vi = vi + 1
    if (lockHasEntry(entries, name)) {
      continue
    }
    let (winner, found) = resolved[name]
    if (!found) {
      continue
    }
    let winKey = "${name}@${winner.major}.${winner.minor}.${winner.patch}"
    let (entry, hasEntry) = fetchedByVersion[winKey]
    if (!hasEntry) {
      fail newError("pmcli: internal error resolving transitive dependency ${name}: PubGrub chose v${winner.major}.${winner.minor}.${winner.patch}, which this resolver never fetched")
    }
    entries = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires, entry.vanity, entry.localPath, entry.dir)
  }

  let ni = 0
  while (ni < len(nonVersionNames)) {
    let name = nonVersionNames[ni]
    ni = ni + 1
    if (lockHasEntry(entries, name)) {
      continue
    }
    let (entry, hasEntry) = nonVersionFetched[name]
    if (!hasEntry) {
      continue
    }
    entries = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires, entry.vanity, entry.localPath, entry.dir)
  }

  return entries
}

// Every entry's own `requires`, flattened into one `[]LockRequire` — the
// seed `resolveTransitiveDeps` starts its walk from, covering not just a
// dependency just added but every requirement `bit.lock` already records (a
// lock file written before this walk existed, or an entry whose own
// requirements have grown since the last resolution).
fn flattenRequires(entries: []LockEntry): []LockRequire {
  let out = []LockRequire(0)
  let i = 0
  while (i < len(entries)) {
    let j = 0
    while (j < len(entries[i].requires)) {
      out = append(out, entries[i].requires[j])
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// ---- reading a fetched dependency's own requirements -------------------

// The `dependencies` object of a fetched dependency's `bit.json`
// (`d`, from pmfetch.bit's `readManifest`), as `[]LockRequire` — an absent
// manifest or an absent/malformed `dependencies` key is not an error, just
// no transitive requirements (`readManifest` already returns a well-formed,
// empty `JsonDoc` for a dependency with no manifest at all).
fn manifestRequires(d: JsonDoc): []LockRequire {
  let out = []LockRequire(0)
  if (!jsonHas(d, d.root)) {
    return out
  }
  let depsId = jsonGet(d, d.root, "dependencies")
  if (depsId < 0 || jsonKindOf(d, depsId) != JsonKind.Obj) {
    return out
  }
  let n = jsonLen(d, depsId)
  let i = 0
  while (i < n) {
    let key = jsonKeyAt(d, depsId, i)
    out = append(out, LockRequire{ name: key, ref: jsonStrOf(d, jsonGet(d, depsId, key)) })
    i = i + 1
  }
  return out
}

// ---- Minimal Version Selection over just this one add ------------------

// An exact `vMAJOR.MINOR.PATCH` tag, or `(_, false)` for anything else (a
// branch name or a bare commit sha — spec §17.7 point 2: not an MVS-ordered
// version).
fn parseVersionTag(ref: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  if (len(ref) < 2 || ref[0] != 'v') {
    return zero, false
  }
  let (major, i1, ok1) = pmScanUint(ref, 1)
  if (!ok1 || i1 >= len(ref) || ref[i1] != '.') {
    return zero, false
  }
  let (minor, i2, ok2) = pmScanUint(ref, i1 + 1)
  if (!ok2 || i2 >= len(ref) || ref[i2] != '.') {
    return zero, false
  }
  let (patch, i3, ok3) = pmScanUint(ref, i2 + 1)
  if (!ok3 || i3 != len(ref)) {
    return zero, false
  }
  return Version{ major: major, minor: minor, patch: patch }, true
}

// The decimal integer starting at `s[start]`, the index just past its last
// digit, and whether at least one digit was read.
fn pmScanUint(s: string, start: int): (int, int, bool) {
  let i = start
  let n = 0
  let any = false
  while (i < len(s) && s[i] >= '0' && s[i] <= '9') {
    n = n * 10 + (int(s[i]) - int('0'))
    i = i + 1
    any = true
  }
  return n, i, any
}

// Every version-shaped requirement any ALREADY-locked dependency's own
// transitive `requires` states for `name` — the other half of "the current
// project's requirements" ticket #1734 step 3 asks to feed the resolver,
// alongside the dependency being added itself.
//
// #2250: this used to call `parseVersionTag(r.ref)` directly, which expects
// an already-bare ref (`"v2.0.0"`); `r.ref` (`LockRequire.ref`, pmlock.bit) is
// always a FULL spec (`"gitHost/owner/repo@ref"` or a vanity `path@ref`), so
// `parseVersionTag`'s `ref[0] == 'v'` check never matched — a full spec's
// first byte is a host name, never `'v'`. This function's result was
// therefore always empty, so `checkVersionConflict`, below, never had any
// ALREADY-LOCKED transitive requirement to arbitrate against.
// `pendingVersionTag` (above) is the correct extraction — same one
// `versionRequirementsOf` (above) already uses for a freshly-fetched
// module's own requirements — so this now shares it instead of repeating the
// bug. `requirer` names the ALREADY-LOCKED entry that stated each
// requirement (#2366: PubGrub's conflict report needs the requirer's
// identity, which the old `[]Requirement` shape had nowhere to carry).
fn pmExistingRequirementsFor(entries: []LockEntry, name: string): []RootRequirement {
  let out = []RootRequirement(0)
  let i = 0
  while (i < len(entries)) {
    let j = 0
    while (j < len(entries[i].requires)) {
      let r = entries[i].requires[j]
      if (r.name == name) {
        let (v, ok) = pendingVersionTag(r.ref)
        if (ok) {
          out = append(out, RootRequirement{ requirer: entries[i].name, name: name, constraint: Constraint{ op: ConstraintOp.Exact, version: v } })
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// `f`'s conflict, rendered for this file's own callers — narrower than
// pmresolveexplain.bit's general renderer because every constraint
// `checkVersionConflict` ever builds is Exact (a git version tag, #2366's
// pmz.bit adaptation), so a "v"-prefixed exact version is always the right
// spelling here (matching this file's existing convention throughout, e.g.
// `parseVersionTag`), unlike the resolver's own `^`/`~`-aware text.
fn pmVersionConflictMessage(f: ResolveFailure): string {
  let msg = "pmcli: ${f.package} conflicts:"
  let i = 0
  while (i < len(f.requirers)) {
    let r = f.requirers[i]
    msg = msg + " ${r.requirer} requires v${r.constraint.version.major}.${r.constraint.version.minor}.${r.constraint.version.patch};"
    i = i + 1
  }
  return msg
}

// Fails if some already-locked dependency's own transitive requirements
// name a DIFFERENT exact version of `name` than `ref` (owner decision,
// #2366's ticket, 2026-08-09: an exact pin means exactly that version, not
// "at least" — MVS's old max-of-minimums rule is gone with MVS itself). A
// non-version `ref` (branch/sha) has nothing for PubGrub to arbitrate and
// always passes. Takes the project's already-read `[]LockEntry` rather than
// a path, so `addDependency` reads bit.lock once per run instead of once
// here and once again to build the upsert list.
fn checkVersionConflict(
  existing: []LockEntry,
  name: string,
  ref: string,
  depRequires: []LockRequire,
): ()! {
  let (reqVersion, isVersion) = parseVersionTag(ref)
  if (!isVersion) {
    return
  }
  let transitive = pmExistingRequirementsFor(existing, name)
  let rootReqs = append(transitive, RootRequirement{ requirer: "root", name: name, constraint: Constraint{ op: ConstraintOp.Exact, version: reqVersion } })
  // `depRequires` is `LockRequire` (full-spec refs), the same shape
  // `versionRequirementsOf` (above) already narrows for a freshly-fetched
  // module during transitive resolution — reused here rather than a second,
  // near-identical extraction.
  let modules = [ModuleReqs{ name: name, version: reqVersion, requires: versionRequirementsOf(depRequires) }]
  let graph = ReqGraph{ rootRequires: rootReqs, modules: modules, available: packageVersionsFromModules(modules) }
  match (resolvePubGrub(graph)) {
    Ok(_) => { return }
    Err(f) => { fail newError(pmVersionConflictMessage(f)) }
  }
}

// `name`'s already-locked `url`, or `fallbackUrl` when bit.lock has no entry
// for it yet (a dependency added to bit.json by hand, never yet `add`ed or
// `up`ed) — `bit up` reuses the URL a dependency was ORIGINALLY fetched from
// rather than re-deriving it, so a non-standard-https remote (recorded once,
// at `add` time) survives every later refresh unchanged.
fn existingUrlFor(entries: []LockEntry, name: string, fallbackUrl: string): string {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return entries[i].url
    }
    i = i + 1
  }
  return fallbackUrl
}
