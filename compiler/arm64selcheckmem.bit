// In-Bit self-checks for #4396: field_set/index_set/atomic_store/
// atomic_cmpxchg must take their store width from the instruction's OWN
// recorded type (`ins.ival2`), never from the VALUE operand's defining
// instruction. Split out as a new sibling of compiler/arm64selcheck.bit,
// which was already at 784 lines against the 800-line limit and had no room
// left (the same reason compiler/arm64selcheckcvt.bit and
// compiler/arm64selcheckcmp.bit exist as their own files).
//
// Named to sort after compiler/arm64selcheckgen.bit and before
// compiler/arm64selcheckovf.bit — module files concatenate in bytewise
// filename order (compiler/project.bit:7).
//
// WHY DISAGREE THE TYPES ON PURPOSE. Before #4396, dispatch read the store
// width off `cx.f.instrs[<value operand>].ty` — so the golden corpus is
// blind to a regression here for the same reason #4363's M1 mutant was blind
// to a convert-elision bug: every value the corpus ever stores already
// agrees with its own store's declared type, because `optfold.bit`'s "THE
// TYPE MUST NOT CHANGE" invariant forbids the one fold that could make them
// disagree. These fixtures build the disagreement directly at the IR level,
// bypassing that invariant entirely, so a regression back to the old read is
// caught here regardless of what the optimizer does or does not do.
//
// `selCtx()` (arm64selcheck.bit) puts value N in vreg N in register xN, so
// operands below are named by their vreg id directly.

// Every ARM64 load/store-family encoding used by these four ops places its
// 2-bit access-width field at bits 30:31 of the first emitted word
// (arm64encode.bit's `storeImm`/`storeIndexed`/`ldstExclusive`, all built on
// `size << 30`) — 0 for a 1-byte access, 3 for 8 bytes. One check reads it.
fn arm64SizeField(code: ByteBuf): int {
  return (wordAt(code, 0) >> 30) & 3
}

fn checkArm64FieldSetWidthOwnType() {
  let cx = selCtx()
  let ctx = cx.module.ctx
  let i64ty = primType(ctx, 3)
  let u8ty = primType(ctx, 4)

  // ival2 says u8 (1 byte); the value's OWN defining instruction (vreg 1)
  // disagrees at i64 (8 bytes). The old, buggy read would emit an 8-byte
  // `str`; the fix must emit a 1-byte `strb`.
  cx.f.instrs[1] = mkInstr(Op.BlockParam, i64ty)
  let fs = mkInstr(Op.FieldSet, ctx.voidId)
  fs.lhs = 0
  fs.ival = 16
  fs.rhs = 1
  fs.ival2 = u8ty
  assert(compileInstMem(cx, 11, fs))
  assert(arm64SizeField(cx.code) == 0)

  // The other direction: ival2 says i64 while the value's own type is u8 —
  // proves this is a genuine read of ival2, not "always narrow".
  let cx2 = selCtx()
  cx2.f.instrs[1] = mkInstr(Op.BlockParam, u8ty)
  let fs2 = mkInstr(Op.FieldSet, ctx.voidId)
  fs2.lhs = 0
  fs2.ival = 16
  fs2.rhs = 1
  fs2.ival2 = i64ty
  assert(compileInstMem(cx2, 11, fs2))
  assert(arm64SizeField(cx2.code) == 3)
}

fn checkArm64IndexSetWidthOwnType() {
  let cx = selCtx()
  let ctx = cx.module.ctx
  let i64ty = primType(ctx, 3)
  let u8ty = primType(ctx, 4)

  // base=vreg0, index=vreg1, value=vreg2. Value's own type (i64) disagrees
  // with ival2 (u8) on purpose.
  cx.f.instrs[2] = mkInstr(Op.BlockParam, i64ty)
  let is0 = mkInstr(Op.IndexSet, ctx.voidId)
  is0.lhs = 0
  is0.rhs = 1
  is0.ival = 2
  is0.ival2 = u8ty
  assert(compileInstMem(cx, 11, is0))
  assert(arm64SizeField(cx.code) == 0)

  let cx2 = selCtx()
  cx2.f.instrs[2] = mkInstr(Op.BlockParam, u8ty)
  let is1 = mkInstr(Op.IndexSet, ctx.voidId)
  is1.lhs = 0
  is1.rhs = 1
  is1.ival = 2
  is1.ival2 = i64ty
  assert(compileInstMem(cx2, 11, is1))
  assert(arm64SizeField(cx2.code) == 3)
}

fn checkArm64AtomicStoreWidthOwnType() {
  let cx = selCtx()
  let ctx = cx.module.ctx
  let i64ty = primType(ctx, 3)
  let u8ty = primType(ctx, 4)

  cx.f.instrs[1] = mkInstr(Op.BlockParam, i64ty)
  let ins = mkInstr(Op.AtomicStore, ctx.voidId)
  ins.lhs = 0
  ins.rhs = 1
  ins.ival2 = u8ty
  assert(compileInstAtomic(cx, 11, ins))
  assert(arm64SizeField(cx.code) == 0)

  let cx2 = selCtx()
  cx2.f.instrs[1] = mkInstr(Op.BlockParam, u8ty)
  let ins2 = mkInstr(Op.AtomicStore, ctx.voidId)
  ins2.lhs = 0
  ins2.rhs = 1
  ins2.ival2 = i64ty
  assert(compileInstAtomic(cx2, 11, ins2))
  assert(arm64SizeField(cx2.code) == 3)
}

fn checkArm64AtomicCmpxchgWidthOwnType() {
  let cx = selCtx()
  let ctx = cx.module.ctx
  let i64ty = primType(ctx, 3)
  let u8ty = primType(ctx, 4)

  // expected=vreg1, desired=vreg2. `ldaxr`, the FIRST emitted word, carries
  // the width field — the fold-in retry loop after it does not change it.
  // Routed through compileInstAtomic (not emitAtomicCmpxchg directly) so the
  // DISPATCH line that reads `ins.ival2` is what is actually exercised.
  cx.f.instrs[1] = mkInstr(Op.BlockParam, i64ty)
  let ins = mkInstr(Op.AtomicCmpxchg, primType(ctx, 10))
  ins.lhs = 0
  ins.rhs = 1
  ins.ival = 2
  ins.ival2 = u8ty
  assert(compileInstAtomic(cx, 11, ins))
  assert(arm64SizeField(cx.code) == 0)

  let cx2 = selCtx()
  cx2.f.instrs[1] = mkInstr(Op.BlockParam, u8ty)
  let ins2 = mkInstr(Op.AtomicCmpxchg, primType(ctx, 10))
  ins2.lhs = 0
  ins2.rhs = 1
  ins2.ival = 2
  ins2.ival2 = i64ty
  assert(compileInstAtomic(cx2, 11, ins2))
  assert(arm64SizeField(cx2.code) == 3)
}
