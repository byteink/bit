// compiler/validateentry.bit — SPEC §17.4's entry-point signature rule (#2236).
// Sibling of validate.bit: same module, so this needs no imports and no
// call-site changes beyond the one hook in `checkModule`.
//
// WHAT WAS WRONG. Nothing judged `main` against §17.4's permitted signatures, so
// the two illegal shapes reached codegen and were normalized by a trampoline
// that assumes them away (runtime/ABI.md §10). Measured on brew 0.1.8 and on
// this tree before the rule landed:
//
//   function main(a: int)              rc=0, printed `a=4363964576` — the
//                                      parameter read out of a register the
//                                      caller never wrote
//   function main(a: int, b: string)   rc=139, SIGSEGV — the second register
//                                      dereferenced as a string
//   function main(...args: string)     rc=0, printed `variadic 4367974540`
//   function main(): string            rc=152 after printing its output
//   function main(): f64               rc=6 after printing its output
//   function main(): bool              rc=1 after printing its output
//
// `bit check` exited 0 and said nothing for every one of them. A crash at
// lowering and a garbage exit status are both worse than a diagnostic, and a
// diagnostic is what §17.4 already licenses: it fixes the signature set.
//
// WHY THE CHECKER AND NOT LOWERING. The permitted set is a property of the
// DECLARATION, decidable from the signature alone with no IR in hand, and
// `bit check` is build's front end (compiler/main.bit's `checkCmd`) — so
// rejecting here is what makes `bit build`, `bit run` and an editor's
// diagnostics agree.

// E0085 (§17.4): a `main` the entry trampoline cannot call. First free code
// above E0084; E0200+ is the lint registry (spec/LINT.md). Declared here rather
// than beside its neighbours in validate.bit's registry only because that file
// is at the 800-line ceiling.
const ecEntrySignature = 85

// §17.4's permitted signatures, as one hint fragment: the parameter rule and the
// result rule both name them, and a single source is what stops the two from
// drifting into different lists.
fn vEntryForms(): string {
  return "'main()', 'main(): int', 'main(): ()!' or 'main(): int!'"
}

// A top-level declaration with an `export` wrapper stripped. The Export node's
// single kid IS the declaration (parser.bit).
fn vUnwrapExport(c: Checker, node: int): int {
  if (node == 0 || getNode(c.tree, node).tag != Tag.Export) {
    return node
  }
  return kidsOf(c.tree, node)[0]
}

// Validates the root module's entry point against §17.4. Driven once per module
// from `checkModule`.
//
// WHICH DECLARATION IS THE ENTRY. Exactly the one `isFallibleEntry`
// (compiler/lowerentry.bit) recognizes, by the same three exclusions and for the
// same reason — a name that only READS like the entry point is an ordinary
// function, and holding it to §17.4 would be a false positive on working code:
//
//   * the root module only. Every other module's names are prefixed `m<id>$`
//     (Checker.moduleId), so a library's `main` is never branched to.
//   * no receiver. `function (s: S) main(a: int): string` is a method; measured
//     before this rule, a program with one alongside a real `main()` built and
//     ran correctly.
//   * no `@symbol` pin. The pin renames the SYMBOL, and the trampoline branches
//     to the symbol named `main` — measured, `@symbol("altmain") function
//     main(a: int)` already fails the build with `NoMain`, so the declaration is
//     not the entry point in the first place.
//
// Top-level children of the Program node, not an arena walk: §17.4 is about the
// module's own declaration, and `Tag.MethodSig` (an interface's `main(): string`)
// must not be mistaken for one.
fn vEntrySignature(c: Checker) {
  if (!c.entryModule) {
    return
  }
  for d of kidsOf(c.tree, c.tree.root) {
    let decl = vUnwrapExport(c, d)
    if (decl == 0 || getNode(c.tree, decl).tag != Tag.FuncDecl) {
      continue
    }
    // [recv, name, generics, params, result, body(, attrs)] — the 7th child is
    // elided when the decl carries no `@attr`, so every index read here is below
    // the width both shapes share (parser.bit, and vFuncDecl's own assert).
    let kids = kidsOf(c.tree, decl)
    if (kids[0] != 0 || vIdentText(c, kids[1]) != "main") {
      continue
    }
    if (funcHasAttr(c, decl, "symbol")) {
      continue
    }
    vEntryParams(c, kids)
    vEntryResult(c, kids)
  }
}

// §17.4: "`main` takes no parameters". The trampoline calls `main` with an empty
// argument list, so a declared parameter is whatever the calling convention left
// in that register — garbage for the first, a fault for the second. Spanning the
// Params node carets the whole list; it is `spanOfKids`-derived (parsertype.bit),
// which is exact here because this reports only when the list is non-empty.
fn vEntryParams(c: Checker, kids: []int) {
  if (kids[3] == 0 || len(kidsOf(c.tree, kids[3])) == 0) {
    return
  }
  report(c.diags, ecEntrySignature, vSpan(c, kids[3]),
    "'main' takes no parameters",
    "read command-line arguments and the environment through 'std/os'; the entry point is one of ${vEntryForms()} (SPEC §17.4)")
}

// §17.4's return rule. Permitted: no result at all, `int`, `()!` and `int!` —
// exactly the set the entry path turns into an exit code. The trampoline
// supplies a constant 0 for a void `main` and passes an `int` `main`'s register
// through, and `emitMainOkRet` (compiler/lowerentry.bit) widens a fallible
// `main`'s integer ok value into the same register (runtime/ABI.md §10).
//
// `int` IS `i64` — `primIndexByName` maps both onto prim 3 — so `main(): i64` is
// the same declaration written differently and is equally accepted, as is the
// explicit void spelling `main(): ()`. `uint`, `i32` and the rest are not: they
// are absent from §17.4, and a program that wants a wider or narrower exit
// status has 8 bits to work with either way (ABI.md §9 truncates).
//
// Permissive when the result type did not resolve — THE SAFETY RULE
// (validate.bit): the undefined type name is already reported at its own span,
// and a second diagnostic naming `<error>` states nothing true about the program.
fn vEntryResult(c: Checker, kids: []int) {
  if (kids[4] == 0) {
    return
  }
  let declared = typeFromNode(c, kids[4])
  if (vMentionsInvalid(c, declared, 0)) {
    return
  }
  let ok = unwrapFallible(c, declared)
  if (ok == c.ctx.voidId || ok == primType(c.ctx, 3)) {
    return
  }
  report(c.diags, ecEntrySignature, vSpan(c, kids[4]),
    "'main' cannot return '${typeName(c.ctx, declared)}'",
    "the entry point is one of ${vEntryForms()} (SPEC §17.4)")
}
