// #7716: the arm64 emitter for regallocclear.bit's callee-saved register
// clears, split out of arm64select.bit at the 800-line ceiling. Same module.

// #7716: zeroes the dead heap-word callee-saved registers the instruction at `idx` owes
// (regallocclear.bit: a call's, or #7732's loop-entry terminator's), only those the prologue saves.
// #7763: a spill store emitted right before stays forwardable (`spillFwd`)
// unless a clear zeroed its register: a clear writes no frame slot, no
// scratch, and nothing else.
fn emitRegClears(cx: A64Ctx, idx: int) {
  let mask = a64ClearsBefore(cx, idx)
  let fwd = cx.spillStAt > 0 && cx.spillStAt == codeLen(cx)
  let r = 0
  while (mask != 0 && r < len(cx.intRegs)) {
    if (((mask >> r) & 1) == 1 && regInList(cx.frame.savedGpr, cx.intRegs[r])) {
      movImm64(cx.code, noteIntReg(cx, cx.intRegs[r]), 0)
      fwd = fwd && (cx.spillStClass != RegClass.Int || cx.spillStReg != cx.intRegs[r])
    }
    r = r + 1
  }
  if (fwd) {
    cx.spillStAt = codeLen(cx)
  }
}

// #7763: the clears to emit before the instruction at `idx`. A `br`'s own move
// up before the compare it fuses (`fuseCmp`): between the two they would split
// the cmp+b.cond pair the core fuses, and the compare reads none of them
// (regallocclearhoist.bit, `branchMaskAt`; a CBZ's operand included).
fn a64ClearsBefore(cx: A64Ctx, idx: int): int {
  if (idx < len(cx.fuseCmp) && cx.fuseCmp[idx]) {
    return regClearsAt(cx.result, idx) | regClearsAt(cx.result, idx + 1)
  }
  if (idx > 0 && idx <= len(cx.fuseCmp) && cx.fuseCmp[idx - 1]) {
    return 0
  }
  return regClearsAt(cx.result, idx)
}
