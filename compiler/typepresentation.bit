// Declaration-owned display keeps AST labels outside canonical Type identity.
class TypePresentation {
  owner: Checker,
  node: int,
}

fn resolveDeclaredSymbol(mods: []Checker, modIdx: int, sym: Symbol): LspResolvedSymbol {
  let curMod = modIdx
  let cur = sym
  let hops = 0
  while (cur.importedFromModule >= 0 && hops < 8) {
    hops = hops + 1
    if (cur.importedFromModule >= len(mods)) {
      return LspResolvedSymbol{ found = false, modIdx = 0, sym = cur }
    }
    let targetC = mods[cur.importedFromModule]
    if (cur.importedFromSymbol <= 0 || cur.importedFromSymbol >= len(targetC.symbols)) {
      return LspResolvedSymbol{ found = false, modIdx = 0, sym = cur }
    }
    curMod = cur.importedFromModule
    cur = targetC.symbols[cur.importedFromSymbol]
  }
  if (cur.importedFromModule >= 0) {
    return LspResolvedSymbol{ found = false, modIdx = 0, sym = cur } // hop limit
  }
  return LspResolvedSymbol{ found = true, modIdx = curMod, sym = cur }
}

fn presentationSymbolId(c: Checker, node: int): int {
  if (node <= 0 || node >= len(c.nodeSymbols)) {
    return 0
  }
  let sid = c.nodeSymbols[node]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return 0
  }
  return sid
}

fn presentationOwner(c: Checker, moduleId: int): Checker {
  if (moduleId == c.moduleId) {
    return c
  }
  return c.mods[moduleId]
}

fn presentationTypeOrigin(c: Checker, node: int): TypePresentation {
  let origin = TypePresentation{ owner = c, node = node }
  let hops = 0
  while (origin.node > 0 && hops < 8) {
    if (getNode(origin.owner.tree, origin.node).tag != Tag.Ident) {
      break
    }
    let sid = presentationSymbolId(origin.owner, origin.node)
    if (sid == 0) {
      break
    }
    let ref = resolveDeclaredSymbol(
      origin.owner.mods,
      origin.owner.moduleId,
      origin.owner.symbols[sid],
    )
    if (!ref.found || ref.sym.kind != SymbolKind.TypeAlias || ref.sym.decl == 0) {
      break
    }
    origin.owner = presentationOwner(origin.owner, ref.modIdx)
    origin.node = kidsOf(origin.owner.tree, ref.sym.decl)[2]
    hops = hops + 1
  }
  return origin
}

fn presentationHasNames(tree: Tree, node: int, depth: int): bool {
  if (node == 0 || depth >= fmtMaxDepth) {
    return false
  }
  if (isFunctionTypeParam(tree, node)) {
    return true
  }
  for child of kidsOf(tree, node) {
    if (presentationHasNames(tree, child, depth + 1)) {
      return true
    }
  }
  return false
}

fn presentationTypeText(c: Checker, node: int, fallback: string): string {
  let origin = presentationTypeOrigin(c, node)
  if (!presentationHasNames(origin.owner.tree, origin.node, 0)) {
    return fallback
  }
  let p = Printer{
    source = origin.owner.source, tree = origin.owner.tree, out = []byte(0),
    comments = []Comment(0), trailAligns = []TrailAlign(0), pendingReceiverGenerics = []int(0),
  }
  return fmtRenderFlat(p, origin.node)
}

fn presentationAliasText(c: Checker, decl: int, name: string, params: string): string {
  let fallback = name + params
  if (getNode(c.tree, decl).tag != Tag.TypeAlias) {
    return fallback
  }
  let text = presentationTypeText(c, kidsOf(c.tree, decl)[2], "")
  if (text == "") {
    return fallback
  }
  return fallback + " = " + text
}

fn presentationFuncText(c: Checker, decl: int, ty: int): string {
  let fallback = typeName(c.ctx, ty)
  if (decl == 0 || getNode(c.tree, decl).tag != Tag.FuncDecl) {
    return fallback
  }
  let sig = c.ctx.types[ty]
  let k = kidsOf(c.tree, decl)
  let params = kidsOf(c.tree, k[3])
  if (len(params) != len(sig.members)) {
    return fallback
  }
  let out = "("
  let i = 0
  while (i < len(params)) {
    if (i != 0) {
      out = out + ", "
    }
    if (sig.variadic && i == len(params) - 1) {
      out = out + "..."
    }
    let pt = typeName(c.ctx, sig.members[i])
    out = out + presentationTypeText(c, kidsOf(c.tree, params[i])[1], pt)
    i = i + 1
  }
  let result = presentationTypeText(c, k[4], typeName(c.ctx, sig.result))
  return out + ") => " + result
}

fn presentationFieldText(c: Checker, recvType: int, name: string, ty: int): string {
  let fallback = typeName(c.ctx, ty)
  let decl = structDeclOf(c, recvType)
  if (decl == 0) {
    return fallback
  }
  let owner = typeOwner(c, recvType)
  for field of structFieldNodes(owner, decl) {
    let k = kidsOf(owner.tree, field)
    let n = getNode(owner.tree, k[0])
    if (owner.source[n.span.start:n.span.end] == name) {
      return presentationTypeText(owner, k[1], fallback)
    }
  }
  return fallback
}

fn lspHoverNodeType(c: Checker, node: int): int {
  let ty = 0
  if (node > 0 && node < len(c.nodeTypes)) {
    ty = c.nodeTypes[node]
  }
  // `nodeTypes` is only fully populated by the `--dump-types` walk (binders get
  // an entry during the normal check, expression usages do not), so an
  // identifier/member/call the user hovers on falls back to re-deriving its type
  // the same way the checker does. The instantiations this produces are deduped
  // by `recordInstantiation`, and no checker path reports a diagnostic — which
  // is what makes it safe against a project that outlives the request
  // (lspbuild.bit), where the cheap `memo`-shaped side effects on `nodeTypes`
  // are the same answer a fresh build would re-derive. `lspFindSnapshot` rolls
  // the diagnostics sink back on every reuse so that safety is structural
  // rather than a standing invitation to break it.
  if (ty <= 0 && node > 0) {
    let tag = getNode(c.tree, node).tag
    if (isLeafTag(tag) || tag == Tag.Member || tag == Tag.Call) {
      ty = checkExprType(c, node)
    }
  }
  return ty
}

fn lspDeclaredHoverType(lp: LspProject, c: Checker, sid: int, ty: int): string {
  let fallback = ""
  if (ty > 0) {
    fallback = typeName(c.ctx, ty)
  }
  if (sid == 0) {
    return fallback
  }
  let ref = lspResolveImportChain(lp, c.moduleId, c.symbols[sid])
  if (!ref.found || ref.sym.decl == 0) {
    return fallback
  }
  let owner = presentationOwner(c, ref.modIdx)
  let decl = ref.sym.decl
  if (ref.sym.kind == SymbolKind.TypeAlias) {
    return presentationTypeText(owner, kidsOf(owner.tree, decl)[2], fallback)
  }
  if (ref.sym.kind == SymbolKind.Func && ty > 0) {
    return presentationFuncText(owner, decl, ty)
  }
  return presentationTypeText(owner, owner.declTypeNodes[decl], fallback)
}
