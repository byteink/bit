// ELF object validation, preserving the writer's rejection order.

fn ewValidateSections(obj: ElfObject, present: []bool, byKind: []ElfSection): ()! {
  let si = 0
  while (si < len(obj.sections)) {
    let s = obj.sections[si]
    let idx = elfKindIndex(s.kind)
    if (present[idx]) {
      fail newError("DuplicateSection")
    }
    if (s.alignment != 0 && !elfIsPowerOfTwo(s.alignment)) {
      fail newError("InvalidSectionAlignment")
    }
    present[idx] = true
    byKind[idx] = s
    si = si + 1
  }

}

fn ewValidateSymbol(sym: ElfSymbol, present: []bool, byKind: []ElfSection): ()! {
  if (!sym.hasSection && sym.binding == ElfBinding.Local) {
    fail newError("UndefinedLocalSymbol")
  }
  if (sym.offset < 0 || sym.size < 0) {
    fail newError("SymbolOutOfBounds")
  }
  if (sym.hasSection) {
    let kidx = elfKindIndex(sym.section)
    if (!present[kidx]) {
      fail newError("SectionNotPresent")
    }
    if (!loRangeOk(elfSectionBytes(byKind[kidx]), sym.offset, sym.size)) {
      fail newError("SymbolOutOfBounds")
    }
  }
}

fn ewLocalSymbols(obj: ElfObject, present: []bool, byKind: []ElfSection): []int! {
  // ---- symbol order: every STB_LOCAL before any STB_GLOBAL ---------------
  // ELF's symtab contract: sh_info names the boundary as a single index, so the
  // two groups must be contiguous. Each group keeps obj.symbols's own order.
  // `order[i]` is the original index landing at final symtab slot i+1 (slot 0 is
  // the mandatory null symbol).
  let order = []int(0)
  let yi = 0
  while (yi < len(obj.symbols)) {
    let sym = obj.symbols[yi]
    ewValidateSymbol(sym, present, byKind)?
    if (sym.binding == ElfBinding.Local) {
      order = append(order, yi)
    }
    yi = yi + 1
  }
  return order
}

fn ewGlobalSymbols(obj: ElfObject, order: []int): []int {
  let yi = 0
  while (yi < len(obj.symbols)) {
    if (obj.symbols[yi].binding != ElfBinding.Local) {
      order = append(order, yi)
    }
    yi = yi + 1
  }

  return order
}

fn ewSymbolIndex(obj: ElfObject, order: []int): map<string, int>! {
  // Final symtab slot of each symbol, by name (+1 past the null symbol).
  let symIdx = map<string, int>{}
  let oi = 0
  while (oi < len(order)) {
    let nm = obj.symbols[order[oi]].name
    let (_, dup) = symIdx[nm]
    if (dup) {
      fail newError("DuplicateSymbol")
    }
    symIdx[nm] = oi + 1
    oi = oi + 1
  }

  return symIdx
}

fn ewValidateRelocations(
  target: ElfTarget,
  obj: ElfObject,
  sections: ([]bool, []ElfSection),
  symIdx: map<string, int>,
): ()! {
  let (present, byKind) = sections
  // ---- validate relocations, bucketed by target section ------------------
  let ri = 0
  while (ri < len(obj.relocations)) {
    let r = obj.relocations[ri]
    let kidx = elfKindIndex(r.section)
    if (!present[kidx]) {
      fail newError("SectionNotPresent")
    }
    if (!loRangeOk(elfSectionBytes(byKind[kidx]), r.offset, elfRelocWidth(r.kind))) {
      fail newError("RelocOutOfBounds")
    }
    if (elfRelocType(r.kind, target) < 0) {
      fail newError("RelocKindUnsupportedForTarget")
    }
    // #5198: the two-result index form, not a scan of `obj.symbols`. `order`
    // is a permutation of every symbol index (locals in the first pass above,
    // non-locals in the second), and the loop that fills `symIdx` rejects a
    // repeated name, so membership in `symIdx` is exactly membership in
    // `obj.symbols`. The scan made writing an object O(R*S) in its own
    // relocation and symbol counts; the rela emission below already reads this
    // same map by hash.
    let (_, known) = symIdx[r.symbol]
    if (!known) {
      fail newError("UnknownSymbol")
    }
    ri = ri + 1
  }

}

