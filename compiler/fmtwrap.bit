// Self-host `bit fmt` (#1345): the width-aware wrap-decision machinery —
// flat lists, bracketed comma lists, and binary/logical chain flattening
// (#2889). All three share one shape: render flat into a scratch buffer,
// keep it if that fits under fmtMaxWidth and holds no comment, else
// re-render one item/operand per line at one deeper indent. Split out of
// fmt.bit to keep each file within the size limit; a sibling .bit file is
// the same module.

// A comma-free, delimiter-free list (return values, assignment sides, `case`
// expressions, constraint bounds). Width-aware (#2889): joins flat if that
// fits under fmtMaxWidth and holds no comment, else renders one item per
// line at one deeper indent, `sep` trailing the line before it (a single
// item never benefits from wrapping, so it always stays flat).
fn fmtPrintFlatList(p: Printer, items: []int, sep: string) {
  let tail = p.nextListTail
  p.nextListTail = 0
  if (len(items) <= 1) {
    let i = 0
    while (i < len(items)) {
      fmtPrintNode(p, items[i])
      i = i + 1
    }
    return
  }
  let spanEnd = getNode(p.tree, items[len(items) - 1]).span.end
  if (!fmtHasCommentBefore(p, spanEnd)) {
    let colBefore = p.col
    let bolBefore = p.bol
    // The trial below renders every item for real through fmtPrintNode, which
    // one-way-ratchets p.srcPos past each item's span (fmt.bit's fmtPrintNode).
    // On the fits path the trial's text IS the real output, so that advance is
    // correct and must stand. On the fallthrough path the items are about to
    // be rendered again for real below, so p.srcPos must be put back or the
    // second render's newlinesBetween/fmtGap calls see a watermark stuck past
    // positions inside the very items being re-descended into (#2901).
    let srcPosBefore = p.srcPos
    // A trial that starts at the beginning of a fresh line (bol) must not let
    // its own lazy indent write bake into the captured `text` (fmtRaw fires
    // the same lazy-indent path in a trial as it does for real): forcing bol
    // false for the trial's own duration produces indent-free text, and the
    // true eventual column -- what fmtRaw would land on once bol is restored
    // -- is p.indent*fmtIndentWidth, not the pre-indent p.col of 0 fmtNewline
    // left behind. Using the raw p.col here would both double the indent (the
    // baked-in copy plus the real write fmtRaw(text) triggers below) and
    // under-count the fits check by a full indent's width.
    let effectiveCol = colBefore
    if (bolBefore) {
      effectiveCol = p.indent * fmtIndentWidth
    }
    let savedOut = p.out
    p.out = []byte(0)
    p.bol = false
    // This list's own fits check below is genuine (never moot, unlike the
    // single-item override in fmtPrintCommaList) -- it always has 2+ items
    // here, since len(items) <= 1 already returned above -- so a nested
    // single-item ancestor's speculative-flat state must not leak into a
    // descendant's wrap decision while THIS list's own real, column-dependent
    // decision is what matters (#2894).
    let savedSpeculative = p.speculativeFlat
    p.speculativeFlat = false
    let i = 0
    while (i < len(items)) {
      if (i > 0) {
        fmtRaw(p, sep)
      }
      fmtPrintNode(p, items[i])
      i = i + 1
    }
    p.speculativeFlat = savedSpeculative
    let text = string(p.out)
    p.out = savedOut
    p.col = colBefore
    p.bol = bolBefore
    if (!fmtHasNl(text) && effectiveCol + len(text) + tail <= fmtMaxWidth) {
      fmtRaw(p, text)
      return
    }
    p.srcPos = srcPosBefore
  }
  let sepTrim = sep
  if (len(sep) > 0 && sep[len(sep) - 1] == ' ') {
    sepTrim = sep[0:len(sep) - 1]
  }
  p.indent = p.indent + 1
  let j = 0
  while (j < len(items)) {
    if (j > 0) {
      fmtGap(p, getNode(p.tree, items[j]).span.start, false)
    }
    fmtPrintNode(p, items[j])
    if (j < len(items) - 1) {
      fmtRaw(p, sepTrim)
    }
    j = j + 1
  }
  p.indent = p.indent - 1
}

// Whether any BETWEEN-ITEM gap, or the gap from the last item to `spanEnd`
// (mirrors a trailing comma pushing the close onto its own line, where the
// caller's span reaches that far — a plain call's Args node never does, see
// fmtOpenBroken for the opening-side equivalent), carries a source newline.
// Never a newline nested inside one item's own content: a gap that only
// exists inside an item (e.g. a class-literal argument the author
// hand-wrapped) is not evidence the *list itself* was laid out across lines,
// and treating it as such flips `grouped` between formatting passes as that
// inner item's own wrap decision changes with the outer column budget — the
// idempotence bug this scoping fixes.
fn fmtAnyItemGapHasNewline(p: Printer, items: []int, spanEnd: int): bool {
  let i = 1
  while (i < len(items)) {
    let prevEnd = getNode(p.tree, items[i - 1]).span.end
    let start = getNode(p.tree, items[i]).span.start
    if (newlinesBetween(p.source, prevEnd, start) > 0) {
      return true
    }
    i = i + 1
  }
  let lastEnd = getNode(p.tree, items[len(items) - 1]).span.end
  return newlinesBetween(p.source, lastEnd, spanEnd) > 0
}

// Whether the source already breaks this list right after its opening
// delimiter, i.e. `firstStart` is not on the same source line as whatever
// immediately precedes it. Deliberately does not use `p.srcPos`: that only
// advances when a real sibling node or comment was printed immediately
// before this list, which is untrue whenever the list is the first thing
// printed in its own statement — a `let (a, b) = ...` binding's `TuplePat`,
// or an `ImportGroup` right after the synthetic `"import "` text — where
// `p.srcPos` is stale from the end of a wholly unrelated, earlier statement,
// so a plain `newlinesBetween(p.source, p.srcPos, firstStart)` reports a
// break that isn't there. Scanning back over pure whitespace instead needs
// nothing but `firstStart` itself: the run of bytes strictly before it is
// either whitespace only (an opening delimiter with nothing else between it
// and the first item) or ends in a comment's own last byte, and either way a
// '\n' inside that whitespace run means the item did not start on the same
// line as whatever the run's non-whitespace end is.
fn fmtOpenBroken(source: string, firstStart: int): bool {
  let i = firstStart - 1
  while (i >= 0) {
    let ch = source[i]
    if (ch == ' ' || ch == '\t' || ch == '\r') {
      i = i - 1
    } else if (ch == '\n') {
      return true
    } else {
      return false
    }
  }
  return false
}

// A bracketed comma list (params, args, class fields, generics, ...). Greedy
// width-aware wrapping: render flat into a scratch buffer; if the source
// didn't already break the list, it has no comment, and it fits, keep it,
// else re-render one item per line (preserving the author's grouping) with a
// trailing comma. `{`/`}` pad with an inner space when flat.
fn fmtPrintCommaList(p: Printer, items: []int, open: string, closeStr: string, spanEnd: int) {
  let tail = p.nextListTail
  p.nextListTail = 0
  fmtRaw(p, open)
  let pad = len(open) == 1 && open == "{"

  if (len(items) == 0) {
    if (fmtHasCommentBefore(p, spanEnd)) {
      p.indent = p.indent + 1
      fmtGap(p, spanEnd, false)
      p.indent = p.indent - 1
    }
    fmtRaw(p, closeStr)
    return
  }

  // The author's own line break is authoritative, at the list's own
  // boundaries only (right after the opener, or between two adjacent items —
  // the same two checks #2880's fixed-point fix already scoped `grouped` to,
  // never a break inside one item's own content). A list the source already
  // broke there is never a candidate for the flat/fits trial below, no
  // matter how short the joined form would be: joining it is what silently
  // deleted the wrapped import-list and class-declaration spelling that
  // SPEC §17.2 documents as the one that parses (#2140).
  let firstStart = getNode(p.tree, items[0]).span.start
  let authorBroke = fmtOpenBroken(p.source, firstStart) ||
    fmtAnyItemGapHasNewline(p, items, spanEnd)

  if (!authorBroke && !fmtHasCommentBefore(p, spanEnd)) {
    let colBefore = p.col
    // `fmtRaw(p, open)` above already ran unconditionally, and fmtRaw always
    // resolves a pending bol to false once it writes non-empty text -- so
    // unlike fmtPrintFlatList/fmtPrintBinaryChain's identical-looking trial
    // (see their comment for the double-indent this guards against there),
    // bol is provably already false by this point for every caller, and a
    // plain save/restore -- mirroring p.col -- is sufficient here.
    let bolBefore = p.bol
    // See fmtPrintFlatList's srcPosBefore comment: the trial below advances
    // p.srcPos for real via fmtPrintNode, correctly on the fits path (the
    // trial's text is kept) but stale on the fallthrough path, where the same
    // items are about to be re-descended into for real (#2901).
    let srcPosBefore = p.srcPos
    let savedOut = p.out
    p.out = []byte(0)
    // A single-item list's own accept/reject decision below never depends on
    // `fits` -- it keeps the item flat regardless of overflow, so a nested
    // width-dependent decision (`fmtPrintBinaryChain`) rendering that sole
    // item is answering a moot question if it measures against the real,
    // inherited `colBefore`: this list was always going to accept the result
    // flat unless the trial text itself holds a newline, and a premature wrap
    // only manufactures that newline, forcing this list -- and every
    // enclosing single-item list in turn -- to explode for no shortening
    // gain (#2894). `speculativeFlat` tells such a nested decision to measure
    // from the indent baseline instead (the same baseline `bolBefore` already
    // uses below). A multi-item list's own decision here IS real, so it
    // clears the flag for its own trial.
    let savedSpeculative = p.speculativeFlat
    p.speculativeFlat = len(items) == 1
    let i = 0
    while (i < len(items)) {
      if (i > 0) {
        fmtRaw(p, ", ")
      }
      fmtPrintNode(p, items[i])
      i = i + 1
    }
    p.speculativeFlat = savedSpeculative
    let text = string(p.out)
    p.out = savedOut
    p.col = colBefore
    p.bol = bolBefore
    let extra = 0
    if (pad) {
      extra = 2
    }
    // A single-element list stays flat even when over-width: wrapping a lone
    // item never shortens the line meaningfully. Multi-element lists still wrap.
    let fits = colBefore + extra + len(text) + len(closeStr) + tail <= fmtMaxWidth
    if (!fmtHasNl(text) && (len(items) == 1 || fits)) {
      if (pad) {
        fmtRaw(p, " ")
      }
      fmtRaw(p, text)
      if (pad) {
        fmtRaw(p, " ")
      }
      fmtRaw(p, closeStr)
      return
    }
    p.srcPos = srcPosBefore
  }

  fmtNoteChainListBreak(p)
  p.indent = p.indent + 1
  // Preserve the author's grouping: same boundary check as `authorBroke`
  // above, so two items stay on the same output line exactly where the
  // source kept them on the same source line, and a hand-laid table is not
  // exploded.
  let grouped = authorBroke
  let prevEnd = firstStart
  let j = 0
  while (j < len(items)) {
    let it = items[j]
    let start = getNode(p.tree, it).span.start
    let sameLine = grouped &&
      j > 0 &&
      newlinesBetween(p.source, prevEnd, start) == 0 &&
      !fmtHasCommentBefore(p, start)
    if (sameLine) {
      fmtRaw(p, " ")
    } else {
      fmtGap(p, start, false)
    }
    let itEnd = getNode(p.tree, it).span.end
    // The trailing comma below always lands right after this item, so an
    // item that is the LAST one on its own output line must see it coming
    // before it makes its own width decision (a nested `&&`/`||` chain or
    // comma list, #2892) -- same one-shot hint FuncDecl already threads into
    // its params (fmtdispatch.bit). A mid-line grouped item is deliberately
    // left at 0: the group's own over-budget width is settled behavior
    // (#2140/#2880) that this hint must not perturb.
    let lastOnLine = j == len(items) - 1
    if (!lastOnLine) {
      let nextStart = getNode(p.tree, items[j + 1]).span.start
      lastOnLine = !(grouped &&
        newlinesBetween(p.source, itEnd, nextStart) == 0 &&
        !fmtHasCommentBefore(p, nextStart))
    }
    if (lastOnLine) {
      p.nextListTail = 1
    } else {
      p.nextListTail = 0
    }
    fmtPrintNode(p, it)
    fmtRaw(p, ",")
    prevEnd = itEnd
    j = j + 1
  }
  fmtGap(p, spanEnd, false)
  p.indent = p.indent - 1
  fmtRaw(p, closeStr)
}

// Records that a bracketed comma list is about to wrap, for
// `fmtTryChainNestedWrap`'s at-most-one-break rule (#4367). Called
// unconditionally from `fmtPrintCommaList`'s wrap path so that function's own
// McCabe complexity is untouched -- the same reason `fmtBinarySideAlwaysWrap`
// and `fmtUnaryOperandWrap` (fmtexpr.bit) exist. Outside a chain trial
// (`chainFlatOnly` false) nobody reads the counter and this is a no-op.
fn fmtNoteChainListBreak(p: Printer) {
  if (p.chainFlatOnly) {
    p.chainListBreaks = p.chainListBreaks + 1
  }
}

// The tags that ALWAYS need parens as a binary operand, regardless of
// precedence — split out of `fmtPrintBinarySide` purely to keep that
// function's own McCabe complexity from growing every time one more joins
// (spec/LINT.md E0204, tools/build/complexity-debt.txt's baseline for
// `fmtPrintBinarySide`): each `||` here costs THIS function's complexity,
// never `fmtPrintBinarySide`'s.
fn fmtBinarySideAlwaysWrap(t: Tag): bool {
  return t == Tag.CatchDefault || t == Tag.CatchBind || t == Tag.ArrowFn || t == Tag.CondExpr
}

// One side of a binary expression, re-parenthesized when precedence (with
// left-associativity), the bitwise/shift clarity rule, or the boolean-mix
// clarity rule requires it.
fn fmtPrintBinarySide(p: Printer, idx: int, parentOp: int, isRhs: bool) {
  let t = getNode(p.tree, idx).tag
  let wrap = fmtBinarySideAlwaysWrap(t)
  if (!wrap && t == Tag.Binary) {
    let childOp = getNode(p.tree, idx).main
    let parentPrec = fmtPrec(parentOp)
    let childPrec = fmtPrec(childOp)
    let precWrap = false
    if (isRhs) {
      precWrap = childPrec <= parentPrec
    } else {
      precWrap = childPrec < parentPrec
    }
    // A bitwise/shift expression mixing two different operators, or a `&&`
    // group nested in a `||` (or vice versa, #2356), is always parenthesized
    // for clarity, even where precedence makes it redundant. The boolean-mix
    // half is scoped to BOTH sides being `&&`/`||` -- a comparison leaf under
    // `&&`/`||` (e.g. `a == b || c`) is unaffected, since precedence there is
    // already unambiguous and not the shape #2356 is about.
    let styleWrap = childOp != parentOp &&
      (fmtIsBitOrShift(parentOp) ||
        fmtIsBitOrShift(childOp) ||
        (fmtIsBoolConn(parentOp) && fmtIsBoolConn(childOp)))
    wrap = precWrap || styleWrap
  }
  if (wrap) {
    fmtRaw(p, "(")
    fmtPrintNode(p, idx)
    fmtRaw(p, ")")
  } else {
    fmtPrintNode(p, idx)
  }
}

// A conditional's condition (§12, #3941): only a nested conditional or an
// arrow needs re-parenthesizing there. `cond` is parsed as `parseBinary(1)`,
// which already threads `catch` into its own climb, so a `Binary`/
// `CatchDefault`/`CatchBind` value is a NATURAL result of that parse and needs
// no parens back — but `parseBinary` can never itself produce a `CondExpr` or
// an `ArrowFn`; the only way either reaches this position is source parens
// that the tree does not preserve (`(a ? b : c) ? d : e`,
// `((x) => x > 0) ? d : e`), so printing them bare would read as one
// expression that swallows everything after it, not the value it actually is.
fn fmtPrintCondCond(p: Printer, idx: int) {
  let t = getNode(p.tree, idx).tag
  let wrap = t == Tag.CondExpr || t == Tag.ArrowFn
  if (wrap) {
    fmtRaw(p, "(")
    fmtPrintNode(p, idx)
    fmtRaw(p, ")")
  } else {
    fmtPrintNode(p, idx)
  }
}

// Whether a binary node with operator `childOp` belongs to the SAME
// left-associative chain as a node whose operator is `parentOp`: exactly the
// same precedence tier (a strictly higher-precedence child, e.g. `k == 1`
// under a `||` parent, is a leaf operand of the chain, not another link in
// it -- flattening past it would tear the leaf's own operator and operand
// apart onto different lines) and not the bitwise/shift clarity-parens case
// (#1266, see fmtIsBitOrShift). Every flattened link renders bare as an LHS
// either way, since equal precedence never triggers fmtPrintBinarySide's
// `childPrec < parentPrec` wrap test.
fn fmtChainFlattens(childOp: int, parentOp: int): bool {
  let sameTier = fmtPrec(childOp) == fmtPrec(parentOp)
  let styleWrap = childOp != parentOp && (fmtIsBitOrShift(parentOp) || fmtIsBitOrShift(childOp))
  return sameTier && !styleWrap
}

// A left-associative run of operands sharing one no-parens spine (#2889):
// `atoms[0] ops[0] atoms[1] ops[1] atoms[2] ...`. `ops[i]` is always the
// operator that decides atoms[i]'s own wrap -- as an LHS for i == 0, as an
// RHS for i > 0 -- so printing re-derives every wrap decision through
// fmtPrintBinarySide exactly as the un-flattened recursive printer did.
class BinaryChain {
  atoms: []int,
  ops: []int,
  // Byte offset in the unwrapped render (`fmtPrintChain` with `wrapped`
  // false, which only ever runs into a scratch buffer that starts empty)
  // just past each atom, recorded there and read by `fmtChainSuffixWidth`
  // (#4367). Empty until that render has run.
  ends: []int,
}

// The left spine below a node whose operator is `parentOp`: keeps
// flattening while `idx` is a `Binary` node that renders bare under
// `parentOp` (fmtChainFlattens); otherwise `idx` is the chain's next atom.
fn fmtCollectChainSide(p: Printer, idx: int, parentOp: int): BinaryChain {
  let n = getNode(p.tree, idx)
  if (n.tag == Tag.Binary && fmtChainFlattens(n.main, parentOp)) {
    let k = kidsOf(p.tree, idx)
    let left = fmtCollectChainSide(p, k[0], n.main)
    left.atoms = append(left.atoms, k[1])
    left.ops = append(left.ops, n.main)
    return left
  }
  return BinaryChain{ atoms: append([]int(0), idx), ops: []int(0), ends: []int(0) }
}

// The chain rooted at `idx`, a known `Binary` node.
fn fmtCollectBinaryChain(p: Printer, idx: int): BinaryChain {
  let n = getNode(p.tree, idx)
  let k = kidsOf(p.tree, idx)
  let left = fmtCollectChainSide(p, k[0], n.main)
  left.atoms = append(left.atoms, k[1])
  left.ops = append(left.ops, n.main)
  return left
}

// One render of a collected chain: `wrapped` breaks to a fresh line (at the
// caller's current indent) between an operator and the operand after it --
// the same trailing-operator spelling this corpus already hand-wraps
// `||`/`&&` chains in today -- via `fmtGap`, so a comment between two
// operands is flushed (trailing the line it was adjacent to in the source,
// per FMT.md §4) rather than left pending, which would otherwise misfire a
// nested chain's OWN comment check (#2889).
//
// The `!wrapped` render records `chain.ends` on the way past each atom
// (#4367): it always runs into a scratch buffer that starts empty, so
// `len(p.out)` there IS the offset into the text the caller captures, and
// `fmtChainSuffixWidth` reads it back to tell a nested comma list how many
// columns of this chain follow it on its own line.
fn fmtPrintChain(p: Printer, chain: BinaryChain, wrapped: bool) {
  fmtPrintBinarySide(p, chain.atoms[0], chain.ops[0], false)
  if (!wrapped) {
    chain.ends = append(chain.ends, len(p.out))
  }
  let i = 1
  while (i < len(chain.atoms)) {
    fmtRaw(p, " ")
    fmtRaw(p, opSymbol(chain.ops[i - 1]))
    if (wrapped) {
      fmtGap(p, getNode(p.tree, chain.atoms[i]).span.start, false)
    } else {
      fmtRaw(p, " ")
    }
    fmtPrintBinarySide(p, chain.atoms[i], chain.ops[i - 1], true)
    if (!wrapped) {
      chain.ends = append(chain.ends, len(p.out))
    }
    i = i + 1
  }
}

// Everything `fmtTryChainNestedWrap` (and the two helpers below it) needs
// from `fmtPrintBinaryChain`'s already-computed state, bundled to stay under
// E0202's 5-parameter limit. `flat` is the unwrapped render that just failed
// the width check -- kept because `chain.ends` indexes into it -- and
// `srcPos`/`outLine` are the values to put back if the nested-wrap render is
// rejected (#4367).
class ChainWrap {
  flat: string,
  tail: int,
  effectiveCol: int,
  srcPos: int,
  outLine: int,
}

// How many columns of `flat` follow offset `at` on the same output line: up
// to the next '\n', or to the end of `flat` plus the caller's own `tail`
// when no newline follows. This is exactly the `p.nextListTail` hint a
// bracketed comma list inside the atom ending at `at` needs (#4367) -- the
// existing hint carries only the fixed text a caller knows will follow a
// list's closing bracket, and a list nested inside a binary chain could
// never see the rest of its own chain, which is how a call whose arguments
// fit by one column left `0) {` stranded on a line of its own.
fn fmtChainSuffixWidth(flat: string, at: int, tail: int): int {
  let i = at
  while (i < len(flat)) {
    if (flat[i] == '\n') {
      return i - at
    }
    i = i + 1
  }
  return len(flat) - at + tail
}

// Whether every line of a candidate multi-line render fits the §1 budget:
// the first line starts at `w.effectiveCol`, every later line carries its own
// indent inside `text`, and only the last line pays `w.tail`.
fn fmtChainNestedFits(text: string, w: ChainWrap): bool {
  let start = 0
  let col = w.effectiveCol
  let i = 0
  while (i < len(text)) {
    if (text[i] == '\n') {
      if (col + i - start > fmtMaxWidth) {
        return false
      }
      start = i + 1
      col = 0
    }
    i = i + 1
  }
  return col + len(text) - start + w.tail <= fmtMaxWidth
}

// The chain rendered with its operators inline -- no operator torn off its
// right operand -- handing each atom the true width of everything that
// follows it on the line, so a bracketed comma list nested in an atom makes
// its own §5 wrap decision against the whole line rather than against a bare
// `)` (#4367).
fn fmtPrintChainTailed(p: Printer, chain: BinaryChain, w: ChainWrap) {
  p.nextListTail = fmtChainSuffixWidth(w.flat, chain.ends[0], w.tail)
  fmtPrintBinarySide(p, chain.atoms[0], chain.ops[0], false)
  let i = 1
  while (i < len(chain.atoms)) {
    fmtRaw(p, " ")
    fmtRaw(p, opSymbol(chain.ops[i - 1]))
    fmtRaw(p, " ")
    p.nextListTail = fmtChainSuffixWidth(w.flat, chain.ends[i], w.tail)
    fmtPrintBinarySide(p, chain.atoms[i], chain.ops[i - 1], true)
    i = i + 1
  }
  p.nextListTail = 0
}

// Tries the nested-comma-list break and emits it if exactly one list broke
// and every line fits,
// returning whether it did (#4367). Rejecting puts `p.srcPos` and
// `p.outLine` back, exactly as the flat trial above does, so the operator
// wrap that follows re-descends into the same atoms from the same watermark
// (#2901). A render with no newline in it is the flat form the caller
// already rejected on width and is never accepted here.
fn fmtTryChainNestedWrap(p: Printer, chain: BinaryChain, w: ChainWrap): bool {
  let colBefore = p.col
  let bolBefore = p.bol
  let savedOut = p.out
  p.out = []byte(0)
  p.bol = false
  p.col = w.effectiveCol
  let savedFlatOnly = p.chainFlatOnly
  let savedBreaks = p.chainListBreaks
  p.chainFlatOnly = true
  p.chainListBreaks = 0
  fmtPrintChainTailed(p, chain, w)
  let breaks = p.chainListBreaks
  p.chainFlatOnly = savedFlatOnly
  p.chainListBreaks = savedBreaks
  let text = string(p.out)
  p.out = savedOut
  p.col = colBefore
  p.bol = bolBefore
  if (breaks == 1 && fmtHasNl(text) && fmtChainNestedFits(text, w)) {
    fmtRaw(p, text)
    return true
  }
  p.srcPos = w.srcPos
  p.outLine = w.outLine
  return false
}

// A chain operand that reads as a FRAGMENT when the operator wrap leaves it
// alone on a continuation line: a bare name, or a bare number/rune/bool/nil.
// `isLeafTag` (ast.bit) minus the two STRING literal tags, deliberately: a
// `+` chain of string pieces is a sequence of content, and each piece reads
// on a line of its own exactly the way a `&&` chain's clauses do. Formatting
// the tree with strings counted as fragments explodes a small call's
// argument list in the middle of three such chains (measured on #4367:
// _tests_/bit/parsergate.bit's `let src = "fn main() {\n  let x = " +
// repeatStr("(", nearN) + ...`, _tests_/bit/stressparallel.bit,
// compiler/lspsymbols.bit) -- strictly worse than one piece per line.
fn fmtChainAtomIsFragment(t: Tag): bool {
  return t == Tag.Ident ||
    t == Tag.IntLit ||
    t == Tag.FloatLit ||
    t == Tag.RuneLit ||
    t == Tag.BoolLit ||
    t == Tag.NilLit
}

// Whether the operator wrap would STRAND a bare operand, which is the one
// case where an inner bracketed-comma-list break is preferred to it (#4367).
// Two conditions, both necessary:
//
//   - Not a chain of boolean connectives. Every `&&`/`||` operand is a
//     complete clause that reads on a line of its own, the trailing-
//     connective spelling is what this corpus hand-wraps, and §10 settled it
//     in #2889. `ops[0]` decides for the whole chain: `fmtChainFlattens` only
//     links operators of ONE precedence tier, and `&&` (3) and `||` (2) are
//     tiers of their own.
//   - Some operand after the first is a FRAGMENT
//     (`fmtChainAtomIsFragment`). The operator wrap puts each operand after
//     the first on a continuation line of its own, and a line reading `0) {`
//     looks like the expression ended on the line before. An operand that is
//     a call, or any other bracketed construct, stands as its own line
//     perfectly well, so a chain made only of those keeps the operator wrap
//     -- shorter, and what this corpus already reads as correct.
fn fmtChainPrefersInnerBreak(p: Printer, chain: BinaryChain): bool {
  if (fmtIsBoolConn(chain.ops[0])) {
    return false
  }
  let i = 1
  while (i < len(chain.atoms)) {
    if (fmtChainAtomIsFragment(getNode(p.tree, chain.atoms[i]).tag)) {
      return true
    }
    i = i + 1
  }
  return false
}

// Width-aware print for a `Binary` node (#2889): flattens its chain and
// joins it on one line if that fits under fmtMaxWidth and holds no comment;
// else (#4367) breaks inside the innermost bracketed comma list nested in it
// when that brings every line under budget; else, last resort, one operand
// per line at one deeper indent.
fn fmtPrintBinaryChain(p: Printer, idx: int) {
  let tail = p.nextListTail
  p.nextListTail = 0
  let chain = fmtCollectBinaryChain(p, idx)
  // #4367: an enclosing chain's nested-comma-list trial is asking whether a
  // BRACKETED break alone brings every line under budget; a chain inside it
  // answering with an operator break of its own would answer a different
  // question. Render flat and let that trial's width check decide.
  if (p.chainFlatOnly) {
    fmtPrintChain(p, chain, false)
    return
  }
  let lastEnd = getNode(p.tree, chain.atoms[len(chain.atoms) - 1]).span.end
  if (!fmtHasCommentBefore(p, lastEnd)) {
    let colBefore = p.col
    let bolBefore = p.bol
    // See fmtPrintFlatList's srcPosBefore comment: the trial below advances
    // p.srcPos for real via fmtPrintChain/fmtPrintNode, correctly on the fits
    // path but stale on the fallthrough path, which re-renders the same
    // chain for real (#2901).
    let srcPosBefore = p.srcPos
    // See fmtPrintFlatList's identical comment: a trial starting at bol must
    // not bake its own lazy indent into `text`, and the fits check must use
    // the column the indent write will actually land at, not the pre-indent
    // p.col fmtNewline left behind. The same baseline applies whenever this
    // chain is rendering as the sole item of an ancestor single-item list
    // (`p.speculativeFlat`, #2894): that ancestor accepts the result flat
    // regardless of overflow, so `colBefore`'s real, inherited value answers
    // a question nobody is asking -- wrapping here only manufactures the
    // newline that forces the ancestor (and everything enclosing it) to
    // explode instead of staying flat as it otherwise always would.
    let effectiveCol = colBefore
    if (bolBefore || p.speculativeFlat) {
      effectiveCol = p.indent * fmtIndentWidth
    }
    let savedOut = p.out
    p.out = []byte(0)
    p.bol = false
    fmtPrintChain(p, chain, false)
    let text = string(p.out)
    p.out = savedOut
    p.col = colBefore
    p.bol = bolBefore
    if (!fmtHasNl(text) && effectiveCol + len(text) + tail <= fmtMaxWidth) {
      fmtRaw(p, text)
      return
    }
    p.srcPos = srcPosBefore
    let w = ChainWrap{
      flat: text, tail: tail, effectiveCol: effectiveCol,
      srcPos: srcPosBefore, outLine: p.outLine,
    }
    if (fmtChainPrefersInnerBreak(p, chain) && fmtTryChainNestedWrap(p, chain, w)) {
      return
    }
  }
  p.indent = p.indent + 1
  fmtPrintChain(p, chain, true)
  p.indent = p.indent - 1
}

// The extra trailing width a condition's own close paren(s) add before the
// `) {` tail hint reaches the `Binary` chain that will actually render it
// (`#2898`): `if`/`while` thread `p.nextListTail` only when `k[0]` is
// literally a `Binary` node, but `!(a && b || c)` puts a `Unary` on top, with
// the chain one (or more) levels down as its operand. Source parens are not
// AST nodes (only the token stream has them), so `Unary` is the only
// wrapper that can sit between a condition and its chain here. Returns -1
// when `idx` does not ultimately bottom out at a `Binary` node (the existing
// `) {` hint does not apply), else the number of extra columns the wrap
// paren(s) add. A chain of `!` prefixes (`!!(a && b)`) still adds exactly
// ONE pair of wrap parens no matter how deep the chain is: fmtDispatchExpr's
// own `Unary` printer only wraps when its IMMEDIATE child is `Binary` (or
// `CatchDefault`/`CatchBind`/`ArrowFn`), so every non-innermost `!` in the
// chain sees a `Unary` child and adds no parens of its own -- only the
// innermost `Unary`-directly-over-`Binary` transition ever fires it.
fn fmtCondBinaryExtra(p: Printer, idx: int): int {
  let cur = idx
  let extra = 0
  while (getNode(p.tree, cur).tag == Tag.Unary) {
    cur = kidsOf(p.tree, cur)[0]
    extra = 1
  }
  if (getNode(p.tree, cur).tag == Tag.Binary) {
    return extra
  }
  return -1
}
