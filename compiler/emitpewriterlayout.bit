fn peWriteDataOffsets(order: []PeSectionKind, byKind: []PeSection, sectionFileOff: []int): int {
  let cursor = sizeofPeFileHeader() + len(order) * sizeofPeSectionHeader()
  let ci = 0
  while (ci < len(order)) {
    let kidx = peKindIndex(order[ci])
    if (order[ci] != PeSectionKind.Bss) {
      let alignment = byKind[kidx].alignment
      if (alignment == 0) {
        alignment = 1
      }
      cursor = alignForward(cursor, alignment)
      sectionFileOff[kidx] = cursor
      cursor = cursor + peSectionBytes(byKind[kidx])
    }
    ci = ci + 1
  }
  return cursor
}

fn peWriteRelocOffsets(
  order: []PeSectionKind,
  relocCount: []int,
  relocFileOff: []int,
  cursor: int,
): int {
  let ci = 0
  while (ci < len(order)) {
    let kidx = peKindIndex(order[ci])
    if (relocCount[kidx] > 0) {
      relocFileOff[kidx] = cursor
      cursor = cursor + pePhysicalRelocCount(relocCount[kidx]) * sizeofPeReloc()
    }
    ci = ci + 1
  }
  return cursor
}

fn peWriteStringSize(strtab: ByteBuf) {
  let strtabLen = len(strtab.bytes)
  let pi = 0
  while (pi < 4) {
    strtab.bytes[pi] = u8((strtabLen >> (pi * 8)) & 255)
    pi = pi + 1
  }
}

fn peWriteSectionData(
  out: ByteBuf,
  order: []PeSectionKind,
  byKind: []PeSection,
  sectionFileOff: []int,
) {
  let ci = 0
  while (ci < len(order)) {
    if (order[ci] != PeSectionKind.Bss) {
      let kidx = peKindIndex(order[ci])
      assert(len(out.bytes) <= sectionFileOff[kidx])
      appendZeros(out, sectionFileOff[kidx] - len(out.bytes))
      appendBytes(out, byKind[kidx].data)
    }
    ci = ci + 1
  }
}

