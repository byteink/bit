// Parser: JSX elements and fragments (SPEC §12.12, epic #3942 step one,
// #3943). Parsing ONLY — these nodes are produced and nothing downstream
// consumes them yet: no typing, no desugaring, no formatting.
//
// THE DISAMBIGUATION RULE, which is the whole of #3943. `<` opens JSX only at
// EXPRESSION START (`parsePrimary`, parserexpr.bit) and only when the very
// next token is an identifier or `>`. Everywhere else `<` stays what it was:
//
//   `a < b`          — parseBinary already has `a`, so this `<` is read as an
//                      infix operator and never reaches parsePrimary.
//   `map<string,i64>`— a TYPE, parsed by parsertype.bit.
//   `f<T>(x)`        — the turbofish postfix, parsePostfix.
//
// so none of them can reach `atJsxStart`. Bit needs no `.tsx` dialect for
// this: TypeScript's ambiguity was `<T>expr`, its cast syntax, and Bit spells
// a type assertion `x.(T)` instead (SPEC §14.4). One token of lookahead is
// then enough — the same test Babel applies.
//
// `<-` is a single token (Kind.ArrowLeft, lexer.bit), so a channel receive at
// expression start cannot reach the lookahead at all, and the `>`-splitting
// rule of SPEC §6 is untouched: a generic call inside a JSX child runs through
// `expectGenericClose` exactly as it does anywhere else.

// A closing tag naming a different element than its opener. In the parser's
// own band (20-22 taken by E0021/E0022); 23 was unused.
const ecJsxTagMismatch = 23

// A `{` claimed by `jsxAtAttr` (attribute position) not followed by `...`.
// Named so this reads as "not a spread" rather than cascading into the
// generic "expected '>', found '{'" the caller would otherwise report once
// the brace silently ended the attribute list (#5172).
const ecJsxMalformedSpread = 24

// Is the cursor on a `<` that opens JSX? The caller must already be at
// expression start — this function answers the second half of the rule only.
// A reserved word can open a tag exactly as an identifier can (`<for>`,
// `<class>`; #5155, SPEC §12.12's `jsx_name`): `<` cannot start any OTHER
// Bit expression, so there is no second meaning for a keyword here to steal.
fn atJsxStart(p: Parser): bool {
  if (peekKind(p) != Kind.Lt) {
    return false
  }
  let next = peekKindAt(p, 1)
  return next == Kind.Ident || next == Kind.Gt || isReservedKeyword(next)
}

// Is the cursor on a token `jsx_name` (SPEC §12.12) can start with — an
// ordinary identifier or ANY reserved word. JSXIdentifier permits both,
// unlike a Bit identifier; keeping this widening behind `jsxAtName` and its
// two callers (`parseJsxName`, `jsxAtAttr`) is what keeps it inside the JSX
// name position — `let class = 1` never reaches this function (#4412 is the
// precedent for a predicate widened for one consumer reaching another).
fn jsxAtName(p: Parser): bool {
  let k = peekKind(p)
  return k == Kind.Ident || isReservedKeyword(k)
}

// `jsx_name = ( IDENT | keyword ) { "-" ( IDENT | keyword ) }
//             [ ":" ( IDENT | keyword ) { "-" ( IDENT | keyword ) } ] .`
// One identifier-or-keyword token, extended by every immediately adjacent
// `-name` run with NO whitespace on either side of the hyphen (`data-id`,
// `aria-label`), then by AT MOST ONE `:name` run — JSXNamespacedName
// (#5170, `<svg:circle>`, `xlink:href`) — glued the same way. The merged
// leaf's span covers the whole run, so `jsxNameText`'s plain source slice
// already reads "data-id" or "xlink:href" — nothing downstream needs to
// know the name crossed token boundaries; a lowercase tag's quoted name
// (`jsxQuoteWord`, desugarjsx.bit) and an attribute's name both reuse that
// text unchanged, so a namespaced name needs no desugaring work of its own.
// The colon extension is NOT repeated (`jsx_name` allows exactly one), so
// `xlink:href:x` merges only "xlink:href" and leaves the second `:` for
// `jsxAtAttr`/`expect(Gt)` to reject on its own terms — one namespace, not a
// chain. A hyphen or colon with whitespace around it (`data - id`, `xlink :
// href`) does not merge, so `a - b` and a ternary/case `:` outside a tag stay
// what they were; the caller only reaches this function already inside a
// JSX name position (#4412's precedent: a predicate widened for one
// consumer must not reach another).
fn parseJsxName(p: Parser): int {
  if (!jsxAtName(p)) {
    parseFail(p, "a JSX name")
    return 0
  }
  let start = peekTok(p).start
  let end = peekTok(p).end
  advance(p)
  end = jsxConsumeHyphenRun(p, end)
  if (jsxAtNameColon(p, end)) {
    advance(p) // ':'
    end = peekTok(p).end
    advance(p) // the local-name token after it
    end = jsxConsumeHyphenRun(p, end)
  }
  return addLeaf(p.tree, Tag.Ident, Span{ file: p.file, start: start, end: end })
}

// Consumes every immediately adjacent `-name` run glued to `end0`, returning
// the new end. Shared by `parseJsxName`'s own name and its optional
// namespaced local part, both of which allow the same hyphen extension.
fn jsxConsumeHyphenRun(p: Parser, end0: int): int {
  let end = end0
  while (jsxAtNameHyphen(p, end)) {
    advance(p) // '-'
    end = peekTok(p).end
    advance(p) // the name token after it
  }
  return end
}

// Is the cursor on a `-name` continuation glued to the token that just ended
// at `prevEnd`, with the following name token itself glued to the hyphen —
// no whitespace anywhere in the run?
fn jsxAtNameHyphen(p: Parser, prevEnd: int): bool {
  if (peekKind(p) != Kind.Minus || peekTok(p).start != prevEnd) {
    return false
  }
  let hyphenEnd = peekTok(p).end
  let nextTok = p.toks[p.pos + 1]
  if (nextTok.start != hyphenEnd) {
    return false
  }
  return nextTok.kind == Kind.Ident || isReservedKeyword(nextTok.kind)
}

// Is the cursor on a `:name` continuation glued to the token that just ended
// at `prevEnd`, with the following name token itself glued to the colon — no
// whitespace anywhere in the run? Mirrors `jsxAtNameHyphen` exactly but for
// JSXNamespacedName's separator (#5170, SPEC §12.12).
fn jsxAtNameColon(p: Parser, prevEnd: int): bool {
  if (peekKind(p) != Kind.Colon || peekTok(p).start != prevEnd) {
    return false
  }
  let colonEnd = peekTok(p).end
  let nextTok = p.toks[p.pos + 1]
  if (nextTok.start != colonEnd) {
    return false
  }
  return nextTok.kind == Kind.Ident || isReservedKeyword(nextTok.kind)
}

// `jsx_tag_name = jsx_name { "." jsx_name } .` — JSXMemberExpression (#5171,
// SPEC §12.12): `<Foo.Bar />` reached through a module path. ONLY the
// element name position chains on `.`; `parseJsxAttr` calls `parseJsxName`
// directly and never this wrapper, since JSX's own grammar has no
// member-expression attribute name (a namespaced name is as far as an
// attribute goes, #5170). Each `.name` becomes an ordinary `Tag.Member`
// `[recv, name]` node — the exact shape `parsePostfix`'s own `.name` builds
// (parserexpr.bit) — reused UNCHANGED as a component tag's callee by
// `rewriteJsxUpperElem` (desugarjsx.bit): `<Foo.Bar />` needs no new
// desugaring of its own, only `jsxIsLowerTag`'s case check needed to stop
// reading a dotted name's first byte (a dotted tag is never an HTML element;
// see that function).
fn parseJsxTagName(p: Parser): int {
  let recv = parseJsxName(p)
  if (recv == 0) {
    return 0
  }
  while (jsxAtNameDot(p, getNode(p.tree, recv).span.end)) {
    advance(p) // '.'
    let name = parseJsxName(p)
    recv = mkSpanNode(
      p, Tag.Member, 0, [recv, name],
      getNode(p.tree, recv).span.start, getNode(p.tree, name).span.end,
    )
  }
  return recv
}

// Is the cursor on a `.name` continuation glued to the token that just ended
// at `prevEnd`, with the following name token itself glued to the dot — no
// whitespace anywhere in the run? Mirrors `jsxAtNameHyphen`/`jsxAtNameColon`.
// A dot with nothing glued after it (`<Foo. />`) does not merge, so the
// stray `.` is left for the attribute list/`expect(Gt)` to reject on its own
// terms exactly as an unmerged trailing hyphen or colon already is.
fn jsxAtNameDot(p: Parser, prevEnd: int): bool {
  if (peekKind(p) != Kind.Dot || peekTok(p).start != prevEnd) {
    return false
  }
  let dotEnd = peekTok(p).end
  let nextTok = p.toks[p.pos + 1]
  if (nextTok.start != dotEnd) {
    return false
  }
  return nextTok.kind == Kind.Ident || isReservedKeyword(nextTok.kind)
}

// `jsx_elem | jsx_fragment`, cursor on the `<`.
fn parseJsx(p: Parser): int {
  let open = peekTok(p)
  advance(p)
  if (peekKind(p) == Kind.Gt) {
    return parseJsxFragment(p, open)
  }
  return parseJsxElement(p, open)
}

// `"<>" { jsx_child } "</>"` — `[jsx_children]`. Both `<>` and `</>` are two
// and three ordinary tokens; the lexer has no JSX mode and needs none.
fn parseJsxFragment(p: Parser, open: Token): int {
  advance(p) // '>'
  let kids = parseJsxChildren(p)
  let endTok = peekTok(p)
  if (peekKind(p) == Kind.Lt && peekKindAt(p, 1) == Kind.Slash) {
    advance(p)
    advance(p)
    endTok = peekTok(p)
    expect(p, Kind.Gt)
  } else {
    parseFail(p, "'</>' closing the fragment")
  }
  return mkSpanNode(p, Tag.JsxFrag, 0, [kids], open.start, endTok.end)
}

// `"<" jsx_tag_name { jsx_attr } ( "/>" | ">" { jsx_child } "</" jsx_tag_name
// ">" )` — `[name, jsx_attrs, jsx_children]`. A self-closing element has no
// children kid at all (`none`), which is what distinguishes it from
// `<div></div>`.
fn parseJsxElement(p: Parser, open: Token): int {
  let name = parseJsxTagName(p)
  let attrs = parseJsxAttrs(p)
  if (peekKind(p) == Kind.Slash && peekKindAt(p, 1) == Kind.Gt) {
    advance(p)
    let selfEnd = peekTok(p)
    advance(p)
    return mkSpanNode(p, Tag.JsxElem, 0, [name, attrs, 0], open.start, selfEnd.end)
  }
  expect(p, Kind.Gt)
  let kids = parseJsxChildren(p)
  let endTok = expectJsxClose(p, name)
  return mkSpanNode(p, Tag.JsxElem, 0, [name, attrs, kids], open.start, endTok.end)
}

// `</name>` for an element opened as `<name>`, returning the token the element
// ends on. A MISMATCH is E0023 naming both tags and pointing at the closer;
// the closer is still consumed so the enclosing tree stays in step, but no tag
// is invented and no child is re-parented — an unbalanced tree rendered
// silently is worse than a refusal (#3943).
fn expectJsxClose(p: Parser, openName: int): Token {
  let here = peekTok(p)
  if (peekKind(p) != Kind.Lt || peekKindAt(p, 1) != Kind.Slash) {
    parseFail(p, "a closing tag")
    return here
  }
  advance(p) // '<'
  advance(p) // '/'
  let closeName = parseJsxTagName(p)
  jsxCheckTags(p, openName, closeName)
  let gt = peekTok(p)
  expect(p, Kind.Gt)
  return gt
}

// The source text a name leaf covers. A poisoned name (index 0) has no text.
fn jsxNameText(p: Parser, node: int): string {
  let s = getNode(p.tree, node).span
  return p.src[s.start:s.end]
}

// E0023. Silent when either name was already poisoned by `expectIdent`, which
// has reported its own E0021 at that span — one mistake, one diagnostic.
fn jsxCheckTags(p: Parser, openName: int, closeName: int) {
  if (openName == 0 || closeName == 0) {
    return
  }
  let o = jsxNameText(p, openName)
  let c = jsxNameText(p, closeName)
  if (o == c) {
    return
  }
  report(
    p.diags, ecJsxTagMismatch, getNode(p.tree, closeName).span,
    "closing tag '</${c}>' does not match opening tag '<${o}>'",
    "close this element with '</${o}>'",
  )
}

// The attribute list, closed by `>` or `/>`. Terminating: `parseJsxAttr` and
// `parseJsxSpreadAttr` each consume at least the token `jsxAtAttr` saw, so
// every turn advances.
fn parseJsxAttrs(p: Parser): int {
  let items = []int(0)
  while (jsxAtAttr(p)) {
    if (peekKind(p) == Kind.LBrace) {
      items = append(items, parseJsxSpreadAttr(p))
    } else {
      items = append(items, parseJsxAttr(p))
    }
  }
  return mkNode(p, Tag.JsxAttrs, 0, items)
}

// An attribute list may wrap across lines, and the lexer's §7 semicolon
// insertion fires after the tag name and after every attribute value, so the
// synthesized `;` is skipped here rather than being read as the list's end.
//
// A `{` is claimed here too (#5172): a spread attribute (`{...props}`) is the
// ONLY thing a bare `{` can mean in attribute position (an attribute's own
// `{expr}` value always follows `name=`, `parseJsxAttr` below), so `jsxAtAttr`
// must claim the brace itself rather than leaving it for `parseJsxChildren`
// to reinterpret as the start of a child — the bug this ticket fixes.
fn jsxAtAttr(p: Parser): bool {
  skipSemis(p)
  return jsxAtName(p) || peekKind(p) == Kind.LBrace
}

// `"{" "..." expression "}"` — JSXSpreadAttribute (SPEC §12.12). Reuses the
// same `...expr` shape a call argument spread takes (parser.bit's
// `parseArgItem`/`Tag.ArgSpread`) rather than inventing a second one; only the
// wrapping `Tag.JsxSpreadAttr` is new, so `parseJsxAttrs`' item list can tell
// a spread from a named attribute without inspecting its arity.
//
// A `{` not followed by `...` is reported HERE, by name (E0024), instead of
// being left to `expect(p, Kind.RBrace)` below, which would blame whatever
// token follows rather than the missing `...` that is the actual mistake.
fn parseJsxSpreadAttr(p: Parser): int {
  let open = peekTok(p)
  advance(p) // '{'
  if (!acceptTok(p, Kind.Ellipsis)) {
    let bad = peekTok(p)
    report(
      p.diags, ecJsxMalformedSpread, Span{ file: p.file, start: bad.start, end: bad.end },
      "expected '...' to start a spread attribute, found " + describeFound(p, bad),
      "write '{...expr}' for a spread or 'name={expr}' for a named attribute",
    )
  }
  let e = parseExpr(p)
  let closeTok = peekTok(p)
  expect(p, Kind.RBrace)
  return mkSpanNode(p, Tag.JsxSpreadAttr, 0, [e], open.start, closeTok.end)
}

// `jsx_name [ "=" ( STRING_LIT | "{" expression "}" ) ]` — `[name, value]`. A
// bare attribute has no value kid; SPEC §12.12 gives it the value `true`,
// which is the desugaring's job (#3942), not the parser's.
fn parseJsxAttr(p: Parser): int {
  let name = parseJsxName(p)
  if (!acceptTok(p, Kind.Eq)) {
    return mkNode(p, Tag.JsxAttr, 0, [name, 0])
  }
  if (peekKind(p) == Kind.LBrace) {
    return mkNode(p, Tag.JsxAttr, 0, [name, parseJsxBraced(p)])
  }
  if (peekKind(p) == Kind.StringLit) {
    return mkNode(p, Tag.JsxAttr, 0, [name, leaf(p, Tag.StringLit)])
  }
  parseFail(p, "a string or '{'")
  return mkNode(p, Tag.JsxAttr, 0, [name, 0])
}

// `{ expression }` — an ATTRIBUTE value. The braces bound the node and are
// not kids, so the span is explicit. JSXAttributeValue's own `{
// AssignmentExpression }` requires a real expression (unlike a child's, see
// `parseJsxChildBraced` below), so `attr={}` still fails to parse — the
// widening this ticket adds stays confined to the JSX CHILD position
// (#4412's precedent: a predicate widened for one consumer must not reach
// another).
fn parseJsxBraced(p: Parser): int {
  return parseJsxBracedExpr(p, false)
}

// `{ [ expression ] }` — a JSX CHILD's own expression container (SPEC
// §12.12, #5173). Unlike an attribute value's `{expr}` above, JSXChildExpression's
// Expression is OPTIONAL: `{}` and the `{/* comment */}` idiom both leave
// nothing between the braces once the lexer's own comment skipping runs
// (comments are never tokens `parseExpr` sees). This still returns a real
// `Tag.JsxExpr` node (kid `none`, the same poison shape a malformed one
// already has) rather than dropping the brace pair outright: `bit fmt`
// round-trips a `jsx_children` node's own kid list (`fmtjsx.bit`), so
// returning 0 here — this file's first attempt — silently deleted the
// `{}`/`{/* ... */}` the author wrote and relocated its comment onto the
// NEXT node instead of losing it, which is worse than keeping the slot.
// `jsxChildValue`/`jsxChildValues` (desugarjsx.bit) filter the empty kid out
// before it ever reaches `elem`/`attr`/a component call — SPEC §12.12's "not
// a child at all" is a DESUGARING fact, not a parse-tree one.
fn parseJsxChildBraced(p: Parser): int {
  return parseJsxBracedExpr(p, true)
}

// Shared by both braced forms above; only the child form may be empty.
fn parseJsxBracedExpr(p: Parser, allowEmpty: bool): int {
  let open = peekTok(p)
  advance(p)
  skipSemis(p)
  if (allowEmpty && peekKind(p) == Kind.RBrace) {
    let closeTok = peekTok(p)
    advance(p)
    return mkSpanNode(p, Tag.JsxExpr, 0, [0], open.start, closeTok.end)
  }
  let e = parseExpr(p)
  skipSemis(p)
  let closeTok = peekTok(p)
  expect(p, Kind.RBrace)
  return mkSpanNode(p, Tag.JsxExpr, 0, [e], open.start, closeTok.end)
}

// `jsxGapText(p)`, unless the turn that just ended was a text run: see
// `parseJsxChildren`'s `afterText` for why a text-adjacent gap is always 0.
fn jsxMaybeGap(p: Parser, afterText: bool): int {
  if (afterText) {
    return 0
  }
  return jsxGapText(p)
}

// `{ jsx_child }` up to the closing tag (or EOF, which the caller reports).
// Terminating: every branch strictly advances the SOURCE byte position —
// `parseJsxText` by at least one byte (`jsxRawTextEnd`), `parseJsx` its `<`,
// `parseJsxBraced` its `{` — so the loop is bounded by the file length.
fn parseJsxChildren(p: Parser): int {
  let items = []int(0)
  let done = false
  // Did the PREVIOUS turn take the text branch? `jsxGapText`'s own guard
  // (below) reads `p.toks[p.pos - 1]` to ask "did the last child end on a
  // real `>`/`}`", but `parseJsxText`'s resync (`jsxResync`) leaves that
  // slot holding whatever token preceded the text run — the OPENING tag's
  // `>` — because text is no longer read a token at a time. Left unguarded,
  // that stale `Gt` would make `jsxGapText` re-trim the SAME byte range
  // `parseJsxText` just emitted, right after it, as a duplicate. A text run
  // already covers its own trailing whitespace (`jsxTrimText`), so the gap
  // for the turn right after one is always exactly 0 — this flag says so
  // without asking the token that can no longer answer.
  let afterText = false
  while (!done) {
    // Each turn produces at most a separator and one child, appended here
    // rather than in the branches: `append` on a slice PARAMETER aliases the
    // caller's array (E0214), so the accumulator never leaves this function.
    let gap = 0
    let child = 0
    if (peekKind(p) == Kind.Eof) {
      done = true
    } else if (peekKind(p) == Kind.Lt && peekKindAt(p, 1) == Kind.Slash) {
      gap = jsxMaybeGap(p, afterText)
      done = true
    } else if (atJsxStart(p)) {
      gap = jsxMaybeGap(p, afterText)
      child = parseJsx(p)
      afterText = false
    } else if (peekKind(p) == Kind.LBrace) {
      gap = jsxMaybeGap(p, afterText)
      child = parseJsxChildBraced(p)
      afterText = false
    } else {
      child = parseJsxText(p)
      afterText = true
    }
    if (gap != 0) {
      items = append(items, gap)
    }
    if (child != 0) {
      items = append(items, child)
    }
  }
  return mkNode(p, Tag.JsxChildren, 0, items)
}

// The whitespace GAP between the element or `{...}` child that just ended and
// the delimiter that starts the next one. A run of text covers its own leading
// whitespace (`parseJsxText` reads from the previous token's end), but two
// adjacent delimiters have no token between them at all, so without this
// `<a/> <b/>` would silently lose the space the author typed between two
// inline elements. Judged by the same §12.12 rule, so children written on
// their own lines still contribute nothing.
//
// Guarded on the previous token being the `>` or `}` that ENDED a child: after
// a text run the same byte range was already consumed and trimmed by
// `parseJsxText`, and re-reading it here would emit the separator twice.
fn jsxGapText(p: Parser): int {
  if (p.pos == 0) {
    return 0
  }
  let prev = p.toks[p.pos - 1]
  if (prev.kind != Kind.Gt && prev.kind != Kind.RBrace) {
    return 0
  }
  let (lo, hi) = jsxTrimText(p.src, prev.end, peekTok(p).start)
  if (lo >= hi) {
    return 0
  }
  return addLeaf(p.tree, Tag.JsxText, Span{ file: p.file, start: lo, end: hi })
}

// The end of a `jsx_text` run starting at `start0` (SPEC §12.12: `{ JSX_CHAR
// }`, any source byte but "<" or "{", a raw run, NOT tokenized) — found
// directly in the bytes, with no lexer involved at all. `jsx_text`'s own
// termination rule needs none: it is "the next '<' or '{' byte", full stop.
//
// Progress when `start0` itself IS a delimiter byte (`<` that failed
// `atJsxStart`, e.g. `<3` — not a tag, not `</`, so `parseJsxChildren`'s
// dispatch falls through to text): one byte is taken as literal text before
// scanning resumes, so the run is never zero-width and the caller's loop
// cannot spin. `{` cannot reach here zero-width — `parseJsxChildren` always
// routes a `{` to `parseJsxChildBraced` first.
fn jsxRawTextEnd(src: string, start0: int): int {
  let i = start0
  if (i < len(src) && (src[i] == '<' || src[i] == '{')) {
    i = i + 1
  }
  while (i < len(src) && src[i] != '<' && src[i] != '{') {
    i = i + 1
  }
  return i
}

// True for a diagnostic code only the LEXER can produce: `ecInvalidCharacter`
// (1) through `ecInvalidRune` (6), lexer.bit/lexstr.bit's whole error range.
// The parser's own diagnostics start at 22 (`ecNestingTooDeep`, parser.bit;
// `ecJsxTagMismatch` = 23, above) — `jsxResync` needs this split because only
// a LEXER diagnostic in `[discardFrom, boundary)` can be wrong about that
// range (the eager lex misreading jsx_text as ordinary tokens); a PARSER
// diagnostic there is a real finding from actual parsing (a malformed
// `{expr}`'s own error recovery can leave the cursor on a token later swept
// into a text run for a reason that has nothing to do with jsx_text) and
// must never be dropped.
fn jsxIsLexerDiagCode(code: int): bool {
  return code >= 1 && code <= 6
}

// `list` minus every stale LEXER diagnostic: `jsxIsLexerDiagCode` and a span
// starting in `[discardFrom, boundary)`. Order-preserving, since diagnostics
// render in list order.
fn jsxFilterStaleLexDiags(list: []Diagnostic, discardFrom: int, boundary: int): []Diagnostic {
  let kept = []Diagnostic(0)
  let i = 0
  while (i < len(list)) {
    let dg = list[i]
    let stale = jsxIsLexerDiagCode(dg.code) &&
      dg.span.start >= discardFrom &&
      dg.span.start < boundary
    if (!stale) {
      kept = append(kept, dg)
    }
    i = i + 1
  }
  return kept
}

// `errorCount` for a filtered diagnostic list — mirrors `truncateDiags`
// (diagnostics.bit), needed here because that one only keeps a PREFIX and
// `jsxFilterStaleLexDiags` removes from anywhere in the list.
fn jsxErrorCount(list: []Diagnostic): int {
  let n = 0
  let i = 0
  while (i < len(list)) {
    if (list[i].severity == 0) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// Discards every token the whole-file eager lex (`newParserD`) produced from
// byte `discardFrom` onward, and every STALE lexer diagnostic in
// `[discardFrom, boundary)` (`jsxFilterStaleLexDiags`), replacing the tokens
// with a fresh lex of the tail starting exactly at `boundary` (`discardFrom
// <= boundary`).
//
// Why: `p.toks` is built once, over the WHOLE file, by the ordinary lexer,
// before the parser — and therefore before it knows anything is JSX text —
// ever runs (`newParserD`, parser.bit). A byte that only means something as
// prose (an apostrophe, a stray `#`) is read by that lexer as what it would
// mean anywhere else in Bit: `'` opens a rune literal, and a rune with no
// closing `'` on the line (`badRune`, lexstr.bit) consumes to the next `'` or
// newline — which can run straight past the `<` this text run must stop at,
// corrupting every token after it, not just the bad one. `boundary` is
// always a `<`, `{`, or EOF, so it is always a clean, unambiguous restart:
// re-lexing from there needs no parser context, only where to begin.
fn jsxResync(p: Parser, discardFrom: int, boundary: int) {
  let keep = 0
  while (keep < len(p.toks) && p.toks[keep].start < discardFrom) {
    keep = keep + 1
  }
  p.diags.list = jsxFilterStaleLexDiags(p.diags.list, discardFrom, boundary)
  p.diags.errorCount = jsxErrorCount(p.diags.list)
  let lx = newLexerD(p.src, p.file, p.diags)
  lx.i = boundary
  let tail = lexDrive(lx)
  p.toks = p.toks[0:keep]
  let i = 0
  while (i < len(tail)) {
    p.toks = append(p.toks, tail[i])
    i = i + 1
  }
  p.pos = keep
}

// One run of text between two delimiters, as a `jsx_text` leaf — or 0 when the
// run is whitespace the §12.12 rule discards.
//
// The run's END is found in the SOURCE (`jsxRawTextEnd`), not in the tokens —
// see `jsxResync` for why the tokens cannot be trusted here. That keeps
// interior spacing exactly as written (tokens have no spacing between them)
// and makes the lexer's synthesized semicolons, which are zero-width,
// invisible here.
fn parseJsxText(p: Parser): int {
  let runStart = 0
  if (p.pos > 0) {
    runStart = p.toks[p.pos - 1].end
  }
  let boundary = jsxRawTextEnd(p.src, runStart)
  jsxResync(p, runStart, boundary)
  let (lo, hi) = jsxTrimText(p.src, runStart, boundary)
  if (lo >= hi) {
    return 0
  }
  return addLeaf(p.tree, Tag.JsxText, Span{ file: p.file, start: lo, end: hi })
}

// SPEC §12.12's whitespace rule over the raw run `[lo0, hi0)`: a LEADING
// whitespace run containing a line terminator is dropped, so is a TRAILING
// one, and everything between is kept byte for byte.
//
// Two consequences, which are the whole reason the rule is written down: the
// indentation between two children on their own lines is not a child at all
// (the run is whitespace and contains a newline, so both ends eat it and
// nothing is left), while `<a/> <b/>` on ONE line keeps its space, because a
// whitespace run with no line terminator is text the author typed on purpose.
fn jsxTrimText(src: string, lo0: int, hi0: int): (int, int) {
  let lo = lo0
  let hi = hi0
  let afterWs = jsxSpaceRunEnd(src, lo, hi)
  if (afterWs > lo && jsxRunHasNewline(src, lo, afterWs)) {
    lo = afterWs
  }
  let beforeWs = jsxSpaceRunStart(src, lo, hi)
  if (beforeWs < hi && jsxRunHasNewline(src, beforeWs, hi)) {
    hi = beforeWs
  }
  return lo, hi
}

// The first index in `[lo, hi)` that is not whitespace (`hi` if all of it is).
// Terminating: `i` strictly increases toward `hi`.
fn jsxSpaceRunEnd(src: string, lo: int, hi: int): int {
  let i = lo
  while (i < hi && jsxIsSpace(src[i])) {
    i = i + 1
  }
  return i
}

// The index just past the last non-whitespace byte in `[lo, hi)` (`lo` if all
// of it is whitespace). Terminating: `i` strictly decreases toward `lo`.
fn jsxSpaceRunStart(src: string, lo: int, hi: int): int {
  let i = hi
  while (i > lo && jsxIsSpace(src[i - 1])) {
    i = i - 1
  }
  return i
}

// Terminating: `i` strictly increases toward `hi`.
fn jsxRunHasNewline(src: string, lo: int, hi: int): bool {
  let i = lo
  while (i < hi) {
    if (src[i] == '\n') {
      return true
    }
    i = i + 1
  }
  return false
}

fn jsxIsSpace(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}
