// compiler/lowertrampoline.bit — split out of lowerglobal.bit (#6689: 800 of
// the 800-line ceiling). Sibling of lowerglobal.bit: same module, so this needs
// no imports and no call-site changes. Holds the two function-value trampolines
// (`lowerIfaceMethodValue`, `fnValueTrampoline`) and the helpers they share.

fn lowerIfaceMethodValue(fc: FnCtx, node: int, recvTy: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let mn = getNode(fc.c.tree, kids[1])
  let mname = fc.c.source[mn.span.start:mn.span.end]
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let sigKey = "${recvTy}.${mname}"
  let fnTy = methodSigLookup(fc.c, sigKey)
  let result = methodResultLookup(fc.c, sigKey)
  let mid = methodId(fc.lowerer, fc.c.ctx, mname, fnTy)
  let paramTypes = fc.c.ctx.types[fnTy].members
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let recvParam = builderAddParam(b, recvTy)
  let allParams = [recvTy]
  let callArgs = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    callArgs = append(callArgs, builderAddParam(b, paramTypes[i]))
    allParams = append(allParams, paramTypes[i])
    i = i + 1
  }
  // #6689: reached through `Op.CallValue`, which binds the error word of a
  // fallible function type, so the trampoline binds the vtable callee's word
  // (`ifaceErrTy`) and returns it as its own last word. The dual publish keeps
  // the slot right: the callee still writes it.
  let errRaw = ifaceErrTy(fc, fnTy)
  let retTy = result
  if (errRaw != 0) {
    retTy = unwrapFallible(fc.c, result)
  }
  let ci = mkInstr(Op.CallIface, errWordCallTy(fc, errRaw, retTy))
  ci.lhs = recvParam
  ci.ival = mid
  ci.args = callArgs
  let r = builderEmit(b, ci)
  emitTrampolineRet(fc, b, retTy, r, emitErrWord(fc, b, errRaw, r, 1))
  builderEndBlock(b)
  let tf = irFuncFromBuilder(b, "ifacemethod\$trampoline\$${fid}", allParams, result)
  tf.isFallible = errRaw != 0
  tf.inRootModule = fc.lowerer.curModule == fc.lowerer.root
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, tf)
  let mc = mkInstr(Op.MakeClosure, fnTy)
  mc.name = "ifacemethod\$trampoline\$${fid}"
  mc.lhs = recvV
  return builderEmit(fc.b, mc)
}

// Whether `name` is in a string list.
fn stringInList(xs: []string, name: string): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// The FuncId of the trampoline that wraps top-level function `funcName` as a
// first-class value, synthesizing it on first use. The trampoline takes the
// closure env (ignored) plus the target's parameters and tail-calls the target,
// so a bare function value is call-compatible with arrow closures.
fn fnValueTrampoline(fc: FnCtx, funcName: string): int {
  for (nm, existing) of fc.lowerer.fnValueTramps {
    if (nm == funcName) {
      return existing
    }
  }
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  let decl = funcDeclLookup(fc.c, funcName)
  // An imported target's params are declared in ITS tree (see declOwner).
  //
  // The SIGNATURE types, not the callee's body slot types: a variadic tail is
  // `...xs: i32`, which the callee's own frame binds as `[]i32` but which the
  // function TYPE carries as the element type with variadic-ness held as a
  // separate flag. The trampoline is declared against the type, so it takes the
  // element type here — matching the seed. The value that actually arrives is
  // the caller's slice either way (one word, identical call sites), so this is
  // the declared type only; no call site or lowering changes with it.
  let paramTypes = lowerParamTypes(declOwner(fc.c, funcName), decl)
  let result = unwrapFallible(fc.c, funcResultLookup(fc.c, funcName))
  let fnTy = funcSigLookup(fc.c, funcName)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  // Leading env param (ignored), then one block param per target parameter.
  builderAddParam(b, fnTy)
  let callArgs = []int(0)
  let allParams = [fnTy]
  let i = 0
  while (i < len(paramTypes)) {
    callArgs = append(callArgs, builderAddParam(b, paramTypes[i]))
    allParams = append(allParams, paramTypes[i])
    i = i + 1
  }
  let errRaw = emitFnValueBody(fc, b, funcName, callArgs, result)
  builderEndBlock(b)
  let tf = irFuncFromBuilder(b, "fnvalue\$trampoline\$${fid}", allParams, result)
  tf.isFallible = errRaw != 0
  tf.inRootModule = fc.lowerer.curModule == fc.lowerer.root
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, tf)
  fc.lowerer.fnValueTramps[funcName] = fid
  return fid
}

// The body of `fnValueTrampoline`: calls `funcName` with `callArgs` and returns
// its result words. Returns the target's `errWordRaw` (0 on the slot
// convention), which the trampoline's own IrFunc reads for `isFallible`.
fn emitFnValueBody(fc: FnCtx, b: IrBuilder, funcName: string, callArgs: []int, result: int): int {
  let owner = declOwner(fc.c, funcName)
  let decl = funcDeclLookup(fc.c, funcName)
  let paramTypes = lowerParamTypes(owner, decl)
  // #4405: the trampoline's OWN result keeps the one-word convention for the
  // same reason its parameters do — it is reached through `Op.CallValue`,
  // which knows only the func type — so a target that returns W words has
  // them collected and re-boxed here, adjacent to the call.
  let retWords = explodedRetWords(owner, decl, fc.lowerer, emptyTypeEnv())
  let callTy = result
  if (len(retWords) != 0) {
    callTy = retWords[0]
  }
  // #6689: the target's own error word, bound after its ok words and returned
  // as the trampoline's last word (`Op.CallValue` binds it there). A void-ok
  // target's `Op.Call` IS that word (`errWordCallTy`).
  let errRaw = errWordRaw(owner, decl, fc.lowerer)
  let call = mkInstr(Op.Call, errWordCallTy(fc, errRaw, callTy))
  // The trampoline body calls the real function, so it needs the same qualified
  // symbol a direct call would use — an imported target lives under its own
  // module's name.
  call.name = callQualified(fc.c, fc.lowerer.root, funcName)
  // #4404: the trampoline's OWN parameters keep the one-word function-type
  // convention — a function value is called through `Op.CallValue`, which knows
  // only the func type — so an exploded aggregate arrives here whole and is
  // taken apart for the direct call, exactly as any other call site does.
  call.args = explodeCallArgs(
    fc.c.ctx, b, paramTypes, callArgs,
    explodeGatesFor(owner, decl, fc.lowerer),
  )
  let callId = builderEmit(b, call)
  let nOk = 1
  if (len(retWords) != 0) {
    nOk = len(retWords)
  }
  let okWords = emitTrampolineWords(fc, b, callId, retWords)
  let errw = emitErrWord(fc, b, errRaw, callId, nOk)
  emitTrampolineRet(fc, b, result, trampolineValue(fc, b, result, callId, okWords), errw)
  return errRaw
}

// #6686: the call's ok result words when the target hands them back in
// registers (#4405), else none (the one-handle convention). The error word is
// bound separately (`emitErrWord`) and must directly follow this run
// (`callWordPlaced`).
fn emitTrampolineWords(fc: FnCtx, b: IrBuilder, call: int, retWords: []int): []int {
  if (len(retWords) == 0) {
    return []int(0)
  }
  return emitCallResultWords(fc.c.ctx, b, call, retWords)
}

// The value the trampoline returns for the call `r`: when the target handed
// its result back in W registers (#4405) `words` are its ids, re-boxed first,
// because the trampoline itself is reached through `Op.CallValue`, which knows
// only the func type and therefore only the one-word convention.
fn trampolineValue(fc: FnCtx, b: IrBuilder, result: int, r: int, words: []int): int {
  if (len(words) == 0) {
    return r
  }
  return materializeExplodedHandle(fc, b, result, words)
}

// The trampoline's `ret` of `v` (`trampolineValue`). #6689: `errw`, the target's
// error word (`emitErrWord`) or -1, is the LAST ret word, the position
// `Op.CallValue` binds it from.
fn emitTrampolineRet(fc: FnCtx, b: IrBuilder, result: int, v: int, errw: int) {
  let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
  if (result != fc.c.ctx.voidId) {
    rt.args = [v]
  }
  if (errw >= 0) {
    rt.args = append(rt.args, errw)
  }
  builderEmit(b, rt)
}
