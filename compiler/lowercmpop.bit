// compiler/lowercmpop.bit — split out of lower.bit (#5598) to bring lower.bit
// under the repo's 800-line limit (E0200). Sibling of lower.bit: same module,
// so this needs no imports and no call-site changes.
//
// The comparison-operator classification helpers: `isRelationalOp` tells a
// relational/equality operator apart from a short-circuiting `&&`/`||`;
// `strCmpOpFor`/`cmpOpFor` map an ordering or equality operator to the IR
// `Op` that implements it, over strings and over ints/floats respectively.
// `binOpFor` (lower.bit), the arithmetic counterpart to this file's
// comparison mapping, stays behind — it is cited by name from
// compiler/loweraccess.bit, and moving it would break that citation.

// Whether an operator kind is a relational/equality comparison (not a logical
// `&&`/`||`, which needs short-circuit block lowering).
fn isRelationalOp(op: int): bool {
  return op == int(Kind.EqEq) ||
    op == int(Kind.BangEq) ||
    op == int(Kind.Lt) ||
    op == int(Kind.Gt) ||
    op == int(Kind.LtEq) ||
    op == int(Kind.GtEq)
}

// The IR compare op applied to `string_cmp`'s three-way sign for an ORDERING
// operator on strings (SPEC §14.6). Signed against 0 in every case — the sign,
// not the operand type, is what is being tested. Op.BlockParam means `op` is
// not an ordering operator (`==`/`!=` take the `string_eq` path instead).
fn strCmpOpFor(op: int): Op {
  if (op == int(Kind.Lt)) {
    return Op.ICmpSlt
  }
  if (op == int(Kind.LtEq)) {
    return Op.ICmpSle
  }
  if (op == int(Kind.Gt)) {
    return Op.ICmpSgt
  }
  if (op == int(Kind.GtEq)) {
    return Op.ICmpSge
  }
  return Op.BlockParam
}

// The IR compare op for a relational operator over ints (signed/unsigned by
// `signed`) or floats. Returns Op.BlockParam as a not-yet-lowerable sentinel.
fn cmpOpFor(op: int, isFloat: bool, signed: bool): Op {
  if (op == int(Kind.EqEq)) {
    if (isFloat) {
      return Op.FCmpEq
    }
    return Op.ICmpEq
  }
  if (op == int(Kind.BangEq)) {
    if (isFloat) {
      return Op.FCmpNe
    }
    return Op.ICmpNe
  }
  if (op == int(Kind.Lt)) {
    if (isFloat) {
      return Op.FCmpLt
    }
    if (signed) {
      return Op.ICmpSlt
    }
    return Op.ICmpUlt
  }
  if (op == int(Kind.LtEq)) {
    if (isFloat) {
      return Op.FCmpLe
    }
    if (signed) {
      return Op.ICmpSle
    }
    return Op.ICmpUle
  }
  if (op == int(Kind.Gt)) {
    if (isFloat) {
      return Op.FCmpGt
    }
    if (signed) {
      return Op.ICmpSgt
    }
    return Op.ICmpUgt
  }
  if (op == int(Kind.GtEq)) {
    if (isFloat) {
      return Op.FCmpGe
    }
    if (signed) {
      return Op.ICmpSge
    }
    return Op.ICmpUge
  }
  return Op.BlockParam
}
