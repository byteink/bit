// compiler/ircheckregcall.bit — #7771's selfcheck arm: a plain call crosses a
// value only where the value is needed once the call returns; #7778's, the
// same for an allocation, a closure and a value call. A sibling of
// ircheckregalloc.bit, which sits too close to the 800-line ceiling to hold it.
//
// Every case runs the production path on hand-built IR: `buildIntervals`, then
// `withCallCfg`, then the root's interval merged over its aliases exactly as
// `allocateCoalesced` merges it, then `intervalRegMask`. Register 0 is
// caller-saved and register 1 callee-saved, so bit 0 of the mask says whether
// %0 may sit in a register the call destroys.

// bb0: %0 = 7; %1 = true; br %1, bb2, bb1
// bb1: %3 = <call>; <term>
// bb2: %5 = %0 + %0; jump bb3(%5)
// bb3(%7): ret %7
//
// bb1 is the cold `fail` block, laid out inside %0's interval [0, 5]; `call`
// is its call, or (#7778) its allocation or closure.
fn coldCallIr(ctx: TypeContext, call: IrInstr, term: IrInstr): IrFunc {
  let i64t = primType(ctx, 3)
  let k = mkInstr(Op.ConstInt, i64t)
  k.ival = 7
  let br = mkInstr(Op.Br, ctx.voidId)
  br.lhs = 1
  br.ival = 2
  br.ival2 = 1
  let add = mkInstr(Op.Add, i64t)
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 3
  jmp.args = [5]
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [7]
  return irFuncOf(
    "cold", []int(0), i64t,
    [
      IrBlock{ instsStart = 0, paramCount = 0, instsLen = 3 },
      IrBlock{ instsStart = 3, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 5, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 7, paramCount = 1, instsLen = 2 },
    ],
    [
      k, mkInstr(Op.ConstBool, i64t), br, call, term, add, jmp,
      mkInstr(Op.BlockParam, i64t), ret,
    ],
  )
}

// bb1's terminator: 0 returns nothing, 1 returns %0, 2 jumps to bb2, 3 passes
// %0 to bb3, whose param bb2 also feeds (with %5), so it is no alias of %0.
fn coldTerm(ctx: TypeContext, kind: int): IrInstr {
  if (kind <= 1) {
    let ret = mkInstr(Op.Ret, ctx.voidId)
    if (kind == 1) {
      ret.args = [0]
    }
    return ret
  }
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 2
  if (kind == 3) {
    jmp.ival = 3
    jmp.args = [0]
  }
  return jmp
}

// The mask %0 gets in `f` whose only plain call sits at `call`, with the CFG
// facts when `cfg`, on the linear test alone when not.
fn callMask(ctx: TypeContext, f: IrFunc, call: int, cfg: bool): int {
  let points = AllocPoints{
    safepoints = [call], calleeSafepoints = [call], polls = []int(0),
    clobbers = []int(0), calls = [call], pins = []AsmPin(0),
  }
  return pointsMask(ctx, f, points, cfg)
}

fn pointsMask(ctx: TypeContext, f: IrFunc, points: AllocPoints, cfg: bool): int {
  let built = buildIntervals(ctx, f)
  let p = points
  if (cfg) {
    p = withCallCfg(f, built, points)
  }
  let scan = copyIntervals(built.intervals)
  mergeAliases(scan, vregPositions(scan), built.roots)
  return intervalRegMask(scan[0], p, mkRegsCs(2, 2, 0, 0))
}

fn coldMask(kind: int, cfg: bool): int {
  let ctx = newTypeContext()
  let call = mkInstr(Op.Call, ctx.voidId)
  call.name = "g"
  return callMask(ctx, coldCallIr(ctx, call, coldTerm(ctx, kind)), 3, cfg)
}

// #7778: the cold block holds `op` at position 3, a call safepoint the backends
// list in `clobbers`, here once more for each of `extra` (the poll-cache
// prefetch sharing its position). `op`'s operand is %0.
fn coldClobberMask(op: Op, kind: int, extra: int, cfg: bool): int {
  let ctx = newTypeContext()
  let mid = mkInstr(op, ctx.voidId)
  let clobbers = [3]
  let i = 0
  while (i < extra) {
    clobbers = append(clobbers, 3)
    i = i + 1
  }
  let points = AllocPoints{
    safepoints = [3], calleeSafepoints = [3], polls = []int(0),
    clobbers = clobbers, calls = []int(0), pins = []AsmPin(0),
  }
  return pointsMask(ctx, coldCallIr(ctx, mid, coldTerm(ctx, kind)), points, cfg)
}

// bb0: %0 = 7; %1 = true; br %1, bb1(%0), bb2
// bb1(%3): %4 = call g; %5 = %3 + %3; ret %5
// bb2: ret
//
// %3 is an alias of %0 (its one predecessor passes %0), so the read after the
// call is a read of %0's register although %0 itself is read only by the br.
fn aliasCallIr(ctx: TypeContext): IrFunc {
  let i64t = primType(ctx, 3)
  let br = mkInstr(Op.Br, ctx.voidId)
  br.lhs = 1
  br.ival = 1
  br.ival2 = 2
  br.thenArgs = [0]
  let call = mkInstr(Op.Call, ctx.voidId)
  call.name = "g"
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 3
  add.rhs = 3
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [5]
  return irFuncOf(
    "alias", []int(0), i64t,
    [
      IrBlock{ instsStart = 0, paramCount = 0, instsLen = 3 },
      IrBlock{ instsStart = 3, paramCount = 1, instsLen = 4 },
      IrBlock{ instsStart = 7, paramCount = 0, instsLen = 1 },
    ],
    [
      mkInstr(Op.ConstInt, i64t), mkInstr(Op.ConstBool, i64t), br,
      mkInstr(Op.BlockParam, i64t), call, add, ret, mkInstr(Op.Ret, ctx.voidId),
    ],
  )
}

fn checkCallCrossingCfg() {
  assert(
    (coldMask(0, true) & 1) == 1,
    "#7771: a value the cold call's block never reads stays caller-saved",
  )
  assert((coldMask(0, false) & 1) == 0, "#7771: without CFG facts the linear test stands")
  assert((coldMask(1, true) & 1) == 0, "#7771: a read after the call in its own block crosses it")
  assert((coldMask(2, true) & 1) == 0, "#7771: a successor inside the interval crosses the call")
  assert((coldMask(3, true) & 1) == 0, "#7771: an edge argument after the call crosses it")
  let ctx = newTypeContext()
  let f = aliasCallIr(ctx)
  assert(buildIntervals(ctx, f).roots[3] == 0, "#7771: the alias case lost its alias")
  assert((callMask(ctx, f, 4, true) & 1) == 0, "#7771: an alias's read after the call crosses it")
  checkClobberCrossingCfg()
}

// bb0: %0 = 7; %1 = true; br %1, bb5, bb1
// bb1: %3 = gc_alloc; br %1, bb2, bb3
// bb2: jump bb4
// bb3: %6 = gc_alloc; jump bb4
// bb4: ret, or ret %0 when `reads`
// bb5: %9 = %0 + %0; ret %9
//
// #7778: a cold region of four blocks inside %0's interval: bb1's successors
// start inside it, yet only `reads` puts a read of %0 within their reach.
fn coldRegionIr(ctx: TypeContext, reads: bool): IrFunc {
  let i64t = primType(ctx, 3)
  let exit = mkInstr(Op.Ret, ctx.voidId)
  if (reads) {
    exit.args = [0]
  }
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [9]
  return irFuncOf(
    "region", []int(0), i64t,
    [
      IrBlock{ instsStart = 0, paramCount = 0, instsLen = 3 },
      IrBlock{ instsStart = 3, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 5, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 6, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 8, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 9, paramCount = 0, instsLen = 2 },
    ],
    [
      mkInstr(Op.ConstInt, i64t), mkInstr(Op.ConstBool, i64t), regionBr(ctx, 5, 1),
      mkInstr(Op.GcAlloc, ctx.voidId), regionBr(ctx, 2, 3), regionJump(ctx),
      mkInstr(Op.GcAlloc, ctx.voidId), regionJump(ctx), exit, mkInstr(Op.Add, i64t), ret,
    ],
  )
}

fn regionBr(ctx: TypeContext, then: int, other: int): IrInstr {
  let br = mkInstr(Op.Br, ctx.voidId)
  br.lhs = 1
  br.ival = then
  br.ival2 = other
  return br
}

fn regionJump(ctx: TypeContext): IrInstr {
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 4
  return jmp
}

fn regionMask(reads: bool): int {
  let ctx = newTypeContext()
  let points = AllocPoints{
    safepoints = [3, 6], calleeSafepoints = [3, 6], polls = []int(0),
    clobbers = [3, 6], calls = []int(0), pins = []AsmPin(0),
  }
  return pointsMask(ctx, coldRegionIr(ctx, reads), points, true)
}

fn checkClobberCrossingCfg() {
  assert(
    (regionMask(false) & 1) == 1,
    "#7778: a successor reaching no read of the value is not live on entry",
  )
  assert((regionMask(true) & 1) == 0, "#7778: a read the successor reaches crosses the allocation")
  assert(
    (coldClobberMask(Op.GcAlloc, 0, 0, true) & 1) == 1,
    "#7778: a value the cold allocation's block never reads stays caller-saved",
  )
  assert(
    (coldClobberMask(Op.GcAlloc, 0, 0, false) & 1) == 0,
    "#7778: without CFG facts an allocation is a linear clobber",
  )
  assert(
    (coldClobberMask(Op.GcAlloc, 1, 0, true) & 1) == 0,
    "#7778: a read after the allocation in its own block crosses it",
  )
  assert(
    (coldClobberMask(Op.GcAlloc, 2, 0, true) & 1) == 0,
    "#7778: a successor inside the interval crosses the allocation",
  )
  assert(
    (coldClobberMask(Op.MakeClosure, 0, 0, true) & 1) == 0,
    "#7778: a closure's operand is read after its allocation, so it crosses",
  )
  assert(
    (coldClobberMask(Op.GcAlloc, 0, 1, true) & 1) == 0,
    "#7778: the poll-cache prefetch at an allocation's position stays linear",
  )
}
