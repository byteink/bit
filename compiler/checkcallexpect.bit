// compiler/checkcallexpect.bit — the expected type of a generic class
// construction (#7299). Sibling of checkarrow.bit: same module, no imports.
//
// `let p: Policy<W, A> = Policy("n", (p, user) => ...)` writes no type
// arguments, and nothing in the arguments binds them: the closure's parameters
// are the thing being typed. The type the context declares then supplies them,
// as written ones would: each position that declares a target records the
// target's type arguments against the construction call
// (`Checker.callExpectArgs`), and `explicitOrExpectedArgs` (arrow seeding,
// `seedArrowExpectedGeneric` in checkgeneric.bit) and `inferInitTypeArgs`
// (classinit.bit) read them ahead of the arguments. A call that contradicts the
// declared type is then the ordinary mismatch against it.
//
// A separate pass from `seedArrowExpectedAt`, because that one visits a call
// before the node that declares its target (the arena is post-order) and the
// expectation has to exist by the time the call's own arrows are seeded.
//
// Positions: an annotated `let`, a `return` from a non-generic function, an
// argument of a non-generic free function or method, and the elements of a list
// in any of those. Every other shape records nothing, so the call is judged as
// it always was (E0068 when its arguments bind nothing).

// The name `call` constructs through a bare identifier callee that writes no
// type arguments, else "".
fn ctorCalleeName(c: Checker, call: int): string {
  if (call == 0 || getNode(c.tree, call).tag != Tag.Call) {
    return ""
  }
  let ck = kidsOf(c.tree, call)
  if (ck[1] != 0 || getNode(c.tree, ck[0]).tag != Tag.Ident) {
    return ""
  }
  return nodeText(c.tree, c.source, ck[0])
}

// The generic class template `call` constructs, when it is a call that infers
// its type arguments from `init` (`seedArrowExpectedConstruct`'s guards), else 0.
fn inferableCtorClass(c: Checker, call: int): int {
  let name = ctorCalleeName(c, call)
  if (name == "") {
    return 0
  }
  let ut = userTypeLookup(c, name)
  if (ut == 0 || isTypeParamId(c, ut) || c.ctx.types[ut].kind != TypeKind.Struct) {
    return 0
  }
  if (typeInstOfResult(c.ctx, ut) >= 0 || structTypeParamCount(c, ut) == 0) {
    return 0
  }
  if (classInitNode(c, ut) == 0) {
    return 0
  }
  return ut
}

// Whether `e` is a construction that wants an expected type, or a list whose
// first element is: the cheap syntactic guard that keeps this pass from typing
// the annotation of every `let` in the program (type-id order feeds mangling).
fn isCtorTarget(c: Checker, e: int): bool {
  if (e == 0) {
    return false
  }
  if (getNode(c.tree, e).tag == Tag.SliceLit) {
    let items = kidsOf(c.tree, e)
    return len(items) > 0 && isCtorTarget(c, argInner(c, items[0]))
  }
  return inferableCtorClass(c, e) != 0
}

// Records the type arguments of `want` against construction `e`, or against the
// constructions in list `e` when `want` is a list type.
fn expectCtorTarget(c: Checker, e: int, want: int) {
  if (want == 0 || e == 0) {
    return
  }
  if (getNode(c.tree, e).tag == Tag.SliceLit) {
    expectCtorElems(c, kidsOf(c.tree, e), want)
    return
  }
  let ut = inferableCtorClass(c, e)
  if (ut != 0 && isInstOfClass(c, want, ut)) {
    c.callExpectArgs[e] = nominalArgsOf(c, want)
  }
}

// `expectCtorTarget` for each of `items`, against list type `want`'s element.
fn expectCtorElems(c: Checker, items: []int, want: int) {
  let kind = c.ctx.types[want].kind
  if (kind != TypeKind.Slice && kind != TypeKind.Array) {
    return
  }
  let elem = c.ctx.types[want].elem
  for it of items {
    expectCtorTarget(c, argInner(c, it), elem)
  }
}

// `let p: Policy<W, A> = Policy(...)` and `let ps: []Policy<W, A> = [Policy(...)]`.
fn seedCallExpectedBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pattern, type_or_none, init_or_none]
  if (kids[1] == 0 || !isCtorTarget(c, kids[2])) {
    return
  }
  expectCtorTarget(c, kids[2], typeFromNode(c, kids[1]))
}

// A typed list `[]Policy<W, A>{ Policy(...) }` carries its own element type.
fn seedCallExpectedLit(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, body]
  let items = kidsOf(c.tree, kids[1])
  if (len(items) == 0 || !isCtorTarget(c, argInner(c, items[0]))) {
    return
  }
  let ty = typeFromNode(c, kids[0])
  if (ty != 0) {
    expectCtorElems(c, items, ty)
  }
}

// The operand of every single-value `return` in `node` that is a construction
// target, descending as `seedReturnedArrows` does (nested ArrowFn and FuncDecl
// own their returns).
fn ctorReturns(c: Checker, node: int, out: []int): []int {
  for k of kidsOf(c.tree, node) {
    if (k == 0) {
      continue
    }
    let t = getNode(c.tree, k).tag
    if (t == Tag.ArrowFn || t == Tag.FuncDecl) {
      continue
    }
    if (t != Tag.ReturnStmt) {
      out = ctorReturns(c, k, out)
      continue
    }
    let rk = kidsOf(c.tree, k)
    if (len(rk) == 1 && isCtorTarget(c, rk[0])) {
      out = append(out, rk[0])
    }
  }
  return out
}

// `fn f(): Policy<W, A> { return Policy(...) }`. A generic function records
// nothing: its result is written against parameters only an instantiation binds.
fn seedCallExpectedReturn(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, name, generics, params, result, body]
  if (kids[2] != 0 || kids[4] == 0 || kids[5] == 0) {
    return
  }
  let rets = ctorReturns(c, kids[5], []int(0))
  if (len(rets) == 0) {
    return
  }
  let ty = typeFromNode(c, kids[4])
  for r of rets {
    expectCtorTarget(c, r, ty)
  }
}

// The parameter types of the non-generic callee of `call`, or none when the
// callee is generic, a value, variadic, or unresolved. Mirrors the callee
// shapes `seedArrowExpectedCall` decides, minus the generic ones: a generic
// parameter type has no target until its own arguments bind it.
fn callParamTypes(c: Checker, call: int): []int {
  let none = []int(0)
  let callee = kidsOf(c.tree, call)[0]
  if (getNode(c.tree, callee).tag == Tag.Member) {
    return calleeMethodParamTypes(c, callee)
  }
  let name = ctorCalleeName(c, call)
  if (name == "" || shadowedByValue(c, callee, name)) {
    return none
  }
  let fr = funcRefAt(c, callee, name)
  if (fr.decl == 0) {
    return none
  }
  let plist = declParamListNode(fr.owner, fr.decl)
  if (plist < 0) {
    return none
  }
  let out = []int(0)
  for p of kidsOf(fr.owner.tree, plist) {
    out = append(out, typeFromNode(fr.owner, kidsOf(fr.owner.tree, p)[1]))
  }
  return out
}

// The parameter types of method `callee` (`recv.name`), when the method has no
// type parameters of its own; none otherwise.
fn calleeMethodParamTypes(c: Checker, callee: int): []int {
  let none = []int(0)
  let mk = kidsOf(c.tree, callee) // [receiver, method_name]
  let recvType = checkExprType(c, mk[0])
  if (recvType == 0) {
    return none
  }
  let mname = nodeText(c.tree, c.source, mk[1])
  let mrType = methodRecvType(c, recvType, mname)
  let sig = methodSigLookup(c, "${mrType}.${mname}")
  if (sig == 0 || c.ctx.types[sig].variadic) {
    return none
  }
  let fr = methodRefAt(c, mrType, mname)
  if (fr.decl != 0 && methodOwnGenericCount(fr.owner, fr.decl) != 0) {
    return none
  }
  return c.ctx.types[sig].members
}

// `register(Policy(...))`, `authz.use([Policy(...)])`: each argument against its
// declared parameter type.
fn seedCallExpectedArgs(c: Checker, node: int) {
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let wanted = false
  for a of args {
    wanted = wanted || isCtorTarget(c, argInner(c, a))
  }
  if (!wanted) {
    return
  }
  let want = callParamTypes(c, node)
  if (len(want) == 0 || arrowSeedUndecided(c, want, args)) {
    return
  }
  let i = 0
  while (i < len(want)) {
    expectCtorTarget(c, callArgNode(c, node, i), want[i])
    i = i + 1
  }
}

// Pre-pass 3b0 (checkmodule.bit): every declared target of a generic class
// construction, recorded before `seedArrowExpectedAt` seeds the call's arrows.
fn seedCallExpectedPass(c: Checker) {
  let i = 1
  while (i < len(c.tree.nodes)) {
    let tag = getNode(c.tree, i).tag
    if (tag == Tag.Binding) {
      seedCallExpectedBinding(c, i)
    } else if (tag == Tag.Call) {
      seedCallExpectedArgs(c, i)
    } else if (tag == Tag.FuncDecl) {
      seedCallExpectedReturn(c, i)
    } else if (tag == Tag.CompositeLit) {
      seedCallExpectedLit(c, i)
    }
    i = i + 1
  }
}

// Type argument `ti` of the type call `callNode` is declared to produce, 0 when
// its context declares none.
fn expectedCtorArg(c: Checker, callNode: int, ti: int): int {
  let (want, ok) = c.callExpectArgs[callNode]
  if (!ok || ti >= len(want)) {
    return 0
  }
  return want[ti]
}

// The type arguments call `callNode` is given before its arguments are read:
// the ones written on it, else the ones its context declares. Like a written
// list they outrank inference from the arguments, which is what lets
// `let p: Pair<f32, S> = Pair(1, s)` type `1` as an `f32` rather than default it
// to `i64` and then disagree with the declared type. A call that writes
// arguments records no expectation, so at most one of the two is non-empty.
fn explicitOrExpectedArgs(c: Checker, callNode: int): []int {
  let written = explicitCallTypeArgs(c, callNode)
  if (len(written) > 0) {
    return written
  }
  let (want, ok) = c.callExpectArgs[callNode]
  if (!ok) {
    return written
  }
  return want
}
