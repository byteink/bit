// compiler/checktraitcollect.bit — split out of checktrait.bit (#5641,
// which was at the 800-line E0200 ceiling with zero headroom). Sibling
// .bit file, same module: nothing here needs an import. See
// checktrait.bit's header for how this fits the overall trait-injection
// design (SPEC §10.7, #3369).
//
// Collects what `injectTraits` needs before it can validate or clone
// anything: every trait declared at module top level (collectTraitDecls),
// every class with at least one `use` statement (collectClassUseSites),
// and the "ClassName.methodName" set the class already declares itself
// (collectOwnMethodNames) — what "the class declaring a method itself
// wins silently" reads against.

// ---- collecting trait declarations and class `use` sites ----------------

// Every trait declared at this module's top level, by name. `export trait`
// unwraps like any other exportable declaration.
fn collectTraitDecls(tree: Tree, source: string): map<string, int> {
  let out = map<string, int>{}
  let decls = kidsOf(tree, tree.root)
  let i = 0
  while (i < len(decls)) {
    let d = decls[i]
    if (d != 0 && getNode(tree, d).tag == Tag.Export) {
      d = kidsOf(tree, d)[0]
    }
    if (d != 0 && getNode(tree, d).tag == Tag.TraitDecl) {
      out[identText(tree, source, kidsOf(tree, d)[0])] = d
    }
    i = i + 1
  }
  return out
}

class ClassUse {
  classNode: int,
  className: int,
  classGenerics: int,
  useStmts: []int,
}

// Every class that has at least one `use` statement in its body.
fn collectClassUseSites(tree: Tree): []ClassUse {
  let out = []ClassUse(0)
  let decls = kidsOf(tree, tree.root)
  let i = 0
  while (i < len(decls)) {
    let d = decls[i]
    if (d != 0 && getNode(tree, d).tag == Tag.Export) {
      d = kidsOf(tree, d)[0]
    }
    if (d != 0 && getNode(tree, d).tag == Tag.StructDecl) {
      let k = kidsOf(tree, d)
      let uses = classUseStmts(tree, k[2])
      if (len(uses) > 0) {
        out = append(
          out,
          ClassUse{ classNode = d, className = k[0], classGenerics = k[1], useStmts = uses },
        )
      }
    }
    i = i + 1
  }
  return out
}

fn classUseStmts(tree: Tree, fieldList: int): []int {
  let members = kidsOf(tree, fieldList)
  let uses = []int(0)
  let j = 0
  while (j < len(members)) {
    if (getNode(tree, members[j]).tag == Tag.UseStmt) {
      uses = append(uses, members[j])
    }
    j = j + 1
  }
  return uses
}

// The receiver's type-ref text, whether the receiver is `(x: Box)` or the
// generic `(x: Box<T>)` — same read `typeNodeName` (checklookup.bit) does,
// duplicated here in three lines because this pass runs before a Checker
// exists to call it on.
fn receiverTypeName(tree: Tree, source: string, recv: int): string {
  let tref = kidsOf(tree, recv)[1]
  if (getNode(tree, tref).tag == Tag.GenericInst) {
    return identText(tree, source, kidsOf(tree, tref)[0])
  }
  return identText(tree, source, tref)
}

// "ClassName.methodName" for every method the module ALREADY declares —
// arena-wide, because a method's home class comes from its receiver's type
// text, never from tree position (parsertype.bit's parseMethodMember desugars
// an in-body method to the identical `func_decl [receiver ...]` shape a
// written receiver produces). This is what "the class declaring a method
// itself wins silently" reads against.
fn collectOwnMethodNames(tree: Tree, source: string): map<string, bool> {
  let out = map<string, bool>{}
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.FuncDecl) {
      let k = kidsOf(tree, i)
      if (k[0] != 0) {
        out["${receiverTypeName(tree, source, k[0])}.${identText(tree, source, k[1])}"] = true
      }
    }
    i = i + 1
  }
  return out
}
