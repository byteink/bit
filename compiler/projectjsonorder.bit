// compiler/projectjsonorder.bit — std/json ordered before every module that needs
// `Json` bound by `__field` (classfieldread.bit, #7110, #7148).
//
// A class module's synthesized `__field` names `Json` through the module id of
// std/json (the one the interface requiring `__field` imported), and a module's
// id is greater than every id it depends on: a class module loaded BEFORE
// std/json (`import "./models"` ahead of `import "authz"`) could not bind it.
// After the one load, if the project declares such an interface and any module
// outside the prelude and std/json's own dependencies has a smaller id, the
// modules are renumbered: the prelude's and std/json's closures first, every
// other module after them in its old relative order. That is still a
// dependency order (a module outside the closures only gained predecessors, a
// module inside one depends on nothing outside them), so the project is
// parsed and resolved once, with no second load. A project with no such
// interface keeps its ids exactly.

// The ids `root` depends on, transitively, and its own, added to `seen`.
fn addImportClosure(p: Project, root: int, seen: map<int, bool>) {
  let stack = [root]
  while (len(stack) != 0) {
    let id = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    let (_, done) = seen[id]
    if (done) {
      continue
    }
    seen[id] = true
    for (_, dep) of p.mods[id].imports {
      if (dep >= 0) {
        stack = append(stack, dep)
      }
    }
  }
}

// `order[newId] = oldId` with the prelude's and std/json's closures first, or an
// empty list when every module below std/json's id is already one of them.
fn jsonFirstOrder(p: Project, jsonMod: int): []int {
  let first = map<int, bool>{}
  addImportClosure(p, jsonMod, first)
  if (p.prelude >= 0) {
    addImportClosure(p, p.prelude, first)
  }
  let id = 0
  let misplaced = false
  while (id < jsonMod) {
    let (_, keep) = first[id]
    misplaced = misplaced || !keep
    id = id + 1
  }
  if (!misplaced) {
    return []int(0)
  }
  let order = []int(0)
  let rest = []int(0)
  id = 0
  while (id < len(p.mods)) {
    let (_, keep) = first[id]
    if (keep) {
      order = append(order, id)
    } else {
      rest = append(rest, id)
    }
    id = id + 1
  }
  return appendAllInts(order, rest)
}

// `imports` with every resolved id mapped through `newId`; a negative entry is
// a failure sentinel (`modPkgFail`, ...) and stays.
fn renumberImports(imports: map<string, int>, newId: []int): map<string, int> {
  let out = map<string, int>{}
  for (path, id) of imports {
    if (id >= 0) {
      out[path] = newId[id]
    } else {
      out[path] = id
    }
  }
  return out
}

// Renumbers `p` in place so std/json (and the prelude) precede every module a
// synthesized `__field` may land in. A no-op unless an interface requires
// `__field` and some module sits below std/json without being its dependency.
fn orderJsonFirst(p: Project) {
  let demand = collectFieldReadDemand(p)
  if (demand.jsonMod < 0) {
    return
  }
  let order = jsonFirstOrder(p, demand.jsonMod)
  if (len(order) == 0) {
    return
  }
  let newId = []int(len(order))
  let mods = []SrcModule(0)
  let at = 0
  while (at < len(order)) {
    newId[order[at]] = at
    mods = append(mods, p.mods[order[at]])
    at = at + 1
  }
  for m of mods {
    m.imports = renumberImports(m.imports, newId)
  }
  p.mods = mods
  if (p.root >= 0) {
    p.root = newId[p.root]
  }
  if (p.prelude >= 0) {
    p.prelude = newId[p.prelude]
  }
}
