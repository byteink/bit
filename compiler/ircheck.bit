// In-Bit self-checks for the IR dump, codegen core and register allocator.
// Split out of selfcheck.bit (#1503); sibling .bit files are the same module,
// so `selfcheck()` still calls these directly.

// The IR text dumper must match `dump` byte-for-byte; pin it on
// a hand-built module (lowering, which produces these, lands next).
fn checkIrDump() {
  let ctx = newTypeContext()
  // Trivial: an empty function is one block with a bare `ret`.
  let f0 = IrFunc{ name: "main", paramTypes: []int(0), result: ctx.voidId,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }],
    instrs: [mkInstr(Op.Ret, ctx.voidId)], isFallible: false }
  assert(dumpIr(IrModule{ funcs: [f0], ctx: ctx, sm: newSourceManager() }) == "func main() void {\nbb0():\n  ret\n}\n", "IRDUMP-1")

  // A block param, a constant, a binary op, and a value-returning ret exercise
  // the header, `%N` numbering, opName, and the value list.
  let i64t = primType(ctx, 3)
  let bp = mkInstr(Op.BlockParam, i64t)
  let ci = mkInstr(Op.ConstInt, i64t)
  ci.ival = 1
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 0
  add.rhs = 1
  let rv = mkInstr(Op.Ret, ctx.voidId)
  rv.args = [2]
  let f1 = IrFunc{ name: "addOne", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 4 }],
    instrs: [bp, ci, add, rv], isFallible: false }
  let want = "func addOne(%0: i64) i64 {\nbb0(%0: i64):\n  %1 = const_int i64 1\n  %2 = add i64 %0, %1\n  ret %2\n}\n"
  assert(dumpIr(IrModule{ funcs: [f1], ctx: ctx, sm: newSourceManager() }) == want, "IRDUMP-2")

  // End-to-end through the real parse -> check -> lower pipeline: an empty
  // function is the fall-off `ret`; a signature carries its params + result.
  assert(lowerSourceDump("fn main() {}\n") == "func main() void {\nbb0():\n  ret\n}\n", "IRDUMP-3")
  assert(lowerSourceDump("fn sink(x: i64) {}\n") ==
    "func sink(%0: i64) void {\nbb0(%0: i64):\n  ret\n}\n", "IRDUMP-4")

  // A returned binary of two params: operand idents resolve to block-param value
  // ids, the op emits, and `ret` carries the result (matches the seed).
  assert(lowerSourceDump("fn add(a: i64, b: i64): i64 { return a + b }\n") ==
    "func add(%0: i64, %1: i64) i64 {\nbb0(%0: i64, %1: i64):\n  %2 = add i64 %0, %1\n  ret %2\n}\n", "IRDUMP-5")

  // A let-bound direct call feeds a print: `call @f`, the local is its result
  // value id, and the string literal + `rt_call print` follow.
  let srcG = "fn f(a: i64): i64 { return a }\nfn g() {\n  let x = f(5)\n  print(\"hi\")\n}\n"
  let wantG = "func f(%0: i64) i64 {\nbb0(%0: i64):\n  ret %0\n}\n\n" +
    "func g() void {\nbb0():\n  %0 = const_int i64 5\n  %1 = call @f(%0) i64\n  %2 = const_string \"hi\"\n  %3 = rt_call print(%2) void\n  ret\n}\n"
  assert(lowerSourceDump(srcG) == wantG, "IRDUMP-6")

  // A guard `if (x == 0) { print }`: the compare + br split the entry, the then
  // block prints and jumps to the join, and the join takes the live local `x`
  // as a block param — the seed's block-threaded SSA (matches bit --dump-ir-pre).
  let srcIf = "fn f(x: i64) {\n  if (x == 0) {\n    print(\"z\")\n  }\n}\n"
  let wantIf = "func f(%0: i64) void {\nbb0(%0: i64):\n  %1 = const_int i64 0\n" +
    "  %2 = icmp_eq bool %0, %1\n  br %2, bb1(), bb2(%0)\nbb1():\n  %4 = const_string \"z\"\n" +
    "  %5 = rt_call print(%4) void\n  jump bb2(%0)\nbb2(%7: i64):\n  ret\n}\n"
  assert(lowerSourceDump(srcIf) == wantIf, "IRDUMP-7")

  // String interpolation `"v=${n}!"`: literal segments -> const_string, the int
  // operand -> string_from_int, joined by ONE `string_concat5` (#4037) whose
  // two unused operands are the shared empty `const_string`. The seed folded
  // them left through the binary `string_concat`, at k-1 allocations for k
  // parts; the pad operands cost a pooled zero-length string and nothing else.
  let srcIp = "fn f(n: i64) {\n  print(\"v=\${n}!\")\n}\n"
  let wantIp = "func f(%0: i64) void {\nbb0(%0: i64):\n  %1 = const_string \"v=\"\n" +
    "  %2 = rt_call string_from_int(%0) string\n  %3 = const_string \"!\"\n" +
    "  %4 = const_string \"\"\n" +
    "  %5 = rt_call string_concat5(%1, %2, %3, %4, %4) string\n" +
    "  %6 = rt_call print(%5) void\n  ret\n}\n"
  assert(lowerSourceDump(srcIp) == wantIp, "IRDUMP-8")

  // A while loop: the entry jumps to a header carrying `i`, the header tests and
  // branches, the body increments and back-jumps, and the exit re-binds `i` —
  // the seed's loop-carried block-param SSA.
  let srcW = "fn main() {\n  let i = 0\n  while (i < 3) {\n    i = i + 1\n  }\n}\n"
  let wantW = "func main() void {\nbb0():\n  %0 = const_int i64 0\n  jump bb1(%0)\n" +
    "bb1(%2: i64):\n  %3 = const_int i64 3\n  %4 = icmp_slt bool %2, %3\n" +
    "  br %4, bb2(), bb3(%2)\nbb2():\n  %6 = const_int i64 1\n  %7 = add i64 %2, %6\n" +
    "  jump bb1(%7)\nbb3(%9: i64):\n  ret\n}\n"
  assert(lowerSourceDump(srcW) == wantW, "IRDUMP-9")

  // A class composite: gc_alloc (16 bytes, no ref fields) then a field_set per
  // field at its computed byte offset (0, 8) — the seed's class layout.
  let srcS = "class Point { x: i64, y: i64 }\nfn mk(a: i64, b: i64): Point { return Point{x: a, y: b} }\n"
  let wantS = "func mk(%0: i64, %1: i64) Point {\nbb0(%0: i64, %1: i64):\n" +
    "  %2 = gc_alloc size=16 ptrs=[] Point\n  field_set %2[0] = %0\n  field_set %2[8] = %1\n  ret %2\n}\n"
  assert(lowerSourceDump(srcS) == wantS, "IRDUMP-10")

  checkSliceElemIrDump()
  checkSliceElemRmwIrDump()
}

// The for-of element fetch, split out of `checkIrDump` (#4347) so that
// already-oversized function does not grow by another dump, and split again
// from `checkSliceElemRmwIrDump` so neither half crosses E0201's 80-line
// limit. These two are the only place either slice element path is pinned.
fn checkSliceElemIrDump() {
  // A for-of over a slice: hidden $iter/$idx locals thread the header/body/step/
  // exit blocks, the cursor advances in the step — the seed's counted-loop SSA.
  // The element reads INLINE (#4347): `buf`/`off` off the header (offsets 0 and
  // 16, ABI.md §2) and one `index_get`, straight in the body block. That is the
  // same sequence `xs[i]` emits (#3107) and is what this pins — a regression
  // back to `rt_call slice_get` here costs 190 runtime instructions per
  // iteration and nothing else in the suite would name it.
  //
  // FOUR BLOCKS, NOT SIX: #4354 dropped the element load's own
  // `slice_len`/`icmp_ult` test and the `index out of range` panic block, on
  // the grounds that bb1's `icmp_slt` against a freshly re-read `slice_len %6`
  // has already made the identical test for this iteration. The case that
  // argument rests on — a loop that `append`s to what it iterates, so the
  // header's `len` moves under the cursor — is pinned behaviourally by
  // `_tests_/cases/run_forof_mutation.bit` and the two
  // `run_forof_index_*_panic.bit` fixtures, not here. Pinning the dump here
  // means any further change to the shape shows up as a deliberate dump edit
  // rather than silently.
  let srcF = "fn sum(xs: []i64): i64 {\n  let s = 0\n  for x of xs {\n    s = s + x\n  }\n  return s\n}\n"
  let wantF = "func sum(%0: []i64) i64 {\n" +
    "bb0(%0: []i64):\n" +
    "  %1 = const_int i64 0\n" +
    "  %2 = const_int i64 0\n" +
    "  jump bb1(%0, %1, %0, %2)\n" +
    "bb1(%4: []i64, %5: i64, %6: []i64, %7: i64):\n" +
    "  %8 = slice_len %6\n" +
    "  %9 = icmp_slt bool %7, %8\n" +
    "  br %9, bb2(), bb4(%4, %5, %6, %7)\n" +
    "bb2():\n" +
    "  %11 = field_get %6[0] i64\n" +
    "  %12 = field_get %6[16] i64\n" +
    "  %13 = add i64 %12, %7\n" +
    "  %14 = index_get %11[%13] i64\n" +
    "  %15 = add i64 %5, %14\n" +
    "  jump bb3(%4, %15, %6, %7)\n" +
    "bb3(%17: []i64, %18: i64, %19: []i64, %20: i64):\n" +
    "  %21 = const_int i64 1\n" +
    "  %22 = add i64 %20, %21\n" +
    "  jump bb1(%17, %18, %19, %22)\n" +
    "bb4(%24: []i64, %25: i64, %26: []i64, %27: i64):\n" +
    "  ret %25\n" +
    "}\n"
  assert(lowerSourceDump(srcF) == wantF, "for-of slice IR dump must match the inline element load (#4347)")

}

// The `xs[i] += v` read half — the last element fetch still on the runtime
// call, and therefore the only remaining pin on its elem_size operand.
fn checkSliceElemRmwIrDump() {
  // `xs[i] += v` — the READ half (`readLvalue`, lowerassign.bit) is the one
  // element fetch still going through `rt_call slice_get`, so it is what pins
  // that call's explicit elem_size operand (#3120, ABI.md §9): the `const_int
  // i64 8` and the call's 3rd argument. The for-of dump above carried this
  // pin until #4347 inlined that site; without this case nothing in the suite
  // would notice elem_size going missing again.
  //
  // The WRITE half is already inline (#3108, `canInlineSliceStore` — an i64
  // element is 8 bytes), which is why only one `slice_get` and no `slice_set`
  // appears here.
  let srcE = "fn bump(xs: []i64) {\n  xs[0] += 1\n}\n"
  let wantE = "func bump(%0: []i64) void {\n" +
    "bb0(%0: []i64):\n" +
    "  %1 = const_int i64 0\n" +
    "  %2 = const_int i64 8\n" +
    "  %3 = rt_call slice_get(%0, %1, %2) i64\n" +
    "  %4 = const_int i64 1\n" +
    "  %5 = add i64 %3, %4\n" +
    "  %6 = slice_len %0\n" +
    "  %7 = icmp_ult bool %1, %6\n" +
    "  br %7, bb2(), bb1()\n" +
    "bb1():\n" +
    "  %9 = const_string \"index out of range\"\n" +
    "  %10 = rt_call panic(%9) void\n" +
    "  unreachable\n" +
    "bb2():\n" +
    "  %12 = field_get %0[0] i64\n" +
    "  %13 = field_get %0[16] i64\n" +
    "  %14 = add i64 %13, %1\n" +
    "  index_set %12[%14] = %5\n" +
    "  ret\n" +
    "}\n"
  assert(lowerSourceDump(srcE) == wantE, "compound-assign slice read must keep slice_get's elem_size operand (#3120)")
}

// #4400: `arityEscapesInFunc` (verify.bit) directly, on hand-built IR that
// never goes near the inliner — this proves the VALIDATOR itself, independent
// of any producer. `badJoin` is the exact pre-fix shape `spliceCallee` built
// for a 2-word return: a `jump bb1(%0, %0)` into a `bb1(%1: i64):` that
// declares only one parameter. `okJoin` is the same edge with matching arity.
fn checkArityValidatorFiresOnMalformedJoin() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let badJump = mkInstr(Op.Jump, ctx.voidId)
  badJump.ival = 1
  badJump.args = [0, 0]
  let badJoin = IrFunc{
    name: "badJoin", paramTypes: [i64t], result: i64t,
    blocks: [
      IrBlock{ instsStart: 0, paramCount: 1, instsLen: 2 },
      IrBlock{ instsStart: 2, paramCount: 1, instsLen: 2 },
    ],
    instrs: [
      mkInstr(Op.BlockParam, i64t), badJump,
      mkInstr(Op.BlockParam, i64t), mkInstr(Op.Ret, ctx.voidId),
    ],
    isFallible: false,
  }
  let bad = arityEscapesInFunc(badJoin)
  assert(len(bad) == 1, "a 2-argument jump into a 1-parameter block must report exactly one violation")
  assert(
    bad[0] == "badJoin: bb0's edge to bb1 passes 2 argument(s), but bb1 declares 1 parameter(s)",
    "unexpected diagnostic: ${bad[0]}",
  )

  let okJump = mkInstr(Op.Jump, ctx.voidId)
  okJump.ival = 1
  okJump.args = [0]
  let okJoin = IrFunc{
    name: "okJoin", paramTypes: [i64t], result: i64t,
    blocks: [
      IrBlock{ instsStart: 0, paramCount: 1, instsLen: 2 },
      IrBlock{ instsStart: 2, paramCount: 1, instsLen: 2 },
    ],
    instrs: [
      mkInstr(Op.BlockParam, i64t), okJump,
      mkInstr(Op.BlockParam, i64t), mkInstr(Op.Ret, ctx.voidId),
    ],
    isFallible: false,
  }
  assert(len(arityEscapesInFunc(okJoin)) == 0, "matching jump/param arity must be silent")
}

// #4400: the REAL inliner, on a genuine multi-word return — not hand-built
// already-inlined IR. `pair` is a 2-BLOCK callee returning the same i64 word
// twice (`calleeShapeOk` needs more than one block to reach spliceCallee's
// join-block path at all; the single-block fast path never builds one).
// `use` calls it and consumes the result, matching #4400's dumped repro
// (`%23 = add i64 %22, %19` reading a value nothing defined). This is also
// the mutation witness: reverting `spliceCallee` to its pre-fix single
// `builderAddParam` call makes THIS check fail — nothing else in the suite
// does, since a W>1 return is unreachable from source today.
fn checkInlineJoinArity() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)

  let calleeJump = mkInstr(Op.Jump, ctx.voidId)
  calleeJump.ival = 1
  let calleeRet = mkInstr(Op.Ret, ctx.voidId)
  calleeRet.args = [0, 0]
  let callee = IrFunc{
    name: "pair", paramTypes: [i64t], result: i64t,
    blocks: [
      IrBlock{ instsStart: 0, paramCount: 1, instsLen: 2 },
      IrBlock{ instsStart: 2, paramCount: 0, instsLen: 1 },
    ],
    instrs: [mkInstr(Op.BlockParam, i64t), calleeJump, calleeRet],
    isFallible: false,
  }

  let call = mkInstr(Op.Call, i64t)
  call.name = "pair"
  call.args = [0]
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 1
  add.rhs = 0
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [2]
  let caller = IrFunc{
    name: "use", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 4 }],
    instrs: [mkInstr(Op.BlockParam, i64t), call, add, ret], isFallible: false,
  }

  let m = IrModule{ funcs: [caller, callee], ctx: ctx, sm: newSourceManager() }
  let inlined = inlineCalls(m, [caller, callee], 0)
  let bad = arityEscapesInFunc(inlined)
  assert(
    len(bad) == 0,
    "the inliner's own join block must satisfy the arity it builds: ${dumpIr(IrModule{ funcs: [inlined], ctx: ctx, sm: newSourceManager() })}",
  )
}

// #4404: the LOWERER's exploded two-word argument, through the real parse ->
// check -> lower pipeline, pinned as emitted IR.
//
// Two assertions, and neither is redundant. The PRE-OPT dump is the shape this
// ticket produces: `take`'s signature is three i64 parameters rather than one
// tuple handle plus an i64, and the call site passes three arguments. The
// POST-OPT dump is the reason it is worth producing: the aggregate that
// `localRead` materializes at each use, and the one the call site takes apart,
// both cancel — the optimized callee reads its words straight out of its
// parameters and NOTHING allocates.
//
// The pre-opt form alone would pass with the optimizer unable to cancel any of
// it (a correct signature and a pessimized body); the post-opt form alone would
// pass if the aggregate had never been exploded at all, since a fully-inlined
// caller collapses either shape. Together they pin both halves.
fn checkExplodedPairArgs() {
  let src = "fn take(w: (int, int), k: int): int {\n" +
    "  return w.0 * 3 + w.1 + k\n" +
    "}\n" +
    "fn callIt(a: int, b: int): int {\n" +
    "  return take((a, b), 5)\n" +
    "}\n"
  let pre = lowerSourceDump(src)
  assert(
    startsWith(pre, "func take(%0: i64, %1: i64, %2: i64) i64 {\nbb0(%0: i64, %1: i64, %2: i64):\n"),
    "a two-word aggregate parameter must lower to TWO i64 parameters: ${pre}",
  )
  assert(
    indexOf(pre, "  %8 = call @take(%6, %7, %5) i64\n") >= 0,
    "the call site must pass the aggregate's two words, not one handle: ${pre}",
  )
  let post = lowerSourceDumpOpt(src)
  assert(
    post == "func take(%0: i64, %1: i64, %2: i64) i64 {\n" +
      "bb0(%0: i64, %1: i64, %2: i64):\n" +
      "  %3 = const_int i64 3\n" +
      "  %4 = mul i64 %0, %3\n" +
      "  %5 = add i64 %4, %1\n" +
      "  %6 = add i64 %5, %2\n" +
      "  ret %6\n" +
      "}\n" +
      "\n" +
      "func callIt(%0: i64, %1: i64) i64 {\n" +
      "bb0(%0: i64, %1: i64):\n" +
      "  %2 = const_int i64 5\n" +
      "  %3 = const_int i64 3\n" +
      "  %4 = mul i64 %0, %3\n" +
      "  %5 = add i64 %4, %1\n" +
      "  %6 = add i64 %5, %2\n" +
      "  ret %6\n" +
      "}\n",
    "an exploded two-word argument must leave NO allocation behind: ${post}",
  )
}

// #4410: an aggregate LOCAL of the exploded shape, held as two words rather
// than as a box, pinned as emitted IR.
//
// The shape that motivates it: the local is declared OUTSIDE a loop and passed
// to an exploded call INSIDE it. Before this, `w` was one boxed value threaded
// through the loop header as a block parameter, so the `field_set`s sat in the
// entry block and the call site's `field_get`s landed in the body — with a
// block parameter the back edge redefines in between, which store-to-load
// forwarding cannot cross. Every iteration paid a load per word, and the box
// stayed live across the whole loop as a traced GC root.
//
// Three things this pins, and each fails on its own for a different reason:
//
//   - `bb1` takes SEVEN i64 parameters, none of them the aggregate type. A
//     regression that stopped exploding the local puts `%N: (i64, i64)` back in
//     that list, which is also a live reference in every safepoint's stack map.
//   - the LOOP BODY, `bb2`, contains no `field_get`. That is the per-iteration
//     cost, and there is no `field_get` anywhere in this text at all.
//
//   - `bb1`/`bb2`/`bb3` are the PLAIN counted-loop shape, not #4204's
//     strip-mined one, and that is #4463 rather than a regression. `loopIt`'s
//     bound is its own function PARAMETER, so no trip count can be proved for
//     it, and a loop whose trip count cannot be bounded keeps its per-lap poll
//     — see optstriptrip.bit. The text carried the eleven-block strip shape
//     until that floor landed. The strip-mined form is pinned instead by
//     optstripcheck.bit, which asserts the DECISION directly.
//   - nothing in the function allocates. The box the initializer builds and the
//     two reads that take it apart must cancel; a lowering that kept either
//     half would still be correct and would still be the bug.
//
// Pinned as whole text rather than by substring, exactly as
// `checkExplodedPairArgs` does: a substring check passes on IR that also
// contains the thing it was written to exclude.
fn checkExplodedPairLocal() {
  let src = "fn take(w: (int, int), k: int): int {\n" +
    "  return w.0 * 3 + w.1 + k\n" +
    "}\n" +
    "fn loopIt(n: int, a: int, b: int): int {\n" +
    "  let w = (a, b)\n" +
    "  let acc = 0\n" +
    "  let i = 0\n" +
    "  while (i < n) {\n" +
    "    acc = acc + take(w, i)\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  return acc\n" +
    "}\n"
  let post = lowerSourceDumpOpt(src)
  assert(
    indexOf(
      post,
      "func loopIt(%0: i64, %1: i64, %2: i64) i64 {\n" +
        "bb0(%0: i64, %1: i64, %2: i64):\n" +
        "  %3 = const_int i64 0\n" +
        "  %4 = const_int i64 0\n" +
        "  jump bb1(%0, %1, %2, %1, %2, %3, %4)\n" +
        "bb1(%6: i64, %7: i64, %8: i64, %9: i64, %10: i64, %11: i64, %12: i64):\n" +
        "  %13 = icmp_slt bool %12, %6\n" +
        "  br %13, bb2(), bb3(%6, %7, %8, %9, %10, %11, %12)\n" +
        "bb2():\n" +
        "  %15 = const_int i64 3\n" +
        "  %16 = mul i64 %9, %15\n" +
        "  %17 = add i64 %16, %10\n" +
        "  %18 = add i64 %17, %12\n" +
        "  %19 = add i64 %11, %18\n" +
        "  %20 = const_int i64 1\n" +
        "  %21 = add i64 %12, %20\n" +
        "  jump bb1(%6, %7, %8, %9, %10, %19, %21)\n" +
        "bb3(%23: i64, %24: i64, %25: i64, %26: i64, %27: i64, %28: i64, %29: i64):\n" +
        "  ret %28\n" +
        "}\n",
    ) >= 0,
    "a two-word aggregate LOCAL must be carried as two i64 words: no box, no field_get in the loop body, no allocation: ${post}",
  )
}

// #4404: `callArityEscapesInFunc` (verify.bit) directly, on hand-built IR.
// A direct `Op.Call` naming a function DEFINED IN THIS MODULE must pass
// exactly as many arguments as that callee declares parameters — the
// invariant that becomes load-bearing once a parameter's word count is
// derived from its type rather than being one.
//
// Three arms, because two of them can pass for the wrong reason on their
// own: a short call must fire, a MATCHING call must stay silent (or the
// check is just "always complain"), and a call naming a symbol this module
// does not define must stay silent (or every freestanding object's
// cross-object reference becomes a false violation).
fn checkCallArityValidator() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let callee = IrFunc{
    name: "takes2", paramTypes: [i64t, i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 2, instsLen: 3 }],
    instrs: [
      mkInstr(Op.BlockParam, i64t), mkInstr(Op.BlockParam, i64t),
      mkInstr(Op.Ret, ctx.voidId),
    ],
    isFallible: false,
  }
  let counts = paramCountsByName([callee])

  let short = mkInstr(Op.Call, i64t)
  short.name = "takes2"
  short.args = [0]
  let bad = callArityEscapesInFunc(oneCallFunc("shortCall", i64t, ctx, short), counts)
  assert(len(bad) == 1, "a 1-argument call to a 2-parameter function must report exactly one violation")
  assert(
    bad[0] == "shortCall: %1 calls @takes2 with 1 argument(s), but @takes2 declares 2 parameter(s)",
    "unexpected diagnostic: ${bad[0]}",
  )

  let exact = mkInstr(Op.Call, i64t)
  exact.name = "takes2"
  exact.args = [0, 0]
  assert(
    len(callArityEscapesInFunc(oneCallFunc("okCall", i64t, ctx, exact), counts)) == 0,
    "a matching argument count must be silent",
  )

  let foreign = mkInstr(Op.Call, i64t)
  foreign.name = "bit_rt_not_in_this_module"
  foreign.args = [0]
  assert(
    len(callArityEscapesInFunc(oneCallFunc("crossObj", i64t, ctx, foreign), counts)) == 0,
    "a call to a symbol this module does not define has no arity to check",
  )
}

// One block: a parameter, `call`, and a `ret` — the smallest caller shape
// `checkCallArityValidator` needs, so its three arms differ only in the call.
fn oneCallFunc(name: string, i64t: int, ctx: TypeContext, call: IrInstr): IrFunc {
  return IrFunc{
    name: name, paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 3 }],
    instrs: [mkInstr(Op.BlockParam, i64t), call, mkInstr(Op.Ret, ctx.voidId)],
    isFallible: false,
  }
}

// `foldConvert` (optfold.bit, #3112) through the real parse -> check -> lower
// -> optimize pipeline. Pins BOTH directions, because only the pair is a
// guard: an over-eager rule that shortcut a lossy conversion would still
// satisfy the first assertion on its own.
fn checkConvertFold() {
  // The fold fires: `*T ± n` scales the offset and retypes it with a no-op
  // `convert`, and 208*8 survives that retype unchanged, so the `add`'s
  // operand reaches codegen as a plain `const_int` #1853 can encode as an
  // ADD-immediate. Pre-opt this is const_int + mul + convert + add.
  let srcP = "fn f(g: *i64): int {\n  return *(g + 208)\n}\n"
  assert(lowerSourceDumpOpt(srcP) ==
    "func f(%0: *i64) i64 {\nbb0(%0: *i64):\n  %1 = const_int *i64 1664\n" +
    "  %2 = add *i64 %0, %1\n  %3 = field_get %2[0] i64\n  ret %3\n}\n")

  // The fold declines: 300 does not survive the narrowing to u8, so the
  // `convert` MUST still be a real instruction and evaluate at runtime. The
  // pinned golden case `_tests_/cases/run_convert.bit` fixes the value it then
  // produces (44); this fixes the shape that produces it.
  let srcN = "fn g(): u8 {\n  return u8(300)\n}\n"
  assert(lowerSourceDumpOpt(srcN) ==
    "func g() u8 {\nbb0():\n  %0 = const_int i64 300\n  %1 = convert u8 %0\n" +
    "  ret %1\n}\n")

  // Nor across register classes: an int->float conversion is an SCVTF, never a
  // reinterpretation of the same bits.
  let srcF = "fn h(): f64 {\n  return f64(3)\n}\n"
  assert(lowerSourceDumpOpt(srcF) ==
    "func h() f64 {\nbb0():\n  %0 = const_int i64 3\n  %1 = convert f64 %0\n" +
    "  ret %1\n}\n")
}

// Stage 3 (#1340) codegen core: scalar classification, GC-reference
// classification, and the stack-map blob's byte layout (runtime/ABI.md §4).
fn checkCodegenCore() {
  let ctx = newTypeContext()
  // Every prim classifies at its natural width; everything else is a boxed
  // 8-byte handle.
  let i8w = widthOf(ctx, primType(ctx, 0))
  assert(i8w.bytes == 1 && i8w.regClass == RegClass.Int && i8w.signed)
  let u8w = widthOf(ctx, primType(ctx, 4))
  assert(u8w.bytes == 1 && !u8w.signed)
  let i64w = widthOf(ctx, primType(ctx, 3))
  assert(i64w.bytes == 8 && i64w.regClass == RegClass.Int && i64w.signed)
  let f64w = widthOf(ctx, primType(ctx, 9))
  assert(f64w.bytes == 8 && f64w.regClass == RegClass.Float && !f64w.signed)
  let f32w = widthOf(ctx, primType(ctx, 8))
  assert(f32w.bytes == 4 && f32w.regClass == RegClass.Float)
  let boolw = widthOf(ctx, primType(ctx, 10))
  assert(boolw.bytes == 1 && boolw.regClass == RegClass.Int)
  let strw = widthOf(ctx, primType(ctx, 11))
  assert(strw.bytes == 8 && strw.regClass == RegClass.Int && !strw.signed)
  assert(regClassOf(ctx, primType(ctx, 9)) == RegClass.Float)
  // A slice is a boxed handle, not a scalar.
  let sl = mkSlice(ctx, primType(ctx, 3))
  assert(widthOf(ctx, sl).bytes == 8)

  // GC references: strings and every boxed shape; never a scalar or a void.
  assert(isRefType(ctx, primType(ctx, 11)))
  assert(!isRefType(ctx, primType(ctx, 3)))
  assert(!isRefType(ctx, primType(ctx, 9)))
  assert(!isRefType(ctx, ctx.voidId))
  assert(isRefType(ctx, sl))
  // A payload-less enum is a bare tag word; one with a payload is boxed.
  let bare = leafType(TypeKind.Enum)
  assert(!isRefType(ctx, addType(ctx, bare)))
  let boxed = leafType(TypeKind.Enum)
  boxed.enumBoxed = true
  assert(isRefType(ctx, addType(ctx, boxed)))

  // The stack-map blob: one function, one saved reg, one safepoint with one
  // live slot and one live reg. Layout per ABI.md §4, little-endian packed.
  let out = newByteBuf()
  let sp = SafepointView{ retOffset: 4, slots: [-16], regs: [7] }
  let fsm = FuncStackMap{ codeSize: 32, saved: [SavedReg{ reg: 29, fpOff: -8 }],
    safepoints: [sp] }
  let relocs = writeStackMaps(out, [fsm])
  // ABI.md §4: NO leading count — the merged table spans every archive member
  // that carries entries, so no object can write one. The entry therefore starts
  // at offset 0, and its 8-byte codeAddr field IS the relocation site.
  assert(len(relocs) == 1 && relocs[0] == 0, "stack-map entry must start at offset 0 with one reloc")
  // 8 (codeAddr) + 2 (format version, #3189) + 4 (codeSize) + 2 (numSaved)
  // + 6 (reg+fpOff) + 2 (numSafepoints) + 4 (retOffset) + 2 (numSlots)
  // + 4 (slot) + 2 (numRegs) + 2 (reg) = 38, then padded to a multiple of 8
  // (#1927, ABI.md §4) = 40.
  assert(len(out.bytes) == 40, "stack-map entry must be padded to a multiple of 8 bytes (#1927)")
  assert(int(out.bytes[8]) == smFormatVersion, "format version field must read back smFormatVersion (#3189)") // version = 1
  assert(int(out.bytes[10]) == 32, "codeSize field must read back 32") // codeSize = 32
  assert(int(out.bytes[14]) == 1, "numSaved field must read back 1") // numSaved = 1
  assert(int(out.bytes[16]) == 29, "saved reg field must read back x29") // saved reg = x29
  // fpOff = -8 sign-extends across the whole i32.
  assert(int(out.bytes[18]) == 248 && int(out.bytes[21]) == 255, "fpOff must sign-extend -8 across the i32 field")
}
