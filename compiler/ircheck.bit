// In-Bit self-checks for the IR dump, codegen core and register allocator.
// Split out of selfcheck.bit (#1503); sibling .bit files are the same module,
// so `selfcheck()` still calls these directly.

// The IR text dumper must match `dump` byte-for-byte; pin it on
// a hand-built module (lowering, which produces these, lands next).
fn checkIrDump() {
  let ctx = newTypeContext()
  // Trivial: an empty function is one block with a bare `ret`.
  let f0 = IrFunc{ name: "main", paramTypes: []int(0), result: ctx.voidId,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }],
    instrs: [mkInstr(Op.Ret, ctx.voidId)], isFallible: false }
  assert(dumpIr(IrModule{ funcs: [f0], ctx: ctx, sm: newSourceManager() }) == "func main() void {\nbb0():\n  ret\n}\n", "IRDUMP-1")

  // A block param, a constant, a binary op, and a value-returning ret exercise
  // the header, `%N` numbering, opName, and the value list.
  let i64t = primType(ctx, 3)
  let bp = mkInstr(Op.BlockParam, i64t)
  let ci = mkInstr(Op.ConstInt, i64t)
  ci.ival = 1
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 0
  add.rhs = 1
  let rv = mkInstr(Op.Ret, ctx.voidId)
  rv.args = [2]
  let f1 = IrFunc{ name: "addOne", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 4 }],
    instrs: [bp, ci, add, rv], isFallible: false }
  let want = "func addOne(%0: i64) i64 {\nbb0(%0: i64):\n  %1 = const_int i64 1\n  %2 = add i64 %0, %1\n  ret %2\n}\n"
  assert(dumpIr(IrModule{ funcs: [f1], ctx: ctx, sm: newSourceManager() }) == want, "IRDUMP-2")

  // End-to-end through the real parse -> check -> lower pipeline: an empty
  // function is the fall-off `ret`; a signature carries its params + result.
  assert(lowerSourceDump("fn main() {}\n") == "func main() void {\nbb0():\n  ret\n}\n", "IRDUMP-3")
  assert(lowerSourceDump("fn sink(x: i64) {}\n") ==
    "func sink(%0: i64) void {\nbb0(%0: i64):\n  ret\n}\n", "IRDUMP-4")

  // A returned binary of two params: operand idents resolve to block-param value
  // ids, the op emits, and `ret` carries the result (matches the seed).
  assert(lowerSourceDump("fn add(a: i64, b: i64): i64 { return a + b }\n") ==
    "func add(%0: i64, %1: i64) i64 {\nbb0(%0: i64, %1: i64):\n  %2 = add i64 %0, %1\n  ret %2\n}\n", "IRDUMP-5")

  // A let-bound direct call feeds a print: `call @f`, the local is its result
  // value id, and the string literal + `rt_call print` follow.
  let srcG = "fn f(a: i64): i64 { return a }\nfn g() {\n  let x = f(5)\n  print(\"hi\")\n}\n"
  let wantG = "func f(%0: i64) i64 {\nbb0(%0: i64):\n  ret %0\n}\n\n" +
    "func g() void {\nbb0():\n  %0 = const_int i64 5\n  %1 = call @f(%0) i64\n  %2 = const_string \"hi\"\n  %3 = rt_call print(%2) void\n  ret\n}\n"
  assert(lowerSourceDump(srcG) == wantG, "IRDUMP-6")

  // A guard `if (x == 0) { print }`: the compare + br split the entry, the then
  // block prints and jumps to the join, and the join takes the live local `x`
  // as a block param — the seed's block-threaded SSA (matches bit --dump-ir-pre).
  let srcIf = "fn f(x: i64) {\n  if (x == 0) {\n    print(\"z\")\n  }\n}\n"
  let wantIf = "func f(%0: i64) void {\nbb0(%0: i64):\n  %1 = const_int i64 0\n" +
    "  %2 = icmp_eq bool %0, %1\n  br %2, bb1(), bb2(%0)\nbb1():\n  %4 = const_string \"z\"\n" +
    "  %5 = rt_call print(%4) void\n  jump bb2(%0)\nbb2(%7: i64):\n  ret\n}\n"
  assert(lowerSourceDump(srcIf) == wantIf, "IRDUMP-7")

  // String interpolation `"v=${n}!"`: literal segments -> const_string, the int
  // operand -> string_from_int, joined by ONE `string_concat5` (#4037) whose
  // two unused operands are the shared empty `const_string`. The seed folded
  // them left through the binary `string_concat`, at k-1 allocations for k
  // parts; the pad operands cost a pooled zero-length string and nothing else.
  let srcIp = "fn f(n: i64) {\n  print(\"v=\${n}!\")\n}\n"
  let wantIp = "func f(%0: i64) void {\nbb0(%0: i64):\n  %1 = const_string \"v=\"\n" +
    "  %2 = rt_call string_from_int(%0) string\n  %3 = const_string \"!\"\n" +
    "  %4 = const_string \"\"\n" +
    "  %5 = rt_call string_concat5(%1, %2, %3, %4, %4) string\n" +
    "  %6 = rt_call print(%5) void\n  ret\n}\n"
  assert(lowerSourceDump(srcIp) == wantIp, "IRDUMP-8")

  // A while loop: the entry jumps to a header carrying `i`, the header tests and
  // branches, the body increments and back-jumps, and the exit re-binds `i` —
  // the seed's loop-carried block-param SSA.
  let srcW = "fn main() {\n  let i = 0\n  while (i < 3) {\n    i = i + 1\n  }\n}\n"
  let wantW = "func main() void {\nbb0():\n  %0 = const_int i64 0\n  jump bb1(%0)\n" +
    "bb1(%2: i64):\n  %3 = const_int i64 3\n  %4 = icmp_slt bool %2, %3\n" +
    "  br %4, bb2(), bb3(%2)\nbb2():\n  %6 = const_int i64 1\n  %7 = add i64 %2, %6\n" +
    "  jump bb1(%7)\nbb3(%9: i64):\n  ret\n}\n"
  assert(lowerSourceDump(srcW) == wantW, "IRDUMP-9")

  // A class composite: gc_alloc (16 bytes, no ref fields) then a field_set per
  // field at its computed byte offset (0, 8) — the seed's class layout.
  let srcS = "class Point { x: i64, y: i64 }\nfn mk(a: i64, b: i64): Point { return Point{x: a, y: b} }\n"
  let wantS = "func mk(%0: i64, %1: i64) Point {\nbb0(%0: i64, %1: i64):\n" +
    "  %2 = gc_alloc size=16 ptrs=[] Point\n  field_set %2[0] = %0\n  field_set %2[8] = %1\n  ret %2\n}\n"
  assert(lowerSourceDump(srcS) == wantS, "IRDUMP-10")

  // A for-of over a slice: hidden $iter/$idx locals thread the header/body/step/
  // exit blocks, the element reads via slice_get, the cursor advances in the
  // step — the seed's counted-loop SSA. slice_get carries an explicit
  // elem_size operand (#3120, ABI.md §9) — the const_int 8 ahead of the call
  // and the call's 3rd argument below.
  let srcF = "fn sum(xs: []i64): i64 {\n  let s = 0\n  for x of xs {\n    s = s + x\n  }\n  return s\n}\n"
  let wantF = "func sum(%0: []i64) i64 {\nbb0(%0: []i64):\n  %1 = const_int i64 0\n" +
    "  %2 = const_int i64 0\n  jump bb1(%0, %1, %0, %2)\n" +
    "bb1(%4: []i64, %5: i64, %6: []i64, %7: i64):\n  %8 = slice_len %6\n" +
    "  %9 = icmp_slt bool %7, %8\n  br %9, bb2(), bb4(%4, %5, %6, %7)\n" +
    "bb2():\n  %11 = const_int i64 8\n  %12 = rt_call slice_get(%6, %7, %11) i64\n" +
    "  %13 = add i64 %5, %12\n  jump bb3(%4, %13, %6, %7)\n" +
    "bb3(%15: []i64, %16: i64, %17: []i64, %18: i64):\n  %19 = const_int i64 1\n" +
    "  %20 = add i64 %18, %19\n  jump bb1(%15, %16, %17, %20)\n" +
    "bb4(%22: []i64, %23: i64, %24: []i64, %25: i64):\n  ret %23\n}\n"
  assert(lowerSourceDump(srcF) == wantF, "for-of slice IR dump must match slice_get's elem_size-carrying call shape (#3120)")
}

// `foldConvert` (optfold.bit, #3112) through the real parse -> check -> lower
// -> optimize pipeline. Pins BOTH directions, because only the pair is a
// guard: an over-eager rule that shortcut a lossy conversion would still
// satisfy the first assertion on its own.
fn checkConvertFold() {
  // The fold fires: `*T ± n` scales the offset and retypes it with a no-op
  // `convert`, and 208*8 survives that retype unchanged, so the `add`'s
  // operand reaches codegen as a plain `const_int` #1853 can encode as an
  // ADD-immediate. Pre-opt this is const_int + mul + convert + add.
  let srcP = "fn f(g: *i64): int {\n  return *(g + 208)\n}\n"
  assert(lowerSourceDumpOpt(srcP) ==
    "func f(%0: *i64) i64 {\nbb0(%0: *i64):\n  %1 = const_int *i64 1664\n" +
    "  %2 = add *i64 %0, %1\n  %3 = field_get %2[0] i64\n  ret %3\n}\n")

  // The fold declines: 300 does not survive the narrowing to u8, so the
  // `convert` MUST still be a real instruction and evaluate at runtime. The
  // pinned golden case `_tests_/cases/run_convert.bit` fixes the value it then
  // produces (44); this fixes the shape that produces it.
  let srcN = "fn g(): u8 {\n  return u8(300)\n}\n"
  assert(lowerSourceDumpOpt(srcN) ==
    "func g() u8 {\nbb0():\n  %0 = const_int i64 300\n  %1 = convert u8 %0\n" +
    "  ret %1\n}\n")

  // Nor across register classes: an int->float conversion is an SCVTF, never a
  // reinterpretation of the same bits.
  let srcF = "fn h(): f64 {\n  return f64(3)\n}\n"
  assert(lowerSourceDumpOpt(srcF) ==
    "func h() f64 {\nbb0():\n  %0 = const_int i64 3\n  %1 = convert f64 %0\n" +
    "  ret %1\n}\n")
}

// Stage 3 (#1340) codegen core: scalar classification, GC-reference
// classification, and the stack-map blob's byte layout (runtime/ABI.md §4).
fn checkCodegenCore() {
  let ctx = newTypeContext()
  // Every prim classifies at its natural width; everything else is a boxed
  // 8-byte handle.
  let i8w = widthOf(ctx, primType(ctx, 0))
  assert(i8w.bytes == 1 && i8w.regClass == RegClass.Int && i8w.signed)
  let u8w = widthOf(ctx, primType(ctx, 4))
  assert(u8w.bytes == 1 && !u8w.signed)
  let i64w = widthOf(ctx, primType(ctx, 3))
  assert(i64w.bytes == 8 && i64w.regClass == RegClass.Int && i64w.signed)
  let f64w = widthOf(ctx, primType(ctx, 9))
  assert(f64w.bytes == 8 && f64w.regClass == RegClass.Float && !f64w.signed)
  let f32w = widthOf(ctx, primType(ctx, 8))
  assert(f32w.bytes == 4 && f32w.regClass == RegClass.Float)
  let boolw = widthOf(ctx, primType(ctx, 10))
  assert(boolw.bytes == 1 && boolw.regClass == RegClass.Int)
  let strw = widthOf(ctx, primType(ctx, 11))
  assert(strw.bytes == 8 && strw.regClass == RegClass.Int && !strw.signed)
  assert(regClassOf(ctx, primType(ctx, 9)) == RegClass.Float)
  // A slice is a boxed handle, not a scalar.
  let sl = mkSlice(ctx, primType(ctx, 3))
  assert(widthOf(ctx, sl).bytes == 8)

  // GC references: strings and every boxed shape; never a scalar or a void.
  assert(isRefType(ctx, primType(ctx, 11)))
  assert(!isRefType(ctx, primType(ctx, 3)))
  assert(!isRefType(ctx, primType(ctx, 9)))
  assert(!isRefType(ctx, ctx.voidId))
  assert(isRefType(ctx, sl))
  // A payload-less enum is a bare tag word; one with a payload is boxed.
  let bare = leafType(TypeKind.Enum)
  assert(!isRefType(ctx, addType(ctx, bare)))
  let boxed = leafType(TypeKind.Enum)
  boxed.enumBoxed = true
  assert(isRefType(ctx, addType(ctx, boxed)))

  // The stack-map blob: one function, one saved reg, one safepoint with one
  // live slot and one live reg. Layout per ABI.md §4, little-endian packed.
  let out = newByteBuf()
  let sp = SafepointView{ retOffset: 4, slots: [-16], regs: [7] }
  let fsm = FuncStackMap{ codeSize: 32, saved: [SavedReg{ reg: 29, fpOff: -8 }],
    safepoints: [sp] }
  let relocs = writeStackMaps(out, [fsm])
  // ABI.md §4: NO leading count — the merged table spans every archive member
  // that carries entries, so no object can write one. The entry therefore starts
  // at offset 0, and its 8-byte codeAddr field IS the relocation site.
  assert(len(relocs) == 1 && relocs[0] == 0, "stack-map entry must start at offset 0 with one reloc")
  // 8 (codeAddr) + 2 (format version, #3189) + 4 (codeSize) + 2 (numSaved)
  // + 6 (reg+fpOff) + 2 (numSafepoints) + 4 (retOffset) + 2 (numSlots)
  // + 4 (slot) + 2 (numRegs) + 2 (reg) = 38, then padded to a multiple of 8
  // (#1927, ABI.md §4) = 40.
  assert(len(out.bytes) == 40, "stack-map entry must be padded to a multiple of 8 bytes (#1927)")
  assert(int(out.bytes[8]) == smFormatVersion, "format version field must read back smFormatVersion (#3189)") // version = 1
  assert(int(out.bytes[10]) == 32, "codeSize field must read back 32") // codeSize = 32
  assert(int(out.bytes[14]) == 1, "numSaved field must read back 1") // numSaved = 1
  assert(int(out.bytes[16]) == 29, "saved reg field must read back x29") // saved reg = x29
  // fpOff = -8 sign-extends across the whole i32.
  assert(int(out.bytes[18]) == 248 && int(out.bytes[21]) == 255, "fpOff must sign-extend -8 across the i32 field")
}

fn mkIv(vreg: int, regClass: RegClass, start: int, end: int, isRef: bool): LiveInterval {
  return LiveInterval{ vreg: vreg, regClass: regClass, start: start, end: end, isRef: isRef }
}

fn mkRegs(intCount: int, floatCount: int): TargetRegs {
  return TargetRegs{ intRegs: RegFile{ count: intCount, calleeSaved: 0 },
    floatRegs: RegFile{ count: floatCount, calleeSaved: 0 } }
}

// The same, with explicit callee-saved masks — the only way #3171's
// clobber-point restriction can be reached.
fn mkRegsCs(intCount: int, intCs: int, floatCount: int, floatCs: int): TargetRegs {
  return TargetRegs{ intRegs: RegFile{ count: intCount, calleeSaved: intCs },
    floatRegs: RegFile{ count: floatCount, calleeSaved: floatCs } }
}

// The allocator's core correctness invariant: no two intervals whose ranges
// overlap were assigned the same physical register within the same class.
fn assertNoOverlappingRegs(intervals: []LiveInterval, locations: []RegLoc) {
  let i = 0
  while (i < len(intervals)) {
    let a = intervals[i]
    let locA = locations[a.vreg]
    if (locA.isSpill) {
      i = i + 1
      continue
    }
    let j = i + 1
    while (j < len(intervals)) {
      let b = intervals[j]
      let locB = locations[b.vreg]
      if (a.regClass == b.regClass && !locB.isSpill && locA.index == locB.index) {
        assert(!(a.start <= b.end && b.start <= a.end))
      }
      j = j + 1
    }
    i = i + 1
  }
}

// Stage 3 linear-scan register allocator — ports own tests.
fn checkRegalloc() {
  // Non-overlapping intervals share a register (reused after expiry).
  let ivs = [mkIv(0, RegClass.Int, 0, 2, false), mkIv(1, RegClass.Int, 3, 5, false)]
  let r = allocate(mkRegs(2, 0), ivs, []int(0), []int(0))
  assert(!r.locations[0].isSpill && r.locations[0].index == 0)
  assert(!r.locations[1].isSpill && r.locations[1].index == 0)
  assert(r.numSpillSlots == 0)
  assertNoOverlappingRegs(ivs, r.locations)

  // Out of registers: the interval with the furthest end spills.
  let ivs2 = [mkIv(0, RegClass.Int, 0, 4, false), mkIv(1, RegClass.Int, 1, 10, false)]
  let r2 = allocate(mkRegs(1, 0), ivs2, []int(0), []int(0))
  assert(!r2.locations[0].isSpill && r2.locations[0].index == 0)
  assert(r2.locations[1].isSpill && r2.locations[1].index == 0)
  assert(r2.numSpillSlots == 1)
  assertNoOverlappingRegs(ivs2, r2.locations)

  // A freed spill slot is recycled: v1's slot frees at 6, so v3 (starting at 9)
  // reuses it instead of growing the frame.
  let ivs3 = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 1, 6, false),
    mkIv(2, RegClass.Int, 7, 12, false), mkIv(3, RegClass.Int, 9, 15, false)]
  let r3 = allocate(mkRegs(1, 0), ivs3, []int(0), []int(0))
  assert(!r3.locations[0].isSpill && r3.locations[0].index == 0)
  assert(r3.locations[1].isSpill && r3.locations[1].index == 0)
  assert(!r3.locations[2].isSpill && r3.locations[2].index == 0)
  assert(r3.locations[3].isSpill && r3.locations[3].index == 0)
  assert(r3.numSpillSlots == 1)
  assertNoOverlappingRegs(ivs3, r3.locations)

  // Int and float classes are independent register files.
  let ivs4 = [mkIv(0, RegClass.Int, 0, 10, false), mkIv(1, RegClass.Float, 0, 10, false)]
  let r4 = allocate(mkRegs(1, 1), ivs4, []int(0), []int(0))
  assert(!r4.locations[0].isSpill && r4.locations[0].index == 0)
  assert(!r4.locations[1].isSpill && r4.locations[1].index == 0)
  assert(r4.numSpillSlots == 0)

  // A precise GC stack map: only v0 (a live ref spanning the safepoint) is
  // reported — not v1 (not a ref) or v2 (dead by pos 5).
  let ivs5 = [mkIv(0, RegClass.Int, 0, 10, true), mkIv(1, RegClass.Int, 0, 10, false),
    mkIv(2, RegClass.Int, 0, 3, true)]
  let r5 = allocate(mkRegs(2, 0), ivs5, [5], []int(0))
  assert(len(r5.stackMaps) == 1)
  assert(r5.stackMaps[0].pos == 5)
  assert(len(r5.stackMaps[0].slots) == 0)
  assert(len(r5.stackMaps[0].regs) == 1)
  assert(r5.stackMaps[0].regs[0] == r5.locations[0].index)

  // A spilled reference is reported by slot, not register.
  let ivs6 = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 1, 20, true)]
  let r6 = allocate(mkRegs(1, 0), ivs6, [10], []int(0))
  assert(r6.locations[1].isSpill)
  assert(len(r6.stackMaps[0].regs) == 0)
  assert(len(r6.stackMaps[0].slots) == 1)
  assert(r6.stackMaps[0].slots[0] == r6.locations[1].index)

  // Forced register pressure (cap of 4): four long-lived loop-carried values
  // already saturate the file, with 20 overlapping temporaries layered on top.
  // Registers must never overlap and spills must happen.
  let stress = []LiveInterval(0)
  let v = 0
  while (v < 4) {
    stress = append(stress, mkIv(v, RegClass.Int, 0, 200, v == 0))
    v = v + 1
  }
  let t = 0
  while (t < 20) {
    stress = append(stress, mkIv(v, RegClass.Int, t * 5, t * 5 + 40, false))
    v = v + 1
    t = t + 1
  }
  let r7 = allocate(mkRegs(4, 0), stress, [100, 150], []int(0))
  assertNoOverlappingRegs(stress, r7.locations)
  assert(r7.numSpillSlots > 0)
  let k = 0
  while (k < len(r7.stackMaps)) {
    assert(len(r7.stackMaps[k].regs) + len(r7.stackMaps[k].slots) <= 1)
    k = k + 1
  }
  checkRegallocClobbers()
}

// #3171: `clobbers` restricts a live-across interval to the callee-saved subset
// of its class, per INTERVAL rather than per function.
fn checkRegallocClobbers() {
  // The SysV float shape that motivated the ticket: two float registers, NONE
  // callee-saved, one clobber point at 10. v0 spans it and must still spill —
  // that is the behaviour a call destroying every xmm requires. v1 lives
  // entirely after it and must now get a register; before #3171 the answer was
  // per function and it spilled too.
  let ivsA = [mkIv(0, RegClass.Float, 0, 20, false), mkIv(1, RegClass.Float, 11, 15, false)]
  let rA = allocate(mkRegsCs(0, 0, 2, 0), ivsA, []int(0), [10])
  assert(rA.locations[0].isSpill, "a float spanning a clobber point must spill when nothing is callee-saved")
  assert(!rA.locations[1].isSpill, "a float living entirely between clobber points must get a register")

  // The boundary, and it is what makes a BACK-EDGE safepoint correct: the poll
  // call is emitted BEFORE the edge's parallel move, so a value whose last read
  // IS that edge is read after the clobber. So end == p crosses, while
  // start == p (a call's own result, defined after the clobber) does not.
  let ivsB = [mkIv(0, RegClass.Float, 0, 10, false), mkIv(1, RegClass.Float, 10, 20, false)]
  let rB = allocate(mkRegsCs(0, 0, 2, 0), ivsB, []int(0), [10])
  assert(rB.locations[0].isSpill, "end == clobber pos must count as live across it")
  assert(!rB.locations[1].isSpill, "start == clobber pos must NOT count as live across it")

  // A partial mask: only register 2 is callee-saved, so the spanning interval
  // takes it even though registers 0 and 1 are free, and the short one then
  // takes register 0.
  let ivsC = [mkIv(0, RegClass.Int, 0, 20, false), mkIv(1, RegClass.Int, 1, 3, false)]
  let rC = allocate(mkRegsCs(3, 4, 0, 0), ivsC, []int(0), [10])
  assert(!rC.locations[0].isSpill && rC.locations[0].index == 2, "a spanning interval must take a callee-saved register")
  assert(!rC.locations[1].isSpill && rC.locations[1].index == 0, "a non-spanning interval may take any free register")

  // The same intervals with NO clobber positions must allocate exactly as they
  // did before #3171 — v0 first, so register 0. This is the pin that the new
  // parameter is inert when unused; every other backend still passes none.
  let rD = allocate(mkRegsCs(3, 4, 0, 0), ivsC, []int(0), []int(0))
  assert(!rD.locations[0].isSpill && rD.locations[0].index == 0, "no clobber positions must leave the plain scan untouched")

  // Eviction has to go through the mask too. Register 1 is FREE when v2 is
  // processed (v1 expired at 20) and v2 still may not have it, so v2 evicts the
  // longer-lived v0 out of register 0 instead. Without the mask v2 would simply
  // take register 1 and nothing would spill at all, which is what makes this
  // case worth pinning rather than assuming.
  let ivsE = [mkIv(0, RegClass.Int, 0, 300, false), mkIv(1, RegClass.Int, 10, 20, false),
    mkIv(2, RegClass.Int, 30, 100, false)]
  let rE = allocate(mkRegsCs(2, 1, 0, 0), ivsE, []int(0), [50])
  assert(rE.locations[0].isSpill, "the evicted holder of the only allowed register must spill")
  assert(!rE.locations[1].isSpill && rE.locations[1].index == 1, "an unrestricted interval may take a caller-saved register")
  assert(!rE.locations[2].isSpill && rE.locations[2].index == 0, "a spanning interval must evict rather than take a free caller-saved register")
  assertNoOverlappingRegs(ivsE, rE.locations)
  checkRegallocCoalesce()
}

// #3738: `roots` makes a vreg share its root's location, and widens the root's
// interval to cover it.
fn checkRegallocCoalesce() {
  // v1 aliases v0. They must land on the SAME register — that identity is what
  // turns the block edge's `v1 := v0` into a self-move the sequencer drops.
  let ivs = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 5, 12, false)]
  let r = allocateCoalesced(mkRegs(2, 0), ivs, []int(0), []int(0), [0, 0])
  assert(!r.locations[0].isSpill && !r.locations[1].isSpill)
  assert(r.locations[0].index == r.locations[1].index, "an alias must take its root's register")

  // THE SAFETY CASE, and the one that fails if the merge does not widen: v2
  // starts at 8, AFTER v0's own end of 5, so a scan that expired v0 on its own
  // interval would hand register 0 straight to v2 while the alias v1 still
  // reads it. With one register available v2 must spill instead.
  let ivs2 = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 5, 12, false),
    mkIv(2, RegClass.Int, 8, 20, false)]
  let r2 = allocateCoalesced(mkRegs(1, 0), ivs2, []int(0), []int(0), [0, 0, 2])
  assert(r2.locations[0].index == r2.locations[1].index && !r2.locations[0].isSpill)
  assert(r2.locations[2].isSpill, "an interval overlapping an alias must not reuse the shared register")

  // Coalescing also BUYS a register: the same three intervals without the alias
  // relation need two registers, and v2 gets one here where it spilled above.
  let r3 = allocateCoalesced(mkRegs(2, 0), ivs2, []int(0), []int(0), [0, 0, 2])
  assert(!r3.locations[2].isSpill && r3.locations[2].index != r3.locations[0].index)

  // A reference reaching a safepoint only through its alias is still reported,
  // once — the root carries the merged interval and the shared location, so
  // listing the alias too would name the same register twice.
  let ivs4 = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 5, 12, true)]
  let r4 = allocateCoalesced(mkRegs(2, 0), ivs4, [9], []int(0), [0, 0])
  assert(len(r4.stackMaps[0].regs) == 1, "a shared live reference is reported exactly once")
  assert(r4.stackMaps[0].regs[0] == r4.locations[1].index)

  // Inertness pin: identity roots must allocate exactly as an empty roots array
  // does, which is exactly as `allocate` did before this parameter existed.
  let r5 = allocateCoalesced(mkRegs(2, 0), ivs, []int(0), []int(0), [0, 1])
  assert(r5.locations[0].index != r5.locations[1].index || r5.locations[1].isSpill)
  let r6 = allocate(mkRegs(2, 0), ivs, []int(0), []int(0))
  assert(r5.locations[0].index == r6.locations[0].index && r5.locations[1].index == r6.locations[1].index)
}
