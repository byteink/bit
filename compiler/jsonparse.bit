// Self-host JSON recursive-descent parser (#1595). Sibling of json.bit (same
// module); named to sort AFTER json.bit so the JsonValue/JsonDoc types and the
// helpers it leans on (utf8Append, hexDigitVal from lower.bit) are lowered
// first. Tolerant enough for LSP JSON-RPC messages: on any malformation it sets
// `ok = false` and returns what it had, mirroring the seed's `catch` recovery.

// Parse cursor over `src`, accumulating nodes into `nodes` (arena; children are
// referenced by id). A class is a reference, so functions that append to
// `nodes` or advance `pos` mutate the shared parser.
class JsonParser {
  src: string,
  pos: int,
  ok: bool,
  nodes: []JsonValue,
}

// Parses one JSON document. `ok` is false if the source is malformed or has
// trailing non-whitespace after the top-level value.
fn jsonParse(src: string): JsonDoc {
  let p = JsonParser{ src: src, pos: 0, ok: true, nodes: []JsonValue(0) }
  jsonSkipWs(p)
  let root = jsonParseValue(p, 0)
  jsonSkipWs(p)
  if (p.pos != len(p.src)) {
    p.ok = false
  }
  return JsonDoc{ nodes: p.nodes, root: root, ok: p.ok }
}

// Appends `v` and returns its id.
fn jsonAddNode(p: JsonParser, v: JsonValue): int {
  let id = len(p.nodes)
  p.nodes = append(p.nodes, v)
  return id
}

// A fresh leaf with all slice fields empty.
fn jsonLeaf(k: JsonKind): JsonValue {
  return JsonValue{ kind: k, boolVal: false, numRaw: "", strVal: "",
    keys: []string(0), items: []int(0) }
}

fn jsonSkipWs(p: JsonParser) {
  while (p.pos < len(p.src)) {
    let c = p.src[p.pos]
    if (c == u8(0x20) || c == u8(0x09) || c == u8(0x0A) || c == u8(0x0D)) {
      p.pos = p.pos + 1
    } else {
      return
    }
  }
}

// Consumes the literal `lit` at the cursor, advancing past it; false (no
// advance) if it does not match.
fn jsonMatchLit(p: JsonParser, lit: string): bool {
  if (p.pos + len(lit) > len(p.src)) {
    return false
  }
  let i = 0
  while (i < len(lit)) {
    if (p.src[p.pos + i] != lit[i]) {
      return false
    }
    i = i + 1
  }
  p.pos = p.pos + len(lit)
  return true
}

// Parses one value at the cursor (leading whitespace skipped), returning its
// node id or -1 on failure.
// `depth` counts container nesting (array/object) already entered to reach
// this value; a document 64 levels deep or more is rejected rather than
// recursed into, so a hostile or accidental `[[[[...` cannot exhaust the
// stack (Power of 10 rule 2). Matches `irTypeNameDepth`'s cap (ir.bit).
const jsonMaxDepth: int = 64

fn jsonParseValue(p: JsonParser, depth: int): int {
  jsonSkipWs(p)
  if (p.pos >= len(p.src)) {
    p.ok = false
    return -1
  }
  if (depth >= jsonMaxDepth) {
    p.ok = false
    return -1
  }
  let c = p.src[p.pos]
  if (c == u8('{')) {
    return jsonParseObject(p, depth)
  }
  if (c == u8('[')) {
    return jsonParseArray(p, depth)
  }
  if (c == u8('"')) {
    return jsonParseString(p)
  }
  if (c == u8('t') || c == u8('f')) {
    return jsonParseBool(p)
  }
  if (c == u8('n')) {
    return jsonParseNull(p)
  }
  if (c == u8('-') || (c >= u8('0') && c <= u8('9'))) {
    return jsonParseNumber(p)
  }
  p.ok = false
  return -1
}

fn jsonParseNull(p: JsonParser): int {
  if (jsonMatchLit(p, "null")) {
    return jsonAddNode(p, jsonLeaf(JsonKind.Null))
  }
  p.ok = false
  return -1
}

fn jsonParseBool(p: JsonParser): int {
  if (jsonMatchLit(p, "true")) {
    let v = jsonLeaf(JsonKind.Bool)
    v.boolVal = true
    return jsonAddNode(p, v)
  }
  if (jsonMatchLit(p, "false")) {
    return jsonAddNode(p, jsonLeaf(JsonKind.Bool))
  }
  p.ok = false
  return -1
}

// A JSON number (RFC 8259 §6): optional `-`, int part, optional fraction,
// optional exponent. The whole span is stored raw so stringify re-emits it
// verbatim and int reads truncate it.
fn jsonParseNumber(p: JsonParser): int {
  let start = p.pos
  if (p.pos < len(p.src) && p.src[p.pos] == u8('-')) {
    p.pos = p.pos + 1
  }
  jsonSkipDigits(p)
  if (p.pos < len(p.src) && p.src[p.pos] == u8('.')) {
    p.pos = p.pos + 1
    jsonSkipDigits(p)
  }
  if (p.pos < len(p.src) && (p.src[p.pos] == u8('e') || p.src[p.pos] == u8('E'))) {
    p.pos = p.pos + 1
    if (p.pos < len(p.src) && (p.src[p.pos] == u8('+') || p.src[p.pos] == u8('-'))) {
      p.pos = p.pos + 1
    }
    jsonSkipDigits(p)
  }
  let v = jsonLeaf(JsonKind.Num)
  v.numRaw = p.src[start:p.pos]
  return jsonAddNode(p, v)
}

fn jsonSkipDigits(p: JsonParser) {
  while (p.pos < len(p.src) && p.src[p.pos] >= u8('0') && p.src[p.pos] <= u8('9')) {
    p.pos = p.pos + 1
  }
}

fn jsonParseString(p: JsonParser): int {
  let s = jsonScanString(p)
  let v = jsonLeaf(JsonKind.Str)
  v.strVal = s
  return jsonAddNode(p, v)
}

// Consumes a `"..."` token from the opening quote and returns its DECODED value.
// On malformation sets `ok = false` and returns what was decoded so far.
fn jsonScanString(p: JsonParser): string {
  let out = ""
  p.pos = p.pos + 1
  while (p.pos < len(p.src)) {
    let c = p.src[p.pos]
    if (c == u8('"')) {
      p.pos = p.pos + 1
      return out
    }
    if (c == u8(0x5C)) {
      p.pos = p.pos + 1
      if (p.pos >= len(p.src)) {
        p.ok = false
        return out
      }
      let e = p.src[p.pos]
      if (e == u8('u')) {
        out = jsonScanUnicode(p, out)
      } else {
        out = jsonDecodeSimple(p, out, e)
      }
    } else {
      out = out + p.src[p.pos:p.pos + 1]
      p.pos = p.pos + 1
    }
  }
  p.ok = false
  return out
}

// Decodes a one-letter escape `\<e>` (cursor at `e`), advancing past it. An
// unknown escape sets `ok = false`.
fn jsonDecodeSimple(p: JsonParser, out: string, e: u8): string {
  p.pos = p.pos + 1
  if (e == u8('"')) {
    return out + "\""
  }
  if (e == u8(0x5C)) {
    return out + "\\"
  }
  if (e == u8('/')) {
    return out + "/"
  }
  if (e == u8('b')) {
    return utf8Append(out, 0x08)
  }
  if (e == u8('f')) {
    return utf8Append(out, 0x0C)
  }
  if (e == u8('n')) {
    return out + "\n"
  }
  if (e == u8('r')) {
    return out + "\r"
  }
  if (e == u8('t')) {
    return out + "\t"
  }
  p.ok = false
  return out
}

// Decodes a `\uXXXX` escape (cursor at `u`), combining a UTF-16 surrogate pair
// into one codepoint. A lone or malformed surrogate sets `ok = false`.
fn jsonScanUnicode(p: JsonParser, out: string): string {
  p.pos = p.pos + 1
  let cp = jsonRead4Hex(p)
  if (cp < 0) {
    p.ok = false
    return out
  }
  if (cp >= 0xD800 && cp <= 0xDBFF) {
    if (p.pos + 1 < len(p.src) && p.src[p.pos] == u8(0x5C) && p.src[p.pos + 1] == u8('u')) {
      p.pos = p.pos + 2
      let lo = jsonRead4Hex(p)
      if (lo >= 0xDC00 && lo <= 0xDFFF) {
        return utf8Append(out, 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00))
      }
    }
    p.ok = false
    return out
  }
  if (cp >= 0xDC00 && cp <= 0xDFFF) {
    p.ok = false
    return out
  }
  return utf8Append(out, cp)
}

// Reads exactly four hex digits at the cursor, advancing past them; -1 (no
// advance guarantee) on a non-hex digit or short input.
fn jsonRead4Hex(p: JsonParser): int {
  if (p.pos + 4 > len(p.src)) {
    return -1
  }
  let v = 0
  let i = 0
  while (i < 4) {
    let h = hexDigitVal(p.src[p.pos])
    if (h < 0) {
      return -1
    }
    v = v * 16 + h
    p.pos = p.pos + 1
    i = i + 1
  }
  return v
}

fn jsonParseArray(p: JsonParser, depth: int): int {
  p.pos = p.pos + 1
  let items = []int(0)
  jsonSkipWs(p)
  if (p.pos < len(p.src) && p.src[p.pos] == u8(']')) {
    p.pos = p.pos + 1
    let v = jsonLeaf(JsonKind.Arr)
    return jsonAddNode(p, v)
  }
  while (p.ok) {
    let elem = jsonParseValue(p, depth + 1)
    if (!p.ok) {
      return -1
    }
    items = append(items, elem)
    jsonSkipWs(p)
    if (p.pos >= len(p.src)) {
      p.ok = false
      return -1
    }
    let c = p.src[p.pos]
    if (c == u8(']')) {
      p.pos = p.pos + 1
      let v = jsonLeaf(JsonKind.Arr)
      v.items = items
      return jsonAddNode(p, v)
    }
    if (c != u8(',')) {
      p.ok = false
      return -1
    }
    p.pos = p.pos + 1
  }
  return -1
}

fn jsonParseObject(p: JsonParser, depth: int): int {
  p.pos = p.pos + 1
  let keys = []string(0)
  let items = []int(0)
  jsonSkipWs(p)
  if (p.pos < len(p.src) && p.src[p.pos] == u8('}')) {
    p.pos = p.pos + 1
    let v = jsonLeaf(JsonKind.Obj)
    return jsonAddNode(p, v)
  }
  while (p.ok) {
    jsonSkipWs(p)
    if (p.pos >= len(p.src) || p.src[p.pos] != u8('"')) {
      p.ok = false
      return -1
    }
    let key = jsonScanString(p)
    if (!p.ok) {
      return -1
    }
    jsonSkipWs(p)
    if (p.pos >= len(p.src) || p.src[p.pos] != u8(':')) {
      p.ok = false
      return -1
    }
    p.pos = p.pos + 1
    let val = jsonParseValue(p, depth + 1)
    if (!p.ok) {
      return -1
    }
    keys = append(keys, key)
    items = append(items, val)
    jsonSkipWs(p)
    if (p.pos >= len(p.src)) {
      p.ok = false
      return -1
    }
    let c = p.src[p.pos]
    if (c == u8('}')) {
      p.pos = p.pos + 1
      let v = jsonLeaf(JsonKind.Obj)
      v.keys = keys
      v.items = items
      return jsonAddNode(p, v)
    }
    if (c != u8(',')) {
      p.ok = false
      return -1
    }
    p.pos = p.pos + 1
  }
  return -1
}
