// In-Bit self-checks for #7750: an inline-asm `input` is built straight into
// its own pinned register, never through the emitter's scratch.
//
// emitAsm/xEmitAsm used to load every input with the scratch register as the
// build target. A value not in a register (a rematerialized constant, a spill
// reload) was built IN the scratch, and when an earlier input was pinned to
// that same scratch (x9 on arm64, r11 on x64) the later build overwrote it.
// runtime/park/linux/vdso.bit `parkVdsoCall` pins `x9 = fnp` ahead of
// `x0 = clock`; once #7706 made `clock` a rematerialized constant, `blr x9`
// jumped to 0x1 and every aarch64-linux program died at startup.
//
// Same module as selfcheck.bit (#1503).

// One asm block with the payload's single nop word/byte and inputs pinned to
// `pins`, installed on a context's module.
fn asmInputsBlock(x64Pins: []int, arm64Pins: []int): []AsmBlock {
  return [
    AsmBlock{
      x64Bytes = [0x90], arm64Words = [0xD503201F], hasResult = false,
      resultX64 = 0, resultArm64 = 0, inX64 = x64Pins, inArm64 = arm64Pins,
      clobX64 = []int(0), clobArm64 = []int(0),
    },
  ]
}

fn checkArm64AsmInputs() {
  // vreg 3 lives in x3; vreg 2 is a spilled one-word constant. `x9 <- x3` then
  // `x0 <- #1`: the constant is built in x0, and x9 is written exactly once.
  let cx = rematCtx()
  cx.module.asmBlocks = asmInputsBlock([3, 7], [9, 0])
  cx.f.instrs[2] = mkInstr(Op.ConstInt, 0)
  cx.f.instrs[2].ival = 1
  emitAsm(cx, -1, 0, [3, 2])
  let want = newByteBuf()
  movRR(want, 9, 3)
  movImm64(want, 0, 1)
  emitWord(want, 0xD503201F)
  assertSameBytes(cx.code, want)
  assert(
    wordsNaming(cx.code, scratch1(), 0, len(cx.code.bytes) / 4) == 1,
    "x9 must be written once",
  )

  // The far-spill reload addresses its slot through x11, so an input pinned to
  // x11 is bound after the others: `x11 <- far slot` first would be clobbered
  // by the `mov x11, #disp` that reloads `x0`.
  let cf = farSpillCtx()
  cf.module.asmBlocks = asmInputsBlock([3, 7], [11, 0])
  emitAsm(cf, -1, 0, [2, 1])
  let wf = newByteBuf()
  loadImm(wf, 0, regSp(), 16 + 4201 * 8, 8, false)
  loadImm(wf, scratch3(), regSp(), 16 + 4200 * 8, 8, false)
  emitWord(wf, 0xD503201F)
  assertSameBytes(cf.code, wf)
}

fn checkX64AsmInputs() {
  // vreg 0 lives in rbx; vreg 1 is a slotless constant. `r11 <- rbx` then
  // `rdi <- 1`: the constant is built in rdi, not through r11.
  let cx = xCallTestCtx()
  cx.module.asmBlocks = asmInputsBlock([11, 7], [9, 0])
  let k = mkInstr(Op.ConstInt, 0)
  k.ival = 1
  cx.f.instrs = [mkInstr(Op.BlockParam, 0), k]
  cx.alloc.locations = [
    RegLoc{ isSpill = false, index = 0 },
    RegLoc{ isSpill = true, index = -1 },
  ]
  xEmitAsm(cx, -1, 0, [0, 1])
  let want = newX64Buf()
  xMovRR(want, XReg64.R11, XReg64.Rbx)
  xMovRI(want, XReg64.Rdi, 1)
  xEmitByte(want, 0x90)
  assert(xHex(cx.buf) == xHex(want), "r11 must hold the first input at the nop")
}
