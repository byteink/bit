// compiler/projectparsecache.bit — the language server's parse reuse (#2348), split
// out of project.bit (800-line ceiling, spec/LINT.md).

// The tree a previous build of this process parsed for `canon`, when this build
// read the SAME file names and the SAME concatenated bytes for that directory —
// which makes `parseSourceD(source, ...)` a call whose answer is already known.
// `reused` false means "parse it"; the returned tree is then a placeholder the
// caller overwrites (Bit has no zero value for a class, §13.4).
//
// Both halves of the key are checked, not just the source: a directory whose
// files were RENAMED with no net text change would otherwise reuse a tree whose
// `fileStarts`/`fileNames` name the old layout, and every span in it would
// render against the wrong file.
fn cachedModuleTree(
  lw: Loader, canon: string, source: string,
  fileNames: []string,
): (Tree, bool) {
  let (cached, inCache) = lw.parseCache[canon]
  if (!inCache) {
    return newTree(), false
  }
  // A module synthesis touched holds a tree with the synthesized members
  // already in it, and the synthesis pass would add them a second time.
  if (len(cached.source) != cached.rawLen ||
    cached.source != source ||
    !strListEqual(cached.fileNames, fileNames)) {
    return newTree(), false
  }
  return cached.tree, true
}
