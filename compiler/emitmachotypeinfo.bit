fn emMachoTypeOffsetWords(rodata: ByteBuf, t: TypeInfoLayout): int {
  emPadTo8(rodata)
  let offsOff = len(rodata.bytes)
  let k = 0
  while (k < len(t.ptrOffsets)) {
    appendU64(rodata, t.ptrOffsets[k])
    k = k + 1
  }
  return offsOff
}

fn emMachoAppendTypeSymbol(acc: EmMachoDbgLines, symbol: MachoSymbol) {
  acc.symbols = append(acc.symbols, symbol)
}

fn emMachoTypeMethodRelocs(methods: EmittedMethods, acc: EmMachoDbgLines) {
  let relocs = acc.relocs
  let mr = 0
  while (mr < len(methods.relocs)) {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = methods.relocs[mr].off, symbol = emMac(methods.relocs[mr].sym),
        kind = MachoRelocKind.Unsigned64,
      },
    )
    mr = mr + 1
  }
  acc.relocs = relocs
}

fn emMachoTypeInfoRelocs(
  acc: EmMachoDbgLines, tiOff: int, offsetIndex: int, displayIndex: int, methodIndex: int,
) {
  let relocs = acc.relocs
  if (offsetIndex >= 0) {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = tiOff + 8, symbol = acc.symbols[offsetIndex].name, kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  if (displayIndex >= 0) {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = tiOff + 24, symbol = acc.symbols[displayIndex].name, kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  if (methodIndex >= 0) {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = tiOff + 40, symbol = acc.symbols[methodIndex].name, kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  acc.relocs = relocs
}

fn emMachoTypeOne(
  module: IrModule, rodata: ByteBuf, data: ByteBuf, t: TypeInfoLayout, acc: EmMachoDbgLines,
): EmMachoDbgLines {
  let name = typeInfoSymbol(t.disc, t.size, t.ptrOffsets)
  let offsetIndex = -1
  let offsName = ""
  if (len(t.ptrOffsets) > 0) {
    let offsOff = emMachoTypeOffsetWords(rodata, t)
    offsName = emMac(name + "_offs")
    offsetIndex = len(acc.symbols)
    let offsetSymbol = MachoSymbol{
      name = offsName, hasSection = true,
      section = MachoSectionKind.Rodata, offset = offsOff,
      size = len(t.ptrOffsets) * 8, binding = MachoBinding.Local,
    }
    emMachoAppendTypeSymbol(acc, offsetSymbol)
    acc.defined[offsName] = true
  }
  let tname = ""
  if (module.ctx.types[t.disc].hasName) {
    tname = module.ctx.types[t.disc].name
  }
  let displayIndex = -1
  let nameSym = ""
  if (len([]byte(tname)) > 0) {
    let nmOff = len(rodata.bytes)
    appendBytes(rodata, []byte(tname))
    nameSym = emMac(name + "_name")
    displayIndex = len(acc.symbols)
    let displaySymbol = MachoSymbol{
      name = nameSym, hasSection = true,
      section = MachoSectionKind.Rodata, offset = nmOff, size = len([]byte(tname)),
      binding = MachoBinding.Local,
    }
    emMachoAppendTypeSymbol(acc, displaySymbol)
    acc.defined[nameSym] = true
  }
  let methods = emitMethodTable(module, data, t.disc, name)
  let methodIndex = -1
  let methodsName = ""
  if (methods.sym != "") {
    methodsName = emMac(methods.sym)
    methodIndex = len(acc.symbols)
    let methodSymbol = MachoSymbol{
      name = methodsName, hasSection = true,
      section = MachoSectionKind.Data, offset = methods.off, size = methods.size,
      binding = MachoBinding.Local,
    }
    emMachoAppendTypeSymbol(acc, methodSymbol)
    acc.defined[methodsName] = true
    emMachoTypeMethodRelocs(methods, acc)
  }
  let tiOff = emTypeInfoWords(data, t, len([]byte(tname)), methods.size / 16)
  let tiName = emMac(name)
  emMachoAppendTypeSymbol(
    acc,
    MachoSymbol{
      name = tiName, hasSection = true,
      section = MachoSectionKind.Data, offset = tiOff, size = emTypeInfoBytes,
      binding = MachoBinding.Global,
    },
  )
  acc.defined[tiName] = true
  emMachoTypeInfoRelocs(acc, tiOff, offsetIndex, displayIndex, methodIndex)
  return acc
}

fn emMachoTypeInfos(
  module: IrModule, rodata: ByteBuf, data: ByteBuf, freestanding: bool, acc: EmMachoDbgLines,
): EmMachoDbgLines {
  let tis = collectTypeInfos(module, freestanding)
  let ti = 0
  while (ti < len(tis)) {
    acc = emMachoTypeOne(module, rodata, data, tis[ti], acc)
    ti = ti + 1
  }
  return acc
}

