fn emMachoTypeOffsets(
  rodata: ByteBuf, t: TypeInfoLayout, name: string, acc: EmMachoDbgLines,
): (string, EmMachoDbgLines) {
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  let offsName = ""
  if (len(t.ptrOffsets) > 0) {
    emPadTo8(rodata)
    let offsOff = len(rodata.bytes)
    let k = 0
    while (k < len(t.ptrOffsets)) {
      appendU64(rodata, t.ptrOffsets[k])
      k = k + 1
    }
    offsName = emMac(name + "_offs")
    symbols = append(
      symbols,
      MachoSymbol{
        name = offsName, hasSection = true,
        section = MachoSectionKind.Rodata, offset = offsOff,
        size = len(t.ptrOffsets) * 8, binding = MachoBinding.Local,
      },
    )
    defined[offsName] = true
  }
  return (offsName, EmMachoDbgLines{ symbols = symbols, relocs = relocs, defined = defined })
}

fn emMachoTypeName(
  module: IrModule, rodata: ByteBuf, t: TypeInfoLayout, name: string, acc: EmMachoDbgLines,
): (string, string, EmMachoDbgLines) {
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  // The type's display name. The seed reads a display_names side table; this
  // port keeps the name on the Type itself.
  let tname = ""
  if (module.ctx.types[t.disc].hasName) {
    tname = module.ctx.types[t.disc].name
  }
  let nameSym = ""
  if (len([]byte(tname)) > 0) {
    let nmOff = len(rodata.bytes)
    appendBytes(rodata, []byte(tname))
    nameSym = emMac(name + "_name")
    symbols = append(
      symbols,
      MachoSymbol{
        name = nameSym, hasSection = true,
        section = MachoSectionKind.Rodata, offset = nmOff, size = len([]byte(tname)),
        binding = MachoBinding.Local,
      },
    )
    defined[nameSym] = true
  }
  return (tname, nameSym, EmMachoDbgLines{ symbols = symbols, relocs = relocs, defined = defined })
}

fn emMachoTypeMethods(
  module: IrModule, data: ByteBuf, t: TypeInfoLayout, name: string, acc: EmMachoDbgLines,
): (string, int, EmMachoDbgLines) {
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  // The method table holds absolute fn pointers, so it lives in writable
  // __data too.
  let methods = emitMethodTable(module, data, t.disc, name)
  let methodsName = ""
  if (methods.sym != "") {
    methodsName = emMac(methods.sym)
    symbols = append(
      symbols,
      MachoSymbol{
        name = methodsName, hasSection = true,
        section = MachoSectionKind.Data, offset = methods.off, size = methods.size,
        binding = MachoBinding.Local,
      },
    )
    defined[methodsName] = true
    let mr = 0
    while (mr < len(methods.relocs)) {
      relocs = append(
        relocs,
        MachoRelocation{
          section = MachoSectionKind.Data,
          offset = methods.relocs[mr].off, symbol = emMac(methods.relocs[mr].sym),
          kind = MachoRelocKind.Unsigned64,
        },
      )
      mr = mr + 1
    }
  }

  return (
    methodsName,
    methods.size,
    EmMachoDbgLines{ symbols = symbols, relocs = relocs, defined = defined },
  )
}

fn emMachoTypeOne(
  module: IrModule, rodata: ByteBuf, data: ByteBuf, t: TypeInfoLayout, acc: EmMachoDbgLines,
): EmMachoDbgLines {
  let name = typeInfoSymbol(t.disc, t.size, t.ptrOffsets)
  let (offsName, acc1) = emMachoTypeOffsets(rodata, t, name, acc)
  let (tname, nameSym, acc2) = emMachoTypeName(module, rodata, t, name, acc1)
  let (methodsName, methodsSize, acc3) = emMachoTypeMethods(module, data, t, name, acc2)
  let symbols = acc3.symbols
  let relocs = acc3.relocs
  let defined = acc3.defined
  let tiOff = emTypeInfoWords(data, t, len([]byte(tname)), methodsSize / 16)
  let tiName = emMac(name)
  symbols = append(
    symbols,
    MachoSymbol{
      name = tiName, hasSection = true,
      section = MachoSectionKind.Data, offset = tiOff, size = emTypeInfoBytes,
      binding = MachoBinding.Global,
    },
  )
  defined[tiName] = true
  if (len(t.ptrOffsets) > 0) {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = tiOff + 8, symbol = offsName, kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  if (nameSym != "") {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = tiOff + 24, symbol = nameSym, kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  if (methodsName != "") {
    relocs = append(
      relocs,
      MachoRelocation{
        section = MachoSectionKind.Data,
        offset = tiOff + 40, symbol = methodsName, kind = MachoRelocKind.Unsigned64,
      },
    )
  }
  return EmMachoDbgLines{ symbols = symbols, relocs = relocs, defined = defined }
}

fn emMachoTypeInfos(
  module: IrModule, rodata: ByteBuf, data: ByteBuf, freestanding: bool, acc: EmMachoDbgLines,
): EmMachoDbgLines {
  let tis = collectTypeInfos(module, freestanding)
  let ti = 0
  while (ti < len(tis)) {
    acc = emMachoTypeOne(module, rodata, data, tis[ti], acc)
    ti = ti + 1
  }
  return acc
}

