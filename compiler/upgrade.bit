// compiler/upgrade.bit — `bit upgrade`, the self-update verb (#4329, asked for
// on GitHub issue #2).
//
// TWO INSTALL METHODS, ONE OF WHICH THIS MUST NOT FIGHT. A `bit` that came
// from `brew install byteink/tap/bit` is a file Homebrew owns and records: an
// upgrade that replaced it in place would leave brew's metadata describing a
// version that is no longer on disk, and the next `brew upgrade` would undo
// the change. So a Homebrew install is REFUSED here, naming the command that
// does the job, and nothing is downloaded.
//
// The replacing itself is `dist/upgrade.sh`, executed by `upgradeCmd` below:
// it downloads the artifact, verifies it against the release's `SHA256SUMS`,
// unpacks it beside the current install and renames the `bin/bit` symlink over
// atomically. That work is shell because its sibling `dist/install.sh` already
// is — one copy of the download/verify/unpack contract, not two that drift.
// What lives HERE is the refusal and finding the script; what the script does
// is documented in its own header.

// The directories a Homebrew-installed binary lives under. `brew --prefix` is
// `$HOMEBREW_PREFIX` when brew set it (brew exports it for everything it runs
// and for shells it has been `shellenv`-ed into), and otherwise one of the two
// fixed defaults: `/opt/homebrew` on Apple Silicon, `/usr/local` on Intel.
// Both fixed spellings are always tested, so detection does not depend on the
// environment a user happens to have.
//
// It is the CELLAR that identifies an install, not the prefix: `brew` links
// `<prefix>/bin/bit` as a symlink into the keg under `<prefix>/Cellar/bit/` —
// today `/opt/homebrew/bin/bit -> /opt/homebrew/Cellar/bit/0.14.0/libexec/bin/bit`
// on this tap, which is why the Cellar prefix rather than the keg shape is
// what gets tested —
// and a resolved real path (`osSelfExe`, the primitive `resolveNearExe`
// (mainpaths.bit) leans on for the same reason) is always the Cellar one.
fn homebrewCellars(): []string {
  let out = []string(0)
  let prefix = envOr("HOMEBREW_PREFIX", "")
  if (len(prefix) > 0) {
    out = append(out, "${prefix}/Cellar/")
  }
  out = append(out, "/opt/homebrew/Cellar/")
  out = append(out, "/usr/local/Cellar/")
  return out
}

// Whether `exe` — a path with its symlinks already resolved — is a binary
// Homebrew owns.
fn isHomebrewExe(exe: string): bool {
  if (len(exe) == 0) {
    return false
  }
  for cellar of homebrewCellars() {
    if (startsWith(exe, cellar)) {
      return true
    }
  }
  return false
}

// `dist/upgrade.sh` as it is reachable from THIS binary, or "" when it is not.
//
// A release artifact carries it at `<prefix>/libexec/upgrade.sh`
// (`dist/package.sh`, `dist/README.md`'s layout), found the same way the
// shipped stdlib is — relative to the running binary, not the cwd
// (`resolveNearExe`, mainpaths.bit). The repo-relative fallback is for a
// build-tree compiler, which has no `libexec` at all; it mirrors
// `stdRootPath`'s own dev-tree fallback rather than inventing a second rule.
fn upgradeScriptPath(): string {
  let shipped = resolveNearExe("libexec/upgrade.sh")
  if (len(shipped) > 0) {
    return shipped
  }
  if (fsExists("dist/upgrade.sh")) {
    return "dist/upgrade.sh"
  }
  return ""
}

// `bit upgrade [--check]`. Returns the process exit code; `--check` reports
// what an upgrade would do and changes nothing.
//
// The flags are already validated by the time this runs (`cliSpecs`, cli.bit),
// so `--check` is the only thing to look for here.
fn upgradeCmd(a: []string): int {
  let exe = selfExe()
  if (isHomebrewExe(exe)) {
    eprint("bit upgrade: this bit was installed by Homebrew; run: brew upgrade byteink/tap/bit\n")
    return 1
  }
  let script = upgradeScriptPath()
  if (len(script) == 0) {
    eprint("bit upgrade: upgrade.sh not found beside this binary (expected libexec/upgrade.sh in the install)\n")
    return 1
  }
  let argv = [script]
  let i = 2
  while (i < len(a)) {
    if (a[i] == "--check") {
      argv = append(argv, "--check")
    }
    i = i + 1
  }
  let code = int(osRun("/bin/sh", argv))
  if (code < 0) {
    eprint("bit upgrade: could not run /bin/sh ${script}\n")
    return 1
  }
  return code
}
