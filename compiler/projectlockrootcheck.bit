// #6299 (M1a): `loadProjectCached`'s `lockRoot` parameter. Split out of
// projectcheck.bit (same module, sibling .bit file) to keep that file under
// spec/LINT.md's 800-line ceiling rather than growing it further.
//
// Motivating shape (data-packages-dx.md "Package commands"): `bit migrate`
// generates `.bit/cmd/migrate/main.bit` inside the project, importing a
// package the project locked in its OWN `bit.lock` — but the generated
// entry's directory is not the project root, so a bare `loadProjectCached`
// (which reads `<rootDir>/bit.lock`) would report the package undeclared.
// This proves the opposite: an entry point that sits well below the lock
// file still resolves an import locked only in that ancestor's bit.lock,
// once `lockRoot` names it explicitly.

// Builds `<root>/proj/bit.lock` locking "pkg" to the local directory
// `<root>/localpkg` (a sibling of `proj`), then loads the entry point at
// `<root>/proj/.bit/cmd/migrate/main.bit` — three directories below
// `proj`, where `bit.lock` actually lives — passing `proj` as `lockRoot`.
// The import must resolve to `localpkg` exactly as it would for an entry
// point sitting in `proj` itself.
fn checkProjectLoadModuleLockRootResolvesAncestorLock() {
  let root = pmCheckScratchDir()

  let pkgDir = root + "/localpkg"
  pmCheckMkdirAll(pkgDir)
  writeFile(
    pkgDir + "/greet.bit",
    "export fn greet(): string {\n  return \"hi from local pkg\"\n}\n",
  ) catch e {
    panic("projectlockrootcheck: cannot write local pkg module: " + e.message())
  }

  let projDir = root + "/proj"
  pmCheckMkdirAll(projDir)
  // `pkgDir` (`root/localpkg`) is a sibling of `projDir` (`root/proj`) —
  // the same relative shape `checkProjectPackageImportsLocalPath` locks,
  // so this exercises nothing new about `localPath` resolution itself,
  // only which directory it is resolved AGAINST.
  writeLock(
    projDir + "/bit.lock",
    [LockEntry{ name = "pkg", localPath = "../localpkg", requires = []LockRequire(0) }],
  ) catch e {
    panic("projectlockrootcheck: writeLock failed: " + e.message())
  }

  let entryDir = projDir + "/.bit/cmd/migrate"
  pmCheckMkdirAll(entryDir)
  writeFile(
    entryDir + "/main.bit",
    "import { greet } from \"pkg\"\nfn main() {\n  print(greet())\n}\n",
  ) catch e {
    panic("projectlockrootcheck: cannot write main.bit: " + e.message())
  }

  let p = loadProjectCached(entryDir, "", "", emptyLoaderIncremental(), projDir)
  assert(p.root >= 0)
  let mods = resolveProject(p)
  checkResolved(p, mods)
  assert(!hasErrors(p.diags))
  let rootMod = p.mods[p.root]
  let (pkgModId, hasPkg) = rootMod.imports["pkg"]
  assert(hasPkg && pkgModId >= 0)
  assert(p.mods[pkgModId].dir == pathResolve(pkgDir))

  removeTree(root, pmCheckTimeoutMs)
}
