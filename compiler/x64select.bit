// Self-host Stage 3 (#1346): the x86-64 backend, per-value selectors.
// Split out of compiler/x64.bit; same module, so nothing here is imported.
//
// compiler/x64selectmem.bit holds the memory-access selectors (field/array
// access, the atomics) split out of this file at 796 lines against the
// 800-line limit (#3141).

// ---------------------------------------------------------------------------
// Width canonicalization
// ---------------------------------------------------------------------------
//
// Every integer SSA value lives in a full 64-bit GPR held WIDTH-CANONICAL: the
// bits above its type width always match the type — zero for an unsigned type,
// a copy of the sign bit for a signed one. That is what lets every consumer
// (logical vs arithmetic shift, signed vs unsigned compare, division) read the
// register directly with no per-op masking.
//
// The invariant is restored at each definition site that can break it. Loads
// extend to width; narrow constants are in range by construction; and the ops
// that CAN push bits past the type width — add/sub/mul/shl, neg/bnot — re-narrow
// their result here. Bitwise and/or/xor and the right shifts carry canonical
// inputs to canonical outputs, so they add no mask. This is the SHA-256 /
// ChaCha20 prerequisite (#1158): without it a narrow add followed by a rotate
// leaks the overflow bits the add left above the type width.

// `movsx`/`movzx` through the 0F escape, register to register.
fn xExt0F(b: X64Buf, opcode: int, dst: XReg64, src: XReg64) {
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(dst)), false, xNeedsRexBit(xRegNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, opcode)
  xEmitByte(b, xModrmReg(xRegNum(dst), xRegNum(src)))
}

// Re-extends `reg` from `width` bytes to a canonical full 64 bits.
fn xExtendReg(b: X64Buf, reg: XReg64, width: int, signed: bool) {
  if (width == 1) {
    if (signed) {
      xExt0F(b, 0xBE, reg, reg)
    } else {
      xExt0F(b, 0xB6, reg, reg)
    }
    return
  }
  if (width == 2) {
    if (signed) {
      xExt0F(b, 0xBF, reg, reg)
    } else {
      xExt0F(b, 0xB7, reg, reg)
    }
    return
  }
  if (width == 4) {
    if (signed) {
      xMaybeRex(b, true, xNeedsRexBit(xRegNum(reg)), false, xNeedsRexBit(xRegNum(reg)))
      xEmitByte(b, 0x63) // movsxd r64, r/m32
      xEmitByte(b, xModrmReg(xRegNum(reg), xRegNum(reg)))
      return
    }
    // `mov r32, r/m32` zero-extends the low 32 bits into the full 64 for free —
    // no movzx needed, and REX.W would defeat the point by keeping all 64.
    xMaybeRex(b, false, xNeedsRexBit(xRegNum(reg)), false, xNeedsRexBit(xRegNum(reg)))
    xEmitByte(b, 0x8B)
    xEmitByte(b, xModrmReg(xRegNum(reg), xRegNum(reg)))
    return
  }
  // 8 bytes: the register width already equals the type width.
  assert(width == 8)
}

// Restores the width-canonical invariant for a freshly-computed result. A no-op
// at 64 bits and for floats, where register width already equals type width.
fn xCanonNarrow(b: X64Buf, reg: XReg64, w: Width) {
  if (w.regClass == RegClass.Int && w.bytes < 8) {
    xExtendReg(b, reg, w.bytes, w.signed)
  }
}

// ---------------------------------------------------------------------------
// Operand fetch and store
// ---------------------------------------------------------------------------
//
// Operands are fetched into scratch registers; the RESULT is computed straight
// into the destination's own register when the allocator gave it one, falling
// back to a scratch only when it is spilled — #3171 for floats (xFloatAcc),
// #3845 for integers (xIntAccMov). Routing every result through xScratch1 cost
// an extra `mov` per instruction: 20370 of the 92752 in the x86_64-linux
// libbitrt were a move to or from that one register.

fn xRegLocOf(cx: XCtx, vreg: int): RegLoc {
  assert(vreg >= 0 && vreg < len(cx.alloc.locations))
  return cx.alloc.locations[vreg]
}

// Reads `vreg` into a register: its own if it has one, else `scratch` after a
// reload from its spill slot. Returns whichever register now holds it.
fn xGetInt(cx: XCtx, vreg: int, scratch: XReg64): XReg64 {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    return cx.intRegs[loc.index]
  }
  xMovLoad(cx.buf, scratch, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), 8, false)
  return scratch
}

// Writes `src` to wherever `vreg` lives.
fn xPutInt(cx: XCtx, vreg: int, src: XReg64) {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    xMovRR(cx.buf, cx.intRegs[loc.index], src)
    return
  }
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), src, 8)
}

// The register an integer selector should compute `dst`'s value INTO: its own
// when the allocator gave it one, xScratch1 when it is spilled. Paired with
// xPutInt, which then emits nothing where `dst` has a register, since xMovRR
// elides a self-move. The integer twin of xFloatAcc (#3171).
//
// Bare xIntAcc has no precondition and so no assert: its callers write the
// accumulator with the very instruction that reads the operands (a load naming
// the base register, a setcc after its cmp, a cvt), and that read happens
// within the instruction — `mov %rax, (%rax)` is well defined. The one caller
// where that is NOT true, xEmitHeaderWordOrZero, stays on the scratch and says
// so.
fn xIntAcc(cx: XCtx, dst: int): XReg64 {
  let loc = xRegLocOf(cx, dst)
  if (loc.isSpill) {
    return xScratch1()
  }
  return cx.intRegs[loc.index]
}

// xIntAcc with `src` moved in first — the opening of every selector that
// computes in place from an operand it already fetched. `after1`/`after2` are
// the operand registers still to be READ once the accumulator holds `src`;
// pass xScratch1, never allocatable, when there are none. The move is what
// creates the hazard, so the guard is exactly "this move can destroy a later
// read": `acc == src` makes it encode nothing and is the BEST case, while
// `acc == rhs` with a different `src` is the miscompile this refuses.
fn xIntAccMov(cx: XCtx, dst: int, src: XReg64, after1: XReg64, after2: XReg64): XReg64 {
  let loc = xRegLocOf(cx, dst)
  if (loc.isSpill) {
    // A spilled destination accumulates in xScratch1, and the only value that
    // can already be there is a reload of `src` itself — xGetInt fetches a
    // spilled second operand through xScratch2. So no later read lives here.
    xMovRR(cx.buf, xScratch1(), src)
    return xScratch1()
  }
  let acc = cx.intRegs[loc.index]
  assert(acc == src || (acc != after1 && acc != after2))
  xMovRR(cx.buf, acc, src)
  return acc
}

fn xGetFloat(cx: XCtx, vreg: int, scratch: XmmReg): XmmReg {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    return cx.floatRegs[loc.index]
  }
  xMovFLoad(cx.buf, scratch, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), 8)
  return scratch
}

fn xPutFloat(cx: XCtx, vreg: int, src: XmmReg) {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    xMovFRR(cx.buf, cx.floatRegs[loc.index], src, 8)
    return
  }
  xMovFStore(cx.buf, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), src, 8)
}

// Where `vreg` lives, as the architecture-neutral PLoc the parallel-move
// sequencer works in. A spill becomes an rbp-relative offset.
fn xPlocOf(cx: XCtx, vreg: int, regClass: RegClass): PLoc {
  let loc = xRegLocOf(cx, vreg)
  if (loc.isSpill) {
    return plocMem(xSpillOffset(cx.frame, loc.index), regClass)
  }
  if (regClass == RegClass.Int) {
    return plocReg(xRegNum(cx.intRegs[loc.index]), regClass)
  }
  return plocReg(xmmNum(cx.floatRegs[loc.index]), regClass)
}

// ---------------------------------------------------------------------------
// Integer selectors
// ---------------------------------------------------------------------------

// Peeks whether `v` is a const_int, returning it as a `ConstVal` (opt.bit) —
// x86-64 counterpart of `xConstShiftAmount` (x64call.bit), which exists for
// the narrower non-negative shift-count case and cannot represent "not a
// constant" together with a full 64-bit value in one sentinel.
fn xConstIntOf(f: IrFunc, v: int): ConstVal {
  if (f.instrs[v].op != Op.ConstInt) {
    return noConst()
  }
  return intConst(f.instrs[v].ival)
}

// x86-64 ADD/SUB `r/m64, imm32` takes a SIGNED 32-bit immediate (`xArithImm32`,
// x64arith.bit) — unlike AArch64 there is no shifted form and no sign
// asymmetry to work around, so this is the whole range check.
fn fitsXArithImm32(val: int): bool {
  return val >= -2147483648 && val <= 2147483647
}

// Emits `dst = operand <op> imm` via a single group-1 immediate instruction —
// the fold this file exists for (#1853): a constant operand within imm32
// range needs no materializing `mov` into a second scratch register.
//
// `81 /digit id` (the group-1 immediate form `xArithImm32` emits) sets OF
// exactly like the register form does — the fold does not need to be bypassed
// in debug builds, unlike AArch64's ADDS/SUBS-immediate, whose shifted-imm12
// encoding a fold here would have to defeat (#3080/#3495 comment thread).
// Verified against the emitted bytes, not assumed: `checkX64OverflowTrap`
// below asserts the JO/JNO sequence appears immediately after the `81 /digit`
// bytes for the folded case exactly as it does for the register-register one.
fn xEmitArithImmInt(cx: XCtx, op: XArith, dst: int, operand: int, imm: int, w: Width) {
  let o = xGetInt(cx, operand, xScratch1())
  let acc = xIntAccMov(cx, dst, o, xScratch1(), xScratch1())
  xArithImm32(cx.buf, op, acc, imm)
  xMaybeOverflowTrap(cx, acc, w)
  xCanonNarrow(cx.buf, acc, w)
  xPutInt(cx, dst, acc)
}

// Same encoding shape as xEmitArithImmInt, for AND/OR/XOR (#3495), but
// WITHOUT its trailing xCanonNarrow: bitwise ops map canonical inputs to a
// canonical output (xEmitBinaryInt's own comment below), so re-narrowing an
// already-canonical result would be a dead instruction at any width < 8.
fn xEmitLogicalImmInt(cx: XCtx, op: XArith, dst: int, operand: int, imm: int) {
  let o = xGetInt(cx, operand, xScratch1())
  let acc = xIntAccMov(cx, dst, o, xScratch1(), xScratch1())
  xArithImm32(cx.buf, op, acc, imm)
  xPutInt(cx, dst, acc)
}

// Tries the ADD/SUB-immediate fold (#1853); true if it emitted, in which case
// the caller is done. Split out of xEmitBinaryInt so that function stays
// under the complexity ceiling now that a second fold (#3495, below) joined
// it — the two-way branch this used to be, plus a third op class, would not
// fit in one function at limit 10. Recomputes `w` from `dst` (the result's
// own instruction id) rather than taking it as a 6th parameter — `xEmitInst`'s
// `dst` is always the instruction being compiled, so `cx.f.instrs[dst].ty` is
// exactly the `w` the caller would otherwise have threaded through.
fn xTryAddSubImmFold(cx: XCtx, op: XArith, dst: int, lhs: int, rhs: int): bool {
  if (op != XArith.Add && op != XArith.Sub) {
    return false
  }
  let w = widthOf(cx.ctx, cx.f.instrs[dst].ty)
  let rc = xConstIntOf(cx.f, rhs)
  if (rc.known && fitsXArithImm32(rc.ival)) {
    xEmitArithImmInt(cx, op, dst, lhs, rc.ival, w)
    return true
  }
  // Add is commutative, so a leading literal (`32 + header`) folds the same
  // way with the operands swapped; Sub is not, so only its rhs is checked.
  if (op == XArith.Add) {
    let lc = xConstIntOf(cx.f, lhs)
    if (lc.known && fitsXArithImm32(lc.ival)) {
      xEmitArithImmInt(cx, op, dst, rhs, lc.ival, w)
      return true
    }
  }
  return false
}

// Tries the AND/OR/XOR-immediate fold (#3495); true if it emitted. And/Or/Xor
// are all commutative (unlike Sub), so either side may carry the constant;
// rhs is checked first, matching xLogicalConstSkip's own precedence
// (x64dispatch.bit's xComputeSkipConstMaterialize relies on the two agreeing
// exactly) — the group-1 `81 /digit id` form needs no NEW encoder, unlike
// AArch64's bitmask scheme: any imm32-range value already fits, so this
// reuses `xArithImm32`/`fitsXArithImm32` as-is.
fn xTryLogicalImmFold(cx: XCtx, op: XArith, dst: int, lhs: int, rhs: int): bool {
  if (op != XArith.And && op != XArith.Or && op != XArith.Xor) {
    return false
  }
  let rc = xConstIntOf(cx.f, rhs)
  if (rc.known && fitsXArithImm32(rc.ival)) {
    xEmitLogicalImmInt(cx, op, dst, lhs, rc.ival)
    return true
  }
  let lc = xConstIntOf(cx.f, lhs)
  if (lc.known && fitsXArithImm32(lc.ival)) {
    xEmitLogicalImmInt(cx, op, dst, rhs, lc.ival)
    return true
  }
  return false
}

// `dst = lhs <op> rhs` for the group-1 ALU ops.
fn xEmitBinaryInt(cx: XCtx, op: XArith, dst: int, lhs: int, rhs: int, w: Width) {
  if (xTryAddSubImmFold(cx, op, dst, lhs, rhs)) {
    return
  }
  if (xTryLogicalImmFold(cx, op, dst, lhs, rhs)) {
    return
  }
  let l = xGetInt(cx, lhs, xScratch1())
  let r = xGetInt(cx, rhs, xScratch2())
  let acc = xIntAccMov(cx, dst, l, r, r)
  xArithRR(cx.buf, op, acc, r)
  // add/sub can carry bits past the type width; the bitwise ops cannot — they
  // map canonical inputs to a canonical output, so they need no re-narrowing.
  if (op == XArith.Add || op == XArith.Sub) {
    xMaybeOverflowTrap(cx, acc, w)
    xCanonNarrow(cx.buf, acc, w)
  }
  xPutInt(cx, dst, acc)
}

// Which operand (if any) of a commutative And/Or/Xor is a known constant
// within imm32 range — used by xComputeSkipConstMaterialize
// (x64dispatch.bit) ONLY. It mirrors xEmitBinaryInt's own rhs-then-lhs
// precedence exactly, which the two MUST agree on: a constant this marks
// "skip materializing" that xEmitBinaryInt then reads as a register is a
// silent miscompile, the same hazard the ADD/SUB fold's shared
// `fitsXArithImm32` already avoids by having one definition, not two
// hand-synced copies.
fn xLogicalConstSkip(f: IrFunc, rhs: int, lhs: int): int {
  let rc = xConstIntOf(f, rhs)
  if (rc.known && fitsXArithImm32(rc.ival)) {
    return rhs
  }
  let lc = xConstIntOf(f, lhs)
  if (lc.known && fitsXArithImm32(lc.ival)) {
    return lhs
  }
  return -1
}

