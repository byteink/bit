// compiler/projectcli.bit — #3784: the "whole project" form of `bit check`,
// `bit fmt` and `bit test`, reached whenever the subcommand is given NO path
// operand. Owns exactly two things none of the three had before:
//
//   - an ANCHOR: `projectRootDir()` walks up from the current directory to
//     the nearest `bit.json`, reusing the same file `compiler/pmcli*.bit`
//     already treats as a project's identity, rather than inventing a
//     second notion of "project". No `bit.json` found -> the cwd itself, so
//     the verbs stay useful in a scratch directory (Bit's fs ABI has no
//     getcwd — `pmcliinit.bit` — so the walk stays relative throughout).
//   - a WALK that will not wander into `bit-out/` (the build driver's own
//     output), `dist/` (the release pipeline's own output tree, #4159) or
//     `vendor/` (a fetched dependency tree — walking `vendor/bit` would run
//     the COMPILER's own suite from inside a user's project).
//
// `bit test`'s own recursive module walk (`collectTestModules`, testrun.bit,
// #2247) already covers both #3779 test-file conventions — a `.test.bit`
// sibling is just another file in its module's directory, and a `_tests_/`
// subdirectory is a module of its own — so it is reused here for `bit check`
// too, and NOT reimplemented: the WALK is shared by both verbs via
// `testWalkSkipsDir`, even though "what counts as a module" is not identical
// — `checkProjectCmd` below passes `requireTestBitFile: false` (every module
// must be checked, tests or not), `bit test` passes `true` (#4253/#4253b).
// Every call from THIS file passes `skipVendor: true` — an explicit `bit
// test <dir>` must keep walking a literal `vendor/` subdirectory exactly as
// it always has (testrun.bit's own
// header explains why `vendor` is opt-in rather than unconditional).
//
// Every summary line below prints its count even when that count is zero —
// this project has been bitten often enough by a query that silently could
// not match (a lint sweep, an `otool | grep` for the wrong relocation name)
// that "ran and found nothing" must never look like a bare, unqualified
// "ok".

// Bit's fs ABI has no getcwd (#2262, `pmcliinit.bit`), so the walk stays
// relative: each step prepends another `..` rather than resolving an
// absolute path. Bounded (Power of 10 rule 2) the same way `maxWalkDepth`
// (stdlib/fs/fs.bit) bounds `std/fs.walk`'s recursion — a symlink loop or a
// pathological mount cannot turn this into an unbounded climb.
const maxProjectRootWalk = 64

// The nearest ancestor of the current directory (including it) that holds a
// `bit.json`, or "." (the cwd itself) when none does within
// `maxProjectRootWalk` levels.
fn projectRootDir(): string {
  let dir = "."
  let depth = 0
  while (depth < maxProjectRootWalk) {
    if (fsExists("${dir}/bit.json")) {
      return dir
    }
    if (dir == ".") {
      dir = ".."
    } else {
      dir = dir + "/.."
    }
    depth = depth + 1
  }
  return "."
}

// Every `.bit` file at or beneath `root`, dotted directories, `bit-out` and
// `dist` excluded unconditionally (`testWalkSkipsDir`, testrun.bit) — the
// FILE-grained counterpart of `collectTestModules`'s directory-grained walk:
// `bit fmt`/`bit lint` ask "how many files", where `bit check`/`bit test` ask
// "how many modules", so this collects leaves rather than module
// directories. Shares `dirEntryNames`/`testWalkIsRealDir`/`sortStrings`/
// `listBitFiles` with that walk rather than re-deriving any of them.
//
// `skipVendor` is the SAME parameter `collectTestModules` already takes and
// means the same thing (#4154): true for a no-operand project-wide walk
// (`fmtProjectCmd`/`countConventionTestFiles` below, both pass true), false
// for a directory an operand named explicitly (`fmtPaths` in fmtcmd.bit,
// `collectLintFiles` in lintbatch.bit) — `bit test <dir>` has walked a literal
// `vendor/` subdirectory named explicitly since #2247, and `bit lint <dir>`/
// `bit fmt <dir>` keep that same convention rather than inventing a different
// one. The dot-directory, `bit-out` and `dist` skip is NEVER opt-in, for
// either verb: that is what stops a root-level `bit fmt .`/`bit lint .` from
// wandering into `.claude/worktrees/`, `bit-out/stage0/` (#4154) or
// `dist/out/stagesrc/` (#4159).
fn collectProjectBitFiles(root: string, skipVendor: bool): []string {
  let out = []string(0)
  for name of listBitFiles(root) {
    out = append(out, "${root}/${name}")
  }
  return projectFilesInto(root, out, maxTestWalkDepth, skipVendor)
}

fn projectFilesInto(dir: string, acc: []string, depth: int, skipVendor: bool): []string {
  if (depth <= 0) {
    return acc
  }
  let out = acc
  for name of sortStrings(dirEntryNames(dir)) {
    if (testWalkSkipsDir(name, skipVendor)) {
      continue
    }
    let p = "${dir}/${name}"
    if (!testWalkIsRealDir(p)) {
      continue
    }
    for f of listBitFiles(p) {
      // bit:lint allow E0214 -- projectFilesInto has 2 call sites (collectProjectBitFiles's tail-forward of its own fresh []string(0), never read again; its own self-recursion below, reassigning out in place) — same shape as testWalkInto (testrun.bit), neither keeps a pre-call reference
      out = append(out, "${p}/${f}")
    }
    out = projectFilesInto(p, out, depth - 1, skipVendor)
  }
  return out
}

// The project's test-file count by the ONLY naming convention discovery
// itself honors (#3786, SPEC §19): a `<name>.test.bit` sibling. A `_tests_/`
// directory is a module boundary, not a discovery marker on its own — a
// plain `.bit` file inside one is never scanned (testgen.bit's `isTestFunc`
// header), so counting it here would report a "found" file that can never
// contribute a "run" test. REPORTING ONLY: `isTestFunc` itself decides what
// runs; this only counts filenames for the "found" half of `bit test`'s "<N>
// test file(s) found, <M> test(s) run" summary line (`testCmd`, testrun.bit).
fn countConventionTestFiles(root: string): int {
  let n = 0
  for f of collectProjectBitFiles(root, true) {
    if (hasSuffix(f, ".test.bit")) {
      n = n + 1
    }
  }
  return n
}

// `bit check` with no operand: every module beneath the project root,
// reusing `bit test`'s own module walk (see the file header) with
// `requireTestBitFile: false` — a module with no `.test.bit` file must
// still be checked, since `bit check` has nothing to do with whether a
// module has tests (#4253b: narrowing this shared walk to `.test.bit`-only
// for #4253's `bit test` fix silently dropped every module with no tests
// from `bit check`'s project-wide walk too, since both verbs called the
// same function). Prints its count even at zero, matching `bit fmt`'s "<N>
// file(s) scanned" and never leaving a project with nothing to check
// looking like a bare, unqualified pass.
fn checkProjectCmd(): bool {
  let root = projectRootDir()
  let mods = collectTestModules(root, true, false)
  let ok = true
  for m of mods {
    if (!checkCmd(m)) {
      ok = false
    }
  }
  print("${len(mods)} module${pluralS(len(mods))} checked\n")
  return ok
}

// `bit fmt` with no operand: every `.bit` file beneath the project root.
fn fmtProjectCmd(checkOnly: bool): int {
  let root = projectRootDir()
  let files = collectProjectBitFiles(root, true)
  let anyFailed = false
  for p of files {
    if (fmtOneFile(p, checkOnly)) {
      anyFailed = true
    }
  }
  print("${len(files)} file${pluralS(len(files))} scanned\n")
  if (anyFailed) {
    return 1
  }
  return 0
}

// Whether `bit fmt`'s argv names an operand at all, past `--check` — the
// only flag its `CliSpec` (cli.bit) declares. `cliFrontEnd` has already
// rejected anything else flag-shaped before `main`'s dispatch ever reaches
// this, so every remaining token is either `--check` or a real path.
fn fmtHasOperand(a: []string): bool {
  let i = 2
  while (i < len(a)) {
    if (a[i] != "--check") {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether `bit test`'s argv names an operand: `a[2]` when it is present and
// is not itself one of `test`'s own flags. `main`'s existing dispatch always
// read `a[2]` as the operand (`--run`/`--timeout`'s values are read starting
// at `a[3]`), so this is exactly that same assumption, named, rather than a
// new rule — `cliFrontEnd` guarantees anything flag-shaped in `a[2:]` here is
// one of `test`'s own two known flags.
fn testHasOperand(a: []string): bool {
  return len(a) >= 3 && a[2] != "--run" && a[2] != "--timeout"
}

// `bit check`'s full dispatch, called from `main` (main.bit) once it knows
// `a[1] == "check"`. Kept OUT of `main` itself: that function is already far
// past this repo's own E0204 complexity ceiling (spec/LINT.md), and #3784
// must not add to it. `check` declares no flags of its own (cli.bit), so
// `len(a) == 2` can only mean a bare `bit check`.
fn dispatchCheck(a: []string) {
  if (len(a) == 2) {
    if (checkProjectCmd()) {
      return
    }
    exit(1)
    return
  }
  if (checkCmd(a[2])) {
    return
  }
  exit(1)
}

// `bit fmt`'s full dispatch — same reason as `dispatchCheck` above.
// `fmtHasOperand` returns true for anything `cliFrontEnd` did not already
// reject as an unknown flag, so a GIVEN path reaches the unchanged
// `fmtCmd(a)` exactly as before.
fn dispatchFmt(a: []string) {
  if (fmtHasOperand(a)) {
    exit(fmtCmd(a))
    return
  }
  exit(fmtProjectCmd(fmtCheckOnly(a, 2)))
}

// `bit test`'s full dispatch — same reason as `dispatchCheck` above. The
// operand is always `a[2]` when one is given (`--run`/`--timeout`'s own
// values start at `a[3]`, unchanged from before #3784); `testHasOperand`
// above is exactly that assumption, so a GIVEN path reaches `testCmd`
// exactly as before with `flagStart` still 3 and `wholeProject` false.
fn dispatchTest(a: []string) {
  let hasOperand = testHasOperand(a)
  let flagStart = 2
  let src = projectRootDir()
  if (hasOperand) {
    src = a[2]
    flagStart = 3
  }
  let (runPattern, ok) = testRunPattern(a, flagStart)
  if (!ok) {
    eprint("bit test: --run needs a pattern\n")
    exit(2)
    return
  }
  let (timeoutMs, timeoutOk) = testTimeoutMs(a, flagStart)
  if (!timeoutOk) {
    eprint("bit test: --timeout needs a positive whole number of seconds\n")
    exit(2)
    return
  }
  exit(
    testCmd(
      TestOptions{
        src: src, runPattern: runPattern, timeoutMs: timeoutMs,
        wholeProject: !hasOperand,
      },
    ),
  )
}
