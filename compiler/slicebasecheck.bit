// #8640: matcher refusals are checked before LICM can hide their provenance.
fn sliceBaseFixture(): IrModule {
  return lowerSourceModule(
      "fn read(xs: []i64, other: []i64, i: int): i64 { return xs[i] }\n" +
      "fn write(xs: []i64, i: int, v: i64) { xs[i] = v }\n" +
      "fn main() {}\n",
  )
}

fn sliceBaseFirst(f: IrFunc, op: Op): int {
  let i = 0
  while (i < len(f.instrs)) {
    if (f.instrs[i].op == op) {
      return i
    }
    i = i + 1
  }
  panic("missing slice-base fixture instruction")
}

fn checkSliceBaseRead() {
  let m = sliceBaseFixture()
  let f = optFuncNamed(m, "read")
  let access = f.instrs[sliceBaseFirst(f, Op.IndexGet)]
  let owner = sliceBaseOwner(m.ctx, f, access)
  assert(owner >= 0, "8640/read/exact-owner")
  let g = biasSliceAddresses(m.ctx, f, false)
  assert(optCountOp(g, Op.SliceBase) == 1, "8640/read/base")
  let base = sliceBaseFirst(g, Op.SliceBase)
  let load = g.instrs[sliceBaseFirst(g, Op.IndexGet)]
  assert(load.lhs == base, "8640/read/address")
  assert(g.instrs[base].ty == primType(m.ctx, 3), "8640/read/not-ref")
  assert(len(g.keepAlive) == 2, "8640/read/owner-edge")
  assert(g.keepAlive[0] == base, "8640/read/derived")
  assert(g.keepAlive[1] == g.instrs[base].lhs, "8640/read/managed-owner")
  let debug = biasSliceAddresses(m.ctx, f, true)
  assert(optCountOp(debug, Op.SliceBase) == 0, "8640/debug/base")
  assert(len(debug.instrs) == len(f.instrs), "8640/debug/unchanged")
}

fn checkSliceBaseRefusals() {
  let m = sliceBaseFixture()
  let f = optFuncNamed(m, "read")
  let access = f.instrs[sliceBaseFirst(f, Op.IndexGet)]
  let slot = f.instrs[access.rhs]
  let off = f.instrs[slot.lhs]
  let owner = off.lhs
  assert(f.instrs[1].op == Op.BlockParam, "8640/refusal/other-param")
  off.lhs = 1
  assert(sliceBaseOwner(m.ctx, f, access) < 0, "8640/refusal/foreign-header")
  off.lhs = owner
  off.ival = 24
  assert(sliceBaseOwner(m.ctx, f, access) < 0, "8640/refusal/wrong-offset")
  off.ival = 16
  access.ty = primType(m.ctx, 7)
  assert(sliceBaseOwner(m.ctx, f, access) < 0, "8640/refusal/element-mismatch")
  access.ty = primType(m.ctx, 3)
  slot.ty = primType(m.ctx, 2)
  assert(sliceBaseOwner(m.ctx, f, access) < 0, "8640/refusal/narrow-address")
  slot.ty = primType(m.ctx, 3)
  assert(sliceBaseOwner(m.ctx, f, access) >= 0, "8640/refusal/restored")
}

fn checkSliceBaseStores() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "write"), false)
  let store = f.instrs[sliceBaseFirst(f, Op.IndexSet)]
  let lc = licmCtxFor(m.ctx, f, false, false)
  let base = f.instrs[store.lhs]
  assert(licmReadsHeaderWord(lc, base), "8640/store/header-read")
  base.ty = primType(m.ctx, 7)
  assert(!licmReadsHeaderWord(lc, base), "8640/store/non-i64-refused")
  base.ty = primType(m.ctx, 3)
  let owner = base.lhs
  base.lhs = 1
  assert(!licmReadsHeaderWord(lc, base), "8640/store/non-header-refused")
  base.lhs = owner
  assert(licmWritesSliceBuf(lc, store), "8640/store/buffer")
  store.ival2 = primType(m.ctx, 6)
  assert(!licmWritesSliceBuf(lc, store), "8640/store/stride-mismatch")
  store.ival2 = primType(m.ctx, 7)
  assert(!licmWritesSliceBuf(lc, store), "8640/store/type-mismatch")
  store.ival2 = primType(m.ctx, 3)
  assert(licmWritesSliceBuf(lc, store), "8640/store/restored")
}

fn checkSliceBaseTypes() {
  let m = sliceBaseFixture()
  let p = 0
  while (p <= 12) {
    assert(
      sliceBaseWordType(m.ctx, primType(m.ctx, p)) == (p == 3 || p == 7 || p == 9),
      "8640/type/${p}",
    )
    p = p + 1
  }
  assert(!sliceBaseWordType(m.ctx, mkSlice(m.ctx, primType(m.ctx, 3))), "8640/type/ref")
}

fn checkSliceBaseClobber() {
  let m = lowerSourceModule(
      "fn withCall(xs: []i64, n: int): i64 {\n" +
      "  let i = 0\n  let s: i64 = 0\n  while (i < n) {\n" +
      "    print(\"\")\n    s = s + xs[i]\n    i = i + 1\n  }\n  return s\n}\n" +
      "fn main() {}\n",
  )
  optimizeModule(m, false)
  let f = optFuncNamed(m, "withCall")
  assert(optCountOp(f, Op.SliceBase) > 0, "8640/call/base-present")
  assert(optCountOpInBlock(f, 0, Op.SliceBase) == 0, "8640/call/no-hoist")
}

fn checkSliceBaseHoistOwner() {
  let m = lowerSourceModule(
      "fn sum(xs: []i64): i64 {\n" +
      "  let i = 0\n  let s: i64 = 0\n  while (i < len(xs)) {\n" +
      "    s = s + xs[i]\n    i = i + 1\n  }\n  return s\n}\n" +
      "fn main() {}\n",
  )
  optimizeModule(m, false)
  let f = optFuncNamed(m, "sum")
  assert(optCountOpInBlock(f, 0, Op.SliceBase) == 1, "8640/hoist/preheader")
  let owners = 0
  let i = 0
  while (i + 1 < len(f.keepAlive)) {
    let derived = f.instrs[f.keepAlive[i]]
    let owner = f.instrs[f.keepAlive[i + 1]]
    assert(derived.ty == primType(m.ctx, 3), "8640/hoist/derived-i64")
    assert(m.ctx.types[owner.ty].kind == TypeKind.Slice, "8640/hoist/real-owner")
    owners = owners + 1
    i = i + 2
  }
  assert(owners > 0, "8640/hoist/owner-edge-lost")
}

// #8648: repeated checked accesses cross bounds blocks and element stores.
fn sliceBaseCseFixture(): IrModule {
  return lowerSourceModule(
      "fn same(xs: []i64, i: int): i64 {\n" +
      "  let first = xs[i]\n  xs[i] = first + 1\n  return xs[i] + first\n}\n" +
      "fn different(xs: []i64, ys: []i64, i: int): i64 {\n" +
      "  let first = xs[i]\n  xs[i] = first + 1\n  return ys[i] + first\n}\n" +
      "fn differentStore(xs: []i64, ys: []i64, i: int): i64 {\n" +
      "  let first = xs[i]\n  ys[i] = first + 1\n  return xs[i] + first\n}\n" +
      "fn main() {}\n",
  )
}

fn checkSliceBaseCseOwner(ctx: TypeContext, f: IrFunc) {
  let base = sliceBaseFirst(f, Op.SliceBase)
  assert(f.instrs[base].ty == primType(ctx, 3), "8648/fullopt/derived-i64")
  let owner = f.instrs[base].lhs
  assert(ctx.types[f.instrs[owner].ty].kind == TypeKind.Slice, "8648/fullopt/real-header")
  let edges = 0
  let i = 0
  while (i + 1 < len(f.keepAlive)) {
    if (f.keepAlive[i] == base && f.keepAlive[i + 1] == owner) {
      edges = edges + 1
    }
    i = i + 2
  }
  assert(edges > 0, "8648/fullopt/owner-edge")
}

fn checkSliceBaseCseFullOpt() {
  let m = sliceBaseCseFixture()
  let before = biasSliceAddresses(m.ctx, optFuncNamed(m, "same"), false)
  assert(optCountOp(before, Op.SliceBase) == 3, "8648/fullopt/three-accesses-built")
  optimizeModule(m, false)
  let same = optFuncNamed(m, "same")
  assert(optCountOp(same, Op.SliceBase) == 1, "8648/fullopt/same-header-dedup")
  assert(optCountOp(same, Op.IndexSet) == 1, "8648/fullopt/store-preserved")
  checkSliceBaseCseOwner(m.ctx, same)
  let different = optFuncNamed(m, "different")
  assert(optCountOp(different, Op.SliceBase) == 2, "8648/fullopt/different-header")
  let differentStore = optFuncNamed(m, "differentStore")
  assert(optCountOp(differentStore, Op.SliceBase) == 2, "8648/fullopt/different-store-headers")
  assert(optCountOp(differentStore, Op.IndexSet) == 1, "8648/fullopt/different-store-preserved")
  assert(optCountOp(differentStore, Op.IndexGet) == 2, "8648/fullopt/aliasable-reads-preserved")
}

fn checkSliceBaseCseStoreTypes() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "write"), false)
  let store = f.instrs[sliceBaseFirst(f, Op.IndexSet)]
  let ar = newAvailArena(m.ctx, f)
  let fwd = noForwarding(len(f.instrs))
  assert(cseWritesSliceBuf(f, ar, fwd, store), "8648/store/exact-buffer")
  store.ival2 = primType(m.ctx, 6)
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/wrong-stride")
  store.ival2 = primType(m.ctx, 7)
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/wrong-element")
  store.ival2 = primType(m.ctx, 3)
  assert(cseWritesSliceBuf(f, ar, fwd, store), "8648/store/type-restored")
}

fn checkSliceBaseCseStoreHeader() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "write"), false)
  let store = f.instrs[sliceBaseFirst(f, Op.IndexSet)]
  let ar = newAvailArena(m.ctx, f)
  let fwd = noForwarding(len(f.instrs))
  let base = f.instrs[store.lhs]
  base.ty = primType(m.ctx, 7)
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/wrong-result")
  assert(!cseLoadValid(f, ar, base), "8648/load/wrong-result")
  base.ty = primType(m.ctx, 3)
  let owner = base.lhs
  base.lhs = 1
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/scalar-header")
  assert(!cseLoadValid(f, ar, base), "8648/load/scalar-header")
  base.lhs = owner
  let header = f.instrs[owner]
  let ty = header.ty
  header.ty = mkSlice(m.ctx, primType(m.ctx, 6))
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/narrow-header")
  assert(!cseLoadValid(f, ar, base), "8648/load/narrow-header")
  header.ty = ty
  assert(cseWritesSliceBuf(f, ar, fwd, store), "8648/store/header-restored")
}

fn checkSliceBaseCseStoreResolved() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "write"), false)
  let store = f.instrs[sliceBaseFirst(f, Op.IndexSet)]
  let ar = newAvailArena(m.ctx, f)
  let fwd = noForwarding(len(f.instrs))
  let address = store.lhs
  store.lhs = 1
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/unknown-raw-base")
  fwd[1] = address
  assert(cseWritesSliceBuf(f, ar, fwd, store), "8648/store/resolved-base")
  fwd[1] = -1
  store.lhs = address
  let base = f.instrs[address]
  base.op = Op.ConstInt
  assert(!cseWritesSliceBuf(f, ar, fwd, store), "8648/store/raw-i64-refused")
}

fn checkSliceBaseCseBarrier(f: IrFunc, ar: AvailArena, fwd: []int, idx: int) {
  let h = CseHeads{ load = 23, hdr = 17, pure = -1 }
  cseStep(f, ar, fwd, h, idx)
  assert(h.hdr == -1, "8648/barrier/header-invalidated")
  assert(h.load == -1, "8648/barrier/element-invalidated")
}

fn checkSliceBaseCseBarriers() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "write"), false)
  let idx = sliceBaseFirst(f, Op.IndexSet)
  let store = f.instrs[idx]
  let ar = newAvailArena(m.ctx, f)
  let fwd = noForwarding(len(f.instrs))
  let h = CseHeads{ load = 23, hdr = 17, pure = -1 }
  cseStep(f, ar, fwd, h, idx)
  assert(h.hdr == 17, "8648/store/header-survives")
  assert(h.load == -1, "8648/store/element-invalidated")
  store.lhs = 1
  checkSliceBaseCseBarrier(f, ar, fwd, idx)
  store.op = Op.Call
  checkSliceBaseCseBarrier(f, ar, fwd, idx)
  store.op = Op.RtCall
  store.name = "slice_append"
  checkSliceBaseCseBarrier(f, ar, fwd, idx)
  store.op = Op.FieldSet
  checkSliceBaseCseBarrier(f, ar, fwd, idx)
  assert(cseInheritHead([-1, 0], [0, 1], [17, 23], 1, 1) == 17, "8648/edge/forward")
  assert(cseInheritHead([1, -1], [1, 0], [17, 23], 0, 1) == -1, "8648/edge/backedge")
}

fn checkSliceBaseBorrowRoots(f: IrFunc, derived: int, expected: bool) {
  let live = []bool(len(f.instrs))
  rootKeepAliveBases(f, live)
  assert(live[f.instrs[derived].lhs] == expected, "8679/borrow/global-owner")
}

fn checkSliceBaseBorrowEscapes() {
  let ops = [Op.Call, Op.Ret, Op.Jump, Op.Br, Op.Bitcast, Op.FieldSet]
  for op of ops {
    let m = sliceBaseFixture()
    let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "read"), false)
    let address = sliceBaseFirst(f, Op.SliceBase)
    assert(borrowedSliceBases(f)[address], "8679/borrow/local-access")
    checkSliceBaseBorrowRoots(f, address, false)
    let use = mkInstr(op, primType(m.ctx, 3))
    use.lhs = address
    use.rhs = address
    use.args = [address]
    use.thenArgs = [address]
    use.elseArgs = [address]
    f.instrs = append(f.instrs, use)
    assert(!borrowedSliceBases(f)[address], "8679/borrow/escape-refused")
    checkSliceBaseBorrowRoots(f, address, true)
  }
}

fn checkSliceBaseBorrowOperands() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "write"), false)
  let store = f.instrs[sliceBaseFirst(f, Op.IndexSet)]
  let address = store.lhs
  assert(borrowedSliceBases(f)[address], "8679/borrow/store-base")
  let value = store.ival
  store.ival = address
  assert(!borrowedSliceBases(f)[address], "8679/borrow/store-value-refused")
  store.ival = value
  let index = store.rhs
  store.rhs = address
  assert(!borrowedSliceBases(f)[address], "8679/borrow/index-refused")
  store.rhs = index
  f.keepAlive = append(f.keepAlive, value)
  f.keepAlive = append(f.keepAlive, address)
  assert(!borrowedSliceBases(f)[address], "8679/borrow/derived-owner-refused")
  checkSliceBaseBorrowRoots(f, address, true)
}

fn checkSliceBaseBorrowRawOwner() {
  let m = sliceBaseFixture()
  let f = biasSliceAddresses(m.ctx, optFuncNamed(m, "read"), false)
  let address = sliceBaseFirst(f, Op.SliceBase)
  f.instrs[address].op = Op.Bitcast
  assert(!borrowedSliceBases(f)[address], "8679/borrow/raw-pointer-refused")
  checkSliceBaseBorrowRoots(f, address, true)
  f.instrs[address].op = Op.SliceBase
  f.keepAlive[1] = 1
  let live = []bool(len(f.instrs))
  rootKeepAliveBases(f, live)
  assert(live[1], "8679/borrow/foreign-owner-refused")
}

fn checkSliceBaseBorrowPtrOf() {
  let m = lowerSourceModule("fn raw(xs: []i64): *i64 { return ptrOf(xs) }\n")
  let f = optFuncNamed(m, "raw")
  assert(len(f.keepAlive) == 2, "8679/borrow/ptrOf-edge")
  let address = f.keepAlive[0]
  assert(!borrowedSliceBases(f)[address], "8679/borrow/ptrOf-escape-refused")
  let live = []bool(len(f.instrs))
  rootKeepAliveBases(f, live)
  assert(live[f.keepAlive[1]], "8679/borrow/ptrOf-owner-rooted")
}

fn checkSliceBaseBorrowDeadCopies() {
  let m = lowerSourceModule(
      "fn dead(n: int): i64 {\n" +
      "  let xs = []i64(1)\n  xs[0] = 7\n  let out = xs[0]\n" +
      "  let i = 0\n  while (i < n) { print(i); i = i + 1 }\n" +
      "  return out\n}\nfn main() {}\n",
  )
  optimizeModule(m, false)
  let f = optFuncNamed(m, "dead")
  assert(optCountOp(f, Op.SliceBase) > 0, "8679/borrow/fullopt-address")
  let lastRead = sliceBaseFirst(f, Op.IndexGet)
  let i = lastRead + 1
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    assert(
      ins.op != Op.BlockParam || m.ctx.types[ins.ty].kind != TypeKind.Slice,
      "8679/borrow/dead-owner-copy",
    )
    i = i + 1
  }
  checkSliceBaseCseOwner(m.ctx, f)
}

fn checkSliceBase() {
  checkSliceBaseRead()
  checkSliceBaseRefusals()
  checkSliceBaseStores()
  checkSliceBaseTypes()
  checkSliceBaseClobber()
  checkSliceBaseHoistOwner()
  checkSliceBaseCseFullOpt()
  checkSliceBaseCseStoreTypes()
  checkSliceBaseCseStoreHeader()
  checkSliceBaseCseStoreResolved()
  checkSliceBaseCseBarriers()
  checkSliceBaseBorrowEscapes()
  checkSliceBaseBorrowOperands()
  checkSliceBaseBorrowRawOwner()
  checkSliceBaseBorrowPtrOf()
  checkSliceBaseBorrowDeadCopies()
}
