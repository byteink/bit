// In-Bit self-checks for atomization, global resolution, dead-stripping and
// relocation apply. Split out of selfcheck.bit (#1503); sibling .bit files are
// the same module, so `selfcheck()` still calls these directly.

// Stage 3 (#1344) the linker's object model. Ports every one of the seed's
// atomizeModule tests, including its two silent-corruption regressions.

function loSec(name: string, kind: LoSectionKind, data: []u8, size: int, align: int): LoRawSection {
  return LoRawSection{ name: name, kind: kind, data: data, size: size, alignment: align }
}

function loSym(name: string, sec: int, off: int, size: int, b: LoBinding, align: int): LoRawSymbol {
  return LoRawSymbol{ name: name, section: sec, offset: off, size: size,
    binding: b, weak: false, alignment: align }
}

// atomizeModule is fallible; every check below passes a well-formed module, so a
// failure is the check's own bug.
function loAtomize(secs: []LoRawSection, syms: []LoRawSymbol, rels: []LoRawReloc): LoModule {
  return atomizeModule("m", secs, syms, rels) catch e {
    assert(false)
    LoModule{ name: "", atoms: []LoAtom(0) }
  }
}

function checkAtomizeSplit() {
  // One atom per symbol, each spanning to the NEXT symbol — not to its own
  // declared size (which is 0 here, as Mach-O always leaves it).
  let text = [u8(0x11), u8(0x11), u8(0x22), u8(0x22), u8(0x22), u8(0x33)]
  let m = loAtomize([loSec(".text", LoSectionKind.Text, text, 6, 1)],
    [loSym("f1", 0, 0, 0, LoBinding.Global, 1),
     loSym("f2", 0, 2, 0, LoBinding.Local, 1),
     loSym("f3", 0, 5, 0, LoBinding.Global, 1)], []LoRawReloc(0))
  assert(len(m.atoms) == 3)
  assert(m.atoms[0].name == "f1" && m.atoms[0].size == 2)
  assert(m.atoms[1].name == "f2" && m.atoms[1].size == 3)
  assert(m.atoms[2].name == "f3" && m.atoms[2].size == 1)
  assert(m.atoms[1].binding == LoBinding.Local)
  // Each atom carries its own bytes.
  assert(m.atoms[1].data[0] == u8(0x22) && len(m.atoms[1].data) == 3)
}

function checkAtomizeRelocs() {
  // A cross-section local relocation with no named symbol (the STT_SECTION
  // shape): .text+4 referencing .rodata+1. It must resolve to the msg atom with
  // the addend rebased from section-relative to atom-relative.
  let text = []u8(8)
  let rodata = [u8(0xAA), u8(0xBB), u8(0xCC)]
  let m = loAtomize(
    [loSec(".text", LoSectionKind.Text, text, 8, 1),
     loSec(".rodata", LoSectionKind.Rodata, rodata, 3, 1)],
    [loSym("main", 0, 0, 8, LoBinding.Global, 1),
     loSym("msg", 1, 0, 3, LoBinding.Local, 1)],
    [LoRawReloc{ section: 0, offset: 4, kind: LoRelocKind.Pc32,
      target: loTargetSectionOffset(1, 1), addend: 0 - 4 }])
  assert(len(m.atoms[0].relocs) == 1)
  let r = m.atoms[0].relocs[0]
  assert(r.offset == 4)
  assert(!r.target.isGlobal && r.target.local == 1)
  assert(r.addend == 0 - 4 + 1)

  // The rebase itself, with a NONZERO atom base — the case that actually proves
  // it. Targeting .rodata+6 lands inside msg2 (which starts at 4), so the addend
  // must become atom-relative: 6 - 4 == 2. Every base-0 target above passes
  // whether or not the rebase happens at all.
  let ro2 = [u8(0xAA), u8(0xBB), u8(0xCC), u8(0xDD), u8(0xEE), u8(0xFF), u8(0x01), u8(0x02)]
  let m3 = loAtomize(
    [loSec(".text", LoSectionKind.Text, []u8(8), 8, 1),
     loSec(".rodata", LoSectionKind.Rodata, ro2, 8, 1)],
    [loSym("main", 0, 0, 8, LoBinding.Global, 1),
     loSym("msg1", 1, 0, 4, LoBinding.Local, 1),
     loSym("msg2", 1, 4, 4, LoBinding.Local, 1)],
    [LoRawReloc{ section: 0, offset: 0, kind: LoRelocKind.Abs64,
      target: loTargetSectionOffset(1, 6), addend: 100 }])
  let r3 = m3.atoms[0].relocs[0]
  assert(m3.atoms[r3.target.local].name == "msg2")
  assert(r3.addend == 102) // 100 + (6 - 4), NOT 100 + 6

  // A global-bound reference stays a name, resolved at whole-link merge time.
  let m2 = loAtomize([loSec(".text", LoSectionKind.Text, []u8(4), 4, 1)],
    [loSym("caller", 0, 0, 4, LoBinding.Global, 1)],
    [LoRawReloc{ section: 0, offset: 0, kind: LoRelocKind.Pc32,
      target: loTargetGlobal("bit_rt_gc_alloc"), addend: 0 - 4 }])
  assert(m2.atoms[0].relocs[0].target.isGlobal)
  assert(m2.atoms[0].relocs[0].target.name == "bit_rt_gc_alloc")
}

function checkAtomizeAlignment() {
  // A symbol-less section's anonymous atom takes the SECTION's alignment. It has
  // no symbol to inherit one from, and an AArch64 literal pool loaded with
  // `ldr q0` faults if under-aligned.
  let m = loAtomize([loSec(".rodata.cst16", LoSectionKind.Rodata, []u8(32), 32, 16)],
    []LoRawSymbol(0), []LoRawReloc(0))
  assert(len(m.atoms) == 1 && m.atoms[0].alignment == 16)

  // A symbol at offset 0 starts at the section base, so it can never be laid out
  // looser than the section requires — even declaring alignment 1.
  let m2 = loAtomize([loSec(".rodata", LoSectionKind.Rodata, []u8(16), 16, 16)],
    [loSym("tbl", 0, 0, 16, LoBinding.Global, 1)], []LoRawReloc(0))
  assert(m2.atoms[0].alignment == 16)
}

function checkAtomizeLeading() {
  // Regression (#1157): AArch64 literal pools are .rodata.cst8/.cst16 sections
  // whose mapping symbols are excluded, leaving a named constant PARTWAY IN as
  // the first symbol. Atomizing only from that symbol silently dropped the pool
  // entries ahead of it — including the lane-index vector indexOfScalar loads —
  // and a relocation into them resolved against the first symbol's atom with a
  // negative addend, reading whatever layout placed before it. Both symptoms are
  // silent.
  let pool = [u8(0), u8(1), u8(2), u8(3), u8(4), u8(5), u8(6), u8(7),
    u8(0xAA), u8(0xAA), u8(0xAA), u8(0xAA), u8(0xAA), u8(0xAA), u8(0xAA), u8(0xAA)]
  let m = loAtomize([loSec(".rodata.cst8", LoSectionKind.Rodata, pool, 16, 8)],
    [loSym(".L__anon_1", 0, 8, 8, LoBinding.Local, 8)], []LoRawReloc(0))
  assert(len(m.atoms) == 2)
  assert(m.atoms[0].name == ".rodata.cst8")
  assert(m.atoms[0].size == 8 && m.atoms[0].alignment == 8)
  assert(len(m.atoms[0].data) == 8)
  let i = 0
  while (i < 8) {
    assert(m.atoms[0].data[i] == pool[i]) // the lane vector, kept
    i = i + 1
  }
  assert(m.atoms[1].name == ".L__anon_1")

  // A reloc BELOW the first symbol resolves to that leading atom, with no
  // negative addend folded against the wrong atom.
  let m2 = loAtomize(
    [loSec(".text", LoSectionKind.Text, []u8(8), 8, 1),
     loSec(".rodata.cst8", LoSectionKind.Rodata, pool, 16, 8)],
    [loSym("f", 0, 0, 8, LoBinding.Global, 1),
     loSym(".L__anon_1", 1, 8, 8, LoBinding.Local, 8)],
    [LoRawReloc{ section: 0, offset: 0, kind: LoRelocKind.Abs64,
      target: loTargetSectionOffset(1, 0), addend: 0 }])
  let r = m2.atoms[0].relocs[0]
  assert(m2.atoms[r.target.local].name == ".rodata.cst8")
  assert(r.addend == 0)
}

function checkAtomizeBssAndAliases() {
  // A bss atom carries a size and no bytes.
  let m = loAtomize([loSec(".bss", LoSectionKind.Bss, []u8(0), 64, 1)],
    [loSym("buf", 0, 0, 64, LoBinding.Global, 1)], []LoRawReloc(0))
  assert(len(m.atoms[0].data) == 0 && m.atoms[0].size == 64)

  // A local section label aliasing a real global at the same offset — the exact
  // shape compiler-rt emits. They collapse to ONE atom, and the global wins its
  // identity; a reloc targeting the local alias resolves to that same atom.
  let text = [u8(0xAA), u8(0xBB), u8(0xCC), u8(0xDD)]
  let m2 = loAtomize([loSec(".text", LoSectionKind.Text, text, 4, 1)],
    [loSym("local_label", 0, 0, 0, LoBinding.Local, 1),
     loSym("real_fn", 0, 0, 0, LoBinding.Global, 1)],
    [LoRawReloc{ section: 0, offset: 0, kind: LoRelocKind.Abs64,
      target: loTargetSymbol(0), addend: 0 }])
  assert(len(m2.atoms) == 1)
  assert(m2.atoms[0].name == "real_fn") // the global wins the identity
  assert(m2.atoms[0].binding == LoBinding.Global)
  assert(m2.atoms[0].size == 4)
  assert(m2.atoms[0].relocs[0].target.local == 0)

  // A STRONG global beats a weak one for the identity.
  let weak = LoRawSymbol{ name: "weak_fn", section: 0, offset: 0, size: 0,
    binding: LoBinding.Global, weak: true, alignment: 1 }
  let m3 = loAtomize([loSec(".text", LoSectionKind.Text, text, 4, 1)],
    [weak, loSym("strong_fn", 0, 0, 0, LoBinding.Global, 1)], []LoRawReloc(0))
  assert(len(m3.atoms) == 1)
  assert(m3.atoms[0].name == "strong_fn" && !m3.atoms[0].weak)
}

// Stage 3 (#1344) symbol resolution, dead-strip, and relocation arithmetic.
// Ports the seed's four tests. Every expected instruction word below was
// produced by the SYSTEM assembler (clang -arch arm64) for the shown mnemonic,
// not derived from the same arithmetic under test:
//   bl .+16          -> 0x94000004
//   b  .-16          -> 0x17fffffc
//   add x0, x0, #2748 -> 0x912af000
//   ldr x1, [x0, #2744] -> 0xf9455c01

function stAtom(name: string, b: LoBinding, relocs: []LoReloc): LoAtom {
  return LoAtom{ name: name, kind: LoSectionKind.Text, binding: b, data: []u8(0),
    size: 0, alignment: 1, weak: false, relocs: relocs }
}

function stWeakAtom(name: string): LoAtom {
  return LoAtom{ name: name, kind: LoSectionKind.Text, binding: LoBinding.Global,
    data: []u8(0), size: 0, alignment: 1, weak: true, relocs: []LoReloc(0) }
}

function stRel(target: LoSymbolRef): LoReloc {
  return LoReloc{ offset: 0, kind: LoRelocKind.Abs64, target: target, addend: 0 }
}

function stGlobalsErr(mods: []LoModule): string {
  let msg = ""
  let t = resolveGlobals(mods) catch e {
    msg = e.message()
    map<string, int>{}
  }
  return msg
}

function checkResolveGlobals() {
  let mods = [
    LoModule{ name: "rt", atoms: [stAtom("_start", LoBinding.Global, []LoReloc(0)),
      stAtom("helper", LoBinding.Local, []LoReloc(0))] },
    LoModule{ name: "user", atoms: [stAtom("bit_main", LoBinding.Global, []LoReloc(0))] }]
  let g = resolveGlobals(mods) catch e { map<string, int>{} }
  // Only global-binding atoms enter the table; a local is invisible outside its
  // own module.
  let (startId, hasStart) = g["_start"]
  let (mainId, hasMain) = g["bit_main"]
  let (_, hasHelper) = g["helper"]
  assert(hasStart && hasMain && !hasHelper)
  assert(atomKeyModule(startId) == 0 && atomKeyAtom(startId) == 0)
  assert(atomKeyModule(mainId) == 1 && atomKeyAtom(mainId) == 0)

  // Two strong definitions of one name is a real conflict.
  assert(stGlobalsErr([
    LoModule{ name: "a", atoms: [stAtom("dup", LoBinding.Global, []LoReloc(0))] },
    LoModule{ name: "b", atoms: [stAtom("dup", LoBinding.Global, []LoReloc(0))] }]) == "DuplicateSymbol")

  // Strong overrides weak, whichever order they appear in — compiler-rt supplies
  // weak memcpy/strlen defaults the runtime may override.
  let wThenS = [LoModule{ name: "crt", atoms: [stWeakAtom("memcpy")] },
    LoModule{ name: "rt", atoms: [stAtom("memcpy", LoBinding.Global, []LoReloc(0))] }]
  assert(stGlobalsErr(wThenS) == "")
  let g2 = resolveGlobals(wThenS) catch e { map<string, int>{} }
  let (mc, _) = g2["memcpy"]
  assert(atomKeyModule(mc) == 1) // the strong one wins

  let sThenW = [LoModule{ name: "rt", atoms: [stAtom("memcpy", LoBinding.Global, []LoReloc(0))] },
    LoModule{ name: "crt", atoms: [stWeakAtom("memcpy")] }]
  let g3 = resolveGlobals(sThenW) catch e { map<string, int>{} }
  let (mc2, _) = g3["memcpy"]
  assert(atomKeyModule(mc2) == 0) // still the strong one

  // Two weak definitions keep the first.
  let g4 = resolveGlobals([LoModule{ name: "a", atoms: [stWeakAtom("w")] },
    LoModule{ name: "b", atoms: [stWeakAtom("w")] }]) catch e { map<string, int>{} }
  let (w, _) = g4["w"]
  assert(atomKeyModule(w) == 0)
}

// Mirrors the seed's three selectArchiveMembers tests (#1647). The property
// under test is membership, not layout: an archive member is read only to
// satisfy a symbol nothing has defined yet.
function checkSelectArchiveMembers() {
  // The #1647 shape: the program compiles `runtime/alloc` from source, so it
  // DEFINES bit_rt_alloc itself while still needing _start from the archive.
  // Loading every member made those two definitions a duplicate.
  let prog = LoModule{ name: "bit.o", atoms: [
    stAtom("bit_main", LoBinding.Global, [stRel(loGlobalRef("bit_rt_alloc"))]),
    stAtom("bit_rt_alloc", LoBinding.Global, []LoReloc(0))] }
  let members = [
    LoModule{ name: "runtime_root.o", atoms: [
      stAtom("_start", LoBinding.Global, [stRel(loGlobalRef("bit_main"))])] },
    LoModule{ name: "runtime_alloc.o", atoms: [
      stAtom("bit_rt_alloc", LoBinding.Global, []LoReloc(0))] }]
  let picked = selectArchiveMembers([prog], members, ["_start"])
  // runtime_root.o is pulled (nothing else defines _start); runtime_alloc.o is
  // NOT (the program already defines its only symbol).
  assert(len(picked) == 1)
  assert(picked[0].name == "runtime_root.o")
  // The whole link therefore resolves, where loading both members is the
  // duplicate this task exists to remove.
  assert(stGlobalsErr([prog, picked[0]]) == "")
  assert(stGlobalsErr([prog, members[0], members[1]]) == "DuplicateSymbol")

  // A pulls B pulls C — each new member creates the reference that pulls the
  // next, so a single pass in this order would find only A. dupC also defines
  // `c`, but nothing outstanding needs it once C is in, so it stays out.
  let p2 = LoModule{ name: "bit.o", atoms: [
    stAtom("bit_main", LoBinding.Global, [stRel(loGlobalRef("a"))])] }
  let chain = [
    LoModule{ name: "a.o", atoms: [stAtom("a", LoBinding.Global, [stRel(loGlobalRef("b"))])] },
    LoModule{ name: "dup_c.o", atoms: [stAtom("c", LoBinding.Global, []LoReloc(0)),
      stAtom("unused", LoBinding.Global, []LoReloc(0))] },
    LoModule{ name: "b.o", atoms: [stAtom("b", LoBinding.Global, [stRel(loGlobalRef("c"))])] },
    LoModule{ name: "c.o", atoms: [stAtom("c", LoBinding.Global, []LoReloc(0)),
      stAtom("only_c", LoBinding.Global, []LoReloc(0))] }]
  let picked2 = selectArchiveMembers([p2], chain, []string(0))
  assert(len(picked2) == 3)
  // Archive order, not pull order (discovered a -> b -> c).
  assert(picked2[0].name == "a.o" && picked2[1].name == "b.o" && picked2[2].name == "c.o")
  assert(stGlobalsErr([p2, picked2[0], picked2[1], picked2[2]]) == "")

  // Once something outstanding needs a symbol from EACH of the two members that
  // define `c`, both are pulled and the duplicate is a real conflict again —
  // laziness decides membership, it does not make duplicates legal.
  let p3 = LoModule{ name: "bit.o", atoms: [
    stAtom("bit_main", LoBinding.Global, [stRel(loGlobalRef("a")),
      stRel(loGlobalRef("unused")), stRel(loGlobalRef("only_c"))])] }
  let picked3 = selectArchiveMembers([p3], chain, []string(0))
  assert(len(picked3) == 4)
  assert(stGlobalsErr([p3, picked3[0], picked3[1], picked3[2], picked3[3]]) == "DuplicateSymbol")

  // Two explicit OBJECTS defining one strong symbol stay an error: both are
  // eager, so neither can be dropped and the diagnostic must still fire.
  let o1 = LoModule{ name: "a.o", atoms: [stAtom("bit_rt_alloc", LoBinding.Global, []LoReloc(0))] }
  let o2 = LoModule{ name: "b.o", atoms: [stAtom("bit_rt_alloc", LoBinding.Global, []LoReloc(0))] }
  assert(len(selectArchiveMembers([o1, o2], []LoModule(0), []string(0))) == 0)
  assert(stGlobalsErr([o1, o2]) == "DuplicateSymbol")
}

function checkDeadStrip() {
  // _start -> used -> deep; unused and its callee are unreachable and must die.
  // This is what keeps libbitrt.a's std-lib closure out of every image.
  let rt = LoModule{ name: "rt", atoms: [
    stAtom("_start", LoBinding.Global, [stRel(loGlobalRef("used"))]),   // 0
    stAtom("used", LoBinding.Global, [stRel(loLocalRef(3))]),           // 1
    stAtom("unused", LoBinding.Global, [stRel(loLocalRef(4))]),         // 2
    stAtom("deep", LoBinding.Local, []LoReloc(0)),                      // 3
    stAtom("unused_callee", LoBinding.Local, []LoReloc(0))]}            // 4
  let g = resolveGlobals([rt]) catch e { map<string, int>{} }
  let kept = deadStrip([rt], g, ["_start"]) catch e { map<int, bool>{} }
  assert(len(kept) == 3)
  let (_, k0) = kept[atomKey(0, 0)]
  let (_, k1) = kept[atomKey(0, 1)]
  let (_, k2) = kept[atomKey(0, 2)]
  let (_, k3) = kept[atomKey(0, 3)]
  let (_, k4) = kept[atomKey(0, 4)]
  assert(k0 && k1 && k3)       // reachable from the root
  assert(!k2 && !k4)           // dead

  // A cycle must terminate, not spin: the kept-set check happens before the
  // push, so each atom enters the stack once.
  let cyc = LoModule{ name: "c", atoms: [
    stAtom("_start", LoBinding.Global, [stRel(loLocalRef(1))]),
    stAtom("b", LoBinding.Local, [stRel(loLocalRef(0))])]}
  let gc = resolveGlobals([cyc]) catch e { map<string, int>{} }
  let keptc = deadStrip([cyc], gc, ["_start"]) catch e { map<int, bool>{} }
  assert(len(keptc) == 2)

  // A root nothing defines, and a reference to an undefined name, both fail
  // loudly rather than silently dropping code — and both NAME the symbol
  // (#1646). Scored on the message, not merely on the failure: "UndefinedSymbol"
  // with nothing else in it is what this pair used to accept, and an error that
  // cannot say what failed has cost this repo real time repeatedly.
  let msg = ""
  let k = deadStrip([rt], g, ["nonexistent"]) catch e {
    msg = e.message()
    map<int, bool>{}
  }
  assert(msg == "undefined symbol 'nonexistent', referenced from link roots")

  let bad = LoModule{ name: "b", atoms: [
    stAtom("_start", LoBinding.Global, [stRel(loGlobalRef("missing"))])]}
  let gb = resolveGlobals([bad]) catch e { map<string, int>{} }
  let msg2 = ""
  let kbad = deadStrip([bad], gb, ["_start"]) catch e {
    msg2 = e.message()
    map<int, bool>{}
  }
  // The referencing module is named too: "b" is the LoModule's own name, which
  // for a real link is the object or ar-member the reference came from.
  assert(msg2 == "undefined symbol 'missing', referenced from b")
}

function stApply(kind: LoRelocKind, insn: int, v: RelocValues): int {
  let d = []u8(4)
  loWrU32(d, 0, insn)
  applyReloc(kind, d, 0, v) catch e {
    panic("applyReloc rejected a valid relocation: ${e.message()}")
  }
  return loRdU32(d, 0)
}

// applyReloc returns ()!, and a catch block on a void-fallible cannot simply
// handle-and-continue: its last statement must either BE an expression of the ok
// type or divert. An assignment is neither. Wrapping it in a value-returning
// fallible sidesteps that.
function applyRelocOk(kind: LoRelocKind, data: []u8, off: int, v: RelocValues): int! {
  applyReloc(kind, data, off, v)?
  return 0
}

function stApplyErr(kind: LoRelocKind, insn: int, v: RelocValues): string {
  let d = []u8(8)
  loWrU32(d, 0, insn)
  let msg = ""
  let r = applyRelocOk(kind, d, 0, v) catch e {
    msg = e.message()
    1
  }
  return msg
}

function checkRelocApply() {
  // abs64 / abs32 write S+A straight into the field.
  let d = []u8(8)
  applyReloc(LoRelocKind.Abs64, d, 0, RelocValues{ s: 0x1122334455667788, p: 0,
    gotSlot: 0, tpOffset: 0 }) catch e { panic("abs64: ${e.message()}") }
  assert(loRdU64(d, 0) == 0x1122334455667788)
  assert(int(d[0]) == 0x88 && int(d[7]) == 0x11) // little-endian

  // pc32 = S - P.
  let d2 = []u8(4)
  applyReloc(LoRelocKind.Pc32, d2, 0, RelocValues{ s: 0x1000, p: 0x1010,
    gotSlot: 0, tpOffset: 0 }) catch e { panic("pc32: ${e.message()}") }
  assert(loRdI32(d2, 0) == 0 - 16)

  // BL forward 16 bytes == the system assembler's `bl .+16`.
  assert(stApply(LoRelocKind.Aarch64Call26, 0x94000000,
    RelocValues{ s: 0x100000010, p: 0x100000000, gotSlot: 0, tpOffset: 0 }) == 0x94000004)
  // B backward 16 bytes == `b .-16`. The opcode bits above imm26 are preserved.
  assert(stApply(LoRelocKind.Aarch64Jump26, 0x14000000,
    RelocValues{ s: 0x100000000, p: 0x100000010, gotSlot: 0, tpOffset: 0 }) == 0x17fffffc)

  // ADRP: (page(S) - page(P)) >> 12, immlo at [30:29] and immhi at [23:5].
  assert(stApply(LoRelocKind.Aarch64AdrPrelPgHi21, 0x90000000,
    RelocValues{ s: 0x100004000, p: 0x100000000, gotSlot: 0, tpOffset: 0 }) == 0x90000020)
  // A negative page delta sign-extends through immhi.
  assert(stApply(LoRelocKind.Aarch64AdrPrelPgHi21, 0x90000000,
    RelocValues{ s: 0x100000000, p: 0x100004000, gotSlot: 0, tpOffset: 0 }) == 0x90ffffe0)
  // Same page: zero immediate.
  assert(stApply(LoRelocKind.Aarch64AdrPrelPgHi21, 0x90000000,
    RelocValues{ s: 0x100000abc, p: 0x100000fff, gotSlot: 0, tpOffset: 0 }) == 0x90000000)

  // add x0, x0, #2748 == `add x0, x0, #0xabc`.
  assert(stApply(LoRelocKind.Aarch64AddAbsLo12Nc, 0x91000000,
    RelocValues{ s: 0x100004abc, p: 0, gotSlot: 0, tpOffset: 0 }) == 0x912af000)
  // ldr x1, [x0, #2744]: the imm12 is SCALED by the access size (>>3).
  assert(stApply(LoRelocKind.Aarch64Ldst64AbsLo12Nc, 0xf9400001,
    RelocValues{ s: 0x100004ab8, p: 0, gotSlot: 0, tpOffset: 0 }) == 0xf9455c01)
  // The same low bits at a different scale land differently — that is the whole
  // reason the reader decodes the instruction to recover the scale.
  assert(stApply(LoRelocKind.Aarch64Ldst8AbsLo12Nc, 0x39400000,
    RelocValues{ s: 0x100004ab8, p: 0, gotSlot: 0, tpOffset: 0 }) == 0x396ae000)

  // The GOT/TLVP kinds address their indirection slot, NOT the symbol.
  assert(stApply(LoRelocKind.Aarch64AdrGotPage, 0x90000000,
    RelocValues{ s: 0xdeadbeef, p: 0x100000000, gotSlot: 0x100004000, tpOffset: 0 }) == 0x90000020)
  assert(stApply(LoRelocKind.Aarch64Ld64GotLo12Nc, 0xf9400000,
    RelocValues{ s: 0xdeadbeef, p: 0, gotSlot: 0x100004ab8, tpOffset: 0 }) == 0xf9455c00)

  // AArch64 local-exec TLS: the pair splits a 24-bit thread-pointer offset into
  // bits [23:12] and [11:0] of two ADD immediates.
  assert(stApply(LoRelocKind.TlsleAddTprelHi12, 0x91000000,
    RelocValues{ s: 0, p: 0, gotSlot: 0, tpOffset: 0x123456 }) == 0x91000000 | (0x123 << 10))
  assert(stApply(LoRelocKind.TlsleAddTprelLo12Nc, 0x91000000,
    RelocValues{ s: 0, p: 0, gotSlot: 0, tpOffset: 0x123456 }) == 0x91000000 | (0x456 << 10))
}

function checkRelocRanges() {
  // A branch target must be 4-aligned.
  assert(stApplyErr(LoRelocKind.Aarch64Call26, 0x94000000,
    RelocValues{ s: 0x100000002, p: 0x100000000, gotSlot: 0, tpOffset: 0 }) == "UnsupportedRelocation")
  // imm26 covers +/-128MB; beyond that the branch cannot encode and must not
  // silently truncate.
  assert(stApplyErr(LoRelocKind.Aarch64Call26, 0x94000000,
    RelocValues{ s: 0x108000000, p: 0x100000000, gotSlot: 0, tpOffset: 0 }) == "RelocationOutOfRange")
  // The largest in-range forward branch encodes fine.
  assert(stApplyErr(LoRelocKind.Aarch64Call26, 0x94000000,
    RelocValues{ s: 0x100000000 + (1 << 27) - 4, p: 0x100000000, gotSlot: 0, tpOffset: 0 }) == "")

  // ADRP covers +/-4GB.
  assert(stApplyErr(LoRelocKind.Aarch64AdrPrelPgHi21, 0x90000000,
    RelocValues{ s: 0x300000000, p: 0x100000000, gotSlot: 0, tpOffset: 0 }) == "RelocationOutOfRange")
  // pc32 must fit a signed 32-bit displacement.
  assert(stApplyErr(LoRelocKind.Pc32, 0,
    RelocValues{ s: 0x200000000, p: 0, gotSlot: 0, tpOffset: 0 }) == "RelocationOutOfRange")
  // A local-exec TLS offset past 24 bits cannot encode.
  assert(stApplyErr(LoRelocKind.TlsleAddTprelHi12, 0x91000000,
    RelocValues{ s: 0, p: 0, gotSlot: 0, tpOffset: 1 << 24 }) == "RelocationOutOfRange")
}

function checkRelocPredicates() {
  // The driver pre-scans kept atoms with these to size the GOT and the
  // __thread_ptr table.
  assert(needsGot(LoRelocKind.Got32) && needsGot(LoRelocKind.Aarch64AdrGotPage))
  assert(needsGot(LoRelocKind.Aarch64Ld64GotLo12Nc))
  assert(!needsGot(LoRelocKind.Abs64) && !needsGot(LoRelocKind.Aarch64Call26))
  assert(!needsGot(LoRelocKind.Aarch64TlvpAdrPage21)) // TLVP is its own table

  assert(needsTlvp(LoRelocKind.Aarch64TlvpAdrPage21))
  assert(needsTlvp(LoRelocKind.Aarch64TlvpLd64Lo12))
  assert(!needsTlvp(LoRelocKind.Aarch64AdrGotPage))

  assert(isTlsKind(LoRelocKind.Tpoff32) && isTlsKind(LoRelocKind.TlsleAddTprelHi12))
  assert(isTlsKind(LoRelocKind.TlsleAddTprelLo12Nc))
  assert(!isTlsKind(LoRelocKind.Abs64))
  // A TLVP kind resolves through a slot, not a thread-pointer offset.
  assert(!isTlsKind(LoRelocKind.Aarch64TlvpAdrPage21))
}
