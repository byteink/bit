// compiler/pmcliaddedgecheck.bit — `bit add` edge-case and security self-
// checks, split off compiler/pmclicheck.bit under the 800-line limit (#2967
// — pmclicheck.bit crossed it again after #2244 landed dependency-spec
// forms). Same module, sibling file: this reuses pmclicheck.bit's
// `import { contains } from "std/strings"` / `import { readDir } from
// "std/fs"` and its shared fixtures (`pmCliDeadAddResult`, `PmCliProject`,
// `pmCliBuildProject`) unqualified — an import is per-MODULE, not per-file,
// so re-importing either name here would be `E0042 already declared in this
// scope`. Run via `checkPmCli()` (pmclicheck.bit), not on its own.

// #2244 acceptance: a GitLab-style nested-group direct spec fetches and
// caches correctly with a multi-segment `owner` — the cache directory nests
// one level deeper (`<cacheRoot>/<host>/<group>/<subgroup>/<repo>/<sha>`)
// and `bit.lock` records the derived nested-group URL.
fn checkPmCliAddNestedGroupHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "group/subgroup", "nested", true, "main", url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency (nested group) failed: " + e.message())
  }
  assert(result.name == "nested")
  assert(result.commit == fx.sha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].url == url)

  let wantDir = cacheRoot + "/local/group/subgroup/nested/" + fx.sha
  assert(exists(wantDir + "/hello.txt"))
}

// #2244 acceptance: an explicit ssh:// spec's derived URL is what gets
// RECORDED in bit.lock, while the actual fetch reaches wherever `fetchUrl`
// points — the same "an override never leaks into bit.lock" contract
// `addCmd`'s `--url` escape hatch already guarantees for the https direct
// form, exercised here with a real fetch (via a `file://` fixture standing
// in for the ssh remote) rather than merely asserted. `pkgUrlHostOwnerRepo`
// (projectpkg.bit) must decompose the recorded `ssh://` URL back to the exact
// host/owner/repo the fetch used, proving the BUILD-time resolver
// understands it too, not just the writer.
fn checkPmCliAddSshUrlRecorded() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let fetchUrl = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let sshUrl = sshDepUrl("git", "example.internal", "owner", "sshdep")
  assert(sshUrl == "ssh://git@example.internal/owner/sshdep")

  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "example.internal", "owner", "sshdep", true, "main", sshUrl, fetchUrl,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency (ssh url) failed: " + e.message())
  }
  assert(result.commit == fx.sha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].url == sshUrl)

  let (h, o, r, ok) = pkgUrlHostOwnerRepo(sshUrl)
  assert(ok)
  assert(h == "example.internal")
  assert(o == "owner")
  assert(r == "sshdep")
}

// A fixture git repo whose OWN `bit.json` declares a local-path dependency
// of its own — the "malicious remote package" shape #2244's transitive ban
// (`resolveTransitiveSpec`, pmz.bit) exists to refuse. The path it names is
// deliberately never expected to exist ("should-never-be-touched"): the ban
// fires at spec-classification time, before any filesystem access, so the
// fixture never needs to point at anything real to prove the point.
fn pmCliBuildMaliciousRequireFixture(root: string): PmFixture {
  let dir = root + "/malicious.git"
  let mkInit = runGit(defaultGitBin, ["init", "--quiet", "-b", "main", dir], pmCheckTimeoutMs) catch e {
    panic("pmclicheck: git init (malicious fixture) failed: " + e.message())
  }
  pmGitMustSucceed("init", mkInit)
  runGit(
    defaultGitBin,
    ["-C", dir, "config", "user.email", "pmclicheck@example.com"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git config user.email (malicious fixture) failed: " + e.message())
  }
  runGit(defaultGitBin, ["-C", dir, "config", "user.name", "pmclicheck"], pmCheckTimeoutMs) catch e {
    panic("pmclicheck: git config user.name (malicious fixture) failed: " + e.message())
  }
  writeFile(
    dir + "/bit.json",
    "{\"dependencies\":{\"evil\":\"../../should-never-be-touched\"}}\n",
  ) catch e {
    panic("pmclicheck: cannot write malicious bit.json: " + e.message())
  }
  writeFile(dir + "/lib.bit", "export fn hi(): string {\n  return \"hi\"\n}\n") catch e {
    panic("pmclicheck: cannot write malicious fixture module: " + e.message())
  }
  let add = runGit(defaultGitBin, ["-C", dir, "add", "-A"], pmCheckTimeoutMs) catch e {
    panic("pmclicheck: git add (malicious fixture) failed: " + e.message())
  }
  pmGitMustSucceed("add", add)
  let commit = runGit(
    defaultGitBin,
    ["-C", dir, "commit", "--quiet", "-m", "malicious fixture"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git commit (malicious fixture) failed: " + e.message())
  }
  pmGitMustSucceed("commit", commit)
  let sha = revParseHead(defaultGitBin, dir, pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot read malicious fixture HEAD: " + e.message())
  }
  return PmFixture{ dir: dir, sha: sha }
}

// #2244 SECURITY (the load-bearing negative fixture): a fetched dependency
// that names a local-path/"file://" dependency in ITS OWN bit.json must
// never have that requirement silently followed — `bit add`/`bit up` of the
// OUTER dependency fails loudly instead, and NOTHING is written: no
// bit.lock entry even for the outer dependency itself, since
// `resolveTransitiveDeps` runs (and fails) before `writeLock`.
fn checkPmCliTransitiveLocalDependencyBanned() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmCliBuildMaliciousRequireFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let errMsg = pmCliTryAddMessage(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "malicious", "main", url, url,
    pmCheckTimeoutMs,
  )
  assert(len(errMsg) > 0)
  assert(contains(errMsg, "local filesystem"))
  assert(contains(errMsg, "evil"))
  assert(contains(errMsg, "only allowed directly"))

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 0)

  let bitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read bit.json: " + e.message())
  }
  assert(!contains(bitJson, "malicious"))
}

// #2751: `bit add` in a directory with no bit.json must fail before any
// fetch, resolve or write — leaving no bit.lock and no other change to the
// directory at all. `host`/`owner`/`repo`/`url` below are deliberately an
// unreachable `file://` path that is never created: if the bit.json-exists
// precondition ever again ran AFTER the fetch instead of before it (the
// exact regression this guards), the failure would come from git/fetch
// machinery — a different message, never "does not exist" — so asserting
// the message's exact shape is itself part of proving the ordering, not
// just the absence of bit.lock.
fn checkPmCliAddMissingManifestLeavesNoDebris() {
  let root = pmCheckScratchDir()
  let dir = root + "/no-manifest-project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create no-manifest project dir: " + e.message())
  }
  writeFile(dir + "/main.bit", "// bystander file — must survive untouched\n") catch e {
    panic("pmclicheck: cannot write bystander main.bit: " + e.message())
  }
  let before = readDir(dir) catch e {
    panic("pmclicheck: cannot list no-manifest project dir: " + e.message())
  }

  let unreachable = "file:///pmclicheck-2751-unreachable"
  let message = pmCliTryAddMessage(
    dir, root + "/cache-missing-manifest", defaultGitBin,
    "local.invalid", "pmclicheck", "never-fetched", "main",
    unreachable, unreachable, pmCheckTimeoutMs,
  )
  assert(len(message) > 0)
  assert(contains(message, "does not exist"))
  // Exactly one `bit add: ` prefix end to end: `addCmd` (pmcli.bit) adds its
  // own single prefix on the way out to the terminal; this message, still
  // one level below that, must carry none of its own (#2751 — it used to,
  // doubling into "bit add: bit add: ...").
  assert(!contains(message, "bit add:"))

  assert(!exists(dir + "/bit.lock"))
  let after = readDir(dir) catch e {
    panic("pmclicheck: cannot re-list no-manifest project dir: " + e.message())
  }
  assert(len(after) == len(before))
  let i = 0
  while (i < len(after)) {
    assert(after[i] == before[i])
    i = i + 1
  }
}

// Same as `checkPmCliAddMissingManifestLeavesNoDebris` above, for a
// `bit.json` that EXISTS but fails to parse — the other half of the same
// precondition (`checkManifestExists`, pmcliaddref.bit), checked before the
// identical fetch/resolve/write sequence.
fn checkPmCliAddInvalidManifestLeavesNoDebris() {
  let root = pmCheckScratchDir()
  let dir = root + "/invalid-manifest-project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create invalid-manifest project dir: " + e.message())
  }
  let bitJsonPath = dir + "/bit.json"
  writeFile(bitJsonPath, "{ this is not valid json") catch e {
    panic("pmclicheck: cannot write invalid bit.json: " + e.message())
  }
  let before = readFile(bitJsonPath) catch e {
    panic("pmclicheck: cannot read invalid bit.json before add: " + e.message())
  }

  let unreachable = "file:///pmclicheck-2751-unreachable"
  let message = pmCliTryAddMessage(
    dir, root + "/cache-invalid-manifest", defaultGitBin,
    "local.invalid", "pmclicheck", "never-fetched", "main",
    unreachable, unreachable, pmCheckTimeoutMs,
  )
  assert(len(message) > 0)
  assert(contains(message, "json:"))
  assert(!contains(message, "bit add:"))

  assert(!exists(dir + "/bit.lock"))
  let after = readFile(bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read invalid bit.json after add: " + e.message())
  }
  assert(after == before)
}

// #2245: `rewriteManifest` on a `bit.json` with NO "dependencies" key at all
// (the shape every hand-written first manifest has — there is no `bit init`)
// must still write syntactically valid JSON. Before the fix, the FIRST-EVER
// `bit add` into such a manifest left a trailing comma before the closing
// `}` — `stdlib/json`'s CST edit layer builds a missing intermediate object
// via a path (`emptyCstObject`/`appendGapSlot`/the printer's `gapForIndex`)
// whose freshly-created tail gap the printer cannot tell apart from an
// ordinary between-entries gap, so it synthesizes a comma before the close as
// if another sibling followed. `rewriteManifest`'s `ensureDependenciesObject`
// pre-seeds a REAL empty `"dependencies": {}` (the same shape `cstParse`
// itself produces for `{}` in source) before `cstSetStringPath` ever runs, so
// that path is never exercised. Asserted on the actual bytes written AND by
// re-parsing them with the compiler's own strict JSON reader (`jsonParse`,
// compiler/json.bit) — a file that merely "looks right" is not evidence.
fn checkPmCliRewriteManifestNoDependenciesKey() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let dir = root + "/nodeps-project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create nodeps project dir: " + e.message())
  }
  let path = dir + "/bit.json"
  writeFile(path, "{\n  \"name\": \"app\",\n  \"version\": \"0.1.0\"\n}\n") catch e {
    panic("pmclicheck: cannot write nodeps bit.json: " + e.message())
  }

  rewriteManifest(dir, "textutil", "github.com/x/textutil@v0.1.0") catch e {
    panic("pmclicheck: rewriteManifest (no dependencies key) failed: " + e.message())
  }

  let updated = readFile(path) catch e {
    panic("pmclicheck: cannot read updated bit.json: " + e.message())
  }
  // Byte-level: no trailing comma directly before a closing brace anywhere —
  // the exact shape of #2245's bug — checked before trusting any parser to
  // tell us the same thing.
  assert(!contains(updated, ",}"))
  assert(!contains(updated, ",\n}"))
  assert(!contains(updated, ", }"))

  // Re-parse with the compiler's own strict reader: valid JSON, the
  // "dependencies" object present, and the one entry set to exactly what was
  // requested.
  let doc = jsonParse(updated)
  assert(doc.ok)
  assert(jsonKindOf(doc, doc.root) == JsonKind.Obj)
  let depsId = jsonGet(doc, doc.root, "dependencies")
  assert(depsId >= 0)
  assert(jsonKindOf(doc, depsId) == JsonKind.Obj)
  assert(jsonStrOf(doc, jsonGet(doc, depsId, "textutil")) == "github.com/x/textutil@v0.1.0")
}

// Adds one more empty commit to the fixture repo at `dir`, tagged `tag`
// (annotated — `-a`/`-m`, matching `checkPmCliVersionConflict`'s own
// convention below), and returns the new commit's own 40-hex sha.
fn pmCliCommitAndTag(dir: string, message: string, tag: string): string {
  let commit = runGit(
    defaultGitBin,
    ["-C", dir, "commit", "--quiet", "--allow-empty", "-m", message],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git commit (${message}) failed: " + e.message())
  }
  pmGitMustSucceed("commit ${message}", commit)
  let t = runGit(defaultGitBin, ["-C", dir, "tag", "-a", tag, "-m", tag], pmCheckTimeoutMs) catch e {
    panic("pmclicheck: git tag ${tag} failed: " + e.message())
  }
  pmGitMustSucceed("tag ${tag}", t)
  return revParseHead(defaultGitBin, dir, pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot read HEAD after tagging ${tag}: " + e.message())
  }
}

// #2367 row 1: a bare `bit add <name>` (no `@ref` at all — `hasRef: false`)
// resolves the HIGHEST available version TAG (`listVersions`, #2365) and
// writes a caret constraint — never a branch tip or `HEAD` (the ticket's own
// constraint: "must NOT resolve a branch or HEAD"), and never the resolved
// commit sha the pre-#2367 default wrote. Three tags across three commits,
// chronologically OUT of semver order (`v1.2.0` is the newest COMMIT, not
// the highest version) — picking the newest commit instead of the highest
// version would be caught by the commit/spec assertions below.
fn checkPmCliAddDefaultRef() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let tagV1 = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "v1.0.0", "-m", "v1.0.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git tag v1.0.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag v1.0.0", tagV1)
  let sha14 = pmCliCommitAndTag(fx.dir, "second commit", "v1.4.0")
  let sha12last = pmCliCommitAndTag(fx.dir, "third commit", "v1.2.0")
  assert(isFullSha(sha12last))

  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", false, "", url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency (default ref) failed: " + e.message())
  }
  assert(result.commit == sha14)
  assert(result.specRef == "local/pmclicheck/fixture@^1.4.0")

  let newBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read updated bit.json: " + e.message())
  }
  assert(contains(newBitJson, "\"fixture\": \"local/pmclicheck/fixture@^1.4.0\""))

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].commit == sha14)
}

// A version-shaped ref that undercuts an existing locked dependency's own
// transitive requirement fails loudly rather than silently locking the lower
// version — MVS's rule (spec §17.7 point 2).
//
// #2250: the seeded `requires` entry used to be a bare `"v2.0.0"` and the ref
// under test a tag ("v1.0.0") the fixture never actually tagged — so
// `addDependency` failed regardless, on "no ref 'v1.0.0'", not on the MVS
// conflict this test claims to cover; `assert(failed)` passed VACUOUSLY, both
// before and after the bug this ticket fixed (`pmToRequirements`/
// `pmExistingRequirementsFor` reading the wrong string, see
// `checkPmCliPendingVersionTag` below). Fixed two ways: the fixture is
// actually tagged `v1.0.0` here, and the seed's `ref` is a realistic FULL
// spec (`LockRequire.ref`'s real shape, pmlock.bit) rather than a bare
// version — the exact shape that made the pre-#2250 extraction silently
// match nothing. The error message assertion pins the FAILURE REASON, so a
// future regression that makes this vacuous again (fails for some unrelated
// cause) is caught instead of passing by accident.
fn checkPmCliVersionConflict() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  // Annotated (`-a` with `-m`), not a bare `git tag`: this machine's own
  // `tag.gpgsign true` (the same trap #2257/#2064 name) turns even a bare
  // `git tag` into one that demands a message, so this spells it out rather
  // than relying on that default.
  let tag = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "v1.0.0", "-m", "v1.0.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git tag v1.0.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag v1.0.0", tag)

  let seed = []LockEntry(0)
  seed = append(
    seed, LockEntry{
      name: "other", url: "https://example.com/other.git", commit: fx.sha,
      requires: [LockRequire{ name: "fixture", ref: "github.com/pmclicheck/fixture@v2.0.0" }],
    },
  )
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let failed = false
  let errMsg = ""
  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", true, "v1.0.0", url, url,
    pmCheckTimeoutMs,
  ) catch e {
    failed = true
    errMsg = e.message()
    pmCliDeadAddResult()
  }
  assert(failed)
  assert(len(result.name) == 0)
  assert(contains(errMsg, "fixture"))
  assert(contains(errMsg, "v2.0.0"))
  assert(contains(errMsg, "conflicts"))
}

// #2253: two UNRELATED repos that happen to share a last path segment (the
// bare repo name `addDependency` keys `bit.json`/`bit.lock` by) must not
// silently swap each other's entry. `resolveDependency` now runs
// `checkResolvedUrlMatches` (pmfetchresolve.bit) — already used on the vanity path —
// BEFORE the direct-spec path ever fetches, so the second `addDependency`
// call here (same `name` == "fixture", a DIFFERENT underlying repo/url) must
// fail naming the URL bit.lock already records, and the first entry must
// survive untouched.
fn checkPmCliDirectSpecUrlCollision() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fxA = pmBuildFixture(root + "/a")
  let fxB = pmBuildFixture(root + "/b")
  let urlA = "file://" + fxA.dir
  let urlB = "file://" + fxB.dir
  assert(urlA != urlB)
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let first = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "ownerA", "fixture", true, "main", urlA, urlA,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: first addDependency (url collision fixture) failed: " + e.message())
  }
  assert(first.commit == fxA.sha)

  let failed = false
  let errMsg = ""
  let second = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "ownerB", "fixture", true, "main", urlB, urlB,
    pmCheckTimeoutMs,
  ) catch e {
    failed = true
    errMsg = e.message()
    pmCliDeadAddResult()
  }
  assert(failed)
  assert(len(second.name) == 0)
  assert(contains(errMsg, "fixture"))
  assert(contains(errMsg, urlA))
  assert(contains(errMsg, urlB))

  // The first entry survives untouched — never silently swapped.
  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "fixture")
  assert(entries[0].url == urlA)
  assert(entries[0].commit == fxA.sha)
}
