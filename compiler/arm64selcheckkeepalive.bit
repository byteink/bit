// In-Bit self-checks for #4467: a keepalive edge names ONE value, and the base
// it roots must outlive everything transitively DERIVED from that value.
//
// Split into its own file because compiler/arm64selcheckgen.bit — which holds
// #4406's `checkKeepAliveInterval` and #4431's `checkStringUnboxKeepAlive` —
// is 785 lines against the 800-line limit (spec/LINT.md E0200) and cannot take
// another fixture. Same split compiler/arm64selcheckcmp.bit (#4349) and
// compiler/arm64selcheckpoll.bit (#4457) already made, and the same module as
// selfcheck.bit (#1503), so every name resolves unchanged.
//
// WHAT THESE PIN, AND WHY THE GOLDEN CASE IS NOT ENOUGH ON ITS OWN.
// `_tests_/cases/run_ptrof_interior_keepalive.bit` proves the whole path end to
// end, but only while the register allocator keeps choosing to reuse the dead
// base's register: root class 8's conservative scan of the live stack finds a
// base that merely happens to still be sitting in a callee-saved register, and
// that is exactly how `run_exploded_pair_keepalive.bit`'s `localCtor` arm
// passed for years without proving anything. These two assertions read the live
// intervals directly, so no allocation decision can mask them.

// The straight-line chain, which is what `ptrOf(s) + 1` lowers to (SPEC §11.4):
// `field_get` -> `convert` -> `add`, with the edge recorded on the `convert`
// (compiler/lowerprim.bit) and the `add` the value read after the call.
//
// The load-bearing assertion is the THIRD one. Extending the base to its edge
// partner's own end — which is all `extendKeepAlive` did before #4467 — stops
// at 4, one instruction short of the safepoint at 5. Only the closure reaches
// 6, so an implementation that drops it fails here rather than somewhere in the
// collector.
fn checkDerivedChainKeepAlive() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let slicet = mkSlice(ctx, i64t)
  let ptrt = mkPtr(ctx, i64t)
  let fg = mkInstr(Op.FieldGet, i64t)
  fg.lhs = 0
  let cv = mkInstr(Op.Convert, ptrt)
  cv.lhs = 1
  let k8 = mkInstr(Op.ConstInt, ptrt)
  k8.ival = 8
  let add = mkInstr(Op.Add, ptrt)
  add.lhs = 2
  add.rhs = 3
  let call = mkInstr(Op.Call, i64t)
  call.name = "sink"
  let deref = mkInstr(Op.FieldGet, i64t)
  deref.lhs = 4
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [6]
  let blocks = [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 8 }]
  let instrs = [mkInstr(Op.BlockParam, slicet), fg, cv, k8, add, call, deref, ret]
  let f = IrFunc{ name: "chain", paramTypes: [slicet], result: i64t,
    blocks: blocks, instrs: instrs, isFallible: false, keepAlive: [2, 0] }

  let held = buildIntervals(ctx, f)
  assert(held.intervals[0].isRef, "the base must be a GC reference")
  assert(len(held.safepoints) == 1 && held.safepoints[0] == 5, "one safepoint, at the call")
  assert(held.intervals[2].end == 4, "the edge's own derived value dies at the add: ${held.intervals[2].end}")
  assert(held.intervals[0].end == 6, "the base must reach the DERIVED pointer's last read: ${held.intervals[0].end}")
  assert(held.intervals[0].start <= 5 && held.intervals[0].end > 5, "the safepoint must fall inside the base's range")

  // The control: the IDENTICAL instruction stream with no edge recorded, which
  // is what removing `builderKeepAlive` from `lowerPtrOf` produces. The base
  // collapses to `forceParamInterference`'s block-0 fence and is dead at the
  // call — the measured `interior=0` of the golden case.
  let bare = buildIntervals(ctx, IrFunc{ name: "bare", paramTypes: [slicet],
    result: i64t, blocks: blocks, instrs: instrs, isFallible: false })
  assert(bare.intervals[0].end < 5, "without the edge the base must NOT reach the call: ${bare.intervals[0].end}")
}

// The same question across a BLOCK PARAMETER, which is how a pointer computed
// before a loop reaches its use inside one. `instrOperands` cannot see this
// hop: a terminator's arguments are operands of the TERMINATOR, and a
// terminator is not a pointer, so the closure has to walk the edge itself.
fn checkDerivedParamKeepAlive() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let slicet = mkSlice(ctx, i64t)
  let ptrt = mkPtr(ctx, i64t)
  let fg = mkInstr(Op.FieldGet, i64t)
  fg.lhs = 0
  let cv = mkInstr(Op.Convert, ptrt)
  cv.lhs = 1
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 1
  jmp.args = [2]
  let call = mkInstr(Op.Call, i64t)
  call.name = "sink"
  let deref = mkInstr(Op.FieldGet, i64t)
  deref.lhs = 4
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [6]
  let blocks = [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 4 },
    IrBlock{ instsStart: 4, paramCount: 1, instsLen: 4 }]
  let instrs = [mkInstr(Op.BlockParam, slicet), fg, cv, jmp,
    mkInstr(Op.BlockParam, ptrt), call, deref, ret]
  let f = IrFunc{ name: "thread", paramTypes: [slicet], result: i64t,
    blocks: blocks, instrs: instrs, isFallible: false, keepAlive: [2, 0] }

  let held = buildIntervals(ctx, f)
  assert(len(held.safepoints) == 1 && held.safepoints[0] == 5, "one safepoint, at the call")
  assert(held.intervals[0].end == 6, "the base must reach the param's last read: ${held.intervals[0].end}")

  let bare = buildIntervals(ctx, IrFunc{ name: "bare", paramTypes: [slicet],
    result: i64t, blocks: blocks, instrs: instrs, isFallible: false })
  assert(bare.intervals[0].end < 5, "without the edge the base must NOT reach the call: ${bare.intervals[0].end}")
}
