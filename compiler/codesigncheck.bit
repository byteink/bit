// In-Bit self-checks for the ad-hoc Mach-O code signature. Split out of
// selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

// Stage 3 (#1344) ad-hoc code signing. Ports the seed's two tests. The expected
// page hashes were computed by Python's hashlib (an implementation independent
// of Bit's own SHA-256), over a PAGE-DEPENDENT byte pattern: the seed's test
// uses `byte i = i & 0xff`, which repeats every 256 bytes, so with a 4096-byte
// page its two full pages hash identically and slot 0 cannot be told from
// slot 1. This pattern makes all three slots distinct.

fn csBE32At(b: []u8, off: int): int {
  return (int(b[off]) << 24) | (int(b[off + 1]) << 16) | (int(b[off + 2]) << 8) |
    int(b[off + 3])
}

fn csBE64At(b: []u8, off: int): int {
  return (csBE32At(b, off) << 32) | csBE32At(b, off + 4)
}

// Two full pages plus a 555-byte partial one: exercises the slot-count rounding
// and the partial last page being hashed over its real bytes only.
fn csTestFile(): []u8 {
  let n = 2 * csPageSize() + 555
  let f = []u8(n)
  let i = 0
  while (i < n) {
    f[i] = u8((i + (i / csPageSize()) * 17) & 255)
    i = i + 1
  }
  return f
}

fn csAssertHash(sig: []u8, cd: int, hashOffset: int, slot: int, want: []u8) {
  let i = 0
  while (i < 32) {
    assert(sig[cd + hashOffset + slot * 32 + i] == want[i])
    i = i + 1
  }
}

fn checkCodeSignature() {
  let file = csTestFile()
  let sig = buildCodeSignature(file, "bit-test", len(file))

  // The size the executable writer reserves must match what gets emitted, to the
  // byte — it sets LC_CODE_SIGNATURE.datasize before the blob exists.
  assert(codeSignatureSize(len(file), "bit-test") == len(sig))
  assert(len(sig) == 20 + 88 + 9 + 3 * 32)

  // SuperBlob: magic, its own length, one contained blob at the header's end.
  assert(csBE32At(sig, 0) == 0xfade0cc0)
  assert(csBE32At(sig, 4) == len(sig))
  assert(csBE32At(sig, 8) == 1)
  assert(csBE32At(sig, 12) == 0)  // CSSLOT_CODEDIRECTORY
  assert(csBE32At(sig, 16) == 20) // the CD follows the SuperBlob header

  // CodeDirectory.
  let cd = superblobHeaderSize()
  assert(csBE32At(sig, cd + 0) == 0xfade0c02)
  assert(csBE32At(sig, cd + 4) == len(sig) - 20)
  assert(csBE32At(sig, cd + 8) == 0x20400) // the version AMFI needs on arm64
  assert(csBE32At(sig, cd + 12) == 0x0002) // CS_ADHOC: no identity, page hashes only
  let hashOffset = csBE32At(sig, cd + 16)
  assert(hashOffset == 88 + 9)
  assert(csBE32At(sig, cd + 20) == 88)  // identOffset
  assert(csBE32At(sig, cd + 24) == 0)   // nSpecialSlots
  assert(csBE32At(sig, cd + 28) == 3)   // nCodeSlots: 2 full pages + 1 partial
  assert(csBE32At(sig, cd + 32) == len(file))
  assert(int(sig[cd + 36]) == 32) // hashSize
  assert(int(sig[cd + 37]) == 2)  // CS_HASHTYPE_SHA256
  assert(int(sig[cd + 38]) == 0)  // not a platform binary
  assert(int(sig[cd + 39]) == 12) // pageSize log2
  assert(csBE64At(sig, cd + 56) == 0) // codeLimit64 unused below 4 GiB
  assert(csBE64At(sig, cd + 64) == 0) // execSegBase: __TEXT starts at file offset 0
  assert(csBE64At(sig, cd + 72) == len(file)) // execSegLimit
  assert(csBE64At(sig, cd + 80) == 0x1)       // CS_EXECSEG_MAIN_BINARY

  // The identifier is NUL-terminated, right after the fixed header.
  assert(string(sig[cd + 88:cd + 88 + 8]) == "bit-test")
  assert(sig[cd + 88 + 8] == u8(0))

  // The page hashes the kernel will recompute. Independently derived.
  csAssertHash(sig, cd, hashOffset, 0, [u8(0xc8), u8(0xf5), u8(0xd0), u8(0x34),
    u8(0x1d), u8(0x54), u8(0xd9), u8(0x51), u8(0xa7), u8(0x1b), u8(0x13), u8(0x6e),
    u8(0x6e), u8(0x2a), u8(0xfc), u8(0xb1), u8(0x4d), u8(0x11), u8(0xed), u8(0x84),
    u8(0x89), u8(0xa7), u8(0xae), u8(0x12), u8(0x6a), u8(0x8f), u8(0xee), u8(0x0d),
    u8(0xf6), u8(0xec), u8(0xf1), u8(0x93)])
  csAssertHash(sig, cd, hashOffset, 1, [u8(0x1b), u8(0x9a), u8(0xea), u8(0x8f),
    u8(0xb4), u8(0x84), u8(0x10), u8(0xb0), u8(0xe7), u8(0xa5), u8(0x51), u8(0x7e),
    u8(0xbe), u8(0x8e), u8(0xb6), u8(0x0a), u8(0x99), u8(0xbf), u8(0x8f), u8(0xeb),
    u8(0x9c), u8(0xae), u8(0xd0), u8(0x5e), u8(0x9f), u8(0x7b), u8(0x6c), u8(0xdd),
    u8(0x85), u8(0xa5), u8(0xfe), u8(0x8c)])
  // The partial last page: hashed over its 555 real bytes, NOT a padded page.
  csAssertHash(sig, cd, hashOffset, 2, [u8(0x19), u8(0x45), u8(0x1e), u8(0xa1),
    u8(0x3b), u8(0xa6), u8(0x19), u8(0xa3), u8(0x00), u8(0x37), u8(0x07), u8(0x2c),
    u8(0x5b), u8(0x65), u8(0x40), u8(0xb6), u8(0xa7), u8(0x89), u8(0x79), u8(0xcb),
    u8(0x47), u8(0x0f), u8(0xba), u8(0x94), u8(0x3f), u8(0x64), u8(0xdc), u8(0xe3),
    u8(0xb9), u8(0x12), u8(0xc0), u8(0x7b)])
}

fn checkCodeSignatureSizing() {
  // Slot-count rounding at the page boundary: the reserved size must track it
  // exactly, or __LINKEDIT is mis-sized and the signature lands at the wrong
  // offset.
  assert(csNumCodeSlots(0) == 0)
  assert(csNumCodeSlots(1) == 1)
  assert(csNumCodeSlots(csPageSize()) == 1)
  assert(csNumCodeSlots(csPageSize() + 1) == 2)
  assert(csNumCodeSlots(2 * csPageSize()) == 2)

  // An exactly-one-page file: one slot, no partial.
  let onePage = []u8(csPageSize())
  let sig = buildCodeSignature(onePage, "x", len(onePage))
  assert(codeSignatureSize(csPageSize(), "x") == len(sig))
  assert(csBE32At(sig, superblobHeaderSize() + 28) == 1)

  // The identifier's length feeds the size, and it is stored NUL-terminated.
  assert(codeSignatureSize(csPageSize(), "abc") - codeSignatureSize(csPageSize(), "a") == 2)
}
