// Function-type parameter names describe positions without declaring values.
fn atNamedFunctionTypeParam(p: Parser): bool {
  return peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.Colon
}

fn parseFunctionTypeParam(p: Parser, named: bool): int {
  if (atNamedFunctionTypeParam(p) != named) {
    parseFail(p, "consistent function-type parameter names")
    return 0
  }
  if (!named) {
    return parseType(p)
  }
  let name = expectIdent(p)
  expect(p, Kind.Colon)
  let ty = parseType(p)
  // main=1 distinguishes documentation from declaration parameters (#7958).
  return mkNode(p, Tag.Param, 1, [name, ty])
}

fn finishParenType(p: Parser, items: []int, named: bool): int {
  if (acceptTok(p, Kind.FatArrow)) {
    let result = parseResultType(p)
    let list = mkNode(p, Tag.TypeList, 0, items)
    return mkNode(p, Tag.FuncType, 0, [list, result])
  }
  if (named) {
    parseFail(p, "'=>' after named function-type parameters")
    return 0
  }
  if (len(items) == 0) {
    return mkNode(p, Tag.VoidType, 0, []int(0))
  }
  if (len(items) == 1) {
    return items[0]
  }
  return mkNode(p, Tag.TupleType, 0, items)
}
