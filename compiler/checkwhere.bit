// A condition literal `{ authorId: user.id }` checked against the class its
// expected type `Where<T>` (std/where) names (SPEC §12.3.1, epic #6984).
//
// A bare `{k: v}` is a map literal everywhere else, so what makes this one a
// condition is only its EXPECTED type: `vExpectMapLit` (validate.bit) hands the
// literal here when `want` is `Where<T>`, and each key is then a field NAME of
// `T`, never a variable. The resolver cannot know that (it has no types), so
// `rResolveMapLit` (resolvebody.bit) leaves an unresolvable key identifier
// alone, and `vSweepWhereKeys` below reports it as the ordinary E0040 for every
// literal this file did not take.
//
// This file judges one condition literal's entries: a `field: value` entry
// (equality), a field whose value is an operator object, and a `related(...)`
// value, plus the `and`/`or`/`not` keys. The operator and `related` halves live
// in checkwhereops.bit. What neither covers (a key that is not an identifier,
// an empty operator object, a `related(...)` whose argument is not one string
// literal) stays E0303, never mis-checked.

// E0301: a key that is not a field of `T`, with the nearest field name as hint.
const ecWhereUnknownField = 301

// E0302: a value that is not assignable to its field's type; `nil` is a value
// only for an `Option` field.
const ecWhereValueType = 302

// E0303: an entry shape the condition literal does not cover.
const ecWhereUnsupported = 303

const whereClassName = "Where"

// What every entry of one literal is judged against: the `Where<T>` type the
// literal is expected to be (a nested `and`/`or`/`not` literal is judged as the
// same type), its `T`, and `T`'s declared field names.
class WhereScope {
  want: int,
  target: int,
  names: []string,
}

// `T` of an expected type `Where<T>`, or 0 for any other type. The class is
// told apart from a user's own `Where<T>` by its `clauses` field, the field
// std/where's `Where` is built around.
fn whereTarget(c: Checker, want: int): int {
  let idx = typeInstOfResult(c.ctx, want)
  if (idx < 0) {
    return 0
  }
  let inst = c.ctx.typeInsts[idx]
  if (inst.name != whereClassName || len(inst.args) != 1) {
    return 0
  }
  let (_, ok) = c.ctx.structFields["${want}.clauses"]
  if (!ok) {
    return 0
  }
  return inst.args[0]
}

// Every field name `target` declares, in declaration order.
fn whereFieldNames(c: Checker, target: int): []string {
  let names = []string(0)
  let decl = structDeclOf(c, target)
  if (decl == 0) {
    return names
  }
  let oc = typeOwner(c, target)
  for f of structFieldNodes(oc, decl) {
    let nameNode = getNode(oc.tree, kidsOf(oc.tree, f)[0])
    names = append(names, oc.source[nameNode.span.start:nameNode.span.end])
  }
  return names
}

fn whereNameIn(names: []string, name: string): bool {
  for n of names {
    if (n == name) {
      return true
    }
  }
  return false
}

fn reportWhereUnsupported(c: Checker, node: int, what: string) {
  report(
    c.diags, ecWhereUnsupported, vSpan(c, node),
    "a condition literal does not support ${what}",
    "write `field: value`, `field: { gte: value }`, `field: related(\"name\")`, or an `and`/`or`/`not` key",
  )
}

fn reportWhereUnknownField(c: Checker, node: int, target: int, names: []string, field: string) {
  let tn = typeName(c.ctx, target)
  let nearest = vClosestFieldName(names, field)
  if (nearest == "") {
    reportNoHint(c.diags, ecWhereUnknownField, vSpan(c, node), "${tn} has no field \"${field}\"")
    return
  }
  report(
    c.diags, ecWhereUnknownField, vSpan(c, node),
    "${tn} has no field \"${field}\"", "did you mean \"${nearest}\"?",
  )
}

// Where a value is going and what to tell the writer when it does not fit.
class WhereSlot {
  owner: string,
  ft: int,
  hint: string,
}

fn reportWhereValueType(c: Checker, node: int, slot: WhereSlot, got: int) {
  let found = "'${typeName(c.ctx, defaultType(c, got))}'"
  if (got == c.ctx.untypedNilId) {
    found = "nil, which only an Option field accepts"
  }
  report(
    c.diags, ecWhereValueType, vSpan(c, node),
    "${slot.owner} is '${typeName(c.ctx, slot.ft)}', found ${found}", slot.hint,
  )
}

// Is `val` fine for a field of type `ft`: assignable to it, or, for an
// `Option` field, to its payload (the implicit `Some`), or `nil`.
fn whereValueFits(c: Checker, val: int, got: int, ft: int): bool {
  if (got == c.ctx.untypedNilId) {
    return vIsOptionType(c, ft)
  }
  if (vAssignableNode(c, val, got, ft)) {
    return true
  }
  let inner = vOptionPayload(c, ft)
  return inner != 0 && vAssignableNode(c, val, got, inner)
}

// `val` against the slot `slot` describes: a value of the field's own type.
fn whereCheckAgainst(c: Checker, val: int, slot: WhereSlot) {
  let got = checkExprType(c, val)
  if (got == 0 || vMentionsInvalid(c, got, 0) || vMentionsInvalid(c, slot.ft, 0)) {
    return
  }
  if (!whereValueFits(c, val, got, slot.ft)) {
    reportWhereValueType(c, val, slot, got)
  }
}

const whereEqualityHint = "a condition entry compares the field with a value of the field's own type"

// A top-level key spelled like a combinator that `T` also declares as a field
// names the field. The writer who meant the combinator is told how to spell it.
fn whereFieldHint(c: Checker, target: int, field: string): string {
  if (field != "and" && field != "or" && field != "not") {
    return whereEqualityHint
  }
  let tn = typeName(c.ctx, target)
  return "`${field}` is a field of ${tn}, so this key names the field and never a combinator; build the combinator with std/where: Where<${tn}>(join = Join.Or, children = [...]) or Where<${tn}>(not = true, children = [...])"
}

// Marks every map literal of a list or condition operand a diagnostic is about
// to refuse, so the end-of-module sweeps do not also read its keys as variables.
fn whereQuietLits(c: Checker, node: int) {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.MapLit) {
    c.whereLits[node] = true
    c.containerLitTargeted[node] = true
    return
  }
  if (tag != Tag.SliceLit) {
    return
  }
  c.containerLitTargeted[node] = true
  for a of kidsOf(c.tree, node) {
    whereQuietLits(c, getNode(c.tree, a).tag == Tag.Arg ? kidsOf(c.tree, a)[0] : a)
  }
}

// A list or condition literal given to a field named like a combinator: the
// field wins (it is a key of `T`), the value is not its type, and the writer
// most likely meant the combinator, so the error says how to spell that.
fn whereReservedLit(c: Checker, val: int, field: string, slot: WhereSlot): bool {
  if (field != "and" && field != "or" && field != "not") {
    return false
  }
  let tag = getNode(c.tree, val).tag
  let kind = c.ctx.types[slot.ft].kind
  if ((tag != Tag.SliceLit && tag != Tag.MapLit) ||
    kind == TypeKind.Slice ||
    kind == TypeKind.Map) {
    return false
  }
  whereQuietLits(c, val)
  let shape = tag == Tag.SliceLit ? "a list" : "a condition literal"
  report(
    c.diags, ecWhereValueType, vSpan(c, val),
    "${slot.owner} is '${typeName(c.ctx, slot.ft)}', found ${shape}", slot.hint,
  )
  return true
}

// One `field: value` entry's value: an operator object, a `related(...)` call,
// or a plain value compared for equality. A field that is itself a map takes a
// `{...}` as its value, so only a non-map field reads one as an operator object.
fn checkWhereValue(c: Checker, val: int, target: int, field: string) {
  let (ft, ok) = c.ctx.structFields["${target}.${field}"]
  if (!ok) {
    return
  }
  let owner = "field \"${field}\" of ${typeName(c.ctx, target)}"
  let slot = WhereSlot{ owner = owner, ft = ft, hint = whereFieldHint(c, target, field) }
  if (whereReservedLit(c, val, field, slot)) {
    return
  }
  if (getNode(c.tree, val).tag == Tag.MapLit && c.ctx.types[ft].kind != TypeKind.Map) {
    checkWhereOps(c, val, slot)
    return
  }
  if (whereIsRelatedCall(c, val)) {
    checkWhereRelated(c, val, target, field, slot)
    return
  }
  whereCheckAgainst(c, val, slot)
}

// One `key: value` entry against `sc.target`'s fields. A key that is a field of
// `T` is that field, whatever its spelling; only a key that is not a field can
// be a combinator.
fn checkWhereEntry(c: Checker, entry: int, sc: WhereScope) {
  let ek = kidsOf(c.tree, entry)
  if (getNode(c.tree, ek[0]).tag != Tag.Ident) {
    reportWhereUnsupported(c, ek[0], "a key that is not a field name")
    return
  }
  let field = nodeText(c.tree, c.source, ek[0])
  if (whereNameIn(sc.names, field)) {
    vForeignFieldAccess(c, sc.target, field, ek[0])
    checkWhereValue(c, ek[1], sc.target, field)
    return
  }
  if (field == "and" || field == "or" || field == "not") {
    checkWhereCombinator(c, field, ek[1], sc.want)
    return
  }
  reportWhereUnknownField(c, ek[0], sc.target, sc.names, field)
}

// A map literal against the expected type `want`: true when `want` is a
// `Where<T>` and the literal was judged here, so the caller stops. The literal
// is marked as targeted so the end-of-module sweeps do not read its keys as
// map keys. A `T` that is not yet a concrete class (a type parameter inside a
// generic body) is judged per instantiation, not here.
fn vCheckWhereLit(c: Checker, node: int, want: int): bool {
  let target = whereTarget(c, want)
  if (target == 0) {
    return false
  }
  c.containerLitTargeted[node] = true
  c.whereLits[node] = true
  if (c.ctx.types[target].kind != TypeKind.Struct) {
    return true
  }
  let sc = WhereScope{ want = want, target = target, names = whereFieldNames(c, target) }
  for e of kidsOf(c.tree, node) {
    checkWhereEntry(c, e, sc)
  }
  return true
}

// A key identifier of a map literal the resolver left unresolved
// (resolvebody.bit's `rResolveMapLit`) in a literal that was NOT taken as a
// condition: the plain undefined name it always was.
fn vSweepWhereKeys(c: Checker, node: int) {
  if (c.whereLits[node] || len(c.nodeSymbols) == 0) {
    return
  }
  for e of kidsOf(c.tree, node) {
    let key = kidsOf(c.tree, e)[0]
    if (getNode(c.tree, key).tag != Tag.Ident || c.nodeSymbols[key] != 0) {
      continue
    }
    let name = nodeText(c.tree, c.source, key)
    if (name != "_") {
      reportNoHint(c.diags, ecUndefinedName, vSpan(c, key), "undefined name '${name}'")
    }
  }
}
