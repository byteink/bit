// A condition literal `{ authorId: user.id }` checked against the class its
// expected type `Where<T>` (std/where) names (SPEC §12.3.1, epic #6984).
//
// A bare `{k: v}` is a map literal everywhere else, so what makes this one a
// condition is only its EXPECTED type: `vExpectMapLit` (validate.bit) hands the
// literal here when `want` is `Where<T>`, and each key is then a field NAME of
// `T`, never a variable. The resolver cannot know that (it has no types), so
// `rResolveMapLit` (resolvebody.bit) leaves an unresolvable key identifier
// alone, and `vSweepWhereKeys` below reports it as the ordinary E0040 for every
// literal this file did not take.
//
// Only plain `field: value` equality entries are checked here. An operator
// object, an `and`/`or`/`not` key and `related(...)` are a later step of the
// same epic and are refused as E0303, never mis-checked.

// E0301: a key that is not a field of `T`, with the nearest field name as hint.
const ecWhereUnknownField = 301

// E0302: a value that is not assignable to its field's type; `nil` is a value
// only for an `Option` field.
const ecWhereValueType = 302

// E0303: an entry shape a plain equality literal does not cover yet.
const ecWhereUnsupported = 303

const whereClassName = "Where"

// `T` of an expected type `Where<T>`, or 0 for any other type. The class is
// told apart from a user's own `Where<T>` by its `clauses` field, the field
// std/where's `Where` is built around.
fn whereTarget(c: Checker, want: int): int {
  let idx = typeInstOfResult(c.ctx, want)
  if (idx < 0) {
    return 0
  }
  let inst = c.ctx.typeInsts[idx]
  if (inst.name != whereClassName || len(inst.args) != 1) {
    return 0
  }
  let (_, ok) = c.ctx.structFields["${want}.clauses"]
  if (!ok) {
    return 0
  }
  return inst.args[0]
}

// Every field name `target` declares, in declaration order.
fn whereFieldNames(c: Checker, target: int): []string {
  let names = []string(0)
  let decl = structDeclOf(c, target)
  if (decl == 0) {
    return names
  }
  let oc = typeOwner(c, target)
  for f of structFieldNodes(oc, decl) {
    let nameNode = getNode(oc.tree, kidsOf(oc.tree, f)[0])
    names = append(names, oc.source[nameNode.span.start:nameNode.span.end])
  }
  return names
}

fn whereNameIn(names: []string, name: string): bool {
  for n of names {
    if (n == name) {
      return true
    }
  }
  return false
}

fn reportWhereUnsupported(c: Checker, node: int, what: string) {
  report(
    c.diags, ecWhereUnsupported, vSpan(c, node),
    "a condition literal does not support ${what} yet",
    "write a plain `field: value` entry, which compares the field for equality",
  )
}

fn reportWhereUnknownField(c: Checker, node: int, target: int, names: []string, field: string) {
  let tn = typeName(c.ctx, target)
  let nearest = vClosestFieldName(names, field)
  if (nearest == "") {
    reportNoHint(c.diags, ecWhereUnknownField, vSpan(c, node), "${tn} has no field \"${field}\"")
    return
  }
  report(
    c.diags, ecWhereUnknownField, vSpan(c, node),
    "${tn} has no field \"${field}\"", "did you mean \"${nearest}\"?",
  )
}

fn reportWhereValueType(c: Checker, node: int, owner: string, ft: int, got: int) {
  let found = "'${typeName(c.ctx, defaultType(c, got))}'"
  if (got == c.ctx.untypedNilId) {
    found = "nil, which only an Option field accepts"
  }
  report(
    c.diags, ecWhereValueType, vSpan(c, node),
    "${owner} is '${typeName(c.ctx, ft)}', found ${found}",
    "a condition entry compares the field with a value of the field's own type",
  )
}

// The entry shapes a later step adds: a nested `{ ... }` operator object, or a
// `related(...)` call. Reported at the value; true when `val` is one.
fn whereUnsupportedValue(c: Checker, val: int): bool {
  let n = getNode(c.tree, val)
  if (n.tag == Tag.MapLit) {
    c.whereLits[val] = true
    reportWhereUnsupported(c, val, "operator objects")
    return true
  }
  if (n.tag == Tag.Call &&
    getNode(c.tree, kidsOf(c.tree, val)[0]).tag == Tag.Ident &&
    nodeText(c.tree, c.source, kidsOf(c.tree, val)[0]) == "related") {
    reportWhereUnsupported(c, val, "related(...)")
    return true
  }
  return false
}

// Is `val` fine for a field of type `ft`: assignable to it, or, for an
// `Option` field, to its payload (the implicit `Some`), or `nil`.
fn whereValueFits(c: Checker, val: int, got: int, ft: int): bool {
  if (got == c.ctx.untypedNilId) {
    return vIsOptionType(c, ft)
  }
  if (vAssignableNode(c, val, got, ft)) {
    return true
  }
  let inner = vOptionPayload(c, ft)
  return inner != 0 && vAssignableNode(c, val, got, inner)
}

fn checkWhereValue(c: Checker, val: int, target: int, field: string) {
  if (whereUnsupportedValue(c, val)) {
    return
  }
  let (ft, ok) = c.ctx.structFields["${target}.${field}"]
  let got = checkExprType(c, val)
  if (!ok || got == 0 || vMentionsInvalid(c, got, 0) || vMentionsInvalid(c, ft, 0)) {
    return
  }
  if (!whereValueFits(c, val, got, ft)) {
    reportWhereValueType(c, val, "field \"${field}\" of ${typeName(c.ctx, target)}", ft, got)
  }
}

// One `key: value` entry against `target`'s fields.
fn checkWhereEntry(c: Checker, entry: int, target: int, names: []string) {
  let ek = kidsOf(c.tree, entry)
  if (getNode(c.tree, ek[0]).tag != Tag.Ident) {
    reportWhereUnsupported(c, ek[0], "a key that is not a field name")
    return
  }
  let field = nodeText(c.tree, c.source, ek[0])
  if (!whereNameIn(names, field)) {
    if (field == "and" || field == "or" || field == "not") {
      reportWhereUnsupported(c, ek[0], "the '${field}' key")
      return
    }
    reportWhereUnknownField(c, ek[0], target, names, field)
    return
  }
  vForeignFieldAccess(c, target, field, ek[0])
  checkWhereValue(c, ek[1], target, field)
}

// A map literal against the expected type `want`: true when `want` is a
// `Where<T>` and the literal was judged here, so the caller stops. The literal
// is marked as targeted so the end-of-module sweeps do not read its keys as
// map keys. A `T` that is not yet a concrete class (a type parameter inside a
// generic body) is judged per instantiation, not here.
fn vCheckWhereLit(c: Checker, node: int, want: int): bool {
  let target = whereTarget(c, want)
  if (target == 0) {
    return false
  }
  c.containerLitTargeted[node] = true
  c.whereLits[node] = true
  if (c.ctx.types[target].kind != TypeKind.Struct) {
    return true
  }
  let names = whereFieldNames(c, target)
  for e of kidsOf(c.tree, node) {
    checkWhereEntry(c, e, target, names)
  }
  return true
}

// A key identifier of a map literal the resolver left unresolved
// (resolvebody.bit's `rResolveMapLit`) in a literal that was NOT taken as a
// condition: the plain undefined name it always was.
fn vSweepWhereKeys(c: Checker, node: int) {
  if (c.whereLits[node] || len(c.nodeSymbols) == 0) {
    return
  }
  for e of kidsOf(c.tree, node) {
    let key = kidsOf(c.tree, e)[0]
    if (getNode(c.tree, key).tag != Tag.Ident || c.nodeSymbols[key] != 0) {
      continue
    }
    let name = nodeText(c.tree, c.source, key)
    if (name != "_") {
      reportNoHint(c.diags, ecUndefinedName, vSpan(c, key), "undefined name '${name}'")
    }
  }
}
