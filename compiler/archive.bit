// Self-host Stage 3 (#1344): `ar` archive reader. Extracts the member
// object(s) out of libbitrt.a so
// the object readers can parse them. Handles both formats `./make libbitrt`
// actually writes: GNU/System V for ELF targets (a `/` symbol-table member, a
// `//` long-name table, GNU trailing-`/` short names) and BSD for Mach-O targets
// (an `__.SYMDEF` symbol table and `#1/<len>` names carried as a null-padded
// prefix of each member's own data).
//
// Both symbol tables are deliberately SKIPPED rather than parsed: the linker's
// merge always needs every member's full symbol table anyway (to build the
// whole-link global table for dead-strip reachability), so routing straight to
// the member defining a wanted symbol would save nothing.

struct ArMember {
  name: string,
  data: []u8,
}

fn arMagic(): string {
  return "!<arch>\n"
}

fn arHeaderLen(): int {
  return 60
}

// Where a member's name came from, and where its real content starts. The
// data offset is nonzero only for BSD `#1/<len>`, whose name is a prefix of the
// data itself.
struct ArResolved {
  name: string,
  dataStart: int,
}

fn arBytesEq(b: []u8, off: int, s: string): bool {
  let t = []byte(s)
  if (off + len(t) > len(b)) {
    return false
  }
  let i = 0
  while (i < len(t)) {
    if (b[off + i] != t[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Trailing `c` removed — `ar` pads its fixed-width header fields with spaces,
// and a BSD name with NULs.
fn arTrimEnd(s: string, c: u8): string {
  let b = []byte(s)
  let n = len(b)
  while (n > 0 && b[n - 1] == c) {
    n = n - 1
  }
  return string(b[0:n])
}

fn arIsAllDigits(s: string): bool {
  let b = []byte(s)
  if (len(b) == 0) {
    return false
  }
  let i = 0
  while (i < len(b)) {
    if (b[i] < u8(48) || b[i] > u8(57)) {
      return false
    }
    i = i + 1
  }
  return true
}

// A plain decimal field, or -1 if it is not one. `ar` sizes and long-name
// offsets are unsigned decimal with space padding; nothing else is valid, and a
// silent 0 would truncate a member.
fn arParseDecimal(s: string): int {
  let t = arTrimEnd(s, u8(32))
  if (!arIsAllDigits(t)) {
    return -1
  }
  let b = []byte(t)
  let v = 0
  let i = 0
  while (i < len(b)) {
    v = v * 10 + (int(b[i]) - 48)
    i = i + 1
  }
  return v
}

// `data` is needed only for the BSD `#1/<len>` case, where the name is a prefix
// of the member's own data rather than a separate table lookup.
fn arResolveName(rawName: string, longNames: []u8, data: []u8): ArResolved! {
  let raw = []byte(rawName)
  // GNU: "name/" — a trailing slash marks the end of a short inline name.
  if (len(raw) > 0 && raw[len(raw) - 1] == u8(47)) {
    return ArResolved{ name: string(raw[0:len(raw) - 1]), dataStart: 0 }
  }
  // GNU: "/<decimal offset>" — the name lives in the `//` long-name table,
  // terminated by a newline.
  if (len(raw) > 1 && raw[0] == u8(47) && arIsAllDigits(string(raw[1:len(raw)]))) {
    let off = arParseDecimal(string(raw[1:len(raw)]))
    if (off < 0 || off >= len(longNames)) {
      fail newError("BadLongName")
    }
    let end = off
    while (end < len(longNames) && longNames[end] != u8(10)) {
      end = end + 1
    }
    if (end >= len(longNames)) {
      fail newError("BadLongName")
    }
    let nameEnd = end
    if (nameEnd > off && longNames[nameEnd - 1] == u8(47)) {
      nameEnd = nameEnd - 1
    }
    return ArResolved{ name: string(longNames[off:nameEnd]), dataStart: 0 }
  }
  // BSD: "#1/<len>" — the name is the first `len` (null-padded) bytes of the
  // member's own data; the real content follows at data[len..].
  if (len(raw) > 3 && raw[0] == u8(35) && raw[1] == u8(49) && raw[2] == u8(47)) {
    let n = arParseDecimal(string(raw[3:len(raw)]))
    if (n < 0 || n > len(data)) {
      fail newError("BadLongName")
    }
    return ArResolved{ name: arTrimEnd(string(data[0:n]), u8(0)), dataStart: n }
  }
  return ArResolved{ name: rawName, dataStart: 0 }
}

// Parses a whole `.a` file into its real members, skipping the `/` (System V
// symbol table), `//` (long-name table), and `__.SYMDEF*` (BSD symbol table)
// special members.
fn parseArchive(bytes: []u8): []ArMember! {
  if (len(bytes) < len([]byte(arMagic())) || !arBytesEq(bytes, 0, arMagic())) {
    fail newError("BadMagic")
  }

  let longNames = []u8(0)
  let members = []ArMember(0)
  let pos = len([]byte(arMagic()))
  while (pos < len(bytes)) {
    // Archives pad each member to an even offset with one newline filler byte;
    // skip it before reading the next header.
    if (pos % 2 == 1) {
      pos = pos + 1
    }
    if (pos == len(bytes)) {
      break
    }
    if (pos + arHeaderLen() > len(bytes)) {
      fail newError("TruncatedArchive")
    }
    if (!arBytesEq(bytes, pos + 58, "`\n")) {
      fail newError("BadHeader")
    }

    let rawName = arTrimEnd(string(bytes[pos:pos + 16]), u8(32))
    let size = arParseDecimal(string(bytes[pos + 48:pos + 58]))
    if (size < 0) {
      fail newError("BadHeader")
    }

    let dataStart = pos + arHeaderLen()
    if (dataStart + size > len(bytes)) {
      fail newError("TruncatedArchive")
    }
    let data = bytes[dataStart:dataStart + size]
    pos = dataStart + size

    if (rawName == "/") {
      continue // System V symbol table — unused, see the file comment
    }
    if (rawName == "//") {
      longNames = data // GNU long-filename table
      continue
    }

    let resolved = arResolveName(rawName, longNames, data)?
    // BSD symbol tables carry an __.SYMDEF / __.SYMDEF SORTED / __.SYMDEF_64
    // name (the macOS form of the GNU `/` member) — the index deliberately not
    // used, same as `/` above.
    if (arHasPrefix(resolved.name, "__.SYMDEF")) {
      continue
    }
    members = append(members, ArMember{ name: resolved.name,
      data: data[resolved.dataStart:len(data)] })
  }
  return members
}

// ---------------------------------------------------------------------------
// Writer (#1398) — the inverse of parseArchive, so a libbitrt.a can be PRODUCED
// from Bit-compiled objects rather than only consumed.
// ---------------------------------------------------------------------------

// Which name encoding to write. Matches what each platform's own `ar` (and
// `./make libbitrt`) produces, and what parseArchive above already reads
// back: GNU/System V for ELF targets, BSD for Mach-O.
fn arFormatGnu(): int {
  return 0
}

fn arFormatBsd(): int {
  return 1
}

// Is this byte string a relocatable object, i.e. something an archive may
// legitimately hold? (#1876)
//
// `bit ar` appended whatever `readFile` returned, so handing it a text file
// produced a 114-byte archive and exit 0. Nothing downstream catches that
// either: `writeArchive` only frames bytes it is given, and the reader's
// checks are all about the ARCHIVE's own structure — magic, header, size
// fields — never about whether a member is an object. The archive is
// well-formed; its contents are garbage. A linker then fails somewhere much
// later with an error naming the archive rather than the file that poisoned it.
//
// Only the first four bytes are read, deliberately. This is a sanity gate on
// operator error, not a validator: parsing far enough to prove a member is a
// well-formed object for the right architecture is the linker's job, it needs
// the target, and it would reject nothing this does not already catch. The
// magic is enough to separate "an object file" from "a .txt, a .a, a shell
// script, a source file" — every way this has actually been misused.
fn arIsObject(data: []u8): bool {
  if (len(data) < 4) {
    return false
  }
  // ELF: 0x7f 'E' 'L' 'F'.
  if (data[0] == u8(0x7f) && data[1] == u8(69) && data[2] == u8(76) && data[3] == u8(70)) {
    return true
  }
  // Mach-O 64-bit. MH_MAGIC_64 is 0xfeedfacf and the header is little-endian,
  // so on disk the bytes run cf fa ed fe.
  return data[0] == u8(0xcf) && data[1] == u8(0xfa) && data[2] == u8(0xed) && data[3] == u8(0xfe)
}

// One 60-byte header: a 16-byte name, then mtime/uid/gid/mode/size in
// fixed-width space-padded decimal, then the "`\n" magic at offset 58. An empty
// `mode` leaves every numeric field but `size` blank, which is how `ar` writes
// the `//` long-name table's own header.
fn arWriteHeader(b: ByteBuf, nameField: string, size: int, mode: string) {
  let start = len(b.bytes)
  let i = 0
  while (i < arHeaderLen()) {
    b.bytes = append(b.bytes, u8(32)) // space-filled
    i = i + 1
  }
  arPatch(b, start, nameField)
  if (len([]byte(mode)) > 0) {
    arPatch(b, start + 16, "0") // mtime
    arPatch(b, start + 28, "0") // uid
    arPatch(b, start + 34, "0") // gid
    arPatch(b, start + 40, mode)
  }
  // Left-aligned in its fixed-width field; the tail it does not reach keeps the
  // space fill written above, which is exactly how `ar` pads.
  arPatch(b, start + 48, "${size}")
  b.bytes[start + 58] = u8(96) // `
  b.bytes[start + 59] = u8(10) // \n
}

// Overwrites already-reserved bytes in place — headers are space-filled first,
// then their populated fields written over the fill.
fn arPatch(b: ByteBuf, off: int, s: string) {
  let sb = []byte(s)
  let i = 0
  while (i < len(sb)) {
    b.bytes[off + i] = sb[i]
    i = i + 1
  }
}

// `ar` starts every header at an even offset, padding with one newline.
fn arPadEven(b: ByteBuf) {
  if (len(b.bytes) % 2 == 1) {
    b.bytes = append(b.bytes, u8(10))
  }
}

// Deliberately writes NO symbol-table member (`/` or `__.SYMDEF`). parseArchive
// skips both by design — the linker's merge builds the whole-link global table
// from every member's own symbols for dead-strip anyway — so an index would be
// bytes this toolchain never reads.
//
// mtime/uid/gid are always 0 (reproducible output). `mode` follows each
// platform's own convention so the result is byte-comparable with that
// platform's tooling: 644 for GNU members, 0 for BSD ones, blank on the `//`
// table — exactly what `./make libbitrt` writes for each.
fn writeArchive(members: []ArMember, format: int): []u8 {
  let b = newByteBuf()
  appendBytes(b, []byte(arMagic()))

  // GNU carries names longer than 15 bytes in a `//` table, referenced by byte
  // offset; BSD carries every name inline, so it needs no table.
  let longOffsets = []int(0)
  let table = newByteBuf()
  let i = 0
  while (i < len(members)) {
    longOffsets = append(longOffsets, 0)
    i = i + 1
  }
  if (format == arFormatGnu()) {
    i = 0
    while (i < len(members)) {
      if (len([]byte(members[i].name)) > 15) {
        longOffsets[i] = len(table.bytes)
        appendBytes(table, []byte(members[i].name))
        appendBytes(table, []byte("/\n")) // real GNU ar slash-terminates
      }
      i = i + 1
    }
    if (len(table.bytes) > 0) {
      arWriteHeader(b, "//", len(table.bytes), "")
      appendBytes(b, table.bytes)
      arPadEven(b)
    }
  }

  i = 0
  while (i < len(members)) {
    let m = members[i]
    let nameLen = len([]byte(m.name))
    if (format == arFormatGnu()) {
      let field = "/${longOffsets[i]}"
      if (nameLen <= 15) {
        field = "${m.name}/"
      }
      arWriteHeader(b, field, len(m.data), "644")
      appendBytes(b, m.data)
    } else {
      // The name is a NUL-padded prefix of the member's own data, its padded
      // length declared in the name field.
      //
      // Padded so the OBJECT DATA lands 8-byte aligned, which 64-bit Mach-O
      // requires so the linker can map each member in place (#1847). This used
      // to align the NAME to 4 — what macOS `ar` happens to produce — and that
      // says nothing about where the data lands: the header is 60 bytes and
      // 60 % 8 == 4, so data sits at `member_start + 60 + padded` and neither
      // term was controlled. 13 of the 23 members of the shipped
      // `libbitrt.a` were misaligned, and `ld` refused the whole archive with
      // "64-bit mach-o member '...' not 8-byte aligned".
      //
      // Padding the name is the right lever rather than trailing padding after
      // the data: `#1/N` DECLARES how many bytes to skip, so a reader needs no
      // change, whereas trailing padding would have to be inferred from the
      // next member's offset. `alignForward` rounds up, so `padded >= nameLen`
      // always and at most `nameLen + 7`.
      //
      // `arPadEven` below still runs and is still necessary — it keeps the NEXT
      // header at an even offset, which is the format's own rule; this only
      // fixes where the data inside a member starts.
      let base = len(b.bytes) + arHeaderLen()
      let padded = alignForward(base + nameLen, 8) - base
      // Mode 644, not 0. `ar x` restores the header's mode onto the extracted
      // file, and mode 0 extracted 23 objects nobody — including their owner —
      // could then read or pass to `nm`. The GNU branch above already writes
      // 644; this was the only place that did not (#1847).
      arWriteHeader(b, "#1/${padded}", padded + len(m.data), "644")
      appendBytes(b, []byte(m.name))
      appendZeros(b, padded - nameLen)
      appendBytes(b, m.data)
    }
    arPadEven(b)
    i = i + 1
  }
  return b.bytes
}

fn arHasPrefix(s: string, prefix: string): bool {
  let a = []byte(s)
  let b = []byte(prefix)
  if (len(b) > len(a)) {
    return false
  }
  let i = 0
  while (i < len(b)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}
