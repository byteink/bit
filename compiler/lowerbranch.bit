// compiler/lowerbranch.bit — split out of lowercond.bit (#2910) to keep both
// files under the 800-line lint limit (see lowercond.bit for the
// unary/comparison/if half). Same module as lowercond.bit, so this needs no
// imports and no call-site changes. Multi-way branch dispatch: `switch`
// case selection, `select` comm-clause dispatch, and match-arm tag/payload
// binding shared with lowerMatch (compiler/lowerflow.bit).

// A single switch-case label test: `subject == label` for a subject switch, or
// the label evaluated as a bool for a subject-less switch.
//
// The equality is `lowerCompare`, the same one `a == b` uses, so a `string`
// subject matches by CONTENT and a class/tuple subject field-wise (§14.6). The
// old bare `icmp_eq` on the two handles (#2407) happened to work for a string
// only when the subject was itself a literal — the pool interns by content, so
// both sides were then the same handle.
fn caseTest(fc: FnCtx, hasSubject: bool, subject: int, subjectTy: int, expr: int): int {
  if (!hasSubject) {
    return lowerExprH(fc, expr, primType(fc.c.ctx, 10))
  }
  let label = lowerExprH(fc, expr, subjectTy)
  if (fc.failed) {
    return 0
  }
  return lowerCompare(fc, int(Kind.EqEq), CompareOperand{ ty: subjectTy, span: getNode(fc.c.tree, expr).span }, subject, label)
}

// Lowers a `switch (subject) { case a, b: ...; default: ... }` over a value to a
// decision chain: each case's `subject == expr` (OR-folded across its labels)
// branches to the body or the next test; an unmatched value falls to `default`.
// ponytail: subject-less `switch { case cond: }` and break-in-case deferred.
fn lowerSwitch(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let boolTy = primType(fc.c.ctx, 10)
  // Subject-less `switch { case cond: ... }`: each label is a bool condition
  // tested directly. A subject switch compares `subject == label`.
  let hasSubject = k[0] != 0
  let subjectTy = boolTy
  let subject = 0
  if (hasSubject) {
    subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
    subject = lowerExprH(fc, k[0], subjectTy)
    if (fc.failed) {
      return
    }
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let cases = kidsOf(fc.c.tree, k[1])
  // Count the non-default cases and find the default body.
  let m = 0
  let defaultStmts = 0
  let ci = 0
  while (ci < len(cases)) {
    let t = getNode(fc.c.tree, cases[ci]).tag
    if (t == Tag.SwitchCase) {
      m = m + 1
    } else if (t == Tag.SwitchDefault) {
      defaultStmts = kidsOf(fc.c.tree, cases[ci])[0]
    }
    ci = ci + 1
  }
  let join = builderNewBlock(fc.b)
  let dflt = 0
  if (m > 0) {
    dflt = builderNewBlock(fc.b)
  }
  // A switch is a `break` target (to the join) but not a `continue` target.
  fc.loops = append(fc.loops, LoopFrame{ exit: join, cont: join, preLen: preLen, isSwitch: true, exitUsed: false })
  let joinReachable = false
  let seen = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.SwitchCase) {
      ci = ci + 1
      continue
    }
    let ck = kidsOf(fc.c.tree, cases[ci])
    let exprs = kidsOf(fc.c.tree, ck[0])
    let cond = caseTest(fc, hasSubject, subject, subjectTy, exprs[0])
    let ei = 1
    while (ei < len(exprs)) {
      let bor = mkInstr(Op.BOr, boolTy)
      bor.lhs = cond
      bor.rhs = caseTest(fc, hasSubject, subject, subjectTy, exprs[ei])
      cond = builderEmit(fc.b, bor)
      ei = ei + 1
    }
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = dflt
    if (seen != m - 1) {
      nextBlk = builderNewBlock(fc.b)
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    restoreValues(fc, orig)
    let mark = len(fc.env)
    lowerStmtList(fc, ck[1])
    truncateEnv(fc, mark)
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    seen = seen + 1
    ci = ci + 1
  }
  // Positioned in the "no case matched" block (dflt when m>0, else the caller's).
  fc.terminated = false
  restoreValues(fc, orig)
  if (defaultStmts != 0) {
    let mark = len(fc.env)
    lowerStmtList(fc, defaultStmts)
    truncateEnv(fc, mark)
  }
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// `select { case <comm>: <body> ... default: <body> }` (SPEC §16.3): each comm
// clause's channel operand (and a send's value) is evaluated once into a
// select_alloc'd descriptor buffer of 32-byte entries {dir @0, chan @8, word @16,
// ok @24}; the runtime `select` returns the fired case index (or n for default),
// which then dispatches like a value switch, binding a recv case's received word
// (field_get buf[off+16]) before its body. `nconst` is emitted once and shared by
// select_alloc and select.
fn lowerSelect(fc: FnCtx, node: int) {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let cases = kidsOf(fc.c.tree, node)
  // Count comm cases; find the default body.
  let n = 0
  let defaultStmts = 0
  let ci = 0
  while (ci < len(cases)) {
    let t = getNode(fc.c.tree, cases[ci]).tag
    if (t == Tag.CommCase) {
      n = n + 1
    } else if (t == Tag.CommDefault) {
      defaultStmts = kidsOf(fc.c.tree, cases[ci])[0]
    }
    ci = ci + 1
  }
  let hasDefault = defaultStmts != 0
  // Pass 1: allocate the descriptor buffer, evaluate every comm exactly once.
  let nc = mkInstr(Op.ConstInt, i64ty)
  nc.ival = n
  let nconst = builderEmit(fc.b, nc)
  let alloc = mkInstr(Op.RtCall, i64ty)
  alloc.name = "select_alloc"
  alloc.args = [nconst]
  let buf = emitRtCall(fc, alloc)
  let idx = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.CommCase) {
      ci = ci + 1
      continue
    }
    let comm = kidsOf(fc.c.tree, cases[ci])[0]
    let off = idx * 32
    if (getNode(fc.c.tree, comm).tag == Tag.SendStmt) {
      let sk = kidsOf(fc.c.tree, comm)
      let chanTy = defaultType(fc.c, nodeType(fc, sk[0]))
      let ch = lowerExpr(fc, sk[0])
      let v = lowerExprH(fc, sk[1], fc.c.ctx.types[chanTy].elem)
      let dc = mkInstr(Op.ConstInt, i64ty)
      dc.ival = 1
      selectSet(fc, buf, off + 0, builderEmit(fc.b, dc))
      selectSet(fc, buf, off + 8, ch)
      selectSet(fc, buf, off + 16, v)
    } else if (getNode(fc.c.tree, comm).tag == Tag.RecvBind) {
      // recv_bind: [binder_or_none, chan]
      let ch = lowerExpr(fc, kidsOf(fc.c.tree, comm)[1])
      let dc = mkInstr(Op.ConstInt, i64ty)
      selectSet(fc, buf, off + 0, builderEmit(fc.b, dc))
      selectSet(fc, buf, off + 8, ch)
    } else {
      // The checker has no dedicated select validator (a `comm` shape that is
      // neither a send nor a receive is not caught at `check` time — see the
      // sibling ticket filed alongside #1693). Refuse to lower rather than
      // index into bindings this comm doesn't have.
      fcFail(fc, getNode(fc.c.tree, comm).span, "a `select` case that is neither a send nor a receive")
      return
    }
    idx = idx + 1
    ci = ci + 1
  }
  if (fc.failed) {
    return
  }
  let hd = mkInstr(Op.ConstInt, i64ty)
  if (hasDefault) {
    hd.ival = 1
  }
  let sel = mkInstr(Op.RtCall, i64ty)
  sel.name = "select"
  sel.args = [buf, nconst, builderEmit(fc.b, hd)]
  let fired = emitRtCall(fc, sel)

  // Pass 2: dispatch on `fired` — a value switch, binding recv results.
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let dflt = builderNewBlock(fc.b)
  fc.loops = append(fc.loops, LoopFrame{ exit: join, cont: join, preLen: preLen, isSwitch: true, exitUsed: false })
  let joinReachable = false
  let seen = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.CommCase) {
      ci = ci + 1
      continue
    }
    let ck = kidsOf(fc.c.tree, cases[ci])
    let comm = ck[0]
    let off = seen * 32
    let cst = mkInstr(Op.ConstInt, i64ty)
    cst.ival = seen
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = fired
    eq.rhs = builderEmit(fc.b, cst)
    let cond = builderEmit(fc.b, eq)
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = dflt
    if (seen != n - 1) {
      nextBlk = builderNewBlock(fc.b)
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    restoreValues(fc, orig)
    let mark = len(fc.env)
    // A recv case with a binder reads the received word from the descriptor.
    if (getNode(fc.c.tree, comm).tag == Tag.RecvBind) {
      bindSelectRecv(fc, comm, buf, off)
      if (fc.failed) {
        return
      }
    }
    lowerStmtList(fc, ck[1])
    truncateEnv(fc, mark)
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    seen = seen + 1
    ci = ci + 1
  }
  if (fc.failed) {
    return
  }
  // "no case matched" (dflt) block: run the default body, if any, then join.
  fc.terminated = false
  restoreValues(fc, orig)
  if (hasDefault) {
    let mark = len(fc.env)
    lowerStmtList(fc, defaultStmts)
    truncateEnv(fc, mark)
  }
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Binds a fired recv clause's results out of its select descriptor, at the top
// of that clause's body block. `case v = <- c:` binds the received word
// (`word`, ABI.md §11); `case (v, ok) = <- c:` also binds the runtime's verdict
// (`ok`), which is false exactly when the channel was closed and drained — the
// same pair `let (v, ok) = <- c` yields outside a select.
//
// SPEC §16.3's `recv_bind = [ ( IDENT | tuple_pat ) "=" ] "<-" expression` has
// always admitted the pair, and the checker types both halves, but only the
// IDENT form was lowered (#2322). A select-based worker therefore could not
// observe a closed channel at all: it had to carry a second channel to signal
// the close out of band, or give up `select` for the plain two-result receive
// and then wait on only one channel.
fn bindSelectRecv(fc: FnCtx, comm: int, buf: int, off: int) {
  // recv_bind: [binder_or_none, chan]
  let rk = kidsOf(fc.c.tree, comm)
  if (rk[0] == 0) {
    return
  }
  let bn = getNode(fc.c.tree, rk[0])
  let isPair = bn.tag == Tag.TuplePat
  if (bn.tag != Tag.Ident && !isPair) {
    fcFail(fc, bn.span, "a `select` receive binder that is not an identifier or a tuple pattern")
    return
  }
  let binders = [rk[0]]
  if (isPair) {
    binders = kidsOf(fc.c.tree, rk[0])
    if (len(binders) != 2) {
      fcFail(fc, bn.span, "a `select` receive tuple pattern with other than two names")
      return
    }
  }
  let elemTy = fc.c.ctx.types[defaultType(fc.c, nodeType(fc, rk[1]))].elem
  let fg = mkInstr(Op.FieldGet, elemTy)
  fg.lhs = buf
  fg.ival = off + 16
  let vn = getNode(fc.c.tree, binders[0])
  declareLocal(fc, fc.c.source[vn.span.start:vn.span.end], builderEmit(fc.b, fg), elemTy)
  rebindCheckerName(fc, binders[0], elemTy)
  if (!isPair) {
    return
  }
  // `ok` is a full descriptor WORD holding 0 or 1, so it is read as an i64 and
  // compared — not loaded at the narrower width `bool` lays out to, which would
  // read one byte of a word and be right only by little-endian accident.
  let i64ty = primType(fc.c.ctx, 3)
  let okg = mkInstr(Op.FieldGet, i64ty)
  okg.lhs = buf
  okg.ival = off + 24
  let zero = mkInstr(Op.ConstInt, i64ty)
  let ne = mkInstr(Op.ICmpNe, primType(fc.c.ctx, 10))
  ne.lhs = builderEmit(fc.b, okg)
  ne.rhs = builderEmit(fc.b, zero)
  let okV = builderEmit(fc.b, ne)
  let on = getNode(fc.c.tree, binders[1])
  declareLocal(fc, fc.c.source[on.span.start:on.span.end], okV, primType(fc.c.ctx, 10))
  rebindCheckerName(fc, binders[1], primType(fc.c.ctx, 10))
}

// Emits `field_set buf[off] = val` for a select descriptor word.
fn selectSet(fc: FnCtx, buf: int, off: int, val: int) {
  let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs.lhs = buf
  fs.ival = off
  fs.rhs = val
  builderEmit(fc.b, fs)
}

// Lowers a match arm's body — a `{ … }` block or a single statement.
fn lowerArmBody(fc: FnCtx, body: int) {
  if (getNode(fc.c.tree, body).tag == Tag.Block) {
    lowerStmtList(fc, body)
  } else {
    lowerStmt(fc, body)
  }
}

// Lowers one match-statement arm's body in the current block; on a non-diverging
// arm, carries the live locals to `join`. Returns whether the join is reached.
// The scrutinee tag: a boxed enum's tag is word 0 of the object (i64); a C-like
// enum's value IS its tag.
fn matchTag(fc: FnCtx, subject: int, subjectTy: int, boxed: bool): int {
  if (!boxed) {
    return subject
  }
  let fg = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  fg.lhs = subject
  fg.ival = 0
  return builderEmit(fc.b, fg)
}

// The tag type used for the arm comparison: i64 for boxed, the enum type for
// C-like (so the compare operands share a type).
fn tagType(fc: FnCtx, subjectTy: int, boxed: bool): int {
  if (boxed) {
    return primType(fc.c.ctx, 3)
  }
  return subjectTy
}

// Binds a boxed variant arm's payload `V(a, b) =>`: word i of the merged
// discriminant/payload object (offset 16+8*i, #4018) into binder i. No-op for
// a C-like enum or a no-binder arm.
//
// An instantiation's payload types come off the type table already
// substituted — local, imported, or a bare inferred variant construction all
// instantiate through `instantiateNamed` now (#1573), so `ptypes[i]` is
// concrete here whenever `enumTy` resolved to a real instantiation.
fn bindArmPayload(fc: FnCtx, arm: int, boxed: bool, enumTy: int, subject: int) {
  if (!boxed) {
    return
  }
  let vp = kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])
  if (vp[1] == 0) {
    return
  }
  let vn = getNode(fc.c.tree, vp[0])
  let ptypes = variantPayloadTypes(fc.c, enumTy, fc.c.source[vn.span.start:vn.span.end])
  let binders = kidsOf(fc.c.tree, vp[1])
  let i = 0
  while (i < len(binders)) {
    let bty = primType(fc.c.ctx, 3)
    if (i < len(ptypes)) {
      bty = ptypes[i]
    }
    // Still a bare param means the table had no instantiation to read —
    // typically a generic FUNCTION body, whose node types lowering re-derives
    // per instantiation. The checker's binder type is the stronger answer there
    // (#1558). Guarded on TypeParam so it never overrides a concrete answer.
    if (fc.c.ctx.types[bty].kind == TypeKind.TypeParam) {
      let checked = fc.c.declTypes[binders[i]]
      if (checked != 0 && fc.c.ctx.types[checked].kind != TypeKind.TypeParam) {
        bty = checked
      }
    }
    let fg = mkInstr(Op.FieldGet, bty)
    fg.lhs = subject
    fg.ival = 16 + 8 * i
    let bn = getNode(fc.c.tree, binders[i])
    let bname = fc.c.source[bn.span.start:bn.span.end]
    declareLocal(fc, bname, builderEmit(fc.b, fg), bty)
    // Keep the checker consistent so `checkExprType` types the binder during
    // lowering (see lowerFunc).
    rebindCheckerName(fc, binders[i], bty)
    i = i + 1
  }
}
