// In-Bit self-checks for the AArch64 encoder: general ALU/shift/compare
// forms, MOVZ/MOVK/MOVN immediate materialization, the logical-immediate
// (bitmask) scheme, register width extension, and float/memory ops
// including branch-fixup patching. Split out of selfcheck.bit (#1503);
// sibling .bit files are the same module, so `selfcheck()` still calls
// these directly. #5643 split the relocation, frame/pairs, move-
// sequentializer, operand-accessor and bounds-branch-analysis checks out
// into arm64checkrelocs.bit, arm64checkframe.bit, arm64checkmoves.bit,
// arm64checkoperands.bit and arm64checkbounds.bit respectively, when this
// file reached exactly 800 lines against E0200 with zero headroom.

// Stage 3 (#1342) ARM64 encoder. Every expected word below is the seed's own
// golden, cross-checked byte-for-byte against Apple's as/objdump — a
// hand-written encoder with no assembler to fall back on earns its trust here.
fn checkArm64Encoder() {
  // mov x0, x1 == ORR X0, XZR, X1
  let c = newByteBuf()
  movRR(c, 0, 1)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xaa0103e0)

  // add/sub/cmp x5, x2, x3
  c = newByteBuf()
  addRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x8b030045)
  c = newByteBuf()
  subRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0xcb030045)
  c = newByteBuf()
  cmpRR(c, 2, 3)
  assert(wordAt(c, 0) == 0xeb03005f)

  // and/orr/eor/tst x5, x2, x3
  c = newByteBuf()
  logicalRR(c, 0, 5, 2, 3)
  assert(wordAt(c, 0) == 0x8a030045)
  c = newByteBuf()
  logicalRR(c, 1, 5, 2, 3)
  assert(wordAt(c, 0) == 0xaa030045)
  c = newByteBuf()
  logicalRR(c, 2, 5, 2, 3)
  assert(wordAt(c, 0) == 0xca030045)
  c = newByteBuf()
  tstRR(c, 2, 3)
  assert(wordAt(c, 0) == 0xea03005f)

  // mvn / neg x5, x3
  c = newByteBuf()
  mvnR(c, 5, 3)
  assert(wordAt(c, 0) == 0xaa2303e5)
  c = newByteBuf()
  negR(c, 5, 3)
  assert(wordAt(c, 0) == 0xcb0303e5)
  // negs x5, x3 == subs x5, xzr, x3 (#3081) -- same word as negR with the S
  // bit (bit 29) set, the same relationship addsRR/subsRR bear to addRR/subRR.
  c = newByteBuf()
  negsR(c, 5, 3)
  assert(wordAt(c, 0) == 0xeb0303e5)

  // mul/sdiv/udiv/msub
  c = newByteBuf()
  mulRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9b037c45)
  c = newByteBuf()
  sdivRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac30c45)
  c = newByteBuf()
  udivRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac30845)
  c = newByteBuf()
  msubRR(c, 5, 2, 3, 4)
  assert(wordAt(c, 0) == 0x9b039045)
  checkArm64EncoderShiftsAndImmediates()
}

// Shift and immediate-materialization half of checkArm64Encoder above.
fn checkArm64EncoderShiftsAndImmediates() {
  // lsl/lsr/asr x5, x2, #5
  let c = newByteBuf()
  lslImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0xd37be845)
  c = newByteBuf()
  lsrImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0xd345fc45)
  c = newByteBuf()
  asrImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0x9345fc45)

  // lslv/lsrv/asrv x5, x2, x3
  c = newByteBuf()
  lslvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32045)
  c = newByteBuf()
  lsrvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32445)
  c = newByteBuf()
  asrvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32845)

  // cset x5, <cond> — every condition this backend uses.
  let conds = [condEq(), condNe(), condLt(), condLe(), condGt(), condGe(),
    condCc(), condLs(), condHi(), condCs(), condMi()]
  let wants = [0x9a9f17e5, 0x9a9f07e5, 0x9a9fa7e5, 0x9a9fc7e5, 0x9a9fd7e5,
    0x9a9fb7e5, 0x9a9f27e5, 0x9a9f87e5, 0x9a9f97e5, 0x9a9f37e5, 0x9a9f57e5]
  let i = 0
  while (i < len(conds)) {
    c = newByteBuf()
    cset(c, 5, conds[i])
    assert(wordAt(c, 0) == wants[i])
    i = i + 1
  }

  // movImm64 picks MOVZ/MOVK/MOVN optimally.
  c = newByteBuf()
  movImm64(c, 5, 0x1234)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xd2824685) // movz x5, #0x1234
  // Upper halfwords all 0xFFFF -> a single MOVN.
  c = newByteBuf()
  movImm64(c, 5, -0x1235)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0x92824685)
  // 0 and all-ones are each one instruction.
  c = newByteBuf()
  movImm64(c, 5, 0)
  assert(len(c.bytes) == 4)
  c = newByteBuf()
  movImm64(c, 5, -1)
  assert(len(c.bytes) == 4)
  // Four distinct nonzero halfwords need MOVZ + 3x MOVK.
  c = newByteBuf()
  movImm64(c, 5, 0x0001000200030004)
  assert(len(c.bytes) == 16)

  // addSubImmWide: a small imm is one instruction; one needing both halves is
  // two (frame-size arithmetic).
  c = newByteBuf()
  addSubImmWide(c, false, 31, 31, 16)
  assert(len(c.bytes) == 4)
  c = newByteBuf()
  addSubImmWide(c, true, 31, 31, 4096 + 16)
  assert(len(c.bytes) == 8)
  // sub sp, sp, #0x100 and the lo==0 shifted-only form (sub sp,sp,#0x11,lsl#12).
  c = newByteBuf()
  addSubImmWide(c, false, 31, 31, 256)
  assert(wordAt(c, 0) == 0x910403ff)
  c = newByteBuf()
  addSubImmWide(c, true, 31, 31, 0x11000)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xd14047ff)
}

// #3495 logical-immediate (bitmask N:immr:imms). Every golden below came out
// of Apple's own assembler (`clang -c` on the matching `and`/`orr`/`eor`/
// `ands` mnemonic, read back with `otool -t`), not from re-deriving this
// encoder's own arithmetic — the encoder is what is on trial, and this scheme
// is exactly the kind of bit-twiddling a self-derived oracle would only
// confirm its own misunderstanding of.
fn checkArm64LogicalImm() {
  // The ticket's own example: `and x1, x2, #-8`.
  let c = newByteBuf()
  logicalImmediate(c, 0, fitsLogicalImm(64, 0 - 8), 2, 1)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0x927df041)
  // Same immediate, different registers — the exact word the ticket quotes
  // (0x927df142), confirming the field derivation is register-independent.
  c = newByteBuf()
  logicalImmediate(c, 0, fitsLogicalImm(64, 0 - 8), 10, 2)
  assert(wordAt(c, 0) == 0x927df142)

  // A period-8 repeating pattern (`and x1, x2, #0xf0f0f0f0f0f0f0f0`).
  c = newByteBuf()
  let repeat8 = fitsLogicalImm(64, i64(u64(0xf0f0f0f0f0f0f0f0)))
  logicalImmediate(c, 0, repeat8, 2, 1)
  assert(wordAt(c, 0) == 0x9204cc41)
  // Its 32-bit (W) form — same low-32-bit pattern, `and w1, w2, #0xf0f0f0f0`.
  // Exercises `fitsLogicalImm`'s regSize==32 path, which production code
  // (always 64-bit; arm64.bit's `logicalImmediate` hardcodes sf=1) never
  // reaches, so this is the only place it is proven correct.
  let repeat8w = fitsLogicalImm(32, 0xf0f0f0f0)
  assert(logicalImmWord(0, 0, repeat8w, 2, 1) == 0x1204cc41)

  // ORR: a plain non-wrapping low run of ones (`orr x5, x2, #0xff`).
  c = newByteBuf()
  logicalImmediate(c, 1, fitsLogicalImm(64, 0xff), 2, 5)
  assert(wordAt(c, 0) == 0xb2401c45)

  // EOR: a period-16 pattern (`eor x5, x2, #0xff00ff00ff00ff00`).
  c = newByteBuf()
  let repeat16 = fitsLogicalImm(64, i64(u64(0xff00ff00ff00ff00)))
  logicalImmediate(c, 2, repeat16, 2, 5)
  assert(wordAt(c, 0) == 0xd2089c45)

  // ANDS (opc=3): flags-setting form, `ands x5, x2, #7`.
  c = newByteBuf()
  logicalImmediate(c, 3, fitsLogicalImm(64, 7), 2, 5)
  assert(wordAt(c, 0) == 0xf2400845)

  // All-ones-ish patterns, both hitting the WRAPPING branch of the
  // derivation (a run of 1s that wraps past bit 0): `#0x7fffffffffffffff`
  // (63 ones) and `#0xfffffffffffffe00` (56 ones, byte-aligned).
  c = newByteBuf()
  let allOnesish1 = fitsLogicalImm(64, i64(u64(0x7fffffffffffffff)))
  logicalImmediate(c, 0, allOnesish1, 2, 1)
  assert(wordAt(c, 0) == 0x9240f841)
  c = newByteBuf()
  let allOnesish2 = fitsLogicalImm(64, i64(u64(0xfffffffffffffe00)))
  logicalImmediate(c, 0, allOnesish2, 4, 3)
  assert(wordAt(c, 0) == 0x9277d883)

  // Not every constant is representable: 0x12345678 is neither a contiguous
  // run at any element size nor a wrapped one (clang's own assembler rejects
  // `and x1, x2, #0x12345678` with "expected compatible register or logical
  // immediate"). The predicate must say so, not emit a plausible-but-wrong
  // word.
  assert(!fitsLogicalImm(64, 0x12345678).fits)
  // The two values the ISA carves out entirely — replicating 0 or all bits
  // set would make AND/ORR/EOR either a no-op or a full clear/set, which the
  // ISA spends no bitmask encoding on since a register form (or MOVN/MOVZ)
  // already covers it.
  assert(!fitsLogicalImm(64, 0).fits)
  assert(!fitsLogicalImm(64, 0 - 1).fits)
}

fn checkArm64Extend() {
  // SBFM/UBFM with the immr/imms pairs that name the low 1/2/4 bytes.
  let c = newByteBuf()
  extendRegA(c, 5, 3, 1, true)
  assert(wordAt(c, 0) == 0x93401c65) // sxtb x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 1, false)
  assert(wordAt(c, 0) == 0xd3401c65) // uxtb x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 2, true)
  assert(wordAt(c, 0) == 0x93403c65) // sxth x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 4, true)
  assert(wordAt(c, 0) == 0x93407c65) // sxtw x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 4, false)
  assert(wordAt(c, 0) == 0xd3407c65) // ubfx x5, x3, #0, #32
  // Width 8 is a plain move, and a move to itself is nothing at all.
  c = newByteBuf()
  extendRegA(c, 5, 3, 8, true)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xaa0303e5)
  c = newByteBuf()
  extendRegA(c, 5, 5, 8, true)
  assert(len(c.bytes) == 0)

  // canonNarrow restores the width-canonical invariant only where it can be lost:
  // never for a full-width int, never for a float.
  c = newByteBuf()
  canonNarrow(c, 5, w64())
  assert(len(c.bytes) == 0)
  c = newByteBuf()
  canonNarrow(c, 5, mkWidth(4, RegClass.Float, false))
  assert(len(c.bytes) == 0)
  c = newByteBuf()
  canonNarrow(c, 5, w8s())
  assert(wordAt(c, 0) == 0x93401ca5) // sxtb x5, w5
}

fn checkArm64MemFloat() {
  // ldr/str x5, [x1] and the w/b/h load variants.
  let c = newByteBuf()
  loadImm(c, 5, 1, 0, 8, false)
  assert(wordAt(c, 0) == 0xf9400025)
  c = newByteBuf()
  storeImm(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xf9000025)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 4, false)
  assert(wordAt(c, 0) == 0xb9400025)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 4, true)
  assert(wordAt(c, 0) == 0xb9800025) // ldrsw
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 1, false)
  assert(wordAt(c, 0) == 0x39400025) // ldrb
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 1, true)
  assert(wordAt(c, 0) == 0x39800025) // ldrsb (64-bit dest)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 2, false)
  assert(wordAt(c, 0) == 0x79400025) // ldrh
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 2, true)
  assert(wordAt(c, 0) == 0x79800025) // ldrsh

  // Nonzero scaled offsets: #16 and the largest that still fits (#4088).
  c = newByteBuf()
  loadImm(c, 5, 1, 16, 8, false)
  assert(wordAt(c, 0) == 0xf9400825)
  c = newByteBuf()
  loadImm(c, 5, 1, 4088, 8, false)
  assert(wordAt(c, 0) == 0xf947fc25)

  // Register-offset forms, unshifted and scaled, int and fp.
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 1, 2, false, 1, 5)
  assert(wordAt(c, 0) == 0xf8626825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 1, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xf8627825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 0, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xf8227825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, true, 1, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xfc627825) // ldr d5,[x1,x2,lsl#3]

  // loadIndexed/storeIndexed pick the scaled register-offset form.
  c = newByteBuf()
  loadIndexed(c, 5, 1, 2, 8, false)
  assert(wordAt(c, 0) == 0xf8627825)
  c = newByteBuf()
  storeIndexed(c, 5, 1, 2, 4)
  assert(wordAt(c, 0) == 0xb8227825)
  checkArm64MemFloatFpAndBranchFixups()
}

// Float ops, ret/udf and branch-fixup half of checkArm64MemFloat above.
fn checkArm64MemFloatFpAndBranchFixups() {
  // Float load/store, fmov transfers, arithmetic, fneg, fcmp.
  let c = newByteBuf()
  storeImmF(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xfd000025)
  c = newByteBuf()
  loadImmF(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xfd400025)
  c = newByteBuf()
  storeImmF(c, 5, 1, 0, 4)
  assert(wordAt(c, 0) == 0xbd000025) // width dictates the size field: s-register
  c = newByteBuf()
  fmovToFp(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x9e670045)
  c = newByteBuf()
  fmovFromFp(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x9e660045)
  c = newByteBuf()
  fmovToFp(c, 5, 2, 4)
  assert(wordAt(c, 0) == 0x1e270045)
  c = newByteBuf()
  fmovFromFp(c, 5, 2, 4)
  assert(wordAt(c, 0) == 0x1e260045)
  c = newByteBuf()
  fArithRR(c, 2, 5, 2, 3, 8) // fadd
  assert(wordAt(c, 0) == 0x1e632845)
  c = newByteBuf()
  fArithRR(c, 3, 5, 2, 3, 8) // fsub
  assert(wordAt(c, 0) == 0x1e633845)
  c = newByteBuf()
  fArithRR(c, 0, 5, 2, 3, 8) // fmul
  assert(wordAt(c, 0) == 0x1e630845)
  c = newByteBuf()
  fArithRR(c, 1, 5, 2, 3, 8) // fdiv
  assert(wordAt(c, 0) == 0x1e631845)
  c = newByteBuf()
  fnegF(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x1e614045)
  c = newByteBuf()
  fcmp(c, 2, 3, 8)
  assert(wordAt(c, 0) == 0x1e632040)
  c = newByteBuf()
  fmovFF(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x1e604045)
  // width=4 selects the s-register encoding for the same register index.
  c = newByteBuf()
  fArithRR(c, 2, 5, 2, 3, 4)
  assert(wordAt(c, 0) == 0x1e232845)

  // ret / udf.
  c = newByteBuf()
  emitRet(c)
  assert(wordAt(c, 0) == 0xd65f03c0)
  c = newByteBuf()
  emitUdf(c)
  assert(wordAt(c, 0) == 0)

  // Branch fixups patch to the correct relative word offset. An unconditional
  // B at 0 targeting byte 8 is +2 words; a B.cond likewise, in its imm19 field.
  c = newByteBuf()
  emitWord(c, 0x14000000) // B placeholder at offset 0
  emitWord(c, 0)
  emitWord(c, 0)
  patchBranchTo(c, 0, 8, true)
  assert(wordAt(c, 0) == (0x14000000 | 2))
  c = newByteBuf()
  emitWord(c, 0x54000000 | condEq())
  emitWord(c, 0)
  emitWord(c, 0)
  patchBranchTo(c, 0, 8, false)
  assert(wordAt(c, 0) == (0x54000000 | (2 << 5) | condEq()))
  // A backward branch encodes a negative word offset (two's complement).
  c = newByteBuf()
  emitWord(c, 0)
  emitWord(c, 0)
  emitWord(c, 0x14000000) // B at offset 8 targeting 0 == -2 words
  patchBranchTo(c, 8, 0, true)
  assert(wordAt(c, 8) == (0x14000000 | ((-2) & 0x3FFFFFF)))
}
