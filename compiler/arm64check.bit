// In-Bit self-checks for the AArch64 encoder, relocations, frames, moves and
// operands. Split out of selfcheck.bit (#1503); sibling .bit files are the
// same module, so `selfcheck()` still calls these directly.

// Stage 3 (#1342) ARM64 encoder. Every expected word below is the seed's own
// golden, cross-checked byte-for-byte against Apple's as/objdump — a
// hand-written encoder with no assembler to fall back on earns its trust here.
fn checkArm64Encoder() {
  // mov x0, x1 == ORR X0, XZR, X1
  let c = newByteBuf()
  movRR(c, 0, 1)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xaa0103e0)

  // add/sub/cmp x5, x2, x3
  c = newByteBuf()
  addRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x8b030045)
  c = newByteBuf()
  subRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0xcb030045)
  c = newByteBuf()
  cmpRR(c, 2, 3)
  assert(wordAt(c, 0) == 0xeb03005f)

  // and/orr/eor/tst x5, x2, x3
  c = newByteBuf()
  logicalRR(c, 0, 5, 2, 3)
  assert(wordAt(c, 0) == 0x8a030045)
  c = newByteBuf()
  logicalRR(c, 1, 5, 2, 3)
  assert(wordAt(c, 0) == 0xaa030045)
  c = newByteBuf()
  logicalRR(c, 2, 5, 2, 3)
  assert(wordAt(c, 0) == 0xca030045)
  c = newByteBuf()
  tstRR(c, 2, 3)
  assert(wordAt(c, 0) == 0xea03005f)

  // mvn / neg x5, x3
  c = newByteBuf()
  mvnR(c, 5, 3)
  assert(wordAt(c, 0) == 0xaa2303e5)
  c = newByteBuf()
  negR(c, 5, 3)
  assert(wordAt(c, 0) == 0xcb0303e5)
  // negs x5, x3 == subs x5, xzr, x3 (#3081) -- same word as negR with the S
  // bit (bit 29) set, the same relationship addsRR/subsRR bear to addRR/subRR.
  c = newByteBuf()
  negsR(c, 5, 3)
  assert(wordAt(c, 0) == 0xeb0303e5)

  // mul/sdiv/udiv/msub
  c = newByteBuf()
  mulRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9b037c45)
  c = newByteBuf()
  sdivRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac30c45)
  c = newByteBuf()
  udivRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac30845)
  c = newByteBuf()
  msubRR(c, 5, 2, 3, 4)
  assert(wordAt(c, 0) == 0x9b039045)

  // lsl/lsr/asr x5, x2, #5
  c = newByteBuf()
  lslImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0xd37be845)
  c = newByteBuf()
  lsrImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0xd345fc45)
  c = newByteBuf()
  asrImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0x9345fc45)

  // lslv/lsrv/asrv x5, x2, x3
  c = newByteBuf()
  lslvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32045)
  c = newByteBuf()
  lsrvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32445)
  c = newByteBuf()
  asrvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32845)

  // cset x5, <cond> — every condition this backend uses.
  let conds = [condEq(), condNe(), condLt(), condLe(), condGt(), condGe(),
    condCc(), condLs(), condHi(), condCs(), condMi()]
  let wants = [0x9a9f17e5, 0x9a9f07e5, 0x9a9fa7e5, 0x9a9fc7e5, 0x9a9fd7e5,
    0x9a9fb7e5, 0x9a9f27e5, 0x9a9f87e5, 0x9a9f97e5, 0x9a9f37e5, 0x9a9f57e5]
  let i = 0
  while (i < len(conds)) {
    c = newByteBuf()
    cset(c, 5, conds[i])
    assert(wordAt(c, 0) == wants[i])
    i = i + 1
  }

  // movImm64 picks MOVZ/MOVK/MOVN optimally.
  c = newByteBuf()
  movImm64(c, 5, 0x1234)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xd2824685) // movz x5, #0x1234
  // Upper halfwords all 0xFFFF -> a single MOVN.
  c = newByteBuf()
  movImm64(c, 5, -0x1235)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0x92824685)
  // 0 and all-ones are each one instruction.
  c = newByteBuf()
  movImm64(c, 5, 0)
  assert(len(c.bytes) == 4)
  c = newByteBuf()
  movImm64(c, 5, -1)
  assert(len(c.bytes) == 4)
  // Four distinct nonzero halfwords need MOVZ + 3x MOVK.
  c = newByteBuf()
  movImm64(c, 5, 0x0001000200030004)
  assert(len(c.bytes) == 16)

  // addSubImmWide: a small imm is one instruction; one needing both halves is
  // two (frame-size arithmetic).
  c = newByteBuf()
  addSubImmWide(c, false, 31, 31, 16)
  assert(len(c.bytes) == 4)
  c = newByteBuf()
  addSubImmWide(c, true, 31, 31, 4096 + 16)
  assert(len(c.bytes) == 8)
  // sub sp, sp, #0x100 and the lo==0 shifted-only form (sub sp,sp,#0x11,lsl#12).
  c = newByteBuf()
  addSubImmWide(c, false, 31, 31, 256)
  assert(wordAt(c, 0) == 0x910403ff)
  c = newByteBuf()
  addSubImmWide(c, true, 31, 31, 0x11000)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xd14047ff)
}

fn checkArm64Relocs() {
  // BL is a placeholder with an all-zero imm26 plus a branch relocation.
  let cx = testA64Ctx()
  emitCallReloc(cx, "bit_rt_gc_alloc")
  assert(len(cx.code.bytes) == 4 && wordAt(cx.code, 0) == 0x94000000)
  assert(len(cx.relocs) == 1)
  assert(cx.relocs[0].offset == 0 && cx.relocs[0].symbol == "bit_rt_gc_alloc")
  assert(cx.relocs[0].kind == RelocKind.Branch)

  // adrp x3, sym / add x3, x3, #0 — two words, two relocations, and the ADD's
  // reloc must name the SECOND word (an object writer patching both fields at
  // the same offset would corrupt the ADRP).
  cx = testA64Ctx()
  emitAddrOf(cx, 3, "__bitstr_0")
  assert(len(cx.code.bytes) == 8)
  assert(wordAt(cx.code, 0) == 0x90000003)
  assert(wordAt(cx.code, 4) == 0x91000063)
  assert(len(cx.relocs) == 2)
  assert(cx.relocs[0].offset == 0 && cx.relocs[0].kind == RelocKind.Page21)
  assert(cx.relocs[1].offset == 4 && cx.relocs[1].kind == RelocKind.PageOff12)
  assert(cx.relocs[1].symbol == "__bitstr_0")

  // A jump fixup resolves against blockOffsets. AArch64's branch immediate is
  // PC-relative to the branch instruction's OWN address (not the next one), so
  // the word offset is exactly 1048/4 with no off-by-one.
  cx = testA64Ctx()
  cx.blockOffsets = [0, 0]
  emitJumpFixup(cx, 1) // patchOffset == 0
  cx.blockOffsets[1] = 1048
  patchJumpFixups(cx)
  assert(wordAt(cx.code, 0) == 0x14000000 | (1048 / 4))

  // A conditional fixup keeps its condition and takes the imm19 field.
  cx = testA64Ctx()
  cx.blockOffsets = [0, 0]
  emitCondJumpFixup(cx, condNe(), 1)
  cx.blockOffsets[1] = 16
  patchJumpFixups(cx)
  assert(wordAt(cx.code, 0) == 0x54000000 | (4 << 5) | condNe())

  // A local cond branch patches to wherever emission has reached.
  cx = testA64Ctx()
  let at = emitLocalCondBranch(cx, condEq())
  emitRet(cx.code)
  emitRet(cx.code)
  patchLocalCondBranch(cx, at) // target == 12, three words ahead
  assert(wordAt(cx.code, at) == 0x54000000 | (3 << 5) | condEq())
}

fn checkArm64Frame() {
  assert(alignFrame16(0) == 0 && alignFrame16(1) == 16 && alignFrame16(16) == 16)
  assert(alignFrame16(17) == 32)

  // Layout, low to high: outgoing args, spills, saved GPRs, saved FPRs, then the
  // x29/x30 frame record in the top 16 bytes.
  let fr = FrameInfo{ savedGpr: [19, 20], savedFpr: [8], numSpillSlots: 3,
    outgoingBytes: 16, frameSize: 96 }
  assert(spillOffset(fr, 0) == 16 && spillOffset(fr, 2) == 32)
  assert(gprSaveOffset(fr, 0) == 40 && gprSaveOffset(fr, 1) == 48)
  assert(fprSaveOffset(fr, 0) == 56)
  assert(savedFpOffset(fr) == 80 && savedLrOffset(fr) == 88)
  assert(outgoingArgOffset(0) == 0 && outgoingArgOffset(2) == 16)
  // The callee reads the k-th incoming stack argument just above its own frame.
  assert(incomingArgOffset(fr, 0) == 96 && incomingArgOffset(fr, 1) == 104)
}

// #3509 register pairs. Every golden below came out of Apple's own assembler
// (`clang -c` on the matching `stp`/`ldp` mnemonic, read back with `otool -t`),
// not from re-deriving this encoder's arithmetic — the encoder is what is on
// trial.
fn checkArm64Pairs() {
  let c = newByteBuf()
  ldStPair(c, false, false, 29, 30, regSp(), 16)      // stp x29, x30, [sp, #16]
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xa9017bfd)
  c = newByteBuf()
  ldStPair(c, false, true, 29, 30, regSp(), 16)       // ldp x29, x30, [sp, #16]
  assert(wordAt(c, 0) == 0xa9417bfd)
  c = newByteBuf()
  ldStPair(c, false, false, 19, 20, regSp(), 40)      // stp x19, x20, [sp, #40]
  assert(wordAt(c, 0) == 0xa902d3f3)
  c = newByteBuf()
  ldStPair(c, false, true, 19, 20, regSp(), 40)       // ldp x19, x20, [sp, #40]
  assert(wordAt(c, 0) == 0xa942d3f3)
  c = newByteBuf()
  ldStPair(c, true, false, 8, 9, regSp(), 56)         // stp d8, d9, [sp, #56]
  assert(wordAt(c, 0) == 0x6d03a7e8)
  c = newByteBuf()
  ldStPair(c, true, true, 8, 9, regSp(), 56)          // ldp d8, d9, [sp, #56]
  assert(wordAt(c, 0) == 0x6d43a7e8)
  // The reach of the signed imm7, both ends and the zero case.
  c = newByteBuf()
  ldStPair(c, false, false, 27, 28, regSp(), 504)     // stp x27, x28, [sp, #504]
  assert(wordAt(c, 0) == 0xa91ff3fb)
  c = newByteBuf()
  ldStPair(c, false, false, 19, 20, regSp(), 0)       // stp x19, x20, [sp]
  assert(wordAt(c, 0) == 0xa90053f3)
  c = newByteBuf()
  ldStPair(c, false, false, 19, 20, regSp(), 0 - 512) // stp x19, x20, [sp, #-512]
  assert(wordAt(c, 0) == 0xa92053f3)

  assert(pairFits(0) && pairFits(504) && pairFits(0 - 512))
  assert(!pairFits(512) && !pairFits(0 - 520) && !pairFits(4))

  // A run of four pairs into two instructions; five leaves the last single, and
  // the single MUST land at the slot the pairs left off at — a run that drifts
  // by one slot is a silently wrong frame, not a crash.
  c = newByteBuf()
  frameRun(c, [19, 20, 21, 22], false, false, regSp(), 40)
  let want = newByteBuf()
  ldStPair(want, false, false, 19, 20, regSp(), 40)
  ldStPair(want, false, false, 21, 22, regSp(), 56)
  assertSameBytes(c, want)
  c = newByteBuf()
  frameRun(c, [19, 20, 21], false, true, regSp(), 40)
  want = newByteBuf()
  ldStPair(want, false, true, 19, 20, regSp(), 40)
  loadImm(want, 21, regSp(), 56, 8, false)
  assertSameBytes(c, want)

  // Out of imm7 reach: every register falls back to the single access it used
  // before #3509, at exactly the same offsets.
  c = newByteBuf()
  frameRun(c, [19, 20], false, false, regSp(), 512)
  want = newByteBuf()
  storeImm(want, 19, regSp(), 512, 8)
  storeImm(want, 20, regSp(), 520, 8)
  assertSameBytes(c, want)
  // ... and a float run does the same, with the float single form.
  c = newByteBuf()
  frameRun(c, [8, 9, 10], true, false, regSp(), 1024)
  want = newByteBuf()
  storeImmF(want, 8, regSp(), 1024, 8)
  storeImmF(want, 9, regSp(), 1032, 8)
  storeImmF(want, 10, regSp(), 1040, 8)
  assertSameBytes(c, want)

  // An empty save set emits nothing at all (a frameless-adjacent function).
  c = newByteBuf()
  frameRun(c, []int(0), false, false, regSp(), 0)
  assert(len(c.bytes) == 0)
}

// #3495 logical-immediate (bitmask N:immr:imms). Every golden below came out
// of Apple's own assembler (`clang -c` on the matching `and`/`orr`/`eor`/
// `ands` mnemonic, read back with `otool -t`), not from re-deriving this
// encoder's own arithmetic — the encoder is what is on trial, and this scheme
// is exactly the kind of bit-twiddling a self-derived oracle would only
// confirm its own misunderstanding of.
fn checkArm64LogicalImm() {
  // The ticket's own example: `and x1, x2, #-8`.
  let c = newByteBuf()
  logicalImmediate(c, 0, fitsLogicalImm(64, 0 - 8), 2, 1)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0x927df041)
  // Same immediate, different registers — the exact word the ticket quotes
  // (0x927df142), confirming the field derivation is register-independent.
  c = newByteBuf()
  logicalImmediate(c, 0, fitsLogicalImm(64, 0 - 8), 10, 2)
  assert(wordAt(c, 0) == 0x927df142)

  // A period-8 repeating pattern (`and x1, x2, #0xf0f0f0f0f0f0f0f0`).
  c = newByteBuf()
  let repeat8 = fitsLogicalImm(64, i64(u64(0xf0f0f0f0f0f0f0f0)))
  logicalImmediate(c, 0, repeat8, 2, 1)
  assert(wordAt(c, 0) == 0x9204cc41)
  // Its 32-bit (W) form — same low-32-bit pattern, `and w1, w2, #0xf0f0f0f0`.
  // Exercises `fitsLogicalImm`'s regSize==32 path, which production code
  // (always 64-bit; arm64.bit's `logicalImmediate` hardcodes sf=1) never
  // reaches, so this is the only place it is proven correct.
  let repeat8w = fitsLogicalImm(32, 0xf0f0f0f0)
  assert(logicalImmWord(0, 0, repeat8w, 2, 1) == 0x1204cc41)

  // ORR: a plain non-wrapping low run of ones (`orr x5, x2, #0xff`).
  c = newByteBuf()
  logicalImmediate(c, 1, fitsLogicalImm(64, 0xff), 2, 5)
  assert(wordAt(c, 0) == 0xb2401c45)

  // EOR: a period-16 pattern (`eor x5, x2, #0xff00ff00ff00ff00`).
  c = newByteBuf()
  let repeat16 = fitsLogicalImm(64, i64(u64(0xff00ff00ff00ff00)))
  logicalImmediate(c, 2, repeat16, 2, 5)
  assert(wordAt(c, 0) == 0xd2089c45)

  // ANDS (opc=3): flags-setting form, `ands x5, x2, #7`.
  c = newByteBuf()
  logicalImmediate(c, 3, fitsLogicalImm(64, 7), 2, 5)
  assert(wordAt(c, 0) == 0xf2400845)

  // All-ones-ish patterns, both hitting the WRAPPING branch of the
  // derivation (a run of 1s that wraps past bit 0): `#0x7fffffffffffffff`
  // (63 ones) and `#0xfffffffffffffe00` (56 ones, byte-aligned).
  c = newByteBuf()
  let allOnesish1 = fitsLogicalImm(64, i64(u64(0x7fffffffffffffff)))
  logicalImmediate(c, 0, allOnesish1, 2, 1)
  assert(wordAt(c, 0) == 0x9240f841)
  c = newByteBuf()
  let allOnesish2 = fitsLogicalImm(64, i64(u64(0xfffffffffffffe00)))
  logicalImmediate(c, 0, allOnesish2, 4, 3)
  assert(wordAt(c, 0) == 0x9277d883)

  // Not every constant is representable: 0x12345678 is neither a contiguous
  // run at any element size nor a wrapped one (clang's own assembler rejects
  // `and x1, x2, #0x12345678` with "expected compatible register or logical
  // immediate"). The predicate must say so, not emit a plausible-but-wrong
  // word.
  assert(!fitsLogicalImm(64, 0x12345678).fits)
  // The two values the ISA carves out entirely — replicating 0 or all bits
  // set would make AND/ORR/EOR either a no-op or a full clear/set, which the
  // ISA spends no bitmask encoding on since a register form (or MOVN/MOVZ)
  // already covers it.
  assert(!fitsLogicalImm(64, 0).fits)
  assert(!fitsLogicalImm(64, 0 - 1).fits)
}

fn checkArm64Moves() {
  // Independent moves emit as-is; a self-move is dropped entirely.
  let cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(1, RegClass.Int), dst: plocReg(2, RegClass.Int) },
    PMove{ src: plocReg(3, RegClass.Int), dst: plocReg(3, RegClass.Int) }])
  assert(len(cx.code.bytes) == 4 && wordAt(cx.code, 0) == 0xaa0103e2) // mov x2, x1

  // A dependent chain must drain in reverse: x1->x2 has to happen BEFORE x0->x1
  // overwrites x1, no matter what order the moves arrive in.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(1, RegClass.Int) },
    PMove{ src: plocReg(1, RegClass.Int), dst: plocReg(2, RegClass.Int) }])
  let want = newByteBuf()
  movRR(want, 2, 1)
  movRR(want, 1, 0)
  assertSameBytes(cx.code, want)

  // Regression (#1235): two spilled values swapping stack slots form a mem<->mem
  // 2-cycle. The cycle-break saves one slot's value in a scratch register held
  // across the whole rotation, so that register must differ from the one emitMove
  // uses as its own mem->mem copy temp (scratch1). Using scratch1 for both means
  // the first rotation step overwrites the saved value and the swap silently
  // corrupts — one loop-carried value takes another's. Byte-exact, so a revert to
  // scratch1 fails here and not only in an allocation-sensitive golden.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocMem(0, RegClass.Int), dst: plocMem(8, RegClass.Int) },
    PMove{ src: plocMem(8, RegClass.Int), dst: plocMem(0, RegClass.Int) }])
  want = newByteBuf()
  loadImm(want, scratch2(), regSp(), 8, 8, false)  // save start slot into x10 (NOT x9)
  loadImm(want, scratch1(), regSp(), 0, 8, false)  // rotate the mem->mem move via x9
  storeImm(want, scratch1(), regSp(), 8, 8)
  storeImm(want, scratch2(), regSp(), 0, 8)        // restore saved value from x10
  assertSameBytes(cx.code, want)

  // The float cycle uses the float scratch pair, not the int one.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(0, RegClass.Float), dst: plocReg(1, RegClass.Float) },
    PMove{ src: plocReg(1, RegClass.Float), dst: plocReg(0, RegClass.Float) }])
  want = newByteBuf()
  fmovFF(want, fscratch2(), 1, 8)
  fmovFF(want, 1, 0, 8)
  fmovFF(want, 0, fscratch2(), 8)
  assertSameBytes(cx.code, want)

  // #3182: a single call carrying BOTH classes at once must produce the exact
  // same bytes as the two independent one-class calls above interleaved in
  // call order — merging must not perturb same-class ordering or scratch
  // choice. Concatenates the dependent-int-chain case with the float-cycle
  // case into one movesIn list.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(0, RegClass.Int), dst: plocReg(1, RegClass.Int) },
    PMove{ src: plocReg(1, RegClass.Int), dst: plocReg(2, RegClass.Int) },
    PMove{ src: plocReg(0, RegClass.Float), dst: plocReg(1, RegClass.Float) },
    PMove{ src: plocReg(1, RegClass.Float), dst: plocReg(0, RegClass.Float) }])
  want = newByteBuf()
  movRR(want, 2, 1)
  movRR(want, 1, 0)
  fmovFF(want, fscratch2(), 1, 8)
  fmovFF(want, 1, 0, 8)
  fmovFF(want, 0, fscratch2(), 8)
  assertSameBytes(cx.code, want)
}

fn checkArm64Operands() {
  // A vreg in a register reads/writes with no memory traffic; a spilled one goes
  // through its frame slot at outgoingBytes + slot*8.
  let cx = testA64Ctx()
  cx.intRegs = [0, 1, 2]
  cx.floatRegs = [4, 5]
  cx.frame = FrameInfo{ savedGpr: []int(0), savedFpr: []int(0), numSpillSlots: 2,
    outgoingBytes: 16, frameSize: 64 }
  cx.result = RegAllocResult{
    locations: [RegLoc{ isSpill: false, index: 2 }, RegLoc{ isSpill: true, index: 1 },
      RegLoc{ isSpill: false, index: 1 }, RegLoc{ isSpill: true, index: 0 }],
    numSpillSlots: 2, stackMaps: []StackMapEntry(0) }

  assert(getInt(cx, 0, scratch1()) == 2 && len(cx.code.bytes) == 0)
  assert(getInt(cx, 1, scratch1()) == scratch1())
  assert(wordAt(cx.code, 0) == 0xf9400fe9) // ldr x9, [sp, #24]
  assert(getFloat(cx, 2, fscratch1()) == 5)
  assert(getFloat(cx, 3, fscratch1()) == fscratch1())
  assert(wordAt(cx.code, 4) == 0xfd400bfe) // ldr d30, [sp, #16]

  cx.code = newByteBuf()
  putInt(cx, 0, 7)
  assert(wordAt(cx.code, 0) == 0xaa0703e2) // mov x2, x7
  cx.code = newByteBuf()
  putInt(cx, 1, 7)
  assert(wordAt(cx.code, 0) == 0xf9000fe7) // str x7, [sp, #24]

  assert(plocOf(cx, 0, RegClass.Int).isReg && plocOf(cx, 0, RegClass.Int).v == 2)
  assert(plocOf(cx, 2, RegClass.Float).v == 5)
  assert(!plocOf(cx, 1, RegClass.Int).isReg && plocOf(cx, 1, RegClass.Int).v == 24)

  cx.instToVreg = [5, 6]
  assert(vregOf(cx, 1) == 6)
}

fn checkArm64Extend() {
  // SBFM/UBFM with the immr/imms pairs that name the low 1/2/4 bytes.
  let c = newByteBuf()
  extendRegA(c, 5, 3, 1, true)
  assert(wordAt(c, 0) == 0x93401c65) // sxtb x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 1, false)
  assert(wordAt(c, 0) == 0xd3401c65) // uxtb x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 2, true)
  assert(wordAt(c, 0) == 0x93403c65) // sxth x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 4, true)
  assert(wordAt(c, 0) == 0x93407c65) // sxtw x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 4, false)
  assert(wordAt(c, 0) == 0xd3407c65) // ubfx x5, x3, #0, #32
  // Width 8 is a plain move, and a move to itself is nothing at all.
  c = newByteBuf()
  extendRegA(c, 5, 3, 8, true)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xaa0303e5)
  c = newByteBuf()
  extendRegA(c, 5, 5, 8, true)
  assert(len(c.bytes) == 0)

  // canonNarrow restores the width-canonical invariant only where it can be lost:
  // never for a full-width int, never for a float.
  c = newByteBuf()
  canonNarrow(c, 5, w64())
  assert(len(c.bytes) == 0)
  c = newByteBuf()
  canonNarrow(c, 5, mkWidth(4, RegClass.Float, false))
  assert(len(c.bytes) == 0)
  c = newByteBuf()
  canonNarrow(c, 5, w8s())
  assert(wordAt(c, 0) == 0x93401ca5) // sxtb x5, w5
}

fn checkArm64MemFloat() {
  // ldr/str x5, [x1] and the w/b/h load variants.
  let c = newByteBuf()
  loadImm(c, 5, 1, 0, 8, false)
  assert(wordAt(c, 0) == 0xf9400025)
  c = newByteBuf()
  storeImm(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xf9000025)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 4, false)
  assert(wordAt(c, 0) == 0xb9400025)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 4, true)
  assert(wordAt(c, 0) == 0xb9800025) // ldrsw
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 1, false)
  assert(wordAt(c, 0) == 0x39400025) // ldrb
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 1, true)
  assert(wordAt(c, 0) == 0x39800025) // ldrsb (64-bit dest)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 2, false)
  assert(wordAt(c, 0) == 0x79400025) // ldrh
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 2, true)
  assert(wordAt(c, 0) == 0x79800025) // ldrsh

  // Nonzero scaled offsets: #16 and the largest that still fits (#4088).
  c = newByteBuf()
  loadImm(c, 5, 1, 16, 8, false)
  assert(wordAt(c, 0) == 0xf9400825)
  c = newByteBuf()
  loadImm(c, 5, 1, 4088, 8, false)
  assert(wordAt(c, 0) == 0xf947fc25)

  // Register-offset forms, unshifted and scaled, int and fp.
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 1, 2, false, 1, 5)
  assert(wordAt(c, 0) == 0xf8626825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 1, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xf8627825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 0, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xf8227825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, true, 1, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xfc627825) // ldr d5,[x1,x2,lsl#3]

  // loadIndexed/storeIndexed pick the scaled register-offset form.
  c = newByteBuf()
  loadIndexed(c, 5, 1, 2, 8, false)
  assert(wordAt(c, 0) == 0xf8627825)
  c = newByteBuf()
  storeIndexed(c, 5, 1, 2, 4)
  assert(wordAt(c, 0) == 0xb8227825)

  // Float load/store, fmov transfers, arithmetic, fneg, fcmp.
  c = newByteBuf()
  storeImmF(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xfd000025)
  c = newByteBuf()
  loadImmF(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xfd400025)
  c = newByteBuf()
  storeImmF(c, 5, 1, 0, 4)
  assert(wordAt(c, 0) == 0xbd000025) // width dictates the size field: s-register
  c = newByteBuf()
  fmovToFp(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x9e670045)
  c = newByteBuf()
  fmovFromFp(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x9e660045)
  c = newByteBuf()
  fmovToFp(c, 5, 2, 4)
  assert(wordAt(c, 0) == 0x1e270045)
  c = newByteBuf()
  fmovFromFp(c, 5, 2, 4)
  assert(wordAt(c, 0) == 0x1e260045)
  c = newByteBuf()
  fArithRR(c, 2, 5, 2, 3, 8) // fadd
  assert(wordAt(c, 0) == 0x1e632845)
  c = newByteBuf()
  fArithRR(c, 3, 5, 2, 3, 8) // fsub
  assert(wordAt(c, 0) == 0x1e633845)
  c = newByteBuf()
  fArithRR(c, 0, 5, 2, 3, 8) // fmul
  assert(wordAt(c, 0) == 0x1e630845)
  c = newByteBuf()
  fArithRR(c, 1, 5, 2, 3, 8) // fdiv
  assert(wordAt(c, 0) == 0x1e631845)
  c = newByteBuf()
  fnegF(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x1e614045)
  c = newByteBuf()
  fcmp(c, 2, 3, 8)
  assert(wordAt(c, 0) == 0x1e632040)
  c = newByteBuf()
  fmovFF(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x1e604045)
  // width=4 selects the s-register encoding for the same register index.
  c = newByteBuf()
  fArithRR(c, 2, 5, 2, 3, 4)
  assert(wordAt(c, 0) == 0x1e232845)

  // ret / udf.
  c = newByteBuf()
  emitRet(c)
  assert(wordAt(c, 0) == 0xd65f03c0)
  c = newByteBuf()
  emitUdf(c)
  assert(wordAt(c, 0) == 0)

  // Branch fixups patch to the correct relative word offset. An unconditional
  // B at 0 targeting byte 8 is +2 words; a B.cond likewise, in its imm19 field.
  c = newByteBuf()
  emitWord(c, 0x14000000) // B placeholder at offset 0
  emitWord(c, 0)
  emitWord(c, 0)
  patchBranchTo(c, 0, 8, true)
  assert(wordAt(c, 0) == (0x14000000 | 2))
  c = newByteBuf()
  emitWord(c, 0x54000000 | condEq())
  emitWord(c, 0)
  emitWord(c, 0)
  patchBranchTo(c, 0, 8, false)
  assert(wordAt(c, 0) == (0x54000000 | (2 << 5) | condEq()))
  // A backward branch encodes a negative word offset (two's complement).
  c = newByteBuf()
  emitWord(c, 0)
  emitWord(c, 0)
  emitWord(c, 0x14000000) // B at offset 8 targeting 0 == -2 words
  patchBranchTo(c, 8, 0, true)
  assert(wordAt(c, 8) == (0x14000000 | ((-2) & 0x3FFFFFF)))
}

// #4430: computeRedundantBoundsBranch must refuse a second `br` on a shared
// condition unless the FIRST `br`'s TRUE edge is provably the only way in.
//
// #4461 REPLACED THE SOUNDNESS ARGUMENT THAT USED TO STAND HERE, because
// both halves of it were false and it explained why a live miscompile could
// not happen. It claimed (a) every two `br`s sharing one condition id come
// from `emitBoundsCheck` being called twice in straight-line code
// (loweraccess.bit), and (b) no source program can share a condition id
// across a block boundary at all, since "every value carried across a block
// boundary is renamed to a fresh block-param id". Neither holds. There are at
// least three producers, not one: `emitBoundsCheck`'s double call,
// `emitInlineStringSlice` (lowerreslice.bit), which points BOTH of its bounds
// `br`s at one shared `oob` block on purpose, and plain `&&` under an
// enclosing `if` on the same value (lowercond.bit). And ids are plainly NOT
// all renamed — `if (c) { if (c && x) ... }` lowers to `bb0: br %3, ...` and
// `bb1: br %3, ...`, the same `%3` read by both, which is exactly what makes
// the analysis fire on ordinary source.
//
// So these checks stand on what they assert directly, not on a reachability
// argument: they pin `chainDominates`'s contract (fold only across a TRUE
// edge) and `computeDeadBoundsBlocks`'s (kill only a single-predecessor
// block). Hand-built IR is used because it is the only way to state a
// negative case as an assertion instead of hoping a corpus contains one —
// breaking either predicate (e.g. returning `true` unconditionally) still
// compiles every program in this repo, and is caught ONLY here.
fn checkRedundantBoundsBranchFalseEdge() {
  let ctx = newTypeContext()
  // The exact type id is irrelevant here — computeRedundantBoundsBranch reads
  // only op/lhs/ival/ival2, never `ty` — so voidId avoids depending on
  // primType's own indexing scheme for a fact this check does not need.
  let boolt = ctx.voidId

  // bb0: %0 = const_bool, br %0, bb1(), bb2()
  // bb1: ret               <- br1's TRUE edge; a dead end, never reaches bb2
  // bb2: br %0, bb3(), bb4() <- reuses %0, but is reached ONLY via br1's FALSE
  //                             edge, so it must NOT be marked redundant
  // bb3: ret
  // bb4: ret
  let cond = mkInstr(Op.ConstBool, boolt)
  cond.bval = true
  let br1 = mkInstr(Op.Br, ctx.voidId)
  br1.lhs = 0
  br1.ival = 1
  br1.ival2 = 2
  let ret1 = mkInstr(Op.Ret, ctx.voidId)
  let br2 = mkInstr(Op.Br, ctx.voidId)
  br2.lhs = 0
  br2.ival = 3
  br2.ival2 = 4
  let ret3 = mkInstr(Op.Ret, ctx.voidId)
  let ret4 = mkInstr(Op.Ret, ctx.voidId)
  let f = IrFunc{
    name: "falseEdge", paramTypes: []int(0), result: ctx.voidId,
    blocks: [
      IrBlock{ instsStart: 0, paramCount: 0, instsLen: 2 },
      IrBlock{ instsStart: 2, paramCount: 0, instsLen: 1 },
      IrBlock{ instsStart: 3, paramCount: 0, instsLen: 1 },
      IrBlock{ instsStart: 4, paramCount: 0, instsLen: 1 },
      IrBlock{ instsStart: 5, paramCount: 0, instsLen: 1 },
    ],
    instrs: [cond, br1, ret1, br2, ret3, ret4],
    isFallible: false,
  }
  let redundant = computeRedundantBoundsBranch(f)
  assert(!redundant[3], "FALSEEDGE-1: br2 is reached only via br1's FALSE edge and must not be folded")

  // Mirror shape, TRUE edge this time: bb1 (br1's true target) falls straight
  // into bb2's `br %0`, so THIS is the shape emitBoundsCheck's double-call
  // actually produces, and it must fold.
  let br1t = mkInstr(Op.Br, ctx.voidId)
  br1t.lhs = 0
  br1t.ival = 1
  br1t.ival2 = 4 // else target is unused by this trace; any dead-end block is fine
  let jump1 = mkInstr(Op.Jump, ctx.voidId)
  jump1.ival = 2
  let br2t = mkInstr(Op.Br, ctx.voidId)
  br2t.lhs = 0
  br2t.ival = 3
  br2t.ival2 = 4
  let ret3t = mkInstr(Op.Ret, ctx.voidId)
  let ret4t = mkInstr(Op.Ret, ctx.voidId)
  let ft = IrFunc{
    name: "trueEdge", paramTypes: []int(0), result: ctx.voidId,
    blocks: [
      IrBlock{ instsStart: 0, paramCount: 0, instsLen: 2 },
      IrBlock{ instsStart: 2, paramCount: 0, instsLen: 1 }, // bb1: jump bb2
      IrBlock{ instsStart: 3, paramCount: 0, instsLen: 1 }, // bb2: br2t
      IrBlock{ instsStart: 4, paramCount: 0, instsLen: 1 }, // bb3
      IrBlock{ instsStart: 5, paramCount: 0, instsLen: 1 }, // bb4, dead end
    ],
    instrs: [cond, br1t, jump1, br2t, ret3t, ret4t],
    isFallible: false,
  }
  let redundantT = computeRedundantBoundsBranch(ft)
  assert(redundantT[3], "FALSEEDGE-2: br2 reached only via br1's TRUE edge must fold")
}

// #4461: folding a redundant `br` is one fact; killing the block on its else
// edge is a second, stronger one. `redundantBr[i]` licenses only the folded
// br's OWN edge, so a block with another predecessor still runs, and
// narrowing it to `paramCount` drops its terminator — after which
// emitJumpOrFallThrough walks past it and the surviving edge falls through
// into the next LIVE block. Silent, exit 0.
//
// The shape below is `if (c) { if (c && x) ... }` reduced to its skeleton:
// bb3 is the `&&` short-circuit join, reached BOTH by br1's else edge and by
// bb2's jump, and its own `br %7` is the real `x` test. Both halves are
// asserted on purpose — `deadBlock[3] == false` alone is satisfied by a
// "fix" that simply stops folding anything, which would silently retire the
// optimization instead of correcting it.
fn checkDeadBoundsBlockNeedsSinglePred() {
  let ctx = newTypeContext()
  let boolt = ctx.voidId

  // bb0: %0 = const_bool, br %0, bb1(), bb6()
  // bb1: br %0, bb2(), bb3()   <- redundant (reached only via bb0's TRUE edge)
  // bb2: jump bb3()            <- bb3's SECOND predecessor
  // bb3(%4): br %4, bb4(), bb5()  <- the join; must NOT be marked dead
  // bb4/bb5/bb6: ret
  let cond = mkInstr(Op.ConstBool, boolt)
  cond.bval = true
  let br0 = mkInstr(Op.Br, ctx.voidId)
  br0.lhs = 0
  br0.ival = 1
  br0.ival2 = 6
  let br1 = mkInstr(Op.Br, ctx.voidId)
  br1.lhs = 0
  br1.ival = 2
  br1.ival2 = 3
  let jump2 = mkInstr(Op.Jump, ctx.voidId)
  jump2.ival = 3
  let p7 = mkInstr(Op.BlockParam, boolt)
  let br3 = mkInstr(Op.Br, ctx.voidId)
  br3.lhs = 4
  br3.ival = 4
  br3.ival2 = 5
  let ret4 = mkInstr(Op.Ret, ctx.voidId)
  let ret5 = mkInstr(Op.Ret, ctx.voidId)
  let ret6 = mkInstr(Op.Ret, ctx.voidId)
  let f = IrFunc{
    name: "sharedJoin", paramTypes: []int(0), result: ctx.voidId,
    blocks: [
      IrBlock{ instsStart: 0, paramCount: 0, instsLen: 2 }, // bb0
      IrBlock{ instsStart: 2, paramCount: 0, instsLen: 1 }, // bb1
      IrBlock{ instsStart: 3, paramCount: 0, instsLen: 1 }, // bb2
      IrBlock{ instsStart: 4, paramCount: 1, instsLen: 2 }, // bb3, the join
      IrBlock{ instsStart: 6, paramCount: 0, instsLen: 1 }, // bb4
      IrBlock{ instsStart: 7, paramCount: 0, instsLen: 1 }, // bb5
      IrBlock{ instsStart: 8, paramCount: 0, instsLen: 1 }, // bb6
    ],
    instrs: [cond, br0, br1, jump2, p7, br3, ret4, ret5, ret6],
    isFallible: false,
  }
  // The premise: bb3 really does have two predecessors in this shape, so a
  // guard keyed on the predecessor count is being exercised and not skipped.
  let predCount = computeBlockPredCounts(f)
  assert(predCount[3] == 2, "SHAREDJOIN-0: bb3 must have two predecessors for this check to test anything")

  let redundant = computeRedundantBoundsBranch(f)
  assert(redundant[2], "SHAREDJOIN-1: br1 reached only via bb0's TRUE edge must still fold")

  let deadBlock = computeDeadBoundsBlocks(f, redundant)
  assert(!deadBlock[3], "SHAREDJOIN-2: bb3 has a second predecessor (bb2's jump) and must not be marked dead")
}
