// compiler/checktraitresolve.bit — split out of checktrait.bit (#5641,
// which was at the 800-line E0200 ceiling with zero headroom). Sibling
// .bit file, same module: nothing here needs an import. See
// checktrait.bit's header for how this fits the overall trait-injection
// design (SPEC §10.7, #3369).
//
// A trait's effective (required, provided) method set: TraitMethodSet
// folds in every method a trait supplies directly plus, recursively,
// everything its own `use` statements pull in (resolveTraitMethods),
// with a name provided by two different sources reported as E0120
// (mergeOneProvided/mergeTraitSets). Shared by nested trait composition
// and by a class's own `use` statements (checktraitinject.bit's
// effectiveUses calls resolveTraitMethods directly).

// ---- a trait's effective (required, provided) method set ----------------

// `providedBy[name]` names the trait that supplies `name` (possibly reached
// through a nested `use`); `providedNode[name]` is the `trait_method` to
// clone. `required[name]` is true iff `name` still needs a supplier.
class TraitMethodSet {
  required: map<string, bool>,
  // The trait that first declared `name` as required — kept even after
  // `name` is satisfied (required[name] flips to false) so a diagnostic can
  // still name which trait asked for it.
  requiredFrom: map<string, string>,
  providedBy: map<string, string>,
  providedNode: map<string, int>,
}

fn emptyTraitMethodSet(): TraitMethodSet {
  return TraitMethodSet{
    required = map<string, bool>{}, requiredFrom = map<string, string>{},
    providedBy = map<string, string>{}, providedNode = map<string, int>{},
  }
}

// Folds one provided name from `src` into `dst`, reporting E0120 when the
// two disagree on who provides it. Split out of `mergeTraitSets` purely to
// keep that loop's own body under the complexity limit.
fn mergeOneProvided(
  dst: TraitMethodSet,
  src: TraitMethodSet,
  name: string,
  diags: Diagnostics,
  span: Span,
) {
  let provider = src.providedBy[name]
  let (existing, has) = dst.providedBy[name]
  if (has && existing != "" && existing != provider) {
    report(
      diags, ecTraitMethodConflict, span,
      "trait method conflict: '${existing}' and '${provider}' both provide '${name}'",
      "declare '${name}' on the class itself to resolve the conflict",
    )
    return
  }
  dst.providedBy[name] = provider
  dst.providedNode[name] = src.providedNode[name]
  dst.required[name] = false
}

// Merges `src` into `dst`. Shared by nested trait composition (a trait
// `use`ing another) and class-level composition (a class `use`ing several)
// — both are "combine several method sets, a name provided twice by two
// different sources is an error".
fn mergeTraitSets(dst: TraitMethodSet, src: TraitMethodSet, diags: Diagnostics, span: Span) {
  for (name, provider) of src.providedBy {
    if (provider != "") {
      mergeOneProvided(dst, src, name, diags, span)
    }
  }
  for (name, isReq) of src.required {
    if (!isReq) {
      continue
    }
    let (existing, has) = dst.providedBy[name]
    if (!(has && existing != "")) {
      dst.required[name] = true
      dst.requiredFrom[name] = src.requiredFrom[name]
    }
  }
}

// One trait's OWN direct members (not what it inherits via `use`), folded
// into `result` so they override anything already merged in from a nested
// trait — "the class [or trait] declaring that method itself wins".
fn applyOwnMembers(
  result: TraitMethodSet,
  tree: Tree,
  source: string,
  name: string,
  members: []int,
) {
  let i = 0
  while (i < len(members)) {
    let m = members[i]
    if (getNode(tree, m).tag == Tag.TraitMethod) {
      let mk = kidsOf(tree, m) // [name, generics, params, result, body_or_none]
      let mname = identText(tree, source, mk[0])
      if (mk[4] == 0) {
        result.required[mname] = true
        result.requiredFrom[mname] = name
        result.providedBy[mname] = ""
        result.providedNode[mname] = 0
      } else {
        result.providedBy[mname] = name
        result.providedNode[mname] = m
        result.required[mname] = false
      }
    }
    i = i + 1
  }
}

// The full method set `name` provides once every trait it (transitively)
// `use`s is folded in, with `name`'s OWN direct members overriding anything
// inherited. `depth` bounds the recursion — cycles are rejected separately
// (checkTraitCycles), so this is a defensive ceiling, not the real guard.
fn resolveTraitMethods(ctx: TraitCtx, name: string, depth: int): TraitMethodSet {
  let result = emptyTraitMethodSet()
  let (node, ok) = ctx.traits[name]
  if (!ok || depth > 64) {
    return result
  }
  let members = kidsOf(ctx.tree, kidsOf(ctx.tree, node)[1])
  let i = 0
  while (i < len(members)) {
    if (getNode(ctx.tree, members[i]).tag == Tag.UseStmt) {
      let usedIdents = kidsOf(ctx.tree, members[i])
      let j = 0
      while (j < len(usedIdents)) {
        let usedName = identText(ctx.tree, ctx.source, usedIdents[j])
        let sub = resolveTraitMethods(ctx, usedName, depth + 1)
        mergeTraitSets(result, sub, ctx.diags, getNode(ctx.tree, members[i]).span)
        j = j + 1
      }
    }
    i = i + 1
  }
  applyOwnMembers(result, ctx.tree, ctx.source, name, members)
  return result
}
