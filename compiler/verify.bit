// compiler/verify.bit — the IR's unchecked invariant, checked (#1925).
//
// THE RULE. A value defined OUTSIDE a loop may not be read INSIDE it. Everything
// live across a loop enters through the header's block parameters.
//
// Every lowering in `compiler/` already obeys it — `lowerWhile` threads the live
// locals through the header, `lowerForOf` and `lowerForInf` the same, and each
// of them re-materializes a constant inside the loop rather than reaching back
// for the one in the entry block. None of that was written down, and nothing
// enforced it.
//
// Reading a value from another block is otherwise ordinary: a `while` body reads
// its header's parameters, and a straight-line value is read across a join
// constantly. Only the loop boundary is dangerous.
//
// WHAT HAPPENS WHEN IT IS BROKEN, measured rather than reasoned about. #1924's
// slice-fill loop first read the slice and the length straight out of the entry
// block instead of passing them in. The result:
//
//   - the builder accepted it;
//   - `--dump-ir` and `--dump-ir-pre` rendered plausible, correct-looking IR;
//   - the optimizer passed it through;
//   - and the program ran the loop body EXACTLY ONCE. Element 0 was live, the
//     rest were null, and the crash landed at an unrelated later line.
//
// No diagnostic at any stage. That is the same class as #1914 and #1921: a
// compiler that knows enough to refuse, and does not.
//
// WHY IT MISCOMPILES. A value's live interval runs from its definition to its
// textually-last use, and the allocator does NOT extend an interval to cover a
// loop that reads it. So a value defined before the loop and read inside it is
// considered dead after that read, its register is reused by the rest of the
// body — across the `gc_alloc` call, in that case — and the next iteration reads
// whatever replaced it. A block parameter is immune because the back edge
// redefines it on every iteration.
//
// So the underlying defect is in the register allocator, and this file does not
// fix it: it refuses the IR that triggers it. Extending intervals across loops
// is a real change to liveness in BOTH backends, and nothing in the tree needs
// it today because every lowering already threads through block parameters.
// That is tracked separately on #1925; what is unacceptable is the silence.
//
// The per-opcode operand table this reads lives in `opt.bit` as `instrOperands`,
// shared with dead-code elimination rather than copied here — see its comment.

// Every loop-boundary violation in `f`, as rendered messages. Empty is the
// expected result for every function this compiler lowers.
//
// THE RULE IS ABOUT LOOPS, NOT ABOUT BLOCKS, and the first version of this
// verifier got that wrong in a way worth recording. Reading a value from
// another block is ordinary and correct — every `while` body reads its header's
// parameters, and a straight-line value is used across a join all the time. A
// verifier that flagged all of those reported twelve violations on `itoa`.
//
// What is NOT safe is a value defined OUTSIDE a loop and read INSIDE it. Its
// live interval ends at the textually-last use, and the allocator does not
// extend an interval to cover a loop that reads it, so the register is free for
// reuse in the loop body — across a call, in #1924's case — and the next
// iteration reads whatever replaced it. A block parameter is immune because the
// back edge redefines it every iteration.
//
// Back edges are recognised by layout position rather than by dominators: a
// block's instructions occupy a contiguous range of the flat array, blocks are
// filled in the order they are begun, and every loop lowering fills its header
// before its body. So a terminator naming a target that starts at or before the
// current block closes a loop, and that loop spans every instruction from the
// target's start to this block's end.
//
// Bounded by the instruction array and the block list, both fixed before this
// runs. It executes once per function on the emit path, never inside a fixpoint.
fn verifyIrFunc(f: IrFunc): []string {
  let out = []string(0)
  let b = 0
  while (b < len(f.blocks)) {
    let blk = f.blocks[b]
    if (blk.instsLen > 0) {
      let hi = blk.instsStart + blk.instsLen
      for t of terminatorTargets(f, hi - 1) {
        if (t < 0 || t >= len(f.blocks) || f.blocks[t].instsStart > blk.instsStart) {
          continue
        }
        out = concatStrs(out, loopEscapes(f, b, f.blocks[t].instsStart, hi))
      }
    }
    b = b + 1
  }
  return out
}

// The block ids a terminator branches to. Anything else branches nowhere.
fn terminatorTargets(f: IrFunc, id: int): []int {
  let ins = f.instrs[id]
  if (ins.op == Op.Jump) {
    return [ins.ival]
  }
  if (ins.op == Op.Br) {
    return [ins.ival, ins.ival2]
  }
  return []int(0)
}

// Every read, inside the loop spanning instructions [lo, hi), of a value defined
// before `lo` — i.e. outside the loop.
fn loopEscapes(f: IrFunc, backBlock: int, lo: int, hi: int): []string {
  let out = []string(0)
  let i = lo
  while (i < hi) {
    for v of instrOperands(f, i) {
      if (v >= lo) {
        continue
      }
      out = append(
        out,
        "${f.name}: %${i} (${opName(f.instrs[i].op)}) reads %${v}, which is defined outside the loop closed by the back edge in bb${backBlock} — pass it in as a block parameter",
      )
    }
    i = i + 1
  }
  return out
}

fn concatStrs(dst: []string, src: []string): []string {
  let o = dst
  for s of src {
    // bit:lint allow E0214 -- concatStrs's only call site, verify.bit:82, reassigns out = concatStrs(out, ...) in place; out is verifyIrFunc's own []string(0), seeded fresh with no other alias
    o = append(o, s)
  }
  return o
}

// ===========================================================================
// #4400: the second unchecked invariant this file exists to catch. A jump/br
// EDGE's argument count must match its TARGET block's declared parameter
// count — the join-point contract every consumer of block arguments assumes.
//
// FOUND LIVE in the inliner: `spliceCallee` (optinline.bit) built a
// multi-word callee's join block with ONE parameter while `spliceTerm` passed
// EVERY ret arg on the jump into it. For a 2-word return that is a
// `jump bb5(%9, %4)` into a `bb5(%18: i64):` — one argument with no
// parameter to bind to.
//
// WHAT HAPPENS WHEN IT IS BROKEN, and it is the same shape as the #1925
// loop-boundary defect above: nothing at any earlier stage refuses it.
// `arm64call.bit`'s `blockArgMoves` walks an edge's arguments strictly by
// POSITION (`tb.instsStart + i`) with no bound check against the target's
// `paramCount`, so a short block param list does not fail to codegen — it
// codegens SILENTLY WRONG, writing argument k into whatever instruction slot
// happens to sit at that offset (the target block's real param when k is in
// range, an unrelated instruction when it is not). The extra ret words become
// values with no defining instruction anywhere in the function: read, never
// written. golden, the differentials and selfcheck all pass regardless,
// because every one of them exercises only what the miscompiled code
// happens to compute, never the IR's own shape.
//
// So, like the loop-boundary check: this file does not fix the producer, it
// refuses IR that violates the contract every producer must uphold.
// ===========================================================================

// The block-argument arity violations of one jump/br EDGE from block
// `fromBlock` to block `target` carrying `argc` arguments — empty when `argc`
// matches `target`'s declared `paramCount`. An out-of-range `target` reports
// nothing here; that is a different invariant (a dangling branch target) and
// not this check's job.
fn arityEdgeEscapes(f: IrFunc, fromBlock: int, target: int, argc: int): []string {
  if (target < 0 || target >= len(f.blocks)) {
    return []string(0)
  }
  let want = f.blocks[target].paramCount
  if (argc == want) {
    return []string(0)
  }
  return [
    "${f.name}: bb${fromBlock}'s edge to bb${target} passes ${argc} argument(s), but bb${target} declares ${want} parameter(s)",
  ]
}

// Every block-argument arity violation in `f`, as rendered messages. Empty is
// the expected result for every function this compiler emits. Walks every
// block's own terminator — `Op.Jump`'s single edge (`ival`/`args`) or
// `Op.Br`'s two (`ival`/`thenArgs`, `ival2`/`elseArgs`) — rather than reusing
// `terminatorTargets` above, because that helper drops the per-edge argument
// lists this check needs and Jump/Br carry them in different fields.
fn arityEscapesInFunc(f: IrFunc): []string {
  let out = []string(0)
  let b = 0
  while (b < len(f.blocks)) {
    let blk = f.blocks[b]
    if (blk.instsLen > 0) {
      let t = f.instrs[blk.instsStart + blk.instsLen - 1]
      if (t.op == Op.Jump) {
        out = concatStrs(out, arityEdgeEscapes(f, b, t.ival, len(t.args)))
      }
      if (t.op == Op.Br) {
        out = concatStrs(out, arityEdgeEscapes(f, b, t.ival, len(t.thenArgs)))
        out = concatStrs(out, arityEdgeEscapes(f, b, t.ival2, len(t.elseArgs)))
      }
    }
    b = b + 1
  }
  return out
}

// ===========================================================================
// #4404: the third unchecked invariant. A direct `Op.Call` naming a function
// DEFINED IN THIS MODULE must pass exactly as many arguments as that
// function declares parameters.
//
// Nothing checked it, and the reason it matters now is that #4404 makes the
// argument list a DERIVED quantity: a parameter whose type is an exploded
// 2-word aggregate contributes two IR parameters, so every producer of a
// direct call has to expand its argument list in step with `lowerFunc`'s
// expansion of the signature. There are several such producers — the
// resolved-call path, the deferred call, the `let f = g` function-value
// trampoline and the `spawn` trampoline — and they were written years apart.
//
// WHAT HAPPENS WHEN IT IS BROKEN, and it is the same silence as the two
// invariants above. `marshalArgs` (arm64call.bit) walks the argument list it
// is handed and `bindIncomingArgs` (arm64compile.bit) walks the parameter
// list it is handed; neither compares the two, because at a call site they
// are in different functions. A short list leaves the callee's last
// parameter holding whatever the ABI register happened to contain — a wrong
// answer at exit 0, not a crash. A long one silently drops a word.
//
// Only calls whose callee is present in this module are checked. A
// freestanding object legitimately calls symbols defined elsewhere, and an
// `extern fn` declaration is itself a module function here (a
// signature-only IrFunc), so it is covered rather than skipped.
// ===========================================================================

// Every module function's declared parameter count, keyed by link-level name.
// Built once per verification so the check is one map lookup per call rather
// than a scan of the function list.
fn paramCountsByName(funcs: []IrFunc): map<string, int> {
  let counts = map<string, int>()
  for f of funcs {
    counts[f.name] = len(f.paramTypes)
  }
  return counts
}

// The call-arity violations of `f` against `counts`. A call naming a function
// this module does not define reports nothing — that is a cross-object
// reference, whose arity this module cannot know.
fn callArityEscapesInFunc(f: IrFunc, counts: map<string, int>): []string {
  let out = []string(0)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.Call) {
      let (want, known) = counts[ins.name]
      if (known && len(ins.args) != want) {
        out = append(
          out,
          "${f.name}: %${i} calls @${ins.name} with ${len(ins.args)} argument(s), but @${ins.name} declares ${want} parameter(s)",
        )
      }
    }
    i = i + 1
  }
  return out
}

// ===========================================================================
// #4405: the fourth unchecked invariant. An `Op.CallWord` — word k > 0 of a
// call result returned in more than one ABI register — must sit at exactly
// `ival` slots after the `Op.Call` it names.
//
// The backend binds EVERY word of a call in one parallel move immediately
// after the `bl`, because nothing may be emitted in that window without
// clobbering a return register (#4236). It finds the words by scanning
// forward from the call (`callWordRunLen`), so a word that has drifted away
// from its call, or that arrives out of order, is simply not bound — its
// register is read as whatever the next instruction leaves there.
//
// That is a wrong answer at exit 0 again, and no existing check sees it: the
// IR still type-checks, every value still has a definition, and the loop and
// arity invariants above are all satisfied. The passes that could break it are
// the ones that MOVE instructions — LICM's hoist, the inliner's splice — and
// they are exactly the passes whose correctness here rests on `Op.CallWord`
// being side-effecting and on the splice consuming the whole run, neither of
// which is a property a reader of those passes would think to re-derive.
// ===========================================================================

// Every misplaced `Op.CallWord` in `f`, as rendered messages.
fn callWordEscapesInFunc(f: IrFunc): []string {
  let out = []string(0)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.CallWord && !callWordPlaced(f, i, ins)) {
      out = append(
        out,
        "${f.name}: %${i} is word ${ins.ival} of %${ins.args[0]}, which is not the call ${ins.ival} slot(s) before it",
      )
    }
    i = i + 1
  }
  return out
}

// Whether the `Op.CallWord` at `i` names a call that really is `ival` slots
// before it. Checks the word index, the owner's identity and the owner's
// opcode together: any one of them alone would admit a run the backend cannot
// bind.
fn callWordPlaced(f: IrFunc, i: int, ins: IrInstr): bool {
  if (len(ins.args) != 1 || ins.ival < 1 || ins.ival > i) {
    return false
  }
  let owner = i - ins.ival
  return ins.args[0] == owner && f.instrs[owner].op == Op.Call
}

// ===========================================================================
// #4407: the fifth unchecked invariant. `emitInlineStringSlice`
// (lowerreslice.bit)'s own comment ARGUES that the string it slices survives
// the view's internal `gc_alloc`: `s`'s IR type is `string`, `isRefType`
// reports that as a GC reference, so the register allocator keeps its
// interval live (`isRef`) across the call, and the `field_set` of `base`
// afterwards is what makes that interval span it. Nothing checked that the
// argument stays true — it holds today only because a source-level `string`
// is always one ref-typed SSA value, and #4411 is planned to explode
// `string` into independent `ptr`/`len`/`base` words (#4404 already does
// this for a 2-word tuple parameter). If a future lowering feeds this
// function anything but a ref-typed value for the view's `base`, the
// interior `ptr` it builds can outlive the memory it points into — the freed
// bytes are swept but not necessarily reused, so the failure is a wrong
// answer or a corrupt read, not a crash (#4406 names the same shape).
//
// The fingerprint is deliberately narrow rather than a general "does every
// `field_set` agree with its operand's type" sweep, because `field_set`'s own
// `ival2` is a declared store type independent of the operand's defining
// instruction (#4396) and a general sweep would need to reconcile the two
// for every ordinary class/struct field store in the tree, which is not this
// invariant. `emitInlineStringSlice` is the ONLY site in the compiler that
// `gc_alloc`s exactly `strViewHeaderSize()` bytes with `ptr_offsets =
// [strViewBaseOffset()]` and a `string`-typed result — a struct's zero-value
// `gc_alloc` (lowerslicefill.bit) is always `TypeKind.Struct`-typed, never
// `string` — so this cannot false-positive on an unrelated class today.
// ===========================================================================

// Every `gc_alloc` matching `emitInlineStringSlice`'s string-view fingerprint
// whose `base` field (offset `strViewBaseOffset()`) is set from a value that
// is not a GC reference.
fn stringViewBaseEscapesInFunc(f: IrFunc, ctx: TypeContext): []string {
  let out = []string(0)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.GcAlloc &&
      ins.ty == primType(ctx, 11) &&
      ins.ival == strViewHeaderSize() &&
      len(ins.offsets) == 1 &&
      ins.offsets[0] == strViewBaseOffset()) {
      out = concatStrs(out, stringViewBaseSetEscapes(f, ctx, i))
    }
    i = i + 1
  }
  return out
}

// The `base` field set(s) of the string view allocated at `alloc`, checked. A
// view with no `field_set` on its base at all is not this function's job:
// codegen's own descriptor would reject a traced field nobody initializes,
// and that is a different invariant.
fn stringViewBaseSetEscapes(f: IrFunc, ctx: TypeContext, alloc: int): []string {
  let out = []string(0)
  let i = alloc + 1
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.FieldSet && ins.lhs == alloc && ins.ival == strViewBaseOffset()) {
      if (!isRefType(ctx, f.instrs[ins.rhs].ty)) {
        out = append(
          out,
          "${f.name}: %${i} sets the string view %${alloc}'s base from %${ins.rhs}, whose IR type is not a GC reference — the source string must survive %${alloc}'s own gc_alloc, and only a ref-typed value stays live across it",
        )
      }
    }
    i = i + 1
  }
  return out
}

// The same over a whole module's functions, in order.
fn verifyIrFuncs(funcs: []IrFunc, ctx: TypeContext): []string {
  let counts = paramCountsByName(funcs)
  let out = []string(0)
  for f of funcs {
    out = concatStrs(out, verifyIrFunc(f))
    out = concatStrs(out, arityEscapesInFunc(f))
    out = concatStrs(out, callArityEscapesInFunc(f, counts))
    out = concatStrs(out, callWordEscapesInFunc(f))
    out = concatStrs(out, stringViewBaseEscapesInFunc(f, ctx))
  }
  return out
}

// The emit-path gate: reports every violation and answers whether `module` may
// be emitted. `what` completes "refusing to ..." so the three call sites read as
// the `stubbed` refusals beside them do.
//
// Called AFTER `optimizeModule`, deliberately: the optimizer renumbers values
// and rewrites block arguments, so verifying the pre-optimization form would
// check IR that codegen never sees.
fn verifyModuleOk(module: IrModule, src: string, what: string): bool {
  let bad = verifyIrFuncs(module.funcs, module.ctx)
  if (len(bad) == 0) {
    return true
  }
  eprint("bit: ${src}: IR verification failed (${len(bad)} violation(s)); refusing to ${what}\n")
  for m of bad {
    eprint("  ${m}\n")
  }
  return false
}
