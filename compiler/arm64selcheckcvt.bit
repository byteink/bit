// In-Bit self-checks for #4363: the `convert` selector's two extends, and the
// exact conditions under which the SOURCE-width one is dropped. Split out of
// compiler/arm64selcheck.bit, which was 784 lines against the 800-line limit
// and could not hold them — the same split compiler/arm64selcheckcmp.bit
// already made (#4349). Same module as selfcheck.bit (#1503), so `selfcheck()`
// reaches these through arm64selcheck.bit's own entry.
//
// Named to sort after compiler/arm64selcheckcmp.bit — module files concatenate
// in bytewise filename order (compiler/project.bit:7).
//
// WHY BYTE-EXACT AND NOT "IS IT SHORTER". Dropping the source extend when the
// source register is NOT width-canonical is a silent wrong answer, not a
// crash: the high bits the extend would have rewritten survive into a wider
// destination. The golden corpus cannot see it — every producer it exercises
// happens to be canonical — so these fixtures are the only thing standing
// between that mutation and a green suite. Each case below pins the exact
// instruction, so eliding one too many and eliding one too few both fail.

// The four cases `emitConvert`'s int->int arm distinguishes. `selCtx()` puts
// value N in vreg N in register xN, so `dst`=0 is x0 and `src`=1 is x1.
fn checkArm64ConvertSel() {
  let cx = selCtx()
  let tctx = cx.module.ctx
  let u8ty = primType(tctx, 4)
  let i8ty = primType(tctx, 0)
  let i32ty = primType(tctx, 2)
  let u32ty = primType(tctx, 6)
  let i64ty = primType(tctx, 3)

  // NARROWING NEEDS NO INVARIANT AT ALL. The destination extend reads only bits
  // below dw's width, which the source extend never touches, so it subsumes it
  // outright — one `uxtb`, not `mov` + `uxtb`. The source here is a block
  // param, deliberately NOT one of the canonical producers.
  cx.f.instrs[1] = mkInstr(Op.BlockParam, i64ty)
  emitConvert(cx, 0, 1, u8ty)
  let want = newByteBuf()
  extendRegA(want, 0, 1, 1, false) // uxtb x0, w1
  assertSameBytes(cx.code, want)

  // Same width, differing signedness is also a narrowing for this purpose:
  // canon(v,32,unsigned) then canon(.,32,signed) is canon(v,32,signed).
  cx = selCtx()
  cx.f.instrs[1] = mkInstr(Op.BlockParam, u32ty)
  emitConvert(cx, 0, 1, i32ty)
  want = newByteBuf()
  extendRegA(want, 0, 1, 4, true) // sxtw x0, w1
  assertSameBytes(cx.code, want)

  // WIDENING FROM A NARROW LOAD: `ldrb` already left x1 zero-extended across
  // all 64 bits, so only the destination extend remains — and at 8 bytes that
  // is the plain move into the destination register.
  cx = selCtx()
  cx.f.instrs[1] = mkInstr(Op.FieldGet, u8ty)
  emitConvert(cx, 0, 1, i64ty)
  want = newByteBuf()
  extendRegA(want, 0, 1, 8, true) // mov x0, x1
  assertSameBytes(cx.code, want)

  // index_get is the other canonical load, and a SIGNED one still counts:
  // `ldrsb` sign-extends to the full register exactly as `ldrb` zero-extends.
  cx = selCtx()
  cx.f.instrs[1] = mkInstr(Op.IndexGet, i8ty)
  emitConvert(cx, 0, 1, i64ty)
  want = newByteBuf()
  extendRegA(want, 0, 1, 8, true) // mov x0, x1
  assertSameBytes(cx.code, want)

  // WIDENING FROM ANYTHING ELSE KEEPS BOTH. A block param is where an `extern`
  // boundary's argument arrives, and neither AAPCS64 nor this backend
  // canonicalizes there — so the source extend is load-bearing and stays.
  cx = selCtx()
  cx.f.instrs[1] = mkInstr(Op.BlockParam, u8ty)
  emitConvert(cx, 0, 1, i64ty)
  want = newByteBuf()
  extendRegA(want, 0, 1, 1, false) // uxtb x0, w1
  extendRegA(want, 0, 0, 8, true)  // mov x0, x0 -- nothing
  assertSameBytes(cx.code, want)

  // A narrow load whose OWN type is 8 bytes wide (a fixed-size array field is
  // an interior address, a slice header word is a full word) can never reach
  // the widening arm, because there is nothing wider to widen to. Pinned here
  // so the "lw.bytes == sw.bytes only at 8" argument in srcIsWidthCanonical
  // stays true if widthOf ever changes.
  assert(!srcIsWidthCanonical(tctx, cx.f, 1, mkWidth(8, RegClass.Int, true)))
  cx.f.instrs[1] = mkInstr(Op.FieldGet, u8ty)
  assert(srcIsWidthCanonical(tctx, cx.f, 1, mkWidth(1, RegClass.Int, false)))
  // Signedness must match too: a u8 load is NOT canonical for a signed byte.
  assert(!srcIsWidthCanonical(tctx, cx.f, 1, mkWidth(1, RegClass.Int, true)))
  cx.f.instrs[1] = mkInstr(Op.Call, u8ty)
  assert(!srcIsWidthCanonical(tctx, cx.f, 1, mkWidth(1, RegClass.Int, false)))
}
