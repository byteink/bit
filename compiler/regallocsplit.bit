// Self-host Stage 3: interval SPLITTING for the linear-scan allocator (#7635,
// epic #7310), split out of compiler/regalloc.bit at the 800-line limit.
// Sibling .bit file, same module: see regalloc.bit for the allocator overview.
//
// Before this, an evicted interval went to its stack slot for its WHOLE life,
// so a value read early and evicted late paid a reload at every read, the
// early ones included, to free a register it was holding anyway. Now the
// eviction splits it at a block start `at` at or before the scan frontier: it
// keeps its register on [start, at) and lives in its slot on [at, end]
// (Wimmer & Franz 2010's split-at-a-block-boundary, in its simplest form).
//
// A split point is always a BLOCK START, so inside any block a value has one
// location and only a CFG edge can change it. `splitEdgeMoves` names the move
// each edge owes, and both backends append it to the edge's parallel move
// (blockArgMoves, xBlockArgMoves), so the jump-chain bypass and the branch
// shape see it exactly as they see a parameter move.
//
// SOUNDNESS of handing the register to nobody before `at`: every other
// interval is placed exactly as before. The evicted one held its register on
// [start, frontier) in the scan, so nothing else was given that register
// there, and `at <= frontier`. The slot is a FRESH one (`assignSpill` with
// reuse=false), so the edge store before `at` overwrites no other value.
//
// SCOPE (#7635): only Int, non-reference, non-heap-derived, non-remat values
// split. A reference's stack maps and #5847's slot clears still name one
// location for a whole life (#7636), which is why `assertNoRefSplit` exists.
//
// THE THIRD PIECE (#7665): after the scan, `placeTails` moves a split value
// back into a register `backReg` from a later block start `at2` to its end,
// so its reads after the competing call stop reloading (Wimmer & Franz's split
// child re-entering a register, decided after the scan rather than inside
// it). The register must be held by NOBODY on [lo2, end], `lo2` being the
// source of the one edge that loads it, so every other placement stands.

// The split of one interval: its register before `at`, `tail` from `at` on,
// and from `at2` on (when >= 0) the register `backReg`. `start`/`end` are its
// (alias-widened) interval, the positions an edge move may be owed at.
class SplitPiece {
  vreg: int,
  start: int,
  at: int,
  end: int,
  tail: RegLoc,
  at2: int = -1,
  lo2: int = -1,
  backReg: int = -1,
}

// One resolution move: `vreg` sits in `src` at an edge's source and must be
// in `dst` at its target.
class SplitMove {
  vreg: int,
  src: RegLoc,
  dst: RegLoc,
}

// #7634: the one read of `locations` outside this module. `pos` is the
// instruction position emitted or checked.
fn locAt(res: RegAllocResult, v: int, pos: int): RegLoc {
  if (v >= len(res.splitOf) || res.splitOf[v] < 0) {
    return res.locations[v]
  }
  return pieceLoc(res.splits[res.splitOf[v]], res.locations[v], pos)
}

fn pieceLoc(p: SplitPiece, head: RegLoc, pos: int): RegLoc {
  if (pos < p.at) {
    return head
  }
  if (p.at2 >= 0 && pos >= p.at2) {
    return RegLoc{ isSpill = false, index = p.backReg }
  }
  return p.tail
}

// A read with no instruction position (frame sizing, whole-function scans,
// allocator tests). For a split value it is the location before the split,
// which is the register a callee-saved scan must see as used; the tail's slot
// is counted by `numSpillSlots`.
fn locWhole(res: RegAllocResult, v: int): RegLoc {
  return res.locations[v]
}

// Overwrites `v`'s location; fixtures only.
fn setLoc(res: RegAllocResult, v: int, loc: RegLoc) {
  res.locations[v] = loc
}

fn splittable(iv: LiveInterval): bool {
  return iv.regClass == RegClass.Int && !iv.isRef && !iv.heapDerived && !iv.remat && !iv.folded
}

// The latest block start in (iv.start, frontier], or -1.
fn latestBlockStart(iv: LiveInterval, frontier: int, edges: []CfgEdge): int {
  let at = -1
  for e of edges {
    if (e.dstStart > iv.start && e.dstStart <= frontier && e.dstStart > at) {
      at = e.dstStart
    }
  }
  return at
}

// Where to split `iv`, evicted at `frontier`, or -1 to spill it whole.
//
// Refused when splitting could cost more than the whole-life spill, which
// pays one store at the definition and one reload per read. It must save at
// least two reads before `at`, and it is not defined in the entry block: there
// the prologue would zero the tail slot the entry block no longer writes
// (`entryWrittenSlots`), and x86-64 reads a spilled parameter from its
// argument register for free right after the binding (`xArgFwd`). A back edge
// crossing `at` inside the interval would reload on every lap, and more than
// one forward crossing edge would store more than once. With at most one
// store and no back-edge reload, the split is no worse, and every read before
// `at` stops reloading. A forward crossing edge never repeats inside a loop
// without a back edge that crosses too, so the bound holds per run.
fn splitPoint(iv: LiveInterval, frontier: int, edges: []CfgEdge): int {
  if (!splittable(iv)) {
    return -1
  }
  let at = latestBlockStart(iv, frontier, edges)
  if (at < 0 || iv.use2 < 0 || iv.use2 >= at || inEntryBlock(iv, edges)) {
    return -1
  }
  if (crossingStores(iv, at, edges) < 0) {
    return -1
  }
  return at
}

// Whether `iv` is defined before the first block any edge enters.
fn inEntryBlock(iv: LiveInterval, edges: []CfgEdge): bool {
  for e of edges {
    if (e.dstStart <= iv.start) {
      return false
    }
  }
  return true
}

// The edges inside `iv` that cross `at` forward, each owing one store; -1
// when a back edge crosses it or more than one forward edge does.
fn crossingStores(iv: LiveInterval, at: int, edges: []CfgEdge): int {
  let stores = 0
  for e of edges {
    if (!spans(iv.start, iv.end, e.srcLast, e.dstStart) || e.srcLast < at == (e.dstStart < at)) {
      continue
    }
    if (e.srcLast >= at || stores == 1) {
      return -1
    }
    stores = stores + 1
  }
  return stores
}

fn spans(start: int, end: int, from: int, to: int): bool {
  return from >= start && from <= end && to >= start && to <= end
}

// The split state `allocateCoalesced` threads through its scan: the result's
// `locations`, the CFG edges, and the pieces split so far.
class Splitter {
  locations: []RegLoc,
  edges: []CfgEdge,
  pieces: []SplitPiece,
}

// Places `iv`, evicted from `reg` at `frontier` into `slot`: split when
// `splitPoint` allows, else on the stack for its whole life. The assert is
// #7636's fence: a reference never reaches a split.
fn placeEvicted(sp: Splitter, iv: LiveInterval, reg: int, slot: int, frontier: int) {
  let at = splitPoint(iv, frontier, sp.edges)
  if (at < 0) {
    sp.locations[iv.vreg] = RegLoc{ isSpill = true, index = slot }
    return
  }
  assert(!iv.isRef && slot >= 0 && at > iv.start && at <= iv.end)
  sp.locations[iv.vreg] = RegLoc{ isSpill = false, index = reg }
  let tail = RegLoc{ isSpill = true, index = slot }
  sp.pieces = append(
    sp.pieces,
    SplitPiece{ vreg = iv.vreg, start = iv.start, at = at, end = iv.end, tail = tail },
  )
}

// Per vreg, the index of its SplitPiece or -1. An alias takes its root's,
// exactly as it takes its root's location (`propagateAliasLocations`).
fn splitIndex(n: int, splits: []SplitPiece, roots: []int): []int {
  let out = []int(0)
  let v = 0
  while (v < n) {
    out = append(out, -1)
    v = v + 1
  }
  let k = 0
  while (k < len(splits)) {
    out[splits[k].vreg] = k
    k = k + 1
  }
  v = 0
  while (v < n && len(roots) > 0) {
    if (roots[v] != v) {
      out[v] = out[roots[v]]
    }
    v = v + 1
  }
  return out
}

// The moves a CFG edge from position `from` (its source's last instruction)
// to `to` (its target's first) owes split values. A value whose interval does
// not contain both ends is not live across the edge and owes nothing.
fn splitEdgeMoves(res: RegAllocResult, from: int, to: int): []SplitMove {
  let out = []SplitMove(0)
  for p of res.splits {
    let src = locAt(res, p.vreg, from)
    let dst = locAt(res, p.vreg, to)
    if (!spans(p.start, p.end, from, to) ||
      (src.isSpill == dst.isSpill && src.index == dst.index)) {
      continue
    }
    out = append(out, SplitMove{ vreg = p.vreg, src = src, dst = dst })
  }
  return out
}

// What `placeTails` reads besides the Splitter: the merged intervals, the copy
// roots, the points and register file that restrict a register, and per vreg
// its piece's index (`splitIndex`), renewed as pieces are added.
class TailScan {
  scan: []LiveInterval,
  roots: []int,
  points: AllocPoints,
  target: TargetRegs,
  splitOf: []int,
}

// Gives each split piece its third piece where one pays: the earliest block
// start `at2` after `at` that still has two distinct reads at or after it,
// entered by exactly one edge, from the slot region, and by no back edge, so
// the tail costs at most one load and saves at least two reloads.
//
// A value spilled WHOLE gets the same chance as a piece whose head is its own
// slot (`at` = its start): it is not moved before `at2`, so the store at its
// definition stands and the one load is the only cost.
fn placeTails(sp: Splitter, ts: TailScan) {
  let n0 = len(sp.pieces)
  let k = 0
  while (k < n0) {
    ts.splitOf = splitIndex(len(sp.locations), sp.pieces, ts.roots)
    placeTail(sp, ts, k, tailIv(ts, sp.pieces[k].vreg).last2)
    k = k + 1
  }
  for iv of ts.scan {
    if (spilledWhole(sp, ts, iv)) {
      tryWholeTail(sp, ts, iv)
    }
  }
}

fn spilledWhole(sp: Splitter, ts: TailScan, iv: LiveInterval): bool {
  let loc = sp.locations[iv.vreg]
  let root = len(ts.roots) == 0 || ts.roots[iv.vreg] == iv.vreg
  return root && splittable(iv) && loc.isSpill && loc.index >= 0
}

fn tryWholeTail(sp: Splitter, ts: TailScan, iv: LiveInterval) {
  let loc = sp.locations[iv.vreg]
  sp.pieces = append(
    sp.pieces,
    SplitPiece{ vreg = iv.vreg, start = iv.start, at = iv.start, end = iv.end, tail = loc },
  )
  let k = len(sp.pieces) - 1
  ts.splitOf = splitIndex(len(sp.locations), sp.pieces, ts.roots)
  placeTail(sp, ts, k, iv.last2)
  if (sp.pieces[k].at2 < 0) {
    sp.pieces = sp.pieces[0:k]
  }
}

fn tailIv(ts: TailScan, v: int): LiveInterval {
  for iv of ts.scan {
    if (iv.vreg == v) {
      return iv
    }
  }
  assert(false, "#7665: a split piece names no interval")
  return ts.scan[0]
}

fn placeTail(sp: Splitter, ts: TailScan, k: int, last2: int) {
  let p = sp.pieces[k]
  let b = nextBlockStart(sp.edges, p.at, p.end)
  while (b >= 0 && b <= last2) {
    sp.pieces[k].lo2 = tailEntry(p, b, sp.edges)
    let r = -1
    if (sp.pieces[k].lo2 >= 0) {
      r = tailReg(sp, ts, k, b)
    }
    if (r >= 0) {
      sp.pieces[k].at2 = b
      sp.pieces[k].backReg = r
      return
    }
    b = nextBlockStart(sp.edges, b, p.end)
  }
  sp.pieces[k].lo2 = -1
}

// The smallest block start in (after, end], or -1.
fn nextBlockStart(edges: []CfgEdge, after: int, end: int): int {
  let b = -1
  for e of edges {
    if (e.dstStart > after && e.dstStart <= end && (b < 0 || e.dstStart < b)) {
      b = e.dstStart
    }
  }
  return b
}

// The source position of the one edge inside `p` that enters `b` from the
// slot region [at, b), or -1 when a back edge crosses `b`, another forward
// edge does, or none does.
fn tailEntry(p: SplitPiece, b: int, edges: []CfgEdge): int {
  let lo = -1
  for e of edges {
    if (!spans(p.start, p.end, e.srcLast, e.dstStart) || e.srcLast < b == (e.dstStart < b)) {
      continue
    }
    if (e.srcLast >= b || e.srcLast < p.at || lo >= 0) {
      return -1
    }
    lo = e.srcLast
  }
  return lo
}

// A register nobody holds on [lo2, end] that the tail's points allow, the
// head register first; a callee-saved register no value uses yet is refused,
// since the prologue would pay to save it. -1 when there is none.
fn tailReg(sp: Splitter, ts: TailScan, k: int, b: int): int {
  let p = sp.pieces[k]
  let file = ts.target.intRegs
  let probe = LiveInterval{
    vreg = p.vreg,
    regClass = RegClass.Int,
    start = b - 1,
    end = p.end,
    isRef = false,
  }
  let mask = fullRegMask(file.count) & intervalRegMask(probe, ts.points, ts.target)
  let head = sp.locations[p.vreg]
  if (!head.isSpill && tailRegFits(sp, ts, mask, head.index, k)) {
    return head.index
  }
  let r = 0
  while (r < file.count) {
    if (tailRegFits(sp, ts, mask, r, k)) {
      return r
    }
    r = r + 1
  }
  return -1
}

fn tailRegFits(sp: Splitter, ts: TailScan, mask: int, r: int, k: int): bool {
  let saved = ((ts.target.intRegs.calleeSaved >> r) & 1) == 1
  return ((mask >> r) & 1) == 1 && (!saved || regUsed(sp, ts, r)) && !regTaken(sp, ts, k, r)
}

fn regUsed(sp: Splitter, ts: TailScan, r: int): bool {
  for iv of ts.scan {
    let loc = sp.locations[iv.vreg]
    if (iv.regClass == RegClass.Int && !loc.isSpill && loc.index == r) {
      return true
    }
  }
  return false
}

// Whether any Int value other than piece `k`'s holds `r` somewhere in
// [lo, pieces[k].end].
fn regTaken(sp: Splitter, ts: TailScan, k: int, r: int): bool {
  for iv of ts.scan {
    let q = ts.splitOf[iv.vreg]
    if (iv.regClass == RegClass.Int &&
      q != k &&
      holdsReg(sp, iv, q, r, RegWindow{ lo = sp.pieces[k].lo2, hi = sp.pieces[k].end })) {
      return true
    }
  }
  return false
}

class RegWindow {
  lo: int,
  hi: int,
}

// Whether `iv` (piece `q`, or -1) holds `r` somewhere in `w`: its head up to
// `at` when split, its tail register from `lo2` on, else its whole interval.
fn holdsReg(sp: Splitter, iv: LiveInterval, q: int, r: int, w: RegWindow): bool {
  let loc = sp.locations[iv.vreg]
  let end = iv.end
  if (q >= 0) {
    let p = sp.pieces[q]
    if (p.backReg == r && p.lo2 <= w.hi && p.end >= w.lo) {
      return true
    }
    end = p.at
  }
  return !loc.isSpill && loc.index == r && iv.start <= w.hi && end >= w.lo
}

// Places the tails, then builds the stack maps the tails' registers reach.
fn tailedStackMaps(
  sp: Splitter, scan: []LiveInterval, roots: []int, points: AllocPoints, target: TargetRegs,
): []StackMapEntry {
  let ts = TailScan{
    scan = scan,
    roots = roots,
    points = points,
    target = target,
    splitOf = []int(0),
  }
  placeTails(sp, ts)
  let maps = buildStackMaps(ts.scan, sp.locations, ts.points)
  notePollTails(maps, sp.pieces)
  return maps
}

// An alias's reads are its root's: they share one location (`widenRoot`).
fn mergeLastReads(root: LiveInterval, alias: LiveInterval) {
  noteLastRead(root, alias.last1)
  noteLastRead(root, alias.last2)
}

// #7303: a poll inside a tail must keep the tail's register in its live mask.
// The head register stays there too: over-reporting only saves a register.
fn notePollTails(stackMaps: []StackMapEntry, pieces: []SplitPiece) {
  for sm of stackMaps {
    for p of pieces {
      if (sm.isPoll && p.at2 >= 0 && sm.pos >= p.at2 && sm.pos <= p.end) {
        sm.live = sm.live | (1 << p.backReg)
      }
    }
  }
}

// Marks every tail register in `used`, the backends' callee-saved scans: a
// tail register may be one no other value holds.
fn markTailRegs(res: RegAllocResult, used: []bool) {
  for p of res.splits {
    if (p.at2 >= 0) {
      used[p.backReg] = true
    }
  }
}
