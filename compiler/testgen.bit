// Test-entry generation for `bit2 test` (#1105) — a direct port.
//
// A test is a top-level `function test_<name>()` in the ROOT module: no
// parameters, no result, not fallible (SPEC §19). Discovery scans the LOWERED
// module rather than the source, because lowering has resolved names — a root
// function keeps its bare name while an imported one is module-qualified
// (`m<id>$…`), so a bare `test_` prefix names exactly the root module's tests and
// never a stdlib helper's, and never a generic/method instance (those carry `$`).
//
// A second convention, `testpanic_<name>` (SPEC §18.4, #2839), is discovered
// alongside `test_` under the same signature rule and run the same way — one
// child process per test — but its verdict is INVERTED by the runner
// (testrun.bit, same module): it passes when the child dies by a panic and
// fails when it returns normally. `testPrefix`/`testPanicPrefix` below are
// the single place both this file's discovery and testrun.bit's verdict read
// the prefix from, so the two stay in lockstep.
//
// The runner needs one process per test (a failed `assert` panics and takes the
// process with it), so instead of looping in-process we synthesize a `main` that
// asks the runtime which single test to run and dispatches to it:
//
//     main() {
//       i = test_index()            // BIT_TEST_INDEX, or -1
//       if i == 0 { test_a() }
//       else if i == 1 { test_b() }
//       ...
//       return
//     }
//
// `bit2 test` execs the produced binary once per test with BIT_TEST_INDEX set. An
// out-of-range (or unset, -1) index falls through every check and returns
// cleanly, so running a test binary by hand is a harmless no-op.

const testPrefix = "test_"
const testPanicPrefix = "testpanic_"

// Whether the IR function name contains a `$` (a generic instance or a method —
// never a plain test).
fn nameHasDollar(n: string): bool {
  let i = 0
  while (i < len(n)) {
    if (n[i:i + 1] == "$") {
      return true
    }
    i = i + 1
  }
  return false
}

fn hasStrPrefix(n: string, prefix: string): bool {
  return len(n) >= len(prefix) && n[0:len(prefix)] == prefix
}

// Whether `n` is a `testpanic_`-named candidate. Exported to testrun.bit
// (same module, compiler/ has no subdirectories) so the verdict-inversion
// check reads the identical prefix discovery matched on, rather than a
// second copy of the string literal.
fn isTestPanicName(n: string): bool {
  return hasStrPrefix(n, testPanicPrefix)
}

// Whether `n` carries either test-name convention. "testpanic_" does not
// begin with "test_" — its 5th byte is 'p', not '_' — so the two candidate
// sets never overlap and neither prefix can shadow the other.
fn isTestName(n: string): bool {
  return hasStrPrefix(n, testPrefix) || isTestPanicName(n)
}

// The runtime's own panic exit status (SPEC §18.4, ABI.md §12: `bit_rt_panic`
// prints `panic: <msg>` and exits 2). Named here rather than inlined as a
// literal `2` because `testVerdictPassed` below reads it beside `osRunTest`'s
// two OTHER non-zero outcomes (spawn failure, timeout) that must NOT count as
// a panic.
const testPanicExitCode = 2

// Whether test `name`'s child, which exited with `code`, PASSED. A `test_`
// function passes on a clean exit (0), unchanged from before #2839. A
// `testpanic_` function INVERTS that: it passes only when the child died by
// exactly the runtime's panic exit code, never on any other non-zero code —
// `osRunTest`/`osRunTestBounded` return -1 on a spawn failure and -2 on a
// timeout (ABI.md §19), and a `testpanic_` function must not "pass" because
// its process never even ran, nor because it crashed some OTHER way (a
// segfault, an explicit `exit(1)`) that is not the panic this convention
// asserts. This is the one place both `runModuleTests` (testrun.bit) and the
// self-check (testgencheck.bit) read the verdict rule from, so a discovery
// change here cannot drift from the verdict.
fn testVerdictPassed(name: string, code: int): bool {
  if (isTestPanicName(name)) {
    return code == testPanicExitCode
  }
  return code == 0
}

// Whether `f` is a root-module test declaration: `test_` or `testpanic_`,
// same signature rule for both (§19, §18.4).
fn isTestFunc(f: IrFunc, voidId: int): bool {
  let n = f.name
  if (!isTestName(n)) {
    return false
  }
  if (nameHasDollar(n)) {
    return false
  }
  return len(f.paramTypes) == 0 && f.result == voidId && !f.isFallible
}

// Test discovery's answer to `--run`: every top-level test found
// (`discovered`, dispatch order, unchanged from before #2834) and the subset
// the `--run` substring narrowed to (`names` — what the synthetic `main`'s
// BIT_TEST_INDEX dispatch actually runs). They are the same slice when
// `runPattern` is "" (not given). `testrun.bit`'s `runModuleTests` reads both
// so a filtered run can report what it discovered separately from what it
// ran, rather than folding to one count.
class TestDiscovery {
  discovered: []string,
  names: []string,
}

// Keeps only the names that CONTAIN `pattern` as a literal substring — plain
// string search, no glob, no regex (std/regex does not exist yet). An empty
// `pattern` returns `names` unchanged: the entire `--run`-not-given case.
fn filterTestNames(names: []string, pattern: string): []string {
  if (len(pattern) == 0) {
    return names
  }
  let out = []string(0)
  for n of names {
    if (contains(n, pattern)) {
      out = append(out, n)
    }
  }
  return out
}

// Discovers the root module's tests, narrows them by the `--run` substring,
// and appends a synthetic `main` dispatching to the SURVIVORS by
// BIT_TEST_INDEX. Any pre-existing `main` is renamed (a test module is not a
// program), so exactly one `main` reaches the object writer. A non-empty
// `runPattern` that matches nothing skips all of that: no rename, no
// dispatch `main` generated at all — `names` comes back empty while
// `discovered` does not, which is how the caller (testrun.bit) tells "no
// tests in this module" (both empty, pattern absent) apart from "a pattern
// was given and matched nothing" (only `names` empty) and turns the latter
// into `bit test: no test matched --run <pattern>` on stderr, exit 1,
// without ever building an executable.
fn injectTestMain(module: IrModule, runPattern: string): TestDiscovery {
  let voidId = module.ctx.voidId
  let discovered = []string(0)
  let i = 0
  while (i < len(module.funcs)) {
    if (isTestFunc(module.funcs[i], voidId)) {
      discovered = append(discovered, module.funcs[i].name)
    }
    i = i + 1
  }
  let names = filterTestNames(discovered, runPattern)
  if (len(runPattern) > 0 && len(names) == 0) {
    return TestDiscovery{ discovered: discovered, names: names }
  }
  // A test module's own `main`, if any, is not the entry: rename it so the
  // synthetic one below is the only `main` symbol. It stays an unreferenced
  // function and the linker's dead-strip drops it. Rebuild the slice rather than
  // mutate an element in place (Bit slice elements are values).
  let rebuilt = []IrFunc(0)
  let renamed = false
  let j = 0
  while (j < len(module.funcs)) {
    let f = module.funcs[j]
    if (!renamed && f.name == "main") {
      renamed = true
      // Only the NAME changes; every other field must survive verbatim. An
      // omitted field zero-fills, so the decl-only flags have to be listed
      // explicitly — dropping them here would quietly strip @naked/@nosplit
      // (and, since §17.6, the module tag) from a renamed `main`.
      rebuilt = append(rebuilt, IrFunc{ name: "__bit_module_main", paramTypes: f.paramTypes,
        result: f.result, blocks: f.blocks, instrs: f.instrs, isFallible: f.isFallible,
        isNaked: f.isNaked, isNosplit: f.isNosplit, inRootModule: f.inRootModule,
        isPinned: f.isPinned })
    } else {
      rebuilt = append(rebuilt, f)
    }
    j = j + 1
  }
  module.funcs = append(rebuilt, buildDispatch(module.ctx, names))
  return TestDiscovery{ discovered: discovered, names: names }
}

// Builds `main`: read the wanted index once, then walk a linear chain of equality
// checks. `idx` is defined in the entry block, which dominates every check block,
// so no block parameters are needed to thread it through (SSA value ids are flat
// across blocks).
fn buildDispatch(ctx: TypeContext, tests: []string): IrFunc {
  let i64ty = primType(ctx, 3)
  let boolty = primType(ctx, 10)
  let voidty = ctx.voidId
  let b = newBuilder()
  let entry = builderNewBlock(b)

  if (len(tests) == 0) {
    builderBeginBlock(b, entry)
    let r = mkInstr(Op.Ret, voidty)
    r.args = []int(0)
    builderEmit(b, r)
    builderEndBlock(b)
    return IrFunc{ name: "main", paramTypes: []int(0), result: voidty,
      blocks: b.blocks, instrs: b.instrs, isFallible: false, inRootModule: true }
  }

  // One call block per test plus a shared `done`; `check` blocks for i >= 1 (the
  // first check lives in the entry block, after the runtime call).
  let callBlocks = []int(0)
  let ci = 0
  while (ci < len(tests)) {
    callBlocks = append(callBlocks, builderNewBlock(b))
    ci = ci + 1
  }
  let checkBlocks = []int(0)
  checkBlocks = append(checkBlocks, entry) // test 0's check is the entry block
  let cj = 1
  while (cj < len(tests)) {
    checkBlocks = append(checkBlocks, builderNewBlock(b))
    cj = cj + 1
  }
  let done = builderNewBlock(b)

  // entry: idx = test_index(); if idx == 0 -> call_0 else -> check_1 (or done)
  builderBeginBlock(b, entry)
  let rt = mkInstr(Op.RtCall, i64ty)
  rt.name = "test_index"
  rt.args = []int(0)
  let idx = builderEmit(b, rt)
  emitDispatchCheck(b, i64ty, boolty, voidty, idx, 0, callBlocks[0],
    checkOrDone(checkBlocks, done, 1, len(tests)))
  builderEndBlock(b)

  let k = 1
  while (k < len(tests)) {
    builderBeginBlock(b, checkBlocks[k])
    emitDispatchCheck(b, i64ty, boolty, voidty, idx, k, callBlocks[k],
      checkOrDone(checkBlocks, done, k + 1, len(tests)))
    builderEndBlock(b)
    k = k + 1
  }

  let m = 0
  while (m < len(tests)) {
    builderBeginBlock(b, callBlocks[m])
    let call = mkInstr(Op.Call, voidty)
    call.name = tests[m]
    call.args = []int(0)
    builderEmit(b, call)
    let jmp = mkInstr(Op.Jump, voidty)
    jmp.ival = done
    jmp.args = []int(0)
    builderEmit(b, jmp)
    builderEndBlock(b)
    m = m + 1
  }

  builderBeginBlock(b, done)
  let r = mkInstr(Op.Ret, voidty)
  r.args = []int(0)
  builderEmit(b, r)
  builderEndBlock(b)

  return IrFunc{ name: "main", paramTypes: []int(0), result: voidty,
    // §17.6: the synthesized entry belongs to the module being built.
    blocks: b.blocks, instrs: b.instrs, isFallible: false, inRootModule: true }
}

// The next check block for index `next`, or `done` when it is the last test.
fn checkOrDone(checkBlocks: []int, done: int, next: int, total: int): int {
  if (next < total) {
    return checkBlocks[next]
  }
  return done
}

// Emits `if idx == k -> callBlk else -> elseBlk` at the end of the current block.
fn emitDispatchCheck(b: IrBuilder, i64ty: int, boolty: int, voidty: int, idx: int, k: int, callBlk: int, elseBlk: int) {
  let kc = mkInstr(Op.ConstInt, i64ty)
  kc.ival = k
  let kv = builderEmit(b, kc)
  let eq = mkInstr(Op.ICmpEq, boolty)
  eq.lhs = idx
  eq.rhs = kv
  let ev = builderEmit(b, eq)
  let br = mkInstr(Op.Br, voidty)
  br.lhs = ev
  br.ival = callBlk
  br.thenArgs = []int(0)
  br.ival2 = elseBlk
  br.elseArgs = []int(0)
  builderEmit(b, br)
}

// `bit test`'s own answer to E0096 (#2958, #2985). `bit test <pkg>` compiles
// `pkg` AS ROOT — that is what makes its own bare-named `test_*` functions
// discoverable above (§19, "never in an imported one") — so a top-level name
// that collides with a linked extern is exactly as real a hazard here as it
// is for `bit build`/`bit run`: the root keeps bare link names, so a root
// `fn listen` would ALSO define the bare symbol the runtime's own `extern fn
// listen` resolves against (build.bit's `rejectRootNameCollision` doc). Four
// stdlib packages have such a name on their own public surface (`net`/`tls`'s
// `listen`, `http2`'s `connect`/`accept`, `fs`'s `open`/`mkdir`), so simply
// running `rejectRootNameCollision` here would make `bit test` permanently
// unbuildable on exactly the packages most worth testing.
//
// Renaming the stdlib API is a breaking public change to work around a
// build-mode artefact, and exempting `bit test` from the check re-admits the
// miscompile in the one configuration nobody would notice a test silently
// calling the runtime's function instead of the package's. So `bit test`
// does neither: `buildIr` (build.bit) still runs the same collision scan
// (`collidingRootDecls`) it always has, and hands the result here instead of
// reporting it. This renames each colliding declaration to a spelling no
// extern can ever have — every extern name is `[a-z_][A-Za-z0-9_]*`
// (build.bit's own derivation from the linked archive), so a name containing
// '$' is categorically outside that alphabet, the exact property that
// already makes `modulePrefix`'s `m<id>$` mangling safe — and repoints every
// reference to it: the declaration itself, every `Call`/`FuncAddr` (a direct
// call, `entryOf()`, or a function-value trampoline: IrInstr's `name` field
// covers all three, per ir.bit's own field comment) anywhere in the lowered
// module, and any global whose initializer captured its address
// (`IrGlobalReloc.symbol`). A method can never be in `names`
// (`collidingRootDecls` excludes a receiver'd decl: its emitted name always
// carries `$t<recvType>`, never a bare extern spelling), so the method
// tables need no walk.
//
// Called from `buildIr` AFTER `lowerProject`, so every reference already
// carries its real, final link name — this is the one pass that can rename
// all of them consistently in a single, local pass over the already-flat
// `IrModule`, with no change to how any OTHER build computes a link name.
fn demangleTestRootCollisions(module: IrModule, names: []string) {
  if (len(names) == 0) {
    return
  }
  let to = map<string, string>{}
  for n of names {
    to[n] = "testroot\$${n}"
  }
  let fi = 0
  while (fi < len(module.funcs)) {
    let (fname, fhit) = to[module.funcs[fi].name]
    if (fhit) {
      module.funcs[fi].name = fname
    }
    let ii = 0
    while (ii < len(module.funcs[fi].instrs)) {
      let (iname, ihit) = to[module.funcs[fi].instrs[ii].name]
      if (ihit) {
        module.funcs[fi].instrs[ii].name = iname
      }
      ii = ii + 1
    }
    fi = fi + 1
  }
  let gi = 0
  while (gi < len(module.globals)) {
    let ri = 0
    while (ri < len(module.globals[gi].relocs)) {
      let (rname, rhit) = to[module.globals[gi].relocs[ri].symbol]
      if (rhit) {
        module.globals[gi].relocs[ri].symbol = rname
      }
      ri = ri + 1
    }
    gi = gi + 1
  }
}
