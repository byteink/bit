// compiler/pmfetchtail.bit — the subprocess plumbing compiler/pmfetch.bit's
// git-fetch and vanity-resolution functions run on top of (#2473, split off
// compiler/pmfetch.bit under the 800-line limit): `runGit` and its three
// private helpers (`scratchBase`, `removeQuiet`, `shQuote`). Named
// `pmfetchtail` rather than something shorter because it sorts bytewise
// after `compiler/pmfetch.bit` AND `compiler/pmfetchcheck.bit` (`t` > `c` at
// the first differing byte) — `pmfetchcheck.bit` reads `pmfetch.bit`'s
// `defaultGitBin` and `pmfetchresolvevanity.bit`'s `vanityMaxDocBytes` consts, so
// this file holds no top-level const of its own, only functions, so its sort
// position can never turn one of those reads into a forward-const reference
// (which types `.invalid` and silently miscompiles). `runGit` is called forward from
// several functions still in `pmfetch.bit` and from `pmfetchcheck.bit`
// itself; a forward reference to a function is fine, only consts are not.

// --- subprocess plumbing --------------------------------------------------

import { output as processOutput } from "std/process"

// Capture git's combined streams to disk so the process module's per-stream
// memory cap cannot truncate a fetch result. Its native deadline owns and
// reaps the child; a shell watchdog cannot safely retain a PID across wait.
// Run through /bin/sh to avoid the first-execution scan on a fresh script.
fn runGit(gitBin: string, args: []string, timeoutMs: int): GitRun! {
  let base = scratchBase()
  let scriptPath = base + ".sh"
  let outPath = base + ".out"
  defer removeQuiet(scriptPath)
  defer removeQuiet(outPath)

  let timeoutSecs = timeoutMs / 1000
  if (timeoutSecs < 1) {
    timeoutSecs = 1
  }

  let cmd = shQuote(gitBin)
  let i = 0
  while (i < len(args)) {
    cmd = cmd + " " + shQuote(args[i])
    i = i + 1
  }

  let script = "#!/bin/sh\n" + cmd + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(scriptPath, script)?
  let run = processOutput("/bin/sh", [scriptPath], timeoutSecs * 1000)
  if (run.truncated) {
    fail newError("pmfetch: git wrapper output exceeded the process capture limit")
  }
  print(run.stdout)
  eprint(run.stderr)
  let code = run.exitCode

  let output = readFile(outPath) catch _ {
    ""
  }
  if (code == -2 || code == 124) {
    return GitRun{ exitCode = -1, timedOut = true, output = output }
  }
  if (code < 0) {
    fail newError("pmfetch: cannot launch git wrapper script: ${scriptPath}")
  }
  return GitRun{ exitCode = code, timedOut = false, output = output }
}

fn scratchBase(): string {
  return envOr("TMPDIR", "/tmp") + "/bitpm-" + uuidFormat(uuidV4())
}

fn removeQuiet(path: string) {
  remove(path) catch _ {
    return
  }
}

// Wraps `s` in single quotes for safe use as one POSIX `/bin/sh` argument
// word: every embedded `'` becomes `'\''` (close the quote, an escaped literal
// quote, reopen the quote), the standard POSIX-shell escaping technique.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\'') {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}
