// bit lsp — a nested `DocumentSymbol` tree for textDocument/documentSymbol
// (#2333). Split out of lspquery.bit (#1547) to keep that file under its
// target size; sibling `.bit` files in `compiler/` are the same module, so
// nothing here needs an import and lspquery.bit needs none to call it.
//
// THE BUG THIS EXISTS TO FIX: the old handler emitted one flat
// `SymbolInformation` per top-level decl. A method
// (`function (t: Task) label() {...}`) is a top-level decl by grammar, so it
// rendered indistinguishable from a free function, and a class's fields
// never rendered at all. This file groups a class's fields and its methods
// as `children` of the class instead.
//
// DELIBERATELY TREE-ONLY, NOT CHECKER-DEPENDENT: `documentSymbol` answers
// even on a file with a syntax error, returning whatever the parser's error
// recovery could still produce (a property this file must not regress — see
// the ticket's "Not in scope" note). So a method's receiver type and a
// field's type are read as literal SOURCE TEXT off the tree (`typeNodeName`,
// a raw source slice) rather than through `ctx.structFields`/`methodSigs`,
// which only the checker (not the resolver alone) populates and which may be
// empty on such a file. Grouping matches a method to its class by NAME TEXT
// for the same reason — not `userTypeLookup`, which needs the checker's
// `userTypes` table.

// A `Range` object (no `uri` — unlike a Location, a DocumentSymbol's range is
// implicitly within the requested document).
fn lspSpanRangeJson(p: Project, span: Span): string {
  let m = p.mods[p.root]
  let fl = fileOf(m.fileStarts, span.start)
  let src = fileSource(p.sm, m.files[fl.fileIdx])
  let start = fl.offset
  let end = fl.offset + (span.end - span.start)
  return lspRangeJson(lspSpanToRange(src, start, end))
}

// `declNode`/`nameNode` together identify one `DocumentSymbol`: `declNode`'s
// own span is `range` (the whole declaration, matching what an editor
// highlights/folds); `nameNode`'s is `selectionRange` (what the outline
// actually points the cursor at).
class LspSymRef {
  declNode: int,
  nameNode: int,
}

// One `DocumentSymbol` JSON entry. `detail` is omitted from the JSON when
// empty — every real detail string this file produces (a field's declared
// type, read as source text) is non-empty, so an empty string unambiguously
// means "no detail" and needs no separate flag. "" for the blank `_` binder
// — callers must check before using the result.
fn lspDocSymEntry(
  p: Project,
  ref: LspSymRef,
  kind: int,
  detail: string,
  children: []string,
): string {
  let m = p.mods[p.root]
  let nameSp = getNode(m.tree, ref.nameNode).span
  let name = m.source[nameSp.start:nameSp.end]
  if (name == "_") {
    return ""
  }
  let s = "{\"name\":" + jsonEncodeString(name) + ",\"kind\":${kind}"
  if (detail != "") {
    s = s + ",\"detail\":" + jsonEncodeString(detail)
  }
  s = s +
    ",\"range\":" +
    lspSpanRangeJson(p, getNode(m.tree, ref.declNode).span) +
    ",\"selectionRange\":" +
    lspSpanRangeJson(p, nameSp)
  if (len(children) > 0) {
    s = s + ",\"children\":[" + lspJoinComma(children) + "]"
  }
  return s + "}"
}

// A binding pattern's leaf entries: a bare identifier, or every element of a
// tuple pattern (a destructuring `let (a, b) = ...`) — mirrors the flat
// form's own pattern walk, now emitting `DocumentSymbol`s.
fn lspDocSymPattern(p: Project, tree: Tree, pat: int, kind: int, items: []string): []string {
  if (pat == 0) {
    return items
  }
  if (getNode(tree, pat).tag == Tag.TuplePat) {
    let out = items
    for sub of kidsOf(tree, pat) {
      out = lspDocSymPattern(p, tree, sub, kind, out)
    }
    return out
  }
  let entry = lspDocSymEntry(p, LspSymRef{ declNode = pat, nameNode = pat }, kind, "", []string(0))
  if (entry == "") {
    return items
  }
  // bit:lint allow E0214 -- items is the caller's document-symbol accumulator, seeded fresh from []string(0); every caller (including this function's own recursion) reassigns it from the return value
  return append(items, entry)
}

// The `DocumentSymbol` children for class `declNode`'s own fields: one
// `Field` (kind 8) per member, `detail` the field's declared type as literal
// source text. Mirrors `checkbinddecl.bit`'s `resolveStructFields` traversal
// (kid 2 of a StructDecl is its field list) without touching the checker.
fn lspStructFieldSymbols(p: Project, tree: Tree, source: string, declNode: int): []string {
  let items = []string(0)
  let fields = kidsOf(tree, kidsOf(tree, declNode)[2])
  let fi = 0
  while (fi < len(fields)) {
    let fld = fields[fi]
    fi = fi + 1
    if (fld == 0) {
      continue
    }
    let fieldDecl = fld
    if (getNode(tree, fld).tag == Tag.Export) {
      fld = kidsOf(tree, fld)[0]
    }
    let fk = kidsOf(tree, fld) // [name, type]
    let tySp = getNode(tree, fk[1]).span
    let entry = lspDocSymEntry(
      p,
      LspSymRef{ declNode = fieldDecl, nameNode = fk[0] },
      8,
      source[tySp.start:tySp.end],
      []string(0),
    )
    if (entry != "") {
      items = append(items, entry)
    }
  }
  return items
}

// The read-only request context every lspDocumentSymbolTree helper shares —
// bundled so no helper needs more than 3 of its own params. One allocation
// per `textDocument/documentSymbol` request, not per decl.
class LspDocSymCtx {
  p: Project,
  m: SrcModule,
  c: Checker,
  tree: Tree,
  source: string,
  decls: []int,
  fileIdx: int,
}

// Bundles pass 1's output: each class's `children` bucket (its own fields,
// plus any method matched to it by receiver name text in pass 1b) and which
// names in this file are actually classes, so pass 2 can tell a grouped
// method from one that belongs at the top level.
class LspDocSymChildren {
  childrenOf: map<string, []string>,
  hasStruct: map<string, bool>,
}

// Pass 1a: every class's field list, keyed by the class's own name text.
fn lspDocSymCollectStructs(ctx: LspDocSymCtx): LspDocSymChildren {
  let childrenOf = map<string, []string>{}
  let hasStruct = map<string, bool>{}
  let di = 0
  while (di < len(ctx.decls)) {
    let node = ctx.decls[di]
    di = di + 1
    if (node == 0) {
      continue
    }
    if (fileOf(ctx.m.fileStarts, getNode(ctx.tree, node).span.start).fileIdx != ctx.fileIdx) {
      continue
    }
    let unwrapped = node
    if (getNode(ctx.tree, unwrapped).tag == Tag.Export) {
      unwrapped = kidsOf(ctx.tree, unwrapped)[0]
    }
    if (unwrapped == 0 || getNode(ctx.tree, unwrapped).tag != Tag.StructDecl) {
      continue
    }
    let k = kidsOf(ctx.tree, unwrapped)
    let nameSp = getNode(ctx.tree, k[0]).span
    let name = ctx.source[nameSp.start:nameSp.end]
    hasStruct[name] = true
    childrenOf[name] = lspStructFieldSymbols(ctx.p, ctx.tree, ctx.source, unwrapped)
  }
  return LspDocSymChildren{ childrenOf = childrenOf, hasStruct = hasStruct }
}

// Pass 1b: every method, appended to its receiver's bucket by NAME TEXT —
// `typeNodeName` handles a generic receiver's base name the same way
// `checkbindfunc.bit`'s `buildSignatures` does. A receiver with no matching
// class in this file is left alone; pass 2 emits it at the top level.
fn lspDocSymCollectMethods(
  ctx: LspDocSymCtx,
  childrenOf: map<string, []string>,
): map<string, []string> {
  let di = 0
  while (di < len(ctx.decls)) {
    let node = ctx.decls[di]
    di = di + 1
    if (node == 0) {
      continue
    }
    if (fileOf(ctx.m.fileStarts, getNode(ctx.tree, node).span.start).fileIdx != ctx.fileIdx) {
      continue
    }
    let unwrapped = node
    if (getNode(ctx.tree, unwrapped).tag == Tag.Export) {
      unwrapped = kidsOf(ctx.tree, unwrapped)[0]
    }
    if (unwrapped == 0 || getNode(ctx.tree, unwrapped).tag != Tag.FuncDecl) {
      continue
    }
    let k = kidsOf(ctx.tree, unwrapped)
    if (k[0] == 0) {
      continue // a free function: handled in pass 2
    }
    let recvName = typeNodeName(ctx.c, kidsOf(ctx.tree, k[0])[1])
    let entry = lspDocSymEntry(
      ctx.p,
      LspSymRef{ declNode = unwrapped, nameNode = k[1] },
      6,
      "",
      []string(0),
    )
    if (entry == "") {
      continue
    }
    let (cur, ok) = childrenOf[recvName]
    if (ok) {
      childrenOf[recvName] = append(cur, entry)
    }
  }
  return childrenOf
}

// Pass 1 of lspDocumentSymbolTree: 1a then 1b, combined into one bundle.
fn lspDocSymCollectChildren(ctx: LspDocSymCtx): LspDocSymChildren {
  let s = lspDocSymCollectStructs(ctx)
  let childrenOf = lspDocSymCollectMethods(ctx, s.childrenOf)
  return LspDocSymChildren{ childrenOf = childrenOf, hasStruct = s.hasStruct }
}

// The Tag.StructDecl arm of pass 2: a class entry, nested under its own
// `children` bucket from pass 1.
fn lspDocSymEmitStruct(
  ctx: LspDocSymCtx,
  declNode: int,
  unwrapped: int,
  childrenOf: map<string, []string>,
): string {
  let k = kidsOf(ctx.tree, unwrapped)
  let nameSp = getNode(ctx.tree, k[0]).span
  let name = ctx.source[nameSp.start:nameSp.end]
  let (kids, ok) = childrenOf[name]
  if (!ok) {
    kids = []string(0)
  }
  return lspDocSymEntry(ctx.p, LspSymRef{ declNode = declNode, nameNode = k[0] }, 23, "", kids)
}

// The Tag.InterfaceDecl/EnumDecl/TypeAlias arm of pass 2: always a top-level
// entry, none of these three nest anything.
fn lspDocSymEmitTypeDecl(ctx: LspDocSymCtx, declNode: int, unwrapped: int, tag: Tag): string {
  let kind = 11
  if (tag == Tag.EnumDecl) {
    kind = 10
  }
  if (tag == Tag.TypeAlias) {
    kind = 5
  }
  return lspDocSymEntry(
    ctx.p,
    LspSymRef{ declNode = declNode, nameNode = kidsOf(ctx.tree, unwrapped)[0] },
    kind,
    "",
    []string(0),
  )
}

// The Tag.FuncDecl arm of pass 2: a free function is always top-level; a
// method is top-level only when pass 1 found no matching class for its
// receiver in this file (a method on a type alias, or on a class declared
// elsewhere) — otherwise it is already nested under that class's entry.
fn lspDocSymEmitFunc(
  ctx: LspDocSymCtx,
  declNode: int,
  unwrapped: int,
  hasStruct: map<string, bool>,
): string {
  let k = kidsOf(ctx.tree, unwrapped)
  if (k[0] == 0) {
    return lspDocSymEntry(
      ctx.p,
      LspSymRef{ declNode = declNode, nameNode = k[1] },
      12,
      "",
      []string(0),
    )
  }
  let recvName = typeNodeName(ctx.c, kidsOf(ctx.tree, k[0])[1])
  let (_, grouped) = hasStruct[recvName]
  if (grouped) {
    return ""
  }
  return lspDocSymEntry(
    ctx.p,
    LspSymRef{ declNode = declNode, nameNode = k[1] },
    6,
    "",
    []string(0),
  )
}

// The Tag.LetDecl/ConstDecl arm of pass 2: one entry per binding pattern.
fn lspDocSymEmitLet(ctx: LspDocSymCtx, unwrapped: int, tag: Tag, items: []string): []string {
  let kind = 13
  if (tag == Tag.ConstDecl) {
    kind = 14
  }
  for binding of kidsOf(ctx.tree, unwrapped) {
    if (binding != 0) {
      items = lspDocSymPattern(ctx.p, ctx.tree, kidsOf(ctx.tree, binding)[0], kind, items)
    }
  }
  return items
}

// True for the three tag kinds that always render as one top-level entry
// with no children (InterfaceDecl, EnumDecl, TypeAlias) — split out so the
// triple-`||` counts as one decision in a caller's complexity, not three.
fn isLspTypeDeclTag(tag: Tag): bool {
  return tag == Tag.InterfaceDecl || tag == Tag.EnumDecl || tag == Tag.TypeAlias
}

// True for the two binding-decl tag kinds (LetDecl, ConstDecl), which emit
// one entry per pattern rather than one per decl.
fn isLspBindingTag(tag: Tag): bool {
  return tag == Tag.LetDecl || tag == Tag.ConstDecl
}

// Resolves a top-level decl node to the node whose tag drives pass 2's
// dispatch: unwraps an `export`, and returns 0 for a decl outside this file
// or with nothing left after unwrapping — either way, pass 2 skips it.
fn lspDocSymUnwrap(ctx: LspDocSymCtx, node: int): int {
  if (node == 0) {
    return 0
  }
  if (fileOf(ctx.m.fileStarts, getNode(ctx.tree, node).span.start).fileIdx != ctx.fileIdx) {
    return 0
  }
  let unwrapped = node
  if (getNode(ctx.tree, unwrapped).tag == Tag.Export) {
    unwrapped = kidsOf(ctx.tree, unwrapped)[0]
  }
  return unwrapped
}

// Pass 2 of lspDocumentSymbolTree: emits every decl in this file, in decl
// order, dispatching each to the arm matching its tag.
fn lspDocSymEmit(ctx: LspDocSymCtx, ch: LspDocSymChildren): []string {
  let items = []string(0)
  let di = 0
  while (di < len(ctx.decls)) {
    let declNode = ctx.decls[di]
    di = di + 1
    let unwrapped = lspDocSymUnwrap(ctx, declNode)
    if (unwrapped == 0) {
      continue
    }
    let tag = getNode(ctx.tree, unwrapped).tag
    let entry = ""
    if (tag == Tag.StructDecl) {
      entry = lspDocSymEmitStruct(ctx, declNode, unwrapped, ch.childrenOf)
    } else if (isLspTypeDeclTag(tag)) {
      entry = lspDocSymEmitTypeDecl(ctx, declNode, unwrapped, tag)
    } else if (tag == Tag.FuncDecl) {
      entry = lspDocSymEmitFunc(ctx, declNode, unwrapped, ch.hasStruct)
    } else if (isLspBindingTag(tag)) {
      items = lspDocSymEmitLet(ctx, unwrapped, tag, items)
      continue
    }
    if (entry != "") {
      items = append(items, entry)
    }
  }
  return items
}

// The nested `DocumentSymbol[]` for `fileIdx` of the root module's tree —
// the concatenated tree holds every file's decls under one root, so this
// filters to the ones whose text begins in the requested file, exactly as
// the flat form did.
//
// TWO PASSES over the same decl list, because a method commonly follows the
// class it belongs to in source order (the ticket's own `task.bit`
// example), so a single top-to-bottom pass cannot know a class's full
// method list before it has already emitted that class's entry:
//   1. collect (lspDocSymCollectChildren): class field-lists (seeding
//      `childrenOf`) and every method's entry, bucketed by its receiver's
//      type NAME.
//   2. emit (lspDocSymEmit), in decl order: a class gets its fields +
//      collected methods as `children`; a method whose receiver type has NO
//      class decl in this file (declared elsewhere, or a plain type alias)
//      is emitted at the top level instead of silently dropped; everything
//      else is unchanged from the flat form's own per-kind handling.
fn lspDocumentSymbolTree(lp: LspProject, fileIdx: int): []string {
  let p = lp.p
  let m = p.mods[p.root]
  let c = lp.mods[lp.p.root]
  let tree = c.tree
  let source = c.source
  let decls = kidsOf(tree, tree.root)
  let ctx = LspDocSymCtx{
    p = p,
    m = m,
    c = c,
    tree = tree,
    source = source,
    decls = decls,
    fileIdx = fileIdx,
  }
  let ch = lspDocSymCollectChildren(ctx)
  return lspDocSymEmit(ctx, ch)
}
