// compiler/classtableimports.bit — `@table`'s implicit "std/sql" dependency
// (#6284), split out of classtabledesc.bit (which #6284 pushed past the
// 800-line ceiling). Sibling file, same module: a pure move of the four
// declarations below, nothing else changed. Mirrors classjson.bit's own
// `moduleDeclaresJsonAttr`/`jsonModulePathImported`/`jsonClassImportDecls`
// (#6244) exactly, against `TableClass`/`classHasTable` instead of
// `JsonClass`/`classHasJson`.

// `@table` and demand-driven row mappers share the std/sql dependency.
const tableSqlModulePath = "std/sql"

// True iff the module declares ANY `@table` class — purely syntactic (tree,
// source only), so `project.bit`'s loader can call it before a `Project`
// exists, to decide whether this module needs std/sql as an IMPLICIT
// dependency. `@softDelete`/`@timestamps`/a relation mark never appear
// without `@table` on the same class (SPEC §10.5), so `classHasTable` alone
// answers this for the whole family.
fn moduleDeclaresTableAttr(tree: Tree, source: string): bool {
  for tc of topClassDecls(tree) {
    if (classHasTable(tree, source, tc.decl)) {
      return true
    }
  }
  return false
}

// True iff the module imports ANYTHING at all from "std/sql": `FieldDesc`/
// `AttrDesc` are resolved by the compiler itself (`tableClassImportDecls`,
// below), so this only has to find an entry for `tableSqlModulePath` in
// `m.imports` — populated either by a literal import the user wrote, or by
// `project.bit`'s `injectImplicitTableImport` when they wrote none.
fn tableModulePathImported(m: SrcModule): bool {
  let (_, ok) = m.imports[tableSqlModulePath]
  return ok
}

// `import { FieldDesc, AttrDesc, JoinDesc } from "std/sql"`, synthesized
// once per module that has at least one `@table` class — the same shape
// #6244's `jsonClassImportDecls` (classjson.bit) takes for `@json`'s
// `Json`/`JsonEntry`, reusing the identical `synthImportDecl`. `bound` is
// fresh here for the identical reason `jsonClassImportDecls`'s own comment
// gives (synthtext.bit): `FieldDesc`/`AttrDesc`/`JoinDesc` are unique to
// this pass, so nothing downstream (`tableRowImportDecl`'s `Value`/`Rows`)
// could collide. `JoinDesc` (#6323) is imported unconditionally, the same
// as `FieldDesc`/`AttrDesc`: every `@table` class's synthesized
// `__manyToManyJoins(): []JoinDesc` (classtablerelationlink.bit) names it
// in its own result type even when the class has no `@manyToMany` field.
fn tableClassImportDecls(
  m: SrcModule, st: SynthText, classes: []TableClass, bound: map<string, bool>,
): []int {
  if (len(classes) == 0) {
    return []int(0)
  }
  let names = synthUnboundNames(bound, ["FieldDesc", "AttrDesc", "JoinDesc"])
  let decl = synthImportAliasedDecl(m, st, tableSqlModulePath, names)
  if (decl == 0) {
    return []int(0)
  }
  return [decl]
}

// #6251: discover row-class modules from imported SQL calls after the graph loads.
// Resolve class aliases against that graph; unrelated functions named find do not count.
fn sqlRowImportTarget(p: Project, mid: int, call: int): int {
  let m = p.mods[mid]
  let targ = sqlRowTypeArg(m.tree, call)
  if (targ == 0 || getNode(m.tree, targ).tag != Tag.Ident) {
    return -1
  }
  let site = sqlClassSiteOf(p, mid, identText(m.tree, m.source, targ))
  if (!site.found || sqlRowModulePathImported(p.mods[site.mod])) {
    return -1
  }
  return site.mod
}

fn moduleSqlRowImportTargets(p: Project, mid: int, targets: map<int, int>) {
  let m = p.mods[mid]
  let (sqlMod, hasSql) = m.imports[sqlRowModulePath]
  if (!hasSql || sqlMod < 0) {
    return
  }
  let bindings = sqlRowBindingsOf(m.tree, m.source)
  if (!sqlRowBindsAny(bindings)) {
    return
  }
  for cn of sqlRowCallNodes(m.tree, m.source, bindings) {
    let target = sqlRowImportTarget(p, mid, cn.node)
    if (target >= 0 && target != sqlMod) {
      targets[target] = sqlMod
    }
  }
}

fn sqlRowImportTargets(p: Project): map<int, int> {
  let targets = map<int, int>{}
  let mid = 0
  while (mid < len(p.mods)) {
    moduleSqlRowImportTargets(p, mid, targets)
    mid = mid + 1
  }
  return targets
}

// std/sql is already reachable through the imported find entry point. Reuse its
// dependency order before adding mapper edges, then rediscover the renumbered ids.
fn injectImplicitSqlRowImports(p: Project) {
  if (!implicitSynthImportsEnabled()) {
    return
  }
  let targets = sqlRowImportTargets(p)
  for (_, sqlMod) of targets {
    applyModuleOrder(p, dependencyFirstOrder(p, sqlMod))
    break
  }
  for (target, sqlMod) of sqlRowImportTargets(p) {
    let closure = map<int, bool>{}
    addImportClosure(p, sqlMod, closure)
    let (_, cycle) = closure[target]
    if (cycle) {
      p.mods[target].imports[sqlRowModulePath] = modCycle
    } else {
      p.mods[target].imports[sqlRowModulePath] = sqlMod
    }
  }
}
