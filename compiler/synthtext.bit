// compiler/synthtext.bit — the one place a synthesized member's TEXT comes
// from, and the one pass that runs every member synthesis (#3879's
// `validateFields`, #3976's `toJson`).
//
// WHY THERE IS A TEXT PROBLEM AT ALL. An identifier's text in this AST is a
// SLICE of the module source (`identText`), and so is a string literal's
// (`decodeStringContent`). There is no string table, so a name that appears
// nowhere in the source cannot be spelled by any node — and every word a
// synthesized member needs (`toJson`, `this`, `Json`, the JSON key `"name"`)
// is exactly that. The fix is to append those words to the module's own
// source, once, and point the synthetic nodes at them.
//
// Appending at the TAIL is what makes it safe: every existing span keeps its
// meaning, the text is added after parsing so no lexer ever sees it, `bit fmt`
// never runs this pass at all, and the one reader that could be surprised by
// an offset past the last file — `locate` (diagnostics.bit) — has clamped
// since the loader started joining a module's files with a separator newline
// that belongs to no file. No diagnostic ever lands on one of these spans:
// every node a synthesis builds that a reader could be pointed at is stamped
// with the REAL span of the class, field or attribute it came from, and the
// nodes carrying synthetic spans are only names and locals.
//
// WHY ONE TABLE AND ONE PASS. #3879 appended two hardcoded words inline and
// its own report said a second synthesized name is the moment to stop. This is
// that generalisation, and it is the SMALLER of the two options on the table
// (the other being a `Tree.synth` string table): `Tree` carries no source
// today and every text reader in the compiler takes `(tree, source)`, so a
// table on `Tree` would have to be threaded through `identText`,
// `decodeStringContent`, the formatter, `bit doc` and the LSP before it spelled
// its first name. A word list costs one function and changes no reader at all.
// Each module gets ONE append covering BOTH features, so the number of appends
// is a property of the module, not of how many features fired in it.

// Where a module's synthesized words live, and what each one's span is.
// Keyed by the word itself: two features asking for `this` get one copy.
class SynthText {
  file: int,
  spans: map<string, Span>,
}

// Appends every distinct word in `words` to `m.source`, space-separated, and
// records where each one landed. Called at most once per module.
//
// The words are joined through a `[]byte` accumulator rather than `s = s + w`
// in the loop: the latter copies the whole accumulation on every word, which
// is the quadratic shape #2173 removed from the JSON encoder for the same
// reason.
fn appendSynthText(m: SrcModule, file: int, words: []string): SynthText {
  let st = SynthText{ file: file, spans: map<string, Span>{} }
  let base = len(m.source)
  let buf = []byte(0)
  for w of words {
    let (_, dup) = st.spans[w]
    if (dup) {
      continue
    }
    let start = base + len(buf)
    st.spans[w] = Span{ file: file, start: start, end: start + len(w) }
    buf = append(buf, w)
    buf = append(buf, " ")
  }
  m.source = m.source + string(buf)
  return st
}

// The span of one synthesized word. A word the builder asks for that the
// collector did not declare is a COMPILER bug, not a user error, and the
// symptom would be a node silently reading the wrong text off the front of the
// module — so it fails loudly here instead of producing a wrong program.
fn synthSpan(st: SynthText, word: string): Span {
  let (sp, ok) = st.spans[word]
  if (!ok) {
    panic("synthtext: '${word}' was never appended to this module's source")
  }
  return sp
}

// An `Ident` leaf spelling `word`. The shape every synthesized name takes.
fn synthIdent(tree: Tree, st: SynthText, word: string): int {
  return addLeaf(tree, Tag.Ident, synthSpan(st, word))
}

// What one module's synthesis pass will do, decided before anything is
// modified: a module needs its words appended exactly once, and the word list
// is the union of every feature that fired in it.
class SynthPlan {
  attrClasses: []AttrClass,
  jsonClasses: []JsonClass,
  decodeClasses: []JsonClass,
  textClasses: []JsonClass,
  textRootClasses: []JsonClass,
  instClasses: []JsonClass,
  tableClasses: []TableClass,
  sqlRowClasses: []SqlRowClass,
  words: []string,
  file: int,
}

// Injects every synthesized declaration for one module: #3879's
// `validateFields`, #3976's `toJson` and #3977's `jsonDecode<T>`
// specialisations. All three need words in the source, so all three go behind
// ONE `appendSynthText` — a module that needs none is byte-identical to before,
// source and tree alike.
//
// `@key` misuse is judged unconditionally, ahead of the plan: a `@key` on a
// class that carries no `@json` synthesizes nothing at all, so there is no
// later pass that could notice it.
fn injectSynthMembersInModule(
  p: Project, m: SrcModule, mid: int, d: JsonDecodeDemand, sqlDemand: SqlRowDemand,
) {
  vStrayKeyAttrs(m.tree, m.source, p.diags)
  let plan = planSynthMembers(p, m, mid, d, sqlDemand)
  if (len(plan.words) == 0) {
    return
  }
  let st = appendSynthText(m, plan.file, plan.words)
  let rc = AttrResolveCtx{ p: p, mid: mid }
  let newDecls = injectFieldValidatorDecls(rc, m, p.diags, st, plan.attrClasses)
  for x of injectJsonDecls(m, st, plan.jsonClasses) {
    newDecls = append(newDecls, x)
  }
  for x of injectTableDescDecls(m.tree, m.source, st, plan.tableClasses) {
    newDecls = append(newDecls, x)
  }
  if (len(plan.decodeClasses) != 0) {
    for x of injectJsonDecodeDecls(newJsonCtx(p, m), st, plan.decodeClasses) {
      newDecls = append(newDecls, x)
    }
  }
  // #4501: the text-level decoders, which read the token stream straight into
  // the class and never build a `Json`. Demanded per CLASS exactly as the DOM
  // ones are, so a project that only ever calls `jsonDecode` synthesizes none.
  for x of injectJsonDecodeTextDecls(newJsonCtx(p, m), st, plan) {
    newDecls = append(newDecls, x)
  }
  // #4563: the specialisation a decoding GENERIC's ledger entry is retargeted
  // at. Only for classes something decodes through a wrapper, so a project that
  // decodes only by name is byte-identical to before.
  for x of injectJsonDecodeInstDecls(newJsonCtx(p, m), st, plan.instClasses) {
    newDecls = append(newDecls, x)
  }
  for x of jsonDecodeImportDecls(m, st, mid, d, plan) {
    newDecls = append(newDecls, x)
  }
  rewriteJsonDecodeCalls(m, st, mid, d)
  for x of injectSqlRowSynth(m, st, mid, plan, sqlDemand) {
    newDecls = append(newDecls, x)
  }
  attachNewDecls(m.tree, newDecls)
}

// #5054: `find<T>`/`findOne<T>`/`findOneOrFail<T>`'s row mappers and their
// imports — the rewrite of every call site this module owns is a side
// effect, run here too since both need the same inputs. Split out of
// `injectSynthMembersInModule` to keep it under LINT.md's max-complexity.
fn injectSqlRowSynth(
  m: SrcModule, st: SynthText, mid: int, plan: SynthPlan, sqlDemand: SqlRowDemand,
): []int {
  let out = []int(0)
  for x of injectSqlRowMapperDecls(m.tree, st, plan.sqlRowClasses) {
    out = append(out, x)
  }
  for x of sqlRowImportDecls(m, st, mid, sqlDemand, len(plan.sqlRowClasses) != 0) {
    out = append(out, x)
  }
  rewriteSqlRowCalls(m, st, mid, sqlDemand)
  return out
}

// The plan: which classes each feature fired on, every word they need, and the
// file id every synthesized span is stamped with.
fn planSynthMembers(
  p: Project, m: SrcModule, mid: int, d: JsonDecodeDemand, sqlDemand: SqlRowDemand,
): SynthPlan {
  let jx = newJsonCtx(p, m)
  let attrClasses = collectAttrClasses(p, mid, m.tree, m.source)
  let jsonClasses = collectJsonClasses(p, m)
  let decodeClasses = moduleDecodeClasses(d, mid, jsonClasses, jx)
  let textClasses = moduleDecodeTextClasses(d, mid, jsonClasses, jx)
  let textRoots = moduleDecodeTextRootClasses(d, mid, jsonClasses, jx)
  let instClasses = moduleDecodeInstClasses(d, mid, jsonClasses, jx)
  let tableClasses = collectTableClasses(p, m, mid)
  let sqlRowClasses = collectSqlRowClasses(p, m, mid, sqlDemand)
  let words = []string(0)
  for w of fieldAttrSynthWords(p, mid, m.tree, m.source, attrClasses) {
    words = append(words, w)
  }
  for w of jsonSynthWords(jsonClasses) {
    words = append(words, w)
  }
  for w of tableDescSynthWords(m.tree, m.source, tableClasses) {
    words = append(words, w)
  }
  for w of jsonDecodeSynthWords(jx, decodeClasses) {
    words = append(words, w)
  }
  for w of jsonDecodeCallWords(d, mid) {
    words = append(words, w)
  }
  for w of jsonDecodeTextSynthWords(jx, textClasses) {
    words = append(words, w)
  }
  for w of jsonDecodeTextCallWords(d, mid) {
    words = append(words, w)
  }
  for w of jsonDecInstWords(jx, instClasses) {
    words = append(words, w)
  }
  for w of sqlRowWords(sqlRowClasses, sqlDemand, mid) {
    words = append(words, w)
  }
  return SynthPlan{
    attrClasses: attrClasses, jsonClasses: jsonClasses,
    decodeClasses: decodeClasses, textClasses: textClasses,
    textRootClasses: textRoots, instClasses: instClasses,
    tableClasses: tableClasses, sqlRowClasses: sqlRowClasses, words: words,
    file: synthFileId(
      m, firstSynthClassName(attrClasses, jsonClasses, tableClasses, sqlRowClasses), d, sqlDemand, mid,
    ),
  }
}

// #5054's own two word lists — the mappers this module builds, and the
// names every call site it owns needs — merged into one so
// `planSynthMembers` stays under LINT.md's max-complexity.
fn sqlRowWords(sqlRowClasses: []SqlRowClass, sqlDemand: SqlRowDemand, mid: int): []string {
  let out = []string(0)
  for w of sqlRowSynthWords(sqlRowClasses) {
    out = append(out, w)
  }
  for w of sqlRowCallWords(sqlDemand, mid) {
    out = append(out, w)
  }
  return out
}

// The className node of whichever class-attribute or #5054 row-mapper
// feature fired first in the module, or 0 when none did — bundled so
// `synthFileId` stays inside LINT.md's max-params (5).
fn firstSynthClassName(
  attrClasses: []AttrClass, jsonClasses: []JsonClass, tableClasses: []TableClass,
  sqlRowClasses: []SqlRowClass,
): int {
  if (len(attrClasses) != 0) {
    return attrClasses[0].className
  }
  if (len(jsonClasses) != 0) {
    return jsonClasses[0].className
  }
  if (len(tableClasses) != 0) {
    return tableClasses[0].className
  }
  if (len(sqlRowClasses) != 0) {
    return sqlRowClasses[0].className
  }
  return 0
}

// The file id every synthesized span is stamped with. Spans are module-global
// at this point, so any node in this module answers it, and `remapDiags` in the
// caller is what turns a module-global span back into a per-file one. Taken
// from whichever feature actually fired.
fn synthFileId(
  m: SrcModule, firstClassName: int, d: JsonDecodeDemand, sqlDemand: SqlRowDemand, mid: int,
): int {
  if (firstClassName != 0) {
    return getNode(m.tree, firstClassName).span.file
  }
  for site of d.sites {
    if (site.callerMod == mid) {
      return getNode(m.tree, site.callNode).span.file
    }
  }
  for site of sqlDemand.sites {
    if (site.callerMod == mid) {
      return getNode(m.tree, site.callNode).span.file
    }
  }
  return 0
}

// Entry point, called from resolveProject (checkproject.bit) immediately after
// `injectTraits` and for the identical reason: every front end (check / build /
// bit doc / the LSP) reaches the checker through there, and this has to have
// happened before a Checker captures the module's source. After traits, so each
// class's member list is final before anything reads it.
//
// The decode demand is collected across the WHOLE project first, because a
// `jsonDecode<T>` call and `T`'s declaration routinely sit in different
// modules and the declaring module has to know it was asked before it
// synthesizes anything.
//
// Spans are MODULE-GLOBAL here, as they are in `injectTraits`, so the same
// `remapDiags` call has to follow — without it a diagnostic renders against
// file 0.
fn injectSynthMembers(p: Project) {
  let demand = collectJsonDecodeDemand(p)
  let sqlDemand = collectSqlRowDemand(p)
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    injectSynthMembersInModule(p, p.mods[i], i, demand, sqlDemand)
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
}
