// compiler/synthtext.bit — the one place a synthesized member's TEXT comes
// from, and the one pass that runs every member synthesis (#3879's
// `validateFields`, #3976's `toJson`).
//
// WHY THERE IS A TEXT PROBLEM AT ALL. An identifier's text in this AST is a
// SLICE of the module source (`identText`), and so is a string literal's
// (`decodeStringContent`). There is no string table, so a name that appears
// nowhere in the source cannot be spelled by any node — and every word a
// synthesized member needs (`toJson`, `this`, `Json`, the JSON key `"name"`)
// is exactly that. The fix is to append those words to the module's own
// source, once, and point the synthetic nodes at them.
//
// Appending at the TAIL is what makes it safe: every existing span keeps its
// meaning, the text is added after parsing so no lexer ever sees it, `bit fmt`
// never runs this pass at all, and the one reader that could be surprised by
// an offset past the last file — `locate` (diagnostics.bit) — has clamped
// since the loader started joining a module's files with a separator newline
// that belongs to no file. No diagnostic ever lands on one of these spans:
// every node a synthesis builds that a reader could be pointed at is stamped
// with the REAL span of the class, field or attribute it came from, and the
// nodes carrying synthetic spans are only names and locals.
//
// WHY ONE TABLE AND ONE PASS. #3879 appended two hardcoded words inline and
// its own report said a second synthesized name is the moment to stop. This is
// that generalisation, and it is the SMALLER of the two options on the table
// (the other being a `Tree.synth` string table): `Tree` carries no source
// today and every text reader in the compiler takes `(tree, source)`, so a
// table on `Tree` would have to be threaded through `identText`,
// `decodeStringContent`, the formatter, `bit doc` and the LSP before it spelled
// its first name. A word list costs one function and changes no reader at all.
// Each module gets ONE append covering BOTH features, so the number of appends
// is a property of the module, not of how many features fired in it.

// Where a module's synthesized words live, and what each one's span is.
// Keyed by the word itself: two features asking for `this` get one copy.
class SynthText {
  file: int,
  spans: map<string, Span>,
}

// True for a member name the compiler reserves for synthesized plumbing: the
// `__` prefix (`__tableName`, `__jobName`, `__variantName`, `__variants`, ...).
// Callable, but never part of a listed surface: `bit doc`, the docs-coverage and
// release-surface gates that read it, and LSP completion all skip a member this
// answers true for (#7072). The one predicate, so a new synthesized member needs
// no per-tool edit.
fn isSynthMemberName(name: string): bool {
  return len(name) > 2 && name[0:2] == "__"
}

// Appends every distinct word in `words` to `m.source`, space-separated, and
// records where each one landed. Called at most once per module.
//
// The words are joined through a `[]byte` accumulator rather than `s = s + w`
// in the loop: the latter copies the whole accumulation on every word, which
// is the quadratic shape #2173 removed from the JSON encoder for the same
// reason.
fn appendSynthText(m: SrcModule, file: int, words: []string): SynthText {
  let st = SynthText{ file = file, spans = map<string, Span>{} }
  let base = len(m.source)
  let buf = []byte(0)
  for w of words {
    let (_, dup) = st.spans[w]
    if (dup) {
      continue
    }
    let start = base + len(buf)
    st.spans[w] = Span{ file = file, start = start, end = start + len(w) }
    buf = append(buf, w)
    buf = append(buf, " ")
  }
  m.source = m.source + string(buf)
  return st
}

// The span of one synthesized word. A word the builder asks for that the
// collector did not declare is a COMPILER bug, not a user error, and the
// symptom would be a node silently reading the wrong text off the front of the
// module — so it fails loudly here instead of producing a wrong program.
fn synthSpan(st: SynthText, word: string): Span {
  let (sp, ok) = st.spans[word]
  if (!ok) {
    panic("synthtext: '${word}' was never appended to this module's source")
  }
  return sp
}

// An `Ident` leaf spelling `word`. The shape every synthesized name takes.
fn synthIdent(tree: Tree, st: SynthText, word: string): int {
  return addLeaf(tree, Tag.Ident, synthSpan(st, word))
}

// An `Ident` leaf spelling `word`, whose UNRESOLVED-NAME diagnostic should
// land on `diagNode` instead of the leaf's own (synthesized, tail-of-source)
// span (#5162). `identText` still reads `word` off the leaf's real span — the
// two purposes stay on two different fields, exactly as the ticket requires —
// so this only ever changes WHERE a report about the name points, never what
// name it resolves. `main` carries `diagNode`'s index: no reader of a
// `Tag.Ident` leaf consults `.main` (it is a tag-specific scalar, `ast.bit`'s
// own convention — see `opSymbol` for the pattern on `Tag.Binary`/`Unary`),
// so every existing pass over this leaf (resolve, check, lower, `bit doc`,
// the LSP) is unaffected; `rSpan` (resolve.bit) is the one reader that
// consults it, and only to pick the span a diagnostic about this leaf
// renders at.
fn synthIdentAt(tree: Tree, st: SynthText, word: string, diagNode: int): int {
  return addNode(tree, Tag.Ident, synthSpan(st, word), diagNode, []int(0))
}

// What one module's synthesis pass will do, decided before anything is
// modified: a module needs its words appended exactly once, and the word list
// is the union of every feature that fired in it.
class SynthPlan {
  attrClasses: []AttrClass,
  jsonClasses: []JsonClass,
  decodeClasses: []JsonClass,
  textClasses: []JsonClass,
  textRootClasses: []JsonClass,
  instClasses: []JsonClass,
  schemaClasses: []JsonClass,
  schemaInstClasses: []JsonClass,
  tableClasses: []TableClass,
  tableRowClasses: []TableRowClass,
  tableRelationClasses: []TableRelationClass,
  // The import text reaching pkg/orm (`moduleOrmImportPath`), "" for none.
  ormPath: string,
  sqlRowClasses: []SqlRowClass,
  jobClasses: []JobClass,
  collectionClasses: []CollectionClass,
  enumClasses: []EnumVariantsClass,
  getters: []IfaceGetter,
  fieldClasses: []FieldReadClass,
  valueClasses: []ValueClass,
  words: []string,
  file: int,
}

// The project-wide demands `injectSynthMembersInModule`/`planSynthMembers`
// need, bundled into one value so adding `jsonSchema<T>`'s demand (#6166)
// did not push either function's own parameter count past LINT.md's
// max-params=5 — both were already at it with `(p, m, mid, decode, sql)`.
class SynthDemand {
  jsonDecode: JsonDecodeDemand,
  sql: SqlRowDemand,
  jsonSchema: JsonSchemaDemand,
  getters: IfaceGetterDemand,
  fieldRead: FieldReadDemand,
  value: ValueDemand,
  // The resolved standard library root: a module under it may declare the
  // `__` helpers synthesized code calls (`vReservedTopName`, #7564).
  stdRoot: string,
}

// Injects every synthesized declaration for one module: #3879's
// `validateFields`, #3976's `toJson` and #3977's `jsonDecode<T>`
// specialisations. All three need words in the source, so all three go behind
// ONE `appendSynthText` — a module that needs none is byte-identical to before,
// source and tree alike.
//
// `@key` misuse is judged unconditionally, ahead of the plan: a `@key` on a
// class that carries no `@json` synthesizes nothing at all, so there is no
// later pass that could notice it. A stray relation mark (#5053,
// classrelationattr.bit's `vStrayRelationAttrs`) is judged the same way, for
// the same reason, against `@table` instead of `@json`.
// Returns the module's own `@job` classes so the caller (`injectSynthMembers`)
// can run the whole-program duplicate-name check once every module has been
// visited — the one place the full module set is in view.
fn injectSynthMembersInModule(p: Project, m: SrcModule, mid: int, dm: SynthDemand): []JobClass {
  vStrayKeyAttrs(m.tree, m.source, p.diags)
  vStrayRelationAttrs(m.tree, m.source, p.diags)
  vReservedJsonAppend(m.tree, m.source, p.diags)
  vReservedJobName(m.tree, m.source, p.diags)
  vReservedCollectionName(m.tree, m.source, p.diags)
  vReservedGetterName(m.tree, m.source, p.diags)
  vReservedFieldReadName(m.tree, m.source, p.diags)
  vReservedValueName(m.tree, m.source, p.diags)
  vReservedTopName(m, dm.stdRoot, p.diags)
  let plan = planSynthMembers(p, m, mid, dm)
  if (len(plan.words) == 0) {
    return plan.jobClasses
  }
  let st = appendSynthText(m, plan.file, plan.words)
  let rc = AttrResolveCtx{ p = p, mid = mid }
  let newDecls = injectFieldValidatorDecls(rc, m, p.diags, st, plan.attrClasses)
  for x of jsonMemberDecls(m, st, plan.jsonClasses) {
    newDecls = append(newDecls, x)
  }
  // #6232: `Json`/`JsonEntry`, the names `toJson`/`__jsonAppend` are written
  // in terms of, resolved without the user importing either — `bound` is
  // fresh here (not shared with the decode/sql import passes below, which
  // need none of these two names) exactly as `jsonSchemaImportDecls`'s own
  // comment on its `bound` param already explains. `appendAllInts`, not a
  // `for` loop of its own, keeps this function's own complexity where the
  // `injectJsonSchemaSynth` call below already does the same.
  newDecls = appendAllInts(
    newDecls, jsonClassImportDecls(m, st, plan.jsonClasses),
  )
  for x of injectTableAndJobSynth(m, st, plan) {
    newDecls = append(newDecls, x)
  }
  // Shared with `injectSqlRowSynth` below (#6255): both features import from
  // "std/sql" and a module using `@table` and `find<T>` together must not
  // import the same name (e.g. `Rows`) twice.
  let sqlBound = importedLocalNames(m.tree, m.source)
  newDecls = appendAllInts(newDecls, injectTableRowSynth(m, st, plan, sqlBound))
  newDecls = appendAllInts(newDecls, injectTableRelationSynth(m, st, plan, sqlBound))
  if (len(plan.decodeClasses) != 0) {
    for x of injectJsonDecodeDecls(newJsonCtx(p, m), st, plan.decodeClasses) {
      newDecls = append(newDecls, x)
    }
  }
  // #4501: the text-level decoders, which read the token stream straight into
  // the class and never build a `Json`. Demanded per CLASS exactly as the DOM
  // ones are, so a project that only ever calls `jsonDecode` synthesizes none.
  for x of injectJsonDecodeTextDecls(newJsonCtx(p, m), st, plan) {
    newDecls = append(newDecls, x)
  }
  // #4563: the specialisation a decoding GENERIC's ledger entry is retargeted
  // at. Only for classes something decodes through a wrapper, so a project that
  // decodes only by name is byte-identical to before.
  for x of injectJsonDecodeInstDecls(newJsonCtx(p, m), st, plan.instClasses) {
    newDecls = append(newDecls, x)
  }
  for x of jsonDecodeImportDecls(m, st, mid, dm.jsonDecode, plan) {
    newDecls = append(newDecls, x)
  }
  rewriteJsonDecodeCalls(m, st, mid, dm.jsonDecode)
  newDecls = appendAllInts(
    newDecls, injectJsonSchemaSynth(newJsonCtx(p, m), mid, st, plan, dm.jsonSchema),
  )
  let sqlRowCtx = SqlRowImportCtx{ m = m, st = st, mid = mid }
  for x of injectSqlRowSynth(sqlRowCtx, plan, dm.sql, sqlBound) {
    newDecls = append(newDecls, x)
  }
  newDecls = appendAllInts(newDecls, injectIfaceGetterDecls(m.tree, m.source, st, plan.getters))
  newDecls = appendAllInts(newDecls, injectFieldReadDecls(m, st, plan, dm.fieldRead.jsonMod))
  newDecls = appendAllInts(newDecls, injectValueDecls(m, st, plan.valueClasses))
  attachNewDecls(m.tree, newDecls)
  return plan.jobClasses
}

// `dst` with every element of `src` appended, in order — a plain MERGE with
// no loop at the call site, so wiring one more inject-and-append feature
// into `injectSynthMembersInModule` costs it no complexity of its own (the
// loop lives here instead).
fn appendAllInts(dst: []int, src: []int): []int {
  for x of src {
    dst = append(dst, x)
  }
  return dst
}

// `jsonSchema<T>()`'s own specialisation (#6166): no closure and no lenient
// variant to thread — a demanded class owes exactly one function, in its own
// declaring module. Split out of `injectSynthMembersInModule` to keep it
// under LINT.md's max-complexity, the same reason `injectTableAndJobSynth`
// and `injectSqlRowSynth` are.
fn injectJsonSchemaSynth(
  jx: JsonCtx,
  mid: int,
  st: SynthText,
  plan: SynthPlan,
  sd: JsonSchemaDemand,
): []int {
  let ctx = SchemaSynthCtx{ mid = mid, sd = sd }
  let out = injectJsonSchemaDecls(jx, ctx, st, plan.schemaClasses, plan.jsonClasses)
  // #6201: the specialisation a describing GENERIC's ledger entry is
  // retargeted at. Only for classes something reaches through a wrapper, so
  // a project that describes only by name is byte-identical to before.
  out = appendAllInts(out, injectJsonSchemaInstDecls(jx, st, plan.schemaInstClasses))
  out = appendAllInts(out, jsonSchemaImportDecls(jx.mod, st, mid, sd))
  rewriteJsonSchemaCalls(jx.mod, st, mid, sd)
  return out
}

// `@table`'s `tableDescriptor`/`tableAttrs`, `@job`'s `__jobName` and every
// `@json` class's `__collectionName` — all simple, no-decode member
// synthesis with nothing else to demand-collect. Split out of
// `injectSynthMembersInModule` to keep it under LINT.md's max-complexity,
// same reason `injectSqlRowSynth` below is.
fn injectTableAndJobSynth(m: SrcModule, st: SynthText, plan: SynthPlan): []int {
  let out = []int(0)
  for x of injectTableDescDecls(m.tree, m.source, st, plan.tableClasses) {
    out = append(out, x)
  }
  // #6284: `FieldDesc`/`AttrDesc`, resolved without the user importing
  // either — mirrors `jsonClassImportDecls`'s own call above, fresh `bound`
  // map for the same reason (this file's own comment there).
  for x of tableClassImportDecls(m, st, plan.tableClasses, importedLocalNames(m.tree, m.source)) {
    out = append(out, x)
  }
  for x of injectJobNameDecls(m.tree, st, plan.jobClasses) {
    out = append(out, x)
  }
  for x of injectCollectionNameDecls(m.tree, st, plan.collectionClasses) {
    out = append(out, x)
  }
  // #6987: `__variantName`/`static __variants` on every payload-free enum.
  out = appendAllInts(out, injectEnumVariantsDecls(m.tree, m.source, st, plan.enumClasses))
  return out
}

// `@table`'s four generic-bound members (#6255, classtablerow.bit) and
// their shared "std/sql" import. Split out of `injectSynthMembersInModule`
// to keep it under LINT.md's max-complexity, same reason
// `injectTableAndJobSynth` and `injectSqlRowSynth` are.
fn injectTableRowSynth(
  m: SrcModule, st: SynthText, plan: SynthPlan, bound: map<string, bool>,
): []int {
  let out = injectTableRowDecls(m.tree, m.source, st, plan.tableRowClasses)
  if (len(plan.tableRowClasses) == 0) {
    return out
  }
  let tableRowImport = tableRowImportDecl(m, st, plan.tableRowClasses, bound)
  if (tableRowImport != 0) {
    out = append(out, tableRowImport)
  }
  return out
}

// `@table`'s relation-loading statics (#6277, classtablerelation.bit) and
// their shared "orm" import — the same split `injectTableRowSynth` above
// makes for its own "std/sql" import, one function per feature to stay
// under LINT.md's max-complexity.
fn injectTableRelationSynth(
  m: SrcModule, st: SynthText, plan: SynthPlan, bound: map<string, bool>,
): []int {
  let out = injectTableRelationDecls(m.tree, m.source, st, plan.tableRelationClasses)
  if (len(plan.tableRelationClasses) == 0) {
    return out
  }
  let relationImport = tableRelationImportDecl(
    m,
    st,
    plan.tableRelationClasses,
    bound,
    plan.ormPath,
  )
  if (relationImport != 0) {
    out = append(out, relationImport)
  }
  return out
}

// #5054: `find<T>`/`findOne<T>`/`findOneOrFail<T>`'s row mappers and their
// imports — the rewrite of every call site this module owns is a side
// effect, run here too since both need the same inputs. Split out of
// `injectSynthMembersInModule` to keep it under LINT.md's max-complexity.
// `ctx` bundles the module/words/id `sqlRowImportDecls` (checksqlrowbuild.bit)
// needs, keeping this at 4 params now that it also takes the shared `bound`
// map (#6255) — LINT.md's max-params=5.
fn injectSqlRowSynth(
  ctx: SqlRowImportCtx, plan: SynthPlan, sqlDemand: SqlRowDemand, bound: map<string, bool>,
): []int {
  let out = []int(0)
  for x of injectSqlRowMapperDecls(ctx.m.tree, ctx.st, plan.sqlRowClasses) {
    out = append(out, x)
  }
  for x of sqlRowImportDecls(ctx, sqlDemand, len(plan.sqlRowClasses) != 0, bound) {
    out = append(out, x)
  }
  rewriteSqlRowCalls(ctx.m, ctx.st, ctx.mid, sqlDemand)
  return out
}

// The per-module class lists every `@json`-family feature fired on, bundled
// so `planSynthWords` stays inside LINT.md's max-params=5 without
// recomputing any of them a second time.
class SynthModuleClasses {
  json: []JsonClass,
  decode: []JsonClass,
  text: []JsonClass,
  inst: []JsonClass,
  schema: []JsonClass,
  schemaFrag: []JsonClass,
  schemaInst: []JsonClass,
}

fn synthModuleClassesOf(jx: JsonCtx, mid: int, dm: SynthDemand): SynthModuleClasses {
  let jsonClasses = collectJsonClasses(jx.proj, jx.mod)
  return SynthModuleClasses{
    json = jsonClasses,
    decode = moduleDecodeClasses(dm.jsonDecode, mid, jsonClasses, jx),
    text = moduleDecodeTextClasses(dm.jsonDecode, mid, jsonClasses, jx),
    inst = moduleDecodeInstClasses(dm.jsonDecode, mid, jsonClasses, jx),
    schema = moduleSchemaClasses(dm.jsonSchema, mid, jsonClasses, jx),
    schemaFrag = moduleSchemaFragClasses(dm.jsonSchema, mid, jsonClasses, jx),
    schemaInst = moduleSchemaInstClasses(dm.jsonSchema, mid, jsonClasses, jx),
  }
}

// The plan: which classes each feature fired on, every word they need, and the
// file id every synthesized span is stamped with.
fn planSynthMembers(p: Project, m: SrcModule, mid: int, dm: SynthDemand): SynthPlan {
  let jx = newJsonCtx(p, m)
  let attrClasses = collectAttrClasses(p, mid, m.tree, m.source)
  let mc = synthModuleClassesOf(jx, mid, dm)
  let textRoots = moduleDecodeTextRootClasses(dm.jsonDecode, mid, mc.json, jx)
  let tableClasses = collectTableClasses(p, m, mid)
  let tableRowClasses = collectTableRowClasses(p, m, tableClasses)
  // Gated on the module already importing pkg/orm — judged by what the
  // import RESOLVED to, not its spelling (`moduleOrmImportPath`,
  // classtablerelation.bit, #6324) — OR being pkg/orm itself
  // (`moduleHasOrmScope`, same file — #6273's
  // `RawNote`, declared inside pkg/orm with no self-import, caught the gap:
  // every `__loadRelation`/`__linkRelation` body this file synthesizes
  // names `pkg/orm`-only symbols (`RelationLoader`, `LinkOp`,
  // `dispatchLoadRelation` — unlike classtablerow.bit's own four members,
  // which need only ALWAYS-RESOLVABLE `std/sql`), so synthesizing either
  // for a module with no reachable "orm" package AND not itself part of
  // pkg/orm (an isolated `@table` fixture, e.g. `_tests_/bit/checkercases/
  // check_table_name_two_args.bit`, compiled as a single file with no
  // project around it) would inject an import nothing can resolve. Such a
  // class was never going to satisfy `Tabled` anyway — reaching it through
  // `Repo<T>` needs `pkg/orm/db.bit`'s own `Db`/`open`, which need the
  // identical import.
  let ormPath = moduleOrmImportPath(p, m)
  let tableRelationClasses = []TableRelationClass(0)
  if (moduleHasOrmScope(m, ormPath)) {
    tableRelationClasses = collectTableRelationClasses(m.tree, m.source, tableRowClasses)
  }
  let sqlRowClasses = collectSqlRowClasses(p, m, mid, dm.sql)
  let jobClasses = collectJobClasses(p, m)
  let collectionClasses = collectCollectionClasses(p, m)
  let enumClasses = collectEnumVariantsClasses(m.tree, m.source, p.diags)
  let getters = collectIfaceGetters(m, mid, dm.getters)
  let fieldClasses = collectFieldReadClasses(p, m, mid, dm.fieldRead)
  let valueClasses = collectValueClasses(dm.value, m, mid)
  let words = planSynthWords(mid, jx, attrClasses, mc, dm)
  for w of tableAndJobWords(m.tree, m.source, tableClasses, jobClasses) {
    words = append(words, w)
  }
  for w of collectionDescSynthWords(collectionClasses) {
    words = append(words, w)
  }
  for w of concatWords(
    enumVariantsSynthWords(m.tree, m.source, enumClasses),
    ifaceAndFieldWords(m, getters, fieldClasses, valueClasses),
  ) {
    words = append(words, w)
  }
  words = concatWords(words, tableRowSynthWords(tableRowClasses))
  words = concatWords(words, tableRelationSynthWords(m.tree, m.source, tableRelationClasses))
  for w of sqlRowWords(sqlRowClasses, dm.sql, mid) {
    words = append(words, w)
  }
  return SynthPlan{
    attrClasses = attrClasses, jsonClasses = mc.json,
    decodeClasses = mc.decode, textClasses = mc.text,
    textRootClasses = textRoots, instClasses = mc.inst,
    schemaClasses = mc.schema, schemaInstClasses = mc.schemaInst,
    tableClasses = tableClasses, tableRowClasses = tableRowClasses,
    tableRelationClasses = tableRelationClasses, ormPath = ormPath,
    sqlRowClasses = sqlRowClasses,
    jobClasses = jobClasses, collectionClasses = collectionClasses, enumClasses = enumClasses,
    getters = getters, fieldClasses = fieldClasses, valueClasses = valueClasses,
    words = words,
    file = synthFileId(
      m,
      firstFieldReadClass(
        firstGetterClass(
          firstSynthClassName(attrClasses, mc.json, tableClasses, sqlRowClasses, enumClasses),
          getters,
        ),
        fieldClasses, valueClasses,
      ),
      dm.jsonDecode, dm.sql, mid,
    ),
  }
}

// The `@json`-family word lists (`toJson`, `jsonDecode<T>` in its three
// shapes, `jsonSchema<T>`) plus the field-attribute list, split out of
// `planSynthMembers` to keep it under LINT.md's max-complexity as this
// ticket's own feature (#6166) added a fifth list beside the other four.
fn planSynthWords(
  mid: int, jx: JsonCtx, attrClasses: []AttrClass, mc: SynthModuleClasses, dm: SynthDemand,
): []string {
  let words = []string(0)
  for w of fieldAttrSynthWords(jx.proj, mid, jx.tree, jx.source, attrClasses) {
    words = append(words, w)
  }
  for w of jsonAllSynthWords(jx.tree, jx.source, mc.json) {
    words = append(words, w)
  }
  for w of jsonDecodeSynthWords(jx, mc.decode) {
    words = append(words, w)
  }
  for w of jsonDecodeCallWords(dm.jsonDecode, mid) {
    words = append(words, w)
  }
  for w of jsonDecodeTextSynthWords(jx, mc.text) {
    words = append(words, w)
  }
  for w of jsonDecodeTextCallWords(dm.jsonDecode, mid) {
    words = append(words, w)
  }
  for w of jsonDecInstWords(jx, mc.inst) {
    words = append(words, w)
  }
  for w of schemaSynthWordsFor(jx, mid, mc, dm) {
    words = append(words, w)
  }
  return words
}

// `jsonSchema<T>`'s own three word lists (the closure's own words, a direct
// call site's, a cross-module `$defs` frag call's — #6182), merged so
// adding the third did not push `planSynthWords` past LINT.md's
// max-complexity=10.
fn schemaSynthWordsFor(jx: JsonCtx, mid: int, mc: SynthModuleClasses, dm: SynthDemand): []string {
  let schemaCtx = SchemaSynthCtx{ mid = mid, sd = dm.jsonSchema }
  let words = jsonSchemaAllSynthWords(jx, schemaCtx, mc.json, mc.schema, mc.schemaFrag)
  for w of jsonSchemaCallWords(dm.jsonSchema, mid) {
    words = append(words, w)
  }
  for w of jsonSchemaFragCallWords(dm.jsonSchema, mid) {
    words = append(words, w)
  }
  for w of jsonSchemaInstWords(jx, mc.schemaInst) {
    words = append(words, w)
  }
  return words
}

// `@table`'s word list and `@job`'s, merged into one so `planSynthMembers`
// stays under LINT.md's max-complexity — same reason `sqlRowWords` below
// merges its own two.
fn tableAndJobWords(
  tree: Tree,
  source: string,
  tableClasses: []TableClass,
  jobClasses: []JobClass,
): []string {
  let out = []string(0)
  for w of tableDescSynthWords(tree, source, tableClasses) {
    out = append(out, w)
  }
  for w of jobDescSynthWords(jobClasses) {
    out = append(out, w)
  }
  return out
}

// #5054's own two word lists — the mappers this module builds, and the
// names every call site it owns needs — merged into one so
// `planSynthMembers` stays under LINT.md's max-complexity.
fn sqlRowWords(sqlRowClasses: []SqlRowClass, sqlDemand: SqlRowDemand, mid: int): []string {
  let out = []string(0)
  for w of sqlRowSynthWords(sqlRowClasses) {
    out = append(out, w)
  }
  for w of sqlRowCallWords(sqlDemand, mid) {
    out = append(out, w)
  }
  return out
}

// The className node of whichever class-attribute or #5054 row-mapper
// feature fired first in the module, or 0 when none did — bundled so
// `synthFileId` stays inside LINT.md's max-params (5).
fn firstSynthClassName(
  attrClasses: []AttrClass, jsonClasses: []JsonClass, tableClasses: []TableClass,
  sqlRowClasses: []SqlRowClass, enumClasses: []EnumVariantsClass,
): int {
  if (len(attrClasses) != 0) {
    return attrClasses[0].className
  }
  if (len(jsonClasses) != 0) {
    return jsonClasses[0].className
  }
  if (len(tableClasses) != 0) {
    return tableClasses[0].className
  }
  if (len(sqlRowClasses) != 0) {
    return sqlRowClasses[0].className
  }
  if (len(enumClasses) != 0) {
    return enumClasses[0].className
  }
  return 0
}

// `a` followed by `b`: merges two feature word lists into one loop at the call
// site, so wiring a feature in costs `planSynthMembers` no complexity.
fn concatWords(a: []string, b: []string): []string {
  for w of b {
    a = append(a, w)
  }
  return a
}

// `first` (the class name node of the first feature that fired), or the first
// getter's class when none did, so the file id still comes from this module.
fn firstGetterClass(first: int, getters: []IfaceGetter): int {
  if (first == 0 && len(getters) != 0) {
    return getters[0].className
  }
  return first
}

// The getters' words then the `__field` classes' (#7110).
fn ifaceAndFieldWords(
  m: SrcModule, getters: []IfaceGetter, fields: []FieldReadClass, values: []ValueClass,
): []string {
  return concatWords(
    concatWords(ifaceGetterSynthWords(getters), fieldReadSynthWords(m.tree, m.source, fields)),
    valueSynthWords(values),
  )
}

// `first`, or the first `__field` (then value-semantics) class's name node when nothing else fired.
fn firstFieldReadClass(first: int, classes: []FieldReadClass, values: []ValueClass): int {
  if (first == 0 && len(classes) != 0) {
    return classes[0].className
  }
  if (first == 0 && len(values) != 0) {
    return values[0].className
  }
  return first
}

// The file id every synthesized span is stamped with. Spans are module-global
// at this point, so any node in this module answers it, and `remapDiags` in the
// caller is what turns a module-global span back into a per-file one. Taken
// from whichever feature actually fired.
fn synthFileId(
  m: SrcModule, firstClassName: int, d: JsonDecodeDemand, sqlDemand: SqlRowDemand, mid: int,
): int {
  if (firstClassName != 0) {
    return getNode(m.tree, firstClassName).span.file
  }
  for site of d.sites {
    if (site.callerMod == mid) {
      return getNode(m.tree, site.callNode).span.file
    }
  }
  for site of sqlDemand.sites {
    if (site.callerMod == mid) {
      return getNode(m.tree, site.callNode).span.file
    }
  }
  return 0
}

// Entry point, called from resolveProject (checkproject.bit) immediately after
// `injectTraits` and for the identical reason: every front end (check / build /
// bit doc / the LSP) reaches the checker through there, and this has to have
// happened before a Checker captures the module's source. After traits, so each
// class's member list is final before anything reads it.
//
// The decode demand is collected across the WHOLE project first, because a
// `jsonDecode<T>` call and `T`'s declaration routinely sit in different
// modules and the declaring module has to know it was asked before it
// synthesizes anything.
//
// Spans are MODULE-GLOBAL here, as they are in `injectTraits`, so the same
// `remapDiags` call has to follow — without it a diagnostic renders against
// file 0.
fn injectSynthMembers(p: Project) {
  let dm = SynthDemand{
    jsonDecode = collectJsonDecodeDemand(p), sql = collectSqlRowDemand(p),
    jsonSchema = collectJsonSchemaDemand(p), getters = collectIfaceGetterDemand(p),
    fieldRead = collectFieldReadDemand(p), value = collectValueDemand(p),
    stdRoot = pathResolve(stdRootPath()),
  }
  let allJobClasses = []JobClass(0)
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    for jc of injectSynthMembersInModule(p, p.mods[i], i, dm) {
      allJobClasses = append(allJobClasses, jc)
    }
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
  // #6081: whole-program, since two `@job` classes anywhere share a queue
  // store keyed by this string — `p.mods` (above) is the module set this
  // check needs, already in view here. Each `JobClass.classSpan` was
  // remapped to its own module's per-file span at collection time
  // (`classjobdesc.bit`'s `remapJobModuleSpan`), so this runs AFTER every
  // module's `remapDiags` call rather than needing one of its own.
  checkJobNameDuplicates(p.diags, allJobClasses)
}
