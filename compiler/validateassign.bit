// Self-host: write-side validation of an assignment/inc/dec target (#2740).
//
// `vIndex` (validateexpr.bit) answers whether a receiver can be indexed AT
// ALL, and answers TRUE for a string — correctly, since `s[0]` is a valid
// read yielding a `byte` (§11.1, §12.6). It runs on every `Index` node, read
// or write alike, and is deliberately not the place to ask a write-only
// question: doing so would also reject the read `let b = s[0]`.
//
// Nothing else asked the write-only question, so `s[0] = x`, `s[0] += 1` and
// `s[0]++` all passed `bit check` and reached `lowerIndexStore`/
// `resolveLvalue`, neither of which has a store arm for a string (it is a
// reference type but deeply immutable, §13.3), and refused with "cannot
// lower 1 function(s)" — a function name, no span, no code, no mention of
// strings.
//
// This file is that missing question, asked once per assignment target and
// inc/dec operand: is this an `Index` node whose receiver is `string`? If
// so, report E0087. `vIndex`'s read-side verdict is untouched — this never
// runs against a read.
//
// `lowerIndex`/`lowerIndexStore`/`resolveLvalue` keep their own refusals as
// the backstop (#2385/#2390/#2403): the checker catching this first is the
// fix, not a reason to remove the lowerer's guard.
//
// Wired from checkmodule.bit's main sweep, not from `vStmt` (validatestmt.bit,
// 799/800 lines — no room for the hook). checkmodule.bit's own arena loop
// already visits every node once, in source order, and children precede
// their enclosing FuncDecl in that order — so by the time this fires for a
// statement's own `Assign`/`IncStmt`/`DecStmt` node, every `let`/`const`
// binding it references has already been typed by that same loop's earlier
// iterations (`isTopLevelBinding` bindings in the pre-pass; a local `let`
// at its own, earlier, arena position). No dependency on `vFuncDecl` having
// run for the enclosing function yet.

// E0087 (§11.1): a `string` index is a read-only byte; nothing may assign
// through one. Declared here, beside the rule that uses it, following
// validateentry.bit's E0085 and validatezero.bit's E0086 (#2236/#2147) —
// first free code above E0086.
const ecStringIndexAssign = 87

// Reports E0087 when `target` is an `Index` node (`recv[i]`) whose receiver
// types to `string`. Anchored at the whole index expression, not just the
// receiver: the receiver alone would read like E0054's not-indexable caret,
// and a string genuinely IS indexable — this is "indexable, but not for
// writing", a different claim from E0054's "not indexable at all".
//
// Skips a receiver that did not infer, mentions `invalid`, or still carries
// an open type param — THE SAFETY RULE (validate.bit): an inference gap must
// never become a spurious diagnostic on code the previous release accepts.
fn vIndexWriteTarget(c: Checker, target: int) {
  if (target == 0 || getNode(c.tree, target).tag != Tag.Index) {
    return
  }
  let recv = kidsOf(c.tree, target)[0]
  let rt = checkExprType(c, recv)
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  if (c.ctx.types[rt].kind != TypeKind.Prim || c.ctx.types[rt].prim != 11) {
    return
  }
  report(
    c.diags, ecStringIndexAssign, vSpan(c, target),
    "cannot assign to a string index: 'string' is deeply immutable, so indexing it can only read a byte (§11.1)",
    "build a new string instead of mutating one in place — concatenation, 'std/strings', or round-trip through '[]byte'",
  )
}

// Every target a plain/compound assignment or inc/dec can write through
// (#2740). A plain `=` and a compound `+=`/`-=`/... share one `Assign` node
// with a comma-separated `lhs_list` (parserstmt.bit); `++`/`--` are their own
// `IncStmt`/`DecStmt` nodes with exactly one operand. Reading both shapes
// uniformly here is what lets checkmodule.bit's single call site cover all
// three spellings the ticket names.
fn vAssignTargetString(c: Checker, node: int) {
  let t = getNode(c.tree, node).tag
  if (t == Tag.IncStmt || t == Tag.DecStmt) {
    vIndexWriteTarget(c, kidsOf(c.tree, node)[0])
    return
  }
  let targets = kidsOf(c.tree, kidsOf(c.tree, node)[0])
  let i = 0
  while (i < len(targets)) {
    vIndexWriteTarget(c, targets[i])
    i = i + 1
  }
}

// E0114 (SPEC §10.5, #4066): a `readonly` class field, written anywhere but
// a composite literal or the declaring class's own `init`. First free code
// above E0113 (classinit.bit's ecArrayCtorInvalid) — the LINT range starts
// at E0200, so this is a checker code, not a lint one.
const ecReadonlyFieldAssign = 114

// Is `recv` (an assignment target's Member receiver) literally the `this`
// bound by `classTy`'s own `init`? The one exemption `readonly` allows
// besides a composite literal (SPEC §10.5): construction is the class's own
// business, everything after is not — including a rebind from inside a
// DIFFERENT method of the same class, or through a local alias of `this`
// (`let self = this; self.n = ...`), both of which resolve to a decl other
// than init's own receiver node and are correctly rejected below.
//
// `this` parses as an ordinary `Tag.Ident` (parserexpr.bit) resolved by the
// scope-based resolver (resolve.bit's rActivateReceiver), never through the
// checker's flat `env` — so `c.nodeSymbols[recv]` names exactly the
// enclosing FUNCTION's own receiver symbol, not any other function's. Two
// receiver nodes are never the same arena index, so comparing `decl`
// directly is exact, with no need to also check the symbol's kind.
fn vInOwnInit(c: Checker, recv: int, classTy: int): bool {
  if (getNode(c.tree, recv).tag != Tag.Ident) {
    return false
  }
  let initNode = classInitNode(c, classTy)
  if (initNode == 0) {
    return false
  }
  let initRecv = kidsOf(c.tree, initNode)[0]
  if (recv < 0 || recv >= len(c.nodeSymbols)) {
    return false
  }
  let sid = c.nodeSymbols[recv]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return false
  }
  return c.symbols[sid].decl == initRecv
}

// Reports E0114 when `target` is a `Member` node (`recv.field`) naming a
// `readonly` field outside the one exemption `vInOwnInit` grants. Anchored
// at the whole member expression, matching `vIndexWriteTarget`'s span
// choice above for the same reason: `t.n` written wholly wrong is a
// different claim from "no such field".
//
// Skips a receiver that did not infer, mentions `invalid`, or still carries
// an open type param — THE SAFETY RULE (validate.bit), same as
// `vIndexWriteTarget`.
fn vMemberReadonlyAssign(c: Checker, target: int) {
  if (target == 0 || getNode(c.tree, target).tag != Tag.Member) {
    return
  }
  let kids = kidsOf(c.tree, target)
  let recv = kids[0]
  let rt = checkExprType(c, recv)
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  if (c.ctx.types[rt].kind != TypeKind.Struct) {
    return
  }
  let mn = getNode(c.tree, kids[1])
  let mname = c.source[mn.span.start:mn.span.end]
  if (!readonlyFieldLookup(c, "${rt}." + mname)) {
    return
  }
  if (vInOwnInit(c, recv, rt)) {
    return
  }
  let tn = typeName(c.ctx, rt)
  report(
    c.diags, ecReadonlyFieldAssign, vSpan(c, target),
    "cannot assign to readonly field '${mname}'",
    "'readonly' forbids REASSIGNING the field, not mutating what it refers to (SPEC §10.5) — it may only be set in a composite literal or in 'init' on '${tn}'",
  )
}

// Same walk as `vAssignTargetString`, over the same three node shapes, for
// the `readonly` rule instead of the string-index one. A separate function
// rather than folding into that one: the two checks are unrelated (an
// `Index` target can never also be a `Member` target), and keeping them
// apart keeps each well under the complexity limit.
fn vAssignTargetReadonly(c: Checker, node: int) {
  let t = getNode(c.tree, node).tag
  if (t == Tag.IncStmt || t == Tag.DecStmt) {
    vMemberReadonlyAssign(c, kidsOf(c.tree, node)[0])
    return
  }
  let targets = kidsOf(c.tree, kidsOf(c.tree, node)[0])
  let i = 0
  while (i < len(targets)) {
    vMemberReadonlyAssign(c, targets[i])
    i = i + 1
  }
}
