// `bit lint` rule dispatch and every rule's own check function (#2470, split
// out of compiler/lint.bit — 1362 lines against the 800-line limit).
// compiler/lint.bit keeps the rule registry and the `// bit:lint` override
// directive reader; compiler/lintbatch.bit keeps diagnostic rendering and the
// `bit lint` command itself, which calls `runLintRules` below.
//
// Named to sort after compiler/lint.bit, whose registry consts (`ecLint*`) and
// `LintConfig`/`LintRule` types this file uses, and before
// compiler/lintcheck.bit, whose self-checks call every function here directly
// — module files concatenate in bytewise filename order (compiler/project.bit:7).
//
// Lint findings are severity=1 (warning) and go through `warn`, which
// deliberately does not bump `errorCount` (diagnostics.bit:93). A lint hit must
// never fail an unrelated `bit build`; failure is expressed by `bit lint`'s exit
// code alone.

// Physical lines in `src`, counting blanks and comments (§4). A file whose last
// line has no terminating newline still counts that line.
fn lintCountLines(src: string): int {
  if (len(src) == 0) {
    return 0
  }
  let n = 0
  let i = 0
  while (i < len(src)) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  if (src[len(src) - 1] != '\n') {
    n = n + 1
  }
  return n
}

// Runs every registered rule over one file, appending findings to `d`. `tree`
// is the file's parsed AST — unused by `max-file-lines`, which reads only
// `src`, and required by every rule that needs syntax (phase 1, plus
// `append-aliasing`).
//
// This is the ONE place a rule is dispatched. A new rule adds its entry to
// `lintRules()` and its arm here; nothing else in the runner changes.
fn runLintRules(src: string, file: int, tree: Tree, cfg: LintConfig, d: Diagnostics) {
  let rules = lintRules()
  let funcs = lintCollectFuncs(tree, tree.root, []int(0))
  // `unused-import`/`unused-local`/`unused-result` are the rules that need
  // the resolver, computed once per file (not once per rule) and only when at
  // least one of the three is enabled, since every other rule here is
  // AST-or-text only.
  let unusedImportIdx = lintRuleIndex(rules, "unused-import")
  let unusedLocalIdx = lintRuleIndex(rules, "unused-local")
  let unusedResultIdx = lintRuleIndex(rules, "unused-result")
  let needUnused = (unusedImportIdx >= 0 && !cfg.disabled[unusedImportIdx]) ||
    (unusedLocalIdx >= 0 && !cfg.disabled[unusedLocalIdx]) ||
    (unusedResultIdx >= 0 && !cfg.disabled[unusedResultIdx])
  let analysis = LintUnusedAnalysis{ mod: newModule(), used: []bool(0) }
  if (needUnused) {
    analysis = lintAnalyzeUnused(tree, src, file, d.sm)
  }
  let i = 0
  while (i < len(rules)) {
    if (cfg.disabled[i]) {
      i = i + 1
      continue
    }
    if (rules[i].code == ecLintMaxFileLines) {
      lintMaxFileLines(src, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxFnLines) {
      lintMaxFnLines(tree, funcs, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxParams) {
      lintMaxParams(tree, funcs, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxNesting) {
      lintMaxNesting(tree, funcs, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintMaxComplexity) {
      lintMaxComplexity(tree, file, cfg.limits[i], d)
    } else if (rules[i].code == ecLintDeferInLoop) {
      lintDeferInLoop(tree, file, d)
    } else if (rules[i].code == ecLintUnusedImport) {
      lintUnusedImport(tree, analysis.mod, analysis.used, file, d)
    } else if (rules[i].code == ecLintUnusedLocal) {
      lintUnusedLocal(tree, analysis.mod, analysis.used, file, d)
    } else if (rules[i].code == ecLintUnreachableCode) {
      lintUnreachableCode(tree, src, file, d)
    } else if (rules[i].code == ecLintShadowedLocal) {
      lintShadowedLocal(src, file, d)
    } else if (rules[i].code == ecLintAppendAliasing) {
      lintAppendAliasing(tree, src, file, d)
    } else if (rules[i].code == ecLintUnusedResult) {
      lintUnusedResult(tree, analysis.mod, file, d)
    }
    i = i + 1
  }
}

// E0200 `max-file-lines`. The finding points at the file's first byte: the
// problem is the whole file, and there is no more specific span to blame.
fn lintMaxFileLines(src: string, file: int, limit: int, d: Diagnostics) {
  let n = lintCountLines(src)
  if (n <= limit) {
    return
  }
  // The hint carries the `-- <reason>` placeholder deliberately: an override
  // form without it would teach the wrong shape and fail with exit 2 on first
  // use (§6).
  warn(d, ecLintMaxFileLines, Span{ file: file, start: 0, end: 0 },
    "file is ${n} lines, limit is ${limit}",
    "split it, or raise the limit with `// bit:lint max-file-lines=${n} -- <reason>` " +
      "in the file's leading comment block")
}

// E0201/E0202/E0203 share one AST walk over every function-shaped node — a
// `FuncDecl` (plain function or method) or an `ArrowFn` — because all three
// rules measure the same thing found the same way (spec/LINT.md §4).

// One function-shaped node's measurements: the byte offset to report at (its
// own declaration, never an inner node, so a finding points at what the author
// has to change), the `[startOff, endOff)` span `max-fn-lines` counts lines
// over, its declared parameter count, and its body node for `max-nesting`.
struct LintFuncInfo {
  reportAt: int,
  startOff: int,
  endOff: int,
  params: int,
  body: int,
}

// Every `FuncDecl`/`ArrowFn` anywhere in `node`'s subtree, nested included: a
// closure defined inside a function is its own function and is measured on
// its own, not folded into the enclosing one's counts.
fn lintCollectFuncs(tree: Tree, node: int, out: []int): []int {
  if (node == 0) {
    return out
  }
  let tag = getNode(tree, node).tag
  if (tag == Tag.FuncDecl || tag == Tag.ArrowFn) {
    out = append(out, node)
  }
  for k of kidsOf(tree, node) {
    out = lintCollectFuncs(tree, k, out)
  }
  return out
}

// `node`'s measurements. `FuncDecl` is `[recv, name, generics, params, result,
// body(, attrs)]` (compiler/parserdecl.bit): the node's own span cannot be used
// for `startOff` because an attribute (the 7th kid) sits BEFORE `function` in
// the source and would widen it past the declaration itself, so `startOff` is
// read explicitly from the receiver (if any) or the name, whichever is
// earliest — both fall on the `function` keyword's line in practice, since
// nothing else can precede them on it. `ArrowFn` has no attrs, so its own
// aggregate span (`ArrowParams` through body) is exactly right, including the
// zero-param case where `ArrowParams` contributes no span at all.
fn lintFuncInfo(tree: Tree, node: int): LintFuncInfo {
  if (getNode(tree, node).tag == Tag.ArrowFn) {
    let k = kidsOf(tree, node)
    let sp = getNode(tree, node).span
    return LintFuncInfo{ reportAt: sp.start, startOff: sp.start, endOff: sp.end,
      params: len(kidsOf(tree, k[0])), body: k[1] }
  }
  let k = kidsOf(tree, node)
  let recv = k[0]
  let start = getNode(tree, k[1]).span.start // name
  if (recv != 0) {
    start = getNode(tree, recv).span.start
  }
  let body = k[5]
  return LintFuncInfo{ reportAt: start, startOff: start, endOff: getNode(tree, body).span.end,
    params: len(kidsOf(tree, k[3])), body: body }
}

// Whether `tag` is a construct spec/LINT.md §4 counts as one nesting level:
// `if`, `while`, `for` (all four loop shapes), a `match` ARM (not the `match`
// itself — a flat 60-arm match stays at depth 1), and a `catch` that binds and
// runs a BLOCK. `catch <expr>` (`CatchDefault`) supplies a plain default value,
// introduces no block, and does not count.
fn lintOpensNesting(tag: Tag): bool {
  return tag == Tag.IfStmt || tag == Tag.WhileStmt || tag == Tag.ForC ||
    tag == Tag.ForOf || tag == Tag.ForIn || tag == Tag.ForInf ||
    tag == Tag.MatchArm || tag == Tag.CatchBind
}

// The deepest nesting reached in `node`'s subtree, starting from `depth`. Stops
// at a nested `FuncDecl`/`ArrowFn` without descending into it — that function's
// own nesting is measured separately, starting back at 0, the same boundary
// `validatestmt.bit`'s `vArrow` draws for its break/loop counters.
fn lintMaxNestingIn(tree: Tree, node: int, depth: int): int {
  if (node == 0) {
    return depth
  }
  let tag = getNode(tree, node).tag
  if (tag == Tag.FuncDecl || tag == Tag.ArrowFn) {
    return depth
  }
  if (tag == Tag.IfStmt) {
    return lintMaxNestingIf(tree, node, depth)
  }
  let childDepth = depth
  if (lintOpensNesting(tag)) {
    childDepth = depth + 1
  }
  let best = depth
  for k of kidsOf(tree, node) {
    let d = lintMaxNestingIn(tree, k, childDepth)
    if (d > best) {
      best = d
    }
  }
  return best
}

// An `if_stmt`'s own contribution to nesting depth (#2127). `if_stmt =
// [cond, thenBlk, elseBlk]` (parserstmt.bit's `parseIfStmt`): `cond` and
// `thenBlk` open a level like any other construct, but `elseBlk` is only a
// GENUINE nested block when it is one — `else { ... }` — a plain `Block`
// node. An `else if` never parses to a block at all: `parseIfStmt` stores the
// chained `if_stmt` directly as `elseBlk`, so it is walked at THIS if's own
// `depth`, continuing the chain rather than descending. Every mainstream
// linter draws the same line (clippy's `excessive_nesting`, eslint's
// `no-lonely-if`): a flat `if / else if / else if / ...` dispatch is one
// decision, not N nested ones, however many arms it has.
fn lintMaxNestingIf(tree: Tree, node: int, depth: int): int {
  let k = kidsOf(tree, node)
  let childDepth = depth + 1
  let best = lintMaxNestingIn(tree, k[0], childDepth) // cond
  let thenDepth = lintMaxNestingIn(tree, k[1], childDepth) // then block
  if (thenDepth > best) {
    best = thenDepth
  }
  let elseNode = k[2]
  if (elseNode != 0) {
    let elseDepth = 0
    if (getNode(tree, elseNode).tag == Tag.IfStmt) {
      elseDepth = lintMaxNestingIn(tree, elseNode, depth) // else-if: same depth
    } else {
      elseDepth = lintMaxNestingIn(tree, elseNode, childDepth) // plain else block
    }
    if (elseDepth > best) {
      best = elseDepth
    }
  }
  return best
}

// E0201 `max-fn-lines`: from the line of the `function` keyword (or an arrow's
// own start) through the line of its closing brace, inclusive (§4).
fn lintMaxFnLines(tree: Tree, funcs: []int, file: int, limit: int, d: Diagnostics) {
  for n of funcs {
    let info = lintFuncInfo(tree, n)
    let startLine = locate(d.sm, file, info.startOff).line
    let endLine = locate(d.sm, file, info.endOff - 1).line
    let lines = endLine - startLine + 1
    if (lines <= limit) {
      continue
    }
    warn(d, ecLintMaxFnLines, Span{ file: file, start: info.reportAt, end: info.reportAt },
      "function is ${lines} lines, limit is ${limit}",
      "split it, or raise the limit with `// bit:lint max-fn-lines=${lines} -- <reason>` " +
        "in the file's leading comment block")
  }
}

// E0202 `max-params`: declared parameters, receiver excluded — a `FuncDecl`'s
// receiver lives in its own `Receiver` kid, never in `Params`, so no
// special-casing is needed here to honour that (§4).
fn lintMaxParams(tree: Tree, funcs: []int, file: int, limit: int, d: Diagnostics) {
  for n of funcs {
    let info = lintFuncInfo(tree, n)
    if (info.params <= limit) {
      continue
    }
    warn(d, ecLintMaxParams, Span{ file: file, start: info.reportAt, end: info.reportAt },
      "function has ${info.params} params, limit is ${limit}",
      "group them into a struct, or raise the limit with `// bit:lint max-params=${info.params} -- <reason>` " +
        "in the file's leading comment block")
  }
}

// E0203 `max-nesting`: nested blocks inside a function body, the body itself
// depth 0 (§4).
fn lintMaxNesting(tree: Tree, funcs: []int, file: int, limit: int, d: Diagnostics) {
  for n of funcs {
    let info = lintFuncInfo(tree, n)
    let depth = lintMaxNestingIn(tree, info.body, 0)
    if (depth <= limit) {
      continue
    }
    warn(d, ecLintMaxNesting, Span{ file: file, start: info.reportAt, end: info.reportAt },
      "function nests ${depth} deep, limit is ${limit}",
      "add an early return, or raise the limit with `// bit:lint max-nesting=${depth} -- <reason>` " +
        "in the file's leading comment block")
  }
}

// E0204 `max-complexity`. McCabe cyclomatic complexity, measured per function
// from the AST: start at 1, add one for each `if`, `while`, `for` (any of its
// four forms), a `match` arm, a `catch` (either the bind or default form), and
// `&&`/`||`. Flat-sensitive, unlike `max-nesting`: a long `match` with many
// one-line arms scores high here while its nesting stays at 1, and a short
// function with a few nested branches can fail this while passing the line
// count — the two rules catch different failures (spec/LINT.md §4).
//
// Takes the same `Tree` `runLintRules` already parsed for the E0201/202/203
// walk — no need for its own parse. The parser recovers from malformed input
// rather than failing outright, so a file `bit check` would reject still
// yields a best-effort tree instead of this rule crashing or silently
// skipping the file — spec/LINT.md §10 open question 2 is still open on what
// `bit lint` should do with such a file, and this rule does not decide it.
fn lintMaxComplexity(t: Tree, file: int, limit: int, d: Diagnostics) {
  let decls = kidsOf(t, t.root)
  let i = 0
  while (i < len(decls)) {
    lintComplexityVisitDecl(t, decls[i], file, limit, d)
    i = i + 1
  }
}

// E0205 `defer-in-loop`. Boolean (no threshold, spec/LINT.md §4): an override
// can only `disable` it, never assign it a value — `lintRules()`'s
// `hasLimit: false` already routes that through the generic "takes no value"
// directive error.
//
// Takes the same `Tree` `runLintRules` already parsed — no need for its own
// parse.
fn lintDeferInLoop(tree: Tree, file: int, d: Diagnostics) {
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.FuncDecl) {
      let kids = kidsOf(tree, i)
      if (kids[5] != 0) {
        lintDeferWalk(tree, file, kids[5], 0, d)
      }
    }
    i = i + 1
  }
}

// Walks one function body for a `defer` lexically inside a `while`/`for`.
// `loopNode` is the nearest enclosing loop (0 outside one), carried down for
// the hint — not just a depth counter, because the message points at that
// specific loop.
//
// An `ArrowFn` resets `loopNode` to 0: a `defer` inside a closure binds to the
// CLOSURE's frame and runs when the arrow returns, not when the enclosing
// function does (spec/LINT.md §4) — so a defer directly in the arrow body must
// not fire even when the arrow itself sits inside a loop, while a defer inside
// a loop that is itself inside the arrow body still must (against that inner
// loop, never the outer one the arrow reset past). This mirrors validatestmt.bit's
// `vArrow`, which restarts `brk`/`loop` at 0 for the identical reason.
//
// Lexical scope only (spec constraint): a defer inside a function merely
// CALLED from a loop is never visited from here — this walk never follows a
// call, only the AST it was handed.
fn lintDeferWalk(t: Tree, file: int, node: int, loopNode: int, d: Diagnostics) {
  if (node == 0) {
    return
  }
  let tag = getNode(t, node).tag
  if (tag == Tag.ArrowFn) {
    for k of kidsOf(t, node) {
      lintDeferWalk(t, file, k, 0, d)
    }
    return
  }
  if (tag == Tag.DeferStmt && loopNode != 0) {
    lintReportDeferInLoop(t, file, node, loopNode, d)
  }
  let next = loopNode
  if (vIsLoop(tag)) {
    next = node
  }
  for k of kidsOf(t, node) {
    lintDeferWalk(t, file, k, next, d)
  }
}

// Reported at the `defer` keyword's span — `DeferStmt`'s span already starts
// there (parserstmt.bit), spanning the keyword plus the deferred call, so the
// keyword alone is the first 5 bytes.
fn lintReportDeferInLoop(t: Tree, file: int, deferNode: int, loopNode: int, d: Diagnostics) {
  let kwStart = getNode(t, deferNode).span.start
  let loopLine = locate(d.sm, file, getNode(t, loopNode).span.start).line + 1
  warn(d, ecLintDeferInLoop, Span{ file: file, start: kwStart, end: kwStart + 5 },
    "defer inside a loop runs at function exit, not loop exit",
    "the enclosing loop starts at line ${loopLine}")
}

// E0212 `unreachable-code`. Grouped in the E021x block for family coherence
// with its dead-weight neighbours (spec/LINT.md §4.2), but unlike them it is
// AST-only: whether a statement follows a diverging one in the same block is
// visible in the tree alone, no resolver needed.
//
// Reuses `vDiverges`/`vBlockDiverges` (validatestmt.bit) — the SAME divergence
// analysis `bit check` uses for E0055 missing-return and catch-block
// completeness — over a bare, resolver-less `Checker` (empty `symbols`/`env`,
// exactly what the dump entry points already use; see `shadowedByValue` and
// `funcRefAt`'s documented fallback). A second, hand-rolled divergence check
// would disagree with the checker's on some construct and report a finding on
// code the checker itself considers fine.
//
// `countBrk: true`, unlike missing-return's own caller: a `break`/`continue`
// always ends the rest of ITS OWN block, whether or not the enclosing
// construct is a loop — the question here is fallthrough within one block,
// not whether a function returns.
fn lintUnreachableCode(tree: Tree, src: string, file: int, d: Diagnostics) {
  let c = newChecker(tree, src, newTypeContext())
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.Block) {
      lintCheckBlockReachability(c, tree, i, file, d)
    }
    i = i + 1
  }
}

// A top-level declaration, possibly wrapped in `export`. Only `func_decl` is
// scored; everything else (types, consts, imports) has no complexity to speak
// of.
fn lintComplexityVisitDecl(t: Tree, idx: int, file: int, limit: int, d: Diagnostics) {
  if (idx == 0) {
    return
  }
  let n = getNode(t, idx)
  if (n.tag == Tag.Export) {
    let kids = kidsOf(t, idx)
    if (len(kids) > 0) {
      lintComplexityVisitDecl(t, kids[0], file, limit, d)
    }
    return
  }
  if (n.tag != Tag.FuncDecl) {
    return
  }
  // `func_decl = [recv, name, generics, params, result, body, attrs?]` (§ast.bit
  // parseFuncDecl): the body is always the 6th child.
  let body = kidsOf(t, idx)[5]
  let score = 1 + lintComplexityWalk(t, body)
  if (score <= limit) {
    return
  }
  warn(d, ecLintMaxComplexity, Span{ file: file, start: n.span.start, end: n.span.end },
    "function complexity is ${score}, limit is ${limit}",
    "split it, or raise the limit with `// bit:lint max-complexity=${score} -- <reason>` " +
      "in the file's leading comment block")
}

// The branch points inside the subtree rooted at `idx` — everything the caller
// adds to the base of 1. A `match_stmt` node itself is not a branch point, only
// its `match_arm` children are; an `if`'s `else` is not a branch point either,
// since it is not one of the counted tags (a plain `else` block just recurses
// through like any other block, and an `else if` is counted because it is its
// own `if_stmt`).
fn lintComplexityWalk(t: Tree, idx: int): int {
  if (idx == 0) {
    return 0
  }
  let n = getNode(t, idx)
  let c = 0
  if (n.tag == Tag.IfStmt || n.tag == Tag.WhileStmt || n.tag == Tag.MatchArm ||
    n.tag == Tag.ForOf || n.tag == Tag.ForIn || n.tag == Tag.ForC || n.tag == Tag.ForInf ||
    n.tag == Tag.CatchBind || n.tag == Tag.CatchDefault) {
    c = 1
  } else if (n.tag == Tag.Binary && (n.main == int(Kind.AmpAmp) || n.main == int(Kind.PipePipe))) {
    c = 1
  }
  let kids = kidsOf(t, idx)
  let i = 0
  while (i < len(kids)) {
    c = c + lintComplexityWalk(t, kids[i])
    i = i + 1
  }
  return c
}

// One finding per dead run, at the FIRST unreachable statement — not one per
// statement, and not the rest of the block, which is all equally unreachable
// once the first one is.
fn lintCheckBlockReachability(c: Checker, tree: Tree, block: int, file: int, d: Diagnostics) {
  let stmts = kidsOf(tree, block)
  let i = 0
  while (i < len(stmts)) {
    if (i + 1 < len(stmts) && vDiverges(c, stmts[i], true)) {
      let divLine = locateOffset(c.source, getNode(tree, stmts[i]).span.start).line + 1
      let sp = getNode(tree, stmts[i + 1]).span
      warn(d, ecLintUnreachableCode, Span{ file: file, start: sp.start, end: sp.end },
        "unreachable code",
        "line ${divLine} always diverts control; nothing after it in this block runs")
      return
    }
    i = i + 1
  }
}

// E0213 `shadowed-local` (spec/LINT.md §4): an inner `let`/`const` (including a
// for/catch/match binder) that hides a name already bound by an enclosing user
// scope. Runs its own private resolve pass over the bare source — the same
// no-project, no-prelude idiom `newChecker`'s dump entry points use (check.bit)
// — so this sees exactly one file's own scope tree. That pass's OWN
// diagnostics (duplicate_declaration, shadows_predeclared) are discarded here;
// only `Resolver.shadows`, `rActivateLocal`'s E0213 bookkeeping (resolve.bit),
// feeds this finding. A parameter/receiver shadowing an outer name is not in
// `r.shadows` at all — see the reasoning at its append site — and neither is a
// `let` shadowing a predeclared or prelude name, since `shadows_predeclared`
// (E0048) already reports that and this rule must not double it (§8).
fn lintShadowedLocal(src: string, file: int, d: Diagnostics) {
  let tree = parseSource(src)
  let scratchSm = newSourceManager()
  let scratchFile = addFile(scratchSm, "", src)
  let mod = SrcModule{ dir: "", fileNames: []string(0), fileStarts: [0], source: src, tree: tree,
    imports: map<string, int>{}, files: [scratchFile] }
  // #2919: `siblingScanEnabled: false` — this scratch resolve's own
  // diagnostics are discarded below (only `r.shadows` is read), and it runs
  // once per file same as `lintAnalyzeUnused` above, so the same 379-file
  // directory-reread cost applies here without it.
  let r = newResolver(newDiagnostics(scratchSm), mod, []Module(0), -1, false)
  rCollectTopLevel(r)
  rInjectPrelude(r)
  rCheckTypeCycles(r)
  rResolveBodies(r)
  let i = 0
  while (i < len(r.shadows)) {
    let h = r.shadows[i]
    let innerSpan = getNode(tree, h.inner).span
    let outerLoc = locate(d.sm, file, getNode(tree, h.outer).span.start)
    warn(d, ecLintShadowedLocal, Span{ file: file, start: innerSpan.start, end: innerSpan.end },
      "'${h.name}' shadows an outer binding of the same name",
      "outer '${h.name}' declared at ${filePath(d.sm, file)}:${outerLoc.line + 1}:${outerLoc.column + 1}")
    i = i + 1
  }
}

// E0214 `append-aliasing`. `append(s, x)` grows `s` in place and aliases its
// backing array (spec/LINT.md §4): if `s` is a slice-typed PARAMETER and the
// call's result is not assigned straight back to that same parameter, the
// caller's array may be mutated out from under it. This is the rule most
// likely to need overriding — a parameter a function genuinely owns looks
// identical, from the AST, to one the caller still holds — so it fires on the
// shape alone and leaves the judgement call to `// bit:lint disable
// append-aliasing`.
//
// Deliberately narrow (spec/LINT.md constraints): PARAMETERS only, never a
// struct field or a call result, and never an attempt to prove the caller
// actually reuses the slice afterward — that is the whole-program view this
// rule avoids. A same-named local `let` shadowing the parameter is a false
// positive this rule accepts rather than resolves (spec/LINT.md §4).
fn lintAppendAliasing(tree: Tree, src: string, file: int, d: Diagnostics) {
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.FuncDecl) {
      lintAppendAliasingFunc(tree, src, file, i, d)
    }
    i = i + 1
  }
}

// `func_decl = [recv, name, generics, params, result, body(, attrs)]`
// (compiler/parserdecl.bit): params is kid 3, the body block is kid 5.
fn lintAppendAliasingFunc(tree: Tree, src: string, file: int, funcNode: int, d: Diagnostics) {
  let k = kidsOf(tree, funcNode)
  let names = lintSliceParamNames(tree, src, k[3])
  if (len(names) == 0) {
    return
  }
  let protected = lintProtectedAppends(tree, src, k[5], []int(0))
  lintFindAppendAliasing(tree, src, file, k[5], names, protected, d)
}

// The names of `params`' slice-typed parameters (`param = [name, type]`,
// compiler/parserdecl.bit). A method receiver is never in this list — it is
// not a kid of `params` at all — so it can never be flagged.
fn lintSliceParamNames(tree: Tree, src: string, params: int): []string {
  let out = []string(0)
  for pn of kidsOf(tree, params) {
    if (getNode(tree, pn).tag != Tag.Param) {
      continue // a `...rest` param is excluded; its ownership rules differ
    }
    let pk = kidsOf(tree, pn)
    if (getNode(tree, pk[1]).tag == Tag.SliceType) {
      let nm = getNode(tree, pk[0]).span
      out = append(out, src[nm.start:nm.end])
    }
  }
  return out
}

// True iff `node` is a `call` whose callee is the bare identifier `append`.
fn lintIsAppendCall(tree: Tree, src: string, node: int): bool {
  if (getNode(tree, node).tag != Tag.Call) {
    return false
  }
  let callee = getNode(tree, kidsOf(tree, node)[0])
  if (callee.tag != Tag.Ident) {
    return false
  }
  return src[callee.span.start:callee.span.end] == "append"
}

// The name `append`'s first argument resolves to, or "" if it is not a bare
// identifier (`append(f(), x)` can never alias a parameter this rule can
// name). `args` holds `arg`/`arg_spread` nodes each wrapping one expression
// (compiler/parser.bit's `parseArgItem`).
fn lintAppendFirstArgName(tree: Tree, src: string, node: int): string {
  let argKids = kidsOf(tree, kidsOf(tree, node)[2])
  if (len(argKids) == 0) {
    return ""
  }
  let expr = getNode(tree, kidsOf(tree, argKids[0])[0])
  if (expr.tag != Tag.Ident) {
    return ""
  }
  return src[expr.span.start:expr.span.end]
}

// Every `append` call node, anywhere under `node`, whose result is assigned
// straight back to the same name it was called on — `p = append(p, x)` — and
// so must not be flagged. Only this exact shape counts: routing the result
// through a temporary before reassigning is indistinguishable, from the AST,
// from never reassigning it at all, so it is not specially recognised either
// (accepted per spec/LINT.md — override, don't chase the flow).
fn lintProtectedAppends(tree: Tree, src: string, node: int, out: []int): []int {
  if (node == 0) {
    return out
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.Assign) {
    let k = kidsOf(tree, node)
    let lhs = kidsOf(tree, k[0])
    let rhs = kidsOf(tree, k[1])
    let i = 0
    while (i < len(lhs) && i < len(rhs)) {
      let lhsNode = getNode(tree, lhs[i])
      if (lhsNode.tag == Tag.Ident && lintIsAppendCall(tree, src, rhs[i])) {
        let lhsName = src[lhsNode.span.start:lhsNode.span.end]
        if (lintAppendFirstArgName(tree, src, rhs[i]) == lhsName) {
          out = append(out, rhs[i])
        }
      }
      i = i + 1
    }
  }
  for kid of kidsOf(tree, node) {
    out = lintProtectedAppends(tree, src, kid, out)
  }
  return out
}

// Reports every unprotected `append` call in `node`'s subtree whose first
// argument is one of `names` (this function's slice-typed parameters).
fn lintFindAppendAliasing(tree: Tree, src: string, file: int, node: int,
  names: []string, protected: []int, d: Diagnostics) {
  if (node == 0) {
    return
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.Call && lintIsAppendCall(tree, src, node) && !lintContainsInt(protected, node)) {
    let argName = lintAppendFirstArgName(tree, src, node)
    if (argName != "" && lintContainsString(names, argName)) {
      warn(d, ecLintAppendAliasing, n.span,
        "append on parameter '${argName}' may alias the caller's backing array",
        "if '${argName}' is owned by this function, silence with `// bit:lint disable append-aliasing -- <reason>` " +
          "in the file's leading comment block; otherwise assign the result back: ${argName} = append(${argName}, ...)")
    }
  }
  for kid of kidsOf(tree, node) {
    lintFindAppendAliasing(tree, src, file, kid, names, protected, d)
  }
}

fn lintContainsInt(xs: []int, v: int): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == v) {
      return true
    }
    i = i + 1
  }
  return false
}

fn lintContainsString(xs: []string, v: string): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == v) {
      return true
    }
    i = i + 1
  }
  return false
}

