fn emMachoGlobals(
  module: IrModule, data: ByteBuf, freestanding: bool, cellBinding: MachoBinding, acc: EmMachoDbgLines,
): int {
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  // #2949: an all-zero cell (the common case for a large scratch buffer, e.g.
  // stdlib/http/trustcache.bit's trust-cache buffer) goes to __bss, a
  // S_ZEROFILL section the loader zero-maps with no file bytes at all, instead
  // of writing its full size into __data.
  let mgs = placeGlobals(module, 0, data, freestanding, true)
  let gi = 0
  while (gi < len(mgs.data)) {
    let gsym = emMac(mgs.data[gi].name)
    symbols = append(
      symbols,
      MachoSymbol{
        name = gsym, hasSection = true,
        section = MachoSectionKind.Data, offset = mgs.data[gi].offset,
        size = mgs.data[gi].size, binding = cellBinding,
      },
    )
    defined[gsym] = true
    gi = gi + 1
  }
  relocs = machoFixups(data, mgs.fixups, MachoSectionKind.Data, relocs)
  let bi = 0
  while (bi < len(mgs.bss)) {
    let bsym = emMac(mgs.bss[bi].name)
    symbols = append(
      symbols,
      MachoSymbol{
        name = bsym, hasSection = true,
        section = MachoSectionKind.Bss, offset = mgs.bss[bi].offset,
        size = mgs.bss[bi].size, binding = cellBinding,
      },
    )
    defined[bsym] = true
    bi = bi + 1
  }

  acc.symbols = symbols
  acc.relocs = relocs
  acc.defined = defined
  return mgs.bssSize
}

fn emMachoReadonlyGlobals(
  module: IrModule, rodata: ByteBuf, freestanding: bool, cellBinding: MachoBinding, acc: EmMachoDbgLines,
): EmMachoDbgLines {
  let symbols = acc.symbols
  let relocs = acc.relocs
  let defined = acc.defined
  // ---- read-only module state (§11.11) -> the same __rodata --------------
  // Two format differences from the ELF path, both silent wrongness if missed:
  //   1. every symbol name is `_`-prefixed, on the REFERENCE as well as on the
  //      definition — an unprefixed target would resolve against nothing;
  //   2. Mach-O relocations carry NO addend field; the addend lives in the field
  //      bytes and the reader takes it back out from there. So it is written
  //      into the image here, where ELF leaves the image untouched.
  let ro = placeReadonlyGlobals(module, rodata, freestanding)
  for rp of ro.placements {
    let rsym = emMac(rp.name)
    symbols = append(
      symbols,
      MachoSymbol{
        name = rsym, hasSection = true,
        section = MachoSectionKind.Rodata, offset = rp.offset, size = rp.size,
        binding = cellBinding,
      },
    )
    defined[rsym] = true
  }
  relocs = machoFixups(rodata, ro.fixups, MachoSectionKind.Rodata, relocs)

  acc.symbols = symbols
  acc.relocs = relocs
  acc.defined = defined
  return acc
}

fn emMachoMetaSections(
  code: ByteBuf, gc: ByteBuf, dbg: ByteBuf,
): []MachoSection {
  let sections = [
    // #7843: every function atom the linker places is a64FuncAlign()-aligned,
    // so a loop header a64BlockStart (arm64layout.bit) aligns is aligned in
    // memory.
    MachoSection{
      kind = MachoSectionKind.Text, data = code.bytes,
      size = 0, alignment = a64FuncAlign(),
    },
  ]
  if (len(gc.bytes) > 0) {
    // 8-aligned (#1927) — see the ELF path: `writeStackMaps` pads every entry
    // to a multiple of 8, so every atom's length is already a multiple of 8
    // and the linker never needs to insert padding of its own to honor this;
    // there is no gap for the walk to misread as an entry.
    sections = append(
      sections,
      MachoSection{
        kind = MachoSectionKind.GcMeta,
        data = gc.bytes, size = 0, alignment = 8,
      },
    )
  }
  if (len(dbg.bytes) > 0) {
    // 8-aligned: writeDebugLines' 24-byte header and 16-byte rows are already
    // multiples of 8, so this needs no padding step either — see its comment.
    sections = append(
      sections,
      MachoSection{
        kind = MachoSectionKind.DbgMeta,
        data = dbg.bytes, size = 0, alignment = 8,
      },
    )
  }
  return sections
}

fn emMachoReadonlySection(
  module: IrModule, rodata: ByteBuf, freestanding: bool, sections: []MachoSection,
): []MachoSection {
  if (len(rodata.bytes) > 0) {
    sections = append(
      sections,
      MachoSection{
        kind = MachoSectionKind.Rodata,
        data = rodata.bytes, size = 0,
        alignment = globalsAlign(module, storageReadonly(), freestanding),
      },
    )
  }
  return sections
}

fn emMachoWritableSections(
  module: IrModule, data: ByteBuf, freestanding: bool, bssSize: int, sections: []MachoSection,
): []MachoSection {
  if (len(data.bytes) > 0) {
    sections = append(
      sections,
      MachoSection{
        kind = MachoSectionKind.Data,
        data = data.bytes, size = 0, alignment = globalsAlign(module, 0, freestanding),
      },
    )
  }
  if (bssSize > 0) {
    // No `data` bytes at all — machoSectionBytes reads `size` for Bss, and the
    // writer refuses a duplicate section kind, so this must be the only
    // MachoSectionKind.Bss entry.
    sections = append(
      sections,
      MachoSection{
        kind = MachoSectionKind.Bss,
        data = []u8(0), size = bssSize, alignment = globalsAlignBss(module, 0, freestanding),
      },
    )
  }
  return sections
}
