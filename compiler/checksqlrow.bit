// compiler/checksqlrow.bit — how `find<T>`/`findOne<T>`/`findOneOrFail<T>`
// (stdlib/sql/row.bit, #5054) resolve `T` and what they refuse.
//
// THE SAME SHAPE `jsonDecode<T>` TAKES (classjsondecodecall.bit), for the
// identical reason: `T` is a different class at every call and the row
// extraction has to name that class's fields, so the template body in
// stdlib/sql/row.bit can never run — this file rewrites each call in
// `resolveProject`, before any Checker exists, into a call to the shared
// generic driver (`sqlFindMany`/`sqlFindOne`/`sqlFindOneOrFail`) with the
// mapper synthesised for the concrete `T` passed in as a value
// (checksqlrowbuild.bit does the synthesis and the rewrite).
//
// NO CLASS-LEVEL MARK. Unlike `@json`/`@table`, `T` needs no attribute: the
// discriminator is the `find<T>` CALL SITE itself, demand-driven exactly the
// way `jsonDecode<T>`'s decoder need-list already is — a class nobody passes
// to `find`/`findOne`/`findOneOrFail` gets no mapper (owner decision, #5054).
//
// `T` IS EITHER a plain class (refusing one that declares `init` — E0152,
// the reasoning is stdlib/sql/row.bit's header comment), or one of the five
// scalar types `i64`/`f64`/`bool`/`string`/`[]byte` for a single-column
// result, matched by one of stdlib/sql/row.bit's own `sqlRowScalar*`
// functions rather than a synthesised mapper. Anything else is E0151.
//
// COLUMN NAMES ARE SYNTACTIC, decided here rather than at runtime: a field's
// own name in snake_case, or the text of its `@column("...")` override
// (classjson.bit's `classAttrColumn`, excluded from #3879's ordinary
// call-desugaring). A field whose declared type is not one of the five
// scalars, or `Option<>` of one, is E0154.

// E0151 (§10.5): `find<T>`/`findOne<T>`/`findOneOrFail<T>` where `T` is not a
// class this can map a row into, and not one of the accepted scalar types.
const ecSqlRowType = 151

// E0152 (§10.5): `T` declares `init`, naming both. The generated mapper
// assigns fields directly (stdlib/sql/row.bit's header comment).
const ecSqlRowInitDeclared = 152

// E0153 (§10.5): the class's own module does not import `Rows` from
// "std/sql" — the one name the synthesised mapper's signature is written in
// terms of. The same shape `@json`'s E0142 and `@table`'s E0150 take, for the
// same reason: one diagnostic naming the import rather than a cascade of
// undefined-name errors against a signature nobody wrote.
const ecSqlRowImportMissing = 153

// E0154 (§10.5): a field of a row-mapped class has a type this cannot claim a
// column with — not `i64`/`f64`/`bool`/`string`/`[]byte`, and not `Option<>`
// of one of those.
const ecSqlRowFieldType = 154

// E0155 (§10.5): a field's `@column(...)` argument is not exactly one string
// constant — the same shape `@key`'s own E0143-style check takes
// (classjson.bit's `reportKeyArgs`), for a mark this file owns instead.
const ecSqlRowColumnArg = 155

// The mapper name synthesized for one class — shared by the collector
// (which records it in a `SqlRowNeed`) and the builder (which defines and
// calls it), so the two can never spell it differently.
fn sqlRowMapperName(className: string): string {
  return "__sql_row_${className}"
}

const sqlFindFuncName = "find"
const sqlFindOneFuncName = "findOne"
const sqlFindOneOrFailFuncName = "findOneOrFail"
const sqlRowModulePath = "std/sql"

// The three entry points, as one small int so a `SqlRowSite`/`SqlRowCallNode`
// carries "which of the three" without three parallel bool fields.
const sqlEntryFind = 0
const sqlEntryFindOne = 1
const sqlEntryFindOneOrFail = 2

// A field's scalar kind, or `sqlKindBad` for anything this cannot claim a
// column with. Zero is BAD (not a valid kind) so a zero-valued `SqlRowField`
// reads as "unresolved" rather than silently "Int".
const sqlKindBad = 0
const sqlKindInt = 1
const sqlKindFloat = 2
const sqlKindBool = 3
const sqlKindString = 4
const sqlKindBlob = 5

// The generic driver `checksqlrowbuild.bit` rewrites a call to, per entry.
fn sqlDriverFuncName(entry: int): string {
  if (entry == sqlEntryFind) {
    return "sqlFindMany"
  }
  if (entry == sqlEntryFindOne) {
    return "sqlFindOne"
  }
  return "sqlFindOneOrFail"
}

// The pre-written stdlib/sql/row.bit function used as the `mapper` argument
// when `T` is a plain scalar rather than a class — no synthesis needed, the
// same function regardless of which of the three entry points is called.
fn sqlScalarMapperName(kind: int): string {
  if (kind == sqlKindInt) {
    return "sqlRowScalarInt"
  }
  if (kind == sqlKindFloat) {
    return "sqlRowScalarFloat"
  }
  if (kind == sqlKindBool) {
    return "sqlRowScalarBool"
  }
  if (kind == sqlKindString) {
    return "sqlRowScalarText"
  }
  return "sqlRowScalarBlob"
}

// The accessor stdlib/sql/row.bit exports for one field: required or
// `Option`, by scalar kind. The full fixed set — every name, regardless of
// which a given module's fields actually use — is what gets imported,
// mirroring `jsonDecHelperNames()`'s reasoning (classjsondecodeimports.bit).
fn sqlFieldAccessorNames(): []string {
  return [
    "sqlReqInt", "sqlReqFloat", "sqlReqBool", "sqlReqText", "sqlReqBlob",
    "sqlOptInt", "sqlOptFloat", "sqlOptBool", "sqlOptText", "sqlOptBlob",
  ]
}

fn sqlFieldAccessorName(kind: int, optional: bool): string {
  if (optional) {
    return sqlOptAccessorName(kind)
  }
  return sqlReqAccessorName(kind)
}

fn sqlReqAccessorName(kind: int): string {
  if (kind == sqlKindInt) {
    return "sqlReqInt"
  }
  if (kind == sqlKindFloat) {
    return "sqlReqFloat"
  }
  if (kind == sqlKindBool) {
    return "sqlReqBool"
  }
  if (kind == sqlKindString) {
    return "sqlReqText"
  }
  return "sqlReqBlob"
}

fn sqlOptAccessorName(kind: int): string {
  if (kind == sqlKindInt) {
    return "sqlOptInt"
  }
  if (kind == sqlKindFloat) {
    return "sqlOptFloat"
  }
  if (kind == sqlKindBool) {
    return "sqlOptBool"
  }
  if (kind == sqlKindString) {
    return "sqlOptText"
  }
  return "sqlOptBlob"
}

// ---- field type classification --------------------------------------------

// The scalar kind a syntactic type node names: `i64`/`int` (aliases, SPEC
// §12.2), `f64`, `bool`, `string`, or `[]byte`/`[]u8`. `sqlKindBad` for
// anything else, including `f32` and every other integer width — `find<T>`
// accepts exactly the five SPEC lists, not every numeric type Bit has.
fn classifySqlScalar(tree: Tree, source: string, typeNode: int): int {
  let n = getNode(tree, typeNode)
  if (n.tag == Tag.Ident) {
    return classifySqlScalarName(source[n.span.start:n.span.end])
  }
  if (n.tag == Tag.SliceType) {
    let elem = getNode(tree, kidsOf(tree, typeNode)[0])
    if (elem.tag == Tag.Ident) {
      let ename = source[elem.span.start:elem.span.end]
      if (ename == "byte" || ename == "u8") {
        return sqlKindBlob
      }
    }
  }
  return sqlKindBad
}

// The scalar kind a bare type NAME spells, split out of `classifySqlScalar`
// to keep it under LINT.md's max-complexity.
fn classifySqlScalarName(name: string): int {
  if (name == "i64" || name == "int") {
    return sqlKindInt
  }
  if (name == "f64") {
    return sqlKindFloat
  }
  if (name == "bool") {
    return sqlKindBool
  }
  if (name == "string") {
    return sqlKindString
  }
  return sqlKindBad
}

// A field's type: its scalar kind and whether it is wrapped in `Option<>`.
// `(sqlKindBad, false)` for anything this cannot claim a column with —
// `Option<Option<T>>`, a nested class, `[]int`, a map, all included.
fn classifySqlFieldType(tree: Tree, source: string, typeNode: int): (int, bool) {
  let n = getNode(tree, typeNode)
  if (n.tag != Tag.GenericInst) {
    return (classifySqlScalar(tree, source, typeNode), false)
  }
  let k = kidsOf(tree, typeNode)
  if (getNode(tree, k[0]).tag != Tag.Ident) {
    return (sqlKindBad, false)
  }
  let base = source[getNode(tree, k[0]).span.start:getNode(tree, k[0]).span.end]
  let targs = kidsOf(tree, k[1])
  if (base != "Option" || len(targs) != 1) {
    return (sqlKindBad, false)
  }
  return (classifySqlScalar(tree, source, targs[0]), true)
}

// ---- resolving a class T ---------------------------------------------------

// Where the class named `name` is declared, as far as `find<T>` cares: which
// module, its `StructDecl`, whether it is exported, and the path this module
// reaches it by ("" when local). Mirrors classjsondecodecall.bit's
// `jsonClassSiteOf`/`importedClassSite`, without the `@json` mark test —
// `find<T>` accepts ANY plain class.
class SqlClassSite {
  mod: int,
  decl: int,
  name: string,
  path: string,
  exported: bool,
  found: bool,
}

fn sqlClassSiteMiss(): SqlClassSite {
  return SqlClassSite{ mod: -1, decl: 0, name: "", path: "", exported: false, found: false }
}

// The top-level class declared `name` in this module, or a `TopClass` whose
// `decl` is 0.
fn sqlLocalClass(tree: Tree, source: string, name: string): TopClass {
  for tc of topClassDecls(tree) {
    if (identText(tree, source, kidsOf(tree, tc.decl)[0]) == name) {
      return tc
    }
  }
  return TopClass{ decl: 0, exported: false }
}

fn sqlClassSiteOf(p: Project, mid: int, name: string): SqlClassSite {
  let m = p.mods[mid]
  let local = sqlLocalClass(m.tree, m.source, name)
  if (local.decl != 0) {
    return SqlClassSite{
      mod: mid, decl: local.decl, name: name, path: "", exported: local.exported, found: true,
    }
  }
  return sqlImportedClassSite(p, m, name)
}

// `name`, imported into `m` by name (following the import to its target
// module's own top-level class). Only the `{ a, b as c }` form is followed —
// a namespace import binds `ns`, and a type reached that way is a
// `QualType`, refused by shape at the call site (`resolveSqlTypeArg`).
fn sqlImportedClassSite(p: Project, m: SrcModule, name: string): SqlClassSite {
  for d of kidsOf(m.tree, m.tree.root) {
    if (d == 0 || getNode(m.tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(m.tree, d)
    if (getNode(m.tree, k[0]).tag != Tag.ImportGroup) {
      continue
    }
    for item of kidsOf(m.tree, k[0]) {
      if (importItemLocalName(m.tree, m.source, item) != name) {
        continue
      }
      return sqlImportedClassAt(p, m, k[1], item)
    }
  }
  return sqlClassSiteMiss()
}

// The class one resolved `ImportItem` names, once its target module is
// known. Split out of `sqlImportedClassSite` to keep that loop's body a
// single statement (LINT.md max-complexity).
fn sqlImportedClassAt(p: Project, m: SrcModule, pathNode: int, item: int): SqlClassSite {
  let path = stringLitText(m.source, getNode(m.tree, pathNode).span)
  let (tid, ok) = m.imports[path]
  if (!ok || tid < 0 || tid >= len(p.mods)) {
    return sqlClassSiteMiss()
  }
  let exported = identText(m.tree, m.source, kidsOf(m.tree, item)[0])
  let target = p.mods[tid]
  let tc = sqlLocalClass(target.tree, target.source, exported)
  if (tc.decl == 0) {
    return sqlClassSiteMiss()
  }
  return SqlClassSite{
    mod: tid, decl: tc.decl, name: exported, path: path, exported: tc.exported, found: true,
  }
}

// ---- resolving the type argument ------------------------------------------

// What one `find<T>`/`findOne<T>`/`findOneOrFail<T>` call's type argument
// resolves to: a scalar kind, or a class site — never both, `ok` false after
// a diagnostic was already reported when neither.
class SqlTypeArgResolved {
  scalarKind: int,
  classSite: SqlClassSite,
  ok: bool,
}

fn sqlTypeArgBad(): SqlTypeArgResolved {
  return SqlTypeArgResolved{ scalarKind: sqlKindBad, classSite: sqlClassSiteMiss(), ok: false }
}

// `targ`'s scalar kind (`Ident`/`SliceType` only — `SPEC §12.2` never allows a
// scalar type to be anything else), or `sqlKindBad`.
fn sqlTypeArgScalarKind(tree: Tree, source: string, targ: int): int {
  let tag = getNode(tree, targ).tag
  if (tag == Tag.Ident || tag == Tag.SliceType) {
    return classifySqlScalar(tree, source, targ)
  }
  return sqlKindBad
}

fn resolveSqlTypeArg(p: Project, mid: int, targ: int, fname: string): SqlTypeArgResolved {
  let m = p.mods[mid]
  let sk = sqlTypeArgScalarKind(m.tree, m.source, targ)
  if (sk != sqlKindBad) {
    return SqlTypeArgResolved{ scalarKind: sk, classSite: sqlClassSiteMiss(), ok: true }
  }
  if (getNode(m.tree, targ).tag != Tag.Ident) {
    reportSqlRowType(p, m, targ, "is not a class or a supported scalar type", fname)
    return sqlTypeArgBad()
  }
  let name = identText(m.tree, m.source, targ)
  let site = sqlClassSiteOf(p, mid, name)
  if (!site.found) {
    reportSqlRowType(
      p, m, targ, "is not declared in this module and is not imported from another by name",
      fname,
    )
    return sqlTypeArgBad()
  }
  return sqlValidatedClassArg(p, m, targ, site, fname)
}

// The `init`/field-type checks a resolved class site still owes before a
// `find<T>` call may use it — split out of `resolveSqlTypeArg` to keep that
// function's own body under LINT.md's max-complexity.
fn sqlValidatedClassArg(
  p: Project, m: SrcModule, targ: int, site: SqlClassSite, fname: string,
): SqlTypeArgResolved {
  let initNode = declaredMember(m.tree, m.source, kidsOf(m.tree, site.decl)[2], "init")
  if (initNode != 0) {
    reportSqlRowInitDeclared(p, m, targ, site, initNode)
    return sqlTypeArgBad()
  }
  if (!sqlValidateClassFields(p, site)) {
    return sqlTypeArgBad()
  }
  return SqlTypeArgResolved{ scalarKind: sqlKindBad, classSite: site, ok: true }
}

// Every field of `site`'s class has a type `find<T>` can claim a column
// with — reported per field (E0154) rather than once for the class, so a
// class with two bad fields gets two diagnostics naming each.
fn sqlValidateClassFields(p: Project, site: SqlClassSite): bool {
  let target = p.mods[site.mod]
  let ok = true
  for m0 of kidsOf(target.tree, kidsOf(target.tree, site.decl)[2]) {
    let f = memberField(target.tree, m0)
    if (f == 0) {
      continue
    }
    let typeNode = kidsOf(target.tree, f)[1]
    let (kind, _) = classifySqlFieldType(target.tree, target.source, typeNode)
    if (kind == sqlKindBad) {
      reportSqlRowFieldType(p, target, f)
      ok = false
    }
  }
  return ok
}

fn reportSqlRowFieldType(p: Project, m: SrcModule, field: int) {
  let k = kidsOf(m.tree, field)
  let fname = identText(m.tree, m.source, k[0])
  let tspan = getNode(m.tree, k[1]).span
  let tname = m.source[tspan.start:tspan.end]
  report(
    p.diags, ecSqlRowFieldType, tspan,
    "field '${fname}' has type '${tname}', which a row mapper cannot claim a column with",
    "a row-mapped field is 'i64'/'f64'/'bool'/'string'/'[]byte', or 'Option<>' of one of those",
  )
}

fn reportSqlRowType(p: Project, m: SrcModule, targ: int, why: string, fname: string) {
  let tname = m.source[getNode(m.tree, targ).span.start:getNode(m.tree, targ).span.end]
  report(
    p.diags, ecSqlRowType, getNode(m.tree, targ).span,
    "'${fname}' cannot map a row into '${tname}': it ${why}",
    "'${fname}<T>' maps into a plain class, or one of 'i64'/'f64'/'bool'/'string'/'[]byte' for a single-column result",
  )
}

fn reportSqlRowInitDeclared(
  p: Project,
  m: SrcModule,
  targ: int,
  site: SqlClassSite,
  initNode: int,
) {
  let cname = site.name
  let iname = identText(p.mods[site.mod].tree, p.mods[site.mod].source, initNode)
  report(
    p.diags, ecSqlRowInitDeclared, getNode(m.tree, targ).span,
    "'${cname}' declares '${iname}', so a row mapper cannot construct it: the mapper assigns fields directly, bypassing whatever '${iname}' enforces",
    "map into a plain projection class instead, and construct '${cname}' through '${iname}' yourself",
  )
}

// ---- finding the calls ------------------------------------------------------

// The local names this module binds `find`/`findOne`/`findOneOrFail` to, by
// import from "std/sql" — "" for whichever it does not import. Only the
// `{ a, b as c }` form is matched, the same scope cut classtabledesc.bit's
// own import test makes: a namespace import is not followed here.
class SqlRowBindings {
  find: string,
  findOne: string,
  findOneOrFail: string,
}

fn sqlRowBindingsOf(tree: Tree, source: string): SqlRowBindings {
  let out = SqlRowBindings{ find: "", findOne: "", findOneOrFail: "" }
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(tree, d)
    if (stringLitText(source, getNode(tree, k[1]).span) != sqlRowModulePath) {
      continue
    }
    if (getNode(tree, k[0]).tag != Tag.ImportGroup) {
      continue
    }
    absorbSqlRowBindings(tree, source, k[0], out)
  }
  return out
}

fn absorbSqlRowBindings(tree: Tree, source: string, group: int, out: SqlRowBindings) {
  for item of kidsOf(tree, group) {
    let exported = identText(tree, source, kidsOf(tree, item)[0])
    let local = importItemLocalName(tree, source, item)
    if (exported == sqlFindFuncName) {
      out.find = local
    }
    if (exported == sqlFindOneFuncName) {
      out.findOne = local
    }
    if (exported == sqlFindOneOrFailFuncName) {
      out.findOneOrFail = local
    }
  }
}

fn sqlRowBindsAny(b: SqlRowBindings): bool {
  return b.find != "" || b.findOne != "" || b.findOneOrFail != ""
}

// One `find`/`findOne`/`findOneOrFail` call node, by arena index, and which
// entry point it is.
class SqlRowCallNode {
  node: int,
  entry: int,
}

// Every call in the module to a name `b` binds, found by a whole-arena sweep
// — the same shape `jsonDecodeCallNodes` (classjsondecodecall.bit) takes, for
// the same reason: a call can sit anywhere an expression can.
fn sqlRowCallNodes(tree: Tree, source: string, b: SqlRowBindings): []SqlRowCallNode {
  let out = []SqlRowCallNode(0)
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.Call) {
      let entry = sqlRowCallEntry(tree, source, kidsOf(tree, i)[0], b)
      if (entry >= 0) {
        out = append(out, SqlRowCallNode{ node: i, entry: entry })
      }
    }
    i = i + 1
  }
  return out
}

// Which entry point `callee` names, or -1 when it names none of the three —
// matched by IMPORT (via `b`), never by bare spelling: a user's own `find`
// is a different function and must not be rewritten.
fn sqlRowCallEntry(tree: Tree, source: string, callee: int, b: SqlRowBindings): int {
  if (callee == 0 || getNode(tree, callee).tag != Tag.Ident) {
    return -1
  }
  let name = identText(tree, source, callee)
  if (b.find != "" && name == b.find) {
    return sqlEntryFind
  }
  if (b.findOne != "" && name == b.findOne) {
    return sqlEntryFindOne
  }
  if (b.findOneOrFail != "" && name == b.findOneOrFail) {
    return sqlEntryFindOneOrFail
  }
  return -1
}

// The single type argument written at a call, or 0 when the call does not
// have exactly one — zero or two is an ordinary generic-arity error on the
// template, left to the checker (mirrors `jsonDecodeTypeArg`).
fn sqlRowTypeArg(tree: Tree, n: int): int {
  let targs = kidsOf(tree, n)[1]
  if (targs == 0) {
    return 0
  }
  let list = kidsOf(tree, targs)
  if (len(list) != 1) {
    return 0
  }
  return list[0]
}

// ---- the project-wide demand ------------------------------------------------

// One resolved call to rewrite: where it is, which entry point, and what it
// maps into — a scalar kind, or a class (`classMod < 0` for a scalar site).
class SqlRowSite {
  callerMod: int,
  callNode: int,
  entry: int,
  scalarKind: int,
  classMod: int,
  className: string,
  path: string,
}

// One class some module needs a mapper for: `needMod` calls it, `classMod`
// declares it. `needMod == classMod` is what makes a module BUILD the
// mapper; any other `needMod` only makes it IMPORT one (mirrors
// `JsonDecodeNeed`, classjsondecodecall.bit).
class SqlRowNeed {
  needMod: int,
  classMod: int,
  className: string,
  path: string,
}

class SqlRowDemand {
  sites: []SqlRowSite,
  needs: []SqlRowNeed,
}

fn sqlRowNeedExists(needs: []SqlRowNeed, needMod: int, classMod: int, name: string): bool {
  for n of needs {
    if (n.needMod == needMod && n.classMod == classMod && n.className == name) {
      return true
    }
  }
  return false
}

fn addSqlRowNeed(d: SqlRowDemand, needMod: int, site: SqlClassSite) {
  if (!sqlRowNeedExists(d.needs, needMod, site.mod, site.name)) {
    d.needs = append(
      d.needs, SqlRowNeed{
        needMod: needMod,
        classMod: site.mod,
        className: site.name,
        path: site.path,
      },
    )
  }
}

// Every `find<T>`/`findOne<T>`/`findOneOrFail<T>` call in the project,
// resolved. Runs before any module is modified, exactly like
// `collectJsonDecodeDemand`: a mapper is synthesized only for a class
// something actually maps a row into.
fn collectSqlRowDemand(p: Project): SqlRowDemand {
  let d = SqlRowDemand{ sites: []SqlRowSite(0), needs: []SqlRowNeed(0) }
  let i = 0
  while (i < len(p.mods)) {
    let before = len(p.diags.list)
    collectModuleSqlRowSites(p, i, d)
    remapDiags(p.diags, before, p.mods[i].files, p.mods[i].fileStarts)
    i = i + 1
  }
  return d
}

fn collectModuleSqlRowSites(p: Project, mid: int, d: SqlRowDemand) {
  let m = p.mods[mid]
  let b = sqlRowBindingsOf(m.tree, m.source)
  if (!sqlRowBindsAny(b)) {
    return
  }
  for cn of sqlRowCallNodes(m.tree, m.source, b) {
    resolveSqlRowCall(p, mid, cn, d)
  }
}

// One call site, resolved and recorded — or left unrecorded after a
// diagnostic when its type argument is missing or does not resolve. A wrong
// ARGUMENT count is an ordinary arity error against the template's own
// signature, left to the checker.
fn resolveSqlRowCall(p: Project, mid: int, cn: SqlRowCallNode, d: SqlRowDemand) {
  let m = p.mods[mid]
  // Fewer than the two required (`db`, `sqlText`) args is left to the
  // checker's own arity diagnostic against the template signature — the
  // rewrite (checksqlrowbuild.bit's `rewriteSqlRowCall`) assumes at least
  // two are there.
  if (len(kidsOf(m.tree, kidsOf(m.tree, cn.node)[2])) < 2) {
    return
  }
  let fname = sqlEntryFuncName(cn.entry)
  let targ = sqlRowTypeArg(m.tree, cn.node)
  if (targ == 0) {
    reportSqlRowArity(p, m, cn.node, fname)
    return
  }
  let resolved = resolveSqlTypeArg(p, mid, targ, fname)
  if (!resolved.ok) {
    return
  }
  if (resolved.scalarKind != sqlKindBad) {
    d.sites = append(
      d.sites,
      SqlRowSite{
        callerMod: mid, callNode: cn.node, entry: cn.entry, scalarKind: resolved.scalarKind,
        classMod: -1, className: "", path: "",
      },
    )
    return
  }
  let site = resolved.classSite
  d.sites = append(
    d.sites,
    SqlRowSite{
      callerMod: mid, callNode: cn.node, entry: cn.entry, scalarKind: sqlKindBad,
      classMod: site.mod, className: site.name, path: site.path,
    },
  )
  addSqlRowNeed(d, mid, site)
  if (mid != site.mod) {
    addSqlRowNeed(d, site.mod, site)
  }
}

fn sqlEntryFuncName(entry: int): string {
  if (entry == sqlEntryFind) {
    return sqlFindFuncName
  }
  if (entry == sqlEntryFindOne) {
    return sqlFindOneFuncName
  }
  return sqlFindOneOrFailFuncName
}

// `find(j)` with no type argument, or with two. `T` appears only in the
// result, so nothing can infer it from the arguments (mirrors
// `reportJsonDecodeArity`, classjsondecodecall.bit).
fn reportSqlRowArity(p: Project, m: SrcModule, call: int, fname: string) {
  report(
    p.diags, ecSqlRowType, getNode(m.tree, call).span,
    "'${fname}' needs exactly one explicit type argument",
    "write '${fname}<T>(...)' naming the class or scalar type to map a row into — 'T' appears only in the result, so nothing infers it from the arguments",
  )
}

// The classes THIS module must synthesize a mapper for: the ones demanded of
// it that it also declares (mirrors `moduleDecodeClasses`,
// classjsondecodecall.bit).
fn moduleSqlRowNeeds(d: SqlRowDemand, mid: int): []SqlRowNeed {
  let out = []SqlRowNeed(0)
  for n of d.needs {
    if (n.needMod == mid && n.classMod == mid) {
      out = append(out, n)
    }
  }
  return out
}
