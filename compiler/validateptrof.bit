// Self-host: validation of `ptrOf` (§11.5), split out of validateunmanaged.bit
// (#7676) to keep that file under the line ceiling. The atomics, inline
// assembly and external-function rules stay there.

// Module-level state (§11.11) is addressable: its cell has a static address,
// so this is the addressability the atomic builtins need. Restricted to
// module scope on purpose — a local has no stable address to hand out, which
// is exactly why `&` stays reserved. Split out of `vPtrOfCall` to keep it
// under the complexity ceiling once #5921 added the string branch there.
// Returns whether `inner` WAS module state (handled either way, valid or not).
fn vPtrOfModuleState(c: Checker, inner: int, sliceTy: int, argNode: int): bool {
  if (!vIsModuleStateRef(c, inner)) {
    return false
  }
  let mel = sliceTy
  if (mel != 0 && c.ctx.types[mel].kind == TypeKind.Array) {
    mel = c.ctx.types[mel].elem
  }
  if (!vIsIntegerPrim(c, mel)) {
    let mn = typeName(c.ctx, mel)
    reportNoHint(
      c.diags, ecInvalidOperand, vSpan(c, argNode),
      "'ptrOf' requires an integer element, found '${mn}'",
    )
  }
  return true
}

// A non-reference scalar prim: integer, float or bool (prims 0..10).
fn vIsScalarPrim(c: Checker, ty: int): bool {
  return ty != 0 && c.ctx.types[ty].kind == TypeKind.Prim && c.ctx.types[ty].prim <= 10
}

// `ptrOf(s: []T): *T` (§11.5): the address of `s`'s element 0, the only bridge
// from a traced slice to a raw `*T` (Bit has no `&`). `T` must be a
// non-reference scalar prim (#7644, Go's `unsafe.SliceData` minus references).
// A `string` operand (#5921) is admitted unconditionally: its header's `ptr` word (ABI.md §2.3) is already
// an absolute `u8` address, so there is no element type to validate the way
// a slice's is.
fn vPtrOfCall(c: Checker, node: int, args: []int) {
  if (len(args) != 1) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "'ptrOf' takes exactly 1 argument, found ${len(args)}",
    )
    return
  }
  let inner = kidsOf(c.tree, args[0])[0]
  let sliceTy = checkExprType(c, inner)
  if (vPtrOfModuleState(c, inner, sliceTy, args[0])) {
    return
  }
  if (sliceTy == 0 || c.ctx.types[sliceTy].kind != TypeKind.Slice) {
    if (sliceTy == primType(c.ctx, 11)) {
      return
    }
    if (sliceTy != 0) {
      let sn = typeName(c.ctx, sliceTy)
      reportNoHint(
        c.diags, ecInvalidOperand, vSpan(c, args[0]),
        "'ptrOf' requires a slice '[]T', a string or module-level state, found '${sn}'",
      )
    }
    return
  }
  let elem = c.ctx.types[sliceTy].elem
  if (!vIsScalarPrim(c, elem)) {
    reportNoHint(
      c.diags, ecInvalidOperand, vSpan(c, args[0]),
      "'ptrOf' requires a slice of a non-reference scalar element, found '[]${typeName(c.ctx, elem)}'",
    )
  }
}

// True iff `node` is a bare reference to a module-level `let` (§11.11) — the
// one thing besides a slice that `ptrOf` accepts.
fn vIsModuleStateRef(c: Checker, node: int): bool {
  if (getNode(c.tree, node).tag != Tag.Ident) {
    return false
  }
  if (node < 0 || node >= len(c.nodeSymbols)) {
    return false
  }
  let sid = c.nodeSymbols[node]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return false
  }
  let sym = c.symbols[sid]
  return sym.kind == SymbolKind.LetBinding && sym.moduleScoped
}
