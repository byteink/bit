// In-Bit self-checks for compiler/pmversion.bit (#2364). Sibling of
// pmversion.bit (same module), named to sort after it. Run by `selfcheck()`
// under `./make test`; a failed `assert` panics with exit 2, so a regression
// in constraint parsing or matching fails the build.

// ---- parseVersion --------------------------------------------------------

fn checkPmParseVersionAccepts() {
  let (v1, ok1) = parseVersion("1.2.3")
  assert(ok1)
  assert(v1.major == 1 && v1.minor == 2 && v1.patch == 3)

  let (v2, ok2) = parseVersion("0.0.0")
  assert(ok2)
  assert(v2.major == 0 && v2.minor == 0 && v2.patch == 0)

  let (v3, ok3) = parseVersion("10.20.30")
  assert(ok3)
  assert(v3.major == 10 && v3.minor == 20 && v3.patch == 30)
}

// A leading `v`, an empty component, a non-digit component, a missing
// component, and an extra component — each its own named failure, not a
// fallback to some plausible-but-wrong parse.
fn checkPmParseVersionRejects() {
  let (_, okV) = parseVersion("v1.2.3")
  assert(!okV)

  let (_, okEmptyMinor) = parseVersion("1..3")
  assert(!okEmptyMinor)

  let (_, okEmptyMajor) = parseVersion(".2.3")
  assert(!okEmptyMajor)

  let (_, okEmptyPatch) = parseVersion("1.2.")
  assert(!okEmptyPatch)

  let (_, okNonDigit) = parseVersion("1.2.a")
  assert(!okNonDigit)

  let (_, okMissing) = parseVersion("1.2")
  assert(!okMissing)

  let (_, okExtra) = parseVersion("1.2.3.4")
  assert(!okExtra)

  let (_, okEmpty) = parseVersion("")
  assert(!okEmpty)
}

// ---- canonicalVersion -----------------------------------------------------

fn checkPmCanonicalVersion() {
  let (c1, ok1) = canonicalVersion("1.2.3")
  assert(ok1)
  assert(c1 == "1.2.3")

  let (c2, ok2) = canonicalVersion("v1.2.3")
  assert(ok2)
  assert(c2 == "1.2.3")

  let (_, ok3) = canonicalVersion("vv1.2.3")
  assert(!ok3)

  let (_, ok4) = canonicalVersion("1.2")
  assert(!ok4)
}

// ---- parseVersionConstraint rejections ------------------------------------

// Every one of these must be a NAMED failure (ok == false), never a silent
// fallback to an exact match on some prefix — the dangerous outcome the
// ticket calls out explicitly.
fn checkPmParseVersionConstraintRejects() {
  let (_, ok1) = parseVersionConstraint(">=1.0.0")
  assert(!ok1)

  let (_, ok2) = parseVersionConstraint("*")
  assert(!ok2)

  let (_, ok3) = parseVersionConstraint("1.0.0 || 2.0.0")
  assert(!ok3)

  let (_, ok4) = parseVersionConstraint("1.0 - 2.0")
  assert(!ok4)

  let (_, ok5) = parseVersionConstraint("^v1.2.3")
  assert(!ok5)

  let (_, ok6) = parseVersionConstraint("")
  assert(!ok6)
}

// ---- constraintMatches, one function per semantics-table row -------------
//
// Every row gets a version at the inclusive lower bound, a version strictly
// inside the range, a version just outside the lower bound (rejected), and a
// version at the exclusive upper bound (rejected) — boundary-exclusive is
// where this class of code actually breaks.

fn pmvAssertMatches(constraint: string, version: string) {
  let (c, cok) = parseVersionConstraint(constraint)
  assert(cok)
  let (v, vok) = parseVersion(version)
  assert(vok)
  assert(constraintMatches(c, v))
}

fn pmvAssertRejects(constraint: string, version: string) {
  let (c, cok) = parseVersionConstraint(constraint)
  assert(cok)
  let (v, vok) = parseVersion(version)
  assert(vok)
  assert(!constraintMatches(c, v))
}

// ^1.2.3 -> >=1.2.3 <2.0.0
fn checkPmConstraintCaretMajor() {
  pmvAssertMatches("^1.2.3", "1.2.3")
  pmvAssertMatches("^1.2.3", "1.9.9")
  pmvAssertRejects("^1.2.3", "1.2.2")
  pmvAssertRejects("^1.2.3", "2.0.0")
}

// ^0.1.2 -> >=0.1.2 <0.2.0
fn checkPmConstraintCaretZeroMinor() {
  pmvAssertMatches("^0.1.2", "0.1.2")
  pmvAssertMatches("^0.1.2", "0.1.9")
  pmvAssertRejects("^0.1.2", "0.1.1")
  pmvAssertRejects("^0.1.2", "0.2.0")
}

// ^0.0.3 -> >=0.0.3 <0.0.4 (effectively exact)
fn checkPmConstraintCaretZeroZero() {
  pmvAssertMatches("^0.0.3", "0.0.3")
  pmvAssertRejects("^0.0.3", "0.0.2")
  pmvAssertRejects("^0.0.3", "0.0.4")
}

// ~1.2.3 -> >=1.2.3 <1.3.0
fn checkPmConstraintTilde() {
  pmvAssertMatches("~1.2.3", "1.2.3")
  pmvAssertMatches("~1.2.3", "1.2.9")
  pmvAssertRejects("~1.2.3", "1.2.2")
  pmvAssertRejects("~1.2.3", "1.3.0")
}

// ~0.1.2 -> >=0.1.2 <0.2.0 (same bound as ^0.1.2, per the ticket's own note
// that caret and tilde coincide at the minor level for 0.x)
fn checkPmConstraintTildeZeroMinor() {
  pmvAssertMatches("~0.1.2", "0.1.2")
  pmvAssertMatches("~0.1.2", "0.1.9")
  pmvAssertRejects("~0.1.2", "0.1.1")
  pmvAssertRejects("~0.1.2", "0.2.0")
}

// 1.2.3 -> ==1.2.3
fn checkPmConstraintExact() {
  pmvAssertMatches("1.2.3", "1.2.3")
  pmvAssertRejects("1.2.3", "1.2.2")
  pmvAssertRejects("1.2.3", "1.2.4")
}

fn checkPmVersion() {
  checkPmParseVersionAccepts()
  checkPmParseVersionRejects()
  checkPmCanonicalVersion()
  checkPmParseVersionConstraintRejects()
  checkPmConstraintCaretMajor()
  checkPmConstraintCaretZeroMinor()
  checkPmConstraintCaretZeroZero()
  checkPmConstraintTilde()
  checkPmConstraintTildeZeroMinor()
  checkPmConstraintExact()
}
