// compiler/classjsondecodeimports.bit — the import declarations the two decode
// entry points synthesize (#3977, #4501).
//
// Split out of classjsondecodecall.bit, which #4501 pushed to within fifty
// lines of the repo's 800-line ceiling. A sibling `.bit` file is the same
// module, so this is a pure move plus the one function `jsonDecodeImportDecls`
// grew when a second entry point appeared.
//
// WHAT A MODULE OWES. A module that synthesizes any decoder needs stdlib/json's
// runtime half — decode.bit's for the DOM entry point, dectext.bit's for the
// text one — and one name per decoder it CALLS that another module declares.
// The three sources are collected as `JsonDecodeImport` pairs and bound once
// each, because a name imported twice is `E0042 already declared in this
// scope` and a name the USER imported too is the same error.

// A cloned copy of the string literal node this module already imports `path`
// through, or 0 when it imports nothing from there. Cloned rather than shared,
// for the reason `jbKeyExpr` clones: a node reachable by two paths is a shape
// no other pass here builds.
//
// Only a path the module ALREADY imports can be used, and that is not a
// limitation in practice: `SrcModule.imports` is built by the LOADER from the
// parsed import declarations, so a path nothing imported was never loaded and
// `bindImports` would skip the synthesized declaration silently.
fn importPathClone(tree: Tree, source: string, path: string): int {
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let node = kidsOf(tree, d)[1]
    if (stringLitText(source, getNode(tree, node).span) == path) {
      return addLeaf(tree, getNode(tree, node).tag, getNode(tree, node).span)
    }
  }
  return 0
}

// `import { a, b } from "<path>"` as a top-level declaration, or 0 when the
// module imports nothing from `path` or already binds every name.
fn synthImportDecl(m: SrcModule, st: SynthText, path: string, names: []string): int {
  let tree = m.tree
  let pathNode = importPathClone(tree, m.source, path)
  if (pathNode == 0 || len(names) == 0) {
    return 0
  }
  let span = getNode(tree, pathNode).span
  let items = []int(0)
  for n of names {
    items = append(
      items,
      addNode(tree, Tag.ImportItem, span, 0, [synthIdent(tree, st, n), 0]),
    )
  }
  return addNode(
    tree, Tag.ImportDecl, span, 0,
    [addNode(tree, Tag.ImportGroup, span, 0, items), pathNode],
  )
}

// stdlib/json/decode.bit's runtime half, as one import declaration, minus any
// name the module already binds — a synthesized import of a name the user
// imported too would be `E0042 already declared in this scope`.
fn jsonDecImportHelpers(
  m: SrcModule, st: SynthText, bound: map<string, bool>, names: []string,
): int {
  let helpers = []string(0)
  for h of names {
    let (_, already) = bound[h]
    if (!already) {
      helpers = append(helpers, h)
      bound[h] = true
    }
  }
  return synthImportDecl(m, st, jsonDecodeModulePath, helpers)
}

// One name a module must import, and the path it reaches it by.
class JsonDecodeImport {
  path: string,
  word: string,
}

// The DOM decoders module `mid` calls that another module declares.
fn jsonDecodeDomImportItems(d: JsonDecodeDemand, mid: int): []JsonDecodeImport {
  let out = []JsonDecodeImport(0)
  for n of d.needs.list {
    if (n.needMod == mid && n.classMod != mid && n.path != "") {
      out = append(out, JsonDecodeImport{ path: n.path, word: jsonDecName(n.className) })
    }
  }
  return out
}

// Every name module `mid` imports for either entry point, in one list so the
// caller binds each of them once.
fn jsonDecodeImportItems(d: JsonDecodeDemand, mid: int): []JsonDecodeImport {
  let out = jsonDecodeDomImportItems(d, mid)
  for it of jsonDecodeTextImportItems(d, mid) {
    out = append(out, it)
  }
  for it of jsonDecodeTextRootImportItems(d, mid) {
    out = append(out, it)
  }
  return out
}

// One import declaration per name above that the module does not already bind
// — a synthesized import of a name the user imported too would be `E0042
// already declared in this scope`.
fn jsonDecodeNeedImports(
  m: SrcModule, st: SynthText, d: JsonDecodeDemand, mid: int, bound: map<string, bool>,
): []int {
  let out = []int(0)
  for it of jsonDecodeImportItems(d, mid) {
    let (_, already) = bound[it.word]
    if (already) {
      continue
    }
    bound[it.word] = true
    let decl = synthImportDecl(m, st, it.path, [it.word])
    if (decl != 0) {
      out = append(out, decl)
    }
  }
  return out
}

// The imports module `mid` needs: stdlib/json's runtime half for whichever
// entry points it synthesizes a decoder for, and one decoder name per class it
// decodes that another module declares.
fn jsonDecodeImportDecls(
  m: SrcModule, st: SynthText, mid: int, d: JsonDecodeDemand, plan: SynthPlan,
): []int {
  let out = []int(0)
  let bound = importedLocalNames(m.tree, m.source)
  if (len(plan.decodeClasses) != 0) {
    let helperDecl = jsonDecImportHelpers(m, st, bound, jsonDecHelperNames())
    if (helperDecl != 0) {
      out = append(out, helperDecl)
    }
  }
  if (len(plan.textClasses) != 0) {
    let textDecl = jsonDecImportHelpers(m, st, bound, jsonDecTextHelperNames())
    if (textDecl != 0) {
      out = append(out, textDecl)
    }
  }
  for decl of jsonDecodeNeedImports(m, st, d, mid, bound) {
    out = append(out, decl)
  }
  return out
}
