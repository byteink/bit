// compiler/classjsondecodeimports.bit — the import declarations the two decode
// entry points synthesize (#3977, #4501).
//
// Split out of classjsondecodecall.bit, which #4501 pushed to within fifty
// lines of the repo's 800-line ceiling. A sibling `.bit` file is the same
// module, so this is a pure move plus the one function `jsonDecodeImportDecls`
// grew when a second entry point appeared.
//
// WHAT A MODULE OWES. A module that synthesizes any decoder needs stdlib/json's
// runtime half — decode.bit's for the DOM entry point, dectext.bit's for the
// text one — and one name per decoder it CALLS that another module declares.
// The three sources are collected as `JsonDecodeImport` pairs and bound once
// each, because a name imported twice is `E0042 already declared in this
// scope` and a name the USER imported too is the same error.

// A cloned copy of the string literal node this module already imports `path`
// through, or 0 when it imports nothing from there. Cloned rather than shared,
// for the reason `jbKeyExpr` clones: a node reachable by two paths is a shape
// no other pass here builds.
//
// Only a path the module ALREADY imports can be used, and that is not a
// limitation in practice: `SrcModule.imports` is built by the LOADER from the
// parsed import declarations, so a path nothing imported was never loaded and
// `bindImports` would skip the synthesized declaration silently.
fn importPathClone(tree: Tree, source: string, path: string): int {
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let node = kidsOf(tree, d)[1]
    if (stringLitText(source, getNode(tree, node).span) == path) {
      return addLeaf(tree, getNode(tree, node).tag, getNode(tree, node).span)
    }
  }
  return 0
}

// True iff the module's own parsed source already has a literal
// `import ... from "<path>"` declaration for `importPathClone` to clone.
// Checked without building any node (unlike `importPathClone`) so a caller
// can decide, before `appendSynthText` runs, whether it must queue the
// fallback quoted-path WORD `synthImportPathWord` builds a fresh literal
// from (#6244).
fn moduleHasLiteralImport(tree: Tree, source: string, path: string): bool {
  for d of kidsOf(tree, tree.root) {
    if (d == 0 || getNode(tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let node = kidsOf(tree, d)[1]
    if (stringLitText(source, getNode(tree, node).span) == path) {
      return true
    }
  }
  return false
}

// The WORD `appendSynthText` must lay down for `synthImportPathLit` to build
// a fresh `"<path>"` string-literal leaf from — the quoted form is the word
// itself, matching `checksqlrowbuild.bit`'s `sqlColumnOf` convention for a
// synthesized string literal's word.
fn synthImportPathWord(path: string): string {
  return "\"" + path + "\""
}

// A fresh `Tag.StringLit` leaf spelling `path`, built from the WORD
// `synthImportPathWord` names — the fallback `synthImportDecl` takes when
// this module's own source has no import from `path` at all for
// `importPathClone` to clone (#6244: a module using only `@json class`,
// no import from "std/json"). Returns 0 when the caller never queued this
// word (`appendSynthText` never saw it), e.g. a module `importPathClone`
// already served.
fn synthImportPathLit(tree: Tree, st: SynthText, path: string): int {
  let (sp, has) = st.spans[synthImportPathWord(path)]
  if (!has) {
    return 0
  }
  return addLeaf(tree, Tag.StringLit, sp)
}

// `import { a, b } from "<path>"` as a top-level declaration, or 0 when the
// module imports nothing from `path` or already binds every name.
fn synthImportDecl(m: SrcModule, st: SynthText, path: string, names: []string): int {
  return synthImportAliasDecl(m, st, path, names, []string(len(names)))
}

// `synthImportDecl` binding `names[i]` locally as `aliases[i]` (`import { a as
// b }`); an empty alias keeps the name. The alias is a word the caller queued
// beside the name, for the same reason every other synthesized identifier is.
fn synthImportAliasDecl(
  m: SrcModule, st: SynthText, path: string, names: []string, aliases: []string,
): int {
  let tree = m.tree
  let pathNode = importPathClone(tree, m.source, path)
  if (pathNode == 0) {
    pathNode = synthImportPathLit(tree, st, path)
  }
  if (pathNode == 0 || len(names) == 0) {
    return 0
  }
  let span = getNode(tree, pathNode).span
  let items = []int(0)
  let i = 0
  for n of names {
    let alias = 0
    if (aliases[i] != "") {
      alias = synthIdent(tree, st, aliases[i])
    }
    items = append(
      items,
      addNode(tree, Tag.ImportItem, span, 0, [synthIdent(tree, st, n), alias]),
    )
    i = i + 1
  }
  return addNode(
    tree, Tag.ImportDecl, span, 0,
    [addNode(tree, Tag.ImportGroup, span, 0, items), pathNode],
  )
}

// The reserved local alias synthesized code binds the imported name `name`
// under: `import { name as __name }`. Synthesized code is written against the
// alias only, so a module's own `name`, or one the user imports, is never
// touched and never collides (E0042), the same way #7558 did it for `Json`.
// A provider module (std/sql, pkg/orm), which has nothing to import, declares
// the same `__name` itself, so no synthesis site branches on provider/consumer.
fn synthAlias(name: string): string {
  return "__" + name
}

// `names` followed by their aliases: both spellings must sit in the module's
// source text, because the import item names the original and the alias, and
// every reference spells the alias.
fn synthAliasedWords(names: []string): []string {
  let out = []string(0)
  for n of names {
    out = append(out, n)
  }
  for n of names {
    out = append(out, synthAlias(n))
  }
  return out
}

// `synthImportAliasDecl` binding every name in `names` under `synthAlias`.
fn synthImportAliasedDecl(m: SrcModule, st: SynthText, path: string, names: []string): int {
  let aliases = []string(0)
  for n of names {
    aliases = append(aliases, synthAlias(n))
  }
  return synthImportAliasDecl(m, st, path, names, aliases)
}

// `names` not yet in `bound`, marked bound. `bound` is keyed by ALIAS: the
// aliases are reserved (E0314), so the user's own imports never shadow one,
// while two features of one module importing the same helper do share it.
fn synthUnboundNames(bound: map<string, bool>, names: []string): []string {
  let out = []string(0)
  for n of names {
    let (_, already) = bound[synthAlias(n)]
    if (!already) {
      out = append(out, n)
      bound[synthAlias(n)] = true
    }
  }
  return out
}

// stdlib/json/decode.bit's runtime half, as one import declaration of the
// aliased names, minus the ones an earlier feature of this module bound.
fn jsonDecImportHelpers(
  m: SrcModule, st: SynthText, bound: map<string, bool>, names: []string,
): int {
  return synthImportAliasedDecl(
    m, st, jsonDecodeModulePath, synthUnboundNames(bound, names),
  )
}

// One name a module must import, and the path it reaches it by.
class JsonDecodeImport {
  path: string,
  word: string,
}

// The DOM decoders module `mid` calls that another module declares.
fn jsonDecodeDomImportItems(d: JsonDecodeDemand, mid: int): []JsonDecodeImport {
  let out = []JsonDecodeImport(0)
  for n of d.needs.list {
    if (n.needMod == mid && n.classMod != mid && n.path != "") {
      out = append(out, JsonDecodeImport{ path = n.path, word = jsonDecName(n.className) })
    }
  }
  return out
}

// Every name module `mid` imports for either entry point, in one list so the
// caller binds each of them once.
fn jsonDecodeImportItems(d: JsonDecodeDemand, mid: int): []JsonDecodeImport {
  let out = jsonDecodeDomImportItems(d, mid)
  for it of jsonDecodeTextImportItems(d, mid) {
    out = append(out, it)
  }
  for it of jsonDecodeTextRootImportItems(d, mid) {
    out = append(out, it)
  }
  return out
}

// One import declaration per name above that the module does not already bind
// — a synthesized import of a name the user imported too would be `E0042
// already declared in this scope`.
fn jsonDecodeNeedImports(
  m: SrcModule, st: SynthText, d: JsonDecodeDemand, mid: int, bound: map<string, bool>,
): []int {
  let out = []int(0)
  for it of jsonDecodeImportItems(d, mid) {
    let (_, already) = bound[it.word]
    if (already) {
      continue
    }
    bound[it.word] = true
    let decl = synthImportDecl(m, st, it.path, [it.word])
    if (decl != 0) {
      out = append(out, decl)
    }
  }
  return out
}

// The imports module `mid` needs: stdlib/json's runtime half for whichever
// entry points it synthesizes a decoder for, and one decoder name per class it
// decodes that another module declares.
fn jsonDecodeImportDecls(
  m: SrcModule, st: SynthText, mid: int, d: JsonDecodeDemand, plan: SynthPlan,
): []int {
  let out = []int(0)
  let bound = importedLocalNames(m.tree, m.source)
  if (len(plan.decodeClasses) != 0) {
    let helperDecl = jsonDecImportHelpers(m, st, bound, jsonDecHelperNames())
    if (helperDecl != 0) {
      out = append(out, helperDecl)
    }
  }
  if (len(plan.textClasses) != 0) {
    let textDecl = jsonDecImportHelpers(m, st, bound, jsonDecTextHelperNames())
    if (textDecl != 0) {
      out = append(out, textDecl)
    }
  }
  for decl of jsonDecodeNeedImports(m, st, d, mid, bound) {
    out = append(out, decl)
  }
  return out
}
