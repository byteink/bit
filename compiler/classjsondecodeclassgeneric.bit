// compiler/classjsondecodeclassgeneric.bit — the class-keyed half of #6259:
// `jsonDecode<T>` where `T` is the enclosing generic CLASS's own type
// parameter, resolved per class instantiation.
//
// Split out of `classjsondecodegeneric.bit` at 879 lines against E0200's 800
// (spec/LINT.md §5.2): that file's own header explains WHY this needs its own
// mechanism (a class is never called, so it has neither a `ctx.instantiations`
// entry nor an explicit-call site to key by) — this file is the class-keyed
// twin of every piece there, function for function. A PURE MOVE: same module
// (directory-scanned), so every helper `classjsondecodegeneric.bit` declares
// (`jsonGenericFuncDecls`, `jsonDeclTypeParamNames`, `jsonRecvGenericCount`,
// `jsonCalleeName`, `jsonCallTypeArgs`, `jsonTypeParamArgAt`,
// `jsonDecodeGenericEntries`, `hasJsonDecodeGeneric`, `closeJsonDecodeGenerics`
// — which this file's edges feed into) is visible here unchanged, and nothing
// here needs a new import.

// One generic CLASS that decodes into one of ITS OWN type parameters,
// directly, through a method with no generic parameters of its own (the
// receiver-only shape #4569's Pass A1 closure re-walks per nominal
// instantiation, `lowerinstclosure.bit`'s `closeMethodInstantiations`).
// Unlike a function/method's own instantiation (found through
// `ctx.instantiations`, keyed by the CALL that names it), a class has no such
// call — `validateJsonDecodeClassGenerics`/`retargetJsonDecodeInstances`
// (classjsondecodegenericretarget.bit) instead walk `ctx.typeInsts`, the
// nominal instantiation ledger every concrete use of the class already
// populates. `site` is the `jsonDecode<P>` call itself: the one
// representative location every instantiation's diagnostic, if any, points
// back at.
class JsonDecodeClassGeneric {
  mod: int,
  className: string,
  tpIndex: int,
  site: Span,
}

fn hasJsonDecodeClassGeneric(
  cgens: []JsonDecodeClassGeneric, mod: int, className: string, tpIndex: int,
): bool {
  for x of cgens {
    if (x.mod == mod && x.className == className && x.tpIndex == tpIndex) {
      return true
    }
  }
  return false
}

// One "this generic FUNCTION/METHOD instantiates that CLASS with its own type
// parameter" edge, found syntactically from a WRITTEN type reference (a
// result type, a parameter type, a composite literal's type) rather than a
// call — a class is never called with explicit type arguments the way a
// function is. `classIndex` is a position in the class's OWN generic list, so
// it compares against a `JsonDecodeClassGeneric`'s `tpIndex`.
class JsonDecodeClassEdge {
  mod: int,
  decl: int,
  name: string,
  tpIndex: int,
  nrecv: int,
  className: string,
  classIndex: int,
}

// Every generic CLASS in the project that decodes into one of its own type
// parameters, directly — the top-level driver `collectJsonDecodeGenerics`
// seeds its own closure from, and `validateJsonDecodeClassGenerics`/
// `collectJsonDecodeClassInstNeeds` read back on their own (each re-derives
// this syntactic set rather than sharing it across passes, matching how
// `collectJsonDecodeGenerics` is already called more than once).
fn collectJsonDecodeClassGenerics(p: Project): []JsonDecodeClassGeneric {
  let cgens = []JsonDecodeClassGeneric(0)
  let mid = 0
  while (mid < len(p.mods)) {
    cgens = moduleJsonDecodeClassGenerics(p.mods[mid], mid, cgens)
    mid = mid + 1
  }
  return cgens
}

// #6259 — the class-keyed twin of `moduleJsonDecodeGenericsFor`: the SAME
// direct sweep, reading the OTHER half of the merged generic list (`k <
// nrecv`, a type parameter the RECEIVER contributed) instead of the method's
// own. Keyed by the RECEIVER's class name rather than by `decl`, because the
// need belongs to the CLASS — `Collection<T>.get` and `.all` calling
// `jsonDecode<T>` are the same need, found twice.
fn moduleJsonDecodeClassGenerics(
  m: SrcModule, mid: int, cgens: []JsonDecodeClassGeneric,
): []JsonDecodeClassGeneric {
  for entry of jsonDecodeGenericEntries() {
    cgens = moduleJsonDecodeClassGenericsFor(m, mid, cgens, entry)
  }
  return cgens
}

fn moduleJsonDecodeClassGenericsFor(
  m: SrcModule, mid: int, cgens: []JsonDecodeClassGeneric, entry: string,
): []JsonDecodeClassGeneric {
  let names = jsonDecodeNamesOf(m.tree, m.source, entry)
  if (!bindsJsonDecode(names)) {
    return cgens
  }
  for decl of jsonGenericFuncDecls(m.tree) {
    let className = jsonRecvClassName(m.tree, m.source, decl)
    if (className == "") {
      continue
    }
    let tps = jsonDeclTypeParamNames(m.tree, m.source, decl)
    let nrecv = jsonRecvGenericCount(m.tree, decl)
    for call of subtreeCallNodes(m.tree, kidsOf(m.tree, decl)[5]) {
      let k = jsonTypeParamArgAt(m.tree, m.source, call, tps, 0)
      if (k < 0 ||
        k >= nrecv ||
        !isJsonDecodeCallee(m.tree, m.source, kidsOf(m.tree, call)[0], names)) {
        continue
      }
      if (!hasJsonDecodeClassGeneric(cgens, mid, className, k)) {
        cgens = append(
          cgens,
          JsonDecodeClassGeneric{
            mod = mid, className = className, tpIndex = k,
            site = getNode(m.tree, call).span,
          },
        )
      }
    }
  }
  return cgens
}

// The receiver's class NAME, or "" for a free function/method on a
// non-generic receiver — `jsonRecvGenericCount`'s sibling, reading the SAME
// receiver type node one kid earlier (the base name rather than the arity).
fn jsonRecvClassName(tree: Tree, source: string, decl: int): string {
  let recv = kidsOf(tree, decl)[0]
  if (recv == 0) {
    return ""
  }
  let rt = kidsOf(tree, recv)[1]
  if (rt == 0 || getNode(tree, rt).tag != Tag.GenericInst) {
    return ""
  }
  return identText(tree, source, kidsOf(tree, rt)[0])
}

// #6259 — the class-keyed twin of `moduleJsonDecodeEdges`: every generic
// FUNCTION/METHOD declaration that WRITES a class's type at that class's own
// index using its OWN type parameter — a result type, a parameter type, or a
// composite literal's type anywhere in its signature or body. `pkg/kv`'s
// `Db.collection<T>(...): Collection<T>` is exactly this shape: `Collection`
// is never CALLED, only named as `Db.collection`'s own declared result.
fn moduleJsonDecodeClassEdges(
  m: SrcModule, mid: int, edges: []JsonDecodeClassEdge,
): []JsonDecodeClassEdge {
  for decl of jsonGenericFuncDecls(m.tree) {
    let tps = jsonDeclTypeParamNames(m.tree, m.source, decl)
    let nrecv = jsonRecvGenericCount(m.tree, decl)
    let dname = jsonDeclName(m.tree, m.source, decl)
    for inst of declGenericInstNodes(m.tree, decl) {
      let className = jsonCalleeName(m.tree, m.source, kidsOf(m.tree, inst)[0])
      let nargs = len(jsonCallTypeArgs(m.tree, inst))
      let ai = 0
      while (className != "" && ai < nargs) {
        let k = jsonTypeParamArgAt(m.tree, m.source, inst, tps, ai)
        if (k >= nrecv) {
          edges = append(
            edges,
            JsonDecodeClassEdge{
              mod = mid, decl = decl, name = dname, tpIndex = k, nrecv = nrecv,
              className = className, classIndex = ai,
            },
          )
        }
        ai = ai + 1
      }
    }
  }
  return edges
}

// Every `Tag.GenericInst` node in the subtree rooted at `node`, mirroring
// `subtreeCallNodes` (lowerinstclosure.bit) for a written TYPE reference
// instead of a call — bounded the same way, by the arena's own size.
fn subtreeGenericInstNodes(t: Tree, node: int): []int {
  let out = []int(0)
  if (node == 0) {
    return out
  }
  let stack = [node]
  let steps = 0
  while (len(stack) > 0 && steps < len(t.nodes)) {
    let n = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    if (getNode(t, n).tag == Tag.GenericInst) {
      out = append(out, n)
    }
    let kids = kidsOf(t, n)
    let i = len(kids) - 1
    while (i >= 0) {
      if (kids[i] != 0) {
        stack = append(stack, kids[i])
      }
      i = i - 1
    }
    steps = steps + 1
  }
  return out
}

// `decl`'s param types, result type and body, swept for `GenericInst` nodes.
// The receiver (kids[0]) and the generic-param list itself (kids[2]) are
// skipped: neither can name a class this declaration hands its OWN type
// parameter to — a constraint bound is the only `GenericInst` either could
// hold, and a class constraint is not a shape SPEC §10.4 allows.
fn declGenericInstNodes(tree: Tree, decl: int): []int {
  let k = kidsOf(tree, decl)
  let out = subtreeGenericInstNodes(tree, k[3])
  out = append(out, ...subtreeGenericInstNodes(tree, k[4]))
  out = append(out, ...subtreeGenericInstNodes(tree, k[5]))
  return out
}

// Whether the class this edge instantiates is already known to decode into
// the type parameter this edge hands it.
fn jsonDecodeClassEdgeFires(cgens: []JsonDecodeClassGeneric, e: JsonDecodeClassEdge): bool {
  for g of cgens {
    if (g.className == e.className && g.tpIndex == e.classIndex) {
      return true
    }
  }
  return false
}

// #6259 — the class-keyed twin of `collectJsonDecodeGenericNeeds`: every
// `@json` class handed to a class that decodes into its own type parameter,
// as a written-out type argument anywhere in the project — a result type, a
// parameter type, a composite literal's type (`Box<Dog>{}`), rather than a
// call's type-argument list, since nothing CALLS a class.
fn collectJsonDecodeClassInstNeeds(
  p: Project, cgens: []JsonDecodeClassGeneric, d: JsonDecodeDemand,
) {
  if (len(cgens) == 0) {
    return
  }
  let mid = 0
  while (mid < len(p.mods)) {
    let m = p.mods[mid]
    let jx = newJsonCtx(p, m)
    let i = 1
    while (i < len(m.tree.nodes)) {
      if (getNode(m.tree, i).tag == Tag.GenericInst) {
        addJsonDecodeClassInstNeed(jx, mid, i, cgens, d)
      }
      i = i + 1
    }
    mid = mid + 1
  }
}

fn addJsonDecodeClassInstNeed(
  jx: JsonCtx, mid: int, inst: int, cgens: []JsonDecodeClassGeneric, d: JsonDecodeDemand,
) {
  let className = jsonCalleeName(jx.tree, jx.source, kidsOf(jx.tree, inst)[0])
  if (className == "") {
    return
  }
  let targs = jsonCallTypeArgs(jx.tree, inst)
  for g of cgens {
    if (g.className != className || g.tpIndex < 0 || g.tpIndex >= len(targs)) {
      continue
    }
    if (getNode(jx.tree, targs[g.tpIndex]).tag != Tag.Ident) {
      continue
    }
    let site = jsonClassSiteOf(jx, mid, identText(jx.tree, jx.source, targs[g.tpIndex]))
    if (site.found && site.mark == jmJsonClass && !hasJsonDecodeInstNeed(d, site)) {
      addJsonDecodeNeed(d.needs, site.mod, site)
      d.instNeeds = append(
        d.instNeeds,
        JsonDecodeNeed{
          needMod = site.mod, classMod = site.mod, className = site.name, path = "",
        },
      )
    }
  }
}
