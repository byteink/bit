// Generic function values share the expected-type ledger and instance identity
// with calls, while keeping identifier nodes out of call-only argument readers.
fn functionValueName(c: Checker, node: int): string {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.Ident) {
    return nodeText(c.tree, c.source, node)
  }
  if (tag == Tag.Member) {
    return nsQualifiedName(c, node)
  }
  return ""
}

fn functionValueSignature(c: Checker, node: int, name: string): int {
  let fr = funcRefAt(c, node, name)
  let signature = funcSigLookup(fr.owner, fr.declName)
  let (args, ok) = c.callExpectArgs[node]
  if (!ok || !funcRefIsGeneric(fr) || functionValueGap(args) >= 0) {
    return signature
  }
  return substType(c, signature, genericEnvOf(fr.owner, fr.decl, args), 0)
}

fn functionValueGap(args: []int): int {
  let i = 0
  while (i < len(args)) {
    if (args[i] == 0) {
      return i
    }
    i = i + 1
  }
  return -1
}

fn functionValueArgs(c: Checker, fr: FuncRef, want: int): []int {
  let signature = funcSigLookup(fr.owner, fr.declName)
  let gens = kidsOf(fr.owner.tree, fr.decl)[2]
  let args = []int(0)
  for pid of declGenericIds(fr.owner, gens) {
    args = append(args, typeBindParam(c, signature, want, pid, 0))
  }
  bindBoundSiblings(c, fr.owner, gens, args)
  return args
}

fn reportFunctionValueGap(c: Checker, node: int, fr: FuncRef, index: int) {
  report(
    c.diags, ecCannotInfer, vSpan(c, node),
    "cannot infer type parameter '${vGenericParamName(fr.owner, fr.decl, index)}' for function value '${fr.declName}'",
    "annotate the binding with a function type",
  )
}

// True means this expression has received the generic-value judgement.
fn vExpectFunctionValue(c: Checker, node: int, want: int): bool {
  let name = functionValueName(c, node)
  if (name == "" || c.ctx.types[want].kind != TypeKind.Func) {
    return false
  }
  let fr = funcRefAt(c, node, name)
  if (!funcRefIsGeneric(fr)) {
    return false
  }
  let args = functionValueArgs(c, fr, want)
  c.callExpectArgs[node] = args
  let gap = functionValueGap(args)
  if (gap >= 0) {
    reportFunctionValueGap(c, node, fr, gap)
    return true
  }
  let signature = functionValueSignature(c, node, name)
  c.nodeTypes[node] = signature
  if (signature != want) {
    vMismatch(c, node, want, signature)
    return true
  }
  vBoundLoop(c, fr, args, node, 0)
  recordInstantiation(c, fr, args, vSpan(c, node))
  return true
}

// These edges are values; names, annotations, patterns and direct callees are
// deliberately absent, so the final sweep cannot diagnose a declaration.
fn functionValueChildren(c: Checker, node: int): []int {
  let tag = getNode(c.tree, node).tag
  let k = kidsOf(c.tree, node)
  if (tag == Tag.FuncDecl) {
    return [k[3], k[5]]
  }
  if (tag == Tag.StructDecl) {
    return [k[2]]
  }
  if (tag == Tag.Binding || tag == Tag.Field) {
    return [k[2]]
  }
  if (tag == Tag.Param || tag == Tag.ParamRest) {
    if (len(k) > 2) {
      return [k[2]]
    }
    return []int(0)
  }
  if (tag == Tag.Call) {
    return functionValueCallChildren(c, node)
  }
  return functionValueChildrenExpr(c, node)
}

fn functionValueChildrenExpr(c: Checker, node: int): []int {
  let tag = getNode(c.tree, node).tag
  let k = kidsOf(c.tree, node)
  if (tag == Tag.Member) {
    return [k[0]]
  }
  if (tag == Tag.CompositeLit || tag == Tag.FieldInit || tag == Tag.NamedArg) {
    return [k[1]]
  }
  if (tag == Tag.ForOf || tag == Tag.ForIn) {
    return [k[1], k[2]]
  }
  if (tag == Tag.CatchBind) {
    return [k[0], k[2]]
  }
  if (tag == Tag.ArrowFn || tag == Tag.MatchArm) {
    return [k[1]]
  }
  return functionValueChildrenRest(c, node)
}

fn functionValueChildrenRest(c: Checker, node: int): []int {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.TypeAssert) {
    return [kidsOf(c.tree, node)[0]]
  }
  for allowed of [
    Tag.Program, Tag.Export, Tag.LetDecl, Tag.ConstDecl, Tag.FieldList, Tag.Params,
    Tag.Block, Tag.ReturnStmt, Tag.ExprStmt, Tag.Binary, Tag.Unary, Tag.Args, Tag.Arg,
    Tag.StrInterp, Tag.TryExpr, Tag.Index, Tag.SliceExpr, Tag.TupleIndex, Tag.ArgSpread,
    Tag.SliceLit, Tag.MapLit, Tag.TupleLit, Tag.FieldInits, Tag.CatchDefault,
    Tag.IfStmt, Tag.WhileStmt, Tag.ForC, Tag.ForInf, Tag.FailStmt, Tag.SpawnStmt,
    Tag.DeferStmt, Tag.IncStmt, Tag.DecStmt, Tag.SendStmt, Tag.Assign, Tag.LhsList,
    Tag.ExprList, Tag.MatchStmt, Tag.ArmList, Tag.MapEntries, Tag.MapEntry,
    Tag.SelectStmt, Tag.CommCase, Tag.CommDefault, Tag.SwitchStmt, Tag.CaseList,
    Tag.SwitchCase, Tag.SwitchDefault, Tag.StmtList, Tag.TestDecl, Tag.CondExpr,
  ] {
    if (tag == allowed) {
      return kidsOf(c.tree, node)
    }
  }
  return []int(0)
}

fn subtreeFunctionValues(c: Checker, root: int): []int {
  let out = []int(0)
  let stack = [root]
  let steps = 0
  while (len(stack) > 0 && steps < len(c.tree.nodes)) {
    let node = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    if (node != 0) {
      let name = functionValueName(c, node)
      if (name != "" && funcRefIsGeneric(funcRefAt(c, node, name))) {
        out = append(out, node)
      }
      for child of functionValueChildren(c, node) {
        if (child != 0) {
          stack = append(stack, child)
        }
      }
    }
    steps = steps + 1
  }
  return out
}

fn vSweepFunctionValues(c: Checker) {
  for node of subtreeFunctionValues(c, c.tree.root) {
    let (_, ok) = c.callExpectArgs[node]
    if (!ok) {
      let fr = funcRefAt(c, node, functionValueName(c, node))
      reportFunctionValueGap(c, node, fr, 0)
    }
  }
}

fn recordSubtreeFunctionValues(c: Checker, node: int, genEnv: TypeEnv) {
  for value of subtreeFunctionValues(c, node) {
    let (args, ok) = c.callExpectArgs[value]
    if (ok && functionValueGap(args) < 0) {
      let fr = funcRefAt(c, value, functionValueName(c, value))
      recordInstantiation(c, fr, substTypeList(c, args, genEnv), vSpan(c, value))
    }
  }
}

fn functionValueCallTarget(fc: FnCtx, node: int, fr: FuncRef): CallTarget {
  if (!funcRefIsGeneric(fr)) {
    return nongenericCallTarget(fc, fr)
  }
  let (raw, ok) = fc.c.callExpectArgs[node]
  let args = substTypeList(fc.c, raw, fc.genEnv)
  let idx = instantiationIndex(fc.c, fr, args)
  if (!ok || idx < 0) {
    return CallTarget{ ok = false, owner = fr.owner }
  }
  let signature = nodeType(fc, node)
  let result = fc.c.ctx.types[signature].result
  return CallTarget{
    ok = true, symbol = instanceSymbol(fc.c.ctx, fc.lowerer.root, idx),
    paramTypes = fc.c.ctx.types[signature].members,
    result = unwrapFallible(fc.c, result), fallible = result,
    owner = fr.owner, decl = fr.decl, targs = args,
  }
}

fn vInstFunctionValue(c: Checker, node: int, step: InstStep) {
  let (args, ok) = c.callExpectArgs[node]
  let name = functionValueName(c, node)
  if (!ok || name == "") {
    return
  }
  let fr = funcRefAt(c, node, name)
  if (!funcRefIsGeneric(fr)) {
    return
  }
  vInstJudgeCall(c, InstCallRef{ fr = fr, name = name, node = node, start = 0 }, args, step)
}

fn vExpectResolvedExpr(c: Checker, node: int, want: int) {
  if (vClassNameArg(c, node, want) || vExpectFunctionValue(c, node, want)) {
    return
  }
  vPinGenericLit(c, node, want)
  vExpect(c, node, checkExprType(c, node), want)
}

// The builtin takes a declaration's address, not a closure value (§11.10).
// Match vUnmanagedBuiltin (validateunmanaged.bit), including user shadows.
fn functionValueCallChildren(c: Checker, node: int): []int {
  let k = kidsOf(c.tree, node)
  let callee = k[0]
  if (getNode(c.tree, callee).tag == Tag.Ident &&
    nodeText(c.tree, c.source, callee) == "entryOf" &&
    !shadowedByValue(c, callee, "entryOf") &&
    funcRefAt(c, callee, "entryOf").decl == 0) {
    return []int(0)
  }
  return [k[2]]
}
