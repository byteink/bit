// #6440 (§11.6): an `asm` block whose payload calls out must declare the whole
// caller-saved file. The callee destroys it, and an undeclared register is an
// allocator-visible lie: a value live across the block sat in rcx, the callee
// clobbered it, and the program read the wrong memory at exit 0.
//
// Split out of validateunmanaged.bit (line budget); a sibling .bit file is the
// same module.

// The one clobber-list spelling that stands for the whole required set. It is
// not a register, so `asmRegX64`/`asmRegArm64` still answer -1 for it and an
// `input`/`result` operand cannot name it.
const asmCallerSavedName = "callerSaved"

// Caller-saved integer registers a call destroys, by the codes of
// `asmRegX64`/`asmRegArm64`.
//
// x64: the checker is target-independent and one payload serves every x64
// target, so the set is the UNION of System V (rax rcx rdx rsi rdi r8-r11) and
// Win64 (rax rcx rdx r8-r11). Win64's is a subset, so System V's is the union.
// arm64: AAPCS64 x0-x17 plus x30, which `bl`/`blr` overwrite with the return
// address. x18 is the platform register and is never a callee's to clobber.
fn asmCallerSavedCodes(isArm64: bool): []int {
  if (isArm64) {
    let out = []int(0)
    let n = 0
    while (n <= 17) {
      out = append(out, n)
      n = n + 1
    }
    return append(out, 30)
  }
  return [0, 1, 2, 6, 7, 8, 9, 10, 11]
}

fn asmRegSpelling(code: int, isArm64: bool): string {
  if (isArm64) {
    return "x${code}"
  }
  let names = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi"]
  if (code < 8) {
    return names[code]
  }
  return "r${code}"
}

// Could this arm64 payload contain a call? Words are instructions, so this is
// exact: `bl` (0x94000000, imm26), `blr` (0xD63F0000 | Rn<<5) and the
// pointer-authenticating `blraa`/`blrab`/`blraaz`/`blrabz`.
fn asmArm64MayCall(words: []int): bool {
  for w of words {
    if ((w & 0xFC000000) == 0x94000000) {
      return true
    }
    if ((w & 0xFFFFFC1F) == 0xD63F0000) {
      return true
    }
    if ((w & 0xFEFFF800) == 0xD63F0800) {
      return true
    }
  }
  return false
}

// The literal values of an `asm_code` block (empty when absent).
fn vAsmCodeVals(c: Checker, code: int): []int {
  let out = []int(0)
  if (code == 0) {
    return out
  }
  for lit of kidsOf(c.tree, code) {
    out = append(out, parseIntText(vIdentText(c, lit)))
  }
  return out
}

// Marks the register an operand/clobber ident names; the `callerSaved` spelling
// marks the whole required set.
fn vAsmMark(c: Checker, ident: int, isArm64: bool, declared: []bool) {
  let name = vIdentText(c, ident)
  if (name == asmCallerSavedName) {
    for q of asmCallerSavedCodes(isArm64) {
      declared[q] = true
    }
    return
  }
  let code = asmRegX64(name)
  if (isArm64) {
    code = asmRegArm64(name)
  }
  if (code >= 0 && code < 32) {
    declared[code] = true
  }
}

// The registers a call may destroy without a diagnostic: those the block lists
// in `clobber`, and those it pins as `input` or `result`, which the allocator
// keeps every value live across the block out of (`reserveAsmX64`/
// `reserveAsmArm64`, AsmPin), so no live value can be sitting in them.
fn vAsmDeclared(c: Checker, k: []int, isArm64: bool): []bool {
  let declared = []bool(32)
  let list = k[3]
  let side = 1
  if (isArm64) {
    list = k[4]
    side = 0
  }
  if (list != 0) {
    for r of kidsOf(c.tree, list) {
      vAsmMark(c, r, isArm64, declared)
    }
  }
  if (k[2] != 0) {
    vAsmMark(c, kidsOf(c.tree, k[2])[side], isArm64, declared)
  }
  let i = 5
  while (i < len(k)) {
    vAsmMark(c, kidsOf(c.tree, k[i])[side], isArm64, declared)
    i = i + 1
  }
  return declared
}

// E0053 (§11.6, #6440): the payload of one arch holds a call but the block does
// not declare every caller-saved register; the error names each one missing.
fn vAsmCallClobbers(c: Checker, node: int, k: []int, isArm64: bool) {
  let arch = "x64"
  let code = k[0]
  if (isArm64) {
    arch = "arm64"
    code = k[1]
  }
  let vals = vAsmCodeVals(c, code)
  if (isArm64 && !asmArm64MayCall(vals)) {
    return
  }
  if (!isArm64 && !asmX64MayCall(vals)) {
    return
  }
  let declared = vAsmDeclared(c, k, isArm64)
  let missing = ""
  for r of asmCallerSavedCodes(isArm64) {
    if (!declared[r]) {
      if (missing != "") {
        missing = missing + ", "
      }
      missing = missing + asmRegSpelling(r, isArm64)
    }
  }
  if (missing == "") {
    return
  }
  report(
    c.diags, ecInvalidOperand, vSpan(c, node),
    "asm ${arch} payload may call out but does not declare the caller-saved clobbers: missing ${missing}",
    "a call destroys the whole caller-saved file; add `clobber ${arch} { callerSaved }`",
  )
}
