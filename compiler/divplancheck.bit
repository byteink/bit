// In-Bit self-checks for `xDivisorPlan` (divplan.bit) — the single decision
// both backends' div/rem emitters, arm64's `hasDivZeroGuard` frameless
// predicate and each backend's skip-the-constant scan share (#4361).
//
// Its own file rather than a sibling of either backend's checks: the function
// is backend-neutral, and `x64selcheck.bit` sits 8 lines under the 800-line
// limit. Sibling .bit files are the same module, so `selfcheck()` calls these
// directly.
//
// A wrong "yes" here is a SILENT wrong answer, not a slow one: reporting no
// guard for a divisor that can be zero deletes the panic SPEC §13.5 requires
// and lets `idiv`/`sdiv` see a zero divisor. That is the reason every arm is
// pinned individually rather than by sampling.

// One-instruction IrFunc whose instruction 0 is `const_int <v>`.
fn dpConstFunc(ctx: TypeContext, v: int): IrFunc {
  let ty = primType(ctx, 3) // i64
  let c = mkInstr(Op.ConstInt, ty)
  c.ival = v
  return IrFunc{
    name: "c", paramTypes: []int(0), result: ty,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }],
    instrs: [c], isFallible: false,
  }
}

// #4729 retired the plan's `magic` field with the selection-time emitter that
// read it, so a plan is once again the two questions `pow2K` and `guard` ask.
// The magic verdict is `divMagicForInstr`'s (optdivmagic.bit) and is pinned
// below against that function, not against a field of this class.
fn dpAssertPlan(p: DivPlan, pow2K: int, guard: bool) {
  assert(p.pow2K == pow2K)
  assert(p.guard == guard)
  // The nonsensical state: the reduced shape does not read the divisor
  // register, so a guard in front of it would test an operand nothing uses.
  assert(!(p.pow2K >= 0 && p.guard))
  // The reduced shape is exactly the one the skip scans may drop the divisor
  // for; asserted here so the two can never drift apart silently.
  assert(divPlanReadsDivisor(p) == (p.pow2K < 0))
}

fn checkDivisorPlan() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let w64s = mkWidth(8, RegClass.Int, true)
  let w64u = mkWidth(8, RegClass.Int, false)

  // A positive power of two >= 2: shift path, and no guard because a power of
  // two is non-zero by construction (the pre-#4361 rule, unchanged).
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64s), 3, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 2), 0, w64s), 1, false)

  // #4361 dropped the guard for a known non-zero literal and kept the divide;
  // #4389 took the divide too, in the IR since #4725. The planner's own answer
  // for all three is `litDivPlan()` -- no shift, no guard -- and the magic
  // verdict that USED to ride this plan is asserted against `divMagicForInstr`
  // beside each row, which is where #4729 left it.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 7), 0, w64s), -1, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 10), 0, w64s), -1, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 2147483647), 0, w64s), -1, false)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 7, 3), 2).ok)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 10, 3), 2).ok)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 2147483647, 3), 2).ok)

  // Divisor 1 and divisor -1 are non-zero, so the guard goes -- and they are
  // the ONLY signed divisors left that still emit a real divide, which is what
  // the two `divMagicForInstr` declines below say.
  //
  // -1 is the one that matters: `INT_MIN / -1` is the single signed overflow
  // division can produce, SPEC §13.5 wraps it two's-complement in a release
  // build, and that is exactly what the hardware `sdiv`/`idiv` already does.
  // A magic sequence would not. Divisor 1 is declined because a multiply to
  // compute `n / 1` would be strictly worse than the divide it replaced.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 1), 0, w64s), -1, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 1), 0, w64s), -1, false)
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 1, 3), 2).ok)
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 0 - 1, 3), 2).ok)
  // As an UNSIGNED divisor the -1 bit pattern is 2^64-1, an ordinary divisor
  // with an ordinary magic. The decline is signed-only and this pins that.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 1), 0, w64u), -1, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 1), 0, w64u), -1, false)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.UDiv, 0 - 1, 7), 2).ok)
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.UDiv, 1, 7), 2).ok)
  // A NEGATIVE power of two is not a shift -- `xConstPow2Divisor` declines any
  // non-positive divisor -- but it is a perfectly good magic multiply, so
  // #4389 reduces it where #4361 left a real divide.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 8), 0, w64s), -1, false)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 0 - 8, 3), 2).ok)

  // A known ZERO divisor keeps the guard, so the program still panics. It is
  // never folded into a silent 0 or a silent `lhs`.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0), 0, w64s), -1, true)

  // Not a constant at all: nothing is known, so everything is emitted.
  let notConst = mkInstr(Op.BlockParam, i64t)
  let fVar = IrFunc{
    name: "v", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 1 }],
    instrs: [notConst], isFallible: false,
  }
  dpAssertPlan(xDivisorPlan(fVar, 0, w64s), -1, true)

  // At an UNSIGNED width, -8 is the huge magnitude 2^64-8: not a power of two,
  // but still non-zero, so the guard goes -- and it takes the unsigned magic,
  // computed on that 2^64-8 and not on any narrowed reading of it.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 8), 0, w64u), -1, false)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.UDiv, 0 - 8, 7), 2).ok)

  checkDivisorPlanRawWidth()
}

// The width half of the same decision, split out under E0201's 80-line cap
// after #4729 added the `divMagicForInstr` rows above.
fn checkDivisorPlanRawWidth() {
  let ctx = newTypeContext()
  // The guard question is asked of the RAW 64-bit ival, because that is what
  // `movImm64`/`xEmitConstInt` materialize and what `cmpZero`/`xTestRR` then
  // compare -- neither truncates to the declared width. 3 * 2^32 in an
  // i32-typed const masks to ZERO at 32 bits and is still a non-zero register
  // at run time, which the emitted `sdiv` divides by; folding the check is
  // therefore correct, and reading the masked value instead would keep a
  // provably-dead branch. (The whole chain is raw: `xConstPow2Divisor` also
  // declines it on the raw magnitude, 0x3_00000000, not on the masked 0.)
  let w32s = mkWidth(4, RegClass.Int, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 12884901888), 0, w32s), -1, false)
  // …and the same rawness makes 2^32 at i32 a real power of two, k == 32,
  // because that is the value the register actually holds.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 4294967296), 0, w32s), 32, false)

  // The three named constructors are what the emitters branch on, and no two
  // of them mean the same thing. #4729 retired the fourth, `magicDivPlan`.
  dpAssertPlan(runtimeDivPlan(), -1, true)
  dpAssertPlan(litDivPlan(), -1, false)
  dpAssertPlan(pow2DivPlan(3), 3, false)
}

// One IrFunc whose instruction 2 is `<op> %0, <d>` over a block param and a
// `const_int`, so `divMagicForInstr` (optdivmagic.bit) can be asked about a
// real instruction rather than about a divisor in the abstract.
fn dpDivFunc(ctx: TypeContext, op: Op, d: int, prim: int): IrFunc {
  let ty = primType(ctx, prim)
  let n = mkInstr(Op.BlockParam, ty)
  let c = mkInstr(Op.ConstInt, ty)
  c.ival = d
  let q = mkInstr(op, ty)
  q.lhs = 0
  q.rhs = 1
  return IrFunc{
    name: "d", paramTypes: [ty], result: ty,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 3 }],
    instrs: [n, c, q], isFallible: false,
  }
}

// #4722: the magic split by OP, not only by divisor. Every pair below is the
// SAME divisor at the SAME width asked twice, so a gate that accidentally
// keyed on anything else (the value, the signedness, the width) cannot pass
// both halves -- one divisor asked once would have proven nothing.
//
// #4729 repointed this at `divMagicForInstr`: since the sequence is lowered in
// the IR (optdivmagic.bit) and the selection-time emitter is gone, THAT is
// where the verdict lives, and `xDivisorPlan` no longer has an opinion about
// it at all. The rows below therefore also pin what the planner is left
// answering for a `/` -- `litDivPlan()`, a real divide, which is what the
// backend must still emit for the divides the IR pass declines.
fn checkRemDeclinesMagic() {
  let ctx = newTypeContext()
  let w64s = mkWidth(8, RegClass.Int, true)
  let w64u = mkWidth(8, RegClass.Int, false)

  // `/` takes the magic multiply; `%` by the same 12 does not. The `%` half
  // measured +4.77% cycles and is declined for that.
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 12, 3), 2).ok)
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.SRem, 12, 3), 2).ok)
  assert(divMagicForInstr(ctx, dpDivFunc(ctx, Op.UDiv, 7, 7), 2).ok)
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.URem, 7, 7), 2).ok)

  // A POWER OF TWO is declined by the IR pass at every op: a shift is strictly
  // cheaper than a multiply, and `emitPow2DivInt`/`emitPow2RemInt` keep it.
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 8, 3), 2).ok)
  // …and the planner still reduces those to the shift, for `%` as well as `/`.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64s), 3, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64u), 3, false)

  // A ZERO divisor is declined by the pass and keeps its guard in the planner,
  // so the program still panics. Neither half folds it into a silent answer.
  assert(!divMagicForInstr(ctx, dpDivFunc(ctx, Op.SDiv, 0, 3), 2).ok)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0), 0, w64s), -1, true)

  // What is left for the backend once the pass has run: a non-zero literal
  // divisor is `litDivPlan()`, and BOTH backends' skip scans must therefore
  // materialize it again -- an emitter reading a register nothing wrote is the
  // failure this predicate exists to prevent.
  assert(divPlanReadsDivisor(xDivisorPlan(dpConstFunc(ctx, 12), 0, w64s)))
  assert(!divPlanReadsDivisor(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64s)))
}

// The emitted-byte half: a `/` and a `%` by the same non-zero literal both
// reach the backend as `litDivPlan()` now, so both emit a REAL divide. #4729
// deleted the magic emitters this used to compare against; the sequence's own
// shape is pinned in the IR by divmagiccheck.bit.
fn checkDivRemEmittedShapes() {
  let ctx = newTypeContext()
  let w64 = mkWidth(8, RegClass.Int, true)

  // `%`: divisor in a register, one `sdiv` into scratch3, one `msub` -- the
  // pre-#4389 sequence, byte for byte, and unchanged by any of this.
  let rplan = xDivisorPlan(dpConstFunc(ctx, 12), 0, w64)
  let rcx = selCtx()
  emitDivInt(rcx, Op.SRem, 0, 1, 2, rplan, w64)
  let rwant = newByteBuf()
  sdivRR(rwant, scratch3(), 1, 2)
  msubRR(rwant, 0, scratch3(), 2, 1)
  assertSameBytes(rcx.code, rwant)
  assert(bufHasDivide(rcx.code))

  // `/` by the same divisor: a plain `sdiv`, because a `/` the IR pass lowered
  // never reaches this emitter and a `/` it declined must divide for real.
  let dcx = selCtx()
  emitDivInt(dcx, Op.SDiv, 0, 1, 2, xDivisorPlan(dpConstFunc(ctx, 12), 0, w64), w64)
  let dwant = newByteBuf()
  sdivRR(dwant, 0, 1, 2)
  assertSameBytes(dcx.code, dwant)
  assert(bufHasDivide(dcx.code))

  // The x86-64 twin takes the same decision from the same plan.
  let xrem = xTestCtx()
  xEmitDivInt(xrem, XDivOp.SRem, 0, 0, 0, rplan, w64)
  assert(xHexHas(xrem.buf, "48f7f8")) // idiv %rax
  let xdiv = xTestCtx()
  xEmitDivInt(xdiv, XDivOp.SDiv, 0, 0, 0, rplan, w64)
  assert(xHexHas(xdiv.buf, "48f7f8"))
}

// The emitted-byte half: `litDivPlan()` must drop the zero-check and keep the
// divide, on BOTH backends. Asserting only "the plan says no guard" would pass
// against an emitter that ignored the field.
fn checkDivGuardFold() {
  let w64 = mkWidth(8, RegClass.Int, true)

  let xGuarded = xTestCtx()
  xEmitDivInt(xGuarded, XDivOp.SDiv, 0, 0, 0, runtimeDivPlan(), w64)
  let xFolded = xTestCtx()
  xEmitDivInt(xFolded, XDivOp.SDiv, 0, 0, 0, litDivPlan(), w64)
  // The folded form is a strict PREFIX-free suffix match: same cqo+idiv tail,
  // fewer bytes, and the test/jcc/call is what went.
  assert(len(xFolded.buf.code) < len(xGuarded.buf.code))
  assert(xHex(xFolded.buf) == "489948f7f8") // cqo ; idiv %rax -- and nothing else
  assert(xHex(xGuarded.buf)[len(xHex(xGuarded.buf)) - 10:len(xHex(xGuarded.buf))] == "489948f7f8")

  let aGuarded = selCtx()
  emitDivInt(aGuarded, Op.SDiv, 0, 1, 2, runtimeDivPlan(), w64)
  let aFolded = selCtx()
  emitDivInt(aFolded, Op.SDiv, 0, 1, 2, litDivPlan(), w64)
  assert(len(aFolded.code.bytes) == 4)                             // one sdiv, nothing else
  assert(len(aGuarded.code.bytes) == len(aFolded.code.bytes) + 12) // cmp + b.ne + bl
  assert(len(aFolded.relocs) == 0 && len(aGuarded.relocs) == 1)
}
