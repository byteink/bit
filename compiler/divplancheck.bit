// In-Bit self-checks for `xDivisorPlan` (divplan.bit) — the single decision
// both backends' div/rem emitters, arm64's `hasDivZeroGuard` frameless
// predicate and each backend's skip-the-constant scan share (#4361).
//
// Its own file rather than a sibling of either backend's checks: the function
// is backend-neutral, and `x64selcheck.bit` sits 8 lines under the 800-line
// limit. Sibling .bit files are the same module, so `selfcheck()` calls these
// directly.
//
// A wrong "yes" here is a SILENT wrong answer, not a slow one: reporting no
// guard for a divisor that can be zero deletes the panic SPEC §13.5 requires
// and lets `idiv`/`sdiv` see a zero divisor. That is the reason every arm is
// pinned individually rather than by sampling.

// One-instruction IrFunc whose instruction 0 is `const_int <v>`.
fn dpConstFunc(ctx: TypeContext, v: int): IrFunc {
  let ty = primType(ctx, 3) // i64
  let c = mkInstr(Op.ConstInt, ty)
  c.ival = v
  return IrFunc{
    name: "c", paramTypes: []int(0), result: ty,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }],
    instrs: [c], isFallible: false,
  }
}

// `magicOk` is not optional detail: since #4389 a plan that reduces to a magic
// multiply and a plan that keeps a real divide BOTH read `pow2K == -1,
// guard == false`, so a check that pins only those two fields no longer
// distinguishes them and would pass whichever one the planner returned.
fn dpAssertPlan(p: DivPlan, pow2K: int, guard: bool, magicOk: bool) {
  assert(p.pow2K == pow2K)
  assert(p.guard == guard)
  assert(p.magic.ok == magicOk)
  // The nonsensical states: neither reduced shape reads the divisor register,
  // so a guard in front of either would test an operand nothing uses, and no
  // divisor is both a shift and a multiply.
  assert(!(p.pow2K >= 0 && p.guard))
  assert(!(p.magic.ok && p.guard))
  assert(!(p.pow2K >= 0 && p.magic.ok))
  // The reduced shapes are exactly the ones the skip scans may drop the
  // divisor for; asserted here so the two can never drift apart silently.
  assert(divPlanReadsDivisor(p) == (p.pow2K < 0 && !p.magic.ok))
}

fn checkDivisorPlan() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let w64s = mkWidth(8, RegClass.Int, true)
  let w64u = mkWidth(8, RegClass.Int, false)

  // A positive power of two >= 2: shift path, and no guard because a power of
  // two is non-zero by construction (the pre-#4361 rule, unchanged).
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64s, Op.SDiv), 3, false, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 2), 0, w64s, Op.SDiv), 1, false, false)

  // #4361 dropped the guard for a known non-zero literal and kept the divide;
  // #4389 took the divide too. These three are now magic multiplies, and the
  // rows exist to pin that the WIDENING happened -- before #4389 all three
  // asserted `magic.ok == false` and were equally true.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 7), 0, w64s, Op.SDiv), -1, false, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 10), 0, w64s, Op.SDiv), -1, false, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 2147483647), 0, w64s, Op.SDiv), -1, false, true)

  // Divisor 1 and divisor -1 are non-zero, so the guard goes -- and they are
  // the ONLY signed divisors left that still emit a real divide, which is why
  // these two rows carry `magic.ok == false` while every other non-zero
  // constant above and below carries true.
  //
  // -1 is the one that matters: `INT_MIN / -1` is the single signed overflow
  // division can produce, SPEC §13.5 wraps it two's-complement in a release
  // build, and that is exactly what the hardware `sdiv`/`idiv` already does.
  // A magic sequence would not. Divisor 1 is declined because a multiply to
  // compute `n / 1` would be strictly worse than the divide it replaced.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 1), 0, w64s, Op.SDiv), -1, false, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 1), 0, w64s, Op.SDiv), -1, false, false)
  // As an UNSIGNED divisor the -1 bit pattern is 2^64-1, an ordinary divisor
  // with an ordinary magic. The decline is signed-only and this pins that.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 1), 0, w64u, Op.UDiv), -1, false, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 1), 0, w64u, Op.UDiv), -1, false, false)
  // A NEGATIVE power of two is not a shift -- `xConstPow2Divisor` declines any
  // non-positive divisor -- but it is a perfectly good magic multiply, so
  // #4389 reduces it where #4361 left a real divide.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 8), 0, w64s, Op.SDiv), -1, false, true)

  // A known ZERO divisor keeps the guard, so the program still panics. It is
  // never folded into a silent 0 or a silent `lhs`.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0), 0, w64s, Op.SDiv), -1, true, false)

  // Not a constant at all: nothing is known, so everything is emitted.
  let notConst = mkInstr(Op.BlockParam, i64t)
  let fVar = IrFunc{
    name: "v", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 1 }],
    instrs: [notConst], isFallible: false,
  }
  dpAssertPlan(xDivisorPlan(fVar, 0, w64s, Op.SDiv), -1, true, false)

  // At an UNSIGNED width, -8 is the huge magnitude 2^64-8: not a power of two,
  // but still non-zero, so the guard goes -- and it takes the unsigned magic,
  // computed on that 2^64-8 and not on any narrowed reading of it.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0 - 8), 0, w64u, Op.UDiv), -1, false, true)

  // The guard question is asked of the RAW 64-bit ival, because that is what
  // `movImm64`/`xEmitConstInt` materialize and what `cmpZero`/`xTestRR` then
  // compare -- neither truncates to the declared width. 3 * 2^32 in an
  // i32-typed const masks to ZERO at 32 bits and is still a non-zero register
  // at run time, which the emitted `sdiv` divides by; folding the check is
  // therefore correct, and reading the masked value instead would keep a
  // provably-dead branch. (The whole chain is raw: `xConstPow2Divisor` also
  // declines it on the raw magnitude, 0x3_00000000, not on the masked 0.)
  let w32s = mkWidth(4, RegClass.Int, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 12884901888), 0, w32s, Op.SDiv), -1, false, true)
  // …and the same rawness makes 2^32 at i32 a real power of two, k == 32,
  // because that is the value the register actually holds.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 4294967296), 0, w32s, Op.SDiv), 32, false, false)

  // The four named constructors are what the emitters branch on, and no two
  // of them mean the same thing.
  dpAssertPlan(runtimeDivPlan(), -1, true, false)
  dpAssertPlan(litDivPlan(), -1, false, false)
  dpAssertPlan(pow2DivPlan(3), 3, false, false)
  dpAssertPlan(magicDivPlan(divisorMagic(7, true)), -1, false, true)
}

// #4722: the plan splits by OP, not only by divisor. Every row below is the
// SAME divisor at the SAME width asked twice, so a gate that accidentally
// keyed on anything else (the value, the signedness, the width) cannot pass
// both halves — one divisor asked once would have proven nothing.
fn checkRemDeclinesMagic() {
  let ctx = newTypeContext()
  let w64s = mkWidth(8, RegClass.Int, true)
  let w64u = mkWidth(8, RegClass.Int, false)

  // `/` takes the magic multiply; `%` by the same 12 keeps the real divide,
  // which is `litDivPlan()`: no guard (12 is provably non-zero), no shift, no
  // magic. The `%` half measured +4.77% cycles and is declined for that.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 12), 0, w64s, Op.SDiv), -1, false, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 12), 0, w64s, Op.SRem), -1, false, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 7), 0, w64u, Op.UDiv), -1, false, true)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 7), 0, w64u, Op.URem), -1, false, false)

  // The power-of-two path is NOT gated: `emitPow2RemInt` masks rather than
  // recovering the remainder, so `%` by 8 still reduces exactly as before.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64s, Op.SRem), 3, false, false)
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 8), 0, w64u, Op.URem), 3, false, false)
  // A zero divisor keeps its panic for `%` too -- the decline moved the magic
  // question only, never the guard question.
  dpAssertPlan(xDivisorPlan(dpConstFunc(ctx, 0), 0, w64s, Op.SRem), -1, true, false)

  // The declined plan must make BOTH backends' skip scans materialize the
  // divisor again: a `%` plan that reduced here while the emitter issued an
  // `msub` would read a register nothing wrote.
  assert(divPlanReadsDivisor(xDivisorPlan(dpConstFunc(ctx, 12), 0, w64s, Op.SRem)))
  assert(!divPlanReadsDivisor(xDivisorPlan(dpConstFunc(ctx, 12), 0, w64s, Op.SDiv)))
  assert(divOpTakesMagic(Op.SDiv) && divOpTakesMagic(Op.UDiv))
  assert(!divOpTakesMagic(Op.SRem) && !divOpTakesMagic(Op.URem))
}

// The emitted-byte half of that split, both shapes through the PLANNER rather
// than through a hand-built plan: the tuple assertions above and an emitter
// that ignored the op are indistinguishable without this.
fn checkDivRemEmittedShapes() {
  let ctx = newTypeContext()
  let w64 = mkWidth(8, RegClass.Int, true)

  // `%`: divisor in a register, one `sdiv` into scratch3, one `msub` -- the
  // pre-#4389 sequence, byte for byte.
  let rplan = xDivisorPlan(dpConstFunc(ctx, 12), 0, w64, Op.SRem)
  let rcx = selCtx()
  emitDivInt(rcx, Op.SRem, 0, 1, 2, rplan, w64)
  let rwant = newByteBuf()
  sdivRR(rwant, scratch3(), 1, 2)
  msubRR(rwant, 0, scratch3(), 2, 1)
  assertSameBytes(rcx.code, rwant)
  assert(bufHasDivide(rcx.code))

  // `/` by the same divisor: the magic quotient and no divide at all.
  let dplan = xDivisorPlan(dpConstFunc(ctx, 12), 0, w64, Op.SDiv)
  assert(dplan.magic.ok)
  let dcx = selCtx()
  emitDivInt(dcx, Op.SDiv, 0, 1, 2, dplan, w64)
  let dwant = newByteBuf()
  dmWantSigned(dwant, dplan.magic, scratch3(), 1)
  movRR(dwant, 0, scratch3())
  assertSameBytes(dcx.code, dwant)
  assert(!bufHasDivide(dcx.code))

  // The x86-64 twin takes the same two decisions from the same two plans.
  let xrem = xTestCtx()
  xEmitDivInt(xrem, XDivOp.SRem, 0, 0, 0, rplan, w64)
  assert(xHexHas(xrem.buf, "48f7f8")) // idiv %rax
  let xdiv = xTestCtx()
  xEmitDivInt(xdiv, XDivOp.SDiv, 0, 0, 0, dplan, w64)
  assert(!xHexHas(xdiv.buf, "48f7f8"))
}

// The emitted-byte half: `litDivPlan()` must drop the zero-check and keep the
// divide, on BOTH backends. Asserting only "the plan says no guard" would pass
// against an emitter that ignored the field.
fn checkDivGuardFold() {
  let w64 = mkWidth(8, RegClass.Int, true)

  let xGuarded = xTestCtx()
  xEmitDivInt(xGuarded, XDivOp.SDiv, 0, 0, 0, runtimeDivPlan(), w64)
  let xFolded = xTestCtx()
  xEmitDivInt(xFolded, XDivOp.SDiv, 0, 0, 0, litDivPlan(), w64)
  // The folded form is a strict PREFIX-free suffix match: same cqo+idiv tail,
  // fewer bytes, and the test/jcc/call is what went.
  assert(len(xFolded.buf.code) < len(xGuarded.buf.code))
  assert(xHex(xFolded.buf) == "489948f7f8") // cqo ; idiv %rax -- and nothing else
  assert(xHex(xGuarded.buf)[len(xHex(xGuarded.buf)) - 10:len(xHex(xGuarded.buf))] == "489948f7f8")

  let aGuarded = selCtx()
  emitDivInt(aGuarded, Op.SDiv, 0, 1, 2, runtimeDivPlan(), w64)
  let aFolded = selCtx()
  emitDivInt(aFolded, Op.SDiv, 0, 1, 2, litDivPlan(), w64)
  assert(len(aFolded.code.bytes) == 4)                             // one sdiv, nothing else
  assert(len(aGuarded.code.bytes) == len(aFolded.code.bytes) + 12) // cmp + b.ne + bl
  assert(len(aFolded.relocs) == 0 && len(aGuarded.relocs) == 1)
}
