// #5847: zeroing a DEAD spilled heap-word stack slot on the control-flow
// edges where its interval ends. Sibling of regalloc.bit, same module;
// `allocateCoalesced` calls `computeSlotClears` once its locations are final,
// and each backend emits the answer on the edge it names.
//
// ## Why a dead slot is a root
//
// runtime/ABI.md scans every frame CONSERVATIVELY on every collection
// (`stwScanStackRange`), so any word in a spill slot that looks like a heap
// pointer keeps its object alive, whatever the stack map says. A spill slot
// keeps its last value until something rewrites it. An evicted interval gets
// a slot nothing else has ever used (`assignSpill`, `reuse = false`), so once
// its value is dead nothing may ever write that slot again: the pointer stays
// a root for the rest of the call. #5824 measured it: `bench/cases/alloc`
// kept one batch's 5000 nodes reachable through the next batch's build loop,
// GC drain 3.0 ms -> 21.5 ms on x86-64.
//
// The scan is type-blind, so `isRef` is the wrong test for "can keep an
// object alive". #5848: with #5824 applied, LICM hoists alloc's for-of slice
// data word, a heap base typed `i64`, into a header param; x86 evicts it to a
// fresh slot and it roots the same 5000 nodes. So a slot is cleared when its
// value may hold a heap address: `isRef`, or `heapDerived` (codegenlivereach.bit,
// `markHeapDerived`). Clearing every Int-class slot instead measured 1-3% on
// x64 call-heavy code for stores over plain indices and counters.
//
// ## Why zeroing it is sound
//
// codegenlive.bit builds one interval per value with no holes, and lowering
// threads every value live across a back edge through the header's params
// (optloop.bit's header states and keeps that invariant). So a value live on
// entry to block B covers B's first position, and `B.start > iv.end` means
// the value is dead on entry to B on every path. That is the same fact slot
// recycling already relies on: `expireSpills` hands the slot to any interval
// starting after `iv.end`. A zero store is one more such write, so it needs
// exactly one extra check: no OTHER interval sharing the slot may be live on
// entry to B. By the same invariant such an interval covers B's first
// position, and so does a param of B, which the edge's own moves write
// (`extendParamsToPreds`). A value the moves only read is dead once they ran,
// and so is an alias of the dead value: its range lies inside its root's.
//
// ## Why on the edge, and not on every edge
//
// The clear is emitted ON the edge, after its parallel moves (which may read
// the dead value as an argument) and before its jump, so it runs exactly as
// often as the edge. Emitting it at B's start instead would run it on every
// entry to B: a loop header entered from its preheader would pay a store per
// iteration for a value that died before the loop.
//
// An edge that stays inside one loop body is skipped. Such a candidate always
// belongs to a value the same iteration defines (a value from outside the loop
// that is read inside it is a header param, live to the latch), so the store
// would run every iteration while the next definition rewrites the slot
// anyway. What is left runs at most once per loop entry: an edge that leaves
// a loop, one that enters a loop at its header, and one outside every loop.
// Only forward edges qualify at all, so a back edge never carries a clear
// and no clear ever sits next to a back-edge poll.
//
// ## Only where a safepoint follows
//
// The frame is scanned only while this call is parked at a safepoint: a call
// that can reach the collector, an allocation, a back-edge poll. Preemption
// is a request those polls read, never a signal (runtime/ABI.md). So a clear
// on an edge from which every path returns before reaching one buys nothing:
// no scan of this frame happens between the store and the return.
// `safepointReach` answers
// "some safepoint is reachable from this block" once per function, and a
// back edge makes a loop's own safepoints reachable from its header.

// One CFG edge, in the position numbering the intervals use. `src`/`dst` are
// block ids in layout order (a back edge has `dst <= src`); `srcStart` and
// `srcLast` are the source block's first and last positions, `dstStart` the
// target's first.
class CfgEdge {
  src: int,
  dst: int,
  srcStart: int,
  srcLast: int,
  dstStart: int,
}

// Store zero to spill `slot` on the edge `src` -> `dst`.
class SlotClear {
  src: int,
  dst: int,
  slot: int,
}

// A value that may hold a heap address (`isRef` or `heapDerived`) and lives
// in a real stack word. A remat interval owns no slot (index -1), a register
// holds nothing the frame scan reads, and an alias shares its root's slot
// inside the root's merged range (`mergeAliases`, which also moves both marks
// onto the root), so each slot is judged once, through that root.
fn ownsHeapSlot(iv: LiveInterval, loc: RegLoc, isAlias: bool): bool {
  return (iv.isRef || iv.heapDerived) && !isAlias && loc.isSpill && loc.index >= 0
}

// The interval reaches into the edge's source block and is dead on entry to
// its target.
fn edgeEndsInterval(iv: LiveInterval, e: CfgEdge): bool {
  return e.dstStart > iv.end && e.srcStart <= iv.end && e.srcLast >= iv.start
}

// Another interval assigned `slot` is live on entry to the edge's target.
// #5848: not "anywhere between the source's terminator and the target", which
// on a loop exit spans the whole body, so a header param aliasing the dead
// value, dead on that exit too, kept its own root's slot from being cleared.
fn slotBusyOnEdge(
  scan: []LiveInterval, locations: []RegLoc, owner: int, slot: int, e: CfgEdge,
): bool {
  let i = 0
  while (i < len(scan)) {
    if (i != owner && holdsSlotAcross(scan[i], locations[scan[i].vreg], slot, e)) {
      return true
    }
    i = i + 1
  }
  return false
}

fn holdsSlotAcross(w: LiveInterval, loc: RegLoc, slot: int, e: CfgEdge): bool {
  return loc.isSpill && loc.index == slot && w.start <= e.dstStart && w.end >= e.dstStart
}

// The last block of the loop headed by `header`: its furthest back-edge
// source. -1 when `header` is not a loop header. Loops are block ranges
// because lowering emits a loop's blocks between its header and its latch.
fn loopEndOf(edges: []CfgEdge, header: int): int {
  let end = -1
  for b of edges {
    if (b.dst == header && b.dst <= b.src && b.src > end) {
      end = b.src
    }
  }
  return end
}

// Runs at most once per loop entry: see the header. `e` enters a loop, leaves
// one, or lies in none.
fn edgeOutsideLoopBody(edges: []CfgEdge, e: CfgEdge): bool {
  if (loopEndOf(edges, e.dst) >= 0) {
    return true
  }
  let inLoop = false
  for b of edges {
    if (b.dst <= b.src && b.dst <= e.src && e.src <= b.src) {
      inLoop = true
      if (e.dst > loopEndOf(edges, b.dst)) {
        return true
      }
    }
  }
  return !inLoop
}

fn hasSlotClear(clears: []SlotClear, src: int, dst: int, slot: int): bool {
  for c of clears {
    if (c.src == src && c.dst == dst && c.slot == slot) {
      return true
    }
  }
  return false
}

// Every clear, in interval order then edge order, each (edge, slot) once.
// `locations` must be final: aliases propagated, float slots shifted. `alias`
// is `mergeAliases`' answer, indexed like `scan`; `safepoints` are positions.
fn computeSlotClears(
  scan: []LiveInterval, locations: []RegLoc, alias: []bool, edges: []CfgEdge,
  safepoints: []int,
): []SlotClear {
  assert(len(alias) == len(scan))
  let clearable = clearableEdges(edges, safepointReach(edges, safepoints))
  let out = []SlotClear(0)
  let owner = 0
  while (owner < len(scan)) {
    if (ownsHeapSlot(scan[owner], locations[scan[owner].vreg], alias[owner])) {
      out = appendSlotClears(out, scan, locations, owner, clearable)
    }
    owner = owner + 1
  }
  return out
}

// The edges a clear may sit on: outside every loop body (see the header) and
// into a block from which a safepoint is reachable.
fn clearableEdges(edges: []CfgEdge, reach: []bool): []CfgEdge {
  let out = []CfgEdge(0)
  for e of edges {
    if (reach[e.dst] && edgeOutsideLoopBody(edges, e)) {
      out = append(out, e)
    }
  }
  return out
}

// `reach[b]`: a safepoint lies in block `b` or in a block reachable from it.
// Blocks are known only through `edges`; a block that is no edge's source (it
// returns or traps) runs up to the next known block start, which can only
// widen it and so keep a clear. Backward propagation to a fixed point: every
// pass that changes anything sets one more block, so it ends within
// `len(reach)` passes.
fn safepointReach(edges: []CfgEdge, safepoints: []int): []bool {
  let starts = blockStarts(edges)
  let reach = []bool(len(starts))
  let b = 0
  while (b < len(starts)) {
    reach[b] = starts[b] >= 0 && holdsSafepoint(safepoints, starts[b], blockLast(edges, starts, b))
    b = b + 1
  }
  let passes = 0
  while (propagateReach(edges, reach)) {
    passes = passes + 1
    assert(passes <= len(reach))
  }
  return reach
}

// First position of every block an edge names, -1 for the rest.
fn blockStarts(edges: []CfgEdge): []int {
  let n = 0
  for e of edges {
    if (e.src >= n) {
      n = e.src + 1
    }
    if (e.dst >= n) {
      n = e.dst + 1
    }
  }
  let starts = []int(n)
  let b = 0
  while (b < n) {
    starts[b] = -1
    b = b + 1
  }
  for e of edges {
    starts[e.src] = e.srcStart
    starts[e.dst] = e.dstStart
  }
  return starts
}

// Block `b`'s last position, or -1 for "to the end of the function".
fn blockLast(edges: []CfgEdge, starts: []int, b: int): int {
  for e of edges {
    if (e.src == b) {
      return e.srcLast
    }
  }
  let next = -1
  for s of starts {
    if (s > starts[b] && (next < 0 || s < next)) {
      next = s
    }
  }
  if (next < 0) {
    return -1
  }
  return next - 1 // >= 0: `next` is after a start, so at least 1
}

// A safepoint at a position in [lo, hi], or in [lo, end) when `hi` is -1.
fn holdsSafepoint(safepoints: []int, lo: int, hi: int): bool {
  for p of safepoints {
    if (p >= lo && (hi < 0 || p <= hi)) {
      return true
    }
  }
  return false
}

// One backward pass, sources after targets. True if any block changed.
fn propagateReach(edges: []CfgEdge, reach: []bool): bool {
  let changed = false
  let i = len(edges) - 1
  while (i >= 0) {
    let e = edges[i]
    if (reach[e.dst] && !reach[e.src]) {
      reach[e.src] = true
      changed = true
    }
    i = i - 1
  }
  return changed
}

// `out` plus the clears `scan[owner]` needs. `edges` are `clearableEdges`.
fn appendSlotClears(
  out: []SlotClear, scan: []LiveInterval, locations: []RegLoc, owner: int, edges: []CfgEdge,
): []SlotClear {
  let iv = scan[owner]
  let slot = locations[iv.vreg].index
  for e of edges {
    if (edgeEndsInterval(iv, e)) {
      assert(e.dst > e.src) // dead on entry to the target: never a back edge
      if (!slotBusyOnEdge(scan, locations, owner, slot, e) &&
        !hasSlotClear(out, e.src, e.dst, slot)) {
        out = append(out, SlotClear{ src = e.src, dst = e.dst, slot = slot })
      }
    }
  }
  return out
}

// #5848: a conditional branch naming an edge that carries clears jumps to an
// out-of-line stub instead of the block. Deciding the branch's shape on the
// clears flipped loop headers from an untaken `jge exit` to a `jl body` taken
// every iteration (x64 sort +8.7%). Each backend emits its stubs after the
// last block: the zero stores, then a jump to `dst`. `patchOffset` is the
// branch's displacement field.
class ClearStub {
  patchOffset: int,
  src: int,
  dst: int,
}

fn edgeHasClears(clears: []SlotClear, src: int, dst: int): bool {
  for c of clears {
    if (c.src == src && c.dst == dst) {
      return true
    }
  }
  return false
}

// The slots a backend zeroes on the edge `src` -> `dst`, in `clears` order.
fn edgeClearSlots(clears: []SlotClear, src: int, dst: int): []int {
  let out = []int(0)
  for c of clears {
    if (c.src == src && c.dst == dst) {
      out = append(out, c.slot)
    }
  }
  return out
}

// #7716: zeroing a DEAD heap-word CALLEE-SAVED register before a call.
//
// Same hazard as the slots above, other storage. A callee that uses a
// callee-saved register saves the caller's value in its prologue, and
// `stwScanStackRange` reads that save conservatively. A register whose
// interval ended keeps its last word until the next interval assigned to it
// writes it, which can be after any number of calls, so a dead reference left
// there roots its object for as long as a callee that saves the register is
// on the stack. Which object leaks is register-assignment luck: #7706 and
// #7708 each moved a retained 58-byte string in `bench/cases/json`.
//
// So before a call that can reach the collector, every callee-saved register
// that holds no value at that point and whose latest occupant was a
// `isRef || heapDerived` interval is zeroed. "Holds no value" is "no interval
// assigned it is live into the call" (a result the call itself defines is
// written after the zero); nothing reads the zero, so it is as sound as
// handing the register to the next interval. A split value counts as
// holding every register it uses over its whole life, which only withholds a
// clear. The clear runs at most once per register between occupants (a later
// call in the same block sees it clean) and never in a loop body, the rule the
// slot clears above follow: a value defined in the iteration is rewritten by
// the next one, and one that dies in the loop is cleared before the first call
// after the loop.
//
// #7732: a register dirty BEFORE a loop is the one case that rule leaves
// exposed: it stays dirty for every call in the loop, and no iteration
// rewrites it. So the same clear also runs once per loop entry, before the
// terminator of each block outside every loop body that jumps forward to the
// header of a loop whose body holds a call (`loopEntryPositions`). The
// terminator is the right place because it runs before the edge's moves, which
// read only values live at it (so covered) and write registers nothing reads
// afterwards, and it runs once per entry, never per iteration. A clear there
// is sound for any block that can follow, as for a call: the mask names only
// registers no live value occupies. An entry from inside an outer loop body is
// left to the outer loop's own entry; a value that dies in the iteration is
// the case above. A loop that only polls on its back edge is not covered: the
// poll republishes the whole file, a different hazard.
//
// The emitter zeroes the registers of `mask` before the instruction at
// position `p`, only those its frame saves (an interval the emitter folded
// away owns a register the prologue never saved, and zeroing that one would
// clobber the caller's value).

// One register occupancy: `reg` (int file position) holds a value on [lo, hi].
class RegSpan {
  reg: int,
  lo: int,
  hi: int,
  heap: bool,
}

// Every register occupancy of a non-alias, non-folded Int interval. A split
// interval contributes one span per register it ever uses, over its whole life.
fn regSpans(
  scan: []LiveInterval, locations: []RegLoc, alias: []bool, splitOf: []int,
  splits: []SplitPiece,
): []RegSpan {
  let out = []RegSpan(0)
  let i = 0
  while (i < len(scan)) {
    let iv = scan[i]
    if (!alias[i] && !iv.filler && !iv.folded && iv.regClass == RegClass.Int) {
      out = appendSpans(out, iv, locations[iv.vreg], splitOf[iv.vreg], splits)
    }
    i = i + 1
  }
  return out
}

fn appendSpans(
  out: []RegSpan, iv: LiveInterval, head: RegLoc, split: int, splits: []SplitPiece,
): []RegSpan {
  let heap = iv.isRef || iv.heapDerived
  if (split < 0) {
    if (head.isSpill) {
      return out
    }
    out = append(out, RegSpan{ reg = head.index, lo = iv.start, hi = iv.end, heap = heap })
    return out
  }
  let p = splits[split]
  if (!head.isSpill) {
    out = append(out, RegSpan{ reg = head.index, lo = iv.start, hi = iv.end, heap = false })
  }
  if (!p.tail.isSpill) {
    out = append(out, RegSpan{ reg = p.tail.index, lo = iv.start, hi = iv.end, heap = false })
  }
  if (p.at2 >= 0) {
    out = append(out, RegSpan{ reg = p.backReg, lo = iv.start, hi = iv.end, heap = false })
  }
  return out
}

// `p` lies in the body of some loop: a back edge's header start to its source's
// last position.
fn inLoopBody(edges: []CfgEdge, p: int): bool {
  for e of edges {
    if (e.dst <= e.src && e.dstStart <= p && p <= e.srcLast) {
      return true
    }
  }
  return false
}

// A block starts in (lo, hi].
fn blockStartIn(starts: []int, lo: int, hi: int): bool {
  for s of starts {
    if (s > lo && s <= hi) {
      return true
    }
  }
  return false
}

// Ascending copy of `ps` (insertion sort; a function's calls are few).
fn sortedPositions(ps: []int): []int {
  let out = []int(0)
  for p of ps {
    out = append(out, p)
    let k = len(out) - 1
    while (k > 0 && out[k - 1] > out[k]) {
      let t = out[k]
      out[k] = out[k - 1]
      out[k - 1] = t
      k = k - 1
    }
  }
  return out
}

// What the call at `p` sees per register: the span holding it (`covered`), or
// else the index of the latest span that ended before `p`.
class RegView {
  covered: []bool,
  last: []int,
}

fn viewAt(spans: []RegSpan, p: int, nregs: int): RegView {
  let v = RegView{ covered = []bool(nregs), last = []int(nregs) }
  let r = 0
  while (r < nregs) {
    v.last[r] = -1
    r = r + 1
  }
  let k = 0
  while (k < len(spans)) {
    let s = spans[k]
    if (s.lo < p && p <= s.hi) {
      v.covered[s.reg] = true
    } else if (s.hi < p && (v.last[s.reg] < 0 || s.lo > spans[v.last[s.reg]].lo)) {
      v.last[s.reg] = k
    }
    k = k + 1
  }
  return v
}

// What `computeRegClears` carries between calls: the occupancies, the block
// starts, and per register the span index (+1) and position of the last clear.
class ClearState {
  spans: []RegSpan,
  starts: []int,
  calleeSaved: int,
  nregs: int,
  lastKey: []int,
  lastPos: []int,
}

// Whether the register whose latest ended span is `key` must be zeroed at `p`.
fn needsClear(st: ClearState, v: RegView, r: int, p: int): bool {
  let key = v.last[r]
  if (((st.calleeSaved >> r) & 1) == 0 || v.covered[r] || key < 0 || !st.spans[key].heap) {
    return false
  }
  // A clear since this occupant, in the same block, still stands.
  return !(st.lastKey[r] == key + 1 && !blockStartIn(st.starts, st.lastPos[r], p))
}

// The mask of registers to zero before the call at `p`.
fn clearMaskAt(st: ClearState, p: int): int {
  let v = viewAt(st.spans, p, st.nregs)
  let mask = 0
  let r = 0
  while (r < st.nregs) {
    if (needsClear(st, v, r, p)) {
      mask = mask | (1 << r)
      st.lastKey[r] = v.last[r] + 1
      st.lastPos[r] = p
    }
    r = r + 1
  }
  return mask
}

// The last position of the loop headed by `header` (its furthest back edge's
// source's last position), or -1 when `header` heads none.
fn loopLastPos(edges: []CfgEdge, header: int): int {
  let last = -1
  for e of edges {
    if (e.dst == header && e.dst <= e.src && e.srcLast > last) {
      last = e.srcLast
    }
  }
  return last
}

// A call lies in [lo, hi].
fn holdsCall(calls: []int, lo: int, hi: int): bool {
  for c of calls {
    if (c >= lo && c <= hi) {
      return true
    }
  }
  return false
}

// The terminator positions of the blocks that enter, from outside every loop
// body, a loop whose body holds a call: where the registers dirty before the
// loop are zeroed, once per entry (#7732, see the header).
fn loopEntryPositions(edges: []CfgEdge, calls: []int): []int {
  let out = []int(0)
  for e of edges {
    let last = loopLastPos(edges, e.dst)
    if (e.dst > e.src &&
      last >= 0 &&
      holdsCall(calls, e.dstStart, last) &&
      !inLoopBody(edges, e.srcLast) &&
      !holdsPos(out, e.srcLast)) {
      out = append(out, e.srcLast)
    }
  }
  return out
}

fn holdsPos(ps: []int, p: int): bool {
  for q of ps {
    if (q == p) {
      return true
    }
  }
  return false
}

// Per position, a mask over int-file positions of the callee-saved registers
// to zero before the instruction there; empty when none needs one. Indexed by
// instruction position, length `last position + 1`, over the calls that can
// reach the collector (`points.calleeSafepoints`) outside every loop body and
// the loop entries `loopEntryPositions` names, for the int `file`.
fn computeRegClears(
  scan: []LiveInterval, alias: []bool, sp: Splitter, points: AllocPoints, file: RegFile,
): []int {
  let calls = points.calleeSafepoints
  let edges = sp.edges
  if (len(calls) == 0 || file.calleeSaved == 0) {
    return []int(0)
  }
  let st = ClearState{
    spans = regSpans(
      scan,
      sp.locations,
      alias,
      splitIndex(len(scan), sp.pieces, []int(0)),
      sp.pieces,
    ),
    starts = blockStarts(edges), calleeSaved = file.calleeSaved, nregs = file.count,
    lastKey = []int(file.count), lastPos = []int(file.count),
  }
  let ordered = calls
  for p of loopEntryPositions(edges, calls) {
    ordered = append(ordered, p)
  }
  ordered = sortedPositions(ordered)
  let out = []int(ordered[len(ordered) - 1] + 1)
  for p of ordered {
    if (!inLoopBody(edges, p)) {
      out[p] = clearMaskAt(st, p)
    }
  }
  return out
}

// The mask `RegAllocResult.regClears` holds for position `p`, 0 past its end.
fn regClearsAt(res: RegAllocResult, p: int): int {
  if (p < 0 || p >= len(res.regClears)) {
    return 0
  }
  return res.regClears[p]
}
