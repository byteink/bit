// #6683: the closure-call emitters, split out of arm64call.bit, which was one
// line under the 800-line ceiling, so the one-word and the word-run forms can
// sit together. Sibling .bit file, same module: see arm64.bit for the backend
// overview, and arm64call.bit for the direct and interface forms this mirrors.

// #6683: the closure-call counterpart of #5446's emitCallIface split. Only the
// binding differs between a one-handle result and a word run, so the nil check,
// the cell loads, the marshaling and the safepoint live in ONE sequence and
// cannot drift between the two forms.
//
// call_value: dispatch through a closure. Load the environment (+8) and code
// pointer (+0) into reserved scratch regs argument marshaling never touches,
// marshal the real arguments into x1.., place the environment in x0, then blr. A
// call is a GC point, so it records a safepoint.
//
// #7740: the code address lives in x16 (ascratch1), NOT x11. Marshaling writes
// x9 (mem->mem staging), x10 (cycle rotation) and x11 (loadImm/storeImm's
// far-displacement temp: a spill slot past 32760 bytes loads through
// `mov x11, #disp` + a register-offset load), so a code address held in x11
// became the displacement and the blr jumped to it. x16 is no allocatable
// register and no marshaling path writes it (only atomics and the interface
// cache probe do, both finished before this point).
fn emitCallValueSeq(cx: A64Ctx, callee: int, args: []int) {
  let cell = getInt(cx, vregOf(cx, callee), scratch1())
  // #2018: a nil function value's cell is the null word (SPEC §13.4); calling
  // through it must panic (§18.4: "call of a nil function"), not dereference
  // address 0 for its {code, env} fields. `Op.CallValue` is already a full
  // safepoint/clobber point for regalloc (isSafepointOp), so this extra call
  // on the cold path needs no register preservation of its own.
  //
  // #4355: CBNZ, not `cmp cell, xzr` + `b.ne` — one instruction where that was
  // two, testing the full 64-bit register directly and writing no flags, the
  // same trade `emitPollGuard` already makes on every back edge. It is paid at
  // EVERY call through a function value, and this check cannot be hoisted out
  // of a loop today: LICM (optloopcand.bit) moves instructions, not branches,
  // and §13.4's panic must fire at the first call rather than at loop entry,
  // so a loop that runs zero times must not perform it at all
  // (`_tests_/cases/run_nil_call_zero_trip.bit`).
  let ncFixup = emitLocalCbz(cx, true, cell) // non-nil -> skip the panic call
  emitCallReloc(cx, "bit_rt_panic_nil_call")
  patchLocalCondBranch(cx, ncFixup)
  loadImm(cx.code, scratch2(), cell, 8, 8, false)  // x10 = env
  loadImm(cx.code, ascratch1(), cell, 0, 8, false) // x16 = code
  marshalArgs(cx, args, 1, 0)
  movRR(cx.code, argReg(RegClass.Int, 0), scratch2()) // x0 = env
  blr(cx.code, ascratch1())
  recordSafepoint(cx, codeLen(cx))
}

// #6683: the one-word form. Byte-identical to the sequence before the split.
fn emitCallValue(cx: A64Ctx, dst: int, dstTy: int, callee: int, args: []int) {
  emitCallValueSeq(cx, callee, args)
  bindCallResult(cx, dst, dstTy, false)
}

// #6683: the multi-word form. Instruction `i` is the `Op.CallValue` (word 0)
// and the `w - 1` `Op.CallWord`s immediately after it carry the rest, so ONE
// `bindCallResults` binds every word — nothing may be emitted between the
// `blr` and the last binding (#4236), which is why the whole run is compiled
// here rather than one word at a time. A closure returns its words in the same
// ABI registers a direct call does, so the binding is the same call as
// `emitCallWords` (arm64call.bit) and `emitCallIfaceWords` (arm64calliface.bit) make.
fn emitCallValueWords(cx: A64Ctx, i: int, ins: IrInstr, w: int) {
  let dsts = callWordDsts(cx, i, w)
  let tys = callWordTys(cx, i, w)
  emitCallValueSeq(cx, ins.lhs, ins.args)
  bindCallResults(cx, dsts, tys, false)
}
